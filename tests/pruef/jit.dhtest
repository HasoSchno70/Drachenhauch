=== methode in einer schleife
CLASS Zaehler
    DIM n AS INTEGER
    DIM schritt AS INTEGER
    SUB weiter()
        Self.n = Self.n + Self.schritt
    END SUB
    FUNCTION doppelt(x AS INTEGER) AS INTEGER
        RETURN x * 2 + Self.n
    END FUNCTION
END CLASS
DIM z AS Zaehler : z = NEW Zaehler()
z.schritt = 3
DIM s AS INTEGER
DIM i AS INTEGER
FOR i = 1 TO 100
    z.weiter()
    s = s + z.doppelt(i) MOD 1000
NEXT
PRINT z.n; " "; s
