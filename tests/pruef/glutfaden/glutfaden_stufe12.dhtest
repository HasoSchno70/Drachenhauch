--- erwartet
gleich (321 Zeilen)

=== vorschaubild: zehn bilder neben denen von pysticky
IMPORT "helfer.dh"
DIM gtkDa AS BOOLEAN : gtkDa = TRUE
TRY
    cairo_surface_destroy(cairo_image_surface_create(CAIRO_ARGB32, 1, 1))
CATCH e
    gtkDa = FALSE
END TRY
IF NOT gtkDa THEN
    PRINT "UEBERSPRINGEN: kein Cairo"
    EXIT(0)
END IF
DIM alle AS kern.Muster : alle = kern.pxsLaden("alle.pxs")
DIM drills AS kern.Muster : drills = kern.pxsLaden("drills.pxs")
DIM leer AS kern.Muster : leer = kern.pxsLaden("leer.pxs")
' wie die Aufzeichnung: ohne Symbole (PySticky fuellte sie beim Laden nach)
DIM fe AS kern.Farbeintrag
FOR EACH fe IN leer.farben
    fe.symbol = ""
NEXT
MKDIR("dh")
SUB bild(name AS STRING, m AS kern.Muster, art AS INTEGER, z AS INTEGER, stoff AS INTEGER, fertig AS BOOLEAN, rueck AS BOOLEAN, grenze AS FLOAT)
    DIM s AS Vorschaustil : s = neuerVorschaustil(art)
    s.stoff = stoff
    s.erledigt = fertig
    s.rueckstiche = rueck
    IF NOT vbPng(m, s, z, "dh/" + name + ".png") THEN
        PRINT name; ": nicht geschrieben"
        RETURN
    END IF
    PRINT gvZeile$(name, "ref/" + name + ".png", "dh/" + name + ".png", grenze)
END SUB
bild("alle_pixel_12", alle, 1, 12, &HFFFFFF, FALSE, TRUE, 0.5)
bild("alle_pixel_5", alle, 1, 5, &HFFFFFF, FALSE, TRUE, 1.5)
bild("alle_pixel_12_fertig", alle, 1, 12, &HFFFFFF, TRUE, TRUE, 1.0)
bild("alle_stoff_20", alle, 0, 20, &HFFFFFF, FALSE, TRUE, 0.5)
bild("alle_stoff_12", alle, 0, 12, &HFFFFFF, FALSE, TRUE, 5.5)
bild("alle_stoff_12_schwarz", alle, 0, 12, &H141414, FALSE, TRUE, 3.5)
bild("drills_stoff_12", drills, 0, 12, &HFFFFFF, FALSE, TRUE, 0.5)
bild("drills_pixel_16", drills, 1, 16, &HFFFFFF, FALSE, TRUE, 0.5)
bild("leer_symbol_20", leer, 2, 20, &HFFFFFF, FALSE, TRUE, 4.5)
bild("leer_symbol_12_fertig", leer, 2, 12, &HFFFFFF, TRUE, TRUE, 7.0)
