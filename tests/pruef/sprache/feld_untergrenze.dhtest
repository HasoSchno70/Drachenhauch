=== die grenzen reisen mit dem feld
FUNCTION summe(a AS ARRAY OF INTEGER) AS INTEGER
    DIM s AS INTEGER
    DIM i AS INTEGER
    FOR i = LBOUND(a) TO UBOUND(a)
        s = s + a[i] * i
    NEXT
    RETURN s
END FUNCTION
FUNCTION neu() AS ARRAY OF INTEGER
    DIM r[-1 TO 1] AS INTEGER
    r[-1] = 10 : r[1] = 30
    RETURN r
END FUNCTION
CLASS Monat
    DIM tage[1 TO 3] AS INTEGER
END CLASS
DIM a[1 TO 3] AS INTEGER
a[1] = 1 : a[2] = 1 : a[3] = 1
PRINT summe(a)
DIM b AS ARRAY OF INTEGER
b = a
b[3] = 5
PRINT a[3], LBOUND(b)
DIM c AS ARRAY OF INTEGER
c = neu()
PRINT LBOUND(c), c[-1], c[1]
DIM m AS Monat
m = NEW Monat()
m.tage[3] = 9
PRINT LBOUND(m.tage), UBOUND(m.tage), m.tage[3]
DIM m2 AS Monat
m2 = NEW Monat()
PRINT m2.tage[3]
a = [7, 8, 9]
PRINT LBOUND(a), a[0]
