--- erwartet
gleich (42 Zeilen)

=== aehnliche farben: zusammenfuehren wie pysticky, rueckstiche gehen mit, ein schritt
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")

' PySticky (ref_merge.py): fuer jede Quelle das erste Paar bis Schwelle 10,
' dann merge_colors_stitches + remove_color. Gleich sein muessen Farben,
' Stichzahlen und alle Raster samt Stichart; die Rueckstiche loescht PySticky
' mit ihrer Farbe (in der Aufzeichnung: 0), hier gehen sie an die bleibende.
DIM vorher AS STRING : vorher = rasterText$(m)
DIM ab AS ARRAY OF FLOAT
DIM pa AS ARRAY OF INTEGER : pa = kern.aehnlichePaare(m, 10, ab)
DIM gewaehlt AS ARRAY OF INTEGER : gewaehlt = []
DIM quelle AS MAP OF BOOLEAN : quelle = {}
DIM i AS INTEGER
DIM t AS STRING
FOR i = 0 TO LEN(pa) - 2 STEP 2
    IF MAPHAS(quelle, STR$(pa[i + 1])) THEN CONTINUE
    MAPPUT(quelle, STR$(pa[i + 1]), TRUE)
    ARRAY_PUSH(gewaehlt, pa[i]) : ARRAY_PUSH(gewaehlt, pa[i + 1])
    t = t + " " + STR$(pa[i]) + "-" + STR$(pa[i + 1])
NEXT
DIM v AS kern.Verlauf : v = NEW kern.Verlauf()
DIM n AS INTEGER
DIM fehler AS STRING : fehler = kern.farbenZusammenfuehren$(m, v, gewaehlt, n)
DIM z AS ARRAY OF STRING : z = ["paare" + t]
DIM f AS kern.Farbeintrag
DIM fz AS ARRAY OF STRING : fz = []
FOR EACH f IN m.farben
    ARRAY_PUSH(fz, f.garn.name + " " + STR$(f.stichzahl))
NEXT
ARRAY_PUSH(z, "farben " + JOIN$(fz, " | "))
ARRAY_PUSH(z, "rueckstiche 0 ")
ARRAY_PUSH(z, rasterText$(m))
PRINT "fehler ["; fehler; "] umgefaerbt "; n; " | verlauf: "; v.textZurueck$()
PRINT geAbweichungen$(geLies$("ref.txt"), JOIN$(z, CHR$(10)))
DIM rz AS ARRAY OF STRING : rz = []
DIM r AS kern.Rueckstich
FOR EACH r IN m.rueckstiche
    ARRAY_PUSH(rz, STR$(r.farbe))
NEXT
PRINT "rueckstiche hier: "; LEN(m.rueckstiche); " -> "; JOIN$(rz, " ")
DIM ok AS BOOLEAN : ok = v.zurueckNehmen(m)
m.stichzahlenNeu()
PRINT "rueckgaengig: "; m.farbanzahl(); " farben, "; LEN(m.rueckstiche); " rueckstiche, raster wie vorher "; rasterText$(m) = vorher
FUNCTION rasterText$(m AS kern.Muster) AS STRING
    DIM z AS ARRAY OF STRING : z = []
    DIM k AS INTEGER
    FOR k = 0 TO m.ebenen.anzahl() - 1
        ARRAY_PUSH(z, "ebene " + STR$(k) + " " + JOIN$(m.ebenen.ebenen[k].raster, " "))
        ARRAY_PUSH(z, "art " + STR$(k) + " " + JOIN$(m.ebenen.ebenen[k].art, " "))
    NEXT
    RETURN JOIN$(z, CHR$(10))
END FUNCTION
