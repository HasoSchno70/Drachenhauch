e 1 7 450 280 0 0
e 2 2 341 0 0 0
e 2 2 340 0 0 0
e 3 2 80 0 0 0
e 4 1 80 0 0 0
e 4 1 340 0 0 0
e 4 1 341 0 0 0
e 6 2 256 0 0 0
e 7 1 256 0 0 0
e 16 2 341 0 0 0
e 16 2 340 0 0 0
e 17 2 80 0 0 0
e 18 1 80 0 0 0
e 25 2 80 0 0 0
e 26 1 80 0 0 0
e 26 1 340 0 0 0

--- umgebung
DHRT_FRAMES=50
--- erwartet
folge offen@4 offen@5 offen@6 eigen@26

=== die palette nimmt die tasten dem textfeld darunter
' Ein Textfeld hat den Fokus; die Palette ist offen: Ruecktaste kuerzt die
' Suche, nicht den Text im Feld. Danach kommt der Fokus zurueck.
IMPORT "gui"
SCREEN(500, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 500, 300)
DIM mD AS INTEGER : mD = GUI_MENU(w, "Bearbeiten")
DIM a1 AS INTEGER : a1 = GUI_MENU_ITEM(mD, "Kopieren")
DIM a2 AS INTEGER : a2 = GUI_MENU_ITEM(mD, "Einfuegen")
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 20, 100, 200, 30)
GUI_SET_TEXT(tf, "Hallo")
GUI_FOCUS(tf)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER
FOR n = 1 TO 12
    IF n = 2 THEN
        GUI_PALETTE(TRUE)
        GUI_PALETTE_FILTER("kopx")
    END IF
    GUI_UPDATE()
    CLS(0) : GUI_DRAW() : FLIP()
NEXT
PRINT "feld "; GUI_TEXT(tf); " palette "; GUI_PALETTE_ITEMS$()
GUI_PALETTE(FALSE)
PRINT "fokus zurueck "; GUI_FOCUSED() = tf
--- datei ev.txt
c 3
e 1 7 450 280 0 0
e 4 2 259 0 0 0
e 5 1 259 0 0 0

--- umgebung
DHRT_FRAMES=20
--- erwartet
feld Hallo palette >Bearbeiten › Kopieren
fokus zurueck TRUE

=== ein klick neben die palette schliesst sie und erreicht nichts
IMPORT "gui"
SCREEN(500, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 500, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM mD AS INTEGER : mD = GUI_MENU(w, "Datei")
DIM a1 AS INTEGER : a1 = GUI_MENU_ITEM(mD, "Neu")
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "Unten", 10, 230, 120, 40)
GUI_PALETTE(TRUE)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER
DIM klicks AS INTEGER
FOR n = 1 TO 14
    GUI_UPDATE()
    IF GUI_CLICKED(b) THEN klicks = klicks + 1
    CLS(0) : GUI_DRAW() : FLIP()
NEXT
PRINT "offen "; GUI_PALETTE(); " klicks "; klicks
--- datei ev.txt
c 6
e 1 7 60 260 0 0
e 3 6 0 0 0 0
e 4 5 0 0 0 0
e 7 7 60 285 0 0
e 8 6 0 0 0 0
e 9 5 0 0 0 0

--- umgebung
DHRT_FRAMES=20
--- erwartet
offen FALSE klicks 1
