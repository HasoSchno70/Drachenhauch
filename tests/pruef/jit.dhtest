=== welche funktionen uebersetzt werden
' `dhrt --jit` nennt je Funktion "uebersetzt" oder den Grund, warum sie in
' der VM bleibt. Ohne diesen Fall bliebe die Sammlung auch gruen, wenn der
' Maschinencode still gar nichts mehr uebersetzte. Ein Bau ohne das Feature
' `jit` kennt den Schalter nicht und ueberspringt sich.
IMPORT "helfer.dh"
dlStarten(["--jit", "prog.dh"])
IF INSTR(dlAus, "uebersetzt") < 0 AND INSTR(dlAus, "VM:") < 0 THEN
    PRINT "UEBERSPRINGEN: Bau ohne Maschinencode"
ELSE
    PRINT dlAus
END IF
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- datei prog.dh
FUNCTION rein(a AS INTEGER, b AS FLOAT) AS FLOAT
    RETURN a * b
END FUNCTION
FUNCTION ruft(a AS INTEGER) AS FLOAT
    RETURN rein(a, 0.5) + 1
END FUNCTION
FUNCTION druckt(a AS INTEGER) AS INTEGER
    PRINT a
    RETURN a
END FUNCTION
FUNCTION ueber(a AS INTEGER) AS INTEGER
    RETURN druckt(a) + 1
END FUNCTION
FUNCTION text(a AS STRING) AS INTEGER
    RETURN LEN(a)
END FUNCTION
DIM g AS INTEGER
FUNCTION global_(a AS INTEGER) AS INTEGER
    RETURN a + g
END FUNCTION
PRINT ruft(3)

--- erwartet
rein: uebersetzt
ruft: uebersetzt
druckt: VM: Ausgabe (PRINT)
ueber: VM: ruft druckt, das in der VM bleibt
text: VM: Platz 0 hat den Typ 'string'
global_: VM: globale Variable
