=== nan vergleiche und gleichheit
FUNCTION nan() AS FLOAT
    DIM gross AS FLOAT
    DIM k AS INTEGER
    gross = 1.0
    FOR k = 1 TO 400
        gross = gross * 1000.0
    NEXT
    RETURN gross - gross
END FUNCTION
FUNCTION gleich(a AS FLOAT, b AS FLOAT) AS BOOLEAN
    RETURN a = b
END FUNCTION
FUNCTION ungleich(a AS FLOAT, b AS FLOAT) AS BOOLEAN
    RETURN a <> b
END FUNCTION
FUNCTION kleiner(a AS FLOAT, b AS FLOAT) AS BOOLEAN
    RETURN a < b
END FUNCTION
FUNCTION gemischt(a AS INTEGER, b AS FLOAT) AS BOOLEAN
    RETURN a = b AND a <= b AND NOT (a > b)
END FUNCTION
DIM x AS FLOAT : x = nan()
PRINT gleich(x, x); " "; ungleich(x, x); " "; gleich(2.0, 2.0); " "; gemischt(2, 2.0); " "; gemischt(2, 2.5)
TRY
    PRINT kleiner(x, 1.0)
CATCH e
    PRINT e
END TRY
--- erwartet
FALSE TRUE TRUE TRUE FALSE
Vergleich mit NaN

=== nan vergleiche und gleichheit (maschinencode)
FUNCTION nan() AS FLOAT
    DIM gross AS FLOAT
    DIM k AS INTEGER
    gross = 1.0
    FOR k = 1 TO 400
        gross = gross * 1000.0
    NEXT
    RETURN gross - gross
END FUNCTION
FUNCTION gleich(a AS FLOAT, b AS FLOAT) AS BOOLEAN
    RETURN a = b
END FUNCTION
FUNCTION ungleich(a AS FLOAT, b AS FLOAT) AS BOOLEAN
    RETURN a <> b
END FUNCTION
FUNCTION kleiner(a AS FLOAT, b AS FLOAT) AS BOOLEAN
    RETURN a < b
END FUNCTION
FUNCTION gemischt(a AS INTEGER, b AS FLOAT) AS BOOLEAN
    RETURN a = b AND a <= b AND NOT (a > b)
END FUNCTION
DIM x AS FLOAT : x = nan()
PRINT gleich(x, x); " "; ungleich(x, x); " "; gleich(2.0, 2.0); " "; gemischt(2, 2.0); " "; gemischt(2, 2.5)
TRY
    PRINT kleiner(x, 1.0)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_JIT=immer
--- erwartet
FALSE TRUE TRUE TRUE FALSE
Vergleich mit NaN

=== kommazahl in eine ganze zahl
FUNCTION halb(a AS INTEGER) AS INTEGER
    DIM h AS INTEGER
    h = a / 2
    RETURN h
END FUNCTION
FUNCTION rueck(a AS FLOAT) AS INTEGER
    RETURN a
END FUNCTION
PRINT halb(8); " "; rueck(3.0); " "; rueck(-0.0)
TRY
    PRINT halb(7)
CATCH e
    PRINT LEFT$(e, 45)
END TRY
TRY
    PRINT rueck(10000000000000000000.0)
CATCH e
    PRINT e
END TRY
--- erwartet
4 3 0
Lokale Variable: FLOAT 3.5 passt nicht verlus
RETURN: Ganzzahl-Ueberlauf bei 'Zuweisung' (INTEGER ist 64-bit; Wertebereich ueberschritten)

