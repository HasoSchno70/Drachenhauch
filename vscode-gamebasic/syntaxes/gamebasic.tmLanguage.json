{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameBasic",
  "scopeName": "source.gamebasic",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gamebasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.gamebasic",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.gamebasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gamebasic",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "constant.numeric.gamebasic",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.gamebasic",
          "match": "(?i)\\b(FALSE|TRUE)\\b"
        },
        {
          "name": "storage.type.gamebasic",
          "match": "(?i)\\b(COROUTINE|BOOLEAN|INTEGER|FUNCREF|STRING|ARRAY|SOUND|IMAGE|TUPLE|FLOAT|FILE|MAP|OF)\\b"
        },
        {
          "name": "keyword.declaration.gamebasic",
          "match": "(?i)\\b(PROPERTY|OPERATOR|FUNCTION|EXTENDS|STATIC|STRUCT|IMPORT|CLASS|CONST|BYREF|ENUM|SUB|DIM|AS)\\b"
        },
        {
          "name": "keyword.control.gamebasic",
          "match": "(?i)\\b(CONTINUE|RESTORE|REPEAT|SELECT|ELSEIF|RETURN|WHERE|YIELD|BREAK|INPUT|THROW|PRINT|CATCH|WHILE|UNTIL|ELIF|WEND|BAND|ELSE|NEXT|WITH|DATA|CASE|BXOR|BNOT|THEN|STEP|READ|FOR|NEW|SHL|BOR|END|NOT|AND|TRY|SHR|MOD|OR|TO|IN|IS|IF)\\b"
        },
        {
          "name": "support.function.dollar.gamebasic",
          "match": "(?i)\\b(READALL|REPLACE|REPEAT|FORMAT|SPLIT|LOWER|UPPER|INKEY|RIGHT|SPACE|LEFT|PADL|PADR|TRIM|JOIN|TIME|DATE|CHR|STR|MID|HEX)\\$"
        },
        {
          "name": "support.function.gamebasic",
          "match": "(?i)\\b(RENDERTARGET_BEGIN|ATLAS_DRAW_FLIPPED|__DICT_FROM_PAIRS|RENDERTARGET_DRAW|RENDERTARGET_END|DRAWIMAGEFLIPPED|RENDERTARGET_NEW|JOYSTICK_BUTTON|GENTEX_GRADIENT|TRIANGLEOUTLINE|SET_FULLSCREEN|SAVESCREENSHOT|POLYGONOUTLINE|JOYSTICK_COUNT|ELLIPSEOUTLINE|JOYSTICK_HAT_X|JOYSTICK_HAT_Y|GENTEX_CHECKED|SETWINDOWTITLE|CLIPBOARD_SET|GENTEX_PERLIN|QUITREQUESTED|DRAWIMAGEPART|ARRAY_INDEXOF|CLIPBOARD_GET|JOYSTICK_AXIS|JOYSTICK_NAME|FILES_DROPPED|GENTEX_COLOR|FILE_DROPPED|TEXT_SPACING|LAYER_DEFINE|SCREENHEIGHT|SHADER_SET3|TEXT_ITALIC|CORO_RESUME|__COMP_ITER|LAYER_CLEAR|MOUSEBUTTON|SHADER_LOAD|SHADER_SET2|CORO_RESULT|BATCH_FLUSH|__SET_DEDUP|TEXT_HEIGHT|LOAD_ASSETS|SCREENWIDTH|IMAGEHEIGHT|DRAWTILEMAP|TEXT_WIDTH|FILEEXISTS|BLEND_MODE|ATLAS_DRAW|IMAGEWIDTH|BATCH_DRAW|COLOR_LERP|MOUSEWHEEL|SHADER_SET|ATLAS_LOAD|CORO_CLOSE|KEYPRESSED|RANDOMIZE|STOPMUSIC|CORO_SEND|STOPSOUND|LOADIMAGE|DRAWIMAGE|WRITELINE|GRADIENTV|MAPVALUES|GRADIENTH|PLAYSOUND|CORO_DONE|PLAYMUSIC|LOADSOUND|TEXT_SIZE|LAYER_END|ENDOFFILE|RECTROUND|CLOSEFILE|TEXT_BOLD|MAPREMOVE|DIMCOUNT|COLLIDES|LOADFONT|OPENFILE|MAPCLEAR|BOXROUND|MAPITEMS|MAPGETOR|READLINE|TRIANGLE|POLYGON|READALL|MAPSIZE|REVERSE|SETFONT|ELLIPSE|REPLACE|DIMSIZE|SHUFFLE|MAPKEYS|RANDINT|CIRCLES|WAITKEY|CIRCLE|MAPHAS|SCROLL|MOUSEX|MILLIS|MAPGET|MAPPUT|MOUSEY|POSTFX|SCREEN|SETFPS|IS_NIL|SPLINE|CHOICE|RANGE|SPLIT|UPPER|SLEEP|PLOTS|TIMER|LAYER|HYPOT|BOXES|RIGHT|SPACE|LINEW|GREEN|LOWER|ATAN2|RANDF|REMAP|DELTA|FLOOR|ROUND|CLAMP|LINES|INSTR|WRITE|PADL|ASIN|ACOS|RECT|TEXT|CEIL|PLOT|LERP|DATE|LEFT|SIGN|PADR|TRIM|LINE|BLUE|FRAC|FLIP|JOIN|TIME|SORT|ATAN|FPS|POW|LEN|HSV|RED|EXP|CHR|LOG|VAL|MAX|RGB|STR|TAN|MIN|ASC|SIN|ABS|COS|RAD|RND|SQR|BOX|MID|HEX|ARC|DEG|CLS|INT)\\b"
        },
        {
          "name": "constant.language.gamebasic",
          "match": "(?i)\\b(JOY_BUTTON_RSTICK|JOY_BUTTON_LSTICK|JOY_BUTTON_START|JOY_BUTTON_BACK|JOY_DPAD_RIGHT|KEY_BACKSPACE|JOY_DPAD_LEFT|JOY_BUTTON_LB|JOY_DPAD_DOWN|JOY_BUTTON_RB|JOY_BUTTON_B|JOY_BUTTON_A|JOY_BUTTON_X|JOY_BUTTON_Y|JOY_DPAD_UP|KEY_ESCAPE|KEY_RETURN|KEY_ENTER|LIGHTGRAY|KEY_SPACE|DARKGREEN|KEY_RIGHT|KEY_LEFT|KEY_DOWN|DARKBLUE|DARKGRAY|KEY_F12|KEY_TAB|KEY_F10|DARKRED|MAGENTA|KEY_F11|KEY_F7|KEY_F3|YELLOW|KEY_F1|ORANGE|KEY_F5|KEY_UP|KEY_F9|KEY_F6|KEY_F2|PURPLE|KEY_F4|KEY_F8|KEY_C|KEY_L|KEY_0|KEY_S|KEY_G|WHITE|KEY_6|KEY_F|KEY_T|BROWN|KEY_H|KEY_5|BLACK|KEY_I|KEY_O|KEY_4|KEY_K|KEY_M|KEY_2|KEY_7|KEY_Z|KEY_R|KEY_X|KEY_3|KEY_N|KEY_B|KEY_9|GREEN|KEY_E|KEY_Y|KEY_A|KEY_Q|KEY_U|KEY_W|KEY_J|KEY_D|KEY_V|KEY_1|KEY_8|KEY_P|BLUE|PINK|CYAN|GRAY|RED|PI)\\b"
        },
        {
          "name": "keyword.operator.gamebasic",
          "match": "<=|>=|<>|[-+*/\\\\=<>^]"
        }
      ]
    }
  }
}
