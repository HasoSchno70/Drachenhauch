DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
' eine Datei mit zwei Unterprogrammen
DIM x AS INTEGER
x = 1

SUB erstes()
    PRINT 1
END SUB

SUB zweites()
    PRINT 2
END SUB
--- erwartet
