=== mehrfach aufgeben geht auf die vm ueber
FUNCTION heikel(a AS INTEGER) AS INTEGER
    RETURN 100 \ a
END FUNCTION
DIM i AS INTEGER
DIM fehler AS INTEGER
DIM summe AS INTEGER
FOR i = -12 TO 12
    TRY
        summe = summe + heikel(i MOD 3)
    CATCH e
        fehler = fehler + 1
    END TRY
NEXT
PRINT summe; " "; fehler
--- erwartet
