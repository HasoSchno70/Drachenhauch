' Ein Rezept kochen -- wie CookRecipeDialog der Python-App: Portionen
' wählen (die Mengen rechnen mit), je Zutat benötigt, vorhanden, Status und
' was fehlt; „Fehlende einkaufen“ und „Jetzt kochen!“ (zieht vom Bestand ab,
' was am frühesten abläuft zuerst -- ein Schritt für Strg+Z).
CLASS KochenFenster EXTENDS KochenFenster_Basis
    DIM rezeptId AS INTEGER
    DIM x AS Rezept
    DIM geaendert AS BOOLEAN

    SUB Geoeffnet()
        Self.x = rezeptLaden(Self.rezeptId)
        IF Self.x IS NIL THEN
            Self.Zumachen()
            RETURN
        END IF
        DIM l AS ARRAY OF Rezept : l = [Self.x]
        kochbarkeitRechnen(l)
        GUI_SET_TEXT(Self.titel, "🍳 " + Self.x.name)
        GUI_SET_TEXT(Self.zeiten, "⏱ Vorbereitung: " + STR$(Self.x.vorb) + " min | Kochzeit: " + STR$(Self.x.koch) + " min")
        DIM p AS FLOAT : p = Self.x.prozent
        GUI_SET_TEXT(Self.anteil, IIF(p >= 100, "✅ ", IIF(p >= 75, "⚠ ", "❌ ")) + STR$(INT(p + 0.5)) + " %")
        GUI_SET_COLOR(Self.anteil, "fg", IIF(p >= 100, &H81C784, IIF(p >= 75, &HFFB74D, &HE57373)))
        GUI_SET_VALUE(Self.portionenFeld, MAX(1, Self.x.portionen))
        GUI_SET_TEXT(Self.original, "(Original: " + STR$(Self.x.portionen) + ")")
        Self.tabelleFuellen()
    END SUB

    FUNCTION faktor() AS FLOAT
        RETURN GUI_VALUE(Self.portionenFeld) / MAX(1, Self.x.portionen)
    END FUNCTION

    SUB tabelleFuellen()
        DIM f AS FLOAT : f = Self.faktor()
        GUI_SET_TEXT(Self.faktorText, "×" + REPLACE$(FORMAT$(f, "%.1f"), ".", ","))
        GUI_TABLE_CLEAR(Self.tabelle)
        DIM fehlt AS INTEGER : fehlt = 0
        DIM teil AS INTEGER : teil = 0
        DIM verknuepft AS INTEGER : verknuepft = 0
        DIM z AS Zutat
        FOR EACH z IN Self.x.zutaten
            DIM braucht AS FLOAT : braucht = z.menge * f
            DIM da AS FLOAT : da = verfuegbar(z)
            DIM status AS STRING
            DIM diff AS STRING : diff = ""
            DIM farbe AS INTEGER
            IF da >= braucht THEN
                status = "✅ OK" : farbe = &H81C784
            ELSEIF da > 0 THEN
                status = "⚠ Teilweise" : farbe = &HFFB74D
                diff = "-" + zahlText$(braucht - da)
                teil = teil + 1
            ELSE
                status = "❌ Fehlt" : farbe = &HE57373
                diff = "-" + zahlText$(braucht)
                fehlt = fehlt + 1
            END IF
            IF z.produktId > 0 THEN verknuepft = verknuepft + 1
            DIM r AS INTEGER : r = GUI_TABLE_ADD_ROW(Self.tabelle, [IIF(z.produktId > 0, "🔗 ", "") + z.name, zahlText$(braucht) + " " + z.einheit, IIF(da > 0, zahlText$(da) + " " + z.einheit, "-"), status, diff])
            GUI_TABLE_CELL_COLOR(Self.tabelle, r, 3, farbe, -1)
            IF diff <> "" THEN GUI_TABLE_CELL_COLOR(Self.tabelle, r, 4, &HE57373, -1)
        NEXT
        DIM n AS INTEGER : n = LEN(Self.x.zutaten)
        IF fehlt = 0 AND teil = 0 THEN
            GUI_SET_TEXT(Self.status, "✅ Perfekt! Alle " + STR$(n) + " Zutaten sind ausreichend vorhanden. Du kannst sofort mit dem Kochen beginnen!")
            GUI_SET_TEXT(Self.info, "👨‍🍳 Bereit zum Kochen!")
        ELSEIF fehlt > 0 THEN
            GUI_SET_TEXT(Self.status, "⚠ Achtung: " + STR$(fehlt) + " Zutat(en) fehlen komplett, " + STR$(teil) + " teilweise vorhanden. Du kannst trotzdem kochen oder erst einkaufen gehen.")
            GUI_SET_TEXT(Self.info, "🛒 " + STR$(fehlt + teil) + " Zutat(en) fehlen")
        ELSE
            GUI_SET_TEXT(Self.status, "🟡 Fast komplett: " + STR$(teil) + " Zutat(en) sind nur teilweise vorhanden. Du kannst trotzdem kochen (evtl. kleinere Portionen).")
            GUI_SET_TEXT(Self.info, "🟡 " + STR$(teil) + " Zutat(en) teilweise")
        END IF
        IF verknuepft > 0 THEN GUI_SET_TEXT(Self.info, GUI_TEXT(Self.info) + " | 🔗 " + STR$(verknuepft) + " verknüpft")
        GUI_SET_VISIBLE(Self.knopfEinkaufen, fehlt + teil > 0)
    END SUB

    SUB portionenFeld_Geaendert()
        Self.tabelleFuellen()
    END SUB

    SUB knopfEinkaufen_Klick()
        DIM n AS INTEGER : n = fehlendeEinkaufen(Self.x, Self.faktor())
        IF n > 0 THEN
            Self.geaendert = TRUE
            Meldung(STR$(n) + " fehlende Zutat(en) auf die Einkaufsliste gesetzt.", "Einkaufsliste")
        ELSE
            Meldung("Alle Zutaten sind vorhanden.", "Einkaufsliste")
        END IF
    END SUB

    SUB knopfKochen_Klick()
        DIM p AS INTEGER : p = INT(GUI_VALUE(Self.portionenFeld))
        IF Frage("Möchtest du „" + Self.x.name + "“ für " + STR$(p) + " Portionen kochen?" + CHR$(10) + CHR$(10) + "Die vorhandenen Zutaten werden vom Bestand abgezogen.", "Kochen|Abbrechen", "Kochen bestätigen") <> 1 THEN RETURN
        DIM weg AS ARRAY OF STRING : weg = kochen(Self.x, Self.faktor())
        Self.geaendert = TRUE
        IF LEN(weg) > 0 THEN
            Meldung("„" + Self.x.name + "“ wurde gekocht!" + CHR$(10) + CHR$(10) + "Vom Bestand abgezogen:" + CHR$(10) + "  • " + JOIN$(weg, CHR$(10) + "  • ") + CHR$(10) + CHR$(10) + "🍽 " + STR$(p) + " Portion(en) zubereitet", "Guten Appetit!")
        ELSE
            Meldung("„" + Self.x.name + "“ wurde gekocht!" + CHR$(10) + CHR$(10) + "Keine Zutaten im Bestand gefunden, die abgezogen werden konnten.", "Guten Appetit!")
        END IF
        Self.Zumachen()
    END SUB

    SUB knopfAbbrechen_Klick()
        Self.Zumachen()
    END SUB
END CLASS
