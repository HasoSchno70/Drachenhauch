=== ein doppelklick auf den schwebenden kopf dockt wieder an
IMPORT "hilfe.dh"
GUI_DOCK_FLOAT(w, "ausgabe", 300, 100, 300, 200)
daVerteilen()
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN daVerteilen()
    bild = bild + 1
    IF bild = 3 THEN
        PRINT "vorher "; GUI_DOCK_WHERE$(w, "ausgabe")
        dmDoppel(300 + 300 - 30, 100 + 11)
        dmSpielen()
    END IF
    IF bild = 30 THEN
        PRINT "nachher "; GUI_DOCK_WHERE$(w, "ausgabe")
        EXIT(0)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei hilfe.dh
