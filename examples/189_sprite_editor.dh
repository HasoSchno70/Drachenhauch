DIM bNeu AS GUI_WIDGET   : bNeu   = GUI_BUTTON(win, "Neu", 10, 7, 62, 32)
DIM bPng AS GUI_WIDGET   : bPng   = GUI_BUTTON(win, "PNG", 76, 7, 62, 32)
DIM bBlatt AS GUI_WIDGET : bBlatt = GUI_BUTTON(win, "Streifen + Atlas", 142, 7, 150, 32)

CONST WZ_B = 88
