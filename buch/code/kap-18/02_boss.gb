' Boss-Klasse mit drei Phasen, Konsolen-Simulation der HP-Reduktion.
'
' Phase wechselt automatisch beim TakeHit:
'   hp >= 50%     -> Phase 1 (langsam)
'   hp >= 20%     -> Phase 2 (schneller)
'   hp <  20%     -> Phase 3 (panisch)
'
' Im Spiel beeinflussen die Phasen Bewegungs-Tween + Farbe. Hier nur
' die Logik isoliert.

CLASS Boss
    DIM x       AS INTEGER
    DIM y       AS INTEGER
    DIM hp      AS INTEGER
    DIM hp_max  AS INTEGER
    DIM phase   AS INTEGER
    DIM alive   AS BOOLEAN

    SUB Init(start_hp AS INTEGER)
        x = 160
        y = 30
        hp = start_hp
        hp_max = start_hp
        phase = 1
        alive = TRUE
    END SUB

    SUB TakeHit()
        IF NOT alive THEN RETURN
        hp = hp - 1
        IF hp <= 0 THEN
            alive = FALSE
            RETURN
        END IF
        UpdatePhase()         ' impliziter Methoden-Aufruf, dank Kap 12-Erweiterung
    END SUB

    SUB UpdatePhase()
        ' Float-Vergleich, sonst rundet INTEGER-Division 5/30 zu 0.
        DIM ratio AS FLOAT
        ratio = (hp + 0.0) / hp_max
        IF ratio < 0.2 THEN
            phase = 3
        ELSEIF ratio < 0.5 THEN
            phase = 2
        ELSE
            phase = 1
        END IF
    END SUB
END CLASS

DIM b AS Boss
b = NEW Boss(30)
PRINT f"Anfang: HP {b.hp}/{b.hp_max}, Phase {b.phase}"

' 30 Treffer simulieren, Phasen-Wechsel anzeigen
DIM last_phase AS INTEGER
last_phase = b.phase

DIM i AS INTEGER
FOR i = 1 TO 30
    b.TakeHit()
    IF b.phase <> last_phase THEN
        PRINT f"  Treffer {i}: HP {b.hp} -> Phase {b.phase}"
        last_phase = b.phase
    END IF
    IF NOT b.alive THEN
        PRINT f"  Treffer {i}: HP 0 -> Boss tot!"
        BREAK
    END IF
NEXT i
