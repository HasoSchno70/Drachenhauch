=== ein klick oben im hauptfenster oeffnet nicht die menueleiste eines nativen fensters
' Das native Fenster steht auf seiner Flaeche bei (0, 0) -- seine Menueleiste
' "Datei" liegt dort, wo im Hauptfenster oben links frei ist. Ohne den Filter
' nach Oberflaechen oeffnete ein Klick bei (25, 8) im Hauptfenster sie: das
' Menue ging IM nativen Fenster auf (Pixel bei 30, 32 dort vorher und
' nachher). Den Eintrag traf erst der naechste Klick nicht mehr, weil er
' fremde Popups schliesst -- darum misst der Fall das Bild, nicht den Klick.
IMPORT "helfer.dh"
DIM kennung AS STRING : kennung = "Leiste-" + STR$(MILLIS()) + "-" + STR$(INT(RND() * 1000000))
DIM kind AS INTEGER : kind = PROCESS_START("dhrt", "run", CWD$() + "/menue.dh", "--", kennung, "leiste")
DIM vorher AS STRING : vorher = ps$("fensterpixel.ps1", "Leiste-" + kennung, "30,32")
DIM s AS STRING : s = ps$("fenstersender.ps1", kennung, "roh:512:0:524313;roh:513:1:524313;roh:514:0:524313")
DIM nachher AS STRING : nachher = ps$("fensterpixel.ps1", "Leiste-" + kennung, "30,32")
DIM k AS STRING : k = auslesen$(kind, 30000)
IF INSTR(auslesenFehler, "Kein Fenster moeglich") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    END
END IF
PRINT "gelesen "; INSTR(vorher, "30,32 #") >= 0 AND INSTR(nachher, "30,32 #") >= 0
PRINT "leiste zu "; TRIM$(vorher) = TRIM$(nachher)
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fenstersender.ps1"
END FUNCTION
FUNCTION ps$(skriptname AS STRING, a AS STRING, b AS STRING) AS STRING
    DIM p AS INTEGER : p = PROCESS_START("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{sammlung}/../_hilfen/" + skriptname, a, b)
    RETURN auslesen$(p, 30000)
END FUNCTION
