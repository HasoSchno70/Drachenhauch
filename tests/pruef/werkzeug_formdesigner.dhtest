=== inspektor schreibt umbenennen und leer-hinweis
' Liste: das Kaestchen "Umbenennen mit F2" setzt list.bearbeitbar und nimmt
' es beim Abwaehlen wieder HERAUS. Tabelle: das Feld "Leer-Hinweis" setzt
' table.leer_text, leer entfernt es. Dazwischen liest der Inspektor den
' Stand zurueck (Kaestchen gesetzt, Feld gefuellt).
auswahl = 0
inspektorFuellen()
PRINT "liste sichtbar "; GUI_VISIBLE(cbUmbenennen); " leer sichtbar "; GUI_VISIBLE(aLeer)
GUI_SET_CHECKED(cbUmbenennen, TRUE)
inspektorUebernehmen()
PRINT JSON_STRINGIFY(teilbaum(doc, "widgets.0.list"))
inspektorFuellen()
PRINT "zurueck "; GUI_CHECKED(cbUmbenennen)
GUI_SET_CHECKED(cbUmbenennen, FALSE)
inspektorUebernehmen()
PRINT "ab "; JSON_HAS(doc, "widgets.0.list.bearbeitbar")
auswahl = 1
inspektorFuellen()
PRINT "tabelle sichtbar "; GUI_VISIBLE(aLeer); " liste sichtbar "; GUI_VISIBLE(cbUmbenennen)
GUI_SET_TEXT(aLeer, "Keine Treffer")
inspektorUebernehmen()
PRINT JSON_GET_STRING(doc, "widgets.1.table.leer_text")
inspektorFuellen()
PRINT "feld "; GUI_TEXT(aLeer)
GUI_SET_TEXT(aLeer, "")
inspektorUebernehmen()
PRINT "leer "; JSON_HAS(doc, "widgets.1.table.leer_text")
EXIT(0)
