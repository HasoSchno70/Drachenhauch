            END IF
        WEND
    NEXT
    DIM t AS STRING : t = "# Test-Aufnahme" + CHR$(10) + "c " + STR$(LEN(prF)) + CHR$(10)
    FOR i = 0 TO LEN(prF) - 1
        t = t + "e " + STR$(prF[i]) + " " + prZ[i] + CHR$(10)
    NEXT
    WRITEALL("ev.txt", t)
    AUTOMATION_PLAY("ev.txt")
    prStart = prBild
END SUB
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
SUB prFall()
    prKlick(3, GUI_GET_X(bEbNeu) + 40, GUI_GET_Y(bEbNeu) + 14)
    prKlick(10, GUI_GET_X(bEbHinten) + 60, GUI_GET_Y(bEbHinten) + 14)
    prKlick(16, GUI_GET_X(bEbVorne) + 60, GUI_GET_Y(bEbVorne) + 14)
    prKlick(24, GUI_GET_X(bCode) + 52, GUI_GET_Y(bCode) + 16)
    prAbspielen()
END SUB
SUB prProbe()
    prSchreib("ebene " + STR$(ebene))
END SUB
