=== drucklage, linienart und enden in den einstellungen
IMPORT "helfer.dh"
' Die Drucklage (PySticky _on_print): 5 % der Seitenbreite Rand, mittig
DIM z AS FLOAT, x AS FLOAT, y AS FLOAT
DIM g AS ARRAY OF INTEGER
FOR EACH g IN [[14, 8], [8, 14], [100, 100], [1, 1], [300, 20]]
    (z, x, y) = kern.druckLage(g[0], g[1], 595.0, 842.0)
    PRINT g[0]; "x"; g[1]; ": zelle "; FORMAT$(z, "%.3f"); " links "; FORMAT$(x, "%.3f"); " oben "; FORMAT$(y, "%.3f"); " | quer "; kern.druckQuer(g[0], g[1])
NEXT
' Linienart und Enden: gemerkt und geklemmt
DIM e AS kern.Einstellungen : e = NEW kern.Einstellungen()
PRINT "vorgabe: linie "; e.rueckLinie; " enden "; e.rueckKappe
e.rueckLinie = 3 : e.rueckKappe = 2
WRITEALL("e.json", kern.einstellungenJson$(e))
DIM l AS kern.Einstellungen : l = kern.einstellungenLaden("e.json")
PRINT "gemerkt: "; l.rueckLinie; " "; l.rueckKappe
WRITEALL("krumm.json", "{" + CHR$(34) + "backstitch_line_style" + CHR$(34) + ": 9, " + CHR$(34) + "backstitch_cap_style" + CHR$(34) + ": -4}")
l = kern.einstellungenLaden("krumm.json")
PRINT "geklemmt: "; l.rueckLinie; " "; l.rueckKappe
