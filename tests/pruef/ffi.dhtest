DECLARE FUNCTION Bytes LIB "kernel32" ALIAS "lstrlenA" (s AS CSTR) AS LONG
' Fuenf Zeichen, aber sieben Bytes in UTF-8.
PRINT lstrlenW("Grüße"), Bytes("Grüße")
PRINT lstrlenW(""), Bytes("abc")
