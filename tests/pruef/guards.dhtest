cmd = "delete"

SELECT CASE cmd
    CASE "delete" WHERE tag IN ("admin", "moderator")
        PRINT "OK"
    CASE "delete"
        PRINT "Permission denied"
END SELECT
--- erwartet
OK

=== guard uses subject indirectly (1)
' Subject-Wert kann in Guard via gleichnamige Variable benutzt werden.
DIM n AS INTEGER
n = 50

SELECT CASE n
    CASE 1 TO 100 WHERE n MOD 2 = 0
        PRINT "gerade in 1-100"
    CASE 1 TO 100
        PRINT "ungerade in 1-100"
END SELECT
--- erwartet
gerade in 1-100

=== guard uses subject indirectly (2)
' Subject-Wert kann in Guard via gleichnamige Variable benutzt werden.
DIM n AS INTEGER
n = 50

SELECT CASE n
    CASE 1 TO 100 WHERE n MOD 2 = 0
        PRINT "gerade in 1-100"
    CASE 1 TO 100
        PRINT "ungerade in 1-100"
END SELECT
--- erwartet
gerade in 1-100

=== guard else still runs when no case matches (1)
' CASE ELSE bleibt unbeeinflusst -- laeuft, wenn weder Match noch
DIM x AS INTEGER
x = 999

SELECT CASE x
    CASE 1, 2, 3 WHERE TRUE
        PRINT "small"
    CASE 100, 200 WHERE TRUE
        PRINT "med"
    CASE ELSE
        PRINT "fallback"
END SELECT
--- erwartet
fallback

