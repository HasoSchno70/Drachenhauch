' Kapitel 24, was schiefgehen kann: Grad, wo Bogenmass hingehoert. Vier
' Fluegel, jeder um 90 weitergedreht -- MAT4_ROTATE_Z rechnet aber im
' Bogenmass.
IMPORT "g3d"
IMPORT "m3d"
SCREEN(800, 500, "Grad und Bogenmass")
DIM fluegel AS INTEGER : fluegel = MESH_CUBE(0.5, 3.4, 0.08)
WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE)
    CLS(RGB(185, 210, 235))
    CAMERA3D(0, 0, 12, 0, 0, 0, 45)
    DIM k AS INTEGER
    FOR k = 0 TO 3
        DIM f AS MAT4
        f = MAT4_MUL(MAT4_ROTATE_Z(k * 90), MAT4_TRANSLATE(0, 1.9, 0))
        MODEL_MATRIX(fluegel, f, RGB(120, 90, 70))
    NEXT
    FLIP()
WEND
