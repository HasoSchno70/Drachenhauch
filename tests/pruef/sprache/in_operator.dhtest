allowed

=== in in select case (1)
' `x IN (...)` als Bedingung in IF/SELECT funktioniert.
DIM x AS INTEGER
x = 3
IF x IN (1, 2, 3) THEN
    PRINT "small"
ELIF x IN (4, 5, 6) THEN
    PRINT "medium"
ELSE
    PRINT "large"
END IF
--- erwartet
small

=== in in select case (2)
' `x IN (...)` als Bedingung in IF/SELECT funktioniert.
DIM x AS INTEGER
x = 3
IF x IN (1, 2, 3) THEN
    PRINT "small"
ELIF x IN (4, 5, 6) THEN
    PRINT "medium"
ELSE
    PRINT "large"
END IF
--- erwartet
small

=== in string needle not string throws (1)
' `5 IN "abc"` -- Mismatch, Needle muss String sein.
PRINT 5 IN "abc"
--- fehler
IN bei STRING: linke Seite muss STRING sein, erhalten INTEGER

=== in string needle not string throws (2)
' `5 IN "abc"` -- Mismatch, Needle muss String sein.
PRINT 5 IN "abc"
--- fehler
IN bei STRING: linke Seite muss STRING sein, erhalten INTEGER

=== in map non string key throws (1)
DIM m AS MAP OF INTEGER
m.put("a", 1)
PRINT 5 IN m
--- fehler
IN bei MAP: Key muss STRING sein, erhalten INTEGER

=== in map non string key throws (2)
DIM m AS MAP OF INTEGER
m.put("a", 1)
PRINT 5 IN m
--- fehler
IN bei MAP: Key muss STRING sein, erhalten INTEGER

=== in unsupported type throws (1)
' `5 IN 42` -- weder String, Tuple, Array, noch Map -> Fehler.
PRINT 5 IN 42
--- fehler
IN: rechte Seite muss STRING, TUPLE, ARRAY oder MAP sein, erhalten INTEGER

=== in unsupported type throws (2)
' `5 IN 42` -- weder String, Tuple, Array, noch Map -> Fehler.
PRINT 5 IN 42
--- fehler
IN: rechte Seite muss STRING, TUPLE, ARRAY oder MAP sein, erhalten INTEGER

=== in chained in complex expression (1)
' IN kombiniert mit AND/OR.
DIM x AS INTEGER
x = 5
IF x > 0 AND x IN (1, 5, 9) THEN PRINT "match"
--- erwartet
match

=== in chained in complex expression (2)
' IN kombiniert mit AND/OR.
DIM x AS INTEGER
x = 5
IF x > 0 AND x IN (1, 5, 9) THEN PRINT "match"
