' Wellenlinien im Textbereich (GUI_TEXTAREA_SQUIGGLES) und die Stellen, die
' CODE_CHECK$ dafuer nennt (spalte, laenge). Die Linie wird am Bild
' gezaehlt: rote Punkte in einem Streifen unter der ersten Zeile, mit
' Gegenprobe im selben Lauf.

=== die wellenlinie steht unter dem abschnitt
IMPORT "gui"
SCREEN(400, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_THEME_PRESET("dark")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 0, 0, 380, 180)
GUI_SET_TEXT(ta, "PRINT hallo welt")
FUNCTION rote(x0 AS INTEGER, x1 AS INTEGER) AS INTEGER
    DIM f AS INTEGER
    FOR f = 1 TO 2
        GUI_UPDATE() : CLS(BLACK) : GUI_DRAW() : FLIP()
    NEXT
    SAVESCREENSHOT("bild.png")
    DIM b AS IMAGE : b = LOADIMAGE("bild.png")
    DIM n AS INTEGER : n = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 5 TO 30
        FOR x = x0 TO x1
            DIM c AS INTEGER : c = GETPIXEL(b, x, y)
            IF ((c SHR 16) BAND 255) > 200 AND ((c SHR 8) BAND 255) < 90 THEN n = n + 1
        NEXT
    NEXT
    IMAGE_FREE(b)
    DELETEFILE("bild.png")
    RETURN n
END FUNCTION
' "hallo" = Zeichen 6..10
GUI_TEXTAREA_SQUIGGLES(ta, [6], [5], [&HFF3030])
DIM unter AS INTEGER : unter = rote(0, 379)
PRINT "unter hallo "; unter > 5
' Nur unter "hallo", nicht unter "PRINT": links davon keine roten Punkte.
PRINT "links frei "; rote(0, 40) = 0
GUI_TEXTAREA_SQUIGGLES(ta, [], [], [])
PRINT "geloescht "; rote(0, 379)
--- umgebung
DHRT_FRAMES=30
--- erwartet
unter hallo TRUE
links frei TRUE
geloescht 0

=== eine aenderung am text nimmt sie weg
IMPORT "gui"
SCREEN(400, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 0, 0, 380, 180)
GUI_SET_TEXT(ta, "PRINT x")
GUI_TEXTAREA_SQUIGGLES(ta, [6], [1], [&HFF0000])
GUI_SET_TEXT(ta, "PRINT y")
PRINT "ok"
--- umgebung
DHRT_FRAMES=2
--- erwartet
ok

=== nur fuer textbereiche
IMPORT "gui"
SCREEN(200, 100, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 200, 100)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w, "x", 10, 10, 50, 20)
GUI_TEXTAREA_SQUIGGLES(k, [0], [1], [RED])
--- umgebung
DHRT_FRAMES=2
--- fehler
GUI_TEXTAREA_SQUIGGLES: das Widget ist kein GUI_TEXTAREA

=== code check nennt die stelle
' Eine Warnung mit genanntem Namen zeigt auf dessen erstes Vorkommen als
' ganzes Wort; ein Syntaxfehler auf seine Spalte.
IMPORT "json"
DIM NL AS STRING : NL = CHR$(10)
DIM j AS JSON_HANDLE
j = JSON_PARSE(CODE_CHECK$("DIM zaehler AS INTEGER" + NL + "  zaehlr = zaehler + 1" + NL))
PRINT JSON_GET_INT(j, "0.zeile"); " "; JSON_GET_INT(j, "0.spalte"); " "; JSON_GET_INT(j, "0.laenge")
j = JSON_PARSE(CODE_CHECK$("PRINT 1" + NL + "DIM x AS" + NL))
PRINT JSON_GET_INT(j, "0.zeile"); " "; JSON_GET_INT(j, "0.spalte"); " "; JSON_GET_INT(j, "0.laenge")
--- erwartet
2 3 6
2 7 2
