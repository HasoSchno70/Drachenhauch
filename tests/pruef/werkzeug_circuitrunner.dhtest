=== zeitbonus im getimten level
' Mit Zeitlimit ist der Bestwert die VERBLIEBENE Zeit, hoeher ist besser.
IMPORT "circuit.dh"
DIM prOben AS ARRAY OF INTEGER : prOben = prLeer()
DIM prUnten AS ARRAY OF INTEGER : prUnten = prLeer()
prOben[1 * 32 + 1] = &H6C
prOben[5 * 32 + 5] = &H15
DIM prH AS JSON_HANDLE : prH = prSet("Timed")
prLevel(prH, "T", 1, 200, "", "ABCD", prOben, prUnten, "")
prSchreiben(prH)
js = JSON_LOAD(prSynth$())
nlevels = JSON_LEN(js, "levels")
cur_setkey = set_key("Timed")
cur_level = 0
load_level(0)
start_ms = MILLIS() - 30000
record_win()
DIM prB1 AS INTEGER : prB1 = best_for(0)
DIM prR1 AS BOOLEAN : prR1 = new_record
start_ms = MILLIS() - 50000
record_win()
DIM prB2 AS INTEGER : prB2 = best_for(0)
DIM prR2 AS BOOLEAN : prR2 = new_record
start_ms = MILLIS() - 10000
record_win()
DIM prB3 AS INTEGER : prB3 = best_for(0)
DIM prR3 AS BOOLEAN : prR3 = new_record
PRINT "170 uebrig: " + STR$(prB1 >= 169 AND prB1 <= 171) + " rekord " + STR$(prR1)
PRINT "150 ist schlechter: " + STR$(prB2 = prB1) + " rekord " + STR$(prR2)
PRINT "190 ist besser: " + STR$(prB3 >= 189 AND prB3 <= 191) + " rekord " + STR$(prR3)
EXIT(0)
