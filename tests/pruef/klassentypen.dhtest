=== der fehler laesst sich fangen
CLASS Tier
END CLASS
CLASS Auto
END CLASS
DIM t AS Tier
TRY
    t = NEW Auto()
CATCH e
    PRINT "gefangen"
END TRY
PRINT t IS NIL
--- erwartet
gefangen
TRUE

=== im maschinencode wie in der vm
' Eine Schleife, die ein Objekt in einen Platz vom Typ einer Klasse legt,
' laeuft im Maschinencode (Wertemodus). Beim falschen Objekt steigt er aus,
' und die VM meldet denselben Fehler.
CLASS Form
    DIM n AS INTEGER
END CLASS
CLASS Auto
END CLASS
DIM teile AS ARRAY OF Form : teile = []
DIM i AS INTEGER
FOR i = 1 TO 50
    DIM f AS Form : f = NEW Form() : f.n = i
    ARRAY_PUSH(teile, f)
NEXT
FUNCTION summe(xs AS ARRAY OF Form) AS INTEGER
    DIM s AS INTEGER : s = 0
    DIM g AS Form
    DIM j AS INTEGER
    FOR j = 0 TO LEN(xs) - 1
        g = xs[j]
        s = s + g.n
    NEXT
    RETURN s
END FUNCTION
PRINT summe(teile)
DIM falsch AS Form
DIM k AS INTEGER
FOR k = 1 TO 100
    IF k = 60 THEN
        falsch = NEW Auto()
    ELSE
        falsch = NEW Form()
    END IF
NEXT
--- fehler
Erwartet FORM (oder eine Unterklasse), erhalten AUTO

=== im maschinencode wie in der vm ohne maschinencode
CLASS Form
    DIM n AS INTEGER
END CLASS
CLASS Auto
END CLASS
DIM falsch AS Form
DIM k AS INTEGER
FOR k = 1 TO 100
    IF k = 60 THEN
        falsch = NEW Auto()
    ELSE
        falsch = NEW Form()
    END IF
NEXT
--- umgebung
DHRT_JIT=aus
--- fehler
Erwartet FORM (oder eine Unterklasse), erhalten AUTO

=== check warnt bei sicher falschen klassen
IMPORT "json"
' dhrt --check als Kind; jede Zusage fragt die Meldungstexte.
FUNCTION lesen$(pc AS INTEGER) AS STRING
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM r AS STRING : r = ""
    DIM stille AS INTEGER : stille = 0
    WHILE MILLIS() < bis AND stille < 5
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN r = r + zz : stille = 0
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
    WEND
    RETURN r
END FUNCTION
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", "w.dh")
DIM roh AS STRING : roh = TRIM$(lesen$(pc))
IF roh = "" THEN roh = "[]"
DIM h AS JSON_HANDLE : h = JSON_PARSE("{" + CHR$(34) + "b" + CHR$(34) + ":" + roh + "}")
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(h, "b") - 1
    PRINT JSON_GET_INT(h, "b." + STR$(i) + ".line"); ": "; JSON_GET_STRING(h, "b." + STR$(i) + ".message")
NEXT
--- datei w.dh
CLASS Tier
END CLASS
CLASS Hund EXTENDS Tier
END CLASS
CLASS Auto
    DIM besitzer AS Tier
END CLASS
SUB zeige(t AS Tier)
END SUB
FUNCTION gib() AS Tier
    RETURN NEW Auto()
END FUNCTION
DIM t AS Tier
t = NEW Auto()
zeige(5)
DIM w AS Auto : w = NEW Auto()
w.besitzer = "Rex"
--- erwartet
11: Diese Funktion ist als TIER angesagt, hier steht AUTO hinter RETURN. Das bricht beim Laufen ab ('Erwartet TIER (oder eine Unterklasse), erhalten AUTO').
14: 't' ist als TIER angesagt, rechts steht AUTO. Das bricht beim Laufen ab ('Erwartet TIER (oder eine Unterklasse), erhalten AUTO').
15: zeige: Parameter 't' ist als TIER angesagt, hier steht INTEGER. Das bricht beim Laufen ab ('Erwartet TIER (oder eine Unterklasse), erhalten INTEGER').
17: 'w.besitzer' ist als TIER angesagt, rechts steht STRING. Das bricht beim Laufen ab ('Erwartet TIER (oder eine Unterklasse), erhalten STRING').

=== check schweigt bei verwandten klassen und nil
IMPORT "json"
FUNCTION lesen$(pc AS INTEGER) AS STRING
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM r AS STRING : r = ""
    DIM stille AS INTEGER : stille = 0
    WHILE MILLIS() < bis AND stille < 5
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN r = r + zz : stille = 0
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
    WEND
    RETURN r
END FUNCTION
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", "w.dh")
PRINT "befund "; TRIM$(lesen$(pc))
--- datei w.dh
CLASS Tier
END CLASS
CLASS Hund EXTENDS Tier
END CLASS
FUNCTION finde() AS Tier
    RETURN NEW Hund()
END FUNCTION
SUB zeige(t AS Tier)
END SUB
DIM t AS Tier
t = NEW Hund()
t = NIL
DIM h AS Hund
h = finde()
h = t
zeige(h)
zeige(NIL)
--- erwartet
befund []

=== die meldung nennt variable parameter und funktion
' Bis 2026-10-22 hiess es "Zuweisung an global", "Lokale Variable",
' "Parameter" und "RETURN" -- welche Variable gemeint war, stand nicht da.
CLASS Tier
END CLASS
CLASS Auto
END CLASS
DIM rex AS Tier
SUB futter(t AS Tier)
END SUB
SUB lokal()
    DIM mein AS Tier
    mein = NEW Auto()
END SUB
FUNCTION finde() AS Tier
    RETURN NEW Auto()
END FUNCTION
TRY
    rex = NEW Auto()
CATCH e
    PRINT e
END TRY
TRY
    lokal()
CATCH e
    PRINT e
END TRY
TRY
    futter(NEW Auto())
CATCH e
    PRINT e
END TRY
TRY
    rex = finde()
CATCH e
    PRINT e
END TRY
DIM zahl AS INTEGER
TRY
    zahl = "drei"
CATCH e
    PRINT e
END TRY
--- erwartet
Zuweisung an 'rex': Erwartet TIER (oder eine Unterklasse), erhalten AUTO
Zuweisung an 'mein': Erwartet TIER (oder eine Unterklasse), erhalten AUTO
Parameter 't' von futter: Erwartet TIER (oder eine Unterklasse), erhalten AUTO
RETURN von finde: Erwartet TIER (oder eine Unterklasse), erhalten AUTO
Zuweisung an 'zahl': Erwartet INTEGER, erhalten STRING
