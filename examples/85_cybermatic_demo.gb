' ============================================================================
'  85_cybermatic_demo.gb  --  "CYBERMATIC"  (native GameBasic Showcase, HiRes)
'
'  Beat-getriebene Demoscene-Nummer, die zeigt, was die native Runtime (gbrt)
'  kann -- alles in EINEM 1280x720-Frame:
'    * 3D (g3d): orbitierende Kamera mit Beat-Zoom-Punch + Shake, Grid,
'      pulsierende Kugel, ZWEI gegenlaeufige Wuerfelringe, rotierende
'      Wuerfelsaeule, Lichtsaeulen.
'    * 2D-Overlay: gespiegeltes Spektrum (BOXES-Bulk), Glow-Funken-Salven +
'      Cyber-Regen (streak) zum Takt, pulsierender Titel, Credits-Laufschrift.
'    * Beat-Flash ueber die Hintergrundfarbe, alles synchron via MILLIS/SIN.
'    * Stream-Musik (geloopt).
'
'  NUR NATIV:  gbrun.py --native examples\85_cybermatic_demo.gb   (oder F6)
'  ESC beendet.
'
'  Musik: "Cybermatic pulse" von Alexandr Zhelanov (opengameart.org), CC-BY 4.0.
'  Fehlt die Datei:  py examples\assets\download_cybermatic.py
'  Credits: examples/assets/CREDITS_cybermatic.txt
' ============================================================================

IMPORT "g3d"
IMPORT "particles"

CONST W AS INTEGER = 1280
CONST H AS INTEGER = 720
CONST TWO_PI AS FLOAT = 6.2831853
CONST NB AS INTEGER = 64            ' Spektrum-Balken
CONST RA AS INTEGER = 16            ' Wuerfel im aeusseren Ring
CONST RB AS INTEGER = 12            ' Wuerfel im inneren Ring
CONST COL AS INTEGER = 8            ' Wuerfel in der Mittelsaeule
CONST BPS AS FLOAT = 2.0833         ' Beats/Sekunde (~125 BPM)

SCREEN(W, H, "GameBasic -- CYBERMATIC (native)", 1)

IF FILEEXISTS("assets/cybermatic_pulse.ogg") THEN
    PLAYMUSIC("assets/cybermatic_pulse.ogg", -1, 0.7)
END IF

' --- Glow-Funken (Beat-Salve aus der Bildmitte) -----------------------------
DIM sparks AS PARTICLE_SYSTEM
sparks = PARTICLE_SYSTEM_NEW(W / 2, H / 2)
PARTICLE_SET_VELOCITY(sparks, -360.0, 360.0, -360.0, 360.0)
PARTICLE_SET_LIFETIME(sparks, 350, 850)
PARTICLE_SET_GRAVITY(sparks, 0.0, 80.0)
PARTICLE_SET_SIZE(sparks, 2, 6)
PARTICLE_SET_MODE(sparks, "glow")
PARTICLE_SET_FADE(sparks, TRUE)

' --- Cyber-Regen (durchgehend, streak-Modus) --------------------------------
DIM rain AS PARTICLE_SYSTEM
rain = PARTICLE_SYSTEM_NEW(W / 2, -10)
PARTICLE_SET_VELOCITY(rain, -30.0, 30.0, 320.0, 620.0)
PARTICLE_SET_LIFETIME(rain, 700, 1500)
PARTICLE_SET_GRAVITY(rain, 0.0, 70.0)
PARTICLE_SET_SIZE(rain, 1, 2)
PARTICLE_SET_MODE(rain, "streak")
PARTICLE_SET_FADE(rain, TRUE)
PARTICLE_SET_COLOR(rain, &H1E50C0)
PARTICLE_SET_COLOR_END(rain, &H0A1840)

' --- Spektrum-Balken (Bulk via BOXES, oben + unten gespiegelt) --------------
DIM bx1[NB] AS INTEGER
DIM bx2[NB] AS INTEGER
DIM bbot1[NB] AS INTEGER
DIM bbot2[NB] AS INTEGER
DIM btop1[NB] AS INTEGER
DIM btop2[NB] AS INTEGER
DIM bcol[NB] AS INTEGER

FUNCTION hue(p AS FLOAT, bright AS FLOAT) AS INTEGER
    DIM r AS INTEGER
    DIM g AS INTEGER
    DIM b AS INTEGER
    r = INT((0.5 + 0.5 * SIN(p)) * bright * 255.0)
    g = INT((0.5 + 0.5 * SIN(p + 2.094)) * bright * 255.0)
    b = INT((0.5 + 0.5 * SIN(p + 4.188)) * bright * 255.0)
    RETURN RGB(MIN(255, r), MIN(255, g), MIN(255, b))
END FUNCTION

DIM t0 AS INTEGER
t0 = MILLIS()
DIM last_beat AS INTEGER
last_beat = -1

DIM scroll_msg AS STRING
scroll_msg = "GAMEBASIC NATIVE RUNTIME  ***  3D + PARTIKEL + BULK-2D + STREAM-AUDIO, ALLES NATIV VIA RAYLIB  ***  KAMERA-PUNCH . DOPPELRING . CYBER-REGEN . BEAT-FLASH  ***  MUSIK: CYBERMATIC PULSE / ALEXANDR ZHELANOV (CC-BY 4.0)  ***  ESC = ENDE  ***   "

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK

    DIM t AS FLOAT
    t = (MILLIS() - t0) / 1000.0

    ' Beat-Mathe: beatf = Takt-Zaehler, kick = punchiger Abfall pro Schlag.
    DIM beatf AS FLOAT
    beatf = t * BPS
    DIM beat AS INTEGER
    beat = INT(beatf)
    DIM frac AS FLOAT
    frac = beatf - beat
    DIM kick AS FLOAT
    kick = (1.0 - frac) * (1.0 - frac)
    DIM pulse AS FLOAT
    pulse = 0.5 + 0.5 * SIN(beatf * TWO_PI)
    DIM downbeat AS BOOLEAN
    downbeat = (beat MOD 4 = 0)

    ' Neuer Schlag -> Funken-Salve in wechselnder Farbe.
    IF beat <> last_beat THEN
        PARTICLE_SET_COLOR(sparks, hue(beat * 0.7, 1.0))
        PARTICLE_SET_COLOR_END(sparks, hue(beat * 0.7 + 2.0, 1.0))
        DIM burst AS INTEGER
        burst = 70
        IF downbeat THEN burst = 150
        PARTICLE_EMIT(sparks, burst)
        last_beat = beat
    END IF

    ' Beat-Flash ueber die Hintergrundfarbe (auf dem Downbeat staerker).
    DIM fl AS INTEGER
    fl = INT(kick * 26.0)
    IF downbeat THEN fl = INT(kick * 70.0)
    CLS(RGB(MIN(255, 5 + fl), MIN(255, 7 + fl), MIN(255, 14 + fl * 2)))

    ' ---------------- 3D-Welt ----------------
    ' Kamera: Orbit + Zoom-Punch (naeher auf dem Schlag) + leichter Shake.
    DIM camr AS FLOAT
    camr = 18.0 - kick * 3.5
    DIM shake AS FLOAT
    shake = kick * 0.35
    DIM camx AS FLOAT
    DIM camz AS FLOAT
    camx = COS(t * 0.32) * camr + (RND() - 0.5) * shake
    camz = SIN(t * 0.32) * camr + (RND() - 0.5) * shake
    CAMERA3D(camx, 8.0 + SIN(t * 0.6) * 3.0, camz, 0.0, 1.5, 0.0, 55.0 - kick * 8.0)

    GRID3D(48, 1.0)

    ' Pulsierende Zentralkugel (auf dem Downbeat dicker).
    DIM sr AS FLOAT
    sr = 2.0 + pulse * 1.0 + kick * 0.8
    SPHERE(0.0, 1.5, 0.0, sr, hue(t * 0.8, 1.0))
    SPHERE_WIRES(0.0, 1.5, 0.0, sr + 0.15, &H0A1830)

    DIM i AS INTEGER
    ' Aeusserer Ring (im Uhrzeigersinn).
    FOR i = 0 TO RA - 1
        DIM a1 AS FLOAT
        a1 = (i / RA) * TWO_PI + t * 0.6
        DIM x1 AS FLOAT
        DIM z1 AS FLOAT
        x1 = COS(a1) * 7.5
        z1 = SIN(a1) * 7.5
        DIM y1 AS FLOAT
        y1 = 1.2 + SIN(t * 2.5 + i * 0.55) * 1.8
        DIM s1 AS FLOAT
        s1 = 0.9 + pulse * 0.6 + kick * 0.3
        DIM c1 AS INTEGER
        c1 = hue(i * 0.4 + t, 1.0)
        CUBE(x1, y1, z1, s1, s1, s1, c1)
        CUBE_WIRES(x1, y1, z1, s1, s1, s1, &H0A1830)
        IF i MOD 2 = 0 THEN LINE3D(x1, 0.0, z1, x1, y1 + 2.5, z1, c1)
    NEXT

    ' Innerer Ring (gegenlaeufig, kleiner, hoeher).
    FOR i = 0 TO RB - 1
        DIM a2 AS FLOAT
        a2 = (i / RB) * TWO_PI - t * 0.9
        DIM x2 AS FLOAT
        DIM z2 AS FLOAT
        x2 = COS(a2) * 11.0
        z2 = SIN(a2) * 11.0
        DIM y2 AS FLOAT
        y2 = 2.5 + COS(t * 2.0 + i * 0.7) * 1.2
        DIM s2 AS FLOAT
        s2 = 0.6 + kick * 0.35
        CUBE_WIRES(x2, y2, z2, s2, s2, s2, hue(i * 0.5 - t * 1.3, 1.0))
    NEXT

    ' Rotierende Mittelsaeule ueber der Kugel.
    FOR i = 0 TO COL - 1
        DIM ca AS FLOAT
        ca = t * 1.6 + i * 0.5
        DIM cy AS FLOAT
        cy = 3.5 + i * 0.9
        DIM cs AS FLOAT
        cs = 0.45 + kick * 0.2
        CUBE(COS(ca) * 0.7, cy, SIN(ca) * 0.7, cs, cs, cs, hue(i * 0.6 + t * 2.0, 1.0))
    NEXT

    ' ---------------- 2D-Overlay ----------------
    ' Cyber-Regen (durchgehend, im Hintergrund des Overlays).
    PARTICLE_SET_POS(rain, INT(RND() * W), -10.0)
    PARTICLE_EMIT(rain, 3)
    PARTICLE_UPDATE(rain, 16)
    PARTICLE_DRAW(rain)

    ' Spektrum, oben + unten gespiegelt.
    DIM bw AS INTEGER
    bw = W / NB
    FOR i = 0 TO NB - 1
        DIM amp AS FLOAT
        amp = 0.28 + 0.72 * (0.5 + 0.5 * SIN(t * 4.0 + i * 0.4)) * (0.4 + 0.6 * pulse)
        DIM bh AS INTEGER
        bh = INT(amp * 190.0)
        bx1[i] = i * bw + 2
        bx2[i] = i * bw + bw - 2
        bbot2[i] = H - 64
        bbot1[i] = H - 64 - bh
        btop1[i] = 110
        btop2[i] = 110 + bh
        bcol[i] = hue(i * 0.18 + t * 1.5, 0.5 + 0.5 * pulse)
    NEXT
    BOXES(bx1, bbot1, bx2, bbot2, bcol)
    BOXES(bx1, btop1, bx2, btop2, bcol)

    ' Glow-Funken updaten + zeichnen (ueber allem).
    PARTICLE_UPDATE(sparks, 16)
    PARTICLE_DRAW(sparks)

    ' Titel: Groesse + Farbe pulsieren mit dem Beat.
    DIM tsz AS INTEGER
    tsz = 52 + INT(kick * 22.0)
    TEXT_SIZE(tsz)
    TEXT(W / 2 - 210, 26, "C Y B E R M A T I C", hue(t * 1.2, 0.55 + 0.45 * pulse))
    TEXT_SIZE(20)
    TEXT(W / 2 - 150, 90, "native GameBasic demo", &H6FA8C8)

    ' Laufschrift unten (Credits).
    DIM mw AS INTEGER
    mw = TEXT_WIDTH(scroll_msg)
    DIM sx AS INTEGER
    sx = W - (INT(t * 165.0) MOD (mw + W))
    TEXT(sx, H - 30, scroll_msg, &H30C0E0)

    TEXT(14, H - 54, f"t={t:.1f}s  beat={beat}  fps~{INT(1.0/0.016)}", &H507088)

    FLIP()
    SLEEP(8)
WEND

STOPMUSIC()
