=== tcp set timeout no crash
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
NET_SET_TIMEOUT(client, 0)
NET_SET_TIMEOUT(client, 100)
NET_SET_TIMEOUT(client, -1)
PRINT "ok"
NET_CLOSE(client)
NET_CLOSE_LISTENER(l)
--- erwartet
ok

