' Natives, vom OS aus groessenveraenderbares Programmfenster (Weg 1).
' Das SCREEN-Fenster selbst wird resizebar gemacht; das Layout liest jeden
' Frame SCREENWIDTH()/SCREENHEIGHT() und fuellt damit das Fenster.
SCREEN(640, 400, "Resizebares Fenster", 1)
WINDOW_RESIZABLE(TRUE)            ' Ziehen an den Fensterkanten erlauben
WINDOW_MIN_SIZE(360, 240)        ' nicht kleiner
WINDOW_MAX_SIZE(1280, 800)       ' nicht groesser

DIM bg AS INTEGER
bg = RGB(14, 20, 28)

WHILE NOT QUITREQUESTED()
    DIM w AS INTEGER
    DIM h AS INTEGER
    w = SCREENWIDTH()            ' live -- waechst/schrumpft mit dem Fenster
    h = SCREENHEIGHT()

    CLS(bg)
    ' Rahmen, der immer das ganze Fenster ausfuellt
    RECT(2, 2, w - 3, h - 3, RGB(43, 196, 232))
    ' Kopfleiste
    BOX(0, 0, w - 1, 28, RGB(18, 90, 120))
    TEXT(8, 8, "Zieh am Fensterrand!")
    ' Live-Groesse mittig
    TEXT(w \ 2 - 60, h \ 2, STR$(w) + " x " + STR$(h))
    ' "Button" unten rechts -- klebt immer in der Ecke
    BOX(w - 130, h - 40, w - 10, h - 12, RGB(46, 62, 80))
    TEXT(w - 120, h - 33, "unten rechts")

    IF WINDOW_RESIZED() THEN
        SETWINDOWTITLE("Resizebares Fenster  -  " + STR$(w) + "x" + STR$(h))
    END IF
    FLIP()
WEND
