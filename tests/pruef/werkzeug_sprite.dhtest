    DIM t AS INTEGER
    prKnopf(2, GUI_GET_X(bBildKopie), GUI_GET_Y(bBildKopie), 128)
    prKnopf(8, GUI_GET_X(bAnimNeu), GUI_GET_Y(bAnimNeu), 128)
    prKnopf(14, GUI_GET_X(bGbCode), GUI_GET_Y(bGbCode), 128)
