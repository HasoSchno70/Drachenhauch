' CONST fuer Werte, die sich nie aendern - und Compound-Assignment.

CONST MAX_LIVES   AS INTEGER = 3
CONST POINTS_HIT  AS INTEGER = 100
CONST BONUS_LEVEL AS INTEGER = 1000

DIM score AS INTEGER
DIM lives AS INTEGER
score = 0
lives = MAX_LIVES

' Drei Treffer: jeweils +100 Punkte
score += POINTS_HIT      ' = score = score + POINTS_HIT
score += POINTS_HIT
score += POINTS_HIT
PRINT f"Nach 3 Treffern: {score}"

' Level geschafft - Bonus drauf
score += BONUS_LEVEL
PRINT f"Mit Level-Bonus:  {score}"

' Ein Leben verloren
lives -= 1
PRINT f"Leben uebrig:     {lives}"
