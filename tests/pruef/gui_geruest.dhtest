=== das laengste wort gewinnt
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_TEXTAREA_SET(ta, "auto_einzug", 1)
GUI_TEXTAREA_INDENT_WORDS(ta, ["DO"], [], ["LOOP"])
GUI_TEXTAREA_CLOSE_WORDS(ta, ["DO", "DO WHILE"], ["LOOP UNTIL x", "LOOP"])
GUI_SET_TEXT(ta, "DO WHILE x < 3")
GUI_TEXTAREA_GOTO(ta, 1, 15)
GUI_FOCUS(ta)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 30 THEN PRINT "[" + REPLACE$(GUI_TEXT(ta), CHR$(10), "|") + "]"
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
# Enter
c 2
e 4 2 257 0 0 0 // Enter runter
e 6 1 257 0 0 0 // Enter hoch
--- umgebung
DHRT_FRAMES=40
--- erwartet
[DO WHILE x < 3|    |LOOP]

=== bei mehreren marken bleibt es beim umbruch
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_TEXTAREA_CLOSE_WORDS(ta, ["IF"], ["END IF"])
GUI_SET_TEXT(ta, "IF a THEN" + CHR$(10) + "IF b THEN")
GUI_TEXTAREA_GOTO(ta, 1, 10)
GUI_TEXTAREA_ADD_CARET(ta, 2, 10)
GUI_FOCUS(ta)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 30 THEN PRINT "[" + REPLACE$(GUI_TEXT(ta), CHR$(10), "|") + "]"
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
# Enter
c 2
e 4 2 257 0 0 0 // Enter runter
e 6 1 257 0 0 0 // Enter hoch
--- umgebung
DHRT_FRAMES=40
--- erwartet
[IF a THEN||IF b THEN|]

