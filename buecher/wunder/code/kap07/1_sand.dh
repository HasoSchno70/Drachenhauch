' Kapitel 7, Schritt 1 -- Sand rieselt aus einer Duese und tuermt sich
' zu einem Kegel auf.
CONST B = 200
CONST H = 125
CONST ZELLE = 4
CONST TAKT = 1.0 / 60

ENUM Stoff
    LEER
    SAND
END ENUM

DIM welt[1 TO B, 1 TO H] AS Stoff

' Ist (x, y) im Feld und leer?
FUNCTION frei(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    IF x < 1 OR x > B OR y < 1 OR y > H THEN RETURN FALSE
    RETURN welt[x, y] = Stoff.LEER
END FUNCTION

SUB tauschen(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    DIM t AS Stoff : t = welt[x1, y1]
    welt[x1, y1] = welt[x2, y2]
    welt[x2, y2] = t
END SUB

' Sand faellt; geht das nicht, rutscht er schraeg nach unten.
SUB sandFaellt(x AS INTEGER, y AS INTEGER)
    DIM s AS INTEGER : s = IIF(RND() < 0.5, -1, 1)
    IF frei(x, y + 1) THEN
        tauschen(x, y, x, y + 1)
    ELSEIF frei(x + s, y + 1) THEN
        tauschen(x, y, x + s, y + 1)
    ELSEIF frei(x - s, y + 1) THEN
        tauschen(x, y, x - s, y + 1)
    END IF
END SUB

' Ein Schritt der Welt: von unten nach oben, Zeile fuer Zeile.
SUB schritt()
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = H - 1 TO 1 STEP -1
        FOR x = 1 TO B
            IF welt[x, y] = Stoff.SAND THEN sandFaellt(x, y)
        NEXT
    NEXT
    ' Die Duese oben in der Mitte
    welt[B \ 2 + RANDINT(-1, 1), 1] = Stoff.SAND
END SUB

SUB zeichnen(bild AS INTEGER)
    RENDERTARGET_BEGIN(bild)
    CLS(RGB(14, 16, 26))
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 1 TO H
        FOR x = 1 TO B
            IF welt[x, y] = Stoff.SAND THEN
                PLOT(x - 1, y - 1, RGB(230, 190, 110))
            END IF
        NEXT
    NEXT
    RENDERTARGET_END()
    RENDERTARGET_DRAW(bild, 0, 0, ZELLE)
    FLIP()
END SUB

SCREEN(B * ZELLE, H * ZELLE, "Sand")
DIM bild AS INTEGER : bild = RENDERTARGET_NEW(B, H)
DIM uhr AS FLOAT
WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE)
    ' Feste Schritte, 60 je Sekunde, auch wenn die Bilder schwanken.
    uhr = MIN(uhr + DELTA(), 0.1)
    WHILE uhr >= TAKT
        schritt()
        uhr = uhr - TAKT
    WEND
    zeichnen(bild)
WEND
