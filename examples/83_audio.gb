' 83_audio.gb -- Sound + Musik (Core-Audio), laeuft nativ in gbrt (F6/--native;
' Audio nur in der nativen Runtime). Builtins:
'   LOADSOUND(pfad$) -> SOUND        PLAYSOUND(sound[, loops, lautstaerke])
'   STOPSOUND(sound)                 PLAYMUSIC(pfad$[, loops, lautstaerke])
'   STOPMUSIC()
'
' SPACE spielt den Pickup-Sound, M startet/stoppt die Musik. ESC beendet.

SCREEN(480, 200, "Audio", 2)

DIM beep AS SOUND
beep = LOADSOUND("assets/beep.wav")
DIM pickup AS SOUND
pickup = LOADSOUND("assets/pickup.wav")

PLAYMUSIC("assets/amiga_title.ogg", -1, 0.5)
DIM music_on AS BOOLEAN
music_on = TRUE

' Edge-Detection fuer Tasten (gedrueckt-Zustand des Vorframes merken).
DIM space_prev AS BOOLEAN
DIM m_prev AS BOOLEAN
space_prev = FALSE
m_prev = FALSE

PLAYSOUND(beep)        ' Start-Beep

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    CLS(&H101828)

    DIM space_now AS BOOLEAN
    space_now = KEYPRESSED(32)
    IF space_now AND NOT space_prev THEN PLAYSOUND(pickup)
    space_prev = space_now

    DIM m_now AS BOOLEAN
    m_now = KEYPRESSED(109)        ' 'm'
    IF m_now AND NOT m_prev THEN
        IF music_on THEN
            STOPMUSIC()
        ELSE
            PLAYMUSIC("assets/amiga_title.ogg", -1, 0.5)
        END IF
        music_on = NOT music_on
    END IF
    m_prev = m_now

    TEXT(12, 16, "Audio-Demo", WHITE)
    TEXT(12, 40, "SPACE = Pickup-Sound", &H9FB4C8)
    TEXT(12, 60, "M = Musik an/aus  (jetzt: " + IIF(music_on, "an", "aus") + ")", &H9FB4C8)
    TEXT(12, 80, "ESC = Ende", &H708090)

    FLIP()
    SLEEP(16)
WEND

STOPMUSIC()
