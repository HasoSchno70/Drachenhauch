' Screenshot-Demo Kapitel 59a: chart (Diagramme)
IMPORT "chart"
SCREEN(480, 320, "Chart")

' Kuchen links oben
DIM k AS CHART
k = CHART_NEW("kuchen", 8, 22, 156, 136)
CHART_ADD(k, "Feuer", 42.0)
CHART_ADD(k, "Wasser", 27.0)
CHART_ADD(k, "Erde", 18.0)
CHART_ADD(k, "Luft", 13.0)
CHART_SET(k, "titel", "Elemente")
CHART_THEME(k, "dunkel")

' Balken rechts oben
DIM b AS CHART
b = CHART_NEW("balken", 172, 22, 296, 136)
CHART_ADD(b, "Mo", 12.0)
CHART_ADD(b, "Di", 19.0)
CHART_ADD(b, "Mi", 8.0)
CHART_ADD(b, "Do", 24.0)
CHART_ADD(b, "Fr", 16.0)
CHART_SET(b, "titel", "Spieler pro Tag")
CHART_THEME(b, "dunkel")

' Linie links unten
DIM l AS CHART
l = CHART_NEW("linie", 8, 170, 296, 140)
DIM s AS INTEGER : s = CHART_SERIES(l, "Bilder/s")
DIM i AS INTEGER
FOR i = 0 TO 23
    CHART_PUSH(l, s, 52.0 + SIN(i * 0.5) * 8.0)
NEXT
CHART_SET(l, "titel", "Bildrate")
CHART_SET_FLAG(l, "glatt", TRUE)
CHART_THEME(l, "dunkel")

' Tacho rechts unten
DIM t AS CHART
t = CHART_NEW("tacho", 312, 170, 156, 140)
CHART_SET_NUM(t, "min", 0.0)
CHART_SET_NUM(t, "max", 100.0)
CHART_ADD(t, "Last", 72.0)
' Zonen ohne Namen -- auf dieser Groesse wuerden sie die Anzeige ueberlagern.
CHART_ZONE(t, 0.0, 50.0, RGB(70, 200, 110))
CHART_ZONE(t, 50.0, 85.0, RGB(230, 180, 70))
CHART_ZONE(t, 85.0, 100.0, RGB(230, 90, 90))
CHART_SET(t, "titel", "Auslastung")
CHART_SET(t, "wertanzeige", "innen")
CHART_THEME(t, "dunkel")

WHILE NOT QUITREQUESTED()
    CLS(RGB(16, 20, 30))
    CHART_DRAW(k)
    CHART_DRAW(b)
    CHART_DRAW(l)
    CHART_DRAW(t)
    FLIP()
WEND
