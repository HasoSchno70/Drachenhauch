=== bitfelder der windows-api: buildcommdcba fuellt ein dcb
' Das DCB einer seriellen Schnittstelle traegt 13 Bitfelder in einer
' DWORD-Einheit. BuildCommDCBA fuellt es aus einem Text, ohne dass es einen
' Anschluss braucht.
STRUCT DCB LAYOUT C
    DCBlength AS ULONG
    BaudRate AS ULONG
    fBinary AS ULONG : 1
    fParity AS ULONG : 1
    fOutxCtsFlow AS ULONG : 1
    fOutxDsrFlow AS ULONG : 1
    fDtrControl AS ULONG : 2
    fDsrSensitivity AS ULONG : 1
    fTXContinueOnXoff AS ULONG : 1
    fOutX AS ULONG : 1
    fInX AS ULONG : 1
    fErrorChar AS ULONG : 1
    fNull AS ULONG : 1
    fRtsControl AS ULONG : 2
    fAbortOnError AS ULONG : 1
    fDummy2 AS ULONG : 17
    wReserved AS USHORT
    XonLim AS USHORT
    XoffLim AS USHORT
    ByteSize AS UBYTE
    Parity AS UBYTE
    StopBits AS UBYTE
    XonChar AS BYTE
    XoffChar AS BYTE
    ErrorChar AS BYTE
    EofChar AS BYTE
    EvtChar AS BYTE
    wReserved1 AS USHORT
END STRUCT
DECLARE FUNCTION BuildCommDCBA LIB "kernel32" (def AS TEXT, dcb AS DCB) AS BOOLEAN
PRINT SIZEOF(DCB), OFFSETOF(DCB, wReserved), OFFSETOF(DCB, ByteSize)
DIM d AS DCB
d.DCBlength = SIZEOF(DCB)
PRINT BuildCommDCBA("baud=19200 parity=e data=7 stop=2 dtr=on rts=on octs=on idsr=on", d)
PRINT d.BaudRate, d.ByteSize, d.Parity, d.StopBits
PRINT d.fOutxCtsFlow, d.fOutxDsrFlow, d.fDtrControl, d.fDsrSensitivity, d.fRtsControl
d.fDtrControl = 2
d.fRtsControl = 3
d.fAbortOnError = 1
PRINT HEX$(BUFFER_GET_I32(d, 8) BAND &H7FFF), d.fOutxCtsFlow, d.fDsrSensitivity
--- system windows
--- erwartet
28 12 18
TRUE
19200 7 2 2
1 0 1 1 1
7064 1 1

=== was nicht geht, sagt der uebersetzer
IMPORT "json"
DIM p AS INTEGER
SUB pruefe(text AS STRING)
    WRITEALL("probe.dh", text)
    p = PROCESS_START("dhrt", "--check", "probe.dh")
    DIM aus AS STRING
    DIM leer AS INTEGER
    WHILE leer < 5
        DIM z AS STRING
        z = PROCESS_READ$(p)
        IF z = "" THEN
            IF NOT PROCESS_RUNNING(p) THEN leer = leer + 1
            SLEEP(30)
        ELSE
            aus = aus + z
        END IF
    WEND
    DIM j AS JSON_HANDLE
    j = JSON_PARSE("{" + CHR$(34) + "m" + CHR$(34) + ":" + aus + "}")
    IF JSON_LEN(j, "m") = 0 THEN
        PRINT "ok"
    ELSE
        PRINT JSON_GET_STRING(j, "m.0.message")
    END IF
END SUB
DIM nl AS STRING
nl = CHR$(10)
DIM kopf AS STRING
kopf = "STRUCT Punkt LAYOUT C" + nl + "  x AS LONG" + nl + "  w[2] AS LONG" + nl + "END STRUCT" + nl + "DIM p AS Punkt" + nl
pruefe(kopf + "PRINT p.x + p.w[1]")
pruefe(kopf + "PRINT p.z")
pruefe(kopf + "PRINT p.w")
pruefe(kopf + "PRINT p.x[1]")
pruefe(kopf + "PRINT SIZEOF(Gibts)")
pruefe(kopf + "PRINT OFFSETOF(Punkt, z)")
pruefe(kopf + "DIM ps[3] AS Punkt")
pruefe(kopf + "CLASS K" + nl + "  DIM p AS Punkt" + nl + "END CLASS")
pruefe(kopf + "DECLARE SUB f LIB " + CHR$(34) + "c" + CHR$(34) + " (a AS Gibts)")
pruefe("STRUCT A LAYOUT C" + nl + "  b AS A" + nl + "END STRUCT")
pruefe("STRUCT A LAYOUT C PACK 3" + nl + "  b AS LONG" + nl + "END STRUCT")
pruefe("STRUCT A LAYOUT C" + nl + "  b AS TEXT" + nl + "END STRUCT")
pruefe("STRUCT A LAYOUT C" + nl + "  b AS LONG" + nl + "END STRUCT" + nl + "STRUCT A" + nl + "  DIM x AS INTEGER" + nl + "END STRUCT")
DIM bits AS STRING
bits = "STRUCT B LAYOUT C" + nl + "  a AS LONG : 3" + nl + "  x AS LONG : y AS LONG" + nl + "END STRUCT" + nl
pruefe(bits + "DIM b AS B" + nl + "b.a = 3" + nl + "PRINT b.a + b.x + b.y")
pruefe(bits + "PRINT OFFSETOF(B, a), OFFSETOF(B, y)")
pruefe("STRUCT B LAYOUT C" + nl + "  a AS FLOAT : 3" + nl + "END STRUCT")
pruefe("STRUCT B LAYOUT C" + nl + "  a AS BYTE : 9" + nl + "END STRUCT")
pruefe("STRUCT B LAYOUT C" + nl + "  a AS LONG : 0" + nl + "END STRUCT")
pruefe("STRUCT B LAYOUT C" + nl + "  a[2] AS LONG : 3" + nl + "END STRUCT")
pruefe("STRUCT B LAYOUT C PACK 1" + nl + "  a AS LONG : 3" + nl + "END STRUCT")
pruefe("STRUCT B LAYOUT C" + nl + "  a : 3 AS TEXT * 4" + nl + "END STRUCT")
--- erwartet
ok
Punkt hat kein Feld 'z' (Felder: x, w)
p.w ist ein Feld von 2 Elementen -- mit Index: p.w[0]
p.x ist kein Feld von Elementen -- ohne Index
SIZEOF: 'GIBTS' ist weder ein STRUCT ... LAYOUT C noch ein Typwort (LONG, ZEIGER ...)
OFFSETOF: Punkt hat kein Feld 'z' (Felder: x, w)
Ein Feld von Punkt gibt es nicht -- ein STRUCT ... LAYOUT C mit einem Feld davon schon: STRUCT Liste LAYOUT C / e[10] AS Punkt / END STRUCT
k.p: ein STRUCT ... LAYOUT C kann (noch) kein Feld einer Klasse sein -- er lebt in einer Variable oder einem Parameter (DIM p AS Punkt), oder das Feld ist ein BUFFER mit BUFFER_NEW(SIZEOF(Punkt))
'GIBTS' ist kein Typ fuer fremde Bibliotheken (moeglich: ein STRUCT ... LAYOUT C oder BYTE, UBYTE, SHORT, USHORT, LONG, ULONG, INTEGER, ZEIGER, SINGLE, FLOAT, BOOLEAN, TEXT, WTEXT, BUFFER, VALIST)
STRUCT A LAYOUT C enthaelt sich selbst (ueber a) -- ein Struct kann sich nicht einbetten, nur einen ZEIGER auf sich haben
Erwartet 1, 2, 4, 8 oder 16 nach PACK
Ein Text im Struct hat eine feste Laenge: TEXT * 32 (Zeichen) -- ein Zeiger auf Text ist ZEIGER
STRUCT A ist zweimal deklariert -- eines von beiden umbenennen
ok
OFFSETOF: B.a ist ein Bitfeld -- es hat keine Stelle in Bytes (in C ebenso)
STRUCT B: das Bitfeld 'a' braucht eine ganze Zahl (BYTE, SHORT, LONG, INTEGER, auch ohne Vorzeichen, oder BOOLEAN), nicht FLOAT
STRUCT B: das Bitfeld 'a' hat 9 Bits, BYTE hat nur 8
Ein Bitfeld hat 1 bis 64 Bits -- etwa flags AS ULONG : 3 (ein Bitfeld mit 0 Bits gibt es hier nicht)
STRUCT B: 'a' ist ein Bitfeld -- ein Feld von Bitfeldern gibt es in C nicht
STRUCT B: Bitfelder gehen (noch) nicht zusammen mit PACK -- dort legen die Compiler sie verschieden
Ein Bitfeld braucht eine ganze Zahl als Typ (LONG, ULONG, BYTE ...) -- etwa flags AS ULONG : 3

=== dhrt fmt schreibt die woerter des structs gross
DIM p AS INTEGER
p = PROCESS_START("dhrt", "fmt", "probe.dh")
WHILE PROCESS_RUNNING(p)
    SLEEP(20)
WEND
DIM z AS ARRAY OF STRING
z = READLINES("probe.dh")
FOR i = 0 TO LEN(z) - 1
    PRINT z[i]
NEXT
--- datei probe.dh
struct uts layout c pack 1
    dim sysname as text * 65
    n[2] as ushort
    p as zeiger
end struct
dim long as integer
--- erwartet
STRUCT uts LAYOUT C PACK 1
    DIM sysname AS TEXT * 65
    n[2] AS USHORT
    p AS ZEIGER
END STRUCT
DIM long AS INTEGER
