' ---- Daten im Speicher ---------------------------------------------------
' Die Datenbank ist die Wahrheit, die Tabelle nur ihre Ansicht. Deshalb
' merkt sich jede Tabellenzeile die id ihres Spiels.
CONST MAXSPIELE = 200
DIM spielId[MAXSPIELE] AS INTEGER
DIM anstoss[MAXSPIELE] AS INTEGER      ' Anstoss als Zeitpunkt, 0 = unbekannt
DIM spieleAnzahl AS INTEGER

' ---- Tippschluss ---------------------------------------------------------
' Eine Regel, eine Stelle -- wie bei punkte(). Beide Fragen, die das
' Programm stellt ("darf noch?" und "wie lange noch?"), rechnen mit
' derselben Zahl.
FUNCTION tippschluss(zeile AS INTEGER) AS INTEGER
    IF anstoss[zeile] = 0 THEN RETURN 0
    RETURN ZEIT_PLUS(anstoss[zeile], -TIPPSCHLUSS_VOR)
END FUNCTION

FUNCTION offen(zeile AS INTEGER) AS BOOLEAN
    ' Ohne bekannten Anstoss bleibt getippt erlaubt -- ein fehlender
    ' Termin darf niemanden aussperren.
    IF anstoss[zeile] = 0 THEN RETURN TRUE
    RETURN ZEIT_JETZT() < tippschluss(zeile)
END FUNCTION

FUNCTION restText(zeile AS INTEGER) AS STRING
    IF anstoss[zeile] = 0 THEN RETURN "Termin offen"
    IF offen(zeile) THEN
        RETURN "noch " + ZEIT_DAUER$(ZEIT_DIFF(tippschluss(zeile), ZEIT_JETZT())) + " zu tippen"
    END IF
    RETURN "Tippschluss war " + ZEIT_DAUER$(ZEIT_DIFF(tippschluss(zeile), ZEIT_JETZT()))
END FUNCTION

CONST MAXSPIELER = 50
DIM spielerId[MAXSPIELER] AS INTEGER
DIM spielerAnzahl AS INTEGER

SUB melde(text AS STRING)
    GUI_SET_TEXT(stand, text)
END SUB

FUNCTION aktiverSpieler() AS INTEGER
    DIM i AS INTEGER : i = GUI_DROPDOWN_SELECTED(spielerWahl)
    IF i < 0 OR i >= spielerAnzahl THEN RETURN 0
    RETURN spielerId[i]
END FUNCTION

SUB spielerLaden()
    spielerAnzahl = 0
    DIM namen[MAXSPIELER] AS STRING
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT id, name FROM spieler ORDER BY name")
    WHILE DB_NEXT(r)
        IF spielerAnzahl >= MAXSPIELER THEN BREAK
        spielerId[spielerAnzahl] = DB_GET_INT(r, 0)
        namen[spielerAnzahl] = DB_GET_STRING(r, 1)
        spielerAnzahl = spielerAnzahl + 1
    WEND
    DB_CLOSE_RESULT(r)

    DIM liste[spielerAnzahl] AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO spielerAnzahl - 1
        liste[i] = namen[i]
    NEXT
    GUI_SET_DROPDOWN(spielerWahl, liste)
    GUI_DROPDOWN_SET_SELECTED(spielerWahl, 0)
END SUB

' Die Spiele des Spieltags mit dem Tipp des gewaehlten Spielers.
' Ein LEFT JOIN, damit auch Spiele ohne Tipp in der Liste stehen.
SUB spieleLaden()
    GUI_TABLE_CLEAR(tabelle)
    spieleAnzahl = 0

    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT s.id, s.heim, s.gast, s.tore_heim, s.tore_gast, " + _
                     "       t.tipp_heim, t.tipp_gast, t.punkte, s.anstoss " + _
                     "FROM spiele s " + _
                     "LEFT JOIN tipps t ON t.spiel_id = s.id AND t.spieler_id = ? " + _
                     "WHERE s.spieltag = 1 ORDER BY s.anstoss, s.id", aktiverSpieler())

    WHILE DB_NEXT(r)
        IF spieleAnzahl >= MAXSPIELE THEN BREAK

        DIM tippText AS STRING : tippText = "-:-"
        IF NOT DB_IS_NULL(r, 5) THEN
            tippText = STR$(DB_GET_INT(r, 5)) + ":" + STR$(DB_GET_INT(r, 6))
        END IF

        DIM ergText AS STRING : ergText = "-:-"
        DIM beendet AS BOOLEAN : beendet = NOT DB_IS_NULL(r, 3)
        IF beendet THEN
            ergText = STR$(DB_GET_INT(r, 3)) + ":" + STR$(DB_GET_INT(r, 4))
        END IF

        DIM punkteText AS STRING : punkteText = ""
        IF beendet AND NOT DB_IS_NULL(r, 7) THEN punkteText = STR$(DB_GET_INT(r, 7))

        ' Aus "2026-08-28 20:30:00" wird "Fr 28.08. 20:30" -- der Text aus der
        ' Datenbank einmal in eine Zahl und wieder heraus.
        DIM anstossText AS STRING : anstossText = "offen"
        anstoss[spieleAnzahl] = 0
        IF NOT DB_IS_NULL(r, 8) THEN
            IF ZEIT_LESBAR(DB_GET_STRING(r, 8)) THEN
                anstoss[spieleAnzahl] = ZEIT_PARSE(DB_GET_STRING(r, 8))
                anstossText = ZEIT_FORMAT$(anstoss[spieleAnzahl], "WT TT.MM. hh:mm")
            END IF
        END IF

        DIM zeile AS ARRAY OF STRING
        zeile = SPLIT$(anstossText + "|" + _
                       DB_GET_STRING(r, 1) + "|" + DB_GET_STRING(r, 2) + "|" + _
                       tippText + "|" + ergText + "|" + punkteText, "|")
        GUI_TABLE_ADD_ROW(tabelle, zeile)
        spielId[spieleAnzahl] = DB_GET_INT(r, 0)

        ' Ist die Zeile schon zu? Grau heisst: hier geht nichts mehr.
        IF anstoss[spieleAnzahl] > 0 AND NOT offen(spieleAnzahl) THEN
            GUI_TABLE_CELL_COLOR(tabelle, spieleAnzahl, 0, &H8A93A6, -1)
        END IF

        ' Gewertete Zeilen nach Ausbeute faerben -- man sieht auf einen
        ' Blick, wo Punkte liegen.
        IF punkteText <> "" THEN
            DIM p AS INTEGER : p = DB_GET_INT(r, 7)
            IF p >= 3 THEN
                GUI_TABLE_CELL_COLOR(tabelle, spieleAnzahl, 4, &H7CE38B, -1)
            ELIF p >= 1 THEN
                GUI_TABLE_CELL_COLOR(tabelle, spieleAnzahl, 4, &HE8C46A, -1)
            ELSE
                GUI_TABLE_CELL_COLOR(tabelle, spieleAnzahl, 4, &HE07A7A, -1)
            END IF
        END IF

        spieleAnzahl = spieleAnzahl + 1
    WEND
    DB_CLOSE_RESULT(r)
END SUB

SUB ranglisteLaden()
    GUI_TABLE_CLEAR(rang)
    DIM r AS DB_RESULT
    ' Gewertet wird nur, was ein Ergebnis hat -- ein Tipp auf ein noch
    ' nicht gespieltes Spiel ist keine Null, er zaehlt einfach nicht.
    r = DB_QUERY(db, "SELECT p.name, " + _
                     "  COALESCE(SUM(CASE WHEN s.tore_heim IS NOT NULL " + _
                     "                    THEN t.punkte END), 0) AS punkte, " + _
                     "  COUNT(t.id) AS tipps " + _
                     "FROM spieler p " + _
                     "LEFT JOIN tipps t ON t.spieler_id = p.id " + _
                     "LEFT JOIN spiele s ON s.id = t.spiel_id " + _
                     "GROUP BY p.id, p.name " + _
                     "ORDER BY punkte DESC, p.name")
    DIM platz AS INTEGER : platz = 1
    WHILE DB_NEXT(r)
        DIM zeile AS ARRAY OF STRING
        zeile = SPLIT$(STR$(platz) + "|" + DB_GET_STRING(r, 0) + "|" + _
                       STR$(DB_GET_INT(r, 1)) + "|" + STR$(DB_GET_INT(r, 2)), "|")
        GUI_TABLE_ADD_ROW(rang, zeile)
        IF platz = 1 THEN GUI_TABLE_ROW_COLOR(rang, platz - 1, &HF4E3A6, -1)
        platz = platz + 1
    WEND
    DB_CLOSE_RESULT(r)
END SUB

' Punkte aller Tipps eines Spiels neu rechnen -- nach jedem Ergebnis.
SUB punkteNeu(spiel AS INTEGER, ergH AS INTEGER, ergA AS INTEGER)
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT id, tipp_heim, tipp_gast FROM tipps WHERE spiel_id = ?", spiel)

    CONST MAXT = 200
    DIM ids[MAXT] AS INTEGER
    DIM werte[MAXT] AS INTEGER
    DIM n AS INTEGER : n = 0
    WHILE DB_NEXT(r)
        IF n >= MAXT THEN BREAK
        ids[n] = DB_GET_INT(r, 0)
        werte[n] = punkte(DB_GET_INT(r, 1), DB_GET_INT(r, 2), ergH, ergA)
        n = n + 1
    WEND
    DB_CLOSE_RESULT(r)

    ' Erst lesen, dann schreiben: waehrend ein Ergebnis-Cursor offen ist,
    ' schreibt es sich schlecht in dieselbe Tabelle.
    DB_BEGIN(db)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DB_EXEC(db, "UPDATE tipps SET punkte = ? WHERE id = ?", werte[i], ids[i])
    NEXT
    DB_COMMIT(db)
END SUB

' ---- Spielplan aus dem Netz ----------------------------------------------
' Der Abruf laeuft im Hintergrund: HTTP_GET_START gibt sofort eine Nummer
' zurueck, die Schleife fragt jedes Bild einmal nach. Mit HTTP_GET stuende
' das Fenster stattdessen eine Fuenftelsekunde still -- bei schlechter
' Verbindung bis zu zehn Sekunden.
DIM abruf AS INTEGER : abruf = -1

SUB spielplanHolen()
    IF abruf >= 0 THEN
        melde("Der Spielplan wird schon geholt.")
        RETURN
    END IF
    abruf = HTTP_GET_START(SPIELPLAN_URL)
    melde("Spielplan wird geholt ...")
END SUB

' Aus der Antwort die Paarungen und Anstosszeiten uebernehmen.
SUB spielplanUebernehmen(text AS STRING)
    DIM wurzel AS JSON_HANDLE
    wurzel = JSON_PARSE(text)
    DIM n AS INTEGER : n = JSON_LEN(wurzel, "")
    IF n <= 0 THEN
        melde("Der Spielplan kam leer zurueck.")
        RETURN
    END IF

    DB_BEGIN(db)
    DIM i AS INTEGER
    DIM uebernommen AS INTEGER : uebernommen = 0
    FOR i = 0 TO n - 1
        ' Pfade sind durchgehend Punkte, auch fuer Array-Plaetze:
        ' "0.team1.teamName" ist das Heimteam des ersten Spiels.
        DIM pfad AS STRING : pfad = STR$(i)
        DIM heim AS STRING : heim = JSON_GET_STRING(wurzel, pfad + ".team1.teamName")
        DIM gast AS STRING : gast = JSON_GET_STRING(wurzel, pfad + ".team2.teamName")
        IF heim <> "" AND gast <> "" THEN
            ' Die API liefert "2026-08-28T20:30:00" -- ZEIT_PARSE versteht
            ' das T, ZEIT_TEXT$ macht die Normalform daraus, die in der
            ' Datenbank steht.
            DIM roh AS STRING : roh = JSON_GET_STRING(wurzel, pfad + ".matchDateTime")
            DIM termin AS STRING : termin = ""
            IF ZEIT_LESBAR(roh) THEN termin = ZEIT_TEXT$(ZEIT_PARSE(roh))
            spielAnlegen(heim, gast, termin)
            uebernommen = uebernommen + 1
        END IF
    NEXT
    DB_COMMIT(db)

    spieleLaden()
    ranglisteLaden()
    melde(STR$(uebernommen) + " Spiele uebernommen.")
END SUB

' Einmal pro Bild nachsehen -- nicht warten.
SUB abrufPruefen()
    IF abruf < 0 THEN RETURN
    IF NOT HTTP_READY(abruf) THEN RETURN

    DIM nummer AS INTEGER : nummer = abruf
    abruf = -1                       ' erst freigeben, dann auswerten
    TRY
        spielplanUebernehmen(HTTP_RESULT(nummer))
    CATCH e
        melde("Spielplan nicht erreichbar: " + e)
    END TRY
END SUB

spielerLaden()
spieleLaden()
ranglisteLaden()
melde("Spieler waehlen, Zeile anklicken, Tipp eingeben.")

' ---- Hauptschleife -------------------------------------------------------
DIM letzterSpieler AS INTEGER : letzterSpieler = 0
DIM letzteZeile AS INTEGER : letzteZeile = -1
DIM letzteSekunde AS INTEGER : letzteSekunde = 0

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    GUI_UPDATE()
    abrufPruefen()

    IF GUI_CLICKED(bHolen) THEN spielplanHolen()

    ' Spielerwechsel -> Liste neu laden
    IF GUI_DROPDOWN_SELECTED(spielerWahl) <> letzterSpieler THEN
        letzterSpieler = GUI_DROPDOWN_SELECTED(spielerWahl)
        spieleLaden()
        melde("Spieler gewechselt.")
    END IF

    ' Zeilenauswahl -> Tipp der Zeile in die Felder holen
    DIM zeile AS INTEGER : zeile = GUI_TABLE_SELECTED(tabelle)
    IF zeile >= 0 AND zeile <> letzteZeile THEN
        letzteZeile = zeile
        DIM tippText AS STRING : tippText = GUI_TABLE_GET_CELL(tabelle, zeile, 3)
        IF tippText <> "-:-" THEN
            DIM teile AS ARRAY OF STRING
            teile = SPLIT$(tippText, ":")
            GUI_SET_VALUE(tippHeim, VAL(teile[0]))
            GUI_SET_VALUE(tippGast, VAL(teile[1]))
        END IF
        melde(GUI_TABLE_GET_CELL(tabelle, zeile, 1) + " gegen " + _
              GUI_TABLE_GET_CELL(tabelle, zeile, 2) + " -- " + restText(zeile))
    END IF

    ' Der Countdown laeuft weiter, auch wenn niemand etwas anklickt.
    ' Einmal je Sekunde reicht -- die Anzeige zeigt keine Zehntel.
    IF zeile >= 0 AND abruf < 0 AND ZEIT_JETZT() <> letzteSekunde THEN
        letzteSekunde = ZEIT_JETZT()
        melde(GUI_TABLE_GET_CELL(tabelle, zeile, 1) + " gegen " + _
              GUI_TABLE_GET_CELL(tabelle, zeile, 2) + " -- " + restText(zeile))
    END IF

    ' --- Tipp speichern ---
    IF GUI_CLICKED(bTipp) THEN
        IF zeile < 0 THEN
            melde("Erst eine Zeile anklicken.")
        ELIF NOT offen(zeile) THEN
            ' Die Sperre steht hier, nicht im Knopf: eine Regel, eine Stelle.
            melde("Zu spaet -- Tippschluss war " + _
                  ZEIT_FORMAT$(tippschluss(zeile), "WT hh:mm") + ".")
        ELSE
            DIM th AS INTEGER : th = INT(GUI_VALUE(tippHeim))
            DIM tg AS INTEGER : tg = INT(GUI_VALUE(tippGast))
            ' Ein Tipp je Spieler und Spiel -- UNIQUE + UPSERT statt
            ' erst suchen, dann entscheiden.
            DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) " + _
                        "VALUES (?, ?, ?, ?) " + _
                        "ON CONFLICT(spieler_id, spiel_id) DO UPDATE SET " + _
                        "  tipp_heim = excluded.tipp_heim, " + _
                        "  tipp_gast = excluded.tipp_gast, punkte = NULL", _
                    aktiverSpieler(), spielId[zeile], th, tg)

            ' Steht das Ergebnis schon, wird gleich neu gewertet.
            DIM r AS DB_RESULT
            r = DB_QUERY(db, "SELECT tore_heim, tore_gast FROM spiele WHERE id = ?", spielId[zeile])
            IF DB_NEXT(r) THEN
                IF NOT DB_IS_NULL(r, 0) THEN
                    punkteNeu(spielId[zeile], DB_GET_INT(r, 0), DB_GET_INT(r, 1))
                END IF
            END IF
            DB_CLOSE_RESULT(r)

            spieleLaden()
            ranglisteLaden()
            melde("Tipp gespeichert: " + STR$(th) + ":" + STR$(tg))
        END IF
    END IF

    ' --- Ergebnis eintragen ---
    IF GUI_CLICKED(bErg) THEN
        IF zeile < 0 THEN
            melde("Erst eine Zeile anklicken.")
        ELSE
            DIM eh AS INTEGER : eh = INT(GUI_VALUE(ergHeim))
            DIM eg AS INTEGER : eg = INT(GUI_VALUE(ergGast))
            ' Steht schon ein Ergebnis, werden alle Punkte dieses Spiels neu
            ' gerechnet. Vorher fragen -- die Rueckfrage steht als Bedingung
            ' da, damit sie nur bei einer echten Aenderung erscheint.
            DIM altes AS STRING : altes = GUI_TABLE_GET_CELL(tabelle, zeile, 4)
            DIM weiter AS BOOLEAN : weiter = TRUE
            IF altes <> "-:-" AND altes <> STR$(eh) + ":" + STR$(eg) THEN
                weiter = GUI_CONFIRM("Ergebnis aendern?", _
                    "Fuer dieses Spiel steht schon " + altes + "." + CHR$(10) + _
                    "Auf " + STR$(eh) + ":" + STR$(eg) + " aendern und alle Punkte neu rechnen?", _
                    "janein")
            END IF
            IF NOT weiter THEN
                melde("Ergebnis unveraendert gelassen.")
            ELSE
                DB_EXEC(db, "UPDATE spiele SET tore_heim = ?, tore_gast = ? WHERE id = ?", _
                        eh, eg, spielId[zeile])
                punkteNeu(spielId[zeile], eh, eg)
                spieleLaden()
                ranglisteLaden()
                melde("Ergebnis " + STR$(eh) + ":" + STR$(eg) + " eingetragen, Punkte neu gerechnet.")
            END IF
        END IF
    END IF

    GRADIENTV(0, 0, SW - 1, SH - 1, &H0A0F16, &H161E29)
    GUI_DRAW()
    FLIP()
WEND

DB_CLOSE(db)
