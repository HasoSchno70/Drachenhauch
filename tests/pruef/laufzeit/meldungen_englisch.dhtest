=== der laeufer haelt die faelle auch auf einem englischen system deutsch
' Der CI-Laeufer spricht Englisch und setzt kein DHRT_LANG -- die deutschen
' Erwartungen muessen trotzdem halten.
IMPORT "helfer.dh"
DIM z AS ARRAY OF STRING : z = []
ARRAY_PUSH(z, "=== deutsch erwartet")
ARRAY_PUSH(z, "PRINT 1 \ 0")
ARRAY_PUSH(z, "--- fehler")
ARRAY_PUSH(z, "Integer-Division durch 0")
WRITEALL("s.dhtest", JOIN$(z, CHR$(10)) + CHR$(10))
SETENV("DHRT_LANG", "")
SETENV("DHRT_SYSTEM_LANG", "en_US")
dlStarten(["test", "s.dhtest"])
PRINT "rueckgabe "; dlCode
IF dlCode <> 0 THEN PRINT dlAus
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0

=== der laeufer nimmt den faellen die sprache
' Die Erwartungen der Pruefsammlungen stehen deutsch da. Startet jemand die
' Pruefung aus der englischen IDE (die DHRT_LANG setzt), duerfen sie nicht
' kippen -- ein Fall, der Englisch will, sagt es in `--- umgebung`.
IMPORT "helfer.dh"
DIM z AS ARRAY OF STRING : z = []
ARRAY_PUSH(z, "=== deutsch erwartet")
ARRAY_PUSH(z, "PRINT 1 \ 0")
ARRAY_PUSH(z, "--- fehler")
ARRAY_PUSH(z, "Integer-Division durch 0")
ARRAY_PUSH(z, "=== englisch verlangt")
ARRAY_PUSH(z, "PRINT 1 \ 0")
ARRAY_PUSH(z, "--- umgebung")
ARRAY_PUSH(z, "DHRT_LANG=en")
ARRAY_PUSH(z, "--- fehler")
ARRAY_PUSH(z, "Integer division by zero")
WRITEALL("s.dhtest", JOIN$(z, CHR$(10)) + CHR$(10))
SETENV("DHRT_LANG", "en")
dlStarten(["test", "s.dhtest"])
PRINT "rueckgabe "; dlCode
IF dlCode <> 0 THEN PRINT dlAus
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0

=== werkzeuge auf englisch: --jit und --export
' Bis 2026-11-24 sprachen `dhrt --jit` und `dhrt --export` auch mit
' DHRT_LANG=en deutsch (ihre Zeilen gingen nicht durch den Katalog), und
' "Exportiert:" nannte unter Windows den ganzen Pfad mit \\?\ davor. Jetzt
' englisch und, liegt das Ziel im Arbeitsordner, relativ zu ihm. Ein Bau
' ohne Maschinencode kennt --jit nicht und ueberspringt sich.
IMPORT "helfer.dh"
dlStarten(["--jit", "prog.dh"])
IF INSTR(dlAus, "VM:") < 0 THEN
    PRINT "UEBERSPRINGEN: Bau ohne Maschinencode"
ELSE
    PRINT dlAus;
    dlStarten(["--export", "prog.dh"])
    PRINT "export "; dlCode
    DIM z AS STRING
    FOR EACH z IN SPLIT$(dlAus, CHR$(10))
        IF LEFT$(z, 9) = "Exported:" THEN PRINT REPLACE$(z, "\", "/") = "Exported: prog_dist/" + exeName$("prog")
    NEXT
END IF
--- umgebung
DHRT_LANG=en
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
IMPORT "{sammlung}/../_hilfen/exportlauf.dh"
--- datei prog.dh
FUNCTION doppelt(a AS INTEGER) AS INTEGER
    RETURN a * 2
END FUNCTION
FUNCTION gruss(a AS STRING) AS STRING
    RETURN "hallo " + a
END FUNCTION
PRINT doppelt(21); gruss("du")
--- erwartet
doppelt: compiled
gruss: VM: slot 0 has the type 'string'
export 0
TRUE

=== die bilanz des maschinencodes auf englisch
' DHRT_JIT_BILANZ=1 zaehlt beim Beenden, was der Maschinencode getan hat;
' Kleine Wunder zitiert daraus. Bis 2026-11-24 blieben diese Zeilen auch
' mit DHRT_LANG=en deutsch.
SUB rechne(t AS TUPLE)
    DIM i AS INTEGER
    DIM w AS STRING
    DIM s AS STRING
    FOR i = 0 TO 3
        w = t[i]
        s = s + w + ","
    NEXT
    PRINT s
END SUB
rechne(("a", "b", "c", "d"))
--- umgebung
DHRT_LANG=en
DHRT_JIT=immer
DHRT_JIT_BILANZ=1
--- erwartet
a,b,c,d,
--- stderr
jit: 0 functions, 1 loops, 1 loop runs

=== der katalog passt zum quelltext
' Jede deutsche Vorlage steht (in ihren festen Stuecken) noch im Quelltext,
' die Platzhalter passen, keine steht doppelt. Eine Vorlage, deren Meldung
' es nicht mehr gibt, uebersetzt nichts -- und die geaenderte Meldung bliebe
' still deutsch.
IMPORT "helfer.dh"
CHDIR(ARG$(0))
dlStarten(["pruef", "meldungen"])
DIM alles AS STRING : alles = dlAus + dlErr
PRINT "ueber 400 vorlagen "; (VAL(alles) > 400)
IF dlCode <> 0 THEN PRINT alles
PRINT "rueckgabe "; dlCode
--- argumente
{sammlung}/../../..
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- erwartet
ueber 400 vorlagen TRUE
rueckgabe 0

=== tastennamen folgen der sprache
' KEY_NAME$ war auch mit DHRT_LANG=en deutsch ("LEER", "LINKS"); die
' eingebauten Texte folgen jetzt der Sprache (Bericht A14.5).
SCREEN(100, 100, "t", 1)
PRINT KEY_NAME$(KEY_SPACE); " "; KEY_NAME$(KEY_LEFT)
--- umgebung
DHRT_FRAMES=1
DHRT_LANG=en
--- erwartet
SPACE LEFT
