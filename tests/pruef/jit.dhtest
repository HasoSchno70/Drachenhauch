=== funktion ohne return liefert nil
FUNCTION vielleicht(a AS INTEGER) AS INTEGER
    IF a > 0 THEN RETURN a * 2
END FUNCTION
FUNCTION kette(a AS INTEGER) AS INTEGER
    RETURN vielleicht(a) + 1
END FUNCTION
PRINT vielleicht(4); " "; kette(4)
PRINT TYPEOF(vielleicht(-1))
