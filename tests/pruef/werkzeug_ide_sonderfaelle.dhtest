blame 3 TRUE

=== git diff zeigt die aenderungen der datei
' Eingecheckt, dann geaendert: zwei geaenderte Zeilen am Rand (`git diff -U0`),
' und Strg+Umschalt+D zeigt den Unterschied.
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=160
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT 1
PRINT 2
PRINT 3
PRINT 4
--- datei _programm/ev.txt
c 6
e 50 2 341 0 0 0
e 50 2 340 0 0 0
e 50 2 68 0 0 0
e 52 1 68 0 0 0
e 52 1 341 0 0 0
e 52 1 340 0 0 0

--- vorher
FUNCTION git(a AS STRING, b AS STRING, c AS STRING, d AS STRING, e AS STRING, f AS STRING) AS INTEGER
    DIM p AS INTEGER
    IF f <> "" THEN
        p = PROCESS_START("git", a, b, c, d, e, f)
    ELSEIF d <> "" THEN
        p = PROCESS_START("git", a, b, c, d)
    ELSEIF c <> "" THEN
        p = PROCESS_START("git", a, b, c)
    ELSE
        p = PROCESS_START("git", a, b)
    END IF
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    WHILE PROCESS_RUNNING(p) AND MILLIS() < bis
        SLEEP(20)
    WEND
    RETURN PROCESS_CODE(p)
END FUNCTION
IF git("init", "-q", "", "", "", "") <> 0 THEN EXIT(3)
IF git("config", "user.name", "Test", "", "", "") <> 0 THEN EXIT(4)
IF git("config", "user.email", "t@t", "", "", "") <> 0 THEN EXIT(5)
IF git("add", "spiel.dh", "", "", "", "") <> 0 THEN EXIT(6)
IF git("commit", "-q", "-m", "erst", "", "") <> 0 THEN EXIT(7)
WRITEALL("spiel.dh", "PRINT 1" + CHR$(10) + "PRINT zwei" + CHR$(10) + "PRINT 3" + CHR$(10) + "PRINT vier" + CHR$(10))
