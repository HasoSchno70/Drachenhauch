' 86_postfx_shaders.gb -- Post-Processing per GLSL-Shader (NUR native Runtime).
'
' Die ganze Szene wird in eine RenderTexture gerendert und dann durch einen
' Fragment-Shader auf den Screen praesentiert. Alle 3 Sekunden wechselt der
' Effekt:  AUS -> CRT -> BLOOM -> VIGNETTE.
'
' Ausfuehren:  gbrun.py --native examples\86_postfx_shaders.gb   (oder F6)
' Im pygame-Pfad (F5) laeuft die Szene OHNE Effekt (SHADER_LOAD liefert -1).
' ESC beendet.

IMPORT "g3d"

CONST W AS INTEGER = 1280
CONST H AS INTEGER = 720
CONST TWO_PI AS FLOAT = 6.2831853

SCREEN(W, H, "GameBasic -- Post-Processing", 1)

' Shader laden (Pfad relativ zur .gb-Datei).
DIM sh_crt AS INTEGER
sh_crt = SHADER_LOAD("assets/shaders/crt.fs")
DIM sh_bloom AS INTEGER
sh_bloom = SHADER_LOAD("assets/shaders/bloom.fs")
DIM sh_vig AS INTEGER
sh_vig = SHADER_LOAD("assets/shaders/vignette.fs")

' resolution-Uniform (CRT + Bloom brauchen sie).
SHADER_SET2(sh_crt, "resolution", W, H)
SHADER_SET2(sh_bloom, "resolution", W, H)

DIM names AS ARRAY OF STRING
names = SPLIT$("AUS|CRT|BLOOM|VIGNETTE", "|")

FUNCTION neon(i AS INTEGER, t AS FLOAT) AS INTEGER
    DIM p AS FLOAT
    p = i * 0.7 + t
    DIM r AS INTEGER
    DIM g AS INTEGER
    DIM b AS INTEGER
    r = INT((0.5 + 0.5 * SIN(p)) * 255.0)
    g = INT((0.5 + 0.5 * SIN(p + 2.094)) * 255.0)
    b = INT((0.5 + 0.5 * SIN(p + 4.188)) * 255.0)
    RETURN RGB(r, g, b)
END FUNCTION

DIM t0 AS INTEGER
t0 = MILLIS()

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    DIM t AS FLOAT
    t = (MILLIS() - t0) / 1000.0

    DIM mode AS INTEGER
    mode = INT(t / 3.0) MOD 4

    SHADER_SET(sh_crt, "time", t)        ' CRT-Flacker animieren

    IF mode = 1 THEN
        POSTFX(sh_crt)
    ELSEIF mode = 2 THEN
        POSTFX(sh_bloom)
    ELSEIF mode = 3 THEN
        POSTFX(sh_vig)
    ELSE
        POSTFX(-1)
    END IF

    CLS(&H06080F)

    ' 3D: rotierende, helle Wuerfel + leuchtende Mittelkugel (Bloom-Quellen).
    CAMERA3D(COS(t * 0.5) * 8.0, 4.0, SIN(t * 0.5) * 8.0, 0.0, 0.5, 0.0, 55.0)
    GRID3D(20, 1.0)
    DIM i AS INTEGER
    FOR i = 0 TO 5
        DIM a AS FLOAT
        a = (i / 6) * TWO_PI + t
        CUBE(COS(a) * 3.0, 1.0, SIN(a) * 3.0, 1.0, 1.0, 1.0, neon(i, t))
    NEXT
    SPHERE(0.0, 1.5, 0.0, 1.1, &HFFFFFF)

    ' 2D-Overlay: helle Neon-Balken + Text (zeigen CRT-Scanlines/Bloom gut).
    FOR i = 0 TO 11
        DIM bh AS INTEGER
        bh = 30 + INT((0.5 + 0.5 * SIN(t * 3.0 + i * 0.5)) * 120.0)
        BOX(60 + i * 95, H - 80 - bh, 60 + i * 95 + 60, H - 80, neon(i + 3, t))
    NEXT

    TEXT_SIZE(46)
    TEXT(40, 30, "POST  PROCESSING", &HFFFFFF)
    TEXT_SIZE(22)
    TEXT(40, 86, "Effekt: " + names[mode] + "   (wechselt alle 3s, ESC = Ende)", &H80E0FF)
    TEXT(40, 112, "Szene -> RenderTexture -> GLSL-Shader -> Screen", &H5A8AA8)

    FLIP()
    SLEEP(8)
WEND

POSTFX(-1)
