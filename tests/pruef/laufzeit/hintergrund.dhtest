DB_EXEC(c, "CREATE TABLE zahlen (a INTEGER, b TEXT)")
DB_BEGIN(c)
DIM i AS INTEGER
FOR i = 0 TO 10 - 1
    DB_EXEC(c, "INSERT INTO zahlen VALUES (?, ?)", i, "zeile " + STR$(i))
NEXT
DB_COMMIT(c)
DB_CLOSE(c)
--- erwartet
gefangen

