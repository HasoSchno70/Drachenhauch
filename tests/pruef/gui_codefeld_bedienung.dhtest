=== bei kurzem text gibt es keinen rollbalken
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM kurz AS GUI_WIDGET : kurz = GUI_TEXTAREA(w, 10, 10, 135, 200)
GUI_SET_TEXT(kurz, "eins")
DIM lang AS GUI_WIDGET : lang = GUI_TEXTAREA(w, 155, 10, 135, 200)
DIM t AS STRING : t = "zeile 1"
DIM k AS INTEGER
FOR k = 2 TO 100
    t = t + CHR$(10) + "zeile " + STR$(k)
NEXT
GUI_SET_TEXT(lang, t)
GUI_TEXTAREA_GOTO(lang, 1, 1)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
    IF bild = 3 THEN SAVESCREENSHOT("t.png")
WEND
' Der Griff steht oben rechts im Innenabstand: Spalte x = rechter Rand - 4.
DIM b AS IMAGE : b = LOADIMAGE("t.png")
PRINT "kurz "; GETPIXEL(b, 141, 30) <> GETPIXEL(b, 100, 30); " lang "; GETPIXEL(b, 286, 30) <> GETPIXEL(b, 250, 30)
--- umgebung
DHRT_FRAMES=5
--- erwartet
kurz FALSE lang TRUE
