' Star Pilot - Kap 5, Schritt 3: erste BOX auf dem Bildschirm.
'
' Pro Frame: Hintergrund + ein gelbes Rechteck am unteren Rand. Der erste
' visuelle Player.

SCREEN(320, 240, "Star Pilot", 2)

WHILE NOT QUITREQUESTED()
    CLS(RGB(20, 30, 60))
    BOX(140, 200, 180, 224, RGB(255, 220, 0))
    FLIP()
    SLEEP(16)
WEND
