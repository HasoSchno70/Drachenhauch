' Das Beispiel examples/karten (Dogfooding-Runde 15): eine Landkarte aus
' OpenStreetMap-Kacheln mit GPX-Spur, Markern, Ortssuche und Ausfuhr.
'
' Der Kern (Projektion, Entfernungen, GPX) wird gegen eine Rechnung in
' JavaScript geprueft, die von dhrt nichts weiss. Die Kacheln kommen von einem
' Gegenserver auf 127.0.0.1 (tests/pruef/_hilfen/gegenserver.dh, Modus
' dateien), der die Kacheln ausliefert, die der Fall vorher selbst gemalt
' hat -- jede in einer Farbe, die sich aus z/x/y rechnen laesst. So laesst
' sich am gezeichneten Bild pruefen, ob die richtige Kachel an der richtigen
' Stelle liegt. Kein Fall fragt die echten Server von OpenStreetMap.
--- seriell
--- langsam

=== kern rechnet wie eine fremde rechnung
' Die Erwartungen stammen aus einer Rechnung in JavaScript (Haversine und
' Web-Mercator nach der Formel von OpenStreetMap); Kachel 550/335 bei Zoom 10
' ist die des Brandenburger Tors.
IMPORT "kern.dh"
PRINT kachelNr(weltX(13.3777, 10)); " "; kachelNr(weltY(52.5163, 10))
PRINT FORMAT$(lonAus(weltX(13.3777, 15), 15), "%.6f"); " "; FORMAT$(latAus(weltY(52.5163, 15), 15), "%.6f")
PRINT FORMAT$(abstandM(52.5163, 13.3777, 48.1374, 11.5755) / 1000, "%.3f")
PRINT FORMAT$(meterJePunkt(52.5163, 15), "%.4f"); " "; massstabMeter(52.5163, 15, 120); " "; streckeText$(1234.5)
PRINT kachelX(-1, 3); " "; kachelX(9, 3)
' Zwei Abschnitte, eine Route ohne Hoehen, ein Wegpunkt: zwischen den Teilen
' wird nicht gezaehlt, Hoehen mit 3 m Totband
DIM sp AS Spur : sp = gpxLesen(READALL$("probe.gpx"))
PRINT sp.name; " "; sp.anzahl(); " "; FORMAT$(sp.laenge, "%.3f"); " "; sp.auf; " "; sp.ab
PRINT LEN(mkName); " "; mkName[0]
DIM s AS FLOAT : DIM w AS FLOAT : DIM n AS FLOAT : DIM o AS FLOAT
(s, w, n, o) = spurRahmen(sp)
PRINT s; " "; w; " "; n; " "; o; " zoom "; zoomFuer(s, w, n, o, 800, 600)
' Marker hin und zurueck: als JSON und als GPX (dort kommen sie als Wegpunkte
' wieder herein -- und nicht doppelt, wenn sie schon da sind)
markerSetzen(52.5, 13.4, "Zweiter")
DIM j AS STRING : j = markerJson$()
mkLat = [] : mkLon = [] : mkName = []
markerAusJson(j)
PRINT LEN(mkName); " "; mkName[1]; " "; mkLat[1]
DIM g AS STRING : g = markerGpx$()
DIM sp2 AS Spur : sp2 = gpxLesen(g)
PRINT LEN(mkName); " "; sp2.anzahl()
mkLat = [] : mkLon = [] : mkName = []
sp2 = gpxLesen(g)
PRINT LEN(mkName); " "; mkName[0]
--- datei kern.dh
IMPORT "{sammlung}/../../examples/karten/kern.dh"

