' ============================================================
'  Drachenhauch Studio -- das Modell eines Fensters
' ============================================================
'  Das Fenster IST sein .dhform-JSON (json-Modul): Sichern, Laden und
'  Rueckgaengig benutzen dasselbe Format, das GUI_SAVE/GUI_LOAD lesen. Die
'  Entwurfsflaeche (entwurf.dh) ist nur eine Ansicht davon -- jede Aenderung
'  schreibt hierher und baut sie neu (gemessen: 1000 Controls in 2,7 ms).
'  Uebernommen aus dem Form-Designer (examples/197_form_designer.dh).
' ============================================================

CONST RASTER = 8

DIM doc AS JSON_HANDLE : doc = JSON_PARSE(leeresFenster$())
DIM formPfad AS STRING : formPfad = ""
DIM auswahl AS INTEGER : auswahl = -1           ' Index in doc.widgets, -1 = das Fenster
' Mehrfachauswahl: alle gewaehlten Indizes; `auswahl` ist darunter das zuletzt
' angeklickte -- der Inspektor zeigt es, "Anordnen" richtet an ihm aus.
DIM gewaehlt AS ARRAY OF INTEGER : gewaehlt = []
DIM geaendert AS BOOLEAN : geaendert = FALSE

' Rueckgaengig: ein JSON-Text je Stand, ein Zeiger darauf.
DIM staende AS ARRAY OF STRING : staende = []
DIM standPos AS INTEGER : standPos = -1

FUNCTION leeresFenster$() AS STRING
    RETURN REPLACE$("{'title':'Fenster1','name':'Fenster1','x':0,'y':0,'w':600,'h':400,'movable':true,'closable':true,'visible':true,'resizable':false,'widgets':[]}", "'", CHR$(34))
END FUNCTION

FUNCTION anzahl() AS INTEGER
    RETURN JSON_LEN(doc, "widgets")
END FUNCTION

' Pfad zu einem Feld eines Controls.
FUNCTION wz$(i AS INTEGER, feld AS STRING) AS STRING
    RETURN "widgets." + STR$(i) + "." + feld
END FUNCTION

FUNCTION feldText$(i AS INTEGER, feld AS STRING) AS STRING
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN ""
    IF JSON_TYPE(doc, wz$(i, feld)) <> "string" THEN RETURN ""
    RETURN JSON_GET_STRING(doc, wz$(i, feld))
END FUNCTION

FUNCTION feldZahl(i AS INTEGER, feld AS STRING) AS INTEGER
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN 0
    IF JSON_TYPE(doc, wz$(i, feld)) <> "number" THEN RETURN 0
    RETURN INT(JSON_GET_FLOAT(doc, wz$(i, feld)))
END FUNCTION

FUNCTION feldKomma(i AS INTEGER, feld AS STRING, vorgabe AS FLOAT) AS FLOAT
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN vorgabe
    IF JSON_TYPE(doc, wz$(i, feld)) <> "number" THEN RETURN vorgabe
    RETURN JSON_GET_FLOAT(doc, wz$(i, feld))
END FUNCTION

FUNCTION feldSchalter(i AS INTEGER, feld AS STRING, vorgabe AS BOOLEAN) AS BOOLEAN
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN vorgabe
    IF JSON_TYPE(doc, wz$(i, feld)) <> "boolean" THEN RETURN vorgabe
    RETURN JSON_GET_BOOL(doc, wz$(i, feld))
END FUNCTION

FUNCTION fensterZahl(feld AS STRING) AS INTEGER
    IF NOT JSON_HAS(doc, feld) THEN RETURN 0
    RETURN INT(JSON_GET_FLOAT(doc, feld))
END FUNCTION

FUNCTION fensterText$(feld AS STRING) AS STRING
    IF NOT JSON_HAS(doc, feld) THEN RETURN ""
    RETURN JSON_GET_STRING(doc, feld)
END FUNCTION

' Einträge (items) als Text mit Semikolon -- so stehen sie im Inspektor.
FUNCTION eintraegeText$(i AS INTEGER) AS STRING
    IF NOT JSON_HAS(doc, wz$(i, "items")) THEN RETURN ""
    DIM teile AS ARRAY OF STRING : teile = []
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(doc, wz$(i, "items")) - 1
        ARRAY_PUSH(teile, JSON_GET_STRING(doc, wz$(i, "items") + "." + STR$(k)))
    NEXT
    RETURN JOIN$(teile, "; ")
END FUNCTION

SUB eintraegeSetzen(i AS INTEGER, text AS STRING)
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    DIM t AS STRING
    FOR EACH t IN SPLIT(text, ";")
        IF TRIM$(t) <> "" THEN JSON_APPEND_STRING(a, "", TRIM$(t))
    NEXT
    JSON_SET_JSON(doc, wz$(i, "items"), a)
END SUB

' --- Auswahl ------------------------------------------------------------------
SUB auswahlSetzen(i AS INTEGER)
    auswahl = i
    trayWahl = -1
    abstandL = -1
    abstandK = -1
    IF i >= 0 THEN gewaehlt = [i] ELSE gewaehlt = []
END SUB

FUNCTION istGewaehlt(i AS INTEGER) AS BOOLEAN
    RETURN ARRAY_INDEXOF(gewaehlt, i) >= 0
END FUNCTION

' Umschalt/Strg+Klick: dazu oder wieder weg.
SUB auswahlUmschalten(i AS INTEGER)
    IF istGewaehlt(i) THEN
        gewaehlt = ARRAY_FILTER(gewaehlt, FUNCTION(j) j <> i)
        IF LEN(gewaehlt) > 0 THEN auswahl = gewaehlt[LEN(gewaehlt) - 1] ELSE auswahl = -1
    ELSE
        ARRAY_PUSH(gewaehlt, i)
        auswahl = i
    END IF
END SUB

' Nach Rueckgaengig oder Loeschen: was es nicht mehr gibt, faellt heraus.
SUB auswahlBereinigen()
    DIM n AS INTEGER : n = anzahl()
    gewaehlt = ARRAY_FILTER(gewaehlt, FUNCTION(j) j >= 0 AND j < n)
    IF auswahl >= n OR NOT istGewaehlt(auswahl) THEN
        IF LEN(gewaehlt) > 0 THEN auswahl = gewaehlt[LEN(gewaehlt) - 1] ELSE auswahl = -1
    END IF
    IF abstandL >= 0 THEN
        DIM ok AS BOOLEAN : ok = istLayout(abstandL)
        IF ok THEN ok = abstandK < LEN(kinderListe(abstandL))
        IF ok THEN ok = kinderListe(abstandL)[abstandK] < 0
        IF NOT ok THEN abstandL = -1 : abstandK = -1
    END IF
END SUB

SUB allesWaehlen()
    gewaehlt = []
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        ARRAY_PUSH(gewaehlt, i)
    NEXT
    IF anzahl() > 0 THEN auswahl = anzahl() - 1 ELSE auswahl = -1
END SUB

' --- Namen --------------------------------------------------------------------
' `ausser`: ein Control (Index), ein Timer (TRAY + Index) oder -1. Timer und
' benannte Menueeintraege teilen sich die Namen mit den Controls -- alle
' werden zu Feldern derselben Fensterklasse.
FUNCTION nameVergeben(kandidat AS STRING, ausser AS INTEGER) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        IF i <> ausser AND LOWER$(feldText$(i, "name")) = LOWER$(kandidat) THEN RETURN TRUE
    NEXT
    FOR i = 0 TO timerZahl() - 1
        IF TRAY + i <> ausser AND LOWER$(timerName$(i)) = LOWER$(kandidat) THEN RETURN TRUE
    NEXT
    DIM mn AS ARRAY OF STRING : mn = []
    DIM ma AS ARRAY OF STRING : ma = []
    menueNamenSammeln(doc, "menus", mn, ma)
    DIM s AS STRING
    FOR EACH s IN mn
        IF LOWER$(s) = LOWER$(kandidat) AND ausser <> MENUE_NAME THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' --- Timer: unsichtbare Controls, als Liste "timer" im Layout ---------------------
CONST TRAY = 100000                 ' Timer k heisst in nameVergeben TRAY + k
CONST MENUE_NAME = -7               ' nameVergeben aus dem Menue-Editor (prueft dort selbst)
DIM trayWahl AS INTEGER : trayWahl = -1     ' gewaehlter Timer, -1 = keiner
' Ein gewaehlter Abstandhalter: Layout und Stelle in seiner Liste (-1 = keiner).
DIM abstandL AS INTEGER : abstandL = -1
DIM abstandK AS INTEGER : abstandK = -1

FUNCTION timerZahl() AS INTEGER
    IF NOT JSON_HAS(doc, "timer") THEN RETURN 0
    RETURN JSON_LEN(doc, "timer")
END FUNCTION

FUNCTION timerName$(k AS INTEGER) AS STRING
    RETURN JSON_GET_STRING(doc, "timer." + STR$(k) + ".name")
END FUNCTION

FUNCTION timerAnlegen() AS INTEGER
    IF NOT JSON_HAS(doc, "timer") THEN JSON_SET_JSON(doc, "timer", JSON_NEW_ARRAY())
    DIM t AS JSON_HANDLE : t = JSON_NEW_OBJECT()
    JSON_SET_STRING(t, "name", eindeutigerName$("Timer"))
    JSON_SET_INT(t, "intervall", 1000)
    JSON_SET_BOOL(t, "aktiv", TRUE)
    JSON_SET_BOOL(t, "wiederholen", TRUE)
    JSON_APPEND_JSON(doc, "timer", t)
    RETURN timerZahl() - 1
END FUNCTION

' Ein Name, wie Xojo ihn vergibt: Grundwort und die naechste freie Zahl.
FUNCTION eindeutigerName$(grund AS STRING) AS STRING
    DIM n AS INTEGER : n = 1
    WHILE nameVergeben(grund + STR$(n), -1)
        n = n + 1
    WEND
    RETURN grund + STR$(n)
END FUNCTION

' Ein Name muss ein Bezeichner sein: er wird zum Feld der Fensterklasse.
FUNCTION istBezeichner(s AS STRING) AS BOOLEAN
    RETURN REGEX_TEST(s, "^[A-Za-z][A-Za-z0-9_]*$")
END FUNCTION

FUNCTION amRaster(v AS INTEGER) AS INTEGER
    IF v >= 0 THEN RETURN ((v + RASTER \ 2) \ RASTER) * RASTER
    RETURN -(((-v) + RASTER \ 2) \ RASTER) * RASTER
END FUNCTION

' --- Rueckgaengig -------------------------------------------------------------
' Stand merken, nach jeder abgeschlossenen Aenderung.
SUB merken()
    DIM text AS STRING : text = JSON_STRINGIFY(doc)
    ' Derselbe Stand noch einmal ist kein Schritt -- sonst braeuchte ein
    ' Rueckgaengig zwei Tastendruecke, ohne dass sich etwas tut.
    IF standPos >= 0 AND standPos < LEN(staende) THEN
        IF staende[standPos] = text THEN RETURN
    END IF
    WHILE LEN(staende) > standPos + 1
        ARRAY_REMOVE_AT(staende, LEN(staende) - 1)
    WEND
    ARRAY_PUSH(staende, text)
    IF LEN(staende) > 200 THEN ARRAY_REMOVE_AT(staende, 0)
    standPos = LEN(staende) - 1
    geaendert = TRUE
END SUB

FUNCTION kannZurueck() AS BOOLEAN
    RETURN standPos > 0
END FUNCTION

FUNCTION kannVor() AS BOOLEAN
    RETURN standPos < LEN(staende) - 1
END FUNCTION

' --- Controls anlegen, loeschen, verdoppeln, ordnen ----------------------------
' Liefert den Index des neuen Controls. `p` ist der Baustein (bibliothek.dh).
FUNCTION controlAnlegen(p AS INTEGER, x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM b AS Baustein : b = bausteine[p]
    DIM w AS JSON_HANDLE : w = JSON_NEW_OBJECT()
    JSON_SET_STRING(w, "kind", b.kind)
    JSON_SET_STRING(w, "name", eindeutigerName$(b.grundname))
    JSON_SET_INT(w, "x", x) : JSON_SET_INT(w, "y", y)
    JSON_SET_INT(w, "w", b.b) : JSON_SET_INT(w, "h", b.h)
    IF b.text <> "" THEN JSON_SET_STRING(w, "text", b.text)
    IF b.vorlage <> "" THEN
        ' Zusaetzliche Felder (Eintraege, Tabellenkopf, Gitter ...) als JSON.
        DIM v AS JSON_HANDLE : v = JSON_PARSE(REPLACE$(b.vorlage, "'", CHR$(34)))
        DIM k AS STRING
        FOR EACH k IN JSON_KEYS(v, "")
            JSON_SET_JSON(w, k, JSON_GET_JSON(v, k))
        NEXT
    END IF
    JSON_APPEND_JSON(doc, "widgets", w)
    RETURN anzahl() - 1
END FUNCTION

SUB controlsLoeschen()
    ' Von hinten nach vorn -- sonst rueckten die Nummern der uebrigen auf.
    DIM weg AS ARRAY OF INTEGER : weg = gewaehlt
    SORT(weg)
    ' Die Kinder eines geloeschten Layouts bleiben, frei an der Stelle, an
    ' der man sie gesehen hat.
    DIM l AS INTEGER
    FOR EACH l IN weg
        IF NOT istLayout(l) THEN CONTINUE
        DIM c AS INTEGER
        FOR EACH c IN kinderListe(l)
            IF c < 0 OR ARRAY_INDEXOF(weg, c) >= 0 THEN CONTINUE
            DIM cx AS INTEGER
            DIM cy AS INTEGER
            DIM cb AS INTEGER
            DIM ch AS INTEGER
            (cx, cy, cb, ch) = lageVon(c)
            JSON_SET_INT(doc, wz$(c, "x"), cx) : JSON_SET_INT(doc, wz$(c, "y"), cy)
        NEXT
    NEXT
    DIM abb AS ARRAY OF INTEGER : abb = []
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO anzahl() - 1
        IF ARRAY_INDEXOF(weg, i) >= 0 THEN
            ARRAY_PUSH(abb, -1)
        ELSE
            ARRAY_PUSH(abb, n)
            n = n + 1
        END IF
    NEXT
    DIM k AS INTEGER
    FOR k = LEN(weg) - 1 TO 0 STEP -1
        JSON_REMOVE(doc, "widgets." + STR$(weg[k]))
    NEXT
    indizesUmbauen(abb)
    auswahlSetzen(-1)
END SUB

SUB controlsVerdoppeln()
    DIM neue AS ARRAY OF INTEGER : neue = []
    DIM neuHaupt AS INTEGER : neuHaupt = -1
    DIM quellen AS ARRAY OF INTEGER : quellen = gewaehlt
    DIM q AS INTEGER
    FOR EACH q IN quellen
        ' Liegt ein gewaehltes Layout darueber, kommt die Kopie mit ihm.
        DIM mit AS BOOLEAN : mit = FALSE
        DIM o AS INTEGER
        FOR EACH o IN quellen
            IF o <> q AND istVorfahr(o, q) THEN mit = TRUE
        NEXT
        IF mit THEN CONTINUE
        DIM c AS INTEGER : c = kopieAnlegen(q, 2 * RASTER, 2 * RASTER)
        ' Die Kopie eines Kindes steht im selben Layout gleich dahinter.
        DIM l AS INTEGER : l = elternVon(q)
        IF l >= 0 THEN kindEinfuegen(l, c, stelleIn(l, q) + 1, gewichtVon(q))
        ARRAY_PUSH(neue, c)
        IF q = auswahl THEN neuHaupt = c
    NEXT
    gewaehlt = neue
    auswahl = neuHaupt
    IF auswahl < 0 AND LEN(neue) > 0 THEN auswahl = neue[LEN(neue) - 1]
END SUB

' Ein Control kopieren, ein Layout samt seinen Kindern. Liefert den neuen Index.
FUNCTION kopieAnlegen(q AS INTEGER, dx AS INTEGER, dy AS INTEGER) AS INTEGER
    DIM neu AS JSON_HANDLE : neu = JSON_GET_JSON(doc, "widgets." + STR$(q))
    JSON_SET_INT(neu, "x", feldZahl(q, "x") + dx)
    JSON_SET_INT(neu, "y", feldZahl(q, "y") + dy)
    DIM grund AS STRING : grund = REGEX_REPLACE(feldText$(q, "name"), "[0-9]+$", "")
    IF grund = "" THEN grund = feldText$(q, "kind")
    JSON_SET_STRING(neu, "name", eindeutigerName$(grund))
    IF istLayout(q) THEN JSON_SET_JSON(neu, "layout.kinder", JSON_NEW_ARRAY())
    JSON_APPEND_JSON(doc, "widgets", neu)
    DIM n AS INTEGER : n = anzahl() - 1
    IF istLayout(q) THEN
        DIM alt AS ARRAY OF INTEGER : alt = kinderListe(q)
        DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(q)
        DIM kopien AS ARRAY OF INTEGER : kopien = []
        DIM k AS INTEGER
        FOR k = 0 TO LEN(alt) - 1
            IF alt[k] < 0 THEN
                ARRAY_PUSH(kopien, -1)
            ELSE
                ARRAY_PUSH(kopien, kopieAnlegen(alt[k], dx, dy))
            END IF
        NEXT
        kinderSetzen(n, kopien, gew)
    END IF
    RETURN n
END FUNCTION

' Reihenfolge = Zeichenreihenfolge: das letzte liegt vorn.
SUB controlOrdnen(nachVorn AS BOOLEAN)
    IF auswahl < 0 THEN RETURN
    DIM n AS INTEGER : n = anzahl()
    DIM abb AS ARRAY OF INTEGER : abb = []
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        IF i = auswahl THEN
            ARRAY_PUSH(abb, IIF(nachVorn, n - 1, 0))
        ELSEIF nachVorn THEN
            ARRAY_PUSH(abb, IIF(i > auswahl, i - 1, i))
        ELSE
            ARRAY_PUSH(abb, IIF(i < auswahl, i + 1, i))
        END IF
    NEXT
    DIM kopie AS JSON_HANDLE : kopie = JSON_GET_JSON(doc, "widgets." + STR$(auswahl))
    JSON_REMOVE(doc, "widgets." + STR$(auswahl))
    IF nachVorn THEN
        JSON_APPEND_JSON(doc, "widgets", kopie)
        indizesUmbauen(abb)
        auswahlSetzen(n - 1)
    ELSE
        DIM neu AS JSON_HANDLE : neu = JSON_NEW_ARRAY()
        JSON_APPEND_JSON(neu, "", kopie)
        FOR i = 0 TO n - 2
            JSON_APPEND_JSON(neu, "", JSON_GET_JSON(doc, "widgets." + STR$(i)))
        NEXT
        JSON_SET_JSON(doc, "widgets", neu)
        indizesUmbauen(abb)
        auswahlSetzen(0)
    END IF
END SUB

' --- Layout-Behaelter -----------------------------------------------------------
'  Ein Layout (Zeile, Spalte, Raster) fuehrt seine Kinder so, wie GUI_SAVE es
'  schreibt: widgets.N.layout.kinder = [[Index, Gewicht], ...], -1 = ein
'  Abstandhalter. Die Laufzeit legt die Kinder selbst -- auch im
'  Entwurfsfenster --, ihr x/y im Modell zaehlt nicht, w/h ist ihre eigene
'  Groesse. Alles, was Indizes verschiebt (Loeschen, Ordnen), zieht die
'  Listen ueber indizesUmbauen nach; ein Widget steht in hoechstens EINEM
'  Layout.
FUNCTION istLayout(i AS INTEGER) AS BOOLEAN
    IF i < 0 OR i >= anzahl() THEN RETURN FALSE
    RETURN feldText$(i, "kind") = "layout"
END FUNCTION

FUNCTION kinderListe(l AS INTEGER) AS ARRAY OF INTEGER
    DIM r AS ARRAY OF INTEGER : r = []
    IF NOT JSON_HAS(doc, wz$(l, "layout.kinder")) THEN RETURN r
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(doc, wz$(l, "layout.kinder")) - 1
        ARRAY_PUSH(r, JSON_GET_INT(doc, wz$(l, "layout.kinder." + STR$(k) + ".0")))
    NEXT
    RETURN r
END FUNCTION

FUNCTION gewichtListe(l AS INTEGER) AS ARRAY OF INTEGER
    DIM r AS ARRAY OF INTEGER : r = []
    IF NOT JSON_HAS(doc, wz$(l, "layout.kinder")) THEN RETURN r
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(doc, wz$(l, "layout.kinder")) - 1
        DIM p AS STRING : p = wz$(l, "layout.kinder." + STR$(k) + ".1")
        IF JSON_HAS(doc, p) THEN
            ARRAY_PUSH(r, JSON_GET_INT(doc, p))
        ELSE
            ARRAY_PUSH(r, 0)
        END IF
    NEXT
    RETURN r
END FUNCTION

SUB kinderSetzen(l AS INTEGER, kinder AS ARRAY OF INTEGER, gewichte AS ARRAY OF INTEGER)
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    DIM k AS INTEGER
    FOR k = 0 TO LEN(kinder) - 1
        DIM paar AS JSON_HANDLE : paar = JSON_NEW_ARRAY()
        JSON_APPEND_INT(paar, "", kinder[k])
        JSON_APPEND_INT(paar, "", IIF(k < LEN(gewichte), gewichte[k], 0))
        JSON_APPEND_JSON(a, "", paar)
    NEXT
    JSON_SET_JSON(doc, wz$(l, "layout.kinder"), a)
END SUB

' Fuer ein Fenster, auch eines, das nicht vorn ist: je Widget das Layout,
' in dem es steht, -1 = frei.
FUNCTION elternAus(d AS JSON_HANDLE) AS ARRAY OF INTEGER
    DIM r AS ARRAY OF INTEGER : r = []
    IF NOT JSON_HAS(d, "widgets") THEN RETURN r
    DIM n AS INTEGER : n = JSON_LEN(d, "widgets")
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        ARRAY_PUSH(r, -1)
    NEXT
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = "widgets." + STR$(i) + ".layout.kinder"
        IF NOT JSON_HAS(d, p) THEN CONTINUE
        DIM k AS INTEGER
        FOR k = 0 TO JSON_LEN(d, p) - 1
            DIM c AS INTEGER : c = JSON_GET_INT(d, p + "." + STR$(k) + ".0")
            IF c >= 0 AND c < n THEN r[c] = i
        NEXT
    NEXT
    RETURN r
END FUNCTION

' Das Layout, in dem i steht (-1 = frei).
FUNCTION elternVon(i AS INTEGER) AS INTEGER
    IF i < 0 THEN RETURN -1
    DIM l AS INTEGER
    FOR l = 0 TO anzahl() - 1
        IF NOT istLayout(l) THEN CONTINUE
        IF ARRAY_INDEXOF(kinderListe(l), i) >= 0 THEN RETURN l
    NEXT
    RETURN -1
END FUNCTION

FUNCTION stelleIn(l AS INTEGER, i AS INTEGER) AS INTEGER
    RETURN ARRAY_INDEXOF(kinderListe(l), i)
END FUNCTION

' Steht b (mittelbar) in a?
FUNCTION istVorfahr(a AS INTEGER, b AS INTEGER) AS BOOLEAN
    IF a < 0 OR b < 0 THEN RETURN FALSE
    DIM e AS INTEGER : e = elternVon(b)
    DIM stufe AS INTEGER : stufe = 0
    WHILE e >= 0 AND stufe < 64
        IF e = a THEN RETURN TRUE
        e = elternVon(e)
        stufe = stufe + 1
    WEND
    RETURN FALSE
END FUNCTION

FUNCTION gewichtVon(i AS INTEGER) AS INTEGER
    DIM l AS INTEGER : l = elternVon(i)
    IF l < 0 THEN RETURN 0
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    RETURN gew[stelleIn(l, i)]
END FUNCTION

SUB gewichtSetzen(i AS INTEGER, g AS INTEGER)
    DIM l AS INTEGER : l = elternVon(i)
    IF l < 0 THEN RETURN
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    gew[stelleIn(l, i)] = MAX(0, g)
    kinderSetzen(l, kinderListe(l), gew)
END SUB

SUB kindEntfernen(i AS INTEGER)
    DIM l AS INTEGER : l = elternVon(i)
    IF l < 0 THEN RETURN
    DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    DIM k AS INTEGER : k = ARRAY_INDEXOF(kinder, i)
    ARRAY_REMOVE_AT(kinder, k)
    ARRAY_REMOVE_AT(gew, k)
    kinderSetzen(l, kinder, gew)
END SUB

' i an Stelle `pos` in Layout l -- gezaehlt in der Liste, wie sie VOR dem
' Herausnehmen ist: stand i dort schon weiter vorn, rueckt die Stelle um eins.
SUB kindEinfuegen(l AS INTEGER, i AS INTEGER, pos AS INTEGER, gewicht AS INTEGER)
    IF l = i OR istVorfahr(i, l) THEN RETURN
    DIM vorher AS INTEGER : vorher = stelleIn(l, i)
    IF vorher >= 0 AND vorher < pos THEN pos = pos - 1
    kindEntfernen(i)
    DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    pos = MAX(0, MIN(pos, LEN(kinder)))
    ARRAY_INSERT(kinder, pos, i)
    ARRAY_INSERT(gew, pos, gewicht)
    kinderSetzen(l, kinder, gew)
END SUB

' Mehrere Controls an Stelle `pos` (gezaehlt in der Liste, wie sie VOR dem
' Herausnehmen ist), in dieser Reihenfolge. Wer aus einem anderen Layout
' kommt, behaelt sein Gewicht; ein Layout kommt nicht in sich selbst.
SUB kinderEinfuegen(l AS INTEGER, liste AS ARRAY OF INTEGER, pos AS INTEGER)
    DIM mit AS ARRAY OF INTEGER : mit = []
    DIM gewichte AS ARRAY OF INTEGER : gewichte = []
    DIM i AS INTEGER
    FOR EACH i IN liste
        IF i = l OR istVorfahr(i, l) THEN CONTINUE
        ARRAY_PUSH(mit, i)
        ARRAY_PUSH(gewichte, gewichtVon(i))
    NEXT
    ' Die Stelle nach dem Herausnehmen: was davor steht und bleibt.
    DIM alt AS ARRAY OF INTEGER : alt = kinderListe(l)
    DIM neu AS INTEGER : neu = 0
    DIM k AS INTEGER
    FOR k = 0 TO MIN(pos, LEN(alt)) - 1
        IF alt[k] < 0 OR ARRAY_INDEXOF(mit, alt[k]) < 0 THEN neu = neu + 1
    NEXT
    FOR EACH i IN mit
        kindEntfernen(i)
    NEXT
    DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    neu = MIN(neu, LEN(kinder))
    FOR k = 0 TO LEN(mit) - 1
        ARRAY_INSERT(kinder, neu + k, mit[k])
        ARRAY_INSERT(gew, neu + k, gewichte[k])
    NEXT
    kinderSetzen(l, kinder, gew)
END SUB

' --- Abstandhalter: ein Eintrag -1 in der Liste, Gewicht = Anteil am Rest ---
SUB abstandEinfuegen(l AS INTEGER, pos AS INTEGER, gewicht AS INTEGER)
    DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    pos = MAX(0, MIN(pos, LEN(kinder)))
    ARRAY_INSERT(kinder, pos, -1)
    ARRAY_INSERT(gew, pos, gewicht)
    kinderSetzen(l, kinder, gew)
END SUB

SUB abstandEntfernen(l AS INTEGER, k AS INTEGER)
    DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    IF k < 0 OR k >= LEN(kinder) THEN RETURN
    ARRAY_REMOVE_AT(kinder, k)
    ARRAY_REMOVE_AT(gew, k)
    kinderSetzen(l, kinder, gew)
END SUB

' Einen Eintrag eine Stelle weiter (richtung -1/+1); liefert die neue Stelle.
FUNCTION eintragRuecken(l AS INTEGER, k AS INTEGER, richtung AS INTEGER) AS INTEGER
    DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    DIM z AS INTEGER : z = k + richtung
    IF z < 0 OR z >= LEN(kinder) THEN RETURN k
    DIM t AS INTEGER : t = kinder[k] : kinder[k] = kinder[z] : kinder[z] = t
    t = gew[k] : gew[k] = gew[z] : gew[z] = t
    kinderSetzen(l, kinder, gew)
    RETURN z
END FUNCTION

SUB eintragGewichtSetzen(l AS INTEGER, k AS INTEGER, g AS INTEGER)
    DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
    IF k < 0 OR k >= LEN(gew) THEN RETURN
    gew[k] = MAX(0, g)
    kinderSetzen(l, kinderListe(l), gew)
END SUB

' Nach Loeschen oder Ordnen: abb[alt] = neuer Index, -1 = weg. Abstandhalter
' (-1 in der Liste) bleiben, wie sie sind.
SUB indizesUmbauen(abb AS ARRAY OF INTEGER)
    DIM l AS INTEGER
    FOR l = 0 TO anzahl() - 1
        IF NOT istLayout(l) THEN CONTINUE
        DIM alt AS ARRAY OF INTEGER : alt = kinderListe(l)
        DIM altG AS ARRAY OF INTEGER : altG = gewichtListe(l)
        DIM kinder AS ARRAY OF INTEGER : kinder = []
        DIM gew AS ARRAY OF INTEGER : gew = []
        DIM k AS INTEGER
        FOR k = 0 TO LEN(alt) - 1
            IF alt[k] < 0 THEN
                ARRAY_PUSH(kinder, -1)
                ARRAY_PUSH(gew, altG[k])
            ELSEIF alt[k] < LEN(abb) THEN
                IF abb[alt[k]] >= 0 THEN
                    ARRAY_PUSH(kinder, abb[alt[k]])
                    ARRAY_PUSH(gew, altG[k])
                END IF
            END IF
        NEXT
        kinderSetzen(l, kinder, gew)
    NEXT
END SUB
