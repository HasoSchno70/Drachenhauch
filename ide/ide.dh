GUI_TABLE_HEADERS(tblProfil, ["Zeile", "Anzahl", "ms", "Anteil", "Quelltext"])
GUI_TABLE_COL_WIDTHS(tblProfil, [60, 80, 80, 70, 320])
GUI_TABLE_SET(tblProfil, "sortierbar", 1)
GUI_WINDOW_VISIBLE(winProfil, FALSE)

' Handbuch: Klappliste der Dokumente, Suche im Dokument, Text mit Umbruch.
DIM winHandbuch AS GUI_WINDOW : winHandbuch = GUI_WINDOW("Handbuch", 200, 60, 980, 720)
GUI_WINDOW_CLOSABLE(winHandbuch, TRUE)
