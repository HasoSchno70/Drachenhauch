' 57_funcref.dh -- First-class Function References (FUNCREF).
'
' Eine User-Function laesst sich als Wert in eine Variable mit Type
' FUNCREF speichern und spaeter ueber `f(args)` aufrufen. Use-Cases:
' Sort-Comparator, Tween-Easing-Callbacks, Event-Handler, Higher-Order-
' Patterns. Closures werden NICHT unterstuetzt -- der Body sieht nur
' Parameter und Globals.

PRINT "=== Variable als Function-Reference ==="

FUNCTION square(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION

FUNCTION cube(x AS INTEGER) AS INTEGER
    RETURN x * x * x
END FUNCTION

DIM f AS FUNCREF
f = square
PRINT "f = square; f(5) =", f(5)
f = cube
PRINT "f = cube;   f(3) =", f(3)

PRINT ""
PRINT "=== FUNCREF als Parameter (Higher-Order-Function) ==="

FUNCTION twice(g AS FUNCREF, x AS INTEGER) AS INTEGER
    RETURN g(g(x))
END FUNCTION

FUNCTION inc(x AS INTEGER) AS INTEGER
    RETURN x + 1
END FUNCTION

PRINT "twice(inc, 5) =", twice(inc, 5)
PRINT "twice(square, 3) =", twice(square, 3)

PRINT ""
PRINT "=== Easing-Callbacks: zwei Easings, eine Animation ==="

FUNCTION ease_linear(t AS FLOAT) AS FLOAT
    RETURN t
END FUNCTION

FUNCTION ease_quad_in(t AS FLOAT) AS FLOAT
    RETURN t * t
END FUNCTION

FUNCTION ease_quad_out(t AS FLOAT) AS FLOAT
    RETURN 1.0 - (1.0 - t) * (1.0 - t)
END FUNCTION

SUB animate(easing AS FUNCREF, label AS STRING)
    PRINT label, ":"
    DIM i AS INTEGER
    FOR i = 0 TO 4
        DIM t AS FLOAT
        t = i / 4.0
        PRINT "  t =", t, "-> easing =", easing(t)
    NEXT
END SUB

animate(ease_linear,  "linear  ")
animate(ease_quad_in, "quad_in ")
animate(ease_quad_out, "quad_out")
