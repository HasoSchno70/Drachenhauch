' Bausteine (gui_bausteine.rs, docs/entwurf-gui-wie-gtk.md Paket 2):
' Fliesslayout mit Auswahl, Alt-Buchstaben, Beschriftung kuerzen und
' markieren, Reglermarken, Kreisel, Kalendermarken, Groessengruppen,
' Schriftwahl. Format: docs/werkzeuge.md.
'
' Tasten in den Aufnahmen: 342 Alt, 341 Strg, 83 S, 82 R, 78 N, 67 C,
' 262 rechts, 257 Enter, 256 ESC. Die Fenster sind randlos bei (0, 0).

=== das fliesslayout bricht um und folgt seiner breite
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM l AS GUI_WIDGET : l = GUI_LAYOUT(w, "fluss", 10, 10, 300, 200)
DIM b[5] AS GUI_WIDGET
DIM i AS INTEGER
FOR i = 0 TO 4
    b[i] = GUI_BUTTON(w, "K" + STR$(i), 0, 0, 100, 30)
    GUI_LAYOUT_ADD(l, b[i])
NEXT
GUI_UPDATE()
DIM s AS STRING
FOR i = 0 TO 4
    s = s + STR$(GUI_GET_X(b[i])) + "/" + STR$(GUI_GET_Y(b[i])) + " "
NEXT
PRINT TRIM$(s)
GUI_SET_BOUNDS(l, 10, 10, 400, 200)
GUI_UPDATE()
s = ""
FOR i = 0 TO 4
    s = s + STR$(GUI_GET_X(b[i])) + "/" + STR$(GUI_GET_Y(b[i])) + " "
NEXT
PRINT TRIM$(s)
--- erwartet
10/10 116/10 10/46 116/46 10/82
10/10 116/10 222/10 10/46 116/46

=== im fliesslayout waehlt ein klick ein kind
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM l AS GUI_WIDGET : l = GUI_LAYOUT(w, "fluss", 10, 10, 380, 200)
GUI_LAYOUT_SET(l, "auswahl", 1)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 100, 60)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "B", 0, 0, 100, 60)
GUI_LAYOUT_ADD(l, a)
GUI_LAYOUT_ADD(l, b)
DIM fremd AS GUI_WIDGET : fremd = GUI_BUTTON(w, "C", 10, 250, 50, 20)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
DIM meldungen AS INTEGER : meldungen = 0
DIM bk AS BOOLEAN : bk = FALSE
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF GUI_CLICKED(l) THEN meldungen = meldungen + 1
    IF GUI_CLICKED(b) THEN bk = TRUE
    IF n = 20 THEN PRINT "gewaehlt b " + STR$(GUI_LAYOUT_SELECTED(l) = b) + " geklickt b " + STR$(bk) + " meldungen " + STR$(meldungen)
    IF n = 21 THEN
        GUI_LAYOUT_SELECT(l, a)
        PRINT "per programm a " + STR$(GUI_LAYOUT_SELECTED(l) = a)
        GUI_LAYOUT_SELECT(l, -1)
        PRINT "keins " + STR$(GUI_LAYOUT_SELECTED(l))
        TRY
            GUI_LAYOUT_SELECT(l, fremd)
        CATCH e
            PRINT e
        END TRY
        GUI_LAYOUT_SELECT(l, b)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 4
e 4 7 160 40 0 0
e 5 7 160 40 0 0
e 6 6 0 0 0 0
e 8 5 0 0 0 0

--- umgebung
DHRT_FRAMES=30
--- erwartet
gewaehlt b TRUE geklickt b TRUE meldungen 1
per programm a TRUE
keins -1
GUI_LAYOUT_SELECT: das Widget gehoert nicht zu diesem Layout

=== die auswahl im fliesslayout ist zu sehen
IMPORT "gui"
SCREEN(400, 300, "T", 1)
GUI_THEME_SET("accent", &HFF00FF)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM l AS GUI_WIDGET : l = GUI_LAYOUT(w, "fluss", 20, 20, 360, 200)
GUI_LAYOUT_SET(l, "auswahl", 1)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 100, 60)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "B", 0, 0, 100, 60)
GUI_LAYOUT_ADD(l, a)
GUI_LAYOUT_ADD(l, b)
GUI_UPDATE()
GUI_LAYOUT_SELECT(l, b)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
