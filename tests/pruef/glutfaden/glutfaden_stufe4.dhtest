=== ohne palette ist es ein fehler
IMPORT "helfer.dh"
DIM e AS kern.Importeinstellung : e = NEW kern.Importeinstellung()
DIM p AS kern.Pixelbild : p = kern.neuesPixelbild(2, 2)
DIM g AS kern.Pixelbild
TRY
    DIM m AS kern.Muster : m = kern.musterAusPixeln(p, g, e, "x", ["A"])
CATCH f
    PRINT f
END TRY
