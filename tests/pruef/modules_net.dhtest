=== tcp is connected false after peer closes
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
DIM srv AS NET_SOCKET
DIM i AS INTEGER
FOR i = 1 TO 50
    srv = NET_TCP_ACCEPT(l)
    IF NOT IS_NIL(srv) THEN BREAK
    SLEEP(2)
NEXT
NET_CLOSE(srv)
DIM waited AS INTEGER
DIM dummy AS STRING
waited = 0
WHILE NET_IS_CONNECTED(client) AND waited < 2000
    dummy = NET_RECV(client, 1024)
    SLEEP(20)
    waited = waited + 20
WEND
PRINT NET_IS_CONNECTED(client)
NET_CLOSE(client)
NET_CLOSE_LISTENER(l)
--- erwartet
FALSE

