DIM a AS ARRAY OF INTEGER
a = "nein"
--- fehler
Erwartet

=== ein globales feld ist so schnell wie ein lokales
' Vorher 165 gegen 75 ms je Million Zugriffe. Die Grenze laesst Luft fuer
' Streuung und faellt beim Weg ueber den Namen trotzdem.
DIM g[1000] AS INTEGER
DIM i AS INTEGER
DIM t AS INTEGER
t = MILLIS()
FOR i = 0 TO 999999
    g[i MOD 1000] = g[i MOD 1000] + 1
NEXT
DIM global_ms AS INTEGER : global_ms = MILLIS() - t
FUNCTION lokal() AS INTEGER
    DIM f[1000] AS INTEGER
    DIM k AS INTEGER
    DIM t0 AS INTEGER : t0 = MILLIS()
    FOR k = 0 TO 999999
        f[k MOD 1000] = f[k MOD 1000] + 1
    NEXT
    RETURN MILLIS() - t0
END FUNCTION
DIM lokal_ms AS INTEGER : lokal_ms = lokal()
PRINT g[5]; " "; global_ms < lokal_ms * 3 / 2 + 15
--- erwartet
1000 TRUE
