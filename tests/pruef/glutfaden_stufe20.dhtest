--- erwartet
geleert: 5 stiche | schritte 1 | rueckstiche 4 | notiz bleibt ''
leere ebene: 0 | schritte 1
ausserhalb: 0 0
gesperrt: 0 | stiche dort 14
zurueck: oben 5 | erledigt dort 1
notiz: TRUE 'Grund und Himmel' | 'Ebenen-Notiz ändern'
gleich: FALSE | ausserhalb FALSE
zurueck: ''
wieder: 'Grund und Himmel'
gesichert und gelesen: 'Grund und Himmel'

=== rollbalken, spiegel, ablage, kuerzel-liste
IMPORT "helfer.dh"
' Rollbalken (PySticky _update_scrollbars), dazu wenn die Lage draussen liegt
DIM u AS FLOAT, o AS FLOAT, s AS FLOAT, w AS FLOAT
DIM fall AS ARRAY OF FLOAT
FOR EACH fall IN [[1400.0, 800.0, 100.0], [400.0, 800.0, 200.0], [3000.0, 1000.0, -900.0], [3000.0, 1000.0, 400.0], [500.0, 800.0, -2000.0]]
    (u, o, s, w) = kern.rollBereich(fall[0], fall[1], fall[2])
    PRINT "muster "; fall[0]; " sicht "; fall[1]; " lage "; fall[2]; ": "; u; " .. "; o; " seite "; s; " wert "; w
NEXT
' Spiegel: Achtfach nur bei quadratischen Mustern
DIM k AS INTEGER
FOR k = 0 TO 4
    PRINT "spiegel "; k; ": 14x8 "; kern.spiegelKurz$(kern.spiegelWirksam(k, 14, 8)); " | 8x8 "; kern.spiegelKurz$(kern.spiegelWirksam(k, 8, 8))
NEXT
PRINT "krumm: "; kern.spiegelWirksam(9, 8, 8); " "; kern.spiegelWirksam(-3, 8, 8)
' Abgelegte Dateien
DIM d AS STRING
FOR EACH d IN ["a.pxs", "B.PXS", "x.oxs", "x.xsd", "x.pat", "foto.JPEG", "f.jpg", "f.png", "f.bmp", "f.gif", "f.tga", "f.qoi", "f.webp", "f.tif", "notiz.txt", "ohne", "ordner.pxs/innen", "punkt.", ".pxs"]
    PRINT d; " "; kern.ablageArt(d); " | ";
NEXT
PRINT
DIM z AS STRING
FOR EACH z IN kern.uriListe("# kommentar" + CHR$(13) + CHR$(10) + "file:///C:/a.pxs" + CHR$(13) + CHR$(10) + CHR$(13) + CHR$(10) + "  file:///tmp/b%20c.png  " + CHR$(10) + "#noch einer")
    PRINT "uri: '"; z; "'"
NEXT
PRINT "leer: "; LEN(kern.uriListe("")); " "; LEN(kern.uriListe(CHR$(13) + CHR$(10)))
' Die Tastenkuerzel-Uebersicht: alle Aktionen, das wirksame Kuerzel
DIM e AS kern.Einstellungen : e = NEW kern.Einstellungen()
DIM l AS ARRAY OF STRING : l = kern.kuerzelListe(e)
DIM ohne AS INTEGER
FOR EACH z IN l
    IF RIGHT$(z, 1) = CHR$(9) THEN ohne = ohne + 1
NEXT
PRINT "kuerzel: "; LEN(l); " = tafel "; LEN(kern.kuerzelAktionen()); " | ohne "; ohne
PRINT "erste: "; REPLACE$(l[0], CHR$(9), " -> ")
FOR EACH z IN l
    IF LEFT$(z, 11) = "Tastenkürze" OR LEFT$(z, 12) = "Ebene leeren" OR LEFT$(z, 13) = "Zentrierhilfe" THEN PRINT "  "; REPLACE$(z, CHR$(9), " -> ")
NEXT
MAPPUT(e.kuerzel, "mittelkreuz", "Strg+Umschalt+M")
MAPPUT(e.kuerzel, "ebene_leeren", "Strg+S")
FOR EACH z IN kern.kuerzelListe(e)
    IF LEFT$(z, 12) = "Ebene leeren" OR LEFT$(z, 13) = "Zentrierhilfe" THEN PRINT "  umgelegt: "; REPLACE$(z, CHR$(9), " -> ")
NEXT
