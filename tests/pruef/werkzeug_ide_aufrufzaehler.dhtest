' Aufrufzaehler: hinter jeder SUB/FUNCTION steht, wie oft ihr Name im
' Projekt vorkommt (GUI_TEXTAREA_HINTS) -- auch in anderen Dateien, als
' FUNCREF, aber nicht im Kommentar, nicht in einer Zeichenkette und nicht
' in der Kopfzeile selbst. Ein Klick auf den Zaehler zeigt die Aufrufer.
' Ausgeschaltet verschwinden die Zaehler.
--- seriell

=== zaehlt ueber das projekt, klick zeigt die aufrufer
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 60 THEN pruefen()
IF prBild = 62 THEN
    DIM prI AS INTEGER
    FOR prI = 0 TO LEN(zaehlZeilen) - 1
        protokoll("pr zeile " + STR$(zaehlZeilen[prI]) + " " + zaehlNamen[prI] + ": " + zaehlTexte[prI])
    NEXT
    zaehlerKlick(tabFelder[aktiverTab], 1)
END IF
IF prBild = 66 THEN
    protokoll("pr fenster " + GUI_TEXT(lblAufruf))
    befehl("aufrufzaehler")
    protokoll("pr aus " + STR$(zaehlFeld))
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
SUB malen()
    PRINT(1)
END SUB
FUNCTION doppelt(x AS INTEGER) AS INTEGER
    RETURN x * 2
END FUNCTION
SUB nie()
END SUB
malen()
' malen() im Kommentar zaehlt nicht
PRINT("malen()")
PRINT(doppelt(2))

--- datei lib.dh
malen()
DIM f AS FUNCREF
f = malen
PRINT(DOPPELT(3))

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 20) = "aufrufzaehler klick " OR LEFT$(L[i], 9) = "aufrufer " THEN PRINT L[i]
NEXT
--- erwartet
pr zeile 1 malen: 3 Aufrufe
pr zeile 4 doppelt: 2 Aufrufe
pr zeile 7 nie: nicht aufgerufen
aufrufzaehler klick malen
aufrufer 3
aufrufer baum 3
pr fenster 3 Aufruf(e) unmittelbar, 3 Knoten im Baum. Ein Klick springt hin.
pr aus -1

=== die zweite ansicht derselben datei zaehlt nicht doppelt
' Stresstest 2026-10-01: in der linken Ansicht (Alt+Umschalt+G) stand jeder
' Zaehler doppelt -- sie gehoert keinem Reiter, also zaehlte neben ihrem
' eigenen Text auch noch die gesicherte Datei auf der Platte.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 50 THEN befehl("spiegel")
IF prBild = 60 THEN
    zaehlerSetzen_(taSpiegel)
    DIM prI AS INTEGER
    FOR prI = 0 TO LEN(zaehlZeilen) - 1
        protokoll("pr links " + zaehlNamen[prI] + ": " + zaehlTexte[prI])
    NEXT
    zaehlerSetzen_(tabFelder[aktiverTab])
    FOR prI = 0 TO LEN(zaehlZeilen) - 1
        protokoll("pr rechts " + zaehlNamen[prI] + ": " + zaehlTexte[prI])
    NEXT
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
SUB malen()
    PRINT(1)
END SUB
malen()
malen()

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr links malen: 2 Aufrufe
pr rechts malen: 2 Aufrufe

=== der reiter in anderer schreibweise zaehlt seine datei nicht doppelt
' Stresstest 2026-10-01: der Reiter traegt den Weg, wie er geoeffnet wurde
' (langer Name, hier "unter/.."), das Projekt nennt die Datei anders. Am
' Text verglichen liess die Zaehlung die eigene Datei auf der Platte nicht
' aus und zaehlte jeden Aufruf doppelt.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 40 THEN
    zaehlerSetzen_(tabFelder[aktiverTab])
    DIM prI AS INTEGER
    FOR prI = 0 TO LEN(zaehlZeilen) - 1
        protokoll("pr " + zaehlNamen[prI] + ": " + zaehlTexte[prI])
    NEXT
    EXIT(0)
END IF
--- argumente
unter/../haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
rechnen()
SUB rechnen()
    PRINT 1
END SUB
--- datei unter/leer.txt
x
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr rechnen: 1 Aufruf

=== ein projekt mit 2000 dateien zaehlt stueckweise und haelt beim sichern still
' Stresstest 2026-10-02: in einem Projekt mit 2000 Dateien stand die IDE
' beim ersten Pruefen bis zu 2,3 s (alle Dateien in einem Bild gelesen), und
' jedes Sichern leerte den Zaehl-Cache -- beim naechsten Tippen 0,8 s
' Stillstand. Jetzt liest die Zaehlung hoechstens 60 Dateien je Bild, das
' Sichern wirft nur den eigenen Eintrag weg, und eine Aenderung von aussen
' findet zaehlNachsehen, wenn die IDE wieder nach vorn kommt (hier
' nachgestellt ueber zaehlFokusVorher). Die Grenze von 600 ms ist grob.
DIM prBild AS INTEGER : prBild = 0
DIM prMax AS FLOAT : prMax = 0.0
DIM prLetzt AS FLOAT : prLetzt = 0.0
DIM prGelesen AS INTEGER : prGelesen = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
DIM prJ AS FLOAT : prJ = GET_TIME()
IF prBild > 2 AND prJ - prLetzt > prMax THEN prMax = prJ - prLetzt
prLetzt = prJ
IF prBild = 160 THEN
    protokoll("pr erst " + zaehlTexte[0] + " flott " + STR$(prMax < 0.6))
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 4, 1)
    GUI_TEXTAREA_INSERT(tabFelder[aktiverTab], "' x" + NL)
    sichern(aktiverTab, FALSE)
    GUI_TEXTAREA_INSERT(tabFelder[aktiverTab], "' y" + NL)
    prMax = 0.0
    prGelesen = zaehlGelesenGesamt
END IF
IF prBild = 260 THEN
    protokoll("pr nach sichern " + zaehlTexte[0] + " flott " + STR$(prMax < 0.6) + " neu gelesen " + STR$(zaehlGelesenGesamt - prGelesen))
    ' von aussen: ein weiterer Aufruf in einer Datei, die nicht offen ist
    WRITEALL(PATHJOIN(projektOrdner, "teil0/m1.dh"), "gruss()" + NL + "gruss()" + NL)
    zaehlFokusVorher = FALSE
END IF
IF prBild = 300 THEN GUI_TEXTAREA_INSERT(tabFelder[aktiverTab], "' z" + NL)
IF prBild = 400 THEN
    protokoll("pr von aussen " + zaehlTexte[0])
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=800
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- vorher
DIM d AS INTEGER
DIM i AS INTEGER
FOR d = 0 TO 19
    MKDIR("teil" + STR$(d))
    FOR i = 0 TO 99
        DIM t AS STRING : t = "SUB hilfe_" + STR$(d) + "_" + STR$(i) + "()" + CHR$(10) + "    PRINT " + STR$(i) + CHR$(10) + "END SUB" + CHR$(10)
        IF i = 0 THEN t = t + "gruss()" + CHR$(10)
        WRITEALL("teil" + STR$(d) + "/m" + STR$(i) + ".dh", t)
    NEXT
NEXT
WRITEALL("haupt.dh", "SUB gruss()" + CHR$(10) + "    PRINT 1" + CHR$(10) + "END SUB" + CHR$(10) + "gruss()" + CHR$(10))
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 17) = "zaehlung veraltet" THEN PRINT L[i]
NEXT
--- erwartet
pr erst 21 Aufrufe flott TRUE
pr nach sichern 21 Aufrufe flott TRUE neu gelesen 0
zaehlung veraltet m1.dh
pr von aussen 23 Aufrufe
