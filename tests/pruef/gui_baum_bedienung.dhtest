=== tippen springt zum passenden knoten
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 280, 200)
GUI_TREE_ADD(t, -1, "Apfel") : GUI_TREE_ADD(t, -1, "Birne") : GUI_TREE_ADD(t, -1, "Banane")
GUI_FOCUS(t)
DIM zuletzt AS INTEGER : zuletzt = -1
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_TREE_SELECTED(t) <> zuletzt THEN zuletzt = GUI_TREE_SELECTED(t) : PRINT GUI_TREE_LABEL(t, zuletzt)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
