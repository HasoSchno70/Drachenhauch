=== with target evaluated once (1)
' Side-Effects im WITH-Target laufen genau einmal.
CLASS Box
    DIM v AS INTEGER
END CLASS

DIM counter AS INTEGER
counter = 0

FUNCTION getbox() AS Box
    counter = counter + 1
    DIM b AS Box
    b = NEW Box()
    b.v = 42
    RETURN b
END FUNCTION

WITH getbox()
    .v = 100
    .v = .v + 1
    .v = .v + 1
END WITH
PRINT counter
--- erwartet
1

