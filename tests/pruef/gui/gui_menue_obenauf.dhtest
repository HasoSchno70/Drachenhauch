--- bild
30 45 nicht #FF00FF +-40
280 45 #FF00FF +-40

=== die offene klappliste liegt ueber einem fenster davor
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 10, 4, 150, 26, ["Apfel", "Birne", "Kirsche"])
DIM v AS GUI_WINDOW : v = GUI_WINDOW("B", 0, 34, 300, 266)
GUI_WINDOW_CHROME(v, FALSE)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(v, "", 0, 0, 300, 266)
GUI_SET_COLOR(k, "bg", &HFF00FF)
GUI_SET_COLOR(k, "border", &HFF00FF)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    GUI_WINDOW_FRONT(v)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
