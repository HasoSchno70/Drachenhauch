' Veraltete Anzeigen und die Art in der Gliederung (2026-10-01, beim
' Dogfooding gefunden):
' - Gliederung und Pfadleiste nannten jede SUB "function" (CODE_SYMBOLS$
'   kannte nur die Symbolarten des Sprachservers, und die haben keine SUB).
' - Eine Meldung in der Statusleiste blieb stehen, bis eine neue kam --
'   "Keine Definition zu 'AS'" stand noch da, als F12 laengst geklappt
'   hatte. Jetzt sagt auch der Erfolg es, und jede Meldung vergeht nach
'   zwoelf Sekunden.
' - Die Hilfe zum Wort blieb nach einem Reiterwechsel beim vorigen Wort,
'   wenn die Marke in beiden Reitern an derselben Stelle stand.
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

--- langsam
=== gliederung, statusleiste und hilfe zum wort
DIM prBild AS INTEGER : prBild = 0
DIM prHilfeA AS STRING
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 60 THEN
    DIM prI AS INTEGER
    FOR prI = 0 TO GUI_LISTBOX_COUNT(lstGliederung) - 1
        protokoll("pr gliederung " + GUI_LISTBOX_ITEM(lstGliederung, prI))
    NEXT
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 7, 9)
    zurDefinition()
    protokoll("pr status " + GUI_TEXT(lblStatus))
END IF
IF prBild = 62 THEN
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 8, 7)
    zurDefinition()
    protokoll("pr status " + GUI_TEXT(lblStatus))
END IF
IF prBild = 64 THEN GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 1, 1)
IF prBild = 68 THEN
    prHilfeA = GUI_TEXT(lblHilfe)
    dateiOeffnen(PATHJOIN(projektOrdner, "b.dh"))
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 1, 1)
END IF
IF prBild = 72 THEN
    protokoll("pr hilfe gewechselt " + STR$(GUI_TEXT(lblHilfe) <> prHilfeA AND INSTR(GUI_TEXT(lblHilfe), "CLS") >= 0))
    GUI_SET_TEXT(lblStatus, "probe")
END IF
IF prBild = 200 THEN protokoll("pr status spaeter " + GUI_TEXT(lblStatus))
IF prBild = 950 THEN
    protokoll("pr status vergangen " + STR$(GUI_TEXT(lblStatus) = ""))
    EXIT(0)
END IF
--- argumente
a.dh
--- umgebung
DHRT_FRAMES=1100
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei a.dh
SUB malen()
    PRINT "x"
END SUB
FUNCTION doppelt(n AS INTEGER) AS INTEGER
    RETURN n * 2
END FUNCTION
DIM k AS INTEGER
k = doppelt(3)
malen()
--- datei b.dh
CLS(0)
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- system windows
--- erwartet
pr gliederung sub malen
pr gliederung function doppelt
pr status Keine Definition zu 'AS' -- auch nicht im Projekt.
pr status Definition von 'doppelt' in Zeile 4.
pr hilfe gewechselt TRUE
pr status spaeter probe
pr status vergangen TRUE
