=== esc nimmt zurueck und drueckt nicht den abbrechen-knopf
IMPORT "gui"
SCREEN(300, 260, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 260)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 280, 200)
DIM a AS INTEGER : a = GUI_TREE_ADD(t, -1, "Apfel")
DIM ab AS GUI_WIDGET : ab = GUI_BUTTON(w, "Abbrechen", 10, 220, 100, 28)
GUI_WINDOW_CANCEL(w, ab)
GUI_TREE_SET(t, "bearbeitbar", 1)
GUI_TREE_EDIT(t, a)
GUI_FOCUS(t)
CLIPBOARD_SET("anders")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(ab) THEN PRINT "abbrechen gedrueckt"
    IF GUI_TREE_EDITED(t) >= 0 THEN PRINT "umbenannt"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT GUI_TREE_EDITING(t); " "; GUI_TREE_LABEL(t, a)
