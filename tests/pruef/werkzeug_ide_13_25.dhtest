    RETURN INSTR(inhalt$(datei), t) >= 0
END FUNCTION
DIM ht AS ARRAY OF STRING : ht = SPLIT$(alle$("hbsuche "), "|")
DIM hok AS BOOLEAN : hok = LEN(ht) = 3
DIM hy AS ARRAY OF INTEGER : hy = [0, 0, 0]
DIM hi AS INTEGER
IF hok THEN
    FOR hi = 0 TO 2
        DIM hs AS ARRAY OF STRING : hs = SPLIT$(ht[hi], " ")
        IF LEN(hs) <> 4 THEN hok = FALSE ELSE hy[hi] = VAL(hs[1])
        IF LEN(hs) = 4 THEN
            IF hs[2] <> "3" OR hs[3] <> "nadel" THEN hok = FALSE
        END IF
    NEXT
END IF
PRINT "drei treffer " ; hok
PRINT "weiter und zurueck " ; hok AND hy[1] > hy[0] AND hy[2] = hy[0]
--- erwartet
drei treffer TRUE
weiter und zurueck TRUE

