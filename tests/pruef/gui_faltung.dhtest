' Faltung im Textbereich (GUI_TEXTAREA_FOLDABLE/FOLD/FOLDED/FOLDS/FOLD_ALL)
' und CODE_RENAME$. Format: docs/werkzeuge.md, dhrt test.

=== zuklappen verbirgt die inneren zeilen, die kopfzeile bleibt
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "SUB a()" + CHR$(10) + "  eins" + CHR$(10) + "  zwei" + CHR$(10) + "END SUB" + CHR$(10) + "PRINT 1")
GUI_TEXTAREA_FOLDABLE(ta, [1], [4])
PRINT GUI_TEXTAREA_FOLD(ta, 1)
DIM z AS INTEGER
FOR z = 1 TO 5
    PRINT z; " "; GUI_TEXTAREA_FOLDED(ta, z)
NEXT
falten(GUI_TEXTAREA_FOLDS(ta))

SUB falten(a AS ARRAY OF INTEGER)
    DIM t AS STRING
    DIM x AS INTEGER
    FOR EACH x IN a : t = t + STR$(x) + " " : NEXT
    PRINT "falten:" + RTRIM$(" " + t)
END SUB
--- umgebung
DHRT_FRAMES=2
--- erwartet
TRUE
1 FALSE
2 TRUE
3 TRUE
4 TRUE
5 FALSE
falten: 1

=== ein zweiter aufruf klappt wieder auf
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "SUB a()" + CHR$(10) + "  eins" + CHR$(10) + "END SUB")
GUI_TEXTAREA_FOLDABLE(ta, [1], [3])
GUI_TEXTAREA_FOLD(ta, 1)
PRINT GUI_TEXTAREA_FOLD(ta, 1)
PRINT GUI_TEXTAREA_FOLDED(ta, 2)
' mit ausdruecklichem Wert statt Umschalten -- zweimal TRUE bleibt TRUE
GUI_TEXTAREA_FOLD(ta, 1, TRUE)
GUI_TEXTAREA_FOLD(ta, 1, TRUE)
PRINT GUI_TEXTAREA_FOLDED(ta, 2)
--- umgebung
DHRT_FRAMES=2
--- erwartet
FALSE
FALSE
TRUE

=== der engste block gewinnt
' Eine Methode soll sich einzeln zuklappen lassen, ohne die Klasse
' mitzunehmen -- sonst waere die Faltung in einer Klasse wertlos.
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
DIM q AS STRING
DIM i AS INTEGER
FOR i = 1 TO 8
    q = q + "zeile " + STR$(i) + CHR$(10)
NEXT
GUI_SET_TEXT(ta, q)
' Klasse 1..8, Methode 3..5
GUI_TEXTAREA_FOLDABLE(ta, [1, 3], [8, 5])
GUI_TEXTAREA_FOLD(ta, 4)
falten(GUI_TEXTAREA_FOLDS(ta))
PRINT GUI_TEXTAREA_FOLDED(ta, 2); " "; GUI_TEXTAREA_FOLDED(ta, 4); " "; GUI_TEXTAREA_FOLDED(ta, 7)

SUB falten(a AS ARRAY OF INTEGER)
    DIM t AS STRING
    DIM x AS INTEGER
    FOR EACH x IN a : t = t + STR$(x) + " " : NEXT
    PRINT "falten:" + RTRIM$(" " + t)
END SUB
--- umgebung
DHRT_FRAMES=2
--- erwartet
falten: 3
FALSE TRUE FALSE

=== alles zuklappen nimmt nur die aeusseren bloecke
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
DIM q AS STRING
DIM i AS INTEGER
FOR i = 1 TO 12
    q = q + "zeile " + STR$(i) + CHR$(10)
NEXT
GUI_SET_TEXT(ta, q)
GUI_TEXTAREA_FOLDABLE(ta, [1, 3, 9], [7, 5, 12])
PRINT GUI_TEXTAREA_FOLD_ALL(ta, TRUE)
falten(GUI_TEXTAREA_FOLDS(ta))
PRINT GUI_TEXTAREA_FOLD_ALL(ta, FALSE)
falten(GUI_TEXTAREA_FOLDS(ta))

SUB falten(a AS ARRAY OF INTEGER)
    DIM t AS STRING
    DIM x AS INTEGER
    FOR EACH x IN a : t = t + STR$(x) + " " : NEXT
    PRINT "falten:" + RTRIM$(" " + t)
END SUB
--- umgebung
DHRT_FRAMES=2
--- erwartet
2
falten: 1 9
0
falten:

=== ein sprung in den block klappt ihn auf
' Sonst spraenge eine Suche an eine Stelle, die man nicht sieht.
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "SUB a()" + CHR$(10) + "  eins" + CHR$(10) + "  zwei" + CHR$(10) + "END SUB")
GUI_TEXTAREA_FOLDABLE(ta, [1], [4])
GUI_TEXTAREA_FOLD(ta, 1)
PRINT GUI_TEXTAREA_FOLDED(ta, 3)
GUI_TEXTAREA_GOTO(ta, 3, 1)
PRINT GUI_TEXTAREA_FOLDED(ta, 3)
DIM z AS INTEGER
DIM s AS INTEGER
(z, s) = GUI_TEXTAREA_CURSOR(ta)
PRINT z; " "; s
--- umgebung
DHRT_FRAMES=2
--- erwartet
TRUE
FALSE
3 1

=== die schreibmarke wandert beim zuklappen auf die kopfzeile
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "SUB a()" + CHR$(10) + "  eins" + CHR$(10) + "  zwei" + CHR$(10) + "END SUB")
GUI_TEXTAREA_FOLDABLE(ta, [1], [4])
GUI_TEXTAREA_GOTO(ta, 3, 3)
GUI_TEXTAREA_FOLD(ta, 1)
DIM z AS INTEGER
DIM s AS INTEGER
(z, s) = GUI_TEXTAREA_CURSOR(ta)
PRINT z; " "; s
--- umgebung
DHRT_FRAMES=2
--- erwartet
1 1

=== eine unbekannte zeile faltet nichts
