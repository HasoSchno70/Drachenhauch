=== check warnt bei festem index ausserhalb fester grenzen
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 30000 AND leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p)
        IF teil <> "" THEN
            aus = aus + teil
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_PARSE("{" + CHR$(34) + "w" + CHR$(34) + ":" + lauf$(PROCESS_START("dhrt", "--check", CWD$() + "/w.dh")) + "}")
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(h, "w") - 1
    PRINT JSON_GET_INT(h, "w." + STR$(i) + ".line"); ": "; JSON_GET_STRING(h, "w." + STR$(i) + ".message")
NEXT
--- datei w.dh
CONST N = 31
DIM tage[1 TO N] AS INTEGER
DIM f[-2 TO 2, 5] AS INTEGER
tage[0] = 1
PRINT tage[N], f[0, 5], f[-3, 0]
DIM a[3] AS INTEGER
PRINT a[3]
SUB s()
    DIM b[1 TO 2] AS STRING
    PRINT b[0]
END SUB

--- erwartet
10: Index 0 liegt ausserhalb [1..2] von 'b' -- das bricht beim Laufen ab, solange das Feld so angelegt bleibt
4: Index 0 liegt ausserhalb [1..31] von 'tage' -- das bricht beim Laufen ab, solange das Feld so angelegt bleibt
5: Index 5 liegt ausserhalb [0..4] in Dimension 2 von 'f' -- das bricht beim Laufen ab, solange das Feld so angelegt bleibt
5: Index -3 liegt ausserhalb [-2..2] in Dimension 1 von 'f' -- das bricht beim Laufen ab, solange das Feld so angelegt bleibt
7: Index 3 liegt ausserhalb [0..2] von 'a' -- das bricht beim Laufen ab, solange das Feld so angelegt bleibt

=== check schweigt, wenn das feld ersetzt wird oder an einen aufruf geht
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 30000 AND leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p)
        IF teil <> "" THEN
            aus = aus + teil
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
PRINT TRIM$(lauf$(PROCESS_START("dhrt", "--check", CWD$() + "/w.dh")))
--- datei w.dh
SUB fuellen(z AS ARRAY OF INTEGER)
    ARRAY_PUSH(z, 1)
END SUB
DIM a[0] AS INTEGER
DIM b[0] AS INTEGER
DIM c[2] AS INTEGER
DIM d[0] AS INTEGER
DIM i AS INTEGER
FOR i = 1 TO 2
    IF LEN(a) > 0 THEN PRINT a[0]
    ARRAY_PUSH(a, i)
    IF LEN(b) > 0 THEN PRINT b[0]
    fuellen(b)
    IF LEN(c) > 2 THEN PRINT c[2]
    c = [1, 2, 3]
    IF LEN(d) > 0 THEN PRINT d[0]
    d.push(1)
NEXT

--- erwartet
[]

=== der maschinencode rechnet mit der untergrenze
' Stufe 3: ein Bereich liest und schreibt das Feld selbst, der Index wird
' um die Untergrenze verschoben; ein Index ausserhalb (oben wie unten)
' steigt aus, und die VM meldet ihn an der Stelle.
DIM a[1 TO 1000] AS INTEGER
DIM i AS INTEGER
DIM s AS INTEGER
FOR i = 1 TO 1000
    a[i] = i * 2
NEXT
FOR i = 1 TO 1000
    s = s + a[i]
NEXT
PRINT s
DIM f[-2 TO 2, 1 TO 3] AS FLOAT
DIM j AS INTEGER
FOR i = -2 TO 2
    FOR j = 1 TO 3
        f[i, j] = i * 10 + j
    NEXT
NEXT
PRINT f[-2, 1]; " "; f[2, 3]
TRY
    FOR i = 1 TO 1001
        s = a[i]
    NEXT
CATCH e
    PRINT e
END TRY
TRY
    FOR i = 1 TO 0 STEP -1
        s = a[i]
    NEXT
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_JIT=immer
DHRT_JIT_BILANZ=1
--- erwartet
1001000
