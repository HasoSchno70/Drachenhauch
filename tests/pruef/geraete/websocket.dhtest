' WebSocket (WS_*, src/websocket.rs). Server und Client sind zwei Prozesse:
' der Handschlag wartet auf die Antwort der Gegenseite, im selben Programm
' wartete er auf sich selbst. Die Beilage echo.dh ist ein Server, der jede
' Nachricht mit "echo:" zurueckschickt, Binaeres unveraendert, und auf "ende"
' mit Code 4001 schliesst; client.dh ist ein Client, der eine Nachricht
' schickt und die Antwort ausgibt. Den Port meldet der Server auf stderr.
' Ein Fall laesst Node (ab 22, eingebauter WebSocket-Client) als fremden
' Client gegen den Server laufen; ohne Node ueberspringt er sich.
' Format: docs/werkzeuge.md, dhrt test.

=== text, binaer, umlaute, grosse nachricht und schliessen
IMPORT "websocket"
IMPORT "hilfe.dh"
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", "echo.dh")
DIM port AS INTEGER : port = portVon(p)
DIM w AS WEBSOCKET
w = WS_CONNECT("ws://127.0.0.1:" + STR$(port) + "/raum?x=1")
PRINT "verbunden "; WS_CONNECTED(w)
PRINT WS_SEND(w, "hallo")
PRINT antwort$(w)
WS_SEND(w, "Grüße 🐉")
PRINT antwort$(w)
DIM b AS BUFFER : b = BUFFER_NEW(3)
BUFFER_SET(b, 0, 0) : BUFFER_SET(b, 1, 255) : BUFFER_SET(b, 2, 7)
WS_SEND(w, b)
DIM t AS INTEGER : t = MILLIS()
WHILE NOT WS_NEXT(w) AND MILLIS() - t < 5000
    SLEEP(5)
WEND
PRINT "binaer "; WS_IS_BINARY(w); " "; BUFFER_LEN(WS_MESSAGE_BYTES(w)); " "; BUFFER_GET(WS_MESSAGE_BYTES(w), 1)
' 100000 Zeichen: Laenge mit 64 Bit im Rahmenkopf
WS_SEND(w, REPEAT$("x", 100000))
PRINT "gross "; LEN(antwort$(w))
WS_SEND(w, "ende")
t = MILLIS()
WHILE WS_CONNECTED(w) AND MILLIS() - t < 5000
    SLEEP(5)
WEND
PRINT "zu "; WS_CONNECTED(w); " "; WS_CLOSE_CODE(w); " "; WS_CLOSE_REASON$(w)
PRINT "senden danach "; WS_SEND(w, "noch was")
--- datei hilfe.dh
IMPORT "{sammlung}/../_hilfen/wshilfe.dh"
--- datei echo.dh
IMPORT "{sammlung}/../_hilfen/wsecho.dh"
--- erwartet
verbunden TRUE
TRUE
echo:hallo
echo:Grüße 🐉
binaer TRUE 3 255
gross 100005
zu FALSE 4001 tschuess
senden danach FALSE

=== der server nimmt einen client an
IMPORT "websocket"
DIM s AS WS_SERVER
s = WS_LISTEN(0, "127.0.0.1")
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", "client.dh", "--", STR$(WS_PORT(s)))
DIM w AS WEBSOCKET : w = -1
DIM t AS INTEGER : t = MILLIS()
WHILE w < 0 AND MILLIS() - t < 10000
    w = WS_ACCEPT(s)
    SLEEP(5)
WEND
PRINT "pfad "; WS_PATH$(w)
PRINT "gegenstelle "; LEFT$(WS_PEER$(w), 10)
t = MILLIS()
WHILE NOT WS_NEXT(w) AND MILLIS() - t < 5000
    SLEEP(5)
WEND
PRINT "bekommen "; WS_MESSAGE$(w)
WS_SEND(w, "willkommen")
t = MILLIS()
WHILE WS_CONNECTED(w) AND MILLIS() - t < 5000
    SLEEP(5)
WEND
PRINT "client schloss "; WS_CLOSE_CODE(w); " "; WS_CLOSE_REASON$(w)
DIM aus AS STRING : aus = ""
DIM leer AS INTEGER : leer = 0
WHILE leer < 5
    DIM z AS STRING : z = PROCESS_READ$(p)
    IF z = "" THEN
        IF NOT PROCESS_RUNNING(p) THEN leer = leer + 1
        SLEEP(30)
    ELSE
        aus = aus + TRIM$(z)
    END IF
WEND
PRINT "client sagt "; aus
--- datei client.dh
IMPORT "websocket"
DIM w AS WEBSOCKET
w = WS_CONNECT("ws://127.0.0.1:" + ARG$(0) + "/lobby")
WS_SEND(w, "ich bin da")
DIM t AS INTEGER : t = MILLIS()
WHILE NOT WS_NEXT(w) AND MILLIS() - t < 5000
    SLEEP(5)
WEND
PRINT WS_MESSAGE$(w)
WS_CLOSE(w, 1000, "fertig")
--- erwartet
pfad /lobby
gegenstelle 127.0.0.1:
bekommen ich bin da
client schloss 1000 fertig
client sagt willkommen

=== eine anfrage ohne websocket bekommt 400
' Ein Browser fragt nach /favicon.ico -- das ist keine Verbindung.
IMPORT "websocket"
IMPORT "net"
DIM s AS WS_SERVER
s = WS_LISTEN(0, "127.0.0.1")
DIM c AS NET_SOCKET
c = NET_TCP_CONNECT("127.0.0.1", WS_PORT(s))
NET_SEND(c, "GET /favicon.ico HTTP/1.1" + CHR$(13) + CHR$(10) + "Host: x" + CHR$(13) + CHR$(10) + CHR$(13) + CHR$(10))
SLEEP(100)
PRINT "angenommen "; WS_ACCEPT(s)
DIM antwort AS STRING : antwort = ""
DIM t AS INTEGER : t = MILLIS()
WHILE INSTR(antwort, "WebSocket-Server") < 0 AND MILLIS() - t < 3000
    antwort = antwort + NET_RECV(c, 4096)
    SLEEP(10)
WEND
PRINT LEFT$(antwort, 24)
--- erwartet
angenommen -1
HTTP/1.1 400 Bad Request

=== ein unmaskierter rahmen vom client wird abgelehnt
' Handschlag und Rahmen von Hand ueber das net-Modul: der Schluessel ist der
' aus RFC 6455 1.3, die Antwort muss "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=" tragen.
' Danach ein Textrahmen OHNE Maske -- ein Server muss die Verbindung mit
' 1002 schliessen (RFC 6455 5.1).
IMPORT "websocket"
IMPORT "net"
DIM nl AS STRING : nl = CHR$(13) + CHR$(10)
DIM s AS WS_SERVER
s = WS_LISTEN(0, "127.0.0.1")
DIM c AS NET_SOCKET
c = NET_TCP_CONNECT("127.0.0.1", WS_PORT(s))
NET_SEND(c, "GET /roh HTTP/1.1" + nl + "Host: x" + nl + "Upgrade: websocket" + nl + "Connection: Upgrade" + nl + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" + nl + "Sec-WebSocket-Version: 13" + nl + nl)
SLEEP(100)
DIM w AS WEBSOCKET : w = WS_ACCEPT(s)
DIM antwort AS STRING : antwort = ""
DIM t AS INTEGER : t = MILLIS()
WHILE INSTR(antwort, nl + nl) < 0 AND MILLIS() - t < 3000
    antwort = antwort + NET_RECV(c, 4096)
    SLEEP(10)
WEND
PRINT LEFT$(antwort, 12); " "; INSTR(antwort, "Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=") >= 0
DIM r AS BUFFER : r = BUFFER_NEW(4)
BUFFER_SET(r, 0, 129) : BUFFER_SET(r, 1, 2) : BUFFER_SET(r, 2, 104) : BUFFER_SET(r, 3, 105)
NET_SEND(c, r)
SLEEP(100)
PRINT "nachricht "; WS_NEXT(w); " offen "; WS_CONNECTED(w); " code "; WS_CLOSE_CODE(w)
--- erwartet
HTTP/1.1 101 TRUE
nachricht FALSE offen FALSE code 1002

=== die gegenstelle bricht ab
' Ohne Schliess-Rahmen weg: Code 1006, wie im Browser.
IMPORT "websocket"
IMPORT "hilfe.dh"
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", "echo.dh")
DIM w AS WEBSOCKET
w = WS_CONNECT("ws://127.0.0.1:" + STR$(portVon(p)) + "/")
WS_SEND(w, "a")
PRINT antwort$(w)
PROCESS_KILL(p)
DIM t AS INTEGER : t = MILLIS()
WHILE WS_CONNECTED(w) AND MILLIS() - t < 5000
    SLEEP(10)
WEND
PRINT "weg "; WS_CONNECTED(w); " "; WS_CLOSE_CODE(w)
--- datei hilfe.dh
IMPORT "{sammlung}/../_hilfen/wshilfe.dh"
--- datei echo.dh
IMPORT "{sammlung}/../_hilfen/wsecho.dh"
--- erwartet
echo:a
weg FALSE 1006

=== ein fremder client: node
' Node ab 22 bringt einen WebSocket-Client mit (der aus den Browsern). Er
' prueft den Handschlag und die Rahmen nach seinen eigenen Regeln.
IMPORT "websocket"
IMPORT "hilfe.dh"
DIM v AS INTEGER : v = PROCESS_START("node", "-e", "console.log(typeof WebSocket)")
DIM art AS STRING : art = ""
DIM t AS INTEGER : t = MILLIS()
WHILE MILLIS() - t < 5000 AND (PROCESS_RUNNING(v) OR art = "")
    art = art + TRIM$(PROCESS_READ$(v))
    IF art <> "" AND NOT PROCESS_RUNNING(v) THEN EXIT WHILE
    SLEEP(20)
WEND
IF art <> "function" THEN
    PRINT "UEBERSPRINGEN: kein Node mit WebSocket (ab 22)"
    EXIT(0)
END IF
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", "echo.dh")
DIM port AS INTEGER : port = portVon(p)
DIM js AS STRING
js = "const w = new WebSocket('ws://127.0.0.1:" + STR$(port) + "/'); const a = [];"
js = js + " w.onopen = () => { w.send('vom browser'); w.send(new Uint8Array([1,2,3])); };"
js = js + " w.onmessage = async (e) => { a.push(typeof e.data === 'string' ? e.data : 'binaer ' + new Uint8Array(await e.data.arrayBuffer()).length);"
js = js + " if (a.length === 2) w.send('ende'); };"
js = js + " w.onclose = (e) => { console.log(a.join('|') + '|' + e.code + ' ' + e.reason); };"
DIM n AS INTEGER : n = PROCESS_START("node", "-e", js)
DIM aus AS STRING : aus = ""
DIM leer AS INTEGER : leer = 0
WHILE leer < 5
    DIM z AS STRING : z = PROCESS_READ$(n)
    IF z = "" THEN
        IF NOT PROCESS_RUNNING(n) THEN leer = leer + 1
        SLEEP(30)
    ELSE
        aus = aus + TRIM$(z)
    END IF
WEND
PRINT aus
--- datei hilfe.dh
IMPORT "{sammlung}/../_hilfen/wshilfe.dh"
--- datei echo.dh
IMPORT "{sammlung}/../_hilfen/wsecho.dh"
--- erwartet
echo:vom browser|binaer 3|4001 tschuess

=== fehler werden gemeldet
IMPORT "websocket"
DIM w AS WEBSOCKET
TRY
    w = WS_CONNECT("http://127.0.0.1/")
CATCH e
    PRINT e
END TRY
TRY
    w = WS_CONNECT("ws://127.0.0.1:1/")
CATCH e
    PRINT LEFT$(e, 26)
END TRY
TRY
    PRINT WS_SEND(5, "x")
CATCH e
    PRINT e
END TRY
--- erwartet
WS_CONNECT: "http://127.0.0.1/" ist keine WebSocket-Adresse (ws://... oder wss://...)
WS_CONNECT: 127.0.0.1:1 --
WS_SEND: ungueltiges/geschlossenes WEBSOCKET 5
