' Glutfaden Stufe 24: die Oberflaeche auf Deutsch und Englisch (Teil 1 --
' Hauptfenster, Werkzeugleiste, Seitenleiste, Statuszeile, Kuerzel).
' Jeder Anzeigetext geht durch tr$("deutsch") bzw. trf$("... {0} ...", [w]);
' auf Englisch kommt er aus daten/sprache/en.txt (Deutsch TAB Englisch).
'
' Der erste Fall liest den Quelltext selbst: jedes Literal in tr$/trf$ und
' jeder Name der Kuerzel-Tafel muss in der Tafel stehen, mit denselben
' Platzhaltern, und kein Eintrag der Tafel darf verwaist sein. Ein fehlender
' Eintrag ist sonst unsichtbar -- der Text bleibt einfach deutsch.
' Die Probe laeuft mit DH_GLUT_SPRACHE=en (eine Probe bleibt sonst deutsch)
' und sammelt, was in den gebauten Fenstern steht.


=== jeder angezeigte text steht in der tafel
IMPORT "helfer.dh"
' Die Tafel: Deutsch TAB Englisch -- doppelte Schluessel und leere Seiten sind Fehler
DIM tafel AS MAP OF STRING : tafel = {}
DIM doppelt AS ARRAY OF STRING : doppelt = []
DIM leer AS ARRAY OF STRING : leer = []
DIM z AS STRING
FOR EACH z IN READLINES(GLUTORDNER + "/daten/sprache/en.txt")
    z = REPLACE$(z, CHR$(13), "")
    DIM tab AS INTEGER : tab = INSTR(z, CHR$(9))
    IF tab >= 0 THEN
        DIM de AS STRING : de = LEFT$(z, tab)
        IF MAPHAS(tafel, de) THEN ARRAY_PUSH(doppelt, de)
        IF TRIM$(de) = "" OR TRIM$(MID$(z, tab + 1)) = "" THEN ARRAY_PUSH(leer, z)
        MAPPUT(tafel, de, MID$(z, tab + 1))
    END IF
NEXT

' Ein Kommentar endet die Zeile, ausser in einer Zeichenkette
FUNCTION ohneKommentar$(l AS STRING) AS STRING
    DIM q AS BOOLEAN : q = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(l) - 1
        DIM c AS STRING : c = MID$(l, i, 1)
        IF c = CHR$(34) THEN
            q = NOT q
        ELSEIF c = "'" AND NOT q THEN
            RETURN LEFT$(l, i)
        END IF
    NEXT
    RETURN l
END FUNCTION

' Die Platzhalter eines Textes, sortiert
FUNCTION platz$(t AS STRING) AS STRING
    DIM p AS ARRAY OF STRING : p = REGEX_FIND_ALL(t, "\{[^}]*\}")
    SORT(p)
    RETURN JOIN$(p, " ")
END FUNCTION

' Jedes Literal in tr$ und trf$ -- die Probe (vorfuehrung.dh) fragt mit
' Absicht nach einem Text, den es nicht gibt, und zeigt nichts an
DIM q AS STRING : q = CHR$(34)
DIM musterTr AS STRING : musterTr = "(?:^|[^A-Za-z0-9_])tr\$\(" + q + "([^" + q + "]*)" + q
DIM musterTrf AS STRING : musterTrf = "(?:^|[^A-Za-z0-9_])trf\$\(" + q + "([^" + q + "]*)" + q
DIM gesehen AS MAP OF STRING : gesehen = {}
DIM fehlt AS ARRAY OF STRING : fehlt = []
DIM falsch AS ARRAY OF STRING : falsch = []
DIM dateien AS INTEGER : dateien = 0
DIM f AS STRING
FOR EACH f IN DIRLIST_REC(GLUTORDNER, "*.dh")
    IF BASENAME(f) = "vorfuehrung.dh" THEN CONTINUE
    dateien = dateien + 1
    DIM nr AS INTEGER : nr = 0
    DIM l AS STRING
    FOR EACH l IN READLINES(PATHJOIN(GLUTORDNER, f))
        nr = nr + 1
        IF INSTR(l, "tr$(") < 0 AND INSTR(l, "trf$(") < 0 THEN CONTINUE
        l = ohneKommentar$(l)
        DIM t AS STRING
        FOR EACH t IN REGEX_FIND_ALL(l, musterTr)
            MAPPUT(gesehen, t, "tr")
            IF NOT MAPHAS(tafel, t) THEN ARRAY_PUSH(fehlt, BASENAME(f) + ":" + STR$(nr) + " " + t)
            ' tr$ setzt nichts ein -- ein {0} stuende woertlich da
            IF REGEX_TEST(t, "\{[0-9]+\}") THEN ARRAY_PUSH(falsch, "tr$ mit {n}: " + BASENAME(f) + ":" + STR$(nr) + " " + t)
        NEXT
        FOR EACH t IN REGEX_FIND_ALL(l, musterTrf)
            MAPPUT(gesehen, t, "trf")
            IF NOT MAPHAS(tafel, t) THEN ARRAY_PUSH(fehlt, BASENAME(f) + ":" + STR$(nr) + " " + t)
            IF NOT REGEX_TEST(t, "\{[0-9]+\}") THEN ARRAY_PUSH(falsch, "trf$ ohne {n}: " + BASENAME(f) + ":" + STR$(nr) + " " + t)
        NEXT
    NEXT
NEXT
' Die Namen der Kuerzel-Tafel (F1, Einstellungen) gehen durch tr$(a.name)
DIM a AS kern.Kuerzelaktion
DIM namen AS INTEGER : namen = 0
FOR EACH a IN kern.kuerzelAktionen()
    namen = namen + 1
    MAPPUT(gesehen, a.name, "ka")
    IF NOT MAPHAS(tafel, a.name) THEN ARRAY_PUSH(fehlt, "kuerzel " + a.kennung + " " + a.name)
NEXT
' Listen aus dem Kern sind dort Schluessel und bleiben deutsch -- die
' Ansicht uebersetzt sie beim Anzeigen (tr$(t), trListe), also muss jeder
' Eintrag in der Tafel stehen
DIM listenZahl AS INTEGER : listenZahl = 0
SUB listeDazu(l AS ARRAY OF STRING)
    DIM t AS STRING
    FOR EACH t IN l
        listenZahl = listenZahl + 1
        MAPPUT(gesehen, t, "liste")
        IF NOT MAPHAS(tafel, t) THEN ARRAY_PUSH(fehlt, "liste " + t)
    NEXT
END SUB
listeDazu(kern.erfahrungsstufen())
listeDazu(kern.bibliothekKategorien())
listeDazu(kern.bibliothekSortierungen())
listeDazu(kern.harmonieArten())
listeDazu(kern.vorlagenKategorien())
listeDazu(kern.farbSortierungen())
listeDazu(kern.startAktionen())
listeDazu(kern.pipettenArten())
listeDazu(kern.farbAnzeigen())
listeDazu(kern.dpVorlagenNamen())
listeDazu(kern.rasterVoreinstellungen())
listeDazu(["Eigene"])
DIM vl AS kern.Vorlage
FOR EACH vl IN kern.vorlagen()
    listeDazu([vl.kategorie, vl.name, vl.beschreibung])
NEXT
DIM anders AS ARRAY OF STRING : anders = []
DIM verwaist AS ARRAY OF STRING : verwaist = []
DIM k AS STRING
FOR EACH k IN MAPKEYS(tafel)
    IF platz$(k) <> platz$(tafel[k]) THEN ARRAY_PUSH(anders, k + " -> " + tafel[k])
    IF NOT MAPHAS(gesehen, k) THEN ARRAY_PUSH(verwaist, k)
NEXT
PRINT "tafel ueber 1500: "; LEN(MAPKEYS(tafel)) > 1500; " | doppelt "; LEN(doppelt); " | leer "; LEN(leer)
PRINT "dateien ueber 20: "; dateien > 20; " | texte ueber 1500: "; LEN(MAPKEYS(gesehen)) > 1500; " | kuerzel-namen "; namen; " | aus kern-listen ueber 100: "; listenZahl > 100
PRINT "fehlen in der tafel: "; LEN(fehlt)
FOR EACH k IN fehlt
    PRINT "  "; k
NEXT
PRINT "andere platzhalter: "; LEN(anders)
FOR EACH k IN anders
    PRINT "  "; k
NEXT
PRINT "falsch eingepackt: "; LEN(falsch)
FOR EACH k IN falsch
    PRINT "  "; k
NEXT
PRINT "verwaist: "; LEN(verwaist)
FOR EACH k IN verwaist
    PRINT "  "; k
NEXT
FOR EACH k IN doppelt
    PRINT "  doppelt: "; k
NEXT
