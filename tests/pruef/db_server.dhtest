=== postgres: platzhalter mit dollar und lastval
IMPORT "db"
IMPORT "hilfe.dh"
DIM c AS DB_CONN
c = DB_OPEN(dbZiel$("pg"))
' Ohne vergebene Kennung kennt die Verbindung kein lastval().
TRY
    PRINT DB_LAST_ROWID(c)
CATCH e
    PRINT INSTR(e, "RETURNING id") > 0
END TRY
DIM t AS STRING : t = dbTabelle$(c)
' $1, $2 duerfen auch selbst stehen -- dann wird nichts uebersetzt, und ein
' Wert darf zweimal gebraucht werden.
DB_EXEC(c, "INSERT INTO " + t + " (name, menge) VALUES ($1, $2), ($1, $2 + 1)", "zwei", 4)
DIM r AS DB_RESULT
r = DB_QUERY(c, "SELECT name, menge, '?' AS frage, $tag$ein ? hier$tag$ AS dollar FROM " + t + " WHERE menge > ? ORDER BY menge", 3)
WHILE DB_NEXT(r)
    PRINT DB_GET_STRING(r, 0), DB_GET_INT(r, 1), DB_GET_STRING(r, 2), DB_GET_STRING(r, 3)
WEND
' Typen, die es nur hier gibt, kommen als Text.
r = DB_QUERY(c, "SELECT '7c9e6679-7425-40de-944b-e07fc1f90ae7'::uuid, '{" + CHR$(34) + "a" + CHR$(34) + ": 1}'::jsonb, interval '1 day 02:00:00', 12.5::money")
DB_NEXT(r)
PRINT DB_GET_STRING(r, 0)
PRINT DB_GET_STRING(r, 1), DB_GET_STRING(r, 2), DB_GET_STRING(r, 3)
' Was Drachenhauch nicht liest, sagt, wie es doch geht.
TRY
    r = DB_QUERY(c, "SELECT ARRAY[1, 2] AS feld")
CATCH e
    PRINT e
END TRY
r = DB_QUERY(c, "SELECT ARRAY[1, 2]::text AS feld")
DB_NEXT(r)
PRINT DB_GET_STRING(r, 0)
DB_EXEC(c, "DROP TABLE " + t)
--- datei hilfe.dh
IMPORT "{sammlung}/_hilfen/dbserver.dh"
--- erwartet
TRUE
zwei 4 ? ein ? hier
zwei 5 ? ein ? hier
7c9e6679-7425-40de-944b-e07fc1f90ae7
{"a": 1} 1 day 02:00:00 12.50
DB_QUERY: Spalte 0 (feld): den Typ _int4 liest Drachenhauch (noch) nicht -- in der Abfrage mit ::text umwandeln
{1,2}
