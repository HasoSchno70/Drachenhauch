=== server ohne starttls sagt es deutlich
IMPORT "smtp"
IMPORT "gegen.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_SERVER(m, "127.0.0.1", starten("AUTH PLAIN LOGIN", "1", "1"), "starttls")
SMTP_FROM(m, "ich@beispiel.de", "Abteilung Zahlen")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Auswertung August")
SMTP_TEXT(m, "Anbei die Zahlen.")
TRY
    SMTP_SEND(m)
    PRINT "raus"
CATCH e
    PRINT INSTR(e, "kein STARTTLS") >= 0
END TRY
beenden()
