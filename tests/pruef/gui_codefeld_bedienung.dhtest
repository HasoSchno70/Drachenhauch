=== der rollbalken laesst sich ziehen
' 100 Zeilen; der Balken liegt im rechten Innenabstand (x 283..287). Nach
' unten gezogen zeigt das Feld das Ende.
IMPORT "gui"
SCREEN(300, 450, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 450)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 280, 200)
DIM t AS STRING : t = "zeile 1"
DIM k AS INTEGER
FOR k = 2 TO 100
    t = t + CHR$(10) + "zeile " + STR$(k)
NEXT
GUI_SET_TEXT(ta, t)
GUI_TEXTAREA_GOTO(ta, 1, 1)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
DIM v AS TUPLE : v = GUI_TEXTAREA_VIEW(ta)
DIM c AS TUPLE : c = GUI_TEXTAREA_CURSOR(ta)
PRINT "am ende "; v[0] + v[1] >= 100; " marke bleibt "; c[0]
--- datei ev.txt
c 5
e 0 7 5 440 0 0
e 1 7 285 20 0 0
e 2 6 0 0 0 0
e 4 7 285 430 0 0
e 6 5 0 0 0 0

--- umgebung
DHRT_FRAMES=12
--- erwartet
am ende TRUE marke bleibt 1

=== das mausrad rollt weich
' Ein Radschritt sind drei Zeilen; drei Schritte rollen neun. Weich heisst:
' dazwischen stehen Zwischenstaende, und am Ende steht die Ansicht bei 9
' (GUI_TEXTAREA_VIEW zaehlt die erste Zeile ab 0).
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 280, 200)
DIM t AS STRING : t = "zeile 1"
DIM k AS INTEGER
FOR k = 2 TO 100
    t = t + CHR$(10) + "zeile " + STR$(k)
NEXT
GUI_SET_TEXT(ta, t)
GUI_TEXTAREA_GOTO(ta, 1, 1)
DIM zwischen AS BOOLEAN
DIM v AS TUPLE
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    v = GUI_TEXTAREA_VIEW(ta)
    IF v[0] > 0 AND v[0] < 9 THEN zwischen = TRUE
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "erste "; v[0]; " zwischen "; zwischen
--- datei ev.txt
c 3
e 0 7 5 215 0 0
e 1 7 150 100 0 0
e 2 8 0 -3 0 0

--- umgebung
DHRT_FRAMES=25
--- erwartet
erste 9 zwischen TRUE

