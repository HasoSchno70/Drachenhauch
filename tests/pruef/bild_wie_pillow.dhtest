11x8 TRUE

=== falsche angaben sind fehler
IMPORT "imgfx"
DIM q AS IMAGE : q = IMAGE_NEW(4, 4, &HFF8800)
TRY
    q = IMAGE_SCALE(q, 2, 2, "weich")
CATCH e
    PRINT e
END TRY
TRY
    q = IMAGE_ENHANCE(q, "schaerfe", 1.0)
CATCH e
    PRINT e
END TRY
TRY
    q = IMAGE_ENHANCE(q, "kontrast", -1)
CATCH e
    PRINT e
END TRY
PRINT GETPIXEL(IMAGE_ENHANCE(q, "helligkeit", 1.0), 1, 1) = &HFF8800

--- erwartet
IMAGE_SCALE: unbekannter Filter 'weich' -- moeglich sind lanczos, bikubisch, box, hamming, linear
IMAGE_ENHANCE: unbekannte Art 'schaerfe' -- moeglich sind helligkeit, kontrast, saettigung
IMAGE_ENHANCE: der Faktor muss eine Zahl ab 0 sein
TRUE
