=== pdf: was in der datei steht
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Gelesen mit dem PDF-Leser der Pruefungen: Seiten, Texte, Symbole je Seite,
' Seitengroesse, Durchsicht des Wasserzeichens. Ein Absatz steht Wort fuer
' Wort im PDF (er bricht um) -- fuer Fliesstext werden die Zeilen einer Seite
' darum wieder aneinandergehaengt.
IMPORT "pdftext.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
DIM o AS kern.PdfOptionen : o = gePdfOptionen(pal, "A4", 0, 0, "", "", FALSE, "")
DIM ab AS ARRAY OF STRING : ab = kern.pdfExportieren(m, "ohne", o)
PRINT "endung "; FILEEXISTS("ohne.pdf")
DIM s AS ARRAY OF STRING : s = pdfSeiten("ohne.pdf")
PRINT "seiten "; LEN(s)
PRINT "deckblatt "; INSTR(s[0], "KREUZSTICH-MUSTER") >= 0; " "; INSTR(s[0], "ohne") >= 0; " "; INSTR(s[0], "12 × 9 Stiche") >= 0; " "; INSTR(s[0], "(c) 2026 Tab") >= 0
PRINT "legende "; INSTR(s[2], "Christmas Red") >= 0; " "; INSTR(REPLACE$(s[2], CHR$(10), ""), "Perlen (Beads)") >= 0; " "; INSTR(s[2], "Mill Hill Beads 00557") >= 0
FUNCTION zeilen(t AS STRING, z AS STRING) AS INTEGER
    DIM n AS INTEGER, x AS STRING
    FOR EACH x IN SPLIT$(t, CHR$(10))
        IF x = z THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
PRINT "musterseite "; INSTR(REPLACE$(s[4], CHR$(10), ""), "Seite 1 von 1 | Spalten 1-12 · Zeilen 1-9") >= 0; " ● "; zeilen(s[4], "●"); " □ "; zeilen(s[4], "□"); " ○ "; zeilen(s[4], "○")
PRINT "fusszeile "; INSTR(REPLACE$(s[4], CHR$(10), ""), "ohne · Seite 1/1 · 16.10.2026") >= 0
DIM w AS ARRAY OF STRING : w = pdfWoerter()
PRINT "ohne wasserzeichen: ca "; pdfWortZahl(w, "/ca")
PRINT "a4 "; INSTR(JOIN$(w, " "), "/MediaBox [0 0 595.2756 841.8898 ]") >= 0
o = gePdfOptionen(pal, "A3", 0, 0, "", "", FALSE, "ENTWURF")
ab = kern.pdfExportieren(m, "mit.pdf", o)
s = pdfSeiten("mit.pdf")
w = pdfWoerter()
PRINT "mit wasserzeichen: ca "; pdfWortZahl(w, "/ca"); " formulare je seite "; pdfWortZahl(w, "Do") = LEN(s)
PRINT "a3 "; INSTR(JOIN$(w, " "), "/MediaBox [0 0 841.8898 1190.5511 ]") >= 0
