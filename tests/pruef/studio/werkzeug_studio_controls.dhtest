CLASS Hauptfenster EXTENDS Hauptfenster_Basis
    SUB messen_Aktion()
        PRINT "seite "; GUI_TABCONTROL_PAGE(Self.reiter); " treffer knopf "; GUI_HIT_TEST(40, 75) = Self.seite1.knopf
        GUI_TABCONTROL_SET_PAGE(Self.reiter, 1)
        GUI_UPDATE()
        PRINT "seite "; GUI_TABCONTROL_PAGE(Self.reiter); " treffer knopf "; GUI_HIT_TEST(40, 75) = Self.seite1.knopf
    END SUB
END CLASS
