' Fuenf Enemies fliegen in V-Formation rein.
'
' Statt fuer jeden Gegner ein eigenes Pos-Update zu schreiben, geben
' wir jedem einen Y-Tween mit `out_back`-Easing - kommt von oben rein,
' ueberschiesst leicht, federt zurueck. Der staffelnde Effekt entsteht
' durch unterschiedliche Tween-Dauern.

IMPORT "tween"

CONST WIDTH    AS INTEGER = 320
CONST HEIGHT   AS INTEGER = 240
CONST BG_COLOR AS INTEGER = &H141E3C
CONST ENEMY_C  AS INTEGER = &HFF6677

' V-Formation: Index 2 ist die Spitze, Indices 0..1 + 3..4 die Fluegel.
DIM xs[5]        AS INTEGER
DIM target_ys[5] AS INTEGER
DIM tweens[5]    AS TWEEN

xs[0] =  60 : target_ys[0] = 60
xs[1] = 110 : target_ys[1] = 50
xs[2] = 160 : target_ys[2] = 40
xs[3] = 210 : target_ys[3] = 50
xs[4] = 260 : target_ys[4] = 60

' Verschiedene Dauern erzeugen den staffelnden Einflug-Effekt.
DIM i AS INTEGER
FOR i = 0 TO 4
    tweens[i] = TWEEN_NEW(-20.0, target_ys[i] + 0.0, 1500 + i * 200, "out_back")
NEXT i

SCREEN(WIDTH, HEIGHT, "Formation", 2)

WHILE NOT QUITREQUESTED()
    CLS(BG_COLOR)

    DIM j AS INTEGER
    FOR j = 0 TO 4
        DIM y AS INTEGER
        y = INT(TWEEN_VALUE(tweens[j]))
        BOX(xs[j] - 8, y - 7, xs[j] + 8, y + 7, ENEMY_C)
    NEXT j

    FLIP()
    SLEEP(16)
WEND
