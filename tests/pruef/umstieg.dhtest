=== eine sub mit yield ist eine coroutine und liefert ein handle
SUB ticker()
    YIELD 1
    YIELD 2
END SUB
DIM c AS COROUTINE
c = ticker()
PRINT CORO_RESUME(c); CORO_RESUME(c)
--- erwartet
12

=== zeichnen ohne fenster
' Ohne SCREEN legt ein Bildbefehl ein VERSTECKTES Fenster an (fuer den
' GL-Kontext). Wer darin auf den Schirm zeichnet, sah nie ein Bild -- und
' bekam kein Wort dazu.
BOX(0, 0, 10, 10, RED)
--- fehler
BOX: es gibt noch kein Fenster -- vor dem ersten Zeichenbefehl SCREEN(breite, hoehe, "Titel") aufrufen

=== flip ohne fenster
FLIP()
--- fehler
FLIP: es gibt noch kein Fenster

=== cls ohne fenster
CLS()
--- fehler
CLS: es gibt noch kein Fenster

=== mit screen zeichnet dieselbe zeile
SCREEN(40, 30, "Probe")
CLS(BLUE)
BOX(0, 0, 10, 10, RED)
FLIP()
PRINT "gezeichnet"
--- erwartet
gezeichnet

=== ein bild entsteht auch ohne fenster
' Die Gegenprobe zur Fenster-Pflicht: IMAGE_*/imgfx brauchen keinen Schirm,
' sie zeichnen in ein Bild. Das darf die Pruefung nicht mitnehmen.
IMPORT "imgfx"
DIM b AS IMAGE
b = IMAGE_NEW(8, 8, RED)
IMAGE_FILL_RECT(b, 0, 0, 4, 4, GREEN)
PRINT GETPIXEL(b, 1, 1) = GREEN
--- erwartet
TRUE

=== gezeichnet aber nie gezeigt
SCREEN(40, 30, "Probe")
BOX(0, 0, 10, 10, RED)
PRINT "fertig"
--- erwartet
fertig
--- stderr
FLIP() fehlt

=== der hinweis kommt nur ohne flip
' Gegenprobe im Fall: dasselbe Programm einmal mit und einmal ohne FLIP,
' beide als Kind gestartet -- anders ist "der Satz steht NICHT da" nicht zu
' pruefen (eine Erwartung sagt nur, was drinsteht).
IMPORT "helfer.dh"
dlStarten(["run", "ohne.dh"])
' Gefragt wird der RUECKGABEWERT, nicht der Meldungstext: ein Bau ohne Grafik
' sagt "im Rust-Kern noch nicht verfuegbar", eine Maschine ohne Bildschirm
' "Kein Fenster moeglich" -- beide Male ist am Hinweis nichts zu pruefen.
IF dlCode <> 0 THEN
    PRINT "UEBERSPRINGEN: das Kind konnte nicht zeichnen"
    EXIT(0)
END IF
PRINT "ohne flip: "; INSTR(dlErr, "FLIP() fehlt") >= 0
dlStarten(["run", "mit.dh"])
PRINT "mit flip:  "; INSTR(dlErr, "FLIP() fehlt") >= 0
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- datei ohne.dh
SCREEN(40, 30, "Probe")
BOX(0, 0, 10, 10, RED)
PRINT "fertig"
--- datei mit.dh
SCREEN(40, 30, "Probe")
BOX(0, 0, 10, 10, RED)
FLIP()
PRINT "fertig"
--- erwartet
ohne flip: TRUE
mit flip:  FALSE

