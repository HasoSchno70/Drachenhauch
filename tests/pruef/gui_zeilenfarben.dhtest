' GUI_TEXTAREA_LINE_COLORS: ein Farbband hinter ganzen Zeilen (die IDE zeigt
' so ein Profil im Code). Geprueft am Bild: rechts in der Zeile, wo kein Text
' steht, ist der Grund rot getoent, in den anderen Zeilen nicht; eine
' eingefuegte Zeile darueber nimmt das Band mit, und GET sagt, wo es steht.

=== das band liegt hinter seiner zeile und wandert mit
IMPORT "gui"
SCREEN(500, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_THEME_PRESET("dark")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 500, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 0, 0, 480, 180)
GUI_SET_TEXT(ta, "a = 1" + CHR$(10) + "b = 2" + CHR$(10) + "c = 3")
' Wie rot ist die Zeile rechts (hinter dem Text)? Rot minus Gruen im Mittel.
FUNCTION rot(zeile AS INTEGER) AS INTEGER
    DIM f AS INTEGER
    FOR f = 1 TO 2
        GUI_UPDATE() : CLS(BLACK) : GUI_DRAW() : FLIP()
    NEXT
    SAVESCREENSHOT("bild.png")
    DIM b AS IMAGE : b = LOADIMAGE("bild.png")
    DIM summe AS INTEGER : summe = 0
    DIM n AS INTEGER : n = 0
    DIM y AS INTEGER
    FOR y = 2 TO 120
        DIM zz AS INTEGER
        DIM ss AS INTEGER
        (zz, ss) = GUI_TEXTAREA_POS_AT(ta, 12, y)
        IF zz <> zeile THEN CONTINUE
        DIM c AS INTEGER : c = GETPIXEL(b, 300, y)
        summe = summe + ((c SHR 16) BAND 255) - ((c SHR 8) BAND 255)
        n = n + 1
    NEXT
    IMAGE_FREE(b)
    DELETEFILE("bild.png")
    IF n = 0 THEN RETURN -999
    RETURN summe \ n
END FUNCTION
PRINT "ohne "; rot(2) > 40
GUI_TEXTAREA_LINE_COLORS(ta, [2], [&HC0FF2020])
PRINT "zeile 2 "; rot(2) > 40
PRINT "zeile 1 "; rot(1) > 40
PRINT "wo "; GUI_TEXTAREA_LINE_COLORS_GET(ta)[0]
' Eine Zeile darueber einfuegen: das Band wandert nach Zeile 3.
GUI_TEXTAREA_SELECT(ta, 1, 1, 1, 1)
GUI_TEXTAREA_INSERT(ta, "neu = 0" + CHR$(10))
PRINT "danach wo "; GUI_TEXTAREA_LINE_COLORS_GET(ta)[0]
PRINT "danach zeile 3 "; rot(3) > 40
PRINT "danach zeile 2 "; rot(2) > 40
GUI_TEXTAREA_LINE_COLORS(ta, [], [])
PRINT "geloescht "; rot(3) > 40
PRINT "leer "; LEN(GUI_TEXTAREA_LINE_COLORS_GET(ta))
--- umgebung
DHRT_FRAMES=40
--- erwartet
ohne FALSE
zeile 2 TRUE
zeile 1 FALSE
wo 2
danach wo 3
danach zeile 3 TRUE
danach zeile 2 FALSE
geloescht FALSE
leer 0

=== ohne deckkraft ein viertel, falsche listen sind ein fehler
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 0, 0, 280, 180)
GUI_SET_TEXT(ta, "a" + CHR$(10) + "b")
GUI_TEXTAREA_LINE_COLORS(ta, [1, 2], [&HFF0000, &H00FF00])
PRINT LEN(GUI_TEXTAREA_LINE_COLORS_GET(ta))
TRY
    GUI_TEXTAREA_LINE_COLORS(ta, [1, 2], [&HFF0000])
CATCH e
    PRINT e
END TRY
--- erwartet
2
GUI_TEXTAREA_LINE_COLORS: beide Listen muessen gleich lang sein (2 Zeilen, 1 Farben)
