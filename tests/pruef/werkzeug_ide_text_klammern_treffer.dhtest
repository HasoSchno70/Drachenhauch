FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr gross |HALLO WELT_NEU X2| 1-18
pr anfang |Hallo Welt_neu X2|
pr klein |hallo welt_neu x2|
pr wort |ZWEITE zeile|

=== zeilen verbinden
DIM prTa AS GUI_WIDGET : prTa = tabFelder[aktiverTab]
GUI_TEXTAREA_SELECT(prTa, 1, 3, 2, 2)
befehl("zl_verbinden")
' Ohne Auswahl: diese und die naechste (die leere faellt weg).
GUI_TEXTAREA_GOTO(prTa, 2, 1)
befehl("zl_verbinden")
DIM prZ AS STRING
FOR EACH prZ IN SPLIT$(GUI_TEXT(prTa), NL)
    protokoll("pr zeile |" + prZ + "|")
NEXT
EXIT(0)
