=== sprite: ein verlaufsschritt macht ungesichert
DIM prN AS INTEGER
DIM prS AS INTEGER
--- programm ../../examples/189_sprite_editor.dh nach SETFPS(60)
--- ersetzen SET_FULLSCREEN(TRUE)
SET_WINDOW_POS(-3000, -3000)

--- einschub nach FLIP()
prN = prN + 1
IF prN = 3 THEN
    schrittBeginn() : schrittEnde()
    SETWINDOWTITLE("DH-Kreuz-sprite-v")
    prS = PROCESS_START("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", GETENV$("PRSENDER"), "DH-Kreuz-sprite-v", "kreuz")
END IF
WRITEALL("probe.txt", STR$(prN) + " " + IIF(GUI_MODAL(), "frage", "keine"))

--- umgebung
DHRT_FRAMES=360
PRSENDER={sammlung}/_hilfen/fenstersender.ps1
--- nachher
