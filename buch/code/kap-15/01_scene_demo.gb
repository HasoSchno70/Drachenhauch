' Drei Scenes mit SCENE_SWITCH wechseln.
'
' Title -> Playing -> GameOver -> Title (Loop). Demonstriert das Pattern:
' Loop-Body besteht aus einem SELECT CASE SCENE_CURRENT(), pro Scene
' eigener Update- und Draw-Block.

IMPORT "scene"

CONST WIDTH  AS INTEGER = 320
CONST HEIGHT AS INTEGER = 240

SCENE_SWITCH("title")

SCREEN(WIDTH, HEIGHT, "Scene Demo", 2)

WHILE NOT QUITREQUESTED()
    SELECT CASE SCENE_CURRENT()
        CASE "title"
            CLS(&H141E3C)
            TEXT(WIDTH / 2 - 40, 80, "TITLE-SCREEN", &HFFDC00)
            TEXT(WIDTH / 2 - 60, 120, "ENTER -> Spiel", &HFFFFFF)
            IF KEYPRESSED(KEY_RETURN) THEN
                SCENE_SWITCH("playing")
            END IF

        CASE "playing"
            CLS(&H101A30)
            TEXT(WIDTH / 2 - 28, 80, "SPIELE...", &HFFDC00)
            TEXT(WIDTH / 2 - 60, 120, "ESC -> Game Over", &HFFFFFF)
            IF KEYPRESSED(KEY_ESCAPE) THEN
                SCENE_SWITCH("gameover")
            END IF

        CASE "gameover"
            CLS(&H300010)
            TEXT(WIDTH / 2 - 32, 80, "GAME OVER", &HFF4444)
            TEXT(WIDTH / 2 - 90, 120, "ENTER -> zurueck zum Titel", &HFFFFFF)
            IF KEYPRESSED(KEY_RETURN) THEN
                SCENE_SWITCH("title")
            END IF
    END SELECT

    FLIP()
    SLEEP(16)
WEND
