=== den verweis einer spalte im spalten-gitter setzen
' In die Zelle "Verweis auf" der Spalte kunde "kunden" einfuegen: die Spalte
' wird eine Ganzzahl, Daten.dhdb nennt das Ziel, die Datei behaelt die Werte.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
SETENV("DH_STUDIO_OEFFNEN", "Daten.rechnungen")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, "", 12, p)
DIM x AS INTEGER
DIM y AS INTEGER
slHin(10, 10)
slWarten(10)
(x, y) = slLage(log, "dbzelle sp 0 5")
slKlick(x, y)
slWarten(4)
slMit([341], 86)
slWarten(10)
slMit([341], 83)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_ABLAGE", "kunden")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "db ")
    PRINT z
NEXT
DIM j AS JSON_HANDLE : j = JSON_LOAD(p + "/Daten.dhdb")
PRINT "dhdb "; JSON_GET_STRING(j, "tabellen.1.spalten.0.name"); " "; JSON_GET_STRING(j, "tabellen.1.spalten.0.typ"); " "; JSON_GET_STRING(j, "tabellen.1.spalten.0.verweis")
DIM db AS DB_CONN : db = DB_OPEN(p + "/daten.sqlite")
DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT kunde, typeof(kunde) FROM rechnungen")
IF DB_NEXT(r) THEN PRINT "wert "; DB_GET_STRING(r, 0); " "; DB_GET_STRING(r, 1)
DB_CLOSE(db)
