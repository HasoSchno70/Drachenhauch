=== fehler beim laden sagen, was fehlt
TRY
    PRINT SPELL_LOAD("gibtsnicht.dic")
CATCH e
    PRINT LEFT$(e, 46)
END TRY
TRY
    PRINT SPELL_SUGGEST(0, "x", 0)
CATCH e
    PRINT e
END TRY
--- erwartet
SPELL_LOAD: 'gibtsnicht.dic' laesst sich nicht
SPELL_SUGGEST: hoechstens 0 Vorschlaege -- erwartet 1 oder mehr

=== die sprachen kommen aus dem ordner
' DHRT_WOERTERBUECHER geht vor -- auch unter Windows, dann ohne die
' Systempruefung.
DIM n AS ARRAY OF STRING
n = SPELL_LANGUAGES()
PRINT JOIN$(n, ",")
DIM h AS INTEGER
h = SPELL_SYSTEM("de")
PRINT SPELL_LANGUAGE$(h); " "; SPELL_CHECK(h, "Baum")
h = SPELL_SYSTEM("en_US")
PRINT SPELL_LANGUAGE$(h); " "; SPELL_CHECK(h, "tree")
TRY
    PRINT SPELL_SYSTEM("fr")
CATCH e
    PRINT e
END TRY
--- verzeichnis buecher
--- datei buecher/de_AT.dic
1
Baum

--- datei buecher/de_AT.aff
SET UTF-8

--- datei buecher/en_US.dic
1
tree

--- datei buecher/en_US.aff
SET UTF-8

--- datei buecher/nur.dic
1
x

--- umgebung
DHRT_WOERTERBUECHER={fall}/buecher
--- erwartet
de-AT,en-US
de-AT TRUE
en-US TRUE
SPELL_SYSTEM: kein Woerterbuch fuer 'fr' -- verfuegbar sind: de-AT, en-US

=== die pruefung von windows
' Die Sprachen sind die, die Windows installiert hat. Ohne Deutsch und
' Englisch uebergeht sich der Fall. Das Emoji vorn prueft die Umrechnung von
' UTF-16-Einheiten (Windows) in Zeichen (Drachenhauch).
DIM n AS ARRAY OF STRING
n = SPELL_LANGUAGES()
DIM sprache AS STRING
DIM gut AS STRING
DIM falsch AS STRING
DIM satz AS STRING
IF ARRAY_INDEXOF(n, "de-DE") >= 0 THEN
    sprache = "de-DE" : gut = "Haus" : falsch = "Hasu" : satz = "😀 Ein Hasu im Garten"
ELSEIF ARRAY_INDEXOF(n, "en-US") >= 0 THEN
    sprache = "en-US" : gut = "house" : falsch = "hosue" : satz = "😀 A hosue in the garden"
ELSE
    PRINT "UEBERSPRINGEN: weder de-DE noch en-US in der Rechtschreibung von Windows"
    END
END IF
DIM h AS INTEGER
h = SPELL_SYSTEM(sprache)
PRINT SPELL_CHECK(h, gut); " "; SPELL_CHECK(h, falsch)
PRINT "vorschlag "; ARRAY_INDEXOF(SPELL_SUGGEST(h, falsch), gut) >= 0
DIM s AS ARRAY OF INTEGER
DIM l AS ARRAY OF INTEGER
(s, l) = SPELL_ERRORS(h, satz)
PRINT LEN(s); " "; MID$(satz, s[0], l[0]) = falsch
SPELL_IGNORE(h, falsch)
PRINT SPELL_CHECK(h, falsch)
--- system windows
--- erwartet
TRUE FALSE
vorschlag TRUE
1 TRUE
TRUE

=== ein textbereich prueft nach einer pause
IMPORT "gui"
SCREEN(500, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 20, 20, 460, 150)
GUI_SET_TEXT(ta, "Ein Hasu im Gartn")
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic")
GUI_SPELL(ta, h)
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 3 THEN PRINT "gleich "; GUI_SPELL_COUNT(ta)
    IF n = 30 THEN
        ' Im ersten Wort korrigiert: dessen Welle faellt sofort weg, die
        ' andere bleibt; gefunden wird das neue Wort erst nach der Pause.
        GUI_SET_TEXT(ta, "Ein Haus Bam im Gartn")
    END IF
    IF n = 31 THEN PRINT "nach dem tippen "; GUI_SPELL_COUNT(ta)
    IF n = 40 THEN PRINT "in der pause "; GUI_SPELL_COUNT(ta)
    IF n = 60 THEN PRINT "danach "; GUI_SPELL_COUNT(ta)
    IF n = 61 THEN GUI_SPELL(ta, -1)
    IF n = 62 THEN PRINT "abgeschaltet "; GUI_SPELL_COUNT(ta)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei de-TEST.dic
4
Haus
Garten
ein
im

--- datei de-TEST.aff
SET UTF-8

--- umgebung
DHRT_FRAMES=64
--- erwartet
gleich 2
nach dem tippen 1
in der pause 1
danach 2
abgeschaltet 0

=== die wellen stehen unter dem falschen wort
' Rot unter dem Text, und nur dort, wo ein falsches Wort steht.
IMPORT "gui"
SCREEN(500, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 20, 20, 460, 70)
GUI_SET_TEXT(ta, "Haus Hasu Haus")
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 120, 460, 30)
GUI_SET_TEXT(tf, "Haus Hasu Haus")
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic")
GUI_SPELL(ta, h)
GUI_SPELL(tf, h)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
