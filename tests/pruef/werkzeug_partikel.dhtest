IF prBild = 3 THEN
    prOx = GUI_CANVAS_X(flaeche) - GUI_GET_X(flaeche)
    prOy = GUI_CANVAS_Y(flaeche) - GUI_GET_Y(flaeche)
    prFall()
END IF
IF prStart >= 0 THEN prProbe(prBild - prStart)
