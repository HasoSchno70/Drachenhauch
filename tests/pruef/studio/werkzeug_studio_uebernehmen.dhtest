=== der abgleich laesst die uebernommene datei, wie sie ist
' Aufbau, Indexe und Zeilen vorher und nachher: Zeichen fuer Zeichen gleich.
' Ohne "sql"/"sqlvorgabe" baute der Abgleich jede Tabelle mit DATE, TIMESTAMP
' oder einer Pflichtspalte ohne Vorgabe neu auf (ohne AUTOINCREMENT und
' FOREIGN KEY), und fuer jedes UNIQUE kaeme ein zweiter Index dazu.
IMPORT "kern.dh"
projOrdner = CWD$()
dateiAnlegen("kuehl.db")
DIM vorher AS STRING : vorher = aufbau$("kuehl.db")
DIM e AS Element : e = elementNeu("datenbank", "Vorrat")
e.schema = dbSchemaAusDatei$("kuehl.db", "kuehl.db")
PRINT "abgleich [" + dbAbgleichen$(e) + "]"
DIM nachher AS STRING : nachher = aufbau$("kuehl.db")
PRINT "unveraendert "; nachher = vorher
IF nachher <> vorher THEN PRINT nachher
' Der Daten-Editor liest auch die Tabelle ohne id (ueber rowid).
PRINT "[" + dbZeilenLesen$(e, "app_settings", 10) + "] "; dbGesamt; " "; JOIN$(dbZellen, "|")
PRINT "[" + dbZelleSetzen$(e, "app_settings", 2, "value", "en") + "]"
PRINT "[" + dbZeilenLesen$(e, "app_settings", 10) + "] "; JOIN$(dbZellen, "|")
