' 154_chart.gb -- Modul "chart": alle sechs Diagrammarten.
'
' Sieben Felder, jedes mit anderen Stellschrauben. Die Maus hebt Segmente,
' Balken und Punkte hervor und zeigt eine Sprechblase.
'
'   MAUS         ueber ein Element fahren -> Hervorhebung + Sprechblase
'   LEERTASTE    Thema wechseln
'   V            Verlauf auf den Daten an/aus
'   S            weiche Schatten an/aus
'   1 / 2        Deckkraft (Alpha) aller Datenfarben
'   HOCH/RUNTER  Drehzahl

IMPORT "chart"

SCREEN(1280, 820, "GameBasic -- Diagramme")

' Zeichensatz: die Diagramme malen ihren Text mit der Schrift, die in
' "schrift" steht (FONT-Handle aus LOADFONT, -1 = eingebaute Pixelschrift).
' Eine echte TTF ist bei kleinen Groessen deutlich besser lesbar.
DIM schrift AS INTEGER
DIM fp AS STRING
schrift = -1
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "C:/Windows/Fonts/calibri.ttf", "C:/Windows/Fonts/arial.ttf")
    IF schrift < 0 AND FILEEXISTS(fp) THEN schrift = LOADFONT(fp, 32)
NEXT
IF schrift >= 0 THEN SETFONT(schrift)
TEXT_SIZE(17)

DIM kuchen AS CHART
DIM balken AS CHART
DIM linie AS CHART
DIM tacho AS CHART
DIM leiste AS CHART
DIM lampen AS CHART
DIM rang AS CHART

' --- Kuchen: Donut mit herausgezogenen Segmenten -------------------
kuchen = CHART_NEW("kuchen", 20, 20, 400, 340)
CHART_SET(kuchen, "titel", "Rohstoffe")
CHART_ADD(kuchen, "Holz", 45.0, 9127187)
CHART_ADD(kuchen, "Stein", 30.0, 8421504)
CHART_ADD(kuchen, "Erz", 15.0, 16753920)
CHART_ADD(kuchen, "Gold", 10.0, 16776960)
CHART_SET_NUM(kuchen, "innenradius", 0.55)
CHART_SET_NUM(kuchen, "abstand", 4)
CHART_SET(kuchen, "werte", "aussen")
CHART_SET(kuchen, "legende", "links")
CHART_SET_FLAG(kuchen, "prozent", TRUE)

' --- Balken: zwei Reihen, gestapelt --------------------------------
DIM r_ein AS INTEGER
DIM r_aus AS INTEGER
DIM ein[7] AS FLOAT
DIM aus[7] AS FLOAT
DIM tage AS ARRAY OF STRING
DIM i AS INTEGER

balken = CHART_NEW("balken", 440, 20, 400, 340)
CHART_SET(balken, "titel", "Woche")
CHART_SET(balken, "achse_x", "Tag")
r_ein = CHART_SERIES(balken, "Einnahmen")   ' ohne Farbe = aus der Palette
r_aus = CHART_SERIES(balken, "Ausgaben")
tage = SPLIT("Mo,Di,Mi,Do,Fr,Sa,So", ",")
FOR i = 0 TO 6
    ein[i] = 20.0 + RND(60)
    aus[i] = 10.0 + RND(30)
NEXT
CHART_DATA(balken, r_ein, ein)
CHART_DATA(balken, r_aus, aus)
FOR i = 0 TO 6
    CHART_LABEL(balken, i, tage[i])
NEXT
CHART_SET_FLAG(balken, "stapel", TRUE)
CHART_SET(balken, "legende", "unten")
CHART_SET_NUM(balken, "abstand", 10)
CHART_SET_NUM(balken, "ecken", 3)
CHART_SET(balken, "einheit", " G")

' --- Tacho: Segment-Zifferblatt, benannte Zonen, Zeiger zieht nach --
DIM drehzahl AS FLOAT
drehzahl = 1200.0
tacho = CHART_NEW("tacho", 860, 20, 400, 340)
CHART_SET(tacho, "titel", "Drehzahl")
CHART_SET(tacho, "zifferblatt", "segmente")
CHART_SET(tacho, "wertanzeige", "pille")
CHART_SET_NUM(tacho, "min", 0)
CHART_SET_NUM(tacho, "max", 8000)
CHART_SET_NUM(tacho, "striche", 9)
CHART_SET_NUM(tacho, "unterstriche", 4)
CHART_SET_NUM(tacho, "animation", 0.4)
CHART_ZONE(tacho, 0, 5000, 5025616, "NORMAL")
CHART_ZONE(tacho, 5000, 6500, 16776960, "ACHTUNG")
CHART_ZONE(tacho, 6500, 8000, 16711680, "ROT")

' --- Linie: Live-Kurve mit gleitendem Fenster ----------------------
DIM r_fps AS INTEGER
linie = CHART_NEW("linie", 20, 380, 400, 360)
CHART_SET(linie, "titel", "Bildrate")
r_fps = CHART_SERIES(linie, "FPS")
CHART_SET_NUM(linie, "fenster", 120)
CHART_SET_NUM(linie, "min", 0)
CHART_SET_NUM(linie, "max", 120)
CHART_SET_FLAG(linie, "flaeche", TRUE)
CHART_SET_FLAG(linie, "glatt", TRUE)
CHART_SET_NUM(linie, "linien_dicke", 2.5)
CHART_SET_NUM(linie, "flaeche_deckkraft", 0.4)

' --- Leiste + Lampen: die linearen Anzeigen ------------------------
leiste = CHART_NEW("leiste", 440, 380, 400, 170)
CHART_SET(leiste, "titel", "Fuellstand")
CHART_SET(leiste, "zeigerform", "balken")
CHART_SET_NUM(leiste, "max", 100)
CHART_SET(leiste, "einheit", " %")

lampen = CHART_NEW("led", 440, 570, 400, 170)
CHART_SET(lampen, "titel", "Pegel")
CHART_SET_NUM(lampen, "blatt_teile", 16)
CHART_SET_NUM(lampen, "blatt_luecke", 5)
CHART_SET_NUM(lampen, "max", 100)

' --- Balken waagerecht ---------------------------------------------
DIM punkte[5] AS FLOAT
DIM namen AS ARRAY OF STRING
rang = CHART_NEW("balken", 860, 380, 400, 360)
CHART_SET(rang, "titel", "Bestenliste")
CHART_SET(rang, "ausrichtung", "waagerecht")
CHART_SERIES(rang, "Punkte")
punkte[0] = 92.0
punkte[1] = 78.0
punkte[2] = 65.0
punkte[3] = 51.0
punkte[4] = 34.0
CHART_DATA(rang, 0, punkte)
namen = SPLIT("Anna,Bruno,Cem,Dora,Emil", ",")
FOR i = 0 TO 4
    CHART_LABEL(rang, i, namen[i])
NEXT
CHART_SET(rang, "werte", "innen")
CHART_SET_NUM(rang, "abstand", 8)
CHART_SET_NUM(rang, "ecken", 4)

' --- gemeinsamer Stil ----------------------------------------------
DIM themen AS ARRAY OF STRING
DIM t_idx AS INTEGER
DIM alle AS ARRAY OF CHART
DIM verlauf AS BOOLEAN
DIM weich AS BOOLEAN
DIM deckkraft AS FLOAT
DIM stil AS CHART
themen = SPLIT("dunkel,hell,neon,pastell", ",")
t_idx = 0
alle = [kuchen, balken, linie, tacho, leiste, lampen, rang]
verlauf = TRUE
weich = TRUE
deckkraft = 1.0

' Schatten, Verlauf, Deckkraft und Sprechblase betreffen alle gleich --
' deshalb eine Hilfsroutine statt sieben Mal derselbe Block.
SUB stil_anwenden()
    FOR EACH stil IN alle
        CHART_SET_NUM(stil, "schrift", schrift)
        CHART_SET_NUM(stil, "text_groesse", 15)
        CHART_SET_NUM(stil, "titel_groesse", 22)
        CHART_SET_FLAG(stil, "verlauf_daten", verlauf)
        CHART_SET_FLAG(stil, "schatten_daten", weich)
        CHART_SET_FLAG(stil, "tooltip", TRUE)
        CHART_SET_NUM(stil, "schatten", IIF(weich, 6, 0))
        CHART_SET_NUM(stil, "schatten_weich", IIF(weich, 6, 0))
        CHART_SET_NUM(stil, "deckkraft", deckkraft)
    NEXT
END SUB

stil_anwenden()

' QUITREQUESTED() statt nur ESC: eine Schleife, die es nie fragt, laeuft
' headless (GBRT_FRAMES) endlos weiter -- die Demo liess sich damit nicht
' als Bild aufnehmen.
WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(KEY_ESCAPE) THEN BREAK
    ' --- Eingabe ---
    IF KEYHIT(KEY_SPACE) THEN
        t_idx = (t_idx + 1) MOD 4
        FOR EACH stil IN alle
            CHART_THEME(stil, themen[t_idx])
        NEXT
        stil_anwenden()          ' Thema setzt die Farben neu -> Stil nachziehen
    END IF
    IF KEYHIT(ASC("v")) THEN
        verlauf = NOT verlauf
        stil_anwenden()
    END IF
    IF KEYHIT(ASC("s")) THEN
        weich = NOT weich
        stil_anwenden()
    END IF
    IF KEYPRESSED(ASC("2")) THEN
        deckkraft = MIN(1.0, deckkraft + 0.6 * DELTA())
        stil_anwenden()
    END IF
    IF KEYPRESSED(ASC("1")) THEN
        deckkraft = MAX(0.1, deckkraft - 0.6 * DELTA())
        stil_anwenden()
    END IF
    IF KEYPRESSED(KEY_UP) THEN drehzahl = MIN(8000.0, drehzahl + 2000.0 * DELTA())
    IF KEYPRESSED(KEY_DOWN) THEN drehzahl = MAX(0.0, drehzahl - 2000.0 * DELTA())

    ' --- Daten nachfuehren ---
    CHART_VALUE(tacho, drehzahl)
    CHART_VALUE(leiste, drehzahl / 80.0)
    CHART_VALUE(lampen, drehzahl / 80.0)
    CHART_PUSH(linie, r_fps, FPS())
    CHART_UPDATE(tacho, DELTA())

    ' --- Zeichnen ---
    CLS(0)
    FOR EACH stil IN alle
        CHART_DRAW(stil)
    NEXT

    ' Anklicken meldet, was getroffen wurde.
    IF CHART_CLICKED(kuchen) >= 0 THEN
        TEXT(20, 772, "Angeklickt: " + CHART_HOVER_LABEL$(kuchen))
    ELSE
        TEXT(20, 772, f"MAUS Hervorhebung   LEERTASTE Thema ({themen[t_idx]})   V Verlauf   S Schatten   1/2 Deckkraft {deckkraft:.2f}   ESC Ende")
    END IF
    FLIP()
WEND
