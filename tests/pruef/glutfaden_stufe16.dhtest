' Glutfaden Stufe 16: Farbleiste (ansicht/farbleiste.dh, PyStickys
' ColorBar), Hervorheben, "Nicht sticken" (kern/bearbeiten.dh) und die
' Willkommensseite (ansicht/willkommen.dh, WelcomeWidget).
'
' Was sich rechnen laesst, steht im ersten Fall; der Rest ist Bedienung und
' Bild -- die Probe der Farbleiste und zwei Startlaeufe ohne Muster.

=== nicht sticken als schritt, gedimmte farben
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("farbprobe.pxs")
m.stichzahlenNeu()
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM vorher AS STRING : vorher = fvStand$(m)
DIM g0 AS kern.Garnrechnung : g0 = kern.garnRechnen(m, 14, 0.0, 0.0)
PRINT "aus: "; kern.farbeAuslassen(m, v, 2, TRUE); " | nochmal "; kern.farbeAuslassen(m, v, 2, TRUE); " | falsche nummer "; kern.farbeAuslassen(m, v, 99, TRUE)
DIM g1 AS kern.Garnrechnung : g1 = kern.garnRechnen(m, 14, 0.0, 0.0)
PRINT "garn: zeilen "; LEN(g0.zeilen); " -> "; LEN(g1.zeilen); " | ausgelassen "; g1.ausgelasseneFarben; " | schritt '"; v.textZurueck$(); "' | schritte "; LEN(v.rueck)
PRINT "stand sonst gleich: "; fvStand$(m) = vorher; " | auslassen "; m.farben[2].auslassen
DIM ok AS BOOLEAN : ok = v.zurueckNehmen(m)
PRINT "zurueck: "; m.farben[2].auslassen; " | gleich "; fvStand$(m) = vorher
ok = v.wiederholen(m)
PRINT "vor: "; m.farben[2].auslassen
PRINT "wieder an: "; kern.farbeAuslassen(m, v, 2, FALSE); " '"; v.textZurueck$(); "' "; m.farben[2].auslassen
' Gedimmt: Deckkraft max(20, a \ 5) ueber dem Stoff
PRINT "gedimmt: "; HEX$(kern.gedimmt(&HC72B3B, &HFAFAF5, 255)); " "; HEX$(kern.gedimmt(&H000000, &HFFFFFF, 255)); " | halbe ebene "; HEX$(kern.gedimmt(&H000000, &HFFFFFF, 128)); " | fast unsichtbar "; HEX$(kern.gedimmt(&H000000, &HFFFFFF, 40)); " | dunkler stoff "; HEX$(kern.gedimmt(&HFFFFFF, &H202020, 255))
