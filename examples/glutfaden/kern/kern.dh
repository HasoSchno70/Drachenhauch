' Der Kern von Glutfaden -- ohne Oberflaeche. Eingebunden als
'     IMPORT "kern/kern.dh" AS kern
' Die Teile tragen denselben Namensraum "kern" (mehrere Dateien mit einem
' Alias bilden EINEN Raum) und sehen einander dadurch ohne Vorsatz.
IMPORT "json"
IMPORT "zeit"
IMPORT "imgfx"
IMPORT "stich.dh" AS kern
IMPORT "garn.dh" AS kern
IMPORT "ebene.dh" AS kern
IMPORT "muster.dh" AS kern
IMPORT "formen.dh" AS kern
IMPORT "verlauf.dh" AS kern
IMPORT "bearbeiten.dh" AS kern
IMPORT "auswahl.dh" AS kern
IMPORT "bildimport.dh" AS kern
IMPORT "pxs.dh" AS kern
