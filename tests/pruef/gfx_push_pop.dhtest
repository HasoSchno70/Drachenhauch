' Aus test_gfx_push_pop.py uebertragen (5 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== kamera schrift und stapeltiefe
IMPORT "camera"
SCREEN(120, 80, "p", 1)
PRINT GFX_DEPTH()
GFX_PUSH()
CAMERA_SET(120.0, 80.0, 2.0)
PRINT STR$(INT(CAMERA_X())) + " " + FORMAT$(CAMERA_ZOOM(), "%.1f") + " " + STR$(GFX_DEPTH())
GFX_POP()
PRINT STR$(INT(CAMERA_X())) + " " + FORMAT$(CAMERA_ZOOM(), "%.1f") + " " + STR$(GFX_DEPTH())
--- erwartet
0
120 2.0 1
0 1.0 0

=== pop ohne push meldet sich
SCREEN(64, 64, "p", 1)
GFX_POP()
--- fehler
GFX_POP: der Stapel ist leer -- zu jedem GFX_POP gehoert ein GFX_PUSH

=== verschachteln geht
IMPORT "camera"
SCREEN(64, 64, "p", 1)
GFX_PUSH()
CAMERA_SET(10.0, 0.0, 1.0)
GFX_PUSH()
CAMERA_SET(99.0, 0.0, 1.0)
GFX_POP()
PRINT INT(CAMERA_X())
GFX_POP()
PRINT INT(CAMERA_X())
--- erwartet
10
0

=== audio lautstaerke kommt zurueck
IMPORT "audio"
SCREEN(64, 64, "p", 1)
AUDIO_BUS_VOLUME("music", 0.8)
PRINT FORMAT$(AUDIO_BUS_GET_VOLUME("music"), "%.2f") + " " + STR$(AUDIO_DEPTH())
AUDIO_PUSH()
AUDIO_BUS_VOLUME("music", 0.1)
PRINT FORMAT$(AUDIO_BUS_GET_VOLUME("music"), "%.2f") + " " + STR$(AUDIO_DEPTH())
AUDIO_POP()
PRINT FORMAT$(AUDIO_BUS_GET_VOLUME("music"), "%.2f") + " " + STR$(AUDIO_DEPTH())
--- erwartet
0.80 0
0.10 1
0.80 0

=== audio pop ohne push meldet sich
IMPORT "audio"
SCREEN(64, 64, "p", 1)
AUDIO_POP()
--- fehler
AUDIO_POP: der Stapel ist leer -- zu jedem AUDIO_POP gehoert ein AUDIO_PUSH

=== das bild ist nach pop wieder identisch[LIGHT_AMBIENT(&HFF0000, 1.0)]
' Zweimal dasselbe zeichnen, dazwischen den Zustand verstellen und zurueckholen
' -- Punkt fuer Punkt verglichen. Die Zeile "wirkte" ist die Kontrolle: ohne
' sie waere der Fall auch gruen, wenn die Stoerung gar nichts getan haette.
' (Bis Stufe 46 in test_gfx_push_pop.py.)
IMPORT "g3d"
SCREEN(160, 120, "p", 1)
LIGHT_ENABLE()
LIGHT_AMBIENT(&H203040, 0.5)
LIGHT_DIRECTIONAL(-0.5, -0.8, -0.4, &HFFE0B0)
DIM kugel AS INTEGER
kugel = MESH_SPHERE(1.0, 24, 24)
MODEL_LIT(kugel)
SUB zeichne()
    DIM f AS INTEGER
    FOR f = 0 TO 3
        CLS(&H101018)
        CAMERA3D(0, 1, 4, 0, 0, 0, 45)
        MODEL(kugel, 0, 0, 0, 1.0, &HD0D0D0)
        FLIP()
    NEXT
END SUB
zeichne()
SAVESCREENSHOT("vorher.png")
GFX_PUSH()
LIGHT_AMBIENT(&HFF0000, 1.0)
zeichne()
SAVESCREENSHOT("waehrend.png")
GFX_POP()
zeichne()
SAVESCREENSHOT("nachher.png")
--- nachher
FUNCTION gleich(pa AS STRING, pb AS STRING) AS BOOLEAN
    DIM a AS IMAGE : a = LOADIMAGE(pa)
    DIM b AS IMAGE : b = LOADIMAGE(pb)
    IF IMAGEWIDTH(a) <> IMAGEWIDTH(b) OR IMAGEHEIGHT(a) <> IMAGEHEIGHT(b) THEN RETURN FALSE
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 0 TO IMAGEHEIGHT(a) - 1
        FOR x = 0 TO IMAGEWIDTH(a) - 1
            IF GETPIXEL(a, x, y) <> GETPIXEL(b, x, y) THEN RETURN FALSE
        NEXT
    NEXT
    RETURN TRUE
END FUNCTION
PRINT "wirkte "; NOT gleich("vorher.png", "waehrend.png")
PRINT "gleich "; gleich("vorher.png", "nachher.png")
--- erwartet
wirkte TRUE
gleich TRUE

