=== tippen springt zur passenden zeile
' "b" waehlt Birne, ein zweites "b" Banane (dieselbe Taste laeuft durch).
' Gesucht wird in der ersten Spalte, weil nicht sortiert ist. Was innerhalb
' einer Sekunde ECHTER Zeit getippt wird, ist ein Wort -- ohne Fenster
' laufen die Bilder in Bruchteilen davon, darum steht "k" in einem eigenen
' Fall (sonst suchte er "bbk").
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 10, 10, 280, 200)
GUI_TABLE_HEADERS(tb, ["Name", "Preis"])
GUI_TABLE_ADD_ROW(tb, ["Apfel", "1"]) : GUI_TABLE_ADD_ROW(tb, ["Birne", "2"])
GUI_TABLE_ADD_ROW(tb, ["Banane", "3"]) : GUI_TABLE_ADD_ROW(tb, ["Kirsche", "4"])
GUI_FOCUS(tb)
DIM zuletzt AS INTEGER : zuletzt = -1
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_TABLE_SELECTED(tb) <> zuletzt THEN zuletzt = GUI_TABLE_SELECTED(tb) : PRINT GUI_TABLE_GET_CELL(tb, zuletzt, 0)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 5
e 0 7 5 215 0 0
e 2 2 66 0 0 0
e 3 1 66 0 0 0
e 5 2 66 0 0 0
e 6 1 66 0 0 0

--- umgebung
DHRT_FRAMES=12
--- erwartet
Birne
Banane

=== tippen springt in der sortierspalte
' Nach Preis sortiert: "4" waehlt die Zeile mit Preis 4 (Kirsche), obwohl
' in der ersten Spalte nichts mit 4 anfaengt.
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 10, 10, 280, 200)
GUI_TABLE_HEADERS(tb, ["Name", "Preis"])
GUI_TABLE_ADD_ROW(tb, ["Apfel", "1"]) : GUI_TABLE_ADD_ROW(tb, ["Birne", "2"])
GUI_TABLE_ADD_ROW(tb, ["Banane", "3"]) : GUI_TABLE_ADD_ROW(tb, ["Kirsche", "4"])
GUI_TABLE_SORT(tb, 1, FALSE)
GUI_FOCUS(tb)
DIM zuletzt AS INTEGER : zuletzt = -1
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_TABLE_SELECTED(tb) <> zuletzt THEN zuletzt = GUI_TABLE_SELECTED(tb) : PRINT GUI_TABLE_GET_CELL(tb, zuletzt, 0)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
