=== monster ziehen im spielertempo
' Ein Feuerball im freien Korridor zieht je world_tick einen Schritt geradeaus:
' Start (3,5), drei Ticks nach rechts -> (6,5). Bei Halbtempo waere x < 6.
IMPORT "circuit.dh"
DIM prOben AS ARRAY OF INTEGER : prOben = prLeer()
DIM prUnten AS ARRAY OF INTEGER : prUnten = prLeer()
prOben[1 * 32 + 1] = &H6C
prOben[5 * 32 + 3] = &H47
prOben[1 * 32 + 30] = &H15
DIM prH AS JSON_HANDLE : prH = prSet("SpeedTest")
prLevel(prH, "Speed", 1, 0, "", "ABCD", prOben, prUnten, "")
prSchreiben(prH)
js = JSON_LOAD(prSynth$())
nlevels = JSON_LEN(js, "levels")
load_level(0)
state = "play"
DIM prT AS INTEGER
FOR prT = 0 TO 2
    want_dir = -1
    world_tick()
NEXT
PRINT "POS " + STR$(mob_x[0]) + " " + STR$(mob_y[0])
EXIT(0)
