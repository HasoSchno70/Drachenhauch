=== property inherited (1)
' Property in Basisklasse -> auch von Subklasse zugreifbar.
CLASS Shape
    DIM _name AS STRING

    PROPERTY GET name() AS STRING
        RETURN Self._name
    END PROPERTY

    PROPERTY SET name(v AS STRING)
        Self._name = "[" + v + "]"
    END PROPERTY
END CLASS

CLASS Circle EXTENDS Shape
    DIM r AS FLOAT
END CLASS

DIM c AS Circle
c = NEW Circle()
c.name = "circle"
PRINT c.name
--- erwartet
[circle]

=== property inherited (2)
' Property in Basisklasse -> auch von Subklasse zugreifbar.
CLASS Shape
    DIM _name AS STRING

    PROPERTY GET name() AS STRING
        RETURN Self._name
    END PROPERTY

    PROPERTY SET name(v AS STRING)
        Self._name = "[" + v + "]"
    END PROPERTY
END CLASS

CLASS Circle EXTENDS Shape
    DIM r AS FLOAT
END CLASS

DIM c AS Circle
c = NEW Circle()
c.name = "circle"
PRINT c.name
--- erwartet
[circle]

=== property setter in method (1)
' Setter kann aus einer Methode aufgerufen werden.
CLASS Counter
    DIM _n AS INTEGER

    PROPERTY GET n() AS INTEGER
        RETURN Self._n
    END PROPERTY

    PROPERTY SET n(v AS INTEGER)
        Self._n = v
    END PROPERTY

    SUB Increment()
        Self.n = Self.n + 1
    END SUB
END CLASS

DIM c AS Counter
c = NEW Counter()
c.n = 5
c.Increment()
c.Increment()
PRINT c.n
--- erwartet
7

=== property setter in method (2)
