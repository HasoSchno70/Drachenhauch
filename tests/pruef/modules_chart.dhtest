=== unbekannter schluessel nennt die gueltigen[CHART SET-"x"]
' Der Preis der String-Schluessel: der Tippfehler faellt erst zur
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("balken", 0, 0, 100, 100)
TRY
    CHART_SET(c, "gibtsnicht", "x")
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_SET: unbekannte Eigenschaft 'gibtsnicht' (gueltig: titel, einheit, achse_x, achse_y, legende, werte, ausrichtung, zeigerform, zifferblatt, wertanzeige, punktform)

=== unbekannter schluessel nennt die gueltigen[CHART SET NUM-1.0]
' Der Preis der String-Schluessel: der Tippfehler faellt erst zur
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("balken", 0, 0, 100, 100)
TRY
    CHART_SET_NUM(c, "gibtsnicht", 1.0)
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_SET_NUM: unbekannte Eigenschaft 'gibtsnicht' (gueltig: min, max, innenradius, abstand, ecken, rahmen_dicke, polster, gitter, nachkomma, titel_groesse, text_groesse, schrift, start_winkel, end_winkel, striche, unterstriche, linien_dicke, punkt_radius, animation, fenster, schatten, schatten_weich, deckkraft, flaeche_deckkraft, hover_tempo, hover_weite, hover_glanz, glanz, blatt_teile, blatt_luecke, blatt_dicke, fassung, strich)

=== unbekannter schluessel nennt die gueltigen[CHART SET COLOR-255]
' Der Preis der String-Schluessel: der Tippfehler faellt erst zur
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("balken", 0, 0, 100, 100)
TRY
    CHART_SET_COLOR(c, "gibtsnicht", 255)
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_SET_COLOR: unbekannte Eigenschaft 'gibtsnicht' (gueltig: hintergrund, rahmen, gitter, text, titel, achse, zeiger, flaeche, verlauf, schatten, verlauf_ende, skala_von, skala_mitte, skala_bis)

=== unbekannter schluessel nennt die gueltigen[CHART SET FLAG-TRUE]
' Der Preis der String-Schluessel: der Tippfehler faellt erst zur
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("balken", 0, 0, 100, 100)
TRY
    CHART_SET_FLAG(c, "gibtsnicht", TRUE)
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_SET_FLAG: unbekannte Eigenschaft 'gibtsnicht' (gueltig: rahmen, gitter_x, gitter_y, prozent, flaeche, punkte, glatt, null_linie, stapel, verlauf, verlauf_daten, schatten_daten, kurz, hover, tooltip, treppe, fadenkreuz)

=== ungueltiger stil wert wird abgelehnt
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("balken", 0, 0, 100, 100)
TRY
    CHART_SET(c, "legende", "schraeg")
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_SET: legende erwartet aus/oben/unten/links/rechts, nicht 'schraeg'

=== theme nennt die verfuegbaren
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("balken", 0, 0, 100, 100)
CHART_THEME(c, "neon")
TRY
    CHART_THEME(c, "quietschbunt")
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_THEME: unbekanntes Thema 'quietschbunt' (gueltig: dunkel, hell, neon, pastell)

=== falscher handle typ meldet klartext
IMPORT "chart"
TRY
    PRINT CHART_COUNT(42)
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_COUNT erwartet CHART

=== reihe ausserhalb meldet klartext
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("balken", 0, 0, 100, 100)
CHART_SERIES(c, "a", 0)
TRY
    CHART_PUSH(c, 7, 1.0)
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_PUSH: Reihe 7 gibt es nicht

=== clear leert die daten
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("kuchen", 0, 0, 100, 100)
CHART_ADD(c, "a", 1.0, 0)
CHART_ADD(c, "b", 2.0, 0)
CHART_CLEAR(c)
PRINT CHART_COUNT(c)
--- erwartet
0

=== zonen sammeln und leeren
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("tacho", 0, 0, 100, 100)
CHART_ZONE(c, 50, 80, 16776960)
CHART_ZONE(c, 80, 100, 16711680)
CHART_ZONE_CLEAR(c)
PRINT "ok"
--- erwartet
ok

=== null groesse wird abgelehnt
IMPORT "chart"
DIM c AS CHART
TRY
    c = CHART_NEW("balken", 0, 0, 0, 100)
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_NEW: Breite und Hoehe muessen > 0 sein

=== tacho bringt seine reihe schon mit
' IMPORT "chart" ohne .dh-Endung nimmt immer das eingebaute Modul.
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("tacho", 0, 0, 10, 10)
PRINT CHART_SERIES_COUNT(c)
--- erwartet
1

=== hover abfragen sind ohne zeichnen leer
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("kuchen", 0, 0, 100, 100)
CHART_ADD(c, "a", 1.0, 0)
PRINT CHART_HOVER(c)
PRINT CHART_HOVER_SERIES(c)
PRINT CHART_CLICKED(c)
PRINT "[" + CHART_HOVER_LABEL$(c) + "]"
PRINT CHART_HOVER_VALUE(c)
--- erwartet
-1
-1
-1
[]
0.0

