=== doppelklick nur fuer listen
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM lb AS GUI_WIDGET
lb = GUI_LISTBOX(w, 20, 20, 200, 120, SPLIT$("Apfel|Birne|Kirsche|Dattel", "|"))
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "k", 20, 200, 60, 24)
TRY
    PRINT GUI_DOUBLE_CLICKED(b)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
GUI_DOUBLE_CLICKED: bisher nur fuer Listen (GUI_LISTBOX)

=== zusatz ueberlebt die datei und fehlt ohne zusatz
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM lb AS GUI_WIDGET
lb = GUI_LISTBOX(w, 20, 20, 200, 120, SPLIT$("Apfel|Birne|Kirsche|Dattel", "|"))
DIM j0 AS STRING : j0 = GUI_TO_JSON(w)
PRINT INSTR(j0, CHR$(34) + "list" + CHR$(34) + ":") >= 0
GUI_LISTBOX_SET(lb, "kaestchen", 1) : GUI_LISTBOX_SET_CHECKED(lb, 1, TRUE)
GUI_LISTBOX_SET(lb, "mehrfachauswahl", 1) : GUI_LISTBOX_SELECT(lb, 3, TRUE)
GUI_LISTBOX_COLOR(lb, 0, 255)
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT GUI_TO_JSON(w2) = j
DIM lb2 AS GUI_WIDGET : lb2 = GUI_WINDOW_WIDGET(w2, 1)
PRINT GUI_LISTBOX_CHECKED(lb2, 1) ; " " ; GUI_LISTBOX_IS_SELECTED(lb2, 3) ; " " ; GUI_LISTBOX_SEL_COUNT(lb2)
--- umgebung
DHRT_FRAMES=1
--- erwartet
FALSE
TRUE
TRUE TRUE 1

