Zum [zweiten Dokument](bbb.md) geht es hier; das Wort nadel steht auch darin.
--- datei wurzel/docs/bbb.md
Das zweite Dokument.
--- datei _programm/ev.txt
c 6
e 40 2 290 0 0 0
e 42 1 290 0 0 0
e 90 7 260 162 0 0
e 91 7 260 162 0 0
e 91 6 0 0 0 0
e 92 5 0 0 0 0

--- verzeichnis wurzel/examples
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(p AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION alleEnden(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            n = n + 1
            IF RIGHT$(L[i], LEN(e)) <> e THEN RETURN FALSE
        END IF
    NEXT
    RETURN n > 0
END FUNCTION
FUNCTION inhalt$(datei AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(z) - 1
        r = r + z[i] + CHR$(10)
    NEXT
    RETURN r
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION pruefe$(datei AS STRING) AS STRING
    DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", datei)
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM befund AS STRING : befund = ""
    WHILE MILLIS() < bis
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN befund = befund + zz
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN BREAK
    WEND
    RETURN TRIM$(befund)
END FUNCTION
FUNCTION steht(datei AS STRING, t AS STRING) AS BOOLEAN
    RETURN INSTR(inhalt$(datei), t) >= 0
END FUNCTION
PRINT "aaa " ; erste$("handbuch aaa.md") <> ""
PRINT "bbb " ; erste$("handbuch bbb.md") <> ""
--- erwartet
aaa TRUE
bbb TRUE

=== die suche im handbuch geht weiter und zurueck
' Protokoll "hbsuche <y> <anzahl> <text>": Enter weiter, Umschalt+Enter zurueck.
