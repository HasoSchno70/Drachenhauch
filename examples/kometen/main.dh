' kometen -- ein kleines Arcade-Spiel: ein Schiff, Kometen, die zerbrechen,
' und eine Bestenliste, die gespeichert wird.
'
' Steuerung: Pfeile oder A/D drehen, Pfeil hoch oder W gibt Schub, Leertaste
' schiesst. P haelt an (verliert das Fenster den Fokus, haelt das Spiel von
' selbst an), M schaltet den Ton, F11 Vollbild. Ein Gamepad geht auch: linker
' Stick lenkt, A schiesst, B gibt Schub.
IMPORT "input"
IMPORT "scene"
IMPORT "save"
IMPORT "particles"
IMPORT "audio"
IMPORT "imgfx"
IMPORT "camera"

CONST BREITE = 800
CONST HOEHE = 600
CONST PLAETZE = 5

SCREEN(BREITE, HOEHE, "Kometen", 1)
SETFPS(60)
RANDOMIZE()

' --- Bilder, im Programm gezeichnet ----------------------------------------
FUNCTION schiffBild() AS INTEGER
    DIM b AS INTEGER
    b = IMAGE_NEW(32, 32)
    IMAGE_FILL_POLY(b, [30.0, 4.0, 10.0, 4.0], [16.0, 4.0, 16.0, 28.0], RGB(120, 200, 255))
    IMAGE_FILL_ELLIPSE(b, 18, 16, 4, 4, RGB(255, 255, 255))
    RETURN b
END FUNCTION

FUNCTION kometBild(r AS INTEGER) AS INTEGER
    DIM b AS INTEGER
    b = IMAGE_NEW(r * 2 + 2, r * 2 + 2)
    IMAGE_FILL_ELLIPSE(b, r + 1, r + 1, r, r, RGB(150, 130, 110))
    IMAGE_FILL_ELLIPSE(b, r * 0.7, r * 0.8, r * 0.25, r * 0.25, RGB(110, 95, 80))
    IMAGE_FILL_ELLIPSE(b, r * 1.3, r * 1.3, r * 0.18, r * 0.18, RGB(110, 95, 80))
    RETURN b
END FUNCTION

DIM bildSchiff AS INTEGER
bildSchiff = schiffBild()
DIM bildGross AS INTEGER
bildGross = kometBild(40)
DIM bildMittel AS INTEGER
bildMittel = kometBild(22)
DIM bildKlein AS INTEGER
bildKlein = kometBild(12)
WINDOW_ICON(bildSchiff)

' --- Klaenge -----------------------------------------------------------------
DIM tonAn AS BOOLEAN
tonAn = TRUE
DIM klangSchuss AS SOUND
klangSchuss = AUDIO_SFX("square", 880.0, -1200.0, 2, 40, 60, 0.0, 0.0, 0.25)
DIM klangKnall AS SOUND
klangKnall = AUDIO_NOISE(220, 0.5)
DIM klangEnde AS SOUND
klangEnde = AUDIO_SFX("saw", 220.0, -180.0, 5, 300, 400, 6.0, 4.0, 0.4)

SUB spiele(k AS SOUND)
    IF tonAn THEN AUDIO_PLAY(k)
END SUB

' --- Tasten ------------------------------------------------------------------
INPUT_BIND("links", KEY_LEFT, KEY_A)
INPUT_BIND("rechts", KEY_RIGHT, KEY_D)
INPUT_BIND("schub", KEY_UP, KEY_W, JOY_BUTTON_B)
INPUT_BIND("feuer", KEY_SPACE, JOY_BUTTON_A)
INPUT_BIND("pause", KEY_P)
INPUT_BIND("ton", KEY_M)
INPUT_BIND("vollbild", KEY_F11)
INPUT_BIND("weiter", KEY_ENTER, KEY_SPACE, JOY_BUTTON_A)

' --- Bestenliste -------------------------------------------------------------
DIM bestenliste AS SAVE_HANDLE
bestenliste = SAVE_LOAD_OR_NEW("bestenliste.json")

FUNCTION platz(i AS INTEGER) AS INTEGER
    RETURN SAVE_GET_INT_OR(bestenliste, "platz" + STR$(i), 0)
END FUNCTION

' Traegt eine Punktzahl ein; liefert den Platz (1..PLAETZE) oder 0.
FUNCTION eintragen(punkte AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 1 TO PLAETZE
        IF punkte > platz(i) THEN
            DIM k AS INTEGER
            FOR k = PLAETZE TO i + 1 STEP -1
                SAVE_SET_INT(bestenliste, "platz" + STR$(k), platz(k - 1))
            NEXT
            SAVE_SET_INT(bestenliste, "platz" + STR$(i), punkte)
            SAVE_WRITE(bestenliste, "bestenliste.json")
            RETURN i
        END IF
    NEXT
    RETURN 0
END FUNCTION

' --- Spielobjekte ------------------------------------------------------------
CLASS Komet
    DIM x AS FLOAT
    DIM y AS FLOAT
    DIM vx AS FLOAT
    DIM vy AS FLOAT
    DIM r AS INTEGER
    DIM winkel AS FLOAT
    DIM dreh AS FLOAT
    DIM lebt AS BOOLEAN
END CLASS

CLASS Schuss
    DIM x AS FLOAT
    DIM y AS FLOAT
    DIM vx AS FLOAT
    DIM vy AS FLOAT
    DIM rest AS FLOAT      ' Sekunden, bis er verlischt
END CLASS

DIM kometen AS ARRAY OF Komet
DIM schuesse AS ARRAY OF Schuss
DIM funken AS ARRAY OF PARTICLE_SYSTEM

DIM sx AS FLOAT
DIM sy AS FLOAT
DIM svx AS FLOAT
DIM svy AS FLOAT
DIM swinkel AS FLOAT
DIM leben AS INTEGER
DIM punkte AS INTEGER
DIM welle AS INTEGER
DIM schutz AS FLOAT        ' Sekunden unverwundbar nach einem Treffer
DIM nachladen AS FLOAT
DIM pausiert AS BOOLEAN
DIM neuerPlatz AS INTEGER

FUNCTION neuerKomet(x AS FLOAT, y AS FLOAT, r AS INTEGER) AS Komet
    DIM k AS Komet
    k = NEW Komet()
    k.x = x
    k.y = y
    DIM w AS FLOAT
    w = RND() * TAU
    DIM v AS FLOAT
    v = (40 + RND() * 60) * (1 + welle * 0.1) * (40 / r) ^ 0.5
    k.vx = COS(w) * v
    k.vy = SIN(w) * v
    k.r = r
    k.winkel = RND() * 360
    k.dreh = (RND() - 0.5) * 120
    k.lebt = TRUE
    RETURN k
END FUNCTION

SUB welleStarten()
    welle += 1
    DIM i AS INTEGER
    FOR i = 1 TO 2 + welle
        ' am Rand, nicht auf dem Schiff
        DIM x AS FLOAT
        DIM y AS FLOAT
        IF RND() < 0.5 THEN
            x = RND() * BREITE
            y = IIF(RND() < 0.5, -40.0, HOEHE + 40.0)
        ELSE
            x = IIF(RND() < 0.5, -40.0, BREITE + 40.0)
            y = RND() * HOEHE
        END IF
        ARRAY_PUSH(kometen, neuerKomet(x, y, 40))
    NEXT
END SUB

SUB spielStarten()
    kometen = []
    schuesse = []
    funken = []
    sx = BREITE / 2
    sy = HOEHE / 2
    svx = 0
    svy = 0
    swinkel = -90
    leben = 3
    punkte = 0
    welle = 0
    schutz = 2
    pausiert = FALSE
    welleStarten()
    SCENE_SWITCH("spiel")
END SUB

SUB explosion(x AS FLOAT, y AS FLOAT, menge AS INTEGER)
    DIM p AS PARTICLE_SYSTEM
    p = PARTICLE_SYSTEM_NEW(x, y)
    PARTICLE_SET_VELOCITY(p, -160, 160, -160, 160)
    PARTICLE_SET_LIFETIME(p, 300, 800)
    PARTICLE_SET_SIZE(p, 1, 3)
    PARTICLE_SET_COLOR(p, RGB(255, 220, 120))
    PARTICLE_SET_COLOR_END(p, RGB(200, 60, 20))
    PARTICLE_SET_FADE(p, TRUE)
    PARTICLE_EMIT(p, menge)
    ARRAY_PUSH(funken, p)
END SUB

' Bildschirmrand: was hinausfliegt, kommt gegenueber wieder herein.
FUNCTION umlauf(v AS FLOAT, grenze AS FLOAT, rand AS FLOAT) AS FLOAT
    IF v < -rand THEN RETURN v + grenze + 2 * rand
    IF v > grenze + rand THEN RETURN v - grenze - 2 * rand
    RETURN v
END FUNCTION

SUB getroffen(k AS Komet)
    k.lebt = FALSE
    spiele(klangKnall)
    explosion(k.x, k.y, k.r)
    punkte += IIF(k.r >= 40, 20, IIF(k.r >= 22, 50, 100))
    IF k.r > 12 THEN
        DIM neu AS INTEGER
        neu = IIF(k.r >= 40, 22, 12)
        ARRAY_PUSH(kometen, neuerKomet(k.x, k.y, neu))
        ARRAY_PUSH(kometen, neuerKomet(k.x, k.y, neu))
    END IF
END SUB

' --- Ein Bild des Spiels -----------------------------------------------------
SUB spielBild(dt AS FLOAT)
    ' Steuern
    DIM lenk AS FLOAT
    lenk = INPUT_AXIS("links", "rechts")
    IF ABS(INPUT_JOY_AXIS(0, "left_x")) > 0.2 THEN lenk = INPUT_JOY_AXIS(0, "left_x")
    swinkel += lenk * 240 * dt
    IF INPUT_HELD("schub") THEN
        svx += COS(RAD(swinkel)) * 300 * dt
        svy += SIN(RAD(swinkel)) * 300 * dt
    END IF
    svx = svx * (1 - 0.6 * dt)
    svy = svy * (1 - 0.6 * dt)
    sx = umlauf(sx + svx * dt, BREITE, 16)
    sy = umlauf(sy + svy * dt, HOEHE, 16)
    nachladen -= dt
    IF INPUT_HELD("feuer") AND nachladen <= 0 THEN
        DIM s AS Schuss
        s = NEW Schuss()
        s.x = sx + COS(RAD(swinkel)) * 16
        s.y = sy + SIN(RAD(swinkel)) * 16
        s.vx = COS(RAD(swinkel)) * 520 + svx
        s.vy = SIN(RAD(swinkel)) * 520 + svy
        s.rest = 0.9
        ARRAY_PUSH(schuesse, s)
        nachladen = 0.18
        spiele(klangSchuss)
    END IF

    ' Bewegen
    DIM k AS Komet
    FOR EACH k IN kometen
        k.x = umlauf(k.x + k.vx * dt, BREITE, k.r)
        k.y = umlauf(k.y + k.vy * dt, HOEHE, k.r)
        k.winkel += k.dreh * dt
    NEXT
    DIM s2 AS Schuss
    FOR EACH s2 IN schuesse
        s2.x = umlauf(s2.x + s2.vx * dt, BREITE, 2)
        s2.y = umlauf(s2.y + s2.vy * dt, HOEHE, 2)
        s2.rest -= dt
        FOR EACH k IN kometen
            IF k.lebt AND s2.rest > 0 AND (k.x - s2.x) ^ 2 + (k.y - s2.y) ^ 2 < k.r ^ 2 THEN
                getroffen(k)
                s2.rest = 0
            END IF
        NEXT
    NEXT

    ' Schiff gegen Komet
    schutz -= dt
    IF schutz <= 0 THEN
        FOR EACH k IN kometen
            IF k.lebt AND (k.x - sx) ^ 2 + (k.y - sy) ^ 2 < (k.r + 10) ^ 2 THEN
                leben -= 1
                schutz = 2
                CAMERA_SHAKE(8, 300)
                explosion(sx, sy, 40)
                spiele(klangKnall)
                getroffen(k)
                EXIT FOR
            END IF
        NEXT
    END IF

    ' Aufraeumen: was weg ist, faellt aus den Listen
    kometen = ARRAY_FILTER(kometen, FUNCTION(k) k.lebt)
    schuesse = ARRAY_FILTER(schuesse, FUNCTION(s) s.rest > 0)
    DIM p AS PARTICLE_SYSTEM
    FOR EACH p IN funken
        PARTICLE_UPDATE(p, INT(dt * 1000))
    NEXT
    funken = ARRAY_FILTER(funken, FUNCTION(p) PARTICLE_COUNT(p) > 0)

    IF LEN(kometen) = 0 THEN welleStarten()
    IF leben <= 0 THEN
        spiele(klangEnde)
        neuerPlatz = eintragen(punkte)
        SCENE_SWITCH("ende")
    END IF
END SUB

SUB spielZeichnen()
    DIM k AS Komet
    FOR EACH k IN kometen
        DIM b AS INTEGER
        b = IIF(k.r >= 40, bildGross, IIF(k.r >= 22, bildMittel, bildKlein))
        DRAWIMAGEROT(b, k.x, k.y, k.winkel)
    NEXT
    DIM s AS Schuss
    FOR EACH s IN schuesse
        CIRCLE(s.x, s.y, 2, RGB(255, 255, 180))
    NEXT
    DIM p AS PARTICLE_SYSTEM
    FOR EACH p IN funken
        PARTICLE_DRAW(p)
    NEXT
    ' blinkt, solange es geschuetzt ist
    IF schutz <= 0 OR INT(schutz * 8) MOD 2 = 0 THEN DRAWIMAGEROT(bildSchiff, sx, sy, swinkel)
    TEXT(12, 10, "Punkte " + STR$(punkte), WHITE)
    DIM l AS INTEGER
    FOR l = 1 TO leben
        DRAWIMAGEROT(bildSchiff, 4 + l * 22, 46, -90, 0.6)
    NEXT
    TEXT(BREITE - 120, 10, "Welle " + STR$(welle), WHITE)
    IF NOT tonAn THEN TEXT(BREITE - 120, 34, "Ton aus", RGB(160, 160, 160))
    IF pausiert THEN
        TEXT(BREITE / 2 - TEXT_WIDTH("PAUSE") / 2, HOEHE / 2 - 10, "PAUSE", YELLOW)
    END IF
END SUB

SUB mitteText(y AS INTEGER, t AS STRING, farbe AS INTEGER)
    TEXT(BREITE / 2 - TEXT_WIDTH(t) / 2, y, t, farbe)
END SUB

SUB bestenlisteZeichnen(y AS INTEGER)
    DIM i AS INTEGER
    FOR i = 1 TO PLAETZE
        DIM farbe AS INTEGER
        farbe = IIF(i = neuerPlatz, YELLOW, RGB(200, 200, 200))
        mitteText(y + i * 26, STR$(i) + ". " + STR$(platz(i)), farbe)
    NEXT
END SUB

' --- Hauptschleife ------------------------------------------------------------
SCENE_SWITCH("menue")
WHILE NOT QUITREQUESTED()
    INPUT_UPDATE()
    DIM dt AS FLOAT
    dt = MIN(DELTA(), 0.05)
    IF INPUT_PRESSED("ton") THEN tonAn = NOT tonAn
    IF INPUT_PRESSED("vollbild") THEN SET_FULLSCREEN(NOT WINDOW_IS_FULLSCREEN())

    CLS(RGB(8, 10, 24))
    SELECT CASE SCENE_CURRENT()
        CASE "menue"
            TEXT_SIZE(48)
            mitteText(110, "KOMETEN", WHITE)
            TEXT_SIZE(20)
            mitteText(190, "Leertaste oder Enter startet", RGB(180, 180, 180))
            mitteText(260, "Bestenliste", RGB(120, 200, 255))
            bestenlisteZeichnen(270)
            IF INPUT_PRESSED("weiter") THEN spielStarten()
        CASE "spiel"
            ' ohne Fokus haelt das Spiel an
            IF INPUT_PRESSED("pause") OR NOT WINDOW_FOCUSED() THEN pausiert = IIF(WINDOW_FOCUSED(), NOT pausiert, TRUE)
            IF NOT pausiert THEN spielBild(dt)
            spielZeichnen()
        CASE "ende"
            TEXT_SIZE(36)
            mitteText(120, "Spiel vorbei", WHITE)
            TEXT_SIZE(20)
            mitteText(180, STR$(punkte) + " Punkte", YELLOW)
            IF neuerPlatz > 0 THEN mitteText(210, "Platz " + STR$(neuerPlatz) + " in der Bestenliste!", RGB(120, 255, 160))
            bestenlisteZeichnen(240)
            mitteText(420, "Enter: noch einmal", RGB(180, 180, 180))
            IF INPUT_PRESSED("weiter") THEN spielStarten()
    END SELECT
    FLIP()
WEND
