--- datei pdftext.dh
' Text aus einem PDF lesen, das dhrt (krilla) geschrieben hat -- ohne PyMuPDF.
' Die Schriften sind eingebettete CID-Schriften: im Inhaltsstrom stehen
' Glyphennummern, die Zeichen verraet erst die ToUnicode-Tabelle der Schrift.
' Der Weg: Objekte finden, Stroeme entpacken, je Seite die Schriftnamen ueber
' die Ressourcen zur Tabelle aufloesen, dann die Zeichenketten der TJ/Tj-Befehle
' in Zeichen uebersetzen. pdfSeiten liefert je Seite eine Zeichenkette, jeder
' Textbefehl endet mit einem Zeilenumbruch.
DIM pdfDaten AS BUFFER
DIM pdfObjAb AS MAP OF INTEGER
DIM pdfObjBis AS MAP OF INTEGER
' Schriftname + ":" + Glyphennummer -> Zeichen (eine MAP laesst sich nicht verschachtelt abfragen)
DIM pdfZeichen AS MAP OF STRING

FUNCTION pdfBytes$(ab AS INTEGER, bis AS INTEGER) AS STRING
    DIM r AS STRING : r = ""
    DIM i AS INTEGER
    FOR i = ab TO bis - 1
        r = r + CHR$(BUFFER_GET(pdfDaten, i))
    NEXT
    RETURN r
END FUNCTION

' Kopf eines Objekts: alles bis "stream" oder "endobj".
FUNCTION pdfKopf$(nr AS INTEGER) AS STRING
    DIM ab AS INTEGER : ab = MAPGET(pdfObjAb, STR$(nr))
    DIM bis AS INTEGER : bis = MAPGET(pdfObjBis, STR$(nr))
    DIM s AS INTEGER : s = BUFFER_INDEXOF(pdfDaten, BUFFER_FROM_STRING("stream"), ab)
    IF s >= 0 AND s < bis THEN bis = s
    RETURN pdfBytes$(ab, bis)
END FUNCTION

FUNCTION pdfStrom(nr AS INTEGER) AS BUFFER
    DIM ab AS INTEGER : ab = MAPGET(pdfObjAb, STR$(nr))
    DIM s AS INTEGER : s = BUFFER_INDEXOF(pdfDaten, BUFFER_FROM_STRING("stream" + CHR$(10)), ab) + 7
    DIM e AS INTEGER : e = BUFFER_INDEXOF(pdfDaten, BUFFER_FROM_STRING(CHR$(10) + "endstream"), s)
    RETURN BUFFER_INFLATE(BUFFER_SLICE(pdfDaten, s, e))
END FUNCTION

' Die Zahl hinter einem Schluessel: "/Contents 10 0 R" -> 10
FUNCTION pdfRef(kopf AS STRING, schluessel AS STRING) AS INTEGER
    DIM p AS INTEGER : p = INSTR(kopf, schluessel)
    IF p < 0 THEN RETURN -1
    p = p + LEN(schluessel)
    WHILE MID$(kopf, p, 1) = " "
        p = p + 1
    WEND
    DIM z AS STRING : z = ""
    WHILE p < LEN(kopf) AND INSTR("0123456789", MID$(kopf, p, 1)) >= 0
        z = z + MID$(kopf, p, 1)
        p = p + 1
    WEND
    IF z = "" THEN RETURN -1
    RETURN VAL(z)
END FUNCTION

' Die fuehrende Zahl einer Zeichenkette: "3 0 R" -> 3 (VAL liest dort 0)
FUNCTION pdfZahl(s AS STRING) AS INTEGER
    DIM z AS STRING : z = ""
    DIM i AS INTEGER : i = 0
    WHILE i < LEN(s) AND MID$(s, i, 1) = " "
        i = i + 1
    WEND
    WHILE i < LEN(s) AND INSTR("0123456789", MID$(s, i, 1)) >= 0 AND MID$(s, i, 1) <> ""
        z = z + MID$(s, i, 1)
        i = i + 1
    WEND
    IF z = "" THEN RETURN -1
    RETURN VAL(z)
END FUNCTION

FUNCTION pdfHex(h AS STRING) AS INTEGER
    DIM n AS INTEGER : n = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(h) - 1
        n = n * 16 + INSTR("0123456789ABCDEF", UPPER$(MID$(h, i, 1)))
    NEXT
    RETURN n
END FUNCTION

' UTF-16BE als Hexziffern in Zeichen
FUNCTION pdfUtf16$(h AS STRING) AS STRING
    DIM r AS STRING : r = ""
    DIM i AS INTEGER : i = 0
    WHILE i + 4 <= LEN(h)
        DIM c AS INTEGER : c = pdfHex(MID$(h, i, 4))
        i = i + 4
        IF c >= 55296 AND c < 56320 AND i + 4 <= LEN(h) THEN
            DIM lo AS INTEGER : lo = pdfHex(MID$(h, i, 4))
            i = i + 4
            c = 65536 + (c - 55296) * 1024 + (lo - 56320)
        END IF
        r = r + CHR$(c)
    WEND
    RETURN r
END FUNCTION

' ToUnicode-Tabelle: Glyphennummer -> Zeichen (bfchar und bfrange)
SUB pdfTabelle(nr AS INTEGER, praefix AS STRING)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(BUFFER_TO_STRING$(pdfStrom(nr)), CHR$(10))
    DIM art AS STRING : art = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM z AS STRING : z = TRIM$(zeilen[i])
        IF RIGHT$(z, 11) = "beginbfchar" THEN
            art = "char"
        ELSEIF RIGHT$(z, 12) = "beginbfrange" THEN
            art = "range"
        ELSEIF LEFT$(z, 5) = "endbf" THEN
            art = ""
        ELSEIF art <> "" AND LEFT$(z, 1) = "<" THEN
            DIM teile AS ARRAY OF STRING : teile = SPLIT$(REPLACE$(REPLACE$(z, "<", ""), ">", " "), " ")
            DIM w AS ARRAY OF STRING : w = []
            DIM k AS INTEGER
            FOR k = 0 TO LEN(teile) - 1
                IF teile[k] <> "" THEN ARRAY_PUSH(w, teile[k])
            NEXT
            IF art = "char" AND LEN(w) >= 2 THEN
                MAPPUT(pdfZeichen, praefix + STR$(pdfHex(w[0])), pdfUtf16$(w[1]))
            ELSEIF art = "range" AND LEN(w) >= 3 THEN
                DIM g AS INTEGER
                DIM basis AS INTEGER : basis = pdfHex(w[2])
                FOR g = pdfHex(w[0]) TO pdfHex(w[1])
                    MAPPUT(pdfZeichen, praefix + STR$(g), CHR$(basis + g - pdfHex(w[0])))
                NEXT
            END IF
        END IF
    NEXT
END SUB

FUNCTION pdfSeiten(pfad AS STRING) AS ARRAY OF STRING
    pdfDaten = READALL_BYTES(pfad)
    pdfObjAb = {}
    pdfObjBis = {}
    ' Objekte: "N 0 obj" am Zeilenanfang
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_STRING(" 0 obj" + CHR$(10))
    DIM p AS INTEGER : p = BUFFER_INDEXOF(pdfDaten, nadel, 0)
    DIM nummern AS ARRAY OF INTEGER : nummern = []
    WHILE p >= 0
        DIM a AS INTEGER : a = p - 1
        WHILE a >= 0 AND BUFFER_GET(pdfDaten, a) >= 48 AND BUFFER_GET(pdfDaten, a) <= 57
            a = a - 1
        WEND
        DIM nr AS INTEGER : nr = pdfZahl(pdfBytes$(a + 1, p))
        MAPPUT(pdfObjAb, STR$(nr), p + 7)
        MAPPUT(pdfObjBis, STR$(nr), BUFFER_INDEXOF(pdfDaten, BUFFER_FROM_STRING("endobj"), p))
        ARRAY_PUSH(nummern, nr)
        p = BUFFER_INDEXOF(pdfDaten, nadel, p + 7)
    WEND
    ' Seiten in der Reihenfolge des Seitenbaums
    DIM seiten AS ARRAY OF STRING : seiten = []
    DIM i AS INTEGER
    DIM baum AS STRING : baum = ""
    FOR i = 0 TO LEN(nummern) - 1
        DIM kk AS STRING : kk = pdfKopf$(nummern[i])
        IF INSTR(kk, "/Type/Pages") >= 0 THEN baum = kk
    NEXT
    DIM kids AS STRING : kids = MID$(baum, INSTR(baum, "/Kids[") + 6, LEN(baum))
    kids = LEFT$(kids, INSTR(kids, "]"))
    DIM refs AS ARRAY OF STRING : refs = SPLIT$(REPLACE$(kids, " 0 R", "|"), "|")
    FOR i = 0 TO LEN(refs) - 1
        IF pdfZahl(refs[i]) < 0 THEN CONTINUE
        DIM seite AS STRING : seite = pdfKopf$(pdfZahl(refs[i]))
        DIM res AS STRING : res = pdfKopf$(pdfRef(seite, "/Resources"))
        DIM inhalt AS BUFFER : inhalt = pdfStrom(pdfRef(seite, "/Contents"))
        ' Schriftnamen der Seite -> Tabelle
        pdfZeichen = {}
        DIM tabellen AS MAP OF INTEGER
        tabellen = {}
        DIM fp AS INTEGER : fp = INSTR(res, "/Font<<")
        IF fp >= 0 THEN
            DIM fonts AS STRING : fonts = MID$(res, fp + 7, LEN(res))
            fonts = LEFT$(fonts, INSTR(fonts, ">>"))
            DIM stuecke AS ARRAY OF STRING : stuecke = SPLIT$(fonts, "/")
            DIM k AS INTEGER
            FOR k = 0 TO LEN(stuecke) - 1
                DIM st AS STRING : st = TRIM$(stuecke[k])
                IF st = "" THEN CONTINUE
                DIM leer AS INTEGER : leer = INSTR(st, " ")
                DIM fname AS STRING : fname = LEFT$(st, leer)
                DIM fobj AS STRING : fobj = pdfKopf$(pdfZahl(MID$(st, leer + 1, LEN(st))))
                MAPPUT(tabellen, fname, 1)
                pdfTabelle(pdfRef(fobj, "/ToUnicode"), fname + ":")
            NEXT
        END IF
        ' Inhalt lesen
        DIM text AS STRING : text = ""
        DIM akt AS STRING : akt = ""
        DIM n AS INTEGER : n = BUFFER_LEN(inhalt)
        DIM j AS INTEGER : j = 0
        DIM codes AS ARRAY OF INTEGER : codes = []
        WHILE j < n
            DIM b AS INTEGER : b = BUFFER_GET(inhalt, j)
            IF b = 47 THEN
                ' Name, vielleicht eine Schrift: /f0 11 Tf
                DIM nm AS STRING : nm = ""
                j = j + 1
                WHILE j < n AND BUFFER_GET(inhalt, j) > 32 AND BUFFER_GET(inhalt, j) <> 47 AND BUFFER_GET(inhalt, j) <> 40 AND BUFFER_GET(inhalt, j) <> 91
                    nm = nm + CHR$(BUFFER_GET(inhalt, j))
                    j = j + 1
                WEND
                IF MAPHAS(tabellen, nm) THEN akt = nm
            ELSEIF b = 40 THEN
                ' Zeichenkette mit Schutzzeichen
                j = j + 1
                DIM roh AS ARRAY OF INTEGER : roh = []
                WHILE j < n AND BUFFER_GET(inhalt, j) <> 41
                    DIM c AS INTEGER : c = BUFFER_GET(inhalt, j)
                    IF c = 92 THEN
                        j = j + 1
                        DIM e AS INTEGER : e = BUFFER_GET(inhalt, j)
                        IF e >= 48 AND e <= 55 THEN
                            DIM okt AS INTEGER : okt = 0
                            DIM stellen AS INTEGER : stellen = 0
                            WHILE stellen < 3 AND j < n AND BUFFER_GET(inhalt, j) >= 48 AND BUFFER_GET(inhalt, j) <= 55
                                okt = okt * 8 + BUFFER_GET(inhalt, j) - 48
                                j = j + 1
                                stellen = stellen + 1
                            WEND
                            j = j - 1
                            c = okt
                        ELSEIF e = 110 THEN
                            c = 10
                        ELSEIF e = 114 THEN
                            c = 13
                        ELSEIF e = 116 THEN
                            c = 9
                        ELSEIF e = 98 THEN
                            c = 8
                        ELSEIF e = 102 THEN
                            c = 12
                        ELSE
                            c = e
                        END IF
                    END IF
                    ARRAY_PUSH(roh, c)
                    j = j + 1
                WEND
                DIM q AS INTEGER : q = 0
                WHILE q + 1 < LEN(roh)
                    DIM gid AS STRING : gid = STR$(roh[q] * 256 + roh[q + 1])
                    IF MAPHAS(pdfZeichen, akt + ":" + gid) THEN text = text + MAPGET(pdfZeichen, akt + ":" + gid)
                    q = q + 2
                WEND
            ELSEIF b = 84 AND j + 1 < n THEN
                ' TJ oder Tj beendet einen Textbefehl
                DIM b2 AS INTEGER : b2 = BUFFER_GET(inhalt, j + 1)
                IF b2 = 74 OR b2 = 106 THEN text = text + CHR$(10)
            END IF
            j = j + 1
        WEND
        ARRAY_PUSH(seiten, text)
    NEXT
    RETURN seiten
END FUNCTION

--- nachher
IMPORT "pdftext.dh"
DIM seiten AS ARRAY OF STRING : seiten = pdfSeiten("_programm/rechnung_2026-0002.pdf")
DIM alles AS STRING : alles = ""
DIM k AS INTEGER
FOR k = 0 TO LEN(seiten) - 1
    alles = alles + seiten[k]
NEXT
' Jeder Textbefehl ist eine Zeile -- ein Wert muss eine GANZE Zeile sein.
DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(alles, CHR$(10))
DIM w AS ARRAY OF STRING
w = SPLIT$("Rechnung 2026-0002|Anna Berger|Fachbuch Drachenhauch|79,80 EUR|5,59 EUR|85,39 EUR|Drachenhauch Software|Zahlbar innerhalb von 14 Tagen", "|")
DIM i AS INTEGER
FOR i = 0 TO LEN(w) - 1
    DIM da AS BOOLEAN : da = FALSE
    FOR k = 0 TO LEN(zeilen) - 1
        IF INSTR(zeilen[k], w[i]) >= 0 THEN da = TRUE
    NEXT
    PRINT w[i] ; ": " ; da
NEXT
