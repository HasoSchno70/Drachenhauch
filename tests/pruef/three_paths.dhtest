=== foreach array
DIM a[4] AS INTEGER
a[0]=10 : a[1]=20 : a[2]=30 : a[3]=40
DIM s AS INTEGER
s = 0
FOR EACH v IN a
  s = s + v
NEXT
PRINT s
--- erwartet
100

=== foreach break continue
DIM a[4] AS INTEGER
a[0]=10 : a[1]=20 : a[2]=30 : a[3]=40
DIM c AS INTEGER
c = 0
FOR EACH v IN a
  IF v = 20 THEN CONTINUE
  IF v = 40 THEN BREAK
  c = c + 1
NEXT
PRINT c
--- erwartet
2

