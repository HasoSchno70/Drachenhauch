' Helfer fuer die Glutfaden-Sammlungen (glutfaden_bearbeiten, glutfaden_ansicht).
' Eingebunden NACH dem Kern (IMPORT ... AS kern).
' Ein 6x5-Muster mit drei Farben: Garn, Perle, Diamant.
FUNCTION neuesTestmuster() AS kern.Muster
    DIM m AS kern.Muster : m = kern.neuesMuster("t", 6, 5)
    DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
    DIM sym AS ARRAY OF STRING : sym = ["A", "B", "C", "D"]
    DIM i AS INTEGER
    i = kern.farbeHinzufuegen(m, v, kern.neuesGarn("Rot", &HFF0000, "DMC", "321"), sym, FALSE, FALSE)
    i = kern.farbeHinzufuegen(m, v, kern.neuesGarn("Gold", &HFFD700, "Mill Hill", "00557"), sym, TRUE, FALSE)
    i = kern.farbeHinzufuegen(m, v, kern.neuesGarn("Blau", &H0000FF, "DMC Diamond", "820"), sym, FALSE, TRUE)
    RETURN m
END FUNCTION

' Ebenen mit Name und Stichzahl, die aktive mit *, Stiche je Farbe und eine
' Pruefsumme ueber alle Zellen (Farbe, Typ, erledigt, Stelle).
FUNCTION zustand$(m AS kern.Muster) AS STRING
    DIM t AS STRING : t = "["
    DIM i AS INTEGER
    FOR i = 0 TO m.ebenen.anzahl() - 1
        DIM e AS kern.Ebene : e = m.ebenen.ebenen[i]
        IF i > 0 THEN t = t + " "
        IF i = m.ebenen.aktiv THEN t = t + "*"
        t = t + e.name + ":" + STR$(e.stichzahl())
    NEXT
    t = t + "] farben"
    DIM f AS kern.Farbeintrag
    FOR EACH f IN m.farben
        t = t + " " + f.symbol + "=" + STR$(f.stichzahl)
    NEXT
    DIM s AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO m.ebenen.anzahl() - 1
        DIM r AS kern.Ebene : r = m.ebenen.ebenen[i]
        FOR k = 0 TO LEN(r.raster) - 1
            IF r.raster[k] <> kern.KEIN_STICH THEN
                s = (s * 31 + (i + 1) * 1000003 + k * 101 + r.raster[k] * 7 + r.art[k] * 3 + r.erledigt[k]) MOD 1000000007
            END IF
        NEXT
    NEXT
    RETURN t + " summe " + STR$(s)
END FUNCTION

' Zellen als Vergleichszeile: Zahl, dann (x+1000)*10000 + (y+1000) sortiert.
SUB zeile(name AS STRING, p AS ARRAY OF INTEGER)
    DIM ks AS ARRAY OF INTEGER : ks = []
    DIM k AS INTEGER
    FOR k = 0 TO LEN(p) - 2 STEP 2
        ARRAY_PUSH(ks, (p[k] + 1000) * 10000 + (p[k + 1] + 1000))
    NEXT
    SORT(ks)
    DIM t AS STRING : t = name + " " + STR$(LEN(ks))
    DIM v AS INTEGER
    FOR EACH v IN ks
        t = t + " " + STR$(v)
    NEXT
    PRINT t
END SUB

' Das sichtbare Muster als Text: je Zelle Farbe und Stichtyp (hex), ".." leer.
FUNCTION bild$(m AS kern.Muster) AS STRING
    DIM t AS STRING
    DIM x AS INTEGER, y AS INTEGER
    FOR y = 0 TO m.hoehe - 1
        IF y > 0 THEN t = t + CHR$(10)
        FOR x = 0 TO m.breite - 1
            IF x > 0 THEN t = t + " "
            DIM e AS kern.Ebene : e = kern.ebeneMitStich(m, x, y)
            IF e IS NIL THEN
                t = t + ".."
            ELSE
                t = t + STR$(e.stich(x, y)) + HEX$(e.stichArt(x, y))
            END IF
        NEXT
    NEXT
    RETURN t
END FUNCTION

FUNCTION ausschnittGleich(a AS kern.Ausschnitt, b AS kern.Ausschnitt) AS BOOLEAN
    IF a.breite <> b.breite OR a.hoehe <> b.hoehe THEN RETURN FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(a.farbe) - 1
        IF a.dabei[i] <> b.dabei[i] OR a.farbe[i] <> b.farbe[i] OR a.art[i] <> b.art[i] THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION
