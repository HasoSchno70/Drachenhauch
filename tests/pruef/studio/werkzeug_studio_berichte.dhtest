--- datei proj/Hauptfenster.dh
CLASS Hauptfenster EXTENDS Hauptfenster_Basis
    SUB Geoeffnet()
        Liste.Pdf(PATHJOIN(GETENV$("DH_STUDIO_DATEN"), "liste.pdf"), {"ab": 2})
        PRINT "pdf gesichert"
        TRY
            Liste.Pdf(PATHJOIN(GETENV$("DH_STUDIO_DATEN"), "x.pdf"), {})
        CATCH fehler
            PRINT fehler
        END TRY
    END SUB
END CLASS
--- datei laeufer.dh
IMPORT "{sammlung}/_hilfen/studiolauf.dh"
IMPORT "{sammlung}/_hilfen/pdftext.dh"
slStudio = ARG$(0)
--- erwartet
ausgabe pdf gesichert
ausgabe Bericht: Parameter :ab fehlt
seiten 1 summe TRUE ohne r1 TRUE kunde TRUE
check []

=== der reiter zeigt den bericht, die vorschau blaettert
' Der Reiter des Berichts zeigt die Seite; [Vorschau …]
' setzt ihn mit den Entwicklungsdaten (Parameter ab = 1, zwei Seiten), [>]
' blaettert auf Seite 2, [Schliessen] macht zu.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
DIM log AS STRING : log = CWD$() + "/s.log"
SETENV("DH_STUDIO_OEFFNEN", "Liste")
slStarten(log, "", 10, p)
DIM x AS INTEGER
DIM y AS INTEGER
(x, y) = slLage(log, "bericht vorschau")
slHin(10, 10)
slWarten(14)
slKlick(x, y)
slWarten(14)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM wx AS INTEGER
DIM wy AS INTEGER
DIM zx AS INTEGER
DIM zy AS INTEGER
(wx, wy) = slLage(log, "bvweiter")
(zx, zy) = slLage(log, "bvzu")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(14)
slKlick(x, y)
slWarten(14)
slKlick(wx, wy)
slWarten(10)
slKlick(zx, zy)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slProtokoll(log)
    IF LEFT$(z, 8) = "bericht " OR LEFT$(z, 13) = "vorn bericht " OR INSTR(z, "knoten Liste") > 0 THEN
        IF INSTR(z, "lage ") <> 0 THEN PRINT z
    END IF
NEXT
--- argumente
{sammlung}/../../studio/studio.dh
--- vorher
IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT)")
DB_EXEC(db, "CREATE TABLE pos (id INTEGER PRIMARY KEY, rechnung INTEGER, kunde INTEGER, text TEXT, betrag INTEGER)")
DB_EXEC(db, "INSERT INTO kunden (name) VALUES ('Anna Berger'), ('Bert Koch')")
DIM i AS INTEGER
FOR i = 1 TO 70
    DB_EXEC(db, "INSERT INTO pos (rechnung, kunde, text, betrag) VALUES (?, ?, ?, ?)", 1 + i \ 40, 1 + i \ 40, "Artikel " + STR$(i), i * 125)
NEXT
DB_CLOSE(db)
