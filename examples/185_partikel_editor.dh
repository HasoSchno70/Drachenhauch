' ============================================================
'  DRACHENHAUCH -- Partikel-Editor
' ============================================================
'  Alle Parameter des `particles`-Moduls live einstellen, mit echter
'  Vorschau, und das Ergebnis als DH-Code mitnehmen. Das Gegenstueck
'  zum Qt-Werkzeug `dhparticles` -- hier in Drachenhauch selbst.
'
'  Die Vorschau ist KEINE Nachbildung: sie treibt ein echtes
'  PARTICLE_SYSTEM mit denselben Aufrufen, die auch im Spiel stehen.
'  Was du siehst, ist was du bekommst.
'
'  Datei -> Sichern schreibt alle Werte in eine `.ini`, Oeffnen holt sie
'  zurueck. Lesbares Format: die Datei laesst sich auch von Hand aendern.
'
'  Rueckgaengig/Wiederholen (Strg+Z, Strg+Y): EIN Zug am Regler ist EIN
'  Schritt -- nicht 60 pro Sekunde. [Zufall] wuerfelt einen neuen Effekt,
'  [Mutieren] veraendert den jetzigen nur ein wenig.
'
'  Bedienung:
'    Regler ziehen, Farbe im Farbwaehler waehlen, Vorlage links waehlen.
'    Alles auch ohne Maus: TAB wechselt, Leertaste loest aus,
'    Pfeile verstellen Regler.
'    [ESC] beendet (fragt nach, wenn etwas nicht gesichert ist).
' ============================================================
IMPORT "gui"
IMPORT "particles"
IMPORT "ini"

' --- Parameter: EINE Reihenfolge fuer Regler, Farben und Vorlagen ---
CONST P_VXMIN  = 0
CONST P_VXMAX  = 1
CONST P_VYMIN  = 2
CONST P_VYMAX  = 3
CONST P_GX     = 4
CONST P_GY     = 5
CONST P_LMIN   = 6
CONST P_LMAX   = 7
CONST P_RATE   = 8
CONST P_SMIN   = 9
CONST P_SMAX   = 10
' Die Farben sind keine Regler mehr, sondern zwei Farbwaehler -- als Zahlen
' gefuehrt bleiben sie trotzdem (Vorlagen, Verlauf und .ini kennen sie so).
CONST P_R1     = 11
CONST P_G1     = 12
CONST P_B1     = 13
CONST P_R2     = 14
CONST P_G2     = 15
CONST P_B2     = 16
CONST N_PARAM  = 17
CONST N_REGLER = 11

DIM regler[N_REGLER] AS GUI_WIDGET
DIM wertText[N_REGLER] AS GUI_WIDGET
DIM reglerLo[N_REGLER] AS FLOAT
DIM reglerHi[N_REGLER] AS FLOAT
DIM parName[N_PARAM] AS STRING         ' Schluessel in der gesicherten Datei
DIM letzter[N_REGLER] AS FLOAT

' Die Darstellungsarten: intern die Namen des Moduls, angezeigt deutsch.
DIM modi AS ARRAY OF STRING
modi = SPLIT$("circle|pixel|square|streak|glow", "|")
DIM modiText AS ARRAY OF STRING
modiText = SPLIT$("Kreis|Pixel|Quadrat|Strich|Leuchten", "|")

SCREEN(1500, 900, "Drachenhauch - Partikel-Editor", 1)
WINDOW_RESIZABLE(TRUE)
WINDOW_MIN_SIZE(1300, 820)
SETFPS(60)
GUI_THEME_PRESET("glas_dunkel")

' Die Oberflaeche schreibt in DejaVu Sans -- nicht in der Pixelschrift.
' GUI_FONT macht sie zur Schrift der gui, egal was danach gezeichnet wird.
DIM uiFont AS INTEGER : uiFont = LOADFONT("sans", 32)
SETFONT(uiFont, 15)
GUI_FONT(uiFont, 15)

DIM win AS GUI_WINDOW
win = GUI_WINDOW("Partikel-Editor", 0, 0, SCREENWIDTH(), SCREENHEIGHT())
GUI_WINDOW_CHROME(win, FALSE)
GUI_WINDOW_MOVABLE(win, FALSE)

' ============================================================
'  Menue
' ============================================================
DIM mDatei AS INTEGER : mDatei = GUI_MENU(win, "Datei")
DIM miLaden AS INTEGER : miLaden = GUI_MENU_ITEM(mDatei, "Einstellung öffnen …", "Strg+O")
DIM miSichern AS INTEGER : miSichern = GUI_MENU_ITEM(mDatei, "Einstellung sichern …", "Strg+S")
GUI_MENU_SEPARATOR(mDatei)
DIM miCode AS INTEGER : miCode = GUI_MENU_ITEM(mDatei, "DH-Code kopieren", "Strg+Umschalt+C")
GUI_MENU_SEPARATOR(mDatei)
DIM miEnde AS INTEGER : miEnde = GUI_MENU_ITEM(mDatei, "Beenden", "Strg+Q")

DIM mBearb AS INTEGER : mBearb = GUI_MENU(win, "Bearbeiten")
DIM miZurueck AS INTEGER : miZurueck = GUI_MENU_ITEM(mBearb, "Rückgängig", "Strg+Z")
DIM miVor AS INTEGER : miVor = GUI_MENU_ITEM(mBearb, "Wiederholen", "Strg+Y")
GUI_MENU_SEPARATOR(mBearb)
DIM miZufall AS INTEGER : miZufall = GUI_MENU_ITEM(mBearb, "Zufälliger Effekt", "Strg+R")
DIM miMutieren AS INTEGER : miMutieren = GUI_MENU_ITEM(mBearb, "Mutieren", "Strg+M")

DIM mVorschau AS INTEGER : mVorschau = GUI_MENU(win, "Vorschau")
DIM miPause AS INTEGER : miPause = GUI_MENU_ITEM(mVorschau, "Anhalten / weiter", "F5")
DIM miLeeren AS INTEGER : miLeeren = GUI_MENU_ITEM(mVorschau, "Leeren", "F6")
DIM miSalve AS INTEGER : miSalve = GUI_MENU_ITEM(mVorschau, "Salve (200 Teilchen)", "F7")

DIM CW AS INTEGER : CW = GUI_WINDOW_CONTENT_W(win)
DIM CH AS INTEGER : CH = GUI_WINDOW_CONTENT_H(win)

' ============================================================
'  Werkzeugleiste und Statusleiste
' ============================================================
DIM leiste AS GUI_WIDGET : leiste = GUI_TOOLBAR(win, 0, 0, CW, 42)
GUI_SET_ANCHOR(leiste, "lrt")
GUI_TOOLBAR_SET(leiste, "beschriftung", 1)
DIM tbLaden AS INTEGER : tbLaden = GUI_TOOLBAR_ADD(leiste, "oeffnen", "Einstellung öffnen (Strg+O)", "Öffnen")
DIM tbSichern AS INTEGER : tbSichern = GUI_TOOLBAR_ADD(leiste, "sichern", "Einstellung sichern (Strg+S)", "Sichern")
DIM tbCode AS INTEGER : tbCode = GUI_TOOLBAR_ADD(leiste, "kopieren", "Die Aufrufe in die Zwischenablage (Strg+Umschalt+C)", "DH-Code")
GUI_TOOLBAR_SEPARATOR(leiste)
DIM tbZurueck AS INTEGER : tbZurueck = GUI_TOOLBAR_ADD(leiste, "rueckgaengig", "Die letzte Änderung zurücknehmen (Strg+Z)", "Zurück")
DIM tbVor AS INTEGER : tbVor = GUI_TOOLBAR_ADD(leiste, "wiederholen", "Wiederherstellen (Strg+Y)", "Vor")
GUI_TOOLBAR_SEPARATOR(leiste)
DIM tbZufall AS INTEGER : tbZufall = GUI_TOOLBAR_ADD(leiste, "wuerfel", "Einen neuen Effekt würfeln (Strg+R)", "Zufall")
DIM tbMutieren AS INTEGER : tbMutieren = GUI_TOOLBAR_ADD(leiste, "aktualisieren", "Den jetzigen Effekt ein wenig verändern (Strg+M)", "Mutieren")
GUI_TOOLBAR_SEPARATOR(leiste)
DIM tbPause AS INTEGER : tbPause = GUI_TOOLBAR_ADD(leiste, "pause", "Vorschau anhalten / weiter (F5)", "Pause")
DIM tbLeeren AS INTEGER : tbLeeren = GUI_TOOLBAR_ADD(leiste, "schliessen", "Alle Teilchen entfernen (F6)", "Leeren")
DIM tbSalve AS INTEGER : tbSalve = GUI_TOOLBAR_ADD(leiste, "plus", "200 Teilchen auf einmal -- für Explosionen (F7)", "Salve")

DIM lblStatus AS GUI_WIDGET : lblStatus = GUI_STATUSBAR(win, 0, CH - 26, CW, 26, "Bereit.")
GUI_SET_ANCHOR(lblStatus, "lrb")
DIM sfZahl AS INTEGER : sfZahl = GUI_STATUSBAR_ADD(lblStatus, "", 160, "mitte")
DIM sfSchritt AS INTEGER : sfSchritt = GUI_STATUSBAR_ADD(lblStatus, "", 150, "mitte")

' ============================================================
'  Links: Vorlagen, Zufall, Hintergrund
' ============================================================
CONST LINKS_X = 14
CONST LINKS_B = 240
DIM lblPresets AS GUI_WIDGET
lblPresets = GUI_LABEL(win, "Vorlagen", LINKS_X, 54)
GUI_SET_FONT_STYLE(lblPresets, "fett")
DIM presetNamen AS ARRAY OF STRING
presetNamen = SPLIT$("Funken|Rauch|Feuer|Regen|Schnee|Explosion|Zauber|Springbrunnen|Blasen|Sterne|Staub|Glut", "|")
CONST N_PRESET = 12
DIM liste AS GUI_WIDGET
liste = GUI_LISTBOX(win, LINKS_X, 78, LINKS_B, 22 * N_PRESET + 6, presetNamen)
GUI_TOOLTIP(liste, "Ein Klick setzt alle Werte auf die Vorlage")

DIM ZY AS INTEGER : ZY = 78 + 22 * N_PRESET + 16
DIM knopfZufall AS GUI_WIDGET
knopfZufall = GUI_BUTTON(win, "Zufall", LINKS_X, ZY, 116, 32)
GUI_BUTTON_VARIANT(knopfZufall, "primaer")
GUI_TOOLTIP(knopfZufall, "Einen neuen Effekt würfeln (Strg+R)")
DIM knopfMutieren AS GUI_WIDGET
knopfMutieren = GUI_BUTTON(win, "Mutieren", LINKS_X + 124, ZY, 116, 32)
GUI_TOOLTIP(knopfMutieren, "Den jetzigen Effekt nur ein wenig verändern (Strg+M)")

DIM lblHg AS GUI_WIDGET
lblHg = GUI_LABEL(win, "Hintergrund", LINKS_X, ZY + 54)
GUI_SET_FONT_STYLE(lblHg, "fett")
DIM waehlHg AS GUI_WIDGET
waehlHg = GUI_DROPDOWN(win, LINKS_X, ZY + 78, LINKS_B, 28, SPLIT$("Nacht|Dämmerung|Hell|Schachbrett", "|"))
GUI_TOOLTIP(waehlHg, "Wie der Effekt vor verschiedenem Grund wirkt")
DIM folgtMaus AS GUI_WIDGET
folgtMaus = GUI_CHECKBOX(win, "Quelle folgt der Maus", LINKS_X, ZY + 118)
GUI_TOOLTIP(folgtMaus, "Die Teilchen entstehen dort, wo die Maus über der Vorschau steht")

' ============================================================
'  Rechts: die Regler in drei Gruppen
' ============================================================
CONST RECHTS_B = 380
DIM RX AS INTEGER : RX = CW - RECHTS_B - 14
DIM gBeweg AS GUI_WIDGET
gBeweg = GUI_GROUPBOX(win, RX, 54, RECHTS_B, 216, "Bewegung")
DIM gLeben AS GUI_WIDGET
gLeben = GUI_GROUPBOX(win, RX, 280, RECHTS_B, 126, "Lebenszeit (ms) und Ausstoß")
DIM gAussehen AS GUI_WIDGET
gAussehen = GUI_GROUPBOX(win, RX, 416, RECHTS_B, 158, "Aussehen")
GUI_SET_ANCHOR(gBeweg, "rt") : GUI_SET_ANCHOR(gLeben, "rt") : GUI_SET_ANCHOR(gAussehen, "rt")

DIM lblModus AS GUI_WIDGET
lblModus = GUI_LABEL(win, "Darstellung", RX + 12, 450)
DIM waehlModus AS GUI_WIDGET
waehlModus = GUI_DROPDOWN(win, RX + 158, 446, 200, 26, modiText)
DIM schalterFade AS GUI_WIDGET
schalterFade = GUI_CHECKBOX(win, "am Ende ausblenden", RX + 12, 542, TRUE)
GUI_SET_ANCHOR(lblModus, "rt") : GUI_SET_ANCHOR(waehlModus, "rt") : GUI_SET_ANCHOR(schalterFade, "rt")

' Der Verlauf ueber die Lebenszeit: so sieht ein Teilchen von der Geburt
' (links) bis zum Ende (rechts) aus -- Farbe, und mit Ausblenden die Deckkraft.
DIM gVerlauf AS GUI_WIDGET
gVerlauf = GUI_GROUPBOX(win, RX, 584, RECHTS_B, 92, "Ein Teilchen im Lauf seines Lebens")
DIM streifen AS GUI_WIDGET
streifen = GUI_CANVAS(win, RX + 12, 614, RECHTS_B - 24, 48)
GUI_SET_ANCHOR(gVerlauf, "rt") : GUI_SET_ANCHOR(streifen, "rt")

SUB machRegler(idx AS INTEGER, name AS STRING, schluessel AS STRING, x AS INTEGER, y AS INTEGER, _
               lo AS FLOAT, hi AS FLOAT, vorgabe AS FLOAT)
    DIM l AS GUI_WIDGET
    l = GUI_LABEL(win, name, x, y + 3)
    regler[idx] = GUI_SLIDER(win, x + 146, y, 140, lo, hi, vorgabe)
    wertText[idx] = GUI_LABEL(win, "", x + 296, y + 3)
    GUI_SET_ANCHOR(l, "rt") : GUI_SET_ANCHOR(regler[idx], "rt") : GUI_SET_ANCHOR(wertText[idx], "rt")
    reglerLo[idx] = lo
    reglerHi[idx] = hi
    parName[idx] = schluessel
    letzter[idx] = vorgabe
END SUB

' Der dritte Text ist der Schluessel in der .ini -- er bleibt, wie er war,
' damit alte Dateien weiter aufgehen.
machRegler(P_VXMIN, "Tempo X min", "Tempo X min", RX + 12, 84,  -400, 400, -60)
machRegler(P_VXMAX, "Tempo X max", "Tempo X max", RX + 12, 114, -400, 400,  60)
machRegler(P_VYMIN, "Tempo Y min", "Tempo Y min", RX + 12, 144, -400, 400, -140)
machRegler(P_VYMAX, "Tempo Y max", "Tempo Y max", RX + 12, 174, -400, 400, -40)
machRegler(P_GX,    "Kraft X", "Kraft X", RX + 12, 204, -600, 600, 0)
machRegler(P_GY,    "Kraft Y", "Kraft Y", RX + 12, 234, -600, 600, 220)

machRegler(P_LMIN,  "Leben min", "Leben min", RX + 12, 310, 50, 4000, 500)
machRegler(P_LMAX,  "Leben max", "Leben max", RX + 12, 340, 50, 4000, 1100)
machRegler(P_RATE,  "je Bild", "je Bild", RX + 12, 370, 0, 60, 6)

machRegler(P_SMIN,  "Größe min", "Groesse min", RX + 12, 480, 1, 40, 2)
machRegler(P_SMAX,  "Größe max", "Groesse max", RX + 12, 510, 1, 40, 5)

parName[P_R1] = "Rot Anfang" : parName[P_G1] = "Gruen Anfang" : parName[P_B1] = "Blau Anfang"
parName[P_R2] = "Rot Ende" : parName[P_G2] = "Gruen Ende" : parName[P_B2] = "Blau Ende"

' ============================================================
'  Mitte: die Vorschau, darunter die beiden Farbwaehler
' ============================================================
CONST MX = 270
DIM MW AS INTEGER : MW = RX - MX - 16
CONST FARB_H = 196
DIM FY AS INTEGER : FY = CH - 26 - 12 - FARB_H

DIM flaeche AS GUI_WIDGET
flaeche = GUI_CANVAS(win, MX, 54, MW, FY - 54 - 12)
GUI_SET_ANCHOR(flaeche, "lrtb")

DIM FB AS INTEGER : FB = (MW - 12) \ 2
DIM gFarbe1 AS GUI_WIDGET
gFarbe1 = GUI_GROUPBOX(win, MX, FY, FB, FARB_H, "Farbe am Anfang")
DIM wahl1 AS GUI_WIDGET
wahl1 = GUI_COLORPICKER(win, MX + 12, FY + 30, FB - 24, FARB_H - 42)
DIM gFarbe2 AS GUI_WIDGET
gFarbe2 = GUI_GROUPBOX(win, MX + FB + 12, FY, FB, FARB_H, "Farbe am Ende")
DIM schalterEnde AS GUI_WIDGET
schalterEnde = GUI_CHECKBOX(win, "Farbverlauf benutzen", MX + FB + 24, FY + 30)
DIM wahl2 AS GUI_WIDGET
wahl2 = GUI_COLORPICKER(win, MX + FB + 24, FY + 58, FB - 24, FARB_H - 70)
GUI_SET_ANCHOR(gFarbe1, "lb") : GUI_SET_ANCHOR(wahl1, "lb")
GUI_SET_ANCHOR(gFarbe2, "lb") : GUI_SET_ANCHOR(schalterEnde, "lb") : GUI_SET_ANCHOR(wahl2, "lb")

' ============================================================
'  Werte lesen und setzen -- Regler und Farbwaehler hinter EINER Nummer
' ============================================================
FUNCTION farbAnteil(farbe AS INTEGER, k AS INTEGER) AS FLOAT
    ' k: 0 = rot, 1 = gruen, 2 = blau
    RETURN FLT((farbe SHR (16 - 8 * k)) BAND 255)
END FUNCTION

FUNCTION p(idx AS INTEGER) AS FLOAT
    IF idx < N_REGLER THEN RETURN GUI_VALUE(regler[idx])
    IF idx < P_R2 THEN RETURN farbAnteil(GUI_PICKED_COLOR(wahl1), idx - P_R1)
    RETURN farbAnteil(GUI_PICKED_COLOR(wahl2), idx - P_R2)
END FUNCTION

SUB setzeP(idx AS INTEGER, v AS FLOAT)
    IF idx < N_REGLER THEN
        GUI_SET_VALUE(regler[idx], v)
        RETURN
    END IF
    DIM w AS GUI_WIDGET : w = IIF(idx < P_R2, wahl1, wahl2)
    DIM k AS INTEGER : k = IIF(idx < P_R2, idx - P_R1, idx - P_R2)
    DIM f AS INTEGER : f = GUI_PICKED_COLOR(w)
    DIM a AS INTEGER : a = CLAMP(INT(v + 0.5), 0, 255)
    DIM schieb AS INTEGER : schieb = 16 - 8 * k
    f = (f BAND (BNOT (255 SHL schieb))) BOR (a SHL schieb)
    GUI_SET_PICKED_COLOR(w, f)
END SUB

' ============================================================
'  Vorlagen
' ============================================================
DIM presetModus[N_PRESET] AS STRING
DIM presetWert[N_PRESET, N_PARAM] AS FLOAT
DIM presetFade[N_PRESET] AS INTEGER
DIM presetVerlauf[N_PRESET] AS INTEGER

' Der Reihe nach: vx min/max, vy min/max, gx, gy, leben min/max, rate,
' groesse min/max, Startfarbe r/g/b, Endfarbe r/g/b.
SUB setzePreset(i AS INTEGER, modus AS STRING, _
                vxa AS FLOAT, vxb AS FLOAT, vya AS FLOAT, vyb AS FLOAT, _
                gx AS FLOAT, gy AS FLOAT, la AS FLOAT, lb AS FLOAT, rate AS FLOAT, _
                sa AS FLOAT, sb AS FLOAT, _
                r1 AS FLOAT, g1 AS FLOAT, b1 AS FLOAT, _
                r2 AS FLOAT, g2 AS FLOAT, b2 AS FLOAT, _
                fade AS INTEGER, verlauf AS INTEGER)
    presetModus[i] = modus
    presetWert[i, P_VXMIN] = vxa : presetWert[i, P_VXMAX] = vxb
    presetWert[i, P_VYMIN] = vya : presetWert[i, P_VYMAX] = vyb
    presetWert[i, P_GX] = gx : presetWert[i, P_GY] = gy
    presetWert[i, P_LMIN] = la : presetWert[i, P_LMAX] = lb
    presetWert[i, P_RATE] = rate
    presetWert[i, P_SMIN] = sa : presetWert[i, P_SMAX] = sb
    presetWert[i, P_R1] = r1 : presetWert[i, P_G1] = g1 : presetWert[i, P_B1] = b1
    presetWert[i, P_R2] = r2 : presetWert[i, P_G2] = g2 : presetWert[i, P_B2] = b2
    presetFade[i] = fade
    presetVerlauf[i] = verlauf
END SUB

setzePreset(0, "circle", -90, 90, -200, -60,   0, 420,  300,  800,  8,  2,  4, 255, 220,  80, 255,  60,  20, 1, 1)
setzePreset(1, "circle", -25, 25,  -70, -25,   0, -20, 1400, 2600,  4,  8, 18, 110, 110, 120,  40,  40,  46, 1, 1)
setzePreset(2, "glow",   -40, 40, -180, -70,   0,-120,  500, 1000, 12,  4, 10, 255, 190,  60, 200,  40,  20, 1, 1)
setzePreset(3, "streak",  -8,  8,  260,  420,  0, 260,  700, 1100, 14,  1,  2, 140, 180, 230, 140, 180, 230, 0, 0)
setzePreset(4, "circle", -25, 25,   30,   80,  0,  20, 2600, 4000,  6,  2,  4, 240, 245, 255, 240, 245, 255, 0, 0)
setzePreset(5, "circle",-260, 260,-260, 260,   0, 200,  400,  900,  0,  2,  6, 255, 230, 140, 200,  30,  10, 1, 1)
setzePreset(6, "pixel",  -60, 60,  -60,  60,   0, -30,  700, 1500, 16,  1,  3, 180, 120, 255,  60, 200, 255, 1, 1)
setzePreset(7, "circle", -70, 70, -320, -240,  0, 420, 1000, 1600, 10,  2,  4, 120, 200, 255,  40,  90, 200, 1, 1)
' Blasen steigen langsam und werden durchsichtig.
setzePreset(8, "circle", -20, 20, -90,  -40,   0, -40, 1800, 3200,  3,  4, 12, 170, 220, 255, 120, 180, 230, 1, 1)
' Sterne: kaum Bewegung, kurzes Funkeln, Leuchten.
setzePreset(9, "glow",  -12, 12,  -12,   12,   0,   0,  300,  900,  5,  1,  3, 255, 255, 200, 140, 160, 255, 1, 1)
' Staub: braun, schwer, verweht nach rechts.
setzePreset(10, "square", 10, 80,  -40,  10,  60, 90,  900, 1800,  8,  1,  3, 160, 130,  90, 110,  90,  70, 1, 1)
' Glut: wenige grosse Teilchen, steigen auf, verloeschen dunkelrot.
setzePreset(11, "glow",  -30, 30, -110, -50,  0, -60,  900, 1700,  3,  5, 12, 255, 150,  40, 120,  20,  10, 1, 1)

SUB modusSetzen(name AS STRING)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(modi) - 1
        IF modi[k] = name THEN GUI_DROPDOWN_SET_SELECTED(waehlModus, k)
    NEXT
END SUB

SUB ladePreset(i AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        setzeP(k, presetWert[i, k])
    NEXT
    modusSetzen(presetModus[i])
    GUI_SET_CHECKED(schalterFade, presetFade[i] = 1)
    GUI_SET_CHECKED(schalterEnde, presetVerlauf[i] = 1)
END SUB

' ============================================================
'  Zufall und Mutieren
' ============================================================
FUNCTION zw(lo AS FLOAT, hi AS FLOAT) AS FLOAT
    RETURN lo + RND() * (hi - lo)
END FUNCTION

' Ein neuer Effekt, der nach etwas aussieht: die Zahlen werden nicht jede fuer
' sich gewuerfelt, sondern als Paare (min <= max) und mit einer Farbe, deren
' Ende zum Anfang passt -- ein voellig freier Wurf ergibt fast immer Brei.
SUB zufallEffekt()
    modusSetzen(modi[INT(RND() * LEN(modi))])
    DIM s AS FLOAT : s = zw(10, 260)
    DIM schief AS FLOAT : schief = zw(-1, 1) * s * 0.5
    setzeP(P_VXMIN, -s + schief) : setzeP(P_VXMAX, s + schief)
    DIM a AS FLOAT : a = zw(-380, 300)
    setzeP(P_VYMIN, a) : setzeP(P_VYMAX, a + zw(20, 240))
    setzeP(P_GX, IIF(RND() < 0.7, 0, zw(-120, 120)))
    setzeP(P_GY, zw(-200, 480))
    DIM l AS FLOAT : l = zw(250, 2200)
    setzeP(P_LMIN, l) : setzeP(P_LMAX, l + zw(150, 1600))
    setzeP(P_RATE, zw(2, 24))
    DIM g AS FLOAT : g = zw(1, 8)
    setzeP(P_SMIN, g) : setzeP(P_SMAX, g + zw(1, 10))
    DIM ton AS FLOAT : ton = zw(0, 360)
    GUI_SET_PICKED_COLOR(wahl1, HSV(ton, zw(0.3, 1), zw(0.75, 1)))
    GUI_SET_PICKED_COLOR(wahl2, HSV(ton + zw(-60, 60), zw(0.4, 1), zw(0.25, 0.8)))
    GUI_SET_CHECKED(schalterEnde, RND() < 0.8)
    GUI_SET_CHECKED(schalterFade, RND() < 0.85)
    GUI_SET_TEXT(lblStatus, "Neuer Effekt gewürfelt.")
END SUB

' Jeder Regler ein wenig, die Farben um wenige Stufen -- der Effekt bleibt
' erkennbar derselbe.
SUB mutiere()
    DIM k AS INTEGER
    FOR k = 0 TO N_REGLER - 1
        IF RND() < 0.7 THEN setzeP(k, p(k) + (RND() - 0.5) * 0.12 * (reglerHi[k] - reglerLo[k]))
    NEXT
    FOR k = P_R1 TO P_B2
        setzeP(k, p(k) + (RND() - 0.5) * 40)
    NEXT
    ' Ein Paar darf durch das Wackeln nicht verkehrt herum liegen.
    IF p(P_VXMIN) > p(P_VXMAX) THEN setzeP(P_VXMAX, p(P_VXMIN))
    IF p(P_VYMIN) > p(P_VYMAX) THEN setzeP(P_VYMAX, p(P_VYMIN))
    IF p(P_LMIN) > p(P_LMAX) THEN setzeP(P_LMAX, p(P_LMIN))
    IF p(P_SMIN) > p(P_SMAX) THEN setzeP(P_SMAX, p(P_SMIN))
    GUI_SET_TEXT(lblStatus, "Ein wenig verändert.")
END SUB

' ============================================================
'  Das Partikelsystem -- das ECHTE, kein Nachbau
' ============================================================
DIM sys AS PARTICLE_SYSTEM
sys = PARTICLE_SYSTEM_NEW(0, 0)

' ============================================================
'  Einstellungen sichern und laden
'
'  Format: eine schlichte `.ini` -- Schluessel ist der Name des Wertes. Das
'  macht die Datei lesbar und von Hand aenderbar, was bei einem Werkzeug fuer
'  Bastler mehr wert ist als ein kompaktes Format. Ein unbekannter Schluessel
'  wird UEBERGANGEN und nicht als Fehler gemeldet. (Bis 2026-10-29 hiessen die
'  sechs Farbanteile "Rot"/"Gruen"/"Blau", je zweimal -- die Endfarbe
'  ueberschrieb die Anfangsfarbe. Alte Dateien bringen darum nur die Endfarbe
'  mit, und so werden sie gelesen.)
' ============================================================
' Ganze Zahlen ohne ".0" -- die Datei soll man von Hand lesen koennen.
FUNCTION zahlText$(v AS FLOAT) AS STRING
    IF v = INT(v) THEN RETURN STR$(INT(v))
    RETURN STR$(v)
END FUNCTION

SUB einstellungSichern()
    DIM datei AS STRING
    datei = FILE_SAVE_DIALOG("Einstellung sichern", "partikel.ini", "ini")
    IF datei <> "" THEN
        DIM m AS MAP OF STRING
        MAPPUT(m, "modus", modi[GUI_DROPDOWN_SELECTED(waehlModus)])
        DIM k AS INTEGER
        FOR k = 0 TO N_PARAM - 1
            MAPPUT(m, parName[k], zahlText$(p(k)))
        NEXT
        MAPPUT(m, "ausblenden", IIF(GUI_CHECKED(schalterFade), "1", "0"))
        MAPPUT(m, "verlauf", IIF(GUI_CHECKED(schalterEnde), "1", "0"))
        TRY
            INI_SAVE(datei, m)
            standLesen(U_GESICHERT)
            GUI_SET_TEXT(lblStatus, "Gesichert: " + datei)
        CATCH e
            GUI_SET_TEXT(lblStatus, e)
        END TRY
    END IF
END SUB

SUB einstellungLaden()
    DIM datei AS STRING
    datei = FILE_OPEN_DIALOG("Einstellung laden", "ini")
    IF datei <> "" THEN
        TRY
            DIM m AS MAP OF STRING
            m = INI_LOAD(datei)
            DIM k AS INTEGER
            DIM gefunden AS INTEGER : gefunden = 0
            FOR k = 0 TO N_PARAM - 1
                IF MAPHAS(m, parName[k]) THEN
                    ' GUI_SET_VALUE klemmt auf den Reglerbereich -- eine von
                    ' Hand verstellte Datei kann also nichts Unmoegliches
                    ' erzwingen.
                    setzeP(k, VAL(MAPGET(m, parName[k])))
                    gefunden = gefunden + 1
                END IF
            NEXT
            ' Die alten Schluessel (siehe oben): sie trugen die Endfarbe.
            DIM altName AS ARRAY OF STRING : altName = SPLIT$("Rot|Gruen|Blau", "|")
            FOR k = 0 TO 2
                IF MAPHAS(m, altName[k]) THEN
                    setzeP(P_R2 + k, VAL(MAPGET(m, altName[k])))
                    gefunden = gefunden + 1
                END IF
            NEXT
            IF MAPHAS(m, "modus") THEN modusSetzen(MAPGET(m, "modus"))
            IF MAPHAS(m, "ausblenden") THEN GUI_SET_CHECKED(schalterFade, MAPGET(m, "ausblenden") = "1")
            IF MAPHAS(m, "verlauf") THEN GUI_SET_CHECKED(schalterEnde, MAPGET(m, "verlauf") = "1")
            ' Die Werte wandern von selbst in den Emitter: die Schleife
            ' vergleicht jeden Wert mit dem zuletzt gesehenen -- ein gesetzter
            ' Wert sieht fuer sie aus wie eine Bewegung von Hand.
            standLesen(U_GESICHERT)
            IF gefunden = 0 THEN
                GUI_SET_TEXT(lblStatus, "Keine bekannten Werte in " + datei)
            ELSE
                GUI_SET_TEXT(lblStatus, STR$(gefunden) + " Werte geladen: " + datei)
            END IF
        CATCH e
            GUI_SET_TEXT(lblStatus, e)
        END TRY
    END IF
END SUB

FUNCTION farbe1() AS INTEGER
    RETURN GUI_PICKED_COLOR(wahl1)
END FUNCTION

FUNCTION farbe2() AS INTEGER
    RETURN GUI_PICKED_COLOR(wahl2)
END FUNCTION

' Alle Werte ins System uebertragen. Wird nur bei Aenderung gerufen.
SUB uebertrage()
    PARTICLE_SET_VELOCITY(sys, p(P_VXMIN), p(P_VXMAX), p(P_VYMIN), p(P_VYMAX))
    PARTICLE_SET_GRAVITY(sys, p(P_GX), p(P_GY))
    PARTICLE_SET_LIFETIME(sys, INT(p(P_LMIN)), INT(p(P_LMAX)))
    PARTICLE_SET_SIZE(sys, INT(p(P_SMIN)), INT(p(P_SMAX)))
    PARTICLE_SET_COLOR(sys, farbe1())
    PARTICLE_SET_MODE(sys, modi[GUI_DROPDOWN_SELECTED(waehlModus)])
    PARTICLE_SET_FADE(sys, GUI_CHECKED(schalterFade))
    ' Kein Verlauf = Endfarbe gleich Startfarbe. Das Modul kennt kein "aus",
    ' und eine zweite Wahrheit dafuer waere eine Stelle zu viel.
    IF GUI_CHECKED(schalterEnde) THEN
        PARTICLE_SET_COLOR_END(sys, farbe2())
    ELSE
        PARTICLE_SET_COLOR_END(sys, farbe1())
    END IF
END SUB

' Der Aufruf-Block, der dieses System im eigenen Programm erzeugt.
FUNCTION dhCode$() AS STRING
    DIM nl AS STRING
    nl = CHR$(10)
    DIM z AS STRING
    z = "DIM sys AS PARTICLE_SYSTEM" + nl
    z = z + "sys = PARTICLE_SYSTEM_NEW(x, y)" + nl
    z = z + "PARTICLE_SET_VELOCITY(sys, " + FORMAT$(p(P_VXMIN), "%.0f") + ", " + _
        FORMAT$(p(P_VXMAX), "%.0f") + ", " + FORMAT$(p(P_VYMIN), "%.0f") + ", " + _
        FORMAT$(p(P_VYMAX), "%.0f") + ")" + nl
    z = z + "PARTICLE_SET_GRAVITY(sys, " + FORMAT$(p(P_GX), "%.0f") + ", " + _
        FORMAT$(p(P_GY), "%.0f") + ")" + nl
    z = z + "PARTICLE_SET_LIFETIME(sys, " + FORMAT$(p(P_LMIN), "%.0f") + ", " + _
        FORMAT$(p(P_LMAX), "%.0f") + ")" + nl
    z = z + "PARTICLE_SET_SIZE(sys, " + FORMAT$(p(P_SMIN), "%.0f") + ", " + _
        FORMAT$(p(P_SMAX), "%.0f") + ")" + nl
    z = z + "PARTICLE_SET_COLOR(sys, RGB(" + FORMAT$(p(P_R1), "%.0f") + ", " + _
        FORMAT$(p(P_G1), "%.0f") + ", " + FORMAT$(p(P_B1), "%.0f") + "))" + nl
    IF GUI_CHECKED(schalterEnde) THEN
        z = z + "PARTICLE_SET_COLOR_END(sys, RGB(" + FORMAT$(p(P_R2), "%.0f") + ", " + _
            FORMAT$(p(P_G2), "%.0f") + ", " + FORMAT$(p(P_B2), "%.0f") + "))" + nl
    END IF
    z = z + "PARTICLE_SET_MODE(sys, " + CHR$(34) + modi[GUI_DROPDOWN_SELECTED(waehlModus)] + CHR$(34) + ")" + nl
    z = z + "PARTICLE_SET_FADE(sys, " + IIF(GUI_CHECKED(schalterFade), "TRUE", "FALSE") + ")" + nl
    z = z + nl + "' pro Bild:" + nl
    z = z + "PARTICLE_EMIT(sys, " + FORMAT$(p(P_RATE), "%.0f") + ")" + nl
    z = z + "PARTICLE_UPDATE(sys, 16)" + nl
    z = z + "PARTICLE_DRAW(sys)"
    RETURN z
END FUNCTION

' ============================================================
'  Rueckgaengig / Wiederholen
'
'  Der ganze Zustand dieses Werkzeugs sind 11 Reglerwerte, zwei Farben (als
'  sechs Anteile), die Darstellungsart und zwei Schalter -- also 20 Zahlen.
'  Ein Schritt ist deshalb der VOLLE Stand, nicht eine Beschreibung dessen,
'  was sich geaendert hat: das ist hier kuerzer als jede Buchfuehrung
'  darueber, und es kann nichts auseinanderlaufen.
'
'  **Wann ist ein Schritt fertig?** Das ist bei einem Regler-Editor die
'  eigentliche Frage: ein gezogener Regler (und ein gezogener Farbpunkt)
'  aendert sich in JEDEM Bild. Gesichert wird deshalb erst, wenn sich ein
'  Bild lang NICHTS geaendert hat und keine Maustaste mehr haengt: ein Zug
'  ist ein Schritt. Vorlage waehlen, Zufall, Mutieren und eine .ini laden
'  sind auf demselben Weg genau ein Schritt.
' ============================================================
CONST U_MAX = 32
CONST U_FELDER = N_PARAM + 3           ' Werte + Darstellung + zwei Schalter
' Ein Platz mehr als der Verlauf braucht: dort liegt der Stand beim letzten
' Sichern oder Laden -- ungesichert ist, was davon abweicht.
DIM uStand[U_MAX + 1, U_FELDER] AS FLOAT
CONST U_GESICHERT = U_MAX
DIM uAnz AS INTEGER : uAnz = 0         ' wie viele Staende aufgezeichnet sind
DIM uPos AS INTEGER : uPos = 0         ' auf welchem wir gerade stehen
DIM uOffen AS BOOLEAN : uOffen = FALSE ' eine Aenderung wartet auf ihr Ende

SUB standLesen(ziel AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        uStand[ziel, k] = p(k)
    NEXT
    uStand[ziel, N_PARAM] = GUI_DROPDOWN_SELECTED(waehlModus)
    uStand[ziel, N_PARAM + 1] = IIF(GUI_CHECKED(schalterFade), 1, 0)
    uStand[ziel, N_PARAM + 2] = IIF(GUI_CHECKED(schalterEnde), 1, 0)
END SUB

' Die Erkennung im Hauptteil vergleicht jeden Wert mit dem zuletzt
' gesehenen. Nach einem Rueckgaengig muss sie den neuen Stand als BEKANNT
' ansehen -- sonst zeichnet sie ihn als frische Aenderung auf und der Vor-Weg
' waere weg.
SUB letzteAuffrischen()
    DIM k AS INTEGER
    FOR k = 0 TO N_REGLER - 1
        letzter[k] = GUI_VALUE(regler[k])
    NEXT
    letzteFarbe1 = farbe1()
    letzteFarbe2 = farbe2()
    letzterModus = GUI_DROPDOWN_SELECTED(waehlModus)
    letztesFade = GUI_CHECKED(schalterFade)
    letzterVerlauf = GUI_CHECKED(schalterEnde)
END SUB

SUB standAnwenden(quelle AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        setzeP(k, uStand[quelle, k])
    NEXT
    GUI_DROPDOWN_SET_SELECTED(waehlModus, INT(uStand[quelle, N_PARAM]))
    GUI_SET_CHECKED(schalterFade, uStand[quelle, N_PARAM + 1] = 1)
    GUI_SET_CHECKED(schalterEnde, uStand[quelle, N_PARAM + 2] = 1)
    letzteAuffrischen()
    uebertrage()
    uOffen = FALSE
END SUB

FUNCTION standGleich(i AS INTEGER) AS BOOLEAN
    ' Ist der aufgezeichnete Stand `i` derselbe wie der jetzige?
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        IF uStand[i, k] <> p(k) THEN RETURN FALSE
    NEXT
    IF uStand[i, N_PARAM] <> GUI_DROPDOWN_SELECTED(waehlModus) THEN RETURN FALSE
    IF (uStand[i, N_PARAM + 1] = 1) <> GUI_CHECKED(schalterFade) THEN RETURN FALSE
    IF (uStand[i, N_PARAM + 2] = 1) <> GUI_CHECKED(schalterEnde) THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

SUB schrittSichern()
    ' Ein Stand, der sich nicht unterscheidet, ist kein Schritt -- sonst
    ' braeuchte man zweimal Rueckgaengig fuer eine Aenderung, und der
    ' Vor-Weg waere schon weg. (Die Pruefung muss VOR dem Abschneiden
    ' stehen, sonst kostet ein Nichts-Schritt den Vor-Weg.)
    IF uAnz > 0 AND standGleich(uPos) THEN RETURN
    ' Der neue Stand kommt HINTER den aktuellen -- beim allerersten gibt es
    ' keinen, der Platz ist also 0.
    DIM ziel AS INTEGER
    ziel = IIF(uAnz = 0, 0, uPos + 1)
    IF ziel >= U_MAX THEN
        ' Voll: der aelteste faellt weg, alles rueckt auf.
        DIM i AS INTEGER
        DIM k AS INTEGER
        FOR i = 0 TO U_MAX - 2
            FOR k = 0 TO U_FELDER - 1
                uStand[i, k] = uStand[i + 1, k]
            NEXT
        NEXT
        ziel = U_MAX - 1
    END IF
    standLesen(ziel)
    uPos = ziel
    ' Alles dahinter faellt weg -- ab hier geht die Geschichte anders weiter.
    uAnz = ziel + 1
END SUB

SUB zurueck()
    IF uPos > 0 THEN
        uPos = uPos - 1
        standAnwenden(uPos)
        GUI_SET_TEXT(lblStatus, "Zurückgenommen.")
    END IF
END SUB

SUB wieder()
    IF uPos < uAnz - 1 THEN
        uPos = uPos + 1
        standAnwenden(uPos)
        GUI_SET_TEXT(lblStatus, "Wiederhergestellt.")
    END IF
END SUB

' ============================================================
'  Die Vorschau zeichnen: Grund, Teilchen, Rahmen
' ============================================================
SUB grundZeichnen(cx AS INTEGER, cy AS INTEGER, cw AS INTEGER, ch AS INTEGER)
    DIM art AS INTEGER : art = GUI_DROPDOWN_SELECTED(waehlHg)
    IF art = 1 THEN
        GRADIENTV(cx, cy, cx + cw - 1, cy + ch - 1, &H1B2A4A, &H7A4256)
    ELSEIF art = 2 THEN
        BOX(cx, cy, cx + cw - 1, cy + ch - 1, &HE6EAF0)
    ELSEIF art = 3 THEN
        BOX(cx, cy, cx + cw - 1, cy + ch - 1, &H2A2F3A)
        DIM x AS INTEGER
        DIM y AS INTEGER
        FOR y = 0 TO (ch - 1) \ 24
            FOR x = 0 TO (cw - 1) \ 24
                IF (x + y) MOD 2 = 0 THEN BOX(cx + x * 24, cy + y * 24, MIN(cx + x * 24 + 23, cx + cw - 1), MIN(cy + y * 24 + 23, cy + ch - 1), &H3A414F)
            NEXT
        NEXT
    ELSE
        BOX(cx, cy, cx + cw - 1, cy + ch - 1, &H0E1620)
    END IF
END SUB

' ============================================================
'  Der Streifen: Farbe und Deckkraft ueber die Lebenszeit
' ============================================================
SUB streifenZeichnen()
    DIM sx AS INTEGER : sx = GUI_CANVAS_X(streifen)
    DIM sy AS INTEGER : sy = GUI_CANVAS_Y(streifen)
    DIM sb AS INTEGER : sb = GUI_CANVAS_W(streifen)
    DIM sh AS INTEGER : sh = GUI_CANVAS_H(streifen)
    ' Schachbrett darunter -- sonst sieht man dem Ausblenden nicht an, wo es
    ' durchsichtig wird.
    DIM i AS INTEGER
    FOR i = 0 TO (sb - 1) \ 8
        BOX(sx + i * 8, sy, MIN(sx + i * 8 + 7, sx + sb - 1), sy + sh \ 2 - 1, IIF(i MOD 2 = 0, &H3A414F, &H23282F))
        BOX(sx + i * 8, sy + sh \ 2, MIN(sx + i * 8 + 7, sx + sb - 1), sy + sh - 1, IIF(i MOD 2 = 0, &H23282F, &H3A414F))
    NEXT
    DIM f2 AS INTEGER : f2 = IIF(GUI_CHECKED(schalterEnde), farbe2(), farbe1())
    DIM t AS FLOAT
    DIM r AS INTEGER
    DIM g AS INTEGER
    DIM b AS INTEGER
    DIM a AS INTEGER
    FOR i = 0 TO sb - 1
        t = i / MAX(1, sb - 1)
        r = INT(farbAnteil(farbe1(), 0) * (1 - t) + farbAnteil(f2, 0) * t)
        g = INT(farbAnteil(farbe1(), 1) * (1 - t) + farbAnteil(f2, 1) * t)
        b = INT(farbAnteil(farbe1(), 2) * (1 - t) + farbAnteil(f2, 2) * t)
        a = IIF(GUI_CHECKED(schalterFade), MAX(1, INT(255 * (1 - t))), 255)
        LINE(sx + i, sy, sx + i, sy + sh - 1, RGBA(r, g, b, a))
    NEXT
    RECT(sx, sy, sx + sb - 1, sy + sh - 1, &H2E3C50)
END SUB

' ============================================================
'  Start
' ============================================================
GUI_LISTBOX_SET_SELECTED(liste, 0)
ladePreset(0)
uebertrage()

DIM letzteWahl AS INTEGER : letzteWahl = 0
DIM letzterModus AS INTEGER : letzterModus = 0
DIM letztesFade AS BOOLEAN : letztesFade = GUI_CHECKED(schalterFade)
DIM letzterVerlauf AS BOOLEAN : letzterVerlauf = GUI_CHECKED(schalterEnde)
DIM letzteFarbe1 AS INTEGER : letzteFarbe1 = farbe1()
DIM letzteFarbe2 AS INTEGER : letzteFarbe2 = farbe2()
DIM pausiert AS INTEGER : pausiert = 0

' Der Anfangsstand ist Schritt 0 -- ohne ihn haette das erste Rueckgaengig
' nichts, wohin es zurueckkoennte. `letzteAuffrischen` gehoert dazu: sonst
' sieht die Erkennung im ersten Bild die Vorlage als frische Aenderung und
' legt einen zweiten, gleichen Stand an.
letzteAuffrischen()
schrittSichern()
standLesen(U_GESICHERT)

DIM frage AS GUI_WINDOW : frage = -1
DIM beenden AS BOOLEAN : beenden = FALSE

FUNCTION ungesichert() AS BOOLEAN
    RETURN NOT standGleich(U_GESICHERT)
END FUNCTION

' ESC beendete den Editor bis 2026-09-19 sofort, das Kreuz ebenso -- auch mit
' ungesicherten Werten. Jetzt fragen beide nach, aber nur dann.
SUB endeAnfragen()
    IF ungesichert() THEN
        frage = GUI_DIALOG("Beenden", "Die Einstellung ist nicht gesichert.", "Sichern|Verwerfen|Abbrechen")
    ELSE
        beenden = TRUE
    END IF
END SUB

SUB pauseUmschalten()
    pausiert = 1 - pausiert
    GUI_TOOLBAR_SET_ICON(leiste, tbPause, IIF(pausiert = 1, "start", "pause"))
    GUI_TOOLBAR_SET_TEXT(leiste, tbPause, IIF(pausiert = 1, "Weiter", "Pause"))
END SUB

DIM warB AS INTEGER : warB = SCREENWIDTH()
DIM warH AS INTEGER : warH = SCREENHEIGHT()

WHILE NOT beenden
    ' Das Kreuz (und Alt+F4) fragt nach, wenn etwas nicht gesichert ist.
    ' QUITREQUESTED ohne das Kreuz ist das Bildlimit eines Testlaufs -- dort
    ' endet das Programm hart wie bisher.
    IF WINDOW_CLOSE_REQUESTED() THEN
        IF frage < 0 THEN endeAnfragen()
    ELSEIF QUITREQUESTED() THEN
        BREAK
    END IF
    ' Das Fenster wurde groesser oder kleiner: die gui folgt, die Anker
    ' verteilen den Platz (die Vorschau waechst, der Rest rueckt mit).
    IF SCREENWIDTH() <> warB OR SCREENHEIGHT() <> warH THEN
        warB = SCREENWIDTH() : warH = SCREENHEIGHT()
        GUI_WINDOW_SET_BOUNDS(win, 0, 0, warB, warH)
    END IF
    CLS(&H0B1119)
    GUI_UPDATE()
    ' ESC erst NACH GUI_UPDATE: davor oeffnete dieselbe Taste den Kasten, und
    ' das GUI_UPDATE desselben Bildes nahm sie gleich als "Abbrechen".
    IF KEYHIT(KEY_ESCAPE) AND frage < 0 THEN endeAnfragen()

    IF GUI_LISTBOX_SELECTED(liste) <> letzteWahl AND GUI_LISTBOX_SELECTED(liste) >= 0 THEN
        letzteWahl = GUI_LISTBOX_SELECTED(liste)
        ladePreset(letzteWahl)
        PARTICLE_CLEAR(sys)
        GUI_SET_TEXT(lblStatus, "Vorlage: " + presetNamen[letzteWahl])
        ' Eine Vorlage laesst sich jederzeit wieder waehlen.
        standLesen(U_GESICHERT)
    END IF

    ' --- Befehle ---
    DIM tb AS INTEGER : tb = GUI_TOOLBAR_CLICKED(leiste)
    IF GUI_CLICKED(miZurueck) OR tb = tbZurueck THEN zurueck()
    IF GUI_CLICKED(miVor) OR tb = tbVor THEN wieder()
    IF GUI_CLICKED(knopfZufall) OR GUI_CLICKED(miZufall) OR tb = tbZufall THEN zufallEffekt()
    IF GUI_CLICKED(knopfMutieren) OR GUI_CLICKED(miMutieren) OR tb = tbMutieren THEN mutiere()
    IF GUI_CLICKED(miPause) OR tb = tbPause THEN pauseUmschalten()
    IF GUI_CLICKED(miLeeren) OR tb = tbLeeren THEN PARTICLE_CLEAR(sys)
    IF GUI_CLICKED(miSichern) OR tb = tbSichern THEN einstellungSichern()
    IF GUI_CLICKED(miLaden) OR tb = tbLaden THEN einstellungLaden()
    IF GUI_CLICKED(miEnde) AND frage < 0 THEN endeAnfragen()
    IF GUI_CLICKED(miCode) OR tb = tbCode THEN
        CLIPBOARD_SET(dhCode$())
        GUI_SET_TEXT(lblStatus, "Aufrufe in der Zwischenablage.")
    END IF

    ' --- Aenderungen erkennen ---
    DIM geaendert AS INTEGER
    geaendert = 0
    DIM k AS INTEGER
    FOR k = 0 TO N_REGLER - 1
        IF GUI_VALUE(regler[k]) <> letzter[k] THEN
            letzter[k] = GUI_VALUE(regler[k])
            geaendert = 1
        END IF
    NEXT
    IF farbe1() <> letzteFarbe1 OR farbe2() <> letzteFarbe2 THEN
        letzteFarbe1 = farbe1()
        letzteFarbe2 = farbe2()
        geaendert = 1
    END IF
    IF GUI_DROPDOWN_SELECTED(waehlModus) <> letzterModus THEN
        letzterModus = GUI_DROPDOWN_SELECTED(waehlModus)
        geaendert = 1
    END IF
    IF GUI_CHECKED(schalterFade) <> letztesFade THEN
        letztesFade = GUI_CHECKED(schalterFade)
        geaendert = 1
    END IF
    IF GUI_CHECKED(schalterEnde) <> letzterVerlauf THEN
        letzterVerlauf = GUI_CHECKED(schalterEnde)
        geaendert = 1
    END IF
    IF geaendert = 1 THEN
        uebertrage()
        uOffen = TRUE
    ELSEIF uOffen AND NOT MOUSEBUTTON(0) THEN
        ' Der Zug ist zu Ende: EIN Schritt fuer die ganze Bewegung. Solange
        ' die Taste haengt, laeuft sie noch -- ein Regler steht zwischendurch
        ' oft ein Bild lang still.
        uOffen = FALSE
        schrittSichern()
    END IF
    GUI_MENU_ENABLE(miZurueck, uPos > 0)
    GUI_MENU_ENABLE(miVor, uPos < uAnz - 1)
    GUI_TOOLBAR_ENABLE(leiste, tbZurueck, uPos > 0)
    GUI_TOOLBAR_ENABLE(leiste, tbVor, uPos < uAnz - 1)
    GUI_SET_ENABLED(wahl2, GUI_CHECKED(schalterEnde))

    ' --- Vorschau ---
    DIM vx AS INTEGER : vx = GUI_CANVAS_X(flaeche)
    DIM vy AS INTEGER : vy = GUI_CANVAS_Y(flaeche)
    DIM vb AS INTEGER : vb = GUI_CANVAS_W(flaeche)
    DIM vh AS INTEGER : vh = GUI_CANVAS_H(flaeche)

    ' Quelle: Mitte der Flaeche, oder unter der Maus wenn gewuenscht.
    DIM qx AS INTEGER : qx = vx + vb \ 2
    DIM qy AS INTEGER : qy = vy + vh \ 2
    IF GUI_CHECKED(folgtMaus) THEN
        IF MOUSEX() >= vx AND MOUSEX() < vx + vb AND MOUSEY() >= vy AND MOUSEY() < vy + vh THEN
            qx = MOUSEX()
            qy = MOUSEY()
        END IF
    END IF
    PARTICLE_SET_POS(sys, qx, qy)

    IF pausiert = 0 THEN
        IF GUI_CLICKED(miSalve) OR tb = tbSalve THEN PARTICLE_EMIT(sys, 200)
        PARTICLE_EMIT(sys, INT(p(P_RATE)))
        PARTICLE_UPDATE(sys, 16)
    END IF

    GUI_DRAW(FALSE)

    ' Nach GUI_DRAW, sonst zeichnet das Fenster darueber. SCISSOR haelt die
    ' Teilchen in der Flaeche -- ohne das fliegen sie ueber die Regler.
    grundZeichnen(vx, vy, vb, vh)
    SCISSOR(vx, vy, vb, vh)
    PARTICLE_DRAW(sys)
    SCISSOR_END()
    RECT(vx, vy, vx + vb - 1, vy + vh - 1, &H2E3C50)
    streifenZeichnen()

    ' Zahlen neben den Reglern
    FOR k = 0 TO N_REGLER - 1
        GUI_SET_TEXT(wertText[k], FORMAT$(GUI_VALUE(regler[k]), "%.0f"))
    NEXT
    GUI_STATUSBAR_SET(lblStatus, sfZahl, STR$(PARTICLE_COUNT(sys)) + " Teilchen")
    GUI_STATUSBAR_SET(lblStatus, sfSchritt, "Schritt " + STR$(uPos + 1) + " von " + STR$(uAnz))

    IF frage >= 0 THEN
        DIM ea AS INTEGER : ea = GUI_ANSWER(frage)
        IF ea = 1 THEN
            frage = -1
            einstellungSichern()
            IF NOT ungesichert() THEN beenden = TRUE
        ELSEIF ea = 2 THEN
            frage = -1 : beenden = TRUE
        ELSEIF ea = 3 THEN
            frage = -1
        END IF
        ' Die Vorschau entsteht nach GUI_DRAW -- ohne diesen Aufruf laege sie
        ' ueber dem Kasten.
        IF frage >= 0 THEN GUI_DRAW_WINDOW(frage)
    END IF
    ' Menues, Klapplisten und Tooltips liegen ueber allem, auch ueber der
    ' Vorschau.
    GUI_DRAW_TOP()

    FLIP()
WEND
