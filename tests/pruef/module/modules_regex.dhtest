--- erwartet
world hello

=== regex split multi separator (1)
' SPLIT$ kann nur Single-Char-Sep -- regex_split kann jedes Pattern.
IMPORT "regex"
DIM parts AS ARRAY OF STRING
parts = REGEX_SPLIT("a,b;c, d", "[,;]\s*")
PRINT parts.length()
PRINT parts[0]
PRINT parts[1]
PRINT parts[2]
PRINT parts[3]
--- erwartet
4
a
b
c
d

=== regex split multi separator (2)
' SPLIT$ kann nur Single-Char-Sep -- regex_split kann jedes Pattern.
IMPORT "regex"
DIM parts AS ARRAY OF STRING
parts = REGEX_SPLIT("a,b;c, d", "[,;]\s*")
PRINT parts.length()
PRINT parts[0]
PRINT parts[1]
PRINT parts[2]
PRINT parts[3]
--- erwartet
4
a
b
c
d

