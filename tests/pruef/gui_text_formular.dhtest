=== gui set text leert den verlauf
' Ein vom Programm gesetzter Text ist kein Schritt des Nutzers -- Strg+Z
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
GUI_FOCUS(tf)
CLIPBOARD_SET("ab")
DIM f AS INTEGER
FOR f = 1 TO 70
    GUI_UPDATE()
    GUI_DRAW()
    IF f = 30 THEN GUI_SET_TEXT(tf, "neu")
    IF f = 65 THEN PRINT "[" + GUI_TEXT(tf) + "]"
    FLIP()
NEXT
--- datei ev.txt
# Test-Aufnahme
c 8
e 3 2 341 0 0 0 // Event: test
e 3 2 86 0 0 0 // Event: test
e 4 1 86 0 0 0 // Event: test
e 4 1 341 0 0 0 // Event: test
e 60 2 341 0 0 0 // Event: test
e 60 2 90 0 0 0 // Event: test
e 61 1 90 0 0 0 // Event: test
e 61 1 341 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=72
--- erwartet
[neu]

=== enter im textfeld loest den standardknopf aus
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
DIM ok AS GUI_WIDGET
ok = GUI_BUTTON(w, "OK", 10, 50, 80, 26)
DIM ab AS GUI_WIDGET
ab = GUI_BUTTON(w, "Abbrechen", 100, 50, 100, 26)
GUI_WINDOW_DEFAULT(w, ok)
GUI_WINDOW_CANCEL(w, ab)
GUI_FOCUS(tf)
DIM f AS INTEGER
FOR f = 1 TO 10
    GUI_UPDATE()
    GUI_DRAW()
    IF GUI_CLICKED(ok) THEN PRINT "ok " + STR$(f)
    IF GUI_CLICKED(ab) THEN PRINT "ab " + STR$(f)
    FLIP()
NEXT
--- datei ev.txt
# Test-Aufnahme
c 2
e 4 2 257 0 0 0 // Event: test
e 5 1 257 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=12
--- erwartet
ok 2

