=== eval mit id gibt id und ausdruck zurueck
' Ein Editor, der Tooltip-Werte und die Eingabezeile ueber dasselbe eval
' fragt, erkennt die Antwort an der id.
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("d.dh", ["{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "lines" + q + ":[3]}", _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "eval" + q + "," + q + "expr" + q + ":" + q + "x" + q + "," + q + "id" + q + ":" + q + "hover" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "eval" + q + "," + q + "expr" + q + ":" + q + "gibtsnicht" + q + "," + q + "id" + q + ":" + q + "hover" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "eval" + q + "," + q + "expr" + q + ":" + q + "x + 1" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "stop" + q + "}"])
DIM i AS INTEGER
FOR i = 0 TO LEN(ereignisse) - 1
    IF LEFT$(art$(i), 4) = "eval" THEN PRINT art$(i); " ["; feld$(i, "id"); "] ["; feld$(i, "expr"); "] "; feld$(i, "value")
NEXT
