=== die infoleiste meldet ihren knopf und das kreuz
' Die Lage der Knoepfe kommt aus GUI_INFOBAR_BUTTON_RECT -- das Programm
' schreibt seine Aufnahme selbst, sobald die Leiste gelegt ist.
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM unter AS GUI_WIDGET
unter = GUI_BUTTON(w, "Darunter", 0, 0, 600, 30)
GUI_INFOBAR(w, "Die Datei wurde geaendert.", "warnung", "Neu laden|Behalten")
GUI_UPDATE()
DIM r AS TUPLE
r = GUI_INFOBAR_BUTTON_RECT(w, 2)
DIM k AS TUPLE
k = GUI_INFOBAR_BUTTON_RECT(w, 0)
DIM bx AS INTEGER : bx = r[0] + r[2] \ 2
DIM by AS INTEGER : by = r[1] + r[3] \ 2
DIM kx AS INTEGER : kx = k[0] + k[2] \ 2
DIM ky AS INTEGER : ky = k[1] + k[3] \ 2
PRINT "kreuz rechts von den knoepfen: " + STR$(k[0] > r[0] + r[2])
WRITEALL("ev.txt", "c 8" + CHR$(10) + "e 4 7 " + STR$(bx) + " " + STR$(by) + " 0 0" + CHR$(10) + "e 5 7 " + STR$(bx) + " " + STR$(by) + " 0 0" + CHR$(10) + "e 6 6 0 0 0 0" + CHR$(10) + "e 8 5 0 0 0 0" + CHR$(10) + "e 30 7 " + STR$(kx) + " " + STR$(ky) + " 0 0" + CHR$(10) + "e 31 7 " + STR$(kx) + " " + STR$(ky) + " 0 0" + CHR$(10) + "e 32 6 0 0 0 0" + CHR$(10) + "e 34 5 0 0 0 0" + CHR$(10) + CHR$(10))
AUTOMATION_PLAY("ev.txt")
DIM getroffen AS BOOLEAN : getroffen = FALSE
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_INFOBAR_ANSWER(w) <> 0 THEN PRINT "antwort " + STR$(GUI_INFOBAR_ANSWER(w)) + " sichtbar " + STR$(GUI_INFOBAR_SHOWN(w))
    IF GUI_CLICKED(unter) THEN getroffen = TRUE
    n = n + 1
    IF n = 20 THEN GUI_INFOBAR(w, "Noch einmal.", "info")
    IF n = 50 THEN PRINT "knopf darunter " + STR$(getroffen)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=55
--- erwartet
kreuz rechts von den knoepfen: TRUE
antwort 2 sichtbar FALSE
antwort -1 sichtbar FALSE
knopf darunter FALSE

=== das suchfeld meldet erst nach der pause
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 20, 200, 28)
GUI_TEXTINPUT_SET(tf, "suche", 1)
GUI_FOCUS(tf)
CLIPBOARD_SET("ap")
AUTOMATION_PLAY("ev.txt")
DIM getippt AS INTEGER : getippt = -1
DIM gemeldet AS INTEGER : gemeldet = -1
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF getippt < 0 AND GUI_TEXT(tf) <> "" THEN getippt = n
    IF GUI_SEARCH_CHANGED(tf) AND gemeldet < 0 THEN gemeldet = n
    IF n = 40 THEN PRINT "text " + GUI_TEXT(tf) + " pause " + STR$(gemeldet - getippt) + " nicht sofort " + STR$(gemeldet > getippt)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
