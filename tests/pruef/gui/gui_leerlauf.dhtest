' Leerlauf (leerlauf.rs, Gui::bild_in): mit WINDOW_WAIT_EVENTS schlaeft
' FLIP, solange nichts passiert -- aber nur so lange, wie die gui kein Bild
' braucht. GUI_NEXT_FRAME() sagt nach GUI_DRAW, wann sie das naechste
' braucht (-1 = erst bei einer Eingabe), WINDOW_IDLE_WAIT() nach FLIP, wie
' lange es warten durfte. Die ersten Faelle laufen mit fester Bildzahl
' (1/60 s je Bild), die letzten in echter Zeit.
' Format: docs/werkzeuge.md, dhrt test.

=== ohne bewegung braucht die gui kein bild
TRY
    SCREEN(400, 200, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
DIM t AS GUI_WIDGET : t = GUI_TEXTINPUT(w, 20, 20, 200, 28)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w, "Knopf", 20, 70, 120, 30)
DIM n AS INTEGER = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE() : CLS(0) : GUI_DRAW()
    n = n + 1
    IF n = 5 THEN PRINT GUI_NEXT_FRAME()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=6
--- erwartet
-1.0

=== die schreibmarke meldet, wann sie umschlaegt
TRY
    SCREEN(400, 200, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
DIM t AS GUI_WIDGET : t = GUI_TEXTINPUT(w, 20, 20, 200, 28)
GUI_FOCUS(t)
DIM n AS INTEGER = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE() : CLS(0) : GUI_DRAW()
    n = n + 1
    ' Bild 5: der Takt steht bei 5/60 s, die Marke schlaegt bei 16/60 s um.
    IF n = 5 THEN PRINT ROUND(GUI_NEXT_FRAME() * 60)
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=6
--- erwartet
11

=== eine laufende animation braucht jedes bild
TRY
    SCREEN(400, 200, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
