=== noise deterministic and zero at lattice
PRINT NOISE(0)
PRINT NOISE2(3, 5)
PRINT NOISE2(1.5, 2.5) = NOISE2(1.5, 2.5)
--- erwartet
0.0
0.0
TRUE

=== noise in range
DIM i AS INTEGER
DIM ok AS INTEGER
ok = 1
FOR i = 0 TO 200
    DIM n AS FLOAT
    n = NOISE2(i * 0.137, i * 0.071)
    IF n < -1.001 OR n > 1.001 THEN ok = 0
NEXT
PRINT ok
--- erwartet
1

=== fbm deterministic
PRINT FBM(1.5, 2.5, 4) = FBM(1.5, 2.5, 4)
--- erwartet
TRUE

=== typeof
DIM s AS STRING
s = "x"
PRINT TYPEOF(5)
PRINT TYPEOF(3.0)
PRINT TYPEOF(s)
PRINT TYPEOF(TRUE)
--- erwartet
INTEGER
FLOAT
STRING
BOOLEAN

=== type predicates
PRINT ISNUM(5)
PRINT ISNUM(3.0)
PRINT ISINT(5)
PRINT ISINT(3.0)
PRINT ISSTR("x")
PRINT ISBOOL(TRUE)
PRINT ISINT(TRUE)
