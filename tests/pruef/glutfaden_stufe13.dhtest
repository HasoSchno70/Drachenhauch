=== probe: einstellungs-dialog, wirkung, raster-optionen, automatisch sichern
IMPORT "helfer.dh"
' --probe-stufe13 mit alle.pxs und eigenem Einstellungsordner: der Dialog
' (Vorgaben, jeder Reiter, Werte und Kuerzel aendern samt Zusammenstoss,
' Uebernehmen), die Wirkung (Zoom, Fuellen, Pipette, Tooltip), die
' Raster-Optionen, Zuruecksetzen, Zuletzt geoeffnet, automatisch sichern
' mit verwaisten Staenden, .bak. Danach die einstellungen.json.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe13", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["einstellungen", "einstellungen_1", "einstellungen_2", "einstellungen_3", "einstellungen_4", "einstellungen_kuerzel", "nur_symbol", "raster_optionen", "raster_blau"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    ' Die Rasterfarben im Bild: kraeftige Linien erst rot (Dialog), dann blau
    ' (Raster-Optionen) -- und jeweils nicht die andere Farbe
    PRINT "raster im bild: rot "; punkte("d_nur_symbol.png", &HC00000) > 100; " blau "; punkte("d_nur_symbol.png", &H2864B4) = 0; " | danach blau "; punkte("d_raster_blau.png", &H2864B4) > 100; " rot "; punkte("d_raster_blau.png", &HC00000) = 0
    ' "Nur Symbol": keine Farbflaechen -- Garn-Gelb kommt nur in Kaestchen vor
    PRINT "nur symbol: gelb "; punkte("d_nur_symbol.png", &HFAC81E)
    DIM e AS kern.Einstellungen : e = kern.einstellungenLaden("app/Glutfaden/einstellungen.json")
    PRINT "gesichert: raster "; e.rasterHaupt; "/"; e.rasterNeben; " zoom "; e.zoomTempo; " kuerzel "; LEN(MAPKEYS(e.kuerzel)); " | zuletzt "; LEN(e.zuletzt); " "; BASENAME(e.zuletzt[0]); " | letztes werkzeug "; e.letztesWerkzeug
    DIM liste AS ARRAY OF STRING : liste = DIRLIST("app/Glutfaden/autosicherung", "*")
    SORT(liste)
    PRINT "autosicherung: "; JOIN$(liste, " ")
    PRINT "neben der datei: bak "; FILEEXISTS("alle.pxs.bak"); " autosave "; FILEEXISTS("alle.pxs.autosave")
END IF
