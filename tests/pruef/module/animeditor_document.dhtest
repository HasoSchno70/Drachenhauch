    },
    {
      "from": "run",
      "to": "idle",
      "conditions": [
        {
          "param": "speed",
          "op": "lt",
          "value": 5.0
        }
      ]
    },
    {
      "from": "*",
      "to": "jump",
      "conditions": [
        {
          "param": "jump",
          "op": "trigger"
        }
      ]
    },
    {
      "from": "jump",
      "to": "idle",
      "wait_finished": true,
      "conditions": []
    }
  ]
}
