' --- Kleine Helfer
SUB gtkKlasse(w AS INTEGER, name AS STRING)
    gtk_style_context_add_class(gtk_widget_get_style_context(w), name)
END SUB

SUB gtkKlasseWeg(w AS INTEGER, name AS STRING)
    gtk_style_context_remove_class(gtk_widget_get_style_context(w), name)
END SUB

FUNCTION gtkFehler$(f AS INTEGER) AS STRING
    IF f = 0 THEN RETURN ""
    DIM g AS GError : g = BUFFER_AUS_ZEIGER(f, SIZEOF(GError))
    DIM t AS STRING : t = TEXT_AUS_ZEIGER$(g.meldung)
    g_error_free(f)
    RETURN t
END FUNCTION

' Eine Farbe &HRRGGBB als Quelle fuer Cairo.
SUB cairoFarbe(cr AS INTEGER, f AS INTEGER)
    cairo_set_source_rgb(cr, ((f SHR 16) BAND 255) / 255.0, ((f SHR 8) BAND 255) / 255.0, (f BAND 255) / 255.0)
END SUB

' Ein Stylesheet fuer den ganzen Bildschirm laden; Rueckgabe "" oder der Fehler.
FUNCTION gtkStil$(css AS STRING) AS STRING
    DIM p AS INTEGER : p = gtk_css_provider_new()
    DIM f AS INTEGER
    IF NOT gtk_css_provider_load_from_data(p, css, -1, f) THEN RETURN gtkFehler$(f)
    gtk_style_context_add_provider_for_screen(gdk_screen_get_default(), p, GTK_VORRANG_ANWENDUNG)
    RETURN ""
END FUNCTION

' Anstehende Ereignisse abarbeiten -- damit ein Balken waehrend einer langen
' Rechnung weiterzeichnet.
SUB gtkAbarbeiten()
    DIM weiter AS BOOLEAN
    WHILE gtk_events_pending()
        weiter = gtk_main_iteration_do(FALSE)
    WEND
END SUB

' Ein Widget in eine PNG zeichnen (unabhaengig davon, ob es zu sehen ist).
FUNCTION gtkFoto(w AS INTEGER, pfad AS STRING) AS BOOLEAN
    ' erst verteilen lassen, was noch ansteht -- ein eben gebautes Fenster hat
    ' sonst noch keine Groessen (Gtk-CRITICAL "alloc_needed")
    WHILE gtk_events_pending()
        DIM weiter AS BOOLEAN : weiter = gtk_main_iteration_do(FALSE)
    WEND
    ' ... und das Vermessen: das macht GTK im Takt der Bildwiederholung, nicht
    ' beim Abholen der Ereignisse. Hat im selben Takt etwas eine neue Groesse
    ' verlangt, verteilt erst das hier sie (sonst wieder "alloc_needed")
    gtk_container_check_resize(gtk_widget_get_toplevel(w))
    DIM flaeche AS INTEGER : flaeche = cairo_image_surface_create(CAIRO_ARGB32, gtk_widget_get_allocated_width(w), gtk_widget_get_allocated_height(w))
    DIM cr AS INTEGER : cr = cairo_create(flaeche)
    gtk_widget_draw(w, cr)
    DIM st AS INTEGER : st = cairo_surface_write_to_png(flaeche, pfad)
    cairo_destroy(cr)
    cairo_surface_destroy(flaeche)
    RETURN st = 0
END FUNCTION
