=== esc schliesst das menue und drueckt nicht abbrechen
' Gegenprobe im Fall: das zweite ESC (ohne Menue) drueckt den Knopf.
IMPORT "gui"
SCREEN(500, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 20, 360, 28)
GUI_SET_TEXT(tf, "da ist Hasu")
DIM ab AS GUI_WIDGET
ab = GUI_BUTTON(w, "Abbrechen", 20, 100, 120, 30)
GUI_WINDOW_CANCEL(w, ab)
GUI_FOCUS(tf)
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic")
GUI_SPELL(tf, h)
AUTOMATION_PLAY("ev.txt")
DIM gedrueckt AS BOOLEAN : gedrueckt = FALSE
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(ab) THEN gedrueckt = TRUE
    n = n + 1
    IF n = 20 THEN PRINT "erstes esc "; gedrueckt
    IF n = 35 THEN PRINT "zweites esc "; gedrueckt
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
