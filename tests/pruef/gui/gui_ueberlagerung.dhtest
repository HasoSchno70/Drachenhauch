--- umgebung
DHRT_FRAMES=75
--- erwartet
offen TRUE
nach esc offen FALSE text ap abbrechen 0
gewaehlt 3 text Aprikose

=== suchfeld, sinnbilder und vorschlaege stehen in der dhform
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 28)
GUI_TEXTINPUT_SET(tf, "suche", 1)
GUI_TEXTINPUT_ICON(tf, "", "auge")
GUI_TEXTINPUT_COMPLETION(tf, ["eins", "zwei"])
DIM j AS STRING
j = GUI_TO_JSON(w)
DIM q AS STRING : q = CHR$(34)
PRINT "suche " + STR$(INSTR(j, q + "suche" + q + ": true") >= 0)
PRINT "icons " + STR$(INSTR(j, q + "icons" + q) >= 0 AND INSTR(j, q + "auge" + q) >= 0)
PRINT "vorschlaege " + STR$(INSTR(j, q + "vorschlaege" + q) >= 0 AND INSTR(j, q + "zwei" + q) >= 0)
DIM w2 AS GUI_WINDOW
w2 = GUI_FROM_JSON(j)
PRINT "rundweg " + STR$(GUI_TO_JSON(w2) = j)
--- erwartet
suche TRUE
icons TRUE
vorschlaege TRUE
rundweg TRUE

=== falsche angaben sind fehler mit der liste
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "x", 10, 10, 50, 20)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 40, 200, 28)
TRY
    GUI_TOAST(w, "x", "rot")
CATCH e
    PRINT e
END TRY
TRY
    DIM p AS GUI_WINDOW
    p = GUI_POPOVER(b, 100, 100, "mitte")
CATCH e
    PRINT e
END TRY
TRY
    GUI_POPOVER_SHOW(w)
CATCH e
    PRINT e
END TRY
TRY
    GUI_TEXTINPUT_ICON(tf, "lupe", "")
CATCH e
    PRINT LEFT$(e, 64)
END TRY
TRY
    GUI_TEXTINPUT_ICON(b, "", "")
CATCH e
    PRINT e
END TRY
TRY
    GUI_INFOBAR(w, "x", "info", "a|b|c|d|e")
CATCH e
    PRINT e
END TRY
--- erwartet
GUI_TOAST: Art 'rot' gibt es nicht -- bekannt sind: info, erfolg, warnung, fehler
GUI_POPOVER: Seite 'mitte' gibt es nicht -- unten, oben, rechts oder links
GUI_POPOVER_SHOW: dieses Fenster ist kein Popover (GUI_POPOVER)
GUI_TEXTINPUT_ICON: ein Sinnbild 'lupe' gibt es nicht -- bekannt
GUI_TEXTINPUT_ICON: Widget ist kein Textfeld (GUI_TEXTINPUT)
GUI_INFOBAR: hoechstens vier Knoepfe
