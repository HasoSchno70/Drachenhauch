=== mediathek kapitel 4: ist die datei gesperrt, wird nichts entfernt
' Eine zweite Verbindung haelt eine Transaktion offen: das Entfernen
' wartet 5 s, nimmt alles zurueck und laesst Feld und Tabelle stehen.
prBild = prBild + 1
IF prBild = 2 THEN
    DIM fremd AS DB_CONN : fremd = DB_OPEN("mediathek.db")
    DB_BEGIN(fremd)
    DB_EXEC(fremd, "UPDATE eintrag SET jahr = jahr WHERE id = 1")
    GUI_TABLE_SELECT(tabelle, 1, TRUE)
    GUI_TABLE_SELECT(tabelle, 2, TRUE)
    auswahl_entfernen()
    PRINT LEFT$(GUI_TEXT(status), 44)
    PRINT LEN(mediathek); " "; GUI_TABLE_ROW_COUNT(tabelle)
    DB_ROLLBACK(fremd)
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT COUNT(*) FROM eintrag")
    DB_NEXT(r)
    PRINT "in der datei "; DB_GET_INT(r, 0)
    EXIT(0)
END IF
