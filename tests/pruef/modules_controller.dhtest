=== variable jump no effect when disabled
IMPORT "tiled"
IMPORT "tile_collide"
IMPORT "controller"
DIM m AS TILED_MAP
m = TILED_LOAD("level.json")
DIM c AS CHAR_CONTROLLER
c = CHAR_NEW(50.0, 104.0, 8.0, 8.0)
CHAR_SET_VARIABLE_JUMP(c, FALSE)
CHAR_SET_INPUT(c, 0, FALSE, FALSE)
CHAR_UPDATE(c, m, 0)
CHAR_SET_INPUT(c, 0, TRUE, TRUE)
CHAR_UPDATE(c, m, 0)
PRINT CHAR_VY(c)
CHAR_SET_INPUT(c, 0, FALSE, FALSE)
CHAR_UPDATE(c, m, 0)
PRINT CHAR_VY(c)
