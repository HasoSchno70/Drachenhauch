FUNCTION lesen$(pfad AS STRING, trenner AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(pfad)
    DIM r AS STRING : r = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        IF i > 0 THEN r = r + trenner
        r = r + z[i]
    NEXT
    RETURN r
END FUNCTION
FUNCTION bild(quelle AS STRING, bilder AS STRING) AS INTEGER
    ' Ein Programm N Bilder laufen lassen (dhrt bild); liefert seinen Rueckgabewert.
    DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "bild", CWD$() + "/" + quelle, CWD$() + "/lauf.png", bilder)
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    WHILE PROCESS_RUNNING(pc) AND MILLIS() < bis
        SLEEP(50)
    WEND
    RETURN PROCESS_CODE(pc)
END FUNCTION
IMPORT "json"
FUNCTION atlas(schluessel AS STRING) AS INTEGER
    ' Ein Schluessel, den es nicht gibt, laesst ATLAS_DRAW scheitern.
    DIM p AS STRING : p = "SCREEN(320, 240, " + CHR$(34) + "Pruefer" + CHR$(34) + ", 1)" + CHR$(10)
    p = p + "DIM a AS SPRITE_ATLAS : a = ATLAS_LOAD(" + CHR$(34) + "raus.json" + CHR$(34) + ")" + CHR$(10)
    p = p + "ATLAS_DRAW(a, " + CHR$(34) + schluessel + CHR$(34) + ", 10, 10)" + CHR$(10)
    WRITEALL("_programm/atl.dh", p)
    RETURN bild("_programm/atl.dh", "3")
END FUNCTION
