' Aus test_properties.py uebertragen (18 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== property basic getter setter (1)
CLASS Box
    DIM _v AS INTEGER

    PROPERTY GET v() AS INTEGER
        RETURN Self._v
    END PROPERTY

    PROPERTY SET v(value AS INTEGER)
        Self._v = value
    END PROPERTY
END CLASS

DIM b AS Box
b = NEW Box()
b.v = 42
PRINT b.v
b.v = 99
PRINT b.v
--- erwartet
42
99

