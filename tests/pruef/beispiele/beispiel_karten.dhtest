--- ersetzen IMPORT "kern.dh"
IMPORT "{sammlung}/../../examples/karten/kern.dh"
--- ersetzen IMPORT "kacheln.dh"
IMPORT "{sammlung}/../../examples/karten/kacheln.dh"
--- einschub nach     kachelnPumpen()
    prProbe()
--- argumente
--daten
{fall}/daten
--ort
52.5163,13.3777,10
--- umgebung
KARTEN_SERVER={sammlung}/_hilfen/gegenserver.dh
--- erwartet
