' Loesung Kapitel 4, Erweitern 1 -- Ausleihen in einer eigenen
' Tabelle: an wen ein Eintrag verliehen ist, und zurueck.
IMPORT "gui"
IMPORT "db"
IMPORT "../kap04/eintrag.dh"

' Die Datenbank liegt neben dem Programm; DB_OPEN legt die Datei beim
' ersten Start an.
DIM db AS DB_CONN
db = DB_OPEN("mediathek.db")
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS eintrag (" + _
            "id INTEGER PRIMARY KEY, titel TEXT NOT NULL, " + _
            "urheber TEXT, art TEXT, jahr INTEGER)")
' >>> neu
' Eine Ausleihe gehoert zu genau einem Eintrag; seine Kennung ist darum
' ihr Schluessel. Ein Eintrag ist hoechstens einmal verliehen.
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS ausleihe (" + _
            "eintrag INTEGER PRIMARY KEY REFERENCES eintrag(id), " + _
            "an TEXT NOT NULL)")

' Wer was hat: Kennung des Eintrags (als Text) -> Name.
DIM verliehen AS MAP OF STRING
FUNCTION ausleihen_laden() AS MAP OF STRING
    DIM m AS MAP OF STRING
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT eintrag, an FROM ausleihe")
    WHILE DB_NEXT(r)
        MAP_PUT(m, STR$(DB_GET_INT(r, 0)), DB_GET_STRING(r, 1))
    WEND
    RETURN m
END FUNCTION
verliehen = ausleihen_laden()
' <<< neu

' Alle Eintraege aus der Datenbank, in der Reihenfolge, in der sie
' aufgenommen wurden.
FUNCTION laden() AS ARRAY OF Eintrag
    DIM m AS ARRAY OF Eintrag
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT id, titel, urheber, art, jahr " + _
                     "FROM eintrag ORDER BY id")
    WHILE DB_NEXT(r)
        DIM e AS Eintrag
        e = NEW Eintrag(DB_GET_STRING(r, 1), DB_GET_STRING(r, 2), _
                        DB_GET_STRING(r, 3), "")
        e.id = DB_GET_INT(r, 0)
        ' Ein Jahr kann fehlen -- dann steht NULL in der Spalte.
        IF NOT DB_IS_NULL(r, 4) THEN e.jahr = STR$(DB_GET_INT(r, 4))
        ARRAY_PUSH(m, e)
    WEND
    RETURN m
END FUNCTION

' Einen neuen Eintrag speichern und sich die Kennung merken, die die
' Datenbank ihm gegeben hat.
SUB speichern(e AS Eintrag)
    DIM sql AS STRING
    sql = "INSERT INTO eintrag (titel, urheber, art, jahr) " + _
          "VALUES (?, ?, ?, ?)"
    IF e.jahr = "" THEN
        DB_EXEC(db, sql, e.titel, e.urheber, e.art, NIL)
    ELSE
        DB_EXEC(db, sql, e.titel, e.urheber, e.art, INT(VAL(e.jahr)))
    END IF
    e.id = DB_LAST_ROWID(db)
END SUB

DIM mediathek AS ARRAY OF Eintrag
mediathek = laden()
' Beim allerersten Start ist sie leer: dann die Beispiele hinein --
' alle in einer Transaktion.
IF LEN(mediathek) = 0 THEN
    DB_BEGIN(db)
    DIM beispiel AS Eintrag
    FOR EACH beispiel IN beispiele()
        speichern(beispiel)
    NEXT
    DB_COMMIT(db)
    mediathek = laden()
END IF

SCREEN(760, 520, "Mediathek", 1)
WINDOW_RESIZABLE(TRUE)
DIM fenster AS GUI_WINDOW
fenster = GUI_WINDOW("Mediathek", 0, 0, 760, 520)
GUI_WINDOW_CHROME(fenster, FALSE)

DIM form AS GUI_WIDGET
form = GUI_LAYOUT(fenster, "spalte", 0, 0, 760, 520)
GUI_SET_ANCHOR(form, "lrtb")
GUI_LAYOUT_SET(form, "rand", 20)
GUI_LAYOUT_SET(form, "abstand", 8)

' Eine Zeile des Formulars, wie in Kapitel 2.
SUB zeile(text AS STRING, feld AS GUI_WIDGET, gewicht AS INTEGER)
    DIM z AS GUI_WIDGET : z = GUI_LAYOUT(fenster, "zeile", 0, 0, 10, 10)
    GUI_LAYOUT_SET(z, "abstand", 12)
    GUI_LAYOUT_SET(z, "ausrichtung", 1)
    GUI_LAYOUT_SET(z, "dehnen", 0)
    DIM l AS GUI_WIDGET : l = GUI_LABEL(fenster, text, 0, 0)
    GUI_SIZE_GROUP(l, "beschriftung", "breite")
    GUI_LAYOUT_ADD(z, l)
    GUI_LAYOUT_ADD(z, feld, gewicht)
    IF gewicht = 0 THEN GUI_LAYOUT_SPACER(z)
    GUI_LAYOUT_ADD(form, z)
END SUB

DIM titel AS GUI_WIDGET : titel = GUI_TEXTINPUT(fenster, 0, 0, 0, 0)
DIM urheber AS GUI_WIDGET : urheber = GUI_TEXTINPUT(fenster, 0, 0, 0, 0)
DIM arten AS ARRAY OF STRING
arten = ["Buch", "Film", "Spiel", "Musik"]
DIM art AS GUI_WIDGET : art = GUI_DROPDOWN(fenster, 0, 0, 160, 0, arten)
GUI_DROPDOWN_SET_SELECTED(art, 0)
DIM jahr AS GUI_WIDGET : jahr = GUI_TEXTINPUT(fenster, 0, 0, 80, 0)
zeile("Titel", titel, 1)
zeile("Urheber", urheber, 1)
zeile("Art", art, 0)
zeile("Erscheinungsjahr", jahr, 0)

' Die Tabelle bekommt allen Platz, der uebrig bleibt (Gewicht 1).
DIM tabelle AS GUI_WIDGET : tabelle = GUI_TABLE(fenster, 0, 0, 10, 10)
' >>> neu
GUI_TABLE_HEADERS(tabelle, ["Titel", "Urheber", "Art", "Jahr", _
                            "Verliehen an"])
GUI_TABLE_COL_WIDTHS(tabelle, [230, 180, 80, 70, 140])
' <<< neu
GUI_TABLE_SET(tabelle, "zebra", 1)
GUI_TABLE_SET(tabelle, "zeilenhoehe", 26)
GUI_TABLE_SET(tabelle, "filterzeile", 1)
GUI_TABLE_PLACEHOLDER(tabelle, "Keine Treffer.")
GUI_TABLE_SET(tabelle, "mehrfachauswahl", 1)
GUI_LAYOUT_ADD(form, tabelle, 1)

DIM knoepfe AS GUI_WIDGET
knoepfe = GUI_LAYOUT(fenster, "zeile", 0, 0, 10, 10)
DIM status AS GUI_WIDGET : status = GUI_LABEL(fenster, "", 0, 0)
DIM knopf AS GUI_WIDGET
knopf = GUI_BUTTON(fenster, "Aufnehmen", 0, 0, 0, 0)
GUI_LAYOUT_SET(knoepfe, "ausrichtung", 1)
GUI_LAYOUT_SET(knoepfe, "dehnen", 0)
DIM entfernen AS GUI_WIDGET
entfernen = GUI_BUTTON(fenster, "Entfernen", 0, 0, 0, 0)
GUI_LAYOUT_ADD(knoepfe, status)
GUI_LAYOUT_SPACER(knoepfe)
' >>> neu
DIM an AS GUI_WIDGET
an = GUI_TEXTINPUT(fenster, 0, 0, 140, 0, "an wen?")
DIM verleihen AS GUI_WIDGET
verleihen = GUI_BUTTON(fenster, "Verleihen", 0, 0, 0, 0)
DIM zurueck AS GUI_WIDGET
zurueck = GUI_BUTTON(fenster, "Zurück", 0, 0, 0, 0)
GUI_LAYOUT_ADD(knoepfe, an)
GUI_LAYOUT_ADD(knoepfe, verleihen)
GUI_LAYOUT_ADD(knoepfe, zurueck)
' <<< neu
GUI_LAYOUT_ADD(knoepfe, entfernen)
GUI_LAYOUT_ADD(knoepfe, knopf)
GUI_LAYOUT_ADD(form, knoepfe)

GUI_WINDOW_DEFAULT(fenster, knopf)
GUI_FOCUS(titel)

' >>> neu
' Die Zellen einer Zeile: die vier des Eintrags und die Ausleihe.
FUNCTION zellen(e AS Eintrag) AS ARRAY OF STRING
    DIM z AS ARRAY OF STRING : z = e.zellen()
    ARRAY_PUSH(z, MAP_GET_OR(verliehen, STR$(e.id), ""))
    RETURN z
END FUNCTION
' <<< neu

' Was im Feld steht, zeigt die Tabelle -- einmal am Anfang alles.
DIM e AS Eintrag
FOR EACH e IN mediathek
    ' >>> neu
    GUI_TABLE_ADD_ROW(tabelle, zellen(e))
    ' <<< neu
NEXT
GUI_SET_TEXT(status, STR$(LEN(mediathek)) + " Einträge")

SUB aufnehmen()
    DIM t AS STRING : t = TRIM$(GUI_TEXT(titel))
    IF t = "" THEN
        GUI_SET_TEXT(status, "Bitte einen Titel eingeben.")
        GUI_FOCUS(titel)
        RETURN
    END IF
    DIM neu AS Eintrag
    neu = NEW Eintrag(t, TRIM$(GUI_TEXT(urheber)), GUI_TEXT(art), _
                      TRIM$(GUI_TEXT(jahr)))
    ' Erst in die Datenbank, dann ins Feld, dann in die Anzeige.
    speichern(neu)
    ARRAY_PUSH(mediathek, neu)
    ' >>> neu
    DIM z AS INTEGER : z = GUI_TABLE_ADD_ROW(tabelle, zellen(neu))
    ' <<< neu
    GUI_TABLE_SET_SELECTED(tabelle, z)
    GUI_SET_TEXT(status, STR$(LEN(mediathek)) + " Einträge")
    GUI_SET_TEXT(titel, "")
    GUI_SET_TEXT(urheber, "")
    GUI_SET_TEXT(jahr, "")
    GUI_FOCUS(titel)
END SUB

' Alle gewaehlten Eintraege entfernen -- aus den Daten und aus der
' Tabelle, und zwar von hinten nach vorn.
SUB auswahl_entfernen()
    DIM n AS INTEGER : n = GUI_TABLE_SEL_COUNT(tabelle)
    IF n = 0 THEN
        GUI_SET_TEXT(status, "Erst eine Zeile wählen.")
        RETURN
    END IF
    DIM zeilen AS ARRAY OF INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        ARRAY_PUSH(zeilen, GUI_TABLE_SEL_ROW(tabelle, i))
    NEXT
    SORT(zeilen, TRUE)
    ' Erst die Datenbank, ganz oder gar nicht. Geht dort etwas schief,
    ' nimmt ROLLBACK alles zurueck, und Feld und Tabelle bleiben, wie
    ' sie sind.
    DIM z AS INTEGER
    DB_BEGIN(db)
    TRY
        FOR EACH z IN zeilen
            DIM weg AS INTEGER : weg = mediathek[z].id
            ' >>> neu
            DB_EXEC(db, "DELETE FROM ausleihe WHERE eintrag = ?", weg)
            ' <<< neu
            DB_EXEC(db, "DELETE FROM eintrag WHERE id = ?", weg)
        NEXT
        DB_COMMIT(db)
    CATCH fehler
        DB_ROLLBACK(db)
        GUI_SET_TEXT(status, "Nichts entfernt: " + fehler)
        RETURN
    END TRY
    ' Dann Feld und Tabelle.
    FOR EACH z IN zeilen
        ARRAY_REMOVE_AT(mediathek, z)
        GUI_TABLE_REMOVE_ROW(tabelle, z)
    NEXT
    GUI_SET_TEXT(status, STR$(n) + " entfernt, " + _
                         STR$(LEN(mediathek)) + " Einträge")
END SUB

' Ein Eintrag ganz, in einem Satz -- fuer den Doppelklick.
SUB zeigen(z AS INTEGER)
    DIM e AS Eintrag : e = mediathek[z]
    GUI_SET_TEXT(status, e.titel + " von " + e.urheber + " (" + _
                         e.art + ", " + e.jahr + ")")
END SUB

' >>> neu
' Den gewaehlten Eintrag verleihen -- oder die Ausleihe beenden.
SUB ausleihe_setzen(wer AS STRING)
    DIM z AS INTEGER : z = GUI_TABLE_SELECTED(tabelle)
    IF z < 0 THEN
        GUI_SET_TEXT(status, "Erst eine Zeile wählen.")
        RETURN
    END IF
    DIM e AS Eintrag : e = mediathek[z]
    IF wer = "" THEN
        DB_EXEC(db, "DELETE FROM ausleihe WHERE eintrag = ?", e.id)
        MAP_REMOVE(verliehen, STR$(e.id))
        GUI_SET_TEXT(status, e.titel + " ist wieder da.")
    ELSE
        DB_EXEC(db, "INSERT OR REPLACE INTO ausleihe (eintrag, an) " + _
                    "VALUES (?, ?)", e.id, wer)
        MAP_PUT(verliehen, STR$(e.id), wer)
        GUI_SET_TEXT(status, e.titel + " ist bei " + wer + ".")
    END IF
    GUI_TABLE_SET_CELL(tabelle, z, 4, wer)
END SUB
' <<< neu

WINDOW_MIN_SIZE(GUI_LAYOUT_MIN_W(form), GUI_LAYOUT_MIN_H(form))
WINDOW_WAIT_EVENTS(1)
WHILE NOT QUITREQUESTED()
    IF WINDOW_RESIZED() THEN
        DIM b AS INTEGER : b = SCREENWIDTH()
        DIM h AS INTEGER : h = SCREENHEIGHT()
        GUI_WINDOW_SET_BOUNDS(fenster, 0, 0, b, h)
    END IF
    GUI_UPDATE()
    IF GUI_CLICKED(knopf) THEN aufnehmen()
    IF GUI_CLICKED(entfernen) THEN auswahl_entfernen()
    ' >>> neu
    IF GUI_CLICKED(verleihen) THEN
        DIM wer AS STRING : wer = TRIM$(GUI_TEXT(an))
        IF wer = "" THEN
            GUI_SET_TEXT(status, "An wen? Bitte einen Namen eingeben.")
        ELSE
            ausleihe_setzen(wer)
        END IF
    END IF
    IF GUI_CLICKED(zurueck) THEN ausleihe_setzen("")
    ' <<< neu
    IF GUI_DOUBLE_CLICKED(tabelle) THEN
        zeigen(GUI_TABLE_SELECTED(tabelle))
    END IF
    CLS(RGB(32, 36, 44))
    GUI_DRAW()
    FLIP()
WEND
DB_CLOSE(db)
