=== not auf einen wert in der schleife
DIM m AS MAP OF INTEGER
DIM s AS STRING
DIM i AS INTEGER
MAPPUT(m, "k3", 3)
MAPPUT(m, "k5", 5)
FOR i = 0 TO 6
    IF NOT MAPHAS(m, "k" + STR$(i)) THEN s = s + "-" ELSE s = s + "+"
    IF NOT STR$(i) = "4" THEN s = s + "a"
NEXT
PRINT s
