bild 6 schritt 0
bild 10 schritt 1
bild 13 fertig

=== abbrechen meldet sich
IMPORT "gui"
SCREEN(440, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 440, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM wz AS GUI_WIDGET : wz = GUI_WIZARD(w, 10, 10, 400, 250)
GUI_WIZARD_ADD(wz, "Eins")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_WIZARD_CANCELLED(wz) THEN PRINT "abgebrochen"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
