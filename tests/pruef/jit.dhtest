=== objekte in einem feld bewegen
CLASS Teil
    DIM x AS FLOAT
    DIM vx AS FLOAT
    DIM n AS INTEGER
END CLASS
DIM teile[20] AS Teil
DIM i AS INTEGER
FOR i = 0 TO 19
    teile[i] = NEW Teil()
    teile[i].vx = i * 0.25
NEXT
DIM r AS INTEGER
FOR r = 1 TO 5
    FOR EACH t IN teile
        t.x = t.x + t.vx
        t.n = t.n + 1
        IF t.x > 10.0 THEN t.vx = 0.0 - t.vx
    NEXT
NEXT
PRINT teile[19].x; " "; teile[19].vx; " "; teile[3].n; " "; t.x
