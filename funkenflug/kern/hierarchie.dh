' Hierarchische Blaetter -- Namensraum "kern".
'
' Ein Unterblatt wird im Elternblatt als Blattsymbol eingesetzt: ein Bauteil
' mit dem Verweis "#BLATT:<Blatt-Id>". Sein Symbol wird NICHT gespeichert,
' sondern jedes Mal aus den hierarchischen Labels des Unterblatts erzeugt --
' ein Port je Label-Name. So gibt es keine zweite Port-Liste, die mit dem
' Unterblatt auseinanderlaufen kann (SparkNode hielt beides getrennt).
'
' Verbunden wird ueber den Namen: der Port im Elternblatt und alle
' hierarchischen Labels gleichen Namens im Unterblatt sind ein Netz.
'
' MEHRFACH-INSTANZEN: ein Blatt darf mehrmals eingesetzt sein (zwei gleiche
' Kanaele). Gezeichnet wird es einmal; elektrisch ist jede Instanz eine
' eigene Schaltung. flach() rollt das Dokument dafuer aus: jede weitere
' Instanz wird eine Kopie des Blatts, deren Bauteile Ids und Referenzen ihres
' Instanzpfads tragen (Pfad = Kette der Blattsymbol-Ids von der Wurzel).
' Netze, ERC, Stueckliste, Netzlisten, Platine, Gerber, 3D und Simulation
' rechnen auf dieser Sicht -- nichts davon kennt Instanzen. Die ERSTE Instanz
' bleibt das Original (Ids, Referenzen), damit vorhandene Platinen beim
' Hinzufuegen einer zweiten Instanz gueltig bleiben. Referenzen der weiteren
' Instanzen stehen im Bauteil (instanzRefs je Pfad); bis zum Annotieren gilt
' "R1_2". Der ERC meldet Zyklen und fehlende Unterblaetter.
'
' Seite eines Ports = die Seite, zu der der Label-Text im Unterblatt zeigt:
' ein Label links am Rand des Unterblatts (Text nach links, 180) ist ein
' Eingang und sitzt links am Symbol, Text nach rechts (0) rechts, nach oben
' (270) oben, nach unten (90) unten. (Bis Runde 22 war es genau verkehrt
' herum -- aufgefallen beim KiCad-Import, wo die Ports dann gegenueber der
' KiCad-Vorlage vertauscht lagen.)

CONST BLATT_VORSATZ = "#BLATT:"

FUNCTION istBlattVerweis(ref AS STRING) AS BOOLEAN
    RETURN STARTSWITH(ref, BLATT_VORSATZ)
END FUNCTION

FUNCTION blattIndexMitId(dok AS Dokument, id AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(dok.blaetter) - 1
        IF dok.blaetter[i].id = id THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Index des Unterblatts, auf das ein Blattsymbol zeigt (-1 = fehlt/kein Verweis).
FUNCTION kindIndex(dok AS Dokument, b AS Bauteil) AS INTEGER
    IF NOT istBlattVerweis(b.symbolRef) THEN RETURN -1
    RETURN blattIndexMitId(dok, MID$(b.symbolRef, LEN(BLATT_VORSATZ)))
END FUNCTION

' Die Ports eines Blatts: Namen der hierarchischen Labels (je Name einmal,
' in Reihenfolge des Auftretens) und ihre Seite.
SUB blattPorts(kind AS Blatt, BYREF namen AS ARRAY OF STRING, BYREF seiten AS ARRAY OF STRING)
    namen = []
    seiten = []
    DIM da AS MAP OF INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(kind.labels) - 1
        DIM la AS Label : la = kind.labels[i]
        IF la.art <> LA_HIER OR MAPHAS(da, la.text) THEN CONTINUE
        MAPPUT(da, la.text, 1)
        ARRAY_PUSH(namen, la.text)
        SELECT CASE la.drehung
            CASE 180 : ARRAY_PUSH(seiten, "links")
            CASE 270 : ARRAY_PUSH(seiten, "oben")
            CASE 90 : ARRAY_PUSH(seiten, "unten")
            CASE ELSE : ARRAY_PUSH(seiten, "rechts")
        END SELECT
    NEXT
END SUB

' Das Symbol eines Blattsymbols: Rechteck mit innerer Linie, ein Port je Name.
FUNCTION blattSymbolErzeugen(kind AS Blatt) AS Symbol
    DIM namen AS ARRAY OF STRING, seiten AS ARRAY OF STRING
    blattPorts(kind, namen, seiten)
    ' der Generator braucht Woerter ohne Leerzeichen -- Platzhalter gleicher
    ' Laenge, die echten Namen kommen danach hinein
    DIM t AS STRING : t = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(namen) - 1
        t = t + "P" + STR$(i + 1) + " " + REPLACE$(namen[i], " ", "_") + " " + seiten[i] + CHR$(10)
    NEXT
    DIM s AS Symbol : s = icErzeugen(BLATT_VORSATZ + kind.id, "Unterblatt", "", "", t)
    s.eigen = FALSE
    s.quelltext = ""
    s.blattSymbol = TRUE
    s.blattKind = kind.id
    s.beschreibung = "Unterblatt " + kind.name
    FOR i = 0 TO LEN(s.pins) - 1
        s.pins[i].name = namen[i]
        s.pins[i].nummer = namen[i]
        s.pins[i].zeigeNummer = FALSE
    NEXT
    ' innere Linie: ein Blattsymbol sieht man auf einen Blick
    IF LEN(s.grafik) > 0 AND s.grafik[0].art = PR_RECHTECK THEN
        DIM r AS Primitiv : r = s.grafik[0]
        s.grafikHinzu(prRechteck(r.punkte[0].x + 40, r.punkte[0].y + 40, r.punkte[1].x - 40, r.punkte[1].y - 40))
    END IF
    RETURN s
END FUNCTION

' Symbole und Referenzen aller Blattsymbole neu erzeugen (nach Laden und
' jeder Aenderung): Referenz = Name des Unterblatts, ab der zweiten Instanz
' mit Nummer ("Kanal (2)").
SUB blattSymboleAktualisieren(dok AS Dokument)
    DIM bi AS INTEGER, i AS INTEGER
    DIM mehr AS BOOLEAN : mehr = mehrfachInstanzen(dok)
    DIM f AS Dokument : f = dok
    IF mehr THEN f = flach(dok)
    FOR bi = 0 TO LEN(dok.blaetter) - 1
        FOR i = 0 TO LEN(dok.blaetter[bi].bauteile) - 1
            DIM b AS Bauteil : b = dok.blaetter[bi].bauteile[i]
            IF NOT istBlattVerweis(b.symbolRef) THEN CONTINUE
            DIM ki AS INTEGER : ki = kindIndex(dok, b)
            IF ki < 0 THEN
                IF NOT b.sym.fehlt THEN
                    b.sym = symbolPlatzhalter(b.symbolRef)
                    b.sym.name = "Unterblatt fehlt"
                    b.sym.blattSymbol = TRUE
                END IF
            ELSE
                b.sym = blattSymbolErzeugen(dok.blaetter[ki])
                b.referenz = dok.blaetter[ki].name
                IF mehr THEN
                    DIM nr AS INTEGER : nr = MAPGETOR(f.nummern, b.id, 1)
                    IF nr > 1 THEN b.referenz = b.referenz + " (" + STR$(nr) + ")"
                END IF
                b.wert = ""
            END IF
        NEXT
    NEXT
END SUB

' --- Mehrfach-Instanzen ----------------------------------------------------------

' Steckt Blatt "ziel" (ueber beliebig viele Ebenen) in Blatt "von"? Ein Blatt
' kann jetzt mehrere Eltern haben -- die erste Eltern-Kette (elternVon) reicht
' fuer Zyklen nicht mehr.
FUNCTION blattEnthaelt(dok AS Dokument, von AS INTEGER, ziel AS INTEGER) AS BOOLEAN
    DIM besucht AS MAP OF INTEGER
    DIM stapel AS ARRAY OF INTEGER : stapel = [von]
    WHILE LEN(stapel) > 0
        DIM bi AS INTEGER : bi = ARRAY_POP(stapel)
        IF MAPHAS(besucht, STR$(bi)) THEN CONTINUE
        MAPPUT(besucht, STR$(bi), 1)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(dok.blaetter[bi].bauteile) - 1
            DIM ki AS INTEGER : ki = kindIndex(dok, dok.blaetter[bi].bauteile[i])
            IF ki < 0 THEN CONTINUE
            IF ki = ziel THEN RETURN TRUE
            ARRAY_PUSH(stapel, ki)
        NEXT
    WEND
    RETURN FALSE
END FUNCTION

' Steckt irgendein Blatt mehr als einmal als Unterblatt?
FUNCTION mehrfachInstanzen(dok AS Dokument) AS BOOLEAN
    DIM gesehen AS MAP OF INTEGER
    DIM bi AS INTEGER, i AS INTEGER
    FOR bi = 0 TO LEN(dok.blaetter) - 1
        FOR i = 0 TO LEN(dok.blaetter[bi].bauteile) - 1
            DIM r AS STRING : r = dok.blaetter[bi].bauteile[i].symbolRef
            IF NOT istBlattVerweis(r) THEN CONTINUE
            IF MAPHAS(gesehen, r) THEN RETURN TRUE
            MAPPUT(gesehen, r, 1)
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

FUNCTION bauteilKlon(b AS Bauteil) AS Bauteil
    DIM c AS Bauteil : c = NEW Bauteil(b.symbolRef, b.lage)
    c.id = b.id
    c.sym = b.sym
    c.referenz = b.referenz
    c.wert = b.wert
    c.gehaeuse = b.gehaeuse
    c.bestellnr = b.bestellnr
    c.refVersatz = b.refVersatz
    c.wertVersatz = b.wertVersatz
    c.instanzRefs = b.instanzRefs
    RETURN c
END FUNCTION

' Huelle eines Blatts: eigene Bauteil-Liste, Draehte/Labels/Busse geteilt
FUNCTION blattHuelle(bl AS Blatt, quelle AS INTEGER) AS Blatt
    DIM h AS Blatt : h = NEW Blatt(bl.name)
    h.id = bl.id
    h.breite = bl.breite
    h.hoehe = bl.hoehe
    h.bauteile = ARRAY_COPY(bl.bauteile)
    h.draehte = bl.draehte
    h.knoten = bl.knoten
    h.labels = bl.labels
    h.busse = bl.busse
    h.quelle = quelle
    h.erste = bl.erste
    RETURN h
END FUNCTION

' Referenz eines Bauteils in einer weiteren Instanz (Nummer n)
FUNCTION instanzReferenz$(b AS Bauteil, pfad AS STRING, n AS INTEGER) AS STRING
    IF MAPHAS(b.instanzRefs, pfad) THEN RETURN MAPGET(b.instanzRefs, pfad)
    IF b.referenz = "" THEN RETURN ""
    RETURN b.referenz + "_" + STR$(n)
END FUNCTION

FUNCTION instanzKopie(orig AS Blatt, quelle AS INTEGER, pfad AS STRING, n AS INTEGER) AS Blatt
    DIM k AS Blatt : k = blattHuelle(orig, quelle)
    k.id = orig.id + "@" + pfad
    k.name = orig.name + " (" + STR$(n) + ")"
    k.instanz = pfad
    k.bauteile = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(orig.bauteile) - 1
        DIM b AS Bauteil : b = orig.bauteile[i]
        DIM c AS Bauteil : c = bauteilKlon(b)
        c.id = b.id + "@" + pfad
        c.vorlageId = b.id
        c.instanz = pfad
        IF NOT istBlattVerweis(b.symbolRef) THEN c.referenz = instanzReferenz$(b, pfad, n)
        ARRAY_PUSH(k.bauteile, c)
    NEXT
    RETURN k
END FUNCTION

SUB flachAbsteigen(dok AS Dokument, f AS Dokument, fi AS INTEGER, pfad AS STRING, BYREF zaehler AS MAP OF INTEGER, tiefe AS INTEGER, kette AS STRING)
    IF tiefe > LEN(dok.blaetter) THEN RETURN          ' Zyklus: meldet der ERC
    DIM bl AS Blatt : bl = f.blaetter[fi]
    DIM j AS INTEGER
    FOR j = 0 TO LEN(bl.bauteile) - 1
        DIM b AS Bauteil : b = bl.bauteile[j]
        IF NOT istBlattVerweis(b.symbolRef) THEN CONTINUE
        DIM ki AS INTEGER : ki = blattIndexMitId(dok, MID$(b.symbolRef, LEN(BLATT_VORSATZ)))
        IF ki < 0 THEN CONTINUE
        ' ein Kreis (das Blatt liegt schon auf dem Weg): nicht ausrollen, der ERC meldet ihn
        IF CONTAINS(kette, "," + STR$(ki) + ",") THEN CONTINUE
        DIM vid AS STRING : vid = IIF(b.vorlageId <> "", b.vorlageId, b.id)
        DIM kp AS STRING : kp = pfad + "/" + vid
        DIM n AS INTEGER : n = MAPGETOR(zaehler, STR$(ki), 0) + 1
        MAPPUT(zaehler, STR$(ki), n)
        IF NOT MAPHAS(f.nummern, vid) THEN MAPPUT(f.nummern, vid, n)
        IF n = 1 THEN
            f.blaetter[ki].instanz = kp
            flachAbsteigen(dok, f, ki, kp, zaehler, tiefe + 1, kette + STR$(ki) + ",")
        ELSE
            DIM kopie AS Blatt : kopie = instanzKopie(dok.blaetter[ki], ki, kp, n)
            ARRAY_PUSH(f.blaetter, kopie)
            DIM bs AS Bauteil : bs = bauteilKlon(b)
            bs.symbolRef = BLATT_VORSATZ + kopie.id
            bs.vorlageId = vid
            bl.bauteile[j] = bs
            flachAbsteigen(dok, f, LEN(f.blaetter) - 1, kp, zaehler, tiefe + 1, kette + STR$(ki) + ",")
        END IF
    NEXT
END SUB

' Die ausgerollte Sicht (siehe oben). Ohne Mehrfach-Instanz: das Dokument selbst.
' Reihenfolge: zuerst die Originalblaetter (= erste Instanzen) an ihren
' Indizes, danach die weiteren Instanzen -- ein Blattindex des Originals
' gilt so auch in der ausgerollten Sicht.
FUNCTION flach(dok AS Dokument) AS Dokument
    IF NOT mehrfachInstanzen(dok) THEN RETURN dok
    DIM f AS Dokument : f = NEW Dokument()
    f.id = dok.id
    f.titel = dok.titel
    f.autor = dok.autor
    f.revision = dok.revision
    f.firma = dok.firma
    f.platine = dok.platine
    f.blaetter = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(dok.blaetter) - 1
        ARRAY_PUSH(f.blaetter, blattHuelle(dok.blaetter[i], i))
    NEXT
    DIM zaehler AS MAP OF INTEGER
    FOR i = 0 TO LEN(dok.blaetter) - 1
        IF elternVon(dok, i) < 0 THEN flachAbsteigen(dok, f, i, "", zaehler, 0, "," + STR$(i) + ",")
    NEXT
    RETURN f
END FUNCTION

' Alle Instanzpfade je Blatt-Id, in der Reihenfolge von flach (die erste = die,
' die das Original stellt). Auch fuer Blaetter, die nur einmal stecken.
SUB pfadeSammeln(dok AS Dokument, bi AS INTEGER, pfad AS STRING, kette AS STRING, BYREF pfade AS MAP OF STRING, tiefe AS INTEGER)
    IF tiefe > LEN(dok.blaetter) THEN RETURN
    DIM j AS INTEGER
    FOR j = 0 TO LEN(dok.blaetter[bi].bauteile) - 1
        DIM b AS Bauteil : b = dok.blaetter[bi].bauteile[j]
        DIM ki AS INTEGER : ki = kindIndex(dok, b)
        IF ki < 0 THEN CONTINUE
        IF CONTAINS(kette, "," + STR$(ki) + ",") THEN CONTINUE
        DIM kp AS STRING : kp = pfad + "/" + b.id
        DIM schl AS STRING : schl = dok.blaetter[ki].id
        MAPPUT(pfade, schl, MAPGETOR(pfade, schl, "") + kp + CHR$(10))
        pfadeSammeln(dok, ki, kp, kette + STR$(ki) + ",", pfade, tiefe + 1)
    NEXT
END SUB

FUNCTION instanzPfade(dok AS Dokument) AS MAP OF STRING
    DIM pfade AS MAP OF STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(dok.blaetter) - 1
        IF elternVon(dok, i) < 0 THEN pfadeSammeln(dok, i, "", "," + STR$(i) + ",", pfade, 0)
    NEXT
    RETURN pfade
END FUNCTION

' Die erste Instanz stellt das Original (Ids, Referenzen). Faellt sie weg
' (Blattsymbol geloescht, ausgeschnitten und eingefuegt) oder rueckt eine
' andere nach vorn, uebernimmt die neue erste ihre EIGENEN Referenzen und
' Platinen-Plaetze -- sonst stuende sie mit denen der alten da. Nach jeder
' Aenderung aufrufen (die Oberflaeche tut es in geaendert(), Laden auch).
SUB instanzenPflegen(dok AS Dokument)
    DIM pfade AS MAP OF STRING : pfade = instanzPfade(dok)
    DIM bi AS INTEGER, i AS INTEGER, k AS INTEGER
    FOR bi = 0 TO LEN(dok.blaetter) - 1
        DIM bl AS Blatt : bl = dok.blaetter[bi]
        DIM liste AS ARRAY OF STRING : liste = []
        DIM roh AS ARRAY OF STRING : roh = SPLIT$(MAPGETOR(pfade, bl.id, ""), CHR$(10))
        FOR i = 0 TO LEN(roh) - 1
            IF roh[i] <> "" THEN ARRAY_PUSH(liste, roh[i])
        NEXT
        IF LEN(liste) = 0 THEN
            bl.erste = ""
            CONTINUE
        END IF
        DIM neu AS STRING : neu = liste[0]
        DIM gilt AS MAP OF INTEGER
        gilt = {}                         ' je Blatt frisch (DIM in der Schleife tut es nicht)
        FOR i = 0 TO LEN(liste) - 1
            MAPPUT(gilt, liste[i], 1)
        NEXT
        IF bl.erste <> "" AND bl.erste <> neu THEN
            DIM altDa AS BOOLEAN : altDa = MAPHAS(gilt, bl.erste)
            FOR i = 0 TO LEN(bl.bauteile) - 1
                DIM b AS Bauteil : b = bl.bauteile[i]
                IF istBlattVerweis(b.symbolRef) THEN CONTINUE
                ' hat die neue erste eigene Platinen-Plaetze?
                DIM eigene AS BOOLEAN : eigene = FALSE
                FOR k = 0 TO LEN(dok.platine.teile) - 1
                    IF dok.platine.teile[k].bauteilId = b.id + "@" + neu THEN eigene = TRUE
                NEXT
                DIM neueTeile AS ARRAY OF PlatTeil : neueTeile = []
                FOR k = 0 TO LEN(dok.platine.teile) - 1
                    DIM t AS PlatTeil : t = dok.platine.teile[k]
                    IF t.bauteilId = b.id AND eigene THEN
                        ' der Platz der alten ersten: bleibt bei ihr oder geht mit ihr
                        IF NOT altDa THEN CONTINUE
                        t.bauteilId = b.id + "@" + bl.erste
                    ELSEIF t.bauteilId = b.id + "@" + neu THEN
                        t.bauteilId = b.id
                    END IF
                    ARRAY_PUSH(neueTeile, t)
                NEXT
                dok.platine.teile = neueTeile
                ' Referenzen tauschen
                IF MAPHAS(b.instanzRefs, neu) THEN
                    IF altDa THEN MAPPUT(b.instanzRefs, bl.erste, b.referenz)
                    b.referenz = MAPGET(b.instanzRefs, neu)
                    MAPREMOVE(b.instanzRefs, neu)
                ELSEIF altDa THEN
                    MAPPUT(b.instanzRefs, bl.erste, b.referenz)
                END IF
            NEXT
        END IF
        bl.erste = neu
        ' Referenzen weggefallener Instanzen vergessen
        FOR i = 0 TO LEN(bl.bauteile) - 1
            DIM schl AS ARRAY OF STRING : schl = MAPKEYS(bl.bauteile[i].instanzRefs)
            FOR k = 0 TO LEN(schl) - 1
                IF NOT MAPHAS(gilt, schl[k]) OR schl[k] = neu THEN MAPREMOVE(bl.bauteile[i].instanzRefs, schl[k])
            NEXT
        NEXT
    NEXT
END SUB

' Index des Blatts einer Instanz in der ausgerollten Sicht (sonst das Original)
FUNCTION flachIndex(f AS Dokument, bi AS INTEGER, pfad AS STRING) AS INTEGER
    DIM i AS INTEGER
    IF pfad <> "" THEN
        FOR i = 0 TO LEN(f.blaetter) - 1
            IF f.blaetter[i].instanz = pfad AND (f.blaetter[i].quelle = bi OR i = bi) THEN RETURN i
        NEXT
    END IF
    RETURN bi
END FUNCTION

' Alle Instanzpfade eines Blatts in ihrer Reihenfolge (leer: nicht mehrfach)
FUNCTION instanzenVon(f AS Dokument, bi AS INTEGER) AS ARRAY OF STRING
    DIM r AS ARRAY OF STRING : r = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(f.blaetter) - 1
        IF (i = bi OR f.blaetter[i].quelle = bi) AND f.blaetter[i].instanz <> "" THEN
            IF i = bi OR i >= 0 THEN ARRAY_PUSH(r, f.blaetter[i].instanz)
        END IF
    NEXT
    IF LEN(r) < 2 THEN RETURN []
    RETURN r
END FUNCTION

' Ports mit den hierarchischen Labels der Unterblaetter verbinden.
SUB portsVerbinden(dok AS Dokument, n AS Netze)
    DIM bi AS INTEGER, i AS INTEGER, j AS INTEGER, k AS INTEGER
    FOR bi = 0 TO LEN(dok.blaetter) - 1
        FOR i = 0 TO LEN(dok.blaetter[bi].bauteile) - 1
            DIM b AS Bauteil : b = dok.blaetter[bi].bauteile[i]
            IF NOT b.sym.blattSymbol OR b.sym.fehlt THEN CONTINUE
            DIM ki AS INTEGER : ki = kindIndex(dok, b)
            IF ki < 0 THEN CONTINUE
            FOR j = 0 TO LEN(b.sym.pins) - 1
                IF istBusName(b.sym.pins[j].name) THEN
                    ' Bus-Port: jedes Mitglied ueber seinen Namen
                    DIM bpp AS Punkt : bpp = b.pinPunkt(j)
                    busPortVerbinden(dok, n, bi, ki, b.sym.pins[j].name, bpp.x, bpp.y)
                    CONTINUE
                END IF
                DIM pp AS Punkt : pp = b.pinPunkt(j)
                n.blattWaehlen(bi)
                DIM pidx AS INTEGER : pidx = n.punkt(pp.x, pp.y)
                n.blattWaehlen(ki)
                FOR k = 0 TO LEN(dok.blaetter[ki].labels) - 1
                    DIM la AS Label : la = dok.blaetter[ki].labels[k]
                    IF la.art = LA_HIER AND la.text = b.sym.pins[j].name THEN n.eins(pidx, n.punkt(la.anker.x, la.anker.y))
                NEXT
            NEXT
        NEXT
    NEXT
END SUB

' In welchem Blatt steckt Blatt bi als Unterblatt? -1 = in keinem (Wurzel).
FUNCTION elternVon(dok AS Dokument, bi AS INTEGER) AS INTEGER
    DIM ei AS INTEGER, i AS INTEGER
    FOR ei = 0 TO LEN(dok.blaetter) - 1
        FOR i = 0 TO LEN(dok.blaetter[ei].bauteile) - 1
            IF kindIndex(dok, dok.blaetter[ei].bauteile[i]) = bi THEN RETURN ei
        NEXT
    NEXT
    RETURN -1
END FUNCTION

' "Haupt > Netzteil > Regler" -- hoechstens so tief, wie es Blaetter gibt
' (ein Zyklus haengt sonst; den meldet der ERC).
FUNCTION blattPfad$(dok AS Dokument, bi AS INTEGER) AS STRING
    DIM t AS STRING : t = dok.blaetter[bi].name
    DIM e AS INTEGER : e = elternVon(dok, bi)
    DIM schritte AS INTEGER : schritte = 0
    WHILE e >= 0 AND schritte < LEN(dok.blaetter)
        t = dok.blaetter[e].name + " > " + t
        e = elternVon(dok, e)
        schritte = schritte + 1
    WEND
    RETURN t
END FUNCTION

' ERC der Hierarchie: mehrfach eingesetzt, Zyklus, fehlendes Unterblatt,
' hierarchische Labels auf einem Blatt, das nirgends eingesetzt ist.
SUB ercHierarchie(dok AS Dokument, BYREF fehler AS ARRAY OF Verstoss, BYREF warnungen AS ARRAY OF Verstoss)
    DIM bi AS INTEGER, i AS INTEGER
    DIM wie AS MAP OF INTEGER
    FOR bi = 0 TO LEN(dok.blaetter) - 1
        FOR i = 0 TO LEN(dok.blaetter[bi].bauteile) - 1
            DIM b AS Bauteil : b = dok.blaetter[bi].bauteile[i]
            IF NOT istBlattVerweis(b.symbolRef) THEN CONTINUE
            DIM ki AS INTEGER : ki = kindIndex(dok, b)
            IF ki < 0 THEN
                ARRAY_PUSH(fehler, NEW Verstoss(ERC_FEHLER, "Unterblatt fehlt -- das Blatt wurde geloescht (Blattsymbol " + b.referenz + ")", bi, b.lage.pos.x, b.lage.pos.y))
                CONTINUE
            END IF
            DIM k AS STRING : k = STR$(ki)
            MAPPUT(wie, k, MAPGETOR(wie, k, 0) + 1)
            IF ki = bi THEN ARRAY_PUSH(fehler, NEW Verstoss(ERC_FEHLER, "Blatt " + dok.blaetter[bi].name + " enthaelt sich selbst als Unterblatt", bi, b.lage.pos.x, b.lage.pos.y))
            IF ki <> bi AND blattEnthaelt(dok, ki, bi) THEN ARRAY_PUSH(fehler, NEW Verstoss(ERC_FEHLER, "Blatt " + dok.blaetter[ki].name + " enthaelt (ueber Ecken) " + dok.blaetter[bi].name + ", in dem es selbst steckt -- ein Kreis", bi, b.lage.pos.x, b.lage.pos.y))
        NEXT
    NEXT
    ' hierarchische Labels auf einem Wurzelblatt verbinden nichts
    FOR bi = 0 TO LEN(dok.blaetter) - 1
        IF elternVon(dok, bi) >= 0 THEN CONTINUE
        FOR i = 0 TO LEN(dok.blaetter[bi].labels) - 1
            DIM la AS Label : la = dok.blaetter[bi].labels[i]
            IF la.art = LA_HIER THEN ARRAY_PUSH(warnungen, NEW Verstoss(ERC_WARNUNG, "Hierarchisches Label " + la.text + ": das Blatt " + dok.blaetter[bi].name + " ist nirgends als Unterblatt eingesetzt", bi, la.anker.x, la.anker.y))
        NEXT
    NEXT
END SUB
