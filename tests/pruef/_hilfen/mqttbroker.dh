' Ein MQTT-3.1.1-Broker fuer modules_mqtt.dhtest, in Drachenhauch und ohne
' Code mit dem Rust-Client zu teilen -- gerade gross genug fuer einen Rundweg:
' CONNECT -> CONNACK, PINGREQ -> PINGRESP, SUBSCRIBE -> SUBACK (mit dem
' angefragten QoS), UNSUBSCRIBE -> UNSUBACK, jedes PUBLISH geht an denselben
' Client zurueck (QoS 1 mit PUBACK vorweg und zurueck mit Nummer 77),
' DISCONNECT beendet. Eine Verbindung.
' Aufruf: dhrt run mqttbroker.dh -- PORTDATEI [stumm|ohneack]
' Das CONNECT-Paket landet als Hex in PORTDATEI.connect (fuer den letzten
' Willen), die Art jedes empfangenen Pakets als Zeile in PORTDATEI.log
' (1 CONNECT, 3 PUBLISH/QoS, 4 PUBACK, 8 SUBSCRIBE, 10 UNSUBSCRIBE ...).
' Mit `stumm` beantwortet er keine PINGREQ -- so sieht ein Broker aus, der
' ohne Abmeldung verschwunden ist (Strom weg, kein RST). Mit `ohneack`
' bestaetigt er kein PUBLISH.
' Nach 30 s ohne Verbindung beendet er sich selbst.
IMPORT "net"

DIM lst AS NET_LISTENER : lst = NET_TCP_LISTEN(0, "127.0.0.1")
WRITEALL(ARG$(0), STR$(NET_LISTENER_PORT(lst)))

DIM c AS NET_SOCKET
DIM t0 AS INTEGER : t0 = MILLIS()
c = NET_TCP_ACCEPT(lst)
WHILE c = NIL
    IF MILLIS() - t0 > 30000 THEN EXIT(0)
    SLEEP(5)
    c = NET_TCP_ACCEPT(lst)
WEND

DIM puf AS BUFFER : puf = BUFFER_NEW(0)

FUNCTION bytes(a AS INTEGER, b AS INTEGER, c3 AS INTEGER, d AS INTEGER, n AS INTEGER) AS BUFFER
    ' Die ersten n der vier Bytes als Puffer.
    DIM p AS BUFFER : p = BUFFER_NEW(n)
    IF n > 0 THEN BUFFER_SET(p, 0, a)
    IF n > 1 THEN BUFFER_SET(p, 1, b)
    IF n > 2 THEN BUFFER_SET(p, 2, c3)
    IF n > 3 THEN BUFFER_SET(p, 3, d)
    RETURN p
END FUNCTION

FUNCTION kopflaenge(p AS BUFFER) AS INTEGER
    ' Laenge des festen Kopfs (Typbyte + Restlaenge, 7 Bit je Byte);
    ' -1, wenn die Restlaenge noch nicht vollstaendig da ist.
    DIM i AS INTEGER : i = 1
    WHILE i < BUFFER_LEN(p)
        IF (BUFFER_GET(p, i) BAND 128) = 0 THEN RETURN i + 1
        i = i + 1
    WEND
    RETURN -1
END FUNCTION

FUNCTION restlaenge(p AS BUFFER) AS INTEGER
    DIM wert AS INTEGER : wert = 0
    DIM faktor AS INTEGER : faktor = 1
    DIM i AS INTEGER : i = 1
    WHILE i < BUFFER_LEN(p)
        DIM b AS INTEGER : b = BUFFER_GET(p, i)
        wert = wert + (b BAND 127) * faktor
        faktor = faktor * 128
        IF (b BAND 128) = 0 THEN RETURN wert
        i = i + 1
    WEND
    RETURN -1
END FUNCTION

FUNCTION paket() AS BUFFER
    ' Das naechste vollstaendige Paket; ein leerer Puffer, wenn die
    ' Verbindung weg ist.
    DIM t AS INTEGER : t = MILLIS()
    WHILE MILLIS() - t < 15000
        IF BUFFER_LEN(puf) >= 2 THEN
            DIM kl AS INTEGER : kl = kopflaenge(puf)
            IF kl > 0 THEN
                DIM ganz AS INTEGER : ganz = kl + restlaenge(puf)
                IF BUFFER_LEN(puf) >= ganz THEN
                    DIM p AS BUFFER : p = BUFFER_SLICE(puf, 0, ganz)
                    puf = BUFFER_SLICE(puf, ganz, BUFFER_LEN(puf))
                    RETURN p
                END IF
            END IF
        END IF
        DIM neu AS BUFFER : neu = NET_RECV_BYTES(c, 65536)
        IF BUFFER_LEN(neu) > 0 THEN
            puf = BUFFER_CONCAT(puf, neu)
        ELSEIF NOT NET_IS_CONNECTED(c) THEN
            RETURN BUFFER_NEW(0)
        ELSE
            SLEEP(2)
        END IF
    WEND
    RETURN BUFFER_NEW(0)
END FUNCTION

DIM p AS BUFFER : p = paket()
IF BUFFER_LEN(p) = 0 THEN EXIT(0)
WRITEALL(ARG$(0) + ".connect", BUFFER_TO_HEX$(p))
DIM modus AS STRING : modus = ""
IF ARGC() > 1 THEN modus = ARG$(1)
DIM stumm AS BOOLEAN : stumm = modus = "stumm"
DIM protokoll AS STRING : protokoll = ""

SUB merken(z AS STRING)
    protokoll = protokoll + z + CHR$(10)
    WRITEALL(ARG$(0) + ".log", protokoll)
END SUB
' CONNECT: der Inhalt ist hier gleich -- angenommen.
NET_SEND(c, bytes(&H20, 2, 0, 0, 4))
WHILE TRUE
    p = paket()
    IF BUFFER_LEN(p) = 0 THEN BREAK
    DIM art AS INTEGER : art = BUFFER_GET(p, 0) SHR 4
    DIM kl AS INTEGER : kl = kopflaenge(p)
    DIM qos AS INTEGER : qos = (BUFFER_GET(p, 0) SHR 1) BAND 3
    IF art = 3 THEN
        merken("3/" + STR$(qos))
    ELSEIF art = 4 THEN
        merken("4/" + STR$(BUFFER_GET(p, kl) * 256 + BUFFER_GET(p, kl + 1)))
    ELSEIF art = 8 THEN
        merken("8/" + STR$(BUFFER_GET(p, BUFFER_LEN(p) - 1)))
    ELSE
        merken(STR$(art))
    END IF
    IF art = 12 THEN
        IF NOT stumm THEN NET_SEND(c, bytes(&HD0, 0, 0, 0, 2))
    ELSEIF art = 8 THEN
        ' SUBACK mit der Paketnummer aus dem SUBSCRIBE und dem angefragten
        ' QoS (letztes Byte des SUBSCRIBE) als Rueckgabecode.
        DIM sa AS BUFFER : sa = bytes(&H90, 3, BUFFER_GET(p, kl), BUFFER_GET(p, kl + 1), 5)
        BUFFER_SET(sa, 4, BUFFER_GET(p, BUFFER_LEN(p) - 1))
        NET_SEND(c, sa)
    ELSEIF art = 10 THEN
        NET_SEND(c, bytes(&HB0, 2, BUFFER_GET(p, kl), BUFFER_GET(p, kl + 1), 4))
    ELSEIF art = 3 AND qos = 0 THEN
        ' Zurueck an den Absender, als QoS-0-PUBLISH
        BUFFER_SET(p, 0, &H30)
        NET_SEND(c, p)
    ELSEIF art = 3 THEN
        ' QoS 1: Topic, dann die Paketnummer -- erst bestaetigen, dann mit
        ' Nummer 77 zurueck (QoS 1, also muss der Client bestaetigen).
        DIM tl AS INTEGER : tl = BUFFER_GET(p, kl) * 256 + BUFFER_GET(p, kl + 1)
        DIM idpos AS INTEGER : idpos = kl + 2 + tl
        IF modus <> "ohneack" THEN
            NET_SEND(c, bytes(&H40, 2, BUFFER_GET(p, idpos), BUFFER_GET(p, idpos + 1), 4))
        END IF
        BUFFER_SET(p, 0, &H32)
        BUFFER_SET(p, idpos, 0)
        BUFFER_SET(p, idpos + 1, 77)
        NET_SEND(c, p)
    ELSEIF art = 14 THEN
        BREAK
    END IF
WEND
NET_CLOSE(c)
EXIT(0)
