=== jede nachricht hat datum und kennung
IMPORT "smtp"
IMPORT "mime_leser.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_FROM(m, "ich@beispiel.de")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Test")
SMTP_TEXT(m, "Hallo")
DIM n AS STRING : n = SMTP_MESSAGE$(m)
' RFC 5322: "Mon, 14 Sep 2026 16:18:41 +0000"
PRINT REGEX_TEST(mimeKopf$(n, "Date"), "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun), \d{1,2} (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) \d{4} \d{2}:\d{2}:\d{2} [+-]\d{4}$")
DIM id AS STRING : id = mimeKopf$(n, "Message-ID")
PRINT LEFT$(id, 1) = "<" AND RIGHT$(id, 13) = "@beispiel.de>"
--- datei mime_leser.dh
IMPORT "{sammlung}/_hilfen/mime.dh"

--- erwartet
TRUE
TRUE

=== senden gegen einen echten server
IMPORT "smtp"
IMPORT "mime_leser.dh"
IMPORT "gegen.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_SERVER(m, "127.0.0.1", starten("AUTH PLAIN LOGIN", "1", "1"), "keine")
SMTP_FROM(m, "ich@beispiel.de", "Abteilung Zahlen")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Auswertung August")
SMTP_TEXT(m, "Anbei die Zahlen.")
SMTP_SEND(m)
PRINT "raus"
PRINT befehl("MAIL FROM:<ich@beispiel.de>")
PRINT befehl("RCPT TO:<du@beispiel.de>")
PRINT befehl("DATA"); " "; befehl("QUIT")
DIM d AS STRING : d = daten$()
PRINT mimeKopf$(d, "Subject")
PRINT BUFFER_TO_STRING$(mimeInhalt(d))
beenden()
--- datei mime_leser.dh
IMPORT "{sammlung}/_hilfen/mime.dh"

--- datei gegen.dh
IMPORT "{sammlung}/_hilfen/smtpstart.dh"

--- argumente
{sammlung}/_hilfen/smtpserver.dh
--- erwartet
raus
TRUE
TRUE
TRUE TRUE
Auswertung August
Anbei die Zahlen.

=== die blindkopie steht im umschlag
IMPORT "smtp"
IMPORT "gegen.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_SERVER(m, "127.0.0.1", starten("AUTH PLAIN LOGIN", "1", "1"), "keine")
SMTP_FROM(m, "ich@beispiel.de", "Abteilung Zahlen")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Auswertung August")
SMTP_TEXT(m, "Anbei die Zahlen.")
SMTP_BCC(m, "heimlich@beispiel.de")
SMTP_SEND(m)
PRINT befehl("RCPT TO:<heimlich@beispiel.de>")
' In der Nachricht selbst darf sie nicht stehen.
PRINT LEN(daten$()) > 0 AND INSTR(daten$(), "heimlich") < 0
beenden()
