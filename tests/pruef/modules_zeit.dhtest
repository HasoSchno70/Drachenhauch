' Aus test_modules_zeit.py uebertragen (41 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== parse und text sind umkehrbar
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PARSE("2026-08-28 20:30:00"))
--- erwartet
2026-08-28 20:30:00

=== parse versteht die ueblichen schreibweisen[2026-08-28 20:30:00-2026-08-28 20:30:00]
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PARSE("2026-08-28 20:30:00"))
--- erwartet
2026-08-28 20:30:00

=== parse versteht die ueblichen schreibweisen[2026-08-28T20:30:00-2026-08-28 20:30:00]
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PARSE("2026-08-28T20:30:00"))
--- erwartet
2026-08-28 20:30:00

=== parse versteht die ueblichen schreibweisen[2026-08-28 20:30-2026-08-28 20:30:00]
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PARSE("2026-08-28 20:30"))
--- erwartet
2026-08-28 20:30:00

=== parse versteht die ueblichen schreibweisen[2026-08-28-2026-08-28 00:00:00]
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PARSE("2026-08-28"))
--- erwartet
2026-08-28 00:00:00

=== parse versteht die ueblichen schreibweisen[2026-08-28T20:30:00Z-2026-08-28 20:30:00]
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PARSE("2026-08-28T20:30:00Z"))
--- erwartet
2026-08-28 20:30:00

=== parse meldet unlesbares im klartext
IMPORT "zeit"
PRINT ZEIT_PARSE("naechsten Dienstag")
--- fehler
ZEIT_PARSE: 'naechsten Dienstag' ist kein Zeitpunkt -- erwartet 'JJJJ-MM-TT hh:mm:ss' (auch mit T, ohne Sekunden oder nur Datum)

=== parse lehnt unmoegliche daten ab (1)
IMPORT "zeit"
PRINT ZEIT_PARSE("2026-02-30")
--- fehler
ZEIT_PARSE: '2026-02-30' ist kein Zeitpunkt -- erwartet 'JJJJ-MM-TT hh:mm:ss' (auch mit T, ohne Sekunden oder nur Datum)

=== parse lehnt unmoegliche daten ab (2)
IMPORT "zeit"
PRINT ZEIT_PARSE("2026-13-01")
--- fehler
ZEIT_PARSE: '2026-13-01' ist kein Zeitpunkt -- erwartet 'JJJJ-MM-TT hh:mm:ss' (auch mit T, ohne Sekunden oder nur Datum)

=== parse lehnt unmoegliche daten ab (3)
IMPORT "zeit"
PRINT ZEIT_PARSE("2026-08-28 25:00:00")
--- fehler
ZEIT_PARSE: '2026-08-28 25:00:00' ist kein Zeitpunkt -- erwartet 'JJJJ-MM-TT hh:mm:ss' (auch mit T, ohne Sekunden oder nur Datum)

=== lesbar fragt nach statt abzubrechen
IMPORT "zeit"
PRINT ZEIT_LESBAR("2026-08-28 20:30:00")
PRINT ZEIT_LESBAR("naechsten Dienstag")
--- erwartet
TRUE
FALSE

=== tippschluss ist anstoss minus 15 minuten
IMPORT "zeit"
DIM a AS INTEGER : a = ZEIT_PARSE("2026-08-28 20:30:00")
PRINT ZEIT_TEXT$(ZEIT_PLUS(a, -15 * 60))
--- erwartet
2026-08-28 20:15:00

=== plus geht ueber alle grenzen[2026-08-28 00:10:00--1200-2026-08-27 23:50:00]
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PLUS(ZEIT_PARSE("2026-08-28 00:10:00"), -1200))
--- erwartet
2026-08-27 23:50:00

=== plus geht ueber alle grenzen[2026-08-31 12:00:00-86400-2026-09-01 12:00:00]
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PLUS(ZEIT_PARSE("2026-08-31 12:00:00"), 86400))
--- erwartet
2026-09-01 12:00:00

=== plus geht ueber alle grenzen[2026-12-31 23:00:00-3600-2027-01-01 00:00:00]
IMPORT "zeit"
PRINT ZEIT_TEXT$(ZEIT_PLUS(ZEIT_PARSE("2026-12-31 23:00:00"), 3600))
--- erwartet
2027-01-01 00:00:00

