=== der platzhalter steht da, solange nichts gewaehlt ist
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM mit AS GUI_WIDGET : mit = GUI_DROPDOWN(w, 10, 10, 190, 28, ["a", "b"])
GUI_DROPDOWN_SET_SELECTED(mit, -1)
GUI_DROPDOWN_PLACEHOLDER(mit, "Bitte waehlen")
DIM ohne AS GUI_WIDGET : ohne = GUI_DROPDOWN(w, 10, 60, 190, 28, ["a", "b"])
GUI_DROPDOWN_SET_SELECTED(ohne, -1)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
    IF bild = 3 THEN SAVESCREENSHOT("t.png")
WEND
DIM b AS IMAGE : b = LOADIMAGE("t.png")
FUNCTION punkte(y0 AS INTEGER) AS INTEGER
    DIM n AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = y0 + 6 TO y0 + 22
        FOR x = 20 TO 150
            IF GETPIXEL(b, x, y) <> GETPIXEL(b, 160, y0 + 14) THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
PRINT "mit "; punkte(10) > 20; " ohne "; punkte(60) > 20
--- umgebung
DHRT_FRAMES=5
--- erwartet
mit TRUE ohne FALSE
