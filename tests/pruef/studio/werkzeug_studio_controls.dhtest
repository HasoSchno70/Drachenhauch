{"kind":"studio_control","studio_control":"Zaehler","name":"zaehler1","x":40,"y":40,"w":240,"h":50,"studio_werte":"Ziel = 2; Vorsatz = \"Erste: \"; Unbekannt = 7"},
{"kind":"studio_control","studio_control":"Zaehler","name":"zaehler2","x":40,"y":120,"w":240,"h":50,"studio_werte":"Ziel = drei"}]}
--- datei proj/Hauptfenster.dh
CLASS Hauptfenster EXTENDS Hauptfenster_Basis
    SUB zaehler1_Erreicht()
        PRINT "erreicht 1 " + GUI_TEXT(Self.zaehler1.anzeige)
    END SUB

    SUB zaehler2_Erreicht()
        PRINT "erreicht 2"
    END SUB
END CLASS
--- datei proj/App.dh
CLASS App EXTENDS StudioApp
END CLASS
