           STR$(GETALPHA(ebene[0, 0], gw - 1, gh - 1)) + " " + STR$(GETALPHA(ebene[0, 0], 0, gh - 1))
END FUNCTION
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
SUB prFall()
    DIM t AS INTEGER
    t = 1 + prStrich(1, 8, 0, 32) + 2
    prTaste(t, 81)
    t = t + 3 + prDreieck(t + 3) + 2
    prTaste(t, 261)
    prAbspielen()
END SUB
SUB prProbe(k AS INTEGER)
    IF k >= 69 THEN
        prZaehlen()
        prSchreib("auswahl steht " + prJa$(selN > 100) + " innen leer " + prJa$(prD = prG) + " aussen steht " + prJa$(prG >= 15 AND prG < 32))
    END IF
END SUB
