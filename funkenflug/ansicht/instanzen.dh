' Mehrfach eingesetzte Unterblaetter in der Oberflaeche -- globaler Namensraum.
'
' Ein Blatt wird einmal gezeichnet, steckt aber vielleicht mehrmals im
' Schaltplan. Welche Instanz man gerade ansieht, sagt gInstanzPfad (Kette der
' Blattsymbol-Ids, "" = die erste): Referenzen, Netznamen in der Statuszeile,
' ERC-Marker und Hervorhebung zeigen DIESE Instanz. Man kommt hinein ueber
' den Doppelklick aufs Blattsymbol (genau diese Instanz) oder wechselt mit
' "Blatt > Naechste Instanz" (Taste I).

DIM gInstanzPfad AS STRING
DIM gFlachGueltig AS BOOLEAN
DIM gFlach AS kern.Dokument

' Die ausgerollte Sicht des Dokuments (neu nach jeder Aenderung)
FUNCTION aktuellesFlach() AS kern.Dokument
    IF NOT gFlachGueltig THEN
        gFlach = kern.flach(gDok)
        gFlachGueltig = TRUE
    END IF
    RETURN gFlach
END FUNCTION

SUB flachVeraltet()
    gFlachGueltig = FALSE
END SUB

' Index des gezeigten Blatts in der ausgerollten Sicht (die gewaehlte Instanz)
FUNCTION aktuellerFlachIndex() AS INTEGER
    DIM bi AS INTEGER : bi = aktuellerBlattIndex()
    IF gInstanzPfad = "" THEN RETURN bi
    RETURN kern.flachIndex(aktuellesFlach(), bi, gInstanzPfad)
END FUNCTION

' Der Pfad der gezeigten Instanz ("" wenn das Blatt nicht mehrfach steckt)
FUNCTION aktuellerPfad$() AS STRING
    DIM f AS kern.Dokument : f = aktuellesFlach()
    DIM fi AS INTEGER : fi = aktuellerFlachIndex()
    IF fi < 0 OR fi >= LEN(f.blaetter) THEN RETURN ""
    RETURN f.blaetter[fi].instanz
END FUNCTION

' Die Instanzen des gezeigten Blatts (leer: es steckt nicht mehrfach)
FUNCTION aktuelleInstanzen() AS ARRAY OF STRING
    IF gDok = NIL THEN RETURN []
    RETURN kern.instanzenVon(aktuellesFlach(), aktuellerBlattIndex())
END FUNCTION

' Referenz eines Bauteils in der gezeigten Instanz
FUNCTION anzeigeRef$(b AS kern.Bauteil) AS STRING
    IF gInstanzPfad = "" THEN RETURN b.referenz
    DIM f AS kern.Dokument : f = aktuellesFlach()
    DIM fi AS INTEGER : fi = aktuellerFlachIndex()
    IF fi = aktuellerBlattIndex() OR fi >= LEN(f.blaetter) THEN RETURN b.referenz
    DIM i AS INTEGER
    DIM such AS STRING : such = b.id + "@" + gInstanzPfad
    FOR i = 0 TO LEN(f.blaetter[fi].bauteile) - 1
        IF f.blaetter[fi].bauteile[i].id = such THEN RETURN f.blaetter[fi].bauteile[i].referenz
    NEXT
    RETURN b.referenz
END FUNCTION

' Ist die gezeigte Instanz eine weitere (nicht die erste)?
FUNCTION weitereInstanz() AS BOOLEAN
    RETURN gInstanzPfad <> "" AND aktuellerFlachIndex() <> aktuellerBlattIndex()
END FUNCTION

' "Instanz 2/3" fuer die Statuszeile, "" wenn nicht mehrfach
FUNCTION instanzText$() AS STRING
    DIM l AS ARRAY OF STRING : l = aktuelleInstanzen()
    IF LEN(l) < 2 THEN RETURN ""
    DIM p AS STRING : p = aktuellerPfad$()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(l) - 1
        IF l[i] = p THEN RETURN "  Instanz " + STR$(i + 1) + "/" + STR$(LEN(l))
    NEXT
    RETURN "  Instanz 1/" + STR$(LEN(l))
END FUNCTION

' "Haupt > Kanal (2)": der Weg zur gezeigten Instanz ueber die Namen ihrer
' Blattsymbole (ohne Mehrfach-Instanz der gewohnte Blattpfad)
FUNCTION instanzPfadText$() AS STRING
    DIM p AS STRING : p = aktuellerPfad$()
    IF p = "" OR LEN(aktuelleInstanzen()) < 2 THEN RETURN kern.blattPfad$(gDok, aktuellerBlattIndex())
    DIM teile AS ARRAY OF STRING : teile = SPLIT$(p, "/")
    DIM t AS STRING : t = ""
    DIM i AS INTEGER, bi AS INTEGER, k AS INTEGER
    FOR i = 0 TO LEN(teile) - 1
        IF teile[i] = "" THEN CONTINUE
        FOR bi = 0 TO LEN(gDok.blaetter) - 1
            FOR k = 0 TO LEN(gDok.blaetter[bi].bauteile) - 1
                IF gDok.blaetter[bi].bauteile[k].id = teile[i] THEN
                    IF t = "" THEN t = gDok.blaetter[bi].name
                    t = t + " > " + gDok.blaetter[bi].bauteile[k].referenz
                END IF
            NEXT
        NEXT
    NEXT
    IF t = "" THEN RETURN kern.blattPfad$(gDok, aktuellerBlattIndex())
    RETURN t
END FUNCTION

' Ins Unterblatt eines Blattsymbols -- genau in diese Instanz
SUB instanzBetreten(b AS kern.Bauteil)
    DIM ki AS INTEGER : ki = kern.kindIndex(gDok, b)
    IF ki < 0 THEN RETURN
    DIM basis AS STRING : basis = aktuellerPfad$()
    blattWechseln(ki)
    gInstanzPfad = basis + "/" + b.id
    ' steckt es nur einmal, ist es die einzige Instanz -- Pfad nicht noetig
    IF LEN(aktuelleInstanzen()) < 2 THEN gInstanzPfad = ""
    neuZeichnen()
    statusAktualisieren()
END SUB

' Zurueck ins Elternblatt der gezeigten Instanz
SUB instanzZumEltern()
    DIM p AS STRING : p = aktuellerPfad$()
    IF p = "" THEN
        DIM e AS INTEGER : e = kern.elternVon(gDok, aktuellerBlattIndex())
        IF e >= 0 THEN blattWechseln(e)
        RETURN
    END IF
    ' letzter Abschnitt = Blattsymbol, in dessen Blatt geht es zurueck
    DIM k AS INTEGER : k = LEN(p) - 1
    WHILE k > 0
        IF MID$(p, k, 1) = "/" THEN BREAK
        k = k - 1
    WEND
    DIM bsId AS STRING : bsId = MID$(p, k + 1)
    DIM eltern AS STRING : eltern = LEFT$(p, k)
    DIM bi AS INTEGER, i AS INTEGER
    FOR bi = 0 TO LEN(gDok.blaetter) - 1
        FOR i = 0 TO LEN(gDok.blaetter[bi].bauteile) - 1
            IF gDok.blaetter[bi].bauteile[i].id = bsId THEN
                blattWechseln(bi)
                gInstanzPfad = eltern
                IF LEN(aktuelleInstanzen()) < 2 THEN gInstanzPfad = ""
                neuZeichnen()
                statusAktualisieren()
                RETURN
            END IF
        NEXT
    NEXT
END SUB

' Naechste Instanz des gezeigten Blatts
SUB instanzWechseln()
    DIM l AS ARRAY OF STRING : l = aktuelleInstanzen()
    IF LEN(l) < 2 THEN
        gSpMeldung = "Dieses Blatt steckt nur einmal im Schaltplan"
        statusAktualisieren()
        RETURN
    END IF
    DIM p AS STRING : p = aktuellerPfad$()
    DIM i AS INTEGER, k AS INTEGER
    k = 0
    FOR i = 0 TO LEN(l) - 1
        IF l[i] = p THEN k = (i + 1) MOD LEN(l)
    NEXT
    gInstanzPfad = l[k]
    gHoverAktiv = FALSE
    neuZeichnen()
    statusAktualisieren()
END SUB

' Ein vorhandenes Blatt noch einmal als Unterblatt einsetzen (eine weitere
' Instanz). Nicht sich selbst und nicht ein Blatt, in dem das aktuelle steckt.
SUB blattErneutEinsetzen()
    DIM vorschlag AS STRING : vorschlag = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gDok.blaetter) - 1
        IF i <> aktuellerBlattIndex() AND kern.elternVon(gDok, i) >= 0 THEN
            vorschlag = gDok.blaetter[i].name
            BREAK
        END IF
    NEXT
    DIM name AS STRING : name = TRIM$(textAbfrage$("Vorhandenes Blatt einsetzen", "Welches Blatt (noch eine Instanz):", vorschlag))
    IF name = "" THEN RETURN
    DIM ki AS INTEGER : ki = -1
    FOR i = 0 TO LEN(gDok.blaetter) - 1
        IF gDok.blaetter[i].name = name THEN ki = i
    NEXT
    IF ki < 0 THEN
        meldung("Ein Blatt namens " + name + " gibt es nicht.")
        RETURN
    END IF
    ' kein Zyklus: das Ziel darf das aktuelle Blatt nicht (ueber Ecken) enthalten
    DIM e AS INTEGER : e = aktuellerBlattIndex()
    DIM schritte AS INTEGER : schritte = 0
    WHILE e >= 0 AND schritte <= LEN(gDok.blaetter)
        IF e = ki THEN
            meldung("Das Blatt " + name + " enthaelt das aktuelle -- eingesetzt ergaebe es einen Kreis.")
            RETURN
        END IF
        e = kern.elternVon(gDok, e)
        schritte = schritte + 1
    WEND
    verlaufMerken()
    DIM mx AS INTEGER : mx = kern.rastern(ROUND(weltX(gtk_widget_get_allocated_width(gFlaeche) / 2.0)), kern.RASTER)
    DIM my AS INTEGER : my = kern.rastern(ROUND(weltY(gtk_widget_get_allocated_height(gFlaeche) / 2.0)), kern.RASTER)
    DIM bs AS kern.Bauteil : bs = kern.neuesBauteil(kern.BLATT_VORSATZ + gDok.blaetter[ki].id, NEW kern.Lage(NEW kern.Punkt(mx, my), 0, FALSE))
    ARRAY_PUSH(gBlatt.bauteile, bs)
    kern.blattSymboleAktualisieren(gDok)
    reiterAktualisieren()
    waehleB(bs)
    gSpMeldung = bs.referenz + " eingesetzt -- Referenzen der neuen Instanz vergibt Bearbeiten > Fehlende Referenzen"
    geaendert()
END SUB

SUB aufMenueInstanz(e AS INTEGER, d AS INTEGER)
    instanzWechseln()
END SUB

SUB aufMenueErneut(e AS INTEGER, d AS INTEGER)
    blattErneutEinsetzen()
END SUB
