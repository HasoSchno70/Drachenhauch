=== mediathek kapitel 4: was man aufnimmt und entfernt, bleibt
' Erster Lauf: Ronja ohne Jahr aufnehmen, Metropolis und Tetris
' entfernen. Zweiter Lauf (mit Argument): aus der Datei neu geladen.
prBild = prBild + 1
IF prBild = 2 AND ARGC() = 0 THEN
    aufnehmen()
    GUI_TABLE_CLEAR_SELECTION(tabelle)
    GUI_TABLE_SELECT(tabelle, 1, TRUE)
    GUI_TABLE_SELECT(tabelle, 2, TRUE)
    auswahl_entfernen()
    EXIT(0)
END IF
IF prBild = 2 THEN
    PRINT LEN(mediathek); " "; GUI_TABLE_ROW_COUNT(tabelle)
    PRINT mediathek[0].id; " "; mediathek[0].titel; " "; mediathek[0].jahr
    PRINT mediathek[1].id; " "; mediathek[1].titel
    DIM k AS INTEGER : k = LEN(mediathek) - 1
    PRINT mediathek[k].id; " "; mediathek[k].titel; " ["; mediathek[k].jahr; "]"
    EXIT(0)
END IF
