=== umschalt f10 oeffnet an der marke, ignorieren per tastatur
IMPORT "gui"
SCREEN(500, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 20, 360, 28)
GUI_SET_TEXT(tf, "da ist Hasu")
GUI_FOCUS(tf)
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic")
GUI_SPELL(tf, h)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 4 THEN PRINT "vorher "; GUI_SPELL_COUNT(tf)
    IF n = 30 THEN PRINT "nachher "; GUI_SPELL_COUNT(tf); " "; SPELL_CHECK(h, "Hasu"); " "; GUI_TEXT(tf)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
