=== create speichert nur den dateinamen
' Sonst traegt ein Archiv die Verzeichnisstruktur des Rechners nach aussen, auf dem es entstanden ist.
DIM dateien AS ARRAY OF STRING
DIM drin AS ARRAY OF STRING
dateien = SPLIT$("unterordner/beleg.txt", "|")
PRINT ZIP_CREATE("c.zip", dateien)
drin = ZIP_LIST("c.zip")
PRINT drin[0]
--- datei unterordner/beleg.txt
Inhalt
--- erwartet
1
beleg.txt

=== read als buffer
DIM namen AS ARRAY OF STRING
DIM inhalte AS ARRAY OF STRING
DIM b AS BUFFER
namen = SPLIT$("x.bin", "|")
inhalte = SPLIT$("ABC", "|")
ZIP_WRITE("d.zip", namen, inhalte)
b = ZIP_READ("d.zip", "x.bin")
PRINT BUFFER_LEN(b)
PRINT BUFFER_GET(b, 0)
--- erwartet
3
65

=== unbekannter eintrag meldet den namen
DIM namen AS ARRAY OF STRING
DIM inhalte AS ARRAY OF STRING
namen = SPLIT$("a.txt", "|")
inhalte = SPLIT$("x", "|")
ZIP_WRITE("e.zip", namen, inhalte)
PRINT ZIP_READ$("e.zip", "gibtsnicht.txt")
--- fehler
gibtsnicht

=== kaputte datei meldet klar
DIM d AS ARRAY OF STRING
d = ZIP_LIST("kaputt.zip")
--- datei kaputt.zip
das ist kein ZIP
--- fehler
kein lesbares ZIP

=== ungleich lange arrays melden
DIM namen AS ARRAY OF STRING
DIM inhalte AS ARRAY OF STRING
namen = SPLIT$("a|b", "|")
inhalte = SPLIT$("nur eins", "|")
ZIP_WRITE("f.zip", namen, inhalte)
--- fehler
gleich lang
