=== tabulator fuellt bis zur naechsten spalte
' Nicht stur vier Leerzeichen: mitten in der Zeile getippt, muss der
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 260, 120)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "ok", 10, 140, 80, 24)
GUI_FOCUS(ta)

GUI_TEXTAREA_SET(ta, "tab_fuegt_ein", 1)
GUI_TEXTAREA_SET(ta, "tabbreite", 4)
GUI_SET_TEXT(ta, "ab")
GUI_FOCUS(ta)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

PRINT "["; GUI_TEXT(ta); "]"
--- datei ev.txt
# Test-Aufnahme
c 2
e 2 2 258 0 0 0 // Event: test
e 3 1 258 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
[ab  ]

=== farbwaehler pfeil aendert die farbe
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM cp AS GUI_WIDGET
cp = GUI_COLORPICKER(w, 10, 10, 200, 150)
GUI_SET_PICKED_COLOR(cp, &HFF0000)
GUI_FOCUS(cp)
DIM vorher AS INTEGER
vorher = GUI_PICKED_COLOR(cp)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

' Pfeil links senkt die Saettigung -- Rot wird heller, nicht dunkler.
PRINT IIF(GUI_PICKED_COLOR(cp) <> vorher, "geaendert", "unveraendert")
--- datei ev.txt
# Test-Aufnahme
c 2
e 2 2 263 0 0 0 // Event: test
e 3 1 263 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
geaendert

=== farbwaehler bild ab dreht den farbton
' Die dritte Achse braucht eine eigene Taste -- die Pfeile sind für
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM cp AS GUI_WIDGET
cp = GUI_COLORPICKER(w, 10, 10, 200, 150)
GUI_SET_PICKED_COLOR(cp, &HFF0000)
GUI_FOCUS(cp)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

' Ton 0 -> 10 Grad: aus reinem Rot wird ein Rotton mit Gruenanteil.
PRINT IIF(GUI_PICKED_COLOR(cp) <> &HFF0000, "gedreht", "unveraendert")
--- datei ev.txt
# Test-Aufnahme
c 2
e 2 2 267 0 0 0 // Event: test
e 3 1 267 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
gedreht

