' Glutfaden Stufe 11: Farb-Harmonien und Muster-Bibliothek (kern/harmonie.dh,
' kern/bibliothek.dh, ansicht/sammlungdialoge.dh).
'
' Die Beilagen hat PySticky selbst aufgezeichnet: ref_harmonie.txt mit
' rgb_to_hsl, hsl_to_rgb und find_closest_thread aus color_harmony_dialog.py
' (40 Ausgangsfarben, drei Paletten); ref_bibliothek.txt mit
' _auto_categorize, den Daten wie _add_pattern_file, dem echten
' ThumbnailWidget._generate_thumbnail (auf einem Ersatz-Objekt, Massstab 2,
' 1,67, 1,01 und 0,4) und LibraryData -- library_neu.json ist das, was
' PySticky aus library_alt.json schreibt. Eine Zeile weicht mit Absicht ab:
' die Vorgabe-Kategorie heisst "Bordüren" wie die, die das Einsortieren
' vergibt (PySticky: "Bordueren").

=== harmonie: alles wie pysticky an 40 farben und drei paletten
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM ref AS STRING : ref = geLies$("ref.txt")
PRINT geAbweichungen$(ref, harmonieText$(harmonieQuellen(ref), pal))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_harmonie.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bibliothek.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
