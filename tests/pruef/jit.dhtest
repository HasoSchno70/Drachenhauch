=== schleife mit einem text bleibt in der vm
SUB lauf(start AS INTEGER)
    DIM t AS STRING
    DIM i AS INTEGER
    DIM r AS INTEGER
    r = start
    FOR i = 1 TO 50
        r = r + i
    NEXT
    PRINT r
    FOR i = 1 TO 3
        t = t + "x"
    NEXT
    PRINT t; " "; r
END SUB
