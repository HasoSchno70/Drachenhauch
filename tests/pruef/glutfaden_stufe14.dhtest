=== umordnen und sortieren behalten das bild, auch auf der gesperrten ebene; strg+z nimmt alles
IMPORT "helfer.dh"
' Das Bild: je Ebene und Zelle die GARNFARBE, Typ und erledigt, dazu die
' Rueckstiche nach Garnfarbe -- ein Plan, der nur die Reihenfolge aendert,
' darf daran nichts aendern. Die Nummern im Stand aendern sich dagegen.
FUNCTION bild$(m AS kern.Muster) AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM e AS kern.Ebene
    FOR EACH e IN m.ebenen.ebenen
        DIM i AS INTEGER
        FOR i = 0 TO LEN(e.raster) - 1
            IF e.raster[i] >= 0 THEN ARRAY_PUSH(t, STR$(i) + "=" + HEX$(m.farben[e.raster[i]].garn.farbe) + ":" + STR$(e.art[i]) + ":" + STR$(e.erledigt[i]))
        NEXT
        ARRAY_PUSH(t, "|")
    NEXT
    DIM r AS kern.Rueckstich
    FOR EACH r IN m.rueckstiche
        ARRAY_PUSH(t, STR$(r.x1) + "," + STR$(r.y1) + "," + STR$(r.x2) + "," + STR$(r.y2) + ":" + HEX$(m.farben[r.farbe].garn.farbe))
    NEXT
    RETURN JOIN$(t, " ")
END FUNCTION

FUNCTION namen$(m AS kern.Muster) AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM f AS kern.Farbeintrag
    FOR EACH f IN m.farben
        ARRAY_PUSH(t, f.garn.name)
    NEXT
    RETURN JOIN$(t, ",")
END FUNCTION

DIM gesperrt AS STRING
DIM m0 AS kern.Muster : m0 = kern.pxsLaden("farbprobe.pxs")
DIM k AS INTEGER
FOR k = 0 TO m0.ebenen.anzahl() - 1
    gesperrt = gesperrt + IIF(m0.ebenen.ebenen[k].gesperrt, "g", "-") + IIF(m0.ebenen.ebenen[k].sichtbar, "s", "-")
NEXT
PRINT "ebenen: "; gesperrt

DIM art AS INTEGER
FOR art = 0 TO 8
    DIM m AS kern.Muster : m = kern.pxsLaden("farbprobe.pxs")
    m.stichzahlenNeu()
    DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
    DIM vorher AS STRING : vorher = fvStand$(m)
    DIM bv AS STRING : bv = bild$(m)
    DIM p AS kern.Farbplan : p = kern.neuerFarbplan(m)
    IF art = 8 THEN
        ' umgekehrt, ueber Verschieben zusammengesetzt
        DIM i AS INTEGER
        FOR i = 0 TO LEN(p.folge) - 1
            kern.planVerschieben(p, LEN(p.folge) - 1, i)
        NEXT
    ELSEIF art > 0 THEN
        kern.planSortieren(m, p, art)
    END IF
    DIM ok AS BOOLEAN : ok = kern.planAnwenden(m, v, p)
    DIM nachher AS STRING : nachher = fvStand$(m)
    PRINT "art "; art; ": geaendert "; ok; " | bild gleich "; bild$(m) = bv; " | stand anders "; nachher <> vorher; " | "; namen$(m)
    ok = v.zurueckNehmen(m)
    PRINT "  zurueck: stand gleich "; fvStand$(m) = vorher; " | stichzahlen "; m.farben[0].stichzahl
    ok = v.wiederholen(m)
    PRINT "  vor: wie danach "; fvStand$(m) = nachher
NEXT
