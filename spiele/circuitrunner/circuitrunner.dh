' =====================================================================
'  CIRCUIT RUNNER  --  ein Chip's-Challenge-artiges Kachel-Puzzle
'  Sammle alle Daten-Chips, dann oeffnet der Sockel den Weg zum Ausgang.
'  Weiche Wasser/Feuer/Monstern aus, nutze Schluessel, Stiefel und Bloecke.
'
'  Steuerung:
'    Pfeile / WASD   bewegen
'    R               Level neu starten
'    N               Level ueberspringen (Entwicklung)
'    P               Passwort eingeben (Level anspringen, im Menue/Intro)
'    ESC             zurueck / Menue
'    LEER / ENTER    bestaetigen
'    T               Feind-Tempo ruhig/original (im Menue)
'
'  Fortschritt + Bestzeiten werden in  circuitrunner.save  gesichert.
'
'  Level liegen als JSON-Sets in  levels/ . Eigene Demos erzeugt
'  make_demo_levels.dh; echte Fansite-Sets (.dat/.ccl) wandelt
'  convert_dat.dh um. Tile-Codes 0x00..0x6F = Zellen in assets/tiles.png.
'
'  Start:  dhrt run circuitrunner\circuitrunner.dh       (oder F5 in der IDE)
' =====================================================================
IMPORT "json"
IMPORT "imgfx"
IMPORT "input"
IMPORT "audio"
IMPORT "save"

CONST SAVEPATH = "circuitrunner.save"

CONST FULLSCREEN = TRUE

CONST GW = 32
CONST GH = 32
CONST NCELL = 1024
CONST VIEW = 9                 ' sichtbare Kacheln je Achse

CONST TICK_MS = 120            ' eine Spielwelt-Stufe (Bewegung)

' ----- Tile-Codes (= Tileset-Zellen) ---------------------------------
CONST T_FLOOR = &H00
CONST T_WALL = &H01
CONST T_CHIP = &H02
CONST T_WATER = &H03
CONST T_FIRE = &H04
CONST T_INVWALL = &H05
CONST T_WALLN = &H06
CONST T_WALLW = &H07
CONST T_WALLS = &H08
CONST T_WALLE = &H09
CONST T_BLOCK = &H0A
CONST T_DIRT = &H0B
CONST T_ICE = &H0C
CONST T_FORCE_S = &H0D
CONST T_FORCE_N = &H12
CONST T_FORCE_E = &H13
CONST T_FORCE_W = &H14
CONST T_EXIT = &H15
CONST T_DOOR_BLUE = &H16
CONST T_DOOR_RED = &H17
CONST T_DOOR_GREEN = &H18
CONST T_DOOR_YELLOW = &H19
CONST T_ICE_NW2 = &H1A
CONST T_ICE_NE2 = &H1B
CONST T_ICE_SE2 = &H1C
CONST T_ICE_SW2 = &H1D
CONST T_BLUEBLOCK_F = &H1E
CONST T_BLUEBLOCK_W = &H1F
CONST T_THIEF = &H21
CONST T_SOCKET = &H22
CONST T_BTN_GREEN = &H23
CONST T_BTN_RED = &H24
CONST T_TOGGLE_C = &H25
CONST T_TOGGLE_O = &H26
CONST T_BTN_BROWN = &H27
CONST T_BTN_BLUE = &H28
CONST T_TELEPORT = &H29
CONST T_BOMB = &H2A
CONST T_TRAP = &H2B
CONST T_HIDDEN = &H2C
CONST T_GRAVEL = &H2D
CONST T_PASSONCE = &H2E
CONST T_HINT = &H2F
CONST T_WALL_SE = &H30
CONST T_CLONER = &H31
CONST T_FORCE_RND = &H32
CONST T_KEY_BLUE = &H64
CONST T_KEY_RED = &H65
CONST T_KEY_GREEN = &H66
CONST T_KEY_YELLOW = &H67
CONST T_FLIPPERS = &H68
CONST T_FIREBOOTS = &H69
CONST T_ICESKATES = &H6A
CONST T_SUCTION = &H6B
CONST T_CHIP_N = &H6C

' Richtungen 0=N 1=W 2=S 3=E (= CC-Codierung)
DIM dxv[4] AS INTEGER
DIM dyv[4] AS INTEGER

' ----- Weltzustand ---------------------------------------------------
DIM terr[NCELL] AS INTEGER            ' Terrain/Items/Geraete

' Monster und Bloecke sind Objekte (Klassen Monster/Kiste weiter unten,
' nach den uebrigen Globalen); hier nur die Obergrenzen.
CONST MAXMOB = 320
CONST MAXBLK = 320
DIM pushed_blk AS INTEGER          ' diesen Tick geschobener Block (kein Sofort-Rutsch)

' Geraete-Verdrahtung (Falle/Cloner): bx,by -> tx,ty
' Ein Draht verbindet einen Knopf mit dem Geraet, das er steuert.
CLASS Draht
    DIM knopf_x AS INTEGER
    DIM knopf_y AS INTEGER
    DIM ziel_x AS INTEGER
    DIM ziel_y AS INTEGER

    SUB Init(kx AS INTEGER, ky AS INTEGER, zx AS INTEGER, zy AS INTEGER)
        knopf_x = kx
        knopf_y = ky
        ziel_x = zx
        ziel_y = zy
    END SUB
END CLASS

CONST MAXWIRE = 256
DIM fallen AS ARRAY OF Draht       ' brauner Knopf -> Falle
DIM kloner AS ARRAY OF Draht       ' roter Knopf -> Kloner

' Spieler
DIM px AS INTEGER
DIM py AS INTEGER
DIM pdir AS INTEGER
DIM chips_left AS INTEGER
DIM chips_total AS INTEGER     ' Chips zu Levelbeginn (fuer den HUD-Balken)
DIM keys_blue AS INTEGER
DIM keys_red AS INTEGER
DIM keys_green AS INTEGER
DIM keys_yellow AS INTEGER
DIM has_flippers AS BOOLEAN
DIM has_fireboots AS BOOLEAN
DIM has_iceskates AS BOOLEAN
DIM has_suction AS BOOLEAN
DIM slide_kind AS INTEGER             ' 0 keine, 1 Eis, 2 Force
DIM slide_dir AS INTEGER
DIM on_water AS BOOLEAN                ' fuer Schwimm-Sprite

' Gleit-Animation
DIM pox AS INTEGER
DIM poy AS INTEGER
DIM anim_t AS FLOAT
DIM tick_timer AS FLOAT

' Ablauf
DIM state AS STRING                    ' menu intro play win dead done
DIM cur_level AS INTEGER
DIM nlevels AS INTEGER
DIM lvl_title AS STRING
DIM lvl_hint AS STRING
DIM lvl_time AS INTEGER
DIM death_msg AS STRING
DIM acc AS FLOAT
DIM tickcount AS INTEGER
DIM time_left AS INTEGER
DIM start_ms AS INTEGER

DIM js AS JSON_HANDLE
DIM tiles AS IMAGE
DIM rtb AS INTEGER             ' Board-Render-Target (288x288, scharf hochskaliert)

' Soundeffekte (Kenney Interface Sounds, CC0 -- siehe assets/sfx/CREDITS.txt)
DIM snd_step AS SOUND
DIM snd_chip AS SOUND
DIM snd_door AS SOUND
DIM snd_block AS SOUND
DIM snd_die AS SOUND
DIM snd_win AS SOUND
DIM snd_blocked AS SOUND
DIM snd_ok AS BOOLEAN          ' TRUE wenn die WAVs geladen werden konnten

' Hintergrundmusik (Juhani Junkala, CC0 -- siehe assets/music/CREDITS.txt)
' Menue = title, Spiel = level1..3 (rotieren pro Level), alle geschafft = ending
CONST MUS_TITLE = "assets/music/title.ogg"
CONST MUS_ENDING = "assets/music/ending.ogg"
DIM music_ok AS BOOLEAN        ' TRUE wenn die OGGs vorhanden sind
DIM music_on AS BOOLEAN        ' Musik an/aus (Taste M)
DIM cur_music AS STRING        ' aktuell laufender Track

' Lautstaerken (Bus-Pegel 0..1, per HUD-Slider einstellbar)
DIM music_vol AS FLOAT
DIM sfx_vol AS FLOAT

' Slider-Geometrie im HUD (in init berechnet, von draw + Maus genutzt)
DIM sl_x0 AS INTEGER
DIM sl_x1 AS INTEGER
DIM sl_lblx AS INTEGER
DIM sl_pctx AS INTEGER
DIM sl_my AS INTEGER           ' Musik-Slider Mittel-Y
DIM sl_sy AS INTEGER           ' Effekte-Slider Mittel-Y
DIM sl_h AS INTEGER            ' Slider-Hoehe / Hit-Toleranz
DIM cursor_form AS STRING      ' aktuell gesetzte Mauszeiger-Form

' --- Loesungen aufzeichnen und wieder abspielen --------------------------
' AUTOMATION_* schreibt die EINGABE mit und speist sie spaeter wieder ein.
' Damit dieselbe Eingabe auch dasselbe Ergebnis liefert, muss der Rest
' gleich sein: derselbe Level-Zustand, dieselbe Zufallsfolge (Zufalls-
' Laufbaender und Blobs wuerfeln!) und dieselbe Zeitrechnung.
CONST DEMO_SEED AS INTEGER = 1337
DIM demo_mode AS INTEGER       ' 0 = normal, 1 = Aufnahme, 2 = Wiedergabe
DIM demo_frames AS INTEGER     ' Bilder seit Demo-Start (ersetzt die Wanduhr)

' Bildschirm-Layout (native Aufloesung; Text/Icons scharf, Board pixelig)
DIM SW AS INTEGER
DIM SH AS INTEGER
DIM bsize AS INTEGER           ' Kantenlaenge des Spielfelds auf dem Schirm
DIM ts AS FLOAT                ' eine Kachel auf dem Schirm (bsize / VIEW)
DIM KP AS INTEGER              ' eine Kachel im Blatt assets/tiles.png (tiles.json "tile")
DIM board_x AS INTEGER
DIM board_y AS INTEGER
DIM hud_x AS INTEGER
DIM hud_w AS INTEGER

' Font (eine TTF; Groesse via TEXTROT-Scale, da LOADFONT-Groesse fix ist)
DIM gfont AS INTEGER
DIM BASEH AS INTEGER
DIM sc_big AS FLOAT
DIM sc_med AS FLOAT
DIM sc_sm AS FLOAT

' HUD-Icons (vorskaliert, scharf)
DIM ic_sz AS INTEGER          ' HUD-Icon-Groesse (direkt aus dem Tileset via DRAWIMAGEPARTEX)

' Level-Set-Auswahl (alle .json in levels/ + levels/_downloaded/)
CLASS LevelSet
    DIM pfad AS STRING
    DIM name AS STRING
    DIM anzahl AS INTEGER

    SUB Init(p AS STRING, n AS STRING, a AS INTEGER)
        pfad = p
        name = n
        anzahl = a
    END SUB
END CLASS

CONST MAXSETS = 64
DIM sets AS ARRAY OF LevelSet
DIM sel_set AS INTEGER

' Persistenz (Bestzeiten + Fortschritt) und Passwort-Eingabe
DIM sav AS SAVE_HANDLE
DIM cur_setkey AS STRING        ' Save-Key-Praefix des aktiven Sets
DIM lvl_best AS INTEGER         ' Bestzeit (Sek.) des aktuellen Levels, -1 = keine
DIM win_secs AS INTEGER         ' Sekunden fuer den letzten Sieg
DIM new_record AS BOOLEAN
DIM pw_input AS STRING          ' aktuell getipptes Passwort
DIM pw_msg AS STRING            ' Rueckmeldung der Passwort-Eingabe
DIM next_pw AS STRING           ' Passwort des naechsten Levels (im Sieg-Overlay)

' Feind-Tempo: Monster ziehen jeden mon_takt-ten Spielschritt. 2 = ruhig
' (halbes Spielertempo, Vorgabe), 1 = original (Spielertempo wie im
' MS-Regelwerk, auf das manche Fansite-Level knapp getimt sind). Taste T im
' Menue schaltet um, die Wahl steht in der Sicherung.
CONST TAKT_RUHIG = 2
CONST TAKT_ORIGINAL = 1
DIM mon_takt AS INTEGER : mon_takt = TAKT_RUHIG

SUB tempo_umschalten()
    mon_takt = IIF(mon_takt = TAKT_RUHIG, TAKT_ORIGINAL, TAKT_RUHIG)
    SAVE_SET_INT(sav, "einstellung/feindtempo", mon_takt)
    SAVE_WRITE(sav, SAVEPATH)
END SUB

FUNCTION tempo_name() AS STRING
    RETURN IIF(mon_takt = TAKT_RUHIG, "ruhig", "original")
END FUNCTION

' ----------------------------------------------------------------------
'  FIGUREN -- alles, was sich auf dem Brett bewegt
' ----------------------------------------------------------------------
' Eine Figur steht auf einer Zelle und weiss, wo sie vor ihrem letzten
' Schritt stand -- daraus gleitet sie im Bild von Zelle zu Zelle.
CLASS Figur
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM ox AS INTEGER
    DIM oy AS INTEGER
    DIM lebt AS BOOLEAN

    SUB Init(nx AS INTEGER, ny AS INTEGER)
        x = nx
        y = ny
        ox = nx
        oy = ny
        lebt = TRUE
    END SUB

    ' Vor einem Spielschritt: die jetzige Lage wird die alte.
    SUB merken()
        ox = x
        oy = y
    END SUB

    FUNCTION steht_auf(zx AS INTEGER, zy AS INTEGER) AS BOOLEAN
        RETURN lebt AND x = zx AND y = zy
    END FUNCTION

    ' Lage im Bild, t = 0 (alte Zelle) .. 1 (neue Zelle)
    FUNCTION bild_x(t AS FLOAT) AS FLOAT
        RETURN ox + (x - ox) * t
    END FUNCTION

    FUNCTION bild_y(t AS FLOAT) AS FLOAT
        RETURN oy + (y - oy) * t
    END FUNCTION
END CLASS

' Ein schiebbarer Block. Auf Eis und Laufband rutscht er weiter.
CLASS Kiste EXTENDS Figur
    DIM rutscht AS INTEGER          ' Rutsch-Richtung, -1 = ruht

    SUB Init(nx AS INTEGER, ny AS INTEGER)
        SUPER.Init(nx, ny)
        rutscht = -1
    END SUB
END CLASS

' Ein Monster. Boden (Laufband, Eis), Fallen und Kollisionen sind fuer alle
' gleich; WOHIN es von sich aus zieht, sagt jede Art selbst (waehlen).
CLASS Monster EXTENDS Figur
    DIM richtung AS INTEGER         ' 0=N 1=W 2=S 3=E
    DIM gefangen AS BOOLEAN

    SUB Init(nx AS INTEGER, ny AS INTEGER, r AS INTEGER)
        SUPER.Init(nx, ny)
        richtung = r
        gefangen = FALSE
    END SUB

    ' Nummer der Art = Zeile im Kachelsatz (&H40 + art * 4 + richtung).
    ABSTRACT FUNCTION art() AS INTEGER
    ' Die eigene Zugwahl auf normalem Boden.
    ABSTRACT SUB waehlen()

    ' Zieht nur jeden wievielten Zug des Grundtakts (Zahn und Blob: halb so oft).
    FUNCTION traegheit() AS INTEGER
        RETURN 1
    END FUNCTION

    FUNCTION kachel() AS INTEGER
        RETURN &H40 + art() * 4 + richtung
    END FUNCTION

    ' Ist der Boden t fuer diese Art eine Wand?
    FUNCTION meidet(t AS INTEGER) AS BOOLEAN
        IF t = T_WALL OR t = T_INVWALL OR t = T_HIDDEN OR t = T_WALL_SE THEN RETURN TRUE
        IF t = T_WALLN OR t = T_WALLW OR t = T_WALLS OR t = T_WALLE THEN RETURN TRUE
        IF t = T_BLUEBLOCK_W OR t = T_BLUEBLOCK_F THEN RETURN TRUE
        IF t = T_TOGGLE_C THEN RETURN TRUE
        IF t = T_SOCKET OR t = T_EXIT OR t = T_CLONER THEN RETURN TRUE
        IF t = T_DOOR_BLUE OR t = T_DOOR_RED OR t = T_DOOR_GREEN OR t = T_DOOR_YELLOW THEN RETURN TRUE
        IF t = T_CHIP OR t = T_DIRT THEN RETURN TRUE
        IF t = T_KEY_BLUE OR t = T_KEY_RED OR t = T_KEY_GREEN OR t = T_KEY_YELLOW THEN RETURN TRUE
        IF t = T_FLIPPERS OR t = T_FIREBOOTS OR t = T_ICESKATES OR t = T_SUCTION THEN RETURN TRUE
        IF t = T_THIEF OR t = T_HINT THEN RETURN TRUE
        RETURN t = T_WATER OR t = T_FIRE
    END FUNCTION

    FUNCTION kann(zx AS INTEGER, zy AS INTEGER, d AS INTEGER) AS BOOLEAN
        IF NOT inb(zx, zy) THEN RETURN FALSE
        IF edge_blocked(x, y, d) THEN RETURN FALSE
        IF meidet(terr[cidx(zx, zy)]) THEN RETURN FALSE
        IF block_at(zx, zy) >= 0 THEN RETURN FALSE
        RETURN mob_at(zx, zy) < 0
    END FUNCTION

    ' Einen Schritt in Richtung d versuchen. TRUE = gezogen.
    FUNCTION versuche(d AS INTEGER) AS BOOLEAN
        IF NOT kann(x + dxv[d], y + dyv[d], d) THEN RETURN FALSE
        x = x + dxv[d]
        y = y + dyv[d]
        richtung = d
        RETURN TRUE
    END FUNCTION

    ' Die erste der vier Richtungen, die geht.
    FUNCTION der_reihe_nach(a AS INTEGER, b AS INTEGER, c AS INTEGER, e AS INTEGER) AS BOOLEAN
        IF versuche(a) THEN RETURN TRUE
        IF versuche(b) THEN RETURN TRUE
        IF versuche(c) THEN RETURN TRUE
        RETURN versuche(e)
    END FUNCTION

    ' Ein Zug: Laufband und Eis bestimmen, sonst die Art.
    SUB ziehen()
        DIM hier AS INTEGER : hier = terr[cidx(x, y)]
        DIM fdir AS INTEGER : fdir = force_dir(hier)
        IF fdir >= 0 THEN
            versuche(fdir)
            RETURN
        END IF
        IF ist_eis(hier) THEN
            ' gleiten; Ecken lenken um, an der Wand kehrt es um
            DIM sd AS INTEGER : sd = richtung
            IF hier <> T_ICE THEN sd = corner_redirect(hier, sd)
            richtung = sd
            IF NOT versuche(sd) THEN
                richtung = turn_back(sd)
                versuche(richtung)
            END IF
            RETURN
        END IF
        waehlen()
    END SUB

    ' Was der Boden mit einem Monster macht, das ihn betritt.
    SUB betreten()
        DIM t AS INTEGER : t = terr[cidx(x, y)]
        IF t = T_BOMB THEN
            terr[cidx(x, y)] = T_FLOOR
            lebt = FALSE
        ELSEIF t = T_TRAP THEN
            gefangen = TRUE
        ELSEIF t = T_BTN_GREEN THEN
            toggle_walls()
        ELSEIF t = T_BTN_BLUE THEN
            reverse_tanks()
        END IF
    END SUB
END CLASS

' Kaefer: haelt sich an die linke Wand.
CLASS Kaefer EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 0
    END FUNCTION
    SUB waehlen()
        der_reihe_nach(turn_left(richtung), richtung, turn_right(richtung), turn_back(richtung))
    END SUB
END CLASS

' Feuerball: geradeaus, sonst rechts, links, zurueck. Feuer macht ihm nichts.
CLASS Feuerball EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 1
    END FUNCTION
    FUNCTION meidet(t AS INTEGER) AS BOOLEAN
        IF t = T_FIRE THEN RETURN FALSE
        RETURN SUPER.meidet(t)
    END FUNCTION
    SUB waehlen()
        der_reihe_nach(richtung, turn_right(richtung), turn_left(richtung), turn_back(richtung))
    END SUB
END CLASS

' Ball: prallt an der Wand zurueck.
CLASS Ball EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 2
    END FUNCTION
    SUB waehlen()
        IF NOT versuche(richtung) THEN versuche(turn_back(richtung))
    END SUB
END CLASS

' Panzer: nur geradeaus, sonst bleibt er stehen. Der blaue Knopf wendet ihn.
CLASS Panzer EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 3
    END FUNCTION
    SUB waehlen()
        versuche(richtung)
    END SUB
END CLASS

' Gleiter: geradeaus, sonst links, rechts, zurueck. Er schwimmt.
CLASS Gleiter EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 4
    END FUNCTION
    FUNCTION meidet(t AS INTEGER) AS BOOLEAN
        IF t = T_WATER THEN RETURN FALSE
        RETURN SUPER.meidet(t)
    END FUNCTION
    SUB waehlen()
        der_reihe_nach(richtung, turn_left(richtung), turn_right(richtung), turn_back(richtung))
    END SUB
END CLASS

' Zahn: verfolgt den Spieler, die laengere Achse zuerst -- halb so schnell.
CLASS Zahn EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 5
    END FUNCTION
    FUNCTION traegheit() AS INTEGER
        RETURN 2
    END FUNCTION
    SUB waehlen()
        DIM dx AS INTEGER : dx = px - x
        DIM dy AS INTEGER : dy = py - y
        DIM dh AS INTEGER : dh = IIF(dx < 0, 1, 3)
        DIM dv AS INTEGER : dv = IIF(dy < 0, 0, 2)
        IF ABS(dx) >= ABS(dy) THEN
            IF dx <> 0 THEN
                IF versuche(dh) THEN RETURN
            END IF
            IF dy <> 0 THEN
                IF versuche(dv) THEN RETURN
            END IF
        ELSE
            IF dy <> 0 THEN
                IF versuche(dv) THEN RETURN
            END IF
            IF dx <> 0 THEN
                IF versuche(dh) THEN RETURN
            END IF
        END IF
    END SUB
END CLASS

' Laeufer: geradeaus; an der Wand wuerfelt er eine neue Richtung.
CLASS Laeufer EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 6
    END FUNCTION
    SUB waehlen()
        IF versuche(richtung) THEN RETURN
        DIM versuch AS INTEGER
        FOR versuch = 1 TO 6
            IF versuche(RANDINT(0, 3)) THEN RETURN
        NEXT
    END SUB
END CLASS

' Blob: irrt zufaellig umher -- halb so schnell.
CLASS Blob EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 7
    END FUNCTION
    FUNCTION traegheit() AS INTEGER
        RETURN 2
    END FUNCTION
    SUB waehlen()
        versuche(RANDINT(0, 3))
    END SUB
END CLASS

' Pantoffeltierchen: haelt sich an die rechte Wand.
CLASS Pantoffel EXTENDS Monster
    FUNCTION art() AS INTEGER
        RETURN 8
    END FUNCTION
    SUB waehlen()
        der_reihe_nach(turn_right(richtung), richtung, turn_left(richtung), turn_back(richtung))
    END SUB
END CLASS

' Das Monster einer Art -- beim Laden des Levels und beim Klonen.
FUNCTION neues_monster(a AS INTEGER, nx AS INTEGER, ny AS INTEGER, r AS INTEGER) AS Monster
    SELECT CASE a
        CASE 0 : RETURN NEW Kaefer(nx, ny, r)
        CASE 1 : RETURN NEW Feuerball(nx, ny, r)
        CASE 2 : RETURN NEW Ball(nx, ny, r)
        CASE 3 : RETURN NEW Panzer(nx, ny, r)
        CASE 4 : RETURN NEW Gleiter(nx, ny, r)
        CASE 5 : RETURN NEW Zahn(nx, ny, r)
        CASE 6 : RETURN NEW Laeufer(nx, ny, r)
        CASE 7 : RETURN NEW Blob(nx, ny, r)
    END SELECT
    RETURN NEW Pantoffel(nx, ny, r)
END FUNCTION

' Monster in Zugreihenfolge, Bloecke
DIM mobs AS ARRAY OF Monster
DIM kisten AS ARRAY OF Kiste

' ----------------------------------------------------------------------
'  EFFEKTE -- nur fuers Auge, die Spiellogik kennt sie nicht
' ----------------------------------------------------------------------
' Ein Funke fliegt in Brett-Koordinaten (Zellen) und verglimmt.
CLASS Funke
    DIM x AS FLOAT
    DIM y AS FLOAT
    DIM vx AS FLOAT
    DIM vy AS FLOAT
    DIM alter AS FLOAT
    DIM dauer AS FLOAT
    DIM farbe AS INTEGER
    DIM groesse AS FLOAT

    ' dt in Sekunden; FALSE = verglueht
    FUNCTION weiter(dt AS FLOAT) AS BOOLEAN
        alter = alter + dt
        x = x + vx * dt
        y = y + vy * dt
        vx = vx * (1.0 - 2.2 * dt)
        vy = vy * (1.0 - 2.2 * dt) + 1.6 * dt
        RETURN alter < dauer
    END FUNCTION
END CLASS

DIM funkenflug AS ARRAY OF Funke
DIM schreck_t AS FLOAT            ' Sekunden seit dem letzten Tod (Wackeln, Rot)
DIM sieg_t AS FLOAT               ' Sekunden seit dem Erreichen des Ausgangs
DIM fx_zeit AS FLOAT              ' laufende Zeit fuer Pulsieren und Schweben
' Eigener Zufall fuer Effekte: RANDINT gehoert der Spiellogik (Aufnahmen
' einer Loesung brauchen dieselbe Wuerfelfolge).
DIM fx_saat AS INTEGER : fx_saat = 12345

FUNCTION fx_rnd() AS FLOAT
    fx_saat = (fx_saat * 1103515245 + 12345) MOD 2147483648
    RETURN fx_saat / 2147483648.0
END FUNCTION

' n Funken aus der Mitte der Zelle (cx, cy)
SUB funken(cx AS INTEGER, cy AS INTEGER, farbe AS INTEGER, n AS INTEGER)
    DIM i AS INTEGER
    FOR i = 1 TO n
        IF LEN(funkenflug) >= 400 THEN RETURN
        DIM f AS Funke : f = NEW Funke()
        DIM w AS FLOAT : w = fx_rnd() * 6.2832
        DIM v AS FLOAT : v = 1.2 + fx_rnd() * 3.2
        f.x = cx + 0.5
        f.y = cy + 0.5
        f.vx = COS(w) * v
        f.vy = SIN(w) * v - 1.0
        f.dauer = 0.35 + fx_rnd() * 0.45
        f.farbe = farbe
        f.groesse = 0.03 + fx_rnd() * 0.05
        ARRAY_PUSH(funkenflug, f)
    NEXT
END SUB

SUB funken_weiter(dt AS FLOAT)
    fx_zeit = fx_zeit + dt
    schreck_t = schreck_t + dt
    sieg_t = sieg_t + dt
    IF LEN(funkenflug) = 0 THEN RETURN
    DIM bleiben AS ARRAY OF Funke : bleiben = []
    DIM f AS Funke
    FOR EACH f IN funkenflug
        IF f.weiter(dt) THEN ARRAY_PUSH(bleiben, f)
    NEXT
    funkenflug = bleiben
END SUB

' ----------------------------------------------------------------------
'  HELFER
' ----------------------------------------------------------------------
FUNCTION cidx(x AS INTEGER, y AS INTEGER) AS INTEGER
    RETURN y * GW + x
END FUNCTION

FUNCTION inb(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    RETURN x >= 0 AND y >= 0 AND x < GW AND y < GH
END FUNCTION

FUNCTION tat(x AS INTEGER, y AS INTEGER) AS INTEGER
    IF NOT inb(x, y) THEN RETURN T_WALL
    RETURN terr[cidx(x, y)]
END FUNCTION

FUNCTION hexnib(ch AS STRING) AS INTEGER
    DIM a AS INTEGER
    a = ASC(ch)
    IF a >= 48 AND a <= 57 THEN RETURN a - 48
    IF a >= 65 AND a <= 70 THEN RETURN a - 55
    IF a >= 97 AND a <= 102 THEN RETURN a - 87
    RETURN 0
END FUNCTION

FUNCTION turn_left(d AS INTEGER) AS INTEGER
    RETURN (d + 1) MOD 4
END FUNCTION

FUNCTION turn_right(d AS INTEGER) AS INTEGER
    RETURN (d + 3) MOD 4
END FUNCTION

FUNCTION turn_back(d AS INTEGER) AS INTEGER
    RETURN (d + 2) MOD 4
END FUNCTION

' Nummer des lebenden Monsters bzw. Blocks auf (x,y), -1 = keins
FUNCTION mob_at(x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(mobs) - 1
        IF mobs[i].steht_auf(x, y) THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION block_at(x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(kisten) - 1
        IF kisten[i].steht_auf(x, y) THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION ist_eis(t AS INTEGER) AS BOOLEAN
    RETURN t = T_ICE OR t = T_ICE_NW2 OR t = T_ICE_NE2 OR t = T_ICE_SE2 OR t = T_ICE_SW2
END FUNCTION

' Blockiert eine duenne Wand die Bewegung von (x,y) in Richtung d?
FUNCTION edge_blocked(x AS INTEGER, y AS INTEGER, d AS INTEGER) AS BOOLEAN
    DIM here AS INTEGER
    here = tat(x, y)
    DIM nx AS INTEGER
    DIM ny AS INTEGER
    nx = x + dxv[d]
    ny = y + dyv[d]
    DIM there AS INTEGER
    there = tat(nx, ny)

    ' Wand auf der Austritts-Kante der Quelle
    IF d = 0 AND (here = T_WALLN OR there = T_WALLS) THEN RETURN TRUE
    IF d = 2 AND (here = T_WALLS OR there = T_WALLN) THEN RETURN TRUE
    IF d = 1 AND (here = T_WALLW OR there = T_WALLE) THEN RETURN TRUE
    IF d = 3 AND (here = T_WALLE OR there = T_WALLW) THEN RETURN TRUE

    ' Eck-Wand SE (blockiert S und E)
    IF here = T_WALL_SE AND (d = 2 OR d = 3) THEN RETURN TRUE
    IF there = T_WALL_SE AND (d = 0 OR d = 1) THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' ----------------------------------------------------------------------
'  LEVEL-SETS FINDEN
' ----------------------------------------------------------------------
SUB scan_sets()
    sets = []
    add_sets_in("levels")
    add_sets_in("levels/_downloaded")
END SUB

SUB add_sets_in(dir AS STRING)
    IF NOT DIREXISTS(dir) THEN RETURN
    DIM fn AS STRING
    FOR EACH fn IN DIRLIST(dir)
        IF RIGHT$(LOWER$(fn), 5) = ".json" AND LEN(sets) < MAXSETS THEN
            DIM path AS STRING : path = PATHJOIN(dir, fn)
            TRY
                DIM h AS JSON_HANDLE : h = JSON_LOAD(path)
                DIM cnt AS INTEGER : cnt = JSON_LEN(h, "levels")
                IF cnt > 0 THEN
                    DIM nm AS STRING : nm = JSON_GET_STRING(h, "name")
                    IF LEN(nm) = 0 THEN nm = fn
                    ARRAY_PUSH(sets, NEW LevelSet(path, nm, cnt))
                END IF
            CATCH e
                ' ungueltige JSON ueberspringen
            END TRY
        END IF
    NEXT
END SUB

' Das gewaehlte Set laden.
SUB set_laden()
    js = JSON_LOAD(sets[sel_set].pfad)
    nlevels = JSON_LEN(js, "levels")
    cur_setkey = set_key(sets[sel_set].name)
END SUB

' ----------------------------------------------------------------------
'  SAVE / FORTSCHRITT / PASSWORT
' ----------------------------------------------------------------------
' Set-Name -> stabiler Save-Key-Praefix (nur a-z0-9, Rest -> '_')
FUNCTION set_key(nm AS STRING) AS STRING
    DIM low AS STRING
    low = LOWER$(nm)
    DIM r AS STRING
    r = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(low) - 1
        DIM c AS STRING
        c = MID$(low, i, 1)
        DIM a AS INTEGER
        a = ASC(c)
        IF (a >= 97 AND a <= 122) OR (a >= 48 AND a <= 57) THEN
            r = r + c
        ELSE
            r = r + "_"
        END IF
    NEXT

    RETURN r
END FUNCTION

FUNCTION best_key(idx AS INTEGER) AS STRING
    RETURN cur_setkey + "/" + STR$(idx) + "/best"
END FUNCTION

' Bestwert des Levels, oder -1 wenn noch nie geschafft.
' Getimte Level: hoechste verbliebene Zeit (CC-Zeitbonus). Ungetimte: kuerzeste
' verbrauchte Zeit. Welche Lesart gilt, sagt lvl_time des Levels.
FUNCTION best_for(idx AS INTEGER) AS INTEGER
    RETURN SAVE_GET_INT_OR(sav, best_key(idx), -1)
END FUNCTION

' Bestwert/Sieg-Wert als Text -- getimt = "… übrig", ungetimt = verbrauchte Zeit
FUNCTION score_label(v AS INTEGER) AS STRING
    IF lvl_time > 0 THEN RETURN fmt_time(v) + " uebrig"
    RETURN fmt_time(v)
END FUNCTION

' Sieg verbuchen: Bestwert aktualisieren, Fortschritt sichern, Datei schreiben
SUB record_win()
    DIM elapsed AS INTEGER
    elapsed = (now_ms() - start_ms) \ 1000
    IF lvl_time > 0 THEN
        win_secs = lvl_time - elapsed       ' CC-Zeitbonus: verbliebene Zeit
        IF win_secs < 0 THEN win_secs = 0
    ELSE
        win_secs = elapsed                  ' ungetimt: verbrauchte Zeit
    END IF

    new_record = FALSE
    DIM old AS INTEGER
    old = best_for(cur_level)
    DIM better AS BOOLEAN
    IF lvl_time > 0 THEN
        better = (old < 0 OR win_secs > old)   ' mehr Zeit uebrig = besser
    ELSE
        better = (old < 0 OR win_secs < old)   ' weniger verbraucht = besser
    END IF

    IF better THEN
        SAVE_SET_INT(sav, best_key(cur_level), win_secs)
        new_record = TRUE
    END IF

    DIM mk AS STRING
    mk = cur_setkey + "/max"
    IF cur_level + 1 > SAVE_GET_INT_OR(sav, mk, 0) THEN
        SAVE_SET_INT(sav, mk, cur_level + 1)
    END IF

    SAVE_WRITE(sav, SAVEPATH)
    lvl_best = best_for(cur_level)

    ' Passwort des naechsten Levels merken (fuer das Sieg-Overlay)
    next_pw = ""
    IF cur_level + 1 < nlevels THEN
        next_pw = JSON_GET_STRING(js, "levels." + STR$(cur_level + 1) + ".password")
    END IF
END SUB

' Sekunden -> "m:ss" bzw. "s" fuer kurze Zeiten
FUNCTION fmt_time(s AS INTEGER) AS STRING
    IF s < 60 THEN RETURN STR$(s) + "s"
    DIM m AS INTEGER
    m = s \ 60
    DIM r AS INTEGER
    r = s MOD 60
    DIM rs AS STRING
    rs = STR$(r)
    IF r < 10 THEN rs = "0" + rs
    RETURN STR$(m) + ":" + rs
END FUNCTION

' Passwort-Eingabe pro Frame verarbeiten (Tippen / Loeschen / Bestaetigen)
SUB update_password()
    IF INPUT_PRESSED("back") THEN
        state = "menu"
        RETURN
    END IF

    ' getippte Zeichen aus der Tipp-Queue holen (A-Z, 0-9)
    DIM ch AS STRING
    ch = INKEY$()
    WHILE LEN(ch) > 0
        DIM ca AS INTEGER
        ca = ASC(UPPER$(ch))
        IF ((ca >= 65 AND ca <= 90) OR (ca >= 48 AND ca <= 57)) AND LEN(pw_input) < 9 THEN
            pw_input = pw_input + UPPER$(ch)
            pw_msg = ""
        END IF

        ch = INKEY$()
    WEND

    IF INPUT_PRESSED("delchar") AND LEN(pw_input) > 0 THEN
        pw_input = pw_input[0:LEN(pw_input) - 1]
        pw_msg = ""
    END IF

    IF INPUT_PRESSED("confirm") AND LEN(pw_input) > 0 THEN
        DIM hit AS INTEGER
        hit = find_password(pw_input)
        IF hit >= 0 THEN
            cur_level = hit
            load_level(cur_level)
            state = "intro"
        ELSE
            pw_msg = "Unbekanntes Passwort"
        END IF
    END IF
END SUB

' Level-Index mit passendem Passwort (case-insensitiv), sonst -1
FUNCTION find_password(pw AS STRING) AS INTEGER
    DIM up AS STRING
    up = UPPER$(pw)
    IF LEN(up) = 0 THEN RETURN -1
    DIM i AS INTEGER
    FOR i = 0 TO nlevels - 1
        DIM lp AS STRING
        lp = UPPER$(JSON_GET_STRING(js, "levels." + STR$(i) + ".password"))
        IF LEN(lp) > 0 AND lp = up THEN RETURN i
    NEXT

    RETURN -1
END FUNCTION

' ----------------------------------------------------------------------
'  LEVEL LADEN
' ----------------------------------------------------------------------
SUB load_level(idx AS INTEGER)
    DIM base AS STRING
    base = "levels." + STR$(idx) + "."
    lvl_title = JSON_GET_STRING(js, base + "title")
    lvl_hint = JSON_GET_STRING(js, base + "hint")
    lvl_time = JSON_GET_INT(js, base + "time")
    DIM want_chips AS INTEGER
    want_chips = JSON_GET_INT(js, base + "chips")
    DIM up AS STRING
    DIM lo AS STRING
    up = JSON_GET_STRING(js, base + "upper")
    lo = JSON_GET_STRING(js, base + "lower")

    mobs = []
    kisten = []
    funkenflug = []
    chips_left = 0
    px = 1
    py = 1
    pdir = 2

    DIM i AS INTEGER
    FOR i = 0 TO NCELL - 1
        DIM uc AS INTEGER
        DIM lc AS INTEGER
        uc = hexnib(MID$(up, i * 2, 1)) * 16 + hexnib(MID$(up, i * 2 + 1, 1))
        lc = hexnib(MID$(lo, i * 2, 1)) * 16 + hexnib(MID$(lo, i * 2 + 1, 1))
        DIM cx AS INTEGER
        DIM cy AS INTEGER
        cx = i MOD GW
        cy = i \ GW
        IF uc >= &H40 AND uc <= &H63 THEN
            ' Monster
            IF LEN(mobs) < MAXMOB THEN ARRAY_PUSH(mobs, neues_monster((uc - &H40) \ 4, cx, cy, (uc - &H40) MOD 4))

            terr[i] = lc
        ELSEIF uc = T_BLOCK OR (uc >= &H0E AND uc <= &H11) THEN
            ' Block (auch Clone-Block)
            IF LEN(kisten) < MAXBLK THEN ARRAY_PUSH(kisten, NEW Kiste(cx, cy))

            terr[i] = lc
        ELSEIF uc >= T_CHIP_N AND uc <= &H6F THEN
            ' Spieler-Start
            px = cx
            py = cy
            pdir = uc - T_CHIP_N
            terr[i] = lc
        ELSEIF uc >= &H3C AND uc <= &H3F THEN
            ' Chip schwimmend = Spieler-Start im Wasser
            px = cx
            py = cy
            pdir = uc - &H3C
            terr[i] = T_WATER
        ELSE
            terr[i] = uc
            IF uc = T_CHIP THEN chips_left = chips_left + 1
        END IF
    NEXT

    IF want_chips > 0 THEN chips_left = want_chips
    chips_total = chips_left

    ' Verdrahtung laden
    load_wires(idx)

    ' Monster in MS-Bewegungsreihenfolge bringen (CCLP1-Timing)
    reorder_monsters(idx)

    keys_blue = 0
    keys_red = 0
    keys_green = 0
    keys_yellow = 0
    has_flippers = FALSE
    has_fireboots = FALSE
    has_iceskates = FALSE
    has_suction = FALSE
    slide_kind = 0
    slide_dir = pdir
    on_water = FALSE
    tickcount = 0
    acc = 0.0
    time_left = lvl_time
    start_ms = MILLIS()
    pox = px
    poy = py
    anim_t = 1.0
    tick_timer = 0.0
    pushed_blk = -1
    lvl_best = best_for(idx)
END SUB

SUB load_wires(idx AS INTEGER)
    DIM base AS STRING : base = "levels." + STR$(idx) + "."
    fallen = draehte_lesen(JSON_GET_STRING(js, base + "traps"))
    kloner = draehte_lesen(JSON_GET_STRING(js, base + "cloners"))
END SUB

' "kx,ky,zx,zy;kx,ky,zx,zy;..." -> Draehte
FUNCTION draehte_lesen(text AS STRING) AS ARRAY OF Draht
    DIM liste AS ARRAY OF Draht : liste = []
    IF LEN(text) = 0 THEN RETURN liste
    DIM rec AS STRING
    FOR EACH rec IN SPLIT$(text, ";")
        DIM p AS ARRAY OF STRING : p = SPLIT$(rec, ",")
        IF LEN(p) >= 4 AND LEN(liste) < MAXWIRE THEN ARRAY_PUSH(liste, NEW Draht(VAL(p[0]), VAL(p[1]), VAL(p[2]), VAL(p[3])))
    NEXT
    RETURN liste
END FUNCTION

' MS-Ruleset: Monster ziehen in der Reihenfolge der 0x0A-Bewegungsliste,
' NICHT in Map-Lesereihenfolge. CCLP1-Puzzles sind darauf getimt.
' Monster, die nicht in der Liste stehen, haengen wir in Lesereihenfolge an.
SUB reorder_monsters(idx AS INTEGER)
    IF LEN(mobs) = 0 THEN RETURN
    DIM ms AS STRING
    ms = JSON_GET_STRING(js, "levels." + STR$(idx) + ".monsters")
    IF LEN(ms) = 0 THEN RETURN
    DIM geordnet AS ARRAY OF Monster : geordnet = []
    DIM rec AS STRING
    FOR EACH rec IN SPLIT$(ms, ";")
        DIM p AS ARRAY OF STRING : p = SPLIT$(rec, ",")
        IF LEN(p) >= 2 THEN
            DIM j AS INTEGER : j = mob_at(VAL(p[0]), VAL(p[1]))
            IF j >= 0 THEN
                ARRAY_PUSH(geordnet, mobs[j])
                ARRAY_REMOVE_AT(mobs, j)
            END IF
        END IF
    NEXT
    ' die uebrigen (nicht gelistet) in Lesereihenfolge dahinter
    DIM m AS Monster
    FOR EACH m IN mobs
        ARRAY_PUSH(geordnet, m)
    NEXT
    mobs = geordnet
END SUB

' ----------------------------------------------------------------------
'  AUDIO
' ----------------------------------------------------------------------
' Kenney-WAVs mit angepasster Lautstaerke; ohne sie Synth-Toene als Fallback.
SUB sfx_step()
    IF snd_ok THEN
        PLAYSOUND(snd_step, 0, 0.30)        ' leise -- spielt bei jedem Zug
    ELSE
        AUDIO_PLAY(AUDIO_TONE(220.0, 25, "sine", 0.05))
    END IF
END SUB

SUB sfx_chip()
    IF snd_ok THEN
        PLAYSOUND(snd_chip, 0, 0.7)
    ELSE
        AUDIO_PLAY(AUDIO_TONE(880.0, 70, "sine", 0.18))
    END IF
END SUB

SUB sfx_door()
    IF snd_ok THEN
        PLAYSOUND(snd_door, 0, 0.6)
    ELSE
        AUDIO_PLAY(AUDIO_SFX("square", 320.0, 460.0, 2, 60, 120, 0.0, 0.0, 0.2))
    END IF
END SUB

SUB sfx_block()
    IF snd_ok THEN
        PLAYSOUND(snd_block, 0, 0.6)
    ELSE
        AUDIO_PLAY(AUDIO_TONE(120.0, 50, "square", 0.12))
    END IF
END SUB

SUB sfx_die()
    IF snd_ok THEN
        PLAYSOUND(snd_die, 0, 0.85)
    ELSE
        AUDIO_PLAY(AUDIO_SFX("noise", 220.0, -200.0, 3, 120, 260, 0.0, 0.0, 0.3))
    END IF
END SUB

SUB sfx_win()
    IF snd_ok THEN
        PLAYSOUND(snd_win, 0, 0.85)
    ELSE
        AUDIO_PLAY(AUDIO_SFX("square", 440.0, 660.0, 4, 160, 240, 4.0, 4.0, 0.28))
        AUDIO_PLAY(AUDIO_TONE(990.0, 240, "sine", 0.2))
    END IF
END SUB

SUB sfx_blocked()
    IF snd_ok THEN
        PLAYSOUND(snd_blocked, 0, 0.45)
    ELSE
        AUDIO_PLAY(AUDIO_TONE(90.0, 40, "square", 0.1))
    END IF
END SUB

' Spiel-Track fuer das aktuelle Level (level1..3 rotierend)
FUNCTION music_for_level() AS STRING
    RETURN "assets/music/level" + STR$((cur_level MOD 3) + 1) + ".ogg"
END FUNCTION

' Gewuenschten Track abspielen -- wechselt nur, wenn er sich aendert.
' Basis-Lautstaerke 1.0; der eigentliche Pegel kommt vom Musik-Bus (Slider).
SUB set_music(track AS STRING)
    IF NOT music_ok OR NOT music_on THEN RETURN
    IF track = cur_music THEN RETURN
    PLAYMUSIC(track, 0, 1.0)
    cur_music = track
END SUB

' Lautstaerke per Tastatur aendern (F1/F2 Musik, F3/F4 Effekte)
SUB adjust_music(d AS FLOAT)
    music_vol = music_vol + d
    IF music_vol < 0.0 THEN music_vol = 0.0
    IF music_vol > 1.0 THEN music_vol = 1.0
    AUDIO_BUS_VOLUME("music", music_vol)
END SUB

SUB adjust_sfx(d AS FLOAT)
    sfx_vol = sfx_vol + d
    IF sfx_vol < 0.0 THEN sfx_vol = 0.0
    IF sfx_vol > 1.0 THEN sfx_vol = 1.0
    AUDIO_BUS_VOLUME("sfx", sfx_vol)
    sfx_chip()                ' kurzes Feedback auf dem neuen Effekt-Pegel
END SUB

' Mauszeiger-Form nur bei echter Aenderung setzen -- MOUSE_CURSOR jedes Bild
' neu zu rufen waere zwar harmlos, aber unnoetiger Fensterverkehr.
SUB set_cursor(form AS STRING)
    IF form = cursor_form THEN RETURN
    cursor_form = form
    MOUSE_CURSOR(form)
END SUB

' Lautstaerke-Slider per Maus bedienen (nur wenn das HUD sichtbar ist)
SUB update_volume()
    DIM mx AS INTEGER
    DIM my AS INTEGER
    mx = MOUSEX()
    my = MOUSEY()
    ' Zeigt der Zeiger auf eine der beiden Leisten? Die Antwort steuert die
    ' Zeigerform -- was man anfassen kann, soll auch so aussehen.
    DIM auf_leiste AS BOOLEAN
    auf_leiste = mx >= sl_x0 - sl_h AND mx <= sl_x1 + sl_h AND (ABS(my - sl_my) <= sl_h OR ABS(my - sl_sy) <= sl_h)
    IF auf_leiste THEN
        set_cursor("hand")
    ELSE
        set_cursor("default")
    END IF

    IF NOT MOUSEBUTTON(0) THEN RETURN
    IF mx < sl_x0 - sl_h OR mx > sl_x1 + sl_h THEN RETURN
    DIM v AS FLOAT
    v = (mx - sl_x0) * 1.0 / (sl_x1 - sl_x0)
    IF v < 0.0 THEN v = 0.0
    IF v > 1.0 THEN v = 1.0
    IF ABS(my - sl_my) <= sl_h THEN
        music_vol = v
        AUDIO_BUS_VOLUME("music", music_vol)
    ELSEIF ABS(my - sl_sy) <= sl_h THEN
        sfx_vol = v
        AUDIO_BUS_VOLUME("sfx", sfx_vol)
    END IF
END SUB

' Musik an/aus schalten (Taste M)
SUB toggle_music()
    music_on = NOT music_on
    IF music_on THEN
        cur_music = ""          ' erzwingt Neustart des passenden Tracks
    ELSE
        STOPMUSIC()
        cur_music = ""
    END IF
END SUB

' ----------------------------------------------------------------------
'  SPIELER-BEWEGUNG + MECHANIK
' ----------------------------------------------------------------------
' Kurzer Ruettler im Gamepad -- nur wenn ueberhaupt eins angeschlossen ist,
' sonst meldet JOYSTICK_RUMBLE einen ungueltigen Index. Dauer in SEKUNDEN.
SUB rumble(staerke AS FLOAT, dauer_s AS FLOAT)
    IF JOYSTICK_COUNT() > 0 THEN JOYSTICK_RUMBLE(0, staerke, staerke, dauer_s)
END SUB

' Spiel-Uhr. Normal die Wanduhr -- waehrend Aufnahme/Wiedergabe aber aus der
' Bildzaehlung abgeleitet. Die Wanduhr schwankt von Lauf zu Lauf um
' Millisekunden; ein einziger dadurch anders gesetzter Zug reicht, damit eine
' aufgezeichnete Loesung nicht mehr passt.
FUNCTION now_ms() AS INTEGER
    IF demo_mode > 0 THEN RETURN start_ms + demo_frames * 1000 \ 60
    RETURN MILLIS()
END FUNCTION

' Dateiname der Loesung zum aktuellen Level -- eine Datei je Set und Level.
FUNCTION demo_file() AS STRING
    RETURN "loesung_" + cur_setkey + "_" + STR$(cur_level + 1) + ".txt"
END FUNCTION

SUB demo_stop()
    IF AUTOMATION_RECORDING() OR AUTOMATION_PLAYING() THEN AUTOMATION_STOP()
    demo_mode = 0
END SUB

' modus: 1 = aufnehmen, 2 = abspielen. Beide starten den Level neu, damit
' Aufnahme und Wiedergabe vom exakt gleichen Punkt aus laufen.
SUB demo_start(modus AS INTEGER)
    demo_stop()
    RANDOMIZE(DEMO_SEED)
    load_level(cur_level)
    state = "play"
    demo_frames = 0
    demo_mode = modus
    IF modus = 1 THEN
        AUTOMATION_RECORD(demo_file())
    ELSEIF AUTOMATION_PLAY(demo_file()) = 0 THEN
        demo_mode = 0              ' leere/fehlende Aufnahme -> normal spielen
    END IF
END SUB

SUB player_die(msg AS STRING)
    state = "dead"
    death_msg = msg
    schreck_t = 0.0
    funken(px, py, RGB(255, 80, 70), 30)
    sfx_die()
    rumble(0.8, 0.35)         ' der Tod ist auch in den Haenden zu spueren
    demo_stop()               ' eine gescheiterte Runde ist keine Loesung
END SUB

' Kann der Spieler von (px,py) nach (nx,ny) in Richtung d?
' Behandelt Tueren/Sockel/Bloecke direkt (Seiteneffekte beim Betreten via land_on).
FUNCTION player_can_enter(nx AS INTEGER, ny AS INTEGER, d AS INTEGER) AS BOOLEAN
    IF NOT inb(nx, ny) THEN RETURN FALSE
    IF edge_blocked(px, py, d) THEN RETURN FALSE
    DIM t AS INTEGER
    t = terr[cidx(nx, ny)]
    IF t = T_WALL OR t = T_INVWALL OR t = T_HIDDEN OR t = T_WALL_SE THEN RETURN FALSE
    IF t = T_WALLN OR t = T_WALLW OR t = T_WALLS OR t = T_WALLE THEN RETURN FALSE
    IF t = T_BLUEBLOCK_W THEN RETURN FALSE
    IF t = T_TOGGLE_C THEN RETURN FALSE
    IF t = T_CLONER THEN RETURN FALSE
    IF t = T_DOOR_BLUE AND keys_blue <= 0 THEN RETURN FALSE
    IF t = T_DOOR_RED AND keys_red <= 0 THEN RETURN FALSE
    IF t = T_DOOR_GREEN AND keys_green <= 0 THEN RETURN FALSE
    IF t = T_DOOR_YELLOW AND keys_yellow <= 0 THEN RETURN FALSE
    IF t = T_SOCKET AND chips_left > 0 THEN RETURN FALSE

    ' Block davor -> nur wenn schiebbar
    DIM bi AS INTEGER
    bi = block_at(nx, ny)
    IF bi >= 0 THEN
        DIM tx AS INTEGER
        DIM ty AS INTEGER
        tx = nx + dxv[d]
        ty = ny + dyv[d]
        IF NOT block_can_move(nx, ny, tx, ty, d) THEN RETURN FALSE
    END IF

    RETURN TRUE
END FUNCTION

FUNCTION block_can_move(fx AS INTEGER, fy AS INTEGER, tx AS INTEGER, ty AS INTEGER, d AS INTEGER) AS BOOLEAN
    IF NOT inb(tx, ty) THEN RETURN FALSE
    IF edge_blocked(fx, fy, d) THEN RETURN FALSE
    IF block_at(tx, ty) >= 0 THEN RETURN FALSE
    IF mob_at(tx, ty) >= 0 THEN RETURN FALSE
    DIM t AS INTEGER
    t = terr[cidx(tx, ty)]
    IF t = T_WALL OR t = T_INVWALL OR t = T_HIDDEN OR t = T_WALL_SE THEN RETURN FALSE
    IF t = T_WALLN OR t = T_WALLW OR t = T_WALLS OR t = T_WALLE THEN RETURN FALSE
    IF t = T_BLUEBLOCK_W OR t = T_BLUEBLOCK_F THEN RETURN FALSE
    IF t = T_TOGGLE_C OR t = T_CLONER OR t = T_SOCKET OR t = T_EXIT THEN RETURN FALSE
    IF t = T_CHIP THEN RETURN FALSE
    IF t = T_DOOR_BLUE OR t = T_DOOR_RED OR t = T_DOOR_GREEN OR t = T_DOOR_YELLOW THEN RETURN FALSE
    IF t = T_KEY_BLUE OR t = T_KEY_RED OR t = T_KEY_GREEN OR t = T_KEY_YELLOW THEN RETURN FALSE
    IF t = T_FLIPPERS OR t = T_FIREBOOTS OR t = T_ICESKATES OR t = T_SUCTION THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' Block bi nach (tx,ty) schieben (inkl. Wasser->Dreck, Bombe).
SUB push_block(bi AS INTEGER, tx AS INTEGER, ty AS INTEGER)
    DIM k AS Kiste : k = kisten[bi]
    DIM t AS INTEGER : t = terr[cidx(tx, ty)]
    IF t = T_WATER THEN
        terr[cidx(tx, ty)] = T_DIRT
        k.lebt = FALSE
        sfx_block()
        funken(tx, ty, RGB(120, 190, 255), 14)
        RETURN
    END IF

    IF t = T_BOMB THEN
        terr[cidx(tx, ty)] = T_FLOOR
        k.lebt = FALSE
        sfx_die()
        funken(tx, ty, RGB(255, 160, 60), 28)
        RETURN
    END IF

    DIM d AS INTEGER
    IF tx > k.x THEN
        d = 3
    ELSEIF tx < k.x THEN
        d = 1
    ELSEIF ty < k.y THEN
        d = 0
    ELSE
        d = 2
    END IF

    k.x = tx
    k.y = ty
    IF t = T_DIRT THEN terr[cidx(tx, ty)] = T_FLOOR
    pushed_blk = bi
    set_block_slide(k, d)
    sfx_block()

    ' Block toggelt gruenen Knopf
    IF t = T_BTN_GREEN THEN toggle_walls()
END SUB

' Rutsch-Richtung eines Blocks aus seiner aktuellen Kachel bestimmen
SUB set_block_slide(k AS Kiste, d AS INTEGER)
    DIM t AS INTEGER : t = terr[cidx(k.x, k.y)]
    DIM fdir AS INTEGER : fdir = force_dir(t)
    IF t = T_ICE THEN
        k.rutscht = d
    ELSEIF ist_eis(t) THEN
        k.rutscht = corner_redirect(t, d)
    ELSEIF fdir >= 0 THEN
        k.rutscht = fdir
    ELSE
        k.rutscht = -1
    END IF
END SUB

' Rutschende Bloecke einen Schritt weiterbewegen (1 Zelle/Tick)
SUB advance_blocks()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(kisten) - 1
        DIM k AS Kiste : k = kisten[i]
        IF k.lebt AND k.rutscht >= 0 AND i <> pushed_blk THEN
            DIM d AS INTEGER : d = k.rutscht
            DIM here AS INTEGER : here = terr[cidx(k.x, k.y)]
            IF ist_eis(here) AND here <> T_ICE THEN
                d = corner_redirect(here, d)
            ELSE
                DIM fd2 AS INTEGER : fd2 = force_dir(here)
                IF fd2 >= 0 THEN d = fd2
            END IF

            k.rutscht = d
            DIM tx AS INTEGER : tx = k.x + dxv[d]
            DIM ty AS INTEGER : ty = k.y + dyv[d]
            DIM tt AS INTEGER : tt = tat(tx, ty)
            IF tt = T_WATER THEN
                terr[cidx(tx, ty)] = T_DIRT
                k.lebt = FALSE
                funken(tx, ty, RGB(120, 190, 255), 14)
            ELSEIF tt = T_BOMB THEN
                terr[cidx(tx, ty)] = T_FLOOR
                k.lebt = FALSE
                sfx_die()
                funken(tx, ty, RGB(255, 160, 60), 28)
            ELSEIF tx = px AND ty = py THEN
                k.x = tx
                k.y = ty
                player_die("Von einem Block zerquetscht!")
            ELSEIF block_can_move(k.x, k.y, tx, ty, d) THEN
                k.x = tx
                k.y = ty
                IF tt = T_DIRT THEN terr[cidx(tx, ty)] = T_FLOOR
                set_block_slide(k, d)
            ELSE
                k.rutscht = -1
            END IF
        END IF
    NEXT
END SUB

' Etwas Aufsammelbares unter dem Spieler: weg vom Boden, Ton, Funken.
SUB aufheben(farbe AS INTEGER)
    terr[cidx(px, py)] = T_FLOOR
    sfx_chip()
    funken(px, py, farbe, 12)
END SUB

' Eine Tuer oder der Sockel gibt nach.
SUB oeffnen()
    terr[cidx(px, py)] = T_FLOOR
    sfx_door()
END SUB

' Effekte beim Betreten von (px,py)
SUB land_on()
    DIM t AS INTEGER : t = terr[cidx(px, py)]
    on_water = FALSE
    SELECT CASE t
        CASE T_DIRT
            terr[cidx(px, py)] = T_FLOOR
        CASE T_CHIP
            terr[cidx(px, py)] = T_FLOOR
            IF chips_left > 0 THEN chips_left = chips_left - 1
            sfx_chip()
            funken(px, py, RGB(80, 255, 160), 16)
        CASE T_KEY_BLUE
            keys_blue = keys_blue + 1
            aufheben(RGB(80, 140, 255))
        CASE T_KEY_RED
            keys_red = keys_red + 1
            aufheben(RGB(255, 90, 90))
        CASE T_KEY_GREEN
            keys_green = keys_green + 1
            aufheben(RGB(90, 235, 120))
        CASE T_KEY_YELLOW
            keys_yellow = keys_yellow + 1
            aufheben(RGB(255, 215, 80))
        CASE T_FLIPPERS
            has_flippers = TRUE
            aufheben(RGB(90, 160, 255))
        CASE T_FIREBOOTS
            has_fireboots = TRUE
            aufheben(RGB(255, 140, 60))
        CASE T_ICESKATES
            has_iceskates = TRUE
            aufheben(RGB(180, 230, 255))
        CASE T_SUCTION
            has_suction = TRUE
            aufheben(RGB(190, 140, 255))
        CASE T_DOOR_BLUE
            keys_blue = keys_blue - 1
            oeffnen()
        CASE T_DOOR_RED
            keys_red = keys_red - 1
            oeffnen()
        CASE T_DOOR_GREEN
            oeffnen()                      ' gruene Schluessel bleiben
        CASE T_DOOR_YELLOW
            keys_yellow = keys_yellow - 1
            oeffnen()
        CASE T_SOCKET
            oeffnen()
            funken(px, py, RGB(110, 255, 200), 18)
        CASE T_THIEF
            has_flippers = FALSE
            has_fireboots = FALSE
            has_iceskates = FALSE
            has_suction = FALSE
            sfx_blocked()
        CASE T_BTN_GREEN
            toggle_walls()
        CASE T_BTN_BLUE
            reverse_tanks()
        CASE T_BTN_RED
            fire_cloners(px, py)
        CASE T_EXIT
            state = "win"
            sieg_t = 0.0
            funken(px, py, RGB(90, 230, 255), 40)
            funken(px, py, RGB(255, 225, 120), 20)
            record_win()
            sfx_win()
            rumble(0.4, 0.18)     ' kurzer Erfolgs-Stups, schwaecher als der Tod
            demo_stop()           ' hier endet die Aufnahme: DAS ist die Loesung
        CASE T_WATER
            IF has_flippers THEN
                on_water = TRUE
            ELSE
                player_die("Ertrunken!")
            END IF
        CASE T_FIRE
            IF NOT has_fireboots THEN player_die("Verbrannt!")
        CASE T_BOMB
            terr[cidx(px, py)] = T_FLOOR
            player_die("In die Luft gesprengt!")
        CASE T_TELEPORT
            do_teleport()
        CASE T_PASSONCE
            terr[cidx(px, py)] = T_WALL    ' wird hinter dir zur Wand
    END SELECT
END SUB

' Eis-/Force-Rutschzustand nach dem Landen bestimmen
SUB update_slide()
    DIM t AS INTEGER
    t = terr[cidx(px, py)]
    slide_kind = 0
    IF t = T_ICE AND NOT has_iceskates THEN
        slide_kind = 1
        slide_dir = pdir
    ELSEIF (t = T_ICE_NW2 OR t = T_ICE_NE2 OR t = T_ICE_SE2 OR t = T_ICE_SW2) AND NOT has_iceskates THEN
        slide_kind = 1
        slide_dir = corner_redirect(t, pdir)
        pdir = slide_dir
    ELSEIF t = T_FORCE_N AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = 0
    ELSEIF t = T_FORCE_W AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = 1
    ELSEIF t = T_FORCE_S AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = 2
    ELSEIF t = T_FORCE_E AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = 3
    ELSEIF t = T_FORCE_RND AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = RANDINT(0, 3)
    END IF
END SUB

FUNCTION force_dir(t AS INTEGER) AS INTEGER
    IF t = T_FORCE_N THEN RETURN 0
    IF t = T_FORCE_W THEN RETURN 1
    IF t = T_FORCE_S THEN RETURN 2
    IF t = T_FORCE_E THEN RETURN 3
    IF t = T_FORCE_RND THEN RETURN RANDINT(0, 3)
    RETURN -1
END FUNCTION

FUNCTION corner_redirect(t AS INTEGER, m AS INTEGER) AS INTEGER
    ' offene Richtungen je Eck-Tile
    ' offene Kanten je CC-Code (1A=SE,1B=SW,1C=NW,1D=NE); 0=N 1=W 2=S 3=E
    DIM oa AS INTEGER
    DIM ob AS INTEGER
    IF t = T_ICE_NW2 THEN
        oa = 2
        ob = 3
    ELSEIF t = T_ICE_NE2 THEN
        oa = 2
        ob = 1
    ELSEIF t = T_ICE_SE2 THEN
        oa = 0
        ob = 1
    ELSE
        oa = 0
        ob = 3
    END IF

    IF m = turn_back(oa) THEN RETURN ob
    IF m = turn_back(ob) THEN RETURN oa
    RETURN m
END FUNCTION

SUB do_teleport()
    ' naechsten Teleporter in Rueckwaerts-Lesereihenfolge suchen, von dem aus
    ' in pdir ausgetreten werden kann
    DIM start AS INTEGER
    start = cidx(px, py)
    DIM c AS INTEGER
    c = start - 1
    DIM guard AS INTEGER
    guard = 0
    WHILE guard < NCELL
        IF c < 0 THEN c = NCELL - 1
        IF terr[c] = T_TELEPORT AND c <> start THEN
            DIM tx2 AS INTEGER
            DIM ty2 AS INTEGER
            tx2 = c MOD GW
            ty2 = c \ GW
            DIM ex AS INTEGER
            DIM ey AS INTEGER
            ex = tx2 + dxv[pdir]
            ey = ty2 + dyv[pdir]

            ' Spieler dorthin setzen (Austritt versucht der naechste Tick)
            px = tx2
            py = ty2
            pox = tx2
            poy = ty2
            RETURN
        END IF

        c = c - 1
        guard = guard + 1
    WEND
END SUB

' Ein Schritt des Spielers in Richtung d
SUB player_step(d AS INTEGER)
    pdir = d
    DIM nx AS INTEGER
    DIM ny AS INTEGER
    nx = px + dxv[d]
    ny = py + dyv[d]
    IF NOT player_can_enter(nx, ny, d) THEN
        ' blockiert: blaue Schein-Bloecke aufdecken
        DIM t0 AS INTEGER
        t0 = tat(nx, ny)
        IF t0 = T_BLUEBLOCK_F THEN terr[cidx(nx, ny)] = T_FLOOR
        IF t0 = T_BLUEBLOCK_W THEN terr[cidx(nx, ny)] = T_WALL
        IF t0 = T_HIDDEN THEN terr[cidx(nx, ny)] = T_WALL
        slide_kind = 0
        sfx_blocked()
        RETURN
    END IF

    ' evtl. Block schieben
    DIM bi AS INTEGER
    bi = block_at(nx, ny)
    IF bi >= 0 THEN
        push_block(bi, nx + dxv[d], ny + dyv[d])
    END IF

    px = nx
    py = ny
    land_on()
    IF state <> "play" THEN RETURN

    ' Kollision mit Monster?
    IF mob_at(px, py) >= 0 THEN
        player_die("Von einem Roboter erwischt!")
        RETURN
    END IF

    update_slide()
    IF slide_kind = 0 THEN sfx_step()
END SUB

' ----------------------------------------------------------------------
'  GERAETE
' ----------------------------------------------------------------------
SUB toggle_walls()
    DIM i AS INTEGER
    FOR i = 0 TO NCELL - 1
        IF terr[i] = T_TOGGLE_C THEN
            terr[i] = T_TOGGLE_O
        ELSEIF terr[i] = T_TOGGLE_O THEN
            terr[i] = T_TOGGLE_C
        END IF
    NEXT

    sfx_door()
END SUB

SUB reverse_tanks()
    DIM m AS Monster
    FOR EACH m IN mobs
        IF m.lebt AND m IS Panzer THEN m.richtung = turn_back(m.richtung)
    NEXT
    sfx_door()
END SUB

SUB fire_cloners(bx AS INTEGER, by AS INTEGER)
    DIM d AS Draht
    FOR EACH d IN kloner
        IF d.knopf_x = bx AND d.knopf_y = by THEN clone_one(d.ziel_x, d.ziel_y)
    NEXT
END SUB

' Das Monster auf dem Kloner schickt eine Kopie in seine Blickrichtung.
SUB clone_one(mx AS INTEGER, my AS INTEGER)
    DIM src AS INTEGER : src = mob_at(mx, my)
    IF src < 0 OR LEN(mobs) >= MAXMOB THEN RETURN
    DIM vorbild AS Monster : vorbild = mobs[src]
    DIM d AS INTEGER : d = vorbild.richtung
    DIM nx AS INTEGER : nx = mx + dxv[d]
    DIM ny AS INTEGER : ny = my + dyv[d]
    IF vorbild.kann(nx, ny, d) THEN ARRAY_PUSH(mobs, neues_monster(vorbild.art(), nx, ny, d))
END SUB

' ----------------------------------------------------------------------
'  MONSTER
' ----------------------------------------------------------------------
SUB update_traps()
    ' Falle offen, solange ihr brauner Knopf belegt ist (Spieler/Block/Monster)
    DIM d AS Draht
    FOR EACH d IN fallen
        DIM held AS BOOLEAN
        held = (px = d.knopf_x AND py = d.knopf_y)
        IF block_at(d.knopf_x, d.knopf_y) >= 0 THEN held = TRUE
        IF mob_at(d.knopf_x, d.knopf_y) >= 0 THEN held = TRUE
        DIM m AS INTEGER : m = mob_at(d.ziel_x, d.ziel_y)
        IF m >= 0 THEN mobs[m].gefangen = NOT held
    NEXT
END SUB

' Zieht ein Monster in diesem Spielschritt? Grundtakt (Feind-Tempo) mal
' der Traegheit der Art.
FUNCTION zieht_jetzt(m AS Monster) AS BOOLEAN
    RETURN (tickcount MOD (mon_takt * m.traegheit())) = 0
END FUNCTION

SUB move_monsters()
    ' Ein Kloner haengt neue Monster hinten an -- sie ziehen erst im naechsten
    ' Schritt (bis hier wie mit der festen Anzahl vom Schleifenbeginn).
    DIM n AS INTEGER : n = LEN(mobs)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM m AS Monster : m = mobs[i]
        IF m.lebt AND NOT m.gefangen AND zieht_jetzt(m) THEN
            m.merken()
            m.ziehen()
            m.betreten()
        END IF
    NEXT

    ' Kollision Monster-auf-Spieler
    IF mob_at(px, py) >= 0 AND state = "play" THEN
        player_die("Von einem Roboter erwischt!")
    END IF
END SUB

' ----------------------------------------------------------------------
'  WELT-TICK
' ----------------------------------------------------------------------
DIM want_dir AS INTEGER
DIM anim_frame AS INTEGER       ' Tile-Animations-Frame 0..3
DIM anim_ms AS FLOAT
DIM buf_dir AS INTEGER          ' gepufferter Tap (geht zwischen Ticks nicht verloren)
DIM held_dir AS INTEGER

SUB world_tick()
    tickcount = tickcount + 1
    pushed_blk = -1
    pox = px
    poy = py
    DIM k AS Kiste
    FOR EACH k IN kisten
        k.merken()
    NEXT

    ' --- Spieler ---
    IF slide_kind = 1 THEN
        ' Eis: kein Steuern, weiter in slide_dir bis blockiert
        IF player_can_enter(px + dxv[slide_dir], py + dyv[slide_dir], slide_dir) THEN
            player_step(slide_dir)
        ELSE
            slide_kind = 0
            IF want_dir >= 0 THEN player_step(want_dir)
        END IF
    ELSEIF slide_kind = 2 THEN
        ' Force: seitlich steuerbar, aber NICHT gegen die Kraftrichtung
        DIM ov AS INTEGER
        ov = want_dir
        IF ov = turn_back(slide_dir) THEN ov = -1
        IF ov >= 0 AND player_can_enter(px + dxv[ov], py + dyv[ov], ov) THEN
            player_step(ov)
        ELSEIF player_can_enter(px + dxv[slide_dir], py + dyv[slide_dir], slide_dir) THEN
            player_step(slide_dir)
        ELSE
            slide_kind = 0
        END IF
    ELSE
        IF want_dir >= 0 THEN player_step(want_dir)
    END IF

    advance_blocks()
    IF state <> "play" THEN RETURN

    ' --- Monster ---
    update_traps()
    move_monsters()

    ' --- Zeitlimit ---
    IF lvl_time > 0 THEN
        time_left = lvl_time - ((now_ms() - start_ms) \ 1000)
        IF time_left <= 0 THEN
            time_left = 0
            player_die("Zeit abgelaufen!")
        END IF
    END IF
END SUB

' ----------------------------------------------------------------------
'  RENDERN
' ----------------------------------------------------------------------
' Animierte Kacheln: Frame-0-Zelle (Sheet-Zeilen 8-9). -1 = statisch.
FUNCTION anim_base(code AS INTEGER) AS INTEGER
    SELECT CASE code
        CASE T_WATER : RETURN 128
        CASE T_FIRE : RETURN 132
        CASE T_FORCE_S : RETURN 136
        CASE T_FORCE_N : RETURN 140
        CASE T_FORCE_E : RETURN 144
        CASE T_FORCE_W : RETURN 148
        CASE T_FORCE_RND : RETURN 152
        CASE T_EXIT : RETURN 156
        CASE T_TELEPORT : RETURN 160
        CASE T_BOMB : RETURN 164
        CASE T_TOGGLE_C : RETURN 168
        CASE T_TOGGLE_O : RETURN 172
        CASE T_SOCKET : RETURN 176
        CASE T_CLONER : RETURN 180
        CASE T_THIEF : RETURN 184
        CASE T_KEY_BLUE : RETURN 188
        CASE T_KEY_RED : RETURN 192
        CASE T_KEY_GREEN : RETURN 196
        CASE T_KEY_YELLOW : RETURN 200
        CASE T_FLIPPERS : RETURN 204
        CASE T_FIREBOOTS : RETURN 208
        CASE T_ICESKATES : RETURN 212
        CASE T_SUCTION : RETURN 216
    END SELECT
    RETURN -1
END FUNCTION

' Pixel-Kante einer Zellen-Koordinate (relativ zur Kamera). Jede Kachel
' reicht von kante(f) bis kante(f + 1) -- so bleibt zwischen Nachbarn keine
' Fuge, auch wenn eine Kachel 110,4 Pixel breit ist.
FUNCTION kante(f AS FLOAT) AS INTEGER
    RETURN INT(FLOOR(f * ts))
END FUNCTION

FUNCTION kachel_zelle(code AS INTEGER) AS INTEGER
    DIM ab AS INTEGER : ab = anim_base(code)
    IF ab >= 0 THEN RETURN ab + (anim_frame MOD 4)
    RETURN code
END FUNCTION

' Kachel code an die Zelle (fx, fy) relativ zur Kamera
SUB draw_tile(code AS INTEGER, fx AS FLOAT, fy AS FLOAT)
    DIM cell AS INTEGER : cell = kachel_zelle(code)
    DIM x0 AS INTEGER : x0 = kante(fx)
    DIM y0 AS INTEGER : y0 = kante(fy)
    DRAWIMAGEPARTEX(tiles, (cell MOD 16) * KP, (cell \ 16) * KP, KP, KP, x0, y0, kante(fx + 1.0) - x0, kante(fy + 1.0) - y0)
END SUB

' Figur (Monster, Spieler, Block) mit Groesse und Toenung, um die
' Zellmitte; dy hebt sie an (Schweben).
SUB draw_sprite(code AS INTEGER, fx AS FLOAT, fy AS FLOAT, skala AS FLOAT, dy AS FLOAT, tint AS INTEGER)
    DIM cell AS INTEGER : cell = kachel_zelle(code)
    DIM g AS FLOAT : g = ts * skala
    DIM mx AS FLOAT : mx = (fx + 0.5) * ts
    DIM my AS FLOAT : my = (fy + 0.5 - dy) * ts
    DRAWIMAGEPARTEX(tiles, (cell MOD 16) * KP, (cell \ 16) * KP, KP, KP, INT(mx - g / 2.0), INT(my - g / 2.0), INT(g), INT(g), tint)
END SUB

' Weicher Schatten unter einer Figur
SUB draw_schatten(fx AS FLOAT, fy AS FLOAT, breite AS FLOAT, staerke AS INTEGER)
    DIM mx AS FLOAT : mx = (fx + 0.5) * ts
    DIM my AS FLOAT : my = (fy + 0.88) * ts
    ELLIPSE(INT(mx - ts * breite), INT(my - ts * 0.09), INT(mx + ts * breite), INT(my + ts * 0.09), RGBA(0, 0, 0, staerke))
END SUB

' Leuchten einer Kachel: Farbe, -1 = leuchtet nicht
FUNCTION leuchtfarbe(t AS INTEGER) AS INTEGER
    IF t = T_CHIP THEN RETURN RGB(80, 255, 160)
    IF t = T_EXIT THEN RETURN RGB(80, 230, 255)
    IF t = T_TELEPORT THEN RETURN RGB(110, 190, 255)
    IF t = T_SOCKET THEN RETURN IIF(chips_left = 0, RGB(110, 255, 200), -1)
    IF t = T_KEY_BLUE THEN RETURN RGB(80, 140, 255)
    IF t = T_KEY_RED THEN RETURN RGB(255, 90, 90)
    IF t = T_KEY_GREEN THEN RETURN RGB(90, 235, 120)
    IF t = T_KEY_YELLOW THEN RETURN RGB(255, 215, 80)
    IF t = T_FLIPPERS THEN RETURN RGB(90, 160, 255)
    IF t = T_FIREBOOTS THEN RETURN RGB(255, 140, 60)
    IF t = T_ICESKATES THEN RETURN RGB(180, 230, 255)
    IF t = T_SUCTION THEN RETURN RGB(190, 140, 255)
    IF t = T_FIRE THEN RETURN RGB(255, 120, 30)
    IF t = T_BOMB THEN RETURN RGB(255, 70, 50)
    IF t = T_HINT THEN RETURN RGB(255, 225, 120)
    IF t = T_BTN_RED THEN RETURN RGB(255, 80, 80)
    IF t = T_BTN_GREEN THEN RETURN RGB(80, 255, 120)
    IF t = T_BTN_BLUE THEN RETURN RGB(90, 150, 255)
    RETURN -1
END FUNCTION

' Weicher Schein um die Zellmitte (additiv; vorher BLEND_MODE("add"))
SUB schein(fx AS FLOAT, fy AS FLOAT, farbe AS INTEGER, radius AS FLOAT, staerke AS INTEGER)
    DIM r AS INTEGER : r = (farbe SHR 16) BAND 255
    DIM g AS INTEGER : g = (farbe SHR 8) BAND 255
    DIM b AS INTEGER : b = farbe BAND 255
    CIRCLE_GRADIENT(INT((fx + 0.5) * ts), INT((fy + 0.5) * ts), INT(radius * ts), RGBA(r, g, b, MAX(1, MIN(255, staerke))), RGBA(r, g, b, 0))
END SUB

DIM camx AS INTEGER
DIM camy AS INTEGER

SUB draw_board()
    DIM ease AS FLOAT
    ease = anim_t
    DIM pfx AS FLOAT
    DIM pfy AS FLOAT
    pfx = pox + (px - pox) * ease
    pfy = poy + (py - poy) * ease
    DIM camfx AS FLOAT
    DIM camfy AS FLOAT
    camfx = pfx - (VIEW - 1) / 2.0
    camfy = pfy - (VIEW - 1) / 2.0
    IF camfx < 0.0 THEN camfx = 0.0
    IF camfy < 0.0 THEN camfy = 0.0
    IF camfx > GW - VIEW THEN camfx = GW - VIEW
    IF camfy > GH - VIEW THEN camfy = GH - VIEW
    DIM bcx AS INTEGER
    DIM bcy AS INTEGER
    bcx = INT(camfx)
    bcy = INT(camfy)

    ' --- Boden und Gelaende ---
    CLS(RGB(10, 13, 20))
    DIM vy AS INTEGER
    DIM vx AS INTEGER
    FOR vy = 0 TO VIEW
        FOR vx = 0 TO VIEW
            DIM cx AS INTEGER : cx = bcx + vx
            DIM cy AS INTEGER : cy = bcy + vy
            IF inb(cx, cy) THEN
                draw_tile(T_FLOOR, cx - camfx, cy - camfy)
                DIM t AS INTEGER : t = terr[cidx(cx, cy)]
                IF t <> T_FLOOR THEN draw_tile(t, cx - camfx, cy - camfy)
            ELSE
                draw_tile(T_WALL, cx - camfx, cy - camfy)
            END IF
        NEXT
    NEXT

    ' --- Leuchten: Chips, Schluessel, Ausgang, Feuer ... (additiv, pulsierend) ---
    BLEND_MODE("add")
    FOR vy = 0 TO VIEW
        FOR vx = 0 TO VIEW
            DIM lx AS INTEGER : lx = bcx + vx
            DIM ly AS INTEGER : ly = bcy + vy
            IF inb(lx, ly) THEN
                DIM lf AS INTEGER : lf = leuchtfarbe(terr[cidx(lx, ly)])
                IF lf >= 0 THEN
                    DIM puls AS FLOAT : puls = 0.5 + 0.5 * SIN(fx_zeit * 3.2 + lx * 0.9 + ly * 1.3)
                    schein(lx - camfx, ly - camfy, lf, 0.62 + 0.08 * puls, INT(46 + 44 * puls))
                END IF
            END IF
        NEXT
    NEXT
    BLEND_MODE("alpha")

    ' --- Schatten ---
    DIM k AS Kiste
    FOR EACH k IN kisten
        IF k.lebt THEN draw_schatten(k.bild_x(ease) - camfx, k.bild_y(ease) - camfy, 0.40, 120)
    NEXT
    DIM m AS Monster
    FOR EACH m IN mobs
        IF m.lebt THEN draw_schatten(m.bild_x(zug_anteil(m, ease)) - camfx, m.bild_y(zug_anteil(m, ease)) - camfy, 0.30, 100)
    NEXT
    draw_schatten(pfx - camfx, pfy - camfy, 0.28, 110)

    ' --- Bloecke ---
    FOR EACH k IN kisten
        IF k.lebt THEN draw_tile(T_BLOCK, k.bild_x(ease) - camfx, k.bild_y(ease) - camfy)
    NEXT

    ' --- Monster: gleiten ueber ihren ganzen Zugtakt, schweben ein wenig ---
    DIM mi AS INTEGER : mi = 0
    FOR EACH m IN mobs
        IF m.lebt THEN
            DIM mph AS FLOAT : mph = zug_anteil(m, ease)
            DIM schweb AS FLOAT : schweb = 0.025 + 0.025 * SIN(fx_zeit * 5.0 + mi * 1.7)
            draw_sprite(m.kachel(), m.bild_x(mph) - camfx, m.bild_y(mph) - camfy, 1.0, schweb, IIF(m.gefangen, RGB(150, 150, 170), -1))
        END IF
        mi = mi + 1
    NEXT

    ' --- Spieler: eigenes Licht, Geh-Frame je Tick, in Ruhe atmet er ---
    DIM moving AS BOOLEAN
    moving = (pox <> px OR poy <> py)
    DIM pc AS INTEGER
    pc = T_CHIP_N + pdir
    IF on_water THEN
        pc = &H3C + pdir
    ELSEIF moving AND (tickcount MOD 2) = 1 THEN
        pc = &H70 + pdir
    END IF
    BLEND_MODE("add")
    schein(pfx - camfx, pfy - camfy, RGB(90, 200, 255), 1.15, 34)
    BLEND_MODE("alpha")
    DIM atem AS FLOAT : atem = 0.0
    IF NOT moving AND NOT on_water THEN atem = 0.02 + 0.02 * SIN(fx_zeit * 3.0)
    DIM ptint AS INTEGER : ptint = -1
    IF state = "dead" THEN ptint = RGB(255, 120, 120)
    draw_sprite(pc, pfx - camfx, pfy - camfy, 1.0, atem, ptint)

    ' --- Funken ---
    IF LEN(funkenflug) > 0 THEN
        BLEND_MODE("add")
        DIM f AS Funke
        FOR EACH f IN funkenflug
            DIM rest AS FLOAT : rest = 1.0 - f.alter / f.dauer
            DIM fr AS INTEGER : fr = (f.farbe SHR 16) BAND 255
            DIM fg AS INTEGER : fg = (f.farbe SHR 8) BAND 255
            DIM fb AS INTEGER : fb = f.farbe BAND 255
            DIM rr AS INTEGER : rr = MAX(2, INT(f.groesse * ts * (0.4 + rest)))
            CIRCLE_GRADIENT(INT((f.x - camfx) * ts), INT((f.y - camfy) * ts), rr * 3, RGBA(fr, fg, fb, INT(120 * rest) + 1), RGBA(fr, fg, fb, 0))
            CIRCLE(INT((f.x - camfx) * ts), INT((f.y - camfy) * ts), rr, RGBA(MIN(255, fr + 80), MIN(255, fg + 80), MIN(255, fb + 80), INT(230 * rest) + 1))
        NEXT
        BLEND_MODE("alpha")
    END IF

    ' --- Vignette: das Brett dunkelt zum Rand hin ab ---
    DIM vg AS INTEGER : vg = INT(bsize * 0.10)
    GRADIENTV(0, 0, bsize, vg, RGBA(6, 9, 15, 150), RGBA(6, 9, 15, 0))
    GRADIENTV(0, bsize - vg, bsize, bsize, RGBA(6, 9, 15, 0), RGBA(6, 9, 15, 150))
    GRADIENTH(0, 0, vg, bsize, RGBA(6, 9, 15, 150), RGBA(6, 9, 15, 0))
    GRADIENTH(bsize - vg, 0, bsize, bsize, RGBA(6, 9, 15, 0), RGBA(6, 9, 15, 150))

    ' --- Tod: kurz rot; Sieg: der Ausgang strahlt ---
    IF state = "dead" AND schreck_t < 0.6 THEN
        BOX(0, 0, bsize, bsize, RGBA(200, 30, 30, INT(110 * (1.0 - schreck_t / 0.6)) + 1))
    END IF
    IF state = "win" THEN
        BLEND_MODE("add")
        schein(pfx - camfx, pfy - camfy, RGB(90, 230, 255), 1.0 + MIN(2.5, sieg_t * 3.0), INT(90 * MAX(0.25, 1.0 - sieg_t)))
        BLEND_MODE("alpha")
    END IF
END SUB

' Wie weit ein Monster in seinem Zug ist (0..1): es zieht nur jeden
' mon_takt * traegheit-ten Spielschritt und gleitet ueber diese ganze Zeit.
FUNCTION zug_anteil(m AS Monster, ease AS FLOAT) AS FLOAT
    DIM mp AS INTEGER : mp = mon_takt * m.traegheit()
    DIM a AS FLOAT : a = ((tickcount MOD mp) + ease) / mp
    IF a > 1.0 THEN a = 1.0
    RETURN a
END FUNCTION

' Hintergrund des ganzen Schirms: dunkler Verlauf, darin ziehen zwei
' weiche Lichter langsam ihre Bahn (Neon hinter Glas).
SUB hintergrund()
    GRADIENTV(0, 0, SW, SH, RGB(16, 22, 36), RGB(6, 8, 14))
    BLEND_MODE("add")
    DIM r AS INTEGER : r = INT(SH * 0.55)
    CIRCLE_GRADIENT(INT(SW * (0.30 + 0.12 * SIN(fx_zeit * 0.11))), INT(SH * (0.35 + 0.10 * COS(fx_zeit * 0.13))), r, RGBA(30, 90, 120, 34), RGBA(30, 90, 120, 0))
    CIRCLE_GRADIENT(INT(SW * (0.72 + 0.10 * COS(fx_zeit * 0.09))), INT(SH * (0.70 + 0.08 * SIN(fx_zeit * 0.12))), r, RGBA(70, 40, 120, 30), RGBA(70, 40, 120, 0))
    BLEND_MODE("alpha")
    ' feines Leiterbahn-Raster
    DIM schritt AS INTEGER : schritt = MAX(24, SH \ 18)
    DIM gx AS INTEGER
    FOR gx = 0 TO SW STEP schritt
        LINE(gx, 0, gx, SH, RGBA(80, 140, 170, 10))
    NEXT
    DIM gy AS INTEGER
    FOR gy = 0 TO SH STEP schritt
        LINE(0, gy, SW, gy, RGBA(80, 140, 170, 10))
    NEXT
END SUB

' Rahmen ums Spielfeld: Neon-Kante mit weichem Schein nach aussen.
SUB brett_rahmen(x AS INTEGER, y AS INTEGER)
    DIM i AS INTEGER
    FOR i = 1 TO 6
        RECTROUND(x - i * 2, y - i * 2, x + bsize + i * 2, y + bsize + i * 2, 10 + i * 2, RGBA(70, 200, 220, 46 - i * 7))
    NEXT
    RECTROUND(x - 1, y - 1, x + bsize + 1, y + bsize + 1, 8, RGB(70, 170, 190))
END SUB

SUB ct(cx AS INTEGER, cy AS INTEGER, scale AS FLOAT, s AS STRING, col AS INTEGER)
    TEXTROT(cx, cy, s, 0, scale, col)
END SUB

' HUD-Icon direkt aus dem Tileset skaliert zeichnen (weich gefiltert)
SUB draw_icon(code AS INTEGER, x AS INTEGER, y AS INTEGER)
    DRAWIMAGEPARTEX(tiles, (code MOD 16) * KP, (code \ 16) * KP, KP, KP, x, y, ic_sz, ic_sz)
END SUB

' Vertikale HUD-Position als Bruchteil der Panel-Hoehe
FUNCTION hb(f AS FLOAT) AS INTEGER
    RETURN board_y + INT(bsize * f)
END FUNCTION

' Gerundetes Sub-Panel mit Neon-Rand
SUB hud_panel(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER)
    BOXROUND(x0, y0, x1, y1, 9, RGBA(14, 20, 32, 200))
    RECTROUND(x0, y0, x1, y1, 9, RGBA(60, 130, 150, 190))
END SUB

' zentriertes Sektions-Label (gedimmtes Neon)
SUB hud_label(cx AS INTEGER, y AS INTEGER, s AS STRING)
    ct(cx, y, sc_sm * 0.82, s, RGB(98, 156, 174))
END SUB

' Schluessel-Zelle: Icon + Anzahl (gedimmt bei 0)
SUB hud_keycell(cx AS INTEGER, y AS INTEGER, code AS INTEGER, n AS INTEGER)
    draw_icon(code, cx - ic_sz \ 2, y)
    DIM col AS INTEGER
    col = RGB(214, 222, 236)
    IF n = 0 THEN col = RGB(78, 90, 114)
    ct(cx, y + ic_sz + INT(BASEH * sc_sm * 0.55), sc_sm, "x" + STR$(n), col)
END SUB

' Ausruestungs-Slot: Icon wenn vorhanden, sonst leerer Slot
SUB hud_slot(cx AS INTEGER, y AS INTEGER, code AS INTEGER, have AS BOOLEAN)
    DIM h AS INTEGER
    h = (ic_sz \ 2) + INT(SH * 0.006)
    BOXROUND(cx - h, y - INT(SH * 0.005), cx + h, y + ic_sz + INT(SH * 0.005), 6, RGB(20, 27, 40))
    IF have THEN
        RECTROUND(cx - h, y - INT(SH * 0.005), cx + h, y + ic_sz + INT(SH * 0.005), 6, RGB(70, 160, 150))
        draw_icon(code, cx - ic_sz \ 2, y)
    ELSE
        RECTROUND(cx - h, y - INT(SH * 0.005), cx + h, y + ic_sz + INT(SH * 0.005), 6, RGB(36, 48, 64))
    END IF
END SUB

' Lautstaerke-Slider: Label + Schiene + Fuellung + Knopf + Prozent
SUB draw_slider(y AS INTEGER, label AS STRING, vol AS FLOAT)
    ct(sl_lblx, y, sc_sm * 0.82, label, RGB(178, 192, 214))
    BOXROUND(sl_x0, y - sl_h, sl_x1, y + sl_h, 4, RGB(22, 32, 48))
    IF vol > 0.01 THEN BOXROUND(sl_x0, y - sl_h, sl_x0 + INT((sl_x1 - sl_x0) * vol), y + sl_h, 4, RGB(86, 210, 198))
    DIM hx AS INTEGER
    hx = sl_x0 + INT((sl_x1 - sl_x0) * vol)
    BOXROUND(hx - sl_h \ 2, y - sl_h - 2, hx + sl_h \ 2, y + sl_h + 2, 3, RGB(190, 244, 238))
    ct(sl_pctx, y, sc_sm * 0.76, STR$(INT(vol * 100 + 0.5)) + "%", RGB(160, 178, 206))
END SUB

SUB draw_hud()
    DIM pad AS INTEGER
    pad = INT(SH * 0.018)
    DIM x0 AS INTEGER
    DIM x1 AS INTEGER
    DIM cxp AS INTEGER
    DIM ix0 AS INTEGER
    DIM ix1 AS INTEGER
    x0 = hud_x
    x1 = hud_x + hud_w
    cxp = hud_x + hud_w \ 2
    ix0 = x0 + pad
    ix1 = x1 - pad
    DIM kw AS INTEGER
    kw = (ix1 - ix0) \ 4

    ' --- Aussen-Panel (Glas + Neon-Rahmen) ---
    glas_karte(x0, board_y, x1, board_y + bsize, RGB(58, 150, 170))

    ' --- Header ---
    GRADIENTV(ix0, hb(0.012), ix1, hb(0.068), RGB(16, 60, 66), RGB(13, 28, 40))
    RECTROUND(ix0, hb(0.012), ix1, hb(0.068), 8, RGB(64, 158, 154))
    glow_text(cxp, hb(0.040), sc_med, "CIRCUIT RUNNER", RGB(122, 246, 234))

    ' --- Level + Fortschrittsbalken ---
    ct(cxp, hb(0.090), sc_sm, "LEVEL " + STR$(cur_level + 1) + " / " + STR$(nlevels), RGB(216, 224, 238))
    DIM pb0 AS INTEGER
    DIM pbh AS INTEGER
    pb0 = hb(0.114)
    pbh = INT(SH * 0.012)
    BOXROUND(ix0, pb0, ix1, pb0 + pbh, 4, RGB(24, 34, 50))
    DIM frac AS FLOAT
    frac = 0.0
    IF nlevels > 0 THEN frac = (cur_level + 1) * 1.0 / nlevels
    IF frac > 1.0 THEN frac = 1.0
    IF frac > 0.02 THEN BOXROUND(ix0, pb0, ix0 + INT((ix1 - ix0) * frac), pb0 + pbh, 4, RGB(92, 222, 162))
    ct(cxp, hb(0.150), sc_sm, lvl_title, RGB(150, 200, 240))

    ' --- Chips-Panel ---
    hud_panel(ix0, hb(0.172), ix1, hb(0.282))
    hud_label(cxp, hb(0.192), "DATEN-CHIPS")
    draw_icon(T_CHIP, ix0 + pad, hb(0.210))
    ct(ix0 + pad + ic_sz + INT(ic_sz * 1.2), hb(0.210) + ic_sz \ 2, sc_med, "x " + STR$(chips_left), RGB(122, 246, 152))
    DIM cb0 AS INTEGER
    cb0 = hb(0.262)
    BOXROUND(ix0 + pad, cb0, ix1 - pad, cb0 + INT(SH * 0.010), 3, RGB(22, 32, 46))
    IF chips_total > 0 THEN
        DIM got AS FLOAT
        got = (chips_total - chips_left) * 1.0 / chips_total
        IF got > 0.02 THEN BOXROUND(ix0 + pad, cb0, ix0 + pad + INT((ix1 - ix0 - 2 * pad) * got), cb0 + INT(SH * 0.010), 3, RGB(80, 210, 130))
    END IF

    ' --- Schluessel-Panel ---
    hud_panel(ix0, hb(0.298), ix1, hb(0.428))
    hud_label(cxp, hb(0.317), "SCHLUESSEL")
    DIM ky AS INTEGER
    ky = hb(0.342)
    hud_keycell(ix0 + kw \ 2, ky, T_KEY_BLUE, keys_blue)
    hud_keycell(ix0 + kw \ 2 + kw, ky, T_KEY_RED, keys_red)
    hud_keycell(ix0 + kw \ 2 + kw * 2, ky, T_KEY_GREEN, keys_green)
    hud_keycell(ix0 + kw \ 2 + kw * 3, ky, T_KEY_YELLOW, keys_yellow)

    ' --- Ausruestung-Panel ---
    hud_panel(ix0, hb(0.444), ix1, hb(0.574))
    hud_label(cxp, hb(0.463), "AUSRUESTUNG")
    DIM sy AS INTEGER
    sy = hb(0.490)
    hud_slot(ix0 + kw \ 2, sy, T_FLIPPERS, has_flippers)
    hud_slot(ix0 + kw \ 2 + kw, sy, T_FIREBOOTS, has_fireboots)
    hud_slot(ix0 + kw \ 2 + kw * 2, sy, T_ICESKATES, has_iceskates)
    hud_slot(ix0 + kw \ 2 + kw * 3, sy, T_SUCTION, has_suction)

    ' --- Zeit/Best-Panel ---
    hud_panel(ix0, hb(0.590), ix1, hb(0.718))
    hud_label(cxp, hb(0.608), "ZEIT")
    IF lvl_time > 0 THEN
        ct(cxp, hb(0.652), sc_big, fmt_time(time_left), RGB(244, 222, 120))
    ELSE
        ct(cxp, hb(0.652), sc_med, "frei", RGB(184, 194, 214))
    END IF

    IF lvl_best >= 0 THEN
        ct(cxp, hb(0.700), sc_sm, "Bestzeit  " + score_label(lvl_best), RGB(180, 200, 214))
    ELSE
        ct(cxp, hb(0.700), sc_sm, "noch keine Bestzeit", RGB(108, 122, 148))
    END IF

    ' --- Audio-Panel (Lautstaerke-Slider: Maus oder F1-F4) ---
    hud_panel(ix0, hb(0.728), ix1, hb(0.900))
    hud_label(cxp, hb(0.747), "LAUTSTAERKE")
    draw_slider(sl_my, "Musik", music_vol)
    draw_slider(sl_sy, "Effekte", sfx_vol)
    ct(cxp, hb(0.886), sc_sm * 0.70, "Maus  -  F1/F2 Musik  -  F3/F4 Effekte", RGB(98, 112, 140))

    ' --- Loesungs-Aufzeichnung ---
    IF demo_mode = 1 THEN
        ct(cxp, hb(0.912), sc_sm * 0.78, "* AUFNAHME  (F5 beendet)", RGB(240, 110, 110))
    ELSEIF demo_mode = 2 THEN
        ct(cxp, hb(0.912), sc_sm * 0.78, "> WIEDERGABE  (Taste uebernimmt)", RGB(120, 220, 160))
    END IF

    ' --- Footer (Steuerung) ---
    ct(cxp, hb(0.928), sc_sm * 0.78, "Pfeile / WASD bewegen", RGB(122, 136, 162))
    ct(cxp, hb(0.962), sc_sm * 0.78, "R neu  -  P Passwort  -  M Musik  -  ESC Menue", RGB(110, 124, 150))
END SUB

' Hinweis-Banner, wenn der Spieler auf einem Fragezeichen-Stein steht
SUB draw_hint()
    IF LEN(lvl_hint) = 0 THEN RETURN
    DIM bx0 AS INTEGER
    DIM bx1 AS INTEGER
    DIM by0 AS INTEGER
    DIM by1 AS INTEGER
    bx0 = board_x
    bx1 = board_x + bsize
    by1 = board_y + bsize
    by0 = by1 - INT(SH * 0.20)
    glas_karte(bx0 + 10, by0, bx1 - 10, by1 - 10, RGB(80, 200, 220))
    glow_text((bx0 + bx1) \ 2, by0 + INT(SH * 0.035), sc_sm, "HINWEIS", RGB(110, 238, 226))
    draw_wrapped(lvl_hint, bx0 + INT(SW * 0.02), by0 + INT(SH * 0.08), bx1 - INT(SW * 0.02), RGB(206, 220, 236))
END SUB

' Glas-Karte: halbdurchsichtig, abgerundet, Neon-Rand mit weichem Schein.
SUB glas_karte(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER, rand AS INTEGER)
    DIM r AS INTEGER : r = (rand SHR 16) BAND 255
    DIM g AS INTEGER : g = (rand SHR 8) BAND 255
    DIM b AS INTEGER : b = rand BAND 255
    DIM i AS INTEGER
    FOR i = 1 TO 5
        RECTROUND(x0 - i * 2, y0 - i * 2, x1 + i * 2, y1 + i * 2, 14 + i * 2, RGBA(r, g, b, 40 - i * 7))
    NEXT
    BOXROUND(x0, y0, x1, y1, 14, RGBA(10, 14, 24, 236))
    RECTROUND(x0, y0, x1, y1, 14, RGBA(r, g, b, 210))
END SUB

' Leuchtschrift: ein weicher Schein in der Farbe, darueber die Schrift.
SUB glow_text(cx AS INTEGER, cy AS INTEGER, scale AS FLOAT, s AS STRING, col AS INTEGER)
    DIM r AS INTEGER : r = (col SHR 16) BAND 255
    DIM g AS INTEGER : g = (col SHR 8) BAND 255
    DIM b AS INTEGER : b = col BAND 255
    DIM d AS INTEGER : d = MAX(2, INT(SH * 0.0025))
    BLEND_MODE("add")
    TEXTROT(cx - d, cy, s, 0, scale, RGBA(r, g, b, 60))
    TEXTROT(cx + d, cy, s, 0, scale, RGBA(r, g, b, 60))
    TEXTROT(cx, cy - d, s, 0, scale, RGBA(r, g, b, 60))
    TEXTROT(cx, cy + d, s, 0, scale, RGBA(r, g, b, 60))
    BLEND_MODE("alpha")
    TEXTROT(cx, cy, s, 0, scale, col)
END SUB

' Die Bewohner des Spiels laufen am unteren Rand vorbei: der Runner vorweg,
' die Roboter hinterher.
SUB parade(y AS INTEGER)
    DIM g AS INTEGER : g = INT(SH * 0.075)
    DIM abstand AS INTEGER : abstand = INT(g * 1.6)
    DIM n AS INTEGER : n = 10
    DIM laenge AS INTEGER : laenge = SW + (n + 2) * abstand
    DIM kopf AS INTEGER : kopf = INT(fx_zeit * SH * 0.11) + SW
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM code AS INTEGER
        DIM luecke AS INTEGER : luecke = 0
        IF i = 0 THEN
            code = IIF(INT(fx_zeit * 6.0) MOD 2 = 0, T_CHIP_N + 3, &H70 + 3)
        ELSE
            code = &H40 + ((i - 1) MOD 9) * 4 + 3
            luecke = abstand
        END IF
        DIM x AS INTEGER : x = kopf - i * abstand - luecke
        x = ((x MOD laenge) + laenge) MOD laenge - (n + 1) * abstand
        DIM hop AS INTEGER : hop = INT(ABS(SIN(fx_zeit * 7.0 + i * 0.8)) * g * 0.10)
        ELLIPSE(x + g \ 5, y + g - g \ 10, x + g - g \ 5, y + g + g \ 12, RGBA(0, 0, 0, 90))
        DRAWIMAGEPARTEX(tiles, (code MOD 16) * KP, (code \ 16) * KP, KP, KP, x, y - hop, g, g)
    NEXT
END SUB

SUB draw_menu()
    DIM cx AS INTEGER
    cx = SW \ 2
    glow_text(cx, INT(SH * 0.13), sc_big * 1.25, "CIRCUIT RUNNER", RGB(110, 238, 226))
    ct(cx, INT(SH * 0.215), sc_sm, "waehle ein Level-Set", RGB(150, 162, 184))
    parade(INT(SH * 0.70))
    IF LEN(sets) = 0 THEN
        ct(cx, SH \ 2, sc_med, "Keine Sets in levels/", RGB(245, 130, 130))
        RETURN
    END IF

    DIM lo AS INTEGER
    lo = sel_set - 3
    IF lo < 0 THEN lo = 0
    DIM hi AS INTEGER
    hi = lo + 6
    IF hi > LEN(sets) - 1 THEN hi = LEN(sets) - 1
    DIM yy AS INTEGER
    yy = INT(SH * 0.34)
    DIM lh AS INTEGER
    lh = INT(BASEH * sc_med * 1.7)
    DIM kb AS INTEGER : kb = INT(SW * 0.21)
    glas_karte(cx - kb, yy - lh, cx + kb, yy + (hi - lo) * lh + lh, RGB(70, 190, 210))
    DIM si AS INTEGER
    FOR si = lo TO hi
        DIM lab AS STRING
        lab = sets[si].name + "    " + STR$(sets[si].anzahl) + " Level"
        DIM col AS INTEGER
        col = RGB(160, 172, 196)
        IF si = sel_set THEN
            BOXROUND(cx - kb + 12, yy - lh \ 2 + 4, cx + kb - 12, yy + lh \ 2 - 4, 10, RGBA(80, 230, 170, 40))
            RECTROUND(cx - kb + 12, yy - lh \ 2 + 4, cx + kb - 12, yy + lh \ 2 - 4, 10, RGBA(110, 244, 170, 150))
            col = RGB(140, 250, 180)
        END IF

        ct(cx, yy, sc_med, lab, col)
        yy = yy + lh
    NEXT

    DIM mx AS INTEGER
    mx = SAVE_GET_INT_OR(sav, set_key(sets[sel_set].name) + "/max", 0)
    DIM hint AS STRING
    hint = "Pfeile waehlen   LEER = Start   P = Passwort   ESC = Ende"
    IF mx > 0 THEN
        DIM nx AS INTEGER
        nx = mx + 1
        IF nx > sets[sel_set].anzahl THEN nx = sets[sel_set].anzahl
        ct(cx, INT(SH * 0.82), sc_sm, "Fortschritt: Level " + STR$(mx) + " / " + STR$(sets[sel_set].anzahl), RGB(150, 200, 240))
        hint = "LEER = Start   C = Weiter ab Level " + STR$(nx) + "   P = Passwort   ESC = Ende"
    END IF

    ct(cx, INT(SH * 0.90), sc_sm, hint, RGB(170, 182, 206))
    DIM mhint AS STRING
    mhint = "M = Musik an"
    IF music_on THEN mhint = "M = Musik aus"
    mhint = mhint + "      T = Feind-Tempo: " + tempo_name()
    ct(cx, INT(SH * 0.95), sc_sm, mhint, RGB(120, 134, 160))
END SUB

SUB draw_intro()
    DIM cx AS INTEGER
    cx = SW \ 2
    glas_karte(INT(SW * 0.14), INT(SH * 0.14), INT(SW * 0.86), INT(SH * 0.66), RGB(70, 190, 210))
    ct(cx, INT(SH * 0.22), sc_med, "Level " + STR$(cur_level + 1), RGB(110, 238, 226))
    glow_text(cx, INT(SH * 0.33), sc_big, lvl_title, RGB(232, 238, 248))
    DIM eckdaten AS STRING
    eckdaten = STR$(chips_total) + " Daten-Chips     Zeit: " + IIF(lvl_time > 0, fmt_time(lvl_time), "frei")
    ct(cx, INT(SH * 0.40), sc_sm, eckdaten, RGB(150, 200, 240))
    parade(INT(SH * 0.74))
    IF lvl_best >= 0 THEN
        ct(cx, INT(SH * 0.45), sc_sm, "Bestzeit  " + score_label(lvl_best), RGB(244, 222, 120))
    END IF

    IF LEN(lvl_hint) > 0 THEN
        draw_wrapped(lvl_hint, INT(SW * 0.16), INT(SH * 0.52), INT(SW * 0.84), RGB(184, 196, 216))
    END IF

    ct(cx, INT(SH * 0.85), sc_med, "LEER = los", RGB(200, 214, 232))
    ct(cx, INT(SH * 0.91), sc_sm, "P = Passwort      ESC = Menue", RGB(150, 162, 184))
END SUB

SUB draw_password()
    DIM cx AS INTEGER
    cx = SW \ 2
    glow_text(cx, INT(SH * 0.22), sc_med, "PASSWORT", RGB(110, 238, 226))
    ct(cx, INT(SH * 0.31), sc_sm, "Set: " + sets[sel_set].name, RGB(150, 162, 184))

    ' Eingabefeld
    DIM disp AS STRING
    disp = pw_input

    ' blinkender Cursor
    IF (INT(MILLIS() / 400) MOD 2) = 0 AND LEN(pw_input) < 9 THEN disp = disp + "_"
    IF LEN(disp) = 0 THEN disp = " "
    DIM by0 AS INTEGER
    by0 = INT(SH * 0.40)
    DIM bw AS INTEGER
    bw = INT(SW * 0.30)
    glas_karte(cx - bw \ 2, by0, cx + bw \ 2, by0 + INT(SH * 0.10), RGB(80, 200, 220))
    ct(cx, by0 + INT(SH * 0.05), sc_big, disp, RGB(232, 238, 248))
    IF LEN(pw_msg) > 0 THEN
        ct(cx, INT(SH * 0.60), sc_med, pw_msg, RGB(245, 130, 130))
    END IF

    ct(cx, INT(SH * 0.85), sc_sm, "tippen      ENTER = los      ESC = zurueck", RGB(170, 182, 206))
END SUB

SUB draw_done()
    DIM cx AS INTEGER
    cx = SW \ 2
    glow_text(cx, INT(SH * 0.34), sc_big, "ALLE LEVEL GESCHAFFT!", RGB(120, 244, 160))
    parade(INT(SH * 0.76))
    ct(cx, INT(SH * 0.50), sc_med, "Gut gemacht, Runner.", RGB(224, 230, 240))
    ct(cx, INT(SH * 0.64), sc_med, "LEER = Menue", RGB(200, 214, 232))
END SUB

' Sieg/Tod: eine Glas-Karte mitten ueber dem Brett -- das Brett bleibt
' darunter zu sehen.
SUB draw_overlay(kind AS STRING)
    DIM cx AS INTEGER : cx = board_x + bsize \ 2
    DIM cy AS INTEGER : cy = board_y + bsize \ 2
    DIM hb2 AS INTEGER : hb2 = INT(bsize * 0.40)
    DIM x0 AS INTEGER : x0 = cx - hb2
    DIM x1 AS INTEGER : x1 = cx + hb2
    DIM zl AS INTEGER : zl = INT(BASEH * sc_sm * 1.7)
    IF kind = "win" THEN
        DIM y0 AS INTEGER : y0 = cy - INT(bsize * 0.17)
        DIM y1 AS INTEGER : y1 = cy + INT(bsize * 0.17)
        glas_karte(x0, y0, x1, y1, RGB(80, 222, 142))
        DIM yy AS INTEGER : yy = y0 + INT(bsize * 0.065)
        glow_text(cx, yy, sc_big, "GESCHAFFT!", RGB(120, 244, 160))
        yy = yy + INT(zl * 1.6)
        ct(cx, yy, sc_med, "Zeit  " + score_label(win_secs), RGB(224, 234, 228))
        yy = yy + zl
        IF new_record THEN
            glow_text(cx, yy, sc_sm, "NEUER REKORD!", RGB(244, 222, 120))
        ELSEIF lvl_best >= 0 THEN
            ct(cx, yy, sc_sm, "Bestzeit  " + score_label(lvl_best), RGB(180, 200, 214))
        END IF
        yy = yy + zl
        IF LEN(next_pw) > 0 THEN
            ct(cx, yy, sc_sm, "Passwort Level " + STR$(cur_level + 2) + ":  " + next_pw, RGB(110, 238, 226))
        END IF
        ct(cx, y1 - INT(zl * 0.9), sc_med, "LEER = weiter", RGB(204, 224, 214))
    ELSE
        DIM ty0 AS INTEGER : ty0 = cy - INT(bsize * 0.11)
        DIM ty1 AS INTEGER : ty1 = cy + INT(bsize * 0.11)
        glas_karte(x0, ty0, x1, ty1, RGB(224, 92, 92))
        glow_text(cx, cy - zl \ 2, sc_med, death_msg, RGB(250, 140, 140))
        ct(cx, cy + INT(zl * 0.9), sc_sm, "R / LEER = nochmal", RGB(232, 204, 204))
    END IF
END SUB

SUB draw_wrapped(s AS STRING, x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, col AS INTEGER)
    DIM words AS ARRAY OF STRING
    words = SPLIT$(s, " ")
    DIM line AS STRING
    line = ""
    DIM yy AS INTEGER
    yy = y0
    DIM maxw AS FLOAT
    maxw = (x1 - x0) * 1.0
    DIM lh AS INTEGER
    lh = INT(BASEH * sc_sm * 1.5)
    DIM cxm AS INTEGER
    cxm = (x0 + x1) \ 2
    DIM i AS INTEGER
    FOR i = 0 TO LEN(words) - 1
        DIM cand AS STRING
        IF LEN(line) = 0 THEN
            cand = words[i]
        ELSE
            cand = line + " " + words[i]
        END IF

        IF TEXT_WIDTH(cand) * sc_sm > maxw AND LEN(line) > 0 THEN
            ct(cxm, yy, sc_sm, line, col)
            yy = yy + lh
            line = words[i]
        ELSE
            line = cand
        END IF
    NEXT

    IF LEN(line) > 0 THEN ct(cxm, yy, sc_sm, line, col)
END SUB

' ----------------------------------------------------------------------
'  EINGABE
' ----------------------------------------------------------------------
SUB read_intent()
    ' Tastendruck (Tap) puffern -- bleibt bis zum naechsten Tick erhalten,
    ' damit einzelne Schritte/Kistenschuebe nicht zwischen den Ticks verloren gehen.
    IF INPUT_PRESSED("up") THEN buf_dir = 0
    IF INPUT_PRESSED("left") THEN buf_dir = 1
    IF INPUT_PRESSED("down") THEN buf_dir = 2
    IF INPUT_PRESSED("right") THEN buf_dir = 3

    ' aktuell gehaltene Richtung (fuer Dauerlauf)
    held_dir = -1
    IF INPUT_HELD("up") THEN held_dir = 0
    IF INPUT_HELD("left") THEN held_dir = 1
    IF INPUT_HELD("down") THEN held_dir = 2
    IF INPUT_HELD("right") THEN held_dir = 3
END SUB

' ======================================================================
'  INITIALISIERUNG
' ======================================================================
IF FULLSCREEN THEN
    SCREEN_NATIVE("Circuit Runner")
ELSE
    SCREEN(1280, 800, "Circuit Runner")
END IF

SETFPS(60)
WINDOW_ESC_QUIT(FALSE)

' Eigenes Fenstersymbol statt des Standardsymbols der Laufzeit: der Daten-Chip
' aus dem Kachelsatz (Kachel T_CHIP, also Spalte 2 der obersten Zeile).
' Kachelgroesse im Blatt aus tiles.json (make_tiles.dh schreibt sie mit)
DIM kachel_js AS JSON_HANDLE : kachel_js = JSON_LOAD("assets/tiles.json")
KP = JSON_GET_INT(kachel_js, "tile")
DIM icon_sheet AS IMAGE : icon_sheet = LOADIMAGE("assets/tiles.png")
WINDOW_ICON(IMAGE_CROP(icon_sheet, T_CHIP * KP, 0, KP, KP))

SW = SCREENWIDTH()
SH = SCREENHEIGHT()

' Board so gross wie moeglich -- stufenlos, die Kacheln werden weich
' gefiltert (bis 2026-11 nur ganzzahlig vergroessert: auf 1080p blieb das
' Brett bei 576 Punkten). HUD rechts daneben.
bsize = (SH * 92) \ 100
IF bsize > (SW * 58) \ 100 THEN bsize = (SW * 58) \ 100
ts = bsize / VIEW
board_x = INT(SW * 0.04)
board_y = (SH - bsize) \ 2
hud_x = board_x + bsize + INT(SW * 0.03)
hud_w = SW - hud_x - INT(SW * 0.04)

dxv[0] = 0
dyv[0] = -1
dxv[1] = -1
dyv[1] = 0
dxv[2] = 0
dyv[2] = 1
dxv[3] = 1
dyv[3] = 0

rtb = RENDERTARGET_NEW(bsize, bsize)
tiles = LOADIMAGE("assets/tiles.png")
IMAGE_MIPMAPS(tiles)          ' weich verkleinern statt Pixeltreppe

' Soundeffekte laden (fehlt der Ordner, faellt sfx_* auf Synth-Toene zurueck)
snd_ok = FALSE
TRY
    snd_step = LOADSOUND("assets/sfx/step.wav")
    snd_chip = LOADSOUND("assets/sfx/chip.wav")
    snd_door = LOADSOUND("assets/sfx/door.wav")
    snd_block = LOADSOUND("assets/sfx/block.wav")
    snd_die = LOADSOUND("assets/sfx/die.wav")
    snd_win = LOADSOUND("assets/sfx/win.wav")
    snd_blocked = LOADSOUND("assets/sfx/blocked.wav")
    snd_ok = TRUE
CATCH e
    snd_ok = FALSE
END TRY

' Hintergrundmusik vorhanden? (streamt via PLAYMUSIC, kein Preload)
music_ok = FILEEXISTS(MUS_TITLE) AND FILEEXISTS("assets/music/level1.ogg")
music_on = TRUE
cur_music = ""

' Lautstaerken (Bus-Pegel) -- per HUD-Slider einstellbar
music_vol = 0.5
sfx_vol = 0.9
AUDIO_BUS_VOLUME("music", music_vol)
AUDIO_BUS_VOLUME("sfx", sfx_vol)

' Slider-Geometrie im Audio-Panel (einmalig, Layout ist statisch)
sl_h = INT(SH * 0.015)
DIM sl_lw AS INTEGER
DIM sl_pw AS INTEGER
sl_lw = INT(hud_w * 0.24)
sl_pw = INT(hud_w * 0.15)
sl_lblx = hud_x + INT(SH * 0.018) + sl_lw \ 2
sl_x0 = hud_x + INT(SH * 0.018) + sl_lw
sl_x1 = hud_x + hud_w - INT(SH * 0.018) - sl_pw
sl_pctx = hud_x + hud_w - INT(SH * 0.018) - sl_pw \ 2
sl_my = hb(0.793)
sl_sy = hb(0.850)

' Font (eine TTF; Skalierung via TEXTROT, da LOADFONT-Groesse fix)
gfont = LOADFONT("assets/font.ttf", 64)
SETFONT(gfont)
TEXT_SIZE(20)
BASEH = 26
sc_big = SH / 470.0
sc_med = SH / 760.0
sc_sm = SH / 1040.0

' HUD-Icons vorskalieren (scharf in nativer Aufloesung)
ic_sz = INT(SH * 0.044)

scan_sets()
sel_set = 0
sav = SAVE_LOAD_OR_NEW(SAVEPATH)
SAVE_SET_VERSION(sav, 1)
mon_takt = SAVE_GET_INT_OR(sav, "einstellung/feindtempo", TAKT_RUHIG)
IF mon_takt <> TAKT_ORIGINAL THEN mon_takt = TAKT_RUHIG
cur_setkey = ""
lvl_best = -1
pw_input = ""
pw_msg = ""

' Tastatur UND Gamepad auf dieselben Aktionen -- das input-Modul nimmt beide
' Sorten Codes in einem Aufruf, die Spiellogik merkt keinen Unterschied.
INPUT_BIND("up", KEY_UP, KEY_W, JOY_DPAD_UP)
INPUT_BIND("down", KEY_DOWN, KEY_S, JOY_DPAD_DOWN)
INPUT_BIND("left", KEY_LEFT, KEY_A, JOY_DPAD_LEFT)
INPUT_BIND("right", KEY_RIGHT, KEY_D, JOY_DPAD_RIGHT)
INPUT_BIND("confirm", KEY_SPACE, KEY_ENTER, JOY_BUTTON_A, JOY_BUTTON_START)
INPUT_BIND("restart", KEY_R, JOY_BUTTON_Y)
INPUT_BIND("skip", KEY_N)
INPUT_BIND("back", KEY_ESCAPE, JOY_BUTTON_B)
INPUT_BIND("password", KEY_P)
INPUT_BIND("delchar", KEY_BACKSPACE)
INPUT_BIND("continue", KEY_C)
INPUT_BIND("mute", KEY_M)
INPUT_BIND("tempo", KEY_T)
INPUT_BIND("mus_down", KEY_F1)
INPUT_BIND("mus_up", KEY_F2)
INPUT_BIND("sfx_down", KEY_F3)
INPUT_BIND("sfx_up", KEY_F4)
INPUT_BIND("demo_rec", KEY_F5)     ' Loesung aufzeichnen (nochmal = beenden)
INPUT_BIND("demo_play", KEY_F6)    ' aufgezeichnete Loesung abspielen

state = "menu"
cur_level = 0
want_dir = -1
buf_dir = -1
held_dir = -1
anim_frame = 0
anim_ms = 0.0

' ======================================================================
'  HAUPTSCHLEIFE
' ======================================================================
WHILE NOT QUITREQUESTED()
    ' --- Pause, wenn das Fenster nicht im Vordergrund ist ---------------
    ' Wichtig ist hier nicht nur das Anhalten: Die Level-Uhr rechnet mit
    ' MILLIS() -- der Wanduhr. Ohne Korrektur laeuft die Zeit weiter, waehrend
    ' der Spieler in einem anderen Fenster ist, und er kommt in ein
    ' abgelaufenes Level zurueck. Deshalb merken wir uns den Beginn der Pause
    ' und schieben den Level-Startzeitpunkt anschliessend um dieselbe Dauer.
    IF NOT WINDOW_FOCUSED() THEN
        DIM pause_ms AS INTEGER : pause_ms = MILLIS()
        WHILE NOT WINDOW_FOCUSED() AND NOT QUITREQUESTED()
            hintergrund()
            ct(SCREENWIDTH() \ 2, SCREENHEIGHT() \ 2, 3.0, "PAUSE", RGB(244, 222, 120))
            FLIP()
        WEND
        start_ms = start_ms + (MILLIS() - pause_ms)
    END IF

    INPUT_UPDATE()
    funken_weiter(MIN(DELTA(), 0.1))
    anim_ms = anim_ms + DELTA() * 1000.0
    IF anim_ms >= 520.0 THEN anim_ms = anim_ms - 520.0
    anim_frame = INT(anim_ms / 130.0) MOD 4

    ' Hintergrundmusik: Titel im Menue, rotierende Level-Loops im Spiel, Ending am Ziel
    IF INPUT_PRESSED("mute") THEN toggle_music()
    IF INPUT_PRESSED("mus_down") THEN adjust_music(-0.1)
    IF INPUT_PRESSED("mus_up") THEN adjust_music(0.1)
    IF INPUT_PRESSED("sfx_down") THEN adjust_sfx(-0.1)
    IF INPUT_PRESSED("sfx_up") THEN adjust_sfx(0.1)
    IF state = "done" THEN
        set_music(MUS_ENDING)
    ELSEIF state = "intro" OR state = "play" OR state = "win" OR state = "dead" THEN
        set_music(music_for_level())
    ELSE
        set_music(MUS_TITLE)
    END IF

    ' Lautstaerke-Slider sind nur sichtbar, wenn das HUD gezeichnet wird
    IF state = "play" OR state = "win" OR state = "dead" THEN
        update_volume()
    ELSE
        set_cursor("default")   ' ohne HUD gibt es nichts zum Anfassen
    END IF

    ' --- Loesungs-Aufzeichnung ------------------------------------------
    IF demo_mode > 0 THEN demo_frames = demo_frames + 1
    IF demo_mode = 2 AND NOT AUTOMATION_PLAYING() THEN demo_mode = 0
    ' Echte Eingabe uebernimmt: KEY_ANY_HIT meldet bewusst NUR echte Tasten,
    ' die von der Wiedergabe eingespeisten blendet die Laufzeit aus -- sonst
    ' braeche die Wiedergabe an ihrem eigenen ersten Zug ab.
    IF demo_mode = 2 AND KEY_ANY_HIT() <> -1 THEN demo_stop()
    IF state = "play" OR state = "intro" OR state = "dead" OR state = "win" THEN
        IF INPUT_PRESSED("demo_rec") THEN
            IF demo_mode = 1 THEN demo_stop() ELSE demo_start(1)
        ELSEIF INPUT_PRESSED("demo_play") AND demo_mode <> 2 THEN
            demo_start(2)
        END IF
    END IF

    IF state = "menu" THEN
        IF INPUT_PRESSED("back") THEN BREAK
        IF INPUT_PRESSED("tempo") THEN tempo_umschalten()
        IF INPUT_PRESSED("up") AND sel_set > 0 THEN sel_set = sel_set - 1
        IF INPUT_PRESSED("down") AND sel_set < LEN(sets) - 1 THEN sel_set = sel_set + 1
        IF INPUT_PRESSED("confirm") AND LEN(sets) > 0 THEN
            set_laden()
            cur_level = 0
            load_level(cur_level)
            state = "intro"
        END IF

        IF INPUT_PRESSED("password") AND LEN(sets) > 0 THEN
            set_laden()
            pw_input = ""
            pw_msg = ""
            state = "password"
        END IF

        IF INPUT_PRESSED("continue") AND LEN(sets) > 0 THEN
            cur_setkey = set_key(sets[sel_set].name)
            IF SAVE_GET_INT_OR(sav, cur_setkey + "/max", 0) > 0 THEN
                set_laden()
                cur_level = SAVE_GET_INT_OR(sav, cur_setkey + "/max", 0)
                IF cur_level > nlevels - 1 THEN cur_level = nlevels - 1
                IF cur_level < 0 THEN cur_level = 0
                load_level(cur_level)
                state = "intro"
            END IF
        END IF
    ELSEIF state = "password" THEN
        update_password()
    ELSEIF state = "intro" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"
        IF INPUT_PRESSED("confirm") THEN state = "play"
        IF INPUT_PRESSED("password") THEN
            pw_input = ""
            pw_msg = ""
            state = "password"
        END IF
    ELSEIF state = "play" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"
        IF INPUT_PRESSED("restart") THEN load_level(cur_level)
        IF INPUT_PRESSED("skip") THEN
            cur_level = cur_level + 1
            IF cur_level >= nlevels THEN
                state = "done"
            ELSE
                load_level(cur_level)
                state = "intro"
            END IF
        END IF

        IF state = "play" THEN
            read_intent()
            ' Waehrend Aufnahme/Wiedergabe zaehlt das Spiel BILDER statt
            ' Sekunden -- sonst faellt ein Zug je nach Bildrate mal in den
            ' einen, mal in den naechsten Spielschritt.
            IF demo_mode > 0 THEN
                tick_timer = tick_timer + 1000.0 / 60.0
            ELSE
                tick_timer = tick_timer + DELTA() * 1000.0
            END IF
            IF tick_timer > TICK_MS * 3.0 THEN tick_timer = TICK_MS
            IF tick_timer >= TICK_MS AND state = "play" THEN
                tick_timer = tick_timer - TICK_MS
                want_dir = buf_dir
                IF want_dir < 0 THEN want_dir = held_dir
                buf_dir = -1
                world_tick()
            END IF

            anim_t = tick_timer / TICK_MS
            IF anim_t > 1.0 THEN anim_t = 1.0
        END IF
    ELSEIF state = "win" THEN
        IF INPUT_PRESSED("confirm") THEN
            cur_level = cur_level + 1
            IF cur_level >= nlevels THEN
                state = "done"
            ELSE
                load_level(cur_level)
                state = "intro"
            END IF
        END IF
    ELSEIF state = "dead" THEN
        IF INPUT_PRESSED("confirm") OR INPUT_PRESSED("restart") THEN
            load_level(cur_level)
            state = "play"
        END IF

        IF INPUT_PRESSED("back") THEN state = "menu"
    ELSEIF state = "done" THEN
        IF INPUT_PRESSED("confirm") THEN state = "menu"
    END IF

    ' --- Render ---
    IF state = "play" OR state = "win" OR state = "dead" THEN
        RENDERTARGET_BEGIN(rtb)
        draw_board()
        RENDERTARGET_END()
    END IF

    hintergrund()
    IF state = "menu" THEN
        draw_menu()
    ELSEIF state = "password" THEN
        draw_password()
    ELSEIF state = "intro" THEN
        draw_intro()
    ELSEIF state = "done" THEN
        draw_done()
    ELSE
        ' Beim Tod wackelt das Brett kurz.
        DIM wx AS INTEGER : wx = 0
        DIM wy AS INTEGER : wy = 0
        IF state = "dead" AND schreck_t < 0.35 THEN
            DIM wst AS FLOAT : wst = (0.35 - schreck_t) * SH * 0.03
            wx = INT(SIN(schreck_t * 90.0) * wst)
            wy = INT(COS(schreck_t * 70.0) * wst)
        END IF
        brett_rahmen(board_x + wx, board_y + wy)
        RENDERTARGET_DRAW(rtb, board_x + wx, board_y + wy, 1)
        draw_hud()
        IF state = "play" AND tat(px, py) = T_HINT THEN draw_hint()
        IF state = "win" THEN draw_overlay("win")
        IF state = "dead" THEN draw_overlay("dead")
    END IF

    FLIP()
WEND
