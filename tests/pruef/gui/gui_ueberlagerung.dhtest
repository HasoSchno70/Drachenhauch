WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(anders) THEN an = TRUE
    n = n + 1
    IF n = 40 THEN PRINT "anders " + STR$(an)
    CLS(&H101820)
    GUI_DRAW()
