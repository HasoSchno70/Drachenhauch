=== stereo und amiga-pan legen den ersten kanal nach links
' Zwei Kanaele, links mehr als dreimal so laut wie rechts -- gelesen aus den
' Bytes der WAV (RIFF-Kopf, 16 Bit), nicht mit Pythons `wave`.
SET_WINDOW_POS(-3000, -3000)
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
DIM prFlag AS STRING : prFlag = ""
DIM prMax AS INTEGER : prMax = -1
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prEinmal(schluessel AS STRING, z AS STRING)
    IF INSTR(prFlag, "|" + schluessel + " ") < 0 THEN prFlag = prFlag + "|" + schluessel + " " + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
--- programm ../../examples/190_tracker.dh nach SETFPS(60)
--- einschub nach FLIP()
prSchreib("")

--- einschub nach bildNr = bildNr + 1
IF bildNr = 3 THEN
    zelleSetzen(0, 0, 0, 60)
    renderStereo = TRUE : renderAmiga = TRUE
    wavRendern("out.wav")
END IF

--- umgebung
DHRT_FRAMES=6
--- nachher
DIM w AS BUFFER : w = READALL_BYTES("_programm/out.wav")
DIM fmt AS INTEGER : fmt = BUFFER_INDEXOF(w, BUFFER_FROM_STRING("fmt "))
DIM kan AS INTEGER : kan = BUFFER_GET_U16(w, fmt + 10)
DIM bits AS INTEGER : bits = BUFFER_GET_U16(w, fmt + 22)
DIM dat AS INTEGER : dat = BUFFER_INDEXOF(w, BUFFER_FROM_STRING("data"))
DIM laenge AS INTEGER : laenge = BUFFER_GET_U32(w, dat + 4)
PRINT "kanaele " ; kan ; " bits " ; bits
DIM links AS INTEGER : links = 0
DIM rechts AS INTEGER : rechts = 0
DIM i AS INTEGER
DIM s AS INTEGER
FOR i = dat + 8 TO dat + 8 + laenge - 4 STEP 4
    s = ABS(BUFFER_GET_I16(w, i))
    IF s > links THEN links = s
    s = ABS(BUFFER_GET_I16(w, i + 2))
    IF s > rechts THEN rechts = s
NEXT
PRINT "links mehr als dreimal so laut " ; links > 3 * rechts
--- erwartet
kanaele 2 bits 16
links mehr als dreimal so laut TRUE

=== der gb-code laeuft durch check und startet
' Uebersetzen allein bewiese nichts -- er muss STARTEN. Lautstaerke 9/15 wird 60 %,
' der Drum-Kanal schreibt einen Schlag, keine Frequenz.
SET_WINDOW_POS(-3000, -3000)
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
DIM prFlag AS STRING : prFlag = ""
DIM prMax AS INTEGER : prMax = -1
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prEinmal(schluessel AS STRING, z AS STRING)
    IF INSTR(prFlag, "|" + schluessel + " ") < 0 THEN prFlag = prFlag + "|" + schluessel + " " + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
--- programm ../../examples/190_tracker.dh nach SETFPS(60)
--- einschub nach FLIP()
prSchreib("")

--- einschub nach bildNr = bildNr + 1
IF bildNr = 3 THEN
    zelleSetzen(0, 0, 0, 60) : vol[0, 0, 0] = 9 : slide[0, 0, 0] = 2
    zelleSetzen(0, 3, 4, 60)
    dhCodeSichern("song_gb.dh")
END IF

--- umgebung
DHRT_FRAMES=6
--- nachher
FUNCTION lesen$(pc AS INTEGER) AS STRING
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM r AS STRING : r = ""
    DIM stille AS INTEGER : stille = 0
    WHILE MILLIS() < bis AND stille < 5
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN r = r + zz : stille = 0
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
    WEND
    RETURN r
END FUNCTION
DIM z AS ARRAY OF STRING : z = READLINES("_programm/song_gb.dh")
DIM code AS STRING : code = ""
DIM i AS INTEGER
FOR i = 0 TO LEN(z) - 1
    code = code + z[i] + CHR$(10)
NEXT
PRINT "lautstaerke " ; INSTR(code, "trkV0[0] = 60") >= 0
PRINT "slide und sfx " ; INSTR(code, "trkSl0[0] =") >= 0 AND INSTR(code, "AUDIO_SFX(") >= 0
PRINT "drum schlag " ; INSTR(code, "trk3[4] = 1") >= 0
DIM befund AS STRING : befund = TRIM$(lesen$(PROCESS_START("dhrt", "--check", "_programm/song_gb.dh")))
PRINT "check sauber " ; befund = "" OR befund = "[]"
WRITEALL("lauf.dh", code + "DIM t AS INTEGER" + CHR$(10) + "FOR t = 1 TO 3" + CHR$(10) + "    TRACKER_UPDATE(130.0)" + CHR$(10) + "NEXT" + CHR$(10) + "PRINT trkRow" + CHR$(10))
DIM aus AS STRING : aus = TRIM$(lesen$(PROCESS_START("dhrt", "run", "lauf.dh")))
PRINT "gestartet, reihe " ; RIGHT$(aus, 1)
--- erwartet
lautstaerke TRUE
slide und sfx TRUE
drum schlag TRUE
check sauber TRUE
gestartet, reihe 3

=== die leertaste startet die uhr und stoppt sie wieder
' 120 BPM = eine Reihe je 125 ms = alle 7,5 Bilder; zwischen Bild 10 und 110
' muss der Kopf mindestens Reihe 8 erreichen, sonst laeuft die Uhr nicht in
' echter Zeit. Danach steht alles still (Kopf -1).
SET_WINDOW_POS(-3000, -3000)
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
DIM prFlag AS STRING : prFlag = ""
DIM prMax AS INTEGER : prMax = -1
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prEinmal(schluessel AS STRING, z AS STRING)
    IF INSTR(prFlag, "|" + schluessel + " ") < 0 THEN prFlag = prFlag + "|" + schluessel + " " + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
--- programm ../../examples/190_tracker.dh nach SETFPS(60)
--- einschub nach FLIP()
IF bildNr > 10 AND bildNr < 110 THEN
    IF NOT spielt THEN prMerke("stand zwischendurch still")
    IF kopfRow > prMax THEN prMax = kopfRow
END IF
prSchreib("kopf bis 8 " + prJa$(prMax >= 8) + " ende spielt " + prJa$(spielt) + " kopf " + STR$(kopfRow))

--- umgebung
DHRT_FRAMES=150
--- datei _programm/ev.txt
# Test-Aufnahme
c 5
e 0 7 0 0 0 0
e 5 2 32 0 0 0
e 6 1 32 0 0 0
e 120 2 32 0 0 0
e 121 1 32 0 0 0

--- inhalt _programm/probe.txt
|kopf bis 8 ja ende spielt nein kopf -1|

--- ohne _programm/probe.txt
|stand zwischendurch still|

