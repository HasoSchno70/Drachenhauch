=== oxs rundweg ueber glutfaden
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Ein Rundweg ist keine Identitaet: beim Lesen kommen bekannte Garne aus der
' Palette (bei PySticky genauso). Ab dem ersten Lesen bleibt alles stehen.
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
kern.oxsSpeichern(m, "eins.oxs")
DIM g1 AS kern.MusterImport : g1 = kern.oxsLaden("eins.oxs", pal, sym)
kern.oxsSpeichern(g1.muster, "zwei.oxs")
DIM g2 AS kern.MusterImport : g2 = kern.oxsLaden("zwei.oxs", pal, sym)
PRINT "muster: "; geVergleich$(geMuster$(g1.muster), geMuster$(g2.muster))
kern.oxsSpeichern(g2.muster, "drei.oxs")
PRINT "datei: "; geVergleich$(geLies$("zwei.oxs"), geLies$("drei.oxs"))
' der Name eines Garns ohne Palette waechst nicht (bei PySticky schon)
PRINT "name: "; g2.muster.farben[3].garn.name
DIM g AS kern.MusterImport
TRY
    g = kern.oxsLaden("probe.pxs", pal, sym)
CATCH e
    PRINT "kein xml: "; LEFT$(e, 24)
END TRY
WRITEALL("falsch.oxs", "<muster><a/></muster>")
TRY
    g = kern.oxsLaden("falsch.oxs", pal, sym)
CATCH e
    PRINT e
END TRY
WRITEALL("riesig.oxs", "<chart><chart_info><chartwidth value='3000'/><chartheight value='5'/></chart_info><palette/></chart>")
TRY
    g = kern.oxsLaden("riesig.oxs", pal, sym)
CATCH e
    PRINT e
END TRY
