' Muster aus Pattern Maker (.xsd), PCStitch (.pat) oder Open Cross Stitch
' (.oxs) importieren -- mit Vorschau, Angaben und den Warnungen, BEVOR das
' Muster uebernommen wird (PySticky PatternImportDialog, Strg+Alt+I). Das
' Oeffnen-Fenster und das Ablegen oeffnen diese Formate weiter direkt, wie in
' PySticky.

DIM fiDialog AS INTEGER
DIM fiDatei AS INTEGER                ' Beschriftung mit dem Dateinamen
DIM fiFlaeche AS INTEGER              ' Vorschau
DIM fiWerte AS ARRAY OF INTEGER       ' Name, Groesse, Farben, Stiche, Format
DIM fiRolle AS INTEGER                ' Meldungen (nur, wenn es welche gibt)
DIM fiMeldungen AS INTEGER
DIM fiErgebnis AS kern.MusterImport
DIM fiPfad AS STRING
DIM fiBild AS INTEGER                 ' cairo_surface_t der Vorschau, 0 = keins
DIM fiPuffer AS BUFFER

SUB fremdImportDialog(pfad AS STRING)
    IF NOT ungesichertFragen("Importieren") THEN RETURN
    fiErgebnis = NIL
    fiPfad = ""
    DIM d AS INTEGER : d = gtk_dialog_new_with_buttons(tr$("Muster importieren"), fenster, GTK_DIALOG_MODAL BOR GTK_DIALOG_EIGENE_LEISTE, _
        tr$("Abbrechen"), GTK_ANTWORT_ABBRECHEN, tr$("Importieren"), GTK_ANTWORT_OK, 0)
    fiDialog = d
    gtk_window_set_default_size(d, 480, -1)
    DIM innen AS INTEGER : innen = gtk_dialog_get_content_area(d)
    DIM s AS INTEGER : s = adSeite()
    gtk_box_pack_start(innen, s, TRUE, TRUE, 0)
    DIM t AS INTEGER : t = gtk_label_new(tr$("Importiere Kreuzstich-Muster aus Pattern Maker (.xsd), PCStitch (.pat) oder Open Cross Stitch (.oxs) Dateien."))
    gtk_label_set_line_wrap(t, TRUE)
    gtk_label_set_xalign(t, 0.0)
    gtkKlasse(t, "nebensache")
    gtk_box_pack_start(s, t, FALSE, FALSE, 0)
    ' Datei
    gtk_box_pack_start(s, adUeberschrift(tr$("Datei")), FALSE, FALSE, 0)
    DIM z AS INTEGER : z = gtk_box_new(GTK_WAAGERECHT, 8)
    fiDatei = gtk_label_new(tr$("Keine Datei ausgewählt"))
    gtk_label_set_xalign(fiDatei, 0.0)
    gtk_label_set_ellipsize(fiDatei, GTK_ELLIPSE_MITTE)
    gtk_widget_set_hexpand(fiDatei, TRUE)
    DIM k AS INTEGER : k = gtk_button_new_with_label(tr$("Durchsuchen …"))
    signal(k, "clicked", fiDurchsuchen, 0, 0, 0)
    gtk_box_pack_start(z, fiDatei, TRUE, TRUE, 0)
    gtk_box_pack_start(z, k, FALSE, FALSE, 0)
    gtk_box_pack_start(s, z, FALSE, FALSE, 0)
    ' Vorschau
    gtk_box_pack_start(s, adUeberschrift(tr$("Vorschau")), FALSE, FALSE, 0)
    fiFlaeche = gtk_drawing_area_new()
    gtk_widget_set_size_request(fiFlaeche, -1, 200)
    signalZeichnen(fiFlaeche, "draw", fiZeichnen, 0, 0, 0)
    gtk_box_pack_start(s, fiFlaeche, FALSE, FALSE, 0)
    ' Angaben
    gtk_box_pack_start(s, adUeberschrift(tr$("Informationen")), FALSE, FALSE, 0)
    DIM g AS INTEGER : g = gtk_grid_new()
    gtk_grid_set_column_spacing(g, 12)
    gtk_grid_set_row_spacing(g, 4)
    fiWerte = []
    DIM namen AS ARRAY OF STRING : namen = [tr$("Name:"), tr$("Größe:"), tr$("Farben:"), tr$("Stiche:"), tr$("Format:")]
    DIM i AS INTEGER
    FOR i = 0 TO 4
        DIM l AS INTEGER : l = gtk_label_new(namen[i])
        gtk_label_set_xalign(l, 0.0)
        gtkKlasse(l, "nebensache")
        DIM w AS INTEGER : w = gtk_label_new("-")
        gtk_label_set_xalign(w, 0.0)
        gtk_widget_set_hexpand(w, TRUE)
        gtk_label_set_ellipsize(w, GTK_ELLIPSE_ENDE)
        gtk_grid_attach(g, l, 0, i, 1, 1)
        gtk_grid_attach(g, w, 1, i, 1, 1)
        ARRAY_PUSH(fiWerte, w)
    NEXT
    gtk_box_pack_start(s, g, FALSE, FALSE, 0)
    ' Meldungen
    fiRolle = gtk_scrolled_window_new(0, 0)
    gtk_scrolled_window_set_policy(fiRolle, GTK_POLITIK_NIE, GTK_POLITIK_AUTO)
    gtk_scrolled_window_set_min_content_height(fiRolle, 80)
    fiMeldungen = gtk_text_view_new()
    gtk_text_view_set_editable(fiMeldungen, FALSE)
    gtk_text_view_set_cursor_visible(fiMeldungen, FALSE)
    gtk_text_view_set_wrap_mode(fiMeldungen, GTK_UMBRUCH_WORT)
    gtk_text_view_set_left_margin(fiMeldungen, 6)
    gtk_container_add(fiRolle, fiMeldungen)
    gtk_box_pack_start(s, fiRolle, FALSE, FALSE, 0)
    gtk_dialog_set_response_sensitive(d, GTK_ANTWORT_OK, FALSE)
    gtk_widget_show_all(d)
    gtk_widget_hide(fiRolle)
    IF pfad <> "" THEN fiLaden(pfad)
    DIM a AS INTEGER : a = gtk_dialog_run(d)
    DIM fi AS kern.MusterImport : fi = fiErgebnis
    fiDialog = 0
    gtk_widget_destroy(d)
    IF fiBild <> 0 THEN cairo_surface_destroy(fiBild) : fiBild = 0
    IF a <> GTK_ANTWORT_OK OR fi IS NIL THEN RETURN
    ' wie das Oeffnen eines fremden Formats: gesichert wird als .pxs
    musterZeigen(fi.muster, "", IIF(fi.muster.name <> "", fi.muster.name, BASENAME(fiPfad)))
    statusMeldung(fremdHinweis$(fi))
    zuletztMerken(fiPfad)
END SUB

SUB fiDurchsuchen(w AS INTEGER, daten AS INTEGER)
    DIM d AS INTEGER : d = gtk_file_chooser_dialog_new(tr$("Muster-Datei öffnen"), fiDialog, GTK_DATEI_OEFFNEN, _
        tr$("Abbrechen"), GTK_ANTWORT_ABBRECHEN, tr$("Öffnen"), GTK_ANTWORT_ANNEHMEN, 0)
    DIM ok AS BOOLEAN
    IF einstOrdner$() <> "" THEN ok = gtk_file_chooser_set_current_folder(d, einstOrdner$())
    DIM f AS INTEGER
    DIM namen AS ARRAY OF STRING : namen = [tr$("Kreuzstich-Muster (*.xsd, *.pat, *.oxs)"), tr$("Pattern Maker (*.xsd)"), tr$("PCStitch (*.pat)"), tr$("Open Cross Stitch (*.oxs)")]
    DIM muster AS ARRAY OF STRING : muster = ["*.xsd *.pat *.oxs", "*.xsd", "*.pat", "*.oxs"]
    DIM i AS INTEGER
    FOR i = 0 TO 3
        f = gtk_file_filter_new()
        gtk_file_filter_set_name(f, namen[i])
        DIM m AS STRING
        FOR EACH m IN SPLIT$(muster[i], " ")
            gtk_file_filter_add_pattern(f, m)
            gtk_file_filter_add_pattern(f, UPPER$(m))
        NEXT
        gtk_file_chooser_add_filter(d, f)
    NEXT
    DIM pfad AS STRING
    IF gtk_dialog_run(d) = GTK_ANTWORT_ANNEHMEN THEN
        DIM z AS INTEGER : z = gtk_file_chooser_get_filename(d)
        pfad = TEXT_AUS_ZEIGER$(z)
        g_free(z)
    END IF
    gtk_widget_destroy(d)
    IF pfad <> "" THEN fiLaden(pfad)
END SUB

' Lesen und anzeigen; Importieren erst, wenn das Lesen gelang
SUB fiLaden(pfad AS STRING)
    fiPfad = pfad
    gtk_label_set_text(fiDatei, BASENAME(pfad))
    DIM zeilen AS ARRAY OF STRING : zeilen = []
    TRY
        fiErgebnis = kern.fremdLaden(pfad, slPaletten, slSymbole)
    CATCH e
        fiErgebnis = NIL
        ARRAY_PUSH(zeilen, trf$("❌ FEHLER: Import-Fehler: {0}", [e]))
    END TRY
    DIM i AS INTEGER
    IF fiErgebnis IS NIL THEN
        FOR i = 0 TO 4 : gtk_label_set_text(fiWerte[i], "-") : NEXT
    ELSE
        DIM info AS ARRAY OF STRING : info = kern.fremdInfo(fiErgebnis)
        FOR i = 0 TO 4 : gtk_label_set_text(fiWerte[i], info[i]) : NEXT
        DIM wn AS STRING
        FOR EACH wn IN fiErgebnis.warnungen
            ARRAY_PUSH(zeilen, trf$("⚠️ Warnung: {0}", [wn]))
        NEXT
    END IF
    fiVorschauBauen()
    gtk_widget_queue_draw(fiFlaeche)
    IF LEN(zeilen) > 0 THEN
        gtk_text_buffer_set_text(gtk_text_view_get_buffer(fiMeldungen), JOIN$(zeilen, CHR$(10)), -1)
        gtk_widget_show(fiRolle)
    ELSE
        gtk_widget_hide(fiRolle)
    END IF
    gtk_dialog_set_response_sensitive(fiDialog, GTK_ANTWORT_OK, NOT (fiErgebnis IS NIL))
END SUB

' Das zusammengesetzte Bild: ein Punkt je Zelle, leer = weiss (PySticky
' _update_preview: eine Farbtafel, dann skaliert ohne Glaetten)
SUB fiVorschauBauen()
    IF fiBild <> 0 THEN cairo_surface_destroy(fiBild) : fiBild = 0
    IF fiErgebnis IS NIL THEN RETURN
    DIM m AS kern.Muster : m = fiErgebnis.muster
    DIM f AS ARRAY OF INTEGER, ta AS ARRAY OF INTEGER, ea AS ARRAY OF INTEGER
    m.ebenen.zusammensetzen(f, ta, ea)
    DIM n AS INTEGER : n = m.farbanzahl()
    DIM rgb[n + 1] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1 : rgb[i] = m.farben[i].garn.farbe : NEXT
    DIM zeile AS INTEGER : zeile = cairo_format_stride_for_width(CAIRO_ARGB32, m.breite)
    fiPuffer = BUFFER_NEW(zeile * m.hoehe)
    DIM x AS INTEGER, y AS INTEGER, c AS INTEGER
    FOR y = 0 TO m.hoehe - 1
        FOR x = 0 TO m.breite - 1
            c = f[y * m.breite + x]
            BUFFER_SET_U32(fiPuffer, y * zeile + x * 4, IIF(c >= 0 AND c < n, &HFF000000 BOR rgb[c], &HFFFFFFFF))
        NEXT
    NEXT
    fiBild = cairo_image_surface_create_for_data(BUFFER_ZEIGER(fiPuffer), CAIRO_ARGB32, m.breite, m.hoehe, zeile)
END SUB

FUNCTION fiZeichnen(w AS INTEGER, cr AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM b AS FLOAT : b = gtk_widget_get_allocated_width(w)
    DIM h AS FLOAT : h = gtk_widget_get_allocated_height(w)
    cairoFarbe(cr, uiFarbe(&H202228))
    cairo_paint(cr)
    IF fiBild = 0 OR fiErgebnis IS NIL THEN
        DIM layout AS INTEGER : layout = pango_cairo_create_layout(cr)
        pango_layout_set_text(layout, tr$("Keine Vorschau verfügbar"), -1)
        DIM tb AS INTEGER, th AS INTEGER
        pango_layout_get_pixel_size(layout, tb, th)
        cairoFarbe(cr, uiFarbe(&H8D93A1))
        cairo_move_to(cr, (b - tb) / 2, (h - th) / 2)
        pango_cairo_show_layout(cr, layout)
        g_object_unref(layout)
        RETURN TRUE
    END IF
    ' hoechstens 180 Punkte, Seitenverhaeltnis bleibt (PySticky max_size)
    DIM m AS kern.Muster : m = fiErgebnis.muster
    DIM z AS FLOAT : z = MIN(180.0 / m.breite, 180.0 / m.hoehe)
    DIM ox AS FLOAT : ox = (b - m.breite * z) / 2
    DIM oy AS FLOAT : oy = (h - m.hoehe * z) / 2
    cairo_save(cr)
    cairo_translate(cr, ox, oy)
    cairo_scale(cr, z, z)
    cairo_set_source_surface(cr, fiBild, 0, 0)
    cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_NAECHST)
    cairo_rectangle(cr, 0, 0, m.breite, m.hoehe)
    cairo_fill(cr)
    cairo_restore(cr)
    RETURN TRUE
END FUNCTION
