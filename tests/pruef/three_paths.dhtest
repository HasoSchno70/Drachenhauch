=== tuple destructuring
FUNCTION mm(a AS INTEGER, b AS INTEGER) AS TUPLE
  IF a < b THEN RETURN (a, b)
  RETURN (b, a)
END FUNCTION
DIM lo AS INTEGER
DIM hi AS INTEGER
(lo, hi) = mm(9, 2)
PRINT lo
PRINT hi
--- erwartet
2
9

=== data read restore
DATA 10, 20, 30
DIM a AS INTEGER
DIM b AS INTEGER
READ a
READ b
PRINT a + b
RESTORE
READ a
PRINT a
--- erwartet
30
10

