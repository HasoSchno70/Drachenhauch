=== ein doppelklick auf eine spalte legt ihr feld unter das letzte control
' Das Fenster hat schon einen Knopf und eine andere Tabelle: das Feld kommt
' darunter, das Fenster behaelt seine Tabelle, und die Statuszeile sagt es.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, "", 8, p)
DIM x AS INTEGER
DIM y AS INTEGER
(x, y) = slLage(log, "knoten Daten.kunden.ort")
slHin(10, 10)
slWarten(10)
slKlick(x, y)
slWarten(3)
slKlick(x, y)
slWarten(10)
slMit([341], 83)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "felder ")
    PRINT z
NEXT
DIM j AS JSON_HANDLE : j = JSON_LOAD(p + "/Hauptfenster.dhform")
PRINT "tabelle "; JSON_GET_STRING(j, "studio_tabelle")
PRINT "feld "; JSON_GET_STRING(j, "widgets.2.name"); " "; JSON_GET_STRING(j, "widgets.2.bind"); " y="; JSON_GET_INT(j, "widgets.2.y"); " text "; JSON_GET_STRING(j, "widgets.1.text")
--- argumente
{sammlung}/../../../studio/studio.dh
--- datei laeufer.dh
IMPORT "json"
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
