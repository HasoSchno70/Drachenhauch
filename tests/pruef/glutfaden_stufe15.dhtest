' Glutfaden Stufe 15: die Zeichenflaeche (kern/flaeche.dh,
' ansicht/flaechenteile.dh) -- Werkzeug Farbverlauf, Lineale, Uebersicht,
' Kachel-Vorschau.
'
' ref_flaeche.txt hat PySticky selbst aufgezeichnet: GradientTool.
' _calculate_gradient (Punkte und Palettenfarben), MinimapWidget (Bildmasse,
' Lage und die Punkte als MD5, das Ausschnitt-Rechteck) und
' TilePreviewWidget._calculate_cell_size an alle.pxs und farbprobe.pxs.

=== wie pysticky: farbverlauf, uebersicht, kachel-vorschau
IMPORT "helfer.dh"
DIM ref AS STRING : ref = geLies$("ref.txt")
PRINT geVergleich$(ref, flaecheText$(ref, CWD$()))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_flaeche.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bild.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
