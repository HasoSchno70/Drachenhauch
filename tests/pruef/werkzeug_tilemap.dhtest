    prE(f, 7, x, y)
    prE(f + 1, 7, x, y)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 5, 0, 0)
END SUB
SUB prZiehen(f AS INTEGER, x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    prE(f, 7, x1, y1)
    prE(f + 1, 7, x1, y1)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 7, x2, y2)
    prE(f + 2, 6, 0, 0)
    prE(f + 3, 7, x2, y2)
    prE(f + 4, 5, 0, 0)
END SUB
