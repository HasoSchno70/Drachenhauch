=== kuerzel: schreibweisen, tasten, tafel, zusammenstoesse
IMPORT "helfer.dh"
DIM t AS STRING
FOR EACH t IN ["strg+s", "Ctrl+Shift+s", "shift+ctrl+alt+p", "F5", "f12", "F13", "Strg++", "Strg+-", "Umschalt+=", "umschalt+r", "plus, =", "Strg+Y,Strg+Umschalt+Z, strg+y", "Bild auf", "Strg+PgDown", "Hyper+X", "Strg+", "", "ä", "Strg+Komma", "Strg+,", "Alt+Enter", "Escape", "Del"]
    PRINT "'"; t; "' -> '"; kern.kuerzelNormal$(t); "' "; kern.kuerzelGueltig(t)
NEXT
' Tasten aus GDK: Keyval, Strg, Alt, Umschalt
PRINT kern.kuerzelAusTaste$(&H73, TRUE, FALSE, FALSE); " | "; kern.kuerzelAusTaste$(&H53, TRUE, FALSE, TRUE); " | "; kern.kuerzelAusTaste$(&H52, FALSE, FALSE, FALSE); " | "; kern.kuerzelAusTaste$(&H3D, FALSE, FALSE, TRUE); " | "; kern.kuerzelAusTaste$(&HFFAB, FALSE, FALSE, FALSE); " | "; kern.kuerzelAusTaste$(&HFFB1, FALSE, FALSE, FALSE)
PRINT kern.kuerzelAusTaste$(&HFFE1, FALSE, FALSE, TRUE); "|"; kern.kuerzelAusTaste$(&HFFC2, FALSE, FALSE, FALSE); " | "; kern.kuerzelAusTaste$(&HFFFF, FALSE, FALSE, TRUE); " | "; kern.kuerzelAusTaste$(&HE4, FALSE, FALSE, FALSE); " | "; kern.kuerzelAusTaste$(&H2C, TRUE, FALSE, FALSE); " | "; kern.kuerzelAusTaste$(&HFF8D, FALSE, TRUE, FALSE)
' Die Vorgaben selbst: alle lesbar, keine zwei auf derselben Taste
DIM e AS kern.Einstellungen : e = NEW kern.Einstellungen()
DIM w AS ARRAY OF STRING : w = kern.kuerzelWirksam(e)
DIM a AS ARRAY OF kern.Kuerzelaktion : a = kern.kuerzelAktionen()
DIM i AS INTEGER, krumm AS INTEGER, zusammen AS INTEGER
FOR i = 0 TO LEN(a) - 1
    IF w[i] = "" THEN krumm = krumm + 1
    IF kern.kuerzelKonflikt(w, w[i], i) >= 0 THEN zusammen = zusammen + 1
NEXT
PRINT "aktionen "; LEN(a); " | krumme vorgaben "; krumm; " | zusammenstoesse "; zusammen
DIM tafel AS MAP OF STRING : tafel = kern.kuerzelTafel(e)
PRINT "tafel "; LEN(MAPKEYS(tafel)); " | Strg+S "; tafel["Strg+S"]; " | = "; tafel["="]; " | Plus "; tafel["Plus"]; " | Strg+Umschalt+Z "; tafel["Strg+Umschalt+Z"]; " | Umschalt+R "; tafel["Umschalt+R"]; " | R "; tafel["R"]
' Eigene: der Reihe nach, ein Zusammenstoss behaelt die Vorgabe
MAPPUT(e.kuerzel, "sichern", "F2")
MAPPUT(e.kuerzel, "export", "f2")
MAPPUT(e.kuerzel, "bibliothek", "krumm+X")
MAPPUT(e.kuerzel, "vorschau", "strg+s")
MAPPUT(e.kuerzel, "gibtsnicht", "F9")
PRINT "sichern "; kern.kuerzelVon$(e, "sichern"); " | export "; kern.kuerzelVon$(e, "export"); " | bibliothek "; kern.kuerzelVon$(e, "bibliothek"); " | vorschau "; kern.kuerzelVon$(e, "vorschau"); " | F9 "; MAPHAS(kern.kuerzelTafel(e), "F9")
