' Drucken (docs/entwurf-drucken.md, Wege A und C): PRINTERS, PRINTER_DEFAULT$,
' PDF_PREVIEW, die Fehlermeldungen von PDF_PRINT und OPENDOC.
'
' Bis 2026-09-16 in tests/test_drucken.py; der Druck durch einen ECHTEN
' Treiber ("Microsoft Print to PDF" in eine Datei) blieb dort noch, weil der
' Leser in Drachenhauch nur PDFs von dhrt selbst kannte. Seit 2026-09-20 liest
' `_hilfen/pdftext.dh` auch fremde PDFs samt Textlagen -- damit steht auch
' dieser Fall hier, und pytest braucht es fuer den Druck nicht mehr.

' Seriell, seit zwei Faelle durch "Microsoft Print to PDF" drucken: zwei
' Auftraege zugleich lieferten einmal in sechs Laeufen eine leere Datei.
--- seriell

=== der standarddrucker ist leer oder steht in der liste
IMPORT "pdf"
DIM namen AS MAP OF BOOLEAN
DIM n AS STRING
DIM anzahl AS INTEGER : anzahl = 0
FOR EACH n IN PRINTERS()
    MAPPUT(namen, n, TRUE)
    anzahl = anzahl + 1
NEXT
DIM standard AS STRING : standard = PRINTER_DEFAULT$()
PRINT "standard passt "; (standard = "" OR MAPHAS(namen, standard))
--- erwartet
standard passt TRUE

=== windows bringt microsoft print to pdf mit
IMPORT "pdf"
DIM gefunden AS BOOLEAN : gefunden = FALSE
DIM n AS STRING
FOR EACH n IN PRINTERS()
    IF n = "Microsoft Print to PDF" THEN gefunden = TRUE
NEXT
PRINT "print to pdf "; gefunden
--- system windows
--- erwartet
print to pdf TRUE

=== die vorschau ist ein bild mit inhalt
' Papier weiss, in der Titelzeile dunkle Punkte, im gefuellten Rechteck
' (20..60 mm x 60..70 mm) schwarz; A4 bei 420 Punkten Breite ist 594 hoch.
IMPORT "pdf"
IMPORT "imgfx"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM p AS PDF : p = PDF_NEW()
PDF_TITLE(p, "Drucktest")
PDF_FONT(p, "helvetica-fett", 18)
PDF_TEXT(p, 20, 25, "Rechnung 2026-0002")
PDF_FONT(p, "helvetica", 11)
PDF_TEXT(p, 20, 40, "Anna Berger")
PDF_LINE(p, 20, 50, 190, 50)
PDF_RECT_FILL(p, 20, 60, 40, 10)
PDF_TEXT(p, 190 - PDF_TEXT_WIDTH(p, "85,39 EUR"), 80, "85,39 EUR")
PDF_PAGE(p)
PDF_TEXT(p, 20, 25, "Seite zwei")
DIM b AS IMAGE : b = PDF_PREVIEW(p, 1, 420)
PRINT IMAGEWIDTH(b) ; " " ; IMAGEHEIGHT(b)
PRINT "ecke weiss "; (GETPIXEL(b, 5, 5) = &HFFFFFF)
DIM f AS FLOAT : f = 420 / 210
DIM dunkel AS INTEGER : dunkel = 0
DIM x AS INTEGER
DIM y AS INTEGER
FOR x = INT(20 * f) TO INT(120 * f) - 1
    FOR y = INT(25 * f) TO INT(33 * f) - 1
        DIM c AS INTEGER : c = GETPIXEL(b, x, y)
        IF ((c SHR 16) BAND 255) + ((c SHR 8) BAND 255) + (c BAND 255) < 300 THEN dunkel = dunkel + 1
    NEXT
NEXT
PRINT "ueberschrift zu sehen "; (dunkel > 50)
DIM r AS INTEGER : r = GETPIXEL(b, INT(40 * f), INT(65 * f))
PRINT "rechteck gefuellt "; (((r SHR 16) BAND 255) + ((r SHR 8) BAND 255) + (r BAND 255) < 60)
TRY
    PDF_PREVIEW(p, 3)
CATCH e
    PRINT "seite 3 "; (INSTR(e, "Seite 3 gibt es nicht") >= 0)
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
420 594
ecke weiss TRUE
ueberschrift zu sehen TRUE
rechteck gefuellt TRUE
seite 3 TRUE

=== fehler haben klare worte
IMPORT "pdf"
DIM p AS PDF : p = PDF_NEW()
PDF_TEXT(p, 20, 25, "Test")
TRY
    PDF_PRINT(p, "Diesen Drucker gibt es nicht")
CATCH e
    PRINT "unbekannter drucker "; (INSTR(e, "PDF_PRINT") >= 0)
END TRY
TRY
    PDF_PRINT(p, "", 0)
CATCH e2
    PRINT "kopien "; (INSTR(e2, "Kopien 1..99") >= 0)
END TRY
TRY
    OPENDOC("gibtsnicht.pdf")
CATCH e3
    PRINT "fehlende datei "; (INSTR(e3, "gibt es nicht") >= 0)
END TRY
' OPENDOC ist kein Programmstarter -- eine .exe weist es ab und nennt SHELL.
WRITEALL("boese.exe", "MZ")
TRY
    OPENDOC("boese.exe")
CATCH e4
    PRINT "programm abgewiesen "; (INSTR(e4, "nicht geoeffnet") >= 0 AND INSTR(e4, "SHELL") >= 0)
END TRY
--- erwartet
unbekannter drucker TRUE
kopien TRUE
fehlende datei TRUE
programm abgewiesen TRUE

=== der druck geht durch einen echten treiber
' Pruefstein 1 aus docs/entwurf-drucken.md: PDF_PRINT schickt die Seiten
' wirklich an einen Druckertreiber. "Microsoft Print to PDF" nimmt in DOCINFO
' einen Ausgabepfad und fragt dann nicht nach -- was dabei herauskommt, ist
' also das, was der Treiber aus unserem GDI-Weg gemacht hat: mm in
' Geraeteeinheiten, PHYSICALOFFSET abgezogen, TA_TOP, Schriften abgebildet.
'
' Gelesen wird die Datei mit demselben Leser wie unsere eigenen PDFs
' (_hilfen/pdftext.dh); bis 2026-09-20 ging das nicht und der Fall stand
' deshalb als letzter Druck-Test in tests/test_drucken.py mit PyMuPDF.
'
' Der Fall fasst den Standarddrucker NICHT an, prueft aber, dass er sich nicht
' verschoben hat: hat Windows "den zuletzt verwendeten Drucker als Standard
' festlegen" eingeschaltet, verschiebt ihn jeder Druck -- dann faellt der Fall
' auf, statt das stillschweigend zu tun.
IMPORT "pdf"
IMPORT "leser.dh"
DIM da AS BOOLEAN : da = FALSE
DIM n AS STRING
FOR EACH n IN PRINTERS()
    IF n = "Microsoft Print to PDF" THEN da = TRUE
NEXT
IF NOT da THEN
    PRINT "UEBERSPRINGEN: kein 'Microsoft Print to PDF' auf dieser Maschine"
    EXIT(0)
END IF
DIM vorher AS STRING : vorher = PRINTER_DEFAULT$()
DIM p AS PDF : p = PDF_NEW()
PDF_TITLE(p, "Drucktest")
PDF_FONT(p, "helvetica-fett", 18)
PDF_TEXT(p, 20, 25, "Rechnung 2026-0002")
PDF_FONT(p, "helvetica", 11)
PDF_TEXT(p, 20, 40, "Anna Berger")
PDF_LINE(p, 20, 50, 190, 50)
PDF_RECT_FILL(p, 20, 60, 40, 10)
DIM sollX AS FLOAT : sollX = 190.0 - PDF_TEXT_WIDTH(p, "85,39 EUR")
PDF_TEXT(p, sollX, 80, "85,39 EUR")
PDF_PAGE(p)
PDF_TEXT(p, 20, 25, "Seite zwei")
PDF_PRINT(p, "Microsoft Print to PDF", 1, "druck.pdf")
DIM s AS ARRAY OF STRING : s = pdfSeiten("druck.pdf")
PRINT "seiten "; LEN(s)
PRINT "ueberschrift "; (INSTR(s[0], "Rechnung 2026-0002") >= 0)
PRINT "name "; (INSTR(s[0], "Anna Berger") >= 0)
PRINT "betrag "; (INSTR(s[0], "85,39 EUR") >= 0)
PRINT "zweite seite "; (INSTR(s[1], "Seite zwei") >= 0)
' Die Lagen kommen aus den Textmatrizen der gedruckten Datei: der Betrag steht
' rechtsbuendig an 190 mm, der Name am linken Rand. Ein Fehler im Massstab
' oder im Versatz der mm-Umrechnung verschoebe genau diese zwei Zahlen.
PRINT "name steht links "; (ABS(pdfStelleXmm("Anna Berger") - 20.0) < 1.0)
PRINT "betrag steht rechts "; (ABS(pdfStelleXmm("85,39") - sollX) < 1.0)
PRINT "standard unveraendert "; (PRINTER_DEFAULT$() = vorher)
--- datei leser.dh
IMPORT "{sammlung}/_hilfen/pdftext.dh"
--- system windows
--- erwartet
seiten 2
ueberschrift TRUE
name TRUE
betrag TRUE
zweite seite TRUE
name steht links TRUE
betrag steht rechts TRUE
standard unveraendert TRUE

=== die vorschau zeigt kreise vielecke gedrehten text und deckkraft
' A4 bei 420 Punkten: 2 Punkte je mm. Gefuellter Kreis um (50, 50) mm, Ring um
' (100, 50), Dreieck (20,100)-(40,100)-(30,120), halb deckendes Schwarz bei
' (150, 100) -- gegen das Papier gemischt grau --, und "HOCH" um 90 Grad
' gedreht an (100, 200): er steigt von dort nach OBEN, rechts davon bleibt
' das Papier weiss.
IMPORT "pdf"
IMPORT "imgfx"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM p AS PDF : p = PDF_NEW()
PDF_COLOR(p, RGB(200, 0, 0))
PDF_CIRCLE_FILL(p, 50, 50, 10)
PDF_CIRCLE(p, 100, 50, 10)
PDF_POLYGON_FILL(p, [20.0, 40, 30], [100.0, 100, 120])
PDF_COLOR(p, RGB(0, 0, 0))
PDF_OPACITY(p, 0.5)
PDF_RECT_FILL(p, 150, 100, 20, 20)
PDF_OPACITY(p, 1)
PDF_FONT(p, "sans", 30)
PDF_TEXT(p, 100, 200, "HOCH", 90)
DIM b AS IMAGE : b = PDF_PREVIEW(p, 1, 420)
PRINT "kreis "; HEX$(GETPIXEL(b, 100, 100)); " ring innen "; HEX$(GETPIXEL(b, 200, 100)); " ring rand "; HEX$(GETPIXEL(b, 219, 100))
PRINT "dreieck "; HEX$(GETPIXEL(b, 60, 210)); " daneben "; HEX$(GETPIXEL(b, 42, 236))
DIM g AS INTEGER : g = GETPIXEL(b, 320, 220)
PRINT "halb deckend grau "; ABS(((g SHR 16) BAND 255) - 128) <= 2 AND ABS((g BAND 255) - 128) <= 2
FUNCTION dunkle(b AS IMAGE, x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER) AS INTEGER
    DIM n AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR y = y0 TO y1
        FOR x = x0 TO x1
            IF GETPIXEL(b, x, y) <> &HFFFFFF THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
PRINT "ueber dem anker "; dunkle(b, 200, 300, 230, 399) > 100; " rechts davon "; dunkle(b, 210, 400, 400, 440)
--- umgebung
DHRT_FRAMES=1
--- erwartet
kreis C80000 ring innen FFFFFF ring rand C80000
dreieck C80000 daneben FFFFFF
halb deckend grau TRUE
ueber dem anker TRUE rechts davon 0

=== der drucker bekommt kreise vielecke und gedrehten text
' Derselbe GDI-Weg mit den Formen von 2026-10-16: Ellipse, Polygon und ein
' Text mit lfEscapement. Im Ergebnis des Treibers steht der gedrehte Text --
' der Treiber legt die Drehung in die Matrix davor (cm mit a = 0, b <> 0) --
' und es gibt gefuellte Pfade.
IMPORT "pdf"
IMPORT "leser.dh"
DIM da AS BOOLEAN : da = FALSE
DIM n AS STRING
FOR EACH n IN PRINTERS()
    IF n = "Microsoft Print to PDF" THEN da = TRUE
NEXT
IF NOT da THEN
    PRINT "UEBERSPRINGEN: kein 'Microsoft Print to PDF' auf dieser Maschine"
    EXIT(0)
END IF
DIM vorher AS STRING : vorher = PRINTER_DEFAULT$()
DIM p AS PDF : p = PDF_NEW()
PDF_COLOR(p, RGB(200, 0, 0))
PDF_CIRCLE_FILL(p, 50, 50, 10)
PDF_POLYGON_FILL(p, [20.0, 40, 30], [100.0, 100, 120])
PDF_COLOR(p, RGB(0, 0, 0))
PDF_FONT(p, "helvetica", 20)
PDF_TEXT(p, 100, 200, "Gedreht", 90)
PDF_PRINT(p, "Microsoft Print to PDF", 1, "druck.pdf")
DIM s AS ARRAY OF STRING : s = pdfSeiten("druck.pdf")
PRINT "text "; (INSTR(s[0], "Gedreht") >= 0)
DIM w AS ARRAY OF STRING : w = pdfWoerter()
DIM i AS INTEGER, gedreht AS BOOLEAN
FOR i = 6 TO LEN(w) - 1
    IF w[i] = "cm" AND ABS(VAL(w[i - 6])) < 0.000001 AND ABS(VAL(w[i - 5])) > 0.000001 THEN gedreht = TRUE
NEXT
PRINT "gedreht "; gedreht
PRINT "flaechen "; pdfWortZahl(w, "f") + pdfWortZahl(w, "f*") >= 2
PRINT "standard unveraendert "; (PRINTER_DEFAULT$() = vorher)
--- datei leser.dh
IMPORT "{sammlung}/_hilfen/pdftext.dh"
--- system windows
--- erwartet
text TRUE
gedreht TRUE
flaechen TRUE
standard unveraendert TRUE

=== die vorschau strichelt linien und umrisse
' A4 bei 420 Punkten: 2 Punkte je mm. Eine Linie von 20 bis 120 mm auf
' Hoehe 50 mm, 4 mm Strich und 2 mm Luecke: 17 Striche zu 8 Punkten, dazwischen
' 4 Punkte Papier (200 Punkte = 16 volle Folgen und ein Strich); darunter dieselbe Linie durchgezogen. Der Umriss eines
' Rechtecks ab (20, 100) mm ist an der Oberkante ebenso unterbrochen. (Die Oberkante hat 10 Striche, dazu der Punkt in der Ecke, an dem die linke Kante endet.)
IMPORT "pdf"
IMPORT "imgfx"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM p AS PDF : p = PDF_NEW()
PDF_DASH(p, 4, 2)
PDF_LINE(p, 20, 50, 120, 50)
PDF_RECT(p, 20, 100, 60, 30)
PDF_DASH(p, 0)
PDF_LINE(p, 20, 70, 120, 70)
DIM b AS IMAGE : b = PDF_PREVIEW(p, 1, 420)
FUNCTION zeile$(b AS IMAGE, y AS INTEGER, x0 AS INTEGER, x1 AS INTEGER) AS STRING
    DIM n AS INTEGER, laeufe AS INTEGER, x AS INTEGER, vorher AS BOOLEAN
    FOR x = x0 TO x1
        DIM an AS BOOLEAN : an = GETPIXEL(b, x, y) <> &HFFFFFF
        IF an THEN n = n + 1
        IF an AND NOT vorher THEN laeufe = laeufe + 1
        vorher = an
    NEXT
    RETURN STR$(n) + " punkte in " + STR$(laeufe) + " stuecken"
END FUNCTION
PRINT "gestrichelt "; zeile$(b, 100, 30, 250)
PRINT "durchgezogen "; zeile$(b, 140, 30, 250)
PRINT "rechteck oben "; zeile$(b, 200, 30, 170)
--- umgebung
DHRT_FRAMES=1
--- erwartet
gestrichelt 136 punkte in 17 stuecken
durchgezogen 200 punkte in 1 stuecken
rechteck oben 81 punkte in 11 stuecken

=== der drucker strichelt
' Ein gestrichelter GDI-Stift (ExtCreatePen mit eigener Folge): der Treiber
' schreibt daraus wieder eine Strichelung ins PDF, 2 zu 1 wie bestellt.
IMPORT "pdf"
IMPORT "leser.dh"
DIM da AS BOOLEAN : da = FALSE
DIM n AS STRING
FOR EACH n IN PRINTERS()
    IF n = "Microsoft Print to PDF" THEN da = TRUE
NEXT
IF NOT da THEN
    PRINT "UEBERSPRINGEN: kein 'Microsoft Print to PDF' auf dieser Maschine"
    EXIT(0)
END IF
DIM vorher AS STRING : vorher = PRINTER_DEFAULT$()
DIM p AS PDF : p = PDF_NEW()
PDF_LINE_WIDTH(p, 1)
PDF_DASH(p, 4, 2)
PDF_LINE(p, 20, 50, 120, 50)
PDF_PRINT(p, "Microsoft Print to PDF", 1, "druck.pdf")
DIM s AS ARRAY OF STRING : s = pdfSeiten("druck.pdf")
DIM w AS ARRAY OF STRING : w = pdfWoerter()
DIM i AS INTEGER, gefunden AS BOOLEAN
FOR i = 3 TO LEN(w) - 1
    IF w[i] = "d" AND w[i - 2] = "]" THEN
        gefunden = TRUE
        PRINT "strichelung 2 zu 1 "; ABS(VAL(w[i - 4]) / VAL(w[i - 3]) - 2) < 0.01
    END IF
NEXT
PRINT "gefunden "; gefunden
PRINT "standard unveraendert "; (PRINTER_DEFAULT$() = vorher)
--- datei leser.dh
IMPORT "{sammlung}/_hilfen/pdftext.dh"
--- system windows
--- erwartet
strichelung 2 zu 1 TRUE
gefunden TRUE
standard unveraendert TRUE
