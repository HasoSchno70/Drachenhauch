    IF GUI_TEXTAREA_ABBREV_HIT(ta) >= 0 THEN gefunden = GUI_TEXTAREA_ABBREV_HIT(ta)
    IF n = 30 THEN PRINT "treffer " + STR$(gefunden)
    IF n = 30 THEN PRINT "text [" + GUI_TEXT(ta) + "]"
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
