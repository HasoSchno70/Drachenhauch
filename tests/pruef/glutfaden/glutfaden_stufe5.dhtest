--- erwartet
190: [<p class='cover-footer-text'>Erstellt mit PySticky &middot; 16.10.2026</p>] gegen [<p class='cover-footer-text'>Erstellt mit Glutfaden &middot; 16.10.2026</p>]

=== paket: was im zip liegt
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Die Garnliste vergleicht mit der von PyStickys export_bundle (BOM, CRLF,
' Semikolon); die Anleitung im Paket ist dieselbe wie htmlText$. Ohne Grafik
' entsteht kein Bild (es stuende in e.fehlt) -- dann ueberspringt sich der Fall.
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
TRY
    DIM probeBild AS IMAGE : probeBild = IMAGE_NEW(1, 1)
CATCH keineGrafik
    PRINT "UEBERSPRINGEN: ohne Grafik entsteht kein Bild im Paket"
    END
END TRY
WRITEALL("alt.zip", "kaputt")
DIM e AS kern.PaketErgebnis : e = kern.paketExportieren(m, "alt.zip", "A4", FALSE, pal)
PRINT JOIN$(ZIP_LIST("alt.zip"), ", ")
PRINT "fehlt "; LEN(e.fehlt); " nebendatei "; FILEEXISTS("alt.zip.tmp")
DIM csv AS BUFFER : csv = ZIP_READ("alt.zip", "garnliste.csv")
DIM ref AS BUFFER : ref = READALL_BYTES("garnliste.ref")
DIM gleich AS BOOLEAN : gleich = BUFFER_LEN(csv) = BUFFER_LEN(ref)
DIM i AS INTEGER
FOR i = 0 TO MIN(BUFFER_LEN(csv), BUFFER_LEN(ref)) - 1
    IF BUFFER_GET(csv, i) <> BUFFER_GET(ref, i) THEN gleich = FALSE
NEXT
PRINT "garnliste wie pysticky "; gleich; " bom "; BUFFER_GET(csv, 0); " "; BUFFER_GET(csv, 1); " "; BUFFER_GET(csv, 2)
DIM ho AS kern.HtmlOptionen : ho = NEW kern.HtmlOptionen()
ho.paletten = pal
PRINT "html "; ZIP_READ$("alt.zip", "Probe_OXS.html") = kern.htmlText$(m, ho, "Probe_OXS")
DIM pdf AS BUFFER : pdf = ZIP_READ("alt.zip", "Probe_OXS.pdf")
PRINT "pdf "; CHR$(BUFFER_GET(pdf, 0)) + CHR$(BUFFER_GET(pdf, 1)) + CHR$(BUFFER_GET(pdf, 2)) + CHR$(BUFFER_GET(pdf, 3))
DIM png AS BUFFER : png = ZIP_READ("alt.zip", "Probe_OXS.png")
PRINT "png "; BUFFER_GET(png, 1); BUFFER_GET(png, 2); BUFFER_GET(png, 3); " "; BUFFER_LEN(png) > 100
DIM px AS kern.Muster : px = kern.musterAusJson(JSON_GET_JSON(JSON_PARSE(ZIP_READ$("alt.zip", "Probe_OXS.pxs")), "pattern"))
PRINT "pxs "; px.breite; "x"; px.hoehe; " "; LEN(px.farben)
PRINT ZIP_READ$("alt.zip", "LIESMICH.txt")
