=== easing validation on fade builtins
IMPORT "audio"
TRY
    AUDIO_PLAY(0, 0, 1.0, 100, "bounce")
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_STOP(0, 100, "bounce")
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_PAN_SLIDE(0, 0.0, 1.0, 100, "bounce")
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_MUSIC_PLAY(-1, 100, "bounce")
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_MUSIC_STOP(100, "bounce")
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_PLAY: unbekanntes Easing 'bounce' (linear, in, out, inout)
AUDIO_STOP: unbekanntes Easing 'bounce' (linear, in, out, inout)
AUDIO_PAN_SLIDE: unbekanntes Easing 'bounce' (linear, in, out, inout)
AUDIO_MUSIC_PLAY: unbekanntes Easing 'bounce' (linear, in, out, inout)
AUDIO_MUSIC_STOP: unbekanntes Easing 'bounce' (linear, in, out, inout)

=== easing defaults to linear when omitted
IMPORT "audio"
TRY
    AUDIO_PLAY(0, -1, 1.0, -5)
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_PAN_SLIDE(0, 0.0, 1.0, 0)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_PLAY: fade_in_ms muss >= 0 sein
AUDIO_PAN_SLIDE: dauer_ms muss > 0 sein

