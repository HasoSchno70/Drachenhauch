=== einkauf abschliessen: vorgaben, pruefung, abweichung, ein schritt
' Die Zeilen bekommen Vorgaben: Tage aus der Kategorie (Milchprodukte 7,
' Grundnahrungsmittel 180, ohne eine Woche), den Lagerort, wo das Produkt
' zuletzt lag (sonst wie die Kategorie empfiehlt, sonst den ersten), den
' letzten Preis und Markt. Ein falsches Datum haelt an (Enter fuer die
' Meldung); eine geaenderte Menge fragt (Enter = uebertragen), dann die
' Erfolgsmeldung (Enter). Ein Produkt ohne Treffer wird angelegt; was im
' Dialog nicht markiert ist, bleibt auf der Liste. Alles ist ein Schritt.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slTaste(257)
slWarten(20)
slTaste(257)
slWarten(20)
slTaste(257)
slAufnahmeSchreiben(p + "/_studio/enter.txt")
PRINT "code "; kProbe(p, "probe.dh", "enter.txt", 120)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO products (name, category) VALUES ('Milch', 'Milchprodukte'), ('Mehl', 'Grundnahrungsmittel')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location) VALUES (1, 1, 'Liter', '2026-11-20', 'Kühlschranktür')")
DB_EXEC(db, "INSERT INTO product_stores (product_id, store_name, price, last_purchased) VALUES (1, 'LIDL', 1.19, '2026-11-01')")
DB_EXEC(db, "INSERT INTO shopping_list (product_name, quantity, unit, category, checked) VALUES ('Milch', 2, 'Liter', 'Milchprodukte', 1), ('Mehl', 1, 'kg', NULL, 1), ('Zahnpasta', 1, 'Stück', NULL, 1), ('Salz', 1, 'Packung', NULL, 0)")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
FUNCTION stand$() AS STRING
    DIM t AS STRING : t = ""
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT p.name, i.quantity, i.unit, i.expiry_date, i.storage_location, IFNULL(i.purchased_at_store, '-'), IFNULL(i.notes, '-') FROM inventory i JOIN products p ON p.id = i.product_id ORDER BY i.id")
    WHILE DB_NEXT(r)
        t = t + "  bestand " + DB_GET_STRING(r, 0) + " " + DB_GET_STRING(r, 1) + " " + DB_GET_STRING(r, 2) + " " + DB_GET_STRING(r, 3) + " " + DB_GET_STRING(r, 4) + " " + DB_GET_STRING(r, 5) + " | " + DB_GET_STRING(r, 6) + CHR$(10)
    WEND
    r = DB_QUERY(db, "SELECT s.store_name, p.name, IFNULL(s.price, 0), s.last_purchased FROM product_stores s JOIN products p ON p.id = s.product_id ORDER BY s.id")
    WHILE DB_NEXT(r)
        t = t + "  markt " + DB_GET_STRING(r, 0) + " " + DB_GET_STRING(r, 1) + " " + DB_GET_STRING(r, 2) + " " + DB_GET_STRING(r, 3) + CHR$(10)
    WEND
    t = t + "  liste " + JOIN$(textListe("SELECT product_name FROM shopping_list ORDER BY id"), ", ") + " | produkte " + STR$(dbZahl("SELECT COUNT(*) FROM products"))
    RETURN t
END FUNCTION
DIM af AS AbschlussFenster : af = NEW AbschlussFenster()
af.vorMarkt = "LIDL"
af.Zeigen()
PRINT "markt "; GUI_DROPDOWN_TEXT(af.marktWahl); " | "; GUI_TEXT(af.untertitel)
DIM z AS INTEGER
DIM s AS INTEGER
FOR z = 0 TO GUI_TABLE_ROW_COUNT(af.tabelle) - 1
    DIM t AS STRING : t = "  "
    FOR s = 1 TO 7
        t = t + GUI_TABLE_GET_CELL(af.tabelle, z, s) + IIF(s < 7, " | ", "")
    NEXT
    PRINT t
NEXT
FUNCTION zeile(af AS AbschlussFenster, name AS STRING) AS INTEGER
    DIM z AS INTEGER
    FOR z = 0 TO GUI_TABLE_ROW_COUNT(af.tabelle) - 1
        IF GUI_TABLE_GET_CELL(af.tabelle, z, 1) = name THEN RETURN z
    NEXT
    RETURN -1
END FUNCTION
' Milch nicht mitnehmen, Mehl mit falschem Datum.
GUI_TABLE_CELL_VALUE(af.tabelle, zeile(af, "Milch"), SP_A_HAKEN, 0)
GUI_TABLE_SET_CELL(af.tabelle, zeile(af, "Mehl"), SP_A_MHD, "2026-13-01")
af.knopfUebernehmen_Klick()
PRINT "falsches datum "; af.uebertragen; " | offen "; af.studioOffen
GUI_TABLE_SET_CELL(af.tabelle, zeile(af, "Mehl"), SP_A_MHD, "2027-01-31")
GUI_TABLE_SET_CELL(af.tabelle, zeile(af, "Mehl"), SP_A_MENGE, "3")
GUI_TABLE_SET_CELL(af.tabelle, zeile(af, "Mehl"), SP_A_PREIS, "1,29")
PRINT "abweichung"
PRINT af.abweichungen$()
af.knopfUebernehmen_Klick()
PRINT "uebertragen "; af.uebertragen; " neu "; af.neuAngelegt; " | offen "; af.studioOffen; " | "; verlauf.textZurueck$()
PRINT stand$()
f.miRueckgaengig_Aktion()
PRINT "zurueck"
PRINT stand$()
f.miWiederholen_Aktion()
PRINT "wieder"
PRINT stand$()
--- erwartet
markt LIDL | 3 gekaufte Artikel zum Bestand hinzufügen
  Mehl | 1 | kg | 2027-05-07 | Vorratsraum |  | Neu
