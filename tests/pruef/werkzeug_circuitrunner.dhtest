=== demo-level entsprechen dem schema
' Fuenf Level, je 1024 Kacheln als Hex, genau ein Spielerstart, mindestens ein
' Ausgang, und der Chipzaehler stimmt mit dem Gitter.
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 30000 AND leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF teil <> "" THEN
            aus = aus + teil
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
FUNCTION kachel(hex AS STRING, i AS INTEGER) AS INTEGER
    ' Zwei Hex-Zeichen -> Zahl. Nicht ueber VAL: VAL("&HFF") ist 0.
    DIM ziffern AS STRING : ziffern = "0123456789ABCDEF"
    RETURN INSTR(ziffern, UPPER$(MID$(hex, i * 2, 1))) * 16 + INSTR(ziffern, UPPER$(MID$(hex, i * 2 + 1, 1)))
END FUNCTION
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/demo.json")
PRINT REPLACE$(TRIM$(lauf$(p)), CWD$(), "FALL")
IMPORT "json"
DIM h AS JSON_HANDLE : h = JSON_LOAD("demo.json")
DIM n AS INTEGER : n = JSON_LEN(h, "levels")
PRINT "level "; n >= 5
DIM k AS INTEGER
FOR k = 0 TO n - 1
    DIM hex AS STRING : hex = JSON_GET_STRING(h, "levels." + STR$(k) + ".upper")
    DIM spieler AS INTEGER : spieler = 0
    DIM ausgang AS BOOLEAN : ausgang = FALSE
    DIM chips AS INTEGER : chips = 0
    DIM i AS INTEGER
    FOR i = 0 TO 1023
        DIM t AS INTEGER : t = kachel(hex, i)
        IF t >= &H6C AND t <= &H6F THEN spieler = spieler + 1
        IF t = &H15 OR t = &H39 OR t = &H3A OR t = &H3B THEN ausgang = TRUE
        IF t = 2 THEN chips = chips + 1
    NEXT
    PRINT JSON_GET_STRING(h, "levels." + STR$(k) + ".title"); ": "; LEN(hex) = 2048 AND LEN(JSON_GET_STRING(h, "levels." + STR$(k) + ".lower")) = 2048; " "; spieler = 1; " "; ausgang; " "; JSON_GET_INT(h, "levels." + STR$(k) + ".chips") = chips
NEXT
--- argumente
{sammlung}/../../circuitrunner/make_demo_levels.dh
--- erwartet
5 Demo-Level (alle validiert) -> FALL/demo.json
level TRUE
BOOT UP: TRUE TRUE TRUE TRUE
LOCKED: TRUE TRUE TRUE TRUE
FLOODED: TRUE TRUE TRUE TRUE
SLIPPERY: TRUE TRUE TRUE TRUE
INFESTED: TRUE TRUE TRUE TRUE

=== demo-level sind die eingecheckten
' Was der Bauer schreibt, ist Byte fuer Byte levels/circuit_runner.json -- die
' Datei, die bis 2026-09-14 make_demo_levels.py erzeugt hat. Wer ein Demo-Level
' aendert, erzeugt die Datei neu und checkt beides ein.
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 30000 AND leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF teil <> "" THEN
            aus = aus + teil
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/demo.json")
DIM aus AS STRING : aus = lauf$(p)
DIM neu AS BUFFER : neu = READALL_BYTES("demo.json")
DIM alt AS BUFFER : alt = READALL_BYTES(ARG$(1))
PRINT BUFFER_LEN(neu) = BUFFER_LEN(alt) AND BUFFER_TO_HEX$(neu) = BUFFER_TO_HEX$(alt)
--- argumente
{sammlung}/../../circuitrunner/make_demo_levels.dh
{sammlung}/../../circuitrunner/levels/circuit_runner.json
--- erwartet
TRUE

=== soundeffekte kommen von der richtigen adresse
' Ein Gegenserver im echo-Modus spiegelt den Pfad jeder Anfrage -- jede
' heruntergeladene Datei sagt also, welche Adresse das Werkzeug gebaut hat.
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 30000 AND leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF teil <> "" THEN
            aus = aus + teil
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
IMPORT "json"
DIM srv AS INTEGER : srv = PROCESS_START("dhrt", "run", ARG$(0), "--", "echo", "0", "-", CWD$() + "/port.txt")
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT FILEEXISTS("port.txt") AND MILLIS() - t0 < 15000
    SLEEP(10)
WEND
SLEEP(50)
DIM port AS STRING : port = TRIM$(READLINES("port.txt")[0])
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", ARG$(1), "--", "http://127.0.0.1:" + port + "/sfx/", CWD$() + "/sfx")
DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(REPLACE$(lauf$(p), CHR$(13), ""), CHR$(10))
PRINT "rueckgabe "; PROCESS_CODE(p); ", zeilen "; LEN(zeilen) - 1
PRINT JSON_GET_STRING(JSON_LOAD("sfx/step.wav"), "pfad")
PRINT JSON_GET_STRING(JSON_LOAD("sfx/blocked.wav"), "pfad")
PRINT READLINES("sfx/CREDITS.txt")[4]
PROCESS_KILL(srv)
--- argumente
{sammlung}/_hilfen/gegenserver.dh
{sammlung}/../../circuitrunner/download_sfx.dh
--- erwartet
rueckgabe 0, zeilen 8
/sfx/tick_001.wav
/sfx/back_002.wav
step.wav  <-  tick_001.wav

=== musik kommt mit kodierten namen
' Die Dateinamen enthalten Leerzeichen und eckige Klammern -- sie gehen wie bei
' Pythons urllib.parse.quote als %20, %5B, %5D hinaus.
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 30000 AND leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF teil <> "" THEN
            aus = aus + teil
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
IMPORT "json"
DIM srv AS INTEGER : srv = PROCESS_START("dhrt", "run", ARG$(0), "--", "echo", "0", "-", CWD$() + "/port.txt")
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT FILEEXISTS("port.txt") AND MILLIS() - t0 < 15000
    SLEEP(10)
WEND
SLEEP(50)
DIM port AS STRING : port = TRIM$(READLINES("port.txt")[0])
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", ARG$(1), "--", "http://127.0.0.1:" + port + "/musik/", CWD$() + "/musik")
DIM aus AS STRING : aus = lauf$(p)
PRINT "rueckgabe "; PROCESS_CODE(p)
PRINT JSON_GET_STRING(JSON_LOAD("musik/title.ogg"), "pfad")
PRINT READLINES("musik/CREDITS.txt")[2]
PROCESS_KILL(srv)
--- argumente
{sammlung}/_hilfen/gegenserver.dh
{sammlung}/../../circuitrunner/download_music.dh
--- erwartet
rueckgabe 0
/musik/Juhani%20Junkala%20%5BRetro%20Game%20Music%20Pack%5D%20Title%20Screen.ogg
Quelle: https://archive.org/details/JuhaniJunkalafiveactionchiptunes
