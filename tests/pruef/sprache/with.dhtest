=== punkt zuweisung im einzeiligen if
' `IF ok THEN .hp = 0` in einem WITH-Block.
CLASS P
    DIM hp AS INTEGER
END CLASS
DIM p AS P
p = NEW P()
p.hp = 5
DIM ok AS BOOLEAN
ok = TRUE
WITH p
    IF ok THEN .hp = 0
END WITH
PRINT p.hp
--- erwartet
0

=== punkt zuweisung haengt an der bedingung
' Gegenprobe: bei falscher Bedingung bleibt der Wert stehen.
CLASS P
    DIM hp AS INTEGER
END CLASS
DIM p AS P
p = NEW P()
p.hp = 5
DIM ok AS BOOLEAN
ok = FALSE
WITH p
    IF ok THEN .hp = 0
END WITH
PRINT p.hp
--- erwartet
5

