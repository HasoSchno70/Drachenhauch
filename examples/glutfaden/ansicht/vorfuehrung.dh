' Die Selbstvorfuehrung fuer Pruefungen (--probe, --probe-bearbeiten): ein
' Zeitgeber geht Schritt fuer Schritt durch, schreibt, was er sieht, und sichert
' mit --foto Bilder des Fensters. Die Werkzeuge bekommen dieselben Zellen und
' Knoepfe gemeldet wie von der Maus (wzDruck/wzZiehen/wzLos).

DIM schritt AS INTEGER
SUB foto(name AS STRING)
    IF fotoZiel = "" THEN RETURN
    IF NOT gtkFoto(fenster, fotoZiel + "_" + name + ".png") THEN PRINT "Foto nicht gesichert: "; name
END SUB

' Stufe 1: ansehen, zoomen, eine Ebene aus- und einblenden
FUNCTION vorfuehren(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    SELECT CASE schritt
        CASE 1
            ' Das erste Zeichnen hat eingepasst
            PRINT "geladen: "; geladen; ", eingepasst: "; lwEingepasst
            PRINT lwMuster.breite; " x "; lwMuster.hoehe; ", "; ZAHL$(lwMuster.breiteCm(), 1); " cm"
        CASE 2
            foto("eingepasst")
            leinwandZoom(30.0, lwX + 5.5 * lwZelle, lwY + 5.5 * lwZelle)
            PRINT "zoom: "; leinwandZoomProzent(); " %"
        CASE 3
            foto("nah")
            ' Die Ebene "Herz" ausblenden -- die Stiche verschwinden aus dem Bild
            IF LEN(slEbenenKnoepfe) < 2 THEN RETURN TRUE
            DIM vorher AS INTEGER : vorher = lwFarbe[12 * lwMuster.breite + 17]
            gtk_toggle_button_set_active(slEbenenKnoepfe[1], FALSE)
            PRINT "zelle 17,12: "; vorher; " -> "; lwFarbe[12 * lwMuster.breite + 17]
        CASE 4
            IF LEN(slEbenenKnoepfe) < 2 THEN RETURN TRUE
            foto("ohne_herz")
            gtk_toggle_button_set_active(slEbenenKnoepfe[1], TRUE)
            PRINT "wieder da: "; lwFarbe[12 * lwMuster.breite + 17]
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Ein Zug mit der Maus: druecken, ueber die Zellen ziehen, loslassen.
SUB zug(taste AS INTEGER, punkte AS ARRAY OF INTEGER, umschalt AS BOOLEAN)
    DIM n AS INTEGER : n = LEN(punkte)
    DIM z AS INTEGER : z = wzDruck(punkte[0], punkte[1], taste, umschalt)
    DIM k AS INTEGER
    FOR k = 2 TO n - 2 STEP 2
        wzZiehen(punkte[k], punkte[k + 1], umschalt)
    NEXT
    wzLos(punkte[n - 2], punkte[n - 1], umschalt)
END SUB

' Stufe 2: bearbeiten
DIM vfBlau AS INTEGER
DIM vfDatei AS STRING
FUNCTION vorfuehrenBearbeiten(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM i AS INTEGER, p AS INTEGER
    SELECT CASE schritt
        CASE 1
            PRINT "geladen: "; geladen; " farben "; lwMuster.farbanzahl(); " geaendert "; istGeaendert()
            ' DMC 996 (Electric Blue) aus dem Katalog ins Muster
            FOR p = 0 TO LEN(slPaletten) - 1
                IF slPaletten[p].hersteller = "DMC" THEN
                    FOR i = 0 TO LEN(slPaletten[p].garne) - 1
                        IF slPaletten[p].garne[i].nummer = "996" THEN garnHinzufuegen(p, i)
                    NEXT
                END IF
            NEXT
            vfBlau = wzFarbe
            PRINT "farbe "; vfBlau; " "; lwMuster.farben[vfBlau].garn.name; " symbol "; lwMuster.farben[vfBlau].symbol; " farben "; lwMuster.farbanzahl()
            ' dasselbe Garn noch einmal: keine neue Farbe
            FOR p = 0 TO LEN(slPaletten) - 1
                IF slPaletten[p].hersteller = "DMC" THEN
                    FOR i = 0 TO LEN(slPaletten[p].garne) - 1
                        IF slPaletten[p].garne[i].nummer = "996" THEN garnHinzufuegen(p, i)
                    NEXT
                END IF
            NEXT
            PRINT "noch einmal: farben "; lwMuster.farbanzahl(); " katalogzeilen "; LEN(slKatZeilen) > 100
        CASE 2
            ' neue Ebene, gefuelltes Rechteck in Blau
            ebenenBefehl(0)
            werkzeugWaehlen(WZ_RECHTECK, TRUE)
            zug(1, [2, 2, 6, 5, 9, 7], FALSE)
            PRINT "ebenen "; lwMuster.ebenen.anzahl(); " aktiv "; lwMuster.ebenen.aktiveEbene().name; " blau "; lwMuster.farben[vfBlau].stichzahl
            PRINT "schritte "; LEN(wzVerlauf.rueck); " oben "; wzVerlauf.textZurueck$(); " geaendert "; istGeaendert()
            PRINT "titel "; gtk_label_get_text_titel()
            leinwandEinpassen()
        CASE 3
            foto("rechteck")
            werkzeugZurueck()
            PRINT "zurueck: blau "; lwMuster.farben[vfBlau].stichzahl; " ebenen "; lwMuster.ebenen.anzahl()
        CASE 4
            foto("zurueck")
            werkzeugVor()
            ' Stift mit Umschalt-Linie und Ellipse: Umschalt haelt die Linie gerade
            werkzeugWaehlen(WZ_LINIE, FALSE)
            zug(1, [0, 10, 15, 12], TRUE)
            PRINT "linie gerade: "; lwMuster.stich(15, 10) = vfBlau; " "; lwMuster.stich(15, 12)
            werkzeugWaehlen(WZ_STIFT, FALSE)
            stichartWaehlen(kern.HALB_OL_UR)
            zug(1, [20, 20, 24, 24], FALSE)
            PRINT "stift: "; lwMuster.stich(22, 22) = vfBlau; " art "; lwMuster.ebenen.aktiveEbene().stichArt(22, 22)
            stichartWaehlen(kern.VOLL)
            ' rechte Maustaste radiert -- auch mit dem Stift
            zug(3, [22, 22], FALSE)
            PRINT "radiert: "; lwMuster.stich(22, 22) = vfBlau
            ' Pipette nimmt die Farbe darunter
            werkzeugWaehlen(WZ_PIPETTE, FALSE)
            zug(1, [17, 12], FALSE)
            PRINT "pipette: "; wzFarbe; " "; lwMuster.stich(17, 12)
            ' Fuellen auf der leeren Ebene in einem Schritt
            farbeWaehlen(vfBlau)
            werkzeugWaehlen(WZ_FUELLEN, FALSE)
            DIM vorher AS INTEGER : vorher = LEN(wzVerlauf.rueck)
            zug(1, [30, 30], FALSE)
            PRINT "gefuellt: "; lwMuster.ebenen.aktiveEbene().stichzahl(); " schritte +"; LEN(wzVerlauf.rueck) - vorher
            werkzeugZurueck()
            PRINT "fuellen zurueck: "; lwMuster.ebenen.aktiveEbene().stichzahl()
        CASE 5
            foto("wieder")
            ' Ebene sperren: Stift setzt nichts
            lwMuster.ebenen.aktiveEbene().gesperrt = TRUE
            werkzeugWaehlen(WZ_STIFT, FALSE)
            DIM n AS INTEGER : n = lwMuster.ebenen.aktiveEbene().stichzahl()
            zug(1, [35, 35, 38, 38], FALSE)
            PRINT "gesperrt: "; lwMuster.ebenen.aktiveEbene().stichzahl() = n
            lwMuster.ebenen.aktiveEbene().gesperrt = FALSE
            ' Ebene loeschen und zurueckholen
            ebenenBefehl(1)
            PRINT "geloescht: ebenen "; lwMuster.ebenen.anzahl(); " blau "; lwMuster.farben[vfBlau].stichzahl
            werkzeugZurueck()
            PRINT "zurueckgeholt: ebenen "; lwMuster.ebenen.anzahl(); " blau "; lwMuster.farben[vfBlau].stichzahl
            ' Deckkraft halb: das Blau mischt sich mit dem Stoff
            gtk_range_set_value(slDeckkraft, 50.0)
            PRINT "deckkraft "; lwMuster.ebenen.aktiveEbene().deckkraft; " geaendert "; istGeaendert()
        CASE 6
            foto("halb")
            gtk_range_set_value(slDeckkraft, 100.0)
            ' sichern und wieder laden
            vfDatei = fotoZiel + "_gesichert.pxs"
            IF fotoZiel = "" THEN vfDatei = PATHJOIN(TEMPDIR$(), "glutfaden_probe.pxs")
            PRINT "gesichert: "; musterSichern(vfDatei); " geaendert "; istGeaendert(); " titel "; gtk_label_get_text_titel()
            DIM m AS kern.Muster : m = kern.pxsLaden(vfDatei)
            PRINT "geladen: ebenen "; m.ebenen.anzahl(); " farben "; m.farbanzahl(); " stiche "; m.sticheGesamt(); " = "; lwMuster.sticheGesamt()
            PRINT "zelle 5,4: "; m.stich(5, 4) = vfBlau; " "; m.farben[vfBlau].garn.hersteller; " "; m.farben[vfBlau].garn.nummer
            ' zurueck nach dem Sichern: wieder ungesichert, und vor: wieder gesichert
            werkzeugZurueck()
            PRINT "nach zurueck "; istGeaendert()
            werkzeugVor()
            PRINT "nach vor "; istGeaendert()
            ' unbenutzte Farben entfernen (die Demo hat keine), umbenennen
            PRINT "ebene umbenannt: "; kern.ebeneUmbenennen(lwMuster, wzVerlauf, lwMuster.ebenen.aktiv, "Blau")
            allesNeu()
            PRINT "oben "; wzVerlauf.textZurueck$(); " liste "; gtk_label_get_text(slEbenenTexte[lwMuster.ebenen.anzahl() - 1 - lwMuster.ebenen.aktiv])
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

FUNCTION gtk_label_get_text_titel() AS STRING
    RETURN musterTitel + IIF(istGeaendert(), " •", "")
END FUNCTION

' Stufe 3: Auswahl, Vieleck, Symmetrie, Rueckstich, Fortschritt, Text
FUNCTION blauHolen() AS INTEGER
    DIM p AS INTEGER, i AS INTEGER
    FOR p = 0 TO LEN(slPaletten) - 1
        IF slPaletten[p].hersteller = "DMC" THEN
            FOR i = 0 TO LEN(slPaletten[p].garne) - 1
                IF slPaletten[p].garne[i].nummer = "996" THEN garnHinzufuegen(p, i)
            NEXT
        END IF
    NEXT
    RETURN wzFarbe
END FUNCTION

FUNCTION vorfuehrenStufe3(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM n AS INTEGER, vorher AS INTEGER
    SELECT CASE schritt
        CASE 1
            vfBlau = blauHolen()
            PRINT "geladen: "; geladen; " blau "; vfBlau; " stiche "; lwMuster.sticheGesamt()
            ' Auswahl ueber das Herz (Zeilen 12..20) auf der Ebene "Herz" -- die
            ' Auswahl nimmt wie im Original nur die AKTIVE Ebene --, kopieren,
            ' links oben einfuegen
            lwMuster.ebenen.aktiv = 1
            slEbeneMarkieren()
            PRINT "aktive ebene "; lwMuster.ebenen.aktiveEbene().name
            werkzeugWaehlen(WZ_AUSWAHL, FALSE)
            zug(1, [14, 12, 20, 16, 25, 20], FALSE)
            PRINT "auswahl "; mrAuswahl.anzahl; " "; mrAuswahl.x0; ","; mrAuswahl.y0; "-"; mrAuswahl.x1; ","; mrAuswahl.y1
            auswahlKopieren()
            vorher = lwMuster.sticheGesamt()
            einfuegenBeginnen()
            DIM z AS INTEGER : z = wzDruck(3, 3, 1, FALSE)
            PRINT "eingefuegt: +"; lwMuster.sticheGesamt() - vorher; " oben "; wzVerlauf.textZurueck$(); " auswahl jetzt "; mrAuswahl.x0; ","; mrAuswahl.y0
        CASE 2
            foto("eingefuegt")
            ' die eingefuegte Auswahl um 5 nach rechts ziehen: ein Schritt
            DIM s0 AS INTEGER : s0 = LEN(wzVerlauf.rueck)
            zug(1, [5, 5, 8, 5, 10, 5], FALSE)
            PRINT "verschoben: auswahl "; mrAuswahl.x0; ","; mrAuswahl.y0; " schritte +"; LEN(wzVerlauf.rueck) - s0; " zelle 4,5 "; lwMuster.stich(4, 5)
            ' drehen (r) und zurueck
            vorher = lwMuster.sticheGesamt()
            DIM ok AS BOOLEAN : ok = werkzeugTaste(&H72, FALSE, FALSE)
            PRINT "gedreht: "; wzVerlauf.textZurueck$(); " breite "; mrAuswahl.x1 - mrAuswahl.x0 + 1; " hoehe "; mrAuswahl.y1 - mrAuswahl.y0 + 1; " stiche gleich "; lwMuster.sticheGesamt() = vorher
            werkzeugZurueck()
            ' Entf und ESC
            ok = werkzeugTaste(&HFFFF, FALSE, FALSE)
            PRINT "geloescht: "; wzVerlauf.textZurueck$(); " stiche "; lwMuster.sticheGesamt() - vorher
            werkzeugZurueck()
            ok = werkzeugTaste(&HFF1B, FALSE, FALSE)
            PRINT "esc: auswahl weg "; NOT mehrHatAuswahl()
        CASE 3
            ' gefuelltes Vieleck in Blau: drei Ecken, rechte Taste schliesst
            farbeWaehlen(vfBlau)
            werkzeugWaehlen(WZ_VIELECK, TRUE)
            n = wzDruck(28, 26, 1, FALSE)
            n = wzDruck(36, 28, 1, FALSE)
            n = wzDruck(30, 35, 1, FALSE)
            n = wzDruck(30, 35, 3, FALSE)
            PRINT "vieleck: blau "; lwMuster.farben[vfBlau].stichzahl; " oben "; wzVerlauf.textZurueck$(); " ecken "; LEN(mrEcken)
            ' Symmetrie vierfach: ein Punkt mit dem Stift ergibt vier
            spiegelWaehlen(kern.SPIEGEL_VIERFACH)
            werkzeugWaehlen(WZ_STIFT, FALSE)
            vorher = lwMuster.farben[vfBlau].stichzahl
            zug(1, [2, 37], FALSE)
            PRINT "vierfach: +"; lwMuster.farben[vfBlau].stichzahl - vorher; " "; lwMuster.stich(37, 37) = vfBlau; " "; lwMuster.stich(2, 2) = vfBlau; " "; lwMuster.stich(37, 2) = vfBlau
            spiegelWaehlen(kern.SPIEGEL_AUS)
        CASE 4
            foto("vieleck")
            ' Rueckstich: zwei Klicks auf Rasterpunkte (Halbstich-Einheiten)
            werkzeugWaehlen(WZ_RUECKSTICH, FALSE)
            lwHalbX = 4 : lwHalbY = 60
            n = wzDruck(2, 30, 1, FALSE)
            lwHalbX = 30 : lwHalbY = 60
            n = wzDruck(15, 30, 1, FALSE)
            lwHalbX = 30 : lwHalbY = 70
            n = wzDruck(15, 35, 1, FALSE)
            n = wzDruck(15, 35, 3, FALSE)
            PRINT "rueckstiche "; LEN(lwMuster.rueckstiche); " oben "; wzVerlauf.textZurueck$()
            ' rechts auf eine Linie: entfernt
            lwHalbGenauX = 17.2 : lwHalbGenauY = 60.4
            n = wzDruck(8, 30, 3, FALSE)
            PRINT "entfernt: "; LEN(lwMuster.rueckstiche); " oben "; wzVerlauf.textZurueck$()
            werkzeugZurueck()
            PRINT "zurueck: "; LEN(lwMuster.rueckstiche)
        CASE 5
            foto("rueckstich")
            ' Fortschritt: die Zeile des Rahmens ziehen, dann Pfeile und Enter
            werkzeugWaehlen(WZ_FORTSCHRITT, FALSE)
            zug(1, [5, 5, 30, 5], FALSE)
            PRINT "erledigt "; lwFertig[5 * lwMuster.breite + 10]; " "; lwFertig[5 * lwMuster.breite + 30]; " oben "; wzVerlauf.textZurueck$()
            farbeWaehlen(lwMuster.stich(10, 5))
            DIM ok2 AS BOOLEAN : ok2 = werkzeugTaste(&HFF53, FALSE, FALSE)
            PRINT "naechster offen "; mrCursor MOD lwMuster.breite; ","; mrCursor \ lwMuster.breite
            ok2 = werkzeugTaste(&HFF0D, FALSE, FALSE)
            DIM c AS INTEGER : c = kern.naechsterOffen(lwMuster, wzFarbe, -1, TRUE)
            PRINT "nach enter "; mrCursor MOD lwMuster.breite; ","; mrCursor \ lwMuster.breite; " erster offen "; c MOD lwMuster.breite; ","; c \ lwMuster.breite
            ' rechts nimmt zurueck
            zug(3, [10, 5], FALSE)
            PRINT "zurueckgenommen 10,5: "; lwFertig[5 * lwMuster.breite + 10]
        CASE 6
            foto("fortschritt")
            ' Text, ohne Dialog: groesse 12 -> etwa 16 hoch
            farbeWaehlen(vfBlau)
            werkzeugWaehlen(WZ_TEXT, FALSE)
            txText = "Hi" : txSchrift = "Sans" : txGroesse = 12 : txFett = TRUE : txKursiv = FALSE
            textAnhaengen()
            PRINT "text: an der maus "; mrEinfuegen; " groesse "; mrEinfuegenAus.breite; "x"; mrEinfuegenAus.hoehe; " stiche > 20 "; mrEinfuegenAus.stiche() > 20
            vorher = lwMuster.farben[vfBlau].stichzahl
            n = wzDruck(6, 18, 1, FALSE)
            PRINT "text gesetzt: +"; lwMuster.farben[vfBlau].stichzahl - vorher = mrEinfuegenAus.stiche(); " oben "; wzVerlauf.textZurueck$(); " haengt "; mrEinfuegen
            ' seltene Farben zusammenlegen (die Demo hat Anchor 309 mit 17)
            n = seltenZusammenlegen(20)
            allesNeu()
            PRINT "selten: "; n; " oben "; wzVerlauf.textZurueck$()
        CASE 7
            foto("text")
            ' sichern und laden: Rueckstiche und erledigt kommen mit
            vfDatei = fotoZiel + "_stufe3.pxs"
            IF fotoZiel = "" THEN vfDatei = PATHJOIN(TEMPDIR$(), "glutfaden_stufe3.pxs")
            DIM ok3 AS BOOLEAN : ok3 = musterSichern(vfDatei)
            DIM m AS kern.Muster : m = kern.pxsLaden(vfDatei)
            DIM e AS kern.Ebene : e = kern.ebeneMitStich(m, 30, 5)
            PRINT "geladen: rueckstiche "; LEN(m.rueckstiche); " erledigt 30,5 "; e.istErledigt(30, 5); " stiche "; m.sticheGesamt() = lwMuster.sticheGesamt()
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 4: Bildimport -- Dialog bauen und einstellen, Vorschau, uebernehmen,
' erneut aus dem Quellbild (mit den Einstellungen von damals), eine
' Voreinstellung, sichern und laden.
DIM vfMuster AS kern.Muster
FUNCTION vorfuehrenStufe4(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM logoBild AS STRING : logoBild = PATHJOIN(CWD$(), "daten/bilder/glutfaden_256.png")
    DIM ok AS BOOLEAN
    SELECT CASE schritt
        CASE 1
            PRINT "dialog: "; imDialogBauen(logoBild, NIL); " bild "; imBildB; "x"; imBildH
            gtk_spin_button_set_value(imBreite, 60)
            gtk_spin_button_set_value(imHoehe, 60)
            gtk_spin_button_set_value(imFarben, 12)
            gtk_combo_box_set_active(imDither, 1)
            gtk_spin_button_set_value(imConfetti, 2)
            imAusschnitt = [0.1, 0.1, 0.9, 0.9]
            imAusschnittGeaendert()
            PRINT "info: "; gtk_label_get_text(imInfo)
        CASE 2
            imVorschauGeklickt(0, 0)
            PRINT "vorschau: "; imErgebnis.breite; "x"; imErgebnis.hoehe; " farben "; imErgebnis.farbanzahl(); " stiche "; imErgebnis.sticheGesamt()
        CASE 3
            IF fotoZiel <> "" THEN ok = gtkFoto(imDialog, fotoZiel + "_importdialog.png")
            DIM m AS kern.Muster : m = imRechnen()
            musterUebernehmen(m)
            imDialogWeg()
            PRINT "importiert: "; lwMuster.breite; "x"; lwMuster.hoehe; " farben "; lwMuster.farbanzahl(); " titel "; musterTitel; " ungesichert "; istGeaendert(); " datei leer "; musterPfad = ""
            PRINT "quelle: "; BASENAME(lwMuster.quellBild); " palette "; lwMuster.quellPalette; " dithering "; JSON_GET_STRING(lwMuster.metadaten, "dithering_mode")
        CASE 4
            foto("importiert")
            ' erneut aus dem Quellbild: dieselben Einstellungen, dasselbe Muster
            DIM e AS kern.Importeinstellung : e = imEinstellungAusMuster(lwMuster)
            PRINT "wieder: "; e.breite; "x"; e.hoehe; " farben "; e.maxFarben; " dither "; e.dithering; " confetti "; e.confetti; " ausschnitt "; e.ausschnitt[0]; " palette "; e.palette.name
            ok = imDialogBauen(lwMuster.quellBild, e)
            DIM m2 AS kern.Muster : m2 = imRechnen()
            imDialogWeg()
            DIM gleich AS BOOLEAN : gleich = m2.breite = lwMuster.breite AND m2.hoehe = lwMuster.hoehe
            DIM i AS INTEGER
            IF gleich THEN
                FOR i = 0 TO m2.breite * m2.hoehe - 1
                    DIM a1 AS INTEGER : a1 = m2.ebenen.aktiveEbene().raster[i]
                    DIM a2 AS INTEGER : a2 = lwMuster.ebenen.aktiveEbene().raster[i]
                    IF m2.farben[a1].garn.nummer <> lwMuster.farben[a2].garn.nummer THEN gleich = FALSE
                NEXT
            END IF
            PRINT "dasselbe muster: "; gleich
        CASE 5
            ' Voreinstellung "DP A4" setzt Groesse, Farben und die Diamant-Palette
            ok = imDialogBauen(logoBild, NIL)
            gtk_combo_box_set_active(imVorein, 5)
            DIM ein AS kern.Importeinstellung : ein = imEinstellung()
            PRINT "vorlage: "; ein.breite; "x"; ein.hoehe; " farben "; ein.maxFarben; " dither "; ein.dithering; " median "; ein.farbwahl = kern.WAHL_MEDIAN; " palette "; ein.palette.name
            imDialogWeg()
        CASE 6
            vfDatei = fotoZiel + "_stufe4.pxs"
            IF fotoZiel = "" THEN vfDatei = PATHJOIN(TEMPDIR$(), "glutfaden_stufe4.pxs")
            ok = musterSichern(vfDatei)
            DIM g AS kern.Muster : g = kern.pxsLaden(vfDatei)
            PRINT "geladen: quelle "; BASENAME(g.quellBild); " palette "; g.quellPalette; " max "; JSON_GET_INT(g.metadaten, "max_colors"); " ausschnitt "; g.quellAusschnitt[2]; " stiche "; g.sticheGesamt() = lwMuster.sticheGesamt(); " gesichert "; NOT istGeaendert()
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 5: Export -- der Dialog mit allen Zeilen, dann PDF, HTML, Bild, OXS
' (und wieder eingelesen) und das Paket, je in eine Datei neben die Fotos.
DIM vfVorher AS STRING

' Der Platz eines Garns in der Garnliste einer Palette des Blend-Dialogs.
FUNCTION vfGarnNr(palWahl AS INTEGER, nummer AS STRING) AS INTEGER
    DIM g AS ARRAY OF kern.Garn : g = slPaletten[blPal[gtk_combo_box_get_active(palWahl)]].garne
    DIM i AS INTEGER
    FOR i = 0 TO LEN(g) - 1
        IF g[i].nummer = nummer THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION vfZiel$(name AS STRING) AS STRING
    IF fotoZiel <> "" THEN RETURN fotoZiel + "_" + name
    RETURN PATHJOIN(TEMPDIR$(), "glutfaden_stufe5_" + name)
END FUNCTION

FUNCTION vorfuehrenStufe5(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    DIM d AS INTEGER
    SELECT CASE schritt
        CASE 1
            d = exDialogBauen()
            DIM f AS INTEGER, zeilen AS STRING
            FOR f = EX_PDF TO EX_PAKET
                gtk_combo_box_set_active(exFormat, f)
                zeilen = zeilen + " " + STR$(exZeilenAktiv())
            NEXT
            PRINT "dialog: zeilen je format"; zeilen; " papiere "; LEN(kern.papierNamen()); " entsprechungen "; LEN(exKreuz)
            gtk_combo_box_set_active(exFormat, EX_PDF)
            gtk_spin_button_set_value(exUeb, 2)
            gtk_entry_set_text(exWasser, "ENTWURF")
            gtk_toggle_button_set_active(exKreuz[0], TRUE)
            gtk_text_buffer_set_text(gtk_text_view_get_buffer(exNotizen), "Mit dem Rand beginnen." + CHR$(10) + "Rot zuletzt.", -1)
            IF fotoZiel <> "" THEN ok = gtkFoto(d, fotoZiel + "_exportdialog.png")
            exWahlMerken()
            DIM nz AS STRING : nz = exNotizenText$()
            gtk_widget_destroy(d)
            exExportieren(EX_PDF, vfZiel$("muster.pdf"), nz)
            PRINT "pdf: "; meldung; " | "; exWahlKreuz[0]; " ueb "; exWahlUeb
        CASE 2
            exExportieren(EX_HTML, vfZiel$("muster.html"), "")
            PRINT "html: "; meldung; " | beginnt "; LEFT$(READALL$(vfZiel$("muster.html")), 15)
        CASE 3
            exWahlZelle = 8 : exWahlSymbole = TRUE
            exExportieren(EX_BILD, vfZiel$("muster.png"), "")
            DIM b AS IMAGE : b = LOADIMAGE(vfZiel$("muster.png"))
            PRINT "bild: "; meldung; " | "; IMAGE_WIDTH(b); "x"; IMAGE_HEIGHT(b)
        CASE 4
            DIM vorher AS INTEGER : vorher = lwMuster.sticheGesamt()
            DIM alt AS STRING : alt = musterPfad
            exExportieren(EX_OXS, vfZiel$("muster.oxs"), "")
            PRINT "oxs: "; meldung
            ok = musterOeffnen(vfZiel$("muster.oxs"))
            PRINT "wieder eingelesen: "; ok; " stiche gleich "; lwMuster.sticheGesamt() = vorher; " datei leer "; musterPfad = ""; " | "; LEFT$(meldung, 29)
            foto("aus_oxs")
            ok = musterOeffnen(alt)
        CASE 5
            exWahlPapier = 0
            exExportieren(EX_PAKET, vfZiel$("muster.zip"), "")
            PRINT "paket: "; meldung
            PRINT "  "; JOIN$(ZIP_LIST(vfZiel$("muster.zip")), ", ")
        CASE 6
            ' Diamond: der Papierwaehler empfiehlt das Format fuer 1:1
            lwMuster.modus = "diamond" : lwMuster.stoff = 10
            exWahlPapier = -1
            d = exDialogBauen()
            DIM wahl AS INTEGER : wahl = gtk_combo_box_get_active(exPapier)
            PRINT "diamond: vorgewaehlt "; kern.papierNamen()[wahl]; " = empfehlung "; kern.papierEmpfehlung$(lwMuster, 1)
            gtk_widget_destroy(d)
            lwMuster.modus = "stitch" : lwMuster.stoff = 14
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 6: eine PCStitch-Datei ist geoeffnet (das Startargument), daneben
' liegt dieselbe als .xsd; dann Diamond Painting hin und zurueck (Strg+D).
FUNCTION vorfuehrenStufe6(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    SELECT CASE schritt
        CASE 1
            PRINT "pat: "; LEFT$(meldung, 32); " | ebenen "; lwMuster.ebenen.anzahl(); " stiche "; lwMuster.sticheGesamt(); " rueckstiche "; LEN(lwMuster.rueckstiche); " datei leer "; musterPfad = ""
            foto("aus_pat")
        CASE 2
            ok = musterOeffnen(LEFT$(start, LEN(start) - 4) + ".xsd")
            PRINT "xsd: "; ok; " "; LEFT$(meldung, 36); " | farben "; lwMuster.farbanzahl(); " blend "; lwMuster.farben[2].garn.istBlend()
            foto("aus_xsd")
        CASE 3
            ' Tweed-Blend: DMC 310 + DMC 321 (1:2), zweimal derselbe, dann 1:1
            DIM bd AS INTEGER : bd = blDialogBauen()
            gtk_combo_box_set_active(blGarnA, vfGarnNr(blPalA, "310"))
            gtk_combo_box_set_active(blGarnB, vfGarnNr(blPalB, "321"))
            gtk_spin_button_set_value(blStrB, 2)
            PRINT "blend: "; REPLACE$(gtk_label_get_text(blText), CHR$(10), " | ")
            IF fotoZiel <> "" THEN ok = gtkFoto(bd, fotoZiel + "_blend.png")
            DIM n0 AS INTEGER : n0 = lwMuster.farbanzahl()
            blUebernehmen()
            DIM n1 AS INTEGER : n1 = lwMuster.farbanzahl()
            blUebernehmen()
            DIM n2 AS INTEGER : n2 = lwMuster.farbanzahl()
            gtk_spin_button_set_value(blStrB, 1)
            blUebernehmen()
            PRINT "farben "; n0; " -> "; n1; " -> "; n2; " -> "; lwMuster.farbanzahl(); " | aktuell "; lwMuster.farben[wzFarbe].garn.name; " | rueckgaengig: "; wzVerlauf.textZurueck$()
            gtk_widget_destroy(bd)
        CASE 4
            DIM vorher AS STRING : vorher = lwMuster.farben[0].garn.hersteller + " " + lwMuster.farben[0].garn.nummer
            modusUmschalten()
            PRINT "diamond: "; lwMuster.modus; " stoff "; lwMuster.stoff; " | "; TEXT_AUS_ZEIGER$(gtk_button_get_label(kModus)); " | "; lwMuster.farben[0].garn.hersteller; " | verlauf leer "; NOT wzVerlauf.kannZurueck(); " ungesichert "; istGeaendert()
            foto("diamond")
            vfVorher = vorher
            blendDialog()
            PRINT "blend im diamond-modus: "; meldung
        CASE 5
            modusUmschalten()
            PRINT "zurueck: "; lwMuster.modus; " stoff "; lwMuster.stoff; " | "; TEXT_AUS_ZEIGER$(gtk_button_get_label(kModus)); " | dasselbe garn "; lwMuster.farben[0].garn.hersteller + " " + lwMuster.farben[0].garn.nummer = vfVorher
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 7: der Stickpfad -- Dialog, Strategie wechseln, Tooltip, Zoom mit
' Nummern, alle vergleichen, die drei Exporte; dazu der Schalter im
' Export-Dialog.
FUNCTION vfDialogFoto(name AS STRING) AS BOOLEAN
    IF fotoZiel = "" THEN RETURN TRUE
    DIM ok AS BOOLEAN : ok = gtkFoto(sdDialog, fotoZiel + "_" + name + ".png")
    IF NOT ok THEN PRINT "Foto nicht gesichert: "; name
    RETURN ok
END FUNCTION

FUNCTION vfSumme$() AS STRING
    DIM t AS STRING
    DIM w AS INTEGER
    FOR EACH w IN sdSumme
        t = t + " | " + gtk_label_get_text(w)
    NEXT
    RETURN MID$(t, 3, 999)
END FUNCTION

FUNCTION vorfuehrenStufe7(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    SELECT CASE schritt
        CASE 1
            DIM d AS INTEGER : d = sdDialogBauen()
            PRINT "dialog: "; kern.spName$(gtk_combo_box_get_active(sdStrategie)); " stoff "; gtk_spin_button_get_value_as_int(sdStoff); " | "; vfSumme$()
            PRINT "farben "; LEN(sdZeilen); " gewaehlt "; sdAktiv; " "; sdGarnName$(sdErg.pfade[sdAktiv]); " | vergleich sichtbar "; gtk_widget_get_visible(sdVergleich)
        CASE 2
            ok = vfDialogFoto("stickpfad")
            gtk_combo_box_set_active(sdStrategie, kern.SP_NACHBAR)
            PRINT "naechster nachbar: "; vfSumme$()
            gtk_list_box_select_row(sdListe, sdZeilen[1])
            DIM p AS kern.Farbpfad : p = sdErg.pfade[sdAktiv]
            DIM z AS FLOAT : z = SD_ZELLE * sdZoom
            DIM i AS INTEGER : i = sdStichBei(sdOx + (p.xs[2] + 0.5) * z, sdOy + (p.ys[2] + 0.5) * z)
            PRINT "farbe 2 "; sdGarnName$(p); " | maus auf stich 3: "; sdTipp$(i); " | daneben "; sdStichBei(sdOx - 5, sdOy - 5)
            ' einen Sprung suchen
            FOR i = 1 TO p.stiche() - 1
                IF p.istSprung(i) THEN
                    PRINT "sprung: "; sdTipp$(i)
                    EXIT FOR
                END IF
            NEXT
        CASE 3
            gtk_toggle_button_set_active(sdNummern, TRUE)
            DIM vorher AS FLOAT : vorher = sdZoom
            sdZoomKnopf(0, 1) : sdZoomKnopf(0, 1) : sdZoomKnopf(0, 1)
            PRINT "zoom x1.25^3: "; ABS(sdZoom / vorher - 1.953125) < 0.0001; " | "; gtk_label_get_text(sdZoomText) <> ""
            ok = vfDialogFoto("stickpfad_nummern")
            sdZoomKnopf(0, 0)
            PRINT "eingepasst: "; ABS(sdZoom - vorher) < 0.0001
        CASE 4
            gtk_spin_button_set_value(sdStoff, 18)
            ' vorher eine andere Strategie -- der Vergleich soll die beste waehlen
            gtk_combo_box_set_active(sdStrategie, kern.SP_DIAGONAL)
            PRINT "vor dem vergleich: "; kern.spName$(gtk_combo_box_get_active(sdStrategie)); " | "; vfSumme$()
            sdAlleVergleichen(0, 0)
            PRINT "verglichen: "; kern.spName$(gtk_combo_box_get_active(sdStrategie)); " | "; vfSumme$(); " | vergleich sichtbar "; gtk_widget_get_visible(sdVergleich)
            DIM r AS kern.Stickpfad
            FOR EACH r IN sdVergleiche
                PRINT "  "; sdKurzname$(r.strategie); " "; FORMAT$(r.distanz, "%.1f"); " "; r.spruenge; " "; FORMAT$(r.garnCm, "%.0f"); " "; kern.spBewertung$(r.distanz, sdVergleiche[0].distanz)
            NEXT
        CASE 5
            ' erst jetzt: die eben gezeigte Tabelle hat im selben Schritt noch keine Groesse
            ok = vfDialogFoto("stickpfad_vergleich")
            DIM ziel AS STRING : ziel = IIF(fotoZiel <> "", fotoZiel, PATHJOIN(TEMPDIR$(), "glutfaden_stufe7"))
            PRINT "text: ["; sdTextSichern$(ziel + "_plan.txt"); "] "; LEFT$(READLINES(ziel + "_plan.txt")[4], 99)
            PRINT "bild: "; sdBildSichern(ziel + "_pfad.png")
            DIM b AS IMAGE : b = LOADIMAGE(ziel + "_pfad.png")
            PRINT "  "; IMAGE_WIDTH(b); " x "; IMAGE_HEIGHT(b); " = "; lwMuster.breite * 15 + 60; " x "; lwMuster.hoehe * 15 + 120
            DIM ordner AS STRING : ordner = ziel + "_alle"
            IF NOT DIREXISTS(ordner) THEN MKDIR(ordner)
            DIM fehler AS ARRAY OF STRING
            PRINT "alle: "; sdAlleBilder(ordner, fehler); " fehler "; LEN(fehler)
            DIM namen AS ARRAY OF STRING : namen = DIRLIST(ordner)
            SORT(namen)
            PRINT "  "; JOIN$(namen, ", ")
            ' Grund nach der Helligkeit des Garns (dunkel -> hell, hell -> dunkel),
            ' ein Stich in seiner Farbe, die Legende unten
            DIM k AS INTEGER
            FOR k = 0 TO 1
                DIM pb AS IMAGE : pb = LOADIMAGE(PATHJOIN(ordner, namen[k]))
                DIM q AS kern.Farbpfad : q = sdErg.pfade[k]
                PRINT "  "; namen[k]; ": grund "; kern.farbeAlsHex$(GETPIXEL(pb, 3, 3)); " stich 3 "; kern.farbeAlsHex$(GETPIXEL(pb, 30 + q.xs[2] * 15 + 13, 30 + q.ys[2] * 15 + 2)); " garn "; kern.farbeAlsHex$(lwMuster.farben[q.farbe].garn.farbe)
            NEXT
            gtk_widget_destroy(sdDialog)
            sdDialog = 0
        CASE 6
            DIM ed AS INTEGER : ed = exDialogBauen()
            PRINT "export: stickpfad vorgewaehlt "; gtk_toggle_button_get_active(exStickpfad)
            gtk_toggle_button_set_active(exStickpfad, FALSE)
            exWahlMerken()
            gtk_widget_destroy(ed)
            PRINT "abgewaehlt gemerkt: "; NOT exWahlStickpfad
            exWahlStickpfad = TRUE
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION
