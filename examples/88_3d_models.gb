' 88_3d_models.gb -- 3D-Modelle (native-only, F6 / dhrun.py --native)
'
' Zeigt geladene & prozedural generierte Modelle:
'   LOADMODEL(pfad$)                      -> MODEL  (OBJ/GLTF/...)
'   MESH_CUBE/SPHERE/CYLINDER/TORUS/KNOT/PLANE -> MODEL  (prozedural)
'   MODEL(m, x,y,z, scale, farbe)               gefuellt zeichnen
'   MODEL_EX(m, x,y,z, ax,ay,az, winkel, scale, farbe)  mit Rotation
'   MODEL_WIRES(m, x,y,z, scale, farbe)         Drahtgitter
'   MODEL_TEXTURE(m, bild)                      Diffuse-Textur (LOADIMAGE)
'
' Modell-Handles bleiben ueber Frames gueltig -> einmal erzeugen, oft zeichnen.

IMPORT "g3d"

SCREEN(800, 480, "3D-Modelle", 1)

' Prozedurale Meshes einmalig erzeugen.
DIM torus AS INTEGER
DIM knot AS INTEGER
DIM ball AS INTEGER
DIM ground AS INTEGER
torus  = MESH_TORUS(0.6, 0.25, 16, 24)
knot   = MESH_KNOT(0.5, 0.4, 24, 12)
ball   = MESH_SPHERE(0.8, 16, 16)
ground = MESH_PLANE(20.0, 20.0, 1, 1)

DIM t AS FLOAT
t = 0.0

DIM frame AS INTEGER
FOR frame = 0 TO 300
    t = t + 0.03
    CLS(&H0E1018)

    ' Langsam um die Szene kreisende Kamera.
    DIM cx AS FLOAT
    DIM cz AS FLOAT
    cx = COS(t * 0.4) * 7.0
    cz = SIN(t * 0.4) * 7.0
    CAMERA3D(cx, 4.5, cz, 0, 0.5, 0, 45)

    GRID3D(20, 1.0)
    MODEL(ground, 0, 0, 0, 1.0, &H1A2030)

    ' Rotierender Torus (gefuellt) ueber dem Boden.
    MODEL_EX(torus, -2.0, 1.2, 0, 0, 1, 0, t * 60.0, 1.0, &H30D0B0)

    ' Rotierender Knoten (Drahtgitter), andere Achse.
    MODEL_EX(knot, 2.0, 1.4, 0, 1, 1, 0, t * 45.0, 1.0, &HFFC040)

    ' Pulsierende Kugel in der Mitte.
    DIM s AS FLOAT
    s = 0.8 + SIN(t * 2.0) * 0.2
    MODEL(ball, 0, 1.3, 0, s, &HE05070)
    MODEL_WIRES(ball, 0, 1.3, 0, s + 0.02, &H401020)

    ' 2D-HUD obenauf.
    TEXT(12, 10, "3D-Modelle: Torus . Knot . Sphere", WHITE)
    TEXT(12, 34, "MESH_* + MODEL/MODEL_EX/MODEL_WIRES", &H88AACC)

    FLIP()
NEXT
