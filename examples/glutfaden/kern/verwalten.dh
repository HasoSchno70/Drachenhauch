' Die Groessen fuer Diamond Painting (2,5 mm Drill)
FUNCTION dpVorlagenNamen() AS ARRAY OF STRING
    RETURN ["— Keine Auswahl (eigene Werte) —", "DP A4 quadratisch (60×60 = 15×15 cm)", "DP A4 hoch (60×80 = 15×20 cm)", "DP A4 quer (80×60 = 20×15 cm)", "DP A3 (100×100 = 25×25 cm)", "DP A3 quer (140×100 = 35×25 cm)", "DP A2 (150×150 = 38×38 cm)", "DP A2 quer (200×150 = 50×38 cm)", "DP A1 (200×200 = 50×50 cm)", "DP A1 quer (280×200 = 70×50 cm)", "DP A0 (300×300 = 75×75 cm)", "DP Gross (400×400 = 100×100 cm)"]
END FUNCTION

' je Eintrag Breite und Hoehe (der erste: keine)
FUNCTION dpVorlagenMasse() AS ARRAY OF INTEGER
    RETURN [0, 0, 60, 60, 60, 80, 80, 60, 100, 100, 140, 100, 150, 150, 200, 150, 200, 200, 280, 200, 300, 300, 400, 400]
END FUNCTION

' Eigene Vorlagen (PyStickys user_templates.json: eine Liste von Objekten mit
' name, width, height, fabric_count, description, category). Ein Eintrag mit
' fehlendem Pflichtfeld oder unbekanntem Schluessel wird uebergangen, wie
' bei PySticky (UserTemplate(**eintrag)).
FUNCTION eigeneVorlagen(pfad AS STRING) AS ARRAY OF Vorlage
    DIM l AS ARRAY OF Vorlage : l = []
    IF NOT FILEEXISTS(pfad) THEN RETURN l
    DIM j AS JSON_HANDLE
    TRY
        j = JSON_LOAD(pfad)
    CATCH e
        RETURN l
    END TRY
    IF JSON_TYPE(j, "") <> "array" THEN RETURN l
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "") - 1
        DIM w AS STRING : w = STR$(i)
        IF JSON_TYPE(j, w) <> "object" THEN CONTINUE
        DIM ok AS BOOLEAN : ok = TRUE
        DIM k AS STRING
        FOR EACH k IN JSON_KEYS(j, w)
            IF INSTR("|name|width|height|fabric_count|description|category|", "|" + k + "|") < 0 THEN ok = FALSE
        NEXT
        IF NOT ok OR NOT JSON_HAS(j, w + ".name") OR NOT JSON_HAS(j, w + ".width") OR NOT JSON_HAS(j, w + ".height") THEN CONTINUE
        ' Breite und Hoehe wie Pythons int() -- PySticky nimmt sie ungeprueft
        ' und stolpert erst beim Benutzen ueber eine Kommazahl oder einen Text
        DIM vb AS INTEGER, vh AS INTEGER
        IF NOT jsonGanz(j, w + ".width", vb) OR NOT jsonGanz(j, w + ".height", vh) THEN CONTINUE
        DIM v AS Vorlage : v = NEW Vorlage()
        IF JSON_TYPE(j, w + ".name") = "string" THEN
            v.name = JSON_GET_STRING(j, w + ".name")
        ELSE
            v.name = JSON_STRINGIFY(JSON_GET_JSON(j, w + ".name"))
        END IF
        v.breite = vb
        v.hoehe = vh
        v.stoff = 14
        DIM vs AS INTEGER
        IF JSON_HAS(j, w + ".fabric_count") THEN
            IF jsonGanz(j, w + ".fabric_count", vs) THEN v.stoff = vs
        END IF
        IF JSON_HAS(j, w + ".description") THEN
            IF JSON_TYPE(j, w + ".description") = "string" THEN v.beschreibung = JSON_GET_STRING(j, w + ".description")
        END IF
        v.kategorie = "Eigene"
        IF JSON_HAS(j, w + ".category") THEN
            IF JSON_TYPE(j, w + ".category") = "string" THEN v.kategorie = JSON_GET_STRING(j, w + ".category")
        END IF
        v.zeichen = "⭐"
        ARRAY_PUSH(l, v)
    NEXT
    RETURN l
END FUNCTION

FUNCTION eigeneVorlagenJson$(l AS ARRAY OF Vorlage) AS STRING
    DIM j AS JSON_HANDLE : j = JSON_NEW_ARRAY()
    DIM v AS Vorlage
    FOR EACH v IN l
        DIM e AS JSON_HANDLE : e = JSON_NEW_OBJECT()
        JSON_SET_STRING(e, "name", v.name)
        JSON_SET_INT(e, "width", v.breite)
        JSON_SET_INT(e, "height", v.hoehe)
        JSON_SET_INT(e, "fabric_count", v.stoff)
        JSON_SET_STRING(e, "description", v.beschreibung)
        JSON_SET_STRING(e, "category", v.kategorie)
        JSON_APPEND_JSON(j, "", e)
    NEXT
    RETURN JSON_PRETTY(j)
END FUNCTION

' Ein neues Muster wie PyStickys "Neu": eine Ebene "Hintergrund", Stoff (im
' Diamond-Modus 10 = 2,5-mm-Drill), mit dem Namen der Vorlage und genau einer
' Farbe -- im Kreuzstich das erste Garn der Palette `palette` (fehlt sie:
' Anchor), im Diamond-Modus das erste der alphabetisch ersten
' Diamond-Palette.
FUNCTION musterAnlegen(b AS INTEGER, h AS INTEGER, stoff AS INTEGER, diamant AS BOOLEAN, vorlage AS STRING, paletten AS ARRAY OF Palette, palette AS STRING, symbole AS ARRAY OF STRING) AS Muster
    DIM m AS Muster : m = neuesMuster(tr$("Neues Muster"), b, h)
    m.stoff = IIF(diamant, 10, stoff)
    IF diamant THEN m.modus = "diamond"
    IF vorlage <> "" THEN m.name = vorlage
    DIM q AS Palette
    IF diamant THEN
        DIM namen AS ARRAY OF STRING : namen = []
        DIM p AS Palette
        FOR EACH p IN paletten
            IF p.istDiamant THEN ARRAY_PUSH(namen, p.name)
        NEXT
        SORT(namen)
        IF LEN(namen) > 0 THEN q = paletteNamens(paletten, namen[0])
    ELSE
        q = paletteNamens(paletten, palette)
        IF IS_NIL(q) THEN q = paletteNamens(paletten, "Anchor")
    END IF
    IF NOT IS_NIL(q) THEN
        IF LEN(q.garne) > 0 THEN
            DIM v AS Verlauf : v = neuerVerlauf()
            DIM nr AS INTEGER : nr = farbeHinzufuegen(m, v, q.garne[0], symbole, FALSE, FALSE)
        END IF
    END IF
    RETURN m
END FUNCTION

' Fertige Groesse in cm (Stiche je Zoll / 2,54)
FUNCTION fertigCm(stiche AS INTEGER, stoff AS FLOAT) AS FLOAT
    RETURN stiche / (stoff / 2.54)
END FUNCTION

' --- Eigenschaften ----------------------------------------------------------------------------
' author, copyright, notes, started_date (JJJJ-MM-TT) in den Metadaten; leer
' nimmt den Schluessel heraus.

FUNCTION eigenschaftenSchluessel() AS ARRAY OF STRING
    RETURN ["author", "copyright", "notes", "started_date"]
END FUNCTION

FUNCTION eigenschaft$(m AS Muster, k AS STRING) AS STRING
    IF NOT JSON_HAS(m.metadaten, k) THEN RETURN ""
    IF JSON_TYPE(m.metadaten, k) = "string" THEN RETURN JSON_GET_STRING(m.metadaten, k)
    IF JSON_TYPE(m.metadaten, k) = "null" THEN RETURN ""
    RETURN JSON_STRINGIFY(JSON_GET_JSON(m.metadaten, k))
END FUNCTION

' Die Notizen; ohne eigene die des PDF-Exports
FUNCTION notizen$(m AS Muster) AS STRING
    DIM n AS STRING : n = eigenschaft$(m, "notes")
    IF n = "" THEN n = eigenschaft$(m, "pdf_notes")
    RETURN n
END FUNCTION

' Liefert, ob sich etwas geaendert hat
FUNCTION eigenschaftSetzen(m AS Muster, k AS STRING, wert AS STRING) AS BOOLEAN
    DIM w AS STRING : w = TRIM$(wert)
    IF w = "" THEN
        IF NOT JSON_HAS(m.metadaten, k) THEN RETURN FALSE
        DIM weg AS BOOLEAN : weg = JSON_REMOVE(m.metadaten, k)
        RETURN TRUE
    END IF
    IF JSON_HAS(m.metadaten, k) THEN
        IF JSON_TYPE(m.metadaten, k) = "string" THEN
            IF JSON_GET_STRING(m.metadaten, k) = w THEN RETURN FALSE
        END IF
    END IF
    JSON_SET_STRING(m.metadaten, k, w)
    RETURN TRUE
END FUNCTION

' Wie PyStickys fabric_label_for
FUNCTION stoffBezeichnung$(m AS Muster) AS STRING
    DIM s AS STRING : s = IIF(m.stoff = INT(m.stoff), STR$(INT(m.stoff)), STR$(m.stoff))
    IF m.modus <> "diamond" THEN RETURN trf$("Aida {0}", [s])
    IF m.stoff = 10 THEN RETURN "2.5 mm Square"
    IF m.stoff = 9 THEN RETURN "2.8 mm Round"
    IF m.stoff = 8 THEN RETURN "3.0 mm Round"
    RETURN s + " (Drill-Pitch)"
END FUNCTION

' --- Abgelegte Dateien (PySticky dragEnterEvent/dropEvent) ------------------------

CONST ABLAGE_KEINE = 0
CONST ABLAGE_MUSTER = 1               ' .pxs und die fremden Formate
CONST ABLAGE_BILD = 2                 ' geht in den Bild-Import

' Bildformate: was die Laufzeit selbst liest (LOADIMAGE), und was dazu
' kommen kann, wenn GTKs Bildlader es hat (PySticky: WebP, TIFF, AVIF; dazu
' HEIC/HEIF und JPEG XL). Ob ein Lader da ist, haengt an der Installation --
' die GTK aus Inkscape kann TIFF und AVIF, aber kein WebP.
FUNCTION bildEndungenEigen() AS ARRAY OF STRING
    RETURN ["png", "jpg", "jpeg", "bmp", "gif", "tga", "qoi"]
END FUNCTION

FUNCTION bildEndungenZusatz() AS ARRAY OF STRING
    RETURN ["webp", "tif", "tiff", "avif", "heic", "heif", "jxl"]
END FUNCTION

' Die eigenen und die zusaetzlichen, die der Bildlader kennt (system: seine
' Endungen, klein geschrieben)
FUNCTION bildEndungen(system AS ARRAY OF STRING) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = bildEndungenEigen()
    DIM e AS STRING
    FOR EACH e IN bildEndungenZusatz()
        IF ARRAY_INDEXOF(system, e) >= 0 THEN ARRAY_PUSH(aus, e)
    NEXT
    RETURN aus
END FUNCTION

FUNCTION endung$(pfad AS STRING) AS STRING
    DIM e AS STRING : e = LOWER$(pfad)
    DIM p AS INTEGER : p = INSTRREV(e, ".")
    IF p < 0 THEN RETURN ""
    RETURN MID$(e, p + 1)
END FUNCTION

' Liest die Laufzeit das Bild nicht selbst, geht es ueber GTKs Bildlader
FUNCTION bildUeberGtk(pfad AS STRING) AS BOOLEAN
    RETURN ARRAY_INDEXOF(bildEndungenEigen(), endung$(pfad)) < 0
END FUNCTION

' Was mit einer Datei geschieht, nach ihrer Endung -- Bilder die, die die
' Laufzeit liest (ablageArt) bzw. dazu die aus bildEndungen (ablageArtMit).
FUNCTION ablageArt(pfad AS STRING) AS INTEGER
    RETURN ablageArtMit(pfad, bildEndungenEigen())
END FUNCTION

FUNCTION ablageArtMit(pfad AS STRING, bilder AS ARRAY OF STRING) AS INTEGER
    DIM e AS STRING : e = endung$(pfad)
    IF e = "" THEN RETURN ABLAGE_KEINE
    IF e = "pxs" OR e = "oxs" OR e = "xsd" OR e = "pat" THEN RETURN ABLAGE_MUSTER
    IF ARRAY_INDEXOF(bilder, e) >= 0 THEN RETURN ABLAGE_BILD
    RETURN ABLAGE_KEINE
END FUNCTION

' Die Zeilen einer text/uri-list (RFC 2483): getrennt durch CR LF, Zeilen mit
' "#" sind Kommentare, leere fallen weg.
FUNCTION uriListe(text AS STRING) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM z AS STRING
    FOR EACH z IN SPLIT$(REPLACE$(text, CHR$(13), ""), CHR$(10))
        z = TRIM$(z)
        IF z = "" OR LEFT$(z, 1) = "#" THEN CONTINUE
        ARRAY_PUSH(aus, z)
    NEXT
    RETURN aus
END FUNCTION

' --- Fremde Muster (PySticky PatternImportDialog) ---------------------------------

CLASS FremdImport
    DIM muster AS Muster
    DIM warnungen AS ARRAY OF STRING
    DIM format AS STRING                ' wie PySticky: "PCStitch (PAT)" ...
END CLASS

' Der Formatname zur Endung (PySticky _PatternImportWorker), "" = keins davon
FUNCTION fremdFormat$(pfad AS STRING) AS STRING
    DIM e AS STRING : e = LOWER$(pfad)
    DIM p AS INTEGER : p = INSTRREV(e, ".")
    IF p < 0 THEN RETURN ""
    SELECT CASE MID$(e, p)
        CASE ".xsd" : RETURN tr$("Pattern Maker (XSD)")
        CASE ".pat" : RETURN tr$("PCStitch (PAT)")
        CASE ".oxs" : RETURN tr$("Open Cross Stitch (OXS)")
    END SELECT
    RETURN ""
END FUNCTION

' Eine XSD-, PAT- oder OXS-Datei lesen; ein Fehler ist ein THROW mit der
' Meldung des Lesers. Die Warnungen bleiben, wie der Leser sie schreibt.
FUNCTION fremdLaden(pfad AS STRING, paletten AS ARRAY OF Palette, symbole AS ARRAY OF STRING) AS FremdImport
    DIM f AS FremdImport : f = NEW FremdImport()
    f.format = fremdFormat$(pfad)
    DIM e AS STRING : e = LOWER$(pfad)
    IF f.format = "" THEN
        DIM p AS INTEGER : p = INSTRREV(e, ".")
        THROW trf$("Unbekanntes Format: {0}", [IIF(p < 0, tr$("(ohne Endung)"), MID$(e, p))])
    END IF
    IF RIGHT$(e, 4) = ".oxs" THEN
        DIM o AS OxsImport : o = oxsLaden(pfad, paletten, symbole)
        f.muster = o.muster : f.warnungen = o.warnungen
    ELSEIF RIGHT$(e, 4) = ".pat" THEN
        DIM pa AS PatImport : pa = patLaden(pfad, paletten, symbole)
        f.muster = pa.muster : f.warnungen = pa.warnungen
    ELSE
        DIM x AS XsdImport : x = xsdLaden(pfad, paletten, symbole)
        f.muster = x.muster : f.warnungen = x.warnungen
    END IF
    RETURN f
END FUNCTION

' Die Angaben des Dialogs (PySticky _update_info): Name, Groesse in Stichen
' und Zentimetern, Farben, Stiche ueber alle Ebenen, Format.
FUNCTION fremdInfo(f AS FremdImport) AS ARRAY OF STRING
    DIM m AS Muster : m = f.muster
    RETURN [m.name, trf$("{0} × {1} Stiche ({2} × {3} cm)", [STR$(m.breite), STR$(m.hoehe), zahlAnzeige$(m.breiteCm(), 1), zahlAnzeige$(m.hoeheCm(), 1)]), _
        STR$(m.farbanzahl()), STR$(statistikVon(m).sticheGesamt), f.format]
END FUNCTION

' --- Neu in Glutfaden (daten/neuigkeiten.txt) ----------------------------------------
' Abschnitte mit "## Titel", darunter Absaetze (Leerzeilen trennen sie), "#" am
' Zeilenanfang ist Kommentar. Liefert (Titel, Texte); ein Text haelt seine
' Absaetze mit einer Leerzeile dazwischen. Ohne Datei: zwei leere Listen.
FUNCTION neuigkeitenLesen(pfad AS STRING) AS TUPLE
    DIM titel AS ARRAY OF STRING : titel = []
    DIM texte AS ARRAY OF STRING : texte = []
    IF NOT FILEEXISTS(pfad) THEN RETURN (titel, texte)
    DIM nl AS STRING : nl = CHR$(10)
    DIM absatz AS STRING, text AS STRING, z AS STRING
    FOR EACH z IN READLINES(pfad)
        z = RTRIM$(z)
        IF LEFT$(z, 3) = "## " THEN
            IF LEN(titel) > 0 THEN ARRAY_PUSH(texte, neuAbsatz$(text, absatz))
            ARRAY_PUSH(titel, TRIM$(MID$(z, 3)))
            text = ""
            absatz = ""
        ELSEIF LEFT$(z, 1) = "#" THEN
            CONTINUE
        ELSEIF LEN(titel) = 0 THEN
            CONTINUE
        ELSEIF TRIM$(z) = "" THEN
            text = neuAbsatz$(text, absatz)
            absatz = ""
        ELSE
            absatz = IIF(absatz = "", TRIM$(z), absatz + " " + TRIM$(z))
        END IF
    NEXT
    IF LEN(titel) > 0 THEN ARRAY_PUSH(texte, neuAbsatz$(text, absatz))
    RETURN (titel, texte)
END FUNCTION

FUNCTION neuAbsatz$(text AS STRING, absatz AS STRING) AS STRING
    IF absatz = "" THEN RETURN text
    IF text = "" THEN RETURN absatz
    RETURN text + CHR$(10) + CHR$(10) + absatz
END FUNCTION
