' Star Pilot - der erste Spielzustand. Noch ohne Bild, nur in Variablen.
'
' Wir merken uns: aktueller Score, verbleibende Leben, Highscore und
' den Spielernamen. In spaeteren Kapiteln zeichnen wir genau diese Werte
' auf den Bildschirm - die Variablen bleiben dann dieselben.

DIM score        AS INTEGER
DIM lives        AS INTEGER
DIM highscore    AS INTEGER
DIM player_name  AS STRING

score        = 0
lives        = 3
highscore    = 4200
player_name  = "Anonymous"

PRINT "=== Star Pilot - Status ==="
PRINT "Spieler:   " + player_name
PRINT "Score:     " + STR$(score)
PRINT "Leben:     " + STR$(lives)
PRINT "Highscore: " + STR$(highscore)

' Ein Treffer: 100 Punkte dazu.
score = score + 100
PRINT ""
PRINT "Nach erstem Treffer:"
PRINT "Score:     " + STR$(score)
