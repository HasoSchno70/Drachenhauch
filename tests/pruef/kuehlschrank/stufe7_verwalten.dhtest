=== supermaerkte: vorlage, gangplan bearbeiten, eingebauten anpassen, loeschen, standard erst mit speichern
' Ein neuer Markt kopiert eine Vorlage (oder den Standardplan); das
' Gangplan-Fenster ordnet nach Gang, nimmt Abteilungen dazu und weg. Ein
' eingebauter Markt bekommt einen eigenen Plan und kann zurueck. Wird ein
' eigener Markt geloescht, der Standard war, ist es keiner mehr. Der
' Standard-Markt gilt erst mit "Speichern" (die Python-App schrieb ihn bei
' jeder Wahl, auch beim Zuruecksetzen).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
PRINT "neu ["; marktAnlegen$("Mein Markt", "REWE"); "] "; gangZahl(gangplan("Mein Markt")); " "; gangplan("Mein Markt")[0]
PRINT "doppelt ["; marktAnlegen$("mein markt", ""); "] eingebaut ["; marktAnlegen$("aldi", ""); "]"
PRINT "standardplan ["; marktAnlegen$("Ecke", ""); "] "; JOIN$(gangplan("Ecke"), ";")
DIM g AS GangplanFenster : g = NEW GangplanFenster()
g.markt = "Ecke"
g.Zeigen()
PRINT "fenster "; GUI_TABLE_ROW_COUNT(g.tabelle); " | "; GUI_TABLE_GET_CELL(g.tabelle, 0, 0); "=" ; GUI_TABLE_GET_CELL(g.tabelle, 0, 1); " … "; GUI_TABLE_GET_CELL(g.tabelle, 8, 0); "=" ; GUI_TABLE_GET_CELL(g.tabelle, 8, 1)
GUI_SET_TEXT(g.neuFeld, "Kaffee")
GUI_SET_VALUE(g.neuGang, 4)
g.knopfNeu_Klick()
g.tabelle_Zelle(0, 2)
GUI_TABLE_SET_CELL(g.tabelle, 0, 1, "99")
g.knopfSpeichern_Klick()
PRINT "gespeichert "; g.gesichert; " | "; JOIN$(gangplan("Ecke"), ";")
' Ein eingebauter bekommt einen eigenen Plan -- und wieder den eingebauten.
planSpeichern("ALDI", ["Obst=2", "Brot=1"])
PRINT "aldi eigen "; hatEigenenPlan("ALDI"); " "; JOIN$(gangplan("ALDI"), ";")
planLoeschen("ALDI")
PRINT "aldi zurueck "; hatEigenenPlan("ALDI"); " "; gangZahl(gangplan("ALDI"))
' Standard: ein eigener geloescht -> keiner; ein eingebauter bleibt.
standardMarktSetzen("Ecke")
planLoeschen("Ecke")
PRINT "ecke weg ["; gewaehlterMarkt$(); "] "; ARRAY_INDEXOF(marktListe(), "Ecke")
standardMarktSetzen("REWE")
planSpeichern("REWE", ["Obst=1"])
planLoeschen("REWE")
PRINT "rewe bleibt ["; gewaehlterMarkt$(); "]"
' Ein Plan, wie ihn die Python-App schreiben kann -- nicht nach Gang: das
' Fenster ordnet ihn.
DB_EXEC(db, "INSERT INTO store_layouts (store_name, layout_json) VALUES ('Wirr', ?)", "{" + CHR$(34) + "Getränke" + CHR$(34) + ": 7, " + CHR$(34) + "Obst" + CHR$(34) + ": 1}")
DIM g2 AS GangplanFenster : g2 = NEW GangplanFenster()
g2.markt = "Wirr"
g2.Zeigen()
PRINT "wirr "; GUI_TABLE_GET_CELL(g2.tabelle, 0, 0); " "; GUI_TABLE_GET_CELL(g2.tabelle, 1, 0)
g2.knopfAbbrechen_Klick()
DB_EXEC(db, "DELETE FROM store_layouts WHERE store_name = 'Wirr'")
' Im Fenster: die Tabelle, der Standard erst mit Speichern.
planSpeichern("EDEKA", ["Obst=1"])
DIM ef AS EinstellungenFenster : ef = NEW EinstellungenFenster()
ef.Zeigen()
DIM i AS INTEGER
FOR i = 0 TO GUI_TABLE_ROW_COUNT(ef.marktTabelle) - 1
    PRINT "  "; GUI_TABLE_GET_CELL(ef.marktTabelle, i, 0); " "; GUI_TABLE_GET_CELL(ef.marktTabelle, i, 1); " | "; GUI_TABLE_GET_CELL(ef.marktTabelle, i, 2); " | "; GUI_TABLE_GET_CELL(ef.marktTabelle, i, 3); " | ["; GUI_TABLE_GET_CELL(ef.marktTabelle, i, 5); "]"
NEXT
PRINT "standard im fenster "; GUI_TEXT(ef.marktStandard)
GUI_SET_TEXT(ef.marktStandard, "LIDL")
PRINT "vor speichern ["; gewaehlterMarkt$(); "]"
ef.knopfSpeichern_Klick()
PRINT "nach speichern ["; gewaehlterMarkt$(); "]"
--- erwartet
neu [] 10 Obst=1
doppelt [„mein markt“ gibt es schon.] eingebaut [„aldi“ gibt es schon.]
standardplan [] Obst=1;Gemüse=1;Brot=2;Milchprodukte=3;Fleisch=4;Tiefkühl=5;Trockenwaren=6;Getränke=7;Sonstiges=8
fenster 9 | Obst=1 … Sonstiges=8
gespeichert TRUE | Brot=2;Milchprodukte=3;Fleisch=4;Kaffee=4;Tiefkühl=5;Trockenwaren=6;Getränke=7;Sonstiges=8;Gemüse=50
aldi eigen TRUE Brot=1;Obst=2
aldi zurueck FALSE 6
ecke weg [] -1
rewe bleibt [REWE]
wirr Obst Getränke
  🏪 ALDI | eingebaut | 6 | []
  🏪 EDEKA | eingebaut, angepasst | 1 | [↺]
  🏪 KAUFLAND | eingebaut | 11 | []
  🏪 LIDL | eingebaut | 8 | []
  ⭐ Mein Markt | eigener | 10 | [🗑]
  🏪 NETTO | eingebaut | 7 | []
  🏪 PENNY | eingebaut | 7 | []
  🏪 REWE | eingebaut | 10 | []
standard im fenster REWE
vor speichern [REWE]
nach speichern [LIDL]
