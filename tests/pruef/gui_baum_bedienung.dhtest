=== f2 benennt einen knoten um, enter uebernimmt
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 280, 200)
DIM r AS INTEGER : r = GUI_TREE_ADD(t, -1, "Obst")
DIM a AS INTEGER : a = GUI_TREE_ADD(t, r, "Apfel")
GUI_TREE_EXPAND(t, r, TRUE)
GUI_TREE_SET(t, "bearbeitbar", 1)
GUI_TREE_SET_SELECTED(t, a)
GUI_FOCUS(t)
CLIPBOARD_SET("Quitte")
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 6 THEN PRINT "bearbeitet gerade "; GUI_TREE_EDITING(t)
    IF GUI_TREE_EDITED(t) >= 0 THEN PRINT "umbenannt "; GUI_TREE_EDITED(t); " "; GUI_TREE_LABEL(t, a)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "danach "; GUI_TREE_EDITING(t)
