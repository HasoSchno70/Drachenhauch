=== verbotene familie im seltenen zweig steigt jedes mal aus
DIM vergleiche AS INTEGER
FUNCTION absteigend(a AS INTEGER, b AS INTEGER) AS INTEGER
    vergleiche = vergleiche + 1
    RETURN b - a
END FUNCTION
DIM f[4] AS INTEGER
DIM i AS INTEGER
DIM s AS STRING
DIM cmp AS FUNCREF
cmp = absteigend
f[0] = 3 : f[1] = 9 : f[2] = 1 : f[3] = 5
FOR i = 1 TO 12
    s = s + "."
    IF i MOD 4 = 0 THEN
        SORT(f, cmp)
        s = s + STR$(f[0]) + "/" + STR$(vergleiche)
    END IF
NEXT
PRINT s
--- umgebung
DHRT_JIT=aus
--- erwartet
....9/5....9/8....9/11

=== verbotene familie im seltenen zweig steigt jedes mal aus (maschinencode)
DIM vergleiche AS INTEGER
FUNCTION absteigend(a AS INTEGER, b AS INTEGER) AS INTEGER
    vergleiche = vergleiche + 1
    RETURN b - a
END FUNCTION
DIM f[4] AS INTEGER
DIM i AS INTEGER
DIM s AS STRING
DIM cmp AS FUNCREF
cmp = absteigend
f[0] = 3 : f[1] = 9 : f[2] = 1 : f[3] = 5
FOR i = 1 TO 12
    s = s + "."
    IF i MOD 4 = 0 THEN
        SORT(f, cmp)
        s = s + STR$(f[0]) + "/" + STR$(vergleiche)
    END IF
NEXT
PRINT s
