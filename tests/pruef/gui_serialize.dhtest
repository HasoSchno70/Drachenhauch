checkbox

=== table roundtrip
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("T", 0, 0, 300, 200)
DIM hdr[2] AS STRING
hdr[0]="ID" : hdr[1]="Name"
DIM cells[2, 2] AS STRING
cells[0,0]="1" : cells[0,1]="Anna"
cells[1,0]="2" : cells[1,1]="Bert"
DIM t AS GUI_WIDGET
t = GUI_TABLE(win, 10, 10, 280, 150, hdr, cells)
GUI_TABLE_SET_SELECTED(t, 1)
DIM w2 AS GUI_WINDOW
w2 = GUI_FROM_JSON(GUI_TO_JSON(win))
DIM t2 AS GUI_WIDGET
t2 = GUI_WINDOW_WIDGET(w2, 0)
PRINT GUI_KIND(t2)
PRINT GUI_TABLE_ROW_COUNT(t2)
PRINT GUI_TABLE_SELECTED(t2)
--- erwartet
table
2
1

=== file roundtrip
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("Login", 100, 80, 300, 200)
GUI_WINDOW_CLOSABLE(win, TRUE)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(win, "Anmelden", 20, 120, 120, 30)
DIM c AS GUI_WIDGET
c = GUI_CHECKBOX(win, "Merken", 20, 80)
GUI_SET_CHECKED(c, TRUE)
DIM s AS GUI_WIDGET
s = GUI_SLIDER(win, 20, 160, 200, 0, 100)
GUI_SET_VALUE(s, 42)
GUI_SAVE(win, "layout.json")
DIM w3 AS GUI_WINDOW
w3 = GUI_LOAD("layout.json")
PRINT GUI_WINDOW_WIDGET_COUNT(w3)
PRINT GUI_KIND(GUI_WINDOW_WIDGET(w3, 0))
--- erwartet
3
button

=== tree menu tabs roundtrip
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("T", 0, 0, 300, 200)
DIM tabs[2] AS STRING
tabs[0]="Eins" : tabs[1]="Zwei"
GUI_TABS(win, tabs)
GUI_SET_ACTIVE_TAB(win, 1)
DIM m AS INTEGER
m = GUI_MENU(win, "Datei")
DIM mi AS INTEGER
mi = GUI_MENU_ITEM(m, "Oeffnen")
DIM t AS GUI_WIDGET
t = GUI_TREE(win, 10, 10, 100, 100)
DIM root AS INTEGER
root = GUI_TREE_ADD(t, -1, "Wurzel")
DIM child AS INTEGER
child = GUI_TREE_ADD(t, root, "Kind")
GUI_TREE_SET_SELECTED(t, child)
GUI_SET_TAB(t, 1)
DIM w2 AS GUI_WINDOW
w2 = GUI_FROM_JSON(GUI_TO_JSON(win))
PRINT GUI_ACTIVE_TAB(w2)
DIM t2 AS GUI_WIDGET
t2 = GUI_WINDOW_WIDGET(w2, 0)
PRINT GUI_KIND(t2)
PRINT GUI_TREE_SELECTED(t2)
PRINT GUI_TREE_LABEL(t2, GUI_TREE_SELECTED(t2))
--- erwartet
1
tree
1
Kind

