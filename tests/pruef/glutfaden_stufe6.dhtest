=== xsd: fremde und kaputte dateien
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = ["A", "B", "C", "D"]
DIM fa AS STRING : fa = xhFarbe$(0, "310", "Black", &H101010, FALSE, "")
fa = fa + xhFarbe$(1, "9403", "Schwarz " + CHR$(&HD7) + CHR$(&HE5), &H202020, TRUE, "")
fa = fa + xhFarbe$(252, "11", "", &H884444, FALSE, "0:310:1;0:321:2")
DIM sy AS ARRAY OF INTEGER : sy = [ASC("S"), &HFFFF, ASC("S")]
' zeilenweise, 4 x 3: voll Farbe 0 | Lauf 2 x Blend | leer | Teilstich-Satz 0 |
' Satz 1 | Lauf 4 leer | Perle (Farbe 1) | Farbe 9
DIM wo AS ARRAY OF INTEGER : wo = [&H00000000, &H40020000, &H00020000, &H0F000000, &H80000000, &H80010000, &H40040000, &H0F000000, &H00010000, &H00090000]
DIM st AS STRING : st = xhStiche$(wo, [&H12345678, &H0BADCAFE, &H31415926, &H27182818])
' Satz 0: halber Stich oben (Farbe 0) + Viertel oben rechts (Farbe 2); Satz 1: Petite unten rechts (Farbe 0)
DIM kl AS STRING : kl = "11000000000002000000" + "00080000000000000000"
' Knoten, Rueckstich, Spannstich, Kurve, Sonderstich, Perle, Rueckstich mit Farbe 9
DIM jo AS STRING : jo = ph16$(1) + "0000" + ph16$(3) + ph16$(1) + "00000000" + "00" + "00"
jo = jo + ph16$(2) + "0000" + ph16$(0) + ph16$(0) + ph16$(8) + ph16$(6) + "02" + "00"
jo = jo + ph16$(5) + "0000" + ph16$(2) + ph16$(2) + ph16$(4) + ph16$(2) + "00" + "00"
jo = jo + ph16$(3) + "000000" + ph16$(2) + "0100020003000400"
jo = jo + ph16$(4) + phNull$(23)
jo = jo + ph16$(6) + "0000" + ph16$(7) + ph16$(5) + "01" + "00" + ph16$(90)
jo = jo + ph16$(2) + "0000" + ph16$(0) + ph16$(0) + ph16$(2) + ph16$(0) + "09" + "00"

SUB versuch(name AS STRING, b AS BUFFER)
    WRITEALL_BYTES("x.xsd", b)
    TRY
        DIM imp AS kern.XsdImport : imp = kern.xsdLaden("x.xsd", pal, sym)
        PRINT name; ": gelesen, "; LEN(imp.muster.rueckstiche); " rueckstiche"
    CATCH e
        PRINT name; ": "; e
    END TRY
END SUB
DIM gut AS BUFFER : gut = xhDatei(4, 3, 18, "T", "", "", 3, fa, sy, st, kl, 7, jo)
versuch("gut", gut)
versuch("kennung", BUFFER_FROM_HEX("0000" + phNull$(100)))
versuch("leer", BUFFER_FROM_STRING(""))
versuch("abgeschnitten", BUFFER_SLICE(gut, 0, BUFFER_LEN(gut) - 30))
versuch("falscher schluessel", xhDatei(4, 3, 18, "T", "", "", 3, fa, sy, REPLACE$(st, "78563412", "79563412"), kl, 7, jo))
versuch("satz fehlt", xhDatei(4, 3, 18, "T", "", "", 3, fa, sy, st, LEFT$(kl, 20), 7, LEFT$(jo, 0)))
versuch("joint unbekannt", xhDatei(4, 3, 18, "T", "", "", 3, fa, sy, st, kl, 1, ph16$(9) + phNull$(20)))
versuch("zu gross", xhDatei(2001, 1, 18, "T", "", "", 3, fa, sy, st, kl, 7, jo))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_pat.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_xsd.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- erwartet
gut: gelesen, 2 rueckstiche
kennung: XSD: keine Pattern-Maker-Datei (die Kennung 0x0510 fehlt)
leer: XSD: keine Pattern-Maker-Datei
abgeschnitten: XSD: Datei endet vorzeitig (bei Byte 49678)
falscher schluessel: XSD: zu viele Stiche (mehr als 12 Zellen)
satz fehlt: XSD: Teilstich-Satz 1 fehlt (es gibt 1)
joint unbekannt: XSD: unbekannte Joint-Art 9 bei Byte 49619
zu gross: XSD: Muster zu groß: 2001x1 (höchstens 2000)

=== blend: farbe und name wie pysticky
IMPORT "helfer.dh"
DIM a AS kern.Garn : a = kern.neuesGarn("Black", &H0C0C0C, "DMC", "310")
DIM b AS kern.Garn : b = kern.neuesGarn("Red", &HC72B3B, "DMC", "321")
DIM c AS kern.Garn : c = kern.neuesGarn("Gold", &HFFD700, "Anchor", "306")
DIM g AS kern.Garn : g = kern.garnBlend([a, b], [1, 1])
PRINT g.name; " | "; g.hersteller; " | "; g.nummer; " | "; kern.farbeAlsHex$(g.farbe); " | "; g.istBlend()
g = kern.garnBlend([a, b, c], [1, 2, 1])
PRINT g.name; " | "; g.hersteller; " | "; g.nummer; " | "; kern.farbeAlsHex$(g.farbe)
PRINT kern.farbeAlsHex$(kern.labFarbe(50.0, 20.0, -30.0)); " "; kern.pyRunden(2.5); " "; kern.pyRunden(3.5); " "; kern.pyRunden(-0.5)
TRY
    g = kern.garnBlend([a], [1])
CATCH e
    PRINT e
END TRY
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_pat.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_xsd.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- erwartet
DMC 310 / DMC 321 (1+1) | DMC | 310+321 | #652224 | TRUE
DMC 310 / DMC 321 / Anchor 306 (1+2+1) | Blend | 310+321+306 | #A4542D
#7F6DAA 2 4 0
Blend braucht mindestens 2 Garne

=== oberflaeche: pat und xsd oeffnen, diamond hin und zurueck
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = ["A", "B", "C", "D"]
DIM fa AS STRING : fa = phFarbe$("DMC", "310", "black", &H000000, ASC("X"))
fa = fa + phFarbe$("Foo", "9999", "Testgarn", &H0C2238, &H8A)
fa = fa + phFarbe$("DMC", "5200", "snow white", &HE6E6E6, ASC("X"))
' spaltenweise, 4 x 3: (0,0) voll Farbe 0 | 3 leer ueber die Spaltengrenze |
' (1,1) Viertel oben rechts + Dreiviertel unten links | (1,2) Viertel unten
' rechts | (2,0..2) voll Farbe 2 | (3,0) unbekannte Art | (3,1) Farbe 7 | (3,2) leer
DIM gi AS STRING : gi = phLauf$(1, 1, phStich$(0, 0, 5, 0, 1)) + phLeer$(3)
gi = gi + phLauf$(1, 2, phStich$(1, 1, 3, 1, 32) + phStich$(1, 1, 5, 2, 33))
gi = gi + phLauf$(1, 1, phStich$(1, 2, 9, 0, 34))
gi = gi + phLauf$(3, 1, phStich$(2, 0, 5, 2, 1))
gi = gi + phLauf$(1, 1, phStich$(3, 0, 5, 0, 7))
gi = gi + phLauf$(1, 1, phStich$(3, 1, 5, 7, 1)) + phLeer$(1)
DIM ru AS STRING : ru = phRueck$(0, 0, 1, 4, 3, 1, 0) + phRueck$(1, 1, 5, 2, 1, 6, 1) + phRueck$(2, 0, 3, 1, 2, 7, 2) + phRueck$(0, 0, 0, 1, 1, 1, 0)
DIM xf AS STRING : xf = xhFarbe$(0, "310", "Black", &H101010, FALSE, "")
xf = xf + xhFarbe$(1, "9403", "Schwarz " + CHR$(&HD7) + CHR$(&HE5), &H202020, TRUE, "")
xf = xf + xhFarbe$(252, "11", "", &H884444, FALSE, "0:310:1;0:321:2")
DIM sy AS ARRAY OF INTEGER : sy = [ASC("S"), &HFFFF, ASC("S")]
' zeilenweise, 4 x 3: voll Farbe 0 | Lauf 2 x Blend | leer | Teilstich-Satz 0 |
' Satz 1 | Lauf 4 leer | Perle (Farbe 1) | Farbe 9
DIM wo AS ARRAY OF INTEGER : wo = [&H00000000, &H40020000, &H00020000, &H0F000000, &H80000000, &H80010000, &H40040000, &H0F000000, &H00010000, &H00090000]
DIM st AS STRING : st = xhStiche$(wo, [&H12345678, &H0BADCAFE, &H31415926, &H27182818])
' Satz 0: halber Stich oben (Farbe 0) + Viertel oben rechts (Farbe 2); Satz 1: Petite unten rechts (Farbe 0)
DIM kl AS STRING : kl = "11000000000002000000" + "00080000000000000000"
' Knoten, Rueckstich, Spannstich, Kurve, Sonderstich, Perle, Rueckstich mit Farbe 9
DIM jo AS STRING : jo = ph16$(1) + "0000" + ph16$(3) + ph16$(1) + "00000000" + "00" + "00"
jo = jo + ph16$(2) + "0000" + ph16$(0) + ph16$(0) + ph16$(8) + ph16$(6) + "02" + "00"
jo = jo + ph16$(5) + "0000" + ph16$(2) + ph16$(2) + ph16$(4) + ph16$(2) + "00" + "00"
jo = jo + ph16$(3) + "000000" + ph16$(2) + "0100020003000400"
jo = jo + ph16$(4) + phNull$(23)
jo = jo + ph16$(6) + "0000" + ph16$(7) + ph16$(5) + "01" + "00" + ph16$(90)
jo = jo + ph16$(2) + "0000" + ph16$(0) + ph16$(0) + ph16$(2) + ph16$(0) + "09" + "00"

' --probe-stufe6: Glutfaden oeffnet die .pat (Startargument) und die .xsd
' daneben, dann Strg+D zweimal. Dazu die Fotos.
WRITEALL_BYTES("probe.pat", phDatei("8", 4, 3, 16, "", "Probe", "Hans", 3, fa, gi, 3, ru, phNull$(14)))
WRITEALL_BYTES("probe.xsd", xhDatei(4, 3, 18, "Probe XSD", "Hans", "", 3, xf, sy, st, kl, 7, jo))
dlStarten(["run", BEISPIEL, "--", "--probe-stufe6", "--foto", "d", "probe.pat"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    PRINT "fotos: "; FILEEXISTS("d_aus_pat.png"); " "; FILEEXISTS("d_aus_xsd.png"); " "; FILEEXISTS("d_diamond.png")
END IF
