=== ein gesperrter eintrag hat kein kuerzel
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM a AS INTEGER : a = GUI_MENU_ITEM(m, "Rueckgaengig", "Strg+Z")
GUI_MENU_ENABLE(a, FALSE)
DIM f AS INTEGER
FOR f = 1 TO 18
    GUI_UPDATE()
    IF GUI_CLICKED(a) THEN PRINT "zurueck"
    IF f = 8 THEN GUI_MENU_ENABLE(a, TRUE)
    GUI_DRAW()
    FLIP()
NEXT
