' Die IDE in Drachenhauch (ide/ide.dh), Staende 6 bis 12 -- ohne Python
' geprueft. Bis Stufe 35 standen diese Faelle in tests/test_ide.py; aus diesen
' Staenden bleiben dort nur die, die ein git-Repository brauchen, im Bild
' Farbbaender zaehlen oder zwei Laeufe hintereinander machen.
'
' Aufbau wie tests/pruef/werkzeug_ide.dhtest: die IDE als Kopie in _programm/,
' Aufnahme und Zwischenablage ueber einen Einschub hinter SETFPS(60), gelesen
' mit `--- nachher`. Eine Voreinstellung (regex, autosichern, geruest) kommt
' als Beilage _programm/ide.json. Mausklicks treffen feste Lagen: Projektbaum
' ab y = 128 je 22 Punkte, Werkzeugleiste bei y = 74.
' In der Aufnahme: 7 Mauslage, 6 Taste runter, 5 hoch, 2 Taste runter, 1 hoch.
--- seriell

--- langsam
=== neue zeile uebernimmt die einrueckung und rueckt aus
' Enter hinter `SUB a()` rueckt die neue Zeile ein; `END` rueckt sich wieder
' heraus. Ohne das Geruest aus Stand 13 -- sonst stuende noch `END SUB` dahinter.
AUTOMATION_PLAY("ev.txt")
CLIPBOARD_SET("END")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=180
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
SUB a()
--- datei _programm/ide.json
{"geruest": false}
--- datei _programm/ev.txt
c 12
e 20 2 269 0 0 0
e 22 1 269 0 0 0
e 40 2 257 0 0 0
e 42 1 257 0 0 0
e 70 2 341 0 0 0
e 70 2 86 0 0 0
e 72 1 86 0 0 0
e 72 1 341 0 0 0
e 110 2 341 0 0 0
e 110 2 83 0 0 0
e 112 1 83 0 0 0
e 112 1 341 0 0 0

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(p AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION alleEnden(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            n = n + 1
            IF RIGHT$(L[i], LEN(e)) <> e THEN RETURN FALSE
        END IF
    NEXT
    RETURN n > 0
END FUNCTION
FUNCTION inhalt$(datei AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(z) - 1
        r = r + z[i] + CHR$(10)
    NEXT
    RETURN r
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
zeige("spiel.dh")
--- erwartet
|SUB a()|
|END|

=== vervollstaendigung geht beim tippen von selbst auf
' Drei Zeichen getippt, und die Liste steht, ohne dass der Fokus das Code-Feld
' verlaesst. Strg+Leer holt sie herein, Enter uebernimmt.
AUTOMATION_PLAY("ev.txt")
CLIPBOARD_SET("SCR")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=220
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh

--- datei _programm/ev.txt
c 14
e 30 2 341 0 0 0
e 30 2 86 0 0 0
e 32 1 86 0 0 0
e 32 1 341 0 0 0
e 80 2 341 0 0 0
e 80 2 32 0 0 0
e 82 1 32 0 0 0
e 82 1 341 0 0 0
e 120 2 257 0 0 0
e 122 1 257 0 0 0
e 150 2 341 0 0 0
e 150 2 83 0 0 0
e 152 1 83 0 0 0
e 152 1 341 0 0 0

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(p AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION alleEnden(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            n = n + 1
            IF RIGHT$(L[i], LEN(e)) <> e THEN RETURN FALSE
        END IF
    NEXT
    RETURN n > 0
END FUNCTION
FUNCTION inhalt$(datei AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(z) - 1
        r = r + z[i] + CHR$(10)
    NEXT
    RETURN r
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
PRINT "vervollstaendigt " ; erste$("vervollstaendigt SCREEN") <> ""
PRINT "datei beginnt mit SCREEN " ; LEFT$(inhalt$("spiel.dh"), 6) = "SCREEN"
--- erwartet
vervollstaendigt TRUE
datei beginnt mit SCREEN TRUE

