' Kuehlschrank-App im Drachenhauch Studio, Stufe 5: die Statistik
' (examples/studio/kuehlschrank: StatistikSeite mit drei Studio-Diagrammen,
' Klasse Statistikdaten, Modul Barcodecache). Proben wie in den Stufen davor:
' F5 im Studio, dann main.dh mit einer Probe statt der Bildschleife; Heute
' ist fest.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== zahlen wie get_statistics, orte ohne bereich, hinweise
' Frisch = alles ausser bald und abgelaufen (auch ohne Datum). Kategorie ohne
' Namen (NULL oder leer) ist "Sonstige", einmal; "Kuehlschrank - Tuer" zaehlt
' zu "Kuehlschrank". Je Ort, wie viele abgelaufen sind oder bald ablaufen --
' Eintraege, nicht Mengen (die Python-App zaehlte 500 g als 500).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "DELETE FROM inventory")
DB_EXEC(db, "DELETE FROM products")
DB_EXEC(db, "INSERT INTO products (name, category) VALUES ('Milch', 'Milchprodukte'), ('Käse', 'Milchprodukte'), ('Äpfel', 'Obst'), ('Brot', 'Backwaren'), ('Hack', 'Fleisch'), ('Joghurt', 'Milchprodukte'), ('Nudeln', NULL), ('Reis', '')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location) VALUES (1, 1, 'Liter', '2026-11-10', 'Kühlschrank - Tür'), (2, 200, 'g', '2026-11-30', 'Kühlschrank'), (3, 6, 'Stück', '2026-11-05', 'Vorratsraum'), (4, 1, 'Stück', '2026-11-09', 'Vorratsraum'), (5, 500, 'g', '2026-12-20', 'Gefrierschrank'), (6, 4, 'Stück', '2026-11-20', 'Kühlschrank'), (7, 500, 'g', NULL, 'Vorratsraum'), (8, 1, 'kg', NULL, NULL)")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
DIM s AS Statistikdaten : s = f.statistik.s
PRINT "gesamt "; s.gesamt; " produkte "; s.produkte; " bald "; s.bald; " abgelaufen "; s.abgelaufen; " frisch "; s.frisch; " schwelle "; s.schwelle
DIM i AS INTEGER
DIM t AS ARRAY OF STRING : t = []
FOR i = 0 TO LEN(s.katNamen) - 1
    ARRAY_PUSH(t, s.katNamen[i] + ":" + STR$(s.katZahlen[i]))
NEXT
PRINT "kategorien "; JOIN$(t, " ")
t = []
FOR i = 0 TO LEN(s.ortNamen) - 1
    ARRAY_PUSH(t, s.ortNamen[i] + ":" + STR$(s.ortZahlen[i]) + "/" + STR$(s.ortBald[i]))
NEXT
PRINT "orte "; JOIN$(t, " ")
DIM h AS STRING
FOR EACH h IN f.statistik.hinweise
    PRINT "  "; h
NEXT
' Die Diagramme: Werte in Reihe 0.
SUB werte(name AS STRING, d AS StudioDiagramm)
    DIM w AS ARRAY OF STRING : w = []
    DIM k AS INTEGER
    FOR k = 0 TO d.Anzahl() - 1
        ARRAY_PUSH(w, STR$(INT(CHART_GET(d.Diagramm, 0, k))))
    NEXT
    PRINT name; " "; d.Art; " "; JOIN$(w, " ")
END SUB
werte("kategorien", f.statistik.kategorien)
werte("orte", f.statistik.orte)
werte("status", f.statistik.status)
' Voll und leer: ab 21 Eintraegen "Gut gefuellt", unter 5 "Einkaufen gehen?".
FOR i = 1 TO 14
    DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location) VALUES (7, 1, 'g', '2027-01-01', 'Vorratsraum')")
NEXT
f.auffrischen()
PRINT "voll "; f.statistik.s.gesamt; " | "; JOIN$(f.statistik.hinweise, " / ")
DB_EXEC(db, "DELETE FROM inventory WHERE id > 3")
f.auffrischen()
PRINT "knapp "; f.statistik.s.gesamt; " | "; JOIN$(f.statistik.hinweise, " / ")
DB_EXEC(db, "DELETE FROM inventory")
f.auffrischen()
PRINT "leer "; f.statistik.s.gesamt; " | "; JOIN$(f.statistik.hinweise, " / "); " | "; f.statistik.kategorien.Anzahl(); " "; f.statistik.orte.Anzahl()
--- erwartet
geprueft TRUE
gesamt 8 produkte 8 bald 2 abgelaufen 1 frisch 5 schwelle 3
kategorien Milchprodukte:3 Sonstige:2 Backwaren:1 Fleisch:1 Obst:1
orte Kühlschrank:3/1 Vorratsraum:3/2 Gefrierschrank:1/0
  gefahr|⚠|Abgelaufene Produkte|Du hast 1 abgelaufene Artikel. Überprüfe diese zeitnah!
  warnung|⏰|Bald ablaufend|2 Artikel laufen in den nächsten 3 Tagen ab.
  lila|🏆|Top Kategorie|'Milchprodukte' ist deine meistgenutzte Kategorie mit 3 Artikeln.
kategorien kuchen 3 2 1 1 1
orte kuchen 3 3 1
status balken 5 2 1
voll 22 | gefahr|⚠|Abgelaufene Produkte|Du hast 1 abgelaufene Artikel. Überprüfe diese zeitnah! / warnung|⏰|Bald ablaufend|2 Artikel laufen in den nächsten 3 Tagen ab. / erfolg|📦|Gut gefüllt!|Dein Kühlschrank ist mit 22 Artikeln gut bestückt. / lila|🏆|Top Kategorie|'Sonstige' ist deine meistgenutzte Kategorie mit 16 Artikeln.
knapp 3 | gefahr|⚠|Abgelaufene Produkte|Du hast 1 abgelaufene Artikel. Überprüfe diese zeitnah! / warnung|⏰|Bald ablaufend|1 Artikel laufen in den nächsten 3 Tagen ab. / info|🛒|Einkaufen gehen?|Nur noch 3 Artikel im Bestand. Zeit für einen Einkauf! / lila|🏆|Top Kategorie|'Milchprodukte' ist deine meistgenutzte Kategorie mit 2 Artikeln.
leer 0 | info|🛒|Einkaufen gehen?|Nur noch 0 Artikel im Bestand. Zeit für einen Einkauf! | 0 0
code 0

=== der barcode-cache: zaehlen, nach 30 tagen nicht mehr, leeren mit frage
' barcode_cache.json neben der Datenbank (DH_STUDIO_DATEN). Ein Eintrag von
' vor 30 Tagen gilt noch, einer davor nicht mehr. Leeren fragt: Esc laesst
' ihn stehen, Enter (Ja) leert ihn, dann Enter fuer die Meldung.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
SETENV("DH_STUDIO_DATEN", p)
WRITEALL(p + "/barcode_cache.json", "{" + _
    CHR$(34) + "4001" + CHR$(34) + ": {" + CHR$(34) + "name" + CHR$(34) + ": " + CHR$(34) + "Milch" + CHR$(34) + ", " + CHR$(34) + "cached_at" + CHR$(34) + ": " + CHR$(34) + "2026-11-01T10:00:00" + CHR$(34) + "}, " + _
    CHR$(34) + "4002" + CHR$(34) + ": {" + CHR$(34) + "not_found" + CHR$(34) + ": true, " + CHR$(34) + "cached_at" + CHR$(34) + ": " + CHR$(34) + "2026-11-07T09:00:00.5" + CHR$(34) + "}, " + _
    CHR$(34) + "4003" + CHR$(34) + ": {" + CHR$(34) + "not_found" + CHR$(34) + ": false, " + CHR$(34) + "cached_at" + CHR$(34) + ": " + CHR$(34) + "2026-10-09T08:00:00" + CHR$(34) + "}, " + _
    CHR$(34) + "4004" + CHR$(34) + ": {" + CHR$(34) + "not_found" + CHR$(34) + ": true, " + CHR$(34) + "cached_at" + CHR$(34) + ": " + CHR$(34) + "2026-10-07T08:00:00" + CHR$(34) + "}}")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slTaste(256)
slWarten(10)
slTaste(257)
slWarten(10)
slTaste(257)
slAufnahmeSchreiben(p + "/_studio/tasten.txt")
PRINT "code "; kProbe(p, "probe.dh", "tasten.txt", 80)
PRINT "datei "; READALL(p + "/barcode_cache.json")
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM f AS Hauptfenster : f = studioStartFenster
DIM st AS StatistikSeite : st = f.statistik
SUB karten(wann AS STRING)
    PRINT wann; " "; st.cacheZahl; " "; st.cacheTreffer; " "; st.cacheOhne; " | karten "; GUI_CARD_TEXT$(st.cacheEintraege); " "; GUI_CARD_TEXT$(st.cacheGefunden); " "; GUI_CARD_TEXT$(st.cacheNicht)
END SUB
karten("vorher")
st.knopfCacheLeeren_Klick()
karten("nein")
st.knopfCacheLeeren_Klick()
karten("ja")
--- erwartet
vorher 3 2 1 | karten 3 2 1
nein 3 2 1 | karten 3 2 1
ja 0 0 0 | karten 0 0 0
code 0
datei {}

=== thema hell und dunkel, die diagramme ziehen mit
' Wie toggle_theme: die ganze Oberflaeche wechselt, der Knopf zeigt Sonne
' oder Mond, die Diagramme nehmen das Thema im naechsten Bild.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 30)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM f AS Hauptfenster : f = studioStartFenster
DIM st AS StatistikSeite : st = f.statistik
GUI_TABCONTROL_SET_PAGE(f.reiter, 3)
GUI_TABCONTROL_SET_PAGE(st.unterreiter, 1)
SUB stand(wann AS STRING)
    DIM n AS INTEGER
    WHILE n < 3 AND studioBild()
        n = n + 1
    WEND
    DIM bg AS INTEGER : bg = GUI_THEME_GET("win_bg")
    PRINT wann; ": hell "; ((bg SHR 16) BAND 255) + ((bg SHR 8) BAND 255) + (bg BAND 255) > 382; " | knopf "; GUI_TEXT(st.knopfThema); " | diagramme "; st.kategorien.studioHell; st.orte.studioHell; st.status.studioHell
END SUB
stand("anfang")
st.knopfThema_Klick()
stand("einmal")
st.knopfThema_Klick()
stand("zweimal")
--- erwartet
anfang: hell FALSE | knopf 🌙 | diagramme 000
einmal: hell TRUE | knopf ☀ | diagramme 111
zweimal: hell FALSE | knopf 🌙 | diagramme 000
code 0

=== echt: reiter statistik, unterseite charts, aktualisieren
' Ein Klick auf "Statistik", dann auf "Charts": die Diagramme sind zu sehen,
' die Uebersicht nicht mehr (das Reiterwerk im Control schaltet seine
' Seiten). Ein neuer Eintrag zaehlt nach "Aktualisieren" mit.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 10)
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
FUNCTION z(i AS INTEGER) AS INTEGER
    RETURN INT(VAL(w[i]))
END FUNCTION
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slKlick(z(0), z(1))
slWarten(10)
slKlick(z(2), z(3))
slWarten(10)
slKlick(z(4), z(5))
slWarten(10)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 20)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei daten.dh
DB_EXEC(db, "DELETE FROM inventory")
DB_EXEC(db, "DELETE FROM products")
DB_EXEC(db, "INSERT INTO products (name, category) VALUES ('Milch', 'Milchprodukte')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location) VALUES (1, 1, 'Liter', '2026-11-10', 'Kühlschrank')")
DIM f AS Hauptfenster : f = studioStartFenster
DIM st AS StatistikSeite : st = f.statistik
f.geaendert()
--- datei mess.dh
IMPORT "../../daten.dh"
GUI_TABCONTROL_SET_PAGE(f.reiter, 3)
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
DIM rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER
(rx, ry, rw, rh) = GUI_TABCONTROL_ITEM_RECT(f.reiter, 3)
DIM ux AS INTEGER, uy AS INTEGER, uw AS INTEGER, uh AS INTEGER
(ux, uy, uw, uh) = GUI_TABCONTROL_ITEM_RECT(st.unterreiter, 1)
WRITEALL("lage.txt", STR$(rx + rw \ 2) + " " + STR$(ry + rh \ 2) + " " + STR$(ux + uw \ 2) + " " + STR$(uy + uh \ 2) + " " + _
    STR$(GUI_GET_X(st.knopfAuffrischen) + GUI_GET_W(st.knopfAuffrischen) \ 2) + " " + STR$(GUI_GET_Y(st.knopfAuffrischen) + 26 + GUI_GET_H(st.knopfAuffrischen) \ 2))
--- datei klick.dh
IMPORT "../../daten.dh"
FUNCTION stand$() AS STRING
    RETURN "Seite " + STR$(GUI_TABCONTROL_PAGE(f.reiter)) + "/" + STR$(GUI_TABCONTROL_PAGE(st.unterreiter)) + " uebersicht " + STR$(GUI_SHOWN(st.uebersicht)) + " kuchen " + STR$(GUI_SHOWN(st.kategorien.Flaeche)) + " cache " + STR$(GUI_SHOWN(st.knopfCacheLeeren)) + " gesamt " + STR$(st.s.gesamt)
END FUNCTION
DIM folge AS ARRAY OF STRING : folge = []
DIM war AS STRING : war = ""
DIM bild AS INTEGER
WHILE studioBild()
    bild = bild + 1
    ' Gleich zu Anfang ein Eintrag mehr -- er zaehlt erst nach Aktualisieren.
    IF bild = 1 THEN DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, storage_location) VALUES (1, 2, 'Liter', 'Kühlschrank')")
    DIM jetzt AS STRING : jetzt = stand$()
    IF jetzt <> war THEN ARRAY_PUSH(folge, jetzt)
    war = jetzt
WEND
PRINT JOIN$(folge, " -> ")
--- erwartet
Seite 0/0 uebersicht FALSE kuchen FALSE cache FALSE gesamt 1 -> Seite 3/0 uebersicht TRUE kuchen FALSE cache FALSE gesamt 1 -> Seite 3/1 uebersicht FALSE kuchen TRUE cache FALSE gesamt 1 -> Seite 3/1 uebersicht FALSE kuchen TRUE cache FALSE gesamt 2
code 0
