' Die Metrik `verlauf_hoehe`: ueber dieser Hoehe klingt der Verlauf aus.
' Ein Knopf von 40 Pixeln darf sich woelben, eine Flaeche von 400 bekommt
' mit derselben Staerke einen Schlagschatten ueber die halbe Hoehe.
'
' Geprueft am BILD: zwei Panels nebeneinander, 40 und 400 hoch. Ohne die
' Metrik hat die hohe Flaeche oben DIESELBE Farbe wie die kleine, mit ihr
' eine andere -- das ist der ganze Unterschied.
' Format: docs/werkzeuge.md.

=== ohne die metrik ist der verlauf ueberall gleich stark
IMPORT "gui"
SCREEN(500, 500, "T", 1)
GUI_THEME_PRESET("glas_dunkel")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 500)
GUI_WINDOW_CHROME(w, FALSE)
DIM klein AS GUI_WIDGET : klein = GUI_PANEL(w, 20, 20, 120, 40)
DIM gross AS GUI_WIDGET : gross = GUI_PANEL(w, 200, 20, 120, 400)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=3
--- bild
' Die hohe Flaeche zieht ueber ihre ganze Hoehe durch: oben dunkel,
' unten hell, 23 Stufen Abstand.
260 30 #29323F +-2
260 410 #404956 +-2
--- erwartet

=== mit der metrik wird die hohe flaeche matter
IMPORT "gui"
SCREEN(500, 500, "T", 1)
GUI_THEME_PRESET("glas_dunkel")
GUI_METRIC_SET("verlauf_hoehe", 120)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 500)
GUI_WINDOW_CHROME(w, FALSE)
DIM klein AS GUI_WIDGET : klein = GUI_PANEL(w, 20, 20, 120, 40)
DIM gross AS GUI_WIDGET : gross = GUI_PANEL(w, 200, 20, 120, 400)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=3
--- bild
' Mit der Metrik bleiben davon 6 Stufen -- dieselben zwei Punkte.
260 30 #343D4A +-2
260 410 #3A4350 +-2
--- erwartet

=== die kleine flaeche bleibt, wie sie war
' Die Gegenprobe zur Gegenprobe: an der KLEINEN aendert die Metrik nichts.
IMPORT "gui"
SCREEN(500, 500, "T", 1)
GUI_THEME_PRESET("glas_dunkel")
GUI_METRIC_SET("verlauf_hoehe", 120)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 500)
GUI_WINDOW_CHROME(w, FALSE)
DIM klein AS GUI_WIDGET : klein = GUI_PANEL(w, 20, 20, 120, 40)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=3
--- bild
80 24 <> 80 56
--- erwartet

=== der schluessel steht im verzeichnis
IMPORT "gui"
SCREEN(200, 200, "T", 1)
GUI_METRIC_SET("verlauf_hoehe", 90)
PRINT GUI_METRIC_GET("verlauf_hoehe")
--- umgebung
DHRT_FRAMES=2
--- erwartet
90

=== die fase einer hohen flaeche ist leiser
' Die Linie unter dem oberen Rand (Fase; ein Panel ist versenkt, dort ist
' sie ein Schatten) in voller Staerke ueber einer ganzen Leiste ist die
' Kante aus Windows 95. Mit der Metrik wird sie auf der hohen Flaeche
' leiser, auf der kleinen bleibt sie. Gemessen wird, wie viel dunkler die
' Linie ist als die Zeile darunter.
IMPORT "gui"
SCREEN(500, 500, "T", 1)
GUI_THEME_PRESET("glas_dunkel")
GUI_METRIC_SET("verlauf_hoehe", 120)
GUI_METRIC_SET("gloss", 0)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 500)
GUI_WINDOW_CHROME(w, FALSE)
DIM klein AS GUI_WIDGET : klein = GUI_PANEL(w, 20, 20, 120, 40)
DIM gross AS GUI_WIDGET : gross = GUI_PANEL(w, 200, 20, 120, 400)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=3
DHRT_SCREENSHOT={fall}/b.png
--- nachher
DIM b AS IMAGE : b = LOADIMAGE("b.png")
FUNCTION hub(x AS INTEGER) AS INTEGER
    RETURN (GETPIXEL(b, x, 22) BAND 255) - (GETPIXEL(b, x, 21) BAND 255)
END FUNCTION
PRINT "klein deutlich "; hub(80) > 15
PRINT "gross leiser "; hub(260) < hub(80) \ 2
--- erwartet
klein deutlich TRUE
gross leiser TRUE

=== der fokusring um eine hohe flaeche ist leiser
' Um ein Code-Feld von 900 Punkten lag der Ring als zweiter Rahmen um den
' ersten -- unruhig. Mit der Metrik bleibt um die hohe Flaeche ein Fuenftel,
' um die kleine der volle Ring.
IMPORT "gui"
SCREEN(500, 500, "T", 1)
GUI_THEME_PRESET("glas_dunkel")
GUI_METRIC_SET("verlauf_hoehe", 120)
GUI_METRIC_SET("uebergang", 0)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 500)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 200, 20, 200, 400, "")
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 20, 20, 120, 28, "")
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    IF bild = 1 THEN GUI_FOCUS(ta)
    IF bild = 4 THEN SAVESCREENSHOT("gross.png") : GUI_FOCUS(tf)
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=8
DHRT_SCREENSHOT={fall}/klein.png
--- nachher
DIM g AS IMAGE : g = LOADIMAGE("gross.png")
DIM k AS IMAGE : k = LOADIMAGE("klein.png")
' Blau des Rings ueber dem Fenstergrund des Themas (Blau 51).
DIM ringGross AS INTEGER : ringGross = (GETPIXEL(g, 300, 17) BAND 255) - 51
DIM ringKlein AS INTEGER : ringKlein = (GETPIXEL(k, 80, 17) BAND 255) - 51
PRINT "klein deutlich "; ringKlein > 120
PRINT "gross sichtbar "; ringGross > 10
PRINT "gross leiser "; ringGross < ringKlein \ 3
--- erwartet
klein deutlich TRUE
gross sichtbar TRUE
gross leiser TRUE

=== ein kleiner textbereich zeigt den fokus im vollen akzent
' Bis zur Hoehe `verlauf_hoehe` ist der Rand im Fokus der Akzent.
IMPORT "gui"
SCREEN(400, 400, "T", 1)
GUI_METRIC_SET("corner_radius", 0)
GUI_METRIC_SET("verlauf_hoehe", 120)
GUI_THEME_SET("accent", &HFF00FF)
GUI_THEME_SET("widget_border", &H404040)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 40, 40, 300, 80)
GUI_FOCUS(ta)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=30
--- bild
40 80 #FF00FF +-30

=== ein grosser textbereich zeigt den fokus leiser
' Seit 2026.47: um eine grosse Flaeche (ein Code-Feld) mischt sich der
' Akzent mit dem Rand -- hier 35 %: #404040 -> #FF00FF gibt etwa #7F2A7F.
IMPORT "gui"
SCREEN(400, 400, "T", 1)
GUI_METRIC_SET("corner_radius", 0)
GUI_METRIC_SET("verlauf_hoehe", 120)
GUI_THEME_SET("accent", &HFF00FF)
GUI_THEME_SET("widget_border", &H404040)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 40, 40, 300, 300)
GUI_FOCUS(ta)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=30
--- bild
40 190 #7F2A7F +-30
40 190 nicht #FF00FF +-60

=== eine eigene akzentfarbe gilt auch um einen grossen textbereich
' Wer dem Widget selbst einen Akzent gibt, bekommt ihn ungemischt.
IMPORT "gui"
SCREEN(400, 400, "T", 1)
GUI_METRIC_SET("corner_radius", 0)
GUI_METRIC_SET("verlauf_hoehe", 120)
GUI_THEME_SET("accent", &HFF00FF)
GUI_THEME_SET("widget_border", &H404040)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 40, 40, 300, 300)
GUI_SET_COLOR(ta, "accent", &H00FF00)
GUI_FOCUS(ta)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=30
--- bild
40 190 #00FF00 +-30
