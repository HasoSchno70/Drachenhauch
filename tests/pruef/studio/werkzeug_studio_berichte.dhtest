=== f5 erzeugt eine klasse je bericht, pdf mit parametern
' Das Programm sichert Liste mit ab = 2 als PDF (nur die zweite Rechnung)
' und meldet einen fehlenden Parameter als Fehler; der erzeugte Code
' uebersetzt ohne Befund.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
slHin(10, 10)
slWarten(10)
slTaste(294)
slWarten(200)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_LAUF_BILDER", "30")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "ausgabe ")
    IF INSTR(z, "▶") < 0 AND INSTR(z, "■") < 0 AND INSTR(z, "WARNING") < 0 THEN PRINT z
NEXT
DIM s AS ARRAY OF STRING : s = pdfSeiten(p + "/liste.pdf")
DIM alles AS STRING : alles = JOIN$(s, CHR$(10))
PRINT "seiten "; LEN(s); " summe "; INSTR(alles, "2.131,25") >= 0; " ohne r1 "; INSTR(alles, "975,00") < 0; " kunde "; INSTR(alles, "Bert Koch") >= 0
DIM c AS INTEGER : c = PROCESS_START("dhrt", "--check", p + "/_studio/main.dh")
DIM aus AS STRING : aus = ""
DIM leer AS INTEGER : leer = 0
WHILE leer < 5
    DIM t AS STRING : t = PROCESS_READ$(c)
    IF t <> "" THEN
        aus = aus + t
        leer = 0
    ELSEIF NOT PROCESS_RUNNING(c) THEN
        leer = leer + 1
    END IF
    SLEEP(30)
WEND
PRINT "check "; TRIM$(aus)
--- argumente
{sammlung}/../../studio/studio.dh
--- vorher
