' Aus test_gui_form_runner.py uebertragen (2 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== form loads structure
IMPORT "gui"
DIM frm AS GUI_WINDOW
frm = GUI_LOAD("f.dhform")
PRINT GUI_WINDOW_WIDGET_COUNT(frm)
PRINT f"{GUI_WINDOW_GET_X(frm)},{GUI_WINDOW_GET_W(frm)}"
PRINT GUI_KIND(GUI_WINDOW_WIDGET(frm, 1))
PRINT GUI_KIND(GUI_WINDOW_WIDGET(frm, 5))
--- datei f.dhform
{"title": "Einstellungen", "x": 230, "y": 120, "w": 360, "h": 250, "movable": true, "closable": true, "visible": true, "widgets": [{"kind": "label", "x": 20, "y": 40, "w": 70, "h": 16, "text": "Name:"}, {"kind": "textinput", "x": 95, "y": 36, "w": 225, "h": 26, "placeholder": "dein Name"}, {"kind": "checkbox", "x": 20, "y": 78, "w": 16, "h": 16, "text": "Sound an", "checked": true, "on_change": "on_sound"}, {"kind": "slider", "x": 120, "y": 112, "w": 200, "h": 14, "min": 0.0, "max": 100.0, "value": 70.0, "on_change": "on_volume"}, {"kind": "dropdown", "x": 140, "y": 142, "w": 180, "h": 24, "items": ["Einfach", "Mittel", "Schwer"], "sel": 1, "on_change": "on_diff"}, {"kind": "button", "x": 20, "y": 196, "w": 145, "h": 32, "text": "Speichern", "on_click": "on_save"}]}
--- erwartet
6
230,360
textinput
button

=== form restores states
IMPORT "gui"
DIM frm AS GUI_WINDOW
frm = GUI_LOAD("f.dhform")
PRINT GUI_CHECKED(GUI_WINDOW_WIDGET(frm, 2))
PRINT GUI_VALUE(GUI_WINDOW_WIDGET(frm, 3))
PRINT GUI_DROPDOWN_TEXT(GUI_WINDOW_WIDGET(frm, 4))
PRINT GUI_TEXT(GUI_WINDOW_WIDGET(frm, 1))
--- datei f.dhform
{"title": "Einstellungen", "x": 230, "y": 120, "w": 360, "h": 250, "movable": true, "closable": true, "visible": true, "widgets": [{"kind": "label", "x": 20, "y": 40, "w": 70, "h": 16, "text": "Name:"}, {"kind": "textinput", "x": 95, "y": 36, "w": 225, "h": 26, "placeholder": "dein Name"}, {"kind": "checkbox", "x": 20, "y": 78, "w": 16, "h": 16, "text": "Sound an", "checked": true, "on_change": "on_sound"}, {"kind": "slider", "x": 120, "y": 112, "w": 200, "h": 14, "min": 0.0, "max": 100.0, "value": 70.0, "on_change": "on_volume"}, {"kind": "dropdown", "x": 140, "y": 142, "w": 180, "h": 24, "items": ["Einfach", "Mittel", "Schwer"], "sel": 1, "on_change": "on_diff"}, {"kind": "button", "x": 20, "y": 196, "w": 145, "h": 32, "text": "Speichern", "on_click": "on_save"}]}
