' Maus, Tastatur und Werkzeug-Logik. Globaler Namensraum (teilt Zustand mit
' leinwand.dh, verlauf.dh und main.dh).
'
' Jede Aenderung am Dokument ruft VORHER verlaufMerken() (verlauf.dh) auf.

' GDK-Tastenwerte
CONST K_ESC = &HFF1B
CONST K_RETURN = &HFF0D
CONST K_DELETE = &HFFFF
CONST K_BACKSPACE = &HFF08
CONST K_A = &H61
CONST K_E = &H65
CONST K_L = &H6C
CONST K_O = &H6F
CONST K_R = &H72
CONST K_S = &H73
CONST K_W = &H77
CONST K_Y = &H79
CONST K_Z = &H7A
CONST K_Z_GROSS = &H5A              ' Strg+Umschalt+Z liefert das grosse Z
CONST K_PLUS = &H2B
CONST K_GLEICH = &H3D
CONST K_MINUS = &H2D
CONST K_NULL = &H30

FUNCTION evKnopf(ev AS INTEGER) AS INTEGER
    DIM k AS INTEGER
    IF NOT gdk_event_get_button(ev, k) THEN RETURN 0
    RETURN k
END FUNCTION

FUNCTION evZustand(ev AS INTEGER) AS INTEGER
    DIM z AS INTEGER
    IF NOT gdk_event_get_state(ev, z) THEN RETURN 0
    RETURN z
END FUNCTION

' Mausposition aktualisieren (roh + gefangen je nach Werkzeug)
SUB mausSetzen(px AS FLOAT, py AS FLOAT)
    gMausRX = weltX(px)
    gMausRY = weltY(py)
    gMausDrin = TRUE
    IF gWerkzeug = WZ_DRAHT OR gWerkzeug = WZ_LABEL THEN
        DIM f AS kern.Punkt : f = fangPunkt(gMausRX, gMausRY)
        gMausWX = f.x
        gMausWY = f.y
    ELSE
        gMausWX = kern.rastern(ROUND(gMausRX), kern.RASTER)
        gMausWY = kern.rastern(ROUND(gMausRY), kern.RASTER)
    END IF
END SUB

SUB auswahlAufheben()
    gHatGewaehlt = FALSE
    gHatLabel = FALSE
END SUB

SUB werkzeugWaehlen(wz AS INTEGER, ref AS STRING)
    gWerkzeug = wz
    IF ref <> "" THEN gSymbolRef = ref
    IF wz <> WZ_DRAHT THEN
        gDrahtAktiv = FALSE
        gDrahtPunkte = []
    END IF
    werkzeugKnoepfeNachziehen()
    statusAktualisieren()
    neuZeichnen()
END SUB

SUB geaendert()
    netzeVeraltet()
    gGeaendert = TRUE
    titelNachziehen()
    statusAktualisieren()
    neuZeichnen()
END SUB

FUNCTION naechsteReferenz(praefix AS STRING) AS STRING
    IF LEFT$(praefix, 1) = "#" THEN RETURN ""        ' Leistungssymbole ohne Referenz
    DIM groesste AS INTEGER : groesste = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gBlatt.bauteile) - 1
        DIM r AS STRING : r = gBlatt.bauteile[i].referenz
        IF LEN(r) > LEN(praefix) AND LEFT$(r, LEN(praefix)) = praefix THEN
            DIM n AS INTEGER : n = VAL(MID$(r, LEN(praefix)))     ' MID$ zaehlt ab 0
            IF n > groesste THEN groesste = n
        END IF
    NEXT
    RETURN praefix + STR$(groesste + 1)
END FUNCTION

' Gibt es die Referenz schon bei einem ANDEREN Bauteil?
FUNCTION referenzBelegt(ref AS STRING, ausser AS kern.Bauteil) AS BOOLEAN
    IF ref = "" THEN RETURN FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gBlatt.bauteile) - 1
        IF gBlatt.bauteile[i] <> ausser AND gBlatt.bauteile[i].referenz = ref THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

SUB bauteilPlatzieren()
    verlaufMerken()
    DIM l AS kern.Lage : l = NEW kern.Lage(NEW kern.Punkt(gMausWX, gMausWY), gPlatzDreh, FALSE)
    DIM b AS kern.Bauteil : b = kern.neuesBauteil(gSymbolRef, l)
    b.referenz = naechsteReferenz(b.sym.praefix)
    ARRAY_PUSH(gBlatt.bauteile, b)
    auswahlAufheben()
    gGewaehlt = b
    gHatGewaehlt = TRUE
    geaendert()
END SUB

' Den gezeichneten Draht uebernehmen. Doppelte Eckpunkte (der Doppelklick
' setzt den letzten Punkt zweimal) fallen weg; unter zwei Punkten kein Draht.
SUB drahtEndePunkt()
    IF gDrahtAktiv THEN
        DIM w AS kern.Draht : w = NEW kern.Draht()
        DIM i AS INTEGER
        FOR i = 0 TO LEN(gDrahtPunkte) - 1
            DIM p AS kern.Punkt : p = gDrahtPunkte[i]
            IF LEN(w.punkte) = 0 THEN
                ARRAY_PUSH(w.punkte, p)
            ELSEIF NOT kern.punktGleich(w.punkte[LEN(w.punkte) - 1], p) THEN
                ARRAY_PUSH(w.punkte, p)
            END IF
        NEXT
        IF LEN(w.punkte) >= 2 THEN
            verlaufMerken()
            ARRAY_PUSH(gBlatt.draehte, w)
            kern.autoKnoten(gBlatt)
            geaendert()
        END IF
    END IF
    gDrahtAktiv = FALSE
    gDrahtPunkte = []
    neuZeichnen()
END SUB

SUB auswahlLoeschen()
    DIM i AS INTEGER
    IF gHatLabel THEN
        FOR i = 0 TO LEN(gBlatt.labels) - 1
            IF gBlatt.labels[i] = gLabelGewaehlt THEN
                verlaufMerken()
                ARRAY_REMOVE_AT(gBlatt.labels, i)
                auswahlAufheben()
                geaendert()
                RETURN
            END IF
        NEXT
    ELSEIF gHatGewaehlt THEN
        FOR i = 0 TO LEN(gBlatt.bauteile) - 1
            IF gBlatt.bauteile[i] = gGewaehlt THEN
                verlaufMerken()
                ARRAY_REMOVE_AT(gBlatt.bauteile, i)
                auswahlAufheben()
                geaendert()
                RETURN
            END IF
        NEXT
    END IF
END SUB

SUB auswahlDrehen()
    IF gHatGewaehlt THEN
        verlaufMerken()
        gGewaehlt.lage.drehung = (gGewaehlt.lage.drehung + 90) MOD 360
        geaendert()
    ELSEIF NOT gHatLabel THEN
        gPlatzDreh = (gPlatzDreh + 90) MOD 360     ' Vorschau beim Platzieren
        neuZeichnen()
    END IF
END SUB

SUB labelSetzen()
    ' Position VOR dem Dialog festhalten: waehrend er offen ist, koennen
    ' Mausereignisse gMausWX/WY schon verschieben.
    DIM ort AS kern.Punkt : ort = NEW kern.Punkt(gMausWX, gMausWY)
    DIM text AS STRING : text = TRIM$(textAbfrage$("Label setzen", "Netzname:", ""))
    IF text = "" THEN RETURN
    verlaufMerken()
    DIM la AS kern.Label : la = NEW kern.Label(text, ort, kern.LA_LOKAL)
    ARRAY_PUSH(gBlatt.labels, la)
    auswahlAufheben()
    gLabelGewaehlt = la
    gHatLabel = TRUE
    geaendert()
END SUB

' Doppelklick / E / Enter: das Gewaehlte bearbeiten.
SUB auswahlBearbeiten()
    gZieht = FALSE
    IF gHatLabel THEN
        DIM text AS STRING : text = TRIM$(textAbfrage$("Label bearbeiten", "Netzname:", gLabelGewaehlt.text))
        IF text <> "" AND text <> gLabelGewaehlt.text THEN
            verlaufMerken()
            gLabelGewaehlt.text = text
            geaendert()
        END IF
    ELSEIF gHatGewaehlt THEN
        eigenschaftenDialog(gGewaehlt)
    END IF
END SUB

' --- Ereignisse
FUNCTION lwDruck(w AS INTEGER, ev AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM px AS FLOAT, py AS FLOAT
    DIM ok AS BOOLEAN : ok = gdk_event_get_coords(ev, px, py)
    gtk_widget_grab_focus(gFlaeche)
    mausSetzen(px, py)
    DIM knopf AS INTEGER : knopf = evKnopf(ev)
    IF knopf = 2 THEN
        gPan = TRUE
        gPanSX = px
        gPanSY = py
        RETURN TRUE
    END IF
    IF knopf = 3 THEN
        IF gWerkzeug = WZ_DRAHT AND gDrahtAktiv THEN
            drahtEndePunkt()
        ELSEIF gWerkzeug = WZ_BAUTEIL THEN
            auswahlDrehen()
        END IF
        RETURN TRUE
    END IF
    IF knopf <> 1 THEN RETURN TRUE
    DIM doppel AS BOOLEAN : doppel = gdk_event_get_event_type(ev) = GDK_DOPPELKLICK
    SELECT CASE gWerkzeug
        CASE WZ_AUSWAHL
            IF doppel THEN
                ' der erste Klick hat schon gewaehlt
                auswahlBearbeiten()
                RETURN TRUE
            END IF
            auswahlAufheben()
            gZiehGemerkt = FALSE
            DIM li AS INTEGER : li = labelIndexUnter(px, py)
            IF li >= 0 THEN
                gLabelGewaehlt = gBlatt.labels[li]
                gHatLabel = TRUE
                gZieht = TRUE
                gZiehDX = gLabelGewaehlt.anker.x - gMausWX
                gZiehDY = gLabelGewaehlt.anker.y - gMausWY
            ELSE
                DIM idx AS INTEGER : idx = bauteilIndexUnter(gMausRX, gMausRY)
                IF idx >= 0 THEN
                    gGewaehlt = gBlatt.bauteile[idx]
                    gHatGewaehlt = TRUE
                    gZieht = TRUE
                    gZiehDX = gGewaehlt.lage.pos.x - gMausWX
                    gZiehDY = gGewaehlt.lage.pos.y - gMausWY
                END IF
            END IF
            neuZeichnen()
        CASE WZ_BAUTEIL
            bauteilPlatzieren()
        CASE WZ_LABEL
            IF NOT doppel THEN labelSetzen()
        CASE WZ_DRAHT
            IF doppel THEN
                drahtEndePunkt()
            ELSE
                IF NOT gDrahtAktiv THEN
                    gDrahtAktiv = TRUE
                    gDrahtPunkte = []
                END IF
                ARRAY_PUSH(gDrahtPunkte, NEW kern.Punkt(gMausWX, gMausWY))
                neuZeichnen()
            END IF
    END SELECT
    statusAktualisieren()
    RETURN TRUE
END FUNCTION

FUNCTION lwLos(w AS INTEGER, ev AS INTEGER, daten AS INTEGER) AS BOOLEAN
    gPan = FALSE
    gZieht = FALSE
    gZiehGemerkt = FALSE
    RETURN TRUE
END FUNCTION

' Ziehen: der Undo-Schnappschuss faellt erst bei der ersten echten Bewegung,
' ein blosser Klick erzeugt keinen leeren Verlaufsschritt.
SUB ziehenNach(nx AS INTEGER, ny AS INTEGER)
    IF gHatLabel THEN
        IF gLabelGewaehlt.anker.x = nx AND gLabelGewaehlt.anker.y = ny THEN RETURN
        IF NOT gZiehGemerkt THEN verlaufMerken() : gZiehGemerkt = TRUE
        gLabelGewaehlt.anker = NEW kern.Punkt(nx, ny)
    ELSEIF gHatGewaehlt THEN
        IF gGewaehlt.lage.pos.x = nx AND gGewaehlt.lage.pos.y = ny THEN RETURN
        IF NOT gZiehGemerkt THEN verlaufMerken() : gZiehGemerkt = TRUE
        gGewaehlt.lage.pos = NEW kern.Punkt(nx, ny)
    ELSE
        RETURN
    END IF
    netzeVeraltet()
    gGeaendert = TRUE
    titelNachziehen()
END SUB

FUNCTION lwBewegung(w AS INTEGER, ev AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM px AS FLOAT, py AS FLOAT
    DIM ok AS BOOLEAN : ok = gdk_event_get_coords(ev, px, py)
    IF gPan THEN
        vX = vX + (px - gPanSX)
        vY = vY + (py - gPanSY)
        gPanSX = px
        gPanSY = py
        neuZeichnen()
        RETURN TRUE
    END IF
    mausSetzen(px, py)
    IF gZieht THEN ziehenNach(gMausWX + gZiehDX, gMausWY + gZiehDY)
    hoverBestimmen(px, py)
    neuZeichnen()
    statusAktualisieren()
    RETURN TRUE
END FUNCTION

FUNCTION lwVerlassen(w AS INTEGER, ev AS INTEGER, daten AS INTEGER) AS BOOLEAN
    gMausDrin = FALSE
    gHoverAktiv = FALSE
    statusAktualisieren()
    neuZeichnen()
    RETURN FALSE
END FUNCTION

FUNCTION lwRad(w AS INTEGER, ev AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM px AS FLOAT, py AS FLOAT
    DIM ok AS BOOLEAN : ok = gdk_event_get_coords(ev, px, py)
    DIM richtung AS INTEGER
    ok = gdk_event_get_scroll_direction(ev, richtung)
    DIM schritt AS FLOAT : schritt = 0
    IF richtung = GDK_RAD_HOCH THEN
        schritt = 1
    ELSEIF richtung = GDK_RAD_RUNTER THEN
        schritt = -1
    ELSE
        DIM dx AS FLOAT, dy AS FLOAT
        ok = gdk_event_get_scroll_deltas(ev, dx, dy)
        schritt = -dy
    END IF
    IF schritt <> 0 THEN zoomUm(vZoom * (1.15 ^ schritt), px, py)
    RETURN TRUE
END FUNCTION

FUNCTION lwTaste(w AS INTEGER, ev AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM taste AS INTEGER
    IF NOT gdk_event_get_keyval(ev, taste) THEN RETURN FALSE
    DIM z AS INTEGER : z = evZustand(ev)
    IF (z BAND GDK_STRG) <> 0 THEN
        SELECT CASE taste
            CASE K_S : dateiSpeichern()
            CASE K_O : dateiOeffnen()
            CASE K_Z : verlaufZurueck()
            CASE K_Y, K_Z_GROSS : verlaufVor()
            CASE ELSE : RETURN FALSE
        END SELECT
        RETURN TRUE
    END IF
    SELECT CASE taste
        CASE K_ESC
            gDrahtAktiv = FALSE
            gDrahtPunkte = []
            auswahlAufheben()
            neuZeichnen()
        CASE K_RETURN
            IF gDrahtAktiv THEN
                drahtEndePunkt()
            ELSE
                auswahlBearbeiten()
            END IF
        CASE K_E
            auswahlBearbeiten()
        CASE K_DELETE, K_BACKSPACE
            auswahlLoeschen()
        CASE K_R
            auswahlDrehen()
        CASE K_W
            werkzeugWaehlen(WZ_DRAHT, "")
        CASE K_L
            werkzeugWaehlen(WZ_LABEL, "")
        CASE K_A
            werkzeugWaehlen(WZ_AUSWAHL, "")
        CASE K_PLUS, K_GLEICH
            zoomMitte(1.2)
        CASE K_MINUS
            zoomMitte(1.0 / 1.2)
        CASE K_NULL
            zoomUm(0.12, gtk_widget_get_allocated_width(gFlaeche) / 2.0, gtk_widget_get_allocated_height(gFlaeche) / 2.0)
        CASE ELSE
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION
