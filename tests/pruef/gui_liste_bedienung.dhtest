' Listen bequemer bedienen (2026-09-23): Umbenennen mit F2, Rechtsklick
' waehlt, Rollbalken zum Ziehen, weiches Rollen -- und das Aufrollen der
' Menues. Tasten und Maus kommen ueber eine Aufnahme; getippt wird ueber die
' Zwischenablage (Strg+V), weil die Wiedergabe keine Zeichen einspeist.
' Darum seriell: parallel pastete ein Fall den Text des anderen.
' Liste bei (10, 10, 280, 200), Zeilen 22 hoch: Zeile r liegt bei
' y 10 + 22 r .. + 21. Tasten: F2 291, Enter 257, ESC 256, Strg 341, V 86.
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

=== f2 benennt um, enter uebernimmt
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM lb AS GUI_WIDGET : lb = GUI_LISTBOX(w, 10, 10, 280, 200, ["eins", "zwei", "drei"])
GUI_LISTBOX_SET(lb, "bearbeitbar", 1)
GUI_LISTBOX_SET_SELECTED(lb, 1)
GUI_FOCUS(lb)
CLIPBOARD_SET("neu")
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 6 THEN PRINT "bearbeitet gerade "; GUI_LISTBOX_EDITING(lb)
    IF GUI_LISTBOX_EDITED(lb) >= 0 THEN PRINT "umbenannt "; GUI_LISTBOX_EDITED(lb); " "; GUI_LISTBOX_ITEM(lb, 1)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "danach "; GUI_LISTBOX_EDITING(lb); " "; GUI_LISTBOX_ITEM(lb, 1)
--- datei ev.txt
c 8
e 0 7 5 215 0 0
e 2 2 291 0 0 0
e 3 1 291 0 0 0
e 8 2 341 0 0 0
e 9 2 86 0 0 0
e 10 1 86 0 0 0
e 11 1 341 0 0 0
e 13 2 257 0 0 0

--- umgebung
DHRT_FRAMES=20
--- erwartet
bearbeitet gerade 1
umbenannt 1 neu
danach -1 neu

=== esc nimmt zurueck und drueckt nicht den abbrechen-knopf
IMPORT "gui"
SCREEN(300, 260, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 260)
GUI_WINDOW_CHROME(w, FALSE)
DIM lb AS GUI_WIDGET : lb = GUI_LISTBOX(w, 10, 10, 280, 200, ["eins", "zwei", "drei"])
DIM ab AS GUI_WIDGET : ab = GUI_BUTTON(w, "Abbrechen", 10, 220, 100, 28)
GUI_WINDOW_CANCEL(w, ab)
GUI_LISTBOX_SET(lb, "bearbeitbar", 1)
GUI_LISTBOX_SET_SELECTED(lb, 2)
GUI_FOCUS(lb)
CLIPBOARD_SET("anders")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(ab) THEN PRINT "abbrechen gedrueckt"
    IF GUI_LISTBOX_EDITED(lb) >= 0 THEN PRINT "umbenannt"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT GUI_LISTBOX_EDITING(lb); " "; GUI_LISTBOX_ITEM(lb, 2)
