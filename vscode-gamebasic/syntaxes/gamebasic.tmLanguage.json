{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameBasic",
  "scopeName": "source.gamebasic",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gamebasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.gamebasic",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.gamebasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gamebasic",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "constant.numeric.gamebasic",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.gamebasic",
          "match": "(?i)\\b(FALSE|TRUE)\\b"
        },
        {
          "name": "storage.type.gamebasic",
          "match": "(?i)\\b(COROUTINE|BOOLEAN|FUNCREF|INTEGER|STRING|IMAGE|FLOAT|ARRAY|SOUND|TUPLE|FILE|MAP|OF)\\b"
        },
        {
          "name": "keyword.declaration.gamebasic",
          "match": "(?i)\\b(FUNCTION|OPERATOR|PROPERTY|EXTENDS|STATIC|IMPORT|STRUCT|CONST|CLASS|BYREF|ENUM|DIM|SUB|AS)\\b"
        },
        {
          "name": "keyword.control.gamebasic",
          "match": "(?i)\\b(CONTINUE|RESTORE|SELECT|RETURN|ELSEIF|REPEAT|WHILE|UNTIL|YIELD|INPUT|BREAK|WHERE|PRINT|THROW|CATCH|ELIF|BXOR|DATA|ELSE|CASE|THEN|WITH|STEP|WEND|BNOT|READ|BAND|NEXT|BOR|NOT|END|AND|SHL|MOD|TRY|FOR|SHR|NEW|TO|IF|OR|IN|IS)\\b"
        },
        {
          "name": "support.function.dollar.gamebasic",
          "match": "(?i)\\b(READALL|REPLACE|REVERSE|FORMAT|REPEAT|UPPER|INKEY|LTRIM|LOWER|SPACE|RIGHT|RTRIM|SPLIT|TIME|JOIN|PADL|TRIM|PADR|DATE|LEFT|BIN|OCT|STR|HEX|MID|CHR)\\$"
        },
        {
          "name": "support.function.gamebasic",
          "match": "(?i)\\b(AUDIO_MUSIC_GET_VOLUME|AUDIO_SET_NUM_CHANNELS|AUDIO_MUSIC_POSITION|AUDIO_BUSY_CHANNELS|NET_UDP_SET_TIMEOUT|AUDIO_MUSIC_RESUME|RENDERTARGET_BEGIN|CURVE_SMOOTHERSTEP|NET_CLOSE_LISTENER|ATLAS_DRAW_FLIPPED|AUDIO_MUSIC_VOLUME|AUDIO_NUM_CHANNELS|NET_UDP_LAST_FROM|RENDERTARGET_DRAW|ECS_GET_OR_STRING|AUDIO_MUSIC_QUEUE|__DICT_FROM_PAIRS|AUDIO_MUSIC_PAUSE|AUDIO_GET_VOLUME|AUDIO_MUSIC_LOAD|RENDERTARGET_NEW|AUDIO_MUSIC_PLAY|RENDERTARGET_END|ECS_GET_OR_FLOAT|CURVE_SMOOTHSTEP|AUDIO_MUSIC_STOP|AUDIO_MUSIC_BUSY|DRAWIMAGEFLIPPED|AUDIO_RESUME_ALL|AUDIO_IS_PLAYING|GENTEX_GRADIENT|ECS_GET_OR_BOOL|ARRAY_REMOVE_AT|AUDIO_PAUSE_ALL|TRIANGLEOUTLINE|JOYSTICK_BUTTON|NET_SET_TIMEOUT|NET_TCP_CONNECT|ELLIPSEOUTLINE|ECS_GET_STRING|NET_TCP_ACCEPT|ECS_ADD_STRING|GENTEX_CHECKED|AUDIO_STOP_ALL|CURVE_CATMULL2|ECS_NEW_ENTITY|SETWINDOWTITLE|POLYGONOUTLINE|SET_FULLSCREEN|JOYSTICK_COUNT|NET_TCP_LISTEN|ECS_GET_OR_INT|JOYSTICK_HAT_Y|SAVESCREENSHOT|JOYSTICK_HAT_X|ECS_NEW_WORLD|ECS_ADD_FLOAT|DRAWIMAGEPART|CLIPBOARD_SET|NET_UDP_CLOSE|NET_PEER_PORT|JOYSTICK_AXIS|CLIPBOARD_GET|QUITREQUESTED|FILES_DROPPED|GENTEX_PERLIN|JOYSTICK_NAME|NET_PEER_ADDR|ECS_GET_FLOAT|ARRAY_INDEXOF|CURVE_HERMITE|CURVE_BEZIER2|CURVE_CATMULL|CURVE_BEZIER|AUDIO_VOLUME|NET_UDP_BIND|GENTEX_COLOR|SCREENHEIGHT|ECS_GET_BOOL|ARRAY_INSERT|LAYER_DEFINE|NET_UDP_OPEN|NET_UDP_SEND|NET_UDP_RECV|TEXT_SPACING|AUDIO_RESUME|ECS_ADD_BOOL|FILE_DROPPED|BATCH_FLUSH|LAYER_CLEAR|__SET_DEDUP|__COMP_ITER|CORO_RESUME|AUDIO_NOISE|LOAD_ASSETS|ECS_GET_INT|SHADER_SET3|ECS_ADD_INT|SHADER_LOAD|TEXT_ITALIC|SHADER_SET2|DRAWTILEMAP|CORO_RESULT|SCREENWIDTH|ECS_ADD_OBJ|AUDIO_PAUSE|TEXT_HEIGHT|ECS_DESTROY|IMAGEHEIGHT|MOUSEBUTTON|ARRAY_PUSH|ECS_QUERY2|ARRAY_COPY|MOUSEWHEEL|ATLAS_LOAD|FILEEXISTS|AUDIO_TONE|AUDIO_PLAY|BLEND_MODE|STARTSWITH|TEXT_WIDTH|AUDIO_INIT|COLOR_LERP|CORO_CLOSE|ARRAY_FILL|AUDIO_STOP|KEYPRESSED|ATLAS_DRAW|IMAGEWIDTH|ECS_QUERY3|ECS_REMOVE|BATCH_DRAW|SHADER_SET|CURVE_LERP|ECS_QUERY|AUDIO_PAN|ISNUMERIC|WRITELINE|ARRAY_AVG|ARRAY_MAX|GRADIENTH|ARRAY_POP|ARRAY_MIN|LOADIMAGE|RANDOMIZE|MAPVALUES|ECS_COUNT|MAPREMOVE|LOADSOUND|ECS_ALIVE|ENDOFFILE|CORO_DONE|NET_CLOSE|PLAYSOUND|TEXT_BOLD|TEXT_SIZE|DRAWIMAGE|PLAYMUSIC|GRADIENTV|ARRAY_SUM|RECTROUND|LAYER_END|STOPSOUND|STOPMUSIC|CORO_SEND|CLOSEFILE|DIMCOUNT|NET_RECV|ENDSWITH|READLINE|NET_SEND|CONTAINS|BOXROUND|COLLIDES|MAPITEMS|LOADFONT|MAPGETOR|OPENFILE|TRIANGLE|MAPCLEAR|ECS_HAS|POLYGON|SETFONT|ELLIPSE|RANDINT|CIRCLES|SHUFFLE|READALL|MAPKEYS|ECS_GET|REVERSE|MAPSIZE|WAITKEY|DIMSIZE|REPLACE|MOUSEX|SPLINE|TRYVAL|POSTFX|CIRCLE|MAPHAS|SCREEN|IS_NIL|MAPGET|MAPPUT|CHOICE|MILLIS|SETFPS|MOUSEY|SCROLL|TIMER|RANDF|REDIM|SPACE|RIGHT|GREEN|SPLIT|PLOTS|CLAMP|LINES|FLOOR|ROUND|RANGE|WRITE|UPPER|BOXES|LOWER|HYPOT|INSTR|LINEW|DELTA|LAYER|REMAP|ATAN2|SLEEP|SIGN|ATAN|FRAC|CEIL|ACOS|TRIM|RECT|FLIP|LERP|PLOT|LEFT|SORT|TEXT|BLUE|JOIN|PADR|ASIN|LINE|TIME|PADL|DATE|FPS|SIN|POW|VAL|MIN|RED|CHR|COS|RND|SQR|RAD|DEG|LOG|CLS|ARC|LEN|INT|BOX|TAN|ABS|ASC|HSV|MAX|RGB|STR|HEX|MID|EXP)\\b"
        },
        {
          "name": "constant.language.gamebasic",
          "match": "(?i)\\b(JOY_BUTTON_RSTICK|JOY_BUTTON_LSTICK|JOY_BUTTON_START|JOY_BUTTON_BACK|JOY_DPAD_RIGHT|KEY_BACKSPACE|JOY_DPAD_LEFT|JOY_BUTTON_LB|JOY_BUTTON_RB|JOY_DPAD_DOWN|JOY_BUTTON_Y|JOY_BUTTON_X|JOY_BUTTON_A|JOY_BUTTON_B|JOY_DPAD_UP|KEY_ESCAPE|KEY_RETURN|KEY_RIGHT|LIGHTGRAY|KEY_SPACE|DARKGREEN|KEY_ENTER|KEY_DOWN|KEY_LEFT|DARKGRAY|DARKBLUE|KEY_F11|DARKRED|KEY_F12|KEY_TAB|KEY_F10|MAGENTA|KEY_F3|KEY_F1|YELLOW|ORANGE|KEY_F4|PURPLE|KEY_F9|KEY_F6|KEY_F5|KEY_F7|KEY_F2|KEY_UP|KEY_F8|KEY_9|KEY_W|KEY_L|KEY_X|KEY_U|KEY_C|GREEN|KEY_F|KEY_5|KEY_1|KEY_B|KEY_O|BLACK|KEY_Y|KEY_Q|KEY_8|BROWN|KEY_E|KEY_H|KEY_7|KEY_Z|KEY_I|KEY_3|KEY_2|KEY_P|KEY_G|KEY_6|KEY_D|KEY_V|KEY_N|WHITE|KEY_4|KEY_M|KEY_K|KEY_R|KEY_S|KEY_0|KEY_J|KEY_T|KEY_A|GRAY|CYAN|BLUE|PINK|RED|PI)\\b"
        },
        {
          "name": "keyword.operator.gamebasic",
          "match": "<=|>=|<>|[-+*/\\\\=<>^]"
        }
      ]
    }
  }
}
