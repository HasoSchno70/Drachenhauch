=== regex replace with backref (1)
' Capture-Gruppen via `\1` im Replacement.
IMPORT "regex"
PRINT REGEX_REPLACE("hello world", "(\w+) (\w+)", "\2 \1")
--- erwartet
world hello

=== regex replace with backref (2)
' Capture-Gruppen via `\1` im Replacement.
IMPORT "regex"
PRINT REGEX_REPLACE("hello world", "(\w+) (\w+)", "\2 \1")
--- erwartet
world hello

=== regex split multi separator (1)
' SPLIT$ kann nur Single-Char-Sep -- regex_split kann jedes Pattern.
IMPORT "regex"
DIM parts AS ARRAY OF STRING
parts = REGEX_SPLIT("a,b;c, d", "[,;]\s*")
PRINT parts.length()
PRINT parts[0]
PRINT parts[1]
PRINT parts[2]
PRINT parts[3]
--- erwartet
4
a
b
c
d

=== regex split multi separator (2)
' SPLIT$ kann nur Single-Char-Sep -- regex_split kann jedes Pattern.
IMPORT "regex"
DIM parts AS ARRAY OF STRING
parts = REGEX_SPLIT("a,b;c, d", "[,;]\s*")
PRINT parts.length()
PRINT parts[0]
PRINT parts[1]
PRINT parts[2]
PRINT parts[3]
--- erwartet
4
a
b
c
d

=== regex split whitespace (1)
IMPORT "regex"
DIM words AS ARRAY OF STRING
words = REGEX_SPLIT("hello   world  foo", "\s+")
PRINT words.length()
PRINT words[0]
PRINT words[1]
PRINT words[2]
--- erwartet
3
hello
world
foo

