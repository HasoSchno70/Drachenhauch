DHRT_FRAMES=60
--- inhalt _programm/probe.txt
|wurf uAnz 2 uPos 1|
|zurueck wie vorher ja|

=== eine werkseinstellung ist genau ein schritt
' Sie setzt 16 Regler UND die Wellenform -- ein Zurueck nimmt beides zurueck.
' Der dritte Eintrag ("Explosion"), Zeilenhoehe rund 22.
SET_WINDOW_POS(-3000, -3000)
DIM prBild AS INTEGER : prBild = 0
DIM prStart AS INTEGER : prStart = -1
DIM prOx AS INTEGER : prOx = 0
DIM prOy AS INTEGER : prOy = 0
DIM prF AS ARRAY OF INTEGER : prF = []
DIM prZ AS ARRAY OF STRING : prZ = []
DIM prText AS STRING : prText = ""
DIM prMerk AS INTEGER : prMerk = 0
SUB prE(f AS INTEGER, typ AS INTEGER, a AS INTEGER, b AS INTEGER)
    ARRAY_PUSH(prF, f)
    ARRAY_PUSH(prZ, STR$(typ) + " " + STR$(a) + " " + STR$(b) + " 0 0")
END SUB
SUB prKlick(f AS INTEGER, x AS INTEGER, y AS INTEGER)
    prE(f, 7, x, y)
    prE(f + 1, 7, x, y)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 5, 0, 0)
END SUB
SUB prZug(f AS INTEGER, x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    DIM i AS INTEGER
    prE(f, 7, x1, y1)
    FOR i = 0 TO 6
        prE(f + 1 + i, 7, x1 + (x2 - x1) * i \ 6, y1 + (y2 - y1) * i \ 6)
        prE(f + 1 + i, 6, 0, 0)
    NEXT
    prE(f + 8, 7, x2, y2)
    prE(f + 8, 5, 0, 0)
END SUB
SUB prStrg(f AS INTEGER, taste AS INTEGER)
    prE(f, 2, 341, 0)
    prE(f + 1, 2, taste, 0)
    prE(f + 3, 1, taste, 0)
    prE(f + 4, 1, 341, 0)
END SUB
SUB prAbspielen()
    ' Die Wiedergabe setzt beim ERSTEN Ereignis an, egal welche Nummer es
    ' traegt -- ein Ereignis in Bild 0 macht die Nummern zu Bildern ab jetzt.
    prE(0, 7, 0, 0)
    ' Nach Bild sortieren (stabil) -- die Wiedergabe arbeitet der Reihe nach ab.
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM weiter AS BOOLEAN
    DIM tf AS INTEGER
    DIM tz AS STRING
    FOR i = 1 TO LEN(prF) - 1
        j = i
        weiter = TRUE
        WHILE weiter
            weiter = FALSE
            IF j > 0 THEN
                IF prF[j - 1] > prF[j] THEN
                    tf = prF[j] : prF[j] = prF[j - 1] : prF[j - 1] = tf
                    tz = prZ[j] : prZ[j] = prZ[j - 1] : prZ[j - 1] = tz
                    j = j - 1
                    weiter = TRUE
                END IF
            END IF
        WEND
    NEXT
    DIM t AS STRING : t = "# Test-Aufnahme" + CHR$(10) + "c " + STR$(LEN(prF)) + CHR$(10)
    FOR i = 0 TO LEN(prF) - 1
        t = t + "e " + STR$(prF[i]) + " " + prZ[i] + CHR$(10)
    NEXT
    WRITEALL("ev.txt", t)
    AUTOMATION_PLAY("ev.txt")
    prStart = prBild
END SUB
SUB prMerke(z AS STRING)
    prText = prText + "|" + z + "|" + CHR$(10)
    WRITEALL("probe.txt", prText)
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
FUNCTION prDeckt(ax AS INTEGER, ay AS INTEGER, aw AS INTEGER, ah AS INTEGER, bx AS INTEGER, by AS INTEGER, bw AS INTEGER, bh AS INTEGER) AS BOOLEAN
    RETURN ax < bx + bw AND bx < ax + aw AND ay < by + bh AND by < ay + ah
END FUNCTION
SUB prFall()
    prMerk = INT(GUI_VALUE(regler[P_FREQ]))
    WRITEALL("welle.txt", STR$(GUI_DROPDOWN_SELECTED(waehlWave)))
    prKlick(6, prOx + GUI_GET_X(liste) + 60, prOy + GUI_GET_Y(liste) + 55)
    prKlick(32, prOx + GUI_GET_X(knopfZurueck) + 40, prOy + GUI_GET_Y(knopfZurueck) + 14)
    prAbspielen()
END SUB
SUB prProbe(k AS INTEGER)
    IF k = 30 THEN prMerke("preset " + STR$(GUI_LISTBOX_SELECTED(liste)) + " uAnz " + STR$(uAnz) + " uPos " + STR$(uPos))
    IF k = 52 THEN prMerke("zurueck wie vorher " + prJa$(INT(GUI_VALUE(regler[P_FREQ])) = prMerk) + " welle wie vorher " + prJa$(STR$(GUI_DROPDOWN_SELECTED(waehlWave)) = READLINES("welle.txt")[0]))
END SUB
--- programm ../../examples/183_sfx_generator.dh nach SETFPS(60)
--- einschub nach FLIP()
prBild = prBild + 1
IF prBild = 3 THEN
    prOx = GUI_CANVAS_X(flaeche) - GUI_GET_X(flaeche)
    prOy = GUI_CANVAS_Y(flaeche) - GUI_GET_Y(flaeche)
    prFall()
END IF
IF prStart >= 0 THEN prProbe(prBild - prStart)
