' Die Mindestmenge eines Produkts -- wie QuickMinimumDialog der Python-App:
' Kästchen aktiv, Menge und Einheit. Unter der Mindestmenge zeigt der Bestand
' das Produkt rot und der Filter „Unter Minimum“ findet es.
CLASS MindestmengeFenster EXTENDS MindestmengeFenster_Basis
    DIM eintragId AS INTEGER
    DIM gesichert AS BOOLEAN
    DIM e AS Eintrag

    SUB Geoeffnet()
        Self.e = eintragLaden(Self.eintragId)
        IF Self.e IS NIL THEN
            Self.Zumachen()
            RETURN
        END IF
        GUI_SET_DROPDOWN(Self.einheitListe, einheiten())
        GUI_SET_TEXT(Self.titel, "Mindestmenge: " + Self.e.name)
        GUI_SET_CHECKED(Self.aktivKasten, Self.e.minMenge > 0)
        GUI_SET_VALUE(Self.mengeFeld, IIF(Self.e.minMenge > 0, Self.e.minMenge, 1.0))
        GUI_SET_TEXT(Self.einheitListe, IIF(Self.e.minEinheit = "", einheitText$(Self.e.einheit), einheitText$(Self.e.minEinheit)))
        Self.aktivKasten_Geaendert()
    END SUB

    SUB aktivKasten_Geaendert()
        GUI_SET_ENABLED(Self.mengeFeld, GUI_CHECKED(Self.aktivKasten))
        GUI_SET_ENABLED(Self.einheitListe, GUI_CHECKED(Self.aktivKasten))
    END SUB

    SUB knopfSichern_Klick()
        DIM m AS FLOAT : m = IIF(GUI_CHECKED(Self.aktivKasten), GUI_VALUE(Self.mengeFeld), 0.0)
        mindestmengeSetzen(Self.e.produktId, Self.e.name, m, TRIM$(GUI_TEXT(Self.einheitListe)))
        Self.gesichert = TRUE
        Self.Zumachen()
    END SUB

    SUB knopfAbbrechen_Klick()
        Self.Zumachen()
    END SUB

    SUB Taste(taste AS INTEGER)
        IF taste = KEY_ESCAPE THEN Self.Zumachen()
    END SUB
END CLASS
