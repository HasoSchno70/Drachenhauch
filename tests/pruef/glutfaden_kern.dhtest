=== kaputte dateien werden mit der meldung des originals abgelehnt
IMPORT "k.dh"
SUB versuch(pfad AS STRING)
    TRY
        DIM m AS kern.Muster : m = kern.pxsLaden(pfad)
        PRINT "geladen?"
    CATCH e
        ' Die Meldung des JSON-Lesers haengt am System -- nur der eigene Teil
        IF INSTR(e, "JSON_LOAD") >= 0 THEN PRINT LEFT$(e, INSTR(e, "JSON_LOAD") + 9) ELSE PRINT e
    END TRY
END SUB
versuch("gibtsnicht.pxs")
versuch("kein_json.pxs")
versuch("fremd.pxs")
versuch("ohne_muster.pxs")
--- datei k.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern

