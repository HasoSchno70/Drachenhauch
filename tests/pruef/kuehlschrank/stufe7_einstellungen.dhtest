' Kuehlschrank-App im Drachenhauch Studio, Stufe 7 (erster Teil): die
' Einstellungen und die Benachrichtigungen (examples/studio/kuehlschrank:
' EinstellungenFenster, Klassen Einstellungen und Nachricht, Modul
' Benachrichtigungen, Hauptfenster). Proben wie in den Stufen davor: F5 im
' Studio, dann main.dh mit einer Probe statt der Bildschleife; Heute ist
' fest. Benachrichtigungen gehen mit KUEHL_MELDUNGEN in eine Datei statt ans
' System.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== einstellungen: laden, grenzen, speichern wie json.dumps
' Dieselben Schluessel und dasselbe JSON wie AppConfig der Python-App
' (true/false, Zahlen, Text in Anfuehrungszeichen, auch mit \u-Folgen);
' was fehlt, ist die Vorgabe, was ausserhalb liegt, die Grenze des Fensters.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
SUB zeigen(wann AS STRING, e AS Einstellungen)
    PRINT wann; ": dunkel "; e.dunkel; " auffrischen "; e.auffrischenS; " cache "; e.cacheAn; " einheit "; e.einheit; " | an "; e.meldungenAn; " "; e.beiAbgelaufen; e.beiHeute; e.beiMorgen; e.beiBald; e.beiMinimum; " pruefen "; e.pruefMin; " tages "; e.tagesAn; " "; e.tagesZeit$(); " | warn "; e.warnTage; " haltbar "; e.haltbarTage
END SUB
zeigen("startdaten", einstellungen())
' Wie die Python-App schreibt: ü, false, Zahlen ausserhalb.
DB_EXEC(db, "UPDATE app_settings SET value = ? WHERE key = 'default_unit'", CHR$(34) + "Stück chen" + CHR$(34))
DB_EXEC(db, "UPDATE app_settings SET value = 'false' WHERE key = 'notify_on_expiring_soon'")
DB_EXEC(db, "UPDATE app_settings SET value = '0' WHERE key = 'auto_refresh_interval_ms'")
DB_EXEC(db, "UPDATE app_settings SET value = '99999999' WHERE key = 'notification_check_interval_ms'")
DB_EXEC(db, "UPDATE app_settings SET value = '30' WHERE key = 'daily_summary_hour'")
DB_EXEC(db, "UPDATE app_settings SET value = 'kaputt' WHERE key = 'expiring_days_threshold'")
DB_EXEC(db, "DELETE FROM app_settings WHERE key = 'notifications_enabled'")
zeigen("geaendert", einstellungen())
DIM e AS Einstellungen : e = einstellungen()
e.dunkel = FALSE
e.einheit = "Pack " + CHR$(34) + "groß" + CHR$(34)
e.tagesStunde = 7 : e.tagesMinute = 45
e.speichern()
zeigen("gespeichert", einstellungen())
PRINT JOIN$(textListe("SELECT key || '=' || value FROM app_settings WHERE key IN ('dark_mode', 'default_unit', 'notifications_enabled', 'notify_on_expiring_soon', 'auto_refresh_interval_ms', 'notification_check_interval_ms', 'daily_summary_hour', 'daily_summary_minute', 'expiring_days_threshold') ORDER BY key"), CHR$(10))
DIM v AS Einstellungen : v = NEW Einstellungen()
v.vorgaben()
zeigen("vorgaben", v)
--- erwartet
geprueft TRUE
startdaten: dunkel TRUE auffrischen 30 cache TRUE einheit Stück | an TRUE TRUETRUETRUETRUETRUE pruefen 60 tages TRUE 09:00 | warn 3 haltbar 7
geaendert: dunkel TRUE auffrischen 5 cache TRUE einheit Stück chen | an TRUE TRUETRUETRUEFALSETRUE pruefen 1440 tages TRUE 23:00 | warn 3 haltbar 7
gespeichert: dunkel FALSE auffrischen 5 cache TRUE einheit Pack "groß" | an TRUE TRUETRUETRUEFALSETRUE pruefen 1440 tages TRUE 07:45 | warn 3 haltbar 7
auto_refresh_interval_ms=5000
daily_summary_hour=7
daily_summary_minute=45
dark_mode=false
default_unit="Pack \"groß\""
expiring_days_threshold=3
notification_check_interval_ms=86400000
notifications_enabled=true
notify_on_expiring_soon=false
vorgaben: dunkel TRUE auffrischen 30 cache TRUE einheit Stück | an TRUE TRUETRUETRUETRUETRUE pruefen 60 tages TRUE 09:00 | warn 3 haltbar 7
code 0

=== benachrichtigungen: arten, haekchen, einmal je produkt, neues spaeter, mindestmenge
' Die Haekchen je Art gelten (der ExpiryNotifier der Python-App las sie nie);
' jedes Produkt einmal je Art, "bald" einmal am Tag; was spaeter dazukommt,
' meldet die naechste Pruefung (dort wurde nur einmal am Tag geprueft).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
SUB pruefen(wann AS STRING, e AS Einstellungen)
    DIM m AS ARRAY OF Nachricht : m = meldungenPruefen(e)
    PRINT wann; " ("; LEN(m); ")"
    DIM x AS Nachricht
    FOR EACH x IN m
        PRINT "  "; IIF(x.wichtig, "! ", "  "); x.titel; " | "; x.text
    NEXT
END SUB
DB_EXEC(db, "INSERT INTO products (name, min_quantity) VALUES ('Quark', NULL), ('Joghurt', NULL), ('Sahne', NULL), ('Ei', NULL), ('Milch', NULL), ('Brot', NULL), ('Käse', NULL), ('Wurst', NULL), ('Reis', NULL), ('Butter', 2), ('Mehl', 1)")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES " + _
    "(1, 1, 'Stück', '2026-11-05'), (2, 1, 'Stück', '2026-11-06'), (3, 1, 'Stück', '2026-11-07'), (4, 1, 'Stück', '2026-11-04'), " + _
    "(5, 1, 'Liter', '2026-11-08'), (5, 1, 'Liter', '2026-11-08'), (6, 1, 'Stück', '2026-11-09'), (7, 1, 'Stück', '2026-11-10'), " + _
    "(8, 1, 'Stück', '2026-11-11'), (7, 1, 'Stück', '2026-11-11'), (9, 1, 'kg', '2026-11-20'), (10, 1, 'Stück', '2026-12-01'), (11, 1, 'kg', NULL)")
DIM e AS Einstellungen : e = einstellungen()
pruefen("erste", e)
pruefen("gleich nochmal", e)
' Am Nachmittag kommt etwas dazu, das heute abläuft.
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Lachs')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES ((SELECT id FROM products WHERE name = 'Lachs'), 1, 'Stück', '2026-11-08')")
pruefen("spaeter", e)
meldungenVergessen()
e.beiAbgelaufen = FALSE
e.beiMinimum = FALSE
e.warnTage = 2
pruefen("ohne abgelaufen und minimum, schwelle 2", e)
meldungenVergessen()
e = einstellungen()
e.beiHeute = FALSE : e.beiMorgen = FALSE : e.beiBald = FALSE
pruefen("nur abgelaufen und minimum", e)
meldungenVergessen()
e = einstellungen()
e.meldungenAn = FALSE
pruefen("aus", e)
--- erwartet
erste (5)
  ! ⚠️ Produkte abgelaufen! | 4 Produkt(e) sind abgelaufen: Ei, Quark, Joghurt...
  ! 🔴 Läuft HEUTE ab! | Milch
  ! 🟡 Läuft MORGEN ab! | Brot
    🟡 Bald ablaufend | 2 Produkt(e) laufen in den nächsten Tagen ab
    📊 Mindestmenge unterschritten | 1 Produkt(e): Butter
gleich nochmal (0)
spaeter (1)
  ! 🔴 Läuft HEUTE ab! | Lachs
ohne abgelaufen und minimum, schwelle 2 (3)
  ! 🔴 Läuft HEUTE ab! | Lachs, Milch
  ! 🟡 Läuft MORGEN ab! | Brot
    🟡 Bald ablaufend | 1 Produkt(e) laufen in den nächsten Tagen ab
nur abgelaufen und minimum (2)
  ! ⚠️ Produkte abgelaufen! | 4 Produkt(e) sind abgelaufen: Ei, Quark, Joghurt...
    📊 Mindestmenge unterschritten | 1 Produkt(e): Butter
aus (0)
code 0

=== zusammenfassung: uhrzeit mit minuten, einmal am tag, auch nach dem start
' Faellig ab der eingestellten Uhrzeit, einmal am Tag (auch ueber einen
' Neustart); die Python-App nahm nur die Stunde, feuerte danach zur
' Startzeit und nach einem Start nach 9 Uhr gar nicht. Gesendet wird ins
' Protokoll (KUEHL_MELDUNGEN).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
SETENV("KUEHL_MELDUNGEN", CWD$() + "/meldungen.txt")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF FILEEXISTS(CWD$() + "/meldungen.txt") THEN PRINT "protokoll:" + CHR$(10) + READALL(CWD$() + "/meldungen.txt")
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM f AS Hauptfenster : f = studioStartFenster
PRINT "leer "; zusammenfassung() IS NIL
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch'), ('Reis')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 1, 'Liter', '2026-11-07'), (1, 1, 'Liter', '2026-11-09'), (2, 1, 'kg', '2027-01-01')")
DIM m AS Nachricht : m = zusammenfassung()
PRINT m.titel; " | "; m.text; " | wichtig "; m.wichtig
DIM e AS Einstellungen : e = einstellungen()
e.tagesStunde = 9 : e.tagesMinute = 30
e.speichern()
SETENV("KUEHL_JETZT", "09:29")
PRINT "09:29 "; zusammenfassungFaellig(einstellungen())
f.zusammenfassung_Aktion()
SETENV("KUEHL_JETZT", "09:30")
PRINT "09:30 "; zusammenfassungFaellig(einstellungen())
f.zusammenfassung_Aktion()
PRINT "danach "; zusammenfassungFaellig(einstellungen()); " | status "; GUI_STATUSBAR_TEXT$(f.status, 3)
f.zusammenfassung_Aktion()
SETENV("KUEHL_JETZT", "18:00")
PRINT "abends "; zusammenfassungFaellig(einstellungen())
SETENV("KUEHL_HEUTE", "2026-11-09")
PRINT "naechster tag 18:00 "; zusammenfassungFaellig(einstellungen())
e = einstellungen()
e.tagesAn = FALSE
e.speichern()
PRINT "ohne zusammenfassung "; zusammenfassungFaellig(einstellungen())
e.tagesAn = TRUE : e.meldungenAn = FALSE
e.speichern()
PRINT "ohne benachrichtigungen "; zusammenfassungFaellig(einstellungen())
--- erwartet
leer TRUE
🧊 Tägliche Kühlschrank-Übersicht | ❌ 1 abgelaufen | ⏰ 1 bald ablaufend | 📦 3 Artikel gesamt | wichtig TRUE
09:29 FALSE
09:30 TRUE
danach FALSE | status 🔔 🧊 Tägliche Kühlschrank-Übersicht
abends FALSE
naechster tag 18:00 TRUE
ohne zusammenfassung FALSE
ohne benachrichtigungen FALSE
code 0
protokoll:
! 🧊 Tägliche Kühlschrank-Übersicht | ❌ 1 abgelaufen | ⏰ 1 bald ablaufend | 📦 3 Artikel gesamt

=== hauptfenster: einstellungen wirken sofort
' Gespeichert gilt alles gleich: Takt des Auffrischens und Pruefens, Pruefen
' aus und an (die Python-App brauchte dafuer einen Neustart), Thema,
' Standard-Einheit auch auf der Einkaufsliste, Warnschwelle, Barcode-Cache.
' Das Fenster sperrt, was ohne Benachrichtigungen nichts tut, und zeigt die
' Schwelle an einem Datum. Der Pruef-Timer meldet im Takt.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
SETENV("KUEHL_MELDUNGEN", CWD$() + "/meldungen.txt")
PRINT "code "; kProbe(p, "probe.dh", "", 600)
IF FILEEXISTS(CWD$() + "/meldungen.txt") THEN PRINT "protokoll:" + CHR$(10) + READALL(CWD$() + "/meldungen.txt")
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM f AS Hauptfenster : f = studioStartFenster
PRINT "start: auffrischen "; f.auffrischen.Intervall; " pruefen "; f.pruefen.Intervall; " "; f.pruefen.Aktiv; " thema "; HEX$(GUI_THEME_GET("win_bg"))
DB_EXEC(db, "INSERT INTO products (name, barcode) VALUES ('Milch', '4001')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 1, 'Liter', '2026-11-12')")
f.geaendert()
PRINT "bald bei 3 "; GUI_CARD_TEXT$(f.kachelBald)
cacheMerken("4001", JSON_PARSE("{" + CHR$(34) + "name" + CHR$(34) + ": " + CHR$(34) + "Milch" + CHR$(34) + "}"))
PRINT "cache an "; offAusCache("4001") IS NOT NIL
' Eine Einheit, die nicht in der Liste steht, kommt dazu.
einstellungSetzen("default_unit", jsonText$("Kiste"))
DIM ef AS EinstellungenFenster : ef = NEW EinstellungenFenster()
ef.Zeigen()
PRINT "fenster: einheit ["; GUI_TEXT(ef.einheitWahl); "] zeit "; GUI_TIME$(ef.tagesZeit); " | "; GUI_TEXT(ef.warnBeispiel)
GUI_SET_CHECKED(ef.meldungenKasten, FALSE)
ef.meldungenKasten_Geaendert()
PRINT "ohne meldungen: heute "; GUI_ENABLED(ef.heuteKasten); " pruefen "; GUI_ENABLED(ef.pruefZahl); " tages "; GUI_ENABLED(ef.tagesKasten); " zeit "; GUI_ENABLED(ef.tagesZeit)
GUI_SET_CHECKED(ef.meldungenKasten, TRUE)
GUI_SET_CHECKED(ef.tagesKasten, FALSE)
ef.meldungenKasten_Geaendert()
PRINT "ohne zusammenfassung: heute "; GUI_ENABLED(ef.heuteKasten); " zeit "; GUI_ENABLED(ef.tagesZeit)
GUI_SET_VALUE(ef.warnZahl, 5)
ef.warnZahl_Geaendert()
PRINT GUI_TEXT(ef.warnBeispiel)
GUI_SET_CHECKED(ef.dunkelKasten, FALSE)
GUI_SET_VALUE(ef.auffrischenZahl, 10)
GUI_SET_CHECKED(ef.cacheKasten, FALSE)
GUI_DROPDOWN_SET_SELECTED(ef.einheitWahl, ARRAY_INDEXOF(einheiten(), "kg"))
GUI_SET_VALUE(ef.pruefZahl, 15)
GUI_SET_TIME(ef.tagesZeit, "07:45")
ef.knopfTest_Klick()
ef.knopfSpeichern_Klick()
PRINT "gespeichert "; ef.gespeichert
' Was miEinstellungen_Aktion nach dem modalen Fenster tut.
f.anwenden()
f.geaendert()
PRINT "danach: auffrischen "; f.auffrischen.Intervall; " pruefen "; f.pruefen.Intervall; " "; f.pruefen.Aktiv; " thema "; HEX$(GUI_THEME_GET("win_bg")); " | bald bei 5 "; GUI_CARD_TEXT$(f.kachelBald)
PRINT "einheit "; standardEinheit$(); " | cache aus "; offAusCache("4001") IS NIL
cacheMerken("4002", JSON_PARSE("{}"))
PRINT "cache aus merkt nichts "; cacheProdukt$("4002") = ""
postenAnlegen("Zucker", 1, "", "", 1, "")
PRINT "einkaufsliste "; JOIN$(textListe("SELECT product_name || ' ' || unit FROM shopping_list WHERE product_name = 'Zucker'"), "")
DIM e AS Einstellungen : e = einstellungen()
PRINT "zusammenfassung "; e.tagesAn; " "; e.tagesZeit$()
' Benachrichtigungen aus: der Pruef-Timer steht; wieder an: er laeuft.
e.meldungenAn = FALSE
e.speichern()
f.anwenden()
PRINT "aus: pruefen "; f.pruefen.Aktiv
e.meldungenAn = TRUE
e.speichern()
f.anwenden()
PRINT "an: pruefen "; f.pruefen.Aktiv
' Im Takt: kurz gestellt, ein paar Bilder -- die Milch laeuft bald ab.
f.pruefen.Intervall = 50
f.pruefen.Starten()
DIM n AS INTEGER
WHILE n < 30 AND studioBild()
    n = n + 1
WEND
PRINT "status "; GUI_STATUSBAR_TEXT$(f.status, 3)
' Das Thema-Knopf der Statistik ist dieselbe Einstellung.
f.statistik.knopfThema_Klick()
PRINT "statistik: dunkel "; einstellungJa("dark_mode", FALSE); " "; GUI_TEXT(f.statistik.knopfThema)
END
--- erwartet
start: auffrischen 30000 pruefen 3600000 TRUE thema 1E2630
bald bei 3 0
cache an TRUE
fenster: einheit [Kiste] zeit 09:00:00 | Bald ablaufend heißt: heute bis 11.11.2026 (3 Tage).
ohne meldungen: heute FALSE pruefen FALSE tages FALSE zeit FALSE
ohne zusammenfassung: heute TRUE zeit FALSE
Bald ablaufend heißt: heute bis 13.11.2026 (5 Tage).
gespeichert TRUE
danach: auffrischen 10000 pruefen 900000 TRUE thema FAFBFC | bald bei 5 1
einheit kg | cache aus TRUE
cache aus merkt nichts TRUE
einkaufsliste Zucker kg
zusammenfassung FALSE 07:45
aus: pruefen FALSE
an: pruefen TRUE
status 🔔 🟡 Bald ablaufend
statistik: dunkel TRUE 🌙
code 0
protokoll:
  🧪 Test-Benachrichtigung | Dies ist ein Test der Kühlschrank-App Benachrichtigungen.
  🟡 Bald ablaufend | 1 Produkt(e) laufen in den nächsten Tagen ab

=== echt: einstellungen mit strg+komma, reiter, haken, enter speichert
' Strg+, (Menue Extras), Reiter Benachrichtigungen, Haken
' "Benachrichtigungen aktivieren" aus, Enter speichert (Standard-Knopf) --
' danach steht der Pruef-Timer. Noch einmal auf, Zuruecksetzen (Frage: Enter),
' ESC: die Vorgaben sind NICHT gespeichert.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 10)
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
FUNCTION z(i AS INTEGER) AS INTEGER
    RETURN INT(VAL(w[i]))
END FUNCTION
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slMit([341], 44)
slWarten(20)
slKlick(z(0), z(1))
slWarten(10)
slKlick(z(2), z(3))
slWarten(10)
slTaste(257)
slWarten(20)
slMit([341], 44)
slWarten(20)
slKlick(z(4), z(5))
slWarten(15)
slTaste(257)
slWarten(15)
slTaste(256)
slWarten(20)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 20)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei daten.dh
' Messlauf und Abspiellauf teilen die Datei: jedes Mal frisch.
DB_EXEC(db, "UPDATE app_settings SET value = 'true' WHERE key = 'notifications_enabled'")
DB_EXEC(db, "UPDATE app_settings SET value = '10' WHERE key = 'expiring_days_threshold'")
DIM f AS Hauptfenster : f = studioStartFenster
f.anwenden()
--- datei mess.dh
IMPORT "../../daten.dh"
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
DIM t AS INTEGER : t = GUI_METRIC_GET("title_h")
DIM ef AS EinstellungenFenster : ef = NEW EinstellungenFenster()
ef.Zeigen()
DIM ex AS INTEGER : ex = GUI_WINDOW_GET_X(ef.Fenster())
DIM ey AS INTEGER : ey = GUI_WINDOW_GET_Y(ef.Fenster()) + t
DIM rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER
(rx, ry, rw, rh) = GUI_TABCONTROL_ITEM_RECT(ef.reiter, 1)
WRITEALL("lage.txt", STR$(rx + rw \ 2) + " " + STR$(ry + rh \ 2) + " " + _
    STR$(ex + GUI_GET_X(ef.meldungenKasten) + 8) + " " + STR$(ey + GUI_GET_Y(ef.meldungenKasten) + 8) + " " + _
    STR$(ex + GUI_GET_X(ef.knopfZuruecksetzen) + GUI_GET_W(ef.knopfZuruecksetzen) \ 2) + " " + STR$(ey + GUI_GET_Y(ef.knopfZuruecksetzen) + GUI_GET_H(ef.knopfZuruecksetzen) \ 2))
--- datei klick.dh
IMPORT "../../daten.dh"
FUNCTION stand$() AS STRING
    RETURN "an " + einstellung$("notifications_enabled", "?") + " schwelle " + einstellung$("expiring_days_threshold", "?") + " pruefen " + STR$(f.pruefen.Aktiv)
END FUNCTION
DIM folge AS ARRAY OF STRING : folge = []
DIM war AS STRING : war = ""
WHILE studioBild()
    DIM jetzt AS STRING : jetzt = stand$()
    IF jetzt <> war THEN ARRAY_PUSH(folge, jetzt)
    war = jetzt
WEND
PRINT JOIN$(folge, " -> ")
--- erwartet
an true schwelle 10 pruefen TRUE -> an false schwelle 10 pruefen FALSE
code 0

=== start: thema aus der einstellung
' Hell gespeichert, hell gestartet (die Python-App hatte das Haekchen "Dark
' Mode", las es aber nie).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
' Die Datei, die die Probe liest: einmal anlegen lassen, dann hell setzen.
kProbe(p, "leer.dh", "", 3)
DIM d AS DB_CONN : d = DB_OPEN(p + "/_studio/fridge_database.db")
DB_EXEC(d, "INSERT OR REPLACE INTO app_settings (key, value) VALUES ('dark_mode', 'false')")
DB_CLOSE(d)
PRINT "code "; kProbe(p, "probe.dh", "", 3)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
