' Welche Datei? Das Argument, sonst das Beispielmuster.
DIM probe AS STRING
DIM fotoZiel AS STRING
DIM start AS STRING
DIM a AS INTEGER
FOR a = 0 TO ARGC() - 1
    IF ARG$(a) = "--probe" THEN
        probe = "ansehen"
    ELSEIF ARG$(a) = "--probe-bearbeiten" THEN
        probe = "bearbeiten"
    ELSEIF ARG$(a) = "--probe-stufe3" THEN
        probe = "stufe3"
    ELSEIF ARG$(a) = "--probe-stufe4" THEN
        probe = "stufe4"
    ELSEIF ARG$(a) = "--probe-stufe5" THEN
        probe = "stufe5"
    ELSEIF ARG$(a) = "--probe-stufe6" THEN
        probe = "stufe6"
    ELSEIF ARG$(a) = "--probe-stufe7" THEN
        probe = "stufe7"
    ELSEIF ARG$(a) = "--probe-stufe8" THEN
        probe = "stufe8"
    ELSEIF ARG$(a) = "--probe-stufe9" THEN
        probe = "stufe9"
    ELSEIF ARG$(a) = "--probe-stufe10" THEN
        probe = "stufe10"
    ELSEIF ARG$(a) = "--probe-stufe11" THEN
        probe = "stufe11"
    ELSEIF ARG$(a) = "--probe-stufe12" THEN
        probe = "stufe12"
    ELSEIF ARG$(a) = "--probe-stufe13" THEN
        probe = "stufe13"
    ELSEIF ARG$(a) = "--probe-start" THEN
        probe = "start"
    ELSEIF ARG$(a) = "--probe-stufe14" THEN
        probe = "stufe14"
    ELSEIF ARG$(a) = "--probe-stufe15" THEN
        probe = "stufe15"
    ELSEIF ARG$(a) = "--probe-stufe16" THEN
        probe = "stufe16"
    ELSEIF ARG$(a) = "--probe-stufe17" THEN
        probe = "stufe17"
    ELSEIF ARG$(a) = "--probe-stufe18" THEN
        probe = "stufe18"
    ELSEIF ARG$(a) = "--probe-stufe19" THEN
        probe = "stufe19"
    ELSEIF ARG$(a) = "--probe-stufe20" THEN
        probe = "stufe20"
    ELSEIF ARG$(a) = "--probe-stufe21" THEN
        probe = "stufe21"
    ELSEIF ARG$(a) = "--probe-stufe22" THEN
        probe = "stufe22"
    ELSEIF ARG$(a) = "--foto" AND a < ARGC() - 1 THEN
        fotoZiel = ARGPATH$(a + 1)
        a = a + 1
    ELSE
        start = ARGPATH$(a)
    END IF
NEXT
autosichernStart()
DIM geladen AS BOOLEAN
IF start <> "" THEN
    geladen = musterOeffnen(start)
    IF NOT lwHat THEN willkommenZeigen()
ELSE
    ' Ohne Datei: erst liegen gebliebene automatische Sicherungen, dann die
    ' Startaktion aus den Einstellungen (wie PySticky _perform_start_action)
    asStartPruefen()
    IF NOT lwHat THEN
        SELECT CASE einst.startAktion
            CASE 1
                musterZeigen(kern.neuesMuster("Unbenannt", 50, 50), "", "Unbenannt")
            CASE 2
                musterZeigen(kern.neuesMuster("Unbenannt", 50, 50), "", "Unbenannt")
                neuDialog()
            CASE 3
                DIM liste AS ARRAY OF STRING : liste = kern.zuletztVorhanden(einst)
                IF LEN(liste) > 0 THEN geladen = musterOeffnen(liste[0])
        END SELECT
    END IF
    ' Das Beispielmuster nur als Startaktion; fehlt die letzte Datei oder
    ' steht die Startaktion auf der Willkommensseite, kommt diese (PySticky)
    IF NOT lwHat AND einst.startAktion = 0 THEN geladen = musterOeffnen(PATHJOIN(CWD$(), "daten/muster/demo_kreuzstich.pxs"))
    IF NOT lwHat THEN willkommenZeigen()
END IF
' Werkzeug beim Start (Einstellungen -> Werkzeuge)
werkzeugWaehlen(IIF(einst.werkzeugMerken, einst.letztesWerkzeug, einst.startWerkzeug), FALSE)

IMPORT "ansicht/vorfuehrung.dh"
' Die Fotoproben vor Stufe 16 zaehlen Farben im Bereich der Zeichenflaeche --
' die Farbleiste darunter zeigt dieselben Farben und zaehlte mit
IF probe <> "" THEN lwOhneMaus = TRUE
IF probe <> "" AND probe <> "stufe16" AND probe <> "start" THEN
    fbProbeAus = TRUE
    farbleisteZeigen(FALSE)
