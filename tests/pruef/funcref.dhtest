CONST FACTOR = 10

FUNCTION scale(x AS INTEGER) AS INTEGER
    RETURN x * FACTOR
END FUNCTION

DIM f AS FUNCREF
f = scale
PRINT f(7)
--- erwartet
70

=== funcref compose (1)
' Kombination: FUNCREF an FUNCREF, beide gleich aufrufbar.
FUNCTION add1(x AS INTEGER) AS INTEGER
    RETURN x + 1
END FUNCTION

FUNCTION mul2(x AS INTEGER) AS INTEGER
    RETURN x * 2
END FUNCTION

FUNCTION apply(f AS FUNCREF, g AS FUNCREF, x AS INTEGER) AS INTEGER
    RETURN g(f(x))
END FUNCTION

PRINT apply(add1, mul2, 5)
PRINT apply(mul2, add1, 5)
--- erwartet
12
11

=== funcref compose (2)
' Kombination: FUNCREF an FUNCREF, beide gleich aufrufbar.
FUNCTION add1(x AS INTEGER) AS INTEGER
    RETURN x + 1
END FUNCTION

FUNCTION mul2(x AS INTEGER) AS INTEGER
    RETURN x * 2
END FUNCTION

FUNCTION apply(f AS FUNCREF, g AS FUNCREF, x AS INTEGER) AS INTEGER
    RETURN g(f(x))
END FUNCTION

PRINT apply(add1, mul2, 5)
PRINT apply(mul2, add1, 5)
--- erwartet
12
11

=== funcref rejects non funcref (1)
DIM f AS FUNCREF
f = 42
--- fehler
Zuweisung an global: Erwartet FUNCREF, erhalten INTEGER

=== funcref rejects non funcref (2)
DIM f AS FUNCREF
f = 42
--- fehler
Zuweisung an global: Erwartet FUNCREF, erhalten INTEGER

=== calling non callable throws (1)
' `x()` mit x = 42 wirft.
DIM x AS INTEGER
x = 42
PRINT x()
--- fehler
'x' ist eine Variable vom Typ INTEGER und kann nicht wie eine Funktion aufgerufen werden. Falls du den eingebauten Befehl 'X' meinst: benenne die Variable um -- eine Variable mit festem Wert-Typ (INTEGER, FLOAT, STRING ...) verdeckt einen Befehl nicht, eine FUNCREF schon.

=== calling non callable throws (2)
' `x()` mit x = 42 wirft.
DIM x AS INTEGER
x = 42
PRINT x()
--- fehler
'x' ist eine Variable vom Typ INTEGER und kann nicht wie eine Funktion aufgerufen werden. Falls du den eingebauten Befehl 'X' meinst: benenne die Variable um -- eine Variable mit festem Wert-Typ (INTEGER, FLOAT, STRING ...) verdeckt einen Befehl nicht, eine FUNCREF schon.

=== user var shadows function (1)
' Eine User-Variable mit gleichem Namen wie eine Function "verschattet"
FUNCTION foo(x AS INTEGER) AS INTEGER
    RETURN x
END FUNCTION

DIM foo AS INTEGER
foo = 99
PRINT foo
--- erwartet
99

