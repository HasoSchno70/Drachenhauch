--- erwartet
halb 1: TRUE
halb 2: TRUE
viertel ol: TRUE
viertel or: TRUE
viertel ul: TRUE
viertel ur: TRUE
dreiviertel: TRUE
knoten: TRUE
perle: TRUE
glanz: TRUE

=== bild: raster, symbole, formate und drills
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
DIM p AS kern.Muster : p = kern.pxsLaden("probe.pxs")
kern.bildExportieren(p, "mit.png", 20, TRUE, TRUE)
kern.bildExportieren(p, "ohne.png", 20, FALSE, FALSE)
DIM a AS IMAGE : a = LOADIMAGE("mit.png")
DIM o AS IMAGE : o = LOADIMAGE("ohne.png")
' Raster: jede Linie hellgrau, jede zehnte dunkler (auch die erste)
PRINT "raster: "; HEX$(GETPIXEL(a, 20, 175)); " "; HEX$(GETPIXEL(a, 200, 175)); " "; HEX$(GETPIXEL(a, 0, 175)); " ohne: "; HEX$(GETPIXEL(o, 20, 175))
' Symbole: in einem schwarzen Kaestchen weisse Punkte (helles Garn -> schwarz)
FUNCTION weisse(b AS IMAGE, cx AS INTEGER, cy AS INTEGER) AS INTEGER
    DIM n AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR y = cy * 20 + 2 TO cy * 20 + 18
        FOR x = cx * 20 + 2 TO cx * 20 + 18
            IF GETPIXEL(b, x, y) = &HFFFFFF THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
PRINT "symbol: "; weisse(a, 4, 0) > 10; " ohne: "; weisse(o, 4, 0)
' andere Formate
kern.bildExportieren(p, "bild.bmp", 8, TRUE, FALSE)
kern.bildExportieren(p, "bild.jpg", 8, TRUE, FALSE)
PRINT "bmp: "; IMAGE_WIDTH(LOADIMAGE("bild.bmp")); " jpg: "; IMAGE_HEIGHT(LOADIMAGE("bild.jpg"))
TRY
    kern.bildExportieren(p, "bild.gif", 8, TRUE, FALSE)
CATCH e
    PRINT e
END TRY
' Diamond: jeder Stich ein Drill mit hellerer oberer Facette, kein Rueckstich
DIM d AS kern.Muster : d = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")
d.modus = "diamond"
kern.bildExportieren(d, "drill.png", 20, FALSE, FALSE)
DIM r AS IMAGE : r = LOADIMAGE("drill.png")
DIM ob AS INTEGER : ob = GETPIXEL(r, 5 * 20 + 10, 5 * 20 + 4)
DIM un AS INTEGER : un = GETPIXEL(r, 5 * 20 + 10, 5 * 20 + 16)
PRINT "drill oben heller: "; kern.rotAnteil(ob) + kern.gruenAnteil(ob) + kern.blauAnteil(ob) > kern.rotAnteil(un) + kern.gruenAnteil(un) + kern.blauAnteil(un); " rand stoff: "; HEX$(GETPIXEL(r, 5 * 20, 5 * 20))
