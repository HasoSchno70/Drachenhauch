DIM mBearb AS INTEGER : mBearb = GUI_MENU(winTop, "Bearbeiten")
DIM miRueck AS INTEGER : miRueck = GUI_MENU_ITEM(mBearb, "Rückgängig", "Strg+Z")
DIM miWieder AS INTEGER : miWieder = GUI_MENU_ITEM(mBearb, "Wiederholen", "Strg+Y")
GUI_MENU_SEPARATOR(mBearb)
DIM miSpurPlus AS INTEGER : miSpurPlus = GUI_MENU_ITEM(mBearb, "Spur hinzufügen")
DIM miSpurWeg AS INTEGER : miSpurWeg = GUI_MENU_ITEM(mBearb, "Letzte Spur entfernen")

DIM dauerNamen AS ARRAY OF STRING : dauerNamen = ["Ganze", "Halbe", "Viertel", "Achtel", "Sechzehntel"]
DIM dauerWerte AS ARRAY OF FLOAT : dauerWerte = [4.0, 2.0, 1.0, 0.5, 0.25]
DIM ddDauer AS GUI_WIDGET : ddDauer = GUI_DROPDOWN(winTop, 8, 8, 110, 24, dauerNamen)
GUI_DROPDOWN_SET_SELECTED(ddDauer, 2)
GUI_TOOLTIP(ddDauer, "Notendauer -- zugleich das Raster fuer den Klick")
DIM cbPunkt AS GUI_WIDGET : cbPunkt = GUI_CHECKBOX(winTop, "punktiert", 126, 12)
DIM ddVorz AS GUI_WIDGET : ddVorz = GUI_DROPDOWN(winTop, 226, 8, 100, 24, ["natürlich", "Kreuz", "B"])
GUI_TOOLTIP(ddVorz, "Vorzeichen: verschiebt die geklickte Stammnote um einen Halbton")
DIM modusNamen AS ARRAY OF STRING : modusNamen = ["Note", "Pause", "Bindebogen", "Fingersatz", "Staccato"]
DIM ddModus AS GUI_WIDGET : ddModus = GUI_DROPDOWN(winTop, 334, 8, 120, 24, modusNamen)
GUI_TOOLTIP(ddModus, "Was ein Klick tut")
DIM ddFinger AS GUI_WIDGET : ddFinger = GUI_DROPDOWN(winTop, 462, 8, 50, 24, ["1", "2", "3", "4", "5"])
GUI_TOOLTIP(ddFinger, "Fingersatz-Zahl (Modus Fingersatz)")
DIM lblBpm AS GUI_WIDGET : lblBpm = GUI_LABEL(winTop, "BPM", 522, 12)
DIM fBpm AS GUI_WIDGET : fBpm = GUI_TEXTINPUT(winTop, 558, 8, 56, 24, "120")
GUI_TEXTINPUT_SET(fBpm, "zahlen", 1)
DIM btnSpielen AS GUI_WIDGET : btnSpielen = GUI_BUTTON(winTop, "Abspielen", 624, 7, 110, 26)
DIM btnTracker AS GUI_WIDGET : btnTracker = GUI_BUTTON(winTop, "In Tracker", 742, 7, 110, 26)
DIM btnSpurPlus AS GUI_WIDGET : btnSpurPlus = GUI_BUTTON(winTop, "+ Spur", 860, 7, 70, 26)
DIM btnSpurWeg AS GUI_WIDGET : btnSpurWeg = GUI_BUTTON(winTop, "- Spur", 938, 7, 70, 26)
DIM lblStatus AS GUI_WIDGET : lblStatus = GUI_LABEL(winTop, "Bereit.", 8, 44)
' Rechts in derselben Zeile stehen die Notenwerte als Knopfleiste.
GUI_SET_WRAP(lblStatus, SCREENWIDTH() - 300)
DIM mAnsicht AS INTEGER : mAnsicht = GUI_MENU(winTop, "Ansicht")
DIM miZoomPlus AS INTEGER : miZoomPlus = GUI_MENU_ITEM(mAnsicht, "Vergrößern", "Strg+Plus")
DIM miZoomMinus AS INTEGER : miZoomMinus = GUI_MENU_ITEM(mAnsicht, "Verkleinern", "Strg+Minus")
DIM miZoom100 AS INTEGER : miZoom100 = GUI_MENU_ITEM(mAnsicht, "Originalgröße", "Strg+0")

' --- Fenster links: je Spur Name, Schluessel, Instrument --------------------------
DIM winLinks AS GUI_WINDOW : winLinks = GUI_WINDOW("Spuren", 0, TOP_B, LINKS_B, SCREENHEIGHT() - TOP_B)
GUI_WINDOW_CHROME(winLinks, FALSE)
GUI_WINDOW_MOVABLE(winLinks, FALSE)
DIM sLabel[MAX_SPUREN] AS GUI_WIDGET
DIM sName[MAX_SPUREN] AS GUI_WIDGET
DIM sClef[MAX_SPUREN] AS GUI_WIDGET
DIM sInst[MAX_SPUREN] AS GUI_WIDGET
DIM sClefSel[MAX_SPUREN] AS INTEGER
DIM sInstSel[MAX_SPUREN] AS INTEGER
DIM si AS INTEGER
FOR si = 0 TO MAX_SPUREN - 1
    sLabel[si] = GUI_LABEL(winLinks, "Spur " + STR$(si + 1), 8, 8)
    sName[si] = GUI_TEXTINPUT(winLinks, 8, 30, LINKS_B - 16, 24, "")
    sClef[si] = GUI_DROPDOWN(winLinks, 8, 60, LINKS_B - 16, 24, ["Violinschlüssel", "Bassschlüssel"])
    sInst[si] = GUI_DROPDOWN(winLinks, 8, 90, LINKS_B - 16, 24, instNamen)
    sClefSel[si] = 0 : sInstSel[si] = 0
NEXT
DIM stumm AS BOOLEAN : stumm = FALSE

DIM spurFarben AS ARRAY OF INTEGER : spurFarben = [&H2DE0E0, &H2DE89A, &HE55A8C, &HFFB74D, &H7FA7FF, &HC792EA, &HFFD54F, &H80CBC4]
FUNCTION spurFarbe(i AS INTEGER) AS INTEGER
    RETURN spurFarben[i MOD LEN(spurFarben)]
END FUNCTION

FUNCTION instrumentIndex(i AS INTEGER) AS INTEGER
    DIM nm AS STRING : nm = text$(tp$(i, "instrument.name"))
    DIM j AS INTEGER : j = ARRAY_INDEXOF(pName, nm)
    IF j < 0 THEN j = LEN(pName)          ' "(aus Datei)"
    RETURN j
END FUNCTION

SUB spurenAnzeigen()
    stumm = TRUE
    DIM i AS INTEGER
    FOR i = 0 TO MAX_SPUREN - 1
        DIM da AS BOOLEAN : da = i < nt()
        DIM y AS INTEGER : y = 8 + i * STAFF_H - scrollY
        GUI_SET_VISIBLE(sLabel[i], da) : GUI_SET_VISIBLE(sName[i], da)
        GUI_SET_VISIBLE(sClef[i], da) : GUI_SET_VISIBLE(sInst[i], da)
        IF da THEN
            GUI_SET_BOUNDS(sLabel[i], 8, y, 200, 20)
            GUI_SET_BOUNDS(sName[i], 8, y + 22, LINKS_B - 16, 24)
            GUI_SET_BOUNDS(sClef[i], 8, y + 52, LINKS_B - 16, 24)
            GUI_SET_BOUNDS(sInst[i], 8, y + 82, LINKS_B - 16, 24)
            GUI_SET_TEXT(sLabel[i], "Spur " + STR$(i + 1) + "  (" + STR$(nn(i)) + " Noten)")
            GUI_SET_TEXT(sName[i], text$(tp$(i, "name")))
            sClefSel[i] = IIF(text$(tp$(i, "clef")) = "bass", 1, 0)
            GUI_DROPDOWN_SET_SELECTED(sClef[i], sClefSel[i])
            sInstSel[i] = instrumentIndex(i)
            GUI_DROPDOWN_SET_SELECTED(sInst[i], sInstSel[i])
        END IF
    NEXT
    GUI_SET_TEXT(fBpm, STR$(bpm()))
    stumm = FALSE
END SUB

' --- Aenderungen am Modell ---------------------------------------------------------
DIM entryDauer AS FLOAT : entryDauer = 1.0
DIM entryAcc AS INTEGER : entryAcc = 0
DIM entryModus AS INTEGER : entryModus = 0       ' 0 Note, 1 Pause, 2 Bogen, 3 Finger, 4 Staccato

SUB werkzeugeLesen()
    entryDauer = dauerWerte[CLAMP(GUI_DROPDOWN_SELECTED(ddDauer), 0, 4)]
    IF GUI_CHECKED(cbPunkt) THEN entryDauer = entryDauer * 1.5
    DIM v AS INTEGER : v = GUI_DROPDOWN_SELECTED(ddVorz)
    entryAcc = 0
    IF v = 1 THEN entryAcc = 1
    IF v = 2 THEN entryAcc = -1
    entryModus = CLAMP(GUI_DROPDOWN_SELECTED(ddModus), 0, 4)
END SUB

FUNCTION rastern(beat AS FLOAT) AS FLOAT
    IF entryDauer <= 0.0 THEN RETURN MAX(0.0, beat)
    RETURN MAX(0.0, ROUND(beat / entryDauer) * entryDauer)
END FUNCTION

SUB boegenWeg(i AS INTEGER, beat AS FLOAT)
    IF NOT JSON_HAS(doc, tp$(i, "slurs")) THEN RETURN
    DIM k AS INTEGER
    FOR k = JSON_LEN(doc, tp$(i, "slurs")) - 1 TO 0 STEP -1
        DIM sp AS STRING : sp = tp$(i, "slurs." + STR$(k))
        IF ABS(komma(sp + ".0", -1.0) - beat) < 0.000001 OR ABS(komma(sp + ".1", -1.0) - beat) < 0.000001 THEN JSON_REMOVE(doc, sp)
    NEXT
END SUB

SUB bogenHinzu(i AS INTEGER, a AS FLOAT, b AS FLOAT)
    DIM lo AS FLOAT : lo = MIN(a, b)
    DIM hi AS FLOAT : hi = MAX(a, b)
    IF ABS(hi - lo) < 0.000001 THEN RETURN
    IF NOT JSON_HAS(doc, tp$(i, "slurs")) THEN JSON_SET_JSON(doc, tp$(i, "slurs"), JSON_NEW_ARRAY())
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(doc, tp$(i, "slurs")) - 1
        DIM sp AS STRING : sp = tp$(i, "slurs." + STR$(k))
        IF ABS(komma(sp + ".0", -1.0) - lo) < 0.000001 AND ABS(komma(sp + ".1", -1.0) - hi) < 0.000001 THEN RETURN
    NEXT
    DIM paar AS JSON_HANDLE : paar = JSON_NEW_ARRAY()
    JSON_APPEND_FLOAT(paar, "", lo) : JSON_APPEND_FLOAT(paar, "", hi)
    JSON_APPEND_JSON(doc, tp$(i, "slurs"), paar)
END SUB

' Bogen-Anker wandern mit einer verschobenen Note -- aber nur, wenn am alten
' Beat keine andere Note mehr sitzt (der Bogen gehoerte sonst wohl ihr).
SUB boegenVerschieben(i AS INTEGER, alt AS FLOAT, neu AS FLOAT)
    IF ABS(alt - neu) < 0.000001 THEN RETURN
    IF noteBei(i, alt) >= 0 THEN RETURN
    IF NOT JSON_HAS(doc, tp$(i, "slurs")) THEN RETURN
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(doc, tp$(i, "slurs")) - 1
        DIM sp AS STRING : sp = tp$(i, "slurs." + STR$(k))
        DIM a AS FLOAT : a = komma(sp + ".0", 0.0)
        DIM b AS FLOAT : b = komma(sp + ".1", 0.0)
        IF ABS(a - alt) < 0.000001 THEN a = neu
        IF ABS(b - alt) < 0.000001 THEN b = neu
        JSON_SET_FLOAT(doc, sp + ".0", MIN(a, b)) : JSON_SET_FLOAT(doc, sp + ".1", MAX(a, b))
    NEXT
END SUB

SUB noteEntfernen(i AS INTEGER, k AS INTEGER)
    DIM beat AS FLOAT : beat = nStart(i, k)
    JSON_REMOVE(doc, "tracks." + STR$(i) + ".notes." + STR$(k))
    IF noteBei(i, beat) < 0 THEN boegenWeg(i, beat)
END SUB

SUB setzen(i AS INTEGER, beat AS FLOAT, pitch AS INTEGER, pause AS BOOLEAN)
    DIM k AS INTEGER : k = noteBei(i, beat)
    DIM gleich AS BOOLEAN : gleich = FALSE
    IF k >= 0 THEN
        gleich = istPause(i, k) = pause AND (pause OR nPitch(i, k) = pitch)
        noteEntfernen(i, k)
    END IF
    IF NOT gleich THEN
        DIM n AS JSON_HANDLE : n = JSON_NEW_OBJECT()
        JSON_SET_FLOAT(n, "start", beat) : JSON_SET_FLOAT(n, "dur", entryDauer)
        IF pause THEN
            JSON_SET_BOOL(n, "rest", TRUE)
        ELSE
            JSON_SET_INT(n, "pitch", pitch)
            IF entryAcc <> 1 THEN JSON_SET_INT(n, "accidental", entryAcc)
        END IF
        JSON_APPEND_JSON(doc, tp$(i, "notes"), n)
        notenSortieren(i)
        IF pause THEN
            protokoll("pause " + STR$(i) + " " + zahl$(beat) + " " + zahl$(entryDauer))
        ELSE
            protokoll("note " + STR$(i) + " " + zahl$(beat) + " " + STR$(pitch) + " " + zahl$(entryDauer))
        END IF
    ELSE
        protokoll("entfernt " + STR$(i) + " " + zahl$(beat))
    END IF
    merken()
    spurenAnzeigen()
END SUB

SUB spurAnlegen()
    DIM t AS JSON_HANDLE : t = JSON_NEW_OBJECT()
    JSON_SET_STRING(t, "name", "Stimme " + STR$(nt() + 1))
    JSON_SET_STRING(t, "clef", "treble")
    JSON_SET_JSON(t, "instrument", presetJson(0))
    JSON_SET_JSON(t, "notes", JSON_NEW_ARRAY())
    JSON_APPEND_JSON(doc, "tracks", t)
END SUB

SUB spurHinzu()
    IF nt() >= MAX_SPUREN THEN
        GUI_SET_TEXT(lblStatus, "Hoechstens " + STR$(MAX_SPUREN) + " Spuren.")
        RETURN
    END IF
    spurAnlegen()
    merken()
    spurenAnzeigen()
    protokoll("spur " + STR$(nt()))
END SUB

SUB spurWeg()
    IF nt() <= 1 THEN RETURN
    JSON_REMOVE(doc, "tracks." + STR$(nt() - 1))
    merken()
    spurenAnzeigen()
    protokoll("spur weg " + STR$(nt()))
END SUB

' Schluesselwechsel transponiert nicht -- aber liegen die Noten danach weit ab
' vom System, rueckt ein Oktavversatz sie heran (Melodie bleibt gleich).
SUB schluesselSetzen(i AS INTEGER, clef AS STRING)
    IF text$(tp$(i, "clef")) = clef THEN RETURN
    JSON_SET_STRING(doc, tp$(i, "clef"), clef)
    DIM summe AS FLOAT : summe = 0.0
    DIM anz AS INTEGER : anz = 0
    DIM k AS INTEGER
    FOR k = 0 TO nn(i) - 1
        IF NOT istPause(i, k) THEN summe = summe + nPitch(i, k) : anz = anz + 1
    NEXT
    DIM versatz AS INTEGER : versatz = 0
    IF anz > 0 THEN
        DIM mitte AS INTEGER : mitte = IIF(clef = "bass", 50, 71)
        versatz = INT(ROUND((mitte - summe / anz) / 12.0)) * 12
        IF versatz <> 0 THEN
            FOR k = 0 TO nn(i) - 1
                IF NOT istPause(i, k) THEN JSON_SET_INT(doc, np$(i, k, "pitch"), nPitch(i, k) + versatz)
            NEXT
            GUI_SET_TEXT(lblStatus, "Schluessel gewechselt; die Noten um " + STR$(versatz \ 12) + " Oktave(n) ans System gerueckt (Strg+Z nimmt es zurueck).")
        END IF
    END IF
    merken()
    protokoll("schluessel " + STR$(i) + " " + clef + " " + STR$(versatz))
END SUB

' --- Klang und Wiedergabe --------------------------------------------------------
DIM cache AS MAP OF INTEGER
DIM takt AS AUDIO_CLOCK
DIM spielt AS BOOLEAN : spielt = FALSE
DIM spielEnde AS INTEGER : spielEnde = 0

FUNCTION freqVon(m AS INTEGER) AS FLOAT
    RETURN 440.0 * POW(2.0, (m - 69) / 12.0)
END FUNCTION

FUNCTION klang(i AS INTEGER, midi AS INTEGER, ms AS INTEGER) AS INTEGER
    DIM ip AS STRING : ip = tp$(i, "instrument")
    DIM wf AS STRING : wf = text$(ip + ".waveform")
    IF wf = "" THEN wf = "triangle"
    DIM atk AS INTEGER : atk = ganz(ip + ".env_attack_ms", 0)
    DIM dec AS INTEGER : dec = ganz(ip + ".env_decay_ms", 0)
    DIM sus AS FLOAT : sus = komma(ip + ".env_sustain", 1.0)
    DIM rel AS INTEGER : rel = ganz(ip + ".env_release_ms", 0)
    DIM vd AS FLOAT : vd = komma(ip + ".vib_depth", 0.0)
    DIM vs AS FLOAT : vs = komma(ip + ".vib_speed", 0.0)
    DIM det AS FLOAT : det = komma(ip + ".detune_cents", 0.0)
    DIM key AS STRING : key = wf + "|" + STR$(atk) + "|" + STR$(dec) + "|" + FORMAT$(sus, "%.2f") + "|" + STR$(rel) + "|" + FORMAT$(vd, "%.3f") + "|" + FORMAT$(vs, "%.1f") + "|" + FORMAT$(det, "%.1f") + "|" + STR$(midi) + "|" + STR$(ms)
    IF MAPHAS(cache, key) THEN RETURN MAPGET(cache, key)
    ' 0.6 als Kopfraum wie die Qt-Fassung -- mehrere Stimmen liegen uebereinander.
    DIM s AS INTEGER : s = AUDIO_NOTE(wf, freqVon(midi), ms, atk, dec, sus, rel, 0.6, vd, vs, det, 0.0)
    MAPPUT(cache, key, s)
    RETURN s
END FUNCTION

SUB stopp()
    IF spielt THEN AUDIO_CLOCK_REMOVE(takt)      ' entfernen, nicht anhalten: Geplantes startet dann nie
    spielt = FALSE
    protokoll("stopp")
END SUB

' Alle Noten auf einer Audio-Uhr planen (eine Sechzehntel = ein Tick) --
' samplegenau vom Audio-Faden gestartet, nicht bildgetrieben.
SUB starten()
    IF spielt THEN stopp()
    IF notenGesamt() = 0 THEN
        GUI_SET_TEXT(lblStatus, "Nichts zu spielen.")
        RETURN
    END IF
    takt = AUDIO_CLOCK_NEW(bpm() / 60.0 * ROWS_PER_BEAT)
    DIM geplant AS INTEGER : geplant = 0
    DIM i AS INTEGER
    FOR i = 0 TO nt() - 1
        DIM lautst AS FLOAT : lautst = CLAMP(ganz(tp$(i, "instrument.default_vol"), 15), 1, 15) / 15.0
        DIM k AS INTEGER
        FOR k = 0 TO nn(i) - 1
            IF istPause(i, k) THEN CONTINUE
            DIM d AS FLOAT : d = nDauer(i, k)
            ' Staccato: halbe Dauer, mindestens eine Tracker-Zeile -- wie convert.py
            IF wahr(np$(i, k, "staccato"), FALSE) THEN d = MAX(1.0 / ROWS_PER_BEAT, d * 0.5)
            DIM ms AS INTEGER : ms = MAX(1, INT(d * 60000.0 / bpm()))
            AUDIO_PLAY_AT(klang(i, nPitch(i, k), ms), takt, INT(ROUND(nStart(i, k) * ROWS_PER_BEAT)), lautst)
            geplant = geplant + 1
        NEXT
    NEXT
    spielEnde = INT(ROUND((stueckLaenge() + 0.5) * ROWS_PER_BEAT))
    spielt = TRUE
    AUDIO_CLOCK_START(takt)
    GUI_SET_TEXT(lblStatus, STR$(geplant) + " Noten geplant, " + STR$(bpm()) + " BPM.")
    protokoll("spielt " + STR$(geplant))
END SUB

' --- Tracker-Projekt: dieselben Regeln wie die fruehere score/convert.py ------------
FUNCTION beatZeile(beat AS FLOAT) AS INTEGER
    RETURN INT(ROUND(beat * ROWS_PER_BEAT))
END FUNCTION

' Eine Zahl wie Pythons `:g` -- sechs gueltige Stellen, ohne Nullen am Ende.
' So stehen die Beats in den Warnungen genau wie bei score/convert.py.
FUNCTION beat$(v AS FLOAT) AS STRING
    IF v = INT(v) THEN RETURN STR$(INT(v))
    DIM stellen AS INTEGER : stellen = 6
    IF ABS(v) >= 1.0 THEN stellen = MAX(0, 6 - LEN(STR$(INT(ABS(v)))))
    DIM t AS STRING : t = FORMAT$(v, "%." + STR$(stellen) + "f")
    WHILE INSTR(t, ".") >= 0 AND RIGHT$(t, 1) = "0"
        t = LEFT$(t, LEN(t) - 1)
    WEND
    IF RIGHT$(t, 1) = "." THEN t = LEFT$(t, LEN(t) - 1)
    RETURN t
END FUNCTION

' Was beim Umrechnen verloren geht -- trackerJson fuellt die Liste, in
' derselben Reihenfolge und mit denselben Saetzen wie score/convert.py.
DIM trackerWarnungen AS ARRAY OF STRING : trackerWarnungen = []

FUNCTION trackerJson() AS JSON_HANDLE
    trackerWarnungen = []
    DIM n AS INTEGER : n = nt()
    DIM kanaele AS INTEGER : kanaele = MAX(4, n + 1)     ' + Pflicht-Drum-Kanal, mindestens 4
    DIM gesamt AS INTEGER : gesamt = MAX(1, beatZeile(stueckLaenge()))
    DIM patAnz AS INTEGER : patAnz = (gesamt + MAX_ROWS - 1) \ MAX_ROWS
    ' Gitter: [pattern][kanal][zeile], -2 = leer (null), NOTE_OFF = -1
    DIM patRows AS ARRAY OF INTEGER : patRows = []
    DIM p AS INTEGER
    FOR p = 0 TO patAnz - 1
        ARRAY_PUSH(patRows, MIN(MAX_ROWS, gesamt - p * MAX_ROWS))
    NEXT
    DIM zelle[patAnz, kanaele, MAX_ROWS] AS INTEGER
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR p = 0 TO patAnz - 1
        FOR c = 0 TO kanaele - 1
            FOR r = 0 TO MAX_ROWS - 1
                zelle[p, c, r] = -2
            NEXT
        NEXT
    NEXT
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        ' Akkord-Reduktion je Zeile: nur die hoechste Note bleibt (ein Kanal ist einstimmig).
        DIM besteZeile AS ARRAY OF INTEGER : besteZeile = []
        DIM besteNote AS ARRAY OF INTEGER : besteNote = []
        DIM gruppeBeats AS ARRAY OF STRING : gruppeBeats = []
        DIM gruppeAnz AS ARRAY OF INTEGER : gruppeAnz = []
        DIM vor AS STRING : vor = "Spur " + STR$(i + 1) + " (" + text$(tp$(i, "name")) + "), "
        DIM k AS INTEGER
        FOR k = 0 TO nn(i) - 1
            IF istPause(i, k) THEN CONTINUE
            DIM z AS INTEGER : z = beatZeile(nStart(i, k))
            DIM j AS INTEGER : j = ARRAY_INDEXOF(besteZeile, z)
            IF j < 0 THEN
                ARRAY_PUSH(besteZeile, z) : ARRAY_PUSH(besteNote, k)
                ARRAY_PUSH(gruppeBeats, beat$(nStart(i, k))) : ARRAY_PUSH(gruppeAnz, 1)
            ELSE
                gruppeBeats[j] = gruppeBeats[j] + ", " + beat$(nStart(i, k))
                gruppeAnz[j] = gruppeAnz[j] + 1
                IF nPitch(i, k) > nPitch(i, besteNote[j]) THEN besteNote[j] = k
            END IF
        NEXT
        FOR j = 0 TO LEN(besteZeile) - 1
            IF gruppeAnz[j] > 1 THEN ARRAY_PUSH(trackerWarnungen, vor + "Zeile " + STR$(besteZeile[j]) + " (Beats " + gruppeBeats[j] + "): Akkord auf hoechste Note reduziert (Tracker-Kanal ist einstimmig)")
        NEXT
        ' in Reihenfolge der Zeilen (die Noten sind nach Beginn sortiert, also
        ' sind es die Zeilen auch)
        FOR j = 0 TO LEN(besteZeile) - 1
            k = besteNote[j]
            DIM genau AS FLOAT : genau = nStart(i, k) * ROWS_PER_BEAT
            IF ABS(genau - ROUND(genau)) > 0.000001 THEN ARRAY_PUSH(trackerWarnungen, vor + "Note bei Beat " + beat$(nStart(i, k)) + ": auf die naechste Tracker-Zeile gerundet")
            DIM startZ AS INTEGER : startZ = besteZeile[j]
            DIM endZ AS INTEGER : endZ = beatZeile(nStart(i, k) + nDauer(i, k))
            IF wahr(np$(i, k, "staccato"), FALSE) THEN endZ = MAX(startZ + 1, beatZeile(nStart(i, k) + nDauer(i, k) * 0.5))
            DIM sp AS INTEGER : sp = startZ \ MAX_ROWS
            IF startZ >= gesamt THEN
                ARRAY_PUSH(trackerWarnungen, vor + "Note bei Beat " + beat$(nStart(i, k)) + ": fiel aus dem Song heraus, uebersprungen")
                CONTINUE
            END IF
            zelle[sp, i, startZ - sp * MAX_ROWS] = nPitch(i, k)
            DIM patEnde AS INTEGER : patEnde = sp * MAX_ROWS + patRows[sp]
            IF endZ > patEnde THEN
                ARRAY_PUSH(trackerWarnungen, vor + "Note bei Beat " + beat$(nStart(i, k)) + ": an Pattern-Grenze gekuerzt (Reihe " + STR$(patEnde) + ")")
                CONTINUE
            END IF
            IF endZ < gesamt THEN
                DIM ep AS INTEGER : ep = endZ \ MAX_ROWS
                IF ep < patAnz THEN
                    IF zelle[ep, i, endZ - ep * MAX_ROWS] = -2 THEN zelle[ep, i, endZ - ep * MAX_ROWS] = NOTE_OFF
                END IF
            END IF
        NEXT
    NEXT
    DIM h AS JSON_HANDLE : h = JSON_NEW_OBJECT()
    JSON_SET_STRING(h, "format", "dhtracker-song")
    JSON_SET_INT(h, "version", 1)
    JSON_SET_INT(h, "bpm", bpm())
    JSON_SET_INT(h, "channels", kanaele)
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    FOR c = 0 TO kanaele - 2
        IF c < n THEN
            DIM wf AS STRING : wf = text$(tp$(c, "instrument.waveform"))
            IF wf = "" THEN wf = "square"
            JSON_APPEND_STRING(a, "", wf)
        ELSE
            JSON_APPEND_STRING(a, "", "square")
        END IF
    NEXT
    JSON_SET_JSON(h, "waves", a)
    DIM pats AS JSON_HANDLE : pats = JSON_NEW_ARRAY()
    FOR p = 0 TO patAnz - 1
        DIM po AS JSON_HANDLE : po = JSON_NEW_OBJECT()
        JSON_SET_STRING(po, "name", "P" + STR$(p + 1))
        JSON_SET_INT(po, "rows", patRows[p])
        JSON_SET_INT(po, "channels", kanaele)
        DIM g AS JSON_HANDLE : g = JSON_NEW_ARRAY()
        FOR c = 0 TO kanaele - 1
            DIM col AS JSON_HANDLE : col = JSON_NEW_ARRAY()
            FOR r = 0 TO patRows[p] - 1
                IF zelle[p, c, r] = -2 THEN JSON_APPEND_NULL(col, "") ELSE JSON_APPEND_INT(col, "", zelle[p, c, r])
            NEXT
            JSON_APPEND_JSON(g, "", col)
        NEXT
        JSON_SET_JSON(po, "data", g)
        JSON_APPEND_JSON(pats, "", po)
    NEXT
    JSON_SET_JSON(h, "patterns", pats)
    a = JSON_NEW_ARRAY()
    FOR p = 0 TO patAnz - 1
        JSON_APPEND_INT(a, "", p)
    NEXT
    JSON_SET_JSON(h, "order", a)
    a = JSON_NEW_ARRAY()
    FOR i = 0 TO n - 1
        JSON_APPEND_JSON(a, "", teilbaum(doc, tp$(i, "instrument")))
    NEXT
    JSON_SET_JSON(h, "instruments", a)
    a = JSON_NEW_ARRAY()
    FOR c = 0 TO kanaele - 1
        IF c < n THEN JSON_APPEND_INT(a, "", c) ELSE JSON_APPEND_NULL(a, "")
    NEXT
    JSON_SET_JSON(h, "channel_inst", a)
    RETURN h
END FUNCTION

DIM trackerProzess AS INTEGER : trackerProzess = -1
DIM trackerWartet AS JSON_HANDLE                  ' umgerechnet, noch nicht geschrieben
DIM dlgTracker AS GUI_WINDOW : dlgTracker = 0
CONST WARN_ZEIGEN = 8

FUNCTION trackerPilot$() AS STRING
    DIM k AS STRING
    FOR EACH k IN ("190_tracker.dh", PATHJOIN(GETENV$("DH_IDE_WURZEL"), "examples/190_tracker.dh"), PATHJOIN(GETENV$("DHRT_START_DIR"), "190_tracker.dh"))
        IF k <> "" AND FILEEXISTS(k) THEN RETURN k
    NEXT
    RETURN ""
END FUNCTION

SUB inTrackerOeffnen()
    IF nt() + 1 > 32 THEN
        GUI_SET_TEXT(lblStatus, "Zu viele Spuren fuer den Tracker.")
        RETURN
    END IF
    IF pfad = "" OR geaendert THEN
        IF NOT sichern(FALSE) THEN RETURN
    END IF
    trackerWartet = trackerJson()
    DIM w AS STRING
    FOR EACH w IN trackerWarnungen
        protokoll("warnung " + w)
    NEXT
    IF LEN(trackerWarnungen) = 0 THEN
        trackerSchreiben()
        RETURN
    END IF
    ' Was verloren geht, sagt der Kasten VOR dem Schreiben -- bis dahin
    ' reduzierte der Export einen Akkord auf seine hoechste Note und kuerzte
    ' an der Pattern-Grenze, ohne ein Wort. Je Warnung zwei Zeilen (Ort,
    ' dann was passiert), sonst liefe sie ueber den Rand des Kastens.
    DIM text AS STRING
    text = "Beim Umrechnen geht etwas verloren (" + STR$(LEN(trackerWarnungen)) + "):"
    DIM k AS INTEGER
    FOR k = 0 TO MIN(LEN(trackerWarnungen), WARN_ZEIGEN) - 1
        w = trackerWarnungen[k]
        DIM t AS INTEGER : t = INSTR(w, "): ")
        IF t < 0 THEN t = INSTR(w, ": ") - 1
        text = text + CHR$(10) + LEFT$(w, t + 2) + CHR$(10) + "      " + MID$(w, t + 3)
    NEXT
    IF LEN(trackerWarnungen) > WARN_ZEIGEN THEN text = text + CHR$(10) + "... und " + STR$(LEN(trackerWarnungen) - WARN_ZEIGEN) + " weitere"
    dlgTracker = GUI_DIALOG("Umrechnen in den Tracker", text, "Trotzdem oeffnen|Abbrechen")
END SUB

SUB trackerSchreiben()
    DIM stamm AS STRING : stamm = pfad
    IF LOWER$(RIGHT$(stamm, 5)) = ".json" THEN stamm = LEFT$(stamm, LEN(stamm) - 5)
    DIM ziel AS STRING : ziel = stamm + "_tracker.json"
    DIM h AS JSON_HANDLE : h = trackerWartet
    WRITEALL(ziel, JSON_PRETTY(h))
    protokoll("tracker " + ziel + " " + STR$(JSON_LEN(h, "patterns")))
    DIM pilot AS STRING : pilot = trackerPilot$()
    IF pilot = "" THEN
        GUI_SET_TEXT(lblStatus, "Tracker-Projekt geschrieben: " + ziel + " (den Tracker-Piloten daneben nicht gefunden).")
        RETURN
    END IF
    IF trackerProzess >= 0 THEN PROCESS_CLOSE(trackerProzess)
    trackerProzess = PROCESS_START("dhrt", "run", pilot, "--", ziel)
    GUI_SET_TEXT(lblStatus, "Tracker geoeffnet mit " + BASENAME(ziel))
END SUB

' --- Datei ---------------------------------------------------------------------
SUB nachLaden()
    IF NOT JSON_HAS(doc, "tracks") THEN JSON_SET_JSON(doc, "tracks", JSON_NEW_ARRAY())
    IF nt() = 0 THEN spurAnlegen()
    DIM i AS INTEGER
    FOR i = 0 TO nt() - 1
        IF NOT JSON_HAS(doc, tp$(i, "notes")) THEN JSON_SET_JSON(doc, tp$(i, "notes"), JSON_NEW_ARRAY())
        IF NOT JSON_HAS(doc, tp$(i, "instrument")) THEN JSON_SET_JSON(doc, tp$(i, "instrument"), presetJson(0))
        IF text$(tp$(i, "clef")) = "" THEN JSON_SET_STRING(doc, tp$(i, "clef"), "treble")
        IF text$(tp$(i, "name")) = "" THEN JSON_SET_STRING(doc, tp$(i, "name"), "Stimme " + STR$(i + 1))
        notenSortieren(i)
    NEXT
    IF NOT JSON_HAS(doc, "format") THEN JSON_SET_STRING(doc, "format", "dhscore-song")
    IF NOT JSON_HAS(doc, "version") THEN JSON_SET_INT(doc, "version", 1)
    IF NOT JSON_HAS(doc, "bpm") THEN JSON_SET_INT(doc, "bpm", 120)
    IF NOT JSON_HAS(doc, "time_sig") THEN JSON_SET_JSON(doc, "time_sig", JSON_PARSE("[4, 4]"))
    IF spielt THEN stopp()
    scrollX = 0 : scrollY = 0
    staende = [] : standPos = -1
    merken()
    geaendert = FALSE
    spurenAnzeigen()
END SUB

SUB neuesStueck()
    doc = JSON_NEW_OBJECT()
    pfad = ""
    nachLaden()
    GUI_SET_TEXT(lblStatus, "Neues Stück.")
    protokoll("neues stueck")
END SUB

SUB laden(p AS STRING)
    IF NOT FILEEXISTS(p) THEN
        neuesStueck()
        pfad = p
        GUI_SET_TEXT(lblStatus, "Neu: " + p)
        protokoll("neu-datei " + p)
        RETURN
    END IF
    doc = JSON_LOAD(p)
    pfad = p
    nachLaden()
    GUI_SET_TEXT(lblStatus, "Geladen: " + p + " (" + STR$(nt()) + " Spuren, " + STR$(notenGesamt()) + " Noten)")
    protokoll("geladen " + STR$(nt()) + " " + STR$(notenGesamt()))
END SUB

FUNCTION sichern(alsNeu AS BOOLEAN) AS BOOLEAN
    IF pfad = "" OR alsNeu THEN
        DIM p AS STRING : p = FILE_SAVE_DIALOG("Stueck sichern", "stueck.json", "json")
        IF p = "" THEN RETURN FALSE
        pfad = p
    END IF
    WRITEALL(pfad, JSON_PRETTY(doc))
    geaendert = FALSE
    GUI_SET_TEXT(lblStatus, "Gesichert: " + pfad)
    protokoll("gesichert " + pfad)
    RETURN TRUE
END FUNCTION

SUB standHolen()
    doc = JSON_PARSE(staende[standPos])
    spurenAnzeigen()
END SUB

SUB rueckgaengig()
    IF standPos <= 0 THEN RETURN
    standPos = standPos - 1
    standHolen()
    protokoll("rueckgaengig " + STR$(notenGesamt()))
END SUB

SUB wiederholen()
    IF standPos >= LEN(staende) - 1 THEN RETURN
    standPos = standPos + 1
    standHolen()
    protokoll("wiederholen " + STR$(notenGesamt()))
END SUB

' --- Maus auf dem Blatt ---------------------------------------------------------
DIM zugSpur AS INTEGER : zugSpur = -1
DIM zugNote AS INTEGER : zugNote = -1
DIM zugBewegt AS BOOLEAN : zugBewegt = FALSE
DIM zugAlt AS FLOAT : zugAlt = 0.0
DIM ankerSpur AS INTEGER : ankerSpur = -1        ' Bindebogen: erste Note
DIM ankerBeat AS FLOAT : ankerBeat = 0.0
DIM hoverSpur AS INTEGER : hoverSpur = -1
DIM hoverBeat AS FLOAT : hoverBeat = 0.0
DIM hoverPitch AS INTEGER : hoverPitch = 0
DIM hoverPause AS BOOLEAN : hoverPause = FALSE

FUNCTION imBlatt(mx AS INTEGER, my AS INTEGER) AS BOOLEAN
    RETURN mx >= gx0 AND my >= TOP_B AND my < SCREENHEIGHT() - PIANO_H
END FUNCTION

FUNCTION spurBei(my AS INTEGER) AS INTEGER
    DIM i AS INTEGER : i = (my - gy0 + scrollY) \ STAFF_H
    IF my - gy0 + scrollY < 0 THEN RETURN -1
    IF i < 0 OR i >= nt() THEN RETURN -1
    RETURN i
END FUNCTION

SUB mausAufBlatt()
    DIM mx AS INTEGER : mx = MOUSEX()
    DIM my AS INTEGER : my = MOUSEY()
    hoverSpur = -1
    IF zugNote < 0 AND imBlatt(mx, my) AND NOT GUI_MODAL() THEN
        DIM i AS INTEGER : i = spurBei(my)
        IF i >= 0 THEN
            DIM beat AS FLOAT : beat = rastern(beatBeiX(mx))
            IF entryModus <= 1 THEN
                hoverSpur = i : hoverBeat = beat : hoverPause = entryModus = 1
                IF NOT hoverPause THEN hoverPitch = pitchBeiY(i, my, entryAcc)
            END IF
            DIM k AS INTEGER : k = noteBei(i, beat)
            IF MOUSE_HIT(RECHTS) THEN
                GUI_FOCUS(-1)
                IF entryModus = 2 THEN
                    boegenWeg(i, beat) : merken()
                    protokoll("bogen weg " + STR$(i) + " " + zahl$(beat))
                ELSEIF k >= 0 THEN
                    noteEntfernen(i, k) : merken() : spurenAnzeigen()
                    protokoll("entfernt " + STR$(i) + " " + zahl$(beat))
                END IF
                RETURN
            END IF
            IF MOUSE_HIT(LINKS) THEN
                GUI_FOCUS(-1)      ' Tastatur (Leertaste) zum Blatt, nicht in ein Feld
                IF entryModus = 3 THEN
                    IF k >= 0 AND NOT istPause(i, k) THEN
                        DIM z AS INTEGER : z = GUI_DROPDOWN_SELECTED(ddFinger) + 1
                        IF ganz(np$(i, k, "fingering"), 0) = z THEN
                            JSON_REMOVE(doc, np$(i, k, "fingering")) : z = 0
                        ELSE
                            JSON_SET_INT(doc, np$(i, k, "fingering"), z)
                        END IF
                        merken()
                        protokoll("finger " + STR$(i) + " " + zahl$(beat) + " " + STR$(z))
                    END IF
                ELSEIF entryModus = 4 THEN
                    IF k >= 0 AND NOT istPause(i, k) THEN
                        DIM an AS BOOLEAN : an = NOT wahr(np$(i, k, "staccato"), FALSE)
                        IF an THEN JSON_SET_BOOL(doc, np$(i, k, "staccato"), TRUE) ELSE JSON_REMOVE(doc, np$(i, k, "staccato"))
                        merken()
                        protokoll("staccato " + STR$(i) + " " + zahl$(beat) + " " + IIF(an, "an", "aus"))
                    END IF
                ELSEIF entryModus = 2 THEN
                    IF k < 0 THEN
                        ankerSpur = -1
                    ELSEIF ankerSpur <> i OR ABS(ankerBeat - beat) < 0.000001 THEN
                        IF ankerSpur = i THEN
                            ankerSpur = -1
                        ELSE
                            ankerSpur = i : ankerBeat = beat
                        END IF
                    ELSE
                        bogenHinzu(i, ankerBeat, beat)
                        merken()
                        protokoll("bogen " + STR$(i) + " " + zahl$(MIN(ankerBeat, beat)) + " " + zahl$(MAX(ankerBeat, beat)))
                        ankerSpur = -1
                    END IF
                ELSEIF k >= 0 THEN
                    zugSpur = i : zugNote = k : zugBewegt = FALSE : zugAlt = nStart(i, k)
                ELSEIF entryModus = 1 THEN
                    setzen(i, beat, 0, TRUE)
                    eingabeSpur = i : eingabeBeat = beat + entryDauer
                ELSE
                    DIM gp AS INTEGER : gp = pitchBeiY(i, my, entryAcc)
                    setzen(i, beat, gp, FALSE)
                    vorhoeren(i, gp)
                    ' Die Eingabemarke folgt dem Klick -- ab hier geht es per
                    ' Tastatur weiter.
                    eingabeSpur = i : eingabeBeat = beat + entryDauer : letzterPitch = gp
                END IF
                RETURN
            END IF
        END IF
    END IF
    IF zugNote >= 0 AND MOUSEBUTTON(LINKS) THEN
        DIM beat2 AS FLOAT : beat2 = rastern(beatBeiX(mx))
        IF ABS(beat2 - nStart(zugSpur, zugNote)) > 0.000001 THEN
            JSON_SET_FLOAT(doc, np$(zugSpur, zugNote, "start"), beat2)
            zugBewegt = TRUE
        END IF
        IF NOT istPause(zugSpur, zugNote) THEN
            DIM p2 AS INTEGER : p2 = pitchBeiY(zugSpur, my, entryAcc)
            IF p2 <> nPitch(zugSpur, zugNote) THEN
                JSON_SET_INT(doc, np$(zugSpur, zugNote, "pitch"), p2)
                IF entryAcc <> 1 THEN JSON_SET_INT(doc, np$(zugSpur, zugNote, "accidental"), entryAcc) ELSE JSON_REMOVE(doc, np$(zugSpur, zugNote, "accidental"))
                zugBewegt = TRUE
            END IF
        END IF
        RETURN
    END IF
    IF zugNote >= 0 AND NOT MOUSEBUTTON(LINKS) THEN
        DIM i2 AS INTEGER : i2 = zugSpur
        DIM k2 AS INTEGER : k2 = zugNote
        zugNote = -1 : zugSpur = -1
        IF zugBewegt THEN
            DIM neu AS FLOAT : neu = nStart(i2, k2)
            ' eine ANDERE Note an der Zielstelle wird ersetzt (wie beim Neu-Setzen)
            DIM j AS INTEGER
            FOR j = nn(i2) - 1 TO 0 STEP -1
                IF j <> k2 AND ABS(nStart(i2, j) - neu) < 0.000001 THEN
                    noteEntfernen(i2, j)
                    IF j < k2 THEN k2 = k2 - 1
                END IF
            NEXT
            boegenVerschieben(i2, zugAlt, neu)
            DIM ph AS STRING : ph = IIF(istPause(i2, k2), "pause", STR$(nPitch(i2, k2)))
            notenSortieren(i2)
            merken()
            protokoll("bewegt " + STR$(i2) + " " + zahl$(neu) + " " + ph)
        ELSE
            DIM beat3 AS FLOAT : beat3 = nStart(i2, k2)
            noteEntfernen(i2, k2)
            merken()
            protokoll("entfernt " + STR$(i2) + " " + zahl$(beat3))
        END IF
        spurenAnzeigen()
    END IF
END SUB

' --- Zeichnen -------------------------------------------------------------------
CONST F_TEXT = &HD8E4F0
CONST F_LINIE = &H6E8494
CONST F_BAND = &H121C28
CONST F_VORZ = &HFFB74D
CONST F_KOPF = &HFF5A5A

DIM balken AS ARRAY OF BOOLEAN : balken = []

SUB hilfslinien(i AS INTEGER, x AS INTEGER, s AS INTEGER, farbe AS INTEGER)
    DIM l AS INTEGER
    IF s > 8 THEN
        FOR l = 10 TO s STEP 2
            LINE(x - NOTE_R - HALB \ 2, yStufe(i, l), x + NOTE_R + HALB \ 2, yStufe(i, l), farbe)
        NEXT
    ELSEIF s < 0 THEN
        FOR l = -2 TO s STEP -2
            LINE(x - NOTE_R - HALB \ 2, yStufe(i, l), x + NOTE_R + HALB \ 2, yStufe(i, l), farbe)
        NEXT
    END IF
END SUB

' --- Die Notenschrift --------------------------------------------------------
' Die Masse jeder Glyphe in Font-Einheiten (1000 je Em): links, unten,
' rechts, oben. Sie kommen aus der Datei selbst -- FONT_GLYPH_BOX bei
' Groesse 1787 (Oberlaenge 1389 minus Unterlaenge -398) liefert sie 1:1 in
' Einheiten, gezaehlt von der Oberkante der Zeile. Ein Notenkopf ist 270
' Einheiten hoch = ein Linienabstand; daraus folgt der Massstab.
DIM gMasse AS MAP OF FLOAT
FUNCTION gBox(cp AS INTEGER, welche AS INTEGER) AS FLOAT
    DIM k AS STRING : k = STR$(cp) + ":" + STR$(welche)
    IF MAPHAS(gMasse, k) THEN RETURN MAPGET(gMasse, k)
    DIM b AS TUPLE : b = FONT_GLYPH_BOX(musikFont, CHR$(cp), 1787)
    DIM oben AS FLOAT : oben = 1389 - b[1]
    MAPPUT(gMasse, STR$(cp) + ":0", b[0])
    MAPPUT(gMasse, STR$(cp) + ":1", oben - b[3])
    MAPPUT(gMasse, STR$(cp) + ":2", b[0] + b[2])
    MAPPUT(gMasse, STR$(cp) + ":3", oben)
    RETURN MAPGET(gMasse, k)
END FUNCTION

' Pixel je Font-Einheit bei einem Linienabstand von `halb` * 2.
FUNCTION gEinheit(halb AS INTEGER) AS FLOAT
    RETURN halb * 2 / 268.0
END FUNCTION

' Eine Glyphe so setzen, dass der Punkt (ex, ey) in Font-Einheiten auf
' (x, y) im Bild faellt. raylib setzt Text an der OBERKANTE der Zeile, und
' die liegt `Ascent` (1389 Einheiten) ueber der Grundlinie.
SUB glyphAn(cp AS INTEGER, ex AS FLOAT, ey AS FLOAT, x AS FLOAT, y AS FLOAT, halb AS INTEGER, farbe AS INTEGER)
    DIM e AS FLOAT : e = gEinheit(halb)
    SETFONT(musikFont, INT(1787 * e + 0.5))
    TEXT(INT(x - ex * e + 0.5), INT(y - (1389 - ey) * e + 0.5), CHR$(cp), farbe)
END SUB

' Waagerecht mittig, senkrecht der Punkt `ey` (Font-Einheiten) auf y.
SUB glyphMitte(cp AS INTEGER, x AS FLOAT, y AS FLOAT, ey AS FLOAT, halb AS INTEGER, farbe AS INTEGER)
    glyphAn(cp, (gBox(cp, 0) + gBox(cp, 2)) / 2.0, ey, x, y, halb, farbe)
END SUB

FUNCTION gBreite(cp AS INTEGER) AS INTEGER
    RETURN INT((gBox(cp, 2) - gBox(cp, 0)) * gEinheit(HALB) + 0.5)
END FUNCTION

SUB notenkopf(x AS INTEGER, y AS INTEGER, d AS FLOAT, farbe AS INTEGER)
    IF musikFont >= 0 THEN
        DIM cp AS INTEGER : cp = G_KOPF_VOLL
        IF d >= 2.0 THEN cp = G_KOPF_LEER
        IF d >= 4.0 THEN cp = G_GANZE
        glyphMitte(cp, x, y, (gBox(cp, 1) + gBox(cp, 3)) / 2.0, HALB, farbe)
        RETURN
    END IF
    IF d < 2.0 THEN
        CIRCLE(x, y, NOTE_R, farbe)
    ELSE
        CIRCLEOUTLINE(x, y, NOTE_R, farbe)
        CIRCLEOUTLINE(x, y, NOTE_R - 1, farbe)
    END IF
END SUB

' Eine Pause nach ihrer Dauer: die ganze haengt an der vierten Linie, die
' halbe sitzt auf der Mittellinie, die uebrigen stehen um sie herum.
SUB pauseZeichnen(i AS INTEGER, x AS INTEGER, d AS FLOAT, farbe AS INTEGER)
    IF musikFont < 0 THEN
        DIM y AS INTEGER : y = yStufe(i, 4)
        RECT(x - 5, y - 3, x + 5, y + 3, farbe)
        RECT(x - 4, y - 2, x + 4, y + 2, farbe)
        RETURN
    END IF
    DIM basis AS FLOAT : basis = d
    IF punktiert(d) THEN basis = d / 1.5
    IF basis >= 4.0 THEN
        glyphMitte(G_P_GANZ, x, yStufe(i, 6), 512, HALB, farbe)
    ELSEIF basis >= 2.0 THEN
        glyphMitte(G_P_HALB, x, yStufe(i, 4), 244, HALB, farbe)
    ELSEIF basis >= 1.0 THEN
        glyphMitte(G_P_VIERTEL, x, yStufe(i, 4), 500, HALB, farbe)
    ELSEIF basis >= 0.5 THEN
        glyphMitte(G_P_ACHTEL, x, yStufe(i, 4), 500, HALB, farbe)
    ELSE
        glyphMitte(G_P_16, x, yStufe(i, 4), 500, HALB, farbe)
    END IF
    IF punktiert(d) THEN CIRCLE(x + HALB * 2, yStufe(i, 5), MAX(2, HALB \ 3), farbe)
END SUB

' Punktiert ist eine Dauer, die das Anderthalbfache einer Grunddauer ist.
FUNCTION punktiert(d AS FLOAT) AS BOOLEAN
    DIM g AS FLOAT
    FOR EACH g IN [4.0, 2.0, 1.0, 0.5, 0.25]
        IF ABS(d - g * 1.5) < 0.000001 THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Balkengruppen: zusammenhaengende Achtel/Sechzehntel GLEICHER Dauer im
' selben Beat -- markiert die Noten und zeichnet den Balken.
SUB balkenZeichnen(i AS INTEGER, farbe AS INTEGER)
    DIM n AS INTEGER : n = nn(i)
    balken = []
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        ARRAY_PUSH(balken, FALSE)
    NEXT
    DIM gruppe AS ARRAY OF INTEGER : gruppe = []
    DIM kand AS ARRAY OF INTEGER : kand = []
    FOR k = 0 TO n - 1
        IF NOT istPause(i, k) AND nDauer(i, k) <= 0.5 THEN ARRAY_PUSH(kand, k)
    NEXT
    DIM q AS INTEGER
    FOR q = 0 TO LEN(kand)          ' ein Schritt mehr: die letzte Gruppe abschliessen
        DIM passt AS BOOLEAN : passt = FALSE
        IF q < LEN(kand) AND LEN(gruppe) > 0 THEN
            DIM v AS INTEGER : v = gruppe[LEN(gruppe) - 1]
            DIM w AS INTEGER : w = kand[q]
            passt = INT(nStart(i, v)) = INT(nStart(i, w)) AND ABS(nStart(i, v) + nDauer(i, v) - nStart(i, w)) < 0.000001 AND ABS(nDauer(i, v) - nDauer(i, w)) < 0.000001
        END IF
        IF passt THEN
            ARRAY_PUSH(gruppe, kand[q])
        ELSE
            IF LEN(gruppe) >= 2 THEN
                DIM summe AS INTEGER : summe = 0
                DIM minY AS INTEGER : minY = 100000
                DIM maxY AS INTEGER : maxY = -100000
                DIM g AS INTEGER
                FOR g = 0 TO LEN(gruppe) - 1
                    DIM s AS INTEGER : s = stufe(i, nPitch(i, gruppe[g]))
                    summe = summe + s
                    minY = MIN(minY, yStufe(i, s)) : maxY = MAX(maxY, yStufe(i, s))
                    balken[gruppe[g]] = TRUE
                NEXT
                DIM oben AS BOOLEAN : oben = summe / LEN(gruppe) < MID_STEP
                DIM by AS INTEGER : by = IIF(oben, minY - STEM_LEN, maxY + STEM_LEN)
                DIM dx AS INTEGER : dx = IIF(oben, NOTE_R - 1, -NOTE_R)
                FOR g = 0 TO LEN(gruppe) - 1
                    DIM x AS INTEGER : x = xBeat(nStart(i, gruppe[g])) + dx
                    LINEW(x, yStufe(i, stufe(i, nPitch(i, gruppe[g]))), x, by, MAX(1, HALB \ 5), farbe)
                NEXT
                DIM x0 AS INTEGER : x0 = xBeat(nStart(i, gruppe[0])) + dx
                DIM x1 AS INTEGER : x1 = xBeat(nStart(i, gruppe[LEN(gruppe) - 1])) + dx
                DIM nb AS INTEGER : nb = IIF(nDauer(i, gruppe[0]) <= 0.25, 2, 1)
                DIM b AS INTEGER
                FOR b = 0 TO nb - 1
                    DIM bd AS INTEGER : bd = MAX(3, HALB * 2 \ 3)
                    LINEW(x0, by + b * IIF(oben, bd + 2, -bd - 2), x1, by + b * IIF(oben, bd + 2, -bd - 2), bd, farbe)
                NEXT
            END IF
            gruppe = []
            IF q < LEN(kand) THEN ARRAY_PUSH(gruppe, kand[q])
        END IF
    NEXT
END SUB

SUB noteZeichnen(i AS INTEGER, k AS INTEGER, farbe AS INTEGER)
    DIM x AS INTEGER : x = xBeat(nStart(i, k))
    IF istPause(i, k) THEN
        pauseZeichnen(i, x, nDauer(i, k), farbe)
        RETURN
    END IF
    DIM p AS INTEGER : p = nPitch(i, k)
    DIM s AS INTEGER : s = stufe(i, p)
    DIM y AS INTEGER : y = yStufe(i, s)
    DIM d AS FLOAT : d = nDauer(i, k)
    hilfslinien(i, x, s, F_LINIE)
    notenkopf(x, y, d, farbe)
    ' Der Punkt der punktierten Note steht rechts im Zwischenraum -- liegt
    ' der Kopf auf einer Linie, im Raum darueber.
    IF punktiert(d) THEN CIRCLE(x + NOTE_R + HALB, y - IIF(s MOD 2 = 0, HALB, 0), MAX(2, HALB \ 3), farbe)
    DIM oben AS BOOLEAN : oben = s < MID_STEP
    ' Der Hals sitzt am Rand des Kopfs: rechts nach oben, links nach unten.
    DIM sx AS INTEGER : sx = IIF(oben, x + NOTE_R - 1, x - NOTE_R)
    IF d < 4.0 AND NOT balken[k] THEN
        DIM fy AS INTEGER : fy = IIF(oben, y - STEM_LEN, y + STEM_LEN)
        LINEW(sx, y, sx, fy, MAX(1, HALB \ 5), farbe)
        IF d <= 0.75 THEN
            ' Faehnchen als geschwungene Linie, eins je halbierter Dauer.
            DIM nf AS INTEGER : nf = IIF(d <= 0.375, 2, 1)
            DIM f AS INTEGER
            FOR f = 0 TO nf - 1
                DIM r AS INTEGER : r = IIF(oben, 1, -1)
                DIM f0 AS INTEGER : f0 = fy + f * HALB * r
                DIM fxs AS ARRAY OF INTEGER : fxs = [sx, sx + HALB \ 2, sx + HALB + HALB \ 2, sx + HALB]
                DIM fys AS ARRAY OF INTEGER : fys = [f0, f0 + HALB * r, f0 + HALB * 2 * r, f0 + HALB * 3 * r]
                SPLINE(fxs, fys, farbe, MAX(2, HALB \ 3))
            NEXT
        END IF
    END IF
    IF hatVorzeichen(p) THEN
        IF ganz(np$(i, k, "accidental"), 1) = -1 THEN bZeichen(x - NOTE_R - HALB - 3, y, F_VORZ) ELSE kreuz(x - NOTE_R - HALB - 3, y, F_VORZ)
    END IF
    IF wahr(np$(i, k, "staccato"), FALSE) THEN CIRCLE(x, IIF(oben, y + NOTE_R + 7, y - NOTE_R - 7), 3, farbe)
    DIM fz AS INTEGER : fz = ganz(np$(i, k, "fingering"), 0)
    IF fz > 0 THEN
        SETFONT(uiFont, 13)
        TEXT(x - 4, y - STEM_LEN - 22, STR$(fz), F_TEXT)
        SETFONT(uiFont, 15)
    END IF
END SUB

SUB bogenZeichnen(xa AS INTEGER, ya AS INTEGER, xb AS INTEGER, yb AS INTEGER, farbe AS INTEGER)
    DIM dx AS INTEGER : dx = xb - xa
    DIM hub AS INTEGER : hub = CLAMP(INT(ABS(dx) * 0.3), 10, 26)
    DIM top AS INTEGER : top = MIN(ya, yb) - hub
    DIM xs AS ARRAY OF INTEGER : xs = [xa, xa + INT(dx * 0.3), xa + INT(dx * 0.7), xb]
    DIM ys AS ARRAY OF INTEGER : ys = [ya - 4, top, top, yb - 4]
    SPLINE(xs, ys, farbe, 2)
END SUB

' Ein Violinschluessel als Kurve durch feste Punkte (Linienabstand 14 px):
' Schleife um die G-Linie, Stiel nach oben mit Haken, kleine Schnecke unten.
SUB violinschluessel(cx AS INTEGER, yBot AS INTEGER, farbe AS INTEGER)
    DIM xs AS ARRAY OF INTEGER : xs = [cx - 2, cx + 7, cx + 3, cx - 9, cx - 8, cx + 4, cx + 12, cx + 4, cx - 6, cx - 2, cx + 8, cx + 4, cx - 6, cx - 4, cx]
    DIM ys AS ARRAY OF INTEGER : ys = [yBot + 16, yBot + 12, yBot + 2, yBot - 8, yBot - 22, yBot - 28, yBot - 18, yBot - 10, yBot - 24, yBot - 50, yBot - 68, yBot - 82, yBot - 66, yBot - 30, yBot + 10]
    SPLINE(xs, ys, farbe, 2)
    CIRCLE(cx - 2, yBot + 16, 3, farbe)
END SUB

' Ein Bassschluessel: Punkt auf der F-Linie, Bogen nach rechts unten, zwei Punkte.
SUB bassschluessel(cx AS INTEGER, yBot AS INTEGER, farbe AS INTEGER)
    DIM xs AS ARRAY OF INTEGER : xs = [cx - 8, cx - 2, cx + 6, cx + 8, cx + 2, cx - 8]
    DIM ys AS ARRAY OF INTEGER : ys = [yBot - 42, yBot - 58, yBot - 49, yBot - 35, yBot - 17, yBot - 6]
    SPLINE(xs, ys, farbe, 2)
    CIRCLE(cx - 8, yBot - 42, 4, farbe)
    CIRCLE(cx + 15, yBot - 49, 2, farbe)
    CIRCLE(cx + 15, yBot - 35, 2, farbe)
END SUB

SUB kreuz(x AS INTEGER, y AS INTEGER, farbe AS INTEGER)
    IF musikFont >= 0 THEN
        glyphMitte(G_KREUZ, x, y, 131, HALB, farbe)
        RETURN
    END IF
    LINE(x - 3, y - 9, x - 3, y + 9, farbe)
    LINE(x + 3, y - 10, x + 3, y + 8, farbe)
    LINEW(x - 7, y - 2, x + 7, y - 5, 2, farbe)
    LINEW(x - 7, y + 5, x + 7, y + 2, 2, farbe)
END SUB

SUB bZeichen(x AS INTEGER, y AS INTEGER, farbe AS INTEGER)
    IF musikFont >= 0 THEN
        glyphMitte(G_BE, x, y, 134, HALB, farbe)
        RETURN
    END IF
    LINE(x - 3, y - 14, x - 3, y + 5, farbe)
    DIM xs AS ARRAY OF INTEGER : xs = [x - 3, x + 3, x + 2, x - 3]
    DIM ys AS ARRAY OF INTEGER : ys = [y - 3, y - 2, y + 3, y + 5]
    SPLINE(xs, ys, farbe, 2)
END SUB

SUB spurZeichnen(i AS INTEGER)
    DIM oben AS INTEGER : oben = spurOben(i)
    IF oben + STAFF_H < TOP_B OR oben > SCREENHEIGHT() THEN RETURN
    DIM farbe AS INTEGER : farbe = spurFarbe(i)
    DIM yTop AS INTEGER : yTop = yStufe(i, 8)
    DIM yBot AS INTEGER : yBot = yStufe(i, 0)
    DIM breite AS INTEGER : breite = SCREENWIDTH()
    DIM takte AS INTEGER : takte = INT(MAX(8.0, spurLaenge(i) + 4.0) / 4) + 1 + scrollX \ (PPB * 4)
    DIM m AS INTEGER
    FOR m = 0 TO takte STEP 2
        BOX(MAX(gx0 + LEFT_MARGIN - 10, xBeat(m * 4.0)), yTop - 20, xBeat((m + 1) * 4.0), yBot + 20, F_BAND)
    NEXT
    DIM l AS INTEGER
    FOR l = 0 TO 4
        LINE(gx0 + LEFT_MARGIN - 14, yStufe(i, l * 2), breite, yStufe(i, l * 2), F_LINIE)
    NEXT
    SETFONT(uiFont, 12)
    FOR m = 1 TO takte
        DIM bx AS INTEGER : bx = xBeat(m * 4.0) - BARLINE_LEAD
        IF bx > gx0 + LEFT_MARGIN THEN
            LINE(bx, yTop, bx, yBot, F_LINIE)
            ' Taktnummer ueber dem Strich: der Takt, der hier beginnt.
            TEXT(bx + 3, yTop - HALB * 2 - 12, STR$(m + 1), &H5E7088)
        END IF
    NEXT
    SETFONT(uiFont, 15)
    ' Schluessel und Taktart. Mit der Notenschrift aus ihr (der G-Schluessel
    ' sitzt mit seiner Grundlinie auf der G-Linie, der F-Schluessel mit
    ' seinen Punkten um die F-Linie), sonst die gezeichnete Kurve.
    BOX(gx0, yTop - 30, gx0 + LEFT_MARGIN - 16, yBot + 30, &H0B1119)
    DIM bass AS BOOLEAN : bass = text$(tp$(i, "clef")) = "bass"
    IF musikFont >= 0 THEN
        IF bass THEN
            glyphAn(F_SCHLUESSEL, gBox(F_SCHLUESSEL, 0), 512, gx0 + HALB * 2, yStufe(i, 6), HALB, farbe)
        ELSE
            glyphAn(G_SCHLUESSEL, gBox(G_SCHLUESSEL, 0), 244, gx0 + HALB * 2, yStufe(i, 2), HALB, farbe)
        END IF
    ELSEIF bass THEN
        bassschluessel(gx0 + 26, yBot, farbe)
    ELSE
        violinschluessel(gx0 + 30, yBot, farbe)
    END IF
    ' Die Taktart (das Format kennt nur 4/4): zwei Ziffern, je zwei
    ' Linienabstaende hoch, eine ueber und eine unter der Mittellinie.
    SETFONT(fettFont, HALB * 5)
    DIM tx AS INTEGER : tx = gx0 + LEFT_MARGIN - HALB * 5
    DIM zb AS INTEGER : zb = TEXT_WIDTH("4") \ 2
    TEXT(tx - zb, yStufe(i, 8) - HALB + 1, "4", F_TEXT)
    TEXT(tx - zb, yStufe(i, 4) - HALB + 1, "4", F_TEXT)
    SETFONT(uiFont, 15)
    ' Bindeboegen
    IF JSON_HAS(doc, tp$(i, "slurs")) THEN
        DIM b AS INTEGER
        FOR b = 0 TO JSON_LEN(doc, tp$(i, "slurs")) - 1
            DIM sp AS STRING : sp = tp$(i, "slurs." + STR$(b))
            DIM a1 AS FLOAT : a1 = komma(sp + ".0", 0.0)
            DIM a2 AS FLOAT : a2 = komma(sp + ".1", 0.0)
            DIM k1 AS INTEGER : k1 = noteBei(i, a1)
            DIM k2 AS INTEGER : k2 = noteBei(i, a2)
            DIM y1 AS INTEGER : y1 = IIF(k1 >= 0, yNote(i, k1), yStufe(i, 4))
            DIM y2 AS INTEGER : y2 = IIF(k2 >= 0, yNote(i, k2), yStufe(i, 4))
            bogenZeichnen(xBeat(a1), y1, xBeat(a2), y2, farbe)
        NEXT
    END IF
    balkenZeichnen(i, farbe)
    DIM k AS INTEGER
    FOR k = 0 TO nn(i) - 1
        noteZeichnen(i, k, farbe)
    NEXT
    ' Bogen-Anker
    IF ankerSpur = i THEN
        DIM ka AS INTEGER : ka = noteBei(i, ankerBeat)
        IF ka >= 0 THEN CIRCLEOUTLINE(xBeat(ankerBeat), yNote(i, ka), NOTE_R + 5, F_TEXT)
    END IF
    ' Spielkopf
    IF spielt THEN
        DIM px AS INTEGER : px = xBeat(AUDIO_CLOCK_TICKS(takt) / (ROWS_PER_BEAT * 1.0))
        LINEW(px, yTop - 12, px, yBot + 12, 2, F_KOPF)
    END IF
    ' Vorschau an der Maus
    IF hoverSpur = i THEN
        DIM hx AS INTEGER : hx = xBeat(hoverBeat)
        LINE(hx, yTop - 18, hx, yBot + 18, &H3A4A5C)
        IF hoverPause THEN
            pauseZeichnen(i, hx, entryDauer, &H7A8E96)
        ELSE
            DIM hs AS INTEGER : hs = stufe(i, hoverPitch)
            hilfslinien(i, hx, hs, &H3A4A5C)
            notenkopf(hx, yStufe(i, hs), entryDauer, &H5A6A7B)
        END IF
    END IF
    ' Die Eingabemarke: wo die naechste getippte Note hinkommt.
    IF eingabeSpur = i THEN
        DIM ex AS INTEGER : ex = xBeat(eingabeBeat) - NOTE_R - 3
        LINEW(ex, yTop - HALB * 2, ex, yBot + HALB * 2, 2, &H4FC8F0)
        TRIANGLE(ex - 5, yTop - HALB * 2 - 7, ex + 5, yTop - HALB * 2 - 7, ex, yTop - HALB * 2, &H4FC8F0)
    END IF
    SETFONT(uiFont, 13)
    TEXT(gx0 + LEFT_MARGIN, yBot + HALB * 6, text$(tp$(i, "name")) + "  ·  " + text$(tp$(i, "instrument.name")), farbe)
    SETFONT(uiFont, 15)
END SUB

SUB blattZeichnen()
    SCISSOR(gx0, TOP_B, SCREENWIDTH() - gx0, SCREENHEIGHT() - TOP_B)
    BOX(gx0, TOP_B, SCREENWIDTH(), SCREENHEIGHT(), &H0B1119)
    DIM i AS INTEGER
    FOR i = 0 TO nt() - 1
        spurZeichnen(i)
    NEXT
    SCISSOR_END()
END SUB

' --- Zoom ---------------------------------------------------------------------
' Die Lage der Spuren-Bedienelemente links haengt an STAFF_H -- nach dem
' Zoom ziehen sie mit. Der Rollstand wird mitgerechnet, damit dieselbe
' Stelle im Bild bleibt.
SUB zoomSetzen(z AS FLOAT)
    DIM alt AS FLOAT : alt = zoom
    zoomRechnen(z)
    IF alt > 0.0 THEN
        scrollX = INT(scrollX * zoom / alt)
        scrollY = INT(scrollY * zoom / alt)
    END IF
    spurenAnzeigen()
    IF zoomVonHand THEN GUI_SET_TEXT(lblStatus, "Zoom " + STR$(INT(zoom * 100 + 0.5)) + " %")
    protokoll("zoom " + STR$(INT(zoom * 100 + 0.5)))
END SUB

' --- Eingabe per Tastatur und Klaviatur ----------------------------------------
' Eine Eingabemarke (blauer Strich) zeigt, wo die naechste Note hinkommt.
' Buchstaben setzen dort eine Note und ruecken weiter: C D E F G A H (B =
' das deutsche B, ein Halbton unter H), P eine Pause, 1..5 waehlen die Dauer
' (Ganze..Sechzehntel), der Punkt punktiert. Pfeil hoch/runter verschiebt
' die Note VOR der Marke um einen Halbton (mit Strg um eine Oktave),
' Pfeil links/rechts bewegt die Marke, die Ruecktaste nimmt die letzte
' Note weg. Die Oktave folgt der vorigen Note -- der naechstgelegene Ton
' dieses Namens wird es, wie beim Notieren von Hand.
DIM eingabeSpur AS INTEGER : eingabeSpur = 0
DIM eingabeBeat AS FLOAT : eingabeBeat = 0.0
DIM letzterPitch AS INTEGER : letzterPitch = -1

SUB vorhoeren(i AS INTEGER, midi AS INTEGER)
    TRY
        AUDIO_PLAY(klang(i, midi, 450), 0, 0.8)
    CATCH e
    END TRY
END SUB

FUNCTION naechsterTon(pc AS INTEGER, ref AS INTEGER) AS INTEGER
    DIM best AS INTEGER : best = pc + 60
    DIM o AS INTEGER
    FOR o = 1 TO 8
        DIM kand AS INTEGER : kand = o * 12 + pc
        IF ABS(kand - ref) < ABS(best - ref) THEN best = kand
    NEXT
    RETURN best
END FUNCTION

SUB eingabeNote(pitch AS INTEGER, acc AS INTEGER)
    IF eingabeSpur >= nt() THEN eingabeSpur = 0
    DIM k AS INTEGER : k = noteBei(eingabeSpur, eingabeBeat)
    DIM merkAcc AS INTEGER : merkAcc = entryAcc
    entryAcc = acc
    IF k < 0 OR istPause(eingabeSpur, k) OR nPitch(eingabeSpur, k) <> pitch THEN setzen(eingabeSpur, eingabeBeat, pitch, FALSE)
    entryAcc = merkAcc
    letzterPitch = pitch
    vorhoeren(eingabeSpur, pitch)
    eingabeBeat = eingabeBeat + entryDauer
    markeSichtbar()
END SUB

SUB eingabePause()
    IF eingabeSpur >= nt() THEN eingabeSpur = 0
    DIM k AS INTEGER : k = noteBei(eingabeSpur, eingabeBeat)
    IF k < 0 OR NOT istPause(eingabeSpur, k) THEN setzen(eingabeSpur, eingabeBeat, 0, TRUE)
    eingabeBeat = eingabeBeat + entryDauer
    markeSichtbar()
END SUB

' Die Note vor der Marke: die mit dem spaetesten Beginn davor.
FUNCTION noteVorMarke() AS INTEGER
    DIM best AS INTEGER : best = -1
    DIM k AS INTEGER
    FOR k = 0 TO nn(eingabeSpur) - 1
        IF nStart(eingabeSpur, k) < eingabeBeat - 0.000001 THEN
            IF best < 0 THEN
                best = k
            ELSEIF nStart(eingabeSpur, k) >= nStart(eingabeSpur, best) THEN
                best = k
            END IF
        END IF
    NEXT
    RETURN best
END FUNCTION

' Rollt das Blatt so, dass die Marke im Bild bleibt.
SUB markeSichtbar()
    DIM mx AS INTEGER : mx = xBeat(eingabeBeat)
    IF mx > SCREENWIDTH() - PPB * 2 THEN scrollX = scrollX + (mx - (SCREENWIDTH() - PPB * 4))
    IF mx < gx0 + LEFT_MARGIN THEN scrollX = MAX(0, scrollX - (gx0 + LEFT_MARGIN + PPB - mx))
END SUB

SUB tastenEingabe()
    IF GUI_MODAL() THEN RETURN
    IF KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL) OR KEYPRESSED(KEY_LALT) OR KEYPRESSED(KEY_RALT) THEN
        ' Strg+Pfeil: um eine Oktave
        IF KEYHIT(KEY_UP) OR KEYHIT(KEY_DOWN) THEN noteVerschieben(IIF(KEYPRESSED(KEY_UP), 12, -12))
        RETURN
    END IF
    DIM namen AS STRING : namen = "cdefgahb"
    DIM klassen AS ARRAY OF INTEGER : klassen = [0, 2, 4, 5, 7, 9, 11, 10]
    DIM j AS INTEGER
    FOR j = 0 TO 7
        IF KEYHIT(MID$(namen, j, 1)) THEN
            DIM pc AS INTEGER : pc = (klassen[j] + IIF(j = 7, 0, entryAcc) + 12) MOD 12
            DIM ref AS INTEGER : ref = letzterPitch
            IF ref < 0 THEN ref = IIF(text$(tp$(eingabeSpur, "clef")) = "bass", 50, 71)
            eingabeNote(naechsterTon(pc, ref), IIF(j = 7, -1, entryAcc))
        END IF
    NEXT
    IF KEYHIT("p") THEN eingabePause()
    FOR j = 0 TO 4
        IF KEYHIT(STR$(j + 1)) THEN GUI_DROPDOWN_SET_SELECTED(ddDauer, j)
    NEXT
    ' 46 = die Punkt-Taste
    IF KEYHIT(46) THEN GUI_SET_CHECKED(cbPunkt, NOT GUI_CHECKED(cbPunkt))
    IF KEYHIT(KEY_LEFT) THEN eingabeBeat = MAX(0.0, eingabeBeat - entryDauer) : markeSichtbar()
    IF KEYHIT(KEY_RIGHT) THEN eingabeBeat = eingabeBeat + entryDauer : markeSichtbar()
    IF KEYHIT(KEY_UP) THEN noteVerschieben(1)
    IF KEYHIT(KEY_DOWN) THEN noteVerschieben(-1)
    IF KEYHIT(KEY_BACKSPACE) THEN
        DIM k AS INTEGER : k = noteVorMarke()
        IF k >= 0 THEN
            DIM b AS FLOAT : b = nStart(eingabeSpur, k)
            noteEntfernen(eingabeSpur, k)
            merken()
            spurenAnzeigen()
            protokoll("entfernt " + STR$(eingabeSpur) + " " + zahl$(b))
            eingabeBeat = b
            markeSichtbar()
        END IF
    END IF
END SUB

SUB noteVerschieben(halbtoene AS INTEGER)
    DIM k AS INTEGER : k = noteVorMarke()
    IF k < 0 THEN RETURN
    IF istPause(eingabeSpur, k) THEN RETURN
    DIM p AS INTEGER : p = CLAMP(nPitch(eingabeSpur, k) + halbtoene, 0, 127)
    JSON_SET_INT(doc, np$(eingabeSpur, k, "pitch"), p)
    IF hatVorzeichen(p) THEN JSON_SET_INT(doc, np$(eingabeSpur, k, "accidental"), IIF(halbtoene < 0, -1, 1)) ELSE JSON_REMOVE(doc, np$(eingabeSpur, k, "accidental"))
    merken()
    letzterPitch = p
    vorhoeren(eingabeSpur, p)
    protokoll("tonhoehe " + STR$(eingabeSpur) + " " + zahl$(nStart(eingabeSpur, k)) + " " + STR$(p))
END SUB

' --- Klaviatur am unteren Rand -------------------------------------------------
' Drei Oktaven um die Lage der Spur mit der Eingabemarke (Violinschluessel
' ab C4, Bass ab C2). Ein Klick setzt die Note an der Marke wie ein
' Buchstabe; beim Abspielen leuchten die klingenden Tasten.
FUNCTION klavierBasis() AS INTEGER
    IF eingabeSpur < nt() THEN
        IF text$(tp$(eingabeSpur, "clef")) = "bass" THEN RETURN 36
    END IF
    RETURN 60
END FUNCTION

FUNCTION klavierY() AS INTEGER
    RETURN SCREENHEIGHT() - PIANO_H
END FUNCTION

FUNCTION klavierTaste(mx AS INTEGER, my AS INTEGER) AS INTEGER
    IF mx < gx0 OR my < klavierY() OR my >= SCREENHEIGHT() THEN RETURN -1
    DIM wb AS FLOAT : wb = (SCREENWIDTH() - gx0) / 21.0
    DIM schwarz AS ARRAY OF INTEGER : schwarz = [1, 3, -1, 6, 8, 10, -1]
    DIM weiss AS ARRAY OF INTEGER : weiss = [0, 2, 4, 5, 7, 9, 11]
    DIM w AS INTEGER : w = INT((mx - gx0) / wb)
    IF my < klavierY() + PIANO_H * 0.6 THEN
        ' die schwarze Taste ueber der Fuge rechts bzw. links
        DIM rel AS FLOAT : rel = (mx - gx0) / wb - w
        IF rel > 0.7 AND schwarz[w MOD 7] >= 0 THEN RETURN klavierBasis() + (w \ 7) * 12 + schwarz[w MOD 7]
        IF rel < 0.3 AND w > 0 THEN
            IF schwarz[(w - 1) MOD 7] >= 0 THEN RETURN klavierBasis() + ((w - 1) \ 7) * 12 + schwarz[(w - 1) MOD 7]
        END IF
    END IF
    RETURN klavierBasis() + (w \ 7) * 12 + weiss[w MOD 7]
END FUNCTION

FUNCTION klingt(midi AS INTEGER) AS INTEGER
    IF NOT spielt THEN RETURN -1
    DIM t AS FLOAT : t = AUDIO_CLOCK_TICKS(takt) / (ROWS_PER_BEAT * 1.0)
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO nt() - 1
        FOR k = 0 TO nn(i) - 1
            IF NOT istPause(i, k) THEN
                IF nPitch(i, k) = midi AND nStart(i, k) <= t AND t < nStart(i, k) + nDauer(i, k) THEN RETURN spurFarbe(i)
            END IF
        NEXT
    NEXT
    RETURN -1
END FUNCTION

SUB klavierZeichnen()
    DIM py AS INTEGER : py = klavierY()
    DIM pw AS INTEGER : pw = SCREENWIDTH() - gx0
    DIM wb AS FLOAT : wb = pw / 21.0
    DIM unter AS INTEGER : unter = klavierTaste(MOUSEX(), MOUSEY())
    DIM weiss AS ARRAY OF INTEGER : weiss = [0, 2, 4, 5, 7, 9, 11]
    DIM schwarz AS ARRAY OF INTEGER : schwarz = [1, 3, -1, 6, 8, 10, -1]
    BOX(gx0, py - 2, SCREENWIDTH(), SCREENHEIGHT(), &H0A0E14)
    DIM w AS INTEGER
    FOR w = 0 TO 20
        DIM midi AS INTEGER : midi = klavierBasis() + (w \ 7) * 12 + weiss[w MOD 7]
        DIM x0 AS INTEGER : x0 = gx0 + INT(w * wb)
        DIM x1 AS INTEGER : x1 = gx0 + INT((w + 1) * wb) - 2
        DIM f AS INTEGER : f = klingt(midi)
        IF f >= 0 THEN
            GRADIENTV(x0, py, x1, SCREENHEIGHT() - 1, f, &HF4F6F8)
        ELSEIF midi = unter THEN
            GRADIENTV(x0, py, x1, SCREENHEIGHT() - 1, &HC8E8F8, &HF4F6F8)
        ELSE
            GRADIENTV(x0, py, x1, SCREENHEIGHT() - 1, &HF4F6F8, &HD2D8DE)
        END IF
        IF w MOD 7 = 0 THEN
            SETFONT(uiFont, 12)
            TEXT(x0 + 4, SCREENHEIGHT() - 17, "C" + STR$(midi \ 12 - 1), &H506070)
        END IF
    NEXT
    FOR w = 0 TO 20
        IF schwarz[w MOD 7] >= 0 THEN
            DIM sm AS INTEGER : sm = klavierBasis() + (w \ 7) * 12 + schwarz[w MOD 7]
            DIM bx AS INTEGER : bx = gx0 + INT((w + 0.7) * wb)
            DIM bf AS INTEGER : bf = klingt(sm)
            IF bf < 0 AND sm = unter THEN bf = &H4A7A9A
            IF bf < 0 THEN
                GRADIENTV(bx, py, bx + INT(wb * 0.6), py + INT(PIANO_H * 0.6), &H2A323C, &H10151B)
            ELSE
                GRADIENTV(bx, py, bx + INT(wb * 0.6), py + INT(PIANO_H * 0.6), bf, &H10151B)
            END IF
        END IF
    NEXT
    SETFONT(uiFont, 15)
END SUB

' --- Notenwerte als Knopfleiste -------------------------------------------------
' Rechts in der Zeile der Statusmeldung: die fuenf Dauern als Notenzeichen und
' der Punkt. Sie stellen dieselbe Klappliste wie Taste 1..5 -- die bleibt,
' damit alles an EINER Stelle steht.
CONST STREIF_B = 40
FUNCTION streifenX() AS INTEGER
    RETURN SCREENWIDTH() - 6 * (STREIF_B + 4) - 10
END FUNCTION
FUNCTION streifenY() AS INTEGER
    RETURN TOP_B - 34
END FUNCTION

FUNCTION streifenBei(mx AS INTEGER, my AS INTEGER) AS INTEGER
    IF my < streifenY() OR my >= streifenY() + 30 THEN RETURN -1
    IF mx < streifenX() THEN RETURN -1
    DIM j AS INTEGER : j = (mx - streifenX()) \ (STREIF_B + 4)
    IF j > 5 THEN RETURN -1
    RETURN j
END FUNCTION

SUB streifenZeichnen()
    DIM zeichen AS ARRAY OF INTEGER : zeichen = [G_GANZE, G_N_HALB, G_N_VIERTEL, G_N_ACHTEL, G_N_16]
    DIM tasten AS ARRAY OF STRING : tasten = ["1", "2", "3", "4", "5"]
    DIM j AS INTEGER
    DIM wahl AS INTEGER : wahl = GUI_DROPDOWN_SELECTED(ddDauer)
    DIM unter AS INTEGER : unter = streifenBei(MOUSEX(), MOUSEY())
    FOR j = 0 TO 5
        DIM x AS INTEGER : x = streifenX() + j * (STREIF_B + 4)
        DIM y AS INTEGER : y = streifenY()
        DIM an AS BOOLEAN : an = IIF(j = 5, GUI_CHECKED(cbPunkt), j = wahl)
        DIM grund AS INTEGER : grund = IIF(an, &H1F6F9A, IIF(j = unter, &H2A3A4C, &H1A2230))
        BOXROUND(x, y, x + STREIF_B, y + 30, 5, grund)
        RECTROUND(x, y, x + STREIF_B, y + 30, 5, IIF(an, &H4FC8F0, &H34404E))
        IF j = 5 THEN
            CIRCLE(x + STREIF_B \ 2, y + 15, 4, F_TEXT)
        ELSEIF musikFont >= 0 THEN
            DIM cp AS INTEGER : cp = zeichen[j]
            ' Ganze Note mittig, die uebrigen mit dem Kopf unten im Kasten.
            IF j = 0 THEN
                glyphMitte(cp, x + STREIF_B \ 2, y + 15, 134, 4, F_TEXT)
            ELSE
                glyphMitte(cp, x + STREIF_B \ 2 - 2, y + 26, 134, 4, F_TEXT)
            END IF
        ELSE
            SETFONT(uiFont, 13)
            TEXT(x + 6, y + 7, ["1", "1/2", "1/4", "1/8", "1/16"][j], F_TEXT)
        END IF
    NEXT
    SETFONT(uiFont, 15)
END SUB

' --- Start --------------------------------------------------------------------
IF ARGC() >= 1 THEN
    DIM startDatei AS STRING : startDatei = ARG$(0)
    IF LEFT$(startDatei, 1) <> "/" AND LEFT$(startDatei, 1) <> "\" AND MID$(startDatei, 1, 1) <> ":" THEN
        DIM start AS STRING : start = GETENV$("DHRT_START_DIR")
        IF start <> "" THEN startDatei = PATHJOIN(start, startDatei)
    END IF
    laden(startDatei)
ELSE
    neuesStueck()
END IF
GUI_FOCUS(-1)
protokoll("bereit")

' Zoom nach der Fensterhoehe: 800 Punkte = 1, auf zehntel gerundet.
FUNCTION zoomFuerSchirm() AS FLOAT
    RETURN CLAMP(INT(SCREENHEIGHT() / 80.0) / 10.0, 1.0, 1.8)
END FUNCTION
IF zoomFuerSchirm() <> zoom THEN zoomSetzen(zoomFuerSchirm())
DIM warBreite AS INTEGER : warBreite = SCREENWIDTH()
DIM warHoehe AS INTEGER : warHoehe = SCREENHEIGHT()
DIM beenden AS BOOLEAN : beenden = FALSE
DIM dlgSchliessen AS GUI_WINDOW : dlgSchliessen = 0

' [Beenden] und das Kreuz fragen dasselbe -- bis 2026-09-19 beendete das
' Kreuz ohne Rueckfrage. Ein anderer offener Kasten geht vor.
SUB endeAnfragen()
    IF dlgSchliessen <> 0 OR GUI_MODAL() THEN RETURN
    IF geaendert THEN dlgSchliessen = GUI_DIALOG("Beenden", "Das Stueck ist nicht gesichert.", "Sichern|Verwerfen|Abbrechen") ELSE beenden = TRUE
END SUB

' [Neu] und [Oeffnen] ersetzen das Stueck -- mit ungesicherten Aenderungen
' fragen sie vorher wie das Kreuz (bis 2026-09-21 warfen sie sie wortlos
' weg). Die Antwort kommt ein Bild spaeter; `ersetzenMit` merkt sich bis
' dahin, was danach geschehen soll. Beim Oeffnen kommt der Datei-Dialog
' erst NACH der Antwort -- wer abbricht, soll keinen sehen.
DIM dlgErsetzen AS GUI_WINDOW : dlgErsetzen = 0
DIM ersetzenMit AS STRING : ersetzenMit = ""

SUB ersetzenAusfuehren(was AS STRING)
    IF was = "neu" THEN
        neuesStueck()
    ELSE
        DIM p AS STRING : p = FILE_OPEN_DIALOG("Stueck oeffnen", "json")
        IF p <> "" THEN laden(p)
    END IF
END SUB

SUB ersetzenAnfragen(was AS STRING)
    IF dlgErsetzen <> 0 OR dlgSchliessen <> 0 OR GUI_MODAL() THEN RETURN
    IF NOT geaendert THEN
        ersetzenAusfuehren(was)
        RETURN
    END IF
    ersetzenMit = was
    dlgErsetzen = GUI_DIALOG(IIF(was = "neu", "Neues Stueck", "Oeffnen"), "Das Stueck ist nicht gesichert.", "Sichern|Verwerfen|Abbrechen")
    protokoll("frage " + was)
END SUB

WHILE NOT beenden
    ' Das Kreuz (und Alt+F4) fragt wie [Beenden] nach, wenn etwas nicht
    ' gesichert ist. QUITREQUESTED ohne das Kreuz ist das Bildlimit eines
    ' Testlaufs -- dort endet das Programm hart wie bisher.
    IF WINDOW_CLOSE_REQUESTED() THEN
        endeAnfragen()
    ELSEIF QUITREQUESTED() THEN
        BREAK
    END IF
    GUI_UPDATE()
    werkzeugeLesen()
    IF SCREENWIDTH() <> warBreite OR SCREENHEIGHT() <> warHoehe THEN
        warBreite = SCREENWIDTH() : warHoehe = SCREENHEIGHT()
        GUI_WINDOW_SET_BOUNDS(winTop, 0, 0, warBreite, TOP_B)
        GUI_WINDOW_SET_BOUNDS(winLinks, 0, TOP_B, LINKS_B, warHoehe - TOP_B)
        GUI_SET_WRAP(lblStatus, warBreite - 300)
        ' Auf einem grossen Schirm (das Fenster startet maximiert) waeren die
        ' Systeme bei Zoom 1 winzig -- einmal anpassen, solange niemand von
        ' Hand gezoomt hat.
        IF NOT zoomVonHand THEN zoomSetzen(zoomFuerSchirm())
    END IF

    ' Menue und Knoepfe
    IF GUI_CLICKED(miNeu) THEN ersetzenAnfragen("neu")
    IF GUI_CLICKED(miOeffnen) THEN ersetzenAnfragen("oeffnen")
    IF GUI_CLICKED(miSichern) THEN sichern(FALSE)
    IF GUI_CLICKED(miSichernAls) THEN sichern(TRUE)
    IF GUI_CLICKED(miTracker) OR GUI_CLICKED(btnTracker) THEN inTrackerOeffnen()
    IF GUI_CLICKED(miSpielen) OR GUI_CLICKED(btnSpielen) THEN
        IF spielt THEN stopp() ELSE starten()
    END IF
    IF GUI_CLICKED(miBeenden) THEN endeAnfragen()
    IF GUI_CLICKED(miRueck) THEN rueckgaengig()
    IF GUI_CLICKED(miWieder) THEN wiederholen()
    IF GUI_CLICKED(miSpurPlus) OR GUI_CLICKED(btnSpurPlus) THEN spurHinzu()
    IF GUI_CLICKED(miSpurWeg) OR GUI_CLICKED(btnSpurWeg) THEN spurWeg()
    IF dlgTracker <> 0 THEN
        DIM at AS INTEGER : at = GUI_ANSWER(dlgTracker)
        IF at = 1 THEN
            dlgTracker = 0 : trackerSchreiben()
        ELSEIF at = 2 THEN
            dlgTracker = 0 : protokoll("tracker abgebrochen")
            GUI_SET_TEXT(lblStatus, "Nicht umgerechnet.")
        END IF
    END IF
    IF dlgErsetzen <> 0 THEN
        DIM ae AS INTEGER : ae = GUI_ANSWER(dlgErsetzen)
        IF ae = 1 THEN
            dlgErsetzen = 0
            IF sichern(FALSE) THEN ersetzenAusfuehren(ersetzenMit)
        ELSEIF ae = 2 THEN
            dlgErsetzen = 0 : protokoll("frage verworfen")
            ersetzenAusfuehren(ersetzenMit)
        ELSEIF ae = 3 THEN
            dlgErsetzen = 0 : protokoll("frage abgebrochen")
            GUI_SET_TEXT(lblStatus, "Nichts ersetzt.")
        END IF
    END IF
    IF dlgSchliessen <> 0 THEN
        DIM a AS INTEGER : a = GUI_ANSWER(dlgSchliessen)
        IF a = 1 THEN
            dlgSchliessen = 0
            IF sichern(FALSE) THEN beenden = TRUE
        ELSEIF a = 2 THEN
            dlgSchliessen = 0 : beenden = TRUE
        ELSEIF a = 3 THEN
            dlgSchliessen = 0
        END IF
    END IF
    GUI_SET_TEXT(btnSpielen, IIF(spielt, "Stopp", "Abspielen"))

    ' Tempo
    IF NOT stumm AND GUI_ENTERED(fBpm) THEN
        DIM b AS INTEGER : b = CLAMP(INT(VAL(GUI_TEXT(fBpm))), 20, 400)
        IF b <> bpm() THEN JSON_SET_INT(doc, "bpm", b) : merken() : protokoll("bpm " + STR$(b))
        spurenAnzeigen()
        GUI_FOCUS(-1)
    END IF

    ' Spuren: Name (Enter), Schluessel und Instrument (Auswahl ist das Ereignis)
    DIM i AS INTEGER
    IF NOT stumm THEN
        FOR i = 0 TO nt() - 1
            IF GUI_ENTERED(sName[i]) THEN
                DIM nm AS STRING : nm = TRIM$(GUI_TEXT(sName[i]))
                IF nm = "" THEN nm = "Stimme " + STR$(i + 1)
                IF nm <> text$(tp$(i, "name")) THEN JSON_SET_STRING(doc, tp$(i, "name"), nm) : merken() : protokoll("name " + STR$(i) + " " + nm)
                spurenAnzeigen()
                GUI_FOCUS(-1)
            END IF
            IF GUI_DROPDOWN_SELECTED(sClef[i]) <> sClefSel[i] AND GUI_DROPDOWN_SELECTED(sClef[i]) >= 0 THEN
                sClefSel[i] = GUI_DROPDOWN_SELECTED(sClef[i])
                schluesselSetzen(i, IIF(sClefSel[i] = 1, "bass", "treble"))
                spurenAnzeigen()
            END IF
            IF GUI_DROPDOWN_SELECTED(sInst[i]) <> sInstSel[i] AND GUI_DROPDOWN_SELECTED(sInst[i]) >= 0 THEN
                sInstSel[i] = GUI_DROPDOWN_SELECTED(sInst[i])
                IF sInstSel[i] < LEN(pName) THEN
                    JSON_SET_JSON(doc, tp$(i, "instrument"), presetJson(sInstSel[i]))
                    merken()
                    protokoll("instrument " + STR$(i) + " " + pName[sInstSel[i]])
                END IF
                spurenAnzeigen()
            END IF
        NEXT
    END IF

    ' Tastatur und Rad, solange kein Eingabefeld den Fokus hat
    DIM fokus AS GUI_WIDGET : fokus = GUI_FOCUSED()
    DIM imFeld AS BOOLEAN : imFeld = FALSE
    IF fokus >= 0 THEN imFeld = GUI_KIND(fokus) = "textinput"
    IF NOT imFeld THEN
        IF KEYHIT(KEY_SPACE) THEN
            IF spielt THEN stopp() ELSE starten()
        END IF
        IF KEYHIT(KEY_ESCAPE) THEN ankerSpur = -1
        tastenEingabe()
    END IF
    IF GUI_CLICKED(miZoomPlus) THEN zoomVonHand = TRUE : zoomSetzen(zoom + 0.1)
    IF GUI_CLICKED(miZoomMinus) THEN zoomVonHand = TRUE : zoomSetzen(zoom - 0.1)
    IF GUI_CLICKED(miZoom100) THEN zoomVonHand = TRUE : zoomSetzen(1.0)
    DIM rad AS INTEGER : rad = MOUSEWHEEL()
    IF rad <> 0 AND imBlatt(MOUSEX(), MOUSEY()) THEN
        IF KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL) THEN
            zoomVonHand = TRUE
            zoomSetzen(zoom + rad * 0.1)
        ELSEIF KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT) THEN
            scrollY = CLAMP(scrollY - rad * 40, 0, MAX(0, nt() * STAFF_H - (SCREENHEIGHT() - TOP_B - 20)))
            spurenAnzeigen()
        ELSE
            scrollX = MAX(0, scrollX - rad * PPB)
        END IF
    END IF

    IF spielt THEN
        IF AUDIO_CLOCK_TICKS(takt) > spielEnde THEN stopp()
    END IF
    IF trackerProzess >= 0 THEN
        IF NOT PROCESS_RUNNING(trackerProzess) THEN PROCESS_CLOSE(trackerProzess) : trackerProzess = -1
    END IF

    mausAufBlatt()
    ' Klaviatur und Notenwerte: ein Klick setzt die Note an der Marke bzw.
    ' waehlt die Dauer.
    IF MOUSE_HIT(LINKS) AND NOT GUI_MODAL() THEN
        DIM kt AS INTEGER : kt = klavierTaste(MOUSEX(), MOUSEY())
        IF kt >= 0 THEN
            letzterPitch = kt
            eingabeNote(kt, IIF(hatVorzeichen(kt), 1, 0))
            GUI_FOCUS(-1)
        END IF
        DIM sj AS INTEGER : sj = streifenBei(MOUSEX(), MOUSEY())
        IF sj = 5 THEN
            GUI_SET_CHECKED(cbPunkt, NOT GUI_CHECKED(cbPunkt))
        ELSEIF sj >= 0 THEN
            GUI_DROPDOWN_SET_SELECTED(ddDauer, sj)
        END IF
    END IF

    CLS(&H0B1119)
    blattZeichnen()
    klavierZeichnen()
    GUI_DRAW()
    streifenZeichnen()
    FLIP()
WEND

IF spielt THEN stopp()
IF trackerProzess >= 0 THEN PROCESS_CLOSE(trackerProzess)
protokoll("noten " + STR$(notenGesamt()))
protokoll("ende")
