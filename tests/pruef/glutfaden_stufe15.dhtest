=== farbverlauf: richtung zaehlt, ein punkt, falsche farbe
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("farbprobe.pxs")
DIM p AS ARRAY OF INTEGER, f AS ARRAY OF INTEGER, q AS ARRAY OF INTEGER, g AS ARRAY OF INTEGER
(p, f) = kern.farbverlauf(m, 0, 0, 11, 3, 0, 8)
(q, g) = kern.farbverlauf(m, 11, 3, 0, 0, 0, 8)
PRINT "hin:     "; JOIN$(p, ","); " | "; JOIN$(f, ",")
PRINT "zurueck: "; JOIN$(q, ","); " | "; JOIN$(g, ",")
' linie() tauscht die Enden -- dieselben Punkte, aber von links
PRINT "linie: "; JOIN$(kern.linie(11, 3, 0, 0), ",")
(p, f) = kern.farbverlauf(m, 4, 4, 4, 4, 2, 7)
PRINT "ein punkt: "; JOIN$(p, ","); " | "; JOIN$(f, ",")
(p, f) = kern.farbverlauf(m, 0, 0, 3, 0, 0, 9)
PRINT "farbe 9 gibt es nicht: "; LEN(p); " "; LEN(f)
' gleiche Start- und Endfarbe: ueberall dieselbe
(p, f) = kern.farbverlauf(m, 0, 2, 7, 2, 3, 3)
PRINT "gleich: "; JOIN$(f, ",")
' Abgeschnitten wie Pythons int(), nicht gerundet: in der Mitte zwischen
' #000000 und #030303 liegt 1,5 je Kanal -- #010101, nicht #020202
m.farben[0].garn.farbe = &H000000
m.farben[1].garn.farbe = &H030303
m.farben[2].garn.farbe = &H010101
m.farben[3].garn.farbe = &H020202
(p, f) = kern.farbverlauf(m, 0, 0, 2, 0, 0, 1)
PRINT "mitte abgeschnitten: "; JOIN$(f, ",")
' Masse fuer ein flaches Muster und ein Feld unter dem Mindestmass
DIM iw AS INTEGER, ih AS INTEGER, bx AS INTEGER, by AS INTEGER
(iw, ih, bx, by) = kern.minikarteMass(500, 20, 50, 50)
PRINT "flaches muster: "; iw; "x"; ih; " bei "; bx; ","; by
PRINT "kachel bei 0 x 0: "; kern.kachelZelle(0, 0, 400, 300, 3, 3); " | riesig: "; kern.kachelZelle(1000, 1000, 400, 300, 5, 5)
--- argumente
{sammlung}/../../examples/glutfaden
