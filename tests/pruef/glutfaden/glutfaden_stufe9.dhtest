=== vorrat: dateien lesen wie pysticky -- flach, kaputt, falsche formen, punkte im schluessel
IMPORT "helfer.dh"
DIM z AS ARRAY OF STRING : z = []
DIM n AS STRING
FOR EACH n IN ["flach.json", "kaputt.json", "liste.json", "stockliste.json", "leer.json", "punkte.json", "kaputt_bytes.json", "gibtsnicht.json"]
    DIM v AS kern.Vorrat : v = kern.vorratLaden(n)
    DIM t AS ARRAY OF STRING : t = []
    DIM k AS STRING
    FOR EACH k IN v.schluessel()
        ARRAY_PUSH(t, k + "=" + STR$(v.holeSchluessel(k)))
    NEXT
    ARRAY_PUSH(z, n + ": " + JOIN$(t, " | "))
NEXT
PRINT geAbweichungen$(geLies$("ref_lesen.txt"), JOIN$(z, CHR$(10)))
' und zurueck: was gelesen wurde, kommt beim Sichern mit seinen Punkten wieder
DIM p AS kern.Vorrat : p = kern.vorratLaden("punkte.json")
p.pfad = "neu/punkte.json"
p.sichern()
DIM q AS kern.Vorrat : q = kern.vorratLaden("neu/punkte.json")
PRINT "rundweg: "; JOIN$(q.schluessel(), " | "); " | "; q.holeSchluessel("a.b::c.d")
