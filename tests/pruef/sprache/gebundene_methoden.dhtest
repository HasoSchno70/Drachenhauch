CLASS Zaehler
    DIM stand AS INTEGER
    SUB tick()
        Self.stand = Self.stand + 1
    END SUB
    FUNCTION mal(x AS INTEGER) AS INTEGER
        RETURN x * Self.stand
    END FUNCTION
END CLASS

DIM z AS Zaehler
z = NEW Zaehler()
