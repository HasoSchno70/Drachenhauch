' Glutfaden Stufe 5: Export. Die Beilagen hat PySticky geschrieben bzw.
' aufgezeichnet -- probe.pxs (alle Stichtypen, ein Blend, eine Perlenfarbe,
' Rueckstiche, zwei Ebenen, Sonderzeichen im Titel), PyStickys OXS davon und
' von demo_kreuzstich.pxs, die Zusammenfassung dessen, was PyStickys OXS-Leser
' daraus macht, und die Zahlen der Export-Rechnung (Seiten je Format, Farben
' und Rueckstiche je Seite, Garnbedarf, Papierempfehlung, Entsprechungen bei
' anderen Herstellern; io/pdf_export.py, io/export_common.py,
' core/thread_cross_ref.py). Erwartet ist ueberall: gleich.
' PySticky schreibt OXS im Textmodus (unter Windows CRLF); verglichen wird
' ohne CR, Glutfaden schreibt LF.

=== oxs schreiben byte fuer byte wie pysticky
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
PRINT "probe: "; geVergleich$(kern.oxsText$(m), geLies$("probe_pysticky.oxs"))
DIM d AS kern.Muster : d = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")
PRINT "demo: "; geVergleich$(kern.oxsText$(d), geLies$("demo.oxs"))
kern.oxsSpeichern(m, "aus.oxs")
PRINT "datei ohne cr: "; INSTR(geLies$("aus.oxs"), CHR$(13)) < 0; " endet mit chart: "; RIGHT$(geLies$("aus.oxs"), 8) = "</chart>"
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"

