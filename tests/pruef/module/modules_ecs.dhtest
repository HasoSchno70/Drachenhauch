=== query returns matching entities
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
DIM e1 AS INTEGER
DIM e2 AS INTEGER
DIM e3 AS INTEGER
e1 = ECS_NEW_ENTITY(w)
e2 = ECS_NEW_ENTITY(w)
e3 = ECS_NEW_ENTITY(w)
ECS_ADD_INT(w, e1, "pos", 10)
ECS_ADD_INT(w, e2, "pos", 20)
DIM q AS ARRAY OF INTEGER
q = ECS_QUERY(w, "pos")
PRINT LEN(q)
DIM i AS INTEGER
FOR i = 0 TO LEN(q) - 1
    PRINT q[i]
NEXT
--- erwartet
2
1
2

=== query2 intersection
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
DIM e1 AS INTEGER
DIM e2 AS INTEGER
DIM e3 AS INTEGER
e1 = ECS_NEW_ENTITY(w)
e2 = ECS_NEW_ENTITY(w)
e3 = ECS_NEW_ENTITY(w)
ECS_ADD_INT(w, e1, "pos", 1)
ECS_ADD_INT(w, e1, "vel", 2)
ECS_ADD_INT(w, e2, "pos", 3)
ECS_ADD_INT(w, e3, "vel", 4)
DIM q AS ARRAY OF INTEGER
q = ECS_QUERY2(w, "pos", "vel")
PRINT LEN(q)
DIM i AS INTEGER
FOR i = 0 TO LEN(q) - 1
    PRINT q[i]
NEXT
--- erwartet
1
1

=== query3 intersection
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
DIM e1 AS INTEGER
DIM e2 AS INTEGER
e1 = ECS_NEW_ENTITY(w)
e2 = ECS_NEW_ENTITY(w)
ECS_ADD_INT(w, e1, "a", 1)
ECS_ADD_INT(w, e1, "b", 1)
ECS_ADD_INT(w, e1, "c", 1)
ECS_ADD_INT(w, e2, "a", 1)
ECS_ADD_INT(w, e2, "b", 1)
DIM q AS ARRAY OF INTEGER
q = ECS_QUERY3(w, "a", "b", "c")
PRINT LEN(q)
DIM i AS INTEGER
FOR i = 0 TO LEN(q) - 1
    PRINT q[i]
NEXT
--- erwartet
1
1

