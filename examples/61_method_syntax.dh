' 61_method_syntax.dh -- Method-Syntax auf Built-in-Containern.
'
' Statt funktional: `UPPER$(s)`, `MAPHAS(m, k)`, `LEN(arr)`
' Jetzt OO-Style: `s.upper()`, `m.has(k)`, `arr.length()`
'
' Beide Stile koexistieren -- die Method-Syntax ist nur Sugar zum
' BUILTIN-Aufruf mit dem Receiver als erstem Argument.

PRINT "=== String ==="
DIM s AS STRING
s = "Hello World"
PRINT "s.upper()        =>", s.upper()
PRINT "s.lower()        =>", s.lower()
PRINT "s.length()       =>", s.length()
PRINT "s.left(5)        =>", s.left(5)
PRINT "s.right(5)       =>", s.right(5)
PRINT "s.mid(0, 5)      =>", s.mid(0, 5)
PRINT "s.indexof('W',0) =>", s.indexof("W", 0)
PRINT "s.replace        =>", s.replace("World", "GameBasic")
PRINT "'  pad  '.trim() =>", "[" + "  pad  ".trim() + "]"

PRINT ""
PRINT "=== Method-Chaining ==="
DIM noisy AS STRING
noisy = "  GAME basic  "
PRINT "Original:        '" + noisy + "'"
PRINT "trim+lower:      '" + noisy.trim().lower() + "'"

PRINT ""
PRINT "=== Array ==="
DIM a[10] AS INTEGER
PRINT "a.length()       =>", a.length()

PRINT ""
PRINT "=== Map ==="
DIM scores AS MAP OF INTEGER
scores.put("alice", 100)
scores.put("bob", 75)
scores.put("cilla", 92)

PRINT "scores.size()    =>", scores.size()
PRINT "scores.has('alice')  =>", scores.has("alice")
PRINT "scores.has('eve')    =>", scores.has("eve")
PRINT "scores.get('alice')  =>", scores.get("alice")
PRINT "scores.getor('eve',0)=>", scores.getor("eve", 0)

scores.remove("bob")
PRINT "Nach remove(bob): size=", scores.size()
scores.clear()
PRINT "Nach clear(): size=", scores.size()
