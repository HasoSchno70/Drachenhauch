=== ein klick ohne strg setzt nur die marke
' Gegenprobe: derselbe Klick ohne Strg -- die Marke steht danach im Wort
' (Zeile 5), gesprungen wird nicht.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
prBild = prBild + 1
IF prBild = 40 THEN prZiel(5, 3, FALSE, TRUE)
IF prBild = 150 THEN prProbe()
--- einschub nach protokoll("bereit")
IMPORT "hilfe.dh"
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=170
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
' Malt einen Stern.
SUB malen()
    PRINT 1
END SUB
malen()
PRINT "ende"
--- datei _programm/hilfe.dh
IMPORT "{sammlung}/_hilfen/idemaus.dh"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 11) = "strg klick " OR LEFT$(L[i], 6) = "probe " OR LEFT$(L[i], 5) = "ziel " THEN PRINT L[i]
NEXT
--- erwartet
ziel gefunden
probe zeile 5
