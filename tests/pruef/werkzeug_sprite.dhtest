    RETURN IIF(b, "ja", "nein")
END FUNCTION
SUB prFall()
    DIM t AS INTEGER
    prKnopf(4, GUI_GET_X(bBildWeg) - 92, GUI_GET_Y(bBildWeg), 88)
    prKlick(12, GUI_GET_X(spMs) + GUI_GET_W(spMs) - 8, GUI_GET_Y(spMs) + 6)
    prKlick(15, GUI_GET_X(spMs) + GUI_GET_W(spMs) - 8, GUI_GET_Y(spMs) + 6)
    prKlick(18, GUI_GET_X(spMs) + GUI_GET_W(spMs) - 8, GUI_GET_Y(spMs) + 6)
    prKlick(21, GUI_GET_X(spMs) + GUI_GET_W(spMs) - 8, GUI_GET_Y(spMs) + 6)
    prKnopf(30, GUI_GET_X(bGif), GUI_GET_Y(bGif), 52)
