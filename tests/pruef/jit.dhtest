=== methode aus der vm gibt auf nach einer feldschreibung
CLASS Zins
    DIM zaehler AS INTEGER
    DIM betrag AS INTEGER
    SUB verdoppeln()
        Self.zaehler = Self.zaehler + 1
        Self.betrag = Self.betrag * 1000
    END SUB
END CLASS
DIM z AS Zins : z = NEW Zins()
z.betrag = 7
DIM i AS INTEGER
TRY
    FOR i = 1 TO 20
        z.verdoppeln()
        PRINT z.zaehler;
    NEXT
CATCH e
    PRINT
    PRINT "gefangen: "; e; " zeile "; ERROR_LINE()
END TRY
PRINT z.zaehler; " "; z.betrag
--- umgebung
DHRT_JIT=aus
--- erwartet
123456
gefangen: Ganzzahl-Ueberlauf bei '*' (INTEGER ist 64-bit; Wertebereich ueberschritten) zeile 6
7 7000000000000000000

