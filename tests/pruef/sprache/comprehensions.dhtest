upper = [n.upper() FOR n IN names]
PRINT upper
--- erwartet
(ALICE, BOB, CILLA)

=== comp string filter (1)
' Filter auf String-Container -- nur Vokale.
DIM vowels AS TUPLE
vowels = [c FOR c IN "Hallo Welt" WHERE c IN "aeiouAEIOU"]
PRINT vowels
--- erwartet
(a, o, e)

