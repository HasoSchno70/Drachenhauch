' Aus test_gui_layout.py uebertragen (16 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== null heisst nach inhalt
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "OK", 10, 10, 0, 0)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "Ein deutlich laengerer Text", 10, 50, 0, 0)
GUI_UPDATE()
PRINT GUI_GET_X(a) ; " " ; GUI_GET_Y(a) ; " " ; GUI_GET_W(a) ; " " ; GUI_GET_H(a)
PRINT GUI_GET_X(b) ; " " ; GUI_GET_Y(b) ; " " ; GUI_GET_W(b) ; " " ; GUI_GET_H(b)
--- umgebung
DHRT_FRAMES=2
--- erwartet
10 10 50 32
10 50 308 32

=== autosize misst sofort und set bounds hebt es auf
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "Knopf mit Text", 10, 10, 30, 10)
GUI_AUTOSIZE(a)
PRINT GUI_GET_X(a) ; " " ; GUI_GET_Y(a) ; " " ; GUI_GET_W(a) ; " " ; GUI_GET_H(a)
GUI_SET_BOUNDS(a, 10, 10, 30, 10)
GUI_UPDATE()
PRINT GUI_GET_X(a) ; " " ; GUI_GET_Y(a) ; " " ; GUI_GET_W(a) ; " " ; GUI_GET_H(a)
--- umgebung
DHRT_FRAMES=2
--- erwartet
10 10 174 32
10 10 30 10

