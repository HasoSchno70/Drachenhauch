' ============================================================
'  DRACHENHAUCH -- die gui in einem Rundgang
' ============================================================
'  Zehn Stationen, links zu waehlen, jede lebendig:
'    Willkommen       Glas ueber einem bewegten Hintergrund, schwebende
'                     Karten, ein Knopf mit Konfetti
'    Bedienelemente   Knoepfe in allen Arten, Kaestchen, Schalter, Regler,
'                     Drehknopf, Zahlenfeld, Klappliste, Fortschritt
'    Text & Emoji     Code-Feld, gesetzter Text, Emoji in Farbe, Schriften
'                     aus aller Welt
'    Daten            eine Tabelle mit einer Million Zeilen (virtuell),
'                     Baum, Baumtabelle, Liste
'    Auswahl          Farbe, Datum, Uhrzeit, Pfadleiste
'    Aufbau           Reiter, Akkordeon, Assistent
'    Lebendig         Formen, Animationen, Klaenge, Funken, Lichtstreif
'    Stildatei live   die Stildatei dieser Schau -- aendern und anwenden
'    Werkzeuge        Befehlspalette, Inspektor, Toast, Infoleiste,
'                     Dialog, echtes Zweitfenster
'    Barrierefreiheit die eingebaute Pruefung (GUI_A11Y_CHECK$)
'
'  Die Leiste oben wirkt auf ALLES: Thema, von rechts nach links,
'  Bewegung, Toene, hoher Kontrast -- und "Sparsam": der Hintergrund steht
'  still, das Programm schlaeft zwischen zwei Eingaben (die Anzeige oben
'  rechts zeigt die Bilder je Sekunde fallen).
'
'  Strg+Umschalt+P: Befehlspalette   Strg+Umschalt+I: Inspektor (mit
'  DHRT_INSPEKTOR=1, aus der IDE gestartet von selbst)
'  Argument: die Station, mit der die Schau beginnt (0..9).
' ============================================================
IMPORT "gui"

SCREEN(1280, 800, "Drachenhauch -- die gui in einem Rundgang", 1)
WINDOW_RESIZABLE(TRUE)
SETFPS(60)

CONST NAV_B = 230
' Kopf samt Menueleiste (26 Punkte): die Widgets im Hauptfenster stehen
' unter der Leiste, die Fenster der Stationen auf dem Bildschirm.
CONST MENUE_H = 26
CONST KOPF_H = 112
CONST FUSS_H = 30

DIM themen AS ARRAY OF STRING : themen = ["glas_dunkel", "dark", "modern_dark", "glas_hell", "light", "modern_light", "contrast"]
DIM themenNamen AS ARRAY OF STRING : themenNamen = ["Glas dunkel", "Dunkel", "Modern dunkel", "Glas hell", "Hell", "Modern hell", "Kontrast"]

' Das Thema setzen -- und den Grund der Fenster durchscheinend machen, damit
' der bewegte Hintergrund durch die ganze Oberflaeche leuchtet.
' Helle Themen bekommen einen hellen Hintergrund (Pastell statt kraeftig).
DIM hellerGrund AS BOOLEAN = FALSE
SUB thema(k AS INTEGER)
    GUI_THEME_PRESET(themen[k])
    GUI_THEME_SET("win_bg", &H3C000000 BOR (GUI_THEME_GET("win_bg") BAND &HFFFFFF))
    hellerGrund = (k >= 3 AND k <= 5)
END SUB
thema(0)

' --------------------------------------------------- das Hauptfenster
DIM haupt AS GUI_WINDOW : haupt = GUI_WINDOW("Rundgang", 0, 0, 1280, 800)
GUI_WINDOW_CHROME(haupt, FALSE)
' Es bleibt hinter den Fenstern der Stationen, auch wenn man hineinklickt --
' sonst verdeckte es sie nach dem ersten Klick in die Navigation.
GUI_WINDOW_BACKGROUND(haupt, TRUE)
DIM mSchau AS INTEGER : mSchau = GUI_MENU(haupt, "Schau")
DIM miWeiter AS INTEGER : miWeiter = GUI_MENU_ITEM(mSchau, "Naechste Station", "Strg+Rechts")
DIM miZurueck AS INTEGER : miZurueck = GUI_MENU_ITEM(mSchau, "Vorige Station", "Strg+Links")
DIM miFeier AS INTEGER : miFeier = GUI_MENU_ITEM(mSchau, "Etwas feiern")
GUI_MENU_SEPARATOR(mSchau)
DIM miEnde AS INTEGER : miEnde = GUI_MENU_ITEM(mSchau, "Beenden", "Strg+Q")
DIM mAnsicht AS INTEGER : mAnsicht = GUI_MENU(haupt, "Ansicht")
DIM miPalette AS INTEGER : miPalette = GUI_MENU_ITEM(mAnsicht, "Befehlspalette", "Strg+Umschalt+P")
DIM miInspektor AS INTEGER : miInspektor = GUI_MENU_ITEM(mAnsicht, "Inspektor")

DIM titel AS GUI_WIDGET : titel = GUI_LABEL(haupt, "Drachenhauch gui", 24, 6)
GUI_SET_NAME(titel, "titel")
DIM untertitel AS GUI_WIDGET : untertitel = GUI_LABEL(haupt, "Alles, was die Oberflaeche kann -- in einem Rundgang", 26, 50)
GUI_SET_NAME(untertitel, "untertitel")

DIM themaWahl AS GUI_WIDGET : themaWahl = GUI_DROPDOWN(haupt, 560, 8, 180, 30, themenNamen)
GUI_TOOLTIP(themaWahl, "Thema der ganzen Oberflaeche")
DIM fpsAnzeige AS GUI_WIDGET : fpsAnzeige = GUI_LABEL(haupt, "", 1120, 14)
GUI_SET_NAME(fpsAnzeige, "fps")
DIM sRtl AS GUI_WIDGET : sRtl = GUI_TOGGLE(haupt, "Rechts nach links", 560, 52, FALSE)
DIM sBewegung AS GUI_WIDGET : sBewegung = GUI_TOGGLE(haupt, "Bewegung", 750, 52, TRUE)
DIM sToene AS GUI_WIDGET : sToene = GUI_TOGGLE(haupt, "Toene", 885, 52, TRUE)
DIM sSparsam AS GUI_WIDGET : sSparsam = GUI_TOGGLE(haupt, "Sparsam", 990, 52, FALSE)
DIM sKontrast AS GUI_WIDGET : sKontrast = GUI_TOGGLE(haupt, "Kontrast", 1115, 52, FALSE)
GUI_TOOLTIP(sSparsam, "Der Hintergrund steht still, und das Programm schlaeft zwischen zwei Eingaben")

DIM stationen AS ARRAY OF STRING : stationen = ["Willkommen", "Bedienelemente", "Text & Emoji", "Daten", "Auswahl", "Aufbau", "Lebendig", "Stildatei live", "Werkzeuge", "Barrierefreiheit"]
DIM nav AS GUI_WIDGET : nav = GUI_LISTBOX(haupt, 12, KOPF_H - MENUE_H + 6, NAV_B - 22, 800 - KOPF_H - FUSS_H - 18, stationen)
GUI_SET_NAME(nav, "nav")
DIM fuss AS GUI_WIDGET : fuss = GUI_STATUSBAR(haupt, 0, 800 - MENUE_H - FUSS_H, 1280, FUSS_H, "Willkommen -- links eine Station waehlen")

' Je Station ein eigenes, randloses Fenster im Inhaltsbereich; sichtbar ist
' immer nur eines.
DIM seiten AS ARRAY OF GUI_WINDOW
FUNCTION seite(name AS STRING) AS GUI_WINDOW
    DIM s AS GUI_WINDOW : s = GUI_WINDOW(name, NAV_B, KOPF_H, 1280 - NAV_B - 10, 800 - KOPF_H - FUSS_H - 6)
    GUI_WINDOW_CHROME(s, FALSE)
    GUI_WINDOW_VISIBLE(s, FALSE)
    ARRAY_PUSH(seiten, s)
    RETURN s
END FUNCTION

' --------------------------------------------------- 0 Willkommen
DIM s0 AS GUI_WINDOW : s0 = seite("Willkommen")
DIM gruss AS GUI_WIDGET : gruss = GUI_LABEL(s0, "Willkommen in der gui", 40, 24)
GUI_SET_NAME(gruss, "gruss")
DIM gruss2 AS GUI_WIDGET : gruss2 = GUI_LABEL(s0, "Eine Oberflaeche fuer Spiele UND Anwendungen -- in Drachenhauch geschrieben, in Rust gezeichnet.", 42, 86)
DIM glas AS GUI_WIDGET : glas = GUI_PANEL(s0, 30, 130, 980, 270)
GUI_ADD_CLASS(glas, "glas")
DIM k1 AS GUI_WIDGET : k1 = GUI_CARD(s0, 60, 160, 290, 210, -1, "Lebendig", "Formen, Bildhaeute, Animationen, Klaenge und Funken -- alles aus einer Stildatei.")
DIM k2 AS GUI_WIDGET : k2 = GUI_CARD(s0, 375, 160, 290, 210, -1, "Zugaenglich", "Bildschirmleser, Tastatur, hoher Kontrast, von rechts nach links -- und eine eingebaute Pruefung.")
DIM k3 AS GUI_WIDGET : k3 = GUI_CARD(s0, 690, 160, 290, 210, -1, "Sparsam", "Schlaeft, solange nichts passiert: die IDE braucht im Leerlauf ein Zwoelftel der Rechenzeit.")
GUI_SET_NAME(k1, "k1") : GUI_SET_NAME(k2, "k2") : GUI_SET_NAME(k3, "k3")
DIM los AS GUI_WIDGET : los = GUI_BUTTON(s0, "Los geht's", 40, 430, 260, 64)
GUI_ADD_CLASS(los, "los")
DIM emojiZeile AS GUI_WIDGET : emojiZeile = GUI_LABEL(s0, CHR$(&H1F600) + " " + CHR$(&H1F389) + " " + CHR$(&H1F44D) + CHR$(&H1F3FD) + " " + CHR$(&H1F680) + " " + CHR$(&H1F308) + " " + CHR$(&H2728), 340, 440)
GUI_SET_NAME(emojiZeile, "emoji")
DIM kreisel AS GUI_WIDGET : kreisel = GUI_BUSY(s0, 950, 450, 44)
DIM hinweis0 AS GUI_WIDGET : hinweis0 = GUI_LABEL(s0, "Tipp: Strg+Umschalt+P sucht in allen Menues -- probier oben die Schalter, sie wirken auf ALLES.", 42, 540)

' --------------------------------------------------- 1 Bedienelemente
DIM s1 AS GUI_WINDOW : s1 = seite("Bedienelemente")
DIM arten AS ARRAY OF STRING : arten = ["standard", "primaer", "erfolg", "warnung", "gefahr", "umriss", "flach", "link"]
DIM k AS INTEGER
FOR k = 0 TO 7
    DIM kn AS GUI_WIDGET : kn = GUI_BUTTON(s1, UPPER$(LEFT$(arten[k], 1)) + MID$(arten[k], 1, LEN(arten[k])), 20 + k * 124, 20, 114, 36)
    GUI_BUTTON_VARIANT(kn, arten[k])
NEXT
DIM gb1 AS GUI_WIDGET : gb1 = GUI_GROUPBOX(s1, 20, 80, 300, 170, "Waehlen")
DIM cb1 AS GUI_WIDGET : cb1 = GUI_CHECKBOX(s1, "Newsletter", 36, 110, TRUE)
DIM cb2 AS GUI_WIDGET : cb2 = GUI_CHECKBOX(s1, "Rechnung per Post", 36, 140)
DIM r1 AS GUI_WIDGET : r1 = GUI_RADIO(s1, "lief", "Abholen", 36, 180)
DIM r2 AS GUI_WIDGET : r2 = GUI_RADIO(s1, "lief", "Liefern", 150, 180)
DIM t1 AS GUI_WIDGET : t1 = GUI_TOGGLE(s1, "Dunkle Ecken", 36, 214, TRUE)
DIM gb2 AS GUI_WIDGET : gb2 = GUI_GROUPBOX(s1, 340, 80, 400, 170, "Einstellen")
DIM regler AS GUI_WIDGET : regler = GUI_SLIDER(s1, 356, 112, 240, 0, 100, 62)
DIM fort AS GUI_WIDGET : fort = GUI_PROGRESS(s1, 356, 150, 240, 18)
DIM laufband AS GUI_WIDGET : laufband = GUI_PROGRESS(s1, 356, 186, 240, 12)
GUI_PROGRESS_SET(laufband, "unbestimmt", 1)
DIM knopf AS GUI_WIDGET : knopf = GUI_KNOB(s1, 630, 104, 90, 0, 100, 40)
DIM zahl AS GUI_WIDGET : zahl = GUI_SPINNER(s1, 356, 212, 120, 0, 20, 5)
DIM frucht AS GUI_WIDGET : frucht = GUI_DROPDOWN(s1, 760, 104, 240, 30, ["Apfel", "Birne", "Kirsche", "Mango", "Quitte"])
DIM vregler AS GUI_WIDGET : vregler = GUI_VSLIDER(s1, 960, 150, 100, 0, 10, 7)
DIM gb3 AS GUI_WIDGET : gb3 = GUI_GROUPBOX(s1, 20, 270, 980, 190, "Formen")
DIM pille AS GUI_WIDGET : pille = GUI_BUTTON(s1, "Pille", 40, 310, 160, 50)
DIM kreis AS GUI_WIDGET : kreis = GUI_BUTTON(s1, "", 230, 300, 72, 72)
DIM raute AS GUI_WIDGET : raute = GUI_BUTTON(s1, "Raute", 330, 300, 150, 80)
GUI_SET_SHAPE(pille, "pille") : GUI_SET_SHAPE(kreis, "kreis") : GUI_SET_SHAPE(raute, "raute")
GUI_SET_ICON(kreis, "einstellungen")
GUI_TOOLTIP(kreis, "Einstellungen (rund -- auch der Treffer)")
GUI_SET_NAME(kreis, "kreis") : GUI_SET_NAME(raute, "raute")
DIM formHinweis AS GUI_WIDGET : formHinweis = GUI_LABEL(s1, "Die Form gilt auch fuer den Klick --" + CHR$(10) + "neben dem Kreis trifft man nicht.", 510, 316)
DIM meldung1 AS GUI_WIDGET : meldung1 = GUI_LABEL(s1, "", 40, 400)

' --------------------------------------------------- 2 Text & Emoji
DIM s2 AS GUI_WINDOW : s2 = seite("Text & Emoji")
DIM name AS GUI_WIDGET : name = GUI_TEXTINPUT(s2, 20, 20, 320, 32, "Dein Name")
DIM code AS GUI_WIDGET : code = GUI_TEXTAREA(s2, 20, 70, 480, 300)
GUI_TEXTAREA_SET(code, "zeilennummern", 1)
GUI_TEXTAREA_SET(code, "aktive_zeile", 1)
GUI_SET_TEXT(code, "' Ein Code-Feld: Nummern, aktive Zeile," + CHR$(10) + "' mehrere Marken (Alt+Klick), Faltung" + CHR$(10) + "FUNCTION gruss(name AS STRING) AS STRING" + CHR$(10) + "    RETURN " + CHR$(34) + "Hallo, " + CHR$(34) + " + name" + CHR$(10) + "END FUNCTION" + CHR$(10) + CHR$(10) + "PRINT gruss(" + CHR$(34) + "Welt" + CHR$(34) + ")")
DIM gesetzt AS GUI_WIDGET : gesetzt = GUI_RICHTEXT(s2, 520, 20, 500, 350, "# Gesetzter Text" + CHR$(10) + CHR$(10) + "Ueberschriften, **fett**, *kursiv*, `code` und Listen:" + CHR$(10) + CHR$(10) + "- Absaetze brechen um" + CHR$(10) + "- Tabellen stehen in Spalten" + CHR$(10) + "- Verweise lassen sich anklicken" + CHR$(10) + CHR$(10) + "| Was | Wie |" + CHR$(10) + "|---|---|" + CHR$(10) + "| Markdown | ein Ausschnitt |" + CHR$(10) + "| Emoji | " + CHR$(&H1F600) + " in Farbe |")
DIM emojiGross AS GUI_WIDGET : emojiGross = GUI_LABEL(s2, "Emoji in Farbe:  " + CHR$(&H1F600) + " " + CHR$(&H1F389) + " " + CHR$(&H1F44D) + CHR$(&H1F3FD) + " " + CHR$(&H1F680) + " " + CHR$(&H1F308) + " " + CHR$(&H1F31F) + " " + CHR$(&H1F984), 20, 396)
GUI_SET_NAME(emojiGross, "emojigross")
DIM schriften AS GUI_WIDGET : schriften = GUI_LABEL(s2, "Hindi " + CHR$(&H928) + CHR$(&H92E) + CHR$(&H938) + CHR$(&H94D) + CHR$(&H924) + CHR$(&H947) + "   Arabisch " + CHR$(&H645) + CHR$(&H631) + CHR$(&H62D) + CHR$(&H628) + CHR$(&H627) + "   Hebraeisch " + CHR$(&H5E9) + CHR$(&H5DC) + CHR$(&H5D5) + CHR$(&H5DD) + "   Japanisch " + CHR$(&H3053) + CHR$(&H3093) + CHR$(&H306B) + CHR$(&H3061) + CHR$(&H306F) + "   Thai " + CHR$(&HE2A) + CHR$(&HE27) + CHR$(&HE31) + CHR$(&HE2A) + CHR$(&HE14) + CHR$(&HE35), 20, 456)
GUI_SET_NAME(schriften, "schriften")
DIM hallo AS GUI_WIDGET : hallo = GUI_LABEL(s2, "", 360, 26)

' --------------------------------------------------- 3 Daten
DIM s3 AS GUI_WINDOW : s3 = seite("Daten")
DIM gross AS GUI_WIDGET : gross = GUI_TABLE(s3, 20, 20, 620, 420)
GUI_TABLE_HEADERS(gross, ["Nr", "Kunde", "Stadt", "Umsatz"])
GUI_TABLE_VIRTUAL(gross, 1000000)
DIM staedte AS ARRAY OF STRING : staedte = ["Berlin", "Hamburg", "Muenchen", "Koeln", "Leipzig", "Bremen", "Dresden", "Kiel"]
DIM baum AS GUI_WIDGET : baum = GUI_TREE(s3, 660, 20, 360, 200)
DIM bw AS INTEGER : bw = GUI_TREE_ADD(baum, -1, "Projekt")
DIM bq AS INTEGER : bq = GUI_TREE_ADD(baum, bw, "quellen")
GUI_TREE_ADD(baum, bq, "main.dh")
GUI_TREE_ADD(baum, bq, "spieler.dh")
DIM bb AS INTEGER : bb = GUI_TREE_ADD(baum, bw, "bilder")
GUI_TREE_ADD(baum, bb, "held.png")
GUI_TREE_ADD(baum, bw, "LIESMICH.md")
GUI_TREE_EXPAND(baum, bw, TRUE)
GUI_TREE_EXPAND(baum, bq, TRUE)
DIM bt AS GUI_WIDGET : bt = GUI_TREETABLE(s3, 660, 240, 360, 200, ["Ordner", "Groesse"])
DIM tw AS INTEGER : tw = GUI_TREETABLE_ADD(bt, -1, ["Dokumente", "1,2 GB"])
GUI_TREETABLE_ADD(bt, tw, ["Rechnungen", "240 MB"])
GUI_TREETABLE_ADD(bt, tw, ["Fotos", "980 MB"])
DIM tm AS INTEGER : tm = GUI_TREETABLE_ADD(bt, -1, ["Musik", "3,4 GB"])
GUI_TREETABLE_ADD(bt, tm, ["Jazz", "1,1 GB"])
GUI_TREETABLE_EXPAND_ALL(bt, TRUE)
DIM liste AS GUI_WIDGET : liste = GUI_LISTBOX(s3, 20, 476, 1000, 150, ["Milch", "Brot", "Kaese", "Aepfel", "Kaffee", "Honig"])
DIM preise AS ARRAY OF STRING : preise = ["1,19 EUR", "2,49 EUR", "3,99 EUR", "2,79 EUR", "6,49 EUR", "4,29 EUR"]
FOR k = 0 TO 5
    GUI_LISTBOX_DETAIL(liste, k, preise[k])
NEXT
DIM datenHinweis AS GUI_WIDGET : datenHinweis = GUI_LABEL(s3, "Eine Million Zeilen: die Tabelle haelt nur, was um den sichtbaren Bereich geliefert wurde.", 22, 444)

SUB tabelleLiefern()
    DIM von AS INTEGER : von = GUI_TABLE_NEED_FROM(gross)
    IF von < 0 THEN EXIT SUB
    DIM r AS INTEGER
    FOR r = von TO von + GUI_TABLE_NEED_COUNT(gross) - 1
        GUI_TABLE_SUPPLY(gross, r, [STR$(r + 1), "Kunde " + STR$(r + 1), staedte[r MOD 8], FORMAT$((r * 37) MOD 9973 + 0.5, "%.2f") + " EUR"])
    NEXT
END SUB

' --------------------------------------------------- 4 Auswahl
DIM s4 AS GUI_WINDOW : s4 = seite("Auswahl")
DIM farbe AS GUI_WIDGET : farbe = GUI_COLORPICKER(s4, 20, 20, 340, 260)
