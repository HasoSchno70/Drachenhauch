=== send dir meldet fehlende dateien als 404
' Eine fehlende Datei ist der Alltag eines Servers und darf das Programm nicht
' anhalten -- der Rueckgabewert sagt es trotzdem.
IMPORT "klient.dh"
DIM port AS INTEGER : port = serverStarten("srv.dh")
PRINT status(holen$(port, "GET", "/gibtsnicht.html", "", ""))
serverEnde()
PRINT "server: " + TRIM$(srvAusgabe)
--- datei klient.dh
IMPORT "{sammlung}/_hilfen/httpklient.dh"

--- datei web/index.html
<h1>Start</h1>
