=== enter im nativen dialog drueckt den standard-knopf
' WM_SETFOCUS (7), dann WM_KEYDOWN/WM_KEYUP VK_RETURN (13, Scancode 0x1C).
IMPORT "helfer.dh"
PRINT sende$(skript$(), "dialog.dh", "roh:7:0:0;roh:256:13:1835009;roh:257:13:3223060481", "modal")
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fenstersender.ps1"
END FUNCTION
FUNCTION hilfe$(name AS STRING) AS STRING
    RETURN "{sammlung}/../_hilfen/" + name
END FUNCTION
FUNCTION ps$(skriptname AS STRING, a AS STRING, b AS STRING) AS STRING
    DIM p AS INTEGER : p = PROCESS_START("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", hilfe$(skriptname), a, b)
    RETURN auslesen$(p, 30000)
END FUNCTION
--- datei dialog.dh
IMPORT "gui"
' ARG$(0) = Kennung; ARG$(1) = "haupt": das Hauptfenster traegt sie (dorthin
' schickt der Sender), sonst der Dialog. "frei": der Dialog ist nicht modal.
DIM kennung AS STRING : kennung = ARG$(0)
DIM art AS STRING : art = ARG$(1)
SCREEN(500, 300, IIF(art = "haupt", kennung, "Haupt-" + kennung), 1)
DIM haupt AS GUI_WINDOW : haupt = GUI_WINDOW("Haupt", 10, 10, 300, 200)
DIM hk AS GUI_WIDGET : hk = GUI_BUTTON(haupt, "Haupt-Knopf", 20, 40, 120, 30)
DIM d AS GUI_WINDOW : d = GUI_WINDOW(IIF(art = "haupt", "Dialog-" + kennung, kennung), 60, 60, 260, 140)
DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(d, "OK", 30, 80, 80, 30)
DIM ab AS GUI_WIDGET : ab = GUI_BUTTON(d, "Abbrechen", 130, 80, 100, 30)
DIM feld AS GUI_WIDGET : feld = GUI_TEXTINPUT(d, 30, 30, 200, 26)
GUI_WINDOW_DEFAULT(d, ok)
GUI_WINDOW_CANCEL(d, ab)
DIM kontext AS INTEGER : kontext = GUI_CONTEXT(d)
DIM eintrag AS INTEGER : eintrag = GUI_MENU_ITEM(kontext, "Einfuegen")
GUI_CONTEXT_WIDGET(kontext, feld)
IF art <> "frei" THEN GUI_WINDOW_MODAL(d, TRUE)
DIM nativ AS BOOLEAN : nativ = GUI_WINDOW_NATIVE(d, TRUE)
DIM t0 AS INTEGER : t0 = MILLIS()
DIM hkl AS INTEGER
DIM okl AS INTEGER
DIM abl AS INTEGER
WHILE NOT QUITREQUESTED() AND MILLIS() - t0 < 9000
    GUI_UPDATE()
    IF GUI_CLICKED(hk) THEN hkl = hkl + 1
    IF GUI_CLICKED(ok) THEN okl = okl + 1
    IF GUI_CLICKED(ab) THEN abl = abl + 1
    CLS(&H202830) : GUI_DRAW() : FLIP()
WEND
PRINT "nativ "; nativ
PRINT "klicks haupt "; hkl; " ok "; okl; " abbrechen "; abl
--- system windows
--- erwartet
gesendet
nativ TRUE
klicks haupt 0 ok 1 abbrechen 0

