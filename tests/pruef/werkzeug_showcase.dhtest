--- datei wurzel/examples/09_shapes.dh
PRINT 1
--- datei _programm/ev.txt
c 4
e 120 7 350 440 0 0
e 121 7 350 440 0 0
e 122 6 0 0 0 0
e 124 5 0 0 0 0

--- verzeichnis wurzel/docs
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
PRINT "kacheln 1 "; hat("kacheln 1")
PRINT "kachel 09 "; hat("kachel 09_shapes.dh")
--- erwartet
kacheln 1 TRUE
kachel 09 TRUE

