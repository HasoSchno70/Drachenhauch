=== pdf: spruenge rot gestrichelt, die pfade durchscheinend
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")

FUNCTION strom$(pfad AS STRING) AS STRING
    DIM s AS ARRAY OF STRING : s = pdfSeiten(pfad)
    DIM w AS ARRAY OF STRING : w = pdfWoerter()
    DIM i AS INTEGER, gs AS INTEGER, z AS STRING
    DIM striche AS MAP OF INTEGER : striche = {}
    FOR i = 0 TO LEN(w) - 1
        IF w[i] = "d" THEN
            DIM k AS STRING : k = w[i - 3] + " " + w[i - 2] + " " + w[i - 1]
            IF MAPHAS(striche, k) THEN MAPPUT(striche, k, MAPGET(striche, k) + 1) ELSE MAPPUT(striche, k, 1)
        END IF
        IF w[i] = "gs" THEN gs = gs + 1
    NEXT
    DIM k2 AS STRING
    FOR EACH k2 IN MAPKEYS(striche)
        z = z + k2 + " x" + STR$(MAPGET(striche, k2)) + " "
    NEXT
    RETURN z + "| gs " + STR$(gs)
END FUNCTION
DIM o AS kern.PdfOptionen : o = NEW kern.PdfOptionen()
o.datum = "16.10.2026"
DIM r AS kern.Stickpfad : r = kern.stickpfadBerechnen(m, kern.SP_NACHBAR, 14)
PRINT "spruenge "; r.spruenge; " linien "; r.stiche - LEN(r.pfade)
DIM ab AS ARRAY OF STRING : ab = kern.pdfExportieren(m, "a.pdf", o)
PRINT "mit: "; strom$("a.pdf")
o.stickpfad = FALSE
ab = kern.pdfExportieren(m, "b.pdf", o)
PRINT "ohne: "; strom$("b.pdf")
