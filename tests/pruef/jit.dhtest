=== schleife in einer funktion mit ausgabe
FUNCTION zaehle(n AS INTEGER) AS INTEGER
    DIM a AS INTEGER
    DIM b AS FLOAT
    DIM j AS INTEGER
    PRINT "los"
    FOR j = 1 TO n
        a = a + j
        b = b + 1.5
    NEXT
    PRINT "fertig "; b
    RETURN a
END FUNCTION
PRINT zaehle(1000); " "; zaehle(3)
--- erwartet
los
fertig 1500.0
los
fertig 4.5
500500 6

