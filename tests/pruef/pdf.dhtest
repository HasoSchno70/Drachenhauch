' Aus test_pdf.py uebertragen (20 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== ein leeres dokument laesst sich oeffnen
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_SAVE(p, "a.pdf")
--- erwartet

=== a4 ist die vorgabe
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_SAVE(p, "a.pdf")
--- erwartet

=== querformat und andere groessen
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW("a5", "quer")
PDF_SAVE(p, "a.pdf")
--- erwartet

=== text kommt an
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_TEXT(p, 20, 25, "Rechnung 4711")
PDF_SAVE(p, "a.pdf")
--- erwartet

=== umlaute kommen an
' Seit dem Umbau auf krilla (2026-09-14) ist der Text Unicode, die Schrift eingebettet.
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_TEXT(p, 20, 25, "Grüße aus Köln")
PDF_SAVE(p, "a.pdf")
--- erwartet

=== millimeter von oben
' Der Unterschied zu rohem PDF: dort wird in Punkten von UNTEN
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "helvetica", 10)
PDF_TEXT(p, 20, 25, "Marke")
PDF_SAVE(p, "a.pdf")
--- erwartet

=== mehrere seiten
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_TEXT(p, 20, 25, "eins")
PDF_PAGE(p)
PDF_TEXT(p, 20, 25, "zwei")
PRINT PDF_PAGE_COUNT(p)
PDF_SAVE(p, "a.pdf")
--- erwartet
2

=== schriften landen auf der seite
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "helvetica-fett", 18)
PDF_TEXT(p, 20, 25, "fett")
PDF_FONT(p, "times", 11)
PDF_TEXT(p, 20, 40, "times")
PDF_SAVE(p, "a.pdf")
--- erwartet

=== striche und flaechen
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_LINE(p, 20, 45, 190, 45)
PDF_RECT(p, 20, 50, 40, 10)
PDF_RECT_FILL(p, 70, 50, 40, 10)
PDF_SAVE(p, "a.pdf")
--- erwartet

=== farbe wirkt
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_COLOR(p, RGB(220, 30, 30))
PDF_RECT_FILL(p, 20, 50, 40, 10)
PDF_SAVE(p, "a.pdf")
--- erwartet

=== titel steht in den angaben
' Der Fehler, den erst der fremde Leser zeigte: im Trailer sieht ihn
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_TITLE(p, "Rechnung 4711")
PDF_SAVE(p, "a.pdf")
--- erwartet

=== einstellungen gelten ueber den seitenwechsel
' Schrift und Farbe sind Sache des Dokuments, nicht der Seite -- alles
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "courier-fett", 14)
PDF_PAGE(p)
PDF_TEXT(p, 20, 25, "zweite")
PDF_SAVE(p, "a.pdf")
--- erwartet

=== breite bei mono ist exakt
' courier meint DejaVu Sans Mono: jedes Zeichen 1233/2048 der Schriftgroesse --
' der Wert stimmt mit PyMuPDF auf derselben Schriftdatei ueberein.
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "courier", 10)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "1234567890"), "%.3f")
--- erwartet ungefaehr
21.239

=== breite bei helvetica und times stimmt mit pymupdf ueberein
' helvetica und times meinen DejaVu Sans und Serif. Die Werte kommen von PyMuPDF
' auf denselben Schriftdateien -- bis auf helvetica und helvetica-fett-kursiv:
' dort wirken Unterschneidungspaare, die PDF_TEXT_WIDTH wie das Zeichnen
' mitnimmt und PyMuPDFs Summe nicht (66.5019 und 74.1853 ohne).
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "helvetica", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "Rechnung 1.234,56 € für Größe W"), "%.4f")
PDF_FONT(p, "helvetica-fett", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "Rechnung 1.234,56 € für Größe W"), "%.4f")
PDF_FONT(p, "helvetica-kursiv", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "Rechnung 1.234,56 € für Größe W"), "%.4f")
PDF_FONT(p, "helvetica-fett-kursiv", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "Rechnung 1.234,56 € für Größe W"), "%.4f")
PDF_FONT(p, "times", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "Rechnung 1.234,56 € für Größe W"), "%.4f")
PDF_FONT(p, "times-fett", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "Rechnung 1.234,56 € für Größe W"), "%.4f")
PDF_FONT(p, "times-kursiv", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "Rechnung 1.234,56 € für Größe W"), "%.4f")
PDF_FONT(p, "times-fett-kursiv", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "Rechnung 1.234,56 € für Größe W"), "%.4f")
--- erwartet ungefaehr
66.2423
74.1853
66.5019
73.9920
67.7487
74.6704
67.7487
74.6704

=== unterschneidung wird mitgemessen
' "AV" ist schmaler als "A" und "V" einzeln -- genau so setzt es krilla.
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "sans", 11)
PRINT PDF_TEXT_WIDTH(p, "AV") < PDF_TEXT_WIDTH(p, "A") + PDF_TEXT_WIDTH(p, "V")
PDF_FONT(p, "mono", 11)
PRINT FORMAT$(PDF_TEXT_WIDTH(p, "AV"), "%.6f") = FORMAT$(PDF_TEXT_WIDTH(p, "A") + PDF_TEXT_WIDTH(p, "V"), "%.6f")
--- erwartet
TRUE
TRUE

=== symbol gibt es nicht mehr
' Seit die Schriften eingebettet werden, hat sans die Zeichen selbst.
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "symbol", 11)
--- fehler
PDF_FONT: die Schrift 'symbol' gibt es nicht mehr

=== breite eines fehlenden zeichens ist ein fehler
' DejaVu hat kein Chinesisch -- geschaetzt wird nicht.
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "helvetica", 11)
PRINT PDF_TEXT_WIDTH(p, "a" + CHR$(20013))
--- fehler
PDF_TEXT_WIDTH: die Schrift 'sans' hat kein Zeichen '中' (U+4E2D)

=== griechisch kyrillisch und zeichen haben ein mass
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PRINT PDF_TEXT_WIDTH(p, "Ωμέγα Привет ✓ → ★") > 0
--- erwartet
TRUE

=== unbekannte schrift zaehlt die moeglichen auf
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "comic sans", 12)
--- fehler
PDF_FONT: Schrift 'comic sans' gibt es nicht. Eingebaut sind sans, sans-fett, sans-kursiv, sans-fett-kursiv, serif, serif-fett, serif-kursiv, serif-fett-kursiv, mono, mono-fett, mono-kursiv, mono-fett-kursiv (helvetica, times und courier meinen sans, serif und mono); eine eigene laedt PDF_FONT_LOAD

=== unbekannte seitengroesse
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW("din a4")
--- fehler
PDF_NEW: Seitengroesse 'din a4' kenne ich nicht -- a3, a4, a5, a6, letter, legal

=== ein zeichen das die schrift nicht hat
' Kein stilles leeres Kaestchen: auf einer Rechnung ist ein verschwundenes
' Zeichen schlimmer als eine Meldung. (Ein Emoji wie U+1F600 hat DejaVu Sans.)
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_TEXT(p, 20, 25, "Rechnung " + CHR$(20013))
--- fehler
PDF_TEXT: die Schrift 'sans' hat kein Zeichen '中' (U+4E2D)

=== klammern im text brechen nichts
' In PDF begrenzen Klammern die Zeichenkette -- ohne Schutz waere die
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_TEXT(p, 20, 25, "Posten (2 Stueck) \ Rest")
PDF_SAVE(p, "a.pdf")
--- erwartet

=== zweimal dasselbe ergibt dieselbe datei
' Kein Erstellungsdatum im Dokument: zwei Laeufe, mehr als eine Sekunde
' auseinander, schreiben Byte fuer Byte dieselbe Datei.
' (Bis Stufe 44 in test_pdf.py.)
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_TEXT(p, 20, 25, "gleich")
IF FILEEXISTS("a.pdf") THEN
    SLEEP(1100)
    PDF_SAVE(p, "b.pdf")
ELSE
    PDF_SAVE(p, "a.pdf")
END IF
--- nochmal

--- nachher
PRINT "beide da " ; FILEEXISTS("a.pdf") AND FILEEXISTS("b.pdf")
PRINT "gleich " ; BUFFER_TO_HEX$(READALL_BYTES("a.pdf")) = BUFFER_TO_HEX$(READALL_BYTES("b.pdf"))
--- erwartet
beide da TRUE
gleich TRUE

=== der text kommt als unicode im pdf an
' Gelesen ueber die ToUnicode-Tabellen der eingebetteten Schriften (pdftext.dh),
' nicht ueber PyMuPDF: drei Schriften, Griechisch, Kyrillisch, Euro und Haken.
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT(p, "sans-fett", 14)
PDF_TEXT(p, 20, 20, "Rechnung Nr. 4711 – Grüße")
PDF_FONT(p, "serif", 11)
PDF_TEXT(p, 20, 30, "Ωμέγα und Привет")
PDF_PAGE(p)
PDF_FONT(p, "mono", 10)
PDF_TEXT(p, 20, 20, "Summe 1.234,56 € ✓")
PDF_SAVE(p, "a.pdf")
--- datei pdftext.dh
IMPORT "{sammlung}/_hilfen/pdftext.dh"

--- nachher
IMPORT "pdftext.dh"
DIM s AS ARRAY OF STRING : s = pdfSeiten("a.pdf")
PRINT "seiten "; LEN(s)
PRINT s[0]
PRINT s[1]
--- erwartet
seiten 2
Rechnung Nr. 4711 – Grüße
Ωμέγα und Привет

Summe 1.234,56 € ✓

=== eine eigene schrift laden
' Arial liegt auf jedem Windows -- auf den anderen Systemen gibt es keine Datei,
' die sicher da ist.
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT_LOAD(p, "C:/Windows/Fonts/arial.ttf", "Hausschrift")
PDF_FONT(p, "hausschrift", 12)
PRINT PDF_TEXT_WIDTH(p, "Rechnung") > 0
PDF_TEXT(p, 20, 25, "Rechnung")
PDF_SAVE(p, "a.pdf")
PRINT FILEEXISTS("a.pdf")
--- system windows
--- erwartet
TRUE
TRUE

=== eine eigene schrift braucht eine lesbare datei
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT_LOAD(p, "keine.ttf", "x")
--- datei keine.ttf
das ist keine schrift

--- fehler
PDF_FONT_LOAD: 'x' ist keine lesbare TrueType- oder OpenType-Schrift

=== eine eigene schrift darf keine eingebaute meinen
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT_LOAD(p, "keine.ttf", "Courier-Fett")
--- datei keine.ttf
egal

--- fehler
PDF_FONT_LOAD: eine Schrift 'Courier-Fett' gibt es schon

=== eine fehlende schriftdatei nennt ihren pfad
IMPORT "pdf"
DIM p AS PDF
p = PDF_NEW()
PDF_FONT_LOAD(p, "gibtsnicht.ttf", "x")
--- fehler
PDF_FONT_LOAD: gibtsnicht.ttf:
