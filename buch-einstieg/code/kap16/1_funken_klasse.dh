' Kapitel 16 -- dieselben Funken wie in Kapitel 14, aber als Klasse.
' Aus fuenf parallelen Arrays wird eines.

CLASS Funke
    DIM x AS FLOAT
    DIM y AS FLOAT
    DIM vx AS FLOAT
    DIM vy AS FLOAT
    DIM leben AS INTEGER

    SUB Init()
        Neustart()
        leben = RANDINT(0, 90)
    END SUB

    SUB Neustart()
        x = 320
        y = 380
        vx = RANDINT(-40, 40) / 10.0
        vy = RANDINT(-95, -55) / 10.0
        leben = RANDINT(60, 110)
    END SUB

    SUB Schritt()
        leben = leben - 1
        IF leben <= 0 THEN Neustart()
        vy = vy + 0.11
        x = x + vx
        y = y + vy
    END SUB

    SUB Malen()
        DIM h AS INTEGER
        h = leben * 2
        IF h > 255 THEN h = 255
        CIRCLE(x, y, 2, RGB(255, h, 40))
    END SUB
END CLASS

SCREEN(640, 400, "Funken als Klasse")

DIM funken[500] AS Funke
DIM i AS INTEGER

FOR i = 0 TO 499
    funken[i] = NEW Funke()
NEXT

WHILE NOT QUITREQUESTED() AND NOT KEYPRESSED(KEY_ESCAPE)
    CLS(RGB(10, 12, 24))

    FOR i = 0 TO 499
        funken[i].Schritt()
        funken[i].Malen()
    NEXT

    FLIP()
WEND
