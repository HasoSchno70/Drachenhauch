' Die Datei aus dem Aufbau der Kuehlschrank-App (PySide6) mit ein paar Zeilen.
SUB dateiAnlegen(pfad AS STRING)
    DIM db AS DB_CONN : db = DB_OPEN(pfad)
    DIM sql AS STRING
    FOR EACH sql IN READLINES("schema.sql")
        sql = TRIM$(sql)
        IF RIGHT$(sql, 1) = ";" THEN sql = LEFT$(sql, LEN(sql) - 1)
        IF sql <> "" THEN DB_EXEC(db, sql)
    NEXT
    DB_EXEC(db, "INSERT INTO products (barcode, name) VALUES ('4000', 'Milch')")
    DB_EXEC(db, "INSERT INTO inventory (product_id, expiry_date) VALUES (1, '2026-11-20')")
    DB_EXEC(db, "INSERT INTO app_settings (key, value, updated_at) VALUES ('theme', 'dark', '2026-11-08 10:00:00')")
    DB_EXEC(db, "INSERT INTO app_settings (key, value, updated_at) VALUES ('language', 'de', '2026-11-08 10:00:00')")
    DB_CLOSE(db)
END SUB
' Alles, was SQLite ueber den Aufbau weiss, und die Zeilen -- als ein Text.
