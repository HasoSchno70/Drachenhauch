threshold = 2
DIM big AS TUPLE
big = [n FOR n IN nums WHERE n > threshold]
PRINT big
--- erwartet
(3, 4)

=== comp with method call in transform (1)
DIM names AS TUPLE
names = ("alice", "bob", "cilla")
DIM upper AS TUPLE
upper = [n.upper() FOR n IN names]
PRINT upper
--- erwartet
(ALICE, BOB, CILLA)

=== comp with method call in transform (2)
