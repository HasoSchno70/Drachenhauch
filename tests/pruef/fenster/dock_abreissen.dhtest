=== ein fremder leser bedient die teilflaeche
' Weg E, Stufe 4: auch eine Teilflaeche hat ihren eigenen Baum -- gebaut mit
' ausgeliehenem Gastfenster, also nur mit den Widgets der Leiste. Der Leser
' drueckt ihren Knopf.
IMPORT "helfer.dh"
DIM kennung AS STRING : kennung = "TeilLeser-" + STR$(MILLIS()) + "-" + STR$(INT(RND() * 1000000))
DIM kind AS INTEGER : kind = PROCESS_START("dhrt", "run", CWD$() + "/teil.dh", "--", kennung, "raus")
DIM s AS STRING : s = leser$(kennung, "Listen-Knopf", "")
DIM k AS STRING : k = auslesen$(kind, 30000)
IF INSTR(auslesenFehler, "Kein Fenster moeglich") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    END
END IF
PRINT "knopf der leiste "; INSTR(s, "N: ControlType.Button [Listen-Knopf]") >= 0
PRINT "ohne das hauptfenster "; INSTR(s, "[Haupt-Knopf]") < 0
PRINT k;
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION leser$(titel AS STRING, klick AS STRING, wert AS STRING) AS STRING
    DIM p AS INTEGER : p = PROCESS_START("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{sammlung}/../_hilfen/uialeser_fenster.ps1", titel, klick, wert)
    RETURN auslesen$(p, 60000)
END FUNCTION
--- datei teil.dh
IMPORT "gui"
' Eine Leiste aus Widgets des Gastfensters (GUI_DOCK_ADD): Knopf, Textfeld,
' Farbfeld. ARG$(1): enthaelt "raus" = gleich als eigenes Fenster;
