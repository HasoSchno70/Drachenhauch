{"kind":"label","name":"lab","text":"Bereit","x":20,"y":10,"w":120,"h":20},
{"kind":"button","name":"knopf","text":"Speichern","tooltip":"Sichert alles","x":20,"y":40,"w":120,"h":28},
{"kind":"textinput","name":"feld","placeholder":"Name eingeben","x":20,"y":80,"w":200,"h":28},
{"kind":"table","name":"tab","table":{"headers":["Produkt","Menge"],"rows":[]},"x":20,"y":120,"w":300,"h":100},
