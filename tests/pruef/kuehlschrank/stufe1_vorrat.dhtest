' Kuehlschrank-App im Drachenhauch Studio, Stufe 1: der Vorrat
' (examples/studio/kuehlschrank: BestandSeite, ProduktFenster,
' MindestmengeFenster, Modul Bestand, Klassen Eintrag und Verlauf). Die
' Proben laufen im erzeugten Programm (F5 im Studio, dann main.dh mit einer
' Probe statt der Bildschleife), Heute ist fest (KUEHL_HEUTE).
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== tabelle, status, filter und suche
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
' Vier Produkte, je ein Eintrag: abgelaufen, heute, in drei Tagen, frisch;
' Butter hat eine Mindestmenge von 2 und liegt mit 1 darunter.
DB_EXEC(db, "INSERT INTO products (name, brand, category, min_quantity, min_unit) VALUES ('Milch', 'Hof', 'Milchprodukte', NULL, NULL), ('Butter', 'Alm', 'Milchprodukte', 2, 'Stück'), ('Brot', NULL, 'Backwaren', NULL, NULL), ('Reis', NULL, 'Grundnahrungsmittel', NULL, NULL)")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location, purchased_at_store) VALUES (1, 1, '📦 Stück', '2026-11-01', 'Kühlschrank', 'ALDI'), (2, 1, 'Stück', '2026-11-08', 'Kühlschrank', NULL), (3, 0.5, 'kg', '2026-11-11', 'Brotkasten', 'REWE'), (4, 2, 'kg', '2027-03-01', 'Vorratsraum', NULL)")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS BestandSeite : s = f.bestand
f.geaendert()
SUB zeilen(s AS BestandSeite)
    DIM z AS INTEGER
    FOR z = 0 TO GUI_TABLE_ROW_COUNT(s.tabelle) - 1
        PRINT "  "; GUI_TABLE_GET_CELL(s.tabelle, z, 0); " | "; GUI_TABLE_GET_CELL(s.tabelle, z, 2); " | "; GUI_TABLE_GET_CELL(s.tabelle, z, SP_MIN); " | "; GUI_TABLE_GET_CELL(s.tabelle, z, SP_MARKT); " | "; GUI_TABLE_GET_CELL(s.tabelle, z, SP_STATUS)
    NEXT
    PRINT "  "; GUI_TEXT(s.zusammenfassung)
END SUB
zeilen(s)
PRINT "kacheln "; GUI_CARD_TEXT$(f.kachelGesamt); " "; GUI_CARD_TEXT$(f.kachelBald); " "; GUI_CARD_TEXT$(f.kachelAbgelaufen)
s.knopfAbgelaufen_Klick()
PRINT "abgelaufen"
zeilen(s)
s.knopfBald_Klick()
PRINT "bald"
zeilen(s)
s.knopfMinimum_Klick()
PRINT "minimum"
zeilen(s)
s.knopfAlle_Klick()
GUI_SET_TEXT(s.sucheFeld, "REWE")
s.sucheFeld_Geaendert()
PRINT "suche rewe"
zeilen(s)
GUI_SET_TEXT(s.sucheFeld, "")
s.sucheFeld_Geaendert()
PRINT "einheit "; einheitText$("📦 Stück"); " | "; einheitText$("kg"); " | "; einheitText$("1 kg Packung")
--- erwartet
geprueft TRUE
  Milch | 1 Stück | - | ALDI | Abgelaufen
  Butter | 1 Stück | 2 Stück | - | Heute
  Brot | 0,5 kg | - | REWE | 3 Tage
  Reis | 2 kg | - | - | Frisch
  4 Einträge, 1 abgelaufen, 2 bald ablaufend.
kacheln 4 2 1
abgelaufen
  Milch | 1 Stück | - | ALDI | Abgelaufen
  1 Eintrag von 4, 1 abgelaufen.
bald
  Butter | 1 Stück | 2 Stück | - | Heute
  Brot | 0,5 kg | - | REWE | 3 Tage
  2 Einträge von 4, 2 bald ablaufend.
minimum
  Butter | 1 Stück | 2 Stück | - | Heute
  1 Eintrag von 4, 1 bald ablaufend.
suche rewe
  Brot | 0,5 kg | - | REWE | 3 Tage
  1 Eintrag von 4, 1 bald ablaufend.
einheit Stück | kg | 1 kg Packung
