=== probe: einrasten, druck, pinch, dialog
IMPORT "helfer.dh"
' --probe-stufe23 mit alle.pxs: Knopf und Befehl, Linie/Rechteck/Rand/
' Vieleck eingerastet, Stift nicht, aus wieder genau; Pinsel nach Druck
' (Zustand wie nach einem Stift), Maus-Ereignis ohne Druck; Pinch an/aus und
' eine Folge; die Felder im Einstellungsdialog.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe23", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    PRINT "leiste "; FILEEXISTS("d_leiste.png")
    PRINT "datei unveraendert: "; READLINES("alle.pxs")[0] = READLINES("vorher.pxs")[0]
END IF
