=== gb-code baut jedes control ohne gui_load
' Ein Formular mit JEDER Art der Laufzeit. Der Code muss uebersetzen UND
' laufen -- eine Signatur, die nicht passt, faellt erst dort auf.
WRITEALL("code.dh", dhCode$())
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", "code.dh")
DIM bis AS INTEGER : bis = MILLIS() + 60000
DIM befund AS STRING : befund = ""
DIM stille AS INTEGER : stille = 0
WHILE MILLIS() < bis AND stille < 5
    DIM z AS STRING : z = PROCESS_READ$(pc)
    IF z <> "" THEN befund = befund + z : stille = 0
    IF z = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
WEND
PRINT "check " + befund
DIM pb AS INTEGER : pb = PROCESS_START("dhrt", "bild", "code.dh", "code.png", "3")
bis = MILLIS() + 60000
WHILE PROCESS_RUNNING(pb) AND MILLIS() < bis
WEND
PRINT "lauf " + STR$(PROCESS_CODE(pb)) + " " + STR$(FILEEXISTS("code.png"))
EXIT(0)
