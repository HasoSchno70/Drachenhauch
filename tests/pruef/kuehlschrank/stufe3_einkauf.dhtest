=== anlegen, schnellknoepfe, haken, auto-ergaenzen, loeschen -- mit rueckgaengig
' Ein Posten nimmt die Kategorie des Produkts gleichen Namens; die
' Schnellknoepfe zeigen, was am haeufigsten verbraucht wurde und nicht schon
' offen auf der Liste steht. Auto-Ergaenzen nimmt jedes Produkt unter der
' Mindestmenge (Bestand zusammengezaehlt), das nicht schon offen dasteht.
' Der Haken ist kein Schritt, alles andere einer.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO products (name, brand, category, min_quantity, min_unit) VALUES ('Käse', NULL, 'Milchprodukte', NULL, NULL), ('Milch', NULL, 'Milchprodukte', 3, 'Liter'), ('Nudeln', 'Barilla', NULL, 2, 'Packung'), ('Bananen', NULL, 'Obst', 4, 'Stück')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location) VALUES (2, 1, 'Liter', '2026-11-20', 'Kühlschrank'), (2, 0.5, 'Liter', '2026-11-21', 'Kühlschrank'), (4, 5, 'Stück', '2026-11-15', 'Obstschale')")
DB_EXEC(db, "INSERT INTO consumption_history (product_name, quantity, unit, reason, removed_date) VALUES ('Joghurt', 1, 'Stück', 'consumed', '2026-11-01'), ('Joghurt', 1, 'Stück', 'consumed', '2026-11-02'), ('Milch', 1, 'Liter', 'consumed', '2026-11-03'), ('Brot', 1, 'Stück', 'consumed', '2026-11-04')")
DB_EXEC(db, "INSERT INTO shopping_list (product_name, quantity, unit, checked) VALUES ('Brot', 1, 'Stück', 0)")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS EinkaufSeite : s = f.einkauf
f.geaendert()
FUNCTION stand$() AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT GROUP_CONCAT(product_name || ':' || quantity || ':' || IFNULL(category, '-') || ':' || checked, ' ') FROM (SELECT * FROM shopping_list ORDER BY id)")
    DIM t AS STRING : t = "-"
    IF DB_NEXT(r) THEN
        IF NOT DB_IS_NULL(r, 0) THEN t = DB_GET_STRING(r, 0)
    END IF
    RETURN t
END FUNCTION
FUNCTION knoepfe$(s AS EinkaufSeite) AS STRING
    DIM t AS STRING : t = ""
    DIM k AS INTEGER
    FOR EACH k IN [s.schnell0, s.schnell1, s.schnell2, s.schnell3, s.schnell4]
        IF GUI_VISIBLE(k) THEN t = t + "[" + GUI_TEXT(k) + "]"
    NEXT
    RETURN t + IIF(GUI_VISIBLE(s.schnellLeer), " leer", "")
END FUNCTION
PRINT "start "; stand$(); " | schnell "; knoepfe$(s)
GUI_SET_TEXT(s.namenFeld, "ban")
s.namenFeld_Geaendert()
PRINT "vorschlag "; GUI_DROPDOWN_COUNT(s.vorschlagListe); " "; GUI_DROPDOWN_ITEM(s.vorschlagListe, 1)
GUI_DROPDOWN_SET_SELECTED(s.vorschlagListe, 1)
s.vorschlagListe_Geaendert()
PRINT "gewaehlt "; GUI_TEXT(s.namenFeld)
GUI_SET_TEXT(s.namenFeld, "Käse")
GUI_SET_VALUE(s.mengeFeld, 2)
s.knopfHinzufuegen_Klick()
PRINT "kaese "; stand$(); " | "; verlauf.textZurueck$(); " | feld ["; GUI_TEXT(s.namenFeld); "]"
s.schnell0_Klick()
PRINT "schnell "; stand$(); " | "; knoepfe$(s)
GUI_TABLE_CELL_VALUE(s.tabelle, ARRAY_INDEXOF(s.ids, 1), SP_HAKEN, 1)
s.tabelle_Zelle(ARRAY_INDEXOF(s.ids, 1), SP_HAKEN)
PRINT "haken "; stand$(); " | "; GUI_TEXT(s.statistik); " | "; verlauf.textZurueck$()
s.knopfAlle_Klick()
PRINT "alle "; stand$()
s.knopfAlle_Klick()
PRINT "keiner "; stand$()
PRINT "auto "; autoErgaenzen(); " | "; stand$()
PRINT "nochmal "; autoErgaenzen()
f.miRueckgaengig_Aktion()
PRINT "zurueck "; stand$()
f.miWiederholen_Aktion()
postenHaken(1, TRUE)
postenHaken(2, TRUE)
PRINT "erledigte "; erledigteLoeschen(); " | "; stand$()
postenLoeschen(3, "Joghurt")
PRINT "geloescht "; stand$()
f.miRueckgaengig_Aktion()
f.miRueckgaengig_Aktion()
PRINT "zweimal zurueck "; stand$()
--- erwartet
start Brot:1.0:-:0 | schnell [Joghurt][Milch]
vorschlag 2 Bananen
gewaehlt Bananen
kaese Brot:1.0:-:0 Käse:2.0:Milchprodukte:0 | Käse auf die Einkaufsliste | feld []
schnell Brot:1.0:-:0 Käse:2.0:Milchprodukte:0 Joghurt:1.0:-:0 | [Milch]
haken Brot:1.0:-:1 Käse:2.0:Milchprodukte:0 Joghurt:1.0:-:0 | 🛒 2 offen  •  ✅ 1 erledigt  •  📋 3 gesamt | Joghurt auf die Einkaufsliste
alle Brot:1.0:-:1 Käse:2.0:Milchprodukte:1 Joghurt:1.0:-:1
keiner Brot:1.0:-:0 Käse:2.0:Milchprodukte:0 Joghurt:1.0:-:0
auto 2 | Brot:1.0:-:0 Käse:2.0:Milchprodukte:0 Joghurt:1.0:-:0 Milch:1.5:Milchprodukte:0 Nudeln:2.0:-:0
nochmal 0
zurueck Brot:1.0:-:0 Käse:2.0:Milchprodukte:0 Joghurt:1.0:-:0
erledigte 2 | Joghurt:1.0:-:0 Milch:1.5:Milchprodukte:0 Nudeln:2.0:-:0
geloescht Milch:1.5:Milchprodukte:0 Nudeln:2.0:-:0
zweimal zurueck Brot:1.0:-:1 Käse:2.0:Milchprodukte:1 Joghurt:1.0:-:0 Milch:1.5:Milchprodukte:0 Nudeln:2.0:-:0
