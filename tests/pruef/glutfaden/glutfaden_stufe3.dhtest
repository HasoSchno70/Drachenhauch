=== farbabstand wie in pysticky
' CIEDE2000 -- die Werte hat PySticky (core/color_math.delta_e) geliefert.
IMPORT "k.dh"
DIM paare AS ARRAY OF INTEGER : paare = [&HFF0000, &HFE0000, &H0097E1, &H7DC8EB, &H000000, &HFFFFFF, &H808080, &H818181, &H123456, &H654321, &HA9152C, &HAB0249, &H00FF00, &H0000FF, &HFFFF00, &HFFC800]
DIM i AS INTEGER
FOR i = 0 TO LEN(paare) - 2 STEP 2
    PRINT HEX$(paare[i]); " "; HEX$(paare[i + 1]); " "; FORMAT$(kern.farbAbstand(paare[i], paare[i + 1]), "%.6f")
NEXT
' Rangfolge und seltene Farben am Demo-Muster (rank_similar_colors,
' compute_rare_color_replacements)
DIM m AS kern.Muster : m = kern.pxsLaden(PATHJOIN(ARG$(0), "daten/muster/demo_kreuzstich.pxs"))
FOR i = 0 TO m.farbanzahl() - 1
    PRINT "aehnlich "; i; " "; JOIN$(kern.aehnlicheFarben(m, i), ",")
NEXT
DIM n AS INTEGER
FOR EACH n IN [5, 20, 60]
    PRINT "selten "; n; " ["; JOIN$(kern.selteneErsetzungen(m, n), ","); "]"
NEXT
