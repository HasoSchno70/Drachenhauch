' Der Tilemap-Pilot (examples/187_tilemap_editor.dh), bedient wie von Hand --
' ohne Python (Stufe 42, bis dahin tests/test_pilot_tilemap.py). Die Karte liest
' das json-Modul mit denselben Fragen, die das Qt-Modell stellte (Punkt = Breite
' und Hoehe 0, Eigenschaften am ersten Tileset, GID -> Tileset mit der groessten
' firstgid <= gid); das Bild des erzeugten Renderers macht `dhrt bild`, gezaehlt
' wird mit GETPIXEL statt mit PIL.
'
' `--- ersetzen` (neu in Stufe 42) setzt, was keine Aufnahme erreicht: das
' Vollbild (feste Lage), den Tileset-Pfad (die Kopie liegt woanders), die
' Dateidialoge (feste Pfade) und das Ablesen der Eingabefelder. Die Aufnahme
' entsteht im dritten Bild mit echten Lagen und beginnt mit einem Ereignis in
' Bild 0. In der Aufnahme: 8 Mausrad, 7 Mauslage, 6/5 Taste runter/hoch,
' 2/1 Taste runter/hoch.
--- seriell

--- langsam
=== gb-code bringt karte und tileset mit
' Alle drei Dateien unter demselben Namen. Fehlt eine, zeigt der Code ins Leere --
' und das faellt erst beim Starten auf.
DIM prBild AS INTEGER : prBild = 0
DIM prStart AS INTEGER : prStart = -1
DIM prF AS ARRAY OF INTEGER : prF = []
DIM prZ AS ARRAY OF STRING : prZ = []
DIM prFlag AS STRING : prFlag = ""
SUB prE(f AS INTEGER, typ AS INTEGER, a AS INTEGER, b AS INTEGER)
    ARRAY_PUSH(prF, f)
    ARRAY_PUSH(prZ, STR$(typ) + " " + STR$(a) + " " + STR$(b) + " 0 0")
END SUB
SUB prKlick(f AS INTEGER, x AS INTEGER, y AS INTEGER)
    prE(f, 7, x, y)
    prE(f + 1, 7, x, y)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 5, 0, 0)
END SUB
SUB prZiehen(f AS INTEGER, x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    prE(f, 7, x1, y1)
    prE(f + 1, 7, x1, y1)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 7, x2, y2)
    prE(f + 2, 6, 0, 0)
    prE(f + 3, 7, x2, y2)
    prE(f + 4, 5, 0, 0)
END SUB
FUNCTION prKx(px AS INTEGER) AS INTEGER
    RETURN GUI_CANVAS_X(leinwand) + px * zoom
END FUNCTION
FUNCTION prKy(py AS INTEGER) AS INTEGER
    RETURN GUI_CANVAS_Y(leinwand) + py * zoom
END FUNCTION
SUB prAbspielen()
    ' Ein Ereignis in Bild 0 -- die Wiedergabe setzt beim ERSTEN an.
    prE(0, 7, 0, 0)
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM weiter AS BOOLEAN
    DIM tf AS INTEGER
    DIM tz AS STRING
    FOR i = 1 TO LEN(prF) - 1
        j = i
        weiter = TRUE
        WHILE weiter
            weiter = FALSE
            IF j > 0 THEN
                IF prF[j - 1] > prF[j] THEN
                    tf = prF[j] : prF[j] = prF[j - 1] : prF[j - 1] = tf
                    tz = prZ[j] : prZ[j] = prZ[j - 1] : prZ[j - 1] = tz
                    j = j - 1
                    weiter = TRUE
                END IF
            END IF
        WEND
    NEXT
    DIM t AS STRING : t = "# Test-Aufnahme" + CHR$(10) + "c " + STR$(LEN(prF)) + CHR$(10)
    FOR i = 0 TO LEN(prF) - 1
        t = t + "e " + STR$(prF[i]) + " " + prZ[i] + CHR$(10)
    NEXT
    WRITEALL("ev.txt", t)
    AUTOMATION_PLAY("ev.txt")
    prStart = prBild
END SUB
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
SUB prFall()
    prKlick(3, GUI_GET_X(bCode) + 52, GUI_GET_Y(bCode) + 16)
    prAbspielen()
END SUB
SUB prProbe()
    prSchreib("")
END SUB
