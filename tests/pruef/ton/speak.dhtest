=== stop macht sofort still
IMPORT "helfer.dh"
TRY
    SPEAK("Eins zwei drei vier fuenf sechs")
    SPEAK_STOP()
    PRINT SPEAKING()
CATCH e
    fehlerOderSprung(e)
END TRY
