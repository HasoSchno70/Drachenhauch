    RETURN GUI_CANVAS_X(leinwand) + px * zoom
END FUNCTION
FUNCTION prKy(py AS INTEGER) AS INTEGER
    RETURN GUI_CANVAS_Y(leinwand) + py * zoom
END FUNCTION
SUB prAbspielen()
    ' Ein Ereignis in Bild 0 -- die Wiedergabe setzt beim ERSTEN an.
    prE(0, 7, 0, 0)
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM weiter AS BOOLEAN
    DIM tf AS INTEGER
    DIM tz AS STRING
    FOR i = 1 TO LEN(prF) - 1
        j = i
        weiter = TRUE
        WHILE weiter
            weiter = FALSE
            IF j > 0 THEN
                IF prF[j - 1] > prF[j] THEN
                    tf = prF[j] : prF[j] = prF[j - 1] : prF[j - 1] = tf
                    tz = prZ[j] : prZ[j] = prZ[j - 1] : prZ[j - 1] = tz
                    j = j - 1
                    weiter = TRUE
                END IF
            END IF
        WEND
    NEXT
    DIM t AS STRING : t = "# Test-Aufnahme" + CHR$(10) + "c " + STR$(LEN(prF)) + CHR$(10)
    FOR i = 0 TO LEN(prF) - 1
        t = t + "e " + STR$(prF[i]) + " " + prZ[i] + CHR$(10)
    NEXT
    WRITEALL("ev.txt", t)
    AUTOMATION_PLAY("ev.txt")
    prStart = prBild
END SUB
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
SUB prFall()
    prKlick(3, GUI_GET_X(bObjEbene) + 70, GUI_GET_Y(bObjEbene) + 14)
    prZiehen(10, prKx(0), prKy(0), prKx(16), prKy(16))
    prZiehen(20, prKx(32), prKy(32), prKx(64), prKy(48))
    prKlick(30, GUI_GET_X(bCode) + 52, GUI_GET_Y(bCode) + 16)
    prAbspielen()
END SUB
SUB prProbe()
    prSchreib("")
END SUB
