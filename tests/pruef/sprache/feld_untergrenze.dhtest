=== lbound und ubound je dimension
DIM f[-10 TO 10, 1 TO 4, 3] AS INTEGER
PRINT LBOUND(f), UBOUND(f)
PRINT LBOUND(f, 1), UBOUND(f, 1)
PRINT LBOUND(f, 2), UBOUND(f, 2)
PRINT LBOUND(f, 3), UBOUND(f, 3)
DIM leer[1 TO 0] AS INTEGER
PRINT LEN(leer), LBOUND(leer), UBOUND(leer)
DIM liste AS ARRAY OF STRING
liste = []
PRINT LBOUND(liste), UBOUND(liste)
DIM von AS INTEGER
von = 1990
DIM jahre[von TO von + 35] AS FLOAT
PRINT LBOUND(jahre), UBOUND(jahre), LEN(jahre)
TRY
    PRINT LBOUND(f, 4)
CATCH e
    PRINT e
END TRY
TRY
    PRINT UBOUND(3)
CATCH e
    PRINT e
END TRY
