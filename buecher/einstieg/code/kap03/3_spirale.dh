' Kapitel 3 -- Sinus und Kosinus malen eine Spirale.

SCREEN(640, 400, "Spirale")
CLS(RGB(10, 10, 20))

DIM i AS INTEGER
DIM winkel AS FLOAT
DIM weite AS FLOAT
DIM sx AS FLOAT
DIM sy AS FLOAT

FOR i = 0 TO 720
    winkel = RAD(i)
    weite = i / 4
    sx = 320 + COS(winkel) * weite
    sy = 200 + SIN(winkel) * weite
    CIRCLE(sx, sy, 3, RGB(255, i \ 3, 60))
NEXT

FLIP()
SLEEP(4000)
