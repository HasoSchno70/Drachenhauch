' studio_laufzeit.dh -- die Laufzeit eines Projekts aus dem Drachenhauch Studio.
'
' Das Studio kopiert diese Datei bei jedem Starten und Bauen nach _studio/.
' Geaendert wird sie in studio/laufzeit.dh, nicht in der Kopie.
'
' StudioApp ist die Basis der App, StudioFenster die Basis jeder erzeugten
' Fensterklasse (<Fenster>_Basis), StudioTimer ein Timer im Fenster.
' studioLauf() dreht die Bildschleife; ein Bild ist studioBild().
'
' Die Ereignisse fragt jedes Fenster NACH dem GUI_UPDATE ab (studioTakt),
' statt sie als Rueckruf der gui laufen zu lassen. Darum darf eine
' Ereignis-Methode warten: Frage(), Meldung(), Eingabe() und
' fenster.ZeigenModal() drehen selbst Bilder, bis eine Antwort da ist, und
' kehren erst dann zurueck -- wie in Xojo oder Visual Basic.

IMPORT "gui"

CLASS StudioApp
    ' Nach dem Start, bevor das Startfenster aufgeht.
    SUB Geoeffnet()
    END SUB

    ' Bevor das Programm endet.
    SUB Beenden()
    END SUB
END CLASS

' Ein Timer: ruft sein Ereignis Aktion alle `Intervall` Millisekunden, solange
' er aktiv ist; ohne `Wiederholen` nur einmal.
CLASS StudioTimer
    DIM Intervall AS INTEGER
    DIM Aktiv AS BOOLEAN
    DIM Wiederholen AS BOOLEAN
    DIM studioStart AS INTEGER

    SUB Starten()
        Self.Aktiv = TRUE
        Self.studioStart = MILLIS()
    END SUB

    SUB Stoppen()
        Self.Aktiv = FALSE
    END SUB

    ' Je Bild gefragt: ist die Zeit um? Dann beginnt sie von vorn.
    FUNCTION studioFaellig() AS BOOLEAN
        IF NOT Self.Aktiv THEN RETURN FALSE
        IF MILLIS() - Self.studioStart < MAX(1, Self.Intervall) THEN RETURN FALSE
        Self.studioStart = MILLIS()
        IF NOT Self.Wiederholen THEN Self.Aktiv = FALSE
        RETURN TRUE
    END FUNCTION
END CLASS

CLASS StudioFenster
    DIM studioWin AS GUI_WINDOW
    DIM studioOffen AS BOOLEAN
    DIM studioHaupt AS BOOLEAN
    DIM studioWarB AS INTEGER
    DIM studioWarH AS INTEGER

    ' Die erzeugte Basisklasse baut hier das Fenster.
    SUB studioAufbauen()
    END SUB

    ' Je Bild nach GUI_UPDATE: die Ereignisse des Fensters.
    SUB studioTakt()
    END SUB

    ' Je Bild nach GUI_DRAW: die Zeichenflaechen.
    SUB studioZeichnen()
    END SUB

    ' Nachdem das Fenster aufgebaut ist.
    SUB Geoeffnet()
    END SUB

    ' Wenn das Fenster geschlossen wird (Kreuz oder Zumachen).
    SUB Schliessen()
    END SUB

    ' Wenn sich die Groesse des Fensters geaendert hat.
    SUB Groesse()
    END SUB

    ' Eine Taste, solange das Fenster vorn ist und kein Eingabefeld sie
    ' nimmt -- `taste` ist der Code (KEY_A, KEY_SPACE ...).
    SUB Taste(taste AS INTEGER)
    END SUB

    ' Zeigt das Fenster; beim ersten Mal wird es aufgebaut.
    SUB Zeigen()
        IF Self.studioOffen THEN
            GUI_WINDOW_VISIBLE(Self.studioWin, TRUE)
            GUI_WINDOW_FRONT(Self.studioWin)
            RETURN
        END IF
        Self.studioAufbauen()
        Self.studioOffen = TRUE
        IF Self.studioHaupt THEN
            GUI_WINDOW_CHROME(Self.studioWin, FALSE)
            GUI_WINDOW_SET_BOUNDS(Self.studioWin, 0, 0, SCREENWIDTH(), SCREENHEIGHT())
        ELSE
            DIM b AS INTEGER : b = GUI_WINDOW_GET_W(Self.studioWin)
            DIM h AS INTEGER : h = GUI_WINDOW_GET_H(Self.studioWin)
            GUI_WINDOW_SET_BOUNDS(Self.studioWin, MAX(0, (SCREENWIDTH() - b) \ 2), MAX(0, (SCREENHEIGHT() - h) \ 2), b, h)
            GUI_WINDOW_FRONT(Self.studioWin)
        END IF
        Self.studioWarB = GUI_WINDOW_GET_W(Self.studioWin)
        Self.studioWarH = GUI_WINDOW_GET_H(Self.studioWin)
        studioAnmelden(Self)
        Self.Geoeffnet()
    END SUB

    ' Zeigt das Fenster modal und kehrt erst zurueck, wenn es geschlossen ist.
    ' Solange nimmt kein anderes Fenster Klicks an.
    SUB ZeigenModal()
        Self.Zeigen()
        IF NOT Self.studioOffen THEN RETURN
        GUI_WINDOW_MODAL(Self.studioWin, TRUE)
        WHILE Self.studioOffen
            IF NOT studioBild() THEN RETURN
        WEND
    END SUB

    ' Schliesst das Fenster. Das Startfenster zu schliessen beendet das Programm.
    SUB Zumachen()
        IF NOT Self.studioOffen THEN RETURN
        Self.Schliessen()
        Self.studioOffen = FALSE
        GUI_WINDOW_DESTROY(Self.studioWin)
        IF Self.studioHaupt THEN studioBeenden()
    END SUB

    ' Das Fenster der gui, fuer alles, was die Klasse nicht selbst anbietet.
    FUNCTION Fenster() AS GUI_WINDOW
        RETURN Self.studioWin
    END FUNCTION
END CLASS

DIM studioFenster AS ARRAY OF StudioFenster : studioFenster = []
DIM studioEnde AS BOOLEAN : studioEnde = FALSE
DIM studioDieStartseite AS StudioFenster
DIM studioDialoge AS ARRAY OF GUI_WINDOW : studioDialoge = []
DIM studioSchirmB AS INTEGER : studioSchirmB = 0
DIM studioSchirmH AS INTEGER : studioSchirmH = 0
' Der Tastaturfokus im vorigen und in diesem Bild -- daraus werden
' FokusRein und FokusRaus.
DIM studioFokusAlt AS INTEGER : studioFokusAlt = -1
DIM studioFokusJetzt AS INTEGER : studioFokusJetzt = -1
DIM studioTaste AS INTEGER : studioTaste = -1

SUB studioAnmelden(f AS StudioFenster)
    ARRAY_PUSH(studioFenster, f)
END SUB

' Beendet das Programm nach dem laufenden Bild.
SUB studioBeenden()
    studioEnde = TRUE
END SUB

' Ein Bild: Eingaben, Ereignisse aller Fenster, Zeichnen. FALSE, wenn das
' Programm endet -- dann soll jede Schleife, die Bilder dreht, aufhoeren.
FUNCTION studioBild() AS BOOLEAN
    IF studioEnde THEN RETURN FALSE
    IF WINDOW_CLOSE_REQUESTED() THEN
        studioDieStartseite.Zumachen()
        studioEnde = TRUE
        RETURN FALSE
    END IF
    IF QUITREQUESTED() THEN
        studioEnde = TRUE
        RETURN FALSE
    END IF
    IF SCREENWIDTH() <> studioSchirmB OR SCREENHEIGHT() <> studioSchirmH THEN
        studioSchirmB = SCREENWIDTH() : studioSchirmH = SCREENHEIGHT()
        IF studioDieStartseite.studioOffen THEN GUI_WINDOW_SET_BOUNDS(studioDieStartseite.studioWin, 0, 0, studioSchirmB, studioSchirmH)
    END IF
    GUI_UPDATE()
    studioFokusAlt = studioFokusJetzt
    studioFokusJetzt = GUI_FOCUSED()
    studioTaste = KEY_ANY_HIT()
    ' Eine Kopie der Liste: ein Ereignis kann Fenster oeffnen und schliessen.
    DIM jetzt AS ARRAY OF StudioFenster : jetzt = ARRAY_COPY(studioFenster)
    DIM f AS StudioFenster
    FOR EACH f IN jetzt
        IF studioEnde THEN BREAK
        IF NOT f.studioOffen THEN CONTINUE
        IF GUI_WINDOW_CLOSED(f.studioWin) THEN
            f.Zumachen()
            CONTINUE
        END IF
        f.studioTakt()
        IF f.studioOffen THEN
            IF GUI_WINDOW_GET_W(f.studioWin) <> f.studioWarB OR GUI_WINDOW_GET_H(f.studioWin) <> f.studioWarH THEN
                f.studioWarB = GUI_WINDOW_GET_W(f.studioWin)
                f.studioWarH = GUI_WINDOW_GET_H(f.studioWin)
                f.Groesse()
            END IF
        END IF
    NEXT
    ' Eine Taste gehoert dem obersten Fenster -- ausser ein Eingabefeld hat
    ' den Fokus, dann tippt man dort.
    IF studioTaste >= 0 AND NOT studioEnde THEN
        DIM feld AS BOOLEAN : feld = FALSE
        IF studioFokusJetzt >= 0 THEN
            DIM art AS STRING : art = GUI_KIND(studioFokusJetzt)
            feld = art = "textinput" OR art = "textarea" OR art = "spinner" OR art = "dropdown"
        END IF
        IF NOT feld AND GUI_MODAL() = FALSE THEN
            DIM oben AS StudioFenster
            FOR EACH f IN studioFenster
                IF f.studioOffen THEN oben = f
            NEXT
            IF oben IS NOT NIL THEN oben.Taste(studioTaste)
        END IF
    END IF
    ' Geschlossene Fenster aus der Liste nehmen.
    DIM noch AS ARRAY OF StudioFenster : noch = []
    FOR EACH f IN studioFenster
        IF f.studioOffen THEN ARRAY_PUSH(noch, f)
    NEXT
    studioFenster = noch
    IF studioEnde THEN RETURN FALSE
    CLS(0)
    GUI_DRAW(FALSE)
    FOR EACH f IN studioFenster
        f.studioZeichnen()
    NEXT
    FOR EACH f IN studioFenster
        IF NOT f.studioHaupt THEN GUI_DRAW_WINDOW(f.studioWin)
    NEXT
    DIM d AS GUI_WINDOW
    FOR EACH d IN studioDialoge
        GUI_DRAW_WINDOW(d)
    NEXT
    GUI_DRAW_TOP()
    FLIP()
    RETURN TRUE
END FUNCTION

' Der Einstieg: oeffnet das Programmfenster in der Groesse des Startfensters,
' laesst die App beginnen, zeigt das Startfenster und dreht die Bildschleife.
SUB studioLauf(app AS StudioApp, start AS StudioFenster, b AS INTEGER, h AS INTEGER, titel AS STRING, veraenderbar AS BOOLEAN)
    SCREEN(b, h, titel)
    IF veraenderbar THEN WINDOW_RESIZABLE(TRUE)
    SETFPS(60)
    studioSchirmB = SCREENWIDTH() : studioSchirmH = SCREENHEIGHT()
    studioDieStartseite = start
    app.Geoeffnet()
    start.studioHaupt = TRUE
    start.Zeigen()
    WHILE studioBild()
    WEND
    app.Beenden()
END SUB

' --- Dialoge, die warten ------------------------------------------------

' Wartet auf die Antwort eines Dialogs der gui (0 = Programm endet).
FUNCTION studioAntwort(d AS GUI_WINDOW) AS INTEGER
    ARRAY_PUSH(studioDialoge, d)
    DIM a AS INTEGER : a = 0
    WHILE a = 0
        IF NOT studioBild() THEN BREAK
        a = GUI_ANSWER(d)
    WEND
    DIM rest AS ARRAY OF GUI_WINDOW : rest = []
    DIM x AS GUI_WINDOW
    FOR EACH x IN studioDialoge
        IF NOT (x = d) THEN ARRAY_PUSH(rest, x)
    NEXT
    studioDialoge = rest
    RETURN a
END FUNCTION

' Eine Meldung mit OK.
SUB Meldung(text AS STRING, titel AS STRING = "")
    studioAntwort(GUI_DIALOG(titel, text, "ok"))
END SUB

' Eine Frage; die Antwort ist die Nummer des Knopfs (1 = der erste).
' Knoepfe mit | getrennt, Enter = der erste, ESC = der letzte.
FUNCTION Frage(text AS STRING, knoepfe AS STRING = "Ja|Nein", titel AS STRING = "") AS INTEGER
    RETURN studioAntwort(GUI_DIALOG(titel, text, knoepfe))
END FUNCTION

' Fragt nach einem Text; "" bei Abbrechen.
FUNCTION Eingabe(text AS STRING, vorgabe AS STRING = "", titel AS STRING = "") AS STRING
    DIM d AS GUI_WINDOW : d = GUI_PROMPT(titel, text, vorgabe)
    IF studioAntwort(d) <> 1 THEN RETURN ""
    RETURN GUI_DIALOG_TEXT(d)
END FUNCTION

' Ein Bild aus dem Ordner bilder/ des Projekts (beim Starten und in der
' gebauten Fassung unter assets/bilder/).
FUNCTION Bild(name AS STRING) AS IMAGE
    RETURN LOADIMAGE(studioDatei$("bilder/" + name))
END FUNCTION

FUNCTION studioDatei$(rel AS STRING) AS STRING
    RETURN "assets/" + rel
END FUNCTION
