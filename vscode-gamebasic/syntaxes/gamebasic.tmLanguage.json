{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameBasic",
  "scopeName": "source.gamebasic",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gamebasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.gamebasic",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.gamebasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gamebasic",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "constant.numeric.gamebasic",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.gamebasic",
          "match": "(?i)\\b(FALSE|TRUE)\\b"
        },
        {
          "name": "storage.type.gamebasic",
          "match": "(?i)\\b(COROUTINE|BOOLEAN|FUNCREF|INTEGER|STRING|SOUND|ARRAY|FLOAT|IMAGE|TUPLE|FILE|MAP|OF)\\b"
        },
        {
          "name": "keyword.declaration.gamebasic",
          "match": "(?i)\\b(OPERATOR|FUNCTION|PROPERTY|EXTENDS|IMPORT|STRUCT|STATIC|BYREF|CLASS|CONST|ENUM|SUB|DIM|AS)\\b"
        },
        {
          "name": "keyword.control.gamebasic",
          "match": "(?i)\\b(CONTINUE|RESTORE|REPEAT|SELECT|ELSEIF|RETURN|INPUT|CATCH|YIELD|BREAK|UNTIL|WHERE|WHILE|THROW|PRINT|BXOR|THEN|STEP|WEND|CASE|NEXT|BNOT|ELIF|BAND|WITH|READ|DATA|ELSE|SHL|SHR|NEW|AND|FOR|BOR|END|NOT|MOD|TRY|IS|IF|IN|OR|TO)\\b"
        },
        {
          "name": "support.function.dollar.gamebasic",
          "match": "(?i)\\b(READALL|REPLACE|FORMAT|REPEAT|SPACE|RIGHT|INKEY|LOWER|UPPER|SPLIT|LEFT|TIME|JOIN|DATE|PADR|PADL|TRIM|MID|HEX|CHR|STR)\\$"
        },
        {
          "name": "support.function.gamebasic",
          "match": "(?i)\\b(ATLAS_DRAW_FLIPPED|RENDERTARGET_BEGIN|RENDERTARGET_DRAW|__DICT_FROM_PAIRS|RENDERTARGET_END|DRAWIMAGEFLIPPED|RENDERTARGET_NEW|GENTEX_GRADIENT|TRIANGLEOUTLINE|JOYSTICK_BUTTON|POLYGONOUTLINE|SAVESCREENSHOT|GENTEX_CHECKED|ELLIPSEOUTLINE|JOYSTICK_HAT_X|SET_FULLSCREEN|JOYSTICK_COUNT|SETWINDOWTITLE|JOYSTICK_HAT_Y|JOYSTICK_AXIS|ARRAY_INDEXOF|CLIPBOARD_GET|QUITREQUESTED|JOYSTICK_NAME|GENTEX_PERLIN|DRAWIMAGEPART|FILES_DROPPED|CLIPBOARD_SET|FILE_DROPPED|GENTEX_COLOR|LAYER_DEFINE|TEXT_SPACING|DRAWTILEMAP|CORO_RESUME|MOUSEBUTTON|__COMP_ITER|__SET_DEDUP|TEXT_ITALIC|LAYER_CLEAR|SHADER_SET2|TEXT_HEIGHT|IMAGEHEIGHT|BATCH_FLUSH|SHADER_SET3|SHADER_LOAD|CORO_RESULT|LOAD_ASSETS|IMAGEWIDTH|TEXT_WIDTH|BLEND_MODE|ATLAS_DRAW|ATLAS_LOAD|CORO_CLOSE|FILEEXISTS|KEYPRESSED|BATCH_DRAW|SHADER_SET|PLAYMUSIC|MAPREMOVE|CORO_DONE|ENDOFFILE|STOPMUSIC|DRAWIMAGE|GRADIENTV|LOADSOUND|RECTROUND|CORO_SEND|PLAYSOUND|WRITELINE|MAPVALUES|CLOSEFILE|STOPSOUND|RANDOMIZE|TEXT_BOLD|GRADIENTH|LOADIMAGE|TEXT_SIZE|LAYER_END|MAPGETOR|LOADFONT|READLINE|DIMCOUNT|TRIANGLE|BOXROUND|COLLIDES|OPENFILE|MAPITEMS|MAPCLEAR|SETFONT|MAPSIZE|WAITKEY|POLYGON|MAPKEYS|REVERSE|CIRCLES|ELLIPSE|DIMSIZE|READALL|REPLACE|IS_NIL|CIRCLE|MILLIS|SPLINE|POSTFX|SCROLL|SCREEN|MAPHAS|MOUSEX|SETFPS|MAPGET|MAPPUT|MOUSEY|ROUND|WRITE|PLOTS|RANGE|UPPER|SPACE|CLAMP|RIGHT|DELTA|LAYER|LINES|LOWER|INSTR|SLEEP|ATAN2|FLOOR|BOXES|LINEW|TIMER|SPLIT|FLIP|CEIL|PADL|SIGN|DATE|PLOT|TRIM|ATAN|RECT|LEFT|TIME|JOIN|LINE|TEXT|SORT|PADR|INT|MAX|TAN|BOX|ASC|RND|STR|COS|LEN|ABS|LOG|RGB|MID|HEX|CHR|SQR|POW|CLS|ARC|MIN|SIN|FPS|VAL|EXP)\\b"
        },
        {
          "name": "constant.language.gamebasic",
          "match": "(?i)\\b(JOY_BUTTON_LSTICK|JOY_BUTTON_RSTICK|JOY_BUTTON_START|JOY_BUTTON_BACK|JOY_DPAD_RIGHT|JOY_DPAD_DOWN|JOY_BUTTON_LB|JOY_DPAD_LEFT|KEY_BACKSPACE|JOY_BUTTON_RB|JOY_BUTTON_X|JOY_BUTTON_A|JOY_BUTTON_B|JOY_BUTTON_Y|JOY_DPAD_UP|KEY_RETURN|KEY_ESCAPE|KEY_SPACE|KEY_RIGHT|LIGHTGRAY|DARKGREEN|KEY_ENTER|DARKGRAY|DARKBLUE|KEY_DOWN|KEY_LEFT|MAGENTA|DARKRED|KEY_F12|KEY_F10|KEY_TAB|KEY_F11|KEY_F3|KEY_F5|KEY_F1|ORANGE|KEY_F7|KEY_F6|YELLOW|KEY_UP|KEY_F8|KEY_F2|KEY_F4|PURPLE|KEY_F9|KEY_L|KEY_4|KEY_I|BROWN|KEY_B|KEY_Y|KEY_6|KEY_J|KEY_Z|KEY_N|KEY_C|BLACK|KEY_8|KEY_G|KEY_E|KEY_S|KEY_V|KEY_T|KEY_X|KEY_P|KEY_R|KEY_W|KEY_9|GREEN|KEY_3|KEY_1|KEY_F|KEY_K|KEY_0|KEY_D|KEY_U|WHITE|KEY_A|KEY_5|KEY_7|KEY_H|KEY_2|KEY_Q|KEY_O|KEY_M|CYAN|GRAY|PINK|BLUE|RED|PI)\\b"
        },
        {
          "name": "keyword.operator.gamebasic",
          "match": "<=|>=|<>|[-+*/\\\\=<>^]"
        }
      ]
    }
  }
}
