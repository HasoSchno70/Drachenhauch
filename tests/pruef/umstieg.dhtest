FOR i = 0 TO 1 STEP 0.5
NEXT
--- fehler
DIM i AS FLOAT vor der Schleife

=== step als kommazahl mit float-laufvariable laeuft
DIM f AS FLOAT
FOR f = 0 TO 1 STEP 0.5
    PRINT f
NEXT
