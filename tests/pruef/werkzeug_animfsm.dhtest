IMPORT "json"
IMPORT "animfsm"
IMPORT "sprite"
FUNCTION zustand$(datei AS STRING, speed AS FLOAT, schritt AS BOOLEAN) AS STRING
    DIM sp AS SPRITE : sp = SPRITE_NEW(0, 16, 16)
    DIM fsm AS ANIM_FSM : fsm = ANIM_FSM_LOAD(datei)
    ANIM_FSM_SETUP(fsm, sp)
    IF schritt THEN
        ANIM_FSM_SET_FLOAT(fsm, "speed", speed)
        ANIM_FSM_UPDATE(fsm, sp, 16)
    END IF
    RETURN ANIM_FSM_STATE(fsm)
END FUNCTION
DIM h AS JSON_HANDLE : h = JSON_LOAD("held.dhanim")
PRINT JSON_GET_STRING(h, "transitions.0.from") ; " " ; JSON_GET_STRING(h, "transitions.0.to")
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(h, "transitions.0.conditions") - 1
    DIM p AS STRING : p = "transitions.0.conditions." + STR$(i)
    PRINT JSON_GET_STRING(h, p + ".param") ; " " ; JSON_GET_STRING(h, p + ".op") ; " " ; INT(JSON_GET_FLOAT(h, p + ".value"))
NEXT
' Beide Bedingungen gelten: speed 10 -> run, speed 1 -> idle.
PRINT "speed 10 " + zustand$("held.dhanim", 10.0, TRUE)
PRINT "speed 1 " + zustand$("held.dhanim", 1.0, TRUE)
--- erwartet
idle run
speed gt 5
speed gt 0
speed 10 run
speed 1 idle

