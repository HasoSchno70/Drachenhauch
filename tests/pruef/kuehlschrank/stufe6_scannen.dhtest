=== produktdialog: suchen fuellt die felder und laedt das bild, nicht gefunden, 404
' Mit Barcode geoeffnet sucht er gleich (wie die Python-App); Name, Marke,
' Kategorie (Liste von map_category), Notizen; das Bild kommt im
' Hintergrund. Meldungen mit Enter. 4003: nicht gefunden, beim zweiten Mal
' aus dem Cache, 🗘 fragt das Netz trotzdem. 4004 (404): keine Antwort.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
COPYFILE(ARG$(2), CWD$() + "/bild.png")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
DIM srv AS INTEGER : srv = kOffStarten(ARG$(3))
slZeilen = [] : slBild = 0
slHin(10, 10)
DIM k AS INTEGER
FOR k = 1 TO 5
    slWarten(40)
    slTaste(257)
NEXT
slAufnahmeSchreiben(p + "/_studio/tasten.txt")
PRINT "code "; kProbe(p, "probe.dh", "tasten.txt", 400)
PRINT "anfragen "; kOffAnfragen$()
kOffEnde(srv)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
{sammlung}/../../../daten/bilder/logo.png
{sammlung}/../_hilfen/off_server.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM pf AS ProduktFenster : pf = NEW ProduktFenster()
pf.barcode = "4001"
pf.Zeigen()
PRINT "sucht "; GUI_TEXT(pf.apiStatus); " | feld an "; GUI_ENABLED(pf.barcodeFeld)
' Bis die Antwort da ist (Meldung: Enter 1) und das Bild.
DIM n AS INTEGER
WHILE (pf.letzter IS NIL OR pf.bildAbruf >= 0) AND n < 300 AND studioBild()
    n = n + 1
WEND
PRINT "felder "; GUI_TEXT(pf.nameFeld); " | "; GUI_TEXT(pf.markeFeld); " | "; GUI_TEXT(pf.kategorieListe); " | "; REPLACE$(GUI_TEXT(pf.notizenFeld), CHR$(10), " / ")
PRINT "status "; GUI_TEXT(pf.apiStatus); " | "; GUI_TEXT(pf.cacheInfo); " | bild ["; GUI_TEXT(pf.bildText); "] | feld an "; GUI_ENABLED(pf.barcodeFeld)
SUB suche(wie AS STRING, b AS STRING)
    GUI_SET_TEXT(pf.barcodeFeld, b)
    pf.letzter = NIL
    IF wie = "neu" THEN pf.knopfNeuSuchen_Klick() ELSE pf.knopfSuchen_Klick()
    DIM m AS INTEGER
    WHILE pf.letzter IS NIL AND m < 300 AND studioBild()
        m = m + 1
    WEND
    PRINT b; " "; wie; ": "; GUI_TEXT(pf.apiStatus); " | cache "; pf.letzter.ausCache; " | "; REGEX_REPLACE(pf.letzter.fehler, "http://[^ ]+", "URL")
END SUB
' Je eine Meldung: Enter 2, 3, 4, 5.
suche("suchen", "4003")
suche("suchen", "4003")
suche("neu", "4003")
suche("suchen", "4004")
--- erwartet
sucht Suche... | feld an FALSE
felder Vollmilch 3,5 % | Weidemilch | Milchprodukte | Packungsgröße: 1 l / Nutri-Score: B / Allergene: milk
status Gefunden! | ✓ Von API geladen | bild [] | feld an TRUE
4003 suchen: Nicht gefunden | cache FALSE | Produkt nicht in Open Food Facts gefunden
4003 suchen: Nicht gefunden | cache TRUE | Produkt wurde zuvor nicht gefunden (aus Cache)
4003 neu: Nicht gefunden | cache FALSE | Produkt nicht in Open Food Facts gefunden
4004 suchen: Nicht gefunden | cache FALSE | Netzwerkfehler: HTTP 404 Not Found - URL
code 0
anfragen /api/v0/product/4001.json /bild.png /api/v0/product/4003.json /api/v0/product/4003.json /api/v0/product/4004.json

=== echt: einkauf erfassen, template laden, alle speichern
' Ein Klick auf "Einkauf erfassen" oeffnet den Stapelscan (modal), "Template
' laden" (Auswahl: Enter, Meldung: Enter), "Alle speichern" (Meldung: Enter)
' -- danach steht alles im Bestand, der Kopf zaehlt mit.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 10)
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
FUNCTION z(i AS INTEGER) AS INTEGER
    RETURN INT(VAL(w[i]))
END FUNCTION
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slKlick(z(0), z(1))
slWarten(20)
slKlick(z(2), z(3))
slWarten(15)
slTaste(257)
slWarten(15)
slTaste(257)
slWarten(15)
slKlick(z(4), z(5))
slWarten(15)
slTaste(257)
slWarten(15)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 20)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei daten.dh
' Messlauf und Abspiellauf teilen die Datei: jedes Mal frisch.
DB_EXEC(db, "DELETE FROM inventory")
DB_EXEC(db, "DELETE FROM products")
DB_EXEC(db, "DELETE FROM shopping_templates")
DB_EXEC(db, "INSERT INTO shopping_templates (name, items_json) VALUES ('Frühstück', '[{""name"": ""Milch"", ""barcode"": ""4001"", ""quantity"": 2, ""storage_location"": ""Kühlschrank"", ""expiry_days"": 7}, {""name"": ""Brötchen"", ""barcode"": null, ""quantity"": 6, ""storage_location"": null, ""expiry_days"": null}]')")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
--- datei mess.dh
IMPORT "../../daten.dh"
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
DIM sc AS ScanFenster : sc = NEW ScanFenster()
sc.Zeigen()
DIM t AS INTEGER : t = GUI_METRIC_GET("title_h")
DIM wx AS INTEGER : wx = GUI_WINDOW_GET_X(sc.Fenster())
DIM wy AS INTEGER : wy = GUI_WINDOW_GET_Y(sc.Fenster()) + t
WRITEALL("lage.txt", STR$(GUI_GET_X(f.knopfEinkauf) + GUI_GET_W(f.knopfEinkauf) \ 2) + " " + STR$(GUI_GET_Y(f.knopfEinkauf) + 26 + GUI_GET_H(f.knopfEinkauf) \ 2) + " " + _
    STR$(wx + GUI_GET_X(sc.knopfVorlageLaden) + GUI_GET_W(sc.knopfVorlageLaden) \ 2) + " " + STR$(wy + GUI_GET_Y(sc.knopfVorlageLaden) + GUI_GET_H(sc.knopfVorlageLaden) \ 2) + " " + _
    STR$(wx + GUI_GET_X(sc.knopfSpeichern) + GUI_GET_W(sc.knopfSpeichern) \ 2) + " " + STR$(wy + GUI_GET_Y(sc.knopfSpeichern) + GUI_GET_H(sc.knopfSpeichern) \ 2))
--- datei klick.dh
IMPORT "../../daten.dh"
FUNCTION stand$() AS STRING
    RETURN JOIN$(textListe("SELECT p.name || ':' || i.quantity || ':' || i.storage_location FROM inventory i JOIN products p ON p.id = i.product_id ORDER BY i.id"), " ") + " | kopf " + GUI_CARD_TEXT$(f.kachelGesamt)
END FUNCTION
DIM folge AS ARRAY OF STRING : folge = []
DIM war AS STRING : war = ""
WHILE studioBild()
    DIM jetzt AS STRING : jetzt = stand$()
    IF jetzt <> war THEN ARRAY_PUSH(folge, jetzt)
    war = jetzt
WEND
PRINT JOIN$(folge, " -> ")
--- erwartet
 | kopf 0 -> Milch:2.0:Kühlschrank Brötchen:6.0:Kühlschrank | kopf 2
code 0
