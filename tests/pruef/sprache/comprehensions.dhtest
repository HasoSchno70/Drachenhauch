=== comp var does not leak (1)
' Iter-Variable lebt nur im Comp-Kontext (Tree-Walker stellt
DIM x AS INTEGER
x = 999
DIM nums AS TUPLE
nums = (1, 2, 3)
DIM r AS TUPLE
r = [x * 2 FOR x IN nums]
PRINT x
PRINT r
--- erwartet
999
(2, 4, 6)

=== comp var does not leak (2)
' Iter-Variable lebt nur im Comp-Kontext (Tree-Walker stellt
DIM x AS INTEGER
x = 999
DIM nums AS TUPLE
nums = (1, 2, 3)
DIM r AS TUPLE
r = [x * 2 FOR x IN nums]
PRINT x
PRINT r
--- erwartet
999
(2, 4, 6)

=== comp nested in function (1)
FUNCTION squares_of(t AS TUPLE) AS TUPLE
    RETURN [n * n FOR n IN t]
END FUNCTION

DIM r AS TUPLE
r = squares_of((1, 2, 3, 4))
PRINT r
--- erwartet
(1, 4, 9, 16)

=== comp nested in function (2)
