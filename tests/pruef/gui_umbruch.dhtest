' Aus test_gui_umbruch.py uebertragen (4 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== view zaehlt mit umbruch weniger logische zeilen
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 200, 150)
GUI_SET_TEXT(ta, "Ein langer Absatz der in einem schmalen Feld mehrfach umbrechen muss damit man es sieht")
CLIPBOARD_SET("#")
GUI_SET_TEXT(ta, "Ein langer Absatz der in einem schmalen Feld mehrfach umbrechen muss damit man es sieht" + CHR$(10) + "zwei" + CHR$(10) + "drei" + CHR$(10) + "vier")
GUI_UPDATE()
PRINT GUI_TEXTAREA_VIEW(ta)
GUI_TEXTAREA_SET(ta, "umbruch", 1)
GUI_UPDATE()
PRINT GUI_TEXTAREA_VIEW(ta)
DIM j AS STRING : j = GUI_TO_JSON(w)
PRINT INSTR(j, "wrap_text") >= 0 ; " " ; GUI_TO_JSON(GUI_FROM_JSON(j)) = j
--- umgebung
DHRT_FRAMES=1
--- erwartet
(0, 5, 0, 102)
(0, 1, 0, 87)
TRUE TRUE

=== ende und pfeil runter bleiben in der sichtbaren zeile (1)
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 200, 150)
GUI_SET_TEXT(ta, "Ein langer Absatz der in einem schmalen Feld mehrfach umbrechen muss damit man es sieht")
CLIPBOARD_SET("#")
GUI_FOCUS(ta)
DIM f AS INTEGER
FOR f = 1 TO 34
    GUI_UPDATE()
    PRINT "T " + GUI_TEXT(ta)
    GUI_DRAW()
    FLIP()
NEXT
