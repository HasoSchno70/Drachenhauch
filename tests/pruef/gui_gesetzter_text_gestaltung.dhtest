' Gesetzter Text, zweite Runde (Handbuch schoener): Inhaltsverzeichnis aus
' den Ueberschriften, Sprung dorthin, Suchen gleich nach dem Setzen, Zitate
' als ein Block, eingefaerbte Codebloecke -- und das Bild hinter einem
' Textbereich (GUI_TEXTAREA_BACKGROUND). Farben werden am Bildschirmfoto
' gezaehlt (SAVESCREENSHOT + GETPIXEL), jeweils mit Gegenprobe im selben Lauf.

=== ueberschriften kommen aus der quelle
' Codebloecke zaehlen nicht mit: ein `# Kommentar` darin ist keine
' Ueberschrift. Stimmt gleich nach SET_TEXT, ohne GUI_UPDATE.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM NL AS STRING : NL = CHR$(10)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM rt AS GUI_WIDGET : rt = GUI_RICHTEXT(w, 10, 10, 300, 200, "")
GUI_RICHTEXT_SET_TEXT(rt, "# Eins" + NL + "Text" + NL + "## Zwei `code`" + NL + "```" + NL + "# kein Titel" + NL + "```" + NL + "### Drei **fett**" + NL)
DIM t AS ARRAY OF STRING : t = GUI_RICHTEXT_HEADINGS(rt)
DIM e AS ARRAY OF INTEGER : e = GUI_RICHTEXT_HEADING_LEVELS(rt)
DIM i AS INTEGER
FOR i = 0 TO LEN(t) - 1
    PRINT e[i]; " "; t[i]
NEXT
--- umgebung
DHRT_FRAMES=2
--- erwartet
1 Eins
2 Zwei code
3 Drei fett

=== sprung zur ueberschrift vor und nach dem satz
' Vor dem ersten GUI_UPDATE gibt es keine Lage -- der Sprung wird
' vorgemerkt. HEADING_AT sagt danach, in welchem Abschnitt man steht.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM NL AS STRING : NL = CHR$(10)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM text AS STRING : text = "# Anfang" + NL
DIM i AS INTEGER
FOR i = 1 TO 40
    text = text + "Absatz " + STR$(i) + NL + NL
NEXT
text = text + "## Mitte" + NL
FOR i = 1 TO 40
    text = text + "Absatz " + STR$(i) + NL + NL
NEXT
text = text + "## Ende" + NL + "Schluss" + NL
DIM rt AS GUI_WIDGET : rt = GUI_RICHTEXT(w, 10, 10, 300, 200, text)
GUI_RICHTEXT_GOTO_HEADING(rt, 1)
GUI_UPDATE()
PRINT "vorgemerkt "; GUI_RICHTEXT_SCROLL_GET(rt) > 100; " "; GUI_RICHTEXT_HEADING_AT(rt)
GUI_RICHTEXT_GOTO_HEADING(rt, 0)
PRINT "anfang "; GUI_RICHTEXT_SCROLL_GET(rt) < 30; " "; GUI_RICHTEXT_HEADING_AT(rt)
GUI_RICHTEXT_SCROLL(rt, 0)
--- umgebung
DHRT_FRAMES=2
--- erwartet
vorgemerkt TRUE 1
anfang TRUE 0

=== suchen gleich nach dem setzen trifft den neuen text
' Bis hierhin suchte GUI_RICHTEXT_FIND direkt nach SET_TEXT im ALTEN Satz
' (-1, oder eine Lage aus dem vorigen Dokument). Jetzt wartet die Suche
' auf den Satz und liefert 0 = vorgemerkt.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM NL AS STRING : NL = CHR$(10)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM rt AS GUI_WIDGET : rt = GUI_RICHTEXT(w, 10, 10, 300, 200, "Altes Dokument" + NL)
GUI_UPDATE()
DIM text AS STRING : text = ""
DIM i AS INTEGER
FOR i = 1 TO 60
    text = text + "Zeile " + STR$(i) + NL + NL
NEXT
text = text + "Nadel im Heuhaufen" + NL
GUI_RICHTEXT_SET_TEXT(rt, text)
PRINT "antwort "; GUI_RICHTEXT_FIND(rt, "nadel", -1)
GUI_UPDATE()
PRINT "gerollt "; GUI_RICHTEXT_SCROLL_GET(rt) > 200
--- umgebung
DHRT_FRAMES=2
--- erwartet
antwort 0
gerollt TRUE

=== ein zitat ueber mehrere zeilen ist ein absatz
' Zeile fuer Zeile gesetzt zerfiel ein Hinweis in Bruchstuecke; jetzt gelten
' die Absatzregeln auch im Zitat (ein leeres `>` trennt).
IMPORT "gui"
SCREEN(600, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM NL AS STRING : NL = CHR$(10)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 10, 10, 560, 260)
DIM rt AS GUI_WIDGET : rt = GUI_RICHTEXT(w, 10, 10, 520, 200, "> eins" + NL + "> zwei" + NL + ">" + NL + "> drei" + NL)
GUI_UPDATE()
GUI_RICHTEXT_SELECT_ALL(rt)
PRINT "|"; REPLACE$(GUI_RICHTEXT_SELECTION$(rt), CHR$(10), "/"); "|"
--- umgebung
DHRT_FRAMES=2
--- erwartet
|eins zwei/drei|

=== codebloecke werden eingefaerbt
' Die Farbe der Schluesselwoerter setzt das Programm; gezaehlt werden rote
' Punkte im Bild. Gegenprobe im selben Lauf: mit -1 (Vorgabe) gibt es keine.
IMPORT "gui"
SCREEN(500, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM NL AS STRING : NL = CHR$(10)
GUI_THEME_PRESET("dark")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 500, 300)
DIM rt AS GUI_WIDGET : rt = GUI_RICHTEXT(w, 0, 0, 480, 260, "```" + NL + "FOR i = 1 TO 10" + NL + "NEXT" + NL + "```" + NL)
GUI_RICHTEXT_SET(rt, "groesse", 24)
FUNCTION rote() AS INTEGER
    DIM f AS INTEGER
    FOR f = 1 TO 2
        GUI_UPDATE() : CLS(BLACK) : GUI_DRAW() : FLIP()
    NEXT
    SAVESCREENSHOT("bild.png")
    DIM b AS IMAGE : b = LOADIMAGE("bild.png")
    DIM n AS INTEGER : n = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 0 TO 150 STEP 2
        FOR x = 0 TO 300 STEP 2
            DIM c AS INTEGER : c = GETPIXEL(b, x, y)
            IF ((c SHR 16) BAND 255) > 200 AND ((c SHR 8) BAND 255) < 60 AND (c BAND 255) < 60 THEN n = n + 1
        NEXT
    NEXT
    IMAGE_FREE(b)
    DELETEFILE("bild.png")
    RETURN n
END FUNCTION
GUI_RICHTEXT_SET(rt, "farbe_schluessel", &HFF0000)
PRINT "rot "; rote() > 10
GUI_RICHTEXT_SET(rt, "farbe_schluessel", -1)
PRINT "vorgabe "; rote()
--- umgebung
DHRT_FRAMES=20
--- erwartet
rot TRUE
vorgabe 0

=== ein bild hinter dem textbereich
' GUI_TEXTAREA_BACKGROUND: eingepasst und mittig. Deckend (255) ist die Mitte
' rot, bei 0 und nach dem Wegnehmen (-1) nicht.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_THEME_PRESET("dark")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 20, 20, 300, 200)
DIM bild AS IMAGE : bild = IMAGE_NEW(60, 40, &HFF0000)
FUNCTION mitteRot() AS BOOLEAN
    DIM f AS INTEGER
    FOR f = 1 TO 2
        GUI_UPDATE() : CLS(BLACK) : GUI_DRAW() : FLIP()
    NEXT
    SAVESCREENSHOT("bild.png")
    DIM b AS IMAGE : b = LOADIMAGE("bild.png")
    DIM c AS INTEGER : c = GETPIXEL(b, GUI_GET_X(ta) + 150 + GUI_WINDOW_GET_X(w), 150)
    IMAGE_FREE(b)
    DELETEFILE("bild.png")
    RETURN ((c SHR 16) BAND 255) > 200 AND ((c SHR 8) BAND 255) < 60
END FUNCTION
GUI_TEXTAREA_BACKGROUND(ta, bild, 255)
PRINT "deckend "; mitteRot()
GUI_TEXTAREA_BACKGROUND(ta, bild, 0)
PRINT "unsichtbar "; mitteRot()
GUI_TEXTAREA_BACKGROUND(ta, bild, 255)
GUI_TEXTAREA_BACKGROUND(ta, -1)
PRINT "weg "; mitteRot()
--- umgebung
DHRT_FRAMES=20
--- erwartet
deckend TRUE
unsichtbar FALSE
weg FALSE

=== das hintergrundbild nur fuer textbereiche
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w, "x", 10, 10, 50, 20)
GUI_TEXTAREA_BACKGROUND(k, -1)
--- umgebung
DHRT_FRAMES=2
--- fehler
GUI_TEXTAREA_BACKGROUND: erwartet einen Textbereich

=== die zeilenhoehe eines textbereichs folgt seiner schrift
' Bis 2026-09-27 kam die Zeilenhoehe aus der AKTIVEN Schrift: ein Feld mit
' eigener Groesse 30 hatte Zeilen fuer 16 -- die dritte Zeile lag dort, wo
' die Rechnung die fuenfte sah. Gegenprobe: ein Feld ohne eigene Groesse
' bleibt bei der alten Hoehe.
IMPORT "gui"
SCREEN(400, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 0, 0, 380, 380)
GUI_SET_TEXT(ta, "eins" + CHR$(10) + "zwei" + CHR$(10) + "drei" + CHR$(10) + "vier" + CHR$(10) + "fuenf" + CHR$(10) + "sechs")
GUI_SET_FONT_SIZE(ta, 30)
GUI_UPDATE()
DIM z AS INTEGER
DIM s AS INTEGER
' Zeile 3 bei 35 Punkten Zeilenhoehe: 5 + 2 * 35 + 17
(z, s) = GUI_TEXTAREA_POS_AT(ta, 10, 92)
PRINT "gross "; z
GUI_SET_FONT_SIZE(ta, 0)
GUI_UPDATE()
(z, s) = GUI_TEXTAREA_POS_AT(ta, 10, 92)
PRINT "vorgabe "; z > 3
--- umgebung
DHRT_FRAMES=2
--- erwartet
gross 3
vorgabe TRUE
