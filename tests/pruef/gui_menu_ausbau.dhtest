=== kuerzel gilt auch wenn ein anderes fenster den fokus hat
' Werkzeugleiste links, Inspektor rechts, EIN Menue: Strg+S muss auch
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM w2 AS GUI_WINDOW
w2 = GUI_WINDOW("Inspektor", 200, 40, 150, 200)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w2, "Ok", 10, 10, 80, 26)
DIM a AS INTEGER : a = GUI_MENU_ITEM(m, "Sichern", "Strg+S")
GUI_FOCUS(k)
DIM f AS INTEGER
FOR f = 1 TO 10
    GUI_UPDATE()
    IF GUI_CLICKED(a) THEN PRINT "sichern " + STR$(f) + " " + STR$(GUI_FOCUSED() = k)
    GUI_DRAW()
    FLIP()
NEXT
