' ===========================================================================
'  113_physics2d_sprites.gb  --  physics2d + DRAWIMAGEROT
'
'  Echte 2D-Physik (Modul "physics2d") mit ECHTEN Sprites: jeder Koerper traegt
'  ein Bild, das per DRAWIMAGEROT um seinen Physik-Winkel gedreht gezeichnet wird
'  (BODY_ANGLE ist Radiant -> DEG() in Grad). Die Sprites purzeln, kippen und
'  stapeln sich physikalisch korrekt.
'
'  Steuerung:  Klick / halten = Sprite spawnen   ·   ESC = Ende
' ===========================================================================
IMPORT "physics2d"

CONST W AS INTEGER = 640
CONST H AS INTEGER = 440
SCREEN(W, H, "physics2d + rotierte Sprites -- Klick = mehr, ESC = Ende", 1)
SETFPS(60)

DIM img AS IMAGE
img = LOADIMAGE("assets/hero.png")     ' 16x16
CONST SCALE AS FLOAT = 2.0             ' 16 px * 2 = 32 px sichtbar
CONST HALF AS FLOAT = 16.0            ' Koerper-Halb-Extent = 32 px / 2

DIM world AS PHYS2D_WORLD
world = PHYS2D_NEW()
' statischer Kasten
PHYS2D_ADD_BOX(world, W / 2, H - 12, W / 2, 12, FALSE, 0.2)
PHYS2D_ADD_BOX(world, 10, H / 2, 10, H / 2, FALSE, 0.2)
PHYS2D_ADD_BOX(world, W - 10, H / 2, 10, H / 2, FALSE, 0.2)

DIM ids[0] AS INTEGER
DIM tick AS INTEGER
tick = 0

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    tick = tick + 1

    DIM do_spawn AS BOOLEAN
    do_spawn = FALSE
    DIM sx AS FLOAT
    sx = RANDF(60.0, W - 60.0)
    DIM sy AS FLOAT
    sy = 40.0
    IF MOUSEBUTTON(0) = 1 THEN
        do_spawn = TRUE
        sx = FLT(MOUSEX())
        sy = FLT(MOUSEY())
    END IF
    IF tick MOD 22 = 0 THEN do_spawn = TRUE

    IF do_spawn AND LEN(ids) < 48 THEN
        DIM id AS INTEGER
        id = PHYS2D_ADD_BOX(world, sx, sy, HALF, HALF, TRUE, 0.2)
        ARRAY_PUSH(ids, id)
    END IF

    PHYS2D_STEP(world, DELTA())

    CLS(RGB(24, 26, 40))
    BOX(0, H - 24, W, H, RGB(40, 44, 62))
    BOX(0, 0, 20, H, RGB(40, 44, 62))
    BOX(W - 20, 0, W, H, RGB(40, 44, 62))

    DIM j AS INTEGER
    FOR j = 0 TO LEN(ids) - 1
        DIM cx AS FLOAT
        cx = PHYS2D_BODY_X(world, ids[j])
        DIM cy AS FLOAT
        cy = PHYS2D_BODY_Y(world, ids[j])
        DIM deg AS FLOAT
        deg = DEG(PHYS2D_BODY_ANGLE(world, ids[j]))
        ' Sprite zentriert auf (cx,cy), gedreht um den Physik-Winkel
        DRAWIMAGEROT(img, cx, cy, deg, SCALE)
    NEXT

    TEXT(28, 10, "Sprites: " + STR$(PHYS2D_COUNT(world) - 3) + "   Klick = mehr")
    FLIP()
WEND
