=== print dann fehler in derselben runde
DIM i AS INTEGER
DIM s AS FLOAT
TRY
    FOR i = 3 TO -3 STEP -1
        PRINT "vorher "; i
        s = s + SQR(i)
        PRINT "nachher "; s
    NEXT
CATCH e
    PRINT "gefangen: "; e
END TRY
PRINT i
