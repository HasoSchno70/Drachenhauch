=== with dotted name invisible to user (1)
' User-Code kann `__with_0` nicht sehen oder neu deklarieren --
CLASS P
    DIM v AS INTEGER
END CLASS

DIM x AS INTEGER
x = 999
DIM p AS P
p = NEW P()
WITH p
    .v = 1
END WITH
PRINT x
--- erwartet
999

