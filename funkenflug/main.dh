' Funkenflug -- ein Schaltplan-Editor in Drachenhauch mit GTK 3.
'
' Eine Neufassung der Idee hinter SparkNode (Python/PySide6), bewusst ohne
' dessen Stolperfallen: EINE Rotations-/Transform-Konvention (gezeichnete ==
' elektrische Pins), EINE Netz-Erkennung, Pin-Punkt eindeutig als elektrischer
' Andockpunkt, Undo ueber vollstaendige Schnappschuesse. GTK/Cairo wie in
' Glutfaden (der GTK-Portierung von PySticky).
'
'   dhrt run funkenflug/main.dh                 (Demo-Schaltung)
'   dhrt run funkenflug/main.dh -- datei.fkn    (diese Datei oeffnen)
'   dhrt run funkenflug/main.dh -- --foto C:/.../bild.png   (Selbsttest)
'
' Aufbau:
'   kern/      Modell, Geometrie, Bibliothek, Netze, Datei (Namensraum kern)
'   gtk/       Deklarationen fuer GTK, GDK, Cairo, Pango
'   ansicht/   Zeichenflaeche, Werkzeuge, Verlauf (globaler Namensraum)
IMPORT "kern/kern.dh" AS kern
IMPORT "gtk/gtk.dh"
IMPORT "ansicht/leinwand.dh"
IMPORT "ansicht/werkzeuge.dh"
IMPORT "ansicht/verlauf.dh"
IMPORT "ansicht/auswahl.dh"
IMPORT "ansicht/symboleditor.dh"
IMPORT "ansicht/ausgabe.dh"

CONST STIL = "window { background-color: #12131a; color: #e6e6f0; }" + _
    " headerbar { background-color: #1a1c26; color: #e6e6f0; }" + _
    " headerbar .title { font-weight: 700; }" + _
    " .leiste { background-color: #1a1c26; border-bottom: 1px solid #2c2f3c; padding: 4px 8px; }" + _
    " .leiste button, .leiste combobox button { background-color: #262a38; color: #e6e6f0; border: 1px solid #333848; border-radius: 6px; padding: 3px 10px; }" + _
    " .leiste button:checked { background-color: #ff8a3d; color: #1a1a2e; }" + _
    " .status { background-color: #1a1c26; color: #aeb4c4; padding: 3px 10px; font-size: 9pt; }" + _
    " .pinliste { font-family: monospace; font-size: 10pt; }"

CONST GTK_KNOEPFE_OK = 1              ' GTK_BUTTONS_OK
CONST LOGO = "daten/bilder/funkenflug_256.png"

DIM gFenster AS INTEGER
DIM gKopf AS INTEGER
DIM gStatus AS INTEGER
DIM gKnopfAuswahl AS INTEGER
DIM gKnopfDraht AS INTEGER
DIM gKnopfLabel AS INTEGER
DIM gKnopfZurueck AS INTEGER
DIM gKnopfVor AS INTEGER
DIM gSymbolWahl AS INTEGER
DIM gComboIds AS ARRAY OF STRING  ' Symbol-Id je Eintrag der Bauteilliste
DIM gComboEigene AS INTEGER       ' wie viele eigene Symbole die Liste zeigt
DIM gBibPfad AS STRING            ' persoenliche Symbol-Bibliothek
DIM fotoZiel AS STRING

' Der gerade offene Dialog und seine Eingabefelder -- damit der Selbsttest
' ihn ausfuellen und bestaetigen kann.
DIM gDlg AS INTEGER
DIM gDlgFeld1 AS INTEGER
DIM gDlgFeld2 AS INTEGER
DIM gDlgHakenWert AS BOOLEAN      ' Ergebnis des Hakens im Umbenennen-Dialog
DIM gFragen AS INTEGER            ' wie oft bestaetigen() gefragt hat (Selbsttest)

FUNCTION basisName$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(p) - 1 TO 0 STEP -1                ' MID$ zaehlt ab 0
        DIM c AS STRING : c = MID$(p, i, 1)
        IF c = "/" OR c = "\" THEN RETURN MID$(p, i + 1)
    NEXT
    RETURN p
END FUNCTION

' --- Statuszeile und Titel
SUB statusAktualisieren()
    IF gStatus = 0 THEN RETURN
    DIM wz AS STRING : wz = "Auswahl"
    IF gWerkzeug = WZ_DRAHT THEN wz = "Draht"
    IF gWerkzeug = WZ_BAUTEIL THEN wz = "Bauteil"
    IF gWerkzeug = WZ_LABEL THEN wz = "Label"
    DIM zoom AS INTEGER : zoom = ROUND(vZoom / 0.12 * 100)
    DIM pos AS STRING : pos = ""
    IF gMausDrin THEN pos = "   X " + STR$(gMausWX / 100) + " mm   Y " + STR$(gMausWY / 100) + " mm"
    DIM wahl AS STRING : wahl = ""
    IF gHatGewaehlt THEN wahl = "   Auswahl: " + gGewaehlt.referenz + " " + gGewaehlt.wert + " (" + gGewaehlt.sym.name + ")"
    IF gHatLabel THEN wahl = "   Label: " + gLabelGewaehlt.text + " (F2 benennt um)"
    IF gHatDraht THEN
        IF gSegment >= 0 THEN
            wahl = "   Draht: Segment " + STR$(gSegment + 1) + " von " + STR$(LEN(gDrahtGewaehlt.punkte) - 1) + " (Entf: Segment, Umschalt+Entf: Draht, F2: Netz umbenennen)"
        ELSE
            wahl = "   Draht (Entf loescht ihn, F2: Netz umbenennen)"
        END IF
    END IF
    IF auswahlAnzahl() > 1 THEN wahl = "   Auswahl: " + STR$(LEN(gSelB)) + " Bauteile, " + STR$(LEN(gSelD)) + " Draehte, " + STR$(LEN(gSelL)) + " Labels (ziehen verschiebt, Strg+C kopiert, Entf loescht)"
    DIM netz AS STRING : netz = hoverText$()
    IF netz <> "" THEN netz = "   " + netz
    gtk_label_set_text(gStatus, wz + "   Zoom " + STR$(zoom) + "%" + pos + netz + wahl + "   [" + STR$(LEN(gBlatt.bauteile)) + " Bauteile, " + STR$(LEN(gBlatt.draehte)) + " Draehte, " + STR$(LEN(gBlatt.labels)) + " Labels]")
END SUB

SUB titelNachziehen()
    IF gKopf = 0 THEN RETURN
    DIM name AS STRING : name = "ohne Namen"
    IF gPfad <> "" THEN name = basisName$(gPfad)
    IF gGeaendert THEN name = name + " *"
    gtk_header_bar_set_subtitle(gKopf, name)
END SUB

' Achtung GTK: gtk_toggle_button_set_active loest bei einer Aenderung auch
' "clicked" aus. Ohne Sperre setzte das Ausschalten von "Auswahl" gleich
' wieder das Auswahl-Werkzeug -- ein gewaehltes Bauteil liess sich so nie
' platzieren, Draht/Label pendelten hin und her.
DIM gKnoepfeSetzen AS BOOLEAN

SUB werkzeugKnoepfeNachziehen()
    IF gKnopfAuswahl = 0 THEN RETURN
    gKnoepfeSetzen = TRUE
    gtk_toggle_button_set_active(gKnopfAuswahl, gWerkzeug = WZ_AUSWAHL)
    gtk_toggle_button_set_active(gKnopfDraht, gWerkzeug = WZ_DRAHT)
    gtk_toggle_button_set_active(gKnopfLabel, gWerkzeug = WZ_LABEL)
    gKnoepfeSetzen = FALSE
END SUB

SUB verlaufKnoepfeNachziehen()
    IF gKnopfZurueck = 0 THEN RETURN
    gtk_widget_set_sensitive(gKnopfZurueck, kannZurueck())
    gtk_widget_set_sensitive(gKnopfVor, kannVor())
END SUB

' --- Dialoge
SUB meldung(text AS STRING)
    DIM d AS INTEGER : d = gtk_message_dialog_new(gFenster, GTK_DIALOG_MODAL, GTK_NACHRICHT_WARNUNG, GTK_KNOEPFE_OK, "%s", text)
    gDlg = d
    DIM antwort AS INTEGER : antwort = gtk_dialog_run(d)
    gDlg = 0
    gtk_widget_destroy(d)
END SUB

FUNCTION dialogNeu(titel AS STRING) AS INTEGER
    DIM d AS INTEGER : d = gtk_dialog_new_with_buttons(titel, gFenster, GTK_DIALOG_MODAL, "Abbrechen", GTK_ANTWORT_ABBRECHEN, "OK", GTK_ANTWORT_OK, NIL)
    gtk_dialog_set_default_response(d, GTK_ANTWORT_OK)
    RETURN d
END FUNCTION

FUNCTION feldNeu(text AS STRING) AS INTEGER
    DIM f AS INTEGER : f = gtk_entry_new()
    gtk_entry_set_text(f, text)
    gtk_entry_set_activates_default(f, TRUE)
    gtk_entry_set_width_chars(f, 18)
    RETURN f
END FUNCTION

FUNCTION etikettNeu(text AS STRING) AS INTEGER
    DIM l AS INTEGER : l = gtk_label_new(text)
    gtk_label_set_xalign(l, 0.0)
    RETURN l
END FUNCTION

' Eine Zeile Text abfragen; "" bei Abbruch.
FUNCTION textAbfrage$(titel AS STRING, frage AS STRING, vorgabe AS STRING) AS STRING
    DIM d AS INTEGER : d = dialogNeu(titel)
    DIM box AS INTEGER : box = gtk_box_new(GTK_WAAGERECHT, 8)
    gtk_container_set_border_width(box, 12)
    gtk_box_pack_start(box, etikettNeu(frage), FALSE, FALSE, 0)
    DIM feld AS INTEGER : feld = feldNeu(vorgabe)
    gtk_box_pack_start(box, feld, TRUE, TRUE, 0)
    gtk_box_pack_start(gtk_dialog_get_content_area(d), box, TRUE, TRUE, 0)
    gtk_widget_show_all(d)
    gDlg = d : gDlgFeld1 = feld : gDlgFeld2 = 0
    DIM text AS STRING : text = ""
    IF gtk_dialog_run(d) = GTK_ANTWORT_OK THEN text = gtk_entry_get_text(feld)
    gDlg = 0 : gDlgFeld1 = 0
    gtk_widget_destroy(d)
    RETURN text
END FUNCTION

' Neuen Netznamen abfragen; mit hakenText einen Haken darunter (Vorgabe: an),
' dessen Stand danach in gDlgHakenWert steht. "" bei Abbruch.
FUNCTION umbenennenDialog$(titel AS STRING, frage AS STRING, vorgabe AS STRING, hakenText AS STRING) AS STRING
    DIM d AS INTEGER : d = dialogNeu(titel)
    DIM vb AS INTEGER : vb = gtk_box_new(GTK_SENKRECHT, 8)
    gtk_container_set_border_width(vb, 12)
    DIM zeile AS INTEGER : zeile = gtk_box_new(GTK_WAAGERECHT, 8)
    gtk_box_pack_start(zeile, etikettNeu(frage), FALSE, FALSE, 0)
    DIM feld AS INTEGER : feld = feldNeu(vorgabe)
    gtk_box_pack_start(zeile, feld, TRUE, TRUE, 0)
    gtk_box_pack_start(vb, zeile, FALSE, FALSE, 0)
    DIM haken AS INTEGER : haken = 0
    IF hakenText <> "" THEN
        haken = gtk_check_button_new_with_label(hakenText)
        gtk_toggle_button_set_active(haken, TRUE)
        gtk_box_pack_start(vb, haken, FALSE, FALSE, 0)
    END IF
    gtk_box_pack_start(gtk_dialog_get_content_area(d), vb, TRUE, TRUE, 0)
    gtk_widget_show_all(d)
    gDlg = d : gDlgFeld1 = feld : gDlgFeld2 = 0
    DIM text AS STRING : text = ""
    IF gtk_dialog_run(d) = GTK_ANTWORT_OK THEN text = gtk_entry_get_text(feld)
    gDlgHakenWert = FALSE
    IF haken <> 0 THEN gDlgHakenWert = gtk_toggle_button_get_active(haken)
    gDlg = 0 : gDlgFeld1 = 0
    gtk_widget_destroy(d)
    RETURN text
END FUNCTION

' Ja/Nein-Rueckfrage; TRUE, wenn der Nutzer "knopf" waehlt.
FUNCTION bestaetigen(titel AS STRING, text AS STRING, knopf AS STRING) AS BOOLEAN
    gFragen = gFragen + 1
    DIM d AS INTEGER : d = gtk_dialog_new_with_buttons(titel, gFenster, GTK_DIALOG_MODAL, "Abbrechen", GTK_ANTWORT_ABBRECHEN, knopf, GTK_ANTWORT_OK, NIL)
    DIM l AS INTEGER : l = etikettNeu(text)
    gtk_widget_set_margin_start(l, 12)
    gtk_widget_set_margin_end(l, 12)
    gtk_widget_set_margin_top(l, 12)
    gtk_widget_set_margin_bottom(l, 12)
    gtk_box_pack_start(gtk_dialog_get_content_area(d), l, TRUE, TRUE, 0)
    gtk_widget_show_all(d)
    gDlg = d : gDlgFeld1 = 0 : gDlgFeld2 = 0
    DIM ja AS BOOLEAN : ja = gtk_dialog_run(d) = GTK_ANTWORT_OK
    gDlg = 0
    gtk_widget_destroy(d)
    RETURN ja
END FUNCTION

' Referenz und Wert eines Bauteils aendern. Eine schon vergebene Referenz
' wird abgelehnt (SparkNode liess doppelte Referenzen still zu).
SUB eigenschaftenDialog(b AS kern.Bauteil)
    DIM d AS INTEGER : d = dialogNeu("Eigenschaften")
    DIM g AS INTEGER : g = gtk_grid_new()
    gtk_grid_set_row_spacing(g, 6)
    gtk_grid_set_column_spacing(g, 10)
    gtk_container_set_border_width(g, 12)
    DIM feldRef AS INTEGER : feldRef = feldNeu(b.referenz)
    DIM feldWert AS INTEGER : feldWert = feldNeu(b.wert)
    gtk_grid_attach(g, etikettNeu("Symbol:"), 0, 0, 1, 1)
    gtk_grid_attach(g, etikettNeu(b.sym.name), 1, 0, 1, 1)
    gtk_grid_attach(g, etikettNeu("Referenz:"), 0, 1, 1, 1)
    gtk_grid_attach(g, feldRef, 1, 1, 1, 1)
    gtk_grid_attach(g, etikettNeu("Wert:"), 0, 2, 1, 1)
    gtk_grid_attach(g, feldWert, 1, 2, 1, 1)
    gtk_box_pack_start(gtk_dialog_get_content_area(d), g, TRUE, TRUE, 0)
    gtk_widget_show_all(d)
    gDlg = d : gDlgFeld1 = feldRef : gDlgFeld2 = feldWert
    DIM ok AS BOOLEAN : ok = gtk_dialog_run(d) = GTK_ANTWORT_OK
    DIM neuRef AS STRING : neuRef = TRIM$(gtk_entry_get_text(feldRef))
    DIM neuWert AS STRING : neuWert = TRIM$(gtk_entry_get_text(feldWert))
    gDlg = 0 : gDlgFeld1 = 0 : gDlgFeld2 = 0
    gtk_widget_destroy(d)
    IF NOT ok THEN RETURN
    IF neuRef = b.referenz AND neuWert = b.wert THEN RETURN
    IF referenzBelegt(neuRef, b) THEN
        meldung("Die Referenz " + neuRef + " ist schon vergeben.")
        RETURN
    END IF
    verlaufMerken()
    b.referenz = neuRef
    b.wert = neuWert
    geaendert()
END SUB

' --- ERC: nicht-modaler Dialog mit der Liste der Verstoesse; eine Zeile
' anklicken holt die Stelle in die Mitte und hebt ihren Marker hervor.
DIM gErcDlg AS INTEGER
DIM gErcListe AS INTEGER

FUNCTION markupSicher$(s AS STRING) AS STRING
    RETURN REPLACE$(REPLACE$(REPLACE$(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
END FUNCTION

SUB ercZeile(box AS INTEGER, zeile AS INTEGER, daten AS INTEGER)
    IF zeile = 0 THEN RETURN
    DIM i AS INTEGER : i = gtk_list_box_row_get_index(zeile)
    IF i < 0 OR i >= LEN(gErc) THEN RETURN
    gErcGewaehlt = i
    zentrieren(gErc[i].x, gErc[i].y)
END SUB

SUB ercZu(dlg AS INTEGER, antwort AS INTEGER, daten AS INTEGER)
    gErcSichtbar = FALSE
    gErcDlg = 0
    gErcListe = 0
    gtk_widget_destroy(dlg)
    neuZeichnen()
END SUB

SUB ercAusfuehren()
    IF gErcDlg <> 0 THEN
        gtk_widget_destroy(gErcDlg)
        gErcDlg = 0
    END IF
    gErc = kern.ercPruefen(gBlatt)
    gErcSichtbar = TRUE
    gErcGewaehlt = -1
    DIM nf AS INTEGER : nf = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gErc) - 1
        IF gErc[i].schwere = kern.ERC_FEHLER THEN nf = nf + 1
    NEXT
    DIM nw AS INTEGER : nw = LEN(gErc) - nf
    gErcDlg = gtk_dialog_new_with_buttons("Elektrische Regelpruefung", gFenster, 0, "Schliessen", GTK_ANTWORT_OK, NIL)
    DIM vb AS INTEGER : vb = gtk_box_new(GTK_SENKRECHT, 8)
    gtk_container_set_border_width(vb, 12)
    DIM kopf AS STRING
    IF LEN(gErc) = 0 THEN
        kopf = "Keine Verstoesse gefunden."
    ELSE
        kopf = STR$(nf) + " Fehler, " + STR$(nw) + " Warnungen -- eine Zeile anklicken springt hin."
    END IF
    gtk_box_pack_start(vb, etikettNeu(kopf), FALSE, FALSE, 0)
    IF LEN(gErc) > 0 THEN
        DIM sw AS INTEGER : sw = gtk_scrolled_window_new(0, 0)
        gtk_scrolled_window_set_policy(sw, GTK_POLITIK_NIE, GTK_POLITIK_AUTO)
        gtk_scrolled_window_set_min_content_height(sw, 220)
        gtk_widget_set_size_request(sw, 480, -1)
        gErcListe = gtk_list_box_new()
        gtk_list_box_set_selection_mode(gErcListe, GTK_AUSWAHL_EINE)
        FOR i = 0 TO LEN(gErc) - 1
            DIM zeile AS INTEGER : zeile = gtk_label_new("")
            DIM art AS STRING
            IF gErc[i].schwere = kern.ERC_FEHLER THEN
                art = "<span foreground='#ff5a5a'><b>Fehler</b></span>"
            ELSE
                art = "<span foreground='#ffc23d'><b>Warnung</b></span>"
            END IF
            gtk_label_set_markup(zeile, art + "   " + markupSicher$(gErc[i].text))
            gtk_label_set_xalign(zeile, 0.0)
            gtk_widget_set_margin_start(zeile, 6)
            gtk_widget_set_margin_top(zeile, 3)
            gtk_widget_set_margin_bottom(zeile, 3)
            gtk_list_box_insert(gErcListe, zeile, -1)
        NEXT
        gtk_container_add(sw, gErcListe)
        gtk_box_pack_start(vb, sw, TRUE, TRUE, 0)
        signalZeile(gErcListe, "row-selected", ercZeile, 0, 0, 0)
    END IF
    gtk_box_pack_start(gtk_dialog_get_content_area(gErcDlg), vb, TRUE, TRUE, 0)
    signalAntwort(gErcDlg, "response", ercZu, 0, 0, 0)
    gtk_widget_show_all(gErcDlg)
    neuZeichnen()
END SUB

' --- Netzliste: das Format folgt der Endung (.cir/.sp SPICE, .csv, .net/.txt)
FUNCTION exportTitel$() AS STRING
    IF gDok.titel <> "" THEN RETURN gDok.titel
    IF gPfad <> "" THEN RETURN basisName$(gPfad)
    RETURN "Schaltplan"
END FUNCTION

FUNCTION exportNach(pfad AS STRING) AS BOOLEAN
    DIM klein AS STRING : klein = LOWER$(pfad)
    DIM text AS STRING
    IF ENDSWITH(klein, ".csv") THEN
        text = kern.netzlisteCsv$(gBlatt)
    ELSEIF ENDSWITH(klein, ".net") OR ENDSWITH(klein, ".txt") THEN
        text = kern.netzlisteText$(gBlatt)
    ELSE
        IF NOT CONTAINS(basisName$(pfad), ".") THEN pfad = pfad + ".cir"
        text = kern.netzlisteSpice$(gBlatt, exportTitel$())
    END IF
    TRY
        WRITEALL(pfad, text)
    CATCH e
        RETURN FALSE
    END TRY
    RETURN TRUE
END FUNCTION

' Datei zum Exportieren waehlen. Je Filter ein Name und seine Muster
' (mehrere durch ; getrennt). "" bei Abbruch.
FUNCTION dateiExportWahl(titel AS STRING, vorschlag AS STRING, namen AS ARRAY OF STRING, muster AS ARRAY OF STRING) AS STRING
    DIM d AS INTEGER : d = gtk_file_chooser_dialog_new(titel, gFenster, GTK_DATEI_SICHERN, "Abbrechen", GTK_ANTWORT_ABBRECHEN, "Exportieren", GTK_ANTWORT_ANNEHMEN, NIL)
    DIM i AS INTEGER, k AS INTEGER
    FOR i = 0 TO LEN(namen) - 1
        DIM f AS INTEGER : f = gtk_file_filter_new()
        gtk_file_filter_set_name(f, namen[i])
        DIM m AS ARRAY OF STRING : m = SPLIT$(muster[i], ";")
        FOR k = 0 TO LEN(m) - 1
            gtk_file_filter_add_pattern(f, m[k])
        NEXT
        gtk_file_chooser_add_filter(d, f)
    NEXT
    gtk_file_chooser_set_do_overwrite_confirmation(d, TRUE)
    gtk_file_chooser_set_current_name(d, vorschlag)
    DIM pfad AS STRING : pfad = ""
    IF gtk_dialog_run(d) = GTK_ANTWORT_ANNEHMEN THEN
        DIM z AS INTEGER : z = gtk_file_chooser_get_filename(d)
        IF z <> 0 THEN
            pfad = TEXT_AUS_ZEIGER$(z)
            g_free(z)
        END IF
    END IF
    gtk_widget_destroy(d)
    RETURN pfad
END FUNCTION

SUB aufErc(knopf AS INTEGER, daten AS INTEGER)
    ercAusfuehren()
END SUB

SUB aufExport(knopf AS INTEGER, daten AS INTEGER)
    DIM pfad AS STRING : pfad = dateiExportWahl("Netzliste exportieren", "netzliste.cir", ["SPICE (*.cir, *.sp)", "CSV (*.csv)", "Text (*.net, *.txt)"], ["*.cir;*.sp", "*.csv", "*.net;*.txt"])
    IF pfad = "" THEN RETURN
    IF NOT exportNach(pfad) THEN meldung("Die Netzliste liess sich nicht nach " + pfad + " schreiben.")
END SUB

' --- Werkzeug-Knoepfe
SUB aufAuswahl(knopf AS INTEGER, daten AS INTEGER)
    IF gKnoepfeSetzen THEN RETURN
    werkzeugWaehlen(WZ_AUSWAHL, "")
END SUB

SUB aufDraht(knopf AS INTEGER, daten AS INTEGER)
    IF gKnoepfeSetzen THEN RETURN
    werkzeugWaehlen(WZ_DRAHT, "")
END SUB

SUB aufLabel(knopf AS INTEGER, daten AS INTEGER)
    IF gKnoepfeSetzen THEN RETURN
    werkzeugWaehlen(WZ_LABEL, "")
END SUB

SUB aufSymbol(combo AS INTEGER, daten AS INTEGER)
    DIM idx AS INTEGER : idx = gtk_combo_box_get_active(combo)
    IF idx < 0 OR idx >= LEN(gComboIds) THEN RETURN
    werkzeugWaehlen(WZ_BAUTEIL, gComboIds[idx])
END SUB

' --- Bauteilliste und eigene Symbole ----------------------------------------

' Die Bauteilliste neu fuellen: eingebaute, dann eigene (ohne Platzhalter).
' Ohne erzwingen nur, wenn neue eigene Symbole dazukamen (Laden, Einfuegen).
SUB symbolListeAktualisieren(erzwingen AS BOOLEAN)
    IF gSymbolWahl = 0 THEN RETURN
    DIM eigene AS ARRAY OF kern.Symbol : eigene = kern.eigeneSymbole()
    IF NOT erzwingen AND LEN(eigene) = gComboEigene THEN RETURN
    gComboEigene = LEN(eigene)
    gtk_combo_box_text_remove_all(gSymbolWahl)
    gComboIds = []
    DIM liste AS ARRAY OF kern.Symbol : liste = kern.bibliothekListe()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(liste) - 1
        gtk_combo_box_text_append_text(gSymbolWahl, liste[i].name)
        ARRAY_PUSH(gComboIds, liste[i].id)
    NEXT
    FOR i = 0 TO LEN(eigene) - 1
        IF eigene[i].fehlt THEN CONTINUE
        gtk_combo_box_text_append_text(gSymbolWahl, eigene[i].name + "  (eigen)")
        ARRAY_PUSH(gComboIds, eigene[i].id)
    NEXT
END SUB

FUNCTION listeHat(id AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gComboIds) - 1
        IF gComboIds[i] = id THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Das Symbol in der Liste waehlen -- das stellt das Werkzeug aufs Platzieren.
SUB symbolInListeWaehlen(id AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gComboIds) - 1
        IF gComboIds[i] = id THEN gtk_combo_box_set_active(gSymbolWahl, i)
    NEXT
END SUB

FUNCTION bibliotheksPfad$() AS STRING
    DIM eigen AS STRING : eigen = GETENV$("FUNKENFLUG_BIBLIOTHEK", "")
    IF eigen <> "" THEN RETURN eigen
    DIM a AS STRING : a = GETENV$("APPDATA", "")
    IF a <> "" THEN RETURN PATHJOIN(PATHJOIN(a, "Funkenflug"), "symbole.fkl")
    DIM x AS STRING : x = GETENV$("XDG_CONFIG_HOME", "")
    IF x = "" THEN x = PATHJOIN(GETENV$("HOME", "."), ".config")
    RETURN PATHJOIN(PATHJOIN(x, "funkenflug"), "symbole.fkl")
END FUNCTION

FUNCTION bibliothekSichern(s AS kern.Symbol) AS BOOLEAN
    DIM ordner AS STRING : ordner = LEFT$(gBibPfad, LEN(gBibPfad) - LEN(basisName$(gBibPfad)))
    IF ordner <> "" THEN
        IF NOT DIREXISTS(ordner) THEN MKDIR(ordner)
    END IF
    RETURN kern.bibliothekAufnehmen(s, gBibPfad)
END FUNCTION

FUNCTION neuesSymbolUI() AS STRING
    DIM id AS STRING : id = symbolEditor(NEW kern.Symbol("", "", ""), FALSE)
    IF id = "" THEN RETURN ""
    symbolListeAktualisieren(TRUE)
    symbolInListeWaehlen(id)
    RETURN id
END FUNCTION

FUNCTION symbolBearbeitenUI(s AS kern.Symbol) AS STRING
    DIM id AS STRING : id = symbolEditor(s, TRUE)
    IF id <> "" THEN symbolListeAktualisieren(TRUE)
    RETURN id
END FUNCTION

' Knopf "Symbol ...": ein gewaehltes eigenes Symbol bearbeiten, sonst ein
' neues anlegen.
SUB aufSymbolEditor(knopf AS INTEGER, daten AS INTEGER)
    IF gHatGewaehlt THEN
        IF gGewaehlt.sym.eigen AND NOT gGewaehlt.sym.fehlt THEN
            DIM r AS STRING : r = symbolBearbeitenUI(gGewaehlt.sym)
            RETURN
        END IF
    END IF
    DIM n AS STRING : n = neuesSymbolUI()
END SUB

' --- Stueckliste -------------------------------------------------------------

FUNCTION stuecklisteNach(pfad AS STRING) AS BOOLEAN
    DIM klein AS STRING : klein = LOWER$(pfad)
    DIM text AS STRING
    IF ENDSWITH(klein, ".md") THEN
        text = kern.stuecklisteMarkdown$(gBlatt, exportTitel$())
    ELSEIF ENDSWITH(klein, ".txt") THEN
        text = kern.stuecklisteText$(gBlatt)
    ELSE
        IF NOT CONTAINS(basisName$(pfad), ".") THEN pfad = pfad + ".csv"
        text = kern.stuecklisteCsv$(gBlatt)
    END IF
    TRY
        WRITEALL(pfad, text)
    CATCH e
        RETURN FALSE
    END TRY
    RETURN TRUE
END FUNCTION

CONST ANTWORT_EXPORT = 1

SUB stuecklisteZeigen()
    DIM z AS ARRAY OF kern.BomZeile : z = kern.stueckliste(gBlatt)
    DIM d AS INTEGER : d = gtk_dialog_new_with_buttons("Stueckliste", gFenster, GTK_DIALOG_MODAL, "Exportieren ...", ANTWORT_EXPORT, "Schliessen", GTK_ANTWORT_OK, NIL)
    gtk_window_set_default_size(d, 620, 420)
    DIM vb AS INTEGER : vb = gtk_box_new(GTK_SENKRECHT, 8)
    gtk_container_set_border_width(vb, 12)
    DIM sw AS INTEGER : sw = gtk_scrolled_window_new(0, 0)
    gtk_scrolled_window_set_min_content_height(sw, 280)
    DIM g AS INTEGER : g = gtk_grid_new()
    gtk_grid_set_column_spacing(g, 18)
    gtk_grid_set_row_spacing(g, 4)
    DIM kopf AS ARRAY OF STRING : kopf = ["Menge", "Referenzen", "Wert", "Bauteil"]
    DIM i AS INTEGER, summe AS INTEGER
    FOR i = 0 TO 3
        DIM k AS INTEGER : k = gtk_label_new("")
        gtk_label_set_markup(k, "<b>" + kopf[i] + "</b>")
        gtk_label_set_xalign(k, 0.0)
        gtk_grid_attach(g, k, i, 0, 1, 1)
    NEXT
    summe = 0
    FOR i = 0 TO LEN(z) - 1
        gtk_grid_attach(g, etikettNeu(STR$(z[i].menge)), 0, i + 1, 1, 1)
        DIM refs AS INTEGER : refs = etikettNeu(kern.referenzBereiche$(z[i].referenzen))
        gtk_label_set_line_wrap(refs, TRUE)
        gtk_label_set_max_width_chars(refs, 34)
        gtk_grid_attach(g, refs, 1, i + 1, 1, 1)
        gtk_grid_attach(g, etikettNeu(z[i].wert), 2, i + 1, 1, 1)
        gtk_grid_attach(g, etikettNeu(z[i].bauteil), 3, i + 1, 1, 1)
        summe = summe + z[i].menge
    NEXT
    gtk_container_add(sw, g)
    gtk_box_pack_start(vb, sw, TRUE, TRUE, 0)
    gtk_box_pack_start(vb, etikettNeu(STR$(summe) + " Bauteile in " + STR$(LEN(z)) + " Positionen (ohne Versorgungssymbole)"), FALSE, FALSE, 0)
    gtk_box_pack_start(gtk_dialog_get_content_area(d), vb, TRUE, TRUE, 0)
    gtk_widget_show_all(d)
    gDlg = d : gDlgFeld1 = 0 : gDlgFeld2 = 0
    WHILE gtk_dialog_run(d) = ANTWORT_EXPORT
        DIM pfad AS STRING : pfad = dateiExportWahl("Stueckliste exportieren", "stueckliste.csv", ["CSV (*.csv)", "Markdown (*.md)", "Text (*.txt)"], ["*.csv", "*.md", "*.txt"])
        IF pfad <> "" THEN
            IF NOT stuecklisteNach(pfad) THEN meldung("Die Stueckliste liess sich nicht nach " + pfad + " schreiben.")
        END IF
    WEND
    gDlg = 0
    gtk_widget_destroy(d)
END SUB

SUB aufStueckliste(knopf AS INTEGER, daten AS INTEGER)
    stuecklisteZeigen()
END SUB

SUB aufZurueck(knopf AS INTEGER, daten AS INTEGER)
    verlaufZurueck()
END SUB

SUB aufVor(knopf AS INTEGER, daten AS INTEGER)
    verlaufVor()
END SUB

' --- Datei
FUNCTION dateiWahl(sichern AS BOOLEAN) AS STRING
    DIM titel AS STRING : titel = "Oeffnen"
    DIM aktion AS INTEGER : aktion = GTK_DATEI_OEFFNEN
    DIM knopf AS STRING : knopf = "Oeffnen"
    IF sichern THEN titel = "Speichern" : aktion = GTK_DATEI_SICHERN : knopf = "Speichern"
    DIM d AS INTEGER : d = gtk_file_chooser_dialog_new(titel, gFenster, aktion, "Abbrechen", GTK_ANTWORT_ABBRECHEN, knopf, GTK_ANTWORT_ANNEHMEN, NIL)
    DIM filter AS INTEGER : filter = gtk_file_filter_new()
    gtk_file_filter_set_name(filter, "Funkenflug (*.fkn)")
    gtk_file_filter_add_pattern(filter, "*.fkn")
    gtk_file_chooser_add_filter(d, filter)
    IF sichern THEN
        gtk_file_chooser_set_do_overwrite_confirmation(d, TRUE)
        gtk_file_chooser_set_current_name(d, "schaltplan.fkn")
    END IF
    DIM pfad AS STRING : pfad = ""
    IF gtk_dialog_run(d) = GTK_ANTWORT_ANNEHMEN THEN
        DIM z AS INTEGER : z = gtk_file_chooser_get_filename(d)
        IF z <> 0 THEN
            pfad = TEXT_AUS_ZEIGER$(z)
            g_free(z)
        END IF
    END IF
    gtk_widget_destroy(d)
    RETURN pfad
END FUNCTION

SUB dateiSpeichern()
    DIM pfad AS STRING : pfad = dateiWahl(TRUE)
    IF pfad = "" THEN RETURN
    IF LOWER$(RIGHT$(pfad, 4)) <> ".fkn" THEN pfad = pfad + ".fkn"
    IF kern.dokumentSpeichern(gDok, pfad) THEN
        gPfad = pfad
        gGeaendert = FALSE
        titelNachziehen()
    ELSE
        meldung("Speichern nach " + pfad + " ist fehlgeschlagen.")
    END IF
END SUB

SUB dateiOeffnen()
    DIM pfad AS STRING : pfad = dateiWahl(FALSE)
    IF pfad = "" THEN RETURN
    DIM d AS kern.Dokument
    TRY
        d = kern.dokumentLaden(pfad)
    CATCH e
        meldung("Die Datei " + basisName$(pfad) + " liess sich nicht lesen.")
        RETURN
    END TRY
    gPfad = pfad
    gGeaendert = FALSE
    leinwandDokument(d)
    symbolListeAktualisieren(FALSE)
    verlaufRuecksetzen()
    titelNachziehen()
    statusAktualisieren()
END SUB

SUB aufSpeichern(knopf AS INTEGER, daten AS INTEGER)
    dateiSpeichern()
END SUB

SUB aufOeffnen(knopf AS INTEGER, daten AS INTEGER)
    dateiOeffnen()
END SUB

SUB fensterZu(objekt AS INTEGER, daten AS INTEGER)
    gtk_main_quit()
END SUB

' --- Demo-Schaltung: VCC -> R -> LED -> GND
FUNCTION demoDokument() AS kern.Dokument
    DIM d AS kern.Dokument : d = NEW kern.Dokument()
    DIM bl AS kern.Blatt : bl = d.blaetter[0]
    DIM vcc AS kern.Bauteil : vcc = kern.neuesBauteil("VCC", kern.neueLage(2000, 1200))
    ARRAY_PUSH(bl.bauteile, vcc)
    DIM r AS kern.Bauteil : r = kern.neuesBauteil("R", kern.neueLage(2000, 2000))
    r.lage.drehung = 90 : r.referenz = "R1" : r.wert = "330"
    ARRAY_PUSH(bl.bauteile, r)
    DIM led AS kern.Bauteil : led = kern.neuesBauteil("LED", kern.neueLage(2000, 3000))
    led.lage.drehung = 90 : led.referenz = "D1"
    ARRAY_PUSH(bl.bauteile, led)
    DIM gnd AS kern.Bauteil : gnd = kern.neuesBauteil("GND", kern.neueLage(2000, 3600))
    ARRAY_PUSH(bl.bauteile, gnd)
    draht2(bl, 2000, 1200, 2000, 1800)       ' VCC -> R oben
    draht2(bl, 2000, 2200, 2000, 2800)       ' R unten -> LED oben
    draht2(bl, 2000, 3200, 2000, 3600)       ' LED unten -> GND
    kern.autoKnoten(bl)
    RETURN d
END FUNCTION

SUB draht2(bl AS kern.Blatt, x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    DIM w AS kern.Draht : w = NEW kern.Draht()
    ARRAY_PUSH(w.punkte, NEW kern.Punkt(x1, y1))
    ARRAY_PUSH(w.punkte, NEW kern.Punkt(x2, y2))
    ARRAY_PUSH(bl.draehte, w)
END SUB

' --- Selbsttest (--foto): spielt die Werkzeuge durch, auch die Dialoge, und
' prueft Undo/Redo. Gibt Pruefzeilen aus, sichert ein Bild und endet.
DIM probeSchritt AS INTEGER
DIM probeText1 AS STRING
DIM probeText2 AS STRING
DIM probeFehler AS INTEGER

SUB pruefe(was AS STRING, ist AS STRING, soll AS STRING)
    IF ist = soll THEN
        PRINT "ok    "; was; " = "; ist
    ELSE
        PRINT "FEHLER "; was; " = "; ist; " (erwartet "; soll; ")"
        probeFehler = probeFehler + 1
    END IF
END SUB

FUNCTION ptListe$(w AS kern.Draht) AS STRING
    DIM t AS STRING : t = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(w.punkte) - 1
        IF i > 0 THEN t = t + " "
        t = t + STR$(w.punkte[i].x) + "," + STR$(w.punkte[i].y)
    NEXT
    RETURN t
END FUNCTION

' Fuellt den Symbol-Editor aus (laeuft in dessen Schleife). Schritt 1: eine
' Pinliste mit doppelter Nummer -- der Dialog muss offen bleiben. Schritt 2:
' eine gute. Schritt 11: beim Bearbeiten einen Pin anhaengen.
DIM seProbeSchritt AS INTEGER
FUNCTION seProbe(daten AS INTEGER) AS BOOLEAN
    IF seDlg = 0 THEN RETURN TRUE
    DIM lf AS STRING : lf = CHR$(10)
    seProbeSchritt = seProbeSchritt + 1
    SELECT CASE seProbeSchritt
        CASE 1
            gtk_entry_set_text(seName, "LM358H")
            gtk_entry_set_text(seWert, "LM358")
            seTextSetzen("1 OUTA rechts aus" + lf + "2 INA- links ein" + lf + "2 INA+ links ein")
            gtk_toggle_button_set_active(seHaken, TRUE)
            gtk_dialog_response(seDlg, GTK_ANTWORT_OK)
            RETURN TRUE
        CASE 2
            pruefe("Editor zeigt den Fehler", STR$(CONTAINS(gtk_label_get_text(seMeldung), "gibt es schon")), STR$(TRUE))
            seTextSetzen("1 OUTA rechts aus" + lf + "2 INA- links ein" + lf + "3 INA+ links ein" + lf + "4 GND unten vin" + lf + "8 VCC oben vin")
            gtk_dialog_response(seDlg, GTK_ANTWORT_OK)
        CASE 11
            seTextSetzen(seTextLesen$() + lf + "5 INB+ links ein")
            gtk_dialog_response(seDlg, GTK_ANTWORT_OK)
    END SELECT
    RETURN FALSE
END FUNCTION

' Fuellt den offenen Dialog aus und bestaetigt ihn (laeuft in dessen Schleife).
FUNCTION dialogBestaetigen(daten AS INTEGER) AS BOOLEAN
    IF gDlg = 0 THEN RETURN TRUE                 ' noch nicht offen: nochmal
    IF gDlgFeld1 <> 0 THEN gtk_entry_set_text(gDlgFeld1, probeText1)
    IF gDlgFeld2 <> 0 THEN gtk_entry_set_text(gDlgFeld2, probeText2)
    gtk_dialog_response(gDlg, GTK_ANTWORT_OK)
    RETURN FALSE
END FUNCTION

FUNCTION probe(daten AS INTEGER) AS BOOLEAN
    probeSchritt = probeSchritt + 1
    SELECT CASE probeSchritt
        CASE 1
            ' die echten Knoepfe und die Bauteilliste (wie ein Mausklick)
            gtk_button_clicked(gKnopfDraht)
            pruefe("Knopf Draht", STR$(gWerkzeug) + " " + STR$(gtk_toggle_button_get_active(gKnopfAuswahl)) + "/" + STR$(gtk_toggle_button_get_active(gKnopfDraht)), STR$(WZ_DRAHT) + " " + STR$(FALSE) + "/" + STR$(TRUE))
            gtk_button_clicked(gKnopfLabel)
            pruefe("Knopf Label", STR$(gWerkzeug) + " " + STR$(gtk_toggle_button_get_active(gKnopfDraht)) + "/" + STR$(gtk_toggle_button_get_active(gKnopfLabel)), STR$(WZ_LABEL) + " " + STR$(FALSE) + "/" + STR$(TRUE))
            gtk_combo_box_set_active(gSymbolWahl, 1)
            pruefe("Bauteilliste waehlt Platzieren", STR$(gWerkzeug) + " " + gSymbolRef + " " + STR$(gtk_toggle_button_get_active(gKnopfLabel)), STR$(WZ_BAUTEIL) + " C " + STR$(FALSE))
            gtk_button_clicked(gKnopfAuswahl)
            pruefe("Knopf Auswahl", STR$(gWerkzeug) + " " + STR$(gtk_toggle_button_get_active(gKnopfAuswahl)), STR$(WZ_AUSWAHL) + " " + STR$(TRUE))
            gtk_button_clicked(gKnopfAuswahl)
            pruefe("Auswahl nochmal: bleibt an", STR$(gWerkzeug) + " " + STR$(gtk_toggle_button_get_active(gKnopfAuswahl)), STR$(WZ_AUSWAHL) + " " + STR$(TRUE))
            ' ein Bauteil per Werkzeug setzen
            werkzeugWaehlen(WZ_BAUTEIL, "C")
            gMausWX = 3000 : gMausWY = 2000 : gMausDrin = TRUE
            bauteilPlatzieren()
            pruefe("C platziert, Referenz", gBlatt.bauteile[4].referenz, "C1")
            ' zweites C: fortlaufende Referenz, dann wieder loeschen
            gMausWX = 3000 : gMausWY = 4400
            bauteilPlatzieren()
            pruefe("zweites C, Referenz", gBlatt.bauteile[5].referenz, "C2")
            auswahlLoeschen(FALSE)
            pruefe("C2 geloescht, Bauteile", STR$(LEN(gBlatt.bauteile)), "5")
        CASE 2
            ' Draht mit doppeltem Endpunkt (wie beim Doppelklick)
            werkzeugWaehlen(WZ_DRAHT, "")
            gDrahtAktiv = TRUE
            gDrahtPunkte = []
            ARRAY_PUSH(gDrahtPunkte, NEW kern.Punkt(3200, 2000))
            ARRAY_PUSH(gDrahtPunkte, NEW kern.Punkt(3600, 2000))
            ARRAY_PUSH(gDrahtPunkte, NEW kern.Punkt(3600, 2600))
            ARRAY_PUSH(gDrahtPunkte, NEW kern.Punkt(3600, 2600))
            drahtEndePunkt()
            pruefe("Drahtecken ohne Doppelpunkt", STR$(LEN(gBlatt.draehte[3].punkte)), "3")
        CASE 3
            ' Label per Dialog auf den VCC-Draht setzen
            werkzeugWaehlen(WZ_LABEL, "")
            gMausWX = 2000 : gMausWY = 1500
            probeText1 = "VCC5"
            g_timeout_add(150, dialogBestaetigen, 0)
            labelSetzen()
            pruefe("Labels", STR$(LEN(gBlatt.labels)), "1")
            pruefe("Labeltext", gBlatt.labels[0].text, "VCC5")
            ' zweites gleichnamiges Label am offenen Draht des C -> selbes Netz
            gMausWX = 3600 : gMausWY = 2600
            g_timeout_add(150, dialogBestaetigen, 0)
            labelSetzen()
            pruefe("Label 1 am Klickpunkt", STR$(gBlatt.labels[0].anker.x) + "," + STR$(gBlatt.labels[0].anker.y), "2000,1500")
            pruefe("Label 2 am Klickpunkt", STR$(gBlatt.labels[1].anker.x) + "," + STR$(gBlatt.labels[1].anker.y), "3600,2600")
            DIM n AS kern.Netze : n = kern.netzeBerechnen(gBlatt)
            pruefe("Label verbindet VCC-Pin mit C-Draht", STR$(n.gleich(2000, 1200, 3200, 2000)), STR$(TRUE))
        CASE 4
            ' Eigenschaften per Dialog
            werkzeugWaehlen(WZ_AUSWAHL, "")
            probeText1 = "R7"
            probeText2 = "4k7"
            g_timeout_add(150, dialogBestaetigen, 0)
            eigenschaftenDialog(gBlatt.bauteile[1])
            pruefe("Referenz nach Dialog", gBlatt.bauteile[1].referenz, "R7")
            pruefe("Wert nach Dialog", gBlatt.bauteile[1].wert, "4k7")
            ' doppelte Referenz wird abgelehnt (die Warnung bestaetigt der Timer)
            probeText1 = "D1"
            probeText2 = "4k7"
            g_timeout_add(150, dialogBestaetigen, 0)
            g_timeout_add(400, dialogBestaetigen, 0)
            eigenschaftenDialog(gBlatt.bauteile[1])
            pruefe("Doppelte Referenz abgelehnt", gBlatt.bauteile[1].referenz, "R7")
        CASE 5
            ' Undo / Redo
            verlaufZurueck()
            pruefe("Undo: Referenz zurueck", gBlatt.bauteile[1].referenz, "R1")
            pruefe("Undo: Wert zurueck", gBlatt.bauteile[1].wert, "330")
            verlaufZurueck()
            pruefe("Undo: zweites Label weg", STR$(LEN(gBlatt.labels)), "1")
            verlaufVor()
            verlaufVor()
            pruefe("Redo: Referenz wieder", gBlatt.bauteile[1].referenz, "R7")
            pruefe("Redo: Labels wieder", STR$(LEN(gBlatt.labels)), "2")
            ' Verschieben = EIN Undo-Schritt, auch ueber viele Bewegungen
            DIM vorher AS INTEGER : vorher = LEN(gUndo)
            waehleB(gBlatt.bauteile[4])
            gMausWX = 3000 : gMausWY = 2000
            gruppenZugBeginn()
            gruppenZiehenUm(0, 0)                  ' keine Bewegung: kein Schritt
            gruppenZiehenUm(100, 0)
            gruppenZiehenUm(200, 100)
            gruppenZugEnde()
            pruefe("Ziehen = ein Undo-Schritt", STR$(LEN(gUndo) - vorher), "1")
            verlaufZurueck()
            pruefe("Undo Ziehen: x zurueck", STR$(gBlatt.bauteile[4].lage.pos.x), "3000")
            ' fuers Bild: R7 gewaehlt
            waehleB(gBlatt.bauteile[1])
            statusAktualisieren()
        CASE 6
            ' Draehte: treffen, Segment ziehen (Verbindung bleibt), Segment und
            ' ganzen Draht loeschen -- jeweils per Undo zurueck
            werkzeugWaehlen(WZ_AUSWAHL, "")
            DIM wi AS INTEGER, si AS INTEGER
            DIM getroffen AS BOOLEAN : getroffen = drahtUnter(sx(3600), sy(2300), wi, si)
            pruefe("Draht getroffen (Draht/Segment)", STR$(wi) + "/" + STR$(si), "3/1")
            gMausRX = 3600 : gMausRY = 2300 : gMausWX = 3600 : gMausWY = 2300
            drahtWaehlen(wi, si)
            drahtZiehBeginn()
            drahtZiehenUm(400, 300)                ' senkrechtes Segment: nur waagrecht
            drahtZiehEnde()
            pruefe("Segment gezogen, Ende bleibt am Label", ptListe$(gBlatt.draehte[3]), "3200,2000 4000,2000 4000,2600 3600,2600")
            pruefe("Verbindung C1 ~ Label bleibt", STR$(aktuelleNetze().gleich(3200, 2000, 3600, 2600)), STR$(TRUE))
            verlaufZurueck()
            pruefe("Undo Ziehen", ptListe$(gBlatt.draehte[3]), "3200,2000 3600,2000 3600,2600")
            getroffen = drahtUnter(sx(3400), sy(2000), wi, si)
            gMausRX = 3400 : gMausRY = 2000
            drahtWaehlen(wi, si)
            auswahlLoeschen(FALSE)
            pruefe("Segment geloescht, Draehte", STR$(LEN(gBlatt.draehte)), "4")
            pruefe("C1 vom Label getrennt", STR$(aktuelleNetze().gleich(3200, 2000, 3600, 2600)), STR$(FALSE))
            verlaufZurueck()
            drahtWaehlen(3, 0)
            auswahlLoeschen(TRUE)
            pruefe("ganzer Draht geloescht, Draehte", STR$(LEN(gBlatt.draehte)), "3")
            verlaufZurueck()
            pruefe("Undo: Draehte wieder", STR$(LEN(gBlatt.draehte)), "4")
        CASE 7
            ' Umbenennen: Label an allen Stellen, Versorgung ueber den Draht,
            ' automatisches Netz bekommt ein Label, Zusammenfuehren fragt nach
            DIM fragenVorher AS INTEGER : fragenVorher = gFragen
            auswahlAufheben()
            waehleL(gBlatt.labels[0])
            probeText1 = "SIG"
            g_timeout_add(150, dialogBestaetigen, 0)
            umbenennenAuswahl()
            pruefe("Label an allen Stellen", gBlatt.labels[0].text + "/" + gBlatt.labels[1].text, "SIG/SIG")
            ' GND ueber seinen Draht umbenennen
            gMausRX = 2000 : gMausRY = 3400
            drahtWaehlen(2, 0)
            probeText1 = "AGND"
            g_timeout_add(150, dialogBestaetigen, 0)
            umbenennenAuswahl()
            pruefe("Versorgung umbenannt", gBlatt.bauteile[3].wert, "AGND")
            pruefe("Netzname am Draht", aktuelleNetze().liste[aktuelleNetze().netzAn(2000, 3200)].name, "AGND")
            pruefe("AGND bleibt SPICE-Masse", STR$(CONTAINS(kern.netzlisteSpice$(gBlatt, "P"), " 0 D_LED")), STR$(TRUE))
            ' automatisches Netz R7-D1: ein Label entsteht am Klickpunkt
            gMausRX = 2000 : gMausRY = 2500
            drahtWaehlen(1, 0)
            probeText1 = "LED_A"
            g_timeout_add(150, dialogBestaetigen, 0)
            umbenennenAuswahl()
            pruefe("neues Label", STR$(LEN(gBlatt.labels)) + " " + gBlatt.labels[2].text + " @" + STR$(gBlatt.labels[2].anker.x) + "," + STR$(gBlatt.labels[2].anker.y), "3 LED_A @2000,2500")
            pruefe("ohne Rueckfrage bisher", STR$(gFragen - fragenVorher), "0")
            ' LED_A -> SIG: SIG liegt auf dem VCC-Netz -> Rueckfrage, dann verbunden
            auswahlAufheben()
            waehleL(gBlatt.labels[2])
            probeText1 = "SIG"
            g_timeout_add(150, dialogBestaetigen, 0)
            g_timeout_add(400, dialogBestaetigen, 0)
            umbenennenAuswahl()
            pruefe("Zusammenfuehren fragt nach", STR$(gFragen - fragenVorher), "1")
            pruefe("Netze verbunden", STR$(aktuelleNetze().gleich(2000, 2200, 2000, 1200)), STR$(TRUE))
            ' alles zurueck
            verlaufZurueck()
            verlaufZurueck()
            verlaufZurueck()
            verlaufZurueck()
            pruefe("Undo: Namen zurueck", gBlatt.labels[0].text + " " + gBlatt.bauteile[3].wert + "|" + STR$(LEN(gBlatt.labels)), "VCC5 |2")
        CASE 8
            ' Gummiband: R7 nach rechts ziehen, beide Draehte folgen mit Knick
            waehleB(gBlatt.bauteile[1])
            gMausWX = 2000 : gMausWY = 2000
            gruppenZugBeginn()
            gruppenZiehenUm(300, 0)
            gruppenZiehenUm(500, 0)
            gruppenZugEnde()
            pruefe("R7 verschoben", STR$(gBlatt.bauteile[1].lage.pos.x) + "," + STR$(gBlatt.bauteile[1].lage.pos.y), "2500,2000")
            pruefe("Draht oben folgt", ptListe$(gBlatt.draehte[0]), "2000,1200 2000,1800 2500,1800")
            pruefe("Draht unten folgt", ptListe$(gBlatt.draehte[1]), "2500,2200 2000,2200 2000,2800")
            pruefe("R7 bleibt an VCC", STR$(aktuelleNetze().gleich(2500, 1800, 2000, 1200)), STR$(TRUE))
            pruefe("R7 bleibt an D1", STR$(aktuelleNetze().gleich(2500, 2200, 2000, 2800)), STR$(TRUE))
            verlaufZurueck()
            pruefe("Undo Gummiband", ptListe$(gBlatt.draehte[0]) + " | " + STR$(gBlatt.bauteile[1].lage.pos.x), "2000,1200 2000,1800 | 2000")
        CASE 9
            ' Rahmen waehlt alles ganz Umschlossene
            auswahlAufheben()
            rahmenAnwendenWelt(1500, 1000, 2600, 3000)
            pruefe("Rahmen", STR$(LEN(gSelB)) + " Bauteile, " + STR$(LEN(gSelD)) + " Draehte, " + STR$(LEN(gSelL)) + " Labels", "2 Bauteile, 2 Draehte, 1 Labels")
            umschaltenB(gBlatt.bauteile[2])
            pruefe("Umschalten dazu", STR$(LEN(gSelB)), "3")
            umschaltenB(gBlatt.bauteile[2])
            pruefe("Umschalten weg", STR$(LEN(gSelB)), "2")
            ' kopieren und an der Maus einfuegen
            ablageKopieren()
            gMausDrin = TRUE : gMausWX = 5000 : gMausWY = 1000
            ablageEinfuegen()
            pruefe("eingefuegt (Bauteile/Draehte/Labels)", STR$(LEN(gBlatt.bauteile)) + "/" + STR$(LEN(gBlatt.draehte)) + "/" + STR$(LEN(gBlatt.labels)), "7/6/3")
            pruefe("neue Referenz", gBlatt.bauteile[6].referenz, "R8")
            pruefe("Kopie an der Maus", STR$(gBlatt.bauteile[5].lage.pos.x) + "," + STR$(gBlatt.bauteile[5].lage.pos.y), "5000,1000")
            pruefe("Kopie haengt am VCC-Netz", STR$(aktuelleNetze().gleich(5000, 1600, 2000, 1200)), STR$(TRUE))
            pruefe("Eingefuegtes ist gewaehlt", STR$(auswahlAnzahl()), "5")
            ' die Kopie als Gruppe ziehen, dann loeschen
            gMausWX = 5000 : gMausWY = 1800
            gruppenZugBeginn()
            gruppenZiehenUm(0, 200)
            gruppenZugEnde()
            pruefe("Gruppe gezogen", STR$(gBlatt.bauteile[6].lage.pos.y) + " " + ptListe$(gBlatt.draehte[4]), "2000 5000,1200 5000,1800")
            auswahlLoeschen(FALSE)
            pruefe("Gruppe geloescht", STR$(LEN(gBlatt.bauteile)) + "/" + STR$(LEN(gBlatt.draehte)) + "/" + STR$(LEN(gBlatt.labels)), "5/4/2")
            verlaufZurueck()
            verlaufZurueck()
            verlaufZurueck()
            pruefe("Undo bis vor das Einfuegen", STR$(LEN(gBlatt.bauteile)) + "/" + STR$(LEN(gBlatt.draehte)), "5/4")
            ' ausschneiden und wieder einfuegen: R7 behaelt seine Referenz
            waehleB(gBlatt.bauteile[1])
            ablageAusschneiden()
            pruefe("ausgeschnitten", STR$(LEN(gBlatt.bauteile)), "4")
            gMausWX = 2000 : gMausWY = 2000
            ablageEinfuegen()
            pruefe("wieder eingefuegt, Referenz", gBlatt.bauteile[4].referenz, "R7")
            verlaufZurueck()
            verlaufZurueck()
            pruefe("Undo Ausschneiden", gBlatt.bauteile[1].referenz + "/" + STR$(LEN(gBlatt.bauteile)), "R7/5")
            ' der Weg ueber den Klick-Handler: Klick ins Leere zieht einen
            ' Rahmen, Loslassen waehlt; Umschalt-Klick nimmt D1 dazu; Klick auf
            ' ein gewaehltes Element zieht die ganze Gruppe
            gMausRX = 1500 : gMausRY = 1000
            klickAuswahl(sx(1500), sy(1000), FALSE)
            pruefe("Klick ins Leere startet Rahmen", STR$(gRahmen), STR$(TRUE))
            gRahmenEX = sx(2600) : gRahmenEY = sy(3000)
            DIM los AS BOOLEAN : los = lwLos(0, 0, 0)
            pruefe("Rahmen per Maus", STR$(auswahlAnzahl()), "5")
            gMausRX = 2000 : gMausRY = 3000
            klickAuswahl(sx(2000), sy(3000), TRUE)
            pruefe("Umschalt-Klick nimmt D1 dazu", STR$(LEN(gSelB)), "3")
            gMausWX = 2000 : gMausWY = 3000
            klickAuswahl(sx(2000), sy(3000), FALSE)
            gruppenZiehenUm(1000, 0)
            los = lwLos(0, 0, 0)
            pruefe("Gruppe per Klick gezogen", STR$(gBlatt.bauteile[1].lage.pos.x) + "/" + STR$(gBlatt.bauteile[2].lage.pos.x) + "/" + STR$(gBlatt.bauteile[3].lage.pos.x), "3000/3000/2000")
            pruefe("GND bleibt per Gummiband dran", STR$(aktuelleNetze().gleich(3000, 3200, 2000, 3600)), STR$(TRUE))
            verlaufZurueck()
            alleWaehlen()
            pruefe("Strg+A", STR$(auswahlAnzahl()), "11")
            auswahlAufheben()
        CASE 10
            ' Symbol-Editor: erst eine fehlerhafte Pinliste (Dialog bleibt
            ' offen, Fehler steht da), dann eine gute
            seProbeSchritt = 0
            g_timeout_add(200, seProbe, 0)
            DIM neueId AS STRING : neueId = neuesSymbolUI()
            pruefe("Editor: Fehler hielt den Dialog offen", STR$(seProbeSchritt), "2")
            pruefe("Editor: neue Id", LEFT$(neueId, 2), "E_")
            DIM es AS kern.Symbol : es = kern.bibliothekSymbol(neueId)
            pruefe("Symbol: Name/Pins", es.name + "/" + STR$(LEN(es.pins)), "LM358H/5")
            pruefe("in der Bauteilliste", STR$(listeHat(neueId)), STR$(TRUE))
            pruefe("in der Bibliothek gesichert", STR$(FILEEXISTS(gBibPfad) AND kern.inBibliothek(neueId)), STR$(TRUE))
            pruefe("Werkzeug steht aufs Platzieren", STR$(gWerkzeug = WZ_BAUTEIL AND gSymbolRef = neueId), STR$(TRUE))
            gMausWX = 5000 : gMausWY = 2000 : gMausDrin = TRUE
            bauteilPlatzieren()
            pruefe("Referenz", gBlatt.bauteile[5].referenz, "U1")
            ' die Pin-Typen kommen beim ERC an
            DIM ercU AS ARRAY OF kern.Verstoss : ercU = kern.ercPruefen(gBlatt)
            DIM ercT AS STRING : ercT = ""
            DIM eu AS INTEGER
            FOR eu = 0 TO LEN(ercU) - 1
                ercT = ercT + ercU[eu].text + "|"
            NEXT
            pruefe("ERC kennt den Eingang", STR$(CONTAINS(ercT, "Eingang ohne Treiber")), STR$(TRUE))
            pruefe("ERC nennt den Pin", STR$(CONTAINS(ercT, "Pin U1.1 (OUTA) ist nicht verbunden")), STR$(TRUE))
            pruefe("Symbol reist in der Datei mit", STR$(CONTAINS(JSON_STRINGIFY(kern.dokumentNachJson(gDok)), neueId)), STR$(TRUE))
            ' bearbeiten: ein Pin mehr -> das Bauteil aendert sich mit, ein Undo-Schritt
            waehleB(gBlatt.bauteile[5])
            seProbeSchritt = 10
            g_timeout_add(200, seProbe, 0)
            DIM eid AS STRING : eid = symbolBearbeitenUI(gGewaehlt.sym)
            pruefe("Bearbeiten: gleiche Id", STR$(eid = neueId), STR$(TRUE))
            pruefe("Bearbeiten: Bauteil hat jetzt 6 Pins", STR$(LEN(gBlatt.bauteile[5].sym.pins)), "6")
            verlaufZurueck()
            pruefe("Undo Bearbeiten: wieder 5 Pins", STR$(LEN(gBlatt.bauteile[5].sym.pins)), "5")
            verlaufZurueck()
            pruefe("Undo Platzieren", STR$(LEN(gBlatt.bauteile)), "5")
            werkzeugWaehlen(WZ_AUSWAHL, "")
        CASE 11
            ' Stueckliste: Dialog oeffnen und schliessen, Inhalt, Export
            g_timeout_add(200, dialogBestaetigen, 0)
            stuecklisteZeigen()
            pruefe("Stueckliste-Dialog wieder zu", STR$(gDlg), "0")
            DIM bz AS ARRAY OF kern.BomZeile : bz = kern.stueckliste(gBlatt)
            pruefe("Stueckliste: Positionen", STR$(LEN(bz)), "3")
            pruefe("Stueckliste: Reihenfolge", bz[0].referenzen[0] + " " + bz[1].referenzen[0] + " " + bz[2].referenzen[0], "C1 D1 R7")
            IF fotoZiel <> "" THEN pruefe("Stueckliste als Markdown", STR$(stuecklisteNach(fotoZiel + ".md")), STR$(TRUE))
            pruefe("Markdown-Tabelle", STR$(CONTAINS(kern.stuecklisteMarkdown$(gBlatt, "P"), "| 1 | R7 | 4k7 | Widerstand |")), STR$(TRUE))
        CASE 12
            ' Drehen: R7 einzeln um 90 Grad -- beide Draehte folgen, ohne Kurzschluss
            werkzeugWaehlen(WZ_AUSWAHL, "")
            waehleB(gBlatt.bauteile[1])
            DIM vorD AS INTEGER : vorD = LEN(gUndo)
            auswahlDrehen()
            DIM nd AS kern.Netze : nd = aktuelleNetze()
            pruefe("R7 gedreht", STR$(gBlatt.bauteile[1].lage.drehung), "180")
            pruefe("Drehen = ein Undo-Schritt", STR$(LEN(gUndo) - vorD), "1")
            DIM p0 AS kern.Punkt : p0 = gBlatt.bauteile[1].pinPunkt(0)
            DIM p1 AS kern.Punkt : p1 = gBlatt.bauteile[1].pinPunkt(1)
            pruefe("R7 Pin 1 bleibt an VCC", STR$(nd.gleich(p0.x, p0.y, 2000, 1200)), STR$(TRUE))
            pruefe("R7 Pin 2 bleibt an D1", STR$(nd.gleich(p1.x, p1.y, 2000, 2800)), STR$(TRUE))
            pruefe("kein Kurzschluss VCC-D1", STR$(nd.gleich(2000, 1200, 2000, 2800)), STR$(FALSE))
            verlaufZurueck()
            ' Spiegeln: C1 oben/unten -- Lage und Anschluss stimmen
            waehleB(gBlatt.bauteile[4])
            auswahlSpiegeln(kern.GR_SPIEGELN_Y)
            pruefe("C1 gespiegelt (Y)", STR$(gBlatt.bauteile[4].lage.gespiegelt) + " " + STR$(gBlatt.bauteile[4].lage.drehung), STR$(TRUE) + " 180")
            pruefe("C1 Pin 2 noch am Draht", STR$(aktuelleNetze().gleich(3200, 2000, 3600, 2600)), STR$(TRUE))
            verlaufZurueck()
            ' Gruppe: R7, D1 und der Draht dazwischen um ihre Mitte drehen
            auswahlAufheben()
            rahmenAnwendenWelt(1500, 1700, 2600, 3300)
            pruefe("Gruppe gewaehlt", STR$(LEN(gSelB)) + "/" + STR$(LEN(gSelD)), "2/1")
            gruppeTransformieren(kern.GR_DREHEN)
            DIM ng AS kern.Netze : ng = aktuelleNetze()
            DIM r0 AS kern.Punkt : r0 = gBlatt.bauteile[1].pinPunkt(0)
            DIM d1 AS kern.Punkt : d1 = gBlatt.bauteile[2].pinPunkt(1)
            pruefe("Gruppe: R7 haengt an VCC", STR$(ng.gleich(r0.x, r0.y, 2000, 1200)), STR$(TRUE))
            pruefe("Gruppe: D1 haengt an GND", STR$(ng.gleich(d1.x, d1.y, 2000, 3600)), STR$(TRUE))
            pruefe("Gruppe: R7-D1 verbunden", STR$(ng.gleich(gBlatt.bauteile[1].pinPunkt(1).x, gBlatt.bauteile[1].pinPunkt(1).y, gBlatt.bauteile[2].pinPunkt(0).x, gBlatt.bauteile[2].pinPunkt(0).y)), STR$(TRUE))
            pruefe("Gruppe: kein Kurzschluss VCC-GND", STR$(ng.gleich(2000, 1200, 2000, 3600)), STR$(FALSE))
            verlaufZurueck()
            ' Beim Platzieren drehen R und X die Vorschau, nicht das eben Gesetzte
            werkzeugWaehlen(WZ_BAUTEIL, "R")
            waehleB(gBlatt.bauteile[1])
            auswahlDrehen()
            auswahlSpiegeln(kern.GR_SPIEGELN_X)
            pruefe("Vorschau statt Auswahl", STR$(gBlatt.bauteile[1].lage.drehung) + " " + STR$(gPlatzDreh) + " " + STR$(gPlatzSpiegel), "90 90 " + STR$(TRUE))
            gPlatzDreh = 0
            gPlatzSpiegel = FALSE
            werkzeugWaehlen(WZ_AUSWAHL, "")
            auswahlAufheben()
        CASE 13
            ' Ausgabe: PDF, SVG, PNG und Drucken (ueber GTKs Export, ohne Drucker)
            DIM zoomVor AS FLOAT : zoomVor = vZoom
            IF fotoZiel <> "" THEN
                pruefe("PDF geschrieben", STR$(ausgabeNach(fotoZiel + ".pdf")), STR$(TRUE))
                pruefe("SVG geschrieben", STR$(ausgabeNach(fotoZiel + ".svg")), STR$(TRUE))
                pruefe("PNG geschrieben", STR$(ausgabeNach(fotoZiel + ".ausgabe.png")), STR$(TRUE))
                pruefe("Drucken (Export-Weg)", drucken$(fotoZiel + ".druck.pdf"), "")
                pruefe("Druck-PDF da", STR$(FILEEXISTS(fotoZiel + ".druck.pdf")), STR$(TRUE))
            END IF
            pruefe("Bildschirm danach unveraendert", STR$(vZoom = zoomVor AND NOT gDruck), STR$(TRUE))
            pruefe("Menue Ausgabe gebaut", STR$(gAusgabeMenue <> 0), STR$(TRUE))
        CASE 14
            ' Netz unter der Maus: VCC-Draht, GND-Draht, Statuszeile
            gMausDrin = TRUE
            hoverBestimmen(sx(2000), sy(1650))
            pruefe("Netz unter der Maus (VCC-Draht)", hoverText$(), "Netz: VCC (2 Pins)")
            hoverBestimmen(sx(2000), sy(3400))
            pruefe("Netz unter der Maus (GND-Draht)", hoverText$(), "Netz: GND (1 Pin)")
            hoverBestimmen(sx(2000), sy(1650))
            statusAktualisieren()
            pruefe("Statuszeile nennt das Netz", STR$(CONTAINS(gtk_label_get_text(gStatus), "Netz: VCC")), STR$(TRUE))
        CASE 15
            ' ERC: genau zwei Warnungen; Zeile 2 anklicken springt zu C1.1
            ercAusfuehren()
            pruefe("ERC-Verstoesse", STR$(LEN(gErc)), "2")
            DIM texte AS STRING : texte = ""
            DIM ei AS INTEGER
            FOR ei = 0 TO LEN(gErc) - 1
                texte = texte + gErc[ei].text + "|"
            NEXT
            pruefe("ERC: Label auf Versorgung", STR$(CONTAINS(texte, "Label VCC5 liegt auf der Versorgung VCC")), STR$(TRUE))
            pruefe("ERC: offener Pin", STR$(CONTAINS(texte, "Pin C1.1 ist nicht verbunden")), STR$(TRUE))
            DIM zielZeile AS INTEGER : zielZeile = -1
            FOR ei = 0 TO LEN(gErc) - 1
                IF CONTAINS(gErc[ei].text, "C1.1") THEN zielZeile = ei
            NEXT
            gtk_list_box_select_row(gErcListe, gtk_list_box_get_row_at_index(gErcListe, zielZeile))
            pruefe("Zeilenklick waehlt Verstoss", STR$(gErcGewaehlt), STR$(zielZeile))
            pruefe("Zeilenklick zentriert", STR$(ROUND(weltX(gtk_widget_get_allocated_width(gFlaeche) / 2.0))), "2800")
            ' Netzliste als SPICE
            IF fotoZiel <> "" THEN
                pruefe("SPICE-Export geschrieben", STR$(exportNach(fotoZiel + ".cir")), STR$(TRUE))
            END IF
            DIM sp AS STRING : sp = kern.netzlisteSpice$(gBlatt, "Probe")
            pruefe("SPICE: R7 an VCC", STR$(CONTAINS(sp, "R7 VCC ")), STR$(TRUE))
            pruefe("SPICE: D1 an Masse", STR$(CONTAINS(sp, " 0 D_LED")), STR$(TRUE))
        CASE ELSE
            IF fotoZiel <> "" THEN
                IF gtkFoto(gFlaeche, fotoZiel) THEN
                    PRINT "Foto gesichert: "; fotoZiel
                ELSE
                    PRINT "Foto fehlgeschlagen"
                END IF
            END IF
            ' ERC-Dialog schliessen: Marker verschwinden
            IF gErcDlg <> 0 THEN gtk_dialog_response(gErcDlg, GTK_ANTWORT_OK)
            pruefe("ERC-Dialog zu, Marker weg", STR$(gErcSichtbar), STR$(FALSE))
            PRINT "Pruefungen mit Fehler: "; probeFehler
            gtk_main_quit()
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

FUNCTION leistenKnopf(text AS STRING) AS INTEGER
    RETURN gtk_toggle_button_new_with_label(text)
END FUNCTION

DIM bereit AS BOOLEAN
TRY
    bereit = gtk_init_check(0, 0)
CATCH e
    PRINT "GTK nicht gefunden -- unter Windows GTK aus MSYS2 im PATH oder aus Inkscape."
    END
END TRY
IF NOT bereit THEN
    PRINT "GTK ist da, findet aber keinen Bildschirm."
    END
END IF

kern.bibliothekAufbauen()

DIM i AS INTEGER
DIM startDok AS kern.Dokument
DIM startPfad AS STRING : startPfad = ""
FOR i = 0 TO ARGC() - 1
    IF ARG$(i) = "--nur-foto" THEN probeSchritt = 100      ' nur das Bild, keine Pruefungen
    IF (ARG$(i) = "--foto" OR ARG$(i) = "--nur-foto") AND i + 1 < ARGC() THEN
        fotoZiel = ARG$(i + 1)
    ELSEIF RIGHT$(LOWER$(ARG$(i)), 4) = ".fkn" THEN
        startPfad = ARG$(i)
    END IF
NEXT

' Der Selbsttest laesst die Zwischenablage des Systems in Ruhe und benutzt
' eine eigene Wegwerf-Bibliothek statt der persoenlichen.
gAblageSystem = fotoZiel = ""
IF fotoZiel <> "" THEN
    gBibPfad = fotoZiel + ".fkl"
ELSE
    gBibPfad = bibliotheksPfad$()
END IF
' erst die Bibliothek, dann das Dokument: gleiche Ids -> die Fassung im
' Dokument gilt fuer dieses Dokument
IF kern.bibliothekLaden(gBibPfad) < 0 THEN PRINT "Bibliothek "; gBibPfad; " ist nicht lesbar -- sie bleibt unangetastet."

IF startPfad <> "" THEN
    startDok = kern.dokumentLaden(startPfad)
    gPfad = startPfad
ELSE
    startDok = demoDokument()
END IF

DIM stilFehler AS STRING : stilFehler = gtkStil$(STIL)

gFenster = gtk_window_new(0)
gtk_window_set_default_size(gFenster, 1000, 700)
' Fenster-Symbol (dhrt startet im Ordner des Skripts -- CWD$() ist funkenflug/)
DIM symbolFehler AS INTEGER
IF NOT gtk_window_set_icon_from_file(gFenster, PATHJOIN(CWD$(), LOGO), symbolFehler) THEN PRINT "Fenster-Symbol: "; gtkFehler$(symbolFehler)
gKopf = gtk_header_bar_new()
gtk_header_bar_set_show_close_button(gKopf, TRUE)
gtk_header_bar_set_title(gKopf, "Funkenflug")
gtk_window_set_titlebar(gFenster, gKopf)
DIM knopfOeffnen AS INTEGER : knopfOeffnen = gtk_button_new_with_label("Oeffnen")
DIM knopfSpeichern AS INTEGER : knopfSpeichern = gtk_button_new_with_label("Speichern")
gKnopfZurueck = gtk_button_new_with_label("↶")
gKnopfVor = gtk_button_new_with_label("↷")
gtk_widget_set_tooltip_text(gKnopfZurueck, "Rueckgaengig (Strg+Z)")
gtk_widget_set_tooltip_text(gKnopfVor, "Wiederholen (Strg+Y)")
gtk_header_bar_pack_start(gKopf, knopfOeffnen)
gtk_header_bar_pack_start(gKopf, knopfSpeichern)
gtk_header_bar_pack_start(gKopf, gKnopfZurueck)
gtk_header_bar_pack_start(gKopf, gKnopfVor)
DIM knopfErc AS INTEGER : knopfErc = gtk_button_new_with_label("ERC")
DIM knopfAusgabe AS INTEGER : knopfAusgabe = gtk_button_new_with_label("Ausgabe ▾")
gtk_widget_set_tooltip_text(knopfErc, "Elektrische Regelpruefung")
gtk_widget_set_tooltip_text(knopfAusgabe, "PDF/SVG/PNG, Drucken, Stueckliste, Netzliste")
gtk_header_bar_pack_end(gKopf, knopfErc)
gtk_header_bar_pack_end(gKopf, knopfAusgabe)
ausgabeMenueBauen()

DIM vbox AS INTEGER : vbox = gtk_box_new(GTK_SENKRECHT, 0)
DIM leiste AS INTEGER : leiste = gtk_box_new(GTK_WAAGERECHT, 6)
gtkKlasse(leiste, "leiste")
gKnopfAuswahl = leistenKnopf("Auswahl")
gKnopfDraht = leistenKnopf("Draht")
gKnopfLabel = leistenKnopf("Label")
gtk_widget_set_tooltip_text(gKnopfAuswahl, "Auswaehlen, ziehen; Doppelklick bearbeitet (A)")
gtk_widget_set_tooltip_text(gKnopfDraht, "Draht zeichnen (W)")
gtk_widget_set_tooltip_text(gKnopfLabel, "Netz-Label setzen (L)")
gtk_box_pack_start(leiste, gKnopfAuswahl, FALSE, FALSE, 0)
gtk_box_pack_start(leiste, gKnopfDraht, FALSE, FALSE, 0)
gtk_box_pack_start(leiste, gKnopfLabel, FALSE, FALSE, 0)
DIM etikett AS INTEGER : etikett = gtk_label_new("  Bauteil:")
gtk_box_pack_start(leiste, etikett, FALSE, FALSE, 0)
gSymbolWahl = gtk_combo_box_text_new()
gtk_box_pack_start(leiste, gSymbolWahl, FALSE, FALSE, 0)
DIM knopfSymbol AS INTEGER : knopfSymbol = gtk_button_new_with_label("Symbol ...")
gtk_widget_set_tooltip_text(knopfSymbol, "Eigenes Bauteil/IC anlegen; ist ein eigenes gewaehlt, es bearbeiten")
gtk_box_pack_start(leiste, knopfSymbol, FALSE, FALSE, 0)
gtk_box_pack_start(vbox, leiste, FALSE, FALSE, 0)

DIM flaeche AS INTEGER : flaeche = leinwandNeu()
gtk_box_pack_start(vbox, flaeche, TRUE, TRUE, 0)

gStatus = gtk_label_new("")
gtk_label_set_xalign(gStatus, 0.0)
gtkKlasse(gStatus, "status")
gtk_box_pack_start(vbox, gStatus, FALSE, FALSE, 0)

gtk_container_add(gFenster, vbox)

signal(gKnopfAuswahl, "clicked", aufAuswahl, 0, 0, 0)
signal(gKnopfDraht, "clicked", aufDraht, 0, 0, 0)
signal(gKnopfLabel, "clicked", aufLabel, 0, 0, 0)
signal(gSymbolWahl, "changed", aufSymbol, 0, 0, 0)
signal(knopfOeffnen, "clicked", aufOeffnen, 0, 0, 0)
signal(knopfSpeichern, "clicked", aufSpeichern, 0, 0, 0)
signal(gKnopfZurueck, "clicked", aufZurueck, 0, 0, 0)
signal(gKnopfVor, "clicked", aufVor, 0, 0, 0)
signal(knopfErc, "clicked", aufErc, 0, 0, 0)
signal(knopfAusgabe, "clicked", aufAusgabeKnopf, 0, 0, 0)
signal(knopfSymbol, "clicked", aufSymbolEditor, 0, 0, 0)
signal(gFenster, "destroy", fensterZu, 0, 0, 0)

symbolListeAktualisieren(TRUE)
leinwandDokument(startDok)
verlaufRuecksetzen()
gWerkzeug = WZ_AUSWAHL
werkzeugKnoepfeNachziehen()
titelNachziehen()
statusAktualisieren()

gtk_widget_show_all(gFenster)
IF fotoZiel <> "" THEN g_timeout_add(400, probe, 0)
gtk_main()
