--- einschub nach GUI_WINDOW_CHROME(win, FALSE)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(win, 0, 0, 1, 1)

--- einschub nach FLIP()
prBild = prBild + 1
IF prBild = 2 THEN prMerke("G " + geld$(1999) + "/" + STR$(centVon("19,99")) + "/" + STR$(centVon("1.234,56")) + "/" + STR$(centVon("12.5")) + "/" + STR$(centVon("abc")) + "/" + geld$(123456789) + "/" + geld$(-5))
prSchreib("")

