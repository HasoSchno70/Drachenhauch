' Aus test_gebundene_methoden.py uebertragen (11 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== gebundene sub wirkt auf ihre instanz
CLASS Zaehler
    DIM stand AS INTEGER
    SUB tick()
        Self.stand = Self.stand + 1
    END SUB
    FUNCTION mal(x AS INTEGER) AS INTEGER
        RETURN x * Self.stand
    END FUNCTION
END CLASS

DIM z AS Zaehler
z = NEW Zaehler()
DIM f AS FUNCREF
f = z.tick
f()
f()
PRINT z.stand
--- erwartet
2

=== gebundene funktion mit argument und rueckgabe
CLASS Zaehler
    DIM stand AS INTEGER
    SUB tick()
        Self.stand = Self.stand + 1
    END SUB
    FUNCTION mal(x AS INTEGER) AS INTEGER
        RETURN x * Self.stand
    END FUNCTION
END CLASS

DIM z AS Zaehler
z = NEW Zaehler()
z.stand = 3
DIM f AS FUNCREF
f = z.mal
PRINT f(7)
--- erwartet
21

=== zwei instanzen bleiben getrennt
CLASS Zaehler
    DIM stand AS INTEGER
    SUB tick()
        Self.stand = Self.stand + 1
    END SUB
    FUNCTION mal(x AS INTEGER) AS INTEGER
        RETURN x * Self.stand
    END FUNCTION
END CLASS

DIM a AS Zaehler
DIM b AS Zaehler
a = NEW Zaehler()
b = NEW Zaehler()
DIM fa AS FUNCREF
DIM fb AS FUNCREF
fa = a.tick
fb = b.tick
fa()
fa()
fb()
PRINT a.stand; " "; b.stand
--- erwartet
2 1

=== ueberschriebene methode gewinnt
' Aufgeloest wird beim AUFRUF, nicht beim Binden -- eine als Elternklasse
CLASS Tier
    SUB laut()
        PRINT "..."
    END SUB
END CLASS
CLASS Hund EXTENDS Tier
    SUB laut()
        PRINT "Wuff"
    END SUB
END CLASS
DIM t AS Tier
t = NEW Hund()
DIM f AS FUNCREF
f = t.laut
f()
--- erwartet
Wuff

=== ist nach aussen ein funcref
CLASS Zaehler
    DIM stand AS INTEGER
    SUB tick()
        Self.stand = Self.stand + 1
    END SUB
    FUNCTION mal(x AS INTEGER) AS INTEGER
        RETURN x * Self.stand
    END FUNCTION
END CLASS

DIM z AS Zaehler
z = NEW Zaehler()
DIM f AS FUNCREF
f = z.tick
PRINT TYPEOF(f)
PRINT f
--- erwartet
FUNCREF
<FUNCREF zaehler.tick>

=== gleichheit vergleicht instanz und methode
CLASS Zaehler
    DIM stand AS INTEGER
    SUB tick()
        Self.stand = Self.stand + 1
    END SUB
    FUNCTION mal(x AS INTEGER) AS INTEGER
        RETURN x * Self.stand
    END FUNCTION
END CLASS

DIM a AS Zaehler
DIM b AS Zaehler
a = NEW Zaehler()
b = NEW Zaehler()
PRINT a.tick = a.tick
PRINT a.tick = b.tick
PRINT a.tick = a.mal
--- erwartet
TRUE
FALSE
FALSE

