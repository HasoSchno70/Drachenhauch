GUI_ANIMATE(k, "puls", 700, 0)
DIM n AS INTEGER = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE() : CLS(0) : GUI_DRAW()
    n = n + 1
    IF n = 5 THEN PRINT GUI_NEXT_FRAME()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=6
--- erwartet
