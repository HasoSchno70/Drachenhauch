' ===========================================================================
'  111_anim_fsm.gb  --  Animations-State-Machine (Modul "animfsm")
'
'  Unity-Mecanim-Stil: States (idle/run/jump) + Parameter + Uebergaenge liegen
'  als Daten in "assets/hero.gbanim" (vom Editor `gbanim` erzeugt). Statt im
'  Spielcode von Hand SPRITE_PLAY zu schalten, setzt das Spiel nur Parameter --
'  die FSM entscheidet den Zustand und spielt die passende Animation.
'
'  Steuerung:  Pfeile links/rechts = laufen   ·   LEER = springen   ·   ESC = Ende
' ===========================================================================
IMPORT "animfsm"
IMPORT "sprite"
IMPORT "input"

CONST W AS INTEGER = 480
CONST H AS INTEGER = 360
SCREEN(W, H, "animfsm -- idle / run / jump", 1)

INPUT_BIND("left",  KEY_LEFT,  KEY_A)
INPUT_BIND("right", KEY_RIGHT, KEY_D)
INPUT_BIND("jump",  KEY_SPACE, KEY_W)

' Sprite + FSM aufsetzen -- SETUP registriert die Frame-Ranges aller States
' als Sprite-Animationen und stellt den Default-State (idle) ein.
DIM sheet AS IMAGE
sheet = LOADIMAGE("assets/hero_walk.png")
DIM hero AS SPRITE
hero = SPRITE_NEW(sheet, 16, 16)
SPRITE_SET_SCALE(hero, 5.0, 5.0)

DIM fsm AS ANIM_FSM
fsm = ANIM_FSM_LOAD("assets/hero.gbanim")
ANIM_FSM_SETUP(fsm, hero)

DIM px AS FLOAT
px = 220.0
DIM facing AS INTEGER
facing = 1
DIM last_ms AS INTEGER
last_ms = MILLIS()

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    INPUT_UPDATE()

    DIM now_ms AS INTEGER
    now_ms = MILLIS()
    DIM dt AS INTEGER
    dt = now_ms - last_ms
    last_ms = now_ms

    ' --- Eingabe -> horizontale Bewegung ---
    DIM vx AS FLOAT
    vx = 0.0
    IF INPUT_HELD("left") THEN
        vx = -140.0
        facing = -1
    END IF
    IF INPUT_HELD("right") THEN
        vx = 140.0
        facing = 1
    END IF
    px = px + vx * (dt / 1000.0)
    IF px < 40.0 THEN px = 40.0
    IF px > W - 40 THEN px = W - 40

    ' --- Parameter an die FSM geben (sie entscheidet den State) ---
    ANIM_FSM_SET_FLOAT(fsm, "speed", ABS(vx))
    IF INPUT_PRESSED("jump") THEN ANIM_FSM_TRIGGER(fsm, "jump")

    ' Springen hebt den Sprite optisch an (rein kosmetisch, von der FSM entkoppelt)
    DIM ybase AS FLOAT
    ybase = 210.0
    DIM yoff AS FLOAT
    yoff = 0.0
    IF ANIM_FSM_STATE(fsm) = "jump" THEN
        ' SPRITE_GET_FRAME 0..3 -> Parabel-artiger Hupf
        DIM fr AS INTEGER
        fr = SPRITE_GET_FRAME(hero)
        yoff = -70.0 * SIN(3.14159 * (fr / 3.0))
    END IF

    SPRITE_SET_FLIP(hero, facing < 0, FALSE)
    SPRITE_SET_POS(hero, px - 40.0, ybase + yoff)

    ' --- EIN Aufruf treibt Animation + Zustandslogik ---
    ANIM_FSM_UPDATE(fsm, hero, dt)

    ' --- Zeichnen ---
    CLS(RGB(24, 26, 38))
    BOX(0, 300, W, H, RGB(40, 44, 62))          ' Boden
    LINE(0, 300, W, 300, RGB(90, 100, 130))
    SPRITE_DRAW(hero)

    ' HUD: aktueller State + Parameter
    TEXT(12, 12, "State:  " + ANIM_FSM_STATE(fsm))
    TEXT(12, 30, "Speed:  " + FORMAT$(ANIM_FSM_GET_FLOAT(fsm, "speed"), "%.0f"))
    TEXT(12, H - 22, "Pfeile = laufen   LEER = springen   ESC = Ende")
    FLIP()
WEND
