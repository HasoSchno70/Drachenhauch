=== falsche ziele und ein freigegebenes woerterbuch
IMPORT "gui"
SCREEN(300, 100, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 100)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "x", 10, 10, 50, 20)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 40, 200, 28)
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic")
TRY
    GUI_SPELL(b, h)
CATCH e
    PRINT e
END TRY
SPELL_FREE(h)
TRY
    GUI_SPELL(tf, h)
CATCH e
    PRINT e
END TRY
GUI_SPELL(tf, -1)
PRINT GUI_SPELL_COUNT(tf)
