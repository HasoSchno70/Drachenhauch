' Glutfaden Stufe 22: Kleinigkeiten aus PySticky -- laufende Auswahlkante
' (marching_ants), Aida-Punkt in leeren Zellen (fabric_texture), ein Garn aus
' dem Katalog auf die Farbleiste ziehen, Ebenen in der Liste verschieben oder
' zusammenfuehren (ansicht/ziehen.dh, kern.ebenenZug,
' kern.ebenenZusammenfuehren), eigene Ordner fuer Bibliothek und Vorlagen,
' "Gewaehlte Farbe hervorheben", Stickzeit abschaltbar und "Neu in Glutfaden".
'
' Der erste Fall ist gegen PySticky aufgezeichnet: je Zug die Entscheidung aus
' LayerListWidget.dragMoveEvent/dropEvent (woertlich uebernommen -- sie
' braucht ein QListWidget mit echtem Ziehen) und ihre Ausfuehrung mit
' PyStickys Kern (LayerStack.move_layer_to/merge_layers), dazu der Abzug der
' Ebenen wie in Stufe 20.

=== ebenen ziehen wie pysticky
IMPORT "helfer.dh"
FUNCTION kurz$(t AS STRING) AS STRING
    RETURN LEFT$(LOWER$(MD5$(t)), 12)
END FUNCTION

SUB abzug(m AS kern.Muster)
    DIM i AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR i = 0 TO m.ebenen.anzahl() - 1
        DIM e AS kern.Ebene : e = m.ebenen.ebenen[i]
        DIM z AS ARRAY OF STRING : z = []
        FOR y = 0 TO m.hoehe - 1
            FOR x = 0 TO m.breite - 1
                DIM q AS INTEGER : q = y * m.breite + x
                IF e.raster[q] < 0 THEN CONTINUE
                ARRAY_PUSH(z, STR$(x) + "," + STR$(y) + "," + STR$(e.raster[q]) + "," + STR$(e.art[q]) + "," + STR$(IIF(e.erledigt[q] <> 0, 1, 0)))
            NEXT
        NEXT
        PRINT "  ebene "; i; " "; e.name; ": "; LEN(z); " "; kurz$(JOIN$(z, ";"))
    NEXT
END SUB

SUB zuege(pfad AS STRING, liste AS ARRAY OF STRING)
    DIM spec AS STRING
    FOR EACH spec IN liste
        DIM m AS kern.Muster : m = kern.pxsLaden(pfad)
        DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
        DIM t AS ARRAY OF STRING : t = SPLIT$(spec, ",")
        DIM art AS INTEGER, a AS INTEGER, b AS INTEGER
        (art, a, b) = kern.ebenenZug(m.ebenen.anzahl(), VAL(t[0]), VAL(t[1]), VAL(t[2]))
        DIM ok AS BOOLEAN : ok = FALSE
        IF art = 1 THEN ok = kern.ebeneVerschieben(m, v, a, b)
        IF art = 2 THEN ok = kern.ebenenZusammenfuehren(m, v, a, b)
        DIM namen AS ARRAY OF STRING : namen = []
        DIM e AS kern.Ebene
        FOR EACH e IN m.ebenen.ebenen
            ARRAY_PUSH(namen, e.name)
        NEXT
        PRINT BASENAME(pfad); " "; spec; ": "; ["nichts", "verschieben", "zusammen"][art]; " "; IIF(ok, "True", "False"); " | "; JOIN$(namen, " "); " | aktiv "; m.ebenen.aktiv
        abzug(m)
    NEXT
END SUB

zuege("alle.pxs", ["0,1,0.5", "0,2,0.5", "2,0,0.5", "1,1,0.5", "0,1,0.1", "0,1,0.9", "0,2,0.9", "2,0,0.1", "2,-1,0", "0,-1,0", "1,0,0.26", "1,0,0.74", "1,2,0.24", "1,2,0.76", "2,1,0.25", "2,1,0.75"])
zuege("farbprobe.pxs", ["0,1,0.5", "0,2,0.5", "1,2,0.5", "1,0,0.5", "1,0,0.1", "0,1,0.9", "2,0,0.2"])
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
CONST GLUTORDNER = "{sammlung}/../../examples/glutfaden"
