' Schnellkorrekturen an CODE_CHECK$: je Meldung "korrekturen" mit Titel und
' Aenderungen (Zeile, Spalte ab 1, Laenge -- 0 = einfuegen -- und Text). Die
' IDE wendet sie mit Strg+. an, VS Code bekommt dieselben ueber dhrt lsp.
' Jeder Fall wendet die Korrektur auch an und prueft das Ergebnis erneut.

=== tippfehler und fehlendes dim
IMPORT "json"
DIM NL AS STRING : NL = CHR$(10)
DIM q AS STRING : q = "DIM zaehler AS INTEGER" + NL + "SUB tu()" + NL + "    FOR i = 1 TO 3" + NL + "        zaehlr = zaehlr + 1" + NL + "    NEXT" + NL + "END SUB"
DIM j AS JSON_HANDLE : j = JSON_PARSE("{" + CHR$(34) + "d" + CHR$(34) + ":" + CODE_CHECK$(q) + "}")
DIM i AS INTEGER
DIM k AS INTEGER
FOR i = 0 TO JSON_LEN(j, "d") - 1
    DIM p AS STRING : p = "d." + STR$(i)
    IF NOT JSON_HAS(j, p + ".korrekturen") THEN CONTINUE
    PRINT JSON_GET_INT(j, p + ".zeile"); " "; JSON_GET_INT(j, p + ".spalte")
    FOR k = 0 TO JSON_LEN(j, p + ".korrekturen") - 1
        DIM a AS STRING : a = p + ".korrekturen." + STR$(k) + ".aenderungen.0"
        PRINT "  "; JSON_GET_STRING(j, p + ".korrekturen." + STR$(k) + ".titel"); " @"; JSON_GET_INT(j, a + ".zeile"); ":"; JSON_GET_INT(j, a + ".spalte"); "+"; JSON_GET_INT(j, a + ".laenge"); " ["; REPLACE$(JSON_GET_STRING(j, a + ".text"), NL, "/"); "]"
    NEXT
NEXT
--- erwartet
4 9
  Ersetzen durch zaehler @4:9+6 [zaehler]
  DIM zaehlr AS INTEGER anlegen @3:1+0 [    DIM zaehlr AS INTEGER/]
  DIM zaehlr AS INTEGER global anlegen (oben in der Datei) @1:1+0 [DIM zaehlr AS INTEGER/]

=== befehl und klammern
IMPORT "json"
DIM NL AS STRING : NL = CHR$(10)
FUNCTION titel$(q AS STRING) AS STRING
    DIM j AS JSON_HANDLE : j = JSON_PARSE("{" + CHR$(34) + "d" + CHR$(34) + ":" + CODE_CHECK$(q) + "}")
    DIM raus AS STRING : raus = ""
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "d") - 1
        DIM p AS STRING : p = "d." + STR$(i)
        IF NOT JSON_HAS(j, p + ".korrekturen") THEN CONTINUE
        FOR k = 0 TO JSON_LEN(j, p + ".korrekturen") - 1
            raus = raus + JSON_GET_STRING(j, p + ".korrekturen." + STR$(k) + ".titel") + "|"
        NEXT
    NEXT
    RETURN raus
END FUNCTION
PRINT titel$("CIRCEL(1, 2, 3)")
PRINT titel$("PRNT " + CHR$(34) + "x" + CHR$(34))
PRINT titel$("IF 1 != 2 THEN PRINT(1)")
PRINT "["; titel$("PRINT(1)"); "]"
--- erwartet
Ersetzen durch CIRCLE|Ersetzen durch CIRCLES|
Klammern setzen|
Durch <> ersetzen|
[]

=== blockende import und unbenutzte variable
' Je Meldung Titel und Aenderung (zeile:spalte bis bis_zeile:bis_spalte),
' der Text mit / statt Zeilenumbruch.
IMPORT "json"
DIM NL AS STRING : NL = CHR$(10)
SUB zeige(q AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE("{" + CHR$(34) + "d" + CHR$(34) + ":" + CODE_CHECK$(q) + "}")
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "d") - 1
        DIM p AS STRING : p = "d." + STR$(i)
        IF NOT JSON_HAS(j, p + ".korrekturen") THEN CONTINUE
        PRINT JSON_GET_STRING(j, p + ".schwere"); " "; JSON_GET_INT(j, p + ".zeile")
        FOR k = 0 TO JSON_LEN(j, p + ".korrekturen") - 1
            DIM a AS STRING : a = p + ".korrekturen." + STR$(k) + ".aenderungen.0"
            PRINT "  "; JSON_GET_STRING(j, p + ".korrekturen." + STR$(k) + ".titel"); " @"; JSON_GET_INT(j, a + ".zeile"); ":"; JSON_GET_INT(j, a + ".spalte"); "-"; JSON_GET_INT(j, a + ".bis_zeile"); ":"; JSON_GET_INT(j, a + ".bis_spalte"); " ["; REPLACE$(JSON_GET_STRING(j, a + ".text"), NL, "/"); "]"
        NEXT
    NEXT
END SUB
zeige("SUB tu()" + NL + "    IF 1 > 0 THEN" + NL + "        PRINT(1)" + NL + "    PRINT(2)" + NL + "END SUB")
zeige("' Kopf" + NL + "DIM v AS VEC2")
zeige("SUB tu()" + NL + "    DIM leer AS INTEGER" + NL + "    PRINT(1)" + NL + "END SUB")
--- erwartet
fehler 5
  END IF ergaenzen @3:17-3:17 [/    END IF]
fehler 2
  IMPORT "vec2" einfuegen @2:1-2:1 [IMPORT "vec2"/]
hinweis 2
  Zeile entfernen @2:1-3:1 []

=== im unterprogramm gibt es auch das globale dim
' Beim Dogfooding 2026-09-30: fuer einen Wert, der den Aufruf ueberleben soll
' (welcher Eintrag wird bearbeitet), half das lokale DIM nicht. Die globale
' Variante kommt oben hinter die IMPORTs; angewendet laeuft das Programm, und
' der Wert ist nach dem Aufruf noch da.
IMPORT "json"
DIM NL AS STRING : NL = CHR$(10)
DIM q AS STRING : q = "' Kopf" + NL + "IMPORT " + CHR$(34) + "json" + CHR$(34) + NL + NL + "SUB merken()" + NL + "    bearbeitId = 7" + NL + "END SUB" + NL + "merken()" + NL + "PRINT 1"
DIM j AS JSON_HANDLE : j = JSON_PARSE("{" + CHR$(34) + "d" + CHR$(34) + ":" + CODE_CHECK$(q) + "}")
DIM i AS INTEGER
DIM k AS INTEGER
DIM z AS ARRAY OF STRING : z = SPLIT$(q, NL)
FOR i = 0 TO JSON_LEN(j, "d") - 1
    DIM p AS STRING : p = "d." + STR$(i)
    IF NOT JSON_HAS(j, p + ".korrekturen") THEN CONTINUE
    FOR k = 0 TO JSON_LEN(j, p + ".korrekturen") - 1
        DIM t AS STRING : t = JSON_GET_STRING(j, p + ".korrekturen." + STR$(k) + ".titel")
        PRINT t
        IF INSTR(t, "global") >= 0 THEN
            DIM a AS STRING : a = p + ".korrekturen." + STR$(k) + ".aenderungen.0"
            ARRAY_INSERT(z, JSON_GET_INT(j, a + ".zeile") - 1, REPLACE$(JSON_GET_STRING(j, a + ".text"), NL, ""))
        END IF
    NEXT
NEXT
' angewendet: oben das DIM, und hinten liest das Hauptprogramm den Wert
DIM neu AS STRING : neu = REPLACE$(JOIN$(z, NL), "PRINT 1", "PRINT bearbeitId")
PRINT REPLACE$(neu, NL, "/")
PRINT "befund "; CODE_CHECK$(neu)
WRITEALL("neu.dh", neu)
DIM pr AS INTEGER : pr = PROCESS_START("dhrt", "run", "neu.dh")
DIM aus AS STRING : aus = ""
DIM still AS INTEGER : still = 0
WHILE still < 5
    DIM zz AS STRING : zz = PROCESS_READ$(pr)
    IF zz <> "" THEN aus = aus + TRIM$(zz) : still = 0
    IF zz = "" AND NOT PROCESS_RUNNING(pr) THEN still = still + 1 : SLEEP(30)
WEND
PRINT "lauf "; aus
--- erwartet
DIM bearbeitId AS INTEGER anlegen
DIM bearbeitId AS INTEGER global anlegen (oben in der Datei)
' Kopf/IMPORT "json"/DIM bearbeitId AS INTEGER//SUB merken()/    bearbeitId = 7/END SUB/merken()/PRINT bearbeitId
befund []
lauf 7

=== viele meldungen kosten linear viel
' Stresstest 2026-10-02: korrekturen zerlegte fuer JEDE Meldung den ganzen
' Text neu (Zeilen, Bereiche, Fundstellen) -- 2000 Meldungen kosteten
' 1,1 s, 5000 je CODE_CHECK$ 6,6 s, und die IDE prueft nach jeder
' Tipp-Pause. Jetzt rechnet ein Kontext das einmal je Pruefung. Die
' Korrektur bleibt dieselbe; die Grenze ist grob (vorher ~4 s).
DIM z AS ARRAY OF STRING : z = ["DIM a AS INTEGER"]
DIM i AS INTEGER
FOR i = 0 TO 3999
    ARRAY_PUSH(z, "a = unbekannt" + STR$(i) + " + 1")
NEXT
DIM t0 AS FLOAT : t0 = GET_TIME()
DIM r AS STRING : r = CODE_CHECK$(JOIN$(z, CHR$(10)), ".")
DIM d AS FLOAT : d = GET_TIME() - t0
PRINT "flott "; d < 1.0
PRINT "korrektur da "; INSTR(r, "DIM unbekannt3999 AS INTEGER anlegen") >= 0
--- erwartet
flott TRUE
korrektur da TRUE
