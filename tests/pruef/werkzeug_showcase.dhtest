--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
PRINT "kacheln 32 "; hat("kacheln 32")
PRINT "handbuch oben "; hat("handbuch offen TRUE")
PRINT "reihe 1 "; hat("kacheln reihe 1")
--- erwartet
kacheln 32 TRUE
handbuch oben TRUE
reihe 1 FALSE
