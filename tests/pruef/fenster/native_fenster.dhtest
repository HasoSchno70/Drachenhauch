=== das kontextmenue eines nativen fensters steht in ihm
' Rechtsklick (WM_RBUTTONDOWN 516 / UP 517) ins Feld bei (60, 40): das Menue
' "Einfuegen" erscheint darunter IM nativen Fenster -- vorher landete es im
' Hauptfenster an der Stelle, die es im nativen gehabt haette. Gelesen wird
' (150, 60) im nativen Fenster vor und nach dem Klick.
IMPORT "helfer.dh"
DIM kennung AS STRING : kennung = "Kontext-" + STR$(MILLIS()) + "-" + STR$(INT(RND() * 1000000))
DIM kind AS INTEGER : kind = PROCESS_START("dhrt", "run", CWD$() + "/dialog.dh", "--", kennung, "frei")
DIM vorher AS STRING : vorher = ps$("fensterpixel.ps1", kennung, "150,60")
DIM s AS STRING : s = ps$("fenstersender.ps1", kennung, "roh:512:0:2621500;roh:516:2:2621500;roh:517:0:2621500")
DIM nachher AS STRING : nachher = ps$("fensterpixel.ps1", kennung, "150,60")
DIM k AS STRING : k = auslesen$(kind, 30000)
IF INSTR(auslesenFehler, "Kein Fenster moeglich") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    END
END IF
PRINT "gelesen "; INSTR(vorher, "150,60 #") >= 0 AND INSTR(nachher, "150,60 #") >= 0
PRINT "menue da "; TRIM$(vorher) <> TRIM$(nachher)
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fenstersender.ps1"
END FUNCTION
FUNCTION hilfe$(name AS STRING) AS STRING
    RETURN "{sammlung}/../_hilfen/" + name
END FUNCTION
FUNCTION ps$(skriptname AS STRING, a AS STRING, b AS STRING) AS STRING
    DIM p AS INTEGER : p = PROCESS_START("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", hilfe$(skriptname), a, b)
    RETURN auslesen$(p, 30000)
END FUNCTION
--- datei dialog.dh
