' Sprach-Erweiterungen: REPEAT/UNTIL, DATA/READ/RESTORE, implizite
' Zeilenfortsetzung, Hex-/Binaer-Literale, FORMAT$, Vorgabewerte fuer
' Parameter, zusammengesetzte Zuweisung, f-Strings.
' Bis Stufe 50 (2026-09-14) tests/test_language_extensions.py; die Faelle zog
' ein Generator aus dem Syntaxbaum, liess sie laufen und pruefte die
' pytest-Zusagen, bevor die ganze Ausgabe zur Erwartung wurde. Die drei
' Registrierungs-Tests stehen in builtin_registrierung.dhtest.
' Format: docs/werkzeuge.md, dhrt test.

=== repeat basic
DIM i AS INTEGER
i = 0
REPEAT
    PRINT i
    i = i + 1
UNTIL i >= 3
--- erwartet
0
1
2

=== repeat runs at least once
' Auch wenn die Bedingung sofort wahr ist, laeuft der Rumpf einmal.
DIM i AS INTEGER
i = 100
REPEAT
    PRINT "once"
UNTIL i = 100
--- erwartet
once

=== repeat break exits
DIM i AS INTEGER
i = 0
REPEAT
    PRINT i
    IF i = 1 THEN BREAK
    i = i + 1
UNTIL i >= 100
--- erwartet
0
1

=== repeat continue jumps to condition
DIM i AS INTEGER
i = 0
REPEAT
    i = i + 1
    IF i MOD 2 = 1 THEN CONTINUE
    PRINT i
UNTIL i >= 6
--- erwartet
2
4
6

=== data read basic
DATA "Anna", 30
DIM name AS STRING
DIM age AS INTEGER
READ name, age
PRINT name, age
--- erwartet
Anna 30

=== data read multiple
DATA "Anna", 100, "Bert", 75, "Cilly", 50
DIM name AS STRING
DIM score AS INTEGER
DIM i AS INTEGER
FOR i = 0 TO 2
    READ name, score
    PRINT name, score
NEXT
--- erwartet
Anna 100
Bert 75
Cilly 50

=== data negative numbers
DATA -5, -10, 100
DIM x AS INTEGER
DIM i AS INTEGER
FOR i = 0 TO 2
    READ x
    PRINT x
NEXT
--- erwartet
-5
-10
100

=== data floats
DATA 1.5, -2.75, 3.14
DIM x AS FLOAT
DIM i AS INTEGER
FOR i = 0 TO 2
    READ x
    PRINT x
NEXT
--- erwartet
1.5
-2.75
3.14

=== data booleans
DATA TRUE, FALSE, TRUE
DIM b AS BOOLEAN
DIM i AS INTEGER
FOR i = 0 TO 2
    READ b
    PRINT b
NEXT
--- erwartet
TRUE
FALSE
TRUE

=== restore resets pointer
DATA 1, 2, 3
DIM x AS INTEGER
READ x
READ x
PRINT x
RESTORE
READ x
PRINT x
--- erwartet
2
1

=== restore before the first print
DATA 1, 2, 3
DIM x AS INTEGER
READ x
READ x
RESTORE
READ x
PRINT x
--- erwartet
1

=== read beyond data errors
DATA 1
DIM x AS INTEGER
READ x
READ x
--- fehler
keine DATA-Werte mehr

=== data collected from inside subs
' Klassisches BASIC: DATA-Anweisungen werden aus dem ganzen Programm
' gesammelt, auch wenn sie in SUB/FUNCTION-Ruempfen stehen.
SUB lade()
    DATA "Hidden", 42
END SUB

DIM name AS STRING
DIM x AS INTEGER
READ name, x
PRINT name, x
--- erwartet
Hidden 42

=== data into array element
DATA 10, 20, 30
DIM xs[3] AS INTEGER
DIM i AS INTEGER
FOR i = 0 TO 2
    READ xs[i]
NEXT
PRINT xs[0], xs[1], xs[2]
--- erwartet
10 20 30

=== data type coercion string into int errors
DATA "nicht eine zahl"
DIM x AS INTEGER
READ x
--- fehler
Zuweisung an 'x': Erwartet INTEGER, erhalten STRING

=== multiline call in parens
' Zeilenumbrueche innerhalb offener Klammern ignoriert der Parser.
DIM s AS STRING
s = REPEAT$(
    "ab",
    3
)
PRINT s
--- erwartet
ababab

=== multiline array index
DIM xs[3] AS INTEGER
xs[0] = 10
xs[1] = 20
xs[2] = 30
PRINT xs[
    1
]
--- erwartet
20

=== explicit underscore continuation still works
' Das alte _ am Zeilenende geht weiter.
DIM x AS INTEGER
x = 1 + _
    2 + _
    3
PRINT x
--- erwartet
6

=== joystick rumble no gamepad graceful error
' Ohne angeschlossenes Gamepad wirft JOYSTICK_RUMBLE denselben
' faengbaren Fehler wie die anderen JOYSTICK_*-Funktionen (kein Absturz).
JOYSTICK_RUMBLE(0, 1.0, 1.0, 0.5)
--- fehler
kein Gamepad angeschlossen

=== repeat string builtin still works
' REPEAT ist ein Schluesselwort, REPEAT$ bleibt ein Befehl.
PRINT REPEAT$("ab", 3)
--- erwartet
ababab

=== hex literal
PRINT &HFF
PRINT &h0a
PRINT &HCAFE
--- erwartet
255
10
51966

=== binary literal
PRINT &B11010110
PRINT &b1111
--- erwartet
214
15

=== hex literal no digits errors
PRINT &H
--- fehler
Hex-Literal

=== amp without h or b errors
PRINT &Z
--- fehler
Erwartet H oder B nach '&'

=== hex used in arithmetic
PRINT &H10 + &H20
--- erwartet
48

=== format integer padding
PRINT FORMAT$(42, "%05d")
--- erwartet
00042

=== format float precision
PRINT FORMAT$(3.14159, "%.2f")
--- erwartet
3.14

=== format string left align
PRINT FORMAT$("hi", "%-5s|")
--- erwartet
hi   |

=== format hex via mask
PRINT FORMAT$(255, "%04X")
--- erwartet
00FF

=== format invalid mask errors
PRINT FORMAT$("nicht eine zahl", "%d")
--- fehler
FORMAT

=== default param used when omitted
SUB greet(name AS STRING, prefix AS STRING = "Hallo")
    PRINT prefix, name
END SUB

greet("Anna")
--- erwartet
Hallo Anna

=== default param overridden
SUB greet(name AS STRING, prefix AS STRING = "Hallo")
    PRINT prefix, name
END SUB

greet("Bert", "Hi")
--- erwartet
Hi Bert

=== default in function
FUNCTION power(base AS FLOAT, exp AS INTEGER = 2) AS FLOAT
    DIM r AS FLOAT
    r = 1.0
    DIM i AS INTEGER
    FOR i = 1 TO exp
        r = r * base
    NEXT
    RETURN r
END FUNCTION

PRINT power(3.0)
PRINT power(3.0, 4)
--- erwartet
9.0
81.0

=== default can reference earlier param
' Der Vorgabewert von h ist w -- ausgewertet beim Aufruf, wenn w schon steht.
SUB show_rect(x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER = w)
    PRINT x, y, w, h
END SUB

show_rect(0, 0, 50)
--- erwartet
0 0 50 50

=== required after default rejected
SUB foo(a AS INTEGER = 1, b AS INTEGER)
END SUB
--- fehler
ohne Default

=== too few args errors
SUB foo(a AS INTEGER, b AS INTEGER = 10)
END SUB

foo()
--- fehler
foo: Parameter 'a' fehlt

=== too many args errors
SUB foo(a AS INTEGER, b AS INTEGER = 10)
END SUB

foo(1, 2, 3)
--- fehler
Argument

=== default type coercion
' Der Vorgabewert wird wie ein Argument auf den Parametertyp gebracht.
SUB scale(x AS FLOAT = 1)
    PRINT x
END SUB

scale()
--- erwartet
1.0

=== compound plus eq
DIM x AS INTEGER
x = 10
x += 5
PRINT x
--- erwartet
15

=== compound minus eq
DIM x AS INTEGER
x = 10
x -= 3
PRINT x
--- erwartet
7

=== compound star eq
DIM x AS INTEGER
x = 10
x *= 3
PRINT x
--- erwartet
30

=== compound slash eq
DIM x AS INTEGER
x = 12
x /= 4
PRINT x
--- erwartet
3

=== compound on array
DIM xs[3] AS INTEGER
xs[0] = 100
xs[0] += 25
PRINT xs[0]
--- erwartet
125

=== fstring simple
DIM n AS STRING
n = "Anna"
PRINT f"Hallo, {n}!"
--- erwartet
Hallo, Anna!

=== fstring int via str
' STR$ wird um den Ausdruck gelegt -- INTEGER geht.
DIM x AS INTEGER
x = 42
PRINT f"x = {x}"
--- erwartet
x = 42

=== fstring multiple exprs
DIM a AS INTEGER
DIM b AS INTEGER
a = 5
b = 7
PRINT f"{a} + {b} = {a + b}"
--- erwartet
5 + 7 = 12

=== fstring double brace escapes
DIM x AS INTEGER
x = 5
PRINT f"{{not expr}} {x}"
--- erwartet
{not expr} 5

=== fstring empty
PRINT "x:" + f""
--- erwartet
x:

=== fstring only expr
DIM x AS INTEGER
x = 5
PRINT f"{x}"
--- erwartet
5

=== fstring unterminated errors
PRINT f"hello
--- fehler
f-String

=== fstring empty expr errors
PRINT f"{}"
--- fehler
Leerer

=== fstring with another name
DIM n AS STRING
n = "Bob"
PRINT f"hi {n}"
--- erwartet
hi Bob
