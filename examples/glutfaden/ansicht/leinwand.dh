' Die Zeichenflaeche: Zoom um den Mauszeiger, Verschieben (Hand oder mittlere
' Maustaste), Raster, Symbole, Teilstiche, Rueckstiche -- und die Werkzeuge
' (ansicht/werkzeuge.dh), denen sie die Zellen unter der Maus meldet.
'
' Das Muster liegt einmal als Bild mit EINEM Pixel je Kaestchen vor
' (lwPuffer, ARGB); Cairo vergroessert es ohne Glaettung. So kostet auch ein
' 2000 x 2000-Muster einen Zeichenaufruf, egal wie weit herausgezoomt ist.
' Was es feiner braucht (Teilstiche, Symbole, Raster), kommt nur fuer den
' sichtbaren Ausschnitt obendrauf.
'
' Ein Werkzeug aendert wenige Zellen: dafuer schreibt leinwandZellen() nur
' deren Bildpunkte neu. Hat eine sichtbare Ebene weniger als volle Deckkraft,
' wird sie wie im Original ueber das Darunterliegende gemischt.

CONST LW_HINTERGRUND = &H2D2D2D
CONST LW_STOFF = &HFAFAF5             ' Aida-Stoff, cremeweiss
CONST LW_ZELLE_STANDARD = 20.0        ' 100 %
CONST LW_ZELLE_MIN = 1.0
CONST LW_ZELLE_MAX = 60.0
CONST LW_RASTER_GROSS = 10            ' jede zehnte Linie kraeftiger

DIM lwFlaeche AS INTEGER              ' GtkDrawingArea
DIM lwMuster AS kern.Muster
DIM lwHat AS BOOLEAN
DIM lwFarbe AS ARRAY OF INTEGER       ' zusammengesetzt: Farbindex je Zelle
DIM lwTyp AS ARRAY OF INTEGER
DIM lwFertig AS ARRAY OF INTEGER
DIM lwRgb AS ARRAY OF INTEGER         ' je Farbindex
DIM lwPuffer AS BUFFER
DIM lwBild AS INTEGER                 ' cairo_surface_t, 0 = keins
DIM lwZelle AS FLOAT
DIM lwX AS FLOAT
DIM lwY AS FLOAT
DIM lwZiehen AS BOOLEAN
DIM lwZiehX AS FLOAT
DIM lwZiehY AS FLOAT
DIM lwMausX AS INTEGER
DIM lwMausY AS INTEGER
DIM lwSchrift AS INTEGER              ' PangoFontDescription
DIM lwEingepasst AS BOOLEAN           ' beim ersten Zeichnen einpassen
DIM lwZeile AS INTEGER                ' Bytes je Bildzeile in lwPuffer
DIM lwHalbX AS INTEGER                ' Rueckstich: Rasterpunkt unter der Maus (Halbstich-Einheiten)
DIM lwHalbY AS INTEGER
DIM lwHalbGenauX AS FLOAT             ' ... und ungerastert (zum Treffen eines Rueckstichs)
DIM lwHalbGenauY AS FLOAT

FUNCTION leinwandNeu() AS INTEGER
    lwFlaeche = gtk_drawing_area_new()
    gtk_widget_set_hexpand(lwFlaeche, TRUE)
    gtk_widget_set_vexpand(lwFlaeche, TRUE)
    gtk_widget_add_events(lwFlaeche, GDK_MASKE_BEWEGUNG BOR GDK_MASKE_DRUCK BOR GDK_MASKE_LOSLASSEN BOR GDK_MASKE_RAD BOR GDK_MASKE_RAD_FEIN BOR GDK_MASKE_VERLASSEN)
    signalZeichnen(lwFlaeche, "draw", lwZeichnen, 0, 0, 0)
    signalEreignis(lwFlaeche, "scroll-event", lwRad, 0, 0, 0)
    signalEreignis(lwFlaeche, "button-press-event", lwDruck, 0, 0, 0)
    signalEreignis(lwFlaeche, "button-release-event", lwLoslassen, 0, 0, 0)
    signalEreignis(lwFlaeche, "motion-notify-event", lwBewegung, 0, 0, 0)
    signalEreignis(lwFlaeche, "leave-notify-event", lwVerlassen, 0, 0, 0)
    gtk_widget_set_can_focus(lwFlaeche, TRUE)
    lwSchrift = pango_font_description_from_string("DejaVu Sans Bold 10")
    lwZelle = LW_ZELLE_STANDARD
    lwMausX = -1
    RETURN lwFlaeche
END FUNCTION

SUB leinwandMuster(m AS kern.Muster)
    lwMuster = m
    lwHat = TRUE
    leinwandAufbauen()
    lwEingepasst = FALSE
    gtk_widget_queue_draw(lwFlaeche)
END SUB

' Zusammensetzen und das Pixelbild neu schreiben -- nach dem Laden, nach
' Rueckgaengig und wenn sich an Ebenen oder Farben etwas aendert.
SUB leinwandAufbauen()
    IF NOT lwHat THEN RETURN
    lwMuster.ebenen.zusammensetzen(lwFarbe, lwTyp, lwFertig)
    DIM n AS INTEGER : n = lwMuster.farbanzahl()
    DIM rgb[n + 1] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        rgb[i] = lwMuster.farben[i].garn.farbe
    NEXT
    lwRgb = rgb
    DIM b AS INTEGER : b = lwMuster.breite
    DIM h AS INTEGER : h = lwMuster.hoehe
    IF lwBild <> 0 THEN cairo_surface_destroy(lwBild) : lwBild = 0
    lwZeile = cairo_format_stride_for_width(CAIRO_ARGB32, b)
    lwPuffer = BUFFER_NEW(lwZeile * h)
    DIM gemischt AS BOOLEAN : gemischt = lwMischen()
    DIM x AS INTEGER, y AS INTEGER, c AS INTEGER
    FOR y = 0 TO h - 1
        FOR x = 0 TO b - 1
            IF gemischt THEN
                BUFFER_SET_U32(lwPuffer, y * lwZeile + x * 4, lwMischfarbe(x, y))
            ELSE
                c = lwFarbe[y * b + x]
                IF c >= 0 AND c < n THEN BUFFER_SET_U32(lwPuffer, y * lwZeile + x * 4, &HFF000000 BOR lwRgb[c])
            END IF
        NEXT
    NEXT
    lwBild = cairo_image_surface_create_for_data(BUFFER_ZEIGER(lwPuffer), CAIRO_ARGB32, b, h, lwZeile)
END SUB

' Hat eine sichtbare Ebene weniger als volle Deckkraft?
FUNCTION lwMischen() AS BOOLEAN
    DIM e AS kern.Ebene
    FOR EACH e IN lwMuster.ebenen.ebenen
        IF e.sichtbar AND e.deckkraft < 0.999 THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Die Farbe einer Zelle, Ebene fuer Ebene von unten ueber den Stoff gemischt
' (wie das Original jede Ebene mit ihrer Deckkraft darueber malt). Ohne Stich
' durchsichtig -- dort zeigt sich der Stoff von selbst.
FUNCTION lwMischfarbe(x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM r AS FLOAT, g AS FLOAT, bl AS FLOAT
    DIM da AS BOOLEAN
    DIM n AS INTEGER : n = lwMuster.farbanzahl()
    DIM e AS kern.Ebene
    FOR EACH e IN lwMuster.ebenen.ebenen
        IF NOT e.sichtbar THEN CONTINUE
        DIM c AS INTEGER : c = e.raster[y * e.breite + x]
        IF c < 0 OR c >= n THEN CONTINUE
        IF NOT da THEN
            r = (LW_STOFF SHR 16) BAND 255 : g = (LW_STOFF SHR 8) BAND 255 : bl = LW_STOFF BAND 255
            da = TRUE
        END IF
        DIM f AS INTEGER : f = lwRgb[c]
        DIM a AS FLOAT : a = CLAMP(e.deckkraft, 0.0, 1.0)
        r = r + (((f SHR 16) BAND 255) - r) * a
        g = g + (((f SHR 8) BAND 255) - g) * a
        bl = bl + ((f BAND 255) - bl) * a
    NEXT
    IF NOT da THEN RETURN 0
    RETURN &HFF000000 BOR (ROUND(r) SHL 16) BOR (ROUND(g) SHL 8) BOR ROUND(bl)
END FUNCTION

' Nur diese Zellen neu ([x0, y0, ...]) -- nach einem Strich. Ausserhalb wird
' uebergangen.
SUB leinwandZellen(p AS ARRAY OF INTEGER)
    IF NOT lwHat OR lwBild = 0 THEN RETURN
    DIM b AS INTEGER : b = lwMuster.breite
    DIM h AS INTEGER : h = lwMuster.hoehe
    DIM n AS INTEGER : n = lwMuster.farbanzahl()
    IF LEN(lwRgb) < n + 1 THEN
        ' eine neue Farbe ist dazugekommen
        leinwandAufbauen()
        gtk_widget_queue_draw(lwFlaeche)
        RETURN
    END IF
    DIM gemischt AS BOOLEAN : gemischt = lwMischen()
    DIM k AS INTEGER, x AS INTEGER, y AS INTEGER, i AS INTEGER
    FOR k = 0 TO LEN(p) - 2 STEP 2
        x = p[k] : y = p[k + 1]
        IF x < 0 OR y < 0 OR x >= b OR y >= h THEN CONTINUE
        i = y * b + x
        ' der oberste sichtbare Stich fuer Symbol und Form
        lwFarbe[i] = kern.KEIN_STICH : lwTyp[i] = 0 : lwFertig[i] = 0
        DIM e AS kern.Ebene
        FOR EACH e IN lwMuster.ebenen.ebenen
            IF e.sichtbar AND e.raster[i] <> kern.KEIN_STICH THEN
                lwFarbe[i] = e.raster[i] : lwTyp[i] = e.art[i] : lwFertig[i] = e.erledigt[i]
            END IF
        NEXT
        DIM c AS INTEGER : c = lwFarbe[i]
        IF gemischt THEN
            BUFFER_SET_U32(lwPuffer, y * lwZeile + x * 4, lwMischfarbe(x, y))
        ELSEIF c >= 0 AND c < n THEN
            BUFFER_SET_U32(lwPuffer, y * lwZeile + x * 4, &HFF000000 BOR lwRgb[c])
        ELSE
            BUFFER_SET_U32(lwPuffer, y * lwZeile + x * 4, 0)
        END IF
    NEXT
    cairo_surface_mark_dirty(lwBild)
    gtk_widget_queue_draw(lwFlaeche)
END SUB

' --- Zoom und Lage ---------------------------------------------------------------
FUNCTION leinwandZoomProzent() AS INTEGER
    RETURN ROUND(lwZelle / LW_ZELLE_STANDARD * 100)
END FUNCTION

' Neue Zellgroesse, der Punkt (px, py) bleibt unter dem Zeiger stehen.
SUB leinwandZoom(neu AS FLOAT, px AS FLOAT, py AS FLOAT)
    neu = CLAMP(neu, LW_ZELLE_MIN, LW_ZELLE_MAX)
    DIM wx AS FLOAT : wx = (px - lwX) / lwZelle
    DIM wy AS FLOAT : wy = (py - lwY) / lwZelle
    lwZelle = neu
    lwX = px - wx * neu
    lwY = py - wy * neu
    gtk_widget_queue_draw(lwFlaeche)
    statusNachziehen()
END SUB

SUB leinwandZoomMitte(faktor AS FLOAT)
    leinwandZoom(lwZelle * faktor, gtk_widget_get_allocated_width(lwFlaeche) / 2.0, gtk_widget_get_allocated_height(lwFlaeche) / 2.0)
END SUB

SUB leinwandEinpassen()
    IF NOT lwHat THEN RETURN
    DIM bw AS FLOAT : bw = gtk_widget_get_allocated_width(lwFlaeche)
    DIM bh AS FLOAT : bh = gtk_widget_get_allocated_height(lwFlaeche)
    IF bw < 10 OR bh < 10 THEN RETURN
    lwZelle = CLAMP(MIN((bw - 40) / lwMuster.breite, (bh - 40) / lwMuster.hoehe), LW_ZELLE_MIN, LW_ZELLE_MAX)
    lwX = (bw - lwMuster.breite * lwZelle) / 2
    lwY = (bh - lwMuster.hoehe * lwZelle) / 2
    lwEingepasst = TRUE
    gtk_widget_queue_draw(lwFlaeche)
    statusNachziehen()
END SUB

' Bildschirmpunkt -> Zelle, auch ausserhalb (fuer Formen, die ueber den Rand gehen)
FUNCTION lwRohX(px AS FLOAT) AS INTEGER
    RETURN FLOOR((px - lwX) / lwZelle)
END FUNCTION
FUNCTION lwRohY(py AS FLOAT) AS INTEGER
    RETURN FLOOR((py - lwY) / lwZelle)
END FUNCTION

' Bildschirmpunkt -> Zelle (-1, wenn ausserhalb des Musters)
FUNCTION leinwandZelleX(px AS FLOAT) AS INTEGER
    IF NOT lwHat THEN RETURN -1
    DIM x AS INTEGER : x = FLOOR((px - lwX) / lwZelle)
    IF x < 0 OR x >= lwMuster.breite THEN RETURN -1
    RETURN x
END FUNCTION
FUNCTION leinwandZelleY(py AS FLOAT) AS INTEGER
    IF NOT lwHat THEN RETURN -1
    DIM y AS INTEGER : y = FLOOR((py - lwY) / lwZelle)
    IF y < 0 OR y >= lwMuster.hoehe THEN RETURN -1
    RETURN y
END FUNCTION

' --- Zeichnen -----------------------------------------------------------------------
FUNCTION lwZeichnen(w AS INTEGER, cr AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM bw AS FLOAT : bw = gtk_widget_get_allocated_width(w)
    DIM bh AS FLOAT : bh = gtk_widget_get_allocated_height(w)
    cairoFarbe(cr, LW_HINTERGRUND)
    cairo_paint(cr)
    IF NOT lwHat THEN RETURN TRUE
    IF NOT lwEingepasst THEN leinwandEinpassen()
    DIM b AS INTEGER : b = lwMuster.breite
    DIM h AS INTEGER : h = lwMuster.hoehe
    DIM z AS FLOAT : z = lwZelle

    ' Stoff und das Pixelbild
    cairoFarbe(cr, LW_STOFF)
    cairo_rectangle(cr, lwX, lwY, b * z, h * z)
    cairo_fill(cr)
    cairo_save(cr)
    cairo_translate(cr, lwX, lwY)
    cairo_scale(cr, z, z)
    cairo_set_source_surface(cr, lwBild, 0, 0)
    cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_NAECHST)
    cairo_rectangle(cr, 0, 0, b, h)
    cairo_fill(cr)
    cairo_restore(cr)

    ' Der sichtbare Ausschnitt
    DIM x0 AS INTEGER : x0 = MAX(0, FLOOR(-lwX / z))
    DIM y0 AS INTEGER : y0 = MAX(0, FLOOR(-lwY / z))
    DIM x1 AS INTEGER : x1 = MIN(b - 1, FLOOR((bw - lwX) / z))
    DIM y1 AS INTEGER : y1 = MIN(h - 1, FLOOR((bh - lwY) / z))
    DIM x AS INTEGER, y AS INTEGER, c AS INTEGER, t AS INTEGER, i AS INTEGER

    ' Besondere Stichtypen: die Zelle zuerst wieder Stoff, dann die Form
    DIM gemischt AS BOOLEAN : gemischt = lwMischen()
    ' Diamond Painting: auch ein ganzer Stich ist ein Drill (PySticky diamond_view)
    DIM drills AS BOOLEAN : drills = lwMuster.modus = "diamond"
    IF z >= 6 THEN
        FOR y = y0 TO y1
            FOR x = x0 TO x1
                i = y * b + x
                t = lwTyp[i]
                IF t = 0 AND drills THEN t = kern.DIAMANT
                IF t = 0 OR lwFarbe[i] < 0 THEN CONTINUE
                ' gemischt: die Farbe aus dem Bild, damit auch Teilstiche durchscheinen
                IF gemischt THEN
                    lwSonderstich(cr, lwX + x * z, lwY + y * z, z, t, BUFFER_GET_U32(lwPuffer, y * lwZeile + x * 4) BAND &HFFFFFF)
                ELSE
                    lwSonderstich(cr, lwX + x * z, lwY + y * z, z, t, lwRgb[lwFarbe[i]])
                END IF
            NEXT
        NEXT
    END IF

    ' Symbole
    IF z >= 12 THEN lwSymbole(cr, x0, y0, x1, y1)

    ' Raster
    IF z >= 4 THEN
        cairo_set_line_width(cr, 1.0)
        cairo_set_source_rgba(cr, 0.0, 0.0, 0.0, 0.14)
        FOR x = x0 TO x1 + 1
            IF x MOD LW_RASTER_GROSS = 0 THEN CONTINUE
            cairo_move_to(cr, ROUND(lwX + x * z) + 0.5, MAX(lwY, 0))
            cairo_line_to(cr, ROUND(lwX + x * z) + 0.5, MIN(lwY + h * z, bh))
        NEXT
        FOR y = y0 TO y1 + 1
            IF y MOD LW_RASTER_GROSS = 0 THEN CONTINUE
            cairo_move_to(cr, MAX(lwX, 0), ROUND(lwY + y * z) + 0.5)
            cairo_line_to(cr, MIN(lwX + b * z, bw), ROUND(lwY + y * z) + 0.5)
        NEXT
        cairo_stroke(cr)
    END IF
    IF z >= 2 THEN
        cairo_set_line_width(cr, IIF(z >= 8, 2.0, 1.0))
        cairo_set_source_rgba(cr, 0.0, 0.0, 0.0, 0.5)
        FOR x = 0 TO b STEP LW_RASTER_GROSS
            cairo_move_to(cr, ROUND(lwX + x * z), lwY)
            cairo_line_to(cr, ROUND(lwX + x * z), lwY + h * z)
        NEXT
        FOR y = 0 TO h STEP LW_RASTER_GROSS
            cairo_move_to(cr, lwX, ROUND(lwY + y * z))
            cairo_line_to(cr, lwX + b * z, ROUND(lwY + y * z))
        NEXT
        cairo_stroke(cr)
    END IF

    ' Rueckstiche (Halbstich-Einheiten)
    DIM r AS kern.Rueckstich
    cairo_set_line_width(cr, MAX(1.5, z / 6))
    FOR EACH r IN lwMuster.rueckstiche
        IF r.farbe < 0 OR r.farbe >= LEN(lwRgb) - 1 THEN CONTINUE
        cairoFarbe(cr, lwRgb[r.farbe])
        cairo_move_to(cr, lwX + r.x1 * z / 2, lwY + r.y1 * z / 2)
        cairo_line_to(cr, lwX + r.x2 * z / 2, lwY + r.y2 * z / 2)
        cairo_stroke(cr)
    NEXT

    ' Erledigte Stiche: Stoff halb darueber und ein Haken -- so sieht man, was
    ' noch zu sticken ist (PySticky blendet sie ebenso ab)
    IF z >= 4 THEN
        cairo_set_source_rgba(cr, 0.98, 0.98, 0.96, 0.62)
        DIM erl AS BOOLEAN
        FOR y = y0 TO y1
            FOR x = x0 TO x1
                i = y * b + x
                IF lwFertig[i] <> 0 AND lwFarbe[i] >= 0 THEN
                    cairo_rectangle(cr, lwX + x * z, lwY + y * z, z, z)
                    erl = TRUE
                END IF
            NEXT
        NEXT
        cairo_fill(cr)
        IF erl AND z >= 10 THEN
            cairo_set_source_rgba(cr, 0.15, 0.55, 0.25, 0.9)
            cairo_set_line_width(cr, MAX(1.5, z / 10))
            FOR y = y0 TO y1
                FOR x = x0 TO x1
                    i = y * b + x
                    IF lwFertig[i] <> 0 AND lwFarbe[i] >= 0 THEN
                        cairo_move_to(cr, lwX + (x + 0.25) * z, lwY + (y + 0.55) * z)
                        cairo_line_to(cr, lwX + (x + 0.42) * z, lwY + (y + 0.72) * z)
                        cairo_line_to(cr, lwX + (x + 0.78) * z, lwY + (y + 0.3) * z)
                    END IF
                NEXT
            NEXT
            cairo_stroke(cr)
        END IF
    END IF

    ' Die Form, die gerade gezogen wird, halb durchsichtig in der Farbe
    IF LEN(wzVorschau) > 0 AND wzFarbe >= 0 AND wzFarbe < lwMuster.farbanzahl() THEN
        DIM vf AS INTEGER : vf = lwRgb[wzFarbe]
        cairo_set_source_rgba(cr, ((vf SHR 16) BAND 255) / 255.0, ((vf SHR 8) BAND 255) / 255.0, (vf BAND 255) / 255.0, 0.6)
        DIM k AS INTEGER
        FOR k = 0 TO LEN(wzVorschau) - 2 STEP 2
            x = wzVorschau[k] : y = wzVorschau[k + 1]
            IF x < x0 OR x > x1 OR y < y0 OR y > y1 THEN CONTINUE
            cairo_rectangle(cr, lwX + x * z, lwY + y * z, z, z)
        NEXT
        cairo_fill(cr)
    END IF

    ' Auswahl, Lasso, Vieleck, Rueckstich, Fortschritt (ansicht/mehr.dh)
    mehrZeichnen(cr)

    ' Rahmen und die Zelle unter dem Zeiger
    cairo_set_line_width(cr, 1.0)
    cairo_set_source_rgb(cr, 0.55, 0.57, 0.62)
    cairo_rectangle(cr, lwX - 0.5, lwY - 0.5, b * z + 1, h * z + 1)
    cairo_stroke(cr)
    IF lwMausX >= 0 AND z >= 4 THEN
        cairo_set_line_width(cr, 2.0)
        cairo_set_source_rgb(cr, 0.0, 0.47, 0.83)
        cairo_rectangle(cr, lwX + lwMausX * z, lwY + lwMausY * z, z, z)
        cairo_stroke(cr)
    END IF
    RETURN TRUE
END FUNCTION

' Ein Kaestchen mit besonderem Stichtyp an (px, py), Groesse z.
SUB lwSonderstich(cr AS INTEGER, px AS FLOAT, py AS FLOAT, z AS FLOAT, t AS INTEGER, farbe AS INTEGER)
    cairoFarbe(cr, LW_STOFF)
    cairo_rectangle(cr, px, py, z, z)
    cairo_fill(cr)
    cairoFarbe(cr, farbe)
    IF kern.istTeilstich(t) THEN
        DIM p AS ARRAY OF FLOAT : p = kern.teilstichPunkte(t)
        DIM k AS INTEGER
        cairo_move_to(cr, px + p[0] * z, py + p[1] * z)
        FOR k = 2 TO LEN(p) - 1 STEP 2
            cairo_line_to(cr, px + p[k] * z, py + p[k + 1] * z)
        NEXT
        cairo_close_path(cr)
        cairo_fill(cr)
    ELSEIF t = kern.KNOTEN THEN
        cairo_arc(cr, px + z / 2, py + z / 2, z * kern.KNOTEN_RADIUS, 0, TAU)
        cairo_fill(cr)
    ELSEIF t = kern.PERLE THEN
        cairo_arc(cr, px + z / 2, py + z / 2, z * kern.PERLE_RADIUS, 0, TAU)
        cairo_fill(cr)
        cairo_set_source_rgba(cr, 1.0, 1.0, 1.0, 0.55)
        cairo_arc(cr, px + z * 0.40, py + z * 0.38, z * 0.10, 0, TAU)
        cairo_fill(cr)
    ELSEIF t = kern.DIAMANT THEN
        DIM rand AS FLOAT : rand = kern.diamantRand(z)
        cairo_rectangle(cr, px + rand, py + rand, z - 2 * rand, z - 2 * rand)
        cairo_fill(cr)
        cairo_set_source_rgba(cr, 1.0, 1.0, 1.0, 0.28)
        cairo_move_to(cr, px + rand, py + rand)
        cairo_line_to(cr, px + z - rand, py + rand)
        cairo_line_to(cr, px + z / 2, py + z / 2)
        cairo_close_path(cr)
        cairo_fill(cr)
    ELSE
        cairo_rectangle(cr, px, py, z, z)
        cairo_fill(cr)
    END IF
END SUB

' Die Symbole im sichtbaren Ausschnitt -- je Farbe einmal gemessen.
SUB lwSymbole(cr AS INTEGER, x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER)
    DIM z AS FLOAT : z = lwZelle
    DIM b AS INTEGER : b = lwMuster.breite
    DIM n AS INTEGER : n = lwMuster.farbanzahl()
    pango_font_description_set_absolute_size(lwSchrift, z * 0.62 * PANGO_SCALE)
    DIM layout AS INTEGER : layout = pango_cairo_create_layout(cr)
    pango_layout_set_font_description(layout, lwSchrift)
    DIM sb[n + 1] AS INTEGER
    DIM sh[n + 1] AS INTEGER
    DIM k AS INTEGER
    FOR k = 0 TO n - 1 : sb[k] = -1 : NEXT
    DIM x AS INTEGER, y AS INTEGER, c AS INTEGER, t AS INTEGER, letzte AS INTEGER
    letzte = -2
    FOR y = y0 TO y1
        FOR x = x0 TO x1
            c = lwFarbe[y * b + x]
            IF c < 0 OR c >= n THEN CONTINUE
            t = lwTyp[y * b + x]
            IF t = kern.KNOTEN OR t = kern.PERLE THEN CONTINUE
            pango_layout_set_text(layout, lwMuster.farben[c].symbol, -1)
            IF sb[c] < 0 THEN
                DIM wb AS INTEGER, wh AS INTEGER
                pango_layout_get_pixel_size(layout, wb, wh)
                sb[c] = wb : sh[c] = wh
            END IF
            ' Schwarz auf hellen, weiss auf dunklen Farben
            DIM schwarz AS INTEGER : schwarz = IIF(kern.helligkeit(lwRgb[c]) > 0.55, 1, 0)
            IF schwarz <> letzte THEN
                IF schwarz = 1 THEN cairo_set_source_rgb(cr, 0.0, 0.0, 0.0) ELSE cairo_set_source_rgb(cr, 1.0, 1.0, 1.0)
                letzte = schwarz
            END IF
            cairo_move_to(cr, lwX + x * z + (z - sb[c]) / 2, lwY + y * z + (z - sh[c]) / 2)
            pango_cairo_show_layout(cr, layout)
        NEXT
    NEXT
    g_object_unref(layout)
END SUB

' --- Maus ---------------------------------------------------------------------------
FUNCTION lwRad(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM px AS FLOAT, py AS FLOAT
    DIM ok AS BOOLEAN : ok = gdk_event_get_coords(ereignis, px, py)
    DIM richtung AS INTEGER
    ok = gdk_event_get_scroll_direction(ereignis, richtung)
    DIM schritt AS FLOAT
    IF richtung = GDK_RAD_HOCH THEN
        schritt = -1
    ELSEIF richtung = GDK_RAD_RUNTER THEN
        schritt = 1
    ELSE
        DIM dx AS FLOAT, dy AS FLOAT
        ok = gdk_event_get_scroll_deltas(ereignis, dx, dy)
        schritt = dy
    END IF
    IF schritt = 0 THEN RETURN TRUE
    leinwandZoom(lwZelle * 1.15 ^ (-schritt), px, py)
    RETURN TRUE
END FUNCTION

' Knopf und Umschalt aus einem Ereignis
FUNCTION lwTaste(ereignis AS INTEGER) AS INTEGER
    DIM k AS INTEGER
    IF NOT gdk_event_get_button(ereignis, k) THEN RETURN 0
    RETURN k
END FUNCTION
FUNCTION lwUmschalt(ereignis AS INTEGER) AS BOOLEAN
    DIM z AS INTEGER
    IF NOT gdk_event_get_state(ereignis, z) THEN RETURN FALSE
    RETURN (z BAND GDK_UMSCHALT) <> 0
END FUNCTION

' Der Rasterpunkt eines Rueckstichs (PySticky backstitch_tool._to_half_stitch):
' Zelle * 2 plus 0/1/2 je Drittel der Zelle -- Ecken, Kantenmitten und die
' Mitte; aufs Muster geklemmt.
SUB lwHalbRechnen(px AS FLOAT, py AS FLOAT)
    DIM rx AS FLOAT : rx = (px - lwX) / lwZelle
    DIM ry AS FLOAT : ry = (py - lwY) / lwZelle
    lwHalbGenauX = rx * 2
    lwHalbGenauY = ry * 2
    lwHalbX = CLAMP(lwHalbAchse(rx), 0, 2 * lwMuster.breite)
    lwHalbY = CLAMP(lwHalbAchse(ry), 0, 2 * lwMuster.hoehe)
END SUB

FUNCTION lwHalbAchse(r AS FLOAT) AS INTEGER
    DIM zelle AS INTEGER : zelle = FLOOR(r)
    DIM innen AS FLOAT : innen = r - zelle
    DIM s AS INTEGER : s = 2
    IF innen < 1.0 / 3 THEN
        s = 0
    ELSEIF innen < 2.0 / 3 THEN
        s = 1
    END IF
    RETURN zelle * 2 + s
END FUNCTION

FUNCTION lwDruck(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM px AS FLOAT, py AS FLOAT
    DIM ok AS BOOLEAN : ok = gdk_event_get_coords(ereignis, px, py)
    gtk_widget_grab_focus(lwFlaeche)
    IF lwHat THEN lwHalbRechnen(px, py)
    IF wzDruck(lwRohX(px), lwRohY(py), lwTaste(ereignis), lwUmschalt(ereignis)) = ZUG_HAND THEN
        lwZiehX = px
        lwZiehY = py
        lwZiehen = TRUE
    END IF
    RETURN TRUE
END FUNCTION

FUNCTION lwLoslassen(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM px AS FLOAT, py AS FLOAT
    DIM ok AS BOOLEAN : ok = gdk_event_get_coords(ereignis, px, py)
    lwZiehen = FALSE
    wzLos(lwRohX(px), lwRohY(py), lwUmschalt(ereignis))
    RETURN TRUE
END FUNCTION

FUNCTION lwBewegung(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM px AS FLOAT, py AS FLOAT
    DIM ok AS BOOLEAN : ok = gdk_event_get_coords(ereignis, px, py)
    IF lwHat THEN lwHalbRechnen(px, py)
    IF lwZiehen THEN
        lwX = lwX + (px - lwZiehX)
        lwY = lwY + (py - lwZiehY)
        lwZiehX = px
        lwZiehY = py
    ELSEIF wzZug <> ZUG_KEINER THEN
        DIM rx AS INTEGER : rx = lwRohX(px)
        DIM ry AS INTEGER : ry = lwRohY(py)
        IF rx <> wzLetzteX OR ry <> wzLetzteY THEN wzZiehen(rx, ry, lwUmschalt(ereignis))
    ELSEIF lwHat THEN
        mehrBewegung(lwRohX(px), lwRohY(py))
    END IF
    DIM mx AS INTEGER : mx = leinwandZelleX(px)
    DIM my AS INTEGER : my = leinwandZelleY(py)
    IF mx < 0 OR my < 0 THEN mx = -1 : my = -1
    IF lwZiehen OR mx <> lwMausX OR my <> lwMausY THEN
        lwMausX = mx
        lwMausY = my
        gtk_widget_queue_draw(lwFlaeche)
        statusNachziehen()
    END IF
    RETURN TRUE
END FUNCTION

FUNCTION lwVerlassen(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    IF lwMausX >= 0 THEN
        lwMausX = -1
        lwMausY = -1
        gtk_widget_queue_draw(lwFlaeche)
        statusNachziehen()
    END IF
    RETURN FALSE
END FUNCTION

' Der Mauszeiger passend zum Werkzeug.
SUB leinwandZeiger()
    IF lwFlaeche = 0 THEN RETURN
    DIM fenster AS INTEGER : fenster = gtk_widget_get_window(lwFlaeche)
    IF fenster = 0 THEN RETURN
    DIM name AS STRING
    SELECT CASE wzAktiv
        CASE WZ_HAND : name = "grab"
        CASE WZ_PIPETTE : name = "copy"
        CASE WZ_FUELLEN : name = "cell"
        CASE WZ_TEXT : name = "text"
        CASE WZ_AUSWAHL, WZ_LASSO : name = "crosshair"
        CASE WZ_FORTSCHRITT : name = "pointer"
        CASE ELSE : name = "crosshair"
    END SELECT
    DIM z AS INTEGER : z = gdk_cursor_new_from_name(gdk_display_get_default(), name)
    IF z = 0 THEN z = gdk_cursor_new_from_name(gdk_display_get_default(), "default")
    gdk_window_set_cursor(fenster, z)
END SUB

' Die Zelle (x, y) ins Bild holen, wenn sie draussen liegt (Fortschritt).
SUB leinwandZeigen(x AS INTEGER, y AS INTEGER)
    DIM bw AS FLOAT : bw = gtk_widget_get_allocated_width(lwFlaeche)
    DIM bh AS FLOAT : bh = gtk_widget_get_allocated_height(lwFlaeche)
    DIM px AS FLOAT : px = lwX + (x + 0.5) * lwZelle
    DIM py AS FLOAT : py = lwY + (y + 0.5) * lwZelle
    IF px < lwZelle OR px > bw - lwZelle OR py < lwZelle OR py > bh - lwZelle THEN
        lwX = bw / 2 - (x + 0.5) * lwZelle
        lwY = bh / 2 - (y + 0.5) * lwZelle
    END IF
    gtk_widget_queue_draw(lwFlaeche)
    statusNachziehen()
END SUB
