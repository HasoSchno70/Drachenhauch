n = AUDIO_NOISE(4000)
DIM ch AS AUDIO_CHANNEL
ch = AUDIO_PLAY(n, -1, 1.0)
DIM bands[16] AS FLOAT
DIM i AS INTEGER
DIM hoch AS FLOAT
DIM tief AS FLOAT
FOR i = 0 TO 40
    SLEEP(25)
    AUDIO_FFT(bands)
    DIM s AS FLOAT
    s = bands[4] + bands[5] + bands[6]
    IF s > hoch THEN hoch = s
    IF i = 0 OR s < tief THEN tief = s
NEXT
PRINT (hoch - tief) < 1.6
--- erwartet
TRUE

=== bus panning and auto pan are accepted
IMPORT "audio"
AUDIO_BUS_PAN("sfx", -1.0)
AUDIO_BUS_PAN("music", 0.5)
AUDIO_BUS_PAN("master", 0.0)
AUDIO_BUS_PAN("sfx", -9.0)
AUDIO_BUS_PAN("sfx", 9.0)
DIM lfo AS AUDIO_MOD
lfo = AUDIO_LFO_NEW("triangle", 0.5)
AUDIO_MODULATE("sfx", "pan", lfo, -1.0, 1.0)
AUDIO_MODULATE("music", "panning", lfo, -0.5, 0.5)
PRINT "ok"
--- erwartet
ok

=== bus pan rejects an unknown bus
IMPORT "audio"
AUDIO_BUS_PAN("gitarre", 0.0)
--- fehler
AUDIO_BUS_PAN: unbekannter Bus 'gitarre' (sfx, music, master)

=== modulation target list names the new targets
IMPORT "audio"
DIM m AS AUDIO_MOD
m = AUDIO_LFO_NEW("sine", 1.0)
AUDIO_MODULATE("sfx", "quatsch", m, 0.0, 1.0)
--- fehler
AUDIO_MODULATE: unbekanntes Ziel 'quatsch' -- erwartet volume/pan/filter/resonance/reverb/distortion

=== ohne modulator kehrt die lautstaerke zum festen wert zurueck
' AUDIO_MOD_REMOVE liess den Bus auf dem letzten Wert des Modulators
' stehen, und AUDIO_BUS_GET_VOLUME meldete trotzdem den festen (Buch
' "Kleine Wunder", Kapitel 18: Tremolo aus, der Bus blieb bei 94 %). Jetzt
' kommt der feste Wert zurueck. Der Tweener steht auf -1, also auf dem
' leisen Ende (0.1) -- anders als ein LFO haengt das nicht von der Zeit ab.
IMPORT "audio"
DIM leise AS AUDIO_MOD : leise = AUDIO_TWEENER_NEW(-1.0)
AUDIO_MODULATE("sfx", "volume", leise, 0.1, 1.0)
DIM ton AS SOUND : ton = AUDIO_TONE(440, 1000, "sine", 0.8)
DIM k AS AUDIO_CHANNEL : k = AUDIO_PLAY(ton, -1, 1.0)
SLEEP(100)
AUDIO_RECORD_START()
SLEEP(400)
AUDIO_MOD_REMOVE(leise)
SLEEP(400)
DIM auf AS SOUND : auf = AUDIO_RECORD_STOP()
AUDIO_STOP(k)
AUDIO_SAVE_WAV(auf, "zurueck.wav")
PRINT AUDIO_BUS_GET_VOLUME("sfx")
--- erwartet
1.0
--- ton zurueck.wav
pegel 50 300 < 0.12
pegel 550 750 > 0.7

=== eine tafel fuer die wellenformen
' AUDIO_TONE/NOTE/SFX und AUDIO_LFO_NEW lesen dieselbe Tafel: englisch und
' deutsch, "pulse" wie "square" (Bericht A14.1; bis 2026.53 drei Leser).
IMPORT "audio"
DIM s AS SOUND : s = AUDIO_TONE(440, 50, "rechteck", 0.5)
DIM n AS SOUND : n = AUDIO_NOTE("saege", 220, 100, 0, 0, 1.0, 0, 0.5)
DIM m AS AUDIO_MOD : m = AUDIO_LFO_NEW("pulse", 2.0)
PRINT "geht"
--- umgebung
DHRT_OHNE_AUDIO=1
--- erwartet
geht
