' Loesung zu Kapitel 17, Erfinden: eine Tapete. Das Fenster ist in
' acht Kacheln geteilt; jeder Strich wird um die Mitte seiner Kachel
' gedreht und gespiegelt und erscheint in allen acht. S sichert das
' Blatt als PNG -- ohne Hilfslinien, denn die stehen nicht darauf.
' Die Stellen, die neu sind, stehen zwischen >>> und <<<.
' >>> neu
IMPORT "imgfx"
' <<< neu
CONST BREITE = 800
CONST HOEHE = 500
CONST MITTE_X = BREITE / 2
CONST MITTE_Y = HOEHE / 2
CONST GRUND = &H0C0A18

SCREEN(BREITE, HOEHE, "Kaleidoskop")
' Das Blatt: ein Zeichenziel, das von Bild zu Bild stehen bleibt.
DIM blatt AS INTEGER : blatt = RENDERTARGET_NEW(BREITE, HOEHE, TRUE)
RENDERTARGET_CLEAR(blatt, GRUND)

DIM teile AS INTEGER : teile = 6
DIM spiegeln AS BOOLEAN : spiegeln = TRUE
DIM hilfe AS BOOLEAN : hilfe = TRUE
DIM dicke AS INTEGER : dicke = 4
DIM farbton AS FLOAT

' >>> neu
' Die Tapete: SPALTEN x ZEILEN Kacheln, jede mit einer eigenen Mitte.
CONST SPALTEN = 4
CONST ZEILEN = 2
CONST KACHEL_B = BREITE / SPALTEN
CONST KACHEL_H = HOEHE / ZEILEN

' Wie im Kapitel, nur mit der Mitte (mx, my) als Parameter.
SUB linie(mx AS FLOAT, my AS FLOAT, wa AS FLOAT, ra AS FLOAT, _
          wb AS FLOAT, rb AS FLOAT, farbe AS INTEGER)
    DIM xa AS FLOAT : xa = mx + ra * COS(wa)
    DIM ya AS FLOAT : ya = my + ra * SIN(wa)
    DIM xb AS FLOAT : xb = mx + rb * COS(wb)
    DIM yb AS FLOAT : yb = my + rb * SIN(wb)
    LINEW(xa, ya, xb, yb, dicke, farbe)
    CIRCLE(xb, yb, dicke / 2, farbe)
END SUB

' Die Mitte der Kachel, in der (x, y) liegt.
FUNCTION kachel_x(x AS FLOAT) AS FLOAT
    RETURN (CLAMP(FLOOR(x / KACHEL_B), 0, SPALTEN - 1) + 0.5) * KACHEL_B
END FUNCTION
FUNCTION kachel_y(y AS FLOAT) AS FLOAT
    RETURN (CLAMP(FLOOR(y / KACHEL_H), 0, ZEILEN - 1) + 0.5) * KACHEL_H
END FUNCTION

' Winkel und Abstand nimmt der Strich von der Mitte seiner Kachel;
' gezeichnet wird er dann um JEDE Mitte herum.
SUB strich(x1 AS FLOAT, y1 AS FLOAT, x2 AS FLOAT, y2 AS FLOAT, _
           farbe AS INTEGER)
    DIM mx AS FLOAT : mx = kachel_x(x1)
    DIM my AS FLOAT : my = kachel_y(y1)
    DIM w1 AS FLOAT : w1 = ATAN2(y1 - my, x1 - mx)
    DIM r1 AS FLOAT : r1 = HYPOT(x1 - mx, y1 - my)
    DIM w2 AS FLOAT : w2 = ATAN2(y2 - my, x2 - mx)
    DIM r2 AS FLOAT : r2 = HYPOT(x2 - mx, y2 - my)
    DIM sp AS INTEGER
    DIM ze AS INTEGER
    FOR ze = 0 TO ZEILEN - 1
        FOR sp = 0 TO SPALTEN - 1
            DIM cx AS FLOAT : cx = (sp + 0.5) * KACHEL_B
            DIM cy AS FLOAT : cy = (ze + 0.5) * KACHEL_H
            DIM k AS INTEGER
            FOR k = 0 TO teile - 1
                DIM dreh AS FLOAT : dreh = k * 2 * PI / teile
                linie(cx, cy, w1 + dreh, r1, w2 + dreh, r2, farbe)
                IF spiegeln THEN
                    linie(cx, cy, dreh - w1, r1, dreh - w2, r2, farbe)
                END IF
            NEXT
        NEXT
    NEXT
END SUB

' Die Hilfe: die Grenzen der Kacheln und ein Ring um jede Mitte.
SUB hilfe_zeichnen(x AS FLOAT, y AS FLOAT)
    DIM sp AS INTEGER
    FOR sp = 1 TO SPALTEN - 1
        LINE(sp * KACHEL_B, 0, sp * KACHEL_B, HOEHE, _
             RGBA(255, 255, 255, 40))
    NEXT
    DIM ze AS INTEGER
    FOR ze = 1 TO ZEILEN - 1
        LINE(0, ze * KACHEL_H, BREITE, ze * KACHEL_H, _
             RGBA(255, 255, 255, 40))
    NEXT
    CIRCLE_OUTLINE(kachel_x(x), kachel_y(y), 4, _
                   RGBA(255, 255, 255, 120))
    DIM zeile AS STRING : zeile = STR$(teile) + " Teile"
    IF spiegeln THEN zeile = zeile + ", gespiegelt"
    TEXT(10, 10, zeile + ", Dicke " + STR$(dicke) + ", S sichert", _
         RGBA(255, 255, 255, 160))
END SUB
' <<< neu

' Wo die Maus im letzten Bild war: Jeder Strich geht von dort nach hier.
DIM alt_x AS FLOAT : alt_x = MOUSE_X()
DIM alt_y AS FLOAT : alt_y = MOUSE_Y()
WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE)
    DIM x AS FLOAT : x = MOUSE_X()
    DIM y AS FLOAT : y = MOUSE_Y()

    ' Die Tasten: jede wirkt einmal, wenn sie heruntergeht.
    DIM n AS INTEGER
    FOR n = 2 TO 9
        IF KEY_HIT(STR$(n)) THEN teile = n
    NEXT
    IF KEY_HIT(KEY_M) THEN spiegeln = NOT spiegeln
    IF KEY_HIT(KEY_H) THEN hilfe = NOT hilfe
    ' >>> neu
    IF KEY_HIT(KEY_S) THEN
        DIM foto AS IMAGE : foto = RENDERTARGET_IMAGE(blatt)
        IMAGE_SAVE(foto, "tapete.png")
        IMAGE_FREE(foto)
    END IF
    ' <<< neu
    IF KEY_HIT(KEY_SPACE) THEN RENDERTARGET_CLEAR(blatt, GRUND)
    dicke = CLAMP(dicke + ROUND(MOUSE_WHEEL()), 1, 20)

    ' Malen: aufs Blatt, damit es bleibt. Die Farbe wandert durch den
    ' Farbkreis, solange man malt -- in drei Sekunden einmal herum.
    IF MOUSE_DOWN(0) THEN
        farbton = farbton + DELTA() * 120
        RENDERTARGET_BEGIN(blatt)
        strich(alt_x, alt_y, x, y, HSV(farbton, 0.7, 1))
        RENDERTARGET_END()
    END IF
    alt_x = x
    alt_y = y

    ' Jedes Bild: erst das Blatt, dann die Hilfe darueber -- die Hilfe
    ' ist im naechsten Bild wieder weg, das Blatt nicht.
    RENDERTARGET_DRAW(blatt, 0, 0)
    IF hilfe THEN hilfe_zeichnen(x, y)
    FLIP()
WEND
