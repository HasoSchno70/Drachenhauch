' Ein selbst gezeichnetes Widget (GUI_CUSTOM, gui_bedienung.rs
' `widget_keys` Kind::Eigen) in einem echten OS-Fenster: dort fuellen
' eingespielte Zeichen die Warteschlange des Fensters (nativfenster.rs,
' Art 6), und GUI_CUSTOM_TEXT$ liefert sie -- im Hauptfenster geht das
' nicht, eingespielte Tasten bringen dort keine Zeichen. Aufnahme wie in
' native_palette_inspektor.dhtest (Bild, Flaeche 1 = das erste echte
' Fenster, Art: 0 Maus, 1/2 Maustaste, 3/4 Taste, 6 Zeichen, 7 Fokus,
' 9 drinnen).
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

--- langsam
=== zeichen und tasten kommen im echten fenster beim eigenen widget an
IMPORT "gui"
SCREEN(500, 300, "Eigen-Haupt", 1)
SET_WINDOW_POS(-3000, -3000)
DIM h AS GUI_WINDOW : h = GUI_WINDOW("Haupt", 0, 0, 500, 300)
DIM d AS GUI_WINDOW : d = GUI_WINDOW("Eigen-Echt", 40, 40, 300, 200)
DIM c AS GUI_WIDGET : c = GUI_CUSTOM(d, 40, 40, 160, 60)
GUI_SET_TEXT(c, "Feld")
PRINT "nativ "; GUI_WINDOW_NATIVE(d, TRUE)
PRINT "ereignisse "; AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER
DIM text AS STRING
DIM links AS BOOLEAN
FOR n = 1 TO 40
    GUI_UPDATE()
    text = text + GUI_CUSTOM_TEXT$(c)
    IF GUI_CUSTOM_KEY(c) = KEY_LEFT THEN links = TRUE
    CLS(0) : GUI_DRAW() : FLIP()
NEXT
PRINT "fokus "; GUI_FOCUSED() = c; " text "; text; " links "; links
--- datei ev.txt
c 0
n 2 1 9 1 0
n 2 1 7 1 0
n 3 1 0 100 70
n 4 1 1 0 0
n 6 1 2 0 0
n 12 1 6 72 0
n 14 1 6 105 0
n 16 1 3 263 0
n 17 1 4 263 0

--- umgebung
DHRT_FRAMES=60
--- system windows
--- erwartet
nativ TRUE
ereignisse 9
fokus TRUE text Hi links TRUE
