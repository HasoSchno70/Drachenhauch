=== reiterseiten werden zu den kindern des reiterwerks
' Das Feld "reiter" nennt das Reiterwerk beim Namen; die Nummern in
' tabctl.kinder rechnet der Designer bei jeder Ansicht neu -- auch nach dem
' Loeschen, und ein umbenanntes Reiterwerk nimmt seine Kinder mit.
PRINT "kinder "; JSON_STRINGIFY(teilbaum(doc, "widgets.0.tabctl.kinder"))
auswahlSetzen(0)
inspektorFuellen()
PRINT "seiten sichtbar "; GUI_VISIBLE(aEintraege); " "; GUI_TEXT(aEintraege); " gezeigt "; GUI_TEXT(aSeite)
GUI_SET_TEXT(fName, "seiten")
GUI_SET_TEXT(aSeite, "2")
inspektorUebernehmen()
PRINT "umbenannt "; feldText$(1, "reiter"); " "; feldText$(2, "reiter"); " seite "; JSON_GET_INT(doc, "widgets.0.tabctl.seite")
PRINT "kinder "; JSON_STRINGIFY(teilbaum(doc, "widgets.0.tabctl.kinder"))
auswahlSetzen(1)
controlLoeschen()
PRINT "nach loeschen "; JSON_STRINGIFY(teilbaum(doc, "widgets.0.tabctl.kinder"))
' Der Code legt die Seiten an und ordnet zu -- und laeuft.
WRITEALL("code.dh", dhCode$())
DIM zeilen AS ARRAY OF STRING : zeilen = READLINES("code.dh")
DIM z AS STRING
FOR EACH z IN zeilen
    IF INSTR(z, "GUI_TABCONTROL_ADD") >= 0 THEN PRINT z
NEXT
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", "code.dh")
DIM bis AS INTEGER : bis = MILLIS() + 60000
DIM befund AS STRING : befund = ""
DIM stille AS INTEGER : stille = 0
WHILE MILLIS() < bis AND stille < 5
    DIM t AS STRING : t = PROCESS_READ$(pc)
    IF t <> "" THEN befund = befund + t : stille = 0
    IF t = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
WEND
PRINT "check " + TRIM$(befund)
DIM pb AS INTEGER : pb = PROCESS_START("dhrt", "bild", "code.dh", "code.png", "3")
bis = MILLIS() + 60000
WHILE PROCESS_RUNNING(pb) AND MILLIS() < bis
WEND
PRINT "lauf " + STR$(PROCESS_CODE(pb))
EXIT(0)
