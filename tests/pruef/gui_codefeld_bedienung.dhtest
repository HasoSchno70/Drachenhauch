=== ein rechtsklick in die auswahl laesst sie stehen
IMPORT "gui"
IMPORT "stelle.dh"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 280, 200)
GUI_SET_TEXT(ta, "aaaaaaa bbbbbbb ccccccc")
GUI_TEXTAREA_SELECT(ta, 1, 9, 1, 16)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 2 THEN klicks(ta, 1, 11, 1, 1)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "[" + GUI_TEXTAREA_SELECTION$(ta) + "]"
--- datei stelle.dh
FUNCTION stelle(ta AS GUI_WIDGET, z AS INTEGER, s AS INTEGER) AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM p AS TUPLE
    FOR y = 12 TO 208 STEP 2
        FOR x = 12 TO 280
            p = GUI_TEXTAREA_POS_AT(ta, x, y)
            IF p[0] = z AND p[1] = s THEN RETURN x * 10000 + y
        NEXT
    NEXT
    RETURN -1
END FUNCTION
SUB klicks(ta AS GUI_WIDGET, z AS INTEGER, s AS INTEGER, n AS INTEGER, k AS INTEGER)
    DIM p AS INTEGER : p = stelle(ta, z, s)
    DIM x AS INTEGER : x = p \ 10000
    DIM y AS INTEGER : y = p MOD 10000
    DIM a AS STRING : a = "e 0 7 " + STR$(x) + " " + STR$(y) + " 0 0" + CHR$(10)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        a = a + "e " + STR$(1 + 2 * i) + " 6 " + STR$(k) + " 0 0 0" + CHR$(10)
        a = a + "e " + STR$(2 + 2 * i) + " 5 " + STR$(k) + " 0 0 0" + CHR$(10)
    NEXT
    WRITEALL("ev.txt", "c " + STR$(1 + 2 * n) + CHR$(10) + a)
    AUTOMATION_PLAY("ev.txt")
END SUB

