' Kapitel 17, Schritt 1 -- das kleinste Malprogramm: mit gedrueckter
' Maustaste malen, die Leertaste wischt das Blatt.
CONST BREITE = 800
CONST HOEHE = 500

SCREEN(BREITE, HOEHE, "Malen")
' Das Blatt: TRUE heisst, es bleibt von Bild zu Bild stehen.
DIM blatt AS INTEGER : blatt = RENDERTARGET_NEW(BREITE, HOEHE, TRUE)

' Wo die Maus im letzten Bild war.
DIM alt_x AS FLOAT : alt_x = MOUSE_X()
DIM alt_y AS FLOAT : alt_y = MOUSE_Y()
WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE)
    DIM x AS FLOAT : x = MOUSE_X()
    DIM y AS FLOAT : y = MOUSE_Y()
    IF KEY_HIT(KEY_SPACE) THEN RENDERTARGET_CLEAR(blatt, RGB(0, 0, 0))
    IF MOUSE_DOWN(0) THEN
        RENDERTARGET_BEGIN(blatt)
        LINEW(alt_x, alt_y, x, y, 6, RGB(255, 200, 60))
        RENDERTARGET_END()
    END IF
    alt_x = x
    alt_y = y

    RENDERTARGET_DRAW(blatt, 0, 0)
    FLIP()
WEND
