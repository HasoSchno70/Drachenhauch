=== zeile gewichte teilen den restplatz
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM z AS GUI_WIDGET : z = GUI_LAYOUT(w, "zeile", 10, 10, 400, 40)
GUI_LAYOUT_SET(z, "abstand", 0)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 40, 30)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "B", 0, 0, 100, 30)
DIM c AS GUI_WIDGET : c = GUI_BUTTON(w, "C", 0, 0, 50, 30)
GUI_LAYOUT_ADD(z, a) : GUI_LAYOUT_ADD(z, b, 1) : GUI_LAYOUT_ADD(z, c, 3)
GUI_UPDATE()
PRINT GUI_GET_X(a) ; " " ; GUI_GET_Y(a) ; " " ; GUI_GET_W(a) ; " " ; GUI_GET_H(a)
PRINT GUI_GET_X(b) ; " " ; GUI_GET_Y(b) ; " " ; GUI_GET_W(b) ; " " ; GUI_GET_H(b)
PRINT GUI_GET_X(c) ; " " ; GUI_GET_Y(c) ; " " ; GUI_GET_W(c) ; " " ; GUI_GET_H(c)
--- umgebung
DHRT_FRAMES=2
--- erwartet
10 10 40 40
50 10 90 40
140 10 270 40

