DIM lblAusgabe AS GUI_WIDGET : lblAusgabe = GUI_LABEL(win, "Ausgabe", 0, 0)
DIM lstAusgabe AS GUI_WIDGET : lstAusgabe = GUI_LISTBOX(win, 0, 0, 10, 10, [])
DIM lblProbleme AS GUI_WIDGET : lblProbleme = GUI_LABEL(win, "Probleme", 0, 0)
DIM lstProbleme AS GUI_WIDGET : lstProbleme = GUI_LISTBOX(win, 0, 0, 10, 10, [])
DIM lblHilfe AS GUI_WIDGET : lblHilfe = GUI_LABEL(win, "", 0, 0)
DIM lblStatus AS GUI_WIDGET : lblStatus = GUI_LABEL(win, "Bereit.", 0, 0)
DIM tfEingabe AS GUI_WIDGET : tfEingabe = GUI_TEXTINPUT(win, 0, 0, 10, 26, "Eingabe fuer das laufende Programm -- Enter schickt")
DIM btnEingabe AS GUI_WIDGET : btnEingabe = GUI_BUTTON(win, "Senden", 0, 0, 80, 26)

' Vervollstaendigung: ein kleines Fenster mit Liste, sonst unsichtbar.
DIM winVervoll AS GUI_WINDOW : winVervoll = GUI_WINDOW("Vervollstaendigen", 400, 200, 320, 240)
DIM lstVervoll AS GUI_WIDGET : lstVervoll = GUI_LISTBOX(winVervoll, 6, 6, 300, 200, [])
GUI_WINDOW_VISIBLE(winVervoll, FALSE)
DIM vervollPraefixLaenge AS INTEGER : vervollPraefixLaenge = 0
DIM vervollOffen AS BOOLEAN : vervollOffen = FALSE

' Debugger: Variablen und die Schritt-Knoepfe rechts unten IM Hauptfenster,
' anstelle der Problemliste, solange der Debugger laeuft. Ein eigenes Fenster
' laege hinter dem bildschirmfuellenden Hauptfenster, und Kuerzel gelten nur
' im Fenster mit Fokus -- F8/F10 waeren dort tot.
DIM lblDebug AS GUI_WIDGET : lblDebug = GUI_LABEL(win, "", 0, 0)
DIM btnWeiter AS GUI_WIDGET : btnWeiter = GUI_BUTTON(win, "Weiter (F8)", 0, 0, 100, 26)
DIM btnDrueber AS GUI_WIDGET : btnDrueber = GUI_BUTTON(win, "Drueber (F10)", 0, 0, 108, 26)
DIM btnHinein AS GUI_WIDGET : btnHinein = GUI_BUTTON(win, "Hinein (F11)", 0, 0, 104, 26)
DIM btnHeraus AS GUI_WIDGET : btnHeraus = GUI_BUTTON(win, "Heraus", 0, 0, 70, 26)
DIM btnStoppD AS GUI_WIDGET : btnStoppD = GUI_BUTTON(win, "Stopp", 0, 0, 60, 26)
DIM tblVars AS GUI_WIDGET : tblVars = GUI_TABLE(win, 0, 0, 10, 10)
GUI_TABLE_HEADERS(tblVars, ["Name", "Typ", "Wert", "Bereich"])
GUI_TABLE_COL_WIDTHS(tblVars, [140, 90, 260, 70])
DIM debugSichtbar AS BOOLEAN : debugSichtbar = FALSE

' Profil: die Zeilen nach Zeit, ein Klick springt hin.
DIM winProfil AS GUI_WINDOW : winProfil = GUI_WINDOW("Profil", 600, 60, 640, 460)
DIM lblProfil AS GUI_WIDGET : lblProfil = GUI_LABEL(winProfil, "", 8, 6)
