' A canvas and a timer: the timer moves the ball, the event Zeichnen paints
' it (every frame), dragging on the canvas puts it there. Drawing happens in
' screen coordinates -- GUI_CANVAS_X/Y say where the canvas is, and it grows
' with the window.
CONST RADIUS = 12

CLASS MainWindow EXTENDS MainWindow_Basis
    DIM x AS FLOAT
    DIM y AS FLOAT
    DIM vx AS FLOAT
    DIM vy AS FLOAT
    DIM bounces AS INTEGER

    SUB Geoeffnet()
        Self.x = 100.0
        Self.y = 80.0
        Self.vx = 3.0
        Self.vy = 2.2
    END SUB

    SUB ticker_Aktion()
        DIM b AS INTEGER : b = GUI_CANVAS_W(Self.canvas)
        DIM h AS INTEGER : h = GUI_CANVAS_H(Self.canvas)
        Self.x = Self.x + Self.vx
        Self.y = Self.y + Self.vy
        IF Self.x < RADIUS OR Self.x > b - RADIUS THEN
            Self.vx = -Self.vx
            Self.bounces = Self.bounces + 1
        END IF
        IF Self.y < RADIUS OR Self.y > h - RADIUS THEN
            Self.vy = -Self.vy
            Self.bounces = Self.bounces + 1
        END IF
        Self.x = CLAMP(Self.x, RADIUS, MAX(RADIUS, b - RADIUS))
        Self.y = CLAMP(Self.y, RADIUS, MAX(RADIUS, h - RADIUS))
        GUI_SET_TEXT(Self.bounceLabel, "Bounces: " + STR$(Self.bounces))
    END SUB

    SUB canvas_Zeichnen()
        DIM ox AS INTEGER : ox = GUI_CANVAS_X(Self.canvas)
        DIM oy AS INTEGER : oy = GUI_CANVAS_Y(Self.canvas)
        BOX(ox, oy, ox + GUI_CANVAS_W(Self.canvas) - 1, oy + GUI_CANVAS_H(Self.canvas) - 1, RGB(22, 28, 42))
        CIRCLE(ox + INT(Self.x), oy + INT(Self.y), RADIUS, RGB(255, 170, 40))
    END SUB

    SUB canvas_Ziehen(x AS INTEGER, y AS INTEGER)
        Self.x = x
        Self.y = y
    END SUB

    SUB buttonStart_Klick()
        IF Self.ticker.Aktiv THEN
            Self.ticker.Stoppen()
            GUI_SET_TEXT(Self.buttonStart, "Resume")
        ELSE
            Self.ticker.Starten()
            GUI_SET_TEXT(Self.buttonStart, "Pause")
        END IF
    END SUB
END CLASS
