' Kuehlschrank-App im Drachenhauch Studio, Stufe 3: der Einkauf
' (examples/studio/kuehlschrank: EinkaufSeite, AbschlussFenster, Bericht
' Einkaufszettel mit der Abfrage Zettelzeilen, Modul Einkauf, Klasse Posten).
' Proben wie in Stufe 1 und 2: F5 im Studio, dann main.dh mit einer Probe
' statt der Bildschleife; Heute ist fest.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== liste, gangplan, gaenge als ueberschrift, nach markt
' Gang wie StoreLayoutManager: die Kategorie steht im Plan (Obst), eine
' Abteilung steckt in der Kategorie (Fleisch & Wurst -> Wurst, neu), eine
' Abteilung im Namen (Tiefkuehlpizza -> Tiefkuehl), sonst ans Ende. Ein
' eigener Plan aus store_layouts geht dem eingebauten vor.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO products (name, brand) VALUES ('Bananen', 'Chiquita'), ('Salami', NULL)")
DB_EXEC(db, "INSERT INTO product_stores (product_id, store_name, last_purchased) VALUES (1, 'ALDI', '2026-10-01'), (1, 'REWE', '2026-11-01'), (2, 'LIDL', '2026-11-02')")
DB_EXEC(db, "INSERT INTO store_layouts (store_name, layout_json) VALUES ('Mein Laden', '{" + CHR$(34) + "Obst" + CHR$(34) + ": 4, " + CHR$(34) + "Fleisch" + CHR$(34) + ": 1}')")
DB_EXEC(db, "INSERT INTO shopping_list (product_name, quantity, unit, category, notes, checked, priority) VALUES " + _
    "('Bananen', 6, 'Stück', 'Obst', NULL, 0, 1), ('Tiefkühlpizza', 2, 'Stück', NULL, 'die mit Salami', 0, 1), " + _
    "('Salami', 1, 'Stück', 'Fleisch & Wurst', NULL, 0, 1), ('Brot', 1, 'Stück', 'Backwaren', NULL, 1, 1), " + _
    "('Seife', 0, 'Stück', NULL, NULL, 0, 1), ('Milch', 2, 'Liter', 'Milchprodukte', 'Auto', 0, 3)")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS EinkaufSeite : s = f.einkauf
s.maerkteFuellen()
f.geaendert()
SUB zeilen(s AS EinkaufSeite)
    DIM z AS INTEGER
    FOR z = 0 TO GUI_TABLE_ROW_COUNT(s.tabelle) - 1
        IF s.ids[z] = 0 THEN
            PRINT "  # "; GUI_TABLE_GET_CELL(s.tabelle, z, 1)
            CONTINUE
        END IF
        PRINT "  "; IIF(GUI_TABLE_GET_VALUE(s.tabelle, z, SP_HAKEN) > 0.5, "x", "."); " "; GUI_TABLE_GET_CELL(s.tabelle, z, 1); " | "; GUI_TABLE_GET_CELL(s.tabelle, z, 2); " | "; GUI_TABLE_GET_CELL(s.tabelle, z, 3); " | "; GUI_TABLE_GET_CELL(s.tabelle, z, 4); " | "; GUI_TABLE_GET_CELL(s.tabelle, z, 5)
    NEXT
    PRINT "  "; GUI_TEXT(s.statistik)
END SUB
zeilen(s)
PRINT "maerkte "; JOIN$(marktListe(), ", ")
GUI_DROPDOWN_SET_SELECTED(s.marktWahl, ARRAY_INDEXOF(marktListe(), "LIDL") + 1)
s.marktWahl_Geaendert()
PRINT "gewaehlt "; gewaehlterMarkt$(); " | "; GUI_TEXT(s.marktHinweis)
GUI_SET_CHECKED(s.sortierKasten, TRUE)
s.sortierKasten_Geaendert()
PRINT "nach gang"
zeilen(s)
GUI_SET_CHECKED(s.gruppierKasten, TRUE)
s.gruppierKasten_Geaendert()
PRINT "mit ueberschrift"
zeilen(s)
GUI_DROPDOWN_SET_SELECTED(s.marktWahl, ARRAY_INDEXOF(marktListe(), "Mein Laden") + 1)
s.marktWahl_Geaendert()
GUI_SET_CHECKED(s.gruppierKasten, FALSE)
s.gruppierKasten_Geaendert()
PRINT "eigener plan | "; GUI_TEXT(s.marktHinweis)
zeilen(s)
PRINT "nach markt"
PRINT nachMarkt$()
