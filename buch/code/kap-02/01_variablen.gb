' Die vier Grundtypen demonstriert.
'
' INTEGER speichert Ganzzahlen, FLOAT Kommazahlen, STRING Text,
' BOOLEAN nur TRUE oder FALSE.

DIM punkte AS INTEGER
DIM zeit   AS FLOAT
DIM name   AS STRING
DIM aktiv  AS BOOLEAN

punkte = 100
zeit   = 12.5
name   = "Pilot Anna"
aktiv  = TRUE

PRINT "Punkte:", punkte
PRINT "Zeit:  ", zeit
PRINT "Name:  ", name
PRINT "Aktiv: ", aktiv
