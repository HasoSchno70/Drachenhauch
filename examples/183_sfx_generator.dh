' ============================================================
'  DRACHENHAUCH -- SFX-Generator
' ============================================================
'  Ein vollstaendiges Werkzeug im sfxr-Stil, geschrieben IN Drachenhauch
'  auf dem eigenen gui-Modul.
'
'  Bedienung:
'    Links eine Vorlage waehlen -- [Zufall] wuerfelt einen neuen Klang
'    DIESER Art (ein Laser bleibt ein Laser), [Mutieren] veraendert den
'    jetzigen nur ein wenig. Die Regler darunter stellen alles einzeln ein,
'    die Huellkurve laesst sich auch IN der Wellenform an ihren drei
'    Punkten ziehen. Ein Klick in die Wellenform oder die Leertaste spielt.
'    Darunter steht der Verlauf: jeder Schritt mit Namen, ein Klick holt ihn
'    zurueck. Alles ist auch ohne Maus bedienbar: TAB wechselt das
'    Bedienelement, die Pfeile verstellen Regler.
'
'  Ausgabe (Menue Datei oder die Werkzeugleiste):
'    WAV sichern       schreibt eine Datei, die LOADSOUND direkt laedt.
'    DH-Code kopieren  legt den fertigen AUDIO_SFX-Aufruf in die
'                      Zwischenablage -- der Weg vom Klang ins Programm.
'    Sichern/Oeffnen   alle Regler als `.ini` -- lesbar und von Hand
'                      aenderbar.
'
'  Zurueck/Vor (Strg+Z, Strg+Y) nehmen eine Aenderung zurueck. EIN Zug am
'  Regler ist EIN Schritt -- nicht 60 pro Sekunde.
' ============================================================
IMPORT "gui"
IMPORT "audio"
IMPORT "ini"

' --- Parameter: EINE Reihenfolge fuer Regler, Werkseinstellungen und ---
' --- den AUDIO_SFX-Aufruf. Zwei Listen waeren zwei Stellen zum Irren. -
CONST P_FREQ    = 0
CONST P_SLIDE   = 1
CONST P_VOL     = 2
CONST P_ATTACK  = 3
CONST P_SUSTAIN = 4
CONST P_DECAY   = 5
CONST P_DUTY    = 6
CONST P_PWM_D   = 7
CONST P_PWM_S   = 8
CONST P_CUTOFF  = 9
CONST P_SWEEP   = 10
CONST P_RES     = 11
CONST P_VIB_D   = 12
CONST P_VIB_S   = 13
CONST P_BREITE  = 14
CONST P_PAN     = 15
CONST N_PARAM   = 16

DIM regler[N_PARAM] AS GUI_WIDGET      ' der Schieber
DIM wertText[N_PARAM] AS GUI_WIDGET    ' die Zahl daneben
DIM nachkomma[N_PARAM] AS INTEGER      ' wie viele Stellen zeigen?
' Der Schluessel in der gesicherten Datei. Bewusst die ALTE Schreibweise
' ohne Umlaut ("Lautstaerke") -- sonst gingen Dateien von frueher an dieser
' Stelle stumm verloren. Angezeigt wird `anzeige`.
DIM parName[N_PARAM] AS STRING
DIM anzeige[N_PARAM] AS STRING
DIM einheit[N_PARAM] AS STRING
DIM letzter[N_PARAM] AS FLOAT          ' Stand des letzten Bildes
DIM reglerLo[N_PARAM] AS FLOAT
DIM reglerHi[N_PARAM] AS FLOAT

DIM wellenformen AS ARRAY OF STRING
wellenformen = SPLIT$("square|saw|sine|triangle|noise", "|")

SCREEN(1440, 860, "Drachenhauch - SFX-Generator", 1)
WINDOW_RESIZABLE(TRUE)
WINDOW_MIN_SIZE(1240, 780)
SETFPS(60)
GUI_THEME_PRESET("glas_dunkel")

' Eine echte Schrift statt der eingebauten Pixelschrift: DejaVu Sans, in
' dhrt eingebettet -- also auf jedem System dieselbe. Gross geladen, klein
' gezeichnet: so bleibt sie scharf.
' Dazu die paar Zeichen, die nicht im Grundvorrat stehen (Abspielen-Dreieck).
DIM uiFont AS INTEGER : uiFont = LOADFONT("sans", 32, "▶■")
SETFONT(uiFont, 15)

DIM win AS GUI_WINDOW
win = GUI_WINDOW("SFX-Generator", 0, 0, SCREENWIDTH(), SCREENHEIGHT())
GUI_WINDOW_CHROME(win, FALSE)
GUI_WINDOW_MOVABLE(win, FALSE)

' ============================================================
'  Menue -- jeder Befehl mit Kuerzel; die Werkzeugleiste darunter ruft
'  dieselben Befehle (eine Stelle: `befehl`).
' ============================================================
DIM mDatei AS INTEGER : mDatei = GUI_MENU(win, "Datei")
DIM miLaden AS INTEGER : miLaden = GUI_MENU_ITEM(mDatei, "Einstellung öffnen …", "Strg+O")
DIM miSichern AS INTEGER : miSichern = GUI_MENU_ITEM(mDatei, "Einstellung sichern …", "Strg+S")
GUI_MENU_SEPARATOR(mDatei)
DIM miWav AS INTEGER : miWav = GUI_MENU_ITEM(mDatei, "Als WAV sichern …", "Strg+E")
DIM miCode AS INTEGER : miCode = GUI_MENU_ITEM(mDatei, "DH-Code kopieren", "Strg+Umschalt+C")
GUI_MENU_SEPARATOR(mDatei)
DIM miEnde AS INTEGER : miEnde = GUI_MENU_ITEM(mDatei, "Beenden", "Strg+Q")

DIM mBearb AS INTEGER : mBearb = GUI_MENU(win, "Bearbeiten")
DIM miZurueck AS INTEGER : miZurueck = GUI_MENU_ITEM(mBearb, "Rückgängig", "Strg+Z")
DIM miVor AS INTEGER : miVor = GUI_MENU_ITEM(mBearb, "Wiederholen", "Strg+Y")
GUI_MENU_SEPARATOR(mBearb)
DIM miZufall AS INTEGER : miZufall = GUI_MENU_ITEM(mBearb, "Zufall dieser Art", "R")
DIM miMutieren AS INTEGER : miMutieren = GUI_MENU_ITEM(mBearb, "Mutieren", "M")

DIM mKlang AS INTEGER : mKlang = GUI_MENU(win, "Klang")
DIM miPlay AS INTEGER : miPlay = GUI_MENU_ITEM(mKlang, "Abspielen", "Leertaste")
DIM miStopp AS INTEGER : miStopp = GUI_MENU_ITEM(mKlang, "Anhalten", "Umschalt+Leertaste")

' Erst NACH der Menueleiste steht fest, wie gross der Inhaltsbereich ist.
DIM CW AS INTEGER : CW = GUI_WINDOW_CONTENT_W(win)
DIM CH AS INTEGER : CH = GUI_WINDOW_CONTENT_H(win)

' ============================================================
'  Werkzeugleiste
' ============================================================
DIM leiste AS GUI_WIDGET : leiste = GUI_TOOLBAR(win, 0, 0, CW, 42)
GUI_SET_ANCHOR(leiste, "lrt")
GUI_TOOLBAR_SET(leiste, "beschriftung", 1)
DIM tbLaden AS INTEGER : tbLaden = GUI_TOOLBAR_ADD(leiste, "oeffnen", "Einstellung öffnen (Strg+O)", "Öffnen")
DIM tbSichern AS INTEGER : tbSichern = GUI_TOOLBAR_ADD(leiste, "sichern", "Einstellung sichern (Strg+S)", "Sichern")
GUI_TOOLBAR_SEPARATOR(leiste)
DIM tbWav AS INTEGER : tbWav = GUI_TOOLBAR_ADD(leiste, "export", "Als WAV sichern (Strg+E)", "WAV")
DIM tbCode AS INTEGER : tbCode = GUI_TOOLBAR_ADD(leiste, "kopieren", "Den AUDIO_SFX-Aufruf in die Zwischenablage (Strg+Umschalt+C)", "DH-Code")
GUI_TOOLBAR_SEPARATOR(leiste)
DIM tbPlay AS INTEGER : tbPlay = GUI_TOOLBAR_ADD(leiste, "start", "Abspielen (Leertaste)", "Abspielen")
DIM tbStopp AS INTEGER : tbStopp = GUI_TOOLBAR_ADD(leiste, "stopp", "Anhalten (Umschalt+Leertaste)", "Stopp")
GUI_TOOLBAR_SEPARATOR(leiste)
DIM tbZurueck AS INTEGER : tbZurueck = GUI_TOOLBAR_ADD(leiste, "rueckgaengig", "Die letzte Änderung zurücknehmen (Strg+Z)", "Zurück")
DIM tbVor AS INTEGER : tbVor = GUI_TOOLBAR_ADD(leiste, "wiederholen", "Wiederherstellen (Strg+Y)", "Vor")

' ============================================================
'  Statusleiste: Meldung | Dauer und Wellenform | Verlaufsschritt
' ============================================================
DIM lblStatus AS GUI_WIDGET : lblStatus = GUI_STATUSBAR(win, 0, CH - 26, CW, 26, "Bereit.")
GUI_SET_ANCHOR(lblStatus, "lrb")
DIM sfDauer AS INTEGER : sfDauer = GUI_STATUSBAR_ADD(lblStatus, "", 260, "mitte")
DIM sfSchritt AS INTEGER : sfSchritt = GUI_STATUSBAR_ADD(lblStatus, "", 150, "mitte")

' ============================================================
'  Linke Spalte: Vorlagen samt Zufall/Mutieren, darunter der Verlauf
' ============================================================
CONST LINKS_X = 14
CONST LINKS_B = 300
DIM lblPresets AS GUI_WIDGET
lblPresets = GUI_LABEL(win, "Vorlagen", LINKS_X, 54)
GUI_SET_FONT_STYLE(lblPresets, "fett")
DIM presetNamen AS ARRAY OF STRING
presetNamen = SPLIT$("Münze|Laser|Explosion|Powerup|Treffer|Sprung|Blip|Motor|Schuss|Klick|Glocke|Alarm", "|")
CONST N_PRESET = 12
DIM liste AS GUI_WIDGET
liste = GUI_LISTBOX(win, LINKS_X, 78, LINKS_B, 22 * N_PRESET + 6, presetNamen)
GUI_TOOLTIP(liste, "Ein Klick setzt alle Regler auf die Vorlage")

DIM knopfZufall AS GUI_WIDGET
knopfZufall = GUI_BUTTON(win, "Zufall", LINKS_X, 78 + 22 * N_PRESET + 16, 146, 32)
GUI_BUTTON_VARIANT(knopfZufall, "primaer")
GUI_TOOLTIP(knopfZufall, "Einen neuen Klang der gewählten Art würfeln (R)")
DIM knopfMutieren AS GUI_WIDGET
knopfMutieren = GUI_BUTTON(win, "Mutieren", LINKS_X + 154, 78 + 22 * N_PRESET + 16, 146, 32)
GUI_TOOLTIP(knopfMutieren, "Den jetzigen Klang nur ein wenig verändern (M)")

DIM VERLAUF_Y AS INTEGER : VERLAUF_Y = 78 + 22 * N_PRESET + 66
DIM lblVerlauf AS GUI_WIDGET
lblVerlauf = GUI_LABEL(win, "Verlauf", LINKS_X, VERLAUF_Y)
GUI_SET_FONT_STYLE(lblVerlauf, "fett")
DIM listVerlauf AS GUI_WIDGET
listVerlauf = GUI_LISTBOX(win, LINKS_X, VERLAUF_Y + 24, LINKS_B, CH - 26 - 12 - (VERLAUF_Y + 24), [])
GUI_SET_ANCHOR(listVerlauf, "ltb")
GUI_TOOLTIP(listVerlauf, "Jeder Schritt mit Namen -- ein Klick holt ihn zurück")

' ============================================================
'  Rechts: Wellenform, Transport, drei Spalten mit Reglern
' ============================================================
CONST RX = 330
DIM RW AS INTEGER : RW = CW - RX - 14
CONST GRUPPE_H = 300
DIM GY AS INTEGER : GY = CH - 26 - 12 - GRUPPE_H
DIM TY AS INTEGER : TY = GY - 46

DIM flaeche AS GUI_WIDGET
flaeche = GUI_CANVAS(win, RX, 54, RW, TY - 54 - 10)
GUI_SET_ANCHOR(flaeche, "lrtb")
GUI_TOOLTIP(flaeche, "Klick = abspielen. Die drei Punkte der Hüllkurve lassen sich ziehen.")

DIM knopfPlay AS GUI_WIDGET
knopfPlay = GUI_BUTTON(win, "▶  Abspielen", RX, TY, 160, 34)
GUI_BUTTON_VARIANT(knopfPlay, "erfolg")
GUI_SET_ANCHOR(knopfPlay, "lb")
DIM autoPlay AS GUI_WIDGET
autoPlay = GUI_CHECKBOX(win, "Auto-Play", RX + 166, TY + 7, TRUE)
GUI_TOOLTIP(autoPlay, "Spielt selbst, sobald ein Regler zur Ruhe kommt")
GUI_SET_ANCHOR(autoPlay, "lb")
DIM knopfBits AS GUI_WIDGET
knopfBits = GUI_CHECKBOX(win, "WAV mit 8 Bit (Lo-Fi)", RX + 290, TY + 7)
GUI_TOOLTIP(knopfBits, "Halb so groß, mehr Rauschen -- der Retro-Klang")
GUI_SET_ANCHOR(knopfBits, "lb")

DIM SPALTE_B AS INTEGER : SPALTE_B = (RW - 28) \ 3
DIM SX1 AS INTEGER : SX1 = RX
DIM SX2 AS INTEGER : SX2 = RX + SPALTE_B + 14
DIM SX3 AS INTEGER : SX3 = RX + 2 * (SPALTE_B + 14)

DIM g1 AS GUI_WIDGET : g1 = GUI_GROUPBOX(win, SX1, GY, SPALTE_B, 160, "Ton")
DIM g2 AS GUI_WIDGET : g2 = GUI_GROUPBOX(win, SX1, GY + 170, SPALTE_B, 130, "Hüllkurve")
DIM g3 AS GUI_WIDGET : g3 = GUI_GROUPBOX(win, SX2, GY, SPALTE_B, 220, "SID / Filter")
DIM g4 AS GUI_WIDGET : g4 = GUI_GROUPBOX(win, SX3, GY, SPALTE_B, 160, "Vibrato / Stereo")
GUI_SET_ANCHOR(g1, "lb") : GUI_SET_ANCHOR(g2, "lb") : GUI_SET_ANCHOR(g3, "lb") : GUI_SET_ANCHOR(g4, "lb")
DIM lblWave AS GUI_WIDGET
lblWave = GUI_LABEL(win, "Wellenform", SX1 + 12, GY + 32)
GUI_SET_ANCHOR(lblWave, "lb")
DIM waehlWave AS GUI_WIDGET
waehlWave = GUI_DROPDOWN(win, SX1 + 128, GY + 28, 150, 26, wellenformen)
GUI_SET_ANCHOR(waehlWave, "lb")

' Einen Regler samt Beschriftung und Zahl anlegen. Liefert nichts zurueck
' -- die Felder liegen unter `idx` in den Arrays, und genau dieser Index ist
' auch die Stelle im AUDIO_SFX-Aufruf. `zeile` zaehlt in der Gruppe ab 0.
SUB machRegler(idx AS INTEGER, schluessel AS STRING, name AS STRING, x AS INTEGER, zeile AS INTEGER, _
               lo AS FLOAT, hi AS FLOAT, vorgabe AS FLOAT, _
               stellen AS INTEGER, mass AS STRING, tipp AS STRING)
    DIM y AS INTEGER : y = GY + 30 + zeile * 30
    DIM l AS GUI_WIDGET
    l = GUI_LABEL(win, name, x + 12, y + 3)
    GUI_SET_ANCHOR(l, "lb")
    GUI_TOOLTIP(l, tipp)
    regler[idx] = GUI_SLIDER(win, x + 128, y, SPALTE_B - 128 - 92, lo, hi, vorgabe)
    GUI_SET_ANCHOR(regler[idx], "lb")
    GUI_TOOLTIP(regler[idx], tipp)
    wertText[idx] = GUI_LABEL(win, "", x + SPALTE_B - 84, y + 3)
    GUI_SET_ANCHOR(wertText[idx], "lb")
    nachkomma[idx] = stellen
    parName[idx] = schluessel
    anzeige[idx] = name
    einheit[idx] = mass
    letzter[idx] = vorgabe
    reglerLo[idx] = lo
    reglerHi[idx] = hi
END SUB

machRegler(P_FREQ,    "Frequenz", "Frequenz", SX1, 1, 50, 8000, 800, 0, " Hz", "Anfangstonhöhe")
machRegler(P_SLIDE,   "Pitch-Slide", "Tonrutsch", SX1, 2, -8000, 8000, 0, 0, " Hz/s", "Wie schnell die Tonhöhe steigt (+) oder fällt (-)")
machRegler(P_VOL,     "Lautstaerke", "Lautstärke", SX1, 3, 0.0, 1.0, 0.7, 2, "", "Lautstärke des Klangs")

machRegler(P_ATTACK,  "Attack", "Anschwellen", SX1, 6, 0, 2000, 0, 0, " ms", "Attack: wie lange der Klang bis zur vollen Lautstärke braucht")
machRegler(P_SUSTAIN, "Sustain", "Halten", SX1, 7, 0, 4000, 40, 0, " ms", "Sustain: wie lange er voll stehen bleibt")
machRegler(P_DECAY,   "Decay", "Ausklingen", SX1, 8, 0, 4000, 150, 0, " ms", "Decay: wie lange er bis zur Stille ausklingt")

machRegler(P_DUTY,    "Pulsbreite", "Pulsbreite", SX2, 0, 0.05, 0.95, 0.5, 2, "", "Verhältnis von oben zu unten -- wirkt auf square")
machRegler(P_PWM_D,   "PWM-Tiefe", "PWM-Tiefe", SX2, 1, 0.0, 0.45, 0.0, 2, "", "Wie weit die Pulsbreite schwingt")
machRegler(P_PWM_S,   "PWM-Tempo", "PWM-Tempo", SX2, 2, 0.0, 30.0, 0.0, 1, " Hz", "Wie schnell die Pulsbreite schwingt")
machRegler(P_CUTOFF,  "Filter", "Filter", SX2, 3, 0, 12000, 0, 0, " Hz", "Tiefpass-Grenzfrequenz, 0 = aus")
machRegler(P_SWEEP,   "Filter-Fahrt", "Filter-Fahrt", SX2, 4, -12000, 12000, 0, 0, " Hz/s", "Wie schnell der Filter wandert")
machRegler(P_RES,     "Resonanz", "Resonanz", SX2, 5, 0.0, 0.95, 0.0, 2, "", "Betonung an der Grenzfrequenz")

machRegler(P_VIB_D,   "Vib-Tiefe", "Vibrato-Tiefe", SX3, 0, 0.0, 0.5, 0.0, 2, "", "Wie weit die Tonhöhe schwingt")
machRegler(P_VIB_S,   "Vib-Tempo", "Vibrato-Tempo", SX3, 1, 0, 60, 0, 0, " Hz", "Wie schnell die Tonhöhe schwingt")
machRegler(P_BREITE,  "Stereo", "Stereobreite", SX3, 2, 0.0, 1.0, 0.0, 2, "", "Stereo-Breite, 0 = mono")
machRegler(P_PAN,     "Pan (L..R)", "Links/Rechts", SX3, 3, -1.0, 1.0, 0.0, 1, "", "Lage im Stereobild beim Abspielen")

' ============================================================
'  Werkseinstellungen
' ============================================================
DIM presetWave[N_PRESET] AS STRING
DIM presetWert[N_PRESET, N_PARAM] AS FLOAT

SUB setzePreset(i AS INTEGER, wf AS STRING, freq AS FLOAT, slide AS FLOAT, _
                atk AS FLOAT, sus AS FLOAT, dec AS FLOAT, _
                vibD AS FLOAT, vibS AS FLOAT)
    presetWave[i] = wf
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        presetWert[i, k] = 0.0
    NEXT
    presetWert[i, P_FREQ] = freq
    presetWert[i, P_SLIDE] = slide
    presetWert[i, P_VOL] = 0.7
    presetWert[i, P_ATTACK] = atk
    presetWert[i, P_SUSTAIN] = sus
    presetWert[i, P_DECAY] = dec
    presetWert[i, P_VIB_D] = vibD
    presetWert[i, P_VIB_S] = vibS
    presetWert[i, P_DUTY] = 0.5        ' neutrale Pulsbreite, nicht 0
END SUB

setzePreset(0, "square", 900,   600,  0, 40, 160, 0.0,  0)
setzePreset(1, "saw",    1000, -1400, 0, 30, 150, 0.0,  0)
setzePreset(2, "noise",  120,  -60,   0, 60, 420, 0.0,  0)
setzePreset(3, "square", 380,   700,  0, 90, 240, 0.15, 18)
setzePreset(4, "square", 500,  -500,  0, 20, 140, 0.0,  0)
setzePreset(5, "square", 420,   560,  0, 50, 130, 0.0,  0)
setzePreset(6, "square", 820,   0,    0, 18, 70,  0.0,  0)
setzePreset(7, "saw",    90,    0,    0, 600, 200, 0.08, 7)
setzePreset(8, "noise",  700,  -900,  0, 20, 140, 0.0,  0)
setzePreset(9, "square", 2600,  0,    0, 4,  20,  0.0,  0)
setzePreset(10, "sine",  1000,  0,    0, 20, 1400, 0.02, 6)
setzePreset(11, "square", 700,  0,    0, 450, 100, 0.35, 6)

FUNCTION welleNr(w AS STRING) AS INTEGER
    DIM k AS INTEGER
    FOR k = 0 TO LEN(wellenformen) - 1
        IF wellenformen[k] = w THEN RETURN k
    NEXT
    RETURN 0
END FUNCTION

SUB ladePreset(i AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        GUI_SET_VALUE(regler[k], presetWert[i, k])
    NEXT
    GUI_DROPDOWN_SET_SELECTED(waehlWave, welleNr(presetWave[i]))
END SUB

' ============================================================
'  Klang bauen und spielen
' ============================================================
DIM klang AS SOUND
klang = -1
DIM kurve AS ARRAY OF FLOAT
DIM geaendert AS INTEGER
DIM ruhig AS INTEGER            ' Bilder ohne Aenderung
DIM letzteWelle AS INTEGER
letzteWelle = -1
DIM kanal AS AUDIO_CHANNEL
kanal = -1
DIM spielStart AS INTEGER : spielStart = -1   ' MILLIS() beim Abspielen

FUNCTION wf$() AS STRING
    RETURN wellenformen[GUI_DROPDOWN_SELECTED(waehlWave)]
END FUNCTION

FUNCTION p(idx AS INTEGER) AS FLOAT
    RETURN GUI_VALUE(regler[idx])
END FUNCTION

FUNCTION dauerMs() AS INTEGER
    RETURN INT(p(P_ATTACK)) + INT(p(P_SUSTAIN)) + INT(p(P_DECAY))
END FUNCTION

' Klang neu erzeugen. Der alte wird freigegeben -- bei einem Werkzeug, das
' pro Reglerbewegung einen neuen baut, waeren das sonst schnell Tausende.
SUB baueKlang()
    IF klang >= 0 THEN UNLOADSOUND(klang)
    klang = AUDIO_SFX(wf$(), p(P_FREQ), p(P_SLIDE), _
                      INT(p(P_ATTACK)), INT(p(P_SUSTAIN)), INT(p(P_DECAY)), _
                      p(P_VIB_D), p(P_VIB_S), p(P_VOL), p(P_BREITE), _
                      p(P_DUTY), p(P_PWM_D), p(P_PWM_S), _
                      p(P_CUTOFF), p(P_SWEEP), p(P_RES))
    kurve = AUDIO_SOUND_WAVE(klang, 600)
    GUI_STATUSBAR_SET(lblStatus, sfDauer, "Dauer " + STR$(dauerMs()) + " ms  ·  " + wf$())
END SUB

SUB spiele()
    kanal = AUDIO_PLAY(klang)
    spielStart = MILLIS()
    ' Pan liegt nicht im Klang, sondern am Kanal -- AUDIO_SFX kennt nur die
    ' Stereo-BREITE. Beides zusammen ergibt die Position im Bild.
    IF p(P_PAN) <> 0.0 THEN
        DIM links AS FLOAT
        DIM rechts AS FLOAT
        links = 1.0 - MAX(0.0, p(P_PAN))
        rechts = 1.0 + MIN(0.0, p(P_PAN))
        AUDIO_PAN(kanal, links, rechts)
    END IF
END SUB

SUB anhalten()
    IF kanal >= 0 THEN AUDIO_STOP(kanal, 30)
    spielStart = -1
END SUB

' ============================================================
'  Zufall nach Art und Mutieren
'
'  Jede Vorlage ist zugleich eine ART: [Zufall] wuerfelt jeden Wert in den
'  Grenzen, die einen Laser zum Laser machen, und behaelt Lautstaerke und
'  Pan. Mutieren verschiebt jeden Wert nur um ein paar Prozent seines
'  Bereichs -- so tastet man sich an einen Klang heran, ohne ihn zu
'  verlieren.
' ============================================================
FUNCTION zw(lo AS FLOAT, hi AS FLOAT) AS FLOAT
    RETURN lo + RND() * (hi - lo)
END FUNCTION

SUB setze(k AS INTEGER, v AS FLOAT)
    GUI_SET_VALUE(regler[k], CLAMP(v, reglerLo[k], reglerHi[k]))
END SUB

SUB welleAus(auswahl AS STRING)
    DIM teile AS ARRAY OF STRING : teile = SPLIT$(auswahl, "|")
    GUI_DROPDOWN_SET_SELECTED(waehlWave, welleNr(teile[INT(RND() * LEN(teile))]))
END SUB

SUB zufallArt(art AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        IF k <> P_VOL AND k <> P_PAN THEN setze(k, 0.0)
    NEXT
    setze(P_DUTY, 0.5)
    SELECT CASE art
        CASE 0  ' Muenze
            welleAus("square|square|sine")
            setze(P_FREQ, zw(600, 1400)) : setze(P_SLIDE, zw(300, 1200))
            setze(P_SUSTAIN, zw(20, 80)) : setze(P_DECAY, zw(100, 300))
        CASE 1  ' Laser
            welleAus("saw|square|square")
            setze(P_FREQ, zw(600, 1800)) : setze(P_SLIDE, zw(-2600, -600))
            setze(P_SUSTAIN, zw(20, 60)) : setze(P_DECAY, zw(80, 250))
            IF RND() < 0.4 THEN setze(P_DUTY, zw(0.15, 0.4))
        CASE 2  ' Explosion
            welleAus("noise")
            setze(P_FREQ, zw(60, 250)) : setze(P_SLIDE, zw(-200, 0))
            setze(P_SUSTAIN, zw(30, 120)) : setze(P_DECAY, zw(300, 900))
            IF RND() < 0.5 THEN setze(P_CUTOFF, zw(1500, 5000)) : setze(P_SWEEP, zw(-3000, 0))
        CASE 3  ' Powerup
            welleAus("square|triangle")
            setze(P_FREQ, zw(250, 600)) : setze(P_SLIDE, zw(300, 1200))
            setze(P_SUSTAIN, zw(60, 160)) : setze(P_DECAY, zw(150, 400))
            setze(P_VIB_D, zw(0.05, 0.25)) : setze(P_VIB_S, zw(8, 25))
        CASE 4  ' Treffer
            welleAus("square|noise|saw")
            setze(P_FREQ, zw(200, 700)) : setze(P_SLIDE, zw(-900, -200))
            setze(P_SUSTAIN, zw(10, 40)) : setze(P_DECAY, zw(80, 200))
        CASE 5  ' Sprung
            welleAus("square")
            setze(P_FREQ, zw(250, 550)) : setze(P_SLIDE, zw(300, 900))
            setze(P_SUSTAIN, zw(30, 80)) : setze(P_DECAY, zw(80, 200))
            setze(P_DUTY, zw(0.3, 0.6))
        CASE 6  ' Blip
            welleAus("square|sine")
            setze(P_FREQ, zw(500, 1500))
            setze(P_SUSTAIN, zw(10, 40)) : setze(P_DECAY, zw(30, 100))
        CASE 7  ' Motor
            welleAus("saw|square")
            setze(P_FREQ, zw(50, 140)) : setze(P_SLIDE, zw(-30, 30))
            setze(P_SUSTAIN, zw(400, 900)) : setze(P_DECAY, zw(100, 300))
            setze(P_VIB_D, zw(0.04, 0.15)) : setze(P_VIB_S, zw(4, 12))
            IF RND() < 0.5 THEN setze(P_PWM_D, zw(0.1, 0.3)) : setze(P_PWM_S, zw(2, 8))
        CASE 8  ' Schuss
            welleAus("noise")
            setze(P_FREQ, zw(400, 1200)) : setze(P_SLIDE, zw(-1500, -300))
            setze(P_SUSTAIN, zw(10, 40)) : setze(P_DECAY, zw(80, 200))
        CASE 9  ' Klick
            welleAus("square|triangle")
            setze(P_FREQ, zw(1500, 4000))
            setze(P_SUSTAIN, zw(2, 10)) : setze(P_DECAY, zw(10, 40))
        CASE 10 ' Glocke
            welleAus("sine|triangle")
            setze(P_FREQ, zw(600, 1500))
            setze(P_SUSTAIN, zw(10, 40)) : setze(P_DECAY, zw(800, 2000))
            setze(P_VIB_D, zw(0.01, 0.05)) : setze(P_VIB_S, zw(4, 8))
        CASE ELSE ' Alarm
            welleAus("square|saw")
            setze(P_FREQ, zw(500, 900))
            setze(P_SUSTAIN, zw(300, 600)) : setze(P_DECAY, zw(50, 150))
            setze(P_VIB_D, zw(0.2, 0.45)) : setze(P_VIB_S, zw(4, 10))
    END SELECT
END SUB

SUB mutiere()
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        ' Nur Werte, die schon etwas tun -- ein ausgeschalteter Filter
        ' bleibt aus, sonst klingt eine Mutation nach einem anderen Klang.
        IF k <> P_VOL AND k <> P_PAN AND p(k) <> 0.0 AND RND() < 0.7 THEN
            setze(k, p(k) + (RND() - 0.5) * 0.12 * (reglerHi[k] - reglerLo[k]))
        END IF
    NEXT
END SUB

' ============================================================
'  Einstellungen sichern und laden
'
'  Format: eine schlichte `.ini` -- Schluessel ist der Name des Reglers
'  (`parName`). Das macht die Datei lesbar und von Hand aenderbar. Ein
'  unbekannter Schluessel wird UEBERGANGEN und nicht als Fehler gemeldet.
' ============================================================
SUB einstellungSichern()
    DIM datei AS STRING
    datei = FILE_SAVE_DIALOG("Einstellung sichern", "klang.ini", "ini")
    IF datei <> "" THEN
        DIM m AS MAP OF STRING
        MAPPUT(m, "wellenform", wf$())
        DIM k AS INTEGER
        FOR k = 0 TO N_PARAM - 1
            MAPPUT(m, parName[k], STR$(p(k)))
        NEXT
        TRY
            INI_SAVE(datei, m)
            standLesen(U_GESICHERT)
            GUI_SET_TEXT(lblStatus, "Gesichert: " + datei)
        CATCH e
            GUI_SET_TEXT(lblStatus, e)
        END TRY
    END IF
END SUB

SUB einstellungLaden()
    DIM datei AS STRING
    datei = FILE_OPEN_DIALOG("Einstellung laden", "ini")
    IF datei <> "" THEN
        TRY
            DIM m AS MAP OF STRING
            m = INI_LOAD(datei)
            DIM k AS INTEGER
            DIM gefunden AS INTEGER : gefunden = 0
            aendName = "Geöffnet: " + BASENAME(datei)
            FOR k = 0 TO N_PARAM - 1
                IF MAPHAS(m, parName[k]) THEN
                    ' GUI_SET_VALUE klemmt auf den Reglerbereich -- eine von
                    ' Hand verstellte Datei kann also nichts Unmoegliches
                    ' erzwingen.
                    GUI_SET_VALUE(regler[k], VAL(MAPGET(m, parName[k])))
                    gefunden = gefunden + 1
                END IF
            NEXT
            IF MAPHAS(m, "wellenform") THEN GUI_DROPDOWN_SET_SELECTED(waehlWave, welleNr(MAPGET(m, "wellenform")))
            ' Der Klang baut sich von selbst neu: die Schleife vergleicht
            ' jeden Regler mit `letzter[]`.
            standLesen(U_GESICHERT)
            IF gefunden = 0 THEN
                GUI_SET_TEXT(lblStatus, "Keine bekannten Regler in " + datei)
            ELSE
                GUI_SET_TEXT(lblStatus, STR$(gefunden) + " Regler geladen: " + datei)
            END IF
        CATCH e
            GUI_SET_TEXT(lblStatus, e)
        END TRY
    END IF
END SUB

SUB wavSichern()
    DIM pfad AS STRING
    pfad = FILE_SAVE_DIALOG("WAV sichern", "effekt.wav", "wav")
    IF pfad <> "" THEN
        AUDIO_SAVE_WAV(klang, pfad, IIF(GUI_CHECKED(knopfBits), 8, 16))
        GUI_SET_TEXT(lblStatus, "Gesichert: " + pfad)
    END IF
END SUB

' Der Code, der diesen Klang im eigenen Programm erzeugt UND abspielt --
' lauffaehig, nicht nur der nackte Aufruf.
'
' Der Pan gehoert dazu, obwohl AUDIO_SFX ihn nicht kennt: er liegt am
' WIEDERGABE-Kanal. Bis 2026-09-17 fehlte er hier, der kopierte Code klang
' also anders als die Vorschau daneben -- und zwar stumm anders, weil man
' einen fehlenden Pan nicht sieht.
FUNCTION dhCode$() AS STRING
    DIM nl AS STRING : nl = CHR$(10)
    DIM z AS STRING
    z = "IMPORT " + CHR$(34) + "audio" + CHR$(34) + nl + nl + "DIM snd AS SOUND" + nl
    z = z + "snd = AUDIO_SFX(" + CHR$(34) + wf$() + CHR$(34)
    z = z + ", " + FORMAT$(p(P_FREQ), "%.0f")
    z = z + ", " + FORMAT$(p(P_SLIDE), "%.0f")
    z = z + ", " + FORMAT$(p(P_ATTACK), "%.0f")
    z = z + ", " + FORMAT$(p(P_SUSTAIN), "%.0f")
    z = z + ", " + FORMAT$(p(P_DECAY), "%.0f")
    z = z + ", " + FORMAT$(p(P_VIB_D), "%.2f")
    z = z + ", " + FORMAT$(p(P_VIB_S), "%.0f")
    z = z + ", " + FORMAT$(p(P_VOL), "%.2f")
    z = z + ", " + FORMAT$(p(P_BREITE), "%.2f")
    z = z + ", " + FORMAT$(p(P_DUTY), "%.2f")
    z = z + ", " + FORMAT$(p(P_PWM_D), "%.2f")
    z = z + ", " + FORMAT$(p(P_PWM_S), "%.1f")
    z = z + ", " + FORMAT$(p(P_CUTOFF), "%.0f")
    z = z + ", " + FORMAT$(p(P_SWEEP), "%.0f")
    z = z + ", " + FORMAT$(p(P_RES), "%.2f") + ")" + nl
    IF p(P_PAN) <> 0.0 THEN
        ' Dieselbe Rechnung wie beim Vorhoeren (`spiele`).
        z = z + "DIM ch AS AUDIO_CHANNEL" + nl + "ch = AUDIO_PLAY(snd)" + nl + _
            "AUDIO_PAN(ch, " + FORMAT$(1.0 - MAX(0.0, p(P_PAN)), "%.2f") + ", " + _
            FORMAT$(1.0 + MIN(0.0, p(P_PAN)), "%.2f") + ")" + nl
    ELSE
        z = z + "PLAYSOUND(snd)" + nl
    END IF
    RETURN z
END FUNCTION

' ============================================================
'  Rueckgaengig / Wiederholen -- und der Verlauf links unten
'
'  Der Zustand dieses Werkzeugs sind 16 Reglerwerte und die Wellenform --
'  genau das, was auch die `.ini` sichert. Ein Schritt ist deshalb der VOLLE
'  Stand: bei 17 Zahlen kuerzer als jede Buchfuehrung darueber, und es kann
'  nichts auseinanderlaufen. Jeder Schritt traegt einen Namen ("Laser",
'  "Zufall: Laser", "Tonrutsch"), damit die Liste etwas sagt.
'
'  **Wann ist ein Schritt fertig?** Ein gezogener Regler aendert sich in
'  JEDEM Bild. Aufgezeichnet wird erst, wenn sich ein Bild lang nichts
'  geaendert hat UND keine Maustaste mehr haengt -- ein Zug ist ein Schritt.
'  Eine Werkseinstellung, ein Wuerfelwurf und eine geladene .ini setzen alle
'  Werte auf einmal und sind auf demselben Weg ebenfalls je einer.
' ============================================================
CONST U_MAX = 32
CONST U_FELDER = N_PARAM + 1           ' Regler + Wellenform
' Ein Platz mehr als der Verlauf braucht: dort liegt der Stand beim letzten
' Sichern oder Laden. Ungesichert ist, was davon abweicht -- ein Zurueck auf
' genau diesen Stand zaehlt also wieder als gesichert.
DIM uStand[U_MAX + 1, U_FELDER] AS FLOAT
DIM uName[U_MAX] AS STRING
CONST U_GESICHERT = U_MAX
DIM uAnz AS INTEGER : uAnz = 0
DIM uPos AS INTEGER : uPos = 0
DIM uOffen AS BOOLEAN : uOffen = FALSE
' Name des Schritts, der gerade entsteht. Wer viele Werte auf einmal setzt
' (Vorlage, Zufall), traegt ihn VORHER ein; sonst nimmt die Erkennung den
' Namen des ersten Reglers, der sich bewegt.
DIM aendName AS STRING : aendName = ""
DIM verlaufStand AS STRING : verlaufStand = ""

SUB standLesen(ziel AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        uStand[ziel, k] = GUI_VALUE(regler[k])
    NEXT
    uStand[ziel, N_PARAM] = GUI_DROPDOWN_SELECTED(waehlWave)
END SUB

FUNCTION standGleich(i AS INTEGER) AS BOOLEAN
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        IF uStand[i, k] <> GUI_VALUE(regler[k]) THEN RETURN FALSE
    NEXT
    RETURN uStand[i, N_PARAM] = GUI_DROPDOWN_SELECTED(waehlWave)
END FUNCTION

' Die Erkennung in der Schleife vergleicht mit `letzter[]` und `letzteWelle`.
' Nach einem Rueckgaengig muss sie den neuen Stand als BEKANNT ansehen --
' sonst zeichnet sie ihn als frische Aenderung auf und der Vor-Weg ist weg.
SUB letzteAuffrischen()
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        letzter[k] = GUI_VALUE(regler[k])
    NEXT
    letzteWelle = GUI_DROPDOWN_SELECTED(waehlWave)
END SUB

SUB standAnwenden(quelle AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        GUI_SET_VALUE(regler[k], uStand[quelle, k])
    NEXT
    GUI_DROPDOWN_SET_SELECTED(waehlWave, INT(uStand[quelle, N_PARAM]))
    letzteAuffrischen()
    baueKlang()
    uOffen = FALSE
    aendName = ""
END SUB

SUB schrittSichern(name AS STRING)
    ' Ein Stand, der sich nicht unterscheidet, ist kein Schritt -- die
    ' Pruefung muss VOR dem Abschneiden stehen, sonst kostet ein
    ' Nichts-Schritt den Vor-Weg.
    IF uAnz > 0 AND standGleich(uPos) THEN RETURN
    ' Der neue Stand kommt HINTER den aktuellen -- beim allerersten gibt es
    ' keinen, der Platz ist also 0.
    DIM ziel AS INTEGER
    ziel = IIF(uAnz = 0, 0, uPos + 1)
    IF ziel >= U_MAX THEN
        DIM i AS INTEGER
        DIM k AS INTEGER
        FOR i = 0 TO U_MAX - 2
            FOR k = 0 TO U_FELDER - 1
                uStand[i, k] = uStand[i + 1, k]
            NEXT
            uName[i] = uName[i + 1]
        NEXT
        ziel = U_MAX - 1
    END IF
    standLesen(ziel)
    uName[ziel] = name
    uPos = ziel
    ' Alles dahinter faellt weg -- ab hier geht die Geschichte anders weiter.
    uAnz = ziel + 1
END SUB

SUB zurueck()
    IF uPos > 0 THEN
        uPos = uPos - 1
        standAnwenden(uPos)
        GUI_SET_TEXT(lblStatus, "Zurück: " + uName[uPos])
    END IF
END SUB

SUB wieder()
    IF uPos < uAnz - 1 THEN
        uPos = uPos + 1
        standAnwenden(uPos)
        GUI_SET_TEXT(lblStatus, "Vor: " + uName[uPos])
    END IF
END SUB

' Die Liste nur neu fuellen, wenn sich etwas geaendert hat -- sonst setzte
' jedes Bild den Rollstand zurueck.
SUB verlaufZeigen()
    DIM schl AS STRING : schl = STR$(uAnz) + "/" + STR$(uPos) + "/" + uName[uAnz - 1]
    IF schl = verlaufStand THEN RETURN
    verlaufStand = schl
    DIM namen AS ARRAY OF STRING : namen = []
    DIM i AS INTEGER
    FOR i = 0 TO uAnz - 1
        ARRAY_PUSH(namen, STR$(i + 1) + ".  " + uName[i])
    NEXT
    GUI_SET_LISTBOX(listVerlauf, namen)
    FOR i = 0 TO uAnz - 1
        ' Was hinter dem aktuellen Stand liegt, ist der Vor-Weg: gedaempft.
        IF i > uPos THEN GUI_LISTBOX_COLOR(listVerlauf, i, &H7A8696)
    NEXT
    GUI_LISTBOX_SET_SELECTED(listVerlauf, uPos)
    GUI_LISTBOX_SCROLL_TO(listVerlauf, uPos)
    GUI_STATUSBAR_SET(lblStatus, sfSchritt, "Schritt " + STR$(uPos + 1) + " von " + STR$(uAnz))
    GUI_MENU_ENABLE(miZurueck, uPos > 0)
    GUI_MENU_ENABLE(miVor, uPos < uAnz - 1)
    GUI_TOOLBAR_ENABLE(leiste, tbZurueck, uPos > 0)
    GUI_TOOLBAR_ENABLE(leiste, tbVor, uPos < uAnz - 1)
END SUB

' ============================================================
'  Die Wellenform mit Huellkurve
'
'  Die Zeitachse ist eine "runde" Spanne ueber der Klangdauer. Waehrend an
'  einem Punkt der Huellkurve gezogen wird, BLEIBT sie stehen -- sonst
'  liefe der Punkt der Maus davon, weil sich die Achse mit der Dauer aendert.
' ============================================================
DIM skalaMs AS INTEGER : skalaMs = 500
DIM ziehPunkt AS INTEGER : ziehPunkt = -1     ' -1 / 0 Attack / 1 Sustain / 2 Decay
DIM ueberPunkt AS INTEGER : ueberPunkt = -1
DIM zeigerJetzt AS STRING : zeigerJetzt = "auto"
DIM pegel AS FLOAT : pegel = 0.0

FUNCTION runde(ms AS INTEGER) AS INTEGER
    DIM stufen AS ARRAY OF INTEGER : stufen = [200, 300, 500, 750, 1000, 1500, 2000, 3000, 4000, 6000, 8000, 10000]
    DIM s AS INTEGER
    FOR EACH s IN stufen
        IF ms * 1.1 <= s THEN RETURN s
    NEXT
    RETURN 10000
END FUNCTION

FUNCTION schritt(ms AS INTEGER) AS INTEGER
    IF ms <= 300 THEN RETURN 50
    IF ms <= 1000 THEN RETURN 100
    IF ms <= 3000 THEN RETURN 500
    RETURN 1000
END FUNCTION

' x-Lage eines Zeitpunkts in der Zeichenflaeche.
FUNCTION zx(ms AS FLOAT) AS INTEGER
    RETURN GUI_CANVAS_X(flaeche) + 12 + INT(ms / skalaMs * (GUI_CANVAS_W(flaeche) - 40))
END FUNCTION

FUNCTION msBei(x AS INTEGER) AS FLOAT
    RETURN (x - GUI_CANVAS_X(flaeche) - 12) * skalaMs / (GUI_CANVAS_W(flaeche) - 40)
END FUNCTION

' Lage der drei Punkte: Ende Attack (oben), Ende Sustain (oben), Ende Decay
' (unten). Liefert die x-Lage; die y-Lage sagt `punktY`.
FUNCTION punktX(i AS INTEGER) AS INTEGER
    IF i = 0 THEN RETURN zx(INT(p(P_ATTACK)))
    IF i = 1 THEN RETURN zx(INT(p(P_ATTACK)) + INT(p(P_SUSTAIN)))
    RETURN zx(dauerMs())
END FUNCTION

FUNCTION obenY() AS INTEGER
    RETURN GUI_CANVAS_Y(flaeche) + 22
END FUNCTION

FUNCTION untenY() AS INTEGER
    RETURN GUI_CANVAS_Y(flaeche) + GUI_CANVAS_H(flaeche) - 30
END FUNCTION

FUNCTION mitteY() AS INTEGER
    RETURN (obenY() + untenY()) \ 2
END FUNCTION

' Die Huellkurve liegt AUF der Welle: oben auf Hoehe der Lautstaerke, das
' Ende auf der Mittellinie (Stille). Bei Lautstaerke fast 0 laegen die
' Punkte sonst alle auf einer Linie und liessen sich nicht mehr greifen.
FUNCTION huelleOben() AS INTEGER
    RETURN mitteY() - INT(MAX(0.15, p(P_VOL)) * (untenY() - obenY()) / 2)
END FUNCTION

FUNCTION punktY(i AS INTEGER) AS INTEGER
    RETURN IIF(i = 2, mitteY(), huelleOben())
END FUNCTION

FUNCTION inFlaeche(mx AS INTEGER, my AS INTEGER) AS BOOLEAN
    RETURN mx >= GUI_CANVAS_X(flaeche) AND my >= GUI_CANVAS_Y(flaeche) AND _
           mx < GUI_CANVAS_X(flaeche) + GUI_CANVAS_W(flaeche) AND my < GUI_CANVAS_Y(flaeche) + GUI_CANVAS_H(flaeche)
END FUNCTION

FUNCTION punktUnter(mx AS INTEGER, my AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    ' Von hinten: liegen zwei Punkte aufeinander (Sustain 0), greift man
    ' den spaeteren -- sonst kaeme man nie mehr an ihn heran.
    FOR i = 2 TO 0 STEP -1
        IF ABS(mx - punktX(i)) <= 9 AND ABS(my - punktY(i)) <= 9 THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB zeigerSetzen(form AS STRING)
    IF form <> zeigerJetzt THEN
        zeigerJetzt = form
        MOUSE_CURSOR(form)
    END IF
END SUB

' Die Maus in der Wellenform: Punkte greifen und ziehen, sonst Klick =
' abspielen. Nicht, solange ein Kasten offen ist.
SUB flaecheMaus()
    DIM mx AS INTEGER : mx = MOUSEX()
    DIM my AS INTEGER : my = MOUSEY()
    IF ziehPunkt >= 0 THEN
        IF NOT MOUSEBUTTON(0) THEN
            ziehPunkt = -1
        ELSE
            DIM t AS FLOAT : t = MAX(0.0, msBei(mx))
            IF ziehPunkt = 0 THEN
                setze(P_ATTACK, INT(t))
            ELSEIF ziehPunkt = 1 THEN
                setze(P_SUSTAIN, INT(t - INT(p(P_ATTACK))))
            ELSE
                setze(P_DECAY, INT(t - INT(p(P_ATTACK)) - INT(p(P_SUSTAIN))))
            END IF
        END IF
        zeigerSetzen("resize_ew")
        RETURN
    END IF
    IF NOT inFlaeche(mx, my) THEN
        ueberPunkt = -1
        zeigerSetzen("auto")
        RETURN
    END IF
    ueberPunkt = punktUnter(mx, my)
    zeigerSetzen(IIF(ueberPunkt >= 0, "resize_ew", "hand"))
    IF MOUSE_HIT(0) THEN
        IF ueberPunkt >= 0 THEN
            ziehPunkt = ueberPunkt
            aendName = "Hüllkurve"
        ELSE
            spiele()
        END IF
    END IF
END SUB

SUB zeichneFlaeche()
    DIM cx AS INTEGER : cx = GUI_CANVAS_X(flaeche)
    DIM cy AS INTEGER : cy = GUI_CANVAS_Y(flaeche)
    DIM cw AS INTEGER : cw = GUI_CANVAS_W(flaeche)
    DIM chh AS INTEGER : chh = GUI_CANVAS_H(flaeche)
    IF ziehPunkt < 0 THEN skalaMs = runde(dauerMs())
    GRADIENTV(cx, cy, cx + cw - 1, cy + chh - 1, &H121C2A, &H0A0F17)

    DIM oben AS INTEGER : oben = obenY()
    DIM unten AS INTEGER : unten = untenY()
    DIM mitte AS INTEGER : mitte = (oben + unten) \ 2
    DIM h AS FLOAT : h = (unten - oben) / 2

    ' Zeitraster mit Beschriftung.
    TEXT_SIZE(12)
    DIM st AS INTEGER : st = schritt(skalaMs)
    DIM t AS INTEGER
    FOR t = 0 TO skalaMs STEP st
        DIM gx AS INTEGER : gx = zx(t)
        LINE(gx, oben, gx, unten, IIF(t MOD (st * 2) = 0, &H22324A, &H18233A))
        ' Die letzte Beschriftung liefe in die Pegelanzeige -- dort weglassen.
        IF gx + 60 < cx + cw - 24 THEN TEXT(gx + 3, unten + 6, STR$(t) + " ms", &H6E7E94)
    NEXT
    LINE(cx + 12, mitte, cx + cw - 28, mitte, &H2E3C50)

    ' Die Welle als gespiegelte Huelle: je Spalte der groesste Ausschlag.
    DIM n AS INTEGER : n = LEN(kurve)
    DIM ende AS INTEGER : ende = zx(dauerMs())
    DIM anfang AS INTEGER : anfang = zx(0)
    IF n >= 2 AND ende > anfang THEN
        DIM spalten AS INTEGER : spalten = ende - anfang
        DIM x1[spalten] AS INTEGER
        DIM y1[spalten] AS INTEGER
        DIM y2[spalten] AS INTEGER
        DIM i AS INTEGER
        DIM uebersteuert AS BOOLEAN : uebersteuert = FALSE
        FOR i = 0 TO spalten - 1
            DIM a AS FLOAT : a = ABS(kurve[MIN(n - 1, i * n \ spalten)])
            IF a >= 0.999 THEN uebersteuert = TRUE
            x1[i] = anfang + i
            y1[i] = mitte - INT(a * h)
            y2[i] = mitte + INT(a * h)
        NEXT
        LINES(x1, y1, x1, y2, &H1F8FB0, spalten)
        DIM innen1[spalten] AS INTEGER
        DIM innen2[spalten] AS INTEGER
        FOR i = 0 TO spalten - 1
            innen1[i] = mitte - (mitte - y1[i]) \ 2
            innen2[i] = mitte + (mitte - y1[i]) \ 2
        NEXT
        LINES(x1, innen1, x1, innen2, &H3DD2F5, spalten)
        IF uebersteuert THEN
            TEXT_SIZE(14)
            TEXT(cx + cw - 110, cy + 4, "Übersteuert", &HEF9F27)
        END IF
    END IF

    ' Die Huellkurve darueber, mit ihren drei Punkten.
    DIM ax AS INTEGER : ax = punktX(0)
    DIM sx AS INTEGER : sx = punktX(1)
    DIM dx AS INTEGER : dx = punktX(2)
    DIM ho AS INTEGER : ho = huelleOben()
    LINEW(anfang, mitte, ax, ho, 2, &HF2C14E)
    LINEW(ax, ho, sx, ho, 2, &HF2C14E)
    LINEW(sx, ho, dx, mitte, 2, &HF2C14E)
    DIM k AS INTEGER
    FOR k = 0 TO 2
        DIM r AS INTEGER : r = IIF(k = ueberPunkt OR k = ziehPunkt, 8, 6)
        CIRCLE(punktX(k), punktY(k), r + 2, &H0A0F17)
        CIRCLE(punktX(k), punktY(k), r, IIF(k = ziehPunkt, &HFFFFFF, &HF2C14E))
    NEXT
    TEXT_SIZE(12)
    TEXT(ax - 4, ho - 24, "A", &HF2C14E)
    TEXT(sx - 4, ho - 24, "S", &HF2C14E)
    TEXT(dx + 10, mitte - 20, "D", &HF2C14E)

    ' Abspielkopf: wo der Klang gerade ist.
    IF spielStart >= 0 THEN
        DIM vergangen AS INTEGER : vergangen = MILLIS() - spielStart
        IF vergangen <= dauerMs() THEN
            DIM px AS INTEGER : px = zx(vergangen)
            LINEW(px, oben - 6, px, unten + 4, 2, &HFFFFFF)
        ELSE
            spielStart = -1
        END IF
    END IF

    ' Pegel am Ausgang, rechts am Rand: was gerade aus dem Mischer kommt.
    DIM jetzt AS FLOAT : jetzt = 0.0
    TRY
        jetzt = AUDIO_PEAK()
    CATCH e
        jetzt = 0.0
    END TRY
    pegel = MAX(jetzt, pegel * 0.9)
    DIM mx0 AS INTEGER : mx0 = cx + cw - 18
    BOXROUND(mx0, oben, mx0 + 8, unten, 3, &H1A2433)
    DIM ph AS INTEGER : ph = INT(MIN(1.0, pegel) * (unten - oben))
    IF ph > 0 THEN BOXROUND(mx0, unten - ph, mx0 + 8, unten, 3, IIF(pegel >= 0.99, &HEF5F4F, IIF(pegel > 0.7, &HF2C14E, &H4BE87A)))
    TEXT_SIZE(15)
END SUB

' ============================================================
'  Befehle -- eine Stelle fuer Menue, Werkzeugleiste und Knoepfe
' ============================================================
DIM frage AS GUI_WINDOW
frage = -1                     ' -1 = keine Rueckfrage offen
DIM beenden AS BOOLEAN : beenden = FALSE

FUNCTION ungesichert() AS BOOLEAN
    RETURN NOT standGleich(U_GESICHERT)
END FUNCTION

' ESC und das Kreuz fragen nur nach, wenn die Regler nicht so stehen wie
' beim letzten Sichern, Laden oder Waehlen einer Werkseinstellung.
SUB endeAnfragen()
    IF ungesichert() THEN
        frage = GUI_DIALOG("Beenden", "Die Einstellung ist nicht gesichert.", "Sichern|Verwerfen|Abbrechen")
    ELSE
        beenden = TRUE
    END IF
END SUB

SUB zufallKnopf()
    DIM art AS INTEGER : art = MAX(0, GUI_LISTBOX_SELECTED(liste))
    aendName = "Zufall: " + presetNamen[art]
    zufallArt(art)
    GUI_SET_TEXT(lblStatus, "Neuer Klang der Art " + presetNamen[art] + ".")
END SUB

SUB mutierenKnopf()
    aendName = "Mutiert"
    mutiere()
END SUB

ladePreset(0)
GUI_LISTBOX_SET_SELECTED(liste, 0)
baueKlang()
letzteAuffrischen()
schrittSichern("Vorlage: " + presetNamen[0])
standLesen(U_GESICHERT)

DIM letztePreset AS INTEGER
letztePreset = 0
DIM warB AS INTEGER : warB = SCREENWIDTH()
DIM warH AS INTEGER : warH = SCREENHEIGHT()

WHILE NOT beenden
    ' Das Kreuz (und Alt+F4) fragt wie [Beenden] nach, wenn etwas nicht
    ' gesichert ist. QUITREQUESTED ohne das Kreuz ist das Bildlimit eines
    ' Testlaufs -- dort endet das Programm hart wie bisher.
    IF WINDOW_CLOSE_REQUESTED() THEN
        IF frage < 0 THEN endeAnfragen()
    ELSEIF QUITREQUESTED() THEN
        BREAK
    END IF
    ' Das Fenster wurde groesser oder kleiner: die gui folgt, die Anker
    ' verteilen den Platz (die Wellenform waechst, der Rest rueckt mit).
    IF SCREENWIDTH() <> warB OR SCREENHEIGHT() <> warH THEN
        warB = SCREENWIDTH() : warH = SCREENHEIGHT()
        GUI_WINDOW_SET_BOUNDS(win, 0, 0, warB, warH)
    END IF
    CLS(&H0B1119)
    GUI_UPDATE()

    ' --- Werkseinstellung gewaehlt? ---
    IF GUI_LISTBOX_SELECTED(liste) <> letztePreset AND GUI_LISTBOX_SELECTED(liste) >= 0 THEN
        letztePreset = GUI_LISTBOX_SELECTED(liste)
        aendName = "Vorlage: " + presetNamen[letztePreset]
        ladePreset(letztePreset)
        ' Eine Werkseinstellung laesst sich jederzeit wieder waehlen -- es geht
        ' nichts verloren, was nicht gesichert waere.
        standLesen(U_GESICHERT)
    END IF

    ' --- Befehle ---
    DIM tb AS INTEGER : tb = GUI_TOOLBAR_CLICKED(leiste)
    IF GUI_CLICKED(knopfZufall) OR GUI_CLICKED(miZufall) THEN zufallKnopf()
    IF GUI_CLICKED(knopfMutieren) OR GUI_CLICKED(miMutieren) THEN mutierenKnopf()
    IF GUI_CLICKED(miZurueck) OR tb = tbZurueck THEN zurueck()
    IF GUI_CLICKED(miVor) OR tb = tbVor THEN wieder()
    IF GUI_CLICKED(miSichern) OR tb = tbSichern THEN einstellungSichern()
    IF GUI_CLICKED(miLaden) OR tb = tbLaden THEN einstellungLaden()
    IF GUI_CLICKED(miWav) OR tb = tbWav THEN wavSichern()
    IF GUI_CLICKED(miCode) OR tb = tbCode THEN
        CLIPBOARD_SET(dhCode$())
        GUI_SET_TEXT(lblStatus, "DH-Code in der Zwischenablage.")
    END IF
    IF GUI_CLICKED(miStopp) OR tb = tbStopp THEN anhalten()
    IF GUI_CLICKED(miEnde) AND frage < 0 THEN endeAnfragen()

    ' --- Ein Schritt aus dem Verlauf? ---
    IF GUI_CLICKED(listVerlauf) THEN
        DIM vi AS INTEGER : vi = GUI_LISTBOX_SELECTED(listVerlauf)
        IF vi >= 0 AND vi < uAnz AND vi <> uPos THEN
            uPos = vi
            standAnwenden(uPos)
            GUI_SET_TEXT(lblStatus, "Zurückgeholt: " + uName[uPos])
        END IF
    END IF

    IF frage < 0 THEN flaecheMaus()

    ' --- Hat sich etwas veraendert? ---
    geaendert = 0
    DIM k AS INTEGER
    FOR k = 0 TO N_PARAM - 1
        IF GUI_VALUE(regler[k]) <> letzter[k] THEN
            letzter[k] = GUI_VALUE(regler[k])
            IF aendName = "" THEN aendName = anzeige[k]
            geaendert = 1
        END IF
    NEXT
    IF GUI_DROPDOWN_SELECTED(waehlWave) <> letzteWelle THEN
        letzteWelle = GUI_DROPDOWN_SELECTED(waehlWave)
        IF aendName = "" THEN aendName = "Wellenform: " + wf$()
        geaendert = 1
    END IF

    IF geaendert = 1 THEN
        baueKlang()
        ruhig = 0
        uOffen = TRUE
    ELSE
        ruhig = ruhig + 1
        ' Der Zug ist zu Ende: EIN Schritt fuer die ganze Bewegung. Solange
        ' die Taste haengt, laeuft er noch -- ein Regler steht zwischendurch
        ' oft ein Bild lang still.
        IF uOffen AND NOT MOUSEBUTTON(0) THEN
            uOffen = FALSE
            schrittSichern(IIF(aendName = "", "Änderung", aendName))
            aendName = ""
        END IF
    END IF
    IF NOT uOffen AND geaendert = 0 AND ziehPunkt < 0 THEN aendName = ""
    verlaufZeigen()

    ' Erst spielen, wenn der Regler ZUR RUHE gekommen ist. Bei jedem
    ' Zwischenwert loszuschiessen ergaebe ein Maschinengewehr aus
    ' angerissenen Toenen -- unbrauchbar zum Beurteilen.
    IF ruhig = 6 AND GUI_CHECKED(autoPlay) THEN spiele()
    IF GUI_CLICKED(knopfPlay) OR GUI_CLICKED(miPlay) OR tb = tbPlay THEN spiele()

    ' --- Zahlen neben den Reglern nachfuehren ---
    FOR k = 0 TO N_PARAM - 1
        GUI_SET_TEXT(wertText[k], FORMAT$(GUI_VALUE(regler[k]), "%." + STR$(nachkomma[k]) + "f") + einheit[k])
    NEXT

    GUI_DRAW()
    zeichneFlaeche()          ' NACH GUI_DRAW -- sonst zeichnet das Fenster darueber

    ' ESC beendet -- aber nicht, wenn gerade eine Rueckfrage offen ist (dort
    ' ist ESC das Abbrechen).
    IF KEYHIT(KEY_ESCAPE) AND frage < 0 THEN endeAnfragen()
    IF frage >= 0 THEN
        DIM ea AS INTEGER : ea = GUI_ANSWER(frage)
        IF ea = 1 THEN
            frage = -1
            einstellungSichern()
            IF NOT ungesichert() THEN beenden = TRUE
        ELSEIF ea = 2 THEN
            frage = -1 : beenden = TRUE
        ELSEIF ea = 3 THEN
            frage = -1
        END IF
        ' Ueber der Wellenform liegt die Zeichenflaeche -- ohne diesen Aufruf
        ' waere der Kasten dort nicht zu sehen.
        IF frage >= 0 THEN GUI_DRAW_WINDOW(frage)
    END IF

    FLIP()
WEND
