=== probe: dialog farben verwalten
IMPORT "helfer.dh"
' --probe-stufe14 mit farbprobe.pxs: der Dialog (Liste, Knoepfe je Auswahl,
' Sortieren, Faeden, Zusammenfuehren, ans Ende, Loeschen, Ungenutzte, Suche),
' Uebernehmen als ein Schritt samt Strg+Z/Strg+Y und der aktuellen Farbe,
' Abbrechen und Zuruecksetzen.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe14", "--foto", "d", "farbprobe.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["farben", "farben_geplant"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    PRINT "datei unveraendert: "; geLies$("farbprobe.pxs") = geLies$("vorher.pxs")
END IF
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
