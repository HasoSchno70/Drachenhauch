=== f5 arbeitet auf den entwicklungsdaten, bauen nimmt sie mit
' Das Programm zaehlt die Kunden ueber die Verbindung Daten: aus dem Studio
' gestartet die zwei im Projektordner. Strg+B legt die Datei neben die Exe,
' und die Exe findet sie dort.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
slHin(10, 10)
slWarten(10)
slTaste(294)
slWarten(150)
slMit([341], 66)
slWarten(200)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_LAUF_BILDER", "20")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
PRINT "lauf "; slHat(log, "ausgabe kunden 2")
DIM exe AS STRING : exe = "proj" + IIF(LOWER$(RIGHT$(EXEPATH$(), 4)) = ".exe", ".exe", "")
PRINT "gebaut "; slHat(log, "gebaut " + PATHJOIN(p + "/bau", exe))
PRINT "daten mit "; slHat(log, "daten mit " + PATHJOIN(p + "/bau", "daten.sqlite"))
SETENV("DHRT_FRAMES", "20")
PRINT "exe "; TRIM$(REPLACE$(SHELL_OUT$(PATHJOIN(p + "/bau", exe)), CHR$(13), ""))
--- argumente
{sammlung}/../../../studio/studio.dh
--- vorher
IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '')")
DB_EXEC(db, "INSERT INTO kunden (name) VALUES ('Anna')")
DB_EXEC(db, "INSERT INTO kunden (name) VALUES ('Bert')")
DB_CLOSE(db)
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
