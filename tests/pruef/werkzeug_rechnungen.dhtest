DIM db AS DB_CONN : db = DB_OPEN("_programm/rechnungen.db")
FUNCTION zahl(sql AS STRING) AS INTEGER
    DIM r AS DB_RESULT : r = DB_QUERY(db, sql)
    DIM n AS INTEGER : n = -1
    IF DB_NEXT(r) THEN n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN n
END FUNCTION
FUNCTION text$(sql AS STRING) AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, sql)
    DIM s AS STRING : s = ""
    IF DB_NEXT(r) THEN s = DB_GET_STRING(r, 0)
