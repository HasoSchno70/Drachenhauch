EPRINT("PORT=" + STR$(HTTPD_PORT(s)))
WHILE NOT HTTPD_ACCEPT(s)
    SLEEP(5)
WEND
PRINT HTTPD_SEND_DIR(s, "web")
HTTPD_STOP(s)

