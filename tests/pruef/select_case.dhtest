=== select treewalker[DIM a AS INTEGER\nDIM b AS INTEGER\na = 1\nb = 20\nSELECT CASE a\n    CASE 1\n        SELECT CASE b\n            CASE 0 TO 10\n                PRINT "a=1, b klein"\n            CASE 11 TO 100\n                PRINT "a=1, b mittel"\n        END SELECT\n    CASE 2\n        PRINT "a=2"\nEND SELECT\n-a=1, b mittel\n]
DIM a AS INTEGER
DIM b AS INTEGER
a = 1
b = 20
SELECT CASE a
    CASE 1
        SELECT CASE b
            CASE 0 TO 10
                PRINT "a=1, b klein"
            CASE 11 TO 100
                PRINT "a=1, b mittel"
        END SELECT
    CASE 2
        PRINT "a=2"
END SELECT
--- erwartet
a=1, b mittel

