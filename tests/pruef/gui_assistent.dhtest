e 6 6 0 0 0 0
e 7 5 0 0 0 0
e 9 7 344 236 0 0
e 10 6 0 0 0 0
e 11 5 0 0 0 0
e 13 6 0 0 0 0
e 14 5 0 0 0 0
e 16 7 76 236 0 0

--- umgebung
DHRT_FRAMES=22
--- erwartet
