' Die Vorschlagsliste beim Tippen (2026-10-01, beim Dogfooding gefunden).
'
' Ab drei getippten Zeichen geht sie von selbst auf -- war aber unsichtbar:
' per GUI_WINDOW_VISIBLE eingeblendet lag das Fenster HINTER dem
' Hauptfenster (der Fokus bleibt beim Tippen im Code, und nur der Fokus holte
' ein Fenster nach vorn). Mit Strg+Leer kam sie, weil die Liste dabei den
' Fokus bekommt. Dazu stand sie fest oben links statt an der Marke. Jetzt
' holt GUI_WINDOW_FRONT sie nach vorn, und GUI_TEXTAREA_CARET_XY setzt sie
' unter die Schreibmarke.
'
' Getippt wird mit ECHTEN Zeichen-Nachrichten (WM_CHAR,
' _hilfen/fenstersender.ps1 "tippe:...") -- eine Aufnahme fuellt die
' Zeichen-Warteschlange nicht.
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

=== caret xy liegt unter dem zeichen an der marke
' GUI_TEXTAREA_CARET_XY spricht dieselbe Lage wie GUI_TEXTAREA_POS_AT: der
' Punkt mitten in der Markenhoehe, ein Stueck rechts der Marke, trifft das
' Zeichen hinter ihr.
IMPORT "gui"
SCREEN(400, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 380, 180)
GUI_SET_TEXT(ta, "erste zeile" + CHR$(10) + "zweite zeile")
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 2 THEN GUI_TEXTAREA_GOTO(ta, 2, 3)
    IF bild = 4 THEN
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM h AS INTEGER
        (x, y, h) = GUI_TEXTAREA_CARET_XY(ta)
        DIM z AS INTEGER
        DIM s AS INTEGER
        (z, s) = GUI_TEXTAREA_POS_AT(ta, x + 2, y + h \ 2)
        PRINT "zeile "; z; " spalte "; s; " hoehe "; h > 0
    END IF
    CLS(0) : GUI_DRAW() : FLIP()
WEND
--- umgebung
DHRT_FRAMES=6
--- erwartet
zeile 2 spalte 3 hoehe TRUE

=== gui window front holt ein fenster nach vorn ohne fokus
' Der Laufzeitbefehl fuer sich: das zweite Fenster ist eingeblendet, liegt
' aber hinter dem ersten (dessen Feld den Fokus hat). GUI_WINDOW_FRONT holt
' es nach vorn; der Fokus bleibt im Feld des ersten. Gegenprobe davor: ohne
' den Befehl liegt das erste oben.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM a AS GUI_WINDOW : a = GUI_WINDOW("A", 0, 0, 400, 300)
DIM feld AS GUI_WIDGET : feld = GUI_TEXTINPUT(a, 10, 10, 200, 26, "")
DIM b AS GUI_WINDOW : b = GUI_WINDOW("B", 100, 100, 150, 100)
GUI_WINDOW_VISIBLE(b, FALSE)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 2 THEN GUI_FOCUS(feld) : GUI_WINDOW_VISIBLE(b, TRUE)
    IF bild = 3 THEN PRINT "vorher oben b "; GUI_WINDOW_AT(150, 150) = b
    IF bild = 4 THEN GUI_WINDOW_FRONT(b)
    IF bild = 5 THEN PRINT "nachher oben b "; GUI_WINDOW_AT(150, 150) = b; " fokus im feld "; GUI_FOCUSED() = feld
    CLS(0) : GUI_DRAW() : FLIP()
WEND
--- umgebung
DHRT_FRAMES=7
--- erwartet
vorher oben b FALSE
nachher oben b TRUE fokus im feld TRUE
