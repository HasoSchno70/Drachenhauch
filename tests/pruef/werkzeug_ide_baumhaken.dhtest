' Die Kaestchen im Projektbaum: angehakte Dateien und Ordner schraenken
' Projektsuche, Umbenennen, Ersetzen und Symbolverzeichnis ein
' (projektDateien in ide/ide.dh). Bis 2026-09-27 zaehlte nur der genaue Weg
' einer DATEI -- ein angehakter Ordner machte das Projekt leer, und es sah
' aus, als taete der Haken nichts.
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

--- langsam
=== ein angehakter ordner nimmt seine dateien mit
DIM prD AS STRING
FOR EACH prD IN projektDateien("*.dh")
    protokoll("probe ohne " + REPLACE$(prD, CHR$(92), "/"))
NEXT
GUI_FILETREE_SET_CHECKED(baum, PATHJOIN(projektOrdner, "lib"), TRUE)
FOR EACH prD IN projektDateien("*.dh")
    protokoll("probe mit " + REPLACE$(prD, CHR$(92), "/"))
NEXT
projektBeschriften()
protokoll("probe text " + MID$(GUI_TEXT(lblProjekt), INSTR(GUI_TEXT(lblProjekt), "--"), 99))
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- argumente
c.dh
--- umgebung
DHRT_FRAMES=300
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei c.dh
PRINT "c"
--- datei lib/a.dh
PRINT "a"
--- datei lib/b.dh
PRINT "b"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 6) = "probe " THEN PRINT MID$(L[i], 6, LEN(L[i]))
NEXT
--- erwartet
ohne c.dh
ohne lib/a.dh
ohne lib/b.dh
mit lib/a.dh
mit lib/b.dh
text -- Suche/Umbau nur in 1 angehakten

=== ohne wunsch keine kaestchen, ausblenden nimmt die haken weg
protokoll("probe anfangs " + STR$(baumHakenAn))
befehl("baum_haken")
protokoll("probe an " + STR$(baumHakenAn) + " " + STR$(GUI_MENU_CHECKED(miBaumHaken)))
GUI_FILETREE_SET_CHECKED(baum, PATHJOIN(projektOrdner, "lib"), TRUE)
protokoll("probe haken " + STR$(GUI_FILETREE_CHECKED_COUNT(baum)))
befehl("baum_haken")
protokoll("probe aus " + STR$(baumHakenAn) + " haken " + STR$(GUI_FILETREE_CHECKED_COUNT(baum)) + " dateien " + STR$(LEN(projektDateien("*.dh"))))
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- argumente
c.dh
--- umgebung
DHRT_FRAMES=300
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei c.dh
PRINT "c"
--- datei lib/a.dh
PRINT "a"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 6) = "probe " OR LEFT$(L[i], 10) = "baum haken" THEN PRINT L[i]
NEXT
DIM k AS STRING : k = REPLACE$(JOIN$(READLINES("_programm/ide.json"), ""), " ", "")
PRINT INSTR(k, CHR$(34) + "baum_haken" + CHR$(34) + ":false") >= 0
--- erwartet
probe anfangs FALSE
baum haken an
probe an TRUE TRUE
probe haken 1
baum haken aus
probe aus FALSE haken 0 dateien 2
TRUE
