=== die maus zoomt um den zeiger zieht und setzt marker
' Echte Mausereignisse aus einer Aufnahme: das Rad ueber der Karte zoomt, und
' der Ort unter dem Zeiger bleibt derselbe; Ziehen verschiebt die Karte genau
' um den Weg der Maus; ein Rechtsklick fragt nach dem Namen eines Markers an
' der Stelle des Klicks.
kUrl = "http://127.0.0.1:1/{z}/{x}/{y}.png"
AUTOMATION_PLAY("ev.txt")
DIM prB AS INTEGER
DIM prZoom AS INTEGER : prZoom = -1
DIM prLat AS FLOAT
DIM prLon AS FLOAT
DIM prZieht AS BOOLEAN
DIM prX0 AS FLOAT
DIM prY0 AS FLOAT
FUNCTION prUnter(mx AS INTEGER, my AS INTEGER, lat AS BOOLEAN) AS FLOAT
    DIM dx AS FLOAT : dx = mx - GUI_CANVAS_X(cvKarte) - karteB() / 2
    DIM dy AS FLOAT : dy = my - GUI_CANVAS_Y(cvKarte) - karteH() / 2
    IF lat THEN RETURN latAus(mitteY + dy, zoom)
    RETURN lonAus(mitteX + dx, zoom)
END FUNCTION
SUB prProbe()
    prB = prB + 1
    IF prZoom >= 0 AND zoom <> prZoom THEN
        PRINT "rad: zoom "; prZoom; " -> "; zoom; ", ort unter dem zeiger bleibt "; ABS(prUnter(300, 300, TRUE) - prLat) < 0.000001 AND ABS(prUnter(300, 300, FALSE) - prLon) < 0.000001
    END IF
    prZoom = zoom
    prLat = prUnter(300, 300, TRUE)
    prLon = prUnter(300, 300, FALSE)
    IF ziehen AND NOT prZieht THEN
        prX0 = mitteX : prY0 = mitteY
    ELSEIF prZieht AND NOT ziehen THEN
        PRINT "gezogen um "; prX0 - mitteX; " "; prY0 - mitteY
    END IF
    prZieht = ziehen
    IF dlgMarker <> 0 THEN
        PRINT "rechtsklick: dialog offen, stelle stimmt "; ABS(neuLat - prUnter(500, 400, TRUE)) < 0.000001 AND ABS(neuLon - prUnter(500, 400, FALSE)) < 0.000001
        EXIT(0)
    END IF
    IF prB > 300 THEN
        PRINT "zeit um"
        EXIT(0)
    END IF
END SUB
--- programm ../../examples/karten/main.dh nach SETFONT(schrift, 16)
--- ersetzen IMPORT "kern.dh"
IMPORT "{sammlung}/../../examples/karten/kern.dh"
--- ersetzen IMPORT "kacheln.dh"
IMPORT "{sammlung}/../../examples/karten/kacheln.dh"
--- einschub nach     kachelnPumpen()
    prProbe()
--- argumente
