DIM btnDruckWeg AS GUI_WIDGET : btnDruckWeg = GUI_BUTTON(winDruck, tr$("Abbrechen"), 318, 196, 70, 28)
GUI_WINDOW_DEFAULT(winDruck, btnDruckOk)
GUI_WINDOW_CANCEL(winDruck, btnDruckWeg)
GUI_WINDOW_VISIBLE(winDruck, FALSE)
DIM druckerNamen AS ARRAY OF STRING : druckerNamen = []

' Alle Widgets auf jedem Reiter sichtbar -- die Reiter schalten nur die Code-Felder.
DIM tabTitel[MAX_TABS] AS STRING

DIM breiteLinks AS INTEGER : breiteLinks = 220
DIM hoeheUnten AS INTEGER : hoeheUnten = 200

' --- Vorschaubilder fuer die Kacheln ----------------------------------
' Erzeugt wird EINES nach dem anderen, im Hintergrund und nur, solange die
' Willkommensseite zu sehen ist: acht Beispiele auf einmal zu starten
' brauchte acht Fenster und die halbe Maschine. `dhrt bild` schiebt sein
' Fenster dabei aus dem Blick.
DIM vorschauOrdner AS STRING : vorschauOrdner = PATHJOIN(DIRNAME(konfigPfad), "vorschau")
DIM vorschauLauf AS INTEGER : vorschauLauf = -1
DIM vorschauIdx AS INTEGER : vorschauIdx = -1
DIM vorschauFertig AS INTEGER : vorschauFertig = 0
' Ist alles da, wird nicht mehr gesucht: acht Dateien in JEDEM Bild
' nachzusehen waere ein Dutzend Betriebssystem-Aufrufe je Sechzigstel.
DIM vorschauRuhe AS BOOLEAN : vorschauRuhe = FALSE

FUNCTION vorschauPfad$(i AS INTEGER) AS STRING
    RETURN PATHJOIN(vorschauOrdner, REPLACE$(kachelDatei[i], ".dh", "") + ".png")
END FUNCTION

' Das mitgelieferte Bild aus examples/screenshots/ (tools/showcase_bilder.dh).
FUNCTION showcaseBild$(i AS INTEGER) AS STRING
    RETURN PATHJOIN(beispielOrdner, "screenshots/" + REPLACE$(kachelDatei[i], ".dh", "") + ".png")
END FUNCTION

' Das Bild an seine Kachel haengen. Eine alte Textur wird vorher
' freigegeben -- LOADIMAGE merkt sich den PFAD, und ohne IMAGE_FREE kaeme
' nach dem Neu-Erzeugen wieder das alte Bild zurueck.
SUB kachelBildSetzen(i AS INTEGER)
    IF i < 0 OR i >= kachelAnzahl THEN RETURN
    DIM pfad AS STRING : pfad = vorschauPfad$(i)
    DIM herkunft AS STRING : herkunft = "vorschau"
    IF FILEEXISTS(showcaseBild$(i)) THEN
        pfad = showcaseBild$(i)
        herkunft = "screenshots"
    END IF
    IF NOT FILEEXISTS(pfad) THEN RETURN
    protokoll("kachelbild " + kachelDatei[i] + " " + herkunft)
    TRY
        IF kachelTextur[i] >= 0 THEN IMAGE_FREE(kachelTextur[i])
        kachelTextur[i] = LOADIMAGE(pfad)
        GUI_SET_IMAGE(kachelKarte[i], kachelTextur[i])
    CATCH e
        kachelTextur[i] = -1
    END TRY
END SUB

SUB vorschauNachziehen()
    IF vorschauLauf >= 0 THEN
        IF PROCESS_RUNNING(vorschauLauf) THEN RETURN
        PROCESS_CLOSE(vorschauLauf)
        vorschauLauf = -1
        kachelBildSetzen(vorschauIdx)
        vorschauFertig = vorschauFertig + 1
        protokoll("vorschau fertig " + STR$(vorschauIdx))
        vorschauIdx = -1
    END IF
    IF tabAnzahl > 0 OR vorschauRuhe THEN RETURN      ' nur auf der Willkommensseite
    DIM i AS INTEGER
    FOR i = 0 TO kachelAnzahl - 1
        IF FILEEXISTS(vorschauPfad$(i)) OR FILEEXISTS(showcaseBild$(i)) THEN CONTINUE
        DIM quelle AS STRING : quelle = PATHJOIN(beispielOrdner, kachelDatei[i])
        IF NOT FILEEXISTS(quelle) THEN CONTINUE
        IF NOT DIREXISTS(vorschauOrdner) THEN MKDIR(vorschauOrdner)
        vorschauLauf = PROCESS_START("dhrt", "bild", quelle, vorschauPfad$(i), STR$(kachelBilderZahl[i]))
        vorschauIdx = i
        GUI_SET_TEXT(lblStatus, tr$("Vorschau: ") + kachelName[i] + " ...")
        protokoll("vorschau " + kachelDatei[i])
        RETURN
    NEXT
    vorschauRuhe = TRUE
END SUB

' Alle noch einmal: die Bilder werden geloescht, der Rest laeuft von selbst.
' Die mitgelieferten unter examples/screenshots/ bleiben -- die erzeugt
' tools/showcase_bilder.dh.
SUB vorschauNeu()
    DIM i AS INTEGER
    FOR i = 0 TO kachelAnzahl - 1
        IF kachelTextur[i] >= 0 THEN
            IMAGE_FREE(kachelTextur[i])
            kachelTextur[i] = -1
        END IF
        GUI_SET_IMAGE(kachelKarte[i], -1)
        IF FILEEXISTS(vorschauPfad$(i)) THEN DELETEFILE(vorschauPfad$(i))
    NEXT
    vorschauFertig = 0
    vorschauRuhe = FALSE
    GUI_SET_TEXT(lblStatus, tr$("Vorschaubilder werden neu erzeugt ..."))
    protokoll("vorschau neu")
END SUB

SUB willkommenZeigen(an AS BOOLEAN)
    IF wkSchriftzug THEN
        GUI_SET_VISIBLE(imgWkTitel, an)
    ELSE
        GUI_SET_VISIBLE(lblWkTitel, an)
    END IF
    GUI_SET_VISIBLE(lblWkUnter, an)
    GUI_SET_VISIBLE(btnWkNeu, an) : GUI_SET_VISIBLE(btnWkOeffnen, an) : GUI_SET_VISIBLE(btnWkBeispiele, an)
    GUI_SET_VISIBLE(btnWkThemen, an)
    GUI_SET_VISIBLE(lblWkZuletzt, an) : GUI_SET_VISIBLE(lstWkZuletzt, an) : GUI_SET_VISIBLE(lblWkKuerzel, an)
    IF NOT an THEN
        GUI_SET_VISIBLE(lblKacheln, FALSE)
        DIM wk AS INTEGER
        FOR wk = 0 TO kachelAnzahl - 1
            GUI_SET_VISIBLE(kachelKarte[wk], FALSE)
        NEXT
    END IF
END SUB

' --- Einstellungen, Sitzung, zuletzt geoeffnet -----------------------
SUB konfigSichern()
    JSON_SET_BOOL(konfig, "hell", hell)
    JSON_SET_INT(konfig, "schrift", codeGroesse)
    JSON_SET_INT(konfig, "listen_schrift", listenGroesse)
    JSON_SET_INT(konfig, "handbuch_schrift", handbuchGroesse)
    JSON_SET_BOOL(konfig, "umbruch", umbruchAn)
    JSON_SET_BOOL(konfig, "karte", minimapAn)
    JSON_SET_BOOL(konfig, "git_rand", gitRandAn)
    JSON_SET_BOOL(konfig, "regex", regexAn)
    JSON_SET_BOOL(konfig, "gross_klein", grossKlein)
    JSON_SET_BOOL(konfig, "ganzes_wort", ganzesWort)
    JSON_SET_BOOL(konfig, "vorschlag", vorschlagAn)
    JSON_SET_BOOL(konfig, "linien", linienAn)
    JSON_SET_BOOL(konfig, "blockkopf", kopfAn)
    JSON_SET_BOOL(konfig, "profil_waerme", waermeAn)
    JSON_SET_BOOL(konfig, "aufrufzaehler", zaehlerAn)
    JSON_SET_BOOL(konfig, "fehler_am_ende", fehlerEndeAn)
    JSON_SET_BOOL(konfig, "typ_hinweise", typHinweiseAn)
    JSON_SET_BOOL(konfig, "neustart_beim_sichern", neustartSichernAn)
    JSON_SET_JSON(konfig, "start", JSON_PARSE("[]"))
    DIM sti AS INTEGER
    FOR sti = 0 TO LEN(startDateien) - 1
        DIM stE AS JSON_HANDLE : stE = JSON_NEW_OBJECT()
        JSON_SET_STRING(stE, "datei", startDateien[sti])
        JSON_SET_STRING(stE, "argumente", startArgs[sti])
        JSON_SET_STRING(stE, "umgebung", startUmg[sti])
        JSON_APPEND_JSON(konfig, "start", stE)
    NEXT
    JSON_SET_BOOL(konfig, "geruest", geruestAn)
    JSON_SET_BOOL(konfig, "klammern", klammernAn)
    JSON_SET_BOOL(konfig, "vorspann", vorspannAn)
    JSON_SET_STRING(konfig, "vorspann_datei", vorspannDatei)
    JSON_SET_BOOL(konfig, "glanz", glanzAn)
    JSON_SET_BOOL(konfig, "wasserzeichen", wasserzeichenAn)
    JSON_SET_INT(konfig, "ui_schrift", uiGroesse)
    JSON_SET_BOOL(konfig, "baum_haken", baumHakenAn)
    JSON_SET_BOOL(konfig, "format_sichern", formatSichernAn)
    JSON_SET_BOOL(konfig, "umbau_vorschau", vorschauAn)
    JSON_SET_BOOL(konfig, "leiste", leisteAn)
    JSON_SET_BOOL(konfig, "seitenleiste", seitenAn)
    JSON_SET_BOOL(konfig, "untere_leiste", untenAn)
    JSON_SET_INT(konfig, "druck_groesse", druckGroesse)
    JSON_SET_INT(konfig, "druck_rand", druckRand)
    JSON_SET_BOOL(konfig, "druck_nummern", druckNummern)
    JSON_SET_INT(konfig, "autosichern", autoSichern)
    JSON_SET_JSON(konfig, "zuletzt", JSON_PARSE("[]"))
    DIM p AS STRING
    FOR EACH p IN zuletzt
        JSON_APPEND_STRING(konfig, "zuletzt", p)
    NEXT
    JSON_SET_JSON(konfig, "sitzung", JSON_PARSE("[]"))
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF tabPfade[i] <> "" THEN JSON_APPEND_STRING(konfig, "sitzung", tabPfade[i])
        faltenMerken(i)
    NEXT
    ' Haltepunkte und Lesezeichen ueberleben den Neustart (bis 2026-09-27
    ' musste man sie nach jedem Start neu setzen).
    JSON_SET_JSON(konfig, "haltepunkte", JSON_NEW_ARRAY())
    DIM hk AS INTEGER
    FOR hk = 0 TO LEN(hpZeilen) - 1
        DIM hpE AS JSON_HANDLE : hpE = JSON_NEW_OBJECT()
        JSON_SET_STRING(hpE, "datei", hpDateien[hk])
        JSON_SET_INT(hpE, "zeile", hpZeilen[hk])
        IF hpBedingungen[hk] <> "" THEN JSON_SET_STRING(hpE, "bedingung", hpBedingungen[hk])
        IF NOT hpIstAktiv(hk) THEN JSON_SET_BOOL(hpE, "aktiv", FALSE)
        IF hpTreffer$(hk) <> "" THEN JSON_SET_STRING(hpE, "treffer", hpTreffer$(hk))
        IF hpLog$(hk) <> "" THEN JSON_SET_STRING(hpE, "log", hpLog$(hk))
        JSON_APPEND_JSON(konfig, "haltepunkte", hpE)
    NEXT
    JSON_SET_JSON(konfig, "lesezeichen", JSON_NEW_ARRAY())
    FOR hk = 0 TO LEN(lzZeilen) - 1
        DIM lzE AS JSON_HANDLE : lzE = JSON_NEW_OBJECT()
        JSON_SET_STRING(lzE, "datei", lzDateien[hk])
        JSON_SET_INT(lzE, "zeile", lzZeilen[hk])
        JSON_APPEND_JSON(konfig, "lesezeichen", lzE)
    NEXT
    JSON_SET_JSON(konfig, "falten_pfade", JSON_PARSE("[]"))
    JSON_SET_JSON(konfig, "falten_zeilen", JSON_PARSE("[]"))
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(faltPfade) - 1
        JSON_APPEND_STRING(konfig, "falten_pfade", faltPfade[fi])
        JSON_APPEND_STRING(konfig, "falten_zeilen", faltListe[fi])
    NEXT
    JSON_SET_INT(konfig, "aktiv", aktiverTab)
    ' Dieselbe Sitzung noch einmal unter dem PROJEKTordner: wer an zwei
    ' Sachen arbeitet, will beim Wechsel nicht die Reiter der anderen
    ' wiederfinden. Der laufende Ordner kommt nach vorn, alte fallen hinten
    ' heraus -- eine Datei, die jeden je besuchten Ordner behaelt, waechst
    ' fuer immer.
    DIM offen AS ARRAY OF STRING : offen = []
    DIM pi AS INTEGER
    FOR pi = 0 TO tabAnzahl - 1
        IF tabPfade[pi] <> "" THEN ARRAY_PUSH(offen, tabPfade[pi])
    NEXT
    DIM alt AS INTEGER : alt = ARRAY_INDEXOF(projOrdner, projektOrdner)
    IF alt >= 0 THEN
        ARRAY_REMOVE_AT(projOrdner, alt) : ARRAY_REMOVE_AT(projDateien, alt) : ARRAY_REMOVE_AT(projAktiv, alt)
    END IF
    ARRAY_INSERT(projOrdner, 0, projektOrdner)
    ARRAY_INSERT(projDateien, 0, JOIN$(offen, "|"))
    ARRAY_INSERT(projAktiv, 0, aktiverTab)
    WHILE LEN(projOrdner) > PROJEKTE_MAX
        DIM letzt AS INTEGER : letzt = LEN(projOrdner) - 1
        ARRAY_REMOVE_AT(projOrdner, letzt) : ARRAY_REMOVE_AT(projDateien, letzt) : ARRAY_REMOVE_AT(projAktiv, letzt)
    WEND
    JSON_SET_JSON(konfig, "projekte", JSON_NEW_ARRAY())
    DIM pk AS INTEGER
    FOR pk = 0 TO LEN(projOrdner) - 1
        DIM e AS JSON_HANDLE : e = JSON_NEW_OBJECT()
        JSON_SET_STRING(e, "ordner", projOrdner[pk])
        JSON_SET_INT(e, "aktiv", projAktiv[pk])
        JSON_SET_JSON(e, "sitzung", JSON_NEW_ARRAY())
        DIM sp AS STRING
        IF projDateien[pk] <> "" THEN
            FOR EACH sp IN SPLIT$(projDateien[pk], "|")
                JSON_APPEND_STRING(e, "sitzung", sp)
            NEXT
        END IF
        JSON_APPEND_JSON(konfig, "projekte", e)
    NEXT
    TRY
        MKDIR(DIRNAME(konfigPfad))
        WRITEALL(konfigPfad, JSON_STRINGIFY(konfig))
    CATCH e
        ' ein schreibgeschuetztes Profil ist kein Grund, die Arbeit zu stoeren
    END TRY
END SUB

SUB zuletztAnzeigen()
    DIM k AS INTEGER
    FOR k = 0 TO ZULETZT_MAX - 1
        IF k < LEN(zuletzt) THEN
            GUI_MENU_TEXT(miZuletzt[k], BASENAME(zuletzt[k]) + "   (" + DIRNAME(zuletzt[k]) + ")")
            GUI_MENU_ENABLE(miZuletzt[k], TRUE)
        ELSE
            GUI_MENU_TEXT(miZuletzt[k], "-")
            GUI_MENU_ENABLE(miZuletzt[k], FALSE)
        END IF
    NEXT
    GUI_LISTBOX_CLEAR(lstWkZuletzt)
    FOR k = 0 TO LEN(zuletzt) - 1
        GUI_LISTBOX_ADD(lstWkZuletzt, BASENAME(zuletzt[k]) + "   (" + DIRNAME(zuletzt[k]) + ")")
    NEXT
END SUB

SUB zuletztMerken(pfad AS STRING)
    IF pfad = "" THEN RETURN
    DIM k AS INTEGER : k = ARRAY_INDEXOF(zuletzt, pfad)
    IF k >= 0 THEN ARRAY_REMOVE_AT(zuletzt, k)
    ARRAY_INSERT(zuletzt, 0, pfad)
    WHILE LEN(zuletzt) > ZULETZT_MAX : ARRAY_REMOVE_AT(zuletzt, LEN(zuletzt) - 1) : WEND
    zuletztAnzeigen()
    konfigSichern()
END SUB

SUB schriftSetzen(groesse AS INTEGER)
    codeGroesse = MAX(10, MIN(32, groesse))
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_SET_FONT_SIZE(tabFelder[i], codeGroesse)
    NEXT
    GUI_SET_TEXT(lblStatus, tr$("Schrift: ") + STR$(codeGroesse) + tr$(" px"))
    ' Das Drehfeld der Einstellungen mitziehen -- sind sie offen, setzte es
    ' die Schrift sonst im naechsten Bild auf seinen alten Wert zurueck.
    GUI_SET_VALUE(spSchrift, codeGroesse)
    protokoll("schrift " + STR$(codeGroesse))
    konfigSichern()
END SUB

SUB listenSchrift(groesse AS INTEGER)
    listenGroesse = MAX(10, MIN(32, groesse))
    GUI_SET_FONT_SIZE(lstGliederung, listenGroesse)
    GUI_SET_FONT_SIZE(lstAusgabe, listenGroesse)
    GUI_SET_FONT_SIZE(lstTerminal, listenGroesse)
    GUI_SET_FONT_SIZE(lstProbleme, listenGroesse)
    protokoll("listenschrift " + STR$(listenGroesse))
END SUB

SUB handbuchSchrift(groesse AS INTEGER)
    handbuchGroesse = MAX(10, MIN(32, groesse))
    GUI_SET_FONT_SIZE(rtHandbuch, handbuchGroesse)
    GUI_SET_FONT_SIZE(taHandbuch, handbuchGroesse)
    protokoll("handbuchschrift " + STR$(handbuchGroesse))
END SUB

' Strg+Rad zoomt die Code-Felder, ein Punkt je Schritt -- ueberall im
' Fenster, nicht nur ueber dem Code: wer zoomt, sieht auf den Text, nicht
' auf die Maus. Die gui rollt mit gedrueckter Strg-Taste nichts (die
' Laufzeit laesst das Rad dann dem Programm), der Inhalt springt also nicht.
SUB radZoom()
    IF NOT (KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)) THEN RETURN
    DIM r AS FLOAT : r = MOUSEWHEEL_Y()
    IF r > 0 THEN schriftSetzen(codeGroesse + 1)
    IF r < 0 THEN schriftSetzen(codeGroesse - 1)
END SUB

SUB debugPanelZeigen(an AS BOOLEAN)
    debugSichtbar = an
    ' Bei ausgeblendeter unterer Leiste ist keins von beiden zu sehen --
    ' `debugSichtbar` merkt sich trotzdem, welches dran waere.
    DIM p AS BOOLEAN : p = (NOT an) AND untenAn
    DIM d AS BOOLEAN : d = an AND untenAn
    GUI_SET_VISIBLE(lblProbleme, p) : GUI_SET_VISIBLE(lstProbleme, p) : GUI_SET_VISIBLE(lblHilfe, p) : GUI_SET_VISIBLE(lblHilfeKopf, p)
    GUI_SET_VISIBLE(lblDebug, d) : GUI_SET_VISIBLE(tblVars, d)
    GUI_SET_VISIBLE(btnWeiter, d) : GUI_SET_VISIBLE(btnDrueber, d) : GUI_SET_VISIBLE(btnHinein, d)
    GUI_SET_VISIBLE(btnHeraus, d) : GUI_SET_VISIBLE(btnStoppD, d)
    GUI_SET_VISIBLE(btnBisMarke, d) : GUI_SET_VISIBLE(tblStapel, d) : GUI_SET_VISIBLE(tblWatch, d)
    GUI_SET_VISIBLE(tfWatch, d) : GUI_SET_VISIBLE(btnWatchWeg, d)
END SUB

SUB leistenSetzen(seiten AS BOOLEAN, unten AS BOOLEAN)
    seitenAn = seiten
    untenAn = unten
    GUI_MENU_CHECK(miSeiten, seitenAn)
    GUI_MENU_CHECK(miUnten, untenAn)
    layout()
    konfigSichern()
    protokoll("leisten seite " + IIF(seitenAn, "an", "aus") + " unten " + IIF(untenAn, "an", "aus") + " code " + STR$(GUI_GET_X(aktivesFeldOderWk())) + "+" + STR$(GUI_GET_W(aktivesFeldOderWk())) + " hoch " + STR$(GUI_GET_H(aktivesFeldOderWk())))
END SUB

' Fuers Protokoll: das Code-Feld, oder ohne Reiter die Willkommensseite --
' beide stehen auf derselben Flaeche.
FUNCTION aktivesFeldOderWk() AS GUI_WIDGET
    IF aktiverTab >= 0 THEN RETURN tabFelder[aktiverTab]
    RETURN lblWkTitel
END FUNCTION

SUB layout()
    DIM w AS INTEGER : w = SCREENWIDTH()
    DIM h AS INTEGER : h = SCREENHEIGHT()
    GUI_WINDOW_SET_BOUNDS(win, 0, 0, w, h)
    ' Widget-Koordinaten zaehlen ab dem INHALT: Menueleiste und Reiterleiste
    ' liegen darueber (zusammen 56 px) und gehen von der Hoehe ab -- sonst
    ' rutschen Eingabezeile und Status unter den Fensterrand (Stand 1 tat das).
    DIM kopf AS INTEGER : kopf = 56
    DIM hi AS INTEGER : hi = h - kopf
    DIM oben AS INTEGER : oben = 4
    ' Die Werkzeugleiste liegt ueber allem anderen und nimmt sich ihre Hoehe.
    DIM leisteH AS INTEGER : leisteH = 0
    IF leisteAn THEN leisteH = 34
    GUI_SET_VISIBLE(leiste, leisteAn)
    IF leisteAn THEN GUI_SET_BOUNDS(leiste, 0, oben - 4, w, 36)
    DIM statusH AS INTEGER : statusH = 24
    DIM eingabeH AS INTEGER : eingabeH = 30
    DIM untenH AS INTEGER : untenH = IIF(untenAn, hoeheUnten, -4)
    DIM mitteH AS INTEGER : mitteH = hi - oben - untenH - statusH - eingabeH - 12 - leisteH
    oben = oben + leisteH
    ' links: Projektbaum oben, Gliederung darunter
    DIM baumH AS INTEGER : baumH = (mitteH - 22) * 3 \ 5
    GUI_SET_VISIBLE(lblProjekt, seitenAn) : GUI_SET_VISIBLE(baum, seitenAn)
    GUI_SET_VISIBLE(tfBaumFilter, seitenAn)
    GUI_SET_VISIBLE(lblGliederung, seitenAn) : GUI_SET_VISIBLE(lstGliederung, seitenAn)
    ' Der Projektname nimmt sich, was er braucht (hoechstens die Haelfte),
    ' das Filterfeld den Rest -- mit fester Haelfte war es bei der groesseren
    ' Schrift so schmal, dass "Filter ..." nicht mehr hineinpasste.
    DIM projB AS INTEGER : projB = MIN((breiteLinks - 16) \ 2 - 4, TEXT_WIDTH(GUI_TEXT(lblProjekt)) + 8)
    GUI_SET_BOUNDS(lblProjekt, 8, oben, projB, 18)
    GUI_SET_BOUNDS(tfBaumFilter, 12 + projB, oben - 2, breiteLinks - 20 - projB, 24)
    GUI_SET_BOUNDS(baum, 8, oben + 22, breiteLinks - 16, baumH)
    GUI_SET_BOUNDS(lblGliederung, 8, oben + 30 + baumH, breiteLinks - 16, 18)
    GUI_SET_BOUNDS(lstGliederung, 8, oben + 52 + baumH, breiteLinks - 16, mitteH - baumH - 52)
    DIM links AS INTEGER : links = IIF(seitenAn, breiteLinks, 8)
    DIM ex AS INTEGER : ex = links
    DIM ew AS INTEGER : ew = w - links - 8
    ' Die Spur steht ueber dem Code und nimmt sich 20 Punkte von seiner Hoehe.
    DIM spurH AS INTEGER : spurH = 20
    GUI_SET_BOUNDS(lblSpur, ex, oben - 1, ew, 20)
    GUI_SET_VISIBLE(lblSpur, tabAnzahl > 0)
    oben = oben + spurH
    mitteH = mitteH - spurH
    ' Die Uebersichtskarte nimmt sich einen Streifen am rechten Rand.
    DIM kartenB AS INTEGER : kartenB = 0
    IF minimapAn THEN kartenB = 92
    GUI_SET_VISIBLE(karte, minimapAn)
    IF minimapAn THEN GUI_SET_BOUNDS(karte, ex + ew - kartenB, oben, kartenB - 6, mitteH)
    ew = ew - kartenB
    ' Geteilt: der linke Reiter bekommt die linke Haelfte, alle anderen die
    ' rechte -- so hat jede Haelfte ein ECHTES Feld, keine Spiegelung.
    DIM halbeB AS INTEGER : halbeB = (ew - 6) \ 2
    DIM i AS INTEGER
    IF spiegelAn AND taSpiegel >= 0 THEN GUI_SET_BOUNDS(taSpiegel, ex, oben, halbeB, mitteH)
    FOR i = 0 TO tabAnzahl - 1
        IF geteilt AND linkerTab >= 0 AND linkerTab < tabAnzahl AND i = linkerTab THEN
            GUI_SET_BOUNDS(tabFelder[i], ex, oben, halbeB, mitteH)
        ELSEIF spiegelAn THEN
            GUI_SET_BOUNDS(tabFelder[i], ex + halbeB + 6, oben, ew - halbeB - 6, mitteH)
        ELSEIF geteilt AND linkerTab >= 0 AND linkerTab < tabAnzahl THEN
            GUI_SET_BOUNDS(tabFelder[i], ex + halbeB + 6, oben, ew - halbeB - 6, mitteH)
        ELSE
            GUI_SET_BOUNDS(tabFelder[i], ex, oben, ew, mitteH)
        END IF
    NEXT
    ' Willkommensseite auf derselben Flaeche
    DIM wx AS INTEGER : wx = ex + 40
    GUI_SET_BOUNDS(lblWkTitel, wx, oben + 30, ew - 80, 44)
    IF wkSchriftzug THEN
        ' Schriftzug links oben, der Satz daneben -- darunter bleibt alles,
        ' wo es war (Knoepfe ab oben + 130).
        GUI_SET_BOUNDS(imgWkTitel, wx, oben + 10, WK_BILD_B, WK_BILD_H)
        GUI_SET_BOUNDS(lblWkUnter, wx + WK_BILD_B + 20, oben + 52, MAX(120, ew - 80 - WK_BILD_B - 20), 18)
        GUI_SET_WRAP(lblWkUnter, MAX(120, ew - 80 - WK_BILD_B - 20))
    ELSE
        GUI_SET_BOUNDS(lblWkUnter, wx, oben + 84, ew - 80, 18)
        GUI_SET_WRAP(lblWkUnter, ew - 80)
    END IF
    GUI_SET_BOUNDS(btnWkNeu, wx, oben + 130, 130, 30)
    GUI_SET_BOUNDS(btnWkOeffnen, wx + 140, oben + 130, 150, 30)
    GUI_SET_BOUNDS(btnWkBeispiele, wx + 300, oben + 130, 180, 30)
    GUI_SET_BOUNDS(btnWkThemen, wx + 490, oben + 130, 190, 30)
    ' Die Kacheln: vier nebeneinander, so viele Reihen wie Platz ist; was
    ' nicht passt, blaettert das Mausrad heran (kachelVersatz).
    GUI_SET_BOUNDS(lblKacheln, wx, oben + 176, ew - 80, 18)
    DIM kb AS INTEGER : kb = MIN(190, (ew - 80 - 3 * 12) \ 4)
    ' Hoehe: Bild 16:10 der Innenbreite (6 Punkte Rand), Titel, und mit
    ' Beschreibung zwei Zeilen in der Schrift der IDE -- die Kachel kuerzt,
    ' was darueber hinausgeht, und der Tooltip sagt den Rest.
    DIM khb AS INTEGER : khb = (kb - 12) * 10 \ 16
    DIM kh AS INTEGER : kh = khb + 40
    IF kachelMitText THEN kh = kh + 2 * (TEXT_HEIGHT() + 3)
    DIM reihenGesamt AS INTEGER : reihenGesamt = (kachelAnzahl + 3) \ 4
    DIM reihen AS INTEGER : reihen = 0
    IF kb >= 110 THEN reihen = MIN(reihenGesamt, MAX(0, (mitteH - 420) \ (kh + 10)))
    ' Ohne Beschreibungen (die acht von frueher) bleibt es bei zwei Reihen.
    IF NOT kachelMitText THEN reihen = MIN(2, reihen)
    kachelVersatz = MAX(0, MIN(kachelVersatz, reihenGesamt - reihen))
    IF reihen <> kachelReihenSichtbar THEN protokoll("kacheln sichtbar " + STR$(reihen) + " von " + STR$(reihenGesamt))
    kachelReihenSichtbar = reihen
    kfX = wx : kfY = oben + 198 : kfB = ew - 80 : kfH = reihen * (kh + 10)
    DIM kk AS INTEGER
    FOR kk = 0 TO kachelAnzahl - 1
        DIM kReihe AS INTEGER : kReihe = kk \ 4 - kachelVersatz
        DIM sichtbar AS BOOLEAN : sichtbar = tabAnzahl = 0 AND kReihe >= 0 AND kReihe < reihen
        GUI_SET_VISIBLE(kachelKarte[kk], sichtbar)
        IF sichtbar THEN
            DIM kx AS INTEGER : kx = wx + (kk MOD 4) * (kb + 12)
            DIM ky AS INTEGER : ky = oben + 198 + kReihe * (kh + 10)
            GUI_SET_BOUNDS(kachelKarte[kk], kx, ky, kb, kh)
        END IF
    NEXT
    IF reihen > 0 AND reihen < reihenGesamt THEN
        GUI_SET_TEXT(lblKacheln, tr$("Showcase -- ein Klick öffnet das Beispiel  (Reihe ") + STR$(kachelVersatz + 1) + "-" + STR$(kachelVersatz + reihen) + tr$(" von ") + STR$(reihenGesamt) + tr$(", Mausrad blättert)"))
    ELSE
        GUI_SET_TEXT(lblKacheln, tr$("Showcase -- ein Klick öffnet das Beispiel"))
    END IF
    GUI_SET_VISIBLE(lblKacheln, tabAnzahl = 0 AND reihen > 0)
    DIM nachKacheln AS INTEGER : nachKacheln = oben + 198 + reihen * (kh + 10) + 8
    IF reihen = 0 THEN nachKacheln = oben + 180
    GUI_SET_BOUNDS(lblWkZuletzt, wx, nachKacheln, ew - 80, 18)
    DIM zlH AS INTEGER : zlH = MAX(60, MIN(200, oben + mitteH - nachKacheln - 70))
    GUI_SET_BOUNDS(lstWkZuletzt, wx, nachKacheln + 22, MIN(ew - 80, 620), zlH)
    GUI_SET_BOUNDS(lblWkKuerzel, wx, nachKacheln + 34 + zlH, MIN(ew - 80, 620), 18)
    GUI_SET_WRAP(lblWkKuerzel, MIN(ew - 80, 620))
    willkommenZeigen(tabAnzahl = 0)
    DIM uy AS INTEGER : uy = oben + mitteH + 4
    DIM halb AS INTEGER : halb = (w - 24) \ 2
    GUI_SET_VISIBLE(lblAusgabe, untenAn) : GUI_SET_VISIBLE(lstAusgabe, untenAn AND NOT terminalAn)
    GUI_SET_VISIBLE(lstTerminal, untenAn AND terminalAn)
    GUI_SET_VISIBLE(btnReiterAusgabe, untenAn) : GUI_SET_VISIBLE(btnReiterTerminal, untenAn)
    GUI_SET_VISIBLE(btnTermStopp, untenAn AND terminalAn AND termProz >= 0)
    GUI_SET_BOUNDS(btnReiterAusgabe, 8, uy - 1, 90, 20)
    GUI_SET_BOUNDS(btnReiterTerminal, 102, uy - 1, 90, 20)
    GUI_SET_BOUNDS(lblAusgabe, 200, uy, MAX(40, halb - 390), 18)
    GUI_SET_VISIBLE(tfAusgabeFilter, untenAn AND NOT terminalAn)
    GUI_SET_BOUNDS(tfAusgabeFilter, 8 + halb - 180, uy - 1, 180, 20)
    GUI_SET_BOUNDS(btnTermStopp, 8 + halb - 90, uy - 1, 90, 20)
    GUI_SET_BOUNDS(lstAusgabe, 8, uy + 20, halb, hoeheUnten - 20)
    GUI_SET_BOUNDS(lstTerminal, 8, uy + 20, halb, hoeheUnten - 20)
    GUI_SET_BOUNDS(lblProbleme, 16 + halb, uy, halb, 18)
    GUI_SET_BOUNDS(lstProbleme, 16 + halb, uy + 20, halb, (hoeheUnten - 20) \ 2 - 4)
    GUI_SET_BOUNDS(lblHilfeKopf, 16 + halb, uy + 20 + (hoeheUnten - 20) \ 2, halb, 18)
    GUI_SET_BOUNDS(lblHilfe, 24 + halb, uy + 42 + (hoeheUnten - 20) \ 2, halb - 8, (hoeheUnten - 20) \ 2 - 22)
    GUI_SET_WRAP(lblHilfe, halb - 16)
    ' Debugger-Panel auf derselben Flaeche
    GUI_SET_BOUNDS(lblDebug, 16 + halb, uy, halb, 18)
    GUI_SET_BOUNDS(btnWeiter, 16 + halb, uy + 20, 100, 26)
    GUI_SET_BOUNDS(btnDrueber, 122 + halb, uy + 20, 108, 26)
    GUI_SET_BOUNDS(btnHinein, 236 + halb, uy + 20, 104, 26)
    GUI_SET_BOUNDS(btnHeraus, 346 + halb, uy + 20, 70, 26)
    GUI_SET_BOUNDS(btnStoppD, 422 + halb, uy + 20, 60, 26)
    GUI_SET_BOUNDS(btnBisMarke, 488 + halb, uy + 20, 84, 26)
    ' Variablen links, Stapel und Ueberwachen rechts uebereinander.
    DIM vw AS INTEGER : vw = (halb * 55) \ 100
    DIM hh AS INTEGER : hh = MAX(60, hoeheUnten - 52)
    GUI_SET_BOUNDS(tblVars, 16 + halb, uy + 52, vw, hh)
    DIM rx AS INTEGER : rx = 16 + halb + vw + 6
    DIM rw AS INTEGER : rw = MAX(60, halb - vw - 6)
    DIM sh AS INTEGER : sh = MAX(30, (hh - 32) \ 2)
    GUI_SET_BOUNDS(tblStapel, rx, uy + 52, rw, sh)
    GUI_SET_BOUNDS(tblWatch, rx, uy + 56 + sh, rw, MAX(30, hh - sh - 36))
    GUI_SET_BOUNDS(tfWatch, rx, uy + 52 + hh - 26, MAX(30, rw - 86), 26)
    GUI_SET_BOUNDS(btnWatchWeg, rx + rw - 80, uy + 52 + hh - 26, 80, 26)
    debugPanelZeigen(debugSichtbar)
    DIM ey AS INTEGER : ey = hi - statusH - eingabeH - 4
    GUI_SET_BOUNDS(tfEingabe, 8, ey, w - 108, 26)
    GUI_SET_BOUNDS(btnEingabe, w - 92, ey, 84, 26)
    GUI_SET_BOUNDS(lblStatus, 0, hi - statusH, w, statusH)
END SUB

' --- Reiter ------------------------------------------------------------
SUB reiterNeuSetzen()
    DIM titel[MAX(tabAnzahl, 1)] AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        DIM t AS STRING
        IF tabPfade[i] = "" THEN t = "Unbenannt" ELSE t = BASENAME(tabPfade[i])
        IF GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN t = t + " *"
        titel[i] = t
    NEXT
    IF tabAnzahl = 0 THEN titel[0] = "Drachenhauch"
    GUI_TABS(win, titel)
    IF aktiverTab >= 0 THEN GUI_SET_ACTIVE_TAB(win, aktiverTab)
END SUB

' Den Schriftzug hinter ein Code-Feld legen (oder wegnehmen). Auf dem
' hellen Thema etwas kraeftiger, dort verschluckt der Grund mehr.
SUB wasserzeichenSetzen(ta AS GUI_WIDGET)
    IF wasserzeichenAn AND hgBild >= 0 THEN
        GUI_TEXTAREA_BACKGROUND(ta, hgBild, IIF(hell, 24, 22))
    ELSE
        GUI_TEXTAREA_BACKGROUND(ta, -1)
    END IF
END SUB

SUB wasserzeichenAlle()
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        wasserzeichenSetzen(tabFelder[i])
    NEXT
    IF taSpiegel >= 0 THEN wasserzeichenSetzen(taSpiegel)
    protokoll("wasserzeichen " + IIF(wasserzeichenAn AND hgBild >= 0, "an", "aus"))
END SUB

SUB uiSchrift(groesse AS INTEGER)
    uiGroesse = MAX(12, MIN(22, groesse))
    IF uiFont >= 0 THEN TEXT_SIZE(uiGroesse)
    protokoll("uischrift " + STR$(uiGroesse))
END SUB

SUB feldEinrichten(ta AS GUI_WIDGET)
    wasserzeichenSetzen(ta)
    IF codeFont >= 0 THEN GUI_SET_FONT(ta, codeFont)
    GUI_SET_FONT_SIZE(ta, codeGroesse)
    GUI_TEXTAREA_SET(ta, "zeilennummern", 1)
    GUI_TEXTAREA_SET(ta, "aktive_zeile", 1)
    GUI_TEXTAREA_SET(ta, "tab_fuegt_ein", 1)
    GUI_TEXTAREA_SET(ta, "tabbreite", 4)
    GUI_TEXTAREA_SET(ta, "umbruch", IIF(umbruchAn, 1, 0))
    GUI_TEXTAREA_SET(ta, "einzugslinien", IIF(linienAn, 1, 0))
    GUI_TEXTAREA_SET(ta, "kopfzeilen", IIF(kopfAn, 3, 0))
    GUI_TEXTAREA_SET(ta, "hinweise_klickbar", 1)
    ' Einrueckung beim Umbruch: die Laufzeit uebernimmt die der laufenden
    ' Zeile, die Woerter der SPRACHE kommen von hier. `THEN` steht in der
    ' Ende-Liste, weil `IF x THEN y = 1` sonst auch einruecken wuerde.
    GUI_TEXTAREA_SET(ta, "auto_einzug", 1)
    ' Der Tabulator klappt einen Schnipsel auf, wenn sein Kuerzel links der
    ' Marke steht -- sonst rueckt er ein wie immer.
    ' Der Tabulator gehoert seit Stand 14 der IDE: er hat drei Bedeutungen
    ' (zum naechsten Platzhalter, Schnipsel aufklappen, einruecken), und nur
    ' sie kennt die Reihenfolge. Darum `tab_meldet` statt GUI_TEXTAREA_ABBREV
    ' -- das Feld entschiede sonst die ersten beiden selbst.
    GUI_TEXTAREA_SET(ta, "tab_meldet", 1)
    GUI_TEXTAREA_INDENT_WORDS(ta, _
        ["SUB", "FUNCTION", "CLASS", "STRUCT", "PROPERTY", "OPERATOR", "FOR", _
         "WHILE", "REPEAT", "DO", "SELECT", "CASE", "TRY", "WITH", "ELSE", _
         "ELSEIF", "ELIF", "CATCH", "FINALLY", "ENUM"], _
        ["THEN"], _
        ["END", "NEXT", "WEND", "UNTIL", "LOOP", "ELSE", "ELSEIF", "ELIF", _
         "CATCH", "FINALLY", "CASE"])
    geruestSetzenAn(ta)
    klammernSetzenAn(ta)
END SUB

SUB klammernSetzenAn(ta AS GUI_WIDGET)
    GUI_TEXTAREA_PAIRS(ta, IIF(klammernAn, "()[]{}" + CHR$(34) + CHR$(34), ""))
END SUB

SUB klammernSetzen(an AS BOOLEAN)
    klammernAn = an
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        klammernSetzenAn(tabFelder[i])
    NEXT
    konfigSichern()
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Klammern schließen an."), tr$("Klammern schließen aus.")))
    protokoll("klammern " + IIF(an, "an", "aus"))
END SUB

' Das Geruest, das mitwaechst: wer `IF x > 0 THEN` schreibt und Enter
' drueckt, bekommt das `END IF` gleich mit und steht dazwischen.
'
' Die Paare stehen HIER und nicht in der Laufzeit -- sie kennt keine
' Sprache. `CASE`, `ELSE` und `ELSEIF` fehlen mit Absicht: sie ruecken zwar
' ein, schliessen aber nichts, ihr `END` gehoert dem `SELECT` bzw. `IF`
' darueber. `REPEAT` bekommt `UNTIL TRUE`, weil ein nacktes `UNTIL` nicht
' uebersetzt -- ein Geruest, das den Fehlerstrich anwirft, ist keins.
SUB geruestSetzenAn(ta AS GUI_WIDGET)
    IF NOT geruestAn THEN
        GUI_TEXTAREA_CLOSE_WORDS(ta, [], [])
        RETURN
    END IF
    GUI_TEXTAREA_CLOSE_WORDS(ta, _
        ["IF", "SUB", "FUNCTION", "CLASS", "STRUCT", "PROPERTY", "OPERATOR", _
         "FOR", "WHILE", "REPEAT", "DO", "SELECT", "TRY", "WITH", "ENUM"], _
        ["END IF", "END SUB", "END FUNCTION", "END CLASS", "END STRUCT", _
         "END PROPERTY", "END OPERATOR", "NEXT", "WEND", "UNTIL TRUE", "LOOP", _
         "END SELECT", "END TRY", "END WITH", "END ENUM"])
END SUB

SUB geruestSetzen(an AS BOOLEAN)
    geruestAn = an
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        geruestSetzenAn(tabFelder[i])
    NEXT
    konfigSichern()
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Gerüst beim Tippen an."), tr$("Gerüst beim Tippen aus.")))
    protokoll("geruest " + IIF(an, "an", "aus"))
END SUB

' Einrueckungslinien: ein Strich je Stufe, unter dem Text. Wie der Umbruch
' fuer ALLE Reiter.
SUB linienSetzen(an AS BOOLEAN)
    linienAn = an
    GUI_MENU_CHECK(miLinien, an)
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_TEXTAREA_SET(tabFelder[i], "einzugslinien", IIF(an, 1, 0))
    NEXT
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Einrückungslinien an."), tr$("Einrückungslinien aus.")))
    protokoll("linien " + IIF(an, "an", "aus"))
    konfigSichern()
END SUB

' Mitlaufender Blockkopf, wie die Linien fuer ALLE Reiter (und die
' geteilte Ansicht). Welche Zeilen Bloecke sind, sagt dieselbe Liste wie
' fuer die Faltung.
SUB kopfSetzen(an AS BOOLEAN)
    kopfAn = an
    GUI_MENU_CHECK(miKopf, an)
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_TEXTAREA_SET(tabFelder[i], "kopfzeilen", IIF(an, 3, 0))
    NEXT
    IF taSpiegel >= 0 THEN GUI_TEXTAREA_SET(taSpiegel, "kopfzeilen", IIF(an, 3, 0))
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Mitlaufender Blockkopf an."), tr$("Mitlaufender Blockkopf aus.")))
    protokoll("blockkopf " + IIF(an, "an", "aus"))
    konfigSichern()
END SUB

' Der Umbruch gilt fuer ALLE Reiter, nicht nur den vorderen -- ein Schalter,
' der je Datei etwas anderes tut, ist einer, den man vergisst.
SUB umbruchSetzen(an AS BOOLEAN)
    umbruchAn = an
    GUI_MENU_CHECK(miUmbruch, an)
    ' Der Knopf in der Leiste kippt sich beim Klick selbst -- gesetzt wird er
    ' trotzdem hier, damit Menue, Kuerzel und Einstellungen ihn mitnehmen.
    GUI_TOOLBAR_SET_CHECKED(leiste, wzUmbruch, an)
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_TEXTAREA_SET(tabFelder[i], "umbruch", IIF(an, 1, 0))
    NEXT
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Zeilenumbruch an."), tr$("Zeilenumbruch aus.")))
    GUI_STATUSBAR_SET(lblStatus, sfUmbruch, IIF(an, tr$("Umbruch an"), tr$("Umbruch aus")))
    konfigSichern()
END SUB

' --- Einstellungen ----------------------------------------------------
' Was im Ueber-Kasten steht. Die Fassung kommt von der LAUFZEIT (VERSION$),
' nicht aus einem Text im Quelltext -- der stand hier auf "Stand 7", als die
' IDE laengst weiter war.
FUNCTION ueberText$() AS STRING
    RETURN "Drachenhauch-IDE -- geschrieben in Drachenhauch." + NL + _
           "Laufzeit: dhrt " + VERSION$() + NL + _
           "Handbuch: " + docsOrdner + NL + _
           "Beispiele: " + beispielOrdner
END FUNCTION

' Das Info-Fenster: Symbol und Schriftzug aus daten/bilder, darunter der
' Text. Ein eigenes Fenster statt GUI_DIALOG, weil ein Dialog nur Text kennt.
DIM winUeber AS GUI_WINDOW : winUeber = GUI_WINDOW(tr$("Über Drachenhauch"), 400, 150, 480, 330)
GUI_WINDOW_VISIBLE(winUeber, FALSE)
DIM ueberBilder AS INTEGER : ueberBilder = 0
IF FILEEXISTS(PATHJOIN(bilderOrdner, "logo.png")) THEN
    DIM imgUeberLogo AS GUI_WIDGET
    imgUeberLogo = GUI_IMAGE(winUeber, 16, 16, 112, 112, IMAGE_SCALE(LOADIMAGE(PATHJOIN(bilderOrdner, "logo.png")), 112, 112))
    ueberBilder = ueberBilder + 1
END IF
IF FILEEXISTS(PATHJOIN(bilderOrdner, "schriftzug.png")) THEN
    DIM imgUeberZug AS GUI_WIDGET
    imgUeberZug = GUI_IMAGE(winUeber, 144, 16, 300, 140, bildEingepasst(PATHJOIN(bilderOrdner, "schriftzug.png"), 300, 140))
    GUI_IMAGE_MODE(imgUeberZug, "mitte")
    ueberBilder = ueberBilder + 1
END IF
DIM lblUeber AS GUI_WIDGET : lblUeber = GUI_LABEL(winUeber, "", 16, 168)
GUI_SET_WRAP(lblUeber, 448)
DIM btnUeberOk AS GUI_WIDGET : btnUeberOk = GUI_BUTTON(winUeber, tr$("OK"), 364, 256, 100, 30)
GUI_WINDOW_DEFAULT(winUeber, btnUeberOk)
GUI_WINDOW_CANCEL(winUeber, btnUeberOk)
DIM ueberOffen AS BOOLEAN : ueberOffen = FALSE

SUB ueberZeigen()
    GUI_SET_TEXT(lblUeber, ueberText$())
    GUI_WINDOW_SET_BOUNDS(winUeber, (SCREENWIDTH() - 480) \ 2, 150, 480, 330)
    GUI_WINDOW_VISIBLE(winUeber, TRUE)
    GUI_WINDOW_MODAL(winUeber, TRUE)
    GUI_FOCUS(btnUeberOk)
    ueberOffen = TRUE
    protokoll("ueber " + VERSION$())
    protokoll("ueber bilder " + STR$(ueberBilder))
END SUB

' Die Vorspann-Videos: jede .mp4 in daten/video, nach Namen.
FUNCTION vorspannListe() AS ARRAY OF STRING
    DIM raus AS ARRAY OF STRING : raus = []
    ' FILEEXISTS kennt nur Dateien -- ein fehlender Ordner ist ein Fehler
    ' von DIRLIST, und dann gibt es eben keinen Vorspann.
    TRY
        DIM n AS STRING
        FOR EACH n IN DIRLIST(vorspannOrdner, "*.mp4")
            ARRAY_PUSH(raus, BASENAME(n))
        NEXT
    CATCH e
        RETURN raus
    END TRY
    SORT(raus)
    RETURN raus
END FUNCTION

' Wie ein Vorspann in der Auswahl heisst: der Dateiname ohne Endung,
' "_" als Leerzeichen, vorn gross -- "vorspann_2.mp4" wird "Vorspann 2".
FUNCTION vorspannName$(datei AS STRING) AS STRING
    DIM n AS STRING : n = datei
    IF LOWER$(RIGHT$(n, 4)) = ".mp4" THEN n = LEFT$(n, LEN(n) - 4)
    n = REPLACE$(n, "_", " ")
    IF n = "" THEN RETURN datei
    RETURN UPPER$(LEFT$(n, 1)) + MID$(n, 1, LEN(n))
END FUNCTION

' Ein Video auf der ganzen Flaeche, eingepasst (schwarze Raender, wo das
' Seitenverhaeltnis nicht passt). Jede Taste und jeder Klick
' ueberspringt, das Kreuz liefert "kreuz". Kann dieser Bau keine Videos
' oder ist die Datei kaputt, steht es im Protokoll, und es geht weiter.
FUNCTION vorspannSpielen(pfad AS STRING) AS STRING
    DIM vspWeg AS STRING : vspWeg = ""
    TRY
        DIM vsp AS VIDEO : vsp = VIDEO_LOAD(pfad)
        VIDEO_PLAY(vsp)
        WHILE vspWeg = ""
            IF WINDOW_CLOSE_REQUESTED() THEN vspWeg = "kreuz"
            IF QUITREQUESTED() AND vspWeg = "" THEN vspWeg = "ende"
            IF KEY_ANY_HIT() >= 0 OR MOUSE_HIT(0) OR MOUSE_HIT(1) THEN vspWeg = "uebersprungen"
            DIM vsb AS INTEGER : vsb = SCREENWIDTH()
            DIM vsh AS INTEGER : vsh = SCREENHEIGHT()
            DIM vsm AS FLOAT : vsm = MIN(vsb / VIDEO_WIDTH(vsp), vsh / VIDEO_HEIGHT(vsp))
            DIM vw AS INTEGER : vw = INT(VIDEO_WIDTH(vsp) * vsm)
            DIM vh AS INTEGER : vh = INT(VIDEO_HEIGHT(vsp) * vsm)
            CLS(0)
            VIDEO_DRAW(vsp, (vsb - vw) \ 2, (vsh - vh) \ 2, vw, vh)
            FLIP()
            IF VIDEO_DONE(vsp) AND vspWeg = "" THEN vspWeg = "zu ende"
        WEND
        protokoll("vorspann " + vspWeg + " bei bild " + STR$(VIDEO_FRAME(vsp)))
        VIDEO_FREE(vsp)
    CATCH e
        protokoll("vorspann fehler " + e)
    END TRY
    RETURN vspWeg
END FUNCTION

' Die Klappliste der Einstellungen: jeder Vorspann, dann "Abwechselnd".
SUB vorspannAuswahlFuellen()
    GUI_LISTBOX_CLEAR(ddVorspann)
    DIM liste AS ARRAY OF STRING : liste = vorspannListe()
    DIM n AS STRING
    DIM wahl AS INTEGER : wahl = 0
    DIM i AS INTEGER : i = 0
    FOR EACH n IN liste
        GUI_LISTBOX_ADD(ddVorspann, vorspannName$(n))
        IF LOWER$(n) = LOWER$(vorspannDatei) THEN wahl = i
        i = i + 1
    NEXT
    GUI_LISTBOX_ADD(ddVorspann, "Abwechselnd")
    IF LOWER$(vorspannDatei) = "abwechselnd" THEN wahl = LEN(liste)
    GUI_DROPDOWN_SET_SELECTED(ddVorspann, wahl)
    vorspannWahlStand = wahl
END SUB

SUB einstellungenZeigen()
    GUI_SET_CHECKED(cbHell, hell)
    GUI_SET_CHECKED(cbUmbruch, umbruchAn)
    GUI_SET_CHECKED(cbKarte, minimapAn)
    GUI_SET_CHECKED(cbGit, gitRandAn)
    GUI_SET_CHECKED(cbRegex, regexAn)
    GUI_SET_CHECKED(cbVorschlag, vorschlagAn)
    GUI_SET_CHECKED(cbLinien, linienAn)
    GUI_SET_CHECKED(cbGeruest, geruestAn)
    GUI_SET_CHECKED(cbVorschau, vorschauAn)
    GUI_SET_CHECKED(cbKlammern, klammernAn)
    GUI_SET_CHECKED(cbFormatSichern, formatSichernAn)
    GUI_SET_CHECKED(cbVorspann, vorspannAn)
    GUI_SET_CHECKED(cbGlanz, glanzAn)
    GUI_SET_CHECKED(cbBaumHaken, baumHakenAn)
    GUI_SET_CHECKED(cbWasser, wasserzeichenAn)
    GUI_SET_VALUE(spUi, uiGroesse)
    vorspannAuswahlFuellen()
    GUI_SET_VALUE(spSchrift, codeGroesse)
    GUI_SET_VALUE(spListen, listenGroesse)
    GUI_SET_VALUE(spHbGr, handbuchGroesse)
    GUI_SET_VALUE(spAuto, autoSichern)
    ' Die linke Kante bleibt, wo sie war: die zweite Spalte waechst nach rechts.
    GUI_WINDOW_SET_BOUNDS(winEinst, (SCREENWIDTH() - 420) \ 2, 150, 820, 530)
    GUI_WINDOW_VISIBLE(winEinst, TRUE)
    einstOffen = TRUE
    GUI_FOCUS(cbHell)
    protokoll("einstellungen auf")
END SUB

' Die Schalter wirken SOFORT, ohne [Uebernehmen]: ein Thema, das man erst
' nach dem Schliessen sieht, waehlt man blind.
SUB einstellungenNachziehen()
    IF NOT einstOffen THEN RETURN
    IF GUI_CHECKED(cbHell) <> hell THEN befehl("thema")
    IF GUI_CHECKED(cbUmbruch) <> umbruchAn THEN umbruchSetzen(GUI_CHECKED(cbUmbruch))
    IF GUI_CHECKED(cbKarte) <> minimapAn THEN minimapSetzen(GUI_CHECKED(cbKarte))
    IF GUI_CHECKED(cbGit) <> gitRandAn THEN befehl("git_rand")
    IF GUI_CHECKED(cbRegex) <> regexAn THEN befehl("regex")
    IF GUI_CHECKED(cbVorschlag) <> vorschlagAn THEN
        vorschlagAn = GUI_CHECKED(cbVorschlag)
        IF NOT vorschlagAn THEN vervollSchliessen()
        konfigSichern()
    END IF
    IF GUI_CHECKED(cbLinien) <> linienAn THEN linienSetzen(GUI_CHECKED(cbLinien))
    IF GUI_CHECKED(cbGeruest) <> geruestAn THEN geruestSetzen(GUI_CHECKED(cbGeruest))
    IF GUI_CHECKED(cbKlammern) <> klammernAn THEN klammernSetzen(GUI_CHECKED(cbKlammern))
    IF GUI_CHECKED(cbFormatSichern) <> formatSichernAn THEN befehl("format_sichern")
    IF GUI_CHECKED(cbVorspann) <> vorspannAn THEN
        vorspannAn = GUI_CHECKED(cbVorspann)
        konfigSichern()
        protokoll("vorspann " + IIF(vorspannAn, "an", "aus"))
    END IF
    IF GUI_DROPDOWN_SELECTED(ddVorspann) <> vorspannWahlStand AND GUI_DROPDOWN_SELECTED(ddVorspann) >= 0 THEN
        vorspannWahlStand = GUI_DROPDOWN_SELECTED(ddVorspann)
        DIM vl AS ARRAY OF STRING : vl = vorspannListe()
        IF vorspannWahlStand < LEN(vl) THEN vorspannDatei = vl[vorspannWahlStand] ELSE vorspannDatei = "abwechselnd"
        konfigSichern()
        protokoll("vorspann wahl " + vorspannDatei)
    END IF
    IF GUI_CLICKED(btnVorspannSehen) THEN
        DIM vl2 AS ARRAY OF STRING : vl2 = vorspannListe()
        IF LEN(vl2) > 0 THEN
            DIM vi AS INTEGER : vi = GUI_DROPDOWN_SELECTED(ddVorspann)
            ' "Abwechselnd" zeigt den, der beim naechsten Start kaeme.
            IF vi < 0 OR vi >= LEN(vl2) THEN vi = (vorspannZuletzt + 1) MOD LEN(vl2)
            IF vi < 0 THEN vi = 0
            IF vorspannSpielen(PATHJOIN(vorspannOrdner, vl2[vi])) = "kreuz" THEN beendenAnfragen()
        END IF
    END IF
    IF GUI_CHECKED(cbBaumHaken) <> baumHakenAn THEN baumHakenSetzen(GUI_CHECKED(cbBaumHaken))
    IF GUI_CHECKED(cbWasser) <> wasserzeichenAn THEN
        wasserzeichenAn = GUI_CHECKED(cbWasser)
        wasserzeichenAlle()
        konfigSichern()
    END IF
    IF INT(GUI_VALUE(spUi)) <> uiGroesse THEN
        uiSchrift(INT(GUI_VALUE(spUi)))
        konfigSichern()
    END IF
    IF GUI_CHECKED(cbGlanz) <> glanzAn THEN
        glanzAn = GUI_CHECKED(cbGlanz)
        konfigSichern()
        IF glanzAn THEN lichtstreif(1800)
        protokoll("glanz " + IIF(glanzAn, "an", "aus"))
    END IF
    IF GUI_CHECKED(cbVorschau) <> vorschauAn THEN
        vorschauAn = GUI_CHECKED(cbVorschau)
        konfigSichern()
        protokoll("umbau schalter " + IIF(vorschauAn, "an", "aus"))
    END IF
    IF INT(GUI_VALUE(spSchrift)) <> codeGroesse THEN schriftSetzen(INT(GUI_VALUE(spSchrift)))
    IF INT(GUI_VALUE(spListen)) <> listenGroesse THEN
        listenSchrift(INT(GUI_VALUE(spListen)))
        konfigSichern()
    END IF
    IF INT(GUI_VALUE(spHbGr)) <> handbuchGroesse THEN
        handbuchSchrift(INT(GUI_VALUE(spHbGr)))
        konfigSichern()
    END IF
    IF INT(GUI_VALUE(spAuto)) <> autoSichern THEN
        autoSichern = INT(GUI_VALUE(spAuto))
        konfigSichern()
        protokoll("autosichern " + STR$(autoSichern))
    END IF
END SUB

' --- Eingebaute Befehle nachschlagen ----------------------------------
' Die Liste kommt aus CODE_COMPLETE mit leerem Text: das sind alle Namen,
' die die Vervollstaendigung ueberhaupt kennt. Die Beschreibung holt
' derselbe CODE_HOVER$ wie die Statuszeile -- ueber einen Text, der nur
' aus dem Namen besteht.
SUB befehleFuellen(filter AS STRING)
    IF LEN(alleBefehle) = 0 THEN alleBefehle = CODE_COMPLETE("", 1, 1)
    GUI_LISTBOX_CLEAR(lstBefehle)
    gezeigteBefehle = []
    DIM klein AS STRING : klein = LOWER$(filter)
    DIM b AS STRING
    FOR EACH b IN alleBefehle
        IF LEN(gezeigteBefehle) >= 400 THEN BREAK
        IF klein = "" OR passtUnscharf(b, klein) THEN
            GUI_LISTBOX_ADD(lstBefehle, b)
            ARRAY_PUSH(gezeigteBefehle, b)
        END IF
    NEXT
    GUI_SET_TEXT(lblBefehlZahl, STR$(LEN(gezeigteBefehle)) + tr$(" von ") + STR$(LEN(alleBefehle)))
    IF LEN(gezeigteBefehle) > 0 THEN GUI_LISTBOX_SET_SELECTED(lstBefehle, 0)
    befehlWahlZuletzt = -2
END SUB

SUB befehleZeigen()
    GUI_SET_TEXT(tfBefehlFilter, "")
    befehlFilterZuletzt = ""
    befehleFuellen("")
    GUI_WINDOW_VISIBLE(winBefehle, TRUE)
    GUI_FOCUS(tfBefehlFilter)
    protokoll("befehle " + STR$(LEN(alleBefehle)))
END SUB

SUB befehleNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winBefehle) THEN RETURN
    IF GUI_TEXT(tfBefehlFilter) <> befehlFilterZuletzt THEN
        befehlFilterZuletzt = GUI_TEXT(tfBefehlFilter)
        befehleFuellen(befehlFilterZuletzt)
    END IF
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstBefehle)
    IF sel = befehlWahlZuletzt THEN RETURN
    befehlWahlZuletzt = sel
    IF sel < 0 OR sel >= LEN(gezeigteBefehle) THEN RETURN
    DIM name AS STRING : name = gezeigteBefehle[sel]
    DIM md AS STRING : md = CODE_HOVER$(name, 1, 1)
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, "```", "")
    IF TRIM$(md) = "" THEN md = name + NL + NL + "(keine Beschreibung -- meist ein Schlüsselwort der Sprache)"
    GUI_SET_TEXT(taBefehlDoku, TRIM$(md))
END SUB

SUB befehlEinfuegen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstBefehle)
    IF sel < 0 OR sel >= LEN(gezeigteBefehle) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_WINDOW_VISIBLE(winBefehle, FALSE)
    GUI_FOCUS(ta)
    GUI_TEXTAREA_INSERT(ta, gezeigteBefehle[sel])
    protokoll("befehl eingefuegt " + gezeigteBefehle[sel])
END SUB

' --- Definition hier zeigen (Peek) -------------------------------------
' Zehn Zeilen um die Definition, ohne die Datei zu verlassen. Wer doch
' hin will, hat den Knopf -- das ist F12.
SUB peekZeigen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM dz AS INTEGER
    DIM ds AS INTEGER
    (dz, ds) = CODE_DEFINITION(q, z, s)
    peekPfad = ""
    IF dz < 1 THEN
        ' Nicht in dieser Datei -- der Symbolindex sieht das ganze Projekt.
        DIM k AS INTEGER : k = symbolSuchen(wortUnterMarke$())
        IF k < 0 THEN
            GUI_SET_TEXT(lblStatus, tr$("Keine Definition zu '") + wortUnterMarke$() + tr$("' -- auch nicht im Projekt."))
            RETURN
        END IF
        peekPfad = symPfade[k]
        dz = symZeilen[k]
        DIM offen AS INTEGER : offen = tabMitPfad(peekPfad)
        IF offen >= 0 THEN
            q = GUI_TEXT(tabFelder[offen])
        ELSE
            q = dateiLesen(peekPfad)
        END IF
    END IF
    peekZeile = dz
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(q, NL)
    DIM von AS INTEGER : von = MAX(1, dz - 1)
    DIM bis AS INTEGER : bis = MIN(LEN(zeilen), dz + 9)
    DIM text AS STRING : text = ""
    DIM i AS INTEGER
    FOR i = von TO bis
        text = text + PADL$(STR$(i), 5) + "  " + zeilen[i - 1] + NL
    NEXT
    GUI_SET_TEXT(taPeek, text)
    GUI_SET_TEXT(lblPeek, wortUnterMarke$() + " -- " + IIF(peekPfad = "", "", BASENAME(peekPfad) + ", ") + tr$("Zeile ") + STR$(dz))
    GUI_WINDOW_SET_BOUNDS(winPeek, (SCREENWIDTH() - 720) \ 2, 240, 720, 300)
    GUI_WINDOW_VISIBLE(winPeek, TRUE)
    GUI_FOCUS(taPeek)
    ' Die Datei steht nur dann dabei, wenn es eine ANDERE ist -- sonst
    ' haette eine neue Zeilenform die Proben von Stand 7 gebrochen.
    protokoll("peek " + STR$(dz) + IIF(peekPfad = "", "", " " + BASENAME(peekPfad)))
END SUB

' --- Farbwaehler am Literal -------------------------------------------
SUB farbfeldNachziehen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM k AS INTEGER : k = GUI_TEXTAREA_SWATCH_CLICKED(ta)
    IF k < 0 OR k >= LEN(farbStellen) THEN RETURN
    farbStart = farbStellen[k]
    farbLaenge = farbLaengen[k]
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM roh AS STRING : roh = MID$(q, farbStart + 2, farbLaenge - 2)
    IF LEN(roh) = 8 THEN roh = RIGHT$(roh, 6)
    GUI_SET_PICKED_COLOR(cpFarbe, COLOR_FROM_HEX("#" + roh))
    GUI_SET_TEXT(lblFarbe, "&H" + roh)
    GUI_WINDOW_SET_BOUNDS(winFarbe, (SCREENWIDTH() - 320) \ 2, 200, 320, 300)
    GUI_WINDOW_VISIBLE(winFarbe, TRUE)
    GUI_FOCUS(cpFarbe)
    protokoll("farbfeld " + STR$(farbStart))
END SUB

SUB farbeUebernehmen()
    GUI_WINDOW_VISIBLE(winFarbe, FALSE)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR farbStart < 0 THEN RETURN
    DIM neu AS STRING : neu = "&H" + UPPER$(RIGHT$(COLOR_HEX$(GUI_PICKED_COLOR(cpFarbe)), 6))
    ' Aus der Zeichenstelle wieder Zeile und Spalte machen -- GUI_TEXTAREA_SELECT
    ' rechnet in Zeilen, die Abschnitte in Zeichen.
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(LEFT$(q, farbStart), NL)
    DIM z AS INTEGER : z = LEN(zeilen)
    DIM s AS INTEGER : s = LEN(zeilen[z - 1]) + 1
    GUI_TEXTAREA_SELECT(ta, z, s, z, s + farbLaenge)
    GUI_TEXTAREA_INSERT(ta, neu)
    GUI_FOCUS(ta)
    faerbSchluessel = "-"
    GUI_SET_TEXT(lblStatus, tr$("Farbe: ") + neu)
    protokoll("farbe " + neu)
    farbStart = -1
END SUB

' --- Geteilte Ansicht -------------------------------------------------
' Links ein zweiter Reiter, rechts der aktive. Beide sind ECHTE Code-Felder;
' zwei Ansichten auf DIESELBE Datei waeren ein Abgleich, den man bei jedem
' Anschlag fuehren muesste -- und GUI_SET_TEXT leerte dabei jedes Mal den
' Verlauf und schoebe die Marke ans Ende.
SUB geteiltSetzen(an AS BOOLEAN)
    IF an AND spiegelAn THEN spiegelSetzen(FALSE)
    IF an AND tabAnzahl < 2 THEN
        GUI_SET_TEXT(lblStatus, tr$("Geteilte Ansicht: dafür braucht es zwei offene Dateien."))
        RETURN
    END IF
    IF NOT an AND linkerTab >= 0 AND linkerTab < tabAnzahl THEN
        ' Zurueck auf seinen eigenen Reiter -- sonst bliebe das Feld
        ' ueber allen Reitern stehen.
        GUI_SET_TAB(tabFelder[linkerTab], linkerTab)
    END IF
    geteilt = an
    IF an THEN
        linkerTab = IIF(aktiverTab = 0, 1, 0)
        ' -1 heisst "auf jedem Reiter sichtbar" -- nur so stehen zwei
        ' Felder gleichzeitig im Bild.
        GUI_SET_TAB(tabFelder[linkerTab], -1)
    ELSE
        linkerTab = -1
    END IF
    GUI_MENU_CHECK(miGeteilt, geteilt)
    layout()
    GUI_SET_TEXT(lblStatus, IIF(geteilt, tr$("Geteilt: links ") + BASENAME(tabPfade[linkerTab]), tr$("Geteilte Ansicht aus.")))
    ' Die Lagen mitschreiben: dass der Befehl LIEF, sagt nichts darueber, ob
    ' die beiden Felder auch nebeneinander liegen.
    IF geteilt THEN
        protokoll("geteilt " + STR$(linkerTab) + " x " + STR$(GUI_GET_X(tabFelder[linkerTab])) + "+" + STR$(GUI_GET_W(tabFelder[linkerTab])) + " " + STR$(GUI_GET_X(tabFelder[aktiverTab])) + "+" + STR$(GUI_GET_W(tabFelder[aktiverTab])))
    ELSE
        protokoll("geteilt aus")
    END IF
END SUB

' Der linke Reiter darf nicht derselbe sein wie der aktive -- ein Widget
' kann nicht zweimal im Bild stehen. Beim Wechsel tauschen die beiden.
SUB geteiltNachziehen(vorher AS INTEGER)
    IF NOT geteilt THEN RETURN
    IF linkerTab <> aktiverTab THEN RETURN
    IF vorher < 0 OR vorher >= tabAnzahl OR vorher = aktiverTab THEN
        geteiltSetzen(FALSE)
        RETURN
    END IF
    GUI_SET_TAB(tabFelder[linkerTab], linkerTab)
    linkerTab = vorher
    GUI_SET_TAB(tabFelder[linkerTab], -1)
    layout()
END SUB

' --- Dieselbe Datei nebeneinander ---------------------------------------
' Die geteilte Ansicht zeigt zwei REITER. Hier ist es EINE Datei: das
' zweite Feld ist eine Ansicht auf das Feld des aktiven Reiters, und die
' Laufzeit gleicht den Text ab (GUI_TEXTAREA_SHARE) -- ohne GUI_SET_TEXT,
' also ohne den Verlauf zu leeren oder die Marke ans Ende zu schieben.
SUB spiegelSetzen(an AS BOOLEAN)
    IF an AND aktiverTab < 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Dieselbe Datei nebeneinander: dafür braucht es eine offene Datei."))
        RETURN
    END IF
    IF an AND geteilt THEN geteiltSetzen(FALSE)
    spiegelAn = an
    IF an THEN
        IF taSpiegel < 0 THEN taSpiegel = GUI_TEXTAREA(win, 0, 0, 10, 10)
        ' Bei JEDEM Einschalten: Schrift, Umbruch, Linien und Paare stehen
        ' seit dem letzten Mal womoeglich anders.
        feldEinrichten(taSpiegel)
        GUI_SET_TAB(taSpiegel, -1)
        GUI_SET_VISIBLE(taSpiegel, TRUE)
        spiegelBesitzer = tabFelder[aktiverTab]
        GUI_TEXTAREA_SHARE(taSpiegel, spiegelBesitzer)
        spiegelFaerbSchl = ""
    ELSEIF taSpiegel >= 0 THEN
        GUI_TEXTAREA_SHARE(taSpiegel, -1)
        GUI_SET_VISIBLE(taSpiegel, FALSE)
        spiegelBesitzer = -1
        IF aktiverTab >= 0 THEN GUI_FOCUS(tabFelder[aktiverTab])
    END IF
    GUI_MENU_CHECK(miSpiegel, spiegelAn)
    layout()
    IF spiegelAn THEN
        GUI_SET_TEXT(lblStatus, tr$("Dieselbe Datei nebeneinander: ") + BASENAME(tabPfade[aktiverTab]))
        protokoll("spiegel an x " + STR$(GUI_GET_X(taSpiegel)) + "+" + STR$(GUI_GET_W(taSpiegel)) + " " + STR$(GUI_GET_X(tabFelder[aktiverTab])) + "+" + STR$(GUI_GET_W(tabFelder[aktiverTab])))
    ELSE
        GUI_SET_TEXT(lblStatus, tr$("Zweite Ansicht aus."))
        protokoll("spiegel aus")
    END IF
END SUB

' Je Bild: folgt die zweite Ansicht noch dem aktiven Reiter? Nach einem
' Reiterwechsel zeigt sie die neue Datei, ohne offenen Reiter geht sie aus.
SUB spiegelNachziehen()
    IF NOT spiegelAn THEN RETURN
    IF aktiverTab < 0 OR aktiverTab >= tabAnzahl THEN
        spiegelSetzen(FALSE)
        RETURN
    END IF
    IF tabFelder[aktiverTab] = spiegelBesitzer THEN RETURN
    spiegelBesitzer = tabFelder[aktiverTab]
    GUI_TEXTAREA_SHARE(taSpiegel, spiegelBesitzer)
    spiegelFaerbSchl = ""
    layout()
    protokoll("spiegel folgt " + STR$(aktiverTab))
END SUB

' --- Uebersichtskarte --------------------------------------------------
' Eine Zeile ist ein Strich, so breit wie sie lang ist; der sichtbare
' Ausschnitt liegt als heller Kasten darueber. Rechts am Rand stehen Fehler
' (rot) und Warnungen (gelb), links die Zeile der Schreibmarke. Ein Klick
' rollt die Stelle in die Mitte, Ziehen laesst den Ausschnitt folgen -- die
' Marke bleibt dabei, wo sie ist, wie beim Mausrad.
SUB minimapZeichnen()
    IF NOT minimapAn THEN kartenZug = FALSE : RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM cx AS INTEGER : cx = GUI_CANVAS_X(karte)
    DIM cy AS INTEGER : cy = GUI_CANVAS_Y(karte)
    DIM cw AS INTEGER : cw = GUI_CANVAS_W(karte)
    DIM ch AS INTEGER : ch = GUI_CANVAS_H(karte)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM n AS INTEGER : n = LEN(zeilen)
    IF n = 0 OR ch < 4 THEN RETURN
    ' So viele Zeilen wie Platz ist, sonst zusammengefasst: bei 3000 Zeilen
    ' und 600 Punkten Hoehe steht eine Zeile fuer fuenf.
    DIM proZeile AS INTEGER : proZeile = MAX(1, (n + ch - 1) \ ch)
    DIM y AS INTEGER : y = 0
    DIM i AS INTEGER
    FOR i = 0 TO n - 1 STEP proZeile
        DIM zt AS STRING : zt = zeilen[i]
        DIM roh AS STRING : roh = LTRIM$(zt)
        IF roh <> "" THEN
            ' Wort fuer Wort statt ein Strich je Zeile: so sieht man in der
            ' Karte, WO in der Datei man ist -- ein gleichmaessiger Balken
            ' sieht ueberall gleich aus.
            DIM einzugX AS INTEGER : einzugX = MIN(cw \ 3, (LEN(zt) - LEN(roh)) * 2)
            DIM x AS INTEGER : x = cx + 4 + einzugX
            DIM grund AS INTEGER : grund = &H60708A
            IF LEFT$(roh, 1) = "'" THEN grund = F_KOMMENTAR
            DIM wt AS STRING
            FOR EACH wt IN SPLIT$(roh, " ")
                DIM bw AS INTEGER : bw = LEN(wt) * 2
                IF wt <> "" AND x < cx + cw - 7 THEN
                    BOX(x, cy + y, MIN(x + bw - 2, cx + cw - 7), cy + y, grund)
                END IF
                x = x + bw + 2
            NEXT
        END IF
        y = y + 1
        IF y >= ch THEN BREAK
    NEXT
    ' Der sichtbare Ausschnitt als heller Rahmen.
    DIM erste AS INTEGER
    DIM sicht AS INTEGER
    DIM von AS INTEGER
    DIM laenge AS INTEGER
    (erste, sicht, von, laenge) = GUI_TEXTAREA_VIEW(ta)
    DIM y0 AS INTEGER : y0 = cy + erste \ proZeile
    DIM y1 AS INTEGER : y1 = cy + MIN(ch - 1, (erste + sicht) \ proZeile)
    DIM ueber AS BOOLEAN
    ueber = MOUSEX() >= cx AND MOUSEX() < cx + cw AND MOUSEY() >= cy AND MOUSEY() < cy + ch
    ueber = ueber AND GUI_WINDOW_AT(MOUSEX(), MOUSEY()) = win
    BOX(cx + 1, y0, cx + cw - 2, y1, IIF(ueber OR kartenZug, &H30FFFFFF, &H20FFFFFF))
    RECT(cx + 1, y0, cx + cw - 2, y1, &H60A8C8E0)
    ' Die Zeile der Schreibmarke links, Fehler und Warnungen rechts am Rand
    ' -- mindestens zwei Punkte hoch, sonst uebersieht man sie.
    DIM mz AS INTEGER
    DIM ms AS INTEGER
    (mz, ms) = GUI_TEXTAREA_CURSOR(ta)
    DIM my AS INTEGER : my = cy + MIN(ch - 2, (mz - 1) \ proZeile)
    BOX(cx, my, cx + 2, my + 1, &HE0E0E0)
    IF ta = probFeld THEN
        DIM pk AS INTEGER
        FOR pk = 0 TO LEN(probZeile) - 1
            IF probHinw[pk] THEN CONTINUE
            DIM py AS INTEGER : py = cy + MIN(ch - 3, (probZeile[pk] - 1) \ proZeile)
            BOX(cx + cw - 5, py, cx + cw - 2, py + 2, IIF(probFehler[pk], &HE84848, &HE0B040))
        NEXT
    END IF
    ' Klick und Zug. Die Leinwand nimmt selbst keine Klicks an, der
    ' Treffertest ist von Hand -- und nur, wenn kein anderes Fenster (etwa
    ' das Handbuch) darueber liegt.
    IF MOUSE_HIT(0) AND ueber THEN kartenZug = TRUE : kartenZiel = -1
    IF kartenZug THEN
        DIM ziel AS INTEGER : ziel = MAX(1, MIN(n, (MOUSEY() - cy) * proZeile + 1))
        IF ziel <> kartenZiel THEN
            kartenZiel = ziel
            ' Die Stelle in die MITTE: oben stuende sie am Rand der Ansicht.
            GUI_TEXTAREA_SCROLL(ta, MAX(1, ziel - sicht \ 2))
        END IF
        IF NOT MOUSEBUTTON(0) THEN
            kartenZug = FALSE
            protokoll("karte sprung " + STR$(kartenZiel))
        END IF
    END IF
END SUB

SUB minimapSetzen(an AS BOOLEAN)
    minimapAn = an
    GUI_MENU_CHECK(miMinimap, an)
    layout()
    konfigSichern()
    protokoll("karte " + IIF(an, "an", "aus"))
END SUB

' --- Faltung ----------------------------------------------------------
SUB faltenUmschalten()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF faltSchluessel = "-" THEN gliederungFuellen(GUI_TEXT(ta))
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zu AS BOOLEAN : zu = GUI_TEXTAREA_FOLD(ta, z)
    GUI_FOCUS(ta)
    protokoll("falte " + STR$(z) + IIF(zu, " zu", " auf"))
END SUB

SUB faltenAlle(zu AS BOOLEAN)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF faltSchluessel = "-" THEN gliederungFuellen(GUI_TEXT(ta))
    DIM n AS INTEGER : n = GUI_TEXTAREA_FOLD_ALL(ta, zu)
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, IIF(zu, STR$(n) + tr$(" Blöcke zugeklappt."), tr$("Alles aufgeklappt.")))
    protokoll("falten alle " + STR$(n))
END SUB

FUNCTION dateiLesen(pfad AS STRING) AS STRING
    DIM zeilen AS ARRAY OF STRING
    zeilen = READLINES(pfad)
    RETURN JOIN$(zeilen, NL)
END FUNCTION

' Derselbe Weg, EINE Schreibweise. Von der Kommandozeile kommt er mit
' Rueckstrichen, aus PATHJOIN mit Schraegstrichen -- verglichen wurde bis
' hierher wortwoertlich, und dieselbe Datei bekam aus dem Projektbaum einen
' ZWEITEN Reiter. Gross/klein bleibt, wie es ist: unter Linux sind es zwei
' verschiedene Dateien.
FUNCTION wegGleich$(pfad AS STRING) AS STRING
    RETURN REPLACE$(pfad, CHR$(92), "/")
END FUNCTION

' Die Faltung eines Reiters merken -- unter dem Weg der Datei, ein Reiter
' ohne Weg hat nichts, woran sie sich wiederfinden liesse. Nichts gefaltet
' heisst: der Eintrag faellt weg. Hoechstens 100 Dateien, die zuletzt
' gemerkte zuerst.
SUB faltenMerken(i AS INTEGER)
    IF i < 0 OR i >= tabAnzahl THEN RETURN
    IF tabPfade[i] = "" THEN RETURN
    ' Noch nicht zurueckgeholt (der Reiter war nie vorn): die gemerkte
    ' Faltung gilt weiter -- das Feld selbst hat ja noch keine.
    IF tabFaltenOffen[i] <> "" THEN RETURN
    DIM z AS ARRAY OF INTEGER : z = GUI_TEXTAREA_FOLDS(tabFelder[i])
    DIM teile AS ARRAY OF STRING : teile = []
    DIM k AS INTEGER
    FOR k = 0 TO LEN(z) - 1
        ARRAY_PUSH(teile, STR$(z[k]))
    NEXT
    DIM weg AS STRING : weg = wegGleich$(tabPfade[i])
    DIM neuP AS ARRAY OF STRING : neuP = []
    DIM neuL AS ARRAY OF STRING : neuL = []
    IF LEN(teile) > 0 THEN
        ARRAY_PUSH(neuP, weg) : ARRAY_PUSH(neuL, JOIN$(teile, ","))
    END IF
    FOR k = 0 TO LEN(faltPfade) - 1
        IF faltPfade[k] <> weg AND LEN(neuP) < 100 THEN
            ARRAY_PUSH(neuP, faltPfade[k]) : ARRAY_PUSH(neuL, faltListe[k])
        END IF
    NEXT
    faltPfade = neuP
    faltListe = neuL
END SUB

FUNCTION gemerkteFalten$(pfad AS STRING) AS STRING
    IF pfad = "" THEN RETURN ""
    DIM k AS INTEGER : k = ARRAY_INDEXOF(faltPfade, wegGleich$(pfad))
    IF k < 0 THEN RETURN ""
    RETURN faltListe[k]
END FUNCTION

' Nachdem der aktive Reiter seine faltbaren Bloecke bekommen hat: die
' gemerkte Faltung wieder zuklappen. Eine Zeile, die inzwischen keinen
' Block mehr anfaengt (die Datei wurde woanders geaendert), bleibt offen.
SUB faltenZurueck(ta AS GUI_WIDGET)
    IF aktiverTab < 0 OR ta <> tabFelder[aktiverTab] THEN RETURN
    IF tabFaltenOffen[aktiverTab] = "" THEN RETURN
    DIM zs AS STRING
    DIM n AS INTEGER : n = 0
    FOR EACH zs IN SPLIT$(tabFaltenOffen[aktiverTab], ",")
        TRY
            ' FOLD liefert, ob die Zeile jetzt zu ist (FALSE: kein Block dort).
            IF GUI_TEXTAREA_FOLD(ta, INT(VAL(zs)), TRUE) THEN n = n + 1
        CATCH e
        END TRY
    NEXT
    tabFaltenOffen[aktiverTab] = ""
    protokoll("falten wieder " + STR$(n))
END SUB

SUB tabOeffnen(pfad AS STRING, inhalt AS STRING)
    IF tabAnzahl >= MAX_TABS THEN
        GUI_SET_TEXT(lblStatus, tr$("Höchstens ") + STR$(MAX_TABS) + tr$(" Reiter -- erst einen schließen."))
        RETURN
    END IF
    ' Schon offen? Dann nur hin.
    DIM i AS INTEGER
    IF pfad <> "" THEN
        FOR i = 0 TO tabAnzahl - 1
            IF wegGleich$(tabPfade[i]) = wegGleich$(pfad) THEN
                aktiverTab = i
                reiterNeuSetzen()
                GUI_FOCUS(tabFelder[i])
                RETURN
            END IF
        NEXT
    END IF
    DIM ta AS GUI_WIDGET
    ta = GUI_TEXTAREA(win, 0, 0, 10, 10)
    feldEinrichten(ta)
    GUI_SET_TEXT(ta, inhalt)
    GUI_SET_TAB(ta, tabAnzahl)
    tabPfade[tabAnzahl] = pfad
    tabFelder[tabAnzahl] = ta
    tabGesichert[tabAnzahl] = inhalt
    tabLetzterText[tabAnzahl] = ""
    tabFaltenOffen[tabAnzahl] = gemerkteFalten$(pfad)
    aktiverTab = tabAnzahl
    tabAnzahl = tabAnzahl + 1
    reiterNeuSetzen()
    layout()
    GUI_FOCUS(ta)
    GUI_TEXTAREA_GOTO(ta, 1, 1)
    pruefungFaellig = GET_TIME()
    protokoll("geoeffnet " + pfad)
    IF waermeDaten THEN waermeFeld(tabAnzahl - 1)
END SUB

' Eine .dhform oeffnet seit Stand 31 den Form-Designer in Drachenhauch
' (examples/197_form_designer.dh) -- als Text nur auf ausdruecklichen Wunsch
' (Befehlspalette), weil man ein Formular sonst im JSON statt am Bild baut.
DIM letzteForm AS STRING : letzteForm = ""
DIM formAlsText AS BOOLEAN : formAlsText = FALSE

SUB dateiOeffnen(pfad AS STRING)
    IF NOT FILEEXISTS(pfad) THEN
        GUI_SET_TEXT(lblStatus, tr$("Gibt es nicht: ") + pfad)
        RETURN
    END IF
    IF LOWER$(RIGHT$(pfad, 7)) = ".dhform" AND NOT formAlsText THEN
        letzteForm = pfad
        werkzeugMit("197_form_designer.dh", pfad)
        GUI_SET_TEXT(lblStatus, tr$("Im Form-Designer geöffnet: ") + BASENAME(pfad) + tr$(" -- als Text: Befehlspalette, 'Formular als Text öffnen'"))
        RETURN
    END IF
    ' Bilder und Klaenge zeigt die IDE selbst -- man will sehen bzw. hoeren,
    ' was das Programm laedt, ohne ein zweites Programm.
    IF assetArt$(pfad) <> "" THEN
        assetZeigen(pfad)
        RETURN
    END IF
    ' Was der Editor nicht bearbeiten kann, gibt er ans System weiter --
    ' ein PNG im Code-Feld waere Kauderwelsch.
    IF NOT istText(pfad) THEN
        TRY
            OPENDOC(pfad)
            GUI_SET_TEXT(lblStatus, tr$("Mit dem Programm des Systems geöffnet: ") + BASENAME(pfad))
        CATCH e
            GUI_SET_TEXT(lblStatus, tr$("Lässt sich nicht öffnen: ") + BASENAME(pfad))
        END TRY
        protokoll("extern " + BASENAME(pfad))
        RETURN
    END IF
    tabOeffnen(pfad, dateiLesen(pfad))
    ' Der Projektordner wandert NUR, wenn die Datei ausserhalb liegt. Sonst
    ' machte ein Klick auf `lib/mehr.dh` den Unterordner zum Projekt, und
    ' der Baum zeigte danach die halbe Arbeit nicht mehr.
    IF LEFT$(wegGleich$(pfad), LEN(wegGleich$(projektOrdner))) <> wegGleich$(projektOrdner) THEN
        projektOrdner = DIRNAME(pfad)
    END IF
    baumFuellen()
    zuletztMerken(pfad)
    GUI_SET_TEXT(lblStatus, pfad)
END SUB

FUNCTION aktivesFeld() AS GUI_WIDGET
    IF aktiverTab < 0 THEN RETURN -1
    ' Steht die Marke in der zweiten Ansicht derselben Datei, meint jeder
    ' Befehl sie -- ihre Marke ist die, die man gerade sieht. Der Text ist
    ' derselbe, geschrieben wird ueber GUI_TEXTAREA_INSERT und die Laufzeit
    ' gleicht ab.
    IF spiegelAn AND taSpiegel >= 0 AND GUI_FOCUSED() = taSpiegel THEN RETURN taSpiegel
    RETURN tabFelder[aktiverTab]
END FUNCTION

FUNCTION sichern(i AS INTEGER, alsNeu AS BOOLEAN) AS BOOLEAN
    IF i < 0 THEN RETURN FALSE
    DIM pfad AS STRING : pfad = tabPfade[i]
    IF pfad = "" OR alsNeu THEN
        pfad = FILE_SAVE_DIALOG("Sichern unter", "programm.dh", "dh")
        IF pfad = "" THEN RETURN FALSE
        tabPfade[i] = pfad
    END IF
    DIM text AS STRING : text = GUI_TEXT(tabFelder[i])
    ' Formatieren beim Sichern: nur Drachenhauch-Quelltext, nie beim
    ' automatischen Sichern. Der Formatierer arbeitet auf Tokens: eine halbe
    ' Anweisung rueckt er ein wie jede andere, nur was sich gar nicht lesen
    ' laesst (eine offene Zeichenkette) laesst er stehen -- dann wird
    ' gesichert, was dasteht.
    IF formatSichernAn AND NOT sichernOhneFormat AND LOWER$(RIGHT$(pfad, 3)) = ".dh" THEN
        DIM geformt AS STRING : geformt = CODE_FORMAT$(text)
        IF geformt <> "" THEN
            IF RIGHT$(text, 1) = NL THEN geformt = geformt + NL
            IF geformt <> text THEN
                feldAustauschen(tabFelder[i], text, geformt)
                text = geformt
                protokoll("beim sichern formatiert")
            END IF
        END IF
    END IF
    tabGesichert[i] = text
    zaehlCache = {}
    blameCache = {}
    blameMarkeZeile = -1
    ' Die Datei endet mit einem Umbruch (dateiLesen laesst ihn weg, das Feld
    ' kennt ihn nicht) -- sonst verloere jede gesicherte Datei ihre letzte
    ' Zeile im Diff ("no newline at end of file"). Bis Stand 3 war das so.
    IF text <> "" AND RIGHT$(text, 1) <> NL THEN text = text + NL
    WRITEALL(pfad, text)
    reiterNeuSetzen()
    zuletztMerken(pfad)
    GUI_SET_TEXT(lblStatus, tr$("Gesichert: ") + pfad)
    protokoll("gesichert " + pfad)
    ' Beim Sichern neu starten: nur ein laufendes F5-Programm (Debugger und
    ' Profil haben einen Zustand, den man nicht nebenbei wegwirft), nur fuer
    ' Drachenhauch-Quelltext, nie beim automatischen Sichern.
    IF neustartSichernAn AND prozess >= 0 AND prozessArt = "run" AND neustartArt = "" _
       AND NOT sichernOhneFormat AND LOWER$(RIGHT$(pfad, 3)) = ".dh" THEN
        neustartArt = "run"
        neustartDatei = prozessDatei
        neustartVomSichern = TRUE
        protokoll("neustart beim sichern")
        stoppen()
    END IF
    ' Eigene Schnipsel und Tastenbelegung gelten, sobald sie gesichert sind --
    ' und sie liegen neben der ide.json, nicht im Projekt: der Projektordner
    ' bleibt, wo er war.
    IF wegGleich$(pfad) = wegGleich$(schnipselPfad$()) THEN
        schnipselLaden()
        RETURN TRUE
    END IF
    IF wegGleich$(pfad) = wegGleich$(tastenPfad$()) THEN
        tastenAnwenden()
        RETURN TRUE
    END IF
    IF wegGleich$(pfad) = wegGleich$(farbenPfad$()) THEN
        themaAnwenden()
        RETURN TRUE
    END IF
    IF DIRNAME(pfad) <> projektOrdner THEN
        projektOrdner = DIRNAME(pfad)
        baumFuellen()
    END IF
    RETURN TRUE
END FUNCTION

' Alle Reiter ausser dem vorderen zumachen. Von HINTEN nach vorn, damit die
' Nummern der noch offenen gueltig bleiben -- tabSchliessen rueckt sie auf.
SUB andereSchliessen()
    IF aktiverTab < 0 THEN RETURN
    DIM behalten AS GUI_WIDGET : behalten = tabFelder[aktiverTab]
    DIM weg AS INTEGER : weg = 0
    DIM i AS INTEGER
    FOR i = tabAnzahl - 1 TO 0 STEP -1
        IF tabFelder[i] <> behalten THEN
            tabSchliessen(i)
            weg = weg + 1
        END IF
    NEXT
    GUI_SET_TEXT(lblStatus, STR$(weg) + tr$(" Reiter geschlossen."))
    protokoll("andere zu " + STR$(weg))
END SUB

' Einen Reiter schliessen -- mit Rueckfrage, wenn er Ungesichertes
' traegt. Vorher nahm Strg+W die Aenderungen wortlos mit; beim Kreuz
' faellt das noch mehr ins Gewicht, weil man es aus Versehen trifft.
SUB tabSchliessenFragen(i AS INTEGER)
    IF i < 0 OR i >= tabAnzahl THEN RETURN
    IF GUI_TEXT(tabFelder[i]) = tabGesichert[i] THEN
        tabSchliessen(i)
        RETURN
    END IF
    tabZuIndex = i
    DIM wie AS STRING : wie = "Unbenannt"
    IF tabPfade[i] <> "" THEN wie = BASENAME(tabPfade[i])
    dlgTabZu = GUI_DIALOG(tr$("Schließen"), wie + tr$(" hat ungesicherte Änderungen."), _
                          "Sichern|Verwerfen|Abbrechen")
END SUB

SUB tabSchliessen(i AS INTEGER)
    IF i < 0 OR i >= tabAnzahl THEN RETURN
    ' Den Pfad merken: Strg+Umschalt+T holt ihn zurueck. Nur gesicherte
    ' Dateien -- ein leerer Reiter haette nichts, was wiederzufinden waere.
    IF tabPfade[i] <> "" THEN ARRAY_PUSH(zuGemacht, tabPfade[i])
    ' Die Reiter ruecken auf, der linke der geteilten Ansicht zeigte danach
    ' auf eine andere Datei -- lieber ganz aus als still auf die falsche.
    IF geteilt THEN geteiltSetzen(FALSE)
    faltenMerken(i)
    GUI_DESTROY(tabFelder[i])
    DIM k AS INTEGER
    FOR k = i TO tabAnzahl - 2
        tabPfade[k] = tabPfade[k + 1]
        tabFelder[k] = tabFelder[k + 1]
        tabGesichert[k] = tabGesichert[k + 1]
        tabLetzterText[k] = tabLetzterText[k + 1]
        tabFaltenOffen[k] = tabFaltenOffen[k + 1]
        GUI_SET_TAB(tabFelder[k], k)
    NEXT
    tabAnzahl = tabAnzahl - 1
    ' Faellt ein Reiter LINKS vom aktiven weg, ruecken die anderen auf --
    ' dieselbe Nummer meinte danach die Datei daneben. Mit Strg+W fiel das
    ' nie auf (es schliesst immer den vorderen), mit dem Kreuz sofort.
    IF i < aktiverTab THEN aktiverTab = aktiverTab - 1
    IF aktiverTab >= tabAnzahl THEN aktiverTab = tabAnzahl - 1
    reiterNeuSetzen()
    layout()
    GUI_LISTBOX_CLEAR(lstProbleme)
    protokoll("geschlossen " + STR$(i))
END SUB

' --- Projektbaum -------------------------------------------------------
DIM baumLetzteWahl AS STRING : baumLetzteWahl = ""
DIM hakenStand AS INTEGER : hakenStand = 0

' Alle Dateien des Projekts mit diesem Muster -- AUCH in Unterordnern.
'
' Ein Projekt ist selten ein flacher Ordner; ein Umbau, der `lib/` nicht
' sieht, laesst die halbe Arbeit liegen. Uebergangen werden Ordner, die mit
' `.` oder `_` anfangen, dazu `target` und `__pycache__`: dort liegt
' Erzeugtes, kein Quelltext, und ein Bau-Ordner kann zehntausend Dateien
' haben.
FUNCTION projektDateien(muster AS STRING) AS ARRAY OF STRING
    DIM roh AS ARRAY OF STRING : roh = []
    TRY
        roh = DIRLIST_REC(projektOrdner, muster)
    CATCH e
        roh = []
    END TRY
    DIM raus AS ARRAY OF STRING : raus = []
    DIM d AS STRING
    FOR EACH d IN roh
        DIM gut AS BOOLEAN : gut = TRUE
        DIM teil AS STRING
        DIM teile AS ARRAY OF STRING : teile = SPLIT$(d, "/")
        DIM ti AS INTEGER
        FOR ti = 0 TO LEN(teile) - 2          ' der Dateiname selbst zaehlt nicht
            teil = teile[ti]
            IF LEFT$(teil, 1) = "." OR LEFT$(teil, 1) = "_" THEN gut = FALSE
            IF teil = "target" OR teil = "__pycache__" THEN gut = FALSE
        NEXT
        IF gut THEN ARRAY_PUSH(raus, d)
    NEXT
    ' Sind im Baum Dateien ANGEHAKT, ist das Projekt genau diese Auswahl.
    ' Eine Umbenennung soll man auf drei Dateien beschraenken koennen, ohne
    ' dafuer einen zweiten Ordner anzulegen -- und weil ALLES hier durchgeht
    ' (Umbauten, Projektsuche, Symbolverzeichnis), gilt die Einschraenkung
    ' ueberall gleich. Damit sie niemandem entgeht, sagt die Beschriftung
    ' ueber dem Baum, wie viele angehakt sind.
    IF GUI_FILETREE_CHECKED_COUNT(baum) = 0 THEN RETURN raus
    DIM gewaehlt AS ARRAY OF STRING : gewaehlt = []
    DIM hi AS INTEGER
    FOR hi = 0 TO GUI_FILETREE_CHECKED_COUNT(baum) - 1
        ARRAY_PUSH(gewaehlt, wegGleich$(GUI_FILETREE_CHECKED_PATH$(baum, hi)))
    NEXT
    ' Ein angehakter ORDNER nimmt alles darunter mit -- bis 2026-09-27 zaehlte
    ' nur der genaue Weg einer Datei, ein Ordner-Haken machte das Projekt
    ' also LEER: die Projektsuche fand nichts, und es sah aus, als taete der
    ' Haken nichts.
    DIM nur AS ARRAY OF STRING : nur = []
    FOR EACH d IN raus
        DIM voll AS STRING : voll = wegGleich$(PATHJOIN(projektOrdner, d))
        DIM drin AS BOOLEAN : drin = ARRAY_INDEXOF(gewaehlt, voll) >= 0
        DIM g AS STRING
        FOR EACH g IN gewaehlt
            IF NOT drin AND LEFT$(voll, LEN(g) + 1) = g + "/" THEN drin = TRUE
        NEXT
        IF drin THEN ARRAY_PUSH(nur, d)
    NEXT
    RETURN nur
END FUNCTION

' Was im Projektbaum steht. Quelltext zuerst, dann was dazugehoert --
' Formulare und Sprites bearbeitet man mit den Werkzeugen, Daten liest man
' nach, und ein Bild will man wenigstens ansehen koennen.
CONST BAUM_MUSTER = "*.dh;*.dhform;*.dhsprite;*.dhanim;*.dhtest;*.json;*.md;*.txt;*.csv;*.ini;*.png;*.wav;*.ogg"
' Uebergangen wird, wo Erzeugtes liegt: ein Bau-Ordner kann zehntausend
' Dateien haben. Namen, die mit `.` anfangen, laesst der Baum von sich aus
' weg (Einstellung `verborgene`).
CONST BAUM_AUSNAHMEN = "target;__pycache__;_*"
GUI_FILETREE_FILTER(baum, BAUM_MUSTER)

' Der Filtertext wird in jedes Endungsmuster gesetzt: aus `*.dh` wird
' `*held*.dh` -- so bleibt es bei den Dateiarten, die der Baum zeigt.
SUB baumFilterNachziehen()
    DIM t AS STRING : t = TRIM$(GUI_TEXT(tfBaumFilter))
    IF t = baumFilterZuletzt THEN RETURN
    baumFilterZuletzt = t
    IF t = "" THEN
        GUI_FILETREE_FILTER(baum, BAUM_MUSTER)
    ELSE
        DIM teile AS ARRAY OF STRING : teile = []
        DIM m AS STRING
        FOR EACH m IN SPLIT$(BAUM_MUSTER, ";")
            ARRAY_PUSH(teile, "*" + t + "*" + MID$(m, 1, LEN(m)))
        NEXT
        GUI_FILETREE_FILTER(baum, JOIN$(teile, ";"))
    END IF
    DIM n AS INTEGER : n = 0
    DIM i AS INTEGER
    FOR i = 0 TO GUI_FILETREE_COUNT(baum) - 1
        IF NOT GUI_FILETREE_IS_DIR(baum, GUI_FILETREE_PATH$(baum, i)) THEN n = n + 1
    NEXT
    protokoll("baumfilter [" + t + "] " + STR$(n))
END SUB
GUI_FILETREE_SKIP(baum, BAUM_AUSNAHMEN)
' Alle zwei Sekunden nachsehen: eine Datei, die ein anderes Programm
' anlegt (oder der Export), steht damit von selbst im Baum. Bis Stand 23
' sah man sie erst nach dem naechsten Oeffnen.
GUI_FILETREE_SET(baum, "auffrischen", 2000)
' Ein Klick auf einen Ordner klappt ihn um -- das schmale Dreieck allein zu
' treffen ist eine Zumutung, und ein Klick, der scheinbar nichts tut, sieht
' nach einem Fehler aus.
GUI_FILETREE_SET(baum, "klick_klappt", 1)
' Haken am Baum: was angehakt ist, IST das Projekt (siehe projektDateien).
GUI_FILETREE_SET(baum, "kaestchen", IIF(baumHakenAn, 1, 0))
IF baumHakenAn THEN GUI_TOOLTIP(baum, baumHakenTipp$())

' Laesst sich die Datei im Editor bearbeiten? Alles andere geht an das
' Programm des Systems (ein PNG im Code-Feld waere Kauderwelsch).
FUNCTION istText(pfad AS STRING) AS BOOLEAN
    DIM e AS STRING : e = LOWER$(pfad)
    IF RIGHT$(e, 4) = ".png" OR RIGHT$(e, 4) = ".wav" OR RIGHT$(e, 4) = ".ogg" THEN RETURN FALSE
    IF RIGHT$(e, 9) = ".dhsprite" THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

SUB baumFuellen()
    ' Der Baum holt sich die Namen selbst -- hier steht nur noch, WO er
    ' suchen soll. Ein Wurzelwechsel raeumt Auswahl und offene Aeste weg,
    ' ein Auffrischen laesst beide stehen: sonst verloere man beim Oeffnen
    ' einer Datei gerade die Mehrfachauswahl, die man einsammelt.
    IF wegGleich$(GUI_FILETREE_ROOT$(baum)) <> wegGleich$(projektOrdner) THEN
        GUI_FILETREE_SET_ROOT(baum, projektOrdner)
        baumLetzteWahl = ""
    ELSE
        GUI_FILETREE_REFRESH(baum)
    END IF
    projektBeschriften()
END SUB

FUNCTION baumHakenTipp$() AS STRING
    RETURN "Haken: Projektsuche, Umbenennen, Ersetzen und Symbolverzeichnis gelten dann nur für die angehakten Dateien und Ordner. Ohne Haken: das ganze Projekt."
END FUNCTION

' Die Kaestchen ein- oder ausblenden. Beim Ausblenden fallen die Haken weg --
' eine Einschraenkung, die man nicht mehr sieht, waere eine Falle.
SUB baumHakenSetzen(an AS BOOLEAN)
    IF NOT an AND GUI_FILETREE_CHECKED_COUNT(baum) > 0 THEN hakenEntfernen()
    baumHakenAn = an
    GUI_FILETREE_SET(baum, "kaestchen", IIF(an, 1, 0))
    GUI_TOOLTIP(baum, IIF(an, baumHakenTipp$(), ""))
    GUI_MENU_CHECK(miBaumHaken, an)
    konfigSichern()
    IF an THEN
        GUI_SET_TEXT(lblStatus, tr$("Kästchen im Projektbaum: was angehakt ist, begrenzt Projektsuche und Umbauten."))
    ELSE
        GUI_SET_TEXT(lblStatus, tr$("Kästchen im Projektbaum ausgeblendet -- Suche und Umbau gelten wieder dem ganzen Projekt."))
    END IF
    protokoll("baum haken " + IIF(an, "an", "aus"))
END SUB

' Was ueber dem Baum steht. Angehakte Dateien schraenken JEDEN Umbau ein --
' das darf man nicht uebersehen, also steht es dort, wo man ohnehin hinsieht.
SUB projektBeschriften()
    DIM n AS INTEGER : n = GUI_FILETREE_CHECKED_COUNT(baum)
    IF n = 0 THEN
        GUI_SET_TEXT(lblProjekt, BASENAME(projektOrdner))
    ELSE
        GUI_SET_TEXT(lblProjekt, BASENAME(projektOrdner) + tr$(" -- Suche/Umbau nur in ") + STR$(n) + tr$(" angehakten"))
    END IF
END SUB

' Alle gewaehlten Dateien oeffnen (Strg+Umschalt+E).
SUB baumAuswahlOeffnen()
    DIM n AS INTEGER : n = GUI_FILETREE_SEL_COUNT(baum)
    IF n < 1 THEN
        GUI_SET_TEXT(lblStatus, tr$("Keine Datei gewählt -- Strg+Klick sammelt, Umschalt+Klick spannt."))
        RETURN
    END IF
    ' Erst alle Wege einsammeln, dann oeffnen: dateiOeffnen frischt den Baum
    ' auf, und ein Ordner darin ist keine Datei.
    DIM pfade AS ARRAY OF STRING : pfade = []
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        DIM p0 AS STRING : p0 = GUI_FILETREE_SEL_PATH$(baum, k)
        IF p0 <> "" AND NOT GUI_FILETREE_IS_DIR(baum, p0) THEN ARRAY_PUSH(pfade, p0)
    NEXT
    DIM p AS STRING
    FOR EACH p IN pfade
        dateiOeffnen(p)
    NEXT
    GUI_SET_TEXT(lblStatus, STR$(LEN(pfade)) + tr$(" Datei(en) geöffnet."))
    protokoll("baum offen " + STR$(LEN(pfade)))
END SUB

' Alle Haken abraeumen -- das Projekt ist danach wieder der ganze Ordner.
SUB hakenEntfernen()
    DIM n AS INTEGER : n = GUI_FILETREE_CHECKED_COUNT(baum)
    ' Von HINTEN nach vorn: jedes Abhaken nimmt einen Weg aus der Liste,
    ' vorwaerts uebersprungen man damit jeden zweiten.
    DIM i AS INTEGER
    FOR i = n - 1 TO 0 STEP -1
        GUI_FILETREE_SET_CHECKED(baum, GUI_FILETREE_CHECKED_PATH$(baum, i), FALSE)
    NEXT
    hakenStand = 0
    projektBeschriften()
    GUI_SET_TEXT(lblStatus, STR$(n) + tr$(" Haken entfernt -- der Umbau geht wieder über das ganze Projekt."))
    protokoll("haken weg " + STR$(n))
END SUB

SUB baumAbfragen()
    ' Die Haken entscheiden, was "das Projekt" heisst -- das gehoert sofort
    ' in die Beschriftung, nicht erst beim naechsten Neuaufbau des Baums.
    IF GUI_FILETREE_CHECKED_COUNT(baum) <> hakenStand THEN
        hakenStand = GUI_FILETREE_CHECKED_COUNT(baum)
        projektBeschriften()
        protokoll("haken " + STR$(hakenStand))
    END IF
    DIM weg AS STRING : weg = GUI_FILETREE_SELECTED$(baum)
    IF weg = "" OR weg = baumLetzteWahl THEN RETURN
    baumLetzteWahl = weg
    ' Ein Rechtsklick waehlt nur (fuer das Kontextmenue), er oeffnet nichts.
    IF MOUSE_HIT(1) THEN RETURN
    ' Ein Ordner ist kein Reiter -- ein Klick darauf klappt ihn auf, mehr
    ' soll er nicht tun.
    IF GUI_FILETREE_IS_DIR(baum) THEN RETURN
    ' Beim SAMMELN wird nicht geoeffnet -- sonst kaeme mit jedem Strg+Klick
    ' ein Reiter dazu, den niemand wollte. Geoeffnet wird nur, wenn genau
    ' eine Zeile gewaehlt ist und es die angeklickte ist (beim Abwaehlen
    ' zeigt die angeklickte woanders hin als die eine uebriggebliebene).
    IF GUI_FILETREE_SEL_COUNT(baum) <> 1 OR GUI_FILETREE_SEL_PATH$(baum, 0) <> weg THEN RETURN
    dateiOeffnen(weg)
END SUB

' --- Einfaerben (nur der sichtbare Ausschnitt) ------------------------
FUNCTION farbeFuer(art AS STRING) AS INTEGER
    IF art = "kommentar" THEN RETURN F_KOMMENTAR
    IF art = "text" THEN RETURN F_TEXT
    IF art = "zahl" THEN RETURN F_ZAHL
    IF art = "schluessel" THEN RETURN F_SCHLUESSEL
    IF art = "operator" THEN RETURN F_OPERATOR
    RETURN F_GRUND
END FUNCTION

' Klammer-Gegenstueck IM AUSSCHNITT suchen -- -1, wenn es keins gibt oder
' es ausserhalb liegt. Der Ausschnitt reicht: was man nicht sieht, muss
' auch nicht leuchten.
FUNCTION klammerPartner(s AS STRING, pos AS INTEGER) AS INTEGER
    DIM auf AS STRING : auf = "([{"
    DIM zu AS STRING : zu = ")]}"
    DIM c AS STRING : c = MID$(s, pos, 1)
    DIM k AS INTEGER : k = INSTR(auf, c)
    DIM richtung AS INTEGER : richtung = 1
    DIM partner AS STRING : partner = ""
    IF k >= 0 THEN
        partner = MID$(zu, k, 1)
    ELSE
        k = INSTR(zu, c)
        IF k < 0 THEN RETURN -1
        partner = MID$(auf, k, 1)
        richtung = -1
    END IF
    DIM tiefe AS INTEGER : tiefe = 0
    DIM i AS INTEGER : i = pos
    WHILE i >= 0 AND i < LEN(s)
        DIM d AS STRING : d = MID$(s, i, 1)
        IF d = c THEN
            tiefe = tiefe + 1
        ELSEIF d = partner THEN
            tiefe = tiefe - 1
            IF tiefe = 0 THEN RETURN i
        END IF
        i = i + richtung
    WEND
    RETURN -1
END FUNCTION

' Ist das Zeichen an dieser Stelle Teil eines Namens?
FUNCTION wortzeichenAn(s AS STRING, i AS INTEGER) AS BOOLEAN
    IF i < 0 OR i >= LEN(s) THEN RETURN FALSE
    RETURN istWortzeichen(MID$(s, i, 1))
END FUNCTION

DIM faerbSchluessel AS STRING : faerbSchluessel = ""

' &H-Literale im Ausschnitt: Anfang, Laenge und Farbe. Sechs oder acht
' Stellen -- kuerzere Zahlen (`&HFF`) sind keine Farbe, sondern eine Zahl,
' und ein Feld daneben waere nur Verwirrung.
SUB farbliteraleSuchen(stueck AS STRING, von AS INTEGER, s AS ARRAY OF INTEGER, _
                       l AS ARRAY OF INTEGER, f AS ARRAY OF INTEGER)
    farbStellen = [] : farbLaengen = []
    DIM ab AS INTEGER : ab = 0
    WHILE ab < LEN(stueck)
        DIM p AS INTEGER : p = INSTR(MID$(stueck, ab, LEN(stueck)), "&H")
        IF p < 0 THEN BREAK
        p = ab + p
        DIM k AS INTEGER : k = p + 2
        WHILE k < LEN(stueck) AND INSTR("0123456789ABCDEFabcdef", MID$(stueck, k, 1)) >= 0
            k = k + 1
        WEND
        DIM stellen AS INTEGER : stellen = k - p - 2
        IF stellen = 6 OR stellen = 8 THEN
            DIM roh AS STRING : roh = MID$(stueck, p + 2, stellen)
            IF stellen = 8 THEN roh = RIGHT$(roh, 6)
            ARRAY_PUSH(s, p + von) : ARRAY_PUSH(l, k - p) : ARRAY_PUSH(f, COLOR_FROM_HEX("#" + roh))
            ARRAY_PUSH(farbStellen, p + von) : ARRAY_PUSH(farbLaengen, k - p)
        END IF
        ab = MAX(k, p + 2)
    WEND
END SUB

SUB faerben(ta AS GUI_WIDGET)
    DIM erste AS INTEGER
    DIM zeilen AS INTEGER
    DIM von AS INTEGER
    DIM laenge AS INTEGER
    (erste, zeilen, von, laenge) = GUI_TEXTAREA_VIEW(ta)
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM stueck AS STRING : stueck = MID$(q, von, laenge)
    DIM cz AS INTEGER
    DIM cs AS INTEGER
    (cz, cs) = GUI_TEXTAREA_CURSOR(ta)
    ' Hat sich nichts geaendert, ist auch nichts neu zu rechnen. Ohne den
    ' Riegel liefen Einfaerbung UND Fundstellensuche in jedem Bild, auch
    ' wenn das Fenster nur dasteht.
    DIM schl AS STRING : schl = STR$(von) + ":" + STR$(cz) + ":" + STR$(cs) + ":" + _
        IIF(sucheOffen, suchMuster$(suchtext), "") + ":" + stueck
    IF schl = faerbSchluessel THEN RETURN
    faerbSchluessel = schl
    DIM starts AS ARRAY OF INTEGER
    DIM laengen AS ARRAY OF INTEGER
    DIM arten AS ARRAY OF STRING
    (starts, laengen, arten) = SYNTAX_SPANS(stueck)
    DIM n AS INTEGER : n = LEN(starts)
    IF n = 0 THEN RETURN
    DIM s2 AS ARRAY OF INTEGER : s2 = []
    DIM l2 AS ARRAY OF INTEGER : l2 = []
    DIM f2 AS ARRAY OF INTEGER : f2 = []
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        ARRAY_PUSH(s2, starts[i] + von) : ARRAY_PUSH(l2, laengen[i])
        ARRAY_PUSH(f2, farbeFuer(arten[i]))
    NEXT
    ' Das Wort unter der Marke ueberall im Ausschnitt. Erst ab zwei
    ' Zeichen: ein einzelnes `i` faerbte die halbe Datei.
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF LEN(wort) >= 2 THEN
        DIM klein AS STRING : klein = LOWER$(stueck)
        DIM kwort AS STRING : kwort = LOWER$(wort)
        DIM ab AS INTEGER : ab = 0
        WHILE ab < LEN(klein)
            DIM p AS INTEGER : p = INSTR(MID$(klein, ab, LEN(klein)), kwort)
            IF p < 0 THEN BREAK
            p = ab + p
            IF NOT wortzeichenAn(stueck, p - 1) AND NOT wortzeichenAn(stueck, p + LEN(wort)) THEN
                ARRAY_PUSH(s2, p + von) : ARRAY_PUSH(l2, LEN(wort)) : ARRAY_PUSH(f2, F_FUNDSTELLE)
            END IF
            ab = p + LEN(wort)
        WEND
    END IF
    ' Die Treffer der offenen Suchleiste, im Ausschnitt und zeilenweise wie
    ' die Suche selbst -- sonst markierte `^` hier etwas anderes als dort.
    IF sucheOffen AND suchtext <> "" THEN
        DIM sm AS STRING : sm = suchMuster$(suchtext)
        DIM suz AS ARRAY OF STRING : suz = SPLIT$(stueck, NL)
        DIM sOff AS INTEGER : sOff = 0
        DIM szi AS INTEGER
        FOR szi = 0 TO LEN(suz) - 1
            DIM sab AS INTEGER : sab = 0
            DIM swie AS INTEGER : swie = 0
            WHILE sab <= LEN(suz[szi]) AND swie < 200
                DIM sp AS INTEGER
                DIM sl AS INTEGER
                TRY
                    (sp, sl) = REGEX_FIND_POS(suz[szi], sm, sab)
                CATCH e
                    sp = -1
                END TRY
                IF sp < 0 THEN BREAK
                IF sl > 0 THEN
                    ARRAY_PUSH(s2, von + sOff + sp) : ARRAY_PUSH(l2, sl) : ARRAY_PUSH(f2, F_SUCHTREFFER)
                END IF
                sab = sp + MAX(sl, 1)
                swie = swie + 1
            WEND
            sOff = sOff + LEN(suz[szi]) + 1
        NEXT
    END IF
    ' Das Klammernpaar um die Marke: erst links davon schauen, dann rechts
    ' -- so wie man es beim Tippen erwartet, wenn man gerade eine Klammer
    ' geschrieben hat.
    DIM sz AS ARRAY OF STRING : sz = SPLIT$(stueck, NL)
    DIM rel AS INTEGER : rel = cz - 1 - erste
    IF rel >= 0 AND rel < LEN(sz) THEN
        DIM markePos AS INTEGER : markePos = cs - 1
        DIM r AS INTEGER
        FOR r = 0 TO rel - 1
            markePos = markePos + LEN(sz[r]) + 1
        NEXT
        DIM kp AS INTEGER : kp = markePos - 1
        DIM gegen AS INTEGER : gegen = -1
        IF kp >= 0 THEN gegen = klammerPartner(stueck, kp)
        IF gegen < 0 AND markePos < LEN(stueck) THEN
            kp = markePos
            gegen = klammerPartner(stueck, kp)
        END IF
        IF gegen >= 0 THEN
            ARRAY_PUSH(s2, kp + von) : ARRAY_PUSH(l2, 1) : ARRAY_PUSH(f2, F_KLAMMER)
            ARRAY_PUSH(s2, gegen + von) : ARRAY_PUSH(l2, 1) : ARRAY_PUSH(f2, F_KLAMMER)
        END IF
    END IF
    GUI_TEXTAREA_SPANS(ta, s2, l2, f2)
    ' Farbfelder neben den &H-Literalen -- eine Farbe sieht man nicht, man
    ' rechnet sie sonst im Kopf aus.
    DIM fs AS ARRAY OF INTEGER : fs = []
    DIM fl AS ARRAY OF INTEGER : fl = []
    DIM ff AS ARRAY OF INTEGER : ff = []
    farbliteraleSuchen(stueck, von, fs, fl, ff)
    GUI_TEXTAREA_SWATCHES(ta, fs, fl, ff)
END SUB

' --- Pruefen -----------------------------------------------------------
DIM problemZeilen AS ARRAY OF INTEGER : problemZeilen = []
' Je Eintrag: nur ein Hinweis (etwa eine unbenutzte Variable)? Hinweise stehen
' grau in der Liste, zaehlen nicht als Problem und bekommen keine Marke.
DIM problemHinweis AS ARRAY OF BOOLEAN : problemHinweis = []

SUB pruefen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF problemModus = 0 THEN GUI_LISTBOX_CLEAR(lstProbleme)
    IF ta < 0 THEN RETURN
    ' Nur Drachenhauch pruefen: eine .json oder .md durch den Uebersetzer
    ' zu schicken fuellt die Liste mit Meldungen ueber etwas, das gar kein
    ' Programm ist.
    IF tabPfade[aktiverTab] <> "" AND LOWER$(RIGHT$(tabPfade[aktiverTab], 3)) <> ".dh" THEN
        GUI_SET_TEXT(lblProbleme, tr$("Probleme: -- (") + BASENAME(tabPfade[aktiverTab]) + _
                     " ist kein Drachenhauch)")
        RETURN
    END IF
    DIM basis AS STRING : basis = projektOrdner
    IF tabPfade[aktiverTab] <> "" THEN basis = DIRNAME(tabPfade[aktiverTab])
    DIM j AS JSON_HANDLE
    j = JSON_PARSE(CODE_CHECK$(GUI_TEXT(ta), basis))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM zeilen[MAX(n, 1)] AS INTEGER
    DIM i AS INTEGER
    DIM fehler AS INTEGER : fehler = 0
    DIM hinweise AS INTEGER : hinweise = 0
    problemHinweis = []
    DIM fz AS ARRAY OF INTEGER : fz = []
    DIM ftx AS ARRAY OF STRING : ftx = []
    DIM ffa AS ARRAY OF INTEGER : ffa = []
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        zeilen[i] = JSON_GET_INT(j, p + ".zeile")
        DIM art AS STRING : art = JSON_GET_STRING(j, p + ".schwere")
        IF art <> "hinweis" THEN fehlerSammeln(fz, ftx, ffa, zeilen[i], JSON_GET_STRING(j, p + ".meldung"), art = "fehler")
        IF art = "fehler" THEN fehler = fehler + 1
        IF art = "hinweis" THEN hinweise = hinweise + 1
        ARRAY_PUSH(problemHinweis, art = "hinweis")
        IF problemModus = 0 THEN
            GUI_LISTBOX_ADD(lstProbleme, "Zeile " + STR$(zeilen[i]) + ": " + JSON_GET_STRING(j, p + ".meldung"))
            IF art = "fehler" THEN
                GUI_LISTBOX_COLOR(lstProbleme, i, &HE06060)
            ELSEIF art = "hinweis" THEN
                GUI_LISTBOX_COLOR(lstProbleme, i, &H909CA8)
            ELSE
                GUI_LISTBOX_COLOR(lstProbleme, i, &HE0C060)
            END IF
        END IF
    NEXT
    problemZeilen = zeilen
    wellenSetzen(ta, j, n)
    typenSammeln(ta, basis)
    DIM altF AS GUI_WIDGET : altF = fehlerFeld
    fehlerFeld = ta : fehlerZeilen = fz : fehlerTexte = ftx : fehlerFarben = ffa
    IF altF >= 0 AND altF <> ta THEN hinweiseZeigen(altF)
    hinweiseZeigen(ta)
    IF fehlerEndeAn AND LEN(fz) > 0 THEN protokoll("fehlertexte " + STR$(LEN(fz)))
    IF problemModus = 0 THEN
        IF n = 0 THEN
            GUI_SET_TEXT(lblProbleme, tr$("Probleme: keine"))
        ELSE
            DIM zusatz AS STRING : zusatz = ""
            IF hinweise > 0 THEN zusatz = ", " + STR$(hinweise) + IIF(hinweise = 1, " Hinweis", " Hinweise")
            GUI_SET_TEXT(lblProbleme, tr$("Probleme: ") + STR$(fehler) + tr$(" Fehler, ") + STR$(n - fehler - hinweise) + tr$(" Warnungen") + zusatz)
        END IF
    END IF
    ' Gezaehlt werden Fehler und Warnungen; Hinweise sind kein Problem.
    protokoll("geprueft " + STR$(n - hinweise))
    IF hinweise > 0 THEN protokoll("hinweise " + STR$(hinweise))
    gliederungFuellen(GUI_TEXT(ta))
    zaehlerSetzen_(ta)
END SUB

' Fehler und Warnungen DORT unterstreichen, wo sie stehen (rot bzw. gelb),
' statt nur als Marke am Rand. CODE_CHECK$ nennt Spalte und Laenge (der
' Uebersetzer kennt die Stelle bei Syntaxfehlern, bei einem genannten Namen
' ist es dessen erstes Vorkommen in der Zeile, sonst die Zeile ohne
' Einrueckung). Dieselben Stellen fragt der Tooltip beim Ueberfahren.
SUB wellenSetzen(ta AS GUI_WIDGET, j AS JSON_HANDLE, n AS INTEGER)
    DIM tz AS ARRAY OF STRING : tz = SPLIT$(GUI_TEXT(ta), NL)
    DIM anfang[MAX(LEN(tz), 1)] AS INTEGER
    DIM k AS INTEGER
    DIM summe AS INTEGER : summe = 0
    FOR k = 0 TO LEN(tz) - 1
        anfang[k] = summe
        summe = summe + LEN(tz[k]) + 1
    NEXT
    DIM ws AS ARRAY OF INTEGER : ws = []
    DIM wl AS ARRAY OF INTEGER : wl = []
    DIM wf AS ARRAY OF INTEGER : wf = []
    probFeld = ta
    probZeile = [] : probSpalte = [] : probLaenge = [] : probMeldung = [] : probFehler = [] : probKorr = [] : probHinw = []
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        DIM z AS INTEGER : z = JSON_GET_INT(j, p + ".zeile")
        DIM sp AS INTEGER : sp = 1
        DIM ln AS INTEGER : ln = 1
        IF JSON_HAS(j, p + ".spalte") THEN sp = JSON_GET_INT(j, p + ".spalte") : ln = JSON_GET_INT(j, p + ".laenge")
        IF z < 1 OR z > LEN(tz) THEN CONTINUE
        ARRAY_PUSH(ws, anfang[z - 1] + sp - 1)
        ARRAY_PUSH(wl, ln)
        DIM schw AS STRING : schw = JSON_GET_STRING(j, p + ".schwere")
        ARRAY_PUSH(wf, IIF(schw = "fehler", &HE84848, IIF(schw = "hinweis", &H8894A0, &HE0B040)))
        ARRAY_PUSH(probZeile, z) : ARRAY_PUSH(probSpalte, sp) : ARRAY_PUSH(probLaenge, ln)
        ARRAY_PUSH(probMeldung, JSON_GET_STRING(j, p + ".meldung"))
        ARRAY_PUSH(probFehler, JSON_GET_STRING(j, p + ".schwere") = "fehler")
        ARRAY_PUSH(probHinw, JSON_GET_STRING(j, p + ".schwere") = "hinweis")
        IF JSON_HAS(j, p + ".korrekturen") THEN
            ARRAY_PUSH(probKorr, JSON_STRINGIFY(JSON_GET_JSON(j, p + ".korrekturen")))
        ELSE
            ARRAY_PUSH(probKorr, "")
        END IF
    NEXT
    GUI_TEXTAREA_SQUIGGLES(ta, ws, wl, wf)
    protokoll("wellen " + STR$(LEN(ws)))
END SUB

' --- Schnellkorrektur (Strg+.) ---------------------------------------
' Die Korrekturen der Meldungen in der Zeile der Marke. Steht die Marke auf
' einer unterstrichenen Stelle, nur deren -- sonst alle der Zeile. Die
' Vorschlaege rechnet die Laufzeit (CODE_CHECK$), dieselben bekommt VS Code.
SUB korrekturZeigen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR ta <> probFeld THEN
        GUI_SET_TEXT(lblStatus, tr$("Hier gibt es nichts zu korrigieren."))
        RETURN
    END IF
    DIM z AS INTEGER
    DIM sp AS INTEGER
    (z, sp) = GUI_TEXTAREA_CURSOR(ta)
    DIM genau AS BOOLEAN : genau = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(probZeile) - 1
        IF probZeile[i] = z AND probKorr[i] <> "" AND sp >= probSpalte[i] AND sp <= probSpalte[i] + probLaenge[i] THEN genau = TRUE
    NEXT
    paletteNamen = [] : paletteKennungen = [] : paletteDetails = []
    FOR i = 0 TO LEN(probZeile) - 1
        IF probZeile[i] <> z OR probKorr[i] = "" THEN CONTINUE
        IF genau AND (sp < probSpalte[i] OR sp > probSpalte[i] + probLaenge[i]) THEN CONTINUE
        DIM j AS JSON_HANDLE : j = JSON_PARSE("{" + CHR$(34) + "k" + CHR$(34) + ":" + probKorr[i] + "}")
        DIM k AS INTEGER
        FOR k = 0 TO JSON_LEN(j, "k") - 1
            ARRAY_PUSH(paletteNamen, JSON_GET_STRING(j, "k." + STR$(k) + ".titel"))
            ARRAY_PUSH(paletteKennungen, STR$(i) + ":" + STR$(k))
            DIM kurz AS STRING : kurz = probMeldung[i]
            IF LEN(kurz) > 40 THEN kurz = LEFT$(kurz, 39) + "…"
            ARRAY_PUSH(paletteDetails, kurz)
        NEXT
    NEXT
    IF LEN(paletteNamen) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Hier gibt es nichts zu korrigieren."))
        protokoll("korrektur keine")
        RETURN
    END IF
    protokoll("korrektur angebot " + JOIN$(paletteNamen, " | "))
    waehlerOeffnen("korrektur", tr$("Schnellkorrektur"))
END SUB

' Eine Korrektur ("meldung:korrektur") anwenden: jede Aenderung als Auswahl
' + INSERT, von hinten nach vorn (sonst verschoebe die erste die Stellen der
' folgenden). Das Feld prueft danach wie nach jedem Tippen neu.
SUB korrekturAnwenden(kennung AS STRING)
    DIM teile AS ARRAY OF STRING : teile = SPLIT$(kennung, ":")
    IF LEN(teile) <> 2 THEN RETURN
    DIM i AS INTEGER : i = INT(VAL(teile[0]))
    DIM k AS INTEGER : k = INT(VAL(teile[1]))
    IF i < 0 OR i >= LEN(probKorr) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = probFeld
    DIM j AS JSON_HANDLE : j = JSON_PARSE("{" + CHR$(34) + "k" + CHR$(34) + ":" + probKorr[i] + "}")
    DIM pfad AS STRING : pfad = "k." + STR$(k) + ".aenderungen"
    DIM a AS INTEGER
    FOR a = JSON_LEN(j, pfad) - 1 TO 0 STEP -1
        DIM q AS STRING : q = pfad + "." + STR$(a)
        DIM az AS INTEGER : az = JSON_GET_INT(j, q + ".zeile")
        DIM asp AS INTEGER : asp = JSON_GET_INT(j, q + ".spalte")
        ' Bis wohin, auch ueber das Zeilenende (eine Zeile entfernen).
        DIM bz AS INTEGER : bz = JSON_GET_INT(j, q + ".bis_zeile")
        DIM bsp AS INTEGER : bsp = JSON_GET_INT(j, q + ".bis_spalte")
        GUI_TEXTAREA_SELECT(ta, az, asp, bz, bsp)
        GUI_TEXTAREA_INSERT(ta, JSON_GET_STRING(j, q + ".text"))
    NEXT
    GUI_FOCUS(ta)
    ' Die gemerkten Stellen gehoeren zum alten Text -- bis zur naechsten
    ' Pruefung gilt nichts mehr davon.
    probFeld = -1
    DIM titel AS STRING : titel = JSON_GET_STRING(j, "k." + STR$(k) + ".titel")
    GUI_SET_TEXT(lblStatus, titel)
    protokoll("korrektur " + titel)
END SUB

' Die Meldung zu einer Stelle (Zeile, Spalte ab 1) im gepruefenen Feld, leer
' = keine. Das Ende zaehlt mit: die Maus steht oft genau hinter dem Wort.
FUNCTION meldungBei$(ta AS GUI_WIDGET, z AS INTEGER, s AS INTEGER) AS STRING
    IF ta <> probFeld OR z < 1 THEN RETURN ""
    DIM i AS INTEGER
    DIM raus AS STRING : raus = ""
    FOR i = 0 TO LEN(probZeile) - 1
        IF probZeile[i] = z AND s >= probSpalte[i] AND s <= probSpalte[i] + probLaenge[i] THEN
            IF raus <> "" THEN raus = raus + NL
            raus = raus + probMeldung[i]
            IF probKorr[i] <> "" THEN raus = raus + NL + "Strg+. schlägt eine Korrektur vor."
        END IF
    NEXT
    RETURN raus
END FUNCTION

' --- Gliederung: SUB/FUNCTION/CLASS der aktiven Datei (CODE_SYMBOLS$) ---
' Faltbare Bloecke aus der EINRUECKUNG -- alles, was CODE_SYMBOLS$ nicht
' kennt: eine FOR-Schleife, ein IF-Zweig, ein von Hand eingerueckter
' Abschnitt. Ein Block ist eine Zeile, unter der mindestens eine tiefer
' eingerueckte steht; er endet an der letzten davon.
'
' Leerzeilen zaehlen nicht mit (sie haben gar keine Einrueckung), und was
' die Gliederung schon nennt, kommt nicht doppelt: sonst haette jede
' Kopfzeile zwei Bereiche, und der engere -- der aus der Einrueckung --
' gewaenne, obwohl der Block derselbe ist.
SUB einzugBloecke(quelle AS STRING, fv AS ARRAY OF INTEGER, fb AS ARRAY OF INTEGER)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM n AS INTEGER : n = LEN(zeilen)
    IF n > 4000 THEN RETURN        ' bei sehr grossen Dateien nicht je Pruefung
    DIM tiefe[MAX(n, 1)] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        IF TRIM$(zeilen[i]) = "" THEN
            tiefe[i] = -1
        ELSE
            tiefe[i] = LEN(zeilen[i]) - LEN(LTRIM$(zeilen[i]))
        END IF
    NEXT
    FOR i = 0 TO n - 2
        IF tiefe[i] < 0 THEN CONTINUE
        DIM k AS INTEGER : k = i + 1
        DIM ende AS INTEGER : ende = i
        WHILE k < n
            IF tiefe[k] < 0 THEN
                k = k + 1
                CONTINUE
            END IF
            IF tiefe[k] <= tiefe[i] THEN BREAK
            ende = k
            k = k + 1
        WEND
        IF ende <= i THEN CONTINUE
        IF ARRAY_INDEXOF(fv, i + 1) >= 0 THEN CONTINUE
        ARRAY_PUSH(fv, i + 1) : ARRAY_PUSH(fb, ende + 1)
    NEXT
END SUB

SUB gliederungFuellen(quelle AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM namen AS ARRAY OF STRING : namen = []
    DIM zeilen AS ARRAY OF INTEGER : zeilen = []
    DIM artLaenge AS ARRAY OF INTEGER : artLaenge = []   ' -1 = ein Kind (nur der Name)
    DIM schl AS STRING : schl = ""
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        DIM eintrag AS STRING : eintrag = JSON_GET_STRING(j, p + ".art") + " " + JSON_GET_STRING(j, p + ".name")
        ARRAY_PUSH(namen, eintrag) : ARRAY_PUSH(zeilen, JSON_GET_INT(j, p + ".von"))
        ARRAY_PUSH(artLaenge, LEN(JSON_GET_STRING(j, p + ".art")))
        schl = schl + eintrag + ":" + STR$(JSON_GET_INT(j, p + ".von")) + ";"
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            ARRAY_PUSH(namen, "    " + JSON_GET_STRING(j, pk + ".name")) : ARRAY_PUSH(zeilen, JSON_GET_INT(j, pk + ".von"))
            ARRAY_PUSH(artLaenge, -1)
            schl = schl + JSON_GET_STRING(j, pk + ".name") + ":" + STR$(JSON_GET_INT(j, pk + ".von")) + ";"
        NEXT
    NEXT
    ' Dieselben Bloecke sind die faltbaren -- die Laufzeit kennt keine
    ' Sprache und erfaehrt sie nur so.
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 AND schl <> faltSchluessel THEN
        faltSchluessel = schl
        DIM fv AS ARRAY OF INTEGER : fv = []
        DIM fb AS ARRAY OF INTEGER : fb = []
        FOR i = 0 TO n - 1
            DIM pf AS STRING : pf = STR$(i)
            ARRAY_PUSH(fv, JSON_GET_INT(j, pf + ".von")) : ARRAY_PUSH(fb, JSON_GET_INT(j, pf + ".bis"))
            DIM mf AS INTEGER
            FOR mf = 0 TO JSON_LEN(j, pf + ".kinder") - 1
                DIM pkf AS STRING : pkf = pf + ".kinder." + STR$(mf)
                ARRAY_PUSH(fv, JSON_GET_INT(j, pkf + ".von")) : ARRAY_PUSH(fb, JSON_GET_INT(j, pkf + ".bis"))
            NEXT
        NEXT
        einzugBloecke(quelle, fv, fb)
        GUI_TEXTAREA_FOLDABLE(ta, fv, fb)
        faltenZurueck(ta)
        blockVon = fv
        blockBis = fb
    END IF
    IF schl = gliederungSchluessel THEN RETURN
    gliederungSchluessel = schl
    gliederungZeilen = zeilen
    GUI_LISTBOX_CLEAR(lstGliederung)
    ' Die Art (SUB, FUNCTION, CLASS ...) in der Farbe der Schluesselwoerter,
    ' der Name in der Farbe der Namen -- wie im Code daneben.
    DIM k AS INTEGER
    FOR k = 0 TO LEN(namen) - 1
        DIM gz AS INTEGER : gz = GUI_LISTBOX_ADD(lstGliederung, namen[k])
        IF artLaenge[k] >= 0 THEN
            GUI_LISTBOX_SPANS(lstGliederung, gz, [0, artLaenge[k] + 1], _
                [artLaenge[k], LEN(namen[k]) - artLaenge[k] - 1], [F_SCHLUESSEL, F_GRUND])
        ELSE
            GUI_LISTBOX_SPANS(lstGliederung, gz, [4], [LEN(namen[k]) - 4], [F_GRUND])
        END IF
    NEXT
    protokoll("gliederung " + STR$(n))
END SUB

' --- Verzeichnis der eigenen Symbole ueber ALLE Dateien des Projekts ---
' Die Gliederung kennt nur die vordere Datei. Ueber das ganze Projekt ist
' der Index eine eigene Sache, und er wird auf ZURUF gebaut statt je Bild:
' ein paar hundert Dateien lesen und zerlegen dauert seine Zeit, und der
' Nutzen faengt erst an, wenn jemand danach fragt.
DIM symPfade AS ARRAY OF STRING : symPfade = []
DIM symZeilen AS ARRAY OF INTEGER : symZeilen = []
DIM symNamen AS ARRAY OF STRING : symNamen = []       ' der blanke Name, fuer die Suche
DIM symAnzeige AS ARRAY OF STRING : symAnzeige = []   ' was in der Liste steht
DIM symSchluessel AS STRING : symSchluessel = "-"

FUNCTION tabMitPfad(pfad AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF wegGleich$(tabPfade[i]) = wegGleich$(pfad) THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB symbolMerken(pfad AS STRING, anzeige AS STRING, name AS STRING, zeile AS INTEGER)
    IF name = "" THEN RETURN
    ARRAY_PUSH(symPfade, pfad)
    ARRAY_PUSH(symZeilen, zeile)
    ARRAY_PUSH(symNamen, name)
    ARRAY_PUSH(symAnzeige, anzeige)
END SUB

SUB symbolEinerDatei(pfad AS STRING, kurz AS STRING, quelle AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        DIM art AS STRING : art = JSON_GET_STRING(j, p + ".art")
        DIM name AS STRING : name = JSON_GET_STRING(j, p + ".name")
        DIM zeile AS INTEGER : zeile = JSON_GET_INT(j, p + ".von")
        symbolMerken(pfad, art + " " + name + "   " + kurz + ":" + STR$(zeile), name, zeile)
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            DIM kn AS STRING : kn = JSON_GET_STRING(j, pk + ".name")
            DIM kz AS INTEGER : kz = JSON_GET_INT(j, pk + ".von")
            symbolMerken(pfad, kn + " (" + name + ")   " + kurz + ":" + STR$(kz), kn, kz)
        NEXT
    NEXT
END SUB

SUB symbolIndexBauen(erzwingen AS BOOLEAN)
    DIM dateien AS ARRAY OF STRING : dateien = projektDateien("*.dh")
    DIM schl AS STRING : schl = projektOrdner + "|" + STR$(LEN(dateien))
    IF NOT erzwingen AND schl = symSchluessel THEN RETURN
    symSchluessel = schl
    symPfade = [] : symZeilen = [] : symNamen = [] : symAnzeige = []
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        ' Ein offener Reiter zaehlt mit dem Stand IM Editor, nicht mit dem auf
        ' der Platte -- sonst zeigte das Verzeichnis auf Zeilen, die es seit
        ' der letzten Aenderung nicht mehr gibt.
        DIM t AS INTEGER : t = tabMitPfad(pfad)
        DIM quelle AS STRING : quelle = ""
        DIM gut AS BOOLEAN : gut = TRUE
        IF t >= 0 THEN
            quelle = GUI_TEXT(tabFelder[t])
        ELSE
            TRY
                quelle = dateiLesen(pfad)
            CATCH e
                gut = FALSE
            END TRY
        END IF
        IF gut THEN symbolEinerDatei(pfad, d, quelle)
    NEXT
    protokoll("symbolindex " + STR$(LEN(symNamen)))
END SUB

' Den Namen im ganzen Projekt suchen -- die Nummer im Index oder -1.
FUNCTION symbolSuchen(name AS STRING) AS INTEGER
    IF name = "" THEN RETURN -1
    symbolIndexBauen(FALSE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(symNamen) - 1
        IF LOWER$(symNamen[i]) = LOWER$(name) THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB symbolAnspringen(nummer AS INTEGER)
    IF nummer < 0 OR nummer >= LEN(symPfade) THEN RETURN
    DIM pfad AS STRING : pfad = symPfade[nummer]
    DIM zeile AS INTEGER : zeile = symZeilen[nummer]
    IF aktiverTab < 0 OR tabPfade[aktiverTab] <> pfad THEN dateiOeffnen(pfad)
    IF aktivesFeld() >= 0 THEN GUI_TEXTAREA_GOTO(aktivesFeld(), zeile, 1)
    GUI_SET_TEXT(lblStatus, symAnzeige[nummer])
    protokoll("symbol " + BASENAME(pfad) + " " + STR$(zeile))
END SUB

SUB symbolVerzeichnis()
    symbolIndexBauen(TRUE)
    IF LEN(symNamen) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Keine Symbole in ") + projektOrdner + ".")
        RETURN
    END IF
    paletteNamen = []
    paletteKennungen = []
    paletteDetails = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(symAnzeige) - 1
        ARRAY_PUSH(paletteNamen, symAnzeige[i]) : ARRAY_PUSH(paletteKennungen, STR$(i)) : ARRAY_PUSH(paletteDetails, "")
    NEXT
    waehlerOeffnen("symbol", tr$("Symbole im Projekt (") + STR$(LEN(symNamen)) + ")")
    ' Wie beim Schnipsel: das Wort unter der Marke fuellt den Filter aus.
    DIM anfang AS STRING : anfang = wortUnterMarke$()
    IF anfang <> "" THEN
        GUI_SET_TEXT(tfPalette, anfang)
        paletteLetzterFilter = anfang
        paletteFuellen(anfang)
    END IF
END SUB

' Die Symbolspur zur Marke: welcher Block umschliesst sie? Die Gliederung
' hat schon Anfang und Ende jedes Symbols -- gesucht ist der ENGSTE, der
' die Zeile enthaelt, samt seinem Elternteil.
DIM spurSchluessel AS STRING : spurSchluessel = "-"

SUB spurNachziehen()
    IF aktiverTab < 0 THEN RETURN
    DIM ta AS GUI_WIDGET : ta = tabFelder[aktiverTab]
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM schl AS STRING : schl = STR$(aktiverTab) + ":" + STR$(z) + ":" + gliederungSchluessel
    IF schl = spurSchluessel THEN RETURN
    spurSchluessel = schl
    DIM datei AS STRING : datei = IIF(tabPfade[aktiverTab] = "", "Unbenannt", BASENAME(tabPfade[aktiverTab]))
    DIM spur AS STRING : spur = datei
    ' Die Pfadleiste bekommt je Teil die ZEILE seines Blocks als Wert --
    ' ein Klick springt dorthin (pfadAnspringen).
    GUI_BREADCRUMB_CLEAR(lblSpur)
    GUI_BREADCRUMB_ADD(lblSpur, datei, "1")
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(GUI_TEXT(ta)))
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "") - 1
        DIM p AS STRING : p = STR$(i)
        IF z < JSON_GET_INT(j, p + ".von") OR z > JSON_GET_INT(j, p + ".bis") THEN CONTINUE
        spur = spur + "  >  " + JSON_GET_STRING(j, p + ".art") + " " + JSON_GET_STRING(j, p + ".name")
        GUI_BREADCRUMB_ADD(lblSpur, JSON_GET_STRING(j, p + ".art") + " " + JSON_GET_STRING(j, p + ".name"), STR$(JSON_GET_INT(j, p + ".von")))
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            IF z >= JSON_GET_INT(j, pk + ".von") AND z <= JSON_GET_INT(j, pk + ".bis") THEN
                spur = spur + "  >  " + JSON_GET_STRING(j, pk + ".name")
                GUI_BREADCRUMB_ADD(lblSpur, JSON_GET_STRING(j, pk + ".name"), STR$(JSON_GET_INT(j, pk + ".von")))
            END IF
        NEXT
    NEXT
    protokoll("spur " + spur)
END SUB

' Ein Klick in die Pfadleiste: an den Anfang des Blocks springen.
SUB pfadAnspringen(zeile AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_TEXTAREA_GOTO(ta, MAX(1, zeile), 1)
    GUI_FOCUS(ta)
    protokoll("pfad sprung " + STR$(zeile))
END SUB

SUB gliederungAnspringen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstGliederung)
    IF sel < 0 OR sel >= LEN(gliederungZeilen) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_TEXTAREA_GOTO(ta, gliederungZeilen[sel], 1)
    GUI_FOCUS(ta)
END SUB

SUB problemAnspringen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstProbleme)
    IF problemModus = 1 THEN
        IF sel < 0 OR sel >= LEN(sucheZeilen) THEN RETURN
        DIM sd AS STRING : sd = sucheDateien[sel]
        IF MID$(sd, 1, 1) = ":" OR LEFT$(sd, 1) = "/" THEN dateiOeffnen(sd) ELSE dateiOeffnen(PATHJOIN(projektOrdner, sd))
        DIM tf AS GUI_WIDGET : tf = aktivesFeld()
        IF tf >= 0 THEN GUI_TEXTAREA_GOTO(tf, sucheZeilen[sel], 1) : GUI_FOCUS(tf)
        RETURN
    END IF
    IF sel < 0 OR sel >= LEN(problemZeilen) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_TEXTAREA_GOTO(ta, problemZeilen[sel], 1)
    GUI_FOCUS(ta)
END SUB

' --- Suche im Projekt --------------------------------------------------
' `zweitens` ist ein zweiter Suchtext (ODER) -- fuer die TODO/FIXME-Liste.
SUB projektSuchen(gesucht AS STRING, zweitens AS STRING)
    IF gesucht = "" THEN RETURN
    GUI_LISTBOX_CLEAR(lstProbleme)
    DIM dateien AS ARRAY OF STRING : dateien = projektDateien("*.dh")
    DIM sd AS ARRAY OF STRING : sd = []
    DIM sz AS ARRAY OF INTEGER : sz = []
    DIM klein AS STRING : klein = LOWER$(gesucht)
    DIM klein2 AS STRING : klein2 = LOWER$(zweitens)
    DIM treffer AS INTEGER : treffer = 0
    DIM inDateien AS INTEGER : inDateien = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(projektOrdner, d))
        DIM vorher AS INTEGER : vorher = treffer
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            IF treffer >= 500 THEN BREAK
            IF passtSuche(zeilen[i], gesucht) OR (zweitens <> "" AND passtSuche(zeilen[i], zweitens)) THEN
                ARRAY_PUSH(sd, d)
                ARRAY_PUSH(sz, i + 1)
                GUI_LISTBOX_ADD(lstProbleme, d + ":" + STR$(i + 1) + ": " + TRIM$(zeilen[i]))
                treffer = treffer + 1
            END IF
        NEXT
        IF treffer > vorher THEN inDateien = inDateien + 1
    NEXT
    sucheDateien = sd
    sucheZeilen = sz
    problemModus = 1
    DIM was AS STRING : was = gesucht
    IF zweitens <> "" THEN was = gesucht + "/" + zweitens
    GUI_SET_TEXT(lblProbleme, tr$("Suche '") + was + "': " + STR$(treffer) + tr$(" Treffer in ") + STR$(inDateien) + tr$(" Dateien -- Umschalt+F7 zeigt wieder die Probleme"))
    protokoll("suche " + STR$(treffer))
END SUB

' --- Aufrufzaehler ------------------------------------------------------
' Hinter jeder SUB/FUNCTION der Datei steht, wie oft ihr Name im Projekt
' vorkommt ("3 Aufrufe"), gedaempft hinter dem Zeilenende
' (GUI_TEXTAREA_HINTS); ein Klick darauf oeffnet "Wer ruft das auf?".
' Gezaehlt wird jedes Vorkommen des Namens als ganzes Wort ausserhalb von
' Kommentaren und Zeichenketten, ohne die Kopfzeilen selbst -- auch als
' FUNCREF (`GUI_ON_CLICK(k, malen)`) und als Methode (`held.malen()`). Das
' ist Text, keine Namensaufloesung: zwei Methoden gleichen Namens in zwei
' Klassen zaehlen zusammen.
'
' Je Datei wird EINMAL gezaehlt (alle Woerter), fuer Dateien, die nicht
' offen sind, gemerkt bis zum naechsten Sichern -- sonst laese jede
' Pruefung das ganze Projekt neu.
DIM zaehlCache AS MAP OF STRING
DIM zaehlFeld AS GUI_WIDGET : zaehlFeld = -1
DIM zaehlZeilen AS ARRAY OF INTEGER : zaehlZeilen = []
DIM zaehlNamen AS ARRAY OF STRING : zaehlNamen = []
DIM zaehlTexte AS ARRAY OF STRING : zaehlTexte = []

SUB zaehlerSetzen(an AS BOOLEAN)
    zaehlerAn = an
    GUI_MENU_CHECK(miZaehler, an)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 THEN zaehlerSetzen_(ta)
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Aufrufzähler an."), tr$("Aufrufzähler aus.")))
    protokoll("aufrufzaehler " + IIF(an, "an", "aus"))
    konfigSichern()
END SUB

' Wie oft jeder Name in einer Quelle benutzt wird (CODE_NAMES: ohne
' Kommentare, Zeichenketten und die Definition selbst), als Text
' ";name=anzahl;..." -- ein Cache-Eintrag ist eine Zeichenkette, und
' nachgeschlagen wird mit INSTR nach ";name=".
FUNCTION woerterZaehlen$(quelle AS STRING) AS STRING
    DIM m AS MAP OF INTEGER : m = CODE_NAMES(quelle)
    DIM teile AS ARRAY OF STRING : teile = [";"]
    DIM k AS STRING
    DIM v AS INTEGER
    FOR EACH k, v IN m
        ARRAY_PUSH(teile, k + "=" + STR$(v) + ";")
    NEXT
    RETURN JOIN$(teile, "")
END FUNCTION

' Die Zaehlung einer Projektdatei -- aus dem Reiter frisch, von der
' Platte ueber den Cache.
FUNCTION zaehlungVon$(pfad AS STRING) AS STRING
    IF tabMitPfad(pfad) >= 0 THEN RETURN woerterZaehlen$(GUI_TEXT(tabFelder[tabMitPfad(pfad)]))
    DIM schl AS STRING : schl = LOWER$(wegGleich$(pfad))
    IF MAPHAS(zaehlCache, schl) THEN RETURN MAPGET(zaehlCache, schl)
    DIM q AS STRING : q = ""
    TRY
        q = dateiLesen(pfad)
    CATCH e
        q = ""
    END TRY
    DIM m AS STRING : m = woerterZaehlen$(q)
    MAPPUT(zaehlCache, schl, m)
    RETURN m
END FUNCTION

' Die Zaehler fuer das Feld setzen (oder wegnehmen). Waehrend der Debugger
' dort Werte zeigt, bleiben die stehen.
SUB zaehlerSetzen_(ta AS GUI_WIDGET)
    IF ta < 0 OR ta = werteFeld THEN RETURN
    IF NOT zaehlerAn THEN
        IF zaehlFeld = ta THEN
            zaehlFeld = -1 : zaehlZeilen = [] : zaehlNamen = []
            hinweiseZeigen(ta)
        END IF
        RETURN
    END IF
    DIM quelle AS STRING : quelle = GUI_TEXT(ta)
    DIM zl AS ARRAY OF INTEGER : zl = []
    DIM nm AS ARRAY OF STRING : nm = []
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM t AS STRING : t = TRIM$(zeilen[i])
        DIM gross AS STRING : gross = UPPER$(t)
        DIM ab AS INTEGER : ab = -1
        IF LEFT$(gross, 4) = "SUB " THEN ab = 4
        IF LEFT$(gross, 9) = "FUNCTION " THEN ab = 9
        IF ab < 0 THEN CONTINUE
        DIM rest AS STRING : rest = TRIM$(MID$(t, ab))
        DIM kl AS INTEGER : kl = INSTR(rest, "(")
        IF kl <= 0 THEN CONTINUE
        ARRAY_PUSH(zl, i + 1)
        ARRAY_PUSH(nm, TRIM$(LEFT$(rest, kl)))
    NEXT
    IF LEN(zl) = 0 THEN
        zaehlFeld = -1 : zaehlZeilen = [] : zaehlNamen = []
        hinweiseZeigen(ta)
        RETURN
    END IF
    DIM summe AS MAP OF INTEGER : summe = {}
    DIM n AS STRING
    FOR EACH n IN nm
        MAPPUT(summe, LOWER$(n), 0)
    NEXT
    ' Das eigene Feld zaehlt immer mit (auch eine noch nie gesicherte Datei).
    DIM eigen AS STRING : eigen = ""
    DIM t2 AS INTEGER
    FOR t2 = 0 TO tabAnzahl - 1
        IF tabFelder[t2] = ta THEN eigen = tabPfade[t2]
    NEXT
    DIM dateien AS ARRAY OF STRING : dateien = []
    IF projektOrdner <> "" THEN dateien = projektDateien("*.dh")
    zaehlerAddieren(summe, woerterZaehlen$(quelle))
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        IF eigen <> "" AND wegGleich$(pfad) = wegGleich$(eigen) THEN CONTINUE
        zaehlerAddieren(summe, zaehlungVon$(pfad))
    NEXT
    DIM texte AS ARRAY OF STRING : texte = []
    FOR i = 0 TO LEN(nm) - 1
        DIM k AS INTEGER : k = MAPGET(summe, LOWER$(nm[i]))
        ARRAY_PUSH(texte, IIF(k = 0, "nicht aufgerufen", IIF(k = 1, "1 Aufruf", STR$(k) + " Aufrufe")))
    NEXT
    zaehlFeld = ta : zaehlZeilen = zl : zaehlNamen = nm : zaehlTexte = texte
    hinweiseZeigen(ta)
    protokoll("aufrufzaehler " + STR$(LEN(zl)))
END SUB

SUB zaehlerAddieren(summe AS MAP OF INTEGER, zaehlung AS STRING)
    DIM k AS STRING
    FOR EACH k IN MAPKEYS(summe)
        DIM p AS INTEGER : p = INSTR(zaehlung, ";" + k + "=")
        IF p < 0 THEN CONTINUE
        DIM a AS INTEGER : a = p + LEN(k) + 2
        DIM e AS INTEGER : e = INSTR(MID$(zaehlung, a), ";")
        MAPPUT(summe, k, MAPGET(summe, k) + INT(VAL(MID$(zaehlung, a, e))))
    NEXT
END SUB

SUB zaehlerKlick(ta AS GUI_WIDGET, zeile AS INTEGER)
    IF ta <> zaehlFeld THEN RETURN
    DIM i AS INTEGER : i = ARRAY_INDEXOF(zaehlZeilen, zeile)
    IF i < 0 THEN RETURN
    protokoll("aufrufzaehler klick " + zaehlNamen[i])
    aufruferZeigenFuer(zaehlNamen[i])
END SUB

' --- Pruefsammlungen ----------------------------------------------------
' Strg+Alt+F5 laesst `dhrt test` ueber die Sammlung im Reiter laufen (eine
' .dhtest), sonst ueber den Projektordner; Strg+Alt+Umschalt+F5 nur den Fall
' unter der Marke (`--fall` mit seinem Namen aus der `===`-Zeile darueber).
' Ein eigener Prozess neben dem Programm-Lauf, die Ausgabe laeuft wie bei
' einem Programm mit; jeder fehlgeschlagene Fall steht in der Liste unten
' rechts mit Datei und Zeile, ein Klick springt zu ihm.
DIM testProz AS INTEGER : testProz = -1
DIM testRest AS STRING : testRest = ""
DIM testDatei AS STRING : testDatei = ""
DIM testBilanz AS STRING : testBilanz = ""
DIM testFehl AS INTEGER : testFehl = 0

' Der Name des Falls, in dem die Marke steht ("" = keiner).
FUNCTION fallUnterMarke$(ta AS GUI_WIDGET) AS STRING
    DIM z AS INTEGER
    DIM sp AS INTEGER
    (z, sp) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM i AS INTEGER
    FOR i = MIN(z, LEN(zeilen)) - 1 TO 0 STEP -1
        IF LEFT$(zeilen[i], 4) = "=== " THEN RETURN TRIM$(MID$(zeilen[i], 4))
    NEXT
    RETURN ""
END FUNCTION

SUB pruefsammlungStarten(nurFall AS BOOLEAN)
    IF testProz >= 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Es läuft noch eine Prüfsammlung."))
        RETURN
    END IF
    DIM ziel AS STRING : ziel = ""
    DIM filter AS STRING : filter = ""
    DIM istSammlung AS BOOLEAN : istSammlung = FALSE
    IF aktiverTab >= 0 THEN istSammlung = LOWER$(RIGHT$(tabPfade[aktiverTab], 7)) = ".dhtest"
    IF istSammlung THEN
        ' Geprueft wird die Datei auf der Platte -- also erst sichern.
        IF GUI_TEXT(tabFelder[aktiverTab]) <> tabGesichert[aktiverTab] THEN
            IF NOT sichern(aktiverTab, FALSE) THEN RETURN
        END IF
        ziel = tabPfade[aktiverTab]
        IF nurFall THEN
            filter = fallUnterMarke$(tabFelder[aktiverTab])
            IF filter = "" THEN
                GUI_SET_TEXT(lblStatus, tr$("Die Marke steht in keinem Fall (=== Name darüber)."))
                RETURN
            END IF
        END IF
    ELSE
        IF nurFall THEN
            GUI_SET_TEXT(lblStatus, tr$("Diesen Prüffall ausführen: im Reiter ist keine .dhtest-Datei."))
            RETURN
        END IF
        IF projektOrdner = "" THEN RETURN
        ziel = projektOrdner
    END IF
    testLaufStarten([ziel], [filter])
END SUB

' Eine Folge von Laeufen: je Ziel (Datei oder Ordner) ein `dhrt test`, mit
' Fall-Namen nur dieser Fall. Ausgabe und Liste werden nur am Anfang
' geleert -- die Fehlgeschlagenen aus drei Dateien sollen zusammen dastehen.
DIM testZiele AS ARRAY OF STRING : testZiele = []
DIM testFaelle AS ARRAY OF STRING : testFaelle = []
DIM testFall AS STRING : testFall = ""
DIM testFehlSumme AS INTEGER : testFehlSumme = 0
DIM testOkSumme AS INTEGER : testOkSumme = 0

SUB testLaufStarten(ziele AS ARRAY OF STRING, faelle AS ARRAY OF STRING)
    IF testProz >= 0 OR LEN(ziele) = 0 THEN RETURN
    GUI_LISTBOX_CLEAR(lstAusgabe)
    GUI_LISTBOX_CLEAR(lstProbleme)
    sucheDateien = []
    sucheZeilen = []
    problemModus = 1
    testFehlSumme = 0 : testOkSumme = 0
    testZiele = ziele
    testFaelle = faelle
    testNaechster()
END SUB

SUB testNaechster()
    DIM ziel AS STRING : ziel = testZiele[0]
    testFall = testFaelle[0]
    ARRAY_REMOVE_AT(testZiele, 0)
    ARRAY_REMOVE_AT(testFaelle, 0)
    testRest = "" : testDatei = "" : testBilanz = "" : testFehl = 0
    IF testFall = "" THEN
        testProz = PROCESS_START("dhrt", "test", ziel)
    ELSE
        testProz = PROCESS_START("dhrt", "test", ziel, "--fall", testFall)
    END IF
    GUI_SET_TEXT(lblAusgabe, tr$("Ausgabe: Prüfsammlung läuft ..."))
    GUI_SET_TEXT(lblProbleme, tr$("Prüfsammlung läuft ..."))
    protokoll("pruefsammlung start " + BASENAME(ziel) + IIF(testFall <> "", " fall " + testFall, ""))
END SUB

' Eine Zeile der Ausgabe von `dhrt test`: in die Ausgabe, und ein FEHL in
' die Liste. Vor den FEHL-Zeilen einer Datei steht ihre FEHLER-Zeile.
SUB testZeile(z AS STRING)
    ausgabe(z)
    DIM t AS STRING : t = TRIM$(z)
    IF LEFT$(t, 8) = "FEHLER  " OR LEFT$(t, 8) = "ok      " THEN
        DIM r AS STRING : r = TRIM$(MID$(t, 8))
        DIM kl AS INTEGER : kl = INSTR(r, "  (")
        IF kl > 0 THEN r = LEFT$(r, kl)
        testDatei = r
        ' Erst gilt jeder gelaufene Fall der Datei als bestanden, die
        ' FEHL-/uebersprungen-Zeilen danach nehmen es zurueck.
        IF LOWER$(RIGHT$(r, 7)) = ".dhtest" THEN testDateiBestanden(r)
    ELSEIF LEFT$(t, 20) = "uebersprungen  Zeile" THEN
        DIM ru AS STRING : ru = MID$(t, 21)
        DIM du AS INTEGER : du = INSTR(ru, ":")
        IF du > 0 AND testDatei <> "" THEN testStatusSetzen(testDatei, INT(VAL(LEFT$(ru, du))), "ueber")
    ELSEIF LEFT$(t, 11) = "FEHL  Zeile" THEN
        DIM rest AS STRING : rest = MID$(t, 12)
        DIM dp AS INTEGER : dp = INSTR(rest, ":")
        IF dp > 0 AND testDatei <> "" THEN
            DIM nr AS INTEGER : nr = INT(VAL(LEFT$(rest, dp)))
            DIM d AS STRING : d = testDatei
            ' relativ zum Projekt, wie die Suche (problemAnspringen haengt an)
            DIM po AS STRING : po = wegGleich$(projektOrdner) + "/"
            IF LOWER$(LEFT$(wegGleich$(d), LEN(po))) = LOWER$(po) THEN d = MID$(wegGleich$(d), LEN(po))
            ARRAY_PUSH(sucheDateien, d)
            ARRAY_PUSH(sucheZeilen, nr)
            GUI_LISTBOX_ADD(lstProbleme, BASENAME(d) + ":" + STR$(nr) + ": " + TRIM$(MID$(rest, dp + 1)))
            GUI_LISTBOX_COLOR(lstProbleme, LEN(sucheZeilen) - 1, &HE06060)
            testFehl = testFehl + 1
            testStatusSetzen(testDatei, nr, "fehl")
        END IF
    ELSEIF INSTR(t, " Faelle, ") >= 0 THEN
        DIM sc AS INTEGER : sc = INSTR(t, "; ")
        testBilanz = IIF(sc >= 0, TRIM$(MID$(t, sc + 2)), t)
    END IF
END SUB

SUB testVerteilen(text AS STRING)
    IF text = "" THEN RETURN
    testRest = testRest + text
    WHILE INSTR(testRest, NL) >= 0
        DIM p AS INTEGER : p = INSTR(testRest, NL)
        testZeile(REPLACE$(LEFT$(testRest, p), CHR$(13), ""))
        testRest = MID$(testRest, p + 1)
    WEND
END SUB

SUB testNachsehen()
    IF testProz < 0 THEN RETURN
    testVerteilen(PROCESS_READ$(testProz))
    DIM err AS STRING : err = PROCESS_ERR$(testProz)
    IF err <> "" THEN testVerteilen(err)
    IF PROCESS_RUNNING(testProz) THEN RETURN
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM a AS STRING : a = PROCESS_READ$(testProz)
        DIM e AS STRING : e = PROCESS_ERR$(testProz)
        IF a = "" AND e = "" THEN
            leer = leer + 1
            SLEEP(10)
        ELSE
            testVerteilen(a + e)
            leer = 0
        END IF
    WEND
    IF testRest <> "" THEN testVerteilen(NL)
    DIM code AS INTEGER : code = PROCESS_CODE(testProz)
    PROCESS_CLOSE(testProz)
    testProz = -1
    testFehlSumme = testFehlSumme + testFehl
    IF GUI_WINDOW_SHOWN(winTests) THEN testUebersichtFuellen()
    IF LEN(testZiele) > 0 THEN
        protokoll("pruefsammlung fertig " + STR$(testFehl) + " " + STR$(code))
        testNaechster()
        RETURN
    END IF
    DIM was AS STRING : was = IIF(testBilanz <> "", testBilanz, "beendet mit Code " + STR$(code))
    GUI_SET_TEXT(lblAusgabe, tr$("Ausgabe: Prüfsammlung ") + was)
    GUI_SET_TEXT(lblProbleme, tr$("Prüfsammlung: ") + was + tr$(" -- Umschalt+F7 zeigt wieder die Probleme der Datei"))
    GUI_SET_TEXT(lblStatus, tr$("Prüfsammlung: ") + was)
    protokoll("pruefsammlung fertig " + STR$(testFehl) + " " + STR$(code))
END SUB

' --- Quellcodeverwaltung: Logik ----------------------------------------
DIM qvWurzel AS STRING : qvWurzel = ""
DIM qvPfade AS ARRAY OF STRING : qvPfade = []
DIM qvArten AS ARRAY OF STRING : qvArten = []
DIM qvHaken AS ARRAY OF BOOLEAN : qvHaken = []
DIM qvWahl AS INTEGER : qvWahl = -2
DIM qvVorgemerkt AS INTEGER : qvVorgemerkt = 0
DIM gitProz AS INTEGER : gitProz = -1
DIM gitProzArt AS STRING : gitProzArt = ""
DIM dlgQvVerwerfen AS GUI_WINDOW : dlgQvVerwerfen = 0
DIM qvVerwerfenPfad AS STRING : qvVerwerfenPfad = ""

FUNCTION qvGit$(a AS STRING, b AS STRING, c AS STRING, d AS STRING, e AS STRING) AS STRING
    TRY
        IF b = "" THEN RETURN SHELL_OUT$("git", "-C", qvWurzel, a)
        IF c = "" THEN RETURN SHELL_OUT$("git", "-C", qvWurzel, a, b)
        IF d = "" THEN RETURN SHELL_OUT$("git", "-C", qvWurzel, a, b, c)
        IF e = "" THEN RETURN SHELL_OUT$("git", "-C", qvWurzel, a, b, c, d)
        RETURN SHELL_OUT$("git", "-C", qvWurzel, a, b, c, d, e)
    CATCH fehler
        RETURN ""
    END TRY
END FUNCTION

SUB qvZeigen()
    DIM ordner AS STRING : ordner = projektOrdner
    IF ordner = "" AND aktiverTab >= 0 AND tabPfade[aktiverTab] <> "" THEN ordner = DIRNAME(tabPfade[aktiverTab])
    IF ordner = "" OR NOT gitRepo(ordner) THEN
        GUI_SET_TEXT(lblStatus, tr$("Quellcodeverwaltung: das Projekt liegt in keinem git-Verzeichnis."))
        protokoll("qv kein repo")
        RETURN
    END IF
    TRY
        qvWurzel = TRIM$(REPLACE$(SHELL_OUT$("git", "-C", ordner, "rev-parse", "--show-toplevel"), CHR$(13), ""))
    CATCH e
        qvWurzel = ""
    END TRY
    IF qvWurzel = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Quellcodeverwaltung: git ist nicht zu starten."))
        protokoll("qv kein git")
        RETURN
    END IF
    qvAuffrischen()
    GUI_WINDOW_VISIBLE(winQv, TRUE)
    GUI_FOCUS(tfQvNachricht)
END SUB

' Den Stand von `git status` einlesen. Das Kaestchen ist die Spalte des
' Index: steht dort etwas (nicht "?"), ist die Datei vorgemerkt.
SUB qvAuffrischen()
    DIM text AS STRING : text = REPLACE$(qvGit$("status", "--porcelain=v1", "-b", "-uall", ""), CHR$(13), "")
    GUI_LISTBOX_CLEAR(lstQv)
    qvPfade = [] : qvArten = [] : qvHaken = []
    qvVorgemerkt = 0
    DIM z AS STRING
    FOR EACH z IN SPLIT$(text, NL)
        IF LEFT$(z, 3) = "## " THEN
            GUI_SET_TEXT(lblQvZweig, tr$("Zweig: ") + LEFT$(MID$(z, 3), 50) + tr$("   in ") + BASENAME(qvWurzel))
            CONTINUE
        END IF
        IF LEN(z) < 4 THEN CONTINUE
        DIM x AS STRING : x = MID$(z, 0, 1)
        DIM y AS STRING : y = MID$(z, 1, 1)
        DIM pfad AS STRING : pfad = MID$(z, 3)
        DIM pf AS INTEGER : pf = INSTR(pfad, " -> ")
        IF pf >= 0 THEN pfad = MID$(pfad, pf + 4)
        IF LEFT$(pfad, 1) = CHR$(34) AND RIGHT$(pfad, 1) = CHR$(34) THEN pfad = MID$(pfad, 1, LEN(pfad) - 2)
        DIM art AS STRING
        IF x = "U" OR y = "U" OR x + y = "AA" OR x + y = "DD" THEN
            art = "Konflikt"
        ELSEIF x = "?" THEN
            art = "neu"
        ELSEIF x = "A" THEN
            art = "hinzugefügt"
        ELSEIF x = "D" OR y = "D" THEN
            art = "gelöscht"
        ELSEIF x = "R" THEN
            art = "umbenannt"
        ELSE
            art = "geändert"
        END IF
        DIM vor AS BOOLEAN : vor = x <> " " AND x <> "?"
        GUI_LISTBOX_ADD(lstQv, pfad)
        DIM k AS INTEGER : k = GUI_LISTBOX_COUNT(lstQv) - 1
        GUI_LISTBOX_DETAIL(lstQv, k, art)
        GUI_LISTBOX_SET_CHECKED(lstQv, k, vor)
        ARRAY_PUSH(qvPfade, pfad) : ARRAY_PUSH(qvArten, x + y) : ARRAY_PUSH(qvHaken, vor)
        IF vor THEN qvVorgemerkt = qvVorgemerkt + 1
    NEXT
    qvZweigeFuellen()
    qvWahl = -2
    GUI_SET_TEXT(taQvDiff, "")
    IF LEN(qvPfade) > 0 THEN GUI_LISTBOX_SET_SELECTED(lstQv, 0)
    GUI_SET_TEXT(lblQvStatus, STR$(LEN(qvPfade)) + tr$(" geänderte Datei(en), ") + STR$(qvVorgemerkt) + tr$(" vorgemerkt."))
    protokoll("qv " + STR$(LEN(qvPfade)) + " " + STR$(qvVorgemerkt))
END SUB

SUB qvDiffZeigen(i AS INTEGER)
    IF i < 0 OR i >= LEN(qvPfade) THEN GUI_SET_TEXT(taQvDiff, "") : RETURN
    DIM text AS STRING
    IF LEFT$(qvArten[i], 1) = "?" THEN
        ' neu, noch nie vorgemerkt: der ganze Inhalt ist der Unterschied
        DIM inhalt AS STRING : inhalt = ""
        TRY
            inhalt = dateiLesen(PATHJOIN(qvWurzel, qvPfade[i]))
        CATCH e
            inhalt = ""
        END TRY
        text = "+++ " + qvPfade[i] + " (neu)" + NL + "+" + REPLACE$(inhalt, NL, NL + "+")
    ELSE
        text = qvGit$("diff", "--no-color", "HEAD", "--", qvPfade[i])
        IF TRIM$(text) = "" THEN text = qvGit$("diff", "--no-color", "--staged", "--", qvPfade[i])
    END IF
    GUI_SET_TEXT(taQvDiff, REPLACE$(text, CHR$(13), ""))
    diffFaerben(taQvDiff)
END SUB

' Uebergeben, was vorgemerkt ist.
SUB qvUebergeben()
    DIM nachricht AS STRING : nachricht = TRIM$(GUI_TEXT(tfQvNachricht))
    IF nachricht = "" THEN
        GUI_SET_TEXT(lblQvStatus, tr$("Erst eine Nachricht schreiben -- sie sagt später, was diese Übergabe wollte."))
        protokoll("qv commit ohne nachricht")
        RETURN
    END IF
    IF qvVorgemerkt = 0 THEN
        GUI_SET_TEXT(lblQvStatus, tr$("Nichts vorgemerkt -- ein Kästchen links setzt eine Datei auf die Liste."))
        protokoll("qv commit leer")
        RETURN
    END IF
    DIM aus AS STRING : aus = qvGit$("commit", "-m", nachricht, "", "")
    GUI_SET_TEXT(tfQvNachricht, "")
    qvAuffrischen()
    DIM erste AS STRING : erste = TRIM$(SPLIT$(REPLACE$(aus, CHR$(13), ""), NL)[0])
    GUI_SET_TEXT(lblQvStatus, IIF(erste = "", tr$("Übergeben."), erste))
    GUI_SET_TEXT(lblStatus, tr$("git: ") + IIF(erste = "", tr$("übergeben"), erste))
    protokoll("qv commit " + nachricht)
END SUB

' Eine Aenderung verwerfen: nach Rueckfrage, und nur, wenn die Datei nicht
' ungesichert in einem Reiter steht (sonst schriebe das naechste Sichern sie
' wieder hin). Neue Dateien loescht die IDE nicht -- das tut man selbst.
SUB qvVerwerfenFragen()
    DIM i AS INTEGER : i = GUI_LISTBOX_SELECTED(lstQv)
    IF i < 0 OR i >= LEN(qvPfade) THEN
        GUI_SET_TEXT(lblQvStatus, tr$("Erst links eine Datei wählen."))
        RETURN
    END IF
    IF LEFT$(qvArten[i], 1) = "?" THEN
        GUI_SET_TEXT(lblQvStatus, qvPfade[i] + tr$(" ist neu -- verwerfen hieße löschen, das tut die IDE nicht."))
        RETURN
    END IF
    qvVerwerfenPfad = qvPfade[i]
    dlgQvVerwerfen = GUI_DIALOG(tr$("Änderung verwerfen"), tr$("Alle Änderungen an ") + qvPfade[i] + _
        " seit der letzten Übergabe verwerfen? Das lässt sich nicht zurücknehmen.", "Verwerfen|Abbrechen")
END SUB

SUB qvVerwerfen(pfad AS STRING)
    DIM voll AS STRING : voll = PATHJOIN(qvWurzel, pfad)
    DIM t AS INTEGER : t = tabMitPfad(voll)
    IF t >= 0 THEN
        IF GUI_TEXT(tabFelder[t]) <> tabGesichert[t] THEN
            GUI_SET_TEXT(lblQvStatus, pfad + tr$(" ist im Reiter ungesichert -- erst sichern oder dort zurücknehmen."))
            protokoll("qv verwerfen ungesichert")
            RETURN
        END IF
    END IF
    DIM aus AS STRING : aus = qvGit$("restore", "--staged", "--worktree", "--", pfad)
    IF t >= 0 THEN
        DIM neu AS STRING : neu = ""
        TRY
            neu = dateiLesen(voll)
        CATCH e
            neu = ""
        END TRY
        feldAustauschen(tabFelder[t], GUI_TEXT(tabFelder[t]), neu)
        tabGesichert[t] = GUI_TEXT(tabFelder[t])
    END IF
    zaehlCache = {}
    qvAuffrischen()
    GUI_SET_TEXT(lblQvStatus, tr$("Verworfen: ") + pfad)
    protokoll("qv verworfen " + pfad)
END SUB

SUB qvNachziehen()
    IF gitProz >= 0 THEN
        DIM a AS STRING : a = PROCESS_READ$(gitProz)
        DIM e AS STRING : e = PROCESS_ERR$(gitProz)
        IF a <> "" THEN ausgabeVerteilen(a)
        IF e <> "" THEN ausgabeVerteilen(e)
        IF NOT PROCESS_RUNNING(gitProz) THEN
            DIM leer AS INTEGER : leer = 0
            WHILE leer < 5
                a = PROCESS_READ$(gitProz) : e = PROCESS_ERR$(gitProz)
                IF a = "" AND e = "" THEN
                    leer = leer + 1 : SLEEP(10)
                ELSE
                    ausgabeVerteilen(a + e) : leer = 0
                END IF
            WEND
            IF ausgabeRest <> "" THEN ausgabe(ausgabeRest) : ausgabeRest = ""
            DIM code AS INTEGER : code = PROCESS_CODE(gitProz)
            PROCESS_CLOSE(gitProz)
            gitProz = -1
            GUI_SET_TEXT(lblQvStatus, tr$("git ") + gitProzArt + IIF(code = 0, tr$(": fertig."), tr$(": fehlgeschlagen (Code ") + STR$(code) + tr$(") -- siehe Ausgabe.")))
            protokoll("qv " + gitProzArt + " " + STR$(code))
            IF GUI_WINDOW_SHOWN(winQv) THEN qvAuffrischen()
        END IF
    END IF
    IF dlgQvVerwerfen <> 0 THEN
        DIM ant AS INTEGER : ant = GUI_ANSWER(dlgQvVerwerfen)
        IF ant = 1 THEN
            dlgQvVerwerfen = 0
            qvVerwerfen(qvVerwerfenPfad)
        ELSEIF ant = 2 THEN
            dlgQvVerwerfen = 0
        END IF
    END IF
    IF NOT GUI_WINDOW_SHOWN(winQv) THEN RETURN
    ' Ein Kaestchen umgelegt: vormerken bzw. zuruecknehmen.
    DIM i AS INTEGER
    FOR i = 0 TO LEN(qvPfade) - 1
        IF i >= GUI_LISTBOX_COUNT(lstQv) THEN EXIT FOR
        DIM an AS BOOLEAN : an = GUI_LISTBOX_CHECKED(lstQv, i)
        IF an <> qvHaken[i] THEN
            DIM p AS STRING : p = qvPfade[i]
            IF an THEN
                qvGit$("add", "--", p, "", "")
            ELSE
                qvGit$("restore", "--staged", "--", p, "")
            END IF
            protokoll("qv " + IIF(an, "vorgemerkt ", "zurueck ") + p)
            qvAuffrischen()
            RETURN
        END IF
    NEXT
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstQv)
    IF sel <> qvWahl THEN
        qvWahl = sel
        qvDiffZeigen(sel)
    END IF
    IF GUI_CLICKED(btnQvCommit) OR GUI_ENTERED(tfQvNachricht) THEN qvUebergeben()
    IF GUI_CLICKED(btnQvAuf) THEN qvAuffrischen()
    IF GUI_CLICKED(btnQvVerwerfen) THEN qvVerwerfenFragen()
    IF GUI_CLICKED(btnQvPull) THEN qvFern("pull")
    IF GUI_CLICKED(btnQvWechseln) THEN qvWechseln(GUI_DROPDOWN_TEXT(ddQvZweig))
    IF GUI_CLICKED(btnQvZweigNeu) AND dlgQvZweig = 0 THEN
        dlgQvZweig = GUI_PROMPT(tr$("Neuer Zweig"), tr$("Name des neuen Zweigs (er beginnt beim jetzigen Stand):"), "thema/")
    END IF
    IF dlgQvZweig <> 0 THEN
        DIM az AS INTEGER : az = GUI_ANSWER(dlgQvZweig)
        IF az = 1 THEN
            DIM zn AS STRING : zn = TRIM$(GUI_DIALOG_TEXT(dlgQvZweig))
            dlgQvZweig = 0
            qvZweigAnlegen(zn)
        ELSEIF az = 2 THEN
            dlgQvZweig = 0
        END IF
    END IF
    IF GUI_CLICKED(btnQvStash) THEN qvBeiseite(TRUE)
    IF GUI_CLICKED(btnQvStashPop) THEN qvBeiseite(FALSE)
    IF GUI_CLICKED(btnQvPush) THEN qvFern("push")
END SUB

' Holen und Senden dauern und koennen nach Zugangsdaten fragen -- ein
' eigener Prozess, die Ausgabe laeuft unten mit.
SUB qvFern(art AS STRING)
    IF gitProz >= 0 THEN
        GUI_SET_TEXT(lblQvStatus, tr$("git ") + gitProzArt + tr$(" läuft noch."))
        RETURN
    END IF
    gitProzArt = art
    GUI_LISTBOX_CLEAR(lstAusgabe)
    ausgabe("git " + art + " in " + qvWurzel)
    gitProz = PROCESS_START("git", "-C", qvWurzel, art)
    PROCESS_CLOSE_INPUT(gitProz)
    GUI_SET_TEXT(lblQvStatus, tr$("git ") + art + tr$(" läuft ..."))
    protokoll("qv " + art + " start")
END SUB

' --- Git: Zweige und Beiseitelegen --------------------------------------
DIM dlgQvZweig AS GUI_WINDOW : dlgQvZweig = 0
DIM qvZweige AS ARRAY OF STRING : qvZweige = []

SUB qvZweigeFuellen()
    DIM aktuell AS STRING : aktuell = TRIM$(REPLACE$(qvGit$("rev-parse", "--abbrev-ref", "HEAD", "", ""), CHR$(13), ""))
    DIM liste AS ARRAY OF STRING : liste = []
    DIM z AS STRING
    FOR EACH z IN SPLIT$(REPLACE$(qvGit$("branch", "--format=%(refname:short)", "", "", ""), CHR$(13), ""), NL)
        IF TRIM$(z) <> "" THEN ARRAY_PUSH(liste, TRIM$(z))
    NEXT
    IF LEN(liste) = 0 THEN ARRAY_PUSH(liste, IIF(aktuell = "", "-", aktuell))
    qvZweige = liste
    GUI_SET_DROPDOWN(ddQvZweig, liste)
    DIM k AS INTEGER : k = ARRAY_INDEXOF(liste, aktuell)
    GUI_DROPDOWN_SET_SELECTED(ddQvZweig, MAX(k, 0))
END SUB

' Ein Zweigwechsel oder Beiseitelegen schreibt die Dateien auf der Platte
' um. Ungesicherte Reiter wuerden dabei stehen bleiben (und beim naechsten
' Sichern den alten Stand zurueckschreiben) -- darum vorher Nein.
FUNCTION qvReiterSauber() AS BOOLEAN
    DIM t AS INTEGER
    FOR t = 0 TO tabAnzahl - 1
        IF tabPfade[t] <> "" AND GUI_TEXT(tabFelder[t]) <> tabGesichert[t] THEN
            GUI_SET_TEXT(lblQvStatus, BASENAME(tabPfade[t]) + tr$(" ist ungesichert -- erst sichern."))
            protokoll("qv reiter ungesichert")
            RETURN FALSE
        END IF
    NEXT
    RETURN TRUE
END FUNCTION

' Offene Reiter von der Platte nachziehen (nach Wechsel/Beiseitelegen).
SUB qvReiterNachziehen()
    DIM t AS INTEGER
    FOR t = 0 TO tabAnzahl - 1
        IF tabPfade[t] = "" OR NOT FILEEXISTS(tabPfade[t]) THEN CONTINUE
        DIM neu AS STRING : neu = ""
        TRY
            neu = dateiLesen(tabPfade[t])
        CATCH e
            CONTINUE
        END TRY
        IF neu <> GUI_TEXT(tabFelder[t]) THEN
            feldAustauschen(tabFelder[t], GUI_TEXT(tabFelder[t]), neu)
            tabGesichert[t] = GUI_TEXT(tabFelder[t])
        END IF
    NEXT
    zaehlCache = {}
    blameCache = {}
    baumFuellen()
END SUB

SUB qvWechseln(zweig AS STRING)
    IF zweig = "" OR zweig = "-" THEN RETURN
    IF NOT qvReiterSauber() THEN RETURN
    DIM aus AS STRING : aus = qvGit$("switch", zweig, "", "", "")
    qvReiterNachziehen()
    qvAuffrischen()
    DIM jetzt AS STRING : jetzt = TRIM$(REPLACE$(qvGit$("rev-parse", "--abbrev-ref", "HEAD", "", ""), CHR$(13), ""))
    IF jetzt = zweig THEN
        GUI_SET_TEXT(lblQvStatus, tr$("Auf Zweig ") + zweig + ".")
    ELSE
        GUI_SET_TEXT(lblQvStatus, tr$("Wechsel auf ") + zweig + tr$(" ging nicht -- geänderte Dateien, die der Zweig anders hat? Erst übergeben oder beiseitelegen."))
    END IF
    protokoll("qv zweig " + jetzt)
END SUB

SUB qvZweigAnlegen(name AS STRING)
    IF name = "" OR NOT REGEX_TEST(name, "^[A-Za-z0-9._/-]+$") THEN
        GUI_SET_TEXT(lblQvStatus, tr$("Ein Zweigname braucht Buchstaben, Ziffern, . _ / oder -."))
        RETURN
    END IF
    DIM aus AS STRING : aus = qvGit$("switch", "-c", name, "", "")
    qvAuffrischen()
    DIM jetzt AS STRING : jetzt = TRIM$(REPLACE$(qvGit$("rev-parse", "--abbrev-ref", "HEAD", "", ""), CHR$(13), ""))
    GUI_SET_TEXT(lblQvStatus, IIF(jetzt = name, tr$("Neuer Zweig ") + name + tr$(", die Änderungen sind mitgekommen."), tr$("Zweig ") + name + tr$(" ließ sich nicht anlegen (gibt es ihn schon?).")))
    protokoll("qv zweig neu " + jetzt)
END SUB

' Alle Aenderungen beiseitelegen (auch neue Dateien) bzw. zurueckholen.
SUB qvBeiseite(weg AS BOOLEAN)
    IF NOT qvReiterSauber() THEN RETURN
    DIM aus AS STRING
    IF weg THEN
        aus = qvGit$("stash", "push", "-u", "-m", "Drachenhauch-IDE")
    ELSE
        aus = qvGit$("stash", "pop", "", "", "")
    END IF
    qvReiterNachziehen()
    qvAuffrischen()
    DIM stapel AS INTEGER : stapel = 0
    DIM z AS STRING
    FOR EACH z IN SPLIT$(REPLACE$(qvGit$("stash", "list", "", "", ""), CHR$(13), ""), NL)
        IF TRIM$(z) <> "" THEN stapel = stapel + 1
    NEXT
    GUI_SET_TEXT(lblQvStatus, IIF(weg, tr$("Beiseitegelegt"), tr$("Zurückgeholt")) + " -- " + STR$(stapel) + tr$(" Stand/Stände beiseite."))
    protokoll("qv " + IIF(weg, "beiseite ", "zurueck ") + STR$(stapel))
END SUB

' --- Wer hat diese Zeile geschrieben (am Zeilenende) -------------------
' An der Zeile der Marke steht gedaempft, wer sie zuletzt geaendert hat
' und wann, mit der Nachricht der Uebergabe. `git blame --porcelain` einmal
' je Datei, gemerkt bis zum naechsten Sichern; nur fuer gesicherte Reiter
' (sonst stimmten die Zeilen nicht mehr). Teilt sich die Hinweise mit den
' Aufrufzaehlern.
DIM blameZeileAn AS BOOLEAN : blameZeileAn = FALSE
DIM blameCache AS MAP OF STRING
DIM blameMarkeZeile AS INTEGER : blameMarkeZeile = -1
DIM blameFeld AS GUI_WIDGET : blameFeld = -1
DIM blameText AS STRING : blameText = ""

SUB blameZeileSetzen(an AS BOOLEAN)
    blameZeileAn = an
    GUI_MENU_CHECK(miBlameZeile, an)
    blameMarkeZeile = -1
    IF NOT an AND blameFeld >= 0 THEN
        DIM f AS GUI_WIDGET : f = blameFeld
        blameFeld = -1 : blameText = ""
        hinweiseZeigen(f)
    END IF
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Blame an der Zeile der Marke an."), tr$("Blame an der Zeile der Marke aus.")))
    protokoll("blame zeile " + IIF(an, "an", "aus"))
END SUB

' Die Zeile (ab 1) einer Datei als "Autor, vor N Tagen: Nachricht"; "" wenn
' es nichts gibt. Die ganze Datei wird einmal zerlegt und je Zeile gemerkt.
FUNCTION blameFuer$(pfad AS STRING, zeile AS INTEGER) AS STRING
    DIM schl AS STRING : schl = LOWER$(wegGleich$(pfad)) + "|" + STR$(zeile)
    IF MAPHAS(blameCache, LOWER$(wegGleich$(pfad)) + "|0") THEN RETURN MAPGETOR(blameCache, schl, "")
    MAPPUT(blameCache, LOWER$(wegGleich$(pfad)) + "|0", "gelesen")
    IF NOT gitRepo(DIRNAME(pfad)) THEN RETURN ""
    DIM roh AS STRING : roh = ""
    TRY
        roh = SHELL_OUT$("git", "-C", DIRNAME(pfad), "blame", "--porcelain", "--", BASENAME(pfad))
    CATCH e
        roh = ""
    END TRY
    DIM autoren AS MAP OF STRING
    DIM zeiten AS MAP OF STRING
    DIM texte AS MAP OF STRING
    DIM jetzt AS INTEGER : jetzt = ZEIT_JETZT()
    DIM sha AS STRING : sha = ""
    DIM ziel AS INTEGER : ziel = 0
    DIM z AS STRING
    FOR EACH z IN SPLIT$(REPLACE$(roh, CHR$(13), ""), NL)
        IF LEFT$(z, 1) = CHR$(9) THEN
            ' die Zeile selbst: jetzt steht fest, wer sie hat
            DIM wer AS STRING : wer = MAPGETOR(autoren, sha, "?")
            DIM was AS STRING : was = MAPGETOR(texte, sha, "")
            DIM wann AS STRING : wann = ""
            IF MAPHAS(zeiten, sha) THEN
                DIM tage AS INTEGER : tage = INT((jetzt - VAL(MAPGET(zeiten, sha))) / 86400)
                wann = IIF(tage <= 0, "heute", IIF(tage = 1, "gestern", "vor " + STR$(tage) + " Tagen"))
            END IF
            IF LEFT$(sha, 8) = "00000000" THEN
                MAPPUT(blameCache, LOWER$(wegGleich$(pfad)) + "|" + STR$(ziel), "noch nicht übergeben")
            ELSE
                MAPPUT(blameCache, LOWER$(wegGleich$(pfad)) + "|" + STR$(ziel), wer + ", " + wann + ": " + was)
            END IF
            CONTINUE
        END IF
        DIM teile AS ARRAY OF STRING : teile = SPLIT$(z, " ")
        IF LEN(teile) >= 3 AND LEN(teile[0]) = 40 THEN
            sha = teile[0] : ziel = INT(VAL(teile[2]))
        ELSEIF LEFT$(z, 7) = "author " THEN
            MAPPUT(autoren, sha, MID$(z, 7))
        ELSEIF LEFT$(z, 12) = "author-time " THEN
            MAPPUT(zeiten, sha, MID$(z, 12))
        ELSEIF LEFT$(z, 8) = "summary " THEN
            MAPPUT(texte, sha, MID$(z, 8))
        END IF
    NEXT
    RETURN MAPGETOR(blameCache, schl, "")
END FUNCTION

' Aufrufzaehler und Blame-Zeile zusammen an das Feld geben (eine Zeile mit
' beidem bekommt beides, durch einen Punkt getrennt).
SUB hinweiseZeigen(ta AS GUI_WIDGET)
    IF ta < 0 OR ta = werteFeld THEN RETURN
    DIM zl AS ARRAY OF INTEGER : zl = []
    DIM tx AS ARRAY OF STRING : tx = []
    DIM i AS INTEGER
    IF ta = zaehlFeld THEN
        FOR i = 0 TO LEN(zaehlZeilen) - 1
            ARRAY_PUSH(zl, zaehlZeilen[i]) : ARRAY_PUSH(tx, zaehlTexte[i])
        NEXT
    END IF
    ' Die Profilzahlen: an den Zeilen, an denen ihre Farben JETZT stehen
    ' (sie wandern beim Tippen mit, die gemerkten Nummern nicht).
    DIM wz AS ARRAY OF INTEGER : wz = []
    FOR i = 0 TO LEN(waermeFelder) - 1
        IF waermeFelder[i] = ta THEN
            IF LEN(wz) = 0 THEN wz = GUI_TEXTAREA_LINE_COLORS_GET(ta)
            DIM wk AS INTEGER : wk = waermeNr[i]
            IF waermeTexte[i] <> "" AND wk < LEN(wz) THEN
                DIM wi AS INTEGER : wi = ARRAY_INDEXOF(zl, wz[wk])
                IF wi >= 0 THEN
                    tx[wi] = tx[wi] + "   ·   " + waermeTexte[i]
                ELSE
                    ARRAY_PUSH(zl, wz[wk]) : ARRAY_PUSH(tx, waermeTexte[i])
                END IF
            END IF
        END IF
    NEXT
    IF ta = blameFeld AND blameText <> "" AND blameMarkeZeile > 0 THEN
        DIM k AS INTEGER : k = ARRAY_INDEXOF(zl, blameMarkeZeile)
        IF k >= 0 THEN
            tx[k] = tx[k] + "   ·   " + blameText
        ELSE
            ARRAY_PUSH(zl, blameMarkeZeile) : ARRAY_PUSH(tx, blameText)
        END IF
    END IF
    ' Die Meldungen von Pruefen stehen VORN und faerben den ganzen Hinweis
    ' ihrer Zeile -- ein roter Satz hinter einer Zeile mit Aufrufzaehler soll
    ' nicht im Grau untergehen.
    DIM farben AS ARRAY OF INTEGER : farben = []
    FOR i = 0 TO LEN(zl) - 1
        ARRAY_PUSH(farben, -1)
    NEXT
    IF typHinweiseAn AND ta = typFeld THEN
        FOR i = 0 TO LEN(typZeilen) - 1
            DIM tk AS INTEGER : tk = ARRAY_INDEXOF(zl, typZeilen[i])
            IF tk >= 0 THEN
                tx[tk] = tx[tk] + "   ·   " + typTexte[i]
            ELSE
                ARRAY_PUSH(zl, typZeilen[i]) : ARRAY_PUSH(tx, typTexte[i])
                ARRAY_PUSH(farben, F_TYP)
            END IF
        NEXT
    END IF
    IF fehlerEndeAn AND ta = fehlerFeld THEN
        FOR i = 0 TO LEN(fehlerZeilen) - 1
            DIM fk AS INTEGER : fk = ARRAY_INDEXOF(zl, fehlerZeilen[i])
            IF fk >= 0 THEN
                tx[fk] = fehlerTexte[i] + "   ·   " + tx[fk]
                farben[fk] = fehlerFarben[i]
            ELSE
                ARRAY_PUSH(zl, fehlerZeilen[i]) : ARRAY_PUSH(tx, fehlerTexte[i])
                ARRAY_PUSH(farben, fehlerFarben[i])
            END IF
        NEXT
    END IF
    GUI_TEXTAREA_HINTS(ta, zl, tx, farben)
END SUB

' Eine Meldung von Pruefen fuer ihre Zeile vormerken. Mehrere in derselben
' Zeile kommen in EINEN Hinweis; ein Fehler faerbt ihn rot, auch wenn eine
' Warnung zuerst kam. Lange Meldungen werden gekuerzt -- der ganze Satz
' steht in der Liste und im Tooltip.
SUB fehlerSammeln(fz AS ARRAY OF INTEGER, ftx AS ARRAY OF STRING, ffa AS ARRAY OF INTEGER, _
                  zeile AS INTEGER, meldung AS STRING, istFehler AS BOOLEAN)
    DIM m AS STRING : m = TRIM$(REPLACE$(meldung, NL, " "))
    IF LEN(m) > 90 THEN m = LEFT$(m, 87) + "..."
    DIM farbe AS INTEGER : farbe = IIF(istFehler, &HE06060, &HD8B048)
    DIM k AS INTEGER : k = ARRAY_INDEXOF(fz, zeile)
    IF k >= 0 THEN
        ftx[k] = ftx[k] + "  ·  " + m
        IF istFehler THEN ffa[k] = farbe
    ELSE
        ARRAY_PUSH(fz, zeile) : ARRAY_PUSH(ftx, m) : ARRAY_PUSH(ffa, farbe)
    END IF
END SUB

' Die Typen, die der Uebersetzer fuer Stellen ohne geschriebenen Typ kennt
' (FOR EACH), als Hinweise je Zeile: "x: INTEGER", mehrere mit Komma.
SUB typenSammeln(ta AS GUI_WIDGET, basis AS STRING)
    typFeld = ta : typZeilen = [] : typTexte = []
    IF NOT typHinweiseAn THEN RETURN
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_TYPES$(GUI_TEXT(ta), basis))
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "") - 1
        DIM z AS INTEGER : z = JSON_GET_INT(j, STR$(i) + ".zeile")
        DIM t AS STRING : t = JSON_GET_STRING(j, STR$(i) + ".name") + ": " + JSON_GET_STRING(j, STR$(i) + ".typ")
        DIM k AS INTEGER : k = ARRAY_INDEXOF(typZeilen, z)
        IF k >= 0 THEN
            typTexte[k] = typTexte[k] + ", " + t
        ELSE
            ARRAY_PUSH(typZeilen, z) : ARRAY_PUSH(typTexte, t)
        END IF
    NEXT
    IF LEN(typZeilen) > 0 THEN protokoll("typen " + STR$(LEN(typZeilen)))
END SUB

SUB typHinweiseSetzen(an AS BOOLEAN)
    typHinweiseAn = an
    GUI_MENU_CHECK(miTypen, an)
    IF an THEN
        pruefen()
    ELSEIF typFeld >= 0 THEN
        hinweiseZeigen(typFeld)
    END IF
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Typ-Hinweise an."), tr$("Typ-Hinweise aus.")))
    protokoll("typ hinweise " + IIF(an, "an", "aus"))
    konfigSichern()
END SUB

' --- Eigene Farben (farben.json neben der ide.json) -----------------------
' {"dunkel": {"schluessel": "#2BC4E8", ..., "oberflaeche": {"accent": ...}},
'  "hell": {...}} -- nur, was ANDERS sein soll. Code-Farben und die Toene der
' Bereiche haben feste Namen, unter "oberflaeche" steht jeder Schluessel von
' GUI_THEME_SET. Gilt nach dem Sichern der Datei sofort.
DIM farbMeldungen AS ARRAY OF STRING : farbMeldungen = []
FUNCTION farbenPfad$() AS STRING
    RETURN PATHJOIN(konfigOrdner$(), "farben.json")
END FUNCTION

SUB farbMelden(m AS STRING)
    ARRAY_PUSH(farbMeldungen, m)
    ausgabe("Farben: " + m)
    protokoll("farben meldung " + m)
END SUB

' Eine Farbe aus der Datei, -1 = keine (dann gemeldet).
FUNCTION farbWert(j AS JSON_HANDLE, pfad AS STRING) AS INTEGER
    IF JSON_TYPE(j, pfad) <> "string" THEN
        farbMelden(pfad + ": keine Farbe (#RRGGBB)")
        RETURN -1
    END IF
    DIM f AS INTEGER : f = -1
    TRY
        f = COLOR_FROM_HEX(JSON_GET_STRING(j, pfad))
    CATCH e
        farbMelden(pfad + ": " + JSON_GET_STRING(j, pfad) + " ist keine Farbe")
    END TRY
    RETURN f
END FUNCTION

SUB eigeneFarben(licht AS BOOLEAN)
    farbMeldungen = []
    DIM p AS STRING : p = farbenPfad$()
    IF NOT FILEEXISTS(p) THEN RETURN
    DIM j AS JSON_HANDLE
    TRY
        j = JSON_LOAD(p)
    CATCH e
        farbMelden("farben.json lässt sich nicht lesen: " + e)
        RETURN
    END TRY
    DIM teil AS STRING : teil = IIF(licht, "hell", "dunkel")
    IF NOT JSON_HAS(j, teil) THEN RETURN
    DIM n AS INTEGER : n = 0
    DIM k AS STRING
    FOR EACH k IN JSON_KEYS(j, teil)
        IF LOWER$(k) = "oberflaeche" THEN
            DIM ok AS STRING
            FOR EACH ok IN JSON_KEYS(j, teil + ".oberflaeche")
                DIM fo AS INTEGER : fo = farbWert(j, teil + ".oberflaeche." + ok)
                IF fo < 0 THEN CONTINUE
                TRY
                    GUI_THEME_SET(ok, fo)
                    n = n + 1
                CATCH e2
                    farbMelden(teil + ".oberflaeche: unbekannter Name " + ok)
                END TRY
            NEXT
            CONTINUE
        END IF
        DIM f AS INTEGER : f = farbWert(j, teil + "." + k)
        IF f < 0 THEN CONTINUE
        DIM bekannt AS BOOLEAN : bekannt = TRUE
        SELECT CASE LOWER$(k)
            CASE "grund" : F_GRUND = f
            CASE "kommentar" : F_KOMMENTAR = f
            CASE "text" : F_TEXT = f
            CASE "zahl" : F_ZAHL = f
            CASE "schluessel" : F_SCHLUESSEL = f
            CASE "operator" : F_OPERATOR = f
            CASE "fundstelle" : F_FUNDSTELLE = f
            CASE "klammer" : F_KLAMMER = f
            CASE "suchtreffer" : F_SUCHTREFFER = f
            CASE "typ" : F_TYP = f
            CASE "projekt" : TON_PROJEKT = f
            CASE "ausgabe" : TON_AUSGABE = f
            CASE "probleme" : TON_PROBLEME = f
            CASE "debugger" : TON_DEBUG = f
            CASE ELSE : bekannt = FALSE
        END SELECT
        IF bekannt THEN
            n = n + 1
        ELSE
            farbMelden(teil + ": unbekannter Name " + k)
        END IF
    NEXT
    protokoll("eigene farben " + teil + " " + STR$(n))
END SUB

' Thema an EINER Stelle: Vorlage, Feinschliff, Code-Farben, eigene Farben,
' dann alles, was aus ihnen gerechnet ist.
SUB themaAnwenden()
    IF hell THEN GUI_THEME_PRESET("glas_hell") ELSE GUI_THEME_PRESET("glas_dunkel")
    themaFeinschliff()
    codeFarben(hell)
    eigeneFarben(hell)
    bereichsFarben()
    hbFarben()
    hbQuelleFaerben()
    wasserzeichenAlle()
    faerbSchluessel = "" : gliederungSchluessel = ""
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        hinweiseZeigen(tabFelder[i])
    NEXT
END SUB

' Eine Zeile der Vorlage: die Werte des Themas, wie sie ohne eigene Farben sind.
FUNCTION farbVorlageTeil$(licht AS BOOLEAN) AS STRING
    codeFarben(licht)
    DIM q AS STRING : q = CHR$(34)
    DIM namen AS ARRAY OF STRING : namen = ["grund", "kommentar", "text", "zahl", "schluessel", "operator", "fundstelle", "klammer", "suchtreffer", "typ", "projekt", "ausgabe", "probleme", "debugger"]
    DIM werte AS ARRAY OF INTEGER : werte = [F_GRUND, F_KOMMENTAR, F_TEXT, F_ZAHL, F_SCHLUESSEL, F_OPERATOR, F_FUNDSTELLE, F_KLAMMER, F_SUCHTREFFER, F_TYP, TON_PROJEKT, TON_AUSGABE, TON_PROBLEME, TON_DEBUG]
    DIM t AS STRING : t = "  " + q + IIF(licht, "hell", "dunkel") + q + ": {" + NL
    DIM i AS INTEGER
    FOR i = 0 TO LEN(namen) - 1
        t = t + "    " + q + namen[i] + q + ": " + q + COLOR_HEX$(werte[i]) + q + "," + NL
    NEXT
    t = t + "    " + q + "oberflaeche" + q + ": {}" + NL + "  }"
    RETURN t
END FUNCTION

SUB farbenEigenOeffnen()
    DIM p AS STRING : p = farbenPfad$()
    IF NOT FILEEXISTS(p) THEN
        DIM t AS STRING : t = "{" + NL + farbVorlageTeil$(FALSE) + "," + NL + farbVorlageTeil$(TRUE) + NL + "}" + NL
        codeFarben(hell)
        eigeneFarben(hell)
        IF NOT DIREXISTS(DIRNAME(p)) THEN MKDIR(DIRNAME(p))
        WRITEALL(p, t)
    END IF
    tabOeffnen(p, dateiLesen(p))
    GUI_SET_TEXT(lblStatus, tr$("Eigene Farben -- nach dem Sichern (Strg+S) gelten sie."))
    protokoll("eigene farben datei")
END SUB

SUB fehlerEndeSetzen(an AS BOOLEAN)
    fehlerEndeAn = an
    GUI_MENU_CHECK(miFehlerEnde, an)
    IF fehlerFeld >= 0 THEN hinweiseZeigen(fehlerFeld)
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Fehlertext am Zeilenende an."), tr$("Fehlertext am Zeilenende aus.")))
    protokoll("fehler am ende " + IIF(an, "an", "aus"))
    konfigSichern()
END SUB

SUB blameZeileNachziehen()
    IF NOT blameZeileAn OR aktiverTab < 0 THEN RETURN
    DIM ta AS GUI_WIDGET : ta = tabFelder[aktiverTab]
    DIM z AS INTEGER
    DIM sp AS INTEGER
    (z, sp) = GUI_TEXTAREA_CURSOR(ta)
    IF z = blameMarkeZeile AND ta = blameFeld THEN RETURN
    DIM altFeld AS GUI_WIDGET : altFeld = blameFeld
    blameMarkeZeile = z
    blameFeld = ta
    blameText = ""
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad <> "" AND GUI_TEXT(ta) = tabGesichert[aktiverTab] THEN blameText = blameFuer$(pfad, z)
    IF altFeld >= 0 AND altFeld <> ta THEN hinweiseZeigen(altFeld)
    hinweiseZeigen(ta)
    IF blameText <> "" THEN protokoll("blame zeile " + STR$(z) + " " + blameText)
END SUB

' --- Konflikt unter der Marke -------------------------------------------
' Ein Merge laesst Markierungen im Text: <<<<<<< meine ======= ihre >>>>>>>
' (dazwischen vielleicht ||||||| mit dem gemeinsamen Stand). Der Block um
' die Marke wird durch meine, ihre oder beide Fassungen ersetzt -- in EINEM
' Schritt, Strg+Z nimmt ihn zurueck.
SUB konfliktLoesen(art AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM sp AS INTEGER
    (z, sp) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM a AS INTEGER : a = -1
    DIM i AS INTEGER
    FOR i = MIN(z, LEN(zeilen)) - 1 TO 0 STEP -1
        IF LEFT$(zeilen[i], 7) = ">>>>>>>" AND i < z - 1 THEN EXIT FOR
        IF LEFT$(zeilen[i], 7) = "<<<<<<<" THEN a = i : EXIT FOR
    NEXT
    IF a < 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Die Marke steht in keinem Konflikt (<<<<<<< ... >>>>>>>)."))
        protokoll("konflikt keiner")
        RETURN
    END IF
    DIM basis AS INTEGER : basis = -1
    DIM mitte AS INTEGER : mitte = -1
    DIM e AS INTEGER : e = -1
    FOR i = a + 1 TO LEN(zeilen) - 1
        IF LEFT$(zeilen[i], 7) = "|||||||" AND mitte < 0 THEN basis = i
        IF LEFT$(zeilen[i], 7) = "=======" AND mitte < 0 THEN mitte = i
        IF LEFT$(zeilen[i], 7) = ">>>>>>>" THEN e = i : EXIT FOR
    NEXT
    IF mitte < 0 OR e < 0 OR e < z - 1 THEN
        GUI_SET_TEXT(lblStatus, tr$("Die Marke steht in keinem vollständigen Konflikt."))
        protokoll("konflikt keiner")
        RETURN
    END IF
    DIM neu AS ARRAY OF STRING : neu = []
    DIM meineBis AS INTEGER : meineBis = IIF(basis > 0, basis, mitte)
    IF art = 1 OR art = 3 THEN
        FOR i = a + 1 TO meineBis - 1
            ARRAY_PUSH(neu, zeilen[i])
        NEXT
    END IF
    IF art = 2 OR art = 3 THEN
        FOR i = mitte + 1 TO e - 1
            ARRAY_PUSH(neu, zeilen[i])
        NEXT
    END IF
    ' Ganze Zeilen a+1 .. e+1 ersetzen (samt Umbruch der letzten, wenn es
    ' eine naechste Zeile gibt).
    IF e + 1 < LEN(zeilen) THEN
        GUI_TEXTAREA_SELECT(ta, a + 1, 1, e + 2, 1)
        GUI_TEXTAREA_INSERT(ta, IIF(LEN(neu) > 0, JOIN$(neu, NL) + NL, ""))
    ELSE
        GUI_TEXTAREA_SELECT(ta, a + 1, 1, e + 1, 1000000)
        GUI_TEXTAREA_INSERT(ta, JOIN$(neu, NL))
    END IF
    DIM wie AS STRING : wie = IIF(art = 1, "meine", IIF(art = 2, "ihre", "beide"))
    GUI_SET_TEXT(lblStatus, tr$("Konflikt gelöst (") + wie + ", " + STR$(LEN(neu)) + tr$(" Zeilen). Strg+Z nimmt es zurück."))
    protokoll("konflikt " + wie + " " + STR$(LEN(neu)))
END SUB

' --- Auswahl als Variable einfuehren ------------------------------------
' Der markierte Ausdruck (in einer Zeile) wird eine Variable: vor der
' Anweisung `DIM name AS TYP : name = ausdruck`, an seiner Stelle der Name.
' Der Typ ist geraten und steht im Kasten zum Aendern.
DIM dlgEinfuehren AS GUI_WINDOW : dlgEinfuehren = 0
DIM einfZeile AS INTEGER : einfZeile = 0
DIM einfVon AS INTEGER : einfVon = 0
DIM einfBis AS INTEGER : einfBis = 0
DIM einfAusdruck AS STRING : einfAusdruck = ""

FUNCTION typRaten$(a AS STRING) AS STRING
    DIM g AS STRING : g = UPPER$(a)
    IF INSTR(a, CHR$(34)) >= 0 OR INSTR(g, "$(") >= 0 OR RIGHT$(TRIM$(g), 1) = "$" THEN RETURN "STRING"
    IF INSTR(g, " AND ") >= 0 OR INSTR(g, " OR ") >= 0 OR INSTR(g, "NOT ") = 0 THEN RETURN "BOOLEAN"
    IF INSTR(a, "<") >= 0 OR INSTR(a, ">") >= 0 OR INSTR(a, "=") >= 0 THEN RETURN "BOOLEAN"
    IF INSTR(a, "/") >= 0 OR REGEX_TEST(a, "[0-9]\.[0-9]") OR REGEX_TEST(g, "\b(SQR|SIN|COS|TAN|FLT|DELTA|RND|ATAN2|EXP|LOG)\(") THEN RETURN "FLOAT"
    RETURN "INTEGER"
END FUNCTION

SUB einfuehrenFragen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR dlgEinfuehren <> 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM s1 AS INTEGER
    DIM z2 AS INTEGER
    DIM s2 AS INTEGER
    (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    DIM a AS STRING : a = TRIM$(GUI_TEXTAREA_SELECTION$(ta))
    IF z1 <> z2 OR a = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Variable einführen: erst einen Ausdruck in einer Zeile markieren."))
        protokoll("einfuehren keine auswahl")
        RETURN
    END IF
    DIM zeile AS STRING : zeile = SPLIT$(GUI_TEXT(ta), NL)[z1 - 1]
    DIM kopf AS STRING : kopf = UPPER$(TRIM$(zeile))
    DIM w AS STRING
    FOR EACH w IN ("ELSEIF", "ELSE", "CASE", "LOOP", "WEND", "NEXT", "END ", "SUB ", "FUNCTION ", "UNTIL")
        IF LEFT$(kopf, LEN(w)) = w THEN
            GUI_SET_TEXT(lblStatus, tr$("Variable einführen: in einer ") + TRIM$(w) + tr$("-Zeile geht das nicht -- davor wäre ein anderer Zweig."))
            protokoll("einfuehren zeile ungeeignet")
            RETURN
        END IF
    NEXT
    einfZeile = z1 : einfVon = s1 : einfBis = s2
    einfAusdruck = MID$(zeile, s1 - 1, s2 - s1)
    dlgEinfuehren = GUI_PROMPT(tr$("Variable einführen"), tr$("Name und Typ für ") + TRIM$(einfAusdruck) + ":", "wert AS " + typRaten$(einfAusdruck))
END SUB

SUB einfuehrenNachziehen()
    IF dlgEinfuehren = 0 THEN RETURN
    DIM a AS INTEGER : a = GUI_ANSWER(dlgEinfuehren)
    IF a = 0 THEN RETURN
    DIM t AS STRING : t = TRIM$(GUI_DIALOG_TEXT(dlgEinfuehren))
    dlgEinfuehren = 0
    IF a = 1 THEN variableEinfuehren(t)
END SUB

SUB variableEinfuehren(angabe AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM name AS STRING : name = angabe
    DIM typ AS STRING : typ = typRaten$(einfAusdruck)
    DIM ap AS INTEGER : ap = INSTR(UPPER$(angabe), " AS ")
    IF ap > 0 THEN name = TRIM$(LEFT$(angabe, ap)) : typ = TRIM$(MID$(angabe, ap + 4))
    IF NOT REGEX_TEST(name, "^[A-Za-z_][A-Za-z0-9_]*\$?$") THEN
        GUI_SET_TEXT(lblStatus, tr$("Variable einführen: '") + name + tr$("' ist kein Name."))
        protokoll("einfuehren name ungueltig")
        RETURN
    END IF
    DIM quelle AS STRING : quelle = GUI_TEXT(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM zeile AS STRING : zeile = zeilen[einfZeile - 1]
    DIM ein AS STRING : ein = LEFT$(zeile, LEN(zeile) - LEN(LTRIM$(zeile)))
    DIM ausdruck AS STRING : ausdruck = TRIM$(einfAusdruck)
    DIM neuZeile AS STRING : neuZeile = LEFT$(zeile, einfVon - 1) + name + MID$(zeile, einfBis - 1)
    DIM neu AS ARRAY OF STRING : neu = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        IF i = einfZeile - 1 THEN
            ARRAY_PUSH(neu, ein + "DIM " + name + " AS " + typ + " : " + name + " = " + ausdruck)
            ARRAY_PUSH(neu, neuZeile)
        ELSE
            ARRAY_PUSH(neu, zeilen[i])
        END IF
    NEXT
    DIM neuText AS STRING : neuText = JOIN$(neu, NL)
    DIM mehr AS INTEGER : mehr = fehlerZahl(neuText) - fehlerZahl(quelle)
    umbauLeeren()
    umbauVormerken(aktiverTab, tabPfade[aktiverTab], neuText)
    umbauZeile = einfZeile + 1 : umbauSpalte = einfVon
    umbauStarten("Variable " + name + " einführen", _
                 IIF(mehr > 0, "Achtung: " + STR$(mehr) + " Fehler mehr -- passt der Typ " + typ + "?", _
                     "DIM " + name + " AS " + typ + " vor der Zeile, der Ausdruck durch den Namen ersetzt."), _
                 "eingefuehrt " + name + " " + typ + " " + STR$(mehr))
END SUB

' --- Variable einsetzen --------------------------------------------------
' Die Gegenrichtung: eine Variable, die genau einmal belegt wird
' (`DIM x AS T : x = ausdruck` oder DIM und eine Zuweisung), verschwindet,
' und an jeder Stelle, an der sie gelesen wird, steht der Ausdruck.
' Verweigert, wenn das die Bedeutung aendern koennte: eine zweite
' Zuweisung, eine Uebergabe als Argument (vielleicht BYREF), ein Aufruf im
' Ausdruck bei mehr als einer Stelle (er liefe dann mehrfach), oder eine
' Variable des Ausdrucks, die sich zwischen Belegung und Benutzung aendert.
SUB variableEinsetzen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM name AS STRING : name = wortUnterMarke$()
    IF name = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Variable einsetzen: die Marke steht auf keinem Namen."))
        protokoll("einsetzen kein name")
        RETURN
    END IF
    DIM quelle AS STRING : quelle = GUI_TEXT(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM mz AS INTEGER
    DIM ms AS INTEGER
    (mz, ms) = GUI_TEXTAREA_CURSOR(ta)
    DIM uv AS INTEGER
    DIM ub AS INTEGER
    (uv, ub) = umgebendesUnterprogramm(quelle, mz)
    IF uv < 1 THEN uv = 1 : ub = LEN(zeilen)
    DIM klein AS STRING : klein = LOWER$(name)
    DIM dimZeile AS INTEGER : dimZeile = -1
    DIM zuwZeile AS INTEGER : zuwZeile = -1
    DIM ausdruck AS STRING : ausdruck = ""
    DIM zuweisungen AS INTEGER : zuweisungen = 0
    DIM i AS INTEGER
    FOR i = uv TO MIN(ub, LEN(zeilen))
        DIM t AS STRING : t = TRIM$(zeilen[i - 1])
        DIM g AS STRING : g = LOWER$(t)
        IF LEFT$(g, 4 + LEN(klein)) = "dim " + klein AND NOT istWortzeichen(MID$(g, 4 + LEN(klein), 1)) THEN
            dimZeile = i
            DIM dp AS INTEGER : dp = INSTR(t, ":")
            IF dp > 0 THEN
                DIM rest AS STRING : rest = TRIM$(MID$(t, dp + 1))
                IF wirdZugewiesen(LOWER$(rest), klein) THEN
                    ausdruck = TRIM$(MID$(rest, INSTR(rest, "=") + 1))
                    zuwZeile = i
                    zuweisungen = zuweisungen + 1
                END IF
            END IF
            CONTINUE
        END IF
        IF wirdZugewiesen(g, klein) THEN
            zuweisungen = zuweisungen + 1
            IF zuwZeile < 0 THEN zuwZeile = i : ausdruck = TRIM$(MID$(t, INSTR(t, "=") + 1))
        ELSEIF REGEX_TEST(g, "^(for|input)\s+" + klein + "\b") OR REGEX_TEST(g, "[(,]\s*" + klein + "\s*[,)]\s*=") THEN
            zuweisungen = zuweisungen + 2
        END IF
    NEXT
    DIM grund AS STRING : grund = ""
    IF dimZeile < 0 THEN grund = "kein DIM " + name + " in diesem Unterprogramm"
    IF grund = "" AND zuweisungen <> 1 THEN grund = name + " wird nicht genau einmal belegt"
    IF grund = "" AND ausdruck = "" THEN grund = "keine Belegung mit einem Ausdruck gefunden"
    ' Die Stellen, an denen gelesen wird.
    DIM stellen AS INTEGER : stellen = 0
    DIM letzte AS INTEGER : letzte = zuwZeile
    IF grund = "" THEN
        FOR i = zuwZeile + 1 TO MIN(ub, LEN(zeilen))
            IF enthaeltWort(LOWER$(zeilen[i - 1]), klein) THEN
                stellen = stellen + 1 : letzte = i
                DIM ruf AS STRING
                FOR EACH ruf IN REGEX_FIND_ALL(LOWER$(zeilen[i - 1]), "[a-z_][a-z0-9_]*\s*\([^()]*\b" + klein + "\b")
                    DIM wer AS STRING : wer = TRIM$(LEFT$(ruf, INSTR(ruf, "(")))
                    IF hatByref(wer) THEN grund = name + " geht an " + wer + ", das BYREF-Parameter hat (Zeile " + STR$(i) + ") -- Einsetzen änderte die Bedeutung"
                NEXT
            END IF
        NEXT
        FOR i = uv TO zuwZeile - 1
            IF i <> dimZeile AND enthaeltWort(LOWER$(zeilen[i - 1]), klein) THEN grund = name + " wird vor der Belegung gelesen (Zeile " + STR$(i) + ")"
        NEXT
    END IF
    IF grund = "" AND stellen = 0 THEN grund = name + " wird nirgends gelesen"
    IF grund = "" AND stellen > 1 AND INSTR(ausdruck, "(") >= 0 THEN grund = "der Ausdruck ruft etwas auf und liefe dann " + STR$(stellen) + "-mal"
    IF grund = "" THEN
        ' Aendert sich eine Variable des Ausdrucks zwischen Belegung und letzter Benutzung?
        DIM w AS STRING
        FOR EACH w IN REGEX_FIND_ALL(LOWER$(ausdruck), "[a-z_][a-z0-9_$]*")
            FOR i = zuwZeile + 1 TO letzte
                IF wirdZugewiesen(LOWER$(TRIM$(zeilen[i - 1])), w) THEN grund = w + " ändert sich in Zeile " + STR$(i)
            NEXT
        NEXT
    END IF
    IF grund <> "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Variable einsetzen geht nicht: ") + grund + ".")
        protokoll("einsetzen nein " + grund)
        RETURN
    END IF
    DIM einfach AS BOOLEAN : einfach = REGEX_TEST(ausdruck, "^([A-Za-z_][A-Za-z0-9_$.]*(\([^()]*\))?|[0-9.]+|" + CHR$(34) + "[^" + CHR$(34) + "]*" + CHR$(34) + ")$")
    DIM ersatz AS STRING : ersatz = IIF(einfach, ausdruck, "(" + ausdruck + ")")
    ' Die Zeilen des Unterprogramms neu: DIM (und Zuweisung) weg, Lesestellen ersetzt.
    DIM neu AS ARRAY OF STRING : neu = []
    FOR i = 1 TO LEN(zeilen)
        IF i = dimZeile OR i = zuwZeile THEN CONTINUE
        IF i > zuwZeile AND i <= letzte THEN
            ARRAY_PUSH(neu, wortErsetzen$(zeilen[i - 1], name, ersatz))
        ELSE
            ARRAY_PUSH(neu, zeilen[i - 1])
        END IF
    NEXT
    DIM neuText AS STRING : neuText = JOIN$(neu, NL)
    DIM mehr AS INTEGER : mehr = fehlerZahl(neuText) - fehlerZahl(quelle)
    umbauLeeren()
    umbauVormerken(aktiverTab, tabPfade[aktiverTab], neuText)
    umbauZeile = MAX(1, dimZeile) : umbauSpalte = 1
    umbauStarten("Variable " + name + " einsetzen", _
                 IIF(mehr > 0, "Achtung: " + STR$(mehr) + " Fehler mehr.", _
                     name + " an " + STR$(stellen) + " Stelle(n) durch " + ersatz + " ersetzt, die Belegung ist weg."), _
                 "eingesetzt " + name + " " + STR$(stellen) + " " + STR$(mehr))
END SUB

' Ein Wort (ganz, Gross/klein egal) in einer Zeile durch einen Text
' ersetzen -- nicht in Zeichenketten und nicht im Kommentar, nicht hinter
' einem Punkt (dort ist es ein Feld). CODE_RENAME$ nimmt als neuen Namen
' nur einen Namen, keinen Ausdruck.
FUNCTION wortErsetzen$(zeile AS STRING, wort AS STRING, ersatz AS STRING) AS STRING
    DIM aus AS STRING : aus = ""
    DIM i AS INTEGER : i = 0
    DIM n AS INTEGER : n = LEN(zeile)
    DIM klein AS STRING : klein = LOWER$(wort)
    WHILE i < n
        DIM c AS STRING : c = MID$(zeile, i, 1)
        IF c = CHR$(34) THEN
            DIM a AS INTEGER : a = i
            i = i + 1
            WHILE i < n AND MID$(zeile, i, 1) <> CHR$(34)
                i = i + 1
            WEND
            aus = aus + MID$(zeile, a, i - a + 1)
            i = i + 1
        ELSEIF c = "'" THEN
            aus = aus + MID$(zeile, i)
            i = n
        ELSEIF istWortzeichen(c) THEN
            DIM b AS INTEGER : b = i
            WHILE i < n AND istWortzeichen(MID$(zeile, i, 1))
                i = i + 1
            WEND
            DIM w AS STRING : w = MID$(zeile, b, i - b)
            DIM punkt AS BOOLEAN : punkt = b > 0 AND MID$(zeile, b - 1, 1) = "."
            IF LOWER$(w) = klein AND NOT punkt THEN aus = aus + ersatz ELSE aus = aus + w
        ELSE
            aus = aus + c
            i = i + 1
        END IF
    WEND
    RETURN aus
END FUNCTION

' Hat ein eigenes Unterprogramm dieses Namens einen BYREF-Parameter? Gesucht
' in der Datei im Reiter und im Projekt (nur Kopfzeilen).
FUNCTION hatByref(name AS STRING) AS BOOLEAN
    IF name = "" THEN RETURN FALSE
    DIM muster AS STRING : muster = "^\s*(sub|function)\s+" + REGEX_ESCAPE$(LOWER$(name)) + "\s*\(.*\bbyref\b"
    DIM texte AS ARRAY OF STRING : texte = []
    IF aktiverTab >= 0 THEN ARRAY_PUSH(texte, GUI_TEXT(tabFelder[aktiverTab]))
    DIM d AS STRING
    FOR EACH d IN projektDateien("*.dh")
        ARRAY_PUSH(texte, projektQuelle$(PATHJOIN(projektOrdner, d)))
    NEXT
    DIM q AS STRING
    FOR EACH q IN texte
        IF INSTR(LOWER$(q), LOWER$(name)) < 0 THEN CONTINUE
        DIM z AS STRING
        FOR EACH z IN SPLIT$(q, NL)
            IF REGEX_TEST(LOWER$(z), muster) THEN RETURN TRUE
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' --- SUB in FUNCTION umwandeln ------------------------------------------
' Eine SUB mit genau einem BYREF-Parameter, der ihr Ergebnis traegt, wird
' eine FUNCTION: der Parameter wird eine lokale Variable, jedes EXIT SUB ein
' `RETURN r`, am Ende `RETURN r`. Jeder Aufruf `name(a, x)` als Anweisung
' wird `x = name(a)` -- im ganzen Projekt, ueber die Vorschau. Verweigert,
' wenn die SUB den hineingegebenen Wert LIEST, bevor sie ihn setzt (den
' gaebe es dann nicht mehr), und fuer Methoden (die stehen eingerueckt).
DIM sfName AS STRING : sfName = ""
DIM sfIndex AS INTEGER : sfIndex = -1
DIM sfUebergangen AS INTEGER : sfUebergangen = 0

' Ein Aufruf als ganze Anweisung umschreiben; "" wenn die Zeile keiner ist.
FUNCTION sfAufrufZeile$(zeile AS STRING, name AS STRING, idx AS INTEGER) AS STRING
    DIM ein AS STRING : ein = LEFT$(zeile, LEN(zeile) - LEN(LTRIM$(zeile)))
    DIM t AS STRING : t = TRIM$(zeile)
    IF LEFT$(UPPER$(t), 5) = "CALL " THEN t = TRIM$(MID$(t, 5))
    IF LOWER$(LEFT$(t, LEN(name))) <> LOWER$(name) THEN RETURN ""
    DIM rest AS STRING : rest = LTRIM$(MID$(t, LEN(name)))
    IF LEFT$(rest, 1) <> "(" THEN RETURN ""
    DIM auf AS INTEGER : auf = LEN(t) - LEN(rest)
    DIM von AS ARRAY OF INTEGER : von = []
    DIM bis AS ARRAY OF INTEGER : bis = []
    DIM zu AS INTEGER : zu = argsZerlegen(t, auf, von, bis)
    IF zu < 0 OR idx >= LEN(von) THEN RETURN ""
    DIM hinten AS STRING : hinten = TRIM$(MID$(t, zu + 1))
    IF hinten <> "" AND LEFT$(hinten, 1) <> "'" THEN RETURN ""
    DIM args AS ARRAY OF STRING : args = []
    DIM ziel AS STRING : ziel = ""
    DIM k AS INTEGER
    FOR k = 0 TO LEN(von) - 1
        DIM a AS STRING : a = TRIM$(MID$(t, von[k], bis[k] - von[k]))
        IF k = idx THEN ziel = a ELSE ARRAY_PUSH(args, a)
    NEXT
    IF ziel = "" THEN RETURN ""
    RETURN ein + ziel + " = " + name + "(" + JOIN$(args, ", ") + ")" + IIF(hinten <> "", " " + hinten, "")
END FUNCTION

SUB subInFunction()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM quelle AS STRING : quelle = GUI_TEXT(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM mz AS INTEGER
    DIM ms AS INTEGER
    (mz, ms) = GUI_TEXTAREA_CURSOR(ta)
    DIM uv AS INTEGER
    DIM ub AS INTEGER
    (uv, ub) = umgebendesUnterprogramm(quelle, mz)
    DIM grund AS STRING : grund = ""
    IF uv < 1 THEN grund = "die Marke steht in keinem Unterprogramm"
    DIM kopf AS STRING : kopf = ""
    IF grund = "" THEN
        kopf = zeilen[uv - 1]
        IF LEFT$(UPPER$(kopf), 4) <> "SUB " THEN grund = "das ist keine SUB"
        IF grund = "" AND LEN(kopf) <> LEN(LTRIM$(kopf)) THEN grund = "Methoden wandelt die IDE nicht um"
    END IF
    DIM name AS STRING : name = ""
    DIM von AS ARRAY OF INTEGER : von = []
    DIM bis AS ARRAY OF INTEGER : bis = []
    DIM auf AS INTEGER : auf = -1
    DIM zu AS INTEGER : zu = -1
    IF grund = "" THEN
        auf = INSTR(kopf, "(")
        name = TRIM$(MID$(kopf, 4, auf - 4))
        zu = argsZerlegen(kopf, auf, von, bis)
        IF zu < 0 THEN grund = "die Kopfzeile ist nicht zu lesen"
    END IF
    DIM idx AS INTEGER : idx = -1
    DIM pname AS STRING : pname = ""
    DIM ptyp AS STRING : ptyp = ""
    DIM params AS ARRAY OF STRING : params = []
    IF grund = "" THEN
        DIM k AS INTEGER
        FOR k = 0 TO LEN(von) - 1
            DIM p AS STRING : p = TRIM$(MID$(kopf, von[k], bis[k] - von[k]))
            IF LEFT$(UPPER$(p), 6) = "BYREF " THEN
                IF idx >= 0 THEN grund = "mehr als ein BYREF-Parameter"
                idx = k
                DIM rp AS STRING : rp = TRIM$(MID$(p, 6))
                DIM ap AS INTEGER : ap = INSTR(UPPER$(rp), " AS ")
                IF ap < 0 THEN grund = "der BYREF-Parameter hat keinen Typ"
                IF ap >= 0 THEN pname = TRIM$(LEFT$(rp, ap)) : ptyp = TRIM$(MID$(rp, ap + 4))
            ELSE
                ARRAY_PUSH(params, p)
            END IF
        NEXT
        IF grund = "" AND idx < 0 THEN grund = "kein BYREF-Parameter, der das Ergebnis tragen könnte"
    END IF
    IF grund = "" THEN
        ' Liest die SUB den hineingegebenen Wert, bevor sie ihn setzt?
        DIM i AS INTEGER
        FOR i = uv + 1 TO ub - 1
            DIM zl AS STRING : zl = LOWER$(TRIM$(zeilen[i - 1]))
            IF wirdZugewiesen(zl, LOWER$(pname)) THEN
                DIM rechts AS STRING : rechts = MID$(zl, INSTR(zl, "=") + 1)
                IF enthaeltWort(rechts, LOWER$(pname)) THEN grund = pname + " wird gelesen, bevor es gesetzt wird (Zeile " + STR$(i) + ")"
                EXIT FOR
            END IF
            IF enthaeltWort(zl, LOWER$(pname)) THEN
                grund = pname + " wird gelesen, bevor es gesetzt wird (Zeile " + STR$(i) + ")"
                EXIT FOR
            END IF
        NEXT
    END IF
    IF grund <> "" THEN
        GUI_SET_TEXT(lblStatus, tr$("SUB in FUNCTION geht nicht: ") + grund + ".")
        protokoll("subfunction nein " + grund)
        RETURN
    END IF
    ' Die eigene Datei: Kopf, lokale Variable, EXIT SUB, Ende.
    DIM neu AS ARRAY OF STRING : neu = []
    FOR i = 1 TO LEN(zeilen)
        DIM z AS STRING : z = zeilen[i - 1]
        IF i = uv THEN
            ARRAY_PUSH(neu, "FUNCTION " + name + "(" + JOIN$(params, ", ") + ") AS " + ptyp + MID$(kopf, zu + 1))
            ARRAY_PUSH(neu, "    DIM " + pname + " AS " + ptyp)
        ELSEIF i > uv AND i < ub THEN
            ARRAY_PUSH(neu, REGEX_REPLACE(z, "(?i)\bEXIT\s+SUB\b", "RETURN " + pname))
        ELSEIF i = ub THEN
            ARRAY_PUSH(neu, "    RETURN " + pname)
            ARRAY_PUSH(neu, REGEX_REPLACE(z, "(?i)END\s+SUB", "END FUNCTION"))
        ELSE
            DIM rz AS STRING : rz = sfAufrufZeile$(z, name, idx)
            ARRAY_PUSH(neu, IIF(rz <> "", rz, z))
        END IF
    NEXT
    umbauLeeren()
    umbauVormerken(aktiverTab, tabPfade[aktiverTab], JOIN$(neu, NL))
    ' Die Aufrufe in den anderen Dateien des Projekts.
    DIM gezaehlt AS INTEGER : gezaehlt = 0
    sfUebergangen = 0
    DIM d AS STRING
    FOR EACH d IN projektDateien("*.dh")
        DIM pf AS STRING : pf = PATHJOIN(projektOrdner, d)
        IF tabPfade[aktiverTab] <> "" AND wegGleich$(pf) = wegGleich$(tabPfade[aktiverTab]) THEN CONTINUE
        DIM q AS STRING : q = projektQuelle$(pf)
        IF q = "" OR INSTR(LOWER$(q), LOWER$(name)) < 0 THEN CONTINUE
        DIM qz AS ARRAY OF STRING : qz = SPLIT$(q, NL)
        DIM geaendert AS BOOLEAN : geaendert = FALSE
        FOR i = 0 TO LEN(qz) - 1
            DIM r2 AS STRING : r2 = sfAufrufZeile$(qz[i], name, idx)
            IF r2 <> "" THEN
                qz[i] = r2 : geaendert = TRUE : gezaehlt = gezaehlt + 1
            ELSEIF enthaeltWort(LOWER$(qz[i]), LOWER$(name)) AND NOT aufrufInZeile(qz[i], name) THEN
                sfUebergangen = sfUebergangen + 1
            END IF
        NEXT
        IF geaendert THEN umbauVormerken(tabMitPfad(pf), pf, JOIN$(qz, NL))
    NEXT
    DIM sagen AS STRING : sagen = "SUB " + name + " -> FUNCTION " + name + " AS " + ptyp + " (Ergebnis in " + pname + ")."
    IF sfUebergangen > 0 THEN sagen = sagen + " " + STR$(sfUebergangen) + " Stelle(n) nennen den Namen ohne Aufruf als Anweisung -- bitte ansehen."
    umbauZeile = uv : umbauSpalte = 1
    umbauStarten("SUB " + name + " in FUNCTION umwandeln", sagen, "subfunction " + name + " " + STR$(LEN(umbauTexte)))
END SUB

' --- Live-Vorschau: Logik ------------------------------------------------
' Ist sie an, laeuft das Programm im Reiter nach jeder Pause beim Tippen
' 30 Bilder lang ueber `dhrt bild` und das letzte Bild steht im Fenster.
' Gerechnet wird eine Kopie des Textes NEBEN der Datei (relative Bilder und
' IMPORTs finden sich so), versteckt als ".dh_live_vorschau.dh" und danach
' geloescht; die Eingabe des Programms ist sofort zu (INPUT haengt nicht),
' und nach 10 s wird abgebrochen.
DIM liveAn AS BOOLEAN : liveAn = FALSE
DIM liveProz AS INTEGER : liveProz = -1
DIM liveStand AS STRING : liveStand = "-"
DIM liveKandidat AS STRING : liveKandidat = "-"
DIM liveFaellig AS FLOAT : liveFaellig = -1.0
DIM liveStart AS FLOAT : liveStart = 0.0
DIM liveKopie AS STRING : liveKopie = ""
DIM liveDatei AS STRING : liveDatei = ""
DIM liveBild AS IMAGE : liveBild = -1
DIM liveFehler AS STRING : liveFehler = ""

SUB liveSetzen(an AS BOOLEAN)
    liveAn = an
    GUI_MENU_CHECK(miLive, an)
    GUI_WINDOW_VISIBLE(winLive, an)
    IF an THEN
        liveStand = "-" : liveKandidat = "-"
        GUI_SET_TEXT(lblLive, tr$("Wartet auf eine Pause beim Tippen ..."))
    END IF
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Live-Vorschau an."), tr$("Live-Vorschau aus.")))
    protokoll("live " + IIF(an, "an", "aus"))
END SUB

' Absolut: `dhrt bild` wechselt in den Ordner des Programms, ein relativer
' Vorschauordner (DH_IDE_KONFIG=ide.json) laege sonst dort.
FUNCTION livePng$() AS STRING
    DIM o AS STRING : o = vorschauOrdner
    IF NOT (MID$(o, 1, 1) = ":" OR LEFT$(o, 1) = "/" OR LEFT$(o, 1) = "\") THEN o = PATHJOIN(CWD$(), o)
    RETURN PATHJOIN(o, "live.png")
END FUNCTION

SUB liveNachziehen()
    IF NOT liveAn THEN RETURN
    IF NOT GUI_WINDOW_SHOWN(winLive) THEN liveSetzen(FALSE) : RETURN
    IF liveProz >= 0 THEN
        liveFehler = liveFehler + PROCESS_ERR$(liveProz)
        DIM verwerfen AS STRING : verwerfen = PROCESS_READ$(liveProz)
        IF PROCESS_RUNNING(liveProz) THEN
            IF GET_TIME() - liveStart > 10.0 THEN
                PROCESS_KILL(liveProz)
                liveFehler = liveFehler + NL + "nach 10 s abgebrochen"
            END IF
            RETURN
        END IF
        SLEEP(20)
        liveFehler = liveFehler + PROCESS_ERR$(liveProz)
        DIM code AS INTEGER : code = PROCESS_CODE(liveProz)
        PROCESS_CLOSE(liveProz)
        liveProz = -1
        IF liveKopie <> "" AND FILEEXISTS(liveKopie) THEN DELETEFILE(liveKopie)
        IF code = 0 AND FILEEXISTS(livePng$()) THEN
            IF liveBild >= 0 THEN IMAGE_FREE(liveBild)
            liveBild = LOADIMAGE(livePng$())
            GUI_SET_IMAGE(imgLive, liveBild)
            GUI_SET_TEXT(lblLive, tr$("Stand ") + TIME$())
            protokoll("live bild " + STR$(IMAGEWIDTH(liveBild)) + "x" + STR$(IMAGEHEIGHT(liveBild)))
        ELSE
            DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(TRIM$(REPLACE$(liveFehler, CHR$(13), "")), NL)
            DIM letzte AS STRING : letzte = "kein Bild (Code " + STR$(code) + ")"
            IF LEN(zeilen) > 0 AND TRIM$(zeilen[LEN(zeilen) - 1]) <> "" THEN letzte = TRIM$(zeilen[LEN(zeilen) - 1])
            ' Die Meldung nennt die Kopie -- gemeint ist die Datei im Reiter.
            letzte = REPLACE$(letzte, ".dh_live_vorschau.dh", liveDatei)
            GUI_SET_TEXT(lblLive, tr$("Kein Bild: ") + letzte)
            protokoll("live fehler " + letzte)
        END IF
        RETURN
    END IF
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" OR LOWER$(RIGHT$(pfad, 3)) <> ".dh" THEN
        GUI_SET_TEXT(lblLive, tr$("Nur für gesicherte .dh-Dateien."))
        RETURN
    END IF
    DIM text AS STRING : text = GUI_TEXT(tabFelder[aktiverTab])
    IF text = liveStand THEN RETURN
    IF text <> liveKandidat THEN
        liveKandidat = text
        liveFaellig = GET_TIME() + 0.8
        RETURN
    END IF
    IF GET_TIME() < liveFaellig THEN RETURN
    liveStand = text
    liveDatei = BASENAME(pfad)
    liveKopie = PATHJOIN(DIRNAME(pfad), ".dh_live_vorschau.dh")
    WRITEALL(liveKopie, text)
    IF NOT DIREXISTS(DIRNAME(livePng$())) THEN MKDIR(DIRNAME(livePng$()))
    IF FILEEXISTS(livePng$()) THEN DELETEFILE(livePng$())
    liveFehler = ""
    liveStart = GET_TIME()
    liveProz = PROCESS_START("dhrt", "bild", liveKopie, livePng$(), "30")
    PROCESS_CLOSE_INPUT(liveProz)
    GUI_SET_TEXT(lblLive, tr$("Rechnet ..."))
    protokoll("live start")
END SUB

' --- Pruefsammlungen im Ueberblick: Logik -------------------------------
' Je Fall der Stand des letzten Laufs ("ok", "fehl", "ueber"), Schluessel
' ist der Weg der Sammlung (klein, mit Schraegstrichen) und die Zeile ihres
' "=== Name". Er bleibt ueber das Schliessen des Fensters hinaus.
DIM testStatus AS MAP OF STRING
DIM tuKnoten AS ARRAY OF INTEGER : tuKnoten = []
DIM tuDatei AS ARRAY OF STRING : tuDatei = []
DIM tuZeile AS ARRAY OF INTEGER : tuZeile = []
DIM tuName AS ARRAY OF STRING : tuName = []
DIM tuPunkte AS ARRAY OF IMAGE : tuPunkte = []

' Kanonisch: `dhrt test` nennt den Weg, wie er ihm gegeben wurde -- auch in
' der kurzen 8.3-Schreibweise (HANSGA~1), der Baum in der langen.
FUNCTION testSchluessel$(pfad AS STRING, zeile AS INTEGER) AS STRING
    DIM w AS STRING : w = pfad
    TRY
        w = REALPATH$(pfad)
    CATCH e
        w = pfad
    END TRY
    RETURN LOWER$(wegGleich$(w)) + "|" + STR$(zeile)
END FUNCTION

SUB testStatusSetzen(pfad AS STRING, zeile AS INTEGER, stand AS STRING)
    MAPPUT(testStatus, testSchluessel$(pfad, zeile), stand)
END SUB

' Die Faelle einer Sammlung: (Zeilen, Namen) der "=== "-Zeilen.
FUNCTION testFaelleVon(pfad AS STRING) AS TUPLE
    DIM zl AS ARRAY OF INTEGER : zl = []
    DIM nm AS ARRAY OF STRING : nm = []
    DIM q AS STRING : q = ""
    TRY
        q = dateiLesen(pfad)
    CATCH e
        q = ""
    END TRY
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(q, NL)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        IF LEFT$(zeilen[i], 4) = "=== " THEN
            ARRAY_PUSH(zl, i + 1)
            ARRAY_PUSH(nm, TRIM$(REPLACE$(MID$(zeilen[i], 4), CHR$(13), "")))
        END IF
    NEXT
    RETURN (zl, nm)
END FUNCTION

' Alle Faelle der Datei, die in diesem Lauf dran waren, als bestanden.
SUB testDateiBestanden(pfad AS STRING)
    DIM zl AS ARRAY OF INTEGER
    DIM nm AS ARRAY OF STRING
    (zl, nm) = testFaelleVon(pfad)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zl) - 1
        IF testFall = "" OR nm[i] = testFall THEN testStatusSetzen(pfad, zl[i], "ok")
    NEXT
END SUB

' Ein kleiner farbiger Punkt als Sinnbild -- grau, gruen, rot.
FUNCTION testPunkt(farbe AS INTEGER) AS IMAGE
    DIM b AS IMAGE : b = IMAGE_NEW(12, 12)
    IMAGE_FILL_ELLIPSE(b, 6.0, 6.0, 4.5, 4.5, farbe)
    RETURN b
END FUNCTION

SUB testUebersichtZeigen()
    IF LEN(tuPunkte) = 0 THEN
        ARRAY_PUSH(tuPunkte, testPunkt(&H808890))
        ARRAY_PUSH(tuPunkte, testPunkt(&H40C060))
        ARRAY_PUSH(tuPunkte, testPunkt(&HE05050))
    END IF
    testUebersichtFuellen()
    GUI_WINDOW_VISIBLE(winTests, TRUE)
    GUI_FOCUS(baumTests)
END SUB

SUB testUebersichtFuellen()
    DIM wahlDatei AS STRING : wahlDatei = ""
    DIM wahlZeile AS INTEGER : wahlZeile = -1
    DIM sel AS INTEGER : sel = GUI_TREE_SELECTED(baumTests)
    DIM k AS INTEGER : k = ARRAY_INDEXOF(tuKnoten, sel)
    IF sel >= 0 AND k >= 0 THEN wahlDatei = tuDatei[k] : wahlZeile = tuZeile[k]
    GUI_TREE_CLEAR(baumTests)
    tuKnoten = [] : tuDatei = [] : tuZeile = [] : tuName = []
    DIM dateien AS ARRAY OF STRING : dateien = []
    IF projektOrdner <> "" THEN dateien = projektDateien("*.dhtest")
    DIM gesamt AS INTEGER : gesamt = 0
    DIM gut AS INTEGER : gut = 0
    DIM schlecht AS INTEGER : schlecht = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM zl AS ARRAY OF INTEGER
        DIM nm AS ARRAY OF STRING
        (zl, nm) = testFaelleVon(pfad)
        DIM fk AS INTEGER : fk = GUI_TREE_ADD(baumTests, -1, d)
        ARRAY_PUSH(tuKnoten, fk) : ARRAY_PUSH(tuDatei, pfad) : ARRAY_PUSH(tuZeile, 0) : ARRAY_PUSH(tuName, "")
        DIM fOk AS INTEGER : fOk = 0
        DIM fFehl AS INTEGER : fFehl = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zl) - 1
            DIM stand AS STRING : stand = MAPGETOR(testStatus, testSchluessel$(pfad, zl[i]), "")
            DIM kk AS INTEGER : kk = GUI_TREE_ADD(baumTests, fk, nm[i])
            ARRAY_PUSH(tuKnoten, kk) : ARRAY_PUSH(tuDatei, pfad) : ARRAY_PUSH(tuZeile, zl[i]) : ARRAY_PUSH(tuName, nm[i])
            DIM bild AS INTEGER : bild = 0
            IF stand = "ok" THEN bild = 1 : fOk = fOk + 1
            IF stand = "fehl" THEN bild = 2 : fFehl = fFehl + 1
            IF LEN(tuPunkte) = 3 THEN GUI_TREE_ICON(baumTests, kk, tuPunkte[bild])
            IF stand = "fehl" THEN GUI_TREE_COLOR(baumTests, kk, &HE06060)
            IF wahlDatei = pfad AND wahlZeile = zl[i] THEN GUI_TREE_SET_SELECTED(baumTests, kk)
        NEXT
        DIM fb AS INTEGER : fb = 0
        IF fFehl > 0 THEN
            fb = 2
            GUI_TREE_COLOR(baumTests, fk, &HE06060)
        ELSEIF fOk = LEN(zl) AND LEN(zl) > 0 THEN
            fb = 1
        END IF
        IF LEN(tuPunkte) = 3 THEN GUI_TREE_ICON(baumTests, fk, tuPunkte[fb])
        ' Eine Datei mit Fehlschlag steht offen; die anderen nur, solange es
        ' wenige Sammlungen sind -- sonst sucht man den roten Fall in einer
        ' langen Liste gruener.
        GUI_TREE_EXPAND(baumTests, fk, fFehl > 0 OR LEN(dateien) <= 5)
        IF wahlDatei = pfad AND wahlZeile = 0 THEN GUI_TREE_SET_SELECTED(baumTests, fk)
        gesamt = gesamt + LEN(zl) : gut = gut + fOk : schlecht = schlecht + fFehl
    NEXT
    GUI_SET_TEXT(lblTests, STR$(LEN(dateien)) + tr$(" Sammlung(en), ") + STR$(gesamt) + tr$(" Fälle: ") + _
                 STR$(gut) + " bestanden, " + STR$(schlecht) + " fehlgeschlagen, " + _
                 STR$(gesamt - gut - schlecht) + " offen")
    protokoll("tests " + STR$(LEN(dateien)) + " " + STR$(gesamt) + " " + STR$(gut) + " " + STR$(schlecht))
END SUB

' Die gewaehlten Knoten als Laeufe: eine Datei ganz, ein Fall allein.
SUB testAuswahlAusfuehren()
    DIM sel AS INTEGER : sel = GUI_TREE_SELECTED(baumTests)
    DIM k AS INTEGER : k = ARRAY_INDEXOF(tuKnoten, sel)
    IF sel < 0 OR k < 0 THEN
        GUI_SET_TEXT(lblTests, tr$("Erst eine Sammlung oder einen Fall wählen."))
        RETURN
    END IF
    testLaufStarten([tuDatei[k]], [tuName[k]])
END SUB

SUB testFehlgeschlageneAusfuehren()
    DIM ziele AS ARRAY OF STRING : ziele = []
    DIM faelle AS ARRAY OF STRING : faelle = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(tuKnoten) - 1
        IF tuZeile[i] = 0 THEN CONTINUE
        IF MAPGETOR(testStatus, testSchluessel$(tuDatei[i], tuZeile[i]), "") = "fehl" THEN
            ARRAY_PUSH(ziele, tuDatei[i]) : ARRAY_PUSH(faelle, tuName[i])
        END IF
    NEXT
    IF LEN(ziele) = 0 THEN
        GUI_SET_TEXT(lblTests, tr$("Kein fehlgeschlagener Fall."))
        protokoll("tests keine fehlgeschlagenen")
        RETURN
    END IF
    testLaufStarten(ziele, faelle)
END SUB

SUB testUebersichtNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winTests) THEN RETURN
    IF GUI_CLICKED(btnTestsNeu) THEN testUebersichtFuellen()
    IF testProz < 0 THEN
        IF GUI_CLICKED(btnTestsAlle) AND projektOrdner <> "" THEN testLaufStarten([projektOrdner], [""])
        IF GUI_CLICKED(btnTestsWahl) THEN testAuswahlAusfuehren()
        IF GUI_CLICKED(btnTestsFehl) THEN testFehlgeschlageneAusfuehren()
    END IF
    IF GUI_DOUBLE_CLICKED(baumTests) THEN
        DIM k AS INTEGER : k = ARRAY_INDEXOF(tuKnoten, GUI_TREE_SELECTED(baumTests))
        IF k >= 0 THEN
            dateiOeffnen(tuDatei[k])
            IF tuZeile[k] > 0 AND aktivesFeld() >= 0 THEN GUI_TEXTAREA_GOTO(aktivesFeld(), tuZeile[k], 1)
            protokoll("tests sprung " + BASENAME(tuDatei[k]) + " " + STR$(tuZeile[k]))
        END IF
    END IF
END SUB

' --- Neues Projekt aus Vorlage: Logik ----------------------------------
' Vier Vorlagen, jede ein lauffaehiges Programm (main.dh) samt LIESMICH.md;
' das Spiel bringt ein Bild in assets/ mit, das Konsolenprogramm eine
' zweite Datei und eine Pruefsammlung. Danach ist der Ordner das Projekt
' und main.dh offen.
FUNCTION npBeschreibung$(i AS INTEGER) AS STRING
    SELECT CASE i
        CASE 0 : RETURN "Ein Fenster mit Spielschleife: eine Figur aus assets/figur.png, die sich mit den Pfeiltasten bewegt -- gerechnet mit DELTA(), also gleich schnell bei jeder Bildrate."
        CASE 1 : RETURN "Eine Anwendung mit gui: Textfeld, Knopf und Liste in einem Fenster; Enter im Feld drückt den Knopf."
        CASE 2 : RETURN "Ein Konsolenprogramm mit INPUT und PRINT, eine Funktion in rechnen.dh und eine Prüfsammlung tests.dhtest dazu (Strg+Alt+F5)."
        CASE 3 : RETURN "Nur main.dh mit einer Zeile -- für alles andere."
    END SELECT
    RETURN ""
END FUNCTION

SUB neuProjektZeigen()
    GUI_LISTBOX_SET_SELECTED(lstVorlagen, 0)
    npWahl = -2
    IF TRIM$(GUI_TEXT(tfNpName)) = "" THEN GUI_SET_TEXT(tfNpName, tr$("MeinProjekt"))
    IF TRIM$(GUI_TEXT(tfNpOrt)) = "" THEN
        DIM ort AS STRING : ort = CWD$()
        IF projektOrdner <> "" THEN ort = DIRNAME(projektOrdner)
        GUI_SET_TEXT(tfNpOrt, ort)
    END IF
    GUI_SET_TEXT(lblNpMeldung, "")
    GUI_WINDOW_VISIBLE(winNeuProj, TRUE)
    GUI_FOCUS(tfNpName)
    protokoll("neues projekt fenster")
END SUB

SUB neuProjektNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winNeuProj) THEN RETURN
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstVorlagen)
    IF sel <> npWahl THEN
        npWahl = sel
        GUI_SET_TEXT(lblVorlage, npBeschreibung$(sel))
    END IF
    IF GUI_CLICKED(btnNpOrt) THEN
        DIM w AS STRING : w = ""
        TRY
            w = FOLDER_DIALOG("Wo soll das Projekt liegen?")
        CATCH e
            w = ""
        END TRY
        IF w <> "" THEN GUI_SET_TEXT(tfNpOrt, w)
    END IF
    IF GUI_CLICKED(btnNpAnlegen) THEN
        IF neuProjektAnlegen(sel, TRIM$(GUI_TEXT(tfNpName)), TRIM$(GUI_TEXT(tfNpOrt))) THEN
            GUI_WINDOW_VISIBLE(winNeuProj, FALSE)
        END IF
    END IF
END SUB

FUNCTION npZeilen$(z AS ARRAY OF STRING) AS STRING
    RETURN JOIN$(z, NL) + NL
END FUNCTION

' Legt das Projekt an; FALSE mit Meldung im Fenster, wenn es nicht geht.
FUNCTION neuProjektAnlegen(art AS INTEGER, name AS STRING, ort AS STRING) AS BOOLEAN
    IF name = "" OR NOT REGEX_TEST(name, "^[A-Za-z0-9_ äöüÄÖÜß-]+$") THEN
        GUI_SET_TEXT(lblNpMeldung, tr$("Der Name braucht Buchstaben, Ziffern, _ oder -."))
        protokoll("neues projekt name ungueltig")
        RETURN FALSE
    END IF
    IF ort = "" OR NOT DIREXISTS(ort) THEN
        GUI_SET_TEXT(lblNpMeldung, tr$("Den Ort gibt es nicht: ") + ort)
        protokoll("neues projekt ort fehlt")
        RETURN FALSE
    END IF
    DIM ziel AS STRING : ziel = PATHJOIN(ort, name)
    IF DIREXISTS(ziel) THEN
        IF LEN(DIRLIST(ziel)) > 0 THEN
            GUI_SET_TEXT(lblNpMeldung, tr$("Den Ordner ") + name + tr$(" gibt es schon, und er ist nicht leer."))
            protokoll("neues projekt ordner belegt")
            RETURN FALSE
        END IF
    ELSE
        MKDIR(ziel)
    END IF
    DIM q AS STRING : q = CHR$(34)
    DIM liesmich AS STRING
    SELECT CASE art
        CASE 0
            MKDIR(PATHJOIN(ziel, "assets"))
            DIM b AS IMAGE : b = IMAGE_NEW(32, 32)
            IMAGE_FILL_ELLIPSE(b, 16.0, 16.0, 14.0, 14.0, &H40C0E0)
            IMAGE_FILL_ELLIPSE(b, 11.0, 12.0, 3.0, 3.0, &H102030)
            IMAGE_FILL_ELLIPSE(b, 21.0, 12.0, 3.0, 3.0, &H102030)
            IMAGE_SAVE(b, PATHJOIN(ziel, "assets/figur.png"))
            IMAGE_FREE(b)
            WRITEALL(PATHJOIN(ziel, "main.dh"), npZeilen$([ _
                "' " + name + " -- ein Spiel in Drachenhauch.", _
                "' Pfeiltasten bewegen die Figur, ESC beendet.", _
                "SCREEN(800, 600, " + q + name + q + ", 1)", _
                "SETFPS(60)", _
                "DIM figur AS IMAGE : figur = LOADIMAGE(" + q + "assets/figur.png" + q + ")", _
                "DIM x AS FLOAT : x = 400.0", _
                "DIM y AS FLOAT : y = 300.0", _
                "CONST TEMPO = 240.0", _
                "WHILE NOT QUITREQUESTED()", _
                "    IF KEYPRESSED(KEY_LEFT) THEN x = x - TEMPO * DELTA()", _
                "    IF KEYPRESSED(KEY_RIGHT) THEN x = x + TEMPO * DELTA()", _
                "    IF KEYPRESSED(KEY_UP) THEN y = y - TEMPO * DELTA()", _
                "    IF KEYPRESSED(KEY_DOWN) THEN y = y + TEMPO * DELTA()", _
                "    CLS(RGB(20, 24, 40))", _
                "    DRAWIMAGE(figur, INT(x) - 16, INT(y) - 16)", _
                "    TEXT(10, 10, " + q + "Pfeiltasten bewegen die Figur" + q + ")", _
                "    FLIP()", _
                "WEND"]))
            liesmich = "Ein Spiel: F5 startet es, die Figur liegt in assets/figur.png."
        CASE 1
            WRITEALL(PATHJOIN(ziel, "main.dh"), npZeilen$([ _
                "' " + name + " -- eine Anwendung mit Fenster und Formular.", _
                "IMPORT " + q + "gui" + q, _
                "SCREEN(640, 420, " + q + name + q + ", 1)", _
                "SETFPS(60)", _
                "DIM win AS GUI_WINDOW : win = GUI_WINDOW(" + q + name + q + ", 0, 0, 640, 420)", _
                "GUI_WINDOW_CHROME(win, FALSE)", _
                "DIM lbl AS GUI_WIDGET : lbl = GUI_LABEL(win, " + q + tr$("Name:") + q + ", 20, 24)", _
                "DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(win, 100, 20, 300, 28, " + q + tr$("Wie heißt du?") + q + ")", _
                "DIM btn AS GUI_WIDGET : btn = GUI_BUTTON(win, " + q + tr$("Hinzufügen") + q + ", 410, 20, 140, 28)", _
                "DIM lst AS GUI_WIDGET : lst = GUI_LISTBOX(win, 20, 64, 530, 300, [])", _
                "GUI_WINDOW_DEFAULT(win, btn)", _
                "GUI_FOCUS(tf)", _
                "WHILE NOT QUITREQUESTED()", _
                "    GUI_UPDATE()", _
                "    IF GUI_CLICKED(btn) AND TRIM$(GUI_TEXT(tf)) <> " + q + q + " THEN", _
                "        GUI_LISTBOX_ADD(lst, TRIM$(GUI_TEXT(tf)))", _
                "        GUI_SET_TEXT(tf, " + q + q + ")", _
                "    END IF", _
                "    CLS(BLACK)", _
                "    GUI_DRAW()", _
                "    FLIP()", _
                "WEND"]))
            liesmich = "Eine Anwendung mit Fenster: F5 startet sie. Das Formular lässt sich auch im Form-Designer bauen (Werkzeuge)."
        CASE 2
            WRITEALL(PATHJOIN(ziel, "rechnen.dh"), npZeilen$([ _
                "' Rechnen -- eine Funktion, die tests.dhtest prueft.", _
                "FUNCTION mal(a AS INTEGER, b AS INTEGER) AS INTEGER", _
                "    RETURN a * b", _
                "END FUNCTION"]))
            WRITEALL(PATHJOIN(ziel, "main.dh"), npZeilen$([ _
                "' " + name + " -- ein Konsolenprogramm.", _
                "IMPORT " + q + "rechnen.dh" + q, _
                "DIM name AS STRING", _
                "INPUT " + q + "Wie heißt du? " + q + ", name", _
                "PRINT " + q + "Hallo, " + q + " + name + " + q + "! 6 mal 7 ist " + q + " + STR$(mal(6, 7)) + " + q + "." + q]))
            WRITEALL(PATHJOIN(ziel, "tests.dhtest"), npZeilen$([ _
                "' Pruefsammlung: in der IDE Strg+Alt+F5, sonst dhrt test tests.dhtest", _
                "", _
                "=== mal rechnet", _
                "IMPORT " + q + "r.dh" + q, _
                "PRINT mal(6, 7)", _
                "--- datei r.dh", _
                "IMPORT " + q + "{sammlung}/rechnen.dh" + q, _
                "", _
                "--- erwartet", _
                "42"]))
            liesmich = "Ein Konsolenprogramm: F5 startet es, Strg+Alt+F5 prüft rechnen.dh mit tests.dhtest."
        CASE ELSE
            WRITEALL(PATHJOIN(ziel, "main.dh"), npZeilen$(["' " + name, "PRINT " + q + "Hallo" + q]))
            liesmich = "Ein leeres Projekt."
    END SELECT
    WRITEALL(PATHJOIN(ziel, "LIESMICH.md"), "# " + name + NL + NL + liesmich + NL)
    projektOrdner = ziel
    baumFuellen()
    dateiOeffnen(PATHJOIN(ziel, "main.dh"))
    GUI_SET_TEXT(lblStatus, tr$("Neues Projekt: ") + ziel)
    protokoll("neues projekt " + STR$(art) + " " + name)
    RETURN TRUE
END FUNCTION

' --- Bilder und Klaenge ------------------------------------------------
' "bild" oder "klang" nach der Endung, sonst "".
FUNCTION assetArt$(pfad AS STRING) AS STRING
    DIM e AS STRING : e = LOWER$(pfad)
    DIM k AS STRING
    FOR EACH k IN (".png", ".jpg", ".jpeg", ".bmp", ".tga", ".gif")
        IF RIGHT$(e, LEN(k)) = k THEN RETURN "bild"
    NEXT
    FOR EACH k IN (".wav", ".ogg", ".mp3", ".flac")
        IF RIGHT$(e, LEN(k)) = k THEN RETURN "klang"
    NEXT
    RETURN ""
END FUNCTION

' Steht die Maus in einer Zeichenkette, die ein vorhandenes Bild nennt?
' Gesucht wird neben der Datei im Reiter (so laedt das Programm), dann im
' Projekt. Liefert den Weg oder "".
FUNCTION bildPfadBei$(ta AS GUI_WIDGET, zeile AS STRING, spalte AS INTEGER) AS STRING
    DIM i AS INTEGER : i = spalte - 1
    IF i < 0 OR i >= LEN(zeile) THEN RETURN ""
    DIM a AS INTEGER : a = -1
    DIM k AS INTEGER
    DIM drin AS BOOLEAN : drin = FALSE
    FOR k = 0 TO LEN(zeile) - 1
        DIM c AS STRING : c = MID$(zeile, k, 1)
        IF c = "'" AND NOT drin THEN RETURN ""
        IF c = CHR$(34) THEN
            IF drin THEN
                IF i > a AND i < k THEN
                    DIM text AS STRING : text = MID$(zeile, a + 1, k - a - 1)
                    IF assetArt$(text) <> "bild" THEN RETURN ""
                    DIM basis AS STRING : basis = projektOrdner
                    DIM t AS INTEGER
                    FOR t = 0 TO tabAnzahl - 1
                        IF (tabFelder[t] = ta OR ta = taSpiegel) AND t = aktiverTab AND tabPfade[t] <> "" THEN basis = DIRNAME(tabPfade[t])
                    NEXT
                    IF FILEEXISTS(PATHJOIN(basis, text)) THEN RETURN PATHJOIN(basis, text)
                    IF projektOrdner <> "" AND FILEEXISTS(PATHJOIN(projektOrdner, text)) THEN RETURN PATHJOIN(projektOrdner, text)
                    RETURN ""
                END IF
                drin = FALSE
            ELSE
                drin = TRUE
                a = k
            END IF
        END IF
    NEXT
    RETURN ""
END FUNCTION

DIM btPfad AS STRING : btPfad = ""
DIM btBild AS IMAGE : btBild = -1
DIM btRuhe AS INTEGER : btRuhe = 0

' Das Bild neben der Maus: erst nach einer kurzen Ruhe, weg, sobald die
' Maus die Zeichenkette verlaesst. Unten rechts neben dem Zeiger, damit das
' Fenster nicht unter der Maus liegt (sonst zaehlte das Code-Feld nicht
' mehr als ueberfahren und das Bild verschwaende gleich wieder).
SUB bildTippNachziehen(pfad AS STRING, mx AS INTEGER, my AS INTEGER)
    IF pfad = "" THEN
        IF GUI_WINDOW_SHOWN(winBildTipp) THEN GUI_WINDOW_VISIBLE(winBildTipp, FALSE)
        btPfad = "" : btRuhe = 0
        RETURN
    END IF
    IF pfad <> btPfad THEN
        btPfad = pfad : btRuhe = 0
        IF GUI_WINDOW_SHOWN(winBildTipp) THEN GUI_WINDOW_VISIBLE(winBildTipp, FALSE)
        RETURN
    END IF
    btRuhe = btRuhe + 1
    IF btRuhe <> TIPP_RUHE THEN RETURN
    IF btBild >= 0 THEN IMAGE_FREE(btBild)
    btBild = -1
    TRY
        btBild = LOADIMAGE(pfad)
    CATCH e
        btBild = -1
    END TRY
    IF btBild < 0 THEN RETURN
    GUI_SET_IMAGE(imgBildTipp, btBild)
    GUI_SET_TEXT(lblBildTipp, BASENAME(pfad) + "  " + STR$(IMAGEWIDTH(btBild)) + "x" + STR$(IMAGEHEIGHT(btBild)))
    DIM x AS INTEGER : x = MIN(mx + 18, SCREENWIDTH() - 190)
    DIM y AS INTEGER : y = my + 22
    IF y + 210 > SCREENHEIGHT() THEN y = my - 222
    GUI_WINDOW_SET_BOUNDS(winBildTipp, x, y, 180, 200)
    GUI_WINDOW_VISIBLE(winBildTipp, TRUE)
    protokoll("bildtipp " + BASENAME(pfad) + " " + STR$(IMAGEWIDTH(btBild)) + "x" + STR$(IMAGEHEIGHT(btBild)))
END SUB

' Die Vorschau eines Bildes oder Klangs aus dem Projekt.
DIM assetPfad AS STRING : assetPfad = ""
DIM assetBild AS IMAGE : assetBild = -1
DIM assetKlang AS SOUND
DIM assetKlangDa AS BOOLEAN : assetKlangDa = FALSE

SUB assetZeigen(pfad AS STRING)
    assetPfad = pfad
    IF assetBild >= 0 THEN IMAGE_FREE(assetBild) : assetBild = -1
    IF assetKlangDa THEN
        TRY
            STOPSOUND(assetKlang)
        CATCH e
        END TRY
        assetKlangDa = FALSE
    END IF
    GUI_WINDOW_TITLE(winAsset, tr$("Vorschau: ") + BASENAME(pfad))
    DIM art AS STRING : art = assetArt$(pfad)
    DIM groesse AS STRING : groesse = STR$(FILESIZE(pfad)) + " Bytes"
    IF FILESIZE(pfad) >= 1024 THEN groesse = STR$(INT(FILESIZE(pfad) / 1024.0 + 0.5)) + " KB"
    IF art = "bild" THEN
        TRY
            assetBild = LOADIMAGE(pfad)
        CATCH e
            assetBild = -1
        END TRY
        IF assetBild >= 0 THEN
            GUI_SET_IMAGE(imgAsset, assetBild)
            GUI_SET_TEXT(lblAsset, BASENAME(pfad) + " -- " + STR$(IMAGEWIDTH(assetBild)) + " x " + _
                         STR$(IMAGEHEIGHT(assetBild)) + " Punkte, " + groesse)
            protokoll("vorschau bild " + BASENAME(pfad) + " " + STR$(IMAGEWIDTH(assetBild)) + "x" + STR$(IMAGEHEIGHT(assetBild)))
        ELSE
            GUI_SET_IMAGE(imgAsset, btLeer)
            GUI_SET_TEXT(lblAsset, BASENAME(pfad) + tr$(" lässt sich nicht als Bild lesen."))
            protokoll("vorschau bild fehler")
        END IF
    ELSE
        GUI_SET_IMAGE(imgAsset, btLeer)
        TRY
            assetKlang = LOADSOUND(pfad)
            assetKlangDa = TRUE
        CATCH e
            assetKlangDa = FALSE
        END TRY
        IF assetKlangDa THEN
            GUI_SET_TEXT(lblAsset, BASENAME(pfad) + tr$(" -- Klang, ") + groesse + tr$(". [Abspielen] spielt ihn."))
            protokoll("vorschau klang " + BASENAME(pfad))
        ELSE
            GUI_SET_TEXT(lblAsset, BASENAME(pfad) + tr$(" -- Klang, ") + groesse + tr$(" (hier nicht abspielbar: keine Tonausgabe oder kein lesbares Format)."))
            protokoll("vorschau klang ohne ton")
        END IF
    END IF
    GUI_SET_VISIBLE(btnAssetSpielen, art = "klang")
    GUI_SET_VISIBLE(btnAssetStopp, art = "klang")
    GUI_WINDOW_VISIBLE(winAsset, TRUE)
    ' Ein Fenster ohne Fokus bliebe hinter dem Hauptfenster.
    GUI_FOCUS(btnAssetSystem)
END SUB

SUB assetNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winAsset) THEN RETURN
    IF GUI_CLICKED(btnAssetSpielen) AND assetKlangDa THEN
        TRY
            PLAYSOUND(assetKlang)
            protokoll("vorschau spielt")
        CATCH e
            GUI_SET_TEXT(lblAsset, tr$("Abspielen ging nicht: ") + e)
        END TRY
    END IF
    IF GUI_CLICKED(btnAssetStopp) AND assetKlangDa THEN
        TRY
            STOPSOUND(assetKlang)
        CATCH e
        END TRY
    END IF
    IF GUI_CLICKED(btnAssetSystem) AND assetPfad <> "" THEN
        TRY
            OPENDOC(assetPfad)
        CATCH e
            GUI_SET_TEXT(lblAsset, tr$("Lässt sich nicht mit dem System öffnen."))
        END TRY
    END IF
END SUB

' --- Ganzes Projekt pruefen --------------------------------------------
' Die Fehlerliste kennt nur die Datei im Reiter. Hier jede .dh des Projekts
' (samt Unterordnern, mit den Haken im Baum), offene Reiter mit dem Stand im
' Editor. In Schritten wie ein Umbau -- bei zweihundert Dateien stuende die
' IDE sonst Sekunden lang; ESC bricht ab, was schon da ist, bleibt stehen.
'
' Ein Fehler in einer importierten Datei meldet jede Datei, die sie
' importiert ("in lib.dh:2 -> ..."). Er steht EINMAL in der Liste, an seiner
' eigenen Stelle: der Schluessel ist (kanonischer Pfad, Zeile, Meldung).
' Hinweise (unbenutzte Variablen) zaehlen nicht, wie in der Fehlerliste.
CONST PRUEF_PRO_BILD = 8
DIM prjAktiv AS BOOLEAN : prjAktiv = FALSE
DIM prjDateien AS ARRAY OF STRING : prjDateien = []
DIM prjIndex AS INTEGER : prjIndex = 0
DIM prjFehler AS INTEGER : prjFehler = 0
DIM prjWarn AS INTEGER : prjWarn = 0
DIM prjGesehen AS MAP OF BOOLEAN
DIM prjMitBefund AS MAP OF BOOLEAN

SUB projektPruefenStarten()
    prjDateien = projektDateien("*.dh")
    IF LEN(prjDateien) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Projekt prüfen: keine .dh-Datei im Projekt."))
        protokoll("projekt geprueft 0 0 0 0")
        RETURN
    END IF
    GUI_LISTBOX_CLEAR(lstProbleme)
    sucheDateien = []
    sucheZeilen = []
    problemModus = 1
    prjIndex = 0 : prjFehler = 0 : prjWarn = 0
    prjGesehen = {}
    prjMitBefund = {}
    prjAktiv = TRUE
    GUI_SET_TEXT(lblProbleme, tr$("Projekt wird geprüft ..."))
    GUI_SET_TEXT(lblStatus, tr$("Prüfe ... 0 von ") + STR$(LEN(prjDateien)) + tr$(" Dateien (ESC bricht ab)"))
END SUB

SUB projektPruefenAbbrechen()
    prjAktiv = FALSE
    projektPruefenBilanz(TRUE)
END SUB

' Eine Meldung in die Liste -- `d` relativ zum Projekt, wie in der Suche.
SUB projektBefund(d AS STRING, zeile AS INTEGER, meldung AS STRING, art AS STRING)
    DIM schluessel AS STRING : schluessel = LOWER$(wegGleich$(PATHJOIN(projektOrdner, d)))
    TRY
        schluessel = LOWER$(wegGleich$(REALPATH$(PATHJOIN(projektOrdner, d))))
    CATCH e
    END TRY
    schluessel = schluessel + "|" + STR$(zeile) + "|" + meldung
    IF MAPHAS(prjGesehen, schluessel) THEN RETURN
    MAPPUT(prjGesehen, schluessel, TRUE)
    MAPPUT(prjMitBefund, d, TRUE)
    ARRAY_PUSH(sucheDateien, d)
    ARRAY_PUSH(sucheZeilen, zeile)
    GUI_LISTBOX_ADD(lstProbleme, d + ":" + STR$(zeile) + ": " + meldung)
    IF art = "fehler" THEN
        GUI_LISTBOX_COLOR(lstProbleme, LEN(sucheZeilen) - 1, &HE06060)
        prjFehler = prjFehler + 1
    ELSE
        GUI_LISTBOX_COLOR(lstProbleme, LEN(sucheZeilen) - 1, &HE0C060)
        prjWarn = prjWarn + 1
    END IF
END SUB

SUB projektPruefenSchritt()
    IF NOT prjAktiv THEN RETURN
    DIM bis AS INTEGER : bis = MIN(prjIndex + PRUEF_PRO_BILD, LEN(prjDateien))
    DIM i AS INTEGER
    FOR i = prjIndex TO bis - 1
        DIM d AS STRING : d = prjDateien[i]
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM t AS INTEGER : t = tabMitPfad(pfad)
        DIM quelle AS STRING : quelle = ""
        IF t >= 0 THEN
            quelle = GUI_TEXT(tabFelder[t])
        ELSE
            TRY
                quelle = dateiLesen(pfad)
            CATCH e
                CONTINUE
            END TRY
        END IF
        DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_CHECK$(quelle, DIRNAME(pfad)))
        DIM n AS INTEGER : n = JSON_LEN(j, "")
        DIM k AS INTEGER
        FOR k = 0 TO n - 1
            DIM p AS STRING : p = STR$(k)
            DIM art AS STRING : art = JSON_GET_STRING(j, p + ".schwere")
            IF art = "hinweis" THEN CONTINUE
            DIM m AS STRING : m = JSON_GET_STRING(j, p + ".meldung")
            DIM zeile AS INTEGER : zeile = JSON_GET_INT(j, p + ".zeile")
            DIM wo AS STRING : wo = d
            ' "in lib.dh:2 -> Meldung": an die Stelle in der importierten Datei.
            DIM pf AS INTEGER : pf = INSTR(m, " -> ")
            IF LEFT$(m, 3) = "in " AND pf > 3 THEN
                DIM ort AS STRING : ort = MID$(m, 3, pf - 3)
                DIM dp AS INTEGER : dp = -1
                DIM q AS INTEGER
                FOR q = LEN(ort) - 1 TO 0 STEP -1
                    IF MID$(ort, q, 1) = ":" THEN dp = q : BREAK
                NEXT
                IF dp > 0 AND VAL(MID$(ort, dp + 1, 10)) > 0 THEN
                    DIM rel AS STRING : rel = MID$(ort, 0, dp)
                    IF DIRNAME(d) <> "" AND DIRNAME(d) <> "." THEN rel = PATHJOIN(DIRNAME(d), rel)
                    wo = rel
                    zeile = VAL(MID$(ort, dp + 1, 10))
                    m = MID$(m, pf + 4, LEN(m))
                END IF
            END IF
            projektBefund(wo, zeile, m, art)
        NEXT
    NEXT
    prjIndex = bis
    IF prjIndex < LEN(prjDateien) THEN
        GUI_SET_TEXT(lblStatus, tr$("Prüfe ... ") + STR$(prjIndex) + tr$(" von ") + STR$(LEN(prjDateien)) + _
                     " Dateien (ESC bricht ab)")
        RETURN
    END IF
    prjAktiv = FALSE
    projektPruefenBilanz(FALSE)
END SUB

SUB projektPruefenBilanz(abgebrochen AS BOOLEAN)
    DIM betroffen AS INTEGER : betroffen = 0
    DIM kk AS STRING
    FOR EACH kk IN prjMitBefund
        betroffen = betroffen + 1
    NEXT
    DIM was AS STRING
    IF prjFehler + prjWarn = 0 THEN
        was = "Projekt: keine Probleme in " + STR$(prjIndex) + " Dateien"
    ELSE
        was = "Projekt: " + STR$(prjFehler) + " Fehler, " + STR$(prjWarn) + " Warnungen in " + _
              STR$(betroffen) + " von " + STR$(prjIndex) + " Dateien"
    END IF
    IF abgebrochen THEN was = was + " (abgebrochen)"
    GUI_SET_TEXT(lblProbleme, was + tr$(" -- Umschalt+F7 zeigt wieder die Probleme der Datei"))
    GUI_SET_TEXT(lblStatus, was + ".")
    protokoll("projekt geprueft " + STR$(prjFehler) + " " + STR$(prjWarn) + " " + STR$(betroffen) + " " + _
              STR$(prjIndex) + IIF(abgebrochen, " abgebrochen", ""))
END SUB

' --- Alle Fundstellen eines Namens ------------------------------------
' "Wer ruft das auf?" kennt nur Unterprogramme. Hier jeder Name: eine
' Variable, eine Konstante, ein Feld. Gezaehlt wird jede Zeile, in der er
' als GANZES Wort steht, ausserhalb von Zeichenketten und Kommentaren
' (`benutztWort`) -- dieselbe Frage, die das Verschieben fuer den IMPORT
' stellt. Offene Reiter zaehlen mit dem Stand im Editor. Das ist Text,
' keine Namensaufloesung: eine lokale `i` in zwei Unterprogrammen sind
' zwei Namen, hier aber eine Liste -- die Datei und die Zeile stehen dabei.
SUB fundstellenZeigen()
    DIM name AS STRING : name = wortUnterMarke$()
    IF name = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Fundstellen: unter der Marke steht kein Name."))
        protokoll("fundstellen 0")
        RETURN
    END IF
    GUI_LISTBOX_CLEAR(lstProbleme)
    DIM dateien AS ARRAY OF STRING : dateien = projektDateien("*.dh")
    DIM sd AS ARRAY OF STRING : sd = []
    DIM sz AS ARRAY OF INTEGER : sz = []
    DIM treffer AS INTEGER : treffer = 0
    DIM inDateien AS INTEGER : inDateien = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM t AS INTEGER : t = tabMitPfad(pfad)
        DIM quelle AS STRING : quelle = ""
        IF t >= 0 THEN
            quelle = GUI_TEXT(tabFelder[t])
        ELSE
            TRY
                quelle = dateiLesen(pfad)
            CATCH e
                CONTINUE
            END TRY
        END IF
        DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
        DIM vorher AS INTEGER : vorher = treffer
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            IF treffer >= 500 THEN BREAK
            ' Namen sind schreibungsunabhaengig: `Punkte` und `punkte` sind
            ' dieselbe Variable.
            IF benutztWort(LOWER$(zeilen[i]), LOWER$(name)) THEN
                ARRAY_PUSH(sd, d)
                ARRAY_PUSH(sz, i + 1)
                GUI_LISTBOX_ADD(lstProbleme, d + ":" + STR$(i + 1) + ": " + TRIM$(zeilen[i]))
                treffer = treffer + 1
            END IF
        NEXT
        IF treffer > vorher THEN inDateien = inDateien + 1
    NEXT
    sucheDateien = sd
    sucheZeilen = sz
    problemModus = 1
    GUI_SET_TEXT(lblProbleme, tr$("Fundstellen von '") + name + "': " + STR$(treffer) + tr$(" in ") + STR$(inDateien) + tr$(" Dateien -- Umschalt+F7 zeigt wieder die Probleme"))
    GUI_SET_TEXT(lblStatus, STR$(treffer) + tr$(" Fundstelle(n) von '") + name + "'.")
    protokoll("fundstellen " + name + " " + STR$(treffer) + " " + STR$(inDateien))
END SUB

' --- Haltepunkte und Marken in der Nummernspalte ---------------------
' --- Wer hat das geschrieben? (git blame) -----------------------------
' Die Trefferliste unten rechts, wie die Projektsuche -- ein eigener
' Bereich waere ein zweites Panel fuer dieselbe Frage "welche Zeile?".
' `git blame` laeuft synchron ueber SHELL_OUT$: eine Datei dauert
' Millisekunden, und ein eigener Prozess mit Warteschlange waere hier
' mehr Buchfuehrung als Nutzen.
SUB blameZeigen()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Git-Blame: die Datei ist noch nicht gesichert."))
        RETURN
    END IF
    DIM ausgabe AS STRING : ausgabe = ""
    TRY
        ausgabe = SHELL_OUT$("git", "-C", DIRNAME(pfad), "blame", "--date=short", "-w", "--", BASENAME(pfad))
    CATCH e
        ausgabe = ""
    END TRY
    IF TRIM$(ausgabe) = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Git-Blame: keine Antwort -- liegt die Datei in einem git-Verzeichnis, und ist `git` da?"))
        protokoll("blame 0")
        RETURN
    END IF
    GUI_LISTBOX_CLEAR(lstProbleme)
    DIM sd AS ARRAY OF STRING : sd = []
    DIM sz AS ARRAY OF INTEGER : sz = []
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(ausgabe, NL)
    DIM n AS INTEGER : n = 0
    DIM z AS STRING
    FOR EACH z IN zeilen
        z = RTRIM$(z)
        IF z = "" THEN CONTINUE
        ' Format: <hash> (<Wer>  <Datum> <Zeile>) <Quelltext>
        DIM auf AS INTEGER : auf = INSTR(z, "(")
        DIM zu AS INTEGER : zu = INSTR(z, ")")
        IF auf < 0 OR zu <= auf THEN CONTINUE
        DIM kopf AS STRING : kopf = TRIM$(MID$(z, auf + 1, zu - auf - 1))
        DIM felder AS ARRAY OF STRING : felder = SPLIT$(kopf, " ")
        DIM nr AS INTEGER : nr = 0
        DIM wer AS STRING : wer = ""
        DIM datum AS STRING : datum = ""
        DIM k AS INTEGER
        FOR k = 0 TO LEN(felder) - 1
            IF felder[k] = "" THEN CONTINUE
            IF k = LEN(felder) - 1 THEN
                nr = INT(VAL(felder[k]))
            ELSEIF LEN(felder[k]) = 10 AND MID$(felder[k], 4, 1) = "-" THEN
                datum = felder[k]
            ELSE
                wer = TRIM$(wer + " " + felder[k])
            END IF
        NEXT
        IF nr <= 0 THEN CONTINUE
        n = n + 1
        ARRAY_PUSH(sd, BASENAME(pfad))
        ARRAY_PUSH(sz, nr)
        GUI_LISTBOX_ADD(lstProbleme, PADL$(STR$(nr), 5) + "  " + datum + "  " + wer + "  " + TRIM$(MID$(z, zu + 1, LEN(z))))
    NEXT
    sucheDateien = sd
    sucheZeilen = sz
    problemModus = 1
    GUI_SET_TEXT(lblProbleme, tr$("git blame ") + BASENAME(pfad) + ": " + STR$(n) + tr$(" Zeilen -- Umschalt+F7 zeigt wieder die Probleme"))
    protokoll("blame " + STR$(n))
END SUB

' `git` fuer die aktive Datei laufen lassen -- leer, wenn es nicht geht.
' Synchron ueber SHELL_OUT$: eine Datei dauert Millisekunden.
' Liegt ein Ordner in einem git-Repository? Einmal je Ordner gefragt und
' gemerkt. Ausserhalb faellt `git diff` in den Vergleich zweier Dateien
' und schreibt seine Hilfe auf die Konsole -- bei JEDEM Sichern.
DIM gitRepoOrdner AS STRING : gitRepoOrdner = "-"
DIM gitRepoJa AS BOOLEAN : gitRepoJa = FALSE
FUNCTION gitRepo(ordner AS STRING) AS BOOLEAN
    IF ordner = gitRepoOrdner THEN RETURN gitRepoJa
    gitRepoOrdner = ordner
    gitRepoJa = FALSE
    ' Ohne Prozess: `.git` aufwaerts suchen (ein Ordner, oder in einem
    ' Arbeitsbaum eine Datei).
    DIM d AS STRING : d = ordner
    DIM schritte AS INTEGER : schritte = 0
    WHILE d <> "" AND schritte < 64
        IF DIREXISTS(PATHJOIN(d, ".git")) OR FILEEXISTS(PATHJOIN(d, ".git")) THEN gitRepoJa = TRUE : EXIT WHILE
        DIM oben AS STRING : oben = DIRNAME(d)
        IF oben = d THEN EXIT WHILE
        d = oben
        schritte = schritte + 1
    WEND
    RETURN gitRepoJa
END FUNCTION

FUNCTION gitAusgabe$(erst AS STRING, zweit AS STRING, dritt AS STRING) AS STRING
    IF aktiverTab < 0 THEN RETURN ""
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN RETURN ""
    TRY
        IF dritt = "" THEN
            RETURN SHELL_OUT$("git", "-C", DIRNAME(pfad), erst, zweit, "--", BASENAME(pfad))
        END IF
        RETURN SHELL_OUT$("git", "-C", DIRNAME(pfad), erst, zweit, dritt, "--", BASENAME(pfad))
    CATCH e
        RETURN ""
    END TRY
END FUNCTION

' Diff und Verlauf im selben Fenster: es ist dieselbe Frage ("was ist mit
' dieser Datei passiert?"), nur einmal seit dem letzten Sichern und einmal
' ueber die Zeit.
SUB gitZeigen(art AS STRING)
    IF aktiverTab < 0 OR tabPfade[aktiverTab] = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("git: die Datei ist noch nicht gesichert."))
        RETURN
    END IF
    DIM text AS STRING
    IF art = "diff" THEN
        text = gitAusgabe$("diff", "--no-color", "")
        IF TRIM$(text) = "" THEN text = gitAusgabe$("diff", "--no-color", "--staged")
    ELSE
        text = gitAusgabe$("log", "--no-color", "--pretty=format:%h  %ad  %an%n    %s%n")
    END IF
    IF TRIM$(text) = "" THEN
        GUI_SET_TEXT(lblStatus, IIF(art = "diff", tr$("git diff: keine Änderungen an dieser Datei."), tr$("git log: kein Verlauf -- liegt sie in einem git-Verzeichnis?")))
        protokoll("git " + art + " 0")
        RETURN
    END IF
    GUI_SET_TEXT(taGit, text)
    GUI_WINDOW_TITLE(winGit, IIF(art = "diff", tr$("Änderungen"), tr$("Verlauf")) + ": " + BASENAME(tabPfade[aktiverTab]))
    GUI_SET_TEXT(lblGit, STR$(LEN(SPLIT$(text, NL))) + tr$(" Zeilen"))
    GUI_WINDOW_VISIBLE(winGit, TRUE)
    GUI_FOCUS(taGit)
    gitFaerben()
    protokoll("git " + art + " " + STR$(LEN(SPLIT$(text, NL))))
END SUB

' Ein Diff liest sich nur mit Farbe: Zugaenge gruen, Abgaenge rot, die
' @@-Koepfe blau. Zeilenweise ueber die Abschnitte, wie im Code-Feld.
SUB gitFaerben()
    diffFaerben(taGit)
END SUB

' Dieselbe Faerbung fuer das git-Fenster und die Umbau-Vorschau: ein
' Unterschied sieht ueberall gleich aus, sonst muss man ihn zweimal lernen.
SUB diffFaerben(ta AS GUI_WIDGET)
    DIM text AS STRING : text = GUI_TEXT(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(text, NL)
    DIM s AS ARRAY OF INTEGER : s = []
    DIM l AS ARRAY OF INTEGER : l = []
    DIM f AS ARRAY OF INTEGER : f = []
    DIM pos AS INTEGER : pos = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM z AS STRING : z = zeilen[i]
        DIM farbe AS INTEGER : farbe = -1
        IF LEFT$(z, 2) = "@@" THEN
            farbe = &H60B0E0
        ELSEIF LEFT$(z, 3) = "+++" OR LEFT$(z, 3) = "---" THEN
            farbe = &H90A0B0
        ELSEIF LEFT$(z, 1) = "+" THEN
            farbe = &H70D080
        ELSEIF LEFT$(z, 1) = "-" THEN
            farbe = &HE07070
        ELSEIF LEFT$(z, 1) = "~" THEN
            farbe = &H707880        ' ausgelassen: steht da, zaehlt nicht
        ELSEIF LEN(z) >= 7 AND MID$(z, 7, 1) = " " AND LEFT$(z, 1) <> " " THEN
            farbe = &HE0C060        ' die Kennung einer Uebergabe im Verlauf
        END IF
        IF farbe >= 0 AND LEN(z) > 0 THEN
            ARRAY_PUSH(s, pos) : ARRAY_PUSH(l, LEN(z)) : ARRAY_PUSH(f, farbe)
        END IF
        pos = pos + LEN(z) + 1
    NEXT
    GUI_TEXTAREA_SPANS(ta, s, l, f)
END SUB

' Die geaenderten Zeilen am Rand: `git diff -U0` nennt sie in den
' @@-Koepfen (`@@ -alt,n +neu,m @@`). Nur die NEUE Seite zaehlt -- was
' geloescht wurde, steht in der Datei nicht mehr.
DIM gitZeilen AS ARRAY OF INTEGER : gitZeilen = []
DIM gitDateiStand AS STRING : gitDateiStand = "-"

SUB gitRandNachziehen(erzwingen AS BOOLEAN)
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF NOT gitRandAn OR pfad = "" THEN
        IF LEN(gitZeilen) > 0 THEN gitZeilen = [] : markenSchluessel = ""
        RETURN
    END IF
    ' Nur nach dem Sichern oder Oeffnen neu fragen: ein Prozessstart je
    ' Bild waere die IDE zum Stillstand gebracht.
    DIM stand AS STRING : stand = pfad + "|" + STR$(LEN(tabGesichert[aktiverTab]))
    IF NOT erzwingen AND stand = gitDateiStand THEN RETURN
    gitDateiStand = stand
    IF NOT gitRepo(DIRNAME(pfad)) THEN
        IF LEN(gitZeilen) > 0 THEN gitZeilen = [] : markenSchluessel = ""
        RETURN
    END IF
    DIM text AS STRING : text = gitAusgabe$("diff", "--no-color", "-U0")
    DIM neu AS ARRAY OF INTEGER : neu = []
    DIM z AS STRING
    FOR EACH z IN SPLIT$(text, NL)
        IF LEFT$(z, 2) <> "@@" THEN CONTINUE
        DIM p AS INTEGER : p = INSTR(z, "+")
        IF p < 0 THEN CONTINUE
        DIM rest AS STRING : rest = MID$(z, p + 1, LEN(z))
        DIM ende AS INTEGER : ende = INSTR(rest, " ")
        IF ende >= 0 THEN rest = LEFT$(rest, ende)
        DIM komma AS INTEGER : komma = INSTR(rest, ",")
        DIM von AS INTEGER : von = INT(VAL(IIF(komma >= 0, LEFT$(rest, komma), rest)))
        DIM anzahl AS INTEGER : anzahl = 1
        IF komma >= 0 THEN anzahl = INT(VAL(MID$(rest, komma + 1, LEN(rest))))
        DIM k AS INTEGER
        FOR k = 0 TO MIN(anzahl, 2000) - 1
            ARRAY_PUSH(neu, von + k)
        NEXT
    NEXT
    gitZeilen = neu
    markenSchluessel = ""
    protokoll("git rand " + STR$(LEN(neu)))
END SUB

' Die Haltepunkt-Felder gehen nur hier hinein und hinaus -- vier Felder,
' die gleich lang bleiben muessen.
SUB hpNeu(pfad AS STRING, z AS INTEGER, bed AS STRING)
    hpAuffuellen()
    ARRAY_PUSH(hpDateien, pfad) : ARRAY_PUSH(hpZeilen, z) : ARRAY_PUSH(hpBedingungen, bed)
    ARRAY_PUSH(hpAktiv, TRUE) : ARRAY_PUSH(hpTreffer, "") : ARRAY_PUSH(hpLog, "")
END SUB

SUB hpEntfernen(k AS INTEGER)
    hpAuffuellen()
    ARRAY_REMOVE_AT(hpDateien, k) : ARRAY_REMOVE_AT(hpZeilen, k) : ARRAY_REMOVE_AT(hpBedingungen, k)
    ARRAY_REMOVE_AT(hpAktiv, k) : ARRAY_REMOVE_AT(hpTreffer, k) : ARRAY_REMOVE_AT(hpLog, k)
END SUB

' Die Zusatzfelder so lang wie die Zeilen (Stand aus einer alten ide.json).
SUB hpAuffuellen()
    WHILE LEN(hpAktiv) < LEN(hpZeilen) : ARRAY_PUSH(hpAktiv, TRUE) : WEND
    WHILE LEN(hpTreffer) < LEN(hpZeilen) : ARRAY_PUSH(hpTreffer, "") : WEND
    WHILE LEN(hpLog) < LEN(hpZeilen) : ARRAY_PUSH(hpLog, "") : WEND
END SUB

FUNCTION hpTreffer$(k AS INTEGER) AS STRING
    IF k >= LEN(hpTreffer) THEN RETURN ""
    RETURN hpTreffer[k]
END FUNCTION

FUNCTION hpLog$(k AS INTEGER) AS STRING
    IF k >= LEN(hpLog) THEN RETURN ""
    RETURN hpLog[k]
END FUNCTION

FUNCTION hpIstAktiv(k AS INTEGER) AS BOOLEAN
    IF k >= LEN(hpAktiv) THEN RETURN TRUE
    RETURN hpAktiv[k]
END FUNCTION

FUNCTION haltepunktIndex(pfad AS STRING, zeile AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF hpDateien[i] = pfad AND hpZeilen[i] = zeile THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB haltepunktUmschalten()
    IF aktiverTab < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    haltepunktUmschaltenIn(tabPfade[aktiverTab], z)
END SUB

' Derselbe Schalter fuer eine BESTIMMTE Zeile -- F9 nimmt die der Marke,
' ein Klick in die Nummernspalte die angeklickte (die Marke bleibt dabei,
' wo sie ist).
SUB haltepunktUmschaltenIn(pfad AS STRING, z AS INTEGER)
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, tr$("Erst sichern -- Haltepunkte gehören zu einer Datei.")) : RETURN
    DIM k AS INTEGER : k = haltepunktIndex(pfad, z)
    IF k >= 0 THEN
        hpEntfernen(k)
        protokoll("haltepunkt " + STR$(z) + " aus")
    ELSE
        hpNeu(pfad, z, "")
        protokoll("haltepunkt " + STR$(z) + " an")
    END IF
    ' Laeuft der Debugger, gilt es sofort -- auch waehrend des Laufens und
    ' auch fuer eine importierte Datei.
    IF prozessArt = "debug" AND prozess >= 0 THEN debugHaltepunkteSenden()
END SUB

' Umschalt+F9: ein Haltepunkt, der nur haelt, wenn ein Ausdruck wahr ist
' (`i = 3`, `hp < 10`). Der Debugger-Kern kennt das schon (`conditions` im
' set-breakpoints-Kommando), die IDE fragt nur nach dem Ausdruck.
SUB haltepunktBedingungFragen()
    IF aktiverTab < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    haltepunktBedingungFragenIn(tabPfade[aktiverTab], z)
END SUB

SUB haltepunktBedingungFragenIn(pfad AS STRING, z AS INTEGER)
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, tr$("Erst sichern -- Haltepunkte gehören zu einer Datei.")) : RETURN
    bedingungZeile = z
    bedingungPfad = pfad
    DIM vorgabe AS STRING : vorgabe = ""
    DIM k AS INTEGER : k = haltepunktIndex(pfad, bedingungZeile)
    IF k >= 0 THEN vorgabe = hpBedingungen[k]
    dlgBedingung = GUI_PROMPT(tr$("Bedingter Haltepunkt"), tr$("Halten in Zeile ") + STR$(bedingungZeile) + tr$(", wenn (leer = immer):"), vorgabe)
END SUB

SUB haltepunktBedingungSetzen(ausdruck AS STRING)
    DIM pfad AS STRING : pfad = bedingungPfad
    IF pfad = "" THEN RETURN
    DIM k AS INTEGER : k = haltepunktIndex(pfad, bedingungZeile)
    IF k < 0 THEN
        hpNeu(pfad, bedingungZeile, TRIM$(ausdruck))
    ELSE
        hpBedingungen[k] = TRIM$(ausdruck)
    END IF
    IF TRIM$(ausdruck) = "" THEN
        protokoll("haltepunkt " + STR$(bedingungZeile) + " an")
    ELSE
        protokoll("haltepunkt " + STR$(bedingungZeile) + " bedingt " + TRIM$(ausdruck))
    END IF
    markenSchluessel = ""
    IF prozessArt = "debug" AND prozess >= 0 THEN debugHaltepunkteSenden()
END SUB

' --- Haltepunkt-Liste --------------------------------------------------
' Eine Zeile Quelltext -- aus dem offenen Reiter, sonst von der Platte.
FUNCTION zeileAusDatei$(pfad AS STRING, z AS INTEGER) AS STRING
    DIM text AS STRING : text = ""
    DIM t AS INTEGER : t = tabMitPfad(pfad)
    IF t >= 0 THEN
        text = GUI_TEXT(tabFelder[t])
    ELSE
        TRY
            text = dateiLesen(pfad)
        CATCH e
            RETURN ""
        END TRY
    END IF
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(text, NL)
    IF z >= 1 AND z <= LEN(zeilen) THEN RETURN TRIM$(zeilen[z - 1])
    RETURN ""
END FUNCTION

SUB haltepunkteListeZeigen()
    hpListeStand = "-"
    haltepunkteListeFuellen()
    GUI_WINDOW_VISIBLE(winHp, TRUE)
    GUI_FOCUS(lstHp)            ' holt das Fenster vor das Hauptfenster
    protokoll("haltepunkte liste " + STR$(LEN(hpZeilen)))
END SUB

' Neu fuellen, wenn sich etwas geaendert hat (auch von aussen: F9 im Code,
' ein gerutschter Haltepunkt) -- die Auswahl bleibt stehen.
SUB haltepunkteListeFuellen()
    DIM stand AS STRING : stand = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        stand = stand + hpDateien[i] + ":" + STR$(hpZeilen[i]) + ":" + hpBedingungen[i] + ":" + IIF(hpIstAktiv(i), "1", "0") + ":" + hpTreffer$(i) + ":" + hpLog$(i) + "|"
    NEXT
    IF stand = hpListeStand THEN RETURN
    hpListeStand = stand
    DIM wahl AS INTEGER : wahl = GUI_LISTBOX_SELECTED(lstHp)
    GUI_LISTBOX_CLEAR(lstHp)
    DIM dateien AS ARRAY OF STRING : dateien = []
    FOR i = 0 TO LEN(hpZeilen) - 1
        DIM eintrag AS STRING : eintrag = BASENAME(hpDateien[i]) + ":" + STR$(hpZeilen[i])
        IF hpBedingungen[i] <> "" THEN eintrag = eintrag + "   wenn " + hpBedingungen[i]
        IF hpTreffer$(i) <> "" THEN eintrag = eintrag + "   Treffer " + hpTreffer$(i)
        IF hpLog$(i) <> "" THEN eintrag = eintrag + "   schreibt: " + hpLog$(i)
        GUI_LISTBOX_ADD(lstHp, eintrag)
        GUI_LISTBOX_SET_CHECKED(lstHp, i, hpIstAktiv(i))
        GUI_LISTBOX_DETAIL(lstHp, i, zeileAusDatei$(hpDateien[i], hpZeilen[i]))
        IF ARRAY_INDEXOF(dateien, hpDateien[i]) < 0 THEN ARRAY_PUSH(dateien, hpDateien[i])
    NEXT
    IF wahl >= 0 AND wahl < LEN(hpZeilen) THEN GUI_LISTBOX_SET_SELECTED(lstHp, wahl)
    GUI_SET_TEXT(lblHp, STR$(LEN(hpZeilen)) + IIF(LEN(hpZeilen) = 1, tr$(" Haltepunkt in "), tr$(" Haltepunkte in ")) + STR$(LEN(dateien)) + IIF(LEN(dateien) = 1, tr$(" Datei"), tr$(" Dateien")) + tr$(" -- das Kästchen schaltet einen an und aus, Doppelklick springt hin"))
END SUB

' Trefferzahl setzen: nur lesbare Angaben, sonst sagt es die Statuszeile.
SUB haltepunktTrefferSetzen(k AS INTEGER, text AS STRING)
    IF k < 0 OR k >= LEN(hpZeilen) THEN RETURN
    hpAuffuellen()
    DIM t AS STRING : t = TRIM$(text)
    IF t <> "" AND NOT REGEX_TEST(t, "^(%|>=|==|=)?\s*[1-9][0-9]*$") THEN
        GUI_SET_TEXT(lblStatus, tr$("Trefferzahl: eine Zahl ab 1, davor wahlweise = oder % (") + t + tr$(" passt nicht)."))
        RETURN
    END IF
    hpTreffer[k] = t
    protokoll("haltepunkt " + STR$(hpZeilen[k]) + " treffer " + t)
END SUB

SUB haltepunktLogSetzen(k AS INTEGER, text AS STRING)
    IF k < 0 OR k >= LEN(hpZeilen) THEN RETURN
    hpAuffuellen()
    hpLog[k] = TRIM$(text)
    protokoll("haltepunkt " + STR$(hpZeilen[k]) + " schreibt " + TRIM$(text))
END SUB

' Nach jeder Aenderung: Marken neu, und ein laufender Debugger erfaehrt es.
SUB haltepunkteGeaendert()
    markenSchluessel = ""
    IF prozessArt = "debug" AND prozess >= 0 THEN debugHaltepunkteSenden()
END SUB

SUB haltepunkteListeNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winHp) THEN RETURN
    haltepunkteListeFuellen()
    DIM i AS INTEGER
    DIM anders AS BOOLEAN : anders = FALSE
    FOR i = 0 TO MIN(GUI_LISTBOX_COUNT(lstHp), LEN(hpZeilen)) - 1
        IF GUI_LISTBOX_CHECKED(lstHp, i) <> hpIstAktiv(i) THEN
            WHILE LEN(hpAktiv) < LEN(hpZeilen) : ARRAY_PUSH(hpAktiv, TRUE) : WEND
            hpAktiv[i] = GUI_LISTBOX_CHECKED(lstHp, i)
            protokoll("haltepunkt " + STR$(hpZeilen[i]) + IIF(hpAktiv[i], " eingeschaltet", " ausgeschaltet"))
            anders = TRUE
        END IF
    NEXT
    DIM w AS INTEGER : w = GUI_LISTBOX_SELECTED(lstHp)
    IF GUI_DOUBLE_CLICKED(lstHp) OR GUI_CLICKED(btnHpSpringen) THEN
        IF w >= 0 AND w < LEN(hpZeilen) THEN
            dateiOeffnen(hpDateien[w])
            DIM ta AS GUI_WIDGET : ta = aktivesFeld()
            IF ta >= 0 THEN GUI_TEXTAREA_GOTO(ta, hpZeilen[w], 1) : GUI_FOCUS(ta)
            protokoll("haltepunkt sprung " + BASENAME(hpDateien[w]) + " " + STR$(hpZeilen[w]))
        END IF
    END IF
    IF GUI_CLICKED(btnHpBed) AND w >= 0 AND w < LEN(hpZeilen) THEN haltepunktBedingungFragenIn(hpDateien[w], hpZeilen[w])
    IF GUI_CLICKED(btnHpTreffer) AND w >= 0 AND w < LEN(hpZeilen) THEN
        hpBearbeitet = w
        dlgTreffer = GUI_PROMPT(tr$("Trefferzahl"), tr$("Halten in ") + BASENAME(hpDateien[w]) + ":" + STR$(hpZeilen[w]) + tr$(" erst ... (5 = ab dem 5. Mal, =5 genau, %5 jedes 5. Mal, leer = immer):"), hpTreffer$(w))
    END IF
    IF GUI_CLICKED(btnHpLog) AND w >= 0 AND w < LEN(hpZeilen) THEN
        hpBearbeitet = w
        dlgLog = GUI_PROMPT(tr$("Protokollpunkt"), tr$("Statt anzuhalten schreiben (Ausdrücke in {}, z. B. i = {i}; leer = anhalten):"), hpLog$(w))
    END IF
    IF dlgTreffer <> 0 THEN
        DIM at AS INTEGER : at = GUI_ANSWER(dlgTreffer)
        IF at = 1 THEN haltepunktTrefferSetzen(hpBearbeitet, GUI_DIALOG_TEXT(dlgTreffer)) : anders = TRUE
        IF at <> 0 THEN dlgTreffer = 0
    END IF
    IF dlgLog <> 0 THEN
        DIM al AS INTEGER : al = GUI_ANSWER(dlgLog)
        IF al = 1 THEN haltepunktLogSetzen(hpBearbeitet, GUI_DIALOG_TEXT(dlgLog)) : anders = TRUE
        IF al <> 0 THEN dlgLog = 0
    END IF
    IF GUI_CLICKED(btnHpWeg) AND w >= 0 AND w < LEN(hpZeilen) THEN
        protokoll("haltepunkt " + STR$(hpZeilen[w]) + " aus")
        hpEntfernen(w)
        anders = TRUE
    END IF
    IF GUI_CLICKED(btnHpAn) OR GUI_CLICKED(btnHpAus) THEN
        DIM an AS BOOLEAN : an = GUI_CLICKED(btnHpAn)
        hpAktiv = []
        FOR i = 0 TO LEN(hpZeilen) - 1
            ARRAY_PUSH(hpAktiv, an)
        NEXT
        protokoll("haltepunkte alle " + IIF(an, "an", "aus"))
        anders = TRUE
    END IF
    IF GUI_CLICKED(btnHpAlleWeg) THEN
        hpDateien = [] : hpZeilen = [] : hpBedingungen = [] : hpAktiv = [] : hpTreffer = [] : hpLog = []
        protokoll("haltepunkte alle entfernt")
        anders = TRUE
    END IF
    IF anders THEN
        haltepunkteListeFuellen()
        haltepunkteGeaendert()
    END IF
END SUB

' --- Lesezeichen -------------------------------------------------------
FUNCTION lesezeichenIndex(pfad AS STRING, zeile AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lzZeilen) - 1
        IF lzDateien[i] = pfad AND lzZeilen[i] = zeile THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB lesezeichenUmschalten()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    DIM k AS INTEGER : k = lesezeichenIndex(pfad, z)
    IF k >= 0 THEN
        ARRAY_REMOVE_AT(lzDateien, k) : ARRAY_REMOVE_AT(lzZeilen, k)
        protokoll("lesezeichen " + STR$(z) + " aus")
    ELSE
        ARRAY_PUSH(lzDateien, pfad) : ARRAY_PUSH(lzZeilen, z)
        protokoll("lesezeichen " + STR$(z) + " an")
    END IF
    markenSchluessel = ""
END SUB

' F2: zum naechsten Lesezeichen hinter der Marke, am Ende wieder von vorn.
' Lesezeichen der Reihe nach -- ueber DATEIEN hinweg: erst die restlichen
' in dieser Datei, dann die naechste Datei, die eins hat. Ein Lesezeichen,
' das man nur in seiner Datei wiederfindet, ist eins zu wenig.
SUB lesezeichenSpringen(vorwaerts AS BOOLEAN)
    IF aktiverTab < 0 THEN RETURN
    IF LEN(lzZeilen) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Kein Lesezeichen gesetzt -- Strg+F2 setzt eins."))
        RETURN
    END IF
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    ' Alle Marken in EINE Reihenfolge bringen: erst nach Datei, dann nach
    ' Zeile. So ist "das naechste" auch ueber die Dateigrenze eindeutig.
    DIM reihe AS ARRAY OF INTEGER : reihe = []
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO LEN(lzZeilen) - 1
        DIM platz AS INTEGER : platz = LEN(reihe)
        FOR k = 0 TO LEN(reihe) - 1
            DIM j AS INTEGER : j = reihe[k]
            IF lzDateien[j] > lzDateien[i] OR (lzDateien[j] = lzDateien[i] AND lzZeilen[j] > lzZeilen[i]) THEN
                platz = k
                BREAK
            END IF
        NEXT
        ARRAY_INSERT(reihe, platz, i)
    NEXT
    ' Wo stehen wir in dieser Reihe?
    DIM hier AS INTEGER : hier = -1
    FOR k = 0 TO LEN(reihe) - 1
        DIM m AS INTEGER : m = reihe[k]
        IF lzDateien[m] < pfad OR (lzDateien[m] = pfad AND lzZeilen[m] <= z) THEN hier = k
    NEXT
    DIM ziel AS INTEGER
    IF vorwaerts THEN
        ziel = (hier + 1) MOD LEN(reihe)
    ELSE
        ziel = hier
        IF ziel < 0 THEN ziel = 0
        ' Steht die Marke GENAU auf einem Lesezeichen, ist "zurueck" das
        ' davor -- sonst kaeme man nie von der Stelle.
        DIM h AS INTEGER : h = reihe[ziel]
        IF lzDateien[h] = pfad AND lzZeilen[h] = z THEN ziel = ziel - 1
        IF ziel < 0 THEN ziel = LEN(reihe) - 1
    END IF
    DIM t AS INTEGER : t = reihe[ziel]
    IF lzDateien[t] <> pfad THEN
        IF NOT FILEEXISTS(lzDateien[t]) THEN
            GUI_SET_TEXT(lblStatus, tr$("Die Datei des Lesezeichens gibt es nicht mehr: ") + lzDateien[t])
            RETURN
        END IF
        dateiOeffnen(lzDateien[t])
    END IF
    GUI_TEXTAREA_GOTO(aktivesFeld(), lzZeilen[t], 1)
    GUI_FOCUS(aktivesFeld())
    ' Nur die Zeile ins Protokoll: welche Datei, sagt die "geoeffnet"-Zeile
    ' davor, wenn der Sprung ueber die Grenze ging.
    protokoll("lesezeichen sprung " + STR$(lzZeilen[t]))
END SUB

' Alle Lesezeichen in der Liste unten rechts -- dieselbe wie Suche und
' blame; ein eigenes Panel fuer dieselbe Frage waere eins zu viel.
SUB lesezeichenListe()
    GUI_LISTBOX_CLEAR(lstProbleme)
    DIM sd AS ARRAY OF STRING : sd = []
    DIM sz AS ARRAY OF INTEGER : sz = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lzZeilen) - 1
        ARRAY_PUSH(sd, lzDateien[i]) : ARRAY_PUSH(sz, lzZeilen[i])
        DIM text AS STRING : text = ""
        TRY
            DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(lzDateien[i])
            IF lzZeilen[i] <= LEN(zeilen) THEN text = TRIM$(zeilen[lzZeilen[i] - 1])
        CATCH e
            text = ""
        END TRY
        GUI_LISTBOX_ADD(lstProbleme, BASENAME(lzDateien[i]) + ":" + STR$(lzZeilen[i]) + ": " + text)
    NEXT
    sucheDateien = sd
    sucheZeilen = sz
    problemModus = 1
    GUI_SET_TEXT(lblProbleme, STR$(LEN(sz)) + tr$(" Lesezeichen -- Umschalt+F7 zeigt wieder die Probleme"))
    protokoll("lesezeichen liste " + STR$(LEN(sz)))
END SUB

' Ein Lichtstreif ueber das Hauptfenster, wenn er eingeschaltet ist.
' Ein Testlauf (DHRT_FRAMES) bekommt ihn nur mit DH_IDE_GLANZ=1 -- sonst
' laege er ueber den Bildproben der ersten Sekunden.
SUB lichtstreif(dauer AS INTEGER)
    IF NOT glanzAn THEN RETURN
    IF GETENV$("DHRT_FRAMES") <> "" AND GETENV$("DH_IDE_GLANZ") <> "1" THEN RETURN
    GUI_WINDOW_GLOW_SET(win, "art", "rahmen")
    GUI_WINDOW_GLOW_SET(win, "richtung", "links")
    GUI_WINDOW_GLOW(win, &HFFB050, dauer)
    IF GETENV$("DH_IDE_GLANZ") = "1" THEN protokoll("glanz " + STR$(dauer))
END SUB

' Haben sich die Marken im Feld verschoben (Zeilen darueber eingefuegt
' oder geloescht), ziehen Haltepunkte und Lesezeichen mit -- sonst laege
' der rote Punkt nach dem Tippen auf einer fremden Zeile, und der Debugger
' hielte dort.
SUB markenZurueckholen(ta AS GUI_WIDGET, pfad AS STRING)
    IF ta <> markenFeld OR pfad <> markenPfad OR LEN(markenGesetzt) = 0 THEN RETURN
    DIM jetzt AS ARRAY OF INTEGER : jetzt = GUI_TEXTAREA_MARKS_GET(ta)
    IF LEN(jetzt) <> LEN(markenGesetzt) THEN RETURN
    DIM k AS INTEGER
    DIM anders AS BOOLEAN : anders = FALSE
    FOR k = 0 TO LEN(jetzt) - 1
        IF jetzt[k] = markenGesetzt[k] THEN CONTINUE
        DIM i AS INTEGER : i = markenIdx[k]
        IF markenArt[k] = "h" AND i < LEN(hpZeilen) THEN
            hpZeilen[i] = jetzt[k] : anders = TRUE
        ELSEIF markenArt[k] = "l" AND i < LEN(lzZeilen) THEN
            lzZeilen[i] = jetzt[k] : anders = TRUE
        END IF
        markenGesetzt[k] = jetzt[k]
    NEXT
    IF anders THEN
        DIM liste AS STRING : liste = ""
        FOR k = 0 TO LEN(hpZeilen) - 1
            liste = liste + " " + STR$(hpZeilen[k])
        NEXT
        protokoll("marken gewandert" + liste)
    END IF
END SUB

SUB markenNachziehen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    markenZurueckholen(ta, pfad)
    DIM zeilen AS ARRAY OF INTEGER : zeilen = []
    DIM farben AS ARRAY OF INTEGER : farben = []
    DIM arten AS ARRAY OF STRING : arten = []
    DIM idx AS ARRAY OF INTEGER : idx = []
    DIM schl AS STRING : schl = pfad + "|"
    ' Reihenfolge = Vorrang: die angehaltene Zeile vor dem Haltepunkt vor dem
    ' Fehler vor dem Lesezeichen. Ein bedingter Haltepunkt ist violett.
    IF prozessArt = "debug" AND debugPause AND debugZeile > 0 AND pfad <> "" THEN
        IF SAMEFILE(debugDatei, pfad) THEN
            ARRAY_PUSH(zeilen, debugZeile) : ARRAY_PUSH(farben, &HFFD040) : schl = schl + "p" + STR$(debugZeile)
            ARRAY_PUSH(arten, "p") : ARRAY_PUSH(idx, 0)
        END IF
    END IF
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF hpDateien[i] = pfad THEN
            ARRAY_PUSH(zeilen, hpZeilen[i])
            IF NOT hpIstAktiv(i) THEN
                ARRAY_PUSH(farben, &H7A7A86)
            ELSEIF hpLog$(i) <> "" THEN
                ARRAY_PUSH(farben, &H40A8E0)
            ELSEIF hpBedingungen[i] = "" AND hpTreffer$(i) = "" THEN
                ARRAY_PUSH(farben, &HE05050)
            ELSE
                ARRAY_PUSH(farben, &HC060E0)
            END IF
            schl = schl + "h" + STR$(hpZeilen[i]) + hpBedingungen[i] + IIF(hpIstAktiv(i), "", "-") + hpTreffer$(i) + "~" + hpLog$(i)
            ARRAY_PUSH(arten, "h") : ARRAY_PUSH(idx, i)
        END IF
    NEXT
    FOR i = 0 TO LEN(problemZeilen) - 1
        IF i < LEN(problemHinweis) THEN
            IF problemHinweis[i] THEN CONTINUE
        END IF
        ARRAY_PUSH(zeilen, problemZeilen[i]) : ARRAY_PUSH(farben, &HD08040) : schl = schl + "f" + STR$(problemZeilen[i])
        ARRAY_PUSH(arten, "f") : ARRAY_PUSH(idx, i)
    NEXT
    FOR i = 0 TO LEN(lzZeilen) - 1
        IF lzDateien[i] = pfad THEN
            ARRAY_PUSH(zeilen, lzZeilen[i]) : ARRAY_PUSH(farben, &H5090E0) : schl = schl + "l" + STR$(lzZeilen[i])
            ARRAY_PUSH(arten, "l") : ARRAY_PUSH(idx, i)
        END IF
    NEXT
    ' Der Vergleich zweier Reiter: die abweichenden Zeilen des VORDEREN.
    IF aktiverTab = diffTabR THEN
        FOR i = 0 TO LEN(diffRechts) - 1
            ARRAY_PUSH(zeilen, diffRechts[i]) : ARRAY_PUSH(farben, &HE07070) : schl = schl + "v" + STR$(diffRechts[i])
            ARRAY_PUSH(arten, "v") : ARRAY_PUSH(idx, i)
        NEXT
    END IF
    ' Geaenderte Zeilen ganz zuletzt: sie sind die schwaechste Aussage und
    ' sollen keinen Haltepunkt zudecken.
    FOR i = 0 TO LEN(gitZeilen) - 1
        ARRAY_PUSH(zeilen, gitZeilen[i]) : ARRAY_PUSH(farben, &H50A070) : schl = schl + "g" + STR$(gitZeilen[i])
        ARRAY_PUSH(arten, "g") : ARRAY_PUSH(idx, i)
    NEXT
    IF schl = markenSchluessel AND ta = markenFeld THEN RETURN
    markenSchluessel = schl
    GUI_TEXTAREA_MARKS(ta, zeilen, farben)
    markenFeld = ta : markenPfad = pfad
    markenArt = arten : markenIdx = idx
    ' Nur gueltige Zeilen stehen im Feld (GUI_TEXTAREA_MARKS laesst < 1 weg).
    markenGesetzt = []
    DIM gz AS ARRAY OF STRING : gz = []
    DIM ga AS ARRAY OF INTEGER : ga = []
    FOR i = 0 TO LEN(zeilen) - 1
        IF zeilen[i] >= 1 THEN
            ARRAY_PUSH(markenGesetzt, zeilen[i]) : ARRAY_PUSH(gz, arten[i]) : ARRAY_PUSH(ga, idx[i])
        END IF
    NEXT
    markenArt = gz : markenIdx = ga
END SUB

' --- Hilfe zum Wort unter der Marke ----------------------------------
' Der Aufruf, in dem die Marke gerade steht: rueckwaerts durch die Zeile,
' Klammern zaehlen. Liefert (name, spalte_des_namens, argumentnummer);
' name leer heisst: die Marke steht in keiner Argumentliste.
FUNCTION aufrufUmDieMarke(zeile AS STRING, spalte AS INTEGER) AS TUPLE
    ' MID$ zaehlt ab 0, `spalte` ab 1: die Marke steht VOR Zeichen spalte-1.
    ' Erst zaehlen, wie viele Anfuehrungszeichen links von ihr stehen -- eine
    ' ungerade Zahl heisst: die Marke steht in einer Zeichenkette, und dort
    ' ist jede Klammer nur ein Zeichen.
    DIM q AS INTEGER : q = 0
    DIM k AS INTEGER
    FOR k = 0 TO spalte - 2
        IF MID$(zeile, k, 1) = CHR$(34) THEN q = q + 1
    NEXT
    IF q MOD 2 = 1 THEN RETURN ("", 0, 0)
    DIM tiefe AS INTEGER : tiefe = 0
    DIM arg AS INTEGER : arg = 0
    DIM inText AS BOOLEAN : inText = FALSE
    DIM i AS INTEGER : i = spalte - 2
    WHILE i >= 0
        DIM c AS STRING : c = MID$(zeile, i, 1)
        IF c = CHR$(34) THEN
            inText = NOT inText
        ELSEIF NOT inText THEN
            IF c = ")" THEN
                tiefe = tiefe + 1
            ELSEIF c = "(" THEN
                IF tiefe = 0 THEN
                    ' Gefunden: der Name links davon.
                    DIM e AS INTEGER : e = i - 1
                    WHILE e >= 0 AND MID$(zeile, e, 1) = " " : e = e - 1 : WEND
                    DIM a AS INTEGER : a = e
                    WHILE a >= 0 AND istWortzeichen(MID$(zeile, a, 1)) : a = a - 1 : WEND
                    IF e > a THEN RETURN (MID$(zeile, a + 1, e - a), a + 2, arg)
                    RETURN ("", 0, 0)
                END IF
                tiefe = tiefe - 1
            ELSEIF c = "," AND tiefe = 0 THEN
                arg = arg + 1
            END IF
        END IF
        i = i - 1
    WEND
    RETURN ("", 0, 0)
END FUNCTION

' Signatur des Aufrufs, in dem die Marke steht -- "" wenn keiner.
FUNCTION signaturHilfe$(ta AS GUI_WIDGET, z AS INTEGER, s AS INTEGER) AS STRING
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN ""
    DIM name AS STRING
    DIM spalte AS INTEGER
    DIM arg AS INTEGER
    (name, spalte, arg) = aufrufUmDieMarke(zeilen[z - 1], s)
    IF name = "" THEN RETURN ""
    DIM md AS STRING : md = CODE_HOVER$(GUI_TEXT(ta), z, spalte)
    IF md = "" THEN RETURN ""
    ' Die erste Zeile im Codeblock ist die Signatur.
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, "```", "")
    DIM erste AS STRING : erste = TRIM$(SPLIT$(TRIM$(md), NL)[0])
    IF erste = "" THEN RETURN ""
    RETURN erste + "   -- Argument " + STR$(arg + 1)
END FUNCTION

SUB hilfeNachziehen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM marke AS STRING : marke = STR$(z) + ":" + STR$(s)
    IF marke = letzteMarke THEN RETURN
    letzteMarke = marke
    GUI_STATUSBAR_SET(lblStatus, sfPos, tr$("Zeile ") + STR$(z) + tr$(", Spalte ") + STR$(s))
    ' Steht die Marke in einer Argumentliste, gilt die Signatur des Aufrufs:
    ' dort steht sie auf einem Komma oder einer Zahl, und die Hilfe zum Wort
    ' schwiege genau dann, wenn man sie braucht.
    DIM sig AS STRING : sig = signaturHilfe$(ta, z, s)
    IF sig <> "" THEN
        GUI_SET_TEXT(lblHilfe, sig)
        protokoll("signatur " + sig)
        RETURN
    END IF
    DIM md AS STRING : md = CODE_HOVER$(GUI_TEXT(ta), z, s)
    ' Die Markdown-Zaeune weglassen -- die Beschriftung zeigt Text.
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, NL + "```", "")
    md = REPLACE$(md, "```", "")
    IF TRIM$(md) = "" THEN md = tr$(HILFE_LEER)
    GUI_SET_TEXT(lblHilfe, md)
END SUB

' --- Tooltip beim Ueberfahren und Strg+Klick zur Definition -----------
' Die Maus zeigt auf ein Wort: nach kurzer Ruhe steht seine Hilfe als
' Tooltip daneben -- dieselbe wie unten rechts fuer das Wort unter der
' Marke, nur ohne die Marke dorthin zu setzen. Gesetzt wird der Tooltip des
' Code-Felds; die gui zeigt ihn nach ihrer eigenen Ruhezeit und nimmt ihn
' bei jeder Bewegung weg, er steht also nie neben dem falschen Wort.
' Strg+Klick springt zur Definition (wie F12), und solange Strg gehalten
' ist, zeigt der Zeiger ueber einem Wort die Hand.
DIM tippStelle AS STRING : tippStelle = ""
DIM tippGefragt AS BOOLEAN : tippGefragt = FALSE
DIM tippFeld AS GUI_WIDGET : tippFeld = -1
DIM tippRuhe AS INTEGER : tippRuhe = 0
DIM tippMx AS INTEGER : tippMx = -1
DIM tippMy AS INTEGER : tippMy = -1
DIM tippHand AS BOOLEAN : tippHand = FALSE
DIM tippSprung AS STRING : tippSprung = ""
DIM tippSprungZ AS INTEGER : tippSprungZ = 0
DIM tippSprungS AS INTEGER : tippSprungS = 0
CONST TIPP_RUHE = 8                  ' Bilder, bevor die Hilfe gefragt wird
CONST TIPP_BREITE = 72               ' Zeichen je Tooltip-Zeile
CONST TIPP_ZEILEN = 14

' Das Wort, auf dessen Zeichen s (ab 1) die Maus steht, samt seiner
' Anfangsspalte -- ("", 0), wenn dort kein Wortzeichen steht.
FUNCTION wortBeiZeichen(zeile AS STRING, s AS INTEGER) AS TUPLE
    IF s < 1 OR s > LEN(zeile) THEN RETURN ("", 0)
    IF NOT istWortzeichen(MID$(zeile, s - 1, 1)) THEN RETURN ("", 0)
    DIM a AS INTEGER : a = s - 1
    DIM e AS INTEGER : e = s
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    WHILE e < LEN(zeile) AND istWortzeichen(MID$(zeile, e, 1)) : e = e + 1 : WEND
    RETURN (MID$(zeile, a, e - a), a + 1)
END FUNCTION

' Die Hilfe als Tooltip-Text: ohne Markdown-Zaeune, an Wortgrenzen
' umbrochen (ein Tooltip bricht selbst nicht um und liefe sonst ueber den
' Schirm) und gekuerzt -- wer mehr will, hat F1.
FUNCTION tippText$(md AS STRING) AS STRING
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, NL + "```", "")
    md = REPLACE$(md, "```", "")
    md = TRIM$(md)
    IF md = "" THEN RETURN ""
    DIM raus AS STRING : raus = ""
    DIM zahl AS INTEGER : zahl = 0
    DIM absatz AS STRING
    FOR EACH absatz IN SPLIT$(md, NL)
        DIM rest AS STRING : rest = RTRIM$(absatz)
        DO
            DIM stueck AS STRING : stueck = rest
            IF LEN(rest) > TIPP_BREITE THEN
                DIM schnitt AS INTEGER : schnitt = TIPP_BREITE
                WHILE schnitt > 20 AND MID$(rest, schnitt, 1) <> " " : schnitt = schnitt - 1 : WEND
                IF schnitt <= 20 THEN schnitt = TIPP_BREITE
                stueck = LEFT$(rest, schnitt)
                rest = LTRIM$(MID$(rest, schnitt))
            ELSE
                rest = ""
            END IF
            IF zahl >= TIPP_ZEILEN THEN RETURN raus + NL + "..."
            IF raus <> "" THEN raus = raus + NL
            raus = raus + stueck
            zahl = zahl + 1
        LOOP UNTIL rest = ""
    NEXT
    RETURN raus
END FUNCTION

SUB tippWeg()
    IF tippFeld >= 0 THEN GUI_TOOLTIP(tippFeld, "")
    tippFeld = -1
    tippWertAusdruck = ""
END SUB

' Werte beim Ueberfahren: steht der Debugger in der Datei unter der Maus,
' fragt die IDE den Ausdruck ab (`eval` mit `id` "hover") und setzt die
' Antwort oben in den Tooltip. Die Antwort kommt ein, zwei Bilder spaeter
' ueber debugEreignis -- bis dahin steht die Hilfe allein da.
DIM tippWertAusdruck AS STRING : tippWertAusdruck = ""
DIM tippWertFeld AS GUI_WIDGET : tippWertFeld = -1
DIM tippDoku AS STRING : tippDoku = ""

FUNCTION debugWertMoeglich() AS BOOLEAN
    IF prozessArt <> "debug" OR NOT debugPause OR prozess < 0 OR aktiverTab < 0 THEN RETURN FALSE
    IF tabPfade[aktiverTab] = "" THEN RETURN FALSE
    RETURN SAMEFILE(debugDatei, tabPfade[aktiverTab])
END FUNCTION

' Das Wort samt davorstehender Mitglieds-Kette: bei `spieler.hp` unter der
' Maus auf `hp` der ganze Ausdruck. Nie mit Klammern -- ein Aufruf haette
' Nebenwirkungen, und die sollen nicht beim blossen Hinsehen passieren.
FUNCTION ausdruckBeiWort$(zeile AS STRING, wort AS STRING, anfang AS INTEGER) AS STRING
    DIM a AS INTEGER : a = anfang - 1          ' 0-basiert, erstes Zeichen des Worts
    DIM ende AS INTEGER : ende = a + LEN(wort)
    WHILE a >= 2
        IF MID$(zeile, a - 1, 1) <> "." THEN EXIT WHILE
        IF NOT istWortzeichen(MID$(zeile, a - 2, 1)) THEN EXIT WHILE
        DIM b AS INTEGER : b = a - 2
        WHILE b > 0 AND istWortzeichen(MID$(zeile, b - 1, 1)) : b = b - 1 : WEND
        a = b
    WEND
    RETURN MID$(zeile, a, ende - a)
END FUNCTION

SUB debugWertFragen(ta AS GUI_WIDGET, ausdruck AS STRING, doku AS STRING)
    tippWertAusdruck = ausdruck
    tippWertFeld = ta
    tippDoku = doku
    PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("eval") + "," + jsonText$("expr") + ":" + jsonText$(ausdruck) + "," + jsonText$("id") + ":" + jsonText$("hover") + "}" + NL)
END SUB

SUB wertTooltip(ausdruck AS STRING, wert AS STRING, typ AS STRING)
    IF ausdruck <> tippWertAusdruck OR tippWertFeld < 0 THEN RETURN
    DIM w AS STRING : w = wert
    IF LEN(w) > 160 THEN w = LEFT$(w, 157) + "..."
    DIM text AS STRING : text = ausdruck + " = " + w + "   (" + typ + ")"
    IF tippDoku <> "" THEN text = text + NL + NL + tippDoku
    GUI_TOOLTIP(tippWertFeld, text)
    tippFeld = tippWertFeld
    protokoll("wert " + ausdruck + " = " + wert)
END SUB

SUB mausNachziehen(ta AS GUI_WIDGET)
    IF ta < 0 THEN RETURN
    DIM mx AS INTEGER : mx = MOUSEX()
    DIM my AS INTEGER : my = MOUSEY()
    DIM strg AS BOOLEAN : strg = KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_POS_AT(ta, mx, my)
    ' Liegt ein Fenster davor (Dialog, Palette), zeigt die Maus nicht auf den Code.
    IF NOT GUI_HOVERED(ta) THEN z = 0
    DIM wort AS STRING : wort = ""
    DIM anfang AS INTEGER : anfang = 0
    DIM bildWeg AS STRING : bildWeg = ""
    IF z > 0 THEN
        DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
        IF z <= LEN(zeilen) THEN
            (wort, anfang) = wortBeiZeichen(zeilen[z - 1], s)
            bildWeg = bildPfadBei$(ta, zeilen[z - 1], s)
        END IF
    END IF
    bildTippNachziehen(bildWeg, mx, my)

    ' Strg+Klick: gesprungen wird beim LOSLASSEN -- beim Druecken setzt der
    ' Textbereich selbst die Marke, und solange die Taste haengt, zieht er
    ' sie als Auswahl hinter der Maus her; ein Sprung beim Druecken stuende
    ' im naechsten Bild wieder an der Klickstelle.
    IF strg AND MOUSE_HIT(0) AND wort <> "" THEN
        tippSprung = wort : tippSprungZ = z : tippSprungS = s
    END IF
    IF tippSprung <> "" AND MOUSE_RELEASED(0) THEN
        DIM ziel AS STRING : ziel = tippSprung
        tippSprung = ""
        GUI_TEXTAREA_SELECT(ta, tippSprungZ, tippSprungS, tippSprungZ, tippSprungS)
        protokoll("strg klick " + ziel)
        tippWeg()
        zurDefinition()
        RETURN
    END IF
    DIM hand AS BOOLEAN : hand = strg AND wort <> ""
    IF hand THEN
        MOUSE_CURSOR("hand")
    ELSEIF tippHand THEN
        ' Die Hand des Programms bleibt stehen, bis es sie zurueckgibt --
        ' danach entscheidet wieder die gui (Textstrich, Pfeil ...).
        MOUSE_CURSOR("auto")
    END IF
    tippHand = hand

    IF mx <> tippMx OR my <> tippMy THEN
        tippRuhe = 0
    ELSE
        tippRuhe = tippRuhe + 1
    END IF
    tippMx = mx : tippMy = my
    ' Steht die Maus auf einer unterstrichenen Stelle, gehoert die Meldung in
    ' den Tooltip -- auch ueber einer Klammer, wo es kein Wort gibt.
    DIM meldung AS STRING : meldung = meldungBei$(ta, z, s)
    DIM stelle AS STRING : stelle = ""
    IF wort <> "" THEN stelle = STR$(ta) + ":" + STR$(z) + ":" + STR$(anfang)
    IF meldung <> "" THEN stelle = STR$(ta) + ":" + STR$(z) + ":m" + meldung
    IF stelle <> tippStelle THEN
        tippStelle = stelle
        tippGefragt = FALSE
        tippWeg()
    END IF
    IF stelle = "" OR tippGefragt OR tippRuhe < TIPP_RUHE THEN RETURN
    tippGefragt = TRUE
    DIM text AS STRING : text = ""
    IF wort <> "" THEN text = tippText$(CODE_HOVER$(GUI_TEXT(ta), z, anfang))
    IF meldung <> "" THEN
        text = tippText$(meldung) + IIF(text <> "", NL + NL + text, "")
        protokoll("tooltip meldung " + LEFT$(meldung, 30))
    END IF
    IF debugWertMoeglich() AND wort <> "" THEN
        DIM wz AS ARRAY OF STRING : wz = SPLIT$(GUI_TEXT(ta), NL)
        debugWertFragen(ta, ausdruckBeiWort$(wz[z - 1], wort, anfang), text)
    END IF
    IF text = "" THEN RETURN
    GUI_TOOLTIP(ta, text)
    tippFeld = ta
    protokoll("tooltip " + wort)
END SUB

' --- Abgelegte Dateien ---------------------------------------------------
' Ins Fenster gezogen oder vom Finder uebergeben (macOS: Doppelklick auf eine
' .dh, "Oeffnen mit" -- die Laufzeit reicht beides als FILES_DROPPED weiter,
' siehe finder.rs). Eine Datei geht ueber dieselbe Weiche wie ein Klick im
' Projektbaum, ein Ordner wird das Projekt. FILES_DROPPED gilt nur EIN Bild:
' ist gerade ein Kasten offen, warten die Pfade, bis er zu ist -- ein Reiter,
' der hinter einer Rueckfrage aufgeht, gehoerte zu keiner Antwort.
DIM abgelegtWartend AS ARRAY OF STRING : abgelegtWartend = []
SUB abgelegteNachziehen()
    DIM i AS INTEGER
    FOR i = 0 TO FILES_DROPPED() - 1
        ARRAY_PUSH(abgelegtWartend, FILE_DROPPED(i))
    NEXT
    IF LEN(abgelegtWartend) = 0 OR GUI_MODAL() THEN RETURN
    DIM liste AS ARRAY OF STRING : liste = abgelegtWartend
    abgelegtWartend = []
    FOR i = 0 TO LEN(liste) - 1
        protokoll("abgelegt " + BASENAME(liste[i]))
        IF DIREXISTS(liste[i]) THEN
            projektOrdner = liste[i]
            baumFuellen()
            GUI_SET_TEXT(lblStatus, tr$("Projekt: ") + liste[i])
            protokoll("projekt " + projektOrdner)
        ELSE
            dateiOeffnen(liste[i])
        END IF
    NEXT
END SUB

' --- Haltepunkt per Klick in die Nummernspalte ---------------------------
' Links schaltet ihn um wie F9, rechts fragt nach einer Bedingung wie
' Umschalt+F9 -- beides fuer die ANGEKLICKTE Zeile, die Marke bleibt stehen.
' Jeder offene Reiter wird gefragt: in der geteilten Ansicht sind zwei zu
' sehen, und ein Klick links gehoert der Datei links.
SUB randKlicksNachziehen()
    DIM t AS INTEGER
    FOR t = 0 TO tabAnzahl - 1
        DIM hz AS INTEGER : hz = GUI_TEXTAREA_HINT_CLICKED(tabFelder[t])
        IF hz > 0 THEN zaehlerKlick(tabFelder[t], hz)
        DIM z AS INTEGER : z = GUI_TEXTAREA_GUTTER_CLICKED(tabFelder[t])
        IF z > 0 THEN
            protokoll("rand klick " + STR$(z))
            haltepunktUmschaltenIn(tabPfade[t], z)
        END IF
        z = GUI_TEXTAREA_GUTTER_CLICKED(tabFelder[t], 1)
        IF z > 0 THEN
            protokoll("rand rechts " + STR$(z))
            haltepunktBedingungFragenIn(tabPfade[t], z)
        END IF
    NEXT
END SUB

' --- Vervollstaendigen -------------------------------------------------
' `fokus` entscheidet, wer danach die Tasten bekommt. Beim Tippen bleibt
' die Marke im Code-Feld -- sonst tippte man in die Liste weiter; Strg+Leer
' holt sie dann herein, wenn man etwas auswaehlen will.
SUB vervollstaendigen(fokus AS BOOLEAN)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM namen AS ARRAY OF STRING
    namen = CODE_COMPLETE(q, z, s)
    ' Laenge des Praefixes links der Marke -- so viel wird beim Uebernehmen ersetzt.
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(q, NL)
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    DIM k AS INTEGER : k = s - 1
    vervollPraefixLaenge = 0
    WHILE k > 0
        DIM c AS STRING : c = MID$(zeile, k - 1, 1)
        IF NOT (c = "_" OR (c >= "a" AND c <= "z") OR (c >= "A" AND c <= "Z") OR (c >= "0" AND c <= "9")) THEN BREAK
        vervollPraefixLaenge = vervollPraefixLaenge + 1
        k = k - 1
    WEND
    GUI_LISTBOX_CLEAR(lstVervoll)
    DIM i AS INTEGER
    FOR i = 0 TO MIN(LEN(namen), 200) - 1
        GUI_LISTBOX_ADD(lstVervoll, namen[i])
    NEXT
    IF LEN(namen) = 0 THEN RETURN
    GUI_LISTBOX_SET_SELECTED(lstVervoll, 0)
    GUI_WINDOW_SET_BOUNDS(winVervoll, breiteLinks + 40, 120, 320, 240)
    GUI_WINDOW_VISIBLE(winVervoll, TRUE)
    vervollOffen = TRUE
    vervollWort = wortAnfang$()
    IF fokus THEN GUI_FOCUS(lstVervoll)
END SUB

SUB vervollSchliessen()
    IF NOT vervollOffen THEN RETURN
    GUI_WINDOW_VISIBLE(winVervoll, FALSE)
    vervollOffen = FALSE
    vervollWort = ""
END SUB

' Beim Tippen von selbst: ab drei Zeichen zeigt die Liste, was passt. Der
' Fokus bleibt im Code-Feld -- die Liste ist ein Vorschlag, keine Sperre.
SUB vervollNachziehen()
    IF NOT vorschlagAn OR aktiverTab < 0 OR paletteOffen THEN RETURN
    DIM wort AS STRING : wort = wortAnfang$()
    IF wort = vervollAus THEN RETURN
    vervollAus = "-"
    IF LEN(wort) < 3 THEN
        vervollSchliessen()
        RETURN
    END IF
    IF wort = vervollWort THEN RETURN
    IF GUI_FOCUSED() <> aktivesFeld() THEN RETURN
    vervollstaendigen(FALSE)
END SUB

' --- Signatur-Platzhalter und der dreifache Tabulator ------------------
' Wer `CIRCLE` vervollstaendigt, bekommt `CIRCLE(x, y, r)` mit `x`
' markiert: tippen ersetzt es, Tabulator geht zum naechsten. Die Namen
' stehen in der Signatur -- dieselbe, die die Statuszeile zeigt.
'
' Gemerkt wird dafuer NICHTS als ein Schalter. Wo der naechste Platzhalter
' steht, rechnet der Sprung jedes Mal neu aus dem Text: eine Buchfuehrung
' ueber Stellen liefe beim ersten Tippen auseinander, und genau tippen
' will man ja.
DIM platzhalterAn AS BOOLEAN : platzhalterAn = FALSE

' Die Argumentnamen einer Signatur, oder ein leeres Feld.
' Optionales (alles ab `[`) faellt weg -- ein Platzhalter, den man meist
' wieder loescht, ist keiner.
FUNCTION signaturArgs(quelle AS STRING, z AS INTEGER, s AS INTEGER) AS ARRAY OF STRING
    DIM leer AS ARRAY OF STRING : leer = []
    DIM md AS STRING : md = ""
    TRY
        md = CODE_HOVER$(quelle, z, s)
    CATCH e
        RETURN leer
    END TRY
    IF md = "" THEN RETURN leer
    ' Die erste Zeile im Code-Block ist die Signatur.
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(md, NL)
    DIM sig AS STRING : sig = ""
    DIM zl AS STRING
    FOR EACH zl IN zeilen
        IF LEFT$(zl, 3) = "```" OR TRIM$(zl) = "" THEN CONTINUE
        sig = TRIM$(zl)
        BREAK
    NEXT
    DIM auf AS INTEGER : auf = INSTR(sig, "(")
    DIM zu AS INTEGER : zu = INSTR(sig, ")")
    IF auf < 0 OR zu < auf THEN RETURN leer
    DIM innen AS STRING : innen = MID$(sig, auf + 1, zu - auf - 1)
    DIM opt AS INTEGER : opt = INSTR(innen, "[")
    IF opt >= 0 THEN innen = LEFT$(innen, opt)
    IF TRIM$(innen) = "" THEN RETURN leer
    ' `NAME(*args)` und `NAME(6..8 Argumente)` sind keine Namen.
    IF INSTR(innen, "*") >= 0 OR INSTR(innen, "Argumente") >= 0 THEN RETURN leer
    DIM raus AS ARRAY OF STRING : raus = []
    DIM stueck AS STRING
    FOR EACH stueck IN SPLIT$(innen, ",")
        DIM t AS STRING : t = TRIM$(stueck)
        IF LEFT$(UPPER$(t), 6) = "BYREF " THEN t = TRIM$(MID$(t, 6))
        DIM als AS INTEGER : als = INSTR(UPPER$(t), " AS ")
        IF als >= 0 THEN t = TRIM$(LEFT$(t, als))
        DIM gl AS INTEGER : gl = INSTR(t, "=")
        IF gl >= 0 THEN t = TRIM$(LEFT$(t, gl))
        IF t = "" THEN RETURN leer
        ARRAY_PUSH(raus, t)
    NEXT
    RETURN raus
END FUNCTION

' Den naechsten Platzhalter des Aufrufs um die Marke markieren.
' FALSE heisst: hier ist keiner mehr, der Tabulator soll etwas anderes tun.
FUNCTION platzhalterSprung() AS BOOLEAN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN FALSE
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN FALSE
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    DIM name AS STRING
    DIM sp AS INTEGER
    DIM arg AS INTEGER
    (name, sp, arg) = aufrufUmDieMarke(zeile, s)
    IF name = "" THEN RETURN FALSE
    ' `sp` ist die 1-basierte Spalte des Namens, `argsZerlegen` rechnet
    ' 0-basiert -- die Klammer steht hinter dem Namen.
    DIM auf AS INTEGER : auf = sp - 1 + LEN(name)
    WHILE auf < LEN(zeile) AND MID$(zeile, auf, 1) = " "
        auf = auf + 1
    WEND
    IF MID$(zeile, auf, 1) <> "(" THEN RETURN FALSE
    DIM von AS ARRAY OF INTEGER : von = []
    DIM bis AS ARRAY OF INTEGER : bis = []
    DIM zu AS INTEGER : zu = argsZerlegen(zeile, auf, von, bis)
    IF zu < 0 THEN RETURN FALSE
    DIM k AS INTEGER : k = arg + 1
    IF k >= LEN(von) THEN
        ' Hinter dem letzten: die Marke hinter die Klammer, Schalter aus.
        GUI_TEXTAREA_GOTO(ta, z, zu + 2)
        RETURN FALSE
    END IF
    GUI_TEXTAREA_SELECT(ta, z, randLinks(zeile, von[k]) + 1, z, bis[k] + 1)
    protokoll("platzhalter " + STR$(k + 1) + " von " + STR$(LEN(von)))
    RETURN TRUE
END FUNCTION

' Der erste Nicht-Leerraum ab `p` (0-basiert) -- damit die Markierung nicht
' das Leerzeichen hinter dem Komma mitnimmt.
FUNCTION randLinks(zeile AS STRING, p AS INTEGER) AS INTEGER
    DIM i AS INTEGER : i = p
    WHILE i < LEN(zeile) AND (MID$(zeile, i, 1) = " " OR MID$(zeile, i, 1) = CHR$(9))
        i = i + 1
    WEND
    RETURN i
END FUNCTION

' Der Tabulator, alle drei Bedeutungen in ihrer Reihenfolge.
SUB tabulator()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    ' 1. Steht ein Platzhalter an, geht es zum naechsten.
    IF platzhalterAn THEN
        IF platzhalterSprung() THEN RETURN
        platzhalterAn = FALSE
    END IF
    ' 2. Eine Abkuerzung links der Marke klappt ihren Schnipsel auf.
    DIM wort AS STRING : wort = LOWER$(wortAnfang$())
    IF wort <> "" THEN
        DIM k AS INTEGER : k = ARRAY_INDEXOF(schnipselAbk, wort)
        IF k >= 0 THEN
            schnipselEinfuegen(k, LEN(schnipselAbk[k]))
            RETURN
        END IF
    END IF
    ' 3. Sonst einruecken. Mehrere Zeilen markiert: der ganze Block --
    ' frueher ersetzte der Tabulator die Auswahl durch Leerzeichen.
    DIM z1 AS INTEGER
    DIM s1 AS INTEGER
    DIM z2 AS INTEGER
    DIM s2 AS INTEGER
    (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    IF z2 > z1 THEN
        einruecken(1)
        RETURN
    END IF
    ' Bis zur naechsten Spalte, nicht stur vier Leerzeichen: sonst steht die
    ' Einrueckung schief, sobald man mitten in der Zeile tabbt.
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM n AS INTEGER : n = 4 - ((s - 1) MOD 4)
    GUI_TEXTAREA_INSERT(ta, SPACE$(n))
END SUB

SUB vervollUebernehmen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstVervoll)
    vervollSchliessen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF sel >= 0 THEN
        DIM z AS INTEGER
        DIM s AS INTEGER
        (z, s) = GUI_TEXTAREA_CURSOR(ta)
        DIM name AS STRING : name = GUI_LISTBOX_ITEM(lstVervoll, sel)
        GUI_TEXTAREA_SELECT(ta, z, s - vervollPraefixLaenge, z, s)
        GUI_TEXTAREA_INSERT(ta, name)
        protokoll("vervollstaendigt " + name)
        ' Hat der Name eine Signatur mit Argumenten, kommt sie als Geruest
        ' mit -- und der erste Platzhalter ist markiert.
        DIM nz AS INTEGER
        DIM ns AS INTEGER
        (nz, ns) = GUI_TEXTAREA_CURSOR(ta)
        DIM args AS ARRAY OF STRING : args = signaturArgs(GUI_TEXT(ta), nz, MAX(1, ns - 1))
        IF LEN(args) > 0 THEN
            GUI_TEXTAREA_INSERT(ta, "(" + JOIN$(args, ", ") + ")")
            GUI_TEXTAREA_SELECT(ta, nz, ns + 1, nz, ns + 1 + LEN(args[0]))
            platzhalterAn = TRUE
            GUI_SET_TEXT(lblStatus, name + ": " + STR$(LEN(args)) + _
                         " Argument(e) -- tippen ersetzt, Tabulator geht zum nächsten.")
            protokoll("platzhalter 1 von " + STR$(LEN(args)))
        END IF
    END IF
    GUI_FOCUS(ta)
END SUB

' --- Suchen / Ersetzen / Zeile ----------------------------------------
' JEDE Suche der IDE geht durch EIN Muster: der Suchtext woertlich
' (maskiert) oder als regulaerer Ausdruck, fuer ganze Woerter zwischen `\b`,
' ohne Gross/klein mit `(?i)`. Liefen Suchleiste, Projektsuche und
' Ersetzen im Projekt getrennte Wege, faende die eine etwas anderes als die
' andere -- und genau das war vorher so: das Ersetzen im Feld suchte ohne
' Ruecksicht auf den Regex-Schalter.
FUNCTION suchMuster$(text AS STRING) AS STRING
    IF text = "" THEN RETURN ""
    DIM m AS STRING : m = IIF(regexAn, text, REGEX_ESCAPE$(text))
    IF ganzesWort THEN m = "\b(?:" + m + ")\b"
    IF NOT grossKlein THEN m = "(?i)" + m
    RETURN m
END FUNCTION

' Passt die Zeile? Fuer die Projektsuche und das Zaehlen vor dem Ersetzen.
FUNCTION passtSuche(zeile AS STRING, muster AS STRING) AS BOOLEAN
    IF muster = "" THEN RETURN FALSE
    TRY
        RETURN REGEX_TEST(zeile, suchMuster$(muster))
    CATCH e
        RETURN FALSE
    END TRY
END FUNCTION

' Ersetzen Zeile fuer Zeile -- dieselbe Einheit wie die Trefferliste, sonst
' hiesse `^` beim Ersetzen etwas anderes als beim Suchen. Woertlich (ohne
' Ausdruck) bekommt der Ersatz verdoppelte Rueckstriche: REGEX_REPLACE liest
' `\1` als Gruppe, und wer woertlich `\1` einsetzen will, meint das nicht.
FUNCTION textErsetzen$(text AS STRING, gesucht AS STRING, ersatz AS STRING) AS STRING
    DIM m AS STRING : m = suchMuster$(gesucht)
    IF m = "" THEN RETURN text
    DIM r AS STRING : r = IIF(regexAn, ersatz, REPLACE$(ersatz, "\", "\\"))
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(text, NL)
    DIM i AS INTEGER
    TRY
        FOR i = 0 TO LEN(zeilen) - 1
            zeilen[i] = REGEX_REPLACE(zeilen[i], m, r)
        NEXT
    CATCH e
        RETURN text
    END TRY
    RETURN JOIN$(zeilen, NL)
END FUNCTION

' --- Die Suchleiste (seit 2026-09-19) ---------------------------------
' Statt zwei Eingabe-Kaesten hintereinander ein Fenster, das offen bleibt:
' Suchfeld mit Weiter/Zurueck und Trefferzahl, die drei Schalter, und in der
' Ersetzen-Form ein Ersatzfeld mit [Ersetzen] (EINE Stelle, dann die
' naechste) und [Alle]. Tippen springt sofort zum ersten Treffer ab der
' Stelle, an der die Leiste aufging; der Fokus bleibt dabei im Suchfeld.
' Die Treffer eines Feldes: Zeile, Spalte (ab 1 wie GUI_TEXTAREA_SELECT) und
' Laenge -- gerechnet, wenn sich Muster, Feld oder Text geaendert haben.
DIM trefferZ AS ARRAY OF INTEGER : trefferZ = []
DIM trefferS AS ARRAY OF INTEGER : trefferS = []
DIM trefferL AS ARRAY OF INTEGER : trefferL = []
DIM trefferFehler AS BOOLEAN : trefferFehler = FALSE
DIM trefferMusterAlt AS STRING : trefferMusterAlt = "-"
DIM trefferFeldAlt AS GUI_WIDGET : trefferFeldAlt = -2
DIM trefferTextAlt AS STRING : trefferTextAlt = ""
CONST TREFFER_HOECHSTENS = 20000

SUB trefferAktuell(ta AS GUI_WIDGET)
    DIM m AS STRING : m = ""
    IF ta >= 0 THEN m = suchMuster$(suchtext)
    DIM t AS STRING : t = ""
    IF ta >= 0 THEN t = GUI_TEXT(ta)
    IF m = trefferMusterAlt AND ta = trefferFeldAlt AND t = trefferTextAlt THEN RETURN
    trefferMusterAlt = m : trefferFeldAlt = ta : trefferTextAlt = t
    trefferZ = [] : trefferS = [] : trefferL = []
    trefferFehler = FALSE
    IF m = "" THEN RETURN
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(t, NL)
    DIM z AS INTEGER
    FOR z = 0 TO LEN(zeilen) - 1
        DIM ab AS INTEGER : ab = 0
        WHILE ab <= LEN(zeilen[z]) AND LEN(trefferZ) < TREFFER_HOECHSTENS
            DIM p AS INTEGER
            DIM l AS INTEGER
            TRY
                (p, l) = REGEX_FIND_POS(zeilen[z], m, ab)
            CATCH e
                trefferFehler = TRUE
                RETURN
            END TRY
            IF p < 0 THEN BREAK
            ' Ein leerer Treffer (`x*` auf einer Zeile ohne x) markiert
            ' nichts -- er zaehlt nicht und schiebt nur weiter.
            IF l > 0 THEN
                ARRAY_PUSH(trefferZ, z + 1) : ARRAY_PUSH(trefferS, p + 1) : ARRAY_PUSH(trefferL, l)
            END IF
            ab = p + MAX(l, 1)
        WEND
    NEXT
END SUB

' Der naechste Treffer: vorwaerts der erste, der bei (z, s) oder dahinter
' anfaengt, rueckwaerts der letzte davor -- mit Umlauf am Dateiende.
FUNCTION trefferIndex(z AS INTEGER, s AS INTEGER, vorwaerts AS BOOLEAN) AS INTEGER
    DIM n AS INTEGER : n = LEN(trefferZ)
    IF n = 0 THEN RETURN -1
    DIM k AS INTEGER
    IF vorwaerts THEN
        FOR k = 0 TO n - 1
            IF trefferZ[k] > z OR (trefferZ[k] = z AND trefferS[k] >= s) THEN RETURN k
        NEXT
        RETURN 0
    END IF
    FOR k = n - 1 TO 0 STEP -1
        IF trefferZ[k] < z OR (trefferZ[k] = z AND trefferS[k] < s) THEN RETURN k
    NEXT
    RETURN n - 1
END FUNCTION

' Welcher Treffer ist gerade GENAU markiert? -1 = keiner.
FUNCTION trefferMarkiert(ta AS GUI_WIDGET) AS INTEGER
    DIM z1 AS INTEGER
    DIM s1 AS INTEGER
    DIM z2 AS INTEGER
    DIM s2 AS INTEGER
    (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    IF z1 <> z2 THEN RETURN -1
    DIM k AS INTEGER
    FOR k = 0 TO LEN(trefferZ) - 1
        IF trefferZ[k] = z1 AND trefferS[k] = s1 AND trefferS[k] + trefferL[k] = s2 THEN RETURN k
        IF trefferZ[k] > z1 THEN RETURN -1
    NEXT
    RETURN -1
END FUNCTION

SUB trefferMarkieren(ta AS GUI_WIDGET, k AS INTEGER)
    GUI_TEXTAREA_SELECT(ta, trefferZ[k], trefferS[k], trefferZ[k], trefferS[k] + trefferL[k])
    protokoll("treffer " + STR$(k + 1) + " von " + STR$(LEN(trefferZ)) + " zeile " + STR$(trefferZ[k]) + _
              " spalte " + STR$(trefferS[k]))
END SUB

' F3 / Umschalt+F3 / Enter im Suchfeld. Vorwaerts ab dem ENDE der Auswahl
' (ein markierter Treffer ist damit erledigt), rueckwaerts ab ihrem Anfang.
' Den Fokus holt es nur ins Code-Feld, wenn die Leiste zu ist -- aus dem
' Suchfeld heraus will man mit Enter weiter springen, nicht ins Feld tippen.
FUNCTION trefferSpringen(vorwaerts AS BOOLEAN) AS BOOLEAN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR suchtext = "" THEN RETURN FALSE
    trefferAktuell(ta)
    IF LEN(trefferZ) = 0 THEN
        IF trefferFehler THEN
            GUI_SET_TEXT(lblStatus, tr$("Ungültiger Ausdruck: ") + suchtext)
        ELSE
            GUI_SET_TEXT(lblStatus, tr$("Nicht gefunden: ") + suchtext)
        END IF
        protokoll("treffer keine")
        RETURN FALSE
    END IF
    DIM z1 AS INTEGER
    DIM s1 AS INTEGER
    DIM z2 AS INTEGER
    DIM s2 AS INTEGER
    (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    DIM k AS INTEGER
    IF vorwaerts THEN k = trefferIndex(z2, s2, TRUE) ELSE k = trefferIndex(z1, s1, FALSE)
    trefferMarkieren(ta, k)
    IF NOT sucheOffen THEN GUI_FOCUS(ta)
    RETURN TRUE
END FUNCTION

' Steht der Fokus in der Suchleiste? ESC schliesst sie nur dann -- im
' Code-Feld raeumt ESC die weiteren Schreibmarken weg, und das soll es weiter.
FUNCTION imSuchfenster() AS BOOLEAN
    DIM f AS GUI_WIDGET : f = GUI_FOCUSED()
    RETURN f = tfSuche OR f = tfErsatz OR f = btnSuWeiter OR f = btnSuZurueck OR f = btnSuErsetzen _
        OR f = btnSuAlle OR f = cbSuGross OR f = cbSuWort OR f = cbSuAusdruck
END FUNCTION

SUB suchSchalterZeigen()
    GUI_MENU_CHECK(miRegex, regexAn)
    GUI_MENU_CHECK(miGross, grossKlein)
    GUI_MENU_CHECK(miWort, ganzesWort)
    GUI_SET_CHECKED(cbSuAusdruck, regexAn)
    GUI_SET_CHECKED(cbSuGross, grossKlein)
    GUI_SET_CHECKED(cbSuWort, ganzesWort)
END SUB

SUB sucheOeffnen(mitErsetzen AS BOOLEAN)
    sucheMitErsetzen = mitErsetzen
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 THEN
        ' Eine Auswahl in EINER Zeile ist das, wonach man suchen will. Im
        ' Ausdrucksmodus maskiert -- sonst suchte `a.b` auch `axb`.
        DIM sel AS STRING : sel = GUI_TEXTAREA_SELECTION$(ta)
        IF sel <> "" AND INSTR(sel, NL) < 0 THEN suchtext = IIF(regexAn, REGEX_ESCAPE$(sel), sel)
        DIM z2 AS INTEGER
        DIM s2 AS INTEGER
        (sucheAnkerZ, sucheAnkerS, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    END IF
    GUI_SET_TEXT(tfSuche, suchtext)
    GUI_SET_TEXT(tfErsatz, ersatztext)
    suchSchalterZeigen()
    GUI_SET_VISIBLE(tfErsatz, mitErsetzen)
    GUI_SET_VISIBLE(btnSuErsetzen, mitErsetzen)
    GUI_SET_VISIBLE(btnSuAlle, mitErsetzen)
    GUI_WINDOW_TITLE(winSuche, IIF(mitErsetzen, tr$("Suchen und ersetzen"), tr$("Suchen")))
    GUI_WINDOW_SET_BOUNDS(winSuche, MAX(0, SCREENWIDTH() - 500), 104, 480, IIF(mitErsetzen, 146, 112))
    GUI_WINDOW_VISIBLE(winSuche, TRUE)
    sucheOffen = TRUE
    GUI_FOCUS(tfSuche)
    faerbSchluessel = ""
    sucheZahlAlt = "-"
    protokoll("suche offen" + IIF(mitErsetzen, " ersetzen", ""))
END SUB

SUB sucheSchliessen()
    GUI_WINDOW_VISIBLE(winSuche, FALSE)
    sucheOffen = FALSE
    faerbSchluessel = ""
    IF aktivesFeld() >= 0 THEN GUI_FOCUS(aktivesFeld())
    protokoll("suche zu")
END SUB

' Ersetzen: ist GENAU ein Treffer markiert, wird er ersetzt; danach -- oder
' wenn keiner markiert war -- geht es zum naechsten. So sieht man jede
' Stelle, bevor sie sich aendert.
SUB ersetzenEinzeln()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR suchtext = "" THEN RETURN
    trefferAktuell(ta)
    DIM k AS INTEGER : k = trefferMarkiert(ta)
    IF k >= 0 THEN
        DIM neu AS STRING : neu = ersatztext
        IF regexAn THEN
            ' Gruppen (`\1`) gelten auch beim einzelnen Ersetzen.
            TRY
                neu = REGEX_REPLACE_ONCE(GUI_TEXTAREA_SELECTION$(ta), suchMuster$(suchtext), ersatztext)
            CATCH e
                neu = ersatztext
            END TRY
        END IF
        GUI_TEXTAREA_INSERT(ta, neu)
        protokoll("ersetzt einzeln zeile " + STR$(trefferZ[k]))
    END IF
    trefferSpringen(TRUE)
END SUB

' Alle auf einmal, als EIN Schritt fuer Strg+Z (Auswahl ueber alles plus
' INSERT); die Marke bleibt in ihrer Zeile.
SUB alleErsetzen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR suchtext = "" THEN RETURN
    trefferAktuell(ta)
    DIM n AS INTEGER : n = LEN(trefferZ)
    IF n = 0 THEN
        GUI_SET_TEXT(lblStatus, IIF(trefferFehler, tr$("Ungültiger Ausdruck: "), tr$("Nicht gefunden: ")) + suchtext)
        protokoll("ersetzt 0")
        RETURN
    END IF
    DIM cz AS INTEGER
    DIM cs AS INTEGER
    (cz, cs) = GUI_TEXTAREA_CURSOR(ta)
    DIM neu AS STRING : neu = textErsetzen$(GUI_TEXT(ta), suchtext, ersatztext)
    GUI_TEXTAREA_SELECT(ta, 1, 1, 1000000, 1000000)
    GUI_TEXTAREA_INSERT(ta, neu)
    GUI_TEXTAREA_GOTO(ta, cz, 1)
    GUI_SET_TEXT(lblStatus, STR$(n) + tr$(" mal ersetzt."))
    protokoll("ersetzt " + STR$(n))
END SUB

' Je Bild, solange die Leiste offen ist.
SUB sucheNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winSuche) THEN
        ' mit dem Kreuz des Fensters geschlossen
        sucheOffen = FALSE
        faerbSchluessel = ""
        protokoll("suche zu")
        RETURN
    END IF
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF GUI_TEXT(tfSuche) <> suchtext THEN
        suchtext = GUI_TEXT(tfSuche)
        faerbSchluessel = ""
        ' Beim Tippen zum ersten Treffer ab der Stelle, an der die Leiste
        ' aufging -- nicht ab dem letzten Treffer, sonst liefe die Auswahl
        ' mit jedem Buchstaben weiter nach unten.
        IF ta >= 0 THEN
            trefferAktuell(ta)
            IF LEN(trefferZ) > 0 THEN trefferMarkieren(ta, trefferIndex(sucheAnkerZ, sucheAnkerS, TRUE))
        END IF
    END IF
    ersatztext = GUI_TEXT(tfErsatz)
    IF GUI_CLICKED(cbSuGross) AND GUI_CHECKED(cbSuGross) <> grossKlein THEN befehl("gross_klein")
    IF GUI_CLICKED(cbSuWort) AND GUI_CHECKED(cbSuWort) <> ganzesWort THEN befehl("ganzes_wort")
    IF GUI_CLICKED(cbSuAusdruck) AND GUI_CHECKED(cbSuAusdruck) <> regexAn THEN befehl("regex")
    DIM zurueck AS BOOLEAN : zurueck = KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT)
    IF GUI_ENTERED(tfSuche) THEN trefferSpringen(NOT zurueck)
    IF GUI_CLICKED(btnSuWeiter) THEN trefferSpringen(TRUE)
    IF GUI_CLICKED(btnSuZurueck) THEN trefferSpringen(FALSE)
    IF GUI_ENTERED(tfErsatz) OR GUI_CLICKED(btnSuErsetzen) THEN ersetzenEinzeln()
    IF GUI_CLICKED(btnSuAlle) THEN alleErsetzen()
    IF KEYHIT(KEY_ESCAPE) AND imSuchfenster() THEN
        sucheSchliessen()
        RETURN
    END IF
    ' Die Trefferzahl: "3 von 12", wenn einer markiert ist.
    DIM zahl AS STRING : zahl = ""
    IF ta >= 0 AND suchtext <> "" THEN
        trefferAktuell(ta)
        IF trefferFehler THEN
            zahl = "Ausdruck ungueltig"
        ELSEIF LEN(trefferZ) = 0 THEN
            zahl = "keine Treffer"
        ELSE
            DIM k AS INTEGER : k = trefferMarkiert(ta)
            IF k >= 0 THEN zahl = STR$(k + 1) + " von " + STR$(LEN(trefferZ)) ELSE zahl = STR$(LEN(trefferZ)) + " Treffer"
        END IF
    END IF
    IF zahl <> sucheZahlAlt THEN
        sucheZahlAlt = zahl
        GUI_SET_TEXT(lblSuZahl, zahl)
        protokoll("suche zahl " + zahl)
    END IF
END SUB

SUB zurDefinition()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM dz AS INTEGER
    DIM ds AS INTEGER
    (dz, ds) = CODE_DEFINITION(GUI_TEXT(ta), z, s)
    IF dz < 1 THEN
        ' CODE_DEFINITION sieht nur DIESEN Text -- was hier fehlt, steht
        ' vielleicht in einer anderen Datei des Projekts.
        DIM k AS INTEGER : k = symbolSuchen(wortUnterMarke$())
        IF k >= 0 THEN
            symbolAnspringen(k)
            RETURN
        END IF
        GUI_SET_TEXT(lblStatus, tr$("Keine Definition zu '") + wortUnterMarke$() + tr$("' -- auch nicht im Projekt."))
        RETURN
    END IF
    GUI_TEXTAREA_GOTO(ta, dz, ds)
END SUB

' --- Handgriffe im Text: Kommentar, Zeilen, Einrueckung, Formatieren -------
' Alle arbeiten auf ganzen ZEILEN: der Auswahl, sonst der Zeile der Marke.
' Geschrieben wird ueber SELECT + INSERT, damit jeder Handgriff ein eigener
' Undo-Schritt bleibt (GUI_SET_TEXT wuerde den Verlauf leeren).
CONST SPALTE_ENDE = 1000000          ' GUI_TEXTAREA_SELECT klemmt ans Zeilenende

FUNCTION zeilenBereich(ta AS GUI_WIDGET) AS TUPLE
    DIM z1 AS INTEGER
    DIM s1 AS INTEGER
    DIM z2 AS INTEGER
    DIM s2 AS INTEGER
    (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    ' Endet die Auswahl am Anfang einer Zeile, gehoert die nicht mehr dazu.
    IF z2 > z1 AND s2 = 1 THEN z2 = z2 - 1
    RETURN (z1, z2)
END FUNCTION

FUNCTION zeilenHolen(alle AS ARRAY OF STRING, z1 AS INTEGER, z2 AS INTEGER) AS ARRAY OF STRING
    DIM block AS ARRAY OF STRING : block = []
    DIM i AS INTEGER
    FOR i = z1 - 1 TO z2 - 1
        IF i >= 0 AND i < LEN(alle) THEN ARRAY_PUSH(block, alle[i])
    NEXT
    RETURN block
END FUNCTION

' --- Mehrere Schreibmarken --------------------------------------------
' Alt+Klick legt eine Marke dazu (das kann der Textbereich selbst), ESC
' raeumt sie weg. Hier kommt der Griff dazu, den man wirklich braucht: eine
' Marke auf JEDE Stelle, an der das Wort unter der Marke steht -- danach
' aendert ein Tippen sie alle auf einmal.
' --- Die Ausgabe durchsuchen ------------------------------------------
' Ein laufendes Programm schreibt hunderte Zeilen; die eine, die man sucht,
' findet man sonst nur durch Scrollen. Gesucht wird AB der gewaehlten Zeile
' weiter -- derselbe Aufruf noch einmal ist "weitersuchen".
SUB ausgabeSuchen(ab AS INTEGER)
    DIM n AS INTEGER : n = GUI_LISTBOX_COUNT(lstAusgabe)
    IF n = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Die Ausgabe ist leer."))
        RETURN
    END IF
    DIM klein AS STRING : klein = LOWER$(ausgabeSuchtext)
    DIM i AS INTEGER
    FOR i = MAX(0, ab) TO n - 1
        IF INSTR(LOWER$(GUI_LISTBOX_ITEM(lstAusgabe, i)), klein) >= 0 THEN
            GUI_LISTBOX_SET_SELECTED(lstAusgabe, i)
            GUI_SET_TEXT(lblStatus, tr$("Ausgabe, Zeile ") + STR$(i + 1) + ": " + GUI_LISTBOX_ITEM(lstAusgabe, i))
            protokoll("ausgabe treffer " + STR$(i + 1))
            RETURN
        END IF
    NEXT
    GUI_SET_TEXT(lblStatus, tr$("Nicht in der Ausgabe: ") + ausgabeSuchtext + tr$(" (ab Zeile ") + STR$(MAX(0, ab) + 1) + ")")
    protokoll("ausgabe treffer 0")
END SUB

' --- Von der Ausgabe an die Stelle ------------------------------------
' Meldungen der Laufzeit nennen ihre Stelle als `datei.dh:zeile:` --
' "Laufzeitfehler in spiel.dh:3: ...", "lib.dh:1: Parse-Fehler ...". Ein
' Doppelklick (oder Enter) auf so eine Zeile oeffnet die Datei dort.
' Der Name kann Leerzeichen tragen (C:\Users\Hans Gaming\x.dh), und davor
' steht beliebiger Text: genommen wird das LAENGSTE Stueck vor ".dh:", das
' es als Datei gibt -- gesucht neben dem gelaufenen Programm (dhrt wechselt
' dorthin, seine Meldungen sind relativ dazu), dann im Projekt.
FUNCTION ausgabeOrt(zeile AS STRING) AS TUPLE
    DIM p AS INTEGER : p = INSTR(LOWER$(zeile), ".dh:")
    WHILE p >= 0
        DIM rest AS STRING : rest = MID$(zeile, p + 4)
        DIM ziffern AS INTEGER : ziffern = 0
        WHILE ziffern < LEN(rest) AND INSTR("0123456789", MID$(rest, ziffern, 1)) >= 0
            ziffern = ziffern + 1
        WEND
        IF ziffern > 0 THEN
            DIM nr AS INTEGER : nr = INT(VAL(LEFT$(rest, ziffern)))
            DIM vorn AS STRING : vorn = LEFT$(zeile, p) + ".dh"
            DIM teile AS ARRAY OF STRING : teile = SPLIT$(vorn, " ")
            DIM gefunden AS STRING : gefunden = ""
            DIM kand AS STRING : kand = ""
            DIM i AS INTEGER
            FOR i = LEN(teile) - 1 TO 0 STEP -1
                IF kand = "" THEN kand = teile[i] ELSE kand = teile[i] + " " + kand
                DIM w AS STRING : w = ausgabeWeg$(kand)
                IF w <> "" THEN gefunden = w
            NEXT
            IF gefunden <> "" AND nr >= 1 THEN RETURN (gefunden, nr)
        END IF
        DIM weiter AS INTEGER : weiter = INSTR(LOWER$(MID$(zeile, p + 4)), ".dh:")
        IF weiter < 0 THEN p = -1 ELSE p = p + 4 + weiter
    WEND
    RETURN ("", 0)
END FUNCTION

' Ein Name aus einer Meldung als vorhandene Datei, sonst "".
FUNCTION ausgabeWeg$(name AS STRING) AS STRING
    IF name = "" THEN RETURN ""
    IF MID$(name, 1, 1) = ":" OR LEFT$(name, 1) = "/" OR LEFT$(name, 1) = "\" THEN
        IF FILEEXISTS(name) THEN RETURN name
        RETURN ""
    END IF
    IF prozessDatei <> "" THEN
        DIM a AS STRING : a = PATHJOIN(DIRNAME(prozessDatei), name)
        IF FILEEXISTS(a) THEN RETURN a
    END IF
    IF projektOrdner <> "" THEN
        DIM b AS STRING : b = PATHJOIN(projektOrdner, name)
        IF FILEEXISTS(b) THEN RETURN b
    END IF
    RETURN ""
END FUNCTION

SUB ausgabeAnspringen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstAusgabe)
    IF sel < 0 THEN RETURN
    DIM pfad AS STRING
    DIM nr AS INTEGER
    (pfad, nr) = ausgabeOrt(GUI_LISTBOX_ITEM(lstAusgabe, sel))
    IF pfad = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Diese Zeile nennt keine Stelle."))
        RETURN
    END IF
    dateiOeffnen(pfad)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_TEXTAREA_GOTO(ta, nr, 1)
    GUI_FOCUS(ta)
    protokoll("ausgabe sprung " + BASENAME(pfad) + " " + STR$(nr))
END SUB

' --- Eine Marke auf die NAECHSTE Fundstelle ---------------------------
' Strg+Umschalt+L setzt sie auf alle auf einmal. Schrittweise ist das
' andere, oft bessere Werkzeug: man sieht jede Stelle, bevor sie dazukommt.
DIM mcWort AS STRING : mcWort = ""
DIM mcZeile AS INTEGER : mcZeile = 0
DIM mcSpalte AS INTEGER : mcSpalte = 0

' Die naechste Fundstelle ab (vonZ, vonS) als (zeile, spalte), sonst (-1, -1).
' GANZE Woerter: GUI_TEXTAREA_FIND sucht Teiltexte, und aus `hp` waere sonst
' auch das in `hpmax` eine Marke.
FUNCTION naechsteFundstelle(ta AS GUI_WIDGET, wort AS STRING, vonZ AS INTEGER, vonS AS INTEGER) AS TUPLE
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = GUI_TEXTAREA_FIND(ta, wort, vonZ, vonS, TRUE)
    WHILE tz >= 1 AND tz <= LEN(zeilen)
        DIM zl AS STRING : zl = zeilen[tz - 1]
        DIM davor AS BOOLEAN : davor = ts > 1 AND istWortzeichen(MID$(zl, ts - 2, 1))
        DIM danach AS BOOLEAN : danach = istWortzeichen(MID$(zl, ts - 1 + LEN(wort), 1))
        IF NOT davor AND NOT danach THEN RETURN (tz, ts)
        (tz, ts) = GUI_TEXTAREA_FIND(ta, wort, tz, ts + 1, TRUE)
    WEND
    RETURN (-1, -1)
END FUNCTION

SUB markeNaechste()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF wort = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Unter der Marke steht kein Wort."))
        RETURN
    END IF
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    ' Ein anderes Wort faengt von vorn an -- sonst suchte man mitten in der
    ' Datei weiter nach etwas, das man gerade erst angeklickt hat. Die
    ' fuehrende Marke rueckt dabei an den ANFANG des Wortes: von dort sucht
    ' die naechste Runde weiter, und jede Marke steht an derselben Stelle
    ' ihres Wortes.
    IF wort <> mcWort THEN
        mcWort = wort
        GUI_TEXTAREA_CLEAR_CARETS(ta)
        DIM anf AS INTEGER : anf = wortSpalte(ta)
        IF anf > 0 THEN
            GUI_TEXTAREA_GOTO(ta, z, anf)
            s = anf
        END IF
        mcZeile = z
        mcSpalte = s
    END IF
    DIM vorher AS INTEGER : vorher = GUI_TEXTAREA_CARETS(ta)
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = naechsteFundstelle(ta, wort, mcZeile, mcSpalte + 1)
    ' Nichts mehr dahinter: von vorn.
    IF tz < 0 THEN (tz, ts) = naechsteFundstelle(ta, wort, 1, 1)
    IF tz < 0 THEN
        GUI_SET_TEXT(lblStatus, "'" + wort + tr$("' steht nur an dieser einen Stelle."))
        mcWort = ""
        protokoll("marke naechste 0")
        RETURN
    END IF
    mcZeile = tz
    mcSpalte = ts
    GUI_TEXTAREA_ADD_CARET(ta, tz, ts)
    DIM jetzt AS INTEGER : jetzt = GUI_TEXTAREA_CARETS(ta)
    ' Dieselbe Stelle noch einmal ist keine neue Marke -- dann sind alle
    ' Fundstellen schon markiert, und das sagen wir, statt stumm zu kreisen.
    IF jetzt = vorher THEN
        GUI_SET_TEXT(lblStatus, tr$("Jede Fundstelle von '") + wort + tr$("' hat eine Marke (") + STR$(jetzt) + ").")
    ELSE
        GUI_SET_TEXT(lblStatus, STR$(jetzt) + tr$(" Marken auf '") + wort + "'.")
    END IF
    protokoll("marke naechste " + STR$(jetzt))
END SUB

' --- Ersetzen im ganzen Projekt ---------------------------------------
' Wortwoertlich, oder mit regulaerem Ausdruck, wenn der Schalter an ist --
' dieselbe Wahl wie bei der Suche. Gearbeitet wird auf den DATEIEN; ein
' Reiter mit ungesicherten Aenderungen bricht ab, statt sie zu ueberschreiben.
FUNCTION projektErsetzenZaehlen(gesucht AS STRING) AS TUPLE
    DIM dateien AS ARRAY OF STRING : dateien = projektDateien("*.dh")
    DIM stellen AS INTEGER : stellen = 0
    DIM wieViele AS INTEGER : wieViele = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(projektOrdner, d))
        DIM hier AS INTEGER : hier = 0
        DIM z AS STRING
        FOR EACH z IN zeilen
            IF passtSuche(z, gesucht) THEN hier = hier + 1
        NEXT
        IF hier > 0 THEN
            stellen = stellen + hier
            wieViele = wieViele + 1
        END IF
    NEXT
    RETURN (stellen, wieViele)
END FUNCTION

FUNCTION projektUngesichert() AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF tabPfade[i] <> "" AND GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

SUB projektErsetzenAusfuehren()
    laufStarten("ersetzen", suchtext, ersatztext)
END SUB

' --- Marke an jedes Zeilenende der Auswahl ----------------------------
' Der Griff, mit dem man eine Liste in einem Zug umschreibt: markieren,
' Strg+Umschalt+I, tippen -- und jede Zeile bekommt dasselbe ans Ende.
' --- Die Auswahl am Block entlang erweitern ---------------------------
' Strg+Umschalt+Hoch nimmt jeweils die naechstgroessere Klammer: das Wort,
' die Zeile, der Block darum, dessen Elternblock, zuletzt die ganze Datei.
' Strg+Umschalt+Runter geht denselben Weg zurueck -- dafuer merkt sich ein
' Stapel jede Stufe, statt sie neu zu erraten.
DIM erwZ1 AS ARRAY OF INTEGER : erwZ1 = []
DIM erwS1 AS ARRAY OF INTEGER : erwS1 = []
DIM erwZ2 AS ARRAY OF INTEGER : erwZ2 = []
DIM erwS2 AS ARRAY OF INTEGER : erwS2 = []

SUB erweiternMerken(z1 AS INTEGER, s1 AS INTEGER, z2 AS INTEGER, s2 AS INTEGER)
    ARRAY_PUSH(erwZ1, z1) : ARRAY_PUSH(erwS1, s1)
    ARRAY_PUSH(erwZ2, z2) : ARRAY_PUSH(erwS2, s2)
END SUB

' Der engste Block, der die Zeile ENTHAELT und groesser ist als der
' angegebene Bereich. -1, wenn es keinen mehr gibt.
FUNCTION blockUm(zeile AS INTEGER, hatZ1 AS INTEGER, hatZ2 AS INTEGER) AS INTEGER
    DIM beste AS INTEGER : beste = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(blockVon) - 1
        IF blockVon[i] > zeile OR blockBis[i] < zeile THEN CONTINUE
        ' Echt groesser als das, was schon markiert ist
        IF blockVon[i] >= hatZ1 AND blockBis[i] <= hatZ2 THEN CONTINUE
        IF beste < 0 THEN
            beste = i
        ELSEIF blockBis[i] - blockVon[i] < blockBis[beste] - blockVon[beste] THEN
            beste = i
        END IF
    NEXT
    RETURN beste
END FUNCTION

SUB auswahlErweitern()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM s1 AS INTEGER
    DIM z2 AS INTEGER
    DIM s2 AS INTEGER
    (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    erweiternMerken(z1, s1, z2, s2)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM was AS STRING : was = ""
    IF z1 = z2 AND s1 = s2 THEN
        ' Nichts markiert: das Wort unter der Marke.
        DIM wort AS STRING : wort = wortUnterMarke$()
        DIM anf AS INTEGER : anf = wortSpalte(ta)
        IF wort <> "" AND anf > 0 THEN
            GUI_TEXTAREA_SELECT(ta, z1, anf, z1, anf + LEN(wort))
            was = "Wort"
        ELSE
            GUI_TEXTAREA_SELECT(ta, z1, 1, z1, SPALTE_ENDE)
            was = "Zeile"
        END IF
    ELSEIF z1 = z2 AND NOT (s1 = 1 AND s2 >= LEN(zeilen[z1 - 1]) + 1) THEN
        GUI_TEXTAREA_SELECT(ta, z1, 1, z1, SPALTE_ENDE)
        was = "Zeile"
    ELSE
        DIM b AS INTEGER : b = blockUm(z1, z1, z2)
        IF b >= 0 THEN
            GUI_TEXTAREA_SELECT(ta, blockVon[b], 1, blockBis[b], SPALTE_ENDE)
            was = "Block " + STR$(blockVon[b]) + "-" + STR$(blockBis[b])
        ELSEIF z1 > 1 OR z2 < LEN(zeilen) THEN
            GUI_TEXTAREA_SELECT(ta, 1, 1, LEN(zeilen), SPALTE_ENDE)
            was = "ganze Datei"
        ELSE
            GUI_SET_TEXT(lblStatus, tr$("Größer geht es nicht."))
            protokoll("erweitern ende")
            RETURN
        END IF
    END IF
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, tr$("Auswahl: ") + was)
    protokoll("erweitern " + was)
END SUB

SUB auswahlVerkleinern()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR LEN(erwZ1) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Nichts zum Zurückgehen -- erst erweitern."))
        RETURN
    END IF
    DIM k AS INTEGER : k = LEN(erwZ1) - 1
    GUI_TEXTAREA_SELECT(ta, erwZ1[k], erwS1[k], erwZ2[k], erwS2[k])
    ARRAY_POP(erwZ1) : ARRAY_POP(erwS1) : ARRAY_POP(erwZ2) : ARRAY_POP(erwS2)
    GUI_FOCUS(ta)
    protokoll("verkleinern " + STR$(LEN(erwZ1)))
END SUB

' --- Eine Auswahl in ein Unterprogramm herausloesen -------------------
' Der erste Umbau, der mehr ist als ein Umbenennen. Die gewaehlten Zeilen
' wandern in ein neues SUB am Dateiende, an ihrer Stelle steht der Aufruf.
'
' Was als PARAMETER mitmuss, steht nicht im Raten: globale Namen sieht ein
' SUB ohnehin, also sind es genau die LOKALEN des umgebenden Unterprogramms,
' die in den Zeilen vorkommen. Wird so einer darin auch ZUGEWIESEN, geht er
' BYREF -- sonst kaeme der neue Wert nie zurueck, und das faellt erst beim
' Laufen auf.
' Wie viele FEHLER (keine Warnungen) ein Text hat -- fuer die Probe
' hinterher: ein Umbau, der die Datei kaputt macht, soll das sagen.
FUNCTION fehlerZahl(quelle AS STRING) AS INTEGER
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_CHECK$(quelle, projektOrdner))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM f AS INTEGER : f = 0
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        IF JSON_GET_STRING(j, STR$(i) + ".schwere") = "fehler" THEN f = f + 1
    NEXT
    RETURN f
END FUNCTION

FUNCTION enthaeltWort(text AS STRING, wort AS STRING) AS BOOLEAN
    DIM s AS INTEGER : s = INSTR(text, wort)
    WHILE s >= 0
        DIM davor AS BOOLEAN : davor = s > 0 AND istWortzeichen(MID$(text, s - 1, 1))
        DIM danach AS BOOLEAN : danach = istWortzeichen(MID$(text, s + LEN(wort), 1))
        IF NOT davor AND NOT danach THEN RETURN TRUE
        s = INSTR(text, wort, s + 1)
    WEND
    RETURN FALSE
END FUNCTION

FUNCTION wirdZugewiesen(zeile AS STRING, wort AS STRING) AS BOOLEAN
    DIM t AS STRING : t = LTRIM$(zeile)
    IF LEFT$(t, LEN(wort)) <> wort THEN RETURN FALSE
    IF istWortzeichen(MID$(t, LEN(wort), 1)) THEN RETURN FALSE     ' laengerer Name
    DIM k AS INTEGER : k = LEN(wort)
    ' Index und Feldzugriff gehoeren dazu: `a[i].x = 1` weist `a` zu.
    WHILE k < LEN(t)
        DIM c AS STRING : c = MID$(t, k, 1)
        IF c = "=" THEN RETURN MID$(t, k + 1, 1) <> "="
        IF c = " " OR c = "[" OR c = "]" OR c = "." OR c = "+" OR c = "-" OR istWortzeichen(c) THEN
            k = k + 1
        ELSE
            RETURN FALSE
        END IF
    WEND
    RETURN FALSE
END FUNCTION

' Das Unterprogramm, das die Zeile umschliesst: (von, bis) oder (-1, -1)
' fuers Hauptprogramm. Die Bloecke kommen aus CODE_SYMBOLS$ -- dieselbe
' Quelle wie Gliederung und Faltung.
FUNCTION umgebendesUnterprogramm(quelle AS STRING, zeile AS INTEGER) AS TUPLE
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM bv AS INTEGER : bv = -1
    DIM bb AS INTEGER : bb = -1
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        DIM v AS INTEGER : v = JSON_GET_INT(j, p + ".von")
        DIM b AS INTEGER : b = JSON_GET_INT(j, p + ".bis")
        IF v <= zeile AND zeile <= b AND (bv < 0 OR b - v < bb - bv) THEN
            bv = v : bb = b
        END IF
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            DIM kv AS INTEGER : kv = JSON_GET_INT(j, pk + ".von")
            DIM kb AS INTEGER : kb = JSON_GET_INT(j, pk + ".bis")
            IF kv <= zeile AND zeile <= kb AND (bv < 0 OR kb - kv < bb - bv) THEN
                bv = kv : bb = kb
            END IF
        NEXT
    NEXT
    RETURN (bv, bb)
END FUNCTION

SUB herausloesen(name AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR name = "" THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM quelle AS STRING : quelle = GUI_TEXT(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    IF z2 < z1 OR z2 > LEN(zeilen) THEN RETURN
    DIM block AS ARRAY OF STRING : block = zeilenHolen(zeilen, z1, z2)
    ' Die Parameter: lokale DIMs des umgebenden Unterprogramms, die in den
    ' gewaehlten Zeilen vorkommen.
    DIM uv AS INTEGER
    DIM ub AS INTEGER
    (uv, ub) = umgebendesUnterprogramm(quelle, z1)
    DIM pNamen AS ARRAY OF STRING : pNamen = []
    DIM pTypen AS ARRAY OF STRING : pTypen = []
    DIM pRef AS ARRAY OF INTEGER : pRef = []
    DIM i AS INTEGER
    IF uv > 0 THEN
        FOR i = uv TO MIN(ub, LEN(zeilen))
            IF i >= z1 AND i <= z2 THEN CONTINUE          ' die Auswahl selbst nicht
            DIM t AS STRING : t = TRIM$(zeilen[i - 1])
            IF LEFT$(UPPER$(t), 4) <> "DIM " THEN CONTINUE
            DIM rest AS STRING : rest = TRIM$(MID$(t, 4))
            DIM alsPos AS INTEGER : alsPos = INSTR(UPPER$(rest), " AS ")
            IF alsPos < 0 THEN CONTINUE
            DIM pn AS STRING : pn = TRIM$(LEFT$(rest, alsPos))
            DIM pt AS STRING : pt = TRIM$(MID$(rest, alsPos + 4))
            DIM dp AS INTEGER : dp = INSTR(pt, ":")
            IF dp >= 0 THEN pt = TRIM$(LEFT$(pt, dp))
            IF pn = "" OR INSTR(pn, "[") >= 0 THEN CONTINUE   ' Felder nicht
            IF ARRAY_INDEXOF(pNamen, pn) >= 0 THEN CONTINUE
            DIM gebraucht AS BOOLEAN : gebraucht = FALSE
            DIM zugewiesen AS BOOLEAN : zugewiesen = FALSE
            DIM bz AS STRING
            FOR EACH bz IN block
                IF enthaeltWort(bz, pn) THEN gebraucht = TRUE
                IF wirdZugewiesen(bz, pn) THEN zugewiesen = TRUE
            NEXT
            IF NOT gebraucht THEN CONTINUE
            ARRAY_PUSH(pNamen, pn) : ARRAY_PUSH(pTypen, pt)
            ARRAY_PUSH(pRef, IIF(zugewiesen, 1, 0))
        NEXT
    END IF
    ' Kopfzeile und Aufruf bauen.
    DIM kopf AS STRING : kopf = "SUB " + name + "("
    DIM ruf AS STRING : ruf = name + "("
    FOR i = 0 TO LEN(pNamen) - 1
        IF i > 0 THEN kopf = kopf + ", " : ruf = ruf + ", "
        IF pRef[i] = 1 THEN kopf = kopf + "BYREF "
        kopf = kopf + pNamen[i] + " AS " + pTypen[i]
        ruf = ruf + pNamen[i]
    NEXT
    kopf = kopf + ")"
    ruf = ruf + ")"
    ' Die Zeilen um ihre gemeinsame Einrueckung nach links, dann vier nach
    ' rechts: im neuen SUB fangen sie wieder bei null an.
    DIM tiefe AS INTEGER : tiefe = -1
    DIM bz2 AS STRING
    FOR EACH bz2 IN block
        IF TRIM$(bz2) = "" THEN CONTINUE
        DIM e AS INTEGER : e = LEN(bz2) - LEN(LTRIM$(bz2))
        IF tiefe < 0 OR e < tiefe THEN tiefe = e
    NEXT
    IF tiefe < 0 THEN tiefe = 0
    DIM neuSub AS ARRAY OF STRING : neuSub = []
    ARRAY_PUSH(neuSub, kopf)
    FOR EACH bz2 IN block
        IF TRIM$(bz2) = "" THEN
            ARRAY_PUSH(neuSub, "")
        ELSE
            ARRAY_PUSH(neuSub, "    " + MID$(bz2, tiefe))
        END IF
    NEXT
    ARRAY_PUSH(neuSub, "END SUB")
    ' Der neue Text am Stueck: an der Stelle der Auswahl der Aufruf, am Ende
    ' das Unterprogramm. Nicht zwei Aenderungen hintereinander im Feld --
    ' die Vorschau will EINEN Text zum Vergleichen, und ein Strg+Z nimmt ihn
    ' dann auch in einem Zug zurueck (frueher brauchte es zwei).
    DIM neuZeilen AS ARRAY OF STRING : neuZeilen = []
    DIM zi AS INTEGER
    FOR zi = 1 TO LEN(zeilen)
        IF zi = z1 THEN ARRAY_PUSH(neuZeilen, LEFT$(block[0], tiefe) + ruf)
        IF zi >= z1 AND zi <= z2 THEN CONTINUE
        ARRAY_PUSH(neuZeilen, zeilen[zi - 1])
    NEXT
    ARRAY_PUSH(neuZeilen, "")
    DIM sz AS STRING
    FOR EACH sz IN neuSub
        ARRAY_PUSH(neuZeilen, sz)
    NEXT
    DIM neuText AS STRING : neuText = JOIN$(neuZeilen, NL)
    ' Die Probe: eine unausgewogene Auswahl (das FOR drin, das NEXT nicht)
    ' ergibt Code, der nicht mehr uebersetzt. Das soll dastehen, statt dass
    ' man es beim naechsten Starten sucht.
    DIM vorher AS INTEGER : vorher = fehlerZahl(quelle)
    DIM nachher AS INTEGER : nachher = fehlerZahl(neuText)
    DIM sagen AS STRING
    sagen = STR$(LEN(block)) + " Zeilen -> SUB " + name + " mit " + _
            STR$(LEN(pNamen)) + " Parameter(n). Strg+Z nimmt es zurück."
    IF nachher > vorher THEN
        sagen = "Achtung: " + STR$(nachher - vorher) + " Fehler mehr als vorher -- " + _
                "war die Auswahl ausgewogen? Strg+Z nimmt es zurück."
    END IF
    umbauLeeren()
    umbauVormerken(aktiverTab, tabPfade[aktiverTab], neuText)
    umbauZeile = z1 : umbauSpalte = 1
    umbauStarten("Herauslösen nach SUB " + name, sagen, _
                 "herausgeloest " + name + " " + STR$(LEN(pNamen)) + " " + STR$(nachher - vorher))
END SUB

' --- Die Parameter eines Unterprogramms umsortieren -------------------
' Der zweite Umbau, der mehr ist als ein Umbenennen -- und der erste, der
' die AUFRUFE mitziehen muss: die Reihenfolge der Argumente ist die
' Bedeutung, ein vergessener Aufruf uebergibt stumm das Falsche.
'
' Gearbeitet wird auf dem GANZEN Text, nicht Zeile fuer Zeile: ein Aufruf
' darf ueber mehrere Zeilen gehen (`_` am Ende), und die Argumente werden
' als Textstuecke VERTAUSCHT -- was zwischen ihnen steht, bleibt stehen.
'
' Die Definition selbst braucht keinen Sonderfall: `SUB name(` sieht fuer
' den Sucher aus wie ein Aufruf, und ihre "Argumente" sind die Parameter.

' Leerzeichen und Tabulatoren an den Enden weg -- ZEILENUMBRUECHE aber
' nicht. Ein Argument darf ueber mehrere Zeilen gehen, und dann steht vor
' dem Umbruch ein `_`; naehme man den Umbruch weg, stuende der
' Fortsetzungsstrich mitten in der Zeile und die Datei uebersetzte nicht
' mehr. TRIM$ kann das nicht, es nimmt jeden Leerraum.
FUNCTION randWeg$(s AS STRING) AS STRING
    DIM a AS INTEGER : a = 0
    DIM b AS INTEGER : b = LEN(s)
    WHILE a < b AND (MID$(s, a, 1) = " " OR MID$(s, a, 1) = CHR$(9))
        a = a + 1
    WEND
    WHILE b > a AND (MID$(s, b - 1, 1) = " " OR MID$(s, b - 1, 1) = CHR$(9))
        b = b - 1
    WEND
    RETURN MID$(s, a, b - a)
END FUNCTION

' Steht an `i` (0-basiert) das Wort `wort`, und zwar als ganzes Wort?
FUNCTION wortAn(text AS STRING, i AS INTEGER, wort AS STRING) AS BOOLEAN
    IF MID$(text, i, LEN(wort)) <> wort THEN RETURN FALSE
    IF i > 0 AND istWortzeichen(MID$(text, i - 1, 1)) THEN RETURN FALSE
    IF istWortzeichen(MID$(text, i + LEN(wort), 1)) THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' Die Argumente eines Aufrufs, dessen `(` an `auf` steht: je Argument
' Anfang und Ende (0-basiert, Ende ausschliesslich) in `von`/`bis`.
' Liefert die Stelle der schliessenden Klammer, oder -1, wenn sie fehlt.
'
' Zeichenketten und Kommentare werden uebersprungen -- ein Komma in
' `PRINT "a, b"` ist keine Argumentgrenze.
FUNCTION argsZerlegen(text AS STRING, auf AS INTEGER, von AS ARRAY OF INTEGER, _
                      bis AS ARRAY OF INTEGER) AS INTEGER
    DIM tiefe AS INTEGER : tiefe = 1
    DIM start AS INTEGER : start = auf + 1
    DIM i AS INTEGER : i = auf + 1
    DIM leer AS BOOLEAN : leer = TRUE          ' bisher nur Leerraum gesehen
    WHILE i < LEN(text)
        DIM c AS STRING : c = MID$(text, i, 1)
        IF c = CHR$(34) THEN
            DIM esc AS BOOLEAN : esc = i > 0 AND MID$(text, i - 1, 1) = "!"
            i = i + 1
            WHILE i < LEN(text) AND MID$(text, i, 1) <> CHR$(34)
                IF esc AND MID$(text, i, 1) = "\" THEN i = i + 1
                i = i + 1
            WEND
            leer = FALSE
        ELSEIF c = "'" THEN
            WHILE i < LEN(text) AND MID$(text, i, 1) <> NL
                i = i + 1
            WEND
            CONTINUE
        ELSEIF c = "(" OR c = "[" OR c = "{" THEN
            tiefe = tiefe + 1 : leer = FALSE
        ELSEIF c = ")" OR c = "]" OR c = "}" THEN
            tiefe = tiefe - 1
            IF tiefe = 0 THEN
                IF NOT leer THEN
                    ARRAY_PUSH(von, start) : ARRAY_PUSH(bis, i)
                END IF
                RETURN i
            END IF
            leer = FALSE
        ELSEIF c = "," AND tiefe = 1 THEN
            ARRAY_PUSH(von, start) : ARRAY_PUSH(bis, i)
            start = i + 1
            leer = TRUE
        ELSEIF c <> " " AND c <> CHR$(9) AND c <> NL AND c <> "_" THEN
            leer = FALSE
        END IF
        i = i + 1
    WEND
    RETURN -1
END FUNCTION

' Der Name des Unterprogramms, dessen Parameter gemeint sind, und die
' Stelle seiner oeffnenden Klammer. Erst das Wort unter der Marke (so geht
' es auch von einem Aufruf aus), sonst das Unterprogramm um die Marke.
DIM paramName AS STRING : paramName = ""
DIM paramArgs AS ARRAY OF STRING : paramArgs = []
' Welche Argumente die neue Liste hat: >= 0 ist die Nummer des alten,
' negativ steht fuer einen NEUEN Parameter (-1 = der erste in paramNeuDecl).
DIM paramFolge AS ARRAY OF INTEGER : paramFolge = []
' Je neuem Parameter die Deklaration (fuer die Definition) und der Wert
' (fuer jede Aufrufstelle) -- `hp AS INTEGER = 0` und `0`.
DIM paramNeuDecl AS ARRAY OF STRING : paramNeuDecl = []
DIM paramNeuWert AS ARRAY OF STRING : paramNeuWert = []

FUNCTION defStelle(quelle AS STRING, name AS STRING) AS INTEGER
    IF name = "" THEN RETURN -1
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM pos AS INTEGER : pos = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM t AS STRING : t = UPPER$(TRIM$(zeilen[i]))
        DIM kopf AS BOOLEAN : kopf = LEFT$(t, 4) = "SUB " OR LEFT$(t, 9) = "FUNCTION "
        IF kopf THEN
            DIM s AS INTEGER : s = INSTR(zeilen[i], name)
            WHILE s >= 0
                IF wortAn(zeilen[i], s, name) AND INSTR(MID$(zeilen[i], s + LEN(name)), "(") = 0 THEN
                    RETURN pos + s + LEN(name)
                END IF
                s = INSTR(zeilen[i], name, s + 1)
            WEND
        END IF
        pos = pos + LEN(zeilen[i]) + 1
    NEXT
    RETURN -1
END FUNCTION

SUB parameterFragen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM quelle AS STRING : quelle = GUI_TEXT(ta)
    DIM name AS STRING : name = wortUnterMarke$()
    DIM auf AS INTEGER : auf = defStelle(quelle, name)
    DIM z AS INTEGER
    DIM sp AS INTEGER
    (z, sp) = GUI_TEXTAREA_CURSOR(ta)
    IF auf < 0 THEN
        ' Steht die Marke IN der Argumentliste, ist der Aufruf gemeint --
        ' dieselbe Frage, die auch die Signaturhilfe stellt. Gerade bei einer
        ' Methode steht man oft mitten in den Klammern.
        DIM zeilenM AS ARRAY OF STRING : zeilenM = SPLIT$(quelle, NL)
        IF z >= 1 AND z <= LEN(zeilenM) THEN
            DIM rufName AS STRING
            DIM rufSp AS INTEGER
            DIM rufArg AS INTEGER
            (rufName, rufSp, rufArg) = aufrufUmDieMarke(zeilenM[z - 1], sp)
            IF rufName <> "" THEN
                name = rufName
                auf = defStelle(quelle, name)
            END IF
        END IF
    END IF
    IF auf < 0 THEN
        ' Immer noch nichts: dann das Unterprogramm, in dem die Marke steht.
        DIM uv AS INTEGER
        DIM ub AS INTEGER
        (uv, ub) = umgebendesUnterprogramm(quelle, z)
        IF uv > 0 THEN
            DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
            DIM t AS STRING : t = TRIM$(zeilen[uv - 1])
            DIM ab AS INTEGER : ab = IIF(LEFT$(UPPER$(t), 4) = "SUB ", 4, 9)
            DIM rest AS STRING : rest = TRIM$(MID$(t, ab))
            DIM kl AS INTEGER : kl = INSTR(rest, "(")
            IF kl > 0 THEN
                name = TRIM$(LEFT$(rest, kl))
                auf = defStelle(quelle, name)
            END IF
        END IF
    END IF
    IF auf < 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Parameter umsortieren: erst auf ein SUB oder eine FUNCTION stellen."))
        protokoll("parameter 0")
        RETURN
    END IF
    DIM pvon AS ARRAY OF INTEGER : pvon = []
    DIM pbis AS ARRAY OF INTEGER : pbis = []
    ' Auch ohne Parameter aufmachen: mit [+ Parameter] ist das der Weg, dem
    ' Unterprogramm seinen ersten zu geben.
    IF argsZerlegen(quelle, auf, pvon, pbis) < 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Parameter: bei '") + name + tr$("' fehlt die schließende Klammer."))
        protokoll("parameter 0")
        RETURN
    END IF
    paramName = name
    paramArgs = [] : paramFolge = [] : paramNeuDecl = [] : paramNeuWert = []
    DIM k AS INTEGER
    FOR k = 0 TO LEN(pvon) - 1
        DIM stueck AS STRING : stueck = TRIM$(MID$(quelle, pvon[k], pbis[k] - pvon[k]))
        ARRAY_PUSH(paramArgs, stueck)
        ARRAY_PUSH(paramFolge, k)
    NEXT
    parameterListe()
    GUI_LISTBOX_SET_SELECTED(lstParam, 0)
    ' Immer an dieselbe Stelle: ein Fenster, das dort aufgeht, wo man es
    ' zuletzt hingeschoben hat, sucht man beim naechsten Mal.
    GUI_WINDOW_SET_BOUNDS(winParam, 420, 200, 460, 320)
    GUI_WINDOW_TITLE(winParam, tr$("Parameter von ") + name)
    GUI_WINDOW_VISIBLE(winParam, TRUE)
    GUI_FOCUS(lstParam)
    protokoll("parameter " + STR$(LEN(paramArgs)))
END SUB

SUB parameterSchieben(richtung AS INTEGER)
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstParam)
    DIM ziel AS INTEGER : ziel = sel + richtung
    IF sel < 0 OR ziel < 0 OR ziel >= LEN(paramFolge) THEN RETURN
    DIM h AS INTEGER : h = paramFolge[sel]
    paramFolge[sel] = paramFolge[ziel] : paramFolge[ziel] = h
    parameterListe()
    GUI_LISTBOX_SET_SELECTED(lstParam, ziel)
END SUB

' Alle Stellen, an denen `name` als AUFRUF steht (Name, dann `(`) --
' geliefert werden die 0-basierten Stellen der oeffnenden Klammer.
' Zeichenketten und Kommentare bleiben aussen vor.
SUB aufrufStellen(quelle AS STRING, name AS STRING, stellen AS ARRAY OF INTEGER)
    DIM i AS INTEGER : i = 0
    WHILE i < LEN(quelle)
        DIM c AS STRING : c = MID$(quelle, i, 1)
        IF c = CHR$(34) THEN
            i = i + 1
            WHILE i < LEN(quelle) AND MID$(quelle, i, 1) <> CHR$(34)
                i = i + 1
            WEND
        ELSEIF c = "'" THEN
            WHILE i < LEN(quelle) AND MID$(quelle, i, 1) <> NL
                i = i + 1
            WEND
        ELSEIF wortAn(quelle, i, name) THEN
            DIM j AS INTEGER : j = i + LEN(name)
            WHILE j < LEN(quelle) AND MID$(quelle, j, 1) = " "
                j = j + 1
            WEND
            IF MID$(quelle, j, 1) = "(" THEN ARRAY_PUSH(stellen, j)
            i = j - 1
        END IF
        i = i + 1
    WEND
END SUB

' Die Argumente aller Aufrufe von `name` in `quelle` umbauen.
'
' `folge` sagt, woraus die neue Liste besteht: eine Zahl >= 0 ist die
' Nummer des alten Arguments, eine negative steht fuer einen NEUEN
' Parameter -- `-1` meint `neuDecl[0]`/`neuWert[0]`, `-2` den naechsten.
' Zwei Texte je neuem Parameter, weil die DEFINITION eine Deklaration
' braucht (`hp AS INTEGER = 0`) und der Aufruf einen Wert (`0`).
'
' `alteZahl` ist die Zahl der Parameter VORHER: nur Aufrufe mit genau so
' vielen Argumenten werden angefasst.
' `zaehler` kommt gefuellt zurueck: [0] geaenderte Stellen, [1] uebergangene.
FUNCTION parameterInText$(quelle AS STRING, name AS STRING, folge AS ARRAY OF INTEGER, _
                          neuDecl AS ARRAY OF STRING, neuWert AS ARRAY OF STRING, _
                          alteZahl AS INTEGER, zaehler AS ARRAY OF INTEGER) AS STRING
    DIM neu AS STRING : neu = quelle
    DIM stellen AS ARRAY OF INTEGER : stellen = []
    aufrufStellen(quelle, name, stellen)
    ' Die Definition ist fuer den Sucher ein Aufruf wie jeder andere -- nur
    ' bekommt sie die Deklarationen statt der Werte.
    DIM defAuf AS INTEGER : defAuf = defStelle(quelle, name)
    DIM geaendert AS INTEGER : geaendert = 0
    DIM uebergangen AS INTEGER : uebergangen = 0
    DIM k AS INTEGER
    DIM s AS INTEGER
    ' Von HINTEN nach vorn ersetzen: dann bleiben die Stellen davor gueltig.
    FOR s = LEN(stellen) - 1 TO 0 STEP -1
        DIM avon AS ARRAY OF INTEGER : avon = []
        DIM abis AS ARRAY OF INTEGER : abis = []
        DIM zu AS INTEGER : zu = argsZerlegen(quelle, stellen[s], avon, abis)
        ' Nur Aufrufe mit genau so vielen Argumenten: wer einen Vorgabewert
        ' weglaesst oder mit Namen uebergibt (`x: 1`), meint eine andere
        ' Zuordnung -- die still umzustellen waere schlimmer als es zu lassen.
        IF zu < 0 OR LEN(avon) <> alteZahl THEN
            IF zu >= 0 AND LEN(avon) > 0 THEN uebergangen = uebergangen + 1
            CONTINUE
        END IF
        DIM benannt AS BOOLEAN : benannt = FALSE
        DIM stuecke AS ARRAY OF STRING : stuecke = []
        FOR k = 0 TO LEN(avon) - 1
            DIM roh AS STRING : roh = MID$(quelle, avon[k], abis[k] - avon[k])
            IF INSTR(roh, ":") >= 0 THEN benannt = TRUE
            ARRAY_PUSH(stuecke, roh)
        NEXT
        IF benannt THEN
            uebergangen = uebergangen + 1
            CONTINUE
        END IF
        DIM istDef AS BOOLEAN : istDef = stellen[s] = defAuf
        DIM neuArgs AS ARRAY OF STRING : neuArgs = []
        FOR k = 0 TO LEN(folge) - 1
            IF folge[k] >= 0 THEN
                ARRAY_PUSH(neuArgs, randWeg$(stuecke[folge[k]]))
            ELSE
                DIM j AS INTEGER : j = -folge[k] - 1
                ARRAY_PUSH(neuArgs, IIF(istDef, neuDecl[j], neuWert[j]))
            END IF
        NEXT
        neu = LEFT$(neu, avon[0]) + JOIN$(neuArgs, ", ") + MID$(neu, abis[LEN(abis) - 1])
        geaendert = geaendert + 1
    NEXT
    ARRAY_PUSH(zaehler, geaendert)
    ARRAY_PUSH(zaehler, uebergangen)
    RETURN neu
END FUNCTION

' Hat ein ANDERER Reiter als `ausser` ungesicherte Aenderungen?
FUNCTION andererUngesichert(ausser AS INTEGER) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF i <> ausser AND tabPfade[i] <> "" AND GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Die Liste im Fenster neu aus `paramFolge` aufbauen.
SUB parameterListe()
    GUI_LISTBOX_CLEAR(lstParam)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(paramFolge) - 1
        IF paramFolge[k] >= 0 THEN
            GUI_LISTBOX_ADD(lstParam, paramArgs[paramFolge[k]])
        ELSE
            GUI_LISTBOX_ADD(lstParam, paramNeuDecl[-paramFolge[k] - 1] + "   [neu]")
        END IF
    NEXT
    GUI_SET_TEXT(lblParam, STR$(LEN(paramFolge)) + tr$(" Parameter (vorher ") + _
                 STR$(LEN(paramArgs)) + ") -- die Aufrufe ziehen mit.")
END SUB

' Einen neuen Parameter aufnehmen. `text` ist eine Deklaration mit Wert,
' also `hp AS INTEGER = 0`: die Definition bekommt sie ganz, jede
' Aufrufstelle nur den Teil hinter dem Gleichheitszeichen.
SUB parameterNeu(text AS STRING)
    DIM t AS STRING : t = TRIM$(text)
    DIM gl AS INTEGER : gl = INSTR(t, "=")
    IF t = "" OR gl < 0 OR TRIM$(MID$(t, gl + 1)) = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Neuer Parameter: bitte in der Form 'hp AS INTEGER = 0' -- ") + _
                     "der Wert hinter dem = kommt an jede Aufrufstelle.")
        RETURN
    END IF
    ARRAY_PUSH(paramNeuDecl, t)
    ARRAY_PUSH(paramNeuWert, TRIM$(MID$(t, gl + 1)))
    ARRAY_PUSH(paramFolge, -LEN(paramNeuDecl))
    parameterListe()
    GUI_LISTBOX_SET_SELECTED(lstParam, LEN(paramFolge) - 1)
    GUI_FOCUS(lstParam)
    protokoll("parameter neu " + t)
END SUB

SUB parameterWeg()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstParam)
    IF sel < 0 OR sel >= LEN(paramFolge) THEN RETURN
    IF LEN(paramFolge) <= 1 THEN
        GUI_SET_TEXT(lblStatus, tr$("Der letzte Parameter bleibt -- ein Unterprogramm ganz ohne ") + _
                     "Klammerinhalt wäre ein anderer Umbau.")
        RETURN
    END IF
    ARRAY_REMOVE_AT(paramFolge, sel)
    parameterListe()
    GUI_LISTBOX_SET_SELECTED(lstParam, MIN(sel, LEN(paramFolge) - 1))
    GUI_FOCUS(lstParam)
    protokoll("parameter weg " + STR$(sel))
END SUB

SUB parameterUebernehmen()
    GUI_WINDOW_VISIBLE(winParam, FALSE)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR paramName = "" THEN RETURN
    DIM gleich AS BOOLEAN : gleich = LEN(paramFolge) = LEN(paramArgs)
    DIM k AS INTEGER
    IF gleich THEN
        FOR k = 0 TO LEN(paramFolge) - 1
            IF paramFolge[k] <> k THEN gleich = FALSE
        NEXT
    END IF
    IF gleich THEN
        GUI_SET_TEXT(lblStatus, tr$("Parameter umsortieren: nichts geändert."))
        GUI_FOCUS(ta)
        RETURN
    END IF
    ' Ein Unterprogramm wird selten nur in seiner eigenen Datei gerufen --
    ' der Umbau geht darum durch ALLE .dh des Projektordners. Dort steht
    ' aber nur, was gesichert ist.
    IF andererUngesichert(aktiverTab) THEN
        GUI_SET_TEXT(lblStatus, tr$("Erst sichern: ein anderer Reiter hat ungesicherte Änderungen."))
        protokoll("parameter umgestellt -1 0")
        GUI_FOCUS(ta)
        RETURN
    END IF
    umbauLeeren()
    ' Die Marke bleibt, wo sie war -- ein Umbau ueber die ganze Datei setzt
    ' sie sonst ans ENDE, und der naechste Griff traefe nichts mehr.
    DIM mz AS INTEGER
    DIM ms AS INTEGER
    (mz, ms) = GUI_TEXTAREA_CURSOR(ta)
    umbauZeile = mz : umbauSpalte = ms
    DIM alteZahl AS INTEGER : alteZahl = LEN(paramArgs)
    DIM zaehler AS ARRAY OF INTEGER : zaehler = []
    DIM neu AS STRING
    neu = parameterInText$(GUI_TEXT(ta), paramName, paramFolge, paramNeuDecl, paramNeuWert, _
                           alteZahl, zaehler)
    DIM geaendert AS INTEGER : geaendert = zaehler[0]
    DIM uebergangen AS INTEGER : uebergangen = zaehler[1]
    umbauVormerken(aktiverTab, tabPfade[aktiverTab], neu)
    ' Die uebrigen Dateien sammelt der Schritt-Laeufer (ESC bricht ab) --
    ' bei vierhundert Dateien steht die IDE sonst lange genug, dass man sie
    ' fuer haengend haelt. Die Zaehler dieser Datei gehen als Startwert mit.
    laufZahl = alteZahl
    laufStarten("parameter", paramName, "")
    laufGeaendert = geaendert
    laufUebergangen = uebergangen
    GUI_FOCUS(ta)
END SUB

' --- Ein Unterprogramm in eine andere Datei verschieben ---------------
' Der Umbau ueber DATEIgrenzen: die Zeilen wandern, und die Aufrufer
' bekommen den IMPORT dazu, den sie dafuer brauchen. In Drachenhauch
' fuegt `IMPORT "datei.dh"` den Text ein -- wer das Unterprogramm ruft,
' muss die Datei also nennen, in der es jetzt steht. Ohne diesen Teil
' waere das Verschieben ein Umbau, der die Uebersetzung kaputt macht.
DIM verschName AS STRING : verschName = ""
DIM verschVon AS INTEGER : verschVon = 0
DIM verschBis AS INTEGER : verschBis = 0

' Nennt `quelle` die Datei `datei` schon in einem IMPORT?
FUNCTION importiert(quelle AS STRING, datei AS STRING) AS BOOLEAN
    DIM klein AS STRING : klein = LOWER$(datei)
    DIM zl AS STRING
    FOR EACH zl IN SPLIT$(quelle, NL)
        DIM t AS STRING : t = LOWER$(TRIM$(zl))
        IF LEFT$(t, 7) <> "import " THEN CONTINUE
        IF INSTR(t, klein) >= 0 THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Einen IMPORT einsetzen: hinter den letzten vorhandenen, sonst vor die
' erste Zeile, die kein Kommentar und nicht leer ist. Ganz oben waere
' falsch -- dort steht bei fast jeder Datei der Kopfkommentar.
FUNCTION mitImport$(quelle AS STRING, datei AS STRING) AS STRING
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM letzterImport AS INTEGER : letzterImport = -1
    DIM ersteEchte AS INTEGER : ersteEchte = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM t AS STRING : t = TRIM$(zeilen[i])
        IF LEFT$(LOWER$(t), 7) = "import " THEN letzterImport = i
        IF ersteEchte < 0 AND t <> "" AND LEFT$(t, 1) <> "'" THEN ersteEchte = i
    NEXT
    DIM wo AS INTEGER : wo = letzterImport + 1
    IF letzterImport < 0 THEN wo = MAX(ersteEchte, 0)
    ARRAY_INSERT(zeilen, wo, "IMPORT " + CHR$(34) + datei + CHR$(34))
    RETURN JOIN$(zeilen, NL)
END FUNCTION

' Die CLASS, in der `zeile` steht: (name, von, bis) -- ("", 0, 0), wenn
' keine. Eine Methode allein laesst sich nicht verschieben; ihre KLASSE
' sehr wohl, und die ist dann gemeint.
FUNCTION klasseUm(quelle AS STRING, zeile AS INTEGER) AS TUPLE
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "") - 1
        DIM p AS STRING : p = STR$(i)
        IF LOWER$(JSON_GET_STRING(j, p + ".art")) <> "class" THEN CONTINUE
        DIM v AS INTEGER : v = JSON_GET_INT(j, p + ".von")
        DIM b AS INTEGER : b = JSON_GET_INT(j, p + ".bis")
        IF v <= zeile AND zeile <= b THEN RETURN (JSON_GET_STRING(j, p + ".name"), v, b)
    NEXT
    RETURN ("", 0, 0)
END FUNCTION

' Kommt `name` in der Zeile als ganzes Wort vor, ausserhalb von Kommentar
' und Zeichenkette?
'
' Fuer die IMPORT-Frage ist das die richtige: eine Klasse wird nicht nur
' mit `NEW Tier(` benutzt, sondern auch als `DIM t AS Tier` -- und ein
' Unterprogramm kann als FUNCREF ohne Klammern dastehen.
FUNCTION benutztWort(zeile AS STRING, name AS STRING) AS BOOLEAN
    DIM i AS INTEGER : i = 0
    WHILE i < LEN(zeile)
        DIM c AS STRING : c = MID$(zeile, i, 1)
        IF c = CHR$(34) THEN
            i = i + 1
            WHILE i < LEN(zeile) AND MID$(zeile, i, 1) <> CHR$(34)
                i = i + 1
            WEND
        ELSEIF c = "'" THEN
            RETURN FALSE
        ELSEIF wortAn(zeile, i, name) THEN
            RETURN TRUE
        END IF
        i = i + 1
    WEND
    RETURN FALSE
END FUNCTION

' Der Name, den eine CONST- oder DIM-Zeile auf oberster Ebene anlegt --
' "" wenn die Zeile keine ist. Eine Zeile in einem Unterprogramm zaehlt
' nicht: die ist dort lokal und woanders sinnlos.
FUNCTION einzelzeileName$(quelle AS STRING, zeile AS INTEGER) AS STRING
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    IF zeile < 1 OR zeile > LEN(zeilen) THEN RETURN ""
    DIM t AS STRING : t = TRIM$(zeilen[zeile - 1])
    DIM gross AS STRING : gross = UPPER$(t)
    DIM ab AS INTEGER : ab = -1
    IF LEFT$(gross, 6) = "CONST " THEN ab = 6
    IF LEFT$(gross, 4) = "DIM " THEN ab = 4
    IF ab < 0 THEN RETURN ""
    DIM rest AS STRING : rest = TRIM$(MID$(t, ab))
    ' Der Name endet am ersten Zeichen, das keines mehr ist.
    DIM i AS INTEGER : i = 0
    WHILE i < LEN(rest) AND istWortzeichen(MID$(rest, i, 1))
        i = i + 1
    WEND
    RETURN LEFT$(rest, i)
END FUNCTION

' Hat `quelle` ein Symbol namens `name`? Geliefert wird "SUB gruessen"
' oder "", damit die Meldung sagen kann, WAS dort steht.
FUNCTION symbolInDatei$(quelle AS STRING, name AS STRING) AS STRING
    IF quelle = "" OR name = "" THEN RETURN ""
    DIM klein AS STRING : klein = LOWER$(name)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "") - 1
        DIM p AS STRING : p = STR$(i)
        IF LOWER$(JSON_GET_STRING(j, p + ".name")) = klein THEN
            RETURN JSON_GET_STRING(j, p + ".art") + " " + JSON_GET_STRING(j, p + ".name")
        END IF
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            IF LOWER$(JSON_GET_STRING(j, pk + ".name")) = klein THEN
                RETURN JSON_GET_STRING(j, pk + ".name") + " (in " + _
                       JSON_GET_STRING(j, p + ".name") + ")"
            END IF
        NEXT
    NEXT
    RETURN ""
END FUNCTION

SUB verschiebenFragen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR tabPfade[aktiverTab] = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Verschieben: diese Datei ist noch nicht gesichert."))
        protokoll("verschieben 0")
        RETURN
    END IF
    DIM quelle AS STRING : quelle = GUI_TEXT(ta)
    DIM z AS INTEGER
    DIM sp AS INTEGER
    (z, sp) = GUI_TEXTAREA_CURSOR(ta)
    ' Steht die Marke in einer KLASSE, ist die Klasse gemeint -- eine
    ' Methode allein waere ohne sie kein Unterprogramm mehr.
    DIM kName AS STRING
    DIM kVon AS INTEGER
    DIM kBis AS INTEGER
    (kName, kVon, kBis) = klasseUm(quelle, z)
    verschName = ""
    DIM uv AS INTEGER
    DIM ub AS INTEGER
    IF kName <> "" THEN
        verschName = kName : verschVon = kVon : verschBis = kBis
    ELSE
        (uv, ub) = umgebendesUnterprogramm(quelle, z)
        ' Nicht IM Unterprogramm, aber auf seinem Namen? Dann ist es gemeint.
        IF uv < 1 THEN
            DIM wort AS STRING : wort = wortUnterMarke$()
            DIM auf AS INTEGER : auf = defStelle(quelle, wort)
            IF auf >= 0 THEN
                DIM bis AS INTEGER : bis = 1 + LEN(SPLIT$(LEFT$(quelle, auf), NL)) - 1
                (uv, ub) = umgebendesUnterprogramm(quelle, bis)
            END IF
        END IF
        ' Auch eine CONST- oder DIM-Zeile ganz oben laesst sich verschieben:
        ' die Einheit ist dann DIE ZEILE. Sie gehoert oft zu dem, was man
        ' gerade woanders hinlegt, und von Hand kopiert man sie nach.
        IF uv < 1 THEN
            DIM eName AS STRING : eName = einzelzeileName$(quelle, z)
            IF eName <> "" THEN
                verschName = eName : verschVon = z : verschBis = z
            END IF
        END IF
        IF uv < 1 AND verschName = "" THEN
            GUI_SET_TEXT(lblStatus, tr$("Verschieben: erst in ein SUB, eine FUNCTION, eine CLASS ") + _
                         "oder auf eine CONST-/DIM-Zeile stellen.")
            protokoll("verschieben 0")
            RETURN
        END IF
        IF uv >= 1 THEN
            verschName = unterprogrammName$(quelle, uv)
            verschVon = uv
            verschBis = ub
            IF verschName = "" THEN
                GUI_SET_TEXT(lblStatus, tr$("Verschieben: hier steht kein Unterprogramm mit Namen."))
                protokoll("verschieben 0")
                RETURN
            END IF
        END IF
    END IF
    ' Die Zieldatei waehlen -- alle .dh des Projekts ausser dieser, und
    ' ganz oben eine neue. Ohne die waere der erste Umzug in eine frische
    ' Datei ein Umweg ueber Datei/Neu und Sichern.
    paletteNamen = []
    paletteKennungen = []
    paletteDetails = []
    ARRAY_PUSH(paletteNamen, "(neue Datei ...)") : ARRAY_PUSH(paletteKennungen, "*neu*") : ARRAY_PUSH(paletteDetails, "")
    DIM d AS STRING
    FOR EACH d IN projektDateien("*.dh")
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        IF wegGleich$(pfad) = wegGleich$(tabPfade[aktiverTab]) THEN CONTINUE
        ARRAY_PUSH(paletteNamen, d) : ARRAY_PUSH(paletteKennungen, pfad) : ARRAY_PUSH(paletteDetails, "")
    NEXT
    waehlerOeffnen("verschieben", verschName + tr$(" verschieben nach ..."))
END SUB

SUB verschiebenNach(ziel AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR verschName = "" THEN RETURN
    IF andererUngesichert(aktiverTab) THEN
        GUI_SET_TEXT(lblStatus, tr$("Erst sichern: ein anderer Reiter hat ungesicherte Änderungen."))
        protokoll("verschieben -1")
        RETURN
    END IF
    DIM quelle AS STRING : quelle = GUI_TEXT(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    IF verschBis > LEN(zeilen) THEN RETURN
    DIM block AS ARRAY OF STRING : block = zeilenHolen(zeilen, verschVon, verschBis)
    ' Kommentarzeilen unmittelbar davor gehoeren dazu -- sie beschreiben
    ' das Unterprogramm, und allein zurueckgelassen beschreiben sie nichts.
    DIM kopf AS INTEGER : kopf = verschVon
    WHILE kopf > 1 AND LEFT$(TRIM$(zeilen[kopf - 2]), 1) = "'"
        kopf = kopf - 1
    WEND
    IF kopf < verschVon THEN block = zeilenHolen(zeilen, kopf, verschBis)
    DIM zielName AS STRING : zielName = BASENAME(ziel)
    DIM meinName AS STRING : meinName = BASENAME(tabPfade[aktiverTab])
    umbauLeeren()
    ' 1. Die Quelle: die Zeilen heraus, und wenn sie das Unterprogramm noch
    '    ruft, den IMPORT der Zieldatei hinein.
    DIM rest AS ARRAY OF STRING : rest = []
    DIM i AS INTEGER
    FOR i = 1 TO LEN(zeilen)
        IF i >= kopf AND i <= verschBis THEN CONTINUE
        ARRAY_PUSH(rest, zeilen[i - 1])
    NEXT
    DIM neuQuelle AS STRING : neuQuelle = JOIN$(rest, NL)
    DIM ruftNoch AS BOOLEAN : ruftNoch = FALSE
    DIM zl AS STRING
    FOR EACH zl IN rest
        IF benutztWort(zl, verschName) THEN ruftNoch = TRUE
    NEXT
    IF ruftNoch AND NOT importiert(neuQuelle, zielName) THEN
        neuQuelle = mitImport$(neuQuelle, zielName)
    END IF
    umbauVormerken(aktiverTab, tabPfade[aktiverTab], neuQuelle)
    ' 1b. Was der Block SELBST braucht: ruft er Unterprogramme, die in der
    '     Quelle bleiben, muss die ZIELdatei die Quelle importieren. Sonst
    '     wandert das Unterprogramm weg und findet seine Helfer nicht mehr.
    DIM brauchtQuelle AS BOOLEAN : brauchtQuelle = FALSE
    ' Die Namen, die in der Quelle BLEIBEN: Unterprogramme und Klassen
    ' (CODE_SYMBOLS$) UND die Konstanten und globalen Variablen ganz oben --
    ' die kennt CODE_SYMBOLS$ nicht, und `CONST MAXHP` ist genauso ein
    ' Grund fuer den IMPORT wie ein Unterprogramm.
    DIM bleibt AS ARRAY OF STRING : bleibt = []
    DIM symVon AS ARRAY OF INTEGER : symVon = []
    DIM symBis AS ARRAY OF INTEGER : symBis = []
    DIM sym AS JSON_HANDLE : sym = JSON_PARSE(CODE_SYMBOLS$(neuQuelle))
    DIM si AS INTEGER
    FOR si = 0 TO JSON_LEN(sym, "") - 1
        DIM sp AS STRING : sp = STR$(si)
        ARRAY_PUSH(bleibt, JSON_GET_STRING(sym, sp + ".name"))
        ARRAY_PUSH(symVon, JSON_GET_INT(sym, sp + ".von"))
        ARRAY_PUSH(symBis, JSON_GET_INT(sym, sp + ".bis"))
    NEXT
    ' Nur Zeilen auf OBERSTER Ebene: ein `DIM i` in einem Unterprogramm ist
    ' dort lokal und kein Grund fuer irgendeinen IMPORT.
    DIM restZ AS INTEGER
    FOR restZ = 1 TO LEN(rest)
        DIM drin AS BOOLEAN : drin = FALSE
        DIM sk AS INTEGER
        FOR sk = 0 TO LEN(symVon) - 1
            IF symVon[sk] <= restZ AND restZ <= symBis[sk] THEN drin = TRUE
        NEXT
        IF drin THEN CONTINUE
        DIM eName AS STRING : eName = einzelzeileName$(neuQuelle, restZ)
        IF eName <> "" THEN ARRAY_PUSH(bleibt, eName)
    NEXT
    DIM sname AS STRING
    FOR EACH sname IN bleibt
        IF sname = "" OR LOWER$(sname) = LOWER$(verschName) THEN CONTINUE
        DIM bz AS STRING
        FOR EACH bz IN block
            IF benutztWort(bz, sname) THEN brauchtQuelle = TRUE
        NEXT
    NEXT
    ' 2. Das Ziel: der Block ans Ende.
    DIM zielText AS STRING : zielText = ""
    TRY
        zielText = JOIN$(READLINES(ziel), NL)
    CATCH e
        ' Eine neue Datei -- sie entsteht beim Uebernehmen.
        zielText = "' " + BASENAME(ziel)
    END TRY
    DIM zielNeu AS STRING : zielNeu = zielText
    IF TRIM$(zielNeu) <> "" THEN zielNeu = zielNeu + NL
    zielNeu = zielNeu + NL + JOIN$(block, NL)
    IF brauchtQuelle AND NOT importiert(zielNeu, meinName) THEN
        zielNeu = mitImport$(zielNeu, meinName)
    END IF
    DIM zielTab AS INTEGER : zielTab = tabMitPfad(ziel)
    umbauVormerken(zielTab, ziel, zielNeu)
    ' Gibt es den Namen im ZIEL schon? Dann verdeckt einer den anderen --
    ' und zwar ohne Uebersetzungsfehler, der zweite gewinnt einfach. Das
    ' merkt man erst, wenn das Falsche laeuft.
    DIM dort AS STRING : dort = symbolInDatei$(zielText, verschName)
    IF dort <> "" THEN
        umbauWarnung = "Achtung: " + zielName + " hat schon " + dort + _
                       " -- danach stehen zwei gleichen Namens in einer Datei."
    END IF
    ' Die Probe wie beim Herausloesen: wird es dadurch schlimmer, soll das
    ' dastehen, bevor jemand es beim naechsten Starten sucht.
    DIM vorher AS INTEGER : vorher = fehlerZahl(quelle)
    DIM nachher AS INTEGER : nachher = fehlerZahl(neuQuelle)
    IF nachher > vorher THEN
        umbauWarnung = "Achtung: " + STR$(nachher - vorher) + " Fehler mehr in " + meinName + _
                       " -- benutzt das Unterprogramm etwas, das nur dort steht?"
    END IF
    ' 3. Alle anderen Dateien, die es rufen, brauchen den IMPORT auch --
    '    gesammelt in Schritten (ESC bricht ab), wie bei den beiden anderen
    '    projektweiten Umbauten. Der Rest der Meldung entsteht dort.
    laufZiel = ziel
    laufBlock = LEN(block)
    laufStarten("verschieben", verschName, "")
END SUB

' --- Wer ruft das auf? (Umschalt+F12) ---------------------------------
' Die Gegenrichtung zu "Zur Definition": alle Stellen, an denen das
' Unterprogramm unter der Marke GERUFEN wird, ueber alle Dateien des
' Projekts. Die Definition selbst steht nicht dabei -- sie ist kein Aufruf,
' und wer sie sucht, hat F12.
'
' Als BAUM, nicht als Liste: unter jedem Aufruf stehen die Aufrufer des
' Unterprogramms, in dem er steht. Wer wissen will, wie eine Funktion
' ueberhaupt erreicht wird, sieht es damit in einem Bild statt in vier
' Suchen.
'
' Gesucht wird ZEILENweise: in Drachenhauch enden Kommentar und
' Zeichenkette an der Zeile, also ist eine Zeile fuer sich vollstaendig zu
' lesen. Das spart die Umrechnung von Zeichenstelle zu Zeilennummer.
FUNCTION aufrufInZeile(zeile AS STRING, name AS STRING) AS BOOLEAN
    DIM t AS STRING : t = UPPER$(TRIM$(zeile))
    IF LEFT$(t, 4) = "SUB " OR LEFT$(t, 9) = "FUNCTION " THEN RETURN FALSE
    DIM i AS INTEGER : i = 0
    WHILE i < LEN(zeile)
        DIM c AS STRING : c = MID$(zeile, i, 1)
        IF c = CHR$(34) THEN
            i = i + 1
            WHILE i < LEN(zeile) AND MID$(zeile, i, 1) <> CHR$(34)
                i = i + 1
            WEND
        ELSEIF c = "'" THEN
            RETURN FALSE
        ELSEIF wortAn(zeile, i, name) THEN
            DIM j AS INTEGER : j = i + LEN(name)
            WHILE j < LEN(zeile) AND MID$(zeile, j, 1) = " "
                j = j + 1
            WEND
            IF MID$(zeile, j, 1) = "(" THEN RETURN TRUE
            ' Ohne Klammern ist es eine FUNCREF: der Name wird als WERT
            ' weitergegeben (`GUI_ON_CLICK(knopf, malen)`, `f = malen`) und
            ' spaeter gerufen. Wer wissen will, wie ein Unterprogramm
            ' erreicht wird, muss genau diese Stelle sehen -- sie ist die
            ' einzige, an der der Name ueberhaupt vorkommt.
            IF nameAlsWert(zeile, i, name) THEN RETURN TRUE
            i = j - 1
        END IF
        i = i + 1
    WEND
    RETURN FALSE
END FUNCTION

' Steht der Name an `i` als WERT da (FUNCREF), nicht als Aufruf?
'
' Ausgenommen ist, was ihn nur ERWAEHNT: die eigene Kopfzeile faengt der
' Aufrufer ab, und nach einem Punkt steht ein Feldname (`held.malen` ohne
' Klammern ist eine gebundene Methode -- die zaehlt, aber `x.malen` als
' Feld nicht; das auseinanderzuhalten braucht Typen, die hier keiner hat).
FUNCTION nameAlsWert(zeile AS STRING, i AS INTEGER, name AS STRING) AS BOOLEAN
    IF i > 0 AND MID$(zeile, i - 1, 1) = "." THEN RETURN FALSE
    ' Ein Wort, das nur in einer DIM-Zeile als TYP steht, ist keiner.
    DIM t AS STRING : t = UPPER$(TRIM$(zeile))
    IF LEFT$(t, 4) = "DIM " AND INSTR(t, " AS " + UPPER$(name)) >= 0 THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' Der Name des Unterprogramms, in dem `zeile` steht -- "" fuers
' Hauptprogramm.
FUNCTION unterprogrammName$(quelle AS STRING, zeile AS INTEGER) AS STRING
    DIM uv AS INTEGER
    DIM ub AS INTEGER
    (uv, ub) = umgebendesUnterprogramm(quelle, zeile)
    IF uv < 1 THEN RETURN ""
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    IF uv > LEN(zeilen) THEN RETURN ""
    DIM t AS STRING : t = TRIM$(zeilen[uv - 1])
    DIM gross AS STRING : gross = UPPER$(t)
    DIM ab AS INTEGER : ab = -1
    IF LEFT$(gross, 4) = "SUB " THEN ab = 4
    IF LEFT$(gross, 9) = "FUNCTION " THEN ab = 9
    IF ab < 0 THEN RETURN ""
    DIM rest AS STRING : rest = TRIM$(MID$(t, ab))
    DIM kl AS INTEGER : kl = INSTR(rest, "(")
    IF kl <= 0 THEN RETURN ""
    RETURN TRIM$(LEFT$(rest, kl))
END FUNCTION

' Der Quelltext einer Projektdatei -- aus dem REITER, wenn sie offen ist.
FUNCTION projektQuelle$(pfad AS STRING) AS STRING
    DIM t AS INTEGER : t = tabMitPfad(pfad)
    IF t >= 0 THEN RETURN GUI_TEXT(tabFelder[t])
    DIM q AS STRING : q = ""
    TRY
        q = dateiLesen(pfad)
    CATCH e
        q = ""
    END TRY
    RETURN q
END FUNCTION

' Je Knoten des Baums die Datei und die Zeile, zu der er gehoert.
DIM aufrKnoten AS ARRAY OF INTEGER : aufrKnoten = []
DIM aufrDateien AS ARRAY OF STRING : aufrDateien = []
DIM aufrZeilen AS ARRAY OF INTEGER : aufrZeilen = []
DIM aufrWahl AS INTEGER : aufrWahl = -1
DIM aufrZahl AS INTEGER : aufrZahl = 0

' Die Aufrufer von `name` unter `eltern` haengen, und darunter wieder deren
' Aufrufer. `gesehen` bricht Kreise auf: ruft A das B und B das A, kaeme man
' sonst nicht heraus. Ein Name steht darum hoechstens EINMAL im Baum.
SUB aufruferAeste(name AS STRING, eltern AS INTEGER, tiefe AS INTEGER, gesehen AS ARRAY OF STRING)
    IF tiefe > 3 OR name = "" OR aufrZahl >= 200 THEN RETURN
    IF ARRAY_INDEXOF(gesehen, LOWER$(name)) >= 0 THEN RETURN
    ARRAY_PUSH(gesehen, LOWER$(name))
    DIM dateien AS ARRAY OF STRING : dateien = projektDateien("*.dh")
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM quelle AS STRING : quelle = projektQuelle$(pfad)
        IF quelle = "" OR INSTR(quelle, name) < 0 THEN CONTINUE
        DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            IF aufrZahl >= 200 THEN BREAK
            IF NOT aufrufInZeile(zeilen[i], name) THEN CONTINUE
            DIM ober AS STRING : ober = unterprogrammName$(quelle, i + 1)
            DIM wo AS STRING : wo = IIF(ober = "", "Hauptprogramm", ober)
            DIM knoten AS INTEGER
            DIM oft AS STRING : oft = laufZahl$(pfad, i + 1)
            IF oft <> "" THEN aufrGemessen = aufrGemessen + 1
            knoten = GUI_TREE_ADD(baumAufruf, eltern, d + ":" + STR$(i + 1) + _
                                  "  (" + wo + ")" + oft + "   " + TRIM$(zeilen[i]))
            ARRAY_PUSH(aufrKnoten, knoten)
            ARRAY_PUSH(aufrDateien, pfad)
            ARRAY_PUSH(aufrZeilen, i + 1)
            aufrZahl = aufrZahl + 1
            IF tiefe = 0 THEN aufrDirekt = aufrDirekt + 1
            aufruferAeste(ober, knoten, tiefe + 1, gesehen)
        NEXT
    NEXT
END SUB

' Wie oft diese Zeile im letzten Profillauf gelaufen ist -- "  [12x]" oder
' "". Ohne Profillauf steht nichts da; eine Null waere eine Aussage, die
' niemand gemessen hat.
FUNCTION laufZahl$(pfad AS STRING, zeile AS INTEGER) AS STRING
    IF profDatei = "" OR wegGleich$(pfad) <> wegGleich$(profDatei) THEN RETURN ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(profZeilen) - 1
        IF profZeilen[i] = zeile THEN RETURN "  [" + STR$(profAnzahl[i]) + "x]"
    NEXT
    RETURN ""
END FUNCTION

SUB aufruferZeigen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    aufruferZeigenFuer(wortUnterMarke$())
END SUB

SUB aufruferZeigenFuer(name AS STRING)
    IF name = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Wer ruft das auf: unter der Marke steht kein Name."))
        protokoll("aufrufer 0")
        RETURN
    END IF
    GUI_TREE_CLEAR(baumAufruf)
    aufrKnoten = [] : aufrDateien = [] : aufrZeilen = []
    aufrZahl = 0 : aufrDirekt = 0 : aufrWahl = -1 : aufrGemessen = 0
    DIM gesehen AS ARRAY OF STRING : gesehen = []
    aufruferAeste(name, -1, 0, gesehen)
    GUI_WINDOW_TITLE(winAufruf, tr$("Wer ruft ") + name + tr$(" auf?"))
    DIM sagen AS STRING
    IF aufrZahl = 0 THEN
        sagen = "Niemand ruft '" + name + "' -- jedenfalls nicht in diesem Projektordner."
    ELSE
        sagen = STR$(aufrDirekt) + " Aufruf(e) unmittelbar, " + STR$(aufrZahl) + _
                " Knoten im Baum. Ein Klick springt hin."
    END IF
    GUI_SET_TEXT(lblAufruf, sagen)
    GUI_WINDOW_VISIBLE(winAufruf, TRUE)
    GUI_FOCUS(baumAufruf)
    GUI_SET_TEXT(lblStatus, sagen)
    protokoll("aufrufer " + STR$(aufrDirekt))
    protokoll("aufrufer baum " + STR$(aufrZahl))
    IF aufrGemessen > 0 THEN protokoll("aufrufer gemessen " + STR$(aufrGemessen))
END SUB

' Ein Klick im Baum springt zur Stelle. Wie beim Projektbaum ueber die
' Auswahl, nicht ueber einen Knopf -- ein Knopf mehr fuer etwas, das der
' Klick schon meint.
SUB aufruferAbfragen()
    IF NOT GUI_WINDOW_SHOWN(winAufruf) THEN RETURN
    DIM sel AS INTEGER : sel = GUI_TREE_SELECTED(baumAufruf)
    IF sel < 0 OR sel = aufrWahl THEN RETURN
    aufrWahl = sel
    DIM i AS INTEGER
    FOR i = 0 TO LEN(aufrKnoten) - 1
        IF aufrKnoten[i] <> sel THEN CONTINUE
        dateiOeffnen(aufrDateien[i])
        IF aktivesFeld() >= 0 THEN GUI_TEXTAREA_GOTO(aktivesFeld(), aufrZeilen[i], 1)
        protokoll("aufrufer sprung " + STR$(aufrZeilen[i]))
        RETURN
    NEXT
END SUB

' --- Zwei Reiter nebeneinander vergleichen ----------------------------
' `git diff` zeigt den Unterschied als TEXT. Nebeneinander sieht man ihn
' an der Stelle, an der er steht: die geteilte Ansicht geht an, und in
' beiden Feldern bekommen die abweichenden Zeilen eine Marke.
'
' Verglichen wird ohne git -- die beiden Reiter muessen dafuer nicht
' gesichert sein, und genau waehrend man tippt will man es wissen. Das
' Verfahren ist die laengste gemeinsame Teilfolge (LCS): dieselbe Rechnung
' wie bei diff, nur auf ZEILEN.
DIM diffLinks AS ARRAY OF INTEGER : diffLinks = []
DIM diffRechts AS ARRAY OF INTEGER : diffRechts = []
DIM diffTabL AS INTEGER : diffTabL = -1
DIM diffTabR AS INTEGER : diffTabR = -1

SUB zeilenVergleichen(a AS ARRAY OF STRING, b AS ARRAY OF STRING)
    diffLinks = []
    diffRechts = []
    DIM n AS INTEGER : n = LEN(a)
    DIM m AS INTEGER : m = LEN(b)
    IF n > 1500 OR m > 1500 THEN
        ' Die Tabelle waere n*m Zellen gross -- bei grossen Dateien lieber
        ' Zeile fuer Zeile vergleichen als minutenlang rechnen.
        DIM k AS INTEGER
        FOR k = 0 TO MAX(n, m) - 1
            DIM az AS STRING : az = IIF(k < n, a[k], "")
            DIM bz AS STRING : bz = IIF(k < m, b[k], "")
            IF az <> bz THEN
                IF k < n THEN ARRAY_PUSH(diffLinks, k + 1)
                IF k < m THEN ARRAY_PUSH(diffRechts, k + 1)
            END IF
        NEXT
        RETURN
    END IF
    ' lcs[i][j] = Laenge der laengsten gemeinsamen Teilfolge ab i bzw. j.
    DIM lcs[(n + 1) * (m + 1)] AS INTEGER
    DIM i AS INTEGER
    DIM j AS INTEGER
    FOR i = n - 1 TO 0 STEP -1
        FOR j = m - 1 TO 0 STEP -1
            IF a[i] = b[j] THEN
                lcs[i * (m + 1) + j] = lcs[(i + 1) * (m + 1) + j + 1] + 1
            ELSE
                lcs[i * (m + 1) + j] = MAX(lcs[(i + 1) * (m + 1) + j], lcs[i * (m + 1) + j + 1])
            END IF
        NEXT
    NEXT
    i = 0
    j = 0
    WHILE i < n AND j < m
        IF a[i] = b[j] THEN
            i = i + 1 : j = j + 1
        ELSEIF lcs[(i + 1) * (m + 1) + j] >= lcs[i * (m + 1) + j + 1] THEN
            ARRAY_PUSH(diffLinks, i + 1) : i = i + 1
        ELSE
            ARRAY_PUSH(diffRechts, j + 1) : j = j + 1
        END IF
    WEND
    WHILE i < n
        ARRAY_PUSH(diffLinks, i + 1) : i = i + 1
    WEND
    WHILE j < m
        ARRAY_PUSH(diffRechts, j + 1) : j = j + 1
    WEND
END SUB

SUB reiterVergleichen()
    IF tabAnzahl < 2 THEN
        GUI_SET_TEXT(lblStatus, tr$("Vergleichen: dafür braucht es zwei offene Dateien."))
        protokoll("reiter vergleich 0")
        RETURN
    END IF
    IF NOT geteilt THEN geteiltSetzen(TRUE)
    IF NOT geteilt THEN RETURN
    diffTabL = linkerTab
    diffTabR = aktiverTab
    IF diffTabL = diffTabR THEN
        GUI_SET_TEXT(lblStatus, tr$("Vergleichen: rechts einen anderen Reiter wählen."))
        RETURN
    END IF
    zeilenVergleichen(SPLIT$(GUI_TEXT(tabFelder[diffTabL]), NL), _
                      SPLIT$(GUI_TEXT(tabFelder[diffTabR]), NL))
    ' Das linke Feld markieren wir hier -- markenNachziehen kuemmert sich
    ' nur um das vordere.
    DIM farbenL AS ARRAY OF INTEGER : farbenL = []
    DIM x AS INTEGER
    FOR EACH x IN diffLinks
        ARRAY_PUSH(farbenL, &HE07070)
    NEXT
    GUI_TEXTAREA_MARKS(tabFelder[diffTabL], diffLinks, farbenL)
    markenSchluessel = ""
    GUI_SET_TEXT(lblStatus, BASENAME(tabPfade[diffTabL]) + tr$(" gegen ") + BASENAME(tabPfade[diffTabR]) + _
                 ": " + STR$(LEN(diffLinks)) + " Zeilen links, " + STR$(LEN(diffRechts)) + " rechts.")
    protokoll("reiter vergleich " + STR$(LEN(diffLinks)) + " " + STR$(LEN(diffRechts)))
END SUB

SUB markenAnZeilenenden()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    IF z2 <= z1 THEN
        GUI_SET_TEXT(lblStatus, tr$("Erst mehrere Zeilen markieren."))
        protokoll("marken enden 0")
        RETURN
    END IF
    GUI_TEXTAREA_CLEAR_CARETS(ta)
    GUI_TEXTAREA_GOTO(ta, z1, SPALTE_ENDE)
    DIM z AS INTEGER
    FOR z = z1 + 1 TO z2
        GUI_TEXTAREA_ADD_CARET(ta, z, SPALTE_ENDE)
    NEXT
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, STR$(GUI_TEXTAREA_CARETS(ta)) + tr$(" Marken, je eine am Zeilenende."))
    protokoll("marken enden " + STR$(GUI_TEXTAREA_CARETS(ta)))
END SUB

' --- Zeilen-Werkzeuge -------------------------------------------------
' Sortieren, Doppelte entfernen, Leerraum am Ende weg: auf der Auswahl,
' und ohne Auswahl auf der ganzen Datei -- eine einzelne Zeile zu
' sortieren ergibt nichts. Geschrieben wird ueber zeilenErsetzen, damit
' jeder Griff EIN Undo-Schritt bleibt.
SUB zeilenWerkzeug(art AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM alle AS ARRAY OF STRING : alle = SPLIT$(GUI_TEXT(ta), NL)
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    IF z1 = z2 THEN
        z1 = 1
        z2 = LEN(alle)
    END IF
    DIM block AS ARRAY OF STRING : block = zeilenHolen(alle, z1, z2)
    DIM raus AS ARRAY OF STRING : raus = []
    DIM z AS STRING
    IF art = "sortieren" THEN
        FOR EACH z IN block
            ARRAY_PUSH(raus, z)
        NEXT
        SORT(raus)
    ELSEIF art = "doppelte" THEN
        DIM gesehen AS MAP OF INTEGER : gesehen = {}
        FOR EACH z IN block
            IF NOT MAPHAS(gesehen, z) THEN
                MAPPUT(gesehen, z, 1)
                ARRAY_PUSH(raus, z)
            END IF
        NEXT
    ELSE
        FOR EACH z IN block
            ARRAY_PUSH(raus, RTRIM$(z))
        NEXT
    END IF
    zeilenErsetzen(ta, z1, z2, raus)
    GUI_SET_TEXT(lblStatus, STR$(LEN(block)) + tr$(" Zeilen -> ") + STR$(LEN(raus)) + " (" + art + ").")
    protokoll("zeilen " + art + " " + STR$(LEN(raus)))
END SUB

' --- Umbenennen im ganzen Projekt -------------------------------------
' CODE_RENAME$ arbeitet auf EINEM Text und braucht eine Stelle, an der der
' Name steht. In einer fremden Datei kennen wir sie nicht -- also werden
' die Fundstellen der Reihe nach probiert, bis eine den Text wirklich
' aendert. Eine Stelle in einem Kommentar oder in einer Zeichenkette
' aendert nichts, und dann kommt eben die naechste dran.
FUNCTION umbenennenInText$(quelle AS STRING, wort AS STRING, neu AS STRING) AS STRING
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM versuche AS INTEGER : versuche = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM zl AS STRING : zl = zeilen[i]
        DIM s AS INTEGER : s = INSTR(zl, wort)
        WHILE s >= 0 AND versuche < 200
            DIM davor AS BOOLEAN : davor = s > 0 AND istWortzeichen(MID$(zl, s - 1, 1))
            DIM danach AS BOOLEAN : danach = istWortzeichen(MID$(zl, s + LEN(wort), 1))
            IF NOT davor AND NOT danach THEN
                versuche = versuche + 1
                DIM ergebnis AS STRING : ergebnis = ""
                TRY
                    ergebnis = CODE_RENAME$(quelle, i + 1, s + 1, neu)
                CATCH e
                    ergebnis = ""
                END TRY
                IF ergebnis <> "" AND ergebnis <> quelle THEN RETURN ergebnis
            END IF
            s = INSTR(zl, wort, s + 1)
        WEND
    NEXT
    RETURN quelle
END FUNCTION

' Gibt es `name` im Projekt schon als SUB, FUNCTION, CLASS oder Methode?
' Liefert die Fundstelle als Text ("helfer.dh:12") oder "".
'
' Geprueft wird gegen den Symbolindex, nicht gegen den Uebersetzer: zwei
' Unterprogramme desselben Namens sind kein Uebersetzungsfehler, das
' zweite verdeckt das erste einfach. Genau das will man beim Umbenennen
' vorher wissen.
FUNCTION nameVergeben$(name AS STRING) AS STRING
    symbolIndexBauen(TRUE)
    DIM klein AS STRING : klein = LOWER$(name)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(symNamen) - 1
        IF LOWER$(symNamen[i]) = klein THEN
            RETURN BASENAME(symPfade[i]) + ":" + STR$(symZeilen[i])
        END IF
    NEXT
    RETURN ""
END FUNCTION

' Formulare mitziehen: eine `.dhform` nennt ihre Rueckrufe beim NAMEN
' ("on_click": "malen"), und GUI_LOAD sucht sie spaeter unter genau dem.
' Wer das Unterprogramm umbenennt und die Datei stehen laesst, hat einen
' Knopf, der nichts mehr tut -- ohne Fehlermeldung, denn der Name wird
' erst beim Klicken gesucht.
'
' Ersetzt wird im TEXT, nicht ueber das json-Modul: ein neu geschriebenes
' JSON haette eine andere Form, und die Vorschau zeigte die ganze Datei als
' geaendert statt der einen Zeile.
SUB formulareNachziehen(alt AS STRING, neu AS STRING)
    IF alt = "" OR neu = "" OR alt = neu THEN RETURN
    DIM schluessel AS ARRAY OF STRING
    schluessel = ["on_click", "on_change", "on_focus", "on_blur", "on_enter"]
    DIM d AS STRING
    FOR EACH d IN projektDateien("*.dhform")
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM text AS STRING : text = ""
        TRY
            text = JOIN$(READLINES(pfad), NL)
        CATCH e
            text = ""
        END TRY
        IF text = "" THEN CONTINUE
        DIM frisch AS STRING : frisch = text
        DIM k AS STRING
        FOR EACH k IN schluessel
            DIM q AS STRING : q = CHR$(34)
            frisch = REPLACE$(frisch, q + k + q + ": " + q + alt + q, _
                                      q + k + q + ": " + q + neu + q)
            frisch = REPLACE$(frisch, q + k + q + ":" + q + alt + q, _
                                      q + k + q + ":" + q + neu + q)
        NEXT
        IF frisch <> text THEN umbauVormerken(tabMitPfad(pfad), pfad, frisch)
    NEXT
END SUB

' --- Ein Umbau, der ueber viele Dateien geht, laeuft in Schritten -------
' Das Sammeln der Aenderungen liest jede Datei des Projekts und laesst den
' Umbenenner darueber laufen. In EINEM Bild erledigt, steht die IDE so
' lange -- bei vierhundert Dateien lange genug, dass man sie fuer haengend
' haelt, und abbrechen kann man nichts, was gar nicht erst zum Zeichnen
' kommt.
'
' Darum je Bild ein Haeppchen: die Statuszeile zaehlt mit, ESC bricht ab.
' Am Ende steht dieselbe Vorschau wie zuvor.
CONST LAUF_PRO_BILD = 25
DIM laufArt AS STRING : laufArt = ""      ' "" = nichts laeuft
DIM laufDateien AS ARRAY OF STRING : laufDateien = []
DIM laufIndex AS INTEGER : laufIndex = 0
DIM laufAlt AS STRING : laufAlt = ""
DIM laufNeu AS STRING : laufNeu = ""
' Was die beiden anderen Arten (Parameter, Verschieben) unterwegs brauchen:
' das Ziel, die alte Parameterzahl und die Zaehler.
DIM laufZiel AS STRING : laufZiel = ""
DIM laufBlock AS INTEGER : laufBlock = 0
DIM laufZahl AS INTEGER : laufZahl = 0
DIM laufGeaendert AS INTEGER : laufGeaendert = 0
DIM laufUebergangen AS INTEGER : laufUebergangen = 0

SUB laufStarten(art AS STRING, alt AS STRING, neu AS STRING)
    laufArt = art
    laufAlt = alt
    laufNeu = neu
    laufDateien = projektDateien("*.dh")
    laufIndex = 0
    laufGeaendert = 0
    laufUebergangen = 0
    ' NICHT `umbauLeeren` bei den Arten, die schon etwas vorgemerkt haben:
    ' Parameter und Verschieben legen die eigene Datei (und die Zieldatei)
    ' VOR dem Sammeln hin -- dort steht der Stand aus dem Reiter, den die
    ' Platte gar nicht kennt.
    IF art = "umbenennen" OR art = "ersetzen" THEN umbauLeeren()
    GUI_SET_TEXT(lblStatus, tr$("Sammle ... 0 von ") + STR$(LEN(laufDateien)) + tr$(" Dateien (ESC bricht ab)"))
END SUB

SUB laufAbbrechen()
    IF laufArt = "" THEN RETURN
    laufArt = ""
    umbauLeeren()
    GUI_SET_TEXT(lblStatus, tr$("Abgebrochen -- nichts geändert."))
    protokoll("umbau abgebrochen")
END SUB

' Ein Haeppchen; am Ende die Vorschau. Wird je Bild aus der Hauptschleife
' gerufen.
SUB laufSchritt()
    IF laufArt = "" THEN RETURN
    DIM bis AS INTEGER : bis = MIN(laufIndex + LAUF_PRO_BILD, LEN(laufDateien))
    DIM i AS INTEGER
    FOR i = laufIndex TO bis - 1
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, laufDateien[i])
        DIM alt AS STRING : alt = ""
        TRY
            alt = JOIN$(READLINES(pfad), NL)
        CATCH e
            alt = ""
        END TRY
        IF alt = "" THEN CONTINUE
        DIM frisch AS STRING : frisch = alt
        IF laufArt = "parameter" THEN
            ' Die eigene Datei ist schon vorgemerkt (dort steht der Stand
            ' AUS DEM REITER, nicht der von der Platte).
            IF wegGleich$(pfad) = wegGleich$(tabPfade[aktiverTab]) THEN CONTINUE
            IF INSTR(alt, paramName) < 0 THEN CONTINUE
            DIM z2 AS ARRAY OF INTEGER : z2 = []
            frisch = parameterInText$(alt, paramName, paramFolge, paramNeuDecl, paramNeuWert, _
                                      laufZahl, z2)
            laufGeaendert = laufGeaendert + z2[0]
            laufUebergangen = laufUebergangen + z2[1]
        ELSEIF laufArt = "verschieben" THEN
            IF wegGleich$(pfad) = wegGleich$(tabPfade[aktiverTab]) THEN CONTINUE
            IF wegGleich$(pfad) = wegGleich$(laufZiel) THEN CONTINUE
            IF NOT benutztWort(alt, verschName) THEN CONTINUE
            frisch = mitImport$(alt, BASENAME(laufZiel))
            IF frisch <> alt THEN laufGeaendert = laufGeaendert + 1
        ELSEIF laufArt = "umbenennen" THEN
            IF INSTR(alt, laufAlt) < 0 THEN CONTINUE
            frisch = umbenennenInText$(alt, laufAlt, laufNeu)
        ELSE
            frisch = textErsetzen$(alt, laufAlt, laufNeu)
        END IF
        ' Auf die PLATTE, nicht in den Reiter: beide Umbauten arbeiten auf
        ' den Dateien (sie brechen vorher ab, wenn ein Reiter ungesichert
        ' ist), und umbauSchreiben zieht einen offenen Reiter nach.
        IF frisch <> alt THEN umbauVormerken(-1, pfad, frisch)
    NEXT
    laufIndex = bis
    IF laufIndex < LEN(laufDateien) THEN
        GUI_SET_TEXT(lblStatus, tr$("Sammle ... ") + STR$(laufIndex) + tr$(" von ") + _
                     STR$(LEN(laufDateien)) + " Dateien (ESC bricht ab)")
        RETURN
    END IF
    ' Fertig gesammelt -- ab hier wie bisher.
    DIM art AS STRING : art = laufArt
    laufArt = ""
    IF art = "parameter" THEN
        DIM psagen AS STRING
        psagen = "Parameter von " + paramName + ": " + STR$(laufGeaendert) + " Stelle(n) in " + _
                 STR$(LEN(umbauTexte)) + " Datei(en)."
        IF laufUebergangen > 0 THEN
            psagen = psagen + " " + STR$(laufUebergangen) + " Aufruf(e) übergangen (andere Zahl " + _
                     "von Argumenten oder mit Namen übergeben)."
        END IF
        umbauStarten("Parameter von " + paramName, psagen, _
                     "parameter umgestellt " + STR$(laufGeaendert) + " " + STR$(laufUebergangen))
        RETURN
    END IF
    IF art = "verschieben" THEN
        DIM vsagen AS STRING
        vsagen = verschName + " (" + STR$(laufBlock) + " Zeilen) nach " + BASENAME(laufZiel) + _
                 ", " + STR$(LEN(umbauTexte)) + " Datei(en) betroffen."
        IF laufGeaendert > 0 THEN
            vsagen = vsagen + " " + STR$(laufGeaendert) + " davon bekommen den IMPORT dazu."
        END IF
        umbauStarten(verschName + " nach " + BASENAME(laufZiel), vsagen, _
                     "verschieben " + verschName + " " + STR$(laufBlock) + " " + STR$(laufGeaendert))
        RETURN
    END IF
    IF art = "umbenennen" THEN
        formulareNachziehen(laufAlt, laufNeu)
        umbauWarnung = umbenennEinwand$(laufAlt, laufNeu)
        umbauStarten("'" + laufAlt + "' -> '" + laufNeu + "' im Projekt", _
                     "'" + laufAlt + "' -> '" + laufNeu + "' in " + STR$(LEN(umbauTexte)) + " Datei(en).", _
                     "projekt umbenannt " + STR$(LEN(umbauTexte)))
    ELSE
        umbauStarten("'" + laufAlt + "' -> '" + laufNeu + "' im Projekt", _
                     "Ersetzt in " + STR$(LEN(umbauTexte)) + " Datei(en).", _
                     "projekt ersetzt " + STR$(LEN(umbauTexte)))
    END IF
END SUB

SUB umbenennenImProjekt(neu AS STRING)
    IF projektUngesichert() THEN
        GUI_SET_TEXT(lblStatus, tr$("Erst sichern: ein Reiter hat ungesicherte Änderungen."))
        protokoll("projekt umbenannt -1")
        RETURN
    END IF
    DIM wort AS STRING : wort = umbenennWort
    IF wort = "" OR neu = "" OR wort = neu THEN RETURN
    laufStarten("umbenennen", wort, neu)
END SUB

' --- Zwei Dateien vergleichen -----------------------------------------
' `git diff --no-index` kann das auch fuer Dateien, die gar nicht in einem
' Verzeichnis unter Versionsverwaltung liegen. Gezeigt wird es im selben
' Fenster und mit derselben Faerbung wie git diff.
SUB dateienVergleichen()
    IF aktiverTab < 0 OR tabPfade[aktiverTab] = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Vergleichen: diese Datei ist noch nicht gesichert."))
        RETURN
    END IF
    ' Steht im Projektbaum eine ANDERE Datei gewaehlt, ist sie gemeint --
    ' sonst fragt der Datei-Dialog. Ein Dialog, den man jedes Mal bekommt,
    ' auch wenn die Antwort schon dasteht, ist einer zu viel.
    DIM anderer AS STRING : anderer = GUI_FILETREE_SELECTED$(baum)
    IF anderer <> "" AND GUI_FILETREE_IS_DIR(baum) THEN anderer = ""
    IF anderer <> "" AND wegGleich$(anderer) = wegGleich$(tabPfade[aktiverTab]) THEN anderer = ""
    IF anderer = "" THEN anderer = FILE_OPEN_DIALOG("Womit vergleichen?", "dh")
    IF anderer = "" THEN RETURN
    DIM meiner AS STRING : meiner = tabPfade[aktiverTab]
    DIM text AS STRING : text = ""
    TRY
        text = SHELL_OUT$("git", "diff", "--no-index", "--no-color", "--", meiner, anderer)
    CATCH e
        text = ""
    END TRY
    IF TRIM$(text) = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Kein Unterschied zu ") + BASENAME(anderer) + ".")
        protokoll("vergleich 0")
        RETURN
    END IF
    GUI_SET_TEXT(taGit, text)
    GUI_WINDOW_TITLE(winGit, BASENAME(meiner) + tr$(" gegen ") + BASENAME(anderer))
    GUI_SET_TEXT(lblGit, STR$(LEN(SPLIT$(text, NL))) + tr$(" Zeilen"))
    GUI_WINDOW_VISIBLE(winGit, TRUE)
    GUI_FOCUS(taGit)
    gitFaerben()
    protokoll("vergleich " + STR$(LEN(SPLIT$(text, NL))))
END SUB

SUB markenAufFundstellen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF wort = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Unter der Marke steht kein Wort."))
        RETURN
    END IF
    GUI_TEXTAREA_CLEAR_CARETS(ta)
    ' GUI_TEXTAREA_FIND sucht Teiltexte -- aus `hp` wuerde sonst auch das
    ' `hp` in `hpmax` eine Marke, und ein Tippen aenderte einen Namen, der
    ' gar nicht gemeint war. Die Grenzen prueft die IDE selbst.
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM erste AS BOOLEAN : erste = TRUE
    DIM n AS INTEGER : n = 0
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = GUI_TEXTAREA_FIND(ta, wort, 1, 1, TRUE)
    WHILE tz >= 0 AND n < 200
        DIM zl AS STRING : zl = zeilen[tz - 1]
        DIM davor AS BOOLEAN : davor = ts > 1 AND istWortzeichen(MID$(zl, ts - 2, 1))
        DIM danach AS BOOLEAN : danach = istWortzeichen(MID$(zl, ts - 1 + LEN(wort), 1))
        IF NOT davor AND NOT danach THEN
            IF erste THEN
                GUI_TEXTAREA_GOTO(ta, tz, ts)
                erste = FALSE
            ELSE
                GUI_TEXTAREA_ADD_CARET(ta, tz, ts)
            END IF
            n = n + 1
        END IF
        (tz, ts) = GUI_TEXTAREA_FIND(ta, wort, tz, ts + LEN(wort), TRUE)
    WEND
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, STR$(n) + tr$(" Marken auf '") + wort + tr$("' -- tippen ändert alle, ESC räumt sie weg."))
    protokoll("marken " + STR$(n))
END SUB

' --- Der Umbau: erst zeigen, dann schreiben ---------------------------
' Jeder Umbau geht diesen Weg: die neuen Texte vormerken (umbauVormerken),
' dann `umbauStarten`. Ist die Vorschau an, zeigt sie den Unterschied und
' fragt; ist sie aus, wird gleich geschrieben. Eine Stelle, an der ein
' Umbau ankommt, und keine zwei Wege, die auseinanderlaufen koennen.
SUB umbauLeeren()
    umbauTabs = [] : umbauPfade = [] : umbauTexte = []
    umbauZeile = 0 : umbauSpalte = 1
    umbauWarnung = ""
    umbauBefunde = []
    ' Die Schritte (`op*`) bleiben stehen: sie sind die Grundlage fuers
    ' Nachbessern, und der naechste Umbau baut sie ohnehin neu.
END SUB

' `tab` >= 0 schreibt in den Reiter (Undo bleibt), sonst in die Datei.
SUB umbauVormerken(tab AS INTEGER, pfad AS STRING, neu AS STRING)
    ARRAY_PUSH(umbauTabs, tab) : ARRAY_PUSH(umbauPfade, pfad) : ARRAY_PUSH(umbauTexte, neu)
END SUB

' Der Text eines Eintrags, wie er JETZT ist -- das, wogegen verglichen wird.
FUNCTION umbauAlt$(k AS INTEGER) AS STRING
    IF umbauTabs[k] >= 0 THEN RETURN GUI_TEXT(tabFelder[umbauTabs[k]])
    ' Eine Datei, die es noch NICHT gibt, ist ein leerer Vorher-Stand --
    ' beim Verschieben in eine neue Datei entsteht sie erst beim Uebernehmen.
    DIM t AS STRING : t = ""
    TRY
        t = dateiLesen(umbauPfade[k])
    CATCH e
        t = ""
    END TRY
    RETURN t
END FUNCTION

' --- Der Unterschied als Folge von SCHRITTEN --------------------------
' Bis Stand 19 war die Vorschau ein Text: schoen zu lesen, aber nichts, an
' dem sich etwas abwaehlen liesse. Jetzt steht dahinter eine Liste von
' Schritten -- je Zeile "bleibt", "faellt weg" oder "kommt dazu" --, und
' zusammenhaengende Aenderungen bilden einen BLOCK. Ein ausgelassener Block
' liefert beim Zusammenbauen die ALTE Zeile statt der neuen; der Text der
' Datei entsteht also aus denselben Schritten, die man sieht.
DIM opDatei AS ARRAY OF INTEGER : opDatei = []
DIM opArt AS ARRAY OF INTEGER : opArt = []       ' 0 bleibt, 1 alt, 2 neu
DIM opText AS ARRAY OF STRING : opText = []
DIM opHunk AS ARRAY OF INTEGER : opHunk = []     ' -1 = kein Block
DIM hunkAus AS ARRAY OF INTEGER : hunkAus = []   ' 1 = ausgelassen
DIM zeigHunk AS ARRAY OF INTEGER : zeigHunk = [] ' je ANGEZEIGTER Zeile

SUB opsLeeren()
    opDatei = [] : opArt = [] : opText = [] : opHunk = []
    hunkAus = [] : zeigHunk = []
END SUB

' Die Schritte einer Datei anhaengen und ihre Bloecke nummerieren.
SUB opsBauen(k AS INTEGER, a AS ARRAY OF STRING, b AS ARRAY OF STRING)
    DIM erste AS INTEGER : erste = LEN(opArt)
    zeilenVergleichen(a, b)
    DIM i AS INTEGER : i = 0
    DIM j AS INTEGER : j = 0
    DIM li AS INTEGER : li = 0
    DIM ri AS INTEGER : ri = 0
    WHILE i < LEN(a) OR j < LEN(b)
        IF li < LEN(diffLinks) AND i < LEN(a) AND diffLinks[li] = i + 1 THEN
            ARRAY_PUSH(opDatei, k) : ARRAY_PUSH(opArt, 1) : ARRAY_PUSH(opText, a[i])
            ARRAY_PUSH(opHunk, -1)
            i = i + 1 : li = li + 1
        ELSEIF ri < LEN(diffRechts) AND j < LEN(b) AND diffRechts[ri] = j + 1 THEN
            ARRAY_PUSH(opDatei, k) : ARRAY_PUSH(opArt, 2) : ARRAY_PUSH(opText, b[j])
            ARRAY_PUSH(opHunk, -1)
            j = j + 1 : ri = ri + 1
        ELSEIF i < LEN(a) AND j < LEN(b) THEN
            ARRAY_PUSH(opDatei, k) : ARRAY_PUSH(opArt, 0) : ARRAY_PUSH(opText, a[i])
            ARRAY_PUSH(opHunk, -1)
            i = i + 1 : j = j + 1
        ELSE
            BREAK
        END IF
    WEND
    ' Jeder zusammenhaengende Lauf geaenderter Schritte ist ein Block.
    DIM h AS INTEGER : h = -1
    DIM n AS INTEGER
    FOR n = erste TO LEN(opArt) - 1
        IF opArt[n] = 0 THEN
            h = -1
            CONTINUE
        END IF
        IF h < 0 THEN
            ARRAY_PUSH(hunkAus, 0)
            h = LEN(hunkAus) - 1
        END IF
        opHunk[n] = h
    NEXT
END SUB

' Der Text einer Datei, wie er mit der jetzigen Auswahl aussaehe.
FUNCTION umbauTextAus$(k AS INTEGER) AS STRING
    DIM raus AS ARRAY OF STRING : raus = []
    DIM n AS INTEGER
    FOR n = 0 TO LEN(opDatei) - 1
        IF opDatei[n] <> k THEN CONTINUE
        DIM aus AS BOOLEAN : aus = opHunk[n] >= 0 AND hunkAus[opHunk[n]] = 1
        IF opArt[n] = 0 THEN ARRAY_PUSH(raus, opText[n])
        IF opArt[n] = 1 AND aus THEN ARRAY_PUSH(raus, opText[n])
        IF opArt[n] = 2 AND NOT aus THEN ARRAY_PUSH(raus, opText[n])
    NEXT
    RETURN JOIN$(raus, NL)
END FUNCTION

' Die Anzeige neu bauen -- und mit ihr die Texte, die geschrieben wuerden.
' Beides aus derselben Quelle: was man sieht, ist was man bekommt.
SUB umbauAnzeigeBauen()
    DIM zeilen AS ARRAY OF STRING : zeilen = []
    zeigHunk = []
    DIM minus AS INTEGER : minus = 0
    DIM plus AS INTEGER : plus = 0
    DIM ausgelassen AS INTEGER : ausgelassen = 0
    DIM h AS INTEGER
    FOR h = 0 TO LEN(hunkAus) - 1
        IF hunkAus[h] = 1 THEN ausgelassen = ausgelassen + 1
    NEXT
    IF umbauWarnung <> "" THEN
        ARRAY_PUSH(zeilen, "@@ " + umbauWarnung) : ARRAY_PUSH(zeigHunk, -1)
        ARRAY_PUSH(zeilen, "") : ARRAY_PUSH(zeigHunk, -1)
    END IF
    DIM bf AS STRING
    FOR EACH bf IN umbauBefunde
        ARRAY_PUSH(zeilen, "@@ " + bf) : ARRAY_PUSH(zeigHunk, -1)
    NEXT
    IF LEN(umbauBefunde) > 0 THEN
        ARRAY_PUSH(zeilen, "") : ARRAY_PUSH(zeigHunk, -1)
    END IF
    DIM k AS INTEGER
    FOR k = 0 TO LEN(umbauTexte) - 1
        umbauTexte[k] = umbauTextAus$(k)
        DIM name AS STRING : name = umbauPfade[k]
        IF name = "" AND umbauTabs[k] >= 0 THEN name = tabTitel[umbauTabs[k]]
        IF k > 0 THEN
            ARRAY_PUSH(zeilen, "") : ARRAY_PUSH(zeigHunk, -1)
        END IF
        ARRAY_PUSH(zeilen, "--- " + BASENAME(name)) : ARRAY_PUSH(zeigHunk, -1)
        ' Zusammenhang nur nahe an einer Aenderung: ein Unterschied von drei
        ' Zeilen in einer Datei mit tausend soll drei Zeilen lang zu lesen sein.
        DIM luecke AS BOOLEAN : luecke = FALSE
        DIM n AS INTEGER
        FOR n = 0 TO LEN(opDatei) - 1
            IF opDatei[n] <> k THEN CONTINUE
            DIM nah AS BOOLEAN : nah = FALSE
            DIM d AS INTEGER
            FOR d = MAX(0, n - 2) TO MIN(LEN(opArt) - 1, n + 2)
                IF opDatei[d] = k AND opArt[d] <> 0 THEN nah = TRUE
            NEXT
            IF NOT nah THEN
                luecke = TRUE
                CONTINUE
            END IF
            IF luecke THEN
                ARRAY_PUSH(zeilen, "@@ ...") : ARRAY_PUSH(zeigHunk, -1)
                luecke = FALSE
            END IF
            DIM aus AS BOOLEAN : aus = opHunk[n] >= 0 AND hunkAus[opHunk[n]] = 1
            DIM vor AS STRING : vor = " "
            IF opArt[n] = 1 THEN vor = "-"
            IF opArt[n] = 2 THEN vor = "+"
            ' Ein ausgelassener Block traegt eine Tilde: er steht noch da,
            ' zaehlt aber nicht mehr mit.
            IF aus AND opArt[n] <> 0 THEN vor = "~"
            IF opArt[n] = 1 AND NOT aus THEN minus = minus + 1
            IF opArt[n] = 2 AND NOT aus THEN plus = plus + 1
            ARRAY_PUSH(zeilen, vor + opText[n]) : ARRAY_PUSH(zeigHunk, opHunk[n])
        NEXT
    NEXT
    GUI_SET_TEXT(taUmbau, JOIN$(zeilen, NL))
    diffFaerben(taUmbau)
    DIM zeile AS STRING
    zeile = STR$(LEN(umbauTexte)) + " Datei(en), " + STR$(minus) + _
            " Zeilen weniger, " + STR$(plus) + " mehr"
    IF ausgelassen > 0 THEN zeile = zeile + ", " + STR$(ausgelassen) + " Block/Blöcke ausgelassen"
    zeile = zeile + " -- Enter übernimmt, ESC verwirft."
    IF umbauWarnung <> "" THEN zeile = umbauWarnung + "  |  " + zeile
    GUI_SET_TEXT(lblUmbau, zeile)
END SUB

' Den Block unter der Marke auslassen oder wieder aufnehmen.
SUB umbauBlockKippen()
    IF NOT GUI_WINDOW_SHOWN(winUmbau) THEN RETURN
    DIM z AS INTEGER
    DIM sp AS INTEGER
    (z, sp) = GUI_TEXTAREA_CURSOR(taUmbau)
    IF z < 1 OR z > LEN(zeigHunk) THEN RETURN
    DIM h AS INTEGER : h = zeigHunk[z - 1]
    IF h < 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Auslassen: erst auf eine geänderte Zeile stellen."))
        protokoll("umbau block -1")
        RETURN
    END IF
    hunkAus[h] = 1 - hunkAus[h]
    umbauAnzeigeBauen()
    GUI_TEXTAREA_GOTO(taUmbau, z, 1)
    ' Der Fokus geht auf den Knopf, NICHT zurueck in die Anzeige: dort waere
    ' Enter ein Zeilenumbruch im Unterschied statt des Uebernehmens. Die
    ' Marke bleibt trotzdem stehen, ein zweiter Klick auf den Knopf nimmt
    ' den Block wieder auf.
    GUI_FOCUS(btnUmbauOk)
    protokoll("umbau block " + STR$(h) + " " + IIF(hunkAus[h] = 1, "aus", "an"))
END SUB

SUB umbauStarten(titel AS STRING, meldung AS STRING, prot AS STRING)
    IF LEN(umbauTexte) = 0 THEN
        GUI_SET_TEXT(lblStatus, titel + tr$(": nichts zu tun."))
        umbauLeeren()
        RETURN
    END IF
    umbauMeldung = meldung
    umbauProt = prot
    IF NOT vorschauAn AND umbauWarnung = "" THEN
        ' Ohne Vorschau wird trotzdem GEPRUEFT -- nur eben still. Bis Stand
        ' 24 ging der Umbau ungesehen durch, und ob er die Uebersetzung
        ' kaputt macht, sah man beim naechsten Starten. Bleibt alles heil,
        ' wird geschrieben; kommen Fehler dazu, geht die Vorschau doch auf,
        ' mit den Meldungen oben. Sie erscheint dann genau dann, wenn sie
        ' etwas zu sagen hat.
        DIM schlimm AS INTEGER : schlimm = umbauNeueFehler()
        IF schlimm = 0 THEN
            umbauSchreiben()
            RETURN
        END IF
        umbauWarnung = "Der Umbau bringt " + STR$(schlimm) + " Fehler DAZU -- darum diese Vorschau."
        protokoll("umbau einwand still " + STR$(schlimm))
    END IF
    opsLeeren()
    DIM k AS INTEGER
    FOR k = 0 TO LEN(umbauTexte) - 1
        opsBauen(k, SPLIT$(umbauAlt$(k), NL), SPLIT$(umbauTexte[k], NL))
    NEXT
    GUI_LISTBOX_CLEAR(lstUmbau)
    DIM ln AS INTEGER
    FOR ln = 0 TO LEN(umbauTexte) - 1
        DIM lname AS STRING : lname = umbauPfade[ln]
        IF lname = "" AND umbauTabs[ln] >= 0 THEN lname = tabTitel[umbauTabs[ln]]
        GUI_LISTBOX_ADD(lstUmbau, BASENAME(lname))
        GUI_LISTBOX_SET_CHECKED(lstUmbau, ln, TRUE)
    NEXT
    umbauAnzeigeBauen()
    GUI_WINDOW_TITLE(winUmbau, tr$("Vorschau: ") + titel)
    GUI_WINDOW_VISIBLE(winUmbau, TRUE)
    GUI_FOCUS(btnUmbauOk)
    DIM pm AS INTEGER : pm = 0
    DIM pp AS INTEGER : pp = 0
    DIM po AS INTEGER
    FOR po = 0 TO LEN(opArt) - 1
        IF opArt[po] = 1 THEN pm = pm + 1
        IF opArt[po] = 2 THEN pp = pp + 1
    NEXT
    protokoll("umbau vorschau " + STR$(LEN(umbauTexte)) + " " + STR$(pm) + " " + STR$(pp))
    IF umbauWarnung <> "" THEN protokoll("umbau einwand")
END SUB

' Den zuletzt geschriebenen Umbau in EINEM Zug zurueckschreiben.
'
' Geschrieben wird auf denselben zwei Wegen wie beim Umbau selbst: in den
' Reiter ueber Auswahl + INSERT (ein Undo-Schritt), sonst auf die Platte.
' Danach ist der Vorrat leer -- zweimal zurueck gaebe es nur mit einem
' Stapel, und einer reicht fuer das, was hier schiefgeht.
' Ein Stand eines Umbaus: welcher Reiter, welche Datei. Hat die Datei einen
' Weg, entscheidet der -- die Reiternummer von damals kann nach einem
' Schliessen auf eine andere Datei zeigen.
FUNCTION umbauReiter(tab AS INTEGER, pfad AS STRING) AS INTEGER
    IF pfad <> "" THEN RETURN tabMitPfad(pfad)
    IF tab >= 0 AND tab < tabAnzahl THEN RETURN tab
    RETURN -1
END FUNCTION

' Der Text, der JETZT dort steht -- im Reiter, sonst in der Datei.
' CHR$(0), wenn es ihn nicht mehr gibt.
FUNCTION umbauJetzt$(tab AS INTEGER, pfad AS STRING) AS STRING
    DIM t AS INTEGER : t = umbauReiter(tab, pfad)
    IF t >= 0 THEN RETURN GUI_TEXT(tabFelder[t])
    IF pfad = "" THEN RETURN CHR$(0)
    TRY
        RETURN dateiLesen(pfad)
    CATCH e
        RETURN CHR$(0)
    END TRY
END FUNCTION

' Gleich bis auf Umbrueche am Ende -- die Datei traegt einen, der Reiter nicht.
FUNCTION gleichesEnde(a AS STRING, b AS STRING) AS BOOLEAN
    WHILE RIGHT$(a, 1) = NL : a = LEFT$(a, LEN(a) - 1) : WEND
    WHILE RIGHT$(b, 1) = NL : b = LEFT$(b, LEN(b) - 1) : WEND
    RETURN a = b
END FUNCTION

SUB umbauStandSetzen(tab AS INTEGER, pfad AS STRING, text AS STRING)
    DIM t AS INTEGER : t = umbauReiter(tab, pfad)
    IF t >= 0 THEN
        ' Offen: in den Reiter, Auswahl ueber alles + INSERT -- ein
        ' Undo-Schritt dort, gesichert wird wie immer mit Strg+S.
        DIM ta AS GUI_WIDGET : ta = tabFelder[t]
        DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
        DIM letzte AS INTEGER : letzte = LEN(zeilen)
        GUI_TEXTAREA_SELECT(ta, 1, 1, letzte, LEN(zeilen[letzte - 1]) + 1)
        GUI_TEXTAREA_INSERT(ta, text)
        RETURN
    END IF
    IF pfad = "" THEN RETURN
    WRITEALL(pfad, text + NL)
END SUB

' Die Dateien einer Gruppe (ab `ab`, `n` Stueck), die seit dem Stand
' `erwartet` geaendert wurden -- "" wenn keine.
FUNCTION umbauGeaendert$(tabs AS ARRAY OF INTEGER, pfade AS ARRAY OF STRING, _
                         erwartet AS ARRAY OF STRING, ab AS INTEGER, n AS INTEGER) AS STRING
    DIM raus AS ARRAY OF STRING : raus = []
    DIM k AS INTEGER
    FOR k = ab TO ab + n - 1
        IF NOT gleichesEnde(umbauJetzt$(tabs[k], pfade[k]), erwartet[k]) THEN
            ARRAY_PUSH(raus, IIF(pfade[k] = "", "Unbenannt", BASENAME(pfade[k])))
        END IF
    NEXT
    RETURN JOIN$(raus, ", ")
END FUNCTION

SUB umbauZurueck()
    IF LEN(zurAnzahl) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Kein Umbau zum Zurücknehmen."))
        protokoll("umbau zurueck 0")
        RETURN
    END IF
    ' Der LETZTE Umbau: seine Eintraege stehen am Ende der Felder.
    DIM mz AS INTEGER : mz = 0
    DIM ms AS INTEGER : ms = 1
    IF aktivesFeld() >= 0 THEN (mz, ms) = GUI_TEXTAREA_CURSOR(aktivesFeld())
    DIM letzt AS INTEGER : letzt = LEN(zurAnzahl) - 1
    DIM n AS INTEGER : n = zurAnzahl[letzt]
    DIM ab AS INTEGER : ab = LEN(zurTexte) - n
    DIM zurWas AS STRING : zurWas = zurNamen[letzt]
    ' Seit dem Umbau geaendert? Dann GAR NICHTS zuruecknehmen -- halb
    ' zurueckgenommen waere schlimmer als gar nicht.
    DIM geaendert AS STRING : geaendert = umbauGeaendert$(zurTabs, zurPfade, zurNachher, ab, n)
    IF geaendert <> "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Nicht zurückgenommen: seit dem Umbau geändert -- ") + geaendert + tr$(". Strg+Z im Reiter nimmt die eigenen Änderungen zurück."))
        protokoll("umbau zurueck geaendert " + geaendert)
        RETURN
    END IF
    DIM k AS INTEGER
    FOR k = ab TO ab + n - 1
        umbauStandSetzen(zurTabs[k], zurPfade[k], zurTexte[k])
        ARRAY_PUSH(wdhTabs, zurTabs[k]) : ARRAY_PUSH(wdhPfade, zurPfade[k])
        ARRAY_PUSH(wdhVorher, zurTexte[k]) : ARRAY_PUSH(wdhNachher, zurNachher[k])
    NEXT
    ARRAY_PUSH(wdhAnzahl, n) : ARRAY_PUSH(wdhNamen, zurWas)
    FOR k = 1 TO n
        ARRAY_POP(zurTabs) : ARRAY_POP(zurPfade) : ARRAY_POP(zurTexte) : ARRAY_POP(zurNachher)
    NEXT
    ARRAY_POP(zurAnzahl) : ARRAY_POP(zurNamen)
    reiterNeuSetzen()
    symSchluessel = "-"
    GUI_SET_TEXT(lblStatus, tr$("Zurückgenommen: ") + zurWas + " (" + STR$(n) + tr$(" Datei(en), ") + _
                 STR$(LEN(zurAnzahl)) + " weitere im Vorrat)")
    protokoll("umbau zurueck " + STR$(n))
    IF aktivesFeld() >= 0 THEN
        IF mz > 0 THEN GUI_TEXTAREA_GOTO(aktivesFeld(), mz, ms)
        GUI_FOCUS(aktivesFeld())
    END IF
END SUB

' Einen zurueckgenommenen Umbau wieder anwenden -- mit derselben Probe in
' der Gegenrichtung: steht nicht mehr der Stand von vor dem Umbau da, bleibt
' alles, wie es ist.
SUB umbauWiederholen()
    IF LEN(wdhAnzahl) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Kein zurückgenommener Umbau zum Wiederholen."))
        protokoll("umbau wieder 0")
        RETURN
    END IF
    DIM letzt AS INTEGER : letzt = LEN(wdhAnzahl) - 1
    DIM n AS INTEGER : n = wdhAnzahl[letzt]
    DIM ab AS INTEGER : ab = LEN(wdhVorher) - n
    DIM was AS STRING : was = wdhNamen[letzt]
    DIM geaendert AS STRING : geaendert = umbauGeaendert$(wdhTabs, wdhPfade, wdhVorher, ab, n)
    IF geaendert <> "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Nicht wiederholt: seit dem Zurücknehmen geändert -- ") + geaendert + ".")
        protokoll("umbau wieder geaendert " + geaendert)
        RETURN
    END IF
    DIM k AS INTEGER
    FOR k = ab TO ab + n - 1
        umbauStandSetzen(wdhTabs[k], wdhPfade[k], wdhNachher[k])
        ARRAY_PUSH(zurTabs, wdhTabs[k]) : ARRAY_PUSH(zurPfade, wdhPfade[k])
        ARRAY_PUSH(zurTexte, wdhVorher[k]) : ARRAY_PUSH(zurNachher, wdhNachher[k])
    NEXT
    ARRAY_PUSH(zurAnzahl, n) : ARRAY_PUSH(zurNamen, was)
    FOR k = 1 TO n
        ARRAY_POP(wdhTabs) : ARRAY_POP(wdhPfade) : ARRAY_POP(wdhVorher) : ARRAY_POP(wdhNachher)
    NEXT
    ARRAY_POP(wdhAnzahl) : ARRAY_POP(wdhNamen)
    reiterNeuSetzen()
    symSchluessel = "-"
    GUI_SET_TEXT(lblStatus, tr$("Wiederholt: ") + was + " (" + STR$(n) + tr$(" Datei(en))"))
    protokoll("umbau wieder " + STR$(n))
END SUB

' Den zuletzt uebernommenen Umbau noch einmal vorlegen.
'
' Ein ausgelassener Block laesst sich sonst nur zurueckholen, indem man den
' ganzen Umbau zuruecknimmt und ihn von vorn macht. Hier stehen dieselben
' Schritte wieder da, mit derselben Auswahl -- man kippt den einen Block
' und uebernimmt; gerechnet wird aus den Schritten, nicht aus dem, was
' gerade in der Datei steht.
SUB umbauNachbessern()
    IF LEN(opArt) = 0 OR LEN(umbauNachPfade) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Nachbessern: es liegt kein übernommener Umbau vor."))
        protokoll("umbau nachbessern 0")
        RETURN
    END IF
    umbauTabs = [] : umbauPfade = [] : umbauTexte = []
    DIM k AS INTEGER
    FOR k = 0 TO LEN(umbauNachPfade) - 1
        ARRAY_PUSH(umbauTabs, umbauNachTabs[k])
        ARRAY_PUSH(umbauPfade, umbauNachPfade[k])
        ARRAY_PUSH(umbauTexte, "")
    NEXT
    umbauMeldung = "Nachgebessert: " + umbauNachWas
    umbauProt = "umbau nachgebessert " + STR$(LEN(umbauTexte))
    umbauWarnung = ""
    umbauZeile = 0 : umbauSpalte = 1
    GUI_LISTBOX_CLEAR(lstUmbau)
    DIM ln AS INTEGER
    FOR ln = 0 TO LEN(umbauTexte) - 1
        DIM lname AS STRING : lname = umbauPfade[ln]
        IF lname = "" AND umbauTabs[ln] >= 0 THEN lname = tabTitel[umbauTabs[ln]]
        GUI_LISTBOX_ADD(lstUmbau, BASENAME(lname))
        GUI_LISTBOX_SET_CHECKED(lstUmbau, ln, TRUE)
    NEXT
    umbauAnzeigeBauen()
    GUI_WINDOW_TITLE(winUmbau, tr$("Nachbessern: ") + umbauNachWas)
    GUI_WINDOW_VISIBLE(winUmbau, TRUE)
    GUI_FOCUS(btnUmbauOk)
    protokoll("umbau nachbessern " + STR$(LEN(umbauTexte)))
END SUB

' Den Umbau pruefen, BEVOR er geschrieben ist.
'
' Bis Stand 21 lief `dhrt --check` erst auf dem Ergebnis -- also erst,
' nachdem die Dateien schon anders aussahen. Hier laeuft er ueber die
' Texte, die geschrieben WUERDEN, mit der Blockauswahl von jetzt: wer einen
' Block auslaesst und damit etwas kaputt macht, sieht es vor dem Schreiben.
'
' Gerechnet wird nur auf Verlangen: ein Umbau ueber zwoelf Dateien braeuchte
' sonst zwoelf Uebersetzungslaeufe, ehe man den Unterschied ueberhaupt zu
' sehen bekommt.
SUB umbauPruefen()
    IF LEN(umbauTexte) = 0 THEN RETURN
    DIM summe AS INTEGER : summe = umbauZaehlen()
    DIM sagen AS STRING
    IF summe = 0 THEN
        sagen = "Geprueft: kein Fehler in " + STR$(LEN(umbauTexte)) + " Datei(en)."
    ELSE
        sagen = "Geprueft: " + STR$(summe) + " Fehler -- sie stehen oben im Unterschied."
    END IF
    umbauAnzeigeBauen()
    GUI_SET_TEXT(lblUmbau, sagen)
    GUI_SET_TEXT(lblStatus, sagen)
    protokoll("umbau geprueft " + STR$(summe))
END SUB

' Wie viele Fehler der Umbau DAZUBRINGT -- je Datei vorher gegen nachher.
'
' Nicht die absolute Zahl: eine Datei, die schon nicht uebersetzt, wuerde
' sonst jeden Umbau in die Vorschau zwingen, obwohl er nichts damit zu tun
' hat. Der stille Weg fragt darum hier, der Knopf in der Vorschau zaehlt
' weiter absolut -- dort will man LESEN, was im Argen liegt.
FUNCTION umbauNeueFehler() AS INTEGER
    DIM summe AS INTEGER : summe = 0
    DIM k AS INTEGER
    FOR k = 0 TO LEN(umbauTexte) - 1
        DIM name AS STRING : name = umbauPfade[k]
        IF name = "" AND umbauTabs[k] >= 0 THEN name = tabTitel[umbauTabs[k]]
        IF LOWER$(RIGHT$(name, 3)) <> ".dh" THEN CONTINUE
        DIM vorher AS INTEGER : vorher = fehlerZahl(umbauAlt$(k))
        DIM nachher AS INTEGER : nachher = fehlerZahl(umbauTexte[k])
        IF nachher > vorher THEN summe = summe + (nachher - vorher)
    NEXT
    RETURN summe
END FUNCTION

' Die Texte, die geschrieben WUERDEN, durch den Uebersetzer schicken --
' liefert die Zahl der Fehler und fuellt `umbauBefunde`. Zwei Aufrufer: der
' Knopf in der Vorschau und der stille Weg ohne sie.
FUNCTION umbauZaehlen() AS INTEGER
    umbauBefunde = []
    DIM summe AS INTEGER : summe = 0
    DIM k AS INTEGER
    FOR k = 0 TO LEN(umbauTexte) - 1
        DIM name AS STRING : name = umbauPfade[k]
        IF name = "" AND umbauTabs[k] >= 0 THEN name = tabTitel[umbauTabs[k]]
        ' Nur .dh: eine .dhform ist JSON, da hat der Uebersetzer nichts zu
        ' suchen (und meldete jede Zeile als Fehler).
        IF LOWER$(RIGHT$(name, 3)) <> ".dh" THEN CONTINUE
        DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_CHECK$(umbauTexte[k], projektOrdner))
        DIM i AS INTEGER
        FOR i = 0 TO JSON_LEN(j, "") - 1
            DIM pp AS STRING : pp = STR$(i)
            IF JSON_GET_STRING(j, pp + ".schwere") <> "fehler" THEN CONTINUE
            ' WELCHER Fehler, nicht nur wie viele: eine Zahl sagt einem
            ' nicht, ob man den Block wieder aufnehmen muss oder etwas
            ' anderes vergessen hat.
            ARRAY_PUSH(umbauBefunde, BASENAME(name) + ":" + _
                       STR$(JSON_GET_INT(j, pp + ".zeile")) + ": " + _
                       JSON_GET_STRING(j, pp + ".meldung"))
            summe = summe + 1
        NEXT
    NEXT
    RETURN summe
END FUNCTION

SUB umbauVerwerfen()
    GUI_WINDOW_VISIBLE(winUmbau, FALSE)
    umbauLeeren()
    GUI_SET_TEXT(lblStatus, tr$("Umbau verworfen -- nichts geändert."))
    protokoll("umbau verworfen")
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 THEN GUI_FOCUS(ta)
END SUB

SUB umbauSchreiben()
    ' ZUERST das Abgewaehlte heraus -- vor dem Ausblenden des Fensters (die
    ' Kaestchen sitzen darin) und vor dem Vorrat zum Zuruecknehmen, sonst
    ' schriebe ein Strg+Umschalt+Z eine Datei zurueck, die gar nicht
    ' geaendert wurde.
    IF GUI_WINDOW_SHOWN(winUmbau) THEN
        DIM ab AS INTEGER
        FOR ab = LEN(umbauTexte) - 1 TO 0 STEP -1
            IF NOT GUI_LISTBOX_CHECKED(lstUmbau, ab) THEN
                ARRAY_REMOVE_AT(umbauTabs, ab) : ARRAY_REMOVE_AT(umbauPfade, ab)
                ARRAY_REMOVE_AT(umbauTexte, ab)
            END IF
        NEXT
    END IF
    GUI_WINDOW_VISIBLE(winUmbau, FALSE)
    IF LEN(umbauTexte) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Alles abgewählt -- nichts geändert."))
        protokoll("umbau abgewaehlt alles")
        umbauLeeren()
        IF aktivesFeld() >= 0 THEN GUI_FOCUS(aktivesFeld())
        RETURN
    END IF
    ' Den Stand VOR dem Umbau aufheben, bevor er ueberschrieben wird.
    DIM v AS INTEGER
    FOR v = 0 TO LEN(umbauTexte) - 1
        ARRAY_PUSH(zurTabs, umbauTabs[v])
        ARRAY_PUSH(zurPfade, umbauPfade[v])
        ARRAY_PUSH(zurTexte, umbauAlt$(v))
        ARRAY_PUSH(zurNachher, umbauTexte[v])
    NEXT
    ARRAY_PUSH(zurAnzahl, LEN(umbauTexte))
    ARRAY_PUSH(zurNamen, umbauMeldung)
    wdhTabs = [] : wdhPfade = [] : wdhVorher = [] : wdhNachher = []
    wdhAnzahl = [] : wdhNamen = []
    ' Der aelteste faellt heraus -- ein Vorrat, der mit jedem Umbau waechst,
    ' haelt irgendwann das ganze Projekt in mehreren Fassungen.
    WHILE LEN(zurAnzahl) > ZUR_MAX
        DIM weg AS INTEGER : weg = zurAnzahl[0]
        DIM k2 AS INTEGER
        FOR k2 = 1 TO weg
            ARRAY_REMOVE_AT(zurTabs, 0) : ARRAY_REMOVE_AT(zurPfade, 0) : ARRAY_REMOVE_AT(zurTexte, 0)
            ARRAY_REMOVE_AT(zurNachher, 0)
        NEXT
        ARRAY_REMOVE_AT(zurAnzahl, 0) : ARRAY_REMOVE_AT(zurNamen, 0)
    WEND
    DIM k AS INTEGER
    FOR k = 0 TO LEN(umbauTexte) - 1
        IF umbauTabs[k] >= 0 THEN
            ' In den Reiter: Auswahl ueber alles + INSERT. GUI_SET_TEXT
            ' leerte den Verlauf -- so nimmt EIN Strg+Z den Umbau zurueck.
            DIM ta AS GUI_WIDGET : ta = tabFelder[umbauTabs[k]]
            DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
            DIM letzte AS INTEGER : letzte = LEN(zeilen)
            GUI_TEXTAREA_SELECT(ta, 1, 1, letzte, LEN(zeilen[letzte - 1]) + 1)
            GUI_TEXTAREA_INSERT(ta, umbauTexte[k])
        ELSE
            WRITEALL(umbauPfade[k], umbauTexte[k] + NL)
            DIM t AS INTEGER : t = tabMitPfad(umbauPfade[k])
            IF t >= 0 THEN
                GUI_SET_TEXT(tabFelder[t], umbauTexte[k])
                tabGesichert[t] = umbauTexte[k]
                tabLetzterText[t] = ""
            END IF
        END IF
    NEXT
    ' Eine Datei, die es vorher nicht gab, bekommt einen Reiter: sonst hat
    ' der Umbau etwas angelegt, das niemand sieht, und man sucht es im
    ' Projektbaum.
    DIM neuDa AS INTEGER : neuDa = 0
    DIM warTab AS INTEGER : warTab = aktiverTab
    DIM nk2 AS INTEGER
    FOR nk2 = 0 TO LEN(umbauTexte) - 1
        IF umbauTabs[nk2] >= 0 OR umbauPfade[nk2] = "" THEN CONTINUE
        IF zurTexte[LEN(zurTexte) - LEN(umbauTexte) + nk2] <> "" THEN CONTINUE
        dateiOeffnen(umbauPfade[nk2])
        neuDa = neuDa + 1
    NEXT
    IF neuDa > 0 THEN
        ' Vorn bleibt, woran man gearbeitet hat -- die neue Datei liegt
        ' daneben. Sonst schriebe die Marke unten in eine fremde Datei.
        IF warTab >= 0 AND warTab < tabAnzahl THEN
            aktiverTab = warTab
            GUI_SET_ACTIVE_TAB(win, aktiverTab)
        END IF
        protokoll("umbau neue datei " + STR$(neuDa))
    END IF
    DIM feld AS GUI_WIDGET : feld = aktivesFeld()
    IF feld >= 0 THEN
        IF umbauZeile > 0 THEN GUI_TEXTAREA_GOTO(feld, umbauZeile, umbauSpalte)
        GUI_FOCUS(feld)
    END IF
    reiterNeuSetzen()
    symSchluessel = "-"
    ' Fuer das Nachbessern merken -- die Schritte selbst bleiben ohnehin
    ' stehen, nur die Zuordnung zu den Dateien geht mit umbauLeeren weg.
    umbauNachTabs = [] : umbauNachPfade = [] : umbauNachWas = umbauMeldung
    DIM nk AS INTEGER
    FOR nk = 0 TO LEN(umbauTexte) - 1
        ARRAY_PUSH(umbauNachTabs, umbauTabs[nk])
        ARRAY_PUSH(umbauNachPfade, umbauPfade[nk])
    NEXT
    GUI_SET_TEXT(lblStatus, umbauMeldung)
    IF umbauProt <> "" THEN protokoll(umbauProt)
    umbauLeeren()
END SUB

' --- Vererbung: wer eine Ueberschreibung umbenennt, zerreisst sie -------
' Heisst eine Methode in der Oberklasse genauso, ist die Umbenennung in
' EINER Klasse keine Umbenennung, sondern eine Trennung: die Ueberschreibung
' greift nicht mehr, und zwar ohne Uebersetzungsfehler -- gerufen wird von
' da an die Fassung der Oberklasse. Genau darum steht es in der Vorschau.
DIM klsName AS ARRAY OF STRING : klsName = []
DIM klsBasis AS ARRAY OF STRING : klsBasis = []
DIM klsDatei AS ARRAY OF STRING : klsDatei = []
DIM klsMethoden AS ARRAY OF STRING : klsMethoden = []

' Alle Klassen des Projekts einlesen: Name, Oberklasse, Methoden.
SUB klassenLesen()
    klsName = [] : klsBasis = [] : klsDatei = [] : klsMethoden = []
    DIM d AS STRING
    FOR EACH d IN projektDateien("*.dh")
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM quelle AS STRING : quelle = projektQuelle$(pfad)
        IF quelle = "" THEN CONTINUE
        DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
        DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
        DIM i AS INTEGER
        FOR i = 0 TO JSON_LEN(j, "") - 1
            DIM p AS STRING : p = STR$(i)
            IF LOWER$(JSON_GET_STRING(j, p + ".art")) <> "class" THEN CONTINUE
            DIM name AS STRING : name = JSON_GET_STRING(j, p + ".name")
            DIM von AS INTEGER : von = JSON_GET_INT(j, p + ".von")
            ' Die Oberklasse steht nur im TEXT der Kopfzeile -- CODE_SYMBOLS$
            ' kennt sie nicht.
            DIM basis AS STRING : basis = ""
            IF von >= 1 AND von <= LEN(zeilen) THEN
                DIM kopf AS STRING : kopf = UPPER$(zeilen[von - 1])
                DIM ex AS INTEGER : ex = INSTR(kopf, " EXTENDS ")
                IF ex >= 0 THEN basis = TRIM$(MID$(zeilen[von - 1], ex + 9))
            END IF
            DIM mm AS STRING : mm = "|"
            DIM m AS INTEGER
            FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
                mm = mm + LOWER$(JSON_GET_STRING(j, p + ".kinder." + STR$(m) + ".name")) + "|"
            NEXT
            ARRAY_PUSH(klsName, name) : ARRAY_PUSH(klsBasis, basis)
            ARRAY_PUSH(klsDatei, d) : ARRAY_PUSH(klsMethoden, mm)
        NEXT
    NEXT
END SUB

FUNCTION klasseIndex(name AS STRING) AS INTEGER
    DIM klein AS STRING : klein = LOWER$(name)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(klsName) - 1
        IF LOWER$(klsName[i]) = klein THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Welche ANDERE Klasse derselben Familie hat eine Methode dieses Namens?
' Geliefert wird "Tier (helfer.dh)" oder "". Gegangen wird nach oben ueber
' EXTENDS und nach unten ueber alle, die davon erben -- eine Umbenennung
' zerreisst die Verbindung in beide Richtungen gleichermassen.
FUNCTION familieHatMethode$(klasse AS STRING, methode AS STRING) AS STRING
    DIM ziel AS STRING : ziel = "|" + LOWER$(methode) + "|"
    ' nach oben
    DIM oben AS STRING : oben = klasse
    DIM runde AS INTEGER : runde = 0
    WHILE runde < 20
        runde = runde + 1
        DIM k AS INTEGER : k = klasseIndex(oben)
        IF k < 0 OR klsBasis[k] = "" THEN BREAK
        oben = klsBasis[k]
        DIM o AS INTEGER : o = klasseIndex(oben)
        IF o < 0 THEN BREAK
        IF INSTR(klsMethoden[o], ziel) >= 0 THEN RETURN klsName[o] + " (" + klsDatei[o] + ")"
    WEND
    ' nach unten: alles, was (ueber Zwischenstufen) von `klasse` erbt
    DIM unten AS ARRAY OF STRING : unten = [LOWER$(klasse)]
    DIM gewachsen AS BOOLEAN : gewachsen = TRUE
    DIM tiefe AS INTEGER : tiefe = 0
    WHILE gewachsen AND tiefe < 20
        gewachsen = FALSE
        tiefe = tiefe + 1
        DIM i AS INTEGER
        FOR i = 0 TO LEN(klsName) - 1
            IF klsBasis[i] = "" THEN CONTINUE
            IF ARRAY_INDEXOF(unten, LOWER$(klsBasis[i])) < 0 THEN CONTINUE
            IF ARRAY_INDEXOF(unten, LOWER$(klsName[i])) >= 0 THEN CONTINUE
            ARRAY_PUSH(unten, LOWER$(klsName[i]))
            gewachsen = TRUE
            IF INSTR(klsMethoden[i], ziel) >= 0 THEN RETURN klsName[i] + " (" + klsDatei[i] + ")"
        NEXT
    WEND
    RETURN ""
END FUNCTION

' Der Einwand zum Umbenennen von `wort` an der Marke -- "" wenn keiner.
' Zwei Fragen: gibt es den neuen Namen schon, und zerreisst die Umbenennung
' eine Ueberschreibung?
FUNCTION umbenennEinwand$(alt AS STRING, neu AS STRING) AS STRING
    DIM schon AS STRING : schon = nameVergeben$(neu)
    IF schon <> "" THEN
        RETURN "Achtung: '" + neu + "' gibt es im Projekt schon (" + schon + ")."
    END IF
    ' Nach der Klasse wird nicht an der MARKE gefragt -- die steht vielleicht
    ' auf einem Aufruf, und der kann ueberall stehen. Gefragt wird, WELCHE
    ' Klassen eine Methode dieses Namens haben.
    klassenLesen()
    DIM ziel AS STRING : ziel = "|" + LOWER$(alt) + "|"
    DIM i AS INTEGER
    FOR i = 0 TO LEN(klsName) - 1
        IF INSTR(klsMethoden[i], ziel) < 0 THEN CONTINUE
        DIM wo AS STRING : wo = familieHatMethode$(klsName[i], alt)
        IF wo = "" THEN CONTINUE
        RETURN "Achtung: '" + alt + "' gibt es in " + klsName[i] + " UND in " + wo + _
               " -- wird nur eine umbenannt, greift die Überschreibung nicht mehr, " + _
               "und zwar ohne Fehlermeldung."
    NEXT
    RETURN ""
END FUNCTION

' --- Umbenennen (Umschalt+F6) ----------------------------------------
' Das Umbenennen selbst macht CODE_RENAME$: ganze Woerter, ohne Kommentare
' und Zeichenketten. Die IDE fragt nur den neuen Namen und schreibt das
' Ergebnis als EINEN Undo-Schritt zurueck (Auswahl ueber alles + INSERT --
' GUI_SET_TEXT leerte den Verlauf).
SUB umbenennenFragen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM alt AS STRING : alt = wortUnterMarke$()
    IF alt = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Umbenennen: unter der Marke steht kein Name."))
        RETURN
    END IF
    (umbenennZeile, umbenennSpalte) = GUI_TEXTAREA_CURSOR(ta)
    umbenennWort = alt
    dlgUmbenennen = GUI_PROMPT(tr$("Umbenennen"), "'" + alt + tr$("' überall nennen in:"), alt)
END SUB

SUB umbenennenAusfuehren(neu AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM neuText AS STRING : neuText = CODE_RENAME$(q, umbenennZeile, umbenennSpalte, neu)
    IF neuText = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Umbenennen: '") + neu + tr$("' geht nicht -- ein Name fängt mit Buchstabe oder _ an, und Schlüsselwörter bleiben, wie sie sind."))
        RETURN
    END IF
    IF neuText = q THEN
        GUI_SET_TEXT(lblStatus, tr$("Umbenennen: nichts zu tun."))
        RETURN
    END IF
    ' Die Zahl der Fundstellen sagt CODE_REFERENCES -- am ALTEN Text, denn
    ' im neuen heisst der Name schon anders.
    DIM n AS INTEGER : n = LEN(CODE_REFERENCES(q, umbenennZeile, umbenennSpalte))
    umbauLeeren()
    umbauVormerken(aktiverTab, tabPfade[aktiverTab], neuText)
    umbauZeile = umbenennZeile : umbauSpalte = umbenennSpalte
    formulareNachziehen(umbenennWort, neu)
    umbauWarnung = umbenennEinwand$(umbenennWort, neu)
    umbauStarten("Umbenennen in '" + neu + "'", _
                 STR$(n) + " Stellen umbenannt in '" + neu + "'.", _
                 "umbenannt " + STR$(n) + " " + neu)
END SUB

' --- Schnipsel (Strg+J) -----------------------------------------------
' Vorlagen mit einem Platzhalter `|` fuer die Schreibmarke. Die Einrueckung
' der laufenden Zeile wird auf jede weitere Zeile uebernommen -- sonst
' klebte ein eingefuegter Block am linken Rand.
DIM schnipselNamen AS ARRAY OF STRING : schnipselNamen = []
DIM schnipselText AS ARRAY OF STRING : schnipselText = []
' Das kurze Wort, das den Schnipsel am Tabulator aufklappt. Die Laufzeit
' meldet nur, DASS eines links der Marke steht (GUI_TEXTAREA_ABBREV) --
' was an seine Stelle kommt, steht hier.
DIM schnipselAbk AS ARRAY OF STRING : schnipselAbk = []
' "" = eingebaut, "eigen" = aus der eigenen Datei (steht in der Liste rechts).
DIM schnipselHerkunft AS ARRAY OF STRING : schnipselHerkunft = []

SUB schnipsel(name AS STRING, abk AS STRING, text AS STRING)
    ARRAY_PUSH(schnipselNamen, IIF(abk = "", name, name + "   [" + abk + "]"))
    ARRAY_PUSH(schnipselAbk, abk)
    ARRAY_PUSH(schnipselText, text)
    ARRAY_PUSH(schnipselHerkunft, "")
END SUB

' `weg` = so viele Zeichen links der Marke weichen (das getippte Kuerzel).
SUB schnipselEinfuegen(nummer AS INTEGER, weg AS INTEGER = 0)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR nummer < 0 OR nummer >= LEN(schnipselText) THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    IF weg > 0 AND s - weg >= 1 THEN
        ' Das Kuerzel markieren -- GUI_TEXTAREA_INSERT ersetzt die Auswahl,
        ' und die Marke steht danach dort, wo das Wort anfing.
        GUI_TEXTAREA_SELECT(ta, z, s - weg, z, s)
        s = s - weg
    END IF
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM einzug AS STRING : einzug = ""
    IF z >= 1 AND z <= LEN(zeilen) THEN
        ' MID$ zaehlt ab 0 -- Zeichen k ist MID$(s, k, 1).
        DIM k AS INTEGER : k = 0
        WHILE k < LEN(zeilen[z - 1]) AND MID$(zeilen[z - 1], k, 1) = " "
            einzug = einzug + " " : k = k + 1
        WEND
    END IF
    ' Eingerueckt wird Zeile fuer Zeile, LEERE ausgenommen: ein blindes
    ' REPLACE$ machte aus jeder Leerzeile vier Leerzeichen, und die sieht man
    ' erst im Diff.
    DIM roh AS ARRAY OF STRING : roh = SPLIT$(schnipselText[nummer], NL)
    DIM zusammen AS ARRAY OF STRING : zusammen = []
    DIM ri AS INTEGER
    FOR ri = 0 TO LEN(roh) - 1
        IF ri = 0 OR roh[ri] = "" THEN
            ARRAY_PUSH(zusammen, roh[ri])
        ELSE
            ARRAY_PUSH(zusammen, einzug + roh[ri])
        END IF
    NEXT
    DIM text AS STRING : text = JOIN$(zusammen, NL)
    ' Wohin die Marke danach gehoert: der Platzhalter | wird gezaehlt und
    ' entfernt. Ohne ihn steht sie am Ende, wie nach jedem Einfuegen.
    ' INSTR zaehlt ab 0 und liefert -1, wenn es den Platzhalter nicht gibt.
    DIM marke AS INTEGER : marke = INSTR(text, "|")
    text = REPLACE$(text, "|", "")
    GUI_TEXTAREA_INSERT(ta, text)
    IF marke >= 0 THEN
        DIM vor AS STRING : vor = LEFT$(text, marke)
        DIM neueZ AS INTEGER : neueZ = z + LEN(SPLIT$(vor, NL)) - 1
        DIM letzteZ AS STRING : letzteZ = SPLIT$(vor, NL)[LEN(SPLIT$(vor, NL)) - 1]
        DIM neueS AS INTEGER : neueS = LEN(letzteZ) + 1
        IF neueZ = z THEN neueS = s + LEN(letzteZ)
        GUI_TEXTAREA_GOTO(ta, neueZ, neueS)
    END IF
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, tr$("Schnipsel: ") + schnipselNamen[nummer])
    protokoll("schnipsel " + schnipselNamen[nummer])
END SUB

SUB schnipselWaehlen()
    IF aktivesFeld() < 0 THEN RETURN
    paletteNamen = []
    paletteKennungen = []
    paletteDetails = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(schnipselNamen) - 1
        ARRAY_PUSH(paletteNamen, schnipselNamen[i]) : ARRAY_PUSH(paletteKennungen, STR$(i)) : ARRAY_PUSH(paletteDetails, schnipselHerkunft[i])
    NEXT
    waehlerOeffnen("schnipsel", tr$("Schnipsel einfügen"))
    ' Der Wortanfang links der Marke fuellt den Filter schon aus: wer `for`
    ' getippt hat und Strg+J drueckt, hat die FOR-Schleife vor sich.
    DIM anfang AS STRING : anfang = wortAnfang$()
    IF anfang <> "" THEN
        GUI_SET_TEXT(tfPalette, anfang)
        paletteLetzterFilter = anfang
        paletteFuellen(anfang)
    END IF
END SUB

SUB zeilenErsetzen(ta AS GUI_WIDGET, z1 AS INTEGER, z2 AS INTEGER, neu AS ARRAY OF STRING)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
    GUI_TEXTAREA_INSERT(ta, JOIN$(neu, NL))
END SUB

SUB kommentarUmschalten()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM alleKommentiert AS BOOLEAN : alleKommentiert = TRUE
    DIM einzug AS INTEGER : einzug = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(block) - 1
        DIM t AS STRING : t = LTRIM$(block[i])
        IF t = "" THEN CONTINUE
        IF LEFT$(t, 1) <> "'" THEN alleKommentiert = FALSE
        DIM e AS INTEGER : e = LEN(block[i]) - LEN(t)
        IF einzug < 0 OR e < einzug THEN einzug = e
    NEXT
    IF einzug < 0 THEN RETURN                      ' nur Leerzeilen
    FOR i = 0 TO LEN(block) - 1
        DIM t2 AS STRING : t2 = LTRIM$(block[i])
        IF t2 = "" THEN CONTINUE
        IF alleKommentiert THEN
            DIM rest AS STRING : rest = MID$(t2, 1)
            IF LEFT$(rest, 1) = " " THEN rest = MID$(rest, 1)
            block[i] = LEFT$(block[i], LEN(block[i]) - LEN(t2)) + rest
        ELSE
            block[i] = LEFT$(block[i], einzug) + "' " + MID$(block[i], einzug)
        END IF
    NEXT
    zeilenErsetzen(ta, z1, z2, block)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
    protokoll("kommentar " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenDuplizieren()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM doppelt AS ARRAY OF STRING : doppelt = []
    DIM z AS STRING
    FOR EACH z IN block : ARRAY_PUSH(doppelt, z) : NEXT
    FOR EACH z IN block : ARRAY_PUSH(doppelt, z) : NEXT
    zeilenErsetzen(ta, z1, z2, doppelt)
    GUI_TEXTAREA_GOTO(ta, z2 + 1, 1)
    protokoll("dupliziert " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenLoeschen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM anzahl AS INTEGER : anzahl = LEN(SPLIT$(GUI_TEXT(ta), NL))
    IF z2 < anzahl THEN
        GUI_TEXTAREA_SELECT(ta, z1, 1, z2 + 1, 1)          ' samt dem Umbruch dahinter
    ELSEIF z1 > 1 THEN
        GUI_TEXTAREA_SELECT(ta, z1 - 1, SPALTE_ENDE, z2, SPALTE_ENDE)   ' die letzte: samt dem Umbruch davor
    ELSE
        GUI_TEXTAREA_SELECT(ta, 1, 1, z2, SPALTE_ENDE)
    END IF
    GUI_TEXTAREA_INSERT(ta, "")
    GUI_TEXTAREA_GOTO(ta, MIN(z1, MAX(anzahl - (z2 - z1 + 1), 1)), 1)
    protokoll("geloescht " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenVerschieben(richtung AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM alle AS ARRAY OF STRING : alle = SPLIT$(GUI_TEXT(ta), NL)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(alle, z1, z2)
    DIM neu AS ARRAY OF STRING : neu = []
    DIM z AS STRING
    IF richtung < 0 THEN
        IF z1 <= 1 THEN RETURN
        FOR EACH z IN block : ARRAY_PUSH(neu, z) : NEXT
        ARRAY_PUSH(neu, alle[z1 - 2])
        zeilenErsetzen(ta, z1 - 1, z2, neu)
        GUI_TEXTAREA_SELECT(ta, z1 - 1, 1, z2 - 1, SPALTE_ENDE)
    ELSE
        IF z2 >= LEN(alle) THEN RETURN
        ARRAY_PUSH(neu, alle[z2])
        FOR EACH z IN block : ARRAY_PUSH(neu, z) : NEXT
        zeilenErsetzen(ta, z1, z2 + 1, neu)
        GUI_TEXTAREA_SELECT(ta, z1 + 1, 1, z2 + 1, SPALTE_ENDE)
    END IF
    protokoll("verschoben " + STR$(z1) + "-" + STR$(z2) + " " + STR$(richtung))
END SUB

SUB einruecken(richtung AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(block) - 1
        IF TRIM$(block[i]) = "" THEN CONTINUE
        IF richtung > 0 THEN
            block[i] = "    " + block[i]
        ELSE
            DIM weg AS INTEGER : weg = 0
            WHILE weg < 4 AND weg < LEN(block[i]) AND MID$(block[i], weg, 1) = " " : weg = weg + 1 : WEND
            block[i] = MID$(block[i], weg)
        END IF
    NEXT
    zeilenErsetzen(ta, z1, z2, block)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
END SUB

' Umschalt+Alt+F: derselbe Formatierer wie `dhrt fmt` -- Schluesselwoerter
' gross, Bloecke eingerueckt, Leerraum am Zeilenende weg.
SUB formatieren()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM text AS STRING : text = GUI_TEXT(ta)
    DIM neu AS STRING : neu = CODE_FORMAT$(text)
    IF neu = "" AND TRIM$(text) <> "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Nicht formatiert: die Quelle lässt sich nicht lesen (Syntaxfehler, siehe Probleme)."))
        RETURN
    END IF
    IF RIGHT$(text, 1) = NL THEN neu = neu + NL
    IF neu = text THEN GUI_SET_TEXT(lblStatus, tr$("Schon formatiert.")) : RETURN
    feldAustauschen(ta, text, neu)
    GUI_SET_TEXT(lblStatus, tr$("Formatiert."))
    protokoll("formatiert")
END SUB

' Den ganzen Text eines Feldes ersetzen -- als EIN Undo-Schritt (Auswahl
' ueber alles + INSERT; GUI_SET_TEXT leerte den Verlauf), die Marke bleibt
' auf ihrer Zeile und Spalte.
SUB feldAustauschen(ta AS GUI_WIDGET, alt AS STRING, neu AS STRING)
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    GUI_TEXTAREA_SELECT(ta, 1, 1, LEN(SPLIT$(alt, NL)), SPALTE_ENDE)
    GUI_TEXTAREA_INSERT(ta, neu)
    GUI_TEXTAREA_GOTO(ta, z, s)
END SUB

' --- Export als eigenstaendiges Programm (dhrt --export) ----------------
SUB exportieren()
    IF aktiverTab < 0 THEN RETURN
    IF exportProzess >= 0 THEN GUI_SET_TEXT(lblStatus, tr$("Ein Export läuft noch.")) : RETURN
    IF tabPfade[aktiverTab] = "" OR GUI_TEXT(tabFelder[aktiverTab]) <> tabGesichert[aktiverTab] THEN
        IF NOT sichern(aktiverTab, FALSE) THEN RETURN
    END IF
    exportDatei = tabPfade[aktiverTab]
    exportProzess = PROCESS_START("dhrt", "--export", exportDatei)
    GUI_SET_TEXT(lblStatus, tr$("Export läuft: ") + BASENAME(exportDatei) + " ...")
    protokoll("export " + exportDatei)
END SUB

SUB exportNachsehen()
    IF exportProzess < 0 THEN RETURN
    DIM t AS STRING : t = PROCESS_READ$(exportProzess) + PROCESS_ERR$(exportProzess)
    IF t <> "" THEN ausgabeVerteilen(t)
    IF PROCESS_RUNNING(exportProzess) THEN RETURN
    DIM code AS INTEGER : code = PROCESS_CODE(exportProzess)
    PROCESS_CLOSE(exportProzess)
    exportProzess = -1
    DIM stamm AS STRING : stamm = BASENAME(exportDatei)
    IF LOWER$(RIGHT$(stamm, 3)) = ".dh" THEN stamm = LEFT$(stamm, LEN(stamm) - 3)
    DIM ziel AS STRING : ziel = PATHJOIN(DIRNAME(exportDatei), stamm + "_dist")
    IF code = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Exportiert nach ") + ziel)
    ELSE
        GUI_SET_TEXT(lblStatus, tr$("Export fehlgeschlagen (Code ") + STR$(code) + tr$(") -- siehe Ausgabe."))
    END IF
    protokoll("exportiert " + STR$(code) + " " + ziel)
END SUB

' --- Ausfuehren --------------------------------------------------------
SUB ausgabe(zeile AS STRING)
    GUI_LISTBOX_ADD(lstAusgabe, zeile)
    ' Zeilen mit einer Stelle sind anklickbar -- das sieht man an der Farbe.
    IF INSTR(LOWER$(zeile), ".dh:") >= 0 THEN
        DIM ortP AS STRING
        DIM ortZ AS INTEGER
        (ortP, ortZ) = ausgabeOrt(zeile)
        IF ortP <> "" THEN
            DIM farbe AS INTEGER : farbe = &H60A0E0
            IF INSTR(zeile, "Warnung") >= 0 THEN farbe = &HE0C060
            IF INSTR(LOWER$(zeile), "fehler") >= 0 THEN farbe = &HE06060
            GUI_LISTBOX_COLOR(lstAusgabe, GUI_LISTBOX_COUNT(lstAusgabe) - 1, farbe)
        END IF
    END IF
    IF GUI_LISTBOX_COUNT(lstAusgabe) > 2000 THEN GUI_LISTBOX_REMOVE(lstAusgabe, 0)
    GUI_LISTBOX_SET_SELECTED(lstAusgabe, GUI_LISTBOX_COUNT(lstAusgabe) - 1)
END SUB

DIM ausgabeRest AS STRING : ausgabeRest = ""

SUB ausgabeVerteilen(text AS STRING)
    IF text = "" THEN RETURN
    ausgabeRest = ausgabeRest + text
    WHILE INSTR(ausgabeRest, NL) >= 0
        DIM p AS INTEGER : p = INSTR(ausgabeRest, NL)
        DIM z AS STRING : z = LEFT$(ausgabeRest, p)
        z = REPLACE$(z, CHR$(13), "")
        ausgabe(z)
        ausgabeRest = MID$(ausgabeRest, p + 1)
    WEND
END SUB

' Ein Programm starten -- als Lauf, im Debugger oder unter dem Profiler.
' Alle drei sind derselbe Kindprozess mit einem anderen Unterbefehl.
FUNCTION prozessStarten(art AS STRING) AS BOOLEAN
    IF aktiverTab < 0 THEN RETURN FALSE
    IF prozess >= 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Es läuft noch ein Programm -- erst stoppen (Umschalt+F5)."))
        RETURN FALSE
    END IF
    IF tabPfade[aktiverTab] = "" OR GUI_TEXT(tabFelder[aktiverTab]) <> tabGesichert[aktiverTab] THEN
        IF NOT sichern(aktiverTab, FALSE) THEN RETURN FALSE
    END IF
    ' Auch die ANDEREN geaenderten Reiter: das Programm liest eine importierte
    ' Datei von der Platte, und bis 2026-09-27 lief dann die alte Fassung --
    ' im Debugger passten obendrein die Zeilen nicht zum Editor. Ein Reiter
    ' ohne Namen gehoert zu keinem Programm und bleibt, wie er ist.
    DIM tg AS INTEGER
    DIM tgN AS INTEGER : tgN = 0
    FOR tg = 0 TO tabAnzahl - 1
        IF tg <> aktiverTab AND tabPfade[tg] <> "" THEN
            IF GUI_TEXT(tabFelder[tg]) <> tabGesichert[tg] THEN
                IF sichern(tg, FALSE) THEN tgN = tgN + 1
            END IF
        END IF
    NEXT
    IF tgN > 0 THEN protokoll("vor start gesichert " + STR$(tgN))
    RETURN prozessStartenDatei(art, tabPfade[aktiverTab])
END FUNCTION

' Eine Datei starten (run/debug/profile), ohne sie in einem Reiter zu haben.
FUNCTION prozessStartenDatei(art AS STRING, datei AS STRING) AS BOOLEAN
    IF prozess >= 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Es läuft noch ein Programm -- erst stoppen (Umschalt+F5)."))
        RETURN FALSE
    END IF
    GUI_LISTBOX_CLEAR(lstAusgabe)
    ' Wer startet, will die Ausgabe sehen -- eine ausgeblendete untere
    ' Leiste kommt zurueck, und das Terminal macht ihr Platz.
    IF terminalAn THEN terminalZeigen(FALSE)
    IF NOT untenAn THEN leistenSetzen(seitenAn, TRUE)
    ausgabeRest = "" : prozessRest = ""
    prozessDatei = datei
    prozessArt = art
    ' Argumente und Umgebung dieser Datei (Ausfuehren -> Startargumente /
    ' Umgebung). Die Umgebung gilt NUR fuer das Kind; SETENV bliebe fuer
    ' jeden weiteren Start stehen.
    DIM sa AS ARRAY OF STRING : sa = startWoerter(startWert$(datei, FALSE))
    DIM su AS MAP OF STRING : su = startUmgebung(startWert$(datei, TRUE))
    IF LEN(sa) > 0 THEN
        prozess = PROCESS_START("dhrt", art, prozessDatei, "--", sa, su)
    ELSE
        prozess = PROCESS_START("dhrt", art, prozessDatei, su)
    END IF
    IF LEN(sa) > 0 OR LEN(MAPKEYS(su)) > 0 THEN
        protokoll("start mit " + STR$(LEN(sa)) + " argumenten " + STR$(LEN(MAPKEYS(su))) + " umgebung")
    END IF
    lichtstreif(1500)
    GUI_SET_TEXT(lblAusgabe, tr$("Ausgabe: ") + BASENAME(prozessDatei) + tr$(" läuft ..."))
    GUI_SET_TEXT(lblStatus, tr$("Gestartet: ") + prozessDatei)
    RETURN TRUE
END FUNCTION

SUB starten()
    IF prozessStarten("run") THEN protokoll("gestartet " + prozessDatei)
END SUB

' --- Zurueck/Vorwaerts ---------------------------------------------------
' Jeder Sprung wird gemerkt -- in eine andere Datei oder um mindestens acht
' Zeilen, ohne dass sich der Text geaendert hat (F12, Problemliste, Suche,
' Gliederung, Klick weit weg). Beobachtet wird die Marke je Bild statt an
' jeder der dreissig Sprungstellen einzeln: eine neue Sprungstelle waere
' sonst eine, die man vergisst. Bild auf/ab und Pos1/Ende sind Blaettern,
' kein Sprung.
DIM navPfade AS ARRAY OF STRING : navPfade = []
DIM navZeilen AS ARRAY OF INTEGER : navZeilen = []
DIM navSpalten AS ARRAY OF INTEGER : navSpalten = []
DIM vorPfade AS ARRAY OF STRING : vorPfade = []
DIM vorZeilen AS ARRAY OF INTEGER : vorZeilen = []
DIM vorSpalten AS ARRAY OF INTEGER : vorSpalten = []
DIM navLetztPfad AS STRING : navLetztPfad = ""
DIM navLetztZeile AS INTEGER : navLetztZeile = 0
DIM navLetztSpalte AS INTEGER : navLetztSpalte = 0
DIM navLetztLaenge AS INTEGER : navLetztLaenge = -1
DIM navSperre AS BOOLEAN : navSperre = FALSE
CONST NAV_MAX = 50

SUB navNachziehen()
    IF MOUSE_HIT(3) THEN navGehen(TRUE)
    IF MOUSE_HIT(4) THEN navGehen(FALSE)
    IF aktiverTab < 0 THEN navLetztPfad = "" : RETURN
    DIM p AS STRING : p = tabPfade[aktiverTab]
    IF p = "" THEN navLetztPfad = "" : RETURN
    DIM ta AS GUI_WIDGET : ta = tabFelder[aktiverTab]
    DIM z AS INTEGER
    DIM sp AS INTEGER
    (z, sp) = GUI_TEXTAREA_CURSOR(ta)
    DIM laenge AS INTEGER : laenge = LEN(GUI_TEXT(ta))
    IF navLetztPfad <> "" AND NOT navSperre THEN
        DIM sprung AS BOOLEAN : sprung = FALSE
        IF p <> navLetztPfad THEN
            sprung = wegGleich$(p) <> wegGleich$(navLetztPfad)
        ELSEIF ABS(z - navLetztZeile) >= 8 AND laenge = navLetztLaenge THEN
            sprung = NOT (KEYHIT(KEY_PAGEUP) OR KEYHIT(KEY_PAGEDOWN) OR KEYHIT(KEY_HOME) OR KEYHIT(KEY_END))
        END IF
        IF sprung THEN
            navAblegen(navPfade, navZeilen, navSpalten, navLetztPfad, navLetztZeile, navLetztSpalte)
            vorPfade = [] : vorZeilen = [] : vorSpalten = []
            protokoll("nav gemerkt " + BASENAME(navLetztPfad) + " " + STR$(navLetztZeile))
        END IF
    END IF
    navSperre = FALSE
    navLetztPfad = p : navLetztZeile = z : navLetztSpalte = sp : navLetztLaenge = laenge
END SUB

SUB navAblegen(ps AS ARRAY OF STRING, zs AS ARRAY OF INTEGER, ss AS ARRAY OF INTEGER, _
               p AS STRING, z AS INTEGER, sp AS INTEGER)
    DIM n AS INTEGER : n = LEN(ps)
    IF n > 0 THEN
        IF ps[n - 1] = p AND zs[n - 1] = z THEN RETURN
    END IF
    ARRAY_PUSH(ps, p) : ARRAY_PUSH(zs, z) : ARRAY_PUSH(ss, sp)
    IF LEN(ps) > NAV_MAX THEN
        ARRAY_REMOVE_AT(ps, 0) : ARRAY_REMOVE_AT(zs, 0) : ARRAY_REMOVE_AT(ss, 0)
    END IF
END SUB

' zurueck = TRUE: zur vorigen Stelle, sonst wieder vorwaerts. Die Stelle, an
' der man steht, kommt dabei auf den anderen Stapel.
SUB navGehen(zurueck AS BOOLEAN)
    IF zurueck AND LEN(navPfade) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Keine vorige Stelle."))
        RETURN
    END IF
    IF NOT zurueck AND LEN(vorPfade) = 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Keine Stelle zum Vorwärtsgehen."))
        RETURN
    END IF
    DIM p AS STRING
    DIM z AS INTEGER
    DIM sp AS INTEGER
    DIM n AS INTEGER
    IF zurueck THEN
        n = LEN(navPfade) - 1
        p = navPfade[n] : z = navZeilen[n] : sp = navSpalten[n]
        ARRAY_REMOVE_AT(navPfade, n) : ARRAY_REMOVE_AT(navZeilen, n) : ARRAY_REMOVE_AT(navSpalten, n)
        IF navLetztPfad <> "" THEN navAblegen(vorPfade, vorZeilen, vorSpalten, navLetztPfad, navLetztZeile, navLetztSpalte)
    ELSE
        n = LEN(vorPfade) - 1
        p = vorPfade[n] : z = vorZeilen[n] : sp = vorSpalten[n]
        ARRAY_REMOVE_AT(vorPfade, n) : ARRAY_REMOVE_AT(vorZeilen, n) : ARRAY_REMOVE_AT(vorSpalten, n)
        IF navLetztPfad <> "" THEN navAblegen(navPfade, navZeilen, navSpalten, navLetztPfad, navLetztZeile, navLetztSpalte)
    END IF
    IF NOT FILEEXISTS(p) THEN
        GUI_SET_TEXT(lblStatus, tr$("Gibt es nicht mehr: ") + p)
        RETURN
    END IF
    navSperre = TRUE
    DIM schonDa AS BOOLEAN : schonDa = FALSE
    IF aktiverTab >= 0 THEN schonDa = wegGleich$(tabPfade[aktiverTab]) = wegGleich$(p)
    IF NOT schonDa THEN dateiOeffnen(p)
    IF aktiverTab >= 0 THEN GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], z, sp)
    protokoll(IIF(zurueck, "nav zurueck ", "nav vor ") + BASENAME(p) + " " + STR$(z))
END SUB

' --- Projektbaum: anlegen, umbenennen, loeschen -------------------------
DIM dlgBaum AS GUI_WINDOW : dlgBaum = -1
DIM dlgBaumLoeschen AS GUI_WINDOW : dlgBaumLoeschen = -1
DIM baumAktion AS STRING : baumAktion = ""
DIM baumZiel AS STRING : baumZiel = ""

' Der Weg, auf den sich ein Befehl aus dem Baum bezieht: die gewaehlte Zeile
' (der Rechtsklick hat sie gewaehlt), sonst die Datei im vorderen Reiter.
FUNCTION baumWahl$() AS STRING
    DIM w AS STRING : w = GUI_FILETREE_SELECTED$(baum)
    IF w <> "" THEN RETURN w
    IF aktiverTab >= 0 THEN RETURN tabPfade[aktiverTab]
    RETURN ""
END FUNCTION

' In welchen Ordner kommt etwas Neues: ein gewaehlter Ordner, sonst der
' Ordner der gewaehlten Datei, sonst das Projekt.
FUNCTION baumOrdner$() AS STRING
    DIM w AS STRING : w = baumWahl$()
    IF w = "" THEN RETURN projektOrdner
    IF DIREXISTS(w) THEN RETURN w
    RETURN DIRNAME(w)
END FUNCTION

SUB baumFragen(art AS STRING)
    IF dlgBaum >= 0 THEN RETURN
    baumAktion = art
    IF art = "datei" THEN
        baumZiel = baumOrdner$()
        IF baumZiel = "" THEN GUI_SET_TEXT(lblStatus, tr$("Kein Projektordner.")) : RETURN
        dlgBaum = GUI_PROMPT(tr$("Neue Datei"), tr$("Name der neuen Datei in ") + BASENAME(baumZiel) + ":", "neu.dh")
    ELSEIF art = "ordner" THEN
        baumZiel = baumOrdner$()
        IF baumZiel = "" THEN GUI_SET_TEXT(lblStatus, tr$("Kein Projektordner.")) : RETURN
        dlgBaum = GUI_PROMPT(tr$("Neuer Ordner"), tr$("Name des neuen Ordners in ") + BASENAME(baumZiel) + ":", "neu")
    ELSE
        baumZiel = baumWahl$()
        IF baumZiel = "" OR NOT (FILEEXISTS(baumZiel) OR DIREXISTS(baumZiel)) THEN
            GUI_SET_TEXT(lblStatus, tr$("Erst im Projektbaum eine Datei oder einen Ordner wählen."))
            RETURN
        END IF
        dlgBaum = GUI_PROMPT(tr$("Umbenennen"), tr$("Neuer Name für ") + BASENAME(baumZiel) + ":", BASENAME(baumZiel))
    END IF
END SUB

' Ein Name, kein Weg: nichts, was aus dem Ordner herausfuehrt.
FUNCTION baumNameOk(name AS STRING) AS BOOLEAN
    IF name = "" OR name = "." OR name = ".." THEN RETURN FALSE
    DIM c AS STRING
    FOR EACH c IN ["/", "\", ":", "*", "?", CHR$(34), "<", ">", "|"]
        IF INSTR(name, c) >= 0 THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

SUB baumDialogNachziehen()
    IF dlgBaum >= 0 THEN
        DIM a AS INTEGER : a = GUI_ANSWER(dlgBaum)
        IF a <> 0 THEN
            DIM name AS STRING : name = TRIM$(GUI_DIALOG_TEXT(dlgBaum))
            dlgBaum = -1
            IF a = 1 THEN baumAusfuehren(name)
        END IF
    END IF
    IF dlgBaumLoeschen >= 0 THEN
        DIM al AS INTEGER : al = GUI_ANSWER(dlgBaumLoeschen)
        IF al <> 0 THEN
            dlgBaumLoeschen = -1
            IF al = 1 THEN baumLoeschen(baumZiel)
        END IF
    END IF
END SUB

SUB baumAusfuehren(name AS STRING)
    IF NOT baumNameOk(name) THEN
        GUI_SET_TEXT(lblStatus, tr$("Kein gültiger Name: ") + name)
        RETURN
    END IF
    IF baumAktion = "datei" THEN
        DIM pd AS STRING : pd = PATHJOIN(baumZiel, name)
        IF FILEEXISTS(pd) OR DIREXISTS(pd) THEN GUI_SET_TEXT(lblStatus, tr$("Gibt es schon: ") + name) : RETURN
        WRITEALL(pd, "")
        baumFuellen()
        GUI_FILETREE_EXPAND(baum, baumZiel, TRUE)
        protokoll("baum neue datei " + name)
        dateiOeffnen(pd)
    ELSEIF baumAktion = "ordner" THEN
        DIM po AS STRING : po = PATHJOIN(baumZiel, name)
        IF FILEEXISTS(po) OR DIREXISTS(po) THEN GUI_SET_TEXT(lblStatus, tr$("Gibt es schon: ") + name) : RETURN
        MKDIR(po)
        baumFuellen()
        GUI_FILETREE_EXPAND(baum, baumZiel, TRUE)
        GUI_SET_TEXT(lblStatus, tr$("Ordner angelegt: ") + name)
        protokoll("baum neuer ordner " + name)
    ELSE
        baumUmbenennen(baumZiel, name)
    END IF
END SUB

' Umbenennen (nicht verschieben: der Ordner bleibt). Offene Reiter,
' Haltepunkte, Lesezeichen und Startargumente zeigen danach auf den neuen
' Namen, und jedes IMPORT im Projekt, das die Datei meint, zieht mit --
' sonst uebersetzte das Programm nach dem Umbenennen nicht mehr.
SUB baumUmbenennen(alt AS STRING, name AS STRING)
    DIM neu AS STRING : neu = PATHJOIN(DIRNAME(alt), name)
    IF name = BASENAME(alt) THEN RETURN
    IF (FILEEXISTS(neu) OR DIREXISTS(neu)) AND LOWER$(name) <> LOWER$(BASENAME(alt)) THEN
        GUI_SET_TEXT(lblStatus, tr$("Gibt es schon: ") + name)
        RETURN
    END IF
    DIM istOrdner AS BOOLEAN : istOrdner = DIREXISTS(alt)
    ' Die IMPORTs VOR dem Umbenennen suchen -- danach laesst sich nicht mehr
    ' pruefen, ob ein Weg dieselbe Datei meint (SAMEFILE fragt die Platte).
    DIM impDateien AS ARRAY OF STRING : impDateien = []
    DIM impTexte AS ARRAY OF STRING : impTexte = []
    IF NOT istOrdner AND LOWER$(RIGHT$(alt, 3)) = ".dh" THEN importsSuchen(alt, name, impDateien, impTexte)
    TRY
        RENAME(alt, neu)
    CATCH e
        GUI_SET_TEXT(lblStatus, tr$("Umbenennen ging nicht: ") + e)
        RETURN
    END TRY
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        tabPfade[i] = wegUmziehen$(tabPfade[i], alt, neu, istOrdner)
    NEXT
    FOR i = 0 TO LEN(hpDateien) - 1
        hpDateien[i] = wegUmziehen$(hpDateien[i], alt, neu, istOrdner)
    NEXT
    FOR i = 0 TO LEN(lzDateien) - 1
        lzDateien[i] = wegUmziehen$(lzDateien[i], alt, neu, istOrdner)
    NEXT
    FOR i = 0 TO LEN(startDateien) - 1
        startDateien[i] = wegUmziehen$(startDateien[i], alt, neu, istOrdner)
    NEXT
    ' Die gefundenen IMPORTs schreiben: in einen offenen Reiter als eigener
    ' Rueckgaengig-Schritt (und gesichert, wenn er es vorher war), sonst auf
    ' die Platte.
    FOR i = 0 TO LEN(impDateien) - 1
        DIM d AS STRING : d = wegUmziehen$(impDateien[i], alt, neu, FALSE)
        DIM t AS INTEGER : t = tabVonWeg(d)
        IF t >= 0 THEN
            DIM warSauber AS BOOLEAN : warSauber = GUI_TEXT(tabFelder[t]) = tabGesichert[t]
            feldAustauschen(tabFelder[t], GUI_TEXT(tabFelder[t]), impTexte[i])
            IF warSauber THEN
                WRITEALL(d, impTexte[i] + IIF(RIGHT$(impTexte[i], 1) = NL, "", NL))
                tabGesichert[t] = impTexte[i]
            END IF
        ELSE
            WRITEALL(d, impTexte[i] + IIF(RIGHT$(impTexte[i], 1) = NL, "", NL))
        END IF
    NEXT
    reiterNeuSetzen()
    baumLetzteWahl = neu
    baumFuellen()
    GUI_FILETREE_SELECT(baum, neu)
    konfigSichern()
    GUI_SET_TEXT(lblStatus, tr$("Umbenannt: ") + BASENAME(alt) + " -> " + name + _
                 IIF(LEN(impDateien) > 0, " (" + STR$(LEN(impDateien)) + tr$(" Datei(en) mit IMPORT angepasst)"), ""))
    protokoll("baum umbenannt " + BASENAME(alt) + " " + name + " imports " + STR$(LEN(impDateien)))
END SUB

' Liegt `weg` bei `alt` (bzw. darin, wenn alt ein Ordner ist), dieselbe
' Stelle unter `neu`.
FUNCTION wegUmziehen$(weg AS STRING, alt AS STRING, neu AS STRING, ordner AS BOOLEAN) AS STRING
    IF weg = "" THEN RETURN weg
    IF wegGleich$(weg) = wegGleich$(alt) THEN RETURN neu
    IF ordner THEN
        DIM a AS STRING : a = wegGleich$(alt)
        DIM w AS STRING : w = wegGleich$(weg)
        IF LEFT$(w, LEN(a) + 1) = a + "/" THEN RETURN PATHJOIN(neu, MID$(REPLACE$(weg, "\", "/"), LEN(a) + 1))
    END IF
    RETURN weg
END FUNCTION

FUNCTION tabVonWeg(weg AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF tabPfade[i] <> "" AND wegGleich$(tabPfade[i]) = wegGleich$(weg) THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Alle .dh des Projekts, deren IMPORT "..." die Datei `alt` meint; je Datei
' der Text mit dem neuen Namen. Der Text eines offenen Reiters zaehlt, nicht
' der auf der Platte.
SUB importsSuchen(alt AS STRING, name AS STRING, dateien AS ARRAY OF STRING, texte AS ARRAY OF STRING)
    DIM altName AS STRING : altName = BASENAME(alt)
    DIM d AS STRING
    FOR EACH d IN projektDateien("*.dh")
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM t AS INTEGER : t = tabVonWeg(pfad)
        DIM text AS STRING
        IF t >= 0 THEN
            text = GUI_TEXT(tabFelder[t])
        ELSE
            TRY
                text = JOIN$(READLINES(pfad), NL)
            CATCH e
                CONTINUE
            END TRY
        END IF
        DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(text, NL)
        DIM geaendert AS BOOLEAN : geaendert = FALSE
        DIM k AS INTEGER
        FOR k = 0 TO LEN(zeilen) - 1
            DIM zt AS STRING : zt = TRIM$(zeilen[k])
            IF UPPER$(LEFT$(zt, 8)) <> "IMPORT " + CHR$(34) THEN CONTINUE
            DIM rest AS STRING : rest = MID$(zt, 8)
            DIM ende AS INTEGER : ende = INSTR(rest, CHR$(34))
            IF ende <= 0 THEN CONTINUE
            DIM x AS STRING : x = LEFT$(rest, ende)
            IF LOWER$(RIGHT$(x, LEN(altName))) <> LOWER$(altName) THEN CONTINUE
            DIM gemeint AS STRING : gemeint = PATHJOIN(DIRNAME(pfad), x)
            IF NOT FILEEXISTS(gemeint) THEN CONTINUE
            IF NOT SAMEFILE(gemeint, alt) THEN CONTINUE
            DIM neuX AS STRING : neuX = LEFT$(x, LEN(x) - LEN(altName)) + name
            zeilen[k] = REPLACE$(zeilen[k], CHR$(34) + x + CHR$(34), CHR$(34) + neuX + CHR$(34))
            geaendert = TRUE
        NEXT
        IF geaendert THEN
            ARRAY_PUSH(dateien, pfad)
            ARRAY_PUSH(texte, JOIN$(zeilen, NL))
        END IF
    NEXT
END SUB

SUB baumLoeschenFragen()
    IF dlgBaumLoeschen >= 0 THEN RETURN
    baumZiel = baumWahl$()
    IF baumZiel = "" OR NOT (FILEEXISTS(baumZiel) OR DIREXISTS(baumZiel)) THEN
        GUI_SET_TEXT(lblStatus, tr$("Erst im Projektbaum eine Datei oder einen Ordner wählen."))
        RETURN
    END IF
    IF wegGleich$(baumZiel) = wegGleich$(projektOrdner) THEN
        GUI_SET_TEXT(lblStatus, tr$("Den Projektordner selbst löscht die IDE nicht."))
        RETURN
    END IF
    DIM text AS STRING
    IF DIREXISTS(baumZiel) THEN
        DIM n AS INTEGER : n = LEN(DIRLIST_REC(baumZiel))
        text = tr$("Ordner endgültig löschen: ") + BASENAME(baumZiel) + tr$(" -- mit allem darin (") + STR$(n) + tr$(" Einträge). Das lässt sich nicht rückgängig machen.")
    ELSE
        text = tr$("Datei endgültig löschen: ") + BASENAME(baumZiel) + tr$(". Das lässt sich nicht rückgängig machen.")
    END IF
    dlgBaumLoeschen = GUI_DIALOG(tr$("Löschen"), text, tr$("Löschen|Abbrechen"))
END SUB

SUB baumLoeschen(ziel AS STRING)
    DIM istOrdner AS BOOLEAN : istOrdner = DIREXISTS(ziel)
    TRY
        IF istOrdner THEN
            RMDIR(ziel, TRUE)
        ELSE
            DELETEFILE(ziel)
        END IF
    CATCH e
        GUI_SET_TEXT(lblStatus, tr$("Löschen ging nicht: ") + e)
        RETURN
    END TRY
    ' Reiter der geloeschten Datei(en) zu -- von hinten, damit die Nummern
    ' der uebrigen gelten.
    DIM i AS INTEGER
    FOR i = tabAnzahl - 1 TO 0 STEP -1
        IF tabPfade[i] <> "" THEN
            IF wegUmziehen$(tabPfade[i], ziel, "", istOrdner) <> tabPfade[i] THEN tabSchliessen(i)
        END IF
    NEXT
    baumLetzteWahl = ""
    baumFuellen()
    GUI_SET_TEXT(lblStatus, tr$("Gelöscht: ") + BASENAME(ziel))
    protokoll("baum geloescht " + BASENAME(ziel))
END SUB

SUB baumPfadKopieren()
    DIM w AS STRING : w = baumWahl$()
    IF w = "" THEN RETURN
    TRY
        CLIPBOARD_SET(w)
        GUI_SET_TEXT(lblStatus, tr$("Pfad kopiert: ") + w)
    CATCH e
        GUI_SET_TEXT(lblStatus, tr$("Zwischenablage nicht erreichbar."))
    END TRY
END SUB

' --- Ausgabe: filtern, kopieren, sichern ---------------------------------
SUB ausgabeFilterNachziehen()
    DIM f AS STRING : f = GUI_TEXT(tfAusgabeFilter)
    IF f = ausgabeFilterAlt THEN RETURN
    ausgabeFilterAlt = f
    GUI_LISTBOX_FILTER(lstAusgabe, f)
    DIM n AS INTEGER : n = GUI_LISTBOX_VIEW_COUNT(lstAusgabe)
    IF f = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Ausgabe: alle Zeilen."))
    ELSE
        GUI_SET_TEXT(lblStatus, tr$("Ausgabe gefiltert: ") + STR$(n) + tr$(" von ") + STR$(GUI_LISTBOX_COUNT(lstAusgabe)) + tr$(" Zeilen."))
    END IF
    protokoll("ausgabe filter [" + f + "] " + STR$(n))
END SUB

' Die angezeigten Zeilen (mit Filter nur die passenden), als ein Text.
FUNCTION ausgabeText$() AS STRING
    DIM z AS ARRAY OF STRING : z = []
    DIM i AS INTEGER
    FOR i = 0 TO GUI_LISTBOX_VIEW_COUNT(lstAusgabe) - 1
        ARRAY_PUSH(z, GUI_LISTBOX_ITEM(lstAusgabe, GUI_LISTBOX_VIEW_ROW(lstAusgabe, i)))
    NEXT
    RETURN JOIN$(z, NL)
END FUNCTION

SUB ausgabeKopieren(nurZeile AS BOOLEAN)
    DIM t AS STRING
    IF nurZeile THEN
        DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstAusgabe)
        IF sel < 0 THEN RETURN
        t = GUI_LISTBOX_ITEM(lstAusgabe, sel)
    ELSE
        t = ausgabeText$()
    END IF
    TRY
        CLIPBOARD_SET(t)
        GUI_SET_TEXT(lblStatus, IIF(nurZeile, tr$("Zeile kopiert."), tr$("Ausgabe kopiert.")))
    CATCH e
        GUI_SET_TEXT(lblStatus, tr$("Zwischenablage nicht erreichbar."))
    END TRY
END SUB

SUB ausgabeSichernNach(pfad AS STRING)
    DIM t AS STRING : t = ausgabeText$()
    WRITEALL(pfad, t + IIF(t = "", "", NL))
    DIM n AS INTEGER : n = GUI_LISTBOX_VIEW_COUNT(lstAusgabe)
    GUI_SET_TEXT(lblStatus, tr$("Ausgabe gesichert: ") + STR$(n) + tr$(" Zeilen in ") + pfad)
    protokoll("ausgabe gesichert " + STR$(n))
END SUB

' Gemerkte Argumente (umgebung = FALSE) bzw. Umgebung einer Datei, "" = keine.
FUNCTION startWert$(datei AS STRING, umgebung AS BOOLEAN) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(startDateien) - 1
        IF wegGleich$(startDateien[i]) = wegGleich$(datei) THEN
            RETURN IIF(umgebung, startUmg[i], startArgs[i])
        END IF
    NEXT
    RETURN ""
END FUNCTION

SUB startWertSetzen(datei AS STRING, umgebung AS BOOLEAN, wert AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(startDateien) - 1
        IF wegGleich$(startDateien[i]) = wegGleich$(datei) THEN
            IF umgebung THEN
                startUmg[i] = wert
            ELSE
                startArgs[i] = wert
            END IF
            RETURN
        END IF
    NEXT
    IF wert = "" THEN RETURN
    ARRAY_PUSH(startDateien, datei)
    ARRAY_PUSH(startArgs, IIF(umgebung, "", wert))
    ARRAY_PUSH(startUmg, IIF(umgebung, wert, ""))
END SUB

' Eine Zeile in Woerter: getrennt an Leerraum, "in Anfuehrungszeichen" bleibt
' zusammen (ohne die Zeichen selbst) -- wie in einer Shell, ohne deren Rest.
FUNCTION startWoerter(zeile AS STRING) AS ARRAY OF STRING
    DIM w AS ARRAY OF STRING : w = []
    DIM akt AS STRING : akt = ""
    DIM hat AS BOOLEAN : hat = FALSE
    DIM inQ AS BOOLEAN : inQ = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeile) - 1
        DIM c AS STRING : c = MID$(zeile, i, 1)
        IF c = CHR$(34) THEN
            inQ = NOT inQ : hat = TRUE
        ELSEIF (c = " " OR c = CHR$(9)) AND NOT inQ THEN
            IF hat THEN ARRAY_PUSH(w, akt)
            akt = "" : hat = FALSE
        ELSE
            akt = akt + c : hat = TRUE
        END IF
    NEXT
    IF hat THEN ARRAY_PUSH(w, akt)
    RETURN w
END FUNCTION

' "NAME=wert NAME2="mit leer"" -> MAP. Ein Wort ohne = wird uebergangen.
FUNCTION startUmgebung(zeile AS STRING) AS MAP OF STRING
    DIM m AS MAP OF STRING : m = {}
    DIM w AS STRING
    FOR EACH w IN startWoerter(zeile)
        DIM g AS INTEGER : g = INSTR(w, "=")
        IF g > 0 THEN MAPPUT(m, LEFT$(w, g), MID$(w, g + 1))
    NEXT
    RETURN m
END FUNCTION

' Ausfuehren -> Startargumente / Umgebung fuer den Start: fuer die Datei im
' vorderen Reiter, gemerkt in der ide.json. Leer = keine.
DIM startFrageDlg AS GUI_WINDOW : startFrageDlg = -1
DIM startFrageUmg AS BOOLEAN : startFrageUmg = FALSE
DIM startFrageDatei AS STRING : startFrageDatei = ""
SUB startEinstellungFragen(umgebung AS BOOLEAN)
    IF aktiverTab < 0 THEN RETURN
    IF tabPfade[aktiverTab] = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Erst sichern -- die Einstellung gehört zu einer Datei."))
        RETURN
    END IF
    startFrageDatei = tabPfade[aktiverTab]
    startFrageUmg = umgebung
    IF umgebung THEN
        startFrageDlg = GUI_PROMPT(tr$("Umgebung für den Start"), _
            tr$("Umgebungsvariablen für ") + BASENAME(startFrageDatei) + tr$(", etwa: STUFE=3 NAME=wert"), _
            startWert$(startFrageDatei, TRUE))
    ELSE
        startFrageDlg = GUI_PROMPT(tr$("Startargumente"), _
            tr$("Argumente für ") + BASENAME(startFrageDatei) + tr$(" (ARG$), getrennt durch Leerzeichen:"), _
            startWert$(startFrageDatei, FALSE))
    END IF
END SUB

SUB startFrageNachziehen()
    IF startFrageDlg < 0 THEN RETURN
    DIM a AS INTEGER : a = GUI_ANSWER(startFrageDlg)
    IF a = 0 THEN RETURN
    IF a = 1 THEN
        DIM wert AS STRING : wert = TRIM$(GUI_DIALOG_TEXT(startFrageDlg))
        startWertSetzen(startFrageDatei, startFrageUmg, wert)
        konfigSichern()
        IF startFrageUmg THEN
            protokoll("start umgebung " + STR$(LEN(MAPKEYS(startUmgebung(wert)))))
            GUI_SET_TEXT(lblStatus, tr$("Umgebung für ") + BASENAME(startFrageDatei) + ": " + IIF(wert = "", tr$("keine"), wert))
        ELSE
            protokoll("start argumente " + STR$(LEN(startWoerter(wert))))
            GUI_SET_TEXT(lblStatus, tr$("Startargumente für ") + BASENAME(startFrageDatei) + ": " + IIF(wert = "", tr$("keine"), wert))
        END IF
    END IF
    startFrageDlg = -1
END SUB

SUB neustartSichernSetzen(an AS BOOLEAN)
    neustartSichernAn = an
    GUI_MENU_CHECK(miNeustartSichern, an)
    GUI_SET_TEXT(lblStatus, IIF(an, tr$("Beim Sichern neu starten: an."), tr$("Beim Sichern neu starten: aus.")))
    protokoll("neustart beim sichern " + IIF(an, "an", "aus"))
    konfigSichern()
END SUB

SUB stoppen()
    IF prozess < 0 THEN RETURN
    fertigNachStopp = TRUE
    ' Ein stehender Debugger bekommt "stop" und beendet sich selbst -- er
    ' meldet dabei noch sein `finished`. Bis 2026-09-27 wurde er im selben
    ' Augenblick abgeschossen, und ob das `finished` noch herauskam, war
    ' Glueckssache (der Neustart-Test wackelte daran). Laeuft er nach einer
    ' Sekunde noch, wird er doch beendet (prozessNachsehen).
    IF prozessArt = "debug" AND debugPause THEN
        debugSenden("stop")
        stoppFrist = GET_TIME() + 1.0
        RETURN
    END IF
    PROCESS_KILL(prozess)
END SUB

' --- Debugger: Client von `dhrt debug` (JSON-Zeilen: stdin Kommandos,
' stdout Ereignisse). Kommandos nimmt das Kind nur an, solange es steht.
SUB debuggen()
    IF NOT prozessStarten("debug") THEN RETURN
    debugPause = FALSE : debugErst = TRUE : debugZeile = 0
    debugDatei = prozessDatei : debugErstWarten = FALSE : debugEingabe = FALSE
    GUI_SET_TEXT(lblDebug, tr$("Debugger: läuft ..."))
    GUI_TABLE_CLEAR(tblVars)
    debugPanelZeigen(TRUE)
    protokoll("debug gestartet")
END SUB

SUB debugSenden(cmd AS STRING)
    IF prozess < 0 OR prozessArt <> "debug" THEN RETURN
    PROCESS_WRITE(prozess, "{" + CHR$(34) + "cmd" + CHR$(34) + ":" + CHR$(34) + cmd + CHR$(34) + "}" + NL)
END SUB

' Ein Text als JSON-Zeichenkette (mit Anfuehrungszeichen).
FUNCTION jsonText$(s AS STRING) AS STRING
    DIM j AS STRING : j = REPLACE$(s, "\", "\\")
    j = REPLACE$(j, CHR$(34), "\" + CHR$(34))
    RETURN CHR$(34) + j + CHR$(34)
END FUNCTION

' Alle Haltepunkte, JEDER Datei -- eine importierte Datei gehoert zum
' Programm, und das Kind ordnet sie selbst zu. `now` laesst sie auch
' waehrend des Laufens gelten, nicht erst beim naechsten Halt.
SUB debugHaltepunkteSenden()
    IF prozess < 0 OR prozessArt <> "debug" THEN RETURN
    DIM teile AS ARRAY OF STRING : teile = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF NOT hpIstAktiv(i) THEN CONTINUE
        DIM e AS STRING : e = "{" + jsonText$("file") + ":" + jsonText$(hpDateien[i]) + "," + jsonText$("line") + ":" + STR$(hpZeilen[i])
        IF hpBedingungen[i] <> "" THEN e = e + "," + jsonText$("condition") + ":" + jsonText$(hpBedingungen[i])
        IF hpTreffer$(i) <> "" THEN e = e + "," + jsonText$("hits") + ":" + jsonText$(hpTreffer$(i))
        IF hpLog$(i) <> "" THEN e = e + "," + jsonText$("log") + ":" + jsonText$(hpLog$(i))
        ARRAY_PUSH(teile, e + "}")
    NEXT
    PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("set-breakpoints") + "," + jsonText$("now") + ":true," + jsonText$("breakpoints") + ":[" + JOIN$(teile, ",") + "]}" + NL)
END SUB

' F6: ein laufendes Programm an der naechsten Zeile anhalten.
SUB debugAnhalten()
    IF prozessArt <> "debug" OR prozess < 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Anhalten geht nur im Debugger -- F7 startet ihn."))
        RETURN
    END IF
    IF debugPause THEN RETURN
    debugSenden("pause")
    protokoll("anhalten")
END SUB

' Die Antwort auf die Haltepunkte: wo sie wirklich halten. Rutscht einer
' (Zeile ohne Code), wandert der rote Punkt mit; haelt einer nie, sagt es
' die Statuszeile, statt dass man vergeblich auf ihn wartet.
SUB haltepunkteBestaetigt(j AS JSON_HANDLE)
    DIM nie AS ARRAY OF STRING : nie = []
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(j, "breakpoints") - 1
        DIM p AS STRING : p = "breakpoints." + STR$(k)
        DIM datei AS STRING : datei = JSON_GET_STRING(j, p + ".file")
        DIM z AS INTEGER : z = JSON_GET_INT(j, p + ".line")
        IF NOT JSON_GET_BOOL(j, p + ".verified") THEN
            ARRAY_PUSH(nie, BASENAME(datei) + ":" + STR$(z))
            CONTINUE
        END IF
        DIM echt AS INTEGER : echt = JSON_GET_INT(j, p + ".actual")
        IF echt = z THEN CONTINUE
        DIM i AS INTEGER
        FOR i = 0 TO LEN(hpZeilen) - 1
            IF hpZeilen[i] = z AND SAMEFILE(hpDateien[i], datei) THEN
                IF haltepunktIndex(hpDateien[i], echt) >= 0 THEN
                    ' Dort steht schon einer: dieser faellt weg.
                    hpEntfernen(i)
                ELSE
                    hpZeilen[i] = echt
                END IF
                protokoll("haltepunkt verschoben " + STR$(z) + " " + STR$(echt))
                markenSchluessel = ""
                EXIT FOR
            END IF
        NEXT
    NEXT
    IF LEN(nie) > 0 THEN GUI_SET_TEXT(lblStatus, tr$("Haltepunkt hält nie (dort und darunter steht kein Code): ") + JOIN$(nie, ", "))
    IF debugErstWarten THEN
        debugErstWarten = FALSE
        ' Steht schon ein Haltepunkt HIER, bleibt es stehen; gibt es gar
        ' keinen, der haelt, auch -- sonst liefe es durch und man saehe nichts.
        DIM hier AS BOOLEAN : hier = FALSE
        DIM gueltig AS INTEGER : gueltig = 0
        FOR k = 0 TO JSON_LEN(j, "breakpoints") - 1
            DIM q AS STRING : q = "breakpoints." + STR$(k)
            IF JSON_GET_BOOL(j, q + ".verified") THEN
                gueltig = gueltig + 1
                IF JSON_GET_INT(j, q + ".actual") = debugZeile AND SAMEFILE(JSON_GET_STRING(j, q + ".file"), debugDatei) THEN hier = TRUE
            END IF
        NEXT
        IF gueltig > 0 AND NOT hier THEN
            debugErstHalt = ""
            debugSenden("continue")
            RETURN
        END IF
        IF debugErstHalt <> "" THEN
            DIM h AS JSON_HANDLE : h = JSON_PARSE(debugErstHalt)
            debugErstHalt = ""
            debugHaltZeigen(h)
        END IF
    END IF
END SUB

' Ein Schritt-Kommando: nur, wenn das Kind steht.
SUB debugSchritt(cmd AS STRING)
    IF prozessArt <> "debug" OR NOT debugPause THEN
        GUI_SET_TEXT(lblStatus, tr$("Der Debugger steht gerade nicht -- F7 startet ihn, F9 setzt einen Haltepunkt."))
        RETURN
    END IF
    debugSenden(cmd)
    debugPause = FALSE
    debugWerteLoeschen()
    GUI_SET_TEXT(lblDebug, tr$("Debugger: läuft ..."))
END SUB

SUB variablenZeigen(j AS JSON_HANDLE)
    ' Welche Eintraege offen sind, gilt ueber den Halt hinaus -- gemerkt
    ' an ihrem Weg (`held`, `held.waffe`, `f[3]`), nicht an der Zeilennummer.
    DIM r AS INTEGER
    IF LEN(varPfade) > 0 THEN
        varOffen = []
        FOR r = 0 TO MIN(LEN(varPfade), GUI_TABLE_ROW_COUNT(tblVars)) - 1
            IF GUI_TREETABLE_EXPANDED(tblVars, r) THEN ARRAY_PUSH(varOffen, varPfade[r])
        NEXT
    END IF
    GUI_TABLE_CLEAR(tblVars)
    varPfade = []
    DIM bereich AS STRING
    FOR EACH bereich IN ("locals", "globals")
        IF NOT JSON_HAS(j, bereich) THEN CONTINUE
        DIM wo AS STRING : wo = "lokal"
        IF bereich = "globals" THEN wo = "global"
        variablenEbene(j, bereich, -1, "", wo)
    NEXT
    FOR r = 0 TO LEN(varPfade) - 1
        IF ARRAY_INDEXOF(varOffen, varPfade[r]) >= 0 THEN GUI_TREETABLE_EXPAND(tblVars, r, TRUE)
    NEXT
END SUB

' Eine Ebene der Variablenliste samt ihren Kindern.
SUB variablenEbene(j AS JSON_HANDLE, pfad AS STRING, eltern AS INTEGER, vor AS STRING, wo AS STRING)
    DIM n AS INTEGER : n = JSON_LEN(j, pfad)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = pfad + "." + STR$(i)
        DIM name AS STRING : name = JSON_GET_STRING(j, p + ".name")
        DIM zeile AS INTEGER : zeile = GUI_TREETABLE_ADD(tblVars, eltern, [name, JSON_GET_STRING(j, p + ".type"), JSON_GET_STRING(j, p + ".value"), IIF(eltern < 0, wo, "")])
        ' Der Weg wie ein Ausdruck: Feld mit Punkt, Index/Schluessel ohne.
        DIM weg AS STRING : weg = name
        IF vor <> "" THEN weg = IIF(LEFT$(name, 1) = "[" OR LEFT$(name, 1) = CHR$(34), vor + name, vor + "." + name)
        WHILE LEN(varPfade) < zeile : ARRAY_PUSH(varPfade, "") : WEND
        IF zeile < LEN(varPfade) THEN varPfade[zeile] = weg ELSE ARRAY_PUSH(varPfade, weg)
        IF JSON_HAS(j, p + ".children") THEN variablenEbene(j, p + ".children", zeile, weg, wo)
    NEXT
END SUB

SUB debugEreignis(zeile AS STRING)
    IF LEFT$(zeile, 1) <> "{" THEN ausgabe(zeile) : RETURN
    DIM j AS JSON_HANDLE : j = JSON_PARSE(zeile)
    DIM ev AS STRING : ev = JSON_GET_STRING(j, "event")
    SELECT CASE ev
        CASE "output"
            ausgabeVerteilen(JSON_GET_STRING(j, "text"))
        CASE "paused"
            debugZeile = JSON_GET_INT(j, "line")
            debugDatei = prozessDatei
            IF JSON_HAS(j, "file") THEN
                IF JSON_GET_STRING(j, "file") <> "" THEN debugDatei = JSON_GET_STRING(j, "file")
            END IF
            debugEingabe = FALSE
            IF debugErst THEN
                ' Der erste Halt ist die erste Zeile: jetzt kennt das Kind
                ' seine Haltepunkte. Ob es bis dorthin weiterlaeuft, sagt
                ' seine Antwort (haltepunkteBestaetigt) -- bis dahin wartet
                ' dieser Halt.
                debugErst = FALSE
                debugHaltepunkteSenden()
                debugWatchesSenden()
                IF debugBis > 0 THEN
                    debugRunTo(debugBis)
                    debugBis = 0
                    RETURN
                END IF
                IF LEN(hpZeilen) > 0 THEN
                    debugErstWarten = TRUE
                    debugErstHalt = zeile
                    RETURN
                END IF
            END IF
            debugHaltZeigen(j)
        CASE "breakpoints"
            haltepunkteBestaetigt(j)
        CASE "log"
            ' Ein Protokollpunkt: eine Zeile in die Ausgabe, angehalten wird nicht.
            ausgabe("» " + BASENAME(JSON_GET_STRING(j, "file")) + ":" + STR$(JSON_GET_INT(j, "line")) + "  " + JSON_GET_STRING(j, "text"))
            protokoll("log " + JSON_GET_STRING(j, "text"))
        CASE "run-to-error"
            ' Es steht noch -- "bis zur Marke" hat nichts gefunden.
            debugPause = TRUE
            GUI_SET_TEXT(lblDebug, tr$("Debugger steht in Zeile ") + STR$(debugZeile))
            GUI_SET_TEXT(lblStatus, tr$("Bis zur Marke: ") + JSON_GET_STRING(j, "message") + ".")
            protokoll("bis zeile fehlt " + STR$(JSON_GET_INT(j, "line")))
        CASE "input"
            debugEingabe = TRUE
            GUI_SET_TEXT(lblDebug, tr$("Debugger: das Programm wartet auf eine Eingabe (Zeile ") + STR$(JSON_GET_INT(j, "line")) + tr$(") -- unten eintippen, Enter"))
            GUI_FOCUS(tfEingabe)
            protokoll("debug eingabe " + STR$(JSON_GET_INT(j, "line")))
        CASE "finished"
            ausgabe("-- Debugger: " + JSON_GET_STRING(j, "reason"))
            protokoll("debug beendet")
        CASE "error"
            debugZeile = JSON_GET_INT(j, "line")
            DIM fdatei AS STRING : fdatei = prozessDatei
            IF JSON_HAS(j, "file") THEN
                IF JSON_GET_STRING(j, "file") <> "" THEN fdatei = JSON_GET_STRING(j, "file")
            END IF
            ausgabe("-- Fehler in " + BASENAME(fdatei) + ":" + STR$(debugZeile) + ": " + JSON_GET_STRING(j, "message"))
            ' Dorthin, wo es passiert ist -- auch in einer importierten Datei.
            IF debugZeile > 0 THEN
                dateiOeffnen(fdatei)
                DIM tf2 AS GUI_WIDGET : tf2 = aktivesFeld()
                IF tf2 >= 0 THEN GUI_TEXTAREA_GOTO(tf2, debugZeile, 1)
            END IF
            protokoll("debug fehler " + STR$(debugZeile))
        CASE "eval-result"
            IF JSON_HAS(j, "id") THEN
                IF JSON_GET_STRING(j, "id") = "hover" THEN
                    wertTooltip(JSON_GET_STRING(j, "expr"), JSON_GET_STRING(j, "value"), JSON_GET_STRING(j, "type"))
                    RETURN
                END IF
            END IF
            ausgabe("= " + JSON_GET_STRING(j, "value") + "   (" + JSON_GET_STRING(j, "type") + ")")
            protokoll("eval " + JSON_GET_STRING(j, "value"))
        CASE "eval-error"
            ' Ein Wort unter der Maus, das keinen Wert hat (Schluesselwort,
            ' Befehl), ist kein Fehler, den man sehen muesste.
            IF JSON_HAS(j, "id") THEN RETURN
            ausgabe("Fehler: " + JSON_GET_STRING(j, "message"))
        CASE "watches"
            watchesZeigen(j)
        CASE "set-result"
            variablenZeigen(j)
            watchesZeigen(j)
            GUI_SET_TEXT(lblStatus, JSON_GET_STRING(j, "name") + " = " + JSON_GET_STRING(j, "value"))
            protokoll("gesetzt " + JSON_GET_STRING(j, "name") + " " + JSON_GET_STRING(j, "value"))
        CASE "set-error"
            GUI_SET_TEXT(lblStatus, JSON_GET_STRING(j, "message"))
            protokoll("setzen fehler " + JSON_GET_STRING(j, "message"))
    END SELECT
END SUB

' Ein Halt: Variablen, Stapel, Ueberwachen, und die Datei an der Zeile.
SUB debugHaltZeigen(j AS JSON_HANDLE)
    debugPause = TRUE
    variablenZeigen(j)
    stapelZeigen(j)
    watchesZeigen(j)
    DIM wo AS STRING : wo = "Zeile " + STR$(debugZeile)
    IF NOT SAMEFILE(debugDatei, prozessDatei) THEN wo = BASENAME(debugDatei) + ", " + wo
    GUI_SET_TEXT(lblDebug, tr$("Debugger steht in ") + wo + tr$(" (Tiefe ") + STR$(JSON_GET_INT(j, "depth")) + ")")
    ' Ein Halt am FEHLER: Variablen so, wie sie beim Fehler waren; weiter
    ' geht es nicht mehr, F8 beendet.
    IF JSON_HAS(j, "reason") THEN
        IF JSON_GET_STRING(j, "reason") = "error" THEN
            GUI_SET_TEXT(lblDebug, tr$("Fehler in ") + wo + ": " + JSON_GET_STRING(j, "message") + tr$("  -- F8 beendet"))
            protokoll("debug fehlerhalt " + STR$(debugZeile))
        END IF
    END IF
    dateiOeffnen(debugDatei)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 THEN GUI_TEXTAREA_GOTO(ta, debugZeile, 1)
    IF ta >= 0 THEN debugWerteZeigen(ta, j)
    markenSchluessel = ""
    protokoll("debug pause " + STR$(debugZeile))
    IF NOT SAMEFILE(debugDatei, prozessDatei) THEN protokoll("debug datei " + BASENAME(debugDatei))
END SUB

' Werte im Code: hinter jede Zeile vom Kopf des Unterprogramms (oder
' hoechstens 60 Zeilen davor) bis zur Haltezeile, welche Variablen darin
' vorkommen und was sie gerade haben -- lokal vor global, wie das Programm
' sie sieht. Kommentare und Zeichenketten zaehlen nicht; je Zeile hoechstens
' vier, ein langer Wert wird gekuerzt.
SUB debugWerteZeigen(ta AS GUI_WIDGET, j AS JSON_HANDLE)
    debugWerteLoeschen()
    DIM werte AS MAP OF STRING : werte = {}
    DIM bereich AS STRING
    FOR EACH bereich IN ("globals", "locals")
        IF NOT JSON_HAS(j, bereich) THEN CONTINUE
        DIM i AS INTEGER
        FOR i = 0 TO JSON_LEN(j, bereich) - 1
            DIM p AS STRING : p = bereich + "." + STR$(i)
            DIM wert AS STRING : wert = JSON_GET_STRING(j, p + ".value")
            IF LEN(wert) > 30 THEN wert = LEFT$(wert, 29) + "…"
            MAPPUT(werte, LOWER$(JSON_GET_STRING(j, p + ".name")), wert)
        NEXT
    NEXT
    IF MAPSIZE(werte) = 0 THEN RETURN
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM nr AS ARRAY OF INTEGER : nr = []
    DIM txt AS ARRAY OF STRING : txt = []
    DIM z AS INTEGER
    FOR z = MIN(debugZeile, LEN(zeilen)) TO MAX(1, debugZeile - 60) STEP -1
        DIM zeile AS STRING : zeile = zeilen[z - 1]
        DIM teile AS ARRAY OF STRING : teile = []
        DIM gesehen AS ARRAY OF STRING : gesehen = []
        DIM wort AS STRING : wort = ""
        DIM im_text AS BOOLEAN : im_text = FALSE
        DIM k AS INTEGER
        FOR k = 0 TO LEN(zeile)
            DIM c AS STRING : c = ""
            IF k < LEN(zeile) THEN c = MID$(zeile, k, 1)
            IF c = CHR$(34) THEN im_text = NOT im_text
            IF NOT im_text AND c = "'" THEN c = "" : k = LEN(zeile)
            IF NOT im_text AND c <> "" AND wortzeichenAn(zeile, k) THEN
                wort = wort + c
            ELSE
                IF wort <> "" THEN
                    DIM klein AS STRING : klein = LOWER$(wort)
                    IF MAPHAS(werte, klein) AND ARRAY_INDEXOF(gesehen, klein) < 0 AND LEN(teile) < 4 THEN
                        ARRAY_PUSH(gesehen, klein)
                        ARRAY_PUSH(teile, wort + " = " + MAPGET(werte, klein))
                    END IF
                END IF
                wort = ""
            END IF
        NEXT
        IF LEN(teile) > 0 THEN ARRAY_PUSH(nr, z) : ARRAY_PUSH(txt, JOIN$(teile, "   "))
        DIM kopf AS STRING : kopf = UPPER$(LTRIM$(zeile))
        IF LEFT$(kopf, 4) = "SUB " OR LEFT$(kopf, 9) = "FUNCTION " OR LEFT$(kopf, 9) = "PROPERTY " THEN BREAK
    NEXT
    GUI_TEXTAREA_HINTS(ta, nr, txt)
    werteFeld = ta
    protokoll("codewerte " + STR$(LEN(nr)))
    DIM wi AS INTEGER
    FOR wi = 0 TO LEN(nr) - 1
        protokoll("codewert " + STR$(nr[wi]) + ": " + txt[wi])
    NEXT
END SUB

SUB debugWerteLoeschen()
    IF werteFeld < 0 THEN RETURN
    GUI_TEXTAREA_HINTS(werteFeld, [], [])
    DIM war AS GUI_WIDGET : war = werteFeld
    werteFeld = -1
    ' Die Aufrufzaehler standen an derselben Stelle -- sie kommen zurueck.
    zaehlerSetzen_(war)
END SUB

' Der Aufrufstapel: innen oben. Das Hauptprogramm heisst im Kind
' "__main__" -- hier heisst es, wie man es nennt.
SUB stapelZeigen(j AS JSON_HANDLE)
    GUI_TABLE_CLEAR(tblStapel)
    stapelDateien = [] : stapelZeilen = []
    IF NOT JSON_HAS(j, "stack") THEN RETURN
    DIM teile AS ARRAY OF STRING : teile = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "stack") - 1
        DIM p AS STRING : p = "stack." + STR$(i)
        DIM name AS STRING : name = JSON_GET_STRING(j, p + ".name")
        IF name = "" OR LEFT$(name, 2) = "__" THEN name = "Hauptprogramm"
        DIM sdatei AS STRING : sdatei = prozessDatei
        IF JSON_HAS(j, p + ".file") THEN
            IF JSON_GET_STRING(j, p + ".file") <> "" THEN sdatei = JSON_GET_STRING(j, p + ".file")
        END IF
        ARRAY_PUSH(stapelDateien, sdatei)
        ARRAY_PUSH(stapelZeilen, JSON_GET_INT(j, p + ".line"))
        DIM szeile AS STRING : szeile = STR$(JSON_GET_INT(j, p + ".line"))
        IF NOT SAMEFILE(sdatei, prozessDatei) THEN szeile = BASENAME(sdatei) + ":" + szeile
        GUI_TABLE_ADD_ROW(tblStapel, [name, szeile])
        ARRAY_PUSH(teile, name + ":" + STR$(JSON_GET_INT(j, p + ".line")))
    NEXT
    protokoll("stapel " + JOIN$(teile, " "))
END SUB

SUB watchesZeigen(j AS JSON_HANDLE)
    GUI_TABLE_CLEAR(tblWatch)
    IF NOT JSON_HAS(j, "watches") THEN RETURN
    DIM teile AS ARRAY OF STRING : teile = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "watches") - 1
        DIM p AS STRING : p = "watches." + STR$(i)
        DIM wert AS STRING
        IF JSON_HAS(j, p + ".error") THEN
            wert = "? " + JSON_GET_STRING(j, p + ".error")
        ELSE
            wert = JSON_GET_STRING(j, p + ".value")
        END IF
        GUI_TABLE_ADD_ROW(tblWatch, [JSON_GET_STRING(j, p + ".expr"), wert])
        ARRAY_PUSH(teile, JSON_GET_STRING(j, p + ".expr") + "=" + wert)
    NEXT
    protokoll("ueberwachen " + JOIN$(teile, " | "))
END SUB

' Die Liste an das Kind -- es liest nur, solange es steht; was waehrend
' des Laufens kommt, liest es beim naechsten Halt und antwortet dann.
SUB debugWatchesSenden()
    IF prozess < 0 OR prozessArt <> "debug" THEN RETURN
    DIM teile AS ARRAY OF STRING : teile = []
    DIM w AS STRING
    FOR EACH w IN watchListe
        ARRAY_PUSH(teile, jsonText$(w))
    NEXT
    PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("set-watches") + "," + jsonText$("exprs") + ":[" + JOIN$(teile, ",") + "]}" + NL)
END SUB

' Eine Variable im Halt setzen -- der Wert ist ein Ausdruck, das Kind
' rechnet ihn aus und wandelt ihn wie bei einer Zuweisung.
SUB debugSetzen(name AS STRING, wert AS STRING)
    IF prozessArt <> "debug" OR NOT debugPause OR prozess < 0 THEN RETURN
    PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("set") + "," + jsonText$("name") + ":" + jsonText$(name) + "," + jsonText$("value") + ":" + jsonText$(wert) + "}" + NL)
END SUB

SUB debugRunTo(zeile AS INTEGER)
    DIM datei AS STRING : datei = prozessDatei
    IF aktiverTab >= 0 THEN
        IF tabPfade[aktiverTab] <> "" THEN datei = tabPfade[aktiverTab]
    END IF
    PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("run-to") + "," + jsonText$("line") + ":" + STR$(zeile) + "," + jsonText$("file") + ":" + jsonText$(datei) + "}" + NL)
    debugPause = FALSE
    debugWerteLoeschen()
    GUI_SET_TEXT(lblDebug, tr$("Debugger: läuft bis Zeile ") + STR$(zeile) + " ...")
    protokoll("bis zeile " + STR$(zeile))
END SUB

' Bis zur Zeile mit der Schreibmarke: im Halt sofort, ohne laufenden
' Debugger startet er ihn und laeuft beim ersten Halt dorthin. Ein
' Haltepunkt davor haelt trotzdem -- wie in jeder anderen Umgebung.
SUB bisZurMarke()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM m AS TUPLE : m = GUI_TEXTAREA_CURSOR(ta)
    DIM z AS INTEGER : z = m[0]
    IF prozessArt = "debug" AND prozess >= 0 THEN
        IF NOT debugPause THEN
            GUI_SET_TEXT(lblStatus, tr$("Der Debugger läuft gerade -- erst im Halt geht es bis zur Marke."))
            RETURN
        END IF
        debugRunTo(z)
        RETURN
    END IF
    IF prozess >= 0 THEN RETURN
    debugBis = z
    debuggen()
END SUB

' Je Bild: einen Ausdruck aufnehmen (Enter im Feld), einen entfernen,
' einen Doppelklick auf eine Variable (neuer Wert) oder auf den Stapel
' (dorthin springen) auswerten.
SUB debugPanelNachziehen()
    IF GUI_ENTERED(tfWatch) THEN
        DIM neu AS STRING : neu = TRIM$(GUI_TEXT(tfWatch))
        IF neu <> "" THEN
            ARRAY_PUSH(watchListe, neu)
            GUI_SET_TEXT(tfWatch, "")
            protokoll("ueberwachen neu " + neu)
            IF prozessArt = "debug" AND prozess >= 0 THEN
                debugWatchesSenden()
            ELSE
                GUI_TABLE_ADD_ROW(tblWatch, [neu, ""])
            END IF
        END IF
    END IF
    IF GUI_CLICKED(btnWatchWeg) THEN
        DIM k AS INTEGER : k = GUI_TABLE_SELECTED(tblWatch)
        IF k >= 0 AND k < LEN(watchListe) THEN
            DIM rest AS ARRAY OF STRING : rest = []
            DIM i AS INTEGER
            FOR i = 0 TO LEN(watchListe) - 1
                IF i <> k THEN ARRAY_PUSH(rest, watchListe[i])
            NEXT
            watchListe = rest
            GUI_TABLE_REMOVE_ROW(tblWatch, k)
            protokoll("ueberwachen weg " + STR$(LEN(watchListe)))
            IF prozessArt = "debug" AND prozess >= 0 THEN debugWatchesSenden()
        END IF
    END IF
    IF GUI_DOUBLE_CLICKED(tblVars) THEN
        DIM r AS INTEGER : r = GUI_TABLE_SELECTED(tblVars)
        ' Setzen geht nur fuer eine ganze Variable -- ein Feld darin nicht.
        IF r >= 0 AND GUI_TREETABLE_PARENT(tblVars, r) >= 0 THEN
            GUI_SET_TEXT(lblStatus, tr$("Setzen geht nur für eine ganze Variable, nicht für ein Feld darin."))
            r = -1
        END IF
        IF r >= 0 AND prozessArt = "debug" AND debugPause THEN
            setzenName = GUI_TABLE_GET_CELL(tblVars, r, 0)
            dlgSetzen = GUI_PROMPT(tr$("Wert setzen"), tr$("Neuer Wert für ") + setzenName + tr$(" (ein Ausdruck):"), GUI_TABLE_GET_CELL(tblVars, r, 2))
        END IF
    END IF
    IF GUI_DOUBLE_CLICKED(tblStapel) THEN
        DIM sr AS INTEGER : sr = GUI_TABLE_SELECTED(tblStapel)
        IF sr >= 0 AND sr < LEN(stapelZeilen) THEN
            DIM zl AS INTEGER : zl = stapelZeilen[sr]
            ' Die Zeile gehoert zu IHRER Datei -- ein Aufruf aus einer
            ' importierten Datei steht nicht im Reiter, der gerade vorn ist.
            IF NOT SAMEFILE(stapelDateien[sr], tabPfade[aktiverTab]) THEN dateiOeffnen(stapelDateien[sr])
            DIM ta AS GUI_WIDGET : ta = aktivesFeld()
            IF ta >= 0 AND zl > 0 THEN GUI_TEXTAREA_GOTO(ta, zl, 1)
            protokoll("stapel sprung " + STR$(zl))
        END IF
    END IF
    IF dlgSetzen <> 0 THEN
        DIM a AS INTEGER : a = GUI_ANSWER(dlgSetzen)
        IF a = 1 THEN
            DIM wert AS STRING : wert = GUI_DIALOG_TEXT(dlgSetzen)
            dlgSetzen = 0
            debugSetzen(setzenName, wert)
        ELSEIF a = 2 THEN
            dlgSetzen = 0
        END IF
    END IF
END SUB

' --- Profil: `dhrt profile` liefert am Ende EINE JSON-Zeile --------------
SUB profilAufnehmen()
    IF prozessStarten("profile") THEN protokoll("profil gestartet")
END SUB

SUB profilAnzeigen(zeile AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(zeile)
    ausgabeVerteilen(JSON_GET_STRING(j, "output"))
    DIM gesamt AS FLOAT : gesamt = JSON_GET_FLOAT(j, "total_time")
    DIM n AS INTEGER : n = JSON_LEN(j, "lines")
    DIM zl[MAX(n, 1)] AS INTEGER
    DIM za[MAX(n, 1)] AS INTEGER
    DIM zt[MAX(n, 1)] AS FLOAT
    DIM zd[MAX(n, 1)] AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = "lines." + STR$(i)
        zl[i] = JSON_GET_INT(j, p + ".line")
        za[i] = JSON_GET_INT(j, p + ".count")
        zt[i] = JSON_GET_FLOAT(j, p + ".time")
        ' Die Hauptdatei heisst wie beim Start, eine importierte kanonisch.
        zd[i] = prozessDatei
        IF JSON_HAS(j, p + ".file") THEN
            IF JSON_GET_STRING(j, p + ".file") <> prozessDatei AND JSON_GET_STRING(j, p + ".file") <> "" THEN zd[i] = JSON_GET_STRING(j, p + ".file")
        END IF
    NEXT
    ' Nach Zeit absteigend -- die teuerste Zeile zuerst.
    DIM k AS INTEGER
    FOR i = 0 TO n - 2
        DIM best AS INTEGER : best = i
        FOR k = i + 1 TO n - 1
            IF zt[k] > zt[best] THEN best = k
        NEXT
        IF best <> i THEN
            DIM t1 AS INTEGER : t1 = zl[i] : zl[i] = zl[best] : zl[best] = t1
            t1 = za[i] : za[i] = za[best] : za[best] = t1
            DIM t2 AS FLOAT : t2 = zt[i] : zt[i] = zt[best] : zt[best] = t2
            DIM t3 AS STRING : t3 = zd[i] : zd[i] = zd[best] : zd[best] = t3
        END IF
    NEXT
    ' Die Quelle zur Messung: der offene Reiter, sonst die Datei -- ohne sie
    ' gaebe es weder den Quelltext je Zeile noch die Funktionen.
    DIM quelle AS ARRAY OF STRING : quelle = []
    DIM tq AS INTEGER : tq = tabMitPfad(prozessDatei)
    IF tq >= 0 THEN
        quelle = SPLIT$(GUI_TEXT(tabFelder[tq]), NL)
    ELSE
        TRY
            quelle = SPLIT$(dateiLesen(prozessDatei), NL)
        CATCH e
            quelle = []
        END TRY
    END IF
    profRohZ = [] : profRohA = [] : profRohT = [] : profRohD = []
    FOR i = 0 TO n - 1
        ARRAY_PUSH(profRohZ, zl[i]) : ARRAY_PUSH(profRohA, za[i]) : ARRAY_PUSH(profRohT, zt[i]) : ARRAY_PUSH(profRohD, zd[i])
    NEXT
    profLeseDatei = ""
    profGesamt = gesamt
    profQuelle = quelle
    profilTabelleFuellen()
    ' Fuer die Aufrufer-Liste aufheben: WIE OFT eine Zeile gelaufen ist.
    ' Wer wissen will, welcher Weg der heisse ist, sieht es dann im Baum,
    ' statt Aufrufstellen und Profil im Kopf zusammenzubringen.
    profDatei = prozessDatei
    profZeilen = [] : profAnzahl = []
    FOR i = 0 TO n - 1
        IF zd[i] = prozessDatei THEN ARRAY_PUSH(profZeilen, zl[i]) : ARRAY_PUSH(profAnzahl, za[i])
    NEXT
    GUI_SET_TEXT(lblProfil, BASENAME(prozessDatei) + ": " + FORMAT$(gesamt * 1000.0, "%.2f") + tr$(" ms gesamt, ") + STR$(n) + tr$(" Zeilen gemessen"))
    IF JSON_HAS(j, "error") THEN
        DIM fd AS STRING : fd = prozessDatei
        IF JSON_HAS(j, "error_file") THEN
            IF JSON_GET_STRING(j, "error_file") <> "" THEN fd = JSON_GET_STRING(j, "error_file")
        END IF
        ausgabe("-- Fehler in " + BASENAME(fd) + ":" + STR$(JSON_GET_INT(j, "error_line")) + ": " + JSON_GET_STRING(j, "error"))
    END IF
    waermeDaten = TRUE
    waermeAnwenden()
    GUI_WINDOW_VISIBLE(winProfil, TRUE)
    GUI_FOCUS(tblProfil)          ' holt das Fenster vor das Hauptfenster
    protokoll("profil " + STR$(n))
END SUB

' Die Tabelle aus der Messung: je Zeile (die teuersten 300) oder je
' Funktion. Eine Zeile gehoert zur INNERSTEN Funktion, die sie umschliesst
' (eine Methode zu ihrer Klasse als `Klasse.methode`), alles ausserhalb zum
' Hauptprogramm. Ein Klick springt zur Zeile bzw. zum Kopf der Funktion.
SUB profilTabelleFuellen()
    GUI_TABLE_CLEAR(tblProfil)
    DIM pz AS ARRAY OF INTEGER : pz = []
    DIM n AS INTEGER : n = LEN(profRohZ)
    DIM i AS INTEGER
    IF NOT GUI_CHECKED(cbProfilFunk) THEN
        GUI_TABLE_HEADERS(tblProfil, [tr$("Zeile"), tr$("Anzahl"), "ms", tr$("Anteil"), tr$("Quelltext")])
        GUI_TABLE_COL_WIDTHS(tblProfil, [60, 80, 80, 70, 320])
        DIM pd AS ARRAY OF STRING : pd = []
        FOR i = 0 TO MIN(n, 300) - 1
            DIM anteil AS STRING : anteil = "-"
            IF profGesamt > 0.0 THEN anteil = FORMAT$(profRohT[i] / profGesamt * 100.0, "%.1f") + " %"
            DIM q AS STRING : q = profZeileText$(profDatei$(i), profRohZ[i])
            DIM zs AS STRING : zs = STR$(profRohZ[i])
            IF profDatei$(i) <> prozessDatei THEN zs = BASENAME(profDatei$(i)) + ":" + zs
            GUI_TABLE_ADD_ROW(tblProfil, [zs, STR$(profRohA[i]), FORMAT$(profRohT[i] * 1000.0, "%.2f"), anteil, q])
            ARRAY_PUSH(pz, profRohZ[i]) : ARRAY_PUSH(pd, profDatei$(i))
        NEXT
        profilZeilen = pz : profilDateien = pd
        protokoll("profiltabelle zeilen " + STR$(LEN(pz)))
        RETURN
    END IF
    profBerName = [] : profBerVon = [] : profBerBis = [] : profBerDatei = []
    ' Die Bereiche JEDER gemessenen Datei, je mit ihrer Datei gemerkt.
    DIM dateien AS ARRAY OF STRING : dateien = []
    FOR i = 0 TO n - 1
        IF ARRAY_INDEXOF(dateien, profDatei$(i)) < 0 THEN ARRAY_PUSH(dateien, profDatei$(i))
    NEXT
    DIM di AS INTEGER
    FOR di = 0 TO LEN(dateien) - 1
        DIM text AS STRING
        IF dateien[di] = prozessDatei THEN
            text = JOIN$(profQuelle, NL)
        ELSE
            TRY
                text = dateiLesen(dateien[di])
            CATCH e
                text = ""
            END TRY
        END IF
        DIM j AS JSON_HANDLE : j = JSON_PARSE("{" + CHR$(34) + "s" + CHR$(34) + ": " + CODE_SYMBOLS$(text) + "}")
        profilBereiche(j, "s", "")
        WHILE LEN(profBerDatei) < LEN(profBerName)
            ARRAY_PUSH(profBerDatei, dateien[di])
        WEND
    NEXT
    DIM gName AS ARRAY OF STRING : gName = []
    DIM gDatei AS ARRAY OF STRING : gDatei = []
    DIM gVon AS ARRAY OF INTEGER : gVon = []
    DIM gZeilen AS ARRAY OF INTEGER : gZeilen = []
    DIM gZeit AS ARRAY OF FLOAT : gZeit = []
    FOR i = 0 TO n - 1
        DIM z AS INTEGER : z = profRohZ[i]
        DIM name AS STRING : name = "(Hauptprogramm)"
        IF profDatei$(i) <> prozessDatei THEN name = "(" + BASENAME(profDatei$(i)) + ")"
        DIM von AS INTEGER : von = 1
        DIM spanne AS INTEGER : spanne = 2000000000
        DIM k AS INTEGER
        FOR k = 0 TO LEN(profBerName) - 1
            IF profBerDatei[k] = profDatei$(i) AND z >= profBerVon[k] AND z <= profBerBis[k] AND profBerBis[k] - profBerVon[k] < spanne THEN
                spanne = profBerBis[k] - profBerVon[k]
                name = profBerName[k] : von = profBerVon[k]
                IF profDatei$(i) <> prozessDatei THEN name = BASENAME(profDatei$(i)) + ": " + name
            END IF
        NEXT
        DIM g AS INTEGER : g = ARRAY_INDEXOF(gName, name)
        IF g < 0 THEN
            ARRAY_PUSH(gName, name) : ARRAY_PUSH(gVon, von) : ARRAY_PUSH(gZeilen, 0) : ARRAY_PUSH(gZeit, 0.0) : ARRAY_PUSH(gDatei, profDatei$(i))
            g = LEN(gName) - 1
        END IF
        gZeilen[g] = gZeilen[g] + 1
        gZeit[g] = gZeit[g] + profRohT[i]
    NEXT
    ' Nach Zeit absteigend.
    DIM m AS INTEGER : m = LEN(gName)
    DIM a AS INTEGER
    FOR a = 0 TO m - 2
        DIM best AS INTEGER : best = a
        FOR k = a + 1 TO m - 1
            IF gZeit[k] > gZeit[best] THEN best = k
        NEXT
        IF best <> a THEN
            DIM t0 AS STRING : t0 = gName[a] : gName[a] = gName[best] : gName[best] = t0
            DIM t1 AS INTEGER : t1 = gVon[a] : gVon[a] = gVon[best] : gVon[best] = t1
            t1 = gZeilen[a] : gZeilen[a] = gZeilen[best] : gZeilen[best] = t1
            DIM t2 AS FLOAT : t2 = gZeit[a] : gZeit[a] = gZeit[best] : gZeit[best] = t2
            DIM t3 AS STRING : t3 = gDatei[a] : gDatei[a] = gDatei[best] : gDatei[best] = t3
        END IF
    NEXT
    GUI_TABLE_HEADERS(tblProfil, [tr$("Funktion"), tr$("ab Zeile"), tr$("Zeilen"), "ms", tr$("Anteil")])
    GUI_TABLE_COL_WIDTHS(tblProfil, [240, 80, 70, 90, 80])
    FOR a = 0 TO m - 1
        DIM ant AS STRING : ant = "-"
        IF profGesamt > 0.0 THEN ant = FORMAT$(gZeit[a] / profGesamt * 100.0, "%.1f") + " %"
        GUI_TABLE_ADD_ROW(tblProfil, [gName[a], STR$(gVon[a]), STR$(gZeilen[a]), FORMAT$(gZeit[a] * 1000.0, "%.2f"), ant])
        ARRAY_PUSH(pz, gVon[a])
        protokoll("profiltabelle funktion " + gName[a] + " " + STR$(gZeilen[a]))
    NEXT
    profilZeilen = pz : profilDateien = gDatei
    protokoll("profiltabelle funktionen " + STR$(m))
END SUB

' Die Datei einer Messzeile -- fehlt sie (Messung ohne Dateien), die
' gestartete.
FUNCTION profDatei$(i AS INTEGER) AS STRING
    IF i < LEN(profRohD) THEN RETURN profRohD[i]
    RETURN prozessDatei
END FUNCTION

' Der Quelltext einer gemessenen Zeile -- aus der Hauptdatei (so, wie sie
' im Editor steht) oder aus einer importierten, die einmal gelesen und
' behalten wird, solange die naechste Zeile aus derselben kommt.
FUNCTION profZeileText$(datei AS STRING, z AS INTEGER) AS STRING
    IF datei = prozessDatei THEN
        IF z >= 1 AND z <= LEN(profQuelle) THEN RETURN TRIM$(profQuelle[z - 1])
        RETURN ""
    END IF
    IF datei <> profLeseDatei THEN
        profLeseDatei = datei
        TRY
            profLeseZeilen = SPLIT$(dateiLesen(datei), NL)
        CATCH e
            profLeseZeilen = []
        END TRY
    END IF
    IF z >= 1 AND z <= LEN(profLeseZeilen) THEN RETURN TRIM$(profLeseZeilen[z - 1])
    RETURN ""
END FUNCTION

' Die Funktionsbereiche aus CODE_SYMBOLS$ einsammeln, Methoden als
' `Klasse.methode`.
SUB profilBereiche(j AS JSON_HANDLE, pfad AS STRING, vor AS STRING)
    DIM n AS INTEGER : n = JSON_LEN(j, pfad)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = pfad + "." + STR$(i)
        DIM art AS STRING : art = JSON_GET_STRING(j, p + ".art")
        DIM name AS STRING : name = JSON_GET_STRING(j, p + ".name")
        IF art = "function" THEN
            ARRAY_PUSH(profBerName, vor + name)
            ARRAY_PUSH(profBerVon, JSON_GET_INT(j, p + ".von"))
            ARRAY_PUSH(profBerBis, JSON_GET_INT(j, p + ".bis"))
        END IF
        IF JSON_LEN(j, p + ".kinder") > 0 THEN
            profilBereiche(j, p + ".kinder", IIF(art = "class", vor + name + ".", vor))
        END IF
    NEXT
END SUB

SUB profilAnspringen()
    DIM r AS INTEGER : r = GUI_TABLE_SELECTED(tblProfil)
    IF r < 0 OR r >= LEN(profilZeilen) THEN RETURN
    IF r < LEN(profilDateien) THEN dateiOeffnen(profilDateien[r]) ELSE dateiOeffnen(prozessDatei)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 THEN GUI_TEXTAREA_GOTO(ta, profilZeilen[r], 1) : GUI_FOCUS(ta)
END SUB

' stdout des Kindes: beim Lauf Text, beim Debugger Ereignisse, beim Profil
' am Ende die eine JSON-Zeile -- alles zeilenweise, halbe Zeilen warten.
SUB stdoutVerteilen(text AS STRING)
    IF text = "" THEN RETURN
    IF prozessArt = "run" THEN ausgabeVerteilen(text) : RETURN
    prozessRest = prozessRest + text
    WHILE INSTR(prozessRest, NL) >= 0
        DIM p AS INTEGER : p = INSTR(prozessRest, NL)
        DIM z AS STRING : z = REPLACE$(LEFT$(prozessRest, p), CHR$(13), "")
        prozessRest = MID$(prozessRest, p + 1)
        IF prozessArt = "debug" THEN
            debugEreignis(z)
        ELSEIF LEFT$(z, 1) = "{" AND INSTR(z, CHR$(34) + "total_time" + CHR$(34)) >= 0 THEN
            ' die eine Ergebniszeile des Profilers (Schluessel sortiert, also
            ' nicht am Anfang zu erkennen)
            profilAnzeigen(z)
        ELSE
            ausgabe(z)
        END IF
    WEND
END SUB

SUB prozessNachsehen()
    IF prozess < 0 THEN RETURN
    IF stoppFrist > 0 AND GET_TIME() > stoppFrist THEN
        stoppFrist = 0
        IF PROCESS_RUNNING(prozess) THEN PROCESS_KILL(prozess)
    END IF
    stdoutVerteilen(PROCESS_READ$(prozess))
    DIM err AS STRING : err = PROCESS_ERR$(prozess)
    IF err <> "" THEN ausgabeVerteilen(err)
    IF NOT PROCESS_RUNNING(prozess) THEN
        ' Das Kind kann schon beendet sein, bevor sein Lesefaden die letzte
        ' Zeile abgelegt hat -- beim Debugger ist das oft das `finished`.
        ' Einmal lesen liess es dann fallen (der Neustart-Test wackelte so);
        ' gelesen wird, bis fuenf Abfragen hintereinander leer sind.
        DIM leerIn AS INTEGER : leerIn = 0
        WHILE leerIn < 5
            DIM restA AS STRING : restA = PROCESS_READ$(prozess)
            DIM restE AS STRING : restE = PROCESS_ERR$(prozess)
            IF restE <> "" THEN ausgabeVerteilen(restE)
            IF restA = "" AND restE = "" THEN
                leerIn = leerIn + 1
                SLEEP(10)
            ELSE
                IF restA <> "" THEN stdoutVerteilen(restA)
                leerIn = 0
            END IF
        WEND
        IF prozessRest <> "" THEN stdoutVerteilen(NL)
        IF ausgabeRest <> "" THEN ausgabe(ausgabeRest) : ausgabeRest = ""
        DIM code AS INTEGER : code = PROCESS_CODE(prozess)
        PROCESS_CLOSE(prozess)
        prozess = -1
        IF prozessArt = "debug" THEN
            debugPause = FALSE : debugZeile = 0
            debugWerteLoeschen()
            debugPanelZeigen(FALSE)
        END IF
        IF fertigNachStopp THEN
            GUI_SET_TEXT(lblAusgabe, tr$("Ausgabe: gestoppt"))
            protokoll("gestoppt")
        ELSE
            GUI_SET_TEXT(lblAusgabe, tr$("Ausgabe: beendet mit Code ") + STR$(code))
            protokoll("beendet " + STR$(code))
        END IF
        fertigNachStopp = FALSE
        stoppFrist = 0
        prozessArt = ""
        IF neustartArt <> "" THEN neustartAusfuehren()
    END IF
END SUB

' Strg+Umschalt+F5: laeuft etwas, wird es gestoppt und danach dasselbe
' Programm in derselben Art neu gestartet; laeuft nichts, ein normaler Start.
SUB neuStarten()
    IF prozess < 0 THEN
        starten()
        RETURN
    END IF
    neustartArt = prozessArt
    neustartDatei = prozessDatei
    protokoll("neustart " + neustartArt)
    stoppen()
END SUB

SUB neustartAusfuehren()
    DIM art AS STRING : art = neustartArt
    neustartArt = ""
    ' Vom Sichern ausgeloest: dieselbe Datei wieder starten, ohne den
    ' Reiter zu wechseln -- gesichert wurde vielleicht eine importierte Datei,
    ' an der man weiterarbeiten will.
    IF neustartVomSichern THEN
        neustartVomSichern = FALSE
        IF prozessStartenDatei("run", neustartDatei) THEN protokoll("gestartet " + prozessDatei)
        RETURN
    END IF
    IF neustartDatei <> "" THEN dateiOeffnen(neustartDatei)
    SELECT CASE art
        CASE "debug" : debuggen()
        CASE "profile" : profilAufnehmen()
        CASE ELSE : starten()
    END SELECT
END SUB

' Geaendert, waehrend der Debugger laeuft: das laufende Programm kennt noch
' die alten Zeilen -- einmal sagen, statt dass Haltepunkte scheinbar
' daneben halten. Vor dem Start war alles gesichert, eine Aenderung an einem
' benannten Reiter ist also eine danach.
SUB debugAenderungNachsehen()
    IF prozessArt <> "debug" OR prozess < 0 THEN
        debugGeaendertGesagt = FALSE
        RETURN
    END IF
    IF debugGeaendertGesagt THEN RETURN
    DIM t AS INTEGER
    FOR t = 0 TO tabAnzahl - 1
        IF tabPfade[t] <> "" THEN
            IF GUI_TEXT(tabFelder[t]) <> tabGesichert[t] THEN
                debugGeaendertGesagt = TRUE
                GUI_SET_TEXT(lblStatus, BASENAME(tabPfade[t]) + tr$(" geändert, während der Debugger läuft -- das Programm kennt noch die alten Zeilen. Strg+Umschalt+F5 startet neu."))
                protokoll("debug geaendert " + BASENAME(tabPfade[t]))
                RETURN
            END IF
        END IF
    NEXT
END SUB

' --- Handbuch: docs/*.md im Fenster -----------------------------------
FUNCTION wortUnterMarke$() AS STRING
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN ""
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN ""
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    ' Spalte ist 1-basiert und steht HINTER dem Zeichen links der Marke.
    DIM a AS INTEGER : a = s - 1
    DIM e AS INTEGER : e = s - 1
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    WHILE e < LEN(zeile) AND istWortzeichen(MID$(zeile, e, 1)) : e = e + 1 : WEND
    RETURN MID$(zeile, a, e - a)
END FUNCTION

FUNCTION wortSpalte(ta AS GUI_WIDGET) AS INTEGER
    IF ta < 0 THEN RETURN 0
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN 0
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    DIM a AS INTEGER : a = s - 1
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    RETURN a + 1
END FUNCTION

FUNCTION istWortzeichen(c AS STRING) AS BOOLEAN
    IF c = "" THEN RETURN FALSE
    RETURN c = "_" OR c = "$" OR (c >= "a" AND c <= "z") OR (c >= "A" AND c <= "Z") OR (c >= "0" AND c <= "9")
END FUNCTION

SUB handbuchDokumente()
    IF LEN(docNamen) > 0 THEN RETURN
    docNamen = DIRLIST(docsOrdner, "*.md")
    GUI_SET_DROPDOWN(ddDoku, docNamen)
END SUB

' --- Handbuch gesetzt statt roh ---------------------------------------
' Das Setzen macht seit Stand 25 `GUI_RICHTEXT`. Was hier stand, waren 180
' Zeilen, die Ueberschriften, Aufzaehlungen, Codebloecke und Tabellen selbst
' auf eine Zeichenflaeche malten -- samt der Einschraenkungen, die im
' Kommentar dazu standen: fett und kursiv fielen weg, ein Verweis wurde zu
' Text, und eine Tabelle wurde zur Begriffsliste, weil Spalten einen zweiten
' Durchlauf gebraucht haetten. Das Widget kann alle drei.

' Zu der Stelle rollen, an der die QUELLZEILE `zeile` gesetzt wurde --
' gesucht wird nach ihrem Inhalt, denn Zeilennummern kennt der Satz nicht.
SUB hbZuZeile(zeile AS INTEGER)
    GUI_RICHTEXT_SCROLL(rtHandbuch, 0)
    IF zeile <= 1 THEN RETURN
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(taHandbuch), NL)
    IF zeile - 1 >= LEN(zeilen) THEN RETURN
    ' Ein Wort reicht nicht (zu haeufig), die ganze Zeile trifft nach dem
    ' Umbruch womoeglich keine gesetzte Zeile -- die ersten Woerter sind der
    ' Kompromiss, der in der Praxis trifft.
    DIM roh AS STRING : roh = TRIM$(REPLACE$(REPLACE$(zeilen[zeile - 1], "#", ""), "*", ""))
    IF LEN(roh) > 40 THEN roh = LEFT$(roh, 40)
    IF TRIM$(roh) = "" THEN RETURN
    GUI_RICHTEXT_FIND(rtHandbuch, TRIM$(roh), -1)
END SUB

SUB handbuchAnsicht(gesetzt AS BOOLEAN)
    hbGesetzt = gesetzt
    GUI_SET_VISIBLE(rtHandbuch, gesetzt)
    GUI_SET_VISIBLE(taHandbuch, NOT gesetzt)
    GUI_SET_TEXT(btnHbAnsicht, IIF(gesetzt, tr$("Quelltext"), tr$("Gesetzt")))
    protokoll("hbansicht " + IIF(gesetzt, "gesetzt", "quelltext"))
END SUB

' Die Masse des Handbuchfensters: es waechst mit dem Schirm (hoechstens
' 1500 x 1000), die linke obere Ecke bleibt -- dann bleibt auch jede Lage im
' Fenster gleich, egal wie gross der Schirm ist. Nach einem Ziehen am Griff
' ruft die Bildschleife es mit der neuen Groesse.
SUB handbuchLayout()
    DIM b AS INTEGER : b = GUI_WINDOW_GET_W(winHandbuch)
    DIM h AS INTEGER : h = GUI_WINDOW_GET_H(winHandbuch)
    IF NOT GUI_WINDOW_SHOWN(winHandbuch) THEN
        b = MAX(900, MIN(1500, SCREENWIDTH() - HB_X - 40))
        h = MAX(500, MIN(1000, SCREENHEIGHT() - HB_Y - 40))
        GUI_WINDOW_SET_BOUNDS(winHandbuch, HB_X, HB_Y, b, h)
    END IF
    hbMassStand = STR$(b) + "x" + STR$(h)
    ' Inhaltshoehe: das Fenster ohne Titelleiste, abzueglich Kopfzeile (46)
    ' und Meldungszeile (30).
    DIM ih AS INTEGER : ih = h - 34 - 46 - 30
    DIM tb AS INTEGER : tb = b - HB_INHALT_B - 32
    GUI_SET_BOUNDS(lstHbInhalt, 8, 46, HB_INHALT_B, ih)
    GUI_SET_BOUNDS(rtHandbuch, HB_INHALT_B + 16, 46, tb, ih)
    GUI_SET_BOUNDS(taHandbuch, HB_INHALT_B + 16, 46, tb, ih)
    GUI_SET_BOUNDS(lblHbStand, 8, 46 + ih + 6, b - 24, 22)
    GUI_SET_BOUNDS(btnHbAnsicht, b - 16 - 104, 8, 104, 28)
END SUB

' --- Suche ueber alle Dokumente -----------------------------------------
' Ein Stueck der Zeile um die Fundstelle, ohne Markdown-Zeichen -- eine
' Zeile aus einer Tabelle waere sonst vor allem Striche.
FUNCTION hbAusschnitt$(zeile AS STRING, klein AS STRING) AS STRING
    DIM t AS STRING : t = TRIM$(zeile)
    ' In einer Tabellenzeile zaehlt die Zelle mit dem Treffer.
    IF LEFT$(t, 1) = "|" THEN
        DIM zelle AS STRING
        FOR EACH zelle IN SPLIT$(t, "|")
            IF INSTR(LOWER$(zelle), klein) >= 0 THEN t = TRIM$(zelle) : BREAK
        NEXT
    END IF
    t = REPLACE$(REPLACE$(t, "`", ""), "**", "")
    WHILE LEFT$(t, 1) = "#" OR LEFT$(t, 1) = ">" OR LEFT$(t, 1) = "-"
        t = TRIM$(MID$(t, 1, LEN(t)))
    WEND
    ' Kurz genug fuer die Spalte -- rechts steht noch die Zeilennummer.
    IF LEN(t) <= 34 THEN RETURN t
    DIM p AS INTEGER : p = INSTR(LOWER$(t), klein)
    DIM a AS INTEGER : a = MAX(0, p - 10)
    IF a + 34 > LEN(t) THEN a = MAX(0, LEN(t) - 34)
    DIM r AS STRING : r = MID$(t, a, 34)
    IF a > 0 THEN r = "…" + r
    IF a + 34 < LEN(t) THEN r = r + "…"
    RETURN r
END FUNCTION

SUB hbSucheAlle()
    DIM gesucht AS STRING : gesucht = TRIM$(GUI_TEXT(tfHbSuche))
    IF gesucht = "" THEN GUI_SET_TEXT(lblHbStand, tr$("Erst einen Suchtext eingeben.")) : RETURN
    handbuchDokumente()
    DIM klein AS STRING : klein = LOWER$(gesucht)
    DIM eintraege AS ARRAY OF STRING : eintraege = []
    DIM details AS ARRAY OF STRING : details = []
    hbTrDatei = [] : hbTrZeile = []
    DIM treffer AS INTEGER : treffer = 0
    DIM dokumente AS INTEGER : dokumente = 0
    DIM voll AS BOOLEAN : voll = FALSE
    DIM d AS STRING
    FOR EACH d IN docNamen
        IF voll THEN BREAK
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(docsOrdner, d))
        DIM kopf AS BOOLEAN : kopf = FALSE
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            IF INSTR(LOWER$(zeilen[i]), klein) >= 0 THEN
                IF NOT kopf THEN
                    ARRAY_PUSH(eintraege, d) : ARRAY_PUSH(details, "")
                    ARRAY_PUSH(hbTrDatei, d) : ARRAY_PUSH(hbTrZeile, 0)
                    kopf = TRUE
                    dokumente = dokumente + 1
                END IF
                ARRAY_PUSH(eintraege, "   " + hbAusschnitt$(zeilen[i], klein))
                ARRAY_PUSH(details, STR$(i + 1))
                ARRAY_PUSH(hbTrDatei, d) : ARRAY_PUSH(hbTrZeile, i + 1)
                treffer = treffer + 1
                ' Mehr liest niemand -- und die Liste bliebe bedienbar.
                IF treffer >= 500 THEN
                    voll = TRUE
                    BREAK
                END IF
            END IF
        NEXT
    NEXT
    hbTrModus = TRUE
    hbTrNadel = gesucht
    hbTrWahl = -1
    GUI_SET_LISTBOX(lstHbInhalt, eintraege)
    GUI_LISTBOX_SET_SELECTED(lstHbInhalt, -1)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(eintraege) - 1
        IF hbTrZeile[k] = 0 THEN
            GUI_LISTBOX_HEADER(lstHbInhalt, k, TRUE)
        ELSE
            GUI_LISTBOX_DETAIL(lstHbInhalt, k, details[k])
            GUI_LISTBOX_TIP(lstHbInhalt, k, hbTrDatei[k] + ", Zeile " + details[k])
        END IF
    NEXT
    GUI_LISTBOX_PLACEHOLDER(lstHbInhalt, tr$("Kein Treffer"))
    GUI_SET_TEXT(btnHbAlle, tr$("Inhalt"))
    GUI_TOOLTIP(btnHbAlle, tr$("Zurück zum Inhaltsverzeichnis des Dokuments"))
    DIM st AS STRING : st = "'" + gesucht + "': " + STR$(treffer) + " Treffer in " + STR$(dokumente) + " Dokumenten"
    IF voll THEN st = st + " (nach 500 abgebrochen)"
    GUI_SET_TEXT(lblHbStand, st)
    protokoll("hballe " + STR$(treffer) + " " + STR$(dokumente))
END SUB

' Zurueck zum Inhaltsverzeichnis des offenen Dokuments.
SUB hbSucheAlleEnde()
    hbTrModus = FALSE
    GUI_LISTBOX_PLACEHOLDER(lstHbInhalt, tr$("Keine Überschriften"))
    GUI_SET_TEXT(btnHbAlle, tr$("In allen"))
    GUI_TOOLTIP(btnHbAlle, tr$("In allen Dokumenten des Handbuchs suchen -- die Treffer stehen links"))
    hbInhaltFuellen()
END SUB

' --- Knoepfe an den Codebloecken ----------------------------------------
' Kopieren, in einen neuen Reiter oder gleich starten. Gestartet wird eine
' Datei neben der ide.json -- ein Reiter ohne Namen wuerde erst nach einem
' Namen fragen, und ein Beispiel will man ausprobieren, nicht ablegen.
SUB hbCodeAktion(aktion AS STRING, code AS STRING)
    DIM n AS INTEGER : n = LEN(SPLIT$(RTRIM$(code), NL))
    protokoll("hbcode " + aktion + " " + STR$(n))
    IF aktion = "Kopieren" THEN
        TRY
            CLIPBOARD_SET(code)
            GUI_SET_TEXT(lblHbStand, tr$("Beispiel kopiert (") + STR$(n) + tr$(" Zeilen)."))
        CATCH e
            GUI_SET_TEXT(lblHbStand, tr$("Die Zwischenablage ist gerade belegt -- noch einmal versuchen."))
        END TRY
    ELSEIF aktion = "In neuen Reiter" THEN
        DIM vorher AS INTEGER : vorher = tabAnzahl
        tabOeffnen("", code)
        ' Als ungesichert markieren -- sonst ginge es beim Schliessen wortlos weg.
        IF tabAnzahl > vorher THEN tabGesichert[aktiverTab] = ""
    ELSEIF aktion = "Starten" THEN
        DIM pfad AS STRING : pfad = PATHJOIN(DIRNAME(konfigPfad), "handbuch_beispiel.dh")
        TRY
            WRITEALL(pfad, code)
        CATCH e
            GUI_SET_TEXT(lblHbStand, tr$("Konnte das Beispiel nicht ablegen: ") + e)
            RETURN
        END TRY
        IF prozessStartenDatei("run", pfad) THEN protokoll("gestartet " + prozessDatei)
    END IF
END SUB

' Die Quelltext-Ansicht eingefaerbt: Ueberschriften, Code, Verweise und
' Auszeichnungen, Codebloecke wie im Editor. Einmal beim Laden -- der Text
' aendert sich dort nicht.
SUB hbQuelleFaerben()
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(taHandbuch), NL)
    DIM s AS ARRAY OF INTEGER : s = []
    DIM l AS ARRAY OF INTEGER : l = []
    DIM f AS ARRAY OF INTEGER : f = []
    DIM off AS INTEGER : off = 0
    DIM imCode AS BOOLEAN : imCode = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM z AS STRING : z = zeilen[i]
        DIM t AS STRING : t = TRIM$(z)
        DIM n AS INTEGER : n = LEN(z)
        IF LEFT$(t, 3) = "```" THEN
            ARRAY_PUSH(s, off) : ARRAY_PUSH(l, n) : ARRAY_PUSH(f, F_KOMMENTAR)
            imCode = NOT imCode
        ELSEIF imCode THEN
            DIM cs AS ARRAY OF INTEGER
            DIM cl AS ARRAY OF INTEGER
            DIM ca AS ARRAY OF STRING
            (cs, cl, ca) = SYNTAX_SPANS(z)
            DIM k AS INTEGER
            FOR k = 0 TO LEN(cs) - 1
                ARRAY_PUSH(s, off + cs[k]) : ARRAY_PUSH(l, cl[k]) : ARRAY_PUSH(f, farbeFuer(ca[k]))
            NEXT
        ELSEIF LEFT$(t, 1) = "#" THEN
            ARRAY_PUSH(s, off) : ARRAY_PUSH(l, n) : ARRAY_PUSH(f, F_SCHLUESSEL)
        ELSE
            ' Zeichen am Zeilenanfang: Aufzaehlung, Zitat, Tabelle.
            DIM vorn AS INTEGER : vorn = n - LEN(LTRIM$(z))
            IF LEFT$(t, 2) = "- " OR LEFT$(t, 2) = "* " OR LEFT$(t, 1) = ">" OR LEFT$(t, 1) = "|" THEN
                ARRAY_PUSH(s, off + vorn) : ARRAY_PUSH(l, 1) : ARRAY_PUSH(f, F_OPERATOR)
            END IF
            ' Inline: `code`, **fett**, [Verweis](ziel), Tabellenstriche.
            DIM p AS INTEGER : p = 0
            WHILE p < n
                DIM ch AS STRING : ch = MID$(z, p, 1)
                IF ch = "`" THEN
                    DIM e AS INTEGER : e = INSTR(MID$(z, p + 1, n), "`")
                    IF e < 0 THEN BREAK
                    ARRAY_PUSH(s, off + p) : ARRAY_PUSH(l, e + 2) : ARRAY_PUSH(f, F_TEXT)
                    p = p + e + 2
                ELSEIF ch = "*" AND MID$(z, p + 1, 1) = "*" THEN
                    DIM e2 AS INTEGER : e2 = INSTR(MID$(z, p + 2, n), "**")
                    IF e2 < 0 THEN p = p + 2 : CONTINUE
                    ARRAY_PUSH(s, off + p) : ARRAY_PUSH(l, e2 + 4) : ARRAY_PUSH(f, F_ZAHL)
                    p = p + e2 + 4
                ELSEIF ch = "[" THEN
                    DIM e3 AS INTEGER : e3 = INSTR(MID$(z, p, n), "](")
                    DIM e4 AS INTEGER : e4 = -1
                    IF e3 > 0 THEN e4 = INSTR(MID$(z, p + e3, n), ")")
                    IF e3 <= 0 OR e4 < 0 THEN p = p + 1 : CONTINUE
                    ARRAY_PUSH(s, off + p) : ARRAY_PUSH(l, e3 + e4 + 1) : ARRAY_PUSH(f, F_SCHLUESSEL)
                    p = p + e3 + e4 + 1
                ELSEIF ch = "|" THEN
                    ARRAY_PUSH(s, off + p) : ARRAY_PUSH(l, 1) : ARRAY_PUSH(f, F_OPERATOR)
                    p = p + 1
                ELSE
                    p = p + 1
                END IF
            WEND
        END IF
        off = off + n + 1
    NEXT
    GUI_TEXTAREA_SPANS(taHandbuch, s, l, f)
END SUB

' Die Codebloecke im Handbuch in den Farben des Editors.
SUB hbFarben()
    GUI_RICHTEXT_SET(rtHandbuch, "farbe_kommentar", F_KOMMENTAR)
    GUI_RICHTEXT_SET(rtHandbuch, "farbe_text", F_TEXT)
    GUI_RICHTEXT_SET(rtHandbuch, "farbe_zahl", F_ZAHL)
    GUI_RICHTEXT_SET(rtHandbuch, "farbe_schluessel", F_SCHLUESSEL)
    GUI_RICHTEXT_SET(rtHandbuch, "farbe_operator", F_OPERATOR)
    GUI_RICHTEXT_SET(rtHandbuch, "farbe_name", F_GRUND)
END SUB

' Das Inhaltsverzeichnis aus den Ueberschriften. Die erste Ebene in der
' Akzentfarbe, die weiteren eingerueckt.
SUB hbInhaltFuellen()
    DIM titel AS ARRAY OF STRING : titel = GUI_RICHTEXT_HEADINGS(rtHandbuch)
    DIM ebene AS ARRAY OF INTEGER : ebene = GUI_RICHTEXT_HEADING_LEVELS(rtHandbuch)
    DIM eintraege AS ARRAY OF STRING : eintraege = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(titel) - 1
        ARRAY_PUSH(eintraege, SPACE$((ebene[i] - 1) * 3) + titel[i])
    NEXT
    GUI_SET_LISTBOX(lstHbInhalt, eintraege)
    ' Eine stehengebliebene Auswahl des vorigen Dokuments saehe im naechsten
    ' Bild aus wie ein Klick -- und schriebe einen falschen Schritt in den Verlauf.
    GUI_LISTBOX_SET_SELECTED(lstHbInhalt, -1)
    FOR i = 0 TO LEN(titel) - 1
        IF ebene[i] = 1 THEN GUI_LISTBOX_COLOR(lstHbInhalt, i, GUI_THEME_GET("accent"))
        ' Lange Titel passen nicht in die Spalte -- der ganze steht im Tooltip.
        GUI_LISTBOX_TIP(lstHbInhalt, i, titel[i])
    NEXT
    hbInhaltWahl = -1
    hbInhaltHalt = -1
    protokoll("hbinhalt " + STR$(LEN(titel)))
END SUB

' Den jetzigen Ort vor einem Sprung merken; ein neuer Sprung loescht das
' Vorwaerts, wie im Browser.
SUB hbMerken()
    IF docLetzteWahl < 0 OR docLetzteWahl >= LEN(docNamen) THEN RETURN
    IF NOT GUI_WINDOW_SHOWN(winHandbuch) THEN RETURN
    ARRAY_PUSH(hbZurDatei, docNamen[docLetzteWahl])
    ARRAY_PUSH(hbZurScroll, GUI_RICHTEXT_SCROLL_GET(rtHandbuch))
    hbVorDatei = [] : hbVorScroll = []
END SUB

' Zurueck (rueck = TRUE) oder vorwaerts im Verlauf.
SUB hbVerlauf(rueck AS BOOLEAN)
    IF rueck AND LEN(hbZurDatei) = 0 THEN RETURN
    IF NOT rueck AND LEN(hbVorDatei) = 0 THEN RETURN
    DIM jetzt AS STRING : jetzt = docNamen[docLetzteWahl]
    DIM js AS INTEGER : js = GUI_RICHTEXT_SCROLL_GET(rtHandbuch)
    DIM d AS STRING
    DIM sc AS INTEGER
    IF rueck THEN
        d = hbZurDatei[LEN(hbZurDatei) - 1] : sc = hbZurScroll[LEN(hbZurScroll) - 1]
        ARRAY_POP(hbZurDatei) : ARRAY_POP(hbZurScroll)
        ARRAY_PUSH(hbVorDatei, jetzt) : ARRAY_PUSH(hbVorScroll, js)
    ELSE
        d = hbVorDatei[LEN(hbVorDatei) - 1] : sc = hbVorScroll[LEN(hbVorScroll) - 1]
        ARRAY_POP(hbVorDatei) : ARRAY_POP(hbVorScroll)
        ARRAY_PUSH(hbZurDatei, jetzt) : ARRAY_PUSH(hbZurScroll, js)
    END IF
    IF d <> jetzt THEN handbuchLaden(d, 1)
    GUI_RICHTEXT_SCROLL(rtHandbuch, sc)
    hbInhaltHalt = -1
    protokoll("hbverlauf " + IIF(rueck, "zurueck ", "vor ") + d + " " + STR$(sc))
END SUB

' Inhaltsverzeichnis und Text gehen miteinander: ein Klick in die Liste
' springt, und beim Lesen folgt die Markierung dem Abschnitt, in dem man
' steht. Nach einem Klick bleibt die angeklickte Zeile markiert, bis der
' Text wirklich gerollt wird -- am Ende eines Dokuments laege sonst der
' obere Rand in einem frueheren Abschnitt, und die Markierung spraenge zurueck.
SUB hbInhaltNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winHandbuch) THEN RETURN
    DIM mass AS STRING : mass = STR$(GUI_WINDOW_GET_W(winHandbuch)) + "x" + STR$(GUI_WINDOW_GET_H(winHandbuch))
    IF mass <> hbMassStand THEN handbuchLayout()
    DIM k AS INTEGER : k = GUI_LISTBOX_SELECTED(lstHbInhalt)
    IF hbTrModus THEN
        IF k >= 0 AND k <> hbTrWahl AND k < LEN(hbTrZeile) THEN
            hbTrWahl = k
            IF hbTrZeile[k] > 0 THEN
                handbuchZeigen(hbTrDatei[k], hbTrZeile[k])
                GUI_RICHTEXT_MARK_ALL(rtHandbuch, hbTrNadel)
                protokoll("hbtreffer " + hbTrDatei[k] + " " + STR$(hbTrZeile[k]))
            END IF
        END IF
        RETURN
    END IF
    IF k >= 0 AND k <> hbInhaltWahl THEN
        hbMerken()
        GUI_RICHTEXT_GOTO_HEADING(rtHandbuch, k)
        hbInhaltWahl = k
        hbInhaltHalt = -2
        protokoll("hbinhalt sprung " + STR$(k))
        RETURN
    END IF
    DIM sc AS INTEGER : sc = GUI_RICHTEXT_SCROLL_GET(rtHandbuch)
    IF hbInhaltHalt = -2 THEN hbInhaltHalt = sc : RETURN
    IF hbInhaltHalt >= 0 AND sc = hbInhaltHalt THEN RETURN
    hbInhaltHalt = -1
    DIM a AS INTEGER : a = GUI_RICHTEXT_HEADING_AT(rtHandbuch)
    IF a <> hbInhaltWahl THEN
        hbInhaltWahl = a
        GUI_LISTBOX_SET_SELECTED(lstHbInhalt, a)
        IF a >= 0 THEN GUI_LISTBOX_SCROLL_TO(lstHbInhalt, a)
    END IF
END SUB

SUB handbuchZeigen(datei AS STRING, zeile AS INTEGER)
    handbuchDokumente()
    ' Ein anderes Dokument ist ein Schritt im Verlauf.
    IF docLetzteWahl >= 0 AND docLetzteWahl < LEN(docNamen) THEN
        IF docNamen[docLetzteWahl] <> datei THEN hbMerken()
    END IF
    handbuchLaden(datei, zeile)
END SUB

SUB handbuchLaden(datei AS STRING, zeile AS INTEGER)
    handbuchDokumente()
    DIM i AS INTEGER
    DIM k AS INTEGER : k = -1
    FOR i = 0 TO LEN(docNamen) - 1
        IF docNamen[i] = datei THEN k = i
    NEXT
    IF k < 0 THEN GUI_SET_TEXT(lblStatus, tr$("Kein Handbuch gefunden in ") + docsOrdner) : RETURN
    GUI_SET_TEXT(taHandbuch, dateiLesen(PATHJOIN(docsOrdner, datei)))
    GUI_DROPDOWN_SET_SELECTED(ddDoku, k)
    docLetzteWahl = k
    GUI_SET_TEXT(lblHbStand, "")
    handbuchLayout()
    GUI_WINDOW_VISIBLE(winHandbuch, TRUE)
    GUI_TEXTAREA_GOTO(taHandbuch, MAX(zeile, 1), 1)
    GUI_RICHTEXT_SET_TEXT(rtHandbuch, GUI_TEXT(taHandbuch))
    hbQuelleFaerben()
    IF NOT hbTrModus THEN hbInhaltFuellen()
    ' Die gesetzte Ansicht kennt keine Zeilennummern: gerollt wird zu dem,
    ' was in der Zeile STEHT. Das trifft die Stelle genauer als jede
    ' Umrechnung Zeile -> Punkte, denn wie hoch eine Zeile gesetzt wird,
    ' weiss nur der Satz.
    hbZuZeile(MAX(zeile, 1))
    handbuchAnsicht(hbGesetzt)
    GUI_FOCUS(taHandbuch)            ' holt das Fenster nach vorn
    protokoll("handbuch " + datei + " " + STR$(zeile))
END SUB

' F1: das Wort unter der Marke in allen Dokumenten suchen; das Dokument mit
' den meisten Fundstellen in Codeschrift (`WORT) gewinnt, sonst Klartext.
SUB handbuch()
    handbuchDokumente()
    IF LEN(docNamen) = 0 THEN GUI_SET_TEXT(lblStatus, tr$("Kein Handbuch gefunden in ") + docsOrdner) : RETURN
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF wort = "" THEN handbuchZeigen("README.md", 1) : RETURN
    DIM klein AS STRING : klein = LOWER$(wort)
    DIM besteDatei AS STRING : besteDatei = ""
    DIM besteZeile AS INTEGER : besteZeile = 1
    DIM besteZahl AS INTEGER : besteZahl = 0
    DIM d AS STRING
    FOR EACH d IN docNamen
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(docsOrdner, d))
        DIM zahl AS INTEGER : zahl = 0
        DIM erste AS INTEGER : erste = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            DIM lz AS STRING : lz = LOWER$(zeilen[i])
            IF LEFT$(lz, LEN(klein) + 3) = "| `" + klein THEN
                ' die Tabellenzeile, die den Befehl BESCHREIBT -- das Referenzdokument
                zahl = zahl + 10
                IF erste = 0 THEN erste = i + 1
            ELSEIF INSTR(lz, "`" + klein) >= 0 THEN
                zahl = zahl + 2
                IF erste = 0 THEN erste = i + 1
            ELSEIF INSTR(lz, klein) >= 0 THEN
                zahl = zahl + 1
                IF erste = 0 THEN erste = i + 1
            END IF
        NEXT
        IF zahl > besteZahl THEN besteZahl = zahl : besteDatei = d : besteZeile = erste
    NEXT
    IF besteDatei = "" THEN
        GUI_SET_TEXT(lblStatus, "'" + wort + tr$("' steht in keinem Dokument."))
        handbuchZeigen("README.md", 1)
        RETURN
    END IF
    GUI_SET_TEXT(tfHbSuche, wort)
    handbuchZeigen(besteDatei, besteZeile)
END SUB

' Einem Verweis im Handbuch folgen. Ein Dokument oeffnet das Handbuch, eine
' Sprungmarke rollt im selben, alles andere sagt nur, wohin es zeigt -- ein
' Klick, der wortlos nichts tut, sieht nach einem Fehler aus.
SUB handbuchVerweis(ziel AS STRING)
    DIM z AS STRING : z = ziel
    ' `docs/ide.md#abschnitt` -- die Marke abtrennen.
    DIM marke AS STRING : marke = ""
    DIM r AS INTEGER : r = INSTR(z, "#")
    IF r >= 0 THEN
        marke = MID$(z, r + 1, LEN(z))
        z = LEFT$(z, r)
    END IF
    IF z = "" THEN
        ' Nur eine Marke: im selben Dokument suchen. Die Marken von Markdown
        ' sind kleingeschrieben und mit Strichen -- gesucht wird nach der
        ' Ueberschrift, also mit Leerzeichen.
        hbMerken()
        hbZurMarke(marke)
        RETURN
    END IF
    DIM name AS STRING : name = BASENAME(z)
    IF RIGHT$(LOWER$(name), 3) = ".md" AND FILEEXISTS(PATHJOIN(docsOrdner, name)) THEN
        handbuchZeigen(name, 1)
        IF marke <> "" THEN hbZurMarke(marke)
        RETURN
    END IF
    GUI_SET_TEXT(lblHbStand, tr$("Verweis: ") + ziel)
    protokoll("hbverweis " + ziel)
END SUB

' Die Sprungmarke einer Ueberschrift, wie GitHub sie bildet: klein,
' Leerzeichen werden Striche, Satzzeichen fallen weg (Buchstaben samt
' Umlauten, Ziffern, `-` und `_` bleiben). Aus "Sprite-Atlas + Batch-Draw"
' wird "sprite-atlas--batch-draw" -- zwei Striche, weil beide Leerzeichen
' bleiben und nur das Plus wegfaellt.
FUNCTION hbMarke$(titel AS STRING) AS STRING
    DIM t AS STRING : t = LOWER$(TRIM$(titel))
    DIM raus AS STRING : raus = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(t) - 1
        DIM c AS STRING : c = MID$(t, i, 1)
        IF c = " " THEN
            raus = raus + "-"
        ELSEIF c = "-" OR c = "_" OR (c >= "0" AND c <= "9") OR UPPER$(c) <> c THEN
            raus = raus + c
        END IF
    NEXT
    RETURN raus
END FUNCTION

' Zu einer Sprungmarke rollen: die Ueberschrift, deren Marke genau passt.
' Bis 2026-09-27 suchte das den Text der Marke mit Leerzeichen statt
' Strichen -- und traf die ERSTE Stelle, an der er stand, oft die Zeile im
' Inhaltsverzeichnis oben statt der Ueberschrift. Gibt es keine passende
' Ueberschrift (eine Marke von Hand im Text), bleibt es bei der Suche.
SUB hbZurMarke(marke AS STRING)
    DIM titel AS ARRAY OF STRING : titel = GUI_RICHTEXT_HEADINGS(rtHandbuch)
    DIM gesucht AS STRING : gesucht = LOWER$(marke)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(titel) - 1
        IF hbMarke$(titel[i]) = gesucht THEN
            GUI_RICHTEXT_GOTO_HEADING(rtHandbuch, i)
            protokoll("hbmarke " + marke + " " + STR$(i))
            RETURN
        END IF
    NEXT
    GUI_RICHTEXT_FIND(rtHandbuch, REPLACE$(marke, "-", " "), -1)
    protokoll("hbmarke " + marke + " suche")
END SUB

' Weiter- und zuruecksuchen, mit Umlauf. In der gesetzten Ansicht sucht das
' Widget selbst (es allein kennt seinen Satz), markiert die Fundstelle und
' hebt alle anderen schwach hervor -- seit Stand 29; davor rollte es nur zur
' ersten, und wer die dritte wollte, musste scrollen.
SUB handbuchSuchen(vorwaerts AS BOOLEAN)
    DIM gesucht AS STRING : gesucht = GUI_TEXT(tfHbSuche)
    IF gesucht = "" THEN GUI_RICHTEXT_MARK_ALL(rtHandbuch, "") : RETURN
    IF hbGesetzt THEN
        DIM anzahl AS INTEGER : anzahl = GUI_RICHTEXT_MARK_ALL(rtHandbuch, gesucht)
        DIM y AS INTEGER
        IF vorwaerts THEN
            y = GUI_RICHTEXT_FIND_NEXT(rtHandbuch, gesucht)
        ELSE
            y = GUI_RICHTEXT_FIND_PREV(rtHandbuch, gesucht)
        END IF
        IF y < 0 THEN GUI_SET_TEXT(lblHbStand, "'" + gesucht + tr$("' nicht in diesem Dokument")) : RETURN
        GUI_SET_TEXT(lblHbStand, docNamen[docLetzteWahl] + " -- " + STR$(anzahl) + tr$(" Fundstellen"))
        protokoll("hbsuche " + STR$(y) + " " + STR$(anzahl) + " " + GUI_RICHTEXT_SELECTION$(rtHandbuch))
        RETURN
    END IF
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(taHandbuch)
    DIM tz AS INTEGER : tz = -1
    DIM ts AS INTEGER
    IF vorwaerts THEN
        (tz, ts) = GUI_TEXTAREA_FIND(taHandbuch, gesucht, z, s + 1)
        IF tz < 0 THEN (tz, ts) = GUI_TEXTAREA_FIND(taHandbuch, gesucht, 1, 1)
    ELSE
        ' Rueckwaerts: die letzte Fundstelle VOR der Auswahl, sonst die letzte
        ' ueberhaupt. GUI_TEXTAREA_FIND kennt nur eine Richtung.
        DIM az AS INTEGER
        DIM as1 AS INTEGER
        DIM ez AS INTEGER
        DIM es AS INTEGER
        (az, as1, ez, es) = GUI_TEXTAREA_SELECTION_RANGE(taHandbuch)
        IF az < 0 THEN az = z : as1 = s
        DIM fz AS INTEGER
        DIM fs AS INTEGER
        DIM lz AS INTEGER : lz = -1
        DIM ls AS INTEGER
        (fz, fs) = GUI_TEXTAREA_FIND(taHandbuch, gesucht, 1, 1)
        DIM erste AS BOOLEAN : erste = TRUE
        WHILE fz > 0
            IF NOT erste AND fz = lz AND fs = ls THEN BREAK
            erste = FALSE
            IF fz < az OR (fz = az AND fs < as1) THEN tz = fz : ts = fs
            lz = fz : ls = fs
            DIM nz AS INTEGER
            DIM ns AS INTEGER
            (nz, ns) = GUI_TEXTAREA_FIND(taHandbuch, gesucht, fz, fs + 1)
            IF nz < fz OR (nz = fz AND ns <= fs) THEN BREAK
            fz = nz : fs = ns
        WEND
        IF tz < 0 THEN tz = lz : ts = ls
    END IF
    IF tz < 0 THEN GUI_SET_TEXT(lblHbStand, "'" + gesucht + tr$("' nicht in diesem Dokument")) : RETURN
    GUI_TEXTAREA_GOTO(taHandbuch, tz, ts)
    GUI_TEXTAREA_SELECT(taHandbuch, tz, ts, tz, ts + LEN(gesucht))
    GUI_SET_TEXT(lblHbStand, docNamen[docLetzteWahl] + tr$(" -- Zeile ") + STR$(tz))
END SUB

' --- Listing drucken / als PDF (pdf-Modul) -----------------------------
' Die Optionen aus dem Druckdialog uebernehmen und merken -- auch die PDF
' daneben nimmt sie, ob der Dialog offen war oder nicht.
SUB druckOptionenLesen()
    druckGroesse = MAX(6, MIN(16, INT(GUI_VALUE(spDruckGr))))
    druckRand = MAX(10, MIN(40, INT(GUI_VALUE(spDruckRand))))
    druckNummern = GUI_CHECKED(cbDruckNr)
    konfigSichern()
END SUB

' Das Listing als PDF. Schrift, Rand und Zeilennummern aus den
' Druckoptionen; `nurAuswahl` nimmt die ganzen Zeilen der Auswahl (mit
' ihren echten Nummern). Mit den Vorgaben (9 pt, 20 mm) ist es genau das
' Listing von vorher: 66 Zeilen je Seite, 3,9 mm Abstand.
FUNCTION listingPdf(nurAuswahl AS BOOLEAN) AS PDF
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    DIM name AS STRING : name = "Unbenannt"
    IF tabPfade[aktiverTab] <> "" THEN name = BASENAME(tabPfade[aktiverTab])
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM von AS INTEGER : von = 0
    DIM bis AS INTEGER : bis = LEN(zeilen) - 1
    IF nurAuswahl AND GUI_TEXTAREA_SELECTION$(ta) <> "" THEN
        DIM z1 AS INTEGER
        DIM s1 AS INTEGER
        DIM z2 AS INTEGER
        DIM s2 AS INTEGER
        (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
        ' Endet die Auswahl in Spalte 1 einer Zeile, gehoert die nicht dazu.
        IF s2 = 1 AND z2 > z1 THEN z2 = z2 - 1
        von = z1 - 1 : bis = z2 - 1
        name = name + " (Zeilen " + STR$(z1) + "-" + STR$(z2) + ")"
    END IF
    DIM p AS PDF : p = PDF_NEW()
    PDF_TITLE(p, name)
    DIM rand AS FLOAT : rand = druckRand
    DIM zeilenH AS FLOAT : zeilenH = druckGroesse * 3.9 / 9.0
    PDF_FONT(p, "courier", druckGroesse)
    ' Eine Monospace-Schrift: ein Zeichen misst so viel wie jedes andere.
    DIM zeichenB AS FLOAT : zeichenB = PDF_TEXT_WIDTH(p, "M")
    DIM vorB AS INTEGER : vorB = IIF(druckNummern, 7, 0)
    DIM breite AS INTEGER : breite = MAX(20, INT((210.0 - 2.0 * rand) / zeichenB) - vorB)
    DIM jeSeite AS INTEGER : jeSeite = MAX(10, INT((297.0 - 2.0 * rand) / zeilenH) + 1)
    DIM reihe AS INTEGER : reihe = jeSeite
    DIM seite AS INTEGER : seite = 0
    DIM i AS INTEGER
    FOR i = von TO bis
        DIM rest AS STRING : rest = REPLACE$(zeilen[i], CHR$(9), "    ")
        DIM nummer AS STRING : nummer = RIGHT$("     " + STR$(i + 1), 5)
        DIM ersteHaelfte AS BOOLEAN : ersteHaelfte = TRUE
        REPEAT
            IF reihe >= jeSeite THEN
                ' PDF_NEW bringt die erste Seite schon mit -- ein PDF_PAGE davor
                ' liesse ein leeres Blatt vorn (so war es zuerst).
                IF seite > 0 THEN PDF_PAGE(p)
                seite = seite + 1
                PDF_FONT(p, "helvetica", 9)
                PDF_TEXT(p, rand, rand - 8.0, name + "   Seite " + STR$(seite))
                PDF_LINE(p, rand, rand - 5.0, 210.0 - rand, rand - 5.0)
                PDF_FONT(p, "courier", druckGroesse)
                reihe = 0
            END IF
            DIM stueck AS STRING : stueck = LEFT$(rest, breite)
            rest = MID$(rest, LEN(stueck))
            DIM vorspann AS STRING : vorspann = ""
            IF druckNummern THEN vorspann = IIF(ersteHaelfte, nummer + "  ", "       ")
            TRY
                PDF_TEXT(p, rand, rand + 2.0 + reihe * zeilenH, vorspann + stueck)
            CATCH e
                ' Ein Zeichen, das die Schrift nicht hat -- die Zeile kommt gekennzeichnet.
                PDF_TEXT(p, rand, rand + 2.0 + reihe * zeilenH, vorspann + "[Zeile mit einem Zeichen, das die Schrift nicht hat]")
            END TRY
            reihe = reihe + 1
            ersteHaelfte = FALSE
        UNTIL rest = ""
    NEXT
    protokoll("listing " + STR$(bis - von + 1) + " zeilen " + STR$(seite) + " seiten je " + STR$(jeSeite) + " breite " + STR$(breite))
    RETURN p
END FUNCTION

SUB listingAlsPdf()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, tr$("Erst sichern -- die PDF kommt neben die Quelle.")) : RETURN
    DIM ziel AS STRING : ziel = pfad
    IF LOWER$(RIGHT$(ziel, 3)) = ".dh" THEN ziel = LEFT$(ziel, LEN(ziel) - 3)
    ziel = ziel + ".pdf"
    DIM p AS PDF : p = listingPdf(FALSE)
    PDF_SAVE(p, ziel)
    GUI_SET_TEXT(lblStatus, tr$("PDF geschrieben: ") + ziel + " (" + STR$(PDF_PAGE_COUNT(p)) + tr$(" Seiten)"))
    PDF_CLOSE(p)
    protokoll("pdf " + ziel)
END SUB

' Strg+P oeffnet den Druckdialog: Drucker (Standard vorgewaehlt), Kopien,
' oder doch als PDF. Ohne Drucker gibt es gleich den PDF-Weg.
SUB listingDrucken()
    IF aktiverTab < 0 THEN RETURN
    druckerNamen = PRINTERS()
    IF LEN(druckerNamen) = 0 THEN GUI_SET_TEXT(lblStatus, tr$("Kein Drucker eingerichtet -- nimm 'Listing als PDF'.")) : RETURN
    GUI_SET_DROPDOWN(ddDrucker, druckerNamen)
    DIM k AS INTEGER : k = ARRAY_INDEXOF(druckerNamen, PRINTER_DEFAULT$())
    GUI_DROPDOWN_SET_SELECTED(ddDrucker, MAX(k, 0))
    ' "Nur die Auswahl" gibt es nur, wenn etwas ausgewaehlt ist.
    DIM hatAuswahl AS BOOLEAN : hatAuswahl = GUI_TEXTAREA_SELECTION$(aktivesFeld()) <> ""
    GUI_SET_ENABLED(cbDruckAuswahl, hatAuswahl)
    GUI_SET_CHECKED(cbDruckAuswahl, hatAuswahl AND GUI_CHECKED(cbDruckAuswahl))
    GUI_WINDOW_SET_BOUNDS(winDruck, (SCREENWIDTH() - 400) \ 2, (SCREENHEIGHT() - 270) \ 2, 400, 270)
    GUI_WINDOW_VISIBLE(winDruck, TRUE)
    GUI_FOCUS(btnDruckOk)              ' holt das Fenster nach vorn
END SUB

SUB druckenAusfuehren()
    GUI_WINDOW_VISIBLE(winDruck, FALSE)
    IF aktiverTab < 0 THEN RETURN
    DIM sel AS INTEGER : sel = GUI_DROPDOWN_SELECTED(ddDrucker)
    IF sel < 0 OR sel >= LEN(druckerNamen) THEN RETURN
    DIM drucker AS STRING : drucker = druckerNamen[sel]
    DIM kopien AS INTEGER : kopien = MAX(1, INT(GUI_VALUE(spKopien)))
    druckOptionenLesen()
    DIM p AS PDF : p = listingPdf(GUI_CHECKED(cbDruckAuswahl))
    TRY
        PDF_PRINT(p, drucker, kopien)
        GUI_SET_TEXT(lblStatus, tr$("Gedruckt auf ") + drucker + " (" + STR$(PDF_PAGE_COUNT(p)) + tr$(" Seiten, ") + STR$(kopien) + "x)")
        protokoll("gedruckt " + drucker + " " + STR$(kopien))
    CATCH e
        GUI_SET_TEXT(lblStatus, tr$("Drucken: ") + e)
    END TRY
    PDF_CLOSE(p)
    GUI_FOCUS(aktivesFeld())
END SUB

' Strg+F1: alle Befehle mit Kuerzel im Handbuch-Fenster.
SUB kuerzelZeigen()
    ' Als Markdown-Tabelle: so steht sie auch in der gesetzten Ansicht da
    ' (bis 2026-09-26 kam sie nur ins Quelltext-Feld und die gesetzte Ansicht
    ' zeigte weiter das vorige Dokument).
    DIM text AS STRING : text = tr$("# Tastenkürzel der IDE") + NL + NL + tr$("| Kürzel | Befehl |") + NL + "|---|---|" + NL
    DIM i AS INTEGER
    FOR i = 0 TO LEN(befehlNamen) - 1
        IF befehlKuerzel[i] <> "" THEN text = text + "| `" + befehlKuerzel[i] + "` | " + befehlNamen[i] + " |" + NL
    NEXT
    text = text + NL + tr$("## Im Code-Feld") + NL + NL + tr$("Tab rückt bis zur nächsten Spalte ein, Strg+Z/Y nimmt zurück und wiederholt, Strg+A/C/V/X wie üblich, Pos1/Ende, Bild auf/ab.") + NL + NL
    text = text + tr$("Alle Befehle ohne Kürzel stehen in der Befehlspalette (`Strg+Umschalt+P`).") + NL
    GUI_SET_TEXT(taHandbuch, text)
    GUI_RICHTEXT_SET_TEXT(rtHandbuch, text)
    hbInhaltFuellen()
    GUI_SET_TEXT(lblHbStand, tr$("Tastenkürzel"))
    handbuchLayout()
    GUI_WINDOW_VISIBLE(winHandbuch, TRUE)
    GUI_TEXTAREA_GOTO(taHandbuch, 1, 1)
    GUI_FOCUS(taHandbuch)
    protokoll("kuerzel " + STR$(LEN(befehlNamen)))
END SUB

' --- Werkzeuge: die Begleit-Editoren in Drachenhauch --------------------
SUB werkzeugStarten(datei AS STRING)
    werkzeugMit(datei, "")
END SUB

' Ein Werkzeug mit einer Datei starten (`dhrt run werkzeug -- datei`).
SUB werkzeugMit(datei AS STRING, arg AS STRING)
    DIM pfad AS STRING : pfad = PATHJOIN(beispielOrdner, datei)
    IF NOT FILEEXISTS(pfad) THEN
        GUI_SET_TEXT(lblStatus, tr$("Nicht gefunden: ") + pfad)
        protokoll("werkzeug fehlt " + datei)
        RETURN
    END IF
    IF arg = "" THEN
        ARRAY_PUSH(werkzeuge, PROCESS_START("dhrt", "run", pfad))
        GUI_SET_TEXT(lblStatus, tr$("Gestartet: ") + datei)
        protokoll("werkzeug " + datei)
    ELSE
        ARRAY_PUSH(werkzeuge, PROCESS_START("dhrt", "run", pfad, "--", arg))
        protokoll("werkzeug " + datei + " " + BASENAME(arg))
    END IF
END SUB

' Befehlspalette: das zuletzt im Designer geoeffnete Formular als Text.
SUB formularAlsText()
    IF letzteForm = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Noch kein Formular geöffnet -- erst eine .dhform im Projektbaum wählen."))
        RETURN
    END IF
    formAlsText = TRUE
    dateiOeffnen(letzteForm)
    formAlsText = FALSE
END SUB

SUB werkzeugeAufraeumen()
    DIM i AS INTEGER : i = 0
    WHILE i < LEN(werkzeuge)
        IF PROCESS_RUNNING(werkzeuge[i]) THEN
            i = i + 1
        ELSE
            PROCESS_CLOSE(werkzeuge[i])
            ARRAY_REMOVE_AT(werkzeuge, i)
        END IF
    WEND
END SUB

' Die Beschreibung eines Beispiels aus seinem Kopfkommentar: die erste
' Kommentarzeile mit Buchstaben in den ersten acht Zeilen -- ohne Zierlinien
' (`' =====`), ohne `=== ... ===`, ohne ein vorangestelltes `DRACHENHAUCH --`,
' den Dateinamen oder die Nummer. Bricht sie mitten im Satz ab, kommt die
' naechste Kommentarzeile dazu (hoechstens zwei); was ueber 100 Zeichen
' geht, endet am letzten Satz- oder Kommaende davor. Interne Vermerke wie
' `(WP H)`, `(Batch 1)` oder `(Weg B, ...)` sagen einem Leser nichts.
FUNCTION kopfZeile$(zeile AS STRING) AS STRING
    DIM z AS STRING : z = TRIM$(zeile)
    IF LEFT$(z, 1) <> "'" THEN RETURN ""
    z = TRIM$(MID$(z, 1, LEN(z)))
    z = REGEX_REPLACE(z, "\s+", " ")
    WHILE LEFT$(z, 1) = "=" OR LEFT$(z, 1) = "-" : z = TRIM$(MID$(z, 1, LEN(z))) : WEND
    WHILE RIGHT$(z, 1) = "=" : z = TRIM$(LEFT$(z, LEN(z) - 1)) : WEND
    IF NOT REGEX_TEST(z, "[A-Za-zÄÖÜäöüß]") THEN RETURN ""
    RETURN z
END FUNCTION

FUNCTION beispielBeschreibung$(pfad AS STRING, datei AS STRING) AS STRING
    DIM zeilen AS ARRAY OF STRING
    TRY
        zeilen = READLINES(pfad)
    CATCH e
        RETURN datei
    END TRY
    DIM stamm AS STRING : stamm = LEFT$(datei, LEN(datei) - 3)
    DIM nummer AS STRING : nummer = LEFT$(stamm, MAX(0, INSTR(stamm, "_")))
    DIM i AS INTEGER
    FOR i = 0 TO MIN(LEN(zeilen), 8) - 1
        DIM z AS STRING : z = kopfZeile$(zeilen[i])
        IF z = "" THEN CONTINUE
        IF UPPER$(LEFT$(z, 16)) = "DRACHENHAUCH -- " THEN z = TRIM$(MID$(z, 16, LEN(z)))
        DIM vor AS STRING
        FOR EACH vor IN [datei + " -- ", datei + " - ", nummer + " -- ", nummer + " - "]
            IF vor <> " -- " AND vor <> " - " AND LEFT$(z, LEN(vor)) = vor THEN z = TRIM$(MID$(z, LEN(vor), LEN(z)))
        NEXT
        IF z = datei OR z = "" THEN CONTINUE
        ' Fortsetzung: nur eine Kommentarzeile mit Text gleich dahinter (ein
        ' eingerueckter Block wie eine Befehlsliste zaehlt nicht).
        DIM dazu AS INTEGER : dazu = 0
        WHILE dazu < 2 AND i + 1 + dazu < LEN(zeilen) AND NOT REGEX_TEST(z, "[.:!?)" + CHR$(34) + "]$")
            DIM roh AS STRING : roh = zeilen[i + 1 + dazu]
            IF LEFT$(roh, 2) <> "' " OR MID$(roh, 2, 1) = " " THEN EXIT WHILE
            DIM weiter AS STRING : weiter = kopfZeile$(roh)
            IF weiter = "" THEN EXIT WHILE
            ' Nur, wo der Satz sichtlich weitergeht -- ein Titel ohne Punkt
            ' ("Coin Quest") nimmt sonst die naechste Zeile mit, die etwas
            ' ganz anderes sagt.
            DIM offen AS BOOLEAN : offen = LEN(z) - LEN(REPLACE$(z, "(", "")) > LEN(z) - LEN(REPLACE$(z, ")", ""))
            IF NOT (RIGHT$(z, 1) = "-" OR RIGHT$(z, 1) = "," OR offen OR REGEX_TEST(weiter, "^[a-zäöü]")) THEN EXIT WHILE
            ' Am Zeilenende getrenntes Wort (`Hindernis-` / `Boxen`) ohne Leerzeichen.
            IF REGEX_TEST(z, "[A-Za-zÄÖÜäöüß]-$") THEN z = z + weiter ELSE z = z + " " + weiter
            dazu = dazu + 1
        WEND
        z = REGEX_REPLACE(z, "\s*\((WP [A-Z][^)]*|Batch [^)]*|Weg B[^)]*|[a-z]+ter Editor-Pilot|sechster Pilot)\)", "")
        IF LEN(z) > 100 THEN
            DIM satz AS INTEGER : satz = -1
            DIM komma AS INTEGER : komma = -1
            DIM k AS INTEGER
            FOR k = 20 TO 99
                ' Ein Satzende, keine Abkuerzung: vor dem Punkt zwei Buchstaben
                ' (`z.B.` endet nichts).
                IF MID$(z, k, 2) = ". " AND REGEX_TEST(MID$(z, k - 2, 2), "^[A-Za-zÄÖÜäöüß]{2}$") THEN satz = k
                IF MID$(z, k, 2) = ", " THEN komma = k
            NEXT
            IF satz > 0 THEN
                z = LEFT$(z, satz + 1)
            ELSEIF komma > 0 THEN
                z = LEFT$(z, komma)
            ELSE
                z = LEFT$(z, 97) + "..."
            END IF
        END IF
        WHILE RIGHT$(z, 1) = "," OR RIGHT$(z, 1) = ";" : z = TRIM$(LEFT$(z, LEN(z) - 1)) : WEND
        ' Eine offene Klammer am Ende (die Fortsetzung kam nicht mit): weg damit.
        DIM auf AS INTEGER : auf = LEN(z) - LEN(REPLACE$(z, "(", ""))
        DIM zu AS INTEGER : zu = LEN(z) - LEN(REPLACE$(z, ")", ""))
        IF auf > zu THEN
            DIM ab AS INTEGER : ab = -1
            DIM q AS INTEGER
            FOR q = 0 TO LEN(z) - 2
                IF MID$(z, q, 2) = " (" THEN ab = q
            NEXT
            IF ab > 0 THEN z = TRIM$(LEFT$(z, ab))
        END IF
        RETURN TRIM$(z)
    NEXT
    RETURN stamm
END FUNCTION

SUB themenZeigen()
    DIM k AS JSON_HANDLE
    DIM gut AS BOOLEAN : gut = TRUE
    TRY
        k = JSON_PARSE("{" + CHR$(34) + "t" + CHR$(34) + ": " + JOIN$(READLINES(PATHJOIN(beispielOrdner, "kategorien.json")), NL) + "}")
    CATCH e
        gut = FALSE
    END TRY
    IF NOT gut THEN
        GUI_SET_TEXT(lblStatus, tr$("Keine Themenliste: ") + PATHJOIN(beispielOrdner, "kategorien.json") + tr$(" fehlt."))
        protokoll("themen fehlen")
        RETURN
    END IF
    GUI_LISTBOX_CLEAR(lstThemen)
    DIM themen AS INTEGER : themen = JSON_LEN(k, "t")
    DIM zahl AS INTEGER : zahl = 0
    DIM t AS INTEGER
    FOR t = 0 TO themen - 1
        DIM pt AS STRING : pt = "t." + STR$(t)
        DIM n AS INTEGER : n = JSON_LEN(k, pt + ".dateien")
        DIM kopf AS INTEGER : kopf = GUI_LISTBOX_ADD(lstThemen, JSON_GET_STRING(k, pt + ".name"))
        GUI_LISTBOX_HEADER(lstThemen, kopf, TRUE)
        DIM d AS INTEGER
        FOR d = 0 TO n - 1
            DIM datei AS STRING : datei = JSON_GET_STRING(k, pt + ".dateien." + STR$(d))
            DIM pfad AS STRING : pfad = PATHJOIN(beispielOrdner, datei)
            ' Eine Liste, die auf fehlende Dateien zeigt, wird nicht zur Falle:
            ' was es nicht gibt, steht nicht da.
            IF NOT FILEEXISTS(pfad) THEN CONTINUE
            DIM ix AS INTEGER : ix = GUI_LISTBOX_ADD(lstThemen, beispielBeschreibung$(pfad, datei))
            GUI_LISTBOX_DETAIL(lstThemen, ix, LEFT$(datei, LEN(datei) - 3))
            GUI_LISTBOX_SET_DATA(lstThemen, ix, datei)
            GUI_LISTBOX_TIP(lstThemen, ix, datei)
            zahl = zahl + 1
        NEXT
        GUI_LISTBOX_DETAIL(lstThemen, kopf, STR$(n))
    NEXT
    GUI_SET_TEXT(tfThemenFilter, "")
    themenFilterZuletzt = ""
    GUI_LISTBOX_FILTER(lstThemen, "")
    GUI_SET_TEXT(lblThemen, STR$(zahl) + tr$(" Beispiele in ") + STR$(themen) + tr$(" Themen"))
    GUI_WINDOW_SET_BOUNDS(winThemen, MAX(0, (SCREENWIDTH() - 760) \ 2), 80, 760, 620)
    GUI_WINDOW_VISIBLE(winThemen, TRUE)
    GUI_FOCUS(tfThemenFilter)          ' holt das Fenster nach vorn
    protokoll("themen " + STR$(themen) + " beispiele " + STR$(zahl))
END SUB

' Je Bild, solange das Fenster offen ist: Filter, Oeffnen, Starten.
SUB themenNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winThemen) THEN RETURN
    DIM f AS STRING : f = TRIM$(GUI_TEXT(tfThemenFilter))
    IF f <> themenFilterZuletzt THEN
        themenFilterZuletzt = f
        GUI_LISTBOX_FILTER(lstThemen, f)
        protokoll("themen filter [" + f + "] " + STR$(GUI_LISTBOX_VIEW_COUNT(lstThemen)))
    END IF
    ' Enter im Filterfeld nimmt den ersten Treffer.
    IF GUI_ENTERED(tfThemenFilter) THEN
        DIM v AS INTEGER
        FOR v = 0 TO GUI_LISTBOX_VIEW_COUNT(lstThemen) - 1
            DIM zeile AS INTEGER : zeile = GUI_LISTBOX_VIEW_ROW(lstThemen, v)
            IF GUI_LISTBOX_DATA$(lstThemen, zeile) <> "" THEN
                GUI_LISTBOX_SET_SELECTED(lstThemen, zeile)
                themenOeffnen(FALSE)
                RETURN
            END IF
        NEXT
    END IF
    IF GUI_DOUBLE_CLICKED(lstThemen) OR GUI_CLICKED(btnThemenOeffnen) THEN themenOeffnen(FALSE)
    IF GUI_CLICKED(btnThemenStart) THEN themenOeffnen(TRUE)
    IF GUI_CLICKED(btnThemenZu) THEN GUI_WINDOW_VISIBLE(winThemen, FALSE)
END SUB

SUB themenOeffnen(starten AS BOOLEAN)
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstThemen)
    IF sel < 0 THEN RETURN
    DIM datei AS STRING : datei = GUI_LISTBOX_DATA$(lstThemen, sel)
    IF datei = "" THEN RETURN          ' ein Themenkopf
    GUI_WINDOW_VISIBLE(winThemen, FALSE)
    dateiOeffnen(PATHJOIN(beispielOrdner, datei))
    protokoll("themen offen " + datei)
    IF starten THEN befehl("start")
END SUB

SUB beispieleOeffnen()
    IF NOT FILEEXISTS(PATHJOIN(beispielOrdner, "01_hello.dh")) THEN
        GUI_SET_TEXT(lblStatus, tr$("Keine Beispiele in ") + beispielOrdner)
        RETURN
    END IF
    projektOrdner = beispielOrdner
    baumFuellen()
    GUI_SET_TEXT(lblStatus, tr$("Projekt: ") + beispielOrdner)
    protokoll("projekt " + projektOrdner)
END SUB

' --- Menue und Befehl: EINE Tafel (seit 2026-09-29) -----------------------
' Jeder Menuepunkt, der einen Befehl ruft, steht hier mit seiner Kennung und
' dem Kuerzel, mit dem er angelegt wurde. Aus derselben Tafel feuern die
' Klicks (menueKlicks) und liest die eigene Tastenbelegung, welcher
' Menuepunkt zu einem Befehl gehoert -- bis dahin standen 136 einzelne
' IF-Zeilen in der Bildschleife, und ein Kuerzel liess sich nur im
' Quelltext aendern. `klickt` = FALSE: der Klick wird woanders abgefragt
' (zusammen mit einem Knopf), der Punkt steht nur fuers Kuerzel hier.
DIM menueItems AS ARRAY OF INTEGER : menueItems = []
DIM menueKennung AS ARRAY OF STRING : menueKennung = []
DIM menueVorgabe AS ARRAY OF STRING : menueVorgabe = []
DIM menueJetzt AS ARRAY OF STRING : menueJetzt = []
DIM menueKlickt AS ARRAY OF BOOLEAN : menueKlickt = []

SUB menueBefehl(item AS INTEGER, kennung AS STRING, kuerzel AS STRING, klickt AS BOOLEAN = TRUE)
    ARRAY_PUSH(menueItems, item)
    ARRAY_PUSH(menueKennung, kennung)
    ARRAY_PUSH(menueVorgabe, kuerzel)
    ARRAY_PUSH(menueJetzt, kuerzel)
    ARRAY_PUSH(menueKlickt, klickt)
END SUB

SUB menueKlicks()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(menueItems) - 1
        IF menueKlickt[i] THEN
            IF GUI_CLICKED(menueItems[i]) THEN befehl(menueKennung[i])
        END IF
    NEXT
END SUB

' --- Eigene Tastenbelegung (tasten.json neben der ide.json) --------------
' Die Datei nennt nur, was ANDERS ist: {"kennung": "Strg+Alt+K", ...}, leer
' heisst "kein Kuerzel". Geht ein Kuerzel an einen Befehl, der es nicht
' hatte, verliert es der, dem es vorher gehoerte -- zwei Befehle auf einer
' Taste feuerten beide, und welcher gewinnt, saehe man nicht.
DIM befehlKuerzelVorgabe AS ARRAY OF STRING : befehlKuerzelVorgabe = []
DIM tastenMeldungen AS ARRAY OF STRING : tastenMeldungen = []
DIM tastenKennung AS STRING : tastenKennung = ""

' Der Ordner der ide.json -- "." bei einem Pfad ohne Ordner (die Tests
' setzen DH_IDE_KONFIG=ide.json), sonst liefe MKDIR("") in einen Fehler.
FUNCTION konfigOrdner$() AS STRING
    DIM d AS STRING : d = DIRNAME(konfigPfad)
    IF d = "" THEN d = "."
    IF NOT DIREXISTS(d) THEN MKDIR(d)
    RETURN d
END FUNCTION

FUNCTION tastenPfad$() AS STRING
    RETURN PATHJOIN(konfigOrdner$(), "tasten.json")
END FUNCTION

' Zwei Schreibweisen desselben Kuerzels ("Umschalt+Strg+K", "ctrl+shift+k")
' sind dasselbe Kuerzel -- verglichen wird in dieser einen Form.
FUNCTION kuerzelForm$(k AS STRING) AS STRING
    DIM t AS STRING : t = LOWER$(REPLACE$(TRIM$(k), " ", ""))
    IF t = "" THEN RETURN ""
    IF RIGHT$(t, 2) = "++" THEN t = LEFT$(t, LEN(t) - 2) + "+plus"
    IF t = "+" THEN t = "plus"
    DIM teile AS ARRAY OF STRING : teile = SPLIT$(t, "+")
    DIM taste AS STRING : taste = teile[LEN(teile) - 1]
    IF taste = "-" THEN taste = "minus"
    IF taste = "space" OR taste = "leertaste" THEN taste = "leer"
    IF taste = "del" OR taste = "delete" THEN taste = "entf"
    ' Englische Tastennamen wie die Anzeige auf Englisch (kz$) sie schreibt.
    SELECT CASE taste
        CASE "up" : taste = "hoch"
        CASE "down" : taste = "runter"
        CASE "left" : taste = "links"
        CASE "right" : taste = "rechts"
        CASE "home" : taste = "pos1"
        CASE "end" : taste = "ende"
        CASE "ins", "insert" : taste = "einfg"
        CASE "pageup" : taste = "bildauf"
        CASE "pagedown" : taste = "bildab"
        CASE "backspace" : taste = "rueck"
        CASE "escape" : taste = "esc"
        CASE "return" : taste = "enter"
    END SELECT
    DIM strg AS BOOLEAN : strg = FALSE
    DIM alt AS BOOLEAN : alt = FALSE
    DIM ums AS BOOLEAN : ums = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(teile) - 2
        DIM m AS STRING : m = teile[i]
        IF m = "strg" OR m = "ctrl" OR m = "control" THEN strg = TRUE
        IF m = "alt" THEN alt = TRUE
        IF m = "umschalt" OR m = "shift" THEN ums = TRUE
    NEXT
    RETURN IIF(strg, "strg+", "") + IIF(alt, "alt+", "") + IIF(ums, "umschalt+", "") + taste
END FUNCTION

SUB tastenMelden(m AS STRING)
    ARRAY_PUSH(tastenMeldungen, m)
    ausgabe("Tastenbelegung: " + m)
    protokoll("tasten meldung " + m)
END SUB

' Alles auf die Vorgabe, dann die Datei darueber. Ohne das Zuruecksetzen
' bliebe ein Kuerzel stehen, das aus der Datei gestrichen wurde.
SUB tastenAnwenden()
    tastenMeldungen = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(menueItems) - 1
        IF menueJetzt[i] <> menueVorgabe[i] THEN
            GUI_MENU_SHORTCUT(menueItems[i], kz$(menueVorgabe[i]))
            menueJetzt[i] = menueVorgabe[i]
        END IF
    NEXT
    FOR i = 0 TO LEN(befehlKuerzel) - 1
        befehlKuerzel[i] = befehlKuerzelVorgabe[i]
    NEXT
    DIM gesetzt AS INTEGER : gesetzt = 0
    IF FILEEXISTS(tastenPfad$()) THEN
        DIM j AS JSON_HANDLE
        DIM gelesen AS BOOLEAN : gelesen = TRUE
        TRY
            j = JSON_LOAD(tastenPfad$())
        CATCH e
            gelesen = FALSE
            tastenMelden("tasten.json lässt sich nicht lesen: " + e)
        END TRY
        IF gelesen THEN
            DIM k AS STRING
            FOR EACH k IN JSON_KEYS(j, "")
                IF JSON_TYPE(j, k) <> "string" THEN
                    tastenMelden(k + ": das Kürzel muss als Text stehen, z. B. " + CHR$(34) + "Strg+Alt+K" + CHR$(34))
                ELSEIF tastenEins(k, TRIM$(JSON_GET_STRING(j, k))) THEN
                    gesetzt = gesetzt + 1
                END IF
            NEXT
        END IF
    END IF
    protokoll("tasten angewendet " + STR$(gesetzt) + " " + STR$(LEN(tastenMeldungen)))
    IF LEN(tastenMeldungen) > 0 THEN GUI_SET_TEXT(lblStatus, tr$("Tastenbelegung: ") + STR$(LEN(tastenMeldungen)) + tr$(" Hinweis(e) -- siehe Ausgabe."))
END SUB

' Ein Eintrag der Datei. TRUE, wenn er gilt.
FUNCTION tastenEins(k AS STRING, neu AS STRING) AS BOOLEAN
    DIM idx AS INTEGER : idx = ARRAY_INDEXOF(befehlKennungen, k)
    DIM i AS INTEGER
    DIM treffer AS INTEGER : treffer = 0
    FOR i = 0 TO LEN(menueItems) - 1
        IF menueKennung[i] = k THEN
            TRY
                GUI_MENU_SHORTCUT(menueItems[i], neu)
            CATCH e
                tastenMelden(k + ": " + CHR$(34) + neu + CHR$(34) + " ist kein Kürzel, das die IDE kennt (" + e + ")")
                RETURN FALSE
            END TRY
            menueJetzt[i] = neu
            treffer = treffer + 1
        END IF
    NEXT
    IF treffer = 0 THEN
        IF idx < 0 THEN
            tastenMelden(k + ": diesen Befehl gibt es nicht")
        ELSE
            tastenMelden(k + ": " + befehlNamen[idx] + " hat keinen Menüpunkt, sein Kürzel lässt sich nicht ändern")
        END IF
        RETURN FALSE
    END IF
    IF idx >= 0 THEN befehlKuerzel[idx] = neu
    ' Wem gehoerte das Kuerzel vorher?
    DIM form AS STRING : form = kuerzelForm$(neu)
    IF form = "" THEN RETURN TRUE
    FOR i = 0 TO LEN(menueItems) - 1
        IF menueKennung[i] <> k AND kuerzelForm$(menueJetzt[i]) = form THEN
            GUI_MENU_SHORTCUT(menueItems[i], "")
            menueJetzt[i] = ""
            DIM andere AS INTEGER : andere = ARRAY_INDEXOF(befehlKennungen, menueKennung[i])
            DIM andererName AS STRING : andererName = menueKennung[i]
            IF andere >= 0 THEN
                befehlKuerzel[andere] = ""
                andererName = befehlNamen[andere]
            END IF
            tastenMelden(neu + " gehörte vorher zu " + CHR$(34) + andererName + CHR$(34) + " -- der hat jetzt keins mehr")
        END IF
    NEXT
    RETURN TRUE
END FUNCTION

' Hilfe -> Tastenkuerzel aendern: erst den Befehl waehlen (nur die mit
' Menuepunkt -- die anderen haben keinen Ort fuer ein Kuerzel), dann fragen.
SUB tastenWaehlen()
    paletteNamen = []
    paletteKennungen = []
    paletteDetails = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(befehlNamen) - 1
        IF ARRAY_INDEXOF(menueKennung, befehlKennungen[i]) >= 0 THEN
            ARRAY_PUSH(paletteNamen, befehlNamen[i]) : ARRAY_PUSH(paletteKennungen, befehlKennungen[i]) : ARRAY_PUSH(paletteDetails, befehlKuerzel[i])
        END IF
    NEXT
    waehlerOeffnen("tasten", tr$("Tastenkürzel ändern: Befehl wählen"))
END SUB

SUB tastenFragen(k AS STRING)
    DIM idx AS INTEGER : idx = ARRAY_INDEXOF(befehlKennungen, k)
    IF idx < 0 THEN RETURN
    tastenKennung = k
    dlgTasten = GUI_PROMPT(tr$("Tastenkürzel"), tr$("Neues Kürzel für ") + CHR$(34) + befehlNamen[idx] + CHR$(34) + tr$(" (z. B. Strg+Alt+K; leer = keins):"), befehlKuerzel[idx])
END SUB

' In die Datei schreiben und neu anwenden. Wer die Vorgabe zurueckstellt,
' bekommt keinen Eintrag -- die Datei bleibt so klein wie die Abweichung.
SUB tastenSetzen(k AS STRING, neu AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE("{}")
    IF FILEEXISTS(tastenPfad$()) THEN
        TRY
            j = JSON_LOAD(tastenPfad$())
        CATCH e
            j = JSON_PARSE("{}")
        END TRY
    END IF
    DIM idx AS INTEGER : idx = ARRAY_INDEXOF(befehlKennungen, k)
    IF idx >= 0 AND kuerzelForm$(neu) = kuerzelForm$(befehlKuerzelVorgabe[idx]) THEN
        IF JSON_HAS(j, k) THEN JSON_REMOVE(j, k)
    ELSE
        JSON_SET_STRING(j, k, neu)
    END IF
    WRITEALL(tastenPfad$(), JSON_STRINGIFY(j) + NL)
    tastenAnwenden()
    IF idx >= 0 THEN
        DIM zeigen AS STRING : zeigen = befehlKuerzel[idx]
        IF zeigen = "" THEN zeigen = "keins"
        IF LEN(tastenMeldungen) = 0 THEN GUI_SET_TEXT(lblStatus, befehlNamen[idx] + ": " + zeigen)
    END IF
    protokoll("tasten gesetzt " + k + " " + neu)
END SUB

SUB tastenZuruecksetzen()
    IF FILEEXISTS(tastenPfad$()) THEN DELETEFILE(tastenPfad$())
    tastenAnwenden()
    GUI_SET_TEXT(lblStatus, tr$("Alle Tastenkürzel wieder wie ausgeliefert."))
END SUB

' --- Eigene Schnipsel (schnipsel.txt neben der ide.json) ------------------
' Ein Textformat statt JSON: ein Schnipsel ist mehrzeiliger Code, und in
' JSON stuende er als eine Zeile voller \n. Jeder beginnt mit
'   === Name | kuerzel
' und reicht bis zum naechsten. Ein eigenes Kuerzel, das es schon gibt,
' ERSETZT den eingebauten Schnipsel -- wer "for" anders haben will, soll
' nicht zwei Eintraege fuer dasselbe Wort bekommen.
DIM schnipselEingebautNamen AS ARRAY OF STRING : schnipselEingebautNamen = []
DIM schnipselEingebautAbk AS ARRAY OF STRING : schnipselEingebautAbk = []
DIM schnipselEingebautText AS ARRAY OF STRING : schnipselEingebautText = []

FUNCTION schnipselPfad$() AS STRING
    RETURN PATHJOIN(konfigOrdner$(), "schnipsel.txt")
END FUNCTION

SUB schnipselEingebautMerken()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(schnipselNamen) - 1
        ARRAY_PUSH(schnipselEingebautNamen, schnipselNamen[i])
        ARRAY_PUSH(schnipselEingebautAbk, schnipselAbk[i])
        ARRAY_PUSH(schnipselEingebautText, schnipselText[i])
    NEXT
END SUB

SUB eigenerSchnipsel(name AS STRING, abk AS STRING, text AS STRING)
    DIM anzeige AS STRING : anzeige = IIF(abk = "", name, name + "   [" + abk + "]")
    DIM k AS INTEGER : k = -1
    IF abk <> "" THEN k = ARRAY_INDEXOF(schnipselAbk, abk)
    IF k >= 0 THEN
        schnipselNamen[k] = anzeige
        schnipselText[k] = text
        schnipselHerkunft[k] = "eigen, ersetzt"
    ELSE
        ARRAY_PUSH(schnipselNamen, anzeige)
        ARRAY_PUSH(schnipselAbk, abk)
        ARRAY_PUSH(schnipselText, text)
        ARRAY_PUSH(schnipselHerkunft, "eigen")
    END IF
END SUB

SUB schnipselLaden()
    schnipselNamen = [] : schnipselAbk = [] : schnipselText = [] : schnipselHerkunft = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(schnipselEingebautNamen) - 1
        ARRAY_PUSH(schnipselNamen, schnipselEingebautNamen[i])
        ARRAY_PUSH(schnipselAbk, schnipselEingebautAbk[i])
        ARRAY_PUSH(schnipselText, schnipselEingebautText[i])
        ARRAY_PUSH(schnipselHerkunft, "")
    NEXT
    DIM eigene AS INTEGER : eigene = 0
    DIM fehler AS INTEGER : fehler = 0
    IF FILEEXISTS(schnipselPfad$()) THEN
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(schnipselPfad$())
        DIM name AS STRING : name = ""
        DIM abk AS STRING : abk = ""
        DIM koerper AS ARRAY OF STRING : koerper = []
        DIM offen AS BOOLEAN : offen = FALSE
        DIM nr AS INTEGER
        FOR nr = 0 TO LEN(zeilen)
            DIM z AS STRING : z = ""
            DIM kopf AS BOOLEAN : kopf = TRUE
            IF nr < LEN(zeilen) THEN
                z = REPLACE$(zeilen[nr], CHR$(13), "")
                kopf = LEFT$(z, 4) = "=== "
            END IF
            IF kopf THEN
                ' den vorigen abschliessen: Leerzeilen am Ende gehoeren nicht dazu
                IF offen THEN
                    WHILE LEN(koerper) > 0 AND TRIM$(koerper[LEN(koerper) - 1]) = ""
                        ARRAY_POP(koerper)
                    WEND
                    IF LEN(koerper) = 0 THEN
                        protokoll("eigene schnipsel meldung leer " + name)
                        fehler = fehler + 1
                    ELSE
                        eigenerSchnipsel(name, abk, JOIN$(koerper, NL))
                        eigene = eigene + 1
                    END IF
                END IF
                offen = FALSE
                IF nr < LEN(zeilen) THEN
                    DIM k AS STRING : k = TRIM$(MID$(z, 4))
                    DIM p AS INTEGER : p = INSTR(k, "|")
                    abk = ""
                    name = k
                    IF p >= 0 THEN
                        name = TRIM$(LEFT$(k, p))
                        abk = TRIM$(MID$(k, p + 1))
                    END IF
                    IF abk <> "" AND NOT REGEX_TEST(abk, "^[A-Za-z_][A-Za-z0-9_]*$") THEN
                        ' Das Kuerzel wird am Tabulator als WORT gelesen --
                        ' mit Leerzeichen oder Punkt traefe es nie.
                        protokoll("eigene schnipsel meldung kuerzel " + abk)
                        GUI_SET_TEXT(lblStatus, tr$("Schnipsel ") + CHR$(34) + name + CHR$(34) + tr$(": das Kürzel ") + CHR$(34) + abk + CHR$(34) + tr$(" ist kein Wort -- nur über Strg+J erreichbar."))
                        fehler = fehler + 1
                        abk = ""
                    END IF
                    IF name = "" THEN name = IIF(abk = "", "Schnipsel", abk)
                    koerper = []
                    offen = TRUE
                END IF
            ELSEIF offen THEN
                ARRAY_PUSH(koerper, z)
            END IF
        NEXT
    END IF
    protokoll("eigene schnipsel " + STR$(eigene) + " " + STR$(fehler))
END SUB

CONST SCHNIPSEL_VORLAGE = "' Eigene Schnipsel der IDE. Jeder beginnt mit einer Kopfzeile" + CHR$(10) + "'   === Name | kuerzel" + CHR$(10) + "' und reicht bis zur nächsten. Kürzel plus Tabulator klappt ihn im Code" + CHR$(10) + "' auf (wie for + Tab), Strg+J listet alle. Ein | im Text ist die Stelle," + CHR$(10) + "' an der danach die Schreibmarke steht. Ein eigenes Kürzel, das es schon" + CHR$(10) + "' gibt, ersetzt den eingebauten Schnipsel. Nach dem Sichern gilt die Datei." + CHR$(10) + CHR$(10)

SUB schnipselEigenOeffnen()
    DIM p AS STRING : p = schnipselPfad$()
    IF NOT FILEEXISTS(p) THEN
        WRITEALL(p, SCHNIPSEL_VORLAGE + "=== Zähler hochzählen | zaehl" + NL + "zaehler = zaehler + |" + NL)
        schnipselLaden()
    END IF
    tabOeffnen(p, dateiLesen(p))
    GUI_SET_TEXT(lblStatus, tr$("Eigene Schnipsel -- nach dem Sichern (Strg+S) gelten sie."))
    protokoll("eigene schnipsel datei")
END SUB

SUB schnipselAuswahlFragen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF GUI_TEXTAREA_SELECTION$(ta) = "" THEN
        GUI_SET_TEXT(lblStatus, tr$("Erst den Code markieren, der zum Schnipsel werden soll."))
        RETURN
    END IF
    dlgSchnipsel = GUI_PROMPT(tr$("Auswahl als Schnipsel"), tr$("Name | Kürzel (das Kürzel plus Tabulator setzt ihn ein):"), tr$("Mein Schnipsel | mein"))
END SUB

SUB schnipselAuswahlSichern(eingabe AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM text AS STRING : text = REPLACE$(GUI_TEXTAREA_SELECTION$(ta), CHR$(13), "")
    IF TRIM$(text) = "" OR TRIM$(eingabe) = "" THEN RETURN
    DIM p AS STRING : p = schnipselPfad$()
    DIM alt AS STRING : alt = ""
    IF FILEEXISTS(p) THEN
        alt = JOIN$(READLINES(p), NL)
        IF alt <> "" THEN alt = alt + NL
    ELSE
        alt = SCHNIPSEL_VORLAGE
    END IF
    IF RIGHT$(text, 1) = NL THEN text = LEFT$(text, LEN(text) - 1)
    WRITEALL(p, alt + "=== " + TRIM$(eingabe) + NL + text + NL)
    schnipselLaden()
    ' Steht die Datei in einem Reiter, soll er nicht den alten Stand halten.
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF wegGleich$(tabPfade[i]) = wegGleich$(p) AND GUI_TEXT(tabFelder[i]) = tabGesichert[i] THEN
            DIM neuT AS STRING : neuT = JOIN$(READLINES(p), NL)
            GUI_SET_TEXT(tabFelder[i], neuT)
            tabGesichert[i] = neuT
        END IF
    NEXT
    GUI_SET_TEXT(lblStatus, tr$("Als Schnipsel gesichert: ") + TRIM$(eingabe))
    protokoll("eigene schnipsel gesichert " + TRIM$(eingabe))
END SUB

' --- Terminal (Alt+3) ------------------------------------------------------
' Jeder Befehl laeuft als eigener Prozess (cmd /C bzw. sh) im Ordner des
' Terminals -- keine dauerhafte Shell: deren Eingabeaufforderung kaeme ohne
' Zeilenende und bliebe in der zeilenweisen Lesung haengen. Das Skript
' meldet am Ende den Ordner, in dem es stand; so wirkt `cd` wie gewohnt
' (auch `cd ..`, `cd /d`), Umgebungsvariablen aus `set` dagegen nicht.
CONST TERM_MARKE = "__DH_TERMINAL_ORT__"
DIM termWindows AS BOOLEAN : termWindows = GETENV$("COMSPEC") <> ""
DIM termOrt AS STRING : termOrt = ""
DIM termRest AS STRING : termRest = ""
DIM termFehlRest AS STRING : termFehlRest = ""
DIM termSkript AS STRING : termSkript = ""
' Abgebrochen: der Code (-1) sagt dann nichts, "[abgebrochen]" steht schon da.
DIM termAbgebrochen AS BOOLEAN : termAbgebrochen = FALSE
DIM termVerlauf AS ARRAY OF STRING : termVerlauf = []
DIM termVerlaufPos AS INTEGER : termVerlaufPos = 0

SUB terminalZeigen(an AS BOOLEAN)
    terminalAn = an
    IF an AND NOT untenAn THEN leistenSetzen(seitenAn, TRUE)
    GUI_BUTTON_VARIANT(btnReiterAusgabe, IIF(an, "flach", "primaer"))
    GUI_BUTTON_VARIANT(btnReiterTerminal, IIF(an, "primaer", "flach"))
    GUI_MENU_CHECK(miTerminal, an)
    layout()
    IF an THEN
        terminalOrtZeigen()
        GUI_FOCUS(tfEingabe)
    END IF
    protokoll("terminal " + IIF(an, "an", "aus"))
END SUB

FUNCTION terminalOrt$() AS STRING
    IF termOrt = "" OR NOT DIREXISTS(termOrt) THEN
        termOrt = projektOrdner
        IF termOrt = "" OR NOT DIREXISTS(termOrt) THEN termOrt = startOrdner
    END IF
    RETURN termOrt
END FUNCTION

SUB terminalOrtZeigen()
    IF termProz >= 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Terminal: läuft -- Enter schickt eine Eingabe, [Abbrechen] beendet."))
    ELSE
        GUI_SET_TEXT(lblStatus, tr$("Terminal: ") + terminalOrt$())
    END IF
END SUB

SUB terminalZeile(z AS STRING, farbe AS INTEGER)
    GUI_LISTBOX_ADD(lstTerminal, z)
    IF farbe <> -1 THEN GUI_LISTBOX_COLOR(lstTerminal, GUI_LISTBOX_COUNT(lstTerminal) - 1, farbe)
    IF GUI_LISTBOX_COUNT(lstTerminal) > 3000 THEN GUI_LISTBOX_REMOVE(lstTerminal, 0)
    GUI_LISTBOX_SET_SELECTED(lstTerminal, GUI_LISTBOX_COUNT(lstTerminal) - 1)
    protokoll("terminal zeile " + z)
END SUB

' Einfache Anfuehrung fuer sh: ' wird zu '\''.
FUNCTION shWort$(s AS STRING) AS STRING
    RETURN "'" + REPLACE$(s, "'", "'\''") + "'"
END FUNCTION

SUB terminalEingabe(t AS STRING)
    GUI_SET_TEXT(tfEingabe, "")
    IF termProz >= 0 THEN
        ' Ein laufender Befehl bekommt die Zeile als Eingabe.
        PROCESS_WRITE(termProz, t + NL)
        terminalZeile("< " + t, F_KOMMENTAR)
        RETURN
    END IF
    DIM b AS STRING : b = TRIM$(t)
    IF b = "" THEN RETURN
    IF LEN(termVerlauf) = 0 THEN
        ARRAY_PUSH(termVerlauf, b)
    ELSEIF termVerlauf[LEN(termVerlauf) - 1] <> b THEN
        ARRAY_PUSH(termVerlauf, b)
    END IF
    termVerlaufPos = LEN(termVerlauf)
    terminalZeile(terminalOrt$() + "> " + b, F_SCHLUESSEL)
    IF LOWER$(b) = "cls" OR LOWER$(b) = "clear" THEN
        GUI_LISTBOX_CLEAR(lstTerminal)
        RETURN
    END IF
    terminalStarten(b)
END SUB

SUB terminalStarten(b AS STRING)
    DIM ordner AS STRING : ordner = konfigOrdner$()
    ' Absolut und unter Windows mit Rueckstrichen: cmd /C nimmt "./x.cmd" nicht.
    IF termSkript = "" THEN
        termSkript = PATHJOIN(REALPATH$(ordner), "terminal_" + LEFT$(UUID4$(), 8) + IIF(termWindows, ".cmd", ".sh"))
        IF termWindows THEN termSkript = REPLACE$(termSkript, "/", CHR$(92))
    END IF
    DIM text AS STRING
    IF termWindows THEN
        ' chcp 65001: sonst kaemen die Umlaute von dir & Co. in der
        ' OEM-Codeseite an. errorlevel wird VOR dem Echo gemerkt.
        DIM crlf AS STRING : crlf = CHR$(13) + CHR$(10)
        text = "@echo off" + crlf + "chcp 65001 >nul" + crlf + "cd /d " + CHR$(34) + terminalOrt$() + CHR$(34) + crlf + b + crlf
        text = text + "set __dh_e=%errorlevel%" + crlf + "echo " + TERM_MARKE + "%cd%" + crlf + "exit /b %__dh_e%" + crlf
        WRITEALL(termSkript, text)
        termProz = PROCESS_START("cmd", "/Q", "/D", "/C", termSkript)
    ELSE
        text = "cd " + shWort$(terminalOrt$()) + " || exit 1" + NL + b + NL
        text = text + "__dh_e=$?" + NL + "echo " + TERM_MARKE + "$(pwd)" + NL + "exit $__dh_e" + NL
        WRITEALL(termSkript, text)
        termProz = PROCESS_START("sh", termSkript)
    END IF
    termRest = "" : termFehlRest = ""
    protokoll("terminal start " + b)
    layout()
    terminalOrtZeigen()
END SUB

' Zeilen verteilen: die Marke setzt den Ort, alles andere kommt in die Liste.
SUB termVerteilen(text AS STRING, fehler AS BOOLEAN, ende AS BOOLEAN)
    DIM rest AS STRING : rest = IIF(fehler, termFehlRest, termRest) + text
    WHILE INSTR(rest, NL) >= 0 OR (ende AND rest <> "")
        DIM p AS INTEGER : p = INSTR(rest, NL)
        DIM z AS STRING
        IF p >= 0 THEN
            z = LEFT$(rest, p)
            rest = MID$(rest, p + 1)
        ELSE
            z = rest
            rest = ""
        END IF
        z = REPLACE$(z, CHR$(13), "")
        IF LEFT$(z, LEN(TERM_MARKE)) = TERM_MARKE THEN
            termOrt = TRIM$(MID$(z, LEN(TERM_MARKE)))
        ELSE
            terminalZeile(z, IIF(fehler, F_ZAHL, -1))
        END IF
    WEND
    IF fehler THEN termFehlRest = rest ELSE termRest = rest
END SUB

SUB terminalNachziehen()
    IF termProz < 0 THEN RETURN
    termVerteilen(PROCESS_READ$(termProz), FALSE, FALSE)
    termVerteilen(PROCESS_ERR$(termProz), TRUE, FALSE)
    IF PROCESS_RUNNING(termProz) THEN RETURN
    ' Wie beim Programmlauf: lesen, bis fuenf Abfragen leer sind -- das Kind
    ' kann fertig sein, bevor sein Lesefaden die letzte Zeile abgelegt hat.
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM a AS STRING : a = PROCESS_READ$(termProz)
        DIM f AS STRING : f = PROCESS_ERR$(termProz)
        IF a = "" AND f = "" THEN
            leer = leer + 1
            SLEEP(10)
        ELSE
            termVerteilen(a, FALSE, FALSE)
            termVerteilen(f, TRUE, FALSE)
            leer = 0
        END IF
    WEND
    termVerteilen("", FALSE, TRUE)
    termVerteilen("", TRUE, TRUE)
    DIM code AS INTEGER : code = PROCESS_CODE(termProz)
    PROCESS_CLOSE(termProz)
    termProz = -1
    IF code <> 0 AND NOT termAbgebrochen THEN terminalZeile("[beendet mit Code " + STR$(code) + "]", F_ZAHL)
    termAbgebrochen = FALSE
    protokoll("terminal fertig " + STR$(code) + " " + BASENAME(termOrt))
    layout()
    IF terminalAn THEN terminalOrtZeigen()
END SUB

SUB terminalAbbrechen()
    IF termProz < 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Im Terminal läuft nichts."))
        RETURN
    END IF
    PROCESS_KILL(termProz)
    termAbgebrochen = TRUE
    terminalZeile("[abgebrochen]", F_ZAHL)
    protokoll("terminal abgebrochen")
END SUB

' Pfeil hoch/runter in der Eingabezeile blaettert durch die Befehle.
SUB terminalVerlaufTasten()
    IF NOT terminalAn OR termProz >= 0 OR GUI_FOCUSED() <> tfEingabe THEN RETURN
    IF LEN(termVerlauf) = 0 THEN RETURN
    IF KEYHIT(KEY_UP) THEN
        termVerlaufPos = MAX(0, termVerlaufPos - 1)
        GUI_SET_TEXT(tfEingabe, termVerlauf[termVerlaufPos])
    ELSEIF KEYHIT(KEY_DOWN) THEN
        termVerlaufPos = MIN(LEN(termVerlauf), termVerlaufPos + 1)
        IF termVerlaufPos >= LEN(termVerlauf) THEN
            GUI_SET_TEXT(tfEingabe, "")
        ELSE
            GUI_SET_TEXT(tfEingabe, termVerlauf[termVerlaufPos])
        END IF
    END IF
END SUB


' --- Profil im Code (seit 2026-09-29) -----------------------------------
' Nach Strg+Umschalt+Y steht die Messung nicht nur in der Tabelle, sondern
' im Code selbst: ein Band hinter jeder gemessenen Zeile, von blassgelb
' (wenig) bis kraeftig rot (die teuerste Zeile), und an den 30 teuersten die
' Zahlen am Zeilenende. Die Farben wandern beim Tippen mit
' (GUI_TEXTAREA_LINE_COLORS); die Zahlen haengen an ihnen. Gemessen ist,
' was gelaufen ist -- nach groesseren Aenderungen stimmt es nicht mehr, dann
' neu messen oder "Profil im Code entfernen".
' Farbe zu einem Anteil an der teuersten Zeile (0..1): Gelb nach Rot, die
' Deckkraft waechst mit -- eine kalte Zeile soll kaum auffallen.
FUNCTION waermeFarbe(h AS FLOAT) AS INTEGER
    h = MAX(0.0, MIN(1.0, h))
    DIM gruen AS INTEGER : gruen = INT(208 - 176 * h)
    DIM blau AS INTEGER : blau = INT(64 - 16 * h)
    DIM deck AS INTEGER : deck = INT(24 + 120 * h)
    RETURN (deck SHL 24) BOR (255 SHL 16) BOR (gruen SHL 8) BOR blau
END FUNCTION

' Die Waerme EINES Reiters aus der letzten Messung setzen (oder wegnehmen).
SUB waermeFeld(t AS INTEGER)
    IF t < 0 OR t >= tabAnzahl THEN RETURN
    DIM ta AS GUI_WIDGET : ta = tabFelder[t]
    ' die alten Eintraege dieses Feldes weg
    DIM nf AS ARRAY OF INTEGER : nf = []
    DIM nn AS ARRAY OF INTEGER : nn = []
    DIM nt AS ARRAY OF STRING : nt = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(waermeFelder) - 1
        IF waermeFelder[i] <> ta THEN
            ARRAY_PUSH(nf, waermeFelder[i]) : ARRAY_PUSH(nn, waermeNr[i]) : ARRAY_PUSH(nt, waermeTexte[i])
        END IF
    NEXT
    waermeFelder = nf : waermeNr = nn : waermeTexte = nt
    DIM zl AS ARRAY OF INTEGER : zl = []
    DIM fa AS ARRAY OF INTEGER : fa = []
    DIM pfad AS STRING : pfad = tabPfade[t]
    IF waermeAn AND waermeDaten AND pfad <> "" THEN
        DIM hoechst AS FLOAT : hoechst = 0.0
        FOR i = 0 TO LEN(profRohT) - 1
            hoechst = MAX(hoechst, profRohT[i])
        NEXT
        ' profRoh* ist nach Zeit absteigend: die ersten 30 bekommen Zahlen.
        FOR i = 0 TO LEN(profRohZ) - 1
            IF wegGleich$(profDatei$(i)) <> wegGleich$(pfad) THEN CONTINUE
            IF profRohT[i] <= 0.0 OR hoechst <= 0.0 THEN CONTINUE
            ARRAY_PUSH(zl, profRohZ[i])
            ARRAY_PUSH(fa, waermeFarbe(profRohT[i] / hoechst))
            DIM text AS STRING : text = ""
            IF i < 30 THEN
                text = FORMAT$(profRohT[i] * 1000.0, "%.2f") + " ms"
                IF profGesamt > 0.0 THEN text = text + "  " + FORMAT$(profRohT[i] / profGesamt * 100.0, "%.1f") + " %"
                text = text + "  " + STR$(profRohA[i]) + "x"
            END IF
            ARRAY_PUSH(waermeFelder, ta) : ARRAY_PUSH(waermeNr, LEN(zl) - 1) : ARRAY_PUSH(waermeTexte, text)
        NEXT
    END IF
    GUI_TEXTAREA_LINE_COLORS(ta, zl, fa)
    hinweiseZeigen(ta)
    IF LEN(zl) > 0 THEN protokoll("waerme " + BASENAME(pfad) + " " + STR$(LEN(zl)))
END SUB

SUB waermeAnwenden()
    DIM t AS INTEGER
    FOR t = 0 TO tabAnzahl - 1
        waermeFeld(t)
    NEXT
END SUB

SUB waermeSetzen(an AS BOOLEAN)
    waermeAn = an
    GUI_MENU_CHECK(miWaerme, an)
    waermeAnwenden()
    IF an AND NOT waermeDaten THEN
        GUI_SET_TEXT(lblStatus, tr$("Profil im Code an -- es erscheint nach einer Messung (Strg+Umschalt+Y)."))
    ELSE
        GUI_SET_TEXT(lblStatus, IIF(an, tr$("Profil im Code an."), tr$("Profil im Code aus.")))
    END IF
    protokoll("waerme " + IIF(an, "an", "aus"))
    konfigSichern()
END SUB

' Die Messung vergessen: Farben und Zahlen weg, die Tabelle bleibt.
SUB waermeEntfernen()
    waermeDaten = FALSE
    waermeAnwenden()
    GUI_SET_TEXT(lblStatus, tr$("Profil aus dem Code entfernt."))
    protokoll("waerme entfernt")
END SUB

' Die Sprache wechselt beim naechsten Start -- die Fenster sind gebaut,
' und jede Beschriftung einzeln nachzuziehen hiesse, jede zweimal zu kennen.
SUB spracheWechseln()
    DIM neu AS STRING : neu = IIF(englisch, "de", "en")
    JSON_SET_STRING(konfig, "sprache", neu)
    konfigSichern()
    IF neu = "en" THEN
        GUI_SET_TEXT(lblStatus, "Beim nächsten Start ist die Oberfläche englisch. / The interface will be English at the next start.")
    ELSE
        GUI_SET_TEXT(lblStatus, "The interface will be German at the next start. / Beim nächsten Start ist die Oberfläche deutsch.")
    END IF
    protokoll("sprache " + neu)
END SUB

' --- Befehlspalette und Datei-Waehler ------------------------------------
' EINE Liste aller Befehle mit Kuerzel: Palette, Tastenkuerzel-Uebersicht.
SUB paletteEintrag(name AS STRING, kennung AS STRING, kuerzel AS STRING)
    ARRAY_PUSH(befehlNamen, tr$(name))
    ARRAY_PUSH(befehlKennungen, kennung)
    ARRAY_PUSH(befehlKuerzel, kz$(kuerzel))
END SUB

