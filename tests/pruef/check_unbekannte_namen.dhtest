    WHILE MILLIS() < bis AND stille < 5
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN r = r + zz : stille = 0
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
    WEND
    RETURN r
END FUNCTION
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", "s.dh")
DIM roh AS STRING : roh = TRIM$(lesen$(pc))
IF roh = "" THEN roh = "[]"
DIM h AS JSON_HANDLE : h = JSON_PARSE("{" + CHR$(34) + "b" + CHR$(34) + ":" + roh + "}")
DIM n AS INTEGER : n = 0
DIM i AS INTEGER
DIM k AS INTEGER
FOR i = 0 TO JSON_LEN(h, "b") - 1
    DIM msg AS STRING : msg = JSON_GET_STRING(h, "b." + STR$(i) + ".message")
    IF INSTR(msg, MARKE) >= 0 THEN
        n = n + 1
        PRINT "zeile "; JSON_GET_INT(h, "b." + STR$(i) + ".line"); " "; JSON_GET_STRING(h, "b." + STR$(i) + ".severity")
        FOR k = 0 TO LEN(such) - 1
            PRINT "  "; such[k]; ": "; INSTR(msg, such[k]) >= 0
        NEXT
    END IF
NEXT
PRINT "befunde "; n; " rueckgabe "; PROCESS_CODE(pc)
