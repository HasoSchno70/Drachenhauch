--- umgebung
DHRT_FRAMES=26
--- nachher
FUNCTION rendern$() AS STRING
    ' Den erzeugten Renderer starten und sein Bild sichern (dhrt bild).
    DIM ziel AS STRING : ziel = CWD$() + "/gerendert.png"
    DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "bild", CWD$() + "/_programm/raus.dh", ziel, "4")
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    WHILE PROCESS_RUNNING(pc) AND MILLIS() < bis
        SLEEP(50)
    WEND
    RETURN ziel
END FUNCTION
FUNCTION farben(pfad AS STRING) AS INTEGER
    DIM img AS IMAGE : img = LOADIMAGE(pfad)
    DIM m AS MAP OF INTEGER : m = {}
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR x = 0 TO IMAGEWIDTH(img) - 1 STEP 4
        FOR y = 0 TO IMAGEHEIGHT(img) - 1 STEP 4
            MAPPUT(m, STR$(GETPIXEL(img, x, y)), 1)
        NEXT
    NEXT
    RETURN LEN(MAPKEYS(m))
END FUNCTION
PRINT "farben " ; farben(rendern$())
--- erwartet
farben 1

=== der erzeugte renderer zeichnet eine gemalte kachel
' Uebersetzen wuerde nichts beweisen: ein Renderer, der sein Tileset nicht findet
' oder die gid falsch aufloest, uebersetzt genauso und zeigt einen leeren Schirm.
DIM prBild AS INTEGER : prBild = 0
DIM prStart AS INTEGER : prStart = -1
DIM prF AS ARRAY OF INTEGER : prF = []
DIM prZ AS ARRAY OF STRING : prZ = []
DIM prFlag AS STRING : prFlag = ""
