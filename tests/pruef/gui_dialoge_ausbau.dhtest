=== zu viele oder leere knoepfe sind ein fehler
IMPORT "gui"
SCREEN(520, 320, "T", 1)
SET_WINDOW_POS(-3000, -3000)
TRY
    GUI_DIALOG("F", "x", "a|b|c|d|e|f")
CATCH e
    PRINT e
END TRY
TRY
    GUI_DIALOG("F", "x", "a||b")
CATCH e2
    PRINT e2
END TRY
TRY
    GUI_DIALOG("F", "x", "vielleicht")
CATCH e3
    PRINT e3
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
GUI_DIALOG: ein bis fuenf Knoepfe, getrennt mit |
GUI_DIALOG: ein Knopf ohne Beschriftung
GUI_DIALOG: 'vielleicht' ist kein Stil -- moeglich sind "ok" (Vorgabe), "janein" oder eigene Knoepfe mit | getrennt ("Speichern|Verwerfen|Abbrechen")

=== prompt liefert den text mit enter
' Tippen ueber die Zwischenablage (Strg+V); die Vorgabe ist markiert und
IMPORT "gui"
SCREEN(520, 320, "T", 1)
SET_WINDOW_POS(-3000, -3000)
CLIPBOARD_SET("Hans")
DIM d AS GUI_WINDOW : d = GUI_PROMPT("Name", "Wie heisst du?", "Anonym")
PRINT GUI_DIALOG_TEXT(d)
AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 1 TO 16
    GUI_UPDATE()
    IF GUI_ANSWER(d) <> 0 THEN PRINT "antwort " + STR$(GUI_ANSWER(d)) + " " + GUI_DIALOG_TEXT(d)
    GUI_DRAW()
    FLIP()
NEXT
PRINT GUI_DIALOG_TEXT(d) ; " " ; GUI_MODAL()
--- datei ev.txt
# Test-Aufnahme
c 6
e 3 2 341 0 0 0 // Event: test
e 3 2 86 0 0 0 // Event: test
e 4 1 86 0 0 0 // Event: test
e 4 1 341 0 0 0 // Event: test
e 9 2 257 0 0 0 // Event: test
e 10 1 257 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=20
--- erwartet
Anonym
antwort 1 Hans
Hans FALSE

