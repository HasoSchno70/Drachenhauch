=== abbrechen
FUNCTION Langsam(x AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    DIM s AS INTEGER
    s = 0
    FOR i = 1 TO 2000
        s = s + i MOD 7
    NEXT
    RETURN x * 2
