FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
PRINT alle$("treffer ")
PRINT letzte$("suche zahl")
DIM k AS STRING : k = READLINES("_programm/ide.json")[0]
PRINT "gemerkt "; INSTR(k, CHR$(34) + "gross_klein" + CHR$(34) + ":true") >= 0; " "; INSTR(k, CHR$(34) + "ganzes_wort" + CHR$(34) + ":true") >= 0
--- erwartet
treffer 1 von 3 zeile 1 spalte 5|treffer 2 von 3 zeile 3 spalte 1|treffer 3 von 3 zeile 5 spalte 9|treffer 1 von 3 zeile 1 spalte 5
suche zahl 1 von 3
gemerkt TRUE TRUE

