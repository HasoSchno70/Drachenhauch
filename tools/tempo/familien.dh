' Tempo: Rechnen mit einem Befehl aus einer Familie der VM (zeit) je Runde
' -- bis M4 Schritt 6 liess dieser eine Befehl die ganze Schleife in der VM.
IMPORT "zeit"
DIM t0 AS FLOAT : t0 = TIMER()
DIM start AS INTEGER : start = ZEIT_AUS_TEILEN(2026, 1, 1)
DIM a AS INTEGER : a = 1
DIM b AS INTEGER : b = 0
DIM s AS INTEGER : s = 0
DIM i AS INTEGER
DIM j AS INTEGER
FOR i = 1 TO 200000
    FOR j = 1 TO 10
        a = (a * 31 + i + j) MOD 1000003
        b = b + a MOD 7
    NEXT
    s = s + ZEIT_WOCHENTAG(start + i * 3600)
NEXT
PRINT "ZEIT "; (TIMER() - t0) * 1000.0
IF s <= 0 OR b <= 0 THEN EXIT(1)
