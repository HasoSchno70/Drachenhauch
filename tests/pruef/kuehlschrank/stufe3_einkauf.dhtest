=== echt: reiter, schnellknopf, haken, papierkorb, strg+z
' Ein Messlauf liest die Lagen (Reiterkopf, Schnellknopf, Tabelle, Spalten
' aus der .dhform), dann klickt der zweite Lauf: Reiter Einkauf, Schnellknopf
' Joghurt (Prioritaet 1, steht damit oben), Haken in Zeile 0 (Joghurt),
' Papierkorb in Zeile 1 (Brot, Enter fuer die Frage), Strg+Z holt Brot
' zurueck.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 10)
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
FUNCTION z(i AS INTEGER) AS INTEGER
    RETURN INT(VAL(w[i]))
END FUNCTION
DIM zy0 AS INTEGER : zy0 = z(5) + z(6) + z(7) \ 2
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slKlick(z(0), z(1))
slWarten(10)
slKlick(z(2), z(3))
slWarten(10)
slKlick(z(4) + kSpalteMitte(p, "EinkaufSeite", "tabelle", 0), zy0)
slWarten(10)
slKlick(z(4) + kSpalteMitte(p, "EinkaufSeite", "tabelle", 6), zy0 + z(7))
slWarten(15)
slTaste(257)
slWarten(15)
slMit([341], 90)
slWarten(10)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 20)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei daten.dh
' Messlauf und Abspiellauf teilen die Datei: jedes Mal frisch.
DB_EXEC(db, "DELETE FROM shopping_list")
DB_EXEC(db, "DELETE FROM consumption_history")
DB_EXEC(db, "INSERT INTO shopping_list (product_name, quantity, unit) VALUES ('Brot', 1, 'Stück')")
DB_EXEC(db, "INSERT INTO consumption_history (product_name, quantity, unit, reason) VALUES ('Joghurt', 1, 'Stück', 'consumed'), ('Joghurt', 1, 'Stück', 'consumed')")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS EinkaufSeite : s = f.einkauf
f.geaendert()
--- datei mess.dh
IMPORT "../../daten.dh"
GUI_TABCONTROL_SET_PAGE(f.reiter, 2)
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
DIM rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER
(rx, ry, rw, rh) = GUI_TABCONTROL_ITEM_RECT(f.reiter, 2)
WRITEALL("lage.txt", STR$(rx + rw \ 2) + " " + STR$(ry + rh \ 2) + " " + _
    STR$(GUI_GET_X(s.schnell0) + GUI_GET_W(s.schnell0) \ 2) + " " + STR$(GUI_GET_Y(s.schnell0) + 26 + GUI_GET_H(s.schnell0) \ 2) + " " + _
    STR$(GUI_GET_X(s.tabelle)) + " " + STR$(GUI_GET_Y(s.tabelle) + 26) + " " + STR$(INT(GUI_TABLE_GET(s.tabelle, "kopfhoehe"))) + " " + STR$(INT(GUI_TABLE_GET(s.tabelle, "zeilenhoehe"))))
--- datei klick.dh
IMPORT "../../daten.dh"
FUNCTION stand$() AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT GROUP_CONCAT(product_name || ':' || checked, ' ') FROM (SELECT * FROM shopping_list ORDER BY id)")
    DIM t AS STRING : t = "-"
    IF DB_NEXT(r) THEN
        IF NOT DB_IS_NULL(r, 0) THEN t = DB_GET_STRING(r, 0)
    END IF
    RETURN t + " / Seite " + STR$(GUI_TABCONTROL_PAGE(f.reiter))
END FUNCTION
DIM folge AS ARRAY OF STRING : folge = []
DIM war AS STRING : war = ""
WHILE studioBild()
    DIM jetzt AS STRING : jetzt = stand$()
    IF jetzt <> war THEN ARRAY_PUSH(folge, jetzt)
    war = jetzt
WEND
PRINT JOIN$(folge, " -> ")
PRINT "statistik "; GUI_TEXT(s.statistik); " | status "; GUI_STATUSBAR_TEXT$(f.status, 3)
--- erwartet
Brot:0 / Seite 0 -> Brot:0 / Seite 2 -> Brot:0 Joghurt:0 / Seite 2 -> Brot:0 Joghurt:1 / Seite 2 -> Joghurt:1 / Seite 2 -> Brot:0 Joghurt:1 / Seite 2
statistik 🛒 1 offen  •  ✅ 1 erledigt  •  📋 2 gesamt | status Rückgängig: Brot von der Liste
