=== kern: rundung, raender, einstellungen, befehl
IMPORT "helfer.dh"
' Pythons round: bei .5 zur geraden Zahl, auch negativ
DIM z AS FLOAT
FOR EACH z IN [0.5, 1.5, 2.5, -0.5, -1.5, 2.4999, 2.5001, 0.0, -2.6]
    PRINT z; " -> "; kern.rundenGerade(z); " | ";
NEXT
PRINT
' Intervall unter 1 gilt als 1, ohne Mustergroesse kein Klemmen
DIM x AS INTEGER, y AS INTEGER
(x, y) = kern.einrasten(7, 8, 0, 20, 20)
PRINT "intervall 0: "; x; ","; y;
(x, y) = kern.einrasten(97, -12, 10, 0, 0)
PRINT " | ohne muster: "; x; ","; y
' Druck ueber 1 zaehlt wie 1, darunter 0 wie die Maus
PRINT "druck 3: "; LEN(kern.pinselZellen(0, 0, 3.0, 5)) \ 2; " | druck -1: "; LEN(kern.pinselZellen(4, 4, -1.0, 5)) \ 2; " | groesse 0: "; LEN(kern.pinselZellen(4, 4, 1.0, 0)) \ 2
' Ohne vorigen Faktor (0) zaehlt der erste Schritt
PRINT "pinch ohne vorher: "; kern.pinchSchritt(1.0, 0.0); " "; kern.pinchSchritt(0.0, 1.0)
' Die neuen Einstellungen
DIM es AS kern.Einstellungen : es = NEW kern.Einstellungen()
PRINT "vorgaben: "; es.einrasten; " "; es.rasterSchritt; " "; es.stiftDruck; " "; es.pinselGroesse; " "; es.gesten
es.einrasten = TRUE : es.rasterSchritt = 7 : es.stiftDruck = FALSE : es.pinselGroesse = 12 : es.gesten = TRUE
WRITEALL("es.json", kern.einstellungenJson$(es))
DIM zl AS STRING
FOR EACH zl IN READLINES("es.json")
    IF INSTR(zl, "snap_") >= 0 OR INSTR(zl, "tablet") >= 0 OR INSTR(zl, "touch") >= 0 THEN PRINT TRIM$(zl)
NEXT
DIM gl AS kern.Einstellungen : gl = kern.einstellungenLaden("es.json")
PRINT "gelesen: "; gl.einrasten; " "; gl.rasterSchritt; " "; gl.stiftDruck; " "; gl.pinselGroesse; " "; gl.gesten
WRITEALL("krumm.json", "{" + CHR$(34) + "snap_interval" + CHR$(34) + ": 0, " + CHR$(34) + "tablet/max_brush_size" + CHR$(34) + ": 99, " + CHR$(34) + "touch/gestures_enabled" + CHR$(34) + ": " + CHR$(34) + "ja" + CHR$(34) + "}")
gl = kern.einstellungenLaden("krumm.json")
PRINT "krumm: schritt "; gl.rasterSchritt; " | pinsel "; gl.pinselGroesse; " | gesten "; gl.gesten
' Der Befehl in der Kuerzel-Tafel
PRINT "befehl einrasten: "; kern.kuerzelVon$(es, "einrasten") = ""; " | tafel "; LEN(kern.kuerzelAktionen())
