=== elif basic (1)
DIM x AS INTEGER
x = 5
IF x = 1 THEN
    PRINT "a"
ELIF x = 2 THEN
    PRINT "b"
ELIF x = 5 THEN
    PRINT "c"
ELSE
    PRINT "d"
END IF
--- erwartet
c

