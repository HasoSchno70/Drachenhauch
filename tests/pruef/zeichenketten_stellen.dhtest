' LEFT$/RIGHT$/MID$/INSTR zaehlen in ZEICHEN, ab 0. Bis 2026-09-24 legte jeder
' Aufruf den ganzen Text als Liste von Zeichen an (MID$ auf 200 000 Zeichen:
' 90 Mikrosekunden, egal an welcher Stelle); jetzt wird nur bis zur Stelle
' gezaehlt. Die Erwartung ist die Ausgabe der Laufzeit 2026.15 mit der alten
' Fassung -- Umlaute, Emoji, leere Texte, Stellen vor dem Anfang und hinter
' dem Ende. Format: docs/werkzeuge.md.

=== randfaelle wie vorher
DIM texte AS ARRAY OF STRING : texte = ["", "a", "Größe", "x😀yäz", "abcabc"]
DIM such AS ARRAY OF STRING : such = ["", "a", "ö", "😀y", "bc", "zz", "Größe"]
DIM i AS INTEGER
DIM j AS INTEGER
DIM k AS INTEGER
FOR i = 0 TO LEN(texte) - 1
    FOR j = -1 TO 7
        PRINT "[" + LEFT$(texte[i], j) + "|" + RIGHT$(texte[i], j) + "|" + MID$(texte[i], j + 1) + "]";
        FOR k = -1 TO 6
            PRINT "(" + MID$(texte[i], j + 1, k) + ")";
        NEXT
        PRINT
    NEXT
    FOR j = 0 TO LEN(such) - 1
        PRINT INSTR(texte[i], such[j]);
        FOR k = 0 TO 7
            PRINT ","; INSTR(texte[i], such[j], k);
        NEXT
        PRINT
    NEXT
NEXT
