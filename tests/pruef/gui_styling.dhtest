GUI_THEME_PRESET("glas_dunkel")
PRINT GUI_THEME_GET("win_bg")
GUI_THEME_PRESET("glas_hell")
PRINT GUI_THEME_GET("win_bg")
--- erwartet
2304563
14870767

=== plastik metriken sind einzeln setzbar
IMPORT "gui"
GUI_METRIC_SET("gradient", 30)
GUI_METRIC_SET("gloss", 50)
GUI_METRIC_SET("bevel", 1)
PRINT GUI_METRIC_GET("gradient")
--- erwartet
30

=== kippschalter verhaelt sich wie ein kaestchen
' Der Zustand liegt in `checked` -- damit gelten GUI_CHECKED und
IMPORT "gui"
DIM w AS GUI_WINDOW
DIM t AS GUI_WIDGET
w = GUI_WINDOW("W", 0, 0, 200, 120)
t = GUI_TOGGLE(w, "Musik", 10, 10, TRUE)
PRINT GUI_CHECKED(t)
GUI_SET_CHECKED(t, FALSE)
PRINT GUI_CHECKED(t)
PRINT GUI_KIND(t)
--- erwartet
TRUE
FALSE
toggle

=== drehregler haelt seinen wert
IMPORT "gui"
DIM w AS GUI_WINDOW
DIM k AS GUI_WIDGET
w = GUI_WINDOW("W", 0, 0, 200, 200)
k = GUI_KNOB(w, 10, 10, 80, 0.0, 100.0, 72.0)
PRINT GUI_VALUE(k)
GUI_SET_VALUE(k, 30.0)
PRINT GUI_VALUE(k)
PRINT GUI_KIND(k)
--- erwartet
72.0
30.0
knob

=== drehregler lehnt leeren bereich ab
IMPORT "gui"
DIM w AS GUI_WINDOW
w = GUI_WINDOW("W", 0, 0, 200, 200)
TRY
    GUI_KNOB(w, 10, 10, 80, 5.0, 5.0, 5.0)
CATCH e
    PRINT e
END TRY
--- erwartet
GUI_KNOB: max muss > min sein

=== runde knoepfe sind schaltbar
IMPORT "gui"
DIM w AS GUI_WINDOW
DIM b AS GUI_WIDGET
w = GUI_WINDOW("W", 0, 0, 200, 120)
b = GUI_BUTTON(w, ">", 10, 10, 40, 40)
GUI_SET_ROUND(b, TRUE)
GUI_SET_ROUND(b, FALSE)
PRINT "ok"
--- erwartet
ok

