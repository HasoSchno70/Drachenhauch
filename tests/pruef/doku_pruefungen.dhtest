=== markdown-links werden ueberhaupt geprueft
' Die Pruefung sah lange nur Inline-Code und uebersah Links -- ausgerechnet die
' Form der vier toten Verweise in CLAUDE.md. Nicht anschlagen duerfen: ein
' Ordner, eine Zeilennummer am Ende, ein Ziel im Netz. Und die Duldung
' historischer Pfade gilt fuer Inline-Code, NICHT fuer einen Link.
IMPORT "helfer.dh"
DIM fall AS STRING : fall = CWD$()
MKDIR("probe")
DIM z AS STRING : z = CHR$(10)
WRITEALL("probe/probe.md", "[tot](drachenhauch/gibtsnicht.py)" + z + _
    "[lebt](rust/build_wasm.py)" + z + "[ordner](docs/)" + z + _
    "[mit Zeile](rust/drachenhauch_runtime/src/lexer.rs:114)" + z + _
    "[netz](https://example.invalid/x.py)" + z + _
    "`drachenhauch/interpreter.py` als Inline-Code ist geduldet" + z + _
    "[klick](drachenhauch/interpreter.py)" + z)
CHDIR(ARG$(0))
dlStarten(["pruef", "pfade", fall + "/probe", "--nur", "probe.md"])
DIM alles AS STRING : alles = dlAus + dlErr
DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(alles, CHR$(10))
DIM befunde AS INTEGER : befunde = 0
DIM i AS INTEGER
FOR i = 0 TO LEN(zeilen) - 1
    IF LEFT$(TRIM$(zeilen[i]), 2) = "->" THEN befunde = befunde + 1
NEXT
PRINT "rueckgabe "; dlCode; ", befunde "; befunde
PRINT "toter link "; (INSTR(alles, "gibtsnicht.py") >= 0)
PRINT "geduldeter pfad als link "; (INSTR(alles, "[...](drachenhauch/interpreter.py)") >= 0)
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 1, befunde 2
toter link TRUE
geduldeter pfad als link TRUE

=== die vscode-grammatik liegt dort, wo package.json sie sucht
' Bei der Umbenennung wurde der INHALT der Grammatik angepasst, der DATEINAME
' nicht -- die Extension hatte keine Grammatik mehr. Zwei Grammatiken im
' Ordner hiessen: eine davon liest niemand.
IMPORT "json"
DIM ext AS STRING : ext = ARG$(0) + "/vscode-drachenhauch"
DIM pkg AS JSON_HANDLE : pkg = JSON_LOAD(ext + "/package.json")
DIM pfad AS STRING : pfad = JSON_GET_STRING(pkg, "contributes.grammars.0.path")
IF LEFT$(pfad, 2) = "./" THEN pfad = MID$(pfad, 2)
PRINT "verweis "; pfad
PRINT "datei da "; FILEEXISTS(ext + "/" + pfad)
DIM alle AS ARRAY OF STRING : alle = DIRLIST(ext + "/syntaxes", "*.tmLanguage.json")
PRINT "grammatiken im ordner "; LEN(alle)
DIM text AS STRING : text = BUFFER_TO_STRING$(READALL_BYTES(ext + "/" + pfad))
' Der Sinn der Erzeugung: ein Befehl aus dem Index wird gefaerbt.
PRINT "kennt neue befehle "; (INSTR(text, "SPEAK_SOUND") >= 0 AND INSTR(text, "GUI_ANNOUNCE") >= 0)
PRINT "kennt woerter und tasten "; (INSTR(text, "WHILE") >= 0 AND INSTR(text, "KEY_SPACE") >= 0)
--- argumente
{sammlung}/../..
--- erwartet
verweis syntaxes/drachenhauch.tmLanguage.json
datei da TRUE
grammatiken im ordner 1
kennt neue befehle TRUE
kennt woerter und tasten TRUE

=== erzeugte dateien sind aktuell
' Neu erzeugen darf nichts aendern -- ein generiertes Artefakt driftet lautlos
' (die Grammatik kannte einmal 223 Befehle nicht). builtin_prosa.json liest
' auch das Referenzbuch, und das geht nur mit Node.
IMPORT "helfer.dh"
CHDIR(ARG$(0))
dlStarten(["doku", "grammatik", "--pruefen"])
IF dlCode <> 0 THEN PRINT dlAus; dlErr
PRINT "grammatik: rueckgabe "; dlCode
DIM node AS BOOLEAN : node = TRUE
TRY
    DIM p AS INTEGER : p = PROCESS_START("node", "--version")
    WHILE PROCESS_RUNNING(p)
        SLEEP(20)
    WEND
    node = PROCESS_CODE(p) = 0
CATCH e
    node = FALSE
END TRY
IF NOT node THEN
    PRINT "UEBERSPRINGEN: node fehlt (fuer das Referenzbuch)"
    EXIT(0)
END IF
dlStarten(["doku", "prosa", "--pruefen"])
IF dlCode <> 0 THEN PRINT dlAus; dlErr
PRINT "prosa: rueckgabe "; dlCode
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
grammatik: rueckgabe 0
prosa: rueckgabe 0

=== die kurzbeschreibungen sind brauchbar
' builtin_docs.json deckte 328 von 1558 Befehlen ab; ganze Module standen bei
' null. Die aus docs/ eingesammelten Texte muessen zu echten Befehlen gehoeren,
' ohne Markdown-Rest sein und duerfen nicht mitten im Satz enden.
IMPORT "json"
DIM ed AS STRING : ed = ARG$(0) + "/daten"
DIM idx AS JSON_HANDLE : idx = JSON_LOAD(ed + "/builtin_index.json")
DIM echt AS MAP OF BOOLEAN
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(idx, "builtins") - 1
    DIM n AS STRING : n = UPPER$(JSON_GET_STRING(idx, "builtins." + STR$(i) + ".name"))
    MAPPUT(echt, n, TRUE)
    IF RIGHT$(n, 1) = "$" THEN MAPPUT(echt, LEFT$(n, LEN(n) - 1), TRUE)
NEXT
DIM prosa AS JSON_HANDLE : prosa = JSON_LOAD(ed + "/builtin_prosa.json")
DIM namen AS ARRAY OF STRING : namen = JSON_KEYS(prosa, "docs")
DIM vertreter AS ARRAY OF STRING
vertreter = ["GUI_TABLE_SET_CELL", "CUBE", "CHART_HOVER_VALUE", "VEC2_LERP", "SPRITE_PLAY", "TILED_LOAD"]
FOR i = 0 TO LEN(vertreter) - 1
    IF NOT JSON_HAS(prosa, "docs." + vertreter[i]) THEN PRINT "fehlt: "; vertreter[i]
NEXT
DIM enden AS ARRAY OF STRING
enden = [",", ":", " und", " oder", " der", " die", " das", " eine", " via", " mit"]
DIM fremd AS INTEGER : fremd = 0
DIM schrott AS INTEGER : schrott = 0
DIM offen AS INTEGER : offen = 0
FOR i = 0 TO LEN(namen) - 1
    IF NOT MAPHAS(echt, namen[i]) THEN
        fremd = fremd + 1
        PRINT "kein builtin: "; namen[i]
    END IF
    DIM t AS STRING : t = JSON_GET_STRING(prosa, "docs." + namen[i])
    IF INSTR(t, "`") >= 0 OR INSTR(t, "|") >= 0 OR INSTR(t, "](") >= 0 OR INSTR(t, "**") >= 0 THEN
        schrott = schrott + 1
        PRINT "markdown-rest: "; namen[i]; " = "; t
    END IF
    ' Gekuerzte Texte enden auf ein Auslassungszeichen. " ein" steht bewusst
    ' nicht in der Liste: "sammelt die Ausgabe ein" ist ein ganzer Satz.
    IF RIGHT$(t, 1) <> "…" THEN
        DIM rt AS STRING : rt = RTRIM$(t)
        DIM k AS INTEGER
        FOR k = 0 TO LEN(enden) - 1
            IF RIGHT$(rt, LEN(enden[k])) = enden[k] THEN
                offen = offen + 1
                PRINT "abgeschnitten: "; namen[i]; " = "; t
                BREAK
            END IF
        NEXT
    END IF
NEXT
PRINT "eintraege "; (LEN(namen) > 1000); ", fremd "; fremd; ", markdown "; schrott; ", abgeschnitten "; offen
--- argumente
{sammlung}/../..
--- erwartet
eintraege TRUE, fremd 0, markdown 0, abgeschnitten 0

=== die handgepflegte tabelle gewinnt und die abdeckung bleibt hoch
' Die Texte aus docs/ sind Tabellenzellen und oft knapp; builtin_docs.json ist
' auf den Hover zugeschnitten und muss vorgehen. Vor dem Einsammeln lag die
' Abdeckung bei 21 %, danach bei rund 54 % -- unter 45 % hat entweder der
' Generator etwas verloren oder docs/ wurde umgebaut.
IMPORT "json"
DIM ed AS STRING : ed = ARG$(0) + "/daten"
DIM hand AS JSON_HANDLE : hand = JSON_LOAD(ed + "/builtin_docs.json")
DIM prosa AS JSON_HANDLE : prosa = JSON_LOAD(ed + "/builtin_prosa.json")
PRINT "abs in beiden "; (JSON_HAS(hand, "docs.abs") AND JSON_HAS(prosa, "docs.ABS"))
DIM text AS STRING : text = JSON_GET_STRING(hand, "docs.abs.1")
DIM hover AS STRING : hover = CODE_HOVER$("PRINT ABS(1)", 1, 8)
PRINT "hover zeigt die tabelle "; (INSTR(hover, text) >= 0)
PRINT "texte verschieden "; (text <> JSON_GET_STRING(prosa, "docs.ABS"))
DIM idx AS JSON_HANDLE : idx = JSON_LOAD(ed + "/builtin_index.json")
DIM gesamt AS INTEGER : gesamt = JSON_LEN(idx, "builtins")
DIM mit AS INTEGER : mit = 0
DIM i AS INTEGER
FOR i = 0 TO gesamt - 1
    DIM n AS STRING : n = JSON_GET_STRING(idx, "builtins." + STR$(i) + ".name")
    IF JSON_HAS(hand, "docs." + LOWER$(n)) OR JSON_HAS(hand, "docs." + LOWER$(n) + "$") OR JSON_HAS(prosa, "docs." + UPPER$(n)) OR JSON_HAS(prosa, "docs." + UPPER$(n) + "$") THEN mit = mit + 1
NEXT
PRINT "abdeckung ueber 45 % "; (mit * 100 > gesamt * 45)
--- argumente
{sammlung}/../..
--- erwartet
abs in beiden TRUE
hover zeigt die tabelle TRUE
texte verschieden TRUE
abdeckung ueber 45 % TRUE

=== signaturen nennen ihre parameter
' Bis 2026-09-22 stand bei 62 Befehlen nur "N..M Argumente" -- so zeigte es
' auch der Hover der IDE und jede Fehlermeldung. Nur GUI_RULE bleibt so: dort
' haengt die Argumentzahl an der Art der Regel.
IMPORT "json"
CHDIR(ARG$(0))
DIM j AS JSON_HANDLE
j = JSON_LOAD("daten/builtin_index.json")
DIM n AS INTEGER : n = JSON_LEN(j, "builtins")
DIM i AS INTEGER
DIM ohne AS STRING
FOR i = 0 TO n - 1
    DIM sig AS STRING
    sig = JSON_GET_STRING(j, "builtins." + STR$(i) + ".signature")
    IF INSTR(sig, "Argumente") >= 0 THEN
        ohne = ohne + JSON_GET_STRING(j, "builtins." + STR$(i) + ".name") + " "
    END IF
NEXT
PRINT "ohne parameternamen: "; TRIM$(ohne)
--- argumente
{sammlung}/../..
--- erwartet
ohne parameternamen: GUI_RULE
