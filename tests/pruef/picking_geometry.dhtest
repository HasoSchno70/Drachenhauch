CAMERA3D(0.0, 0.0, 10.0, 0.0, 0.0, 0.0, 45.0)
PRINT PICK_TRI(-100.0,-100.0,0.0, 100.0,-100.0,0.0, 0.0,100.0,0.0)
--- umgebung
DHRT_FRAMES=1
--- erwartet ungefaehr
