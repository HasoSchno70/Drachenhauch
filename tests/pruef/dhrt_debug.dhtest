halt 1
ende done

=== pause haelt ein laufendes programm an
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("lang.dh", ["{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "pause" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "stop" + q + "}"])
DIM n AS INTEGER : n = 0
DIM i AS INTEGER
FOR i = 0 TO LEN(ereignisse) - 1
    IF art$(i) = "paused" THEN n = n + 1
    IF art$(i) = "finished" THEN PRINT "ende "; feld$(i, "reason")
NEXT
PRINT "halte "; n
PRINT INSTR(ausgaben$(), "durch") < 0
