' Ein SMTP-Gegenserver fuer die Pruefsammlung smtp.dhtest -- gerade gross genug,
' um eine Nachricht anzunehmen, und er schreibt mit, was ankam.
' Aufruf: dhrt run smtpserver.dh -- ORDNER FAEHIGKEITEN AUTH_OK RCPT_OK
'   ORDNER        dort landen port.txt, befehle.txt (je Zeile ein Befehl) und daten.txt
'   FAEHIGKEITEN  EHLO-Zeilen mit "|" getrennt, z.B. "AUTH PLAIN LOGIN"
'   AUTH_OK       1 = Anmeldung klappt, 0 = "535 falsch"
'   RCPT_OK       1 = Empfaenger angenommen, 0 = "550 kenne ich nicht"
' Eine Verbindung; danach (oder nach 30 s ohne Verbindung) beendet er sich.
IMPORT "net"

DIM ordner AS STRING : ordner = ARG$(0)
DIM faehigkeiten AS ARRAY OF STRING : faehigkeiten = SPLIT$(ARG$(1), "|")
DIM authOk AS BOOLEAN : authOk = ARG$(2) = "1"
DIM rcptOk AS BOOLEAN : rcptOk = ARG$(3) = "1"
DIM CRLF AS STRING : CRLF = CHR$(13) + CHR$(10)
DIM ENDE AS STRING : ENDE = CHR$(0)

DIM lst AS NET_LISTENER : lst = NET_TCP_LISTEN(0, "127.0.0.1")
DIM befehle AS STRING : befehle = ""
WRITEALL(ordner + "/befehle.txt", "")
WRITEALL(ordner + "/port.txt", STR$(NET_LISTENER_PORT(lst)))

DIM c AS NET_SOCKET
DIM t0 AS INTEGER : t0 = MILLIS()
c = NET_TCP_ACCEPT(lst)
WHILE c = NIL
    IF MILLIS() - t0 > 30000 THEN EXIT(0)
    SLEEP(5)
    c = NET_TCP_ACCEPT(lst)
WEND

DIM puffer AS STRING : puffer = ""
FUNCTION zeile$() AS STRING
    ' Die naechste Zeile ohne Zeilenende; CHR$(0), wenn die Verbindung weg ist.
    DIM t AS INTEGER : t = MILLIS()
    WHILE INSTR(puffer, CHR$(10)) < 0
        IF NOT NET_IS_CONNECTED(c) OR MILLIS() - t > 15000 THEN RETURN ENDE
        puffer = puffer + NET_RECV(c, 65536)
        SLEEP(1)
    WEND
    DIM p AS INTEGER : p = INSTR(puffer, CHR$(10))
    DIM z AS STRING : z = LEFT$(puffer, p)
    puffer = MID$(puffer, p + 1, LEN(puffer))
    IF RIGHT$(z, 1) = CHR$(13) THEN z = LEFT$(z, LEN(z) - 1)
    RETURN z
END FUNCTION

SUB antwort(text AS STRING)
    NET_SEND(c, text + CRLF)
END SUB

SUB merken(text AS STRING)
    ' Vor der Antwort geschrieben: wer die Antwort hat, findet die Zeile schon.
    befehle = befehle + text + CHR$(10)
    WRITEALL(ordner + "/befehle.txt", befehle)
END SUB

antwort("220 mini.beispiel.de ESMTP")
DIM erwarteLogin AS INTEGER : erwarteLogin = 0
WHILE TRUE
    DIM z AS STRING : z = zeile$()
    IF z = ENDE THEN BREAK
    merken(z)
    DIM oben AS STRING : oben = UPPER$(z)
    IF erwarteLogin > 0 THEN
        erwarteLogin = erwarteLogin - 1
        IF erwarteLogin > 0 THEN
            antwort("334 ")
        ELSEIF authOk THEN
            antwort("235 ok")
        ELSE
            antwort("535 falsch")
        END IF
    ELSEIF LEFT$(oben, 4) = "EHLO" OR LEFT$(oben, 4) = "HELO" THEN
        DIM i AS INTEGER
        FOR i = 0 TO LEN(faehigkeiten) - 1
            IF faehigkeiten[i] <> "" AND faehigkeiten[i] <> "-" THEN antwort("250-" + faehigkeiten[i])
        NEXT
        antwort("250 HELP")
    ELSEIF LEFT$(oben, 10) = "AUTH LOGIN" THEN
        erwarteLogin = 2
        antwort("334 ")
    ELSEIF LEFT$(oben, 10) = "AUTH PLAIN" THEN
        IF authOk THEN
            antwort("235 ok")
        ELSE
            antwort("535 falsch")
        END IF
    ELSEIF LEFT$(oben, 9) = "MAIL FROM" THEN
        antwort("250 ok")
    ELSEIF LEFT$(oben, 7) = "RCPT TO" THEN
        IF rcptOk THEN
            antwort("250 ok")
        ELSE
            antwort("550 kenne ich nicht")
        END IF
    ELSEIF oben = "DATA" THEN
        antwort("354 los")
        DIM daten AS STRING : daten = ""
        WHILE TRUE
            DIM d AS STRING : d = zeile$()
            IF d = ENDE OR d = "." THEN BREAK
            ' Punkt-Verdopplung ruecknehmen -- so wie es ein echter Server tut.
            IF LEFT$(d, 2) = ".." THEN d = MID$(d, 1, LEN(d))
            daten = daten + d + CRLF
        WEND
        WRITEALL(ordner + "/daten.txt", daten)
        antwort("250 angenommen")
    ELSEIF oben = "QUIT" THEN
        antwort("221 tschuess")
        SLEEP(50)
        BREAK
    ELSE
        antwort("502 kenne ich nicht")
    END IF
WEND
NET_CLOSE(c)
EXIT(0)
