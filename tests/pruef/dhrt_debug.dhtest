=== waehrend des laufens gesetzt haelt sofort
' Mit "now" gilt ein set-breakpoints auch waehrend das Programm laeuft --
' vorher las der Debugger nur im Halt, und ein Programm, das nie hielt, sah
' einen neuen Haltepunkt nie.
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("lang.dh", ["{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "now" + q + ":true," + q + "lines" + q + ":[4]}", _
    "{" + q + "cmd" + q + ":" + q + "stop" + q + "}"])
DIM i AS INTEGER
FOR i = 0 TO LEN(ereignisse) - 1
    IF art$(i) = "paused" THEN PRINT "halt "; feld$(i, "line")
    IF art$(i) = "finished" THEN PRINT "ende "; feld$(i, "reason")
NEXT
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei lang.dh
DIM i AS INTEGER
FOR i = 1 TO 200
    SLEEP(5)
    i = i
NEXT
PRINT "durch"

--- erwartet
halt 1
halt 4
ende stopped

=== ohne now gilt ein vorab geschicktes set-breakpoints dem naechsten halt
' Die Gegenprobe: dasselbe ohne "now" -- ein Skript, das alles vorab
' schickt, meint den Halt nach dem continue, und es gibt keinen.
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("lang.dh", ["{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "lines" + q + ":[4]}", _
    "{" + q + "cmd" + q + ":" + q + "stop" + q + "}"])
DIM i AS INTEGER
FOR i = 0 TO LEN(ereignisse) - 1
    IF art$(i) = "paused" THEN PRINT "halt "; feld$(i, "line")
    IF art$(i) = "finished" THEN PRINT "ende "; feld$(i, "reason")
NEXT
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei lang.dh
DIM i AS INTEGER
FOR i = 1 TO 20
    SLEEP(1)
    i = i
NEXT
PRINT "durch"

