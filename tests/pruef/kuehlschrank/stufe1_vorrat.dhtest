=== aendern, entnehmen, anlegen -- und rueckgaengig mit derselben id
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
SETENV("KUEHL_EXPORT", CWD$() + "/bestand.csv")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
DIM z AS STRING
FOR EACH z IN READLINES(CWD$() + "/bestand.csv")
    PRINT "csv "; z
NEXT
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO products (name, brand, category) VALUES ('Milch', 'Hof', 'Milchprodukte')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, purchase_date, expiry_date, storage_location) VALUES (1, 2, 'Liter', '2026-11-05', '2026-11-12', 'Kühlschrank')")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS BestandSeite : s = f.bestand
f.geaendert()
FUNCTION stand$() AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT GROUP_CONCAT(i.id || ':' || p.name || ':' || i.quantity, ' ') FROM inventory i JOIN products p ON p.id = i.product_id")
    DIM t AS STRING : t = ""
    IF DB_NEXT(r) THEN t = IIF(DB_IS_NULL(r, 0), "-", DB_GET_STRING(r, 0))
    RETURN t + " | verlauf " + STR$(dbZahl("SELECT COUNT(*) FROM consumption_history")) + " | produkte " + STR$(dbZahl("SELECT COUNT(*) FROM products"))
END FUNCTION
' -1 in Zeile 0 (2 -> 1), zurueck, wieder vor.
s.tabelle_Zelle(0, SP_MINUS)
PRINT "minus "; stand$(); " | "; verlauf.kannZurueck(); " "; verlauf.textZurueck$()
f.miRueckgaengig_Aktion()
PRINT "zurueck "; stand$(); " | "; GUI_STATUSBAR_TEXT$(f.status, 3); " | vor "; GUI_TOOLBAR_ENABLED(f.werkzeuge, KNOPF_WIEDERHOLEN)
f.miWiederholen_Aktion()
PRINT "wieder "; stand$()
' Entnehmen schreibt den Verbrauch und nimmt den Eintrag weg; Rueckgaengig
' bringt ihn mit derselben id 1 zurueck und nimmt die Verlaufszeile weg.
DIM e AS Eintrag : e = eintragLaden(1)
entnehmen(e, "consumed", "Milch verbraucht")
f.geaendert()
DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT product_name, quantity, unit, purchase_date, empty_date, duration_days, storage_location, reason FROM consumption_history")
IF DB_NEXT(r) THEN PRINT "verbrauch "; DB_GET_STRING(r, 0); " "; DB_GET_STRING(r, 1); " "; DB_GET_STRING(r, 2); " "; DB_GET_STRING(r, 3); " "; DB_GET_STRING(r, 4); " "; DB_GET_INT(r, 5); " "; DB_GET_STRING(r, 6); " "; DB_GET_STRING(r, 7)
PRINT "entnommen "; stand$(); " | tabelle "; GUI_TABLE_ROW_COUNT(s.tabelle)
f.miRueckgaengig_Aktion()
PRINT "zurueck "; stand$(); " | tabelle "; GUI_TABLE_ROW_COUNT(s.tabelle); " | "; GUI_TABLE_GET_CELL(s.tabelle, 0, 2)
' Anlegen ueber den Dialog: erst fehlt die Kategorie, dann geht es.
DIM pf AS ProduktFenster : pf = NEW ProduktFenster()
pf.barcode = "4000400"
pf.Zeigen()
PRINT "neu "; GUI_TEXT(pf.titel); " | "; GUI_TEXT(pf.barcodeFeld); " | "; GUI_TEXT(pf.kaufFeld); " | "; GUI_TEXT(pf.ablaufFeld); " | "; GUI_TEXT(pf.einheitListe)
GUI_SET_TEXT(pf.nameFeld, "Käse")
GUI_SET_TEXT(pf.lagerortListe, "Kühlschrank")
pf.knopfSichern_Klick()
PRINT "fehlt "; GUI_TEXT(pf.fehlerText); " | "; pf.gesichert
GUI_SET_TEXT(pf.kategorieListe, "Milchprodukte")
GUI_SET_TEXT(pf.ablaufFeld, "2026-13-01")
pf.knopfSichern_Klick()
PRINT "datum "; GUI_TEXT(pf.fehlerText)
pf.plus14_Klick()
GUI_SET_CHECKED(pf.minKasten, TRUE)
GUI_SET_VALUE(pf.minFeld, 3)
pf.knopfSichern_Klick()
PRINT "gesichert "; pf.gesichert; " | "; stand$()
r = DB_QUERY(db, "SELECT p.barcode, p.min_quantity, p.min_unit, i.expiry_date FROM inventory i JOIN products p ON p.id = i.product_id WHERE p.name = 'Käse'")
IF DB_NEXT(r) THEN PRINT "kaese "; DB_GET_STRING(r, 0); " "; DB_GET_STRING(r, 1); " "; DB_GET_STRING(r, 2); " "; DB_GET_STRING(r, 3)
' Anlegen und Mindestmenge sind zwei Schritte; zweimal zurueck nimmt das
' neue Produkt samt Eintrag weg.
PRINT "tipp "; verlauf.textZurueck$()
f.miRueckgaengig_Aktion()
f.miRueckgaengig_Aktion()
PRINT "ohne kaese "; stand$()
f.miWiederholen_Aktion()
PRINT "kaese wieder "; stand$()
' Bearbeiten aendert Eintrag und Produkt in einem Schritt.
DIM be AS ProduktFenster : be = NEW ProduktFenster()
be.eintragId = 1
be.Zeigen()
PRINT "bearbeiten "; GUI_TEXT(be.titel); " | "; GUI_TEXT(be.nameFeld); " | "; GUI_ENABLED(be.barcodeFeld)
GUI_SET_TEXT(be.nameFeld, "Vollmilch")
GUI_SET_TEXT(be.marktListe, "EDEKA")
be.knopfSichern_Klick()
PRINT "geaendert "; stand$(); " | markt "; eintragLaden(1).markt
f.miRueckgaengig_Aktion()
PRINT "zurueck "; stand$(); " | markt ["; eintragLaden(1).markt; "]"
f.miExport_Aktion()
--- erwartet
minus 1:Milch:1.0 | verlauf 0 | produkte 1 | TRUE Milch: 1 Liter
zurueck 1:Milch:2.0 | verlauf 0 | produkte 1 | Rückgängig: Milch: 1 Liter | vor TRUE
wieder 1:Milch:1.0 | verlauf 0 | produkte 1
verbrauch Milch 1 Liter 2026-11-05 2026-11-08 3 Kühlschrank consumed
