=== hochzaehlen vor einem fehler zaehlt einmal
DIM zaehler AS INTEGER
DIM teiler AS INTEGER
FUNCTION kaputt(n AS INTEGER) AS INTEGER
    zaehler = zaehler + 1
    RETURN n \ teiler
END FUNCTION
teiler = 2
PRINT kaputt(10); " "; zaehler
teiler = 0
TRY
    PRINT kaputt(10)
CATCH e
    PRINT e
END TRY
PRINT zaehler
teiler = 5
PRINT kaputt(10); " "; zaehler
--- erwartet
5 1
Integer-Division durch 0
2
2 3

