' Rückgängig und Wiederholen für Änderungen an der Datenbank. Ein Schritt hält
' je betroffener Zeile ihren Stand vorher und nachher; Rückgängig setzt den
' Stand vorher wieder ein -- mit derselben id. (Das Undo der Python-App legte
' Gelöschtes neu an und scheiterte an Spalten, die es nicht gibt.) Höchstens
' 50 Schritte wie dort.
CLASS Verlauf
    DIM zurueck AS ARRAY OF Schritt
    DIM vor AS ARRAY OF Schritt
    DIM offen AS Schritt

    SUB beginnen(text AS STRING)
        Self.offen = NEW Schritt()
        Self.offen.text = text
        Self.offen.teile = []
    END SUB

    ' Eine Zeile, die sich gleich ändert oder verschwindet.
    SUB merken(tabelle AS STRING, id AS INTEGER)
        DIM a AS Aenderung : a = NEW Aenderung()
        a.tabelle = tabelle
        a.id = id
        a.vorher = Self.zeileJson$(tabelle, id)
        ARRAY_PUSH(Self.offen.teile, a)
    END SUB

    ' Eine Zeile, die eben entstanden ist.
    SUB neu(tabelle AS STRING, id AS INTEGER)
        DIM a AS Aenderung : a = NEW Aenderung()
        a.tabelle = tabelle
        a.id = id
        a.vorher = ""
        ARRAY_PUSH(Self.offen.teile, a)
    END SUB

    SUB abschliessen()
        DIM a AS Aenderung
        FOR EACH a IN Self.offen.teile
            a.nachher = Self.zeileJson$(a.tabelle, a.id)
        NEXT
        ARRAY_PUSH(Self.zurueck, Self.offen)
        IF LEN(Self.zurueck) > 50 THEN ARRAY_REMOVE_AT(Self.zurueck, 0)
        Self.vor = []
        Self.offen = NIL
    END SUB

    FUNCTION kannZurueck() AS BOOLEAN
        RETURN LEN(Self.zurueck) > 0
    END FUNCTION

    FUNCTION kannVor() AS BOOLEAN
        RETURN LEN(Self.vor) > 0
    END FUNCTION

    FUNCTION textZurueck$() AS STRING
        IF LEN(Self.zurueck) = 0 THEN RETURN ""
        RETURN Self.zurueck[LEN(Self.zurueck) - 1].text
    END FUNCTION

    FUNCTION textVor$() AS STRING
        IF LEN(Self.vor) = 0 THEN RETURN ""
        RETURN Self.vor[LEN(Self.vor) - 1].text
    END FUNCTION

    ' Nimmt den letzten Schritt zurück; liefert seinen Text ("" = keiner).
    FUNCTION rueckgaengig$() AS STRING
        IF LEN(Self.zurueck) = 0 THEN RETURN ""
        DIM s AS Schritt : s = Self.zurueck[LEN(Self.zurueck) - 1]
        ARRAY_REMOVE_AT(Self.zurueck, LEN(Self.zurueck) - 1)
        DB_BEGIN(db)
        DIM k AS INTEGER
        FOR k = LEN(s.teile) - 1 TO 0 STEP -1
            Self.zeileSetzen(s.teile[k].tabelle, s.teile[k].id, s.teile[k].vorher)
        NEXT
        DB_COMMIT(db)
        ARRAY_PUSH(Self.vor, s)
        RETURN s.text
    END FUNCTION

    FUNCTION wiederholen$() AS STRING
        IF LEN(Self.vor) = 0 THEN RETURN ""
        DIM s AS Schritt : s = Self.vor[LEN(Self.vor) - 1]
        ARRAY_REMOVE_AT(Self.vor, LEN(Self.vor) - 1)
        DB_BEGIN(db)
        DIM a AS Aenderung
        FOR EACH a IN s.teile
            Self.zeileSetzen(a.tabelle, a.id, a.nachher)
        NEXT
        DB_COMMIT(db)
        ARRAY_PUSH(Self.zurueck, s)
        RETURN s.text
    END FUNCTION

    ' Der Stand einer Zeile als JSON ("" = es gibt sie nicht).
    FUNCTION zeileJson$(tabelle AS STRING, id AS INTEGER) AS STRING
        DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT * FROM " + CHR$(34) + tabelle + CHR$(34) + " WHERE rowid = ?", id)
        IF NOT DB_NEXT(r) THEN RETURN ""
        DIM j AS JSON_HANDLE : j = JSON_NEW_OBJECT()
        DIM i AS INTEGER
        FOR i = 0 TO DB_COL_COUNT(r) - 1
            IF DB_IS_NULL(r, i) THEN
                JSON_SET_NULL(j, JSON_KEY$(DB_COL_NAME(r, i)))
            ELSE
                JSON_SET_STRING(j, JSON_KEY$(DB_COL_NAME(r, i)), DB_GET_STRING(r, i))
            END IF
        NEXT
        DB_CLOSE_RESULT(r)
        RETURN JSON_STRINGIFY(j)
    END FUNCTION

    ' Eine Zeile auf einen Stand setzen: "" löscht sie, sonst UPDATE oder,
    ' wenn es sie nicht gibt, INSERT. Kein REPLACE -- das löschte vorher und
    ' nähme über ON DELETE CASCADE den Bestand eines Produkts mit.
    SUB zeileSetzen(tabelle AS STRING, id AS INTEGER, stand AS STRING)
        DIM t AS STRING : t = CHR$(34) + tabelle + CHR$(34)
        IF stand = "" THEN
            DB_EXEC(db, "DELETE FROM " + t + " WHERE rowid = ?", id)
            RETURN
        END IF
        DIM j AS JSON_HANDLE : j = JSON_PARSE(stand)
        DIM spalten AS ARRAY OF STRING : spalten = []
        DIM werte AS ARRAY OF STRING : werte = []
        DIM paare AS ARRAY OF STRING : paare = []
        DIM k AS STRING
        FOR EACH k IN JSON_KEYS(j, "")
            DIM w AS STRING : w = "NULL"
            IF JSON_TYPE(j, JSON_KEY$(k)) <> "null" THEN w = "'" + REPLACE$(JSON_GET_STRING(j, JSON_KEY$(k)), "'", "''") + "'"
            ARRAY_PUSH(spalten, CHR$(34) + k + CHR$(34))
            ARRAY_PUSH(werte, w)
            ARRAY_PUSH(paare, CHR$(34) + k + CHR$(34) + " = " + w)
        NEXT
        IF dbZahlEin("SELECT COUNT(*) FROM " + t + " WHERE rowid = ?", STR$(id)) > 0 THEN
            DB_EXEC(db, "UPDATE " + t + " SET " + JOIN$(paare, ", ") + " WHERE rowid = ?", id)
        ELSE
            DB_EXEC(db, "INSERT INTO " + t + " (" + JOIN$(spalten, ", ") + ") VALUES (" + JOIN$(werte, ", ") + ")")
        END IF
    END SUB
END CLASS
