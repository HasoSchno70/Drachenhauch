' Spiegel der Bedienelemente: ein Wert, den das PROGRAMM setzt, sieht fuer
' die Aenderungs-Erkennung wie eine Eingabe aus. Was zuletzt hineingestellt
' wurde, steht hier -- nur eine Abweichung davon ist eine Eingabe.
DIM lBpm AS INTEGER
DIM lKan AS INTEGER
DIM lPat AS INTEGER
DIM lRows AS INTEGER
DIM lVol AS INTEGER
DIM lSlide AS INTEGER
DIM lFx AS INTEGER
DIM lFxp AS INTEGER
DIM lZInst AS INTEGER
DIM lChInst AS INTEGER
DIM lWave AS INTEGER
DIM lMute AS BOOLEAN
DIM lSolo AS BOOLEAN
DIM lChVol AS INTEGER
DIM lIWave AS INTEGER
DIM lIVol AS INTEGER
DIM lA AS INTEGER
DIM lD AS INTEGER
DIM lS AS INTEGER
DIM lR AS INTEGER
DIM lVibD AS INTEGER
DIM lVibS AS INTEGER
DIM lDet AS INTEGER
DIM lPan AS INTEGER
DIM lOrder AS INTEGER
DIM lKanalAnz AS INTEGER : lKanalAnz = -1   ' der Kanal, den die Spalte zeigt
DIM lInstAnz AS INTEGER : lInstAnz = -1     ' das Instrument, das der Kasten zeigt

FUNCTION waveIndex(wf AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(wellenformen) - 1
        IF wellenformen[i] = wf THEN RETURN i
    NEXT
    RETURN 0
END FUNCTION

FUNCTION instListe$() AS STRING
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO instAnz - 1
        s = s + "|" + STR$(i + 1) + " " + iName[i]
    NEXT
    RETURN s
END FUNCTION

SUB patternListeAnzeigen()
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO patAnz - 1
        IF i > 0 THEN s = s + "|"
        s = s + patName[i] + " (" + STR$(patRows[i]) + ")"
    NEXT
    GUI_SET_DROPDOWN(ddPat, SPLIT$(s, "|"))
    GUI_DROPDOWN_SET_SELECTED(ddPat, patAkt)
    lPat = patAkt
    GUI_SET_VALUE(spRows, patRows[patAkt])
    lRows = patRows[patAkt]
END SUB

SUB orderAnzeigen()
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO orderAnz - 1
        IF i > 0 THEN s = s + "|"
        s = s + STR$(i + 1) + ": " + patName[order[i]]
    NEXT
    GUI_SET_LISTBOX(lstOrder, SPLIT$(s, "|"))
    IF lOrder >= orderAnz THEN lOrder = orderAnz - 1
    IF lOrder < 0 THEN lOrder = 0
    GUI_LISTBOX_SET_SELECTED(lstOrder, lOrder)
END SUB

SUB zelleAnzeigen()
    DIM p AS INTEGER : p = patAkt
    lVol = vol[p, curC, curR] : GUI_SET_VALUE(spVol, lVol)
    lSlide = slide[p, curC, curR] : GUI_SET_VALUE(spSlide, lSlide)
    lFx = fx[p, curC, curR] : GUI_DROPDOWN_SET_SELECTED(ddFx, lFx)
    lFxp = fxp[p, curC, curR] : GUI_SET_VALUE(spFxp, lFxp)
    lZInst = inst[p, curC, curR] + 1 : GUI_DROPDOWN_SET_SELECTED(ddZInst, lZInst)
END SUB

SUB kanalAnzeigen()
    lKanalAnz = curC
    DIM art AS STRING : art = "Ton"
    IF istDrum(curC) THEN art = "Schlagzeug"
    GUI_SET_TEXT(lblKanal, "Kanal " + STR$(curC + 1) + " (" + art + ")")
    lChInst = chInst[curC] + 1 : GUI_DROPDOWN_SET_SELECTED(ddChInst, lChInst)
    lWave = waveIndex(wave[curC]) : GUI_DROPDOWN_SET_SELECTED(ddWave, lWave)
    lMute = mute[curC] : GUI_SET_CHECKED(cbMute, lMute)
    lSolo = solo[curC] : GUI_SET_CHECKED(cbSolo, lSolo)
    lChVol = INT(chVol[curC] * 100.0 + 0.5) : GUI_SET_VALUE(slChVol, lChVol)
    GUI_SET_ENABLED(ddWave, chInst[curC] < 0 AND NOT istDrum(curC))
END SUB

SUB instrumentAnzeigen()
    DIM ii AS INTEGER : ii = chInst[curC]
    lInstAnz = ii
    DIM da AS BOOLEAN : da = (ii >= 0)
    GUI_SET_ENABLED(ddIWave, da) : GUI_SET_ENABLED(spIVol, da)
    GUI_SET_ENABLED(spA, da) : GUI_SET_ENABLED(spD, da)
    GUI_SET_ENABLED(spS, da) : GUI_SET_ENABLED(spR, da)
    GUI_SET_ENABLED(spVibD, da) : GUI_SET_ENABLED(spVibS, da)
    GUI_SET_ENABLED(spDet, da) : GUI_SET_ENABLED(slPan, da)
    GUI_SET_ENABLED(bIDel, da)
    IF NOT da THEN
        GUI_SET_TEXT(lblIName, "(Kanal ohne Instrument)")
        RETURN
    END IF
    GUI_SET_TEXT(lblIName, STR$(ii + 1) + " " + iName[ii])
    DIM wi AS INTEGER : wi = waveIndex(iWave[ii])
    IF iWave[ii] = "noise" THEN wi = 4
    lIWave = wi : GUI_DROPDOWN_SET_SELECTED(ddIWave, wi)
    lIVol = iVol[ii] : GUI_SET_VALUE(spIVol, lIVol)
    lA = iAtk[ii] : GUI_SET_VALUE(spA, lA)
    lD = iDec[ii] : GUI_SET_VALUE(spD, lD)
    lS = INT(iSus[ii] * 100.0 + 0.5) : GUI_SET_VALUE(spS, lS)
    lR = iRel[ii] : GUI_SET_VALUE(spR, lR)
    lVibD = INT(iVibD[ii] * 100.0 + 0.5) : GUI_SET_VALUE(spVibD, lVibD)
    lVibS = INT(iVibS[ii] + 0.5) : GUI_SET_VALUE(spVibS, lVibS)
    lDet = INT(iDet[ii] + 0.5) : GUI_SET_VALUE(spDet, lDet)
    lPan = INT(iPan[ii] * 100.0) : GUI_SET_VALUE(slPan, lPan)
END SUB

SUB instrumentListenAnzeigen()
    DIM l AS STRING : l = instListe$()
    GUI_SET_DROPDOWN(ddChInst, SPLIT$("Wellenform" + l, "|"))
    GUI_SET_DROPDOWN(ddZInst, SPLIT$("Standard" + l, "|"))
END SUB

' Alles nachfuehren -- nach Laden, Neu, Rueckgaengig.
SUB allesAnzeigen()
    lBpm = bpm : GUI_SET_VALUE(spBpm, bpm)
    lKan = kanaele : GUI_SET_VALUE(spKan, kanaele)
    IF patAkt >= patAnz THEN patAkt = patAnz - 1
    IF curC >= kanaele THEN curC = kanaele - 1
    IF curR >= patRows[patAkt] THEN curR = patRows[patAkt] - 1
    patternListeAnzeigen()
    orderAnzeigen()
    instrumentListenAnzeigen()
    kanalAnzeigen()
    instrumentAnzeigen()
    zelleAnzeigen()
    GUI_SET_TEXT(lblStatus, meldung)
END SUB

' ------------------------------------------------------------ Bearbeiten
SUB cursorSichtbar()
    DIM sichtR AS INTEGER : sichtR = (GUI_CANVAS_H(gitter) - HDR_H) \ ROW_H
    DIM sichtC AS INTEGER : sichtC = (GUI_CANVAS_W(gitter) - RH_W) \ CELL_W
    IF curR < rowOff THEN rowOff = curR
    IF curR >= rowOff + sichtR THEN rowOff = curR - sichtR + 1
    IF curC < chOff THEN chOff = curC
    IF curC >= chOff + sichtC THEN chOff = curC - sichtC + 1
    IF rowOff < 0 THEN rowOff = 0
    IF chOff < 0 THEN chOff = 0
END SUB

SUB cursorSetzen(c AS INTEGER, r AS INTEGER, auswahl AS BOOLEAN)
    curC = CLAMP(c, 0, kanaele - 1)
    curR = CLAMP(r, 0, patRows[patAkt] - 1)
    IF auswahl THEN
        selAn = (curC <> ankC OR curR <> ankR)
    ELSE
        selAn = FALSE : ankC = curC : ankR = curR
    END IF
    cursorSichtbar()
    zelleAnzeigen()
END SUB

' Der markierte Block als Rechteck -- ohne Auswahl die Cursorzelle.
FUNCTION selC0() AS INTEGER
    IF selAn THEN RETURN MIN(ankC, curC)
    RETURN curC
END FUNCTION
FUNCTION selC1() AS INTEGER
    IF selAn THEN RETURN MAX(ankC, curC)
    RETURN curC
END FUNCTION
FUNCTION selR0() AS INTEGER
    IF selAn THEN RETURN MIN(ankR, curR)
    RETURN curR
END FUNCTION
FUNCTION selR1() AS INTEGER
    IF selAn THEN RETURN MAX(ankR, curR)
    RETURN curR
END FUNCTION

SUB noteSetzen(midi AS INTEGER)
    zelleSetzen(patAkt, curC, curR, midi)
    geaendert()
    IF midi >= 0 THEN vorhoeren(curC, midi)
    ' Eine Reihe weiter -- so tippt man eine Melodie ohne Pfeiltaste.
    cursorSetzen(curC, MIN(curR + 1, patRows[patAkt] - 1), FALSE)
END SUB

SUB blockLoeschen()
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = selC0() TO selC1()
        FOR r = selR0() TO selR1()
            zelleSetzen(patAkt, c, r, LEER)
        NEXT
    NEXT
    geaendert()
    zelleAnzeigen()
END SUB

SUB blockKopieren(ausschneiden AS BOOLEAN)
    DIM c AS INTEGER
    DIM r AS INTEGER
    cbW = selC1() - selC0() + 1
    cbH = selR1() - selR0() + 1
    FOR c = 0 TO cbW - 1
        FOR r = 0 TO cbH - 1
            DIM sc AS INTEGER : sc = selC0() + c
            DIM sr AS INTEGER : sr = selR0() + r
            cbNote[c, r] = note[patAkt, sc, sr]
            cbVol[c, r] = vol[patAkt, sc, sr]
            cbSlide[c, r] = slide[patAkt, sc, sr]
            cbFx[c, r] = fx[patAkt, sc, sr]
            cbFxp[c, r] = fxp[patAkt, sc, sr]
            cbInst[c, r] = inst[patAkt, sc, sr]
        NEXT
    NEXT
    IF ausschneiden THEN blockLoeschen()
    meldung = "Block " + STR$(cbW) + " x " + STR$(cbH) + IIF(ausschneiden, " ausgeschnitten", " kopiert")
END SUB

' Am Rand wird geschnitten, nicht gemeldet -- wie in der Qt-Fassung.
SUB blockEinfuegen()
    IF cbW = 0 THEN RETURN
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = 0 TO cbW - 1
        FOR r = 0 TO cbH - 1
            DIM zc AS INTEGER : zc = curC + c
            DIM zr AS INTEGER : zr = curR + r
            IF zc < kanaele AND zr < patRows[patAkt] THEN
                zelleSetzen(patAkt, zc, zr, cbNote[c, r])
                IF cbNote[c, r] >= 0 THEN
                    vol[patAkt, zc, zr] = cbVol[c, r]
                    slide[patAkt, zc, zr] = cbSlide[c, r]
                    fx[patAkt, zc, zr] = cbFx[c, r]
                    fxp[patAkt, zc, zr] = cbFxp[c, r]
                    inst[patAkt, zc, zr] = cbInst[c, r]
                END IF
            END IF
        NEXT
    NEXT
    geaendert()
    zelleAnzeigen()
END SUB

' Der Schlagzeugkanal bleibt stehen: seine "Note" ist nur ein Schlag.
SUB blockTransponieren(halbtoene AS INTEGER)
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = selC0() TO selC1()
        IF NOT istDrum(c) THEN
            FOR r = selR0() TO selR1()
                IF note[patAkt, c, r] >= 0 THEN
                    note[patAkt, c, r] = CLAMP(note[patAkt, c, r] + halbtoene, 0, 127)
                END IF
            NEXT
        END IF
    NEXT
    geaendert()
END SUB

' Je Kanal eine gerade Rampe von der ersten zur letzten Note im Block;
' belegte Zwischenzellen bleiben, wie sie sind.
SUB blockInterpolieren()
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = selC0() TO selC1()
        IF NOT istDrum(c) THEN
            DIM erste AS INTEGER : erste = -1
            DIM letzte AS INTEGER : letzte = -1
            FOR r = selR0() TO selR1()
                IF note[patAkt, c, r] >= 0 THEN
                    IF erste < 0 THEN erste = r
                    letzte = r
                END IF
            NEXT
            IF erste >= 0 AND letzte > erste THEN
                DIM n0 AS INTEGER : n0 = note[patAkt, c, erste]
                DIM n1 AS INTEGER : n1 = note[patAkt, c, letzte]
                FOR r = erste + 1 TO letzte - 1
                    IF note[patAkt, c, r] = LEER THEN
                        DIM t AS FLOAT : t = (r - erste) / (letzte - erste)
                        zelleSetzen(patAkt, c, r, CLAMP(INT(n0 + (n1 - n0) * t + 0.5), 0, 127))
                    END IF
                NEXT
            END IF
        END IF
    NEXT
    geaendert()
END SUB

SUB kanaeleSetzen(n AS INTEGER)
    n = CLAMP(n, MIN_CH, MAX_CH)
    IF n = kanaele THEN RETURN
    DIM i AS INTEGER
    DIM p AS INTEGER
    DIM r AS INTEGER
    ' Neue Kanaele kommen leer; ueberzaehlige verlieren ihren Inhalt -- die
    ' Datei hat danach nur noch so viele.
    FOR i = MIN(n, kanaele) TO MAX_CH - 1
        wave[i] = "square" : chInst[i] = -1 : chVol[i] = 1.0
        mute[i] = FALSE : solo[i] = FALSE
        FOR p = 0 TO patAnz - 1
            FOR r = 0 TO MAX_ROWS - 1
                zelleSetzen(p, i, r, LEER)
            NEXT
        NEXT
    NEXT
    kanaele = n
    IF curC >= kanaele THEN curC = kanaele - 1
    selAn = FALSE
    geaendert()
    kanalAnzeigen()
    instrumentAnzeigen()
    zelleAnzeigen()
END SUB

SUB reihenSetzen(n AS INTEGER)
    n = CLAMP(n, 1, MAX_ROWS)
    IF n = patRows[patAkt] THEN RETURN
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR r = n TO MAX_ROWS - 1
        FOR c = 0 TO MAX_CH - 1
            zelleSetzen(patAkt, c, r, LEER)
        NEXT
    NEXT
    patRows[patAkt] = n
    IF curR >= n THEN curR = n - 1
    selAn = FALSE
    geaendert()
    patternListeAnzeigen()
    orderAnzeigen()
END SUB

SUB patternWaehlen(p AS INTEGER)
    IF p < 0 OR p >= patAnz OR p = patAkt THEN RETURN
    patAkt = p
    selAn = FALSE
    IF curR >= patRows[patAkt] THEN curR = patRows[patAkt] - 1
    rowOff = MIN(rowOff, MAX(0, patRows[patAkt] - 1))
    patternListeAnzeigen()
    zelleAnzeigen()
END SUB

SUB patternNeu(kopie AS BOOLEAN)
    IF patAnz >= MAX_PAT THEN meldung = "Hoechstens " + STR$(MAX_PAT) + " Patterns" : RETURN
    DIM p AS INTEGER : p = patAnz
    patternLeeren(p)
    patRows[p] = 16
    patName[p] = "P" + STR$(p + 1)
    IF kopie THEN
        patternKopieren(patAkt, p)
        patName[p] = patName[patAkt] + "*"
    END IF
    patAnz = patAnz + 1
    geaendert()
    patAkt = p - 1        ' damit patternWaehlen die Anzeige nachzieht
    patternWaehlen(p)
END SUB

SUB patternLoeschen()
    IF patAnz <= 1 THEN meldung = "Das letzte Pattern bleibt." : RETURN
    DIM p AS INTEGER
    FOR p = patAkt TO patAnz - 2
        patternKopieren(p + 1, p)
        patName[p] = patName[p + 1]
    NEXT
    patAnz = patAnz - 1
    ' Reihenfolge nachziehen: Verweise auf das geloeschte fallen weg,
    ' hoehere ruecken nach; leer darf sie nicht werden.
    DIM neu AS INTEGER : neu = 0
    DIM i AS INTEGER
    FOR i = 0 TO orderAnz - 1
        IF order[i] <> patAkt THEN
            order[neu] = IIF(order[i] > patAkt, order[i] - 1, order[i])
            neu = neu + 1
        END IF
    NEXT
    orderAnz = neu
    IF orderAnz = 0 THEN order[0] = 0 : orderAnz = 1
    IF patAkt >= patAnz THEN patAkt = patAnz - 1
    IF curR >= patRows[patAkt] THEN curR = patRows[patAkt] - 1
    selAn = FALSE
    geaendert()
    patternListeAnzeigen()
    orderAnzeigen()
    zelleAnzeigen()
END SUB

SUB instrumentNeu()
    IF instAnz >= MAX_INST THEN meldung = "Hoechstens " + STR$(MAX_INST) + " Instrumente" : RETURN
    DIM q AS INTEGER : q = chInst[curC]
    DIM i AS INTEGER : i = instAnz
    IF q >= 0 THEN
        instrumentSetzen(i, iName[q] + " (Kopie)", iWave[q], iAtk[q], iDec[q], iSus[q], _
                         iRel[q], iVibD[q], iVibS[q], iDet[q])
        iPan[i] = iPan[q] : iVol[i] = iVol[q]
    ELSE
        instrumentSetzen(i, "Neu", wave[curC], 0, 0, 1.0, 20, 0.0, 0.0, 0.0)
    END IF
    instAnz = instAnz + 1
    chInst[curC] = i
    cacheLeeren()
    geaendert()
    instrumentListenAnzeigen()
    kanalAnzeigen()
    instrumentAnzeigen()
END SUB

' Kanal-Zuweisungen UND die Nummern in den Zellen ruecken nach -- sonst
' zeigte jede Note hinter dem entfernten auf das falsche Instrument.
SUB instrumentEntfernen()
    DIM q AS INTEGER : q = chInst[curC]
    IF q < 0 THEN RETURN
    DIM i AS INTEGER
    FOR i = q TO instAnz - 2
        instrumentSetzen(i, iName[i + 1], iWave[i + 1], iAtk[i + 1], iDec[i + 1], iSus[i + 1], _
                         iRel[i + 1], iVibD[i + 1], iVibS[i + 1], iDet[i + 1])
        iPan[i] = iPan[i + 1] : iVol[i] = iVol[i + 1]
    NEXT
    instAnz = instAnz - 1
    FOR i = 0 TO MAX_CH - 1
        IF chInst[i] = q THEN chInst[i] = -1
        IF chInst[i] > q THEN chInst[i] = chInst[i] - 1
    NEXT
    DIM p AS INTEGER
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR p = 0 TO patAnz - 1
        FOR c = 0 TO kanaele - 1
            FOR r = 0 TO patRows[p] - 1
                IF inst[p, c, r] = q THEN inst[p, c, r] = -1
                IF inst[p, c, r] > q THEN inst[p, c, r] = inst[p, c, r] - 1
            NEXT
        NEXT
    NEXT
    cacheLeeren()
    geaendert()
    instrumentListenAnzeigen()
    kanalAnzeigen()
    instrumentAnzeigen()
    zelleAnzeigen()
END SUB

' ------------------------------------------------------------ Dateien
SUB songNeu()
    stopp()
    neuerSong()
    cacheLeeren()
    dateiPfad = ""
    dirty = FALSE
    meldung = "Neuer Song."
    allesAnzeigen()
    verlaufLeeren()
END SUB

SUB oeffnen()
    DIM p AS STRING : p = FILE_OPEN_DIALOG("Song oeffnen", "json")
    IF p = "" THEN RETURN
    ladeDatei(p)
END SUB

SUB ladeDatei(p AS STRING)
    stopp()
    TRY
        DIM h AS JSON_HANDLE : h = JSON_LOAD(p)
        songAusHandle(h)
        cacheLeeren()
        dateiPfad = p
        dirty = FALSE
        meldung = "Geladen: " + p
        allesAnzeigen()
        verlaufLeeren()
    CATCH e
        meldung = "Laden fehlgeschlagen: " + e
        GUI_SET_TEXT(lblStatus, meldung)
    END TRY
END SUB

SUB speichern(als AS BOOLEAN)
    DIM p AS STRING : p = dateiPfad
    IF als OR p = "" THEN p = FILE_SAVE_DIALOG("Song sichern", "song.json", "json")
    IF p = "" THEN RETURN
    WRITEALL(p, JSON_PRETTY(songHandle()))
    dateiPfad = p
    dirty = FALSE
    meldung = "Gesichert: " + p
END SUB

SUB gbCodeSichern(p AS STRING)
    WRITEALL(p, gbCode$())
    meldung = "GB-Code gesichert: " + p
END SUB

' ------------------------------------------------------------ Zeichnen
DIM akzent AS ARRAY OF INTEGER
akzent = [&H2BC4E8, &HF0B040, &H60E0A0, &HE070E0, &H80A0FF, &HFF8060, &HC0E060, &H60D0D0]

FUNCTION kanalFarbe(c AS INTEGER) AS INTEGER
    IF istDrum(c) THEN RETURN &HFF60E0
    RETURN akzent[c MOD 8]
END FUNCTION

SUB zeichneGitter()
    DIM gx AS INTEGER : gx = GUI_CANVAS_X(gitter)
    DIM gy AS INTEGER : gy = GUI_CANVAS_Y(gitter)
    DIM gw AS INTEGER : gw = GUI_CANVAS_W(gitter)
    DIM gh AS INTEGER : gh = GUI_CANVAS_H(gitter)
    SCISSOR(gx, gy, gw, gh)
    BOX(gx, gy, gx + gw - 1, gy + gh - 1, &H0A0E14)
    DIM sichtR AS INTEGER : sichtR = (gh - HDR_H) \ ROW_H + 1
    DIM sichtC AS INTEGER : sichtC = (gw - RH_W) \ CELL_W + 1
    DIM p AS INTEGER : p = patAkt
    DIM c AS INTEGER
    DIM r AS INTEGER
    ' Reihen: Beat-Raster, Cursor, Wiedergabe
    FOR r = rowOff TO MIN(patRows[p] - 1, rowOff + sichtR - 1)
        DIM y AS INTEGER : y = gy + HDR_H + (r - rowOff) * ROW_H
        DIM hg AS INTEGER : hg = &H0A0E14
        IF r MOD 4 = 0 THEN hg = &H121A24
        IF r MOD 16 = 0 THEN hg = &H18222E
        IF kopfPat = p AND kopfRow = r THEN hg = &H1E4A2E
        BOX(gx, y, gx + gw - 1, y + ROW_H - 1, hg)
        TEXT(gx + 6, y + 2, RIGHT$("0" + STR$(r), 2), &H8090A0)
    NEXT
    ' Auswahl
    IF selAn THEN
        DIM sx0 AS INTEGER : sx0 = gx + RH_W + (selC0() - chOff) * CELL_W
        DIM sy0 AS INTEGER : sy0 = gy + HDR_H + (selR0() - rowOff) * ROW_H
        DIM sx1 AS INTEGER : sx1 = gx + RH_W + (selC1() - chOff + 1) * CELL_W - 1
        DIM sy1 AS INTEGER : sy1 = gy + HDR_H + (selR1() - rowOff + 1) * ROW_H - 1
        BOX(sx0, sy0, sx1, sy1, &H70305A9A)
    END IF
    ' Zellen
    FOR c = chOff TO MIN(kanaele - 1, chOff + sichtC - 1)
        DIM x AS INTEGER : x = gx + RH_W + (c - chOff) * CELL_W
        LINE(x, gy, x, gy + gh - 1, &H1E2A38)
        FOR r = rowOff TO MIN(patRows[p] - 1, rowOff + sichtR - 1)
            DIM y2 AS INTEGER : y2 = gy + HDR_H + (r - rowOff) * ROW_H
            DIM n AS INTEGER : n = note[p, c, r]
            DIM nf AS INTEGER : nf = kanalFarbe(c)
            IF n = LEER THEN nf = &H303A46
            IF n = NOTE_OFF THEN nf = &H8090A0
            DIM tx AS INTEGER : tx = x + 5
            TEXT(tx, y2 + 2, notenName$(n), nf)
            IF n >= 0 THEN
                tx = tx + 34
                IF vol[p, c, r] > 0 THEN
                    TEXT(tx, y2 + 2, "v" + STR$(vol[p, c, r]), &H7FE0C0) : tx = tx + 26
                END IF
                IF slide[p, c, r] <> 0 THEN
                    TEXT(tx, y2 + 2, "s" + IIF(slide[p, c, r] > 0, "+", "") + STR$(slide[p, c, r]), &HFFC060)
                    tx = tx + 30
                END IF
                IF fx[p, c, r] <> 0 THEN
                    DIM fn AS STRING
                    fn = MID$("ArpVibRetOff", (fx[p, c, r] - 1) * 3, 3) + STR$(fxp[p, c, r])
                    TEXT(tx, y2 + 2, fn, &HFF60E0)
                END IF
                IF inst[p, c, r] >= 0 THEN
                    TEXT(x + CELL_W - 24, y2 + 2, "i" + STR$(inst[p, c, r] + 1), &HA0A8B0)
                END IF
            END IF
        NEXT
    NEXT
    ' Cursor
    DIM cx AS INTEGER : cx = gx + RH_W + (curC - chOff) * CELL_W
    DIM cy AS INTEGER : cy = gy + HDR_H + (curR - rowOff) * ROW_H
    RECT(cx, cy, cx + CELL_W - 1, cy + ROW_H - 1, &H2BC4E8)
    ' Kopfzeile zuletzt -- ueber den Zellen, die darunter herausrollen
    BOX(gx, gy, gx + gw - 1, gy + HDR_H - 1, &H141C26)
    FOR c = chOff TO MIN(kanaele - 1, chOff + sichtC - 1)
        DIM hx AS INTEGER : hx = gx + RH_W + (c - chOff) * CELL_W
        DIM kn AS STRING : kn = "Ch" + STR$(c + 1)
        IF istDrum(c) THEN kn = "Drum"
        IF mute[c] THEN kn = kn + " M"
        IF solo[c] THEN kn = kn + " S"
        DIM nm AS STRING : nm = wave[c]
        IF chInst[c] >= 0 THEN nm = iName[chInst[c]]
        IF istDrum(c) AND chInst[c] < 0 THEN nm = "noise"
        TEXT(hx + 5, gy + 4, kn, kanalFarbe(c))
        DIM kb AS INTEGER : kb = TEXT_WIDTH(kn)
        TEXT_SIZE(12)
        TEXT(hx + 5 + kb + 8, gy + 7, LEFT$(nm, 10), &H8090A0)
        TEXT_SIZE(16)
    NEXT
    LINE(gx, gy + HDR_H - 1, gx + gw - 1, gy + HDR_H - 1, &H2A3848)
    SCISSOR_END()
END SUB

' Zwei Oktaven, ab C der gewaehlten Oktave. Weisse Tasten teilen die
' Breite, schwarze sitzen auf den Fugen.
FUNCTION pianoTasteBei(mx AS INTEGER, my AS INTEGER) AS INTEGER
    DIM px AS INTEGER : px = GUI_CANVAS_X(piano)
    DIM py AS INTEGER : py = GUI_CANVAS_Y(piano)
    DIM pw AS INTEGER : pw = GUI_CANVAS_W(piano)
    DIM ph AS INTEGER : ph = GUI_CANVAS_H(piano)
    IF mx < px OR my < py OR mx >= px + pw OR my >= py + ph THEN RETURN -1
    DIM basis AS INTEGER : basis = INT(GUI_VALUE(spOkt)) * 12 + 12
    DIM wb AS FLOAT : wb = pw / 14.0
    DIM schwarz AS ARRAY OF INTEGER
    schwarz = [1, 3, 6, 8, 10]
    DIM weissHalb AS ARRAY OF INTEGER
    weissHalb = [0, 2, 4, 5, 7, 9, 11]
    ' Erst die schwarzen: sie liegen oben und vorn.
    IF my < py + ph * 0.6 THEN
        DIM o AS INTEGER
        DIM k AS INTEGER
        FOR o = 0 TO 1
            FOR k = 0 TO 4
                DIM wIdx AS INTEGER : wIdx = o * 7 + IIF(schwarz[k] < 5, (schwarz[k] + 1) \ 2, (schwarz[k] + 2) \ 2)
                DIM bx AS FLOAT : bx = px + wIdx * wb - wb * 0.3
                IF mx >= bx AND mx < bx + wb * 0.6 THEN RETURN basis + o * 12 + schwarz[k]
            NEXT
        NEXT
    END IF
    DIM w AS INTEGER : w = INT((mx - px) / wb)
    RETURN basis + (w \ 7) * 12 + weissHalb[w MOD 7]
END FUNCTION

SUB zeichnePiano()
    DIM px AS INTEGER : px = GUI_CANVAS_X(piano)
    DIM py AS INTEGER : py = GUI_CANVAS_Y(piano)
    DIM pw AS INTEGER : pw = GUI_CANVAS_W(piano)
    DIM ph AS INTEGER : ph = GUI_CANVAS_H(piano)
    DIM wb AS FLOAT : wb = pw / 14.0
    DIM i AS INTEGER
    DIM basis AS INTEGER : basis = INT(GUI_VALUE(spOkt)) * 12 + 12
    FOR i = 0 TO 13
        DIM x0 AS INTEGER : x0 = px + INT(i * wb)
        DIM x1 AS INTEGER : x1 = px + INT((i + 1) * wb) - 2
        BOX(x0, py, x1, py + ph - 1, &HE8ECF0)
        IF i MOD 7 = 0 THEN
            TEXT_SIZE(12)
            TEXT(x0 + 4, py + ph - 16, "C" + STR$(basis \ 12 - 1 + i \ 7), &H506070)
            TEXT_SIZE(16)
        END IF
    NEXT
    DIM schwarzPos AS ARRAY OF INTEGER
    schwarzPos = [1, 2, 4, 5, 6, 8, 9, 11, 12, 13]
    FOR i = 0 TO 9
        DIM bx AS INTEGER : bx = px + INT(schwarzPos[i] * wb - wb * 0.3)
        BOX(bx, py, bx + INT(wb * 0.6), py + INT(ph * 0.6), &H1A2028)
    NEXT
END SUB

' ------------------------------------------------------------ Verlauf anwenden
' Der Cursor bleibt, wo er war -- ein Rueckgaengig soll die Noten
' zuruecknehmen, nicht die Arbeitsstelle.
SUB standAnwenden(idx AS INTEGER)
    DIM c AS INTEGER : c = curC
    DIM r AS INTEGER : r = curR
    DIM pa AS INTEGER : pa = patAkt
    stopp()
    songAusHandle(JSON_PARSE(uStand[idx]))
    cacheLeeren()
    dirty = TRUE
    patAkt = MIN(pa, patAnz - 1)
    curC = MIN(c, kanaele - 1)
    curR = MIN(r, patRows[patAkt] - 1)
    allesAnzeigen()
END SUB

SUB zurueck()
    IF uPos <= 1 THEN RETURN
    uPos = uPos - 1
    standAnwenden((uStart + uPos - 1) MOD UNDO_MAX)
END SUB

SUB wieder()
    IF uPos >= uAnz THEN RETURN
    uPos = uPos + 1
    standAnwenden((uStart + uPos - 1) MOD UNDO_MAX)
END SUB

' ------------------------------------------------------------ Start
songNeu()
DIM frage AS GUI_WINDOW : frage = -1
DIM frageNeu AS GUI_WINDOW : frageNeu = -1
DIM ziehen AS BOOLEAN : ziehen = FALSE

' Klaviatur auf der Tastatur (US-Lage): untere Reihe = Oktave, obere = +1.
DIM tastNote AS ARRAY OF INTEGER
tastNote = [KEY_Z, KEY_S, KEY_X, KEY_D, KEY_C, KEY_V, KEY_G, KEY_B, KEY_H, KEY_N, KEY_J, KEY_M, _
            KEY_Q, KEY_2, KEY_W, KEY_3, KEY_E, KEY_R, KEY_5, KEY_T, KEY_6, KEY_Y, KEY_7, KEY_U]

WHILE NOT QUITREQUESTED()
    bildNr = bildNr + 1
    GUI_UPDATE()
    DIM strg AS BOOLEAN : strg = KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)
    DIM umsch AS BOOLEAN : umsch = KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT)
    DIM dialogOffen AS BOOLEAN : dialogOffen = (frage >= 0 OR frageNeu >= 0)
    ' Tasten gehen ins Gitter, solange kein Bedienelement den Fokus hat --
    ' ein Drehfeld mit Fokus nimmt die Pfeile selbst.
    DIM tasten AS BOOLEAN : tasten = (GUI_FOCUSED() < 0) AND NOT dialogOffen

    ' ---- Wiedergabe planen
    IF spielt THEN
        planen()
        IF songModus AND kopfPat >= 0 AND kopfPat <> patAkt THEN patternWaehlen(kopfPat)
    END IF

    ' ---- Werkzeugleiste 1
    IF GUI_CLICKED(bNeu) AND NOT dialogOffen THEN
        IF dirty THEN
            frageNeu = GUI_DIALOG("Neuer Song", "Ungesicherte Aenderungen verwerfen?", "janein")
        ELSE
            songNeu()
        END IF
    END IF
    IF frageNeu >= 0 THEN
        IF GUI_ANSWER(frageNeu) = 1 THEN songNeu() : frageNeu = -1
        IF GUI_ANSWER(frageNeu) = 2 THEN frageNeu = -1
    END IF
    IF GUI_CLICKED(bAuf) OR (strg AND KEYHIT(KEY_O) AND tasten) THEN oeffnen()
    IF GUI_CLICKED(bSpei) OR (strg AND KEYHIT(KEY_S) AND tasten) THEN speichern(FALSE)
    IF GUI_CLICKED(bSpeiAls) THEN speichern(TRUE)
    IF INT(GUI_VALUE(spBpm)) <> lBpm THEN
        bpm = INT(GUI_VALUE(spBpm)) : lBpm = bpm
        cacheLeeren()
        IF spielt THEN AUDIO_CLOCK_SET_SPEED(takt, bpm / 60.0 * 4.0 * TICKS)
        geaendert()
    END IF
    IF INT(GUI_VALUE(spKan)) <> lKan THEN
        lKan = INT(GUI_VALUE(spKan))
        kanaeleSetzen(lKan)
    END IF
    IF GUI_CLICKED(bPlayPat) THEN starten(FALSE)
    IF GUI_CLICKED(bPlaySong) THEN starten(TRUE)
    IF GUI_CLICKED(bStop) THEN stopp()
    ' EINE Abfrage fuer beide Richtungen: zwei Zeilen hintereinander
    ' starteten und stoppten im selben Bild, weil die zweite den eben
    ' gesetzten Zustand schon sah.
    IF KEYHIT(KEY_SPACE) AND tasten THEN
        IF spielt THEN
            stopp()
        ELSE
            starten(FALSE)
        END IF
    END IF
    IF GUI_CLICKED(bZur) OR (strg AND KEYHIT(KEY_Z) AND tasten) THEN zurueck()
    IF GUI_CLICKED(bVor) OR (strg AND KEYHIT(KEY_Y) AND tasten) THEN wieder()
    IF GUI_CLICKED(bWav) THEN
        DIM wp AS STRING : wp = FILE_SAVE_DIALOG("Song als WAV", "song.wav", "wav")
        IF wp <> "" THEN
            renderStereo = GUI_CHECKED(cbStereo)
            renderAmiga = GUI_CHECKED(cbAmiga)
            wavRendern(wp)
        END IF
    END IF
    IF GUI_CLICKED(bCode) THEN
        DIM cp AS STRING : cp = FILE_SAVE_DIALOG("GB-Code sichern", "song.dh", "dh")
        IF cp <> "" THEN gbCodeSichern(cp)
    END IF

    ' ---- Werkzeugleiste 2
    IF GUI_DROPDOWN_SELECTED(ddPat) <> lPat AND GUI_DROPDOWN_SELECTED(ddPat) >= 0 THEN
        patternWaehlen(GUI_DROPDOWN_SELECTED(ddPat))
    END IF
    IF INT(GUI_VALUE(spRows)) <> lRows THEN
        lRows = INT(GUI_VALUE(spRows))
        reihenSetzen(lRows)
    END IF
    IF GUI_CLICKED(bPatNeu) THEN patternNeu(FALSE)
    IF GUI_CLICKED(bPatDup) THEN patternNeu(TRUE)
    IF GUI_CLICKED(bPatDel) THEN patternLoeschen()
    IF GUI_CLICKED(bPatLeer) THEN
        patternLeeren(patAkt)
        geaendert()
        zelleAnzeigen()
    END IF
    IF GUI_CLICKED(bOff) THEN noteSetzen(NOTE_OFF)
    ' Die Zellen-Felder wirken nur, wo eine Note steht -- sonst zurueck.
    DIM hatNote AS BOOLEAN : hatNote = (note[patAkt, curC, curR] >= 0)
    IF INT(GUI_VALUE(spVol)) <> lVol THEN
        IF hatNote THEN
            vol[patAkt, curC, curR] = INT(GUI_VALUE(spVol)) : lVol = vol[patAkt, curC, curR]
            geaendert()
        ELSE
            GUI_SET_VALUE(spVol, lVol)
        END IF
    END IF
    IF INT(GUI_VALUE(spSlide)) <> lSlide THEN
        IF hatNote AND NOT istDrum(curC) THEN
            slide[patAkt, curC, curR] = INT(GUI_VALUE(spSlide)) : lSlide = slide[patAkt, curC, curR]
            geaendert()
        ELSE
            GUI_SET_VALUE(spSlide, lSlide)
        END IF
    END IF
    IF GUI_DROPDOWN_SELECTED(ddFx) <> lFx AND GUI_DROPDOWN_SELECTED(ddFx) >= 0 THEN
        IF hatNote THEN
            fx[patAkt, curC, curR] = GUI_DROPDOWN_SELECTED(ddFx) : lFx = fx[patAkt, curC, curR]
            IF lFx = 0 THEN fxp[patAkt, curC, curR] = 0 : lFxp = 0 : GUI_SET_VALUE(spFxp, 0)
            geaendert()
        ELSE
            GUI_DROPDOWN_SET_SELECTED(ddFx, lFx)
        END IF
    END IF
    IF INT(GUI_VALUE(spFxp)) <> lFxp THEN
        IF hatNote AND fx[patAkt, curC, curR] <> 0 THEN
            fxp[patAkt, curC, curR] = INT(GUI_VALUE(spFxp)) : lFxp = fxp[patAkt, curC, curR]
            geaendert()
        ELSE
            GUI_SET_VALUE(spFxp, lFxp)
        END IF
    END IF
    IF GUI_DROPDOWN_SELECTED(ddZInst) <> lZInst AND GUI_DROPDOWN_SELECTED(ddZInst) >= 0 THEN
        IF hatNote THEN
            inst[patAkt, curC, curR] = GUI_DROPDOWN_SELECTED(ddZInst) - 1 : lZInst = inst[patAkt, curC, curR] + 1
            geaendert()
        ELSE
            GUI_DROPDOWN_SET_SELECTED(ddZInst, lZInst)
        END IF
    END IF

    ' ---- Kanal-Spalte
    IF lKanalAnz <> curC THEN kanalAnzeigen() : instrumentAnzeigen()
    IF GUI_DROPDOWN_SELECTED(ddChInst) <> lChInst AND GUI_DROPDOWN_SELECTED(ddChInst) >= 0 THEN
        lChInst = GUI_DROPDOWN_SELECTED(ddChInst)
        chInst[curC] = lChInst - 1
        geaendert()
        kanalAnzeigen()
        instrumentAnzeigen()
    END IF
    IF GUI_DROPDOWN_SELECTED(ddWave) <> lWave AND GUI_DROPDOWN_SELECTED(ddWave) >= 0 THEN
        lWave = GUI_DROPDOWN_SELECTED(ddWave)
        wave[curC] = wellenformen[lWave]
        geaendert()
    END IF
    IF GUI_CHECKED(cbMute) <> lMute THEN lMute = GUI_CHECKED(cbMute) : mute[curC] = lMute
    IF GUI_CHECKED(cbSolo) <> lSolo THEN lSolo = GUI_CHECKED(cbSolo) : solo[curC] = lSolo
    IF INT(GUI_VALUE(slChVol)) <> lChVol THEN
        lChVol = INT(GUI_VALUE(slChVol))
        chVol[curC] = lChVol / 100.0
        geaendert()
    END IF

    ' ---- Instrument-Kasten
    IF lInstAnz <> chInst[curC] THEN instrumentAnzeigen()
    DIM ii AS INTEGER : ii = chInst[curC]
    IF ii >= 0 THEN
        DIM iGeaendert AS BOOLEAN : iGeaendert = FALSE
        IF GUI_DROPDOWN_SELECTED(ddIWave) <> lIWave AND GUI_DROPDOWN_SELECTED(ddIWave) >= 0 THEN
            lIWave = GUI_DROPDOWN_SELECTED(ddIWave)
            iWave[ii] = IIF(lIWave = 4, "noise", wellenformen[lIWave]) : iGeaendert = TRUE
        END IF
        IF INT(GUI_VALUE(spIVol)) <> lIVol THEN lIVol = INT(GUI_VALUE(spIVol)) : iVol[ii] = lIVol : iGeaendert = TRUE
        IF INT(GUI_VALUE(spA)) <> lA THEN lA = INT(GUI_VALUE(spA)) : iAtk[ii] = lA : iGeaendert = TRUE
        IF INT(GUI_VALUE(spD)) <> lD THEN lD = INT(GUI_VALUE(spD)) : iDec[ii] = lD : iGeaendert = TRUE
        IF INT(GUI_VALUE(spS)) <> lS THEN lS = INT(GUI_VALUE(spS)) : iSus[ii] = lS / 100.0 : iGeaendert = TRUE
        IF INT(GUI_VALUE(spR)) <> lR THEN lR = INT(GUI_VALUE(spR)) : iRel[ii] = lR : iGeaendert = TRUE
        IF INT(GUI_VALUE(spVibD)) <> lVibD THEN lVibD = INT(GUI_VALUE(spVibD)) : iVibD[ii] = lVibD / 100.0 : iGeaendert = TRUE
        IF INT(GUI_VALUE(spVibS)) <> lVibS THEN lVibS = INT(GUI_VALUE(spVibS)) : iVibS[ii] = lVibS : iGeaendert = TRUE
        IF INT(GUI_VALUE(spDet)) <> lDet THEN lDet = INT(GUI_VALUE(spDet)) : iDet[ii] = lDet : iGeaendert = TRUE
        IF INT(GUI_VALUE(slPan)) <> lPan THEN lPan = INT(GUI_VALUE(slPan)) : iPan[ii] = lPan / 100.0 : iGeaendert = TRUE
        IF iGeaendert THEN
            cacheLeeren()
            geaendert()
        END IF
    END IF
    IF GUI_CLICKED(bINeu) THEN instrumentNeu()
    IF GUI_CLICKED(bIDel) THEN instrumentEntfernen()

    ' ---- Reihenfolge
    IF GUI_LISTBOX_SELECTED(lstOrder) <> lOrder AND GUI_LISTBOX_SELECTED(lstOrder) >= 0 THEN
        lOrder = GUI_LISTBOX_SELECTED(lstOrder)
        IF NOT spielt THEN patternWaehlen(order[lOrder])
    END IF
    IF GUI_CLICKED(bOAdd) THEN
        IF orderAnz < MAX_ORDER THEN
            order[orderAnz] = patAkt : orderAnz = orderAnz + 1
            lOrder = orderAnz - 1
            geaendert()
            orderAnzeigen()
        END IF
    END IF
    IF GUI_CLICKED(bODel) THEN
        IF orderAnz > 1 AND lOrder >= 0 THEN
            DIM oi AS INTEGER
            FOR oi = lOrder TO orderAnz - 2
                order[oi] = order[oi + 1]
            NEXT
            orderAnz = orderAnz - 1
            geaendert()
            orderAnzeigen()
        END IF
    END IF
    IF GUI_CLICKED(bOLinks) OR GUI_CLICKED(bORechts) THEN
        DIM ziel AS INTEGER : ziel = lOrder + IIF(GUI_CLICKED(bOLinks), -1, 1)
        IF lOrder >= 0 AND ziel >= 0 AND ziel < orderAnz THEN
            DIM tmp AS INTEGER : tmp = order[lOrder]
            order[lOrder] = order[ziel] : order[ziel] = tmp
            lOrder = ziel
            geaendert()
            orderAnzeigen()
        END IF
    END IF

    ' ---- Maus im Gitter
    DIM gx AS INTEGER : gx = GUI_CANVAS_X(gitter)
    DIM gy AS INTEGER : gy = GUI_CANVAS_Y(gitter)
    DIM gw AS INTEGER : gw = GUI_CANVAS_W(gitter)
    DIM gh AS INTEGER : gh = GUI_CANVAS_H(gitter)
    DIM mx AS INTEGER : mx = MOUSEX()
    DIM my AS INTEGER : my = MOUSEY()
    DIM imGitter AS BOOLEAN
    imGitter = (mx >= gx + RH_W AND my >= gy + HDR_H AND mx < gx + gw AND my < gy + gh) AND NOT dialogOffen
    IF imGitter THEN
        DIM hc AS INTEGER : hc = chOff + (mx - gx - RH_W) \ CELL_W
        DIM hr AS INTEGER : hr = rowOff + (my - gy - HDR_H) \ ROW_H
        IF hc < kanaele AND hr < patRows[patAkt] THEN
            IF MOUSE_HIT(0) THEN
                cursorSetzen(hc, hr, umsch)
                ziehen = TRUE
            ELSEIF ziehen AND MOUSEBUTTON(0) THEN
                IF hc <> curC OR hr <> curR THEN cursorSetzen(hc, hr, TRUE)
            END IF
        END IF
        DIM rad AS INTEGER : rad = MOUSEWHEEL()
        IF rad <> 0 THEN
            IF umsch THEN
                chOff = CLAMP(chOff - rad, 0, MAX(0, kanaele - 1))
            ELSE
                rowOff = CLAMP(rowOff - rad * 3, 0, MAX(0, patRows[patAkt] - 1))
            END IF
        END IF
    END IF
    IF NOT MOUSEBUTTON(0) THEN ziehen = FALSE

    ' ---- Klaviatur (Maus)
    IF MOUSE_HIT(0) AND NOT dialogOffen THEN
        DIM pm AS INTEGER : pm = pianoTasteBei(mx, my)
        IF pm >= 0 THEN noteSetzen(MIN(127, pm))
    END IF

    ' ---- Tastatur
    IF tasten THEN
        DIM schritt AS INTEGER : schritt = 0
        IF strg THEN
            IF KEYHIT(KEY_UP) THEN blockTransponieren(IIF(umsch, 12, 1))
            IF KEYHIT(KEY_DOWN) THEN blockTransponieren(IIF(umsch, -12, -1))
            IF KEYHIT(KEY_C) THEN blockKopieren(FALSE)
            IF KEYHIT(KEY_X) THEN blockKopieren(TRUE)
            IF KEYHIT(KEY_V) THEN blockEinfuegen()
            IF KEYHIT(KEY_I) THEN blockInterpolieren()
        ELSE
            IF KEYREPEAT(KEY_UP) THEN cursorSetzen(curC, curR - 1, umsch)
            IF KEYREPEAT(KEY_DOWN) THEN cursorSetzen(curC, curR + 1, umsch)
            IF KEYREPEAT(KEY_LEFT) THEN cursorSetzen(curC - 1, curR, umsch)
            IF KEYREPEAT(KEY_RIGHT) THEN cursorSetzen(curC + 1, curR, umsch)
            IF KEYREPEAT(KEY_PAGEUP) THEN cursorSetzen(curC, curR - 16, umsch)
            IF KEYREPEAT(KEY_PAGEDOWN) THEN cursorSetzen(curC, curR + 16, umsch)
            IF KEYHIT(KEY_HOME) THEN cursorSetzen(curC, 0, umsch)
            IF KEYHIT(KEY_END) THEN cursorSetzen(curC, patRows[patAkt] - 1, umsch)
            IF KEYHIT(KEY_DELETE) OR KEYHIT(KEY_BACKSPACE) THEN blockLoeschen()
            IF KEYHIT(KEY_0) THEN noteSetzen(NOTE_OFF)
            DIM tk AS INTEGER
            FOR tk = 0 TO 23
                IF KEYHIT(tastNote[tk]) THEN
                    noteSetzen(MIN(127, INT(GUI_VALUE(spOkt)) * 12 + 12 + tk))
                END IF
            NEXT
        END IF
    END IF

    ' ---- Verlauf: ein Schritt, sobald die Maus los ist -- ein Zug am
    ' Regler ist EIN Schritt, nicht sechzig.
    IF undoFaellig AND NOT MOUSEBUTTON(0) THEN
        undoFaellig = FALSE
        schrittSichern()
    END IF

    ' ---- Zeichnen
    GUI_SET_TEXT(lblStatus, meldung + IIF(dirty, "  *", ""))
    GUI_DRAW()
    zeichneGitter()
    zeichnePiano()
    ' Ein Dialog liegt ueber der Zeichenflaeche -- ohne diesen Aufruf
    ' sperrt er die Eingabe und ist nicht zu sehen.
    IF frage >= 0 THEN GUI_DRAW_WINDOW(frage)
    IF frageNeu >= 0 THEN GUI_DRAW_WINDOW(frageNeu)

    ' ---- Beenden
    IF KEYHIT(KEY_ESCAPE) AND NOT dialogOffen THEN
        IF dirty THEN
            frage = GUI_DIALOG("Beenden", "Ungesicherte Aenderungen verwerfen und beenden?", "janein")
        ELSE
            stopp()
            EXIT(0)
        END IF
    END IF
    IF frage >= 0 THEN
        IF GUI_ANSWER(frage) = 1 THEN stopp() : EXIT(0)
        IF GUI_ANSWER(frage) = 2 THEN frage = -1
    END IF

    FLIP()
WEND

