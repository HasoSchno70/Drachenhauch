=== fehler: kein schluessel, falscher, kontingent, kaputt, kein netz, einzelheiten fehlen
' Die Python-App zeigte in jedem Fall nur "Keine Rezepte gefunden" (der Grund
' stand im Log). Hier steht er in der Statuszeile; der Katalog sucht weiter.
' Kein Netz nach einer gelungenen Suche ist kein "Fehler 200".
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
DIM srv AS INTEGER : srv = kNetzStarten(ARG$(2))
PRINT "code "; kProbe(p, "probe.dh", "", 1500)
kOffEnde(srv)
PRINT "anfragen "; kOffAnfragen$()
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
{sammlung}/../_hilfen/spoon_server.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
SUB warten(kf AS KatalogFenster)
    DIM n AS INTEGER
    WHILE (kf.sucheAbruf >= 0 OR LEN(kf.detailAbrufe) > 0 OR ueOffen() > 0) AND n < 900 AND studioBild()
        n = n + 1
    WEND
END SUB
SUB suchen(kf AS KatalogFenster, wann AS STRING, text AS STRING)
    GUI_SET_TEXT(kf.sucheFeld, text)
    kf.knopfSuchen_Klick()
    warten(kf)
    PRINT wann; ": "; GUI_TEXT(kf.ergebnis); " | "; GUI_TEXT(kf.hinweis); " | suchen an "; GUI_ENABLED(kf.knopfSuchen)
END SUB
DIM kf AS KatalogFenster : kf = NEW KatalogFenster()
kf.Zeigen()
PRINT "ohne schluessel ["; GUI_TEXT(kf.hinweis); "]"
suchen(kf, "ohne schluessel", "Schnitzel")
PRINT "leer"
GUI_SET_TEXT(kf.sucheFeld, "  ")
kf.knopfSuchen_Klick()
PRINT "leer: "; GUI_TEXT(kf.hinweis); " | "; GUI_TEXT(kf.ergebnis)
SETENV("SPOONACULAR_API_KEY", "falsch")
suchen(kf, "falsch", "Hähnchen")
SETENV("SPOONACULAR_API_KEY", "erschoepft")
suchen(kf, "erschoepft", "Hähnchen")
SETENV("SPOONACULAR_API_KEY", "testschluessel")
suchen(kf, "kaputt", "kaputt")
suchen(kf, "gut", "Nudeln")
DIM basis AS STRING : basis = GETENV$("KUEHL_SPOON_URL")
SETENV("KUEHL_SPOON_URL", "http://127.0.0.1:9")
suchen(kf, "kein netz", "Nudeln")
SETENV("KUEHL_SPOON_URL", basis)
suchen(kf, "wieder", "Nudeln")
GUI_TABLE_SET_SELECTED(kf.tabelle, 0)
kf.tabelle_Geaendert()
warten(kf)
PRINT "einzelheiten 404: "; REPLACE$(GUI_TEXT(kf.details), CHR$(10), " / "); " | import an "; GUI_ENABLED(kf.knopfImport)
' Der Uebersetzer streikt: der Rest bleibt englisch, importieren geht.
suchen(kf, "kontingent", "quota")
GUI_TABLE_SET_SELECTED(kf.tabelle, 0)
kf.tabelle_Geaendert()
warten(kf)
PRINT "kontingent: "; GUI_TABLE_GET_CELL(kf.tabelle, 0, 1); " | "; GUI_TEXT(kf.hinweis); " | import an "; GUI_ENABLED(kf.knopfImport); " | "; SPLIT(GUI_TEXT(kf.details), CHR$(10))[1]
END
