' Unscharfer Filter: der Text als Teil ODER seine Zeichen der Reihe nach
' ("spred" findet "189_sprite_editor.dh").
' Wer "oeffnen" tippt, meint "öffnen" -- beide Seiten ohne Umlaute
' vergleichen, dann trifft jede Schreibweise.
FUNCTION ohneUmlaute$(s AS STRING) AS STRING
    DIM r AS STRING : r = LOWER$(s)
    r = REPLACE$(r, "ä", "ae") : r = REPLACE$(r, "ö", "oe") : r = REPLACE$(r, "ü", "ue")
    r = REPLACE$(r, "Ä", "ae") : r = REPLACE$(r, "Ö", "oe") : r = REPLACE$(r, "Ü", "ue")
    RETURN REPLACE$(r, "ß", "ss")
END FUNCTION

FUNCTION passtUnscharf(name AS STRING, roh AS STRING) AS BOOLEAN
    IF roh = "" THEN RETURN TRUE
    DIM filter AS STRING : filter = ohneUmlaute$(roh)
    DIM n AS STRING : n = ohneUmlaute$(name)
    IF INSTR(n, filter) >= 0 THEN RETURN TRUE
    DIM k AS INTEGER : k = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(n) - 1
        IF MID$(n, i, 1) = MID$(filter, k, 1) THEN k = k + 1
        IF k >= LEN(filter) THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

SUB paletteFuellen(filter AS STRING)
    GUI_LISTBOX_CLEAR(lstPalette)
    DIM sichtbar AS ARRAY OF STRING : sichtbar = []
    DIM klein AS STRING : klein = LOWER$(filter)
    ' Zwei Durchgaenge: erst was den Text am Stueck enthaelt, dann was ihn nur
    ' Buchstabe fuer Buchstabe hat. Sonst gewann "Profil im Code entfernen"
    ' vor "Listing als PDF", wer "pdf" tippte -- nur weil es weiter oben steht.
    DIM i AS INTEGER
    DIM gang AS INTEGER
    DIM ff AS STRING : ff = ohneUmlaute$(klein)
    FOR gang = 1 TO 2
        FOR i = 0 TO LEN(paletteNamen) - 1
            DIM volltext AS STRING : volltext = paletteNamen[i] + " " + paletteDetails[i]
            DIM amStueck AS BOOLEAN : amStueck = INSTR(ohneUmlaute$(volltext), ff) >= 0
            IF (gang = 1 AND amStueck) OR (gang = 2 AND NOT amStueck AND passtUnscharf(volltext, klein)) THEN
                DIM pz AS INTEGER : pz = GUI_LISTBOX_ADD(lstPalette, paletteNamen[i])
                IF paletteDetails[i] <> "" THEN GUI_LISTBOX_DETAIL(lstPalette, pz, paletteDetails[i])
                ARRAY_PUSH(sichtbar, paletteKennungen[i])
            END IF
        NEXT
    NEXT
    paletteSichtbar = sichtbar
    IF LEN(sichtbar) > 0 THEN GUI_LISTBOX_SET_SELECTED(lstPalette, 0)
END SUB

SUB waehlerOeffnen(art AS STRING, titel AS STRING)
    paletteArt = art
    GUI_WINDOW_TITLE(winPalette, titel)
    GUI_SET_TEXT(tfPalette, "")
    paletteLetzterFilter = "-"
    GUI_WINDOW_SET_BOUNDS(winPalette, (SCREENWIDTH() - 440) \ 2, 80, 440, 340)
    GUI_WINDOW_VISIBLE(winPalette, TRUE)
    paletteOffen = TRUE
    GUI_FOCUS(tfPalette)
END SUB

SUB paletteOeffnen()
    paletteNamen = []
    paletteKennungen = []
    paletteDetails = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(befehlNamen) - 1
        DIM n AS STRING : n = befehlNamen[i]
        ARRAY_PUSH(paletteNamen, n) : ARRAY_PUSH(paletteKennungen, befehlKennungen[i]) : ARRAY_PUSH(paletteDetails, befehlKuerzel[i])
    NEXT
    waehlerOeffnen("befehl", tr$("Befehle"))
END SUB

' Strg+Umschalt+O: die .dh des Projektordners und die zuletzt geoeffneten.
SUB schnellOeffnen()
    paletteNamen = []
    paletteKennungen = []
    paletteDetails = []
    DIM d AS STRING
    FOR EACH d IN projektDateien("*.dh")
        ARRAY_PUSH(paletteNamen, d) : ARRAY_PUSH(paletteKennungen, PATHJOIN(projektOrdner, d)) : ARRAY_PUSH(paletteDetails, "")
    NEXT
    FOR EACH d IN zuletzt
        IF ARRAY_INDEXOF(paletteKennungen, d) < 0 THEN
            ARRAY_PUSH(paletteNamen, BASENAME(d)) : ARRAY_PUSH(paletteKennungen, d) : ARRAY_PUSH(paletteDetails, DIRNAME(d))
        END IF
    NEXT
    waehlerOeffnen("datei", tr$("Datei öffnen: ") + BASENAME(projektOrdner))
END SUB

SUB paletteSchliessen()
    GUI_WINDOW_VISIBLE(winPalette, FALSE)
    paletteOffen = FALSE
    GUI_FOCUS(aktivesFeld())
END SUB

SUB paletteAusfuehren()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstPalette)
    IF sel < 0 AND LEN(paletteSichtbar) > 0 THEN sel = 0
    paletteSchliessen()
    IF sel < 0 OR sel >= LEN(paletteSichtbar) THEN RETURN
    IF paletteArt = "schnipsel" THEN
        schnipselEinfuegen(INT(VAL(paletteSichtbar[sel])))
    ELSEIF paletteArt = "symbol" THEN
        symbolAnspringen(INT(VAL(paletteSichtbar[sel])))
    ELSEIF paletteArt = "verschieben" THEN
        IF paletteSichtbar[sel] = "*neu*" THEN
            dlgVerschNeu = GUI_PROMPT(tr$("Neue Datei"), tr$("Wie soll sie heißen?"), "helfer.dh")
        ELSE
            verschiebenNach(paletteSichtbar[sel])
        END IF
    ELSEIF paletteArt = "tasten" THEN
        tastenFragen(paletteSichtbar[sel])
    ELSEIF paletteArt = "korrektur" THEN
        korrekturAnwenden(paletteSichtbar[sel])
    ELSEIF paletteArt = "datei" THEN
        protokoll("schnell " + paletteSichtbar[sel])
        dateiOeffnen(paletteSichtbar[sel])
    ELSE
        protokoll("palette " + paletteSichtbar[sel])
        befehl(paletteSichtbar[sel])
    END IF
END SUB

SUB eingabeSenden()
    DIM t AS STRING : t = GUI_TEXT(tfEingabe)
    IF terminalAn THEN
        terminalEingabe(t)
        RETURN
    END IF
    IF prozess < 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("Kein Programm läuft."))
        RETURN
    END IF
    IF prozessArt = "debug" THEN
        ' Wartet das Programm in einem INPUT, geht die Zeile dorthin.
        IF debugEingabe THEN
            PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("input") + "," + jsonText$("text") + ":" + jsonText$(t) + "}" + NL)
            debugEingabe = FALSE
            ausgabe("> " + t)
            GUI_SET_TEXT(tfEingabe, "")
            GUI_SET_TEXT(lblDebug, tr$("Debugger: läuft ..."))
            protokoll("debug eingabe gesendet")
            RETURN
        END IF
        ' Im Halt ist die Eingabezeile die Ausdruck-Auswertung.
        IF NOT debugPause THEN GUI_SET_TEXT(lblStatus, tr$("Der Debugger steht gerade nicht.")) : RETURN
        PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("eval") + "," + jsonText$("expr") + ":" + jsonText$(t) + "}" + NL)
        ausgabe("? " + t)
        GUI_SET_TEXT(tfEingabe, "")
        RETURN
    END IF
    PROCESS_WRITE(prozess, t + NL)
    ausgabe("> " + t)
    GUI_SET_TEXT(tfEingabe, "")
END SUB

' --- Absturz-Wiederherstellung ---------------------------------------
FUNCTION whEigen$() AS STRING
    RETURN PATHJOIN(whOrdner, whKennung)
END FUNCTION

' Den Stand dieser IDE schreiben: je Reiter mit ungesicherten Aenderungen
' Pfad und Text. `offen` = FALSE heisst "diese IDE laeuft nicht mehr" --
' dann darf der naechste Start den Stand sofort anbieten, statt drei Takte
' auf das ausbleibende Lebenszeichen zu warten. Geschrieben wird erst in
' eine Nebendatei und dann umbenannt: ein Absturz MITTEN im Schreiben liesse
' sonst einen halben Stand zurueck, und der waere genau der, den man braucht.
SUB whSchreiben(offen AS BOOLEAN)
    DIM h AS JSON_HANDLE : h = JSON_NEW_OBJECT()
    JSON_SET_INT(h, "zeit", ZEIT_JETZT())
    JSON_SET_BOOL(h, "offen", offen)
    JSON_SET_JSON(h, "reiter", JSON_NEW_ARRAY())
    DIM n AS INTEGER : n = 0
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        DIM txt AS STRING : txt = GUI_TEXT(tabFelder[i])
        IF txt <> tabGesichert[i] THEN
            DIM e AS JSON_HANDLE : e = JSON_NEW_OBJECT()
            JSON_SET_STRING(e, "pfad", tabPfade[i])
            JSON_SET_STRING(e, "text", txt)
            JSON_APPEND_JSON(h, "reiter", e)
            n = n + 1
        END IF
    NEXT
    TRY
        IF NOT DIREXISTS(whOrdner) THEN MKDIR(whOrdner)
        IF NOT DIREXISTS(whEigen$()) THEN MKDIR(whEigen$())
        DIM ziel AS STRING : ziel = PATHJOIN(whEigen$(), "stand.json")
        DIM neben AS STRING : neben = PATHJOIN(whEigen$(), "stand.neu")
        WRITEALL(neben, JSON_STRINGIFY(h))
        RENAME(neben, ziel)
        protokoll("sicherung " + STR$(n) + IIF(offen, "", " beendet"))
    CATCH fehler
        ' EINMAL sagen, nicht jeden Takt: ein schreibgeschuetztes Profil
        ' soll die Arbeit nicht stoeren, aber man muss wissen, dass das
        ' Netz fehlt.
        IF NOT whGewarnt THEN
            GUI_SET_TEXT(lblStatus, tr$("Wiederherstellung kann nicht sichern: ") + fehler)
            whGewarnt = TRUE
        END IF
        protokoll("sicherung fehlgeschlagen")
    END TRY
END SUB

' Verwaiste Staende anderer Laeufe einsammeln. Einer LEBT, solange er als
' offen gilt und sein Lebenszeichen juenger als drei Takte ist -- den laesst
' die Suche stehen, er gehoert einer IDE, die gerade laeuft. Ein verwaister
' Stand ohne Reiter hat nichts zu bieten und wird still weggeraeumt.
SUB whSuchen()
    whFremd = []
    IF NOT DIREXISTS(whOrdner) THEN RETURN
    DIM name AS STRING
    FOR EACH name IN DIRLIST(whOrdner)
        DIM d AS STRING : d = PATHJOIN(whOrdner, name)
        DIM st AS STRING : st = PATHJOIN(d, "stand.json")
        DIM reiter AS INTEGER : reiter = -1
        IF name <> whKennung AND FILEEXISTS(st) THEN
            TRY
                DIM h AS JSON_HANDLE : h = JSON_LOAD(st)
                DIM lebt AS BOOLEAN
                lebt = JSON_GET_BOOL(h, "offen") AND ZEIT_JETZT() - JSON_GET_INT(h, "zeit") < 3 * whTakt
                IF NOT lebt THEN reiter = JSON_LEN(h, "reiter")
            CATCH fehler
                ' unlesbar: liegen lassen -- vielleicht schreibt ihn gerade jemand
                reiter = -1
            END TRY
        END IF
        IF reiter = 0 THEN
            TRY
                RMDIR(d, TRUE)
            CATCH fehler
                protokoll("wiederherstellung nicht entfernbar " + name)
            END TRY
        ELSEIF reiter > 0 THEN
            ARRAY_PUSH(whFremd, d)
        END IF
    NEXT
END SUB

SUB whAnbieten()
    whSuchen()
    IF LEN(whFremd) = 0 THEN RETURN
    DIM n AS INTEGER : n = 0
    DIM namen AS STRING : namen = ""
    DIM d AS STRING
    FOR EACH d IN whFremd
        TRY
            DIM h AS JSON_HANDLE : h = JSON_LOAD(PATHJOIN(d, "stand.json"))
            DIM k AS INTEGER
            FOR k = 0 TO JSON_LEN(h, "reiter") - 1
                DIM p AS STRING : p = JSON_GET_STRING(h, "reiter." + STR$(k) + ".pfad")
                n = n + 1
                IF n <= 6 THEN
                    IF namen <> "" THEN namen = namen + ", "
                    namen = namen + IIF(p = "", "(neu)", BASENAME(p))
                END IF
            NEXT
        CATCH fehler
            protokoll("wiederherstellung unlesbar " + BASENAME(d))
        END TRY
    NEXT
    IF n = 0 THEN RETURN
    IF n > 6 THEN namen = namen + " ..."
    dlgWieder = GUI_DIALOG(tr$("Wiederherstellen"), STR$(n) + tr$(" ungesicherte Reiter aus einer Sitzung, die nicht sauber endete: ") + namen, tr$("Wiederherstellen|Verwerfen|Später"))
    protokoll("wiederherstellung angeboten " + STR$(n))
END SUB

' Die angebotenen Staende als Reiter zurueckholen -- UNGESICHERT: die Datei
' auf der Platte bleibt, wie sie war, bis man selbst sichert. Eine Datei
' geht ueber tabOeffnen und nicht ueber dateiOeffnen, sonst oeffnete eine
' als Text bearbeitete .dhform den Form-Designer statt ihres Textes.
SUB whHolen()
    DIM n AS INTEGER : n = 0
    DIM d AS STRING
    FOR EACH d IN whFremd
        TRY
            DIM h AS JSON_HANDLE : h = JSON_LOAD(PATHJOIN(d, "stand.json"))
            DIM k AS INTEGER
            FOR k = 0 TO JSON_LEN(h, "reiter") - 1
                DIM p AS STRING : p = JSON_GET_STRING(h, "reiter." + STR$(k) + ".pfad")
                DIM txt AS STRING : txt = JSON_GET_STRING(h, "reiter." + STR$(k) + ".text")
                DIM ziel AS INTEGER : ziel = -1
                DIM vorher AS INTEGER : vorher = tabAnzahl
                IF p = "" THEN
                    tabOeffnen("", "")
                    IF tabAnzahl > vorher THEN ziel = tabAnzahl - 1
                ELSE
                    IF FILEEXISTS(p) THEN tabOeffnen(p, dateiLesen(p)) ELSE tabOeffnen(p, "")
                    ziel = tabMitPfad(p)
                END IF
                IF ziel >= 0 THEN
                    GUI_SET_TEXT(tabFelder[ziel], txt)
                    n = n + 1
                    protokoll("wiederhergestellt " + IIF(p = "", "(neu)", p))
                END IF
            NEXT
            RMDIR(d, TRUE)
        CATCH fehler
            protokoll("wiederherstellung fehlgeschlagen " + BASENAME(d))
        END TRY
    NEXT
    whFremd = []
    reiterNeuSetzen()
    GUI_SET_TEXT(lblStatus, STR$(n) + tr$(" Reiter wiederhergestellt -- noch NICHT gesichert."))
    ' Gleich in den eigenen Stand: stuerzt die IDE jetzt ab, waeren sie
    ' sonst ein zweites Mal weg.
    whSchreiben(TRUE)
END SUB

SUB whVerwerfen()
    DIM d AS STRING
    FOR EACH d IN whFremd
        TRY
            RMDIR(d, TRUE)
        CATCH fehler
            protokoll("wiederherstellung nicht entfernbar " + BASENAME(d))
        END TRY
    NEXT
    whFremd = []
    protokoll("wiederherstellung verworfen")
END SUB

' --- Beenden mit Rueckfrage ------------------------------------------
FUNCTION ungesichert() AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

DIM beenden AS BOOLEAN : beenden = FALSE

SUB beendenAnfragen()
    IF ungesichert() THEN
        dlgSchliessen = GUI_DIALOG(tr$("Beenden"), tr$("Es gibt ungesicherte Änderungen."), tr$("Alle sichern|Verwerfen|Abbrechen"))
        protokoll("rueckfrage beenden")
    ELSE
        beenden = TRUE
    END IF
END SUB

' EIN Ort fuer jeden Befehl: Menue, Kuerzel, Palette und Knoepfe rufen ihn.
SUB befehl(k AS STRING)
    SELECT CASE k
        CASE "neu" : tabOeffnen("", "")
        CASE "oeffnen"
            DIM p AS STRING : p = FILE_OPEN_DIALOG("Datei öffnen", "dh")
            IF p <> "" THEN dateiOeffnen(p)
        CASE "schnell" : schnellOeffnen()
        CASE "todo" : projektSuchen("TODO", "FIXME")
        CASE "blame" : blameZeigen()
        CASE "diff" : gitZeigen("diff")
        CASE "verlauf" : gitZeigen("log")
        CASE "git_rand"
            gitRandAn = NOT gitRandAn
            GUI_MENU_CHECK(miGitRand, gitRandAn)
            gitDateiStand = "-"
            gitRandNachziehen(TRUE)
            konfigSichern()
        CASE "kommentar" : kommentarUmschalten()
        CASE "duplizieren" : zeilenDuplizieren()
        CASE "zeile_weg" : zeilenLoeschen()
        CASE "hoch" : zeilenVerschieben(-1)
        CASE "runter" : zeilenVerschieben(1)
        CASE "einruecken" : einruecken(1)
        CASE "ausruecken" : einruecken(-1)
        CASE "format" : formatieren()
        CASE "lesezeichen" : lesezeichenUmschalten()
        CASE "lz_weiter" : lesezeichenSpringen(TRUE)
        CASE "lz_zurueck" : lesezeichenSpringen(FALSE)
        CASE "lz_liste" : lesezeichenListe()
        CASE "regex"
            regexAn = NOT regexAn
            suchSchalterZeigen()
            GUI_SET_TEXT(lblStatus, IIF(regexAn, tr$("Suche mit regulärem Ausdruck (z. B. ^SUB .*\\(\\))."), tr$("Suche als Teiltext.")))
            konfigSichern()
        CASE "wiederauf"
            IF LEN(zuGemacht) = 0 THEN
                GUI_SET_TEXT(lblStatus, tr$("Kein geschlossener Reiter zum Wiederholen."))
            ELSE
                DIM zurueck AS STRING : zurueck = ARRAY_POP(zuGemacht)
                IF FILEEXISTS(zurueck) THEN dateiOeffnen(zurueck) ELSE GUI_SET_TEXT(lblStatus, tr$("Gibt es nicht mehr: ") + zurueck)
                protokoll("wieder auf " + zurueck)
            END IF
        CASE "bedingung" : haltepunktBedingungFragen()
        CASE "export" : exportieren()
        CASE "groesser" : schriftSetzen(codeGroesse + 2)
        CASE "kleiner" : schriftSetzen(codeGroesse - 2)
        CASE "schrift_normal" : schriftSetzen(SCHRIFT_NORMAL)
        CASE "kuerzel" : kuerzelZeigen()
        CASE "schnipsel_eigen" : schnipselEigenOeffnen()
        CASE "schnipsel_auswahl" : schnipselAuswahlFragen()
        CASE "tasten" : tastenWaehlen()
        CASE "tasten_zurueck" : tastenZuruecksetzen()
        CASE "terminal" : terminalZeigen(NOT (terminalAn AND untenAn))
        CASE "sprache" : spracheWechseln()
        CASE "terminal_stopp" : terminalAbbrechen()
        CASE "sichern" : sichern(aktiverTab, FALSE)
        CASE "sichern_unter" : sichern(aktiverTab, TRUE)
        CASE "schliessen" : tabSchliessenFragen(aktiverTab)
        CASE "beenden" : beendenAnfragen()
        CASE "suchen" : sucheOeffnen(FALSE)
        CASE "weiter" : trefferSpringen(TRUE)
        CASE "zurueck_suchen" : trefferSpringen(FALSE)
        CASE "ersetzen" : sucheOeffnen(TRUE)
        ' Ohne offene Ersetzen-Leiste waere unklar, WOMIT ersetzt wird -- dann
        ' geht sie erst einmal auf.
        CASE "ersetzen_eins" : IF sucheOffen AND sucheMitErsetzen THEN ersetzenEinzeln() ELSE sucheOeffnen(TRUE)
        CASE "ersetzen_alle" : IF sucheOffen AND sucheMitErsetzen THEN alleErsetzen() ELSE sucheOeffnen(TRUE)
        CASE "gross_klein"
            grossKlein = NOT grossKlein
            suchSchalterZeigen()
            GUI_SET_TEXT(lblStatus, IIF(grossKlein, tr$("Suche beachtet Groß/klein."), tr$("Suche ohne Rücksicht auf Groß/klein.")))
            konfigSichern()
        CASE "ganzes_wort"
            ganzesWort = NOT ganzesWort
            suchSchalterZeigen()
            GUI_SET_TEXT(lblStatus, IIF(ganzesWort, tr$("Suche nur nach ganzen Wörtern."), tr$("Suche auch mitten im Wort.")))
            konfigSichern()
        CASE "ersetzen_projekt"
            ersetzenZiel = "projekt"
            dlgSuche = GUI_PROMPT(tr$("Im ganzen Projekt ersetzen"), tr$("Wonach suchen?"), suchtext)
            schliessenNachDialog = TRUE
        CASE "ausgabe_suchen" : dlgAusgabeSuche = GUI_PROMPT(tr$("Ausgabe durchsuchen"), tr$("Wonach?"), ausgabeSuchtext)
        CASE "marke_naechste" : markeNaechste()
        CASE "marken_enden" : markenAnZeilenenden()
        CASE "erweitern" : auswahlErweitern()
        CASE "herausloesen"
            DIM hz1 AS INTEGER
            DIM hz2 AS INTEGER
            (hz1, hz2) = zeilenBereich(IIF(aktivesFeld() >= 0, aktivesFeld(), -1))
            IF aktivesFeld() < 0 THEN
                GUI_SET_TEXT(lblStatus, tr$("Kein Code-Feld offen."))
            ELSEIF hz2 <= hz1 THEN
                GUI_SET_TEXT(lblStatus, tr$("Erst mehrere Zeilen markieren."))
                protokoll("herausgeloest 0")
            ELSE
                dlgHeraus = GUI_PROMPT(tr$("Herauslösen"), _
                    STR$(hz2 - hz1 + 1) + " Zeilen in ein neues Unterprogramm. Wie soll es heißen?", "teil")
            END IF
        CASE "verkleinern" : auswahlVerkleinern()
        CASE "zl_sortieren" : zeilenWerkzeug("sortieren")
        CASE "zl_doppelte" : zeilenWerkzeug("doppelte")
        CASE "zl_rand" : zeilenWerkzeug("rand")
        CASE "vergleichen" : dateienVergleichen()
        CASE "reiter_vergleich" : reiterVergleichen()
        CASE "umb_projekt"
            umbenennWort = wortUnterMarke$()
            IF umbenennWort = "" THEN
                GUI_SET_TEXT(lblStatus, tr$("Unter der Marke steht kein Wort."))
            ELSE
                dlgUmbProjekt = GUI_PROMPT(tr$("Im ganzen Projekt umbenennen"), _
                    "'" + umbenennWort + "' überall im Projektordner ersetzen durch:", umbenennWort)
            END IF
        CASE "parameter" : parameterFragen()
        CASE "aufrufer" : aufruferZeigen()
        CASE "fundstellen" : fundstellenZeigen()
        CASE "verschieben" : verschiebenFragen()
        CASE "umbau_zurueck" : umbauZurueck()
        CASE "umbau_wieder" : umbauWiederholen()
        CASE "umbau_nach" : umbauNachbessern()
        CASE "geruest" : geruestSetzen(NOT geruestAn)
        CASE "klammern" : klammernSetzen(NOT klammernAn)
        CASE "format_sichern"
            formatSichernAn = NOT formatSichernAn
            konfigSichern()
            GUI_SET_TEXT(lblStatus, IIF(formatSichernAn, tr$("Beim Sichern formatieren an."), tr$("Beim Sichern formatieren aus.")))
            protokoll("format sichern " + IIF(formatSichernAn, "an", "aus"))
        CASE "andere_zu" : andereSchliessen()
        CASE "linien" : linienSetzen(NOT linienAn)
        CASE "blockkopf" : kopfSetzen(NOT kopfAn)
        CASE "fehler_am_ende" : fehlerEndeSetzen(NOT fehlerEndeAn)
        CASE "nav_zurueck" : navGehen(TRUE)
        CASE "nav_vor" : navGehen(FALSE)
        CASE "baum_neue_datei" : baumFragen("datei")
        CASE "baum_neuer_ordner" : baumFragen("ordner")
        CASE "baum_umbenennen" : baumFragen("umbenennen")
        CASE "baum_loeschen" : baumLoeschenFragen()
        CASE "baum_pfad" : baumPfadKopieren()
        CASE "ausgabe_zeile_kopieren" : ausgabeKopieren(TRUE)
        CASE "ausgabe_kopieren" : ausgabeKopieren(FALSE)
        CASE "ausgabe_sichern"
            DIM asPfad AS STRING : asPfad = FILE_SAVE_DIALOG(tr$("Ausgabe sichern"), "ausgabe.txt", "txt")
            IF asPfad <> "" THEN ausgabeSichernNach(asPfad)
        CASE "start_argumente" : startEinstellungFragen(FALSE)
        CASE "start_umgebung" : startEinstellungFragen(TRUE)
        CASE "neustart_sichern" : neustartSichernSetzen(NOT neustartSichernAn)
        CASE "profil_waerme" : waermeSetzen(NOT waermeAn)
        CASE "profil_waerme_weg" : waermeEntfernen()
        CASE "aufrufzaehler" : zaehlerSetzen(NOT zaehlerAn)
        CASE "git_fenster" : qvZeigen()
        CASE "live" : liveSetzen(NOT liveAn)
        CASE "pruefsammlung" : pruefsammlungStarten(FALSE)
        CASE "prueffall" : pruefsammlungStarten(TRUE)
        CASE "test_uebersicht" : testUebersichtZeigen()
        CASE "neues_projekt" : neuProjektZeigen()
        CASE "einfuehren" : einfuehrenFragen()
        CASE "einsetzen" : variableEinsetzen()
        CASE "sub_function" : subInFunction()
        CASE "konflikt_meine" : konfliktLoesen(1)
        CASE "konflikt_ihre" : konfliktLoesen(2)
        CASE "konflikt_beide" : konfliktLoesen(3)
        CASE "blame_zeile" : blameZeileSetzen(NOT blameZeileAn)
        CASE "leiste"
            leisteAn = NOT leisteAn
            GUI_MENU_CHECK(miLeiste, leisteAn)
            layout()
            konfigSichern()
            protokoll("leiste " + IIF(leisteAn, "an", "aus"))
        CASE "vorschau_neu" : vorschauNeu()
        CASE "zeile" : dlgZeile = GUI_PROMPT(tr$("Gehe zu Zeile"), tr$("Zeilennummer:"), "")
        CASE "projekt" : dlgProjekt = GUI_PROMPT(tr$("Im Projekt suchen"), tr$("Wonach (alle .dh in ") + BASENAME(projektOrdner) + ")?", suchtext)
        CASE "vervoll"
            ' Steht die Liste schon (weil sie beim Tippen aufging), holt
            ' Strg+Leer sie nur nach vorn -- ausgewaehlt wird mit den
            ' Pfeilen und Enter.
            IF vervollOffen THEN GUI_FOCUS(lstVervoll) ELSE vervollstaendigen(TRUE)
        CASE "definition" : zurDefinition()
        CASE "umbenennen" : umbenennenFragen()
        CASE "korrektur" : korrekturZeigen()
        CASE "schnipsel" : schnipselWaehlen()
        CASE "einstellungen" : einstellungenZeigen()
        CASE "befehle" : befehleZeigen()
        CASE "peek" : peekZeigen()
        CASE "symbole" : symbolVerzeichnis()
        CASE "baum_oeffnen" : baumAuswahlOeffnen()
        CASE "haken_weg" : hakenEntfernen()
        CASE "baum_haken" : baumHakenSetzen(NOT baumHakenAn)
        CASE "marken" : markenAufFundstellen()
        CASE "palette" : paletteOeffnen()
        CASE "start" : starten()
        CASE "stopp" : stoppen()
        CASE "neustart" : neuStarten()
        CASE "pruefen" : problemModus = 0 : pruefen()
        CASE "projekt_pruefen" : projektPruefenStarten()
        CASE "debug" : debuggen()
        CASE "haltepunkt" : haltepunktUmschalten()
        CASE "weiter_d" : debugSchritt("continue")
        CASE "anhalten" : debugAnhalten()
        CASE "hp_liste" : haltepunkteListeZeigen()
        CASE "drueber" : debugSchritt("step-over")
        CASE "hinein" : debugSchritt("step-into")
        CASE "heraus" : debugSchritt("step-out")
        CASE "bis_marke" : bisZurMarke()
        CASE "profil" : profilAufnehmen()
        CASE "thema"
            hell = NOT hell
            GUI_MENU_CHECK(miThema, hell)
            themaAnwenden()
            protokoll("codefarben " + COLOR_HEX$(F_SCHLUESSEL))
            konfigSichern()
        CASE "farben_eigen" : farbenEigenOeffnen()
        CASE "typ_hinweise" : typHinweiseSetzen(NOT typHinweiseAn)
        CASE "vollbild" : SET_FULLSCREEN(NOT WINDOW_IS_FULLSCREEN())
        CASE "umbruch" : umbruchSetzen(NOT umbruchAn)
        CASE "geteilt" : geteiltSetzen(NOT geteilt)
        CASE "spiegel" : spiegelSetzen(NOT spiegelAn)
        CASE "ausgabe_leeren"
            ' Eine halbe Zeile, die noch auf ihren Umbruch wartet, geht mit --
            ' sonst stuende ihr Rest nachher allein am Anfang.
            GUI_LISTBOX_CLEAR(lstAusgabe)
            ausgabeRest = ""
            GUI_SET_TEXT(lblStatus, tr$("Ausgabe geleert."))
            protokoll("ausgabe geleert")
        CASE "seitenleiste" : leistenSetzen(NOT seitenAn, untenAn)
        CASE "untere_leiste" : leistenSetzen(seitenAn, NOT untenAn)
        CASE "minimap" : minimapSetzen(NOT minimapAn)
        CASE "falten" : faltenUmschalten()
        CASE "falten_alle" : faltenAlle(TRUE)
        CASE "falten_auf" : faltenAlle(FALSE)
        CASE "ueber" : ueberZeigen()
        CASE "handbuch" : handbuch()
        CASE "hb_ansicht" : handbuchAnsicht(NOT hbGesetzt)
        CASE "drucken" : listingDrucken()
        CASE "pdf" : listingAlsPdf()
        CASE "wz_sfx" : werkzeugStarten("183_sfx_generator.dh")
        CASE "wz_partikel" : werkzeugStarten("185_partikel_editor.dh")
        CASE "wz_tilemap" : werkzeugStarten("187_tilemap_editor.dh")
        CASE "wz_sprite" : werkzeugStarten("189_sprite_editor.dh")
        CASE "wz_tracker" : werkzeugStarten("190_tracker.dh")
        CASE "wz_form" : werkzeugStarten("197_form_designer.dh")
        CASE "form_text" : formularAlsText()
        CASE "wz_anim" : werkzeugStarten("198_anim_fsm_editor.dh")
        CASE "wz_noten" : werkzeugStarten("199_notenblatt.dh")
        CASE "beispiele" : beispieleOeffnen()
        CASE "beispiele_themen" : themenZeigen()
        CASE "ausdruck"
            IF prozessArt = "debug" AND debugPause THEN GUI_FOCUS(tfEingabe) ELSE GUI_SET_TEXT(lblStatus, tr$("Der Debugger steht gerade nicht -- erst F7 und ein Halt."))
    END SELECT
END SUB

' --- Symbole in den Menues --------------------------------------------
' Seit Stand 26 dieselben eingebauten Sinnbilder wie in der Werkzeugleiste
' (GUI_MENU_ICON mit einem NAMEN). Bis dahin malte die IDE hier 16x16-Bilder
' aus Rechtecken -- in eigenen Farben, die zu keinem Thema passten, und in
' einer Groesse, die die Leiste krumm strecken musste.
SUB symbol(eintrag AS INTEGER, art AS STRING)
    GUI_MENU_ICON(eintrag, art)
END SUB

symbol(miNeu, "neu") : symbol(miOeffnen, "oeffnen") : symbol(miSchnell, "oeffnen")
symbol(miSichern, "sichern") : symbol(miSichernAls, "sichern")
symbol(miDrucken, "drucken") : symbol(miPdf, "export")
symbol(miSuchen, "suchen") : symbol(miWeiter, "suchen") : symbol(miErsetzen, "suchen")
symbol(miProjekt, "suchen") : symbol(miTodo, "suchen") : symbol(miBlame, "info")
symbol(miStart, "start") : symbol(miStopp, "stopp") : symbol(miPruefen, "pruefen")
symbol(miDebug, "debug") : symbol(miHaltepunkt, "haltepunkt") : symbol(miBedingung, "haltepunkt")
symbol(miExport, "export")
symbol(miWzSfx, "werkzeug") : symbol(miWzPartikel, "werkzeug") : symbol(miWzTilemap, "werkzeug")
symbol(miWzSprite, "werkzeug") : symbol(miWzTracker, "werkzeug") : symbol(miWzForm, "werkzeug")
symbol(miWzAnim, "werkzeug") : symbol(miWzNoten, "werkzeug")
symbol(miHandbuch, "handbuch") : symbol(miKuerzel, "handbuch")
symbol(miUmbruch, "umbruch") : symbol(miLeiste, "menue")

' Vorschaubilder, die es schon gibt, sofort zeigen.
DIM kvs AS INTEGER
FOR kvs = 0 TO KACHEL_PLAETZE - 1
    kachelTextur[kvs] = -1
NEXT
protokoll("kacheln " + STR$(kachelAnzahl))
FOR kvs = 0 TO kachelAnzahl - 1
    kachelBildSetzen(kvs)
NEXT

' --- Schnipsel: die Geruester, die man staendig tippt -----------------
' Der senkrechte Strich sagt, wohin die Schreibmarke danach gehoert.
schnipsel("Spielschleife (SCREEN + Bildschleife)", "screen", "SCREEN(800, 600, " + CHR$(34) + "Spiel" + CHR$(34) + ", 1)" + NL + "SETFPS(60)" + NL + NL + "WHILE NOT QUITREQUESTED()" + NL + "    CLS(BLACK)" + NL + "    |" + NL + "    FLIP()" + NL + "WEND")
schnipsel("FOR-Schleife", "for", "DIM i AS INTEGER" + NL + "FOR i = 0 TO |" + NL + NL + "NEXT")
schnipsel("FOR EACH", "foreach", "DIM e AS STRING" + NL + "FOR EACH e IN |" + NL + NL + "NEXT")
schnipsel("WHILE", "while", "WHILE |" + NL + NL + "WEND")
schnipsel("IF ... ELSE", "if", "IF | THEN" + NL + NL + "ELSE" + NL + NL + "END IF")
schnipsel("SELECT CASE", "select", "SELECT CASE |" + NL + "    CASE 1" + NL + NL + "    CASE ELSE" + NL + NL + "END SELECT")
schnipsel("SUB", "sub", "SUB |()" + NL + NL + "END SUB")
schnipsel("FUNCTION", "function", "FUNCTION |() AS INTEGER" + NL + "    RETURN 0" + NL + "END FUNCTION")
schnipsel("CLASS mit Init", "class", "CLASS |" + NL + "    DIM wert AS INTEGER" + NL + NL + "    SUB Init()" + NL + "        Self.wert = 0" + NL + "    END SUB" + NL + "END CLASS")
schnipsel("TRY ... CATCH", "try", "TRY" + NL + "    |" + NL + "CATCH e" + NL + "    PRINT " + CHR$(34) + "Fehler: " + CHR$(34) + " + e" + NL + "END TRY")
schnipsel("Datei zeilenweise lesen", "readlines", "DIM zeilen AS ARRAY OF STRING" + NL + "zeilen = READLINES(|)" + NL + "DIM z AS STRING" + NL + "FOR EACH z IN zeilen" + NL + "    PRINT z" + NL + "NEXT")
schnipsel(tr$("gui-Fenster mit Knopf"), "gui", "IMPORT " + CHR$(34) + "gui" + CHR$(34) + NL + "DIM win AS GUI_WINDOW" + NL + "win = GUI_WINDOW(" + CHR$(34) + tr$("Fenster") + CHR$(34) + ", 60, 60, 320, 200)" + NL + "DIM knopf AS GUI_WIDGET" + NL + "knopf = GUI_BUTTON(win, " + CHR$(34) + tr$("Los") + CHR$(34) + ", 20, 20, 100, 30)" + NL + NL + "WHILE NOT QUITREQUESTED()" + NL + "    GUI_UPDATE()" + NL + "    IF GUI_CLICKED(knopf) THEN |" + NL + "    CLS(BLACK)" + NL + "    GUI_DRAW()" + NL + "    FLIP()" + NL + "WEND")
schnipsel("Sprite mit Animation", "sprite", "DIM held AS SPRITE" + NL + "held = SPRITE_NEW(LOADIMAGE(|), 32, 32)" + NL + "SPRITE_ADD_ANIM(held, " + CHR$(34) + "lauf" + CHR$(34) + ", 0, 3, 8.0)" + NL + "SPRITE_PLAY(held, " + CHR$(34) + "lauf" + CHR$(34) + ")")

' Die Tafel der Menuepunkte (siehe menueBefehl) -- hinter der Palette,
' weil die Tastenbelegung die Vorgaben BEIDER braucht.
menueBefehl(miNeu, "neu", "Strg+N") : menueBefehl(miOeffnen, "oeffnen", "Strg+O") : menueBefehl(miSichern, "sichern", "Strg+S")
menueBefehl(miSichernAls, "sichern_unter", "") : menueBefehl(miSchliessen, "schliessen", "Strg+W") : menueBefehl(miBeenden, "beenden", "Strg+Q")
menueBefehl(miSuchen, "suchen", "Strg+F") : menueBefehl(miWeiter, "weiter", "F3") : menueBefehl(miZurueckSuchen, "zurueck_suchen", "Umschalt+F3")
menueBefehl(miErsetzen, "ersetzen", "Strg+H") : menueBefehl(miErsetzenEins, "ersetzen_eins", "Strg+Umschalt+1") : menueBefehl(miErsetzenAlle, "ersetzen_alle", "Strg+Alt+Enter")
menueBefehl(miZeile, "zeile", "Strg+G") : menueBefehl(miProjekt, "projekt", "Strg+Umschalt+F") : menueBefehl(miVervoll, "vervoll", "Strg+Leer")
menueBefehl(miNavZurueck, "nav_zurueck", "Strg+Alt+Links") : menueBefehl(miNavVor, "nav_vor", "Strg+Alt+Rechts")
menueBefehl(miBNeuDatei, "baum_neue_datei", "") : menueBefehl(miBNeuOrdner, "baum_neuer_ordner", "") : menueBefehl(miBUmbenennen, "baum_umbenennen", "")
menueBefehl(miBLoeschen, "baum_loeschen", "") : menueBefehl(miBPfad, "baum_pfad", "")
menueBefehl(miAZeile, "ausgabe_zeile_kopieren", "") : menueBefehl(miAKopieren, "ausgabe_kopieren", "") : menueBefehl(miASichern, "ausgabe_sichern", "") : menueBefehl(miALeeren, "ausgabe_leeren", "")
menueBefehl(miDefinition, "definition", "F12") : menueBefehl(miUmbenennen, "umbenennen", "Umschalt+F6") : menueBefehl(miKorrektur, "korrektur", "Strg+.")
menueBefehl(miSchnipsel, "schnipsel", "Strg+J") : menueBefehl(miEinstellungen, "einstellungen", "Strg+U") : menueBefehl(miBefehle, "befehle", "Strg+F3")
menueBefehl(miPeek, "peek", "Alt+F12") : menueBefehl(miSymbole, "symbole", "Strg+Umschalt+S") : menueBefehl(miErsProjekt, "ersetzen_projekt", "Strg+Umschalt+H")
menueBefehl(miAusgabeSuche, "ausgabe_suchen", "Strg+Umschalt+A") : menueBefehl(miMarkeNaechste, "marke_naechste", "Strg+Umschalt+N") : menueBefehl(miMarkeEnden, "marken_enden", "Strg+Umschalt+I")
menueBefehl(miErweitern, "erweitern", "Strg+Umschalt+Hoch") : menueBefehl(miHerausloesen, "herausloesen", "Strg+Umschalt+R") : menueBefehl(miVerkleinern, "verkleinern", "Strg+Umschalt+Runter")
menueBefehl(miUmbProjekt, "umb_projekt", "Strg+Umschalt+F6") : menueBefehl(miParameter, "parameter", "Strg+Umschalt+U") : menueBefehl(miAufrufer, "aufrufer", "Umschalt+F12")
menueBefehl(miFundstellen, "fundstellen", "Strg+Umschalt+F12") : menueBefehl(miVerschieben, "verschieben", "Strg+Umschalt+V") : menueBefehl(miUmbauZur, "umbau_zurueck", "Strg+Umschalt+Z")
menueBefehl(miUmbauWdh, "umbau_wieder", "") : menueBefehl(miUmbauNach, "umbau_nach", "Strg+Umschalt+G") : menueBefehl(miVergleich, "vergleichen", "")
menueBefehl(miReiterVgl, "reiter_vergleich", "") : menueBefehl(miZlSort, "zl_sortieren", "") : menueBefehl(miZlDoppelt, "zl_doppelte", "")
menueBefehl(miZlRand, "zl_rand", "") : menueBefehl(miAndereZu, "andere_zu", "Strg+Umschalt+W") : menueBefehl(miLinien, "linien", "")
menueBefehl(miTypen, "typ_hinweise", "") : menueBefehl(miFarbenEigen, "farben_eigen", "")
menueBefehl(miFehlerEnde, "fehler_am_ende", "") : menueBefehl(miKopf, "blockkopf", "") : menueBefehl(miWaerme, "profil_waerme", "") : menueBefehl(miZaehler, "aufrufzaehler", "") : menueBefehl(miQv, "git_fenster", "Strg+Alt+G")
menueBefehl(miLive, "live", "Strg+Alt+L") : menueBefehl(miPruefsammlung, "pruefsammlung", "Strg+Alt+F5") : menueBefehl(miPrueffall, "prueffall", "Strg+Alt+Umschalt+F5")
menueBefehl(miTestUebersicht, "test_uebersicht", "Strg+Alt+T") : menueBefehl(miNeuProjekt, "neues_projekt", "Strg+Alt+N") : menueBefehl(miEinfuehren, "einfuehren", "Strg+Alt+V")
menueBefehl(miEinsetzen, "einsetzen", "Strg+Alt+I") : menueBefehl(miSubFunc, "sub_function", "Strg+Alt+U") : menueBefehl(miKonfMeine, "konflikt_meine", "")
menueBefehl(miKonfIhre, "konflikt_ihre", "") : menueBefehl(miKonfBeide, "konflikt_beide", "") : menueBefehl(miBlameZeile, "blame_zeile", "")
menueBefehl(miLeiste, "leiste", "") : menueBefehl(miBaumOeffnen, "baum_oeffnen", "Strg+Umschalt+E") : menueBefehl(miHakenWeg, "haken_weg", "")
menueBefehl(miBaumHaken, "baum_haken", "") : menueBefehl(miMarken, "marken", "Strg+Umschalt+L") : menueBefehl(miPalette, "palette", "Strg+Umschalt+P")
menueBefehl(miStart, "start", "F5") : menueBefehl(miStopp, "stopp", "Umschalt+F5") : menueBefehl(miPruefen, "pruefen", "Umschalt+F7")
menueBefehl(miPrjPruefen, "projekt_pruefen", "Strg+Umschalt+F7") : menueBefehl(miDebug, "debug", "F7") : menueBefehl(miHaltepunkt, "haltepunkt", "F9")
menueBefehl(miAnhalten, "anhalten", "F6") : menueBefehl(miStartArgs, "start_argumente", "") : menueBefehl(miStartUmg, "start_umgebung", "") : menueBefehl(miNeustartSichern, "neustart_sichern", "")
menueBefehl(miNeustart, "neustart", "Strg+Umschalt+F5") : menueBefehl(miHpListe, "hp_liste", "Strg+Umschalt+F9")
menueBefehl(miProfil, "profil", "Strg+Umschalt+Y") : menueBefehl(miAusgabeLeer, "ausgabe_leeren", "") : menueBefehl(miThema, "thema", "")
menueBefehl(miVollbild, "vollbild", "Alt+Enter") : menueBefehl(miUmbruch, "umbruch", "Alt+Z") : menueBefehl(miGeteilt, "geteilt", "Alt+G")
menueBefehl(miSpiegel, "spiegel", "Alt+Umschalt+G") : menueBefehl(miSeiten, "seitenleiste", "Alt+1") : menueBefehl(miUnten, "untere_leiste", "Alt+2")
menueBefehl(miMinimap, "minimap", "") : menueBefehl(miFalten, "falten", "F4") : menueBefehl(miFaltenAlle, "falten_alle", "Strg+F4")
menueBefehl(miFaltenAuf, "falten_auf", "Umschalt+F4") : menueBefehl(miUeber, "ueber", "") : menueBefehl(miHandbuch, "handbuch", "F1")
menueBefehl(miDrucken, "drucken", "Strg+P") : menueBefehl(miPdf, "pdf", "") : menueBefehl(miWzSfx, "wz_sfx", "")
menueBefehl(miWzPartikel, "wz_partikel", "") : menueBefehl(miWzTilemap, "wz_tilemap", "") : menueBefehl(miWzSprite, "wz_sprite", "")
menueBefehl(miWzTracker, "wz_tracker", "") : menueBefehl(miWzForm, "wz_form", "") : menueBefehl(miWzAnim, "wz_anim", "")
menueBefehl(miWzNoten, "wz_noten", "") : menueBefehl(miBeispiele, "beispiele", "") : menueBefehl(miThemen, "beispiele_themen", "")
menueBefehl(miAusdruck, "ausdruck", "Strg+E") : menueBefehl(miSchnell, "schnell", "Strg+Umschalt+O") : menueBefehl(miTodo, "todo", "Strg+Umschalt+M")
menueBefehl(miBlame, "blame", "Strg+Umschalt+B") : menueBefehl(miDiff, "diff", "Strg+Umschalt+D") : menueBefehl(miVerlauf, "verlauf", "")
menueBefehl(miGitRand, "git_rand", "") : menueBefehl(miKommentar, "kommentar", "Strg+K") : menueBefehl(miDuplizieren, "duplizieren", "Strg+D")
menueBefehl(miZeileWeg, "zeile_weg", "Strg+Umschalt+K") : menueBefehl(miHoch, "hoch", "Alt+Hoch") : menueBefehl(miRunter, "runter", "Alt+Runter")
menueBefehl(miEinruecken, "einruecken", "Alt+Rechts") : menueBefehl(miAusruecken, "ausruecken", "Alt+Links") : menueBefehl(miFormat, "format", "Umschalt+Alt+F")
menueBefehl(miLesezeichen, "lesezeichen", "Strg+F2") : menueBefehl(miLzWeiter, "lz_weiter", "F2") : menueBefehl(miLzZurueck, "lz_zurueck", "Umschalt+F2")
menueBefehl(miLzListe, "lz_liste", "Alt+F2") : menueBefehl(miRegex, "regex", "") : menueBefehl(miGross, "gross_klein", "Alt+C")
menueBefehl(miWort, "ganzes_wort", "Alt+W") : menueBefehl(miWiederauf, "wiederauf", "Strg+Umschalt+T") : menueBefehl(miBedingung, "bedingung", "Umschalt+F9")
menueBefehl(miExport, "export", "Strg+F6") : menueBefehl(miGroesser, "groesser", "Strg+Plus") : menueBefehl(miKleiner, "kleiner", "Strg+Minus")
menueBefehl(miNormal, "schrift_normal", "Strg+0") : menueBefehl(miKuerzel, "kuerzel", "Strg+F1") : menueBefehl(miWeiterD, "weiter_d", "F8", FALSE)
menueBefehl(miDrueber, "drueber", "F10", FALSE) : menueBefehl(miHinein, "hinein", "F11", FALSE) : menueBefehl(miHeraus, "heraus", "Umschalt+F11", FALSE)
menueBefehl(miBisMarke, "bis_marke", "Strg+F10", FALSE) : menueBefehl(miSchnipselEigen, "schnipsel_eigen", "") : menueBefehl(miSchnipselAuswahl, "schnipsel_auswahl", "")
menueBefehl(miTerminal, "terminal", "Alt+3") : menueBefehl(miSprache, "sprache", "") : menueBefehl(miTasten, "tasten", "") : menueBefehl(miTastenZurueck, "tasten_zurueck", "")
DIM bkv AS INTEGER
FOR bkv = 0 TO LEN(befehlKuerzel) - 1
    ARRAY_PUSH(befehlKuerzelVorgabe, befehlKuerzel[bkv])
NEXT
schnipselEingebautMerken()
schnipselLaden()
tastenAnwenden()

' --- Start -------------------------------------------------------------
layout()
reiterNeuSetzen()
baumFuellen()
zuletztAnzeigen()
' Die Sitzung von zuletzt: was offen war, ist wieder offen (was es noch
' gibt). Gefragt wird zuerst nach DIESEM Projekt -- kennt die Datei den
' Ordner nicht, gilt die zuletzt geschlossene Sitzung, wie bis Stand 4.
DIM sitzDateien AS ARRAY OF STRING : sitzDateien = []
DIM sitzAktiv AS INTEGER : sitzAktiv = 0
DIM sp0 AS INTEGER : sp0 = ARRAY_INDEXOF(projOrdner, startOrdner)
IF sp0 >= 0 THEN
    IF projDateien[sp0] <> "" THEN sitzDateien = SPLIT$(projDateien[sp0], "|")
    sitzAktiv = projAktiv[sp0]
ELSEIF NOT JSON_HAS(konfig, "projekte") AND JSON_HAS(konfig, "sitzung") THEN
    ' Nur beim ersten Start nach Stand 4: da gab es die Sitzung nur einmal
    ' fuer alles. Sobald es Projekte gibt, faengt ein unbekannter Ordner
    ' LEER an -- sonst schleppte man die Reiter des letzten Projekts mit.
    DIM sz AS INTEGER
    FOR sz = 0 TO JSON_LEN(konfig, "sitzung") - 1
        ARRAY_PUSH(sitzDateien, JSON_GET_STRING(konfig, "sitzung." + STR$(sz)))
    NEXT
    IF JSON_HAS(konfig, "aktiv") THEN sitzAktiv = JSON_GET_INT(konfig, "aktiv")
END IF
DIM sd AS STRING
FOR EACH sd IN sitzDateien
    IF FILEEXISTS(sd) AND tabAnzahl < MAX_TABS THEN dateiOeffnen(sd)
NEXT
IF tabAnzahl > 0 THEN
    aktiverTab = MAX(0, MIN(tabAnzahl - 1, sitzAktiv))
    reiterNeuSetzen()
END IF
' Der Projektordner wandert beim Oeffnen mit -- fuer die Sitzung gilt aber
' der Ordner, in dem der Nutzer STAND.
IF sp0 >= 0 THEN projektOrdner = startOrdner : baumFuellen()
IF umbruchAn THEN umbruchSetzen(TRUE)
' ARG$ zaehlt ab 0: das erste Wort hinter `--`.
IF ARGC() >= 1 THEN
    DIM startDatei AS STRING : startDatei = ARG$(0)
    ' relativ heisst: relativ zum Ort des Nutzers, nicht zum Ort der IDE
    IF LEFT$(startDatei, 1) <> "/" AND LEFT$(startDatei, 1) <> "\" AND MID$(startDatei, 1, 1) <> ":" THEN
        startDatei = PATHJOIN(startOrdner, startDatei)
    END IF
    ' Ein ORDNER wird das Projekt -- wie beim Hineinziehen. FILEEXISTS kennt
    ' nur Dateien; bis 2026-09-27 hiess es fuer einen Ordner "Gibt es nicht".
    IF DIREXISTS(startDatei) THEN
        projektOrdner = startDatei
        baumFuellen()
        GUI_SET_TEXT(lblStatus, tr$("Projekt: ") + startDatei)
    ELSEIF FILEEXISTS(startDatei) THEN
        dateiOeffnen(startDatei)
    ELSE
        GUI_SET_TEXT(lblStatus, tr$("Gibt es nicht: ") + startDatei)
    END IF
END IF
' Erst anbieten, DANN den eigenen Stand anlegen -- die Suche liesse ihn
' zwar aus (whKennung), aber so ist die Reihenfolge auch ohne das richtig.
whAnbieten()
whSchreiben(TRUE)
whFaellig = GET_TIME() + whTakt
eigeneFarben(hell)
bereichsFarben()
listenSchrift(listenGroesse)
handbuchSchrift(handbuchGroesse)
IF codeFont >= 0 THEN GUI_RICHTEXT_SET(rtHandbuch, "codeschrift", codeFont)
hbFarben()
protokoll("projekt " + projektOrdner)
lichtstreif(2200)
protokoll("bereit")

DIM warBreite AS INTEGER : warBreite = SCREENWIDTH()
DIM warHoehe AS INTEGER : warHoehe = SCREENHEIGHT()
DIM letzterTab AS INTEGER : letzterTab = -1

WHILE NOT beenden
    GUI_UPDATE()
    ' Das Kreuz des Fensters (auch Alt+F4) beendet nicht sofort, sondern
    ' fragt wie Datei -> Beenden -- sonst waere ungesicherte Arbeit wortlos
    ' weg. QUITREQUESTED ohne das Kreuz ist das Bildlimit eines Testlaufs:
    ' dort endet die IDE hart, die Sicherung bleibt liegen wie bei einem Absturz.
    IF WINDOW_CLOSE_REQUESTED() THEN
        protokoll("fenster kreuz")
        IF dlgSchliessen = 0 THEN beendenAnfragen()
    ELSEIF QUITREQUESTED() THEN
        protokoll("bildlimit")
        BREAK
    END IF
    IF WINDOW_RESIZED() OR SCREENWIDTH() <> warBreite OR SCREENHEIGHT() <> warHoehe THEN
        warBreite = SCREENWIDTH() : warHoehe = SCREENHEIGHT()
        layout()
    END IF

    ' Ein Kreuz am Reiter (oder die mittlere Taste) schliesst ihn. VOR dem
    ' Reiterwechsel abfragen: das Schliessen ruecken die Reiter auf, und der
    ' Vergleich mit GUI_ACTIVE_TAB weiter unten meinte danach einen anderen.
    IF GUI_TAB_CLOSED(win) >= 0 AND dlgTabZu = 0 THEN
        tabSchliessenFragen(GUI_TAB_CLOSED(win))
    END IF

    ' Reiterwechsel durch Klick auf die Leiste
    IF tabAnzahl > 0 AND GUI_ACTIVE_TAB(win) <> aktiverTab THEN
        DIM vorherTab AS INTEGER : vorherTab = aktiverTab
        aktiverTab = GUI_ACTIVE_TAB(win)
        geteiltNachziehen(vorherTab)
        letzteMarke = ""
        ' Gliederung und faltbare Bloecke gehoeren zum FELD -- ohne das
        ' Zuruecksetzen behielte der neue Reiter die Bloecke des alten.
        gliederungSchluessel = "" : faltSchluessel = "-"
        pruefungFaellig = GET_TIME()
    END IF

    ' --- Menue (Klick oder Kuerzel) ---
    menueKlicks()
    IF GUI_CLICKED(btnReiterAusgabe) THEN terminalZeigen(FALSE)
    IF GUI_CLICKED(btnReiterTerminal) THEN terminalZeigen(TRUE)
    IF GUI_CLICKED(btnTermStopp) THEN befehl("terminal_stopp")
    terminalNachziehen()
    terminalVerlaufTasten()
    ' Werkzeugleiste: jeder Knopf ruft denselben Befehl wie sein Menuepunkt.
    DIM wzc AS INTEGER : wzc = GUI_TOOLBAR_CLICKED(leiste)
    IF wzc >= 0 THEN
        IF wzBefehle[wzc] <> "" THEN
            protokoll("leistenknopf " + wzBefehle[wzc])
            befehl(wzBefehle[wzc])
        END IF
    END IF
    ' Statusleiste und Pfadleiste: ein Klick ist derselbe Befehl wie sein Kuerzel.
    DIM sfk AS INTEGER : sfk = GUI_STATUSBAR_CLICKED(lblStatus)
    IF sfk >= 0 THEN protokoll("statusfeld " + STR$(sfk))
    IF sfk = sfPos THEN befehl("zeile")
    IF sfk = sfUmbruch THEN befehl("umbruch")
    DIM spk AS INTEGER : spk = GUI_BREADCRUMB_CLICKED(lblSpur)
    IF spk >= 0 THEN pfadAnspringen(INT(VAL(GUI_BREADCRUMB_DATA$(lblSpur, spk))))
    ' Kacheln: ein Klick oeffnet das Beispiel.
    DIM kc AS INTEGER
    FOR kc = 0 TO kachelAnzahl - 1
        IF GUI_CLICKED(kachelKarte[kc]) THEN
            protokoll("kachel " + kachelDatei[kc])
            dateiOeffnen(PATHJOIN(beispielOrdner, kachelDatei[kc]))
        END IF
    NEXT
    ' Mausrad ueber den Kacheln blaettert reihenweise.
    radZoom()
    IF tabAnzahl = 0 AND kachelReihenSichtbar > 0 AND NOT (KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)) THEN
        DIM kmx AS INTEGER : kmx = MOUSEX()
        DIM kmy AS INTEGER : kmy = MOUSEY()
        ' Nur wenn das Hauptfenster an der Stelle OBEN liegt -- sonst gehoert
        ' das Rad dem Fenster darueber (Handbuch, Palette ...), und bis
        ' 2026-09-21 rollten beide zugleich.
        IF kmx >= kfX AND kmx < kfX + kfB AND kmy >= kfY AND kmy < kfY + kfH AND GUI_WINDOW_AT(kmx, kmy) = win THEN
            DIM krad AS FLOAT : krad = MOUSEWHEEL_Y()
            IF krad <> 0 THEN
                DIM kalt AS INTEGER : kalt = kachelVersatz
                IF krad < 0 THEN kachelVersatz = kachelVersatz + 1 ELSE kachelVersatz = kachelVersatz - 1
                layout()
                IF kachelVersatz <> kalt THEN protokoll("kacheln reihe " + STR$(kachelVersatz))
            END IF
        END IF
    END IF
    vorschauNachziehen()
    aufruferAbfragen()
    ' Ein Umbau, der noch sammelt, bekommt sein Haeppchen -- und ESC bricht
    ' ihn ab, solange er laeuft.
    IF laufArt <> "" THEN
        IF KEYHIT(KEY_ESCAPE) THEN laufAbbrechen() ELSE laufSchritt()
    END IF
    IF prjAktiv THEN
        IF KEYHIT(KEY_ESCAPE) THEN projektPruefenAbbrechen() ELSE projektPruefenSchritt()
    END IF
    testNachsehen()
    qvNachziehen()
    liveNachziehen()
    testUebersichtNachziehen()
    neuProjektNachziehen()
    assetNachziehen()
    einfuehrenNachziehen()
    blameZeileNachziehen()
    IF GUI_CLICKED(miWeiterD) OR GUI_CLICKED(btnWeiter) THEN befehl("weiter_d")
    IF GUI_CLICKED(miDrueber) OR GUI_CLICKED(btnDrueber) THEN befehl("drueber")
    IF GUI_CLICKED(miHinein) OR GUI_CLICKED(btnHinein) THEN befehl("hinein")
    IF GUI_CLICKED(miHeraus) OR GUI_CLICKED(btnHeraus) THEN befehl("heraus")
    IF GUI_CLICKED(btnStoppD) THEN befehl("stopp")
    IF GUI_CLICKED(miBisMarke) OR GUI_CLICKED(btnBisMarke) THEN befehl("bis_marke")
    haltepunkteListeNachziehen()
    debugAenderungNachsehen()
    debugPanelNachziehen()
    IF GUI_CLICKED(cbProfilFunk) THEN profilTabelleFuellen()
    DIM zk AS INTEGER
    FOR zk = 0 TO ZULETZT_MAX - 1
        IF GUI_CLICKED(miZuletzt[zk]) AND zk < LEN(zuletzt) THEN dateiOeffnen(zuletzt[zk])
    NEXT
    ' Willkommensseite
    IF GUI_CLICKED(btnWkNeu) THEN befehl("neu")
    IF GUI_CLICKED(btnWkOeffnen) THEN befehl("oeffnen")
    IF GUI_CLICKED(btnWkBeispiele) THEN befehl("beispiele")
    IF GUI_CLICKED(btnWkThemen) THEN befehl("beispiele_themen")
    IF GUI_DOUBLE_CLICKED(lstWkZuletzt) AND GUI_LISTBOX_SELECTED(lstWkZuletzt) >= 0 AND GUI_LISTBOX_SELECTED(lstWkZuletzt) < LEN(zuletzt) THEN dateiOeffnen(zuletzt[GUI_LISTBOX_SELECTED(lstWkZuletzt)])
    IF GUI_DOUBLE_CLICKED(lstGliederung) THEN gliederungAnspringen()
    ' Druckdialog
    IF GUI_CLICKED(btnDruckOk) THEN druckenAusfuehren()
    IF GUI_CLICKED(btnDruckPdf) THEN GUI_WINDOW_VISIBLE(winDruck, FALSE) : druckOptionenLesen() : listingAlsPdf()
    IF GUI_CLICKED(btnDruckWeg) THEN GUI_WINDOW_VISIBLE(winDruck, FALSE) : GUI_FOCUS(aktivesFeld())
    ' Handbuch: Klappliste wechselt das Dokument, Enter/Knopf sucht darin.
    IF GUI_DROPDOWN_SELECTED(ddDoku) <> docLetzteWahl AND GUI_DROPDOWN_SELECTED(ddDoku) >= 0 THEN
        IF hbTrModus THEN hbTrModus = FALSE : GUI_SET_TEXT(btnHbAlle, tr$("In allen"))
        handbuchZeigen(docNamen[GUI_DROPDOWN_SELECTED(ddDoku)], 1)
    END IF
    IF GUI_ENTERED(tfHbSuche) THEN handbuchSuchen(NOT (KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT)))
    IF GUI_CLICKED(btnHbSuche) THEN handbuchSuchen(TRUE)
    IF GUI_CLICKED(btnHbZurueck) THEN handbuchSuchen(FALSE)
    IF GUI_CLICKED(btnHbAlle) THEN
        IF hbTrModus THEN
            hbSucheAlleEnde()
        ELSE
            hbSucheAlle()
        END IF
    END IF
    IF GUI_RICHTEXT_CODE_ACTION$(rtHandbuch) <> "" THEN hbCodeAktion(GUI_RICHTEXT_CODE_ACTION$(rtHandbuch), GUI_RICHTEXT_CODE$(rtHandbuch))
    IF GUI_CLICKED(btnHbAnsicht) THEN handbuchAnsicht(NOT hbGesetzt)
    IF GUI_CLICKED(btnHbRueck) THEN hbVerlauf(TRUE)
    IF GUI_CLICKED(btnHbVor) THEN hbVerlauf(FALSE)
    IF GUI_WINDOW_AT(MOUSEX(), MOUSEY()) = winHandbuch AND (KEYPRESSED(KEY_LALT) OR KEYPRESSED(KEY_RALT)) THEN
        IF KEYHIT(KEY_LEFT) THEN hbVerlauf(TRUE)
        IF KEYHIT(KEY_RIGHT) THEN hbVerlauf(FALSE)
    END IF
    hbInhaltNachziehen()
    IF GUI_RICHTEXT_LINK$(rtHandbuch) <> "" THEN handbuchVerweis(GUI_RICHTEXT_LINK$(rtHandbuch))
    werkzeugeAufraeumen()
    ' GUI_TABLE_CLICKED liefert die Zeile oder -1 -- und -1 ist WAHR. Bis
    ' Stand 30 lief profilAnspringen darum in jedem Bild und nagelte die
    ' Marke nach dem ersten Klick ins Profil auf dessen Zeile fest.
    IF GUI_TABLE_CLICKED(tblProfil) >= 0 THEN profilAnspringen()
    gitRandNachziehen(FALSE)
    farbfeldNachziehen()
    einstellungenNachziehen()
    befehleNachziehen()
    themenNachziehen()
    IF GUI_CLICKED(btnEinstZu) THEN GUI_WINDOW_VISIBLE(winEinst, FALSE) : einstOffen = FALSE : GUI_FOCUS(aktivesFeld())
    IF GUI_CLICKED(btnBefehlEin) OR GUI_DOUBLE_CLICKED(lstBefehle) THEN befehlEinfuegen()
    IF GUI_CLICKED(btnPeekZu) THEN GUI_WINDOW_VISIBLE(winPeek, FALSE) : GUI_FOCUS(aktivesFeld())
    IF GUI_CLICKED(btnPeekHin) THEN
        GUI_WINDOW_VISIBLE(winPeek, FALSE)
        IF peekPfad <> "" THEN dateiOeffnen(peekPfad)
        IF aktivesFeld() >= 0 AND peekZeile > 0 THEN GUI_TEXTAREA_GOTO(aktivesFeld(), peekZeile, 1)
        GUI_FOCUS(aktivesFeld())
    END IF
    IF GUI_CLICKED(btnFarbeOk) THEN farbeUebernehmen()
    IF GUI_CLICKED(btnFarbeWeg) THEN GUI_WINDOW_VISIBLE(winFarbe, FALSE) : farbStart = -1 : GUI_FOCUS(aktivesFeld())
    IF GUI_CLICKED(btnUmbauOk) THEN umbauSchreiben()
    IF GUI_CLICKED(btnUmbauWeg) THEN umbauVerwerfen()
    IF GUI_CLICKED(btnUmbauBlock) THEN umbauBlockKippen()
    IF GUI_CLICKED(btnUmbauPruef) THEN umbauPruefen()
    ' Enter und ESC gelten auch, wenn die Marke in der Dateiliste steht --
    ' eine Liste nimmt die Taste sonst fuer sich, und der Standard-Knopf
    ' kommt nicht mehr dran. Wer gerade etwas abgewaehlt hat, steht aber
    ' genau dort.
    IF GUI_WINDOW_SHOWN(winUmbau) AND GUI_FOCUSED() = lstUmbau THEN
        IF KEYHIT(KEY_RETURN) THEN umbauSchreiben()
        IF KEYHIT(KEY_ESCAPE) THEN umbauVerwerfen()
    END IF
    IF GUI_CLICKED(btnParamHoch) THEN parameterSchieben(-1)
    IF GUI_CLICKED(btnParamRunter) THEN parameterSchieben(1)
    IF GUI_CLICKED(btnParamPlus) THEN dlgParamNeu = GUI_PROMPT(tr$("Neuer Parameter"), _
        "Deklaration mit Wert -- der Teil hinter dem = kommt an jede Aufrufstelle:", "hp AS INTEGER = 0")
    IF GUI_CLICKED(btnParamMinus) THEN parameterWeg()
    IF GUI_CLICKED(btnParamOk) THEN parameterUebernehmen()
    IF GUI_CLICKED(btnParamWeg) THEN GUI_WINDOW_VISIBLE(winParam, FALSE) : GUI_FOCUS(aktivesFeld())

    ' --- Dialoge auswerten ---
    startFrageNachziehen()
    baumDialogNachziehen()
    IF dlgSuche <> 0 THEN
        DIM a AS INTEGER : a = GUI_ANSWER(dlgSuche)
        IF a = 1 THEN
            suchtext = GUI_DIALOG_TEXT(dlgSuche)
            dlgSuche = 0
            IF schliessenNachDialog THEN
                schliessenNachDialog = FALSE
                dlgErsetze = GUI_PROMPT(tr$("Ersetzen"), tr$("Ersetzen durch:"), ersatztext)
            ELSE
                trefferSpringen(TRUE)
            END IF
        ELSEIF a = 2 THEN
            dlgSuche = 0 : schliessenNachDialog = FALSE
        END IF
    END IF
    IF dlgErsetze <> 0 THEN
        DIM a2 AS INTEGER : a2 = GUI_ANSWER(dlgErsetze)
        IF a2 = 1 AND ersetzenZiel = "projekt" THEN
            ersatztext = GUI_DIALOG_TEXT(dlgErsetze)
            dlgErsetze = 0
            ersetzenZiel = "feld"
            ' Gearbeitet wird auf den DATEIEN. Ein Reiter mit ungesicherten
            ' Aenderungen wuerde sie beim naechsten Sichern ueberschreiben --
            ' lieber abbrechen und es sagen.
            IF projektUngesichert() THEN
                GUI_SET_TEXT(lblStatus, tr$("Erst sichern: ein Reiter hat ungesicherte Änderungen."))
                protokoll("projekt ersetzt -1")
            ELSE
                DIM pStellen AS INTEGER
                DIM pDateien AS INTEGER
                (pStellen, pDateien) = projektErsetzenZaehlen(suchtext)
                IF pStellen = 0 THEN
                    GUI_SET_TEXT(lblStatus, tr$("Nicht im Projekt gefunden: ") + suchtext)
                    protokoll("projekt ersetzt 0")
                ELSE
                    dlgProjErsetze = GUI_DIALOG(tr$("Im ganzen Projekt ersetzen"), _
                        STR$(pStellen) + " Zeile(n) in " + STR$(pDateien) + " Datei(en) enthalten '" + suchtext + "'." + NL + _
                        "Durch '" + ersatztext + "' ersetzen? Das lässt sich nur über git zurücknehmen.", _
                        "Ersetzen|Abbrechen")
                END IF
            END IF
        ELSEIF a2 = 2 THEN
            dlgErsetze = 0 : ersetzenZiel = "feld"
        END IF
    END IF
    IF dlgHeraus <> 0 THEN
        DIM ah AS INTEGER : ah = GUI_ANSWER(dlgHeraus)
        IF ah = 1 THEN
            DIM hname AS STRING : hname = TRIM$(GUI_DIALOG_TEXT(dlgHeraus))
            dlgHeraus = 0
            herausloesen(hname)
        ELSEIF ah = 2 THEN
            dlgHeraus = 0
        END IF
    END IF
    IF dlgUmbProjekt <> 0 THEN
        DIM au AS INTEGER : au = GUI_ANSWER(dlgUmbProjekt)
        IF au = 1 THEN
            DIM neuerName AS STRING : neuerName = TRIM$(GUI_DIALOG_TEXT(dlgUmbProjekt))
            dlgUmbProjekt = 0
            umbenennenImProjekt(neuerName)
        ELSEIF au = 2 THEN
            dlgUmbProjekt = 0
        END IF
    END IF
    IF dlgProjErsetze <> 0 THEN
        DIM ap AS INTEGER : ap = GUI_ANSWER(dlgProjErsetze)
        IF ap = 1 THEN
            dlgProjErsetze = 0
            projektErsetzenAusfuehren()
        ELSEIF ap = 2 THEN
            dlgProjErsetze = 0
            GUI_SET_TEXT(lblStatus, tr$("Nichts ersetzt."))
        END IF
    END IF
    IF dlgAusgabeSuche <> 0 THEN
        DIM aa AS INTEGER : aa = GUI_ANSWER(dlgAusgabeSuche)
        IF aa = 1 THEN
            DIM neuerText AS STRING : neuerText = GUI_DIALOG_TEXT(dlgAusgabeSuche)
            dlgAusgabeSuche = 0
            ' Derselbe Text noch einmal heisst "weitersuchen" -- ein neuer
            ' faengt oben an.
            DIM abZeile AS INTEGER : abZeile = 0
            IF neuerText = ausgabeSuchtext THEN abZeile = GUI_LISTBOX_SELECTED(lstAusgabe) + 1
            ausgabeSuchtext = neuerText
            IF ausgabeSuchtext <> "" THEN ausgabeSuchen(abZeile)
        ELSEIF aa = 2 THEN
            dlgAusgabeSuche = 0
        END IF
    END IF
    IF dlgZeile <> 0 THEN
        DIM a3 AS INTEGER : a3 = GUI_ANSWER(dlgZeile)
        IF a3 = 1 THEN
            DIM zt AS STRING : zt = GUI_DIALOG_TEXT(dlgZeile)
            dlgZeile = 0
            DIM ta2 AS GUI_WIDGET : ta2 = aktivesFeld()
            IF ta2 >= 0 AND VAL(zt) >= 1 THEN GUI_TEXTAREA_GOTO(ta2, INT(VAL(zt)), 1) : GUI_FOCUS(ta2)
        ELSEIF a3 = 2 THEN
            dlgZeile = 0
        END IF
    END IF
    IF dlgSchliessen <> 0 THEN
        DIM a4 AS INTEGER : a4 = GUI_ANSWER(dlgSchliessen)
        IF a4 = 1 THEN
            DIM i AS INTEGER
            DIM alles AS BOOLEAN : alles = TRUE
            FOR i = 0 TO tabAnzahl - 1
                IF GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN
                    IF NOT sichern(i, FALSE) THEN alles = FALSE
                END IF
            NEXT
            dlgSchliessen = 0
            IF alles THEN beenden = TRUE
        ELSEIF a4 = 2 THEN
            dlgSchliessen = 0 : beenden = TRUE
        ELSEIF a4 = 3 THEN
            dlgSchliessen = 0
        END IF
    END IF
    IF dlgTasten <> 0 THEN
        DIM atk AS INTEGER : atk = GUI_ANSWER(dlgTasten)
        IF atk = 1 THEN
            DIM tktext AS STRING : tktext = TRIM$(GUI_DIALOG_TEXT(dlgTasten))
            dlgTasten = 0
            tastenSetzen(tastenKennung, tktext)
        ELSEIF atk <> 0 THEN
            dlgTasten = 0
        END IF
    END IF
    IF dlgSchnipsel <> 0 THEN
        DIM asn AS INTEGER : asn = GUI_ANSWER(dlgSchnipsel)
        IF asn = 1 THEN
            DIM sntext AS STRING : sntext = GUI_DIALOG_TEXT(dlgSchnipsel)
            dlgSchnipsel = 0
            schnipselAuswahlSichern(sntext)
        ELSEIF asn <> 0 THEN
            dlgSchnipsel = 0
        END IF
    END IF
    IF dlgVerschNeu <> 0 THEN
        DIM av AS INTEGER : av = GUI_ANSWER(dlgVerschNeu)
        IF av = 1 THEN
            DIM vname AS STRING : vname = TRIM$(GUI_DIALOG_TEXT(dlgVerschNeu))
            dlgVerschNeu = 0
            IF vname <> "" THEN
                IF LOWER$(RIGHT$(vname, 3)) <> ".dh" THEN vname = vname + ".dh"
                verschiebenNach(PATHJOIN(projektOrdner, vname))
            END IF
        ELSEIF av <> 0 THEN
            dlgVerschNeu = 0
        END IF
    END IF
    IF dlgParamNeu <> 0 THEN
        DIM ap AS INTEGER : ap = GUI_ANSWER(dlgParamNeu)
        IF ap = 1 THEN
            DIM ptext AS STRING : ptext = GUI_DIALOG_TEXT(dlgParamNeu)
            dlgParamNeu = 0
            parameterNeu(ptext)
        ELSEIF ap <> 0 THEN
            dlgParamNeu = 0
            GUI_FOCUS(lstParam)
        END IF
    END IF
    IF dlgWieder <> 0 THEN
        DIM aw AS INTEGER : aw = GUI_ANSWER(dlgWieder)
        IF aw = 1 THEN
            dlgWieder = 0
            whHolen()
        ELSEIF aw = 2 THEN
            dlgWieder = 0
            whVerwerfen()
        ELSEIF aw = 3 THEN
            ' Spaeter: liegen lassen, der naechste Start fragt wieder.
            dlgWieder = 0
            whFremd = []
            protokoll("wiederherstellung spaeter")
        END IF
    END IF
    IF dlgTabZu <> 0 THEN
        DIM a5 AS INTEGER : a5 = GUI_ANSWER(dlgTabZu)
        IF a5 = 1 THEN
            dlgTabZu = 0
            IF sichern(tabZuIndex, FALSE) THEN tabSchliessen(tabZuIndex)
        ELSEIF a5 = 2 THEN
            dlgTabZu = 0 : tabSchliessen(tabZuIndex)
        ELSEIF a5 = 3 THEN
            dlgTabZu = 0
        END IF
    END IF
    IF ueberOffen AND GUI_CLICKED(btnUeberOk) THEN
        GUI_WINDOW_MODAL(winUeber, FALSE)
        GUI_WINDOW_VISIBLE(winUeber, FALSE)
        ueberOffen = FALSE
        protokoll("ueber zu")
    END IF
    IF dlgProjekt <> 0 THEN
        DIM a5 AS INTEGER : a5 = GUI_ANSWER(dlgProjekt)
        IF a5 = 1 THEN
            suchtext = GUI_DIALOG_TEXT(dlgProjekt)
            dlgProjekt = 0
            projektSuchen(suchtext, "")
        ELSEIF a5 = 2 THEN
            dlgProjekt = 0
        END IF
    END IF
    IF dlgUmbenennen <> 0 THEN
        DIM a7 AS INTEGER : a7 = GUI_ANSWER(dlgUmbenennen)
        IF a7 = 1 THEN
            DIM neuerName AS STRING : neuerName = TRIM$(GUI_DIALOG_TEXT(dlgUmbenennen))
            dlgUmbenennen = 0
            umbenennenAusfuehren(neuerName)
        ELSEIF a7 = 2 THEN
            dlgUmbenennen = 0
        END IF
    END IF
    IF dlgBedingung <> 0 THEN
        DIM a6 AS INTEGER : a6 = GUI_ANSWER(dlgBedingung)
        IF a6 = 1 THEN
            DIM ausdruck AS STRING : ausdruck = GUI_DIALOG_TEXT(dlgBedingung)
            dlgBedingung = 0
            haltepunktBedingungSetzen(ausdruck)
        ELSEIF a6 = 2 THEN
            dlgBedingung = 0
        END IF
    END IF

    ' --- Suchleiste ---
    IF sucheOffen THEN sucheNachziehen()

    ' --- Befehlspalette: tippen filtert, Enter/Doppelklick fuehrt aus, ESC schliesst ---
    IF paletteOffen THEN
        IF GUI_TEXT(tfPalette) <> paletteLetzterFilter THEN
            paletteLetzterFilter = GUI_TEXT(tfPalette)
            paletteFuellen(paletteLetzterFilter)
        END IF
        ' Die Pfeile bewegen die LISTE, auch wenn die Marke im Filterfeld
        ' steht -- sonst kommt man ohne Maus nur an den ersten Eintrag, und
        ' wer den zweiten will, muss ihn erst wegfiltern.
        DIM pn AS INTEGER : pn = LEN(paletteSichtbar)
        IF pn > 0 AND (KEYHIT(KEY_DOWN) OR KEYHIT(KEY_UP)) THEN
            DIM ps AS INTEGER : ps = GUI_LISTBOX_SELECTED(lstPalette)
            IF ps < 0 THEN ps = 0
            IF KEYHIT(KEY_DOWN) THEN ps = MIN(ps + 1, pn - 1) ELSE ps = MAX(ps - 1, 0)
            GUI_LISTBOX_SET_SELECTED(lstPalette, ps)
        END IF
        IF GUI_ENTERED(tfPalette) OR GUI_DOUBLE_CLICKED(lstPalette) OR (KEYHIT(KEY_RETURN) AND GUI_FOCUSED() = lstPalette) THEN paletteAusfuehren()
        IF KEYHIT(KEY_ESCAPE) THEN paletteSchliessen()
    END IF

    ' --- Vervollstaendigung: Enter/Doppelklick uebernimmt, ESC schliesst ---
    IF vervollOffen THEN
        IF GUI_DOUBLE_CLICKED(lstVervoll) OR (KEYHIT(KEY_RETURN) AND GUI_FOCUSED() = lstVervoll) THEN vervollUebernehmen()
        IF KEYHIT(KEY_ESCAPE) THEN vervollAus = wortAnfang$() : vervollSchliessen() : GUI_FOCUS(aktivesFeld())
    END IF

    ' --- Der Tabulator: drei Bedeutungen, eine Reihenfolge ---
    IF aktivesFeld() >= 0 AND GUI_TEXTAREA_TAB_HIT(aktivesFeld()) THEN tabulator()

    ' --- Baum, Probleme, Eingabe ---
    baumAbfragen()
    IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
    IF GUI_DOUBLE_CLICKED(lstAusgabe) THEN ausgabeAnspringen()
    IF GUI_CLICKED(btnEingabe) OR GUI_ENTERED(tfEingabe) THEN eingabeSenden()

    spiegelNachziehen()
    baumFilterNachziehen()
    ' --- Aenderungen im aktiven Feld: einfaerben, Pruefung vormerken ---
    IF aktiverTab >= 0 THEN
        DIM tf AS GUI_WIDGET : tf = tabFelder[aktiverTab]
        DIM jetzt AS STRING : jetzt = GUI_TEXT(tf)
        IF jetzt <> tabLetzterText[aktiverTab] THEN
            tabLetzterText[aktiverTab] = jetzt
            pruefungFaellig = GET_TIME() + 0.6
            IF autoSichern > 0 THEN autoFaellig = GET_TIME() + autoSichern
            reiterNeuSetzen()
        END IF
        ' Automatisch sichern: erst nach der eingestellten Ruhe, und nur was
        ' schon einen Namen hat -- fuer einen neuen Reiter kaeme sonst mitten
        ' im Tippen ein Datei-Dialog.
        IF autoSichern > 0 AND autoFaellig >= 0.0 AND GET_TIME() >= autoFaellig THEN
            autoFaellig = -1.0
            IF tabPfade[aktiverTab] <> "" AND jetzt <> tabGesichert[aktiverTab] THEN
                sichernOhneFormat = TRUE
                sichern(aktiverTab, FALSE)
                sichernOhneFormat = FALSE
                protokoll("auto gesichert")
            END IF
        END IF
        faerben(tf)
        ' Die zweite Ansicht hat ihren eigenen Ausschnitt, also ihre eigene
        ' Einfaerbung -- mit eigenem Riegel, sonst rechneten beide Felder in
        ' jedem Bild neu, weil sie sich den Schluessel gegenseitig
        ' ueberschrieben.
        IF spiegelAn AND taSpiegel >= 0 THEN
            DIM hauptSchl AS STRING : hauptSchl = faerbSchluessel
            faerbSchluessel = spiegelFaerbSchl
            faerben(taSpiegel)
            spiegelFaerbSchl = faerbSchluessel
            faerbSchluessel = hauptSchl
        END IF
        markenNachziehen()
        hilfeNachziehen()
        vervollNachziehen()
        spurNachziehen()
        mausNachziehen(tf)
        randKlicksNachziehen()
        IF pruefungFaellig >= 0.0 AND GET_TIME() >= pruefungFaellig THEN
            pruefungFaellig = -1.0
            pruefen()
        END IF
    END IF

    abgelegteNachziehen()
    navNachziehen()
    ausgabeFilterNachziehen()
    prozessNachsehen()
    exportNachsehen()

    ' Absturz-Wiederherstellung: im Takt schreiben, auch wenn nichts
    ' geaendert ist -- der Stand ist zugleich das Lebenszeichen.
    IF GET_TIME() >= whFaellig THEN
        whFaellig = GET_TIME() + whTakt
        whSchreiben(TRUE)
    END IF

    CLS(&H0B1119)
    GUI_DRAW()
    minimapZeichnen()
    ' Das Handbuch-Fenster liegt ueber der Leinwand des Hauptfensters und
    ' waere sonst von ihr verdeckt -- GUI_DRAW zeichnet Fenster und
    ' Zeichenflaechen in EINEM Durchgang, das Gemalte kommt danach.
    IF GUI_WINDOW_SHOWN(winHandbuch) THEN GUI_DRAW_WINDOW(winHandbuch) : GUI_DRAW_TOP()
    ' Das Bild neben der Maus gehoert ueber alles (es ist ein Tooltip).
    IF GUI_WINDOW_SHOWN(winBildTipp) THEN GUI_DRAW_WINDOW(winBildTipp)
    ' Die Live-Vorschau schwebt: sie bleibt sichtbar, waehrend man im Code
    ' tippt (dabei hat das Hauptfenster den Fokus und laege sonst davor).
    IF liveAn AND GUI_WINDOW_SHOWN(winLive) THEN GUI_DRAW_WINDOW(winLive)
    FLIP()
WEND

' Sauber beendet heisst: ueber die Rueckfrage (alles gesichert oder
' ausdruecklich verworfen) oder ohne ungesicherte Reiter -- dann ist der
' Stand leer oder unerwuenscht und geht weg. Endete die IDE dagegen OHNE
' Rueckfrage mit ungesicherten Reitern (das Fenster-Kreuz fragt nicht, und
' ein Absturz schon gar nicht), bleibt er liegen, als beendet markiert --
' der naechste Start bietet ihn an.
IF beenden OR NOT ungesichert() THEN
    TRY
        IF DIREXISTS(whEigen$()) THEN RMDIR(whEigen$(), TRUE)
        protokoll("sicherung entfernt")
    CATCH fehler
        protokoll("sicherung nicht entfernbar")
    END TRY
ELSE
    whSchreiben(FALSE)
    protokoll("sicherung bleibt")
END IF
konfigSichern()
IF prozess >= 0 THEN PROCESS_KILL(prozess)
IF exportProzess >= 0 THEN PROCESS_KILL(exportProzess)
DIM wz AS INTEGER
FOR EACH wz IN werkzeuge
    PROCESS_KILL(wz)
NEXT
protokoll("ende")
