=== gespiegelt steht der baum rechts und der winkel klappt auf
' Einzug, Winkel und Name von rechts (gui_zeichnen_teile.rs `sp`); der
' Klick auf den Winkel am rechten Rand klappt auf, weil der Treffer mit
' gespiegelter Maus rechnet. GUI_TREE_ITEM_RECT beginnt am linken Rand.
IMPORT "gui"
SCREEN(480, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 480, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM b AS GUI_WIDGET : b = GUI_TREE(w, 20, 20, 300, 150)
DIM wurzel AS INTEGER : wurzel = GUI_TREE_ADD(b, -1, "Ordner")
DIM kind AS INTEGER : kind = GUI_TREE_ADD(b, wurzel, "Datei")
