lightmask 0

=== der zufall zieht dieselben zahlen wie numpy
' np.random.default_rng(7).integers(-10, 11) zwoelfmal und
' default_rng(3).integers(0, 100) zwoelfmal -- ohne Grafik pruefbar.
DIM prK AS INTEGER
DIM prZeile AS STRING
zufallStart(7)
prZeile = ""
FOR prK = 1 TO 12
    prZeile = prZeile + STR$(zufall(-10, 11)) + " "
NEXT
PRINT TRIM$(prZeile)
zufallStart(3)
prZeile = ""
FOR prK = 1 TO 12
    prZeile = prZeile + STR$(zufall(0, 100)) + " "
NEXT
PRINT TRIM$(prZeile)
EXIT(0)
--- programm ../../pyramid_pusher/assets/gen_art.dh nach CONST ICE_LO = &H6896C0
