' ======================================================================
'  SCHWARM  -  Boids in echtem 3D (native g3d-Pipeline + CAMERA_ORBIT)
' ----------------------------------------------------------------------
'  Drei Schwaerme (Arten) fliegen ueber einer Boden-Ebene (X-Z). Jeder
'  Vogel folgt drei einfachen Regeln gegenueber Nachbarn der GLEICHEN Art
'  (Craig Reynolds 1986):
'     1. SEPARATION  - nicht zu nah ans Nachbartier   (gegen ALLE Arten)
'     2. ALIGNMENT   - dieselbe Richtung wie die Nachbarn
'     3. COHESION    - zur Mitte des eigenen Schwarms
'
'  Gezeichnet wird mit der nativen 3D-Pipeline: jeder Boid ist eine Kugel
'  mit Schweif, die Tiefe macht der z-Buffer (kein Sortieren von Hand).
'  Die Kamera ist eine eingebaute Orbit-Kamera (CAMERA_ORBIT), der Maus-
'  Cursor wird per MOUSE_GROUND auf die Boden-Ebene projiziert.
'
'     2D  -> die Tiere sind auf die Boden-Ebene (Y=0) gesperrt, Kamera von
'            oben. Die harte Kollision haelt sie auseinander.
'     3D  -> Y ist frei, die Tiere steigen/tauchen und ueberlappen sich
'            im Bild (vorne/hinten) - die Kamera kreist schraeg.
'
'  STEUERUNG
'     Linke Maus HALTEN  -> Schwarm stuerzt zum Cursor (auf dem Boden)
'     RECHTE Maus ziehen  -> Kamera drehen (Umlauf + Neigung)
'     Scrollen            -> Zoom (Kamera-Abstand)
'     TAB                 -> 2D / 3D umschalten
'     F                   -> Vollbild    ESC = Ende
' ======================================================================

IMPORT "g3d"

' --- Welt (Weltkoordinaten: X rechts, Y oben, Z Tiefe) -----------------
CONST HF AS FLOAT = 20.0           ' halbe Feld-Ausdehnung (X und Z)
CONST HV AS FLOAT = 9.0            ' halbe Hoehe (Y) im 3D-Modus

CONST NUM AS INTEGER = 150
CONST SWARMS AS INTEGER = 3

' --- Flug-Parameter (Welteinheiten/Sekunde) ----------------------------
CONST MAXS AS FLOAT = 5.5
CONST MINS AS FLOAT = 2.0
CONST MAXF AS FLOAT = 8.0

CONST PERCEPT AS FLOAT = 2.4
CONST SEP_DIST AS FLOAT = 1.1
CONST PSQ AS FLOAT = 5.76          ' PERCEPT^2
CONST SSQ AS FLOAT = 1.21          ' SEP_DIST^2

CONST W_SEP AS FLOAT = 1.8
CONST W_ALI AS FLOAT = 1.0
CONST W_COH AS FLOAT = 0.9
CONST W_HOME AS FLOAT = 0.45       ' Bindung an Heimat in X/Z
CONST W_HOME_Y AS FLOAT = 0.22     ' Bindung in der Hoehe (schwaecher)
CONST W_MOUSE AS FLOAT = 3.4

CONST BODY_R AS FLOAT = 0.42       ' Kollisions-Radius (Festkoerper)
CONST COLL_PASSES AS INTEGER = 2
CONST BSIZE AS FLOAT = 0.32        ' Kugel-Radius beim Zeichnen

' ======================================================================
'  Wiederverwendbare 3D-Kollisions-Routine (Kugeln, gleiche Masse)
' ======================================================================
SUB ResolveCollisions(px AS ARRAY OF FLOAT, py AS ARRAY OF FLOAT, pz AS ARRAY OF FLOAT, vx AS ARRAY OF FLOAT, vy AS ARRAY OF FLOAT, vz AS ARRAY OF FLOAT, n AS INTEGER, r AS FLOAT, passes AS INTEGER)
    DIM minD AS FLOAT
    DIM minD2 AS FLOAT
    minD = r * 2.0
    minD2 = minD * minD
    DIM pass AS INTEGER
    DIM ci AS INTEGER
    DIM cj AS INTEGER
    DIM dx AS FLOAT
    DIM dy AS FLOAT
    DIM dz AS FLOAT
    DIM dist2 AS FLOAT
    DIM dist AS FLOAT
    DIM nx AS FLOAT
    DIM ny AS FLOAT
    DIM nz AS FLOAT
    DIM ov AS FLOAT
    DIM rvn AS FLOAT
    FOR pass = 0 TO passes - 1
        FOR ci = 0 TO n - 2
            FOR cj = ci + 1 TO n - 1
                dx = px[cj] - px[ci]
                dy = py[cj] - py[ci]
                dz = pz[cj] - pz[ci]
                dist2 = dx * dx + dy * dy + dz * dz
                IF dist2 < minD2 THEN
                    IF dist2 > 0.000001 THEN
                        dist = SQR(dist2)
                        nx = dx / dist : ny = dy / dist : nz = dz / dist
                    ELSE
                        dist = 0.0 : nx = 1.0 : ny = 0.0 : nz = 0.0
                    END IF
                    ov = (minD - dist) * 0.5
                    px[ci] = px[ci] - nx * ov : py[ci] = py[ci] - ny * ov : pz[ci] = pz[ci] - nz * ov
                    px[cj] = px[cj] + nx * ov : py[cj] = py[cj] + ny * ov : pz[cj] = pz[cj] + nz * ov
                    rvn = (vx[cj] - vx[ci]) * nx + (vy[cj] - vy[ci]) * ny + (vz[cj] - vz[ci]) * nz
                    IF rvn < 0.0 THEN
                        vx[ci] = vx[ci] + nx * rvn * 0.5 : vy[ci] = vy[ci] + ny * rvn * 0.5 : vz[ci] = vz[ci] + nz * rvn * 0.5
                        vx[cj] = vx[cj] - nx * rvn * 0.5 : vy[cj] = vy[cj] - ny * rvn * 0.5 : vz[cj] = vz[cj] - nz * rvn * 0.5
                    END IF
                END IF
            NEXT
        NEXT
    NEXT
END SUB

' ======================================================================
'  Setup
' ======================================================================
SCREEN(1280, 720, "Schwarm 3D - CAMERA_ORBIT", 1)
SET_FULLSCREEN(TRUE)
MOUSE_VISIBLE(TRUE)
RANDOMIZE(MILLIS())

DIM isFull AS BOOLEAN
isFull = TRUE
DIM fPrev AS BOOLEAN
fPrev = FALSE
DIM tPrev AS BOOLEAN
tPrev = FALSE

' Ansicht 2D/3D
DIM mode3D AS BOOLEAN
mode3D = FALSE

' Orbit-Kamera (Grad)
DIM yaw AS FLOAT
DIM pitch AS FLOAT
DIM camRadius AS FLOAT
yaw = 0.0
pitch = 89.0                       ' Start: von oben (2D-Aufsicht)
camRadius = 50.0
DIM pmx AS INTEGER
DIM pmy AS INTEGER
pmx = 0
pmy = 0
DIM rmbPrev AS BOOLEAN
rmbPrev = FALSE

' --- Tiere -------------------------------------------------------------
DIM bx[150] AS FLOAT
DIM by[150] AS FLOAT
DIM bz[150] AS FLOAT
DIM bvx[150] AS FLOAT
DIM bvy[150] AS FLOAT
DIM bvz[150] AS FLOAT
DIM bs[150] AS INTEGER

' --- Farben pro Schwarm ------------------------------------------------
DIM colDim[3] AS INTEGER
DIM colHi[3] AS INTEGER
DIM baseCol[3] AS INTEGER
baseCol[0] = RGB(255, 120, 50)
baseCol[1] = RGB(70, 200, 235)
baseCol[2] = RGB(190, 120, 255)

DIM s AS INTEGER
FOR s = 0 TO SWARMS - 1
    colDim[s] = COLOR_LERP(RGB(20, 26, 40), baseCol[s], 0.55)
    colHi[s]  = COLOR_LERP(baseCol[s], RGB(255, 255, 255), 0.30)
NEXT

' --- Schwarm-Heimatpunkte (driften in X/Z, in 3D auch in Y) ------------
DIM homeX[3] AS FLOAT
DIM homeY[3] AS FLOAT
DIM homeZ[3] AS FLOAT
DIM homeVX[3] AS FLOAT
DIM homeVY[3] AS FLOAT
DIM homeVZ[3] AS FLOAT
FOR s = 0 TO SWARMS - 1
    homeX[s] = (s - 1) * (HF * 0.6)
    homeY[s] = 0.0
    homeZ[s] = (RND(2) * 2 - 1) * (HF * 0.3)
    homeVX[s] = (RND(2) * 2 - 1) * (1.2 + RND(10) * 0.1)
    homeVZ[s] = (RND(2) * 2 - 1) * (1.0 + RND(10) * 0.1)
    homeVY[s] = (RND(2) * 2 - 1) * (1.0 + RND(8) * 0.1)
NEXT

' --- Tiere verteilen ---------------------------------------------------
DIM i AS INTEGER
FOR i = 0 TO NUM - 1
    bs[i]  = i MOD SWARMS
    bx[i]  = homeX[bs[i]] + RANDF(-3.0, 3.0)
    by[i]  = 0.0
    bz[i]  = homeZ[bs[i]] + RANDF(-3.0, 3.0)
    DIM a0 AS FLOAT
    a0 = RND(628) / 100.0
    bvx[i] = COS(a0) * MAXS
    bvz[i] = SIN(a0) * MAXS
    bvy[i] = 0.0
NEXT

' --- Arbeitsvariablen --------------------------------------------------
DIM j AS INTEGER
DIM dx AS FLOAT
DIM dy AS FLOAT
DIM dz AS FLOAT
DIM d2 AS FLOAT
DIM d AS FLOAT
DIM cnt AS INTEGER
DIM sumvx AS FLOAT
DIM sumvy AS FLOAT
DIM sumvz AS FLOAT
DIM sumpx AS FLOAT
DIM sumpy AS FLOAT
DIM sumpz AS FLOAT
DIM sepx AS FLOAT
DIM sepy AS FLOAT
DIM sepz AS FLOAT
DIM ax AS FLOAT
DIM ay AS FLOAT
DIM az AS FLOAT
DIM cdx AS FLOAT
DIM cdy AS FLOAT
DIM cdz AS FLOAT
DIM cl AS FLOAT
DIM sp2 AS FLOAT
DIM sp AS FLOAT
DIM am2 AS FLOAT
DIM sc AS FLOAT
DIM mx AS INTEGER
DIM my AS INTEGER
DIM held AS BOOLEAN
DIM curMaxF AS FLOAT
DIM tgx AS FLOAT
DIM tgz AS FLOAT
DIM haveTarget AS BOOLEAN
DIM last_ms AS INTEGER
DIM now_ms AS INTEGER
DIM dt_s AS FLOAT
last_ms = MILLIS()

' ======================================================================
'  Hauptschleife
' ======================================================================
WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(KEY_ESCAPE) THEN
        BREAK
    END IF

    ' --- Vollbild (Flanke) ---
    DIM fNow AS BOOLEAN
    fNow = KEYPRESSED(KEY_F)
    IF fNow AND NOT fPrev THEN
        isFull = NOT isFull
        SET_FULLSCREEN(isFull)
    END IF
    fPrev = fNow

    ' --- 2D/3D umschalten (Flanke) ---
    DIM tNow AS BOOLEAN
    tNow = KEYPRESSED(KEY_TAB)
    IF tNow AND NOT tPrev THEN
        mode3D = NOT mode3D
        IF mode3D THEN
            pitch = 30.0                 ' schraeg -> Tiefe sichtbar
            FOR i = 0 TO NUM - 1
                by[i] = RANDF(-HV * 0.7, HV * 0.7)
                bvy[i] = RANDF(-2.0, 2.0)
            NEXT
        ELSE
            pitch = 89.0                 ' von oben -> 2D-Aufsicht
        END IF
    END IF
    tPrev = tNow

    ' --- Zeitschritt ---
    now_ms = MILLIS()
    DIM dms AS INTEGER
    dms = now_ms - last_ms
    last_ms = now_ms
    IF dms > 50 THEN
        dms = 50
    END IF
    dt_s = dms / 1000.0

    ' --- Maus lesen ---
    mx = MOUSEX()
    my = MOUSEY()
    held = MOUSEBUTTON(0)
    curMaxF = MAXF
    IF held THEN
        curMaxF = 23.0
    END IF

    ' --- Kamera drehen: RECHTE Maustaste ziehen (raylib: Button 1) ---
    '  Press-Frame ueberspringen + Delta kappen -> kein Springen.
    DIM rmb AS BOOLEAN
    rmb = MOUSEBUTTON(1)
    IF rmb AND rmbPrev THEN
        DIM ddx AS FLOAT
        DIM ddy AS FLOAT
        ddx = CLAMP(mx - pmx, -55.0, 55.0)
        ddy = CLAMP(my - pmy, -55.0, 55.0)
        yaw = yaw + ddx * 0.3
        pitch = CLAMP(pitch - ddy * 0.3, 6.0, 89.5)
    END IF
    rmbPrev = rmb
    pmx = mx
    pmy = my

    ' --- Scroll = Zoom ---
    DIM wheel AS INTEGER
    wheel = MOUSEWHEEL()
    IF wheel <> 0 THEN
        camRadius = CLAMP(camRadius - wheel * 4.0, 22.0, 95.0)
    END IF

    ' --- Kamera setzen (Ziel = Feldmitte) ---
    CAMERA_ORBIT(0.0, 0.0, 0.0, camRadius, yaw, pitch)

    ' --- Cursor auf die Boden-Ebene (Y=0) projizieren ---
    haveTarget = FALSE
    IF held THEN
        IF MOUSE_GROUND_HIT(0.0) THEN
            tgx = MOUSE_GROUND_X(0.0)
            tgz = MOUSE_GROUND_Z(0.0)
            haveTarget = TRUE
        END IF
    END IF

    ' --- Heimatpunkte driften lassen ---
    FOR s = 0 TO SWARMS - 1
        homeX[s] = homeX[s] + homeVX[s] * dt_s
        homeZ[s] = homeZ[s] + homeVZ[s] * dt_s
        IF homeX[s] < -(HF - 3.0) OR homeX[s] > (HF - 3.0) THEN
            homeVX[s] = -homeVX[s]
            homeX[s] = CLAMP(homeX[s], -(HF - 3.0), HF - 3.0)
        END IF
        IF homeZ[s] < -(HF - 3.0) OR homeZ[s] > (HF - 3.0) THEN
            homeVZ[s] = -homeVZ[s]
            homeZ[s] = CLAMP(homeZ[s], -(HF - 3.0), HF - 3.0)
        END IF
        IF mode3D THEN
            homeY[s] = homeY[s] + homeVY[s] * dt_s
            IF homeY[s] < -(HV - 2.0) OR homeY[s] > (HV - 2.0) THEN
                homeVY[s] = -homeVY[s]
                homeY[s] = CLAMP(homeY[s], -(HV - 2.0), HV - 2.0)
            END IF
        END IF
    NEXT

    ' ==================================================================
    '  Boids aktualisieren (immer in 3D gerechnet; in 2D ist Y gesperrt)
    ' ==================================================================
    FOR i = 0 TO NUM - 1
        IF NOT mode3D THEN
            by[i] = 0.0 : bvy[i] = 0.0
        END IF

        cnt = 0
        sumvx = 0.0 : sumvy = 0.0 : sumvz = 0.0
        sumpx = 0.0 : sumpy = 0.0 : sumpz = 0.0
        sepx = 0.0  : sepy = 0.0  : sepz = 0.0

        FOR j = 0 TO NUM - 1
            IF j <> i THEN
                dx = bx[j] - bx[i]
                dy = by[j] - by[i]
                dz = bz[j] - bz[i]
                d2 = dx * dx + dy * dy + dz * dz
                IF d2 < PSQ AND d2 > 0.000001 THEN
                    IF bs[j] = bs[i] THEN
                        cnt = cnt + 1
                        sumvx = sumvx + bvx[j]
                        sumvy = sumvy + bvy[j]
                        sumvz = sumvz + bvz[j]
                        sumpx = sumpx + bx[j]
                        sumpy = sumpy + by[j]
                        sumpz = sumpz + bz[j]
                    END IF
                    IF d2 < SSQ THEN
                        d = SQR(d2)
                        sepx = sepx - dx / d
                        sepy = sepy - dy / d
                        sepz = sepz - dz / d
                    END IF
                END IF
            END IF
        NEXT

        ax = 0.0 : ay = 0.0 : az = 0.0

        IF cnt > 0 THEN
            sumvx = sumvx / cnt : sumvy = sumvy / cnt : sumvz = sumvz / cnt
            ax = ax + (sumvx - bvx[i]) * W_ALI
            ay = ay + (sumvy - bvy[i]) * W_ALI
            az = az + (sumvz - bvz[i]) * W_ALI

            cdx = sumpx / cnt - bx[i]
            cdy = sumpy / cnt - by[i]
            cdz = sumpz / cnt - bz[i]
            cl = SQR(cdx * cdx + cdy * cdy + cdz * cdz)
            IF cl > 0.0001 THEN
                cdx = cdx / cl * MAXS : cdy = cdy / cl * MAXS : cdz = cdz / cl * MAXS
                ax = ax + (cdx - bvx[i]) * W_COH
                ay = ay + (cdy - bvy[i]) * W_COH
                az = az + (cdz - bvz[i]) * W_COH
            END IF
        END IF

        cl = SQR(sepx * sepx + sepy * sepy + sepz * sepz)
        IF cl > 0.0001 THEN
            sepx = sepx / cl * MAXS : sepy = sepy / cl * MAXS : sepz = sepz / cl * MAXS
            ax = ax + (sepx - bvx[i]) * W_SEP
            ay = ay + (sepy - bvy[i]) * W_SEP
            az = az + (sepz - bvz[i]) * W_SEP
        END IF

        ' ZIEL: Cursor auf dem Boden (gehalten) ODER Heimat
        IF held AND haveTarget THEN
            cdx = tgx - bx[i]
            cdy = 0.0 - by[i]
            cdz = tgz - bz[i]
            cl = SQR(cdx * cdx + cdy * cdy + cdz * cdz)
            IF cl > 0.0001 THEN
                cdx = cdx / cl * MAXS : cdy = cdy / cl * MAXS : cdz = cdz / cl * MAXS
                ax = ax + (cdx - bvx[i]) * W_MOUSE
                ay = ay + (cdy - bvy[i]) * W_MOUSE
                az = az + (cdz - bvz[i]) * W_MOUSE
            END IF
        ELSE
            cdx = homeX[bs[i]] - bx[i]
            cdy = homeY[bs[i]] - by[i]
            cdz = homeZ[bs[i]] - bz[i]
            cl = SQR(cdx * cdx + cdy * cdy + cdz * cdz)
            IF cl > 0.0001 THEN
                cdx = cdx / cl * MAXS : cdy = cdy / cl * MAXS : cdz = cdz / cl * MAXS
                ax = ax + (cdx - bvx[i]) * W_HOME
                ay = ay + (cdy - bvy[i]) * W_HOME_Y
                az = az + (cdz - bvz[i]) * W_HOME
            END IF
        END IF

        ' Lenkkraft begrenzen
        am2 = ax * ax + ay * ay + az * az
        IF am2 > curMaxF * curMaxF THEN
            sc = curMaxF / SQR(am2)
            ax = ax * sc : ay = ay * sc : az = az * sc
        END IF

        bvx[i] = bvx[i] + ax * dt_s
        bvz[i] = bvz[i] + az * dt_s
        IF mode3D THEN
            bvy[i] = bvy[i] + ay * dt_s
        END IF

        ' Tempo begrenzen
        sp2 = bvx[i] * bvx[i] + bvy[i] * bvy[i] + bvz[i] * bvz[i]
        IF sp2 > MAXS * MAXS THEN
            sc = MAXS / SQR(sp2)
            bvx[i] = bvx[i] * sc : bvy[i] = bvy[i] * sc : bvz[i] = bvz[i] * sc
        ELSEIF sp2 < MINS * MINS AND sp2 > 0.0001 THEN
            sc = MINS / SQR(sp2)
            bvx[i] = bvx[i] * sc : bvy[i] = bvy[i] * sc : bvz[i] = bvz[i] * sc
        END IF

        bx[i] = bx[i] + bvx[i] * dt_s
        bz[i] = bz[i] + bvz[i] * dt_s
        IF mode3D THEN
            by[i] = by[i] + bvy[i] * dt_s
            IF by[i] < -HV THEN
                by[i] = -HV : bvy[i] = -bvy[i]
            ELSEIF by[i] > HV THEN
                by[i] = HV : bvy[i] = -bvy[i]
            END IF
        END IF
    NEXT

    ' --- Harte Kollision ---
    ResolveCollisions(bx, by, bz, bvx, bvy, bvz, NUM, BODY_R, COLL_PASSES)

    ' --- Wrap-around im X-Z-Feld ---
    FOR i = 0 TO NUM - 1
        IF bx[i] < -HF THEN
            bx[i] = HF
        ELSEIF bx[i] > HF THEN
            bx[i] = -HF
        END IF
        IF bz[i] < -HF THEN
            bz[i] = HF
        ELSEIF bz[i] > HF THEN
            bz[i] = -HF
        END IF
    NEXT

    ' ==================================================================
    '  Zeichnen (native 3D-Pipeline)
    ' ==================================================================
    CLS(RGB(10, 14, 28))

    GRID3D(40, 1.0)                  ' Boden-Raster zur Orientierung

    ' Ziel-Marker auf dem Boden
    IF held AND haveTarget THEN
        POINT3D(tgx, 0.0, tgz, RGB(255, 255, 255))
        LINE3D(tgx, 0.0, tgz, tgx, 2.0, tgz, RGB(255, 255, 255))
    END IF

    ' Tiere
    DIM tr AS FLOAT
    DIM tcol AS INTEGER
    DIM inv AS FLOAT
    DIM tlx AS FLOAT
    DIM tly AS FLOAT
    DIM tlz AS FLOAT
    FOR i = 0 TO NUM - 1
        sp = SQR(bvx[i] * bvx[i] + bvy[i] * bvy[i] + bvz[i] * bvz[i])
        tr = CLAMP01((sp - MINS) / (MAXS - MINS))
        tcol = COLOR_LERP(colDim[bs[i]], colHi[bs[i]], tr)

        ' Bewegungs-Schweif entgegen der Flugrichtung
        IF sp > 0.0001 THEN
            inv = 1.0 / sp
            tlx = bx[i] - bvx[i] * inv * 1.1
            tly = by[i] - bvy[i] * inv * 1.1
            tlz = bz[i] - bvz[i] * inv * 1.1
            LINE3D(bx[i], by[i], bz[i], tlx, tly, tlz, colDim[bs[i]])
        END IF

        SPHERE(bx[i], by[i], bz[i], BSIZE, tcol)
    NEXT

    ' --- 2D-HUD ueber der Szene ---
    DIM modeLbl AS STRING
    IF mode3D THEN
        modeLbl = "Ansicht: 3D (Y frei - Schwaerme duerfen sich ueberlappen)"
    ELSE
        modeLbl = "Ansicht: 2D (Boden-Ebene - keine Ueberlappung)"
    END IF
    TEXT(18, 16, modeLbl, RGB(210, 225, 255))
    TEXT(18, 36, "Linke Maus = folgen   RECHTE Maus = drehen   Scrollen = Zoom   TAB = 2D/3D   F = Vollbild   ESC", RGB(140, 165, 205))

    FLIP()
    SLEEP(16)
WEND
