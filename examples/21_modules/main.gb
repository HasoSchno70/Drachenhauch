' Hauptprogramm das mehrere Module via IMPORT einzieht.
IMPORT "mathlib.gb"
IMPORT "strlib.gb"

PRINT "DEG2RAD =", DEG2RAD
PRINT "Distance (0,0)->(3,4) =", Distance(0.0, 0.0, 3.0, 4.0)
PRINT "Lerp(0, 100, 0.25)    =", Lerp(0.0, 100.0, 0.25)
PRINT "DegToRad(180)         =", DegToRad(180.0)

PRINT ""
PRINT "Reverse$('GameBasic')   =", Reverse$("GameBasic")
PRINT "StartsWith('hello', 'he') =", StartsWith("hello", "he")
PRINT "StartsWith('hello', 'ho') =", StartsWith("hello", "ho")

' Imports koennen sich auch gegenseitig ziehen - hier doppelte sind harmlos
IMPORT "mathlib.gb"     ' nochmal: wird ignoriert
PRINT ""
PRINT "Doppel-Import war kein Problem."
