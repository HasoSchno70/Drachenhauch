=== rechnungsfenster meldet sich bei fremden eltern
' Pruefstein 3 aus entwurf-native-fenster.md: das Kind (196_rechnung_fenster.dh)
' laeuft als eigener Prozess auf derselben Datenbank. Die Eltern spielt das
' Nachher-Programm ueber das net-Modul -- ein Teilnehmer, der WINDOW_OPEN nicht
' kennt: es lauscht, reicht den Port in der Umgebung weiter, liest "offen 2"
' und beendet das Kind, indem es die Verbindung schliesst. Allein gestartet
' laeuft das Kind ebenfalls. Der Hauptlauf legt nur die Datenbank an und merkt
' sich, wo das Kind liegt.
SET_WINDOW_POS(-3000, -3000)
DIM prBild AS INTEGER : prBild = 0
DIM prStart AS INTEGER : prStart = -1
DIM prF AS ARRAY OF INTEGER : prF = []
DIM prZ AS ARRAY OF STRING : prZ = []
DIM prFlag AS STRING : prFlag = ""
DIM prA AS INTEGER : prA = 0
DIM prB AS INTEGER : prB = 0
DIM prC AS INTEGER : prC = 0
DIM prD AS INTEGER : prD = 0
SUB prE(f AS INTEGER, typ AS INTEGER, a AS INTEGER, b AS INTEGER)
    ARRAY_PUSH(prF, f)
    ARRAY_PUSH(prZ, STR$(typ) + " " + STR$(a) + " " + STR$(b) + " 0 0")
END SUB
SUB prKlick(f AS INTEGER, x AS INTEGER, y AS INTEGER)
    prE(f, 7, x, y)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 5, 0, 0)
END SUB
SUB prTaste(f AS INTEGER, code AS INTEGER, modifier AS INTEGER)
    IF modifier > 0 THEN prE(f, 2, modifier, 0)
    prE(f + 1, 2, code, 0)
    prE(f + 2, 1, code, 0)
    IF modifier > 0 THEN prE(f + 3, 1, modifier, 0)
END SUB
FUNCTION prMx(w AS GUI_WIDGET) AS INTEGER
    RETURN GUI_CANVAS_X(nullpunkt) + GUI_GET_X(w) + GUI_GET_W(w) \ 2
END FUNCTION
FUNCTION prMy(w AS GUI_WIDGET) AS INTEGER
    RETURN GUI_CANVAS_Y(nullpunkt) + GUI_GET_Y(w) + GUI_GET_H(w) \ 2
END FUNCTION
SUB prAbspielen()
    ' Ein Ereignis in Bild 0 -- die Wiedergabe setzt beim ERSTEN an.
    prE(0, 7, 0, 0)
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM weiter AS BOOLEAN
    DIM tf AS INTEGER
    DIM tz AS STRING
    FOR i = 1 TO LEN(prF) - 1
        j = i
        weiter = TRUE
        WHILE weiter
            weiter = FALSE
            IF j > 0 THEN
                IF prF[j - 1] > prF[j] THEN
                    tf = prF[j] : prF[j] = prF[j - 1] : prF[j - 1] = tf
                    tz = prZ[j] : prZ[j] = prZ[j - 1] : prZ[j - 1] = tz
                    j = j - 1
                    weiter = TRUE
                END IF
            END IF
        WEND
    NEXT
    DIM t AS STRING : t = "# Test-Aufnahme" + CHR$(10) + "c " + STR$(LEN(prF)) + CHR$(10)
    FOR i = 0 TO LEN(prF) - 1
        t = t + "e " + STR$(prF[i]) + " " + prZ[i] + CHR$(10)
    NEXT
    WRITEALL("ev.txt", t)
    AUTOMATION_PLAY("ev.txt")
    prStart = prBild
END SUB
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
--- programm ../../examples/196_rechnungen.dh nach SETFPS(60)
--- einschub nach GUI_WINDOW_CHROME(win, FALSE)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(win, 0, 0, 1, 1)

--- einschub nach FLIP()
prBild = prBild + 1
IF prBild = 1 THEN WRITEALL("kind.txt", ARG$(0))
prSchreib("")

--- umgebung
DHRT_FRAMES=2
--- argumente
{sammlung}/../../examples/196_rechnung_fenster.dh
--- nachher
IMPORT "net"
DIM kind AS STRING : kind = TRIM$(READLINES("_programm/kind.txt")[0])
DIM dbPfad AS STRING : dbPfad = CWD$() + "/_programm/rechnungen.db"
' Allein (ohne Eltern): laeuft, bis es beendet wird.
DIM allein AS INTEGER : allein = PROCESS_START("dhrt", "run", kind, "--", dbPfad, "1")
SLEEP(2500)
PRINT "allein laeuft " ; PROCESS_RUNNING(allein)
PROCESS_KILL(allein)
' Mit fremden Eltern.
DIM lst AS NET_LISTENER : lst = NET_TCP_LISTEN(48123, "127.0.0.1")
SETENV("DHRT_ELTERN_PORT", "48123")
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "run", kind, "--", dbPfad, "2")
DIM sock AS NET_SOCKET
DIM bis AS INTEGER : bis = MILLIS() + 20000
WHILE IS_NIL(sock) AND MILLIS() < bis
    sock = NET_TCP_ACCEPT(lst)
    IF IS_NIL(sock) THEN SLEEP(20)
WEND
PRINT "verbunden " ; NOT IS_NIL(sock)
DIM zeile AS STRING : zeile = ""
bis = MILLIS() + 10000
WHILE INSTR(zeile, CHR$(10)) < 0 AND MILLIS() < bis
    zeile = zeile + NET_RECV(sock, 1024)
    SLEEP(20)
WEND
PRINT "meldung " ; TRIM$(zeile)
PRINT "laeuft mit eltern " ; PROCESS_RUNNING(pc)
NET_CLOSE(sock)
NET_CLOSE(lst)
bis = MILLIS() + 10000
WHILE PROCESS_RUNNING(pc) AND MILLIS() < bis
    SLEEP(50)
WEND
PRINT "beendet sich ohne verbindung " ; NOT PROCESS_RUNNING(pc)
IF PROCESS_RUNNING(pc) THEN PROCESS_KILL(pc)
--- erwartet
allein laeuft TRUE
verbunden TRUE
meldung offen 2
laeuft mit eltern TRUE
beendet sich ohne verbindung TRUE

