=== grenzen: teilstiche bei 180, leer, ausgeblendet, schritte
IMPORT "helfer.dh"
' Ein kleines Muster 4 x 3 mit einem Viertelstich oben links, einem halben
' Stich, einem Rueckstich und einer erledigten Zelle
DIM m AS kern.Muster : m = kern.neuesMuster("Klein", 4, 3)
DIM vs AS kern.Verlauf : vs = kern.neuerVerlauf()          ' nur fuer den Aufbau
DIM g AS kern.Garn : g = kern.neuesGarn("Rot", &HC00000, "DMC", "321")
DIM nr AS INTEGER : nr = kern.farbeHinzufuegen(m, vs, g, ["●"], FALSE, FALSE)
DIM e AS kern.Ebene : e = m.ebenen.ebenen[0]
e.raster[0] = nr : e.art[0] = kern.VIERTEL_OL
e.raster[5] = nr : e.art[5] = kern.HALB_OL_UR : e.erledigt[5] = 1
ARRAY_PUSH(m.rueckstiche, kern.neuerRueckstich(0, 0, 2, 2, nr))
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM ok AS BOOLEAN
FUNCTION zellen$(m AS kern.Muster) AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM e AS kern.Ebene : e = m.ebenen.ebenen[0]
    DIM i AS INTEGER
    FOR i = 0 TO LEN(e.raster) - 1
        IF e.raster[i] >= 0 THEN ARRAY_PUSH(t, STR$(i MOD m.breite) + "," + STR$(i \ m.breite) + " typ " + STR$(e.art[i]) + IIF(e.erledigt[i] <> 0, " erledigt", ""))
    NEXT
    DIM r AS kern.Rueckstich
    FOR EACH r IN m.rueckstiche
        ARRAY_PUSH(t, "rueck " + STR$(r.x1) + "," + STR$(r.y1) + "-" + STR$(r.x2) + "," + STR$(r.y2))
    NEXT
    RETURN STR$(m.breite) + "x" + STR$(m.hoehe) + ": " + JOIN$(t, " | ")
END FUNCTION
DIM vorher AS STRING : vorher = zellen$(m)
PRINT "vorher "; vorher
' 180 Grad: der Viertelstich oben links (3) wird unten rechts (6) -- PySticky
' liesse ihn 3, obwohl sein Kaestchen jetzt unten rechts liegt
ok = kern.musterUmlegen(m, v, kern.UMLEGEN_180)
PRINT "180     "; zellen$(m); " | '"; v.textZurueck$(); "'"
ok = v.zurueckNehmen(m)
PRINT "zurueck gleich "; zellen$(m) = vorher
ok = kern.musterUmlegen(m, v, kern.UMLEGEN_RECHTS)
PRINT "rechts  "; zellen$(m)
ok = v.zurueckNehmen(m)
ok = kern.musterUmlegen(m, v, kern.UMLEGEN_WAAGERECHT)
PRINT "waager. "; zellen$(m)
ok = v.zurueckNehmen(m)
ok = v.wiederholen(m)
PRINT "vor     "; zellen$(m)
ok = v.zurueckNehmen(m)
PRINT "unbekannte art: "; kern.musterUmlegen(m, v, 7); " | schritte "; LEN(v.rueck)
' Zuschneiden: Bereich ausserhalb und unveraendert sind keine Schritte
PRINT "zuschneiden: aussen "; kern.musterZuschneiden(m, v, 2, 0, 3, 3, "x"); " negativ "; kern.musterZuschneiden(m, v, -1, 0, 2, 2, "x"); " alles "; kern.musterZuschneiden(m, v, 0, 0, 4, 3, "x"); " leer "; kern.musterZuschneiden(m, v, 0, 0, 0, 2, "x"); " | schritte "; LEN(v.rueck)
' Auto-Zuschneiden: ein leeres Muster bleibt (PySticky schnitt es auf 1 x 1),
' ein Stich auf einer ausgeblendeten Ebene zaehlt mit (PySticky nur sichtbare)
DIM leer AS kern.Muster : leer = kern.neuesMuster("Leer", 6, 5)
PRINT "auto leer: "; LEN(kern.autoZuschneiden(leer, v)); " "; leer.breite; "x"; leer.hoehe
DIM h AS kern.Muster : h = kern.neuesMuster("Versteckt", 8, 6)
nr = kern.farbeHinzufuegen(h, vs, g, ["●"], FALSE, FALSE)
h.ebenen.ebenen[0].raster[2 * 8 + 3] = nr
DIM i2 AS INTEGER : i2 = kern.ebeneNeu(h, vs, "Versteckt")
h.ebenen.ebenen[1].raster[5 * 8 + 7] = nr
h.ebenen.ebenen[1].sichtbar = FALSE
DIM ra AS ARRAY OF INTEGER : ra = kern.autoZuschneiden(h, v)
PRINT "auto mit ausgeblendeter: ("; JOIN$(ra, ", "); ") "; h.breite; "x"; h.hoehe; " | stich unten rechts erhalten "; h.ebenen.ebenen[1].raster[h.breite * h.hoehe - 1] = nr
' Vereinen: eine Ebene ist nichts, ausgeblendete werden gezaehlt
PRINT "vereinen eine ebene: "; kern.ebenenVereinen(m, v); " | ausgeblendete stiche "; kern.ausgeblendeteStiche(h)
ok = kern.ebenenVereinen(h, v)
PRINT "vereint: "; h.ebenen.anzahl(); " "; h.ebenen.ebenen[0].name; " sichtbar "; h.ebenen.ebenen[0].sichtbar; " | aktiv "; h.ebenen.aktiv; " | '"; v.textZurueck$(); "'"
ok = v.zurueckNehmen(h)
PRINT "zurueck: "; h.ebenen.anzahl(); " ebenen, die obere ausgeblendet "; NOT h.ebenen.ebenen[1].sichtbar
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
CONST GLUTORDNER = "{sammlung}/../../examples/glutfaden"
--- erwartet
vorher 4x3: 0,0 typ 3 | 1,1 typ 1 erledigt | rueck 0,0-2,2
180     4x3: 2,1 typ 1 erledigt | 3,2 typ 6 | rueck 8,6-6,4 | '180° gedreht'
zurueck gleich TRUE
rechts  3x4: 2,0 typ 4 | 1,1 typ 2 erledigt | rueck 6,0-4,2
waager. 4x3: 3,0 typ 4 | 2,1 typ 2 erledigt | rueck 8,0-6,2
vor     4x3: 3,0 typ 4 | 2,1 typ 2 erledigt | rueck 8,0-6,2
unbekannte art: FALSE | schritte 0
zuschneiden: aussen FALSE negativ FALSE alles FALSE leer FALSE | schritte 0
auto leer: 0 6x5
auto mit ausgeblendeter: (3, 2, 0, 0) 5x4 | stich unten rechts erhalten TRUE
vereinen eine ebene: FALSE | ausgeblendete stiche 1
vereint: 1 Zusammengeführt sichtbar TRUE | aktiv 0 | 'Alle Ebenen vereinen'
zurueck: 2 ebenen, die obere ausgeblendet TRUE

=== probe: drehen, zuschneiden, vereinen, ebenen-ansicht
IMPORT "helfer.dh"
' --probe-stufe18 mit alle.pxs: Drehen und Spiegeln ueber Befehl und
' Muster-Knopf samt Rueckgaengig, Auto-Zuschneiden, Vereinen, "Nur aktive"
' und "Andere abdunkeln".
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe18", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["gedreht", "vereint", "nur_aktive", "abgedunkelt"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    PRINT "datei unveraendert: "; READLINES("alle.pxs")[0] = READLINES("vorher.pxs")[0]
END IF
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
CONST GLUTORDNER = "{sammlung}/../../examples/glutfaden"
