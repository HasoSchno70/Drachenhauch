' 87_ttf_fonts.gb -- TTF/OTF-Schriften (LOADFONT / SETFONT / TEXT_SPACING)
'
' Nur die native Runtime (F6 / dhrun.py --native) rendert echte TTF-Glyphen
' ueber raylibs LoadFontEx + DrawTextEx. Der Tree-Walker (F5) ist konsolen-only
' und kann keine Grafik/Schriften zeichnen.
'
' Es gibt KEIN gebuendeltes Font-Asset im Repo. Die Demo sucht einen
' System-Font und faellt sonst sauber auf den Default-Font zurueck.

SCREEN(640, 360, "TTF-Fonts")

' --- Font finden (erster existierender Pfad gewinnt) ---
DIM font AS INTEGER
font = -1

DIM paths AS TUPLE
paths = ("C:/Windows/Fonts/arial.ttf", "C:/Windows/Fonts/segoeui.ttf", "/Library/Fonts/Arial.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")

DIM p AS STRING
FOR EACH p IN paths
    IF font < 0 AND FILEEXISTS(p) THEN
        font = LOADFONT(p, 64)
    END IF
NEXT

DIM frame AS INTEGER
FOR frame = 0 TO 240
    CLS(RGB(18, 18, 28))

    ' Vergleich: immer der Default-Font oben.
    SETFONT(-1)
    TEXT_SIZE(20)
    TEXT(20, 16, "Default-Font (raylib):", RGB(160, 160, 180))
    TEXT(20, 40, "ABCabc 0123 - Hallo Welt!", WHITE)

    IF font >= 0 THEN
        SETFONT(font)

        ' Groessen-Skalierung aus EINEM geladenen Font.
        TEXT_SPACING(0)
        TEXT_SIZE(48)
        TEXT(20, 90, "TTF 48px", RGB(0, 230, 200))
        TEXT_SIZE(28)
        TEXT(20, 150, "TTF 28px -- frei skalierbar", RGB(120, 220, 255))

        ' Buchstabenabstand (wirkt nativ via DrawTextEx).
        TEXT_SIZE(32)
        TEXT_SPACING(10)
        TEXT(20, 200, "S P A C I N G", RGB(255, 200, 60))
        TEXT_SPACING(0)

        ' TEXT_WIDTH nutzt die aktive Schrift -> zentrieren.
        TEXT_SIZE(36)
        DIM msg AS STRING
        msg = "zentriert"
        DIM w AS INTEGER
        w = TEXT_WIDTH(msg)
        TEXT(320 - w \ 2, 270, msg, RGB(255, 120, 200))
    ELSE
        SETFONT(-1)
        TEXT_SIZE(24)
        TEXT(20, 120, "Kein System-Font gefunden --", RGB(255, 120, 120))
        TEXT(20, 150, "LOADFONT(pfad, groesse) mit eigener TTF nutzen.", RGB(255, 120, 120))
    END IF

    FLIP()
NEXT
