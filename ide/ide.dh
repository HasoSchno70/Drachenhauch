' Alle Widgets auf jedem Reiter sichtbar -- die Reiter schalten nur die Code-Felder.
DIM tabTitel[MAX_TABS] AS STRING

DIM breiteLinks AS INTEGER : breiteLinks = 220
DIM hoeheUnten AS INTEGER : hoeheUnten = 200

SUB willkommenZeigen(an AS BOOLEAN)
    GUI_SET_VISIBLE(lblWkTitel, an) : GUI_SET_VISIBLE(lblWkUnter, an)
    GUI_SET_VISIBLE(btnWkNeu, an) : GUI_SET_VISIBLE(btnWkOeffnen, an) : GUI_SET_VISIBLE(btnWkBeispiele, an)
    GUI_SET_VISIBLE(lblWkZuletzt, an) : GUI_SET_VISIBLE(lstWkZuletzt, an) : GUI_SET_VISIBLE(lblWkKuerzel, an)
END SUB

' --- Einstellungen, Sitzung, zuletzt geoeffnet -----------------------
SUB konfigSichern()
    JSON_SET_BOOL(konfig, "hell", hell)
    JSON_SET_INT(konfig, "schrift", codeGroesse)
    JSON_SET_BOOL(konfig, "umbruch", umbruchAn)
    JSON_SET_BOOL(konfig, "karte", minimapAn)
    JSON_SET_JSON(konfig, "zuletzt", JSON_PARSE("[]"))
    DIM p AS STRING
    FOR EACH p IN zuletzt
        JSON_APPEND_STRING(konfig, "zuletzt", p)
    NEXT
    JSON_SET_JSON(konfig, "sitzung", JSON_PARSE("[]"))
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF tabPfade[i] <> "" THEN JSON_APPEND_STRING(konfig, "sitzung", tabPfade[i])
    NEXT
    JSON_SET_INT(konfig, "aktiv", aktiverTab)
    ' Dieselbe Sitzung noch einmal unter dem PROJEKTordner: wer an zwei
    ' Sachen arbeitet, will beim Wechsel nicht die Reiter der anderen
    ' wiederfinden. Der laufende Ordner kommt nach vorn, alte fallen hinten
    ' heraus -- eine Datei, die jeden je besuchten Ordner behaelt, waechst
    ' fuer immer.
    DIM offen AS ARRAY OF STRING : offen = []
    DIM pi AS INTEGER
    FOR pi = 0 TO tabAnzahl - 1
        IF tabPfade[pi] <> "" THEN ARRAY_PUSH(offen, tabPfade[pi])
    NEXT
    DIM alt AS INTEGER : alt = ARRAY_INDEXOF(projOrdner, projektOrdner)
    IF alt >= 0 THEN
        ARRAY_REMOVE_AT(projOrdner, alt) : ARRAY_REMOVE_AT(projDateien, alt) : ARRAY_REMOVE_AT(projAktiv, alt)
    END IF
    ARRAY_INSERT(projOrdner, 0, projektOrdner)
    ARRAY_INSERT(projDateien, 0, JOIN$(offen, "|"))
    ARRAY_INSERT(projAktiv, 0, aktiverTab)
    WHILE LEN(projOrdner) > PROJEKTE_MAX
        DIM letzt AS INTEGER : letzt = LEN(projOrdner) - 1
        ARRAY_REMOVE_AT(projOrdner, letzt) : ARRAY_REMOVE_AT(projDateien, letzt) : ARRAY_REMOVE_AT(projAktiv, letzt)
    WEND
    JSON_SET_JSON(konfig, "projekte", JSON_NEW_ARRAY())
    DIM pk AS INTEGER
    FOR pk = 0 TO LEN(projOrdner) - 1
        DIM e AS JSON_HANDLE : e = JSON_NEW_OBJECT()
        JSON_SET_STRING(e, "ordner", projOrdner[pk])
        JSON_SET_INT(e, "aktiv", projAktiv[pk])
        JSON_SET_JSON(e, "sitzung", JSON_NEW_ARRAY())
        DIM sp AS STRING
        IF projDateien[pk] <> "" THEN
            FOR EACH sp IN SPLIT$(projDateien[pk], "|")
                JSON_APPEND_STRING(e, "sitzung", sp)
            NEXT
        END IF
        JSON_APPEND_JSON(konfig, "projekte", e)
    NEXT
    TRY
        MKDIR(DIRNAME(konfigPfad))
        WRITEALL(konfigPfad, JSON_STRINGIFY(konfig))
    CATCH e
        ' ein schreibgeschuetztes Profil ist kein Grund, die Arbeit zu stoeren
    END TRY
END SUB

SUB zuletztAnzeigen()
    DIM k AS INTEGER
    FOR k = 0 TO ZULETZT_MAX - 1
        IF k < LEN(zuletzt) THEN
            GUI_MENU_TEXT(miZuletzt[k], BASENAME(zuletzt[k]) + "   (" + DIRNAME(zuletzt[k]) + ")")
            GUI_MENU_ENABLE(miZuletzt[k], TRUE)
        ELSE
            GUI_MENU_TEXT(miZuletzt[k], "-")
            GUI_MENU_ENABLE(miZuletzt[k], FALSE)
        END IF
    NEXT
    GUI_LISTBOX_CLEAR(lstWkZuletzt)
    FOR k = 0 TO LEN(zuletzt) - 1
        GUI_LISTBOX_ADD(lstWkZuletzt, BASENAME(zuletzt[k]) + "   (" + DIRNAME(zuletzt[k]) + ")")
    NEXT
END SUB

SUB zuletztMerken(pfad AS STRING)
    IF pfad = "" THEN RETURN
    DIM k AS INTEGER : k = ARRAY_INDEXOF(zuletzt, pfad)
    IF k >= 0 THEN ARRAY_REMOVE_AT(zuletzt, k)
    ARRAY_INSERT(zuletzt, 0, pfad)
    WHILE LEN(zuletzt) > ZULETZT_MAX : ARRAY_REMOVE_AT(zuletzt, LEN(zuletzt) - 1) : WEND
    zuletztAnzeigen()
    konfigSichern()
END SUB

SUB schriftSetzen(groesse AS INTEGER)
    codeGroesse = MAX(10, MIN(32, groesse))
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_SET_FONT_SIZE(tabFelder[i], codeGroesse)
    NEXT
    GUI_SET_TEXT(lblStatus, "Schrift: " + STR$(codeGroesse) + " px")
    konfigSichern()
END SUB

SUB debugPanelZeigen(an AS BOOLEAN)
    debugSichtbar = an
    GUI_SET_VISIBLE(lblProbleme, NOT an) : GUI_SET_VISIBLE(lstProbleme, NOT an) : GUI_SET_VISIBLE(lblHilfe, NOT an)
    GUI_SET_VISIBLE(lblDebug, an) : GUI_SET_VISIBLE(tblVars, an)
    GUI_SET_VISIBLE(btnWeiter, an) : GUI_SET_VISIBLE(btnDrueber, an) : GUI_SET_VISIBLE(btnHinein, an)
    GUI_SET_VISIBLE(btnHeraus, an) : GUI_SET_VISIBLE(btnStoppD, an)
END SUB

SUB layout()
    DIM w AS INTEGER : w = SCREENWIDTH()
    DIM h AS INTEGER : h = SCREENHEIGHT()
    GUI_WINDOW_SET_BOUNDS(win, 0, 0, w, h)
    ' Widget-Koordinaten zaehlen ab dem INHALT: Menueleiste und Reiterleiste
    ' liegen darueber (zusammen 56 px) und gehen von der Hoehe ab -- sonst
    ' rutschen Eingabezeile und Status unter den Fensterrand (Stand 1 tat das).
    DIM kopf AS INTEGER : kopf = 56
    DIM hi AS INTEGER : hi = h - kopf
    DIM oben AS INTEGER : oben = 4
    DIM statusH AS INTEGER : statusH = 24
    DIM eingabeH AS INTEGER : eingabeH = 30
    DIM mitteH AS INTEGER : mitteH = hi - oben - hoeheUnten - statusH - eingabeH - 12
    ' links: Projektbaum oben, Gliederung darunter
    DIM baumH AS INTEGER : baumH = (mitteH - 22) * 3 \ 5
    GUI_SET_BOUNDS(lblProjekt, 8, oben, breiteLinks - 16, 18)
    GUI_SET_BOUNDS(baum, 8, oben + 22, breiteLinks - 16, baumH)
    GUI_SET_BOUNDS(lblGliederung, 8, oben + 30 + baumH, breiteLinks - 16, 18)
    GUI_SET_BOUNDS(lstGliederung, 8, oben + 52 + baumH, breiteLinks - 16, mitteH - baumH - 52)
    DIM ex AS INTEGER : ex = breiteLinks
    DIM ew AS INTEGER : ew = w - breiteLinks - 8
    ' Die Uebersichtskarte nimmt sich einen Streifen am rechten Rand.
    DIM kartenB AS INTEGER : kartenB = 0
    IF minimapAn THEN kartenB = 92
    GUI_SET_VISIBLE(karte, minimapAn)
    IF minimapAn THEN GUI_SET_BOUNDS(karte, ex + ew - kartenB, oben, kartenB - 6, mitteH)
    ew = ew - kartenB
    ' Geteilt: der linke Reiter bekommt die linke Haelfte, alle anderen die
    ' rechte -- so hat jede Haelfte ein ECHTES Feld, keine Spiegelung.
    DIM halbeB AS INTEGER : halbeB = (ew - 6) \ 2
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF geteilt AND linkerTab >= 0 AND linkerTab < tabAnzahl AND i = linkerTab THEN
            GUI_SET_BOUNDS(tabFelder[i], ex, oben, halbeB, mitteH)
        ELSEIF geteilt AND linkerTab >= 0 AND linkerTab < tabAnzahl THEN
            GUI_SET_BOUNDS(tabFelder[i], ex + halbeB + 6, oben, ew - halbeB - 6, mitteH)
        ELSE
            GUI_SET_BOUNDS(tabFelder[i], ex, oben, ew, mitteH)
        END IF
    NEXT
    ' Willkommensseite auf derselben Flaeche
    DIM wx AS INTEGER : wx = ex + 40
    GUI_SET_BOUNDS(lblWkTitel, wx, oben + 30, ew - 80, 44)
    GUI_SET_BOUNDS(lblWkUnter, wx, oben + 84, ew - 80, 18)
    GUI_SET_WRAP(lblWkUnter, ew - 80)
    GUI_SET_BOUNDS(btnWkNeu, wx, oben + 130, 130, 30)
    GUI_SET_BOUNDS(btnWkOeffnen, wx + 140, oben + 130, 150, 30)
    GUI_SET_BOUNDS(btnWkBeispiele, wx + 300, oben + 130, 180, 30)
    GUI_SET_BOUNDS(lblWkZuletzt, wx, oben + 180, ew - 80, 18)
    DIM zlH AS INTEGER : zlH = MAX(60, MIN(230, mitteH - 320))
    GUI_SET_BOUNDS(lstWkZuletzt, wx, oben + 202, MIN(ew - 80, 620), zlH)
    GUI_SET_BOUNDS(lblWkKuerzel, wx, oben + 214 + zlH, MIN(ew - 80, 620), 18)
    GUI_SET_WRAP(lblWkKuerzel, MIN(ew - 80, 620))
    willkommenZeigen(tabAnzahl = 0)
    DIM uy AS INTEGER : uy = oben + mitteH + 4
    DIM halb AS INTEGER : halb = (w - 24) \ 2
    GUI_SET_BOUNDS(lblAusgabe, 8, uy, 200, 18)
    GUI_SET_BOUNDS(lstAusgabe, 8, uy + 20, halb, hoeheUnten - 20)
    GUI_SET_BOUNDS(lblProbleme, 16 + halb, uy, halb, 18)
    GUI_SET_BOUNDS(lstProbleme, 16 + halb, uy + 20, halb, (hoeheUnten - 20) \ 2 - 4)
    GUI_SET_BOUNDS(lblHilfe, 16 + halb, uy + 20 + (hoeheUnten - 20) \ 2, halb, (hoeheUnten - 20) \ 2)
    GUI_SET_WRAP(lblHilfe, halb - 8)
    ' Debugger-Panel auf derselben Flaeche
    GUI_SET_BOUNDS(lblDebug, 16 + halb, uy, halb, 18)
    GUI_SET_BOUNDS(btnWeiter, 16 + halb, uy + 20, 100, 26)
    GUI_SET_BOUNDS(btnDrueber, 122 + halb, uy + 20, 108, 26)
    GUI_SET_BOUNDS(btnHinein, 236 + halb, uy + 20, 104, 26)
    GUI_SET_BOUNDS(btnHeraus, 346 + halb, uy + 20, 70, 26)
    GUI_SET_BOUNDS(btnStoppD, 422 + halb, uy + 20, 60, 26)
    GUI_SET_BOUNDS(tblVars, 16 + halb, uy + 52, halb, hoeheUnten - 52)
    debugPanelZeigen(debugSichtbar)
    DIM ey AS INTEGER : ey = hi - statusH - eingabeH - 4
    GUI_SET_BOUNDS(tfEingabe, 8, ey, w - 108, 26)
    GUI_SET_BOUNDS(btnEingabe, w - 92, ey, 84, 26)
    GUI_SET_BOUNDS(lblStatus, 8, hi - statusH, w - 16, 18)
END SUB

' --- Reiter ------------------------------------------------------------
SUB reiterNeuSetzen()
    DIM titel[MAX(tabAnzahl, 1)] AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        DIM t AS STRING
        IF tabPfade[i] = "" THEN t = "Unbenannt" ELSE t = BASENAME(tabPfade[i])
        IF GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN t = t + " *"
        titel[i] = t
    NEXT
    IF tabAnzahl = 0 THEN titel[0] = "Drachenhauch"
    GUI_TABS(win, titel)
    IF aktiverTab >= 0 THEN GUI_SET_ACTIVE_TAB(win, aktiverTab)
END SUB

SUB feldEinrichten(ta AS GUI_WIDGET)
    IF codeFont >= 0 THEN GUI_SET_FONT(ta, codeFont)
    GUI_SET_FONT_SIZE(ta, codeGroesse)
    GUI_TEXTAREA_SET(ta, "zeilennummern", 1)
    GUI_TEXTAREA_SET(ta, "aktive_zeile", 1)
    GUI_TEXTAREA_SET(ta, "tab_fuegt_ein", 1)
    GUI_TEXTAREA_SET(ta, "tabbreite", 4)
    GUI_TEXTAREA_SET(ta, "umbruch", IIF(umbruchAn, 1, 0))
END SUB

' Der Umbruch gilt fuer ALLE Reiter, nicht nur den vorderen -- ein Schalter,
' der je Datei etwas anderes tut, ist einer, den man vergisst.
SUB umbruchSetzen(an AS BOOLEAN)
    umbruchAn = an
    GUI_MENU_CHECK(miUmbruch, an)
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_TEXTAREA_SET(tabFelder[i], "umbruch", IIF(an, 1, 0))
    NEXT
    GUI_SET_TEXT(lblStatus, IIF(an, "Zeilenumbruch an.", "Zeilenumbruch aus."))
    konfigSichern()
END SUB

' --- Geteilte Ansicht -------------------------------------------------
' Links ein zweiter Reiter, rechts der aktive. Beide sind ECHTE Code-Felder;
' zwei Ansichten auf DIESELBE Datei waeren ein Abgleich, den man bei jedem
' Anschlag fuehren muesste -- und GUI_SET_TEXT leerte dabei jedes Mal den
' Verlauf und schoebe die Marke ans Ende.
SUB geteiltSetzen(an AS BOOLEAN)
    IF an AND tabAnzahl < 2 THEN
        GUI_SET_TEXT(lblStatus, "Geteilte Ansicht: dafuer braucht es zwei offene Dateien.")
        RETURN
    END IF
    IF NOT an AND linkerTab >= 0 AND linkerTab < tabAnzahl THEN
        ' Zurueck auf seinen eigenen Reiter -- sonst bliebe das Feld
        ' ueber allen Reitern stehen.
        GUI_SET_TAB(tabFelder[linkerTab], linkerTab)
    END IF
    geteilt = an
    IF an THEN
        linkerTab = IIF(aktiverTab = 0, 1, 0)
        ' -1 heisst "auf jedem Reiter sichtbar" -- nur so stehen zwei
        ' Felder gleichzeitig im Bild.
        GUI_SET_TAB(tabFelder[linkerTab], -1)
    ELSE
        linkerTab = -1
    END IF
    GUI_MENU_CHECK(miGeteilt, geteilt)
    layout()
    GUI_SET_TEXT(lblStatus, IIF(geteilt, "Geteilt: links " + BASENAME(tabPfade[linkerTab]), "Geteilte Ansicht aus."))
    ' Die Lagen mitschreiben: dass der Befehl LIEF, sagt nichts darueber, ob
    ' die beiden Felder auch nebeneinander liegen.
    IF geteilt THEN
        protokoll("geteilt " + STR$(linkerTab) + " x " + STR$(GUI_GET_X(tabFelder[linkerTab])) + "+" + STR$(GUI_GET_W(tabFelder[linkerTab])) + " " + STR$(GUI_GET_X(tabFelder[aktiverTab])) + "+" + STR$(GUI_GET_W(tabFelder[aktiverTab])))
    ELSE
        protokoll("geteilt aus")
    END IF
END SUB

' Der linke Reiter darf nicht derselbe sein wie der aktive -- ein Widget
' kann nicht zweimal im Bild stehen. Beim Wechsel tauschen die beiden.
SUB geteiltNachziehen(vorher AS INTEGER)
    IF NOT geteilt THEN RETURN
    IF linkerTab <> aktiverTab THEN RETURN
    IF vorher < 0 OR vorher >= tabAnzahl OR vorher = aktiverTab THEN
        geteiltSetzen(FALSE)
        RETURN
    END IF
    GUI_SET_TAB(tabFelder[linkerTab], linkerTab)
    linkerTab = vorher
    GUI_SET_TAB(tabFelder[linkerTab], -1)
    layout()
END SUB

' --- Uebersichtskarte --------------------------------------------------
' Eine Zeile ist ein Strich, so breit wie sie lang ist; der sichtbare
' Ausschnitt liegt als heller Kasten darueber. Ein Klick springt.
SUB minimapZeichnen()
    IF NOT minimapAn THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM cx AS INTEGER : cx = GUI_CANVAS_X(karte)
    DIM cy AS INTEGER : cy = GUI_CANVAS_Y(karte)
    DIM cw AS INTEGER : cw = GUI_CANVAS_W(karte)
    DIM ch AS INTEGER : ch = GUI_CANVAS_H(karte)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM n AS INTEGER : n = LEN(zeilen)
    IF n = 0 THEN RETURN
    ' So viele Zeilen wie Platz ist, sonst zusammengefasst: bei 3000 Zeilen
    ' und 600 Punkten Hoehe steht eine Zeile fuer fuenf.
    DIM proZeile AS INTEGER : proZeile = MAX(1, (n + ch - 1) \ ch)
    DIM y AS INTEGER : y = 0
    DIM i AS INTEGER
    FOR i = 0 TO n - 1 STEP proZeile
        DIM zt AS STRING : zt = zeilen[i]
        DIM roh AS STRING : roh = LTRIM$(zt)
        IF roh <> "" THEN
            DIM breit AS INTEGER : breit = MIN(cw - 4, LEN(zt) * 2)
            DIM einzugX AS INTEGER : einzugX = MIN(cw \ 3, (LEN(zt) - LEN(roh)) * 2)
            DIM f AS INTEGER : f = &H60708A
            IF LEFT$(roh, 1) = "'" THEN f = F_KOMMENTAR
            BOX(cx + 2 + einzugX, cy + y, cx + 2 + breit, cy + y, f)
        END IF
        y = y + 1
        IF y >= ch THEN BREAK
    NEXT
    ' Der sichtbare Ausschnitt als heller Rahmen.
    DIM erste AS INTEGER
    DIM sicht AS INTEGER
    DIM von AS INTEGER
    DIM laenge AS INTEGER
    (erste, sicht, von, laenge) = GUI_TEXTAREA_VIEW(ta)
    DIM y0 AS INTEGER : y0 = cy + erste \ proZeile
    DIM y1 AS INTEGER : y1 = cy + MIN(ch, (erste + sicht) \ proZeile)
    BOX(cx + 1, y0, cx + cw - 2, y1, &H20FFFFFF)
    RECT(cx + 1, y0, cx + cw - 2, y1, &H60A8C8E0)
    ' Klick: dorthin springen. Die Leinwand nimmt selbst keine Klicks an,
    ' der Treffertest ist deshalb von Hand.
    IF MOUSE_HIT(1) AND MOUSEX() >= cx AND MOUSEX() < cx + cw AND MOUSEY() >= cy AND MOUSEY() < cy + ch THEN
        DIM ziel AS INTEGER : ziel = (MOUSEY() - cy) * proZeile + 1
        GUI_TEXTAREA_GOTO(ta, MAX(1, MIN(n, ziel)), 1)
        GUI_FOCUS(ta)
        protokoll("karte sprung " + STR$(MAX(1, MIN(n, ziel))))
    END IF
END SUB

SUB minimapSetzen(an AS BOOLEAN)
    minimapAn = an
    GUI_MENU_CHECK(miMinimap, an)
    layout()
    konfigSichern()
    protokoll("karte " + IIF(an, "an", "aus"))
END SUB

' --- Faltung ----------------------------------------------------------
SUB faltenUmschalten()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF faltSchluessel = "" THEN gliederungFuellen(GUI_TEXT(ta))
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zu AS BOOLEAN : zu = GUI_TEXTAREA_FOLD(ta, z)
    GUI_FOCUS(ta)
    protokoll("falte " + STR$(z) + IIF(zu, " zu", " auf"))
END SUB

SUB faltenAlle(zu AS BOOLEAN)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF faltSchluessel = "" THEN gliederungFuellen(GUI_TEXT(ta))
    DIM n AS INTEGER : n = GUI_TEXTAREA_FOLD_ALL(ta, zu)
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, IIF(zu, STR$(n) + " Bloecke zugeklappt.", "Alles aufgeklappt."))
    protokoll("falten alle " + STR$(n))
END SUB

FUNCTION dateiLesen(pfad AS STRING) AS STRING
    DIM zeilen AS ARRAY OF STRING
    zeilen = READLINES(pfad)
    RETURN JOIN$(zeilen, NL)
END FUNCTION

SUB tabOeffnen(pfad AS STRING, inhalt AS STRING)
    IF tabAnzahl >= MAX_TABS THEN
        GUI_SET_TEXT(lblStatus, "Hoechstens " + STR$(MAX_TABS) + " Reiter -- erst einen schliessen.")
        RETURN
    END IF
    ' Schon offen? Dann nur hin.
    DIM i AS INTEGER
    IF pfad <> "" THEN
        FOR i = 0 TO tabAnzahl - 1
            IF tabPfade[i] = pfad THEN
                aktiverTab = i
                reiterNeuSetzen()
                GUI_FOCUS(tabFelder[i])
                RETURN
            END IF
        NEXT
    END IF
    DIM ta AS GUI_WIDGET
    ta = GUI_TEXTAREA(win, 0, 0, 10, 10)
    feldEinrichten(ta)
    GUI_SET_TEXT(ta, inhalt)
    GUI_SET_TAB(ta, tabAnzahl)
    tabPfade[tabAnzahl] = pfad
    tabFelder[tabAnzahl] = ta
    tabGesichert[tabAnzahl] = inhalt
    tabLetzterText[tabAnzahl] = ""
    aktiverTab = tabAnzahl
    tabAnzahl = tabAnzahl + 1
    reiterNeuSetzen()
    layout()
    GUI_FOCUS(ta)
    GUI_TEXTAREA_GOTO(ta, 1, 1)
    pruefungFaellig = GET_TIME()
    protokoll("geoeffnet " + pfad)
END SUB

SUB dateiOeffnen(pfad AS STRING)
    IF NOT FILEEXISTS(pfad) THEN
        GUI_SET_TEXT(lblStatus, "Gibt es nicht: " + pfad)
        RETURN
    END IF
    tabOeffnen(pfad, dateiLesen(pfad))
    projektOrdner = DIRNAME(pfad)
    baumFuellen()
    zuletztMerken(pfad)
    GUI_SET_TEXT(lblStatus, pfad)
END SUB

FUNCTION aktivesFeld() AS GUI_WIDGET
    IF aktiverTab < 0 THEN RETURN -1
    RETURN tabFelder[aktiverTab]
END FUNCTION

FUNCTION sichern(i AS INTEGER, alsNeu AS BOOLEAN) AS BOOLEAN
    IF i < 0 THEN RETURN FALSE
    DIM pfad AS STRING : pfad = tabPfade[i]
    IF pfad = "" OR alsNeu THEN
        pfad = FILE_SAVE_DIALOG("Sichern unter", "programm.dh", "dh")
        IF pfad = "" THEN RETURN FALSE
        tabPfade[i] = pfad
    END IF
    DIM text AS STRING : text = GUI_TEXT(tabFelder[i])
    tabGesichert[i] = text
    ' Die Datei endet mit einem Umbruch (dateiLesen laesst ihn weg, das Feld
    ' kennt ihn nicht) -- sonst verloere jede gesicherte Datei ihre letzte
    ' Zeile im Diff ("no newline at end of file"). Bis Stand 3 war das so.
    IF text <> "" AND RIGHT$(text, 1) <> NL THEN text = text + NL
    WRITEALL(pfad, text)
    reiterNeuSetzen()
    zuletztMerken(pfad)
    GUI_SET_TEXT(lblStatus, "Gesichert: " + pfad)
    protokoll("gesichert " + pfad)
    IF DIRNAME(pfad) <> projektOrdner THEN
        projektOrdner = DIRNAME(pfad)
        baumFuellen()
    END IF
    RETURN TRUE
END FUNCTION

SUB tabSchliessen(i AS INTEGER)
    IF i < 0 OR i >= tabAnzahl THEN RETURN
    ' Die Reiter ruecken auf, der linke der geteilten Ansicht zeigte danach
    ' auf eine andere Datei -- lieber ganz aus als still auf die falsche.
    IF geteilt THEN geteiltSetzen(FALSE)
    GUI_DESTROY(tabFelder[i])
    DIM k AS INTEGER
    FOR k = i TO tabAnzahl - 2
        tabPfade[k] = tabPfade[k + 1]
        tabFelder[k] = tabFelder[k + 1]
        tabGesichert[k] = tabGesichert[k + 1]
        tabLetzterText[k] = tabLetzterText[k + 1]
        GUI_SET_TAB(tabFelder[k], k)
    NEXT
    tabAnzahl = tabAnzahl - 1
    IF aktiverTab >= tabAnzahl THEN aktiverTab = tabAnzahl - 1
    reiterNeuSetzen()
    layout()
    GUI_LISTBOX_CLEAR(lstProbleme)
    protokoll("geschlossen")
END SUB

' --- Projektbaum -------------------------------------------------------
DIM baumDateien AS ARRAY OF STRING
DIM baumKnoten AS ARRAY OF INTEGER

SUB baumFuellen()
    GUI_TREE_CLEAR(baum)
    GUI_SET_TEXT(lblProjekt, BASENAME(projektOrdner))
    baumDateien = DIRLIST(projektOrdner, "*.dh")
    DIM n AS INTEGER : n = LEN(baumDateien)
    DIM knoten[MAX(n, 1)] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        knoten[i] = GUI_TREE_ADD(baum, -1, baumDateien[i])
    NEXT
    baumKnoten = knoten
END SUB

DIM baumLetzteWahl AS INTEGER : baumLetzteWahl = -1

SUB baumAbfragen()
    DIM sel AS INTEGER : sel = GUI_TREE_SELECTED(baum)
    IF sel < 0 OR sel = baumLetzteWahl THEN RETURN
    baumLetzteWahl = sel
    DIM i AS INTEGER
    FOR i = 0 TO LEN(baumDateien) - 1
        IF baumKnoten[i] = sel THEN dateiOeffnen(PATHJOIN(projektOrdner, baumDateien[i]))
    NEXT
END SUB

' --- Einfaerben (nur der sichtbare Ausschnitt) ------------------------
FUNCTION farbeFuer(art AS STRING) AS INTEGER
    IF art = "kommentar" THEN RETURN F_KOMMENTAR
    IF art = "text" THEN RETURN F_TEXT
    IF art = "zahl" THEN RETURN F_ZAHL
    IF art = "schluessel" THEN RETURN F_SCHLUESSEL
    IF art = "operator" THEN RETURN F_OPERATOR
    RETURN F_GRUND
END FUNCTION

SUB faerben(ta AS GUI_WIDGET)
    DIM erste AS INTEGER
    DIM zeilen AS INTEGER
    DIM von AS INTEGER
    DIM laenge AS INTEGER
    (erste, zeilen, von, laenge) = GUI_TEXTAREA_VIEW(ta)
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM stueck AS STRING : stueck = MID$(q, von, laenge)
    DIM starts AS ARRAY OF INTEGER
    DIM laengen AS ARRAY OF INTEGER
    DIM arten AS ARRAY OF STRING
    (starts, laengen, arten) = SYNTAX_SPANS(stueck)
    DIM n AS INTEGER : n = LEN(starts)
    IF n = 0 THEN RETURN
    DIM farben[n] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        starts[i] = starts[i] + von
        farben[i] = farbeFuer(arten[i])
    NEXT
    GUI_TEXTAREA_SPANS(ta, starts, laengen, farben)
END SUB

' --- Pruefen -----------------------------------------------------------
DIM problemZeilen AS ARRAY OF INTEGER : problemZeilen = []

SUB pruefen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF problemModus = 0 THEN GUI_LISTBOX_CLEAR(lstProbleme)
    IF ta < 0 THEN RETURN
    DIM basis AS STRING : basis = projektOrdner
    IF tabPfade[aktiverTab] <> "" THEN basis = DIRNAME(tabPfade[aktiverTab])
    DIM j AS JSON_HANDLE
    j = JSON_PARSE(CODE_CHECK$(GUI_TEXT(ta), basis))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM zeilen[MAX(n, 1)] AS INTEGER
    DIM i AS INTEGER
    DIM fehler AS INTEGER : fehler = 0
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        zeilen[i] = JSON_GET_INT(j, p + ".zeile")
        DIM art AS STRING : art = JSON_GET_STRING(j, p + ".schwere")
        IF art = "fehler" THEN fehler = fehler + 1
        IF problemModus = 0 THEN
            GUI_LISTBOX_ADD(lstProbleme, "Zeile " + STR$(zeilen[i]) + ": " + JSON_GET_STRING(j, p + ".meldung"))
            IF art = "fehler" THEN GUI_LISTBOX_COLOR(lstProbleme, i, &HE06060) ELSE GUI_LISTBOX_COLOR(lstProbleme, i, &HE0C060)
        END IF
    NEXT
    problemZeilen = zeilen
    IF problemModus = 0 THEN
        IF n = 0 THEN
            GUI_SET_TEXT(lblProbleme, "Probleme: keine")
        ELSE
            GUI_SET_TEXT(lblProbleme, "Probleme: " + STR$(fehler) + " Fehler, " + STR$(n - fehler) + " Warnungen")
        END IF
    END IF
    protokoll("geprueft " + STR$(n))
    gliederungFuellen(GUI_TEXT(ta))
END SUB

' --- Gliederung: SUB/FUNCTION/CLASS der aktiven Datei (CODE_SYMBOLS$) ---
SUB gliederungFuellen(quelle AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM namen AS ARRAY OF STRING : namen = []
    DIM zeilen AS ARRAY OF INTEGER : zeilen = []
    DIM schl AS STRING : schl = ""
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        DIM eintrag AS STRING : eintrag = JSON_GET_STRING(j, p + ".art") + " " + JSON_GET_STRING(j, p + ".name")
        ARRAY_PUSH(namen, eintrag) : ARRAY_PUSH(zeilen, JSON_GET_INT(j, p + ".von"))
        schl = schl + eintrag + ":" + STR$(JSON_GET_INT(j, p + ".von")) + ";"
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            ARRAY_PUSH(namen, "    " + JSON_GET_STRING(j, pk + ".name")) : ARRAY_PUSH(zeilen, JSON_GET_INT(j, pk + ".von"))
            schl = schl + JSON_GET_STRING(j, pk + ".name") + ":" + STR$(JSON_GET_INT(j, pk + ".von")) + ";"
        NEXT
    NEXT
    ' Dieselben Bloecke sind die faltbaren -- die Laufzeit kennt keine
    ' Sprache und erfaehrt sie nur so.
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 AND schl <> faltSchluessel THEN
        faltSchluessel = schl
        DIM fv AS ARRAY OF INTEGER : fv = []
        DIM fb AS ARRAY OF INTEGER : fb = []
        FOR i = 0 TO n - 1
            DIM pf AS STRING : pf = STR$(i)
            ARRAY_PUSH(fv, JSON_GET_INT(j, pf + ".von")) : ARRAY_PUSH(fb, JSON_GET_INT(j, pf + ".bis"))
            DIM mf AS INTEGER
            FOR mf = 0 TO JSON_LEN(j, pf + ".kinder") - 1
                DIM pkf AS STRING : pkf = pf + ".kinder." + STR$(mf)
                ARRAY_PUSH(fv, JSON_GET_INT(j, pkf + ".von")) : ARRAY_PUSH(fb, JSON_GET_INT(j, pkf + ".bis"))
            NEXT
        NEXT
        GUI_TEXTAREA_FOLDABLE(ta, fv, fb)
    END IF
    IF schl = gliederungSchluessel THEN RETURN
    gliederungSchluessel = schl
    gliederungZeilen = zeilen
    GUI_LISTBOX_CLEAR(lstGliederung)
    DIM e AS STRING
    FOR EACH e IN namen
        GUI_LISTBOX_ADD(lstGliederung, e)
    NEXT
    protokoll("gliederung " + STR$(n))
END SUB

SUB gliederungAnspringen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstGliederung)
    IF sel < 0 OR sel >= LEN(gliederungZeilen) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_TEXTAREA_GOTO(ta, gliederungZeilen[sel], 1)
    GUI_FOCUS(ta)
END SUB

SUB problemAnspringen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstProbleme)
    IF problemModus = 1 THEN
        IF sel < 0 OR sel >= LEN(sucheZeilen) THEN RETURN
        dateiOeffnen(PATHJOIN(projektOrdner, sucheDateien[sel]))
        DIM tf AS GUI_WIDGET : tf = aktivesFeld()
        IF tf >= 0 THEN GUI_TEXTAREA_GOTO(tf, sucheZeilen[sel], 1) : GUI_FOCUS(tf)
        RETURN
    END IF
    IF sel < 0 OR sel >= LEN(problemZeilen) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_TEXTAREA_GOTO(ta, problemZeilen[sel], 1)
    GUI_FOCUS(ta)
END SUB

' --- Suche im Projekt --------------------------------------------------
' `zweitens` ist ein zweiter Suchtext (ODER) -- fuer die TODO/FIXME-Liste.
SUB projektSuchen(gesucht AS STRING, zweitens AS STRING)
    IF gesucht = "" THEN RETURN
    GUI_LISTBOX_CLEAR(lstProbleme)
    DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(projektOrdner, "*.dh")
    DIM sd AS ARRAY OF STRING : sd = []
    DIM sz AS ARRAY OF INTEGER : sz = []
    DIM klein AS STRING : klein = LOWER$(gesucht)
    DIM klein2 AS STRING : klein2 = LOWER$(zweitens)
    DIM treffer AS INTEGER : treffer = 0
    DIM inDateien AS INTEGER : inDateien = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(projektOrdner, d))
        DIM vorher AS INTEGER : vorher = treffer
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            IF treffer >= 500 THEN BREAK
            IF INSTR(LOWER$(zeilen[i]), klein) >= 0 OR (klein2 <> "" AND INSTR(LOWER$(zeilen[i]), klein2) >= 0) THEN
                ARRAY_PUSH(sd, d)
                ARRAY_PUSH(sz, i + 1)
                GUI_LISTBOX_ADD(lstProbleme, d + ":" + STR$(i + 1) + ": " + TRIM$(zeilen[i]))
                treffer = treffer + 1
            END IF
        NEXT
        IF treffer > vorher THEN inDateien = inDateien + 1
    NEXT
    sucheDateien = sd
    sucheZeilen = sz
    problemModus = 1
    DIM was AS STRING : was = gesucht
    IF zweitens <> "" THEN was = gesucht + "/" + zweitens
    GUI_SET_TEXT(lblProbleme, "Suche '" + was + "': " + STR$(treffer) + " Treffer in " + STR$(inDateien) + " Dateien -- Umschalt+F7 zeigt wieder die Probleme")
    protokoll("suche " + STR$(treffer))
END SUB

' --- Haltepunkte und Marken in der Nummernspalte ---------------------
FUNCTION haltepunktIndex(pfad AS STRING, zeile AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF hpDateien[i] = pfad AND hpZeilen[i] = zeile THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB haltepunktUmschalten()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, "Erst sichern -- Haltepunkte gehoeren zu einer Datei.") : RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    DIM k AS INTEGER : k = haltepunktIndex(pfad, z)
    IF k >= 0 THEN
        ARRAY_REMOVE_AT(hpDateien, k)
        ARRAY_REMOVE_AT(hpZeilen, k)
        ARRAY_REMOVE_AT(hpBedingungen, k)
        protokoll("haltepunkt " + STR$(z) + " aus")
    ELSE
        ARRAY_PUSH(hpDateien, pfad)
        ARRAY_PUSH(hpZeilen, z)
        ARRAY_PUSH(hpBedingungen, "")
        protokoll("haltepunkt " + STR$(z) + " an")
    END IF
    ' Laeuft der Debugger gerade an dieser Datei und steht, gilt es sofort.
    IF prozessArt = "debug" AND debugPause AND prozessDatei = pfad THEN debugHaltepunkteSenden()
END SUB

' Umschalt+F9: ein Haltepunkt, der nur haelt, wenn ein Ausdruck wahr ist
' (`i = 3`, `hp < 10`). Der Debugger-Kern kennt das schon (`conditions` im
' set-breakpoints-Kommando), die IDE fragt nur nach dem Ausdruck.
SUB haltepunktBedingungFragen()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, "Erst sichern -- Haltepunkte gehoeren zu einer Datei.") : RETURN
    DIM s AS INTEGER
    (bedingungZeile, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    DIM vorgabe AS STRING : vorgabe = ""
    DIM k AS INTEGER : k = haltepunktIndex(pfad, bedingungZeile)
    IF k >= 0 THEN vorgabe = hpBedingungen[k]
    dlgBedingung = GUI_PROMPT("Bedingter Haltepunkt", "Halten in Zeile " + STR$(bedingungZeile) + ", wenn (leer = immer):", vorgabe)
END SUB

SUB haltepunktBedingungSetzen(ausdruck AS STRING)
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM k AS INTEGER : k = haltepunktIndex(pfad, bedingungZeile)
    IF k < 0 THEN
        ARRAY_PUSH(hpDateien, pfad) : ARRAY_PUSH(hpZeilen, bedingungZeile) : ARRAY_PUSH(hpBedingungen, TRIM$(ausdruck))
    ELSE
        hpBedingungen[k] = TRIM$(ausdruck)
    END IF
    IF TRIM$(ausdruck) = "" THEN
        protokoll("haltepunkt " + STR$(bedingungZeile) + " an")
    ELSE
        protokoll("haltepunkt " + STR$(bedingungZeile) + " bedingt " + TRIM$(ausdruck))
    END IF
    markenSchluessel = ""
    IF prozessArt = "debug" AND debugPause AND prozessDatei = pfad THEN debugHaltepunkteSenden()
END SUB

' --- Lesezeichen -------------------------------------------------------
FUNCTION lesezeichenIndex(pfad AS STRING, zeile AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lzZeilen) - 1
        IF lzDateien[i] = pfad AND lzZeilen[i] = zeile THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB lesezeichenUmschalten()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    DIM k AS INTEGER : k = lesezeichenIndex(pfad, z)
    IF k >= 0 THEN
        ARRAY_REMOVE_AT(lzDateien, k) : ARRAY_REMOVE_AT(lzZeilen, k)
        protokoll("lesezeichen " + STR$(z) + " aus")
    ELSE
        ARRAY_PUSH(lzDateien, pfad) : ARRAY_PUSH(lzZeilen, z)
        protokoll("lesezeichen " + STR$(z) + " an")
    END IF
    markenSchluessel = ""
END SUB

' F2: zum naechsten Lesezeichen hinter der Marke, am Ende wieder von vorn.
SUB lesezeichenWeiter()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    DIM naechste AS INTEGER : naechste = 0
    DIM erste AS INTEGER : erste = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lzZeilen) - 1
        IF lzDateien[i] <> pfad THEN CONTINUE
        IF erste = 0 OR lzZeilen[i] < erste THEN erste = lzZeilen[i]
        IF lzZeilen[i] > z AND (naechste = 0 OR lzZeilen[i] < naechste) THEN naechste = lzZeilen[i]
    NEXT
    IF naechste = 0 THEN naechste = erste
    IF naechste = 0 THEN GUI_SET_TEXT(lblStatus, "Kein Lesezeichen in dieser Datei -- Strg+F2 setzt eins.") : RETURN
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], naechste, 1)
    GUI_FOCUS(tabFelder[aktiverTab])
    protokoll("lesezeichen sprung " + STR$(naechste))
END SUB

SUB markenNachziehen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM zeilen AS ARRAY OF INTEGER : zeilen = []
    DIM farben AS ARRAY OF INTEGER : farben = []
    DIM schl AS STRING : schl = pfad + "|"
    ' Reihenfolge = Vorrang: die angehaltene Zeile vor dem Haltepunkt vor dem
    ' Fehler vor dem Lesezeichen. Ein bedingter Haltepunkt ist violett.
    IF prozessArt = "debug" AND debugPause AND prozessDatei = pfad AND debugZeile > 0 THEN
        ARRAY_PUSH(zeilen, debugZeile) : ARRAY_PUSH(farben, &HFFD040) : schl = schl + "p" + STR$(debugZeile)
    END IF
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF hpDateien[i] = pfad THEN
            ARRAY_PUSH(zeilen, hpZeilen[i])
            IF hpBedingungen[i] = "" THEN ARRAY_PUSH(farben, &HE05050) ELSE ARRAY_PUSH(farben, &HC060E0)
            schl = schl + "h" + STR$(hpZeilen[i]) + hpBedingungen[i]
        END IF
    NEXT
    FOR i = 0 TO LEN(problemZeilen) - 1
        ARRAY_PUSH(zeilen, problemZeilen[i]) : ARRAY_PUSH(farben, &HD08040) : schl = schl + "f" + STR$(problemZeilen[i])
    NEXT
    FOR i = 0 TO LEN(lzZeilen) - 1
        IF lzDateien[i] = pfad THEN ARRAY_PUSH(zeilen, lzZeilen[i]) : ARRAY_PUSH(farben, &H5090E0) : schl = schl + "l" + STR$(lzZeilen[i])
    NEXT
    IF schl = markenSchluessel THEN RETURN
    markenSchluessel = schl
    GUI_TEXTAREA_MARKS(ta, zeilen, farben)
END SUB

' --- Hilfe zum Wort unter der Marke ----------------------------------
' Der Aufruf, in dem die Marke gerade steht: rueckwaerts durch die Zeile,
' Klammern zaehlen. Liefert (name, spalte_des_namens, argumentnummer);
' name leer heisst: die Marke steht in keiner Argumentliste.
FUNCTION aufrufUmDieMarke(zeile AS STRING, spalte AS INTEGER) AS TUPLE
    ' MID$ zaehlt ab 0, `spalte` ab 1: die Marke steht VOR Zeichen spalte-1.
    ' Erst zaehlen, wie viele Anfuehrungszeichen links von ihr stehen -- eine
    ' ungerade Zahl heisst: die Marke steht in einer Zeichenkette, und dort
    ' ist jede Klammer nur ein Zeichen.
    DIM q AS INTEGER : q = 0
    DIM k AS INTEGER
    FOR k = 0 TO spalte - 2
        IF MID$(zeile, k, 1) = CHR$(34) THEN q = q + 1
    NEXT
    IF q MOD 2 = 1 THEN RETURN ("", 0, 0)
    DIM tiefe AS INTEGER : tiefe = 0
    DIM arg AS INTEGER : arg = 0
    DIM inText AS BOOLEAN : inText = FALSE
    DIM i AS INTEGER : i = spalte - 2
    WHILE i >= 0
        DIM c AS STRING : c = MID$(zeile, i, 1)
        IF c = CHR$(34) THEN
            inText = NOT inText
        ELSEIF NOT inText THEN
            IF c = ")" THEN
                tiefe = tiefe + 1
            ELSEIF c = "(" THEN
                IF tiefe = 0 THEN
                    ' Gefunden: der Name links davon.
                    DIM e AS INTEGER : e = i - 1
                    WHILE e >= 0 AND MID$(zeile, e, 1) = " " : e = e - 1 : WEND
                    DIM a AS INTEGER : a = e
                    WHILE a >= 0 AND istWortzeichen(MID$(zeile, a, 1)) : a = a - 1 : WEND
                    IF e > a THEN RETURN (MID$(zeile, a + 1, e - a), a + 2, arg)
                    RETURN ("", 0, 0)
                END IF
                tiefe = tiefe - 1
            ELSEIF c = "," AND tiefe = 0 THEN
                arg = arg + 1
            END IF
        END IF
        i = i - 1
    WEND
    RETURN ("", 0, 0)
END FUNCTION

' Signatur des Aufrufs, in dem die Marke steht -- "" wenn keiner.
FUNCTION signaturHilfe$(ta AS GUI_WIDGET, z AS INTEGER, s AS INTEGER) AS STRING
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN ""
    DIM name AS STRING
    DIM spalte AS INTEGER
    DIM arg AS INTEGER
    (name, spalte, arg) = aufrufUmDieMarke(zeilen[z - 1], s)
    IF name = "" THEN RETURN ""
    DIM md AS STRING : md = CODE_HOVER$(GUI_TEXT(ta), z, spalte)
    IF md = "" THEN RETURN ""
    ' Die erste Zeile im Codeblock ist die Signatur.
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, "```", "")
    DIM erste AS STRING : erste = TRIM$(SPLIT$(TRIM$(md), NL)[0])
    IF erste = "" THEN RETURN ""
    RETURN erste + "   -- Argument " + STR$(arg + 1)
END FUNCTION

SUB hilfeNachziehen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM marke AS STRING : marke = STR$(z) + ":" + STR$(s)
    IF marke = letzteMarke THEN RETURN
    letzteMarke = marke
    GUI_SET_TEXT(lblStatus, "Zeile " + STR$(z) + ", Spalte " + STR$(s))
    ' Steht die Marke in einer Argumentliste, gilt die Signatur des Aufrufs:
    ' dort steht sie auf einem Komma oder einer Zahl, und die Hilfe zum Wort
    ' schwiege genau dann, wenn man sie braucht.
    DIM sig AS STRING : sig = signaturHilfe$(ta, z, s)
    IF sig <> "" THEN
        GUI_SET_TEXT(lblHilfe, sig)
        protokoll("signatur " + sig)
        RETURN
    END IF
    DIM md AS STRING : md = CODE_HOVER$(GUI_TEXT(ta), z, s)
    ' Die Markdown-Zaeune weglassen -- die Beschriftung zeigt Text.
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, NL + "```", "")
    md = REPLACE$(md, "```", "")
    GUI_SET_TEXT(lblHilfe, md)
END SUB

' --- Vervollstaendigen -------------------------------------------------
SUB vervollstaendigen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM namen AS ARRAY OF STRING
    namen = CODE_COMPLETE(q, z, s)
    ' Laenge des Praefixes links der Marke -- so viel wird beim Uebernehmen ersetzt.
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(q, NL)
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    DIM k AS INTEGER : k = s - 1
    vervollPraefixLaenge = 0
    WHILE k > 0
        DIM c AS STRING : c = MID$(zeile, k - 1, 1)
        IF NOT (c = "_" OR (c >= "a" AND c <= "z") OR (c >= "A" AND c <= "Z") OR (c >= "0" AND c <= "9")) THEN BREAK
        vervollPraefixLaenge = vervollPraefixLaenge + 1
        k = k - 1
    WEND
    GUI_LISTBOX_CLEAR(lstVervoll)
    DIM i AS INTEGER
    FOR i = 0 TO MIN(LEN(namen), 200) - 1
        GUI_LISTBOX_ADD(lstVervoll, namen[i])
    NEXT
    IF LEN(namen) = 0 THEN RETURN
    GUI_LISTBOX_SET_SELECTED(lstVervoll, 0)
    GUI_WINDOW_SET_BOUNDS(winVervoll, breiteLinks + 40, 120, 320, 240)
    GUI_WINDOW_VISIBLE(winVervoll, TRUE)
    vervollOffen = TRUE
    GUI_FOCUS(lstVervoll)
END SUB

SUB vervollUebernehmen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstVervoll)
    GUI_WINDOW_VISIBLE(winVervoll, FALSE)
    vervollOffen = FALSE
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF sel >= 0 THEN
        DIM z AS INTEGER
        DIM s AS INTEGER
        (z, s) = GUI_TEXTAREA_CURSOR(ta)
        GUI_TEXTAREA_SELECT(ta, z, s - vervollPraefixLaenge, z, s)
        GUI_TEXTAREA_INSERT(ta, GUI_LISTBOX_ITEM(lstVervoll, sel))
        protokoll("vervollstaendigt " + GUI_LISTBOX_ITEM(lstVervoll, sel))
    END IF
    GUI_FOCUS(ta)
END SUB

' --- Suchen / Ersetzen / Zeile ----------------------------------------
FUNCTION weitersuchen(abNaechstem AS BOOLEAN) AS BOOLEAN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR suchtext = "" THEN RETURN FALSE
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    IF abNaechstem THEN s = s + 1
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = GUI_TEXTAREA_FIND(ta, suchtext, z, s)
    IF tz < 0 THEN (tz, ts) = GUI_TEXTAREA_FIND(ta, suchtext, 1, 1)
    IF tz < 0 THEN
        GUI_SET_TEXT(lblStatus, "Nicht gefunden: " + suchtext)
        RETURN FALSE
    END IF
    GUI_TEXTAREA_SELECT(ta, tz, ts, tz, ts + LEN(suchtext))
    GUI_FOCUS(ta)
    RETURN TRUE
END FUNCTION

SUB zurDefinition()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM dz AS INTEGER
    DIM ds AS INTEGER
    (dz, ds) = CODE_DEFINITION(GUI_TEXT(ta), z, s)
    IF dz < 0 THEN
        GUI_SET_TEXT(lblStatus, "Keine Definition in dieser Datei.")
        RETURN
    END IF
    GUI_TEXTAREA_GOTO(ta, dz, ds)
END SUB

' --- Handgriffe im Text: Kommentar, Zeilen, Einrueckung, Formatieren -------
' Alle arbeiten auf ganzen ZEILEN: der Auswahl, sonst der Zeile der Marke.
' Geschrieben wird ueber SELECT + INSERT, damit jeder Handgriff ein eigener
' Undo-Schritt bleibt (GUI_SET_TEXT wuerde den Verlauf leeren).
CONST SPALTE_ENDE = 1000000          ' GUI_TEXTAREA_SELECT klemmt ans Zeilenende

FUNCTION zeilenBereich(ta AS GUI_WIDGET) AS TUPLE
    DIM z1 AS INTEGER
    DIM s1 AS INTEGER
    DIM z2 AS INTEGER
    DIM s2 AS INTEGER
    (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    ' Endet die Auswahl am Anfang einer Zeile, gehoert die nicht mehr dazu.
    IF z2 > z1 AND s2 = 1 THEN z2 = z2 - 1
    RETURN (z1, z2)
END FUNCTION

FUNCTION zeilenHolen(alle AS ARRAY OF STRING, z1 AS INTEGER, z2 AS INTEGER) AS ARRAY OF STRING
    DIM block AS ARRAY OF STRING : block = []
    DIM i AS INTEGER
    FOR i = z1 - 1 TO z2 - 1
        IF i >= 0 AND i < LEN(alle) THEN ARRAY_PUSH(block, alle[i])
    NEXT
    RETURN block
END FUNCTION

' --- Umbenennen (Umschalt+F6) ----------------------------------------
' Das Umbenennen selbst macht CODE_RENAME$: ganze Woerter, ohne Kommentare
' und Zeichenketten. Die IDE fragt nur den neuen Namen und schreibt das
' Ergebnis als EINEN Undo-Schritt zurueck (Auswahl ueber alles + INSERT --
' GUI_SET_TEXT leerte den Verlauf).
SUB umbenennenFragen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM alt AS STRING : alt = wortUnterMarke$()
    IF alt = "" THEN
        GUI_SET_TEXT(lblStatus, "Umbenennen: unter der Marke steht kein Name.")
        RETURN
    END IF
    (umbenennZeile, umbenennSpalte) = GUI_TEXTAREA_CURSOR(ta)
    dlgUmbenennen = GUI_PROMPT("Umbenennen", "'" + alt + "' ueberall nennen in:", alt)
END SUB

SUB umbenennenAusfuehren(neu AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM neuText AS STRING : neuText = CODE_RENAME$(q, umbenennZeile, umbenennSpalte, neu)
    IF neuText = "" THEN
        GUI_SET_TEXT(lblStatus, "Umbenennen: '" + neu + "' geht nicht -- ein Name faengt mit Buchstabe oder _ an, und Schluesselwoerter bleiben, wie sie sind.")
        RETURN
    END IF
    IF neuText = q THEN
        GUI_SET_TEXT(lblStatus, "Umbenennen: nichts zu tun.")
        RETURN
    END IF
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(q, NL)
    DIM letzte AS INTEGER : letzte = LEN(zeilen)
    GUI_TEXTAREA_SELECT(ta, 1, 1, letzte, LEN(zeilen[letzte - 1]) + 1)
    GUI_TEXTAREA_INSERT(ta, neuText)
    GUI_TEXTAREA_GOTO(ta, umbenennZeile, umbenennSpalte)
    GUI_FOCUS(ta)
    ' Die Zahl der Fundstellen sagt CODE_REFERENCES -- am ALTEN Text, denn
    ' im neuen heisst der Name schon anders.
    DIM n AS INTEGER : n = LEN(CODE_REFERENCES(q, umbenennZeile, umbenennSpalte))
    GUI_SET_TEXT(lblStatus, STR$(n) + " Stellen umbenannt in '" + neu + "'.")
    protokoll("umbenannt " + STR$(n) + " " + neu)
END SUB

' --- Schnipsel (Strg+J) -----------------------------------------------
' Vorlagen mit einem Platzhalter `|` fuer die Schreibmarke. Die Einrueckung
' der laufenden Zeile wird auf jede weitere Zeile uebernommen -- sonst
' klebte ein eingefuegter Block am linken Rand.
DIM schnipselNamen AS ARRAY OF STRING : schnipselNamen = []
DIM schnipselText AS ARRAY OF STRING : schnipselText = []

SUB schnipsel(name AS STRING, text AS STRING)
    ARRAY_PUSH(schnipselNamen, name) : ARRAY_PUSH(schnipselText, text)
END SUB

SUB schnipselEinfuegen(nummer AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR nummer < 0 OR nummer >= LEN(schnipselText) THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM einzug AS STRING : einzug = ""
    IF z >= 1 AND z <= LEN(zeilen) THEN
        ' MID$ zaehlt ab 0 -- Zeichen k ist MID$(s, k, 1).
        DIM k AS INTEGER : k = 0
        WHILE k < LEN(zeilen[z - 1]) AND MID$(zeilen[z - 1], k, 1) = " "
            einzug = einzug + " " : k = k + 1
        WEND
    END IF
    ' Eingerueckt wird Zeile fuer Zeile, LEERE ausgenommen: ein blindes
    ' REPLACE$ machte aus jeder Leerzeile vier Leerzeichen, und die sieht man
    ' erst im Diff.
    DIM roh AS ARRAY OF STRING : roh = SPLIT$(schnipselText[nummer], NL)
    DIM zusammen AS ARRAY OF STRING : zusammen = []
    DIM ri AS INTEGER
    FOR ri = 0 TO LEN(roh) - 1
        IF ri = 0 OR roh[ri] = "" THEN
            ARRAY_PUSH(zusammen, roh[ri])
        ELSE
            ARRAY_PUSH(zusammen, einzug + roh[ri])
        END IF
    NEXT
    DIM text AS STRING : text = JOIN$(zusammen, NL)
    ' Wohin die Marke danach gehoert: der Platzhalter | wird gezaehlt und
    ' entfernt. Ohne ihn steht sie am Ende, wie nach jedem Einfuegen.
    ' INSTR zaehlt ab 0 und liefert -1, wenn es den Platzhalter nicht gibt.
    DIM marke AS INTEGER : marke = INSTR(text, "|")
    text = REPLACE$(text, "|", "")
    GUI_TEXTAREA_INSERT(ta, text)
    IF marke >= 0 THEN
        DIM vor AS STRING : vor = LEFT$(text, marke)
        DIM neueZ AS INTEGER : neueZ = z + LEN(SPLIT$(vor, NL)) - 1
        DIM letzteZ AS STRING : letzteZ = SPLIT$(vor, NL)[LEN(SPLIT$(vor, NL)) - 1]
        DIM neueS AS INTEGER : neueS = LEN(letzteZ) + 1
        IF neueZ = z THEN neueS = s + LEN(letzteZ)
        GUI_TEXTAREA_GOTO(ta, neueZ, neueS)
    END IF
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, "Schnipsel: " + schnipselNamen[nummer])
    protokoll("schnipsel " + schnipselNamen[nummer])
END SUB

SUB schnipselWaehlen()
    IF aktivesFeld() < 0 THEN RETURN
    paletteNamen = []
    paletteKennungen = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(schnipselNamen) - 1
        ARRAY_PUSH(paletteNamen, schnipselNamen[i]) : ARRAY_PUSH(paletteKennungen, STR$(i))
    NEXT
    waehlerOeffnen("schnipsel", "Schnipsel einfuegen")
END SUB

SUB zeilenErsetzen(ta AS GUI_WIDGET, z1 AS INTEGER, z2 AS INTEGER, neu AS ARRAY OF STRING)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
    GUI_TEXTAREA_INSERT(ta, JOIN$(neu, NL))
END SUB

SUB kommentarUmschalten()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM alleKommentiert AS BOOLEAN : alleKommentiert = TRUE
    DIM einzug AS INTEGER : einzug = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(block) - 1
        DIM t AS STRING : t = LTRIM$(block[i])
        IF t = "" THEN CONTINUE
        IF LEFT$(t, 1) <> "'" THEN alleKommentiert = FALSE
        DIM e AS INTEGER : e = LEN(block[i]) - LEN(t)
        IF einzug < 0 OR e < einzug THEN einzug = e
    NEXT
    IF einzug < 0 THEN RETURN                      ' nur Leerzeilen
    FOR i = 0 TO LEN(block) - 1
        DIM t2 AS STRING : t2 = LTRIM$(block[i])
        IF t2 = "" THEN CONTINUE
        IF alleKommentiert THEN
            DIM rest AS STRING : rest = MID$(t2, 1)
            IF LEFT$(rest, 1) = " " THEN rest = MID$(rest, 1)
            block[i] = LEFT$(block[i], LEN(block[i]) - LEN(t2)) + rest
        ELSE
            block[i] = LEFT$(block[i], einzug) + "' " + MID$(block[i], einzug)
        END IF
    NEXT
    zeilenErsetzen(ta, z1, z2, block)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
    protokoll("kommentar " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenDuplizieren()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM doppelt AS ARRAY OF STRING : doppelt = []
    DIM z AS STRING
    FOR EACH z IN block : ARRAY_PUSH(doppelt, z) : NEXT
    FOR EACH z IN block : ARRAY_PUSH(doppelt, z) : NEXT
    zeilenErsetzen(ta, z1, z2, doppelt)
    GUI_TEXTAREA_GOTO(ta, z2 + 1, 1)
    protokoll("dupliziert " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenLoeschen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM anzahl AS INTEGER : anzahl = LEN(SPLIT$(GUI_TEXT(ta), NL))
    IF z2 < anzahl THEN
        GUI_TEXTAREA_SELECT(ta, z1, 1, z2 + 1, 1)          ' samt dem Umbruch dahinter
    ELSEIF z1 > 1 THEN
        GUI_TEXTAREA_SELECT(ta, z1 - 1, SPALTE_ENDE, z2, SPALTE_ENDE)   ' die letzte: samt dem Umbruch davor
    ELSE
        GUI_TEXTAREA_SELECT(ta, 1, 1, z2, SPALTE_ENDE)
    END IF
    GUI_TEXTAREA_INSERT(ta, "")
    GUI_TEXTAREA_GOTO(ta, MIN(z1, MAX(anzahl - (z2 - z1 + 1), 1)), 1)
    protokoll("geloescht " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenVerschieben(richtung AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM alle AS ARRAY OF STRING : alle = SPLIT$(GUI_TEXT(ta), NL)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(alle, z1, z2)
    DIM neu AS ARRAY OF STRING : neu = []
    DIM z AS STRING
    IF richtung < 0 THEN
        IF z1 <= 1 THEN RETURN
        FOR EACH z IN block : ARRAY_PUSH(neu, z) : NEXT
        ARRAY_PUSH(neu, alle[z1 - 2])
        zeilenErsetzen(ta, z1 - 1, z2, neu)
        GUI_TEXTAREA_SELECT(ta, z1 - 1, 1, z2 - 1, SPALTE_ENDE)
    ELSE
        IF z2 >= LEN(alle) THEN RETURN
        ARRAY_PUSH(neu, alle[z2])
        FOR EACH z IN block : ARRAY_PUSH(neu, z) : NEXT
        zeilenErsetzen(ta, z1, z2 + 1, neu)
        GUI_TEXTAREA_SELECT(ta, z1 + 1, 1, z2 + 1, SPALTE_ENDE)
    END IF
    protokoll("verschoben " + STR$(z1) + "-" + STR$(z2) + " " + STR$(richtung))
END SUB

SUB einruecken(richtung AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(block) - 1
        IF TRIM$(block[i]) = "" THEN CONTINUE
        IF richtung > 0 THEN
            block[i] = "    " + block[i]
        ELSE
            DIM weg AS INTEGER : weg = 0
            WHILE weg < 4 AND weg < LEN(block[i]) AND MID$(block[i], weg, 1) = " " : weg = weg + 1 : WEND
            block[i] = MID$(block[i], weg)
        END IF
    NEXT
    zeilenErsetzen(ta, z1, z2, block)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
END SUB

' Umschalt+Alt+F: derselbe Formatierer wie `dhrt fmt` -- Schluesselwoerter
' gross, Bloecke eingerueckt, Leerraum am Zeilenende weg.
SUB formatieren()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM text AS STRING : text = GUI_TEXT(ta)
    DIM neu AS STRING : neu = CODE_FORMAT$(text)
    IF neu = "" AND TRIM$(text) <> "" THEN
        GUI_SET_TEXT(lblStatus, "Nicht formatiert: die Quelle laesst sich nicht lesen (Syntaxfehler, siehe Probleme).")
        RETURN
    END IF
    IF RIGHT$(text, 1) = NL THEN neu = neu + NL
    IF neu = text THEN GUI_SET_TEXT(lblStatus, "Schon formatiert.") : RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    GUI_TEXTAREA_SELECT(ta, 1, 1, LEN(SPLIT$(text, NL)), SPALTE_ENDE)
    GUI_TEXTAREA_INSERT(ta, neu)
    GUI_TEXTAREA_GOTO(ta, z, s)
    GUI_SET_TEXT(lblStatus, "Formatiert.")
    protokoll("formatiert")
END SUB

' --- Export als eigenstaendiges Programm (dhrt --export) ----------------
SUB exportieren()
    IF aktiverTab < 0 THEN RETURN
    IF exportProzess >= 0 THEN GUI_SET_TEXT(lblStatus, "Ein Export laeuft noch.") : RETURN
    IF tabPfade[aktiverTab] = "" OR GUI_TEXT(tabFelder[aktiverTab]) <> tabGesichert[aktiverTab] THEN
        IF NOT sichern(aktiverTab, FALSE) THEN RETURN
    END IF
    exportDatei = tabPfade[aktiverTab]
    exportProzess = PROCESS_START("dhrt", "--export", exportDatei)
    GUI_SET_TEXT(lblStatus, "Export laeuft: " + BASENAME(exportDatei) + " ...")
    protokoll("export " + exportDatei)
END SUB

SUB exportNachsehen()
    IF exportProzess < 0 THEN RETURN
    DIM t AS STRING : t = PROCESS_READ$(exportProzess) + PROCESS_ERR$(exportProzess)
    IF t <> "" THEN ausgabeVerteilen(t)
    IF PROCESS_RUNNING(exportProzess) THEN RETURN
    DIM code AS INTEGER : code = PROCESS_CODE(exportProzess)
    PROCESS_CLOSE(exportProzess)
    exportProzess = -1
    DIM stamm AS STRING : stamm = BASENAME(exportDatei)
    IF LOWER$(RIGHT$(stamm, 3)) = ".dh" THEN stamm = LEFT$(stamm, LEN(stamm) - 3)
    DIM ziel AS STRING : ziel = PATHJOIN(DIRNAME(exportDatei), stamm + "_dist")
    IF code = 0 THEN
        GUI_SET_TEXT(lblStatus, "Exportiert nach " + ziel)
    ELSE
        GUI_SET_TEXT(lblStatus, "Export fehlgeschlagen (Code " + STR$(code) + ") -- siehe Ausgabe.")
    END IF
    protokoll("exportiert " + STR$(code) + " " + ziel)
END SUB

' --- Ausfuehren --------------------------------------------------------
SUB ausgabe(zeile AS STRING)
    GUI_LISTBOX_ADD(lstAusgabe, zeile)
    IF GUI_LISTBOX_COUNT(lstAusgabe) > 2000 THEN GUI_LISTBOX_REMOVE(lstAusgabe, 0)
    GUI_LISTBOX_SET_SELECTED(lstAusgabe, GUI_LISTBOX_COUNT(lstAusgabe) - 1)
END SUB

DIM ausgabeRest AS STRING : ausgabeRest = ""

SUB ausgabeVerteilen(text AS STRING)
    IF text = "" THEN RETURN
    ausgabeRest = ausgabeRest + text
    WHILE INSTR(ausgabeRest, NL) >= 0
        DIM p AS INTEGER : p = INSTR(ausgabeRest, NL)
        DIM z AS STRING : z = LEFT$(ausgabeRest, p)
        z = REPLACE$(z, CHR$(13), "")
        ausgabe(z)
        ausgabeRest = MID$(ausgabeRest, p + 1)
    WEND
END SUB

' Ein Programm starten -- als Lauf, im Debugger oder unter dem Profiler.
' Alle drei sind derselbe Kindprozess mit einem anderen Unterbefehl.
FUNCTION prozessStarten(art AS STRING) AS BOOLEAN
    IF aktiverTab < 0 THEN RETURN FALSE
    IF prozess >= 0 THEN
        GUI_SET_TEXT(lblStatus, "Es laeuft noch ein Programm -- erst stoppen (Umschalt+F5).")
        RETURN FALSE
    END IF
    IF tabPfade[aktiverTab] = "" OR GUI_TEXT(tabFelder[aktiverTab]) <> tabGesichert[aktiverTab] THEN
        IF NOT sichern(aktiverTab, FALSE) THEN RETURN FALSE
    END IF
    GUI_LISTBOX_CLEAR(lstAusgabe)
    ausgabeRest = "" : prozessRest = ""
    prozessDatei = tabPfade[aktiverTab]
    prozessArt = art
    prozess = PROCESS_START("dhrt", art, prozessDatei)
    GUI_SET_TEXT(lblAusgabe, "Ausgabe: " + BASENAME(prozessDatei) + " laeuft ...")
    GUI_SET_TEXT(lblStatus, "Gestartet: " + prozessDatei)
    RETURN TRUE
END FUNCTION

SUB starten()
    IF prozessStarten("run") THEN protokoll("gestartet " + prozessDatei)
END SUB

SUB stoppen()
    IF prozess < 0 THEN RETURN
    IF prozessArt = "debug" AND debugPause THEN debugSenden("stop")
    PROCESS_KILL(prozess)
    fertigNachStopp = TRUE
END SUB

' --- Debugger: Client von `dhrt debug` (JSON-Zeilen: stdin Kommandos,
' stdout Ereignisse). Kommandos nimmt das Kind nur an, solange es steht.
SUB debuggen()
    IF NOT prozessStarten("debug") THEN RETURN
    debugPause = FALSE : debugErst = TRUE : debugZeile = 0
    GUI_SET_TEXT(lblDebug, "Debugger: laeuft ...")
    GUI_TABLE_CLEAR(tblVars)
    debugPanelZeigen(TRUE)
    protokoll("debug gestartet")
END SUB

SUB debugSenden(cmd AS STRING)
    IF prozess < 0 OR prozessArt <> "debug" THEN RETURN
    PROCESS_WRITE(prozess, "{" + CHR$(34) + "cmd" + CHR$(34) + ":" + CHR$(34) + cmd + CHR$(34) + "}" + NL)
END SUB

' Ein Text als JSON-Zeichenkette (mit Anfuehrungszeichen).
FUNCTION jsonText$(s AS STRING) AS STRING
    DIM j AS STRING : j = REPLACE$(s, "\", "\\")
    j = REPLACE$(j, CHR$(34), "\" + CHR$(34))
    RETURN CHR$(34) + j + CHR$(34)
END FUNCTION

SUB debugHaltepunkteSenden()
    IF prozess < 0 OR prozessArt <> "debug" THEN RETURN
    DIM liste AS STRING : liste = ""
    DIM bedingungen AS STRING : bedingungen = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF hpDateien[i] = prozessDatei THEN
            IF liste <> "" THEN liste = liste + ","
            liste = liste + STR$(hpZeilen[i])
            IF hpBedingungen[i] <> "" THEN
                IF bedingungen <> "" THEN bedingungen = bedingungen + ","
                bedingungen = bedingungen + jsonText$(STR$(hpZeilen[i])) + ":" + jsonText$(hpBedingungen[i])
            END IF
        END IF
    NEXT
    PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("set-breakpoints") + "," + jsonText$("lines") + ":[" + liste + "]," + jsonText$("conditions") + ":{" + bedingungen + "}}" + NL)
END SUB

' Ein Schritt-Kommando: nur, wenn das Kind steht.
SUB debugSchritt(cmd AS STRING)
    IF prozessArt <> "debug" OR NOT debugPause THEN
        GUI_SET_TEXT(lblStatus, "Der Debugger steht gerade nicht -- F7 startet ihn, F9 setzt einen Haltepunkt.")
        RETURN
    END IF
    debugSenden(cmd)
    debugPause = FALSE
    GUI_SET_TEXT(lblDebug, "Debugger: laeuft ...")
END SUB

SUB variablenZeigen(j AS JSON_HANDLE)
    GUI_TABLE_CLEAR(tblVars)
    DIM bereich AS STRING
    FOR EACH bereich IN ("locals", "globals")
        IF NOT JSON_HAS(j, bereich) THEN CONTINUE
        DIM n AS INTEGER : n = JSON_LEN(j, bereich)
        DIM i AS INTEGER
        FOR i = 0 TO n - 1
            DIM p AS STRING : p = bereich + "." + STR$(i)
            DIM wo AS STRING : wo = "lokal"
            IF bereich = "globals" THEN wo = "global"
            GUI_TABLE_ADD_ROW(tblVars, [JSON_GET_STRING(j, p + ".name"), JSON_GET_STRING(j, p + ".type"), JSON_GET_STRING(j, p + ".value"), wo])
        NEXT
    NEXT
END SUB

SUB debugEreignis(zeile AS STRING)
    IF LEFT$(zeile, 1) <> "{" THEN ausgabe(zeile) : RETURN
    DIM j AS JSON_HANDLE : j = JSON_PARSE(zeile)
    DIM ev AS STRING : ev = JSON_GET_STRING(j, "event")
    SELECT CASE ev
        CASE "output"
            ausgabeVerteilen(JSON_GET_STRING(j, "text"))
        CASE "paused"
            debugZeile = JSON_GET_INT(j, "line")
            IF debugErst THEN
                ' Der erste Halt ist die erste Zeile: jetzt kennt das Kind
                ' seine Haltepunkte. Gibt es welche, laeuft es bis dorthin;
                ' ohne Haltepunkte bleibt es stehen -- sonst saehe man nichts.
                debugErst = FALSE
                debugHaltepunkteSenden()
                DIM hat AS BOOLEAN : hat = FALSE
                DIM i AS INTEGER
                FOR i = 0 TO LEN(hpZeilen) - 1
                    IF hpDateien[i] = prozessDatei THEN hat = TRUE
                NEXT
                IF hat AND haltepunktIndex(prozessDatei, debugZeile) < 0 THEN debugSenden("continue") : RETURN
            END IF
            debugPause = TRUE
            variablenZeigen(j)
            GUI_SET_TEXT(lblDebug, "Debugger steht in Zeile " + STR$(debugZeile) + " (Tiefe " + STR$(JSON_GET_INT(j, "depth")) + ")")
            dateiOeffnen(prozessDatei)
            DIM ta AS GUI_WIDGET : ta = aktivesFeld()
            IF ta >= 0 THEN GUI_TEXTAREA_GOTO(ta, debugZeile, 1)
            protokoll("debug pause " + STR$(debugZeile))
        CASE "finished"
            ausgabe("-- Debugger: " + JSON_GET_STRING(j, "reason"))
            protokoll("debug beendet")
        CASE "error"
            debugZeile = JSON_GET_INT(j, "line")
            ausgabe("-- Fehler in Zeile " + STR$(debugZeile) + ": " + JSON_GET_STRING(j, "message"))
            protokoll("debug fehler " + STR$(debugZeile))
        CASE "eval-result"
            ausgabe("= " + JSON_GET_STRING(j, "value") + "   (" + JSON_GET_STRING(j, "type") + ")")
            protokoll("eval " + JSON_GET_STRING(j, "value"))
        CASE "eval-error"
            ausgabe("Fehler: " + JSON_GET_STRING(j, "message"))
    END SELECT
END SUB

' --- Profil: `dhrt profile` liefert am Ende EINE JSON-Zeile --------------
SUB profilAufnehmen()
    IF prozessStarten("profile") THEN protokoll("profil gestartet")
END SUB

SUB profilAnzeigen(zeile AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(zeile)
    ausgabeVerteilen(JSON_GET_STRING(j, "output"))
    DIM gesamt AS FLOAT : gesamt = JSON_GET_FLOAT(j, "total_time")
    DIM n AS INTEGER : n = JSON_LEN(j, "lines")
    DIM zl[MAX(n, 1)] AS INTEGER
    DIM za[MAX(n, 1)] AS INTEGER
    DIM zt[MAX(n, 1)] AS FLOAT
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = "lines." + STR$(i)
        zl[i] = JSON_GET_INT(j, p + ".line")
        za[i] = JSON_GET_INT(j, p + ".count")
        zt[i] = JSON_GET_FLOAT(j, p + ".time")
    NEXT
    ' Nach Zeit absteigend -- die teuerste Zeile zuerst.
    DIM k AS INTEGER
    FOR i = 0 TO n - 2
        DIM best AS INTEGER : best = i
        FOR k = i + 1 TO n - 1
            IF zt[k] > zt[best] THEN best = k
        NEXT
        IF best <> i THEN
            DIM t1 AS INTEGER : t1 = zl[i] : zl[i] = zl[best] : zl[best] = t1
            t1 = za[i] : za[i] = za[best] : za[best] = t1
            DIM t2 AS FLOAT : t2 = zt[i] : zt[i] = zt[best] : zt[best] = t2
        END IF
    NEXT
    DIM quelle AS ARRAY OF STRING : quelle = []
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 AND tabPfade[aktiverTab] = prozessDatei THEN quelle = SPLIT$(GUI_TEXT(ta), NL)
    GUI_TABLE_CLEAR(tblProfil)
    DIM pz AS ARRAY OF INTEGER : pz = []
    FOR i = 0 TO MIN(n, 300) - 1
        DIM anteil AS STRING : anteil = "-"
        IF gesamt > 0.0 THEN anteil = FORMAT$(zt[i] / gesamt * 100.0, "%.1f") + " %"
        DIM q AS STRING : q = ""
        IF zl[i] >= 1 AND zl[i] <= LEN(quelle) THEN q = TRIM$(quelle[zl[i] - 1])
        GUI_TABLE_ADD_ROW(tblProfil, [STR$(zl[i]), STR$(za[i]), FORMAT$(zt[i] * 1000.0, "%.2f"), anteil, q])
        ARRAY_PUSH(pz, zl[i])
    NEXT
    profilZeilen = pz
    GUI_SET_TEXT(lblProfil, BASENAME(prozessDatei) + ": " + FORMAT$(gesamt * 1000.0, "%.2f") + " ms gesamt, " + STR$(n) + " Zeilen gemessen")
    IF JSON_HAS(j, "error") THEN ausgabe("-- Fehler in Zeile " + STR$(JSON_GET_INT(j, "error_line")) + ": " + JSON_GET_STRING(j, "error"))
    GUI_WINDOW_VISIBLE(winProfil, TRUE)
    GUI_FOCUS(tblProfil)          ' holt das Fenster vor das Hauptfenster
    protokoll("profil " + STR$(n))
END SUB

SUB profilAnspringen()
    DIM r AS INTEGER : r = GUI_TABLE_SELECTED(tblProfil)
    IF r < 0 OR r >= LEN(profilZeilen) THEN RETURN
    dateiOeffnen(prozessDatei)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 THEN GUI_TEXTAREA_GOTO(ta, profilZeilen[r], 1) : GUI_FOCUS(ta)
END SUB

' stdout des Kindes: beim Lauf Text, beim Debugger Ereignisse, beim Profil
' am Ende die eine JSON-Zeile -- alles zeilenweise, halbe Zeilen warten.
SUB stdoutVerteilen(text AS STRING)
    IF text = "" THEN RETURN
    IF prozessArt = "run" THEN ausgabeVerteilen(text) : RETURN
    prozessRest = prozessRest + text
    WHILE INSTR(prozessRest, NL) >= 0
        DIM p AS INTEGER : p = INSTR(prozessRest, NL)
        DIM z AS STRING : z = REPLACE$(LEFT$(prozessRest, p), CHR$(13), "")
        prozessRest = MID$(prozessRest, p + 1)
        IF prozessArt = "debug" THEN
            debugEreignis(z)
        ELSEIF LEFT$(z, 1) = "{" AND INSTR(z, CHR$(34) + "total_time" + CHR$(34)) >= 0 THEN
            ' die eine Ergebniszeile des Profilers (Schluessel sortiert, also
            ' nicht am Anfang zu erkennen)
            profilAnzeigen(z)
        ELSE
            ausgabe(z)
        END IF
    WEND
END SUB

SUB prozessNachsehen()
    IF prozess < 0 THEN RETURN
    stdoutVerteilen(PROCESS_READ$(prozess))
    DIM err AS STRING : err = PROCESS_ERR$(prozess)
    IF err <> "" THEN ausgabeVerteilen(err)
    IF NOT PROCESS_RUNNING(prozess) THEN
        stdoutVerteilen(PROCESS_READ$(prozess))
        IF prozessRest <> "" THEN stdoutVerteilen(NL)
        IF ausgabeRest <> "" THEN ausgabe(ausgabeRest) : ausgabeRest = ""
        DIM code AS INTEGER : code = PROCESS_CODE(prozess)
        PROCESS_CLOSE(prozess)
        prozess = -1
        IF prozessArt = "debug" THEN
            debugPause = FALSE : debugZeile = 0
            debugPanelZeigen(FALSE)
        END IF
        IF fertigNachStopp THEN
            GUI_SET_TEXT(lblAusgabe, "Ausgabe: gestoppt")
            protokoll("gestoppt")
        ELSE
            GUI_SET_TEXT(lblAusgabe, "Ausgabe: beendet mit Code " + STR$(code))
            protokoll("beendet " + STR$(code))
        END IF
        fertigNachStopp = FALSE
        prozessArt = ""
    END IF
END SUB

' --- Handbuch: docs/*.md im Fenster -----------------------------------
FUNCTION wortUnterMarke$() AS STRING
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN ""
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN ""
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    ' Spalte ist 1-basiert und steht HINTER dem Zeichen links der Marke.
    DIM a AS INTEGER : a = s - 1
    DIM e AS INTEGER : e = s - 1
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    WHILE e < LEN(zeile) AND istWortzeichen(MID$(zeile, e, 1)) : e = e + 1 : WEND
    RETURN MID$(zeile, a, e - a)
END FUNCTION

FUNCTION istWortzeichen(c AS STRING) AS BOOLEAN
    IF c = "" THEN RETURN FALSE
    RETURN c = "_" OR c = "$" OR (c >= "a" AND c <= "z") OR (c >= "A" AND c <= "Z") OR (c >= "0" AND c <= "9")
END FUNCTION

SUB handbuchDokumente()
    IF LEN(docNamen) > 0 THEN RETURN
    docNamen = DIRLIST(docsOrdner, "*.md")
    GUI_SET_DROPDOWN(ddDoku, docNamen)
END SUB

SUB handbuchZeigen(datei AS STRING, zeile AS INTEGER)
    handbuchDokumente()
    DIM i AS INTEGER
    DIM k AS INTEGER : k = -1
    FOR i = 0 TO LEN(docNamen) - 1
        IF docNamen[i] = datei THEN k = i
    NEXT
    IF k < 0 THEN GUI_SET_TEXT(lblStatus, "Kein Handbuch gefunden in " + docsOrdner) : RETURN
    GUI_SET_TEXT(taHandbuch, dateiLesen(PATHJOIN(docsOrdner, datei)))
    GUI_DROPDOWN_SET_SELECTED(ddDoku, k)
    docLetzteWahl = k
    GUI_SET_TEXT(lblHbStand, datei)
    GUI_WINDOW_VISIBLE(winHandbuch, TRUE)
    GUI_TEXTAREA_GOTO(taHandbuch, MAX(zeile, 1), 1)
    GUI_FOCUS(taHandbuch)            ' holt das Fenster nach vorn
    protokoll("handbuch " + datei + " " + STR$(zeile))
END SUB

' F1: das Wort unter der Marke in allen Dokumenten suchen; das Dokument mit
' den meisten Fundstellen in Codeschrift (`WORT) gewinnt, sonst Klartext.
SUB handbuch()
    handbuchDokumente()
    IF LEN(docNamen) = 0 THEN GUI_SET_TEXT(lblStatus, "Kein Handbuch gefunden in " + docsOrdner) : RETURN
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF wort = "" THEN handbuchZeigen("README.md", 1) : RETURN
    DIM klein AS STRING : klein = LOWER$(wort)
    DIM besteDatei AS STRING : besteDatei = ""
    DIM besteZeile AS INTEGER : besteZeile = 1
    DIM besteZahl AS INTEGER : besteZahl = 0
    DIM d AS STRING
    FOR EACH d IN docNamen
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(docsOrdner, d))
        DIM zahl AS INTEGER : zahl = 0
        DIM erste AS INTEGER : erste = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            DIM lz AS STRING : lz = LOWER$(zeilen[i])
            IF LEFT$(lz, LEN(klein) + 3) = "| `" + klein THEN
                ' die Tabellenzeile, die den Befehl BESCHREIBT -- das Referenzdokument
                zahl = zahl + 10
                IF erste = 0 THEN erste = i + 1
            ELSEIF INSTR(lz, "`" + klein) >= 0 THEN
                zahl = zahl + 2
                IF erste = 0 THEN erste = i + 1
            ELSEIF INSTR(lz, klein) >= 0 THEN
                zahl = zahl + 1
                IF erste = 0 THEN erste = i + 1
            END IF
        NEXT
        IF zahl > besteZahl THEN besteZahl = zahl : besteDatei = d : besteZeile = erste
    NEXT
    IF besteDatei = "" THEN
        GUI_SET_TEXT(lblStatus, "'" + wort + "' steht in keinem Dokument.")
        handbuchZeigen("README.md", 1)
        RETURN
    END IF
    GUI_SET_TEXT(tfHbSuche, wort)
    handbuchZeigen(besteDatei, besteZeile)
END SUB

SUB handbuchSuchen()
    DIM gesucht AS STRING : gesucht = GUI_TEXT(tfHbSuche)
    IF gesucht = "" THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(taHandbuch)
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = GUI_TEXTAREA_FIND(taHandbuch, gesucht, z, s + 1)
    IF tz < 0 THEN (tz, ts) = GUI_TEXTAREA_FIND(taHandbuch, gesucht, 1, 1)
    IF tz < 0 THEN GUI_SET_TEXT(lblHbStand, "'" + gesucht + "' nicht in diesem Dokument") : RETURN
    GUI_TEXTAREA_GOTO(taHandbuch, tz, ts)
    GUI_TEXTAREA_SELECT(taHandbuch, tz, ts, tz, ts + LEN(gesucht))
    GUI_SET_TEXT(lblHbStand, docNamen[docLetzteWahl] + " -- Zeile " + STR$(tz))
END SUB

' --- Listing drucken / als PDF (pdf-Modul) -----------------------------
FUNCTION listingPdf() AS PDF
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    DIM name AS STRING : name = "Unbenannt"
    IF tabPfade[aktiverTab] <> "" THEN name = BASENAME(tabPfade[aktiverTab])
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM p AS PDF : p = PDF_NEW()
    PDF_TITLE(p, name)
    CONST BREITE = 92                   ' Zeichen je Zeile in Courier 9 pt auf A4
    CONST JE_SEITE = 66
    DIM reihe AS INTEGER : reihe = JE_SEITE
    DIM seite AS INTEGER : seite = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM rest AS STRING : rest = REPLACE$(zeilen[i], CHR$(9), "    ")
        DIM nummer AS STRING : nummer = RIGHT$("     " + STR$(i + 1), 5)
        DIM ersteHaelfte AS BOOLEAN : ersteHaelfte = TRUE
        REPEAT
            IF reihe >= JE_SEITE THEN
                ' PDF_NEW bringt die erste Seite schon mit -- ein PDF_PAGE davor
                ' liesse ein leeres Blatt vorn (so war es zuerst).
                IF seite > 0 THEN PDF_PAGE(p)
                seite = seite + 1
                PDF_FONT(p, "helvetica", 9)
                PDF_TEXT(p, 20, 12, name + "   Seite " + STR$(seite))
                PDF_LINE(p, 20, 15, 190, 15)
                PDF_FONT(p, "courier", 9)
                reihe = 0
            END IF
            DIM stueck AS STRING : stueck = LEFT$(rest, BREITE)
            rest = MID$(rest, LEN(stueck))
            DIM vorspann AS STRING : vorspann = nummer + "  "
            IF NOT ersteHaelfte THEN vorspann = "       "
            TRY
                PDF_TEXT(p, 20, 22 + reihe * 3.9, vorspann + stueck)
            CATCH e
                ' Ein Zeichen ausserhalb von cp1252 -- die Zeile kommt gekennzeichnet.
                PDF_TEXT(p, 20, 22 + reihe * 3.9, vorspann + "[Zeile mit Zeichen ausserhalb von cp1252]")
            END TRY
            reihe = reihe + 1
            ersteHaelfte = FALSE
        UNTIL rest = ""
    NEXT
    RETURN p
END FUNCTION

SUB listingAlsPdf()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, "Erst sichern -- die PDF kommt neben die Quelle.") : RETURN
    DIM ziel AS STRING : ziel = pfad
    IF LOWER$(RIGHT$(ziel, 3)) = ".dh" THEN ziel = LEFT$(ziel, LEN(ziel) - 3)
    ziel = ziel + ".pdf"
    DIM p AS PDF : p = listingPdf()
    PDF_SAVE(p, ziel)
    GUI_SET_TEXT(lblStatus, "PDF geschrieben: " + ziel + " (" + STR$(PDF_PAGE_COUNT(p)) + " Seiten)")
    PDF_CLOSE(p)
    protokoll("pdf " + ziel)
END SUB

' Strg+P oeffnet den Druckdialog: Drucker (Standard vorgewaehlt), Kopien,
' oder doch als PDF. Ohne Drucker gibt es gleich den PDF-Weg.
SUB listingDrucken()
    IF aktiverTab < 0 THEN RETURN
    druckerNamen = PRINTERS()
    IF LEN(druckerNamen) = 0 THEN GUI_SET_TEXT(lblStatus, "Kein Drucker eingerichtet -- nimm 'Listing als PDF'.") : RETURN
    GUI_SET_DROPDOWN(ddDrucker, druckerNamen)
    DIM k AS INTEGER : k = ARRAY_INDEXOF(druckerNamen, PRINTER_DEFAULT$())
    GUI_DROPDOWN_SET_SELECTED(ddDrucker, MAX(k, 0))
    GUI_WINDOW_SET_BOUNDS(winDruck, (SCREENWIDTH() - 400) \ 2, (SCREENHEIGHT() - 170) \ 2, 400, 170)
    GUI_WINDOW_VISIBLE(winDruck, TRUE)
    GUI_FOCUS(btnDruckOk)              ' holt das Fenster nach vorn
END SUB

SUB druckenAusfuehren()
    GUI_WINDOW_VISIBLE(winDruck, FALSE)
    IF aktiverTab < 0 THEN RETURN
    DIM sel AS INTEGER : sel = GUI_DROPDOWN_SELECTED(ddDrucker)
    IF sel < 0 OR sel >= LEN(druckerNamen) THEN RETURN
    DIM drucker AS STRING : drucker = druckerNamen[sel]
    DIM kopien AS INTEGER : kopien = MAX(1, INT(GUI_VALUE(spKopien)))
    DIM p AS PDF : p = listingPdf()
    TRY
        PDF_PRINT(p, drucker, kopien)
        GUI_SET_TEXT(lblStatus, "Gedruckt auf " + drucker + " (" + STR$(PDF_PAGE_COUNT(p)) + " Seiten, " + STR$(kopien) + "x)")
        protokoll("gedruckt " + drucker + " " + STR$(kopien))
    CATCH e
        GUI_SET_TEXT(lblStatus, "Drucken: " + e)
    END TRY
    PDF_CLOSE(p)
    GUI_FOCUS(aktivesFeld())
END SUB

' Strg+F1: alle Befehle mit Kuerzel im Handbuch-Fenster.
SUB kuerzelZeigen()
    DIM text AS STRING : text = "TASTENKUERZEL DER IDE" + NL + NL
    DIM i AS INTEGER
    FOR i = 0 TO LEN(befehlNamen) - 1
        IF befehlKuerzel[i] <> "" THEN text = text + LEFT$(befehlKuerzel[i] + "                    ", 20) + befehlNamen[i] + NL
    NEXT
    text = text + NL + "Im Code-Feld: Tab rueckt bis zur naechsten Spalte ein, Strg+Z/Y nimmt zurueck und wiederholt, Strg+A/C/V/X wie ueblich, Pos1/Ende, Bild auf/ab." + NL
    text = text + "Alle Befehle ohne Kuerzel stehen in der Befehlspalette (Strg+Umschalt+P)." + NL
    GUI_SET_TEXT(taHandbuch, text)
    GUI_SET_TEXT(lblHbStand, "Tastenkuerzel")
    GUI_WINDOW_VISIBLE(winHandbuch, TRUE)
    GUI_TEXTAREA_GOTO(taHandbuch, 1, 1)
    GUI_FOCUS(taHandbuch)
    protokoll("kuerzel " + STR$(LEN(befehlNamen)))
END SUB

' --- Werkzeuge: die Begleit-Editoren in Drachenhauch --------------------
SUB werkzeugStarten(datei AS STRING)
    DIM pfad AS STRING : pfad = PATHJOIN(beispielOrdner, datei)
    IF NOT FILEEXISTS(pfad) THEN
        GUI_SET_TEXT(lblStatus, "Nicht gefunden: " + pfad)
        protokoll("werkzeug fehlt " + datei)
        RETURN
    END IF
    ARRAY_PUSH(werkzeuge, PROCESS_START("dhrt", "run", pfad))
    GUI_SET_TEXT(lblStatus, "Gestartet: " + datei)
    protokoll("werkzeug " + datei)
END SUB

SUB werkzeugeAufraeumen()
    DIM i AS INTEGER : i = 0
    WHILE i < LEN(werkzeuge)
        IF PROCESS_RUNNING(werkzeuge[i]) THEN
            i = i + 1
        ELSE
            PROCESS_CLOSE(werkzeuge[i])
            ARRAY_REMOVE_AT(werkzeuge, i)
        END IF
    WEND
END SUB

SUB beispieleOeffnen()
    IF NOT FILEEXISTS(PATHJOIN(beispielOrdner, "01_hello.dh")) THEN
        GUI_SET_TEXT(lblStatus, "Keine Beispiele in " + beispielOrdner)
        RETURN
    END IF
    projektOrdner = beispielOrdner
    baumFuellen()
    GUI_SET_TEXT(lblStatus, "Projekt: " + beispielOrdner)
    protokoll("projekt " + projektOrdner)
END SUB

' --- Befehlspalette und Datei-Waehler ------------------------------------
' EINE Liste aller Befehle mit Kuerzel: Palette, Tastenkuerzel-Uebersicht.
SUB paletteEintrag(name AS STRING, kennung AS STRING, kuerzel AS STRING)
    ARRAY_PUSH(befehlNamen, name)
    ARRAY_PUSH(befehlKennungen, kennung)
    ARRAY_PUSH(befehlKuerzel, kuerzel)
END SUB

