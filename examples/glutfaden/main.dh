' Glutfaden -- Kreuzstich-Muster ansehen und bearbeiten. Eine Portierung von
' PySticky (Python + Qt) nach Drachenhauch, mit GTK 3 als Oberflaeche.
'
'     dhrt run main.dh                       (Beispielmuster)
'     dhrt run main.dh -- muster.pxs         (diese Datei)
'
' Stufe 1: Muster (.pxs) oeffnen und ansehen -- Zoom um den Mauszeiger (Rad,
' + / - / 0), Ebenen ein- und ausblenden, Farbliste mit Symbol und Stichzahl.
' Stufe 2: bearbeiten -- Stift, Radierer, Fuellen, Pipette, Linie, Rechteck,
' Ellipse, Hand (P E F I L R O M), Sticharten (Alt+1 .. Alt+0), Rueckgaengig
' (Strg+Z / Strg+Y) auch fuer Ebenen-Umbauten, Ebenen anlegen, loeschen,
' duplizieren, verschieben, zusammenfuehren, umbenennen, sperren, Deckkraft,
' Garne aus 19 Herstellerkatalogen, Sichern (Strg+S) mit Rueckfrage beim
' Schliessen.
' Stufe 3: Auswahl und Lasso (S, Umschalt+S; Strg+C/X/V/A, Entf, F, R drehen,
' H/V spiegeln), Vieleck (G), Text (T), Rueckstich (B), Fortschritt (K; Pfeile
' und Enter), Symmetrie, Farbe ersetzen (Strg+R) mit Toleranz, seltene Farben
' zusammenlegen, Symbol aendern, ganze Farbe als erledigt.
' Stufe 4: Bild importieren (Strg+I) -- Groesse, Palette, Farbzahl, die
' haeufigsten oder Median-Cut, Floyd-Steinberg oder Bayer, Confetti, Helligkeit/
' Kontrast/Saettigung, Konturen als Rueckstiche, Voreinstellungen, Ausschnitt
' aufziehen, Vorschau; erneut aus dem Quellbild (auch mit anderer Palette):
' Strg+Umschalt+I.
' Stufe 5: Exportieren (Strg+E) -- PDF-Anleitung (A4 bis A0, Letter; Diamond
' 1:1, Mystery, Wasserzeichen, Notizen, Entsprechungen anderer Hersteller),
' HTML-Anleitung, Bild, Open Cross Stitch (.oxs, auch zum Oeffnen) und ein
' Paket als ZIP. Ohne Passwortschutz.
' Stufe 6: echte PCStitch- (.pat) und Pattern-Maker-Muster (.xsd) oeffnen,
' Diamond Painting (Strg+D: die Farben wechseln in die Drill-Palette, zurueck
' kommen dieselben Garne), Tweed-Blends aus zwei Garnen (Strg+B).
'
' Aufbau:
'     kern/      Muster, Ebenen, Garne, Paletten, .pxs, Formen, Verlauf,
'                Bearbeiten -- ohne Oberflaeche, als Namensraum "kern"
'     gtk/       die Deklarationen fuer GTK, Cairo, Pango, GLib
'     ansicht/   Werkzeuge, Zeichenflaeche und Seitenleiste
'     daten/     Paletten, Symbole, Beispielmuster (aus PySticky, MIT-Lizenz,
'                siehe daten/LIZENZ-PySticky.txt), das Logo
'
' GTK muss da sein: unter Linux fast immer (libgtk-3-0), unter macOS ueber
' Homebrew (brew install gtk+3), unter Windows aus MSYS2 im PATH -- oder aus
' Inkscape. Mit --probe (bzw. --probe-bearbeiten, --probe-stufe3 .. 5) fuehrt
' sich das Programm selbst vor und endet; --foto
' ziel sichert dabei Bilder des Fensters (fuer Pruefungen).
IMPORT "kern/kern.dh" AS kern
IMPORT "gtk/gtk.dh"
IMPORT "ansicht/werkzeuge.dh"
IMPORT "ansicht/mehr.dh"
IMPORT "ansicht/text.dh"
IMPORT "ansicht/dialoge.dh"
IMPORT "ansicht/importdialog.dh"
IMPORT "ansicht/exportdialog.dh"
IMPORT "ansicht/stickpfaddialog.dh"
IMPORT "ansicht/leinwand.dh"
IMPORT "ansicht/seitenleiste.dh"

' Farben: dunkel wie das Logo, Glut (#ff8a3d) fuer alles, was gewaehlt ist
CONST STIL = "window, .flaeche { background-color: #1b1c20; color: #e4e5ea; }" + _
    " headerbar { background-image: linear-gradient(to bottom, #2c2e35, #22242a); border-bottom: 1px solid #0c0d10; color: #e4e5ea; box-shadow: none; }" + _
    " headerbar .title { font-weight: 700; color: #f2f3f7; } headerbar .subtitle { color: #9aa0ad; opacity: 1; }" + _
    " headerbar button, .werkzeugzeile button { background-image: none; background-color: transparent; border: none; border-radius: 8px; color: #d6d9e1; box-shadow: none; text-shadow: none; -gtk-icon-shadow: none; }" + _
    " headerbar button:hover, .werkzeugzeile button:hover { background-color: rgba(255,255,255,0.08); }" + _
    " headerbar button:disabled { opacity: 0.35; }" + _
    " .werkzeugzeile { background-color: #202228; border-bottom: 1px solid #0c0d10; padding: 3px 8px; }" + _
    " .werkzeugzeile button:checked { background-color: rgba(255,138,61,0.20); box-shadow: inset 0 -2px #ff8a3d; }" + _
    " .werkzeugzeile combobox button { background-image: none; background-color: #2a2c33; color: #d6d9e1; padding: 2px 8px; }" + _
    " .werkzeugzeile separator { background-color: #3a3c44; min-width: 1px; margin: 4px 2px; }" + _
    " .zoom { color: #c9ccd4; min-width: 52px; }" + _
    " .seitenleiste { background-color: #202228; border-left: 1px solid #0c0d10; }" + _
    " .seitenleiste list, .seitenleiste row { background-color: transparent; color: #d6d9e1; }" + _
    " .seitenleiste row:selected { background-color: rgba(255,138,61,0.22); }" + _
    " .seitenleiste row:selected label { color: #ffffff; }" + _
    " .ueberschrift { color: #8d93a1; font-weight: 700; font-size: 9pt; margin: 14px 14px 4px 14px; }" + _
    " .farbzeile { padding: 3px 14px; }" + _
    " .farbzeile label { color: #d6d9e1; } .nebensache { color: #8d93a1; } .wert { color: #ff8a3d; } .benutzt { color: #ffb27a; }" + _
    " .ebene { padding: 2px 10px; color: #d6d9e1; }" + _
    " .innen { margin: 2px 14px; }" + _
    " .seitenleiste entry, .seitenleiste combobox button { background-image: none; background-color: #2a2c33; color: #e4e5ea; border: 1px solid #3a3c44; box-shadow: none; text-shadow: none; }" + _
    " .werkzeugzeile combobox cellview, .werkzeugzeile combobox button label, .seitenleiste combobox cellview, .seitenleiste combobox button label { color: #e4e5ea; }" + _
    " .abschnitt { font-weight: 700; margin-top: 4px; }" + _
    " button.klein { background-image: none; background-color: #2a2c33; color: #d6d9e1; border: 1px solid #3a3c44; border-radius: 6px; padding: 2px 6px; box-shadow: none; text-shadow: none; }" + _
    " button.klein:hover { background-color: #33363e; }" + _
    " button.schloss { background-image: none; background-color: transparent; border: none; box-shadow: none; padding: 2px; min-height: 0; min-width: 0; }" + _
    " scale trough { background-color: #33363e; } scale highlight { background-color: #ff8a3d; } scale value { color: #8d93a1; }" + _
    " .status { background-color: #16171b; color: #9aa0ad; padding: 4px 12px; border-top: 1px solid #0c0d10; font-size: 9pt; }"

CONST LOGO = "daten/bilder/glutfaden_256.png"
CONST LOGO_KLEIN = "daten/bilder/glutfaden_32.png"

DIM fenster AS INTEGER
DIM kopf AS INTEGER
DIM zoomText AS INTEGER
DIM status AS INTEGER
DIM kZurueck AS INTEGER
DIM kVor AS INTEGER
DIM kSichern AS INTEGER
DIM kModus AS INTEGER
DIM musterPfad AS STRING
DIM musterTitel AS STRING
DIM extraGeaendert AS BOOLEAN         ' Sichtbarkeit, Sperre, Deckkraft (kein Schritt)
DIM meldung AS STRING
DIM meldungZeit AS INTEGER
DIM schliessenErlaubt AS BOOLEAN

' --- Was andere Teile rufen ---------------------------------------------------------

' Statuszeile und Zoom nachfuehren -- die Zeichenflaeche und die Werkzeuge rufen das.
SUB statusNachziehen()
    IF zoomText = 0 THEN RETURN
    gtk_label_set_text(zoomText, STR$(leinwandZoomProzent()) + " %")
    IF NOT lwHat THEN RETURN
    DIM t AS STRING
    IF meldung <> "" AND MILLIS() - meldungZeit < 5000 THEN t = meldung + "   ·   "
    t = t + wzKurzname$(wzAktiv) + ", " + wzStichartName$(wzStichart)
    IF wzSpiegel > 0 THEN t = t + ", " + spiegelName$(wzSpiegel)
    IF NOT (mrAuswahl IS NIL) THEN t = t + ", Auswahl " + STR$(mrAuswahl.anzahl)
    IF wzFarbe >= 0 AND wzFarbe < lwMuster.farbanzahl() THEN
        DIM gf AS kern.Garn : gf = lwMuster.farben[wzFarbe].garn
        t = t + ", " + TRIM$(gf.hersteller + " " + gf.nummer)
    END IF
    t = t + " auf „" + lwMuster.ebenen.aktiveEbene().name + "“   ·   "
    t = t + STR$(lwMuster.breite) + " × " + STR$(lwMuster.hoehe) + " Stiche, " + _
        ZAHL$(lwMuster.breiteCm(), 1) + " × " + ZAHL$(lwMuster.hoeheCm(), 1) + " cm auf " + ZAHL$(lwMuster.stoff, 0) + "er Stoff"
    IF lwMausX >= 0 THEN
        t = t + "   ·   Stich " + STR$(lwMausX + 1) + ", " + STR$(lwMausY + 1)
        DIM c AS INTEGER : c = lwFarbe[lwMausY * lwMuster.breite + lwMausX]
        IF c >= 0 AND c < lwMuster.farbanzahl() THEN
            DIM g AS kern.Garn : g = lwMuster.farben[c].garn
            t = t + ": " + TRIM$(g.hersteller + " " + g.nummer) + " " + g.name
        END IF
    END IF
    gtk_label_set_text(status, t)
END SUB

FUNCTION wzKurzname$(nr AS INTEGER) AS STRING
    DIM n AS STRING : n = wzName$(nr)
    DIM p AS INTEGER : p = INSTR(n, " (")
    IF p >= 0 THEN n = LEFT$(n, p)
    IF wzKannGefuellt(nr) AND wzGefuellt THEN n = n + " gefüllt"
    RETURN n
END FUNCTION

' Eine Meldung, die ein paar Sekunden vorne in der Statuszeile steht.
SUB statusMeldung(text AS STRING)
    meldung = text
    meldungZeit = MILLIS()
    statusNachziehen()
END SUB

FUNCTION istGeaendert() AS BOOLEAN
    RETURN wzVerlauf.geaendert() OR extraGeaendert
END FUNCTION

' Titel (mit • fuer Ungesichertes) und die Knoepfe Zurueck/Vor.
SUB zustandNachziehen()
    IF kopf = 0 OR NOT lwHat THEN RETURN
    gtk_header_bar_set_title(kopf, musterTitel + IIF(istGeaendert(), " •", ""))
    gtk_header_bar_set_subtitle(kopf, BASENAME(musterPfad) + "  ·  " + STR$(lwMuster.farbanzahl()) + " Farben  ·  " + ZAHL$(lwMuster.sticheGesamt(), 0) + " Stiche")
    gtk_widget_set_sensitive(kZurueck, wzVerlauf.kannZurueck())
    gtk_widget_set_sensitive(kVor, wzVerlauf.kannVor())
    gtk_widget_set_tooltip_text(kZurueck, IIF(wzVerlauf.kannZurueck(), "Rückgängig: " + wzVerlauf.textZurueck$() + " (Strg+Z)", "Nichts zurückzunehmen"))
    gtk_widget_set_tooltip_text(kVor, IIF(wzVerlauf.kannVor(), "Wiederholen: " + wzVerlauf.textVor$() + " (Strg+Y)", "Nichts zu wiederholen"))
END SUB

SUB extraAenderung()
    extraGeaendert = TRUE
    zustandNachziehen()
END SUB

' Nach einem Strich oder einer Form: Zahlen, Titel, Status.
SUB nachAenderung()
    seitenleisteZahlen()
    zustandNachziehen()
    statusNachziehen()
END SUB

' Nach Rueckgaengig und Umbauten: Bild und Seitenleiste ganz neu.
SUB allesNeu()
    IF wzFarbe >= lwMuster.farbanzahl() THEN wzFarbe = -1
    leinwandAufbauen()
    seitenleisteMuster(lwMuster)
    gtk_widget_queue_draw(lwFlaeche)
    IF wzFarbeLeiste <> 0 THEN gtk_widget_queue_draw(wzFarbeLeiste)
    zustandNachziehen()
    statusNachziehen()
END SUB

' Ein Text vom Benutzer; "" bei Abbrechen.
FUNCTION textFragen(titel AS STRING, frage AS STRING, vorgabe AS STRING) AS STRING
    DIM d AS INTEGER : d = gtk_dialog_new_with_buttons(titel, fenster, GTK_DIALOG_MODAL BOR GTK_DIALOG_EIGENE_LEISTE, _
        "Abbrechen", GTK_ANTWORT_ABBRECHEN, "OK", GTK_ANTWORT_OK, 0)
    gtk_dialog_set_default_response(d, GTK_ANTWORT_OK)
    DIM innen AS INTEGER : innen = gtk_dialog_get_content_area(d)
    gtk_container_set_border_width(innen, 12)
    DIM l AS INTEGER : l = gtk_label_new(frage)
    gtk_label_set_xalign(l, 0.0)
    DIM feld AS INTEGER : feld = gtk_entry_new()
    gtk_entry_set_text(feld, vorgabe)
    gtk_entry_set_activates_default(feld, TRUE)
    gtk_box_pack_start(innen, l, FALSE, FALSE, 4)
    gtk_box_pack_start(innen, feld, FALSE, FALSE, 4)
    gtk_widget_show_all(d)
    DIM ergebnis AS STRING
    IF gtk_dialog_run(d) = GTK_ANTWORT_OK THEN ergebnis = TRIM$(gtk_entry_get_text(feld))
    gtk_widget_destroy(d)
    RETURN ergebnis
END FUNCTION

' --- Oeffnen und sichern -------------------------------------------------------------

FUNCTION musterOeffnen(pfad AS STRING) AS BOOLEAN
    DIM m AS kern.Muster
    DIM fremdHinweis AS STRING
    DIM endung AS STRING : endung = LOWER$(RIGHT$(pfad, 4))
    DIM fremd AS BOOLEAN : fremd = endung = ".oxs" OR endung = ".pat" OR endung = ".xsd"
    TRY
        ' ein fremdes Format: eingelesen, gesichert wird als .pxs
        DIM warnungen AS ARRAY OF STRING : warnungen = []
        IF endung = ".oxs" THEN
            DIM imp AS kern.OxsImport : imp = kern.oxsLaden(pfad, slPaletten, slSymbole)
            m = imp.muster
            warnungen = imp.warnungen
            fremdHinweis = "Aus OXS eingelesen -- Sichern legt eine .pxs an."
        ELSEIF endung = ".pat" THEN
            DIM pimp AS kern.PatImport : pimp = kern.patLaden(pfad, slPaletten, slSymbole)
            m = pimp.muster
            warnungen = pimp.warnungen
            fremdHinweis = "Aus PCStitch eingelesen -- Sichern legt eine .pxs an."
        ELSEIF endung = ".xsd" THEN
            DIM ximp AS kern.XsdImport : ximp = kern.xsdLaden(pfad, slPaletten, slSymbole)
            m = ximp.muster
            warnungen = ximp.warnungen
            fremdHinweis = "Aus Pattern Maker eingelesen -- Sichern legt eine .pxs an."
        ELSE
            m = kern.pxsLaden(pfad)
        END IF
        IF LEN(warnungen) > 0 THEN fremdHinweis = fremdHinweis + " " + JOIN$(warnungen, " ")
    CATCH e
        statusMeldung("Nicht geöffnet: " + e)
        RETURN FALSE
    END TRY
    musterPfad = IIF(fremd, "", pfad)
    musterTitel = IIF(m.name <> "", m.name, BASENAME(pfad))
    wzVerlauf.leeren()
    extraGeaendert = FALSE
    wzFarbe = IIF(m.farbanzahl() > 0, 0, -1)
    leinwandMuster(m)
    seitenleisteMuster(m)
    modusKnopfNachziehen()
    zustandNachziehen()
    statusNachziehen()
    IF fremdHinweis <> "" THEN statusMeldung(fremdHinweis)
    RETURN TRUE
END FUNCTION

FUNCTION musterSichern(pfad AS STRING) AS BOOLEAN
    IF pfad = "" THEN pfad = dateiWaehlen(TRUE)
    IF pfad = "" THEN RETURN FALSE
    TRY
        kern.pxsSpeichern(lwMuster, pfad)
    CATCH e
        statusMeldung("Nicht gesichert: " + e)
        RETURN FALSE
    END TRY
    musterPfad = pfad
    wzVerlauf.alsGesichert()
    extraGeaendert = FALSE
    zustandNachziehen()
    statusMeldung("Gesichert: " + BASENAME(pfad))
    RETURN TRUE
END FUNCTION

' Einen Pfad waehlen; "" bei Abbrechen.
FUNCTION dateiWaehlen(sichern AS BOOLEAN) AS STRING
    DIM d AS INTEGER
    IF sichern THEN
        d = gtk_file_chooser_dialog_new("Muster sichern unter", fenster, GTK_DATEI_SICHERN, _
            "Abbrechen", GTK_ANTWORT_ABBRECHEN, "Sichern", GTK_ANTWORT_ANNEHMEN, 0)
        gtk_file_chooser_set_do_overwrite_confirmation(d, TRUE)
        DIM ok AS BOOLEAN
        IF musterPfad = "" THEN
            ' frisch importiert: neben das Quellbild, unter seinem Namen
            gtk_file_chooser_set_current_name(d, musterTitel + ".pxs")
            IF lwHat THEN
                IF lwMuster.quellBild <> "" THEN ok = gtk_file_chooser_set_current_folder(d, DIRNAME(lwMuster.quellBild))
            END IF
        ELSE
            gtk_file_chooser_set_current_name(d, BASENAME(musterPfad))
            ok = gtk_file_chooser_set_current_folder(d, DIRNAME(musterPfad))
        END IF
    ELSE
        d = gtk_file_chooser_dialog_new("Muster öffnen", fenster, GTK_DATEI_OEFFNEN, _
            "Abbrechen", GTK_ANTWORT_ABBRECHEN, "Öffnen", GTK_ANTWORT_ANNEHMEN, 0)
    END IF
    DIM filter AS INTEGER : filter = gtk_file_filter_new()
    gtk_file_filter_set_name(filter, IIF(sichern, "Kreuzstich-Muster (*.pxs)", "Kreuzstich-Muster (*.pxs, *.oxs, *.pat, *.xsd)"))
    gtk_file_filter_add_pattern(filter, "*.pxs")
    IF NOT sichern THEN
        gtk_file_filter_add_pattern(filter, "*.oxs")
        gtk_file_filter_add_pattern(filter, "*.pat")
        gtk_file_filter_add_pattern(filter, "*.xsd")
    END IF
    gtk_file_chooser_add_filter(d, filter)
    DIM pfad AS STRING
    IF gtk_dialog_run(d) = GTK_ANTWORT_ANNEHMEN THEN
        DIM z AS INTEGER : z = gtk_file_chooser_get_filename(d)
        pfad = TEXT_AUS_ZEIGER$(z)
        g_free(z)
    END IF
    gtk_widget_destroy(d)
    IF sichern AND pfad <> "" AND LOWER$(RIGHT$(pfad, 4)) <> ".pxs" THEN pfad = pfad + ".pxs"
    RETURN pfad
END FUNCTION

' Ungesichertes? Sichern, Verwerfen oder Abbrechen. TRUE = weitermachen.
FUNCTION ungesichertFragen(was AS STRING) AS BOOLEAN
    IF NOT istGeaendert() THEN RETURN TRUE
    DIM d AS INTEGER : d = gtk_message_dialog_new(fenster, GTK_DIALOG_MODAL, GTK_NACHRICHT_FRAGE, GTK_KNOEPFE_KEINE, _
        "%s", "„" + musterTitel + "“ hat ungesicherte Änderungen.")
    gtk_message_dialog_format_secondary_text(d, "%s", "Vor dem " + was + " sichern?")
    DIM k AS INTEGER
    k = gtk_dialog_add_button(d, "Verwerfen", 2)
    k = gtk_dialog_add_button(d, "Abbrechen", GTK_ANTWORT_ABBRECHEN)
    k = gtk_dialog_add_button(d, "Sichern", 1)
    gtk_dialog_set_default_response(d, 1)
    DIM a AS INTEGER : a = gtk_dialog_run(d)
    gtk_widget_destroy(d)
    IF a = 1 THEN RETURN musterSichern(musterPfad)
    RETURN a = 2
END FUNCTION

SUB oeffnenGeklickt(knopf AS INTEGER, daten AS INTEGER)
    IF NOT ungesichertFragen("Öffnen") THEN RETURN
    DIM pfad AS STRING : pfad = dateiWaehlen(FALSE)
    IF pfad <> "" THEN
        DIM ok AS BOOLEAN : ok = musterOeffnen(pfad)
    END IF
END SUB

SUB sichernGeklickt(knopf AS INTEGER, daten AS INTEGER)
    IF lwHat THEN
        DIM ok AS BOOLEAN : ok = musterSichern(musterPfad)
    END IF
END SUB

SUB exportGeklickt(knopf AS INTEGER, daten AS INTEGER) : exportDialog() : END SUB
SUB pfadGeklickt(knopf AS INTEGER, daten AS INTEGER) : stickpfadDialog() : END SUB

' Kreuzstich <-> Diamond Painting (Strg+D, PySticky "Diamond-Painting-Ansicht").
' Wie dort ist der Wechsel kein Schritt im Verlauf -- der Verlauf wird geleert,
' weil er die alten Stichtypen haelt; Strg+D noch einmal holt die Garne genau
' zurueck (der gemerkte Stand in mode_backups).
SUB modusUmschalten()
    IF NOT lwHat THEN RETURN
    DIM ziel AS STRING : ziel = IIF(lwMuster.modus = "diamond", "stitch", "diamond")
    DIM ok AS BOOLEAN : ok = kern.modusWechseln(lwMuster, ziel, slPaletten)
    wzVerlauf.leeren()
    mrAblage = NIL
    extraGeaendert = TRUE
    allesNeu()
    modusKnopfNachziehen()
    statusMeldung(IIF(ziel = "diamond", "Diamond Painting -- die Farben sind jetzt Drills der Palette DMC Diamond Painting (Strg+D zurück).", "Kreuzstich -- die Garne von vorher sind zurück (Strg+D: wieder Diamond Painting)."))
END SUB

SUB modusGeklickt(knopf AS INTEGER, daten AS INTEGER) : modusUmschalten() : END SUB

SUB modusKnopfNachziehen()
    IF kModus = 0 THEN RETURN
    DIM dp AS BOOLEAN : dp = lwHat
    IF dp THEN dp = lwMuster.modus = "diamond"
    gtk_button_set_label(kModus, IIF(dp, "◆ Diamond", "✕ Kreuzstich"))
END SUB

SUB sichernUnter()
    IF NOT lwHat THEN RETURN
    DIM pfad AS STRING : pfad = dateiWaehlen(TRUE)
    IF pfad <> "" THEN
        DIM ok AS BOOLEAN : ok = musterSichern(pfad)
    END IF
END SUB

SUB zurueckGeklickt(knopf AS INTEGER, daten AS INTEGER) : werkzeugZurueck() : END SUB
SUB vorGeklickt(knopf AS INTEGER, daten AS INTEGER) : werkzeugVor() : END SUB
SUB kleinerGeklickt(knopf AS INTEGER, daten AS INTEGER) : leinwandZoomMitte(1 / 1.25) : END SUB
SUB groesserGeklickt(knopf AS INTEGER, daten AS INTEGER) : leinwandZoomMitte(1.25) : END SUB
SUB einpassenGeklickt(knopf AS INTEGER, daten AS INTEGER) : leinwandEinpassen() : END SUB
SUB fensterZu(objekt AS INTEGER, daten AS INTEGER) : gtk_main_quit() : END SUB

' Das Kreuz: bei Ungesichertem erst fragen. TRUE haelt das Fenster offen.
FUNCTION schliessenAngefragt(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    IF schliessenErlaubt THEN RETURN FALSE
    RETURN NOT ungesichertFragen("Schließen")
END FUNCTION

SUB ueberGeklickt(knopf AS INTEGER, daten AS INTEGER)
    DIM f AS INTEGER
    DIM bild AS INTEGER : bild = gdk_pixbuf_new_from_file_at_size(PATHJOIN(CWD$(), LOGO), 128, 128, f)
    IF bild = 0 THEN g_error_free(f)
    gtk_show_about_dialog(fenster, "program-name", "Glutfaden", "logo", bild, "version", "Stufe 6", _
        "comments", "Kreuzstich-Muster ansehen und bearbeiten -- eine Portierung von PySticky nach Drachenhauch und GTK 3.", _
        "website", "https://github.com/HasoSchno70/Pysticky", "website-label", "PySticky (das Original)", 0)
END SUB

FUNCTION taste(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM t AS INTEGER
    IF NOT gdk_event_get_keyval(ereignis, t) THEN RETURN FALSE
    DIM z AS INTEGER
    DIM ok AS BOOLEAN : ok = gdk_event_get_state(ereignis, z)
    DIM strg AS BOOLEAN : strg = (z BAND GDK_STRG) <> 0
    DIM umschalt AS BOOLEAN : umschalt = (z BAND GDK_UMSCHALT) <> 0
    DIM alt AS BOOLEAN : alt = (z BAND GDK_ALT) <> 0
    ' Im Suchfeld gehoeren Kopieren/Einfuegen/Alles dem Feld
    IF strg AND gtk_widget_has_focus(slSuche) THEN
        IF t = &H63 OR t = &H43 OR t = &H78 OR t = &H58 OR t = &H76 OR t = &H56 OR t = &H61 OR t = &H41 THEN RETURN FALSE
    END IF
    IF strg THEN
        SELECT CASE t
            CASE &H7A, &H5A                                      ' Strg+Z, Strg+Umschalt+Z
                IF umschalt THEN werkzeugVor() ELSE werkzeugZurueck()
            CASE &H79, &H59 : werkzeugVor()                      ' Strg+Y
            CASE &H73, &H53                                      ' Strg+S, Strg+Umschalt+S
                IF umschalt THEN
                    sichernUnter()
                ELSEIF lwHat THEN
                    ok = musterSichern(musterPfad)
                END IF
            CASE &H6F, &H4F                                      ' Strg+O, Strg+Umschalt+O
                IF umschalt THEN stickpfadDialog() ELSE oeffnenGeklickt(0, 0)
            CASE &H63, &H43 : auswahlKopieren()                  ' Strg+C
            CASE &H78, &H58 : auswahlAusschneiden()              ' Strg+X
            CASE &H76, &H56 : einfuegenBeginnen()                ' Strg+V
            CASE &H61, &H41 : auswahlAlles()                     ' Strg+A
            CASE &H72, &H52 : farbeErsetzenDialog()              ' Strg+R
            CASE &H65, &H45 : exportDialog()                     ' Strg+E
            CASE &H64, &H44 : modusUmschalten()                  ' Strg+D
            CASE &H62, &H42 : blendDialog()                      ' Strg+B
            CASE &H69, &H49                                      ' Strg+I, Strg+Umschalt+I
                IF umschalt THEN bildNeuImportieren() ELSE bildImportieren()
            CASE &H6E, &H4E                                      ' Strg+Umschalt+N
                IF NOT umschalt THEN RETURN FALSE
                ebenenBefehl(0)
            CASE ELSE : RETURN FALSE
        END SELECT
        RETURN TRUE
    END IF
    ' Im Suchfeld gehoeren Buchstaben dem Feld
    IF gtk_widget_has_focus(slSuche) THEN RETURN FALSE
    IF werkzeugTaste(t, FALSE, alt) THEN RETURN TRUE
    IF alt THEN RETURN FALSE
    SELECT CASE t
        CASE &H2B, &H3D, &HFFAB : leinwandZoomMitte(1.25)          ' + = (Ziffernblock +)
        CASE &H2D, &HFFAD : leinwandZoomMitte(1 / 1.25)            ' - (Ziffernblock -)
        CASE &H30, &HFFB0 : leinwandEinpassen()                     ' 0
        CASE &H31 : leinwandZoomMitte(LW_ZELLE_STANDARD / lwZelle)  ' 1 = 100 %
        CASE ELSE : RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

FUNCTION knopf(symbol AS STRING, tipp AS STRING) AS INTEGER
    DIM k AS INTEGER : k = gtk_button_new_from_icon_name(symbol, GTK_ICON_KNOPF)
    gtk_widget_set_tooltip_text(k, tipp)
    gtk_widget_set_can_focus(k, FALSE)
    RETURN k
END FUNCTION

' --- Aufbau -------------------------------------------------------------------------
DIM bereit AS BOOLEAN
TRY
    bereit = gtk_init_check(0, 0)
CATCH e
    PRINT "GTK nicht gefunden -- unter Linux das Paket libgtk-3-0, unter macOS brew install gtk+3, unter Windows GTK aus MSYS2 in den PATH oder Inkscape installieren."
    END
END TRY
IF NOT bereit THEN
    PRINT "GTK ist da, findet aber keinen Bildschirm."
    END
END IF
DIM stilFehler AS STRING : stilFehler = gtkStil$(STIL)
IF stilFehler <> "" THEN PRINT "Stylesheet: "; stilFehler
werkzeugeStart()

fenster = gtk_window_new(0)
