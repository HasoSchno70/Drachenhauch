' Textfeld bequem und Textbereich mit Inline-Formaten (2026-09-23).
' Textfeld: Doppelklick waehlt das Wort, Dreifachklick alles (im
' Passwortfeld schon der Doppelklick), ein Rechtsklick setzt die Marke und
' laesst eine getroffene Auswahl stehen. Was gewaehlt ist, verraet die
' Ruecktaste danach -- ein Textfeld hat keine Auswahl-Abfrage.
' Textbereich: GUI_TEXTAREA_SET "formatiert", Strg+B/I/U auf die Auswahl
' oder fuer das naechste Getippte, GUI_TEXTAREA_STYLE/GET_STYLE$/MARKDOWN$/
' SET_MARKDOWN, Verlauf und .dhform. Getippt wird ueber die Zwischenablage
' (Strg+V) -- die Wiedergabe fuellt keine Zeichenwarteschlange.
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

=== textfeld: doppelklick waehlt das wort
IMPORT "gui"
IMPORT "tf.dh"
SCREEN(300, 120, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 120)
GUI_WINDOW_CHROME(w, FALSE)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 10, 10, 280, 28)
GUI_SET_TEXT(tf, "eins zwei drei")
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 2 THEN klicks(15 + TEXT_WIDTH("eins zw"), 2, 0)
    IF bild = 20 THEN PRINT "[" + GUI_TEXT(tf) + "]"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei tf.dh
' n Klicks mit Knopf k bei x (y = 24), danach die Ruecktaste.
SUB klicks(x AS INTEGER, n AS INTEGER, k AS INTEGER)
    DIM a AS STRING : a = "e 0 7 " + STR$(x) + " 24 0 0" + CHR$(10)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        a = a + "e " + STR$(1 + 2 * i) + " 6 " + STR$(k) + " 0 0 0" + CHR$(10)
        a = a + "e " + STR$(2 + 2 * i) + " 5 " + STR$(k) + " 0 0 0" + CHR$(10)
    NEXT
    a = a + "e 12 2 259 0 0 0" + CHR$(10) + "e 13 1 259 0 0 0" + CHR$(10)
    WRITEALL("ev.txt", "c " + STR$(3 + 2 * n) + CHR$(10) + a)
    AUTOMATION_PLAY("ev.txt")
END SUB

