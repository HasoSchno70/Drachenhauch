=== esc schliesst den popover und nicht das fenster
' Der Fokus liegt im Hauptfenster, dessen Abbrechen-Knopf ESC sonst
' ausloest (Gegenprobe: das zweite ESC tut es).
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM knopf AS GUI_WIDGET
knopf = GUI_BUTTON(w, "Optionen", 20, 20, 120, 30)
DIM abbr AS GUI_WIDGET
abbr = GUI_BUTTON(w, "Abbrechen", 400, 300, 120, 30)
GUI_WINDOW_CANCEL(w, abbr)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 300, 20, 200, 28)
DIM pop AS GUI_WINDOW
pop = GUI_POPOVER(knopf, 200, 120)
GUI_POPOVER_SHOW(pop)
GUI_FOCUS(tf)
AUTOMATION_PLAY("ev.txt")
DIM zu AS BOOLEAN : zu = FALSE
DIM ab AS INTEGER : ab = 0
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_POPOVER_CLOSED(pop) THEN zu = TRUE
    IF GUI_CLICKED(abbr) THEN ab = ab + 1
    n = n + 1
    IF n = 15 THEN PRINT "zu " + STR$(zu) + " abbrechen " + STR$(ab) + " offen " + STR$(GUI_WINDOW_SHOWN(pop))
    IF n = 35 THEN PRINT "abbrechen " + STR$(ab)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 4
e 4 2 256 0 0 0
e 6 1 256 0 0 0
e 24 2 256 0 0 0
e 26 1 256 0 0 0

--- umgebung
DHRT_FRAMES=40
--- erwartet
zu TRUE abbrechen 0 offen FALSE
abbrechen 1

