' ============================================================
'  DRACHENHAUCH -- Sprite-Editor (vierter Editor-Pilot)
' ============================================================
'  Nachbau des Qt-Werkzeugs `dhsprites` in Drachenhauch selbst.
'
'  Der schwerste der vier Faelle -- und der einzige, bei dem vorher
'  ausdruecklich stand, dass die Faktoren der anderen NICHT gelten: Ebenen,
'  Rueckgaengig, Werkzeuge und Zwischenablage sind hier groesstenteils KEIN
'  Duplikat dessen, was die Laufzeit ohnehin kann. Der Tilemap-Editor bekam
'  das Fuellen als Befehl geschenkt (TILED_FLOOD_FILL); hier steht es unten
'  als BASIC-Schleife.
'
'  Was drin ist:
'    Werkzeuge   Stift, Radierer, Fuellen, Linie, Rechteck, Ellipse,
'                Spruehen, Pipette, Auswahl, Lasso, Zauberstab,
'                Verschieben -- Rechteck/Ellipse wahlweise gefuellt,
'                Pinsel 1..6 px
'    Bild        mehrere Einzelbilder mit optionalem Namen ([Name]) --
'                der Name wird sein Schluessel im Atlas; Ebenen (global,
'                wie in Aseprite), Zwiebelhaut, Spiegeln X/Y beim Zeichnen
'    Farbe       Farbwaehler + 16er-Palette + Pipette; die Palette laedt
'                und sichert GIMP-Dateien (.gpl) -- das Format, das Aseprite,
'                GIMP, Krita und die Paletten-Sammlungen im Netz sprechen
'    Bereiche    benannte Animationsbereiche (Name, von, bis, fps) -- genau
'                das, was SPRITE_ADD_ANIM braucht. Die Vorschau spielt den
'                gewaehlten; sie stehen mit in der .dhsprite
'    Leinwand    [Zuschneiden] auf den Inhalt (ueber ALLE Ebenen, auch
'                ausgeblendete) und [Groesse aendern]
'    Auswahl     eine echte Punkt-MASKE, kein Rahmen: Rechteck, Lasso
'                (Freiform) und Zauberstab (gleiche Farbe ringsum) fuellen
'                dieselbe Maske, und ALLES was zeichnet fragt sie. Solange
'                eine Auswahl steht, trifft kein Strich daneben.
'                Strg+C/X/V, Entf leert, Strg+D hebt sie auf.
'                Verschieben hebt sie vom Bild AB und setzt sie woanders
'                wieder auf -- ohne Auswahl die ganze Ebene
'    Historie    Strg+Z / Strg+Y, 24 Schritte
'    Dateien     [Sichern]/[Oeffnen] .dhsprite -- das eigene Format MIT
'                Ebenen: ein Raster-PNG (Spalten = Einzelbilder, Zeilen =
'                Ebenen) und eine JSON-Datei daneben mit Massen, Namen und
'                Sichtbarkeit. Beides fuer sich lesbar.
'    Ausgabe     einzelnes PNG, Streifen-PNG + Atlas-JSON (das Format, das
'                ATLAS_LOAD direkt liest -- der Kreis schliesst sich),
'                bewegtes GIF (Tempo aus dem Vorschau-Regler), und
'                [GB-Code]: ein lauffaehiges Programm samt Blatt, mit einer
'                SPRITE_ADD_ANIM-Zeile je Bereich, und [dhanim]: dieselben
'                Bereiche als Zustandsmaschine (.dhanim), die der
'                dhanim-Editor oeffnet
'    Eingabe     [Oeffnen] nimmt beides: `.dhsprite` mit Ebenen, oder einen
'                Streifen samt Atlas-JSON. Beim Streifen sind die Ebenen
'                weg -- er IST das zusammengerechnete Bild. Die Endung
'                entscheidet, nicht der Nutzer.
'    Vorschau    laufende Wiedergabe mit einstellbarem Tempo; Kachel-Ansicht
'                3x3 (T) zeigt das Bild acht Mal ringsum -- eine Naht sieht
'                man erst neben ihrer Wiederholung
'    Statistik   Punkte, Farben, haeufigste Farbe -- gesamt und je Bild
'
'  Was NICHT drin ist (offen gesagt, wie bei den anderen Piloten): der
'    Dateibrowser und die Dialoge der Qt-Fassung. Das
'    `.dhsprite` hier ist NICHT das der Qt-Fassung (die legt die Pixel als
'    base64 in die JSON) -- gleicher Zweck, anderes Format.
'
'  Bedienung:
'    Maus links  zeichnen        Maus rechts   Ansicht schieben
'    P E F L R O Y I S Q Z V     Werkzeuge (Q = Lasso, Z = Zauberstab,
'                                V = Verschieben)
'    T           Kachel-Ansicht
'    1..6        Palette 1..6    +/-           Pinsel
'    Strg+Z/Y    zurueck/vor     Strg+C/X/V    Zwischenablage
'    Strg+D      Auswahl weg
'    ESC         Ende
' ============================================================
IMPORT "gui"
IMPORT "imgfx"
IMPORT "json"
IMPORT "physics"   ' PHYSICS_POINT_POLY fuer das Lasso

CONST MAXG = 128               ' groesste Kantenlaenge eines Sprites
CONST MAXBILD = 16             ' Einzelbilder
CONST MAXEB = 4                ' Ebenen
CONST UNDO_MAX = 24
CONST MAXANIM = 8              ' benannte Animationsbereiche
CONST MAXPKT = MAXG * MAXG     ' Punkte einer Form

SCREEN(1440, 900, "Drachenhauch - Sprite-Editor", 1)
SET_FULLSCREEN(TRUE)
SETFPS(60)

DIM uiFont AS INTEGER : uiFont = -1
DIM fp AS STRING
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "C:/Windows/Fonts/calibri.ttf")
    IF uiFont < 0 AND FILEEXISTS(fp) THEN uiFont = LOADFONT(fp, 30)
NEXT
IF uiFont >= 0 THEN SETFONT(uiFont)
TEXT_SIZE(15)
GUI_THEME_PRESET("glas_dunkel")

DIM SW AS INTEGER : SW = SCREENWIDTH()
DIM SH AS INTEGER : SH = SCREENHEIGHT()

' ---------------------------------------------------------------- Zustand
DIM gw AS INTEGER : gw = 32            ' Sprite-Breite in Pixeln
DIM gh AS INTEGER : gh = 32
DIM anzBild AS INTEGER : anzBild = 1
DIM anzEb AS INTEGER : anzEb = 1
DIM aktBild AS INTEGER : aktBild = 0
DIM aktEb AS INTEGER : aktEb = 0

' Ebenen sind GLOBAL (jede gilt fuer alle Einzelbilder) -- so halten es
' Aseprite und Verwandte. Der Qt-Editor haengt sie an das einzelne Bild;
' das macht "Ebene ueberall ausblenden" unmoeglich.
DIM ebene[MAXBILD, MAXEB] AS IMAGE
DIM ebName[MAXEB] AS STRING
DIM ebSicht[MAXEB] AS INTEGER

DIM zoom AS INTEGER : zoom = 10
DIM panX AS INTEGER : panX = 0
DIM panY AS INTEGER : panY = 0

DIM farbe AS INTEGER : farbe = &HE84B4B
DIM pinsel AS INTEGER : pinsel = 1
DIM symX AS BOOLEAN : symX = FALSE
DIM symY AS BOOLEAN : symY = FALSE

DIM werkzeug AS INTEGER : werkzeug = 0
CONST WZ_STIFT = 0
CONST WZ_RADIER = 1
CONST WZ_FUELL = 2
CONST WZ_LINIE = 3
CONST WZ_RECHT = 4
CONST WZ_ELLIPSE = 5
CONST WZ_SPRUEH = 6
CONST WZ_PIPETTE = 7
CONST WZ_AUSWAHL = 8
CONST WZ_LASSO = 9
CONST WZ_ZAUBER = 10
CONST WZ_VERSCHIEB = 11
CONST WZ_ANZ = 12

DIM zieht AS BOOLEAN : zieht = FALSE
' Mit WELCHEM Werkzeug der Zug begonnen hat. Ein Werkzeugwechsel mitten im
' Zug (Taste oder Knopf) wuerde sonst den falschen Abschluss ausfuehren --
' beim Verschieben waere das Datenverlust: das Abgehobene wird nie wieder
' abgesetzt.
DIM ziehWz AS INTEGER : ziehWz = 0
DIM ankerX AS INTEGER : ankerX = 0
DIM ankerY AS INTEGER : ankerY = 0
DIM letztX AS INTEGER : letztX = 0
DIM letztY AS INTEGER : letztY = 0
DIM schiebt AS BOOLEAN : schiebt = FALSE
DIM schiebX AS INTEGER : schiebX = 0
DIM schiebY AS INTEGER : schiebY = 0

' Die Auswahl ist eine PUNKT-MASKE, kein Rechteck. Ein Rechteck waere nur
' der Sonderfall, in dem alles im Rahmen gesetzt ist -- und mit dem Lasso
' gibt es diesen Sonderfall nicht mehr. Weil alle drei Auswahlwerkzeuge in
' dieselbe Maske schreiben, muss keine der Aktionen dahinter (Kopieren,
' Ausschneiden, Loeschen, Zeichnen) zwischen ihnen unterscheiden.
'
' `selX/selY/selB/selH` sind der GERECHNETE Rahmen der Maske -- gebraucht,
' um beim Suchen nicht jedes Mal ueber das ganze Bild zu laufen. Sie sind
' abgeleitet, nie die Wahrheit; die steht in `maske`.
DIM maske[MAXPKT] AS INTEGER
DIM selAn AS BOOLEAN : selAn = FALSE
DIM selN AS INTEGER : selN = 0
DIM selX AS INTEGER : selX = 0
DIM selY AS INTEGER : selY = 0
DIM selB AS INTEGER : selB = 0
DIM selH AS INTEGER : selH = 0
DIM mnX AS INTEGER : mnX = 0
DIM mnY AS INTEGER : mnY = 0
DIM mxX AS INTEGER : mxX = -1
DIM mxY AS INTEGER : mxY = -1

' Das Abgehobene beim Verschieben: Farbe, Deckkraft und Zugehoerigkeit je
' Punkt des Ausschnitts. Eine EIGENE Ablage, nicht die der Zwischenablage --
' ein Verschieben darf nicht wegwerfen, was jemand vorher kopiert hat.
DIM movF[MAXPKT] AS INTEGER
DIM movA[MAXPKT] AS INTEGER
DIM movM[MAXPKT] AS INTEGER
DIM movX AS INTEGER : movX = 0
DIM movY AS INTEGER : movY = 0
DIM movB AS INTEGER : movB = 0
DIM movH AS INTEGER : movH = 0
DIM schwebt AS BOOLEAN : schwebt = FALSE
DIM verX AS INTEGER : verX = 0
DIM verY AS INTEGER : verY = 0

' Der gezogene Weg des Lassos, in Bildpunkten.
DIM lasX[MAXPKT] AS INTEGER
DIM lasY[MAXPKT] AS INTEGER
DIM lasN AS INTEGER : lasN = 0
DIM clipF[MAXPKT] AS INTEGER          ' Farbe je Punkt
DIM clipA[MAXPKT] AS INTEGER          ' Deckkraft je Punkt
DIM clipB AS INTEGER : clipB = 0
DIM clipH AS INTEGER : clipH = 0

' Benannte Animationsbereiche -- genau das, was SPRITE_ADD_ANIM braucht:
' Name, erstes und letztes Bild (beide EINSCHLIESSLICH) und ein Tempo.
' Nach innen 0-basiert wie alles andere, in der Oberflaeche 1-basiert wie
' die Bilderliste ("Bild 1").
DIM anName[MAXANIM] AS STRING
DIM anVon[MAXANIM] AS INTEGER
DIM anBis[MAXANIM] AS INTEGER
DIM anFps[MAXANIM] AS INTEGER
' Namen der Einzelbilder (leer = namenlos). Sie werden zu den Schluesseln im
' Atlas, also zu dem, was ein Programm spaeter in ATLAS_DRAW schreibt --
' deshalb sind es KENNUNGEN und kein Fliesstext, siehe `alsName$`.
DIM bildName[MAXBILD] AS STRING

DIM anzAnim AS INTEGER : anzAnim = 0
DIM aktAnim AS INTEGER : aktAnim = -1

DIM meldung AS STRING : meldung = ""

' Kachel-Ansicht. Gemerkt statt bei jedem Bild aus dem Kaestchen gelesen:
' beim UMSCHALTEN muss der Zoom neu eingepasst werden, und das faellt nur
' auf, wenn man den vorigen Stand kennt.
DIM kacheln AS BOOLEAN : kacheln = FALSE

' Formpunkte -- EINE Quelle fuer Vorschau und Uebernahme. Ohne das haette
' jede Form zwei Fassungen (eine fuer den Bildschirm, eine fuers Bild), und
' die zeigten frueher oder spaeter Verschiedenes.
DIM pX[MAXPKT] AS INTEGER
DIM pY[MAXPKT] AS INTEGER
DIM pN AS INTEGER : pN = 0

' Flut-Stapel (kein TILED_FLOOD_FILL fuer Bilder -- hier von Hand).
DIM flutX[MAXPKT] AS INTEGER
DIM flutY[MAXPKT] AS INTEGER

' Verlauf. Die Plaetze werden EINMAL angelegt und wiederverwendet
' (IMAGE_CLEAR + IMAGE_DRAW_IMAGE statt IMAGE_COPY): eine neue Momentaufnahme
' je Pinselstrich waere zwar mit IMAGE_FREE wieder wegzubekommen, aber gar
' nicht erst anzulegen ist billiger als anlegen und freigeben.
DIM uVor[UNDO_MAX] AS IMAGE
DIM uNach[UNDO_MAX] AS IMAGE
DIM uBild[UNDO_MAX] AS INTEGER
DIM uEbe[UNDO_MAX] AS INTEGER
DIM uStart AS INTEGER : uStart = 0
DIM uAnz AS INTEGER : uAnz = 0
DIM uPos AS INTEGER : uPos = 0
DIM puffer AS IMAGE

DIM angelegt AS BOOLEAN : angelegt = FALSE
DIM anpassen AS BOOLEAN : anpassen = TRUE
DIM schachbrett AS IMAGE
DIM streifen AS IMAGE                  ' Arbeitsflaeche fuer den Export

' ============================================================ Hilfsmittel

SUB kopiere(ziel AS IMAGE, quelle AS IMAGE)
    IMAGE_CLEAR(ziel)
    IMAGE_DRAW_IMAGE(ziel, quelle, 0, 0)
END SUB

' ----------------------------------------------------------- Auswahlmaske
' Vier kleine SUBs statt einer grossen: `maskeBeginn` raeumt, `maskeAdd`
' setzt einen Punkt und fuehrt Zaehler und Rahmen mit, `maskeEnde` schliesst
' ab. Jedes Auswahlwerkzeug benutzt genau diese Reihenfolge -- damit gibt es
' keinen Weg, eine Maske zu bauen und dabei den Rahmen zu vergessen.
SUB maskeAlleWeg()
    ' Das ganze Feld raeumen. Noetig, wenn sich die Sprite-GROESSE aendert:
    ' danach zeigt derselbe Index auf einen anderen Punkt, der gemerkte
    ' Rahmen taugt also nicht mehr zum gezielten Raeumen.
    DIM i AS INTEGER
    FOR i = 0 TO MAXPKT - 1
        maske[i] = 0
    NEXT
    selAn = FALSE : selN = 0
    selX = 0 : selY = 0 : selB = 0 : selH = 0
END SUB

SUB maskeBeginn()
    ' Nur den bisherigen Rahmen raeumen -- ausserhalb ist die Maske per
    ' Bauart leer. Ueber das ganze Feld zu laufen waeren bei 128x128
    ' sechzehntausend Schritte, und der Zauberstab macht das bei JEDEM Klick.
    DIM x AS INTEGER
    DIM y AS INTEGER
    IF selAn THEN
        FOR y = selY TO selY + selH - 1
            FOR x = selX TO selX + selB - 1
                maske[y * gw + x] = 0
            NEXT
        NEXT
    END IF
    selN = 0
    mnX = gw : mnY = gh : mxX = -1 : mxY = -1
END SUB

SUB maskeAdd(x AS INTEGER, y AS INTEGER)
    IF x >= 0 AND y >= 0 AND x < gw AND y < gh THEN
        IF maske[y * gw + x] = 0 THEN
            maske[y * gw + x] = 1
            selN = selN + 1
            IF x < mnX THEN mnX = x
            IF y < mnY THEN mnY = y
            IF x > mxX THEN mxX = x
            IF y > mxY THEN mxY = y
        END IF
    END IF
END SUB

SUB maskeEnde()
    selAn = selN > 0
    IF selAn THEN
        selX = mnX : selY = mnY
        selB = mxX - mnX + 1 : selH = mxY - mnY + 1
    ELSE
        selX = 0 : selY = 0 : selB = 0 : selH = 0
    END IF
END SUB

FUNCTION gewaehlt(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    ' OHNE Auswahl gilt das ganze Bild. So braucht keine Zeichenroutine einen
    ' Sonderfall "es gibt keine Auswahl" -- sie fragt einfach immer.
    IF NOT selAn THEN RETURN TRUE
    IF x < 0 OR y < 0 OR x >= gw OR y >= gh THEN RETURN FALSE
    RETURN maske[y * gw + x] = 1
END FUNCTION

FUNCTION istRechteck() AS BOOLEAN
    ' Ist die Maske genau ihr eigener Rahmen? Nur dann darf ein Rahmen um
    ' sie gezeichnet werden -- bei einer Freiform zeigte er einen Bereich,
    ' der gar nicht gewaehlt ist.
    RETURN selAn AND selN = selB * selH
END FUNCTION

SUB rechteckMaske(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER)
    maskeBeginn()
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = MIN(y0, y1) TO MAX(y0, y1)
        FOR x = MIN(x0, x1) TO MAX(x0, x1)
            maskeAdd(x, y)
        NEXT
    NEXT
    maskeEnde()
END SUB

' Einen Punkt an den gezogenen Weg haengen -- und zwar LUECKENLOS: zwischen
' zwei Bildern springt eine schnell gefuehrte Maus mehrere Punkte weit, also
' wird die Strecke dorthin ausgezogen.
'
' Das ist nicht nur Kosmetik. Der Weg ist spaeter BEIDES: die Ecken des
' Vielecks und der gezeichnete Rand. Waeren die Ecken grob und der Rand
' fein, laegen beide an den Kanten um einen Punkt auseinander -- und genau
' dort blieben einzelne Punkte ungewaehlt, mitten in der Auswahl.
SUB lassoPunkt(x AS INTEGER, y AS INTEGER)
    IF lasN > 0 AND x = lasX[lasN - 1] AND y = lasY[lasN - 1] THEN RETURN
    IF lasN = 0 THEN
        lasX[0] = x : lasY[0] = y : lasN = 1
        RETURN
    END IF
    formPunkte(WZ_LINIE, lasX[lasN - 1], lasY[lasN - 1], x, y, FALSE)
    DIM k AS INTEGER
    FOR k = 1 TO pN - 1                ' der erste Punkt steht schon drin
        IF lasN < MAXPKT THEN
            lasX[lasN] = pX[k] : lasY[lasN] = pY[k] : lasN = lasN + 1
        END IF
    NEXT
END SUB

' Freiform. Der gezogene Weg wird als Vieleck aufgefasst und ueber
' PHYSICS_POINT_POLY punktweise geprueft (Strahl-Verfahren, kann auch
' konkave Formen -- und eine mit der Hand gezogene Schlaufe ist immer eine).
' Von Hand nachgebaut waere das dieselbe Rechnung, nur langsamer und mit
' eigenen Randfaellen.
SUB lassoMaske()
    IF lasN < 3 THEN
        ' Ein Klick ohne Zug ist kein Vieleck -- das hebt die Auswahl auf.
        maskeBeginn() : maskeEnde()
        RETURN
    END IF
    ' Der Schluss-Strich zum Anfang zurueck gehoert zum Vieleck -- und damit
    ' auch in den Weg, sonst haette ausgerechnet diese Kante wieder die
    ' grobe Fassung.
    lassoPunkt(lasX[0], lasY[0])
    DIM i AS INTEGER
    DIM xs[lasN] AS FLOAT
    DIM ys[lasN] AS FLOAT
    DIM ax AS INTEGER : ax = lasX[0]
    DIM ay AS INTEGER : ay = lasY[0]
    DIM bx AS INTEGER : bx = lasX[0]
    DIM by AS INTEGER : by = lasY[0]
    FOR i = 0 TO lasN - 1
        ' Das Vieleck liegt auf den MITTEN der Punkte -- wie gleich auch die
        ' Testpunkte. Beides muss dasselbe Raster benutzen: nimmt man hier
        ' die Ecken und dort die Mitten, faellt ein 45-Grad-Rand genau auf
        ' die Kante, und ausgerechnet dort entscheidet die Rundung. Gemessen
        ' war das eine Reihe einzelner ungewaehlter Punkte MITTEN in der
        ' Auswahl -- sichtbar erst im Bild, nicht in einer Zahl.
        xs[i] = lasX[i] + 0.5 : ys[i] = lasY[i] + 0.5
        ax = MIN(ax, lasX[i]) : ay = MIN(ay, lasY[i])
        bx = MAX(bx, lasX[i]) : by = MAX(by, lasY[i])
    NEXT
    ax = MAX(0, ax) : ay = MAX(0, ay)
    bx = MIN(gw - 1, bx) : by = MIN(gh - 1, by)
    maskeBeginn()
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = ay TO by
        FOR x = ax TO bx
            IF PHYSICS_POINT_POLY(x + 0.5, y + 0.5, xs, ys) THEN maskeAdd(x, y)
        NEXT
    NEXT
    ' Der gezogene Weg selbst gehoert dazu. Bei einer duennen Schlaufe liegt
    ' zwischen Hin- und Rueckweg kein einziger Punktmittelpunkt -- ohne das
    ' waere die Auswahl leer, obwohl man sichtbar etwas umfahren hat.
    FOR i = 0 TO lasN - 1
        maskeAdd(lasX[i], lasY[i])
    NEXT
    maskeEnde()
END SUB

' Zauberstab: alles, was vom angeklickten Punkt aus ueber Nachbarn erreichbar
' ist und dieselbe Farbe UND Deckkraft hat. Ohne Toleranz, wie beim Fuellen
' auch -- in Pixelgrafik ist eine Flaeche genau eine Farbe, und zwei
' verschiedene Regeln fuer "dieselbe Farbe" waeren die groessere Ueberraschung.
SUB zauberMaske(sx AS INTEGER, sy AS INTEGER)
    DIM bild AS IMAGE : bild = ebene[aktBild, aktEb]
    DIM zf AS INTEGER : zf = GETPIXEL(bild, sx, sy)
    DIM za AS INTEGER : za = GETALPHA(bild, sx, sy)
    maskeBeginn()
    DIM voll AS BOOLEAN : voll = FALSE
    DIM n AS INTEGER : n = 1
    flutX[0] = sx : flutY[0] = sy
    WHILE n > 0
        n = n - 1
        DIM x AS INTEGER : x = flutX[n]
        DIM y AS INTEGER : y = flutY[n]
        IF x >= 0 AND y >= 0 AND x < gw AND y < gh THEN
            ' Die Maske selbst ist die Merkliste des Verfahrens. Das Fuellen
            ' weiter oben merkt sich Besuchtes daran, dass es die Farbe
            ' aendert -- hier aendert sich am Bild nichts, also braucht es
            ' diesen eigenen Vermerk.
            IF maske[y * gw + x] = 0 AND GETPIXEL(bild, x, y) = zf AND GETALPHA(bild, x, y) = za THEN
                maskeAdd(x, y)
                IF n + 4 < MAXPKT THEN
                    flutX[n] = x - 1 : flutY[n] = y : n = n + 1
                    flutX[n] = x + 1 : flutY[n] = y : n = n + 1
                    flutX[n] = x : flutY[n] = y - 1 : n = n + 1
                    flutX[n] = x : flutY[n] = y + 1 : n = n + 1
                ELSE
                    voll = TRUE
                END IF
            END IF
        END IF
    WEND
    maskeEnde()
    ' Ein voller Stapel laesst Teile der Flaeche stehen. Das sieht aus wie
    ' eine seltsam ausgefranste Auswahl -- also sagen, was passiert ist,
    ' statt es stillschweigend abzuschneiden.
    IF voll THEN meldung = "Zauberstab: Flaeche zu verzweigt, Auswahl unvollstaendig"
END SUB

' ------------------------------------------------- Groesse und Hilfsbilder
' Alles, was an der GROESSE des Sprites haengt und kein Inhalt ist:
' Verlaufsplaetze, Arbeitspuffer, Streifen und Schachbrett. Herausgeloest,
' weil es zwei Anlaesse gibt -- ein neues Sprite und eine Groessenaenderung --
' und zwei Fassungen davon frueher oder spaeter auseinanderlaufen.
SUB hilfsbilderFrei()
    DIM i AS INTEGER
    FOR i = 0 TO UNDO_MAX - 1
        IMAGE_FREE(uVor[i])
        IMAGE_FREE(uNach[i])
    NEXT
    IMAGE_FREE(puffer)
    IMAGE_FREE(streifen)
    IMAGE_FREE(schachbrett)
END SUB

SUB hilfsbilderNeu(alteFrei AS BOOLEAN)
    IF alteFrei THEN hilfsbilderFrei()
    DIM i AS INTEGER
    FOR i = 0 TO UNDO_MAX - 1
        uVor[i] = IMAGE_NEW(gw, gh)
        uNach[i] = IMAGE_NEW(gw, gh)
    NEXT
    puffer = IMAGE_NEW(gw, gh)
    streifen = IMAGE_NEW(gw * MAXBILD, gh)
    ' Der Verlauf wird geleert: seine Momentaufnahmen haetten die alte
    ' Groesse, und ein Zurueck darauf brauchte eine zweite Umrechnung.
    uStart = 0 : uAnz = 0 : uPos = 0

    ' Schachbrett als Untergrund -- ohne das ist "durchsichtig" von
    ' "schwarz" nicht zu unterscheiden.
    schachbrett = IMAGE_NEW(gw, gh, &H2A3038)
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 0 TO gh - 1
        FOR x = 0 TO gw - 1
            IF ((x \ 4) + (y \ 4)) MOD 2 = 0 THEN
                IMAGE_DRAW_RECT(schachbrett, x, y, 1, 1, &H353C46)
            END IF
        NEXT
    NEXT
END SUB

' Groesse aendern, Inhalt behalten: (vx, vy) ist die Ecke des alten Bildes,
' die links oben landen soll. Ein NEGATIVER Zeichenort schneidet ab, ein
' positiver laesst Rand stehen -- Zuschneiden und Vergroessern sind damit
' derselbe Aufruf und koennen nicht auseinanderlaufen.
SUB groesseAendern(nb AS INTEGER, nh AS INTEGER, vx AS INTEGER, vy AS INTEGER)
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO MAXBILD - 1
        FOR k = 0 TO MAXEB - 1
            DIM n AS IMAGE : n = IMAGE_NEW(nb, nh)
            IF i < anzBild AND k < anzEb THEN
                IMAGE_DRAW_IMAGE(n, ebene[i, k], -vx, -vy)
            END IF
            IMAGE_FREE(ebene[i, k])
            ebene[i, k] = n
        NEXT
    NEXT
    gw = nb : gh = nh
    hilfsbilderNeu(TRUE)
    maskeAlleWeg()
    panX = 0 : panY = 0
    anpassen = TRUE
END SUB

' Auf den Inhalt zuschneiden: der Rahmen um alles, was nicht durchsichtig
' ist -- ueber alle Einzelbilder UND alle Ebenen.
'
' Auch ueber die AUSGEBLENDETEN. Nach der Sichtbarkeit zu gehen waere
' bequemer, wuerde aber Inhalt wegschneiden, den man gerade nicht sieht --
' und das faellt erst auf, wenn man die Ebene wieder einblendet.
SUB zuschneiden()
    DIM mnx AS INTEGER : mnx = gw
    DIM mny AS INTEGER : mny = gh
    DIM mxx AS INTEGER : mxx = -1
    DIM mxy AS INTEGER : mxy = -1
    DIM i AS INTEGER
    DIM k AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR i = 0 TO anzBild - 1
        FOR k = 0 TO anzEb - 1
            FOR y = 0 TO gh - 1
                FOR x = 0 TO gw - 1
                    IF GETALPHA(ebene[i, k], x, y) > 0 THEN
                        IF x < mnx THEN mnx = x
                        IF y < mny THEN mny = y
                        IF x > mxx THEN mxx = x
                        IF y > mxy THEN mxy = y
                    END IF
                NEXT
            NEXT
        NEXT
    NEXT
    IF mxx < 0 THEN
        meldung = "Alles durchsichtig -- da bleibt nichts uebrig."
    ELIF mnx = 0 AND mny = 0 AND mxx = gw - 1 AND mxy = gh - 1 THEN
        meldung = "Keine durchsichtigen Raender."
    ELSE
        DIM nb AS INTEGER : nb = mxx - mnx + 1
        DIM nh AS INTEGER : nh = mxy - mny + 1
        groesseAendern(nb, nh, mnx, mny)
        meldung = "Zugeschnitten auf " + STR$(nb) + "x" + STR$(nh)
    END IF
END SUB

SUB neuesSprite(b AS INTEGER, h AS INTEGER)
    ' Beim zweiten Mal zuerst die alten Bilder freigeben -- sonst haengt
    ' jedes "Neu" einen kompletten Satz Texturen an, den niemand mehr
    ' erreicht (bei 16x4 Ebenen plus Verlauf sind das ueber 90 Stueck).
    IF angelegt THEN
        DIM fi AS INTEGER
        DIM fk AS INTEGER
        FOR fi = 0 TO MAXBILD - 1
            FOR fk = 0 TO MAXEB - 1
                IMAGE_FREE(ebene[fi, fk])
            NEXT
        NEXT
        hilfsbilderFrei()
    END IF
    angelegt = TRUE
    gw = b : gh = h
    anzBild = 1 : anzEb = 1
    aktBild = 0 : aktEb = 0
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO MAXBILD - 1
        FOR k = 0 TO MAXEB - 1
            ebene[i, k] = IMAGE_NEW(gw, gh)
        NEXT
    NEXT
    FOR k = 0 TO MAXEB - 1
        ebName[k] = "Ebene " + STR$(k + 1)
        ebSicht[k] = 1
    NEXT
    hilfsbilderNeu(FALSE)          ' die alten hat der Block oben schon frei
    anzAnim = 0 : aktAnim = -1
    DIM bn AS INTEGER
    FOR bn = 0 TO MAXBILD - 1
        bildName[bn] = ""
    NEXT
    maskeAlleWeg()
    panX = 0 : panY = 0
    ' Den Zoom kann diese SUB nicht selbst setzen: sie laeuft schon, bevor
    ' es die Zeichenflaeche gibt (und ihre Groesse aendert sich mit dem
    ' Fenster). Also nur vormerken -- die Schleife rechnet ihn aus.
    anpassen = TRUE
END SUB

' ---------------------------------------------------------------- Verlauf
SUB schrittBeginn()
    kopiere(puffer, ebene[aktBild, aktEb])
END SUB

SUB schrittEnde()
    uAnz = uPos
    IF uAnz = UNDO_MAX THEN
        uStart = (uStart + 1) MOD UNDO_MAX
        uAnz = uAnz - 1
    END IF
    DIM s AS INTEGER : s = (uStart + uAnz) MOD UNDO_MAX
    kopiere(uVor[s], puffer)
    kopiere(uNach[s], ebene[aktBild, aktEb])
    uBild[s] = aktBild
    uEbe[s] = aktEb
    uAnz = uAnz + 1
    uPos = uAnz
END SUB

SUB zurueck()
    IF uPos > 0 THEN
        uPos = uPos - 1
        DIM s AS INTEGER : s = (uStart + uPos) MOD UNDO_MAX
        aktBild = uBild[s] : aktEb = uEbe[s]
        kopiere(ebene[aktBild, aktEb], uVor[s])
    END IF
END SUB

SUB wieder()
    IF uPos < uAnz THEN
        DIM s AS INTEGER : s = (uStart + uPos) MOD UNDO_MAX
        aktBild = uBild[s] : aktEb = uEbe[s]
        kopiere(ebene[aktBild, aktEb], uNach[s])
        uPos = uPos + 1
    END IF
END SUB

' -------------------------------------------------------------- Zeichnen
' EIN Ort, an dem Farbe ins Bild kommt -- und damit der einzige, der die
' Auswahl kennen muss. Stift, Radierer, Linie, Rechteck, Ellipse und
' Spruehen laufen alle hier durch.
SUB block(x AS INTEGER, y AS INTEGER, c AS INTEGER, weg AS BOOLEAN)
    IF x < 0 OR y < 0 OR x >= gw OR y >= gh THEN RETURN
    IF NOT selAn THEN
        ' Ohne Auswahl der ganze Pinsel in EINEM Aufruf. Punktweise waeren
        ' es bei Pinsel 6 sechsunddreissig statt einem -- und ein Aufruf
        ' schreibt die ganze Textur neu (gemessen rund 4 Mikrosekunden).
        IF weg THEN
            IMAGE_CLEAR(ebene[aktBild, aktEb], x, y, pinsel, pinsel)
        ELSE
            IMAGE_DRAW_RECT(ebene[aktBild, aktEb], x, y, pinsel, pinsel, c)
        END IF
        RETURN
    END IF
    DIM bx AS INTEGER
    DIM by AS INTEGER
    FOR by = y TO y + pinsel - 1
        FOR bx = x TO x + pinsel - 1
            IF gewaehlt(bx, by) THEN
                IF weg THEN
                    IMAGE_CLEAR(ebene[aktBild, aktEb], bx, by, 1, 1)
                ELSE
                    IMAGE_DRAW_RECT(ebene[aktBild, aktEb], bx, by, 1, 1, c)
                END IF
            END IF
        NEXT
    NEXT
END SUB

SUB punkt(x AS INTEGER, y AS INTEGER, c AS INTEGER, weg AS BOOLEAN)
    block(x, y, c, weg)
    ' Gespiegelt wird die ganze Pinselbreite, nicht nur ihr Anfang -- sonst
    ' sitzt der Spiegelstrich bei dickem Pinsel um pinsel-1 daneben.
    DIM sx AS INTEGER : sx = gw - x - pinsel
    DIM sy AS INTEGER : sy = gh - y - pinsel
    IF symX THEN block(sx, y, c, weg)
    IF symY THEN block(x, sy, c, weg)
    IF symX AND symY THEN block(sx, sy, c, weg)
END SUB

' ------------------------------------------------- Formen (eine Quelle)
SUB pAdd(x AS INTEGER, y AS INTEGER)
    IF pN < MAXPKT THEN
        pX[pN] = x : pY[pN] = y : pN = pN + 1
    END IF
END SUB

SUB linie(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER)
    DIM dx AS INTEGER : dx = ABS(x1 - x0)
    DIM dy AS INTEGER : dy = -ABS(y1 - y0)
    DIM sx AS INTEGER : sx = IIF(x0 < x1, 1, -1)
    DIM sy AS INTEGER : sy = IIF(y0 < y1, 1, -1)
    DIM err AS INTEGER : err = dx + dy
    DIM x AS INTEGER : x = x0
    DIM y AS INTEGER : y = y0
    DIM sicher AS INTEGER : sicher = 0
    WHILE sicher < MAXPKT
        pAdd(x, y)
        IF x = x1 AND y = y1 THEN BREAK
        DIM e2 AS INTEGER : e2 = 2 * err
        IF e2 >= dy THEN
            err = err + dy
            x = x + sx
        END IF
        IF e2 <= dx THEN
            err = err + dx
            y = y + sy
        END IF
        sicher = sicher + 1
    WEND
END SUB

SUB formPunkte(art AS INTEGER, x0 AS INTEGER, y0 AS INTEGER, _
               x1 AS INTEGER, y1 AS INTEGER, gefuellt AS BOOLEAN)
    pN = 0
    DIM ax AS INTEGER : ax = MIN(x0, x1)
    DIM ay AS INTEGER : ay = MIN(y0, y1)
    DIM bx AS INTEGER : bx = MAX(x0, x1)
    DIM by AS INTEGER : by = MAX(y0, y1)
    DIM x AS INTEGER
    DIM y AS INTEGER
    SELECT CASE art
        CASE WZ_LINIE
            linie(x0, y0, x1, y1)
        CASE WZ_RECHT
            IF gefuellt THEN
                FOR y = ay TO by
                    FOR x = ax TO bx
                        pAdd(x, y)
                    NEXT
                NEXT
            ELSE
                FOR x = ax TO bx
                    pAdd(x, ay) : pAdd(x, by)
                NEXT
                FOR y = ay TO by
                    pAdd(ax, y) : pAdd(bx, y)
                NEXT
            END IF
        CASE WZ_ELLIPSE
            ' Ueber die Zeilen statt ueber den Mittelpunkt-Algorithmus: so
            ' faellt die gefuellte Fassung ohne zweiten Weg mit ab, und die
            ' Kante ist bei beiden dieselbe.
            DIM rx AS FLOAT : rx = (bx - ax) / 2.0
            DIM ry AS FLOAT : ry = (by - ay) / 2.0
            DIM cx AS FLOAT : cx = (ax + bx) / 2.0
            DIM cy AS FLOAT : cy = (ay + by) / 2.0
            IF rx < 0.5 THEN rx = 0.5
            IF ry < 0.5 THEN ry = 0.5
            FOR y = ay TO by
                DIM t AS FLOAT : t = 1.0 - ((y - cy) * (y - cy)) / (ry * ry)
                IF t >= 0.0 THEN
                    DIM d AS INTEGER : d = INT(rx * SQR(t))
                    DIM lx AS INTEGER : lx = INT(cx - d)
                    DIM rxi AS INTEGER : rxi = INT(cx + d + 0.5)
                    IF gefuellt THEN
                        FOR x = lx TO rxi
                            pAdd(x, y)
                        NEXT
                    ELSE
                        pAdd(lx, y) : pAdd(rxi, y)
                    END IF
                END IF
            NEXT
            ' Zeilenweise allein reicht fuer den Umriss NICHT: wo die Kurve
            ' flach laeuft (oben und unten), springt sie von Zeile zu Zeile
            ' mehrere Spalten weit und der Umriss bekommt Luecken. Also
            ' dieselbe Rechnung noch einmal ueber die SPALTEN -- zusammen
            ' ergeben beide einen geschlossenen Rand. Doppelte Punkte
            ' schaden nicht, sie werden nur zweimal gesetzt.
            IF NOT gefuellt THEN
                FOR x = ax TO bx
                    DIM t2 AS FLOAT : t2 = 1.0 - ((x - cx) * (x - cx)) / (rx * rx)
                    IF t2 >= 0.0 THEN
                        DIM d2 AS INTEGER : d2 = INT(ry * SQR(t2))
                        pAdd(x, INT(cy - d2))
                        pAdd(x, INT(cy + d2 + 0.5))
                    END IF
                NEXT
            END IF
    END SELECT
END SUB

' Farbe und Deckkraft wieder zu einer Farbe zusammensetzen. GETPIXEL liefert
' nur RGB, GETALPHA nur die Deckkraft -- wer beides getrennt aufhebt und
' spaeter allein die Farbe setzt, macht aus jedem halbdurchsichtigen Punkt
' einen deckenden. Bei selbst Gemaltem faellt das nie auf, bei einem
' geladenen Bild mit weichen Raendern sofort.
FUNCTION mitAlpha(c AS INTEGER, a AS INTEGER) AS INTEGER
    RETURN RGBA((c \ 65536) MOD 256, (c \ 256) MOD 256, c MOD 256, a)
END FUNCTION

' ---------------------------------------------------------------- GB-Code
' Ein LAUFFAEHIGES Drachenhauch-Programm zu diesem Sprite: der Streifen als
' PNG daneben, dazu eine SPRITE_ADD_ANIM-Zeile je Bereich. Damit schliesst
' sich der Kreis -- was hier gemalt wurde, laeuft ohne Zwischenschritt.
'
' Beides unter DEMSELBEN Namen und in EINEM Zug. Wer nur den Code schreibt,
' hat einen Verweis ins Leere, und das faellt erst beim Starten auf.
SUB gbCodeSichern(pfad AS STRING)
    DIM png AS STRING : png = pfad
    IF LEN(png) > 3 AND RIGHT$(LOWER$(png), 3) = ".dh" THEN
        png = LEFT$(png, LEN(png) - 3)
    END IF
    png = png + ".png"

    baueStreifen()
    ' Wie beim Streifen-Export auf die belegten Bilder zuschneiden: SPRITE_NEW
    ' rechnet die Bildzahl aus der BREITE, ein zu breites Blatt haette also
    ' lauter leere Einzelbilder am Ende.
    DIM eng AS IMAGE : eng = IMAGE_CROP(streifen, 0, 0, gw * anzBild, gh)
    IMAGE_SAVE(eng, png)
    IMAGE_FREE(eng)

    DIM z AS STRING : z = CHR$(10)
    DIM t AS STRING
    t = "' Von 189_sprite_editor.dh erzeugt." + z + _
        "IMPORT " + CHR$(34) + "sprite" + CHR$(34) + z + z + _
        "SCREEN(640, 400, " + CHR$(34) + "Sprite" + CHR$(34) + ", 1)" + z + z + _
        "DIM blatt AS IMAGE" + z + _
        "blatt = LOADIMAGE(" + CHR$(34) + BASENAME(png) + CHR$(34) + ")" + z + _
        "DIM sp AS SPRITE" + z + _
        "sp = SPRITE_NEW(blatt, " + STR$(gw) + ", " + STR$(gh) + ")" + z
    ' Ohne eigene Bereiche einer ueber alles -- so hat das Programm immer
    ' etwas zu spielen, und der Name ist der uebliche.
    DIM erster AS STRING : erster = "idle"
    IF anzAnim = 0 THEN
        t = t + "SPRITE_ADD_ANIM(sp, " + CHR$(34) + "idle" + CHR$(34) + ", 0, " + _
            STR$(anzBild - 1) + ", " + STR$(INT(GUI_VALUE(slTempo))) + ")" + z
    ELSE
        erster = anName[0]
        DIM k AS INTEGER
        FOR k = 0 TO anzAnim - 1
            t = t + "SPRITE_ADD_ANIM(sp, " + CHR$(34) + anName[k] + CHR$(34) + ", " + _
                STR$(anVon[k]) + ", " + STR$(anBis[k]) + ", " + STR$(anFps[k]) + ")" + z
        NEXT
    END IF
    t = t + "SPRITE_PLAY(sp, " + CHR$(34) + erster + CHR$(34) + ")" + z + _
        "SPRITE_SET_POS(sp, 300, 180)" + z + z + _
        "WHILE NOT QUITREQUESTED()" + z + _
        "    CLS(&H101820)" + z + _
        "    SPRITE_UPDATE(sp, INT(DELTA() * 1000))" + z + _
        "    SPRITE_DRAW(sp)" + z + _
        "    FLIP()" + z + _
        "WEND" + z
    WRITEALL(pfad, t)
    meldung = "Code + Blatt: " + BASENAME(pfad) + " / " + BASENAME(png)
END SUB

' ----------------------------------------------------------------- dhanim
' Die Bereiche als Zustandsmaschine (.dhanim) -- ein Zustand je Bereich, der
' erste als Startzustand. Uebergaenge und Parameter bleiben LEER: welcher
' Zustand wann in welchen wechselt, weiss der Editor nicht, das ist eine
' Aussage ueber das Spiel. Die Datei ist damit eine Vorlage, die `dhanim`
' oeffnet und ergaenzt -- und die `ANIM_FSM_LOAD` schon so laedt.
'
' Ueber das json-Modul geschrieben, nicht von Hand: Bereichsnamen sind
' Nutzertext, und die Maskierung will man nicht selbst schreiben.
SUB dhanimSichern(pfad AS STRING)
    DIM h AS JSON_HANDLE : h = JSON_NEW_OBJECT()
    JSON_SET_INT(h, "version", 1)
    DIM erster AS STRING : erster = IIF(anzAnim > 0, anName[0], "idle")
    JSON_SET_STRING(h, "default", erster)
    JSON_SET_JSON(h, "params", JSON_NEW_ARRAY())
    JSON_SET_JSON(h, "states", JSON_NEW_ARRAY())
    IF anzAnim = 0 THEN
        ' Ohne eigene Bereiche einer ueber alles -- eine Maschine ohne
        ' Zustand laedt zwar, hat aber nichts zu spielen.
        DIM z0 AS JSON_HANDLE : z0 = JSON_NEW_OBJECT()
        JSON_SET_STRING(z0, "name", "idle")
        JSON_SET_STRING(z0, "anim", "idle")
        JSON_SET_BOOL(z0, "loop", TRUE)
        JSON_SET_INT(z0, "first", 0)
        JSON_SET_INT(z0, "last", anzBild - 1)
        JSON_SET_INT(z0, "fps", INT(GUI_VALUE(slTempo)))
        JSON_APPEND_JSON(h, "states", z0)
    ELSE
        DIM k AS INTEGER
        FOR k = 0 TO anzAnim - 1
            DIM zt AS JSON_HANDLE : zt = JSON_NEW_OBJECT()
            JSON_SET_STRING(zt, "name", anName[k])
            JSON_SET_STRING(zt, "anim", anName[k])
            JSON_SET_BOOL(zt, "loop", TRUE)
            JSON_SET_INT(zt, "first", anVon[k])
            JSON_SET_INT(zt, "last", anBis[k])
            JSON_SET_INT(zt, "fps", anFps[k])
            JSON_APPEND_JSON(h, "states", zt)
        NEXT
    END IF
    JSON_SET_JSON(h, "transitions", JSON_NEW_ARRAY())
    WRITEALL(pfad, JSON_PRETTY(h))
    meldung = "Zustandsmaschine: " + BASENAME(pfad) + " (Uebergaenge in dhanim ergaenzen)"
END SUB

' ----------------------------------------------------------------- Namen
' Aus Eingetipptem eine Kennung machen: Buchstaben, Ziffern, Unterstrich und
' Bindestrich bleiben, alles andere wird zum Unterstrich.
'
' Der Punkt ist dabei nicht Geschmack, sondern eine gemessene Falle: das
' json-Modul liest einen Schluessel mit PUNKT als PFAD -- aus dem Namen
' "held.lauf" wird beim Schreiben `{"held": {"lauf": ...}}` statt eines
' Eintrags, und `streifenLaden` sucht spaeter mit derselben Punkt-Notation.
' Ein Name, der aus dem Atlas nicht mehr herauszulesen ist, waere ein
' Fehler, den man erst beim Wiederoeffnen bemerkt.
FUNCTION alsName$(roh AS STRING) AS STRING
    DIM t AS STRING : t = TRIM$(roh)
    DIM aus AS STRING : aus = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(t) - 1
        DIM c AS STRING : c = MID$(t, i, 1)
        DIM o AS INTEGER : o = ASC(c)
        IF (o >= 48 AND o <= 57) OR (o >= 65 AND o <= 90) OR _
           (o >= 97 AND o <= 122) OR c = "_" OR c = "-" THEN
            aus = aus + c
        ELSE
            aus = aus + "_"
        END IF
    NEXT
    ' Lang genug fuer einen sprechenden Namen, kurz genug fuer die Liste.
    IF LEN(aus) > 24 THEN aus = LEFT$(aus, 24)
    RETURN aus
END FUNCTION

' -------------------------------------------------------------- Statistik
' Zaehlt ueber die SICHTBAREN Ebenen -- also ueber das, was man sieht und was
' auch exportiert wuerde. Eine ausgeblendete Ebene taucht nicht auf; ohne
' diesen Satz im Ergebnis waere eine ploetzlich kleinere Zahl ein Raetsel.
'
' Gemessen: 16384 Punkte kosten mit Farbzaehlung rund 9 ms -- selbst bei
' 128x128 und 16 Bildern bleibt das ein kurzer Halt auf Knopfdruck.
DIM statZaehl AS MAP OF INTEGER          ' Farbe (als Text) -> Anzahl
DIM statBild AS MAP OF INTEGER           ' dasselbe je Einzelbild

FUNCTION statistik$() AS STRING
    MAPCLEAR(statZaehl)
    DIM gesamt AS INTEGER : gesamt = gw * gh * anzBild
    DIM deckend AS INTEGER : deckend = 0
    DIM proBild AS STRING : proBild = ""
    DIM i AS INTEGER
    DIM k AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR i = 0 TO anzBild - 1
        DIM eins AS IMAGE : eins = IMAGE_NEW(gw, gh)
        FOR k = 0 TO anzEb - 1
            IF ebSicht[k] = 1 THEN IMAGE_DRAW_IMAGE(eins, ebene[i, k], 0, 0)
        NEXT
        MAPCLEAR(statBild)
        DIM bDeck AS INTEGER : bDeck = 0
        FOR y = 0 TO gh - 1
            FOR x = 0 TO gw - 1
                ' Halb durchsichtig zaehlt ab 128 als deckend -- dieselbe
                ' Schwelle, mit der auch das GIF entscheidet. Zwei
                ' verschiedene Grenzen im selben Programm waeren eine
                ' Stolperfalle.
                IF GETALPHA(eins, x, y) >= 128 THEN
                    bDeck = bDeck + 1
                    DIM sf AS STRING : sf = STR$(GETPIXEL(eins, x, y))
                    MAPPUT(statBild, sf, 1)
                    MAPPUT(statZaehl, sf, MAPGETOR(statZaehl, sf, 0) + 1)
                END IF
            NEXT
        NEXT
        deckend = deckend + bDeck
        proBild = proBild + "  Bild " + STR$(i + 1) + ":  " + STR$(bDeck) + _
                  " deckend, " + STR$(MAPSIZE(statBild)) + " Farben" + CHR$(10)
        IMAGE_FREE(eins)                 ' nur zum Zaehlen gebraucht
    NEXT

    ' Die haeufigste Farbe. Ueber die Schluessel statt beim Zaehlen
    ' mitzufuehren: so steht der Vergleich an EINER Stelle.
    DIM haeufig AS INTEGER : haeufig = -1
    DIM hAnz AS INTEGER : hAnz = 0
    DIM ks AS STRING
    FOR EACH ks IN MAPKEYS(statZaehl)
        DIM n AS INTEGER : n = MAPGET(statZaehl, ks)
        IF n > hAnz THEN
            hAnz = n : haeufig = INT(VAL(ks))
        END IF
    NEXT

    DIM t AS STRING
    t = STR$(gw) + " x " + STR$(gh) + " Punkte, " + STR$(anzBild) + " Bilder, " + _
        STR$(anzEb) + " Ebenen" + CHR$(10) + _
        "(gerechnet ueber die sichtbaren Ebenen)" + CHR$(10) + CHR$(10) + _
        "Punkte gesamt:        " + STR$(gesamt) + CHR$(10) + _
        "davon deckend:        " + STR$(deckend) + _
        "  (" + FORMAT$(100.0 * deckend / gesamt, "%.1f") + " %)" + CHR$(10) + _
        "davon durchsichtig:   " + STR$(gesamt - deckend) + _
        "  (" + FORMAT$(100.0 * (gesamt - deckend) / gesamt, "%.1f") + " %)" + CHR$(10) + _
        "verschiedene Farben:  " + STR$(MAPSIZE(statZaehl)) + CHR$(10)
    IF haeufig >= 0 THEN
        t = t + "haeufigste Farbe:     " + COLOR_HEX$(haeufig) + _
            "  (" + STR$(hAnz) + " Punkte)" + CHR$(10)
    END IF
    IF anzBild > 1 THEN t = t + CHR$(10) + "Je Bild:" + CHR$(10) + proBild
    RETURN t
END FUNCTION

' ---------------------------------------------------------------- Palette
' GIMP-Palette (.gpl). Ein Textformat, und genau deshalb interessant: es ist
' das, was Aseprite, GIMP, Krita und die Sammlungen im Netz sprechen.
'
'     GIMP Palette
'     Name: Irgendwas
'     Columns: 8
'     # ein Kommentar
'     255   0   0     Rot
'
' Die Trennung ist BELIEBIG viel Leerraum, auch Tabulatoren -- SPLIT$ liefert
' dafuer leere Stuecke, die uebergangen werden muessen.
FUNCTION nurZiffern(t AS STRING) AS BOOLEAN
    IF LEN(t) = 0 THEN RETURN FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(t) - 1
        DIM c AS INTEGER : c = ASC(MID$(t, i, 1))
        IF c < 48 OR c > 57 THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

' Liefert die Zahl der uebernommenen Farben. Eine Zeile, die nicht passt,
' wird UEBERGANGEN statt gemeldet -- .gpl-Dateien werden von Hand bearbeitet,
' und eine einzelne krumme Zeile darf nicht die ganze Palette verhindern.
FUNCTION paletteLaden(pfad AS STRING) AS INTEGER
    DIM zeilen AS ARRAY OF STRING
    zeilen = READLINES(pfad)
    DIM n AS INTEGER : n = 0
    DIM gesamt AS INTEGER : gesamt = 0
    DIM z AS STRING
    FOR EACH z IN zeilen
        DIM t AS STRING : t = TRIM$(z)
        IF t <> "" AND LEFT$(t, 1) <> "#" AND LEFT$(t, 4) <> "GIMP" _
           AND LEFT$(t, 5) <> "Name:" AND LEFT$(t, 8) <> "Columns:" THEN
            DIM teile AS ARRAY OF STRING
            teile = SPLIT$(REPLACE$(t, CHR$(9), " "), " ")
            DIM w[3] AS INTEGER
            DIM k AS INTEGER : k = 0
            DIM st AS STRING
            FOR EACH st IN teile
                IF k < 3 AND st <> "" THEN
                    IF nurZiffern(st) THEN
                        w[k] = VAL(st) : k = k + 1
                    ELSE
                        k = 99            ' Wortzeile -- diese Zeile faellt aus
                    END IF
                END IF
            NEXT
            ' Werte ausserhalb 0..255 uebergehen: eine von Hand verdrehte
            ' Zeile ("300 300 300") wuerde sonst eine unsinnige Farbe geben.
            IF k = 3 AND w[0] <= 255 AND w[1] <= 255 AND w[2] <= 255 THEN
                gesamt = gesamt + 1
                IF n < 16 THEN
                    pal[n] = RGB(w[0], w[1], w[2])
                    n = n + 1
                END IF
            END IF
        END IF
    NEXT
    ' Die Palette hat 16 Plaetze. Was darueber hinausgeht, sagen statt es
    ' still fallen zu lassen -- Paletten aus dem Netz haben oft 32 oder mehr.
    IF gesamt > 16 THEN
        meldung = "16 von " + STR$(gesamt) + " Farben aus " + BASENAME(pfad)
    ELSE
        meldung = STR$(n) + " Farben aus " + BASENAME(pfad)
    END IF
    RETURN n
END FUNCTION

SUB paletteSichern(pfad AS STRING)
    DIM name AS STRING : name = BASENAME(pfad)
    IF LEN(name) > 4 AND RIGHT$(LOWER$(name), 4) = ".gpl" THEN
        name = LEFT$(name, LEN(name) - 4)
    END IF
    ' Zeilenenden ausdruecklich als CHR$(10): so schreibt es auch GIMP. Ein
    ' Leser, der am Zeilenvorschub trennt, bekommt dann keine
    ' Wagenruecklauf-Reste an den Enden.
    DIM t AS STRING
    t = "GIMP Palette" + CHR$(10) + "Name: " + name + CHR$(10) + _
        "Columns: 8" + CHR$(10) + "#" + CHR$(10)
    DIM i AS INTEGER
    FOR i = 0 TO 15
        DIM c AS INTEGER : c = pal[i]
        t = t + STR$((c \ 65536) MOD 256) + " " + STR$((c \ 256) MOD 256) + " " + _
            STR$(c MOD 256) + CHR$(9) + "Farbe " + STR$(i + 1) + CHR$(10)
    NEXT
    WRITEALL(pfad, t)
    meldung = "Palette gesichert: " + BASENAME(pfad)
END SUB

' -------------------------------------------------------------- Verschieben
' Die Auswahl (oder, ohne Auswahl, die ganze Ebene) vom Bild ABHEBEN: die
' Punkte kommen nach movF/movA und werden im Bild geloescht. Deshalb sieht
' man beim Ziehen ein Loch und nicht eine Kopie -- verschieben heisst
' verschieben.
SUB abheben()
    IF selAn THEN
        movX = selX : movY = selY : movB = selB : movH = selH
    ELSE
        movX = 0 : movY = 0 : movB = gw : movH = gh
    END IF
    DIM bild AS IMAGE : bild = ebene[aktBild, aktEb]
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 0 TO movH - 1
        FOR x = 0 TO movB - 1
            DIM i AS INTEGER : i = y * movB + x
            IF gewaehlt(movX + x, movY + y) THEN
                movM[i] = 1
                movF[i] = GETPIXEL(bild, movX + x, movY + y)
                movA[i] = GETALPHA(bild, movX + x, movY + y)
                IF movA[i] > 0 THEN IMAGE_CLEAR(bild, movX + x, movY + y, 1, 1)
            ELSE
                movM[i] = 0 : movA[i] = 0
            END IF
        NEXT
    NEXT
    schwebt = TRUE
    verX = 0 : verY = 0
END SUB

' ... und um (verX, verY) versetzt wieder absetzen.
SUB absetzen()
    DIM bild AS IMAGE : bild = ebene[aktBild, aktEb]
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM raus AS INTEGER : raus = 0
    FOR y = 0 TO movH - 1
        FOR x = 0 TO movB - 1
            DIM i AS INTEGER : i = y * movB + x
            IF movM[i] = 1 AND movA[i] > 0 THEN
                DIM zx AS INTEGER : zx = movX + x + verX
                DIM zy AS INTEGER : zy = movY + y + verY
                IF zx >= 0 AND zy >= 0 AND zx < gw AND zy < gh THEN
                    IMAGE_DRAW_RECT(bild, zx, zy, 1, 1, mitAlpha(movF[i], movA[i]))
                ELSE
                    raus = raus + 1
                END IF
            END IF
        NEXT
    NEXT
    ' Die Auswahl wandert MIT. Bliebe sie liegen, zeigte sie auf die Stelle,
    ' wo das Verschobene gerade NICHT mehr ist -- und der naechste Strich
    ' landete dort.
    IF selAn THEN
        maskeBeginn()
        FOR y = 0 TO movH - 1
            FOR x = 0 TO movB - 1
                IF movM[y * movB + x] = 1 THEN maskeAdd(movX + x + verX, movY + y + verY)
            NEXT
        NEXT
        maskeEnde()
    END IF
    schwebt = FALSE
    ' Was ueber den Rand hinausgeschoben wurde, ist weg. Das ist ueblich --
    ' aber es still zu tun waere es nicht.
    IF raus > 0 THEN meldung = STR$(raus) + " Punkte ueber den Rand hinaus -- weg"
END SUB

' Die Auswahl leeren -- Ausschneiden und Entf teilen sich das. Punktweise,
' weil eine Freiform kein Rechteck ist; im schlimmsten Fall (128x128 ganz
' gewaehlt) sind das gemessen rund 70 ms, und das genau einmal je Tastendruck.
SUB auswahlLeeren()
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = selY TO selY + selH - 1
        FOR x = selX TO selX + selB - 1
            IF gewaehlt(x, y) THEN IMAGE_CLEAR(ebene[aktBild, aktEb], x, y, 1, 1)
        NEXT
    NEXT
END SUB

' ---------------------------------------------------------------- Fuellen
SUB fluten(sx AS INTEGER, sy AS INTEGER, neu AS INTEGER)
    DIM bild AS IMAGE : bild = ebene[aktBild, aktEb]
    DIM zf AS INTEGER : zf = GETPIXEL(bild, sx, sy)
    DIM za AS INTEGER : za = GETALPHA(bild, sx, sy)
    ' Farbe UND Deckkraft muessen stimmen. Ohne die Deckkraft laeuft die
    ' Fuellung ueber leere Punkte, die zufaellig schwarz gespeichert sind.
    IF zf = neu AND za = 255 THEN
        meldung = "schon diese Farbe"
    ELSE
        DIM n AS INTEGER : n = 1
        flutX[0] = sx : flutY[0] = sy
        WHILE n > 0
            n = n - 1
            DIM x AS INTEGER : x = flutX[n]
            DIM y AS INTEGER : y = flutY[n]
            IF x >= 0 AND y >= 0 AND x < gw AND y < gh THEN
                ' `gewaehlt` haelt die Fuellung in der Auswahl -- ohne das
                ' liefe sie unter dem Lasso hindurch und der ganze Sinn
                ' einer Freiform-Auswahl waere weg.
                IF gewaehlt(x, y) AND GETPIXEL(bild, x, y) = zf AND GETALPHA(bild, x, y) = za THEN
                    IMAGE_DRAW_RECT(bild, x, y, 1, 1, neu)
                    IF n + 4 < MAXPKT THEN
                        flutX[n] = x - 1 : flutY[n] = y : n = n + 1
                        flutX[n] = x + 1 : flutY[n] = y : n = n + 1
                        flutX[n] = x : flutY[n] = y - 1 : n = n + 1
                        flutX[n] = x : flutY[n] = y + 1 : n = n + 1
                    END IF
                END IF
            END IF
        WEND
    END IF
END SUB

' ----------------------------------------------------------- Ausgabe
SUB baueStreifen()
    IMAGE_CLEAR(streifen)
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO anzBild - 1
        FOR k = 0 TO anzEb - 1
            IF ebSicht[k] = 1 THEN
                IMAGE_DRAW_IMAGE(streifen, ebene[i, k], i * gw, 0)
            END IF
        NEXT
    NEXT
END SUB

' Der Schluessel eines Einzelbildes im Atlas: sein Name, sonst `bild_<n>`.
' Ein Name, den es schon gibt, bekommt die Nummer angehaengt -- zwei gleiche
' Schluessel waeren ein Eintrag, und einer der beiden Ausschnitte fiele
' stillschweigend weg.
FUNCTION atlasName$(i AS INTEGER) AS STRING
    IF bildName[i] = "" THEN RETURN "bild_" + STR$(i)
    DIM k AS INTEGER
    FOR k = 0 TO i - 1
        IF bildName[k] = bildName[i] THEN RETURN bildName[i] + "_" + STR$(i)
    NEXT
    RETURN bildName[i]
END FUNCTION

FUNCTION atlasJson$(pngName AS STRING) AS STRING
    ' Genau die Form, die ATLAS_LOAD liest -- und die `streifenLaden` unten
    ' wieder aufmacht.
    '
    ' Frueher stand hier von Hand zusammengesetzter Text, mit der Begruendung,
    ' fuer eine so flache Datei sei das kuerzer. Das galt, solange alle
    ' Schluessel `bild_0`, `bild_1` hiessen. Seit sie NUTZERTEXT enthalten
    ' koennen, gilt es nicht mehr: ein Anfuehrungszeichen im Namen zerbraeche
    ' die Datei, und Maskierung will man nicht selbst schreiben.
    DIM h AS JSON_HANDLE : h = JSON_NEW_OBJECT()
    JSON_SET_STRING(h, "image", pngName)
    JSON_SET_JSON(h, "sprites", JSON_NEW_OBJECT())
    DIM i AS INTEGER
    FOR i = 0 TO anzBild - 1
        ' JSON_APPEND_* haengt an ein Feld UNTER einem Pfad an, nicht an ein
        ' loses Feld -- also erst den Platz anlegen, dann dorthin anhaengen.
        DIM pf2 AS STRING : pf2 = "sprites." + atlasName$(i)
        JSON_SET_JSON(h, pf2, JSON_NEW_ARRAY())
        JSON_APPEND_INT(h, pf2, i * gw)
        JSON_APPEND_INT(h, pf2, 0)
        JSON_APPEND_INT(h, pf2, gw)
        JSON_APPEND_INT(h, pf2, gh)
    NEXT
    RETURN JSON_PRETTY(h)
END FUNCTION

' ---------------------------------------------------------------- Laden
' ---------------------------------------------------------------- .dhsprite
' Das eigene Format: ein RASTER-PNG (Spalten = Einzelbilder, Zeilen =
' Ebenen) und eine JSON-Datei daneben mit Massen, Ebenennamen und
' Sichtbarkeit. Der Streifen kann das nicht -- er ist das
' zusammengerechnete Bild.
'
' Warum nicht alles in EINE Datei? Weil ein PNG, das jeder Bildbetrachter
' oeffnet, mehr wert ist als ein Format, das nur sein Erzeuger ansehen kann.
' Die Pixel in JSON zu stecken (base64) haette beides verloren: lesbar waere
' es auch nicht, und schreiben muesste man es Punkt fuer Punkt.
FUNCTION rasterPfad$(pfad AS STRING) AS STRING
    RETURN pfad + ".png"
END FUNCTION

' Alle Einzelbilder als bewegtes GIF. Jedes wird vorher zusammengerechnet --
' ein GIF kennt keine Ebenen, und "unsichtbar" heisst hier: kommt nicht mit.
SUB gifSichern(pfad AS STRING, fps AS FLOAT)
    DIM ausgabe[MAXBILD] AS IMAGE
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO anzBild - 1
        ausgabe[i] = IMAGE_NEW(gw, gh)
        FOR k = 0 TO anzEb - 1
            IF ebSicht[k] = 1 THEN IMAGE_DRAW_IMAGE(ausgabe[i], ebene[i, k], 0, 0)
        NEXT
    NEXT
    ' `anzahl` sagt, wie viele Plaetze des Feldes gelten -- ohne das kaemen
    ' die unbenutzten als leere Bilder mit in die Bewegung.
    IMAGE_SAVE_GIF(ausgabe, pfad, fps, TRUE, anzBild)
    FOR i = 0 TO anzBild - 1
        IMAGE_FREE(ausgabe[i])
    NEXT
    meldung = STR$(anzBild) + " Bilder mit " + FORMAT$(fps, "%.0f") + "/s: " + BASENAME(pfad)
END SUB

SUB nativSichern(pfad AS STRING)
    ' Raster aufbauen: Spalte = Einzelbild, Zeile = Ebene.
    DIM raster AS IMAGE : raster = IMAGE_NEW(gw * anzBild, gh * anzEb)
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO anzBild - 1
        FOR k = 0 TO anzEb - 1
            IMAGE_DRAW_IMAGE(raster, ebene[i, k], i * gw, k * gh)
        NEXT
    NEXT
    IMAGE_SAVE(raster, rasterPfad$(pfad))
    IMAGE_FREE(raster)

    ' Die Beschreibung ueber das json-Modul, nicht von Hand: Ebenennamen
    ' sind Nutzertext, und die Maskierung will man nicht selbst schreiben.
    DIM h AS JSON_HANDLE : h = JSON_NEW_OBJECT()
    JSON_SET_STRING(h, "format", "dhsprite-gitter-1")
    JSON_SET_STRING(h, "bild", BASENAME(rasterPfad$(pfad)))
    JSON_SET_INT(h, "breite", gw)
    JSON_SET_INT(h, "hoehe", gh)
    JSON_SET_INT(h, "bilder", anzBild)
    JSON_SET_JSON(h, "ebenen", JSON_NEW_ARRAY())
    FOR k = 0 TO anzEb - 1
        DIM e AS JSON_HANDLE : e = JSON_NEW_OBJECT()
        JSON_SET_STRING(e, "name", ebName[k])
        JSON_SET_BOOL(e, "sichtbar", ebSicht[k] = 1)
        JSON_APPEND_JSON(h, "ebenen", e)
    NEXT
    ' Die Bereiche gehoeren zum Sprite, nicht zur Sitzung -- ohne sie waere
    ' der Lauf beim naechsten Oeffnen wieder namenlos.
    ' Namen der Einzelbilder -- nur wenn es welche gibt, sonst blaeht ein
    ' Feld voller Leerstrings jede Datei auf.
    DIM hatNamen AS BOOLEAN : hatNamen = FALSE
    FOR k = 0 TO anzBild - 1
        IF bildName[k] <> "" THEN hatNamen = TRUE
    NEXT
    IF hatNamen THEN
        JSON_SET_JSON(h, "bildnamen", JSON_NEW_ARRAY())
        FOR k = 0 TO anzBild - 1
            JSON_APPEND_STRING(h, "bildnamen", bildName[k])
        NEXT
    END IF
    IF anzAnim > 0 THEN
        JSON_SET_JSON(h, "bereiche", JSON_NEW_ARRAY())
        FOR k = 0 TO anzAnim - 1
            DIM ab AS JSON_HANDLE : ab = JSON_NEW_OBJECT()
            JSON_SET_STRING(ab, "name", anName[k])
            JSON_SET_INT(ab, "von", anVon[k])
            JSON_SET_INT(ab, "bis", anBis[k])
            JSON_SET_INT(ab, "fps", anFps[k])
            JSON_APPEND_JSON(h, "bereiche", ab)
        NEXT
    END IF
    WRITEALL(pfad, JSON_PRETTY(h))
    meldung = STR$(anzBild) + " Bilder x " + STR$(anzEb) + " Ebenen: " + BASENAME(pfad)
END SUB

SUB nativLaden(pfad AS STRING)
    DIM h AS JSON_HANDLE : h = JSON_LOAD(pfad)
    DIM bw AS INTEGER : bw = JSON_GET_INT(h, "breite")
    DIM bh AS INTEGER : bh = JSON_GET_INT(h, "hoehe")
    DIM nb AS INTEGER : nb = JSON_GET_INT(h, "bilder")
    DIM ne AS INTEGER : ne = JSON_LEN(h, "ebenen")
    IF bw < 1 OR bh < 1 OR bw > MAXG OR bh > MAXG OR nb < 1 OR ne < 1 THEN
        meldung = "Das ist keine brauchbare .dhsprite-Beschreibung."
    ELSE
        ' Der Bildname steht in der Datei, gesucht wird aber NEBEN ihr --
        ' sonst bricht ein verschobenes Paar auseinander.
        DIM bild AS STRING : bild = rasterPfad$(pfad)
        IF NOT FILEEXISTS(bild) THEN
            meldung = "Das Raster fehlt: " + bild
        ELSE
            DIM raster AS IMAGE : raster = LOADIMAGE(bild)
            neuesSprite(bw, bh)
            anzBild = MIN(nb, MAXBILD)
            anzEb = MIN(ne, MAXEB)
            DIM i AS INTEGER
            DIM k AS INTEGER
            FOR k = 0 TO anzEb - 1
                ebName[k] = JSON_GET_STRING(h, "ebenen." + STR$(k) + ".name")
                IF ebName[k] = "" THEN ebName[k] = "Ebene " + STR$(k + 1)
                ebSicht[k] = IIF(JSON_GET_BOOL(h, "ebenen." + STR$(k) + ".sichtbar"), 1, 0)
                FOR i = 0 TO anzBild - 1
                    IMAGE_DRAW_IMAGE(ebene[i, k], raster, 0, 0, i * bw, k * bh, bw, bh)
                NEXT
            NEXT
            IMAGE_FREE(raster)
            aktBild = 0 : aktEb = 0
            ' Bereiche, falls die Datei welche hat. Eine aeltere .dhsprite
            ' hat sie nicht -- das ist kein Fehler, sondern der Normalfall
            ' fuer alles, was vor heute gesichert wurde.
            DIM nn2 AS INTEGER : nn2 = MIN(JSON_LEN(h, "bildnamen"), anzBild)
            DIM q3 AS INTEGER
            FOR q3 = 0 TO nn2 - 1
                bildName[q3] = alsName$(JSON_GET_STRING(h, "bildnamen." + STR$(q3)))
            NEXT
            anzAnim = MIN(JSON_LEN(h, "bereiche"), MAXANIM)
            DIM q AS INTEGER
            FOR q = 0 TO anzAnim - 1
                DIM pf AS STRING : pf = "bereiche." + STR$(q) + "."
                anName[q] = JSON_GET_STRING(h, pf + "name")
                IF anName[q] = "" THEN anName[q] = "bereich" + STR$(q + 1)
                anVon[q] = MAX(0, MIN(anzBild - 1, JSON_GET_INT(h, pf + "von")))
                anBis[q] = MAX(anVon[q], MIN(anzBild - 1, JSON_GET_INT(h, pf + "bis")))
                anFps[q] = MAX(1, JSON_GET_INT(h, pf + "fps"))
            NEXT
            aktAnim = IIF(anzAnim > 0, 0, -1)
            listenAuffrischen()
            meldung = STR$(anzBild) + " Bilder x " + STR$(anzEb) + " Ebenen aus " + BASENAME(pfad)
        END IF
    END IF
END SUB

' Einen Streifen samt Atlas-JSON zurueckholen. Die Ebenen sind dabei weg:
' der Streifen ist das ZUSAMMENGERECHNETE Bild, jedes Einzelbild kommt also
' auf einer Ebene zurueck. Das ist keine Nachlaessigkeit, sondern steht so
' in der Datei.
SUB streifenLaden(pngPfad AS STRING)
    DIM jsonPfad AS STRING : jsonPfad = REPLACE$(pngPfad, ".png", ".json")
    IF NOT FILEEXISTS(jsonPfad) THEN
        meldung = "Kein Atlas daneben: " + jsonPfad
    ELSE
        DIM h AS JSON_HANDLE : h = JSON_LOAD(jsonPfad)
        DIM namen AS ARRAY OF STRING : namen = JSON_KEYS(h, "sprites")
        IF LEN(namen) = 0 THEN
            meldung = "Der Atlas nennt keine Bilder."
        ELSE
            ' Die Groesse kommt aus dem ERSTEN Eintrag. Ein Streifen mit
            ' verschieden grossen Feldern ist keiner -- alles andere wird auf
            ' dieses Mass zugeschnitten.
            DIM n AS INTEGER : n = MIN(LEN(namen), MAXBILD)
            DIM bw AS INTEGER : bw = JSON_GET_INT(h, "sprites." + namen[0] + ".2")
            DIM bh AS INTEGER : bh = JSON_GET_INT(h, "sprites." + namen[0] + ".3")
            IF bw < 1 OR bh < 1 OR bw > MAXG OR bh > MAXG THEN
                meldung = "Bildgroesse " + STR$(bw) + "x" + STR$(bh) + " geht nicht."
            ELSE
                DIM blatt AS IMAGE : blatt = LOADIMAGE(pngPfad)
                neuesSprite(bw, bh)
                anzBild = n
                DIM i AS INTEGER
                FOR i = 0 TO n - 1
                    DIM qx AS INTEGER : qx = JSON_GET_INT(h, "sprites." + namen[i] + ".0")
                    DIM qy AS INTEGER : qy = JSON_GET_INT(h, "sprites." + namen[i] + ".1")
                    IMAGE_DRAW_IMAGE(ebene[i, 0], blatt, 0, 0, qx, qy, bw, bh)
                    ' Der Schluessel IST der Name -- ausser er ist der
                    ' namenlose Vorgabe-Schluessel. Damit kommt ein Streifen
                    ' mit seinen Namen zurueck, statt sie beim Rundweg zu
                    ' verlieren.
                    IF namen[i] = "bild_" + STR$(i) THEN
                        bildName[i] = ""
                    ELSE
                        bildName[i] = alsName$(namen[i])
                    END IF
                NEXT
                ' Das Blatt hat seinen Zweck erfuellt -- ohne Freigabe bliebe
                ' bei jedem Oeffnen eine Textur liegen.
                IMAGE_FREE(blatt)
                aktBild = 0
                listenAuffrischen()
                meldung = STR$(n) + " Bilder aus " + BASENAME(pngPfad)
                IF LEN(namen) > MAXBILD THEN
                    meldung = meldung + " (von " + STR$(LEN(namen)) + ", Rest passt nicht)"
                END IF
            END IF
        END IF
    END IF
END SUB

' ============================================================ Oberflaeche

CONST TB_H = 46
CONST LINKS = 300
CONST RECHTS = 340

DIM win AS GUI_WINDOW
win = GUI_WINDOW("Sprite", 0, 0, SW, SH)
GUI_WINDOW_CHROME(win, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(win, 0, 0, SW, TB_H)
GUI_SET_ANCHOR(tb, "lr")

' Die Dateiknoepfe. Ihre Breiten sind gerechnet, nicht geraten -- der
' "Oeffnen"-Knopf lag vorher UNTER dem ersten Werkzeug und war damit gar
' nicht anklickbar. Das zeigt kein Test, nur das gerenderte Bild.
DIM bNeu AS GUI_WIDGET     : bNeu     = GUI_BUTTON(win, "Neu", 10, 7, 52, 32)
DIM bOeffnen AS GUI_WIDGET : bOeffnen = GUI_BUTTON(win, "Oeffnen", 66, 7, 74, 32)
GUI_TOOLTIP(bOeffnen, "Eigenes Format (.dhsprite, mit Ebenen) ODER einen Streifen + Atlas")
DIM bSichern AS GUI_WIDGET : bSichern = GUI_BUTTON(win, "Sichern", 144, 7, 74, 32)
GUI_TOOLTIP(bSichern, "Eigenes Format .dhsprite -- behaelt Ebenen und Namen")
DIM bPng AS GUI_WIDGET     : bPng     = GUI_BUTTON(win, "PNG", 222, 7, 52, 32)
GUI_TOOLTIP(bPng, "Nur das aktuelle Einzelbild, zusammengerechnet")
DIM bBlatt AS GUI_WIDGET   : bBlatt   = GUI_BUTTON(win, "Streifen", 278, 7, 86, 32)
GUI_TOOLTIP(bBlatt, "Alle Einzelbilder nebeneinander als PNG + Atlas-JSON (ohne Ebenen)")
DIM bGif AS GUI_WIDGET     : bGif     = GUI_BUTTON(win, "GIF", 368, 7, 52, 32)
GUI_TOOLTIP(bGif, "Alle Einzelbilder als bewegtes GIF -- Tempo aus dem Vorschau-Regler")

' Zwoelf Werkzeuge auf demselben Platz wie vorher neun: die Knopfbreite ist
' aus der Zahl gerechnet, damit alles rechts davon (Zurueck/Vor, die
' Schalter) stehen bleibt, wo es war.
CONST WZ_B = 64
DIM wzName AS ARRAY OF STRING
wzName = SPLIT$("Stift|Radierer|Fuellen|Linie|Rechteck|Ellipse|Spruehen|Pipette|Auswahl|Lasso|Zauber|Schieben", "|")
DIM wzKnopf[WZ_ANZ] AS GUI_WIDGET
DIM wx AS INTEGER : wx = 432
DIM i AS INTEGER
FOR i = 0 TO WZ_ANZ - 1
    wzKnopf[i] = GUI_BUTTON(win, wzName[i], wx, 7, WZ_B, 32)
    wx = wx + WZ_B + 4
NEXT
GUI_TOOLTIP(wzKnopf[WZ_AUSWAHL], "Rechteck aufziehen (S) -- Klick ohne Zug hebt die Auswahl auf")
GUI_TOOLTIP(wzKnopf[WZ_LASSO], "Freiform umfahren (Q) -- der Weg schliesst sich von selbst")
GUI_TOOLTIP(wzKnopf[WZ_ZAUBER], "Zusammenhaengende Flaeche gleicher Farbe waehlen (Z)")
GUI_TOOLTIP(wzKnopf[WZ_VERSCHIEB], "Die Auswahl versetzen (V) -- ohne Auswahl die ganze Ebene")

DIM bZur AS GUI_WIDGET : bZur = GUI_BUTTON(win, "Zurueck", wx + 10, 7, 84, 32)
DIM bVor AS GUI_WIDGET : bVor = GUI_BUTTON(win, "Vor", wx + 98, 7, 56, 32)
DIM cbGefuellt AS GUI_WIDGET : cbGefuellt = GUI_CHECKBOX(win, "gefuellt", wx + 164, 15, FALSE)
DIM cbSymX AS GUI_WIDGET : cbSymX = GUI_CHECKBOX(win, "Spiegel X", wx + 254, 15, FALSE)
DIM cbSymY AS GUI_WIDGET : cbSymY = GUI_CHECKBOX(win, "Spiegel Y", wx + 358, 15, FALSE)
DIM cbZwiebel AS GUI_WIDGET : cbZwiebel = GUI_CHECKBOX(win, "Zwiebelhaut", wx + 462, 15, FALSE)
DIM cbRaster AS GUI_WIDGET : cbRaster = GUI_CHECKBOX(win, "Raster", wx + 580, 15, TRUE)

' ------------------------------------------------------------ links: Farbe
DIM y AS INTEGER : y = TB_H + 12
DIM lbl AS GUI_WIDGET
lbl = GUI_LABEL(win, "Farbe", 12, y) : y = y + 22
DIM cp AS GUI_WIDGET : cp = GUI_COLORPICKER(win, 12, y, LINKS - 24, 170)
GUI_SET_PICKED_COLOR(cp, farbe)
y = y + 182

lbl = GUI_LABEL(win, "Palette   (1..6 waehlen)", 12, y) : y = y + 22
DIM palY AS INTEGER : palY = y
