' Ein Posten der Einkaufsliste (shopping_list), dazu der Gang im gewählten
' Markt, wenn die Liste danach sortiert ist.
CLASS Posten
    DIM id AS INTEGER
    DIM name AS STRING
    DIM menge AS FLOAT
    DIM einheit AS STRING
    DIM kategorie AS STRING
    DIM notizen AS STRING
    DIM erledigt AS BOOLEAN
    DIM prioritaet AS INTEGER
    ' 999 = ohne Gang (ans Ende), gangName die Abteilung, die ihn bestimmt hat.
    DIM gang AS INTEGER
    DIM gangName AS STRING

    ' "2 Liter", ohne Menge "-" -- wie die Python-App.
    FUNCTION mengeText$() AS STRING
        IF Self.menge = 0 THEN RETURN "-"
        RETURN zahlText$(Self.menge) + " " + einheitText$(Self.einheit)
    END FUNCTION

    FUNCTION gangText$() AS STRING
        IF Self.gang = 0 OR Self.gang = GANG_ENDE THEN RETURN "-"
        RETURN STR$(Self.gang)
    END FUNCTION
END CLASS

CONST GANG_ENDE = 999
