Deckchen: Untersetzer Rund 40x40 | Untersetzer Groß 60x60 | Deckchen Klein 80x80 | Deckchen Mittel 120x120 | Tischläufer Kurz 40x150 | Tischläufer Lang 40x250
Bordüren: Bordüre Schmal 20x200 | Bordüre Mittel 35x200 | Bordüre Breit 50x200 | Borte Endlos 30x400
Bilder: Mini-Bild 40x40 | Kleines Bild 60x80 | Mittleres Bild 100x120 | Großes Bild 150x200 | Wandbild 200x250
Kissen: Nadelkissen 30x30 | Duftkissen 50x50 | Sofakissen Klein 100x100 | Sofakissen Groß 140x140
Accessoires: Schlüsselanhänger 20x30 | Taschenspiegel 35x35 | Brillenetui 35x70 | Handytasche 40x80 | Geldbörse 50x40
Weihnachten: Baumschmuck Klein 25x25 | Baumschmuck Groß 40x50 | Nikolausstiefel 60x80 | Adventskalender 120x150
dp — Keine Auswahl (eigene Werte) — = 0x0
dp DP A4 quadratisch (60×60 = 15×15 cm) = 60x60
dp DP A4 hoch (60×80 = 15×20 cm) = 60x80
dp DP A4 quer (80×60 = 20×15 cm) = 80x60
dp DP A3 (100×100 = 25×25 cm) = 100x100
dp DP A3 quer (140×100 = 35×25 cm) = 140x100
dp DP A2 (150×150 = 38×38 cm) = 150x150
dp DP A2 quer (200×150 = 50×38 cm) = 200x150
dp DP A1 (200×200 = 50×50 cm) = 200x200
dp DP A1 quer (280×200 = 70×50 cm) = 280x200
dp DP A0 (300×300 = 75×75 cm) = 300x300
dp DP Gross (400×400 = 100×100 cm) = 400x400
rundweg Mein Kissen 90x90 16 Kissen 7
rundweg Nur Pflicht 30x40 14 Eigene 0
rundweg Kommabreite 12x20 14 Eigene 0
rundweg Äpfel 7x8 11 Eigene 0
rundweg Neu "mit" Zeichen 11x22 18 Saisonal 15
kaputt: 0 fehlt: 0

=== eigenschaften: setzen, leer nimmt heraus, notizen aus dem pdf
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
PRINT "schluessel: "; JOIN$(kern.eigenschaftenSchluessel(), " ")
PRINT "setzen: "; kern.eigenschaftSetzen(m, "author", "  Anna  "); " nochmal: "; kern.eigenschaftSetzen(m, "author", "Anna"); " | '"; kern.eigenschaft$(m, "author"); "'"
JSON_SET_STRING(m.metadaten, "pdf_notes", "aus dem pdf")
PRINT "notizen: "; kern.notizen$(m)
PRINT "eigene notizen: "; kern.eigenschaftSetzen(m, "notes", "eigene"); " "; kern.notizen$(m)
PRINT "leer: "; kern.eigenschaftSetzen(m, "author", " "); " "; JSON_HAS(m.metadaten, "author"); " nochmal leer: "; kern.eigenschaftSetzen(m, "author", "")
JSON_SET_INT(m.metadaten, "copyright", 7)
PRINT "zahl: '"; kern.eigenschaft$(m, "copyright"); "'"
PRINT "stoff: "; kern.stoffBezeichnung$(m)
m.modus = "diamond"
DIM s AS FLOAT
FOR EACH s IN [10.0, 9.0, 8.0, 12.5]
    m.stoff = s
    PRINT "  "; kern.stoffBezeichnung$(m)
NEXT
PRINT "cm: "; FORMAT$(kern.fertigCm(140, 14), "%.2f"); " "; FORMAT$(kern.fertigCm(100, 16), "%.2f")
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_verwalten.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- datei probe.pxs
