FUNCTION Summe(a AS INTEGER, b AS INTEGER, c AS INTEGER) AS INTEGER
    RETURN a + b + c
END FUNCTION
FUNCTION Satz(wer AS STRING, wie AS STRING) AS STRING
    RETURN wer + " ist " + wie
END FUNCTION
