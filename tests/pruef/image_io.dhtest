=== freigeben wirft das bild aus dem pfad cache
' Bliebe der Eintrag stehen, bekaeme der naechste LOADIMAGE fuer denselben Pfad
' ein freigegebenes Bild -- ohne jeden Hinweis.
' (Bis Stufe 46 in test_image_io.py.)
IMPORT "imgfx"
SCREEN(160, 80, "t", 1)
DIM q AS IMAGE : q = IMAGE_NEW(8, 8, &HFF0000)
IMAGE_SAVE(q, "x.png")
DIM a AS IMAGE : a = LOADIMAGE("x.png")
IMAGE_FREE(a)
DIM b AS IMAGE : b = LOADIMAGE("x.png")
PRINT IMAGEWIDTH(b); " "; (b = a)
--- umgebung
DHRT_FRAMES=2
--- erwartet
8 FALSE

=== das gif hat die bilder und das tempo
' 8 Bilder/s -> 100/8 = 12,5 -> 13 Hundertstel -> 130 ms; Schleife 0 = endlos.
' (Bis Stufe 46 in test_image_io.py.)
IMPORT "imgfx"
SCREEN(160, 80, "t", 1)
DIM gb AS BUFFER
FUNCTION zaehle(hex AS STRING) AS INTEGER
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_HEX(hex)
    DIM z AS INTEGER : z = 0
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, nadel)
    WHILE p >= 0
        z = z + 1
        p = BUFFER_INDEXOF(gb, nadel, p + 1)
    WEND
    RETURN z
END FUNCTION
FUNCTION dauern$() AS STRING
    ' Graphic Control Extension: 21 F9 04, Schalter, Verzoegerung (Hundertstel, LE)
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_HEX("21F904")
    DIM r AS STRING : r = ""
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, nadel)
    WHILE p >= 0
        r = r + STR$((BUFFER_GET(gb, p + 4) + BUFFER_GET(gb, p + 5) * 256) * 10) + " "
        p = BUFFER_INDEXOF(gb, nadel, p + 1)
    WEND
    RETURN TRIM$(r)
END FUNCTION
FUNCTION schleife$() AS STRING
    ' NETSCAPE2.0, dann 03 01 und die Wiederholzahl (0 = endlos)
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, BUFFER_FROM_STRING("NETSCAPE2.0"))
    IF p < 0 THEN RETURN "keine"
    RETURN STR$(BUFFER_GET(gb, p + 13) + BUFFER_GET(gb, p + 14) * 256)
END FUNCTION
DIM b[3] AS IMAGE
DIM f AS ARRAY OF INTEGER : f = [&HE84B4B, &H4BE87A, &H2BC4E8]
DIM i AS INTEGER
FOR i = 0 TO 2
    b[i] = IMAGE_NEW(8, 8)
    IMAGE_DRAW_RECT(b[i], i * 2, 1, 2, 6, f[i])
NEXT
IMAGE_SAVE_GIF(b, "a.gif", 8)
gb = READALL_BYTES("a.gif")
PRINT "kopf "; BUFFER_GET(gb, 0) = 71 AND BUFFER_GET(gb, 1) = 73 AND BUFFER_GET(gb, 2) = 70
PRINT "masse "; BUFFER_GET(gb, 6); " "; BUFFER_GET(gb, 8)
PRINT "bilder "; zaehle("21F904")
PRINT "dauern "; dauern$()
PRINT "schleife "; schleife$()
--- umgebung
DHRT_FRAMES=2
--- erwartet
kopf TRUE
masse 8 8
bilder 3
dauern 130 130 130
schleife 0

=== jedes bild kann seine eigene dauer haben
' Der dritte Parameter ist ZWEIERLEI: eine Zahl sind Bilder je Sekunde fuer
' alle, ein FELD ist die Dauer je Bild in Millisekunden.
' (Bis Stufe 46 in test_image_io.py.)
IMPORT "imgfx"
SCREEN(160, 80, "t", 1)
DIM gb AS BUFFER
FUNCTION zaehle(hex AS STRING) AS INTEGER
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_HEX(hex)
    DIM z AS INTEGER : z = 0
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, nadel)
    WHILE p >= 0
        z = z + 1
        p = BUFFER_INDEXOF(gb, nadel, p + 1)
    WEND
    RETURN z
END FUNCTION
FUNCTION dauern$() AS STRING
    ' Graphic Control Extension: 21 F9 04, Schalter, Verzoegerung (Hundertstel, LE)
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_HEX("21F904")
    DIM r AS STRING : r = ""
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, nadel)
    WHILE p >= 0
        r = r + STR$((BUFFER_GET(gb, p + 4) + BUFFER_GET(gb, p + 5) * 256) * 10) + " "
        p = BUFFER_INDEXOF(gb, nadel, p + 1)
    WEND
    RETURN TRIM$(r)
END FUNCTION
FUNCTION schleife$() AS STRING
    ' NETSCAPE2.0, dann 03 01 und die Wiederholzahl (0 = endlos)
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, BUFFER_FROM_STRING("NETSCAPE2.0"))
    IF p < 0 THEN RETURN "keine"
    RETURN STR$(BUFFER_GET(gb, p + 13) + BUFFER_GET(gb, p + 14) * 256)
END FUNCTION
DIM b[3] AS IMAGE
b[0] = IMAGE_NEW(8, 8, RGB(255, 0, 0))
b[1] = IMAGE_NEW(8, 8, RGB(0, 255, 0))
b[2] = IMAGE_NEW(8, 8, RGB(0, 0, 255))
IMAGE_SAVE_GIF(b, "a.gif", [1000, 80, 500])
gb = READALL_BYTES("a.gif")
PRINT dauern$()
--- umgebung
DHRT_FRAMES=2
--- erwartet
1000 80 500

