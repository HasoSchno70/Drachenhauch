PRINT "city" IN m
PRINT "unknown" IN m
--- erwartet
TRUE
TRUE
FALSE

=== in negation with not (1)
' Klassisches `NOT (x IN c)` fuer Anti-Mitgliedschaft.
DIM banned[2] AS STRING
banned[0] = "spam"
banned[1] = "scam"
DIM word AS STRING
word = "ham"
IF NOT (word IN banned) THEN
    PRINT "allowed"
ELSE
    PRINT "blocked"
END IF
--- erwartet
allowed

=== in negation with not (2)
' Klassisches `NOT (x IN c)` fuer Anti-Mitgliedschaft.
DIM banned[2] AS STRING
banned[0] = "spam"
