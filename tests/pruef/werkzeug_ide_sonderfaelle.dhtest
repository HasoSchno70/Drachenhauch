' Die Sonderfaelle der IDE (ide/ide.dh) -- ohne Python geprueft. Bis Stufe 37
' standen sie in tests/test_ide.py, weil sie mehr als EINEN Lauf brauchen:
' zwei IDE-Laeufe hintereinander (Sitzung, Umbruch, Sitzung je Projektordner),
' ein git-Repository VOR dem Lauf oder eine Messung im Bildschirmfoto. Dafuer
' die Bloecke `--- vorher`, `--- zwischen` und `--- nochmal [in ORDNER]`
' (docs/werkzeuge.md). Seit Stufe 38 auch das PDF-Listing: den Text liest
' pdftext.dh (ToUnicode-Tabellen), tests/test_ide.py gibt es nicht mehr.
'
' Der Einschub spielt die Aufnahme nur ab, wenn es sie gibt: ein zweiter Lauf
' ohne sie laeuft ohne Eingaben, und beim Farbfeld schreibt sie erst das
' `--- zwischen`. Das Protokoll haengt an, alle Laeufe stehen darin.
' In der Aufnahme: 7 Mauslage, 6 Taste runter, 5 hoch, 2 Taste runter, 1 hoch.
--- seriell

=== sitzung und zuletzt geoeffnet ueberleben den neustart
' Der erste Lauf merkt sich die Datei (zuletzt + Sitzung) in der ide.json;
' der zweite Lauf mit einer Datei, die es nicht gibt, stellt sie wieder her.
' Das Protokoll haengt an -- beide Laeufe stehen darin.
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=60
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT 1
--- nochmal
gibt_es_nicht.dh
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(p AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION alleEnden(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            n = n + 1
            IF RIGHT$(L[i], LEN(e)) <> e THEN RETURN FALSE
        END IF
    NEXT
    RETURN n > 0
END FUNCTION
FUNCTION inhalt$(datei AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(z) - 1
        r = r + z[i] + CHR$(10)
    NEXT
    RETURN r
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION pruefe$(datei AS STRING) AS STRING
    DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", datei)
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM befund AS STRING : befund = ""
    DIM stille AS INTEGER : stille = 0
    WHILE MILLIS() < bis AND stille < 5
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN befund = befund + zz : stille = 0
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
    WEND
    RETURN TRIM$(befund)
END FUNCTION
FUNCTION steht(datei AS STRING, t AS STRING) AS BOOLEAN
    RETURN INSTR(inhalt$(datei), t) >= 0
END FUNCTION
IMPORT "json"
DIM kh AS JSON_HANDLE : kh = JSON_LOAD("_programm/ide.json")
PRINT "zuletzt " ; RIGHT$(JSON_GET_STRING(kh, "zuletzt.0"), 8) = "spiel.dh"
PRINT "sitzung " ; RIGHT$(JSON_GET_STRING(kh, "sitzung.0"), 8) = "spiel.dh"
PRINT "zweimal geoeffnet " ; zahl("geoeffnet ") = 2
PRINT "zweites oeffnen ist spiel.dh " ; RIGHT$(letzte$("geoeffnet "), 8) = "spiel.dh"
--- erwartet
zuletzt TRUE
sitzung TRUE
zweimal geoeffnet TRUE
zweites oeffnen ist spiel.dh TRUE

=== zeilenumbruch bleibt gemerkt
' Alt+Z im ersten Lauf; das `--- zwischen` nimmt die Aufnahme weg, damit der
' zweite Lauf den Umbruch nicht wieder ausschaltet -- und danach steht er noch.
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=90
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT 1
--- datei _programm/ev.txt
c 4
e 30 2 342 0 0 0
e 30 2 90 0 0 0
e 32 1 90 0 0 0
e 32 1 342 0 0 0

--- zwischen
DELETEFILE("_programm/ev.txt")
--- nochmal
spiel.dh
--- nachher
