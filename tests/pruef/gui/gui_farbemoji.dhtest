' Farbige Emoji (farbglyphe.rs): ein Emoji kommt in seinen Farben, nicht
' als Silhouette in der Textfarbe -- in der gui (deren Schrift DejaVu Sans
' 😀 selbst als Umriss hat, `farb_emoji`) wie mit TEXT. Gemessen wird Gelb
' im Gesicht des Smileys, gezeichnet in Blau (getoent gaebe es kein Gelb). Laeuft nur, wo es Segoe UI
' Emoji gibt (Windows); sonst uebersprungen.
' Format: docs/werkzeuge.md, dhrt test.

=== ein smiley in der gui ist gelb
IF NOT FILEEXISTS("C:/Windows/Fonts/seguiemj.ttf") THEN
    PRINT "UEBERSPRINGEN: keine Farb-Emoji-Schrift"
    EXIT(0)
END IF
TRY
    SCREEN(400, 200, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM l AS GUI_WIDGET : l = GUI_LABEL(w, CHR$(&H1F600), 20, 20)
' In der Vorgabeschrift der gui -- sie hat den Smiley selbst als Umriss.
GUI_SET_COLOR(l, "fg", &H4060FF)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(400, 200)
FUNCTION gelb_in(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER) AS INTEGER
    DIM bild AS IMAGE : bild = RENDERTARGET_IMAGE(rt)
    DIM n AS INTEGER = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR x = x0 TO x1
        FOR y = y0 TO y1
            DIM p AS INTEGER : p = GETPIXEL(bild, x, y) BAND &HFFFFFF
            IF ((p \ 65536) BAND 255) > 200 AND ((p \ 256) BAND 255) > 150 AND (p BAND 255) < 110 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
' Die Emoji-Schrift kommt auf Zuruf: ein paar Bilder, bis sie gebacken ist.
DIM k AS INTEGER
FOR k = 1 TO 4
    GUI_UPDATE()
    RENDERTARGET_BEGIN(rt) : CLS(&H202830) : GUI_DRAW()
    RENDERTARGET_END()
    FLIP()
NEXT
PRINT "gui gelb "; gelb_in(15, 15, 60, 50) > 8
--- umgebung
DHRT_FRAMES=8
--- erwartet
gui gelb TRUE

=== ein smiley mit text ist gelb
IF NOT FILEEXISTS("C:/Windows/Fonts/seguiemj.ttf") THEN
    PRINT "UEBERSPRINGEN: keine Farb-Emoji-Schrift"
    EXIT(0)
END IF
TRY
    SCREEN(400, 200, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(400, 200)
FUNCTION gelb_in(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER) AS INTEGER
    DIM bild AS IMAGE : bild = RENDERTARGET_IMAGE(rt)
    DIM n AS INTEGER = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR x = x0 TO x1
        FOR y = y0 TO y1
            DIM p AS INTEGER : p = GETPIXEL(bild, x, y) BAND &HFFFFFF
            IF ((p \ 65536) BAND 255) > 200 AND ((p \ 256) BAND 255) > 150 AND (p BAND 255) < 110 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
' Die Emoji-Schrift kommt auf Zuruf: ein paar Bilder, bis sie gebacken ist.
DIM k AS INTEGER
FOR k = 1 TO 4
    GUI_UPDATE()
    RENDERTARGET_BEGIN(rt) : CLS(&H202830) : GUI_DRAW()
    TEXT_SIZE(40)
    TEXT(20, 110, CHR$(&H1F600), &H4060FF)
    RENDERTARGET_END()
    FLIP()
NEXT
PRINT "text gelb "; gelb_in(15, 105, 90, 180) > 40
--- umgebung
DHRT_FRAMES=8
--- erwartet
text gelb TRUE
