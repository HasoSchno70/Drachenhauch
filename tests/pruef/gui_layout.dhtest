DIM z1 AS GUI_WIDGET : z1 = GUI_LAYOUT(w, "zeile", 0, 0, 100, 30)
DIM z2 AS GUI_WIDGET : z2 = GUI_LAYOUT(w, "zeile", 0, 100, 100, 30)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 40, 30)
GUI_LAYOUT_ADD(z1, a) : GUI_LAYOUT_ADD(z2, a)
