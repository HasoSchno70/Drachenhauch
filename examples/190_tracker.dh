' ============================================================
'  DRACHENHAUCH -- Tracker (Musik-Editor)
' ============================================================
'  Ein mehrspuriger Tracker, geschrieben IN Drachenhauch auf dem eigenen
'  gui-Modul. Das Gegenstueck zum Qt-Werkzeug `dhtracker` -- und der fuenfte
'  Pilot, der misst, ob die Sprache fuer ihre eigenen Werkzeuge taugt.
'
'  Was er kann:
'    Patterns (1..64 Reihen) x Kanaele (4..32, der LETZTE ist der Schlagzeug-
'    kanal), eine Reihenfolge (Order) daraus, 18 fertige Instrumente mit
'    ADSR/Vibrato/Detune -- alle im Instrument-Kasten aenderbar --, je Note
'    Lautstaerke, Portamento (Slide), Effekt (Arp/Vib/Ret) und ein eigenes
'    Instrument; Blockauswahl mit Kopieren/Ausschneiden/Einfuegen,
'    Transponieren und Interpolieren; Stumm/Solo und ein Lautstaerke-Regler
'    je Kanal; Wiedergabe von Pattern oder Song auf einer Audio-UHR
'    (samplegenau, nicht bildgetrieben); Rueckgaengig/Wiederholen ueber den
'    ganzen Song; Datei = dasselbe JSON wie die Qt-Fassung (`dhtracker-song`,
'    in beide Richtungen); [WAV] mischt den Song offline zu einer Datei,
'    [GB-Code] schreibt den frame-basierten Live-Player wie die Qt-Fassung.
'
'  Bedienung:
'    Klick ins Gitter setzt den Cursor, Ziehen oder Umschalt+Klick waehlt
'    einen Block. Pfeile bewegen, Umschalt+Pfeile waehlen, Bild auf/ab
'    springen, Pos1/Ende an den Rand. Klaviatur unten ODER die Tastatur
'    (Z S X D C V G B H N J M = untere Oktave, Q 2 W 3 E R 5 T 6 Y 7 U =
'    obere; die Lage ist die der US-Tastatur, auf einer deutschen liegt das
'    Z also auf dem Y). `0` = Note aus, Entf/Ruecktaste loescht.
'    Strg+C/X/V Block kopieren/ausschneiden/einfuegen, Strg+Pfeil auf/ab
'    transponiert (+Umschalt: Oktave), Strg+I interpoliert, Strg+Z/Y
'    zurueck/vor, Strg+S sichert, Strg+O oeffnet, Leertaste spielt das
'    Pattern. ESC beendet (fragt bei ungesicherten Aenderungen).
'
'  Nicht portiert (die Qt-Fassung hat es):
'    Sample-Instrumente (WAV/OGG), Keymaps und SoundFonts -- alles, was
'    eingebettete PCM-Daten braucht; VU-Meter je Kanal; Umbenennen von
'    Patterns; der Sample-Offset-Effekt (er braucht Samples).
'
'  Was dieser Pilot in der Laufzeit freigelegt hat: AUDIO_NOTE (eine Note
'  mit Sustain-PEGEL und Ausklingen -- AUDIO_SFX kennt nur drei Zeiten),
'  AUDIO_SOUND_NEW/MIX/NORMALIZE (ohne Mischen kein WAV-Export) und
'  JSON_APPEND_NULL (eine Liste mit leeren Plaetzen liess sich nicht
'  schreiben).
' ============================================================
IMPORT "gui"
IMPORT "audio"
IMPORT "json"

' ------------------------------------------------------------ Grenzen
CONST MAX_CH = 32
CONST MIN_CH = 4
CONST MAX_ROWS = 64
CONST MAX_PAT = 32
CONST MAX_ORDER = 128
CONST MAX_INST = 48
CONST LEER = -2                 ' keine Note (die Qt-Fassung schreibt null)
CONST NOTE_OFF = -1             ' Note aus (Key Off)
CONST TICKS = 6                 ' Ticks je Reihe -- Raster fuer Arp/Retrigger
CONST FX_ARP = 1
CONST FX_VIB = 2
CONST FX_RET = 3
CONST FX_OFF = 4
CONST UNDO_MAX = 32

' ------------------------------------------------------------ Der Song
' Ein Wert je Zelle, sechs Gitter -- so liegt es auch in der Datei.
DIM note[MAX_PAT, MAX_CH, MAX_ROWS] AS INTEGER
DIM vol[MAX_PAT, MAX_CH, MAX_ROWS] AS INTEGER       ' 1..15, 0 = Standard
DIM slide[MAX_PAT, MAX_CH, MAX_ROWS] AS INTEGER     ' -12..12, 0 = keiner
DIM fx[MAX_PAT, MAX_CH, MAX_ROWS] AS INTEGER        ' FX_*, 0 = keiner
DIM fxp[MAX_PAT, MAX_CH, MAX_ROWS] AS INTEGER       ' Parameter 0..255
DIM inst[MAX_PAT, MAX_CH, MAX_ROWS] AS INTEGER      ' Instrument, -1 = Kanal
DIM patName[MAX_PAT] AS STRING
DIM patRows[MAX_PAT] AS INTEGER
DIM patAnz AS INTEGER
DIM order[MAX_ORDER] AS INTEGER
DIM orderAnz AS INTEGER
DIM bpm AS INTEGER
DIM kanaele AS INTEGER
DIM wave[MAX_CH] AS STRING          ' Wellenform der Tonkanaele ohne Instrument
DIM chInst[MAX_CH] AS INTEGER       ' Instrument je Kanal, -1 = Wellenform
DIM chVol[MAX_CH] AS FLOAT          ' Mixer-Regler 0..1
DIM mute[MAX_CH] AS BOOLEAN
DIM solo[MAX_CH] AS BOOLEAN

' Instrumente: nur Synth-Klaenge (siehe Kopf).
DIM iName[MAX_INST] AS STRING
DIM iWave[MAX_INST] AS STRING
DIM iAtk[MAX_INST] AS INTEGER
DIM iDec[MAX_INST] AS INTEGER
DIM iSus[MAX_INST] AS FLOAT
DIM iRel[MAX_INST] AS INTEGER
DIM iVibD[MAX_INST] AS FLOAT
DIM iVibS[MAX_INST] AS FLOAT
DIM iDet[MAX_INST] AS FLOAT
DIM iPan[MAX_INST] AS FLOAT
DIM iVol[MAX_INST] AS INTEGER       ' 1..15
DIM instAnz AS INTEGER

DIM wellenformen AS ARRAY OF STRING
wellenformen = SPLIT$("square|saw|sine|triangle", "|")
DIM notenNamen AS ARRAY OF STRING
notenNamen = SPLIT$("C-|C#|D-|D#|E-|F-|F#|G-|G#|A-|A#|B-", "|")

' ------------------------------------------------------------ Zustand
DIM patAkt AS INTEGER : patAkt = 0
DIM curC AS INTEGER : curC = 0
DIM curR AS INTEGER : curR = 0
DIM selAn AS BOOLEAN : selAn = FALSE
DIM ankC AS INTEGER : ankC = 0       ' Anker der Blockauswahl
DIM ankR AS INTEGER : ankR = 0
DIM rowOff AS INTEGER : rowOff = 0   ' erste sichtbare Reihe
DIM chOff AS INTEGER : chOff = 0     ' erster sichtbarer Kanal
DIM dateiPfad AS STRING : dateiPfad = ""
DIM dirty AS BOOLEAN : dirty = FALSE
DIM undoFaellig AS BOOLEAN : undoFaellig = FALSE
DIM meldung AS STRING : meldung = "Bereit."
DIM bildNr AS INTEGER : bildNr = 0

' Zwischenablage fuer Bloecke
DIM cbNote[MAX_CH, MAX_ROWS] AS INTEGER
DIM cbVol[MAX_CH, MAX_ROWS] AS INTEGER
DIM cbSlide[MAX_CH, MAX_ROWS] AS INTEGER
DIM cbFx[MAX_CH, MAX_ROWS] AS INTEGER
DIM cbFxp[MAX_CH, MAX_ROWS] AS INTEGER
DIM cbInst[MAX_CH, MAX_ROWS] AS INTEGER
DIM cbW AS INTEGER : cbW = 0
DIM cbH AS INTEGER : cbH = 0

' ------------------------------------------------------------ Hilfen
FUNCTION notenName$(m AS INTEGER) AS STRING
    IF m = NOTE_OFF THEN RETURN "OFF"
    IF m < 0 THEN RETURN "..."
    RETURN notenNamen[m MOD 12] + STR$(m \ 12 - 1)
END FUNCTION

FUNCTION freqVon(m AS INTEGER) AS FLOAT
    RETURN 440.0 * POW(2.0, (m - 69) / 12.0)
END FUNCTION

FUNCTION reihenMs() AS FLOAT
    RETURN 60000.0 / MAX(1, bpm) / 4.0
END FUNCTION

FUNCTION tickMs() AS FLOAT
    RETURN reihenMs() / TICKS
END FUNCTION

FUNCTION istDrum(c AS INTEGER) AS BOOLEAN
    RETURN c = kanaele - 1
END FUNCTION

FUNCTION hoerbar(c AS INTEGER) AS BOOLEAN
    IF mute[c] THEN RETURN FALSE
    DIM i AS INTEGER
    FOR i = 0 TO kanaele - 1
        IF solo[i] THEN RETURN solo[c]
    NEXT
    RETURN TRUE
END FUNCTION

' Eine Zelle loeschen nimmt ihre Effekte mit -- wie in der Qt-Fassung.
SUB zelleSetzen(p AS INTEGER, c AS INTEGER, r AS INTEGER, n AS INTEGER)
    note[p, c, r] = n
    IF n < 0 THEN
        vol[p, c, r] = 0 : slide[p, c, r] = 0
        fx[p, c, r] = 0 : fxp[p, c, r] = 0 : inst[p, c, r] = -1
    END IF
END SUB

SUB patternLeeren(p AS INTEGER)
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = 0 TO MAX_CH - 1
        FOR r = 0 TO MAX_ROWS - 1
            note[p, c, r] = LEER
            vol[p, c, r] = 0 : slide[p, c, r] = 0
            fx[p, c, r] = 0 : fxp[p, c, r] = 0 : inst[p, c, r] = -1
        NEXT
    NEXT
END SUB

SUB patternKopieren(von AS INTEGER, nach AS INTEGER)
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = 0 TO MAX_CH - 1
        FOR r = 0 TO MAX_ROWS - 1
            note[nach, c, r] = note[von, c, r]
            vol[nach, c, r] = vol[von, c, r]
            slide[nach, c, r] = slide[von, c, r]
            fx[nach, c, r] = fx[von, c, r]
            fxp[nach, c, r] = fxp[von, c, r]
            inst[nach, c, r] = inst[von, c, r]
        NEXT
    NEXT
    patRows[nach] = patRows[von]
END SUB

' ------------------------------------------------------------ Instrumente
SUB instrumentSetzen(i AS INTEGER, nm AS STRING, wf AS STRING, atk AS INTEGER, _
                     dec AS INTEGER, sus AS FLOAT, rel AS INTEGER, _
                     vd AS FLOAT, vs AS FLOAT, det AS FLOAT)
    iName[i] = nm : iWave[i] = wf
    iAtk[i] = atk : iDec[i] = dec : iSus[i] = sus : iRel[i] = rel
    iVibD[i] = vd : iVibS[i] = vs : iDet[i] = det
    iPan[i] = 0.0 : iVol[i] = 15
END SUB

' Dieselbe Tabelle wie `tracker/presets.py` -- ein Song, den die Qt-Fassung
' anlegt, klingt hier also mit denselben Zahlen.
SUB werksInstrumente()
    instrumentSetzen(0,  "Fluegel (Piano)", "triangle",   2, 700, 0.0,  200, 0.0,  0, 6)
    instrumentSetzen(1,  "E-Piano",         "sine",       2, 450, 0.30, 220, 0.0,  0, 8)
    instrumentSetzen(2,  "Orgel",           "square",     6,   0, 1.0,   70, 0.06, 6, 5)
    instrumentSetzen(3,  "Kirchenorgel",    "saw",       14,   0, 1.0,  140, 0.04, 5, 10)
    instrumentSetzen(4,  "Streicher",       "saw",      140,   0, 1.0,  280, 0.05, 5, 14)
    instrumentSetzen(5,  "Synth-Pad",       "triangle", 220,   0, 0.85, 420, 0.03, 4, 18)
    instrumentSetzen(6,  "Bass",            "square",     2, 140, 0.55,  80, 0.0,  0, 0)
    instrumentSetzen(7,  "Synth-Bass",      "saw",        2, 120, 0.50,  70, 0.0,  0, 6)
    instrumentSetzen(8,  "Lead",            "saw",        2,   0, 0.9,   90, 0.05, 6, 4)
    instrumentSetzen(9,  "Pluck",           "triangle",   1, 220, 0.0,  130, 0.0,  0, 4)
    instrumentSetzen(10, "Glocke",          "sine",       1, 900, 0.0,  320, 0.0,  0, 10)
    instrumentSetzen(11, "Marimba",         "sine",       1, 260, 0.0,  130, 0.0,  0, 0)
    instrumentSetzen(12, "Chip-Square",     "square",     1,   0, 1.0,   20, 0.0,  0, 0)
    instrumentSetzen(13, "Chip-Saw",        "saw",        1,   0, 1.0,   20, 0.0,  0, 0)
    instrumentSetzen(14, "Kick",            "sine",       0,  90, 0.0,   30, 0.0,  0, 0)
    instrumentSetzen(15, "Snare",           "noise",      0, 140, 0.0,   40, 0.0,  0, 0)
    instrumentSetzen(16, "HiHat",           "noise",      0,  40, 0.0,   20, 0.0,  0, 0)
    instrumentSetzen(17, "Tom",             "sine",       0, 160, 0.0,   40, 0.0,  0, 0)
    instAnz = 18
END SUB

SUB neuerSong()
    DIM i AS INTEGER
    bpm = 120
    kanaele = 4
    FOR i = 0 TO MAX_CH - 1
        wave[i] = "square" : chInst[i] = -1 : chVol[i] = 1.0
        mute[i] = FALSE : solo[i] = FALSE
    NEXT
    wave[0] = "square" : wave[1] = "saw" : wave[2] = "triangle"
    FOR i = 0 TO MAX_PAT - 1
        patternLeeren(i)
        patRows[i] = 16
        patName[i] = "P" + STR$(i + 1)
    NEXT
    patAnz = 1
    order[0] = 0 : orderAnz = 1
    werksInstrumente()
    ' Dieselben Vorgaben wie die Qt-Fassung: Fluegel / Streicher /
    ' Synth-Bass / Kick.
    chInst[0] = 0 : chInst[1] = 4 : chInst[2] = 7 : chInst[3] = 14
    patAkt = 0 : curC = 0 : curR = 0 : selAn = FALSE
    rowOff = 0 : chOff = 0
END SUB

' ------------------------------------------------------------ JSON
' EINE Routine fuer Datei UND Verlauf: der Verlauf merkt sich den ganzen
' Song als Text. Bei einem Tracker ist das billig genug (ein paar tausend
' Zahlen), und es deckt ALLES ab -- Noten, Patterns, Reihenfolge, Tempo,
' Instrumente -- ohne fuer jede Aenderungsart eine eigene Buchfuehrung.
FUNCTION gitterHatWerte(p AS INTEGER, welches AS INTEGER) AS BOOLEAN
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = 0 TO kanaele - 1
        FOR r = 0 TO patRows[p] - 1
            IF welches = 1 AND vol[p, c, r] > 0 THEN RETURN TRUE
            IF welches = 2 AND slide[p, c, r] <> 0 THEN RETURN TRUE
            IF welches = 3 AND fx[p, c, r] <> 0 THEN RETURN TRUE
            IF welches = 4 AND inst[p, c, r] >= 0 THEN RETURN TRUE
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Ein Gitter als Liste von Listen; `welches` waehlt das Feld. Leere
' Plaetze werden null -- so liest es die Qt-Fassung.
FUNCTION gitterJson(p AS INTEGER, welches AS INTEGER) AS JSON_HANDLE
    DIM g AS JSON_HANDLE : g = JSON_NEW_ARRAY()
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = 0 TO kanaele - 1
        DIM col AS JSON_HANDLE : col = JSON_NEW_ARRAY()
        FOR r = 0 TO patRows[p] - 1
            DIM w AS INTEGER : w = 0
            DIM istLeer AS BOOLEAN : istLeer = TRUE
            IF welches = 0 THEN
                w = note[p, c, r] : istLeer = (w = LEER)
            ELSEIF welches = 1 THEN
                w = vol[p, c, r] : istLeer = (w = 0)
            ELSEIF welches = 2 THEN
                w = slide[p, c, r] : istLeer = (w = 0)
            ELSEIF welches = 3 THEN
                w = fx[p, c, r] : istLeer = (w = 0)
            ELSEIF welches = 4 THEN
                w = fxp[p, c, r] : istLeer = (fx[p, c, r] = 0)
            ELSE
                w = inst[p, c, r] : istLeer = (w < 0)
            END IF
            IF istLeer THEN
                JSON_APPEND_NULL(col, "")
            ELSE
                JSON_APPEND_INT(col, "", w)
            END IF
        NEXT
        JSON_APPEND_JSON(g, "", col)
    NEXT
    RETURN g
END FUNCTION

FUNCTION songHandle() AS JSON_HANDLE
    DIM h AS JSON_HANDLE : h = JSON_NEW_OBJECT()
    JSON_SET_STRING(h, "format", "dhtracker-song")
    JSON_SET_INT(h, "version", 1)
    JSON_SET_INT(h, "bpm", bpm)
    JSON_SET_INT(h, "channels", kanaele)
    DIM i AS INTEGER
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    FOR i = 0 TO kanaele - 2
        JSON_APPEND_STRING(a, "", wave[i])
    NEXT
    JSON_SET_JSON(h, "waves", a)
    DIM pats AS JSON_HANDLE : pats = JSON_NEW_ARRAY()
    DIM p AS INTEGER
    FOR p = 0 TO patAnz - 1
        DIM po AS JSON_HANDLE : po = JSON_NEW_OBJECT()
        JSON_SET_STRING(po, "name", patName[p])
        JSON_SET_INT(po, "rows", patRows[p])
        JSON_SET_INT(po, "channels", kanaele)
        JSON_SET_JSON(po, "data", gitterJson(p, 0))
        IF gitterHatWerte(p, 1) THEN JSON_SET_JSON(po, "vol", gitterJson(p, 1))
        IF gitterHatWerte(p, 2) THEN JSON_SET_JSON(po, "slide", gitterJson(p, 2))
        IF gitterHatWerte(p, 3) THEN
            JSON_SET_JSON(po, "fx", gitterJson(p, 3))
            JSON_SET_JSON(po, "fxp", gitterJson(p, 4))
        END IF
        IF gitterHatWerte(p, 4) THEN JSON_SET_JSON(po, "inst", gitterJson(p, 5))
        JSON_APPEND_JSON(pats, "", po)
    NEXT
    JSON_SET_JSON(h, "patterns", pats)
    a = JSON_NEW_ARRAY()
    FOR i = 0 TO orderAnz - 1
        JSON_APPEND_INT(a, "", order[i])
    NEXT
    JSON_SET_JSON(h, "order", a)
    DIM abweichend AS BOOLEAN : abweichend = FALSE
    FOR i = 0 TO kanaele - 1
        IF chVol[i] <> 1.0 THEN abweichend = TRUE
    NEXT
    IF abweichend THEN
        a = JSON_NEW_ARRAY()
        FOR i = 0 TO kanaele - 1
            JSON_APPEND_FLOAT(a, "", chVol[i])
        NEXT
        JSON_SET_JSON(h, "channel_vol", a)
    END IF
    a = JSON_NEW_ARRAY()
    FOR i = 0 TO instAnz - 1
        DIM io AS JSON_HANDLE : io = JSON_NEW_OBJECT()
        JSON_SET_STRING(io, "name", iName[i])
        JSON_SET_STRING(io, "kind", "synth")
        JSON_SET_INT(io, "default_vol", iVol[i])
        JSON_SET_FLOAT(io, "pan", iPan[i])
        JSON_SET_STRING(io, "waveform", iWave[i])
        JSON_SET_STRING(io, "loop_mode", "none")
        JSON_SET_INT(io, "loop_start", 0)
        JSON_SET_INT(io, "loop_end", 0)
        JSON_SET_INT(io, "env_attack_ms", iAtk[i])
        JSON_SET_INT(io, "env_decay_ms", iDec[i])
        JSON_SET_FLOAT(io, "env_sustain", iSus[i])
        JSON_SET_INT(io, "env_release_ms", iRel[i])
        JSON_SET_FLOAT(io, "vib_depth", iVibD[i])
        JSON_SET_FLOAT(io, "vib_speed", iVibS[i])
        JSON_SET_FLOAT(io, "detune_cents", iDet[i])
        JSON_APPEND_JSON(a, "", io)
    NEXT
    JSON_SET_JSON(h, "instruments", a)
    a = JSON_NEW_ARRAY()
    FOR i = 0 TO kanaele - 1
        IF chInst[i] >= 0 THEN
            JSON_APPEND_INT(a, "", chInst[i])
        ELSE
            JSON_APPEND_NULL(a, "")
        END IF
    NEXT
    JSON_SET_JSON(h, "channel_inst", a)
    RETURN h
END FUNCTION

FUNCTION zahlOder(h AS JSON_HANDLE, pfad AS STRING, sonst AS INTEGER) AS INTEGER
    IF JSON_TYPE(h, pfad) = "number" THEN RETURN JSON_GET_INT(h, pfad)
    RETURN sonst
END FUNCTION

FUNCTION kommaOder(h AS JSON_HANDLE, pfad AS STRING, sonst AS FLOAT) AS FLOAT
    IF JSON_TYPE(h, pfad) = "number" THEN RETURN JSON_GET_FLOAT(h, pfad)
    RETURN sonst
END FUNCTION

' Ein Gitter aus der Datei; Zeilen, die die Datei nicht hat, bleiben leer.
SUB gitterLesen(h AS JSON_HANDLE, pp AS STRING, p AS INTEGER, welches AS INTEGER)
    IF NOT JSON_HAS(h, pp) THEN RETURN
    DIM nc AS INTEGER : nc = MIN(kanaele, JSON_LEN(h, pp))
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR c = 0 TO nc - 1
        DIM cp AS STRING : cp = pp + "." + STR$(c)
        DIM nr AS INTEGER : nr = MIN(patRows[p], JSON_LEN(h, cp))
        FOR r = 0 TO nr - 1
            DIM zp AS STRING : zp = cp + "." + STR$(r)
            IF JSON_TYPE(h, zp) = "number" THEN
                DIM w AS INTEGER : w = JSON_GET_INT(h, zp)
                IF welches = 0 THEN
                    IF w >= -1 AND w <= 127 THEN note[p, c, r] = w
                ELSEIF welches = 1 THEN
                    vol[p, c, r] = CLAMP(w, 0, 15)
                ELSEIF welches = 2 THEN
                    slide[p, c, r] = CLAMP(w, -12, 12)
                ELSEIF welches = 3 THEN
                    IF w >= 1 AND w <= 4 THEN fx[p, c, r] = w
                ELSEIF welches = 4 THEN
                    fxp[p, c, r] = CLAMP(w, 0, 255)
                ELSE
                    IF w >= 0 THEN inst[p, c, r] = w
                END IF
            END IF
        NEXT
    NEXT
END SUB

SUB songAusHandle(h AS JSON_HANDLE)
    neuerSong()
    instAnz = 0
    DIM i AS INTEGER
    FOR i = 0 TO MAX_CH - 1
        chInst[i] = -1
    NEXT
    bpm = CLAMP(zahlOder(h, "bpm", 120), 40, 300)
    kanaele = CLAMP(zahlOder(h, "channels", 4), MIN_CH, MAX_CH)
    IF JSON_HAS(h, "waves") THEN
        FOR i = 0 TO MIN(kanaele - 2, JSON_LEN(h, "waves") - 1)
            wave[i] = JSON_GET_STRING(h, "waves." + STR$(i))
        NEXT
    END IF
    patAnz = 0
    IF JSON_HAS(h, "patterns") THEN patAnz = MIN(MAX_PAT, JSON_LEN(h, "patterns"))
    DIM p AS INTEGER
    FOR p = 0 TO patAnz - 1
        DIM pp AS STRING : pp = "patterns." + STR$(p)
        IF JSON_HAS(h, pp + ".name") THEN patName[p] = JSON_GET_STRING(h, pp + ".name")
        patRows[p] = CLAMP(zahlOder(h, pp + ".rows", 16), 1, MAX_ROWS)
        gitterLesen(h, pp + ".data", p, 0)
        gitterLesen(h, pp + ".vol", p, 1)
        gitterLesen(h, pp + ".slide", p, 2)
        gitterLesen(h, pp + ".fx", p, 3)
        gitterLesen(h, pp + ".fxp", p, 4)
        gitterLesen(h, pp + ".inst", p, 5)
    NEXT
    IF patAnz = 0 THEN patAnz = 1
    orderAnz = 0
    IF JSON_HAS(h, "order") THEN
        FOR i = 0 TO MIN(MAX_ORDER, JSON_LEN(h, "order")) - 1
            DIM o AS INTEGER : o = zahlOder(h, "order." + STR$(i), -1)
            IF o >= 0 AND o < patAnz THEN
                order[orderAnz] = o : orderAnz = orderAnz + 1
            END IF
        NEXT
    END IF
    IF orderAnz = 0 THEN order[0] = 0 : orderAnz = 1
    IF JSON_HAS(h, "channel_vol") THEN
        FOR i = 0 TO MIN(kanaele, JSON_LEN(h, "channel_vol")) - 1
            chVol[i] = CLAMP(kommaOder(h, "channel_vol." + STR$(i), 1.0), 0.0, 1.0)
        NEXT
    END IF
    IF JSON_HAS(h, "instruments") THEN
        DIM n AS INTEGER : n = MIN(MAX_INST, JSON_LEN(h, "instruments"))
        FOR i = 0 TO n - 1
            DIM ip AS STRING : ip = "instruments." + STR$(i)
            DIM art AS STRING : art = "synth"
            IF JSON_HAS(h, ip + ".kind") THEN art = JSON_GET_STRING(h, ip + ".kind")
            DIM wf AS STRING : wf = "square"
            IF JSON_HAS(h, ip + ".waveform") THEN wf = JSON_GET_STRING(h, ip + ".waveform")
            DIM nm AS STRING : nm = "Instrument"
            IF JSON_HAS(h, ip + ".name") THEN nm = JSON_GET_STRING(h, ip + ".name")
            ' Ein Sample- oder Keymap-Instrument kann dieser Pilot nicht
            ' spielen -- es bleibt als Platzhalter stehen, damit die Nummern
            ' der anderen stimmen, und sagt es im Namen.
            IF art <> "synth" THEN nm = nm + " [" + art + ", hier stumm]"
            instrumentSetzen(instAnz, nm, wf, zahlOder(h, ip + ".env_attack_ms", 0), _
                             zahlOder(h, ip + ".env_decay_ms", 0), _
                             kommaOder(h, ip + ".env_sustain", 1.0), _
                             zahlOder(h, ip + ".env_release_ms", 0), _
                             kommaOder(h, ip + ".vib_depth", 0.0), _
                             kommaOder(h, ip + ".vib_speed", 0.0), _
                             kommaOder(h, ip + ".detune_cents", 0.0))
            iPan[instAnz] = CLAMP(kommaOder(h, ip + ".pan", 0.0), -1.0, 1.0)
            iVol[instAnz] = CLAMP(zahlOder(h, ip + ".default_vol", 15), 1, 15)
            instAnz = instAnz + 1
        NEXT
        IF JSON_HAS(h, "channel_inst") THEN
            FOR i = 0 TO MIN(kanaele, JSON_LEN(h, "channel_inst")) - 1
                DIM ci AS INTEGER : ci = zahlOder(h, "channel_inst." + STR$(i), -1)
                IF ci >= 0 AND ci < instAnz THEN chInst[i] = ci
            NEXT
        END IF
    END IF
    ' Verwaiste Instrument-Nummern in den Zellen zuruecksetzen -- sonst
    ' klaenge eine Note mit einem Instrument, das es nicht gibt.
    DIM c AS INTEGER
    DIM r AS INTEGER
    FOR p = 0 TO patAnz - 1
        FOR c = 0 TO kanaele - 1
            FOR r = 0 TO patRows[p] - 1
                IF inst[p, c, r] >= instAnz THEN inst[p, c, r] = -1
            NEXT
        NEXT
    NEXT
END SUB

' ------------------------------------------------------------ Verlauf
DIM uStand[UNDO_MAX] AS STRING
DIM uAnz AS INTEGER : uAnz = 0
DIM uPos AS INTEGER : uPos = 0
DIM uStart AS INTEGER : uStart = 0

FUNCTION standJetzt$() AS STRING
    RETURN JSON_STRINGIFY(songHandle())
END FUNCTION

SUB verlaufLeeren()
    uAnz = 1 : uPos = 1 : uStart = 0
    uStand[0] = standJetzt$()
END SUB

' Gesichert wird der VOLLE Stand, und nur, wenn er sich vom letzten
' unterscheidet -- ein Klick, der nichts aendert, ist kein Schritt.
SUB schrittSichern()
    DIM s AS STRING : s = standJetzt$()
    IF uPos > 0 AND s = uStand[(uStart + uPos - 1) MOD UNDO_MAX] THEN RETURN
    uAnz = uPos                        ' alles Wiederholbare verfaellt
    IF uAnz = UNDO_MAX THEN
        uStart = (uStart + 1) MOD UNDO_MAX
        uAnz = uAnz - 1
    END IF
    uStand[(uStart + uAnz) MOD UNDO_MAX] = s
    uAnz = uAnz + 1
    uPos = uAnz
END SUB

SUB geaendert()
    dirty = TRUE
    undoFaellig = TRUE
END SUB

' ------------------------------------------------------------ Klang
' Klaenge werden EINMAL gebaut und wiederverwendet: dieselbe Note mit
' derselben Laenge und demselben Instrument ist derselbe SOUND.
DIM cache AS MAP OF INTEGER
DIM gWf AS STRING
DIM gAtk AS INTEGER
DIM gDec AS INTEGER
DIM gSus AS FLOAT
DIM gRel AS INTEGER
DIM gVd AS FLOAT
DIM gVs AS FLOAT
DIM gDet AS FLOAT

SUB cacheLeeren()
    DIM k AS STRING
    FOR EACH k IN MAPKEYS(cache)
        UNLOADSOUND(MAPGET(cache, k))
    NEXT
    MAPCLEAR(cache)
END SUB

' Die Klang-Parameter fuer eine Note: das Instrument -- oder die nackte
' Wellenform des Kanals (Schlagzeugkanal: kurzes Rauschen).
SUB parameterLaden(ii AS INTEGER, c AS INTEGER)
    IF ii >= 0 AND ii < instAnz THEN
        gWf = iWave[ii] : gAtk = iAtk[ii] : gDec = iDec[ii] : gSus = iSus[ii]
        gRel = iRel[ii] : gVd = iVibD[ii] : gVs = iVibS[ii] : gDet = iDet[ii]
    ELSEIF istDrum(c) THEN
        gWf = "noise" : gAtk = 0 : gDec = 120 : gSus = 0.0 : gRel = 0
        gVd = 0.0 : gVs = 0.0 : gDet = 0.0
    ELSE
        gWf = wave[c] : gAtk = 0 : gDec = 0 : gSus = 1.0 : gRel = 20
        gVd = 0.0 : gVs = 0.0 : gDet = 0.0
    END IF
END SUB

FUNCTION klangFuer(midi AS INTEGER, tks AS INTEGER, sl AS INTEGER, _
                   vibX AS INTEGER, vibY AS INTEGER) AS INTEGER
    DIM k AS STRING
    k = gWf + "|" + STR$(gAtk) + "|" + STR$(gDec) + "|" + FORMAT$(gSus, "%.2f") + "|" + _
        STR$(gRel) + "|" + FORMAT$(gVd, "%.3f") + "|" + FORMAT$(gVs, "%.1f") + "|" + _
        FORMAT$(gDet, "%.1f") + "|" + STR$(midi) + "|" + STR$(tks) + "|" + _
        STR$(sl) + "|" + STR$(vibX) + "|" + STR$(vibY)
    IF MAPHAS(cache, k) THEN RETURN MAPGET(cache, k)
    DIM ms AS INTEGER : ms = MAX(1, INT(tks * tickMs()))
    DIM vd AS FLOAT : vd = gVd
    DIM vs AS FLOAT : vs = gVs
    ' Vibrato-Effekt: x = Hz, y = Tiefe in Achtel-Halbtoenen (wie im Render
    ' der Qt-Fassung) -- AUDIO_NOTE will die Tiefe als Anteil der Frequenz.
    IF vibY > 0 AND vibX > 0 THEN
        vd = POW(2.0, vibY * 0.125 / 12.0) - 1.0
        vs = vibX
    END IF
    DIM s AS INTEGER
    ' 0.6 als Kopfraum, wie die Qt-Fassung -- vier Kanaele uebereinander
    ' bei voller Lautstaerke wuerden sonst uebersteuern.
    s = AUDIO_NOTE(gWf, freqVon(midi), ms, gAtk, gDec, gSus, gRel, 0.6, vd, vs, gDet, sl)
    MAPPUT(cache, k, s)
    RETURN s
END FUNCTION

' ------------------------------------------------------------ Wiedergabe
' Die Noten laufen auf einer AUDIO-UHR: geplant wird zwei Reihen voraus,
' gestartet wird samplegenau vom Audio-Faden. Ein bildgetriebener Zaehler
' (wie im GB-Code-Export) schwankt um bis zu ein Bild -- bei 60 Bildern
' sind das 16 ms, und das hoert man bei schnellen Sechzehnteln.
DIM takt AS AUDIO_CLOCK
DIM spielt AS BOOLEAN : spielt = FALSE
DIM songModus AS BOOLEAN : songModus = FALSE
DIM plPos AS INTEGER : plPos = 0        ' Stelle in der Reihenfolge
DIM plPat AS INTEGER : plPat = 0
DIM plRow AS INTEGER : plRow = 0
DIM planTick AS INTEGER : planTick = 0
DIM geplantPat[256] AS INTEGER
DIM geplantRow[256] AS INTEGER
DIM kopfPat AS INTEGER : kopfPat = -1   ' was gerade klingt
DIM kopfRow AS INTEGER : kopfRow = -1
' Beim Rendern in eine Datei laufen dieselben Routinen -- nur das Ziel ist
' ein Misch-Puffer statt der Uhr.
DIM rendern AS BOOLEAN : rendern = FALSE
DIM renderStereo AS BOOLEAN : renderStereo = FALSE
DIM renderAmiga AS BOOLEAN : renderAmiga = FALSE
DIM mixZiel AS INTEGER : mixZiel = -1

SUB ausgeben(snd AS INTEGER, tick AS INTEGER, lautst AS FLOAT, pan AS FLOAT)
    IF rendern THEN
        IF renderStereo THEN
            AUDIO_SOUND_MIX(mixZiel, snd, tick * tickMs(), lautst, pan)
        ELSE
            AUDIO_SOUND_MIX(mixZiel, snd, tick * tickMs(), lautst)
        END IF
    ELSE
        AUDIO_PLAY_AT(snd, takt, tick, lautst)
    END IF
END SUB

' Reihen, bis auf diesem Kanal die naechste Note (oder ein OFF) kommt.
' Am Pattern-Ende geht es im Song in das naechste Pattern der Reihenfolge
' weiter, im Pattern-Modus endet die Note dort.
FUNCTION notenLaenge(p AS INTEGER, c AS INTEGER, r AS INTEGER, _
                     weiter AS BOOLEAN, opos AS INTEGER) AS INTEGER
    DIM n AS INTEGER : n = 1
    DIM rr AS INTEGER
    FOR rr = r + 1 TO patRows[p] - 1
        IF note[p, c, rr] <> LEER THEN RETURN n
        n = n + 1
    NEXT
    IF weiter AND orderAnz > 0 THEN
        DIM p2 AS INTEGER : p2 = order[(opos + 1) MOD orderAnz]
        FOR rr = 0 TO patRows[p2] - 1
            IF note[p2, c, rr] <> LEER THEN RETURN n
            n = n + 1
        NEXT
    END IF
    RETURN n
END FUNCTION

FUNCTION kanalPan(c AS INTEGER, ii AS INTEGER) AS FLOAT
    DIM p AS FLOAT : p = 0.0
    IF ii >= 0 THEN p = iPan[ii]
    IF renderAmiga THEN
        ' Kanal 1+4 links, 2+3 rechts -- die Paula-Verteilung, nicht ganz
        ' hart, wie im Render der Qt-Fassung.
        DIM m AS INTEGER : m = c MOD 4
        IF m = 0 OR m = 3 THEN
            p = p - 0.8
        ELSE
            p = p + 0.8
        END IF
    END IF
    RETURN CLAMP(p, -1.0, 1.0)
END FUNCTION

SUB reiheAusgeben(p AS INTEGER, r AS INTEGER, tick AS INTEGER, _
                  weiter AS BOOLEAN, opos AS INTEGER)
    DIM c AS INTEGER
    FOR c = 0 TO kanaele - 1
        DIM n AS INTEGER : n = note[p, c, r]
        IF n >= 0 AND (rendern OR hoerbar(c)) THEN
            DIM ii AS INTEGER : ii = inst[p, c, r]
            IF ii < 0 OR ii >= instAnz THEN ii = chInst[c]
            parameterLaden(ii, c)
            DIM ticksL AS INTEGER : ticksL = notenLaenge(p, c, r, weiter, opos) * TICKS
            DIM lautst AS FLOAT
            IF vol[p, c, r] > 0 THEN
                lautst = vol[p, c, r] / 15.0
            ELSEIF ii >= 0 THEN
                lautst = iVol[ii] / 15.0
            ELSE
                lautst = 1.0
            END IF
            lautst = lautst * chVol[c]
            DIM pan AS FLOAT : pan = kanalPan(c, ii)
            DIM f AS INTEGER : f = fx[p, c, r]
            DIM par AS INTEGER : par = fxp[p, c, r]
            DIM t AS INTEGER
            IF f = FX_ARP THEN
                ' Der C64-Akkord: Grundton, +x, +y im Tick-Takt.
                DIM ax AS INTEGER : ax = par \ 16
                DIM ay AS INTEGER : ay = par MOD 16
                FOR t = 0 TO ticksL - 1
                    DIM off AS INTEGER : off = 0
                    IF t MOD 3 = 1 THEN off = ax
                    IF t MOD 3 = 2 THEN off = ay
                    ausgeben(klangFuer(MIN(127, n + off), 1, 0, 0, 0), tick + t, lautst, pan)
                NEXT
            ELSEIF f = FX_RET THEN
                DIM alle AS INTEGER : alle = MAX(1, par)
                FOR t = 0 TO ticksL - 1 STEP alle
                    ausgeben(klangFuer(n, MIN(alle, ticksL - t), 0, 0, 0), tick + t, lautst, pan)
                NEXT
            ELSEIF f = FX_VIB THEN
                ausgeben(klangFuer(n, ticksL, slide[p, c, r], par \ 16, par MOD 16), tick, lautst, pan)
            ELSE
                ausgeben(klangFuer(n, ticksL, slide[p, c, r], 0, 0), tick, lautst, pan)
            END IF
        END IF
    NEXT
END SUB

SUB stopp()
    IF spielt THEN
        ' Die Uhr ENTFERNEN, nicht anhalten: ein Klang, der auf eine Uhr
        ' wartet, die es nicht mehr gibt, startet nie (Kira verwirft ihn).
        ' Angehalten bliebe er stehen und kaeme beim naechsten Start als
        ' Geisternote wieder -- an einer Stelle, die dann eine andere ist.
        AUDIO_CLOCK_REMOVE(takt)
    END IF
    spielt = FALSE
    kopfPat = -1 : kopfRow = -1
END SUB

' Zwei Reihen voraus planen. Mehr waere bei einer Aenderung im Gitter zu
' spaet zu hoeren, weniger reicht bei einem Ruckler nicht ueber das Bild.
SUB planen()
    DIM jetzt AS INTEGER : jetzt = AUDIO_CLOCK_TICKS(takt)
    DIM grenze AS INTEGER : grenze = 0
    WHILE planTick <= jetzt + TICKS * 2 AND grenze < 64
        reiheAusgeben(plPat, plRow, planTick, songModus, plPos)
        geplantPat[(planTick \ TICKS) MOD 256] = plPat
        geplantRow[(planTick \ TICKS) MOD 256] = plRow
        planTick = planTick + TICKS
        plRow = plRow + 1
        IF plRow >= patRows[plPat] THEN
            plRow = 0
            IF songModus THEN
                plPos = (plPos + 1) MOD orderAnz
                plPat = order[plPos]
            END IF
        END IF
        grenze = grenze + 1
    WEND
    kopfPat = geplantPat[(jetzt \ TICKS) MOD 256]
    kopfRow = geplantRow[(jetzt \ TICKS) MOD 256]
END SUB

SUB starten(song AS BOOLEAN)
    stopp()
    songModus = song
    IF songModus THEN
        plPos = 0 : plPat = order[0]
    ELSE
        plPos = 0 : plPat = patAkt
    END IF
    plRow = 0 : planTick = 0
    takt = AUDIO_CLOCK_NEW(bpm / 60.0 * 4.0 * TICKS)
    spielt = TRUE
    planen()
    AUDIO_CLOCK_START(takt)
END SUB

' Eine einzelne Note vorhoeren (Klaviatur, Tastatur).
SUB vorhoeren(c AS INTEGER, midi AS INTEGER)
    DIM ii AS INTEGER : ii = chInst[c]
    parameterLaden(ii, c)
    DIM tks AS INTEGER : tks = MAX(TICKS * 2, INT(600.0 / tickMs()))
    DIM lautst AS FLOAT : lautst = chVol[c]
    IF ii >= 0 THEN lautst = lautst * iVol[ii] / 15.0
    AUDIO_PLAY(klangFuer(midi, tks, 0, 0, 0), 0, lautst)
END SUB

' ------------------------------------------------------------ WAV-Ausgabe
SUB wavRendern(pfad AS STRING)
    stopp()
    DIM gesamt AS INTEGER : gesamt = 0
    DIM i AS INTEGER
    FOR i = 0 TO orderAnz - 1
        gesamt = gesamt + patRows[order[i]]
    NEXT
    rendern = TRUE
    mixZiel = AUDIO_SOUND_NEW(INT(gesamt * reihenMs()) + 800)
    DIM tick AS INTEGER : tick = 0
    FOR i = 0 TO orderAnz - 1
        DIM p AS INTEGER : p = order[i]
        DIM r AS INTEGER
        FOR r = 0 TO patRows[p] - 1
            reiheAusgeben(p, r, tick, i < orderAnz - 1, i)
            tick = tick + TICKS
        NEXT
    NEXT
    rendern = FALSE
    DIM faktor AS FLOAT : faktor = AUDIO_SOUND_NORMALIZE(mixZiel)
    AUDIO_SAVE_WAV(mixZiel, pfad)
    UNLOADSOUND(mixZiel)
    meldung = "WAV gesichert: " + pfad + " (" + STR$(gesamt) + " Reihen, Pegel x" + _
              FORMAT$(faktor, "%.2f") + ")"
END SUB

' ------------------------------------------------------------ GB-Code
' Derselbe Player wie der Export der Qt-Fassung (`Song.dh_code`): die
' Reihenfolge wird zu EINER Zeitachse, jede Note klingt genau eine Reihe.
FUNCTION gbCode$() AS STRING
    DIM z AS STRING : z = CHR$(10)
    DIM q AS STRING : q = CHR$(34)
    DIM gesamt AS INTEGER : gesamt = 0
    DIM i AS INTEGER
    FOR i = 0 TO orderAnz - 1
        gesamt = gesamt + patRows[order[i]]
    NEXT
    DIM rowms AS INTEGER : rowms = INT(reihenMs())
    DIM s AS STRING
    s = "IMPORT " + q + "audio" + q + z + z + _
        "' === Tracker-Song (Drachenhauch-Tracker) -- " + STR$(patAnz) + " Pattern(s), " + _
        "Order-Laenge " + STR$(orderAnz) + ", " + STR$(gesamt) + " Reihen, BPM " + STR$(bpm) + " ===" + z + _
        "CONST TRK_ROWS = " + STR$(gesamt) + z + _
        "CONST TRK_ROWMS = " + STR$(rowms) + z + z
    DIM c AS INTEGER
    DIM hatVol[MAX_CH] AS BOOLEAN
    DIM hatSlide[MAX_CH] AS BOOLEAN
    DIM irgendVol AS BOOLEAN : irgendVol = FALSE
    FOR c = 0 TO kanaele - 1
        s = s + "DIM trk" + STR$(c) + "[TRK_ROWS] AS INTEGER" + z
        DIM g AS INTEGER : g = 0
        FOR i = 0 TO orderAnz - 1
            DIM p AS INTEGER : p = order[i]
            DIM r AS INTEGER
            FOR r = 0 TO patRows[p] - 1
                DIM n AS INTEGER : n = note[p, c, r]
                IF n >= 0 THEN
                    DIM w AS INTEGER : w = 1
                    IF NOT istDrum(c) THEN w = INT(freqVon(n) + 0.5)
                    s = s + "trk" + STR$(c) + "[" + STR$(g) + "] = " + STR$(w) + z
                    IF vol[p, c, r] > 0 THEN hatVol[c] = TRUE : irgendVol = TRUE
                    IF slide[p, c, r] <> 0 AND NOT istDrum(c) THEN hatSlide[c] = TRUE
                END IF
                g = g + 1
            NEXT
        NEXT
    NEXT
    FOR c = 0 TO kanaele - 1
        IF hatVol[c] THEN
            s = s + "DIM trkV" + STR$(c) + "[TRK_ROWS] AS INTEGER" + z
            s = s + spur$(c, 1)
        END IF
        IF hatSlide[c] THEN
            s = s + "DIM trkSl" + STR$(c) + "[TRK_ROWS] AS INTEGER" + z
            s = s + spur$(c, 2)
        END IF
    NEXT
    s = s + z + "' --- Player-Status + Update (im Game-Loop aufrufen) ---" + z + _
        "DIM trkRow AS INTEGER" + z + "DIM trkAcc AS FLOAT" + z + _
        "trkRow = 0" + z + "trkAcc = 0.0" + z + z
    IF irgendVol THEN
        s = s + "' Lautstaerke-Spur -> Amplitude (0 = Standard 0.5)" + z + _
            "FUNCTION TRACKER_AMP(pct AS INTEGER) AS FLOAT" + z + _
            "    IF pct <= 0 THEN RETURN 0.5" + z + _
            "    RETURN pct / 100.0" + z + "END FUNCTION" + z + z
    END IF
    s = s + "SUB TRACKER_PLAY_ROW(r AS INTEGER)" + z
    FOR c = 0 TO kanaele - 2
        DIM wf AS STRING : wf = wave[c]
        IF chInst[c] >= 0 THEN wf = iWave[chInst[c]]
        DIM amp AS STRING : amp = "0.5"
        IF hatVol[c] THEN amp = "TRACKER_AMP(trkV" + STR$(c) + "[r])"
        IF chVol[c] <> 1.0 THEN amp = "(" + amp + " * " + FORMAT$(chVol[c], "%.2f") + ")"
        DIM ton AS STRING
        ton = "AUDIO_TONE(trk" + STR$(c) + "[r], TRK_ROWMS, " + q + wf + q + ", " + amp + ")"
        IF hatSlide[c] THEN
            DIM sfx AS STRING
            sfx = "AUDIO_SFX(" + q + wf + q + ", trk" + STR$(c) + "[r], trkSl" + STR$(c) + _
                  "[r], 4, TRK_ROWMS, 40, 0.0, 0, " + amp + ")"
            s = s + "    IF trk" + STR$(c) + "[r] > 0 THEN" + z + _
                "        IF trkSl" + STR$(c) + "[r] <> 0 THEN" + z + _
                "            PLAYSOUND(" + sfx + ")" + z + "        ELSE" + z + _
                "            PLAYSOUND(" + ton + ")" + z + "        END IF" + z + "    END IF" + z
        ELSE
            s = s + "    IF trk" + STR$(c) + "[r] > 0 THEN PLAYSOUND(" + ton + ")" + z
        END IF
    NEXT
    DIM d AS INTEGER : d = kanaele - 1
    DIM damp AS STRING : damp = "0.5"
    IF hatVol[d] THEN damp = "TRACKER_AMP(trkV" + STR$(d) + "[r])"
    IF chVol[d] <> 1.0 THEN damp = "(" + damp + " * " + FORMAT$(chVol[d], "%.2f") + ")"
    s = s + "    IF trk" + STR$(d) + "[r] > 0 THEN PLAYSOUND(AUDIO_NOISE(120, " + damp + "))" + z
    s = s + "END SUB" + z + z + _
        "SUB TRACKER_UPDATE(dt_ms AS FLOAT)" + z + _
        "    trkAcc = trkAcc + dt_ms" + z + _
        "    WHILE trkAcc >= TRK_ROWMS" + z + _
        "        trkAcc = trkAcc - TRK_ROWMS" + z + _
        "        TRACKER_PLAY_ROW(trkRow)" + z + _
        "        trkRow = (trkRow + 1) MOD TRK_ROWS" + z + _
        "    WEND" + z + "END SUB" + z + z + _
        "' Im Game-Loop:  TRACKER_UPDATE(DELTA() * 1000.0)" + z
    RETURN s
END FUNCTION

' Die Lautstaerke- (welches = 1) bzw. Slide-Spur (2) eines Kanals als
' Zuweisungen -- nur die belegten Reihen.
FUNCTION spur$(c AS INTEGER, welches AS INTEGER) AS STRING
    DIM z AS STRING : z = CHR$(10)
    DIM s AS STRING : s = ""
    DIM g AS INTEGER : g = 0
    DIM i AS INTEGER
    DIM rowms AS INTEGER : rowms = INT(reihenMs())
    FOR i = 0 TO orderAnz - 1
        DIM p AS INTEGER : p = order[i]
        DIM r AS INTEGER
        FOR r = 0 TO patRows[p] - 1
            IF note[p, c, r] >= 0 THEN
                IF welches = 1 AND vol[p, c, r] > 0 THEN
                    DIM pct AS INTEGER : pct = CLAMP(INT(vol[p, c, r] / 15.0 * 100.0 + 0.5), 1, 100)
                    s = s + "trkV" + STR$(c) + "[" + STR$(g) + "] = " + STR$(pct) + z
                ELSEIF welches = 2 AND slide[p, c, r] <> 0 THEN
                    DIM f0 AS FLOAT : f0 = freqVon(note[p, c, r])
                    DIM f1 AS FLOAT : f1 = f0 * POW(2.0, slide[p, c, r] / 12.0)
                    DIM hz AS INTEGER : hz = INT((f1 - f0) * 1000.0 / rowms + 0.5)
                    s = s + "trkSl" + STR$(c) + "[" + STR$(g) + "] = " + STR$(hz) + z
                END IF
            END IF
            g = g + 1
        NEXT
    NEXT
    RETURN s
END FUNCTION

' ------------------------------------------------------------ Fenster
CONST SW = 1400
CONST SH = 840
CONST LINKS = 300
CONST GRID_Y = 84
CONST PIANO_H = 96
CONST HDR_H = 24
CONST RH_W = 40
CONST CELL_W = 118
CONST ROW_H = 20

SCREEN(SW, SH, "Drachenhauch - Tracker", 1)
SETFPS(60)
GUI_THEME_PRESET("glas_dunkel")
TEXT_SIZE(16)

DIM win AS GUI_WINDOW
win = GUI_WINDOW("Tracker", 0, 0, SW, SH)
GUI_WINDOW_CHROME(win, FALSE)
GUI_WINDOW_MOVABLE(win, FALSE)

' Werkzeugleiste 1: Datei, Tempo, Wiedergabe, Verlauf, Ausgabe
DIM bNeu AS GUI_WIDGET : bNeu = GUI_BUTTON(win, "Neu", 12, 8, 56, 28)
DIM bAuf AS GUI_WIDGET : bAuf = GUI_BUTTON(win, "Oeffnen", 72, 8, 78, 28)
DIM bSpei AS GUI_WIDGET : bSpei = GUI_BUTTON(win, "Sichern", 154, 8, 78, 28)
DIM bSpeiAls AS GUI_WIDGET : bSpeiAls = GUI_BUTTON(win, "Sichern als", 236, 8, 100, 28)
DIM lblBpm AS GUI_WIDGET : lblBpm = GUI_LABEL(win, "BPM", 350, 14)
DIM spBpm AS GUI_WIDGET : spBpm = GUI_SPINNER(win, 386, 8, 80, 40, 300, 120)
DIM lblKan AS GUI_WIDGET : lblKan = GUI_LABEL(win, "Kanaele", 480, 14)
DIM spKan AS GUI_WIDGET : spKan = GUI_SPINNER(win, 546, 8, 70, MIN_CH, MAX_CH, 4)
DIM bPlayPat AS GUI_WIDGET : bPlayPat = GUI_BUTTON(win, "> Pattern", 632, 8, 96, 28)
DIM bPlaySong AS GUI_WIDGET : bPlaySong = GUI_BUTTON(win, "> Song", 732, 8, 80, 28)
DIM bStop AS GUI_WIDGET : bStop = GUI_BUTTON(win, "Stopp", 816, 8, 64, 28)
DIM bZur AS GUI_WIDGET : bZur = GUI_BUTTON(win, "Zurueck", 896, 8, 82, 28)
GUI_TOOLTIP(bZur, "Strg+Z -- die letzte Aenderung zuruecknehmen")
DIM bVor AS GUI_WIDGET : bVor = GUI_BUTTON(win, "Vor", 982, 8, 50, 28)
GUI_TOOLTIP(bVor, "Strg+Y -- wieder herstellen")
DIM bWav AS GUI_WIDGET : bWav = GUI_BUTTON(win, "WAV ...", 1046, 8, 68, 28)
GUI_TOOLTIP(bWav, "Den ganzen Song offline mischen und als WAV sichern")
DIM cbStereo AS GUI_WIDGET : cbStereo = GUI_CHECKBOX(win, "Stereo", 1122, 14, FALSE)
GUI_TOOLTIP(cbStereo, "WAV mit Instrument-Pan statt Mono")
DIM cbAmiga AS GUI_WIDGET : cbAmiga = GUI_CHECKBOX(win, "Amiga", 1204, 14, FALSE)
GUI_TOOLTIP(cbAmiga, "Kanal 1+4 links, 2+3 rechts -- der Paula-Stereoeindruck")
DIM bCode AS GUI_WIDGET : bCode = GUI_BUTTON(win, "GB-Code", 1284, 8, 80, 28)
