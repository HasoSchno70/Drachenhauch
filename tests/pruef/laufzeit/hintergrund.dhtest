' (Bis Stufe 46 in test_hintergrund.py.)
IMPORT "db"
DIM a AS INTEGER
a = DB_QUERY_START("d.db", "SELECT quatsch FROM gibtsnicht")
WHILE NOT DB_QUERY_READY(a)
    SLEEP(1)
WEND
TRY
    PRINT DB_QUERY_RESULT(a)
CATCH e
    PRINT "gefangen"
END TRY
--- vorher
