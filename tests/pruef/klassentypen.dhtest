' Klassentypen werden geprueft (docs/entwurf-schnittstellen.md, Weg B).
' Ein Platz vom Typ einer Klasse -- Variable, Parameter, Feld, Feldelement,
' MAP-Wert, Rueckgabe -- nimmt NIL und Instanzen der Klasse oder einer
' Unterklasse (`value::klasse_pruefen`). Bis 2026-10-22 reichte die Laufzeit
' Klassen ungeprueft durch: eine Variable AS Tier nahm ein Auto, ein Parameter
' AS Datei die Zahl 5, und der Fehler kam erst beim naechsten Methodenaufruf.
' `--check` warnt, wo es sicher nicht passt (fremde Klasse, Zahl, Text).

=== erlaubt bleiben unterklasse nil und polymorphie
CLASS Tier
    FUNCTION laut() AS STRING
        RETURN "?"
    END FUNCTION
END CLASS
CLASS Hund EXTENDS Tier
    FUNCTION laut() AS STRING
        RETURN "wuff"
    END FUNCTION
END CLASS
CLASS Dackel EXTENDS Hund
END CLASS
DIM t AS Tier
t = NEW Dackel()
PRINT t.laut()
t = NIL
PRINT t IS NIL
DIM tiere AS ARRAY OF Tier : tiere = []
ARRAY_PUSH(tiere, NEW Tier())
ARRAY_PUSH(tiere, NEW Hund())
DIM x AS Tier
FOR EACH x IN tiere
    PRINT x.laut()
NEXT
' Herunter geht, wenn es wirklich einer ist
DIM h AS Hund
t = NEW Hund()
h = t
PRINT h.laut()
--- erwartet
wuff
TRUE
?
wuff
wuff

=== fremde klasse an eine variable
CLASS Tier
END CLASS
CLASS Auto
END CLASS
DIM t AS Tier
t = NEW Auto()
PRINT "nicht erreicht"
--- fehler
Erwartet TIER (oder eine Unterklasse), erhalten AUTO

=== herunter in die falsche unterklasse
CLASS Tier
END CLASS
CLASS Hund EXTENDS Tier
END CLASS
CLASS Katze EXTENDS Tier
END CLASS
DIM t AS Tier : t = NEW Katze()
DIM h AS Hund
h = t
--- fehler
Erwartet HUND (oder eine Unterklasse), erhalten KATZE

=== zahl an einen klassenparameter
CLASS Datei
    FUNCTION name() AS STRING
        RETURN "d"
    END FUNCTION
END CLASS
SUB zeige(d AS Datei)
    PRINT d.name()
END SUB
zeige(NEW Datei())
zeige(5)
--- fehler
Erwartet DATEI (oder eine Unterklasse), erhalten INTEGER

=== lokale variable in einer sub
