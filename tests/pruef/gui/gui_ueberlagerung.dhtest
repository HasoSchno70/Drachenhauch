=== der popover liegt ueber dem gemalten
' Das Programm malt nach GUI_DRAW(FALSE) selbst ueber alles; der Popover
' kommt mit der oberen Schicht danach -- samt Pfeil zum Knopf.
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM knopf AS GUI_WIDGET
knopf = GUI_BUTTON(w, "Optionen", 20, 20, 120, 30)
DIM pop AS GUI_WINDOW
pop = GUI_POPOVER(knopf, 200, 120)
GUI_POPOVER_SHOW(pop)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW(FALSE)
    BOX(0, 0, 599, 399, &HFF0000)
    GUI_DRAW_TOP()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=4
--- bild
100 120 nicht #FF0000 +-40
80 56 nicht #FF0000 +-40
60 53 #FF0000 +-10
300 300 #FF0000 +-10

=== toasts zaehlen, verschwinden und lassen sich wegklicken
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM unter AS GUI_WIDGET
unter = GUI_BUTTON(w, "Darunter", 250, 350, 100, 40)
DIM i AS INTEGER
FOR i = 1 TO 5
    GUI_TOAST(w, "Meldung " + STR$(i), "info", 0)
NEXT
PRINT "hoechstens vier: " + STR$(GUI_TOAST_COUNT(w))
GUI_TOAST_CLEAR(w)
PRINT "geleert: " + STR$(GUI_TOAST_COUNT(w))
GUI_TOAST(w, "kurz", "erfolg", 200)
AUTOMATION_PLAY("ev.txt")
DIM getroffen AS BOOLEAN : getroffen = FALSE
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(unter) THEN getroffen = TRUE
    n = n + 1
    IF n = 3 THEN PRINT "nach 3 bildern: " + STR$(GUI_TOAST_COUNT(w))
    IF n = 20 THEN PRINT "nach 200 ms: " + STR$(GUI_TOAST_COUNT(w)) : GUI_TOAST(w, "bleibt", "fehler", 0)
    IF n = 30 THEN PRINT "ohne zeit: " + STR$(GUI_TOAST_COUNT(w))
    IF n = 60 THEN PRINT "weggeklickt: " + STR$(GUI_TOAST_COUNT(w)) + " knopf darunter " + STR$(getroffen)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
