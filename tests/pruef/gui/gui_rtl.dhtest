=== gespiegelt steht ein feld ohne ausrichtung rechts und der klick trifft den text
IMPORT "gui"
SCREEN(480, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 480, 220)
GUI_WINDOW_CHROME(w, FALSE)
