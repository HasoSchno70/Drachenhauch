=== map values items
DIM m AS MAP OF INTEGER
MAPPUT(m, "x", 10)
MAPPUT(m, "y", 20)
DIM vs AS ARRAY OF INTEGER
vs = MAPVALUES(m)
PRINT vs[0] + vs[1]
DIM it AS ARRAY OF TUPLE
it = m.items()
DIM k AS STRING
DIM v AS INTEGER
(k, v) = it[0]
PRINT k
PRINT v
--- erwartet
30
x
10

