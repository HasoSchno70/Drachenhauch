' Rechtschreibung (rechtschreibung.rs, gui_rechtschreibung.rs;
' docs/entwurf-gui-wie-gtk.md Paket 3). Format: docs/werkzeuge.md.
'
' Die Woerterbuecher sind winzige Hunspell-Dateien als Beilage -- so ist das
' Ergebnis auf jedem System dasselbe. Nur ein Fall fragt die Pruefung von
' Windows selbst, und der uebergeht sich ohne deutsche oder englische Sprache.
'
' Die Fenster sind randlos bei (0, 0): eine Widget-Lage ist dann eine
' Bildschirmlage. Tasten in den Aufnahmen: 256 ESC, 257 Enter, 264 runter,
' 265 hoch, 299 F10, 340 Umschalt, 341 Strg, 90 Z. Maustaste rechts = 1.

=== ein woerterbuch aus dateien
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic")
PRINT SPELL_LANGUAGE$(h)
PRINT SPELL_CHECK(h, "Haus"); " "; SPELL_CHECK(h, "Hause"); " "; SPELL_CHECK(h, "Hasu")
DIM v AS ARRAY OF STRING
v = SPELL_SUGGEST(h, "Hasu")
PRINT "vorschlag haus "; ARRAY_INDEXOF(v, "Haus") >= 0
PRINT "hoechstens eins "; LEN(SPELL_SUGGEST(h, "Hasu", 1))
DIM s AS ARRAY OF INTEGER
DIM l AS ARRAY OF INTEGER
DIM t AS STRING
t = "Ein Hasu im Gartn, da ist ein Apfel."
(s, l) = SPELL_ERRORS(h, t)
DIM i AS INTEGER
FOR i = 0 TO LEN(s) - 1
    PRINT s[i]; " "; l[i]; " "; MID$(t, s[i], l[i])
NEXT
SPELL_IGNORE(h, "Gartn")
(s, l) = SPELL_ERRORS(h, t)
PRINT "nach ignorieren "; LEN(s); " "; SPELL_CHECK(h, "Gartn")
SPELL_FREE(h)
TRY
    PRINT SPELL_CHECK(h, "Haus")
CATCH e
    PRINT e
END TRY
--- datei de-TEST.dic
8
Haus/S
Baum
Garten
Apfel
ein
im
ist
da

--- datei de-TEST.aff
SET UTF-8
TRY esianrtolcdugmphbyfvkwzESIANRTOLCDUGMPHBYFVKWZ
SFX S Y 1
SFX S 0 e .

--- erwartet
de-TEST
TRUE TRUE FALSE
vorschlag haus TRUE
hoechstens eins 1
4 4 Hasu
12 5 Gartn
nach ignorieren 1 TRUE
SPELL_CHECK: 0 ist kein Woerterbuch (SPELL_LOAD oder SPELL_SYSTEM)

=== woerter mit umlaut und apostroph, zahlen und einzelbuchstaben zaehlen nicht
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic", "de-TEST.aff")
DIM s AS ARRAY OF INTEGER
DIM l AS ARRAY OF INTEGER
DIM t AS STRING
t = "x 42 Äpfl's Haus-Baum Grün"
(s, l) = SPELL_ERRORS(h, t)
DIM i AS INTEGER
FOR i = 0 TO LEN(s) - 1
    PRINT MID$(t, s[i], l[i])
NEXT
