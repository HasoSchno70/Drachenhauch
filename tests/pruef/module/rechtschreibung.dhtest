1
Haus

--- datei de-TEST.aff
SET UTF-8

--- umgebung
DHRT_FRAMES=10
DHRT_SCREENSHOT={fall}/bild.png
--- nachher
' Rote Punkte je Fuenftel der Breite, getrennt fuer Bereich und Feld.
DIM b AS IMAGE
b = LOADIMAGE("bild.png")
DIM x AS INTEGER
DIM y AS INTEGER
DIM c AS INTEGER
DIM zeile AS STRING
DIM von AS INTEGER
DIM bis AS INTEGER
DIM k AS INTEGER
FOR k = 0 TO 1
    IF k = 0 THEN von = 20 : bis = 90 ELSE von = 120 : bis = 150
    zeile = ""
    DIM teil AS INTEGER
    FOR teil = 0 TO 4
        DIM rot AS INTEGER : rot = 0
        FOR x = 20 + teil * 40 TO 20 + teil * 40 + 39
            FOR y = von TO bis
                c = GETPIXEL(b, x, y)
                IF RED(c) > 170 AND GREEN(c) < 110 AND BLUE(c) < 110 THEN rot = rot + 1
            NEXT
        NEXT
        zeile = zeile + IIF(rot > 3, "x", ".")
    NEXT
    PRINT zeile
NEXT
--- erwartet
.xx..
.xx..

=== rechtsklick auf das wort schlaegt vor und setzt ein
' Ein Rechtsklick auf "Hasu" oeffnet das Menue, ein Klick auf den ersten
' Vorschlag setzt ihn ein -- ein eigener Schritt fuer Strg+Z.
IMPORT "gui"
SCREEN(500, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 20, 360, 28)
GUI_SET_TEXT(tf, "Hasu ist da")
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic")
GUI_SPELL(tf, h)
DIM geaendert AS INTEGER : geaendert = 0
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 12 THEN PRINT "offen, text "; GUI_TEXT(tf)
    IF n = 25 THEN PRINT "gewaehlt "; GUI_TEXT(tf); " = "; SPELL_SUGGEST(h, "Hasu")[0]
    IF n = 45 THEN PRINT "zurueck "; GUI_TEXT(tf)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
