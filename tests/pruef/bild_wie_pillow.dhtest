=== anpassungen wie imageenhance
IMPORT "helfer.dh"
IMPORT "imgfx"
DIM q AS IMAGE : q = LOADIMAGE("quelle.png")
PRINT "helligkeit 0.6 "; bvAbweichung$(IMAGE_ENHANCE(q, "helligkeit", 0.6), LOADIMAGE("helligkeit_0.6.png"))
PRINT "brightness 1.7 "; bvAbweichung$(IMAGE_ENHANCE(q, "brightness", 1.7), LOADIMAGE("helligkeit_1.7.png"))
PRINT "kontrast 0 "; bvAbweichung$(IMAGE_ENHANCE(q, "kontrast", 0), LOADIMAGE("kontrast_0.0.png"))
PRINT "kontrast 1.7 "; bvAbweichung$(IMAGE_ENHANCE(q, "kontrast", 1.7), LOADIMAGE("kontrast_1.7.png"))
