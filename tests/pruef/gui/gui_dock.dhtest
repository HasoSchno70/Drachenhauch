=== ein reiter in die mitte gezogen schwebt und liegt obenauf
IMPORT "hilfe.dh"
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN daVerteilen()
    bild = bild + 1
    IF bild = 3 THEN
        dmZug(daReiterX("ausgabe"), daReiterY("ausgabe"), 500, 200, 8)
        dmSpielen()
    END IF
    IF bild = 40 THEN
        PRINT "ausgabe "; GUI_DOCK_WHERE$(w, "ausgabe"); " "; daRect$("ausgabe")
        PRINT "terminal kommt nach vorn "; GUI_DOCK_SHOWN(w, "terminal")
        PRINT "in der schwebenden leiste "; GUI_HIT_TEST(600, 300) = daListe[2]
        PRINT "daneben die mitte "; GUI_HIT_TEST(300, 100) = daMitte
        EXIT(0)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
