' Drachenhauch Studio: modale Fenster im erzeugten Programm -- gefunden beim
' Port der Kuehlschrank-App (Kachel anklicken oeffnet das Detailfenster):
' - ZeigenModal (und Frage) drehen ihr erstes Bild noch im Bild des Klicks;
'   vorher sah die innere Schleife denselben MOUSE_HIT noch einmal, und das
'   Maus-Ereignis der Zeichenflaeche oeffnete das Fenster wieder und wieder,
'   bis die Aufruftiefe ueberlief.
' - GUI_HIT_TEST sieht durch den Schleier: ein Klick auf die Zeichenflaeche
'   neben dem modalen Fenster oeffnete ein zweites (studioFrei).
' - Standard- und Abbrechen-Knopf eines Fensters (Inspektor, beim Namen):
'   Enter und Esc druecken ihn.
' - Taste erreicht ein modales Fenster (vorher nie, GUI_MODAL() war ja wahr).
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== eine zeichenflaeche oeffnet das modale fenster einmal, enter und esc schliessen es
' Klick auf die Flaeche oeffnet den Dialog; ein Klick daneben auf die Flaeche
' (hinter dem Schleier) tut nichts; Enter drueckt OK. Zweiter Klick, Esc
' drueckt Zu.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
slHin(10, 10)
slWarten(10)
slTaste(294)
slWarten(150)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_LAUF_BILDER", "20")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
PRINT "erzeugt "; LEN(slAnfang(log, "erzeugt ")) = 1
PRINT "code "; probeLaufen(p, "probe.dh")
--- argumente
{sammlung}/../../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
' Statt studioLauf(...) die Probe-Zeilen (mit ihrer Aufnahme).
FUNCTION probeLaufen(p AS STRING, teil AS STRING) AS INTEGER
    DIM neu AS ARRAY OF STRING : neu = []
    DIM s AS STRING
    FOR EACH s IN READLINES(p + "/_studio/main.dh")
        IF LEFT$(s, 11) = "studioLauf(" THEN
            DIM t AS STRING
            FOR EACH t IN READLINES(CWD$() + "/" + teil)
                ARRAY_PUSH(neu, t)
            NEXT
        ELSE
            ARRAY_PUSH(neu, s)
        END IF
    NEXT
    WRITEALL(p + "/_studio/probe.dh", JOIN$(neu, CHR$(10)) + CHR$(10))
    COPYFILE(CWD$() + "/klick.txt", p + "/_studio/klick.txt")
    DIM k AS INTEGER : k = PROCESS_START("dhrt", "run", "--bilder", "90", p + "/_studio/probe.dh")
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t2 AS STRING : t2 = PROCESS_READ$(k) + PROCESS_ERR$(k)
        IF t2 <> "" THEN
            DIM zeile AS STRING
            FOR EACH zeile IN SPLIT(REPLACE$(t2, CHR$(13), ""), CHR$(10))
                IF zeile <> "" AND LEFT$(zeile, 8) <> "WARNING:" AND LEFT$(zeile, 5) <> "INFO:" THEN PRINT zeile
            NEXT
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(k) THEN
            leer = leer + 1
            SLEEP(30)
        END IF
    WEND
    RETURN PROCESS_CODE(k)
END FUNCTION
--- datei probe.dh
AUTOMATION_PLAY("klick.txt")
SCREEN(640, 480, "Probe")
studioSchirmB = SCREENWIDTH() : studioSchirmH = SCREENHEIGHT()
studioDieStartseite = studioStartFenster
studioDieApp.Geoeffnet()
studioStartFenster.studioHaupt = TRUE
studioStartFenster.Zeigen()
WHILE studioBild()
WEND
--- datei klick.txt
c 17
e 0 7 60 60 0 0
e 4 7 60 60 0 0
e 5 7 60 60 0 0
e 6 6 0 0 0 0
e 8 5 0 0 0 0
e 20 7 60 120 0 0
e 21 7 60 120 0 0
e 22 6 0 0 0 0
e 24 5 0 0 0 0
e 30 2 257 0 0 0
e 32 1 257 0 0 0
e 40 7 60 60 0 0
e 41 7 60 60 0 0
e 42 6 0 0 0 0
e 44 5 0 0 0 0
e 55 2 256 0 0 0
e 57 1 256 0 0 0
--- datei proj/projekt.dhstudio
{"format":"drachenhauch-studio","fassung":1,"name":"proj","start":"Hauptfenster","elemente":[{"art":"app","name":"App"},{"art":"fenster","name":"Hauptfenster"},{"art":"fenster","name":"Dialog"}]}
--- datei proj/Hauptfenster.dhform
{"title":"Haupt","name":"Hauptfenster","w":640,"h":480,"widgets":[
{"kind":"canvas","name":"flaeche","x":20,"y":20,"w":200,"h":200}]}
--- datei proj/Hauptfenster.dh
CLASS Hauptfenster EXTENDS Hauptfenster_Basis
    DIM auf AS INTEGER

    SUB flaeche_Maus()
        Self.auf = Self.auf + 1
        PRINT "maus "; Self.auf
        DIM d AS Dialog : d = NEW Dialog()
        d.ZeigenModal()
        PRINT "dialog zurueck "; d.wie
    END SUB
END CLASS
--- datei proj/Dialog.dhform
{"title":"Dialog","name":"Dialog","w":300,"h":160,"studio_standard":"knopfOk","studio_abbrechen":"knopfZu","widgets":[
{"kind":"textinput","name":"feld","x":20,"y":20,"w":200,"h":26},
{"kind":"button","name":"knopfOk","text":"OK","x":20,"y":70,"w":100,"h":30},
{"kind":"button","name":"knopfZu","text":"Zu","x":130,"y":70,"w":100,"h":30}]}
--- datei proj/Dialog.dh
CLASS Dialog EXTENDS Dialog_Basis
    DIM wie AS STRING

    SUB knopfOk_Klick()
        Self.wie = "ok"
        Self.Zumachen()
    END SUB

    SUB knopfZu_Klick()
        Self.wie = "zu"
        Self.Zumachen()
    END SUB
END CLASS
--- erwartet
erzeugt TRUE
maus 1
dialog zurueck ok
maus 2
dialog zurueck zu
code 0

=== der klick, der ein modales fenster oeffnet, trifft es nicht gleich mit
' Das Fenster geht genau dort auf, wo geklickt wurde, und hat selbst eine
' Zeichenflaeche: im ersten Bild seiner Schleife darf es den oeffnenden Klick
' nicht noch einmal sehen (MOUSE_HIT gilt bis FLIP). Erst der zweite Klick
' trifft seine Flaeche.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
slHin(10, 10)
slWarten(10)
slTaste(294)
slWarten(150)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_LAUF_BILDER", "20")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
PRINT "erzeugt "; LEN(slAnfang(log, "erzeugt ")) = 1
PRINT "code "; probeLaufen(p, "probe.dh")
--- argumente
{sammlung}/../../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
FUNCTION probeLaufen(p AS STRING, teil AS STRING) AS INTEGER
    DIM neu AS ARRAY OF STRING : neu = []
    DIM s AS STRING
    FOR EACH s IN READLINES(p + "/_studio/main.dh")
        IF LEFT$(s, 11) = "studioLauf(" THEN
            DIM t AS STRING
            FOR EACH t IN READLINES(CWD$() + "/" + teil)
                ARRAY_PUSH(neu, t)
            NEXT
        ELSE
            ARRAY_PUSH(neu, s)
        END IF
    NEXT
    WRITEALL(p + "/_studio/probe.dh", JOIN$(neu, CHR$(10)) + CHR$(10))
    COPYFILE(CWD$() + "/klick.txt", p + "/_studio/klick.txt")
    DIM k AS INTEGER : k = PROCESS_START("dhrt", "run", "--bilder", "60", p + "/_studio/probe.dh")
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t2 AS STRING : t2 = PROCESS_READ$(k) + PROCESS_ERR$(k)
        IF t2 <> "" THEN
            DIM zeile AS STRING
            FOR EACH zeile IN SPLIT(REPLACE$(t2, CHR$(13), ""), CHR$(10))
                IF zeile <> "" AND LEFT$(zeile, 8) <> "WARNING:" AND LEFT$(zeile, 5) <> "INFO:" THEN PRINT zeile
            NEXT
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(k) THEN
            leer = leer + 1
            SLEEP(30)
        END IF
    WEND
    RETURN PROCESS_CODE(k)
END FUNCTION
--- datei probe.dh
AUTOMATION_PLAY("klick.txt")
SCREEN(640, 480, "Probe")
studioSchirmB = SCREENWIDTH() : studioSchirmH = SCREENHEIGHT()
studioDieStartseite = studioStartFenster
studioDieApp.Geoeffnet()
studioStartFenster.studioHaupt = TRUE
studioStartFenster.Zeigen()
WHILE studioBild()
WEND
