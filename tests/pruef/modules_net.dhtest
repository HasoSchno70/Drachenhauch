=== tcp full roundtrip
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
DIM srv AS NET_SOCKET
DIM i AS INTEGER
FOR i = 1 TO 50
    srv = NET_TCP_ACCEPT(l)
    IF NOT IS_NIL(srv) THEN BREAK
    SLEEP(2)
NEXT
PRINT IS_NIL(srv)
PRINT NET_SEND(client, "hallo")
DIM got AS STRING
FOR i = 1 TO 50
    got = NET_RECV(srv, 1024)
    IF got <> "" THEN BREAK
    SLEEP(2)
NEXT
PRINT got
NET_CLOSE(client)
NET_CLOSE(srv)
NET_CLOSE_LISTENER(l)
--- erwartet
FALSE
5
hallo

