=== der einkaufszettel: bericht aus der abfrage, gaenge aus dem programm
' Drucken mit KUEHL_ZETTEL schreibt den Bericht Einkaufszettel als PDF:
' nur offene Posten, nach Gang sortiert, mit Markt im Kopf -- ohne
' Sortierung in der Reihenfolge der Liste und ohne Markt.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
SETENV("KUEHL_PDF", CWD$())
PRINT "code "; kProbe(p, "probe.dh", "", 10)
DIM d AS STRING
FOR EACH d IN ["sortiert.pdf", "liste.pdf"]
    PRINT "== "; d
    DIM z AS STRING
    FOR EACH z IN SPLIT(JOIN$(pdfSeiten(CWD$() + "/" + d), CHR$(10)), CHR$(10))
        IF z <> "" AND INSTR(z, ".2026") < 0 THEN PRINT z
    NEXT
NEXT
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
IMPORT "{sammlung}/../_hilfen/pdftext.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO shopping_list (product_name, quantity, unit, category, notes, checked) VALUES ('Tiefkühlpizza', 2, 'Stück', NULL, 'mit Salami', 0), ('Bananen', 6, 'Stück', 'Obst', NULL, 0), ('Brot', 1, 'Stück', 'Backwaren', NULL, 1), ('Käse', 0.5, 'kg', 'Milchprodukte', NULL, 0), ('Seife', 0, 'Stück', NULL, NULL, 0)")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS EinkaufSeite : s = f.einkauf
f.geaendert()
' Drucken meldet das Control; das Fenster holt es im naechsten Bild ab.
SUB bilder()
    DIM n AS INTEGER
    WHILE n < 2 AND studioBild()
        n = n + 1
    WEND
END SUB
SETENV("KUEHL_ZETTEL", GETENV$("KUEHL_PDF") + "/liste.pdf")
s.knopfDrucken_Klick()
bilder()
GUI_DROPDOWN_SET_SELECTED(s.marktWahl, ARRAY_INDEXOF(marktListe(), "REWE") + 1)
s.marktWahl_Geaendert()
GUI_SET_CHECKED(s.sortierKasten, TRUE)
s.sortierKasten_Geaendert()
SETENV("KUEHL_ZETTEL", GETENV$("KUEHL_PDF") + "/sortiert.pdf")
s.knopfDrucken_Klick()
bilder()
PRINT "status "; GUI_STATUSBAR_TEXT$(f.status, 3)
--- erwartet
status Einkaufszettel: sortiert.pdf
