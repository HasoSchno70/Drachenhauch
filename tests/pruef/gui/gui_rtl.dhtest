GUI_TABLE_HEADERS(t, ["A", "B", "C"])
GUI_TABLE_ADD_ROW(t, ["3", "x", "y"])
GUI_TABLE_ADD_ROW(t, ["1", "x", "y"])
GUI_TABLE_ADD_ROW(t, ["2", "x", "y"])
GUI_SET_NAME(t, "t")
GUI_STYLESHEET("#t { fg: #FF0000 }")
GUI_WINDOW_RTL(w, TRUE)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(480, 220)
FUNCTION rot_zwischen(x0 AS INTEGER, x1 AS INTEGER) AS BOOLEAN
    RENDERTARGET_BEGIN(rt) : CLS(0) : GUI_DRAW() : RENDERTARGET_END()
    DIM bild AS IMAGE : bild = RENDERTARGET_IMAGE(rt)
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR x = x0 TO x1
        FOR y = 50 TO 110
            IF (GETPIXEL(bild, x, y) BAND &HFFFFFF) = &HFF0000 THEN RETURN TRUE
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION
GUI_UPDATE()
