' Der Reiter Lagerorte: je Ort eine Kachel in seiner Farbe mit Sinnbild,
' Anzahl und Warnungen -- wie tabs/locations_tab.py mit LocationCard. Ein
' Klick auf eine Kachel meldet Details (das Fenster öffnet LagerortFenster).
' Die Kacheln malt die Zeichenfläche selbst; das Mausrad rollt, wenn nicht
' alle auf einmal passen.
CLASS LagerorteSeite EXTENDS LagerorteSeite_Basis
    DIM orte AS ARRAY OF Ort
    DIM rollen AS INTEGER
    ' Der Ort, dessen Details aufgehen sollen.
    DIM gewaehlterOrt AS STRING

    SUB laden()
        Self.orte = ortUebersicht()
        Self.rollen = MIN(Self.rollen, Self.rollenMax())
        GUI_SET_TEXT(Self.leerText, IIF(LEN(Self.orte) = 0, "📦 Noch keine Lagerorte vorhanden. Füge Produkte hinzu, um Lagerorte zu sehen.", ""))
    END SUB

    FUNCTION spalten() AS INTEGER
        RETURN MAX(1, (GUI_CANVAS_W(Self.flaeche) - 2 * KARTE_RAND + KARTE_ABSTAND) \ (KARTE_B + KARTE_ABSTAND))
    END FUNCTION

    FUNCTION rollenMax() AS INTEGER
        DIM zeilen AS INTEGER : zeilen = (LEN(Self.orte) + Self.spalten() - 1) \ Self.spalten()
        RETURN MAX(0, 2 * KARTE_RAND + zeilen * (KARTE_H + KARTE_ABSTAND) - KARTE_ABSTAND - GUI_CANVAS_H(Self.flaeche))
    END FUNCTION

    ' Die Kachel unter einem Punkt der Fläche (-1 = keine).
    FUNCTION karteBei(x AS INTEGER, y AS INTEGER) AS INTEGER
        DIM i AS INTEGER
        FOR i = 0 TO LEN(Self.orte) - 1
            DIM kx AS INTEGER : kx = KARTE_RAND + (i MOD Self.spalten()) * (KARTE_B + KARTE_ABSTAND)
            DIM ky AS INTEGER : ky = KARTE_RAND + (i \ Self.spalten()) * (KARTE_H + KARTE_ABSTAND) - Self.rollen
            IF x >= kx AND x < kx + KARTE_B AND y >= ky AND y < ky + KARTE_H THEN RETURN i
        NEXT
        RETURN -1
    END FUNCTION

    SUB flaeche_Zeichnen()
        DIM x0 AS INTEGER : x0 = GUI_CANVAS_X(Self.flaeche)
        DIM y0 AS INTEGER : y0 = GUI_CANVAS_Y(Self.flaeche)
        DIM drueber AS INTEGER : drueber = -1
        IF GUI_HIT_TEST(MOUSEX(), MOUSEY()) = Self.flaeche THEN drueber = Self.karteBei(MOUSEX() - x0, MOUSEY() - y0)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(Self.orte) - 1
            DIM kx AS INTEGER : kx = x0 + KARTE_RAND + (i MOD Self.spalten()) * (KARTE_B + KARTE_ABSTAND)
            DIM ky AS INTEGER : ky = y0 + KARTE_RAND + (i \ Self.spalten()) * (KARTE_H + KARTE_ABSTAND) - Self.rollen
            Self.karte(Self.orte[i], kx, ky, i = drueber)
        NEXT
        TEXT_BOLD(FALSE)
    END SUB

    ' Eine Kachel: Glas in der Farbe des Orts, oben Sinnbild und Name, in der
    ' Mitte die Anzahl, unten was abgelaufen ist und was bald abläuft.
    SUB karte(o AS Ort, x AS INTEGER, y AS INTEGER, hell AS BOOLEAN)
        DIM grund AS INTEGER : grund = COLOR_LERP(&H23262C, o.farbe, IIF(hell, 0.38, 0.22))
        BOXROUND(x + 3, y + 4, x + KARTE_B + 3, y + KARTE_H + 4, 14, RGBA(0, 0, 0, 90))
        BOXROUND(x, y, x + KARTE_B, y + KARTE_H, 14, grund)
        ' Der Glanz oben: rund wie die Kachel, nach unten auslaufend.
        DIM glanz AS INTEGER : glanz = COLOR_LERP(grund, &HFFFFFF, IIF(hell, 0.16, 0.08))
        BOXROUND(x + 1, y + 1, x + KARTE_B - 1, y + 30, 13, glanz)
        GRADIENTV(x + 1, y + 16, x + KARTE_B - 1, y + 46, glanz, grund)
        RECTROUND(x, y, x + KARTE_B, y + KARTE_H, 14, IIF(hell, COLOR_LERP(o.farbe, &HFFFFFF, 0.35), o.farbe))
        TEXT_BOLD(FALSE)
        TEXT_SIZE(26)
        TEXT(x + 16, y + 14, o.sinnbild, &HFFFFFF)
        TEXT_BOLD(TRUE)
        TEXT_SIZE(17)
        TEXT(x + 56, y + 14, o.name, &HFFFFFF)
        TEXT_BOLD(FALSE)
        TEXT_SIZE(12)
        IF o.zone <> "" THEN TEXT(x + 56, y + 36, zoneText$(o.zone), COLOR_LERP(&HFFFFFF, grund, 0.4))
        LINE(x + 16, y + 56, x + KARTE_B - 16, y + 56, COLOR_LERP(o.farbe, grund, 0.4))
        TEXT_BOLD(TRUE)
        TEXT_SIZE(38)
        TEXT(x + 16, y + 66, STR$(o.anzahl), &HFFFFFF)
        DIM zb AS INTEGER : zb = TEXT_WIDTH(STR$(o.anzahl))
        TEXT_BOLD(FALSE)
        TEXT_SIZE(14)
        TEXT(x + 24 + zb, y + 86, "Artikel", COLOR_LERP(&HFFFFFF, grund, 0.25))
        DIM wy AS INTEGER : wy = y + 124
        IF o.abgelaufen > 0 THEN
            TEXT(x + 16, wy, "✖ " + STR$(o.abgelaufen) + " abgelaufen", &HFF8A80)
            wy = wy + 22
        END IF
        IF o.bald > 0 THEN
            TEXT(x + 16, wy, "⚠ " + IIF(o.bald = 1, "1 Lebensmittel läuft bald ab", STR$(o.bald) + " Lebensmittel laufen bald ab"), &HFFD180)
        ELSEIF o.abgelaufen = 0 THEN
            TEXT(x + 16, wy, IIF(o.anzahl = 0, "leer", "✔ alles frisch"), COLOR_LERP(&HFFFFFF, grund, 0.35))
        END IF
    END SUB

    SUB flaeche_Maus()
        DIM i AS INTEGER : i = Self.karteBei(MOUSEX() - GUI_CANVAS_X(Self.flaeche), MOUSEY() - GUI_CANVAS_Y(Self.flaeche))
        IF i < 0 THEN RETURN
        Self.gewaehlterOrt = Self.orte[i].name
        Self.Ausloesen("Details")
    END SUB

    SUB flaeche_Rad(schritte AS FLOAT)
        Self.rollen = MAX(0, MIN(Self.rollenMax(), Self.rollen - INT(schritte * 60)))
    END SUB

    SUB Groesse()
        Self.rollen = MIN(Self.rollen, Self.rollenMax())
    END SUB
END CLASS

CONST KARTE_B = 260
CONST KARTE_H = 180
CONST KARTE_ABSTAND = 15
CONST KARTE_RAND = 20
