' Drachenhauch Studio: Berichte, Stufe 1 -- auslegen und drucken
' (studio/berichte_laufzeit.dh, studio/berichte.dh, studio/laufzeit.dh,
' docs/entwurf-berichte.md). Ein Bericht (Element "bericht", Datei
' .dhreport) hat Baender mit Gruppen und Summen, eine Quelle mit :parametern
' und wird im Programm zu Pdf/Drucken/Vorschau; im Studio zeigt ihn ein
' Reiter, [Vorschau …] setzt ihn mit den Entwicklungsdaten.
' Die PDFs liest _hilfen/pdftext.dh.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== die auslegung setzt baender, gruppen, summen und seiten
' 70 Positionen in zwei Rechnungen (39 und 31), je Detail 6 mm: zwei Seiten.
' Der Seitenkopf steht auf beiden, der Gruppenkopf nennt den Kunden ueber den
' Verweis, die Gruppenfuesse die Zwischensummen, der Berichtsfuss Summe und
' Anzahl, "Seite n von m" kennt m. Ein fehlender Parameter ist ein Fehler.
IMPORT "kern.dh"
projOrdner = CWD$() + "/proj"
DIM e AS Element : e = elementNeu("datenbank", "Daten")
e.schema = READLINES("proj/Daten.dhdb")[0]
DIM b AS Element : b = elementNeu("bericht", "Liste")
b.schema = READLINES("proj/Liste.dhreport")[0]
PRINT "parameter "; JOIN$(berichtParameter(b), ",")
PRINT "db "; berichtDb$(b)
DIM sql AS STRING : sql = berichtSql$(b)
PRINT "verbund "; INSTR(sql, "LEFT JOIN " + CHR$(34) + "kunden" + CHR$(34)) >= 0; " ordnung "; INSTR(sql, "ORDER BY " + CHR$(34) + "rechnung" + CHR$(34) + ", " + CHR$(34) + "id" + CHR$(34)) >= 0
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DIM p AS PDF : p = studioBerichtPdf(berichtNeu$("Leer"), db, "", {})
PRINT "ohne quelle "; PDF_PAGE_COUNT(p)
p = studioBerichtPdf(b.schema, db, sql, {"ab": 1})
PRINT "seiten "; PDF_PAGE_COUNT(p)
PDF_SAVE(p, "b.pdf")
DIM s AS ARRAY OF STRING : s = pdfSeiten("b.pdf")
DIM k AS INTEGER
FOR k = 0 TO LEN(s) - 1
    DIM t AS STRING : t = s[k]
    PRINT "seite "; k + 1; ": kopf "; INSTR(t, "Artikel" + CHR$(10) + "Betrag") >= 0; " fuss "; INSTR(t, "Seite " + STR$(k + 1) + " von 2") >= 0
NEXT
DIM alles AS STRING : alles = JOIN$(s, CHR$(10))
PRINT "kunden "; INSTR(alles, "Anna Berger") >= 0; " "; INSTR(alles, "Bert Koch") >= 0
PRINT "summen "; INSTR(alles, "975,00") >= 0; " "; INSTR(alles, "2.131,25") >= 0; " "; INSTR(alles, "3.106,25") >= 0; " anzahl "; INSTR(alles, CHR$(10) + "70" + CHR$(10)) >= 0
PRINT "titel nur vorn "; INSTR(s[0], "Positionen") >= 0; " "; INSTR(s[1], "Positionen") < 0
p = studioBerichtPdf(b.schema, db, sql, {"ab": 2})
PRINT "nur rechnung 2: "; PDF_PAGE_COUNT(p)
PDF_SAVE(p, "c.pdf")
alles = JOIN$(pdfSeiten("c.pdf"), CHR$(10))
PRINT "  "; INSTR(alles, "975,00") < 0; " "; INSTR(alles, "2.131,25") >= 0
TRY
    p = studioBerichtPdf(b.schema, db, sql, {})
CATCH fehler
    PRINT fehler
END TRY
PRINT "text "; studioBParameter$("a = :x AND b = ':x' AND c = :y", {"x": "O'Neil", "Y": 2.5})
--- vorher
IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT)")
DB_EXEC(db, "CREATE TABLE pos (id INTEGER PRIMARY KEY, rechnung INTEGER, kunde INTEGER, text TEXT, betrag INTEGER)")
DB_EXEC(db, "INSERT INTO kunden (name) VALUES ('Anna Berger'), ('Bert Koch')")
DIM i AS INTEGER
FOR i = 1 TO 70
    DB_EXEC(db, "INSERT INTO pos (rechnung, kunde, text, betrag) VALUES (?, ?, ?, ?)", 1 + i \ 40, 1 + i \ 40, "Artikel " + STR$(i), i * 125)
NEXT
DB_CLOSE(db)
