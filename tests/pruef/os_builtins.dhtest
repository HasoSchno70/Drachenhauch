' Aus test_os_builtins.py uebertragen (23 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== argc ohne argumente ist null
PRINT ARGC()
--- erwartet
0

=== setenv dann getenv
SETENV("DH_TESTVAR", "hallo")
PRINT GETENV$("DH_TESTVAR")
--- erwartet
hallo

=== getenv unbekannt ist leer und nimmt vorgabe
PRINT "[" + GETENV$("DH_GIBTESGANZSICHERNICHT") + "]"
PRINT GETENV$("DH_GIBTESGANZSICHERNICHT", "vorgabe")
--- erwartet
[]
vorgabe

=== setenv lehnt ungueltige namen ab[""]
SETENV("", "x")
--- fehler
SETENV: ungueltiger Name '' (leer, '=' oder Null-Byte)

=== setenv lehnt ungueltige namen ab["MIT=GLEICH"]
SETENV("MIT=GLEICH", "x")
--- fehler
SETENV: ungueltiger Name 'MIT=GLEICH' (leer, '=' oder Null-Byte)

=== chdir wirkt auf folgende dateizugriffe
PRINT FILEEXISTS("beleg.txt")
CHDIR("unter")
PRINT FILEEXISTS("beleg.txt")
PRINT READALL$(OPENFILE("beleg.txt", "r"))
--- datei unter/beleg.txt
gefunden
--- erwartet
FALSE
TRUE
gefunden

=== chdir auf nichtexistierendes wirft
CHDIR("gibt_es_nicht_xyz_123")
--- fehler
CHDIR:
(gibt_es_nicht_xyz_123)

=== exit ausserhalb von 0 bis 255 wirft
EXIT(256)
--- fehler
EXIT: Rueckgabewert 256 liegt ausserhalb 0..255

=== shell liefert den rueckgabewert
PRINT SHELL("cmd", "/c", "exit 7")
--- system windows
--- erwartet
7

=== shell out sammelt die ausgabe ein
PRINT TRIM$(SHELL_OUT$("cmd", "/c", "echo hallo"))
--- system windows
--- erwartet
hallo

=== shell auf unbekanntes programm wirft
PRINT SHELL("gibt_es_ganz_sicher_nicht_xyz123")
--- fehler
SHELL: 'gibt_es_ganz_sicher_nicht_xyz123' laesst sich nicht starten

=== shell sieht was setenv gesetzt hat
' SETENV wirkt auf diesen Prozess UND seine Kinder -- das ist der Weg,
SETENV("DH_FUER_KIND", "weitergereicht")
PRINT TRIM$(SHELL_OUT$("cmd", "/c", "echo %DH_FUER_KIND%"))
--- system windows
--- erwartet
weitergereicht

=== argumente hinter doppelstrich
DIM i AS INTEGER
PRINT ARGC()
FOR i = 0 TO ARGC() - 1
    PRINT ARG$(i)
NEXT
--- argumente
eins
zwei drei
--- erwartet
2
eins
zwei drei

=== arg ausserhalb liefert leerstring statt fehler
PRINT "[" + ARG$(5) + "]"
PRINT "[" + ARG$(-1) + "]"
--- erwartet
[]
[]

=== exit setzt den rueckgabewert
PRINT "vorher"
EXIT(3)
PRINT "nachher"
--- rueckgabe 3
--- erwartet
vorher

=== exit ohne argument ist null
PRINT "fertig"
EXIT()
--- erwartet
fertig

=== exit meldet keinen laufzeitfehler
EXIT(2)
' EXIT laeuft ueber denselben Kanal wie ein Fehler -- der Nutzer darf davon
--- rueckgabe 2
--- erwartet

=== try catch faengt exit nicht
TRY
    EXIT(4)
CATCH e
    PRINT "gefangen"
END TRY
PRINT "danach"
--- rueckgabe 4
--- erwartet

=== throw exit sentinel bleibt ein normaler fehler
TRY
    THROW "__EXIT__"
CATCH e
    PRINT "gefangen: " + e
END TRY
' Der Signalkanal ist das Flag, nicht der Text -- ein Programm darf sich
--- erwartet
gefangen: __EXIT__

=== exit in einer funktion beendet das ganze programm
SUB abbrechen()
    EXIT(5)
END SUB
PRINT "start"
abbrechen()
PRINT "nie"
--- rueckgabe 5
--- erwartet
start

=== eprint geht nach stderr nicht nach stdout
PRINT "nutzdaten"
EPRINT("meldung")
--- stderr
meldung
--- erwartet
nutzdaten

=== eprint stringifiziert wie print
EPRINT(42)
EPRINT(TRUE)
EPRINT(1.5)
--- stderr
42
TRUE
1.5
--- erwartet

=== shell out nimmt stderr nicht in die nutzdaten
PRINT "[" + TRIM$(SHELL_OUT$("cmd", "/c", "echo fehler 1>&2")) + "]"
--- system windows
--- stderr
fehler 
--- erwartet
[]

