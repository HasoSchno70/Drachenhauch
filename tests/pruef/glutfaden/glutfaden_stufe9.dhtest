=== tauschen und konvertieren sind ein schritt, rueckgaengig stellt alles her
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("planprobe.pxs")
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM vorher AS STRING : vorher = JSON_STRINGIFY(kern.musterNachJson(m))
PRINT "gleiche farbe: "; kern.farbenTauschen(m, v, 2, 2); " | ausserhalb: "; kern.farbenTauschen(m, v, 2, 99); " | schritte "; v.stand()
PRINT "getauscht: "; kern.farbenTauschen(m, v, 1, 3); " | schritte "; v.stand(); " "; v.textZurueck$()
DIM ok AS BOOLEAN : ok = v.zurueckNehmen(m)
PRINT "rueckgaengig wie vorher: "; JSON_STRINGIFY(kern.musterNachJson(m)) = vorher
ok = v.wiederholen(m)
PRINT "wiederholt: "; m.farben[1].stichzahl; " "; m.farben[3].stichzahl
ok = v.zurueckNehmen(m)
DIM pal AS kern.Palette : pal = kern.paletteLaden(ARG$(0) + "/daten/paletten/Anchor_Stick_Farben.json")
DIM ab AS ARRAY OF FLOAT
DIM ziele AS ARRAY OF INTEGER : ziele = kern.umwandlungRechnen(m, pal, ab)
PRINT "konvertiert: "; kern.paletteUmwandeln(m, v, pal, ziele); " | "; m.farben[2].garn.hersteller; " "; m.farben[2].garn.nummer; " | symbol "; m.farben[2].symbol; " | perle "; m.farben[4].istPerle; " | ausgelassen "; m.farben[7].auslassen; " | "; v.textZurueck$()
ok = v.zurueckNehmen(m)
PRINT "rueckgaengig wie vorher: "; JSON_STRINGIFY(kern.musterNachJson(m)) = vorher
ziele[0] = -1
PRINT "ein ziel fehlt: "; kern.paletteUmwandeln(m, v, pal, ziele); " | "; m.farben[0].garn.hersteller
DIM leer AS kern.Palette : leer = NEW kern.Palette()
ziele = kern.umwandlungRechnen(m, leer, ab)
PRINT "leere palette: "; ziele[0]; " "; ab[0]
