' Aus test_gui_tastatur.py uebertragen (21 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== tab springt auf den knopf leertaste loest aus
' Der Kern: ohne einen einzigen Mausklick einen Knopf auslösen.
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "ok", 10, 10, 80, 24)
DIM traf AS INTEGER

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
    IF GUI_CLICKED(b) THEN traf = traf + 1
NEXT

PRINT traf
--- datei ev.txt
# Test-Aufnahme
c 4
e 1 2 258 0 0 0 // Event: test
e 2 1 258 0 0 0 // Event: test
e 4 2 32 0 0 0 // Event: test
e 5 1 32 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
1

=== tab ueberspringt deko
' Label, Panel und Trennlinie fangen keinen Fokus.
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM l AS GUI_WIDGET
l = GUI_LABEL(w, "Name", 10, 10)
DIM p AS GUI_WIDGET
p = GUI_PANEL(w, 10, 30, 100, 40)
DIM s AS GUI_WIDGET
s = GUI_SEPARATOR(w, 10, 75, 100)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "ok", 10, 90, 80, 24)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

PRINT IIF(GUI_FOCUSED() = b, "knopf", "falsch")
--- datei ev.txt
# Test-Aufnahme
c 2
e 1 2 258 0 0 0 // Event: test
e 2 1 258 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
knopf

=== tab reihenfolge und shift tab rueckwaerts
' Vorwärts in Anlege-Reihenfolge, Umschalt+Tab zurück.
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM a AS GUI_WIDGET
a = GUI_BUTTON(w, "a", 10, 10, 60, 24)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "b", 10, 40, 60, 24)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

' 1. Tab -> a, 2. Tab -> b, Umschalt+Tab -> zurueck auf a
PRINT IIF(GUI_FOCUSED() = a, "a", IIF(GUI_FOCUSED() = b, "b", "keins"))
--- datei ev.txt
# Test-Aufnahme
c 8
e 1 2 258 0 0 0 // Event: test
e 2 1 258 0 0 0 // Event: test
e 3 2 258 0 0 0 // Event: test
e 4 1 258 0 0 0 // Event: test
e 5 2 340 0 0 0 // Event: test
e 5 2 258 0 0 0 // Event: test
e 6 1 258 0 0 0 // Event: test
e 6 1 340 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
a

