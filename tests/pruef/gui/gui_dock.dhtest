--- erwartet
links 340 8 22 324 173

=== das kreuz blendet die leiste aus und meldet sie
IMPORT "hilfe.dh"
GUI_DOCK_CLOSABLE(w, "probleme", TRUE)
DIM bild AS INTEGER
DIM zu AS STRING
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN daVerteilen()
    IF GUI_DOCK_CLOSED$(w) <> "" THEN zu = zu + GUI_DOCK_CLOSED$(w) + ";"
    bild = bild + 1
    IF bild = 3 THEN
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM b AS INTEGER
        DIM h AS INTEGER
        (x, y, b, h) = GUI_DOCK_TAB_RECT(w, "probleme")
        dmKlick(x + b - 10, y + h \ 2)
        dmSpielen()
    END IF
    IF bild = 30 THEN
        PRINT "gemeldet "; zu
        PRINT "jetzt "; GUI_DOCK_WHERE$(w, "probleme"); " "; GUI_DOCK_SHOWN(w, "probleme")
        PRINT "ausgabe nimmt den platz "; daRect$("ausgabe")
        GUI_DOCK_SHOW(w, "probleme", TRUE)
        PRINT "wieder "; GUI_DOCK_WHERE$(w, "probleme"); " "; daRect$("probleme")
        EXIT(0)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei hilfe.dh
IMPORT "{sammlung}/_hilfen/dockmaus.dh"
IMPORT "{sammlung}/_hilfen/dockaufbau.dh"
--- umgebung
DHRT_FRAMES=60
--- erwartet
gemeldet probleme;
jetzt zu FALSE
ausgabe nimmt den platz 8 422 784 178
wieder unten 404 422 388 178

=== der stand geht hin und zurueck
IMPORT "hilfe.dh"
GUI_DOCK_MOVE(w, "probleme", "rechts")
GUI_DOCK_FLOAT(w, "gliederung", 300, 120, 260, 180)
GUI_DOCK_MOVE(w, "terminal", "links", "projekt")
GUI_DOCK_SIZE(w, "rechts", 200)
GUI_DOCK_SHOW(w, "terminal", FALSE)
DIM stand AS STRING : stand = GUI_DOCK_STATE$(w)
DIM vorher AS STRING
DIM n AS STRING
FOR EACH n IN daNamen
    vorher = vorher + n + "=" + GUI_DOCK_WHERE$(w, n) + ":" + daRect$(n) + " "
NEXT
' alles zurueck in die Vorgabe ...
GUI_DOCK_MOVE(w, "probleme", "unten")
GUI_DOCK_MOVE(w, "gliederung", "links")
GUI_DOCK_MOVE(w, "terminal", "unten", "ausgabe")
' ... und den Stand wieder setzen
GUI_DOCK_SET_STATE(w, stand)
DIM nachher AS STRING
FOR EACH n IN daNamen
    nachher = nachher + n + "=" + GUI_DOCK_WHERE$(w, n) + ":" + daRect$(n) + " "
NEXT
PRINT "gleich "; vorher = nachher
PRINT RTRIM$(vorher)
' Ein zweites Dock, das die Leisten noch nicht kennt: eine spaeter
' angemeldete findet den Platz, den der Stand ihr gab.
DIM w2 AS GUI_WINDOW : w2 = GUI_WINDOW("zwei", 0, 0, 800, 600)
GUI_DOCK(w2, 0, 0, 800, 600)
GUI_DOCK_SET_STATE(w2, stand)
GUI_DOCK_PANEL(w2, "probleme", "Probleme", "links")
PRINT "spaeter angemeldet "; GUI_DOCK_WHERE$(w2, "probleme")
--- datei hilfe.dh
IMPORT "{sammlung}/_hilfen/dockmaus.dh"
IMPORT "{sammlung}/_hilfen/dockaufbau.dh"
--- umgebung
DHRT_FRAMES=2
--- erwartet
gleich TRUE
projekt=links:8 22 224 376 gliederung=schwebend:301 142 258 157 ausgabe=unten:8 422 784 178 terminal=zu:0 0 0 0 probleme=rechts:608 22 184 376
spaeter angemeldet rechts

=== ein fenster als leiste liegt auf ihr und ueber dem gastfenster
IMPORT "hilfe.dh"
DIM w2 AS GUI_WINDOW : w2 = GUI_WINDOW("plugin", 0, 0, 200, 100)
DIM knopf AS GUI_WIDGET : knopf = GUI_BUTTON(w2, "im plugin", 5, 5, 100, 30)
GUI_DOCK_PANEL(w, "plugin", "Plugin", "rechts")
GUI_DOCK_WINDOW(w, "plugin", w2)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN daVerteilen()
    bild = bild + 1
    IF bild = 3 THEN
        PRINT "lage "; GUI_WINDOW_GET_X(w2); " "; GUI_WINDOW_GET_Y(w2); " "; GUI_WINDOW_GET_W(w2); " "; GUI_WINDOW_GET_H(w2); " "; daRect$("plugin")
        PRINT "knopf getroffen "; GUI_HIT_TEST(575, 32) = knopf
        ' ein Klick ins Gastfenster holt es nach vorn -- die Leiste bleibt darueber
        dmKlick(400, 200)
        dmSpielen()
    END IF
    IF bild = 20 THEN
        PRINT "nach dem klick oben "; GUI_WINDOW_AT(600, 100) = w2
        GUI_DOCK_TAB(w, "zweit", "Zweit", "plugin")
        GUI_DOCK_ACTIVATE(w, "zweit")
    END IF
    IF bild = 22 THEN
        PRINT "hinterer reiter "; GUI_WINDOW_SHOWN(w2)
        EXIT(0)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei hilfe.dh
IMPORT "{sammlung}/_hilfen/dockmaus.dh"
IMPORT "{sammlung}/_hilfen/dockaufbau.dh"
--- umgebung
DHRT_FRAMES=60
--- erwartet
lage 568 22 224 376 568 22 224 376
knopf getroffen TRUE
nach dem klick oben TRUE
hinterer reiter FALSE

=== eine schwebende leiste liegt ueber einem angedockten fenster
' Die Leiste gehoert dem Gastfenster, das angedockte Fenster steht in der
' Reihenfolge darueber: bis 2026.35 zeichnete es sich ueber die schwebende
' Leiste und nahm ihr die Klicks. Jetzt kommt die obere Schicht des Docks
' nach den angedockten Fenstern, und die Treffertests ueberspringen sie dort.
IMPORT "hilfe.dh"
DIM w2 AS GUI_WINDOW : w2 = GUI_WINDOW("plugin", 0, 0, 200, 100)
DIM gruen AS GUI_WIDGET : gruen = GUI_BUTTON(w2, "", 0, 0, 224, 376)
GUI_SET_COLOR(gruen, "bg", &H30C030)
GUI_DOCK_PANEL(w, "plugin", "Plugin", "rechts")
GUI_DOCK_WINDOW(w, "plugin", w2)
GUI_DOCK_FLOAT(w, "ausgabe", 540, 100, 200, 140)
daVerteilen()
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN daVerteilen()
    bild = bild + 1
    IF bild = 3 THEN
        PRINT "unter der leiste "; GUI_HIT_TEST(640, 180) = daListe[2]
        PRINT "fenster dort "; GUI_WINDOW_AT(640, 180) = w
        PRINT "daneben das plugin "; GUI_HIT_TEST(640, 300) = gruen
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei hilfe.dh
IMPORT "{sammlung}/_hilfen/dockmaus.dh"
IMPORT "{sammlung}/_hilfen/dockaufbau.dh"
--- umgebung
DHRT_FRAMES=4
--- erwartet
unter der leiste TRUE
fenster dort TRUE
daneben das plugin TRUE
--- bild
640 180 nicht #30C030 +-60
640 300 #30C030 +-60

=== ohne schwebende leiste zeigt dieselbe stelle das angedockte fenster
' Gegenprobe zum Fall davor: ohne GUI_DOCK_FLOAT ist die Stelle gruen und
' gehoert dem Plugin.
IMPORT "hilfe.dh"
DIM w2 AS GUI_WINDOW : w2 = GUI_WINDOW("plugin", 0, 0, 200, 100)
DIM gruen AS GUI_WIDGET : gruen = GUI_BUTTON(w2, "", 0, 0, 224, 376)
GUI_SET_COLOR(gruen, "bg", &H30C030)
GUI_DOCK_PANEL(w, "plugin", "Plugin", "rechts")
GUI_DOCK_WINDOW(w, "plugin", w2)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN daVerteilen()
    bild = bild + 1
    IF bild = 3 THEN
        PRINT "dort das plugin "; GUI_HIT_TEST(640, 180) = gruen
        PRINT "fenster dort "; GUI_WINDOW_AT(640, 180) = w2
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
