' Pakete fuer macOS und Linux -- eingebunden von bauen.dh.
'
' Linux: ein Ordner Drachenhauch-IDE-<fassung>/ mit dhrt, ide/, docs/,
'   examples/, dem Starter `drachenhauch` und install.sh (fuer den Nutzer,
'   ohne root), gepackt als .tar.gz.
' macOS: Drachenhauch.app (dhrt und der Starter in Contents/MacOS, alles
'   andere in Contents/Resources) plus LIESMICH und ein Verweis auf den
'   Programme-Ordner, gepackt als .dmg ueber hdiutil.
'
' Dieselbe Aufteilung wie der Windows-Installer (Drachenhauch-IDE.iss): die
' IDE als Quelltext, das Handbuch, die Beispiele. Die Beispiele kopiert der
' Starter beim Start in den Nutzerordner -- siehe installer/posix/drachenhauch.
'
' Gebaut wird auf dem System, fuer das das Paket ist (tar behaelt die
' Ausfuehrungsrechte, hdiutil gibt es nur auf dem Mac). Der Ordner allein
' entsteht ueberall -- `--ohne-archiv`; so prueft ihn die Sammlung
' tests/pruef/werkzeug_paket.dhtest auch unter Windows.


FUNCTION aufWindows() AS BOOLEAN
    RETURN GETENV$("OS") = "Windows_NT"
END FUNCTION

' Ein kurzer Befehl, dessen Ausgabe gebraucht wird (uname). Leer, wenn es
' ihn nicht gibt.
FUNCTION ausgabe$(prog AS STRING, arg AS STRING) AS STRING
    DIM p AS INTEGER
    TRY
        p = PROCESS_START(prog, arg)
    CATCH e
        RETURN ""
    END TRY
    DIM t AS STRING : t = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM s AS STRING : s = PROCESS_READ$(p)
        IF s <> "" THEN
            t = t + s
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    PROCESS_CLOSE(p)
    RETURN TRIM$(REPLACE$(REPLACE$(t, CHR$(13), ""), CHR$(10), ""))
END FUNCTION

' Einen Befehl laufen lassen; ein Fehlschlag bricht das Paket ab.
SUB mussLaufen(p AS INTEGER, was AS STRING)
    IF lauf(p, TRUE) <> 0 THEN
        PRINT was; " ist fehlgeschlagen."
        EXIT(1)
    END IF
END SUB

' Eine Vorlage als Text uebernehmen: ohne Wagenruecklauf (ein Shell-Skript
' mit CRLF laeuft nicht -- "/bin/sh^M: bad interpreter") und mit der Fassung.
SUB vorlageKopieren(von AS STRING, nach AS STRING, fassung AS STRING)
    DIM t AS STRING : t = BUFFER_TO_STRING$(READALL_BYTES(von))
    t = REPLACE$(t, CHR$(13), "")
    t = REPLACE$(t, "@FASSUNG@", fassung)
    WRITEALL_BYTES(nach, BUFFER_FROM_STRING(t))
END SUB

SUB dateiKopieren(von AS STRING, nach AS STRING)
    IF NOT DIREXISTS(DIRNAME(nach)) THEN MKDIR(DIRNAME(nach))
    COPYFILE(von, nach)
END SUB

' Einen Ordner kopieren. `tief` = mit Unterordnern; ohne nur die oberste
' Ebene (ide/ und docs/ -- wie im Windows-Installer). Liefert die Zahl.
' Uebergangen werden die Temp-Dateien der IDE (_dhtmp_*, siehe
' editor_qt/tempdateien.py) und __pycache__.
FUNCTION ordnerKopieren(von AS STRING, nach AS STRING, muster AS STRING, tief AS BOOLEAN) AS INTEGER
    DIM l AS ARRAY OF STRING : l = DIRLIST_REC(von, muster)
    DIM n AS INTEGER : n = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(l) - 1
        DIM rel AS STRING : rel = REPLACE$(l[i], CHR$(92), "/")
        IF NOT tief AND INSTR(rel, "/") >= 0 THEN CONTINUE
        IF LEFT$(BASENAME(rel), 7) = "_dhtmp_" THEN CONTINUE
        IF INSTR(rel, "__pycache__") >= 0 THEN CONTINUE
        dateiKopieren(PATHJOIN(von, rel), PATHJOIN(nach, rel))
        n = n + 1
    NEXT
    RETURN n
END FUNCTION

' Was in jedes Paket gehoert. `bin` bekommt dhrt, `res` den Rest (unter
' Linux derselbe Ordner, im .app-Bundle zwei verschiedene).
SUB inhaltKopieren(wurzel AS STRING, laufzeit AS STRING, bin AS STRING, res AS STRING)
    dateiKopieren(laufzeit, PATHJOIN(bin, "dhrt"))
    PRINT "  ide/      "; ordnerKopieren(PATHJOIN(wurzel, "ide"), PATHJOIN(res, "ide"), "*.dh", FALSE); " Dateien"
    PRINT "  docs/     "; ordnerKopieren(PATHJOIN(wurzel, "docs"), PATHJOIN(res, "docs"), "*.md", FALSE); " Dateien"
    PRINT "  examples/ "; ordnerKopieren(PATHJOIN(wurzel, "examples"), PATHJOIN(res, "examples"), "*", TRUE); " Dateien"
    ' Logo und Schriftzug -- die IDE sucht sie unter daten/bilder neben ide/.
    PRINT "  bilder/   "; ordnerKopieren(PATHJOIN(wurzel, "daten/bilder"), PATHJOIN(res, "daten/bilder"), "*.png", FALSE); " Dateien"
    ' Der Vorspann beim Start der IDE.
    IF FILEEXISTS(PATHJOIN(wurzel, "daten/video/vorspann.mp4")) THEN
        PRINT "  video/    "; ordnerKopieren(PATHJOIN(wurzel, "daten/video"), PATHJOIN(res, "daten/video"), "*.mp4", FALSE); " Dateien"
    END IF
    DIM texte AS ARRAY OF STRING : texte = ["EULA.txt", "THIRD-PARTY-NOTICES-IDE.txt"]
    DIM i AS INTEGER
    FOR i = 0 TO LEN(texte) - 1
        DIM q AS STRING : q = PATHJOIN(wurzel, "installer/" + texte[i])
        IF FILEEXISTS(q) THEN dateiKopieren(q, PATHJOIN(res, texte[i]))
    NEXT
END SUB

' --- Symbole ------------------------------------------------------------
' Fertig im Repo (installer/symbole/, erzeugt von installer/symbole.dh aus dem
' Logo): Bilder brauchen in der Laufzeit einen GL-Kontext, also ein
' (verstecktes) Fenster -- und das gibt es auf einem Bau-Rechner ohne
' Bildschirm nicht (Linux ohne DISPLAY, die macOS-Laeufer der CI ganz ohne
' passendes OpenGL). Hier wird nur kopiert.
SUB symbolKopieren(symbole AS STRING, name AS STRING, nach AS STRING)
    DIM q AS STRING : q = PATHJOIN(symbole, name)
    IF FILEEXISTS(q) THEN
        dateiKopieren(q, nach)
    ELSE
        PRINT "  (kein "; name; " unter "; symbole; " -- ohne Symbol; erzeugen mit installer/symbole.dh)"
    END IF
END SUB

SUB ausfuehrbar(pfade AS ARRAY OF STRING)
    IF aufWindows() THEN RETURN      ' dort gibt es keine Rechte-Bits
    DIM i AS INTEGER
    FOR i = 0 TO LEN(pfade) - 1
        mussLaufen(PROCESS_START("chmod", "755", pfade[i]), "chmod")
    NEXT
END SUB

' --- Linux --------------------------------------------------------------
SUB linuxPaket(wurzel AS STRING, laufzeit AS STRING, vorlagen AS STRING, ausgabe AS STRING, fassung AS STRING, arch AS STRING, symbole AS STRING, archiv AS BOOLEAN)
    DIM name AS STRING : name = "Drachenhauch-IDE-" + fassung + "-linux-" + arch
    DIM buehne AS STRING : buehne = PATHJOIN(ausgabe, "paket")
    IF DIREXISTS(buehne) THEN RMDIR(buehne, TRUE)
    DIM ziel AS STRING : ziel = PATHJOIN(buehne, name)
    MKDIR(ziel)
    PRINT "Linux-Paket in "; ziel
    inhaltKopieren(wurzel, laufzeit, ziel, ziel)
    vorlageKopieren(PATHJOIN(vorlagen, "drachenhauch"), PATHJOIN(ziel, "drachenhauch"), fassung)
    vorlageKopieren(PATHJOIN(vorlagen, "install.sh"), PATHJOIN(ziel, "install.sh"), fassung)
    symbolKopieren(symbole, "drachenhauch.png", PATHJOIN(ziel, "drachenhauch.png"))
    ausfuehrbar([PATHJOIN(ziel, "dhrt"), PATHJOIN(ziel, "drachenhauch"), PATHJOIN(ziel, "install.sh")])
    IF NOT archiv THEN
        PRINT "Fertig (ohne Archiv)."
        RETURN
    END IF
    DIM tgz AS STRING : tgz = PATHJOIN(ausgabe, name + ".tar.gz")
    IF FILEEXISTS(tgz) THEN DELETEFILE(tgz)
    mussLaufen(PROCESS_START("tar", "-czf", tgz, "-C", buehne, name), "tar")
    PRINT "FERTIG -> "; tgz; " ("; FILESIZE(tgz) \ 1048576; " MB)"
    PRINT "Installieren:  tar xzf "; BASENAME(tgz); " && ./"; name; "/install.sh"
END SUB

' --- macOS --------------------------------------------------------------
' Ein Befehl, dessen Ausgabe gebraucht wird UND der sichtbar bleiben soll
' (notarytool) -- Rueckgabe in `paketCode`.
DIM paketCode AS INTEGER : paketCode = 0
FUNCTION mitschreiben$(p AS INTEGER) AS STRING
    DIM t AS STRING : t = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF teil <> "" THEN
            leer = 0
            PRINT REPLACE$(teil, CHR$(13), "");
            t = t + teil
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(50)
    WEND
    paketCode = PROCESS_CODE(p)
    RETURN t
END FUNCTION

' Signieren und beglaubigen. Die Zugangsdaten kommen NUR aus der Umgebung,
' im Repo steht keins davon:
'   DH_MAC_SIGNATUR   die Identitaet im Schluesselbund, etwa
'                     "Developer ID Application: Name (TEAMID)"
'   DH_NOTAR_KEY      Pfad zur .p8 eines App-Store-Connect-API-Schluessels
'   DH_NOTAR_KEY_ID   seine Kennung
'   DH_NOTAR_ISSUER   die Aussteller-Kennung (Issuer ID)
' Ohne DH_MAC_SIGNATUR wird ad hoc signiert (wie bisher: heruntergeladen
' meldet macOS dann "nicht verifizierter Entwickler", ctrl-Klick -> Oeffnen
' reicht). Hardened Runtime gilt IMMER -- Apple verlangt sie fuer die
' Beglaubigung, und so zeigt schon der Lauf ohne Zugangsdaten, dass dhrt
' damit laeuft. Ohne DH_NOTAR_* wird nicht beglaubigt.
' Die App bekommt die Berechtigungen aus `rechte` (dhrt.entitlements): der
' Maschinencode macht Speicher ausfuehrbar, und das verbietet Hardened
' Runtime ohne sie -- die App stuerzte beim ersten uebersetzten Aufruf ab.
SUB macosSignieren(ziel AS STRING, ident AS STRING, istApp AS BOOLEAN, rechte AS STRING)
    IF ident = "" THEN
        IF istApp THEN mussLaufen(PROCESS_START("codesign", "--force", "--options", "runtime", "--entitlements", rechte, "--sign", "-", ziel), "codesign")
    ELSEIF istApp THEN
        mussLaufen(PROCESS_START("codesign", "--force", "--options", "runtime", "--entitlements", rechte, "--timestamp", "--sign", ident, ziel), "codesign")
    ELSE
        mussLaufen(PROCESS_START("codesign", "--force", "--timestamp", "--sign", ident, ziel), "codesign")
    END IF
END SUB

SUB macosBeglaubigen(dmg AS STRING, ident AS STRING)
    DIM key AS STRING : key = GETENV$("DH_NOTAR_KEY")
    DIM kid AS STRING : kid = GETENV$("DH_NOTAR_KEY_ID")
    DIM iss AS STRING : iss = GETENV$("DH_NOTAR_ISSUER")
    IF key = "" OR kid = "" OR iss = "" THEN
        PRINT "Nicht beglaubigt (DH_NOTAR_KEY/_KEY_ID/_ISSUER fehlen) -- beim ersten Start ctrl-Klick -> Oeffnen."
        RETURN
    END IF
    IF ident = "" THEN
        PRINT "Beglaubigen braucht eine Developer-ID-Signatur (DH_MAC_SIGNATUR) -- uebersprungen."
        RETURN
    END IF
    PRINT "Beglaubigen bei Apple (notarytool, wartet auf das Ergebnis) ..."
    DIM t AS STRING : t = mitschreiben$(PROCESS_START("xcrun", "notarytool", "submit", dmg, _
        "--key", key, "--key-id", kid, "--issuer", iss, "--wait"))
    IF INSTR(t, "status: Accepted") < 0 THEN
        ' Warum abgelehnt, steht im Protokoll des Auftrags -- ohne es
        ' saehe man nur "Invalid".
        DIM z AS ARRAY OF STRING : z = SPLIT$(REPLACE$(t, CHR$(13), ""), CHR$(10))
        DIM i AS INTEGER
        FOR i = 0 TO LEN(z) - 1
            IF LEFT$(TRIM$(z[i]), 4) = "id: " THEN
                DIM auftrag AS STRING
                auftrag = mitschreiben$(PROCESS_START("xcrun", "notarytool", "log", MID$(TRIM$(z[i]), 4), _
                    "--key", key, "--key-id", kid, "--issuer", iss))
                BREAK
            END IF
        NEXT
        PRINT "Die Beglaubigung ist nicht durchgegangen."
        EXIT(1)
    END IF
    ' Das Ticket ans Abbild heften: dann prueft macOS auch ohne Netz.
    mussLaufen(PROCESS_START("xcrun", "stapler", "staple", dmg), "stapler staple")
    mussLaufen(PROCESS_START("xcrun", "stapler", "validate", dmg), "stapler validate")
    PRINT "Beglaubigt und geheftet."
END SUB

SUB macosPaket(wurzel AS STRING, laufzeit AS STRING, vorlagen AS STRING, ausgabe AS STRING, fassung AS STRING, arch AS STRING, symbole AS STRING, archiv AS BOOLEAN)
    DIM buehne AS STRING : buehne = PATHJOIN(ausgabe, "paket/Drachenhauch")
    IF DIREXISTS(PATHJOIN(ausgabe, "paket")) THEN RMDIR(PATHJOIN(ausgabe, "paket"), TRUE)
    DIM app AS STRING : app = PATHJOIN(buehne, "Drachenhauch.app")
    DIM bin AS STRING : bin = PATHJOIN(app, "Contents/MacOS")
    DIM res AS STRING : res = PATHJOIN(app, "Contents/Resources")
    MKDIR(bin)
    MKDIR(res)
    PRINT "macOS-Paket in "; app
    ' dhrt IST das Hauptprogramm (CFBundleExecutable): ohne Argumente aus dem
    ' Bundle gestartet, kopiert es die Beispiele und startet die IDE
    ' (appstart.rs). Ein Shell-Starter an dieser Stelle liesse sich nicht mit
    ' Hardened Runtime signieren -- die Notarisierung verlangt sie.
    inhaltKopieren(wurzel, laufzeit, bin, res)
    vorlageKopieren(PATHJOIN(vorlagen, "Info.plist"), PATHJOIN(app, "Contents/Info.plist"), fassung)
    WRITEALL_BYTES(PATHJOIN(app, "Contents/PkgInfo"), BUFFER_FROM_STRING("APPL????"))
    vorlageKopieren(PATHJOIN(vorlagen, "LIESMICH-macos.txt"), PATHJOIN(buehne, "LIESMICH.txt"), fassung)
    symbolKopieren(symbole, "Drachenhauch.icns", PATHJOIN(res, "Drachenhauch.icns"))
    ausfuehrbar([PATHJOIN(bin, "dhrt")])
    IF NOT archiv THEN
        PRINT "Fertig (ohne Archiv)."
        RETURN
    END IF
    DIM ident AS STRING : ident = GETENV$("DH_MAC_SIGNATUR")
    IF ident = "" THEN
        PRINT "Signatur: ad hoc (DH_MAC_SIGNATUR fehlt)"
    ELSE
        PRINT "Signatur: "; ident
    END IF
    macosSignieren(app, ident, TRUE, PATHJOIN(vorlagen, "dhrt.entitlements"))
    ' Der Verweis macht aus dem geoeffneten Abbild ein "hierher ziehen".
    mussLaufen(PROCESS_START("ln", "-s", "/Applications", PATHJOIN(buehne, "Programme")), "ln")
    DIM dmg AS STRING : dmg = PATHJOIN(ausgabe, "Drachenhauch-IDE-" + fassung + "-macos-" + arch + ".dmg")
    IF FILEEXISTS(dmg) THEN DELETEFILE(dmg)
    mussLaufen(PROCESS_START("hdiutil", "create", "-volname", "Drachenhauch " + fassung, _
                             "-srcfolder", buehne, "-ov", "-format", "UDZO", dmg), "hdiutil")
    macosSignieren(dmg, ident, FALSE, "")
    macosBeglaubigen(dmg, ident)
    PRINT "FERTIG -> "; dmg; " ("; FILESIZE(dmg) \ 1048576; " MB)"
END SUB
