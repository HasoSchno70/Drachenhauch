' Aus test_funcref.py uebertragen (18 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== funcref basic (1)
FUNCTION square(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION

DIM f AS FUNCREF
f = square
PRINT f(5)
--- erwartet
25

=== funcref basic (2)
FUNCTION square(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION

DIM f AS FUNCREF
f = square
PRINT f(5)
--- erwartet
25

=== funcref reassign (1)
FUNCTION square(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION

FUNCTION cube(x AS INTEGER) AS INTEGER
    RETURN x * x * x
END FUNCTION

DIM f AS FUNCREF
f = square
PRINT f(4)
f = cube
PRINT f(3)
--- erwartet
16
27

=== funcref reassign (2)
FUNCTION square(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION

FUNCTION cube(x AS INTEGER) AS INTEGER
    RETURN x * x * x
END FUNCTION

DIM f AS FUNCREF
f = square
PRINT f(4)
f = cube
PRINT f(3)
--- erwartet
16
27

=== funcref passed as arg (1)
' FUNCREF als Parameter -- klassischer Higher-Order-Use-Case.
FUNCTION twice(f AS FUNCREF, x AS INTEGER) AS INTEGER
    RETURN f(f(x))
END FUNCTION

FUNCTION inc(x AS INTEGER) AS INTEGER
    RETURN x + 1
END FUNCTION

PRINT twice(inc, 5)
--- erwartet
7

=== funcref passed as arg (2)
' FUNCREF als Parameter -- klassischer Higher-Order-Use-Case.
FUNCTION twice(f AS FUNCREF, x AS INTEGER) AS INTEGER
    RETURN f(f(x))
END FUNCTION

FUNCTION inc(x AS INTEGER) AS INTEGER
    RETURN x + 1
END FUNCTION

PRINT twice(inc, 5)
--- erwartet
7

=== funcref print (1)
FUNCTION foo(x AS INTEGER) AS INTEGER
    RETURN x
END FUNCTION

DIM f AS FUNCREF
f = foo
PRINT f
--- erwartet
<FUNCREF foo>

=== funcref print (2)
FUNCTION foo(x AS INTEGER) AS INTEGER
    RETURN x
END FUNCTION

DIM f AS FUNCREF
f = foo
PRINT f
--- erwartet
<FUNCREF foo>

=== funcref no closure locals (1)
' Lambdas/FuncRefs sehen keine Locals des umgebenden Scopes -- sie
CONST FACTOR = 10

FUNCTION scale(x AS INTEGER) AS INTEGER
    RETURN x * FACTOR
END FUNCTION

DIM f AS FUNCREF
f = scale
PRINT f(7)
--- erwartet
70

=== funcref no closure locals (2)
