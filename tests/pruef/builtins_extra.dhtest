' Aus test_builtins_extra.py uebertragen (23 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== rgba packs alpha in high byte
PRINT RGBA(255, 128, 64, 200)
--- erwartet
3372187712

=== alpha extracts and defaults opaque
PRINT ALPHA(RGBA(10, 20, 30, 128))
PRINT ALPHA(RGB(10, 20, 30))
--- erwartet
128
255

=== rgb channels ignore alpha byte
PRINT RED(RGBA(200, 100, 50, 128))
PRINT GREEN(RGBA(200, 100, 50, 128))
PRINT BLUE(RGBA(200, 100, 50, 128))
--- erwartet
200
100
50

=== rgba alpha zero clamped to one
PRINT ALPHA(RGBA(1, 2, 3, 0))
--- erwartet
1

=== rgba out of range errors
PRINT RGBA(0, 0, 0, 300)
--- fehler
RGBA-Werte muessen 0..255 sein

=== rgb still 24bit
PRINT RGB(255, 128, 64)
--- erwartet
16744512

