' Barrierefreiheit (docs/entwurf-barrierefreiheit.md, Wege A und C).
'
' Der Kern ist der Pruefstein aus dem Entwurf: ein FREMDER Leser -- UI
' Automation aus PowerShell heraus (System.Windows.Automation, keine neue
' Abhaengigkeit) -- zaehlt die Bedienelemente eines laufenden dhrt-Fensters,
' liest ihre Namen, klickt den Knopf, setzt Text und Fokus. Vor dem Bau fand
' derselbe Leser NULL Nachkommen. Dazu Weg A: Menue per F10/Alt, setzbare
' Tab-Reihenfolge, Kontrast der Themen.
'
' Bis 2026-09-17 tests/test_gui_barrierefreiheit.py. Seriell, weil Tasten
' echt eingespeist werden und der Leser ein Fenster anfasst. Den Leser-Faellen
' gibt das Programm ein eigenes Fenster (ein zweiter dhrt als Kind, Titel mit
' einer Kennung) -- PowerShell sucht es ueber den Titel, weil PROCESS_START
' keine Prozessnummer nennt.
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

=== menue per f10 und alt
' F10, ab, Enter -> Oeffnen; Alt allein, Enter -> Neu; auf, ESC, Enter ->
' nichts. Eine Aufnahme-Beilage braucht die Leerzeile am Ende, sonst geht
' raylib die letzte Zeile verloren.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM iNeu AS INTEGER : iNeu = GUI_MENU_ITEM(m, "Neu")
DIM iAuf AS INTEGER : iAuf = GUI_MENU_ITEM(m, "Oeffnen")
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 10, 60, 200, 26)
GUI_FOCUS(tf)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(iNeu) THEN PRINT "klick Neu"
    IF GUI_CLICKED(iAuf) THEN PRINT "klick Oeffnen"
    CLS(0) : GUI_DRAW() : FLIP()
WEND
PRINT "ende"
--- datei ev.txt
# Test-Aufnahme
c 16
e 3 2 299 0 0 0 // Event: test
e 4 1 299 0 0 0 // Event: test
e 6 2 264 0 0 0 // Event: test
e 7 1 264 0 0 0 // Event: test
