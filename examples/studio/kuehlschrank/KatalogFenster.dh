' Die Rezeptsuche -- wie RecipeSearchDialog der Python-App, hier zuerst im
' Katalog (29 deutsche Rezepte, ohne Internet): Suchen, Ergebnis wählen,
' Details sehen, importieren. Die Suche im Internet (Spoonacular, mit
' Schlüssel) kommt mit dem Scannen in Stufe 6.
CLASS KatalogFenster EXTENDS KatalogFenster_Basis
    DIM treffer AS ARRAY OF Rezept
    DIM importiert AS INTEGER

    SUB Geoeffnet()
        GUI_SET_TEXT(Self.anzahl, "🇩🇪 " + STR$(LEN(katalog())) + " Rezepte im Katalog")
        Self.treffer = []
        GUI_SET_ENABLED(Self.knopfImport, FALSE)
    END SUB

    SUB knopfSuchen_Klick()
        Self.treffer = katalogSuchen(GUI_TEXT(Self.sucheFeld))
        GUI_TABLE_CLEAR(Self.tabelle)
        DIM x AS Rezept
        FOR EACH x IN Self.treffer
            GUI_TABLE_ADD_ROW(Self.tabelle, [x.name, minutenText$(x.gesamt()), STR$(x.portionen), x.kategorie])
        NEXT
        GUI_SET_TEXT(Self.ergebnis, IIF(LEN(Self.treffer) = 0, "Nichts gefunden -- ein anderes Wort?", "📋 " + STR$(LEN(Self.treffer)) + " Treffer"))
        GUI_SET_TEXT(Self.details, "")
        GUI_SET_ENABLED(Self.knopfImport, FALSE)
        IF LEN(Self.treffer) > 0 THEN
            GUI_TABLE_SET_SELECTED(Self.tabelle, 0)
            Self.tabelle_Geaendert()
        END IF
    END SUB

    SUB sucheFeld_Enter()
        Self.knopfSuchen_Klick()
    END SUB

    FUNCTION gewaehlt() AS Rezept
        DIM z AS INTEGER : z = GUI_TABLE_SELECTED(Self.tabelle)
        IF z < 0 OR z >= LEN(Self.treffer) THEN RETURN NIL
        RETURN Self.treffer[z]
    END FUNCTION

    SUB tabelle_Geaendert()
        DIM x AS Rezept : x = Self.gewaehlt()
        IF x IS NIL THEN RETURN
        DIM t AS STRING : t = x.name + CHR$(10) + x.beschreibung + CHR$(10) + CHR$(10) + "🍽 " + STR$(x.portionen) + " Portionen, ⏱ " + STR$(x.vorb) + " + " + STR$(x.koch) + " min" + CHR$(10) + CHR$(10) + "Zutaten:" + CHR$(10)
        DIM z AS Zutat
        FOR EACH z IN x.zutaten
            t = t + "  • " + z.mengeText$() + " " + z.name + CHR$(10)
        NEXT
        GUI_SET_TEXT(Self.details, t + CHR$(10) + "Zubereitung:" + CHR$(10) + x.anleitung)
        GUI_SET_ENABLED(Self.knopfImport, TRUE)
    END SUB

    ' Wie import_web_recipe -- mit der Beschreibung (die Python-App liess sie
    ' beim Import fallen).
    SUB knopfImport_Klick()
        DIM x AS Rezept : x = Self.gewaehlt()
        IF x IS NIL THEN RETURN
        rezeptAnlegen(x)
        Self.importiert = Self.importiert + 1
        GUI_TOAST(Self.studioWin, "„" + x.name + "“ wurde importiert!", "erfolg")
    END SUB

    SUB knopfSchliessen_Klick()
        Self.Zumachen()
    END SUB
END CLASS
