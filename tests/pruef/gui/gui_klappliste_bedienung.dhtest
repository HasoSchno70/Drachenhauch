=== tippen waehlt bei geschlossener liste
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 10, 10, 190, 28, ["Apfel", "Birne", "Kirsche"])
GUI_FOCUS(dd)
DIM zuletzt AS STRING : zuletzt = ""
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DROPDOWN_TEXT(dd) <> zuletzt THEN zuletzt = GUI_DROPDOWN_TEXT(dd) : PRINT zuletzt
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
