=== rahmen: falsche werte sind ein fehler, die vorlagen nach stoff
IMPORT "helfer.dh"
DIM w AS ARRAY OF INTEGER : w = [0, 10, 0, 10, 10, -1, 10, 20, 10, 20, 10, 20]
DIM i AS INTEGER
FOR i = 0 TO 3
    TRY
        DIM r AS INTEGER, s AS INTEGER
        (r, s) = kern.rahmenRaster(50, 50, w[3 * i], w[3 * i + 1], w[3 * i + 2])
        PRINT "ok "; r; " "; s
    CATCH f
        PRINT "fehler: "; f
    END TRY
NEXT
PRINT JOIN$(kern.rahmenVorlagen(), " | ")
DIM m AS kern.Muster : m = kern.neuesMuster("leer", 12, 5)
DIM p AS kern.Rahmenplan : p = kern.rahmenPlanen(m, 10, 10, 3)
PRINT "leer: "; p.reihen; " "; p.spalten; " "; p.einRahmen(); " | "; p.sektoren[0].x0; ".."; p.sektoren[0].x1; " "; p.sektoren[1].x0; ".."; p.sektoren[1].x1; " stiche "; p.sektoren[0].stiche
