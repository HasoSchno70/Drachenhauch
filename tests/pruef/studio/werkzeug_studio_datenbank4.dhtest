--- datei proj/Hauptfenster.dh
CLASS Hauptfenster EXTENDS Hauptfenster_Basis
    SUB Geoeffnet()
        DIM ordner AS STRING : ordner = GETENV$("DH_STUDIO_DATEN")
        PRINT "zellen "; GUI_TABLE_ROW_COUNT(Self.liste); " "; GUI_TABLE_GET_CELL(Self.liste, 0, 0); " bilder "; LEN(Self.studioBilder_liste)
        PRINT "laden "; Self.Laden(1); " "; IMAGE_WIDTH(Self.studioBild_fotoFeld); " "; Self.Ungesichert()
        PRINT "laden "; Self.Laden(2); " "; Self.studioBild_fotoFeld
        PRINT "kein bild "; Self.BildSetzen(Self.fotoFeld, PATHJOIN(ordner, "notiz.txt")); " "; Self.Ungesichert()
        PRINT "setzen "; Self.BildSetzen(Self.fotoFeld, PATHJOIN(ordner, "blau.png")); " "; IMAGE_WIDTH(Self.studioBild_fotoFeld); " "; Self.Ungesichert()
        PRINT "sichern "; Self.Sichern(); " "; Self.Ungesichert(); " bilder "; LEN(Self.studioBilder_liste)
        DIM r AS DB_RESULT : r = DB_QUERY(Daten, "SELECT length(foto) FROM produkte WHERE id = 2")
        DB_NEXT(r)
        PRINT "datei "; DB_GET_INT(r, 0)
        Self.BildLeeren(Self.fotoFeld)
        PRINT "leeren "; Self.Ungesichert(); " "; Self.Sichern()
        r = DB_QUERY(Daten, "SELECT foto IS NULL FROM produkte WHERE id = 2")
        DB_NEXT(r)
        PRINT "null "; DB_GET_INT(r, 0); " bilder "; LEN(Self.studioBilder_liste)
        Self.Neu()
        PRINT "neu "; Self.studioBild_fotoFeld; " "; Self.Ungesichert()
    END SUB
    ' Danach steht nur noch in der Zeile Tasse ein Bild (rot) -- in der Zelle.
    SUB foto_Aktion()
        SAVESCREENSHOT(PATHJOIN(GETENV$("DH_STUDIO_DATEN"), "schirm.png"))
    END SUB
END CLASS
--- datei proj/App.dh
CLASS App EXTENDS StudioApp
END CLASS
