' Groesse der Platine (Loecher). Was danach ueber den Rand ragt, meldet die
' Pruefung -- nichts wird still verschoben.
SUB plGroesseDialog()
    DIM d AS INTEGER : d = dialogNeu("Platinengroesse")
    DIM g AS INTEGER : g = gtk_grid_new()
    gtk_grid_set_row_spacing(g, 6)
    gtk_grid_set_column_spacing(g, 10)
    gtk_container_set_border_width(g, 12)
    DIM fs AS INTEGER : fs = feldNeu(STR$(gDok.platine.spalten))
    DIM fz AS INTEGER : fz = feldNeu(STR$(gDok.platine.zeilen))
    gtk_grid_attach(g, etikettNeu("Spalten (Loecher):"), 0, 0, 1, 1)
    gtk_grid_attach(g, fs, 1, 0, 1, 1)
    gtk_grid_attach(g, etikettNeu("Zeilen (Loecher):"), 0, 1, 1, 1)
    gtk_grid_attach(g, fz, 1, 1, 1, 1)
    gtk_box_pack_start(gtk_dialog_get_content_area(d), g, TRUE, TRUE, 0)
    gtk_widget_show_all(d)
    gDlg = d : gDlgFeld1 = fs : gDlgFeld2 = fz
    DIM ok AS BOOLEAN : ok = gtk_dialog_run(d) = GTK_ANTWORT_OK
    DIM ts AS STRING : ts = TRIM$(gtk_entry_get_text(fs))
    DIM tz AS STRING : tz = TRIM$(gtk_entry_get_text(fz))
    gDlg = 0 : gDlgFeld1 = 0 : gDlgFeld2 = 0
    gtk_widget_destroy(d)
    IF NOT ok THEN RETURN
    DIM sp AS INTEGER, ze AS INTEGER
    IF NOT kern.ganzzahlLesen(ts, sp) OR NOT kern.ganzzahlLesen(tz, ze) OR sp < 3 OR ze < 3 OR sp > 300 OR ze > 300 THEN
        meldung("Spalten und Zeilen muessen ganze Zahlen zwischen 3 und 300 sein.")
        RETURN
    END IF
    plGroesseSetzen(sp, ze)
END SUB

SUB aufPlGroesse(knopf AS INTEGER, daten AS INTEGER)
    plGroesseDialog()
END SUB

