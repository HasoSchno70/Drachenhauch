' Benachrichtigungen wie services/notifications.py der Python-App
' (ExpiryNotifier): Abgelaufenes, was heute, morgen und bald abläuft, was
' unter der Mindestmenge liegt -- jedes Produkt einmal je Art und Sitzung,
' „bald“ einmal am Tag; dazu die tägliche Zusammenfassung. Gesendet wird mit
' NOTIFY (Windows am Tray-Symbol, macOS osascript, Linux notify-send).
' KUEHL_MELDUNGEN nennt eine Datei, in die sie statt dessen gehen (für
' Prüfungen, wie KUEHL_EXPORT).
'
' Anders als dort:
'  * Die Häkchen je Art gelten -- der ExpiryNotifier las sie nie, „Bei
'    abgelaufenen Produkten“ aus hieß trotzdem Meldungen über Abgelaufenes.
'  * Geprüft wird in jedem Intervall: dort prüfte check_and_notify nur einmal
'    am Tag, das Prüfintervall (60 Minuten) tat danach nichts, und was am
'    Nachmittag hinzukam und heute abläuft, meldete niemand.
'  * Die Zusammenfassung kommt einmal am Tag zur eingestellten Uhrzeit mit
'    Minuten, auch nach einem Start später am Tag (dort feuerte der
'    24-Stunden-Timer ab dem Start, also zur Startzeit, und nach 9 Uhr
'    gestartet gab es heute keine).
'  * Namen in der Reihenfolge des Ablaufs, jeder einmal (dort aus einer
'    Menge: jedes Mal anders sortiert).
IMPORT "db"

' Was schon gemeldet ist ("art|name"), wie _notified_items.
DIM gemeldet AS MAP OF STRING

' Die ersten drei Namen, mit "..." wenn es mehr sind.
FUNCTION ersteDrei$(namen AS ARRAY OF STRING) AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM n AS STRING
    FOR EACH n IN namen
        IF LEN(t) < 3 THEN ARRAY_PUSH(t, n)
    NEXT
    RETURN JOIN$(t, ", ") + IIF(LEN(namen) > 3, "...", "")
END FUNCTION

' Die Namen, die für diese Art noch nicht gemeldet sind -- und merkt sie.
FUNCTION neueNamen(art AS STRING, namen AS ARRAY OF STRING) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM n AS STRING
    FOR EACH n IN namen
        IF MAPHAS(gemeldet, art + "|" + n) THEN CONTINUE
        MAPPUT(gemeldet, art + "|" + n, "1")
        ARRAY_PUSH(aus, n)
    NEXT
    RETURN aus
END FUNCTION

SUB einmalDazu(liste AS ARRAY OF STRING, name AS STRING)
    IF ARRAY_INDEXOF(liste, name) < 0 THEN ARRAY_PUSH(liste, name)
END SUB

' Produkte unter ihrer Mindestmenge (wie get_products_below_minimum).
FUNCTION unterMindestmenge() AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT p.name FROM products p LEFT JOIN inventory i ON p.id = i.product_id " + _
        "WHERE p.min_quantity IS NOT NULL AND p.min_quantity > 0 GROUP BY p.id HAVING COALESCE(SUM(i.quantity), 0) < p.min_quantity ORDER BY p.name")
    WHILE DB_NEXT(r)
        ARRAY_PUSH(aus, DB_GET_STRING(r, 0))
    WEND
    RETURN aus
END FUNCTION

' Was jetzt zu melden ist (wie check_and_notify, ohne das Senden).
FUNCTION meldungenPruefen(e AS Einstellungen) AS ARRAY OF Nachricht
    DIM aus AS ARRAY OF Nachricht : aus = []
    IF NOT e.meldungenAn THEN RETURN aus
    DIM ab AS ARRAY OF STRING : ab = []
    DIM hz AS ARRAY OF STRING : hz = []
    DIM mo AS ARRAY OF STRING : mo = []
    DIM bald AS ARRAY OF STRING : bald = []
    DIM x AS Eintrag
    ' bestandLaden liefert nach Ablaufdatum.
    FOR EACH x IN bestandLaden()
        IF x.ablauf = "" THEN CONTINUE
        IF x.tage < 0 THEN
            einmalDazu(ab, x.name)
        ELSEIF x.tage = 0 THEN
            einmalDazu(hz, x.name)
        ELSEIF x.tage = 1 THEN
            einmalDazu(mo, x.name)
        ELSEIF x.tage <= e.warnTage THEN
            einmalDazu(bald, x.name)
        END IF
    NEXT
    DIM neu AS ARRAY OF STRING
    IF e.beiAbgelaufen THEN
        neu = neueNamen("abgelaufen", ab)
        IF LEN(neu) > 0 THEN ARRAY_PUSH(aus, nachrichtNeu(tr$("⚠️ Produkte abgelaufen!"), trf$("{0} Produkt(e) sind abgelaufen: {1}", [STR$(LEN(neu)), ersteDrei$(neu)]), TRUE))
    END IF
    IF e.beiHeute THEN
        neu = neueNamen("heute", hz)
        IF LEN(neu) > 0 THEN ARRAY_PUSH(aus, nachrichtNeu(tr$("🔴 Läuft HEUTE ab!"), ersteDrei$(neu), TRUE))
    END IF
    IF e.beiMorgen THEN
        neu = neueNamen("morgen", mo)
        IF LEN(neu) > 0 THEN ARRAY_PUSH(aus, nachrichtNeu(tr$("🟡 Läuft MORGEN ab!"), ersteDrei$(neu), TRUE))
    END IF
    IF e.beiBald AND LEN(bald) > 0 AND NOT MAPHAS(gemeldet, "bald|" + heute$()) THEN
        MAPPUT(gemeldet, "bald|" + heute$(), "1")
        ARRAY_PUSH(aus, nachrichtNeu(tr$("🟡 Bald ablaufend"), trf$("{0} Produkt(e) laufen in den nächsten Tagen ab", [STR$(LEN(bald))]), FALSE))
    END IF
    IF e.beiMinimum THEN
        neu = neueNamen("minimum", unterMindestmenge())
        IF LEN(neu) > 0 THEN ARRAY_PUSH(aus, nachrichtNeu(tr$("📊 Mindestmenge unterschritten"), trf$("{0} Produkt(e): {1}", [STR$(LEN(neu)), ersteDrei$(neu)]), FALSE))
    END IF
    RETURN aus
END FUNCTION

' Wie reset_notifications.
SUB meldungenVergessen()
    MAPCLEAR(gemeldet)
END SUB

' Die tägliche Zusammenfassung (wie send_daily_summary) -- NIL, wenn weder
' etwas abgelaufen ist noch bald abläuft.
FUNCTION zusammenfassung() AS Nachricht
    DIM k AS Kennzahlen : k = NEW Kennzahlen()
    k.rechnen()
    IF k.abgelaufen = 0 AND k.bald = 0 THEN RETURN NIL
    DIM t AS ARRAY OF STRING : t = []
    IF k.abgelaufen > 0 THEN ARRAY_PUSH(t, trf$("❌ {0} abgelaufen", [STR$(k.abgelaufen)]))
    IF k.bald > 0 THEN ARRAY_PUSH(t, trf$("⏰ {0} bald ablaufend", [STR$(k.bald)]))
    ARRAY_PUSH(t, trf$("📦 {0} Artikel gesamt", [STR$(k.gesamt)]))
    RETURN nachrichtNeu(tr$("🧊 Tägliche Kühlschrank-Übersicht"), JOIN$(t, " | "), k.abgelaufen > 0)
END FUNCTION

' Ist die Zusammenfassung fällig? Ab der eingestellten Uhrzeit, einmal am Tag
' (daily_summary_last merkt den Tag, auch über einen Neustart).
FUNCTION zusammenfassungFaellig(e AS Einstellungen) AS BOOLEAN
    IF NOT e.meldungenAn OR NOT e.tagesAn THEN RETURN FALSE
    IF jetzt$() < e.tagesZeit$() THEN RETURN FALSE
    RETURN einstellung$("daily_summary_last", "") <> heute$()
END FUNCTION

SUB zusammenfassungErledigt()
    einstellungSetzen("daily_summary_last", jsonText$(heute$()))
END SUB

' Senden: FALSE, wenn das System sie nicht nahm (kein Tray, kein
' notify-send) -- dann zeigt das Fenster sie selbst.
FUNCTION meldungSenden(m AS Nachricht) AS BOOLEAN
    DIM datei AS STRING : datei = GETENV$("KUEHL_MELDUNGEN")
    IF datei <> "" THEN
        APPENDFILE(datei, IIF(m.wichtig, "! ", "  ") + m.titel + " | " + m.text + CHR$(10))
        RETURN TRUE
    END IF
    TRY
        NOTIFY(m.titel, m.text)
    CATCH fehler
        RETURN FALSE
    END TRY
    RETURN TRUE
END FUNCTION
