' Die Datenbank: das Element Daten (Daten.dhdb) hat den Aufbau der Datei
' fridge_database.db der Python-App -- übernommen mit Projekt -> Datenbank
' aus Datei übernehmen, darum liest diese Fassung dieselbe Datei. Dieses
' Modul gibt der Verbindung den kurzen Namen db, füllt eine neue Datei mit den
' Startdaten (Modul Startdaten) und liest Einstellungen aus app_settings.
' Datumswerte stehen wie dort als Text JJJJ-MM-TT.
IMPORT "db"
IMPORT "json"
DIM db AS DB_CONN

SUB dbOeffnen()
    db = Daten
    ' Wie die Python-App: Löschen eines Produkts nimmt seinen Bestand mit.
    DB_EXEC(db, "PRAGMA foreign_keys = ON")
    IF dbZahl("SELECT COUNT(*) FROM storage_locations") = 0 THEN startdatenAnlegen()
END SUB

' Die erste Spalte der ersten Zeile als Zahl (0, wenn nichts kommt).
FUNCTION dbZahl(sql AS STRING) AS INTEGER
    DIM r AS DB_RESULT : r = DB_QUERY(db, sql)
    IF NOT DB_NEXT(r) THEN RETURN 0
    DIM n AS INTEGER : n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN n
END FUNCTION

' Dasselbe mit einem Wert für das ? in der Abfrage.
FUNCTION dbZahlEin(sql AS STRING, a AS STRING) AS INTEGER
    DIM r AS DB_RESULT : r = DB_QUERY(db, sql, a)
    IF NOT DB_NEXT(r) THEN RETURN 0
    DIM n AS INTEGER : n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN n
END FUNCTION

' Dasselbe mit zwei Werten (?1 und ?2 in der Abfrage).
FUNCTION dbZahlMit(sql AS STRING, a AS STRING, b AS STRING) AS INTEGER
    DIM r AS DB_RESULT : r = DB_QUERY(db, sql, a, b)
    IF NOT DB_NEXT(r) THEN RETURN 0
    DIM n AS INTEGER : n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN n
END FUNCTION

' Heute als JJJJ-MM-TT. KUEHL_HEUTE setzt ein anderes Datum (für Prüfungen,
' damit „bald ablaufend“ nicht vom Kalender abhängt).
FUNCTION heute$() AS STRING
    DIM h AS STRING : h = GETENV$("KUEHL_HEUTE")
    IF h <> "" THEN RETURN h
    RETURN DATE$()
END FUNCTION

' Eine Einstellung aus app_settings. Dort steht JSON, wie die Python-App es
' schreibt: "\"Stück\"" für einen Text, 3 und true wie sie sind.
FUNCTION einstellung$(schluessel AS STRING, vorgabe AS STRING) AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT value FROM app_settings WHERE key = ?", schluessel)
    IF NOT DB_NEXT(r) THEN RETURN vorgabe
    DIM v AS STRING : v = DB_GET_STRING(r, 0)
    DB_CLOSE_RESULT(r)
    TRY
        DIM j AS JSON_HANDLE : j = JSON_PARSE("{" + CHR$(34) + "v" + CHR$(34) + ":" + v + "}")
        IF JSON_TYPE(j, "v") = "string" THEN RETURN JSON_GET_STRING(j, "v")
    CATCH fehler
    END TRY
    RETURN v
END FUNCTION

' Eine Zahl -- was keine ist, gilt als die Vorgabe (nicht als 0: eine
' Warnschwelle "kaputt" hätte sonst nichts mehr als bald gezählt).
FUNCTION einstellungZahl(schluessel AS STRING, vorgabe AS INTEGER) AS INTEGER
    DIM v AS STRING : v = TRIM$(einstellung$(schluessel, STR$(vorgabe)))
    IF NOT REGEX_TEST(v, "^-?[0-9]+(\.[0-9]+)?$") THEN RETURN vorgabe
    RETURN INT(VAL(v))
END FUNCTION

' true/false wie json.dumps; was sonst dasteht, gilt als die Vorgabe.
FUNCTION einstellungJa(schluessel AS STRING, vorgabe AS BOOLEAN) AS BOOLEAN
    DIM v AS STRING : v = LOWER$(TRIM$(einstellung$(schluessel, "")))
    IF v = "true" THEN RETURN TRUE
    IF v = "false" THEN RETURN FALSE
    RETURN vorgabe
END FUNCTION

' Eine Einstellung schreiben -- wert ist schon JSON (wie save_all der
' Python-App: json.dumps), für Text siehe jsonText$.
SUB einstellungSetzen(schluessel AS STRING, wert AS STRING)
    DB_EXEC(db, "INSERT OR REPLACE INTO app_settings (key, value, updated_at) VALUES (?, ?, CURRENT_TIMESTAMP)", schluessel, wert)
END SUB

' Ein Text als JSON-Wert ("Stück" -> "\"Stück\"").
FUNCTION jsonText$(s AS STRING) AS STRING
    DIM j AS JSON_HANDLE : j = JSON_NEW_OBJECT()
    JSON_SET_STRING(j, "v", s)
    DIM t AS STRING : t = JSON_STRINGIFY(j)
    RETURN MID$(t, INSTR(t, ":") + 1, LEN(t) - INSTR(t, ":") - 2)
END FUNCTION

FUNCTION jsonJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "true", "false")
END FUNCTION

' Die Uhrzeit als SS:MM. KUEHL_JETZT setzt eine andere (für Prüfungen der
' Tageszusammenfassung).
FUNCTION jetzt$() AS STRING
    DIM j AS STRING : j = GETENV$("KUEHL_JETZT")
    IF j <> "" THEN RETURN j
    RETURN LEFT$(TIME$(), 5)
END FUNCTION
