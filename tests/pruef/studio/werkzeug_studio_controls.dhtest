{"format":"drachenhauch-studio","fassung":1,"name":"proj","start":"Hauptfenster","elemente":[{"art":"app","name":"App"},{"art":"control","name":"Melder"},{"art":"fenster","name":"Hauptfenster"},{"art":"fenster","name":"Dialog"}]}
