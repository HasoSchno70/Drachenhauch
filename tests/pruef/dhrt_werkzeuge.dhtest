=== nichts gefunden ist kein fehlschlag, ein falscher pfad schon
' Sonst faellt eine Kette ueber ein noch leeres Projekt.
IMPORT "helfer.dh"
dlStarten(["test", CWD$() + "/leer"])
PRINT "leer: rueckgabe "; dlCode
PRINT "leer: meldet sich "; (INSTR(dlErr, "keine Pruefprogramme") >= 0)
dlStarten(["test", CWD$() + "/gibtsnicht"])
PRINT "weg: rueckgabe "; dlCode
PRINT "weg: meldet sich "; (INSTR(dlErr, "gibt es nicht") >= 0)
