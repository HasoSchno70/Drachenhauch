' Das WASM-Geruest: rust/build_wasm.py, der Web-Harness in web/ und der
' emscripten-Einstieg in main.rs. Bis 2026-09-21 tests/test_build_wasm.py
' (pytest) -- die Datei faellt mit dem Python-Teil weg, das Bauskript aber
' NICHT (Entscheidung (c) in docs/entwurf-python-abbau.md: es bleibt Python,
' nur mit der Standardbibliothek). Darum prueft ein Python-Kind seine Logik:
' dasselbe nackte Python 3, das der Bau ohnehin braucht, ohne pytest.
'
' Der eigentliche emscripten-Bau ist hier nicht ausfuehrbar.
' Format: docs/werkzeuge.md, dhrt test.

=== der web-harness hat seine haken
' raylib/emscripten zeichnet ins Canvas, der Live-Editor schreibt die
' Quelle nach /program.dh und laedt zum Lauf frisch.
DIM w AS STRING : w = ARG$(0) + "/web/"
DIM html AS STRING : html = JOIN$(READLINES(w + "index.html"), CHR$(10))
PRINT "canvas "; INSTR(html, "id=" + CHR$(34) + "canvas" + CHR$(34)) >= 0
PRINT "editor "; INSTR(html, "id=" + CHR$(34) + "src" + CHR$(34)) >= 0
PRINT "laedt dhrt.js "; INSTR(html, "dhrt.js") >= 0
DIM js AS STRING : js = JOIN$(READLINES(w + "playground.js"), CHR$(10))
PRINT "schreibt program.dh "; INSTR(js, "/program.dh") >= 0
PRINT "laedt neu "; INSTR(js, "location.reload") >= 0
--- argumente
{sammlung}/../..
--- erwartet
canvas TRUE
editor TRUE
laedt dhrt.js TRUE
schreibt program.dh TRUE
laedt neu TRUE

=== main.rs hat den emscripten-einstieg
' Kompiliert im Browser /program.dh (Quelle, Vorrang) und faellt auf
' /program.dhc zurueck.
DIM src AS STRING : src = JOIN$(READLINES(ARG$(0) + "/rust/drachenhauch_runtime/src/main.rs"), CHR$(10))
PRINT "cfg "; INSTR(src, "target_os = " + CHR$(34) + "emscripten" + CHR$(34)) >= 0
PRINT "quelle "; INSTR(src, "/program.dh" + CHR$(34)) >= 0
PRINT "rueckfall "; INSTR(src, "/program.dhc") >= 0
--- argumente
{sammlung}/../..
--- erwartet
cfg TRUE
quelle TRUE
rueckfall TRUE

=== build_wasm.py rechnet richtig
' Toolchain-Pruefung liefert Wahrheitswerte, die Quelle wird eingebettet,
' ohne Toolchain endet der Bau sauber, und eine Aenderung der Linker-Flags
' raeumt die alte Ausgabe weg (cargo verfolgt EMCC_CFLAGS nicht -- sonst
' bliebe die ALTE .wasm liegen und der Bau meldete trotzdem Erfolg).
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF teil <> "" THEN
            aus = aus + teil
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN REPLACE$(aus, CHR$(13), "")
END FUNCTION
' Probiert der Reihe nach, bis einer die Probe wirklich durchlaeuft:
' "python3"/"python" koennen unter Windows Platzhalter aus WindowsApps sein,
' die sich gar nicht starten lassen (os error 3); dann bleibt der Launcher.
DIM p AS INTEGER : p = -1
DIM aus AS STRING : aus = ""
DIM namen AS ARRAY OF STRING : namen = ["python3", "python", "py"]
DIM i AS INTEGER
FOR i = 0 TO LEN(namen) - 1
    TRY
        p = PROCESS_START(namen[i], "probe.py", ARG$(0))
        aus = lauf$(p)
    CATCH e
        p = -1
    END TRY
    IF p >= 0 AND INSTR(aus, "ergebnis") >= 0 THEN BREAK
    p = -1
NEXT
IF p < 0 THEN
    PRINT "UEBERSPRINGEN: kein Python 3 gefunden"
    EXIT(0)
END IF
PRINT TRIM$(aus)
PRINT "rueckgabe "; PROCESS_CODE(p)
--- argumente
{sammlung}/../..
--- datei probe.py
import contextlib, importlib.util, io, sys, tempfile
from pathlib import Path

ROOT = Path(sys.argv[1]).resolve()
spec = importlib.util.spec_from_file_location("build_wasm", ROOT / "rust" / "build_wasm.py")
bw = importlib.util.module_from_spec(spec)
spec.loader.exec_module(bw)

info = bw.check_toolchain()
print("toolchain", sorted(info) == ["cargo", "emcc", "wasm_target"] and all(isinstance(v, bool) for v in info.values()))

with tempfile.TemporaryDirectory() as t:
    t = Path(t)
    gb = t / "hi.dh"
    gb.write_text('PRINT "x"\n', encoding="utf-8")
    out = bw.copy_source(gb, t)
    print("eingebettet", out.name == "program.dh" and out.read_text(encoding="utf-8") == gb.read_text(encoding="utf-8"))

with tempfile.TemporaryDirectory() as t:
    t = Path(t)
    gb = t / "hi.dh"
    gb.write_text("PRINT 1\n", encoding="utf-8")
    bw.check_toolchain = lambda: {"emcc": False, "cargo": False, "wasm_target": False}
    # build() meldet, was es tut (mit Pfaden) -- das gehoert nicht in den Vergleich.
    with contextlib.redirect_stdout(io.StringIO()):
        rc = bw.build(gb, t)
    print("ohne toolchain", rc == 0 and (t / "program.dh").exists())

with tempfile.TemporaryDirectory() as t:
    t = Path(t)
    rel = t / "target" / bw.TARGET / "release"
    rel.mkdir(parents=True)
    bw.CRATE = t
    def anlegen():
        for n in ("dhrt.js", "dhrt.wasm", "dhrt.data"):
            (rel / n).write_bytes(b"alt")
    anlegen()
    erst = bw.erzwinge_relink("-s A=1", rel) is True and not (rel / "dhrt.wasm").exists()
    anlegen()
    gleich = bw.erzwinge_relink("-s A=1", rel) is False and (rel / "dhrt.wasm").read_bytes() == b"alt"
    neu = bw.erzwinge_relink("-s A=2", rel) is True and not (rel / "dhrt.wasm").exists() and not (rel / "dhrt.data").exists()
    print("relink", erst, gleich, neu)

# Der Zielordner: CARGO_TARGET_DIR, wenn gesetzt -- relativ zum Ordner, in
# dem cargo laeuft (out_dir) --, sonst target/ im Crate
with tempfile.TemporaryDirectory() as t:
    t = Path(t)
    bw.CRATE = t / "crate"
    ohne = bw.release_ordner(t / "web", {}) == t / "crate" / "target" / bw.TARGET / "release"
    absolut = bw.release_ordner(t / "web", {"CARGO_TARGET_DIR": str(t / "ziel")}) == t / "ziel" / bw.TARGET / "release"
    relativ = bw.release_ordner(t / "web", {"CARGO_TARGET_DIR": "bau"}) == (t / "web").resolve() / "bau" / bw.TARGET / "release"
    print("zielordner", ohne, absolut, relativ)

# Das Datenpaket: dieselbe Quelle laesst den Stempel stehen (copy_source
# schreibt sie dann nicht neu), ein geaendertes Asset nicht
with tempfile.TemporaryDirectory() as t:
    t = Path(t)
    (t / "spiel" / "assets").mkdir(parents=True)
    quelle = t / "spiel" / "main.dh"
    quelle.write_text('PRINT "x"\n', encoding="utf-8")
    (t / "spiel" / "assets" / "a.fs").write_text("alt", encoding="utf-8")
    web = t / "web"
    bw.copy_source(quelle, web)
    bw.copy_assets(quelle, web)
    s1 = bw.paket_stempel(web)
    bw.copy_source(quelle, web)
    bw.copy_assets(quelle, web)
    gleich = bw.paket_stempel(web) == s1
    (t / "spiel" / "assets" / "a.fs").write_text("neu und laenger", encoding="utf-8")
    bw.copy_assets(quelle, web)
    asset = bw.paket_stempel(web) != s1 and "assets/a.fs" in s1
    quelle.write_text('PRINT "y"\n', encoding="utf-8")
    s2 = bw.paket_stempel(web)
    bw.copy_source(quelle, web)
    programm = bw.paket_stempel(web) != s2
    print("stempel", gleich, asset, programm)

# Neu linken auch bei gleichen Flags, wenn sich das Paket aendert -- und dann
# auch in deps/ loeschen (sonst holt cargo die alte Kopie von dort zurueck)
with tempfile.TemporaryDirectory() as t:
    rel = Path(t) / "rel"
    (rel / "deps").mkdir(parents=True)
    bw.erzwinge_relink("-s A=1", rel, "paket 1")
    for n in ("dhrt.js", "dhrt.wasm", "dhrt.data"):
        (rel / n).write_bytes(b"alt")
        (rel / "deps" / n).write_bytes(b"alt")
    bleibt = bw.erzwinge_relink("-s A=1", rel, "paket 1") is False and (rel / "deps" / "dhrt.data").exists()
    neu = bw.erzwinge_relink("-s A=1", rel, "paket 2") is True
    weg = not any((o / n).exists() for o in (rel, rel / "deps") for n in ("dhrt.js", "dhrt.wasm", "dhrt.data"))
    print("relink paket", bleibt, neu, weg)

# Der Bau mit einem nachgemachten cargo: die Ergebnisse kommen aus dem
# Zielordner von CARGO_TARGET_DIR (dhrt.data aus deps/); fehlen sie, meldet
# der Bau einen Fehler statt "Fertig"
import os, types
bw.check_toolchain = lambda: {"emcc": True, "cargo": True, "wasm_target": True}
bw.setup_emscripten_env = lambda: False
def bauen(liefern):
    with tempfile.TemporaryDirectory() as t:
        t = Path(t)
        bw.CRATE = t / "crate"
        (t / "spiel" / "assets").mkdir(parents=True)
        quelle = t / "spiel" / "main.dh"
        quelle.write_text('PRINT "x"\n', encoding="utf-8")
        (t / "spiel" / "assets" / "a.fs").write_text("shader", encoding="utf-8")
        web = t / "web"
        def lauf(cmd, cwd=None, env=None):
            rel = bw.release_ordner(cwd, env)
            if liefern:
                (rel / "deps").mkdir(parents=True, exist_ok=True)
                (rel / "dhrt.js").write_bytes(b"js")
                (rel / "dhrt.wasm").write_bytes(b"wasm")
                (rel / "deps" / "dhrt.data").write_bytes(b"daten")
            return types.SimpleNamespace(returncode=0)
        bw.subprocess = types.SimpleNamespace(run=lauf)
        alt = os.environ.get("CARGO_TARGET_DIR")
        os.environ["CARGO_TARGET_DIR"] = str(t / "ziel")
        puffer = io.StringIO()
        try:
            with contextlib.redirect_stdout(puffer):
                rc = bw.build(quelle, web)
        finally:
            if alt is None:
                del os.environ["CARGO_TARGET_DIR"]
            else:
                os.environ["CARGO_TARGET_DIR"] = alt
        da = all((web / n).exists() for n in ("dhrt.js", "dhrt.wasm", "dhrt.data"))
        return rc, da, puffer.getvalue()
rc, da, text = bauen(True)
print("bau", rc == 0, da and "Fertig" in text)
rc, da, text = bauen(False)
print("bau ohne ergebnis", rc == 2, "FEHLER" in text and "Fertig" not in text)
print("ergebnis fertig")
--- erwartet
toolchain True
eingebettet True
ohne toolchain True
relink True True True
zielordner True True True
stempel True True True
relink paket True True True
bau True True
bau ohne ergebnis True True
ergebnis fertig
rueckgabe 0
