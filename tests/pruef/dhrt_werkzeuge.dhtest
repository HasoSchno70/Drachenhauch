' Die Werkzeuge um die Sprache herum: `--version`, `--help`, `dhrt test`,
' `dhrt fmt` und `dhrt doku` -- die Zeichen, an denen jemand abliest, ob eine
' Sprache zum Arbeiten taugt.
'
' Bis 2026-09-16 tests/test_dhrt_werkzeuge.py. Gestartet wird dhrt als Kind
' (_hilfen/dhrtlauf.dh); die Pruefprogramme und die zu formatierenden Dateien
' schreibt jeder Fall selbst in seinen Ordner.

=== die fassung wird ueberhaupt beantwortet
' `dhrt --version` antwortete frueher mit "Kann --version nicht lesen" -- es
' hielt den Namen fuer eine Datei. Das ist das Erste, was jemand tippt.
IMPORT "helfer.dh"
dlStarten(["--version"])
PRINT "rueckgabe "; dlCode
PRINT "beginnt mit dhrt "; (LEFT$(dlAus, 5) = "dhrt ")
' Ein Bau ohne --hardware laesst Module weg, ohne dass man es dem Binary
' ansieht -- die Meldung kam sonst erst beim ersten Aufruf.
PRINT "nennt die teile "; (INSTR(dlAus, "dabei:") >= 0)
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0
beginnt mit dhrt TRUE
nennt die teile TRUE

=== die fassung stimmt mit dem projekt ueberein
' Seit dem Loeschen des Python-Teils (2026-09-21) nennt nur noch
' rust/drachenhauch_runtime/Cargo.toml die Fassung -- vorher standen
' pyproject.toml und drachenhauch/__init__.py daneben und mussten dasselbe
' sagen. Geprueft wird, dass die Laufzeit meldet, was dort steht: Cargo
' verlangt drei Stellen, "2026.8.0" heisst nach aussen "2026.8".
IMPORT "helfer.dh"
FUNCTION ersteFassung$(pfad AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(pfad)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        DIM zeile AS STRING : zeile = TRIM$(z[i])
        IF LEFT$(zeile, 10) = "version = " THEN RETURN REPLACE$(MID$(zeile, 10), CHR$(34), "")
    NEXT
    RETURN ""
END FUNCTION
DIM cargo AS STRING : cargo = TRIM$(ersteFassung$(ARG$(0) + "/rust/drachenhauch_runtime/Cargo.toml"))
DIM kurz AS STRING : kurz = cargo
IF RIGHT$(kurz, 2) = ".0" THEN kurz = LEFT$(kurz, LEN(kurz) - 2)
PRINT "cargo gelesen "; (LEN(cargo) >= 6)
dlStarten(["--version"])
PRINT "laufzeit "; (TRIM$(SPLIT$(dlAus, CHR$(10))[0]) = "dhrt " + kurz)
PRINT "version$ "; (VERSION$() = kurz)
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
cargo gelesen TRUE
laufzeit TRUE
version$ TRUE

=== die hilfe nennt die unterbefehle
IMPORT "helfer.dh"
dlStarten(["--help"])
PRINT "rueckgabe "; dlCode
DIM woerter AS ARRAY OF STRING : woerter = ["run", "test", "--check", "--export", "--version"]
DIM i AS INTEGER
FOR i = 0 TO LEN(woerter) - 1
    PRINT woerter[i]; " "; (INSTR(dlAus, woerter[i]) >= 0)
NEXT
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0
run TRUE
test TRUE
--check TRUE
--export TRUE
--version TRUE

=== der laeufer findet die pruefprogramme und besteht
IMPORT "helfer.dh"
WRITEALL("ordner/a_pruefung.dh", !"ASSERT(1 + 1 = 2, \"Addition\")\nPRINT \"alles gut\"\n")
WRITEALL("ordner/b_pruefung.dh", !"ASSERT(1 + 1 = 2, \"Addition\")\nPRINT \"alles gut\"\n")
dlStarten(["test", CWD$() + "/ordner"])
PRINT "rueckgabe "; dlCode
PRINT "zweimal ok "; dlZaehle(dlAus, "  ok ")
PRINT "bilanz "; (INSTR(dlAus, "2 Datei(en), 2 ok, 0 mit Fehlern") >= 0)
--- verzeichnis ordner
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0
zweimal ok 2
bilanz TRUE

=== ein fehlschlag faerbt den ganzen lauf
IMPORT "helfer.dh"
WRITEALL("ordner/a_pruefung.dh", !"ASSERT(1 + 1 = 2, \"Addition\")\n")
WRITEALL("ordner/b_pruefung.dh", !"ASSERT_COLLECT(TRUE)\nASSERT_EQ(2 + 2, 5, \"Rechnen\")\nASSERT_REPORT()\nIF ASSERT_FAILED() > 0 THEN EXIT(1)\n")
dlStarten(["test", CWD$() + "/ordner"])
PRINT "rueckgabe "; dlCode
PRINT "bilanz "; (INSTR(dlAus, "1 ok, 1 mit Fehlern") >= 0)
' Die Einzelheiten muessen mit heraus -- sonst weiss niemand, WAS schiefging.
PRINT "nennt die zusage "; (INSTR(dlAus, "Rechnen") >= 0)
--- verzeichnis ordner
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 1
bilanz TRUE
nennt die zusage TRUE

