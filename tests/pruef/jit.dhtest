=== print mit einer funktion, die globale schreibt
DIM zaehler AS INTEGER
SUB zaehle()
    zaehler = zaehler + 1
END SUB
DIM i AS INTEGER
DIM s AS FLOAT
TRY
    FOR i = 2 TO -2 STEP -1
        zaehle()
        PRINT "runde "; i; " "; zaehler
        s = s + SQR(i)
    NEXT
CATCH e
    PRINT "gefangen: "; e
END TRY
PRINT zaehler
--- umgebung
DHRT_JIT=aus
--- erwartet
runde 2 1
runde 1 2
runde 0 3
runde -1 4
gefangen: SQR von negativer Zahl
4

