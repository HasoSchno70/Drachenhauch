' Mehrere Blaetter: Reiter ueber der Zeichenflaeche und das Menue "Blatt".
' Globaler Namensraum.
'
' Die Reiter sind ein GtkNotebook mit leeren Seiten -- es dient nur als
' Reiterleiste; gezeichnet wird weiter auf der einen Zeichenflaeche. Neu,
' Umbenennen und Loeschen sind je ein Rueckgaengig-Schritt.

DIM gReiter AS INTEGER            ' das GtkNotebook
DIM gReiterBauen AS BOOLEAN       ' waehrend des Neuaufbaus: Seitenwechsel ignorieren
DIM gBlattMenue AS INTEGER
DIM gBlattMenueNeu AS INTEGER

FUNCTION reiterNeu() AS INTEGER
    gReiter = gtk_notebook_new()
    gtk_notebook_set_scrollable(gReiter, TRUE)
    gtk_notebook_set_show_border(gReiter, FALSE)
    signalSeite(gReiter, "switch-page", aufReiterWechsel, 0, 0, 0)
    RETURN gReiter
END FUNCTION

' Die Reiter nach den Blaettern des Dokuments neu aufbauen (nach Laden,
' Rueckgaengig, Neu/Umbenennen/Loeschen) und das aktuelle Blatt zeigen.
SUB reiterAktualisieren()
    IF gReiter = 0 THEN RETURN
    gReiterBauen = TRUE
    WHILE gtk_notebook_get_n_pages(gReiter) > 0
        gtk_notebook_remove_page(gReiter, 0)
    WEND
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gDok.blaetter) - 1
        DIM leer AS INTEGER : leer = gtk_box_new(GTK_WAAGERECHT, 0)
        DIM r AS INTEGER : r = gtk_notebook_append_page(gReiter, leer, gtk_label_new(gDok.blaetter[i].name))
    NEXT
    gtk_widget_show_all(gReiter)
    gtk_notebook_set_current_page(gReiter, aktuellerBlattIndex())
    gReiterBauen = FALSE
END SUB

SUB aufReiterWechsel(nb AS INTEGER, seite AS INTEGER, nummer AS INTEGER, daten AS INTEGER)
    IF gReiterBauen THEN RETURN
    blattWechseln(nummer)
END SUB

' Auf ein anderes Blatt wechseln (Auswahl und angefangener Draht verfallen).
SUB blattWechseln(i AS INTEGER)
    IF i < 0 OR i >= LEN(gDok.blaetter) THEN RETURN
    IF gDok.blaetter[i] = gBlatt THEN RETURN
    gBlatt = gDok.blaetter[i]
    auswahlAufheben()
    gDrahtAktiv = FALSE
    gDrahtPunkte = []
    gHoverAktiv = FALSE
    IF gReiter <> 0 AND gtk_notebook_get_current_page(gReiter) <> i THEN
        gReiterBauen = TRUE
        gtk_notebook_set_current_page(gReiter, i)
        gReiterBauen = FALSE
    END IF
    neuZeichnen()
    statusAktualisieren()
END SUB

FUNCTION blattNameFrei(name AS STRING, ausser AS INTEGER) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gDok.blaetter) - 1
        IF i <> ausser AND gDok.blaetter[i].name = name THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

SUB blattNeu()
    DIM k AS INTEGER : k = LEN(gDok.blaetter) + 1
    WHILE NOT blattNameFrei("Blatt" + STR$(k), -1)
        k = k + 1
    WEND
    verlaufMerken()
    ARRAY_PUSH(gDok.blaetter, NEW kern.Blatt("Blatt" + STR$(k)))
    reiterAktualisieren()
    blattWechseln(LEN(gDok.blaetter) - 1)
    geaendert()
END SUB

SUB blattUmbenennen()
    DIM i AS INTEGER : i = aktuellerBlattIndex()
    DIM neu AS STRING : neu = TRIM$(textAbfrage$("Blatt umbenennen", "Name:", gBlatt.name))
    IF neu = "" OR neu = gBlatt.name THEN RETURN
    IF CONTAINS(neu, "/") THEN
        meldung("Ein Blattname darf kein / enthalten (er steht vor lokalen Netznamen).")
        RETURN
    END IF
    IF NOT blattNameFrei(neu, i) THEN
        meldung("Ein Blatt namens " + neu + " gibt es schon.")
        RETURN
    END IF
    verlaufMerken()
    gBlatt.name = neu
    reiterAktualisieren()
    geaendert()
END SUB

SUB blattLoeschen()
    IF LEN(gDok.blaetter) <= 1 THEN
        meldung("Das letzte Blatt laesst sich nicht loeschen.")
        RETURN
    END IF
    DIM i AS INTEGER : i = aktuellerBlattIndex()
    IF LEN(gBlatt.bauteile) + LEN(gBlatt.draehte) + LEN(gBlatt.labels) > 0 THEN
        IF NOT bestaetigen("Blatt loeschen?", "Das Blatt " + gBlatt.name + " ist nicht leer." + CHR$(10) + "Es laesst sich mit Rueckgaengig zurueckholen.", "Loeschen") THEN RETURN
    END IF
    verlaufMerken()
    ARRAY_REMOVE_AT(gDok.blaetter, i)
    gBlatt = gDok.blaetter[MAX(i - 1, 0)]
    auswahlAufheben()
    reiterAktualisieren()
    geaendert()
END SUB

SUB aufMenueBlattNeu(e AS INTEGER, d AS INTEGER)
    blattNeu()
END SUB

SUB aufMenueBlattUmbenennen(e AS INTEGER, d AS INTEGER)
    blattUmbenennen()
END SUB

SUB aufMenueBlattLoeschen(e AS INTEGER, d AS INTEGER)
    blattLoeschen()
END SUB

SUB blattMenueBauen()
    gBlattMenue = gtk_menu_new()
    gBlattMenueNeu = menueEintrag(gBlattMenue, "Neues Blatt")
    signal(gBlattMenueNeu, "activate", aufMenueBlattNeu, 0, 0, 0)
    signal(menueEintrag(gBlattMenue, "Blatt umbenennen ..."), "activate", aufMenueBlattUmbenennen, 0, 0, 0)
    gtk_menu_shell_append(gBlattMenue, gtk_separator_menu_item_new())
    signal(menueEintrag(gBlattMenue, "Blatt loeschen ..."), "activate", aufMenueBlattLoeschen, 0, 0, 0)
    gtk_widget_show_all(gBlattMenue)
END SUB

SUB aufBlattKnopf(knopf AS INTEGER, daten AS INTEGER)
    gtk_menu_popup_at_widget(gBlattMenue, knopf, GDK_SCHWERE_UNTEN_LINKS, GDK_SCHWERE_OBEN_LINKS, 0)
END SUB
