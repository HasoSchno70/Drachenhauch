FOR EACH proj IN ["kap23/mediathek", "loesungen/kap23_gross", "loesungen/kap23_erinnern"]
    DIM nm AS STRING : nm = BASENAME(proj)
    IF nm = "mediathek" THEN nm = "kap23_mediathek"
    kopieren(code + proj, CWD$() + "/" + nm)
    f5(nm, CWD$() + "/" + nm)
NEXT
