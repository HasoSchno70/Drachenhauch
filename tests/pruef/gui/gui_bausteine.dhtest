=== eine gekuerzte beschriftung bleibt in ihrer breite
' Gezaehlt werden helle Punkte rechts neben der 80 Punkte breiten
' Beschriftung: gekuerzt keine, ungekuerzt laeuft der Text hinaus.
IMPORT "gui"
SCREEN(400, 120, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 120)
GUI_WINDOW_CHROME(w, FALSE)
DIM a AS GUI_WIDGET : a = GUI_LABEL(w, "Ein sehr langer Dateiname.txt", 10, 10)
DIM b AS GUI_WIDGET : b = GUI_LABEL(w, "Ein sehr langer Dateiname.txt", 10, 60)
GUI_SET_BOUNDS(a, 10, 10, 80, 20)
GUI_SET_BOUNDS(b, 10, 60, 80, 20)
GUI_LABEL_SET(a, "kuerzen", "ende")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H000000)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=4
DHRT_SCREENSHOT={fall}/bild.png
--- nachher
SCREEN(10, 10, "N", 1)
DIM b AS INTEGER : b = LOADIMAGE("bild.png")
FUNCTION hell(y0 AS INTEGER, y1 AS INTEGER) AS INTEGER
    DIM n AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = y0 TO y1
        FOR x = 95 TO 380
            IF (GETPIXEL(b, x, y) BAND &HFF) > 128 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
PRINT "gekuerzt " + STR$(hell(10, 30) = 0) + " ungekuerzt " + STR$(hell(60, 80) > 0)
--- erwartet
gekuerzt TRUE ungekuerzt TRUE

=== eine markierbare beschriftung kopiert mit strg+c
IMPORT "gui"
SCREEN(400, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM lb AS GUI_WIDGET : lb = GUI_LABEL(w, "Hallo Welt", 20, 20)
GUI_LABEL_SET(lb, "auswaehlbar", 1)
CLIPBOARD_SET("vorher")
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 15 THEN PRINT "gezogen '" + GUI_LABEL_SELECTION$(lb) + "'"
    IF n = 25 THEN PRINT "kopiert '" + CLIPBOARD_GET() + "'"
    IF n = 45 THEN PRINT "doppelklick '" + GUI_LABEL_SELECTION$(lb) + "'"
    IF n = 55 THEN PRINT "daneben '" + GUI_LABEL_SELECTION$(lb) + "'"
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
