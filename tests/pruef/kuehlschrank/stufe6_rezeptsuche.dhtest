' Kuehlschrank-App im Drachenhauch Studio, Stufe 6 (zweiter Teil): die
' Rezeptsuche im Internet (examples/studio/kuehlschrank: KatalogFenster,
' Module Spoonacular und Uebersetzung). Proben wie in den Stufen davor: F5
' im Studio, dann main.dh mit einer Probe statt der Bildschleife; Heute ist
' fest. Spoonacular und der Uebersetzer sind ein falscher Server auf diesem
' Rechner (_hilfen/spoon_server.dh) -- nie die echten, nie ein echter
' Schluessel.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== woerterbuch, einheiten, stuecke, katalog nach zutaten
' Suchwoerter gehen englisch hinaus, auch ohne Umlaut (die Python-App
' uebersetzte "Nudeln mit Tomaten" nicht) und zusammengesetzt; Zutaten
' kommen deutsch herein, das laengste bekannte Ende gilt. Einheiten wie
' UnitConverter, aber "oz." und "Tbsps" werden auch umgerechnet. Lange
' Zeilen teilt der Uebersetzer an Satzenden.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM f AS STRING
FOR EACH f IN ["Hähnchen mit Nudeln", "Nudeln mit Tomaten", "Kartoffelsuppe", "Schweinebraten", "Käsespätzle", "Jägerschnitzel", "Vollmilch 3,5 %", "pasta carbonara", "Saure Sahne", "Erdbeerkuchen"]
    PRINT f; " -> "; frageEnglisch$(f)
NEXT
PRINT "zutaten -> "; zutatenEnglisch$("Milch, Hähnchenbrust ,Tomaten,")
FOR EACH f IN ["chicken breast", "red bell pepper", "fresh basil", "strawberries", "large eggs", "sriracha", "salt and pepper", "Cherries", "cranberries", "peaches", "lemons"]
    PRINT f; " -> ["; zutatDeutsch$(f); "]"
NEXT
DIM z AS Zutat : z = NEW Zutat()
DIM e AS STRING
FOR EACH e IN ["2|cups", "8|oz", "8|oz.", "1.5|tablespoons", "3|Tbsps", "0.25|tsp", "5|cups", "3|pounds", "2|large", "1|", "2|handfuls", "1|stick", "0.333|cup", "236.588|ml"]
    DIM t AS ARRAY OF STRING : t = SPLIT(e, "|")
    einheitUmrechnen(z, VAL(t[0]), t[1])
    PRINT e; " -> "; z.mengeText$()
NEXT
DIM lang AS STRING : lang = ""
DIM i AS INTEGER
FOR i = 1 TO 30
    lang = lang + "Stir the pot now and wait. "
NEXT
DIM st AS ARRAY OF STRING : st = ueStuecke(lang)
DIM l AS ARRAY OF STRING : l = []
FOR EACH f IN st
    ARRAY_PUSH(l, STR$(LEN(f)) + ":" + RIGHT$(f, 14))
NEXT
PRINT "stuecke "; LEN(lang); " -> "; JOIN$(l, " / ")
PRINT "ohne satzende "; LEN(ueStuecke(REPEAT$("abcdefghi ", 50))); " | kurz "; JOIN$(ueStuecke("  Boil.  "), "|")
DIM x AS Rezept
DIM n AS ARRAY OF STRING : n = []
FOR EACH x IN katalogNachZutaten("Milch, Ei", 6)
    ARRAY_PUSH(n, x.name)
NEXT
PRINT "nach zutaten "; JOIN$(n, ", ")
PRINT "katalog max 3 "; LEN(katalogSuchen("kartoffel", 3))
--- erwartet
