' =====================================================================
'  PYRAMID PUSHER  --  A Sokoban-Style Escape
'  Schiebe die Ankh-Kisten auf die leuchtenden Zielfelder. Ist die Kammer
'  geloest, springt die Schatztruhe auf und zeigt den Code zur naechsten
'  Kammer.
'
'  Steuerung:
'    Pfeile / WASD  bewegen + schieben
'    U / Z          letzten Zug zuruecknehmen
'    R              Kammer neu starten
'    L              Level-Auswahl     C = Code-Schloss
'    ESC            zurueck / Menue
'    LEER / ENTER   bestaetigen
'
'  Level liegen als Standard-.xsb/.sok-Dateien in  levels/ . Eigene oder
'  klassische Saetze (z.B. Microban, frei verteilbar) einfach dort ablegen.
'
'  Start:  gbrun.py pyramid_pusher\pyramid_pusher.gb       (oder im Editor F5)
' =====================================================================

IMPORT "input"
IMPORT "save"
IMPORT "audio"
IMPORT "imgfx"
IMPORT "particles"
IMPORT "db"

CONST SCR_W = 960
CONST SCR_H = 600
CONST CELL = 32
CONST GWMAX = 54           ' groesste Klassik-Level sind ~49 breit
CONST GHMAX = 46           ' ~43 hoch
CONST MAXBOX = 128
CONST MAXLEV = 600
CONST MAXCHAP = 80
CONST UMAX = 6000
CONST SAVE_PATH = "pyramid_pusher.save"
CONST MASK_SCALE = 4.0          ' Lichtmaske deckt bei scale 4 jede Spielerlage
CONST FULLSCREEN = TRUE         ' TRUE = randloses Vollbild (SCREEN_NATIVE + Render-Target-Upscale)
CONST DEV_UNLOCK = FALSE        ' TRUE = alle Kammern/Kapitel sofort spielbar (Entwicklung)

' Sichtfenster fuer das Spielfeld (unter dem HUD-Balken)
CONST VX = 0
CONST VY = 72
CONST VW = 960
CONST VH = 488

' Tile-Typen in smap
CONST T_VOID = 0
CONST T_FLOOR = 1
CONST T_WALL = 2

' Spezial-Features (Bonus-Mechaniken) in feat[]
CONST F_NONE = 0
CONST F_PIT = 1            ' offenes Loch (Spieler blockiert, Kiste fuellt es)
CONST F_PITFILLED = 2      ' gefuelltes Loch (= begehbarer Boden)
CONST F_ICE = 3            ' Eis (Spieler rutscht bis zur Wand)
CONST F_BUTTON = 4         ' Schalter (alle belegt -> Tueren auf)
CONST F_DOOR = 5           ' Tuer (zu = Wand, auf = Boden)

' ----------------------------------------------------------------------
'  LEVEL-KATALOG
' ----------------------------------------------------------------------
STRUCT LevelInfo
    DIM title AS STRING
    DIM setname AS STRING
    DIM code AS STRING
    DIM board AS STRING          ' Zeilen mit "|" verbunden
    DIM w AS INTEGER
    DIM h AS INTEGER
END STRUCT
DIM cat[MAXLEV] AS LevelInfo
DIM ncat AS INTEGER

' Parser-Akkumulatoren (global, weil SUBs keine Caller-Locals schreiben)
DIM p_rows AS STRING
DIM p_w AS INTEGER
DIM p_h AS INTEGER
DIM p_title AS STRING
DIM p_set AS STRING

' ----------------------------------------------------------------------
'  AKTUELLER SPIELZUSTAND
' ----------------------------------------------------------------------
DIM smap[GWMAX * GHMAX] AS INTEGER
DIM goalc[GWMAX * GHMAX] AS INTEGER
DIM feat[GWMAX * GHMAX] AS INTEGER
DIM box_active[MAXBOX] AS BOOLEAN
DIM btnx[MAXBOX] AS INTEGER
DIM btny[MAXBOX] AS INTEGER
DIM nbutton AS INTEGER
DIM ndoor AS INTEGER
DIM doors_open AS BOOLEAN
DIM gw AS INTEGER
DIM gh AS INTEGER
DIM px AS INTEGER
DIM py AS INTEGER
DIM facing AS INTEGER           ' 0 down  1 up  2 right  3 left
DIM boxx[MAXBOX] AS INTEGER
DIM boxy[MAXBOX] AS INTEGER
DIM goalpx[MAXBOX] AS INTEGER
DIM goalpy[MAXBOX] AS INTEGER
DIM nbox AS INTEGER
DIM par_push AS INTEGER         ' untere Schub-Schranke (fuer Sterne)
DIM win_stars AS INTEGER
DIM moves AS INTEGER
DIM pushes AS INTEGER
DIM cur AS INTEGER
DIM ngoal AS INTEGER

' Sanftes Gleiten (Render-Interpolation; Logik bleibt rasterbasiert)
CONST ANIM_DUR = 0.14           ' Sekunden pro Schritt (groesser = langsameres Gleiten)
DIM anim_t AS FLOAT             ' 0..1, 1 = fertig
DIM gpx AS FLOAT               ' Start-Pixel-Offset Spieler
DIM gpy AS FLOAT
DIM gbx AS FLOAT               ' Start-Pixel-Offset bewegte Kiste
DIM gby AS FLOAT
DIM anim_box AS INTEGER        ' Index der gleitenden Kiste (-1 = keine)
DIM cur_pox AS INTEGER         ' aktueller Spieler-Pixel-Offset (fuer Licht)
DIM cur_poy AS INTEGER

' Undo-Stack (absolute Positionen -> robust fuer Schieben/Gleiten/Loch-Fuellen)
DIM u_ppx[UMAX] AS INTEGER
DIM u_ppy[UMAX] AS INTEGER
DIM u_mbox[UMAX] AS INTEGER     ' bewegte Kiste (-1 = keine)
DIM u_mbx[UMAX] AS INTEGER
DIM u_mby[UMAX] AS INTEGER
DIM u_fill[UMAX] AS INTEGER     ' 1 = ein Loch wurde gefuellt
DIM u_pitx[UMAX] AS INTEGER
DIM u_pity[UMAX] AS INTEGER
DIM utop AS INTEGER

' Flood-Fill-Stack (Innenraum bestimmen)
DIM fstx[GWMAX * GHMAX] AS INTEGER
DIM fsty[GWMAX * GHMAX] AS INTEGER

' Bilder
DIM img_floor AS IMAGE
DIM img_wall AS IMAGE
DIM img_goal AS IMAGE
DIM img_crate AS IMAGE
DIM img_crate_on AS IMAGE
DIM img_hero AS IMAGE
DIM img_chest AS IMAGE
DIM img_chest_open AS IMAGE
DIM img_star AS IMAGE
DIM img_pit AS IMAGE
DIM img_pit_filled AS IMAGE
DIM img_button AS IMAGE
DIM img_door_closed AS IMAGE
DIM img_door_open AS IMAGE
DIM img_ice AS IMAGE
DIM img_title AS IMAGE
DIM has_title AS BOOLEAN
DIM glow AS IMAGE
DIM vig AS IMAGE
DIM lightmask AS IMAGE
DIM dark_mode AS BOOLEAN

' Persistenz
DIM sav AS SAVE_HANDLE
DIM best_unlocked AS INTEGER    ' hoechster erreichter Katalog-Index
DIM dbcon AS DB_CONN            ' Bestenliste (SQLite)

' Zeit + Bestenliste/Statistik
DIM lvl_start_ms AS INTEGER
DIM win_secs AS INTEGER
DIM win_best_secs AS INTEGER
DIM stat_solved AS INTEGER
DIM stat_stars AS INTEGER
DIM stat_perfect AS INTEGER
DIM rec_title[12] AS STRING
DIM rec_secs[12] AS INTEGER
DIM nrec AS INTEGER

' Hinweis-Solver (beschraenkte Push-BFS)
CONST HINT_CAP = 22000
CONST SBMAX = 24               ' Solver nur fuer Level mit <= 24 Kisten
DIM has_special AS BOOLEAN     ' Level nutzt Bonus-Mechaniken -> kein Hinweis
DIM vis AS MAP OF INTEGER
DIM qstate[HINT_CAP] AS STRING
DIM qfb[HINT_CAP] AS INTEGER
DIM qfd[HINT_CAP] AS INTEGER
DIM sbx[SBMAX] AS INTEGER       ' dekodierte Kisten-Zellen (Arbeit)
DIM snb AS INTEGER
DIM g_normp AS INTEGER
DIM nbx[SBMAX] AS INTEGER       ' Kisten nach einem Schub
DIM rmark[GWMAX * GHMAX] AS INTEGER
DIM rstk[GWMAX * GHMAX] AS INTEGER
DIM reach_gen AS INTEGER
DIM hint_active AS BOOLEAN
DIM hint_box AS INTEGER
DIM hint_dx AS INTEGER
DIM hint_dy AS INTEGER
DIM hint_ms AS INTEGER
DIM hint_msg AS STRING
DIM hdx[4] AS INTEGER
DIM hdy[4] AS INTEGER

' Ablauf
DIM state AS STRING             ' "menu" "play" "win" "code" "select"
DIM win_ms AS INTEGER           ' Zeitstempel beim Loesen (fuer Truhen-Animation)
DIM win_best AS INTEGER
DIM win_record AS BOOLEAN

' Code-Schloss
DIM dial[4] AS INTEGER
DIM dialpos AS INTEGER
DIM codemsg AS STRING

' Level-Auswahl (auf ein Kapitel eingegrenzt)
DIM selpos AS INTEGER
DIM sel_lo AS INTEGER
DIM sel_hi AS INTEGER

' Kapitel (fuer die Schatzkarte): zusammenhaengende Bloecke gleichen Sets
DIM chap_first[MAXCHAP] AS INTEGER
DIM chap_count[MAXCHAP] AS INTEGER
DIM chap_name[MAXCHAP] AS STRING
DIM nchap AS INTEGER
DIM cur_chap AS INTEGER
DIM mapx[MAXCHAP] AS INTEGER
DIM mapy[MAXCHAP] AS INTEGER
CONST MAP_COLS = 5

' Ambiente: prozedurale Musik + Staubpartikel
DIM music_on AS BOOLEAN
DIM has_xm AS BOOLEAN
DIM next_note AS INTEGER
DIM note_idx AS INTEGER
DIM scale[7] AS FLOAT           ' "antike" Tonleiter (Phrygisch-dominant auf A)
DIM ps_dust AS PARTICLE_SYSTEM

' ----------------------------------------------------------------------
'  KLEINE HELFER
' ----------------------------------------------------------------------
FUNCTION cidx(x AS INTEGER, y AS INTEGER) AS INTEGER
    RETURN y * GWMAX + x
END FUNCTION

FUNCTION inb(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    RETURN x >= 0 AND y >= 0 AND x < gw AND y < gh
END FUNCTION

FUNCTION tile(x AS INTEGER, y AS INTEGER) AS INTEGER
    IF NOT inb(x, y) THEN RETURN T_VOID
    RETURN smap[cidx(x, y)]
END FUNCTION

FUNCTION is_goal(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    IF NOT inb(x, y) THEN RETURN FALSE
    RETURN goalc[cidx(x, y)] = 1
END FUNCTION

FUNCTION boxat(x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO nbox - 1
        IF box_active[i] AND boxx[i] = x AND boxy[i] = y THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION featf(x AS INTEGER, y AS INTEGER) AS INTEGER
    IF NOT inb(x, y) THEN RETURN F_NONE
    RETURN feat[cidx(x, y)]
END FUNCTION

' Begehbar fuer den Spieler? (Boden, kein offenes Loch, keine geschlossene Tuer)
FUNCTION walkable(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    IF tile(x, y) <> T_FLOOR THEN RETURN FALSE
    DIM ft AS INTEGER
    ft = feat[cidx(x, y)]
    IF ft = F_PIT THEN RETURN FALSE
    IF ft = F_DOOR AND NOT doors_open THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

FUNCTION is_ice(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    RETURN featf(x, y) = F_ICE
END FUNCTION

' Tuerzustand aus den Schaltern neu bestimmen
SUB doors_update()
    IF nbutton = 0 THEN
        doors_open = FALSE
        RETURN
    END IF
    DIM cov AS INTEGER
    cov = 0
    DIM i AS INTEGER
    FOR i = 0 TO nbutton - 1
        IF (px = btnx[i] AND py = btny[i]) OR boxat(btnx[i], btny[i]) >= 0 THEN cov = cov + 1
    NEXT
    doors_open = (cov = nbutton)
END SUB

FUNCTION has_board_char(s AS STRING) AS BOOLEAN
    IF INSTR(s, "#") >= 0 THEN RETURN TRUE
    IF INSTR(s, "$") >= 0 THEN RETURN TRUE
    IF INSTR(s, ".") >= 0 THEN RETURN TRUE
    IF INSTR(s, "@") >= 0 THEN RETURN TRUE
    IF INSTR(s, "*") >= 0 THEN RETURN TRUE
    IF INSTR(s, "+") >= 0 THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

SUB ctext(cx AS INTEGER, y AS INTEGER, s AS STRING, col AS INTEGER)
    DIM w AS INTEGER
    w = TEXT_WIDTH(s)
    TEXT(cx - INT(w / 2), y, s, col)
END SUB

FUNCTION fmt_time(s AS INTEGER) AS STRING
    DIM m AS INTEGER
    DIM r AS INTEGER
    m = s \ 60
    r = s MOD 60
    DIM rs AS STRING
    rs = STR$(r)
    IF r < 10 THEN rs = "0" + rs
    RETURN STR$(m) + ":" + rs
END FUNCTION

' Eindeutiger, aussprechbarer 4-Buchstaben-Code je Katalog-Index.
FUNCTION gencode(idx AS INTEGER) AS STRING
    DIM cons AS STRING
    DIM vow AS STRING
    cons = "BDFGKLMNPRSTVZ"      ' 14
    vow = "AEIOU"                ' 5
    DIM n AS INTEGER
    n = idx
    DIM d0 AS INTEGER
    DIM d1 AS INTEGER
    DIM d2 AS INTEGER
    DIM d3 AS INTEGER
    d0 = n MOD 14 : n = n \ 14
    d1 = n MOD 5  : n = n \ 5
    d2 = n MOD 14 : n = n \ 14
    d3 = n MOD 5
    RETURN MID$(cons, d0, 1) + MID$(vow, d1, 1) + MID$(cons, d2, 1) + MID$(vow, d3, 1)
END FUNCTION

FUNCTION strip_num(s AS STRING) AS STRING
    ' "1. Titel" -> "Titel"
    DIM p AS INTEGER
    p = INSTR(s, ". ")
    IF p < 0 THEN RETURN s
    DIM pre AS STRING
    pre = LEFT$(s, p)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(pre) - 1
        DIM c AS STRING
        c = MID$(pre, i, 1)
        IF c < "0" OR c > "9" THEN RETURN s
    NEXT
    RETURN TRIM$(MID$(s, p + 2))
END FUNCTION

' ----------------------------------------------------------------------
'  LEVEL LADEN
' ----------------------------------------------------------------------
SUB flush_level()
    IF p_h > 0 AND INSTR(p_rows, "#") >= 0 AND ncat < MAXLEV THEN
        cat[ncat].board = p_rows
        cat[ncat].w = p_w
        cat[ncat].h = p_h
        cat[ncat].setname = p_set
        IF LEN(p_title) > 0 THEN
            cat[ncat].title = strip_num(p_title)
        ELSE
            cat[ncat].title = "Kammer " + STR$(ncat + 1)
        END IF
        cat[ncat].code = gencode(ncat)
        ncat = ncat + 1
    END IF
    p_rows = "" : p_w = 0 : p_h = 0 : p_title = ""
END SUB

SUB parse_file(path AS STRING, setname AS STRING)
    DIM lines AS ARRAY OF STRING
    lines = READLINES(path)
    p_rows = "" : p_w = 0 : p_h = 0 : p_title = "" : p_set = setname
    DIM li AS INTEGER
    FOR li = 0 TO LEN(lines) - 1
        DIM raw AS STRING
        raw = lines[li]
        IF LEN(raw) > 0 AND RIGHT$(raw, 1) = CHR$(13) THEN raw = LEFT$(raw, LEN(raw) - 1)
        DIM trimmed AS STRING
        trimmed = TRIM$(raw)
        DIM isComment AS BOOLEAN
        isComment = LEN(trimmed) > 0 AND LEFT$(trimmed, 1) = ";"
        IF (NOT isComment) AND has_board_char(raw) THEN
            p_rows = p_rows + raw + "|"
            IF LEN(raw) > p_w THEN p_w = LEN(raw)
            p_h = p_h + 1
        ELSEIF LEN(trimmed) = 0 THEN
            flush_level()
        ELSE
            ' Kommentar-/Titel-/Metadatenzeile
            flush_level()
            DIM tt AS STRING
            tt = trimmed
            IF isComment THEN tt = TRIM$(MID$(tt, 1))
            IF LEN(tt) > 0 THEN p_title = tt
        END IF
    NEXT
    flush_level()
END SUB

SUB load_catalog()
    ncat = 0
    IF NOT DIREXISTS("levels") THEN RETURN
    DIM files AS ARRAY OF STRING
    files = DIRLIST("levels")
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(files) - 1
        DIM fname AS STRING
        fname = files[fi]
        DIM low AS STRING
        low = LOWER$(fname)
        IF RIGHT$(low, 4) = ".xsb" OR RIGHT$(low, 4) = ".sok" THEN
            parse_file(PATHJOIN("levels", fname), fname)
        END IF
    NEXT
END SUB

FUNCTION titlecase(s AS STRING) AS STRING
    DIM out AS STRING
    out = ""
    DIM cap AS BOOLEAN
    cap = TRUE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(s) - 1
        DIM c AS STRING
        c = MID$(s, i, 1)
        IF cap AND c >= "a" AND c <= "z" THEN c = CHR$(ASC(c) - 32)
        out = out + c
        cap = (c = " ")
    NEXT
    RETURN out
END FUNCTION

FUNCTION chapter_display(key AS STRING) AS STRING
    ' Dateiname-Schluessel -> huebscher Kapitelname; sonst Set-Praefix unveraendert
    IF INSTR(key, ".xsb") >= 0 OR INSTR(key, ".sok") >= 0 THEN
        DIM s AS STRING
        s = key
        DIM d AS INTEGER
        d = INSTR(s, ".")
        IF d >= 0 THEN s = LEFT$(s, d)
        WHILE LEN(s) > 0 AND ((LEFT$(s, 1) >= "0" AND LEFT$(s, 1) <= "9") OR LEFT$(s, 1) = "_")
            s = MID$(s, 1)
        WEND
        RETURN titlecase(REPLACE$(s, "_", " "))
    END IF
    RETURN key
END FUNCTION

' Kapitel = aufeinanderfolgende Level mit gleichem Set-Praefix (Titel vor " / ")
SUB build_chapters()
    nchap = 0
    DIM lastkey AS STRING
    lastkey = CHR$(1)
    DIM i AS INTEGER
    FOR i = 0 TO ncat - 1
        DIM key AS STRING
        DIM p AS INTEGER
        p = INSTR(cat[i].title, " / ")
        IF p >= 0 THEN
            key = LEFT$(cat[i].title, p)
        ELSE
            key = cat[i].setname
        END IF
        IF key <> lastkey THEN
            IF nchap < MAXCHAP THEN
                chap_first[nchap] = i
                chap_count[nchap] = 0
                chap_name[nchap] = chapter_display(key)
                nchap = nchap + 1
            END IF
            lastkey = key
        END IF
        IF nchap > 0 THEN chap_count[nchap - 1] = chap_count[nchap - 1] + 1
    NEXT
END SUB

FUNCTION chap_of(idx AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO nchap - 1
        IF idx >= chap_first[i] AND idx < chap_first[i] + chap_count[i] THEN RETURN i
    NEXT
    RETURN 0
END FUNCTION

FUNCTION chap_solved(c AS INTEGER) AS INTEGER
    DIM n AS INTEGER
    n = 0
    DIM j AS INTEGER
    FOR j = chap_first[c] TO chap_first[c] + chap_count[c] - 1
        IF SAVE_GET_INT_OR(sav, "best_" + cat[j].code, 0) > 0 THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION

' ----------------------------------------------------------------------
'  LEVEL STARTEN  (Daten -> Arbeits-Arrays, Innenraum per Flood-Fill)
' ----------------------------------------------------------------------
SUB start_level(idx AS INTEGER)
    cur = idx
    DIM rows AS ARRAY OF STRING
    rows = SPLIT$(cat[idx].board, "|")
    gw = cat[idx].w
    gh = cat[idx].h
    IF gw > GWMAX THEN gw = GWMAX
    IF gh > GHMAX THEN gh = GHMAX

    DIM i AS INTEGER
    FOR i = 0 TO GWMAX * GHMAX - 1
        smap[i] = T_VOID
        goalc[i] = 0
        feat[i] = F_NONE
    NEXT
    nbox = 0
    ngoal = 0
    nbutton = 0
    ndoor = 0
    doors_open = FALSE
    px = 0 : py = 0

    DIM y AS INTEGER
    DIM x AS INTEGER
    FOR y = 0 TO gh - 1
        DIM row AS STRING
        row = rows[y]
        FOR x = 0 TO LEN(row) - 1
            IF x >= gw THEN BREAK
            DIM c AS STRING
            c = MID$(row, x, 1)
            IF c = "#" THEN
                smap[cidx(x, y)] = T_WALL
            END IF
            IF c = "." OR c = "+" OR c = "*" THEN
                goalc[cidx(x, y)] = 1
                IF ngoal < MAXBOX THEN
                    goalpx[ngoal] = x : goalpy[ngoal] = y
                END IF
                ngoal = ngoal + 1
            END IF
            IF c = "$" OR c = "*" THEN
                IF nbox < MAXBOX THEN
                    boxx[nbox] = x : boxy[nbox] = y : box_active[nbox] = TRUE : nbox = nbox + 1
                END IF
            END IF
            IF c = "@" OR c = "+" THEN
                px = x : py = y
            END IF
            IF c = "H" THEN feat[cidx(x, y)] = F_PIT
            IF c = "I" THEN feat[cidx(x, y)] = F_ICE
            IF c = "B" THEN
                feat[cidx(x, y)] = F_BUTTON
                IF nbutton < MAXBOX THEN btnx[nbutton] = x : btny[nbutton] = y : nbutton = nbutton + 1
            END IF
            IF c = "D" THEN
                feat[cidx(x, y)] = F_DOOR
                ndoor = ndoor + 1
            END IF
        NEXT
    NEXT

    ' Flood-Fill vom Spieler ueber Nicht-Wand -> Innenraum = T_FLOOR
    DIM top AS INTEGER
    top = 0
    fstx[0] = px : fsty[0] = py : top = 1
    smap[cidx(px, py)] = T_FLOOR
    WHILE top > 0
        top = top - 1
        DIM cx AS INTEGER
        DIM cy AS INTEGER
        cx = fstx[top] : cy = fsty[top]
        DIM k AS INTEGER
        FOR k = 0 TO 3
            DIM nx AS INTEGER
            DIM ny AS INTEGER
            nx = cx : ny = cy
            IF k = 0 THEN nx = cx + 1
            IF k = 1 THEN nx = cx - 1
            IF k = 2 THEN ny = cy + 1
            IF k = 3 THEN ny = cy - 1
            IF inb(nx, ny) THEN
                DIM ix AS INTEGER
                ix = cidx(nx, ny)
                IF smap[ix] = T_VOID THEN
                    smap[ix] = T_FLOOR
                    fstx[top] = nx : fsty[top] = ny : top = top + 1
                END IF
            END IF
        NEXT
    WEND

    doors_update()
    has_special = FALSE
    DIM hsx AS INTEGER
    DIM hsy AS INTEGER
    FOR hsy = 0 TO gh - 1
        FOR hsx = 0 TO gw - 1
            IF feat[cidx(hsx, hsy)] <> F_NONE THEN has_special = TRUE
        NEXT
    NEXT
    hint_active = FALSE
    hint_msg = ""

    ' Par (untere Schub-Schranke): je Kiste Manhattan-Distanz zum naechsten Ziel
    par_push = 0
    DIM bi2 AS INTEGER
    FOR bi2 = 0 TO nbox - 1
        DIM best AS INTEGER
        best = 999999
        DIM gj AS INTEGER
        FOR gj = 0 TO ngoal - 1
            DIM dd AS INTEGER
            dd = ABS(boxx[bi2] - goalpx[gj]) + ABS(boxy[bi2] - goalpy[gj])
            IF dd < best THEN best = dd
        NEXT
        par_push = par_push + best
    NEXT

    facing = 0
    moves = 0
    pushes = 0
    utop = 0
    anim_t = 1.0
    anim_box = -1
    cur_pox = 0 : cur_poy = 0
    lvl_start_ms = MILLIS()
    state = "play"
END SUB

FUNCTION rate_stars(p AS INTEGER, lb AS INTEGER) AS INTEGER
    DIM base AS INTEGER
    base = lb
    IF base < 1 THEN base = 1
    IF p * 10 <= base * 16 THEN RETURN 3      ' Verhaeltnis <= 1.6
    IF p * 10 <= base * 26 THEN RETURN 2      ' <= 2.6
    RETURN 1
END FUNCTION

FUNCTION is_solved() AS BOOLEAN
    DIM cov AS INTEGER
    cov = 0
    DIM i AS INTEGER
    FOR i = 0 TO nbox - 1
        IF box_active[i] AND goalc[cidx(boxx[i], boxy[i])] = 1 THEN cov = cov + 1
    NEXT
    RETURN ngoal > 0 AND cov = ngoal
END FUNCTION

' ----------------------------------------------------------------------
'  AUDIO
' ----------------------------------------------------------------------
SUB sfx_step()
    AUDIO_PLAY(AUDIO_TONE(150.0, 35, "sine", 0.10))
END SUB
SUB sfx_push()
    AUDIO_PLAY(AUDIO_SFX("noise", 90.0, -120.0, 1, 40, 70, 0.0, 0.0, 0.22))
END SUB
SUB sfx_place()
    AUDIO_PLAY(AUDIO_TONE(680.0, 110, "sine", 0.30))
END SUB
SUB sfx_blocked()
    AUDIO_PLAY(AUDIO_TONE(90.0, 60, "square", 0.16))
END SUB
SUB sfx_win()
    AUDIO_PLAY(AUDIO_SFX("square", 440.0, 520.0, 4, 140, 220, 4.0, 4.0, 0.30))
    AUDIO_PLAY(AUDIO_TONE(880.0, 240, "sine", 0.22))
END SUB

' ----------------------------------------------------------------------
'  SPIELZUG
' ----------------------------------------------------------------------
SUB finish_level()
    state = "win"
    win_ms = MILLIS()
    DIM key AS STRING
    key = "best_" + cat[cur].code
    DIM prev AS INTEGER
    prev = SAVE_GET_INT_OR(sav, key, 0)
    win_record = FALSE
    IF prev = 0 OR moves < prev THEN
        SAVE_SET_INT(sav, key, moves)
        win_best = moves
        IF prev > 0 THEN win_record = TRUE
    ELSE
        win_best = prev
    END IF
    ' Sterne aus Schub-Effizienz; bestes Ergebnis behalten
    win_stars = rate_stars(pushes, par_push)
    DIM skey AS STRING
    skey = "stars_" + cat[cur].code
    IF win_stars > SAVE_GET_INT_OR(sav, skey, 0) THEN SAVE_SET_INT(sav, skey, win_stars)

    ' Zeit messen, Bestzeit + Bestenliste (db) fuehren
    win_secs = (MILLIS() - lvl_start_ms) \ 1000
    DIM tkey AS STRING
    tkey = "time_" + cat[cur].code
    win_best_secs = SAVE_GET_INT_OR(sav, tkey, 0)
    IF win_best_secs = 0 OR win_secs < win_best_secs THEN
        SAVE_SET_INT(sav, tkey, win_secs)
        win_best_secs = win_secs
    END IF
    DB_EXEC(dbcon, "INSERT INTO solves (code, title, secs, moves, pushes, stars) VALUES (?,?,?,?,?,?)", cat[cur].code, cat[cur].title, win_secs, moves, pushes, win_stars)
    IF cur + 1 > best_unlocked THEN
        best_unlocked = cur + 1
        IF best_unlocked > ncat - 1 THEN best_unlocked = ncat - 1
        SAVE_SET_INT(sav, "unlocked", best_unlocked)
    END IF
    SAVE_WRITE(sav, SAVE_PATH)
    sfx_win()
END SUB

' Prozedurale Ambient-Musik: sparsame, weiche Toene aus einer "antiken"
' Tonleiter + gelegentlicher tiefer Drone. (Nur wenn keine ambient.xm laeuft.)
SUB update_ambient()
    IF NOT music_on OR has_xm THEN RETURN
    DIM nowm AS INTEGER
    nowm = MILLIS()
    IF nowm < next_note THEN RETURN
    DIM f AS FLOAT
    f = scale[note_idx]
    AUDIO_PLAY(AUDIO_TONE(f, 1500, "sine", 0.09))
    IF (note_idx MOD 3) = 0 THEN AUDIO_PLAY(AUDIO_TONE(55.0, 2800, "triangle", 0.06))
    note_idx = (note_idx + RANDINT(1, 3)) MOD 7
    next_note = nowm + RANDINT(2300, 4300)
END SUB

SUB update_dust(dms AS INTEGER)
    PARTICLE_SET_POS(ps_dust, RANDF(0.0, SCR_W), RANDF(VY, SCR_H - 30))
    IF RANDF(0.0, 1.0) < 0.30 THEN PARTICLE_EMIT(ps_dust, 1)
    PARTICLE_UPDATE(ps_dust, dms)
END SUB

SUB do_move(dx AS INTEGER, dy AS INTEGER)
    hint_active = FALSE
    hint_msg = ""
    IF dy > 0 THEN facing = 0
    IF dy < 0 THEN facing = 1
    IF dx > 0 THEN facing = 2
    IF dx < 0 THEN facing = 3

    DIM oldpx AS INTEGER
    DIM oldpy AS INTEGER
    oldpx = px : oldpy = py

    DIM nx AS INTEGER
    DIM ny AS INTEGER
    nx = px + dx : ny = py + dy
    DIM bi AS INTEGER
    bi = boxat(nx, ny)

    IF bi >= 0 THEN
        ' --- Schieben (genau ein Feld, kein Rutschen) ---
        DIM tx AS INTEGER
        DIM ty AS INTEGER
        tx = nx + dx : ty = ny + dy
        IF boxat(tx, ty) >= 0 THEN
            sfx_blocked() : RETURN
        END IF
        DIM filled AS INTEGER
        filled = 0
        IF featf(tx, ty) = F_PIT THEN
            filled = 1
        ELSEIF NOT walkable(tx, ty) THEN
            sfx_blocked() : RETURN
        END IF
        IF utop < UMAX THEN
            u_ppx[utop] = oldpx : u_ppy[utop] = oldpy
            u_mbox[utop] = bi : u_mbx[utop] = nx : u_mby[utop] = ny
            u_fill[utop] = filled : u_pitx[utop] = tx : u_pity[utop] = ty
            utop = utop + 1
        END IF
        IF filled = 1 THEN
            box_active[bi] = FALSE
            feat[cidx(tx, ty)] = F_PITFILLED
            anim_box = -1
        ELSE
            boxx[bi] = tx : boxy[bi] = ty
            anim_box = bi : gbx = -dx * CELL : gby = -dy * CELL
        END IF
        pushes = pushes + 1
        px = nx : py = ny
        moves = moves + 1
        IF filled = 1 OR is_goal(tx, ty) THEN
            sfx_place()
        ELSE
            sfx_push()
        END IF
    ELSE
        ' --- Gehen (auf Eis bis zur Wand weiterrutschen) ---
        IF NOT walkable(nx, ny) THEN
            sfx_blocked() : RETURN
        END IF
        IF utop < UMAX THEN
            u_ppx[utop] = oldpx : u_ppy[utop] = oldpy
            u_mbox[utop] = -1 : u_fill[utop] = 0
            utop = utop + 1
        END IF
        anim_box = -1
        px = nx : py = ny
        moves = moves + 1
        WHILE is_ice(px, py)
            DIM sx AS INTEGER
            DIM sy AS INTEGER
            sx = px + dx : sy = py + dy
            IF walkable(sx, sy) AND boxat(sx, sy) < 0 THEN
                px = sx : py = sy
            ELSE
                BREAK
            END IF
        WEND
        sfx_step()
    END IF

    ' Gleiten: Spieler von alt nach neu (volle Distanz, auch beim Rutschen)
    anim_t = 0.0
    gpx = (oldpx - px) * CELL : gpy = (oldpy - py) * CELL

    doors_update()
    IF is_solved() THEN finish_level()
END SUB

SUB do_undo()
    IF utop = 0 THEN RETURN
    utop = utop - 1
    DIM oldpx AS INTEGER
    DIM oldpy AS INTEGER
    oldpx = px : oldpy = py
    IF u_mbox[utop] >= 0 THEN
        DIM bi AS INTEGER
        bi = u_mbox[utop]
        IF u_fill[utop] = 1 THEN
            box_active[bi] = TRUE
            feat[cidx(u_pitx[utop], u_pity[utop])] = F_PIT
        END IF
        boxx[bi] = u_mbx[utop] : boxy[bi] = u_mby[utop]
        pushes = pushes - 1
        anim_box = bi
        gbx = (u_pitx[utop] - u_mbx[utop]) * CELL
        gby = (u_pity[utop] - u_mby[utop]) * CELL
    ELSE
        anim_box = -1
    END IF
    px = u_ppx[utop] : py = u_ppy[utop]
    moves = moves - 1
    IF py > oldpy THEN facing = 0
    IF py < oldpy THEN facing = 1
    IF px > oldpx THEN facing = 2
    IF px < oldpx THEN facing = 3
    anim_t = 0.0
    gpx = (oldpx - px) * CELL : gpy = (oldpy - py) * CELL
    doors_update()
END SUB

' ======================================================================
'  HINWEIS-SOLVER (beschraenkte Push-BFS; nur Standard-Mechanik)
' ======================================================================
FUNCTION cellx(c AS INTEGER) AS INTEGER
    RETURN c MOD GWMAX
END FUNCTION
FUNCTION celly(c AS INTEGER) AS INTEGER
    RETURN c \ GWMAX
END FUNCTION
FUNCTION pad4(n AS INTEGER) AS STRING
    DIM s AS STRING
    s = STR$(n)
    WHILE LEN(s) < 4
        s = "0" + s
    WEND
    RETURN s
END FUNCTION
FUNCTION freefloor(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    RETURN inb(x, y) AND smap[cidx(x, y)] = T_FLOOR
END FUNCTION
FUNCTION boxat_s(c AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO snb - 1
        IF sbx[i] = c THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION
FUNCTION deadcell(c AS INTEGER) AS BOOLEAN
    IF goalc[c] = 1 THEN RETURN FALSE
    DIM x AS INTEGER
    DIM y AS INTEGER
    x = cellx(c) : y = celly(c)
    DIM up AS BOOLEAN
    DIM dn AS BOOLEAN
    DIM lf AS BOOLEAN
    DIM rt AS BOOLEAN
    up = NOT freefloor(x, y - 1)
    dn = NOT freefloor(x, y + 1)
    lf = NOT freefloor(x - 1, y)
    rt = NOT freefloor(x + 1, y)
    RETURN (up AND lf) OR (up AND rt) OR (dn AND lf) OR (dn AND rt)
END FUNCTION
SUB reach_from(start AS INTEGER)
    reach_gen = reach_gen + 1
    DIM top AS INTEGER
    top = 0
    rstk[0] = start : top = 1
    rmark[start] = reach_gen
    WHILE top > 0
        top = top - 1
        DIM c AS INTEGER
        c = rstk[top]
        DIM cx AS INTEGER
        DIM cy AS INTEGER
        cx = cellx(c) : cy = celly(c)
        DIM k AS INTEGER
        FOR k = 0 TO 3
            DIM nx AS INTEGER
            DIM ny AS INTEGER
            nx = cx + hdx[k] : ny = cy + hdy[k]
            IF freefloor(nx, ny) THEN
                DIM nc AS INTEGER
                nc = cidx(nx, ny)
                IF rmark[nc] <> reach_gen AND boxat_s(nc) < 0 THEN
                    rmark[nc] = reach_gen
                    rstk[top] = nc : top = top + 1
                END IF
            END IF
        NEXT
    WEND
END SUB
FUNCTION is_reach(c AS INTEGER) AS BOOLEAN
    RETURN rmark[c] = reach_gen
END FUNCTION
FUNCTION encode_sbx(pc AS INTEGER) AS STRING
    DIM s AS STRING
    s = ""
    DIM i AS INTEGER
    FOR i = 0 TO snb - 1
        s = s + pad4(sbx[i])
    NEXT
    RETURN s + "." + pad4(pc)
END FUNCTION
FUNCTION encode_nbx(pc AS INTEGER) AS STRING
    DIM i AS INTEGER
    FOR i = 1 TO snb - 1
        DIM v AS INTEGER
        v = nbx[i]
        DIM j AS INTEGER
        j = i - 1
        WHILE j >= 0 AND nbx[j] > v
            nbx[j + 1] = nbx[j] : j = j - 1
        WEND
        nbx[j + 1] = v
    NEXT
    DIM s AS STRING
    s = ""
    FOR i = 0 TO snb - 1
        s = s + pad4(nbx[i])
    NEXT
    RETURN s + "." + pad4(pc)
END FUNCTION
SUB decode_state(s AS STRING)
    snb = 0
    DIM i AS INTEGER
    i = 0
    WHILE MID$(s, i, 1) <> "."
        sbx[snb] = VAL(MID$(s, i, 4))
        snb = snb + 1
        i = i + 4
    WEND
    g_normp = VAL(MID$(s, i + 1, 4))
END SUB
FUNCTION allgoal_nbx() AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO snb - 1
        IF goalc[nbx[i]] = 0 THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION
SUB sort_sbx()
    DIM i AS INTEGER
    FOR i = 1 TO snb - 1
        DIM v AS INTEGER
        v = sbx[i]
        DIM j AS INTEGER
        j = i - 1
        WHILE j >= 0 AND sbx[j] > v
            sbx[j + 1] = sbx[j] : j = j - 1
        WEND
        sbx[j + 1] = v
    NEXT
END SUB
SUB apply_hint(boxcell AS INTEGER, dir AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO nbox - 1
        IF box_active[i] AND cidx(boxx[i], boxy[i]) = boxcell THEN hint_box = i
    NEXT
    hint_dx = hdx[dir] : hint_dy = hdy[dir]
    hint_active = TRUE
    hint_ms = MILLIS()
END SUB
SUB find_hint()
    hint_active = FALSE
    hint_msg = ""
    hint_ms = MILLIS()
    IF has_special THEN
        hint_msg = "Hier kein Hinweis (Bonus-Mechanik)"
        RETURN
    END IF
    snb = 0
    DIM i AS INTEGER
    FOR i = 0 TO nbox - 1
        IF box_active[i] THEN
            IF snb >= SBMAX THEN
                hint_msg = "Zu viele Kisten fuer Hinweis"
                RETURN
            END IF
            sbx[snb] = cidx(boxx[i], boxy[i]) : snb = snb + 1
        END IF
    NEXT
    sort_sbx()
    MAPCLEAR(vis)
    DIM startkey AS STRING
    startkey = encode_sbx(cidx(px, py))
    MAPPUT(vis, startkey, 1)
    DIM qh AS INTEGER
    DIM qt AS INTEGER
    qstate[0] = startkey : qfb[0] = -1 : qfd[0] = -1 : qh = 0 : qt = 1
    DIM cnt AS INTEGER
    cnt = 0
    WHILE qh < qt AND cnt < HINT_CAP
        DIM st AS STRING
        st = qstate[qh]
        DIM fb AS INTEGER
        DIM fd AS INTEGER
        fb = qfb[qh] : fd = qfd[qh]
        qh = qh + 1
        cnt = cnt + 1
        decode_state(st)
        reach_from(g_normp)
        DIM bi AS INTEGER
        FOR bi = 0 TO snb - 1
            DIM bc AS INTEGER
            bc = sbx[bi]
            DIM bx AS INTEGER
            DIM by AS INTEGER
            bx = cellx(bc) : by = celly(bc)
            DIM dir AS INTEGER
            FOR dir = 0 TO 3
                DIM tx AS INTEGER
                DIM ty AS INTEGER
                DIM psx AS INTEGER
                DIM psy AS INTEGER
                tx = bx + hdx[dir] : ty = by + hdy[dir]
                psx = bx - hdx[dir] : psy = by - hdy[dir]
                IF freefloor(tx, ty) AND boxat_s(cidx(tx, ty)) < 0 AND inb(psx, psy) THEN
                    IF is_reach(cidx(psx, psy)) THEN
                        DIM tc AS INTEGER
                        tc = cidx(tx, ty)
                        IF NOT deadcell(tc) THEN
                            DIM j AS INTEGER
                            FOR j = 0 TO snb - 1
                                nbx[j] = sbx[j]
                            NEXT
                            nbx[bi] = tc
                            DIM ffb AS INTEGER
                            DIM ffd AS INTEGER
                            ffb = fb : ffd = fd
                            IF fb < 0 THEN ffb = bc : ffd = dir
                            IF allgoal_nbx() THEN
                                apply_hint(ffb, ffd)
                                RETURN
                            END IF
                            DIM nk AS STRING
                            nk = encode_nbx(bc)
                            IF NOT MAPHAS(vis, nk) THEN
                                MAPPUT(vis, nk, 1)
                                IF qt < HINT_CAP THEN
                                    qstate[qt] = nk : qfb[qt] = ffb : qfd[qt] = ffd : qt = qt + 1
                                END IF
                            END IF
                        END IF
                    END IF
                END IF
            NEXT
        NEXT
    WEND
    hint_msg = "Kein Hinweis gefunden"
END SUB

' ----------------------------------------------------------------------
'  RENDERN  --  Spielfeld
' ----------------------------------------------------------------------
DIM ox AS INTEGER
DIM oy AS INTEGER

SUB compute_origin()
    DIM bw AS INTEGER
    DIM bh AS INTEGER
    bw = gw * CELL
    bh = gh * CELL
    IF bw <= VW THEN
        ox = VX + INT((VW - bw) / 2)
    ELSE
        DIM camx AS INTEGER
        camx = px * CELL + INT(CELL / 2) - INT(VW / 2)
        IF camx < 0 THEN camx = 0
        IF camx > bw - VW THEN camx = bw - VW
        ox = VX - camx
    END IF
    IF bh <= VH THEN
        oy = VY + INT((VH - bh) / 2)
    ELSE
        DIM camy AS INTEGER
        camy = py * CELL + INT(CELL / 2) - INT(VH / 2)
        IF camy < 0 THEN camy = 0
        IF camy > bh - VH THEN camy = bh - VH
        oy = VY - camy
    END IF
END SUB

SUB draw_board()
    compute_origin()
    ' Gleit-Animation fortschreiben (ease-out), aktuellen Offset-Faktor bestimmen
    IF anim_t < 1.0 THEN
        anim_t = anim_t + DELTA() / ANIM_DUR
        IF anim_t > 1.0 THEN anim_t = 1.0
    END IF
    DIM ease AS FLOAT
    ease = 1.0 - (1.0 - anim_t) * (1.0 - anim_t)     ' ease-out quad
    DIM af AS FLOAT
    af = 1.0 - ease                                  ' Start-Offset -> 0
    cur_pox = INT(gpx * af) : cur_poy = INT(gpy * af)
    DIM bxoff AS INTEGER
    DIM byoff AS INTEGER
    bxoff = INT(gbx * af) : byoff = INT(gby * af)
    DIM y AS INTEGER
    DIM x AS INTEGER
    FOR y = 0 TO gh - 1
        FOR x = 0 TO gw - 1
            DIM t AS INTEGER
            t = smap[cidx(x, y)]
            DIM sx AS INTEGER
            DIM sy AS INTEGER
            sx = ox + x * CELL : sy = oy + y * CELL
            IF sx < -CELL OR sx > SCR_W OR sy < VY - CELL OR sy > SCR_H THEN
                ' off-screen -> skip
            ELSE
                IF t = T_FLOOR THEN
                    DIM ft AS INTEGER
                    ft = feat[cidx(x, y)]
                    IF ft = F_PIT THEN
                        DRAWIMAGE(img_pit, sx, sy)
                    ELSEIF ft = F_PITFILLED THEN
                        DRAWIMAGE(img_pit_filled, sx, sy)
                    ELSEIF ft = F_ICE THEN
                        DRAWIMAGE(img_ice, sx, sy)
                    ELSEIF ft = F_BUTTON THEN
                        DRAWIMAGE(img_button, sx, sy)
                    ELSEIF ft = F_DOOR THEN
                        IF doors_open THEN
                            DRAWIMAGE(img_door_open, sx, sy)
                        ELSE
                            DRAWIMAGE(img_door_closed, sx, sy)
                        END IF
                    ELSE
                        DRAWIMAGE(img_floor, sx, sy)
                        IF goalc[cidx(x, y)] = 1 THEN DRAWIMAGE(img_goal, sx, sy)
                    END IF
                ELSEIF t = T_WALL THEN
                    DRAWIMAGE(img_wall, sx, sy)
                END IF
            END IF
        NEXT
    NEXT
    ' Kisten
    DIM i AS INTEGER
    FOR i = 0 TO nbox - 1
        IF box_active[i] THEN
            DIM bx AS INTEGER
            DIM by AS INTEGER
            bx = ox + boxx[i] * CELL : by = oy + boxy[i] * CELL
            IF i = anim_box THEN
                bx = bx + bxoff : by = by + byoff
            END IF
            IF is_goal(boxx[i], boxy[i]) THEN
                DRAWIMAGE(img_crate_on, bx, by)
            ELSE
                DRAWIMAGE(img_crate, bx, by)
            END IF
        END IF
    NEXT
    ' Held (mit Gleit-Offset)
    DIM hx AS INTEGER
    DIM hy AS INTEGER
    hx = ox + px * CELL + cur_pox : hy = oy + py * CELL + cur_poy
    DIM frame AS INTEGER
    frame = moves MOD 2
    DRAWIMAGEPART(img_hero, frame * 32, facing * 32, 32, 32, hx, hy)
    ' Staub schwebt ueber dem Feld (vor der Beleuchtung -> im Dunkeln nur am Licht)
    PARTICLE_DRAW(ps_dust)
    ' Hinweis: markierte Kiste + Pfeil in Schubrichtung
    IF hint_active AND hint_box >= 0 AND hint_box < nbox THEN
        IF MILLIS() - hint_ms > 5000 THEN
            hint_active = FALSE
        ELSE
            DIM hbx AS INTEGER
            DIM hby AS INTEGER
            hbx = ox + boxx[hint_box] * CELL : hby = oy + boxy[hint_box] * CELL
            DIM pf AS FLOAT
            pf = 0.5 + 0.5 * SIN(MILLIS() * 0.012)
            DIM hc AS INTEGER
            hc = RGB(120 + INT(135 * pf), 230, 70)
            RECT(hbx, hby, hbx + CELL - 1, hby + CELL - 1, hc)
            RECT(hbx + 1, hby + 1, hbx + CELL - 2, hby + CELL - 2, hc)
            DIM acx AS INTEGER
            DIM acy AS INTEGER
            acx = hbx + 16 + hint_dx * 24 : acy = hby + 16 + hint_dy * 24
            LINEW(hbx + 16, hby + 16, acx, acy, 3, &H88FF50)
            CIRCLE(acx, acy, 5, &H88FF50)
        END IF
    END IF
END SUB

SUB draw_lighting()
    ' Vignette (multiplikativ -> Raender abdunkeln, Mitte hell)
    BLEND_MODE("mult")
    DRAWIMAGE(vig, 0, 0)
    BLEND_MODE("alpha")
    ' Fackelschein am Helden (additiv, leicht flackernd)
    DIM hx AS INTEGER
    DIM hy AS INTEGER
    hx = ox + px * CELL + 16 + cur_pox : hy = oy + py * CELL + 16 + cur_poy
    ' Im hellen Modus statischer, ruhiger Schein (kein Flackern -> stoert sonst)
    DIM fl AS FLOAT
    fl = 0.9
    BLEND_MODE("add")
    DIM b1 AS INTEGER
    b1 = INT(55 * fl)
    DRAWIMAGEROT(glow, hx, hy, 0.0, 2.2 * fl, RGB(b1, INT(b1 * 0.6), INT(b1 * 0.28)))
    DIM b2 AS INTEGER
    b2 = INT(95 * fl)
    DRAWIMAGEROT(glow, hx, hy, 0.0, 1.0 * fl, RGB(b2, INT(b2 * 0.62), INT(b2 * 0.3)))
    BLEND_MODE("alpha")
END SUB

SUB draw_dark_lighting()
    DIM hx AS INTEGER
    DIM hy AS INTEGER
    hx = ox + px * CELL + 16 + cur_pox : hy = oy + py * CELL + 16 + cur_poy
    DIM fl AS FLOAT
    fl = 0.86 + 0.10 * SIN(MILLIS() * 0.013) + 0.05 * SIN(MILLIS() * 0.029)
    ' 1) Lichtmaske multiplikativ: alles ausser dem Fackelkreis wird fast schwarz
    BLEND_MODE("mult")
    DRAWIMAGEROT(lightmask, hx, hy, 0.0, MASK_SCALE * (0.95 + 0.06 * fl), &HFFFFFF)
    BLEND_MODE("alpha")
    ' 2) warmer Fackelschein additiv obendrauf
    BLEND_MODE("add")
    DIM b AS INTEGER
    b = INT(80 * fl)
    DRAWIMAGEROT(glow, hx, hy, 0.0, 2.0 * fl, RGB(b, INT(b * 0.55), INT(b * 0.24)))
    ' 3) Zielfelder schimmern schwach tuerkis durch die Dunkelheit (fair bleiben)
    DIM y AS INTEGER
    DIM x AS INTEGER
    FOR y = 0 TO gh - 1
        FOR x = 0 TO gw - 1
            IF goalc[cidx(x, y)] = 1 THEN
                DIM gx AS INTEGER
                DIM gy AS INTEGER
                gx = ox + x * CELL + 16 : gy = oy + y * CELL + 16
                DIM pu AS FLOAT
                pu = 0.45 + 0.30 * SIN(MILLIS() * 0.004 + x + y)
                DRAWIMAGEROT(glow, gx, gy, 0.0, 0.55 * pu, RGB(8, INT(40 * pu), INT(34 * pu)))
            END IF
        NEXT
    NEXT
    BLEND_MODE("alpha")
END SUB

SUB draw_hud()
    BOX(0, 0, SCR_W, 64, &H241A10)
    BOX(0, 64, SCR_W, 66, &H4A3018)
    TEXT(16, 12, "PYRAMID PUSHER", &HF5C542)
    TEXT(16, 38, cat[cur].setname + "  -  " + cat[cur].title, &HC8A878)
    DIM info AS STRING
    info = f"Kammer {cur + 1}/{ncat}    " + fmt_time((MILLIS() - lvl_start_ms) \ 1000) + f"    Zuege {moves}    Schuebe {pushes}"
    DIM bestv AS INTEGER
    bestv = SAVE_GET_INT_OR(sav, "best_" + cat[cur].code, 0)
    IF bestv > 0 THEN info = info + f"    Best {bestv}"
    TEXT(SCR_W - TEXT_WIDTH(info) - 16, 12, info, &HE8C88A)
    TEXT(SCR_W - TEXT_WIDTH("Code " + cat[cur].code) - 16, 38, "Code " + cat[cur].code, &H6E5030)
    ' Hinweis-Meldung (z.B. "kein Hinweis") kurz einblenden
    IF LEN(hint_msg) > 0 AND MILLIS() - hint_ms < 3000 THEN
        ctext(SCR_W \ 2, SCR_H - 46, hint_msg, &HE0C060)
    END IF
    ' Fusszeile
    BOX(0, SCR_H - 26, SCR_W, SCR_H, &H241A10)
    DIM fk AS STRING
    IF dark_mode THEN
        fk = "F:Fackel"
    ELSE
        fk = "F:Fackel-aus"
    END IF
    DIM mk AS STRING
    IF music_on THEN
        mk = "M:Musik"
    ELSE
        mk = "M:still"
    END IF
    ctext(SCR_W \ 2, SCR_H - 20, "Pfeile/WASD . U zurueck . R neu . H Hinweis . " + fk + " . " + mk + " . L Karte . ESC", &H9A8060)
END SUB

' ----------------------------------------------------------------------
'  RENDERN  --  Menue / Sieg / Code / Auswahl
' ----------------------------------------------------------------------
SUB draw_menu()
    IF has_title THEN
        DRAWIMAGE(img_title, 0, 0)
    ELSE
        CLS(&H2A1E12)
    END IF
    ' abdunkelnder Streifen unten fuer Text
    BLEND_MODE("mult")
    DRAWIMAGE(vig, 0, 0)
    BLEND_MODE("alpha")

    ctext(SCR_W \ 2, 360, f"Geloeste Kammern: {best_unlocked} / {ncat}", &HE8C88A)

    DIM blink AS INTEGER
    blink = (MILLIS() \ 500) MOD 2
    IF blink = 0 THEN
        ctext(SCR_W \ 2, 410, "[ LEERTASTE ]  Kammer betreten", &HF5C542)
    END IF
    ctext(SCR_W \ 2, 452, "L  Schatzkarte    C  Code-Schloss    T  Bestenliste", &HD2A860)
    ctext(SCR_W \ 2, 482, "ESC  beenden", &H9A8060)
    ctext(SCR_W \ 2, 560, "RUECKTASTE  Fortschritt loeschen (mit Bestaetigung)", &H7A6048)
END SUB

SUB draw_stars(cx AS INTEGER, y AS INTEGER, count AS INTEGER, scale AS FLOAT, gap AS INTEGER)
    DIM s AS INTEGER
    FOR s = 0 TO 2
        DIM sx AS INTEGER
        sx = cx - gap + s * gap
        DIM tnt AS INTEGER
        IF s < count THEN
            tnt = &HFFD24A
        ELSE
            tnt = &H4A3A28
        END IF
        DRAWIMAGEROT(img_star, sx, y, 0.0, scale, tnt)
    NEXT
END SUB

SUB draw_win()
    ' geloestes Feld gedimmt im Hintergrund
    draw_board()
    BLEND_MODE("mult")
    DRAWIMAGE(vig, 0, 0)
    BLEND_MODE("alpha")
    BOX(0, 0, SCR_W, SCR_H, RGBA(18, 12, 8, 205))

    DIM dt AS INTEGER
    dt = MILLIS() - win_ms
    DIM cxp AS INTEGER
    DIM cyp AS INTEGER
    cxp = SCR_W \ 2
    cyp = 250

    ' goldener Schein
    DIM pulse AS FLOAT
    pulse = 2.6 + 0.5 * SIN(MILLIS() * 0.006)
    BLEND_MODE("add")
    DRAWIMAGEROT(glow, cxp, cyp + 10, 0.0, pulse, RGB(150, 110, 40))
    BLEND_MODE("alpha")

    ' Truhe: erst zu, nach 350ms offen
    IF dt < 350 THEN
        DRAWIMAGEROT(img_chest, cxp, cyp, 0.0, 2.4, &HFFFFFF)
    ELSE
        DRAWIMAGEROT(img_chest_open, cxp, cyp, 0.0, 2.6, &HFFFFFF)
    END IF

    ' aufsteigende Funken
    BLEND_MODE("add")
    DIM s AS INTEGER
    FOR s = 0 TO 11
        DIM ph AS INTEGER
        ph = (MILLIS() + s * 270) MOD 1400
        DIM fy AS INTEGER
        fy = cyp - INT(ph * 0.06)
        DIM fx AS INTEGER
        fx = cxp - 60 + ((s * 53) MOD 120) + INT(8 * SIN((MILLIS() * 0.01) + s))
        DIM br AS INTEGER
        br = 255 - INT(ph * 0.15)
        IF br < 0 THEN br = 0
        CIRCLE(fx, fy, 2, RGB(br, INT(br * 0.8), INT(br * 0.3)))
    NEXT
    BLEND_MODE("alpha")

    ctext(cxp, 70, "KAMMER GELOEST!", &HF5C542)
    draw_stars(cxp, 122, win_stars, 1.7, 46)
    ctext(cxp, 360, cat[cur].title, &HE8C88A)
    ctext(cxp, 398, f"Zuege {moves}    Schuebe {pushes}    Best {win_best}", &HD2A860)
    ctext(cxp, 424, "Zeit " + fmt_time(win_secs) + "    Bestzeit " + fmt_time(win_best_secs), &HD2A860)
    IF win_record THEN ctext(cxp, 448, "** NEUER REKORD! **", &H78E0D0)

    ctext(cxp, 478, "Code zur naechsten Kammer:", &H9A8060)
    DIM nextcode AS STRING
    IF cur + 1 < ncat THEN
        nextcode = cat[cur + 1].code
    ELSE
        nextcode = "----"
    END IF
    ctext(cxp, 500, nextcode, &HFFE060)

    DIM blink AS INTEGER
    blink = (MILLIS() \ 500) MOD 2
    IF blink = 0 THEN
        IF cur + 1 < ncat THEN
            ctext(cxp, 556, "[ LEERTASTE ]  naechste Kammer    .    ESC  Menue", &HF5C542)
        ELSE
            ctext(cxp, 556, "Alle Kammern geschafft!   ESC  Menue", &HF5C542)
        END IF
    END IF
END SUB

SUB draw_code()
    CLS(&H2A1E12)
    BLEND_MODE("mult")
    DRAWIMAGE(vig, 0, 0)
    BLEND_MODE("alpha")
    ctext(SCR_W \ 2, 120, "CODE-SCHLOSS", &HF5C542)
    ctext(SCR_W \ 2, 160, "Hoch/Runter dreht . Links/Rechts waehlt . LEER bestaetigt", &H9A8060)

    DIM i AS INTEGER
    DIM startx AS INTEGER
    startx = SCR_W \ 2 - 2 * 90
    FOR i = 0 TO 3
        DIM dx AS INTEGER
        dx = startx + i * 90
        DIM col AS INTEGER
        col = &H4A3018
        IF i = dialpos THEN col = &H7A5020
        BOX(dx, 250, dx + 70, 340, col)
        RECT(dx, 250, dx + 70, 340, &HF5C542)
        DIM ch AS STRING
        ch = CHR$(65 + dial[i])
        ctext(dx + 35, 278, ch, &HFFE060)
        ' kleine Pfeile
        ctext(dx + 35, 230, "^", &HD2A860)
        ctext(dx + 35, 344, "v", &HD2A860)
    NEXT

    IF LEN(codemsg) > 0 THEN ctext(SCR_W \ 2, 400, codemsg, &HE08060)
    ctext(SCR_W \ 2, 470, "ESC  zurueck", &H9A8060)
END SUB

CONST SEL_COLS = 14

' Statistik berechnen (aus Save) + schnellste Loesungen abfragen (db)
SUB compute_stats()
    stat_solved = 0 : stat_stars = 0 : stat_perfect = 0
    DIM i AS INTEGER
    FOR i = 0 TO ncat - 1
        IF SAVE_GET_INT_OR(sav, "best_" + cat[i].code, 0) > 0 THEN stat_solved = stat_solved + 1
        DIM st AS INTEGER
        st = SAVE_GET_INT_OR(sav, "stars_" + cat[i].code, 0)
        stat_stars = stat_stars + st
        IF st >= 3 THEN stat_perfect = stat_perfect + 1
    NEXT
    nrec = 0
    DIM r AS DB_RESULT
    r = DB_QUERY(dbcon, "SELECT title, MIN(secs) FROM solves GROUP BY code ORDER BY MIN(secs) ASC LIMIT 12")
    WHILE DB_NEXT(r)
        rec_title[nrec] = DB_GET_STRING(r, 0)
        rec_secs[nrec] = DB_GET_INT(r, 1)
        nrec = nrec + 1
    WEND
    DB_CLOSE_RESULT(r)
END SUB

SUB draw_stats()
    CLS(&H2A1E12)
    BLEND_MODE("mult")
    DRAWIMAGE(vig, 0, 0)
    BLEND_MODE("alpha")
    ctext(SCR_W \ 2, 22, "BESTENLISTE & STATISTIK", &HF5C542)
    ctext(SCR_W \ 2, 58, f"Geloest {stat_solved}/{ncat}    Sterne {stat_stars}/{ncat * 3}    Perfekt {stat_perfect}", &HE8C88A)
    ctext(SCR_W \ 2, 92, "-- Schnellste Loesungen --", &HD2A860)
    DIM colx AS INTEGER
    colx = SCR_W \ 2 - 250
    DIM i AS INTEGER
    FOR i = 0 TO nrec - 1
        DIM yy AS INTEGER
        yy = 122 + i * 30
        DIM rc AS INTEGER
        rc = &HC8A878
        IF i = 0 THEN rc = &HFFE060
        TEXT(colx, yy, STR$(i + 1) + ".", rc)
        TEXT(colx + 42, yy, rec_title[i], rc)
        TEXT(colx + 452, yy, fmt_time(rec_secs[i]), rc)
    NEXT
    IF nrec = 0 THEN ctext(SCR_W \ 2, 220, "Noch keine Loesung - los geht's!", &H9A8060)
    ctext(SCR_W \ 2, SCR_H - 22, "ESC zurueck", &H9A8060)
END SUB

SUB draw_resetconfirm()
    CLS(&H2A1E12)
    BLEND_MODE("mult")
    DRAWIMAGE(vig, 0, 0)
    BLEND_MODE("alpha")
    ctext(SCR_W \ 2, 220, "FORTSCHRITT LOESCHEN?", &HF5C542)
    ctext(SCR_W \ 2, 268, "Alle geloesten Kammern, Sterne und Bestzeiten", &HD2A860)
    ctext(SCR_W \ 2, 296, "gehen dabei unwiderruflich verloren.", &HD2A860)
    DIM blink AS INTEGER
    blink = (MILLIS() \ 500) MOD 2
    IF blink = 0 THEN
        ctext(SCR_W \ 2, 360, "[ LEERTASTE ]  Ja, Fortschritt loeschen", &HE55A5A)
    END IF
    ctext(SCR_W \ 2, 400, "ESC  Abbrechen", &H9A8060)
END SUB

SUB reset_progress()
    ' Kompletten Save verwerfen (SAVE_NEW() -> leerer Handle) und sofort
    ' als leere Datei schreiben -- danach ist "unlocked" wieder 0 und keine
    ' "best_"/"stars_"/"time_"-Eintraege existieren mehr, exakt wie bei
    ' einem allerersten Programmstart ohne Save-Datei.
    sav = SAVE_NEW()
    best_unlocked = 0
    SAVE_SET_INT(sav, "unlocked", 0)
    SAVE_WRITE(sav, SAVE_PATH)
END SUB

' Knoten-Positionen der Schatzkarte (Schlangenlinie = gewundener Pfad)
SUB layout_map()
    DIM marginx AS INTEGER
    marginx = 130
    DIM span AS INTEGER
    span = SCR_W - 2 * marginx
    DIM topy AS INTEGER
    topy = 140
    DIM rowh AS INTEGER
    rowh = 86
    DIM i AS INTEGER
    FOR i = 0 TO nchap - 1
        DIM row AS INTEGER
        DIM col AS INTEGER
        row = i \ MAP_COLS
        col = i MOD MAP_COLS
        IF (row MOD 2) = 1 THEN col = MAP_COLS - 1 - col
        mapx[i] = marginx + INT(col * span / (MAP_COLS - 1))
        mapy[i] = topy + row * rowh
    NEXT
END SUB

SUB draw_map()
    IF has_title THEN
        DRAWIMAGE(img_title, 0, 0)
    ELSE
        CLS(&H2A1E12)
    END IF
    BLEND_MODE("mult")
    DRAWIMAGE(vig, 0, 0)
    BLEND_MODE("alpha")
    BOX(0, 0, SCR_W, SCR_H, RGBA(22, 15, 9, 150))
    ctext(SCR_W \ 2, 22, "SCHATZKARTE", &HF5C542)

    DIM i AS INTEGER
    FOR i = 0 TO nchap - 2
        DIM s AS INTEGER
        FOR s = 0 TO 14
            IF (s MOD 2) = 0 THEN
                DIM lx AS INTEGER
                DIM ly AS INTEGER
                lx = mapx[i] + (mapx[i + 1] - mapx[i]) * s \ 14
                ly = mapy[i] + (mapy[i + 1] - mapy[i]) * s \ 14
                CIRCLE(lx, ly, 2, &H8A6A40)
            END IF
        NEXT
    NEXT

    FOR i = 0 TO nchap - 1
        DIM nx AS INTEGER
        DIM ny AS INTEGER
        nx = mapx[i] : ny = mapy[i]
        DIM unlocked AS BOOLEAN
        unlocked = chap_first[i] <= best_unlocked
        DIM solvedn AS INTEGER
        solvedn = chap_solved(i)
        DIM col AS INTEGER
        col = &H4A3A28
        IF unlocked THEN col = &HC89030
        IF unlocked AND solvedn >= chap_count[i] THEN col = &HF5C542
        IF i = cur_chap THEN
            DIM rr AS INTEGER
            rr = 19 + INT(2.0 * SIN(MILLIS() * 0.006))
            CIRCLE(nx, ny, rr, &HFFE060)
        END IF
        CIRCLE(nx, ny, 15, &H241A10)
        CIRCLE(nx, ny, 12, col)
        IF unlocked AND solvedn >= chap_count[i] THEN
            DRAWIMAGEROT(img_star, nx, ny - 24, 0.0, 0.7, &HFFE060)
        END IF
        DIM nlab AS STRING
        nlab = STR$(i + 1)
        IF NOT unlocked THEN nlab = "?"
        ctext(nx, ny - 7, nlab, &H241A10)
    NEXT

    ctext(SCR_W \ 2, SCR_H - 74, chap_name[cur_chap], &HFFE060)
    IF chap_first[cur_chap] <= best_unlocked THEN
        ctext(SCR_W \ 2, SCR_H - 48, f"{chap_solved(cur_chap)}/{chap_count[cur_chap]} Kammern geloest", &HD2A860)
        ctext(SCR_W \ 2, SCR_H - 22, "Pfeile waehlen . LEER oeffnen . ESC Menue", &H9A8060)
    ELSE
        ctext(SCR_W \ 2, SCR_H - 48, "Noch gesperrt - loese vorige Kapitel", &H9A8060)
        ctext(SCR_W \ 2, SCR_H - 22, "Pfeile waehlen . ESC Menue", &H9A8060)
    END IF
END SUB

SUB draw_select()
    CLS(&H2A1E12)
    ctext(SCR_W \ 2, 18, chap_name[cur_chap], &HF5C542)
    ctext(SCR_W \ 2, 44, "Pfeile waehlen . LEER betreten . ESC zur Karte", &H9A8060)
    DIM cw AS INTEGER
    DIM chh AS INTEGER
    cw = 64 : chh = 44
    DIM count AS INTEGER
    count = sel_hi - sel_lo
    DIM startx AS INTEGER
    DIM topy AS INTEGER
    startx = SCR_W \ 2 - INT(SEL_COLS * cw / 2)
    topy = 76
    DIM visrows AS INTEGER
    visrows = (SCR_H - topy - 64) \ chh
    DIM totalrows AS INTEGER
    totalrows = (count + SEL_COLS - 1) \ SEL_COLS
    DIM selrow AS INTEGER
    selrow = (selpos - sel_lo) \ SEL_COLS
    DIM startrow AS INTEGER
    startrow = 0
    IF selrow >= visrows THEN startrow = selrow - visrows + 1
    IF startrow > totalrows - visrows THEN startrow = totalrows - visrows
    IF startrow < 0 THEN startrow = 0

    DIM i AS INTEGER
    FOR i = sel_lo TO sel_hi - 1
        DIM k AS INTEGER
        k = i - sel_lo
        DIM rrow AS INTEGER
        rrow = k \ SEL_COLS
        IF rrow >= startrow AND rrow < startrow + visrows THEN
            DIM gx AS INTEGER
            DIM gy AS INTEGER
            gx = startx + (k MOD SEL_COLS) * cw
            gy = topy + (rrow - startrow) * chh
            DIM solved AS BOOLEAN
            DIM unlocked AS BOOLEAN
            solved = SAVE_GET_INT_OR(sav, "best_" + cat[i].code, 0) > 0
            unlocked = i <= best_unlocked
            DIM bg AS INTEGER
            bg = &H30221400
            IF unlocked THEN bg = &H4A3018
            IF solved THEN bg = &H8A6010
            BOX(gx + 3, gy + 3, gx + cw - 3, gy + chh - 3, bg)
            IF i = selpos THEN RECT(gx + 1, gy + 1, gx + cw - 1, gy + chh - 1, &HFFE060)
            DIM lab AS STRING
            lab = STR$(k + 1)
            IF NOT unlocked THEN lab = "?"
            DIM tcol AS INTEGER
            tcol = &HD2A860
            IF solved THEN tcol = &HFFF0C0
            ctext(gx + cw \ 2, gy + 8, lab, tcol)
            IF solved THEN
                draw_stars(gx + cw \ 2, gy + 30, SAVE_GET_INT_OR(sav, "stars_" + cat[i].code, 0), 0.5, 12)
            END IF
        END IF
    NEXT
    IF startrow > 0 THEN ctext(SCR_W \ 2, topy - 14, "^ ^ ^", &H9A8060)
    IF startrow + visrows < totalrows THEN ctext(SCR_W \ 2, topy + visrows * chh + 2, "v v v", &H9A8060)
    IF unlocked_idx(selpos) THEN
        ctext(SCR_W \ 2, SCR_H - 38, f"Kammer {selpos - sel_lo + 1}/{count}   (Code {cat[selpos].code})", &HE8C88A)
    ELSE
        ctext(SCR_W \ 2, SCR_H - 38, "Gesperrt - Code-Schloss (C) oder vorige Kammern loesen", &H9A8060)
    END IF
END SUB

FUNCTION unlocked_idx(i AS INTEGER) AS BOOLEAN
    RETURN i <= best_unlocked
END FUNCTION

' ----------------------------------------------------------------------
'  CODE-EINGABE: pruefen
' ----------------------------------------------------------------------
SUB try_code()
    DIM s AS STRING
    s = CHR$(65 + dial[0]) + CHR$(65 + dial[1]) + CHR$(65 + dial[2]) + CHR$(65 + dial[3])
    DIM i AS INTEGER
    FOR i = 0 TO ncat - 1
        IF UPPER$(cat[i].code) = s THEN
            start_level(i)
            RETURN
        END IF
    NEXT
    codemsg = s + " passt zu keiner Kammer"
END SUB

' ----------------------------------------------------------------------
'  EIN FRAME (logisch 960x600) — gemeinsam fuer Fenster + Vollbild
' ----------------------------------------------------------------------
SUB render_frame()
    IF state = "menu" THEN
        draw_menu()
    ELSEIF state = "play" THEN
        CLS(&H140E08)
        draw_board()
        IF dark_mode THEN
            draw_dark_lighting()
        ELSE
            draw_lighting()
        END IF
        draw_hud()
    ELSEIF state = "win" THEN
        CLS(&H140E08)
        draw_win()
    ELSEIF state = "code" THEN
        draw_code()
    ELSEIF state = "map" THEN
        draw_map()
    ELSEIF state = "stats" THEN
        draw_stats()
    ELSEIF state = "resetconfirm" THEN
        draw_resetconfirm()
    ELSEIF state = "select" THEN
        draw_select()
    ELSE
        CLS(&H2A1E12)
        ctext(SCR_W \ 2, 280, "Keine Level gefunden!", &HF5C542)
        ctext(SCR_W \ 2, 320, "Lege .xsb-Dateien in den Ordner  levels/", &HD2A860)
    END IF
END SUB

' ======================================================================
'  INITIALISIERUNG
' ======================================================================
IF FULLSCREEN THEN
    SCREEN_NATIVE("Pyramid Pusher")     ' randlos in nativer Monitor-Aufloesung
ELSE
    SCREEN(SCR_W, SCR_H, "Pyramid Pusher")
END IF
SETFPS(60)
WINDOW_ESC_QUIT(FALSE)      ' ESC ist Menue-Taste, NICHT Fenster-schliessen (raylib-Default)

' Die ganze Szene wird logisch in 960x600 gerendert und dann passgenau (mit
' Letterbox, Seitenverhaeltnis-treu) auf den echten Bildschirm skaliert.
DIM rt AS INTEGER
rt = RENDERTARGET_NEW(SCR_W, SCR_H)

img_floor = LOADIMAGE("assets/floor.png")
img_wall = LOADIMAGE("assets/wall.png")
img_goal = LOADIMAGE("assets/goal.png")
img_crate = LOADIMAGE("assets/crate.png")
img_crate_on = LOADIMAGE("assets/crate_on.png")
img_hero = LOADIMAGE("assets/hero.png")
img_chest = LOADIMAGE("assets/chest_closed.png")
img_chest_open = LOADIMAGE("assets/chest_open.png")
img_star = LOADIMAGE("assets/star.png")
img_pit = LOADIMAGE("assets/pit.png")
img_pit_filled = LOADIMAGE("assets/pit_filled.png")
img_button = LOADIMAGE("assets/button.png")
img_door_closed = LOADIMAGE("assets/door_closed.png")
img_door_open = LOADIMAGE("assets/door_open.png")
img_ice = LOADIMAGE("assets/ice.png")

has_title = FALSE
IF FILEEXISTS("assets/title.png") THEN
    img_title = IMAGE_SCALE(LOADIMAGE("assets/title.png"), SCR_W, SCR_H)
    has_title = TRUE
END IF

glow = GENTEX_RADIAL(256, 256, RGB(255, 180, 80), RGB(0, 0, 0), 0.16)
vig = GENTEX_RADIAL(SCR_W, SCR_H, RGB(255, 255, 255), RGB(70, 56, 40), 0.0)
lightmask = LOADIMAGE("assets/lightmask.png")

load_catalog()
build_chapters()
layout_map()
cur_chap = 0
sel_lo = 0
sel_hi = ncat

dbcon = DB_OPEN("pyramid_pusher.db")
DB_EXEC(dbcon, "CREATE TABLE IF NOT EXISTS solves (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT, title TEXT, secs INTEGER, moves INTEGER, pushes INTEGER, stars INTEGER)")

sav = SAVE_LOAD_OR_NEW(SAVE_PATH)
best_unlocked = SAVE_GET_INT_OR(sav, "unlocked", 0)
IF DEV_UNLOCK THEN best_unlocked = ncat - 1
IF best_unlocked > ncat - 1 THEN best_unlocked = ncat - 1
IF best_unlocked < 0 THEN best_unlocked = 0
dark_mode = SAVE_GET_INT_OR(sav, "darkmode", 0) = 1
music_on = SAVE_GET_INT_OR(sav, "music", 1) = 1

' Ambiente-Tonleiter (A Phrygisch-dominant: A Bb C# D E F G), tiefe Lage
scale[0] = 110.0 : scale[1] = 116.5 : scale[2] = 138.6 : scale[3] = 146.8
scale[4] = 164.8 : scale[5] = 174.6 : scale[6] = 196.0
note_idx = 0
next_note = MILLIS() + 800

has_xm = FALSE
IF FILEEXISTS("assets/ambient.xm") THEN
    PLAYMUSIC("assets/ambient.xm", 0, 0.5)
    has_xm = TRUE
    IF NOT music_on THEN AUDIO_BUS_VOLUME("music", 0.0)
END IF

ps_dust = PARTICLE_SYSTEM_NEW(0.0, 0.0)
PARTICLE_SET_LIFETIME(ps_dust, 3000, 7000)
PARTICLE_SET_COLOR(ps_dust, &H4A4032)        ' nur RGB! gedaempft, additiv -> subtil
PARTICLE_SET_FADE(ps_dust, TRUE)
PARTICLE_SET_MODE(ps_dust, "glow")
PARTICLE_SET_VELOCITY(ps_dust, -6.0, 6.0, 3.0, 12.0)
PARTICLE_SET_GRAVITY(ps_dust, 0.0, 1.5)
PARTICLE_SET_SIZE(ps_dust, 1, 2)

' Richtungs-Tabellen fuer den Hinweis-Solver (0=rechts 1=links 2=runter 3=hoch)
hdx[0] = 1 : hdy[0] = 0
hdx[1] = -1 : hdy[1] = 0
hdx[2] = 0 : hdy[2] = 1
hdx[3] = 0 : hdy[3] = -1

INPUT_BIND("up", KEY_UP, KEY_W)
INPUT_BIND("down", KEY_DOWN, KEY_S)
INPUT_BIND("left", KEY_LEFT, KEY_A)
INPUT_BIND("right", KEY_RIGHT, KEY_D)
INPUT_BIND("undo", KEY_U, KEY_Z)
INPUT_BIND("restart", KEY_R)
INPUT_BIND("confirm", KEY_SPACE, KEY_ENTER)
INPUT_BIND("back", KEY_ESCAPE)
INPUT_BIND("codescr", KEY_C)
INPUT_BIND("selscr", KEY_L)
INPUT_BIND("torch", KEY_F)
INPUT_BIND("music", KEY_M)
INPUT_BIND("stats", KEY_T)
INPUT_BIND("hint", KEY_H)
INPUT_BIND("resetprogress", KEY_BACKSPACE)

state = "menu"
dialpos = 0
codemsg = ""
selpos = best_unlocked
IF ncat = 0 THEN state = "nolevels"

' ======================================================================
'  HAUPTSCHLEIFE
' ======================================================================
WHILE NOT QUITREQUESTED()
    INPUT_UPDATE()

    IF state = "menu" THEN
        IF INPUT_PRESSED("back") THEN BREAK
        IF INPUT_PRESSED("confirm") THEN
            DIM startidx AS INTEGER
            startidx = best_unlocked
            IF startidx > ncat - 1 THEN startidx = ncat - 1
            start_level(startidx)
        END IF
        IF INPUT_PRESSED("selscr") THEN
            cur_chap = chap_of(best_unlocked) : state = "map"
        END IF
        IF INPUT_PRESSED("codescr") THEN
            dial[0] = 0 : dial[1] = 0 : dial[2] = 0 : dial[3] = 0
            dialpos = 0 : codemsg = "" : state = "code"
        END IF
        IF INPUT_PRESSED("stats") THEN
            compute_stats() : state = "stats"
        END IF
        IF INPUT_PRESSED("resetprogress") THEN
            state = "resetconfirm"
        END IF

    ELSEIF state = "resetconfirm" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"
        IF INPUT_PRESSED("confirm") THEN
            reset_progress()
            selpos = best_unlocked
            state = "menu"
        END IF

    ELSEIF state = "play" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"
        IF INPUT_PRESSED("up") THEN do_move(0, -1)
        IF INPUT_PRESSED("down") THEN do_move(0, 1)
        IF INPUT_PRESSED("left") THEN do_move(-1, 0)
        IF INPUT_PRESSED("right") THEN do_move(1, 0)
        IF INPUT_PRESSED("undo") THEN do_undo()
        IF INPUT_PRESSED("restart") THEN start_level(cur)
        IF INPUT_PRESSED("hint") THEN find_hint()
        IF INPUT_PRESSED("torch") THEN
            dark_mode = NOT dark_mode
            DIM dv AS INTEGER
            dv = 0
            IF dark_mode THEN dv = 1
            SAVE_SET_INT(sav, "darkmode", dv)
            SAVE_WRITE(sav, SAVE_PATH)
        END IF
        IF INPUT_PRESSED("music") THEN
            music_on = NOT music_on
            DIM mv AS INTEGER
            mv = 0
            IF music_on THEN mv = 1
            SAVE_SET_INT(sav, "music", mv)
            SAVE_WRITE(sav, SAVE_PATH)
            IF has_xm THEN
                IF music_on THEN
                    AUDIO_BUS_VOLUME("music", 0.5)
                ELSE
                    AUDIO_BUS_VOLUME("music", 0.0)
                END IF
            END IF
        END IF
        update_ambient()
        update_dust(INT(DELTA() * 1000.0))
        IF INPUT_PRESSED("selscr") THEN
            cur_chap = chap_of(cur) : state = "map"
        END IF

    ELSEIF state = "win" THEN
        IF INPUT_PRESSED("confirm") THEN
            IF cur + 1 < ncat THEN
                start_level(cur + 1)
            ELSE
                state = "menu"
            END IF
        END IF
        IF INPUT_PRESSED("back") THEN state = "menu"

    ELSEIF state = "stats" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"

    ELSEIF state = "code" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"
        IF INPUT_PRESSED("left") THEN dialpos = (dialpos + 3) MOD 4
        IF INPUT_PRESSED("right") THEN dialpos = (dialpos + 1) MOD 4
        IF INPUT_PRESSED("up") THEN dial[dialpos] = (dial[dialpos] + 1) MOD 26
        IF INPUT_PRESSED("down") THEN dial[dialpos] = (dial[dialpos] + 25) MOD 26
        IF INPUT_PRESSED("confirm") THEN try_code()

    ELSEIF state = "map" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"
        IF INPUT_PRESSED("left") AND cur_chap > 0 THEN cur_chap = cur_chap - 1
        IF INPUT_PRESSED("right") AND cur_chap < nchap - 1 THEN cur_chap = cur_chap + 1
        IF INPUT_PRESSED("up") AND cur_chap - MAP_COLS >= 0 THEN cur_chap = cur_chap - MAP_COLS
        IF INPUT_PRESSED("down") AND cur_chap + MAP_COLS < nchap THEN cur_chap = cur_chap + MAP_COLS
        IF INPUT_PRESSED("confirm") THEN
            IF chap_first[cur_chap] <= best_unlocked THEN
                sel_lo = chap_first[cur_chap]
                sel_hi = chap_first[cur_chap] + chap_count[cur_chap]
                selpos = sel_lo
                IF best_unlocked >= sel_lo AND best_unlocked < sel_hi THEN selpos = best_unlocked
                state = "select"
            END IF
        END IF

    ELSEIF state = "select" THEN
        IF INPUT_PRESSED("back") THEN state = "map"
        IF INPUT_PRESSED("left") AND selpos > sel_lo THEN selpos = selpos - 1
        IF INPUT_PRESSED("right") AND selpos < sel_hi - 1 THEN selpos = selpos + 1
        IF INPUT_PRESSED("up") AND selpos - SEL_COLS >= sel_lo THEN selpos = selpos - SEL_COLS
        IF INPUT_PRESSED("down") AND selpos + SEL_COLS < sel_hi THEN selpos = selpos + SEL_COLS
        IF INPUT_PRESSED("confirm") THEN
            IF unlocked_idx(selpos) THEN start_level(selpos)
        END IF
    END IF

    IF state = "nolevels" AND INPUT_PRESSED("back") THEN BREAK

    ' --- Zeichnen ---
    IF FULLSCREEN THEN
        ' alles logisch in 960x600 ins Render-Target, dann passgenau (Letterbox)
        ' aufs echte, native Vollbild skalieren
        RENDERTARGET_BEGIN(rt)
        render_frame()
        RENDERTARGET_END()
        CLS(&H000000)
        DIM scw AS INTEGER
        DIM sch AS INTEGER
        scw = SCREENWIDTH() : sch = SCREENHEIGHT()
        DIM sc AS FLOAT
        sc = scw / SCR_W
        IF (sch * 1.0) / SCR_H < sc THEN sc = (sch * 1.0) / SCR_H
        DIM offx AS INTEGER
        DIM offy AS INTEGER
        offx = INT((scw - SCR_W * sc) / 2)
        offy = INT((sch - SCR_H * sc) / 2)
        RENDERTARGET_DRAW(rt, offx, offy, sc)
    ELSE
        render_frame()
    END IF

    FLIP()
WEND

DB_CLOSE(dbcon)
