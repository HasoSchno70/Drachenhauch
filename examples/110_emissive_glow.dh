' 110_emissive_glow.dh -- Eigenleuchtende Materialien (Emissive) + Bloom-Glow.
'
' MODEL_EMISSIVE(modell, farbe, staerke) laesst ein MODEL_LIT-Modell selbst
' leuchten (unabhaengig von Lichtern, durchschlaegt den Fog). Mit dem Bloom-
' Post-Shader (POSTFX) entsteht echter Neon-Glow.
'
'   MODEL_EMISSIVE(m, &H30E0FF, 2.0)   ' cyan, kraeftig (>1 = ueberstrahlt -> Bloom)
'   MODEL_EMISSIVE(m, 0, 0.0)          ' aus
'
' Native-only (3D). ESC = beenden.

IMPORT "g3d"

SCREEN(880, 540, "Emissive + Bloom-Glow", 1)
SETFPS(60)

LIGHT_ENABLE()
LIGHT_AMBIENT(&H101822, 0.5)
LIGHT_DIRECTIONAL(-0.4, -1.0, -0.3, &H6070A0)   ' dezentes, kuehles Licht -> Glow dominiert

' Bloom als Post-Processing (Szene -> Shader -> Screen).
DIM bloom AS INTEGER
bloom = SHADER_LOAD("assets/shaders/bloom.fs")
IF bloom >= 0 THEN POSTFX(bloom)

DIM ground AS INTEGER
DIM orb AS INTEGER
DIM ring AS INTEGER
ground = MESH_PLANE(30.0, 30.0, 1, 1)
MODEL_LIT(ground)
orb = MESH_SPHERE(0.7, 24, 24)
MODEL_LIT(orb)
ring = MESH_TORUS(0.9, 0.28, 18, 28)
MODEL_LIT(ring)
MODEL_EMISSIVE(ring, &HFF40C0, 2.4)             ' magenta, glueht

' Sechs leuchtende Orbs in Regenbogenfarben (jeweils eigenes Mesh fuer eigene
' Emissive-Farbe -- Emissive ist pro Modell).
CONST N = 6
DIM orbs[6] AS INTEGER
DIM cols[6] AS INTEGER
cols[0] = &HFF3030 : cols[1] = &HFFA020 : cols[2] = &H30FF60
cols[3] = &H30E0FF : cols[4] = &H4060FF : cols[5] = &HE040FF
DIM i AS INTEGER
FOR i = 0 TO N - 1
    orbs[i] = MESH_SPHERE(0.45, 18, 18)
    MODEL_LIT(orbs[i])
    MODEL_EMISSIVE(orbs[i], cols[i], 2.0)
NEXT

DIM t AS FLOAT
t = 0.0

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(KEY_ESCAPE) THEN BREAK
    DIM dt AS FLOAT
    dt = DELTA()
    IF dt > 0.05 THEN dt = 0.05
    t = t + dt

    CLS(&H05070C)
    CAMERA3D(SIN(t * 0.3) * 11.0, 6.0, COS(t * 0.3) * 11.0,  0.0, 1.0, 0.0,  50.0)
    GRID3D(30, 1.0)
    MODEL(ground, 0, 0, 0, 1.0, &H0E1626)

    ' Glueh-Ring in der Mitte (pulsierende Staerke).
    MODEL_EMISSIVE(ring, &HFF40C0, 1.6 + SIN(t * 3.0) * 1.0)
    MODEL_EX(ring, 0, 1.6, 0,  1, 0, 0, 90.0,  1.0, &H401028)

    ' Orbs kreisen.
    FOR i = 0 TO N - 1
        DIM a AS FLOAT
        a = t * 0.8 + i * 6.2832 / N
        MODEL(orbs[i], COS(a) * 4.0, 1.0 + SIN(t * 2.0 + i) * 0.4, SIN(a) * 4.0, 1.0, cols[i])
    NEXT

    TEXT(12, 10, "Emissive-Materialien + Bloom-Glow (POSTFX)", WHITE)
    TEXT(12, 34, "MODEL_EMISSIVE(modell, farbe, staerke)", &H88FFCC)
    FLIP()
WEND
