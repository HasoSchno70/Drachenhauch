=== gui klick ruft gebundene methode (1)
' Der Kern: ein Knopf ruft eine Methode AUF EINER INSTANZ.
IMPORT "gui"
SCREEN(320, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 200, 100)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "ok", 10, 10, 80, 24)

DIM x AS INTEGER
DIM y AS INTEGER
DIM fertig AS BOOLEAN
FOR y = 0 TO 199
  FOR x = 0 TO 319
    IF GUI_HIT_TEST(x, y) = b AND NOT fertig THEN
      PRINT STR$(x + GUI_GET_W(b) / 2); " "; STR$(y + GUI_GET_H(b) / 2)
      fertig = TRUE
    END IF
  NEXT
NEXT
--- umgebung
DHRT_FRAMES=2
--- erwartet
60 54

=== gui klick ruft gebundene methode (2)
' Der Kern: ein Knopf ruft eine Methode AUF EINER INSTANZ.
IMPORT "gui"
SCREEN(320, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)

CLASS Steuerung
    DIM zahl AS INTEGER
    SUB klick()
        Self.zahl = Self.zahl + 1
    END SUB
END CLASS
DIM s AS Steuerung
s = NEW Steuerung()
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 200, 100)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "ok", 10, 10, 80, 24)

GUI_ON_CLICK(b, s.klick)
AUTOMATION_PLAY("klick.txt")
DIM f AS INTEGER
FOR f = 0 TO 7
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT
PRINT s.zahl
--- datei klick.txt
# Test-Aufnahme
c 3
e 0 7 60 54 0 0 // Event: test
e 1 6 0 0 0 0 // Event: test
e 2 5 0 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=10
--- erwartet
1

