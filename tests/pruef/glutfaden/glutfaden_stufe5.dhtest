=== pdf: eine unbekannte palette ist ein fehler
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
DIM o AS kern.PdfOptionen : o = gePdfOptionen(pal, "A4", 0, 0, "Gibtsnicht", "", FALSE, "")
TRY
    DIM ab AS ARRAY OF STRING : ab = kern.pdfExportieren(m, "x.pdf", o)
CATCH e
    PRINT e
END TRY
PRINT "datei "; FILEEXISTS("x.pdf")
