' Pruefungen der Kuehlschrank-App (examples/studio/kuehlschrank): das Projekt
' in den Fallordner kopieren, im Studio mit F5 starten (studiolauf.dh) und
' danach das erzeugte Programm eine Probe fahren lassen -- dasselbe main.dh,
' nur dass statt der Bildschleife die Zeilen einer Probe-Datei laufen.
' Vorher slStudio setzen (der Weg zu studio.dh).
IMPORT "db"
IMPORT "json"
IMPORT "studiolauf.dh"

' Das Projekt ohne Entwicklungsdaten und Erzeugtes (_studio/, bau/).
SUB kKopieren(quelle AS STRING, ziel AS STRING)
    MKDIR(ziel)
    DIM n AS STRING
    FOR EACH n IN DIRLIST(quelle)
        IF n = "fridge_database.db" OR DIREXISTS(PATHJOIN(quelle, n)) THEN CONTINUE
        COPYFILE(PATHJOIN(quelle, n), PATHJOIN(ziel, n))
    NEXT
END SUB

' F5 im Studio: pruefen, erzeugen, das Programm 20 Bilder laufen lassen.
' Liefert die Ausgabe des Studios; das Protokoll steht in log.
FUNCTION kF5(p AS STRING, log AS STRING) AS STRING
    slZeilen = [] : slBild = 0
    slHin(10, 10)
    slWarten(10)
    slTaste(294)
    slWarten(200)
    slAufnahmeSchreiben(CWD$() + "/ev_f5.txt")
    SETENV("DH_STUDIO_LAUF_BILDER", "20")
    RETURN slStarten(log, CWD$() + "/ev_f5.txt", slBild + 20, p)
END FUNCTION

' Ausgabe eines Kindes bis zum Ende (fuenf leere Abfragen, siehe CLAUDE.md);
' mit zeigen = jede Zeile ausser WARNING/INFO der Laufzeit drucken.
FUNCTION kLauf$(k AS INTEGER, zeigen AS BOOLEAN) AS STRING
    DIM z AS STRING : z = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(k) + PROCESS_ERR$(k)
        IF t <> "" THEN
            DIM zeile AS STRING
            FOR EACH zeile IN SPLIT(REPLACE$(t, CHR$(13), ""), CHR$(10))
                IF zeile = "" OR LEFT$(zeile, 8) = "WARNING:" OR LEFT$(zeile, 5) = "INFO:" THEN CONTINUE
                IF zeigen THEN PRINT zeile
                z = z + zeile + CHR$(10)
            NEXT
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(k) THEN
            leer = leer + 1
            SLEEP(30)
        END IF
    WEND
    RETURN z
END FUNCTION

' Der erzeugte Code uebersetzt ohne Befund: "" ist gut.
FUNCTION kCheck$(p AS STRING) AS STRING
    RETURN TRIM$(kLauf$(PROCESS_START("dhrt", "--check", p + "/_studio/main.dh"), FALSE))
END FUNCTION

' Die Probe: statt studioLauf(...) die Schritte vor der Schleife, dann die
' Zeilen aus teil (relativ zum Fallordner), dann bilder Bilder lang die
' Schleife mit Aufnahme (aufnahme "" = keine). Druckt die Ausgabe, liefert
' den Rueckgabewert.
FUNCTION kProbe(p AS STRING, teil AS STRING, aufnahme AS STRING, bilder AS INTEGER) AS INTEGER
    DIM neu AS ARRAY OF STRING : neu = []
    DIM s AS STRING
    FOR EACH s IN READLINES(p + "/_studio/main.dh")
        IF LEFT$(s, 11) = "studioLauf(" THEN
            IF aufnahme <> "" THEN ARRAY_PUSH(neu, "AUTOMATION_PLAY(" + CHR$(34) + aufnahme + CHR$(34) + ")")
            ARRAY_PUSH(neu, "SCREEN(1280, 830, " + CHR$(34) + "Probe" + CHR$(34) + ")")
            ARRAY_PUSH(neu, "studioSchirmB = SCREENWIDTH() : studioSchirmH = SCREENHEIGHT()")
            ARRAY_PUSH(neu, "studioDieStartseite = studioStartFenster")
            ARRAY_PUSH(neu, "studioDieApp.Geoeffnet()")
            ARRAY_PUSH(neu, "studioStartFenster.studioHaupt = TRUE")
            ARRAY_PUSH(neu, "studioStartFenster.Zeigen()")
            DIM t AS STRING
            FOR EACH t IN READLINES(PATHJOIN(CWD$(), teil))
                ARRAY_PUSH(neu, t)
            NEXT
        ELSE
            ARRAY_PUSH(neu, s)
        END IF
    NEXT
    WRITEALL(p + "/_studio/probe.dh", JOIN$(neu, CHR$(10)) + CHR$(10))
    DIM k AS INTEGER : k = PROCESS_START("dhrt", "run", "--bilder", STR$(bilder), p + "/_studio/probe.dh")
    kLauf$(k, TRUE)
    RETURN PROCESS_CODE(k)
END FUNCTION

' Alles, was SQLite ueber den Aufbau einer Datei weiss, als ein Text.
FUNCTION kAufbau$(pfad AS STRING) AS STRING
    DIM db AS DB_CONN : db = DB_OPEN(pfad)
    DIM z AS ARRAY OF STRING : z = []
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT type, name, IFNULL(sql, '') FROM sqlite_master ORDER BY name")
    WHILE DB_NEXT(r)
        ARRAY_PUSH(z, DB_GET_STRING(r, 0) + " " + DB_GET_STRING(r, 1) + " " + DB_GET_STRING(r, 2))
    WEND
    DB_CLOSE(db)
    RETURN JOIN$(z, CHR$(10))
END FUNCTION

' Wo die Mitte einer Spalte einer Tabelle liegt, vom linken Rand der Tabelle
' aus -- aus den Spaltenbreiten in der .dhform (sonst klickt eine Pruefung
' daneben, sobald jemand die Breiten aendert).
FUNCTION kSpalteMitte(p AS STRING, form AS STRING, tabelle AS STRING, spalte AS INTEGER) AS INTEGER
    DIM d AS JSON_HANDLE : d = JSON_LOAD(p + "/" + form + ".dhform")
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(d, "widgets") - 1
        IF JSON_GET_STRING(d, "widgets." + STR$(i) + ".name") <> tabelle THEN CONTINUE
        DIM k AS STRING : k = "widgets." + STR$(i) + ".table.col_widths."
        DIM x AS INTEGER : x = 0
        DIM s AS INTEGER
        FOR s = 0 TO spalte - 1
            x = x + JSON_GET_INT(d, k + STR$(s))
        NEXT
        RETURN x + JSON_GET_INT(d, k + STR$(spalte)) \ 2
    NEXT
    RETURN -1
END FUNCTION
