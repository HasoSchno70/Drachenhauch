=== udp open unbound
IMPORT "net"
DIM s AS NET_UDP
s = NET_UDP_OPEN()
PRINT "ok"
NET_UDP_CLOSE(s)
--- erwartet
ok

=== udp send recv
IMPORT "net"
DIM srv AS NET_UDP
srv = NET_UDP_BIND(0)
DIM cl AS NET_UDP
cl = NET_UDP_OPEN()
PRINT NET_UDP_SEND(cl, "127.0.0.1", NET_UDP_PORT(srv), "ping")
DIM got AS STRING
DIM i AS INTEGER
FOR i = 1 TO 50
    got = NET_UDP_RECV(srv, 1024)
    IF got <> "" THEN BREAK
    SLEEP(2)
NEXT
PRINT got
DIM last AS STRING
last = NET_UDP_LAST_FROM(srv)
PRINT LEFT$(last, 10)
NET_UDP_CLOSE(cl)
NET_UDP_CLOSE(srv)
--- erwartet
4
ping
127.0.0.1:

