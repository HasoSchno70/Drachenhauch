' Drachenhauch Studio: Layout-Behaelter (Zeile, Spalte, Raster) im Entwurf.
'
' Ein Control kommt in ein Layout, wenn man es darauf ablegt oder hineinzieht;
' ein Kind wird umgesetzt (es bleibt stehen, eine Marke zeigt die neue
' Stelle) oder neben jedes Layout gezogen und damit frei. Die Laufzeit legt
' die Kinder auch im Entwurfsfenster selbst -- die Lagen kommen darum aus
' dem Protokoll ("lage control NAME x y w h"), nicht aus dem Modell.
' Jeder Fall: ein erster Lauf misst, ein zweiter spielt echte Klicks ab
' (_hilfen/studiolauf.dh).

--- langsam
=== die zeile legt ihre kinder, die leere spalte zeigt sich
IMPORT "laeufer.dh"
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, "", 8, CWD$() + "/f.dhform")
DIM ax AS INTEGER
DIM ay AS INTEGER
DIM bx AS INTEGER
DIM by AS INTEGER
DIM sx AS INTEGER
DIM sy AS INTEGER
(ax, ay) = slLage(log, "control knopfA")
(bx, by) = slLage(log, "control knopfB")
(sx, sy) = slLage(log, "control feldSuche")
PRINT "nebeneinander "; ax < bx AND bx < sx AND ay = by AND by = sy
PRINT slAnfang(log, "behaelter Zeile1")[0]
PRINT "das gewicht nimmt den rest "; slBreite(log, "feldSuche") > 300
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/_hilfen/studiolauf.dh"
slStudio = ARG$(0)
' Breite aus "lage control NAME x y w h" (die letzte Nennung).
FUNCTION slBreite(log AS STRING, name AS STRING) AS INTEGER
    DIM w AS INTEGER : w = -1
    DIM z AS STRING
    FOR EACH z IN slAnfang(log, "lage control " + name + " ")
        DIM t AS ARRAY OF STRING : t = SPLIT(z, " ")
        w = INT(VAL(t[5]))
    NEXT
    RETURN w
END FUNCTION
--- datei f.dhform
{"title":"Fenster1","name":"Fenster1","x":0,"y":0,"w":600,"h":400,"movable":true,"closable":true,"visible":true,"resizable":true,"widgets":[{"kind":"button","name":"knopfA","text":"Neu","x":0,"y":0,"w":90,"h":30},{"kind":"button","name":"knopfB","text":"Oeffnen","x":0,"y":0,"w":90,"h":30},{"kind":"textinput","name":"feldSuche","text":"","x":0,"y":0,"w":120,"h":30},{"kind":"layout","name":"Zeile1","x":20,"y":20,"w":560,"h":44,"anchor":"lrt","layout":{"art":"zeile","kinder":[[0,0],[1,0],[2,1]],"abstand":6}},{"kind":"layout","name":"Spalte1","x":20,"y":90,"w":240,"h":200,"layout":{"art":"spalte","kinder":[],"abstand":6}},{"kind":"label","name":"frei","text":"frei","x":320,"y":120,"w":100,"h":20}]}

--- erwartet
nebeneinander TRUE
behaelter Zeile1 knopfA:0,knopfB:0,feldSuche:1
das gewicht nimmt den rest TRUE

=== ein baustein auf die spalte gezogen kommt hinein, ein freies control ebenso
IMPORT "laeufer.dh"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 8, CWD$() + "/f.dhform")
DIM kx AS INTEGER
DIM ky AS INTEGER
DIM px AS INTEGER
DIM py AS INTEGER
DIM fx AS INTEGER
DIM fy AS INTEGER
(kx, ky) = slLage(m, "zeile button/Knopf")
(px, py) = slLage(m, "control Spalte1")
(fx, fy) = slLage(m, "control frei")
slHin(10, 10)
slZug(kx, ky, px, py, 12, TRUE)
slWarten(8)
' das Label unter den Knopf -- er liegt jetzt oben in der Spalte
slZug(fx, fy, px, py + 60, 12, TRUE)
slWarten(8)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, CWD$() + "/f.dhform")
DIM z AS STRING
FOR EACH z IN slAnfang(log, "eingesetzt ")
    PRINT z
NEXT
DIM b AS ARRAY OF STRING : b = slAnfang(log, "behaelter Spalte1")
PRINT b[LEN(b) - 1]
DIM k1x AS INTEGER
DIM k1y AS INTEGER
DIM frx AS INTEGER
DIM fry AS INTEGER
(k1x, k1y) = slLage(log, "control Knopf1")
(frx, fry) = slLage(log, "control frei")
PRINT "untereinander "; k1y < fry AND ABS(k1x - frx) < 2
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
