=== passwort verbirgt nur die anzeige
' GUI_TEXT liefert den echten Text; in der Datei steht der Modus.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
GUI_FOCUS(tf)
GUI_TEXTINPUT_SET(tf, "passwort", 1)
CLIPBOARD_SET("geheim")
DIM f AS INTEGER
FOR f = 1 TO 10
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT
PRINT GUI_TEXT(tf)
PRINT INSTR(GUI_TO_JSON(w), CHR$(34) + "passwort" + CHR$(34) + ": true") >= 0
