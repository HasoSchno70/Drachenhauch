' Aus test_gui_styling.py uebertragen (26 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.
'
' Seriell, weil ZWEI Faelle den Mauszeiger bewegen (MOUSE_SET_POS setzt den
' echten des Systems, nicht einen je Prozess): parallel zog der eine ihn dem
' anderen unter dem Knopf weg, und `rein` feuerte ein drittes Mal. Der
' Fehlschlag kam nur im vollen Lauf und nur manchmal.
--- seriell

=== enabled toggle
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("S", 0, 0, 300, 200)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(win, "OK", 20, 40, 120, 30)
PRINT GUI_ENABLED(b)
GUI_SET_ENABLED(b, FALSE)
PRINT GUI_ENABLED(b)
--- erwartet
TRUE
FALSE

=== disabled still hit testable
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("S", 0, 0, 300, 200)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(win, "OK", 20, 40, 120, 30)
GUI_SET_ENABLED(b, FALSE)
PRINT GUI_HIT_TEST(60, 77) = b
--- erwartet
TRUE

=== font setters and roundtrip
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("S", 0, 0, 300, 200)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(win, "OK", 20, 40, 120, 30)
GUI_SET_ENABLED(b, FALSE)
GUI_SET_FONT_SIZE(b, 24)
DIM w2 AS GUI_WINDOW
w2 = GUI_FROM_JSON(GUI_TO_JSON(win))
PRINT GUI_ENABLED(GUI_WINDOW_WIDGET(w2, 0))
--- erwartet
FALSE

=== font size negative raises
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("S", 0, 0, 300, 200)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(win, "OK", 20, 40, 120, 30)
GUI_SET_FONT_SIZE(b, -5)
--- fehler
GUI_SET_FONT_SIZE: Groesse muss >= 0 sein

=== corner radius metric
IMPORT "gui"
PRINT GUI_METRIC_GET("corner_radius")
GUI_METRIC_SET("corner_radius", 8)
PRINT GUI_METRIC_GET("corner_radius")
--- erwartet
0
