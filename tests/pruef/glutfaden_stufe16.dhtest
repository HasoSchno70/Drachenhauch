--- erwartet
aus: TRUE | nochmal FALSE | falsche nummer FALSE
garn: zeilen 9 -> 8 | ausgelassen 1 | schritt 'Nicht sticken' | schritte 1
stand sonst gleich: TRUE | auslassen TRUE
zurueck: FALSE | gleich TRUE
vor: TRUE
wieder an: TRUE 'Farbe sticken' FALSE
gedimmt: F0D1D0 CCCCCC | halbe ebene E6E6E6 | fast unsichtbar EBEBEB | dunkler stoff 4C4C4C

=== probe: farbleiste, hervorheben, nicht sticken, startseite
IMPORT "helfer.dh"
' Punkte im Rot von F0 (C72B3B, +-12) zwischen Werkzeugleiste und Farbleiste,
' links von der Seitenleiste
FUNCTION rotOben(pfad AS STRING) AS INTEGER
    DIM b AS IMAGE : b = LOADIMAGE(pfad)
    DIM n AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR y = 140 TO IMAGE_HEIGHT(b) - 220 STEP 3
        FOR x = 60 TO IMAGE_WIDTH(b) - 460 STEP 3
            DIM c AS INTEGER : c = GETPIXEL(b, x, y)
            IF ABS(((c SHR 16) BAND 255) - &HC7) < 12 AND ABS(((c SHR 8) BAND 255) - &H2B) < 12 AND ABS((c BAND 255) - &H3B) < 12 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION

' --probe-stufe16 mit alle.pxs: Farbleiste (Treffer, Wahl, Tauschen per
' Ziehen, Hervorheben ueber Strg+H und das Menue, nicht sticken mit
' Rueckgaengig, Groesse, ein/aus und gemerkt), die Startseite mit Muster.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe16", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["farbleiste", "hervorgehoben", "nicht_sticken", "farbleiste_30", "startseite"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    ' Hervorgehoben ist F2 (Schwarz): das Rot von F0 steht danach nur noch
    ' gedimmt im Muster (gezaehlt oberhalb der Farbleiste)
    PRINT "rot im muster: vorher "; rotOben("d_farbleiste.png") > 50; " | hervorgehoben "; rotOben("d_hervorgehoben.png")
    PRINT "datei unveraendert: "; geLies$("alle.pxs") = geLies$("vorher.pxs")
END IF
