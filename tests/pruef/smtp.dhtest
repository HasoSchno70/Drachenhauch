--- argumente
{sammlung}/_hilfen/smtpserver.dh
--- erwartet
TRUE

=== ein abgelehnter empfaenger ist ein fehler
' Ein Tippfehler in der Adresse darf nicht als "verschickt" durchgehen.
IMPORT "smtp"
IMPORT "gegen.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_SERVER(m, "127.0.0.1", starten("AUTH PLAIN LOGIN", "1", "0"), "keine")
SMTP_FROM(m, "ich@beispiel.de", "Abteilung Zahlen")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Auswertung August")
SMTP_TEXT(m, "Anbei die Zahlen.")
TRY
    SMTP_SEND(m)
    PRINT "raus"
CATCH e
    PRINT INSTR(e, "550") >= 0 AND INSTR(e, "du@beispiel.de") >= 0
END TRY
beenden()
--- datei gegen.dh
IMPORT "{sammlung}/_hilfen/smtpstart.dh"

--- argumente
{sammlung}/_hilfen/smtpserver.dh
--- erwartet
TRUE
