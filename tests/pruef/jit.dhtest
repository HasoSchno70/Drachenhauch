DIM summe AS INTEGER
SUB merk()
    summe = summe + g
END SUB
DIM f AS FUNCREF : f = merk
DIM i AS INTEGER
FOR i = 1 TO 20
    g = i * 10
    TIMER_AFTER(0, f)
    TIMER_UPDATE()
NEXT
PRINT summe; " "; g
--- umgebung
DHRT_JIT=aus
--- erwartet
2100 200

