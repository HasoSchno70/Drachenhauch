IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM a AS INTEGER : a = GUI_MENU_ITEM(m, "Loeschen", "Entf")
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 10, 40, 200, 26)
GUI_FOCUS(tf)
DIM f AS INTEGER
FOR f = 1 TO 16
    GUI_UPDATE()
    IF GUI_CLICKED(a) THEN PRINT "loeschen " + STR$(f)
    IF f = 8 THEN GUI_DESTROY(tf)
    GUI_DRAW()
    FLIP()
NEXT
