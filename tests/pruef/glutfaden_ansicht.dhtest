' Die Oberflaeche des Glutfaden-Ports (examples/glutfaden, GTK 3) -- ueber
' --probe bzw. --probe-bearbeiten, das sich selbst vorfuehrt, mit
' Bildschirmfotos (--foto). Ohne GTK mit Bildschirm ueberspringt sich der Fall.
' Format: docs/werkzeuge.md, dhrt test.

=== glutfaden zeigt das demo muster
IMPORT "helfer.dh"
dlStarten(["run", BEISPIEL, "--", "--probe", "--foto", "s"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    ' Das Herz ist Anchor 47 (#A9152C): auf dem nahen Bild viele solche
    ' Punkte, nach dem Ausblenden der Ebene keiner mehr.
    PRINT "herz nah: "; punkte("s_nah.png", &HA9152C) > 500
    PRINT "herz ausgeblendet: "; punkte("s_ohne_herz.png", &HA9152C)
    PRINT "eingepasst: "; punkte("s_eingepasst.png", &HA9152C) > 200
END IF
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bild.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- erwartet
rueckgabe 0
geladen: TRUE, eingepasst: TRUE
40 x 40, 7,3 cm
zoom: 150 %
zelle 17,12: 1 -> -1
wieder da: 1
herz nah: TRUE
herz ausgeblendet: 0
eingepasst: TRUE

=== glutfaden bearbeitet, nimmt zurueck und sichert
' Ein Katalog-Garn (DMC 996, #0097E1) ins Muster, ein gefuelltes Rechteck auf
' einer neuen Ebene, zurueck und wieder vor, Linie mit Umschalt, Stift mit
' Halbstich, rechte Taste radiert, Pipette, Fuellen in EINEM Schritt, gesperrte
' Ebene, Ebene loeschen und zurueckholen, halbe Deckkraft, sichern und laden,
' umbenennen. Die Fotos zeigen, dass das Bild mitgeht: nach dem Zurueck kein
' Blau mehr, bei halber Deckkraft ein gemischtes statt des reinen.
IMPORT "helfer.dh"
dlStarten(["run", BEISPIEL, "--", "--probe-bearbeiten", "--foto", "b"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    PRINT "blau im rechteck: "; punkte("b_rechteck.png", &H0097E1) > 1000
    PRINT "blau nach zurueck: "; punkte("b_zurueck.png", &H0097E1)
    PRINT "blau wieder: "; punkte("b_wieder.png", &H0097E1) > 1000
    ' halb ueber dem Stoff (#FAFAF5): (0+250)/2, (151+250)/2, (225+245)/2
    PRINT "halb: rein "; punkte("b_halb.png", &H0097E1) < 50; " gemischt "; punkte("b_halb.png", &H7DC8EB) > 1000
END IF
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bild.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- erwartet
