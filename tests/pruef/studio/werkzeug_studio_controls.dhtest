--- datei proj/Hauptfenster.dhform
{"title":"Haupt","name":"Hauptfenster","w":420,"h":300,"widgets":[
{"kind":"studio_control","studio_control":"Melder","name":"melder1","x":20,"y":20,"w":120,"h":30}]}
--- datei proj/Hauptfenster.dh
CLASS Hauptfenster EXTENDS Hauptfenster_Basis
    DIM bilder AS INTEGER
    DIM n AS INTEGER

    SUB Takt()
        Self.bilder = Self.bilder + 1
        IF Self.bilder = 3 THEN Self.melder1.Ausloesen("Los")
    END SUB

    SUB melder1_Los()
        Self.n = Self.n + 1
        PRINT "los "; Self.n
        DIM d AS Dialog : d = NEW Dialog()
        d.ZeigenModal()
        PRINT "los zu"
    END SUB
END CLASS
--- datei proj/App.dh
CLASS App EXTENDS StudioApp
END CLASS
--- erwartet
ausgabe los 1
ausgabe los zu
