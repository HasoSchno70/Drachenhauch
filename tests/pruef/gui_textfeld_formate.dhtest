=== geformt ist mehr tinte als ungeformt
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM t0 AS GUI_WIDGET : t0 = GUI_TEXTAREA(w, 10, 10, 280, 50)
DIM t1 AS GUI_WIDGET : t1 = GUI_TEXTAREA(w, 10, 70, 280, 50)
DIM t2 AS GUI_WIDGET : t2 = GUI_TEXTAREA(w, 10, 130, 280, 50)
GUI_TEXTAREA_SET(t0, "formatiert", 1)
GUI_SET_TEXT(t0, "Wort Wort")
GUI_TEXTAREA_SET_MARKDOWN(t1, "**Wort Wort**")
GUI_TEXTAREA_SET_MARKDOWN(t2, "<u>Wort Wort</u>")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
