FUNCTION zaehle(n AS INTEGER) AS INTEGER
    DIM a AS INTEGER
    DIM b AS FLOAT
    DIM j AS INTEGER
    PRINT "los"
    FOR j = 1 TO n
        a = a + j
        b = b + 1.5
    NEXT
    PRINT "fertig "; b
    RETURN a
END FUNCTION
