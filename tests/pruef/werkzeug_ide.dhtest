--- datei _programm/ev.txt
c 4
e 20 2 341 0 0 0
e 20 2 295 0 0 0
e 22 1 295 0 0 0
e 22 1 341 0 0 0

--- system windows
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(z AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
PRINT "export 0 " ; LEFT$(erste$("exportiert "), 12) = "exportiert 0"
DIM px AS INTEGER : px = PROCESS_START("spiel_dist/spiel.exe")
DIM bx AS INTEGER : bx = MILLIS() + 60000
DIM ax AS STRING : ax = ""
DIM stille AS INTEGER : stille = 0
WHILE MILLIS() < bx AND stille < 5
    DIM zx AS STRING : zx = PROCESS_READ$(px)
    IF zx <> "" THEN ax = ax + zx : stille = 0
    IF zx = "" AND NOT PROCESS_RUNNING(px) THEN stille = stille + 1 : SLEEP(30)
WEND
PRINT "die exe sagt " + TRIM$(REPLACE$(ax, CHR$(13), ""))
--- erwartet
export 0 TRUE
die exe sagt exportiert

