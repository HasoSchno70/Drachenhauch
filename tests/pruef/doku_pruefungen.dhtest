=== die beispielzaehlung kommt aus der versionsverwaltung
' Die Zahl kam frueher aus einem glob ueber examples/ -- und darin fiel eine
' Temp-Datei der Live-Diagnose, die fuer 40 ms NEBEN der Quelle liegt. Hier in
' einem eigenen Wegwerf-Repo, damit kein paralleler Lauf die Streudatei sieht.
IMPORT "helfer.dh"
DIM fall AS STRING : fall = CWD$()
MKDIR("repo")
MKDIR("repo/examples")
WRITEALL("repo/examples/01_hallo.dh", "PRINT 1" + CHR$(10))
WRITEALL("repo/examples/02_welt.dh", "PRINT 2" + CHR$(10))
CHDIR("repo")
IF NOT git("init", "", "") THEN
    PRINT "UEBERSPRINGEN: git nicht installiert"
    EXIT(0)
END IF
git("config", "user.email", "t@t.de")
git("config", "user.name", "Tester")
git("add", "examples", "")
git("-c", "commit.gpgsign=false", "commit -m zwei")
CHDIR(ARG$(0))
dlStarten(["pruef", "beispiele", fall + "/repo"])
PRINT "vorher: "; TRIM$(dlAus)
' Der Fremdkoerper aus der Live-Diagnose -- unversioniert, also unsichtbar.
WRITEALL(fall + "/repo/examples/tmp9k3x.dh", "PRINT 1" + CHR$(10))
dlStarten(["pruef", "beispiele", fall + "/repo"])
PRINT "mit streudatei: "; TRIM$(dlAus)
PRINT "der glob saehe "; LEN(DIRLIST(fall + "/repo/examples", "*.dh"))
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
' git im Arbeitsordner; "commit -m zwei" als dritter Teil wird zerlegt.
FUNCTION git(a AS STRING, b AS STRING, c AS STRING) AS BOOLEAN
    DIM p AS INTEGER
    TRY
        IF c = "commit -m zwei" THEN
            p = PROCESS_START("git", a, b, "commit", "-m", "zwei")
        ELSEIF b = "" THEN
            p = PROCESS_START("git", a)
        ELSEIF c = "" THEN
            p = PROCESS_START("git", a, b)
        ELSE
            p = PROCESS_START("git", a, b, c)
        END IF
    CATCH e
        RETURN FALSE
    END TRY
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF teil <> "" THEN
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN PROCESS_CODE(p) = 0
END FUNCTION
--- erwartet
vorher: 2 versioniert
mit streudatei: 2 versioniert
der glob saehe 3

