=== mehrere anfragen nacheinander
IMPORT "klient.dh"
DIM port AS INTEGER : port = serverStarten("srv.dh")
DIM i AS INTEGER
FOR i = 0 TO 2
    PRINT rumpf$(holen$(port, "GET", "/" + STR$(i), "", ""))
NEXT
serverEnde()
--- datei klient.dh
IMPORT "{sammlung}/_hilfen/httpklient.dh"

--- datei srv.dh
IMPORT "httpd"
DIM s AS HTTPD
DIM n AS INTEGER
s = HTTPD_START(0)
EPRINT("PORT=" + STR$(HTTPD_PORT(s)))
WHILE n < 3
    IF HTTPD_ACCEPT(s) THEN
        HTTPD_SEND(s, 200, "text/plain", "nr" + STR$(n))
        n = n + 1
    END IF
    SLEEP(5)
WEND
HTTPD_STOP(s)

--- erwartet
nr0
nr1
nr2

