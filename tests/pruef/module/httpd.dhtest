=== send dir laesst niemanden hinaus
' Der eigentliche Grund, warum es SEND_DIR gibt: die naheliegende Handarbeit
' (HTTPD_SEND_FILE(s, 200, "web" + HTTPD_PATH$(s))) laesst sich mit
' /../geheim.txt aus dem Ordner herausfuehren -- dieselbe Lehre wie bei der
' Zip-Slip-Pruefung in ZIP_EXTRACT.
IMPORT "klient.dh"
DIM port AS INTEGER : port = serverStarten("srv.dh")
DIM a AS STRING : a = holen$(port, "GET", "/../geheim.txt", "", "")
PRINT status(a)
PRINT INSTR(a, "GEHEIM") < 0
serverEnde()
--- datei klient.dh
IMPORT "{sammlung}/_hilfen/httpklient.dh"

--- datei geheim.txt
GEHEIM
