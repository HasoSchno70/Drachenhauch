' 152_pixelart_skalierung.gb -- IMAGE_SCALE vs. IMAGE_SCALE_NN (native-only, F6)
'
' IMAGE_SCALE glaettet bilinear. Fuer Fotos ist das richtig -- fuer PIXELGRAFIK
' ist es der klassische Anfaengerfehler: aus harten Kanten werden Verlaeufe,
' ein 8x8-Sprite auf 128x128 ist danach matschig statt gross.
'
' IMAGE_SCALE_NN(bild, w, h) skaliert ohne Interpolation (Nearest-Neighbour) --
' jeder Quellpixel wird zu einem sauberen Block.
'
' Faustregel: ganzzahlige Vielfache nehmen (2x, 3x, 4x ...), sonst werden
' einzelne Pixelreihen unterschiedlich breit ("Pixel-Wackeln").

IMPORT "imgfx"

SCREEN(720, 420, "Pixelgrafik skalieren", 1)

' Ein winziges 8x8-Gesicht aus Zellrauschen waere zufaellig -- hier lieber
' etwas Gezeichnetes: Schachbrett + ein paar gesetzte Pixel als "Sprite".
DIM klein AS IMAGE
klein = GENTEX_CHECKED(8, 8, 4, 4, &H2A3550, &H68C8FF)

DIM weich AS IMAGE
DIM hart AS IMAGE
weich = IMAGE_SCALE(klein, 256, 256)      ' bilinear -- verwaschen
hart = IMAGE_SCALE_NN(klein, 256, 256)    ' Nearest-Neighbour -- knackig

WHILE NOT QUITREQUESTED()
    CLS(&H0B1016)

    DRAWIMAGE(weich, 40, 90)
    DRAWIMAGE(hart, 420, 90)

    TEXT(40, 30, "8x8-Bild auf 256x256 vergroessert", &HD0E0F0)
    TEXT(40, 60, "IMAGE_SCALE (bilinear)", &HFF8080)
    TEXT(420, 60, "IMAGE_SCALE_NN (knackig)", &H80FFA0)
    TEXT(40, 370, "Links verlaufen die Kanten, rechts bleiben es Bloecke.", &H90A0B0)

    FLIP()
WEND
