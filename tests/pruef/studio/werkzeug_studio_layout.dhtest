eingesetzt knopfB Zeile1 0
frei TRUE
behaelter Zeile1 knopfB:0,knopfA:0

=== verdoppeln nimmt die kinder mit, loeschen laesst sie frei stehen
' knopfA verdoppelt: die Kopie steht in der Zeile gleich dahinter. Zeile1
' verdoppelt (gewaehlt im Navigator): Zeile2 mit Kopien aller Kinder.
' Zeile1 geloescht: ihre Kinder bleiben frei, Zeile2 zeigt weiter auf IHRE.
IMPORT "laeufer.dh"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 8, CWD$() + "/f.dhform")
DIM ax AS INTEGER
DIM ay AS INTEGER
DIM nx AS INTEGER
DIM ny AS INTEGER
(ax, ay) = slLage(m, "control knopfA")
(nx, ny) = slLage(m, "knoten Fenster1.Zeile1")
slHin(10, 10)
slKlick(ax, ay)
slWarten(4)
slMit([341], 68)
slWarten(6)
slKlick(nx, ny)
slWarten(4)
slMit([341], 68)
slWarten(6)
slKlick(nx, ny)
slWarten(4)
slTaste(261)
slWarten(8)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, CWD$() + "/f.dhform")
' Je Aenderung ein Stand (nach "behaelter --"); gleiche hintereinander einmal.
DIM staende AS ARRAY OF STRING : staende = []
DIM z AS STRING
FOR EACH z IN slAnfang(log, "behaelter ")
    IF z = "behaelter --" THEN
        ARRAY_PUSH(staende, "")
    ELSEIF LEN(staende) > 0 THEN
        staende[LEN(staende) - 1] = staende[LEN(staende) - 1] + TRIM$(MID$(z, 10, 999)) + " | "
    END IF
NEXT
DIM vorher AS STRING : vorher = "?"
DIM st AS STRING
FOR EACH st IN staende
    IF st <> vorher THEN PRINT st
    vorher = st
NEXT
DIM kx AS INTEGER
DIM ky AS INTEGER
(kx, ky) = slLage(log, "control knopfA")
PRINT "knopfA steht noch "; kx > 0
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
