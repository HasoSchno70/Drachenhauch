' Aus test_modules_audio.py uebertragen (25 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== music play stop fade validation
IMPORT "audio"
TRY
    AUDIO_MUSIC_PLAY(-1, -5)
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_MUSIC_STOP(-1)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_MUSIC_PLAY: fade_in_ms muss >= 0 sein
AUDIO_MUSIC_STOP: fade_out_ms muss >= 0 sein

=== play stop fade validation
IMPORT "audio"
TRY
    AUDIO_PLAY(0, -1, 1.0, -5)
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_STOP(0, -1)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_PLAY: fade_in_ms muss >= 0 sein
AUDIO_STOP: fade_out_ms muss >= 0 sein

=== pan slide validation
IMPORT "audio"
TRY
    AUDIO_PAN_SLIDE(0, 0.0, 1.0, 0)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_PAN_SLIDE: dauer_ms muss > 0 sein

=== pitch validation
IMPORT "audio"
TRY
