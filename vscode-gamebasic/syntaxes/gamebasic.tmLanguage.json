  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.drachenhauch",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.drachenhauch",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.drachenhauch",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.drachenhauch",
              "match": "\"\""
