=== guard multiple cases (1)
' Mehrere Cases mit Guards, plus CASE ohne Guard.
DIM hp AS INTEGER
hp = 30
DIM healed AS BOOLEAN
healed = TRUE

SELECT CASE hp
    CASE IS <= 0
        PRINT "tot"
    CASE IS <= 50 WHERE healed
        PRINT "low aber bereits geheilt"
    CASE IS <= 50
        PRINT "low ungeheilt"
    CASE ELSE
        PRINT "ok"
END SELECT
--- erwartet
low aber bereits geheilt

=== guard multiple cases (2)
' Mehrere Cases mit Guards, plus CASE ohne Guard.
