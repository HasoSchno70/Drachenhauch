IMPORT "{sammlung}/_hilfen/dockmaus.dh"
IMPORT "{sammlung}/_hilfen/dockaufbau.dh"
--- umgebung
DHRT_FRAMES=4
--- erwartet
dort das plugin TRUE
fenster dort TRUE
--- bild
640 180 #30C030 +-60

