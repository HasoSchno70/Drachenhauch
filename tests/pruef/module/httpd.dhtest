=== belegter port meldet sich
' Zwei Server auf demselben Port -- der zweite muss es sagen.
IMPORT "klient.dh"
DIM port AS INTEGER : port = serverStarten("srv.dh")
DIM p2 AS INTEGER : p2 = PROCESS_START("dhrt", "run", CWD$() + "/zweit.dh", "--", STR$(port))
DIM fehler AS STRING : fehler = ""
DIM leer AS INTEGER : leer = 0
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE MILLIS() - t0 < 15000 AND leer < 5
    DIM e AS STRING : e = PROCESS_ERR$(p2)
    IF e <> "" THEN fehler = fehler + e
    IF e = "" AND NOT PROCESS_RUNNING(p2) THEN leer = leer + 1
    SLEEP(30)
WEND
PRINT PROCESS_CODE(p2) <> 0
PRINT INSTR(fehler, "nicht belegbar") >= 0
PROCESS_KILL(srvProzess)
--- datei klient.dh
IMPORT "{sammlung}/_hilfen/httpklient.dh"

--- datei srv.dh
IMPORT "httpd"
DIM s AS HTTPD
s = HTTPD_START(0)
EPRINT("PORT=" + STR$(HTTPD_PORT(s)))
WHILE NOT HTTPD_ACCEPT(s)
    SLEEP(5)
WEND
HTTPD_SEND(s, 200, "text/plain", "x")
HTTPD_STOP(s)

--- datei zweit.dh
IMPORT "httpd"
DIM t AS HTTPD
t = HTTPD_START(VAL(ARG$(0)))

--- erwartet
TRUE
TRUE
