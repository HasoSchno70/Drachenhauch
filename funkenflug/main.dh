SUB ansichtLeistenNachziehen()
    IF gLeiste = 0 THEN RETURN
    gKnoepfeSetzen = TRUE
    gtk_toggle_button_set_active(gKnopfSchaltplan, gAnsicht = ANS_SCHALTPLAN)
    gtk_toggle_button_set_active(gKnopfPlatine, gAnsicht = ANS_PLATINE)
    gKnoepfeSetzen = FALSE
    IF gAnsicht = ANS_PLATINE THEN
        gtk_widget_hide(gLeiste)
        gtk_widget_hide(gReiter)
        gtk_widget_show(gPlLeiste)
        plKnoepfeNachziehen()
    ELSE
        gtk_widget_hide(gPlLeiste)
        gtk_widget_show(gLeiste)
        gtk_widget_show(gReiter)
    END IF
END SUB

SUB plKnoepfeNachziehen()
    IF gPlKnopfAuswahl = 0 THEN RETURN
    gKnoepfeSetzen = TRUE
    gtk_toggle_button_set_active(gPlKnopfAuswahl, gPlWz = PW_AUSWAHL)
    gtk_toggle_button_set_active(gPlKnopfBahn, gPlWz = PW_BAHN)
    gtk_toggle_button_set_active(gPlKnopfTrennen, gPlWz = PW_TRENNEN)
    gtk_combo_box_set_active(gPlArtWahl, IIF(gDok.platine.art = kern.PL_STREIFEN, 0, 1))
    gKnoepfeSetzen = FALSE
END SUB

