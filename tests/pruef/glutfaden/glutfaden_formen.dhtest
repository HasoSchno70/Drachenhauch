' Die Formen der Werkzeuge (examples/glutfaden/kern/formen.dh) Punkt fuer Punkt
' gegen PySticky: die Erwartung ist die Ausgabe der Original-Algorithmen
' (BaseTool._get_line_points, RectTool._get_rect_points,
' EllipseTool._get_ellipse_points, LineTool._constrain_angle,
' RectTool._constrain_square, FillTool._scanline_fill), einmal mit PySticky
' aufgezeichnet. Je Zeile: Zahl der Zellen, dann jede Zelle als
' (x+1000)*10000 + (y+1000), sortiert -- die Reihenfolge ist im Original eine
' Menge und zaehlt nicht.

=== formen wie in pysticky
IMPORT "k.dh"
SUB zeile(name AS STRING, p AS ARRAY OF INTEGER)
    DIM ks AS ARRAY OF INTEGER : ks = []
    DIM k AS INTEGER
    FOR k = 0 TO LEN(p) - 2 STEP 2
        ARRAY_PUSH(ks, (p[k] + 1000) * 10000 + (p[k + 1] + 1000))
    NEXT
    SORT(ks)
    DIM t AS STRING : t = name + " " + STR$(LEN(ks))
    DIM v AS INTEGER
    FOR EACH v IN ks
        t = t + " " + STR$(v)
    NEXT
    PRINT t
END SUB
SUB vier(art AS STRING, c AS ARRAY OF INTEGER, f AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(c) - 4 STEP 4
        DIM n AS STRING : n = art + " " + STR$(c[i]) + " " + STR$(c[i + 1]) + " " + STR$(c[i + 2]) + " " + STR$(c[i + 3])
        IF art = "linie" THEN
            zeile(n, kern.linie(c[i], c[i + 1], c[i + 2], c[i + 3]))
        ELSEIF art = "rechteck" THEN
            zeile(n + " " + STR$(f), kern.rechteck(c[i], c[i + 1], c[i + 2], c[i + 3], f = 1))
        ELSE
            zeile(n + " " + STR$(f), kern.ellipse(c[i], c[i + 1], c[i + 2], c[i + 3], f = 1))
        END IF
    NEXT
END SUB
vier("linie", [0, 0, 9, 0, 0, 0, 0, 7, 0, 0, 6, 6, 0, 0, 8, 4, 8, 4, 0, 0, 0, 0, 4, 8, 4, 8, 0, 0, 2, 9, 11, 3, 11, 3, 2, 9, 5, 5, 5, 5, -3, 2, 4, -6, 0, 0, 10, 3, 10, 3, 0, 0], 0)
DIM rk AS ARRAY OF INTEGER : rk = [1, 1, 6, 4, 6, 4, 1, 1, 3, 3, 3, 3, 2, 5, 9, 5, 4, 0, 4, 6, -2, -1, 3, 2]
vier("rechteck", rk, 0)
vier("rechteck", rk, 1)
DIM el AS ARRAY OF INTEGER : el = [0, 0, 10, 6, 10, 6, 0, 0, 0, 0, 7, 7, 2, 3, 13, 4, 0, 0, 1, 1, 4, 4, 4, 4, 1, 0, 1, 9, 0, 5, 9, 5, 0, 0, 20, 11, -6, -3, 5, 8, 3, 2, 4, 9, 0, 0, 31, 17]
vier("ellipse", el, 0)
vier("ellipse", el, 1)
DIM w AS ARRAY OF INTEGER : w = [5, 5, 12, 6, 5, 5, 6, 13, 5, 5, 9, 7, 5, 5, 1, 2, 5, 5, 5, 5, 5, 5, -4, 1]
DIM i AS INTEGER
FOR i = 0 TO LEN(w) - 4 STEP 4
    DIM a AS INTEGER, b AS INTEGER
    (a, b) = kern.winkelGerade(w[i], w[i + 1], w[i + 2], w[i + 3])
    PRINT "winkel "; w[i]; " "; w[i + 1]; " "; w[i + 2]; " "; w[i + 3]; " -> "; a; " "; b
NEXT
DIM q AS ARRAY OF INTEGER : q = [5, 5, 12, 7, 5, 5, 2, 11, 5, 5, 1, 3]
FOR i = 0 TO LEN(q) - 4 STEP 4
    (a, b) = kern.quadratEcke(q[i], q[i + 1], q[i + 2], q[i + 3])
    PRINT "quadrat "; q[i]; " "; q[i + 1]; " "; q[i + 2]; " "; q[i + 3]; " -> "; a; " "; b
NEXT
DIM karte AS ARRAY OF STRING : karte = ["..111....2", ".1...1..2.", ".1.0.1.2..", ".1...1....", "..111..333", ".......3.3", "0000...333"]
DIM e AS kern.Ebene : e = kern.neueEbene("t", 10, 7)
DIM x AS INTEGER, y AS INTEGER
DIM ok AS BOOLEAN
FOR y = 0 TO 6
    FOR x = 0 TO 9
        DIM ch AS STRING : ch = MID$(karte[y], x, 1)
        IF ch <> "." THEN ok = e.setzeStich(x, y, VAL(ch))
    NEXT
NEXT
DIM fu AS ARRAY OF INTEGER : fu = [0, 0, 5, 3, 2, 5, 3, 2, 0, 2, 0, 4, 8, 5, 1, 9, 0, 2, 2, 2, 1, 0, 6, 7]
FOR i = 0 TO LEN(fu) - 3 STEP 3
    zeile("fuellen " + STR$(fu[i]) + " " + STR$(fu[i + 1]) + " " + STR$(fu[i + 2]), kern.fuellung(e, fu[i], fu[i + 1], fu[i + 2]))
NEXT
--- datei k.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern

