=== umwandeln beim speichern und division durch null
' Ein INTEGER-Ergebnis in eine FLOAT-Variable braucht eine Umwandlung, eine
' Kommazahl in eine INTEGER-Variable die Pruefung "verlustfrei" -- beides
' macht der Einzelbefehl. Ebenso die Division durch 0.
DIM gf AS FLOAT
DIM gi AS INTEGER
DIM x AS INTEGER : x = 6
DIM y AS INTEGER : y = 4
gf = x + y
PRINT gf; " "; TYPEOF(gf)
gi = x / 2
PRINT gi; " "; TYPEOF(gi)
TRY
    gi = x / y
CATCH e
    PRINT "halb: "; LEFT$(e, 40)
END TRY
DIM null AS INTEGER
TRY
    gf = x / null
CATCH e
    PRINT "null: "; e
END TRY
--- erwartet
10.0 FLOAT
3 INTEGER
halb: Zuweisung an global: FLOAT 1.5 passt nic
null: Division durch 0

=== umwandeln beim speichern und division durch null (ohne verschmelzen)
DIM gf AS FLOAT
DIM gi AS INTEGER
DIM x AS INTEGER : x = 6
DIM y AS INTEGER : y = 4
gf = x + y
PRINT gf; " "; TYPEOF(gf)
gi = x / 2
PRINT gi; " "; TYPEOF(gi)
TRY
    gi = x / y
CATCH e
    PRINT "halb: "; LEFT$(e, 40)
END TRY
DIM null AS INTEGER
TRY
    gf = x / null
CATCH e
    PRINT "null: "; e
END TRY
--- umgebung
DHRT_OHNE_VERSCHMELZEN=1
--- erwartet
10.0 FLOAT
3 INTEGER
halb: Zuweisung an global: FLOAT 1.5 passt nic
null: Division durch 0

=== welche folgen markiert werden
' Gegenprobe, dass der schnelle Weg ueberhaupt da ist -- ohne Zeitmessung
' (die flackert auf einer belasteten Maschine): `dhrt --verschmolzen` listet
' die markierten Stellen. Die Folge im Rumpf der Schleife ist ein Sprung
' (IF i MOD 3 = 0), die Zuweisung `c = a * b` speichert lokal; `a + b` als
' Argument bleibt ein Wert. Mit DHRT_OHNE_VERSCHMELZEN steht nichts da.
IMPORT "helfer.dh"
dlStarten(["--verschmolzen", "prog.dh"])
PRINT dlAus
SETENV("DHRT_OHNE_VERSCHMELZEN", "1")
dlStarten(["--verschmolzen", "prog.dh"])
PRINT "ohne: ["; TRIM$(dlAus); "]"
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- datei prog.dh
SUB lauf(a AS INTEGER, b AS INTEGER)
    DIM c AS INTEGER
    DIM i AS INTEGER
    FOR i = 1 TO 10
        IF i MOD 3 = 0 THEN c = a * b
    NEXT
    PRINT a + b
END SUB
lauf(2, 3)

--- erwartet
lauf 7 sprung-wahr
lauf 11 wert
lauf 17 lokal
lauf 23 wert

ohne: []
