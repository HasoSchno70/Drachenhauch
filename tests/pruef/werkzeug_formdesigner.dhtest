=== anordnen richtet am zuletzt angeklickten aus
' Drei Knoepfe, Bezug ist der mittlere (zuletzt angeklickt). Jede Anordnung
' beginnt beim selben Stand; Verteilen laesst den ersten und letzten stehen.
DIM orig AS STRING : orig = JSON_STRINGIFY(doc)
SUB frisch()
    doc = JSON_PARSE(orig)
    ansichtBauen()
    gewaehlt = [0, 1, 2]
    auswahl = 1
END SUB
SUB zeige(was AS STRING)
    DIM teile AS ARRAY OF STRING : teile = []
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        ARRAY_PUSH(teile, STR$(feldZahl(i, "x")) + "," + STR$(feldZahl(i, "y")) + "," + STR$(feldZahl(i, "w")) + "," + STR$(feldZahl(i, "h")))
    NEXT
    PRINT was; " "; JOIN$(teile, " | ")
END SUB
DIM w AS STRING
FOR EACH w IN ("links", "rechts", "mitte_w", "oben", "unten", "mitte_s", "breite", "hoehe", "groesse", "vert_w", "vert_s")
    frisch()
    anordnen(w)
    zeige(w)
NEXT
' Zu wenige gewaehlt: nichts geschieht, die Statuszeile sagt es.
frisch()
gewaehlt = [1]
anordnen("links")
zeige("einer")
PRINT GUI_TEXT(lblStatus)
frisch()
gewaehlt = [0, 1]
anordnen("vert_w")
zeige("zwei")
PRINT GUI_TEXT(lblStatus)
EXIT(0)
