GET /mess/raum

=== abfrage wird aufgeloest
' %20 und + gehoeren zurueckuebersetzt -- sonst steht die Prozent-Schreibweise
' im Programm.
IMPORT "klient.dh"
DIM port AS INTEGER : port = serverStarten("srv.dh")
PRINT rumpf$(holen$(port, "GET", "/x?raum=Wohn%20zimmer&grad=21", "", ""))
serverEnde()
--- datei klient.dh
IMPORT "{sammlung}/_hilfen/httpklient.dh"

--- datei srv.dh
IMPORT "httpd"
DIM s AS HTTPD
s = HTTPD_START(0)
EPRINT("PORT=" + STR$(HTTPD_PORT(s)))
WHILE NOT HTTPD_ACCEPT(s)
    SLEEP(5)
WEND
HTTPD_SEND(s, 200, "text/plain", "[" + HTTPD_QUERY$(s, "raum") + "]")
HTTPD_STOP(s)

--- erwartet
[Wohn zimmer]

=== fehlende abfrage ist leer
' Was in einer Adresse steht, ist Benutzereingabe -- wie bei ARG$ ist ein
' Leerstring die richtige Antwort, kein Fehler.
IMPORT "klient.dh"
DIM port AS INTEGER : port = serverStarten("srv.dh")
PRINT rumpf$(holen$(port, "GET", "/x", "", ""))
serverEnde()
