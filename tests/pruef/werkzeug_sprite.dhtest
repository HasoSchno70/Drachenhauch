    WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
SUB prFall()
    DIM t AS INTEGER
    prKnopf(2, GUI_GET_X(bBildKopie), GUI_GET_Y(bBildKopie), 128)
    prKnopf(8, GUI_GET_X(bBildKopie), GUI_GET_Y(bBildKopie), 128)
    prKnopf(14, GUI_GET_X(bAnimNeu), GUI_GET_Y(bAnimNeu), 128)
    prKlick(24, GUI_GET_X(lstBild) + 40, GUI_GET_Y(lstBild) + 10)
    prKnopf(32, GUI_GET_X(bBildWeg), GUI_GET_Y(bBildWeg), 128)
    prAbspielen()
END SUB
SUB prProbe(k AS INTEGER)
    IF k = 21 THEN prMerke("mitte " + STR$(anzBild) + " bilder " + STR$(anzAnim) + " bereich " + STR$(anVon[0]) + ".." + STR$(anBis[0]))
    IF k >= 40 THEN
        prZaehlen()
        prSchreib(STR$(anzBild) + " bilder " + STR$(anzAnim) + " bereich " + STR$(anVon[0]) + ".." + STR$(anBis[0]))
    END IF
END SUB
