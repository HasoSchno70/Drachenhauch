=== projektliste: voller pfad, doppelt, entfernen, lesen
IMPORT "helfer.dh"
WRITEALL("a.pxs", "x")
DIM l AS kern.Projektliste : l = kern.projektlisteLaden("gibt_es_nicht.json")
PRINT "neu: "; l.hinzu("a.pxs"); " doppelt: "; l.hinzu(CWD$() + "/a.pxs"); " zahl "; LEN(l.pfade)
PRINT "voll: "; l.pfade[0] = REALPATH$("a.pxs")
l.entfernen("./a.pxs")
PRINT "entfernt: "; LEN(l.pfade)
WRITEALL("p.json", "{""version"": 1, ""projects"": [""x.pxs"", 3, null, [1], ""y.pxs""]}")
PRINT "gelesen: "; JOIN$(kern.projektlisteLaden("p.json").pfade, " | ")
WRITEALL("q.json", "{""projects"": ""x.pxs""}")
PRINT "keine liste: "; LEN(kern.projektlisteLaden("q.json").pfade)
