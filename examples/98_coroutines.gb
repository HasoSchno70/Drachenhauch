' 98_coroutines.gb -- Coroutines / YIELD.
'
' Eine FUNCTION/SUB mit YIELD im Body ist eine Coroutine. Ihr Aufruf fuehrt
' den Body NICHT aus, sondern liefert ein COROUTINE-Handle. Mit CORO_RESUME
' treibt man sie bis zum naechsten YIELD; CORO_SEND uebergibt dabei einen
' Wert, den der YIELD-Ausdruck im Body liefert (`x = YIELD ...`). RETURN
' beendet die Coroutine (Endwert via CORO_RESULT). FOR EACH konsumiert eine
' Coroutine eager bis zum Ende.
'
' Mechanismus: jede Coroutine laeuft auf einem eigenen Thread mit striktem
' Ping-Pong (immer nur einer laeuft) -- in allen drei Pfaden bit-identisch.

PRINT "=== Generator: yield 1..3 ==="

' Bei manuellem CORO_RESUME-Loop liefert der letzte (beendende) Aufruf den
' RETURN-Wert. Damit die Zuweisung an eine typisierte Variable klappt, gibt
' der Generator einen INTEGER zurueck (oder man nutzt FOR EACH, s.u.).
FUNCTION zaehler() AS INTEGER
    YIELD 1
    YIELD 2
    YIELD 3
    RETURN 0
END FUNCTION

DIM c AS COROUTINE
c = zaehler()
WHILE NOT CORO_DONE(c)
    DIM v AS INTEGER
    v = CORO_RESUME(c)
    IF NOT CORO_DONE(c) THEN PRINT "  yield:", v
WEND

PRINT ""
PRINT "=== FOR EACH konsumiert eine Coroutine ==="

DIM total AS INTEGER
total = 0
FOR EACH n IN zaehler()
    total = total + n
NEXT
PRINT "  Summe 1+2+3 =", total

PRINT ""
PRINT "=== send/return: Dialog mit der Coroutine ==="

FUNCTION akkumulator() AS INTEGER
    DIM sum AS INTEGER
    sum = 0
    WHILE TRUE
        DIM zugabe AS INTEGER
        zugabe = YIELD sum          ' gibt Summe ab, empfaengt naechsten Summanden
        sum = sum + zugabe
    WEND
END FUNCTION

DIM acc AS COROUTINE
acc = akkumulator()
PRINT "  Start:", CORO_RESUME(acc)  ' 0 (erster YIELD, send-Wert ignoriert)
PRINT "  +10  :", CORO_SEND(acc, 10)
PRINT "  +5   :", CORO_SEND(acc, 5)
PRINT "  +100 :", CORO_SEND(acc, 100)
CORO_CLOSE(acc)                      ' endlose Coroutine sauber abbauen

PRINT ""
PRINT "=== RETURN-Wert via CORO_RESULT ==="

FUNCTION countdown(start AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = start TO 1 STEP -1
        YIELD i
    NEXT
    RETURN -1                        ' Endwert
END FUNCTION

DIM cd AS COROUTINE
cd = countdown(3)
WHILE NOT CORO_DONE(cd)
    DIM x AS INTEGER
    x = CORO_RESUME(cd)
    IF NOT CORO_DONE(cd) THEN PRINT "  T-minus", x
WEND
PRINT "  Liftoff! Result =", CORO_RESULT(cd)

PRINT ""
PRINT "=== Coroutine-Methode mit Self ==="

CLASS Spawner
    DIM welle AS INTEGER
    SUB gegner()
        YIELD "Gegner Welle " + STR$(Self.welle) + " #1"
        YIELD "Gegner Welle " + STR$(Self.welle) + " #2"
    END SUB
END CLASS

DIM s AS Spawner
s = NEW Spawner()
s.welle = 7
DIM g AS COROUTINE
g = s.gegner()
PRINT "  " + CORO_RESUME(g)
PRINT "  " + CORO_RESUME(g)
