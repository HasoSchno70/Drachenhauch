' Particles-Einstieg: alle 60 Frames eine Explosion in der Mitte.
'
' Kein Asset noetig - Particles sind kleine Punkte/Kreise, die das Modul
' selbst zeichnet. Konfiguration einmal beim Setup, dann nur EMIT/UPDATE/DRAW.

IMPORT "particles"

CONST WIDTH    AS INTEGER = 320
CONST HEIGHT   AS INTEGER = 240
CONST BG_COLOR AS INTEGER = &H141E3C

DIM emitter AS PARTICLE_SYSTEM
emitter = PARTICLE_SYSTEM_NEW(WIDTH / 2, HEIGHT / 2)

' Geschwindigkeit: rundum, +/- 80 Pixel pro Sekunde
PARTICLE_SET_VELOCITY(emitter, -80, 80, -80, 80)
' Lebensdauer: zwischen 400 und 800 Millisekunden
PARTICLE_SET_LIFETIME(emitter, 400, 800)
' Warmes Orange
PARTICLE_SET_COLOR(emitter, &HFFAA00)
' Kleine Funken: 1 bis 3 Pixel
PARTICLE_SET_SIZE(emitter, 1, 3)
' Verblassen waehrend des Fluges
PARTICLE_SET_FADE(emitter, TRUE)

DIM tick AS INTEGER
tick = 0

SCREEN(WIDTH, HEIGHT, "Particle Demo", 2)

WHILE NOT QUITREQUESTED()
    tick = tick + 1

    ' Alle 60 Frames eine Explosion mit 30 Partikeln
    IF tick MOD 60 = 0 THEN
        PARTICLE_EMIT(emitter, 30)
    END IF

    ' Pro Frame: Partikel um 16ms (= 1 Frame bei 60 FPS) altern lassen
    PARTICLE_UPDATE(emitter, 16)

    CLS(BG_COLOR)
    PARTICLE_DRAW(emitter)
    FLIP()
    SLEEP(16)
WEND
