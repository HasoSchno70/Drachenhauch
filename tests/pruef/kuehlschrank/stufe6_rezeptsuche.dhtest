=== ablaufende im internet nach zutaten, schluessel, cache der uebersetzung
' "Im Internet suchen" bei den Ablaufenden gibt die Namen als Zutaten weiter
' (includeIngredients, englisch); der Katalog sucht dieselben Zutaten. Ein
' Schluessel aus der Umgebung gilt vor dem gespeicherten. Was einmal
' uebersetzt ist, fragt niemand mehr.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
DIM srv AS INTEGER : srv = kNetzStarten(ARG$(2))
PRINT "code "; kProbe(p, "probe.dh", "", 1500)
kOffEnde(srv)
DIM a AS STRING
IF FILEEXISTS(CWD$() + "/anfragen.txt") THEN
    FOR EACH a IN READLINES(CWD$() + "/anfragen.txt")
        IF a <> "" THEN PRINT "anfrage "; a
    NEXT
END IF
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
{sammlung}/../_hilfen/spoon_server.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
SUB warten(kf AS KatalogFenster)
    DIM n AS INTEGER
    WHILE (kf.sucheAbruf >= 0 OR LEN(kf.detailAbrufe) > 0 OR ueOffen() > 0) AND n < 900 AND studioBild()
        n = n + 1
    WEND
END SUB
PRINT "schluessel ["; spoonSchluessel$(); "]"
PRINT "mit leerzeichen "; spoonSchluesselSetzen("abc def"); " | gut "; spoonSchluesselSetzen(" testschluessel "); " | "; spoonSchluessel$(); " | gespeichert "; JOIN$(textListe("SELECT value FROM app_settings WHERE key = 'spoonacular_api_key'"), "")
SETENV("SPOONACULAR_API_KEY", "aus-der-umgebung")
PRINT "umgebung gilt "; spoonSchluessel$()
SETENV("SPOONACULAR_API_KEY", "")
' Zwei ablaufende Produkte, dann "Im Internet suchen".
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Fettarme Milch'), ('Tellerlinsen')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 1, 'Liter', '2026-11-09'), (1, 1, 'Liter', '2026-11-10'), (2, 500, 'g', '2026-11-10')")
DIM vf AS VorschlagFenster : vf = NEW VorschlagFenster()
vf.art = "ablauf"
vf.Zeigen()
vf.knopfInternet_Klick()
PRINT "suche ["; vf.suche; "]"
DIM kf AS KatalogFenster : kf = NEW KatalogFenster()
kf.vorgabeText = vf.suche
kf.vorgabeZutaten = TRUE
kf.Zeigen()
warten(kf)
PRINT GUI_DROPDOWN_SELECTED(kf.suchArt); " | "; GUI_TEXT(kf.sucheFeld); " | "; GUI_TEXT(kf.ergebnis)
DIM i AS INTEGER
FOR i = 0 TO GUI_TABLE_ROW_COUNT(kf.tabelle) - 1
    PRINT "  "; GUI_TABLE_GET_CELL(kf.tabelle, i, 0); " "; GUI_TABLE_GET_CELL(kf.tabelle, i, 1)
NEXT
GUI_TABLE_SET_SELECTED(kf.tabelle, GUI_TABLE_ROW_COUNT(kf.tabelle) - 1)
kf.tabelle_Geaendert()
warten(kf)
PRINT "ohne anleitung: "; REPLACE$(MID$(GUI_TEXT(kf.details), INSTR(GUI_TEXT(kf.details), "Zutaten:"), 999), CHR$(10), " / ")
kf.knopfSchliessen_Klick()
' Wie nach einem neuen Start (der Speicher ist leer), dieselbe Suche: die
' Titel kommen aus der Datei.
MAPCLEAR(ueDe)
ueGeladen = FALSE
DIM kf2 AS KatalogFenster : kf2 = NEW KatalogFenster()
kf2.vorgabeText = vf.suche
kf2.vorgabeZutaten = TRUE
kf2.Zeigen()
warten(kf2)
PRINT "zweites mal: "; GUI_TABLE_GET_CELL(kf2.tabelle, GUI_TABLE_ROW_COUNT(kf2.tabelle) - 1, 1)
END
--- erwartet
schluessel []
mit leerzeichen FALSE | gut TRUE | testschluessel | gespeichert "testschluessel"
umgebung gilt aus-der-umgebung
suche [Fettarme Milch, Tellerlinsen]
1 | Fettarme Milch, Tellerlinsen | 📋 4 Treffer: 🇩🇪 3 + 🌐 1
  🇩🇪 Kaiserschmarrn
  🇩🇪 Milchreis
  🇩🇪 Himmel und Erde
  🌐 DE: Milk Rice
ohne anleitung: Zutaten: /   • 1 l Milch /  / Zubereitung: / Keine Anleitung verfügbar. /  / 🌐 Quelle: Spoonacular -- https://example.org/104
zweites mal: DE: Milk Rice
