GUI_TOOLTIP(knopfSalve, "200 Teilchen auf einmal -- fuer Explosionen")
DIM folgtMaus AS GUI_WIDGET
folgtMaus = GUI_CHECKBOX(win, "folgt der Maus", 344, 434)

DIM lblPresets AS GUI_WIDGET
lblPresets = GUI_LABEL(win, "Werkseinstellungen", 16, 472)
DIM presetNamen AS ARRAY OF STRING
presetNamen = SPLIT$("Funken|Rauch|Feuer|Regen|Schnee|Explosion|Zauber|Springbrunnen", "|")
