' =====================================================================
'  Kaminfeuer -- gemuetliches Grafik-Demo (Vollbild)
'
'  Ein prozedurales, geschichtetes Partikel-Feuer (Flammen + heisser Kern +
'  Funken + Rauch) brennt vor einem echten Kaminbild, mit knisterndem
'  Feuer-Sound und warm flackerndem Licht.
'
'  Assets (frei, einmalig holen):   py fireplace\assets\download.py
'    fireplace.jpg  -- Steinkamin, Wikimedia Commons / CEllen (CC BY-SA 4.0)
'    fire.ogg       -- Knistern, Wikimedia Commons / Glaneur de sons (CC BY 3.0)
'  Laeuft auch OHNE die Dateien (prozeduraler Ersatz-Kamin, stumm).
'
'  ESC = beenden.   Native:  gbrun.py --native fireplace\fireplace.gb
' =====================================================================

IMPORT "particles"
IMPORT "imgfx"

CONST W = 1280
CONST H = 720
' Das 4:3-Kaminbild wird hoehenfuellend (960x720) zentriert -> Letterbox.
CONST IMGW = 960
CONST IMGX = 160
' Lage der Feuerstelle (auf den Holzscheiten, in Bildschirm-Koordinaten).
CONST FIRE_CX = 600.0
CONST FIRE_BASE = 516.0
CONST FIRE_WIDTH = 48.0

SCREEN(W, H, "Kaminfeuer")
SET_FULLSCREEN(TRUE)
RANDOMIZE(MILLIS())

' --- Hintergrund: echtes Kaminbild (skaliert) oder prozeduraler Ersatz ---
DIM has_bg AS BOOLEAN
DIM bg AS IMAGE
has_bg = FALSE
IF FILEEXISTS("assets/fireplace.jpg") THEN
    DIM raw AS IMAGE
    raw = LOADIMAGE("assets/fireplace.jpg")
    bg = IMAGE_SCALE(raw, IMGW, H)
    has_bg = TRUE
END IF

' --- Sound: knisterndes Feuer im Loop (volle Lautstaerke) ---
IF FILEEXISTS("assets/fire.ogg") THEN PLAYMUSIC("assets/fire.ogg", 0, 1.0)

' --- Wind: heult gelegentlich in Boeen ums Gemaeuer (ueber dem Feuer) ---
DIM has_wind AS BOOLEAN
DIM wind_snd AS SOUND
DIM wind_timer AS FLOAT
DIM wind_active AS BOOLEAN
DIM wind_dur AS FLOAT
has_wind = FALSE
IF FILEEXISTS("assets/wind.ogg") THEN
    wind_snd = LOADSOUND("assets/wind.ogg")
    has_wind = TRUE
END IF
wind_timer = RANDF(5.0, 11.0)
wind_active = FALSE
wind_dur = 0.0

' --- Feuer-Schichten (kompakt + fein) ----------------------------------
DIM ps_smoke AS PARTICLE_SYSTEM
ps_smoke = PARTICLE_SYSTEM_NEW(FIRE_CX, FIRE_BASE - 130.0)
PARTICLE_SET_VELOCITY(ps_smoke, -16.0, 16.0, -58.0, -30.0)
PARTICLE_SET_GRAVITY(ps_smoke, 0.0, -10.0)
PARTICLE_SET_LIFETIME(ps_smoke, 1200, 2200)
PARTICLE_SET_SIZE(ps_smoke, 10, 22)
PARTICLE_SET_COLOR(ps_smoke, &H241F1D)
PARTICLE_SET_COLOR_END(ps_smoke, &H070608)
PARTICLE_SET_FADE(ps_smoke, TRUE)
PARTICLE_SET_MODE(ps_smoke, "glow")

DIM ps_flame AS PARTICLE_SYSTEM
ps_flame = PARTICLE_SYSTEM_NEW(FIRE_CX, FIRE_BASE)
PARTICLE_SET_VELOCITY(ps_flame, -22.0, 22.0, -205.0, -130.0)
PARTICLE_SET_GRAVITY(ps_flame, 0.0, -45.0)
PARTICLE_SET_LIFETIME(ps_flame, 460, 850)
PARTICLE_SET_SIZE(ps_flame, 5, 12)
PARTICLE_SET_COLOR(ps_flame, &HFFD050)
PARTICLE_SET_COLOR_END(ps_flame, &HC81400)
PARTICLE_SET_FADE(ps_flame, TRUE)
PARTICLE_SET_MODE(ps_flame, "glow")

DIM ps_core AS PARTICLE_SYSTEM
ps_core = PARTICLE_SYSTEM_NEW(FIRE_CX, FIRE_BASE)
PARTICLE_SET_VELOCITY(ps_core, -12.0, 12.0, -150.0, -105.0)
PARTICLE_SET_GRAVITY(ps_core, 0.0, -42.0)
PARTICLE_SET_LIFETIME(ps_core, 260, 460)
PARTICLE_SET_SIZE(ps_core, 3, 6)
PARTICLE_SET_COLOR(ps_core, &HFFF6C8)
PARTICLE_SET_COLOR_END(ps_core, &HFF7000)
PARTICLE_SET_FADE(ps_core, TRUE)
PARTICLE_SET_MODE(ps_core, "glow")

DIM ps_spark AS PARTICLE_SYSTEM
ps_spark = PARTICLE_SYSTEM_NEW(FIRE_CX, FIRE_BASE)
PARTICLE_SET_VELOCITY(ps_spark, -45.0, 45.0, -210.0, -110.0)
PARTICLE_SET_GRAVITY(ps_spark, 0.0, 90.0)
PARTICLE_SET_LIFETIME(ps_spark, 450, 1000)
PARTICLE_SET_SIZE(ps_spark, 2, 2)
PARTICLE_SET_COLOR(ps_spark, &HFFF0A0)
PARTICLE_SET_COLOR_END(ps_spark, &HFF4000)
PARTICLE_SET_FADE(ps_spark, TRUE)
PARTICLE_SET_MODE(ps_spark, "streak")

DIM t AS FLOAT
t = 0.0
DIM last AS INTEGER
last = MILLIS()

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(KEY_ESCAPE) THEN BREAK
    DIM now AS INTEGER
    now = MILLIS()
    DIM dt AS INTEGER
    dt = now - last
    last = now
    IF dt < 1 THEN dt = 1
    IF dt > 80 THEN dt = 80
    DIM dts AS FLOAT
    dts = dt * 0.001
    t = t + dts

    ' Wind-Boeen: gelegentlich anspielen, nach einigen Sekunden wieder stoppen.
    IF has_wind THEN
        IF wind_active THEN
            wind_dur = wind_dur - dts
            IF wind_dur <= 0.0 THEN
                STOPSOUND(wind_snd)
                wind_active = FALSE
                wind_timer = RANDF(12.0, 26.0)
            END IF
        ELSE
            wind_timer = wind_timer - dts
            IF wind_timer <= 0.0 THEN
                PLAYSOUND(wind_snd, 0, RANDF(0.45, 0.8))
                wind_active = TRUE
                wind_dur = RANDF(7.0, 13.0)
            END IF
        END IF
    END IF

    DIM fl AS FLOAT
    fl = 0.72 + 0.18 * SIN(t * 8.0) + 0.10 * SIN(t * 19.0) + RANDF(-0.05, 0.05)
    IF fl < 0.4 THEN fl = 0.4
    IF fl > 1.2 THEN fl = 1.2

    ' --- Emission (schmale Feuerbasis, fein) ---
    DIM j AS INTEGER
    FOR j = 0 TO 3
        DIM jx AS FLOAT
        jx = RANDF(-FIRE_WIDTH, FIRE_WIDTH)
        PARTICLE_SET_POS(ps_flame, FIRE_CX + jx, FIRE_BASE - RANDF(0.0, 10.0))
        PARTICLE_EMIT(ps_flame, INT(2.5 * fl) + 1)
        PARTICLE_SET_POS(ps_core, FIRE_CX + jx * 0.5, FIRE_BASE)
        PARTICLE_EMIT(ps_core, 2)
    NEXT
    PARTICLE_SET_POS(ps_spark, FIRE_CX + RANDF(-32.0, 32.0), FIRE_BASE - RANDF(0.0, 40.0))
    IF RANDF(0.0, 1.0) < 0.5 THEN PARTICLE_EMIT(ps_spark, 1)
    PARTICLE_SET_POS(ps_smoke, FIRE_CX + RANDF(-22.0, 22.0), FIRE_BASE - 130.0)
    IF RANDF(0.0, 1.0) < 0.7 THEN PARTICLE_EMIT(ps_smoke, 1)

    PARTICLE_UPDATE(ps_smoke, dt)
    PARTICLE_UPDATE(ps_flame, dt)
    PARTICLE_UPDATE(ps_core, dt)
    PARTICLE_UPDATE(ps_spark, dt)

    ' ================= ZEICHNEN =================
    CLS(&H000000)                                  ' Letterbox-Balken
    IF has_bg THEN
        DRAWIMAGE(bg, IMGX, 0)
    ELSE
        BOX(FIRE_CX - 240, 150, FIRE_CX + 240, 660, &H3A302A)
        BOX(FIRE_CX - 185, 230, FIRE_CX + 185, 640, &H040302)
    END IF

    ' Warmes, kompaktes Flackerlicht (additiv).
    BLEND_MODE("add")
    DIM ring AS INTEGER
    FOR ring = 0 TO 3
        DIM rr AS INTEGER
        rr = INT((132 - ring * 26) * (0.85 + fl * 0.2))
        DIM rb AS INTEGER
        rb = INT((10 + ring * 6) * fl)
        CIRCLE(INT(FIRE_CX), INT(FIRE_BASE - 45.0), rr, RGB(rb, INT(rb * 0.5), INT(rb * 0.15)))
    NEXT
    BLEND_MODE("alpha")

    PARTICLE_DRAW(ps_smoke)
    PARTICLE_DRAW(ps_flame)
    PARTICLE_DRAW(ps_core)
    PARTICLE_DRAW(ps_spark)

    TEXT(10, H - 22, "Kamin: CEllen (CC BY-SA 4.0) . Feuer: Glaneur de sons (CC BY 3.0) . Wind: Tvabutzku1234 (CC0) . ESC", &H80706A)

    FLIP()
WEND
