=== zeiger lesen: text und bytes einer bibliothek
' Stufe 2: was eine Bibliothek als ZEIGER liefert, kopieren TEXT_AUS_ZEIGER$
' und BUFFER_AUS_ZEIGER heraus. _strdup/_wcsdup legen eine Kopie an, die
' free wieder freigibt -- so gehoert der Speicher eindeutig der Bibliothek.
DECLARE FUNCTION GetCommandLineW LIB "kernel32" () AS ZEIGER
DECLARE FUNCTION GetCommandLineA LIB "kernel32" () AS ZEIGER
DECLARE FUNCTION strdup LIB "c" ALIAS "_strdup" (s AS TEXT) AS ZEIGER
DECLARE FUNCTION wcsdup LIB "c" ALIAS "_wcsdup" (s AS WTEXT) AS ZEIGER
DECLARE SUB free LIB "c" (z AS ZEIGER)
PRINT INSTR(TEXT_AUS_ZEIGER$(GetCommandLineW(), TRUE), ".dh") > 0
PRINT INSTR(TEXT_AUS_ZEIGER$(GetCommandLineA()), ".dh") > 0
DIM z AS INTEGER
z = strdup("Grüße")
PRINT TEXT_AUS_ZEIGER$(z)
DIM b AS BUFFER
b = BUFFER_AUS_ZEIGER(z, 8)
' sieben Bytes UTF-8 und die Null dahinter
PRINT BUFFER_LEN(b), BUFFER_GET(b, 0), BUFFER_GET(b, 2), BUFFER_GET(b, 7)
free(z)
z = wcsdup("Grüße 🐉")
PRINT TEXT_AUS_ZEIGER$(z, TRUE)
' UTF-16: das Ue und die Ersatzzeichen des Drachen
b = BUFFER_AUS_ZEIGER(z, 18)
PRINT BUFFER_GET_U16(b, 4), BUFFER_GET_U16(b, 12), BUFFER_GET_U16(b, 16)
free(z)
--- system windows
--- erwartet
TRUE
TRUE
Grüße
8 71 195 0
Grüße 🐉
252 55357 0

=== zeiger lesen auf linux und macos
DECLARE FUNCTION strdup LIB "c" (s AS TEXT) AS ZEIGER
DECLARE FUNCTION wcsdup LIB "c" (s AS WTEXT) AS ZEIGER
DECLARE SUB free LIB "c" (z AS ZEIGER)
DIM z AS INTEGER
z = strdup("Grüße")
PRINT TEXT_AUS_ZEIGER$(z)
DIM b AS BUFFER
b = BUFFER_AUS_ZEIGER(z, 8)
PRINT BUFFER_LEN(b), BUFFER_GET(b, 0), BUFFER_GET(b, 2), BUFFER_GET(b, 7)
free(z)
' wchar_t ist hier 32 Bit breit: der Drache ist EIN Zeichen
z = wcsdup("Grüße 🐉")
PRINT TEXT_AUS_ZEIGER$(z, TRUE)
b = BUFFER_AUS_ZEIGER(z, 32)
PRINT BUFFER_GET_U32(b, 8), BUFFER_GET_U32(b, 24), BUFFER_GET_U32(b, 28)
free(z)
