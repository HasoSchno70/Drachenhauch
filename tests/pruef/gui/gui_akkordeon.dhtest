=== das akkordeon steht vollstaendig in der form
IMPORT "gui"
SCREEN(400, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 400, 400)
DIM acc AS GUI_WIDGET : acc = GUI_ACCORDION(w, 10, 10, 300, 300)
GUI_ACCORDION_SET(acc, "mehrere", 1)
GUI_ACCORDION_ADD(acc, "Oben")
GUI_ACCORDION_ADD(acc, "Unten")
DIM b AS GUI_WIDGET : b = GUI_TEXTINPUT(w, 12, 8, 200, 26, "")
GUI_ACCORDION_ADD_WIDGET(acc, b, 1)
GUI_ACCORDION_OPEN(acc, 0, TRUE)
GUI_ACCORDION_OPEN(acc, 1, TRUE)
GUI_ACCORDION_SET_HEIGHT(acc, 0, 50)
GUI_UPDATE()
DIM y1 AS INTEGER : y1 = GUI_GET_Y(b)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(GUI_TO_JSON(w))
GUI_WINDOW_VISIBLE(w, FALSE)
GUI_UPDATE()
DIM a2 AS GUI_WIDGET : a2 = GUI_WINDOW_WIDGET(w2, 0)
DIM b2 AS GUI_WIDGET : b2 = GUI_WINDOW_WIDGET(w2, 1)
PRINT GUI_KIND(a2); " "; GUI_ACCORDION_COUNT(a2); " "; GUI_ACCORDION_TITLE$(a2, 1)
PRINT "offen "; GUI_ACCORDION_IS_OPEN(a2, 0); " "; GUI_ACCORDION_IS_OPEN(a2, 1)
PRINT "gleiche lage "; (GUI_GET_Y(b2) = y1)
--- erwartet
accordion 2 Unten
offen TRUE TRUE
gleiche lage TRUE
