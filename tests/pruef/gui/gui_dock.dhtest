' Dock (GUI_DOCK, gui_dock.rs): Leisten links, rechts und unten, mehrere
' als Reiter in einer Gruppe, Trennlinien, Ziehen an einen anderen Ort,
' Abtrennen als schwebende Leiste, ein Fenster als Inhalt, Stand speichern.
'
' Der Aufbau steht in _hilfen/dockaufbau.dh (800x600, links Projekt und
' Gliederung, unten Ausgabe|Terminal und Probleme, Rand 8, Kopf 22), die
' Mauswege in _hilfen/dockmaus.dh -- die Lagen der Reiter kommen zur
' Laufzeit aus GUI_DOCK_TAB_RECT, weil ihre Breite an der Schrift haengt.

=== die vorgabe teilt die flaeche
IMPORT "hilfe.dh"
DIM n AS STRING
FOR EACH n IN daNamen
    PRINT n; ": "; daRect$(n); " "; GUI_DOCK_SHOWN(w, n); " "; GUI_DOCK_WHERE$(w, n)
NEXT
DIM x AS INTEGER
DIM y AS INTEGER
DIM b AS INTEGER
DIM h AS INTEGER
(x, y, b, h) = GUI_DOCK_CENTER(w)
PRINT "mitte: "; x; " "; y; " "; b; " "; h
PRINT "groessen "; GUI_DOCK_GET_SIZE(w, "links"); " "; GUI_DOCK_GET_SIZE(w, "unten")
' Die Liste des hinteren Reiters liegt auf derselben Stelle -- getroffen
' wird trotzdem die der vorderen, die hintere blendet das Dock aus.
GUI_SET_BOUNDS(daListe[3], 10, 424, 384, 174)
PRINT "getroffen wird die vordere liste "; GUI_HIT_TEST(100, 480) = daListe[2]
--- datei hilfe.dh
IMPORT "{sammlung}/_hilfen/dockmaus.dh"
IMPORT "{sammlung}/_hilfen/dockaufbau.dh"
--- umgebung
DHRT_FRAMES=2
--- erwartet
projekt: 8 22 224 173 TRUE links
gliederung: 8 225 224 173 TRUE links
ausgabe: 8 422 388 178 TRUE unten
terminal: 0 0 0 0 FALSE unten
probleme: 404 422 388 178 TRUE unten
mitte: 240 0 560 398
groessen 240 200
getroffen wird die vordere liste TRUE

=== ein klick auf einen reiter holt ihn nach vorn
IMPORT "hilfe.dh"
DIM bild AS INTEGER
DIM geaendert AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN
        geaendert = geaendert + 1
        daVerteilen()
    END IF
    bild = bild + 1
    IF bild = 3 THEN
        geaendert = 0
        dmKlick(daReiterX("terminal"), daReiterY("terminal"))
        dmSpielen()
    END IF
    IF bild = 30 THEN
        PRINT "terminal "; daRect$("terminal"); " "; GUI_DOCK_SHOWN(w, "terminal")
        PRINT "ausgabe "; GUI_DOCK_SHOWN(w, "ausgabe")
        PRINT "gemeldet "; geaendert
        PRINT "die liste darunter ist die des terminals "; GUI_HIT_TEST(100, 480) = daListe[3]
        EXIT(0)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei hilfe.dh
IMPORT "{sammlung}/_hilfen/dockmaus.dh"
IMPORT "{sammlung}/_hilfen/dockaufbau.dh"
--- umgebung
DHRT_FRAMES=60
--- erwartet
terminal 8 422 388 178 TRUE
ausgabe FALSE
gemeldet 1
die liste darunter ist die des terminals TRUE

=== ein reiter an den rechten rand gezogen bekommt den bereich dort
IMPORT "hilfe.dh"
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN daVerteilen()
    bild = bild + 1
    IF bild = 3 THEN
        dmZug(daReiterX("probleme"), daReiterY("probleme"), 790, 200, 8)
        dmSpielen()
    END IF
    IF bild = 40 THEN
        PRINT "probleme "; GUI_DOCK_WHERE$(w, "probleme"); " "; daRect$("probleme")
        PRINT "ausgabe "; daRect$("ausgabe")
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM b AS INTEGER
        DIM h AS INTEGER
        (x, y, b, h) = GUI_DOCK_CENTER(w)
        PRINT "mitte "; x; " "; y; " "; b; " "; h
        EXIT(0)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
