Hallo, Drache! (2. Gruss)
Tooltip: Sagt Hallo
Gruesse: 2

=== variadisch: sprintf mit allen arten von werten
' `...` am Ende der Parameter nimmt beliebig viele weitere Werte; ihr Typ
' kommt aus dem Wert (INTEGER, FLOAT, Text, BUFFER, NIL). Unter Windows
' liegt die printf-Familie in msvcrt, nicht in ucrtbase -- daher "msvcrt|c".
' Elf Werte gemischt: einige reisen auf dem Stapel statt in Registern.
DECLARE FUNCTION sprintf LIB "msvcrt|c" (ziel AS BUFFER, format AS TEXT, ...) AS LONG
DIM b AS BUFFER
b = BUFFER_NEW(256)
PRINT sprintf(b, "%d|%s|%.2f|%lld|%c|%x", 42, "Drache", 3.14159, 1234567890123, 65, 255)
PRINT TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
PRINT sprintf(b, "%d %d %d %d %d %.1f %.1f %.1f %d %s %.3f", 1, 2, 3, 4, 5, 6.5, 7.5, 8.5, 9, "zehn", 11.25)
PRINT TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
PRINT sprintf(b, "%.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f", 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 10.5)
PRINT TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
PRINT sprintf(b, "ohne weitere")
PRINT TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
--- erwartet
33
42|Drache|3.14|1234567890123|A|ff
35
1 2 3 4 5 6.5 7.5 8.5 9 zehn 11.250
40
1.5 2.5 3.5 4.5 5.5 6.5 7.5 8.5 9.5 10.5
12
ohne weitere

