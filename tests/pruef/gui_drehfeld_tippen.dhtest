=== buchstaben fallen weg, der fokus woanders uebernimmt
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM sp AS GUI_WIDGET
sp = GUI_SPINNER(w, 10, 10, 120, -50, 50, 5, 1)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 60, 200, 26)
GUI_FOCUS(sp)
CLIPBOARD_SET("ab-70x")
DIM f AS INTEGER
FOR f = 1 TO 14
    GUI_UPDATE()
    IF f = 6 THEN PRINT f; " "; GUI_VALUE(sp)
    IF f = 8 THEN GUI_FOCUS(tf)
    IF f = 12 THEN PRINT f; " "; GUI_VALUE(sp)
    GUI_DRAW()
    FLIP()
NEXT
--- datei ev.txt
