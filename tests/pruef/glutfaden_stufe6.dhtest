--- erwartet
rueckgabe 0
pat: Aus PCStitch eingelesen -- Siche | ebenen 2 stiche 7 rueckstiche 3 datei leer TRUE
xsd: TRUE Aus Pattern Maker eingelesen -- Sich | farben 3 blend TRUE
diamond: diamond stoff 10.0 | ◆ Diamond | DMC Diamond Painting | verlauf leer TRUE ungesichert TRUE
zurueck: stitch stoff 18.0 | ✕ Kreuzstich | dasselbe garn TRUE
fotos: TRUE TRUE TRUE

=== diamond: hin und zurueck wie pysticky
IMPORT "helfer.dh"
' Die Erwartung ist PyStickys Ausgabe (Pattern.convert_to_mode: hin, zurueck,
' wieder hin) fuer probe.pxs und demo_kreuzstich.pxs -- Garne, Drill-Flags,
' Stichtypen je Ebene, Stoff und der gemerkte Aida-Stoff.
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
FUNCTION pb$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "True", "False")
END FUNCTION
SUB zeigen(m AS kern.Muster, titel AS STRING)
    DIM sfc AS STRING : sfc = "None"
    IF JSON_TYPE(m.metadaten, "stitch_fabric_count") = "number" THEN sfc = STR$(JSON_GET_INT(m.metadaten, "stitch_fabric_count"))
    PRINT "== "; titel; " "; m.modus; " "; INT(m.stoff); " "; sfc
    DIM i AS INTEGER
    FOR i = 0 TO LEN(m.farben) - 1
        DIM f AS kern.Farbeintrag : f = m.farben[i]
        PRINT "farbe "; i; " "; f.garn.name; " | "; f.garn.hersteller; " | "; f.garn.nummer; " | "; kern.farbeAlsHex$(f.garn.farbe); " | "; pb$(f.istDiamant); " "; pb$(f.istPerle)
    NEXT
    FOR i = 0 TO m.ebenen.anzahl() - 1
        DIM eb AS kern.Ebene : eb = m.ebenen.ebenen[i]
        DIM z AS MAP OF INTEGER : z = {}
        DIM k AS INTEGER
        FOR k = 0 TO LEN(eb.raster) - 1
            IF eb.raster[k] < 0 THEN CONTINUE
            DIM s AS STRING : s = RIGHT$("000" + STR$(eb.raster[k]), 3) + ":" + RIGHT$("000" + STR$(eb.art[k]), 3)
            MAPPUT(z, s, IIF(MAPHAS(z, s), MAPGET(z, s), 0) + 1)
        NEXT
        DIM schl AS ARRAY OF STRING : schl = MAPKEYS(z)
        SORT(schl)
        DIM t AS STRING : t = "ebene " + STR$(i)
        DIM q AS STRING
        FOR EACH q IN schl
            t = t + " " + STR$(VAL(LEFT$(q, 3))) + ":" + STR$(VAL(RIGHT$(q, 3))) + "=" + STR$(MAPGET(z, q))
        NEXT
        PRINT t
    NEXT
END SUB
DIM datei AS STRING
FOR EACH datei IN ["probe.pxs", ARG$(0) + "/daten/muster/demo_kreuzstich.pxs"]
    DIM m AS kern.Muster : m = kern.pxsLaden(datei)
    zeigen(m, "start")
    kern.modusWechseln(m, "diamond", pal) : zeigen(m, "diamond")
    kern.modusWechseln(m, "stitch", pal) : zeigen(m, "stitch")
    kern.modusWechseln(m, "diamond", pal) : zeigen(m, "diamond2")
NEXT
