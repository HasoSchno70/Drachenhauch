' Aus test_funcref.py uebertragen (18 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== funcref basic (1)
FUNCTION square(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION

DIM f AS FUNCREF
f = square
PRINT f(5)
--- erwartet
25

=== funcref basic (2)
FUNCTION square(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION

DIM f AS FUNCREF
f = square
PRINT f(5)
--- erwartet
25

=== funcref reassign (1)
FUNCTION square(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION

FUNCTION cube(x AS INTEGER) AS INTEGER
    RETURN x * x * x
END FUNCTION

DIM f AS FUNCREF
f = square
PRINT f(4)
f = cube
PRINT f(3)
--- erwartet
16
27

=== funcref reassign (2)
