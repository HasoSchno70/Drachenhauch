' Rechts nach links, Stufe 1 (GUI_WINDOW_RTL; gui_geometrie.rs `abs_rect`,
' gui_zeichnen.rs `menubar_slots`): die Lage der Widgets gespiegelt an der
' Breite des Fensters, die Menueleiste von rechts. Das Programm sieht
' weiter seine eigenen Lagen; Treffer, Klick und Zeichnen gehen ueber
' dieselbe gespiegelte Stelle.
' Format: docs/werkzeuge.md, dhrt test.

=== gespiegelt trifft der knopf rechts und das programm sieht seine lage
TRY
    SCREEN(480, 220, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 480, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "Los", 20, 80, 120, 34)
PRINT "vorher rtl "; GUI_WINDOW_IS_RTL(w); " links "; GUI_HIT_TEST(80, 97) = b; " rechts "; GUI_HIT_TEST(400, 97) = b
GUI_WINDOW_RTL(w, TRUE)
GUI_UPDATE()
PRINT "rtl "; GUI_WINDOW_IS_RTL(w); " links "; GUI_HIT_TEST(80, 97) = b; " rechts "; GUI_HIT_TEST(400, 97) = b; " lage "; GUI_GET_X(b)
GUI_WINDOW_RTL(w, FALSE)
PRINT "zurueck rechts "; GUI_HIT_TEST(400, 97) = b
--- erwartet
vorher rtl FALSE links TRUE rechts FALSE
rtl TRUE links FALSE rechts TRUE lage 20
zurueck rechts FALSE

=== ein klick rechts drueckt den gespiegelten knopf und die menueleiste beginnt rechts
IMPORT "gui"
SCREEN(480, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 480, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM it AS INTEGER : it = GUI_MENU_ITEM(m, "Speichern")
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "Los", 20, 80, 120, 34)
GUI_WINDOW_RTL(w, TRUE)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER
DIM log AS STRING
FOR n = 1 TO 40
    GUI_UPDATE()
    IF GUI_CLICKED(b) THEN log = log + " knopf"
    IF GUI_CLICKED(it) THEN log = log + " speichern"
    CLS(0) : GUI_DRAW() : FLIP()
NEXT
PRINT "folge"; log
--- datei ev.txt
c 9
e 0 7 400 120 0 0
e 2 6 0 0 0 0
e 3 5 0 0 0 0
e 8 7 460 10 0 0
e 9 6 0 0 0 0
e 10 5 0 0 0 0
e 16 7 440 36 0 0
e 17 6 0 0 0 0
e 18 5 0 0 0 0

--- umgebung
DHRT_FRAMES=50
--- erwartet
folge knopf speichern

=== stufe 2 kennzeichen rechts werkzeugleiste von rechts regler waechst nach links
TRY
    SCREEN(480, 260, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 480, 260)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(w, 0, 0, 480, 32)
GUI_TOOLBAR_ADD(tb, "neu", "Neu")
GUI_TOOLBAR_ADD(tb, "sichern", "Sichern")
DIM c AS GUI_WIDGET : c = GUI_CHECKBOX(w, "Merken", 20, 50, TRUE)
GUI_SET_NAME(c, "c")
DIM s AS GUI_WIDGET : s = GUI_SLIDER(w, 20, 180, 300, 0, 10, 0)
GUI_STYLESHEET("#c { accent: #FF0000 }")
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(480, 260)
FUNCTION rot_bei(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    RENDERTARGET_BEGIN(rt) : CLS(0) : GUI_DRAW() : RENDERTARGET_END()
    DIM bild AS IMAGE : bild = RENDERTARGET_IMAGE(rt)
    RETURN (GETPIXEL(bild, x, y) BAND &HFFFFFF) = &HFF0000
END FUNCTION
GUI_UPDATE() : GUI_UPDATE()
DIM cy AS INTEGER : cy = GUI_GET_Y(c) + GUI_GET_H(c) \ 2
DIM cl AS INTEGER : cl = GUI_GET_X(c) + 6
DIM cr AS INTEGER : cr = GUI_GET_X(c) + GUI_GET_W(c) - 6
PRINT "ltr kaestchen links "; rot_bei(cl, cy); " rechts "; rot_bei(cr, cy); " erster knopf vorn "; GUI_TOOLBAR_ITEM_X(tb, 0) < GUI_TOOLBAR_ITEM_X(tb, 1)
GUI_WINDOW_RTL(w, TRUE)
GUI_UPDATE() : GUI_UPDATE()
PRINT "rtl kaestchen links "; rot_bei(cl, cy); " rechts "; rot_bei(480 - 20 - 6, cy); " erster knopf vorn "; GUI_TOOLBAR_ITEM_X(tb, 0) < GUI_TOOLBAR_ITEM_X(tb, 1)
--- erwartet
ltr kaestchen links TRUE rechts FALSE erster knopf vorn TRUE
rtl kaestchen links FALSE rechts TRUE erster knopf vorn FALSE

=== gespiegelt nimmt der regler den wert von rechts und links heisst mehr
IMPORT "gui"
SCREEN(480, 260, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 480, 260)
GUI_WINDOW_CHROME(w, FALSE)
DIM s AS GUI_WIDGET : s = GUI_SLIDER(w, 20, 100, 300, 0, 10, 5)
GUI_SET_BOUNDS(s, 20, 100, 300, 24)
GUI_WINDOW_RTL(w, TRUE)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER
DIM nach_klick AS FLOAT : nach_klick = -1
FOR n = 1 TO 30
    GUI_UPDATE()
    IF n = 6 THEN nach_klick = GUI_VALUE(s)
    CLS(0) : GUI_DRAW() : FLIP()
NEXT
PRINT "klick rechts aussen "; nach_klick; " nach pfeil links "; GUI_VALUE(s)
--- datei ev.txt
c 5
e 0 7 459 112 0 0
e 2 6 0 0 0 0
e 3 5 0 0 0 0
e 10 2 263 0 0 0
e 11 1 263 0 0 0

--- umgebung
DHRT_FRAMES=40
--- erwartet
klick rechts aussen 0.0 nach pfeil links 0.5
