=== objekt als local einer funktion
CLASS Summe
    DIM wert AS INTEGER
    DIM zahl AS INTEGER
END CLASS
FUNCTION rechne(n AS INTEGER) AS INTEGER
    DIM s AS Summe
    s = NEW Summe()
    DIM i AS INTEGER
    FOR i = 1 TO n
        s.wert = s.wert + i * i
        s.zahl = s.zahl + 1
    NEXT
    RETURN s.wert * 1000 + s.zahl
END FUNCTION
PRINT rechne(10); " "; rechne(3)
