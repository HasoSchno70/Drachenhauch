' Der Wortanfang links der Marke -- so viel wird beim Uebernehmen ersetzt.
FUNCTION wortAnfang$() AS STRING
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN ""
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN ""
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    DIM a AS INTEGER : a = s - 1
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    RETURN MID$(zeile, a, s - 1 - a)
END FUNCTION

