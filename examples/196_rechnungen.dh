' ============================================================
'  Rechnungen -- eine Geschaeftsanwendung in Drachenhauch (sechster Pilot)
' ============================================================
'  Kein Editor und kein Spiel: Kunden, Artikel und Rechnungen mit
'  Positionen, SQLite als Wahrheit, PDF und CSV als Ausgabe. Der Pilot
'  soll zeigen, was dem gui-Modul fuer eine ANWENDUNG noch fehlt -- nach
'  den sechs Ausbaustufen vom September 2026.
'
'  Was drin ist:
'    * drei Reiter (Kunden / Artikel / Rechnungen), Menueleiste mit
'      Kuerzeln, Statuszeile, groessenveraenderbares Fenster (Anker +
'      Layout-Behaelter)
'    * Tabellen mit Filterzeile und Sortierung; jede Zeile merkt sich
'      ihre Datenbank-id (Sortieren/Filtern stellt Datenzeilen nicht um)
'    * Kunden-Formular ueber Datenbindung: GUI_BIND je Feld, GUI_FORM_LOAD /
'      GUI_FORM_SAVE / GUI_FORM_CHANGED erledigen Laden, Speichern und die
'      Frage "geaendert?" -- keine Spaltenliste mehr im Programm. Der
'      Artikel rechnet Preis (Cent) und MwSt um und bleibt darum von Hand,
'      nutzt die Bindung aber fuer die Aenderungserkennung
'    * Notiz je Kunde in einem Textbereich mit Zeilenumbruch
'    * Formulare mit Pruefung ueber GUI_RULE / GUI_VALIDATE (Pflichtfeld,
'      PLZ, E-Mail, Zahl, Datum -- die Meldung steht in einer Beschriftung
'      und im Tooltip, das falsche Feld bekommt den Fokus), Enter speichert;
'      Wechsel mit ungesicherten Aenderungen fragt nach
'      (Speichern | Verwerfen | Abbrechen)
'    * Rechnung: Positionen in einer Tabelle, Menge direkt in der Zelle
'      editierbar, Netto/MwSt/Brutto in CENT gerechnet (nie in FLOAT --
'      INT(19.99 * 100) ist 1998), PDF ueber das pdf-Modul, CSV-Export
'    * Einstellungen in einem eigenen modalen Fenster mit rollendem Panel
'
'  Die Datenbank `rechnungen.db` entsteht neben dem Programm, beim ersten
'  Start mit Beispieldaten. [Strg+Q] Ende
' ============================================================
IMPORT "gui"
IMPORT "db"
IMPORT "pdf"

SCREEN(1120, 680, "Drachenhauch - Rechnungen", 1)
SETFPS(60)
WINDOW_RESIZABLE(TRUE)

DIM uiFont AS INTEGER : uiFont = -1
DIM fp AS STRING
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "C:/Windows/Fonts/calibri.ttf", "C:/Windows/Fonts/arial.ttf")
    IF uiFont < 0 AND FILEEXISTS(fp) THEN uiFont = LOADFONT(fp, 32)
NEXT
IF uiFont >= 0 THEN SETFONT(uiFont)
TEXT_SIZE(16)
GUI_THEME_PRESET("glas_dunkel")

CONST DBDATEI = "rechnungen.db"
CONST MAXZ = 500            ' Zeilen je Tabelle
CONST MAXPOS = 60           ' Positionen je Rechnung
CONST KOPF = 60             ' Menueleiste + Reiterleiste (Schaetzung fuer die Grundmasse)
DIM SW AS INTEGER : SW = SCREENWIDTH()
DIM SH AS INTEGER : SH = SCREENHEIGHT()
DIM ROT AS INTEGER : ROT = RGB(240, 100, 100)
DIM GRUEN AS INTEGER : GRUEN = RGB(120, 220, 140)

' ============================================================ Geld
' Geld ist eine ganze Zahl in CENT. Der Weg ueber FLOAT sieht harmlos aus
' und ist es nicht: INT(19.99 * 100) ergibt 1998.
DIM waehrung AS STRING : waehrung = "EUR"

FUNCTION geld$(cent AS INTEGER) AS STRING
    DIM neg AS BOOLEAN : neg = cent < 0
    IF neg THEN cent = -cent
    DIM euro AS INTEGER : euro = cent \ 100
    DIM rest AS INTEGER : rest = cent MOD 100
    ' Tausenderpunkte von rechts einsetzen.
    DIM e$ AS STRING : e$ = STR$(euro)
    DIM aus AS STRING : aus = ""
    DIM n AS INTEGER : n = 0
    DIM i AS INTEGER
    FOR i = LEN(e$) - 1 TO 0 STEP -1
        aus = MID$(e$, i, 1) + aus
        n = n + 1
        IF n MOD 3 = 0 AND i > 0 THEN aus = "." + aus
    NEXT
    RETURN IIF(neg, "-", "") + aus + "," + FORMAT$(rest, "%02d") + " " + waehrung
END FUNCTION

' "12,50", "12.50", "12" und " 1.234,56 " -> Cent. Ungueltiges -> -1.
FUNCTION centVon(text AS STRING) AS INTEGER
    DIM s AS STRING : s = TRIM$(text)
    IF s = "" THEN RETURN -1
    ' Deutsche Schreibweise: Punkt als Tausender, Komma als Dezimaltrenner.
    IF INSTR(s, ",") >= 0 THEN
        s = s.replace(".", "")
        s = s.replace(",", ".")
    END IF
    DIM i AS INTEGER
    FOR i = 0 TO LEN(s) - 1
        IF INSTR("0123456789.", MID$(s, i, 1)) < 0 THEN RETURN -1
    NEXT
    RETURN INT(VAL(s) * 100.0 + 0.5)
END FUNCTION

' ============================================================ Datenbank
DIM db AS DB_CONN
DIM neuAngelegt AS BOOLEAN : neuAngelegt = NOT FILEEXISTS(DBDATEI)
db = DB_OPEN(DBDATEI)
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL, strasse TEXT, plz TEXT, ort TEXT, email TEXT, notiz TEXT)")
' Eine Datenbank aus der Zeit vor der Notiz bekommt die Spalte nachgereicht;
' gibt es sie schon, meldet SQLite das -- und genau das darf hier still sein.
TRY
    DB_EXEC(db, "ALTER TABLE kunden ADD COLUMN notiz TEXT")
CATCH e
END TRY
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS artikel (id INTEGER PRIMARY KEY, bezeichnung TEXT NOT NULL, preis_cent INTEGER NOT NULL, mwst INTEGER NOT NULL)")
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS rechnungen (id INTEGER PRIMARY KEY, nummer TEXT NOT NULL UNIQUE, kunde_id INTEGER NOT NULL, datum TEXT NOT NULL, bezahlt INTEGER NOT NULL DEFAULT 0)")
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS positionen (id INTEGER PRIMARY KEY, rechnung_id INTEGER NOT NULL, bezeichnung TEXT NOT NULL, menge INTEGER NOT NULL, preis_cent INTEGER NOT NULL, mwst INTEGER NOT NULL)")
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS einstellungen (key TEXT PRIMARY KEY, wert TEXT NOT NULL)")

SUB einstSetzen(k AS STRING, v AS STRING)
    DB_EXEC(db, "INSERT OR REPLACE INTO einstellungen (key, wert) VALUES (?, ?)", k, v)
END SUB

FUNCTION einst$(k AS STRING, vorgabe AS STRING) AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT wert FROM einstellungen WHERE key = ?", k)
    DIM aus AS STRING : aus = vorgabe
    IF DB_NEXT(r) THEN aus = DB_GET_STRING(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN aus
END FUNCTION

