DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '')")
DB_EXEC(db, "CREATE TABLE rechnungen (id INTEGER PRIMARY KEY, betrag INTEGER, kunde INTEGER)")
DB_CLOSE(db)
