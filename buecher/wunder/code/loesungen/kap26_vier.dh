' Loesung zu Kapitel 26, Erfinden: eine vierte Szene. Nach dem Flug
' kommt das Sonnensystem aus Kapitel 24 -- als eigene Datei,
' kap26_sonne.dh, eingebunden wie die anderen.
' Die Stellen, die neu sind, stehen zwischen >>> und <<<.
IMPORT "audio"
IMPORT "../kap26/musik.dh" AS musik
IMPORT "../kap26/titel.dh" AS titel
IMPORT "../kap26/flug.dh" AS flug
IMPORT "../kap26/abspann.dh" AS abspann
' >>> neu
IMPORT "kap26_sonne.dh" AS sonne
' <<< neu

CONST BREITE = 800
CONST HOEHE = 500
' Wie lange jede Szene dauert, und wie lange es dazwischen dunkel wird.
CONST BLENDE = 1.0
' >>> neu
DIM dauer AS ARRAY OF FLOAT : dauer = [9.6, 19.2, 12, 16]
' <<< neu

SCREEN(BREITE, HOEHE, "Kleine Wunder -- die Demo")
RANDOMIZE(26)
titel.vorbereiten()
flug.vorbereiten()
abspann.vorbereiten()
' >>> neu
sonne.vorbereiten()
' <<< neu

' Das Leuchten aus Kapitel 15, ueber jedes Bild gelegt.
DIM glanz AS INTEGER : glanz = SHADER_LOAD("../kap26/assets/glanz.fs")
SHADER_SET2(glanz, "groesse", BREITE, HOEHE)
SHADER_SET(glanz, "staerke", 1.2)
POSTFX(glanz)

DIM kanal AS AUDIO_CHANNEL : kanal = AUDIO_PLAY(musik.stueck(), -1)
DIM szene AS INTEGER
DIM zeit AS FLOAT

WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE) _
      AND szene < LEN(dauer)
    zeit = zeit + DELTA()
    IF KEY_HIT(KEY_SPACE) THEN zeit = dauer[szene]
    ' Ist die Szene vorbei, kommt die naechste.
    IF zeit >= dauer[szene] THEN
        ' >>> neu
        IF szene = 1 THEN flug.beenden()
        IF szene = 2 THEN sonne.beenden()
        szene = szene + 1
        zeit = 0
        IF szene = 2 THEN sonne.beginnen()
        ' Ueber der Landschaft leuchtet es weniger, sonst blendet es.
        SHADER_SET(glanz, "staerke", IIF(szene = 1, 0.4, 1.2))
        ' Die Musik klingt im Abspann aus -- jetzt die vierte Szene.
        IF szene = 3 THEN AUDIO_STOP(kanal, INT(dauer[3] * 1000))
        ' <<< neu
        IF szene = LEN(dauer) THEN EXIT WHILE
    END IF

    ' >>> neu
    SELECT CASE szene
        CASE 0 : titel.zeichnen(zeit)
        CASE 1 : flug.zeichnen(zeit)
        CASE 2 : sonne.zeichnen(zeit)
        CASE 3 : abspann.zeichnen(zeit)
    END SELECT
    ' <<< neu

    ' Die Blende: am Anfang und am Ende jeder Szene ein Schwarz, das
    ' kommt und geht.
    DIM rest AS FLOAT : rest = MIN(zeit, dauer[szene] - zeit)
    DIM dunkel AS FLOAT : dunkel = CLAMP(1 - rest / BLENDE, 0, 1)
    BOX(0, 0, BREITE, HOEHE, RGBA(0, 0, 0, INT(dunkel * 255)))
    FLIP()
WEND
