' Umstieg aus QBasic, FreeBASIC, VB und Python (2026-09-21). Was man von dort
' mitbringt, geht entweder (EXIT FOR, SWAP, LET, END, DIM x AS T = wert,
' INPUT "..."; x, m["k"], LEN(map), a + [x], VAL("&HFF") ...) oder bekommt
' eine Meldung, die sagt, wie es hier heisst -- statt "Erwartet Zeilenende".
' Format: docs/werkzeuge.md.


=== dim mit startwert
DIM a AS INTEGER = 5
DIM s AS STRING = "Hallo"
DIM f AS ARRAY OF INTEGER = [1, 2, 3]
PRINT a; " "; s; " "; LEN(f)
--- erwartet
5 Hallo 3

=== dim mit startwert in einer sub laeuft bei jedem aufruf
SUB s()
    DIM t AS INTEGER = 1
    t = t + 1
    PRINT t
END SUB
s()
s()
--- erwartet
2
2

=== der startwert laeuft durch die typpruefung
DIM i AS INTEGER = "fuenf"
--- fehler
Erwartet INTEGER, erhalten STRING

=== ein startwert gilt fuer eine variable
DIM a, b AS INTEGER = 3
--- fehler
Ein Startwert gilt fuer genau eine Variable

=== ein feld bekommt keinen startwert in der dim-zeile
CLASS K
    DIM hp AS INTEGER = 100
END CLASS
--- fehler
SUB Init()

=== exit for do while und sub
DIM i AS INTEGER
FOR i = 1 TO 10
    IF i = 3 THEN EXIT FOR
NEXT
PRINT i
DIM n AS INTEGER
DO
    n = n + 1
    IF n = 4 THEN EXIT DO
LOOP
PRINT n
WHILE TRUE
    n = n + 1
    EXIT WHILE
WEND
PRINT n
SUB s()
    PRINT "a"
    EXIT SUB
    PRINT "b"
END SUB
s()
--- erwartet
3
4
5
a

=== exit verlaesst nur die passende schleife
DIM i AS INTEGER
DIM j AS INTEGER
FOR i = 1 TO 3
    WHILE j < 5
        EXIT FOR
    WEND
NEXT
--- fehler
die innerste Schleife ist aber eine WHILE-Schleife

=== exit sub ausserhalb
EXIT SUB
--- fehler
EXIT SUB steht in keinem Unterprogramm

=== exit function sagt return
FUNCTION f() AS INTEGER
    EXIT FUNCTION
END FUNCTION
--- fehler
RETURN wert

=== exit als befehl bleibt exit
PRINT "a"
EXIT(0)
PRINT "b"
--- erwartet
a

=== end allein beendet das programm
DIM x AS INTEGER = 1
IF x = 1 THEN
    PRINT "vor"
    END
END IF
PRINT "nach"
--- erwartet
vor

=== end im einzeiler
IF TRUE THEN PRINT "a" : END
PRINT "nie"
--- erwartet
a

=== end while wie wend
DIM i AS INTEGER
WHILE i < 3
    i = i + 1
END WHILE
PRINT i
--- erwartet
3

=== swap
DIM a AS INTEGER = 1
DIM b AS INTEGER = 2
SWAP a, b
PRINT a; b
DIM f AS ARRAY OF STRING = ["x", "y", "z"]
SWAP f[0], f[2]
PRINT f[0]; f[2]
--- erwartet
21
zx

=== swap und let bleiben namen
DIM swap AS INTEGER = 4
DIM let AS INTEGER
let = swap + 1
PRINT let
--- erwartet
5

=== let wird uebergangen
DIM x AS INTEGER
LET x = 5
LET x += 1
PRINT x
--- erwartet
6

=== fragezeichen ist print
? "hallo"; 1 + 1
--- erwartet
hallo2

=== input mit semikolon haengt ein fragezeichen an
DIM n AS STRING
INPUT "Name"; n
PRINT "[" + n + "]"
--- eingabe
Anna
--- erwartet
Name? [Anna]

