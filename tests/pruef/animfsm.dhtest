{"version": 1, "default": "idle", "params": [{"name": "speed", "type": "float", "default": 0.0}, {"name": "jump", "type": "trigger"}], "states": [{"name": "idle", "anim": "idle", "loop": true, "first": 0, "last": 3, "fps": 6.0}, {"name": "run", "anim": "run", "loop": true, "first": 4, "last": 9, "fps": 12.0}, {"name": "jump", "anim": "jump", "loop": false, "first": 10, "last": 12, "fps": 30.0}], "transitions": [{"from": "idle", "to": "run", "conditions": [{"param": "speed", "op": "gt", "value": 0.1}]}, {"from": "run", "to": "idle", "conditions": [{"param": "speed", "op": "lt", "value": 0.1}]}, {"from": "*", "to": "jump", "conditions": [{"param": "jump", "op": "trigger"}]}, {"from": "jump", "to": "idle", "wait_finished": true, "conditions": []}]}
