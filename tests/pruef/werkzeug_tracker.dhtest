=== eine datei der qt-fassung kommt mit allen spalten an
' Die Beilage hat `Song.save_json` der Qt-Fassung geschrieben (6 Kanaele, 140 BPM,
' zwei Patterns, Reihenfolge 0 1 0; Note 64 mit Lautstaerke 9, Slide -3, Arpeggio
' 0x47 und Instrument 5), hier nur auf eine Zeile gepackt.
SET_WINDOW_POS(-3000, -3000)
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
DIM prFlag AS STRING : prFlag = ""
DIM prMax AS INTEGER : prMax = -1
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prEinmal(schluessel AS STRING, z AS STRING)
    IF INSTR(prFlag, "|" + schluessel + " ") < 0 THEN prFlag = prFlag + "|" + schluessel + " " + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
