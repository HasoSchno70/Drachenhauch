=== echt: reiter datenbank, sicherung einspielen mit frage, esc
' Strg+, , Reiter "Datenbank" (der sechste -- er passt jetzt in die
' Leiste), "Sicherung einspielen" (KUEHL_SICHERUNG), die Frage mit Enter,
' ESC. Danach zeigt das Hauptfenster den eingespielten Bestand.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 10)
' Die Sicherung: dieselbe Datei mit zwei Eintraegen im Bestand.
COPYFILE(p + "/_studio/fridge_database.db", CWD$() + "/sicherung.db")
DIM d AS DB_CONN : d = DB_OPEN(CWD$() + "/sicherung.db")
DB_EXEC(d, "INSERT INTO products (name) VALUES ('Milch'), ('Brot')")
DB_EXEC(d, "INSERT INTO inventory (product_id, quantity, unit) VALUES (1, 1, 'Liter'), (2, 1, 'Stück')")
DB_CLOSE(d)
SETENV("KUEHL_SICHERUNG", CWD$() + "/sicherung.db")
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
FUNCTION z(i AS INTEGER) AS INTEGER
    RETURN INT(VAL(w[i]))
END FUNCTION
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slMit([341], 44)
slWarten(20)
slKlick(z(0), z(1))
slWarten(10)
slKlick(z(2), z(3))
slWarten(20)
slTaste(257)
slWarten(20)
slTaste(256)
slWarten(20)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 20)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei daten.dh
DIM f AS Hauptfenster : f = studioStartFenster
--- datei mess.dh
IMPORT "../../daten.dh"
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
DIM t AS INTEGER : t = GUI_METRIC_GET("title_h")
DIM ef AS EinstellungenFenster : ef = NEW EinstellungenFenster()
ef.Zeigen()
n = 0
WHILE n < 3 AND studioBild()
    n = n + 1
WEND
DIM ex AS INTEGER : ex = GUI_WINDOW_GET_X(ef.Fenster())
DIM ey AS INTEGER : ey = GUI_WINDOW_GET_Y(ef.Fenster()) + t
DIM rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER
(rx, ry, rw, rh) = GUI_TABCONTROL_ITEM_RECT(ef.reiter, 5)
WRITEALL("lage.txt", STR$(rx + rw \ 2) + " " + STR$(ry + rh \ 2) + " " + _
    STR$(ex + GUI_GET_X(ef.knopfEinspielen) + GUI_GET_W(ef.knopfEinspielen) \ 2) + " " + STR$(ey + GUI_GET_Y(ef.knopfEinspielen) + GUI_GET_H(ef.knopfEinspielen) \ 2))
--- datei klick.dh
IMPORT "../../daten.dh"
FUNCTION stand$() AS STRING
    RETURN "bestand " + STR$(dbZahl("SELECT COUNT(*) FROM inventory")) + " kachel " + GUI_CARD_TEXT$(f.kachelGesamt)
END FUNCTION
DIM folge AS ARRAY OF STRING : folge = []
DIM war AS STRING : war = ""
WHILE studioBild()
    DIM jetzt AS STRING : jetzt = stand$()
    IF jetzt <> war THEN ARRAY_PUSH(folge, jetzt)
    war = jetzt
WEND
PRINT JOIN$(folge, " -> ")
--- erwartet
bestand 0 kachel 0 -> bestand 2 kachel 2
code 0
