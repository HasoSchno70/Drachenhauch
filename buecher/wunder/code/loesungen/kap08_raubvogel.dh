' Loesung zu Kapitel 8, Erfinden: ein Raubvogel jagt den Schwarm.
' Er ist ein Vogel mit eigenen Regeln (EXTENDS); die Voegel fliehen.
' Die Stellen, die neu sind, stehen zwischen >>> und <<<.
CONST BREITE = 800
CONST HOEHE = 500
CONST ANZAHL = 150
CONST FLUGTEMPO = 120.0
CONST TEMPO_MIN = 80.0
CONST TEMPO_MAX = 180.0
' Wie weit ein Vogel sieht, und ab wann ihm einer zu nah ist.
CONST SICHT = 60.0
CONST NAEHE = 18.0
' Wie stark jede Regel lenkt.
CONST KRAFT_ABSTAND = 4000.0
CONST KRAFT_RICHTUNG = 1.5
CONST KRAFT_MITTE = 0.8
' >>> neu
CONST FLUCHT = 90.0
CONST KRAFT_FLUCHT = 700.0
CONST KRAFT_JAGD = 1.2
CONST JAGDTEMPO = 170.0
' <<< neu

CLASS Vogel
    DIM x AS FLOAT
    DIM y AS FLOAT
    DIM vx AS FLOAT
    DIM vy AS FLOAT
    ' Was der Vogel beim Umschauen gesehen hat.
    DIM nachbarn AS INTEGER
    DIM summeX AS FLOAT
    DIM summeY AS FLOAT
    DIM summeVx AS FLOAT
    DIM summeVy AS FLOAT
    DIM wegX AS FLOAT
    DIM wegY AS FLOAT
    ' Die neue Geschwindigkeit -- gilt erst nach bewegen.
    DIM neuVx AS FLOAT
    DIM neuVy AS FLOAT

    ' Ein neuer Vogel: irgendwo, in irgendeine Richtung.
    SUB Init()
        x = RND() * BREITE
        y = RND() * HOEHE
        DIM w AS FLOAT : w = RND() * 2 * PI
        vx = COS(w) * FLUGTEMPO
        vy = SIN(w) * FLUGTEMPO
    END SUB

    ' Alle anderen ansehen und zusammenzaehlen, was in Sicht ist.
    SUB umschauen(alle AS ARRAY OF Vogel)
        nachbarn = 0
        summeX = 0 : summeY = 0 : summeVx = 0 : summeVy = 0
        wegX = 0 : wegY = 0
        FOR EACH v IN alle
            IF v = Self THEN CONTINUE
            DIM dx AS FLOAT : dx = v.x - x
            DIM dy AS FLOAT : dy = v.y - y
            DIM d AS FLOAT : d = HYPOT(dx, dy)
            IF d < SICHT THEN
                nachbarn = nachbarn + 1
                summeX = summeX + v.x
                summeY = summeY + v.y
                summeVx = summeVx + v.vx
                summeVy = summeVy + v.vy
                ' Je naeher, desto staerker weg von ihm.
                IF d < NAEHE THEN
                    wegX = wegX - dx / (d * d)
                    wegY = wegY - dy / (d * d)
                END IF
            END IF
        NEXT
    END SUB

    ' Regel 1, Abstand: weg von denen, die zu nah sind.
    SUB abstandHalten(dt AS FLOAT)
        neuVx = neuVx + wegX * KRAFT_ABSTAND * dt
        neuVy = neuVy + wegY * KRAFT_ABSTAND * dt
    END SUB

    ' Regel 2, Ausrichtung: so fliegen wie die Nachbarn.
    SUB ausrichten(dt AS FLOAT)
        DIM mx AS FLOAT : mx = summeVx / nachbarn
        DIM my AS FLOAT : my = summeVy / nachbarn
        neuVx = neuVx + (mx - vx) * KRAFT_RICHTUNG * dt
        neuVy = neuVy + (my - vy) * KRAFT_RICHTUNG * dt
    END SUB

    ' Regel 3, Zusammenhalt: zur Mitte der Nachbarn.
    SUB zusammenbleiben(dt AS FLOAT)
        DIM mx AS FLOAT : mx = summeX / nachbarn
        DIM my AS FLOAT : my = summeY / nachbarn
        neuVx = neuVx + (mx - x) * KRAFT_MITTE * dt
        neuVy = neuVy + (my - y) * KRAFT_MITTE * dt
    END SUB

    ' >>> neu
    ' Regel 4: weg vom Raubvogel, wenn er naeher als FLUCHT ist.
    SUB fliehen(dt AS FLOAT)
        DIM dx AS FLOAT : dx = x - jaeger.x
        DIM dy AS FLOAT : dy = y - jaeger.y
        DIM d AS FLOAT : d = HYPOT(dx, dy)
        IF d < FLUCHT AND d > 0 THEN
            neuVx = neuVx + dx / d * KRAFT_FLUCHT * dt
            neuVy = neuVy + dy / d * KRAFT_FLUCHT * dt
        END IF
    END SUB
    ' <<< neu

    ' Nie zu langsam, nie zu schnell.
    SUB tempoHalten()
        DIM t AS FLOAT : t = HYPOT(neuVx, neuVy)
        DIM soll AS FLOAT : soll = CLAMP(t, TEMPO_MIN, TEMPO_MAX)
        neuVx = neuVx * soll / t
        neuVy = neuVy * soll / t
    END SUB

    ' Umschauen und nach den drei Regeln die neue Richtung waehlen.
    SUB entscheiden(alle AS ARRAY OF Vogel, dt AS FLOAT)
        umschauen(alle)
        neuVx = vx
        neuVy = vy
        IF nachbarn > 0 THEN
            abstandHalten(dt)
            ausrichten(dt)
            zusammenbleiben(dt)
        END IF
        ' >>> neu
        fliehen(dt)
        ' <<< neu
        tempoHalten()
    END SUB

    SUB bewegen(dt AS FLOAT)
        vx = neuVx
        vy = neuVy
        x = x + vx * dt
        y = y + vy * dt
        ' Wer hinausfliegt, kommt auf der anderen Seite wieder herein.
        IF x < 0 THEN x = x + BREITE
        IF x >= BREITE THEN x = x - BREITE
        IF y < 0 THEN y = y + HOEHE
        IF y >= HOEHE THEN y = y - HOEHE
    END SUB

    ' Ein schmales Dreieck, das in Flugrichtung zeigt.
    SUB zeichnen()
        DIM w AS FLOAT : w = ATAN2(vy, vx)
        DIM sx AS FLOAT : sx = x + COS(w) * 8
        DIM sy AS FLOAT : sy = y + SIN(w) * 8
        DIM lx AS FLOAT : lx = x + COS(w + 2.5) * 5
        DIM ly AS FLOAT : ly = y + SIN(w + 2.5) * 5
        DIM rx AS FLOAT : rx = x + COS(w - 2.5) * 5
        DIM ry AS FLOAT : ry = y + SIN(w - 2.5) * 5
        TRIANGLE(sx, sy, lx, ly, rx, ry, RGB(230, 236, 250))
    END SUB
END CLASS

' >>> neu
' Der Raubvogel ist ein Vogel: Er erbt die Felder, Init und bewegen.
' Nur entscheiden und zeichnen macht er anders.
CLASS Raubvogel EXTENDS Vogel
    ' Kein Schwarm fuer ihn: Er fliegt auf den naechsten Vogel zu.
    SUB entscheiden(alle AS ARRAY OF Vogel, dt AS FLOAT)
        DIM ziel AS Vogel
        DIM best AS FLOAT : best = 1.0E9
        FOR EACH v IN alle
            DIM d AS FLOAT : d = HYPOT(v.x - x, v.y - y)
            IF d < best THEN
                best = d
                ziel = v
            END IF
        NEXT
        neuVx = vx + (ziel.x - x) * KRAFT_JAGD * dt
        neuVy = vy + (ziel.y - y) * KRAFT_JAGD * dt
        DIM t AS FLOAT : t = HYPOT(neuVx, neuVy)
        neuVx = neuVx * JAGDTEMPO / t
        neuVy = neuVy * JAGDTEMPO / t
    END SUB

    SUB zeichnen()
        DIM w AS FLOAT : w = ATAN2(vy, vx)
        DIM sx AS FLOAT : sx = x + COS(w) * 16
        DIM sy AS FLOAT : sy = y + SIN(w) * 16
        DIM lx AS FLOAT : lx = x + COS(w + 2.4) * 10
        DIM ly AS FLOAT : ly = y + SIN(w + 2.4) * 10
        DIM rx AS FLOAT : rx = x + COS(w - 2.4) * 10
        DIM ry AS FLOAT : ry = y + SIN(w - 2.4) * 10
        TRIANGLE(sx, sy, lx, ly, rx, ry, RGB(240, 90, 70))
    END SUB
END CLASS

DIM jaeger AS Raubvogel : jaeger = NEW Raubvogel()
' <<< neu

DIM schwarm AS ARRAY OF Vogel
DIM i AS INTEGER
FOR i = 1 TO ANZAHL
    ARRAY_PUSH(schwarm, NEW Vogel())
NEXT

SCREEN(BREITE, HOEHE, "Schwarm")
WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE)
    ' Bei einem Ruckler nicht weit springen.
    DIM dt AS FLOAT : dt = MIN(DELTA(), 0.05)
    ' Erst entscheiden ALLE, dann bewegen sich alle.
    FOR EACH v IN schwarm
        v.entscheiden(schwarm, dt)
    NEXT
    FOR EACH v IN schwarm
        v.bewegen(dt)
    NEXT
    ' >>> neu
    jaeger.entscheiden(schwarm, dt)
    jaeger.bewegen(dt)
    ' <<< neu
    CLS(RGB(18, 26, 48))
    FOR EACH v IN schwarm
        v.zeichnen()
    NEXT
    ' >>> neu
    jaeger.zeichnen()
    ' <<< neu
    FLIP()
WEND
