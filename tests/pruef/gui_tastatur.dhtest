=== deckkraft mit pos1 und ende
' Die Pfeile sind für Sättigung und Helligkeit belegt, Bild auf/ab für
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM cp AS GUI_WIDGET
cp = GUI_COLORPICKER(w, 10, 10, 200, 150)
GUI_COLORPICKER_SET(cp, "alpha", 1)
GUI_SET_PICKED_COLOR(cp, &HFFFF8800)
GUI_FOCUS(cp)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

' Pos1 senkt die Deckkraft um 16: FF -> EF
PRINT COLOR_HEX$(GUI_PICKED_COLOR(cp))
--- datei ev.txt
# Test-Aufnahme
c 2
e 2 2 268 0 0 0 // Event: test
e 3 1 268 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
#EFFF8800

