' Drei Handgriffe der IDE:
' (1) Dateien im Projektbaum verwalten: Rechtsklick -> Neue Datei, Neuer
'     Ordner, Umbenennen, Loeschen, Pfad kopieren (GUI_CONTEXT_WIDGET).
'     Umbenennen zieht offene Reiter und jedes IMPORT im Projekt mit.
' (2) Zurueck zur vorigen Stelle / Vorwaerts (Strg+Alt+Links/Rechts): jeder
'     Sprung in eine andere Datei oder um mindestens acht Zeilen wird gemerkt.
' (3) Ausgabe filtern und sichern.
--- seriell
--- langsam

=== rechtsklick im baum waehlt ohne zu oeffnen und legt eine datei an
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 30 THEN
    ' Die obere Kante des Baums suchen, dann in seine erste Zeile.
    DIM prY AS INTEGER : prY = -1
    DIM prX AS INTEGER : prX = -1
    DIM prYY AS INTEGER
    DIM prXX AS INTEGER
    FOR prYY = 0 TO SCREENHEIGHT() - 1 STEP 2
        FOR prXX = 10 TO 200 STEP 10
            IF prY < 0 AND GUI_HIT_TEST(prXX, prYY) = baum THEN prY = prYY : prX = prXX + 30
        NEXT
    NEXT
    protokoll("pr baum gefunden " + STR$(prY >= 0))
    DIM prA AS STRING : prA = ""
    prA = prA + "e 0 7 " + STR$(prX) + " " + STR$(prY + 10) + " 0" + CHR$(10)
    prA = prA + "e 2 6 1 0 0" + CHR$(10) + "e 3 5 1 0 0" + CHR$(10)
    prA = prA + "e 20 2 264 0 0" + CHR$(10) + "e 21 1 264 0 0" + CHR$(10)
    prA = prA + "e 24 2 257 0 0" + CHR$(10) + "e 25 1 257 0 0" + CHR$(10)
    prA = prA + "e 40 2 257 0 0" + CHR$(10) + "e 41 1 257 0 0" + CHR$(10)
    WRITEALL("prmaus.txt", "c 9" + CHR$(10) + prA + CHR$(10))
    AUTOMATION_PLAY("prmaus.txt")
END IF
IF prBild = 45 THEN
    protokoll("pr gewaehlt " + BASENAME(GUI_FILETREE_SELECTED$(baum)) + " reiter " + STR$(tabAnzahl))
END IF
IF prBild = 110 THEN
    protokoll("pr reiter " + STR$(tabAnzahl) + " vorn " + BASENAME(tabPfade[aktiverTab]))
    EXIT(0)
END IF
--- argumente
d.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei c.dh
PRINT "c"
--- datei d.dh
PRINT "d"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 5) = "baum " THEN PRINT L[i]
NEXT
PRINT "neu.dh da "; FILEEXISTS("neu.dh")
--- erwartet
pr baum gefunden TRUE
pr gewaehlt c.dh reiter 1
baum neue datei neu.dh
pr reiter 2 vorn neu.dh
neu.dh da TRUE

=== umbenennen zieht reiter und imports mit
' haupt.dh ist offen und gesichert, andere.dh nicht offen: beide bekommen
' den neuen Namen im IMPORT, der Kommentar nicht.
baumUmbenennen(PATHJOIN(projektOrdner, "lib/helfer.dh"), "werkzeug.dh")
protokoll("pr reiter " + BASENAME(tabPfade[aktiverTab]) + " sauber " + STR$(GUI_TEXT(tabFelder[aktiverTab]) = tabGesichert[aktiverTab]))
dateiOeffnen(PATHJOIN(projektOrdner, "lib/werkzeug.dh"))
protokoll("pr zweiter reiter " + BASENAME(tabPfade[aktiverTab]) + " reiter " + STR$(tabAnzahl))
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
' IMPORT "lib/helfer.dh" bleibt im Kommentar stehen
IMPORT "lib/helfer.dh"
hallo()
--- datei andere.dh
IMPORT "lib/helfer.dh"
hallo()
--- datei lib/helfer.dh
SUB hallo()
    PRINT "hallo"
END SUB
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 5) = "baum " THEN PRINT L[i]
NEXT
PRINT "alt da "; FILEEXISTS("lib/helfer.dh"); " neu da "; FILEEXISTS("lib/werkzeug.dh")
DIM z AS STRING
FOR EACH z IN READLINES("haupt.dh")
    PRINT "haupt |"; z
NEXT
FOR EACH z IN READLINES("andere.dh")
    PRINT "andere |"; z
NEXT
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", "andere.dh")
DIM r AS INTEGER : r = 0
WHILE PROCESS_RUNNING(p) AND r < 300 : SLEEP(20) : r = r + 1 : WEND
SLEEP(50)
PRINT "lauf "; TRIM$(REPLACE$(PROCESS_READ$(p), CHR$(13), ""))
--- erwartet
baum umbenannt helfer.dh werkzeug.dh imports 2
pr reiter haupt.dh sauber TRUE
pr zweiter reiter werkzeug.dh reiter 2
alt da FALSE neu da TRUE
haupt |' IMPORT "lib/helfer.dh" bleibt im Kommentar stehen
haupt |IMPORT "lib/werkzeug.dh"
haupt |hallo()
andere |IMPORT "lib/werkzeug.dh"
andere |hallo()
lauf hallo

=== loeschen schliesst den reiter, ordner mit inhalt
baumLoeschen(PATHJOIN(projektOrdner, "weg.dh"))
protokoll("pr reiter " + STR$(tabAnzahl))
baumLoeschen(PATHJOIN(projektOrdner, "alt"))
baumZiel = "" : dlgBaumLoeschen = -1
' Das Projekt selbst loescht die IDE nicht.
GUI_FILETREE_SELECT(baum, projektOrdner)
baumLoeschenFragen()
protokoll("pr dialog " + STR$(dlgBaumLoeschen >= 0))
EXIT(0)
