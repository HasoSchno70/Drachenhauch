=== seltenes dim neben try bleibt in der vm
DIM i AS INTEGER
DIM s AS INTEGER
FOR i = 1 TO 12
    s = s + i
    IF i = 4 THEN
        DIM spaeter AS INTEGER
        spaeter = 7
    END IF
    IF i > 4 THEN s = s + spaeter
    IF i = 11 THEN
        TRY
            THROW "x"
        CATCH e
            s = s + 1000
        END TRY
    END IF
NEXT
PRINT s
--- umgebung
DHRT_JIT=aus
--- erwartet
1134

