=== kochen: aelteste zuerst, portionen, ein schritt mit rueckgaengig
' Fuer 4 statt 2 Portionen (Faktor 2): Milch 2 x 1,5 Liter aus zwei
' Eintraegen (der fruehere ganz, als "cooked" im Verlauf, vom spaeteren der
' Rest), Ei 6 von 10, Zwiebel 2 von 3, Salz gibt es nicht. Reis bleibt --
' die Python-App haette ihn fuer "Ei" mit abgezogen. Fehlendes fuer 8
' Portionen auf die Einkaufsliste. Enter beantwortet Frage und Meldung.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slTaste(257)
slWarten(20)
slTaste(257)
slAufnahmeSchreiben(p + "/_studio/enter.txt")
PRINT "code "; kProbe(p, "probe.dh", "enter.txt", 80)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM x AS Rezept : x = NEW Rezept()
x.name = "Pfanne"
x.portionen = 2
x.zutaten = []
DIM z AS Zutat
z = NEW Zutat() : z.name = "Milch" : z.menge = 1.5 : z.einheit = "Liter" : ARRAY_PUSH(x.zutaten, z)
z = NEW Zutat() : z.name = "Ei" : z.menge = 3 : z.einheit = "Stück" : ARRAY_PUSH(x.zutaten, z)
z = NEW Zutat() : z.name = "Zwiebeln" : z.menge = 1 : z.einheit = "Stück" : ARRAY_PUSH(x.zutaten, z)
z = NEW Zutat() : z.name = "Salz" : z.menge = 1 : z.einheit = "TL" : ARRAY_PUSH(x.zutaten, z)
rezeptAnlegen(x)
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch'), ('Ei'), ('Reis'), ('Zwiebel')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, purchase_date, expiry_date, storage_location) VALUES (1, 2, 'Liter', '2026-11-01', '2026-11-20', 'Kühlschrank'), (1, 2, 'Liter', '2026-11-02', '2026-11-10', 'Kühlschrank'), (2, 10, 'Stück', NULL, '2026-11-15', 'Kühlschrank'), (3, 250, 'g', NULL, NULL, 'Vorratsraum'), (4, 3, 'Stück', NULL, NULL, 'Vorratsraum')")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
FUNCTION stand$() AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT GROUP_CONCAT(i.id || ':' || p.name || ':' || i.quantity, ' ') FROM (SELECT * FROM inventory ORDER BY id) i JOIN products p ON p.id = i.product_id")
    DIM t AS STRING : t = ""
    IF DB_NEXT(r) THEN t = DB_GET_STRING(r, 0)
    RETURN t + " | gekocht " + JOIN$(textListe("SELECT product_name || ':' || quantity || ':' || reason || ':' || duration_days FROM consumption_history ORDER BY id"), " ")
END FUNCTION
DIM kf AS KochenFenster : kf = NEW KochenFenster()
kf.rezeptId = 1
kf.Zeigen()
GUI_SET_VALUE(kf.portionenFeld, 4)
kf.portionenFeld_Geaendert()
PRINT "faktor "; GUI_TEXT(kf.faktorText); " | "; GUI_TEXT(kf.info)
DIM i AS INTEGER
FOR i = 0 TO GUI_TABLE_ROW_COUNT(kf.tabelle) - 1
    PRINT "  "; GUI_TABLE_GET_CELL(kf.tabelle, i, 0); " | "; GUI_TABLE_GET_CELL(kf.tabelle, i, 1); " | "; GUI_TABLE_GET_CELL(kf.tabelle, i, 2); " | "; GUI_TABLE_GET_CELL(kf.tabelle, i, 3); " | "; GUI_TABLE_GET_CELL(kf.tabelle, i, 4)
NEXT
PRINT "vorher "; stand$()
kf.knopfKochen_Klick()
PRINT "gekocht "; stand$(); " | offen "; kf.studioOffen; " | "; verlauf.textZurueck$()
f.miRueckgaengig_Aktion()
PRINT "zurueck "; stand$()
f.miWiederholen_Aktion()
PRINT "wieder "; stand$()
f.miRueckgaengig_Aktion()
PRINT "fehlend "; fehlendeEinkaufen(rezeptLaden(1), 4.0); " | "; JOIN$(textListe("SELECT product_name || ':' || quantity || ':' || unit || ':' || notes FROM shopping_list ORDER BY id"), " ")
--- erwartet
faktor ×2,0 | 🛒 1 Zutat(en) fehlen
  Milch | 3 Liter | 4 Liter | ✅ OK | 
  Ei | 6 Stück | 10 Stück | ✅ OK | 
  Zwiebeln | 2 Stück | 3 Stück | ✅ OK | 
  Salz | 2 TL | - | ❌ Fehlt | -2
vorher 1:Milch:2.0 2:Milch:2.0 3:Ei:10.0 4:Reis:250.0 5:Zwiebel:3.0 | gekocht 
gekocht 1:Milch:1.0 3:Ei:4.0 4:Reis:250.0 5:Zwiebel:1.0 | gekocht Milch:2:cooked:6 | offen FALSE | Pfanne gekocht
zurueck 1:Milch:2.0 2:Milch:2.0 3:Ei:10.0 4:Reis:250.0 5:Zwiebel:3.0 | gekocht 
wieder 1:Milch:1.0 3:Ei:4.0 4:Reis:250.0 5:Zwiebel:1.0 | gekocht Milch:2:cooked:6
fehlend 4 | Milch:2.0:Liter:Für: Pfanne Ei:2.0:Stück:Für: Pfanne Zwiebeln:1.0:Stück:Für: Pfanne Salz:4.0:TL:Für: Pfanne
