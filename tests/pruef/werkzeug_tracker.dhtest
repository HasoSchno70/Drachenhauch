' Der Tracker-Pilot (examples/190_tracker.dh), bedient wie von Hand -- ohne
' Python (Stufe 40, bis dahin tests/test_pilot_tracker.py). Der erste Pilot mit
' einer Zeitachse; geprueft an drei Ergebnissen, die Drachenhauch selbst liest:
' die Datei (json-Modul, Schluessel wie die Qt-Fassung sie liest), die WAV
' (`--- ton` bzw. ihre Bytes) und der GB-Code (`dhrt --check` und ein Start).
'
' Der Quelltext des Falls steht hinter SETFPS(60): Fenster aus dem Bild, die
' Aufnahme (falls es eine gibt) und Helfer. Der Einschub hinter FLIP() schreibt
' je Bild _programm/probe.txt; ein Einschub hinter `bildNr = bildNr + 1` ruft
' Unterprogramme des Piloten direkt. Jede Aufnahme beginnt mit einem Ereignis in
' Bild 0 -- die Wiedergabe setzt beim ersten Ereignis an.
' In der Aufnahme: 7 Mauslage, 6 Taste runter, 5 hoch, 2 Taste runter, 1 hoch.
--- seriell

=== die werkzeugleisten ueberlappen nicht und passen ins fenster
' Im ersten Bild lagen 'Stereo' und 'Amiga' uebereinander, und der letzte Knopf
' jeder Leiste war abgeschnitten -- gesehen nur im BILD. Geprueft werden die
' RECHTECKE aller 35 Widgets paarweise und gegen den Fensterrand (1400).
SET_WINDOW_POS(-3000, -3000)
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
DIM prFlag AS STRING : prFlag = ""
DIM prMax AS INTEGER : prMax = -1
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prEinmal(schluessel AS STRING, z AS STRING)
    IF INSTR(prFlag, "|" + schluessel + " ") < 0 THEN prFlag = prFlag + "|" + schluessel + " " + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
--- programm ../../examples/190_tracker.dh nach SETFPS(60)
--- einschub nach FLIP()
IF bildNr = 2 THEN
    DIM prW[34] AS GUI_WIDGET
    prW[0] = bNeu
    prW[1] = bAuf
    prW[2] = bSpei
    prW[3] = bSpeiAls
    prW[4] = spBpm
    prW[5] = spKan
    prW[6] = bPlayPat
    prW[7] = bPlaySong
    prW[8] = bStop
    prW[9] = bZur
    prW[10] = bVor
    prW[11] = bWav
    prW[12] = cbStereo
    prW[13] = cbAmiga
    prW[14] = bCode
    prW[15] = lblPat
    prW[16] = ddPat
    prW[17] = lblRows
    prW[18] = spRows
    prW[19] = bPatNeu
    prW[20] = bPatDup
    prW[21] = bPatDel
    prW[22] = bPatLeer
    prW[23] = lblOkt
    prW[24] = spOkt
    prW[25] = lblZelle
    prW[26] = spVol
    prW[27] = lblSlide
    prW[28] = spSlide
    prW[29] = lblFx
    prW[30] = ddFx
    prW[31] = spFxp
    prW[32] = ddZInst
    prW[33] = bOff
    DIM a AS INTEGER
    DIM b AS INTEGER
    DIM ueber AS INTEGER : ueber = 0
    DIM rand AS INTEGER : rand = 0
    FOR a = 0 TO 33
        IF GUI_GET_X(prW[a]) + GUI_GET_W(prW[a]) > 1400 - 8 THEN rand = rand + 1
        FOR b = a + 1 TO 33
            IF GUI_GET_X(prW[a]) < GUI_GET_X(prW[b]) + GUI_GET_W(prW[b]) AND GUI_GET_X(prW[b]) < GUI_GET_X(prW[a]) + GUI_GET_W(prW[a]) AND GUI_GET_Y(prW[a]) < GUI_GET_Y(prW[b]) + GUI_GET_H(prW[b]) AND GUI_GET_Y(prW[b]) < GUI_GET_Y(prW[a]) + GUI_GET_H(prW[a]) THEN ueber = ueber + 1
        NEXT
    NEXT
    prMerke("ueberlappungen " + STR$(ueber))
    prMerke("ueber den rand " + STR$(rand))
END IF
prSchreib("")

--- umgebung
DHRT_FRAMES=4
--- inhalt _programm/probe.txt
|ueberlappungen 0|
|ueber den rand 0|

=== die tastatur setzt noten und rueckt weiter
' Z = C der gewaehlten Oktave (4 -> MIDI 60), Q = eine Oktave hoeher; nach jeder
' Note eine Reihe weiter.
SET_WINDOW_POS(-3000, -3000)
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
DIM prFlag AS STRING : prFlag = ""
