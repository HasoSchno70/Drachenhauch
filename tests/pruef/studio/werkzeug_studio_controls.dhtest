=== ein umbenanntes control nimmt seine instanzen mit, auch im verlauf
' Erst wird zaehler1 im Hauptfenster verschoben (ein Rueckgaengig-Stand),
' dann Zaehler im Inspektor zu Zahl umbenannt, dann im Hauptfenster
' zurueckgenommen: auch der alte Stand nennt Zahl.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 6, p)
DIM cx AS INTEGER
DIM cy AS INTEGER
(cx, cy) = slLage(m, "control zaehler1")
DIM kx AS INTEGER
DIM ky AS INTEGER
(kx, ky) = slLage(m, "knoten Zaehler")
DIM hx AS INTEGER
DIM hy AS INTEGER
(hx, hy) = slLage(m, "knoten Hauptfenster")
DIM nx AS INTEGER
DIM ny AS INTEGER
(nx, ny) = slLage(m, "feld name")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(6)
slKlick(cx, cy)
slWarten(4)
slTaste(262)
slWarten(6)
slKlick(kx, ky)
slWarten(10)
slKlick(nx, ny)
slMit([341], 65)
slMit([341], 86)
slTaste(257)
slWarten(6)
slKlick(hx, hy)
slWarten(10)
slMit([341], 90)
slWarten(6)
slMit([341], 83)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_ABLAGE", "Zahl")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
PRINT "umbenannt "; slHat(log, "instanzen umbenannt Zaehler Zahl 1")
DIM d AS JSON_HANDLE : d = JSON_PARSE(JOIN$(READLINES(p + "/Hauptfenster.dhform"), CHR$(10)))
PRINT "instanz "; JSON_GET_STRING(d, "widgets.0.studio_control"); " "; JSON_GET_INT(d, "widgets.0.x")
PRINT "dateien "; FILEEXISTS(p + "/Zahl.dhform"); " "; FILEEXISTS(p + "/Zaehler.dhform")
PRINT "projekt "; INSTR(JOIN$(READLINES(p + "/projekt.dhstudio"), ""), CHR$(34) + "Zahl" + CHR$(34)) >= 0
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
