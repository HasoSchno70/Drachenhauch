=== befehle mit einer stelle zaehlen im feld
DIM a[-10 TO -8] AS INTEGER
a[-10] = 4 : a[-9] = 5 : a[-8] = 6
PRINT ARRAY_INDEXOF(a, 6), ARRAY_INDEXOF(a, 99), LBOUND(a) - 1
PRINT ARRAY_FIND(a, FUNCTION(x) x = 5), ARRAY_FIND(a, FUNCTION(x) x > 100)
ARRAY_PUSH(a, 7)
PRINT UBOUND(a), a[-7]
PRINT ARRAY_POP(a), UBOUND(a)
ARRAY_INSERT(a, -10, 3)
PRINT a[-10], a[-9], UBOUND(a)
PRINT ARRAY_REMOVE_AT(a, -8), UBOUND(a)
TRY
    ARRAY_REMOVE_AT(a, 0)
CATCH e
    PRINT e
END TRY
DIM k AS ARRAY OF INTEGER
k = ARRAY_COPY(a)
PRINT LBOUND(k), k[-10]
DIM s AS ARRAY OF INTEGER
s = a[-9:-7]
PRINT LEN(s), LBOUND(s), s[0], s[1]
DIM n[3] AS INTEGER
PRINT ARRAY_INDEXOF(n, 5)
