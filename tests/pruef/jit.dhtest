=== print von werten aller art
DIM m AS MAP OF INTEGER
DIM i AS INTEGER
DIM b AS BOOLEAN
MAPPUT(m, "a", 1)
FOR i = 0 TO 2
    b = i MOD 2 = 0
    PRINT b; " "; MAPHAS(m, "a"); " "; STR$(i) + "x"; " "; i / 2
NEXT
