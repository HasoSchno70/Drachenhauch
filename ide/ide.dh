' Unscharfer Filter: der Text als Teil ODER seine Zeichen der Reihe nach
' ("spred" findet "189_sprite_editor.dh").
FUNCTION passtUnscharf(name AS STRING, filter AS STRING) AS BOOLEAN
    IF filter = "" THEN RETURN TRUE
    DIM n AS STRING : n = LOWER$(name)
    IF INSTR(n, filter) >= 0 THEN RETURN TRUE
    DIM k AS INTEGER : k = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(n) - 1
        IF MID$(n, i, 1) = MID$(filter, k, 1) THEN k = k + 1
        IF k >= LEN(filter) THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

SUB paletteFuellen(filter AS STRING)
    GUI_LISTBOX_CLEAR(lstPalette)
    DIM sichtbar AS ARRAY OF STRING : sichtbar = []
    DIM klein AS STRING : klein = LOWER$(filter)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(paletteNamen) - 1
        IF passtUnscharf(paletteNamen[i], klein) THEN
            GUI_LISTBOX_ADD(lstPalette, paletteNamen[i])
            ARRAY_PUSH(sichtbar, paletteKennungen[i])
        END IF
    NEXT
    paletteSichtbar = sichtbar
    IF LEN(sichtbar) > 0 THEN GUI_LISTBOX_SET_SELECTED(lstPalette, 0)
END SUB

SUB waehlerOeffnen(art AS STRING, titel AS STRING)
    paletteArt = art
    GUI_WINDOW_TITLE(winPalette, titel)
    GUI_SET_TEXT(tfPalette, "")
    paletteLetzterFilter = "-"
    GUI_WINDOW_SET_BOUNDS(winPalette, (SCREENWIDTH() - 440) \ 2, 80, 440, 340)
    GUI_WINDOW_VISIBLE(winPalette, TRUE)
    paletteOffen = TRUE
    GUI_FOCUS(tfPalette)
END SUB

SUB paletteOeffnen()
    paletteNamen = []
    paletteKennungen = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(befehlNamen) - 1
        DIM n AS STRING : n = befehlNamen[i]
        IF befehlKuerzel[i] <> "" THEN n = n + "   " + befehlKuerzel[i]
        ARRAY_PUSH(paletteNamen, n) : ARRAY_PUSH(paletteKennungen, befehlKennungen[i])
    NEXT
    waehlerOeffnen("befehl", "Befehle")
END SUB

' Strg+Umschalt+O: die .dh des Projektordners und die zuletzt geoeffneten.
SUB schnellOeffnen()
    paletteNamen = []
    paletteKennungen = []
    DIM d AS STRING
    FOR EACH d IN DIRLIST(projektOrdner, "*.dh")
        ARRAY_PUSH(paletteNamen, d) : ARRAY_PUSH(paletteKennungen, PATHJOIN(projektOrdner, d))
    NEXT
    FOR EACH d IN zuletzt
        IF ARRAY_INDEXOF(paletteKennungen, d) < 0 THEN
            ARRAY_PUSH(paletteNamen, BASENAME(d) + "   (" + DIRNAME(d) + ")") : ARRAY_PUSH(paletteKennungen, d)
        END IF
    NEXT
    waehlerOeffnen("datei", "Datei oeffnen: " + BASENAME(projektOrdner))
END SUB

SUB paletteSchliessen()
    GUI_WINDOW_VISIBLE(winPalette, FALSE)
    paletteOffen = FALSE
    GUI_FOCUS(aktivesFeld())
END SUB

SUB paletteAusfuehren()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstPalette)
    IF sel < 0 AND LEN(paletteSichtbar) > 0 THEN sel = 0
    paletteSchliessen()
    IF sel < 0 OR sel >= LEN(paletteSichtbar) THEN RETURN
    IF paletteArt = "schnipsel" THEN
        schnipselEinfuegen(INT(VAL(paletteSichtbar[sel])))
    ELSEIF paletteArt = "symbol" THEN
        symbolAnspringen(INT(VAL(paletteSichtbar[sel])))
    ELSEIF paletteArt = "datei" THEN
        protokoll("schnell " + paletteSichtbar[sel])
        dateiOeffnen(paletteSichtbar[sel])
    ELSE
        protokoll("palette " + paletteSichtbar[sel])
        befehl(paletteSichtbar[sel])
    END IF
END SUB

SUB eingabeSenden()
    DIM t AS STRING : t = GUI_TEXT(tfEingabe)
    IF prozess < 0 THEN
        GUI_SET_TEXT(lblStatus, "Kein Programm laeuft.")
        RETURN
    END IF
    IF prozessArt = "debug" THEN
        ' Im Debugger ist die Eingabezeile die Ausdruck-Auswertung.
        IF NOT debugPause THEN GUI_SET_TEXT(lblStatus, "Der Debugger steht gerade nicht.") : RETURN
        PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("eval") + "," + jsonText$("expr") + ":" + jsonText$(t) + "}" + NL)
        ausgabe("? " + t)
        GUI_SET_TEXT(tfEingabe, "")
        RETURN
    END IF
    PROCESS_WRITE(prozess, t + NL)
    ausgabe("> " + t)
    GUI_SET_TEXT(tfEingabe, "")
END SUB

' --- Beenden mit Rueckfrage ------------------------------------------
FUNCTION ungesichert() AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

DIM beenden AS BOOLEAN : beenden = FALSE

SUB beendenAnfragen()
    IF ungesichert() THEN
        dlgSchliessen = GUI_DIALOG("Beenden", "Es gibt ungesicherte Aenderungen.", "Alle sichern|Verwerfen|Abbrechen")
    ELSE
        beenden = TRUE
    END IF
END SUB

' EIN Ort fuer jeden Befehl: Menue, Kuerzel, Palette und Knoepfe rufen ihn.
SUB befehl(k AS STRING)
    SELECT CASE k
        CASE "neu" : tabOeffnen("", "")
        CASE "oeffnen"
            DIM p AS STRING : p = FILE_OPEN_DIALOG("Datei oeffnen", "dh")
            IF p <> "" THEN dateiOeffnen(p)
        CASE "schnell" : schnellOeffnen()
        CASE "todo" : projektSuchen("TODO", "FIXME")
        CASE "blame" : blameZeigen()
        CASE "diff" : gitZeigen("diff")
        CASE "verlauf" : gitZeigen("log")
        CASE "git_rand"
            gitRandAn = NOT gitRandAn
            GUI_MENU_CHECK(miGitRand, gitRandAn)
            gitDateiStand = "-"
            gitRandNachziehen(TRUE)
            konfigSichern()
        CASE "kommentar" : kommentarUmschalten()
        CASE "duplizieren" : zeilenDuplizieren()
        CASE "zeile_weg" : zeilenLoeschen()
        CASE "hoch" : zeilenVerschieben(-1)
        CASE "runter" : zeilenVerschieben(1)
        CASE "einruecken" : einruecken(1)
        CASE "ausruecken" : einruecken(-1)
        CASE "format" : formatieren()
        CASE "lesezeichen" : lesezeichenUmschalten()
        CASE "lz_weiter" : lesezeichenSpringen(TRUE)
        CASE "lz_zurueck" : lesezeichenSpringen(FALSE)
        CASE "lz_liste" : lesezeichenListe()
        CASE "regex"
            regexAn = NOT regexAn
            GUI_MENU_CHECK(miRegex, regexAn)
            GUI_SET_TEXT(lblStatus, IIF(regexAn, "Suche mit regulaerem Ausdruck (z. B. ^SUB .*\\(\\)).", "Suche als Teiltext."))
            konfigSichern()
        CASE "wiederauf"
            IF LEN(zuGemacht) = 0 THEN
                GUI_SET_TEXT(lblStatus, "Kein geschlossener Reiter zum Wiederholen.")
            ELSE
                DIM zurueck AS STRING : zurueck = ARRAY_POP(zuGemacht)
                IF FILEEXISTS(zurueck) THEN dateiOeffnen(zurueck) ELSE GUI_SET_TEXT(lblStatus, "Gibt es nicht mehr: " + zurueck)
                protokoll("wieder auf " + zurueck)
            END IF
        CASE "bedingung" : haltepunktBedingungFragen()
        CASE "export" : exportieren()
        CASE "groesser" : schriftSetzen(codeGroesse + 2)
        CASE "kleiner" : schriftSetzen(codeGroesse - 2)
        CASE "kuerzel" : kuerzelZeigen()
        CASE "sichern" : sichern(aktiverTab, FALSE)
        CASE "sichern_unter" : sichern(aktiverTab, TRUE)
        CASE "schliessen" : tabSchliessen(aktiverTab)
        CASE "beenden" : beendenAnfragen()
        CASE "suchen" : dlgSuche = GUI_PROMPT("Suchen", "Wonach?", suchtext)
        CASE "weiter" : weitersuchen(TRUE)
        CASE "ersetzen" : ersetzenZiel = "feld" : dlgSuche = GUI_PROMPT("Ersetzen", "Wonach suchen?", suchtext) : schliessenNachDialog = TRUE
        CASE "ersetzen_projekt"
            ersetzenZiel = "projekt"
            dlgSuche = GUI_PROMPT("Im ganzen Projekt ersetzen", "Wonach suchen?", suchtext)
            schliessenNachDialog = TRUE
        CASE "ausgabe_suchen" : dlgAusgabeSuche = GUI_PROMPT("Ausgabe durchsuchen", "Wonach?", ausgabeSuchtext)
        CASE "marke_naechste" : markeNaechste()
        CASE "marken_enden" : markenAnZeilenenden()
        CASE "zl_sortieren" : zeilenWerkzeug("sortieren")
        CASE "zl_doppelte" : zeilenWerkzeug("doppelte")
        CASE "zl_rand" : zeilenWerkzeug("rand")
        CASE "vergleichen" : dateienVergleichen()
        CASE "umb_projekt"
            umbenennWort = wortUnterMarke$()
            IF umbenennWort = "" THEN
                GUI_SET_TEXT(lblStatus, "Unter der Marke steht kein Wort.")
            ELSE
                dlgUmbProjekt = GUI_PROMPT("Im ganzen Projekt umbenennen", _
                    "'" + umbenennWort + "' ueberall im Projektordner ersetzen durch:", umbenennWort)
            END IF
        CASE "andere_zu" : andereSchliessen()
        CASE "linien" : linienSetzen(NOT linienAn)
        CASE "zeile" : dlgZeile = GUI_PROMPT("Gehe zu Zeile", "Zeilennummer:", "")
        CASE "projekt" : dlgProjekt = GUI_PROMPT("Im Projekt suchen", "Wonach (alle .dh in " + BASENAME(projektOrdner) + ")?", suchtext)
        CASE "vervoll"
            ' Steht die Liste schon (weil sie beim Tippen aufging), holt
            ' Strg+Leer sie nur nach vorn -- ausgewaehlt wird mit den
            ' Pfeilen und Enter.
            IF vervollOffen THEN GUI_FOCUS(lstVervoll) ELSE vervollstaendigen(TRUE)
        CASE "definition" : zurDefinition()
        CASE "umbenennen" : umbenennenFragen()
        CASE "schnipsel" : schnipselWaehlen()
        CASE "einstellungen" : einstellungenZeigen()
        CASE "befehle" : befehleZeigen()
        CASE "peek" : peekZeigen()
        CASE "symbole" : symbolVerzeichnis()
        CASE "baum_oeffnen" : baumAuswahlOeffnen()
        CASE "marken" : markenAufFundstellen()
        CASE "palette" : paletteOeffnen()
        CASE "start" : starten()
        CASE "stopp" : stoppen()
        CASE "pruefen" : problemModus = 0 : pruefen()
        CASE "debug" : debuggen()
        CASE "haltepunkt" : haltepunktUmschalten()
        CASE "weiter_d" : debugSchritt("continue")
        CASE "drueber" : debugSchritt("step-over")
        CASE "hinein" : debugSchritt("step-into")
        CASE "heraus" : debugSchritt("step-out")
        CASE "profil" : profilAufnehmen()
        CASE "thema"
            hell = NOT hell
            GUI_MENU_CHECK(miThema, hell)
            IF hell THEN GUI_THEME_PRESET("glas_hell") ELSE GUI_THEME_PRESET("glas_dunkel")
            konfigSichern()
        CASE "vollbild" : SET_FULLSCREEN(NOT WINDOW_IS_FULLSCREEN())
        CASE "umbruch" : umbruchSetzen(NOT umbruchAn)
        CASE "geteilt" : geteiltSetzen(NOT geteilt)
        CASE "minimap" : minimapSetzen(NOT minimapAn)
        CASE "falten" : faltenUmschalten()
        CASE "falten_alle" : faltenAlle(TRUE)
        CASE "falten_auf" : faltenAlle(FALSE)
        CASE "ueber" : dlgUeber = GUI_DIALOG("Ueber", ueberText$(), "ok") : protokoll("ueber " + VERSION$())
        CASE "handbuch" : handbuch()
        CASE "hb_ansicht" : handbuchAnsicht(NOT hbGesetzt)
        CASE "drucken" : listingDrucken()
        CASE "pdf" : listingAlsPdf()
        CASE "wz_sfx" : werkzeugStarten("183_sfx_generator.dh")
        CASE "wz_partikel" : werkzeugStarten("185_partikel_editor.dh")
        CASE "wz_tilemap" : werkzeugStarten("187_tilemap_editor.dh")
        CASE "wz_sprite" : werkzeugStarten("189_sprite_editor.dh")
        CASE "wz_tracker" : werkzeugStarten("190_tracker.dh")
        CASE "wz_form" : werkzeugStarten("197_form_designer.dh")
        CASE "wz_anim" : werkzeugStarten("198_anim_fsm_editor.dh")
        CASE "wz_noten" : werkzeugStarten("199_notenblatt.dh")
        CASE "beispiele" : beispieleOeffnen()
        CASE "ausdruck"
            IF prozessArt = "debug" AND debugPause THEN GUI_FOCUS(tfEingabe) ELSE GUI_SET_TEXT(lblStatus, "Der Debugger steht gerade nicht -- erst F7 und ein Halt.")
    END SELECT
END SUB

' --- Symbole in den Menues --------------------------------------------
' Gezeichnet statt geladen: ein Ordner voller PNGs waere eine zweite Sache,
' die beim Installieren mitkommen muss, und 16x16 aus Rechtecken und
' Strichen ist keine Kunst. IMAGE_NEW ohne Farbe ist DURCHSICHTIG -- ueber
' eine Farbe waere das gar nicht auszudruecken, weil Deckkraft 0 als
' deckend gilt.
CONST SYM_A = &H2BC4E8        ' Akzent
CONST SYM_G = &H7E8E9E        ' ruhiges Grau -- liest sich auf hellem UND dunklem Thema
CONST SYM_R = &HE06060        ' Warnfarbe

FUNCTION symbolBild(art AS STRING) AS IMAGE
    DIM b AS IMAGE : b = IMAGE_NEW(16, 16)
    ' Loecher werden GESTOCHEN (IMAGE_CLEAR schreibt Durchsichtigkeit) und
    ' nicht mit der Hintergrundfarbe uebermalt: die Symbole sollen auf dem
    ' hellen Thema so aussehen wie auf dem dunklen. Mit einer Farbe waere das
    ' gar nicht auszudruecken -- Deckkraft 0 gilt in Drachenhauch als deckend.
    SELECT CASE art
        CASE "neu"
            IMAGE_DRAW_RECT(b, 3, 1, 10, 14, SYM_G)
            IMAGE_CLEAR(b, 4, 2, 8, 12)
            IMAGE_DRAW_RECT(b, 7, 4, 2, 8, SYM_A) : IMAGE_DRAW_RECT(b, 4, 7, 8, 2, SYM_A)
        CASE "oeffnen"
            IMAGE_DRAW_RECT(b, 1, 3, 6, 3, SYM_A)
            IMAGE_DRAW_RECT(b, 1, 5, 14, 9, SYM_A)
            IMAGE_CLEAR(b, 3, 8, 10, 4)
        CASE "sichern"
            IMAGE_DRAW_RECT(b, 2, 2, 12, 12, SYM_A)
            ' Schieber und Aufkleber muessen INNEN liegen: reichen sie an den
            ' Rand, bleiben nur zwei Balken stehen und die Diskette liest sich
            ' als Buchstabe H.
            IMAGE_CLEAR(b, 5, 3, 6, 4)
            IMAGE_CLEAR(b, 4, 10, 8, 3)
        CASE "suchen"
            IMAGE_DRAW_CIRCLE(b, 6, 6, 5, SYM_G)
            IMAGE_CLEAR(b, 4, 4, 5, 5)
            IMAGE_DRAW_LINE(b, 10, 10, 14, 14, SYM_G)
            IMAGE_DRAW_LINE(b, 11, 10, 15, 14, SYM_G)
        CASE "start"
            ' Ein Dreieck aus senkrechten Strichen -- IMAGE_ hat keines.
            DIM k AS INTEGER
            FOR k = 0 TO 6
                IMAGE_DRAW_RECT(b, 4 + k, 2 + k, 1, 12 - 2 * k, &H60D080)
            NEXT
        CASE "stopp"
            IMAGE_DRAW_RECT(b, 4, 4, 8, 8, SYM_R)
        CASE "debug"
            IMAGE_DRAW_CIRCLE(b, 8, 9, 4, SYM_A)
            IMAGE_DRAW_LINE(b, 2, 6, 5, 8, SYM_A) : IMAGE_DRAW_LINE(b, 14, 6, 11, 8, SYM_A)
            IMAGE_DRAW_LINE(b, 2, 13, 5, 11, SYM_A) : IMAGE_DRAW_LINE(b, 14, 13, 11, 11, SYM_A)
        CASE "haltepunkt"
            IMAGE_DRAW_CIRCLE(b, 8, 8, 5, SYM_R)
        CASE "pruefen"
            IMAGE_DRAW_LINE(b, 3, 8, 6, 12, &H60D080)
            IMAGE_DRAW_LINE(b, 4, 8, 7, 12, &H60D080)
            IMAGE_DRAW_LINE(b, 6, 12, 13, 4, &H60D080)
            IMAGE_DRAW_LINE(b, 7, 12, 14, 4, &H60D080)
        CASE "handbuch"
            IMAGE_DRAW_RECT(b, 2, 2, 12, 12, SYM_G)
            IMAGE_CLEAR(b, 3, 3, 4, 10)
            IMAGE_CLEAR(b, 9, 3, 4, 10)
        CASE "drucken"
            IMAGE_DRAW_RECT(b, 4, 1, 8, 4, SYM_G)
            IMAGE_DRAW_RECT(b, 1, 5, 14, 6, SYM_A)
            IMAGE_DRAW_RECT(b, 4, 10, 8, 5, SYM_G)
        CASE "werkzeug"
            IMAGE_DRAW_CIRCLE(b, 8, 8, 6, SYM_G)
            IMAGE_CLEAR(b, 6, 6, 5, 5)
        CASE "export"
            IMAGE_DRAW_RECT(b, 2, 9, 12, 5, SYM_G)
            IMAGE_DRAW_RECT(b, 7, 2, 2, 6, SYM_A)
            IMAGE_DRAW_LINE(b, 4, 5, 8, 1, SYM_A) : IMAGE_DRAW_LINE(b, 12, 5, 8, 1, SYM_A)
        CASE ELSE
            IMAGE_DRAW_CIRCLE(b, 8, 8, 3, SYM_G)
    END SELECT
    RETURN b
END FUNCTION

SUB symbol(eintrag AS INTEGER, art AS STRING)
    GUI_MENU_ICON(eintrag, symbolBild(art))
END SUB

symbol(miNeu, "neu") : symbol(miOeffnen, "oeffnen") : symbol(miSchnell, "oeffnen")
symbol(miSichern, "sichern") : symbol(miSichernAls, "sichern")
symbol(miDrucken, "drucken") : symbol(miPdf, "drucken")
symbol(miSuchen, "suchen") : symbol(miWeiter, "suchen") : symbol(miErsetzen, "suchen")
symbol(miProjekt, "suchen") : symbol(miTodo, "suchen") : symbol(miBlame, "handbuch")
symbol(miStart, "start") : symbol(miStopp, "stopp") : symbol(miPruefen, "pruefen")
symbol(miDebug, "debug") : symbol(miHaltepunkt, "haltepunkt") : symbol(miBedingung, "haltepunkt")
symbol(miExport, "export")
symbol(miWzSfx, "werkzeug") : symbol(miWzPartikel, "werkzeug") : symbol(miWzTilemap, "werkzeug")
symbol(miWzSprite, "werkzeug") : symbol(miWzTracker, "werkzeug") : symbol(miWzForm, "werkzeug")
symbol(miWzAnim, "werkzeug") : symbol(miWzNoten, "werkzeug")
symbol(miHandbuch, "handbuch") : symbol(miKuerzel, "handbuch")

' --- Schnipsel: die Geruester, die man staendig tippt -----------------
' Der senkrechte Strich sagt, wohin die Schreibmarke danach gehoert.
schnipsel("Spielschleife (SCREEN + Bildschleife)", "screen", "SCREEN(800, 600, " + CHR$(34) + "Spiel" + CHR$(34) + ", 1)" + NL + "SETFPS(60)" + NL + NL + "WHILE NOT QUITREQUESTED()" + NL + "    CLS(BLACK)" + NL + "    |" + NL + "    FLIP()" + NL + "WEND")
schnipsel("FOR-Schleife", "for", "DIM i AS INTEGER" + NL + "FOR i = 0 TO |" + NL + NL + "NEXT")
schnipsel("FOR EACH", "foreach", "DIM e AS STRING" + NL + "FOR EACH e IN |" + NL + NL + "NEXT")
schnipsel("WHILE", "while", "WHILE |" + NL + NL + "WEND")
schnipsel("IF ... ELSE", "if", "IF | THEN" + NL + NL + "ELSE" + NL + NL + "END IF")
schnipsel("SELECT CASE", "select", "SELECT CASE |" + NL + "    CASE 1" + NL + NL + "    CASE ELSE" + NL + NL + "END SELECT")
schnipsel("SUB", "sub", "SUB |()" + NL + NL + "END SUB")
schnipsel("FUNCTION", "function", "FUNCTION |() AS INTEGER" + NL + "    RETURN 0" + NL + "END FUNCTION")
schnipsel("CLASS mit Init", "class", "CLASS |" + NL + "    DIM wert AS INTEGER" + NL + NL + "    SUB Init()" + NL + "        Self.wert = 0" + NL + "    END SUB" + NL + "END CLASS")
schnipsel("TRY ... CATCH", "try", "TRY" + NL + "    |" + NL + "CATCH e" + NL + "    PRINT " + CHR$(34) + "Fehler: " + CHR$(34) + " + e" + NL + "END TRY")
schnipsel("Datei zeilenweise lesen", "readlines", "DIM zeilen AS ARRAY OF STRING" + NL + "zeilen = READLINES(|)" + NL + "DIM z AS STRING" + NL + "FOR EACH z IN zeilen" + NL + "    PRINT z" + NL + "NEXT")
schnipsel("gui-Fenster mit Knopf", "gui", "IMPORT " + CHR$(34) + "gui" + CHR$(34) + NL + "DIM win AS GUI_WINDOW" + NL + "win = GUI_WINDOW(" + CHR$(34) + "Fenster" + CHR$(34) + ", 60, 60, 320, 200)" + NL + "DIM knopf AS GUI_WIDGET" + NL + "knopf = GUI_BUTTON(win, " + CHR$(34) + "Los" + CHR$(34) + ", 20, 20, 100, 30)" + NL + NL + "WHILE NOT QUITREQUESTED()" + NL + "    GUI_UPDATE()" + NL + "    IF GUI_CLICKED(knopf) THEN |" + NL + "    CLS(BLACK)" + NL + "    GUI_DRAW()" + NL + "    FLIP()" + NL + "WEND")
schnipsel("Sprite mit Animation", "sprite", "DIM held AS SPRITE" + NL + "held = SPRITE_NEW(LOADIMAGE(|), 32, 32)" + NL + "SPRITE_ADD_ANIM(held, " + CHR$(34) + "lauf" + CHR$(34) + ", 0, 3, 8.0)" + NL + "SPRITE_PLAY(held, " + CHR$(34) + "lauf" + CHR$(34) + ")")

' --- Start -------------------------------------------------------------
layout()
reiterNeuSetzen()
baumFuellen()
zuletztAnzeigen()
' Die Sitzung von zuletzt: was offen war, ist wieder offen (was es noch
' gibt). Gefragt wird zuerst nach DIESEM Projekt -- kennt die Datei den
' Ordner nicht, gilt die zuletzt geschlossene Sitzung, wie bis Stand 4.
DIM sitzDateien AS ARRAY OF STRING : sitzDateien = []
DIM sitzAktiv AS INTEGER : sitzAktiv = 0
DIM sp0 AS INTEGER : sp0 = ARRAY_INDEXOF(projOrdner, startOrdner)
IF sp0 >= 0 THEN
    IF projDateien[sp0] <> "" THEN sitzDateien = SPLIT$(projDateien[sp0], "|")
    sitzAktiv = projAktiv[sp0]
ELSEIF NOT JSON_HAS(konfig, "projekte") AND JSON_HAS(konfig, "sitzung") THEN
    ' Nur beim ersten Start nach Stand 4: da gab es die Sitzung nur einmal
    ' fuer alles. Sobald es Projekte gibt, faengt ein unbekannter Ordner
    ' LEER an -- sonst schleppte man die Reiter des letzten Projekts mit.
    DIM sz AS INTEGER
    FOR sz = 0 TO JSON_LEN(konfig, "sitzung") - 1
        ARRAY_PUSH(sitzDateien, JSON_GET_STRING(konfig, "sitzung." + STR$(sz)))
    NEXT
    IF JSON_HAS(konfig, "aktiv") THEN sitzAktiv = JSON_GET_INT(konfig, "aktiv")
END IF
DIM sd AS STRING
FOR EACH sd IN sitzDateien
    IF FILEEXISTS(sd) AND tabAnzahl < MAX_TABS THEN dateiOeffnen(sd)
NEXT
IF tabAnzahl > 0 THEN
    aktiverTab = MAX(0, MIN(tabAnzahl - 1, sitzAktiv))
    reiterNeuSetzen()
END IF
' Der Projektordner wandert beim Oeffnen mit -- fuer die Sitzung gilt aber
' der Ordner, in dem der Nutzer STAND.
IF sp0 >= 0 THEN projektOrdner = startOrdner : baumFuellen()
IF umbruchAn THEN umbruchSetzen(TRUE)
' ARG$ zaehlt ab 0: das erste Wort hinter `--`.
IF ARGC() >= 1 THEN
    DIM startDatei AS STRING : startDatei = ARG$(0)
    ' relativ heisst: relativ zum Ort des Nutzers, nicht zum Ort der IDE
    IF LEFT$(startDatei, 1) <> "/" AND LEFT$(startDatei, 1) <> "\" AND MID$(startDatei, 1, 1) <> ":" THEN
        startDatei = PATHJOIN(startOrdner, startDatei)
    END IF
    IF FILEEXISTS(startDatei) THEN dateiOeffnen(startDatei) ELSE GUI_SET_TEXT(lblStatus, "Gibt es nicht: " + startDatei)
END IF
protokoll("projekt " + projektOrdner)
protokoll("bereit")

DIM warBreite AS INTEGER : warBreite = SCREENWIDTH()
DIM warHoehe AS INTEGER : warHoehe = SCREENHEIGHT()
DIM letzterTab AS INTEGER : letzterTab = -1

WHILE NOT QUITREQUESTED() AND NOT beenden
    GUI_UPDATE()
    IF WINDOW_RESIZED() OR SCREENWIDTH() <> warBreite OR SCREENHEIGHT() <> warHoehe THEN
        warBreite = SCREENWIDTH() : warHoehe = SCREENHEIGHT()
        layout()
    END IF

    ' Reiterwechsel durch Klick auf die Leiste
    IF tabAnzahl > 0 AND GUI_ACTIVE_TAB(win) <> aktiverTab THEN
        DIM vorherTab AS INTEGER : vorherTab = aktiverTab
        aktiverTab = GUI_ACTIVE_TAB(win)
        geteiltNachziehen(vorherTab)
        letzteMarke = ""
        ' Gliederung und faltbare Bloecke gehoeren zum FELD -- ohne das
        ' Zuruecksetzen behielte der neue Reiter die Bloecke des alten.
        gliederungSchluessel = "" : faltSchluessel = "-"
        pruefungFaellig = GET_TIME()
    END IF

    ' --- Menue (Klick oder Kuerzel) ---
    IF GUI_CLICKED(miNeu) THEN befehl("neu")
    IF GUI_CLICKED(miOeffnen) THEN befehl("oeffnen")
    IF GUI_CLICKED(miSichern) THEN befehl("sichern")
    IF GUI_CLICKED(miSichernAls) THEN befehl("sichern_unter")
    IF GUI_CLICKED(miSchliessen) THEN befehl("schliessen")
    IF GUI_CLICKED(miBeenden) THEN befehl("beenden")
    IF GUI_CLICKED(miSuchen) THEN befehl("suchen")
    IF GUI_CLICKED(miWeiter) THEN befehl("weiter")
    IF GUI_CLICKED(miErsetzen) THEN befehl("ersetzen")
    IF GUI_CLICKED(miZeile) THEN befehl("zeile")
    IF GUI_CLICKED(miProjekt) THEN befehl("projekt")
    IF GUI_CLICKED(miVervoll) THEN befehl("vervoll")
    IF GUI_CLICKED(miDefinition) THEN befehl("definition")
    IF GUI_CLICKED(miUmbenennen) THEN befehl("umbenennen")
    IF GUI_CLICKED(miSchnipsel) THEN befehl("schnipsel")
    IF GUI_CLICKED(miEinstellungen) THEN befehl("einstellungen")
    IF GUI_CLICKED(miBefehle) THEN befehl("befehle")
    IF GUI_CLICKED(miPeek) THEN befehl("peek")
    IF GUI_CLICKED(miSymbole) THEN befehl("symbole")
    IF GUI_CLICKED(miErsProjekt) THEN befehl("ersetzen_projekt")
    IF GUI_CLICKED(miAusgabeSuche) THEN befehl("ausgabe_suchen")
    IF GUI_CLICKED(miMarkeNaechste) THEN befehl("marke_naechste")
    IF GUI_CLICKED(miMarkeEnden) THEN befehl("marken_enden")
    IF GUI_CLICKED(miUmbProjekt) THEN befehl("umb_projekt")
    IF GUI_CLICKED(miVergleich) THEN befehl("vergleichen")
    IF GUI_CLICKED(miZlSort) THEN befehl("zl_sortieren")
    IF GUI_CLICKED(miZlDoppelt) THEN befehl("zl_doppelte")
    IF GUI_CLICKED(miZlRand) THEN befehl("zl_rand")
    IF GUI_CLICKED(miAndereZu) THEN befehl("andere_zu")
    IF GUI_CLICKED(miLinien) THEN befehl("linien")
    IF GUI_CLICKED(miBaumOeffnen) THEN befehl("baum_oeffnen")
    IF GUI_CLICKED(miMarken) THEN befehl("marken")
    IF GUI_CLICKED(miPalette) THEN befehl("palette")
    IF GUI_CLICKED(miStart) THEN befehl("start")
    IF GUI_CLICKED(miStopp) THEN befehl("stopp")
    IF GUI_CLICKED(miPruefen) THEN befehl("pruefen")
    IF GUI_CLICKED(miDebug) THEN befehl("debug")
    IF GUI_CLICKED(miHaltepunkt) THEN befehl("haltepunkt")
    IF GUI_CLICKED(miWeiterD) OR GUI_CLICKED(btnWeiter) THEN befehl("weiter_d")
    IF GUI_CLICKED(miDrueber) OR GUI_CLICKED(btnDrueber) THEN befehl("drueber")
    IF GUI_CLICKED(miHinein) OR GUI_CLICKED(btnHinein) THEN befehl("hinein")
    IF GUI_CLICKED(miHeraus) OR GUI_CLICKED(btnHeraus) THEN befehl("heraus")
    IF GUI_CLICKED(btnStoppD) THEN befehl("stopp")
    IF GUI_CLICKED(miProfil) THEN befehl("profil")
    IF GUI_CLICKED(miThema) THEN befehl("thema")
    IF GUI_CLICKED(miVollbild) THEN befehl("vollbild")
    IF GUI_CLICKED(miUmbruch) THEN befehl("umbruch")
    IF GUI_CLICKED(miGeteilt) THEN befehl("geteilt")
    IF GUI_CLICKED(miMinimap) THEN befehl("minimap")
    IF GUI_CLICKED(miFalten) THEN befehl("falten")
    IF GUI_CLICKED(miFaltenAlle) THEN befehl("falten_alle")
    IF GUI_CLICKED(miFaltenAuf) THEN befehl("falten_auf")
    IF GUI_CLICKED(miUeber) THEN befehl("ueber")
    IF GUI_CLICKED(miHandbuch) THEN befehl("handbuch")
    IF GUI_CLICKED(miDrucken) THEN befehl("drucken")
    IF GUI_CLICKED(miPdf) THEN befehl("pdf")
    IF GUI_CLICKED(miWzSfx) THEN befehl("wz_sfx")
    IF GUI_CLICKED(miWzPartikel) THEN befehl("wz_partikel")
    IF GUI_CLICKED(miWzTilemap) THEN befehl("wz_tilemap")
    IF GUI_CLICKED(miWzSprite) THEN befehl("wz_sprite")
    IF GUI_CLICKED(miWzTracker) THEN befehl("wz_tracker")
    IF GUI_CLICKED(miWzForm) THEN befehl("wz_form")
    IF GUI_CLICKED(miWzAnim) THEN befehl("wz_anim")
    IF GUI_CLICKED(miWzNoten) THEN befehl("wz_noten")
    IF GUI_CLICKED(miBeispiele) THEN befehl("beispiele")
    IF GUI_CLICKED(miAusdruck) THEN befehl("ausdruck")
    IF GUI_CLICKED(miSchnell) THEN befehl("schnell")
    IF GUI_CLICKED(miTodo) THEN befehl("todo")
    IF GUI_CLICKED(miBlame) THEN befehl("blame")
    IF GUI_CLICKED(miDiff) THEN befehl("diff")
    IF GUI_CLICKED(miVerlauf) THEN befehl("verlauf")
    IF GUI_CLICKED(miGitRand) THEN befehl("git_rand")
    IF GUI_CLICKED(miKommentar) THEN befehl("kommentar")
    IF GUI_CLICKED(miDuplizieren) THEN befehl("duplizieren")
    IF GUI_CLICKED(miZeileWeg) THEN befehl("zeile_weg")
    IF GUI_CLICKED(miHoch) THEN befehl("hoch")
    IF GUI_CLICKED(miRunter) THEN befehl("runter")
    IF GUI_CLICKED(miEinruecken) THEN befehl("einruecken")
    IF GUI_CLICKED(miAusruecken) THEN befehl("ausruecken")
    IF GUI_CLICKED(miFormat) THEN befehl("format")
    IF GUI_CLICKED(miLesezeichen) THEN befehl("lesezeichen")
    IF GUI_CLICKED(miLzWeiter) THEN befehl("lz_weiter")
    IF GUI_CLICKED(miLzZurueck) THEN befehl("lz_zurueck")
    IF GUI_CLICKED(miLzListe) THEN befehl("lz_liste")
    IF GUI_CLICKED(miRegex) THEN befehl("regex")
    IF GUI_CLICKED(miWiederauf) THEN befehl("wiederauf")
    IF GUI_CLICKED(miBedingung) THEN befehl("bedingung")
    IF GUI_CLICKED(miExport) THEN befehl("export")
    IF GUI_CLICKED(miGroesser) THEN befehl("groesser")
    IF GUI_CLICKED(miKleiner) THEN befehl("kleiner")
    IF GUI_CLICKED(miKuerzel) THEN befehl("kuerzel")
    DIM zk AS INTEGER
    FOR zk = 0 TO ZULETZT_MAX - 1
        IF GUI_CLICKED(miZuletzt[zk]) AND zk < LEN(zuletzt) THEN dateiOeffnen(zuletzt[zk])
    NEXT
    ' Willkommensseite
    IF GUI_CLICKED(btnWkNeu) THEN befehl("neu")
    IF GUI_CLICKED(btnWkOeffnen) THEN befehl("oeffnen")
    IF GUI_CLICKED(btnWkBeispiele) THEN befehl("beispiele")
    IF GUI_DOUBLE_CLICKED(lstWkZuletzt) AND GUI_LISTBOX_SELECTED(lstWkZuletzt) >= 0 AND GUI_LISTBOX_SELECTED(lstWkZuletzt) < LEN(zuletzt) THEN dateiOeffnen(zuletzt[GUI_LISTBOX_SELECTED(lstWkZuletzt)])
    IF GUI_DOUBLE_CLICKED(lstGliederung) THEN gliederungAnspringen()
    ' Druckdialog
    IF GUI_CLICKED(btnDruckOk) THEN druckenAusfuehren()
    IF GUI_CLICKED(btnDruckPdf) THEN GUI_WINDOW_VISIBLE(winDruck, FALSE) : listingAlsPdf()
    IF GUI_CLICKED(btnDruckWeg) THEN GUI_WINDOW_VISIBLE(winDruck, FALSE) : GUI_FOCUS(aktivesFeld())
    ' Handbuch: Klappliste wechselt das Dokument, Enter/Knopf sucht darin.
    IF GUI_DROPDOWN_SELECTED(ddDoku) <> docLetzteWahl AND GUI_DROPDOWN_SELECTED(ddDoku) >= 0 THEN
        handbuchZeigen(docNamen[GUI_DROPDOWN_SELECTED(ddDoku)], 1)
    END IF
    IF GUI_CLICKED(btnHbSuche) OR GUI_ENTERED(tfHbSuche) THEN handbuchSuchen()
    IF GUI_CLICKED(btnHbAnsicht) THEN handbuchAnsicht(NOT hbGesetzt)
    werkzeugeAufraeumen()
    IF GUI_TABLE_CLICKED(tblProfil) THEN profilAnspringen()
    gitRandNachziehen(FALSE)
    farbfeldNachziehen()
    einstellungenNachziehen()
    befehleNachziehen()
    IF GUI_CLICKED(btnEinstZu) THEN GUI_WINDOW_VISIBLE(winEinst, FALSE) : einstOffen = FALSE : GUI_FOCUS(aktivesFeld())
    IF GUI_CLICKED(btnBefehlEin) OR GUI_DOUBLE_CLICKED(lstBefehle) THEN befehlEinfuegen()
    IF GUI_CLICKED(btnPeekZu) THEN GUI_WINDOW_VISIBLE(winPeek, FALSE) : GUI_FOCUS(aktivesFeld())
    IF GUI_CLICKED(btnPeekHin) THEN
        GUI_WINDOW_VISIBLE(winPeek, FALSE)
        IF peekPfad <> "" THEN dateiOeffnen(peekPfad)
        IF aktivesFeld() >= 0 AND peekZeile > 0 THEN GUI_TEXTAREA_GOTO(aktivesFeld(), peekZeile, 1)
        GUI_FOCUS(aktivesFeld())
    END IF
    IF GUI_CLICKED(btnFarbeOk) THEN farbeUebernehmen()
    IF GUI_CLICKED(btnFarbeWeg) THEN GUI_WINDOW_VISIBLE(winFarbe, FALSE) : farbStart = -1 : GUI_FOCUS(aktivesFeld())

    ' --- Dialoge auswerten ---
    IF dlgSuche <> 0 THEN
        DIM a AS INTEGER : a = GUI_ANSWER(dlgSuche)
        IF a = 1 THEN
            suchtext = GUI_DIALOG_TEXT(dlgSuche)
            dlgSuche = 0
            IF schliessenNachDialog THEN
                schliessenNachDialog = FALSE
                dlgErsetze = GUI_PROMPT("Ersetzen", "Ersetzen durch:", ersatztext)
            ELSE
                weitersuchen(FALSE)
            END IF
        ELSEIF a = 2 THEN
            dlgSuche = 0 : schliessenNachDialog = FALSE
        END IF
    END IF
    IF dlgErsetze <> 0 THEN
        DIM a2 AS INTEGER : a2 = GUI_ANSWER(dlgErsetze)
        IF a2 = 1 AND ersetzenZiel = "projekt" THEN
            ersatztext = GUI_DIALOG_TEXT(dlgErsetze)
            dlgErsetze = 0
            ersetzenZiel = "feld"
            ' Gearbeitet wird auf den DATEIEN. Ein Reiter mit ungesicherten
            ' Aenderungen wuerde sie beim naechsten Sichern ueberschreiben --
            ' lieber abbrechen und es sagen.
            IF projektUngesichert() THEN
                GUI_SET_TEXT(lblStatus, "Erst sichern: ein Reiter hat ungesicherte Aenderungen.")
                protokoll("projekt ersetzt -1")
            ELSE
                DIM pStellen AS INTEGER
                DIM pDateien AS INTEGER
                (pStellen, pDateien) = projektErsetzenZaehlen(suchtext)
                IF pStellen = 0 THEN
                    GUI_SET_TEXT(lblStatus, "Nicht im Projekt gefunden: " + suchtext)
                    protokoll("projekt ersetzt 0")
                ELSE
                    dlgProjErsetze = GUI_DIALOG("Im ganzen Projekt ersetzen", _
                        STR$(pStellen) + " Zeile(n) in " + STR$(pDateien) + " Datei(en) enthalten '" + suchtext + "'." + NL + _
                        "Durch '" + ersatztext + "' ersetzen? Das laesst sich nur ueber git zuruecknehmen.", _
                        "Ersetzen|Abbrechen")
                END IF
            END IF
        ELSEIF a2 = 1 THEN
            ersatztext = GUI_DIALOG_TEXT(dlgErsetze)
            dlgErsetze = 0
            DIM ta AS GUI_WIDGET : ta = aktivesFeld()
            DIM anzahl AS INTEGER : anzahl = 0
            IF ta >= 0 THEN
                GUI_TEXTAREA_GOTO(ta, 1, 1)
                DIM tz AS INTEGER
                DIM ts AS INTEGER
                (tz, ts) = GUI_TEXTAREA_FIND(ta, suchtext, 1, 1)
                WHILE tz >= 0 AND anzahl < 10000
                    GUI_TEXTAREA_SELECT(ta, tz, ts, tz, ts + LEN(suchtext))
                    GUI_TEXTAREA_INSERT(ta, ersatztext)
                    anzahl = anzahl + 1
                    (tz, ts) = GUI_TEXTAREA_FIND(ta, suchtext, tz, ts + LEN(ersatztext))
                WEND
            END IF
            GUI_SET_TEXT(lblStatus, STR$(anzahl) + " mal ersetzt.")
            protokoll("ersetzt " + STR$(anzahl))
        ELSEIF a2 = 2 THEN
            dlgErsetze = 0 : ersetzenZiel = "feld"
        END IF
    END IF
    IF dlgUmbProjekt <> 0 THEN
        DIM au AS INTEGER : au = GUI_ANSWER(dlgUmbProjekt)
        IF au = 1 THEN
            DIM neuerName AS STRING : neuerName = TRIM$(GUI_DIALOG_TEXT(dlgUmbProjekt))
            dlgUmbProjekt = 0
            umbenennenImProjekt(neuerName)
        ELSEIF au = 2 THEN
            dlgUmbProjekt = 0
        END IF
    END IF
    IF dlgProjErsetze <> 0 THEN
        DIM ap AS INTEGER : ap = GUI_ANSWER(dlgProjErsetze)
        IF ap = 1 THEN
            dlgProjErsetze = 0
            projektErsetzenAusfuehren()
        ELSEIF ap = 2 THEN
            dlgProjErsetze = 0
            GUI_SET_TEXT(lblStatus, "Nichts ersetzt.")
        END IF
    END IF
    IF dlgAusgabeSuche <> 0 THEN
        DIM aa AS INTEGER : aa = GUI_ANSWER(dlgAusgabeSuche)
        IF aa = 1 THEN
            DIM neuerText AS STRING : neuerText = GUI_DIALOG_TEXT(dlgAusgabeSuche)
            dlgAusgabeSuche = 0
            ' Derselbe Text noch einmal heisst "weitersuchen" -- ein neuer
            ' faengt oben an.
            DIM abZeile AS INTEGER : abZeile = 0
            IF neuerText = ausgabeSuchtext THEN abZeile = GUI_LISTBOX_SELECTED(lstAusgabe) + 1
            ausgabeSuchtext = neuerText
            IF ausgabeSuchtext <> "" THEN ausgabeSuchen(abZeile)
        ELSEIF aa = 2 THEN
            dlgAusgabeSuche = 0
        END IF
    END IF
    IF dlgZeile <> 0 THEN
        DIM a3 AS INTEGER : a3 = GUI_ANSWER(dlgZeile)
        IF a3 = 1 THEN
            DIM zt AS STRING : zt = GUI_DIALOG_TEXT(dlgZeile)
            dlgZeile = 0
            DIM ta2 AS GUI_WIDGET : ta2 = aktivesFeld()
            IF ta2 >= 0 AND VAL(zt) >= 1 THEN GUI_TEXTAREA_GOTO(ta2, INT(VAL(zt)), 1) : GUI_FOCUS(ta2)
        ELSEIF a3 = 2 THEN
            dlgZeile = 0
        END IF
    END IF
    IF dlgSchliessen <> 0 THEN
        DIM a4 AS INTEGER : a4 = GUI_ANSWER(dlgSchliessen)
        IF a4 = 1 THEN
            DIM i AS INTEGER
            DIM alles AS BOOLEAN : alles = TRUE
            FOR i = 0 TO tabAnzahl - 1
                IF GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN
                    IF NOT sichern(i, FALSE) THEN alles = FALSE
                END IF
            NEXT
            dlgSchliessen = 0
            IF alles THEN beenden = TRUE
        ELSEIF a4 = 2 THEN
            dlgSchliessen = 0 : beenden = TRUE
        ELSEIF a4 = 3 THEN
            dlgSchliessen = 0
        END IF
    END IF
    IF dlgUeber <> 0 THEN
        IF GUI_ANSWER(dlgUeber) <> 0 THEN dlgUeber = 0
    END IF
    IF dlgProjekt <> 0 THEN
        DIM a5 AS INTEGER : a5 = GUI_ANSWER(dlgProjekt)
        IF a5 = 1 THEN
            suchtext = GUI_DIALOG_TEXT(dlgProjekt)
            dlgProjekt = 0
            projektSuchen(suchtext, "")
        ELSEIF a5 = 2 THEN
            dlgProjekt = 0
        END IF
    END IF
    IF dlgUmbenennen <> 0 THEN
        DIM a7 AS INTEGER : a7 = GUI_ANSWER(dlgUmbenennen)
        IF a7 = 1 THEN
            DIM neuerName AS STRING : neuerName = TRIM$(GUI_DIALOG_TEXT(dlgUmbenennen))
            dlgUmbenennen = 0
            umbenennenAusfuehren(neuerName)
        ELSEIF a7 = 2 THEN
            dlgUmbenennen = 0
        END IF
    END IF
    IF dlgBedingung <> 0 THEN
        DIM a6 AS INTEGER : a6 = GUI_ANSWER(dlgBedingung)
        IF a6 = 1 THEN
            DIM ausdruck AS STRING : ausdruck = GUI_DIALOG_TEXT(dlgBedingung)
            dlgBedingung = 0
            haltepunktBedingungSetzen(ausdruck)
        ELSEIF a6 = 2 THEN
            dlgBedingung = 0
        END IF
    END IF

    ' --- Befehlspalette: tippen filtert, Enter/Doppelklick fuehrt aus, ESC schliesst ---
    IF paletteOffen THEN
        IF GUI_TEXT(tfPalette) <> paletteLetzterFilter THEN
            paletteLetzterFilter = GUI_TEXT(tfPalette)
            paletteFuellen(paletteLetzterFilter)
        END IF
        IF GUI_ENTERED(tfPalette) OR GUI_DOUBLE_CLICKED(lstPalette) OR (KEYHIT(KEY_RETURN) AND GUI_FOCUSED() = lstPalette) THEN paletteAusfuehren()
        IF KEYHIT(KEY_ESCAPE) THEN paletteSchliessen()
    END IF

    ' --- Vervollstaendigung: Enter/Doppelklick uebernimmt, ESC schliesst ---
    IF vervollOffen THEN
        IF GUI_DOUBLE_CLICKED(lstVervoll) OR (KEYHIT(KEY_RETURN) AND GUI_FOCUSED() = lstVervoll) THEN vervollUebernehmen()
        IF KEYHIT(KEY_ESCAPE) THEN vervollAus = wortAnfang$() : vervollSchliessen() : GUI_FOCUS(aktivesFeld())
    END IF

    ' --- Der Tabulator hat eine Abkuerzung gemeldet: Schnipsel aufklappen ---
    IF aktivesFeld() >= 0 THEN
        DIM ak AS INTEGER : ak = GUI_TEXTAREA_ABBREV_HIT(aktivesFeld())
        IF ak >= 0 AND ak < LEN(schnipselAbk) THEN schnipselEinfuegen(ak, LEN(schnipselAbk[ak]))
    END IF

    ' --- Baum, Probleme, Eingabe ---
    baumAbfragen()
    IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
    IF GUI_CLICKED(btnEingabe) OR GUI_ENTERED(tfEingabe) THEN eingabeSenden()

    ' --- Aenderungen im aktiven Feld: einfaerben, Pruefung vormerken ---
    IF aktiverTab >= 0 THEN
        DIM tf AS GUI_WIDGET : tf = tabFelder[aktiverTab]
        DIM jetzt AS STRING : jetzt = GUI_TEXT(tf)
        IF jetzt <> tabLetzterText[aktiverTab] THEN
            tabLetzterText[aktiverTab] = jetzt
            pruefungFaellig = GET_TIME() + 0.6
            IF autoSichern > 0 THEN autoFaellig = GET_TIME() + autoSichern
            reiterNeuSetzen()
        END IF
        ' Automatisch sichern: erst nach der eingestellten Ruhe, und nur was
        ' schon einen Namen hat -- fuer einen neuen Reiter kaeme sonst mitten
        ' im Tippen ein Datei-Dialog.
        IF autoSichern > 0 AND autoFaellig >= 0.0 AND GET_TIME() >= autoFaellig THEN
            autoFaellig = -1.0
            IF tabPfade[aktiverTab] <> "" AND jetzt <> tabGesichert[aktiverTab] THEN
                sichern(aktiverTab, FALSE)
                protokoll("auto gesichert")
            END IF
        END IF
        faerben(tf)
        markenNachziehen()
        hilfeNachziehen()
        vervollNachziehen()
        spurNachziehen()
        IF pruefungFaellig >= 0.0 AND GET_TIME() >= pruefungFaellig THEN
            pruefungFaellig = -1.0
            pruefen()
        END IF
    END IF

    prozessNachsehen()
    exportNachsehen()

    CLS(&H0B1119)
    GUI_DRAW()
    minimapZeichnen()
    handbuchSetzen()
    ' Das Handbuch-Fenster liegt ueber der Leinwand des Hauptfensters und
    ' waere sonst von ihr verdeckt -- GUI_DRAW zeichnet Fenster und
    ' Zeichenflaechen in EINEM Durchgang, das Gemalte kommt danach.
    IF GUI_WINDOW_SHOWN(winHandbuch) THEN GUI_DRAW_TOP()
    FLIP()
WEND

konfigSichern()
IF prozess >= 0 THEN PROCESS_KILL(prozess)
IF exportProzess >= 0 THEN PROCESS_KILL(exportProzess)
DIM wz AS INTEGER
FOR EACH wz IN werkzeuge
    PROCESS_KILL(wz)
NEXT
protokoll("ende")
