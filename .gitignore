# Lokale Claude-/Preview-Konfiguration (maschinenspezifische Pfade)
.claude/launch.json

# PyCharm
.idea/
*.iml

# Python (nur noch die zwei Bauskripte in rust/)
__pycache__/
*.py[cod]
.venv/

# Build / Distribution
build/
dist/
*.so

# OS
.DS_Store
Thumbs.db

# Grosse Demo-Musik-Assets (via examples/assets/download_*.dh geladen)
examples/assets/cybermatic_pulse.ogg
examples/assets/techno_messup.ogg
# HDR-Environment fuer HDR-IBL-Demo (via download_hdri.dh geladen)
examples/assets/ibl_env.hdr
# Geriggtes Modell fuer Skelett-Animations-Demo (via download_robot.dh geladen)
examples/assets/robot.glb
# VOIDREAVER-Spielstand/Run-DB (zur Laufzeit erzeugt)
voidreaver/voidreaver.save
voidreaver/voidreaver.db*
# Kaminfeuer-Demo: freie Assets (via fireplace/assets/download.dh geladen)
fireplace/assets/fireplace.jpg
fireplace/assets/fire.ogg
fireplace/assets/wind.mp3
# Bestenliste aus 16_files.dh -- entsteht dort, wo das Programm laeuft
highscores.txt
# Spielstaende und Belege der Beispiele (32_coinquest, 196_rechnungen)
examples/coinquest.db
examples/rechnungen.db
# Eingabe-Aufnahme der AUTOMATION-Demo (153_automation.dh, F9 schreibt sie)
examples/aufnahme.txt

# Drachenhauch-Installer: Quelle committen, Build-Artefakte ignorieren
installer/output/
installer/Drachenhauch.icns
installer/Drachenhauch.png
installer/THIRD-PARTY-NOTICES.txt
installer/THIRD-PARTY-NOTICES-IDE.txt

# Rust build output
target/

# Arbeitskopie der SQLite-Demo (examples/158) -- wird beim Beenden geloescht,
# bleibt aber liegen, wenn die Demo abstuerzt.
examples/tabelle_sqlite_arbeitskopie.db

# Haushaltsbuch: die Buchungen legt das Programm beim ersten Start an --
# Daten des Nutzers, kein Quelltext.
examples/haushaltsbuch/*.db*
examples/notizen/*.db*
examples/notizen/*.pdf
examples/kometen/bestenliste.json
examples/werkstatt3d/bau.txt
examples/feedleser/*.db*

# Tippspiel-Buch: jeder Kapitelstand legt seine SQLite-Datei beim ersten Start
# selbst an (tippspiel.db, kapNN.db, kapNN_sicherung.db, dazu -wal/-shm).
# Das sind die Daten des Lesers, nicht der Quelltext des Buchs.
buch-tippspiel/code/*.db*
buch-tippspiel/code/kap*/*.db*
# Der Export legt den Ordner mit der .exe an -- Bauergebnis, kein Quelltext.
buch-tippspiel/code/*_dist/

# Arbeitsdateien der IDE (Fehlerpruefung/Debugger/Profiler). Sie liegen
# ABSICHTLICH neben der Quelle -- sonst loest `IMPORT "helfer.dh"` nicht auf --
# und bleiben liegen, wenn ein Lauf abbricht.
_dhtmp_*.dh

# Website (tools/website.dh)
/_site/
