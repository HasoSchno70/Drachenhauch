=== valist: vsprintf bekommt eine liste von werten
' Funktionen mit va_list (vprintf, vsprintf, wvsprintfA) nehmen die Werte
' als EINE Liste: ein Tupel, ein Feld, ein einzelner Wert oder NIL. Jedes
' System baut den va_list anders (Windows und Apple-ARM ein Zeiger auf die
' Werte, System V ein Struct mit gp/fp_offset); im Programm sieht man davon
' nichts.
DECLARE FUNCTION vsprintf LIB "msvcrt|c" (ziel AS BUFFER, format AS TEXT, werte AS VALIST) AS LONG
DIM b AS BUFFER
b = BUFFER_NEW(256)
PRINT vsprintf(b, "%d|%s|%.2f|%lld|%x", (42, "Drache", 3.14159, 1234567890123, 255))
PRINT TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
vsprintf(b, "%.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f", (1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 10.5))
PRINT TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
DIM zahlen AS ARRAY OF INTEGER
zahlen = [3, 1, 4, 1, 5, 9, 2, 6]
vsprintf(b, "%d-%d-%d-%d-%d-%d-%d-%d", zahlen)
PRINT TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
vsprintf(b, "<%s>", "einer")
PRINT TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
PRINT vsprintf(b, "keiner", NIL), TEXT_AUS_ZEIGER$(BUFFER_ZEIGER(b))
--- erwartet
31
42|Drache|3.14|1234567890123|ff
1.5 2.5 3.5 4.5 5.5 6.5 7.5 8.5 9.5 10.5
3-1-4-1-5-9-2-6
<einer>
6 keiner

