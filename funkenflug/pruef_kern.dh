' Kern-Pruefung ohne Oberflaeche: Transform, Save/Load, Netze.
IMPORT "kern/kern.dh" AS kern

kern.bibliothekAufbauen()
PRINT "Symbole: "; LEN(kern.bibliothekListe())

DIM dok AS kern.Dokument : dok = NEW kern.Dokument()
DIM bl AS kern.Blatt : bl = dok.blaetter[0]

DIM r AS kern.Bauteil : r = kern.neuesBauteil("R", kern.neueLage(1000, 1000))
r.referenz = "R1"
ARRAY_PUSH(bl.bauteile, r)

DIM w AS kern.Draht : w = NEW kern.Draht()
ARRAY_PUSH(w.punkte, NEW kern.Punkt(1200, 1000))
ARRAY_PUSH(w.punkte, NEW kern.Punkt(2000, 1000))
ARRAY_PUSH(bl.draehte, w)
kern.autoKnoten(bl)

' Transform: Pin 0 (lokal -200,0) bei pos 1000,1000
PRINT "Pin0 rot0:  "; r.pinPunkt(0).x; ","; r.pinPunkt(0).y; "  (erwartet 800,1000)"
r.lage.drehung = 90
PRINT "Pin0 rot90: "; r.pinPunkt(0).x; ","; r.pinPunkt(0).y; "  (erwartet 1000,800)"
r.lage.drehung = 0

' Netz: Pin 1 des R bei (1200,1000) == Drahtende (2000,1000)?
DIM n AS kern.Netze : n = kern.netzeBerechnen(bl)
PRINT "Pin1(1200,1000) ~ Drahtende(2000,1000)? "; n.gleich(1200, 1000, 2000, 1000); " (erwartet TRUE)"
PRINT "Pin0(800,1000)  ~ Drahtende(2000,1000)? "; n.gleich(800, 1000, 2000, 1000); " (erwartet FALSE)"

' Raster: "\" statt "/" (in Drachenhauch ist "/" immer Kommazahl)
PRINT "rastern 0/49/50/149/-49/-50: "; kern.rastern(0, 100); " "; kern.rastern(49, 100); " "; kern.rastern(50, 100); " "; kern.rastern(149, 100); " "; kern.rastern(-49, 100); " "; kern.rastern(-50, 100); "  (erwartet 0 0 100 100 0 -100)"

' Labels: Label A innen auf dem Draht (T), Label B frei bei (5000,5000),
' beide "NETZ" -> Draht und B im selben Netz.
DIM lb AS kern.Blatt : lb = NEW kern.Blatt("L")
DIM w2 AS kern.Draht : w2 = NEW kern.Draht()
ARRAY_PUSH(w2.punkte, NEW kern.Punkt(0, 0))
ARRAY_PUSH(w2.punkte, NEW kern.Punkt(0, 1000))
ARRAY_PUSH(lb.draehte, w2)
ARRAY_PUSH(lb.labels, NEW kern.Label("NETZ", NEW kern.Punkt(0, 500), kern.LA_LOKAL))
ARRAY_PUSH(lb.labels, NEW kern.Label("NETZ", NEW kern.Punkt(5000, 5000), kern.LA_LOKAL))
DIM nl AS kern.Netze : nl = kern.netzeBerechnen(lb)
PRINT "Label A ~ Drahtende (T)?   "; nl.gleich(0, 500, 0, 0); " (erwartet TRUE)"
PRINT "Label A ~ Label B (Name)?  "; nl.gleich(0, 500, 5000, 5000); " (erwartet TRUE)"
PRINT "Drahtende ~ Label B?       "; nl.gleich(0, 0, 5000, 5000); " (erwartet TRUE)"

' Benannte Netze: zwei GND-Symbole ohne Draht sind EIN Netz "GND";
' R1 Pin 1 haengt per Draht an GND, Pin 2 ist frei (automatisch N1).
DIM nb AS kern.Blatt : nb = NEW kern.Blatt("N")
ARRAY_PUSH(nb.bauteile, kern.neuesBauteil("GND", kern.neueLage(0, 0)))
ARRAY_PUSH(nb.bauteile, kern.neuesBauteil("GND", kern.neueLage(5000, 0)))
DIM rn AS kern.Bauteil : rn = kern.neuesBauteil("R", kern.neueLage(200, -1000))
rn.referenz = "R1"
ARRAY_PUSH(nb.bauteile, rn)
DIM wn AS kern.Draht : wn = NEW kern.Draht()
ARRAY_PUSH(wn.punkte, NEW kern.Punkt(0, -1000))
ARRAY_PUSH(wn.punkte, NEW kern.Punkt(0, 0))
ARRAY_PUSH(nb.draehte, wn)
DIM nn AS kern.Netze : nn = kern.netzeBerechnen(nb)
PRINT "Netze: "; LEN(nn.liste); "  (erwartet 2)"
PRINT "Netz an R1.1 / GND rechts / R1.2: "; nn.liste[nn.netzAn(0, -1000)].name; " / "; nn.liste[nn.netzAn(5000, 0)].name; " / "; nn.liste[nn.netzAn(400, -1000)].name; "  (erwartet GND / GND / N1)"
PRINT "echte Pins in GND: "; nn.liste[nn.netzAn(0, 0)].echtePins(); "  (erwartet 1)"

' ERC am Blatt oben: genau ein Verstoss (R1 Pin 2 offen)
DIM ev AS ARRAY OF kern.Verstoss : ev = kern.ercPruefen(nb)
PRINT "ERC-Verstoesse: "; LEN(ev); "  (erwartet 1)"
IF LEN(ev) > 0 THEN PRINT "  -> "; ev[0].text
' Kurzschluss: VCC per Draht an GND
DIM kb AS kern.Blatt : kb = NEW kern.Blatt("K")
ARRAY_PUSH(kb.bauteile, kern.neuesBauteil("VCC", kern.neueLage(0, 0)))
ARRAY_PUSH(kb.bauteile, kern.neuesBauteil("GND", kern.neueLage(0, 1000)))
DIM wk AS kern.Draht : wk = NEW kern.Draht()
ARRAY_PUSH(wk.punkte, NEW kern.Punkt(0, 0))
ARRAY_PUSH(wk.punkte, NEW kern.Punkt(0, 1000))
ARRAY_PUSH(kb.draehte, wk)
DIM ek AS ARRAY OF kern.Verstoss : ek = kern.ercPruefen(kb)
PRINT "Kurzschluss erkannt: "; LEN(ek) > 0 AND ek[0].schwere = kern.ERC_FEHLER; "  (erwartet TRUE)"
IF LEN(ek) > 0 THEN PRINT "  -> "; ek[0].text

' SPICE-Werte
PRINT "spiceWert: "; kern.spiceWert$("4k7"); " "; kern.spiceWert$("2R2"); " "; kern.spiceWert$("1M"); " "; kern.spiceWert$("100n"); " "; kern.spiceWert$("10R"); " "; kern.spiceWert$("330"); " "; kern.spiceWert$("4.7µ")
PRINT "           (erwartet 4.7k 2.2 1Meg 100n 10 330 4.7u)"

' SPICE einer kleinen Schaltung: VCC - R1 4k7 - D1 LED - GND
DIM sb AS kern.Blatt : sb = NEW kern.Blatt("S")
ARRAY_PUSH(sb.bauteile, kern.neuesBauteil("VCC", kern.neueLage(2000, 1200)))
DIM sr AS kern.Bauteil : sr = kern.neuesBauteil("R", kern.neueLage(2000, 2000))
sr.lage.drehung = 90 : sr.referenz = "R1" : sr.wert = "4k7"
ARRAY_PUSH(sb.bauteile, sr)
DIM sd AS kern.Bauteil : sd = kern.neuesBauteil("LED", kern.neueLage(2000, 3000))
sd.lage.drehung = 90 : sd.referenz = "D1"
ARRAY_PUSH(sb.bauteile, sd)
ARRAY_PUSH(sb.bauteile, kern.neuesBauteil("GND", kern.neueLage(2000, 3600)))
DIM sw AS kern.Draht
sw = NEW kern.Draht() : ARRAY_PUSH(sw.punkte, NEW kern.Punkt(2000, 1200)) : ARRAY_PUSH(sw.punkte, NEW kern.Punkt(2000, 1800)) : ARRAY_PUSH(sb.draehte, sw)
sw = NEW kern.Draht() : ARRAY_PUSH(sw.punkte, NEW kern.Punkt(2000, 2200)) : ARRAY_PUSH(sw.punkte, NEW kern.Punkt(2000, 2800)) : ARRAY_PUSH(sb.draehte, sw)
sw = NEW kern.Draht() : ARRAY_PUSH(sw.punkte, NEW kern.Punkt(2000, 3200)) : ARRAY_PUSH(sw.punkte, NEW kern.Punkt(2000, 3600)) : ARRAY_PUSH(sb.draehte, sw)
DIM sp AS STRING : sp = kern.netzlisteSpice$(sb, "Pruefung")
PRINT "--- SPICE ---"
PRINT sp;
PRINT "SPICE enthaelt R1 VCC N1 4.7k: "; CONTAINS(sp, "R1 VCC N1 4.7k"); "  (erwartet TRUE)"
PRINT "SPICE enthaelt D1 N1 0 D_LED:  "; CONTAINS(sp, "D1 N1 0 D_LED"); "  (erwartet TRUE)"
PRINT "ERC der LED-Schaltung: "; LEN(kern.ercPruefen(sb)); " Verstoesse  (erwartet 0)"
PRINT "--- CSV ---"
PRINT kern.netzlisteCsv$(sb);

' Umbenennen: GND -> AGND bleibt SPICE-Masse, VCC -> +5V wird Knoten _5V
PRINT "Stellen GND: "; kern.namensStellen(sb, "GND"); "  (erwartet 1)"
PRINT "umbenannt GND->AGND: "; kern.namenUmbenennen(sb, "GND", "AGND"); "  (erwartet 1)"
PRINT "umbenannt VCC->+5V:  "; kern.namenUmbenennen(sb, "VCC", "+5V"); "  (erwartet 1)"
DIM sp2 AS STRING : sp2 = kern.netzlisteSpice$(sb, "Pruefung")
PRINT "SPICE AGND bleibt Masse: "; CONTAINS(sp2, "D1 N1 0 D_LED"); "  (erwartet TRUE)"
PRINT "SPICE +5V als _5V:       "; CONTAINS(sp2, "R1 _5V N1 4.7k"); "  (erwartet TRUE)"

' Draht aufraeumen: Doppelte und Ecken auf der Geraden weg, Spitze bleibt
DIM wa AS kern.Draht : wa = NEW kern.Draht()
ARRAY_PUSH(wa.punkte, NEW kern.Punkt(0, 0)) : ARRAY_PUSH(wa.punkte, NEW kern.Punkt(0, 0))
ARRAY_PUSH(wa.punkte, NEW kern.Punkt(0, 500)) : ARRAY_PUSH(wa.punkte, NEW kern.Punkt(0, 1000))
ARRAY_PUSH(wa.punkte, NEW kern.Punkt(500, 1000)) : ARRAY_PUSH(wa.punkte, NEW kern.Punkt(500, 1000))
kern.drahtAufraeumen(wa)
PRINT "aufgeraeumt: "; LEN(wa.punkte); " Ecken  (erwartet 3)"
DIM wsp AS kern.Draht : wsp = NEW kern.Draht()
ARRAY_PUSH(wsp.punkte, NEW kern.Punkt(0, 0)) : ARRAY_PUSH(wsp.punkte, NEW kern.Punkt(0, 1000)) : ARRAY_PUSH(wsp.punkte, NEW kern.Punkt(0, 500))
kern.drahtAufraeumen(wsp)
PRINT "Spitze bleibt: "; LEN(wsp.punkte); " Ecken  (erwartet 3)"
PRINT "Pin angeschlossen: "; kern.punktAngeschlossen(sb, 2000, 1800, wa); "  frei: "; kern.punktAngeschlossen(sb, 9000, 9000, wa); "  (erwartet TRUE FALSE)"

' Gummiband
FUNCTION pl$(p AS ARRAY OF kern.Punkt) AS STRING
    DIM t AS STRING : t = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(p) - 1
        IF i > 0 THEN t = t + " "
        t = t + STR$(p[i].x) + "," + STR$(p[i].y)
    NEXT
    RETURN t
END FUNCTION
DIM g1 AS ARRAY OF kern.Punkt : g1 = []
ARRAY_PUSH(g1, NEW kern.Punkt(2000, 1200)) : ARRAY_PUSH(g1, NEW kern.Punkt(2000, 1800))
PRINT "Gummiband Ende  : "; pl$(kern.gummiband(g1, 2, 500, 0)); "  (erwartet 2000,1200 2000,1800 2500,1800)"
DIM g2 AS ARRAY OF kern.Punkt : g2 = []
ARRAY_PUSH(g2, NEW kern.Punkt(2000, 2200)) : ARRAY_PUSH(g2, NEW kern.Punkt(2000, 2800))
PRINT "Gummiband Anfang: "; pl$(kern.gummiband(g2, 1, 500, 0)); "  (erwartet 2500,2200 2000,2200 2000,2800)"
DIM g3 AS ARRAY OF kern.Punkt : g3 = []
ARRAY_PUSH(g3, NEW kern.Punkt(0, 0)) : ARRAY_PUSH(g3, NEW kern.Punkt(0, 1000)) : ARRAY_PUSH(g3, NEW kern.Punkt(1000, 1000))
PRINT "Nachbar rueckt  : "; pl$(kern.gummiband(g3, 2, 0, 300)); "  (erwartet 0,0 0,1300 1000,1300)"
PRINT "Gleiten         : "; pl$(kern.gummiband(g3, 2, 200, 0)); "  (erwartet 0,0 0,1000 1200,1000)"
PRINT "Original bleibt : "; pl$(g3); "  (erwartet 0,0 0,1000 1000,1000)"

' --- Eigene Symbole
DIM fl AS kern.Pinliste : fl = kern.pinlisteLesen("# Kommentar" + CHR$(10) + "1 A links ein" + CHR$(10) + "2 B seitwaerts" + CHR$(10) + "3 C r quatsch" + CHR$(10) + "1 D" + CHR$(10) + "4 E r aus zuviel" + CHR$(10) + CHR$(10) + "5 F")
PRINT "Pinliste: "; LEN(fl.pins); " Pins, "; LEN(fl.fehler); " Fehler  (erwartet 2 Pins, 4 Fehler)"
DIM fi AS INTEGER
FOR fi = 0 TO LEN(fl.fehler) - 1
    PRINT "  "; fl.fehler[fi]
NEXT
DIM nePins AS STRING : nePins = "1 GND unten vin" + CHR$(10) + "2 TRIG links ein" + CHR$(10) + "3 OUT rechts aus" + CHR$(10) + "4 RESET links ein" + CHR$(10) + "5 CTRL links ein" + CHR$(10) + "6 THR links ein" + CHR$(10) + "7 DIS rechts aus" + CHR$(10) + "8 VCC oben vin"
DIM ne AS kern.Symbol : ne = kern.icErzeugen("E_TEST555", "NE555", "U", "NE555", nePins)
DIM aufRaster AS BOOLEAN : aufRaster = TRUE
DIM pi2 AS INTEGER
FOR pi2 = 0 TO LEN(ne.pins) - 1
    IF ne.pins[pi2].pos.x MOD 100 <> 0 OR ne.pins[pi2].pos.y MOD 100 <> 0 THEN aufRaster = FALSE
NEXT
PRINT "NE555: "; LEN(ne.pins); " Pins, alle auf dem Raster: "; aufRaster; "  (erwartet 8 TRUE)"
PRINT "  Pin 3 OUT: "; ne.pins[2].pos.x; ","; ne.pins[2].pos.y; " Typ "; kern.pinTypName$(ne.pins[2].typ); " Richtung "; ne.pins[2].richtung
DIM nj AS kern.Symbol : nj = kern.symbolAusJson(kern.symbolNachJson(ne), "")
PRINT "JSON hin und zurueck: "; LEN(nj.pins); " Pins, Pin 8 bei "; nj.pins[7].pos.x; ","; nj.pins[7].pos.y; ", Quelle gleich: "; nj.quelltext = nePins; "  (erwartet 8, wie oben, TRUE)"
' fehlendes Symbol -> Platzhalter; taucht es auf, heilt das Bauteil
DIM eb AS kern.Blatt : eb = NEW kern.Blatt("E")
DIM ub AS kern.Bauteil : ub = kern.neuesBauteil("E_TEST555", kern.neueLage(0, 0))
ub.referenz = "U1"
ARRAY_PUSH(eb.bauteile, ub)
PRINT "unbekannt -> Platzhalter: "; ub.sym.fehlt; "  ERC: "; kern.ercPruefen(eb)[0].text
DIM reg AS kern.Symbol : reg = kern.symbolRegistrieren(ne)
PRINT "nach Registrieren geheilt: "; NOT ub.sym.fehlt; ", "; LEN(ub.sym.pins); " Pins  (erwartet TRUE, 8)"
' eingebettet in die Datei
DIM ed AS kern.Dokument : ed = NEW kern.Dokument()
ARRAY_PUSH(ed.blaetter[0].bauteile, ub)
DIM ejs AS STRING : ejs = JSON_STRINGIFY(kern.dokumentNachJson(ed))
PRINT "Symbol steckt in der Datei: "; CONTAINS(ejs, "E_TEST555") AND CONTAINS(ejs, "TRIG"); "  (erwartet TRUE)"

' --- Stueckliste
DIM bb AS kern.Blatt : bb = NEW kern.Blatt("B")
DIM bomRefs AS ARRAY OF STRING : bomRefs = ["R10", "R2", "R1", "R3", "R4", "C1"]
DIM bomWerte AS ARRAY OF STRING : bomWerte = ["4k7", "4k7", "4k7", "4k7", "1k", "100n"]
DIM bi2 AS INTEGER
FOR bi2 = 0 TO LEN(bomRefs) - 1
    DIM bt2 AS kern.Bauteil : bt2 = kern.neuesBauteil(IIF(LEFT$(bomRefs[bi2], 1) = "C", "C", "R"), kern.neueLage(bi2 * 1000, 0))
    bt2.referenz = bomRefs[bi2]
    bt2.wert = bomWerte[bi2]
    ARRAY_PUSH(bb.bauteile, bt2)
NEXT
ARRAY_PUSH(bb.bauteile, kern.neuesBauteil("GND", kern.neueLage(0, 2000)))
PRINT "--- Stueckliste ---"
PRINT kern.stuecklisteText$(kern.einBlattDokument(bb));
DIM bz AS ARRAY OF kern.BomZeile : bz = kern.stueckliste(bb)
PRINT "Zeilen: "; LEN(bz); "  erste: "; bz[0].referenzen[0]; "  4k7: "; kern.referenzBereiche$(bz[1].referenzen); " x"; bz[1].menge; "  (erwartet 3, C1, R1-R3, R10 x4)"

' Gruppen drehen/spiegeln: in allen 8 Lagen x 3 Arten muss jeder Pin (und
' seine Stummel-Richtung) genau dort landen, wo punktGruppe ihn hinbringt.
DIM gq AS kern.Symbol : gq = kern.bibliothekSymbol("Q_NPN")
DIM piv AS kern.Punkt : piv = NEW kern.Punkt(1000, 200)
DIM fehlerG AS INTEGER : fehlerG = 0
DIM pruefG AS INTEGER : pruefG = 0
DIM gsp AS INTEGER, gdr AS INTEGER, gart AS INTEGER, gpn AS INTEGER
FOR gsp = 0 TO 1
    FOR gdr = 0 TO 270 STEP 90
        FOR gart = 1 TO 3
            DIM gl AS kern.Lage : gl = NEW kern.Lage(NEW kern.Punkt(300, -500), gdr, gsp = 1)
            DIM gn AS kern.Lage : gn = kern.lageGruppe(gl, piv, gart)
            FOR gpn = 0 TO LEN(gq.pins) - 1
                DIM pv AS kern.Pin : pv = gq.pins[gpn]
                DIM soll AS kern.Punkt : soll = kern.punktGruppe(kern.transformPunkt(gl, pv.pos), piv, gart)
                DIM ist AS kern.Punkt : ist = kern.transformPunkt(gn, pv.pos)
                ' Richtung: wohin zeigt der Stummel nach der Gruppenbewegung?
                DIM rv AS INTEGER : rv = kern.transformRichtung(gl, pv.richtung)
                DIM spitze2 AS kern.Punkt : spitze2 = kern.punktGruppe(NEW kern.Punkt(kern.transformPunkt(gl, pv.pos).x + kern.richtungDx(rv) * 100, kern.transformPunkt(gl, pv.pos).y + kern.richtungDy(rv) * 100), piv, gart)
                DIM rnn AS INTEGER : rnn = kern.transformRichtung(gn, pv.richtung)
                pruefG = pruefG + 1
                IF NOT kern.punktGleich(soll, ist) OR kern.richtungDx(rnn) * 100 <> spitze2.x - soll.x OR kern.richtungDy(rnn) * 100 <> spitze2.y - soll.y THEN
                    fehlerG = fehlerG + 1
                    PRINT "  FEHLER sp="; gsp; " d="; gdr; " art="; gart; " pin "; pv.nummer; ": soll "; soll.x; ","; soll.y; " ist "; ist.x; ","; ist.y
                END IF
            NEXT
        NEXT
    NEXT
NEXT
PRINT "Gruppen-Lage: "; pruefG; " Pin-Pruefungen, Fehler: "; fehlerG; "  (erwartet 72, 0)"
DIM gb AS ARRAY OF kern.Punkt : gb = []
ARRAY_PUSH(gb, NEW kern.Punkt(0, 0)) : ARRAY_PUSH(gb, NEW kern.Punkt(1000, 0))
PRINT "Gummiband beide Enden gleich: "; pl$(kern.gummibandEnden(gb, 100, 200, 100, 200)); "  (erwartet 100,200 1100,200)"
PRINT "Gummiband beide verschieden : "; pl$(kern.gummibandEnden(gb, 0, 200, 0, -200)); "  (erwartet 0,200 0,-200 1000,-200: Enden am Ziel, rechtwinklig)"

' Gummiband darf keinen Kurzschluss erfinden: senkrechter R mit Draehten
' oben und unten, um 90 Grad gedreht -- beide Leitungen wuerden sonst zum
' selben Mittelpunkt knicken.
DIM kz AS kern.Blatt : kz = NEW kern.Blatt("KZ")
DIM rk AS kern.Bauteil : rk = kern.neuesBauteil("R", kern.neueLage(2000, 2000))
rk.lage.drehung = 90
ARRAY_PUSH(kz.bauteile, rk)
DIM wo AS kern.Draht : wo = NEW kern.Draht()
ARRAY_PUSH(wo.punkte, NEW kern.Punkt(2000, 1200)) : ARRAY_PUSH(wo.punkte, NEW kern.Punkt(2000, 1800))
DIM wu AS kern.Draht : wu = NEW kern.Draht()
ARRAY_PUSH(wu.punkte, NEW kern.Punkt(2000, 2200)) : ARRAY_PUSH(wu.punkte, NEW kern.Punkt(2000, 2800))
ARRAY_PUSH(kz.draehte, wo) : ARRAY_PUSH(kz.draehte, wu)
' ein Label, das schon vorher auf dem oberen Draht sitzt, ist KEINE neue
' Beruehrung -- es darf den gewohnten Knick nicht verhindern
ARRAY_PUSH(kz.labels, NEW kern.Label("OBEN", NEW kern.Punkt(2000, 1500), kern.LA_LOKAL))
DIM altO AS kern.Punkt : altO = rk.pinPunkt(0)
DIM altU AS kern.Punkt : altU = rk.pinPunkt(1)
rk.lage = kern.lageGruppe(rk.lage, rk.lage.pos, kern.GR_DREHEN)
DIM neuO AS kern.Punkt : neuO = rk.pinPunkt(0)
DIM neuU AS kern.Punkt : neuU = rk.pinPunkt(1)
wo.punkte = kern.gummibandSicher(kz, wo, wo.punkte, 0, 0, neuO.x - altO.x, neuO.y - altO.y)
wu.punkte = kern.gummibandSicher(kz, wu, wu.punkte, neuU.x - altU.x, neuU.y - altU.y, 0, 0)
DIM nkz AS kern.Netze : nkz = kern.netzeBerechnen(kz)
PRINT "Drehen: oben "; pl$(wo.punkte); " | unten "; pl$(wu.punkte)
PRINT "  Enden an den neuen Pins: "; kern.punktGleich(wo.punkte[LEN(wo.punkte) - 1], neuO) AND kern.punktGleich(wu.punkte[0], neuU); "  kein Kurzschluss: "; NOT nkz.gleich(2000, 1200, 2000, 2800); "  (erwartet TRUE TRUE)"

' --- Mehrere Blaetter: global/lokal, Namen, ERC, Netzliste, Stueckliste
DIM md AS kern.Dokument : md = NEW kern.Dokument()
md.blaetter[0].name = "Haupt"
DIM mb2 AS kern.Blatt : mb2 = NEW kern.Blatt("Takt")
ARRAY_PUSH(md.blaetter, mb2)
DIM mbi AS INTEGER
FOR mbi = 0 TO 1
    DIM mr AS kern.Bauteil : mr = kern.neuesBauteil("R", kern.neueLage(0, 0))
    mr.referenz = "R" + STR$(mbi + 1)
    ARRAY_PUSH(md.blaetter[mbi].bauteile, mr)
    ARRAY_PUSH(md.blaetter[mbi].bauteile, kern.neuesBauteil("VCC", kern.neueLage(1000, 0)))
    ARRAY_PUSH(md.blaetter[mbi].labels, NEW kern.Label("SIG", NEW kern.Punkt(200, 0), kern.LA_GLOBAL))
    ARRAY_PUSH(md.blaetter[mbi].labels, NEW kern.Label("L", NEW kern.Punkt(-200, 0), kern.LA_LOKAL))
NEXT
DIM mn AS kern.Netze : mn = kern.netzeDokument(md)
PRINT "Blaetter: SIG verbunden "; mn.gleichUeber(0, 200, 0, 1, 200, 0); ", lokales L getrennt "; NOT mn.gleichUeber(0, -200, 0, 1, -200, 0); ", VCC verbunden "; mn.gleichUeber(0, 1000, 0, 1, 1000, 0); "  (erwartet TRUE TRUE TRUE)"
mn.blattWaehlen(0)
DIM nameH AS STRING : nameH = mn.liste[mn.netzAn(-200, 0)].name
mn.blattWaehlen(1)
DIM nameT AS STRING : nameT = mn.liste[mn.netzAn(-200, 0)].name
PRINT "Namen der lokalen L: "; nameH; " / "; nameT; "  (erwartet Haupt/L / Takt/L)"
DIM msp AS STRING : msp = kern.netzlisteSpiceDok$(md, "Mehr")
PRINT "SPICE ueber Blaetter: "; CONTAINS(msp, "R1 Haupt_L SIG 1k") AND CONTAINS(msp, "R2 Takt_L SIG 1k"); "  (erwartet TRUE)"
DIM mbz AS ARRAY OF kern.BomZeile : mbz = kern.stuecklisteDok(md)
PRINT "Stueckliste ueber Blaetter: "; kern.referenzBereiche$(mbz[0].referenzen); " x"; mbz[0].menge; "  (erwartet R1, R2 x2)"
' lokale L verbinden NICHT ueber Blaetter -> R1.1 und R2.1 sind wirklich offen
DIM mev0 AS ARRAY OF kern.Verstoss : mev0 = kern.ercPruefenDok(md)
DIM mtx0 AS STRING : mtx0 = ""
DIM mv0 AS INTEGER
FOR mv0 = 0 TO LEN(mev0) - 1
    mtx0 = mtx0 + mev0[mv0].text + "|"
NEXT
PRINT "ERC: "; LEN(mev0); " Verstoesse, R1.1 offen "; CONTAINS(mtx0, "Pin R1.1 ist nicht verbunden"); ", R2.1 offen "; CONTAINS(mtx0, "Pin R2.1 ist nicht verbunden"); "  (erwartet 2, TRUE, TRUE)"
md.blaetter[1].bauteile[0].referenz = "R1"
ARRAY_PUSH(md.blaetter[1].labels, NEW kern.Label("EINZELN", NEW kern.Punkt(3000, 3000), kern.LA_GLOBAL))
DIM mev AS ARRAY OF kern.Verstoss : mev = kern.ercPruefenDok(md)
DIM mtx AS STRING : mtx = ""
DIM mvi AS INTEGER
FOR mvi = 0 TO LEN(mev) - 1
    mtx = mtx + mev[mvi].text + " [Blatt " + STR$(mev[mvi].blatt) + "]|"
NEXT
PRINT "ERC doppelte Ref ueber Blaetter: "; CONTAINS(mtx, "Referenz R1 ist doppelt vergeben [Blatt 1]"); "  einzelnes globales Label: "; CONTAINS(mtx, "Globales Label EINZELN gibt es nur einmal"); "  (erwartet TRUE TRUE)"

' --- Ueberstrich (aktiv-low)
PRINT "Ueberstrich sichtbar: "; kern.sichtbarerText$("~{RESET}"); " "; kern.sichtbarerText$("~CS~/WR"); " "; kern.sichtbarerText$("A~~B"); " "; kern.sichtbarerText$("~{WR}/RD"); "  (erwartet RESET CS/WR A~B WR/RD)"
DIM ue1 AS STRING : ue1 = kern.ueberstrichMarkup$("~{RESET}")
DIM ue2 AS STRING : ue2 = kern.ueberstrichMarkup$("~CS~/WR")
DIM ue3 AS STRING : ue3 = kern.ueberstrichMarkup$("R&D<1>")
PRINT "Markup: "; ue1 = "<span overline=" + CHR$(34) + "single" + CHR$(34) + ">RESET</span>"; " "; ue2 = "<span overline=" + CHR$(34) + "single" + CHR$(34) + ">CS</span>/WR"; " "; ue3; "  (erwartet TRUE TRUE R&amp;D&lt;1&gt;)"
PRINT "Ohne Tilde unveraendert: "; kern.sichtbarerText$("VCC"); " "; kern.hatUeberstrich("VCC"); "  (erwartet VCC FALSE)"

' --- Label-Richtungen folgen der Gruppe wie Pins
PRINT "Label-Richtung: R "; kern.richtungGruppe(0, kern.GR_DREHEN); " "; kern.richtungGruppe(270, kern.GR_DREHEN); "  X "; kern.richtungGruppe(0, kern.GR_SPIEGELN_X); " "; kern.richtungGruppe(90, kern.GR_SPIEGELN_X); "  Y "; kern.richtungGruppe(90, kern.GR_SPIEGELN_Y); " "; kern.richtungGruppe(180, kern.GR_SPIEGELN_Y); "  (erwartet R 90 0  X 180 90  Y 270 180)"

' --- Bauteil-Felder: Gehaeuse/Bestellnummer, Stueckliste trennt danach
DIM fd AS kern.Dokument : fd = NEW kern.Dokument()
DIM fi AS INTEGER
FOR fi = 1 TO 3
    DIM fr AS kern.Bauteil : fr = kern.neuesBauteil("R", kern.neueLage(fi * 1000, 0))
    fr.referenz = "R" + STR$(fi)
    fr.wert = "10k"
    fr.gehaeuse = IIF(fi = 3, "1206", "0805")
    IF fi = 1 THEN fr.bestellnr = "RC0805-10K"
    ARRAY_PUSH(fd.blaetter[0].bauteile, fr)
NEXT
DIM fl AS kern.Label : fl = NEW kern.Label("~{RESET}", NEW kern.Punkt(0, 500), kern.LA_LOKAL)
fl.drehung = 270
ARRAY_PUSH(fd.blaetter[0].labels, fl)
DIM fz AS ARRAY OF kern.BomZeile : fz = kern.stuecklisteDok(fd)
PRINT "Stueckliste nach Gehaeuse: "; LEN(fz); " Positionen  "; JOIN$(fz[0].referenzen, ","); "/"; fz[0].gehaeuse; "/"; fz[0].bestellnr; "  "; JOIN$(fz[1].referenzen, ","); "/"; fz[1].gehaeuse; "  "; JOIN$(fz[2].referenzen, ","); "/"; fz[2].gehaeuse; "  (erwartet 3 Positionen  R1/0805/RC0805-10K  R2/0805  R3/1206)"
PRINT "CSV-Kopf: "; STARTSWITH(kern.stuecklisteCsv$(fd), "Menge;Referenzen;Wert;Bauteil;Gehaeuse;Bestellnummer;Beschreibung"); "  Markdown-Spalten: "; CONTAINS(kern.stuecklisteMarkdown$(fd, "F"), "| Gehaeuse | Bestellnummer |"); " "; CONTAINS(kern.stuecklisteMarkdown$(fd, "F"), "| 1 | R3 | 10k | Widerstand | 1206 |  |"); "  (erwartet TRUE TRUE TRUE)"
DIM fd2 AS kern.Dokument : fd2 = kern.dokumentAusJson(kern.dokumentNachJson(fd))
PRINT "JSON: "; fd2.blaetter[0].bauteile[0].gehaeuse; " "; fd2.blaetter[0].bauteile[0].bestellnr; " "; fd2.blaetter[0].bauteile[1].bestellnr = ""; " "; fd2.blaetter[0].labels[0].text; " "; fd2.blaetter[0].labels[0].drehung; "  (erwartet 0805 RC0805-10K TRUE ~{RESET} 270)"
ARRAY_PUSH(fd.blaetter[0].labels, NEW kern.Label("~{RESET}", fd.blaetter[0].bauteile[0].pinPunkt(0), kern.LA_LOKAL))
DIM fn AS kern.Netze : fn = kern.netzeBerechnen(fd.blaetter[0])
PRINT "Netzname bleibt der geschriebene Text: "; fn.liste[fn.netzAn(fd.blaetter[0].bauteile[0].pinPunkt(0).x, fd.blaetter[0].bauteile[0].pinPunkt(0).y)].name; "  (erwartet ~{RESET})"

' --- Freie Symbolgrafik und frei gesetzte Pins
DIM lf AS STRING : lf = CHR$(10)
DIM opvText AS STRING : opvText = "# Operationsverstaerker, frei gezeichnet" + lf + "linie -2 -3 3 0 -2 3 -2 -3" + lf + "kreis 0 0 0,5 voll" + lf + "bogen 0 0 4 0 90" + lf + "text 0 -4 OPV" + lf + "pin 1 IN- -5 -1 links ein" + lf + "pin 2 IN+ -5 1 links ein" + lf + "pin 3 OUT 5 0 rechts aus 2"
DIM opv AS kern.Symbol : opv = kern.icErzeugen("E_OPV", "OPV", "U", "", opvText)
DIM opvPl AS kern.Pinliste : opvPl = kern.pinlisteLesen(opvText)
PRINT "Frei: Fehler "; LEN(opvPl.fehler); ", Grafik "; LEN(opv.grafik); ", Pins "; LEN(opv.pins); ", kein Rechteck "; opv.grafik[0].art = kern.PR_POLYLINIE; "  (erwartet 0, 4, 3, TRUE)"
PRINT "Frei: Polylinie "; LEN(opv.grafik[0].punkte); " Punkte, Kreis voll "; opv.grafik[1].fuellen; " r "; opv.grafik[1].radius; ", Bogen bis "; ROUND(opv.grafik[2].winkel2 * 180 / PI); " Grad, Text "; opv.grafik[3].text; "  (erwartet 4 Punkte, TRUE r 50, 90 Grad, OPV)"
PRINT "Frei: Pin 3 bei "; opv.pins[2].pos.x; ","; opv.pins[2].pos.y; " Laenge "; opv.pins[2].laenge; " Richtung "; opv.pins[2].richtung; " Typ aus "; opv.pins[2].typ = kern.PIN_AUSGANG; ", Pin 1 Richtung "; opv.pins[0].richtung; "  (erwartet 500,0 Laenge 200 Richtung 180 Typ aus TRUE, Pin 1 Richtung 0)"
PRINT "Frei: Texte ueber/unter der Grafik "; opv.refOrt.y < -300; " "; opv.wertOrt.y > 300; "  (erwartet TRUE TRUE)"
DIM opvJ AS kern.Symbol : opvJ = kern.symbolAusJson(kern.symbolNachJson(opv), "")
PRINT "Frei JSON: "; LEN(opvJ.grafik); " "; opvJ.grafik[1].fuellen; " "; opvJ.grafik[3].text; " "; LEN(opvJ.pins); " Name "; opvJ.pins[0].name; " versteckt "; NOT opvJ.pins[0].zeigeName; "  (erwartet 4 TRUE OPV 3 Name IN- versteckt TRUE)"
DIM fpl AS kern.Pinliste : fpl = kern.pinlisteLesen("1 A links" + lf + "pin 1 B 0 0 links" + lf + "pin 2 C 1,5 0 links" + lf + "kreis 0 0" + lf + "linie 0 0 x 1" + lf + "bogen 0 0 1 0 90 voll")
DIM fft AS STRING : fft = JOIN$(fpl.fehler, "|")
PRINT "Frei Fehler: "; LEN(fpl.fehler); " doppelt "; CONTAINS(fft, "Zeile 2: Pin-Nummer 1 gibt es schon"); " Raster "; CONTAINS(fft, "Zeile 3: pin 2: der Punkt liegt nicht auf dem 1-mm-Raster"); " Kreis "; CONTAINS(fft, "Zeile 4: kreis braucht"); " Zahl "; CONTAINS(fft, "Zeile 5: 'x' ist keine Zahl"); " Bogen "; CONTAINS(fft, "Zeile 6: bogen braucht"); "  (erwartet 5 TRUE TRUE TRUE TRUE TRUE)"
DIM gem AS kern.Symbol : gem = kern.icErzeugen("E_GEM", "Logo-IC", "U", "", "1 A links" + lf + "2 B rechts" + lf + "text 0 0 LOGO")
PRINT "Gemischt: "; LEN(gem.grafik); " Grafik (Rechteck + Text), erstes Rechteck "; gem.grafik[0].art = kern.PR_RECHTECK; "  (erwartet 2, TRUE)"

' --- Referenz/Wert-Versatz wird gespeichert
DIM vd AS kern.Dokument : vd = NEW kern.Dokument()
DIM vb AS kern.Bauteil : vb = kern.neuesBauteil("R", kern.neueLage(0, 0))
vb.referenz = "R1"
vb.refVersatz = NEW kern.Punkt(250, -150)
ARRAY_PUSH(vd.blaetter[0].bauteile, vb)
DIM vd2 AS kern.Dokument : vd2 = kern.dokumentAusJson(kern.dokumentNachJson(vd))
PRINT "Versatz JSON: "; vd2.blaetter[0].bauteile[0].refVersatz.x; ","; vd2.blaetter[0].bauteile[0].refVersatz.y; " Wert "; vd2.blaetter[0].bauteile[0].wertVersatz.x; ","; vd2.blaetter[0].bauteile[0].wertVersatz.y; "  (erwartet 250,-150 Wert 0,0)"

' Save / Load
DIM pfad AS STRING : pfad = "C:/Programmieren/Python/GameBasic/funkenflug/pruef.fkn"
PRINT "Speichern: "; kern.dokumentSpeichern(dok, pfad)
DIM dok2 AS kern.Dokument : dok2 = kern.dokumentLaden(pfad)
PRINT "Geladen Bauteile: "; LEN(dok2.blaetter[0].bauteile)
PRINT "Geladen Ref:      "; dok2.blaetter[0].bauteile[0].referenz
PRINT "Geladen Wert:     "; dok2.blaetter[0].bauteile[0].wert
PRINT "Geladen Draehte:  "; LEN(dok2.blaetter[0].draehte)
PRINT "fertig"
