=== die klappliste rollt herab
' Die Liste unter der Klappliste (220, 10, 180, 28) reicht mit vier
' Eintraegen von y 38 bis 125; der letzte Eintrag liegt bei y 104..125.
' Kurz nach dem Klick ist dort noch nichts, nach der Dauer die Farbe der Liste.
IMPORT "gui"
SCREEN(420, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 420, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 220, 10, 180, 28, ["a", "b", "c", "d"])
GUI_SET_COLOR(dd, "bg", &H0000FF)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
