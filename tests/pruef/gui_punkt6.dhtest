=== fortschritt unbestimmt bild und baum headless
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM p AS GUI_WIDGET : p = GUI_PROGRESS(w, 10, 10, 200, 20)
GUI_PROGRESS_SET(p, "unbestimmt", 1)
DIM b AS IMAGE : b = GENTEX_CHECKED(40, 20, 10, 10, RED, YELLOW)
DIM i AS GUI_WIDGET : i = GUI_IMAGE(w, 10, 40, 100, 60, b)
PRINT GUI_IMAGE_MODE_GET(i)
GUI_IMAGE_MODE(i, "kacheln")
PRINT GUI_IMAGE_MODE_GET(i)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 110, 200, 100)
DIM n AS INTEGER : n = GUI_TREE_ADD(t, -1, "Wurzel")
GUI_TREE_ICON(t, n, b) : GUI_TREE_COLOR(t, n, GREEN)
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT GUI_TO_JSON(w2) = j ; " " ; INSTR(j, "indeterminate") >= 0 ; " " ; INSTR(j, "kacheln") >= 0
TRY
    GUI_IMAGE_MODE(i, "schief")
CATCH e
    PRINT e
END TRY
TRY
    GUI_TREE_ICON(t, 7, b)
CATCH e2
    PRINT e2
END TRY
TRY
    GUI_PROGRESS_SET(p, "farbe", 1)
CATCH e3
    PRINT e3
END TRY
GUI_UPDATE() : GUI_DRAW() : FLIP()
PRINT "gezeichnet"
--- umgebung
DHRT_FRAMES=2
--- erwartet
strecken
kacheln
TRUE TRUE TRUE
GUI_IMAGE_MODE: 'schief' ist kein Modus -- strecken, einpassen, fuellen, mitte oder kacheln
GUI_TREE_ICON: ungueltige Knoten-id 7
GUI_PROGRESS_SET: unbekannter Schluessel 'farbe' -- erwartet unbestimmt
gezeichnet

=== panel rollt und klemmt
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM pn AS GUI_WIDGET : pn = GUI_PANEL(w, 20, 20, 200, 120, "")
DIM k1 AS GUI_WIDGET : k1 = GUI_BUTTON(w, "Oben", 30, 30, 100, 26)
DIM k2 AS GUI_WIDGET : k2 = GUI_BUTTON(w, "Unten", 30, 300, 100, 26)
GUI_PANEL_ADD(pn, k1) : GUI_PANEL_ADD(pn, k2)
GUI_UPDATE()
PRINT GUI_PANEL_SCROLL_GET(pn) ; " " ; GUI_HIT_TEST(40, 40) = k1 ; " " ; GUI_HIT_TEST(40, 310) = k2
GUI_PANEL_SCROLL(pn, 5000)
GUI_UPDATE()
PRINT GUI_PANEL_SCROLL_GET(pn)
PRINT GUI_HIT_TEST(40, 40) = k1 ; " " ; GUI_HIT_TEST(40, 300 + 13 - GUI_PANEL_SCROLL_GET(pn)) = k2
PRINT GUI_GET_Y(k2)
GUI_PANEL_REMOVE(pn, k2)
GUI_UPDATE()
PRINT GUI_PANEL_SCROLL_GET(pn) ; " " ; GUI_HIT_TEST(40, 310) = k2
TRY
    GUI_PANEL_ADD(pn, pn)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
0 TRUE FALSE
192
FALSE TRUE
300
0 TRUE
GUI_PANEL_ADD: ein Panel kann sich nicht selbst aufnehmen

