' ============================================================
'  TIPPSPIEL -- Schnitt durch eine ganze Anwendung
' ============================================================
'  Ein Bundesliga-Tippspiel in Drachenhauch: Spiele aus SQLite,
'  Tipps eingeben und speichern, Ergebnisse eintragen, Punkte
'  rechnen, Rangliste.
'
'  Das ist der senkrechte Schnitt: von der Datenbank bis zum
'  Fenster, jede Schicht einmal -- klein gehalten, aber nichts
'  weggelassen, was eine echte Anwendung braucht.
'
'  Bedienung:
'    * Zeile anklicken   -> Tipp der Zeile kommt in die Felder
'    * Tipp speichern    -> schreibt in die Datenbank (INSERT/UPDATE)
'    * Ergebnis eintragen-> traegt das Ergebnis der gewaehlten Zeile
'                           ein und rechnet die Punkte neu
'    * Rangliste         -> zweiter Reiter
'    [ESC] Ende
'
'  Die Datenbank legt das Programm beim ersten Start selbst an.
' ============================================================
IMPORT "gui"
IMPORT "db"
IMPORT "zeit"
IMPORT "html"
IMPORT "json"

CONST DATEI = "tippspiel.db"

' Getippt wird bis eine Viertelstunde vor Anpfiff.
CONST TIPPSCHLUSS_VOR = 15 * 60
' Woher der Spielplan kommt, wenn man ihn holt.
CONST SPIELPLAN_URL = "https://api.openligadb.de/getmatchdata/bl1/2026/1"

' ---- Punkteregel ---------------------------------------------------------
' Die einzige Stelle, an der die Regel steht. Alles andere fragt hier nach.
'   3 Punkte  exaktes Ergebnis
'   2 Punkte  richtige Tendenz + richtige Tordifferenz
'   1 Punkt   richtige Tendenz
'   0 Punkte  daneben
FUNCTION tendenz(heim AS INTEGER, gast AS INTEGER) AS INTEGER
    IF heim > gast THEN RETURN 1
    IF heim < gast THEN RETURN -1
    RETURN 0
END FUNCTION

FUNCTION punkte(tippH AS INTEGER, tippA AS INTEGER, _
                ergH AS INTEGER, ergA AS INTEGER) AS INTEGER
    IF tippH = ergH AND tippA = ergA THEN RETURN 3
    IF tendenz(tippH, tippA) <> tendenz(ergH, ergA) THEN RETURN 0
    IF (tippH - tippA) = (ergH - ergA) THEN RETURN 2
    RETURN 1
END FUNCTION

' ---- Datenbank -----------------------------------------------------------
DIM db AS DB_CONN

' Gibt es die Spalte schon? PRAGMA table_info listet die Spalten einer
' Tabelle -- die Datenbank weiss selbst am besten, wie sie aussieht.
FUNCTION spalteDa(tabelle AS STRING, spalte AS STRING) AS BOOLEAN
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "PRAGMA table_info(" + tabelle + ")")
    DIM gefunden AS BOOLEAN : gefunden = FALSE
    WHILE DB_NEXT(r)
        IF DB_GET_STRING(r, 1) = spalte THEN gefunden = TRUE
    WEND
    DB_CLOSE_RESULT(r)
    RETURN gefunden
END FUNCTION

SUB anlegen()
    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS spieler (" + _
                "id INTEGER PRIMARY KEY, name TEXT NOT NULL)")
    ' anstoss steht als "JJJJ-MM-TT hh:mm:ss" da: so sortiert SQLite es als
    ' Text richtig, und ZEIT_PARSE macht daraus eine Zahl zum Rechnen.
    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS spiele (" + _
                "id INTEGER PRIMARY KEY, spieltag INTEGER NOT NULL, " + _
                "heim TEXT NOT NULL, gast TEXT NOT NULL, " + _
                "anstoss TEXT, " + _
                "tore_heim INTEGER, tore_gast INTEGER)")
    ' Eine aeltere Datenbank kennt die Spalte noch nicht. Nachruesten statt
    ' neu anfangen -- die Tipps darin sollen erhalten bleiben.
    IF NOT spalteDa("spiele", "anstoss") THEN
        DB_EXEC(db, "ALTER TABLE spiele ADD COLUMN anstoss TEXT")
    END IF
    ' Dieselbe Paarung am selben Spieltag gibt es nur einmal. Als Index,
    ' nicht als Tabellen-Bedingung: so gilt die Regel auch fuer Datenbanken,
    ' die es schon vorher gab.
    DB_EXEC(db, "CREATE UNIQUE INDEX IF NOT EXISTS idx_spiel " + _
                "ON spiele (spieltag, heim, gast)")
    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS tipps (" + _
                "id INTEGER PRIMARY KEY, spieler_id INTEGER NOT NULL, " + _
                "spiel_id INTEGER NOT NULL, tipp_heim INTEGER NOT NULL, " + _
                "tipp_gast INTEGER NOT NULL, punkte INTEGER, " + _
                "UNIQUE(spieler_id, spiel_id))")
END SUB

FUNCTION anzahl(sql AS STRING) AS INTEGER
    DIM r AS DB_RESULT
    r = DB_QUERY(db, sql)
    DIM n AS INTEGER : n = 0
    IF DB_NEXT(r) THEN n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN n
END FUNCTION

SUB grunddaten()
    DB_BEGIN(db)
    IF anzahl("SELECT COUNT(*) FROM spieler") = 0 THEN
        DIM name AS STRING
        FOR EACH name IN ("Anna", "Ben", "Clara")
            DB_EXEC(db, "INSERT INTO spieler (name) VALUES (?)", name)
        NEXT
    END IF

    ' Ein Spieltag der 1. Bundesliga -- Freitagabend, Samstag, Sonntag.
    ' Termin nur eintragen, wo noch keiner steht: ein geholter Spielplan
    ' soll beim naechsten Start nicht wieder ueberschrieben werden.
    terminVorgabe("FC Bayern München", "VfB Stuttgart", "2026-08-28 20:30:00")
    terminVorgabe("Borussia Dortmund", "Hamburger SV", "2026-08-29 15:30:00")
    terminVorgabe("RB Leipzig", "Bor. Mönchengladbach", "2026-08-29 15:30:00")
    terminVorgabe("SC Freiburg", "SV Werder Bremen", "2026-08-29 18:30:00")
    terminVorgabe("1. FC Köln", "TSG Hoffenheim", "2026-08-30 17:30:00")
    DB_COMMIT(db)
END SUB

' Wie spielAnlegen, aber zurueckhaltend: ein vorhandener Termin bleibt
' stehen. COALESCE nimmt den alten Wert, wenn es einen gibt.
SUB terminVorgabe(heim AS STRING, gast AS STRING, anstoss AS STRING)
    DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) " + _
                "VALUES (1, ?, ?, ?) " + _
                "ON CONFLICT(spieltag, heim, gast) DO UPDATE SET " + _
                "  anstoss = COALESCE(spiele.anstoss, excluded.anstoss)", _
            heim, gast, anstoss)
END SUB

' Ein Spiel anlegen oder seinen Anstoss auffrischen. Dieselbe Paarung am
' selben Spieltag gibt es nur einmal (UNIQUE) -- ein zweiter Abruf des
' Spielplans legt also keine Dubletten an.
SUB spielAnlegen(heim AS STRING, gast AS STRING, anstoss AS STRING)
    DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) " + _
                "VALUES (1, ?, ?, ?) " + _
                "ON CONFLICT(spieltag, heim, gast) DO UPDATE SET " + _
                "  anstoss = excluded.anstoss", heim, gast, anstoss)
END SUB

db = DB_OPEN(DATEI)
anlegen()
grunddaten()

