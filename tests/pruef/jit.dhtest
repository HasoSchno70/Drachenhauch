FUNCTION summe(n AS INTEGER, schritt AS INTEGER) AS INTEGER
    DIM s AS INTEGER
    DIM i AS INTEGER
    FOR i = n TO 1 STEP schritt
        s = s + i
    NEXT
    FOR i = 1 TO n
        IF i MOD 3 = 0 OR i = 7 AND NOT (i > 50) THEN s = s + 1
    NEXT
    RETURN s
END FUNCTION
FUNCTION stufe(x AS FLOAT) AS INTEGER
    SELECT CASE x
        CASE IS < 0.0
            RETURN -1
        CASE 0.0 TO 10.0
            RETURN 1
        CASE ELSE
            RETURN 2
    END SELECT
END FUNCTION
FUNCTION wahr(a AS INTEGER, b AS BOOLEAN) AS BOOLEAN
    DIM r AS BOOLEAN
    r = NOT b
    WHILE a > 0
        r = NOT r
        a = a - 1
    WEND
    RETURN r
END FUNCTION
FUNCTION wieder(n AS INTEGER) AS INTEGER
    DIM k AS INTEGER
    REPEAT
        k = k + n
    UNTIL k > 20
    RETURN k
END FUNCTION
