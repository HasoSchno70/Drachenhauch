=== kern: entscheidung, ziehtext, zusammenfuehren, neuigkeiten, einstellungen, ordner
IMPORT "helfer.dh"
' Die Entscheidung an den Raendern
DIM art AS INTEGER, a AS INTEGER, b AS INTEGER
(art, a, b) = kern.ebenenZug(1, 0, -1, 0.0)
PRINT "eine ebene, darunter: "; art; " "; a; " "; b
(art, a, b) = kern.ebenenZug(3, 3, 0, 0.5)
PRINT "quelle ausserhalb: "; art;
(art, a, b) = kern.ebenenZug(3, 0, 3, 0.5)
PRINT " | ziel ausserhalb: "; art;
(art, a, b) = kern.ebenenZug(3, -1, 0, 0.5)
PRINT " | quelle -1: "; art
(art, a, b) = kern.ebenenZug(4, 3, 0, 0.0)
PRINT "unterste nach ganz oben: "; art; " "; a; " -> "; b;
(art, a, b) = kern.ebenenZug(4, 0, -1, 0.0)
PRINT " | oberste nach ganz unten: "; art; " "; a; " -> "; b
' Der Text, mit dem gezogen wird
PRINT kern.ziehText$("garn", 2, 117); " | "; kern.ziehText$("ebene", 1, 0)
DIM w AS STRING, x AS INTEGER, y AS INTEGER
DIM t AS STRING
FOR EACH t IN ["glutfaden:garn:2:117", " glutfaden:ebene:1:0 ", "hallo", "glutfaden:garn:1", "glutfaden:x:1:2", "glutfaden:garn:-1:2", "glutfaden:garn:1:2:3", "file:///c/a.pxs", "glutfaden:garn:1.5:2"]
    (w, x, y) = kern.ziehLesen(t)
    PRINT "'"; t; "' -> '"; w; "' "; x; " "; y
NEXT
' Zusammenfuehren: Rueckgaengig, Wiederholen, was abgelehnt wird
DIM m AS kern.Muster : m = kern.pxsLaden("alle.pxs")
m.stichzahlenNeu()
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM zahlen AS STRING : zahlen = ""
DIM f AS kern.Farbeintrag
FOR EACH f IN m.farben
    zahlen = zahlen + STR$(f.stichzahl) + ","
NEXT
PRINT "vorher: ebenen "; m.ebenen.anzahl(); " aktiv "; m.ebenen.aktiv; " | stiche "; zahlen
PRINT "versteckt auf hintergrund: "; kern.ebenenZusammenfuehren(m, v, 2, 0); " | ebenen "; m.ebenen.anzahl(); " aktiv "; m.ebenen.aktiv; " | unten "; m.ebenen.ebenen[0].stichzahl(); " | '"; v.textZurueck$(); "'"
zahlen = ""
FOR EACH f IN m.farben
    zahlen = zahlen + STR$(f.stichzahl) + ","
NEXT
PRINT "  stiche "; zahlen
PRINT "zurueck: "; v.zurueckNehmen(m); " | ebenen "; m.ebenen.anzahl(); " aktiv "; m.ebenen.aktiv; " | "; m.ebenen.ebenen[0].stichzahl(); " "; m.ebenen.ebenen[2].stichzahl()
PRINT "wieder: "; v.wiederholen(m); " | ebenen "; m.ebenen.anzahl(); " aktiv "; m.ebenen.aktiv; " | "; m.ebenen.ebenen[0].stichzahl()
DIM schritte AS INTEGER : schritte = LEN(v.rueck)
PRINT "dieselbe: "; kern.ebenenZusammenfuehren(m, v, 1, 1); " | ausserhalb: "; kern.ebenenZusammenfuehren(m, v, 0, 5); " | schritte gleich "; LEN(v.rueck) = schritte
m.ebenen.ebenen[1].gesperrt = TRUE
PRINT "gesperrtes ziel: "; kern.ebenenZusammenfuehren(m, v, 0, 1); " | gesperrte quelle: "; kern.ebenenZusammenfuehren(m, v, 1, 0)
m.ebenen.ebenen[1].gesperrt = FALSE
PRINT "aktiv bleibt dieselbe: aktiv "; m.ebenen.aktiv; " '"; m.ebenen.aktiveEbene().name; "' -> ";
DIM ok AS BOOLEAN : ok = kern.ebenenZusammenfuehren(m, v, 1, 0)
PRINT m.ebenen.aktiv; " '"; m.ebenen.aktiveEbene().name; "' | nur noch eine: "; kern.ebenenZusammenfuehren(m, v, 0, 0)
' Neu in Glutfaden
DIM ti AS ARRAY OF STRING, te AS ARRAY OF STRING
(ti, te) = kern.neuigkeitenLesen("neu.txt")
PRINT "neuigkeiten: "; LEN(ti); " | "; JOIN$(ti, " / ")
DIM k AS INTEGER
FOR k = 0 TO LEN(te) - 1
    PRINT "  "; k; ": "; REPLACE$(te[k], CHR$(10), "|")
NEXT
(ti, te) = kern.neuigkeitenLesen("gibtsnicht.txt")
PRINT "ohne datei: "; LEN(ti); " "; LEN(te)
(ti, te) = kern.neuigkeitenLesen(GLUTORDNER + "/daten/neuigkeiten.txt")
PRINT "die echte: oben '"; ti[0]; "' | jeder abschnitt hat text "; ARRAY_INDEXOF(te, "") < 0
' Die neuen Einstellungen
DIM es AS kern.Einstellungen : es = NEW kern.Einstellungen()
PRINT "vorgaben: "; es.ameisen; " "; es.stoffTextur; " "; es.stickzeit; " "; es.hervorheben; " '"; es.bibliothekPfad; "' '"; es.vorlagenPfad; "'"
es.ameisen = FALSE : es.stoffTextur = FALSE : es.stickzeit = FALSE : es.hervorheben = TRUE
es.bibliothekPfad = "C:/Muster/Bib" : es.vorlagenPfad = "/home/x/vorlagen"
WRITEALL("es.json", kern.einstellungenJson$(es))
DIM z AS STRING
FOR EACH z IN READLINES("es.json")
    IF INSTR(z, "marching") >= 0 OR INSTR(z, "fabric") >= 0 OR INSTR(z, "stitch_timer") >= 0 OR INSTR(z, "highlight") >= 0 OR INSTR(z, "library_path") >= 0 OR INSTR(z, "templates_path") >= 0 THEN PRINT TRIM$(z)
NEXT
DIM g AS kern.Einstellungen : g = kern.einstellungenLaden("es.json")
PRINT "gelesen: "; g.ameisen; " "; g.stoffTextur; " "; g.stickzeit; " "; g.hervorheben; " '"; g.bibliothekPfad; "' '"; g.vorlagenPfad; "'"
WRITEALL("krumm.json", "{" + CHR$(34) + "marching_ants" + CHR$(34) + ": 1, " + CHR$(34) + "fabric_texture" + CHR$(34) + ": " + CHR$(34) + "nein" + CHR$(34) + ", " + CHR$(34) + "library_path" + CHR$(34) + ": 5, " + CHR$(34) + "templates_path" + CHR$(34) + ": " + CHR$(34) + "  /da  " + CHR$(34) + "}")
g = kern.einstellungenLaden("krumm.json")
PRINT "krumm: "; g.ameisen; " "; g.stoffTextur; " '"; g.bibliothekPfad; "' '"; g.vorlagenPfad; "'"
' Eingestellte Ordner: leer, angelegt, schon da, eine Datei
WRITEALL("eine datei", "x")
MKDIR("schon da")
PRINT "ordner: '"; kern.eigenerOrdner$("", "vorgabe"); "' '"; kern.eigenerOrdner$("   ", "vorgabe"); "' '"; kern.eigenerOrdner$("schon da", "vorgabe"); "' '"; kern.eigenerOrdner$(" neu/tief ", "vorgabe"); "' angelegt "; DIREXISTS("neu/tief"); " '"; kern.eigenerOrdner$("eine datei", "vorgabe"); "'"
PRINT "bibliothek: "; BASENAME(kern.bibliothekOrdner$()); " | "; kern.bibliothekOrdner$("schon da"); " | "; BASENAME(kern.bibliothekOrdner$("eine datei"))
