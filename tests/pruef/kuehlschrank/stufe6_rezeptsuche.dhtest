=== spaete antwort gehoert zu ihrem rezept, nicht zum gewaehlten
' Zwei Rezepte nacheinander gewaehlt, die Antwort des ersten kommt zuletzt:
' die Python-App zeigte sie unter dem zweiten und importierte sie auch so.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
DIM srv AS INTEGER : srv = kNetzStarten(ARG$(2))
kSchluessel = "testschluessel"
PRINT "code "; kProbe(p, "probe.dh", "", 1500)
kOffEnde(srv)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
{sammlung}/../_hilfen/spoon_server.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM kf AS KatalogFenster : kf = NEW KatalogFenster()
kf.Zeigen()
GUI_SET_CHECKED(kf.uebersetzenSchalter, FALSE)
GUI_SET_TEXT(kf.sucheFeld, "chicken")
kf.knopfSuchen_Klick()
DIM n AS INTEGER
WHILE kf.sucheAbruf >= 0 AND n < 900 AND studioBild()
    n = n + 1
WEND
PRINT "treffer "; LEN(kf.treffer); " | gewaehlt "; GUI_TABLE_SELECTED(kf.tabelle)
' Erst das erste waehlen, dann das zweite -- beide Antworten abwarten, ohne
' den Takt des Fensters, und die erste zuletzt einsortieren.
GUI_TABLE_SET_SELECTED(kf.tabelle, 0)
kf.tabelle_Geaendert()
GUI_TABLE_SET_SELECTED(kf.tabelle, 1)
kf.tabelle_Geaendert()
' Noch einmal dasselbe: es bleibt bei einem Abruf je Rezept.
kf.tabelle_Geaendert()
PRINT "unterwegs "; LEN(kf.detailAbrufe)
n = 0
WHILE NOT (HTTP_READY(kf.detailAbrufe[0]) AND HTTP_READY(kf.detailAbrufe[1])) AND n < 3000
    SLEEP(5)
    n = n + 1
WEND
DIM a AS INTEGER : a = kf.detailAbrufe[0]
DIM x AS Rezept : x = kf.detailRezepte[0]
kf.detailAbrufe[0] = kf.detailAbrufe[1] : kf.detailRezepte[0] = kf.detailRezepte[1]
kf.detailAbrufe[1] = a : kf.detailRezepte[1] = x
kf.Takt()
PRINT "gewaehlt "; GUI_TABLE_SELECTED(kf.tabelle); " | "; REPLACE$(GUI_TEXT(kf.details), CHR$(10), " / ")
PRINT "erstes "; kf.treffer[0].name; " "; LEN(kf.treffer[0].zutaten); " | zweites "; kf.treffer[1].name; " "; LEN(kf.treffer[1].zutaten)
kf.knopfImport_Klick()
PRINT "importiert "; JOIN$(textListe("SELECT name || ' ' || servings FROM recipes WHERE id = (SELECT MAX(id) FROM recipes)"), "")
END
--- erwartet
