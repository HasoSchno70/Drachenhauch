=== vielecke und gestrichelte linie
' NGON mit 6 Ecken und Winkel 0: eine Ecke rechts, die Oberkante flach bei
' y = 220 - 50 * sin(60) = 176.7. Das Fuenfeck mit Winkel 90 zeigt nach
' unten, seine Oberkante liegt bei y = 180. Strich 10, Luecke 6 ab x = 280.
SCREEN(640, 360, "t")
WHILE NOT QUITREQUESTED()
    CLS(RGB(20, 20, 30))
    NGON(70, 220, 6, 50, 0, RGB(180, 80, 220))
    NGONOUTLINE(200, 220, 5, 50, 90, WHITE, 3)
    LINEDASHED(280, 300, 620, 300, 10, 6, WHITE)
    FLIP()
WEND
--- bild
110 220 #B450DC +-20
70 182 #B450DC +-20
70 172 #14141E +-12
200 220 #14141E +-12
200 180 #FFFFFF +-80
284 300 #FFFFFF +-40
293 300 #14141E +-12
300 300 #FFFFFF +-40

=== neun teile: ecken und raender in ihrer groesse
' Vorlage 24x24: roter Rand 6, blaue Mitte, gelbe Ecke oben links (0..5).
' Gestreckt auf 300x120 bleibt der Rand 6 breit und die Ecke 6x6 -- ein
' gewoehnlich gestrecktes Bild haette einen 75 breiten Rand.
IMPORT "imgfx"
SCREEN(640, 360, "t")
DIM v AS IMAGE : v = IMAGE_NEW(24, 24, RGB(200, 40, 40))
IMAGE_FILL_RECT(v, 6, 6, 17, 17, RGB(40, 80, 200))
IMAGE_FILL_RECT(v, 0, 0, 5, 5, RGB(250, 220, 40))
WHILE NOT QUITREQUESTED()
    CLS(RGB(20, 20, 30))
    DRAWIMAGE9(v, 300, 200, 300, 120, 6, 6, 6, 6)
    FLIP()
WEND
--- bild
450 260 #2850C8 +-20
303 260 #C82828 +-20
309 260 #2850C8 +-20
596 260 #C82828 +-20
590 260 #2850C8 +-20
450 202 #C82828 +-20
450 317 #C82828 +-20
