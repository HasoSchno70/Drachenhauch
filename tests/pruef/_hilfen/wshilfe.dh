' Helfer fuer tests/pruef/websocket.dhtest: den Port eines gestarteten
' Servers lesen (er meldet "PORT=n" auf stderr) und auf eine Antwort warten.

FUNCTION portVon(whP AS INTEGER) AS INTEGER
    DIM whT AS INTEGER : whT = MILLIS()
    DIM whZ AS STRING : whZ = ""
    WHILE MILLIS() - whT < 10000
        whZ = whZ + PROCESS_ERR$(whP)
        IF INSTR(whZ, "PORT=") >= 0 THEN RETURN INT(VAL(MID$(whZ, INSTR(whZ, "PORT=") + 5)))
        SLEEP(10)
    WEND
    RETURN -1
END FUNCTION

FUNCTION antwort$(whW AS WEBSOCKET) AS STRING
    DIM whT AS INTEGER : whT = MILLIS()
    WHILE MILLIS() - whT < 5000
        IF WS_NEXT(whW) THEN RETURN WS_MESSAGE$(whW)
        SLEEP(5)
    WEND
    RETURN "(keine Antwort)"
END FUNCTION
