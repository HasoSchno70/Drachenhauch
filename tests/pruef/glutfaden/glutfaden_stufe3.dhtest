' Glutfaden Stufe 3, Formen und Auswahl Punkt fuer Punkt gegen PySticky: die
' Erwartung ist die Ausgabe der Original-Algorithmen (PolygonTool.
' _get_polygon_points, LassoSelectTool._fill_lasso_polygon, MirrorMixin.
' get_mirrored_positions), einmal mit PySticky aufgezeichnet. Je Zeile: Zahl
' der Zellen, dann jede als (x+1000)*10000 + (y+1000), sortiert.

=== vieleck lasso und spiegel wie in pysticky
IMPORT "k.dh"
DIM i AS INTEGER, x AS INTEGER, y AS INTEGER
zeile("vieleck 0 2,2 12,4 6,11", kern.vieleck([2, 2, 12, 4, 6, 11], FALSE, 16, 14))
zeile("vieleck 0 0,0 9,0 9,6 5,3 0,6", kern.vieleck([0, 0, 9, 0, 9, 6, 5, 3, 0, 6], FALSE, 16, 14))
zeile("vieleck 0 3,1 14,9 1,12 10,2", kern.vieleck([3, 1, 14, 9, 1, 12, 10, 2], FALSE, 16, 14))
zeile("vieleck 0 1,1 6,1 6,6 1,6", kern.vieleck([1, 1, 6, 1, 6, 6, 1, 6], FALSE, 16, 14))
zeile("vieleck 0 -3,2 8,-2 5,9", kern.vieleck([-3, 2, 8, -2, 5, 9], FALSE, 16, 14))
zeile("vieleck 1 2,2 12,4 6,11", kern.vieleck([2, 2, 12, 4, 6, 11], TRUE, 16, 14))
