' Die Vorgabe der Kuerzel: was die Befehle bis hierher bekommen haben
' (Plugins melden ihre spaeter an und haben ihre eigene).
DIM bkv AS INTEGER
FOR bkv = 0 TO LEN(befehle) - 1
    befehle[bkv].vorgabe = befehle[bkv].kuerzel
NEXT
