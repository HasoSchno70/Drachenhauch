{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameBasic",
  "scopeName": "source.gamebasic",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gamebasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.gamebasic",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.gamebasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gamebasic",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "constant.numeric.gamebasic",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.gamebasic",
          "match": "(?i)\\b(FALSE|TRUE)\\b"
        },
        {
          "name": "storage.type.gamebasic",
          "match": "(?i)\\b(COROUTINE|INTEGER|BOOLEAN|FUNCREF|STRING|FLOAT|IMAGE|ARRAY|TUPLE|SOUND|FILE|MAP|OF)\\b"
        },
        {
          "name": "keyword.declaration.gamebasic",
          "match": "(?i)\\b(FUNCTION|OPERATOR|PROPERTY|EXTENDS|IMPORT|STRUCT|STATIC|CONST|BYREF|CLASS|ENUM|SUB|DIM|AS)\\b"
        },
        {
          "name": "keyword.control.gamebasic",
          "match": "(?i)\\b(CONTINUE|RESTORE|ELSEIF|RETURN|SELECT|REPEAT|WHILE|UNTIL|THROW|CATCH|WHERE|YIELD|INPUT|BREAK|PRINT|CASE|WEND|BXOR|NEXT|READ|THEN|ELIF|WITH|DATA|STEP|BNOT|ELSE|BAND|BOR|AND|NEW|NOT|TRY|SHR|FOR|MOD|SHL|END|TO|IF|IS|OR|IN)\\b"
        },
        {
          "name": "support.function.dollar.gamebasic",
          "match": "(?i)\\b(REPLACE|READALL|FORMAT|REPEAT|RIGHT|SPACE|INKEY|UPPER|LOWER|SPLIT|PADL|TIME|PADR|DATE|JOIN|LEFT|TRIM|STR|MID|CHR|HEX)\\$"
        },
        {
          "name": "support.function.gamebasic",
          "match": "(?i)\\b(AUDIO_MUSIC_GET_VOLUME|AUDIO_SET_NUM_CHANNELS|AUDIO_MUSIC_POSITION|AUDIO_BUSY_CHANNELS|NET_UDP_SET_TIMEOUT|CURVE_SMOOTHERSTEP|NET_CLOSE_LISTENER|AUDIO_NUM_CHANNELS|AUDIO_MUSIC_RESUME|RENDERTARGET_BEGIN|ATLAS_DRAW_FLIPPED|AUDIO_MUSIC_VOLUME|NET_UDP_LAST_FROM|ECS_GET_OR_STRING|AUDIO_MUSIC_PAUSE|RENDERTARGET_DRAW|__DICT_FROM_PAIRS|AUDIO_MUSIC_QUEUE|AUDIO_MUSIC_STOP|AUDIO_GET_VOLUME|RENDERTARGET_NEW|AUDIO_IS_PLAYING|RENDERTARGET_END|DRAWIMAGEFLIPPED|AUDIO_MUSIC_PLAY|ECS_GET_OR_FLOAT|CURVE_SMOOTHSTEP|AUDIO_RESUME_ALL|AUDIO_MUSIC_LOAD|AUDIO_MUSIC_BUSY|NET_SET_TIMEOUT|ECS_GET_OR_BOOL|TRIANGLEOUTLINE|GENTEX_GRADIENT|AUDIO_PAUSE_ALL|ARRAY_REMOVE_AT|NET_TCP_CONNECT|JOYSTICK_BUTTON|ECS_GET_STRING|SET_FULLSCREEN|JOYSTICK_COUNT|ELLIPSEOUTLINE|NET_TCP_LISTEN|ECS_GET_OR_INT|JOYSTICK_HAT_X|JOYSTICK_HAT_Y|POLYGONOUTLINE|ECS_ADD_STRING|SAVESCREENSHOT|GENTEX_CHECKED|AUDIO_STOP_ALL|SETWINDOWTITLE|NET_TCP_ACCEPT|ECS_NEW_ENTITY|CURVE_CATMULL2|ECS_NEW_WORLD|NET_PEER_PORT|JOYSTICK_AXIS|FILES_DROPPED|CURVE_HERMITE|CLIPBOARD_GET|GENTEX_PERLIN|JOYSTICK_NAME|ARRAY_INDEXOF|CURVE_BEZIER2|CURVE_CATMULL|ECS_ADD_FLOAT|DRAWIMAGEPART|ECS_GET_FLOAT|CLIPBOARD_SET|NET_PEER_ADDR|NET_UDP_CLOSE|QUITREQUESTED|LAYER_DEFINE|ECS_ADD_BOOL|NET_UDP_OPEN|NET_UDP_BIND|SCREENHEIGHT|AUDIO_RESUME|AUDIO_VOLUME|GENTEX_COLOR|NET_UDP_SEND|NET_UDP_RECV|CURVE_BEZIER|ARRAY_INSERT|TEXT_SPACING|FILE_DROPPED|ECS_GET_BOOL|ECS_ADD_OBJ|LAYER_CLEAR|TEXT_ITALIC|ECS_ADD_INT|AUDIO_PAUSE|DRAWTILEMAP|ECS_GET_INT|IMAGEHEIGHT|CORO_RESULT|AUDIO_NOISE|__COMP_ITER|LOAD_ASSETS|SCREENWIDTH|SHADER_SET3|ECS_DESTROY|SHADER_SET2|__SET_DEDUP|TEXT_HEIGHT|MOUSEBUTTON|SHADER_LOAD|CORO_RESUME|BATCH_FLUSH|ATLAS_LOAD|ARRAY_COPY|COLOR_LERP|BATCH_DRAW|TEXT_WIDTH|AUDIO_PLAY|AUDIO_TONE|AUDIO_INIT|ECS_REMOVE|ATLAS_DRAW|CURVE_LERP|ECS_QUERY2|SHADER_SET|ARRAY_PUSH|AUDIO_STOP|FILEEXISTS|BLEND_MODE|MOUSEWHEEL|IMAGEWIDTH|ECS_QUERY3|KEYPRESSED|ARRAY_FILL|CORO_CLOSE|TEXT_SIZE|CLOSEFILE|WRITELINE|LOADIMAGE|ECS_COUNT|STOPSOUND|DRAWIMAGE|STOPMUSIC|ARRAY_AVG|CORO_DONE|LOADSOUND|PLAYMUSIC|NET_CLOSE|ARRAY_SUM|AUDIO_PAN|MAPREMOVE|ECS_ALIVE|ENDOFFILE|ARRAY_MAX|MAPVALUES|RANDOMIZE|GRADIENTH|TEXT_BOLD|CORO_SEND|ARRAY_POP|PLAYSOUND|LAYER_END|GRADIENTV|RECTROUND|ECS_QUERY|ARRAY_MIN|NET_SEND|MAPGETOR|COLLIDES|MAPCLEAR|NET_RECV|DIMCOUNT|BOXROUND|OPENFILE|LOADFONT|MAPITEMS|READLINE|TRIANGLE|POLYGON|ECS_HAS|DIMSIZE|SETFONT|ECS_GET|READALL|MAPKEYS|ELLIPSE|WAITKEY|SHUFFLE|CIRCLES|REPLACE|RANDINT|MAPSIZE|REVERSE|SCREEN|MOUSEY|SETFPS|MILLIS|MAPHAS|CIRCLE|CHOICE|IS_NIL|SCROLL|MAPPUT|POSTFX|MAPGET|MOUSEX|SPLINE|RIGHT|BOXES|UPPER|LINEW|PLOTS|LAYER|SLEEP|RANGE|REMAP|DELTA|LINES|WRITE|HYPOT|CLAMP|RANDF|GREEN|SPLIT|REDIM|SPACE|TIMER|LOWER|FLOOR|ROUND|ATAN2|INSTR|TEXT|BLUE|DATE|JOIN|ACOS|RECT|PADL|LERP|PADR|PLOT|FLIP|FRAC|LEFT|LINE|SIGN|TIME|ATAN|CEIL|SORT|TRIM|ASIN|SIN|CLS|RND|ARC|EXP|RGB|FPS|MAX|HSV|MIN|LEN|POW|HEX|ABS|STR|COS|MID|TAN|ASC|RAD|RED|INT|SQR|DEG|CHR|VAL|LOG|BOX)\\b"
        },
        {
          "name": "constant.language.gamebasic",
          "match": "(?i)\\b(JOY_BUTTON_RSTICK|JOY_BUTTON_LSTICK|JOY_BUTTON_START|JOY_BUTTON_BACK|JOY_DPAD_RIGHT|JOY_DPAD_LEFT|JOY_BUTTON_LB|JOY_BUTTON_RB|JOY_DPAD_DOWN|KEY_BACKSPACE|JOY_BUTTON_B|JOY_BUTTON_A|JOY_BUTTON_X|JOY_BUTTON_Y|JOY_DPAD_UP|KEY_ESCAPE|KEY_RETURN|KEY_SPACE|KEY_RIGHT|LIGHTGRAY|KEY_ENTER|DARKGREEN|DARKBLUE|KEY_DOWN|DARKGRAY|KEY_LEFT|KEY_TAB|KEY_F12|DARKRED|KEY_F10|MAGENTA|KEY_F11|KEY_F2|KEY_F9|KEY_F7|KEY_F8|ORANGE|KEY_UP|PURPLE|KEY_F3|KEY_F5|KEY_F6|YELLOW|KEY_F4|KEY_F1|BROWN|KEY_8|KEY_X|KEY_I|KEY_2|KEY_H|KEY_G|BLACK|KEY_A|KEY_J|KEY_Z|KEY_3|KEY_6|KEY_O|KEY_1|KEY_P|KEY_V|KEY_C|KEY_Q|KEY_D|KEY_0|KEY_R|KEY_Y|KEY_F|KEY_U|GREEN|KEY_E|KEY_7|KEY_9|KEY_W|KEY_5|WHITE|KEY_K|KEY_B|KEY_N|KEY_L|KEY_T|KEY_M|KEY_4|KEY_S|CYAN|BLUE|GRAY|PINK|RED|PI)\\b"
        },
        {
          "name": "keyword.operator.gamebasic",
          "match": "<=|>=|<>|[-+*/\\\\=<>^]"
        }
      ]
    }
  }
}
