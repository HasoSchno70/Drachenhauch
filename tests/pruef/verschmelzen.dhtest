    END TRY
    c = a * b
    PRINT c
    c = a + b
END SUB
lauf()
--- umgebung
DHRT_OHNE_VERSCHMELZEN=1
--- erwartet
gefangen: Ganzzahl-Ueberlauf bei '+' (INTEGER ist 64-bit; Wertebereich ueberschritten)
9223372036854775807
