' ============================================================
'  Drachenhauch Studio -- die Entwurfsflaeche
' ============================================================
'  Das Fenster, das man entwirft, ist ein echtes GUI_WINDOW im Entwurfsmodus
'  (GUI_WINDOW_DESIGN): die Laufzeit zeichnet die Controls genau so, wie das
'  Programm sie spaeter bekommt, nimmt ihnen aber die Eingabe. Die Maus
'  gehoert dem Studio. Gezeichnet wird darum herum: ein Fensterrahmen mit
'  Titelleiste und Schatten, die Auswahl mit acht Griffen, der Rahmen beim
'  Aufziehen und die Ausrichtungslinien, die beim Ziehen an Kanten und
'  Mitten der Nachbarn und an die Raender des Fensters einrasten.
'
'  Lagen: im Modell stehen Fensterkoordinaten (ab der linken oberen Ecke des
'  Inhalts, unvergroessert). Auf dem Schirm liegt der Inhalt bei formX/formY
'  und ist um zoomF vergroessert: zS rechnet hin, zF zurueck.
' ============================================================

CONST TITEL_H = 30              ' Hoehe der gezeichneten Titelleiste
CONST RAND_FENSTER = 20         ' der Abstand zum Fensterrand, den Xojo vorschlaegt
CONST ABSTAND_NACHBAR = 12      ' der Abstand zwischen zwei Controls
CONST FANG = 6                  ' wie nah (in Fensterpunkten) eine Linie einrastet
CONST F_LINIE = &HE0409A        ' Ausrichtungslinien
CONST F_AUSWAHL = &H3AA8F0
CONST F_GRIFF_RAND = &H1C6FB0

DIM frm AS GUI_WINDOW : frm = -1
DIM formX AS INTEGER : formX = 400
DIM formY AS INTEGER : formY = 120
DIM zoomF AS FLOAT : zoomF = 1.0
DIM rasterAn AS BOOLEAN : rasterAn = TRUE
DIM linienAn AS BOOLEAN : linienAn = TRUE

' Mittelbereich auf dem Schirm (vom Dock, oberflaeche.dh setzt ihn).
DIM mitteX AS INTEGER
DIM mitteY AS INTEGER
DIM mitteB AS INTEGER
DIM mitteH AS INTEGER

' Zug
DIM modus AS INTEGER : modus = 0      ' 1 ziehen, 2 Griff, 3 Rahmen, 4 Fenstergroesse
DIM fensterGriff AS INTEGER : fensterGriff = 0   ' 1 rechts, 2 unten, 3 Ecke
DIM griff AS INTEGER : griff = -1
DIM startMx AS INTEGER
DIM startMy AS INTEGER
DIM startX AS INTEGER
DIM startY AS INTEGER
DIM startW AS INTEGER
DIM startH AS INTEGER
DIM zugX AS ARRAY OF INTEGER : zugX = []
DIM zugY AS ARRAY OF INTEGER : zugY = []
DIM zugW AS ARRAY OF INTEGER : zugW = []        ' Groesse je gezogenem Control (fuer den Umriss)
DIM zugH AS ARRAY OF INTEGER : zugH = []
DIM bewegt AS BOOLEAN : bewegt = FALSE
DIM rahmenDazu AS BOOLEAN : rahmenDazu = FALSE
DIM mausFx AS INTEGER                 ' Maus in Fensterlage, je Bild
DIM mausFy AS INTEGER

' Ausrichtungslinien des laufenden Zugs (Fensterlage)
DIM linX1 AS ARRAY OF INTEGER : linX1 = []
DIM linY1 AS ARRAY OF INTEGER : linY1 = []
DIM linX2 AS ARRAY OF INTEGER : linX2 = []
DIM linY2 AS ARRAY OF INTEGER : linY2 = []

' Layout-Behaelter (modell.dh): je Widget das Layout, in dem es steht --
' gerechnet bei jedem Neuaufbau, damit die Maus nicht je Bild suchen muss.
DIM elternCache AS ARRAY OF INTEGER : elternCache = []
' Ziel eines Zugs oder Ablegens: das Layout, die Stelle in seiner Liste und
' die Marke, die zeigt, wo das Control landet (Fensterlage).
DIM zielL AS INTEGER : zielL = -1
DIM zielPos AS INTEGER : zielPos = 0
DIM markeX AS INTEGER
DIM markeY AS INTEGER
DIM markeB AS INTEGER
DIM markeH AS INTEGER
' Ein Kind eines Layouts wird nicht verschoben, sondern umgesetzt: es bleibt
' stehen, ein Umriss folgt der Maus.
DIM kindZug AS BOOLEAN : kindZug = FALSE
' Nach einer Aenderung die Lagen der Controls ins Protokoll -- erst nach dem
' naechsten GUI_UPDATE, vorher hat die Laufzeit die Kinder noch nicht gelegt.
DIM controlsNachBild AS INTEGER : controlsNachBild = 0
CONST F_BEHAELTER = &H8C7BD8

FUNCTION zS(v AS INTEGER) AS INTEGER
    RETURN INT(v * zoomF + 0.5)
END FUNCTION

FUNCTION zF(v AS INTEGER) AS INTEGER
    IF v >= 0 THEN RETURN INT(v / zoomF)
    RETURN -INT(-v / zoomF)
END FUNCTION

FUNCTION fensterB() AS INTEGER
    RETURN MAX(40, fensterZahl("w"))
END FUNCTION

FUNCTION fensterH() AS INTEGER
    RETURN MAX(40, fensterZahl("h"))
END FUNCTION

' Ueber dem Inhalt (formY): die gezeichnete Titelleiste und, wenn das Fenster
' Menues hat, die Menueleiste der gui (Schirmpunkte).
FUNCTION kopfH() AS INTEGER
    RETURN TITEL_H + zS(menueLeisteH(doc))
END FUNCTION

' --- Lage und Neuaufbau --------------------------------------------------------
' Das Fenster mittig in den Mittelbereich, mit Platz fuer die Titelleiste.
SUB entwurfLegen()
    DIM b AS INTEGER : b = zS(fensterB())
    DIM h AS INTEGER : h = zS(fensterH())
    formX = mitteX + MAX(32, (mitteB - b) \ 2)
    formY = mitteY + MAX(32 + kopfH(), (mitteH - h - kopfH()) \ 2 + kopfH())
    ' formY ist die Oberkante des Inhalts -- das Fenster der gui beginnt
    ' mit seiner Menueleiste darueber.
    IF frm >= 0 THEN
        GUI_WINDOW_SET_BOUNDS(frm, formX, formY - zS(menueLeisteH(doc)), fensterB(), fensterH() + menueLeisteH(doc))
        ' Ein Fenster, groesser als die Mitte, bleibt in ihr -- es laege
        ' sonst ueber Inspektor und Ausgabe (gefunden mit der Kuehlschrank-App).
        GUI_WINDOW_CLIP(frm, mitteX, mitteY, mitteB, mitteH)
    END IF
END SUB

SUB entwurfBauen()
    ' Ein neues Fenster nimmt den Fokus -- und Kuerzel gelten im Fenster mit
    ' Fokus. Also merken und zurueckgeben.
    DIM fokus AS GUI_WIDGET : fokus = GUI_FOCUSED()
    elternCache = elternAus(doc)
    IF frm >= 0 THEN GUI_WINDOW_DESTROY(frm)
    ' Eigene Controls ausgeklappt: ihre Teile stehen hinter den Controls des
    ' Fensters, die Nummern bis anzahl() bleiben die des Modells.
    DIM bau AS JSON_HANDLE : bau = ausgeklappt(doc)
    IF menueLeisteH(doc) > 0 THEN JSON_SET_INT(bau, "h", fensterH() + menueLeisteH(doc))
    frm = GUI_FROM_JSON(JSON_STRINGIFY(bau))
    ' Eine eigene Kopie der Zuordnung -- das Pruefen klappt beim Erzeugen
    ' ebenfalls aus und ueberschriebe sonst die des Entwurfs.
    vkFensterN = akFensterN : vkInstanz = akInstanz : vkErster = akErster : vkAnzahl = akAnzahl
    vkWurzel = akWurzel : vkName = akName
    vkB = akB : vkH = akH : vkTeilInst = akTeilInst : vkTeilFrei = akTeilFrei
    vkTeilX = akTeilX : vkTeilY = akTeilY : vkTeilW = akTeilW : vkTeilH = akTeilH : vkTeilAnker = akTeilAnker
    vorschauWar = []
    GUI_WINDOW_DESIGN(frm, TRUE)
    GUI_WINDOW_CHROME(frm, FALSE)
    GUI_WINDOW_MOVABLE(frm, FALSE)
    GUI_WINDOW_RESIZABLE(frm, FALSE)
    GUI_WINDOW_ZOOM(frm, zoomF)
    entwurfBilder()
    entwurfLegen()
    ' Zu sehen nur, solange sein Reiter vorn ist.
    GUI_WINDOW_VISIBLE(frm, layoutVorn())
    IF fokus >= 0 THEN GUI_FOCUS(fokus) ELSE GUI_FOCUS(-1)
END SUB

' Nach jeder Aenderung am Modell: neu bauen, Navigator und Inspektor nach.
SUB nachAenderung(festhalten AS BOOLEAN)
    entwurfBauen()
    IF festhalten THEN merken()
    behaelterProtokollieren()
    controlsNachBild = 2
    navigatorFuellen()
    inspektorFuellen()
    werkzeugeNachziehen()
END SUB

FUNCTION indexVonHandle(h AS GUI_WIDGET) AS INTEGER
    IF h < 0 OR frm < 0 THEN RETURN -1
    DIM i AS INTEGER
    FOR i = 0 TO GUI_WINDOW_WIDGET_COUNT(frm) - 1
        IF GUI_WINDOW_WIDGET(frm, i) = h THEN
            ' Ein Teil eines eigenen Controls meint seine Instanz im Fenster --
            ' auch der Teil eines Controls im Control.
            IF i >= vkFensterN AND i - vkFensterN < LEN(vkTeilInst) THEN RETURN vkWurzel[vkTeilInst[i - vkFensterN]]
            RETURN i
        END IF
    NEXT
    RETURN -1
END FUNCTION

' Je Bild: die Teile jeder Instanz dorthin, wo ihr Behaelter gerade liegt --
' beim Ziehen, beim Groesserziehen und wenn ein Layout ihn legt.
DIM vorschauWar AS ARRAY OF STRING : vorschauWar = []
DIM vkFensterN AS INTEGER : vkFensterN = 0
DIM vkInstanz AS ARRAY OF INTEGER : vkInstanz = []
DIM vkWurzel AS ARRAY OF INTEGER : vkWurzel = []
DIM vkName AS ARRAY OF STRING : vkName = []
DIM vkErster AS ARRAY OF INTEGER : vkErster = []
DIM vkAnzahl AS ARRAY OF INTEGER : vkAnzahl = []
DIM vkB AS ARRAY OF INTEGER : vkB = []
DIM vkH AS ARRAY OF INTEGER : vkH = []
DIM vkTeilInst AS ARRAY OF INTEGER : vkTeilInst = []
DIM vkTeilFrei AS ARRAY OF BOOLEAN : vkTeilFrei = []
DIM vkTeilX AS ARRAY OF INTEGER : vkTeilX = []
DIM vkTeilY AS ARRAY OF INTEGER : vkTeilY = []
DIM vkTeilW AS ARRAY OF INTEGER : vkTeilW = []
DIM vkTeilH AS ARRAY OF INTEGER : vkTeilH = []
DIM vkTeilAnker AS ARRAY OF STRING : vkTeilAnker = []
SUB vorschauLegen()
    IF frm < 0 THEN RETURN
    WHILE LEN(vorschauWar) < LEN(vkInstanz)
        ARRAY_PUSH(vorschauWar, "")
    WEND
    DIM s AS INTEGER
    FOR s = 0 TO LEN(vkInstanz) - 1
        IF vkAnzahl[s] = 0 THEN CONTINUE
        DIM h AS GUI_WIDGET : h = GUI_WINDOW_WIDGET(frm, vkInstanz[s])
        DIM hx AS INTEGER : hx = GUI_GET_X(h)
        DIM hy AS INTEGER : hy = GUI_GET_Y(h)
        DIM hb AS INTEGER : hb = GUI_GET_W(h)
        DIM hh AS INTEGER : hh = GUI_GET_H(h)
        DIM schl AS STRING : schl = STR$(hx) + "," + STR$(hy) + "," + STR$(hb) + "," + STR$(hh)
        IF schl = vorschauWar[s] THEN CONTINUE
        vorschauWar[s] = schl
        DIM t AS INTEGER
        FOR t = vkErster[s] - vkFensterN TO vkErster[s] - vkFensterN + vkAnzahl[s] - 1
            IF NOT vkTeilFrei[t] THEN CONTINUE
            DIM a AS STRING : a = LOWER$(vkTeilAnker[t])
            DIM x AS INTEGER
            DIM w AS INTEGER
            DIM y AS INTEGER
            DIM hoehe AS INTEGER
            (x, w) = teilLage(vkTeilX[t], vkTeilW[t], INSTR(a, "l") >= 0, INSTR(a, "r") >= 0, hb - vkB[s])
            (y, hoehe) = teilLage(vkTeilY[t], vkTeilH[t], INSTR(a, "t") >= 0, INSTR(a, "b") >= 0, hh - vkH[s])
            GUI_SET_BOUNDS(GUI_WINDOW_WIDGET(frm, vkFensterN + t), hx + x, hy + y, w, hoehe)
        NEXT
    NEXT
END SUB

' --- Layout-Behaelter im Entwurf ----------------------------------------------
FUNCTION verwaltet(i AS INTEGER) AS BOOLEAN
    IF i < 0 OR i >= LEN(elternCache) THEN RETURN FALSE
    RETURN elternCache[i] >= 0
END FUNCTION

' Wo ein Control zu sehen ist (Fensterlage). Ein Kind eines Layouts legt die
' Laufzeit selbst -- sein x/y im Modell zaehlt nicht, also das Widget fragen.
FUNCTION lageVon(i AS INTEGER) AS TUPLE
    IF verwaltet(i) AND frm >= 0 THEN
        DIM h AS GUI_WIDGET : h = GUI_WINDOW_WIDGET(frm, i)
        IF h >= 0 THEN RETURN (GUI_GET_X(h), GUI_GET_Y(h), GUI_GET_W(h), GUI_GET_H(h))
    END IF
    RETURN (feldZahl(i, "x"), feldZahl(i, "y"), feldZahl(i, "w"), feldZahl(i, "h"))
END FUNCTION

FUNCTION tiefe(i AS INTEGER) AS INTEGER
    DIM t AS INTEGER : t = 0
    WHILE verwaltet(i) AND t < 64
        i = elternCache[i]
        t = t + 1
    WEND
    RETURN t
END FUNCTION

' Steht b (mittelbar) in a? -- wie istVorfahr, aber ueber den Zwischenspeicher.
FUNCTION liegtIn(b AS INTEGER, a AS INTEGER) AS BOOLEAN
    IF a < 0 THEN RETURN FALSE
    DIM t AS INTEGER : t = 0
    WHILE verwaltet(b) AND t < 64
        b = elternCache[b]
        IF b = a THEN RETURN TRUE
        t = t + 1
    WEND
    RETURN FALSE
END FUNCTION

' Was bei einem Zug nicht Ziel sein darf: das gezogene Control -- bei
' ausser = -2 die ganze Auswahl -- und alles, was darin steht.
FUNCTION ausgenommen(l AS INTEGER, ausser AS INTEGER) AS BOOLEAN
    IF ausser = -2 THEN
        DIM g AS INTEGER
        FOR EACH g IN gewaehlt
            IF l = g OR liegtIn(l, g) THEN RETURN TRUE
        NEXT
        RETURN FALSE
    END IF
    IF ausser < 0 THEN RETURN FALSE
    RETURN l = ausser OR liegtIn(l, ausser)
END FUNCTION

' Steht etwas aus der Auswahl in einem Layout? Dann wird umgesetzt statt
' verschoben -- was ein Layout legt, legt es weiter.
FUNCTION auswahlVerwaltet() AS BOOLEAN
    DIM g AS INTEGER
    FOR EACH g IN gewaehlt
        IF verwaltet(g) THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Was ein Zug bewegt: die Auswahl ohne die, deren Layout selbst gewaehlt ist
' (sie gehen mit ihm), sortiert, wie sie im Ziel stehen sollen.
FUNCTION zugListe(art AS STRING) AS ARRAY OF INTEGER
    DIM r AS ARRAY OF INTEGER : r = []
    DIM g AS INTEGER
    FOR EACH g IN gewaehlt
        DIM mit AS BOOLEAN : mit = FALSE
        DIM o AS INTEGER
        FOR EACH o IN gewaehlt
            IF o <> g AND liegtIn(g, o) THEN mit = TRUE
        NEXT
        IF NOT mit THEN ARRAY_PUSH(r, g)
    NEXT
    ' In eine Zeile von links nach rechts, sonst zeilenweise von oben.
    SORT(r, FUNCTION(a, b) zugVergleich(a, b, art))
    RETURN r
END FUNCTION

FUNCTION zugVergleich(a AS INTEGER, b AS INTEGER, art AS STRING) AS INTEGER
    DIM ax AS INTEGER
    DIM ay AS INTEGER
    DIM aw AS INTEGER
    DIM ah AS INTEGER
    DIM bx AS INTEGER
    DIM by AS INTEGER
    DIM bw AS INTEGER
    DIM bh AS INTEGER
    (ax, ay, aw, ah) = lageVon(a)
    (bx, by, bw, bh) = lageVon(b)
    IF art = "zeile" THEN
        IF ax <> bx THEN RETURN ax - bx
        RETURN ay - by
    END IF
    IF ABS(ay - by) > MIN(ah, bh) \ 2 THEN RETURN ay - by
    RETURN ax - bx
END FUNCTION

' Das innerste Layout unter einem Punkt -- ohne `ausser` und alles, was darin
' steht (ein Layout laesst sich nicht in sich selbst legen).
FUNCTION instanzBei(fx AS INTEGER, fy AS INTEGER) AS INTEGER
    DIM best AS INTEGER : best = -1
    DIM l AS INTEGER
    FOR l = 0 TO anzahl() - 1
        IF feldText$(l, "kind") <> "studio_control" THEN CONTINUE
        DIM h AS GUI_WIDGET : h = IIF(frm >= 0, GUI_WINDOW_WIDGET(frm, l), -1)
        IF h >= 0 THEN
            IF NOT GUI_VISIBLE(h) THEN CONTINUE
        END IF
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM w AS INTEGER
        DIM hh AS INTEGER
        (x, y, w, hh) = lageVon(l)
        IF fx >= x AND fy >= y AND fx < x + w AND fy < y + hh THEN best = l
    NEXT
    RETURN best
END FUNCTION

FUNCTION layoutBei(fx AS INTEGER, fy AS INTEGER, ausser AS INTEGER) AS INTEGER
    DIM best AS INTEGER : best = -1
    DIM bestT AS INTEGER : bestT = -1
    DIM l AS INTEGER
    FOR l = 0 TO anzahl() - 1
        IF NOT istLayout(l) OR ausgenommen(l, ausser) THEN CONTINUE
        DIM h AS GUI_WIDGET : h = IIF(frm >= 0, GUI_WINDOW_WIDGET(frm, l), -1)
        IF h >= 0 THEN
            IF NOT GUI_VISIBLE(h) THEN CONTINUE
        END IF
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM w AS INTEGER
        DIM hh AS INTEGER
        (x, y, w, hh) = lageVon(l)
        IF fx < x OR fy < y OR fx >= x + w OR fy >= y + hh THEN CONTINUE
        DIM t AS INTEGER : t = tiefe(l)
        IF t >= bestT THEN
            best = l
            bestT = t
        END IF
    NEXT
    RETURN best
END FUNCTION

' Was ein Klick trifft: die Laufzeit nimmt Layouts aus ihrem Treffertest
' (fuer Klicks sind sie Luft). Im Entwurf will man sie aber anklicken --
' zwischen den Kindern, auf dem Rand. Ein Kind gewinnt vor seinem Layout,
' ein Control, das vorn darueber liegt, ebenso.
FUNCTION trefferMitLayouts(i AS INTEGER, fx AS INTEGER, fy AS INTEGER) AS INTEGER
    ' Eine Instanz eines eigenen Controls ist im Entwurf ein leerer
    ' Behaelter -- Luft fuer Klicks. Wo keiner ihrer Teile liegt, trifft der
    ' Klick sie trotzdem.
    IF i < 0 THEN i = instanzBei(fx, fy)
    DIM l AS INTEGER : l = layoutBei(fx, fy, -1)
    IF l < 0 THEN RETURN i
    IF i < 0 THEN RETURN l
    IF liegtIn(i, l) OR i > l THEN RETURN i
    RETURN l
END FUNCTION

' Wohin ein Control in Layout l kommt, wenn man es bei (fx, fy) loslaesst:
' die Stelle in der Liste (zielPos) und die Marke dafuer. `ausser` = das
' gezogene Control, es zaehlt beim Vergleichen nicht mit.
SUB stelleRechnen(l AS INTEGER, fx AS INTEGER, fy AS INTEGER, ausser AS INTEGER)
    DIM art AS STRING : art = feldText$(l, "layout.art")
    IF art = "" THEN art = "spalte"
    DIM lx AS INTEGER
    DIM ly AS INTEGER
    DIM lw AS INTEGER
    DIM lh AS INTEGER
    (lx, ly, lw, lh) = lageVon(l)
    DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
    zielPos = LEN(kinder)
    ' Ohne Kinder: am Anfang des Layouts.
    IF art = "spalte" THEN
        markeX = lx + 2 : markeY = ly + 2 : markeB = lw - 4 : markeH = 3
    ELSE
        markeX = lx + 2 : markeY = ly + 2 : markeB = 3 : markeH = lh - 4
    END IF
    DIM letzte AS INTEGER : letzte = -1
    DIM k AS INTEGER
    FOR k = 0 TO LEN(kinder) - 1
        DIM c AS INTEGER : c = kinder[k]
        IF c < 0 OR c = ausser THEN CONTINUE
        IF ausser = -2 THEN
            IF istGewaehlt(c) THEN CONTINUE
        END IF
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM w AS INTEGER
        DIM h AS INTEGER
        (x, y, w, h) = lageVon(c)
        DIM davor AS BOOLEAN
        SELECT CASE art
            CASE "zeile" : davor = fx < x + w \ 2
            CASE "spalte" : davor = fy < y + h \ 2
            CASE ELSE : davor = fy < y OR (fy < y + h AND fx < x + w \ 2)
        END SELECT
        IF davor THEN
            zielPos = k
            IF art = "spalte" THEN
                markeX = x : markeY = y - 4 : markeB = w : markeH = 3
            ELSE
                markeX = x - 4 : markeY = y : markeB = 3 : markeH = h
            END IF
            RETURN
        END IF
        letzte = c
    NEXT
    IF letzte >= 0 THEN
        DIM ex AS INTEGER
        DIM ey AS INTEGER
        DIM ew AS INTEGER
        DIM eh AS INTEGER
        (ex, ey, ew, eh) = lageVon(letzte)
        IF art = "spalte" THEN
            markeX = ex : markeY = ey + eh + 1 : markeB = ew : markeH = 3
        ELSE
            markeX = ex + ew + 1 : markeY = ey : markeB = 3 : markeH = eh
        END IF
    END IF
END SUB

' Das Ziel unter der Maus bestimmen (zielL = -1: frei ablegen).
SUB zielBestimmen(fx AS INTEGER, fy AS INTEGER, ausser AS INTEGER)
    zielL = layoutBei(fx, fy, ausser)
    IF zielL >= 0 THEN stelleRechnen(zielL, fx, fy, ausser)
END SUB

' Ein gestrichelter Rahmen (Bildschirmlage) -- so zeigt der Entwurf Layouts,
' die selbst nichts zeichnen.
SUB gestrichelt(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, f AS INTEGER)
    DIM p AS INTEGER
    FOR p = x1 TO x2 STEP 8
        BOX(p, y1, MIN(p + 3, x2), y1, f)
        BOX(p, y2, MIN(p + 3, x2), y2, f)
    NEXT
    FOR p = y1 TO y2 STEP 8
        BOX(x1, p, x1, MIN(p + 3, y2), f)
        BOX(x2, p, x2, MIN(p + 3, y2), f)
    NEXT
END SUB

' Fuer Pruefungen: die Kinderliste jedes Layouts, "behaelter L a:0,b:1".
SUB behaelterProtokollieren()
    IF logDatei = "" THEN RETURN
    ' Ein Strich vorweg: so liest eine Pruefung den Stand nach JEDER Aenderung.
    protokoll("behaelter --")
    DIM l AS INTEGER
    FOR l = 0 TO anzahl() - 1
        IF NOT istLayout(l) THEN CONTINUE
        DIM teile AS ARRAY OF STRING : teile = []
        DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
        DIM gew AS ARRAY OF INTEGER : gew = gewichtListe(l)
        DIM k AS INTEGER
        FOR k = 0 TO LEN(kinder) - 1
            DIM n AS STRING : n = IIF(kinder[k] < 0, "-", feldText$(kinder[k], "name"))
            ARRAY_PUSH(teile, n + ":" + STR$(gew[k]))
        NEXT
        protokoll("behaelter " + feldText$(l, "name") + " " + JOIN$(teile, ","))
    NEXT
END SUB

' Fuer Pruefungen: die Mitte jedes Controls auf dem Schirm, wie man es sieht.
SUB controlsProtokollieren()
    IF logDatei = "" OR frm < 0 THEN RETURN
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM w AS INTEGER
        DIM h AS INTEGER
        (x, y, w, h) = lageVon(i)
        protokoll("lage control " + feldText$(i, "name") + " " + STR$(formX + zS(x + w \ 2)) + " " + STR$(formY + zS(y + h \ 2)) + " " + STR$(w) + " " + STR$(h))
    NEXT
    ' die Teile eigener Controls in der Vorschau: "lage teil INSTANZ_TEIL x y b h"
    ' (Lage im Fenster, nicht auf dem Schirm -- so wie ein Programm sie sieht).
    FOR i = 0 TO LEN(vkTeilInst) - 1
        DIM th AS GUI_WIDGET : th = GUI_WINDOW_WIDGET(frm, vkFensterN + i)
        DIM tn AS STRING : tn = vkName[vkTeilInst[i]] + "_" + STR$(i - (vkErster[vkTeilInst[i]] - vkFensterN))
        protokoll("lage teil " + tn + " " + STR$(GUI_GET_X(th)) + " " + STR$(GUI_GET_Y(th)) + " " + STR$(GUI_GET_W(th)) + " " + STR$(GUI_GET_H(th)))
    NEXT
    ' und jeden Abstandhalter: "lage abstand LAYOUT STELLE x y"
    FOR i = 0 TO anzahl() - 1
        IF NOT istLayout(i) THEN CONTINUE
        DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(i)
        DIM k AS INTEGER
        FOR k = 0 TO LEN(kinder) - 1
            IF kinder[k] >= 0 THEN CONTINUE
            (x, y, w, h) = abstandRect(i, k)
            IF w > 0 THEN protokoll("lage abstand " + feldText$(i, "name") + " " + STR$(k) + " " + STR$(formX + zS(x + w \ 2)) + " " + STR$(formY + zS(y + h \ 2)))
        NEXT
    NEXT
END SUB

' Lage waehrend eines Zugs: ins Modell UND live ins Widget (kein Neuaufbau).
SUB lageSetzenVon(i AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    JSON_SET_INT(doc, wz$(i, "x"), x) : JSON_SET_INT(doc, wz$(i, "y"), y)
    JSON_SET_INT(doc, wz$(i, "w"), w) : JSON_SET_INT(doc, wz$(i, "h"), h)
    IF frm >= 0 THEN
        DIM hd AS GUI_WIDGET : hd = GUI_WINDOW_WIDGET(frm, i)
        IF hd >= 0 THEN GUI_SET_BOUNDS(hd, x, y, w, h)
    END IF
END SUB

' --- Zoom -------------------------------------------------------------------
' Beim Oeffnen eines Fensters: passt es bei 100 % nicht in die Mitte, die
' groesste Stufe bis 50 %, bei der es ganz zu sehen ist (der Rest laege
' hinter dem Zuschnitt). Ein kleines Fenster bleibt bei 100 %.
SUB zoomEinpassen()
    zoomF = 1.0
    IF mitteB <= 0 OR mitteH <= 0 THEN RETURN
    DIM z AS FLOAT
    FOR EACH z IN [1.0, 0.75, 0.5]
        zoomF = z
        IF fensterB() * z + 64 <= mitteB AND (fensterH() + menueLeisteH(doc)) * z + TITEL_H + 64 <= mitteH THEN EXIT FOR
    NEXT
    statusZoom()
    IF zoomF < 1.0 THEN protokoll("zoom eingepasst " + STR$(INT(zoomF * 100 + 0.5)))
END SUB

SUB zoomStufe(richtung AS INTEGER)
    DIM stufen AS ARRAY OF FLOAT : stufen = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0]
    DIM k AS INTEGER
    IF richtung = 0 THEN
        zoomF = 1.0
    ELSEIF richtung > 0 THEN
        FOR k = 0 TO LEN(stufen) - 1
            IF stufen[k] > zoomF + 0.01 THEN zoomF = stufen[k] : BREAK
        NEXT
    ELSE
        FOR k = LEN(stufen) - 1 TO 0 STEP -1
            IF stufen[k] < zoomF - 0.01 THEN zoomF = stufen[k] : BREAK
        NEXT
    END IF
    IF frm >= 0 THEN GUI_WINDOW_ZOOM(frm, zoomF)
    entwurfLegen()
    statusZoom()
    protokoll("zoom " + STR$(INT(zoomF * 100 + 0.5)))
END SUB

' --- Ausrichtungslinien --------------------------------------------------------
SUB linienLeeren()
    linX1 = [] : linY1 = [] : linX2 = [] : linY2 = []
END SUB

SUB linie(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    ARRAY_PUSH(linX1, x1) : ARRAY_PUSH(linY1, y1)
    ARRAY_PUSH(linX2, x2) : ARRAY_PUSH(linY2, y2)
END SUB

' Ziele einer Achse: Fensterraender, Rand von 20, Mitte; Kanten und Mitten der
' Controls, die nicht mitgezogen werden; Abstand 12 neben einem Nachbarn.
' `art` sagt, was der Wert ist (0 Kante/Mitte, 1 "links von mir endet ein
' Nachbar" = meine linke Kante darf dort hin, 2 = meine rechte Kante).
DIM zielWert AS ARRAY OF INTEGER : zielWert = []
DIM zielArt AS ARRAY OF INTEGER : zielArt = []
DIM zielVon AS ARRAY OF INTEGER : zielVon = []     ' Control oder -1 (Fenster)
' Gesammelt wird nur waehrend eines Zugs (Maustaste unten), und dabei bewegt
' sich nur die Auswahl, die selbst kein Ziel ist -- also je Zug und Achse
' einmal. Ein grosses Fenster las sonst in jedem Bild alle Lagen aus dem JSON.
DIM zielZug AS INTEGER : zielZug = 0
DIM zielStandX AS STRING : zielStandX = ""
DIM zielStandY AS STRING : zielStandY = ""
DIM zielWx AS ARRAY OF INTEGER : zielWx = []
DIM zielAx AS ARRAY OF INTEGER : zielAx = []
DIM zielVx AS ARRAY OF INTEGER : zielVx = []
DIM zielWy AS ARRAY OF INTEGER : zielWy = []
DIM zielAy AS ARRAY OF INTEGER : zielAy = []
DIM zielVy AS ARRAY OF INTEGER : zielVy = []

SUB zieleSammeln(senkrecht AS BOOLEAN)
    DIM groesse AS INTEGER : groesse = IIF(senkrecht, fensterH(), fensterB())
    DIM stand AS STRING : stand = STR$(zielZug) + ":" + STR$(groesse) + ":" + STR$(anzahl()) + ":" + JOIN$(gewaehlt, ",")
    IF senkrecht AND stand = zielStandY THEN
        zielWert = zielWy : zielArt = zielAy : zielVon = zielVy
        RETURN
    END IF
    IF NOT senkrecht AND stand = zielStandX THEN
        zielWert = zielWx : zielArt = zielAx : zielVon = zielVx
        RETURN
    END IF
    zielWert = [] : zielArt = [] : zielVon = []
    DIM v AS INTEGER
    FOR EACH v IN [0, groesse, groesse \ 2]
        ARRAY_PUSH(zielWert, v) : ARRAY_PUSH(zielArt, 0) : ARRAY_PUSH(zielVon, -1)
    NEXT
    ARRAY_PUSH(zielWert, RAND_FENSTER) : ARRAY_PUSH(zielArt, 1) : ARRAY_PUSH(zielVon, -1)
    ARRAY_PUSH(zielWert, groesse - RAND_FENSTER) : ARRAY_PUSH(zielArt, 2) : ARRAY_PUSH(zielVon, -1)
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        IF istGewaehlt(i) THEN CONTINUE
        DIM ix AS INTEGER
        DIM iy AS INTEGER
        DIM iw AS INTEGER
        DIM ih AS INTEGER
        (ix, iy, iw, ih) = lageVon(i)
        DIM a AS INTEGER : a = IIF(senkrecht, iy, ix)
        DIM l AS INTEGER : l = IIF(senkrecht, ih, iw)
        FOR EACH v IN [a, a + l, a + l \ 2]
            ARRAY_PUSH(zielWert, v) : ARRAY_PUSH(zielArt, 0) : ARRAY_PUSH(zielVon, i)
        NEXT
        ARRAY_PUSH(zielWert, a + l + ABSTAND_NACHBAR) : ARRAY_PUSH(zielArt, 1) : ARRAY_PUSH(zielVon, i)
        ARRAY_PUSH(zielWert, a - ABSTAND_NACHBAR) : ARRAY_PUSH(zielArt, 2) : ARRAY_PUSH(zielVon, i)
    NEXT
    IF senkrecht THEN
        zielWy = zielWert : zielAy = zielArt : zielVy = zielVon : zielStandY = stand
    ELSE
        zielWx = zielWert : zielAx = zielArt : zielVx = zielVon : zielStandX = stand
    END IF
END SUB

' Die beste Verschiebung, damit eine der Kanten (anfang, mitte, ende) eines
' Bereichs auf einem Ziel liegt. `kanten`: 1 = nur Anfang, 2 = nur Ende,
' 3 = alle drei. Liefert die Verschiebung; `treffer` den Zielindex (-1 = keiner).
DIM treffer AS INTEGER
DIM trefferKante AS INTEGER
FUNCTION einrasten(anfang AS INTEGER, laenge AS INTEGER, kanten AS INTEGER) AS INTEGER
    treffer = -1
    DIM beste AS INTEGER : beste = FANG + 1
    DIM d AS INTEGER : d = 0
    DIM z AS INTEGER
    FOR z = 0 TO LEN(zielWert) - 1
        DIM k AS INTEGER
        FOR k = 0 TO 2
            IF kanten = 1 AND k <> 0 THEN CONTINUE
            IF kanten = 2 AND k <> 2 THEN CONTINUE
            ' Abstandsziele nur fuer die passende Kante.
            IF zielArt[z] = 1 AND k <> 0 THEN CONTINUE
            IF zielArt[z] = 2 AND k <> 2 THEN CONTINUE
            DIM pos AS INTEGER : pos = anfang + IIF(k = 0, 0, IIF(k = 1, laenge \ 2, laenge))
            DIM abst AS INTEGER : abst = ABS(zielWert[z] - pos)
            IF abst < beste THEN
                beste = abst
                d = zielWert[z] - pos
                treffer = z
                trefferKante = k
            END IF
        NEXT
    NEXT
    RETURN d
END FUNCTION

' Eine Linie fuer den gefundenen Treffer: ueber Bereich und Ziel hinweg.
SUB linieZuTreffer(senkrecht AS BOOLEAN, wert AS INTEGER, a1 AS INTEGER, a2 AS INTEGER)
    IF treffer < 0 THEN RETURN
    DIM von AS INTEGER : von = a1
    DIM bis AS INTEGER : bis = a2
    DIM c AS INTEGER : c = zielVon[treffer]
    IF c >= 0 THEN
        DIM cx AS INTEGER
        DIM cy AS INTEGER
        DIM cw AS INTEGER
        DIM ch AS INTEGER
        (cx, cy, cw, ch) = lageVon(c)
        DIM ca AS INTEGER : ca = IIF(senkrecht, cx, cy)
        DIM cl AS INTEGER : cl = IIF(senkrecht, cw, ch)
        von = MIN(von, ca) : bis = MAX(bis, ca + cl)
    ELSE
        von = 0 : bis = IIF(senkrecht, fensterB(), fensterH())
    END IF
    IF senkrecht THEN linie(von, wert, bis, wert) ELSE linie(wert, von, wert, bis)
END SUB

' --- Griffe -----------------------------------------------------------------
FUNCTION griffBei(mx AS INTEGER, my AS INTEGER) AS INTEGER
    IF auswahl < 0 OR LEN(gewaehlt) <> 1 THEN RETURN -1
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM w AS INTEGER
    DIM h AS INTEGER
    (x, y, w, h) = lageVon(auswahl)
    DIM gx AS ARRAY OF INTEGER : gx = [x, x + w \ 2, x + w, x + w, x + w, x + w \ 2, x, x]
    DIM gy AS ARRAY OF INTEGER : gy = [y, y, y, y + h \ 2, y + h, y + h, y + h, y + h \ 2]
    DIM weite AS INTEGER : weite = MAX(3, zF(6))
    DIM i AS INTEGER
    FOR i = 0 TO 7
        IF ABS(mx - gx[i]) <= weite AND ABS(my - gy[i]) <= weite THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Die Griffe des Fensters selbst: die rechte und die untere Kante und die
' Ecke unten rechts (Schirmlage). 0 = keiner, 1 rechts, 2 unten, 3 Ecke.
FUNCTION fensterGriffBei(sx AS INTEGER, sy AS INTEGER) AS INTEGER
    IF NOT inDerMitte(sx, sy) THEN RETURN 0
    DIM rx AS INTEGER : rx = formX + zS(fensterB())
    DIM uy AS INTEGER : uy = formY + zS(fensterH())
    IF ABS(sx - rx) <= 6 AND ABS(sy - uy) <= 6 THEN RETURN 3
    IF ABS(sx - rx) <= 4 AND sy >= formY AND sy < uy THEN RETURN 1
    IF ABS(sy - uy) <= 4 AND sx >= formX AND sx < rx THEN RETURN 2
    RETURN 0
END FUNCTION

FUNCTION fensterGriffZeiger$(g AS INTEGER) AS STRING
    SELECT CASE g
        CASE 1 : RETURN "resize_ew"
        CASE 2 : RETURN "resize_ns"
    END SELECT
    RETURN "resize_nwse"
END FUNCTION

' Nach dem Ziehen am Fenster: die Laufzeit hat verankerte Controls schon
' mitgenommen (wie spaeter im Programm) -- ihre Lage ins Modell.
SUB ankerUebernehmen()
    IF frm < 0 THEN RETURN
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        IF verwaltet(i) THEN CONTINUE
        DIM a AS STRING : a = feldText$(i, "anchor")
        IF INSTR(a, "r") < 0 AND INSTR(a, "b") < 0 THEN CONTINUE
        DIM h AS GUI_WIDGET : h = GUI_WINDOW_WIDGET(frm, i)
        IF h < 0 THEN CONTINUE
        JSON_SET_INT(doc, wz$(i, "x"), GUI_GET_X(h)) : JSON_SET_INT(doc, wz$(i, "y"), GUI_GET_Y(h))
        JSON_SET_INT(doc, wz$(i, "w"), GUI_GET_W(h)) : JSON_SET_INT(doc, wz$(i, "h"), GUI_GET_H(h))
    NEXT
END SUB

' Das Fenster ist im Inspektor um dw/dh gewachsen: verankerte Controls
' ruecken wie beim Ziehen am Griff -- rechts verankert ruecken sie, links
' und rechts verankert werden sie breiter (ebenso oben/unten).
SUB ankerNachMass(dw AS INTEGER, dh AS INTEGER)
    IF dw = 0 AND dh = 0 THEN RETURN
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        IF verwaltet(i) THEN CONTINUE
        DIM a AS STRING : a = feldText$(i, "anchor")
        IF INSTR(a, "r") >= 0 THEN
            IF INSTR(a, "l") >= 0 THEN
                JSON_SET_INT(doc, wz$(i, "w"), MAX(1, feldZahl(i, "w") + dw))
            ELSE
                JSON_SET_INT(doc, wz$(i, "x"), feldZahl(i, "x") + dw)
            END IF
        END IF
        IF INSTR(a, "b") >= 0 THEN
            IF INSTR(a, "t") >= 0 THEN
                JSON_SET_INT(doc, wz$(i, "h"), MAX(1, feldZahl(i, "h") + dh))
            ELSE
                JSON_SET_INT(doc, wz$(i, "y"), feldZahl(i, "y") + dh)
            END IF
        END IF
    NEXT
END SUB

FUNCTION griffZeiger$(g AS INTEGER) AS STRING
    SELECT CASE g
        CASE 0, 4 : RETURN "resize_nwse"
        CASE 2, 6 : RETURN "resize_nesw"
        CASE 1, 5 : RETURN "resize_ns"
        CASE 3, 7 : RETURN "resize_ew"
    END SELECT
    RETURN "default"
END FUNCTION

' --- Maus ---------------------------------------------------------------------
FUNCTION imFenster(sx AS INTEGER, sy AS INTEGER) AS BOOLEAN
    IF NOT inDerMitte(sx, sy) THEN RETURN FALSE
    RETURN sx >= formX AND sy >= formY AND sx < formX + zS(fensterB()) AND sy < formY + zS(fensterH())
END FUNCTION

FUNCTION inDerMitte(sx AS INTEGER, sy AS INTEGER) AS BOOLEAN
    IF NOT layoutVorn() THEN RETURN FALSE
    RETURN sx >= mitteX AND sy >= mitteY AND sx < mitteX + mitteB AND sy < mitteY + mitteH
END FUNCTION

FUNCTION umschalt() AS BOOLEAN
    RETURN KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT)
END FUNCTION

FUNCTION strg() AS BOOLEAN
    RETURN KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)
END FUNCTION

FUNCTION alt() AS BOOLEAN
    RETURN KEYPRESSED(KEY_LALT) OR KEYPRESSED(KEY_RALT)
END FUNCTION

' Ein Wert ans Raster -- es sei denn, das Raster ist aus oder Alt gedrueckt.
FUNCTION rasterWert(v AS INTEGER) AS INTEGER
    IF NOT rasterAn OR alt() THEN RETURN v
    RETURN amRaster(v)
END FUNCTION

SUB mausAufEntwurf()
    DIM smx AS INTEGER : smx = MOUSEX()
    DIM smy AS INTEGER : smy = MOUSEY()
    mausFx = zF(smx - formX)
    mausFy = zF(smy - formY)
    IF strg() AND MOUSEWHEEL_Y() <> 0.0 AND inDerMitte(smx, smy) THEN zoomStufe(IIF(MOUSEWHEEL_Y() > 0.0, 1, -1))

    ' Zeiger: ueber einem Griff die passende Form.
    DIM fgz AS INTEGER : fgz = IIF(modus = 0 AND NOT bibScharf() AND fensterOben(smx, smy), fensterGriffBei(smx, smy), 0)
    IF modus = 4 THEN
        MOUSE_CURSOR(fensterGriffZeiger$(fensterGriff))
    ELSEIF fgz > 0 AND griffBei(mausFx, mausFy) < 0 THEN
        MOUSE_CURSOR(fensterGriffZeiger$(fgz))
    ELSEIF modus = 0 AND imFenster(smx, smy) AND NOT bibScharf() THEN
        DIM gz AS INTEGER : gz = griffBei(mausFx, mausFy)
        IF gz >= 0 THEN MOUSE_CURSOR(griffZeiger$(gz)) ELSE MOUSE_CURSOR("auto")
    ELSEIF modus = 0 AND bibScharf() AND imFenster(smx, smy) THEN
        MOUSE_CURSOR("crosshair")
    ELSEIF modus = 0 THEN
        MOUSE_CURSOR("auto")
    END IF

    IF MOUSE_HIT(0) AND inDerMitte(smx, smy) AND fensterOben(smx, smy) THEN
        ' Ein Baustein ist scharf: ablegen.
        IF bibScharf() AND imFenster(smx, smy) THEN
            ablegen(bibAusgewaehlt(), mausFx, mausFy, TRUE)
            bibEntschaerfen()
            RETURN
        END IF
        ' Ein Timer in der Leiste unter dem Fenster: waehlen, doppelt = Ereignis.
        DIM tk AS INTEGER : tk = trayBei(smx, smy)
        IF tk >= 0 THEN
            auswahlSetzen(-1)
            trayWahl = tk
            auswahlGeaendert()
            modus = 0
            IF doppelKlick(TRAY + tk) THEN
                controlsVon(aktFenster)
                ereignisDialog(aktFenster, ctrlWidgets + tk)
            END IF
            GUI_FOCUS(-1)
            RETURN
        END IF
        griff = IIF(imFenster(smx, smy), griffBei(mausFx, mausFy), -1)
        DIM fgd AS INTEGER : fgd = fensterGriffBei(smx, smy)
        IF griff < 0 AND fgd > 0 THEN
            ' Am Rand des Fensters: es wird groesser oder kleiner.
            auswahlSetzen(-1)
            auswahlGeaendert()
            modus = 4
            fensterGriff = fgd
            startMx = mausFx : startMy = mausFy
            startW = fensterB() : startH = fensterH()
            bewegt = FALSE
            GUI_FOCUS(-1)
            RETURN
        END IF
        IF griff >= 0 THEN
            modus = 2
        ELSE
            DIM i AS INTEGER : i = -1
            IF imFenster(smx, smy) THEN i = trefferMitLayouts(indexVonHandle(GUI_HIT_TEST(smx, smy)), mausFx, mausFy)
            ' Auf einem Abstandhalter (er gehoert zum Layout, ist kein Control).
            IF imFenster(smx, smy) AND (i < 0 OR istLayout(i)) THEN
                IF abstandBei(mausFx, mausFy) THEN
                    auswahlSetzen(-1)
                    abstandL = abstandTrefferL
                    abstandK = abstandTrefferK
                    auswahlGeaendert()
                    modus = 0
                    GUI_FOCUS(-1)
                    RETURN
                END IF
            END IF
            ' Doppelklick auf ein Control oder das Fenster: Ereignis hinzufuegen.
            IF imFenster(smx, smy) AND doppelKlick(i) THEN
                IF i >= 0 THEN auswahlSetzen(i) ELSE auswahlSetzen(-1)
                auswahlGeaendert()
                modus = 0
                ereignisDialog(aktFenster, i)
                RETURN
            END IF
            DIM dazu AS BOOLEAN : dazu = umschalt() OR strg()
            IF i >= 0 AND dazu THEN
                auswahlUmschalten(i)
                auswahlGeaendert()
                modus = 0
                RETURN
            ELSEIF i >= 0 THEN
                IF NOT istGewaehlt(i) THEN auswahlSetzen(i)
                auswahl = i
                auswahlGeaendert()
                modus = 1
            ELSE
                IF NOT dazu THEN auswahlSetzen(-1) : auswahlGeaendert()
                modus = 3
                rahmenDazu = dazu
            END IF
        END IF
        startMx = mausFx : startMy = mausFy
        zielZug = zielZug + 1
        bewegt = FALSE
        kindZug = (modus = 1) AND auswahlVerwaltet()
        zielL = -1
        IF auswahl >= 0 THEN
            (startX, startY, startW, startH) = lageVon(auswahl)
            zugX = [] : zugY = [] : zugW = [] : zugH = []
            DIM gj AS INTEGER
            FOR EACH gj IN gewaehlt
                DIM gx AS INTEGER
                DIM gy AS INTEGER
                DIM gw AS INTEGER
                DIM gh AS INTEGER
                (gx, gy, gw, gh) = lageVon(gj)
                ARRAY_PUSH(zugX, gx) : ARRAY_PUSH(zugY, gy)
                ARRAY_PUSH(zugW, gw) : ARRAY_PUSH(zugH, gh)
            NEXT
        END IF
        GUI_FOCUS(-1)
        RETURN
    END IF

    IF modus = 4 THEN
        IF MOUSEBUTTON(0) THEN
            ' Die Lage des Fensters bleibt beim Ziehen stehen (sonst rueckte
            ' es mittig und die Maus liefe davon); erst danach neu gelegt.
            DIM nw AS INTEGER : nw = startW
            DIM nh AS INTEGER : nh = startH
            IF fensterGriff <> 2 THEN nw = MAX(80, rasterWert(startW + mausFx - startMx))
            IF fensterGriff <> 1 THEN nh = MAX(60, rasterWert(startH + mausFy - startMy))
            IF nw <> fensterB() OR nh <> fensterH() THEN
                bewegt = TRUE
                JSON_SET_INT(doc, "w", nw)
                JSON_SET_INT(doc, "h", nh)
                IF frm >= 0 THEN GUI_WINDOW_SET_BOUNDS(frm, formX, formY, nw, nh)
                lageAnzeigen()
            END IF
            RETURN
        END IF
        modus = 0
        IF bewegt THEN
            ankerUebernehmen()
            nachAenderung(TRUE)
            status(trf$("Fenster: {0} × {1}", [STR$(fensterB()), STR$(fensterH())]))
            protokoll("fenstergroesse " + STR$(fensterB()) + " " + STR$(fensterH()))
        END IF
        RETURN
    END IF

    IF modus = 3 THEN
        IF MOUSEBUTTON(0) THEN RETURN
        modus = 0
        IF ABS(mausFx - startMx) < 3 AND ABS(mausFy - startMy) < 3 THEN RETURN
        DIM rx1 AS INTEGER : rx1 = MIN(startMx, mausFx)
        DIM ry1 AS INTEGER : ry1 = MIN(startMy, mausFy)
        DIM rx2 AS INTEGER : rx2 = MAX(startMx, mausFx)
        DIM ry2 AS INTEGER : ry2 = MAX(startMy, mausFy)
        IF NOT rahmenDazu THEN gewaehlt = []
        DIM k AS INTEGER
        FOR k = 0 TO anzahl() - 1
            DIM kx AS INTEGER
            DIM ky AS INTEGER
            DIM kw AS INTEGER
            DIM kh2 AS INTEGER
            (kx, ky, kw, kh2) = lageVon(k)
            IF kx >= rx1 AND ky >= ry1 AND kx + kw <= rx2 AND ky + kh2 <= ry2 AND NOT istGewaehlt(k) THEN
                DIM kh AS GUI_WIDGET : kh = GUI_WINDOW_WIDGET(frm, k)
                IF kh >= 0 AND GUI_VISIBLE(kh) THEN ARRAY_PUSH(gewaehlt, k)
            END IF
        NEXT
        IF LEN(gewaehlt) > 0 THEN auswahl = gewaehlt[LEN(gewaehlt) - 1] ELSE auswahl = -1
        auswahlGeaendert()
        protokoll("rahmen " + STR$(LEN(gewaehlt)))
        RETURN
    END IF

    IF modus > 0 AND MOUSEBUTTON(0) AND auswahl >= 0 THEN
        DIM dx AS INTEGER : dx = mausFx - startMx
        DIM dy AS INTEGER : dy = mausFy - startMy
        IF NOT bewegt AND ABS(dx) < 2 AND ABS(dy) < 2 THEN RETURN
        bewegt = TRUE
        linienLeeren()
        IF modus = 1 AND kindZug THEN
            ' Die Kinder bleiben stehen; wohin sie kommen, zeigt die Marke.
            zielBestimmen(mausFx, mausFy, -2)
        ELSEIF modus = 1 THEN
            ziehenRechnen(dx, dy)
            ' Freie Controls lassen sich in ein Layout ziehen.
            zielBestimmen(mausFx, mausFy, -2)
        ELSE
            groesseRechnen(dx, dy)
        END IF
        lageAnzeigen()
        RETURN
    END IF

    IF modus > 0 AND NOT MOUSEBUTTON(0) THEN
        linienLeeren()
        IF bewegt AND modus = 1 THEN zugAbschliessen()
        zielL = -1
        kindZug = FALSE
        IF bewegt THEN
            nachAenderung(TRUE)
            protokoll("bewegt " + STR$(auswahl) + " " + STR$(feldZahl(auswahl, "x")) + " " + STR$(feldZahl(auswahl, "y")) + " " + STR$(feldZahl(auswahl, "w")) + " " + STR$(feldZahl(auswahl, "h")))
        END IF
        modus = 0
    END IF
END SUB

' Losgelassen nach einem Zug: in ein Layout hinein, darin umgesetzt -- oder
' neben jedes Layout gezogen, dann heraus und frei an der Stelle des Umrisses.
SUB zugAbschliessen()
    IF auswahl < 0 THEN RETURN
    DIM dx AS INTEGER : dx = mausFx - startMx
    DIM dy AS INTEGER : dy = mausFy - startMy
    IF zielL >= 0 THEN
        DIM art AS STRING : art = feldText$(zielL, "layout.art")
        DIM liste AS ARRAY OF INTEGER : liste = zugListe(art)
        kinderEinfuegen(zielL, liste, zielPos)
        DIM i AS INTEGER
        FOR EACH i IN liste
            protokoll("eingesetzt " + feldText$(i, "name") + " " + feldText$(zielL, "name") + " " + STR$(stelleIn(zielL, i)))
        NEXT
        IF LEN(liste) = 1 THEN
            status(trf$("{0} steht in {1} an Stelle {2}.", [feldText$(liste[0], "name"), feldText$(zielL, "name"), STR$(stelleIn(zielL, liste[0]) + 1)]))
        ELSE
            status(trf$("{0} Controls stehen jetzt in {1}.", [STR$(LEN(liste)), feldText$(zielL, "name")]))
        END IF
    ELSEIF kindZug THEN
        ' Neben jedes Layout: heraus, frei an der Stelle ihres Umrisses. Was
        ' frei war, geht denselben Weg mit.
        DIM los AS ARRAY OF INTEGER : los = zugListe("")
        DIM z AS INTEGER
        FOR z = 0 TO LEN(gewaehlt) - 1
            DIM g AS INTEGER : g = gewaehlt[z]
            IF ARRAY_INDEXOF(los, g) < 0 OR z >= LEN(zugX) THEN CONTINUE
            DIM x AS INTEGER : x = MAX(0, rasterWert(zugX[z] + dx))
            DIM y AS INTEGER : y = MAX(0, rasterWert(zugY[z] + dy))
            IF verwaltet(g) THEN
                kindEntfernen(g)
                protokoll("herausgenommen " + feldText$(g, "name") + " " + STR$(x) + " " + STR$(y))
            END IF
            JSON_SET_INT(doc, wz$(g, "x"), x)
            JSON_SET_INT(doc, wz$(g, "y"), y)
        NEXT
        IF LEN(los) = 1 THEN
            status(trf$("{0} steht jetzt frei im Fenster.", [feldText$(los[0], "name")]))
        ELSE
            status(trf$("{0} Controls stehen jetzt frei im Fenster.", [STR$(LEN(los))]))
        END IF
    END IF
END SUB

' Verschieben: die ganze Auswahl um denselben Weg. Eingerastet wird ihr
' umschliessendes Rechteck -- erst an Linien, sonst ans Raster.
SUB ziehenRechnen(dx AS INTEGER, dy AS INTEGER)
    ' Umschliessendes Rechteck der Auswahl beim Start.
    DIM bx1 AS INTEGER : bx1 = 99999
    DIM by1 AS INTEGER : by1 = 99999
    DIM bx2 AS INTEGER : bx2 = -99999
    DIM by2 AS INTEGER : by2 = -99999
    DIM z AS INTEGER
    FOR z = 0 TO LEN(gewaehlt) - 1
        IF z >= LEN(zugX) THEN CONTINUE
        DIM g AS INTEGER : g = gewaehlt[z]
        bx1 = MIN(bx1, zugX[z]) : by1 = MIN(by1, zugY[z])
        bx2 = MAX(bx2, zugX[z] + feldZahl(g, "w")) : by2 = MAX(by2, zugY[z] + feldZahl(g, "h"))
    NEXT
    DIM nx AS INTEGER : nx = bx1 + dx
    DIM ny AS INTEGER : ny = by1 + dy
    DIM bw AS INTEGER : bw = bx2 - bx1
    DIM bh AS INTEGER : bh = by2 - by1
    DIM eingerastetX AS BOOLEAN : eingerastetX = FALSE
    DIM eingerastetY AS BOOLEAN : eingerastetY = FALSE
    IF linienAn AND NOT alt() THEN
        zieleSammeln(FALSE)
        DIM ddx AS INTEGER : ddx = einrasten(nx, bw, 3)
        IF treffer >= 0 THEN
            nx = nx + ddx : eingerastetX = TRUE
            linieZuTreffer(FALSE, nx + IIF(trefferKante = 0, 0, IIF(trefferKante = 1, bw \ 2, bw)), ny, ny + bh)
        END IF
        zieleSammeln(TRUE)
        DIM ddy AS INTEGER : ddy = einrasten(ny, bh, 3)
        IF treffer >= 0 THEN
            ny = ny + ddy : eingerastetY = TRUE
            linieZuTreffer(TRUE, ny + IIF(trefferKante = 0, 0, IIF(trefferKante = 1, bh \ 2, bh)), nx, nx + bw)
        END IF
    END IF
    IF NOT eingerastetX THEN nx = rasterWert(nx)
    IF NOT eingerastetY THEN ny = rasterWert(ny)
    DIM wx AS INTEGER : wx = nx - bx1
    DIM wy AS INTEGER : wy = ny - by1
    FOR z = 0 TO LEN(gewaehlt) - 1
        IF z < LEN(zugX) THEN
            DIM gz AS INTEGER : gz = gewaehlt[z]
            ' Was ein Layout legt, legt es auch weiter.
            IF NOT verwaltet(gz) THEN lageSetzenVon(gz, zugX[z] + wx, zugY[z] + wy, feldZahl(gz, "w"), feldZahl(gz, "h"))
        END IF
    NEXT
END SUB

' Groesse an einem Griff: die bewegten Kanten rasten ein.
SUB groesseRechnen(dx AS INTEGER, dy AS INTEGER)
    DIM x1 AS INTEGER : x1 = startX
    DIM y1 AS INTEGER : y1 = startY
    DIM x2 AS INTEGER : x2 = startX + startW
    DIM y2 AS INTEGER : y2 = startY + startH
    DIM links AS BOOLEAN : links = griff = 0 OR griff = 6 OR griff = 7
    DIM rechts AS BOOLEAN : rechts = griff = 2 OR griff = 3 OR griff = 4
    DIM oben AS BOOLEAN : oben = griff = 0 OR griff = 1 OR griff = 2
    DIM unten AS BOOLEAN : unten = griff = 4 OR griff = 5 OR griff = 6
    IF links THEN x1 = x1 + dx
    IF rechts THEN x2 = x2 + dx
    IF oben THEN y1 = y1 + dy
    IF unten THEN y2 = y2 + dy
    DIM mitLinien AS BOOLEAN : mitLinien = linienAn AND NOT alt()
    IF links OR rechts THEN
        DIM rx AS INTEGER : rx = IIF(links, x1, x2)
        DIM fertigX AS BOOLEAN : fertigX = FALSE
        IF mitLinien THEN
            zieleSammeln(FALSE)
            DIM dvx AS INTEGER : dvx = einrasten(rx, 0, IIF(links, 1, 2))
            IF treffer >= 0 THEN
                rx = rx + dvx : fertigX = TRUE
                linieZuTreffer(FALSE, rx, y1, y2)
            END IF
        END IF
        IF NOT fertigX THEN rx = rasterWert(rx)
        IF links THEN x1 = MIN(rx, x2 - RASTER) ELSE x2 = MAX(rx, x1 + RASTER)
    END IF
    IF oben OR unten THEN
        DIM ry AS INTEGER : ry = IIF(oben, y1, y2)
        DIM fertigY AS BOOLEAN : fertigY = FALSE
        IF mitLinien THEN
            zieleSammeln(TRUE)
            DIM dvy AS INTEGER : dvy = einrasten(ry, 0, IIF(oben, 1, 2))
            IF treffer >= 0 THEN
                ry = ry + dvy : fertigY = TRUE
                linieZuTreffer(TRUE, ry, x1, x2)
            END IF
        END IF
        IF NOT fertigY THEN ry = rasterWert(ry)
        IF oben THEN y1 = MIN(ry, y2 - RASTER) ELSE y2 = MAX(ry, y1 + RASTER)
    END IF
    lageSetzenVon(auswahl, x1, y1, x2 - x1, y2 - y1)
END SUB

' Ein Baustein an eine Stelle im Fenster (Fensterlage). `mittig`: die Stelle
' ist die Mitte des neuen Controls (Ablegen per Zug), sonst die linke obere
' Ecke (Klick mit scharfem Baustein).
SUB ablegen(p AS INTEGER, fx AS INTEGER, fy AS INTEGER, mittig AS BOOLEAN)
    IF p < 0 THEN RETURN
    DIM b AS Baustein : b = bausteine[p]
    IF b.kind = "timer" THEN
        timerAblegen()
        RETURN
    END IF
    IF b.kind = "spacer" THEN
        abstandAblegen(fx, fy)
        RETURN
    END IF
    DIM x AS INTEGER : x = fx
    DIM y AS INTEGER : y = fy
    IF mittig THEN x = fx - b.b \ 2 : y = fy - b.h \ 2
    x = MAX(0, MIN(rasterWert(x), fensterB() - MIN(b.b, fensterB())))
    y = MAX(0, MIN(rasterWert(y), fensterH() - MIN(b.h, fensterH())))
    DIM i AS INTEGER : i = controlAnlegen(p, x, y)
    ' Auf ein Layout gelegt: hinein, an die Stelle unter der Maus.
    DIM l AS INTEGER : l = layoutBei(fx, fy, -1)
    IF l >= 0 THEN
        stelleRechnen(l, fx, fy, -1)
        kindEinfuegen(l, i, zielPos, 0)
        protokoll("eingesetzt " + feldText$(i, "name") + " " + feldText$(l, "name") + " " + STR$(stelleIn(l, i)))
    END IF
    zielL = -1
    auswahlSetzen(i)
    nachAenderung(TRUE)
    status(trf$("{0} abgelegt: {1}", [bausteinAnzeige$(b), feldText$(i, "name")]))
    protokoll("neu " + b.kind + " " + feldText$(i, "name") + " " + STR$(x) + " " + STR$(y))
END SUB

' Einen Abstandhalter in das Layout unter der Stelle -- per Doppelklick in
' der Bibliothek (die Stelle ist dann die Fenstermitte) in das gewaehlte.
SUB abstandAblegen(fx AS INTEGER, fy AS INTEGER)
    DIM l AS INTEGER : l = layoutBei(fx, fy, -1)
    DIM pos AS INTEGER
    IF l >= 0 THEN
        stelleRechnen(l, fx, fy, -1)
        pos = zielPos
    ELSEIF istLayout(auswahl) THEN
        l = auswahl
        pos = LEN(kinderListe(l))
    ELSEIF verwaltet(auswahl) THEN
        l = elternCache[auswahl]
        pos = stelleIn(l, auswahl) + 1
    ELSE
        zielL = -1
        status(tr$("Ein Abstandhalter gehört in ein Layout -- auf eine Zeile, Spalte oder ein Raster ziehen."))
        protokoll("abstand ohne layout")
        RETURN
    END IF
    zielL = -1
    abstandEinfuegen(l, pos, 1)
    auswahlSetzen(-1)
    abstandL = l
    abstandK = pos
    nachAenderung(TRUE)
    status(trf$("Abstandhalter in {0} an Stelle {1}.", [feldText$(l, "name"), STR$(pos + 1)]))
    protokoll("neu abstand " + feldText$(l, "name") + " " + STR$(pos))
END SUB

' Wo ein Abstandhalter zu sehen ist (Fensterlage). Die Laufzeit legt ihn als
' Luecke zwischen den Nachbarn -- also aus deren Lage gerechnet; einer ohne
' Gewicht ist 0 breit und bekommt hier 10 Punkte, damit man ihn sieht und
' anklicken kann. Im Fluss-Layout hat er keine Stelle (0 breit).
FUNCTION abstandRect(l AS INTEGER, k AS INTEGER) AS TUPLE
    DIM art AS STRING : art = feldText$(l, "layout.art")
    IF art = "" THEN art = "spalte"
    DIM lx AS INTEGER
    DIM ly AS INTEGER
    DIM lw AS INTEGER
    DIM lh AS INTEGER
    (lx, ly, lw, lh) = lageVon(l)
    DIM rand AS INTEGER : rand = feldZahl(l, "layout.rand")
    DIM ab AS INTEGER : ab = 6
    IF JSON_HAS(doc, wz$(l, "layout.abstand")) THEN ab = feldZahl(l, "layout.abstand")
    DIM ix AS INTEGER : ix = lx + rand
    DIM iy AS INTEGER : iy = ly + rand
    DIM iw AS INTEGER : iw = MAX(0, lw - 2 * rand)
    DIM ih AS INTEGER : ih = MAX(0, lh - 2 * rand)
    DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM w AS INTEGER
    DIM h AS INTEGER
    DIM x2 AS INTEGER
    DIM y2 AS INTEGER
    DIM w2 AS INTEGER
    DIM h2 AS INTEGER
    IF art = "fluss" THEN RETURN (ix, iy, 0, 0)
    IF art = "raster" THEN
        DIM sp AS INTEGER : sp = 2
        IF JSON_HAS(doc, wz$(l, "layout.spalten")) THEN sp = MAX(1, feldZahl(l, "layout.spalten"))
        DIM zw AS INTEGER : zw = MAX(1, (iw - ab * (sp - 1)) \ sp)
        DIM zeile AS INTEGER : zeile = k \ sp
        x = ix + (k MOD sp) * (zw + ab)
        ' Die Hoehe der Zeile aus den Controls darin, sonst unter der vorigen.
        y = iy : h = 0
        DIM j AS INTEGER
        FOR j = 0 TO LEN(kinder) - 1
            IF kinder[j] < 0 THEN CONTINUE
            (x2, y2, w2, h2) = lageVon(kinder[j])
            IF j \ sp = zeile THEN
                y = y2 : h = MAX(h, h2)
            ELSEIF j \ sp < zeile THEN
                y = MAX(y, y2 + h2 + ab)
            END IF
        NEXT
        RETURN (x, y, zw, MAX(h, 20))
    END IF
    ' Zeile oder Spalte: vom Ende des Vorgaengers bis zum Anfang des Nachfolgers.
    DIM zeileArt AS BOOLEAN : zeileArt = art = "zeile"
    DIM von AS INTEGER : von = IIF(zeileArt, ix, iy)
    DIM bis AS INTEGER : bis = IIF(zeileArt, ix + iw, iy + ih)
    DIM v AS INTEGER
    FOR v = k - 1 TO 0 STEP -1
        IF kinder[v] >= 0 THEN
            (x2, y2, w2, h2) = lageVon(kinder[v])
            von = IIF(zeileArt, x2 + w2, y2 + h2) + ab
            BREAK
        END IF
    NEXT
    FOR v = k + 1 TO LEN(kinder) - 1
        IF kinder[v] >= 0 THEN
            (x2, y2, w2, h2) = lageVon(kinder[v])
            bis = IIF(zeileArt, x2, y2) - ab
            BREAK
        END IF
    NEXT
    IF bis - von < 10 THEN
        von = (von + bis) \ 2 - 5
        bis = von + 10
    END IF
    IF zeileArt THEN RETURN (von, iy, bis - von, ih)
    RETURN (ix, von, iw, bis - von)
END FUNCTION

' Ein Abstandhalter unter dem Punkt? Setzt abstandTrefferL/K.
DIM abstandTrefferL AS INTEGER : abstandTrefferL = -1
DIM abstandTrefferK AS INTEGER : abstandTrefferK = -1
FUNCTION abstandBei(fx AS INTEGER, fy AS INTEGER) AS BOOLEAN
    abstandTrefferL = -1
    abstandTrefferK = -1
    DIM l AS INTEGER
    FOR l = 0 TO anzahl() - 1
        IF NOT istLayout(l) THEN CONTINUE
        DIM kinder AS ARRAY OF INTEGER : kinder = kinderListe(l)
        DIM k AS INTEGER
        FOR k = 0 TO LEN(kinder) - 1
            IF kinder[k] >= 0 THEN CONTINUE
            DIM x AS INTEGER
            DIM y AS INTEGER
            DIM w AS INTEGER
            DIM h AS INTEGER
            (x, y, w, h) = abstandRect(l, k)
            IF w > 0 AND fx >= x AND fy >= y AND fx < x + w AND fy < y + h THEN
                abstandTrefferL = l
                abstandTrefferK = k
            END IF
        NEXT
    NEXT
    RETURN abstandTrefferL >= 0
END FUNCTION

' Einen Abstandhalter zeichnen: eine Feder zwischen zwei Strichen (Schirmlage).
SUB abstandZeichnen(sx AS INTEGER, sy AS INTEGER, sw AS INTEGER, sh AS INTEGER, gewaehltJetzt AS BOOLEAN)
    DIM f AS INTEGER : f = IIF(gewaehltJetzt, F_AUSWAHL, F_BEHAELTER)
    BOX(sx, sy, sx + sw - 1, sy + sh - 1, RGBA(140, 123, 216, IIF(gewaehltJetzt, 70, 34)))
    IF gewaehltJetzt THEN RECT(sx, sy, sx + sw - 1, sy + sh - 1, F_AUSWAHL)
    DIM quer AS BOOLEAN : quer = sw >= sh
    DIM n AS INTEGER : n = MAX(2, IIF(quer, sw, sh) \ 8)
    DIM k AS INTEGER
    DIM px AS INTEGER : px = IIF(quer, sx, sx + sw \ 2)
    DIM py AS INTEGER : py = IIF(quer, sy + sh \ 2, sy)
    FOR k = 1 TO n
        DIM t AS INTEGER : t = IIF(k MOD 2 = 1, -1, 1) * MIN(5, IIF(quer, sh, sw) \ 3)
        DIM qx AS INTEGER : qx = IIF(quer, sx + sw * k \ (n + 1), sx + sw \ 2 + t)
        DIM qy AS INTEGER : qy = IIF(quer, sy + sh \ 2 + t, sy + sh * k \ (n + 1))
        LINE(px, py, qx, qy, f)
        px = qx : py = qy
    NEXT
    LINE(px, py, IIF(quer, sx + sw - 1, sx + sw \ 2), IIF(quer, sy + sh \ 2, sy + sh - 1), f)
END SUB

' Einen Timer anlegen: er liegt nicht im Fenster, sondern in der Leiste
' darunter (wie in Xojo).
SUB timerAblegen()
    DIM k AS INTEGER : k = timerAnlegen()
    auswahlSetzen(-1)
    trayWahl = k
    nachAenderung(TRUE)
    status(trf$("Timer angelegt: {0}", [timerName$(k)]))
    protokoll("neu timer " + timerName$(k))
    trayProtokollieren()
END SUB

' Die Leiste der Timer unter dem Fenster: Lage eines Chips auf dem Schirm.
FUNCTION trayRect(k AS INTEGER) AS TUPLE
    DIM x AS INTEGER : x = formX
    DIM y AS INTEGER : y = formY + zS(fensterH()) + 34
    DIM i AS INTEGER
    FOR i = 0 TO k - 1
        x = x + TEXT_WIDTH(timerName$(i)) + 44
    NEXT
    RETURN (x, y, TEXT_WIDTH(timerName$(k)) + 36, 28)
END FUNCTION

FUNCTION trayBei(sx AS INTEGER, sy AS INTEGER) AS INTEGER
    IF NOT layoutVorn() THEN RETURN -1
    DIM k AS INTEGER
    FOR k = 0 TO timerZahl() - 1
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM b AS INTEGER
        DIM h AS INTEGER
        (x, y, b, h) = trayRect(k)
        IF sx >= x AND sy >= y AND sx < x + b AND sy < y + h THEN RETURN k
    NEXT
    RETURN -1
END FUNCTION

SUB trayProtokollieren()
    IF logDatei = "" THEN RETURN
    DIM k AS INTEGER
    FOR k = 0 TO timerZahl() - 1
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM b AS INTEGER
        DIM h AS INTEGER
        (x, y, b, h) = trayRect(k)
        protokoll("lage timer " + timerName$(k) + " " + STR$(x + b \ 2) + " " + STR$(y + h \ 2))
    NEXT
END SUB

' Liegt an der Stelle das Entwurfsfenster oben (und kein Popover, Menue,
' Dialog darueber)?
FUNCTION fensterOben(sx AS INTEGER, sy AS INTEGER) AS BOOLEAN
    IF GUI_MODAL() THEN RETURN FALSE
    DIM w AS GUI_WINDOW : w = GUI_WINDOW_AT(sx, sy)
    RETURN w = frm OR w = win
END FUNCTION

' --- Tastatur -----------------------------------------------------------------
SUB schieben(dx AS INTEGER, dy AS INTEGER)
    IF abstandL >= 0 THEN
        abstandK = eintragRuecken(abstandL, abstandK, IIF(dx + dy < 0, -1, 1))
        nachAenderung(TRUE)
        protokoll("umgesetzt abstand " + STR$(abstandK))
        RETURN
    END IF
    IF auswahl < 0 THEN RETURN
    ' Ein Kind eines Layouts rueckt mit den Pfeilen eine Stelle weiter.
    IF LEN(gewaehlt) = 1 AND verwaltet(auswahl) THEN
        DIM l AS INTEGER : l = elternCache[auswahl]
        DIM k AS INTEGER : k = stelleIn(l, auswahl)
        kindEinfuegen(l, auswahl, IIF(dx + dy < 0, k - 1, k + 2), gewichtVon(auswahl))
        nachAenderung(TRUE)
        protokoll("umgesetzt " + feldText$(auswahl, "name") + " " + STR$(stelleIn(l, auswahl)))
        RETURN
    END IF
    DIM j AS INTEGER
    FOR EACH j IN gewaehlt
        IF verwaltet(j) THEN CONTINUE
        lageSetzenVon(j, feldZahl(j, "x") + dx, feldZahl(j, "y") + dy, feldZahl(j, "w"), feldZahl(j, "h"))
    NEXT
    nachAenderung(TRUE)
END SUB

' --- Anordnen -------------------------------------------------------------------
SUB anordnen(was AS STRING)
    IF was = "vorn" OR was = "hinten" THEN
        IF auswahl < 0 THEN RETURN
        controlOrdnen(was = "vorn")
        nachAenderung(TRUE)
        RETURN
    END IF
    DIM j0 AS INTEGER
    FOR EACH j0 IN gewaehlt
        IF verwaltet(j0) THEN
            status(tr$("Was in einem Layout steht, legt das Layout -- zum Anordnen erst herausziehen."))
            RETURN
        END IF
    NEXT
    IF auswahl < 0 OR LEN(gewaehlt) < 2 THEN
        status(tr$("Anordnen braucht mindestens zwei gewählte Controls (Umschalt+Klick oder ein Rahmen)."))
        RETURN
    END IF
    DIM bx AS INTEGER : bx = feldZahl(auswahl, "x")
    DIM by AS INTEGER : by = feldZahl(auswahl, "y")
    DIM bw AS INTEGER : bw = feldZahl(auswahl, "w")
    DIM bh AS INTEGER : bh = feldZahl(auswahl, "h")
    DIM j AS INTEGER
    IF was = "vert_w" OR was = "vert_s" THEN
        IF LEN(gewaehlt) < 3 THEN
            status(tr$("Verteilen braucht mindestens drei gewählte Controls."))
            RETURN
        END IF
        DIM feld AS STRING : feld = IIF(was = "vert_w", "x", "y")
        DIM mass AS STRING : mass = IIF(was = "vert_w", "w", "h")
        DIM reihe AS ARRAY OF INTEGER : reihe = gewaehlt
        SORT(reihe, FUNCTION(a, b) feldZahl(a, feld) - feldZahl(b, feld))
        DIM erste AS INTEGER : erste = reihe[0]
        DIM letzte AS INTEGER : letzte = reihe[LEN(reihe) - 1]
        DIM spanne AS INTEGER : spanne = feldZahl(letzte, feld) + feldZahl(letzte, mass) - feldZahl(erste, feld)
        DIM summe AS INTEGER : summe = 0
        FOR EACH j IN reihe
            summe = summe + feldZahl(j, mass)
        NEXT
        DIM luecke AS FLOAT : luecke = (spanne - summe) / (LEN(reihe) - 1)
        DIM pos AS FLOAT : pos = feldZahl(erste, feld)
        DIM a AS INTEGER
        FOR a = 0 TO LEN(reihe) - 1
            j = reihe[a]
            IF a > 0 AND a < LEN(reihe) - 1 THEN
                IF was = "vert_w" THEN
                    lageSetzenVon(j, INT(pos + 0.5), feldZahl(j, "y"), feldZahl(j, "w"), feldZahl(j, "h"))
                ELSE
                    lageSetzenVon(j, feldZahl(j, "x"), INT(pos + 0.5), feldZahl(j, "w"), feldZahl(j, "h"))
                END IF
            END IF
            pos = pos + feldZahl(j, mass) + luecke
        NEXT
    ELSE
        FOR EACH j IN gewaehlt
            IF j = auswahl THEN CONTINUE
            DIM x AS INTEGER : x = feldZahl(j, "x")
            DIM y AS INTEGER : y = feldZahl(j, "y")
            DIM w AS INTEGER : w = feldZahl(j, "w")
            DIM h AS INTEGER : h = feldZahl(j, "h")
            SELECT CASE was
                CASE "links" : x = bx
                CASE "rechts" : x = bx + bw - w
                CASE "oben" : y = by
                CASE "unten" : y = by + bh - h
                CASE "mitte_w" : x = bx + (bw - w) \ 2
                CASE "mitte_s" : y = by + (bh - h) \ 2
                CASE "breite" : w = bw
                CASE "hoehe" : h = bh
                CASE "groesse" : w = bw : h = bh
            END SELECT
            lageSetzenVon(j, x, y, w, h)
        NEXT
    END IF
    nachAenderung(TRUE)
    status(trf$("Angeordnet: {0} Controls.", [STR$(LEN(gewaehlt))]))
    protokoll("angeordnet " + was + " " + STR$(LEN(gewaehlt)))
END SUB

' --- Zeichnen (nach GUI_DRAW, vor GUI_DRAW_TOP) -------------------------------
SUB entwurfZeichnen()
    IF NOT layoutVorn() THEN RETURN
    DIM b AS INTEGER : b = zS(fensterB())
    DIM h AS INTEGER : h = zS(fensterH())
    DIM x0 AS INTEGER : x0 = formX
    DIM y0 AS INTEGER : y0 = formY - kopfH()
    DIM yt AS INTEGER : yt = formY - zS(menueLeisteH(doc))
    SCISSOR(mitteX, mitteY, mitteB, mitteH)
    ' Schatten: Ringe AUSSEN herum, nach aussen blasser. Gefuellte Flaechen
    ' gingen nicht -- die Entwurfsflaeche ist schon gezeichnet und laege
    ' darunter.
    DIM s AS INTEGER
    FOR s = 1 TO 16
        RECTROUND(x0 - s, y0 - s + 3, x0 + b + s - 1, formY + h + s + 2, 8 + s, RGBA(0, 0, 0, MAX(3, 46 - s * 3)))
    NEXT
    ' Titelleiste wie bei einem echten Fenster: oben rund, unten gerade.
    BOXROUND(x0, y0, x0 + b - 1, yt - 1, 8, farbe("titel"))
    BOX(x0, y0 + 10, x0 + b - 1, yt - 1, farbe("titel"))
    DIM k AS INTEGER
    FOR k = 0 TO 2
        CIRCLE(x0 + 18 + k * 20, y0 + TITEL_H \ 2, 6, IIF(k = 0, &HEC6A5E, IIF(k = 1, &HF4BF4F, &H61C554)))
    NEXT
    DIM titel AS STRING : titel = fensterText$("title")
    DIM tb AS INTEGER : tb = TEXT_WIDTH(titel)
    TEXT(x0 + MAX(80, (b - tb) \ 2), y0 + (TITEL_H - 15) \ 2, titel, farbe("titeltext"))
    RECT(x0 - 1, y0 - 1, x0 + b, formY + h, farbe("fensterrand"))
    ' Groesse des Fensters unten rechts, und ein Griff, der sie aendert.
    TEXT(x0 + b - TEXT_WIDTH(STR$(fensterB()) + " × " + STR$(fensterH())) - 12, formY + h + 8, STR$(fensterB()) + " × " + STR$(fensterH()), farbe("leise"))
    DIM fgx AS ARRAY OF INTEGER : fgx = [x0 + b, x0 + b \ 2, x0 + b]
    DIM fgy AS ARRAY OF INTEGER : fgy = [formY + h \ 2, formY + h, formY + h]
    DIM fk AS INTEGER
    FOR fk = 0 TO 2
        DIM an AS BOOLEAN : an = (modus = 4 AND fensterGriff = fk + 1) OR fensterGriffBei(MOUSEX(), MOUSEY()) = fk + 1
        BOXROUND(fgx[fk] - 4, fgy[fk] - 4, fgx[fk] + 4, fgy[fk] + 4, 2, IIF(an, F_AUSWAHL, &HFFFFFF))
        RECTROUND(fgx[fk] - 4, fgy[fk] - 4, fgx[fk] + 4, fgy[fk] + 4, 2, IIF(an, &HFFFFFF, F_GRIFF_RAND))
    NEXT

    ' Ausrichtungslinien
    DIM l AS INTEGER
    FOR l = 0 TO LEN(linX1) - 1
        ' Immer waagerecht oder senkrecht -- als Rechteck gezeichnet ist die
        ' Linie scharf; eine LINEW von einem Punkt Breite kam halb durchsichtig.
        BOX(formX + zS(linX1[l]), formY + zS(linY1[l]), formX + zS(linX2[l]), formY + zS(linY2[l]), F_LINIE)
    NEXT
    ' Layouts: gestrichelt, das Ziel eines Zugs kraeftig, leere mit Hinweis.
    IF bibZug >= 0 AND modus = 0 THEN
        IF imFenster(MOUSEX(), MOUSEY()) THEN zielBestimmen(mausFx, mausFy, -1) ELSE zielL = -1
    ELSEIF modus <> 1 THEN
        zielL = -1
    END IF
    ' Die Arten einmal je Bild -- die drei Schleifen unten fragten sie sonst
    ' je Control dreimal aus dem JSON.
    DIM arten AS ARRAY OF STRING : arten = []
    DIM li AS INTEGER
    FOR li = 0 TO anzahl() - 1
        ARRAY_PUSH(arten, feldText$(li, "kind"))
    NEXT
    FOR li = 0 TO LEN(arten) - 1
        IF arten[li] <> "layout" THEN CONTINUE
        DIM lw AS GUI_WIDGET : lw = IIF(frm >= 0, GUI_WINDOW_WIDGET(frm, li), -1)
        DIM zeigen AS BOOLEAN : zeigen = TRUE
        IF lw >= 0 THEN zeigen = GUI_VISIBLE(lw)
        IF NOT zeigen THEN CONTINUE
        DIM lx AS INTEGER
        DIM ly AS INTEGER
        DIM lb AS INTEGER
        DIM lhh AS INTEGER
        (lx, ly, lb, lhh) = lageVon(li)
        DIM sx1 AS INTEGER : sx1 = formX + zS(lx)
        DIM sy1 AS INTEGER : sy1 = formY + zS(ly)
        DIM sx2 AS INTEGER : sx2 = formX + zS(lx + lb) - 1
        DIM sy2 AS INTEGER : sy2 = formY + zS(ly + lhh) - 1
        IF li = zielL THEN
            RECT(sx1, sy1, sx2, sy2, F_AUSWAHL)
            RECT(sx1 + 1, sy1 + 1, sx2 - 1, sy2 - 1, F_AUSWAHL)
        ELSE
            gestrichelt(sx1, sy1, sx2, sy2, F_BEHAELTER)
        END IF
        IF LEN(kinderListe(li)) = 0 THEN
            DIM leer AS STRING : leer = tr$("Controls hierher ziehen")
            DIM tw AS INTEGER : tw = TEXT_WIDTH(leer)
            IF tw < sx2 - sx1 - 8 AND sy2 - sy1 > 18 THEN TEXT((sx1 + sx2 - tw) \ 2, (sy1 + sy2 - 15) \ 2, leer, farbe("leise"))
        END IF
    NEXT
    ' Die eigenen Controls: wie weit eine Instanz reicht -- ihr Behaelter
    ' zeichnet nichts. Fehlt ihr Control im Projekt, steht das darin.
    FOR li = 0 TO LEN(arten) - 1
        IF arten[li] <> "studio_control" THEN CONTINUE
        DIM cx AS INTEGER
        DIM cy AS INTEGER
        DIM cb AS INTEGER
        DIM ch AS INTEGER
        (cx, cy, cb, ch) = lageVon(li)
        DIM cx1 AS INTEGER : cx1 = formX + zS(cx)
        DIM cy1 AS INTEGER : cy1 = formY + zS(cy)
        DIM cx2 AS INTEGER : cx2 = formX + zS(cx + cb) - 1
        DIM cy2 AS INTEGER : cy2 = formY + zS(cy + ch) - 1
        gestrichelt(cx1, cy1, cx2, cy2, farbe("leise"))
        DIM cn AS STRING : cn = feldText$(li, "studio_control")
        DIM ce AS INTEGER : ce = elementIndex(cn)
        DIM da AS BOOLEAN : da = ce >= 0
        IF da THEN da = elemente[ce].art = "control"
        IF NOT da THEN
            TEXT(cx1 + 6, cy1 + 4, trf$("{0} gibt es nicht im Projekt", [cn]), farbe("leise"))
        ELSEIF NOT controlBrauchbar(cn) THEN
            TEXT(cx1 + 6, cy1 + 4, trf$("{0} enthält sich selbst", [cn]), farbe("leise"))
        END IF
    NEXT
    ' Die Abstandhalter jedes Layouts.
    FOR li = 0 TO LEN(arten) - 1
        IF arten[li] <> "layout" THEN CONTINUE
        DIM ak AS ARRAY OF INTEGER : ak = kinderListe(li)
        DIM ai AS INTEGER
        FOR ai = 0 TO LEN(ak) - 1
            IF ak[ai] >= 0 THEN CONTINUE
            DIM rx AS INTEGER
            DIM ry AS INTEGER
            DIM rw AS INTEGER
            DIM rh AS INTEGER
            (rx, ry, rw, rh) = abstandRect(li, ai)
            IF rw > 0 AND rh > 0 THEN abstandZeichnen(formX + zS(rx), formY + zS(ry), MAX(1, zS(rw)), MAX(1, zS(rh)), li = abstandL AND ai = abstandK)
        NEXT
    NEXT
    IF zielL >= 0 THEN BOX(formX + zS(markeX), formY + zS(markeY), formX + zS(markeX + markeB) - 1, formY + zS(markeY + markeH) - 1, F_AUSWAHL)
    ' Was umgesetzt wird: die Umrisse folgen der Maus.
    IF modus = 1 AND kindZug AND bewegt THEN
        DIM uz AS INTEGER
        FOR uz = 0 TO MIN(LEN(zugX), LEN(zugW)) - 1
            DIM ux AS INTEGER : ux = formX + zS(zugX[uz] + mausFx - startMx)
            DIM uy AS INTEGER : uy = formY + zS(zugY[uz] + mausFy - startMy)
            BOXROUND(ux, uy, ux + zS(zugW[uz]), uy + zS(zugH[uz]), 4, RGBA(58, 168, 240, 50))
            RECTROUND(ux, uy, ux + zS(zugW[uz]), uy + zS(zugH[uz]), 4, F_AUSWAHL)
        NEXT
    END IF

    ' Auswahl
    IF modus = 3 AND MOUSEBUTTON(0) THEN
        DIM rx1 AS INTEGER : rx1 = formX + zS(MIN(startMx, mausFx))
        DIM ry1 AS INTEGER : ry1 = formY + zS(MIN(startMy, mausFy))
        DIM rx2 AS INTEGER : rx2 = formX + zS(MAX(startMx, mausFx))
        DIM ry2 AS INTEGER : ry2 = formY + zS(MAX(startMy, mausFy))
        BOX(rx1, ry1, rx2, ry2, RGBA(58, 168, 240, 40))
        RECT(rx1, ry1, rx2, ry2, F_AUSWAHL)
    END IF
    DIM j AS INTEGER
    FOR EACH j IN gewaehlt
        IF j < 0 OR j >= anzahl() THEN CONTINUE
        DIM ax AS INTEGER
        DIM ay AS INTEGER
        DIM aw AS INTEGER
        DIM ah AS INTEGER
        (ax, ay, aw, ah) = lageVon(j)
        DIM jx AS INTEGER : jx = formX + zS(ax)
        DIM jy AS INTEGER : jy = formY + zS(ay)
        DIM jw AS INTEGER : jw = zS(aw)
        DIM jh AS INTEGER : jh = zS(ah)
        RECT(jx - 1, jy - 1, jx + jw, jy + jh, IIF(j = auswahl, F_AUSWAHL, &H6F9FC0))
        IF LEN(gewaehlt) = 1 THEN
            DIM gx AS ARRAY OF INTEGER : gx = [jx, jx + jw \ 2, jx + jw, jx + jw, jx + jw, jx + jw \ 2, jx, jx]
            DIM gy AS ARRAY OF INTEGER : gy = [jy, jy, jy, jy + jh \ 2, jy + jh, jy + jh, jy + jh, jy + jh \ 2]
            DIM gi AS INTEGER
            FOR gi = 0 TO 7
                BOXROUND(gx[gi] - 4, gy[gi] - 4, gx[gi] + 4, gy[gi] + 4, 2, &HFFFFFF)
                RECTROUND(gx[gi] - 4, gy[gi] - 4, gx[gi] + 4, gy[gi] + 4, 2, F_GRIFF_RAND)
            NEXT
        END IF
    NEXT
    ' Die Timer in einer Leiste darunter.
    DIM tk AS INTEGER
    FOR tk = 0 TO timerZahl() - 1
        DIM tx AS INTEGER
        DIM ty AS INTEGER
        DIM tb2 AS INTEGER
        DIM th AS INTEGER
        (tx, ty, tb2, th) = trayRect(tk)
        BOXROUND(tx, ty, tx + tb2 - 1, ty + th - 1, 6, farbe("titel"))
        RECTROUND(tx, ty, tx + tb2 - 1, ty + th - 1, 6, IIF(tk = trayWahl, F_AUSWAHL, farbe("fensterrand")))
        IF tk = trayWahl THEN RECTROUND(tx + 1, ty + 1, tx + tb2 - 2, ty + th - 2, 5, F_AUSWAHL)
        CIRCLE(tx + 14, ty + th \ 2, 7, farbe("leise"))
        CIRCLE(tx + 14, ty + th \ 2, 5, farbe("titel"))
        LINE(tx + 14, ty + th \ 2, tx + 14, ty + th \ 2 - 4, farbe("titeltext"))
        LINE(tx + 14, ty + th \ 2, tx + 17, ty + th \ 2 + 2, F_AUSWAHL)
        TEXT(tx + 26, ty + (th - 15) \ 2, timerName$(tk), farbe("titeltext"))
    NEXT
    ' Zug aus der Bibliothek: das Control als Umriss, wo es landet.
    bibGeistZeichnen()
    SCISSOR_END()
END SUB
