=== standardknopf ueberlebt die datei
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
DIM ok AS GUI_WIDGET
ok = GUI_BUTTON(w, "OK", 10, 50, 80, 26)
DIM ab AS GUI_WIDGET
ab = GUI_BUTTON(w, "Abbrechen", 100, 50, 100, 26)
GUI_WINDOW_DEFAULT(w, ok)
GUI_WINDOW_CANCEL(w, ab)
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM q AS STRING : q = CHR$(34)
PRINT INSTR(j, q + "default_button" + q + ": 1") >= 0
PRINT INSTR(j, q + "cancel_button" + q + ": 2") >= 0
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT INSTR(GUI_TO_JSON(w2), q + "cancel_button" + q + ": 2") >= 0
--- umgebung
DHRT_FRAMES=1
--- erwartet
TRUE
TRUE
TRUE

