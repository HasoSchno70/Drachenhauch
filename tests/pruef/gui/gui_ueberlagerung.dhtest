=== ein klick nimmt den vorschlag, esc schliesst die liste
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM abbr AS GUI_WIDGET
abbr = GUI_BUTTON(w, "Abbrechen", 400, 300, 120, 30)
GUI_WINDOW_CANCEL(w, abbr)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 20, 200, 28)
GUI_TEXTINPUT_COMPLETION(tf, ["Banane", "Papaya", "Apfel", "Aprikose"])
GUI_FOCUS(tf)
CLIPBOARD_SET("ap")
AUTOMATION_PLAY("ev.txt")
DIM ab AS INTEGER : ab = 0
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF GUI_CLICKED(abbr) THEN ab = ab + 1
    IF GUI_COMPLETION_CHOSEN(tf) >= 0 THEN PRINT "gewaehlt " + STR$(GUI_COMPLETION_CHOSEN(tf)) + " text " + GUI_TEXT(tf)
    IF n = 15 THEN PRINT "offen " + STR$(GUI_COMPLETION_OPEN(tf))
    IF n = 35 THEN PRINT "nach esc offen " + STR$(GUI_COMPLETION_OPEN(tf)) + " text " + GUI_TEXT(tf) + " abbrechen " + STR$(ab)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
