=== eine listenzeile blendet unter der maus ein
' Schwarzer Grund: die Hover-Farbe ist 22 Stufen heller (#161616). Zwei
' Bilder nach dem Hinfahren steht ein Zwischenton, nach der Dauer die Farbe.
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM lb AS GUI_WIDGET : lb = GUI_LISTBOX(w, 10, 10, 280, 200, ["eins", "zwei", "drei"])
GUI_SET_COLOR(lb, "bg", &H000000)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
    IF bild = 7 THEN SAVESCREENSHOT("mitte.png")
WEND
--- datei ev.txt
c 2
e 0 7 5 215 0 0
e 2 7 150 42 0 0

--- umgebung
DHRT_FRAMES=25
--- bild mitte.png
250 42 nicht #161616 +-3
250 42 nicht #000000 +-3
