=== map methods (1)
DIM m AS MAP OF STRING
m.put("name", "Alice")
m.put("city", "Berlin")
PRINT m.size()
PRINT m.has("name")
PRINT m.get("name")
PRINT m.has("unknown")
m.remove("name")
PRINT m.size()
m.clear()
PRINT m.size()
--- erwartet
2
TRUE
Alice
FALSE
1
0

=== map methods (2)
DIM m AS MAP OF STRING
m.put("name", "Alice")
m.put("city", "Berlin")
PRINT m.size()
PRINT m.has("name")
PRINT m.get("name")
PRINT m.has("unknown")
m.remove("name")
PRINT m.size()
m.clear()
