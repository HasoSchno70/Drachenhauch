' Kapitel 33 -- der Vokabeltrainer.
' Listen aus dem Netz oder selbst getippt, ein Karteikasten, der
' entscheidet, was drankommt, und fuenf Arten zu fragen.

IMPORT "gui"
IMPORT "db"
IMPORT "html"

CONST VERSTECKT = 99
CONST VORSTELLEN = 0
CONST WAHL_DE = 1
CONST WAHL_FREMD = 2
CONST TIPP_DE = 3
CONST TIPP_FREMD = 4

FUNCTION wartezeit(f AS INTEGER) AS INTEGER
    IF f <= 1 THEN RETURN 3
    IF f = 2 THEN RETURN 8
    IF f = 3 THEN RETURN 20
    IF f = 4 THEN RETURN 50
    RETURN 120
END FUNCTION

FUNCTION muster_zu(fach AS INTEGER, gesehen AS INTEGER) AS INTEGER
    IF gesehen = 0 THEN RETURN VORSTELLEN
    IF fach <= 1 THEN RETURN WAHL_DE
    IF fach = 2 THEN RETURN WAHL_FREMD
    IF fach = 3 THEN RETURN TIPP_DE
    RETURN TIPP_FREMD
END FUNCTION

FUNCTION ohne_artikel(s AS STRING) AS STRING
    DIM t AS STRING
    DIM a AS STRING
    t = TRIM$(LOWER$(s))
    FOR EACH a IN SPLIT$("to |the |a |an |la |le |les |l'|" + _
                         "el |los |las |der |die |das ", "|")
        IF LEFT$(t, LEN(a)) = a THEN RETURN TRIM$(MID$(t, LEN(a)))
    NEXT
    RETURN t
END FUNCTION

FUNCTION abstand(a AS STRING, b AS STRING) AS INTEGER
    DIM zeile[0] AS INTEGER
    DIM n AS INTEGER
    DIM m AS INTEGER
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM kosten AS INTEGER
    DIM oben AS INTEGER
    DIM schraeg AS INTEGER
    n = LEN(a)
    m = LEN(b)
    REDIM(zeile, m + 1)
    FOR j = 0 TO m
        zeile[j] = j
    NEXT
    FOR i = 1 TO n
        schraeg = zeile[0]
        zeile[0] = i
        FOR j = 1 TO m
            oben = zeile[j]
            kosten = 1
            IF MID$(a, i - 1, 1) = MID$(b, j - 1, 1) THEN kosten = 0
            zeile[j] = MIN(MIN(oben + 1, zeile[j - 1] + 1), _
                           schraeg + kosten)
            schraeg = oben
        NEXT
    NEXT
    RETURN zeile[m]
END FUNCTION

FUNCTION schrift_holen(groesse AS INTEGER) AS INTEGER
    DIM p AS STRING
    FOR EACH p IN SPLIT$("C:/Windows/Fonts/segoeui.ttf|" + _
                         "/System/Library/Fonts/Supplemental/" + _
                         "Arial.ttf|/usr/share/fonts/truetype/" + _
                         "dejavu/DejaVuSans.ttf", "|")
        IF FILEEXISTS(p) THEN RETURN LOADFONT(p, groesse)
    NEXT
    RETURN -1
END FUNCTION

FUNCTION mehrzahl(n AS INTEGER, eins AS STRING, _
                  viele AS STRING) AS STRING
    IF n = 1 THEN RETURN STR$(n) + " " + eins
    RETURN STR$(n) + " " + viele
END FUNCTION

SUB tabellen_anlegen(con AS DB_CONN)
    DB_EXEC(con, "CREATE TABLE IF NOT EXISTS listen (" + _
                 "id INTEGER PRIMARY KEY, name TEXT, sprache TEXT)")
    DB_EXEC(con, "CREATE TABLE IF NOT EXISTS vokabeln (" + _
                 "id INTEGER PRIMARY KEY, liste INTEGER, de TEXT, " + _
                 "fremd TEXT, fach INTEGER DEFAULT 1, " + _
                 "faellig INTEGER DEFAULT 0, " + _
                 "gesehen INTEGER DEFAULT 0, " + _
                 "richtig INTEGER DEFAULT 0, falsch INTEGER DEFAULT 0)")
    DB_EXEC(con, "CREATE TABLE IF NOT EXISTS stand (" + _
                 "schluessel TEXT PRIMARY KEY, wert INTEGER)")
    DB_EXEC(con, "INSERT OR IGNORE INTO stand VALUES ('runde', 0)")
END SUB

FUNCTION liste_anlegen(con AS DB_CONN, name AS STRING, _
                       sprache AS STRING) AS INTEGER
    DIM erg AS DB_RESULT
    DIM id AS INTEGER
    erg = DB_QUERY(con, "SELECT id FROM listen WHERE name = ?", name)
    IF DB_NEXT(erg) THEN
        id = DB_GET_INT(erg, 0)
        DB_CLOSE_RESULT(erg)
        RETURN id
    END IF
    DB_CLOSE_RESULT(erg)
    DB_EXEC(con, "INSERT INTO listen (name, sprache) VALUES (?, ?)", _
            name, sprache)
    erg = DB_QUERY(con, "SELECT last_insert_rowid()")
    DB_NEXT(erg)
    id = DB_GET_INT(erg, 0)
    DB_CLOSE_RESULT(erg)
    RETURN id
END FUNCTION

SUB text_einlesen(con AS DB_CONN, liste AS INTEGER, _
                  zeilen AS ARRAY OF STRING)
    DIM roh AS STRING
    DIM z AS STRING
    DIM t AS ARRAY OF STRING
    DB_BEGIN(con)
    FOR EACH roh IN zeilen
        z = TRIM$(roh)
        IF z <> "" AND LEFT$(z, 1) <> "#" THEN
            t = SPLIT$(z, ";")
            IF LEN(t) >= 2 THEN
                DB_EXEC(con, "INSERT INTO vokabeln (liste, de, " + _
                             "fremd) VALUES (?, ?, ?)", liste, _
                        TRIM$(t[0]), TRIM$(t[1]))
            END IF
        END IF
    NEXT
    DB_COMMIT(con)
END SUB

FUNCTION kopfzeile(zeilen AS ARRAY OF STRING, feld AS STRING) AS STRING
    DIM roh AS STRING
    DIM marke AS STRING
    marke = "# " + feld + ":"
    FOR EACH roh IN zeilen
        IF LEFT$(TRIM$(roh), LEN(marke)) = marke THEN
            RETURN TRIM$(MID$(TRIM$(roh), LEN(marke)))
        END IF
    NEXT
    RETURN ""
END FUNCTION

SCREEN(640, 400, "Vokabeltrainer")

DIM con AS DB_CONN
DIM erg AS DB_RESULT
DIM fenster AS GUI_WINDOW
DIM reiter[4] AS STRING
DIM w_frage AS GUI_WIDGET
DIM w_a[4] AS GUI_WIDGET
DIM w_tipp AS GUI_WIDGET
DIM w_ok AS GUI_WIDGET
DIM w_urteil AS GUI_WIDGET
DIM w_weiter AS GUI_WIDGET
DIM w_kasten AS GUI_WIDGET
DIM w_liste AS GUI_WIDGET
DIM w_name AS GUI_WIDGET
DIM w_neu AS GUI_WIDGET
DIM w_de AS GUI_WIDGET
DIM w_fremd AS GUI_WIDGET
DIM w_dazu AS GUI_WIDGET
DIM w_weg AS GUI_WIDGET
DIM w_box AS GUI_WIDGET
DIM w_stand AS GUI_WIDGET
DIM w_katalog AS GUI_WIDGET
DIM w_holen AS GUI_WIDGET
DIM w_netz AS GUI_WIDGET
DIM w_balken[6] AS GUI_WIDGET
DIM w_summe AS GUI_WIDGET
DIM listen_id[0] AS INTEGER
DIM listen_name[0] AS STRING
DIM vok_id[0] AS INTEGER
DIM zeilen[0] AS STRING
DIM dateien[0] AS STRING
DIM namen[0] AS STRING
DIM teile AS ARRAY OF STRING
DIM antworten[4] AS STRING
DIM basis AS STRING
DIM schrift AS INTEGER
DIM abruf AS INTEGER
DIM aktuell AS INTEGER
DIM runde AS INTEGER
DIM v_id AS INTEGER
DIM v_de AS STRING
DIM v_fremd AS STRING
DIM v_fach AS INTEGER
DIM v_gesehen AS INTEGER
DIM muster AS INTEGER
DIM stimmt AS INTEGER
DIM geantwortet AS BOOLEAN
DIM korrekt AS BOOLEAN
DIM neu_listen AS BOOLEAN
DIM neu_vokabeln AS BOOLEAN
DIM neu_frage AS BOOLEAN
DIM jubel AS SOUND
DIM brumm AS SOUND
DIM txt AS STRING
DIM i AS INTEGER
DIM d AS INTEGER

basis = "https://raw.githubusercontent.com/HasoSchno70/" + _
        "Drachenhauch/main/buch-einstieg/vokabellisten/"
HTTP_TIMEOUT(8)
schrift = schrift_holen(20)
IF schrift >= 0 THEN SETFONT(schrift)
jubel = AUDIO_TONE(880, 90, "square", 0.3)
brumm = AUDIO_TONE(160, 180, "saw", 0.3)

con = DB_OPEN("trainer.db")
tabellen_anlegen(con)
erg = DB_QUERY(con, "SELECT wert FROM stand WHERE schluessel='runde'")
IF DB_NEXT(erg) THEN runde = DB_GET_INT(erg, 0)
DB_CLOSE_RESULT(erg)

' Beim allerersten Start eine Liste anlegen -- ein leeres Fenster
' sagt niemandem, wofuer es gut ist.
erg = DB_QUERY(con, "SELECT COUNT(*) FROM listen")
DB_NEXT(erg)
i = DB_GET_INT(erg, 0)
DB_CLOSE_RESULT(erg)
IF i = 0 AND FILEEXISTS("englisch_grund.txt") THEN
    zeilen = READLINES("englisch_grund.txt")
    text_einlesen(con, liste_anlegen(con, kopfzeile(zeilen, "name"), _
                  kopfzeile(zeilen, "sprache")), zeilen)
END IF

TRY
    zeilen = SPLIT$(HTTP_GET(basis + "katalog.txt"), CHR$(10))
CATCH e
    zeilen = READLINES("katalog.txt")
END TRY
FOR EACH txt IN zeilen
    IF TRIM$(txt) <> "" AND LEFT$(TRIM$(txt), 1) <> "#" THEN
        teile = SPLIT$(TRIM$(txt), ";")
        IF LEN(teile) >= 2 THEN
            ARRAY_PUSH(dateien, TRIM$(teile[0]))
            ARRAY_PUSH(namen, TRIM$(teile[1]))
        END IF
    END IF
NEXT

reiter[0] = "Lernen"
reiter[1] = "Vokabeln"
reiter[2] = "Aus dem Netz"
reiter[3] = "Fortschritt"

fenster = GUI_WINDOW("Vokabeltrainer", 20, 12, 600, 376)
GUI_TABS(fenster, reiter)

w_frage = GUI_LABEL(fenster, "", 16, 40)
FOR i = 0 TO 3
    w_a[i] = GUI_BUTTON(fenster, "", 16, 76 + i * 40, 560, 34)
    GUI_SET_TAB(w_a[i], VERSTECKT)
NEXT
w_tipp = GUI_TEXTINPUT(fenster, 16, 76, 400, 34, "Antwort")
w_ok = GUI_BUTTON(fenster, "Pruefen", 426, 76, 150, 34)
w_urteil = GUI_LABEL(fenster, "", 16, 140)
w_weiter = GUI_BUTTON(fenster, "Weiter", 16, 180, 150, 34)
w_kasten = GUI_LABEL(fenster, "", 16, 290)
GUI_SET_TAB(w_frage, 0)
GUI_SET_TAB(w_tipp, VERSTECKT)
GUI_SET_TAB(w_ok, VERSTECKT)
GUI_SET_TAB(w_urteil, 0)
GUI_SET_TAB(w_weiter, VERSTECKT)
GUI_SET_TAB(w_kasten, 0)

w_liste = GUI_DROPDOWN(fenster, 16, 42, 250, 28, listen_name)
w_name = GUI_TEXTINPUT(fenster, 276, 42, 180, 28, "neue Liste")
w_neu = GUI_BUTTON(fenster, "Anlegen", 466, 42, 110, 28)
w_de = GUI_TEXTINPUT(fenster, 16, 82, 180, 28, "deutsch")
w_fremd = GUI_TEXTINPUT(fenster, 206, 82, 180, 28, "fremd")
w_dazu = GUI_BUTTON(fenster, "Dazu", 396, 82, 84, 28)
w_weg = GUI_BUTTON(fenster, "Weg", 490, 82, 86, 28)
w_box = GUI_LISTBOX(fenster, 16, 122, 560, 150, zeilen)
w_stand = GUI_LABEL(fenster, "", 16, 284)
GUI_SET_TAB(w_liste, 1)
GUI_SET_TAB(w_name, 1)
GUI_SET_TAB(w_neu, 1)
GUI_SET_TAB(w_de, 1)
GUI_SET_TAB(w_fremd, 1)
GUI_SET_TAB(w_dazu, 1)
GUI_SET_TAB(w_weg, 1)
GUI_SET_TAB(w_box, 1)
GUI_SET_TAB(w_stand, 1)

w_katalog = GUI_DROPDOWN(fenster, 16, 42, 380, 28, namen)
w_holen = GUI_BUTTON(fenster, "Holen", 406, 42, 170, 28)
w_netz = GUI_LABEL(fenster, "Die Listen liegen im Netz.", 16, 96)
GUI_SET_TAB(w_katalog, 2)
GUI_SET_TAB(w_holen, 2)
GUI_SET_TAB(w_netz, 2)

FOR i = 1 TO 5
    GUI_SET_TAB(GUI_LABEL(fenster, "Fach " + STR$(i), 16, _
                          28 + i * 34), 3)
    w_balken[i] = GUI_PROGRESS(fenster, 110, 30 + i * 34, 380, 20)
    GUI_SET_TAB(w_balken[i], 3)
NEXT
w_summe = GUI_LABEL(fenster, "", 16, 228)
GUI_SET_TAB(w_summe, 3)

abruf = -1
aktuell = -1
v_id = -1
neu_listen = TRUE

' Auf dem Reiter starten, wo es etwas zu tun gibt.
erg = DB_QUERY(con, "SELECT COUNT(*) FROM listen")
DB_NEXT(erg)
IF DB_GET_INT(erg, 0) = 0 THEN GUI_SET_ACTIVE_TAB(fenster, 2)
DB_CLOSE_RESULT(erg)

WHILE NOT QUITREQUESTED() AND NOT KEYPRESSED(KEY_ESCAPE)

    IF neu_listen THEN
        neu_listen = FALSE
        REDIM(listen_id, 0)
        REDIM(listen_name, 0)
        erg = DB_QUERY(con, "SELECT id, name FROM listen ORDER BY name")
        WHILE DB_NEXT(erg)
            ARRAY_PUSH(listen_id, DB_GET_INT(erg, 0))
            ARRAY_PUSH(listen_name, DB_GET_STRING(erg, 1))
        WEND
        DB_CLOSE_RESULT(erg)
        GUI_SET_DROPDOWN(w_liste, listen_name)
        aktuell = -1
        IF LEN(listen_id) > 0 THEN
            i = GUI_DROPDOWN_SELECTED(w_liste)
            IF i < 0 OR i >= LEN(listen_id) THEN
                i = 0
                GUI_DROPDOWN_SET_SELECTED(w_liste, 0)
            END IF
            aktuell = listen_id[i]
        END IF
        neu_vokabeln = TRUE
        neu_frage = TRUE
    END IF

    IF neu_vokabeln THEN
        neu_vokabeln = FALSE
        REDIM(vok_id, 0)
        REDIM(zeilen, 0)
        IF aktuell >= 0 THEN
            erg = DB_QUERY(con, "SELECT id, de, fremd FROM " + _
                                "vokabeln WHERE liste = ? " + _
                                "ORDER BY de", aktuell)
            WHILE DB_NEXT(erg)
                ARRAY_PUSH(vok_id, DB_GET_INT(erg, 0))
                ARRAY_PUSH(zeilen, DB_GET_STRING(erg, 1) + _
                                   "   ->   " + DB_GET_STRING(erg, 2))
            WEND
            DB_CLOSE_RESULT(erg)
        END IF
        GUI_SET_LISTBOX(w_box, zeilen)
        GUI_SET_TEXT(w_stand, mehrzahl(LEN(zeilen), "Vokabel", _
                              "Vokabeln") + " in " + _
                              mehrzahl(LEN(listen_name), _
                              "Liste", "Listen"))

        FOR i = 1 TO 5
            GUI_SET_VALUE(w_balken[i], 0.0)
        NEXT
        IF LEN(vok_id) > 0 THEN
            erg = DB_QUERY(con, "SELECT fach, COUNT(*) FROM " + _
                                "vokabeln WHERE liste = ? " + _
                                "GROUP BY fach", aktuell)
            WHILE DB_NEXT(erg)
                GUI_SET_VALUE(w_balken[DB_GET_INT(erg, 0)], _
                              DB_GET_INT(erg, 1) * 1.0 / LEN(vok_id))
            WEND
            DB_CLOSE_RESULT(erg)
        END IF
        erg = DB_QUERY(con, "SELECT SUM(richtig), SUM(falsch) FROM " + _
                            "vokabeln WHERE liste = ?", aktuell)
        i = 0
        d = 0
        IF DB_NEXT(erg) THEN
            i = DB_GET_INT(erg, 0)
            d = DB_GET_INT(erg, 1)
        END IF
        DB_CLOSE_RESULT(erg)
        txt = mehrzahl(i + d, "Antwort", "Antworten")
        IF i + d > 0 THEN
            txt = txt + ", " + STR$(INT(i * 100.0 / (i + d))) + _
                  "% richtig"
        END IF
        GUI_SET_TEXT(w_summe, txt)
    END IF

    IF neu_frage THEN
        neu_frage = FALSE
        geantwortet = FALSE
        v_id = -1
        GUI_SET_TEXT(w_urteil, "")
        GUI_SET_TEXT(w_tipp, "")
        FOR i = 0 TO 3
            GUI_SET_TAB(w_a[i], VERSTECKT)
        NEXT
        GUI_SET_TAB(w_tipp, VERSTECKT)
        GUI_SET_TAB(w_ok, VERSTECKT)
        GUI_SET_TAB(w_weiter, VERSTECKT)

        IF aktuell >= 0 THEN
            erg = DB_QUERY(con, "SELECT id, de, fremd, fach, " + _
                                "gesehen FROM vokabeln " + _
                                "WHERE liste = ? AND faellig <= ? " + _
                                "ORDER BY faellig, fach, RANDOM() " + _
                                "LIMIT 1", aktuell, runde)
            IF DB_NEXT(erg) THEN
                v_id = DB_GET_INT(erg, 0)
                v_de = DB_GET_STRING(erg, 1)
                v_fremd = DB_GET_STRING(erg, 2)
                v_fach = DB_GET_INT(erg, 3)
                v_gesehen = DB_GET_INT(erg, 4)
            END IF
            DB_CLOSE_RESULT(erg)
        END IF

        IF v_id < 0 THEN
            IF aktuell < 0 THEN
                GUI_SET_TEXT(w_frage, "Noch keine Liste. Hol " + _
                                      "dir eine unter " + _
                                      "'Aus dem Netz'.")
            ELSE
                GUI_SET_TEXT(w_frage, "Alles wiederholt. Nimm " + _
                                      "eine andere Liste oder " + _
                                      "komm spaeter.")
            END IF
        ELSE
            muster = muster_zu(v_fach, v_gesehen)
            IF muster = VORSTELLEN THEN
                GUI_SET_TEXT(w_frage, v_de + "   =   " + v_fremd)
                GUI_SET_TEXT(w_urteil, "Neu. Praeg es dir ein.")
                GUI_SET_TAB(w_weiter, 0)
            ELSEIF muster = TIPP_DE OR muster = TIPP_FREMD THEN
                IF muster = TIPP_DE THEN
                    GUI_SET_TEXT(w_frage, "Tippe die " + _
                                          "Uebersetzung: " + v_de)
                ELSE
                    GUI_SET_TEXT(w_frage, "Was heisst " + v_fremd + "?")
                END IF
                GUI_SET_TAB(w_tipp, 0)
                GUI_SET_TAB(w_ok, 0)
            ELSE
                antworten[0] = v_fremd
                IF muster = WAHL_FREMD THEN antworten[0] = v_de
                i = 1
                erg = DB_QUERY(con, "SELECT de, fremd FROM " + _
                                    "vokabeln WHERE liste = ? " + _
                                    "AND id <> ? " + _
                                    "ORDER BY RANDOM() LIMIT 3", _
                               aktuell, v_id)
                WHILE DB_NEXT(erg) AND i < 4
                    IF muster = WAHL_FREMD THEN
                        antworten[i] = DB_GET_STRING(erg, 0)
                    ELSE
                        antworten[i] = DB_GET_STRING(erg, 1)
                    END IF
                    i = i + 1
                WEND
                DB_CLOSE_RESULT(erg)
                stimmt = INT(RND() * i)
                txt = antworten[stimmt]
                antworten[stimmt] = antworten[0]
                antworten[0] = txt
                IF muster = WAHL_FREMD THEN
                    GUI_SET_TEXT(w_frage, "Was heisst " + v_fremd + "?")
                ELSE
                    GUI_SET_TEXT(w_frage, "Was heisst " + v_de + "?")
                END IF
                FOR i = 0 TO 3
                    GUI_SET_TEXT(w_a[i], antworten[i])
                    IF antworten[i] <> "" THEN GUI_SET_TAB(w_a[i], 0)
                NEXT
            END IF
        END IF
    END IF

    CLS(RGB(28, 32, 50))
    GUI_UPDATE()

    IF v_id >= 0 AND NOT geantwortet THEN
        d = -1
        FOR i = 0 TO 3
            IF GUI_CLICKED(w_a[i]) THEN d = i
        NEXT
        IF d >= 0 THEN
            geantwortet = TRUE
            korrekt = (d = stimmt)
            IF korrekt THEN
                GUI_SET_TEXT(w_urteil, "richtig")
            ELSE
                GUI_SET_TEXT(w_urteil, "nein -- " + antworten[stimmt])
            END IF
        END IF

        IF muster = TIPP_DE OR muster = TIPP_FREMD THEN
            IF GUI_CLICKED(w_ok) OR KEYPRESSED(KEY_ENTER) THEN
                txt = v_fremd
                IF muster = TIPP_FREMD THEN txt = v_de
                d = abstand(ohne_artikel(GUI_TEXT(w_tipp)), _
                            ohne_artikel(txt))
                IF TRIM$(GUI_TEXT(w_tipp)) <> "" THEN
                    geantwortet = TRUE
                    korrekt = (d <= 1)
                    IF d = 0 THEN
                        GUI_SET_TEXT(w_urteil, "richtig")
                    ELSEIF d = 1 THEN
                        GUI_SET_TEXT(w_urteil, "fast -- " + txt)
                    ELSE
                        GUI_SET_TEXT(w_urteil, "nein -- " + txt)
                    END IF
                END IF
            END IF
        END IF

        IF geantwortet THEN
            runde = runde + 1
            IF korrekt THEN
                PLAYSOUND(jubel)
                v_fach = MIN(5, v_fach + 1)
                DB_EXEC(con, "UPDATE vokabeln SET fach = ?, " + _
                             "faellig = ?, gesehen = gesehen + 1, " + _
                             "richtig = richtig + 1 WHERE id = ?", _
                        v_fach, runde + wartezeit(v_fach), v_id)
            ELSE
                PLAYSOUND(brumm)
                DB_EXEC(con, "UPDATE vokabeln SET fach = 1, " + _
                             "faellig = ?, gesehen = gesehen + 1, " + _
                             "falsch = falsch + 1 WHERE id = ?", _
                        runde + wartezeit(1), v_id)
            END IF
            DB_EXEC(con, "UPDATE stand SET wert = ? WHERE " + _
                         "schluessel = 'runde'", runde)
            FOR i = 0 TO 3
                GUI_SET_TAB(w_a[i], VERSTECKT)
            NEXT
            GUI_SET_TAB(w_tipp, VERSTECKT)
            GUI_SET_TAB(w_ok, VERSTECKT)
            GUI_SET_TAB(w_weiter, 0)
            neu_vokabeln = TRUE
        END IF
    END IF

    IF GUI_CLICKED(w_weiter) THEN
        IF v_id >= 0 AND muster = VORSTELLEN AND NOT geantwortet THEN
            runde = runde + 1
            DB_EXEC(con, "UPDATE vokabeln SET faellig = ?, " + _
                         "gesehen = gesehen + 1 WHERE id = ?", _
                    runde + wartezeit(1), v_id)
            DB_EXEC(con, "UPDATE stand SET wert = ? WHERE " + _
                         "schluessel = 'runde'", runde)
            neu_vokabeln = TRUE
        END IF
        neu_frage = TRUE
    END IF

    i = GUI_DROPDOWN_SELECTED(w_liste)
    IF i >= 0 AND i < LEN(listen_id) AND listen_id[i] <> aktuell THEN
        aktuell = listen_id[i]
        neu_vokabeln = TRUE
        neu_frage = TRUE
    END IF

    IF GUI_CLICKED(w_neu) THEN
        txt = TRIM$(GUI_TEXT(w_name))
        IF txt <> "" THEN
            liste_anlegen(con, txt, "eigene")
            GUI_SET_TEXT(w_name, "")
            neu_listen = TRUE
        END IF
    END IF

    IF GUI_CLICKED(w_dazu) AND aktuell >= 0 THEN
        txt = TRIM$(GUI_TEXT(w_de))
        IF txt <> "" AND TRIM$(GUI_TEXT(w_fremd)) <> "" THEN
            DB_EXEC(con, "INSERT INTO vokabeln (liste, de, fremd) " + _
                         "VALUES (?, ?, ?)", aktuell, txt, _
                    TRIM$(GUI_TEXT(w_fremd)))
            GUI_SET_TEXT(w_de, "")
            GUI_SET_TEXT(w_fremd, "")
            neu_vokabeln = TRUE
        END IF
    END IF

    IF GUI_CLICKED(w_weg) THEN
        i = GUI_LISTBOX_SELECTED(w_box)
        IF i >= 0 AND i < LEN(vok_id) THEN
            DB_EXEC(con, "DELETE FROM vokabeln WHERE id = ?", vok_id[i])
            neu_vokabeln = TRUE
            neu_frage = TRUE
        END IF
    END IF

    IF GUI_CLICKED(w_holen) AND abruf < 0 THEN
        i = GUI_DROPDOWN_SELECTED(w_katalog)
        IF i >= 0 THEN
            abruf = HTTP_GET_START(basis + dateien[i])
            GUI_SET_TEXT(w_netz, "hole " + dateien[i] + " ...")
        END IF
    END IF

    IF abruf >= 0 AND HTTP_READY(abruf) THEN
        i = GUI_DROPDOWN_SELECTED(w_katalog)
        TRY
            zeilen = SPLIT$(HTTP_RESULT(abruf), CHR$(10))
            GUI_SET_TEXT(w_netz, "aus dem Netz: " + namen[i])
        CATCH e
            zeilen = READLINES(dateien[i])
            GUI_SET_TEXT(w_netz, "von der Platte, Netz sagte " + _
                                 STR$(HTTP_STATUS()))
        END TRY
        txt = kopfzeile(zeilen, "name")
        IF txt = "" THEN txt = namen[i]
        text_einlesen(con, liste_anlegen(con, txt, _
                      kopfzeile(zeilen, "sprache")), zeilen)
        abruf = -1
        neu_listen = TRUE
        GUI_SET_ACTIVE_TAB(fenster, 0)
    END IF

    GUI_SET_TEXT(w_kasten, "Runde " + STR$(runde))
    GUI_DRAW()
    FLIP()
WEND

DB_CLOSE(con)
