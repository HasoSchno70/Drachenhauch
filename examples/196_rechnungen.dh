reiter(lKNotiz, 0) : reiter(tfKNotiz, 0)
GUI_LAYOUT_ADD(fK, lKNotiz) : GUI_LAYOUT_ADD(fK, tfKNotiz)
' Datenbindung: jedes Feld traegt seinen Spaltennamen. Laden, Speichern und
' "geaendert?" laufen ueber das Formular "kunde" -- keine Spaltenliste mehr.
GUI_BIND(tfKName, "name", "kunde") : GUI_BIND(tfKStr, "strasse", "kunde") : GUI_BIND(tfKPlz, "plz", "kunde")
GUI_BIND(tfKOrt, "ort", "kunde") : GUI_BIND(tfKMail, "email", "kunde") : GUI_BIND(tfKNotiz, "notiz", "kunde")
DIM lKFehler AS GUI_WIDGET : lKFehler = GUI_LABEL(win, "", 0, 0)
GUI_SET_COLOR(lKFehler, "fg", ROT) : GUI_SET_WRAP(lKFehler, formW)
reiter(lKFehler, 0) : GUI_LAYOUT_ADD(fK, lKFehler)
' Die Pruefung haengt an den Feldern; kundeSpeichern ruft nur GUI_VALIDATE.
GUI_RULE(tfKName, "pflicht", "Der Name fehlt.")
GUI_RULE(tfKName, "laenge", 2, 80)
GUI_RULE(tfKPlz, "muster", "[0-9]{5}", "Eine Postleitzahl hat fuenf Ziffern.")
GUI_RULE(tfKMail, "email", "Das sieht nicht nach einer E-Mail-Adresse aus.")
GUI_ERROR_LABEL(tfKName, lKFehler) : GUI_ERROR_LABEL(tfKPlz, lKFehler) : GUI_ERROR_LABEL(tfKMail, lKFehler)
DIM kK AS GUI_WIDGET : kK = GUI_LAYOUT(win, "zeile", 0, 0, 10, 30)
reiter(kK, 0)
DIM bKNeu AS GUI_WIDGET : bKNeu = GUI_BUTTON(win, "Neu", 0, 0, 0, 0)
DIM bKSpeichern AS GUI_WIDGET : bKSpeichern = GUI_BUTTON(win, "Speichern", 0, 0, 0, 0)
DIM bKLoeschen AS GUI_WIDGET : bKLoeschen = GUI_BUTTON(win, "Loeschen", 0, 0, 0, 0)
reiter(bKNeu, 0) : reiter(bKSpeichern, 0) : reiter(bKLoeschen, 0)
GUI_LAYOUT_ADD(kK, bKNeu) : GUI_LAYOUT_SPACER(kK) : GUI_LAYOUT_ADD(kK, bKSpeichern) : GUI_LAYOUT_ADD(kK, bKLoeschen)
GUI_LAYOUT_ADD(fK, kK)

DIM kundeId AS INTEGER : kundeId = -1          ' -1 = neuer Kunde
DIM kZeileAlt AS INTEGER : kZeileAlt = -1

SUB kundenLaden()
    GUI_TABLE_CLEAR(tKunden)
    kundenAnz = 0
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT id, name, ort, email FROM kunden ORDER BY name")
    WHILE DB_NEXT(r)
        IF kundenAnz >= MAXZ THEN BREAK
        GUI_TABLE_ADD_ROW(tKunden, [DB_GET_STRING(r, 1), DB_GET_STRING(r, 2), DB_GET_STRING(r, 3)])
        kundenId[kundenAnz] = DB_GET_INT(r, 0)
        kundenAnz = kundenAnz + 1
    WEND
    DB_CLOSE_RESULT(r)
END SUB

SUB kundeZeigen(id AS INTEGER)
    kundeId = id
    GUI_CLEAR_ERRORS(win)
    IF id < 0 THEN
        GUI_FORM_CLEAR(win, "kunde")
        GUI_SET_TEXT(lKTitel, "Neuer Kunde")
    ELSE
        IF NOT GUI_FORM_LOAD(win, db, "kunden", id, "kunde") THEN fehler("Kunde #" + STR$(id) + " gibt es nicht mehr.")
        GUI_SET_TEXT(lKTitel, "Kunde #" + STR$(id))
    END IF
END SUB

' Zeile der Tabelle, die eine id traegt (oder -1).
FUNCTION zeileVonId(ids AS ARRAY OF INTEGER, anz AS INTEGER, id AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO anz - 1
        IF ids[i] = id THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION kundeSpeichern() AS BOOLEAN
    ' GUI_VALIDATE prueft nur die Felder des aktiven Reiters -- die anderen
    ' sind nicht sichtbar und zaehlen nicht. Genau richtig hier.
    IF GUI_VALIDATE(win) > 0 THEN RETURN FALSE
    DIM name AS STRING : name = TRIM$(GUI_TEXT(tfKName))
    ' INSERT oder UPDATE, je nach id -- die Spalten kennt das Formular.
    kundeId = GUI_FORM_SAVE(win, db, "kunden", kundeId, "kunde")
    kundenLaden()
    kZeileAlt = zeileVonId(kundenId, kundenAnz, kundeId)
    GUI_TABLE_SET_SELECTED(tKunden, kZeileAlt)
    kundeZeigen(kundeId)
    status("Kunde gespeichert: " + name)
    RETURN TRUE
END FUNCTION

