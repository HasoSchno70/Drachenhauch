e 4 1 86 0 0 0
e 4 1 341 0 0 0

--- umgebung
DHRT_FRAMES=16
--- erwartet
6 5.0
12 -50.0

=== esc holt den wert von vorher zurueck
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM sp AS GUI_WIDGET
sp = GUI_SPINNER(w, 10, 10, 120, 0, 100, 5, 1)
DIM ab AS GUI_WIDGET
ab = GUI_BUTTON(w, "Abbrechen", 10, 60, 100, 26)
GUI_WINDOW_CANCEL(w, ab)
GUI_FOCUS(sp)
CLIPBOARD_SET("33")
DIM f AS INTEGER
FOR f = 1 TO 14
    GUI_UPDATE()
    IF GUI_CLICKED(ab) THEN PRINT f; " abbrechen gedrueckt"
    IF f = 6 OR f = 12 THEN PRINT f; " "; GUI_VALUE(sp)
    GUI_DRAW()
    FLIP()
NEXT
