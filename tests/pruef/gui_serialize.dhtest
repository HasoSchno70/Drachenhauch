' Aus test_gui_serialize.py uebertragen (33 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== string roundtrip structure
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("Login", 100, 80, 300, 200)
GUI_WINDOW_CLOSABLE(win, TRUE)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(win, "Anmelden", 20, 120, 120, 30)
DIM c AS GUI_WIDGET
c = GUI_CHECKBOX(win, "Merken", 20, 80)
GUI_SET_CHECKED(c, TRUE)
DIM s AS GUI_WIDGET
s = GUI_SLIDER(win, 20, 160, 200, 0, 100)
GUI_SET_VALUE(s, 42)
DIM js AS STRING
js = GUI_TO_JSON(win)
DIM w2 AS GUI_WINDOW
w2 = GUI_FROM_JSON(js)
PRINT GUI_WINDOW_WIDGET_COUNT(w2)
PRINT f"{GUI_WINDOW_GET_X(w2)},{GUI_WINDOW_GET_W(w2)}"
DIM w0 AS GUI_WIDGET
w0 = GUI_WINDOW_WIDGET(w2, 0)
PRINT f"{GUI_KIND(w0)} {GUI_GET_X(w0)},{GUI_GET_Y(w0)},{GUI_GET_W(w0)},{GUI_GET_H(w0)}"
--- erwartet
3
100,300
button 20,120,120,30

=== roundtrip preserves state
IMPORT "gui"
DIM win AS GUI_WINDOW
win = GUI_WINDOW("Login", 100, 80, 300, 200)
GUI_WINDOW_CLOSABLE(win, TRUE)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(win, "Anmelden", 20, 120, 120, 30)
DIM c AS GUI_WIDGET
c = GUI_CHECKBOX(win, "Merken", 20, 80)
GUI_SET_CHECKED(c, TRUE)
DIM s AS GUI_WIDGET
s = GUI_SLIDER(win, 20, 160, 200, 0, 100)
GUI_SET_VALUE(s, 42)
DIM w2 AS GUI_WINDOW
w2 = GUI_FROM_JSON(GUI_TO_JSON(win))
PRINT GUI_CHECKED(GUI_WINDOW_WIDGET(w2, 1))
PRINT GUI_VALUE(GUI_WINDOW_WIDGET(w2, 2))
--- erwartet
TRUE
42.0

=== roundtrip skips destroyed
