' GTK 3, GDK, Cairo, Pango und GLib fuer Glutfaden -- nur die Teile, die das
' Programm braucht. Je System ein Bibliotheksname, durch | getrennt; der erste,
' der laedt, gilt (unter Windows das GTK von Inkscape, wenn keins im PATH ist).
CONST GTK = "libgtk-3-0.dll|C:/Program Files/Inkscape/bin/libgtk-3-0.dll|libgtk-3.so.0|libgtk-3.0.dylib|/opt/homebrew/lib/libgtk-3.0.dylib"
CONST GDK = "libgdk-3-0.dll|C:/Program Files/Inkscape/bin/libgdk-3-0.dll|libgdk-3.so.0|libgdk-3.0.dylib|/opt/homebrew/lib/libgdk-3.0.dylib"
CONST GOBJECT = "libgobject-2.0-0.dll|C:/Program Files/Inkscape/bin/libgobject-2.0-0.dll|libgobject-2.0.so.0|libgobject-2.0.0.dylib|/opt/homebrew/lib/libgobject-2.0.0.dylib"
CONST GLIB = "libglib-2.0-0.dll|C:/Program Files/Inkscape/bin/libglib-2.0-0.dll|libglib-2.0.so.0|libglib-2.0.0.dylib|/opt/homebrew/lib/libglib-2.0.0.dylib"
CONST CAIRO = "libcairo-2.dll|C:/Program Files/Inkscape/bin/libcairo-2.dll|libcairo.so.2|libcairo.2.dylib|/opt/homebrew/lib/libcairo.2.dylib"
CONST PANGO = "libpango-1.0-0.dll|C:/Program Files/Inkscape/bin/libpango-1.0-0.dll|libpango-1.0.so.0|libpango-1.0.0.dylib|/opt/homebrew/lib/libpango-1.0.0.dylib"
CONST PIXBUF = "libgdk_pixbuf-2.0-0.dll|C:/Program Files/Inkscape/bin/libgdk_pixbuf-2.0-0.dll|libgdk_pixbuf-2.0.so.0|libgdk_pixbuf-2.0.0.dylib|/opt/homebrew/lib/libgdk_pixbuf-2.0.0.dylib"
CONST PANGOCAIRO = "libpangocairo-1.0-0.dll|C:/Program Files/Inkscape/bin/libpangocairo-1.0-0.dll|libpangocairo-1.0.so.0|libpangocairo-1.0.0.dylib|/opt/homebrew/lib/libpangocairo-1.0.0.dylib"

