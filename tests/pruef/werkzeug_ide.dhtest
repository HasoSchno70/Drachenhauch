' Die IDE in Drachenhauch (ide/ide.dh), Staende 1 bis 5 -- ohne Python
' geprueft. Bis Stufe 34 standen diese Faelle in tests/test_ide.py; was dort
' bleibt, braucht zwei Laeufe hintereinander (Sitzung), ein git-Repository
' oder einen fremden PDF-Leser.
'
' Die IDE laeuft als Kopie in _programm/ (der Projektbaum uebergeht Ordner mit
' `_`), der Fallordner ist ihr Projekt. Aufnahme, Protokoll und Sitzung liegen
' in _programm/; ein Einschub hinter SETFPS(60) spielt die Aufnahme ab und
' legt, wo noetig, den Text in die Zwischenablage -- getippt wird mit Strg+V,
' weil die Wiedergabe keine Zeichen einspeist. Darum laufen die Faelle
' nacheinander. Gelesen wird danach mit `--- nachher`: das Protokoll
' zeilenweise (genau, nicht als Teiltext), gesicherte Dateien als |Zeile|.
' In der Aufnahme: 2 Taste runter, 1 hoch.
--- seriell

--- langsam
=== ide uebersetzt ohne befund
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", GETENV$("IDE_QUELLE"))
DIM bis AS INTEGER : bis = MILLIS() + 120000
DIM befund AS STRING : befund = ""
DIM stille AS INTEGER : stille = 0
WHILE MILLIS() < bis AND stille < 5
    DIM zz AS STRING : zz = PROCESS_READ$(pc)
    IF zz <> "" THEN befund = befund + zz : stille = 0
    IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
WEND
PRINT "check " + TRIM$(befund) ; " " ; PROCESS_CODE(pc)
--- umgebung
IDE_QUELLE={sammlung}/../../ide/ide.dh
--- erwartet
check [] 0

=== oeffnet datei und prueft
' Die Pruefung laeuft 0,6 s nach dem Oeffnen von selbst und findet den Fehler.
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=90
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT "hallo"
DIM x AS
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(z AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
PRINT "bereit " ; hat("bereit")
PRINT "geoeffnet " ; endet("geoeffnet ", "spiel.dh")
PRINT "geprueft 1 " ; hat("geprueft 1")
PRINT "ende zuletzt " ; L[LEN(L) - 1] = "ende"
--- erwartet
bereit TRUE
geoeffnet TRUE
geprueft 1 TRUE
ende zuletzt TRUE

=== relativer name meint den ort des nutzers
' `dhrt run` wechselt ins Verzeichnis der IDE; `spiel.dh` meint trotzdem die
' Datei dort, wo der Nutzer steht (DHRT_START_DIR), und der Projektbaum zeigt
' diesen Ordner -- nicht _programm/. Verglichen werden die letzten zwei
' Pfadteile: derselbe Ordner kommt einmal mit 8.3-Kurznamen (HANSGA~1) und
' einmal mit langem Namen an.
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=90
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT 1
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(z AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
PRINT "geoeffnet " ; endet("geoeffnet ", "spiel.dh")
DIM pj AS STRING : pj = MID$(erste$("projekt "), 8)
FUNCTION norm$(x AS STRING) AS STRING
    DIM y AS STRING : y = LOWER$(REPLACE$(x, "\", "/"))
    IF RIGHT$(y, 1) = "/" THEN y = LEFT$(y, LEN(y) - 1)
    DIM t AS ARRAY OF STRING : t = SPLIT$(y, "/")
    IF LEN(t) < 2 THEN RETURN y
    RETURN t[LEN(t) - 2] + "/" + t[LEN(t) - 1]
END FUNCTION
PRINT "projekt ist der fallordner " ; norm$(pj) = norm$(CWD$())
--- erwartet
geoeffnet TRUE
projekt ist der fallordner TRUE

