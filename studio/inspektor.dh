' ============================================================
'  Drachenhauch Studio -- der Inspektor
' ============================================================
'  Die Eigenschaften des gewaehlten Controls (oder des Fensters) in Gruppen,
'  die auf- und zuklappen, je Eigenschaft der passende Editor: Text, Zahl,
'  Schalter, Auswahl, Farbe (Farbwaehler im Popover), Anker. Alle Zeilen
'  gibt es einmal; welche zu sehen sind, haengt an der Art des Controls --
'  inspektorLegen schichtet die sichtbaren untereinander. Sie liegen in einem
'  rollenden Bereich der Leiste "inspektor".
'
'  Uebernommen wird sofort, das Entwurfsfenster folgt jedem Anschlag. Einen
'  Schritt fuer Rueckgaengig gibt es erst, wenn das Feld den Fokus abgibt
'  oder Enter kommt -- sonst waere "Knopf" in "Speichern" sieben Schritte.
' ============================================================

CLASS InspZeile
    DIM gruppe AS STRING
    DIM schluessel AS STRING
    DIM titel AS STRING
    DIM art AS STRING        ' text, zahl, komma, schalter, wahl, wahlindex, farbe, eintraege, info, anker, gewicht
    DIM fuer AS STRING       ' Arten, durch Komma; "*" = jedes Control, "fenster" = das Fenster
    DIM wahl AS STRING       ' Eintraege der Auswahl, durch Semikolon
    DIM lbl AS GUI_WIDGET
    DIM ed AS GUI_WIDGET
    DIM anker AS ARRAY OF GUI_WIDGET
    DIM sichtbar AS BOOLEAN
END CLASS

DIM inspZeilen AS ARRAY OF InspZeile : inspZeilen = []
DIM inspGruppen AS ARRAY OF STRING : inspGruppen = []
DIM inspKoepfe AS ARRAY OF GUI_WIDGET : inspKoepfe = []
DIM inspOffen AS MAP OF BOOLEAN
DIM inspPanel AS GUI_WIDGET
DIM inspTitel AS GUI_WIDGET
DIM inspArt AS GUI_WIDGET
DIM inspAnhaengig AS INTEGER : inspAnhaengig = -1    ' Zeile mit Aenderung ohne Rueckgaengig-Schritt
DIM inspStumm AS BOOLEAN : inspStumm = FALSE
' Farbe: ein Popover mit Farbwaehler, an die Zeile gehaengt.
DIM farbPop AS GUI_WINDOW
DIM farbWahl AS GUI_WIDGET
DIM farbVorgabe AS GUI_WIDGET
DIM farbZeile AS INTEGER : farbZeile = -1

CONST TEXTARTEN = "button,label,checkbox,radio,toggle,groupbox,card,richtext,statusbar,textinput,textarea"
CONST WERTARTEN = "slider,spinner,knob,progress"
CONST LISTENARTEN = "dropdown,listbox,tabcontrol,accordion,wizard"
' Was an eine Spalte gebunden werden kann (GUI_BIND), und was Zeilen zeigt.
CONST BINDARTEN = "textinput,textarea,checkbox,toggle,dropdown,spinner,slider,datepicker"
CONST QUELLARTEN = "table,listbox,dropdown"

SUB inspGruppe(name AS STRING)
    ARRAY_PUSH(inspGruppen, name)
    IF NOT MAPHAS(inspOffen, name) THEN MAPPUT(inspOffen, name, TRUE)
END SUB

SUB inspZeile(gruppe AS STRING, schluessel AS STRING, titel AS STRING, art AS STRING, fuer AS STRING, wahl AS STRING)
    DIM z AS InspZeile : z = NEW InspZeile()
    z.gruppe = gruppe : z.schluessel = schluessel : z.titel = titel
    z.art = art : z.fuer = fuer : z.wahl = wahl
    z.anker = []
    ARRAY_PUSH(inspZeilen, z)
END SUB

SUB inspektorAnlegen()
    inspPanel = GUI_PANEL(win, 0, 0, 10, 10)
    GUI_ADD_CLASS(inspPanel, "inspektor")
    GUI_DOCK_ADD(win, "inspektor", inspPanel)
    inspTitel = GUI_LABEL(win, "", 0, 0)
    GUI_ADD_CLASS(inspTitel, "insptitel")
    inspArt = GUI_LABEL(win, "", 0, 0)
    GUI_ADD_CLASS(inspArt, "leise")
    inspDazu(inspTitel)
    inspDazu(inspArt)

    inspGruppe("Fenster")
    inspZeile("Fenster", "name", "Name", "text", "fenster", "")
    inspZeile("Fenster", "title", "Titel", "text", "fenster", "")
    inspZeile("Fenster", "w", "Breite", "zahl", "fenster", "")
    inspZeile("Fenster", "h", "Höhe", "zahl", "fenster", "")
    inspZeile("Fenster", "resizable", "Größe änderbar", "schalter", "fenster", "")
    ' Welcher Knopf Enter bzw. Esc bekommt -- beim Namen, wie in Xojo.
    inspZeile("Fenster", "studio_standard", "Standard-Knopf (Enter)", "knopfwahl", "fenster", "")
    inspZeile("Fenster", "studio_abbrechen", "Abbrechen-Knopf (Esc)", "knopfwahl", "fenster", "")
    ' Ein eigenes Control legt fest, was es meldet und was eine Instanz
    ' einstellen kann; eine Instanz traegt ihre Werte (modell.dh).
    inspGruppe("Eigenes Control")
    inspZeile("Eigenes Control", "studio_ereignisse", "Ereignisse", "text", "fenster", "")
    inspZeile("Eigenes Control", "studio_eigenschaften", "Eigenschaften", "text", "fenster", "")
    inspZeile("Eigenes Control", "studio_werte", "Werte", "text", "studio_control", "")
    ' Daten (datenbank.dh): das Fenster an eine Tabelle, ein Feld an eine
    ' Spalte, eine Liste an die Zeilen einer Tabelle. Die Auswahlen fuellt
    ' inspektorFuellen aus dem Projekt.
    inspGruppe("Daten")
    inspZeile("Daten", "studio_tabelle", "Tabelle", "wahl", "fenster", "")
    inspZeile("Daten", "bind", "Spalte", "wahl", BINDARTEN, "")
    inspZeile("Daten", "studio_bildspalte", "Bildspalte", "wahl", "image", "")
    inspZeile("Daten", "studio_quelle", "Datenquelle", "wahl", QUELLARTEN, "")
    inspZeile("Daten", "studio_spalten", "Angezeigte Spalten", "text", QUELLARTEN, "")
    inspZeile("Daten", "studio_sortieren", "Sortieren nach", "wahl", QUELLARTEN, "")
    inspZeile("Daten", "studio_absteigend", "Absteigend", "schalter", QUELLARTEN, "")
    inspZeile("Daten", "studio_filter", "Bedingung", "text", QUELLARTEN, "")
    inspZeile("Daten", "studio_suchfeld", "Suchfeld", "wahl", QUELLARTEN, "")
    inspGruppe("Timer")
    inspZeile("Timer", "name", "Name", "text", "timer", "")
    inspZeile("Timer", "intervall", "Intervall (ms)", "zahl", "timer", "")
    inspZeile("Timer", "aktiv", "Läuft beim Start", "schalter", "timer", "")
    inspZeile("Timer", "wiederholen", "Wiederholt sich", "schalter", "timer", "")
    inspGruppe("Kennung")
    inspZeile("Kennung", "name", "Name", "text", "*", "")
    inspZeile("Kennung", "kind", "Art", "info", "*", "")
    inspGruppe("Lage")
    inspZeile("Lage", "x", "Links", "zahl", "*", "")
    inspZeile("Lage", "y", "Oben", "zahl", "*", "")
    inspZeile("Lage", "w", "Breite", "zahl", "*", "")
    inspZeile("Lage", "h", "Höhe", "zahl", "*", "")
    inspZeile("Lage", "anchor", "Anker", "anker", "*", "")
    ' Steht das Control in einem Layout, legt das Layout es: statt Links/Oben
    ' und Anker zaehlt sein Anteil am freien Platz (0 = eigene Groesse).
    inspZeile("Lage", "studio_gewicht", "Gewicht", "gewicht", "*", "")
    inspGruppe("Layout")
    inspZeile("Layout", "layout.art", "Anordnung", "wahl", "layout", "zeile;spalte;raster;fluss")
    inspZeile("Layout", "layout.spalten", "Spalten", "zahl", "layout", "")
    inspZeile("Layout", "layout.abstand", "Abstand", "zahl", "layout", "")
    inspZeile("Layout", "layout.rand", "Rand", "zahl", "layout", "")
    inspZeile("Layout", "layout.ausrichtung", "Ausrichtung", "wahlindex", "layout", "Anfang;Mitte;Ende")
    inspZeile("Layout", "layout.dehnen", "Kinder dehnen", "schalter", "layout", "")
    inspZeile("Layout", "layout.rahmen", "Rahmen", "schalter", "layout", "")
    inspGruppe("Inhalt")
    inspZeile("Inhalt", "text", "Text", "text", TEXTARTEN, "")
    inspZeile("Inhalt", "placeholder", "Platzhalter", "text", "textinput,textarea,dropdown", "")
    inspZeile("Inhalt", "items", "Einträge", "eintraege", LISTENARTEN, "")
    inspZeile("Inhalt", "table.headers", "Spalten", "eintraege", "table", "")
    inspZeile("Inhalt", "leiste.eintraege", "Knöpfe", "leiste", "toolbar", "")
    inspZeile("Inhalt", "leiste.beschriftung", "Mit Text", "schalter", "toolbar", "")
    inspZeile("Inhalt", "status.felder", "Felder", "felder", "statusbar", "")
    inspZeile("Inhalt", "group", "Gruppe", "text", "radio", "")
    inspZeile("Inhalt", "studio_bild", "Bild", "wahl", "image", "(keins)")
    inspZeile("Inhalt", "checked", "Gesetzt", "schalter", "checkbox,radio,toggle", "")
    inspZeile("Inhalt", "min", "Minimum", "komma", WERTARTEN, "")
    inspZeile("Inhalt", "max", "Maximum", "komma", WERTARTEN, "")
    inspZeile("Inhalt", "value", "Wert", "komma", WERTARTEN, "")
    inspGruppe("Aussehen")
    inspZeile("Aussehen", "variant", "Knopfart", "wahl", "button", JOIN$(["standard", "primaer", "erfolg", "warnung", "gefahr", "umriss", "flach", "link"], ";"))
    inspZeile("Aussehen", "font_size", "Schriftgröße", "zahl", "*", "")
    inspZeile("Aussehen", "font_style", "Schriftstil", "wahl", "*", "normal;fett;kursiv;fett+kursiv;unterstrichen")
    inspZeile("Aussehen", "align", "Ausrichtung", "wahl", "button,label,textinput", "links;mitte;rechts")
    inspZeile("Aussehen", "ov.bg", "Hintergrund", "farbe", "*", "")
    inspZeile("Aussehen", "ov.fg", "Textfarbe", "farbe", "*", "")
    inspGruppe("Verhalten")
    inspZeile("Verhalten", "enabled", "Aktiviert", "schalter", "*", "")
    inspZeile("Verhalten", "visible", "Sichtbar", "schalter", "*", "")
    inspZeile("Verhalten", "tooltip", "Hinweis", "text", "*", "")
    inspZeile("Verhalten", "tab_index", "Tab-Folge", "zahl", "*", "")
    inspZeile("Verhalten", "draggable", "Ziehbar", "schalter", "listbox,tree,table,label,button,card,image", "")
    inspZeile("Verhalten", "drop_target", "Ablage", "schalter", "*", "")

    DIM g AS INTEGER
    FOR g = 0 TO LEN(inspGruppen) - 1
        DIM kopf AS GUI_WIDGET : kopf = GUI_BUTTON(win, tr$(inspGruppen[g]), 0, 0, 10, 26)
        GUI_ADD_CLASS(kopf, "gruppenkopf")
        GUI_SET_ALIGN(kopf, "links")
        GUI_SET_ICON(kopf, "runter")
        ARRAY_PUSH(inspKoepfe, kopf)
        inspDazu(kopf)
    NEXT
    DIM z AS InspZeile
    FOR EACH z IN inspZeilen
        z.lbl = GUI_LABEL(win, tr$(z.titel), 0, 0)
        GUI_ADD_CLASS(z.lbl, "feldname")
        inspDazu(z.lbl)
        SELECT CASE z.art
            CASE "text", "eintraege", "leiste", "felder"
                z.ed = GUI_TEXTINPUT(win, 0, 0, 10, 26)
                IF z.art = "eintraege" THEN GUI_TOOLTIP(z.ed, tr$("Einträge durch Semikolon getrennt"))
                IF z.art = "leiste" THEN GUI_TOOLTIP(z.ed, tr$("Text|Sinnbild|Tipp je Knopf, durch Semikolon getrennt; - = Trenner, ~ = Lücke"))
                IF z.art = "felder" THEN GUI_TOOLTIP(z.ed, tr$("Text|Breite[|links,mitte,rechts[|klick]] je Feld, durch Semikolon getrennt; Breite 0 = der Rest"))
            CASE "komma"
                z.ed = GUI_TEXTINPUT(win, 0, 0, 10, 26)
                GUI_TEXTINPUT_SET(z.ed, "zahlen", 2)
            CASE "zahl", "gewicht"
                IF z.schluessel = "intervall" THEN
                    z.ed = GUI_SPINNER(win, 0, 0, 10, 1, 3600000, 1000, 100)
                ELSEIF z.art = "gewicht" OR LEFT$(z.schluessel, 7) = "layout." THEN
                    z.ed = GUI_SPINNER(win, 0, 0, 10, 0, 999, 0, 1)
                ELSE
                    z.ed = GUI_SPINNER(win, 0, 0, 10, -9999, 9999, 0, 1)
                END IF
            CASE "schalter"
                z.ed = GUI_TOGGLE(win, "", 0, 0, FALSE)
            CASE "wahl", "wahlindex"
                ' Die Werte einer "wahl" sind Woerter der Laufzeit und bleiben, wie sie
                ' sind; bei "wahlindex" zaehlt nur die Stelle.
                z.ed = GUI_DROPDOWN(win, 0, 0, 10, 26, SPLIT(IIF(z.art = "wahlindex", tr$(z.wahl), z.wahl), ";"))
            CASE "knopfwahl"
                ' Die Knoepfe des Fensters; inspektorFuellen setzt sie ein.
                z.ed = GUI_DROPDOWN(win, 0, 0, 10, 26, [tr$("(keiner)")])
            CASE "farbe"
                z.ed = GUI_BUTTON(win, tr$("Vorgabe"), 0, 0, 10, 26)
                GUI_ADD_CLASS(z.ed, "farbfeld")
            CASE "info"
                z.ed = GUI_LABEL(win, "", 0, 0)
                GUI_ADD_CLASS(z.ed, "leise")
            CASE "anker"
                DIM k AS INTEGER
                DIM namen AS ARRAY OF STRING : namen = ["links", "oben", "rechts", "unten"]
                FOR k = 0 TO 3
                    DIM cb AS GUI_WIDGET : cb = GUI_CHECKBOX(win, LEFT$(UPPER$(namen[k]), 1), 0, 0)
                    GUI_TOOLTIP(cb, trf$("klebt am {0} Rand, wenn das Fenster wächst", [IIF(k = 0, tr$("linken"), IIF(k = 1, tr$("oberen"), IIF(k = 2, tr$("rechten"), tr$("unteren"))))]))
                    ARRAY_PUSH(z.anker, cb)
                    inspDazu(cb)
                NEXT
                z.ed = z.anker[0]
        END SELECT
        IF z.art <> "anker" THEN inspDazu(z.ed)
    NEXT

    ' Das Popover fuer Farben.
    farbPop = GUI_POPOVER(inspPanel, 236, 236, "links")
    farbWahl = GUI_COLORPICKER(farbPop, 8, 8, 220, 180)
    farbVorgabe = GUI_BUTTON(farbPop, tr$("Vorgabe des Themas"), 8, 196, 220, 30)
END SUB

' Ein Widget gehoert zum Inspektor: zur Leiste (ein- und ausgeblendet mit
' ihr) und in den rollenden Bereich.
SUB inspDazu(w AS GUI_WIDGET)
    GUI_DOCK_ADD(win, "inspektor", w)
    GUI_PANEL_ADD(inspPanel, w)
END SUB

' Die Namen der Knoepfe im Fenster (fuer Standard- und Abbrechen-Knopf).
FUNCTION knoepfeDesFensters() AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(doc, "widgets") - 1
        DIM art AS STRING : art = feldText$(i, "kind")
        IF (art = "button" OR art = "iconbutton") AND feldText$(i, "name") <> "" THEN ARRAY_PUSH(aus, feldText$(i, "name"))
    NEXT
    RETURN aus
END FUNCTION

FUNCTION giltFuer(z AS InspZeile, art AS STRING) AS BOOLEAN
    IF abstandL >= 0 THEN RETURN z.art = "gewicht"
    IF trayWahl >= 0 THEN RETURN z.fuer = "timer"
    IF auswahl < 0 THEN
        ' Ein eigenes Control hat keinen Titel und waechst mit seiner Instanz.
        IF z.fuer = "fenster" AND entwurfIstControl() THEN RETURN z.schluessel <> "title" AND z.schluessel <> "resizable" AND z.schluessel <> "studio_tabelle" AND z.art <> "knopfwahl"
        IF z.schluessel = "studio_ereignisse" OR z.schluessel = "studio_eigenschaften" THEN RETURN FALSE
        RETURN z.fuer = "fenster"
    END IF
    IF z.fuer = "fenster" THEN RETURN FALSE
    ' Eine Instanz eines eigenen Controls: Name, Lage und Sichtbarkeit -- das
    ' Aussehen legen seine Teile fest.
    IF art = "studio_control" THEN
        IF z.art = "gewicht" THEN RETURN verwaltet(auswahl)
        IF verwaltet(auswahl) AND (z.schluessel = "x" OR z.schluessel = "y" OR z.schluessel = "anchor") THEN RETURN FALSE
        RETURN INSTR(",name,kind,x,y,w,h,anchor,visible,studio_werte,", "," + z.schluessel + ",") >= 0
    END IF
    ' In einem Layout: kein Links/Oben/Anker, dafuer das Gewicht.
    DIM imLayout AS BOOLEAN : imLayout = verwaltet(auswahl)
    IF z.art = "gewicht" THEN RETURN imLayout
    IF imLayout AND (z.schluessel = "x" OR z.schluessel = "y" OR z.schluessel = "anchor") THEN RETURN FALSE
    IF z.schluessel = "layout.spalten" THEN RETURN art = "layout" AND feldText$(auswahl, "layout.art") = "raster"
    IF z.fuer = "*" THEN RETURN TRUE
    RETURN INSTR("," + z.fuer + ",", "," + art + ",") >= 0
END FUNCTION

' --- Werte lesen und schreiben ---------------------------------------------------
FUNCTION pfadFuer$(z AS InspZeile, i AS INTEGER) AS STRING
    IF trayWahl >= 0 THEN RETURN "timer." + STR$(trayWahl) + "." + z.schluessel
    IF i < 0 THEN RETURN z.schluessel
    RETURN wz$(i, z.schluessel)
END FUNCTION

FUNCTION wertText$(pfad AS STRING) AS STRING
    IF NOT JSON_HAS(doc, pfad) THEN RETURN ""
    DIM t AS STRING : t = JSON_TYPE(doc, pfad)
    IF t = "string" THEN RETURN JSON_GET_STRING(doc, pfad)
    IF t = "number" THEN
        DIM f AS FLOAT : f = JSON_GET_FLOAT(doc, pfad)
        IF f = INT(f) THEN RETURN STR$(INT(f))
        RETURN STR$(f)
    END IF
    RETURN ""
END FUNCTION

FUNCTION listeText$(pfad AS STRING) AS STRING
    IF NOT JSON_HAS(doc, pfad) THEN RETURN ""
    DIM teile AS ARRAY OF STRING : teile = []
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(doc, pfad) - 1
        ARRAY_PUSH(teile, JSON_GET_STRING(doc, pfad + "." + STR$(k)))
    NEXT
    RETURN JOIN$(teile, "; ")
END FUNCTION

SUB listeSetzen(pfad AS STRING, text AS STRING)
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    DIM t AS STRING
    FOR EACH t IN SPLIT(text, ";")
        IF TRIM$(t) <> "" THEN JSON_APPEND_STRING(a, "", TRIM$(t))
    NEXT
    JSON_SET_JSON(doc, pfad, a)
END SUB

' Die Knoepfe einer Werkzeugleiste als eine Zeile: "Text|Sinnbild|Tipp" je
' Knopf, "-" = Trenner, "~" = Luecke (schiebt den Rest nach rechts). Was
' leer ist, faellt hinten weg ("Neu|neu", "|stift|Bearbeiten").
FUNCTION leisteText$(pfad AS STRING) AS STRING
    IF NOT JSON_HAS(doc, pfad) THEN RETURN ""
    DIM teile AS ARRAY OF STRING : teile = []
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(doc, pfad) - 1
        DIM q AS STRING : q = pfad + "." + STR$(k)
        DIM art AS STRING : art = jsonText$(doc, q + ".art")
        IF art = "trenner" THEN
            ARRAY_PUSH(teile, "-")
        ELSEIF art = "luecke" THEN
            ARRAY_PUSH(teile, "~")
        ELSE
            DIM f AS ARRAY OF STRING : f = [jsonText$(doc, q + ".text"), jsonText$(doc, q + ".symbol"), jsonText$(doc, q + ".tip")]
            WHILE LEN(f) > 1 AND f[LEN(f) - 1] = ""
                ARRAY_REMOVE_AT(f, LEN(f) - 1)
            WEND
            ARRAY_PUSH(teile, JOIN$(f, "|"))
        END IF
    NEXT
    RETURN JOIN$(teile, "; ")
END FUNCTION

SUB leisteSetzen(pfad AS STRING, text AS STRING)
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    DIM t AS STRING
    FOR EACH t IN SPLIT(text, ";")
        t = TRIM$(t)
        IF t = "" THEN CONTINUE
        DIM o AS JSON_HANDLE : o = JSON_PARSE("{}")
        IF t = "-" THEN
            JSON_SET_STRING(o, "art", "trenner")
        ELSEIF t = "~" THEN
            JSON_SET_STRING(o, "art", "luecke")
        ELSE
            JSON_SET_STRING(o, "art", "knopf")
            DIM f AS ARRAY OF STRING : f = SPLIT(t, "|")
            IF TRIM$(f[0]) <> "" THEN JSON_SET_STRING(o, "text", TRIM$(f[0]))
            IF LEN(f) > 1 THEN
                IF TRIM$(f[1]) <> "" THEN JSON_SET_STRING(o, "symbol", TRIM$(f[1]))
            END IF
            IF LEN(f) > 2 THEN
                IF TRIM$(f[2]) <> "" THEN JSON_SET_STRING(o, "tip", TRIM$(f[2]))
            END IF
        END IF
        JSON_APPEND_JSON(a, "", o)
    NEXT
    JSON_SET_JSON(doc, pfad, a)
END SUB

' Die Felder einer Statusleiste als eine Zeile: "Text|Breite" je Feld, dahinter
' wahlweise die Ausrichtung (links, mitte, rechts) und "klick" (das Feld meldet
' das Ereignis Feld).
FUNCTION felderText$(pfad AS STRING) AS STRING
    IF NOT JSON_HAS(doc, pfad) THEN RETURN ""
    DIM teile AS ARRAY OF STRING : teile = []
    DIM k AS INTEGER
    FOR k = 0 TO JSON_LEN(doc, pfad) - 1
        DIM q AS STRING : q = pfad + "." + STR$(k)
        DIM b AS INTEGER : b = 0
        IF JSON_HAS(doc, q + ".breite") THEN b = INT(JSON_GET_FLOAT(doc, q + ".breite"))
        DIM z AS STRING : z = jsonText$(doc, q + ".text") + "|" + STR$(b)
        DIM au AS STRING : au = jsonText$(doc, q + ".ausrichtung")
        DIM kl AS BOOLEAN : kl = FALSE
        IF JSON_HAS(doc, q + ".klickbar") THEN kl = JSON_GET_BOOL(doc, q + ".klickbar")
        IF au <> "" OR kl THEN z = z + "|" + IIF(au = "", "links", au)
        IF kl THEN z = z + "|klick"
        ARRAY_PUSH(teile, z)
    NEXT
    RETURN JOIN$(teile, "; ")
END FUNCTION

SUB felderSetzen(pfad AS STRING, text AS STRING)
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    DIM t AS STRING
    FOR EACH t IN SPLIT(text, ";")
        IF TRIM$(t) = "" THEN CONTINUE
        DIM f AS ARRAY OF STRING : f = SPLIT(t, "|")
        DIM o AS JSON_HANDLE : o = JSON_PARSE("{}")
        JSON_SET_STRING(o, "text", TRIM$(f[0]))
        DIM b AS INTEGER : b = 0
        IF LEN(f) > 1 THEN b = MAX(0, INT(VAL(TRIM$(f[1]))))
        JSON_SET_INT(o, "breite", b)
        IF LEN(f) > 2 THEN
            DIM au AS STRING : au = LOWER$(TRIM$(f[2]))
            IF au = "mitte" OR au = "rechts" THEN JSON_SET_STRING(o, "ausrichtung", au)
        END IF
        IF LEN(f) > 3 THEN
            IF LOWER$(TRIM$(f[3])) = "klick" THEN JSON_SET_BOOL(o, "klickbar", TRUE)
        END IF
        JSON_APPEND_JSON(a, "", o)
    NEXT
    JSON_SET_JSON(doc, pfad, a)
END SUB

SUB farbfeldZeigen(z AS InspZeile, pfad AS STRING)
    IF JSON_HAS(doc, pfad) THEN
        DIM c AS INTEGER : c = INT(JSON_GET_FLOAT(doc, pfad))
        GUI_SET_TEXT(z.ed, COLOR_HEX$(c))
        GUI_SET_COLOR(z.ed, "bg", c)
        DIM hell AS BOOLEAN : hell = ((c SHR 16) BAND 255) * 3 + ((c SHR 8) BAND 255) * 6 + (c BAND 255) > 1400
        GUI_SET_COLOR(z.ed, "fg", IIF(hell, &H101010, &HFFFFFF))
    ELSE
        GUI_SET_TEXT(z.ed, tr$("Vorgabe"))
        GUI_SET_COLOR(z.ed, "bg", -1)
        GUI_SET_COLOR(z.ed, "fg", -1)
    END IF
END SUB

' Das Element des vorderen Reiters, wenn es nicht das Fenster in `doc` ist
' (Datenbank, Modul, Klasse, Code eines anderen Fensters) -- sonst -1. Dann
' zeigt der Inspektor dieses Element statt des zuletzt offenen Fensters.
FUNCTION inspFremdesElement() AS INTEGER
    DIM k AS INTEGER : k = reiterVorn()
    IF k < 0 OR k >= LEN(reiter) THEN RETURN -1
    IF reiter[k].art = "layout" THEN RETURN -1
    DIM ei AS INTEGER : ei = elementVon(reiter[k].el)
    IF ei = aktFenster THEN RETURN -1
    RETURN ei
END FUNCTION

' Die Editoren auf den Stand des Modells.
SUB inspektorFuellen()
    DIM fremd AS INTEGER : fremd = inspFremdesElement()
    ' Eine Eingabe ohne Rueckgaengig-Schritt gehoert noch zum Fenster in `doc`.
    IF fremd >= 0 AND inspAnhaengig >= 0 THEN merken()
    inspStumm = TRUE
    inspAnhaengig = -1
    DIM art AS STRING : art = ""
    IF fremd >= 0 THEN
        ' Nichts, was in `doc` steht, gehoert zu diesem Element.
        GUI_SET_TEXT(inspTitel, elemente[fremd].name)
        GUI_SET_TEXT(inspArt, artText$(elemente[fremd].art))
        DIM zf AS InspZeile
        FOR EACH zf IN inspZeilen
            zf.sichtbar = FALSE
        NEXT
        inspektorLegen()
        inspStumm = FALSE
        protokoll("inspektor element " + elemente[fremd].art + " " + elemente[fremd].name)
        RETURN
    END IF
    IF abstandL >= 0 THEN
        art = "abstand"
        GUI_SET_TEXT(inspTitel, tr$("Abstandhalter"))
        GUI_SET_TEXT(inspArt, trf$("in {0}, Stelle {1}", [feldText$(abstandL, "name"), STR$(abstandK + 1)]))
    ELSEIF trayWahl >= 0 THEN
        art = "timer"
        GUI_SET_TEXT(inspTitel, timerName$(trayWahl))
        GUI_SET_TEXT(inspArt, tr$("Timer"))
    ELSEIF auswahl >= 0 THEN
        art = feldText$(auswahl, "kind")
        GUI_SET_TEXT(inspTitel, feldText$(auswahl, "name"))
        DIM text AS STRING : text = bausteinNameAnzeige$(auswahl)
        IF LEN(gewaehlt) > 1 THEN text = text + trf$(" -- {0} gewählt", [STR$(LEN(gewaehlt))])
        GUI_SET_TEXT(inspArt, text)
    ELSE
        GUI_SET_TEXT(inspTitel, fensterText$("name"))
        GUI_SET_TEXT(inspArt, IIF(entwurfIstControl(), tr$("Eigenes Control"), tr$("Fenster")))
    END IF
    DIM z AS InspZeile
    FOR EACH z IN inspZeilen
        z.sichtbar = giltFuer(z, art)
        IF NOT z.sichtbar THEN CONTINUE
        DIM p AS STRING : p = pfadFuer$(z, auswahl)
        SELECT CASE z.art
            CASE "text", "komma"
                GUI_SET_TEXT(z.ed, wertText$(p))
                GUI_SET_ERROR(z.ed, "")
                IF z.schluessel = "studio_werte" AND auswahl >= 0 THEN
                    ' Was das Control anbietet, mit seinen Vorgaben.
                    DIM cn AS STRING : cn = feldText$(auswahl, "studio_control")
                    DIM angebot AS STRING : angebot = jsonText$(controlLayout(cn), "studio_eigenschaften")
                    GUI_TOOLTIP(z.ed, IIF(angebot = "", trf$("{0} hat keine Eigenschaften.", [cn]), trf$("Name = Wert; ... -- {0} hat: {1}", [cn, angebot])))
                END IF
                IF z.schluessel = "studio_eigenschaften" THEN GUI_TOOLTIP(z.ed, tr$("Name = Vorgabe; Zahl AS INTEGER = 3 -- ohne AS ein STRING; dazu FLOAT und BOOLEAN"))
                IF z.schluessel = "studio_ereignisse" THEN GUI_TOOLTIP(z.ed, tr$("Namen durch Semikolon; im Code des Controls meldet Self.Ausloesen(...) eines davon"))
                IF z.schluessel = "studio_spalten" THEN GUI_TOOLTIP(z.ed, tr$("Spalten durch Semikolon, auch über einen Verweis (kunde.name) -- leer: bei einer Tabelle alle, sonst die erste"))
                IF z.schluessel = "studio_filter" THEN
                    GUI_TOOLTIP(z.ed, tr$("Eine SQL-Bedingung wie im WHERE, etwa: ort = 'Köln' AND umsatz > 100"))
                    filterPruefen(z)
                END IF
            CASE "eintraege"
                GUI_SET_TEXT(z.ed, listeText$(p))
            CASE "leiste"
                GUI_SET_TEXT(z.ed, leisteText$(p))
            CASE "felder"
                GUI_SET_TEXT(z.ed, felderText$(p))
            CASE "zahl"
                ' Was die Laufzeit ohne Angabe nimmt (GUI_SAVE laesst es weg).
                DIM v AS INTEGER : v = 0
                IF z.schluessel = "layout.abstand" THEN v = 6
                IF z.schluessel = "layout.spalten" THEN v = 2
                IF JSON_HAS(doc, p) THEN v = INT(JSON_GET_FLOAT(doc, p))
                GUI_SET_VALUE(z.ed, v)
            CASE "gewicht"
                IF abstandL >= 0 THEN
                    GUI_SET_VALUE(z.ed, gewichtListe(abstandL)[abstandK])
                ELSE
                    GUI_SET_VALUE(z.ed, gewichtVon(auswahl))
                END IF
            CASE "wahlindex"
                DIM wi AS INTEGER : wi = 0
                IF JSON_HAS(doc, p) THEN wi = INT(JSON_GET_FLOAT(doc, p))
                GUI_DROPDOWN_SET_SELECTED(z.ed, MAX(0, wi))
            CASE "schalter"
                DIM an AS BOOLEAN : an = z.schluessel = "enabled" OR z.schluessel = "visible" OR z.schluessel = "aktiv" OR z.schluessel = "wiederholen" OR z.schluessel = "layout.dehnen"
                IF JSON_HAS(doc, p) THEN
                    IF JSON_TYPE(doc, p) = "boolean" THEN an = JSON_GET_BOOL(doc, p)
                END IF
                GUI_SET_CHECKED(z.ed, an)
            CASE "wahl"
                IF z.schluessel = "studio_bild" THEN
                    ' Die Bilder des Projekts -- die Liste aendert sich mit ihm.
                    DIM bl AS ARRAY OF STRING : bl = projektBilder()
                    z.wahl = "(keins)" + IIF(LEN(bl) > 0, ";" + JOIN$(bl, ";"), "")
                    GUI_LISTBOX_CLEAR(z.ed)
                    DIM bn AS STRING
                    FOR EACH bn IN SPLIT(z.wahl, ";")
                        GUI_LISTBOX_ADD(z.ed, bn)
                    NEXT
                END IF
                IF istDatenWahl(z.schluessel) THEN datenWahlFuellen(z, wertText$(p))
                DIM eintraege AS ARRAY OF STRING : eintraege = SPLIT(z.wahl, ";")
                DIM w AS STRING : w = wertText$(p)
                IF w = "" AND z.schluessel = "layout.art" THEN w = "spalte"
                DIM idx AS INTEGER : idx = ARRAY_INDEXOF(eintraege, w)
                GUI_DROPDOWN_SET_SELECTED(z.ed, MAX(0, idx))
            CASE "knopfwahl"
                DIM kl AS ARRAY OF STRING : kl = [tr$("(keiner)")]
                DIM kn AS STRING
                FOR EACH kn IN knoepfeDesFensters()
                    ARRAY_PUSH(kl, kn)
                NEXT
                GUI_SET_DROPDOWN(z.ed, kl)
                GUI_DROPDOWN_SET_SELECTED(z.ed, MAX(0, ARRAY_INDEXOF(kl, wertText$(p))))
            CASE "farbe"
                farbfeldZeigen(z, p)
            CASE "info"
                GUI_SET_TEXT(z.ed, bausteinNameAnzeige$(auswahl) + "  (" + wertText$(p) + ")")
            CASE "anker"
                DIM a AS STRING : a = wertText$(p)
                IF a = "" THEN a = "lt"
                GUI_SET_CHECKED(z.anker[0], INSTR(a, "l") >= 0)
                GUI_SET_CHECKED(z.anker[1], INSTR(a, "t") >= 0)
                GUI_SET_CHECKED(z.anker[2], INSTR(a, "r") >= 0)
                GUI_SET_CHECKED(z.anker[3], INSTR(a, "b") >= 0)
        END SELECT
    NEXT
    inspektorLegen()
    inspStumm = FALSE
    felderProtokollieren()
END SUB

' Die sichtbaren Zeilen untereinander, Gruppen mit Kopf.
SUB inspektorLegen()
    DIM px AS INTEGER
    DIM py AS INTEGER
    DIM pw AS INTEGER
    DIM ph AS INTEGER
    (px, py, pw, ph) = GUI_DOCK_RECT(win, "inspektor")
    IF pw <= 0 THEN RETURN
    GUI_SET_BOUNDS(inspPanel, px, py, pw, ph)
    DIM lx AS INTEGER : lx = px + 14
    DIM ex AS INTEGER : ex = px + 128
    DIM eb AS INTEGER : eb = MAX(60, pw - 128 - 14)
    DIM y AS INTEGER : y = py + 12
    GUI_SET_BOUNDS(inspTitel, lx, y, pw - 28, 24)
    y = y + 26
    GUI_SET_BOUNDS(inspArt, lx, y, pw - 28, 18)
    y = y + 30
    DIM g AS INTEGER
    FOR g = 0 TO LEN(inspGruppen) - 1
        DIM gname AS STRING : gname = inspGruppen[g]
        DIM hat AS BOOLEAN : hat = FALSE
        DIM z AS InspZeile
        FOR EACH z IN inspZeilen
            IF z.gruppe = gname AND z.sichtbar THEN hat = TRUE
        NEXT
        GUI_SET_VISIBLE(inspKoepfe[g], hat)
        DIM offen AS BOOLEAN : offen = MAPGET(inspOffen, gname)
        IF hat THEN
            GUI_SET_BOUNDS(inspKoepfe[g], px + 6, y, pw - 12, 28)
            GUI_SET_ICON(inspKoepfe[g], IIF(offen, "runter", "rechts"))
            y = y + 32
        END IF
        FOR EACH z IN inspZeilen
            IF z.gruppe <> gname THEN CONTINUE
            DIM zeigen AS BOOLEAN : zeigen = z.sichtbar AND offen
            GUI_SET_VISIBLE(z.lbl, zeigen)
            IF z.art = "anker" THEN
                DIM k AS INTEGER
                FOR k = 0 TO 3
                    GUI_SET_VISIBLE(z.anker[k], zeigen)
                    IF zeigen THEN GUI_SET_BOUNDS(z.anker[k], ex + k * (eb \ 4), y + 4, eb \ 4 - 4, 20)
                NEXT
            ELSE
                GUI_SET_VISIBLE(z.ed, zeigen)
            END IF
            IF NOT zeigen THEN CONTINUE
            GUI_SET_BOUNDS(z.lbl, lx, y + 5, 112, 18)
            IF z.art = "schalter" THEN
                GUI_SET_BOUNDS(z.ed, ex, y + 3, 48, 22)
            ELSEIF z.art = "info" THEN
                GUI_SET_BOUNDS(z.ed, ex, y + 5, eb, 18)
            ELSEIF z.art <> "anker" THEN
                GUI_SET_BOUNDS(z.ed, ex, y, eb, 28)
            END IF
            y = y + 34
        NEXT
        IF hat THEN y = y + 6
    NEXT
END SUB

' Einen Wert aus dem Editor ins Modell -- fuer alle gewaehlten Controls, die
' die Eigenschaft haben (wie in Xojo).
DIM nameAlt AS STRING : nameAlt = ""
SUB zeileUebernehmen(zi AS INTEGER)
    DIM z AS InspZeile : z = inspZeilen[zi]
    DIM ziele AS ARRAY OF INTEGER
    IF auswahl < 0 THEN ziele = [-1] ELSE ziele = gewaehlt
    IF trayWahl >= 0 THEN ziele = [-1]
    ' Ein Name ist ein Bezeichner und eindeutig -- er wird zum Feld der Klasse.
    IF z.schluessel = "name" THEN
        DIM n AS STRING : n = TRIM$(GUI_TEXT(z.ed))
        IF NOT istBezeichner(n) THEN
            GUI_SET_ERROR(z.ed, tr$("Ein Name beginnt mit einem Buchstaben und hat nur Buchstaben, Ziffern und _."))
            RETURN
        END IF
        IF trayWahl >= 0 AND nameVergeben(n, TRAY + trayWahl) THEN
            GUI_SET_ERROR(z.ed, trf$("Den Namen '{0}' gibt es in diesem Fenster schon.", [n]))
            RETURN
        END IF
        IF trayWahl < 0 AND auswahl >= 0 AND nameVergeben(n, auswahl) THEN
            GUI_SET_ERROR(z.ed, trf$("Den Namen '{0}' gibt es in diesem Fenster schon.", [n]))
            RETURN
        END IF
        ' Der Name des Fensters ist der Name seiner Klasse -- eindeutig im Projekt.
        IF trayWahl < 0 AND auswahl < 0 AND aktFenster >= 0 THEN
            DIM schon AS INTEGER : schon = elementIndex(n)
            IF schon >= 0 AND schon <> aktFenster THEN
                GUI_SET_ERROR(z.ed, trf$("Ein Element '{0}' gibt es im Projekt schon.", [n]))
                RETURN
            END IF
        END IF
        nameAlt = IIF(auswahl >= 0, feldText$(auswahl, "name"), fensterText$("name"))
        IF trayWahl >= 0 THEN nameAlt = timerName$(trayWahl)
        GUI_SET_ERROR(z.ed, "")
        ziele = [IIF(trayWahl >= 0, -1, auswahl)]
    END IF
    DIM i AS INTEGER
    IF z.art = "gewicht" AND abstandL >= 0 THEN
        eintragGewichtSetzen(abstandL, abstandK, INT(GUI_VALUE(z.ed)))
        entwurfBauen()
        behaelterProtokollieren()
        RETURN
    END IF
    IF z.art = "gewicht" THEN
        FOR EACH i IN ziele
            IF verwaltet(i) THEN gewichtSetzen(i, INT(GUI_VALUE(z.ed)))
        NEXT
        entwurfBauen()
        RETURN
    END IF
    FOR EACH i IN ziele
        IF i >= 0 THEN
            IF NOT giltFuer(z, feldText$(i, "kind")) THEN CONTINUE
        END IF
        DIM p AS STRING : p = pfadFuer$(z, i)
        SELECT CASE z.art
            CASE "text"
                IF z.schluessel = "name" THEN
                    JSON_SET_STRING(doc, p, TRIM$(GUI_TEXT(z.ed)))
                ELSEIF GUI_TEXT(z.ed) = "" AND z.schluessel <> "text" AND z.schluessel <> "title" THEN
                    IF JSON_HAS(doc, p) THEN JSON_REMOVE(doc, p)
                ELSE
                    JSON_SET_STRING(doc, p, GUI_TEXT(z.ed))
                END IF
            CASE "eintraege"
                listeSetzen(p, GUI_TEXT(z.ed))
            CASE "leiste"
                leisteSetzen(p, GUI_TEXT(z.ed))
            CASE "felder"
                felderSetzen(p, GUI_TEXT(z.ed))
            CASE "komma"
                IF TRIM$(GUI_TEXT(z.ed)) <> "" THEN JSON_SET_FLOAT(doc, p, VAL(REPLACE$(GUI_TEXT(z.ed), ",", ".")))
            CASE "zahl"
                DIM v AS INTEGER : v = INT(GUI_VALUE(z.ed))
                IF (z.schluessel = "w" OR z.schluessel = "h" OR z.schluessel = "layout.spalten") AND v < 1 THEN v = 1
                IF (z.schluessel = "font_size" OR z.schluessel = "tab_index") AND v <= 0 THEN
                    IF JSON_HAS(doc, p) THEN JSON_REMOVE(doc, p)
                ELSE
                    JSON_SET_INT(doc, p, v)
                END IF
            CASE "schalter"
                JSON_SET_BOOL(doc, p, GUI_CHECKED(z.ed))
            CASE "wahlindex"
                JSON_SET_INT(doc, p, MAX(0, GUI_DROPDOWN_SELECTED(z.ed)))
            CASE "knopfwahl"
                IF GUI_DROPDOWN_SELECTED(z.ed) <= 0 THEN
                    IF JSON_HAS(doc, p) THEN JSON_REMOVE(doc, p)
                ELSE
                    JSON_SET_STRING(doc, p, GUI_DROPDOWN_TEXT(z.ed))
                END IF
            CASE "wahl"
                DIM w AS STRING : w = GUI_DROPDOWN_TEXT(z.ed)
                IF istDatenWahl(z.schluessel) AND GUI_DROPDOWN_SELECTED(z.ed) <= 0 THEN
                    IF JSON_HAS(doc, p) THEN JSON_REMOVE(doc, p)
                ELSEIF w = "normal" OR w = "standard" OR w = "(keins)" OR (z.schluessel = "align" AND w = "links") THEN
                    IF JSON_HAS(doc, p) THEN JSON_REMOVE(doc, p)
                ELSE
                    JSON_SET_STRING(doc, p, w)
                END IF
            CASE "anker"
                DIM a AS STRING : a = ""
                IF GUI_CHECKED(z.anker[0]) THEN a = a + "l"
                IF GUI_CHECKED(z.anker[2]) THEN a = a + "r"
                IF GUI_CHECKED(z.anker[1]) THEN a = a + "t"
                IF GUI_CHECKED(z.anker[3]) THEN a = a + "b"
                IF a = "lt" THEN
                    IF JSON_HAS(doc, p) THEN JSON_REMOVE(doc, p)
                ELSE
                    JSON_SET_STRING(doc, p, a)
                END IF
        END SELECT
    NEXT
    entwurfBauen()
    IF z.schluessel = "name" THEN
        IF nameAlt <> TRIM$(GUI_TEXT(z.ed)) THEN nameGeaendert(nameAlt, TRIM$(GUI_TEXT(z.ed)), auswahl < 0 AND trayWahl < 0)
        navigatorFuellen()
        GUI_SET_TEXT(inspTitel, TRIM$(GUI_TEXT(z.ed)))
    END IF
    IF z.schluessel = "w" OR z.schluessel = "h" THEN lageAnzeigen()
    ' Eine Tabelle mit Datenquelle zeigt im Entwurf schon ihre Spalten; die
    ' Spalten eines Feldes haengen an der Tabelle des Fensters.
    IF z.schluessel = "studio_quelle" OR z.schluessel = "studio_spalten" THEN
        FOR EACH i IN ziele
            IF i >= 0 THEN quellKopfSetzen(i)
        NEXT
        entwurfBauen()
        ' Nach welcher Spalte sortiert werden kann, haengt an der Quelle.
        IF z.schluessel = "studio_quelle" THEN inspektorFuellen()
    END IF
    IF z.schluessel = "studio_filter" THEN filterPruefen(z)
    IF z.schluessel = "studio_tabelle" THEN protokoll("fenster tabelle " + fensterText$("studio_tabelle"))
    ' Die Anordnung entscheidet, ob es Spalten gibt -- und wie das Control im
    ' Navigator heisst.
    IF z.schluessel = "layout.art" THEN
        inspektorFuellen()
        navigatorFuellen()
    END IF
    IF LEFT$(z.schluessel, 7) = "layout." THEN behaelterProtokollieren()
END SUB

' Je Bild nach GUI_UPDATE: was der Nutzer im Inspektor geaendert hat.
SUB inspektorPruefen()
    IF inspStumm THEN RETURN
    ' Gruppen auf- und zuklappen.
    DIM g AS INTEGER
    FOR g = 0 TO LEN(inspGruppen) - 1
        IF GUI_CLICKED(inspKoepfe[g]) THEN
            MAPPUT(inspOffen, inspGruppen[g], NOT MAPGET(inspOffen, inspGruppen[g]))
            inspektorLegen()
        END IF
    NEXT
    ' Ein anhaengiger Schritt wird fest, wenn sein Feld den Fokus abgibt.
    IF inspAnhaengig >= 0 THEN
        DIM za AS InspZeile : za = inspZeilen[inspAnhaengig]
        IF GUI_FOCUSED() <> za.ed OR GUI_ENTERED(za.ed) THEN
            inspAnhaengig = -1
            ' Breite oder Hoehe des Fensters: verankerte Controls ruecken mit,
            ' wie beim Ziehen am Griff (gemessen am Stand vor dem Tippen).
            IF (za.schluessel = "w" OR za.schluessel = "h") AND za.fuer = "fenster" AND standPos >= 0 THEN
                DIM vorher AS JSON_HANDLE : vorher = JSON_PARSE(staende[standPos])
                ankerNachMass(fensterZahl("w") - JSON_GET_INT(vorher, "w"), fensterZahl("h") - JSON_GET_INT(vorher, "h"))
                entwurfBauen()
            END IF
            merken()
            werkzeugeNachziehen()
            protokoll("inspektor " + za.schluessel)
        END IF
    END IF
    DIM zi AS INTEGER
    FOR zi = 0 TO LEN(inspZeilen) - 1
        DIM z AS InspZeile : z = inspZeilen[zi]
        IF NOT z.sichtbar THEN CONTINUE
        DIM geaendertJetzt AS BOOLEAN : geaendertJetzt = FALSE
        IF z.art = "anker" THEN
            DIM k AS INTEGER
            FOR k = 0 TO 3
                IF GUI_CHANGED(z.anker[k]) THEN geaendertJetzt = TRUE
            NEXT
        ELSEIF z.art = "farbe" THEN
            IF GUI_CLICKED(z.ed) THEN farbeOeffnen(zi)
        ELSEIF z.art <> "info" THEN
            geaendertJetzt = GUI_CHANGED(z.ed)
        END IF
        IF NOT geaendertJetzt THEN CONTINUE
        zeileUebernehmen(zi)
        IF z.art = "text" OR z.art = "komma" OR z.art = "eintraege" OR z.art = "leiste" OR z.art = "felder" OR z.art = "zahl" OR z.art = "gewicht" THEN
            IF inspAnhaengig >= 0 AND inspAnhaengig <> zi THEN merken()
            inspAnhaengig = zi
        ELSE
            merken()
            werkzeugeNachziehen()
            protokoll("inspektor " + z.schluessel)
        END IF
    NEXT
    farbePruefen()
END SUB

' --- Farbe -----------------------------------------------------------------
SUB farbeOeffnen(zi AS INTEGER)
    farbZeile = zi
    DIM z AS InspZeile : z = inspZeilen[zi]
    DIM p AS STRING : p = pfadFuer$(z, auswahl)
    IF JSON_HAS(doc, p) THEN GUI_SET_PICKED_COLOR(farbWahl, INT(JSON_GET_FLOAT(doc, p))) ELSE GUI_SET_PICKED_COLOR(farbWahl, &H2BA8E0)
    ' Am Farbfeld haengen, nicht am Bereich.
    GUI_WINDOW_DESTROY(farbPop)
    farbPop = GUI_POPOVER(z.ed, 236, 236, "links")
    farbWahl = GUI_COLORPICKER(farbPop, 8, 8, 220, 180)
    farbVorgabe = GUI_BUTTON(farbPop, tr$("Vorgabe des Themas"), 8, 196, 220, 30)
    IF JSON_HAS(doc, p) THEN GUI_SET_PICKED_COLOR(farbWahl, INT(JSON_GET_FLOAT(doc, p)))
    GUI_POPOVER_SHOW(farbPop)
END SUB

SUB farbePruefen()
    IF farbZeile < 0 THEN RETURN
    DIM z AS InspZeile : z = inspZeilen[farbZeile]
    DIM ziele AS ARRAY OF INTEGER
    IF auswahl < 0 THEN RETURN
    ziele = gewaehlt
    DIM i AS INTEGER
    IF GUI_CHANGED(farbWahl) THEN
        FOR EACH i IN ziele
            JSON_SET_INT(doc, wz$(i, z.schluessel), GUI_PICKED_COLOR(farbWahl))
        NEXT
        farbfeldZeigen(z, wz$(auswahl, z.schluessel))
        entwurfBauen()
    END IF
    IF GUI_CLICKED(farbVorgabe) THEN
        FOR EACH i IN ziele
            IF JSON_HAS(doc, wz$(i, z.schluessel)) THEN JSON_REMOVE(doc, wz$(i, z.schluessel))
        NEXT
        farbfeldZeigen(z, wz$(auswahl, z.schluessel))
        entwurfBauen()
        GUI_POPOVER_HIDE(farbPop)
    END IF
    IF GUI_POPOVER_CLOSED(farbPop) OR NOT GUI_WINDOW_SHOWN(farbPop) THEN
        IF JSON_STRINGIFY(doc) <> staende[standPos] THEN
            merken()
            werkzeugeNachziehen()
            protokoll("inspektor " + z.schluessel)
        END IF
        farbZeile = -1
    END IF
END SUB

' --- Auswahlen aus dem Projekt (Daten) ------------------------------------------
FUNCTION istDatenWahl(schluessel AS STRING) AS BOOLEAN
    RETURN schluessel = "studio_tabelle" OR schluessel = "studio_quelle" OR schluessel = "bind" OR schluessel = "studio_sortieren" OR schluessel = "studio_suchfeld" OR schluessel = "studio_bildspalte"
END FUNCTION

' Die Eintraege einer Daten-Auswahl: zuerst "(keine)", dann die Tabellen des
' Projekts bzw. die Spalten der Tabelle des Fensters -- und der jetzige Wert,
' auch wenn es ihn dort nicht (mehr) gibt, sonst sprang die Auswahl still um.
SUB datenWahlFuellen(z AS InspZeile, jetzt AS STRING)
    DIM liste AS ARRAY OF STRING
    SELECT CASE z.schluessel
        CASE "bind"
            liste = dbSpaltenBild(fensterText$("studio_tabelle"), FALSE)
        CASE "studio_bildspalte"
            liste = dbSpaltenBild(fensterText$("studio_tabelle"), TRUE)
        CASE "studio_quelle"
            liste = dbAlleQuellen()
        CASE "studio_sortieren"
            liste = []
            IF auswahl >= 0 THEN liste = dbQuellSpaltenMit(feldText$(auswahl, "studio_quelle"))
        CASE "studio_suchfeld"
            ' Die Textfelder des Fensters.
            liste = []
            DIM i AS INTEGER
            FOR i = 0 TO anzahl() - 1
                IF feldText$(i, "kind") = "textinput" AND feldText$(i, "name") <> "" THEN ARRAY_PUSH(liste, feldText$(i, "name"))
            NEXT
        CASE ELSE
            liste = dbAlleTabellen()
    END SELECT
    IF jetzt <> "" AND ARRAY_INDEXOF(liste, jetzt) < 0 THEN ARRAY_PUSH(liste, jetzt)
    z.wahl = tr$("(keine)") + IIF(LEN(liste) > 0, ";" + JOIN$(liste, ";"), "")
    GUI_LISTBOX_CLEAR(z.ed)
    DIM t AS STRING
    FOR EACH t IN SPLIT(z.wahl, ";")
        GUI_LISTBOX_ADD(z.ed, t)
    NEXT
END SUB

' Die Kopfzeile einer Tabelle nach ihrer Datenquelle (die Laufzeit setzt sie
' beim Fuellen ohnehin so -- im Entwurf sieht man sie dann schon).
SUB quellKopfSetzen(i AS INTEGER)
    IF feldText$(i, "kind") <> "table" THEN RETURN
    DIM ref AS STRING : ref = feldText$(i, "studio_quelle")
    ' Die Spalten der Quelle; genannte, soweit es sie gibt -- wie im Programm.
    DIM alle AS ARRAY OF STRING : alle = dbQuellSpalten(ref)
    IF LEN(alle) = 0 THEN RETURN
    ' Auch "verweis.spalte" -- in der Schreibweise des Schemas.
    DIM gueltig AS ARRAY OF STRING : gueltig = dbQuellSpaltenMit(ref)
    DIM klein AS ARRAY OF STRING : klein = []
    DIM w AS STRING
    FOR EACH w IN gueltig
        ARRAY_PUSH(klein, LOWER$(w))
    NEXT
    DIM namen AS ARRAY OF STRING : namen = []
    FOR EACH w IN SPLIT(feldText$(i, "studio_spalten"), ";")
        DIM gi AS INTEGER : gi = ARRAY_INDEXOF(klein, LOWER$(TRIM$(w)))
        IF gi >= 0 THEN ARRAY_PUSH(namen, gueltig[gi])
    NEXT
    IF LEN(namen) = 0 THEN namen = alle
    DIM kopf AS JSON_HANDLE : kopf = JSON_NEW_ARRAY()
    FOR EACH w IN namen
        JSON_APPEND_STRING(kopf, "", w)
    NEXT
    JSON_SET_JSON(doc, wz$(i, "table.headers"), kopf)
END SUB

' Die Bedingung einer Liste an der Entwicklungsdatei pruefen und am Feld zeigen.
SUB filterPruefen(z AS InspZeile)
    IF auswahl < 0 THEN RETURN
    DIM f AS STRING : f = dbFilterFehler$(feldText$(auswahl, "studio_quelle"), feldText$(auswahl, "studio_filter"))
    GUI_SET_ERROR(z.ed, IIF(f = "", "", trf$("Die Bedingung geht so nicht: {0}", [f])))
    IF f <> "" THEN protokoll("filter fehler " + f)
END SUB
