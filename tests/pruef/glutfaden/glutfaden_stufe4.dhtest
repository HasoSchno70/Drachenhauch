=== in schritten wie in einem zug
' Der Balken der Oberflaeche: schrittweise gerechnet kommt dasselbe heraus,
' und der Fortschritt waechst bis 1.
IMPORT "helfer.dh"
DIM e AS kern.Importeinstellung : e = giEinstellung(ARG$(0), "ref.json")
DIM p AS kern.Pixelbild : p = giPixel("ref.json", "pixel")
DIM g AS kern.Pixelbild
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/symbole.txt")
DIM ganz AS kern.Muster : ganz = kern.musterAusPixeln(p, g, e, "a", sym)
DIM im AS kern.Bildimport : im = kern.importBeginnen(p, g, e, "b", sym)
DIM n AS INTEGER, vorher AS FLOAT, steigt AS BOOLEAN : steigt = TRUE
WHILE im.schritt(3)
    n = n + 1
    IF im.fortschritt() < vorher THEN steigt = FALSE
    vorher = im.fortschritt()
WEND
PRINT "schritte > 10 "; n > 10; " steigt "; steigt; " ende "; im.fortschritt(); " fertig "; im.fertig()
DIM i AS INTEGER, gleich AS BOOLEAN : gleich = TRUE
FOR i = 0 TO p.breite * p.hoehe - 1
    IF ganz.farben[ganz.ebenen.aktiveEbene().raster[i]].garn.nummer <> im.ergebnis.farben[im.ergebnis.ebenen.aktiveEbene().raster[i]].garn.nummer THEN gleich = FALSE
NEXT
PRINT "gleich "; gleich; " stiche "; im.ergebnis.sticheGesamt() = p.breite * p.hoehe
--- argumente
{sammlung}/../../examples/glutfaden/daten
