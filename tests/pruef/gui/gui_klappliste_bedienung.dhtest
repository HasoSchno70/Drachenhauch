' Klappliste bedienen wie eine Liste (2026-09-23): offen bewegen Pfeile,
' Pos1/Ende und Tippen nur die MARKIERUNG, Enter uebernimmt, ESC verwirft;
' hoechstens 10 Zeilen mit Rad und Rollbalken, nach oben, wenn unten kein
' Platz ist; Tippen waehlt auch bei geschlossener Liste; ein Platzhalter.
' Klappliste bei (10, 10, 190, 28), das Popup darunter ab y 38, Zeilen 22
' hoch. Tasten: Enter 257, ESC 256, ab 264, Ende 269, B 66, K 75.
' Format: docs/werkzeuge.md, dhrt test.

=== pfeile markieren nur, esc verwirft
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 10, 10, 190, 28, ["Apfel", "Birne", "Kirsche"])
GUI_FOCUS(dd)
DIM aenderungen AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DROPDOWN_SELECTED(dd) <> 0 THEN aenderungen = aenderungen + 1
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT GUI_DROPDOWN_TEXT(dd); " zwischendurch anders: "; aenderungen
--- datei ev.txt
c 9
e 0 7 5 295 0 0
e 2 2 257 0 0 0
e 3 1 257 0 0 0
e 5 2 264 0 0 0
e 6 1 264 0 0 0
e 8 2 264 0 0 0
e 9 1 264 0 0 0
e 11 2 256 0 0 0
e 12 1 256 0 0 0

--- umgebung
DHRT_FRAMES=16
--- erwartet
Apfel zwischendurch anders: 0

