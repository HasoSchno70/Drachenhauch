=== die eigene verbindung sieht nur festgeschriebenes
' Dokumentierte Grenze: der Auftrag oeffnet seine EIGENE Verbindung.
' (Bis Stufe 46 in test_hintergrund.py.)
IMPORT "db"
DIM c AS DB_CONN
DIM a AS INTEGER
DIM e AS INTEGER
DIM n AS INTEGER
c = DB_OPEN("d.db")
DB_BEGIN(c)
DB_EXEC(c, "INSERT INTO zahlen VALUES (999, 'neu')")
a = DB_QUERY_START("d.db", "SELECT a FROM zahlen WHERE a = 999")
WHILE NOT DB_QUERY_READY(a)
    SLEEP(1)
WEND
e = DB_QUERY_RESULT(a)
WHILE DB_NEXT(e)
    n = n + 1
WEND
PRINT n
DB_ROLLBACK(c)
DB_CLOSE(c)
--- vorher
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN("d.db")
DB_EXEC(c, "CREATE TABLE zahlen (a INTEGER, b TEXT)")
DB_BEGIN(c)
DIM i AS INTEGER
FOR i = 0 TO 10 - 1
    DB_EXEC(c, "INSERT INTO zahlen VALUES (?, ?)", i, "zeile " + STR$(i))
NEXT
DB_COMMIT(c)
DB_CLOSE(c)
--- erwartet
0
