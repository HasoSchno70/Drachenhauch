Feld 'gibtsnicht' existiert nicht in zaehler

=== feld gewinnt vor methode
' Heisst ein Feld wie eine Methode, liefert der Zugriff weiterhin das
CLASS K
    DIM wert AS INTEGER
    SUB wert2()
    END SUB
END CLASS
DIM k AS K
k = NEW K()
k.wert = 42
PRINT k.wert
--- erwartet
42

=== timer ruft gebundene methode
CLASS Zaehler
    DIM stand AS INTEGER
    SUB tick()
        Self.stand = Self.stand + 1
    END SUB
    FUNCTION mal(x AS INTEGER) AS INTEGER
        RETURN x * Self.stand
    END FUNCTION
END CLASS

IMPORT "timer"
DIM z AS Zaehler
z = NEW Zaehler()
TIMER_AFTER(0, z.tick)
TIMER_UPDATE()
PRINT z.stand
--- erwartet
1

=== sort mit gebundenem vergleicher
CLASS Regel
    DIM absteigend AS BOOLEAN
    FUNCTION cmp(a AS INTEGER, b AS INTEGER) AS INTEGER
        IF Self.absteigend THEN RETURN b - a
        RETURN a - b
    END FUNCTION
END CLASS
DIM r AS Regel
r = NEW Regel()
r.absteigend = TRUE
DIM a AS ARRAY OF INTEGER
a = [3, 1, 2]
SORT(a, r.cmp)
PRINT a[0]; a[1]; a[2]
--- erwartet
321

=== task start lehnt gebundene methode ab
' Ein Auftrag laeuft in einem eigenen Prozess -- die Instanz gibt es dort
CLASS Zaehler
    DIM stand AS INTEGER
    SUB tick()
        Self.stand = Self.stand + 1
    END SUB
    FUNCTION mal(x AS INTEGER) AS INTEGER
        RETURN x * Self.stand
    END FUNCTION
END CLASS

DIM z AS Zaehler
z = NEW Zaehler()
TASK_START(z.tick)
--- fehler
TASK_START: 'tick' ist an ein Objekt gebunden. Ein Auftrag laeuft in einem eigenen Prozess und sieht dieses Objekt nicht -- nimm eine freie FUNCTION und gib ihr die Werte als Argumente mit.

