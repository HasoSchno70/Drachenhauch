' Galaga-Buch -- Pilotkapitel "Sprites": die selbst gezeichneten Sprites
' ins Spiel bringen. Statischer Player + Schuss, animierter Gegner (Bee).
'
' Start aus diesem Ordner:
'   .venv\Scripts\python.exe gbrun.py buch\code\sprites\sprites_im_spiel.gb
IMPORT "sprite"

SCREEN(240, 200, "Galaga -- Sprites", 2)

' --- Bilder laden (Pfade relativ zu DIESER .gb-Datei) ---
DIM shipImg AS IMAGE
shipImg = LOADIMAGE("../../assets/sprites/player.png")
DIM shotImg AS IMAGE
shotImg = LOADIMAGE("../../assets/sprites/bullet.png")
DIM beeImg AS IMAGE
beeImg = LOADIMAGE("../../assets/sprites/bee.png")

' --- Aus dem 2-Frame-Sheet ein animiertes SPRITE bauen ---
DIM bee AS SPRITE
bee = SPRITE_NEW(beeImg, 16, 16)          ' Sheet in 16x16-Frames schneiden
SPRITE_ADD_ANIM(bee, "fly", 0, 1, 6)      ' Animation "fly": Frame 0..1, 6 fps
SPRITE_PLAY(bee, "fly")
SPRITE_SET_POS(bee, 112, 40)

DIM shotY AS INTEGER
shotY = 118

WHILE NOT QUITREQUESTED()
    ' Schuss nach oben bewegen (nur fuer die Optik in diesem Beispiel)
    shotY = shotY - 2
    IF shotY < -8 THEN shotY = 150

    CLS(&H0C1020)                         ' dunkler Weltraum-Hintergrund

    DRAWIMAGE(shipImg, 112, 150)          ' Player (statisch, 1 Frame)
    DRAWIMAGE(shotImg, 117, shotY)        ' Schuss

    SPRITE_UPDATE(bee, 16)                ' ~16 ms/Frame -> Fluegelschlag laeuft
    SPRITE_DRAW(bee)                      ' animierter Gegner

    FLIP()
WEND
