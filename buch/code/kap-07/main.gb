' Star Pilot - Kap 7, Endstand: refactor in Funktionen.
'
' Statt einer langen WHILE-Schleife mit allem drin, ist die Logik jetzt
' auf benannte Funktionen verteilt:
'
'   Setup()         - einmal beim Start
'   UpdatePlayer()  - pro Frame: Eingabe + Position
'   DrawPlayer()    - pro Frame: zeichnen
'   Clamp()         - Helfer, Wert in Intervall klemmen
'
' Die WHILE-Schleife ist dadurch wieder ueberschaubar - sie ruft nur
' noch die richtigen Funktionen in der richtigen Reihenfolge auf.

CONST WIDTH        AS INTEGER = 320
CONST HEIGHT       AS INTEGER = 240
CONST BG_COLOR     AS INTEGER = &H141E3C
CONST PLAYER_C     AS INTEGER = &HFFDC00
CONST PLAYER_W     AS INTEGER = 40
CONST PLAYER_H     AS INTEGER = 24
CONST PLAYER_SPEED AS INTEGER = 3

DIM player_x AS INTEGER
DIM player_y AS INTEGER

' --- Helper: einen Wert ins Intervall [lo..hi] klemmen ---
FUNCTION Clamp(wert AS INTEGER, lo AS INTEGER, hi AS INTEGER) AS INTEGER
    IF wert < lo THEN RETURN lo
    IF wert > hi THEN RETURN hi
    RETURN wert
END FUNCTION

' --- Einmal beim Start ---
SUB Setup()
    player_x = WIDTH / 2 - PLAYER_W / 2
    player_y = HEIGHT - PLAYER_H - 16
    SCREEN(WIDTH, HEIGHT, "Star Pilot", 2)
END SUB

' --- Pro Frame: Player aktualisieren ---
SUB UpdatePlayer()
    IF KEYPRESSED(KEY_LEFT) THEN
        player_x -= PLAYER_SPEED
    END IF
    IF KEYPRESSED(KEY_RIGHT) THEN
        player_x += PLAYER_SPEED
    END IF
    player_x = Clamp(player_x, 0, WIDTH - PLAYER_W)
END SUB

' --- Pro Frame: Player zeichnen ---
SUB DrawPlayer()
    BOX(player_x, player_y, player_x + PLAYER_W, player_y + PLAYER_H, PLAYER_C)
END SUB

' --- Hauptprogramm ---
Setup()

WHILE NOT QUITREQUESTED()
    UpdatePlayer()

    CLS(BG_COLOR)
    DrawPlayer()
    FLIP()
    SLEEP(16)
WEND
