' Rezepte aus dem Internet (Spoonacular), wie services/api/spoonacular.py
' der Python-App: suchen (complexSearch), dann die Einzelheiten eines Rezepts
' (information) -- beides im Hintergrund, das Fenster fragt je Bild nach.
' Der Schlüssel kommt aus SPOONACULAR_API_KEY (wie die .env der Python-App),
' sonst aus app_settings (spoonacular_api_key, im Suchfenster eintragbar);
' er geht als Kopfzeile x-api-key hinaus, nicht in der Adresse (die
' Python-App hängte ihn an jede URL, die das Log schrieb). KUEHL_SPOON_URL
' ersetzt die Adresse (für Prüfungen ein Server auf diesem Rechner).
'
' Anders als dort:
'  * Fehler sagt die Suche (kein Schlüssel, falscher Schlüssel, Kontingent
'    aufgebraucht, kein Netz) -- die Python-App zeigte nur "Keine Rezepte
'    gefunden" und schrieb den Grund ins Log.
'  * Mengen nimmt sie metrisch, wo Spoonacular es mitliefert (measures.metric),
'    sonst rechnet sie wie UnitConverter um.
'  * Unbekannte Zeiten (-1 oder null) zählen als keine; fehlen beide, teilt
'    sie readyInMinutes 30/70 wie dort, ohne eine Minute zu verlieren.
'  * Mehrere Abschnitte der Anleitung zählen durch (dort fing jeder wieder
'    bei 1 an) und tragen ihren Namen; eine Anleitung als HTML behält ihre
'    Zeilen.
IMPORT "html"
IMPORT "json"

DIM spoonFehler AS STRING

FUNCTION spoonBasis$() AS STRING
    DIM u AS STRING : u = GETENV$("KUEHL_SPOON_URL")
    IF u = "" THEN RETURN "https://api.spoonacular.com"
    RETURN u
END FUNCTION

FUNCTION spoonSchluessel$() AS STRING
    DIM k AS STRING : k = TRIM$(GETENV$("SPOONACULAR_API_KEY"))
    IF k = "" THEN k = TRIM$(einstellung$("spoonacular_api_key", ""))
    IF k = "dein_api_key_hier" THEN RETURN ""
    RETURN k
END FUNCTION

' Nur Buchstaben, Ziffern und Bindestriche -- dann braucht der JSON-Text in
' app_settings kein Maskieren. FALSE = abgelehnt.
FUNCTION spoonSchluesselSetzen(k AS STRING) AS BOOLEAN
    k = TRIM$(k)
    IF k <> "" AND NOT REGEX_TEST(k, "^[A-Za-z0-9_-]+$") THEN RETURN FALSE
    IF k = "" THEN
        DB_EXEC(db, "DELETE FROM app_settings WHERE key = 'spoonacular_api_key'")
    ELSE
        DB_EXEC(db, "INSERT OR REPLACE INTO app_settings (key, value) VALUES ('spoonacular_api_key', ?)", CHR$(34) + k + CHR$(34))
    END IF
    RETURN TRUE
END FUNCTION

FUNCTION spoonKopf() AS MAP OF STRING
    DIM kopf AS MAP OF STRING
    MAPPUT(kopf, "x-api-key", spoonSchluessel$())
    MAPPUT(kopf, "User-Agent", "Kuehlschrank-App/1.0 (Drachenhauch)")
    MAPPUT(kopf, "Accept", "application/json")
    HTTP_TIMEOUT(10)
    RETURN kopf
END FUNCTION

' Suchen: im Namen (query) oder nach Zutaten (includeIngredients, die mit den
' meisten zuerst). Die Wörter gehen englisch hinaus (Modul Uebersetzung).
FUNCTION spoonSucheStarten(text AS STRING, nachZutaten AS BOOLEAN, anzahl AS INTEGER) AS INTEGER
    DIM url AS STRING : url = spoonBasis$() + "/recipes/complexSearch?number=" + STR$(anzahl) + "&addRecipeInformation=true"
    IF nachZutaten THEN
        url = url + "&includeIngredients=" + URL_ENCODE(zutatenEnglisch$(text)) + "&sort=max-used-ingredients"
    ELSE
        url = url + "&query=" + URL_ENCODE(frageEnglisch$(text))
    END IF
    RETURN HTTP_REQUEST_START("GET", url, "", spoonKopf())
END FUNCTION

FUNCTION spoonDetailsStarten(id AS INTEGER) AS INTEGER
    RETURN HTTP_REQUEST_START("GET", spoonBasis$() + "/recipes/" + STR$(id) + "/information?includeNutrition=false", "", spoonKopf())
END FUNCTION

' Die Antwort eines Abrufs; "" mit spoonFehler, wenn keine kam.
FUNCTION spoonAntwort$(abruf AS INTEGER) AS STRING
    spoonFehler = ""
    DIM antwort AS STRING
    TRY
        antwort = HTTP_RESULT(abruf)
    CATCH fehler
        DIM st AS INTEGER : st = HTTP_STATUS()
        IF st = 401 THEN
            spoonFehler = "Spoonacular kennt den API-Schlüssel nicht (401) -- bitte prüfen."
        ELSEIF st = 402 THEN
            spoonFehler = "Das Tageskontingent von Spoonacular ist aufgebraucht (402) -- morgen geht es wieder."
        ELSEIF st = 0 THEN
            spoonFehler = "Spoonacular ist nicht erreichbar."
        ELSE
            spoonFehler = "Spoonacular antwortet mit Fehler " + STR$(st) + "."
        END IF
        RETURN ""
    END TRY
    RETURN antwort
END FUNCTION

' Die Antwort als JSON; ungültig = ein leeres Objekt und spoonFehler.
FUNCTION spoonJson(antwort AS STRING) AS JSON_HANDLE
    DIM j AS JSON_HANDLE
    spoonFehler = ""
    TRY
        j = JSON_PARSE(antwort)
    CATCH fehler
        spoonFehler = "Ungültige Antwort von Spoonacular."
        RETURN JSON_NEW_OBJECT()
    END TRY
    RETURN j
END FUNCTION

' Eine Zahl oder vorgabe (fehlt, null, kein Zahlwert).
FUNCTION jZahl(j AS JSON_HANDLE, pfad AS STRING, vorgabe AS FLOAT) AS FLOAT
    IF NOT JSON_HAS(j, pfad) THEN RETURN vorgabe
    IF JSON_TYPE(j, pfad) <> "number" THEN RETURN vorgabe
    RETURN JSON_GET_FLOAT(j, pfad)
END FUNCTION

' Text aus HTML: Tags weg, Entities aufgelöst (die Python-App ließ "&amp;"
' stehen), Leerraum je Zeile zusammengezogen, leere Zeilen weg.
FUNCTION htmlText$(h AS STRING) AS STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM z AS STRING
    FOR EACH z IN SPLIT(HTML_TEXT(h), CHR$(10))
        z = TRIM$(REGEX_REPLACE(z, "\s+", " "))
        IF z <> "" THEN ARRAY_PUSH(aus, z)
    NEXT
    RETURN JOIN$(aus, CHR$(10))
END FUNCTION

' Die Treffer einer Suche -- ohne Zutaten und Anleitung, die bringt erst
' spoonDetailsAus.
FUNCTION spoonTreffer(antwort AS STRING) AS ARRAY OF Rezept
    DIM aus AS ARRAY OF Rezept : aus = []
    IF antwort = "" THEN RETURN aus
    DIM j AS JSON_HANDLE : j = spoonJson(antwort)
    IF spoonFehler <> "" THEN RETURN aus
    IF NOT JSON_HAS(j, "results") THEN RETURN aus
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "results") - 1
        DIM p AS STRING : p = "results." + STR$(i) + "."
        DIM x AS Rezept : x = NEW Rezept()
        x.herkunft = "netz"
        x.netzId = INT(jZahl(j, p + "id", 0))
        x.name = TRIM$(jText$(j, p + "title"))
        x.beschreibung = htmlText$(jText$(j, p + "summary"))
        x.portionen = MAX(1, INT(jZahl(j, p + "servings", 1)))
        x.koch = MAX(0, INT(jZahl(j, p + "readyInMinutes", 0)))
        x.adresse = jText$(j, p + "sourceUrl")
        x.zutaten = []
        IF x.netzId > 0 THEN ARRAY_PUSH(aus, x)
    NEXT
    RETURN aus
END FUNCTION

' Die Einzelheiten in x eintragen; FALSE mit spoonFehler.
FUNCTION spoonDetailsAus(x AS Rezept, antwort AS STRING) AS BOOLEAN
    IF antwort = "" THEN RETURN FALSE
    DIM j AS JSON_HANDLE : j = spoonJson(antwort)
    IF spoonFehler <> "" THEN RETURN FALSE
    DIM t AS STRING : t = TRIM$(jText$(j, "title"))
    IF t <> "" THEN x.name = t
    x.beschreibung = htmlText$(jText$(j, "summary"))
    x.portionen = MAX(1, INT(jZahl(j, "servings", 1)))
    DIM vorb AS INTEGER : vorb = MAX(0, INT(jZahl(j, "preparationMinutes", 0)))
    DIM koch AS INTEGER : koch = MAX(0, INT(jZahl(j, "cookingMinutes", 0)))
    DIM fertig AS INTEGER : fertig = MAX(0, INT(jZahl(j, "readyInMinutes", 0)))
    IF vorb = 0 AND koch = 0 AND fertig > 0 THEN
        vorb = INT(fertig * 0.3)
        koch = fertig - vorb
    END IF
    x.vorb = vorb
    x.koch = koch
    x.anleitung = spoonAnleitung$(j)
    x.quelle = jText$(j, "creditsText")
    IF x.quelle = "" THEN x.quelle = "Spoonacular"
    IF jText$(j, "sourceUrl") <> "" THEN x.adresse = jText$(j, "sourceUrl")
    x.zutaten = []
    IF JSON_HAS(j, "extendedIngredients") THEN
        DIM i AS INTEGER
        FOR i = 0 TO JSON_LEN(j, "extendedIngredients") - 1
            ARRAY_PUSH(x.zutaten, spoonZutat(j, "extendedIngredients." + STR$(i) + "."))
        NEXT
    END IF
    x.zutatenZahl = LEN(x.zutaten)
    x.vollstaendig = TRUE
    RETURN TRUE
END FUNCTION

FUNCTION spoonZutat(j AS JSON_HANDLE, p AS STRING) AS Zutat
    DIM z AS Zutat : z = NEW Zutat()
    DIM en AS STRING : en = TRIM$(jText$(j, p + "nameClean"))
    IF en = "" THEN en = TRIM$(jText$(j, p + "name"))
    DIM de AS STRING : de = zutatDeutsch$(en)
    IF de <> "" THEN
        z.name = de
    ELSE
        z.name = en
        z.englisch = TRUE
    END IF
    z.original = jText$(j, p + "original")
    IF JSON_HAS(j, p + "measures.metric.amount") THEN
        einheitUmrechnen(z, jZahl(j, p + "measures.metric.amount", 0), jText$(j, p + "measures.metric.unitShort"))
    ELSE
        einheitUmrechnen(z, jZahl(j, p + "amount", 0), jText$(j, p + "unit"))
    END IF
    RETURN z
END FUNCTION

' analyzedInstructions (je Schritt eine Zeile, durchgezählt, Abschnitte mit
' Namen), sonst instructions als Text, sonst "" (das Fenster sagt dann
' "Keine Anleitung verfügbar." -- die Python-App speicherte den Satz als
' Anleitung, und hier ginge er an den Übersetzer, der Englisch erwartet).
FUNCTION spoonAnleitung$(j AS JSON_HANDLE) AS STRING
    DIM zeilen AS ARRAY OF STRING : zeilen = []
    IF JSON_HAS(j, "analyzedInstructions") THEN
        DIM n AS INTEGER : n = 0
        DIM a AS INTEGER
        FOR a = 0 TO JSON_LEN(j, "analyzedInstructions") - 1
            DIM p AS STRING : p = "analyzedInstructions." + STR$(a) + "."
            DIM titel AS STRING : titel = TRIM$(jText$(j, p + "name"))
            IF titel <> "" THEN ARRAY_PUSH(zeilen, titel + ":")
            IF NOT JSON_HAS(j, p + "steps") THEN CONTINUE
            DIM s AS INTEGER
            FOR s = 0 TO JSON_LEN(j, p + "steps") - 1
                DIM schritt AS STRING : schritt = TRIM$(jText$(j, p + "steps." + STR$(s) + ".step"))
                IF schritt = "" THEN CONTINUE
                n = n + 1
                ARRAY_PUSH(zeilen, STR$(n) + ". " + schritt)
            NEXT
        NEXT
        IF n > 0 THEN RETURN JOIN$(zeilen, CHR$(10))
    END IF
    RETURN htmlText$(jText$(j, "instructions"))
END FUNCTION
