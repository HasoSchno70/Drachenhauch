' Fotos -- ein Fotobetrachter mit GTK 3 als Oberflaeche
'
'     dhrt run main.dh                 (Bilder-Ordner des Benutzers)
'     dhrt run main.dh -- C:/Fotos     (dieser Ordner)
'
' Die Oberflaeche ist GTK 3, angesprochen ueber DECLARE ... LIB (docs/ffi.md),
' gestaltet mit einem eigenen Stylesheet (GtkCssProvider): dunkle Flaeche,
' Karten mit runden Ecken, Akzentfarbe fuer die Auswahl. Die Bilder laedt
' GdkPixbuf -- JPEG, PNG, GIF, BMP, TIFF, WebP und was das GTK sonst mitbringt
' --, verkleinert schon beim Laden und nach der Drehung aus den Kameradaten.
'
' Bedienung: Doppelklick oder Enter oeffnet ein Bild, Pfeile blaettern,
' Esc zurueck zur Uebersicht, R/L drehen, 1 = Originalgroesse, Leertaste =
' Diaschau, F11 = Vollbild.
'
' GTK muss da sein: unter Linux fast immer (Paket libgtk-3-0), unter macOS ueber
' Homebrew (brew install gtk+3), unter Windows aus MSYS2 im PATH -- oder aus
' Inkscape, das es mitbringt. Mit --probe fuehrt sich das Programm selbst vor
' und endet (fuer Pruefungen).

IMPORT "zeit"

' --- Bibliotheken (je System ein Name, durch | getrennt; der erste, der laedt, gilt)
CONST GTK = "libgtk-3-0.dll|C:/Program Files/Inkscape/bin/libgtk-3-0.dll|libgtk-3.so.0|libgtk-3.0.dylib|/opt/homebrew/lib/libgtk-3.0.dylib"
CONST GDK = "libgdk-3-0.dll|C:/Program Files/Inkscape/bin/libgdk-3-0.dll|libgdk-3.so.0|libgdk-3.0.dylib|/opt/homebrew/lib/libgdk-3.0.dylib"
CONST PIX = "libgdk_pixbuf-2.0-0.dll|C:/Program Files/Inkscape/bin/libgdk_pixbuf-2.0-0.dll|libgdk_pixbuf-2.0.so.0|libgdk_pixbuf-2.0.0.dylib|/opt/homebrew/lib/libgdk_pixbuf-2.0.0.dylib"
CONST GOBJECT = "libgobject-2.0-0.dll|C:/Program Files/Inkscape/bin/libgobject-2.0-0.dll|libgobject-2.0.so.0|libgobject-2.0.0.dylib|/opt/homebrew/lib/libgobject-2.0.0.dylib"
CONST GLIB = "libglib-2.0-0.dll|C:/Program Files/Inkscape/bin/libglib-2.0-0.dll|libglib-2.0.so.0|libglib-2.0.0.dylib|/opt/homebrew/lib/libglib-2.0.0.dylib"

