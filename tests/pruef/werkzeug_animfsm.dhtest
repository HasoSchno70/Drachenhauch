IMPORT "json"
IMPORT "animfsm"
IMPORT "sprite"
FUNCTION zustand$(datei AS STRING, speed AS FLOAT, schritt AS BOOLEAN) AS STRING
    DIM sp AS SPRITE : sp = SPRITE_NEW(0, 16, 16)
    DIM fsm AS ANIM_FSM : fsm = ANIM_FSM_LOAD(datei)
    ANIM_FSM_SETUP(fsm, sp)
    IF schritt THEN
        ANIM_FSM_SET_FLOAT(fsm, "speed", speed)
        ANIM_FSM_UPDATE(fsm, sp, 16)
    END IF
    RETURN ANIM_FSM_STATE(fsm)
END FUNCTION
DIM h AS JSON_HANDLE : h = JSON_LOAD("held.dhanim")
DIM n AS INTEGER : n = JSON_LEN(h, "transitions")
DIM p AS STRING : p = "transitions." + STR$(n - 1)
DIM warten AS BOOLEAN : warten = FALSE
IF JSON_HAS(h, p + ".wait_finished") THEN warten = JSON_GET_BOOL(h, p + ".wait_finished")
PRINT n ; " " ; JSON_GET_STRING(h, p + ".from") ; " " ; JSON_GET_STRING(h, p + ".to") ; " " ; JSON_LEN(h, p + ".conditions") ; " " ; warten
' Ohne Bedingung feuert der neue Uebergang sofort.
PRINT "laufzeit " + zustand$("held.dhanim", 0.0, TRUE)
--- erwartet
6 idle fall 0 FALSE
laufzeit fall

