=== deckkraft steht im text nur wenn sie gesetzt ist
' Oberstes Byte 0 heisst DECKEND -- dann gehört es auch nicht in den
PRINT COLOR_HEX$(&HFF8800); " "; COLOR_HEX$(&H80FF8800)
--- erwartet
#FF8800 #80FF8800

=== ohne alpha bleibt es bei sechs stellen
' Programme, die den Wähler schon benutzen, bekommen weiterhin
IMPORT "gui"
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)

DIM cp AS GUI_WIDGET
cp = GUI_COLORPICKER(w, 10, 10, 200, 150)
GUI_SET_PICKED_COLOR(cp, &H80FF8800)
PRINT COLOR_HEX$(GUI_PICKED_COLOR(cp))
--- erwartet
#FF8800

=== mit alpha kommt die deckkraft mit
IMPORT "gui"
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)

DIM cp AS GUI_WIDGET
cp = GUI_COLORPICKER(w, 10, 10, 200, 150)
GUI_COLORPICKER_SET(cp, "alpha", 1)
GUI_SET_PICKED_COLOR(cp, &H80FF8800)
PRINT COLOR_HEX$(GUI_PICKED_COLOR(cp))
--- erwartet
#80FF8800

=== unbekannte einstellung wird abgelehnt
IMPORT "gui"
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)

DIM cp AS GUI_WIDGET
cp = GUI_COLORPICKER(w, 10, 10, 200, 150)
TRY
    GUI_COLORPICKER_SET(cp, "durchsicht", 1)
    PRINT "angenommen"
CATCH e
    PRINT "abgelehnt"
END TRY
--- erwartet
abgelehnt

=== grenzen ziehen ein datum herein
' Sonst stünde im Feld ein Wert, den der Wähler selbst nicht zulässt.
IMPORT "gui"
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)

DIM dp AS GUI_WIDGET
dp = GUI_DATEPICKER(w, 10, 10, 300, 220)
GUI_SET_DATE(dp, "2026-01-01")
GUI_DATE_RANGE(dp, "2026-09-05", "2026-09-25")
PRINT GUI_DATE(dp)
GUI_SET_DATE(dp, "2026-12-31")
GUI_DATE_RANGE(dp, "2026-09-05", "2026-09-25")
PRINT GUI_DATE(dp)
--- erwartet
2026-09-05
2026-09-25

=== leere grenze hebt sie auf
IMPORT "gui"
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)

DIM dp AS GUI_WIDGET
dp = GUI_DATEPICKER(w, 10, 10, 300, 220)
GUI_DATE_RANGE(dp, "2026-09-05", "")
GUI_SET_DATE(dp, "2030-01-01")
PRINT GUI_DATE(dp)
--- erwartet
2030-01-01

=== verdrehte grenzen werden abgelehnt
IMPORT "gui"
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)

DIM dp AS GUI_WIDGET
dp = GUI_DATEPICKER(w, 10, 10, 300, 220)
TRY
    GUI_DATE_RANGE(dp, "2026-09-25", "2026-09-05")
    PRINT "angenommen"
CATCH e
    PRINT "abgelehnt"
END TRY
--- erwartet
abgelehnt

=== wochenbeginn wird angenommen
IMPORT "gui"
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)

DIM dp AS GUI_WIDGET
dp = GUI_DATEPICKER(w, 10, 10, 300, 220)
GUI_DATEPICKER_SET(dp, "wochenbeginn", 6)
TRY
    GUI_DATEPICKER_SET(dp, "wochenanfang", 6)
    PRINT "angenommen"
CATCH e
    PRINT "unbekannter Schluessel abgelehnt"
END TRY
--- erwartet
unbekannter Schluessel abgelehnt

