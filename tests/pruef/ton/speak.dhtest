=== anhaengen reiht, unterbrechen ersetzt
' Zwei angehaengte Saetze dauern rund doppelt so lang wie einer, der den ersten
' unterbricht. Gemessen ueber SPEAK_WAIT -- die Warteschlange laeuft auf Kiras
' Audio-Faden, nicht ueber FLIP.
IMPORT "helfer.dh"
TRY
    DIM t AS INTEGER
    t = MILLIS()
    SPEAK("Der Drache erwacht")
    SPEAK("Der Drache erwacht")
    SPEAK_WAIT()
    DIM zwei AS INTEGER : zwei = MILLIS() - t
    t = MILLIS()
    SPEAK("Der Drache erwacht")
    SPEAK("Der Drache erwacht", TRUE)
    SPEAK_WAIT()
    DIM eins AS INTEGER : eins = MILLIS() - t
    PRINT "unterbrochen ueber 300 ms "; (eins > 300)
    PRINT "angehaengt mehr als 1,6-mal so lang "; (zwei * 10 > eins * 16)
    IF NOT (zwei * 10 > eins * 16) THEN PRINT "angehaengt "; zwei; " ms, unterbrochen "; eins; " ms"
CATCH e
    fehlerOderSprung(e)
END TRY
--- datei helfer.dh
IMPORT "audio"
' Fehlt die Systemstimme oder ein Audio-Geraet, ueberspringt sich der Fall --
' mit dem, was fehlt. Jeder andere Fehler bleibt einer.
SUB fehlerOderSprung(e AS STRING)
    DIM sprung AS BOOLEAN : sprung = FALSE
    IF INSTR(e, "keine Sprachausgabe") >= 0 OR INSTR(e, "Audio-Geraet") >= 0 THEN sprung = TRUE
    IF INSTR(e, "keine Systemstimme") >= 0 OR INSTR(e, "nicht verfuegbar") >= 0 THEN sprung = TRUE
    ' "nicht gefunden" heisst auch: das Werkzeug (say, espeak-ng) fehlt. Die
    ' Meldung zu einer unbekannten Stimme ist aber KEIN fehlendes Werkzeug.
    IF INSTR(e, "nicht gefunden") >= 0 AND INSTR(e, "SPEAK_VOICE: Stimme") < 0 THEN sprung = TRUE
    IF sprung THEN
        PRINT "UEBERSPRINGEN: keine Sprachausgabe: " + e
        EXIT(0)
    END IF
    PRINT "FEHLER: " + e
END SUB
--- erwartet
unterbrochen ueber 300 ms TRUE
angehaengt mehr als 1,6-mal so lang TRUE

=== stimmen auflisten und waehlen
' Gross/klein spielt keine Rolle, "" heisst: die Vorgabe des Systems.
IMPORT "helfer.dh"
TRY
    DIM v AS ARRAY OF STRING
    v = SPEAK_VOICES()
    PRINT LEN(v) > 0
    SPEAK_VOICE(v[0])
    SPEAK_VOICE(UPPER$(v[0]))
    SPEAK_VOICE("")
    PRINT SPEAK_SOUND("Hallo") >= 0
CATCH e
    fehlerOderSprung(e)
END TRY
--- datei helfer.dh
IMPORT "audio"
' Fehlt die Systemstimme oder ein Audio-Geraet, ueberspringt sich der Fall --
' mit dem, was fehlt. Jeder andere Fehler bleibt einer.
