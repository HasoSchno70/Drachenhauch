IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
CONST GLUTORDNER = "{sammlung}/../../examples/glutfaden"
--- erwartet
tafel ueber 1500: TRUE | doppelt 0 | leer 0
dateien ueber 20: TRUE | texte ueber 1500: TRUE | kuerzel-namen 77 | aus kern-listen ueber 100: TRUE
fehlen in der tafel: 0
andere platzhalter: 0
falsch eingepackt: 0
verwaist: 0

=== kern: sprache, uebersetzen, kuerzel, zahlen, einstellung
IMPORT "helfer.dh"
' "auto" folgt der Systemsprache, Unbekanntes gilt als auto
PRINT "aufloesen: "; kern.spracheAufloesen$("auto", "de_DE"); " "; kern.spracheAufloesen$("auto", "de-AT"); " "; kern.spracheAufloesen$("auto", "en-US"); " "; kern.spracheAufloesen$("auto", ""); " "; kern.spracheAufloesen$(" DE ", "en"); " "; kern.spracheAufloesen$("en", "de"); " "; kern.spracheAufloesen$("fr", "de")
' Fehlt die Tafel, bleibt es deutsch
PRINT "ohne datei: "; kern.spracheLaden("en", "gibtsnicht.txt"); " "; kern.spracheJetzt$(); " "; kern.englisch()
' Deutsch: alles unveraendert
PRINT "de: "; kern.spracheLaden("de", "gibtsnicht.txt"); " | "; kern.tr$("Sichern"); " | "; kern.trf$("Die Ebene „{0}“ ist gesperrt.", ["Rand"]); " | "; kern.kuerzelAnzeige$("Strg+Umschalt+S, Entf"); " | "; kern.zahlAnzeige$(1234.5, 1); " | "; kern.zahlAnzeige$(0.25, -1)
' Eine eigene Tafel: Kommentar, CR am Zeilenende, ein Tabulator im Englischen
WRITEALL("t.txt", "# Kommentar" + CHR$(10) + "Sichern" + CHR$(9) + "Save" + CHR$(13) + CHR$(10) + "{0} von {1}" + CHR$(9) + "{0} of {1}" + CHR$(10) + "zwei" + CHR$(9) + "a" + CHR$(9) + "b" + CHR$(10) + "ohne tabulator" + CHR$(10))
PRINT "geladen: "; kern.spracheLaden("en", "t.txt"); " "; kern.spracheJetzt$(); " "; kern.englisch()
PRINT "en: "; kern.tr$("Sichern"); " | fehlt bleibt: "; kern.tr$("Öffnen"); " | "; REPLACE$(kern.tr$("zwei"), CHR$(9), "<tab>"); " | kommentar: "; kern.tr$("# Kommentar"); " | "; kern.tr$("ohne tabulator")
' Die Werte werden nach dem Uebersetzen eingesetzt und nicht noch einmal gelesen
PRINT "trf: "; kern.trf$("{0} von {1}", ["3", "7"]); " | "; kern.trf$("{0} von {1}", ["{1}", "x"]); " | unbekannt: "; kern.trf$("{0} und {1}", ["a", "b"]); " | zu wenig: "; kern.trf$("{0} von {1}", ["3"])
PRINT "kuerzel: "; kern.kuerzelAnzeige$("Strg+Umschalt+Entf, Alt+Bild auf, Leertaste"); " | "; kern.kuerzelAnzeige$("Strg+Y, Strg+Umschalt+Z"); " | "; kern.kuerzelAnzeige$("Einfg, Pos1, Ende, Bild ab, Rücktaste, Enter, Tab, Esc, Strg+Komma, Strg+Punkt, Alt+Links, Plus"); " | "; kern.kuerzelAnzeige$("F1"); " | leer '"; kern.kuerzelAnzeige$(""); "'"
PRINT "zahlen: "; kern.zahlAnzeige$(1234567.891, 2); " | "; kern.zahlAnzeige$(2.5, 1); " | "; kern.zahlAnzeige$(400000, -1); " | "; kern.zahlAnzeige$(-1234.5, 1); " | "; kern.zahlAnzeige$(7, 0)
' Die echte Tafel: Kuerzel-Liste und Farbenblindheit auf Englisch
PRINT "echte tafel: "; kern.spracheLaden("en", GLUTORDNER + "/daten/sprache/en.txt")
DIM es AS kern.Einstellungen : es = NEW kern.Einstellungen()
DIM zl AS STRING
FOR EACH zl IN kern.kuerzelListe(es)
    IF INSTR(zl, "Undo") = 0 OR INSTR(zl, "Redo") = 0 OR INSTR(zl, "Save as") = 0 OR INSTR(zl, "Delete") = 0 THEN PRINT "  "; REPLACE$(zl, CHR$(9), " -> ")
NEXT
PRINT "farbenblind: "; JOIN$(kern.farbenblindNamen(), " / ")
kern.spracheLaden("de", "")
PRINT "zurueck: "; REPLACE$(kern.kuerzelListe(es)[0], CHR$(9), " -> "); " | "; kern.farbenblindNamen()[1]
' Die Einstellung ui_language: Vorgabe auto, gemerkt, Unbekanntes wird auto
PRINT "vorgabe '"; es.sprache; "'"
es.sprache = "en"
WRITEALL("es.json", kern.einstellungenJson$(es))
FOR EACH zl IN READLINES("es.json")
    IF INSTR(zl, "ui_language") >= 0 THEN PRINT TRIM$(zl)
NEXT
PRINT "gelesen '"; kern.einstellungenLaden("es.json").sprache; "'"
WRITEALL("krumm.json", "{" + CHR$(34) + "ui_language" + CHR$(34) + ": " + CHR$(34) + "fr" + CHR$(34) + "}")
PRINT "krumm '"; kern.einstellungenLaden("krumm.json").sprache; "'"
WRITEALL("de.json", "{" + CHR$(34) + "ui_language" + CHR$(34) + ": " + CHR$(34) + "de" + CHR$(34) + "}")
PRINT "deutsch '"; kern.einstellungenLaden("de.json").sprache; "'"
