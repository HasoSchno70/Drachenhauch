=== mod folgt dem vorzeichen des teilers
FUNCTION r(a AS INTEGER, b AS INTEGER) AS INTEGER
    RETURN a MOD b
END FUNCTION
FUNCTION rf(a AS FLOAT, b AS FLOAT) AS FLOAT
    RETURN a MOD b
END FUNCTION
FUNCTION g(a AS INTEGER, b AS INTEGER) AS INTEGER
    RETURN a \ b
END FUNCTION
PRINT r(-17, 5); " "; r(17, -5); " "; r(-17, -5); " "; r(17, 5); " "; r(-15, 5)
