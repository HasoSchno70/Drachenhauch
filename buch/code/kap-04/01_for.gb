' FOR/TO/NEXT: zaehlende Schleife.
'
' Ohne STEP zaehlt FOR von start bis end inklusive in Einer-Schritten.
' Mit STEP kann die Schrittweite (auch negativ) angepasst werden.

' Quadrate von 1 bis 10
DIM i AS INTEGER
PRINT "Quadrate:"
FOR i = 1 TO 10
    PRINT f"  {i}^2 = {i * i}"
NEXT i

' Mit STEP -1: Countdown von 5
PRINT ""
PRINT "Countdown:"
DIM j AS INTEGER
FOR j = 5 TO 1 STEP -1
    PRINT f"  {j}..."
NEXT j
PRINT "  Start!"
