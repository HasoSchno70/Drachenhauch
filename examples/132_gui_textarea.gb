' ============================================================
'  GAMEBASIC -- gui-Modul: mehrzeiliges Textfeld + modale Dialoge
' ============================================================
'  GUI_TEXTAREA(win, x, y, w, h[, platzhalter$]) ist ein mehrzeiliges Textfeld:
'  tippen, ENTER = neue Zeile, Pfeile (auch hoch/runter)/Home/End/Maus zum
'  Navigieren, vertikal scrollend. GUI_MESSAGE/GUI_CONFIRM sind native modale
'  Dialoge (Info bzw. OK/Abbrechen -> BOOLEAN).
'  TAB wechselt den Fokus zwischen den Feldern.   [ESC] Ende
' ============================================================
IMPORT "gui"
SCREEN(1180, 760, "GameBasic - TextArea + Dialoge", 1)
SETFPS(60)

DIM uiFont AS INTEGER : uiFont = -1
DIM fp AS STRING
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "C:/Windows/Fonts/calibri.ttf", "C:/Windows/Fonts/arial.ttf")
    IF uiFont < 0 AND FILEEXISTS(fp) THEN uiFont = LOADFONT(fp, 32)
NEXT
IF uiFont >= 0 THEN SETFONT(uiFont)
TEXT_SIZE(16)
GUI_THEME_PRESET("modern_dark")

DIM SW AS INTEGER : SW = SCREENWIDTH()
DIM SH AS INTEGER : SH = SCREENHEIGHT()
DIM NL AS STRING : NL = CHR$(10)

DIM win AS GUI_WINDOW
win = GUI_WINDOW("Notiz", (SW - 620) \ 2, (SH - 480) \ 2, 620, 480)

DIM lbl AS GUI_WIDGET : lbl = GUI_LABEL(win, "Beschreibung:", 24, 18)
DIM titel AS GUI_WIDGET : titel = GUI_TEXTINPUT(win, 24, 44, 560, 32, "Titel ...")
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(win, 24, 88, 560, 270, "Hier mehrzeilig tippen ...")
GUI_SET_TEXT(ta, "Zeile eins." + NL + "Zeile zwei." + NL + "ENTER macht eine neue Zeile," + NL + "Pfeile/Maus zum Navigieren.")

DIM save AS GUI_WIDGET : save = GUI_BUTTON(win, "Speichern", 24, 372, 200, 38)
DIM del AS GUI_WIDGET : del = GUI_BUTTON(win, "Loeschen", 244, 372, 200, 38)

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    GUI_UPDATE()
    IF GUI_CLICKED(save) THEN GUI_MESSAGE("Gespeichert", "Notiz gespeichert:" + NL + NL + GUI_TEXT(ta))
    IF GUI_CLICKED(del) THEN
        IF GUI_CONFIRM("Loeschen?", "Wirklich den gesamten Text loeschen?") THEN GUI_SET_TEXT(ta, "")
    END IF

    GRADIENTV(0, 0, SW - 1, SH - 1, &H0C1118, &H1A2330)
    TEXT(20, 12, "TextArea: tippen, ENTER=neue Zeile, Pfeile/Maus | Buttons = modale Dialoge | TAB wechselt Felder | [ESC] Ende", &HC0D0E0)
    GUI_DRAW()
    FLIP()
WEND
