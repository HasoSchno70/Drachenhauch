=== open food facts: cache zuerst, im hintergrund, nicht gefunden, kein netz
' Ein Fund kommt in den Cache (mit Zeitstempel), "status 0" als nicht
' gefunden; beim zweiten Mal fragt niemand das Netz. Ohne Namen der deutsche
' aus den Rohdaten, die Kategorien aus den Tags. Ein HTTP-Fehler kommt nicht
' in den Cache.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
COPYFILE(ARG$(2), CWD$() + "/bild.png")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
DIM srv AS INTEGER : srv = kOffStarten(ARG$(3))
PRINT "code "; kProbe(p, "probe.dh", "", 1500)
PRINT "anfragen "; kOffAnfragen$()
PRINT "kennung "; INSTR(READALL(CWD$() + "/anfragen.txt"), "Kuehlschrank-App/1.0") >= 0
kOffEnde(srv)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
{sammlung}/../../../daten/bilder/logo.png
{sammlung}/../_hilfen/off_server.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
FUNCTION holen(b AS STRING) AS Fund
    DIM a AS INTEGER : a = offStarten(b)
    DIM n AS INTEGER
    WHILE NOT HTTP_READY(a) AND n < 600 AND studioBild()
        n = n + 1
    WEND
    RETURN offAbholen(a, b)
END FUNCTION
SUB zeigen(wann AS STRING, f AS Fund)
    IF f IS NIL THEN
        PRINT wann; " NIL"
        RETURN
    END IF
    PRINT wann; " gefunden "; f.gefunden; " cache "; f.ausCache; " | "; f.anzeigeName$(); " | "; f.marke; " | "; f.kategorien; " | "; f.menge; " | "; f.nutriScore; " | "; JOIN$(f.allergene, ","); " | bild "; RIGHT$(f.bildUrl, 9); " | "; REGEX_REPLACE(f.fehler, "http://[^ ]+", "URL")
END SUB
zeigen("4001 vorher", offAusCache("4001"))
DIM f AS Fund : f = holen("4001")
zeigen("4001 netz", f)
PRINT "notizen "; REPLACE$(f.notizen$(), CHR$(10), " / ")
zeigen("4001 cache", offAusCache("4001"))
f = holen("4002")
zeigen("4002 netz", f)
PRINT "4002 tags "; fundKategorien$(f); " | ort "; vorschlagOrt$(f.anzeigeName$(), fundKategorien$(f))
zeigen("4005 netz", holen("4005"))
zeigen("4003 netz", holen("4003"))
zeigen("4003 cache", offAusCache("4003"))
zeigen("4004 netz", holen("4004"))
zeigen("4004 cache", offAusCache("4004"))
DIM n AS INTEGER, g AS INTEGER, ng AS INTEGER
(n, g, ng) = cacheZahlen()
PRINT "cache "; n; " "; g; " "; ng; " | 4001 am "; LEFT$(JSON_GET_STRING(JSON_PARSE(READALL(cachePfad$())), "4001.cached_at"), 11)
END
--- erwartet
4001 vorher NIL
4001 netz gefunden TRUE cache FALSE | Vollmilch 3,5 % | Weidemilch | Milchprodukte, Milch | 1 l | b | en:milk | bild /bild.png | 
notizen Packungsgröße: 1 l / Nutri-Score: B / Allergene: milk
4001 cache gefunden TRUE cache TRUE | Vollmilch 3,5 % | Weidemilch | Milchprodukte, Milch | 1 l | b | en:milk | bild /bild.png | 
4002 netz gefunden TRUE cache FALSE | Basmati Reis |  |  |  |  |  | bild  | 
4002 tags rices, cereals | ort Vorratsraum
4005 netz gefunden TRUE cache FALSE | Haferflocken zart | Hausmarke |  |  |  |  | bild  | 
4003 netz gefunden FALSE cache FALSE | Unbekannt (4003) |  |  |  |  |  | bild  | Produkt nicht in Open Food Facts gefunden
4003 cache gefunden FALSE cache TRUE | Unbekannt (4003) |  |  |  |  |  | bild  | Produkt wurde zuvor nicht gefunden (aus Cache)
4004 netz gefunden FALSE cache FALSE | Unbekannt (4004) |  |  |  |  |  | bild  | Netzwerkfehler: HTTP 404 Not Found - URL
4004 cache NIL
cache 4 3 1 | 4001 am 2026-11-08T
code 0
anfragen /api/v0/product/4001.json /api/v0/product/4002.json /api/v0/product/4005.json /api/v0/product/4003.json /api/v0/product/4004.json
