=== vec2 equality (1)
IMPORT "vec2"
DIM a AS VEC2
DIM b AS VEC2
DIM c AS VEC2
a = VEC2_NEW(1.0, 2.0)
b = VEC2_NEW(1.0, 2.0)
c = VEC2_NEW(1.0, 3.0)
PRINT a = b
PRINT a = c
PRINT a <> c
--- erwartet
TRUE
FALSE
TRUE

=== vec2 equality (2)
IMPORT "vec2"
DIM a AS VEC2
DIM b AS VEC2
DIM c AS VEC2
a = VEC2_NEW(1.0, 2.0)
b = VEC2_NEW(1.0, 2.0)
c = VEC2_NEW(1.0, 3.0)
PRINT a = b
PRINT a = c
PRINT a <> c
--- erwartet
TRUE
FALSE
TRUE

=== vec2 chained ops (1)
' Komplexere Ausdruecke -- (v + w) * 2 - v.
IMPORT "vec2"
DIM v AS VEC2
DIM w AS VEC2
v = VEC2_NEW(1.0, 1.0)
w = VEC2_NEW(2.0, 3.0)
PRINT (v + w) * 2.0 - v
--- erwartet
Vec2(5.0, 7.0)

=== vec2 chained ops (2)
' Komplexere Ausdruecke -- (v + w) * 2 - v.
IMPORT "vec2"
DIM v AS VEC2
DIM w AS VEC2
v = VEC2_NEW(1.0, 1.0)
w = VEC2_NEW(2.0, 3.0)
PRINT (v + w) * 2.0 - v
--- erwartet
Vec2(5.0, 7.0)

=== vec2 reflect (1)
' Reflexion an x-Achse-Normale.
IMPORT "vec2"
DIM v AS VEC2
DIM n AS VEC2
v = VEC2_NEW(3.0, 4.0)
n = VEC2_NEW(0.0, 1.0)
PRINT VEC2_REFLECT(v, n)
--- erwartet
Vec2(3.0, -4.0)

