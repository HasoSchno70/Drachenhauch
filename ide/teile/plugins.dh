DIM lstPlug AS GUI_WIDGET : lstPlug = GUI_LISTBOX(winPlug, 12, 34, 536, 250, [])
GUI_LISTBOX_SET(lstPlug, "kaestchen", 1)
GUI_LISTBOX_PLACEHOLDER(lstPlug, tr$("Keine Plugins -- „Neues Plugin ...“ legt eins an."))
DIM btnPlugNeu AS GUI_WIDGET : btnPlugNeu = GUI_BUTTON(winPlug, tr$("Neu laden"), 12, 296, 120, 30)
DIM btnPlugOrdner AS GUI_WIDGET : btnPlugOrdner = GUI_BUTTON(winPlug, tr$("Ordner öffnen"), 142, 296, 140, 30)
DIM btnPlugAnlegen AS GUI_WIDGET : btnPlugAnlegen = GUI_BUTTON(winPlug, tr$("Neues Plugin ..."), 292, 296, 126, 30)
DIM btnPlugHolen AS GUI_WIDGET : btnPlugHolen = GUI_BUTTON(winPlug, tr$("Holen ..."), 12, 336, 120, 30)
GUI_TOOLTIP(btnPlugHolen, tr$("Ein Plugin aus github:nutzer/repo@stand, einer https-Adresse oder einem Ordner holen (dhrt paket)"))
DIM btnPlugEntfernen AS GUI_WIDGET : btnPlugEntfernen = GUI_BUTTON(winPlug, tr$("Entfernen"), 142, 336, 140, 30)
GUI_TOOLTIP(btnPlugEntfernen, tr$("Das gewählte geholte Plugin entfernen"))
DIM btnPlugAktuell AS GUI_WIDGET : btnPlugAktuell = GUI_BUTTON(winPlug, tr$("Aktualisieren"), 292, 336, 126, 30)
GUI_TOOLTIP(btnPlugAktuell, tr$("Alle geholten Plugins neu holen und einen neuen Stand annehmen (dhrt paket hole --erneuern)"))
