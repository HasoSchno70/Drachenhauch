Erwartet PERSON (oder eine Unterklasse), erhalten AUTO

=== feld im eigenen objekt ohne self
CLASS Person
END CLASS
CLASS Auto
    DIM besitzer AS Person
    SUB falsch()
        besitzer = NEW Auto()
    END SUB
END CLASS
DIM w AS Auto : w = NEW Auto()
w.falsch()
--- fehler
Erwartet PERSON (oder eine Unterklasse), erhalten AUTO

=== feldelement per array_push und per index
CLASS Form
END CLASS
CLASS Kreis EXTENDS Form
END CLASS
CLASS Auto
END CLASS
DIM formen AS ARRAY OF Form : formen = []
ARRAY_PUSH(formen, NEW Kreis())
PRINT LEN(formen)
TRY
    ARRAY_PUSH(formen, NEW Auto())
CATCH e
    PRINT "push: "; INSTR(e, "Erwartet FORM (oder eine Unterklasse), erhalten AUTO") >= 0
END TRY
TRY
    formen[0] = NEW Auto()
CATCH e
    PRINT "index: "; INSTR(e, "Erwartet FORM (oder eine Unterklasse), erhalten AUTO") >= 0
END TRY
DIM feste[2] AS Form
TRY
    feste[1] = "text"
CATCH e
    PRINT "fest: "; INSTR(e, "Erwartet FORM (oder eine Unterklasse), erhalten STRING") >= 0
END TRY
PRINT LEN(formen); " "; TYPEOF(formen[0])
--- erwartet
1
push: TRUE
index: TRUE
fest: TRUE
1 KREIS

=== map-wert
CLASS Form
END CLASS
CLASS Auto
END CLASS
DIM m AS MAP OF Form
m["a"] = NEW Form()
PRINT MAPSIZE(m)
TRY
    m["b"] = NEW Auto()
CATCH e
    PRINT "index: "; INSTR(e, "Erwartet FORM (oder eine Unterklasse), erhalten AUTO") >= 0
END TRY
TRY
    MAPPUT(m, "c", 7)
CATCH e
    PRINT "mapput: "; INSTR(e, "Erwartet FORM (oder eine Unterklasse), erhalten INTEGER") >= 0
END TRY
PRINT MAPSIZE(m)
--- erwartet
1
index: TRUE
mapput: TRUE
1

