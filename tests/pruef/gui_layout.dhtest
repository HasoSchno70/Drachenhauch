=== kreise und fremde fenster sind fehler
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM s AS GUI_WIDGET : s = GUI_LAYOUT(w, "spalte", 0, 0, 100, 100)
DIM r AS GUI_WIDGET : r = GUI_LAYOUT(w, "raster:2", 0, 0, 10, 10)
GUI_LAYOUT_ADD(s, r)
TRY
    GUI_LAYOUT_ADD(r, s)
CATCH e
    PRINT e
END TRY
TRY
    GUI_LAYOUT_ADD(s, s)
CATCH e2
    PRINT e2
END TRY
DIM w2 AS GUI_WINDOW : w2 = GUI_WINDOW("B", 10, 10, 100, 100)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w2, "x", 0, 0, 40, 20)
TRY
    GUI_LAYOUT_ADD(s, b)
CATCH e3
    PRINT e3
END TRY
TRY
    GUI_LAYOUT(w, "kreis", 0, 0, 10, 10)
CATCH e4
    PRINT e4
END TRY
TRY
    GUI_LAYOUT_SET(s, "farbe", 1)
CATCH e5
    PRINT e5
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
GUI_LAYOUT_ADD: das Widget ist ein Behaelter, in dem dieses Layout schon steckt
GUI_LAYOUT_ADD: ein Layout kann sich nicht selbst aufnehmen
GUI_LAYOUT_ADD: das Widget gehoert zu einem anderen Fenster
GUI_LAYOUT: 'kreis' ist keine Art -- zeile, spalte oder raster:N
GUI_LAYOUT_SET: unbekannter Schluessel 'farbe' -- abstand, rand, ausrichtung, dehnen, rahmen

=== ein behaelter ist luft fuer klicks
' GUI_HIT_TEST ueber einem Behaelter liefert das Kind darunter -- oder
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM z AS GUI_WIDGET : z = GUI_LAYOUT(w, "zeile", 0, 0, 300, 40)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 40, 30)
GUI_LAYOUT_ADD(z, a)
GUI_UPDATE()
PRINT GUI_HIT_TEST(10, 10) = a
PRINT GUI_HIT_TEST(200, 10) = z
PRINT GUI_FOCUSED()
--- umgebung
DHRT_FRAMES=1
--- erwartet
TRUE
FALSE
-1

=== layout ueberlebt die datei
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM s AS GUI_WIDGET : s = GUI_LAYOUT(w, "raster:3", 0, 0, 300, 100)
GUI_LAYOUT_SET(s, "abstand", 2) : GUI_LAYOUT_SET(s, "rand", 4) : GUI_LAYOUT_SET(s, "dehnen", 0)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 0, 0)
GUI_LAYOUT_ADD(s, a, 2) : GUI_LAYOUT_SPACER(s)
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT GUI_TO_JSON(w2) = j
PRINT INSTR(j, "raster") >= 0 ; " " ; INSTR(j, "auto_w") >= 0
--- umgebung
DHRT_FRAMES=1
--- erwartet
TRUE
TRUE TRUE

=== gewichtetes kind faellt nicht unter sein mindestmass
' Ohne Mindestmass wird ein gewichteter Knopf in einer engen Zeile zu
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM z AS GUI_WIDGET : z = GUI_LAYOUT(w, "zeile", 10, 10, 200, 30)
GUI_LAYOUT_SET(z, "abstand", 0)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 50, 30)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "B", 0, 0, 50, 30)
GUI_SET_MIN_SIZE(b, 120, 0)
GUI_LAYOUT_ADD(z, a) : GUI_LAYOUT_ADD(z, b, 1)
GUI_UPDATE()
PRINT GUI_GET_W(b) ; " " ; GUI_LAYOUT_MIN_W(z) ; " " ; GUI_LAYOUT_MIN_H(z)
GUI_SET_BOUNDS(z, 10, 10, 100, 30)
GUI_UPDATE()
PRINT GUI_GET_X(b) ; " " ; GUI_GET_W(b)
--- umgebung
DHRT_FRAMES=1
--- erwartet
150 170 30
60 120

=== mindestmass eines behaelters reicht nach oben
' Ein Behaelter im Behaelter bringt das Mass seines Inhalts mit -- und
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM s AS GUI_WIDGET : s = GUI_LAYOUT(w, "spalte", 0, 0, 300, 200)
GUI_LAYOUT_SET(s, "abstand", 10) : GUI_LAYOUT_SET(s, "rand", 5)
DIM z AS GUI_WIDGET : z = GUI_LAYOUT(w, "zeile", 0, 0, 10, 30)
GUI_LAYOUT_SET(z, "abstand", 4)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 80, 30)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "B", 0, 0, 90, 30)
GUI_LAYOUT_ADD(z, a) : GUI_LAYOUT_ADD(z, b)
DIM t AS GUI_WIDGET : t = GUI_TEXTAREA(w, 0, 0, 100, 60)
GUI_SET_MIN_SIZE(t, 0, 80)
GUI_LAYOUT_ADD(s, z) : GUI_LAYOUT_ADD(s, t, 1)
GUI_UPDATE()
PRINT GUI_LAYOUT_MIN_W(s) ; " " ; GUI_LAYOUT_MIN_H(s)
GUI_SET_BOUNDS(s, 0, 0, 300, 60)
GUI_UPDATE()
PRINT GUI_GET_H(t)
--- umgebung
DHRT_FRAMES=1
--- erwartet
184 130
80

