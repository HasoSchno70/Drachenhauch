=== mediathek kapitel 3: entfernen trifft auch sortiert die richtigen
' Nach Jahr sortiert, Datenzeilen 1 und 2 (Metropolis, Tetris) gewaehlt:
' genau die beiden fallen weg, aus dem Feld wie aus der Tabelle. Von
' vorn nach hinten entfernt fiele Kind of Blue statt Tetris.
prBild = prBild + 1
IF prBild = 2 THEN
    GUI_TABLE_SORT(tabelle, 3, FALSE)
    GUI_TABLE_SELECT(tabelle, 1, TRUE)
    GUI_TABLE_SELECT(tabelle, 2, TRUE)
    auswahl_entfernen()
    PRINT GUI_TEXT(status)
    DIM k AS INTEGER
    DIM gleich AS BOOLEAN : gleich = TRUE
    FOR k = 0 TO LEN(mediathek) - 1
        IF mediathek[k].titel <> GUI_TABLE_GET_CELL(tabelle, k, 0) THEN gleich = FALSE
    NEXT
    PRINT "gleich "; gleich; " | "; mediathek[1].titel; " | "; mediathek[2].titel
    EXIT(0)
END IF
--- programm ../../../buecher/anwendungen/code/kap03/3_auswahl.dh nach     GUI_UPDATE()
