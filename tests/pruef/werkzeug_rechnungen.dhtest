--- nachher
DIM pdf AS BUFFER : pdf = READALL_BYTES("_programm/rechnung_2026-0002.pdf")
DIM auf AS BUFFER : auf = BUFFER_FROM_STRING("stream" + CHR$(10))
DIM zu AS BUFFER : zu = BUFFER_FROM_STRING(CHR$(10) + "endstream")
DIM alles AS STRING : alles = ""
DIM a AS INTEGER : a = BUFFER_INDEXOF(pdf, auf, 0)
WHILE a >= 0
    DIM e AS INTEGER : e = BUFFER_INDEXOF(pdf, zu, a)
    alles = alles + BUFFER_TO_STRING$(BUFFER_INFLATE(BUFFER_SLICE(pdf, a + 7, e)))
    a = BUFFER_INDEXOF(pdf, auf, e + 10)
WEND
DIM w AS ARRAY OF STRING
w = SPLIT$("Rechnung 2026-0002|Anna Berger|Fachbuch Drachenhauch|79,80 EUR|5,59 EUR|85,39 EUR|Drachenhauch Software|Zahlbar innerhalb von 14 Tagen", "|")
DIM i AS INTEGER
FOR i = 0 TO LEN(w) - 1
    PRINT w[i] ; ": " ; INSTR(alles, "(" + w[i]) >= 0 OR INSTR(alles, w[i] + ")") >= 0
NEXT
