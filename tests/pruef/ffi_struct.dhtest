=== bitfelder lesen und schreiben
' Die Lage haengt am System (MSVC unter Windows, GCC/Clang sonst); hier
' nur, was ueberall gleich ist: drei Felder in einer ULONG-Einheit, ein
' Vorzeichen, BOOLEAN, und dass jedes Feld nur seine Bits anfasst.
STRUCT Flags LAYOUT C
    a AS ULONG : 3
    b AS LONG : 5
    c AS ULONG : 24
    d : 1 AS BOOLEAN
    e AS ULONG
END STRUCT
DIM f AS Flags
f.a = 5
f.b = -7
f.c = &HABCDEF
PRINT f.a, f.b, f.c, f.d, f.e
PRINT HEX$(BUFFER_GET_U32(f, 0))
f.d = TRUE
f.e = 42
f.b = 15
PRINT f.a, f.b, f.c, f.d, f.e, SIZEOF(Flags), OFFSETOF(Flags, e)
f.b = -16
PRINT f.b
TRY
    f.b = 16
CATCH e
    PRINT e
END TRY
TRY
    f.a = -1
CATCH e
    PRINT e
END TRY
TRY
    f.d = 1
CATCH e
    PRINT e
END TRY
--- erwartet
5 -7 11259375 FALSE 0
ABCDEFCD
5 15 11259375 TRUE 42 12 8
-16
f.b: 16 passt nicht in ein Bitfeld mit 5 Bits (-16 bis 15)
f.a: -1 passt nicht in ein Bitfeld mit 3 Bits (0 bis 7)
f.d: erwartet einen Wahrheitswert (BOOLEAN), erhalten INTEGER

=== bitfelder: die lage nach den regeln des systems
' char c; int a:4; short s -- GCC und Clang setzen a in die int-Einheit
' des char (Bit 8), MSVC beginnt eine neue (Stelle 4).
STRUCT Bits LAYOUT C
    c AS BYTE
    a AS LONG : 4
    s AS SHORT
END STRUCT
DIM b AS Bits
b.a = -1
PRINT SIZEOF(Bits), OFFSETOF(Bits, s), BUFFER_LEN(b)
DIM z AS STRING
DIM i AS INTEGER
FOR i = 0 TO BUFFER_LEN(b) - 1
    z = z + HEX$(BUFFER_GET(b, i)) + " "
NEXT
PRINT TRIM$(z)
--- system windows
--- erwartet
12 8 12
0 0 0 0 F 0 0 0 0 0 0 0

