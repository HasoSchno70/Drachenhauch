' --- Werkzeugleiste ---------------------------------------------------
' Was man am haeufigsten braucht, als Sinnbild unter dem Menue. Seit Stand
' 26 ist das EIN Widget der Laufzeit: die Leiste verteilt ihre Knoepfe
' selbst und zeichnet die Sinnbilder in ihrer Groesse -- vorher lagen hier
' zwoelf Einzelknoepfe mit 16-Punkt-Bildern, die krumm auf 20 gestreckt
' wurden, und ein Text-"|" als Trenner. Der Befehl je Eintrag steht in
' wzBefehle unter derselben Nummer.
DIM leiste AS GUI_WIDGET : leiste = GUI_TOOLBAR(win, 0, 0, 10, 34)
DIM wzBefehle AS ARRAY OF STRING : wzBefehle = []
SUB wzKnopf(sinnbild AS STRING, tip AS STRING, bef AS STRING)
    GUI_TOOLBAR_ADD(leiste, sinnbild, tr$(tip))
    ARRAY_PUSH(wzBefehle, bef)
END SUB
SUB wzTrenner()
    GUI_TOOLBAR_SEPARATOR(leiste)
    ARRAY_PUSH(wzBefehle, "")
END SUB
wzKnopf("neu", "Neue Datei (Strg+N)", "neu")
wzKnopf("oeffnen", "Öffnen (Strg+O)", "oeffnen")
wzKnopf("sichern", "Sichern (Strg+S)", "sichern")
DIM wzSichern AS INTEGER : wzSichern = LEN(wzBefehle) - 1
wzTrenner()
wzKnopf("start", "Starten (F5)", "start")
wzKnopf("stopp", "Stoppen (Umschalt+F5)", "stopp")
DIM wzStopp AS INTEGER : wzStopp = LEN(wzBefehle) - 1
' Stoppen geht nur, wenn etwas laeuft, Sichern nur mit einem Reiter -- vorher
' sahen beide Knoepfe immer gleich bedienbar aus. Gesetzt wird nur beim
' Wechsel (wzNachziehen in der Bildschleife).
DIM wzStoppAn AS BOOLEAN : wzStoppAn = TRUE
DIM wzSichernAn AS BOOLEAN : wzSichernAn = TRUE
wzKnopf("debug", "Debuggen (F7)", "debuggen")
wzKnopf("pruefen", "Prüfen (Umschalt+F7)", "pruefen")
wzTrenner()
wzKnopf("suchen", "Suchen (Strg+F)", "suchen")
wzKnopf("umbruch", "Zeilenumbruch (Alt+Z)", "umbruch")
DIM wzUmbruch AS INTEGER : wzUmbruch = LEN(wzBefehle) - 1
GUI_TOOLBAR_CHECKABLE(leiste, wzUmbruch, TRUE)
GUI_TOOLBAR_SPACER(leiste)
ARRAY_PUSH(wzBefehle, "")
wzKnopf("handbuch", "Handbuch (F1)", "handbuch")
wzKnopf("einstellungen", "Einstellungen (Strg+U)", "einstellungen")

' --- Showcase: Kacheln mit Vorschaubildern -----------------------------
' Beispiele, die zeigen, was die Sprache kann -- mit einem BILD davon,
' Titel und Kurzbeschreibung. Die Liste steht in examples/showcase.json,
' derselben Datei, aus der tools/showcase_bilder.dh die Bilder unter
' examples/screenshots/ erzeugt (und das Qt-Welcome-Panel liest). Fehlt ein
' Bild dort, entsteht es wie seit Stand 11: das Beispiel laeuft wirklich
' (`dhrt bild`), eines nach dem anderen und unsichtbar, und das Bild liegt
' danach neben der Sitzung. Ohne showcase.json gelten die acht von frueher.
CONST KACHEL_PLAETZE = 32
' Eine Kachel: das Beispiel, Titel, Beschreibung, wie viele Bilder es fuer
' sein Vorschaubild laeuft, dazu ihr Widget (GUI_CARD) und die Textur des
' Bildes. Bis 2026-10-30 sechs Felder nebeneinander.
CLASS Kachel
    DIM datei AS STRING
    DIM name AS STRING
    DIM beschr AS STRING
    DIM bilderZahl AS INTEGER
    DIM karte AS GUI_WIDGET
    DIM textur AS IMAGE
    ' Umgebung fuer den Lauf, der das Vorschaubild macht ("umgebung" in der
    ' Liste) -- so zeigt ein Programm, das auf ein Geraet wartet, seine Demo.
    DIM umgebung AS MAP OF STRING
    SUB Init(d AS STRING, n AS STRING, b AS STRING, z AS INTEGER)
        datei = d : name = n : beschr = b : bilderZahl = z
        karte = -1 : textur = -1
    END SUB
END CLASS
DIM kacheln AS ARRAY OF Kachel : kacheln = []
DIM kai AS INTEGER
DIM showcasePfad AS STRING : showcasePfad = PATHJOIN(beispielOrdner, "showcase.json")
IF FILEEXISTS(showcasePfad) THEN
    TRY
        DIM scListe AS JSON_HANDLE : scListe = JSON_PARSE("{""l"":" + JOIN$(READLINES(showcasePfad), CHR$(10)) + "}")
        FOR kai = 0 TO MIN(JSON_LEN(scListe, "l"), KACHEL_PLAETZE) - 1
            DIM scWo AS STRING : scWo = "l." + STR$(kai) + "."
            DIM scBeschr AS STRING : scBeschr = ""
            IF JSON_HAS(scListe, scWo + "desc") THEN scBeschr = JSON_GET_STRING(scListe, scWo + "desc")
            DIM scBilder AS INTEGER : scBilder = 90
            IF JSON_HAS(scListe, scWo + "frames") THEN scBilder = JSON_GET_INT(scListe, scWo + "frames")
            ARRAY_PUSH(kacheln, NEW Kachel(JSON_GET_STRING(scListe, scWo + "file"), JSON_GET_STRING(scListe, scWo + "title"), scBeschr, scBilder))
            IF JSON_HAS(scListe, scWo + "umgebung") THEN
                DIM scSchl AS STRING
                FOR EACH scSchl IN JSON_KEYS(scListe, scWo + "umgebung")
                    MAPPUT(kacheln[LEN(kacheln) - 1].umgebung, scSchl, JSON_GET_STRING(scListe, scWo + "umgebung." + JSON_KEY$(scSchl)))
                NEXT
            END IF
        NEXT
    CATCH scFehler
        ' Eine kaputte Liste darf die IDE nicht aufhalten: dann die acht.
        kacheln = []
    END TRY
END IF
IF LEN(kacheln) = 0 THEN
    DIM kaAlt AS ARRAY OF STRING
    kaAlt = ["09_shapes.dh", "Formen zeichnen", "10_pong.dh", "Pong", "100_2d_extras.dh", "2D-Extras", _
             "112_physics2d.dh", "Physik", "154_chart.dh", "Diagramme", "156_gui_alle_widgets.dh", "Oberflächen", _
             "95_pbr.dh", "3D mit Licht", "119_vortex.dh", "Effekte"]
    FOR kai = 0 TO LEN(kaAlt) - 1 STEP 2
        ARRAY_PUSH(kacheln, NEW Kachel(kaAlt[kai], kaAlt[kai + 1], "", 90))
    NEXT
END IF
DIM kachelAnzahl AS INTEGER : kachelAnzahl = LEN(kacheln)
' Eine Beschreibung braucht eine eigene Zeile unter dem Titel -- ohne eine
' einzige bleibt die Kachel so hoch wie vorher.
DIM kachelMitText AS BOOLEAN : kachelMitText = FALSE
' Eine Kachel ist EIN Widget (GUI_CARD): Bild, Titel und Beschreibung, und
' ueberall darauf nimmt sie den Klick an. Bis 2026-09-21 waren es drei --
' Bild, Knopf, Beschriftung --, und nur der schmale Knopf reagierte.
' Weggeblaetterte Reihen (Mausrad ueber den Kacheln) und das Feld, in dem
' das Rad zaehlt -- beides setzt `layout`.
DIM kachelVersatz AS INTEGER : kachelVersatz = 0
DIM kachelReihenSichtbar AS INTEGER : kachelReihenSichtbar = 0
DIM kfX AS INTEGER : kfX = 0
DIM kfY AS INTEGER : kfY = 0
DIM kfB AS INTEGER : kfB = 0
DIM kfH AS INTEGER : kfH = 0
DIM lblKacheln AS GUI_WIDGET : lblKacheln = GUI_LABEL(win, tr$("Showcase -- ein Klick öffnet das Beispiel"), 0, 0)
FOR kai = 0 TO kachelAnzahl - 1
    kacheln[kai].karte = GUI_CARD(win, 0, 0, 10, 10, -1, kacheln[kai].name, kacheln[kai].beschr)
    IF kacheln[kai].beschr <> "" THEN
        kachelMitText = TRUE
        GUI_TOOLTIP(kacheln[kai].karte, kacheln[kai].beschr + "  (" + kacheln[kai].datei + ")")
    ELSE
        GUI_TOOLTIP(kacheln[kai].karte, kacheln[kai].datei)
    END IF
NEXT

' Bereiche -- die Masse setzt `layout` bei jeder Groessenaenderung.
' Der Projektbaum ist seit Stand 24 ein DATEIbaum der Laufzeit: er liest
' seinen Ordner selbst, und zwar nur die Aeste, die offen sind. Vorher stand
' hier eine Buchfuehrung aus Dateiliste und Knoten-Nummern, die bei jedem
' Aufbau auseinanderlaufen konnte.
DIM baum AS GUI_WIDGET : baum = GUI_FILETREE(win, 0, 0, 10, 10, ".")
' Rechtsklick im Projektbaum: Dateien und Ordner anlegen, umbenennen,
' loeschen. Das Menue gehoert nur dem Baum (GUI_CONTEXT_WIDGET), der
' Rechtsklick waehlt dabei die Zeile darunter.
DIM ctxBaum AS INTEGER : ctxBaum = GUI_CONTEXT(win)
DIM miBNeuDatei AS INTEGER : miBNeuDatei = GUI_MENU_ITEM(ctxBaum, tr$("Neue Datei ..."))
DIM miBNeuOrdner AS INTEGER : miBNeuOrdner = GUI_MENU_ITEM(ctxBaum, tr$("Neuer Ordner ..."))
GUI_MENU_SEPARATOR(ctxBaum)
DIM miBUmbenennen AS INTEGER : miBUmbenennen = GUI_MENU_ITEM(ctxBaum, tr$("Umbenennen ..."))
DIM miBLoeschen AS INTEGER : miBLoeschen = GUI_MENU_ITEM(ctxBaum, tr$("Löschen ..."))
GUI_MENU_SEPARATOR(ctxBaum)
DIM miBPfad AS INTEGER : miBPfad = GUI_MENU_ITEM(ctxBaum, tr$("Pfad kopieren"))
GUI_CONTEXT_WIDGET(ctxBaum, baum)
' Kontextmenues von Code-Feld und Reiterleiste. Ihre Eintraege rufen
' vorhandene Befehle; sie laufen ueber eine eigene Liste statt ueber die
' Menue-Tafel, damit ein Befehl nicht zweimal ein Kuerzel bekommt.
CLASS KontextEintrag
    DIM item AS INTEGER
    DIM kennung AS STRING
    SUB Init(i AS INTEGER, k AS STRING)
        item = i : kennung = k
    END SUB
END CLASS
DIM ctxEintraege AS ARRAY OF KontextEintrag : ctxEintraege = []
SUB ctxEintrag(menu AS INTEGER, text AS STRING, kennung AS STRING)
    ARRAY_PUSH(ctxEintraege, NEW KontextEintrag(GUI_MENU_ITEM(menu, text), kennung))
END SUB
' Der Eintrag mit dieser Kennung, -1 = keiner.
FUNCTION ctxNr(kennung AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(ctxEintraege) - 1
        IF ctxEintraege[i].kennung = kennung THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION
' Das Code-Feld wechselt mit dem Reiter -- das Menue haengt je Bild an dem
' Code-Feld, ueber dem die Maus steht (kontextNachziehen).
DIM ctxCode AS INTEGER : ctxCode = GUI_CONTEXT(win)
ctxEintrag(ctxCode, tr$("Ausschneiden"), "code_ausschneiden")
ctxEintrag(ctxCode, tr$("Kopieren"), "code_kopieren")
ctxEintrag(ctxCode, tr$("Einfügen"), "code_einfuegen")
GUI_MENU_SEPARATOR(ctxCode)
ctxEintrag(ctxCode, tr$("Zur Definition"), "definition")
ctxEintrag(ctxCode, tr$("Wer ruft das auf?"), "aufrufer")
ctxEintrag(ctxCode, tr$("Umbenennen ..."), "umbenennen")
ctxEintrag(ctxCode, tr$("Schnellkorrektur ..."), "korrektur")
GUI_MENU_SEPARATOR(ctxCode)
ctxEintrag(ctxCode, tr$("Haltepunkt setzen/entfernen"), "haltepunkt")
ctxEintrag(ctxCode, tr$("Im Projektbaum zeigen"), "im_baum_zeigen")
DIM ctxCodeZiel AS GUI_WIDGET : ctxCodeZiel = -1
DIM ctxReiter AS INTEGER : ctxReiter = GUI_CONTEXT(win)
ctxEintrag(ctxReiter, tr$("Schließen"), "reiter_schliessen")
ctxEintrag(ctxReiter, tr$("Andere schließen"), "reiter_andere")
ctxEintrag(ctxReiter, tr$("Rechts davon schließen"), "reiter_rechts")
GUI_MENU_SEPARATOR(ctxReiter)
ctxEintrag(ctxReiter, tr$("Pfad kopieren"), "reiter_pfad")
ctxEintrag(ctxReiter, tr$("Mit gesicherter Fassung vergleichen ..."), "reiter_vergleichen")
ctxEintrag(ctxReiter, tr$("Im Projektbaum zeigen"), "reiter_im_baum")
GUI_CONTEXT_TABS(ctxReiter)
' Strg+Klick sammelt, Umschalt+Klick spannt -- damit sich mehrere Dateien
' auf einmal oeffnen lassen (Datei -> Gewaehlte Dateien oeffnen).
GUI_FILETREE_SET(baum, "mehrfachauswahl", 1)
DIM lblProjekt AS GUI_WIDGET : lblProjekt = GUI_LABEL(win, tr$("Projekt"), 0, 0)
' Filter ueber dem Baum, in der Zeile des Projektnamens -- der Baum bleibt,
' wo er war. Ein Teil des Dateinamens, Gross/klein egal; Ordner bleiben
' stehen (ihr Inhalt wird beim Aufklappen gefiltert).
DIM tfBaumFilter AS GUI_WIDGET : tfBaumFilter = GUI_TEXTINPUT(win, 0, 0, 10, 10, tr$("Filter ..."))
GUI_TOOLTIP(tfBaumFilter, tr$("Nur Dateien, deren Name das enthält"))
DIM baumFilterZuletzt AS STRING : baumFilterZuletzt = ""
DIM lblGliederung AS GUI_WIDGET : lblGliederung = GUI_LABEL(win, tr$("Gliederung"), 0, 0)
DIM lstGliederung AS GUI_WIDGET : lstGliederung = GUI_LISTBOX(win, 0, 0, 10, 10, [])
' Leer sah sie aus wie ein vergessenes Feld.
GUI_LISTBOX_PLACEHOLDER(lstGliederung, tr$("Keine Unterprogramme"))
' Willkommensseite -- sie steht dort, wo sonst die Code-Felder liegen, und
' verschwindet mit dem ersten Reiter.
DIM lblWkTitel AS GUI_WIDGET : lblWkTitel = GUI_LABEL(win, tr$("Drachenhauch"), 0, 0)
GUI_SET_FONT_SIZE(lblWkTitel, 34)
' Ein Bild vorab so verkleinert, dass es in b x h passt, OHNE es zu
' verzerren -- der Kasten bleibt, das Bild steht in seiner Mitte.
FUNCTION bildEingepasst(pfad AS STRING, b AS INTEGER, h AS INTEGER) AS IMAGE
    DIM roh AS IMAGE : roh = LOADIMAGE(pfad)
    DIM f AS FLOAT : f = MIN(b / IMAGEWIDTH(roh), h / IMAGEHEIGHT(roh))
    RETURN IMAGE_SCALE(roh, MAX(1, INT(IMAGEWIDTH(roh) * f + 0.5)), MAX(1, INT(IMAGEHEIGHT(roh) * f + 0.5)))
END FUNCTION

' Der Schriftzug statt des Titels -- vorab auf seine Anzeigegroesse gebracht:
