=== das mausrad rollt den baum weich
' Knoten 5 hat ein gruenes Sinnbild bei x 32..49, y 11 + 110 + 2. Drei
' Radschritte rollen um 66: dann steht es bei y 57..74.
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 280, 200)
DIM gruen AS IMAGE : gruen = IMAGE_NEW(16, 16, &H00FF00)
DIM k AS INTEGER
FOR k = 0 TO 29
    DIM n AS INTEGER : n = GUI_TREE_ADD(t, -1, "Knoten " + STR$(k))
    IF k = 5 THEN GUI_TREE_ICON(t, n, gruen)
NEXT
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 3
e 0 7 5 215 0 0
e 1 7 150 100 0 0
e 2 8 0 -3 0 0

--- umgebung
DHRT_FRAMES=5
--- bild
40 66 nicht #00FF00 +-40

