' Modul `mqtt` (MQTT-3.1.1-Client, QoS 0). Bis Stufe 51 (2026-09-14)
' tests/test_mqtt_module.py mit einem Test-Broker in Python; hier laeuft der
' Broker _hilfen/mqttbroker.dh als eigener Prozess (Pfad ueber `--- argumente`)
' und teilt keinen Code mit dem Rust-Client. Die Byte-Logik selbst pruefen die
' Rust-Tests in mqtt.rs; hier der Weg durch die echte VM.
' Die Registrierung der Befehle steht in builtin_registrierung.dhtest.
' Format: docs/werkzeuge.md, dhrt test.

=== verbindungsaufbau ohne broker ist ein fangbarer fehler
' Kein Broker am Port -- schon der TCP-Aufbau scheitert, also kein Warten auf
' CONNACK; der Fehler muss sich fangen lassen statt abzustuerzen.
IMPORT "mqtt"
DIM h AS MQTT_HANDLE
TRY
    h = MQTT_CONNECT("127.0.0.1", 18999, "dh-test")
    PRINT "verbunden"
CATCH e
    PRINT INSTR(e, "MQTT_CONNECT") >= 0
END TRY
--- erwartet
TRUE

=== veroeffentlichen und abonnieren im rundweg
IMPORT "mqtt"
DIM brokerProzess AS INTEGER
FUNCTION brokerStarten() AS INTEGER
    IF FILEEXISTS("port.txt") THEN DELETEFILE("port.txt")
    brokerProzess = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/port.txt")
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS("port.txt") THEN
            DIM z AS ARRAY OF STRING : z = READLINES("port.txt")
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN VAL(z[0])
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN 0
END FUNCTION

DIM h AS MQTT_HANDLE
h = MQTT_CONNECT("127.0.0.1", brokerStarten(), "dh-e2e-test", 30)
PRINT "connected: ", MQTT_IS_CONNECTED(h)

MQTT_SUBSCRIBE(h, "sensors/temp")
MQTT_PUBLISH(h, "sensors/temp", "21.5")

DIM tries AS INTEGER
DIM got AS BOOLEAN
got = FALSE
FOR tries = 1 TO 40
    MQTT_UPDATE(h)
    IF MQTT_NEXT_MESSAGE(h) THEN
        PRINT "topic: ", MQTT_MESSAGE_TOPIC(h)
        PRINT "payload: ", MQTT_MESSAGE_PAYLOAD(h)
        got = TRUE
        BREAK
    END IF
    SLEEP(25)
NEXT
PRINT "got message: ", got

MQTT_DISCONNECT(h)
PRINT "connected after disconnect: ", MQTT_IS_CONNECTED(h)
IF PROCESS_RUNNING(brokerProzess) THEN PROCESS_KILL(brokerProzess)
--- argumente
{sammlung}/_hilfen/mqttbroker.dh
--- erwartet
connected:  TRUE
topic:  sensors/temp
payload:  21.5
got message:  TRUE
connected after disconnect:  FALSE

=== bricht der broker ab, ist das ein zustand und kein fehler
' Bis 2026.30 warf MQTT_UPDATE (unter Windows 10054), sobald der Broker
' abbrach -- ein Dashboard ohne TRY endete, wenn der Raspberry Pi neu startete
' (Werkstatt-Dashboard, 2026-10-12). Jetzt wird MQTT_IS_CONNECTED FALSE, und
' MQTT_PUBLISH/MQTT_SUBSCRIBE melden FALSE statt zu werfen.
IMPORT "mqtt"
DIM brokerProzess AS INTEGER
FUNCTION brokerStarten(modus AS STRING) AS INTEGER
    IF FILEEXISTS("port.txt") THEN DELETEFILE("port.txt")
    brokerProzess = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/port.txt", modus)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS("port.txt") THEN
            DIM z AS ARRAY OF STRING : z = READLINES("port.txt")
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN VAL(z[0])
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN 0
END FUNCTION
DIM h AS MQTT_HANDLE : h = MQTT_CONNECT("127.0.0.1", brokerStarten(""), "dh-weg", 30)
PRINT "vorher "; MQTT_IS_CONNECTED(h); " "; MQTT_SUBSCRIBE(h, "a/#"); " "; MQTT_PUBLISH(h, "a/b", "x")
PROCESS_KILL(brokerProzess)
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE MQTT_IS_CONNECTED(h) AND MILLIS() - t0 < 5000
    MQTT_UPDATE(h)
    IF MQTT_IS_CONNECTED(h) THEN MQTT_PUBLISH(h, "a/b", "x")
    SLEEP(20)
WEND
PRINT "nachher "; MQTT_IS_CONNECTED(h); " schnell "; MILLIS() - t0 < 5000
PRINT "publish "; MQTT_PUBLISH(h, "a/b", "y"); " subscribe "; MQTT_SUBSCRIBE(h, "c")
MQTT_UPDATE(h)
PRINT "update ohne fehler"
--- argumente
{sammlung}/_hilfen/mqttbroker.dh
--- erwartet
vorher TRUE TRUE TRUE
nachher FALSE schnell TRUE
publish FALSE subscribe FALSE
update ohne fehler

=== ein broker ohne ping-antwort gilt nach der halben keepalive-zeit als weg
' Verschwindet der Broker ohne Abmeldung (Strom weg), kommt kein RST -- der
' Client merkte es bis 2026.30 nie. Jetzt wartet er auf die Antwort zu seinem
' PINGREQ hoechstens die halbe Keepalive-Zeit (mindestens 2 s).
IMPORT "mqtt"
DIM brokerProzess AS INTEGER
FUNCTION brokerStarten(modus AS STRING) AS INTEGER
    IF FILEEXISTS("port.txt") THEN DELETEFILE("port.txt")
    brokerProzess = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/port.txt", modus)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS("port.txt") THEN
            DIM z AS ARRAY OF STRING : z = READLINES("port.txt")
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN VAL(z[0])
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN 0
END FUNCTION
DIM h AS MQTT_HANDLE : h = MQTT_CONNECT("127.0.0.1", brokerStarten("stumm"), "dh-stumm", 2)
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE MQTT_IS_CONNECTED(h) AND MILLIS() - t0 < 8000
    MQTT_UPDATE(h)
    SLEEP(20)
WEND
DIM dauer AS INTEGER : dauer = MILLIS() - t0
PRINT "weg "; NOT MQTT_IS_CONNECTED(h); " nach mehr als 2 s "; dauer > 2000; " vor 6 s "; dauer < 6000
IF PROCESS_RUNNING(brokerProzess) THEN PROCESS_KILL(brokerProzess)
--- argumente
{sammlung}/_hilfen/mqttbroker.dh
--- erwartet
weg TRUE nach mehr als 2 s TRUE vor 6 s TRUE

=== der letzte wille steht im connect-paket
' MQTT_WILL(topic$, inhalt$[, retain]) gilt fuer das naechste MQTT_CONNECT:
' Will-Flag 0x04 und Retain 0x20 im Flag-Byte, Topic und Inhalt hinter der
' Kennung. Gelesen am Draht -- der Test-Broker schreibt das CONNECT als Hex.
' Ohne den Willen blieb ein "online" mit retain fuer immer stehen.
IMPORT "mqtt"
DIM brokerProzess AS INTEGER
FUNCTION brokerStarten(modus AS STRING) AS INTEGER
    IF FILEEXISTS("port.txt") THEN DELETEFILE("port.txt")
    brokerProzess = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/port.txt", modus)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS("port.txt") THEN
            DIM z AS ARRAY OF STRING : z = READLINES("port.txt")
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN VAL(z[0])
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN 0
END FUNCTION
MQTT_WILL("w/status", "offline", TRUE)
DIM h AS MQTT_HANDLE : h = MQTT_CONNECT("127.0.0.1", brokerStarten(""), "id", 30)
MQTT_DISCONNECT(h)
DIM hex AS STRING : hex = READLINES("port.txt.connect")[0]
' Flag-Byte: Kopf (2), "MQTT" mit Laenge (6), Level (1)
PRINT "flags "; MID$(hex, 18, 2)
PRINT "wille "; INSTR(UPPER$(hex), "0008772F7374617475730007") > 0
' Der Wille gilt nur EINMAL: das naechste CONNECT ist ohne
h = MQTT_CONNECT("127.0.0.1", brokerStarten(""), "id", 30)
MQTT_DISCONNECT(h)
hex = READLINES("port.txt.connect")[0]
PRINT "danach "; MID$(hex, 18, 2)
TRY
    MQTT_WILL("w/#", "x")
CATCH e
    PRINT e
END TRY
--- argumente
{sammlung}/_hilfen/mqttbroker.dh
--- erwartet
flags 26
wille TRUE
danach 02
MQTT_WILL: das Topic darf nicht leer sein und keine Platzhalter (# +) enthalten

=== qos 1 in beide richtungen und abmelden
' Der Broker bestaetigt das PUBLISH mit PUBACK und schickt es mit QoS 1 und
' Nummer 77 zurueck -- dann muss der Client seinerseits bestaetigen. Was beim
' Broker ankam, steht in port.txt.log.
IMPORT "start.dh"
DIM h AS MQTT_HANDLE
h = MQTT_CONNECT("127.0.0.1", brokerStarten(""), "dh-qos", 30)
PRINT "abo "; MQTT_SUBSCRIBE(h, "a/b", 1)
PRINT "gesendet "; MQTT_PUBLISH(h, "a/b", "eins", FALSE, 1)
PRINT "offen "; MQTT_PENDING(h)
PRINT "bestaetigt "; MQTT_FLUSH(h, 3000)
PRINT "offen "; MQTT_PENDING(h)
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT MQTT_NEXT_MESSAGE(h) AND MILLIS() - t0 < 3000
    MQTT_UPDATE(h)
    SLEEP(5)
WEND
PRINT MQTT_MESSAGE_TOPIC(h); " = "; MQTT_MESSAGE_PAYLOAD(h)
PRINT "abgemeldet "; MQTT_UNSUBSCRIBE(h, "a/b")
SLEEP(100)
MQTT_UPDATE(h)
MQTT_DISCONNECT(h)
SLEEP(200)
PRINT JOIN$(READLINES("port.txt.log"), " ")
--- datei start.dh
IMPORT "mqtt"
DIM brokerProzess AS INTEGER
FUNCTION brokerStarten(modus AS STRING) AS INTEGER
    IF FILEEXISTS("port.txt") THEN DELETEFILE("port.txt")
    brokerProzess = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/port.txt", modus)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS("port.txt") THEN
            DIM z AS ARRAY OF STRING : z = READLINES("port.txt")
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN VAL(z[0])
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN 0
END FUNCTION

--- argumente
{sammlung}/_hilfen/mqttbroker.dh
--- erwartet
abo TRUE
gesendet TRUE
offen 1
bestaetigt TRUE
offen 0
a/b = eins
abgemeldet TRUE
8/1 3/1 4/77 10 14

=== ohne bestaetigung bleibt die nachricht offen
IMPORT "start.dh"
DIM h AS MQTT_HANDLE
h = MQTT_CONNECT("127.0.0.1", brokerStarten("ohneack"), "dh-offen", 30)
MQTT_PUBLISH(h, "a/b", "eins", FALSE, 1)
MQTT_PUBLISH(h, "a/b", "zwei", FALSE, 1)
MQTT_PUBLISH(h, "a/b", "null", FALSE, 0)
DIM t0 AS INTEGER : t0 = MILLIS()
PRINT "bestaetigt "; MQTT_FLUSH(h, 300)
PRINT "gewartet "; MILLIS() - t0 >= 250
PRINT "offen "; MQTT_PENDING(h)
MQTT_DISCONNECT(h)
--- datei start.dh
IMPORT "mqtt"
DIM brokerProzess AS INTEGER
FUNCTION brokerStarten(modus AS STRING) AS INTEGER
    IF FILEEXISTS("port.txt") THEN DELETEFILE("port.txt")
    brokerProzess = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/port.txt", modus)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS("port.txt") THEN
            DIM z AS ARRAY OF STRING : z = READLINES("port.txt")
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN VAL(z[0])
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN 0
END FUNCTION

--- argumente
{sammlung}/_hilfen/mqttbroker.dh
--- erwartet
bestaetigt FALSE
gewartet TRUE
offen 2

=== qos 2 und falsche angaben sind fehler mit hinweis
IMPORT "start.dh"
DIM h AS MQTT_HANDLE
h = MQTT_CONNECT("127.0.0.1", brokerStarten(""), "dh-fehler", 30)
TRY
    MQTT_PUBLISH(h, "a/b", "x", FALSE, 2)
CATCH e
    PRINT e
END TRY
TRY
    MQTT_SUBSCRIBE(h, "a/b", 5)
CATCH e
    PRINT e
END TRY
MQTT_DISCONNECT(h)
TRY
    MQTT_TLS_CA("gibt_es_nicht.pem")
CATCH e
    PRINT e
END TRY
--- datei start.dh
IMPORT "mqtt"
DIM brokerProzess AS INTEGER
FUNCTION brokerStarten(modus AS STRING) AS INTEGER
    IF FILEEXISTS("port.txt") THEN DELETEFILE("port.txt")
    brokerProzess = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/port.txt", modus)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS("port.txt") THEN
            DIM z AS ARRAY OF STRING : z = READLINES("port.txt")
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN VAL(z[0])
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN 0
END FUNCTION

--- argumente
{sammlung}/_hilfen/mqttbroker.dh
--- erwartet
MQTT_PUBLISH: QoS 2 kann dieser Client nicht -- 0 oder 1
MQTT_SUBSCRIBE: QoS 5 gibt es nicht -- 0 oder 1
MQTT_TLS_CA: die Datei gibt_es_nicht.pem gibt es nicht

=== mqtts gegen einen broker ohne tls scheitert im klartext
' Der Test-Broker spricht kein TLS: der Handschlag scheitert, und das sagt
' die Meldung. Den gelungenen Weg pruefen die Rust-Tests in mqtt.rs mit einem
' TLS-Broker und eigener CA.
IMPORT "start.dh"
DIM h AS MQTT_HANDLE
TRY
    h = MQTT_CONNECT("mqtts://127.0.0.1", brokerStarten(""), "dh-tls", 30)
    PRINT "verbunden?"
CATCH e
    PRINT INSTR(e, "MQTT_CONNECT: TLS-Verbindung fehlgeschlagen") >= 0
END TRY
IF PROCESS_RUNNING(brokerProzess) THEN PROCESS_KILL(brokerProzess)
--- datei start.dh
IMPORT "mqtt"
DIM brokerProzess AS INTEGER
FUNCTION brokerStarten(modus AS STRING) AS INTEGER
    IF FILEEXISTS("port.txt") THEN DELETEFILE("port.txt")
    brokerProzess = PROCESS_START("dhrt", "run", ARG$(0), "--", CWD$() + "/port.txt", modus)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS("port.txt") THEN
            DIM z AS ARRAY OF STRING : z = READLINES("port.txt")
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN VAL(z[0])
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN 0
END FUNCTION

--- argumente
{sammlung}/_hilfen/mqttbroker.dh
--- erwartet
TRUE
