{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameBasic",
  "scopeName": "source.gamebasic",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gamebasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.gamebasic",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.gamebasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gamebasic",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "constant.numeric.gamebasic",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.gamebasic",
          "match": "(?i)\\b(FALSE|TRUE)\\b"
        },
        {
          "name": "storage.type.gamebasic",
          "match": "(?i)\\b(COROUTINE|INTEGER|BOOLEAN|FUNCREF|STRING|IMAGE|SOUND|ARRAY|TUPLE|FLOAT|FILE|MAP|OF)\\b"
        },
        {
          "name": "keyword.declaration.gamebasic",
          "match": "(?i)\\b(OPERATOR|FUNCTION|PROPERTY|EXTENDS|IMPORT|STATIC|STRUCT|CLASS|CONST|BYREF|ENUM|DIM|SUB|AS)\\b"
        },
        {
          "name": "keyword.control.gamebasic",
          "match": "(?i)\\b(CONTINUE|RESTORE|SELECT|ELSEIF|REPEAT|RETURN|WHERE|PRINT|CATCH|WHILE|INPUT|THROW|BREAK|UNTIL|YIELD|BXOR|WITH|DATA|THEN|ELSE|CASE|STEP|ELIF|BNOT|WEND|NEXT|BAND|READ|NEW|FOR|MOD|SHR|AND|TRY|BOR|NOT|END|SHL|IS|IN|OR|TO|IF)\\b"
        },
        {
          "name": "support.function.dollar.gamebasic",
          "match": "(?i)\\b(REPLACE|READALL|FORMAT|REPEAT|SPACE|SPLIT|INKEY|RIGHT|UPPER|LOWER|JOIN|TRIM|DATE|TIME|PADL|PADR|LEFT|STR|HEX|CHR|MID)\\$"
        },
        {
          "name": "support.function.gamebasic",
          "match": "(?i)\\b(AUDIO_SET_NUM_CHANNELS|AUDIO_MUSIC_GET_VOLUME|AUDIO_MUSIC_POSITION|NET_UDP_SET_TIMEOUT|AUDIO_BUSY_CHANNELS|AUDIO_MUSIC_VOLUME|AUDIO_MUSIC_RESUME|NET_CLOSE_LISTENER|RENDERTARGET_BEGIN|ATLAS_DRAW_FLIPPED|AUDIO_NUM_CHANNELS|CURVE_SMOOTHERSTEP|ECS_GET_OR_STRING|AUDIO_MUSIC_PAUSE|NET_UDP_LAST_FROM|RENDERTARGET_DRAW|AUDIO_MUSIC_QUEUE|__DICT_FROM_PAIRS|AUDIO_MUSIC_BUSY|ECS_GET_OR_FLOAT|AUDIO_GET_VOLUME|AUDIO_IS_PLAYING|RENDERTARGET_NEW|RENDERTARGET_END|DRAWIMAGEFLIPPED|AUDIO_RESUME_ALL|AUDIO_MUSIC_PLAY|AUDIO_MUSIC_LOAD|AUDIO_MUSIC_STOP|CURVE_SMOOTHSTEP|JOYSTICK_BUTTON|TRIANGLEOUTLINE|GENTEX_GRADIENT|ECS_GET_OR_BOOL|NET_SET_TIMEOUT|NET_TCP_CONNECT|AUDIO_PAUSE_ALL|JOYSTICK_HAT_X|POLYGONOUTLINE|JOYSTICK_HAT_Y|JOYSTICK_COUNT|ELLIPSEOUTLINE|NET_TCP_ACCEPT|SAVESCREENSHOT|AUDIO_STOP_ALL|SET_FULLSCREEN|GENTEX_CHECKED|ECS_GET_OR_INT|SETWINDOWTITLE|ECS_GET_STRING|ECS_NEW_ENTITY|ECS_ADD_STRING|NET_TCP_LISTEN|CURVE_CATMULL2|FILES_DROPPED|CURVE_BEZIER2|NET_PEER_ADDR|NET_UDP_CLOSE|QUITREQUESTED|GENTEX_PERLIN|CLIPBOARD_GET|CURVE_CATMULL|DRAWIMAGEPART|CLIPBOARD_SET|JOYSTICK_AXIS|CURVE_HERMITE|ECS_GET_FLOAT|ECS_NEW_WORLD|ARRAY_INDEXOF|ECS_ADD_FLOAT|NET_PEER_PORT|JOYSTICK_NAME|NET_UDP_RECV|CURVE_BEZIER|AUDIO_VOLUME|ECS_GET_BOOL|TEXT_SPACING|ECS_ADD_BOOL|AUDIO_RESUME|SCREENHEIGHT|LAYER_DEFINE|NET_UDP_OPEN|NET_UDP_BIND|GENTEX_COLOR|NET_UDP_SEND|FILE_DROPPED|SHADER_LOAD|CORO_RESUME|MOUSEBUTTON|DRAWTILEMAP|__COMP_ITER|ECS_DESTROY|ECS_ADD_OBJ|SHADER_SET2|AUDIO_NOISE|SHADER_SET3|ECS_GET_INT|ECS_ADD_INT|TEXT_HEIGHT|__SET_DEDUP|CORO_RESULT|IMAGEHEIGHT|BATCH_FLUSH|LAYER_CLEAR|SCREENWIDTH|AUDIO_PAUSE|LOAD_ASSETS|TEXT_ITALIC|KEYPRESSED|BLEND_MODE|AUDIO_INIT|ECS_QUERY3|ECS_REMOVE|ATLAS_DRAW|MOUSEWHEEL|AUDIO_PLAY|COLOR_LERP|AUDIO_TONE|CORO_CLOSE|CURVE_LERP|ATLAS_LOAD|IMAGEWIDTH|ARRAY_FILL|AUDIO_STOP|TEXT_WIDTH|ARRAY_COPY|BATCH_DRAW|ECS_QUERY2|FILEEXISTS|SHADER_SET|ARRAY_MIN|TEXT_SIZE|CORO_SEND|ARRAY_AVG|TEXT_BOLD|ENDOFFILE|CLOSEFILE|ECS_COUNT|DRAWIMAGE|ECS_QUERY|LOADSOUND|CORO_DONE|NET_CLOSE|LAYER_END|AUDIO_PAN|GRADIENTV|PLAYMUSIC|MAPREMOVE|RECTROUND|LOADIMAGE|WRITELINE|STOPMUSIC|PLAYSOUND|GRADIENTH|ECS_ALIVE|STOPSOUND|RANDOMIZE|ARRAY_MAX|ARRAY_SUM|MAPVALUES|OPENFILE|MAPITEMS|DIMCOUNT|READLINE|TRIANGLE|MAPCLEAR|MAPGETOR|NET_SEND|NET_RECV|COLLIDES|BOXROUND|LOADFONT|READALL|SETFONT|ECS_GET|MAPSIZE|RANDINT|ELLIPSE|MAPKEYS|REVERSE|REPLACE|POLYGON|WAITKEY|CIRCLES|DIMSIZE|SHUFFLE|ECS_HAS|POSTFX|SCROLL|SETFPS|SPLINE|SCREEN|MOUSEX|MOUSEY|MILLIS|IS_NIL|MAPHAS|MAPGET|MAPPUT|CIRCLE|CHOICE|DELTA|LINEW|ATAN2|INSTR|WRITE|LINES|RIGHT|CLAMP|UPPER|LOWER|RANDF|GREEN|REMAP|SPACE|HYPOT|ROUND|SLEEP|FLOOR|BOXES|RANGE|SPLIT|TIMER|PLOTS|LAYER|SORT|ATAN|JOIN|TRIM|DATE|PADL|PADR|SIGN|ASIN|TIME|FRAC|RECT|PLOT|LINE|CEIL|TEXT|LERP|BLUE|LEFT|ACOS|FLIP|LOG|VAL|POW|SIN|DEG|MAX|MID|RAD|INT|HSV|TAN|BOX|STR|HEX|RGB|SQR|RED|ARC|LEN|EXP|CHR|COS|MIN|CLS|RND|ASC|ABS|FPS)\\b"
        },
        {
          "name": "constant.language.gamebasic",
          "match": "(?i)\\b(JOY_BUTTON_RSTICK|JOY_BUTTON_LSTICK|JOY_BUTTON_START|JOY_BUTTON_BACK|JOY_DPAD_RIGHT|JOY_BUTTON_RB|KEY_BACKSPACE|JOY_DPAD_LEFT|JOY_BUTTON_LB|JOY_DPAD_DOWN|JOY_BUTTON_X|JOY_BUTTON_B|JOY_BUTTON_Y|JOY_BUTTON_A|JOY_DPAD_UP|KEY_ESCAPE|KEY_RETURN|DARKGREEN|LIGHTGRAY|KEY_ENTER|KEY_RIGHT|KEY_SPACE|DARKBLUE|KEY_DOWN|KEY_LEFT|DARKGRAY|MAGENTA|DARKRED|KEY_F10|KEY_F12|KEY_F11|KEY_TAB|KEY_F1|PURPLE|YELLOW|KEY_F2|KEY_F7|KEY_F9|ORANGE|KEY_UP|KEY_F3|KEY_F8|KEY_F4|KEY_F6|KEY_F5|KEY_0|KEY_A|KEY_F|KEY_V|KEY_K|KEY_Q|KEY_R|GREEN|KEY_Y|BLACK|KEY_8|KEY_G|KEY_U|KEY_N|KEY_L|KEY_C|WHITE|KEY_M|KEY_D|KEY_E|KEY_B|KEY_4|KEY_5|KEY_S|KEY_J|KEY_6|KEY_X|KEY_I|KEY_Z|KEY_7|KEY_H|KEY_2|KEY_O|BROWN|KEY_T|KEY_3|KEY_P|KEY_1|KEY_9|KEY_W|GRAY|CYAN|BLUE|PINK|RED|PI)\\b"
        },
        {
          "name": "keyword.operator.gamebasic",
          "match": "<=|>=|<>|[-+*/\\\\=<>^]"
        }
      ]
    }
  }
}
