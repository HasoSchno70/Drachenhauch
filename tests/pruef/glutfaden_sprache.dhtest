--- erwartet
aufloesen: de de en en de en de
ohne datei: FALSE de FALSE
de: TRUE | Sichern | Die Ebene „Rand“ ist gesperrt. | Strg+Umschalt+S, Entf | 1.234,5 | 0,25
geladen: TRUE en TRUE
en: Save | fehlt bleibt: Öffnen | a<tab>b | kommentar: # Kommentar | ohne tabulator
trf: 3 of 7 | {1} of x | unbekannt: a und b | zu wenig: 3 of {1}
kuerzel: Ctrl+Shift+Del, Alt+PgUp, Space | Ctrl+Y, Ctrl+Shift+Z | Ins, Home, End, PgDown, Backspace, Enter, Tab, Esc, Ctrl+Comma, Ctrl+Period, Alt+Left, Plus | F1 | leer ''
zahlen: 1,234,567.89 | 2.5 | 400,000 | -1,234.5 | 7
echte tafel: TRUE
  Save as -> Ctrl+Shift+S
  Undo -> Ctrl+Z
  Redo -> Ctrl+Y, Ctrl+Shift+Z
farbenblind: No simulation / Protanopia (red blindness) / Deuteranopia (green blindness) / Tritanopia (blue blindness)
zurueck: Neues Muster -> Strg+N | Protanopie (Rot-Blindheit)
vorgabe 'auto'
"ui_language": "en",
gelesen 'en'
krumm 'auto'
deutsch 'de'

=== probe: oberflaeche auf englisch
IMPORT "helfer.dh"
' --probe-sprache mit DH_GLUT_SPRACHE=en: die Kern-Funktionen in der
' laufenden Oberflaeche, alle Texte des Hauptfensters und der
' Kuerzel-Uebersicht (F1) -- deutsch aussehende werden aufgelistet --, dann
' die Sprache in den Einstellungen umstellen (wirkt erst beim naechsten Start).
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
SETENV("DH_GLUT_SPRACHE", "en")
dlStarten(["run", BEISPIEL, "--", "--probe-sprache", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    PRINT "hauptfenster "; FILEEXISTS("d_hauptfenster.png")
    PRINT "datei unveraendert: "; READLINES("alle.pxs")[0] = READLINES("vorher.pxs")[0]
END IF
