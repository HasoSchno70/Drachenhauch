DIM kOeffnen AS INTEGER : kOeffnen = knopf("document-open-symbolic", "Muster öffnen (Strg+O)")
DIM kImport AS INTEGER : kImport = knopf("insert-image-symbolic", "Bild importieren (Strg+I) -- erneut aus dem Quellbild: Strg+Umschalt+I")
kSichern = knopf("document-save-symbolic", "Sichern (Strg+S) -- Sichern unter: Strg+Umschalt+S")
DIM kExport AS INTEGER : kExport = knopf("document-send-symbolic", "Exportieren (Strg+E) -- PDF, HTML, Bild, OXS oder Paket")
DIM kPfad AS INTEGER : kPfad = knopf("mark-location-symbolic", "Stickpfad (Strg+Umschalt+O) -- in welcher Reihenfolge die Stiche jeder Farbe gesetzt werden")
kZurueck = knopf("edit-undo-symbolic", "Rückgängig (Strg+Z)")
kVor = knopf("edit-redo-symbolic", "Wiederholen (Strg+Y)")
