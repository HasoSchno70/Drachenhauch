=== add obj with arbitrary value
' ECS_ADD_OBJ speichert beliebige Werte per Referenz (hier eine MAP);
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
DIM e AS INTEGER
e = ECS_NEW_ENTITY(w)
DIM m AS MAP OF INTEGER
MAPPUT(m, "x", 1)
ECS_ADD_OBJ(w, e, "data", m)
DIM got AS MAP OF INTEGER
got = ECS_GET(w, e, "data")
PRINT MAPGET(got, "x")
MAPPUT(got, "x", 99)
PRINT MAPGET(m, "x")
--- erwartet
1
99

=== movement system via query
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
DIM e1 AS INTEGER
DIM e2 AS INTEGER
e1 = ECS_NEW_ENTITY(w)
e2 = ECS_NEW_ENTITY(w)
ECS_ADD_INT(w, e1, "pos", 0)
ECS_ADD_INT(w, e1, "vel", 5)
ECS_ADD_INT(w, e2, "pos", 100)
ECS_ADD_INT(w, e2, "vel", -3)

DIM moved AS ARRAY OF INTEGER
moved = ECS_QUERY2(w, "pos", "vel")
DIM i AS INTEGER
FOR i = 0 TO LEN(moved) - 1
    DIM ent AS INTEGER
    ent = moved[i]
    ECS_ADD_INT(w, ent, "pos",
                ECS_GET_INT(w, ent, "pos") + ECS_GET_INT(w, ent, "vel"))
NEXT
PRINT ECS_GET_INT(w, e1, "pos")
PRINT ECS_GET_INT(w, e2, "pos")
--- erwartet
5
97

