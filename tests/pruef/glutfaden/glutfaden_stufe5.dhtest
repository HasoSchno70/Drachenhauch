=== pdf: ablauf wie pysticky beim probemuster
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Die Beilage hat ref_pdf.py aus PyStickys Story aufgezeichnet: Absaetze,
' Tabellenzeilen, Zeichnungen (Formen je Art, Texte als Menge), Umbrueche.
' Einzige Abweichung mit Absicht: ein Garn ohne Hersteller heisst nicht "None".
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
DIM o AS kern.PdfOptionen : o = gePdfOptionen(pal, "A4", 0, 0, "", "", FALSE, "")
o.titel = "probe"
DIM ab AS ARRAY OF STRING : ab = kern.pdfExportieren(m, "aus.pdf", o)
PRINT geAbweichungen$(geLies$("probe.txt"), JOIN$(ab, CHR$(10)) + CHR$(10))
PRINT "datei "; FILEEXISTS("aus.pdf"); " seiten "; ab[LEN(ab) - 1]
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"

