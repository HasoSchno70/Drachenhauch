' --- Modell -----------------------------------------------------------------
DIM doc AS JSON_HANDLE
DIM frm AS GUI_WINDOW : frm = -1
DIM formPfad AS STRING : formPfad = ""
DIM auswahl AS INTEGER : auswahl = -1           ' Index in doc.widgets
' Mehrfachauswahl: alle gewaehlten Indizes; `auswahl` ist darunter das
' zuletzt angeklickte -- der Inspektor zeigt es, "Anordnen" richtet an ihm aus.
DIM gewaehlt AS ARRAY OF INTEGER : gewaehlt = []
DIM geaendert AS BOOLEAN : geaendert = FALSE
DIM formX AS INTEGER : formX = PAL_B + 40        ' wo die Form auf dem Schirm liegt
DIM formY AS INTEGER : formY = 60

' Rueckgaengig: ein JSON-Text je Stand, ein Zeiger darauf.
DIM staende AS ARRAY OF STRING : staende = []
DIM standPos AS INTEGER : standPos = -1

FUNCTION leeresFormular$() AS STRING
    RETURN "{" + CHR$(34) + "title" + CHR$(34) + ":" + CHR$(34) + "Formular" + CHR$(34) + "," + CHR$(34) + "x" + CHR$(34) + ":0," + CHR$(34) + "y" + CHR$(34) + ":0," + CHR$(34) + "w" + CHR$(34) + ":480," + CHR$(34) + "h" + CHR$(34) + ":360," + CHR$(34) + "movable" + CHR$(34) + ":true," + CHR$(34) + "closable" + CHR$(34) + ":true," + CHR$(34) + "visible" + CHR$(34) + ":true," + CHR$(34) + "resizable" + CHR$(34) + ":false," + CHR$(34) + "widgets" + CHR$(34) + ":[]}"
END FUNCTION

FUNCTION anzahl() AS INTEGER
    RETURN JSON_LEN(doc, "widgets")
END FUNCTION

FUNCTION wz$(i AS INTEGER, feld AS STRING) AS STRING
    ' Pfad zu einem Widget-Feld
    RETURN "widgets." + STR$(i) + "." + feld
END FUNCTION

FUNCTION feldText$(i AS INTEGER, feld AS STRING) AS STRING
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN ""
    RETURN JSON_GET_STRING(doc, wz$(i, feld))
END FUNCTION

FUNCTION feldZahl(i AS INTEGER, feld AS STRING) AS INTEGER
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN 0
    RETURN JSON_GET_INT(doc, wz$(i, feld))
END FUNCTION

' --- Auswahl ------------------------------------------------------------------
SUB auswahlSetzen(i AS INTEGER)
    auswahl = i
    IF i >= 0 THEN gewaehlt = [i] ELSE gewaehlt = []
END SUB

FUNCTION istGewaehlt(i AS INTEGER) AS BOOLEAN
    RETURN ARRAY_INDEXOF(gewaehlt, i) >= 0
END FUNCTION

' Umschalt/Strg+Klick: dazu oder wieder weg.
SUB auswahlUmschalten(i AS INTEGER)
    IF istGewaehlt(i) THEN
        DIM rest AS ARRAY OF INTEGER : rest = []
        DIM j AS INTEGER
        FOR EACH j IN gewaehlt
            IF j <> i THEN ARRAY_PUSH(rest, j)
        NEXT
        gewaehlt = rest
        IF LEN(gewaehlt) > 0 THEN auswahl = gewaehlt[LEN(gewaehlt) - 1] ELSE auswahl = -1
    ELSE
        ARRAY_PUSH(gewaehlt, i)
        auswahl = i
    END IF
END SUB

' Nach Rueckgaengig oder Loeschen: was es nicht mehr gibt, faellt heraus.
SUB auswahlBereinigen()
    DIM rest AS ARRAY OF INTEGER : rest = []
    DIM j AS INTEGER
    FOR EACH j IN gewaehlt
        IF j >= 0 AND j < anzahl() THEN ARRAY_PUSH(rest, j)
    NEXT
    gewaehlt = rest
    IF auswahl >= anzahl() OR NOT istGewaehlt(auswahl) THEN
        IF LEN(gewaehlt) > 0 THEN auswahl = gewaehlt[LEN(gewaehlt) - 1] ELSE auswahl = -1
    END IF
END SUB

SUB allesWaehlen()
    gewaehlt = []
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        ARRAY_PUSH(gewaehlt, i)
    NEXT
    IF anzahl() > 0 THEN auswahl = anzahl() - 1 ELSE auswahl = -1
    inspektorFuellen()
    protokoll("alle " + STR$(LEN(gewaehlt)))
END SUB

' --- Reiterseiten -------------------------------------------------------------
' Ein Control gehoert zu einer Seite eines Reiterwerks (oder einem Schritt
' eines Assistenten), wenn sein Feld "reiter" NAME:SEITE sagt (Seite ab 1).
' Die Laufzeit fuehrt die Kinder als Widget-NUMMERN (`tabctl.kinder`) -- die
' verschieben sich bei jedem Loeschen und Umordnen. Deshalb fuehrt der
' Designer sie am NAMEN und rechnet die Nummern vor jeder Ansicht neu aus;
' beim Laden geht es einmal umgekehrt.
FUNCTION istBehaelter(i AS INTEGER) AS BOOLEAN
    DIM k AS STRING : k = feldText$(i, "kind")
    RETURN k = "tabcontrol" OR k = "wizard"
END FUNCTION

FUNCTION seitenZahl(i AS INTEGER) AS INTEGER
    IF NOT JSON_HAS(doc, wz$(i, "items")) THEN RETURN 0
    RETURN JSON_LEN(doc, wz$(i, "items"))
END FUNCTION

' Welcher Behaelter, welche Seite (ab 1)? -1 / 0, wenn keine gilt.
FUNCTION reiterVon(c AS INTEGER) AS INTEGER
    DIM r AS STRING : r = feldText$(c, "reiter")
    DIM dp AS INTEGER : dp = INSTR(r, ":")
    IF dp <= 0 THEN RETURN -1
    DIM pn AS STRING : pn = LOWER$(TRIM$(LEFT$(r, dp)))
    DIM p AS INTEGER
    FOR p = 0 TO anzahl() - 1
        IF p <> c AND istBehaelter(p) AND LOWER$(feldText$(p, "name")) = pn THEN RETURN p
    NEXT
    RETURN -1
END FUNCTION

FUNCTION reiterSeite(c AS INTEGER) AS INTEGER
    DIM r AS STRING : r = feldText$(c, "reiter")
    DIM dp AS INTEGER : dp = INSTR(r, ":")
    IF dp <= 0 THEN RETURN 0
    RETURN INT(VAL(TRIM$(MID$(r, dp + 1, LEN(r)))))
END FUNCTION

SUB reiterNachziehen()
    DIM n AS INTEGER : n = anzahl()
    DIM p AS INTEGER
    DIM c AS INTEGER
    FOR p = 0 TO n - 1
        IF NOT istBehaelter(p) THEN CONTINUE
        DIM kinder AS JSON_HANDLE : kinder = JSON_NEW_ARRAY()
        FOR c = 0 TO n - 1
            IF reiterVon(c) <> p THEN CONTINUE
            DIM s AS INTEGER : s = reiterSeite(c)
            IF s < 1 OR s > seitenZahl(p) THEN CONTINUE
            DIM paar AS JSON_HANDLE : paar = JSON_NEW_ARRAY()
            JSON_APPEND_INT(paar, "", c)
            JSON_APPEND_INT(paar, "", s - 1)
            JSON_APPEND_JSON(kinder, "", paar)
        NEXT
        DIM seite AS INTEGER : seite = 0
        IF JSON_HAS(doc, wz$(p, "tabctl.seite")) THEN seite = JSON_GET_INT(doc, wz$(p, "tabctl.seite"))
        DIM tc AS JSON_HANDLE : tc = JSON_NEW_OBJECT()
        JSON_SET_JSON(tc, "kinder", kinder)
        JSON_SET_INT(tc, "seite", seite)
        JSON_SET_JSON(doc, wz$(p, "tabctl"), tc)
    NEXT
END SUB

' Eine Datei, die ein Programm mit GUI_SAVE geschrieben hat, kennt nur die
' Nummern: daraus einmal die Namen machen (wer keinen Namen hat, bekommt
' einen).
SUB reiterAusDatei()
    DIM p AS INTEGER
    FOR p = 0 TO anzahl() - 1
        IF NOT istBehaelter(p) OR NOT JSON_HAS(doc, wz$(p, "tabctl.kinder")) THEN CONTINUE
        IF feldText$(p, "name") = "" THEN JSON_SET_STRING(doc, wz$(p, "name"), eindeutigerName$(feldText$(p, "kind")))
        DIM kp AS STRING : kp = wz$(p, "tabctl.kinder")
        DIM e AS INTEGER
        FOR e = 0 TO JSON_LEN(doc, kp) - 1
            DIM c AS INTEGER : c = JSON_GET_INT(doc, kp + "." + STR$(e) + ".0")
            DIM s AS INTEGER : s = JSON_GET_INT(doc, kp + "." + STR$(e) + ".1")
            IF c < 0 OR c >= anzahl() OR c = p OR feldText$(c, "reiter") <> "" THEN CONTINUE
            IF feldText$(c, "name") = "" THEN JSON_SET_STRING(doc, wz$(c, "name"), eindeutigerName$(feldText$(c, "kind")))
            JSON_SET_STRING(doc, wz$(c, "reiter"), feldText$(p, "name") + ":" + STR$(s + 1))
        NEXT
    NEXT
END SUB

' --- Ansicht: das Formular als echtes Fenster im Entwurfsmodus ---------------
SUB ansichtBauen()
    reiterNachziehen()
    ' Ein neues Fenster nimmt den Fokus -- und Kuerzel gelten im Fenster mit
    ' Fokus. Also merken und zurueckgeben, sonst waeren Strg+S und F5 nach
    ' dem ersten Ablegen tot.
    DIM fokus AS GUI_WIDGET : fokus = GUI_FOCUSED()
    IF frm >= 0 THEN GUI_WINDOW_DESTROY(frm)
    frm = GUI_FROM_JSON(JSON_STRINGIFY(doc))
    GUI_WINDOW_DESIGN(frm, TRUE)
    GUI_WINDOW_CHROME(frm, FALSE)
    GUI_WINDOW_MOVABLE(frm, FALSE)
    GUI_WINDOW_RESIZABLE(frm, FALSE)
    GUI_WINDOW_SET_BOUNDS(frm, formX, formY, JSON_GET_INT(doc, "w"), JSON_GET_INT(doc, "h"))
    GUI_WINDOW_VISIBLE(frm, TRUE)
    IF fokus >= 0 THEN GUI_FOCUS(fokus) ELSE GUI_FOCUS(lstPalette)
END SUB

' Stand merken (nach jeder abgeschlossenen Aenderung).
SUB merken()
    DIM text AS STRING : text = JSON_STRINGIFY(doc)
    ' alles hinter dem Zeiger verwerfen (ein neuer Zweig)
    WHILE LEN(staende) > standPos + 1
        ARRAY_REMOVE_AT(staende, LEN(staende) - 1)
    WEND
    ARRAY_PUSH(staende, text)
    IF LEN(staende) > 200 THEN ARRAY_REMOVE_AT(staende, 0)
    standPos = LEN(staende) - 1
    geaendert = TRUE
END SUB

SUB standHolen()
    doc = JSON_PARSE(staende[standPos])
    auswahlBereinigen()
    ansichtBauen()
    inspektorFuellen()
END SUB

SUB rueckgaengig()
    IF standPos <= 0 THEN RETURN
    standPos = standPos - 1
    standHolen()
    protokoll("rueckgaengig " + STR$(anzahl()))
END SUB

SUB wiederholen()
    IF standPos >= LEN(staende) - 1 THEN RETURN
    standPos = standPos + 1
    standHolen()
    protokoll("wiederholen " + STR$(anzahl()))
END SUB

' --- Fenster: Palette links (mit Menue), Inspektor rechts -------------------
DIM winPal AS GUI_WINDOW : winPal = GUI_WINDOW("Palette", 0, 0, PAL_B, SCREENHEIGHT())
GUI_WINDOW_CHROME(winPal, FALSE)
GUI_WINDOW_MOVABLE(winPal, FALSE)
DIM mDatei AS INTEGER : mDatei = GUI_MENU(winPal, "Datei")
DIM miNeu AS INTEGER : miNeu = GUI_MENU_ITEM(mDatei, "Neu", "Strg+N")
DIM miOeffnen AS INTEGER : miOeffnen = GUI_MENU_ITEM(mDatei, "Oeffnen ...", "Strg+O")
DIM miSichern AS INTEGER : miSichern = GUI_MENU_ITEM(mDatei, "Sichern", "Strg+S")
DIM miSichernAls AS INTEGER : miSichernAls = GUI_MENU_ITEM(mDatei, "Sichern unter ...", "Strg+Umschalt+S")
GUI_MENU_SEPARATOR(mDatei)
DIM miLauf AS INTEGER : miLauf = GUI_MENU_ITEM(mDatei, "Formular ausfuehren", "F5")
DIM miDhCode AS INTEGER : miDhCode = GUI_MENU_ITEM(mDatei, "DH-Code schreiben", "Strg+G")
GUI_MENU_SEPARATOR(mDatei)
DIM miBeenden AS INTEGER : miBeenden = GUI_MENU_ITEM(mDatei, "Beenden", "Strg+Q")
DIM mBearb AS INTEGER : mBearb = GUI_MENU(winPal, "Bearbeiten")
DIM miRueck AS INTEGER : miRueck = GUI_MENU_ITEM(mBearb, "Rueckgaengig", "Strg+Z")
DIM miWieder AS INTEGER : miWieder = GUI_MENU_ITEM(mBearb, "Wiederholen", "Strg+Y")
DIM miDoppel AS INTEGER : miDoppel = GUI_MENU_ITEM(mBearb, "Verdoppeln", "Strg+D")
DIM miLoeschen AS INTEGER : miLoeschen = GUI_MENU_ITEM(mBearb, "Loeschen")
DIM miVorn AS INTEGER : miVorn = GUI_MENU_ITEM(mBearb, "Nach vorn")
DIM miHinten AS INTEGER : miHinten = GUI_MENU_ITEM(mBearb, "Nach hinten")
' Strg+A liegt nicht am Menue: ein Kuerzel mit Strg gewaenne auch in einem
' Inspektor-Feld, und dort heisst Strg+A "den Text markieren".
DIM miAlle AS INTEGER : miAlle = GUI_MENU_ITEM(mBearb, "Alles auswaehlen (Strg+A)")
' Anordnen: Bezug ist das zuletzt angeklickte Control.
DIM mAnord AS INTEGER : mAnord = GUI_MENU(winPal, "Anordnen")
DIM miLinks AS INTEGER : miLinks = GUI_MENU_ITEM(mAnord, "Links ausrichten")
DIM miRechts AS INTEGER : miRechts = GUI_MENU_ITEM(mAnord, "Rechts ausrichten")
DIM miOben AS INTEGER : miOben = GUI_MENU_ITEM(mAnord, "Oben ausrichten")
DIM miUnten AS INTEGER : miUnten = GUI_MENU_ITEM(mAnord, "Unten ausrichten")
DIM miMitteW AS INTEGER : miMitteW = GUI_MENU_ITEM(mAnord, "Waagerecht mittig")
DIM miMitteS AS INTEGER : miMitteS = GUI_MENU_ITEM(mAnord, "Senkrecht mittig")
GUI_MENU_SEPARATOR(mAnord)
DIM miGleichB AS INTEGER : miGleichB = GUI_MENU_ITEM(mAnord, "Gleiche Breite")
DIM miGleichH AS INTEGER : miGleichH = GUI_MENU_ITEM(mAnord, "Gleiche Hoehe")
DIM miGleichG AS INTEGER : miGleichG = GUI_MENU_ITEM(mAnord, "Gleiche Groesse")
GUI_MENU_SEPARATOR(mAnord)
DIM miVertW AS INTEGER : miVertW = GUI_MENU_ITEM(mAnord, "Waagerecht verteilen")
DIM miVertS AS INTEGER : miVertS = GUI_MENU_ITEM(mAnord, "Senkrecht verteilen")

DIM lblPalette AS GUI_WIDGET : lblPalette = GUI_LABEL(winPal, "Palette -- anklicken, dann auf die Form", 8, 34)
' Die Liste laesst unten Platz fuer zwei Zeilen Status -- eine Meldung mit
' Pfad bricht um und stand sonst halb unter dem Fensterrand.
DIM lstPalette AS GUI_WIDGET : lstPalette = GUI_LISTBOX(winPal, 8, 56, PAL_B - 16, 664, palName)
DIM lblStatus AS GUI_WIDGET : lblStatus = GUI_LABEL(winPal, "Bereit.", 8, 726)
GUI_SET_WRAP(lblStatus, PAL_B - 16)
DIM palScharf AS INTEGER : palScharf = -1

DIM winInsp AS GUI_WINDOW : winInsp = GUI_WINDOW("Inspektor", SCREENWIDTH() - INSP_B, 0, INSP_B, SCREENHEIGHT())
GUI_WINDOW_CHROME(winInsp, FALSE)
GUI_WINDOW_MOVABLE(winInsp, FALSE)
DIM lblInsp AS GUI_WIDGET : lblInsp = GUI_LABEL(winInsp, "Formular", 8, 8)

' Eingabefelder des Inspektors: eine Beschriftung, ein Feld je Zeile.
DIM inspNamen AS ARRAY OF STRING : inspNamen = []
DIM inspFelder AS ARRAY OF GUI_WIDGET : inspFelder = []
DIM inspLabels AS ARRAY OF GUI_WIDGET : inspLabels = []

FUNCTION inspFeld(schluessel AS STRING, titel AS STRING, zeile AS INTEGER) AS GUI_WIDGET
    DIM y AS INTEGER : y = 36 + zeile * 34
    DIM l AS GUI_WIDGET : l = GUI_LABEL(winInsp, titel, 8, y + 4)
    DIM f AS GUI_WIDGET : f = GUI_TEXTINPUT(winInsp, 100, y, INSP_B - 110, 26, "")
    ARRAY_PUSH(inspNamen, schluessel) : ARRAY_PUSH(inspFelder, f) : ARRAY_PUSH(inspLabels, l)
    RETURN f
END FUNCTION

' Widget-Felder
DIM fName AS GUI_WIDGET : fName = inspFeld("name", "Name", 0)
DIM fX AS GUI_WIDGET : fX = inspFeld("x", "X", 1)
DIM fY AS GUI_WIDGET : fY = inspFeld("y", "Y", 2)
DIM fW AS GUI_WIDGET : fW = inspFeld("w", "Breite", 3)
DIM fH AS GUI_WIDGET : fH = inspFeld("h", "Hoehe", 4)
DIM fText AS GUI_WIDGET : fText = inspFeld("text", "Text", 5)
DIM fTip AS GUI_WIDGET : fTip = inspFeld("tooltip", "Tooltip", 6)
DIM fAnker AS GUI_WIDGET : fAnker = inspFeld("anchor", "Anker (lrtb)", 7)
DIM fClick AS GUI_WIDGET : fClick = inspFeld("on_click", "on_click", 8)
DIM fChange AS GUI_WIDGET : fChange = inspFeld("on_change", "on_change", 9)
DIM fEnter AS GUI_WIDGET : fEnter = inspFeld("on_enter", "on_enter", 10)
' Schriftstil als Text: fett, kursiv, unterstrichen, durchgestrichen mit +.
DIM fStil AS GUI_WIDGET : fStil = inspFeld("font_style", "Schriftstil", 11)
GUI_TOOLTIP(fStil, "fett, kursiv, unterstrichen, durchgestrichen -- verbunden mit +, z. B. fett+unterstrichen")
DIM cbAktiv AS GUI_WIDGET : cbAktiv = GUI_CHECKBOX(winInsp, "Aktiviert", 250, 36 + 19 * 34 + 4)
' Unter den Knoepfen, damit keine bisherige Zeile rueckt.
DIM fReiter AS GUI_WIDGET : fReiter = inspFeld("reiter", "Reiterseite", 20)
GUI_TOOLTIP(fReiter, "Name eines Reiterwerks (oder Assistenten) und die Seite ab 1, z. B. reiterwerk1:2 -- das Control steht dann nur auf dieser Seite")

' Felder je Art (seit Stand 31): sichtbar nur bei den Arten, die in ihrer
' Liste stehen. Listen werden mit Semikolon getrennt -- ein Komma steht zu
' oft in einem Eintrag selbst.
DIM artSchl AS ARRAY OF STRING : artSchl = []
DIM artArten AS ARRAY OF STRING : artArten = []
DIM artFelder AS ARRAY OF GUI_WIDGET : artFelder = []
DIM artLabels AS ARRAY OF GUI_WIDGET : artLabels = []

FUNCTION artFeld(schluessel AS STRING, titel AS STRING, arten AS STRING, zeile AS INTEGER, platzhalter AS STRING) AS GUI_WIDGET
    DIM y AS INTEGER : y = 36 + zeile * 34
    DIM l AS GUI_WIDGET : l = GUI_LABEL(winInsp, titel, 8, y + 4)
    DIM f AS GUI_WIDGET : f = GUI_TEXTINPUT(winInsp, 100, y, INSP_B - 110, 26, platzhalter)
    ARRAY_PUSH(artSchl, schluessel) : ARRAY_PUSH(artArten, arten)
    ARRAY_PUSH(artFelder, f) : ARRAY_PUSH(artLabels, l)
    RETURN f
END FUNCTION

DIM aEintraege AS GUI_WIDGET : aEintraege = artFeld("items", "Eintraege", ",dropdown,listbox,accordion,wizard,tabcontrol,", 12, "Rot; Gruen; Blau")
' Welche Seite das Reiterwerk im Entwurf zeigt -- die Controls der anderen
' sind dort verborgen, wie spaeter im Programm.
DIM aSeite AS GUI_WIDGET : aSeite = artFeld("seite", "Gezeigte Seite", ",tabcontrol,wizard,", 13, "1")
DIM aSpalten AS GUI_WIDGET : aSpalten = artFeld("spalten", "Spalten", ",table,", 12, "Name; Menge; Farbe")
DIM aBreiten AS GUI_WIDGET : aBreiten = artFeld("breiten", "Breiten", ",table,", 13, "120; 60; 80")
DIM aBearb AS GUI_WIDGET : aBearb = artFeld("bearbeitbar", "Bearbeitbar", ",table,", 14, "0; 2  oder  alle")
DIM aArten AS GUI_WIDGET : aArten = artFeld("arten", "Spaltenarten", ",table,", 15, "text; ganz; auswahl")
DIM aWahl AS GUI_WIDGET : aWahl = artFeld("wahl", "Auswahl", ",table,", 16, "2 = Rot|Gruen|Blau")
DIM aMin AS GUI_WIDGET : aMin = artFeld("min", "Min", ",slider,progress,spinner,knob,", 12, "0")
DIM aMax AS GUI_WIDGET : aMax = artFeld("max", "Max", ",slider,progress,spinner,knob,", 13, "100")
DIM aWert AS GUI_WIDGET : aWert = artFeld("value", "Wert", ",slider,progress,spinner,knob,", 14, "50")
' Die Beschreibung einer Kachel steht in der .dhform unter "placeholder".
DIM aBeschr AS GUI_WIDGET : aBeschr = artFeld("placeholder", "Beschreibung", ",card,", 12, "Was die Kachel oeffnet")
' Der Platzhalter einer Klappliste liegt im selben Feld der .dhform.
DIM aPlatzhalter AS GUI_WIDGET : aPlatzhalter = artFeld("placeholder", "Platzhalter", ",dropdown,", 13, "Bitte waehlen")
' Hinweis, wenn eine Tabelle keine Zeile zeigt (GUI_TABLE_PLACEHOLDER).
DIM aLeer AS GUI_WIDGET : aLeer = artFeld("leer_text", "Leer-Hinweis", ",table,tree,", 17, "Keine Treffer")
DIM cbZellen AS GUI_WIDGET : cbZellen = GUI_CHECKBOX(winInsp, "Zellmodus (Gitter)", 100, 36 + 18 * 34)
' Eine Liste bzw. ein Baum, deren Eintraege sich mit F2 umbenennen lassen.
DIM cbUmbenennen AS GUI_WIDGET : cbUmbenennen = GUI_CHECKBOX(winInsp, "Umbenennen mit F2", 100, 36 + 13 * 34)
' Eine Klappliste, in die man auch tippen darf (Combobox).
DIM cbFrei AS GUI_WIDGET : cbFrei = GUI_CHECKBOX(winInsp, "Tippen erlaubt (Combobox)", 100, 36 + 14 * 34)

DIM btnUebernehmen AS GUI_WIDGET : btnUebernehmen = GUI_BUTTON(winInsp, "Uebernehmen", 100, 36 + 19 * 34, 140, 28)
' Formular-Felder (wenn nichts ausgewaehlt ist)
DIM fTitel AS GUI_WIDGET : fTitel = GUI_TEXTINPUT(winInsp, 100, 36, INSP_B - 110, 26, "")
DIM lTitel AS GUI_WIDGET : lTitel = GUI_LABEL(winInsp, "Titel", 8, 40)
DIM fFormB AS GUI_WIDGET : fFormB = GUI_TEXTINPUT(winInsp, 100, 70, INSP_B - 110, 26, "")
DIM lFormB AS GUI_WIDGET : lFormB = GUI_LABEL(winInsp, "Breite", 8, 74)
DIM fFormH AS GUI_WIDGET : fFormH = GUI_TEXTINPUT(winInsp, 100, 104, INSP_B - 110, 26, "")
DIM lFormH AS GUI_WIDGET : lFormH = GUI_LABEL(winInsp, "Hoehe", 8, 108)
DIM cbResizable AS GUI_WIDGET : cbResizable = GUI_CHECKBOX(winInsp, "Groessenveraenderbar", 100, 138)
DIM lThema AS GUI_WIDGET : lThema = GUI_LABEL(winInsp, "Thema", 8, 176)
DIM ddThema AS GUI_WIDGET : ddThema = GUI_DROPDOWN(winInsp, 100, 172, INSP_B - 110, 24, ["(keines)", "glas_dunkel", "glas_hell", "dark", "light"])
DIM lblHinweis AS GUI_WIDGET : lblHinweis = GUI_LABEL(winInsp, "", 8, 36 + 21 * 34 + 10)
GUI_SET_WRAP(lblHinweis, INSP_B - 16)

DIM inspStumm AS BOOLEAN : inspStumm = FALSE     ' beim Fuellen nicht als Eingabe werten

' Felder je Art ein- und ausblenden ("" = alle aus).
SUB artSichtbar(art AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(artFelder) - 1
        DIM an AS BOOLEAN : an = art <> "" AND ("," + art + ",") IN artArten[i]
        GUI_SET_VISIBLE(artFelder[i], an) : GUI_SET_VISIBLE(artLabels[i], an)
    NEXT
    GUI_SET_VISIBLE(cbZellen, art = "table")
    GUI_SET_VISIBLE(cbUmbenennen, art = "listbox" OR art = "tree")
    GUI_SET_VISIBLE(cbFrei, art = "dropdown")
END SUB

FUNCTION zahlText$(f AS FLOAT) AS STRING
    IF f = INT(f) THEN RETURN STR$(INT(f))
    RETURN STR$(f)
END FUNCTION

' Eine JSON-Liste als "a; b; c" -- Texte und Zahlen.
FUNCTION listeText$(pfad AS STRING) AS STRING
    IF NOT JSON_HAS(doc, pfad) THEN RETURN ""
    IF JSON_TYPE(doc, pfad) <> "array" THEN RETURN ""
    DIM teile AS ARRAY OF STRING : teile = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(doc, pfad) - 1
        DIM ep AS STRING : ep = pfad + "." + STR$(i)
        DIM et AS STRING : et = JSON_TYPE(doc, ep)
        IF et = "string" THEN ARRAY_PUSH(teile, JSON_GET_STRING(doc, ep))
        IF et = "number" THEN ARRAY_PUSH(teile, zahlText$(JSON_GET_FLOAT(doc, ep)))
    NEXT
    RETURN JOIN$(teile, "; ")
END FUNCTION

' "a; b; c" als JSON-Liste schreiben; leer entfernt den Schluessel.
SUB listeSetzen(pfad AS STRING, text AS STRING, alsZahl AS BOOLEAN)
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    DIM n AS INTEGER : n = 0
    DIM t AS STRING
    FOR EACH t IN SPLIT$(text, ";")
        DIM s AS STRING : s = TRIM$(t)
        IF s <> "" THEN
            IF alsZahl THEN JSON_APPEND_INT(a, "", INT(VAL(s))) ELSE JSON_APPEND_STRING(a, "", s)
            n = n + 1
        END IF
    NEXT
    IF n = 0 THEN
        IF JSON_HAS(doc, pfad) THEN JSON_REMOVE(doc, pfad)
    ELSE
        JSON_SET_JSON(doc, pfad, a)
    END IF
END SUB

FUNCTION feldZahlText$(i AS INTEGER, feld AS STRING) AS STRING
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN ""
    RETURN zahlText$(JSON_GET_FLOAT(doc, wz$(i, feld)))
END FUNCTION

' Modell -> Felder je Art.
SUB artFuellen(i AS INTEGER)
    DIM art AS STRING : art = feldText$(i, "kind")
    artSichtbar(art)
    GUI_SET_TEXT(aEintraege, listeText$(wz$(i, "items")))
    GUI_SET_TEXT(aMin, feldZahlText$(i, "min"))
    GUI_SET_TEXT(aMax, feldZahlText$(i, "max"))
    GUI_SET_TEXT(aWert, feldZahlText$(i, "value"))
    GUI_SET_TEXT(aBeschr, feldText$(i, "placeholder"))
    GUI_SET_TEXT(aPlatzhalter, feldText$(i, "placeholder"))
    DIM tp AS STRING : tp = wz$(i, "table")
    GUI_SET_TEXT(aSpalten, listeText$(tp + ".headers"))
    GUI_SET_TEXT(aBreiten, listeText$(tp + ".col_widths"))
    GUI_SET_TEXT(aArten, listeText$(tp + ".col_type"))
    DIM teile AS ARRAY OF STRING : teile = []
    DIM k AS INTEGER
    IF JSON_HAS(doc, tp + ".col_edit") THEN
        FOR k = 0 TO JSON_LEN(doc, tp + ".col_edit") - 1
            IF JSON_GET_BOOL(doc, tp + ".col_edit." + STR$(k)) THEN ARRAY_PUSH(teile, STR$(k))
        NEXT
    END IF
    GUI_SET_TEXT(aBearb, JOIN$(teile, "; "))
    teile = []
    IF JSON_HAS(doc, tp + ".col_choices") THEN
        FOR k = 0 TO JSON_LEN(doc, tp + ".col_choices") - 1
            DIM lp AS STRING : lp = tp + ".col_choices." + STR$(k)
            IF JSON_LEN(doc, lp) > 0 THEN ARRAY_PUSH(teile, STR$(k) + " = " + REPLACE$(listeText$(lp), "; ", "|"))
        NEXT
    END IF
    GUI_SET_TEXT(aWahl, JOIN$(teile, "; "))
    DIM zm AS BOOLEAN : zm = FALSE
    IF JSON_HAS(doc, tp + ".zellmodus") THEN zm = JSON_GET_BOOL(doc, tp + ".zellmodus")
    GUI_SET_CHECKED(cbZellen, zm)
    DIM hp AS STRING : hp = tp
    IF art = "tree" THEN hp = wz$(i, "tree")
    GUI_SET_TEXT(aLeer, "")
    IF JSON_HAS(doc, hp + ".leer_text") THEN GUI_SET_TEXT(aLeer, JSON_GET_STRING(doc, hp + ".leer_text"))
    DIM up AS STRING : up = wz$(i, "list")
    IF art = "tree" THEN up = wz$(i, "tree")
    DIM umb AS BOOLEAN : umb = FALSE
    IF JSON_HAS(doc, up + ".bearbeitbar") THEN umb = JSON_GET_BOOL(doc, up + ".bearbeitbar")
    GUI_SET_CHECKED(cbUmbenennen, umb)
    DIM seite AS INTEGER : seite = 0
    IF JSON_HAS(doc, wz$(i, "tabctl.seite")) THEN seite = JSON_GET_INT(doc, wz$(i, "tabctl.seite"))
    GUI_SET_TEXT(aSeite, STR$(seite + 1))
    DIM frei AS BOOLEAN : frei = FALSE
    IF JSON_HAS(doc, wz$(i, "bearbeitbar")) THEN frei = JSON_GET_BOOL(doc, wz$(i, "bearbeitbar"))
    GUI_SET_CHECKED(cbFrei, frei)
END SUB

' Felder je Art -> Modell.
SUB artUebernehmen(i AS INTEGER)
    DIM art AS STRING : art = feldText$(i, "kind")
    DIM t AS STRING
    IF art = "dropdown" OR art = "listbox" OR art = "accordion" OR art = "wizard" OR art = "tabcontrol" THEN listeSetzen(wz$(i, "items"), GUI_TEXT(aEintraege), FALSE)
    IF art = "tabcontrol" OR art = "wizard" THEN
        IF NOT JSON_HAS(doc, wz$(i, "tabctl")) THEN JSON_SET_JSON(doc, wz$(i, "tabctl"), JSON_NEW_OBJECT())
        DIM sz AS INTEGER : sz = MAX(1, seitenZahl(i))
        JSON_SET_INT(doc, wz$(i, "tabctl.seite"), MAX(0, MIN(sz - 1, INT(VAL(GUI_TEXT(aSeite))) - 1)))
    END IF
    IF art = "dropdown" THEN
        ' Abgewaehlt wird der Schluessel ENTFERNT -- die Laufzeit schreibt
        ' ihn nur, wenn er an ist.
        IF GUI_CHECKED(cbFrei) THEN
            JSON_SET_BOOL(doc, wz$(i, "bearbeitbar"), TRUE)
        ELSEIF JSON_HAS(doc, wz$(i, "bearbeitbar")) THEN
            JSON_REMOVE(doc, wz$(i, "bearbeitbar"))
        END IF
    END IF
    IF art = "slider" OR art = "progress" OR art = "spinner" OR art = "knob" THEN
        IF TRIM$(GUI_TEXT(aMin)) <> "" THEN JSON_SET_FLOAT(doc, wz$(i, "min"), VAL(GUI_TEXT(aMin)))
        IF TRIM$(GUI_TEXT(aMax)) <> "" THEN JSON_SET_FLOAT(doc, wz$(i, "max"), VAL(GUI_TEXT(aMax)))
        IF TRIM$(GUI_TEXT(aWert)) <> "" THEN JSON_SET_FLOAT(doc, wz$(i, "value"), VAL(GUI_TEXT(aWert)))
    END IF
    IF art = "card" THEN JSON_SET_STRING(doc, wz$(i, "placeholder"), GUI_TEXT(aBeschr))
    IF art = "dropdown" THEN JSON_SET_STRING(doc, wz$(i, "placeholder"), GUI_TEXT(aPlatzhalter))
    IF art = "listbox" OR art = "tree" THEN
        ' Abgewaehlt wird der Schluessel ENTFERNT, nicht auf FALSE gesetzt --
        ' die Laufzeit schreibt ihn auch nur, wenn er an ist.
        DIM lp AS STRING : lp = wz$(i, "list")
        IF art = "tree" THEN lp = wz$(i, "tree")
        IF GUI_CHECKED(cbUmbenennen) THEN
            IF NOT JSON_HAS(doc, lp) THEN JSON_SET_JSON(doc, lp, JSON_NEW_OBJECT())
            JSON_SET_BOOL(doc, lp + ".bearbeitbar", TRUE)
        ELSEIF JSON_HAS(doc, lp + ".bearbeitbar") THEN
            JSON_REMOVE(doc, lp + ".bearbeitbar")
        END IF
    END IF
    IF art = "tree" THEN
        DIM bp AS STRING : bp = wz$(i, "tree")
        IF TRIM$(GUI_TEXT(aLeer)) <> "" THEN
            IF NOT JSON_HAS(doc, bp) THEN JSON_SET_JSON(doc, bp, JSON_NEW_OBJECT())
            JSON_SET_STRING(doc, bp + ".leer_text", TRIM$(GUI_TEXT(aLeer)))
        ELSEIF JSON_HAS(doc, bp + ".leer_text") THEN
            JSON_REMOVE(doc, bp + ".leer_text")
        END IF
    END IF
    IF art <> "table" THEN RETURN
    DIM tp AS STRING : tp = wz$(i, "table")
    IF NOT JSON_HAS(doc, tp) THEN JSON_SET_JSON(doc, tp, JSON_NEW_OBJECT())
    listeSetzen(tp + ".headers", GUI_TEXT(aSpalten), FALSE)
    listeSetzen(tp + ".col_widths", GUI_TEXT(aBreiten), TRUE)
    DIM ns AS INTEGER : ns = 0
    IF JSON_HAS(doc, tp + ".headers") THEN ns = JSON_LEN(doc, tp + ".headers")
    DIM k AS INTEGER
    ' Bearbeitbar: Spaltennummern oder "alle".
    DIM be AS STRING : be = LOWER$(TRIM$(REPLACE$(GUI_TEXT(aBearb), ",", ";")))
    DIM ce AS JSON_HANDLE : ce = JSON_NEW_ARRAY()
    DIM ceN AS INTEGER : ceN = 0
    IF be = "alle" THEN
        FOR k = 0 TO ns - 1
            JSON_APPEND_BOOL(ce, "", TRUE)
            ceN = ceN + 1
        NEXT
    ELSE
        DIM nummern AS ARRAY OF INTEGER : nummern = []
        DIM groesste AS INTEGER : groesste = -1
        FOR EACH t IN SPLIT$(be, ";")
            IF TRIM$(t) <> "" THEN
                ARRAY_PUSH(nummern, INT(VAL(TRIM$(t))))
                groesste = MAX(groesste, INT(VAL(TRIM$(t))))
            END IF
        NEXT
        FOR k = 0 TO groesste
            JSON_APPEND_BOOL(ce, "", ARRAY_INDEXOF(nummern, k) >= 0)
            ceN = ceN + 1
        NEXT
    END IF
    IF ceN > 0 THEN
        JSON_SET_JSON(doc, tp + ".col_edit", ce)
    ELSEIF JSON_HAS(doc, tp + ".col_edit") THEN
        JSON_REMOVE(doc, tp + ".col_edit")
    END IF
    ' Spaltenarten; eine Spalte mit Auswahlliste ist eine Auswahlspalte, auch
    ' wenn das Feld es nicht sagt -- sonst wirkte die Liste beim Laden nicht.
    DIM arten AS ARRAY OF STRING : arten = []
    FOR EACH t IN SPLIT$(GUI_TEXT(aArten), ";")
        IF TRIM$(t) <> "" THEN ARRAY_PUSH(arten, LOWER$(TRIM$(t)))
    NEXT
    DIM spalte AS ARRAY OF INTEGER : spalte = []
    DIM listen AS ARRAY OF STRING : listen = []
    DIM maxS AS INTEGER : maxS = -1
    FOR EACH t IN SPLIT$(GUI_TEXT(aWahl), ";")
        DIM teile AS ARRAY OF STRING : teile = SPLIT$(t, "=")
        IF LEN(teile) = 2 THEN
            ARRAY_PUSH(spalte, INT(VAL(TRIM$(teile[0]))))
            ARRAY_PUSH(listen, TRIM$(teile[1]))
            maxS = MAX(maxS, INT(VAL(TRIM$(teile[0]))))
        END IF
    NEXT
    IF maxS >= 0 THEN
        DIM cw AS JSON_HANDLE : cw = JSON_NEW_ARRAY()
        FOR k = 0 TO maxS
            DIM eintr AS JSON_HANDLE : eintr = JSON_NEW_ARRAY()
            DIM q AS INTEGER : q = ARRAY_INDEXOF(spalte, k)
            IF q >= 0 THEN
                DIM e AS STRING
                FOR EACH e IN SPLIT$(listen[q], "|")
                    IF TRIM$(e) <> "" THEN JSON_APPEND_STRING(eintr, "", TRIM$(e))
                NEXT
                WHILE LEN(arten) <= k
                    ARRAY_PUSH(arten, "text")
                WEND
                arten[k] = "auswahl"
            END IF
            JSON_APPEND_JSON(cw, "", eintr)
        NEXT
        JSON_SET_JSON(doc, tp + ".col_choices", cw)
    ELSEIF JSON_HAS(doc, tp + ".col_choices") THEN
        JSON_REMOVE(doc, tp + ".col_choices")
    END IF
    listeSetzen(tp + ".col_type", JOIN$(arten, ";"), FALSE)
    IF GUI_CHECKED(cbZellen) THEN
        JSON_SET_BOOL(doc, tp + ".zellmodus", TRUE)
    ELSEIF JSON_HAS(doc, tp + ".zellmodus") THEN
        JSON_REMOVE(doc, tp + ".zellmodus")
    END IF
    IF TRIM$(GUI_TEXT(aLeer)) <> "" THEN
        JSON_SET_STRING(doc, tp + ".leer_text", TRIM$(GUI_TEXT(aLeer)))
    ELSEIF JSON_HAS(doc, tp + ".leer_text") THEN
        JSON_REMOVE(doc, tp + ".leer_text")
    END IF
END SUB

SUB inspektorSichtbar(widgetModus AS BOOLEAN)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(inspFelder) - 1
        GUI_SET_VISIBLE(inspFelder[i], widgetModus) : GUI_SET_VISIBLE(inspLabels[i], widgetModus)
    NEXT
    IF NOT widgetModus THEN artSichtbar("")
    GUI_SET_VISIBLE(cbAktiv, widgetModus) : GUI_SET_VISIBLE(btnUebernehmen, TRUE)
    GUI_SET_VISIBLE(fTitel, NOT widgetModus) : GUI_SET_VISIBLE(lTitel, NOT widgetModus)
    GUI_SET_VISIBLE(fFormB, NOT widgetModus) : GUI_SET_VISIBLE(lFormB, NOT widgetModus)
    GUI_SET_VISIBLE(fFormH, NOT widgetModus) : GUI_SET_VISIBLE(lFormH, NOT widgetModus)
    GUI_SET_VISIBLE(cbResizable, NOT widgetModus) : GUI_SET_VISIBLE(lThema, NOT widgetModus) : GUI_SET_VISIBLE(ddThema, NOT widgetModus)
END SUB

SUB inspektorFuellen()
    inspStumm = TRUE
    IF auswahl >= 0 AND auswahl < anzahl() THEN
        inspektorSichtbar(TRUE)
        IF LEN(gewaehlt) > 1 THEN
            GUI_SET_TEXT(lblInsp, feldText$(auswahl, "kind") + "  #" + STR$(auswahl) + "  (+" + STR$(LEN(gewaehlt) - 1) + " weitere)")
        ELSE
            GUI_SET_TEXT(lblInsp, feldText$(auswahl, "kind") + "  #" + STR$(auswahl))
        END IF
        DIM i AS INTEGER
        FOR i = 0 TO LEN(inspFelder) - 1
            DIM k AS STRING : k = inspNamen[i]
            IF k = "x" OR k = "y" OR k = "w" OR k = "h" THEN
                GUI_SET_TEXT(inspFelder[i], STR$(feldZahl(auswahl, k)))
            ELSE
                GUI_SET_TEXT(inspFelder[i], feldText$(auswahl, k))
            END IF
        NEXT
        DIM an AS BOOLEAN : an = TRUE
        IF JSON_HAS(doc, wz$(auswahl, "enabled")) THEN an = JSON_GET_BOOL(doc, wz$(auswahl, "enabled"))
        GUI_SET_CHECKED(cbAktiv, an)
        artFuellen(auswahl)
        IF LEN(gewaehlt) > 1 THEN
            GUI_SET_TEXT(lblHinweis, STR$(LEN(gewaehlt)) + " Controls gewaehlt -- das Menue Anordnen richtet sie am hier gezeigten aus. Entf, Strg+D und die Pfeile gelten fuer alle.")
        ELSE
            GUI_SET_TEXT(lblHinweis, "Enter in einem Feld oder [Uebernehmen] schreibt die Werte. Entf loescht, Strg+D verdoppelt, Pfeile schieben.")
        END IF
    ELSE
        inspektorSichtbar(FALSE)
        GUI_SET_TEXT(lblInsp, "Formular")
        GUI_SET_TEXT(fTitel, JSON_GET_STRING(doc, "title"))
        GUI_SET_TEXT(fFormB, STR$(JSON_GET_INT(doc, "w")))
        GUI_SET_TEXT(fFormH, STR$(JSON_GET_INT(doc, "h")))
        DIM rz AS BOOLEAN : rz = FALSE
        IF JSON_HAS(doc, "resizable") THEN rz = JSON_GET_BOOL(doc, "resizable")
        GUI_SET_CHECKED(cbResizable, rz)
        DIM thema AS STRING : thema = ""
        IF JSON_HAS(doc, "theme") THEN thema = JSON_GET_STRING(doc, "theme")
        DIM ti AS INTEGER : ti = 0
        IF thema = "glas_dunkel" THEN ti = 1
        IF thema = "glas_hell" THEN ti = 2
        IF thema = "dark" THEN ti = 3
        IF thema = "light" THEN ti = 4
        GUI_DROPDOWN_SET_SELECTED(ddThema, ti)
        GUI_SET_TEXT(lblHinweis, "Kein Control ausgewaehlt: das sind die Werte des Formulars. Ein Klick auf ein Control zeigt seine.")
    END IF
    inspStumm = FALSE
END SUB

' Inspektor -> Modell
SUB inspektorUebernehmen()
    IF auswahl >= 0 AND auswahl < anzahl() THEN
        DIM alterName AS STRING : alterName = feldText$(auswahl, "name")
        DIM i AS INTEGER
        FOR i = 0 TO LEN(inspFelder) - 1
            DIM k AS STRING : k = inspNamen[i]
            DIM t AS STRING : t = GUI_TEXT(inspFelder[i])
            IF k = "x" OR k = "y" OR k = "w" OR k = "h" THEN
                DIM v AS INTEGER : v = INT(VAL(t))
                IF (k = "w" OR k = "h") AND v < 4 THEN v = 4
                JSON_SET_INT(doc, wz$(auswahl, k), v)
            ELSEIF t = "" THEN
                IF JSON_HAS(doc, wz$(auswahl, k)) THEN JSON_REMOVE(doc, wz$(auswahl, k))
            ELSE
                JSON_SET_STRING(doc, wz$(auswahl, k), t)
            END IF
        NEXT
        IF GUI_CHECKED(cbAktiv) THEN
            IF JSON_HAS(doc, wz$(auswahl, "enabled")) THEN JSON_REMOVE(doc, wz$(auswahl, "enabled"))
        ELSE
            JSON_SET_BOOL(doc, wz$(auswahl, "enabled"), FALSE)
        END IF
        artUebernehmen(auswahl)
        ' Ein umbenanntes Reiterwerk nimmt seine Kinder mit -- sie fuehren es
        ' am Namen und staenden sonst auf keiner Seite mehr.
        DIM neuerName AS STRING : neuerName = feldText$(auswahl, "name")
        IF istBehaelter(auswahl) AND alterName <> "" AND LOWER$(neuerName) <> LOWER$(alterName) THEN
            DIM c AS INTEGER
            FOR c = 0 TO anzahl() - 1
                DIM r AS STRING : r = feldText$(c, "reiter")
                IF LOWER$(LEFT$(r, LEN(alterName) + 1)) = LOWER$(alterName) + ":" THEN
                    JSON_SET_STRING(doc, wz$(c, "reiter"), neuerName + MID$(r, LEN(alterName), LEN(r)))
                END IF
            NEXT
        END IF
    ELSE
        JSON_SET_STRING(doc, "title", GUI_TEXT(fTitel))
        JSON_SET_INT(doc, "w", MAX(INT(VAL(GUI_TEXT(fFormB))), 80))
        JSON_SET_INT(doc, "h", MAX(INT(VAL(GUI_TEXT(fFormH))), 60))
        JSON_SET_BOOL(doc, "resizable", GUI_CHECKED(cbResizable))
        DIM ti AS INTEGER : ti = GUI_DROPDOWN_SELECTED(ddThema)
        IF ti <= 0 THEN
            IF JSON_HAS(doc, "theme") THEN JSON_REMOVE(doc, "theme")
        ELSE
            JSON_SET_STRING(doc, "theme", GUI_DROPDOWN_TEXT(ddThema))
        END IF
    END IF
    ansichtBauen()
    merken()
    inspektorFuellen()
    protokoll("uebernommen")
END SUB

' --- Controls anlegen, loeschen, ordnen -------------------------------------
FUNCTION eindeutigerName$(art AS STRING) AS STRING
    DIM n AS INTEGER : n = 1
    DIM kandidat AS STRING
    REPEAT
        kandidat = art + STR$(n)
        DIM frei AS BOOLEAN : frei = TRUE
        DIM i AS INTEGER
        FOR i = 0 TO anzahl() - 1
            IF feldText$(i, "name") = kandidat THEN frei = FALSE
        NEXT
        n = n + 1
    UNTIL frei
    RETURN kandidat
END FUNCTION

FUNCTION amRaster(v AS INTEGER) AS INTEGER
    RETURN INT((v + RASTER \ 2) \ RASTER) * RASTER
END FUNCTION

SUB controlAnlegen(p AS INTEGER, x AS INTEGER, y AS INTEGER)
    DIM w AS JSON_HANDLE : w = JSON_NEW_OBJECT()
    ' Gitter und Baumtabelle sind keine eigenen Arten, sondern Tabellen im
    ' Zellmodus bzw. mit Baum.
    DIM kind AS STRING : kind = palArt[p]
    IF kind = "grid" OR kind = "treetable" THEN kind = "table"
    JSON_SET_STRING(w, "kind", kind)
    IF palArt[p] = "grid" THEN
        JSON_SET_STRING(w, "name", eindeutigerName$("gitter"))
    ELSEIF palArt[p] = "treetable" THEN
        JSON_SET_STRING(w, "name", eindeutigerName$("baumtabelle"))
    ELSE
        JSON_SET_STRING(w, "name", eindeutigerName$(kind))
    END IF
    IF palArt[p] = "table" THEN JSON_SET_JSON(w, "table", JSON_PARSE(REPLACE$("{'headers':['Name','Wert']}", "'", CHR$(34))))
    IF palArt[p] = "grid" THEN JSON_SET_JSON(w, "table", JSON_PARSE(REPLACE$("{'headers':['A','B','C'],'zellmodus':true,'col_edit':[true,true,true]}", "'", CHR$(34))))
    IF palArt[p] = "treetable" THEN JSON_SET_JSON(w, "table", JSON_PARSE(REPLACE$("{'headers':['Name','Wert'],'baum':true}", "'", CHR$(34))))
    IF palArt[p] = "accordion" THEN JSON_SET_JSON(w, "items", JSON_PARSE(REPLACE$("['Abschnitt 1','Abschnitt 2']", "'", CHR$(34))))
    IF palArt[p] = "wizard" THEN JSON_SET_JSON(w, "items", JSON_PARSE(REPLACE$("['Schritt 1','Schritt 2']", "'", CHR$(34))))
    IF palArt[p] = "tabcontrol" THEN JSON_SET_JSON(w, "items", JSON_PARSE(REPLACE$("['Seite 1','Seite 2']", "'", CHR$(34))))
    JSON_SET_INT(w, "x", amRaster(x)) : JSON_SET_INT(w, "y", amRaster(y))
    JSON_SET_INT(w, "w", palB[p]) : JSON_SET_INT(w, "h", palH[p])
    IF palText[p] THEN JSON_SET_STRING(w, "text", palName[p])
    IF palArt[p] = "dropdown" OR palArt[p] = "listbox" THEN
        JSON_SET_JSON(w, "items", JSON_PARSE("[" + CHR$(34) + "Eintrag 1" + CHR$(34) + "," + CHR$(34) + "Eintrag 2" + CHR$(34) + "]"))
    END IF
    IF palArt[p] = "slider" OR palArt[p] = "progress" THEN JSON_SET_FLOAT(w, "min", 0.0) : JSON_SET_FLOAT(w, "max", 100.0) : JSON_SET_FLOAT(w, "value", 50.0)
    JSON_APPEND_JSON(doc, "widgets", w)
    auswahlSetzen(anzahl() - 1)
    ansichtBauen()
    merken()
    inspektorFuellen()
    GUI_SET_TEXT(lblStatus, palName[p] + " abgelegt bei " + STR$(amRaster(x)) + ", " + STR$(amRaster(y)))
    protokoll("neu " + palArt[p] + " " + STR$(amRaster(x)) + " " + STR$(amRaster(y)))
END SUB

SUB controlLoeschen()
    IF auswahl < 0 THEN RETURN
    ' Von hinten nach vorn -- sonst rueckten die Nummern der uebrigen auf.
    DIM weg AS ARRAY OF INTEGER : weg = gewaehlt
    SORT(weg)
    DIM k AS INTEGER
    FOR k = LEN(weg) - 1 TO 0 STEP -1
        JSON_REMOVE(doc, "widgets." + STR$(weg[k]))
    NEXT
    IF LEN(weg) = 1 THEN protokoll("geloescht " + STR$(weg[0])) ELSE protokoll("geloescht " + STR$(LEN(weg)) + " controls")
    auswahlSetzen(-1)
    ansichtBauen()
    merken()
    inspektorFuellen()
END SUB

SUB controlVerdoppeln()
    IF auswahl < 0 THEN RETURN
    ' Alle gewaehlten; danach sind die Kopien gewaehlt (das Kopierte des
    ' zuletzt angeklickten vorn im Inspektor).
    DIM quellen AS ARRAY OF INTEGER : quellen = gewaehlt
    DIM haupt AS INTEGER : haupt = auswahl
    DIM neue AS ARRAY OF INTEGER : neue = []
    DIM neuHaupt AS INTEGER : neuHaupt = -1
    DIM q AS INTEGER
    FOR EACH q IN quellen
        ' Das Widget als eigenes Handle (JSON_SET_JSON/APPEND_JSON brauchen eins).
        DIM neu AS JSON_HANDLE : neu = teilbaum(doc, "widgets." + STR$(q))
        JSON_SET_INT(neu, "x", feldZahl(q, "x") + RASTER)
        JSON_SET_INT(neu, "y", feldZahl(q, "y") + RASTER)
        JSON_SET_STRING(neu, "name", eindeutigerName$(feldText$(q, "kind")))
        JSON_APPEND_JSON(doc, "widgets", neu)
        ARRAY_PUSH(neue, anzahl() - 1)
        IF q = haupt THEN neuHaupt = anzahl() - 1
    NEXT
    gewaehlt = neue
    auswahl = neuHaupt
    ansichtBauen()
    merken()
    inspektorFuellen()
    protokoll("verdoppelt")
END SUB

' Ein Teilbaum als eigenes Handle -- ueber seinen Text.
FUNCTION teilbaum(h AS JSON_HANDLE, pfad AS STRING) AS JSON_HANDLE
    DIM huelle AS JSON_HANDLE : huelle = JSON_NEW_OBJECT()
    ' JSON_STRINGIFY kennt nur ganze Handles: den Teil in ein neues Objekt heben.
    DIM typ AS STRING : typ = JSON_TYPE(h, pfad)
    IF typ = "array" THEN
        DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
        DIM n AS INTEGER : n = JSON_LEN(h, pfad)
        DIM i AS INTEGER
        FOR i = 0 TO n - 1
            DIM ep AS STRING : ep = pfad + "." + STR$(i)
            DIM et AS STRING : et = JSON_TYPE(h, ep)
            IF et = "string" THEN JSON_APPEND_STRING(a, "", JSON_GET_STRING(h, ep))
            IF et = "number" THEN
                ' JSON_TYPE unterscheidet nicht: eine ganze Zahl bleibt ganz,
                ' sonst laese GUI_FROM_JSON aus 48.0 kein x mehr.
                DIM ef AS FLOAT : ef = JSON_GET_FLOAT(h, ep)
                IF ef = INT(ef) THEN JSON_APPEND_INT(a, "", INT(ef)) ELSE JSON_APPEND_FLOAT(a, "", ef)
            END IF
            IF et = "boolean" THEN JSON_APPEND_BOOL(a, "", JSON_GET_BOOL(h, ep))
            IF et = "array" OR et = "object" THEN JSON_APPEND_JSON(a, "", teilbaum(h, ep))
        NEXT
        RETURN a
    END IF
    DIM o AS JSON_HANDLE : o = JSON_NEW_OBJECT()
    DIM k AS STRING
    FOR EACH k IN JSON_KEYS(h, pfad)
        DIM kp AS STRING : kp = pfad + "." + k
        DIM kt AS STRING : kt = JSON_TYPE(h, kp)
        IF kt = "string" THEN JSON_SET_STRING(o, k, JSON_GET_STRING(h, kp))
        IF kt = "number" THEN
            DIM kf AS FLOAT : kf = JSON_GET_FLOAT(h, kp)
            IF kf = INT(kf) THEN JSON_SET_INT(o, k, INT(kf)) ELSE JSON_SET_FLOAT(o, k, kf)
        END IF
        IF kt = "boolean" THEN JSON_SET_BOOL(o, k, JSON_GET_BOOL(h, kp))
        IF kt = "array" OR kt = "object" THEN JSON_SET_JSON(o, k, teilbaum(h, kp))
    NEXT
    RETURN o
END FUNCTION

' Reihenfolge = Zeichenreihenfolge: das letzte liegt vorn.
SUB controlOrdnen(nachVorn AS BOOLEAN)
    IF auswahl < 0 THEN RETURN
    DIM n AS INTEGER : n = anzahl()
    DIM ziel AS INTEGER
    IF nachVorn THEN ziel = n - 1 ELSE ziel = 0
    IF ziel = auswahl THEN RETURN
    DIM kopie AS JSON_HANDLE : kopie = teilbaum(doc, "widgets." + STR$(auswahl))
    JSON_REMOVE(doc, "widgets." + STR$(auswahl))
    IF nachVorn THEN
        JSON_APPEND_JSON(doc, "widgets", kopie)
        auswahlSetzen(n - 1)
    ELSE
        ' vorn einfuegen: alle anderen hinten anhaengen, dann die Liste tauschen
        DIM neu AS JSON_HANDLE : neu = JSON_NEW_ARRAY()
        JSON_APPEND_JSON(neu, "", kopie)
        DIM i AS INTEGER
        FOR i = 0 TO n - 2
            JSON_APPEND_JSON(neu, "", teilbaum(doc, "widgets." + STR$(i)))
        NEXT
        JSON_SET_JSON(doc, "widgets", neu)
        auswahlSetzen(0)
    END IF
    ansichtBauen()
    merken()
    inspektorFuellen()
END SUB

' --- Datei ------------------------------------------------------------------
SUB neuesFormular()
    doc = JSON_PARSE(leeresFormular$())
    formPfad = ""
    auswahlSetzen(-1)
    staende = [] : standPos = -1
    ansichtBauen()
    merken()
    geaendert = FALSE
    inspektorFuellen()
    GUI_SET_TEXT(lblStatus, "Neues Formular.")
END SUB

SUB formularLaden(pfad AS STRING)
    IF NOT FILEEXISTS(pfad) THEN
        ' Eine noch nicht vorhandene Datei: neues Formular, das dorthin gesichert wird.
        neuesFormular()
        formPfad = pfad
        GUI_SET_TEXT(lblStatus, "Neu: " + pfad)
        protokoll("neu-datei " + pfad)
        RETURN
    END IF
    doc = JSON_LOAD(pfad)
    IF NOT JSON_HAS(doc, "widgets") THEN JSON_SET_JSON(doc, "widgets", JSON_NEW_ARRAY())
    formPfad = pfad
    auswahlSetzen(-1)
    reiterAusDatei()
    staende = [] : standPos = -1
    ansichtBauen()
    merken()
    geaendert = FALSE
    inspektorFuellen()
    GUI_SET_TEXT(lblStatus, "Geladen: " + pfad + " (" + STR$(anzahl()) + " Controls)")
    protokoll("geladen " + STR$(anzahl()))
END SUB

FUNCTION sichern(alsNeu AS BOOLEAN) AS BOOLEAN
    IF formPfad = "" OR alsNeu THEN
        DIM p AS STRING : p = FILE_SAVE_DIALOG("Formular sichern", "formular.dhform", "dhform")
        IF p = "" THEN RETURN FALSE
        formPfad = p
    END IF
    WRITEALL(formPfad, JSON_PRETTY(doc))
    geaendert = FALSE
    GUI_SET_TEXT(lblStatus, "Gesichert: " + formPfad)
    protokoll("gesichert " + formPfad)
    RETURN TRUE
END FUNCTION

' --- Ausfuehren: Programm-Geruest wie der Qt-Designer, dann dhrt run ---------
DIM laufProzess AS INTEGER : laufProzess = -1

FUNCTION handlerNamen() AS ARRAY OF STRING
    DIM namen AS ARRAY OF STRING : namen = []
    DIM i AS INTEGER
    DIM ev AS STRING
    FOR i = 0 TO anzahl() - 1
        FOR EACH ev IN ("on_click", "on_change", "on_enter", "on_hover", "on_leave", "on_focus", "on_blur")
            DIM n AS STRING : n = feldText$(i, ev)
            IF n <> "" AND ARRAY_INDEXOF(namen, n) < 0 THEN ARRAY_PUSH(namen, n)
        NEXT
    NEXT
    RETURN namen
END FUNCTION

FUNCTION dhString$(s AS STRING) AS STRING
    RETURN CHR$(34) + REPLACE$(s, CHR$(34), CHR$(34) + CHR$(34)) + CHR$(34)
END FUNCTION

FUNCTION laufProgramm$() AS STRING
    DIM z AS ARRAY OF STRING : z = []
    ARRAY_PUSH(z, "' Erzeugt vom Form-Designer -- Layout: " + BASENAME(formPfad))
    ARRAY_PUSH(z, "IMPORT " + dhString$("gui"))
    ARRAY_PUSH(z, "SCREEN(" + STR$(JSON_GET_INT(doc, "w")) + ", " + STR$(JSON_GET_INT(doc, "h")) + ", " + dhString$(JSON_GET_STRING(doc, "title")) + ", 1)")
    IF JSON_HAS(doc, "theme") THEN ARRAY_PUSH(z, "GUI_THEME_PRESET(" + dhString$(JSON_GET_STRING(doc, "theme")) + ")")
    IF JSON_HAS(doc, "resizable") THEN
        IF JSON_GET_BOOL(doc, "resizable") THEN ARRAY_PUSH(z, "WINDOW_RESIZABLE(TRUE)")
    END IF
    ARRAY_PUSH(z, "")
    ARRAY_PUSH(z, "DIM frm AS GUI_WINDOW")
    ARRAY_PUSH(z, "frm = GUI_LOAD(" + dhString$(BASENAME(formPfad)) + ")")
    ARRAY_PUSH(z, "GUI_WINDOW_CHROME(frm, FALSE)        ' randlos -- das OS-Fenster liefert den Rahmen")
    ARRAY_PUSH(z, "GUI_WINDOW_RESIZABLE(frm, FALSE)")
    ARRAY_PUSH(z, "")
    DIM n AS STRING
    FOR EACH n IN handlerNamen()
        ARRAY_PUSH(z, "SUB " + n + "()")
        IF JSON_HAS(doc, "code." + n) THEN
            DIM zeile AS STRING
            FOR EACH zeile IN SPLIT$(JSON_GET_STRING(doc, "code." + n), NL)
                ARRAY_PUSH(z, "    " + zeile)
            NEXT
        ELSE
            ARRAY_PUSH(z, "    ' TODO: " + n)
        END IF
        ARRAY_PUSH(z, "END SUB")
        ARRAY_PUSH(z, "")
    NEXT
    ARRAY_PUSH(z, "WHILE NOT QUITREQUESTED()")
    ARRAY_PUSH(z, "    GUI_WINDOW_SET_BOUNDS(frm, 0, 0, SCREENWIDTH(), SCREENHEIGHT())")
    ARRAY_PUSH(z, "    GUI_UPDATE()")
    ARRAY_PUSH(z, "    CLS(&H0E1014)")
    ARRAY_PUSH(z, "    GUI_DRAW()")
    ARRAY_PUSH(z, "    FLIP()")
    ARRAY_PUSH(z, "WEND")
    RETURN JOIN$(z, NL) + NL
END FUNCTION

' --- DH-Code: das Formular Aufruf fuer Aufruf, ohne GUI_LOAD ------------------
' Das Gegenstueck zu laufProgramm$: dort laedt das Programm die .dhform, hier
' steht jedes Control als eigener Aufruf im Quelltext -- lesbar, von Hand
' weiterzuschreiben, und ohne Datei daneben lauffaehig.
DIM dhZeilen AS ARRAY OF STRING : dhZeilen = []
DIM dhBenutzt AS ARRAY OF STRING : dhBenutzt = []

' Ein Text als Drachenhauch-Zeichenkette; mit Umbruch oder Rueckstrich als
' !"..." mit Escape-Folgen, sonst die schlichte Form.
FUNCTION dhText$(s AS STRING) AS STRING
    IF NOT (NL IN s) AND NOT (CHR$(13) IN s) AND NOT (CHR$(9) IN s) THEN RETURN dhString$(s)
    DIM e AS STRING : e = REPLACE$(s, "\", "\\")
    e = REPLACE$(e, CHR$(34), "\" + CHR$(34))
    e = REPLACE$(e, NL, "\n")
    e = REPLACE$(e, CHR$(13), "\r")
    e = REPLACE$(e, CHR$(9), "\t")
    RETURN "!" + CHR$(34) + e + CHR$(34)
END FUNCTION

FUNCTION dhIdent$(s AS STRING) AS STRING
    DIM r AS STRING : r = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(s) - 1
        DIM ch AS STRING : ch = MID$(s, i, 1)
        IF (ch >= "a" AND ch <= "z") OR (ch >= "A" AND ch <= "Z") OR (ch >= "0" AND ch <= "9") OR ch = "_" THEN r = r + ch ELSE r = r + "_"
    NEXT
    IF r = "" THEN RETURN "c"
    IF MID$(r, 0, 1) >= "0" AND MID$(r, 0, 1) <= "9" THEN r = "c" + r
    RETURN r
END FUNCTION

' Eine JSON-Liste als Feld-Literal: Texte in Anfuehrungszeichen, Zahlen blank.
FUNCTION dhListe$(pfad AS STRING) AS STRING
    IF NOT JSON_HAS(doc, pfad) THEN RETURN "[]"
    DIM teile AS ARRAY OF STRING : teile = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(doc, pfad) - 1
        DIM ep AS STRING : ep = pfad + "." + STR$(i)
        IF JSON_TYPE(doc, ep) = "number" THEN ARRAY_PUSH(teile, zahlText$(JSON_GET_FLOAT(doc, ep))) ELSE ARRAY_PUSH(teile, dhText$(JSON_GET_STRING(doc, ep)))
    NEXT
    RETURN "[" + JOIN$(teile, ", ") + "]"
END FUNCTION

FUNCTION dhZahl$(i AS INTEGER, feld AS STRING, vorgabe AS STRING) AS STRING
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN vorgabe
    RETURN zahlText$(JSON_GET_FLOAT(doc, wz$(i, feld)))
END FUNCTION

FUNCTION dhSchalter(pfad AS STRING) AS BOOLEAN
    IF NOT JSON_HAS(doc, pfad) THEN RETURN FALSE
    IF JSON_TYPE(doc, pfad) <> "boolean" THEN RETURN FALSE
    RETURN JSON_GET_BOOL(doc, pfad)
END FUNCTION

' Je Control der Variablenname im DH-Code (Index wie in doc.widgets) --
' die Zuordnung zu Reiterseiten kommt NACH allen Controls, dann gibt es
' Behaelter und Kind beide schon.
DIM dhVarNamen AS ARRAY OF STRING : dhVarNamen = []

SUB codeZeile(zeile AS STRING)
    ARRAY_PUSH(dhZeilen, zeile)
END SUB

SUB dhControl(i AS INTEGER)
    DIM k AS STRING : k = feldText$(i, "kind")
    DIM basis AS STRING : basis = feldText$(i, "name")
    IF basis = "" THEN basis = k + STR$(i + 1)
    basis = dhIdent$(basis)
    DIM v AS STRING : v = basis
    DIM nr AS INTEGER : nr = 2
    WHILE ARRAY_INDEXOF(dhBenutzt, LOWER$(v)) >= 0
        v = basis + STR$(nr)
        nr = nr + 1
    WEND
    ARRAY_PUSH(dhBenutzt, LOWER$(v))
    ARRAY_PUSH(dhVarNamen, v)
    DIM w AS INTEGER : w = feldZahl(i, "w")
    DIM h AS INTEGER : h = feldZahl(i, "h")
    DIM lage AS STRING : lage = STR$(feldZahl(i, "x")) + ", " + STR$(feldZahl(i, "y"))
    DIM rahmen AS STRING : rahmen = lage + ", " + STR$(w) + ", " + STR$(h)
    DIM t AS STRING : t = dhText$(feldText$(i, "text"))
    DIM mn AS STRING : mn = dhZahl$(i, "min", "0")
    DIM mx AS STRING : mx = dhZahl$(i, "max", "100")
    DIM wert AS STRING : wert = dhZahl$(i, "value", "0")
    DIM an AS STRING : an = "FALSE"
    IF dhSchalter(wz$(i, "checked")) THEN an = "TRUE"
    DIM ctor AS STRING : ctor = ""
    DIM groesse AS BOOLEAN : groesse = FALSE
    SELECT CASE k
        CASE "button" : ctor = "GUI_BUTTON(frm, " + t + ", " + rahmen + ")"
        CASE "label" : ctor = "GUI_LABEL(frm, " + t + ", " + lage + ")" : groesse = TRUE
        CASE "checkbox" : ctor = "GUI_CHECKBOX(frm, " + t + ", " + lage + ", " + an + ")" : groesse = TRUE
        CASE "radio"
            DIM gruppe AS STRING : gruppe = feldText$(i, "group")
            IF gruppe = "" THEN gruppe = "gruppe"
            ctor = "GUI_RADIO(frm, " + dhText$(gruppe) + ", " + t + ", " + lage + ")"
            groesse = TRUE
        CASE "slider" : ctor = "GUI_SLIDER(frm, " + lage + ", " + STR$(w) + ", " + mn + ", " + mx + ", " + wert + ")" : groesse = TRUE
        CASE "textinput" : ctor = "GUI_TEXTINPUT(frm, " + rahmen + ", " + dhText$(feldText$(i, "placeholder")) + ")"
        CASE "dropdown" : ctor = "GUI_DROPDOWN(frm, " + rahmen + ", " + dhListe$(wz$(i, "items")) + ")"
        CASE "listbox" : ctor = "GUI_LISTBOX(frm, " + rahmen + ", " + dhListe$(wz$(i, "items")) + ")"
        CASE "progress" : ctor = "GUI_PROGRESS(frm, " + rahmen + ")"
        CASE "table"
            IF dhSchalter(wz$(i, "table") + ".baum") THEN ctor = "GUI_TREETABLE(frm, " + rahmen + ")" ELSE ctor = "GUI_TABLE(frm, " + rahmen + ")"
        CASE "canvas" : ctor = "GUI_CANVAS(frm, " + rahmen + ")"
        CASE "panel" : ctor = "GUI_PANEL(frm, " + rahmen + ", " + t + ")"
        CASE "groupbox" : ctor = "GUI_GROUPBOX(frm, " + rahmen + ", " + t + ")"
        CASE "separator" : ctor = "GUI_SEPARATOR(frm, " + lage + ", " + STR$(w) + ")" : groesse = TRUE
        CASE "textarea" : ctor = "GUI_TEXTAREA(frm, " + rahmen + ", " + dhText$(feldText$(i, "placeholder")) + ")"
        CASE "spinner" : ctor = "GUI_SPINNER(frm, " + lage + ", " + STR$(w) + ", " + mn + ", " + mx + ", " + wert + ")" : groesse = TRUE
        CASE "knob" : ctor = "GUI_KNOB(frm, " + lage + ", " + STR$(MIN(w, h)) + ", " + mn + ", " + mx + ", " + wert + ")" : groesse = TRUE
        CASE "toggle" : ctor = "GUI_TOGGLE(frm, " + t + ", " + lage + ", " + an + ")" : groesse = TRUE
        CASE "tree" : ctor = "GUI_TREE(frm, " + rahmen + ")"
        CASE "layout"
            DIM la AS STRING : la = "spalte"
            IF JSON_HAS(doc, wz$(i, "layout.art")) THEN la = JSON_GET_STRING(doc, wz$(i, "layout.art"))
            ctor = "GUI_LAYOUT(frm, " + dhText$(la) + ", " + rahmen + ")"
        CASE "toolbar" : ctor = "GUI_TOOLBAR(frm, " + rahmen + ")"
        CASE "splitter"
            DIM richtung AS STRING : richtung = LOWER$(feldText$(i, "text"))
            IF richtung <> "v" THEN richtung = "h"
            DIM laenge AS INTEGER : laenge = w
            IF richtung = "v" THEN laenge = h
            ctor = "GUI_SPLITTER(frm, " + lage + ", " + STR$(laenge) + ", " + dhText$(richtung) + ", 40, " + STR$(MAX(80, laenge)) + ")"
            groesse = TRUE
        CASE "colorpicker" : ctor = "GUI_COLORPICKER(frm, " + rahmen + ")"
        CASE "datepicker" : ctor = "GUI_DATEPICKER(frm, " + rahmen + ")"
        CASE "richtext" : ctor = "GUI_RICHTEXT(frm, " + rahmen + ", " + t + ")"
        CASE "timepicker" : ctor = "GUI_TIMEPICKER(frm, " + rahmen + ")"
        CASE "tabcontrol" : ctor = "GUI_TABCONTROL(frm, " + rahmen + ")"
        CASE "statusbar" : ctor = "GUI_STATUSBAR(frm, " + rahmen + ", " + t + ")"
        CASE "breadcrumb" : ctor = "GUI_BREADCRUMB(frm, " + rahmen + ")"
        CASE "card" : ctor = "GUI_CARD(frm, " + rahmen + ", -1, " + t + ", " + dhText$(feldText$(i, "placeholder")) + ")"
        CASE "accordion" : ctor = "GUI_ACCORDION(frm, " + rahmen + ")"
        CASE "wizard" : ctor = "GUI_WIZARD(frm, " + rahmen + ")"
    END SELECT
    IF ctor = "" THEN
        ' Ein Bild braucht eine Quelle (LOADIMAGE), die die .dhform nicht kennt.
        codeZeile("' " + k + " '" + v + "' uebersprungen -- dafuer gibt es keinen Aufruf ohne weitere Angaben")
        codeZeile("")
        RETURN
    END IF
    codeZeile("DIM " + v + " AS GUI_WIDGET")
    codeZeile(v + " = " + ctor)
    ' Diese Konstruktoren messen sich selbst -- die Groesse aus dem Designer
    ' ginge sonst verloren.
    IF groesse THEN codeZeile("GUI_SET_BOUNDS(" + v + ", " + rahmen + ")")
    IF k = "table" THEN
        DIM tp AS STRING : tp = wz$(i, "table")
        IF JSON_HAS(doc, tp + ".headers") THEN codeZeile("GUI_TABLE_HEADERS(" + v + ", " + dhListe$(tp + ".headers") + ")")
        IF JSON_HAS(doc, tp + ".col_widths") THEN codeZeile("GUI_TABLE_COL_WIDTHS(" + v + ", " + dhListe$(tp + ".col_widths") + ")")
        IF dhSchalter(tp + ".zellmodus") THEN codeZeile("GUI_TABLE_SET(" + v + ", " + dhString$("zellmodus") + ", 1)")
        IF dhSchalter(tp + ".zeilen_anhaengen") THEN codeZeile("GUI_TABLE_SET(" + v + ", " + dhString$("zeilen_anhaengen") + ", 1)")
        IF dhSchalter(tp + ".zebra") THEN codeZeile("GUI_TABLE_SET(" + v + ", " + dhString$("zebra") + ", 1)")
        IF dhSchalter(tp + ".filter_row") THEN codeZeile("GUI_TABLE_SET(" + v + ", " + dhString$("filterzeile") + ", 1)")
        IF dhSchalter(tp + ".multi") THEN codeZeile("GUI_TABLE_SET(" + v + ", " + dhString$("mehrfachauswahl") + ", 1)")
        IF JSON_HAS(doc, tp + ".leer_text") THEN codeZeile("GUI_TABLE_PLACEHOLDER(" + v + ", " + dhText$(JSON_GET_STRING(doc, tp + ".leer_text")) + ")")
        DIM s AS INTEGER
        IF JSON_HAS(doc, tp + ".col_edit") THEN
            FOR s = 0 TO JSON_LEN(doc, tp + ".col_edit") - 1
                IF dhSchalter(tp + ".col_edit." + STR$(s)) THEN codeZeile("GUI_TABLE_COL_EDIT(" + v + ", " + STR$(s) + ", TRUE)")
            NEXT
        END IF
        IF JSON_HAS(doc, tp + ".col_type") THEN
            FOR s = 0 TO JSON_LEN(doc, tp + ".col_type") - 1
                DIM ct AS STRING : ct = JSON_GET_STRING(doc, tp + ".col_type." + STR$(s))
                IF ct = "ganz" OR ct = "zahl" THEN codeZeile("GUI_TABLE_COL_TYPE(" + v + ", " + STR$(s) + ", " + dhString$(ct) + ")")
            NEXT
        END IF
        IF JSON_HAS(doc, tp + ".col_choices") THEN
            FOR s = 0 TO JSON_LEN(doc, tp + ".col_choices") - 1
                DIM cp AS STRING : cp = tp + ".col_choices." + STR$(s)
                IF JSON_LEN(doc, cp) > 0 THEN codeZeile("GUI_TABLE_COL_CHOICES(" + v + ", " + STR$(s) + ", " + dhListe$(cp) + ")")
            NEXT
        END IF
        IF dhSchalter(tp + ".baum") THEN
            codeZeile("' " + v + ": Zeilen zur Laufzeit fuellen -- GUI_TREETABLE_ADD(" + v + ", eltern, zellen)")
        ELSE
            codeZeile("' " + v + ": Zeilen zur Laufzeit fuellen -- GUI_TABLE_ADD_ROW / GUI_TABLE_ROWS")
        END IF
    END IF
    IF k = "dropdown" AND feldText$(i, "placeholder") <> "" THEN codeZeile("GUI_DROPDOWN_PLACEHOLDER(" + v + ", " + dhText$(feldText$(i, "placeholder")) + ")")
    IF k = "dropdown" AND dhSchalter(wz$(i, "bearbeitbar")) THEN codeZeile("GUI_DROPDOWN_SET(" + v + ", " + dhString$("bearbeitbar") + ", 1)")
    IF k = "tabcontrol" AND JSON_HAS(doc, wz$(i, "items")) THEN
        DIM sei AS INTEGER
        FOR sei = 0 TO JSON_LEN(doc, wz$(i, "items")) - 1
            codeZeile("GUI_TABCONTROL_ADD(" + v + ", " + dhText$(JSON_GET_STRING(doc, wz$(i, "items") + "." + STR$(sei))) + ")")
        NEXT
    END IF
    IF k = "listbox" AND dhSchalter(wz$(i, "list") + ".bearbeitbar") THEN codeZeile("GUI_LISTBOX_SET(" + v + ", " + dhString$("bearbeitbar") + ", 1)")
    IF k = "tree" AND dhSchalter(wz$(i, "tree") + ".bearbeitbar") THEN codeZeile("GUI_TREE_SET(" + v + ", " + dhString$("bearbeitbar") + ", 1)")
    IF k = "tree" AND JSON_HAS(doc, wz$(i, "tree") + ".leer_text") THEN codeZeile("GUI_TREE_PLACEHOLDER(" + v + ", " + dhText$(JSON_GET_STRING(doc, wz$(i, "tree") + ".leer_text")) + ")")
    IF (k = "accordion" OR k = "wizard") AND JSON_HAS(doc, wz$(i, "items")) THEN
        DIM ab AS INTEGER
        FOR ab = 0 TO JSON_LEN(doc, wz$(i, "items")) - 1
            IF k = "accordion" THEN
                codeZeile("GUI_ACCORDION_ADD(" + v + ", " + dhText$(JSON_GET_STRING(doc, wz$(i, "items") + "." + STR$(ab))) + ")")
            ELSE
                codeZeile("GUI_WIZARD_ADD(" + v + ", " + dhText$(JSON_GET_STRING(doc, wz$(i, "items") + "." + STR$(ab))) + ")")
            END IF
        NEXT
        IF k = "accordion" THEN codeZeile("' " + v + ": Controls je Abschnitt -- GUI_ACCORDION_ADD_WIDGET(" + v + ", wdg, abschnitt)")
    END IF
    IF k = "datepicker" AND feldText$(i, "date") <> "" THEN codeZeile("GUI_SET_DATE(" + v + ", " + dhText$(feldText$(i, "date")) + ")")
    IF k = "timepicker" AND feldText$(i, "time") <> "" THEN codeZeile("GUI_SET_TIME(" + v + ", " + dhText$(feldText$(i, "time")) + ")")
    IF JSON_HAS(doc, wz$(i, "enabled")) THEN
        IF NOT dhSchalter(wz$(i, "enabled")) THEN codeZeile("GUI_SET_ENABLED(" + v + ", FALSE)")
    END IF
    DIM anker AS STRING : anker = feldText$(i, "anchor")
    IF anker <> "" AND anker <> "lt" THEN codeZeile("GUI_SET_ANCHOR(" + v + ", " + dhText$(anker) + ")")
    IF feldText$(i, "tooltip") <> "" THEN codeZeile("GUI_TOOLTIP(" + v + ", " + dhText$(feldText$(i, "tooltip")) + ")")
    IF feldText$(i, "font_style") <> "" AND feldText$(i, "font_style") <> "normal" THEN codeZeile("GUI_SET_FONT_STYLE(" + v + ", " + dhText$(feldText$(i, "font_style")) + ")")
    IF feldText$(i, "on_click") <> "" THEN codeZeile("GUI_ON_CLICK(" + v + ", " + feldText$(i, "on_click") + ")")
    IF feldText$(i, "on_change") <> "" THEN codeZeile("GUI_ON_CHANGE(" + v + ", " + feldText$(i, "on_change") + ")")
    IF feldText$(i, "on_enter") <> "" THEN codeZeile("GUI_ON_ENTER(" + v + ", " + feldText$(i, "on_enter") + ")")
    codeZeile("")
END SUB

FUNCTION dhCode$() AS STRING
    dhZeilen = []
    dhBenutzt = ["frm"]
    dhVarNamen = []
    codeZeile("' Erzeugt vom Form-Designer -- das Formular ausgeschrieben, ohne GUI_LOAD")
    codeZeile("' Vorlage: " + BASENAME(formPfad))
    codeZeile("IMPORT " + dhString$("gui"))
    codeZeile("SCREEN(" + STR$(JSON_GET_INT(doc, "w")) + ", " + STR$(JSON_GET_INT(doc, "h")) + ", " + dhText$(JSON_GET_STRING(doc, "title")) + ", 1)")
    IF JSON_HAS(doc, "theme") THEN codeZeile("GUI_THEME_PRESET(" + dhString$(JSON_GET_STRING(doc, "theme")) + ")")
    IF dhSchalter("resizable") THEN codeZeile("WINDOW_RESIZABLE(TRUE)")
    codeZeile("")
    DIM n AS STRING
    FOR EACH n IN handlerNamen()
        ARRAY_PUSH(dhBenutzt, LOWER$(n))
        codeZeile("SUB " + n + "()")
        IF JSON_HAS(doc, "code." + n) THEN
            DIM zeile AS STRING
            FOR EACH zeile IN SPLIT$(JSON_GET_STRING(doc, "code." + n), NL)
                codeZeile("    " + zeile)
            NEXT
        ELSE
            codeZeile("    ' TODO: " + n)
        END IF
        codeZeile("END SUB")
        codeZeile("")
    NEXT
    codeZeile("DIM frm AS GUI_WINDOW")
    codeZeile("frm = GUI_WINDOW(" + dhText$(JSON_GET_STRING(doc, "title")) + ", 0, 0, " + STR$(JSON_GET_INT(doc, "w")) + ", " + STR$(JSON_GET_INT(doc, "h")) + ")")
    codeZeile("GUI_WINDOW_CHROME(frm, FALSE)        ' randlos -- das OS-Fenster liefert den Rahmen")
    codeZeile("GUI_WINDOW_RESIZABLE(frm, FALSE)")
    IF JSON_HAS(doc, "menus") THEN codeZeile("' Menues stehen in der .dhform -- dieser Code baut sie nicht nach; GUI_LOAD tut es.")
    codeZeile("")
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        dhControl(i)
    NEXT
    ' Reiterseiten und Assistenten-Schritte, jetzt da es alle gibt.
    DIM zugeordnet AS BOOLEAN : zugeordnet = FALSE
    FOR i = 0 TO anzahl() - 1
        DIM rp AS INTEGER : rp = reiterVon(i)
        DIM rs AS INTEGER : rs = reiterSeite(i)
        IF rp < 0 OR rs < 1 OR rs > seitenZahl(rp) THEN CONTINUE
        IF feldText$(rp, "kind") = "wizard" THEN
            codeZeile("GUI_WIZARD_ADD_WIDGET(" + dhVarNamen[rp] + ", " + dhVarNamen[i] + ", " + STR$(rs - 1) + ")")
        ELSE
            codeZeile("GUI_TABCONTROL_ADD_WIDGET(" + dhVarNamen[rp] + ", " + dhVarNamen[i] + ", " + STR$(rs - 1) + ")")
        END IF
        zugeordnet = TRUE
    NEXT
    IF zugeordnet THEN codeZeile("")
    codeZeile("WHILE NOT QUITREQUESTED()")
    codeZeile("    GUI_WINDOW_SET_BOUNDS(frm, 0, 0, SCREENWIDTH(), SCREENHEIGHT())")
    codeZeile("    GUI_UPDATE()")
    codeZeile("    CLS(&H0E1014)")
    codeZeile("    GUI_DRAW()")
    codeZeile("    FLIP()")
    codeZeile("WEND")
    RETURN JOIN$(dhZeilen, NL) + NL
END FUNCTION

SUB dhCodeSchreiben()
    IF formPfad = "" OR geaendert THEN
        IF NOT sichern(FALSE) THEN RETURN
    END IF
    DIM stamm AS STRING : stamm = formPfad
    IF LOWER$(RIGHT$(stamm, 7)) = ".dhform" THEN stamm = LEFT$(stamm, LEN(stamm) - 7)
    DIM ziel AS STRING : ziel = stamm + "_code.dh"
    WRITEALL(ziel, dhCode$())
    GUI_SET_TEXT(lblStatus, "DH-Code geschrieben: " + BASENAME(ziel))
    protokoll("gbcode " + ziel)
END SUB

SUB ausfuehren()
    IF formPfad = "" OR geaendert THEN
        IF NOT sichern(FALSE) THEN RETURN
    END IF
    IF laufProzess >= 0 THEN PROCESS_KILL(laufProzess) : PROCESS_CLOSE(laufProzess) : laufProzess = -1
    DIM stamm AS STRING : stamm = formPfad
    IF LOWER$(RIGHT$(stamm, 7)) = ".dhform" THEN stamm = LEFT$(stamm, LEN(stamm) - 7)
    DIM lauf AS STRING : lauf = stamm + "_lauf.dh"
    WRITEALL(lauf, laufProgramm$())
    laufProzess = PROCESS_START("dhrt", "run", lauf)
    GUI_SET_TEXT(lblStatus, "Gestartet: " + BASENAME(lauf))
    protokoll("gestartet " + lauf)
END SUB

' --- Maus auf der Form --------------------------------------------------------
DIM modus AS INTEGER : modus = 0          ' 0 nichts, 1 verschieben, 2 groesse, 3 Auswahlrahmen
' Beim Verschieben mehrerer: ihre Lage am Anfang des Zuges.
DIM zugX AS ARRAY OF INTEGER : zugX = []
DIM zugY AS ARRAY OF INTEGER : zugY = []
' Auswahlrahmen: Ecke am Anfang (Formkoordinaten) und ob er dazunimmt.
DIM rahmenAn AS BOOLEAN : rahmenAn = FALSE
DIM rahmenDazu AS BOOLEAN : rahmenDazu = FALSE
DIM griff AS INTEGER : griff = -1         ' 0..7: NW N NE E SE S SW W
DIM startMx AS INTEGER
DIM startMy AS INTEGER
DIM startX AS INTEGER
DIM startY AS INTEGER
DIM startW AS INTEGER
DIM startH AS INTEGER
DIM bewegt AS BOOLEAN : bewegt = FALSE

FUNCTION indexVonHandle(h AS GUI_WIDGET) AS INTEGER
    IF h < 0 OR frm < 0 THEN RETURN -1
    DIM i AS INTEGER
    FOR i = 0 TO GUI_WINDOW_WIDGET_COUNT(frm) - 1
        IF GUI_WINDOW_WIDGET(frm, i) = h THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Griff unter der Maus (Bildschirmkoordinaten), -1 = keiner.
FUNCTION griffBei(mx AS INTEGER, my AS INTEGER) AS INTEGER
    ' Griffe gibt es nur bei EINEM gewaehlten Control -- eine Groesse fuer
    ' mehrere steht im Menue Anordnen.
    IF auswahl < 0 OR LEN(gewaehlt) <> 1 THEN RETURN -1
    DIM x AS INTEGER : x = formX + feldZahl(auswahl, "x")
    DIM y AS INTEGER : y = formY + feldZahl(auswahl, "y")
    DIM w AS INTEGER : w = feldZahl(auswahl, "w")
    DIM h AS INTEGER : h = feldZahl(auswahl, "h")
    DIM gx[8] AS INTEGER
    DIM gy[8] AS INTEGER
    gx[0] = x : gy[0] = y : gx[1] = x + w \ 2 : gy[1] = y : gx[2] = x + w : gy[2] = y
    gx[3] = x + w : gy[3] = y + h \ 2 : gx[4] = x + w : gy[4] = y + h : gx[5] = x + w \ 2 : gy[5] = y + h
    gx[6] = x : gy[6] = y + h : gx[7] = x : gy[7] = y + h \ 2
    DIM i AS INTEGER
    FOR i = 0 TO 7
        IF ABS(mx - gx[i]) <= 5 AND ABS(my - gy[i]) <= 5 THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB griffeZeichnen()
    IF rahmenAn THEN
        DIM rx1 AS INTEGER : rx1 = MIN(startMx, MOUSEX())
        DIM ry1 AS INTEGER : ry1 = MIN(startMy, MOUSEY())
        DIM rx2 AS INTEGER : rx2 = MAX(startMx, MOUSEX())
        DIM ry2 AS INTEGER : ry2 = MAX(startMy, MOUSEY())
        RECT(rx1, ry1, rx2, ry2, &H4FC3F7)
    END IF
    IF auswahl < 0 OR auswahl >= anzahl() THEN RETURN
    ' Mehrere: je ein Rahmen, der Bezug (zuletzt angeklickt) heller.
    IF LEN(gewaehlt) > 1 THEN
        DIM j AS INTEGER
        FOR EACH j IN gewaehlt
            IF j < 0 OR j >= anzahl() THEN CONTINUE
            DIM farbe AS INTEGER : farbe = &H2F7F9F
            IF j = auswahl THEN farbe = &H9FE7FF
            DIM jx AS INTEGER : jx = formX + feldZahl(j, "x")
            DIM jy AS INTEGER : jy = formY + feldZahl(j, "y")
            RECT(jx - 1, jy - 1, jx + feldZahl(j, "w"), jy + feldZahl(j, "h"), farbe)
            IF j = auswahl THEN RECT(jx - 2, jy - 2, jx + feldZahl(j, "w") + 1, jy + feldZahl(j, "h") + 1, farbe)
        NEXT
        RETURN
    END IF
    DIM x AS INTEGER : x = formX + feldZahl(auswahl, "x")
    DIM y AS INTEGER : y = formY + feldZahl(auswahl, "y")
    DIM w AS INTEGER : w = feldZahl(auswahl, "w")
    DIM h AS INTEGER : h = feldZahl(auswahl, "h")
    RECT(x - 1, y - 1, x + w, y + h, &H4FC3F7)
    DIM gx AS INTEGER
    DIM gy AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO 7
        SELECT CASE i
            CASE 0 : gx = x : gy = y
            CASE 1 : gx = x + w \ 2 : gy = y
            CASE 2 : gx = x + w : gy = y
            CASE 3 : gx = x + w : gy = y + h \ 2
            CASE 4 : gx = x + w : gy = y + h
            CASE 5 : gx = x + w \ 2 : gy = y + h
            CASE 6 : gx = x : gy = y + h
            CASE 7 : gx = x : gy = y + h \ 2
        END SELECT
        BOX(gx - 3, gy - 3, gx + 3, gy + 3, &H4FC3F7)
    NEXT
END SUB

' Lage/Groesse waehrend eines Zuges: ins Modell UND live ins Widget.
SUB lageSetzen(x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    lageSetzenVon(auswahl, x, y, w, h)
END SUB

SUB lageSetzenVon(i AS INTEGER, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    JSON_SET_INT(doc, wz$(i, "x"), x) : JSON_SET_INT(doc, wz$(i, "y"), y)
    JSON_SET_INT(doc, wz$(i, "w"), w) : JSON_SET_INT(doc, wz$(i, "h"), h)
    DIM hd AS GUI_WIDGET : hd = GUI_WINDOW_WIDGET(frm, i)
    IF hd >= 0 THEN GUI_SET_BOUNDS(hd, x, y, w, h)
END SUB

' Anordnen: am zuletzt angeklickten ausrichten, auf seine Groesse bringen
' oder gleichmaessig verteilen (erstes und letztes bleiben stehen).
SUB anordnen(was AS STRING)
    IF auswahl < 0 OR LEN(gewaehlt) < 2 THEN
        GUI_SET_TEXT(lblStatus, "Anordnen braucht mindestens zwei gewaehlte Controls (Umschalt+Klick oder ein Rahmen).")
        RETURN
    END IF
    DIM bx AS INTEGER : bx = feldZahl(auswahl, "x")
    DIM by AS INTEGER : by = feldZahl(auswahl, "y")
    DIM bw AS INTEGER : bw = feldZahl(auswahl, "w")
    DIM bh AS INTEGER : bh = feldZahl(auswahl, "h")
    DIM j AS INTEGER
    IF was = "vert_w" OR was = "vert_s" THEN
        IF LEN(gewaehlt) < 3 THEN
            GUI_SET_TEXT(lblStatus, "Verteilen braucht mindestens drei gewaehlte Controls.")
            RETURN
        END IF
        ' Nach Lage sortieren (Auswahl-Sortierung, die Listen sind kurz).
        DIM reihe AS ARRAY OF INTEGER : reihe = gewaehlt
        DIM feld AS STRING : feld = IIF(was = "vert_w", "x", "y")
        DIM mass AS STRING : mass = IIF(was = "vert_w", "w", "h")
        DIM a AS INTEGER
        DIM b AS INTEGER
        FOR a = 0 TO LEN(reihe) - 2
            FOR b = a + 1 TO LEN(reihe) - 1
                IF feldZahl(reihe[b], feld) < feldZahl(reihe[a], feld) THEN
                    DIM t AS INTEGER : t = reihe[a] : reihe[a] = reihe[b] : reihe[b] = t
                END IF
            NEXT
        NEXT
        DIM erste AS INTEGER : erste = reihe[0]
        DIM letzte AS INTEGER : letzte = reihe[LEN(reihe) - 1]
        DIM spanne AS INTEGER : spanne = feldZahl(letzte, feld) + feldZahl(letzte, mass) - feldZahl(erste, feld)
        DIM summe AS INTEGER : summe = 0
        FOR EACH j IN reihe
            summe = summe + feldZahl(j, mass)
        NEXT
        DIM luecke AS FLOAT : luecke = (spanne - summe) / (LEN(reihe) - 1)
        DIM pos AS FLOAT : pos = feldZahl(erste, feld)
        FOR a = 0 TO LEN(reihe) - 1
            j = reihe[a]
            IF a > 0 AND a < LEN(reihe) - 1 THEN
                IF was = "vert_w" THEN
                    lageSetzenVon(j, INT(pos + 0.5), feldZahl(j, "y"), feldZahl(j, "w"), feldZahl(j, "h"))
                ELSE
                    lageSetzenVon(j, feldZahl(j, "x"), INT(pos + 0.5), feldZahl(j, "w"), feldZahl(j, "h"))
                END IF
            END IF
            pos = pos + feldZahl(j, mass) + luecke
        NEXT
    ELSE
        FOR EACH j IN gewaehlt
            IF j = auswahl THEN CONTINUE
            DIM x AS INTEGER : x = feldZahl(j, "x")
            DIM y AS INTEGER : y = feldZahl(j, "y")
            DIM w AS INTEGER : w = feldZahl(j, "w")
            DIM h AS INTEGER : h = feldZahl(j, "h")
            SELECT CASE was
                CASE "links" : x = bx
                CASE "rechts" : x = bx + bw - w
                CASE "oben" : y = by
                CASE "unten" : y = by + bh - h
                CASE "mitte_w" : x = bx + (bw - w) \ 2
                CASE "mitte_s" : y = by + (bh - h) \ 2
                CASE "breite" : w = bw
                CASE "hoehe" : h = bh
                CASE "groesse" : w = bw : h = bh
            END SELECT
            lageSetzenVon(j, x, y, w, h)
        NEXT
    END IF
    merken()
    inspektorFuellen()
    GUI_SET_TEXT(lblStatus, "Angeordnet: " + STR$(LEN(gewaehlt)) + " Controls.")
    protokoll("angeordnet " + was + " " + STR$(LEN(gewaehlt)))
END SUB

SUB mausAufForm()
    DIM mx AS INTEGER : mx = MOUSEX()
    DIM my AS INTEGER : my = MOUSEY()
    DIM fw AS INTEGER : fw = JSON_GET_INT(doc, "w")
    DIM fh AS INTEGER : fh = JSON_GET_INT(doc, "h")
    DIM drin AS BOOLEAN : drin = mx >= formX AND my >= formY AND mx < formX + fw AND my < formY + fh
    IF MOUSE_HIT(LINKS) AND drin THEN
        IF palScharf >= 0 THEN
            controlAnlegen(palScharf, mx - formX, my - formY)
            palScharf = -1
            GUI_LISTBOX_CLEAR_SELECTION(lstPalette)
            RETURN
        END IF
        griff = griffBei(mx, my)
        IF griff >= 0 THEN
            modus = 2
        ELSE
            DIM h AS GUI_WIDGET : h = GUI_HIT_TEST(mx, my)
            DIM i AS INTEGER : i = indexVonHandle(h)
            DIM dazu AS BOOLEAN : dazu = KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT) OR KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)
            IF i >= 0 AND dazu THEN
                ' Umschalt/Strg+Klick: dazu oder weg -- ohne Zug.
                auswahlUmschalten(i)
                inspektorFuellen()
                protokoll("gewaehlt " + STR$(LEN(gewaehlt)))
                modus = 0
                GUI_FOCUS(lstPalette)
                RETURN
            ELSEIF i >= 0 THEN
                ' Ein Klick in eine Mehrfachauswahl behaelt sie (zum
                ' Verschieben aller) und macht das Control zum Bezug.
                IF istGewaehlt(i) THEN auswahl = i ELSE auswahlSetzen(i)
                inspektorFuellen()
                modus = 1
            ELSE
                ' Leere Flaeche: ein Rahmen waehlt, was ganz darin liegt.
                IF NOT dazu THEN auswahlSetzen(-1) : inspektorFuellen()
                modus = 3
                rahmenAn = TRUE
                rahmenDazu = dazu
            END IF
        END IF
        startMx = mx : startMy = my
        bewegt = FALSE
        IF auswahl >= 0 THEN
            startX = feldZahl(auswahl, "x") : startY = feldZahl(auswahl, "y")
            startW = feldZahl(auswahl, "w") : startH = feldZahl(auswahl, "h")
            zugX = [] : zugY = []
            DIM gj AS INTEGER
            FOR EACH gj IN gewaehlt
                ARRAY_PUSH(zugX, feldZahl(gj, "x")) : ARRAY_PUSH(zugY, feldZahl(gj, "y"))
            NEXT
        END IF
        GUI_FOCUS(lstPalette)     ' Tastatur (Entf, Pfeile) zum Designer, nicht in ein Inspektor-Feld
        RETURN
    END IF
    IF modus = 3 THEN
        IF MOUSEBUTTON(LINKS) THEN RETURN
        ' Losgelassen: alles, was ganz im Rahmen liegt.
        rahmenAn = FALSE
        modus = 0
        IF ABS(mx - startMx) < 3 AND ABS(my - startMy) < 3 THEN RETURN
        DIM rx1 AS INTEGER : rx1 = MIN(startMx, mx) - formX
        DIM ry1 AS INTEGER : ry1 = MIN(startMy, my) - formY
        DIM rx2 AS INTEGER : rx2 = MAX(startMx, mx) - formX
        DIM ry2 AS INTEGER : ry2 = MAX(startMy, my) - formY
        IF NOT rahmenDazu THEN gewaehlt = []
        DIM k AS INTEGER
        FOR k = 0 TO anzahl() - 1
            DIM kx AS INTEGER : kx = feldZahl(k, "x")
            DIM ky AS INTEGER : ky = feldZahl(k, "y")
            IF kx >= rx1 AND ky >= ry1 AND kx + feldZahl(k, "w") <= rx2 AND ky + feldZahl(k, "h") <= ry2 AND NOT istGewaehlt(k) THEN
                ' Ein Control auf einer verborgenen Reiterseite liegt nicht
                ' sichtbar im Rahmen -- es bleibt aussen vor.
                DIM kh AS GUI_WIDGET : kh = GUI_WINDOW_WIDGET(frm, k)
                IF kh >= 0 AND GUI_VISIBLE(kh) THEN ARRAY_PUSH(gewaehlt, k)
            END IF
        NEXT
        IF LEN(gewaehlt) > 0 THEN auswahl = gewaehlt[LEN(gewaehlt) - 1] ELSE auswahl = -1
        inspektorFuellen()
        protokoll("rahmen " + STR$(LEN(gewaehlt)))
        RETURN
    END IF
    IF modus > 0 AND MOUSEBUTTON(LINKS) AND auswahl >= 0 THEN
        DIM dx AS INTEGER : dx = mx - startMx
        DIM dy AS INTEGER : dy = my - startMy
        IF dx <> 0 OR dy <> 0 THEN bewegt = TRUE
        IF modus = 1 THEN
            ' Alle gewaehlten gleich weit -- der Bezug rastet ein, die
            ' anderen behalten ihren Abstand zu ihm.
            DIM rdx AS INTEGER : rdx = amRaster(startX + dx) - startX
            DIM rdy AS INTEGER : rdy = amRaster(startY + dy) - startY
            DIM z AS INTEGER
            FOR z = 0 TO LEN(gewaehlt) - 1
                IF z < LEN(zugX) THEN
                    DIM gz AS INTEGER : gz = gewaehlt[z]
                    lageSetzenVon(gz, zugX[z] + rdx, zugY[z] + rdy, feldZahl(gz, "w"), feldZahl(gz, "h"))
                END IF
            NEXT
        ELSE
            DIM x AS INTEGER : x = startX
            DIM y AS INTEGER : y = startY
            DIM w AS INTEGER : w = startW
            DIM hh AS INTEGER : hh = startH
            IF griff = 0 OR griff = 6 OR griff = 7 THEN x = amRaster(startX + dx) : w = startX + startW - x
            IF griff = 2 OR griff = 3 OR griff = 4 THEN w = amRaster(startW + dx)
            IF griff = 0 OR griff = 1 OR griff = 2 THEN y = amRaster(startY + dy) : hh = startY + startH - y
            IF griff = 4 OR griff = 5 OR griff = 6 THEN hh = amRaster(startH + dy)
            IF w < RASTER THEN w = RASTER
            IF hh < RASTER THEN hh = RASTER
            lageSetzen(x, y, w, hh)
        END IF
        RETURN
    END IF
    IF modus > 0 AND NOT MOUSEBUTTON(LINKS) THEN
        IF bewegt THEN
            merken()
            inspektorFuellen()
            protokoll("bewegt " + STR$(auswahl) + " " + STR$(feldZahl(auswahl, "x")) + " " + STR$(feldZahl(auswahl, "y")) + " " + STR$(feldZahl(auswahl, "w")) + " " + STR$(feldZahl(auswahl, "h")))
            IF LEN(gewaehlt) > 1 THEN protokoll("bewegt alle " + STR$(LEN(gewaehlt)))
        END IF
        modus = 0
    END IF
END SUB

SUB schieben(dx AS INTEGER, dy AS INTEGER)
    IF auswahl < 0 THEN RETURN
    DIM j AS INTEGER
    FOR EACH j IN gewaehlt
        lageSetzenVon(j, feldZahl(j, "x") + dx, feldZahl(j, "y") + dy, feldZahl(j, "w"), feldZahl(j, "h"))
    NEXT
    merken()
    inspektorFuellen()
END SUB

' --- Start ------------------------------------------------------------------
IF ARGC() >= 1 THEN
    DIM startDatei AS STRING : startDatei = ARG$(0)
    IF LEFT$(startDatei, 1) <> "/" AND LEFT$(startDatei, 1) <> "\" AND MID$(startDatei, 1, 1) <> ":" THEN
        DIM start AS STRING : start = GETENV$("DHRT_START_DIR")
        IF start <> "" THEN startDatei = PATHJOIN(start, startDatei)
    END IF
    formularLaden(startDatei)
ELSE
    neuesFormular()
END IF
GUI_FOCUS(lstPalette)      ' Kuerzel gelten im Fenster mit Fokus -- vor dem ersten Klick gaebe es keins
protokoll("bereit")

DIM warBreite AS INTEGER : warBreite = SCREENWIDTH()
DIM warHoehe AS INTEGER : warHoehe = SCREENHEIGHT()
DIM beenden AS BOOLEAN : beenden = FALSE
DIM dlgSchliessen AS GUI_WINDOW : dlgSchliessen = 0

' [Beenden] und das Kreuz fragen dasselbe -- bis 2026-09-19 beendete das
' Kreuz ohne Rueckfrage. Ein anderer offener Kasten geht vor.
SUB endeAnfragen()
    IF dlgSchliessen <> 0 OR GUI_MODAL() THEN RETURN
    IF geaendert THEN dlgSchliessen = GUI_DIALOG("Beenden", "Das Formular ist nicht gesichert.", "Sichern|Verwerfen|Abbrechen") ELSE beenden = TRUE
END SUB

' [Neu] und [Oeffnen] ersetzen das Formular -- mit ungesicherten Aenderungen
' fragen sie vorher (bis 2026-09-23 warfen sie sie wortlos weg, wie es das
' Notenblatt bis 2026-09-21 tat). Der Datei-Dialog kommt erst nach der
' Antwort; wer abbricht, sieht keinen.
DIM dlgErsetzen AS GUI_WINDOW : dlgErsetzen = 0
DIM ersetzenMit AS STRING : ersetzenMit = ""

SUB ersetzenAusfuehren(was AS STRING)
    IF was = "neu" THEN
        neuesFormular()
    ELSE
        DIM p AS STRING : p = FILE_OPEN_DIALOG("Formular oeffnen", "dhform")
        IF p <> "" THEN formularLaden(p)
    END IF
END SUB

SUB ersetzenAnfragen(was AS STRING)
    IF dlgErsetzen <> 0 OR dlgSchliessen <> 0 OR GUI_MODAL() THEN RETURN
    IF NOT geaendert THEN
        ersetzenAusfuehren(was)
        RETURN
    END IF
    ersetzenMit = was
    dlgErsetzen = GUI_DIALOG(IIF(was = "neu", "Neues Formular", "Oeffnen"), "Das Formular ist nicht gesichert.", "Sichern|Verwerfen|Abbrechen")
    protokoll("frage " + was)
END SUB

WHILE NOT beenden
    ' Das Kreuz (und Alt+F4) fragt wie [Beenden] nach, wenn etwas nicht
    ' gesichert ist. QUITREQUESTED ohne das Kreuz ist das Bildlimit eines
    ' Testlaufs -- dort endet das Programm hart wie bisher.
    IF WINDOW_CLOSE_REQUESTED() THEN
        endeAnfragen()
    ELSEIF QUITREQUESTED() THEN
        BREAK
    END IF
    GUI_UPDATE()
    IF SCREENWIDTH() <> warBreite OR SCREENHEIGHT() <> warHoehe THEN
        warBreite = SCREENWIDTH() : warHoehe = SCREENHEIGHT()
        GUI_WINDOW_SET_BOUNDS(winPal, 0, 0, PAL_B, warHoehe)
        GUI_WINDOW_SET_BOUNDS(winInsp, warBreite - INSP_B, 0, INSP_B, warHoehe)
    END IF

    ' Menue
    IF GUI_CLICKED(miNeu) THEN ersetzenAnfragen("neu")
    IF GUI_CLICKED(miOeffnen) THEN ersetzenAnfragen("oeffnen")
    IF dlgErsetzen <> 0 THEN
        DIM ae AS INTEGER : ae = GUI_ANSWER(dlgErsetzen)
        IF ae = 1 THEN
            dlgErsetzen = 0
            IF sichern(FALSE) THEN ersetzenAusfuehren(ersetzenMit)
        ELSEIF ae = 2 THEN
            dlgErsetzen = 0 : ersetzenAusfuehren(ersetzenMit)
        ELSEIF ae = 3 THEN
            dlgErsetzen = 0 : protokoll("ersetzen abgebrochen")
        END IF
    END IF
    IF GUI_CLICKED(miSichern) THEN sichern(FALSE)
    IF GUI_CLICKED(miSichernAls) THEN sichern(TRUE)
    IF GUI_CLICKED(miLauf) THEN ausfuehren()
    IF GUI_CLICKED(miDhCode) THEN dhCodeSchreiben()
    IF GUI_CLICKED(miBeenden) THEN endeAnfragen()
    IF GUI_CLICKED(miRueck) THEN rueckgaengig()
    IF GUI_CLICKED(miWieder) THEN wiederholen()
    IF GUI_CLICKED(miDoppel) THEN controlVerdoppeln()
    IF GUI_CLICKED(miLoeschen) THEN controlLoeschen()
    IF GUI_CLICKED(miVorn) THEN controlOrdnen(TRUE)
    IF GUI_CLICKED(miHinten) THEN controlOrdnen(FALSE)
    IF GUI_CLICKED(miAlle) THEN allesWaehlen()
    IF GUI_CLICKED(miLinks) THEN anordnen("links")
    IF GUI_CLICKED(miRechts) THEN anordnen("rechts")
    IF GUI_CLICKED(miOben) THEN anordnen("oben")
    IF GUI_CLICKED(miUnten) THEN anordnen("unten")
    IF GUI_CLICKED(miMitteW) THEN anordnen("mitte_w")
    IF GUI_CLICKED(miMitteS) THEN anordnen("mitte_s")
    IF GUI_CLICKED(miGleichB) THEN anordnen("breite")
    IF GUI_CLICKED(miGleichH) THEN anordnen("hoehe")
    IF GUI_CLICKED(miGleichG) THEN anordnen("groesse")
    IF GUI_CLICKED(miVertW) THEN anordnen("vert_w")
    IF GUI_CLICKED(miVertS) THEN anordnen("vert_s")
    IF dlgSchliessen <> 0 THEN
        DIM a AS INTEGER : a = GUI_ANSWER(dlgSchliessen)
        IF a = 1 THEN
            dlgSchliessen = 0
            IF sichern(FALSE) THEN beenden = TRUE
        ELSEIF a = 2 THEN
            dlgSchliessen = 0 : beenden = TRUE
        ELSEIF a = 3 THEN
            dlgSchliessen = 0
        END IF
    END IF

    ' Palette: eine (neue) Auswahl macht die Art scharf, der naechste Klick auf
    ' die Form legt ab. Eine Liste meldet kein GUI_CLICKED -- die Auswahl ist
    ' das Ereignis.
    IF GUI_LISTBOX_SELECTED(lstPalette) <> palScharf AND GUI_LISTBOX_SELECTED(lstPalette) >= 0 THEN
        palScharf = GUI_LISTBOX_SELECTED(lstPalette)
        GUI_SET_TEXT(lblStatus, palName[palScharf] + ": jetzt auf die Form klicken.")
        protokoll("palette " + palArt[palScharf])
    END IF

    ' Inspektor: Enter in einem Feld oder der Knopf uebernimmt.
    DIM uebernehmen AS BOOLEAN : uebernehmen = GUI_CLICKED(btnUebernehmen)
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(inspFelder) - 1
        IF GUI_ENTERED(inspFelder[fi]) THEN uebernehmen = TRUE
    NEXT
    FOR fi = 0 TO LEN(artFelder) - 1
        IF GUI_ENTERED(artFelder[fi]) THEN uebernehmen = TRUE
    NEXT
    IF GUI_ENTERED(fTitel) OR GUI_ENTERED(fFormB) OR GUI_ENTERED(fFormH) THEN uebernehmen = TRUE
    IF uebernehmen AND NOT inspStumm THEN inspektorUebernehmen()

    ' Tastatur, solange kein Eingabefeld den Fokus hat
    DIM fokus AS GUI_WIDGET : fokus = GUI_FOCUSED()
    DIM imFeld AS BOOLEAN : imFeld = FALSE
    IF fokus >= 0 THEN
        DIM art AS STRING : art = GUI_KIND(fokus)
        imFeld = art = "textinput" OR art = "textarea" OR art = "spinner"
    END IF
    IF NOT imFeld THEN
        IF KEYHIT(KEY_DELETE) THEN controlLoeschen()
        DIM schritt AS INTEGER : schritt = RASTER
        IF KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT) THEN schritt = 1
        IF KEYHIT(KEY_LEFT) THEN schieben(-schritt, 0)
        IF KEYHIT(KEY_RIGHT) THEN schieben(schritt, 0)
        IF KEYHIT(KEY_UP) THEN schieben(0, -schritt)
        IF KEYHIT(KEY_DOWN) THEN schieben(0, schritt)
        IF KEYHIT(KEY_ESCAPE) THEN palScharf = -1 : auswahlSetzen(-1) : inspektorFuellen()
        IF (KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)) AND KEYHIT(KEY_A) THEN allesWaehlen()
    END IF

    mausAufForm()

    IF laufProzess >= 0 THEN
        IF NOT PROCESS_RUNNING(laufProzess) THEN
            GUI_SET_TEXT(lblStatus, "Formular beendet mit Code " + STR$(PROCESS_CODE(laufProzess)))
            PROCESS_CLOSE(laufProzess)
            laufProzess = -1
        END IF
    END IF

    CLS(&H0B1119)
    ' Rahmen und Titel der Form -- die Form selbst ist randlos
    DIM fw2 AS INTEGER : fw2 = JSON_GET_INT(doc, "w")
    DIM fh2 AS INTEGER : fh2 = JSON_GET_INT(doc, "h")
    BOX(formX - 1, formY - 28, formX + fw2, formY - 1, &H1F2A38)
    TEXT(formX + 8, formY - 22, JSON_GET_STRING(doc, "title") + "   " + STR$(fw2) + " x " + STR$(fh2), &HD8E4F0)
    RECT(formX - 1, formY - 28, formX + fw2, formY + fh2, &H3A4A5C)
    GUI_DRAW()
    griffeZeichnen()
    FLIP()
WEND

IF laufProzess >= 0 THEN PROCESS_KILL(laufProzess)
protokoll("ende")
