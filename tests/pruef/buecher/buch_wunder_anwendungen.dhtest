=== mediathek kapitel 3: aufnehmen haengt an daten und tabelle an
' Der neue Eintrag steht im Feld UND als gewaehlte letzte Zeile in der
' Tabelle; das Formular ist danach leer.
prBild = prBild + 1
IF prBild = 2 THEN
    aufnehmen()
    DIM k AS INTEGER : k = LEN(mediathek) - 1
    PRINT LEN(mediathek); " "; GUI_TABLE_ROW_COUNT(tabelle); " "; GUI_TABLE_SELECTED(tabelle)
    PRINT mediathek[k].titel; " | "; GUI_TABLE_GET_CELL(tabelle, k, 0); " | "; GUI_TABLE_GET_CELL(tabelle, k, 3)
    PRINT GUI_TEXT(status); " | leer: "; GUI_TEXT(urheber) = ""
    EXIT(0)
END IF
