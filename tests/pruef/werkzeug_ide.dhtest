=== dieselbe datei in anderer schreibweise oeffnet keinen zweiten reiter
' Stresstest 2026-10-01: der Debugger meldet eine importierte Datei mit
' ihrem langen Namen, das Projekt kennt den kurzen (HANSGA~1). Am Text
' verglichen stand die Datei danach zweimal als Reiter da, und das Projekt
' zog in den Ordner der importierten Datei um. Hier traegt der zweite Weg
' ein "..", und der Projektordner ein "lib/.." -- beides dieselben Orte.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 30 THEN
    DIM prWurzel AS STRING : prWurzel = projektOrdner
    dateiOeffnen(PATHJOIN(prWurzel, "lib/mathe.dh"))
    protokoll("pr reiter " + STR$(tabAnzahl))
    dateiOeffnen(PATHJOIN(prWurzel, "lib/../lib/mathe.dh"))
    protokoll("pr reiter " + STR$(tabAnzahl))
    projektOrdner = PATHJOIN(prWurzel, "lib/..")
    dateiOeffnen(PATHJOIN(prWurzel, "lib/mathe.dh"))
    protokoll("pr projekt bleibt " + STR$(projektOrdner = PATHJOIN(prWurzel, "lib/..")))
    protokoll("pr reiter " + STR$(tabAnzahl))
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
IMPORT "lib/mathe.dh"
PRINT quadrat(3)
--- datei lib/mathe.dh
FUNCTION quadrat(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr reiter 2
pr reiter 2
pr projekt bleibt TRUE
pr reiter 2

=== sichern, das die platte ablehnt, beendet die ide nicht
' Stresstest 2026-10-02: WRITEALL beim Sichern lief ohne TRY. Eine Datei,
' die die Platte nicht schreiben laesst (schreibgeschuetzt, Ordner weg,
' hier: ein ORDNER an ihrer Stelle), beendete die ganze IDE -- samt der
' ungesicherten Arbeit in allen Reitern. Jetzt bleibt der Reiter
' ungesichert markiert und die Statuszeile sagt es.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 30 THEN
    GUI_TEXTAREA_INSERT(tabFelder[0], "' neu" + CHR$(10))
    DELETEFILE(tabPfade[0])
    MKDIR(tabPfade[0])
    protokoll("pr gesichert " + STR$(sichern(0, FALSE)))
    protokoll("pr ungesichert " + STR$(GUI_TEXT(tabFelder[0]) <> tabGesichert[0]))
    protokoll("pr status " + LEFT$(GUI_STATUSBAR_TEXT$(lblStatus, 0), 19))
END IF
IF prBild = 50 THEN
    protokoll("pr laeuft weiter")
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
PRINT 1
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr gesichert FALSE
pr ungesichert TRUE
pr status Sichern ging nicht:
pr laeuft weiter

=== eine datei in cp1252 laesst sich oeffnen und durchsuchen
' Stresstest 2026-10-02: READLINES verlangt UTF-8, und eine Datei aus
' einem alten Windows-Programm (cp1252) beendete die IDE -- beim Oeffnen,
' bei der Suche im Projekt und schon beim Zaehlen der Aufrufe, das jede
' Projektdatei liest. Jetzt wird sie als cp1252 gelesen, und die
' Statuszeile sagt, dass das Sichern UTF-8 schreibt.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 30 THEN
    dateiOeffnen(PATHJOIN(projektOrdner, "alt.dh"))
    protokoll("pr reiter " + STR$(tabAnzahl) + " " + SPLIT$(GUI_TEXT(tabFelder[aktiverTab]), CHR$(10))[0])
    protokoll("pr status " + STR$(INSTR(GUI_STATUSBAR_TEXT$(lblStatus, 0), "cp1252") >= 0))
    projektSuchen("Grüße", "")
END IF
IF prBild = 80 THEN
    protokoll("pr laeuft weiter")
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
SUB gruss()
    PRINT "hallo"
END SUB
--- datei alt.dh base64
JyBHcvzfZSBhdXMgY3AxMjUyCmdydXNzKCkK
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 6) = "suche " THEN PRINT L[i]
NEXT
--- erwartet
pr reiter 2 ' Grüße aus cp1252
pr status TRUE
suche 1
pr laeuft weiter

