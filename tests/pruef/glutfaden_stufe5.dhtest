=== bild: zellmitten wie pysticky
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Die Beilagen hat PyStickys ImageExporter geschrieben (Zelle 20, ohne Raster
' und Symbole). Verglichen wird die Mitte jeder Zelle. Beim Probemuster liegen
' zwei Mitten auf einer Kante (Diagonale eines Halbstichs, Ende eines
' Rueckstichs mit Schatten), die Qt glaettet -- sonst ist alles gleich.
FUNCTION mitten(m AS kern.Muster, unser AS STRING, ihr AS STRING) AS STRING
    DIM a AS IMAGE : a = LOADIMAGE(unser)
    DIM b AS IMAGE : b = LOADIMAGE(ihr)
    DIM x AS INTEGER, y AS INTEGER, n AS INTEGER
    FOR y = 0 TO m.hoehe - 1
        FOR x = 0 TO m.breite - 1
            IF GETPIXEL(a, x * 20 + 10, y * 20 + 10) <> GETPIXEL(b, x * 20 + 10, y * 20 + 10) THEN n = n + 1
        NEXT
    NEXT
    RETURN STR$(IMAGE_WIDTH(a)) + "x" + STR$(IMAGE_HEIGHT(a)) + " gegen " + STR$(IMAGE_WIDTH(b)) + "x" + STR$(IMAGE_HEIGHT(b)) + ", abweichend " + STR$(n) + " von " + STR$(m.breite * m.hoehe)
END FUNCTION
DIM d AS kern.Muster : d = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")
kern.bildExportieren(d, "demo.png", 20, FALSE, FALSE)
PRINT "demo: "; mitten(d, "demo.png", "demo_py_nackt.png")
DIM p AS kern.Muster : p = kern.pxsLaden("probe.pxs")
kern.bildExportieren(p, "probe.png", 20, FALSE, FALSE)
PRINT "probe: "; mitten(p, "probe.png", "probe_py_nackt.png")
--- argumente
