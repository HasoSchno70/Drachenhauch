' Marken im Code-Feld (GUI_TEXTAREA_MARKS) wandern beim Bearbeiten mit
' ihrer Zeile, und GUI_TEXTAREA_MARKS_GET sagt, wo sie jetzt stehen. Bis
' 2026-09-27 hingen sie an der NUMMER: eine eingefuegte Zeile darueber
' legte einen Haltepunkt still auf die Zeile davor.
' Format: docs/werkzeuge.md.

=== eine zeile darueber schiebt die marken nach unten
IMPORT "gui"
FUNCTION liste$(a AS ARRAY OF INTEGER) AS STRING
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(a) - 1
        IF i > 0 THEN s = s + ","
        s = s + STR$(a[i])
    NEXT
    RETURN s
END FUNCTION
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 380, 250, "")
GUI_SET_TEXT(ta, "a" + CHR$(10) + "b" + CHR$(10) + "c" + CHR$(10) + "d")
GUI_TEXTAREA_MARKS(ta, [2, 4], [RGB(255, 0, 0), RGB(0, 0, 255)])
PRINT liste$(GUI_TEXTAREA_MARKS_GET(ta))
GUI_UPDATE()
' Am Anfang von Zeile 1 eine neue Zeile einfuegen.
GUI_TEXTAREA_SELECT(ta, 1, 1, 1, 1)
GUI_TEXTAREA_INSERT(ta, "neu" + CHR$(10))
PRINT liste$(GUI_TEXTAREA_MARKS_GET(ta))
' In Zeile 3 (das b) getippt: sie bleibt, wo sie ist.
GUI_TEXTAREA_SELECT(ta, 3, 2, 3, 2)
GUI_TEXTAREA_INSERT(ta, "xyz")
PRINT liste$(GUI_TEXTAREA_MARKS_GET(ta))
' Zwei Zeilen am Anfang weg: beide wandern hoch.
GUI_TEXTAREA_SELECT(ta, 1, 1, 3, 1)
GUI_TEXTAREA_INSERT(ta, "")
PRINT liste$(GUI_TEXTAREA_MARKS_GET(ta))
--- erwartet
2,4
3,5
3,5
1,3

=== auch strg+z verschiebt sie zurueck
' Strg+Z geht einen anderen Weg als INSERT -- die Marken folgen trotzdem,
' weil sie am TEXT abgeglichen werden, nicht an jedem Aenderungsweg.
IMPORT "gui"
FUNCTION liste$(a AS ARRAY OF INTEGER) AS STRING
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(a) - 1
        IF i > 0 THEN s = s + ","
        s = s + STR$(a[i])
    NEXT
    RETURN s
END FUNCTION
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 380, 250, "")
GUI_SET_TEXT(ta, "a" + CHR$(10) + "b" + CHR$(10) + "c")
GUI_TEXTAREA_MARKS(ta, [3], [RGB(255, 0, 0)])
GUI_FOCUS(ta)
DIM f AS INTEGER
FOR f = 1 TO 50
    GUI_UPDATE()
    GUI_DRAW()
    IF f = 5 THEN
        GUI_TEXTAREA_SELECT(ta, 1, 1, 1, 1)
        GUI_TEXTAREA_INSERT(ta, "x" + CHR$(10) + "y" + CHR$(10))
    END IF
    IF f = 10 THEN PRINT liste$(GUI_TEXTAREA_MARKS_GET(ta))
    IF f = 45 THEN PRINT liste$(GUI_TEXTAREA_MARKS_GET(ta)); " "; GUI_TEXT(ta) = "a" + CHR$(10) + "b" + CHR$(10) + "c"
    FLIP()
NEXT
--- datei ev.txt
# Test-Aufnahme
c 5
e 0 7 0 0 0 0 // Event: Anker
e 25 2 341 0 0 0 // Event: test
e 25 2 90 0 0 0 // Event: test
e 26 1 90 0 0 0 // Event: test
e 26 1 341 0 0 0 // Event: test

--- erwartet
5
3 TRUE

=== neu gesetzt gilt der neue text
IMPORT "gui"
FUNCTION liste$(a AS ARRAY OF INTEGER) AS STRING
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(a) - 1
        IF i > 0 THEN s = s + ","
        s = s + STR$(a[i])
    NEXT
    RETURN s
END FUNCTION
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 380, 250, "")
GUI_SET_TEXT(ta, "a" + CHR$(10) + "b")
GUI_TEXTAREA_MARKS(ta, [2], [RGB(255, 0, 0)])
' Ein ganz anderer Text: die Marke bleibt an ihrer Nummer, wie immer bei
' GUI_SET_TEXT -- das Programm setzt sie neu.
GUI_SET_TEXT(ta, "x" + CHR$(10) + "y" + CHR$(10) + "z")
GUI_TEXTAREA_MARKS(ta, [2], [RGB(255, 0, 0)])
PRINT liste$(GUI_TEXTAREA_MARKS_GET(ta))
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w, "K", 10, 270, 60, 24)
TRY
    PRINT GUI_TEXTAREA_MARKS_GET(k)
CATCH e
    PRINT e
END TRY
--- erwartet
2
GUI_TEXTAREA_MARKS_GET: das Widget ist kein GUI_TEXTAREA

=== ein umbau ueber den ganzen text laesst die marke auf ihrer zeile
' Stresstest 2026-10-01: ein Umbau (Umbenennen im Projekt) markiert alles
' und setzt den neuen Text ein. Geaendert sind Zeile 2 und 4, und alles
' dazwischen galt als EINE Aenderung -- der Haltepunkt in Zeile 4 fiel auf
' Zeile 2. Gleich viele Zeilen vorher und nachher: er bleibt.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 380, 250, "")
DIM nl AS STRING : nl = CHR$(10)
GUI_SET_TEXT(ta, "kopf" + nl + "f quadrat" + nl + "x" + nl + "y = quadrat(1)" + nl + "fuss")
GUI_TEXTAREA_MARKS(ta, [3, 4], [RGB(255, 0, 0), RGB(0, 0, 255)])
GUI_UPDATE()
GUI_TEXTAREA_SELECT(ta, 1, 1, 1000000, 1000000)
GUI_TEXTAREA_INSERT(ta, "kopf" + nl + "f hoch2" + nl + "x" + nl + "y = hoch2(1)" + nl + "fuss")
DIM m AS ARRAY OF INTEGER : m = GUI_TEXTAREA_MARKS_GET(ta)
PRINT m[0]; " "; m[1]
--- umgebung
DHRT_FRAMES=2
--- erwartet
3 4
