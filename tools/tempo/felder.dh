' Tempo: ein Feld fuellen, lesen und sortieren (1 Mio. Plaetze).
DIM t0 AS FLOAT : t0 = TIMER()
DIM a[1000000] AS INTEGER
DIM i AS INTEGER
FOR i = 0 TO 999999
    a[i] = (i * 7919) MOD 1000003
NEXT
DIM s AS INTEGER : s = 0
FOR i = 0 TO 999999
    s = s + a[i]
NEXT
SORT(a)
PRINT "ZEIT "; (TIMER() - t0) * 1000.0
IF a[0] <> 0 OR s <= 0 THEN EXIT(1)
