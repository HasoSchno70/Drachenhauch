IMPORT "{sammlung}/_hilfen/mime.dh"

--- erwartet
multipart/alternative
text/plain Hallo
text/html <b>Hallo</b>

=== anhang kommt unveraendert an
IMPORT "smtp"
IMPORT "mime_leser.dh"
' Bytes schreiben, nicht Text: sonst prueft der Fall am Ende die Zeilenenden.
DIM roh AS BUFFER : roh = BUFFER_FROM_STRING("a;b" + CHR$(10) + "1;2" + CHR$(10))
WRITEALL_BYTES("zahlen.csv", roh)
DIM m AS SMTP
m = SMTP_NEW()
SMTP_FROM(m, "ich@beispiel.de")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Test")
SMTP_TEXT(m, "Hallo")
SMTP_ATTACH(m, "zahlen.csv")
DIM n AS STRING : n = SMTP_MESSAGE$(m)
PRINT mimeArt$(n)
DIM t AS ARRAY OF STRING : t = mimeTeile(n)
DIM anzahl AS INTEGER : anzahl = 0
DIM i AS INTEGER
FOR i = 0 TO LEN(t) - 1
    IF mimeDateiname$(t[i]) <> "" THEN
        anzahl = anzahl + 1
        PRINT mimeDateiname$(t[i])
        PRINT BUFFER_TO_BASE64$(mimeInhalt(t[i])) = BUFFER_TO_BASE64$(roh)
    END IF
NEXT
PRINT anzahl
--- datei mime_leser.dh
IMPORT "{sammlung}/_hilfen/mime.dh"

--- erwartet
multipart/mixed
zahlen.csv
TRUE
1

=== anhang bekommt seine art aus der endung
IMPORT "smtp"
IMPORT "mime_leser.dh"
WRITEALL_BYTES("bericht.pdf", BUFFER_FROM_STRING("%PDF-1.4 nicht echt"))
DIM m AS SMTP
m = SMTP_NEW()
SMTP_FROM(m, "ich@beispiel.de")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Test")
SMTP_TEXT(m, "Hallo")
SMTP_ATTACH(m, "bericht.pdf")
DIM t AS ARRAY OF STRING : t = mimeTeile(SMTP_MESSAGE$(m))
DIM i AS INTEGER
FOR i = 0 TO LEN(t) - 1
    IF mimeDateiname$(t[i]) <> "" THEN PRINT mimeDateiname$(t[i]); " "; mimeArt$(t[i])
NEXT
