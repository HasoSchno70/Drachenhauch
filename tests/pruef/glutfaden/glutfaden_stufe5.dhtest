--- erwartet
195: [<p class='cover-footer-text'>Erstellt mit PySticky &middot; 16.10.2026 &middot; (c) 2026	Tab</p>] gegen [<p class='cover-footer-text'>Erstellt mit Glutfaden &middot; 16.10.2026 &middot; (c) 2026	Tab</p>]

=== html: vier seiten mit ueberlappung und anchor
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
DIM m AS kern.Muster : m = kern.pxsLaden("breit.pxs")
DIM o AS kern.HtmlOptionen : o = NEW kern.HtmlOptionen()
o.datum = "16.10.2026" : o.paletten = pal
o.ueberlappung = 3 : o.kreuz = ["Anchor"]
kern.htmlExportieren(m, "breit", o)
PRINT geAbweichungen$(geLies$("breit.html.ref"), geLies$("breit.html"))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"

