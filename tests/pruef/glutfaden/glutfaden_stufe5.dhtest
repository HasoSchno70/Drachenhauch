=== pdf: letter, neun seiten mit ueberlappung, entsprechung dmc
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
DIM m AS kern.Muster : m = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")
DIM o AS kern.PdfOptionen : o = gePdfOptionen(pal, "Letter", 15, 2, "DMC", "", FALSE, "")
o.titel = "demo_ueb"
DIM ab AS ARRAY OF STRING : ab = kern.pdfExportieren(m, "aus.pdf", o)
PRINT geAbweichungen$(geLies$("demo_ueb.txt"), JOIN$(ab, CHR$(10)) + CHR$(10))
PRINT "datei "; FILEEXISTS("aus.pdf"); " seiten "; ab[LEN(ab) - 1]
