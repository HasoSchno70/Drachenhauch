        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
PRINT "karte an " ; hat("karte an")
IMPORT "json"
DIM kh AS JSON_HANDLE : kh = JSON_LOAD("_programm/ide.json")
PRINT "karte gemerkt " ; JSON_GET_BOOL(kh, "karte")
--- erwartet
karte an TRUE
karte gemerkt TRUE

