--- erwartet
gleiche farbe: 0 | ausserhalb: 0 | schritte 0
getauscht: 130 | schritte 1 Farben tauschen
rueckgaengig wie vorher: TRUE
wiederholt: 118 114
konvertiert: 9 | Anchor 12 | symbol ■ | perle TRUE | ausgelassen TRUE | Palette konvertieren
rueckgaengig wie vorher: TRUE
ein ziel fehlt: 0 | DMC
leere palette: -1 999.0

=== probe: vorrat, einkaufsliste, palette, tauschen, rahmen
IMPORT "helfer.dh"
' --probe-stufe9 mit dem Probemuster und einem eigenen Einstellungsordner
' (APPDATA/HOME): Vorrat in drei Reitern (setzen, 0 nimmt heraus, Suche,
' Leere entfernen, Projekte samt einem, das fehlt; sichern), die
' Einkaufsliste der Statistik bei 20 und 50 %, Palette Anchor konvertieren
' und zuruecknehmen, Farben tauschen und zuruecknehmen, Rahmen. Fotos.
MKDIR("app/Glutfaden")
WRITEALL("app/Glutfaden/garnvorrat.json", geLies$("vorrat.json"))
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe9", "--foto", "d", "planprobe.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["vorrat", "vorrat_alle", "vorrat_projekte", "statistik_einkauf", "palette", "tauschen", "rahmen"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    PRINT "gesichert: "; geLies$("app/Glutfaden/garnvorrat.json")
END IF
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_planung.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
