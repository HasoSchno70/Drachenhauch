=== die willkommensseite laeuft nicht in die leisten
' Mit Uebersichtskarte in der Einstellung: ohne Reiter steht sie nicht da,
' der Satz unter "Zuletzt geoeffnet" endet ueber den Leisten oder fehlt, und
' der Kopf der Probleme-Leiste wiederholt den Reiter nicht.
layout()
GUI_UPDATE()
DIM prCx AS INTEGER
DIM prCy AS INTEGER
DIM prCw AS INTEGER
DIM prCh AS INTEGER
(prCx, prCy, prCw, prCh) = GUI_DOCK_CENTER(win)
PRINT "karte "; GUI_VISIBLE(karte)
PRINT "satz passt "; NOT GUI_VISIBLE(lblWkKuerzel) OR GUI_GET_Y(lblWkKuerzel) + GUI_GET_H(lblWkKuerzel) <= prCy + prCh
PRINT "probleme |"; GUI_TEXT(lblProbleme); "|"
PRINT "zuletzt "; zuletztText$("C:/Spiele/neu/held.dh")
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- datei _programm/ide.json
{"karte": true}
--- umgebung
DHRT_FRAMES=300
DH_IDE_WURZEL={fall}
DH_IDE_KONFIG=ide.json
--- erwartet
karte FALSE
satz passt TRUE
probleme ||
zuletzt held.dh   (C:\Spiele\neu)

=== ein eigener schnipsel ersetzt nur die liste, nicht den vorrat
' schnipselLaden legt Kopien an: ersetzt ein eigener Schnipsel den
' eingebauten "for", muss der eingebaute zurueckkommen, sobald die eigene
' Datei weg ist (mit geteilten Objekten waere er dauerhaft ueberschrieben).
WRITEALL(schnipselPfad$(), "=== Meine Schleife | for" + NL + "FOR k = 1 TO 3" + NL + "NEXT" + NL)
schnipselLaden()
DIM prF AS INTEGER : prF = schnipselNr("for")
PRINT "eigen: "; schnipselListe[prF].herkunft; " | "; LEFT$(schnipselListe[prF].text, 14)
DELETEFILE(schnipselPfad$())
schnipselLaden()
prF = schnipselNr("for")
PRINT "wieder: |"; schnipselListe[prF].herkunft; "| "; LEFT$(schnipselListe[prF].text, 16)
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- umgebung
DHRT_FRAMES=300
DH_IDE_WURZEL={fall}
DH_IDE_KONFIG=ide.json
--- erwartet
eigen: eigen, ersetzt | FOR k = 1 TO 3
wieder: || DIM i AS INTEGER

=== ein befehl eines plugins und danach die tastenbelegung
' Die Vorgabe der Kuerzel lag bis 2026-10-30 in einem eigenen Feld, das nur
' beim Start gefuellt wurde. Ein Plugin, das danach einen Befehl anmeldet,
' machte die Befehlsliste laenger als die Vorgaben -- tastenAnwenden (etwa
' nach dem Aendern eines Kuerzels) brach dann mit "Index ausserhalb" ab.
paletteEintrag("Plugin-Befehl", "plugin:probe:eins", "Strg+Alt+9")
tastenAnwenden()
DIM prB AS INTEGER : prB = befehlNr("plugin:probe:eins")
PRINT "angewendet "; befehle[prB].kuerzel; " vorgabe "; befehle[prB].vorgabe
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- umgebung
DHRT_FRAMES=300
DH_IDE_WURZEL={fall}
DH_IDE_KONFIG=ide.json
--- erwartet
angewendet Strg+Alt+9 vorgabe Strg+Alt+9
