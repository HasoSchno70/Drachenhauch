CLASS Hauptfenster EXTENDS Hauptfenster_Basis
    SUB knopf1_Klick()
        PRINT "knopf "; GUI_GET_X(Self.knopf1); " "; GUI_GET_Y(Self.knopf1); " "; GUI_GET_W(Self.knopf1)
        PRINT "anzeige "; GUI_GET_X(Self.anzeige); " "; GUI_GET_Y(Self.anzeige)
    END SUB
END CLASS
--- datei proj/App.dh
CLASS App EXTENDS StudioApp
END CLASS
--- erwartet
geprueft TRUE
erzeugt TRUE
kinder in der basis TRUE
lauf knopf 40 40 200
lauf anzeige 40 76
code 0

=== zwei gewaehlte controls kommen zusammen in die spalte
' knopfX und knopfY frei gewaehlt (Umschalt+Klick), knopfY auf die Spalte
' gezogen: beide kommen hinein, von oben nach unten -- knopfX steht hoeher.
IMPORT "laeufer.dh"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 8, CWD$() + "/f.dhform")
DIM xx AS INTEGER
DIM xy AS INTEGER
DIM yx AS INTEGER
DIM yy AS INTEGER
DIM px AS INTEGER
DIM py AS INTEGER
(xx, xy) = slLage(m, "control knopfX")
(yx, yy) = slLage(m, "control knopfY")
(px, py) = slLage(m, "control Spalte1")
slHin(10, 10)
slKlick(xx, xy)
slWarten(4)
umschaltKlick(yx, yy)
' sonst zaehlt der Druck zum Ziehen als Doppelklick (0,4 s)
slWarten(40)
slZug(yx, yy, px, py, 12, TRUE)
slWarten(8)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, CWD$() + "/f.dhform")
DIM z AS STRING
FOR EACH z IN slAnfang(log, "eingesetzt ")
    PRINT z
NEXT
DIM b AS ARRAY OF STRING : b = slAnfang(log, "behaelter Spalte1")
PRINT b[LEN(b) - 1]
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/_hilfen/studiolauf.dh"
slStudio = ARG$(0)
' Ein Klick mit gehaltener Umschalttaste.
SUB umschaltKlick(x AS INTEGER, y AS INTEGER)
    slHin(x, y)
    ARRAY_PUSH(slZeilen, "e " + STR$(slBild) + " 2 340 0 0 0")
    slBild = slBild + 2
    slRunter()
    slHoch()
    ARRAY_PUSH(slZeilen, "e " + STR$(slBild) + " 1 340 0 0 0")
    slBild = slBild + 2
END SUB
--- datei f.dhform
{"title":"Fenster1","name":"Fenster1","x":0,"y":0,"w":600,"h":400,"movable":true,"closable":true,"visible":true,"resizable":true,"widgets":[{"kind":"button","name":"knopfX","text":"X","x":320,"y":100,"w":90,"h":30},{"kind":"button","name":"knopfY","text":"Y","x":440,"y":160,"w":90,"h":30},{"kind":"layout","name":"Spalte1","x":20,"y":90,"w":240,"h":200,"layout":{"art":"spalte","kinder":[],"abstand":6}}]}

--- erwartet
eingesetzt knopfX Spalte1 0
eingesetzt knopfY Spalte1 1
behaelter Spalte1 knopfX:0,knopfY:0

=== zwei gewaehlte kinder kommen zusammen heraus
IMPORT "laeufer.dh"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 8, CWD$() + "/f.dhform")
DIM ax AS INTEGER
DIM ay AS INTEGER
DIM bx AS INTEGER
DIM by AS INTEGER
(ax, ay) = slLage(m, "control knopfA")
(bx, by) = slLage(m, "control knopfB")
slHin(10, 10)
slKlick(ax, ay)
slWarten(4)
umschaltKlick(bx, by)
slWarten(40)
slZug(bx, by, bx, by + 280, 12, TRUE)
slWarten(8)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, CWD$() + "/f.dhform")
PRINT "heraus "; LEN(slAnfang(log, "herausgenommen "))
DIM b AS ARRAY OF STRING : b = slAnfang(log, "behaelter Zeile1")
PRINT b[LEN(b) - 1]
DIM ka AS INTEGER
DIM kay AS INTEGER
DIM kb AS INTEGER
DIM kby AS INTEGER
(ka, kay) = slLage(log, "control knopfA")
(kb, kby) = slLage(log, "control knopfB")
PRINT "nebeneinander wie vorher "; kay = kby AND kb - ka = bx - ax
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/_hilfen/studiolauf.dh"
slStudio = ARG$(0)
SUB umschaltKlick(x AS INTEGER, y AS INTEGER)
    slHin(x, y)
    ARRAY_PUSH(slZeilen, "e " + STR$(slBild) + " 2 340 0 0 0")
    slBild = slBild + 2
    slRunter()
    slHoch()
    ARRAY_PUSH(slZeilen, "e " + STR$(slBild) + " 1 340 0 0 0")
    slBild = slBild + 2
END SUB
