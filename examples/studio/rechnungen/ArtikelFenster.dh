' Die Artikel. Der Preis ist ein Geldfeld (getippt 19,99, gebunden als 1999
' Cent), die MwSt eine Klappliste, deren Eintraege den Satz als Wert tragen.
CLASS ArtikelFenster EXTENDS ArtikelFenster_Basis
    DIM ids AS ARRAY OF INTEGER
    ' Der Artikel in den Feldern, -1 = ein neuer.
    DIM aktId AS INTEGER

    SUB Geoeffnet()
        Self.liste()
        Self.neu()
    END SUB

    SUB liste()
        GUI_TABLE_CLEAR(Self.tabelle)
        Self.ids = []
        DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT id, bezeichnung, preis, mwst FROM artikel ORDER BY bezeichnung")
        WHILE DB_NEXT(r)
            ARRAY_PUSH(Self.ids, DB_GET_INT(r, 0))
            GUI_TABLE_ADD_ROW(Self.tabelle, [DB_GET_STRING(r, 1), EURO$(DB_GET_INT(r, 2)), STR$(DB_GET_INT(r, 3)) + " %"])
        WEND
    END SUB

    SUB datensatzZeigen(aid AS INTEGER)
        IF GUI_FORM_LOAD(Self.Fenster(), db, "artikel", aid) THEN Self.aktId = aid
        GUI_CLEAR_ERRORS(Self.Fenster())
        GUI_SET_TEXT(Self.hinweis, "")
        Self.markieren()
    END SUB

    SUB neu()
        GUI_FORM_CLEAR(Self.Fenster())
        ' Ein neuer Artikel beginnt mit 19 % -- und das zaehlt nicht als Eingabe.
        GUI_DROPDOWN_SET_SELECTED(Self.auswahlMwst, 0)
        GUI_FORM_CLEAN(Self.Fenster())
        GUI_CLEAR_ERRORS(Self.Fenster())
        Self.aktId = -1
        GUI_TABLE_CLEAR_SELECTION(Self.tabelle)
        GUI_SET_TEXT(Self.hinweis, "Neuer Artikel.")
        GUI_FOCUS(Self.feldBezeichnung)
    END SUB

    SUB markieren()
        DIM z AS INTEGER : z = ARRAY_INDEXOF(Self.ids, Self.aktId)
        IF z >= 0 THEN GUI_TABLE_SET_SELECTED(Self.tabelle, z) ELSE GUI_TABLE_CLEAR_SELECTION(Self.tabelle)
    END SUB

    FUNCTION sichern() AS BOOLEAN
        IF GUI_VALIDATE(Self.Fenster()) > 0 THEN RETURN FALSE
        DIM aid AS INTEGER : aid = GUI_FORM_SAVE(Self.Fenster(), db, "artikel", Self.aktId)
        IF aid = 0 THEN
            GUI_SET_TEXT(Self.hinweis, "Nicht gesichert.")
            RETURN FALSE
        END IF
        Self.aktId = aid
        Self.liste()
        Self.markieren()
        GUI_SET_TEXT(Self.hinweis, "Gesichert. Rechnungen, die den Artikel schon haben, behalten ihren Preis.")
        RETURN TRUE
    END FUNCTION

    FUNCTION darfWechseln() AS BOOLEAN
        IF NOT GUI_FORM_CHANGED(Self.Fenster()) THEN RETURN TRUE
        DIM a AS INTEGER : a = Frage("Die Änderungen am Artikel sind nicht gesichert.", "Sichern|Verwerfen|Abbrechen", "Artikel")
        IF a = 1 THEN RETURN Self.sichern()
        RETURN a = 2
    END FUNCTION

    SUB tabelle_Geaendert()
        DIM z AS INTEGER : z = GUI_TABLE_SELECTED(Self.tabelle)
        IF z < 0 OR z >= LEN(Self.ids) THEN RETURN
        DIM ziel AS INTEGER : ziel = Self.ids[z]
        IF ziel = Self.aktId THEN RETURN
        IF Self.darfWechseln() THEN
            Self.datensatzZeigen(ziel)
        ELSE
            Self.markieren()
        END IF
    END SUB

    SUB knopfNeu_Klick()
        IF Self.darfWechseln() THEN Self.neu()
    END SUB

    SUB knopfSichern_Klick()
        Self.sichern()
    END SUB

    ' Loeschen geht immer: eine Position kopiert, was sie vom Artikel braucht.
    SUB knopfLoeschen_Klick()
        IF Self.aktId < 0 THEN RETURN
        IF Frage("Den Artikel löschen?", "Löschen|Abbrechen", "Artikel") <> 1 THEN RETURN
        DB_EXEC(db, "DELETE FROM artikel WHERE id = ?", Self.aktId)
        Self.liste()
        Self.neu()
    END SUB

    SUB knopfSchliessen_Klick()
        IF Self.darfWechseln() THEN Self.Zumachen()
    END SUB
END CLASS
