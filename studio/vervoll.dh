' ============================================================
'  Drachenhauch Studio -- Vervollstaendigung im Code-Feld
' ============================================================
'  Ein Code-Feld zeigt nur den Rumpf einer Methode. Gefragt wird darum der
'  ganze Text des Programms, wie ihn auch die Pruefung zusammensetzt
'  (ganzerText$: Laufzeit, Basisklassen, Code, Start) -- die Zeile der
'  Schreibmarke findet die Zeilenkarte (gzEl/gzMeth/gzZeile/gzEinzug). So
'  kennt CODE_COMPLETE die Felder der Basisklasse (Self.knopf1), die
'  Laufzeit (Frage, Meldung ...) und hinter `objekt.` dessen Mitglieder.
'
'  Strg+Leertaste oeffnet die Liste, hinter einem Punkt geht sie von selbst
'  auf, wenn Mitglieder kamen. In der Liste springt Tippen, Enter oder
'  Doppelklick setzt ein, Esc schliesst.
' ============================================================

DIM winVv AS GUI_WINDOW : winVv = -1
DIM lstVv AS GUI_WIDGET
DIM vvOffen AS BOOLEAN : vvOffen = FALSE
DIM vvFeld AS GUI_WIDGET : vvFeld = -1
DIM vvPraefix AS INTEGER : vvPraefix = 0

SUB vervollAnlegen()
    winVv = GUI_WINDOW("", 0, 0, 320, 240)
    GUI_WINDOW_CHROME(winVv, FALSE)
    GUI_WINDOW_MOVABLE(winVv, FALSE)
    lstVv = GUI_LISTBOX(winVv, 0, 0, 320, 240, [])
    IF codeSchrift >= 0 THEN GUI_SET_FONT(lstVv, codeSchrift)
    GUI_SET_FONT_SIZE(lstVv, 14)
    GUI_WINDOW_VISIBLE(winVv, FALSE)
END SUB

FUNCTION wortzeichen(c AS STRING) AS BOOLEAN
    RETURN c = "_" OR c = "$" OR (c >= "a" AND c <= "z") OR (c >= "A" AND c <= "Z") OR (c >= "0" AND c <= "9")
END FUNCTION

' Oeffnet die Liste fuer den vorderen Code-Reiter. `vonSelbst`: nur, wenn
' es Mitglieder hinter einem Punkt sind (ohne bekannte Klasse kaeme die
' ganze Liste, und die soll nicht hinter jedem Satzpunkt aufgehen).
SUB vervollOeffnen(vonSelbst AS BOOLEAN)
    DIM k AS INTEGER : k = reiterVorn()
    IF k < 0 OR k >= LEN(reiter) THEN RETURN
    DIM r AS Reiter : r = reiter[k]
    IF r.art = "layout" OR r.feld < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(r.feld)
    codeUebernehmen(r)
    DIM text AS STRING : text = ganzerText$()
    DIM ei AS INTEGER : ei = elementVon(r.el)
    DIM mi AS INTEGER : mi = -1
    IF r.art = "code" THEN mi = ARRAY_INDEXOF(methoden, r.meth)
    DIM gz AS INTEGER : gz = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gzEl) - 1
        IF gzEl[i] <> ei OR gzErzeugt[i] OR gzZeile[i] <> z THEN CONTINUE
        IF r.art = "code" AND gzMeth[i] = mi THEN gz = i
        IF r.art = "dekl" AND gzMeth[i] = KARTE_DEKL THEN gz = i
        IF gz >= 0 THEN BREAK
    NEXT
    IF gz < 0 THEN RETURN
    DIM namen AS ARRAY OF STRING : namen = CODE_COMPLETE(text, gz + 1, s + gzEinzug[gz], projOrdner)
    ' Wie viel links der Marke schon getippt ist -- das wird ersetzt.
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT(GUI_TEXT(r.feld), CHR$(10))
    DIM zeile AS STRING : zeile = IIF(z >= 1 AND z <= LEN(zeilen), zeilen[z - 1], "")
    vvPraefix = 0
    DIM p AS INTEGER : p = s - 2
    WHILE p >= 0
        IF NOT wortzeichen(MID$(zeile, p, 1)) THEN BREAK
        vvPraefix = vvPraefix + 1
        p = p - 1
    WEND
    IF vonSelbst AND LEN(namen) > 100 THEN RETURN
    IF LEN(namen) = 0 THEN
        IF NOT vonSelbst THEN status("Keine Vorschläge an dieser Stelle.")
        RETURN
    END IF
    GUI_LISTBOX_CLEAR(lstVv)
    FOR i = 0 TO MIN(LEN(namen), 300) - 1
        GUI_LISTBOX_ADD(lstVv, namen[i])
    NEXT
    GUI_LISTBOX_SET_SELECTED(lstVv, 0)
    DIM mx AS INTEGER
    DIM my AS INTEGER
    DIM mh AS INTEGER
    (mx, my, mh) = GUI_TEXTAREA_CARET_XY(r.feld)
    DIM vx AS INTEGER : vx = MAX(0, MIN(mx, SCREENWIDTH() - 330))
    DIM vy AS INTEGER : vy = my + mh + 2
    IF vy + 240 > SCREENHEIGHT() THEN vy = MAX(0, my - 242)
    GUI_WINDOW_SET_BOUNDS(winVv, vx, vy, 320, 240)
    GUI_SET_BOUNDS(lstVv, 0, 0, 320, 240)
    GUI_WINDOW_VISIBLE(winVv, TRUE)
    GUI_WINDOW_FRONT(winVv)
    GUI_FOCUS(lstVv)
    vvOffen = TRUE
    vvFeld = r.feld
    DIM erste AS ARRAY OF STRING : erste = []
    FOR i = 0 TO MIN(LEN(namen), 8) - 1
        ARRAY_PUSH(erste, namen[i])
    NEXT
    protokoll("vorschlag " + STR$(LEN(namen)) + " " + JOIN$(erste, ","))
END SUB

SUB vervollSchliessen()
    IF NOT vvOffen THEN RETURN
    GUI_WINDOW_VISIBLE(winVv, FALSE)
    vvOffen = FALSE
    IF vvFeld >= 0 THEN GUI_FOCUS(vvFeld)
END SUB

SUB vervollUebernehmen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstVv)
    DIM feld AS GUI_WIDGET : feld = vvFeld
    vervollSchliessen()
    IF sel < 0 OR feld < 0 THEN RETURN
    DIM name AS STRING : name = GUI_LISTBOX_ITEM(lstVv, sel)
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(feld)
    GUI_TEXTAREA_SELECT(feld, z, s - vvPraefix, z, s)
    GUI_TEXTAREA_INSERT(feld, name)
    GUI_FOCUS(feld)
    protokoll("vervollstaendigt " + name)
END SUB

' Je Bild nach GUI_UPDATE.
SUB vervollPruefen()
    IF vvOffen THEN
        IF NOT GUI_WINDOW_SHOWN(winVv) THEN
            vvOffen = FALSE
        ELSEIF GUI_DOUBLE_CLICKED(lstVv) THEN
            vervollUebernehmen()
        ELSEIF KEYHIT(KEY_ESCAPE) OR KEYHIT(KEY_TAB) THEN
            IF KEYHIT(KEY_TAB) THEN vervollUebernehmen() ELSE vervollSchliessen()
        ELSEIF MOUSE_HIT(0) AND GUI_WINDOW_AT(MOUSEX(), MOUSEY()) <> winVv THEN
            vervollSchliessen()
        END IF
        RETURN
    END IF
    IF NOT codeVorn() THEN RETURN
    IF GUI_MODAL() THEN RETURN
    IF strg() AND KEYHIT(KEY_SPACE) THEN
        vervollOeffnen(FALSE)
        RETURN
    END IF
    ' Hinter einem gerade getippten Punkt: die Mitglieder.
    DIM k AS INTEGER : k = reiterVorn()
    IF k < 0 OR k >= LEN(reiter) THEN RETURN
    DIM r AS Reiter : r = reiter[k]
    IF r.feld < 0 THEN RETURN
    ' Jedes Bild fragen: der erste Aufruf von GUI_CHANGED beginnt erst zu
    ' beobachten und meldet nichts.
    DIM neu AS BOOLEAN : neu = GUI_CHANGED(r.feld)
    IF NOT neu OR GUI_FOCUSED() <> r.feld THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(r.feld)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT(GUI_TEXT(r.feld), CHR$(10))
    IF z < 1 OR z > LEN(zeilen) OR s < 2 THEN RETURN
    IF MID$(zeilen[z - 1], s - 2, 1) = "." THEN vervollOeffnen(TRUE)
END SUB
