' Aus test_method_syntax.py uebertragen (26 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== string upper lower (1)
DIM s AS STRING
s = "Hallo"
PRINT s.upper()
PRINT s.lower()
--- erwartet
HALLO
hallo

=== string upper lower (2)
DIM s AS STRING
s = "Hallo"
PRINT s.upper()
PRINT s.lower()
--- erwartet
HALLO
hallo

=== string length (1)
PRINT "abc".length()
PRINT "".length()
--- erwartet
3
0

=== string length (2)
PRINT "abc".length()
PRINT "".length()
--- erwartet
3
0

=== string trim (1)
PRINT "[" + "  hi  ".trim() + "]"
--- erwartet
[hi]

=== string trim (2)
PRINT "[" + "  hi  ".trim() + "]"
--- erwartet
[hi]

=== string left right mid (1)
DIM s AS STRING
s = "TestString"
PRINT s.left(4)
PRINT s.right(6)
PRINT s.mid(4, 6)
--- erwartet
Test
String
String

=== string left right mid (2)
