=== die abgedruckten meldungen sind die von dhrt
' pruef_meldungen.js laesst jedes Fehlerbeispiel laufen und sucht den
' Abdruck (Zeilen mit Leerzeichen verbunden) in der Ausgabe.
IMPORT "helfer.dh"
DIM b AS STRING
FOR EACH b IN ["wunder", "anwendungen"]
    buchWerkzeugIn(ARG$(0), b, "pruef_meldungen.js")
    ' Ohne Bildschirm fallen die Fehlerbeispiele mit Fenster weg; je Buch
    ' laeuft mindestens eines auf der Konsole.
    PRINT b; " "; nlCode; " "; (zahlVor(nlAus, "Meldungen") >= 1)
    IF nlCode <> 0 THEN PRINT nlAus; nlErr
NEXT
--- argumente
{sammlung}/../../..
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/einstieg.dh"
--- erwartet
wunder 0 TRUE
anwendungen 0 TRUE

=== jedes programm und jede loesung uebersetzt ohne befund
' Auch ohne Warnung: ein Leser tippt es ab und soll keine Wellenlinie
' sehen. Die Fehlerbeispiele (fehler_*) sind ausgenommen, sie sollen
' scheitern.
IMPORT "helfer.dh"
DIM w AS STRING : w = ARG$(0) + "/buecher/"
DIM n AS INTEGER : n = 0
DIM o AS STRING
FOR EACH o IN ordner(w)
    DIM f AS STRING
    FOR EACH f IN DIRLIST(w + o)
        IF RIGHT$(f, 3) = ".dh" AND LEFT$(f, 7) <> "fehler_" THEN
            nlWarten(PROCESS_START("dhrt", "--check", w + o + "/" + f), 60000)
            IF TRIM$(nlAus) <> "[]" THEN PRINT o; "/"; f; ": "; nlAus
            n = n + 1
        END IF
    NEXT
NEXT
PRINT "genug "; n >= 15
--- argumente
{sammlung}/../../..
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/nodelauf.dh"
' Jeder Ordner unter code/ beider Buecher (Kapitel, Loesungen) und ihre
' figures/ -- ein neues Kapitel ist so von selbst dabei. Projekte des
' Studios liegen eine Ebene tiefer und bleiben aussen vor.
FUNCTION ordner(w AS STRING) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM b AS STRING
    FOR EACH b IN ["wunder", "anwendungen"]
        DIM k AS STRING
        FOR EACH k IN DIRLIST(w + b + "/code")
            IF DIREXISTS(w + b + "/code/" + k) THEN ARRAY_PUSH(aus, b + "/code/" + k)
        NEXT
        ARRAY_PUSH(aus, b + "/buch/figures")
    NEXT
    RETURN aus
END FUNCTION
--- erwartet
genug TRUE

=== rundgang kapitel 0: was der text zeigt, hat die fertige mediathek
' Kapitel 0 fuehrt durch die fertige Mediathek (Stand Kapitel 24): die
' Menues mit ihren Eintraegen und Kuerzeln, die Suche an der Tabelle, die
' Kachel als eigenes Control, die Karten des Startbildschirms und wo
' jeder Stand liegt. Aendert sich eines davon, stimmt der Rundgang nicht
' mehr.
IMPORT "json"
DIM w AS STRING : w = ARG$(0)
DIM c AS STRING : c = w + "/buecher/anwendungen/code/"
DIM h AS JSON_HANDLE
h = JSON_PARSE(READALL(c + "kap24/mediathek/Hauptfenster.dhform"))
DIM menue AS ARRAY OF STRING : menue = []
DIM i AS INTEGER
DIM k AS INTEGER
FOR i = 0 TO JSON_LEN(h, "menus") - 1
    DIM mp AS STRING : mp = "menus." + STR$(i)
    DIM z AS STRING : z = JSON_GET_STRING(h, mp + ".label") + ":"
    FOR k = 0 TO JSON_LEN(h, mp + ".items") - 1
        DIM ep AS STRING : ep = mp + ".items." + STR$(k)
        z = z + " " + JSON_GET_STRING(h, ep + ".label")
        IF JSON_HAS(h, ep + ".shortcut") THEN z = z + " (" + JSON_GET_STRING(h, ep + ".shortcut") + ")"
        z = z + ","
    NEXT
    PRINT z
NEXT
FOR i = 0 TO JSON_LEN(h, "widgets") - 1
    DIM wp AS STRING : wp = "widgets." + STR$(i)
    DIM n AS STRING : n = JSON_GET_STRING(h, wp + ".name")
    IF n = "tabelle" THEN PRINT "suche "; JSON_GET_STRING(h, wp + ".studio_suchfeld")
    IF n = "kachel1" THEN PRINT "kachel "; JSON_GET_STRING(h, wp + ".studio_control")
NEXT
DIM ef AS JSON_HANDLE
ef = JSON_PARSE(READALL(c + "kap24/mediathek/EintragFenster.dhform"))
FOR i = 0 TO JSON_LEN(ef, "widgets") - 1
    IF JSON_GET_STRING(ef, "widgets." + STR$(i) + ".name") = "feldJahr" THEN
        PRINT "jahr nur ziffern "; JSON_GET_INT(ef, "widgets." + STR$(i) + ".zahlen") = 1
    END IF
NEXT
DIM sw AS STRING : sw = READALL(w + "/ide/teile/startwahl.dh")
DIM t AS STRING
FOR EACH t IN ["Wie möchtest du arbeiten?", "KLASSISCH", "Die IDE", "MODERN", "Das Studio"]
    PRINT t; " "; INSTR(sw, "tr$(" + CHR$(34) + t + CHR$(34) + ")") >= 0
NEXT
DIM teil1 AS INTEGER : teil1 = 0
FOR i = 1 TO 6
    IF DIREXISTS(c + "kap0" + STR$(i)) THEN teil1 = teil1 + 1
NEXT
DIM studio AS INTEGER : studio = 0
FOR i = 8 TO 24
    IF FILEEXISTS(c + "kap" + RIGHT$("0" + STR$(i), 2) + "/mediathek/projekt.dhstudio") THEN studio = studio + 1
NEXT
PRINT "teil I "; teil1; ", studio "; studio; ", kap07 "; DIREXISTS(c + "kap07")
--- argumente
{sammlung}/../../..
--- erwartet
Datei: Ausleihliste ..., Karteikarte ..., Als Excel-Mappe sichern ..., Liste einlesen ..., Im Heimnetz zeigen,
Bearbeiten: Neu ... (Strg+N), Bearbeiten ... (Strg+E), Entfernen (Entf), Suchen (Strg+F),
Ansicht: Überfällig ..., Statistik ..., Helles Aussehen,
Hilfe: Barrierefreiheit prüfen ..., Über die Mediathek ...,
suche feldSuche
kachel CoverKachel
jahr nur ziffern TRUE
Wie möchtest du arbeiten? TRUE
KLASSISCH TRUE
Die IDE TRUE
MODERN TRUE
Das Studio TRUE
teil I 6, studio 17, kap07 FALSE

=== anhang c: die sql-beispiele liefern, was der anhang abdruckt
' Anhang C druckt jede Anweisung aus beispiele.sql und darunter ihr
' Ergebnis aus ausgabe.txt. sql.dh fuehrt sie aus; was es ausgibt, muss
' ausgabe.txt sein -- sonst stuende im Buch eine Antwort, die SQLite so
' nicht gibt.
DIM d AS STRING : d = ARG$(0) + "/buecher/anwendungen/code/anhang_c"
CHDIR(d)
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", "sql.dh")
DIM aus AS STRING
DIM leer AS INTEGER
WHILE leer < 5
    DIM t AS STRING : t = PROCESS_READ$(p) + PROCESS_ERR$(p)
    aus = aus + t
    IF t = "" AND NOT PROCESS_RUNNING(p) THEN leer = leer + 1
    SLEEP(20)
WEND
aus = REPLACE$(aus, CHR$(13), "")
DIM soll AS STRING : soll = REPLACE$(READALL("ausgabe.txt"), CHR$(13), "")
PRINT "gleich "; aus = soll
IF aus <> soll THEN PRINT aus
PRINT "bloecke "; LEN(SPLIT$(soll, "== ")) - 1
--- argumente
{sammlung}/../../..
--- erwartet
gleich TRUE
bloecke 14

=== anhang b und e: was der buchbau aus den quellen liest
' Anhang B liest Ereignisse und Tasten aus den Quellen des Studios, Anhang
' E sammelt die Meldungen aus den Kapiteln. Aendert sich die Form der
' Quellen, fiele eine Tabelle still leer aus -- der Fall zeigt Stichproben.
IMPORT "helfer.dh"
CHDIR(ARG$(0) + "/buecher/anwendungen/buch")
WRITEALL("_anhang_probe.js", READALL(ARG$(1)))
nlWarten(PROCESS_START("node", "_anhang_probe.js"), 60000)
DELETEFILE("_anhang_probe.js")
PRINT nlAus;
IF nlCode <> 0 THEN PRINT nlErr
--- argumente
{sammlung}/../../..
{fall}/probe.js
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/nodelauf.dh"
--- datei probe.js
const path = require("path");
const tabellen = {};
let h2 = "";
const H = new Proxy({
  h2: (t) => { h2 = t; return null; },
  table: (r, o) => {
    (tabellen[h2] = tabellen[h2] || []).push(r.map((z) => z.map((c) => (typeof c === "object" ? c.text : c)).join(" | ")));
    return null;
  },
}, { get: (t, k) => (k in t ? t[k] : () => null) });
require(path.resolve("content/91_anhang_b.js"))(H);
require(path.resolve("content/94_anhang_e.js"))(H);
const hat = (h, z) => (tabellen[h] || []).some((t) => t.some((zeile) => zeile.includes(z)));
console.log("textfeld", hat("Ereignisse im Studio", "Textfeld | Geaendert, Enter, FokusRein, FokusRaus"));
console.log("fenster", hat("Ereignisse im Studio", "Fenster | Geoeffnet, Schliessen, Groesse, Taste, Takt"));
console.log("zelle", hat("Ereignisse im Studio", "Zelle(zeile AS INTEGER, spalte AS INTEGER) | wenn eine Zelle angeklickt wird"));
console.log("starten", hat("Tasten im Studio", "Ausführen | Starten | F5"));
console.log("bauen", hat("Tasten im Studio", "Ausführen | Bauen | Strg+B"));
console.log("alles", hat("Tasten im Studio", "Bearbeiten | Alles auswählen | Strg+A"));
console.log("debugger und lauf eine zeile", (tabellen["Laufzeitfehler"] || []).flat().filter((z) => z.includes("GUI_SET_TEXT: erwartet INTEGER")).map((z) => z.split(" | ").slice(1, 2).join("")).join(";"));
console.log("studio", (tabellen["Im Studio"] || []).flat().map((z) => z.split(" | ")[1]).join(", "));
--- erwartet
textfeld true
fenster true
zelle true
starten true
bauen true
alles true
debugger und lauf eine zeile 11, 12
studio Probleme, Probleme, Statuszeile

