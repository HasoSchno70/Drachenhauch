' Aus test_gui_dialoge_ausbau.py uebertragen (14 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== eigene knoepfe antwort ist die nummer (1)
' Klick auf den zweiten von drei Knoepfen -> Antwort 2.
IMPORT "gui"
SCREEN(520, 320, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM d AS GUI_WINDOW : d = GUI_DIALOG("F", "Text?", "Speichern|Verwerfen|Abbrechen")
DIM k AS GUI_WIDGET : k = GUI_WINDOW_WIDGET(d, GUI_WINDOW_WIDGET_COUNT(d) - 2)
DIM np AS GUI_WIDGET : np = GUI_CANVAS(d, 0, 0, 1, 1)
GUI_UPDATE()
DIM ox AS INTEGER : ox = GUI_CANVAS_X(np)
DIM oy AS INTEGER : oy = GUI_CANVAS_Y(np)
PRINT ox + GUI_GET_X(k) + GUI_GET_W(k) \ 2 ; " " ; oy + GUI_GET_Y(k) + GUI_GET_H(k) \ 2
--- umgebung
DHRT_FRAMES=2
--- erwartet
265 192

=== eigene knoepfe antwort ist die nummer (2)
' Klick auf den zweiten von drei Knoepfen -> Antwort 2.
IMPORT "gui"
SCREEN(520, 320, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM d AS GUI_WINDOW : d = GUI_DIALOG("F", "Text?", "Speichern|Verwerfen|Abbrechen")
AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 1 TO 12
    GUI_UPDATE()
    IF GUI_ANSWER(d) <> 0 THEN PRINT "antwort " + STR$(GUI_ANSWER(d))
    GUI_DRAW()
    FLIP()
NEXT
--- datei ev.txt
# Test-Aufnahme
c 4
e 4 7 265 192 0 0 // Event: test
e 5 7 265 192 0 0 // Event: test
e 5 6 0 0 0 0 // Event: test
e 6 5 0 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
antwort 2

