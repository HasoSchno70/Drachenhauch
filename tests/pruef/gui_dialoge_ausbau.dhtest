=== modal aus gibt frei und ein knopf im fenster beendet es nicht
' Anders als ein Dialog: ein Klick auf einen Knopf im modalen EIGENEN
IMPORT "gui"
SCREEN(520, 320, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Hinten", 4, 4, 200, 120)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "los", 8, 8, 90, 26)
DIM m AS GUI_WINDOW : m = GUI_WINDOW("Modal", 250, 150, 200, 120)
DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(m, "zu", 8, 8, 90, 26)
GUI_WINDOW_MODAL(m, TRUE)
GUI_FOCUS(ok)
AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 1 TO 14
    GUI_UPDATE()
    IF GUI_CLICKED(ok) THEN PRINT "zu " + STR$(GUI_MODAL())
    IF f = 8 THEN GUI_WINDOW_MODAL(m, FALSE)
    IF f = 12 THEN PRINT GUI_MODAL()
    GUI_DRAW()
    FLIP()
NEXT
--- datei ev.txt
# Test-Aufnahme
c 2
e 3 2 257 0 0 0 // Event: test
e 4 1 257 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
zu TRUE
FALSE

=== ausblenden gibt die modalitaet frei
IMPORT "gui"
SCREEN(520, 320, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Hinten", 4, 4, 200, 120)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "los", 8, 8, 90, 26)
DIM m AS GUI_WINDOW : m = GUI_WINDOW("Modal", 250, 150, 200, 120)
DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(m, "zu", 8, 8, 90, 26)
GUI_WINDOW_MODAL(m, TRUE)
DIM f AS INTEGER
FOR f = 1 TO 6
    GUI_UPDATE()
    IF f = 2 THEN GUI_WINDOW_VISIBLE(m, FALSE)
    IF f = 5 THEN PRINT GUI_MODAL()
    GUI_DRAW()
    FLIP()
NEXT
--- umgebung
DHRT_FRAMES=8
--- erwartet
FALSE

