' Mario-Clone-Demo -- zeigt die mit examples/mario/make_sprites.py gebauten
' Sprites in Aktion: Held laeuft (Pfeile), springt (Leertaste/Hoch), bremst,
' duckt sich (Runter); Goombas patrouillieren und lassen sich draufspringen;
' ein fliegender Para schwebt in einer Sinuswelle vorbei.
'
' Voraussetzung: erst `py examples/mario/make_sprites.py` ausfuehren, damit
' hero.png / goomba.png / para.png neben dieser Datei liegen.
IMPORT "sprite"

CONST W AS INTEGER = 256
CONST H AS INTEGER = 224
CONST GROUND AS FLOAT = 176.0          ' Boden-Oberkante (Sprite-Top der Figuren)
SCREEN(W, H, "Mario-Clone (Pfeile/Leertaste, ESC = Ende)", 3)

' --- Held ---------------------------------------------------------------
DIM hsheet AS IMAGE
hsheet = LOADIMAGE("hero.png")
DIM hero AS SPRITE
hero = SPRITE_NEW(hsheet, 16, 16)
SPRITE_ADD_ANIM(hero, "idle", 0, 0, 1.0)
SPRITE_ADD_ANIM(hero, "run",  1, 3, 12.0)
SPRITE_ADD_ANIM(hero, "jump", 4, 4, 1.0)
SPRITE_ADD_ANIM(hero, "skid", 5, 5, 1.0)
SPRITE_ADD_ANIM(hero, "duck", 6, 6, 1.0)
SPRITE_PLAY(hero, "idle")

DIM hx AS FLOAT
DIM hy AS FLOAT
DIM hvx AS FLOAT
DIM hvy AS FLOAT
DIM on_ground AS BOOLEAN
DIM face_left AS BOOLEAN
hx = 60.0
hy = GROUND
hvx = 0.0
hvy = 0.0
on_ground = TRUE
face_left = FALSE

' --- Goombas ------------------------------------------------------------
DIM gsheet AS IMAGE
gsheet = LOADIMAGE("goomba.png")
DIM gA AS SPRITE
DIM gB AS SPRITE
gA = SPRITE_NEW(gsheet, 16, 16)
gB = SPRITE_NEW(gsheet, 16, 16)
SPRITE_ADD_ANIM(gA, "walk", 0, 1, 6.0)
SPRITE_ADD_ANIM(gA, "squash", 2, 2, 1.0)
SPRITE_ADD_ANIM(gB, "walk", 0, 1, 6.0)
SPRITE_ADD_ANIM(gB, "squash", 2, 2, 1.0)
SPRITE_PLAY(gA, "walk")
SPRITE_PLAY(gB, "walk")

DIM gAx AS FLOAT
DIM gAdir AS FLOAT
DIM gA_dead AS INTEGER          ' >0 = Squash-Timer (ms) laeuft
DIM gBx AS FLOAT
DIM gBdir AS FLOAT
DIM gB_dead AS INTEGER
gAx = 150.0
gAdir = -1.0
gA_dead = 0
gBx = 210.0
gBdir = 1.0
gB_dead = 0

' --- Para (fliegt) ------------------------------------------------------
DIM psheet AS IMAGE
psheet = LOADIMAGE("para.png")
DIM para AS SPRITE
para = SPRITE_NEW(psheet, 16, 16)
SPRITE_ADD_ANIM(para, "fly", 0, 1, 7.0)
SPRITE_PLAY(para, "fly")
DIM px AS FLOAT
px = 260.0

DIM t AS FLOAT
t = 0.0
DIM last_ms AS INTEGER
last_ms = MILLIS()

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK

    DIM now_ms AS INTEGER
    now_ms = MILLIS()
    DIM dt AS INTEGER
    dt = now_ms - last_ms
    last_ms = now_ms
    IF dt > 60 THEN dt = 60          ' grosse Spikes kappen
    DIM dts AS FLOAT
    dts = dt / 1000.0
    t = t + dts

    ' --- Eingabe ---
    DIM ducking AS BOOLEAN
    ducking = FALSE
    hvx = 0.0
    IF KEYPRESSED(1073741904) THEN          ' LEFT
        hvx = -90.0
        face_left = TRUE
    END IF
    IF KEYPRESSED(1073741903) THEN          ' RIGHT
        hvx = 90.0
        face_left = FALSE
    END IF
    IF on_ground AND KEYPRESSED(1073741905) THEN   ' DOWN -> ducken
        ducking = TRUE
        hvx = 0.0
    END IF
    DIM jump AS BOOLEAN
    jump = KEYPRESSED(32) OR KEYPRESSED(1073741906)   ' SPACE / UP
    IF on_ground AND jump AND NOT ducking THEN
        hvy = -260.0
        on_ground = FALSE
    END IF

    ' --- Physik Held ---
    hvy = hvy + 700.0 * dts          ' Schwerkraft
    hx = hx + hvx * dts
    hy = hy + hvy * dts
    IF hx < 0.0 THEN hx = 0.0
    IF hx > W - 16.0 THEN hx = W - 16.0
    IF hy >= GROUND THEN
        hy = GROUND
        hvy = 0.0
        on_ground = TRUE
    END IF

    ' --- Anim-Auswahl ---
    SPRITE_SET_FLIP(hero, face_left, FALSE)
    IF NOT on_ground THEN
        SPRITE_PLAY(hero, "jump")
    ELSEIF ducking THEN
        SPRITE_PLAY(hero, "duck")
    ELSEIF hvx <> 0.0 THEN
        SPRITE_PLAY(hero, "run")
    ELSE
        SPRITE_PLAY(hero, "idle")
    END IF
    SPRITE_SET_POS(hero, hx, hy)
    SPRITE_UPDATE(hero, dt)

    ' --- Goombas bewegen ---
    IF gA_dead = 0 THEN
        gAx = gAx + gAdir * 28.0 * dts
        IF gAx < 96.0 THEN gAdir = 1.0
        IF gAx > 176.0 THEN gAdir = -1.0
        SPRITE_SET_FLIP(gA, gAdir > 0.0, FALSE)
    ELSE
        gA_dead = gA_dead - dt
    END IF
    SPRITE_SET_POS(gA, gAx, GROUND)
    SPRITE_UPDATE(gA, dt)

    IF gB_dead = 0 THEN
        gBx = gBx + gBdir * 34.0 * dts
        IF gBx < 188.0 THEN gBdir = 1.0
        IF gBx > 236.0 THEN gBdir = -1.0
        SPRITE_SET_FLIP(gB, gBdir > 0.0, FALSE)
    ELSE
        gB_dead = gB_dead - dt
    END IF
    SPRITE_SET_POS(gB, gBx, GROUND)
    SPRITE_UPDATE(gB, dt)

    ' --- Stomp-Pruefung (Held faellt von oben auf einen Goomba) ---
    IF gA_dead = 0 AND hvy > 0.0 AND SPRITE_COLLIDES(hero, gA) THEN
        SPRITE_PLAY(gA, "squash")
        gA_dead = 600
        hvy = -200.0          ' Abprall
    END IF
    IF gB_dead = 0 AND hvy > 0.0 AND SPRITE_COLLIDES(hero, gB) THEN
        SPRITE_PLAY(gB, "squash")
        gB_dead = 600
        hvy = -200.0
    END IF

    ' --- Para fliegt nach links, wickelt um, schwebt in Sinuswelle ---
    px = px - 40.0 * dts
    IF px < -16.0 THEN px = W * 1.0 + 8.0
    SPRITE_SET_POS(para, px, 70.0 + SIN(t * 3.0) * 18.0)
    SPRITE_UPDATE(para, dt)

    ' --- Zeichnen ---
    CLS(RGB(92, 148, 252))                 ' Himmelblau
    BOX(0, INT(GROUND) + 14, W - 1, H - 1, RGB(196, 112, 48))   ' Erde
    BOX(0, INT(GROUND) + 14, W - 1, INT(GROUND) + 18, RGB(96, 200, 72)) ' Gras
    ' Ein paar Backstein-Bloecke zur Deko (gefuellt + dunkler Rand)
    DIM bx AS INTEGER
    FOR bx = 0 TO 3
        BOX(40 + bx * 56, 96, 40 + bx * 56 + 15, 111, RGB(200, 96, 48))
        RECT(40 + bx * 56, 96, 40 + bx * 56 + 15, 111, RGB(120, 52, 24))
    NEXT

    IF gA_dead = 0 OR gA_dead > 0 THEN SPRITE_DRAW(gA)
    IF gB_dead = 0 OR gB_dead > 0 THEN SPRITE_DRAW(gB)
    SPRITE_DRAW(para)
    SPRITE_DRAW(hero)

    TEXT(4, 4, "Pfeile / Leer", RGB(255, 255, 255))
    FLIP()
    SLEEP(16)
WEND
