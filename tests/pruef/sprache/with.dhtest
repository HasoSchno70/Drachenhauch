=== with member in expression (1)
' `.member` als Read-Expression, nicht nur als Assign-Target.
CLASS Vec
    DIM x AS FLOAT
    DIM y AS FLOAT
END CLASS

DIM v AS Vec
v = NEW Vec()
v.x = 3.0
v.y = 4.0
DIM len AS FLOAT
WITH v
    len = SQR(.x * .x + .y * .y)
END WITH
PRINT len
--- erwartet
5.0

