=== umbenennen mit einer schreibgeschuetzten importierenden datei
' Stresstest 2026-10-02: beim Umbenennen im Projektbaum schreibt die IDE
' die IMPORT-Zeilen der Dateien nach, die die umbenannte einbinden -- ohne
' TRY. Eine schreibgeschuetzte (hier echt: attrib +r) beendete die IDE,
' NACHDEM die Datei schon umbenannt war. Jetzt nennt die Statuszeile sie.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 30 THEN
    baumUmbenennen(PATHJOIN(projektOrdner, "lib.dh"), "neu.dh")
    protokoll("pr status " + GUI_STATUSBAR_TEXT$(lblStatus, 0))
END IF
IF prBild = 50 THEN
    protokoll("pr laeuft weiter")
    EXIT(0)
END IF
--- vorher
DIM p AS INTEGER : p = PROCESS_START("attrib", "+r", "haupt.dh")
WHILE PROCESS_RUNNING(p) : SLEEP(20) : WEND
--- argumente
a.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei a.dh
PRINT 0
--- datei haupt.dh
IMPORT "lib.dh"
PRINT eins()
--- datei lib.dh
FUNCTION eins() AS INTEGER
    RETURN 1
END FUNCTION
--- system windows
--- nachher
DIM p AS INTEGER : p = PROCESS_START("attrib", "-r", "haupt.dh")
WHILE PROCESS_RUNNING(p) : SLEEP(20) : WEND
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
PRINT "neu da "; FILEEXISTS("neu.dh")
--- erwartet
pr status Umbenannt: lib.dh -> neu.dh Nicht geschrieben: haupt.dh
pr laeuft weiter
neu da TRUE

=== eine ide.json mit werten vom falschen typ haelt den start nicht auf
' Stresstest 2026-10-02: die Einstellungen wurden mit JSON_GET_BOOL/INT/
' STRING gelesen, und die werfen bei einem Wert vom falschen Typ. Eine
' von Hand geaenderte ide.json ("hell": 1 statt true, "schrift": 17.5)
' liess die IDE bei JEDEM Start abbrechen, bis jemand die Datei fand und
' loeschte. Jetzt gilt fuer einen solchen Wert die Vorgabe; eine Zahl
' geht als Wahrheitswert durch, eine Kommazahl als ganze Zahl.
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
protokoll("pr hell " + STR$(hell) + " schrift " + STR$(codeGroesse) + " umbruch " + STR$(umbruchAn))
protokoll("pr zuletzt " + STR$(LEN(zuletzt)) + " haltepunkte " + STR$(LEN(hpDateien)) + " sprache " + sprache)
EXIT(0)
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
PRINT 0
--- datei _programm/ide.json
{"hell": 1, "schrift": 17.5, "umbruch": "ja", "sprache": 5, "zuletzt": "x", "haltepunkte": [{"datei": 3, "zeile": "zwei"}, {"datei": "a.dh", "zeile": 4}]}
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 16) = "konfig uebergang" THEN PRINT L[i]
NEXT
--- erwartet
konfig uebergangen sprache, zuletzt, umbruch, haltepunkte.0.datei, haltepunkte.0.zeile
pr hell TRUE schrift 17 umbruch FALSE
pr zuletzt 1 haltepunkte 1 sprache de

=== farben.json und tasten.json in falscher form halten den start nicht auf
' Stresstest 2026-10-02: eigene Farben und Tastenbelegung lasen ihre
' Abschnitte mit JSON_KEYS, und das wirft, wenn dort kein Objekt steht --
' {"dunkel": "blau"} oder eine tasten.json mit einer Liste beendeten die
' IDE schon beim Start. Jetzt steht es bei den Meldungen der Datei.
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
protokoll("pr farben " + STR$(LEN(farbMeldungen)) + " tasten " + STR$(LEN(tastenMeldungen)))
befehl("thema")
protokoll("pr hell " + STR$(hell) + " farben " + STR$(LEN(farbMeldungen)))
EXIT(0)
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
PRINT 0
--- datei _programm/farben.json
{"dunkel": "blau", "hell": {"oberflaeche": 5, "kommentar": "#808080"}}
--- datei _programm/tasten.json
[1, 2]
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr farben 1 tasten 1
pr hell TRUE farben 1

=== eine riesige zeilennummer laesst int nicht ueberlaufen
' Stresstest 2026-10-02: "Gehe zu Zeile" mit 99999999999999999999 und eine
' Zeile der Ausgabe wie "haupt.dh:99999999999999999999" gingen durch
' INT(VAL(...)) -- INT laeuft ueber (64 Bit) und beendete die IDE. Jetzt
' wird vorher begrenzt.
AUTOMATION_PLAY("ev.txt")
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 10 THEN
    ausgabe("Laufzeitfehler in haupt.dh:99999999999999999999: zu gross")
    dlgZeile = GUI_PROMPT("Gehe zu Zeile", "Zeile:", "99999999999999999999")
END IF
IF prBild = 60 THEN
    DIM prZ AS INTEGER
    DIM prS AS INTEGER
    (prZ, prS) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    protokoll("pr laeuft weiter, marke " + STR$(prZ) + " dialog " + STR$(dlgZeile))
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
PRINT 1
PRINT 2
PRINT 3
--- datei _programm/ev.txt
c 3
e 0 1 340 0 0 0
e 30 2 257 0 0 0
e 33 1 257 0 0 0

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr laeuft weiter, marke 3 dialog 0

=== klammerpaar und signaturhilfe haben eine reichweite
' Stresstest 2026-10-02: hinter der ] einer Datenzeile mit 270000 Zeichen
' suchte klammerPartner Zeichen fuer Zeichen bis zur [ am Zeilenanfang (2 s
' in einem Bild), und aufrufUmDieMarke zaehlte bei jedem Tastendruck die
' Anfuehrungszeichen ab dem Zeilenanfang. Jetzt sucht das Klammerpaar
' hoechstens 20000 Zeichen weit, und jenseits von Spalte 5000 gibt es keine
' Signaturhilfe. Nahe Paare und Aufrufe gehen wie bisher.
DIM prS AS STRING : prS = "[" + REPEAT$("1", 30000) + "]"
protokoll("pr weit " + STR$(klammerPartner(prS, LEN(prS) - 1)))
DIM prN AS STRING : prN = "[" + REPEAT$("1", 100) + "]"
protokoll("pr nah " + STR$(klammerPartner(prN, LEN(prN) - 1)))
DIM prA AS STRING
DIM prSp AS INTEGER
DIM prArg AS INTEGER
DIM prZ AS STRING : prZ = REPEAT$(" ", 6000) + "CIRCLE(1, "
(prA, prSp, prArg) = aufrufUmDieMarke(prZ, LEN(prZ) + 1)
protokoll("pr weit rechts [" + prA + "]")
prZ = "CIRCLE(1, "
(prA, prSp, prArg) = aufrufUmDieMarke(prZ, LEN(prZ) + 1)
protokoll("pr vorn [" + prA + "] argument " + STR$(prArg))
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- umgebung
DHRT_FRAMES=100
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr weit -1
pr nah 0
pr weit rechts []
pr vorn [CIRCLE] argument 1

=== mit zwoelf offenen reitern springt die ide zu einer offenen datei und macht platz
' Stresstest 2026-10-02: tabOeffnen pruefte die Grenze von 12 Reitern VOR
' der Frage, ob die Datei schon offen ist -- ein Sprung in eine OFFENE
' Datei (Projektbaum, Problemliste, Ausgabe, Debugger, F12) meldete
' "Hoechstens 12 Reiter", und die Aufrufer setzten die Marke danach im
' falschen Feld. Jetzt wird zuerst gewechselt; fuer eine neue Datei macht
' der erste ungesicherte-freie Reiter Platz, der nicht vorn ist. Sind alle
' geaendert, bleibt es bei der Meldung.
DIM prI AS INTEGER
FOR prI = 1 TO 11
    dateiOeffnen(PATHJOIN(projektOrdner, "d" + STR$(prI) + ".dh"))
NEXT
protokoll("pr offen " + STR$(tabAnzahl))
dateiOeffnen(PATHJOIN(projektOrdner, "d3.dh"))
protokoll("pr gewechselt " + BASENAME(tabPfade[aktiverTab]) + " " + STR$(tabAnzahl))
dateiOeffnen(PATHJOIN(projektOrdner, "neu.dh"))
protokoll("pr neu " + BASENAME(tabPfade[aktiverTab]) + " " + STR$(tabAnzahl) + " haupt noch da " + STR$(tabMitPfad(PATHJOIN(projektOrdner, "haupt.dh")) >= 0))
FOR prI = 0 TO tabAnzahl - 1
    GUI_TEXTAREA_SELECT(tabFelder[prI], 1, 1, 1, 1)
    GUI_TEXTAREA_INSERT(tabFelder[prI], "' x" + NL)
NEXT
DIM prVorher AS STRING : prVorher = tabPfade[aktiverTab]
dateiOeffnen(PATHJOIN(projektOrdner, "haupt.dh"))
protokoll("pr alle geaendert " + STR$(tabPfade[aktiverTab] = prVorher) + " " + STR$(tabAnzahl) + " " + LEFT$(GUI_STATUSBAR_TEXT$(lblStatus, 0), 9))
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=100
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- vorher
DIM i AS INTEGER
FOR i = 1 TO 11
    WRITEALL("d" + STR$(i) + ".dh", "PRINT " + STR$(i) + CHR$(10))
NEXT
WRITEALL("neu.dh", "PRINT 99" + CHR$(10))
WRITEALL("haupt.dh", "PRINT 0" + CHR$(10))
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr offen 12
pr gewechselt d3.dh 12
pr neu neu.dh 12 haupt noch da FALSE
pr alle geaendert TRUE 12 Höchstens
