=== guard with value match (1)
DIM cmd AS STRING
cmd = "save"
DIM dirty AS BOOLEAN
dirty = TRUE

SELECT CASE cmd
    CASE "save" WHERE dirty
        PRINT "saving..."
    CASE "save"
        PRINT "nothing to save"
    CASE "load"
        PRINT "loading..."
END SELECT
--- erwartet
saving...

