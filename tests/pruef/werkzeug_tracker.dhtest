IF bildNr = 3 THEN ladeDatei("qt.json")
IF bildNr = 4 THEN curC = 1 : instrumentEntfernen()
IF bildNr = 5 THEN curC = 0 : instrumentNeu()
IF bildNr = 6 THEN dateiPfad = "zurueck.json" : speichern(FALSE)

