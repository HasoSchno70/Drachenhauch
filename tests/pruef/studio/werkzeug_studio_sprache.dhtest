' Drachenhauch Studio: ein Projekt in zwei Sprachen (gefunden beim Port der
' Kuehlschrank-App, deren Einstellungen eine Sprache anboten). Vorher gab es
' keinen Weg: die Texte der Fenster, Menues und Berichte standen fest im
' erzeugten Code. Jetzt macht eine Tafel sprache/<code>.txt im Projektordner
' eine zweite Sprache daraus (studio/laufzeit.dh: SpracheWaehlen, tr$, trf$,
' studioTexte$, studioBerichtTexte$; studio/erzeugen.dh kopiert die Tafel
' nach assets/sprache/ und schickt Layout, Menues und Diagrammtitel durch
' die Laufzeit). Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== ein projekt mit tafel laeuft englisch deutsch und in der sprache der app
' F5 erzeugt das Programm, dann laeuft es dreimal: mit DHRT_LANG=en (die
' Vorgabe), ohne (die Sprache der Quelle) und mit einer Sprache, die die App
' selbst waehlt. Texte, die in der Tafel fehlen, schreibt die Laufzeit nach
' DH_STUDIO_SPRACHLUECKEN.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
slHin(10, 10)
slWarten(10)
slTaste(294)
slWarten(150)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_LAUF_BILDER", "20")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
PRINT "erzeugt "; LEN(slAnfang(log, "erzeugt ")) = 1
PRINT "tafel kopiert "; FILEEXISTS(p + "/_studio/assets/sprache/en.txt")
DIM basis AS STRING : basis = READALL(p + "/_studio/Hauptfenster_basis.dh")
PRINT "menue "; INSTR(basis, "studioTr$(!" + CHR$(34) + "Datei" + CHR$(34) + ")") >= 0; " kuerzel "; INSTR(basis, "studioKuerzel$(!" + CHR$(34) + "Strg+Q" + CHR$(34) + ")") >= 0; " diagramm "; INSTR(basis, "studioTr$(!" + CHR$(34) + "Anteile" + CHR$(34) + ")") >= 0

SUB lauf(wie AS STRING)
    PRINT "-- "; wie
    IF FILEEXISTS(p + "/_studio/liste.pdf") THEN DELETEFILE(p + "/_studio/liste.pdf")
    DIM k AS INTEGER : k = PROCESS_START("dhrt", "run", "--bilder", "40", p + "/_studio/main.dh")
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(k)
        IF t <> "" THEN
            DIM zeile AS STRING
            FOR EACH zeile IN SPLIT(REPLACE$(t, CHR$(13), ""), CHR$(10))
                IF zeile <> "" AND LEFT$(zeile, 8) <> "WARNING:" AND LEFT$(zeile, 5) <> "INFO:" THEN PRINT zeile
            NEXT
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(k) THEN
            leer = leer + 1
            SLEEP(30)
        END IF
    WEND
    DIM s AS STRING : s = JOIN$(pdfSeiten(p + "/_studio/liste.pdf"), "|")
    PRINT "bericht "; REPLACE$(s, CHR$(10), "|")
    ' Der Titel steht nur in den Angaben der Datei (PDF_TITLE).
    DIM roh AS STRING : roh = READALL(p + "/_studio/liste.pdf", "latin1")
    PRINT "titel "; IIF(INSTR(roh, "Shopping list") >= 0, "Shopping list", IIF(INSTR(roh, "Einkaufsliste") >= 0, "Einkaufsliste", "?"))
END SUB

DIM luecken AS STRING : luecken = CWD$() + "/luecken.txt"
SETENV("DH_STUDIO_SPRACHLUECKEN", luecken)
SETENV("DHRT_LANG", "en")
lauf("englisch")
PRINT "luecken "; REPLACE$(READALL(luecken), CHR$(10), "|")
SETENV("DHRT_LANG", "")
lauf("deutsch")
SETENV("PROBE_SPRACHE", "en")
lauf("die app waehlt")
--- argumente
{sammlung}/../../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
IMPORT "{sammlung}/../_hilfen/pdftext.dh"
slStudio = ARG$(0)
--- datei proj/projekt.dhstudio
