=== abstand rand und ausrichtung
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM z AS GUI_WIDGET : z = GUI_LAYOUT(w, "zeile", 10, 10, 400, 40)
GUI_LAYOUT_SET(z, "abstand", 0)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 0, 0, 40, 30)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "B", 0, 0, 100, 30)
DIM c AS GUI_WIDGET : c = GUI_BUTTON(w, "C", 0, 0, 50, 30)
GUI_LAYOUT_SET(z, "abstand", 8) : GUI_LAYOUT_SET(z, "rand", 5)
GUI_LAYOUT_SET(z, "dehnen", 0) : GUI_LAYOUT_SET(z, "ausrichtung", 1)
GUI_LAYOUT_ADD(z, a) : GUI_LAYOUT_ADD(z, b)
