=== der inspektor zeigt beim kind das gewicht, beim layout die anordnung
' Ein Kind hat kein Links/Oben (das Layout legt es), ein freies Layout schon:
' "lage feld x" kommt genau einmal, von Spalte1.
IMPORT "laeufer.dh"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 8, CWD$() + "/f.dhform")
DIM ax AS INTEGER
DIM ay AS INTEGER
DIM px AS INTEGER
DIM py AS INTEGER
(ax, ay) = slLage(m, "control knopfA")
(px, py) = slLage(m, "control Spalte1")
slHin(10, 10)
slKlick(ax, ay)
slWarten(6)
slKlick(px, py)
slWarten(6)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, CWD$() + "/f.dhform")
PRINT "gewicht "; LEN(slAnfang(log, "lage feld studio_gewicht ")) > 0
PRINT "anordnung "; LEN(slAnfang(log, "lage feld layout.art ")) > 0
PRINT "links einmal "; LEN(slAnfang(log, "lage feld x "))
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
