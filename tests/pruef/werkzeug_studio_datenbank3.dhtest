=== sortieren und bedingung im inspektor
' Die Tabelle liste hat die Datenquelle kunden: "Sortieren nach" bietet deren
' Spalten an (zweimal nach unten = ort), eine Bedingung mit einer Spalte, die
' es nicht gibt, meldet sich am Feld. Strg+S sichert beides.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
DIM log AS STRING : log = CWD$() + "/s.log"
DIM x AS INTEGER
DIM y AS INTEGER
slStarten(log, "", 8, p)
(x, y) = slLage(log, "knoten Hauptfenster.liste")
slHin(10, 10)
slWarten(10)
slKlick(x, y)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM sx AS INTEGER
DIM sy AS INTEGER
DIM bx AS INTEGER
DIM by AS INTEGER
DIM lx AS INTEGER
DIM ly AS INTEGER
(sx, sy) = slLage(log, "feld studio_sortieren")
(bx, by) = slLage(log, "feld studio_filter")
(lx, ly) = slLage(log, "knoten Hauptfenster.liste")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slKlick(lx, ly)
slWarten(10)
slKlick(sx, sy)
slWarten(6)
slTaste(264)
slTaste(264)
slTaste(257)
slWarten(10)
slKlick(bx, by)
slWarten(4)
slMit([341], 86)
slWarten(4)
slKlick(lx, ly)
slWarten(10)
slMit([341], 83)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_ABLAGE", "stadt = 1")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "filter ")
    PRINT z
NEXT
DIM j AS JSON_HANDLE : j = JSON_LOAD(p + "/Hauptfenster.dhform")
PRINT "sortieren "; JSON_GET_STRING(j, "widgets.0.studio_sortieren")
PRINT "bedingung "; JSON_GET_STRING(j, "widgets.0.studio_filter")
