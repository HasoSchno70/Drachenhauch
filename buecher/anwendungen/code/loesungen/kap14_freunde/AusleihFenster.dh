' Kapitel 14 -- das Ausleihfenster kennt nur noch die id des Eintrags;
' was es zeigt, fragt es die Datenbank.
CLASS AusleihFenster EXTENDS AusleihFenster_Basis
    DIM haupt AS Hauptfenster
    ' Der Eintrag, um den es gerade geht (0 = keiner).
    DIM id AS INTEGER
    DIM offen AS BOOLEAN

    SUB Geoeffnet()
        Self.offen = TRUE
        Self.anzeigen()
    END SUB

    SUB Schliessen()
        Self.offen = FALSE
    END SUB

    SUB folgen(eid AS INTEGER)
        Self.id = eid
        IF Self.offen THEN Self.anzeigen()
    END SUB

    SUB anzeigen()
        IF Self.id = 0 THEN
            GUI_SET_TEXT(Self.gewaehlt, "Kein Eintrag gewählt.")
            RETURN
        END IF
        DIM t AS STRING : t = titelVon$(Self.id)
        DIM bei AS STRING : bei = verliehenAn$(Self.id)
        IF bei = "" THEN
            GUI_SET_TEXT(Self.gewaehlt, t + " ist da.")
        ELSE
            GUI_SET_TEXT(Self.gewaehlt, t + " ist bei " + bei + ".")
        END IF
    END SUB

    SUB knopfVerleihen_Klick()
        DIM wer AS STRING : wer = TRIM$(GUI_TEXT(Self.feldAn))
        IF Self.id = 0 OR wer = "" THEN RETURN
        ' Wer etwas hat, gibt es erst zurueck.
        IF verliehenAn$(Self.id) <> "" THEN RETURN
        verleihen(Self.id, wer)
        Self.anzeigen()
    END SUB

    SUB knopfZurueck_Klick()
        IF Self.id = 0 THEN RETURN
        zurueckgeben(Self.id)
        Self.anzeigen()
    END SUB
END CLASS
