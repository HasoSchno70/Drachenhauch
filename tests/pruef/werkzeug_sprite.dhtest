    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
SUB prFall()
    DIM t AS INTEGER
    prStrich(1, 10, 4, 8)
    prKnopf(7, GUI_GET_X(bEbNeu), GUI_GET_Y(bEbNeu), 128)
    prStrich(13, 20, 24, 28)
    prKlick(19, GUI_GET_X(cbEbSicht) + 8, GUI_GET_Y(cbEbSicht) + 8)
    prKnopf(25, GUI_GET_X(bZuschnitt), GUI_GET_Y(bZuschnitt), 128)
    prAbspielen()
END SUB
