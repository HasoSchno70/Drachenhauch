=== sort ascending and descending flag
DIM x[5] AS INTEGER
x[0]=3 : x[1]=1 : x[2]=9 : x[3]=2 : x[4]=7
SORT(x)
PRINT x[0], x[1], x[2], x[3], x[4]
SORT(x, TRUE)
PRINT x[0], x[1], x[2], x[3], x[4]
--- erwartet
1 2 3 7 9
9 7 3 2 1

=== sort string descending
DIM s[3] AS STRING
s[0]="banana" : s[1]="apple" : s[2]="cherry"
SORT(s, TRUE)
PRINT s[0], s[1], s[2]
--- erwartet
cherry banana apple

=== sort with comparator funcref
FUNCTION desc(a AS INTEGER, b AS INTEGER) AS INTEGER
RETURN b - a
END FUNCTION
DIM x[5] AS INTEGER
x[0]=3 : x[1]=1 : x[2]=9 : x[3]=2 : x[4]=7
SORT(x, desc)
PRINT x[0], x[1], x[2], x[3], x[4]
DIM f AS FUNCREF
f = desc
DIM y[3] AS INTEGER
y[0]=5 : y[1]=8 : y[2]=2
SORT(y, f)
PRINT y[0], y[1], y[2]
--- erwartet
9 7 3 2 1
8 5 2

=== sort comparator stable by distance
FUNCTION bydist(a AS INTEGER, b AS INTEGER) AS INTEGER
RETURN ABS(a - 5) - ABS(b - 5)
END FUNCTION
DIM y[5] AS INTEGER
y[0]=3 : y[1]=1 : y[2]=9 : y[3]=2 : y[4]=7
SORT(y, bydist)
PRINT y[0], y[1], y[2], y[3], y[4]
--- erwartet
3 7 2 1 9

