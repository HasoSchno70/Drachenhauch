--- erwartet
probe.oxs: Vorschauprobe | 14x8 | farben 6 | stiche 99 | Open Cross Stitch (OXS) | 2.5 x 1.5 cm
farbe.oxs: Farbprobe | 12x9 | farben 9 | stiche 95 | Open Cross Stitch (OXS) | 2.2 x 1.6 cm
demo.oxs: Demo Kreuzstich | 40x40 | farben 6 | stiche 185 | Open Cross Stitch (OXS) | 7.3 x 7.3 cm
kaputt.oxs: fehler
kaputt.pat: fehler

=== kern: format, angaben, bildformate, zoombereich, thema
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(GLUTORDNER + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = ["A", "B", "C", "D"]
SUB patBauen()
DIM fa AS STRING : fa = phFarbe$("DMC", "310", "black", &H000000, ASC("X"))
fa = fa + phFarbe$("Foo", "9999", "Testgarn", &H0C2238, &H8A)
fa = fa + phFarbe$("DMC", "5200", "snow white", &HE6E6E6, ASC("X"))
' spaltenweise, 4 x 3: (0,0) voll Farbe 0 | 3 leer ueber die Spaltengrenze |
' (1,1) Viertel oben rechts + Dreiviertel unten links | (1,2) Viertel unten
' rechts | (2,0..2) voll Farbe 2 | (3,0) unbekannte Art | (3,1) Farbe 7 | (3,2) leer
DIM gi AS STRING : gi = phLauf$(1, 1, phStich$(0, 0, 5, 0, 1)) + phLeer$(3)
gi = gi + phLauf$(1, 2, phStich$(1, 1, 3, 1, 32) + phStich$(1, 1, 5, 2, 33))
gi = gi + phLauf$(1, 1, phStich$(1, 2, 9, 0, 34))
gi = gi + phLauf$(3, 1, phStich$(2, 0, 5, 2, 1))
gi = gi + phLauf$(1, 1, phStich$(3, 0, 5, 0, 7))
gi = gi + phLauf$(1, 1, phStich$(3, 1, 5, 7, 1)) + phLeer$(1)
DIM ru AS STRING : ru = phRueck$(0, 0, 1, 4, 3, 1, 0) + phRueck$(1, 1, 5, 2, 1, 6, 1) + phRueck$(2, 0, 3, 1, 2, 7, 2) + phRueck$(0, 0, 0, 1, 1, 1, 0)

DIM b AS BUFFER : b = phDatei("8", 4, 3, 16, "{\rtf1\ansi{\fonttbl{\f0\fnil Arial;}}\viewkind4\pard\f0\fs20 Erste Zeile\par Zweite \'e4 \{x\}\par}", "Probe", "Hans", 3, fa, gi, 4, ru, phNull$(14))
WRITEALL_BYTES("probe.pat", b)
END SUB
SUB xsdBauen()
DIM fa AS STRING : fa = xhFarbe$(0, "310", "Black", &H101010, FALSE, "")
fa = fa + xhFarbe$(1, "9403", "Schwarz " + CHR$(&HD7) + CHR$(&HE5), &H202020, TRUE, "")
fa = fa + xhFarbe$(252, "11", "", &H884444, FALSE, "0:310:1;0:321:2")
DIM sy AS ARRAY OF INTEGER : sy = [ASC("S"), &HFFFF, ASC("S")]
' zeilenweise, 4 x 3: voll Farbe 0 | Lauf 2 x Blend | leer | Teilstich-Satz 0 |
' Satz 1 | Lauf 4 leer | Perle (Farbe 1) | Farbe 9
DIM wo AS ARRAY OF INTEGER : wo = [&H00000000, &H40020000, &H00020000, &H0F000000, &H80000000, &H80010000, &H40040000, &H0F000000, &H00010000, &H00090000]
DIM st AS STRING : st = xhStiche$(wo, [&H12345678, &H0BADCAFE, &H31415926, &H27182818])
' Satz 0: halber Stich oben (Farbe 0) + Viertel oben rechts (Farbe 2); Satz 1: Petite unten rechts (Farbe 0)
DIM kl AS STRING : kl = "11000000000002000000" + "00080000000000000000"
' Knoten, Rueckstich, Spannstich, Kurve, Sonderstich, Perle, Rueckstich mit Farbe 9
DIM jo AS STRING : jo = ph16$(1) + "0000" + ph16$(3) + ph16$(1) + "00000000" + "00" + "00"
jo = jo + ph16$(2) + "0000" + ph16$(0) + ph16$(0) + ph16$(8) + ph16$(6) + "02" + "00"
jo = jo + ph16$(5) + "0000" + ph16$(2) + ph16$(2) + ph16$(4) + ph16$(2) + "00" + "00"
jo = jo + ph16$(3) + "000000" + ph16$(2) + "0100020003000400"
jo = jo + ph16$(4) + phNull$(23)
jo = jo + ph16$(6) + "0000" + ph16$(7) + ph16$(5) + "01" + "00" + ph16$(90)
jo = jo + ph16$(2) + "0000" + ph16$(0) + ph16$(0) + ph16$(2) + ph16$(0) + "09" + "00"

DIM b AS BUFFER : b = xhDatei(4, 3, 18, "Probe XSD", "Hans", "Notiz", 3, fa, sy, st, kl, 7, jo)
WRITEALL_BYTES("probe.xsd", b)
END SUB
patBauen()
xsdBauen()
DIM quelle AS kern.Muster : quelle = kern.pxsLaden("alle.pxs")
kern.oxsSpeichern(quelle, "probe.oxs")
WRITEALL("kaputt.pat", "PCStitch? nein")

' Formatname nach der Endung, fremde Endung ist ein Fehler
DIM d AS STRING
FOR EACH d IN ["a.xsd", "B.PAT", "c.oxs", "d.pxs", "ohne", "e.tar.oxs"]
    PRINT d; " '"; kern.fremdFormat$(d); "' | ";
NEXT
PRINT
TRY
    DIM f AS kern.MusterImport : f = kern.fremdLaden("notiz.txt", pal, sym)
CATCH e
    PRINT "notiz.txt: "; e
END TRY
' Die Angaben, wie der Dialog sie zeigt
PRINT JOIN$(kern.fremdInfo(kern.fremdLaden("probe.pat", pal, sym)), " | ")
PRINT JOIN$(kern.fremdInfo(kern.fremdLaden("probe.xsd", pal, sym)), " | ")
PRINT "warnungen: "; LEN(kern.fremdLaden("probe.pat", pal, sym).warnungen)
' Bildformate: die eigenen, dazu, was der Lader liest
PRINT "eigene: "; JOIN$(kern.bildEndungenEigen(), ",")
PRINT "ohne lader: "; JOIN$(kern.bildEndungen([]), ",")
PRINT "mit lader: "; JOIN$(kern.bildEndungen(["png", "tiff", "tif", "avif", "svg", "ico", "jxl"]), ",")
PRINT "umweg: "; kern.bildUeberGtk("a.PNG"); " "; kern.bildUeberGtk("b.tiff"); " "; kern.bildUeberGtk("c.avif"); " "; kern.bildUeberGtk("ohne")
PRINT "ablage: "; kern.ablageArt("x.avif"); " "; kern.ablageArtMit("x.avif", kern.bildEndungen(["avif"])); " "; kern.ablageArtMit("x.svg", kern.bildEndungen(["svg"])); " "; kern.ablageArtMit("x.PXS", [])
' Zoom-Regler: Bereich aus den Zellgroessen
DIM es AS kern.Einstellungen : es = NEW kern.Einstellungen()
DIM von AS INTEGER, bis AS INTEGER
(von, bis) = kern.zoomBereich(es)
PRINT "zoom vorgabe: "; von; " .. "; bis;
es.zelleStandard = 10 : es.zelleMin = 2 : es.zelleMax = 100
(von, bis) = kern.zoomBereich(es)
PRINT " | 10/2/100: "; von; " .. "; bis;
es.zelleStandard = 0 : es.zelleMin = 0 : es.zelleMax = 0
(von, bis) = kern.zoomBereich(es)
PRINT " | krumm: "; von; " .. "; bis
' Erscheinungsbild: die Tafel, die Definitionen, die Zuordnung
DIM t AS ARRAY OF STRING : t = kern.themaTafel()
PRINT "rollen: "; LEN(t) \ 3;
DIM dunkel AS ARRAY OF STRING : dunkel = SPLIT$(kern.stilFarben$(FALSE), CHR$(10))
DIM hell AS ARRAY OF STRING : hell = SPLIT$(kern.stilFarben$(TRUE), CHR$(10))
PRINT " | zeilen "; LEN(dunkel); " "; LEN(hell)
PRINT dunkel[0]; " / "; hell[0]
PRINT dunkel[LEN(dunkel) - 3]; " / "; hell[LEN(hell) - 3]
PRINT "zuordnung: "; HEX$(kern.themaFarbe(&H202228, TRUE)); " "; HEX$(kern.themaFarbe(&H202228, FALSE)); " "; HEX$(kern.themaFarbe(&HD6D9E1, TRUE)); " "; HEX$(kern.themaFarbe(&H123456, TRUE))
DIM doppelt AS INTEGER, i AS INTEGER, j AS INTEGER
FOR i = 0 TO LEN(t) - 1 STEP 3
    FOR j = i + 3 TO LEN(t) - 1 STEP 3
        IF t[i] = t[j] OR t[i + 1] = t[j + 1] THEN doppelt = doppelt + 1
    NEXT
NEXT
PRINT "doppelte namen oder dunkle farben: "; doppelt
' gemerkt und geprueft
es = NEW kern.Einstellungen()
PRINT "vorgabe: "; es.thema;
es.thema = "light"
WRITEALL("es.json", kern.einstellungenJson$(es))
PRINT " | gemerkt "; kern.einstellungenLaden("es.json").thema;
WRITEALL("krumm.json", "{" + CHR$(34) + "theme" + CHR$(34) + ": " + CHR$(34) + "blau" + CHR$(34) + "}")
PRINT " | krumm "; kern.einstellungenLaden("krumm.json").thema
