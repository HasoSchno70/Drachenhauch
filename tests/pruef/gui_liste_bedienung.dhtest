=== rechtsklick laesst eine mehrfachauswahl stehen, wenn die zeile dazugehoert
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM lb AS GUI_WIDGET : lb = GUI_LISTBOX(w, 10, 10, 280, 200, ["eins", "zwei", "drei", "vier"])
GUI_LISTBOX_SET(lb, "mehrfachauswahl", 1)
GUI_LISTBOX_SELECT(lb, 1, TRUE)
GUI_LISTBOX_SELECT(lb, 2, TRUE)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "zahl "; GUI_LISTBOX_SEL_COUNT(lb); " zweite "; GUI_LISTBOX_IS_SELECTED(lb, 1)
