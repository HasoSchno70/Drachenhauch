{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Drachenhauch",
  "scopeName": "source.drachenhauch",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.drachenhauch",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.drachenhauch",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.drachenhauch",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.drachenhauch",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "constant.numeric.hex.drachenhauch",
          "match": "\\b0[xX][0-9a-fA-F]+\\b|&[Hh][0-9a-fA-F]+"
        },
        {
          "name": "constant.numeric.binary.drachenhauch",
          "match": "\\b0[bB][01]+\\b|&[Bb][01]+"
        },
        {
          "name": "constant.numeric.drachenhauch",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.drachenhauch",
          "match": "(?i)\\b(FALSE|TRUE)\\b"
        },
        {
          "name": "storage.type.drachenhauch",
          "match": "(?i)\\b(COROUTINE|BOOLEAN|FUNCREF|INTEGER|STRING|ARRAY|FLOAT|IMAGE|SOUND|TUPLE|FILE|MAP|OF)\\b"
        },
        {
          "name": "keyword.declaration.drachenhauch",
          "match": "(?i)\\b(FUNCTION|OPERATOR|PROPERTY|EXTENDS|IMPORT|STATIC|STRUCT|BYREF|CLASS|CONST|ENUM|DIM|SUB|AS)\\b"
        },
        {
          "name": "keyword.control.drachenhauch",
          "match": "(?i)\\b(CONTINUE|FINALLY|PRIVATE|RESTORE|ELSEIF|REPEAT|RETURN|SELECT|BREAK|CATCH|INPUT|PRINT|THROW|UNTIL|WHERE|WHILE|YIELD|BAND|BNOT|BXOR|CASE|DATA|ELIF|ELSE|NEXT|READ|STEP|THEN|WEND|WITH|AND|BOR|END|FOR|MOD|NEW|NIL|NOT|SHL|SHR|TRY|IF|IN|IS|OR|TO)\\b"
        },
