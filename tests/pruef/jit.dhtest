=== rekursion bis zur grenze
FUNCTION tief(n AS INTEGER) AS INTEGER
    IF n = 0 THEN RETURN 0
    RETURN tief(n - 1) + 1
END FUNCTION
FUNCTION ewig(n AS INTEGER) AS INTEGER
    RETURN ewig(n + 1)
END FUNCTION
PRINT tief(900)
TRY
    PRINT ewig(0)
CATCH e
    PRINT LEFT$(e, 33)
END TRY
PRINT tief(10)
--- erwartet
900
Maximale Aufruftiefe (1000) ueber
10

