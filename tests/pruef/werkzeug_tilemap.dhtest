--- umgebung
DHRT_FRAMES=56
--- nachher
IMPORT "json"
DIM h AS JSON_HANDLE : h = JSON_LOAD("_programm/raus.json")
FUNCTION props$(ts AS INTEGER, id AS INTEGER) AS STRING
    DIM p AS STRING : p = "tilesets." + STR$(ts) + ".tiles"
    DIM r AS STRING : r = ""
    IF NOT JSON_HAS(h, p) THEN RETURN "{}"
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO JSON_LEN(h, p) - 1
        IF JSON_GET_INT(h, p + "." + STR$(i) + ".id") = id AND JSON_HAS(h, p + "." + STR$(i) + ".properties") THEN
            DIM q AS STRING : q = p + "." + STR$(i) + ".properties"
            FOR k = 0 TO JSON_LEN(h, q) - 1
                DIM e AS STRING : e = q + "." + STR$(k)
                DIM typ AS STRING : typ = JSON_GET_STRING(h, e + ".type")
                DIM w AS STRING
                IF typ = "int" THEN w = STR$(JSON_GET_INT(h, e + ".value"))
                IF typ = "float" THEN w = STR$(JSON_GET_FLOAT(h, e + ".value"))
                IF typ = "bool" THEN w = STR$(JSON_GET_BOOL(h, e + ".value"))
                IF typ = "string" THEN w = CHR$(34) + JSON_GET_STRING(h, e + ".value") + CHR$(34)
                IF r <> "" THEN r = r + ", "
                r = r + JSON_GET_STRING(h, e + ".name") + ": " + typ + " " + w
            NEXT
        END IF
    NEXT
    RETURN "{" + r + "}"
END FUNCTION
FUNCTION ebenen$() AS STRING
    DIM r AS STRING : r = ""
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(h, "layers") - 1
        IF r <> "" THEN r = r + ", "
        r = r + JSON_GET_STRING(h, "layers." + STR$(i) + ".name")
    NEXT
    RETURN r
END FUNCTION
FUNCTION gid(e AS INTEGER, x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM w AS INTEGER : w = JSON_GET_INT(h, "layers." + STR$(e) + ".width")
    RETURN JSON_GET_INT(h, "layers." + STR$(e) + ".data." + STR$(y * w + x))
END FUNCTION
FUNCTION tsVon$(g AS INTEGER) AS STRING
    ' Wie Tiled: das Tileset mit der GROESSTEN firstgid <= gid.
    DIM best AS INTEGER : best = -1
    DIM bestFg AS INTEGER : bestFg = -1
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(h, "tilesets") - 1
        DIM fg AS INTEGER : fg = JSON_GET_INT(h, "tilesets." + STR$(i) + ".firstgid")
        IF fg <= g AND fg > bestFg THEN best = i : bestFg = fg
    NEXT
    RETURN "(" + STR$(best) + ", " + STR$(g - bestFg) + ")"
END FUNCTION
FUNCTION objekte$(ebene AS STRING) AS STRING
    DIM r AS STRING : r = ""
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO JSON_LEN(h, "layers") - 1
        DIM l AS STRING : l = "layers." + STR$(i)
        IF JSON_GET_STRING(h, l + ".name") = ebene AND JSON_HAS(h, l + ".objects") THEN
            FOR k = 0 TO JSON_LEN(h, l + ".objects") - 1
                DIM o AS STRING : o = l + ".objects." + STR$(k)
                IF r <> "" THEN r = r + "; "
                r = r + JSON_GET_STRING(h, o + ".name") + "/" + JSON_GET_STRING(h, o + ".type") + " " + _
                    STR$(INT(JSON_GET_FLOAT(h, o + ".x"))) + "," + STR$(INT(JSON_GET_FLOAT(h, o + ".y"))) + " " + _
                    STR$(INT(JSON_GET_FLOAT(h, o + ".width"))) + "x" + STR$(INT(JSON_GET_FLOAT(h, o + ".height")))
            NEXT
        END IF
    NEXT
    RETURN r
END FUNCTION
PRINT objekte$("spawns")
--- erwartet
gegner/feind 0,0 16x16; gegner/feind 32,32 32x16

=== am anfang gibt es nur das eingebaute tileset
' Gegenprobe zum naechsten Fall: die firstgid steht bei 1.
DIM prBild AS INTEGER : prBild = 0
DIM prStart AS INTEGER : prStart = -1
DIM prF AS ARRAY OF INTEGER : prF = []
DIM prZ AS ARRAY OF STRING : prZ = []
DIM prFlag AS STRING : prFlag = ""
SUB prE(f AS INTEGER, typ AS INTEGER, a AS INTEGER, b AS INTEGER)
    ARRAY_PUSH(prF, f)
    ARRAY_PUSH(prZ, STR$(typ) + " " + STR$(a) + " " + STR$(b) + " 0 0")
END SUB
SUB prKlick(f AS INTEGER, x AS INTEGER, y AS INTEGER)
    prE(f, 7, x, y)
    prE(f + 1, 7, x, y)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 5, 0, 0)
END SUB
SUB prZiehen(f AS INTEGER, x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER)
    prE(f, 7, x1, y1)
    prE(f + 1, 7, x1, y1)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 7, x2, y2)
    prE(f + 2, 6, 0, 0)
    prE(f + 3, 7, x2, y2)
    prE(f + 4, 5, 0, 0)
END SUB
FUNCTION prKx(px AS INTEGER) AS INTEGER
    RETURN GUI_CANVAS_X(leinwand) + px * zoom
END FUNCTION
FUNCTION prKy(py AS INTEGER) AS INTEGER
    RETURN GUI_CANVAS_Y(leinwand) + py * zoom
END FUNCTION
SUB prAbspielen()
    ' Ein Ereignis in Bild 0 -- die Wiedergabe setzt beim ERSTEN an.
    prE(0, 7, 0, 0)
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM weiter AS BOOLEAN
    DIM tf AS INTEGER
    DIM tz AS STRING
    FOR i = 1 TO LEN(prF) - 1
        j = i
        weiter = TRUE
        WHILE weiter
            weiter = FALSE
            IF j > 0 THEN
                IF prF[j - 1] > prF[j] THEN
                    tf = prF[j] : prF[j] = prF[j - 1] : prF[j - 1] = tf
                    tz = prZ[j] : prZ[j] = prZ[j - 1] : prZ[j - 1] = tz
                    j = j - 1
                    weiter = TRUE
                END IF
            END IF
        WEND
    NEXT
    DIM t AS STRING : t = "# Test-Aufnahme" + CHR$(10) + "c " + STR$(LEN(prF)) + CHR$(10)
    FOR i = 0 TO LEN(prF) - 1
        t = t + "e " + STR$(prF[i]) + " " + prZ[i] + CHR$(10)
    NEXT
    WRITEALL("ev.txt", t)
    AUTOMATION_PLAY("ev.txt")
    prStart = prBild
END SUB
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
SUB prFall()

    prStart = prBild
END SUB
SUB prProbe()
    prSchreib("tsAnz " + STR$(tsAnz) + " tsAkt " + STR$(tsAkt) + " basisGid " + STR$(basisGid()))
END SUB
