' Fremde Bibliotheken aufrufen: DECLARE ... LIB (docs/entwurf-ffi.md, Stufen 1 bis 3).
' Geprueft wird gegen Bibliotheken, die ueberall da sind: unter Windows
' kernel32/user32, sonst und auch unter Windows die C-Bibliothek ("c", "m" --
' ucrtbase, glibc, libSystem). Jeder Typ der DECLARE-Zeile kommt mindestens
' einmal vor; die Breiten im Einzelnen pruefen die Rust-Tests in ffi.rs.

=== kernel32 rechnet mit LONG und liefert ULONG und INTEGER
DECLARE FUNCTION GetCurrentProcessId LIB "kernel32" () AS ULONG
DECLARE FUNCTION MulDiv LIB "kernel32" (zahl AS LONG, mal AS LONG, durch AS LONG) AS LONG
DECLARE FUNCTION GetTickCount64 LIB "kernel32" () AS INTEGER
DECLARE FUNCTION GetSystemMetrics LIB "user32" (n AS LONG) AS LONG
PRINT GetCurrentProcessId() > 0
PRINT MulDiv(10, 6, 4)
' MulDiv rundet weg von der Null -- ein falsch erweitertes Vorzeichen gaebe
' hier eine riesige Zahl.
PRINT MulDiv(-7, 3, 2)
PRINT GetTickCount64() > 0
PRINT TYPEOF(GetSystemMetrics(0)), GetSystemMetrics(0) >= 0
--- system windows
--- erwartet
TRUE
15
-11
TRUE
INTEGER TRUE

