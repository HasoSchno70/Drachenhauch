' Kuehlschrank-App im Drachenhauch Studio, Stufe 2: die Lagerorte
' (examples/studio/kuehlschrank: LagerorteSeite mit Kacheln auf einer
' Zeichenflaeche, LagerortFenster, Modul Lagerorte, Klasse Ort, die
' Ablageliste rechts im Bestand). Proben wie in Stufe 1: F5 im Studio, dann
' main.dh mit einer Probe statt der Bildschleife; Heute ist fest.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== kacheln: anzahl, abgelaufen, bald, farbe und sinnbild wie die python-app
' Farbe und Sinnbild wie LocationSettingsManager: location_settings mit
' gleichem Namen (Garage), dann ein Stichwort darin (kammer in
' Speisekammer), dann die eingebauten Stichwoerter in ihrer Reihenfolge
' (Kuehlschrank ist kuehl, nicht schrank), sonst Stahlblau mit Paket.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch'), ('Butter'), ('Eis'), ('Schrauben')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location, storage_area) VALUES (1, 1, 'Liter', '2026-11-01', 'Kühlschrank', 'oben'), (2, 1, 'Stück', '2026-11-10', 'Kühlschrank', NULL), (3, 2, 'Packung', '2027-01-01', 'Gefrierschrank', NULL), (4, 5, 'Stück', NULL, 'Garage', NULL)")
DB_EXEC(db, "INSERT INTO location_settings (keyword, color_r, color_g, color_b, icon) VALUES ('Garage', 10, 20, 30, '🚗'), ('kammer', 200, 100, 50, '🥫')")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
DIM o AS Ort
FOR EACH o IN f.orte.orte
    PRINT "  "; o.name; " | "; o.sinnbild; " | "; COLOR_HEX$(o.farbe); " | "; o.anzahl; " "; o.abgelaufen; " "; o.bald; " | "; IIF(o.zone = "", "-", o.zone + " " + zoneText$(o.zone))
NEXT
PRINT "spalten "; f.orte.spalten(); " | rollen bis "; f.orte.rollenMax()
PRINT "treffer "; f.orte.karteBei(30, 30); " "; f.orte.karteBei(20 + 275 + 5, 30); " "; f.orte.karteBei(20 + 275, 20 + 195 + 10); " "; f.orte.karteBei(5, 5); " "; f.orte.karteBei(20 + 260 + 3, 30)
f.orte.flaeche_Rad(-1.0)
PRINT "rad "; f.orte.rollen; " "; f.orte.karteBei(30, 30); " "; f.orte.karteBei(30, 90)
f.orte.flaeche_Rad(-5.0)
PRINT "rad "; f.orte.rollen; " "; f.orte.karteBei(30, 150)
f.orte.flaeche_Rad(9.0)
PRINT "rad "; f.orte.rollen
PRINT "ziele "; JOIN$(f.bestand.ziele, " / ")
PRINT "liste "; GUI_LISTBOX_COUNT(f.bestand.ablageListe); " | "; GUI_LISTBOX_ITEM(f.bestand.ablageListe, 0); " | "; GUI_LISTBOX_ITEM(f.bestand.ablageListe, 1)
--- erwartet
geprueft TRUE
  Kühlschrank | 🧊 | #3498DB | 2 1 1 | cold kühl
  Gefrierschrank | ❄️ | #9B59B6 | 1 0 0 | frozen tiefgekühlt
  Vorratsraum | 🏠 | #E67E22 | 0 0 0 | room_temp Raumtemperatur
  Gemüsefach | 🥕 | #2ECC71 | 0 0 0 | cold kühl
  Obstschale | 🍎 | #2ECC71 | 0 0 0 | room_temp Raumtemperatur
  Speisekammer | 🥫 | #C86432 | 0 0 0 | cool kühl und dunkel
  Kühlschranktür | 🧊 | #3498DB | 0 0 0 | cold kühl
  Brotkasten | 🍞 | #E67E22 | 0 0 0 | room_temp Raumtemperatur
  Gewürzregal | 📦 | #4682B4 | 0 0 0 | room_temp Raumtemperatur
  Garage | 🚗 | #0A141E | 1 0 0 | -
spalten 4 | rollen bis 82
treffer 0 1 5 -1 -1
rad 60 0 0
rad 82 4
rad 0
ziele Kühlschrank / Kühlschrank · oben / Gefrierschrank / Vorratsraum / Gemüsefach / Obstschale / Speisekammer / Kühlschranktür / Brotkasten / Gewürzregal / Garage
liste 11 | 🧊  Kühlschrank |         › oben
code 0

=== verlegen ist ein schritt, das ziel setzt auch den bereich
' Wie die Seitenleiste der Python-App: der Ort mit Bereich setzt beides, der
' Ort allein leert den Bereich. Schon dort = nichts zu tun, kein Schritt.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch'), ('Butter')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location, storage_area) VALUES (1, 1, 'Liter', '2026-11-20', 'Kühlschrank', 'oben'), (2, 1, 'Stück', '2026-11-21', 'Kühlschrank', NULL)")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
FUNCTION lage$() AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT GROUP_CONCAT(id || ':' || storage_location || ':' || IFNULL(storage_area, '-'), ' ') FROM (SELECT * FROM inventory ORDER BY id)")
    DIM t AS STRING : t = ""
    IF DB_NEXT(r) THEN t = DB_GET_STRING(r, 0)
    RETURN t
END FUNCTION
PRINT "start "; lage$()
PRINT "butter nach oben "; verlegen(eintragLaden(2), "Kühlschrank · oben"); " | "; lage$(); " | "; verlauf.textZurueck$()
PRINT "nochmal "; verlegen(eintragLaden(2), "Kühlschrank · oben"); " | "; verlauf.textZurueck$()
PRINT "milch ins gefrierfach "; verlegen(eintragLaden(1), "Gefrierschrank"); " | "; lage$()
f.geaendert()
PRINT "kacheln "; f.orte.orte[0].name; " "; f.orte.orte[0].anzahl; " | "; f.orte.orte[1].name; " "; f.orte.orte[1].anzahl
f.miRueckgaengig_Aktion()
PRINT "zurueck "; lage$(); " | "; f.orte.orte[0].anzahl; " "; f.orte.orte[1].anzahl
f.miRueckgaengig_Aktion()
PRINT "zurueck "; lage$()
f.miWiederholen_Aktion()
PRINT "vor "; lage$(); " | "; GUI_STATUSBAR_TEXT$(f.status, 3)
--- erwartet
start 1:Kühlschrank:oben 2:Kühlschrank:-
butter nach oben TRUE | 1:Kühlschrank:oben 2:Kühlschrank:oben | Butter → Kühlschrank · oben
nochmal FALSE | Butter → Kühlschrank · oben
milch ins gefrierfach TRUE | 1:Gefrierschrank:- 2:Kühlschrank:oben
kacheln Kühlschrank 1 | Gefrierschrank 1
zurueck 1:Kühlschrank:oben 2:Kühlschrank:oben | 2 0
zurueck 1:Kühlschrank:oben 2:Kühlschrank:-
vor 1:Kühlschrank:oben 2:Kühlschrank:oben | Wiederholt: Butter → Kühlschrank · oben
code 0

=== details: entnehmen nimmt ein stueck, das letzte ist verbraucht
' Die Frage beantwortet Enter aus einer Aufnahme (erster Knopf).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slTaste(257)
slWarten(30)
slTaste(257)
slAufnahmeSchreiben(p + "/_studio/enter.txt")
PRINT "code "; kProbe(p, "probe.dh", "enter.txt", 120)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO products (name, brand) VALUES ('Milch', 'Hof'), ('Butter', NULL), ('Eis', NULL)")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location, storage_area) VALUES (1, 2, 'Liter', '2026-11-01', 'Kühlschrank', 'oben'), (2, 1, 'Stück', '2026-11-10', 'Kühlschrank', NULL), (3, 1, 'Packung', '2027-01-01', 'Gefrierschrank', NULL)")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
DIM lf AS LagerortFenster : lf = NEW LagerortFenster()
lf.ort = "Kühlschrank"
lf.Zeigen()
SUB zeilen(lf AS LagerortFenster)
    DIM z AS INTEGER
    FOR z = 0 TO GUI_TABLE_ROW_COUNT(lf.tabelle) - 1
        PRINT "  "; GUI_TABLE_GET_CELL(lf.tabelle, z, 0); " | "; GUI_TABLE_GET_CELL(lf.tabelle, z, 1); " | "; GUI_TABLE_GET_CELL(lf.tabelle, z, 2); " | "; GUI_TABLE_GET_CELL(lf.tabelle, z, 3); " | "; GUI_TABLE_GET_CELL(lf.tabelle, z, SP_ORT_STATUS); " | "; GUI_TABLE_GET_CELL(lf.tabelle, z, SP_ENTNEHMEN)
    NEXT
    PRINT "  "; GUI_TEXT(lf.info)
END SUB
PRINT "titel "; GUI_TEXT(lf.titel)
zeilen(lf)
lf.tabelle_Zelle(0, SP_ENTNEHMEN)
PRINT "milch"
zeilen(lf)
lf.tabelle_Zelle(1, SP_ENTNEHMEN)
PRINT "butter"
zeilen(lf)
PRINT "verbraucht "; dbZahl("SELECT COUNT(*) FROM consumption_history WHERE reason = 'consumed'"); " | geaendert "; lf.geaendert; " | "; verlauf.textZurueck$()
f.miRueckgaengig_Aktion()
lf.laden()
PRINT "zurueck"
zeilen(lf)
--- erwartet
titel 🧊  Kühlschrank
  Milch | Hof | 2 Liter | oben | Abgelaufen | Entnehmen
  Butter | - | 1 Stück | - | 2 Tage | Entnehmen
  📦 2 Einträge an diesem Lagerort
milch
  Milch | Hof | 1 Liter | oben | Abgelaufen | Entnehmen
  Butter | - | 1 Stück | - | 2 Tage | Entnehmen
  📦 2 Einträge an diesem Lagerort
butter
  Milch | Hof | 1 Liter | oben | Abgelaufen | Entnehmen
  📦 1 Eintrag an diesem Lagerort
verbraucht 1 | geaendert TRUE | Butter verbraucht
zurueck
  Milch | Hof | 1 Liter | oben | Abgelaufen | Entnehmen
  Butter | - | 1 Stück | - | 2 Tage | Entnehmen
  📦 2 Einträge an diesem Lagerort
code 0

=== echt: zeile auf einen ort ziehen, strg+z, kachel anklicken, entnehmen
' Ein erster Lauf misst (Tabelle, Eintrag der Ablageliste, Kopf des Reiters,
' Zeichenflaeche, die Tabelle im Dialog), ein zweiter spielt ab: Milch aus
' der Tabelle auf "Gefrierschrank" ziehen, Strg+Z, Reiter Lagerorte, Klick
' auf die Kachel Kuehlschrank, im Dialog "Entnehmen" in Milchs Zeile, Enter
' fuer die Frage, ESC schliesst den Dialog -- dann geht der Klick auf den
' Reiter Bestand wieder durch.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 12)
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
FUNCTION z(i AS INTEGER) AS INTEGER
    RETURN INT(VAL(w[i]))
END FUNCTION
DIM zy AS INTEGER : zy = z(1) + z(2) + z(3) \ 2
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slZug(z(0) + kSpalteMitte(p, "BestandSeite", "tabelle", 0), zy, z(4), z(5), 8, TRUE)
slWarten(10)
slMit([341], 90)
slWarten(10)
slKlick(z(6), z(7))
slWarten(10)
slKlick(z(8) + 20 + 130, z(9) + 20 + 90)
slWarten(20)
slKlick(z(10) + kSpalteMitte(p, "LagerortFenster", "tabelle", 6), z(11) + z(12) + z(13) \ 2)
slWarten(15)
slTaste(257)
slWarten(15)
slTaste(256)
slWarten(10)
slKlick(z(14), z(15))
slWarten(10)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 20)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei daten.dh
' Messlauf und Abspiellauf teilen die Datei: jedes Mal frisch.
DB_EXEC(db, "DELETE FROM inventory")
DB_EXEC(db, "DELETE FROM products")
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch'), ('Butter')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date, storage_location) VALUES (1, 2, 'Liter', '2026-11-20', 'Kühlschrank'), (2, 1, 'Stück', '2026-11-21', 'Kühlschrank')")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
--- datei mess.dh
IMPORT "../../daten.dh"
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
DIM lb AS GUI_WIDGET : lb = f.bestand.ablageListe
DIM li AS INTEGER : li = ARRAY_INDEXOF(f.bestand.ziele, "Gefrierschrank")
DIM lx AS INTEGER, ly AS INTEGER, lw AS INTEGER, lh AS INTEGER
(lx, ly, lw, lh) = GUI_LISTBOX_ITEM_RECT(lb, li)
DIM rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER
(rx, ry, rw, rh) = GUI_TABCONTROL_ITEM_RECT(f.reiter, 1)
DIM r0x AS INTEGER, r0y AS INTEGER, r0w AS INTEGER, r0h AS INTEGER
(r0x, r0y, r0w, r0h) = GUI_TABCONTROL_ITEM_RECT(f.reiter, 0)
DIM lf AS LagerortFenster : lf = NEW LagerortFenster()
lf.ort = "Kühlschrank"
lf.Zeigen()
n = 0
WHILE n < 3 AND studioBild()
    n = n + 1
WEND
' Der Inhalt des Dialogs beginnt unter seiner Titelleiste.
DIM dx AS INTEGER : dx = GUI_WINDOW_GET_X(lf.Fenster()) + GUI_GET_X(lf.tabelle)
DIM dy AS INTEGER : dy = GUI_WINDOW_GET_Y(lf.Fenster()) + GUI_METRIC_GET("title_h") + GUI_GET_Y(lf.tabelle)
WRITEALL("lage.txt", STR$(GUI_GET_X(f.bestand.tabelle)) + " " + STR$(GUI_GET_Y(f.bestand.tabelle) + 26) + " " + STR$(INT(GUI_TABLE_GET(f.bestand.tabelle, "kopfhoehe"))) + " " + STR$(INT(GUI_TABLE_GET(f.bestand.tabelle, "zeilenhoehe"))) + " " + _
    STR$(lx + lw \ 2) + " " + STR$(ly + lh \ 2) + " " + STR$(rx + rw \ 2) + " " + STR$(ry + rh \ 2) + " " + STR$(GUI_CANVAS_X(f.orte.flaeche)) + " " + STR$(GUI_CANVAS_Y(f.orte.flaeche)) + " " + _
    STR$(dx) + " " + STR$(dy) + " " + STR$(INT(GUI_TABLE_GET(lf.tabelle, "kopfhoehe"))) + " " + STR$(INT(GUI_TABLE_GET(lf.tabelle, "zeilenhoehe"))) + " " + STR$(r0x + r0w \ 2) + " " + STR$(r0y + r0h \ 2))
PRINT "dialog trifft "; GUI_HIT_TEST(dx + 5, dy + 5) = lf.tabelle
--- datei klick.dh
IMPORT "../../daten.dh"
FUNCTION milch$() AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT storage_location || ' ' || quantity FROM inventory WHERE id = 1")
    IF DB_NEXT(r) THEN RETURN DB_GET_STRING(r, 0)
    RETURN "-"
END FUNCTION
DIM stand AS ARRAY OF STRING : stand = []
DIM war AS STRING : war = ""
WHILE studioBild()
    DIM jetzt AS STRING : jetzt = milch$() + " / Seite " + STR$(GUI_TABCONTROL_PAGE(f.reiter))
    IF jetzt <> war THEN ARRAY_PUSH(stand, jetzt)
    war = jetzt
WEND
PRINT "milch "; JOIN$(stand, " -> ")
PRINT "kachel "; f.orte.gewaehlterOrt; " | "; f.orte.orte[0].name; " "; f.orte.orte[0].anzahl; " | "; GUI_STATUSBAR_TEXT$(f.status, 3)
PRINT "zurueck "; verlauf.textZurueck$(); " | vor ["; verlauf.textVor$(); "]"
--- erwartet
dialog trifft TRUE
milch Kühlschrank 2.0 / Seite 0 -> Gefrierschrank 2.0 / Seite 0 -> Kühlschrank 2.0 / Seite 0 -> Kühlschrank 2.0 / Seite 1 -> Kühlschrank 1.0 / Seite 1 -> Kühlschrank 1.0 / Seite 0
kachel Kühlschrank | Kühlschrank 2 | Rückgängig: Milch → Gefrierschrank
zurueck Milch: 1 Liter | vor []
code 0
