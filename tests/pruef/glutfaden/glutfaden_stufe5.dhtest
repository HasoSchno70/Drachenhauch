=== html: wie pysticky beim probemuster
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Die Beilagen (.ref) hat PyStickys HTMLExporter mit festem Datum geschrieben
' (ref_html.py). Verglichen wird Zeile fuer Zeile; einzige Absicht: der Fuss
' nennt Glutfaden.
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
DIM o AS kern.HtmlOptionen : o = NEW kern.HtmlOptionen()
o.datum = "16.10.2026" : o.paletten = pal

kern.htmlExportieren(m, "probe", o)
PRINT geAbweichungen$(geLies$("probe.html.ref"), geLies$("probe.html"))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"

