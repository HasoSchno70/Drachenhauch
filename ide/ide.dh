GUI_WINDOW_VISIBLE(winUmbau, FALSE)
GUI_WINDOW_RESIZABLE(winUmbau, TRUE)
DIM lblUmbau AS GUI_WIDGET : lblUmbau = GUI_LABEL(winUmbau, "", 8, 8)
' Links die betroffenen Dateien mit Kaestchen: was man abwaehlt, bleibt
' stehen. Ein Umbau ueber zwoelf Dateien ist selten in allen zwoelf
' gemeint, und "alles oder nichts" heisst dann: von Hand nacharbeiten.
DIM lstUmbau AS GUI_WIDGET : lstUmbau = GUI_LISTBOX(winUmbau, 8, 30, 220, 508, [])
DIM taUmbau AS GUI_WIDGET : taUmbau = GUI_TEXTAREA(winUmbau, 236, 30, 656, 508)
' Der Unterschied ist Code: dicktengleich und in fester Codegroesse, damit er
' nicht mit der Schrift der Oberflaeche waechst (die Zeilen standen sonst
' woanders, als man sie aus dem Code-Feld kennt).
IF codeFont >= 0 THEN GUI_SET_FONT(taUmbau, codeFont)
GUI_SET_FONT_SIZE(taUmbau, 16)
DIM btnUmbauOk AS GUI_WIDGET : btnUmbauOk = GUI_BUTTON(winUmbau, tr$("Übernehmen"), 8, 546, 140, 30)
GUI_BUTTON_VARIANT(btnUmbauOk, "primaer")
DIM btnUmbauWeg AS GUI_WIDGET : btnUmbauWeg = GUI_BUTTON(winUmbau, tr$("Abbrechen"), 158, 546, 120, 30)
DIM btnUmbauBlock AS GUI_WIDGET
btnUmbauBlock = GUI_BUTTON(winUmbau, tr$("Block auslassen / aufnehmen"), 288, 546, 230, 30)
DIM btnUmbauPruef AS GUI_WIDGET
btnUmbauPruef = GUI_BUTTON(winUmbau, tr$("Prüfen"), 528, 546, 110, 30)
GUI_LISTBOX_SET(lstUmbau, "kaestchen", 1)
' Beim Ziehen am Griff waechst der Unterschied mit (vorher blieb der Inhalt
' stehen, das Fenster war nur scheinbar groessenveraenderbar).
GUI_SET_ANCHOR(lstUmbau, "ltb")
GUI_SET_ANCHOR(taUmbau, "lrtb")
GUI_SET_ANCHOR(btnUmbauOk, "lb") : GUI_SET_ANCHOR(btnUmbauWeg, "lb")
GUI_SET_ANCHOR(btnUmbauBlock, "lb") : GUI_SET_ANCHOR(btnUmbauPruef, "lb")
GUI_WINDOW_DEFAULT(winUmbau, btnUmbauOk)
GUI_WINDOW_CANCEL(winUmbau, btnUmbauWeg)
' Der anstehende Umbau: je Eintrag ein Reiter ODER eine Datei auf der Platte.
' Reiter werden ueber Auswahl+INSERT geschrieben (EIN Undo-Schritt), Dateien
' geschrieben und der offene Reiter nachgezogen -- genau die zwei Wege, die
' es vorher schon gab.
CLASS UmbauZiel
    DIM tab AS INTEGER              ' der Reiter, -1 = eine Datei auf der Platte
    DIM pfad AS STRING
    DIM text AS STRING              ' was hineinkommt
    SUB Init(t AS INTEGER, p AS STRING, x AS STRING)
        tab = t : pfad = p : text = x
    END SUB
END CLASS
DIM umbauZiele AS ARRAY OF UmbauZiel : umbauZiele = []
DIM umbauMeldung AS STRING : umbauMeldung = ""
DIM umbauProt AS STRING : umbauProt = ""
' Ein Einwand gegen den Umbau (leer = keiner). Er steht OBEN in der
' Vorschau und schaltet sie ein, auch wenn sie abgeschaltet ist: wer einen
' Einwand nur in die Statuszeile schreibt, hat ihn nicht vorgebracht.
' Was VOR dem letzten geschriebenen Umbau in den Dateien stand -- damit
' er sich in EINEM Zug zuruecknehmen laesst. Strg+Z im Code-Feld nimmt nur
' den Reiter zurueck, in dem man gerade steht; ein Umbau ueber sechs
' Dateien waere damit sechsmal zurueckzunehmen, und zwar in sechs Reitern,
' die man dafuer erst oeffnen muss.
' Ein STAPEL, kein einzelner Stand: wer zwei Umbauten hintereinander
' macht und beide zurueckwill, kaeme mit einem nur bis zur Haelfte.
' Je Umbau ein UmbauStand. Bis 2026-10-30 lagen alle Umbauten
' hintereinander in vier Feldern mit einer Grenzliste (`zurAnzahl`) -- "ein
' Feld von Feldern gibt es nicht"; eine Klasse kann Felder halten.
CONST ZUR_MAX = 10
CLASS UmbauStand
    DIM name AS STRING              ' was der Umbau war ("umbenannt ...")
    DIM tabs AS ARRAY OF INTEGER
    DIM pfade AS ARRAY OF STRING
    DIM vorher AS ARRAY OF STRING
    ' Was der Umbau GESCHRIEBEN hat: steht in einer Datei inzwischen etwas
    ' anderes, wurde sie danach geaendert -- dann nimmt das Zuruecknehmen
    ' nichts zurueck, sonst waere die spaetere Arbeit wortlos weg.
    DIM nachher AS ARRAY OF STRING

    SUB Init(n AS STRING)
        ' Jedes Objekt bekommt EIGENE Listen -- gemeinsame waeren ein
        ' Vorrat, in dem jeder Umbau alle anderen mitveraendert.
        name = n : tabs = [] : pfade = [] : vorher = [] : nachher = []
    END SUB

    SUB dazu(tab AS INTEGER, pfad AS STRING, vor AS STRING, nach AS STRING)
        ARRAY_PUSH(tabs, tab) : ARRAY_PUSH(pfade, pfad)
        ARRAY_PUSH(vorher, vor) : ARRAY_PUSH(nachher, nach)
    END SUB

    FUNCTION anzahl() AS INTEGER
        RETURN LEN(tabs)
    END FUNCTION
END CLASS
DIM zurStapel AS ARRAY OF UmbauStand : zurStapel = []
' Zurueckgenommene Umbauten, zum Wiederholen. Ein neuer Umbau leert sie.
DIM wdhStapel AS ARRAY OF UmbauStand : wdhStapel = []
' Der zuletzt UEBERNOMMENE Umbau, damit er sich nachbessern laesst: die
' Schritte (`op*`) stehen ohnehin noch, hier die Dateien dazu.
DIM umbauNach AS ARRAY OF UmbauZiel : umbauNach = []    ' nur Reiter und Pfad
DIM umbauNachWas AS STRING : umbauNachWas = ""
DIM umbauWarnung AS STRING : umbauWarnung = ""
' Was das Pruefen gefunden hat -- je Zeile "datei:zeile: meldung". Steht
' oben im Unterschied, damit man nicht zwischen Zahl und Ursache raten muss.
DIM umbauBefunde AS ARRAY OF STRING : umbauBefunde = []
DIM umbauZeile AS INTEGER : umbauZeile = 0
DIM umbauSpalte AS INTEGER : umbauSpalte = 1

' --- Befehlspalette / Datei-Waehler
' auch der Waehler fuer "Datei im Projekt oeffnen" (paletteArt = "datei").
DIM winPalette AS GUI_WINDOW : winPalette = GUI_WINDOW(tr$("Befehle"), 400, 80, 440, 340)
DIM tfPalette AS GUI_WIDGET : tfPalette = GUI_TEXTINPUT(winPalette, 8, 8, 424, 26, "")
DIM lstPalette AS GUI_WIDGET : lstPalette = GUI_LISTBOX(winPalette, 8, 40, 424, 260, [])
GUI_WINDOW_VISIBLE(winPalette, FALSE)
DIM paletteOffen AS BOOLEAN : paletteOffen = FALSE
DIM paletteArt AS STRING : paletteArt = "befehl"
DIM paletteLetzterFilter AS STRING : paletteLetzterFilter = "-"
' Ein Befehl der Palette. Name SUB befehl gibt es schon -- darum
' BefehlEintrag. `vorgabe` ist das Kuerzel ohne tasten.json (bis
' 2026-10-30 ein eigenes Feld befehlKuerzelVorgabe daneben).
CLASS BefehlEintrag
    DIM name AS STRING
    DIM kennung AS STRING
    DIM kuerzel AS STRING
    DIM vorgabe AS STRING
    SUB Init(n AS STRING, k AS STRING, kz AS STRING)
        name = n : kennung = k : kuerzel = kz : vorgabe = kz
    END SUB
END CLASS
DIM befehle AS ARRAY OF BefehlEintrag : befehle = []

FUNCTION befehlNr(kennung AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(befehle) - 1
        IF befehle[i].kennung = kennung THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Ein Eintrag des Waehlers (Befehle, Dateien, Schnipsel, Korrekturen ...):
' was dasteht, was gewaehlt wird, der Zusatz rechts und die Form ohne
' Umlaute fuer die Suche (einmal je Eintrag gerechnet, nicht je Taste).
CLASS WaehlerEintrag
    DIM name AS STRING
    DIM kennung AS STRING
    DIM detail AS STRING
    DIM norm AS STRING
    SUB Init(n AS STRING, k AS STRING, d AS STRING)
        name = n : kennung = k : detail = d
    END SUB
END CLASS
DIM waehlerListe AS ARRAY OF WaehlerEintrag : waehlerListe = []

SUB waehlerDazu(name AS STRING, kennung AS STRING, detail AS STRING)
    ARRAY_PUSH(waehlerListe, NEW WaehlerEintrag(name, kennung, detail))
END SUB

FUNCTION waehlerNr(kennung AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(waehlerListe) - 1
        IF waehlerListe[i].kennung = kennung THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION
' Zusatztext je Eintrag (Kuerzel, Ordner) -- rechts in der Liste, nicht an den Namen gehaengt.
DIM paletteSichtbar AS ARRAY OF STRING : paletteSichtbar = []

