' Der Debugger `dhrt debug`: Kommandos als JSON-Zeilen auf stdin, Ereignisse
' (paused/output/eval-result/error/finished) als JSON-Zeilen auf stdout.
' Bis Stufe 52 (2026-09-14) tests/test_dhrt_debug.py; hier treibt
' _hilfen/debugsitzung.dh die Sitzung per PROCESS_START und liest die
' Ereignisse mit dem json-Modul.
' Format: docs/werkzeuge.md, dhrt test.

=== haltepunkt globale auswertung stopp
IMPORT "sitzung.dh"
sitzung("d.dh", ["{" + CHR$(34) + "cmd" + CHR$(34) + ":" + CHR$(34) + "set-breakpoints" + CHR$(34) + "," + CHR$(34) + "lines" + CHR$(34) + ":[3]}", _
    "{" + CHR$(34) + "cmd" + CHR$(34) + ":" + CHR$(34) + "continue" + CHR$(34) + "}", _
    "{" + CHR$(34) + "cmd" + CHR$(34) + ":" + CHR$(34) + "eval" + CHR$(34) + "," + CHR$(34) + "expr" + CHR$(34) + ":" + CHR$(34) + "x * 2" + CHR$(34) + "}", _
    "{" + CHR$(34) + "cmd" + CHR$(34) + ":" + CHR$(34) + "stop" + CHR$(34) + "}"])
' Erster Halt vor Zeile 1, dann am Haltepunkt mit x = 5
PRINT art$(0); " "; feld$(0, "line")
DIM h3 AS INTEGER : h3 = ersteMit("paused", 3)
PRINT h3 >= 0; " "; paar$(h3, "globals", "x")
DIM ev AS INTEGER : ev = ersteMit("eval-result", 0)
PRINT feld$(ev, "value"); " "; feld$(ev, "type")
DIM letzt AS INTEGER : letzt = LEN(ereignisse) - 1
PRINT art$(letzt); " "; feld$(letzt, "reason")
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
DIM x AS INTEGER
x = 5
PRINT x

--- erwartet
paused 1
TRUE 5
10 INTEGER
finished stopped

=== lokale einer funktion beim namen
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("d.dh", ["{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "lines" + q + ":[4]}", _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "eval" + q + "," + q + "expr" + q + ":" + q + "a + b" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}"])
' Halt auf RETURN b: b ist schon gesetzt, Tiefe 2 = in der Funktion
DIM h4 AS INTEGER : h4 = ersteMit("paused", 4)
PRINT h4 >= 0; " "; feld$(h4, "depth")
PRINT paar$(h4, "locals", "a"); " "; paar$(h4, "locals", "b")
PRINT feld$(ersteMit("eval-result", 0), "value")
PRINT art$(LEN(ereignisse) - 1)
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
FUNCTION f(a AS INTEGER) AS INTEGER
  DIM b AS INTEGER
  b = a + 1
  RETURN b
END FUNCTION
DIM r AS INTEGER
r = f(10)
PRINT r

--- erwartet
TRUE 2
10 11
21
finished

=== schritt ueber geht zeile fuer zeile
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("d.dh", ["{" + q + "cmd" + q + ":" + q + "step-over" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "step-over" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "stop" + q + "}"])
DIM i AS INTEGER
DIM n AS INTEGER : n = 0
FOR i = 0 TO LEN(ereignisse) - 1
    IF art$(i) = "paused" AND n < 3 THEN
        PRINT feld$(i, "line")
        n = n + 1
    END IF
NEXT
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
DIM x AS INTEGER
x = 1
x = 2
x = 3

--- erwartet
1
2
3

=== input zerstoert das protokoll nicht
' Waehrend einer Sitzung gehoert stdin dem Kommando-Protokoll und stdout den
' Ereignissen. INPUT schrieb seinen Prompt frueher ROH mitten ins JSON und
' stahl dem Debugger eine Kommandozeile; jetzt geht der Prompt als output
' hinaus und INPUT bekommt eine leere Zeile.
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
DIM weiter AS STRING : weiter = "{" + q + "cmd" + q + ":" + q + "continue" + q + "}"
sitzung("d.dh", [weiter, weiter, weiter])
' Jede Zeile war JSON -- sonst haette JSON_PARSE schon abgebrochen.
PRINT INSTR(ausgaben$(), "vorher" + CHR$(10)) >= 0
PRINT INSTR(ausgaben$(), "Zahl: ") >= 0
' Leere Eingabe bei einem INTEGER-Ziel: sauberer Fehler an der INPUT-Zeile
PRINT feld$(ersteMit("error", 0), "line")
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
DIM n AS INTEGER
PRINT "vorher"
INPUT "Zahl: ", n
PRINT "nachher"

--- erwartet
TRUE
TRUE
3

=== input auf string liefert leerstring
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
DIM weiter AS STRING : weiter = "{" + q + "cmd" + q + ":" + q + "continue" + q + "}"
sitzung("d.dh", [weiter, weiter])
PRINT INSTR(ausgaben$(), "[]") >= 0
PRINT ersteMit("error", 0)
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
DIM s AS STRING
INPUT "Name: ", s
PRINT "[" + s + "]"

--- erwartet
TRUE
-1

=== stdin handle stiehlt dem debugger nichts
' Dieselbe Sperre wie bei INPUT, fuer STDIN(): das Programm bekommt einen Strom,
' der sofort zu Ende ist -- die Filterschleife laeuft null mal, statt die
' Sitzung aus dem Tritt zu bringen.
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
DIM weiter AS STRING : weiter = "{" + q + "cmd" + q + ":" + q + "continue" + q + "}"
sitzung("d.dh", [weiter, weiter, weiter])
DIM aus AS STRING : aus = ausgaben$()
PRINT INSTR(aus, "vorher") >= 0; " "; INSTR(aus, "nachher") >= 0
PRINT INSTR(aus, "gelesen:") >= 0
PRINT ersteMit("error", 0)
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
DIM f AS FILE
DIM z AS STRING
PRINT "vorher"
f = STDIN()
WHILE NOT ENDOFFILE(f)
    z = READLINE(f)
    PRINT "gelesen: " + z
WEND
PRINT "nachher"

--- erwartet
TRUE TRUE
FALSE
-1

=== aufrufstapel ueberwachen setzen und bis zeile
' Stapel innen zuerst (die aeussere Zeile ist die des Aufrufs), die
' ueberwachten Ausdruecke bei jedem Halt, "set" wandelt wie eine Zuweisung,
' "run-to" haelt einmal an der Zeile.
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
FUNCTION cmd$(c AS STRING, rest AS STRING) AS STRING
    DIM s AS STRING : s = "{" + q + "cmd" + q + ":" + q + c + q
    IF rest <> "" THEN s = s + "," + rest
    RETURN s + "}"
END FUNCTION
sitzung("p.dh", [cmd$("set-breakpoints", q + "lines" + q + ":[4]"), _
    cmd$("set-watches", q + "exprs" + q + ":[" + q + "n * 10" + q + "," + q + "summe" + q + "," + q + "gibtsnicht" + q + "]"), _
    cmd$("continue", ""), _
    cmd$("set", q + "name" + q + ":" + q + "n" + q + "," + q + "value" + q + ":" + q + "100" + q), _
    cmd$("continue", ""), _
    cmd$("set-breakpoints", q + "lines" + q + ":[]"), _
    cmd$("run-to", q + "line" + q + ":11"), _
    cmd$("continue", "")])
DIM i AS INTEGER
FOR i = 0 TO LEN(ereignisse) - 1
    IF art$(i) <> "output" THEN PRINT TRIM$(art$(i) + " " + feld$(i, "line"))
NEXT
DIM h AS INTEGER : h = ersteMit("paused", 4)
PRINT feld$(h, "stack.0.name"); ":"; feld$(h, "stack.0.line"); " "; feld$(h, "stack.1.name"); ":"; feld$(h, "stack.1.line")
PRINT feld$(h, "watches.0.expr"); "="; feld$(h, "watches.0.value"); " "; feld$(h, "watches.1.value"); " "; feld$(h, "watches.2.error")
DIM s AS INTEGER : s = ersteMit("set-result", 0)
PRINT feld$(s, "value"); " "; feld$(s, "type"); " "; feld$(s, "watches.0.value"); " "; paar$(s, "locals", "n")
DIM e AS INTEGER : e = ersteMit("paused", 11)
PRINT paar$(e, "globals", "summe"); " "; feld$(e, "stack.0.name"); ":"; feld$(e, "stack.0.line"); " "; feld$(e, "stack.1.name") = ""
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei p.dh
DIM summe AS INTEGER
FUNCTION doppelt(n AS INTEGER) AS INTEGER
    DIM r AS INTEGER
    r = n * 2
    RETURN r
END FUNCTION
DIM i AS INTEGER
FOR i = 1 TO 3
    summe = summe + doppelt(i)
NEXT
PRINT summe

--- erwartet
paused 1
watches
paused 4
set-result
paused 4
paused 11
finished
doppelt:4 __main__:9
n * 10=10 0 eval: 'gibtsnicht' nicht gefunden
100 INTEGER 1000 100
210 __main__:11 TRUE

=== setzen wandelt und weist zurueck
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
FUNCTION setze$(name AS STRING, wert AS STRING) AS STRING
    RETURN "{" + q + "cmd" + q + ":" + q + "set" + q + "," + q + "name" + q + ":" + q + name + q + "," + q + "value" + q + ":" + q + wert + q + "}"
END FUNCTION
sitzung("d.dh", ["{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "lines" + q + ":[4]}", _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    setze$("maxi", "6"), setze$("gibtsnicht", "1"), setze$("x", "\" + q + "abc\" + q), setze$("x", "7 * 3"), _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}"])
DIM i AS INTEGER
FOR i = 0 TO LEN(ereignisse) - 1
    IF art$(i) = "set-error" THEN PRINT "fehler "; feld$(i, "message")
    IF art$(i) = "set-result" THEN PRINT "gesetzt "; feld$(i, "name"); " "; feld$(i, "value")
    IF art$(i) = "output" THEN PRINT "ausgabe "; TRIM$(feld$(i, "text"))
NEXT
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
CONST MAXI AS INTEGER = 5
DIM x AS INTEGER
x = 1
PRINT x

--- erwartet
fehler set: 'maxi' nicht gefunden
fehler set: 'gibtsnicht' nicht gefunden
fehler x: Erwartet INTEGER, erhalten STRING
gesetzt x 21
ausgabe 21
