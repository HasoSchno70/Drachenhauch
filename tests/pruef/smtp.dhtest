bericht.pdf application/pdf

=== binaerer anhang ueberlebt
IMPORT "smtp"
IMPORT "mime_leser.dh"
' Jeder Bytewert, achtmal -- auch 0, CR, LF und alles ueber 127.
DIM roh AS BUFFER : roh = BUFFER_NEW(256 * 8)
DIM i AS INTEGER
FOR i = 0 TO 256 * 8 - 1
    BUFFER_SET(roh, i, i MOD 256)
NEXT
WRITEALL_BYTES("roh.bin", roh)
DIM m AS SMTP
m = SMTP_NEW()
SMTP_FROM(m, "ich@beispiel.de")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Test")
SMTP_TEXT(m, "Hallo")
SMTP_ATTACH(m, "roh.bin")
DIM t AS ARRAY OF STRING : t = mimeTeile(SMTP_MESSAGE$(m))
FOR i = 0 TO LEN(t) - 1
    IF mimeDateiname$(t[i]) <> "" THEN
        DIM an AS BUFFER : an = mimeInhalt(t[i])
        PRINT BUFFER_LEN(an); " "; BUFFER_TO_BASE64$(an) = BUFFER_TO_BASE64$(roh)
    END IF
NEXT
--- datei mime_leser.dh
IMPORT "{sammlung}/_hilfen/mime.dh"

--- erwartet
2048 TRUE

