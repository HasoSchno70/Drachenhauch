=== der vorrang haengt am gewicht, nicht an der reihenfolge
' Die spezifischen Regeln stehen ZUERST -- ohne Gewicht gewaenne die letzte.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM b1 AS GUI_WIDGET : b1 = GUI_BUTTON(w, "eins", 10, 10, 100, 30)
DIM b2 AS GUI_WIDGET : b2 = GUI_BUTTON(w, "zwei", 10, 50, 100, 30)
DIM b3 AS GUI_WIDGET : b3 = GUI_BUTTON(w, "drei", 10, 90, 100, 30)
GUI_ADD_CLASS(b2, "gefahr")
GUI_ADD_CLASS(b3, "gefahr")
GUI_SET_NAME(b3, "ok")
GUI_STYLESHEET("#ok { bg: #00A000 } button.gefahr { bg: #C0392B } .gefahr:hover { bg: #FFFF00 } button { bg: #2050C0 } * { bg: #777777 }")
GUI_UPDATE()
PRINT COLOR_HEX$(GUI_GET_COLOR(b1, "bg")) + " " + COLOR_HEX$(GUI_GET_COLOR(b2, "bg")) + " " + COLOR_HEX$(GUI_GET_COLOR(b3, "bg"))
--- erwartet
#2050C0 #C0392B #00A000

=== eine klasse wirkt live, eine entfernte nicht mehr
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 100, 30)
GUI_STYLESHEET("button { bg: #2050C0 } button.gefahr { bg: #C0392B }")
GUI_UPDATE()
PRINT "ohne " + COLOR_HEX$(GUI_GET_COLOR(b, "bg"))
GUI_ADD_CLASS(b, "gefahr")
GUI_UPDATE()
PRINT "mit " + COLOR_HEX$(GUI_GET_COLOR(b, "bg")) + " " + STR$(GUI_HAS_CLASS(b, "GEFAHR"))
GUI_STYLESHEET("button { bg: #2050C0 } button.gefahr { bg: #112233 }")
GUI_UPDATE()
PRINT "neue datei " + COLOR_HEX$(GUI_GET_COLOR(b, "bg"))
GUI_REMOVE_CLASS(b, "gefahr")
GUI_UPDATE()
PRINT "entfernt " + COLOR_HEX$(GUI_GET_COLOR(b, "bg")) + " " + STR$(GUI_HAS_CLASS(b, "gefahr"))
GUI_STYLESHEET("")
GUI_UPDATE()
PRINT "keine datei " + STR$(GUI_GET_COLOR(b, "bg"))
--- erwartet
ohne #2050C0
mit #C0392B TRUE
neue datei #112233
entfernt #2050C0 FALSE
keine datei -1

=== zustaende checked und disabled, die knopfart als klasse
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM cb AS GUI_WIDGET : cb = GUI_CHECKBOX(w, "an", 10, 10)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 50, 100, 30)
GUI_STYLESHEET("checkbox { accent: #111111 } checkbox:checked { accent: #FF8000 } button:disabled { fg: #445566 } .gefahr { bg: #C0392B }")
GUI_UPDATE()
PRINT "aus " + COLOR_HEX$(GUI_GET_COLOR(cb, "accent"))
GUI_SET_CHECKED(cb, TRUE)
GUI_UPDATE()
PRINT "an " + COLOR_HEX$(GUI_GET_COLOR(cb, "accent"))
PRINT "bedienbar " + STR$(GUI_GET_COLOR(b, "fg"))
GUI_SET_ENABLED(b, FALSE)
GUI_UPDATE()
PRINT "gesperrt " + COLOR_HEX$(GUI_GET_COLOR(b, "fg"))
GUI_BUTTON_VARIANT(b, "gefahr")
GUI_UPDATE()
PRINT "knopfart " + COLOR_HEX$(GUI_GET_COLOR(b, "bg")) + " " + STR$(GUI_HAS_CLASS(b, "gefahr"))
--- erwartet
aus #111111
an #FF8000
bedienbar -1
gesperrt #445566
knopfart #C0392B TRUE

=== hover blendet die farbe ein
IMPORT "gui"
SCREEN(400, 300, "T", 1)
GUI_METRIC_SET("gradient", 0)
GUI_METRIC_SET("gloss", 0)
GUI_METRIC_SET("bevel", 0)
GUI_METRIC_SET("corner_radius", 0)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 100, 30)
DIM c AS GUI_WIDGET : c = GUI_BUTTON(w, "y", 10, 60, 100, 30)
GUI_STYLESHEET("button { bg: #2050C0 } button:hover { bg: #00C000 }")
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 20 THEN PRINT "ueber " + COLOR_HEX$(GUI_GET_COLOR(b, "bg")) + " daneben " + COLOR_HEX$(GUI_GET_COLOR(c, "bg"))
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 2
e 0 7 60 25 0 0
e 1 7 60 25 0 0

--- umgebung
DHRT_FRAMES=40
--- erwartet
ueber #00C000 daneben #2050C0
--- bild
14 14 #00C000 +-16
14 64 #2050C0 +-16

=== der fokusrahmen eines textfelds kommt aus der stildatei
IMPORT "gui"
SCREEN(400, 300, "T", 1)
GUI_METRIC_SET("corner_radius", 0)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 20, 20, 200, 30)
DIM tf2 AS GUI_WIDGET : tf2 = GUI_TEXTINPUT(w, 20, 80, 200, 30)
GUI_STYLESHEET("textinput:focus { border: #FF00FF; bg: #203020 }")
GUI_FOCUS(tf)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
