=== loeschen und zusammenfuehren als ein schritt, auch auf der gesperrten ebene
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("farbprobe.pxs")
m.stichzahlenNeu()
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM vorher AS STRING : vorher = fvStand$(m)
DIM p AS kern.Farbplan : p = kern.neuerFarbplan(m)
PRINT "stiche je farbe: "; kern.planStiche(m, p, 1); " "; kern.planStiche(m, p, 4); " "; kern.planStiche(m, p, 7)
kern.planZusammen(p, 1, [4])
kern.planLoeschen(p, [0])
DIM n AS INTEGER : n = kern.planUngenutzte(m, p)
PRINT "ungenutzte: "; n; " | plan "; LEN(p.folge)
p.straenge[p.folge[0]] = 6
DIM ok AS BOOLEAN : ok = kern.planAnwenden(m, v, p)
PRINT "angewendet "; ok; " | schritte "; LEN(v.rueck); " | text "; v.textZurueck$()
PRINT fvStand$(m)
PRINT "gesperrte ebene bleibt gesperrt: "; m.ebenen.ebenen[1].gesperrt; " | unsichtbare bleibt unsichtbar: "; NOT m.ebenen.ebenen[2].sichtbar
ok = v.zurueckNehmen(m)
PRINT "zurueck: wie vorher "; fvStand$(m) = vorher
' eine Farbe nur mit Rueckstichen ist nicht ungenutzt (PySticky loescht sie)
DIM m2 AS kern.Muster : m2 = kern.pxsLaden("farbprobe.pxs")
m2.stichzahlenNeu()
ARRAY_PUSH(m2.rueckstiche, kern.neuerRueckstich(0, 0, 2, 2, 7))
DIM p2 AS kern.Farbplan : p2 = kern.neuerFarbplan(m2)
PRINT "nur rueckstiche: ungenutzt "; kern.planUngenutzte(m2, p2); " | plan "; LEN(p2.folge)
' ein leerer Plan aendert nichts und legt keinen Schritt an
DIM leer AS kern.Farbplan : leer = kern.neuerFarbplan(m)
' (sonst waere das Wiederholen weg)
PRINT "leerer plan: "; kern.planAnwenden(m, v, leer); " | wiederholbar "; LEN(v.vor); " | zuruecknehmbar "; LEN(v.rueck)
