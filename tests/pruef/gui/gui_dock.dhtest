nachher unten

=== die trennlinie zieht den bereich breiter
IMPORT "hilfe.dh"
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN daVerteilen()
    bild = bild + 1
    IF bild = 3 THEN
        dmZug(236, 300, 336, 300, 6)
        dmSpielen()
    END IF
    IF bild = 30 THEN
        PRINT "links "; GUI_DOCK_GET_SIZE(w, "links"); " "; daRect$("projekt")
        EXIT(0)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
