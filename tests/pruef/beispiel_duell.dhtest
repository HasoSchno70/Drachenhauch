        IF LEFT$(z, LEN(anfang)) = anfang THEN RETURN z
    NEXT
    RETURN "(keine Zeile '" + anfang + "')"
END FUNCTION
' die Zahl hinter einem Wort in der Zeile, die so anfaengt
FUNCTION zahlNach(i AS INTEGER, anfang AS STRING, wort AS STRING) AS INTEGER
