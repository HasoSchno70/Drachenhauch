{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameBasic",
  "scopeName": "source.gamebasic",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gamebasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.gamebasic",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.gamebasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gamebasic",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "constant.numeric.gamebasic",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.gamebasic",
          "match": "(?i)\\b(FALSE|TRUE)\\b"
        },
        {
          "name": "storage.type.gamebasic",
          "match": "(?i)\\b(COROUTINE|INTEGER|BOOLEAN|FUNCREF|STRING|TUPLE|SOUND|IMAGE|ARRAY|FLOAT|FILE|MAP|OF)\\b"
        },
        {
          "name": "keyword.declaration.gamebasic",
          "match": "(?i)\\b(PROPERTY|OPERATOR|FUNCTION|EXTENDS|IMPORT|STRUCT|STATIC|BYREF|CLASS|CONST|ENUM|DIM|SUB|AS)\\b"
        },
        {
          "name": "keyword.control.gamebasic",
          "match": "(?i)\\b(CONTINUE|RESTORE|ELSEIF|REPEAT|RETURN|SELECT|YIELD|PRINT|WHILE|WHERE|BREAK|CATCH|UNTIL|THROW|INPUT|WEND|BNOT|WITH|ELIF|STEP|BXOR|CASE|READ|NEXT|THEN|ELSE|BAND|DATA|SHL|TRY|AND|NEW|SHR|MOD|END|FOR|NOT|BOR|IS|OR|IN|IF|TO)\\b"
        },
        {
          "name": "support.function.dollar.gamebasic",
          "match": "(?i)\\b(READALL|REVERSE|REPLACE|REPEAT|FORMAT|SPLIT|LOWER|RIGHT|INKEY|LTRIM|SPACE|UPPER|RTRIM|PADL|LEFT|PADR|TRIM|DATE|TIME|JOIN|BIN|MID|HEX|STR|OCT|CHR)\\$"
        },
        {
          "name": "support.function.gamebasic",
          "match": "(?i)\\b(AUDIO_MUSIC_SET_VOLUME|AUDIO_SET_NUM_CHANNELS|AUDIO_MUSIC_GET_VOLUME|AUDIO_MUSIC_POSITION|AUDIO_BUSY_CHANNELS|NET_UDP_SET_TIMEOUT|AUDIO_MUSIC_RESUME|CURVE_SMOOTHERSTEP|ATLAS_DRAW_FLIPPED|AUDIO_NUM_CHANNELS|NET_CLOSE_LISTENER|RENDERTARGET_BEGIN|AUDIO_MUSIC_VOLUME|NET_UDP_LAST_FROM|AUDIO_MUSIC_QUEUE|ECS_GET_OR_STRING|RENDERTARGET_DRAW|AUDIO_MUSIC_PAUSE|__DICT_FROM_PAIRS|ECS_GET_OR_FLOAT|DRAWIMAGEFLIPPED|AUDIO_IS_PLAYING|AUDIO_RESUME_ALL|CURVE_SMOOTHSTEP|AUDIO_MUSIC_LOAD|AUDIO_MUSIC_PLAY|RENDERTARGET_END|AUDIO_MUSIC_STOP|RENDERTARGET_NEW|AUDIO_GET_VOLUME|AUDIO_MUSIC_BUSY|AUDIO_SET_VOLUME|AUDIO_PAUSE_ALL|ECS_GET_OR_BOOL|GENTEX_GRADIENT|NET_SET_TIMEOUT|JOYSTICK_BUTTON|ARRAY_REMOVE_AT|NET_TCP_CONNECT|TRIANGLEOUTLINE|JOYSTICK_HAT_X|AUDIO_STOP_ALL|CURVE_CATMULL2|JOYSTICK_HAT_Y|SAVESCREENSHOT|ECS_NEW_ENTITY|ECS_ADD_STRING|ELLIPSEOUTLINE|NET_TCP_ACCEPT|SETWINDOWTITLE|SET_FULLSCREEN|ECS_GET_OR_INT|JOYSTICK_COUNT|ECS_GET_STRING|GENTEX_CHECKED|POLYGONOUTLINE|NET_TCP_LISTEN|NET_PEER_ADDR|GENTEX_PERLIN|DRAWIMAGEPART|ECS_ADD_FLOAT|CURVE_CATMULL|JOYSTICK_NAME|NET_UDP_CLOSE|ECS_NEW_WORLD|ARRAY_INDEXOF|FILES_DROPPED|CLIPBOARD_SET|ECS_GET_FLOAT|CURVE_BEZIER2|CLIPBOARD_GET|NET_PEER_PORT|JOYSTICK_AXIS|CURVE_HERMITE|QUITREQUESTED|SCREENHEIGHT|CURVE_BEZIER|FILE_DROPPED|NET_UDP_RECV|NET_UDP_OPEN|AUDIO_VOLUME|ECS_GET_BOOL|ARRAY_INSERT|AUDIO_RESUME|LAYER_DEFINE|GENTEX_COLOR|NET_UDP_BIND|TEXT_SPACING|ECS_ADD_BOOL|NET_UDP_SEND|__SET_DEDUP|MOUSEBUTTON|DRAWTILEMAP|ECS_GET_INT|CORO_RESUME|SCREENWIDTH|LAYER_CLEAR|ECS_DESTROY|AUDIO_NOISE|SHADER_SET2|SHADER_SET3|IMAGEHEIGHT|BATCH_FLUSH|ECS_ADD_INT|LOAD_ASSETS|TEXT_HEIGHT|TEXT_ITALIC|CORO_RESULT|__COMP_ITER|AUDIO_PAUSE|ECS_ADD_OBJ|SHADER_LOAD|ATLAS_DRAW|ECS_QUERY2|STARTSWITH|IMAGEWIDTH|FILEEXISTS|DELETEFILE|KEYPRESSED|COLOR_LERP|ARRAY_FILL|CURVE_LERP|BATCH_DRAW|ATLAS_LOAD|AUDIO_PLAY|MOUSEWHEEL|ECS_QUERY3|ARRAY_COPY|AUDIO_STOP|CORO_CLOSE|TEXT_WIDTH|AUDIO_TONE|SHADER_SET|ARRAY_PUSH|BLEND_MODE|AUDIO_INIT|ECS_REMOVE|MAPREMOVE|TEXT_BOLD|LOADIMAGE|NET_CLOSE|MAPVALUES|ARRAY_MIN|DRAWIMAGE|GRADIENTV|AUDIO_PAN|ECS_QUERY|ECS_COUNT|STOPSOUND|ENDOFFILE|RANDOMIZE|RECTROUND|ARRAY_MAX|PLAYSOUND|CORO_SEND|PLAYMUSIC|ARRAY_SUM|STOPMUSIC|ECS_ALIVE|DIREXISTS|LOADSOUND|WRITELINE|GRADIENTH|LAYER_END|CORO_DONE|CLOSEFILE|ISNUMERIC|ARRAY_POP|READLINES|TEXT_SIZE|ARRAY_AVG|TRIANGLE|READLINE|PATHJOIN|LOADFONT|WRITEALL|FILESIZE|NET_RECV|COLLIDES|BOXROUND|MAPCLEAR|DIMCOUNT|ENDSWITH|OPENFILE|CONTAINS|NET_SEND|MAPGETOR|MAPITEMS|REPLACE|POLYGON|WAITKEY|REVERSE|MAPSIZE|MAPKEYS|CIRCLES|SHUFFLE|ECS_GET|ECS_HAS|RANDINT|DIRLIST|READALL|ELLIPSE|DIMSIZE|SETFONT|TRYVAL|SPLINE|MAPHAS|CHOICE|RENAME|MAPPUT|MOUSEY|SCROLL|MOUSEX|POSTFX|SCREEN|MILLIS|MAPGET|IS_NIL|CIRCLE|SETFPS|SPLIT|ROUND|SPACE|REDIM|UPPER|INSTR|LOWER|RIGHT|GREEN|SLEEP|REMAP|MKDIR|DELTA|RANGE|WRITE|PLOTS|HYPOT|LAYER|LINES|ATAN2|RANDF|LINEW|CLAMP|FLOOR|TIMER|BOXES|SORT|LINE|LERP|SQRT|TIME|CEIL|TEXT|FRAC|PADR|BLUE|DATE|ASIN|ACOS|JOIN|LEFT|TRIM|RECT|PLOT|SIGN|FLIP|PADL|ATAN|ABS|ASC|RND|RED|SIN|CHR|LEN|POW|STR|SGN|VAL|DEG|MIN|MID|HSV|HEX|MAX|TAN|COS|LOG|FPS|RGB|CLS|SQR|BOX|RAD|INT|EXP|ARC)\\b"
        },
        {
          "name": "constant.language.gamebasic",
          "match": "(?i)\\b(JOY_BUTTON_LSTICK|JOY_BUTTON_RSTICK|JOY_BUTTON_START|JOY_BUTTON_BACK|JOY_DPAD_RIGHT|JOY_BUTTON_LB|JOY_DPAD_DOWN|JOY_BUTTON_RB|KEY_BACKSPACE|JOY_DPAD_LEFT|JOY_BUTTON_Y|JOY_BUTTON_B|JOY_BUTTON_X|JOY_BUTTON_A|JOY_DPAD_UP|KEY_RETURN|KEY_ESCAPE|KEY_SPACE|DARKGREEN|LIGHTGRAY|KEY_RIGHT|KEY_ENTER|KEY_DOWN|KEY_LEFT|DARKBLUE|DARKGRAY|KEY_TAB|KEY_F12|DARKRED|KEY_F11|KEY_F10|MAGENTA|KEY_F7|KEY_F1|YELLOW|KEY_F5|KEY_F6|KEY_F3|PURPLE|KEY_UP|KEY_F9|KEY_F4|KEY_F2|KEY_F8|ORANGE|KEY_7|KEY_O|KEY_9|BROWN|KEY_Y|KEY_1|KEY_N|KEY_D|KEY_P|KEY_K|KEY_V|KEY_E|GREEN|KEY_5|KEY_8|KEY_T|KEY_B|KEY_H|KEY_L|KEY_4|KEY_M|KEY_F|KEY_I|KEY_C|KEY_Z|KEY_R|KEY_6|KEY_3|KEY_Q|KEY_A|WHITE|KEY_S|BLACK|KEY_G|KEY_W|KEY_X|KEY_0|KEY_2|KEY_J|KEY_U|GRAY|CYAN|BLUE|PINK|RED|PI)\\b"
        },
        {
          "name": "keyword.operator.gamebasic",
          "match": "<=|>=|<>|[-+*/\\\\=<>^]"
        }
      ]
    }
  }
}
