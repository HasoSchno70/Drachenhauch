=== datenbank: sichern, einspielen ohne neustart, fremde datei, csv, wartung, neu beginnen
' Die Sicherung schreibt SQLite selbst (VACUUM INTO); Einspielen ersetzt den
' Inhalt Tabelle fuer Tabelle, legt vorher eine Sicherung des jetzigen Stands
' an und vergisst den Verlauf -- ohne Neustart (die Python-App ueberschrieb
' die offene Datei). Eine Datei, die keine Sicherung ist, bleibt draussen.
' "Neue Datenbank" fuellt die Startdaten, wahlweise mit den 29 Rezepten.
IMPORT "laeufer.dh"
IMPORT "regex"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
SETENV("KUEHL_EXPORT_ORDNER", CWD$() + "/export")
MKDIR(CWD$() + "/export")
WRITEALL(CWD$() + "/fremd.db", "das ist keine datenbank")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
DIM ex AS ARRAY OF STRING : ex = DIRLIST(CWD$() + "/export")
SORT(ex)
PRINT "export: "; JOIN$(ex, " ")
PRINT TRIM$(REGEX_REPLACE(READALL(CWD$() + "/export/products.csv"), "\d{4}-\d\d-\d\d \d\d:\d\d:\d\d", "ZEIT"))
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
FUNCTION zahlen$() AS STRING
    RETURN "produkte " + STR$(dbZahl("SELECT COUNT(*) FROM products")) + " bestand " + STR$(dbZahl("SELECT COUNT(*) FROM inventory")) + " liste " + STR$(dbZahl("SELECT COUNT(*) FROM shopping_list")) + " rezepte " + STR$(dbZahl("SELECT COUNT(*) FROM recipes")) + " orte " + STR$(dbZahl("SELECT COUNT(*) FROM storage_locations")) + " einstellungen " + STR$(dbZahl("SELECT COUNT(*) FROM app_settings"))
END FUNCTION
FUNCTION inDatei(pfad AS STRING, sql AS STRING) AS INTEGER
    DIM d AS DB_CONN : d = DB_OPEN(pfad)
    DIM r AS DB_RESULT : r = DB_QUERY(d, sql)
    DIM n AS INTEGER : n = -1
    IF DB_NEXT(r) THEN n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    DB_CLOSE(d)
    RETURN n
END FUNCTION
PRINT "groessen "; groesseText$(0); " | "; groesseText$(1536); " | "; groesseText$(5 * 1024 * 1024)
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch, frisch')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit) VALUES (1, 2, 'Liter')")
DIM s1 AS STRING : s1 = sicherungAnlegen$()
PRINT "sicherung "; LEFT$(BASENAME(s1), 20); " im ordner "; BASENAME(DIRNAME(s1)); " | produkte darin "; inDatei(s1, "SELECT COUNT(*) FROM products")
' Danach aendert sich viel -- und die Sicherung kommt zurueck.
verlauf.beginnen("probe")
verlauf.abschliessen()
DB_EXEC(db, "DELETE FROM inventory")
DB_EXEC(db, "DELETE FROM products")
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Käse')")
DB_EXEC(db, "INSERT INTO shopping_list (product_name, quantity) VALUES ('Brot', 1)")
PRINT "vorher: "; zahlen$()
PRINT "einspielen ["; sicherungEinspielen$(s1); "]"
PRINT "nachher: "; zahlen$(); " | "; JOIN$(textListe("SELECT name FROM products"), ",")
PRINT "stand davor gesichert "; FILEEXISTS(vorEinspielen); " "; inDatei(vorEinspielen, "SELECT COUNT(*) FROM products WHERE name = 'Käse'"); " | verlauf "; verlauf.kannZurueck()
PRINT "fremd ["; sicherungEinspielen$(CWD$() + "/../../fremd.db"); "]"
PRINT "fehlt ["; sicherungEinspielen$(CWD$() + "/../gibtsnicht.db"); "]"
' Eine Datenbank ohne products/inventory ist keine Sicherung der App.
DIM a AS DB_CONN : a = DB_OPEN(CWD$() + "/../andere.db")
DB_EXEC(a, "CREATE TABLE notizen (text TEXT)")
DB_CLOSE(a)
PRINT "andere ["; sicherungEinspielen$(CWD$() + "/../andere.db"); "]"
' Eine aeltere Sicherung mit weniger Spalten und ohne shopping_list.
DIM alt AS DB_CONN : alt = DB_OPEN(CWD$() + "/../alt.db")
DB_EXEC(alt, "CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT)")
DB_EXEC(alt, "CREATE TABLE inventory (id INTEGER PRIMARY KEY, product_id INTEGER, quantity REAL)")
DB_EXEC(alt, "INSERT INTO products VALUES (7, 'Alt')")
DB_EXEC(alt, "INSERT INTO inventory VALUES (1, 7, 3)")
DB_CLOSE(alt)
DB_EXEC(db, "INSERT INTO shopping_list (product_name, quantity) VALUES ('Brot', 1)")
PRINT "alt ["; sicherungEinspielen$(CWD$() + "/../alt.db"); "] "; zahlen$(); " | "; JOIN$(textListe("SELECT id || ':' || name || ':' || IFNULL(barcode, '-') FROM products"), ",")
PRINT "zurueck ["; sicherungEinspielen$(s1); "] "; zahlen$()
PRINT "csv "; JOIN$(csvExport(GETENV$("KUEHL_EXPORT_ORDNER")), " / ")
optimieren()
PRINT "optimiert "; dbZahl("SELECT COUNT(*) FROM sqlite_master WHERE name = 'sqlite_stat1'")
DIM vor AS INTEGER, nach AS INTEGER
(vor, nach) = aufraeumen()
PRINT "aufgeraeumt "; nach <= vor; " "; nach = FILESIZE(dbDatei$())
' Das Fenster: Zahlen, Knoepfe ohne Frage.
DIM ef AS EinstellungenFenster : ef = NEW EinstellungenFenster()
ef.Zeigen()
PRINT "fenster: "; GUI_TEXT(ef.dbZahlen); " | pfad endet "; RIGHT$(GUI_TEXT(ef.dbPfad), 18); " ganz "; INSTR(dbDateiGanz$(), ":\") >= 0 OR LEFT$(dbDateiGanz$(), 1) = "/"
ef.knopfSichern_Klick()
PRINT LEFT$(GUI_TEXT(ef.dbStatus), 34)
ef.knopfOptimieren_Klick()
PRINT GUI_TEXT(ef.dbStatus)
ef.knopfCsv_Klick()
PRINT GUI_TEXT(ef.dbStatus)
datenbankNeu(TRUE)
PRINT "neu mit rezepten: "; zahlen$(); " | verlauf "; verlauf.kannZurueck()
datenbankNeu(FALSE)
PRINT "neu ohne: "; zahlen$()
--- erwartet
