' Loesung zu Kapitel 19, Erweitern 1: Kreis statt Balken. Die Baender
' stehen als Strahlen um die Mitte, der Bass oben, rechts und gespiegelt
' links; der innere Kreis atmet mit dem Bass.
' Die Stellen, die neu sind, stehen zwischen >>> und <<<.
IMPORT "audio"
CONST BREITE = 800
CONST HOEHE = 500
CONST BAENDER = 48
CONST BODEN = 340
' Ein Schlag dauert eine halbe Sekunde, zwei Takte sind acht Schlaege.
CONST SCHLAG = 500

' Das Stueck, einmal gebaut: Trommel, Klatschen, Zischen, Bass und eine
' Melodie, jeder Klang an seine Stelle gemischt.
FUNCTION musik() AS SOUND
    DIM stueck AS SOUND : stueck = AUDIO_SOUND_NEW(8 * SCHLAG)
    ' Die Trommel: ein Sinus, der in 140 ms zwei Oktaven tief faellt.
    DIM trommel AS SOUND
    trommel = AUDIO_NOTE("sine", 110, 40, 1, 140, 0, 60, 1, _
                         0, 0, 0, -24)
    DIM klatsch AS SOUND
    klatsch = AUDIO_NOTE("noise", 1, 20, 1, 120, 0, 60, 0.5)
    DIM zisch AS SOUND
    zisch = AUDIO_NOTE("noise", 1, 10, 1, 30, 0, 20, 0.2)
    ' Je Takt zwei Akkorde, je Akkord ein Grundton: a, F, C, G.
    DIM grund AS ARRAY OF FLOAT : grund = [220, 174.61, 261.63, 196]
    ' Die Melodie in Halbtoenen ueber dem A mit 440 Hz, je Achtel einer;
    ' -1 ist eine Pause.
    DIM lied AS ARRAY OF INTEGER
    lied = [0, -1, 3, 5, 7, -1, 5, 3, 0, -1, -2, 0, 3, -1, -1, -1]
    DIM s AS INTEGER
    FOR s = 0 TO 7
        DIM t AS INTEGER : t = s * SCHLAG
        AUDIO_SOUND_MIX(stueck, trommel, t, 0.9)
        IF s MOD 2 = 1 THEN AUDIO_SOUND_MIX(stueck, klatsch, t, 0.7)
        AUDIO_SOUND_MIX(stueck, zisch, t + SCHLAG \ 2, 0.5)
        DIM b AS SOUND
        b = AUDIO_NOTE("saw", grund[s \ 2], 200, 5, 100, 0.5, 60, 0.35)
        AUDIO_SOUND_MIX(stueck, b, t)
        AUDIO_SOUND_MIX(stueck, b, t + SCHLAG \ 2)
        DIM h AS INTEGER
        FOR h = 0 TO 1
            DIM ton AS INTEGER : ton = lied[s * 2 + h]
            IF ton >= 0 THEN
                DIM m AS SOUND
                DIM f AS FLOAT : f = 440 * 2 ^ (ton / 12)
                m = AUDIO_NOTE("triangle", f, 200, 5, 150, 0.4, 80, 0.4)
                AUDIO_SOUND_MIX(stueck, m, t + h * SCHLAG \ 2)
            END IF
        NEXT
    NEXT
    RETURN stueck
END FUNCTION

' Ein Wert, der einem anderen langsam folgt: In `sekunden` legt er zwei
' Drittel des Wegs zurueck -- gleich schnell bei 30 und bei 144 Bildern
' je Sekunde, denn gerechnet wird mit der Zeit, nicht mit den Bildern.
FUNCTION glaetten(alt AS FLOAT, neu AS FLOAT, sekunden AS FLOAT) _
         AS FLOAT
    RETURN alt + (neu - alt) * (1 - EXP(-DELTA() / sekunden))
END FUNCTION

' Der Mittelwert der Baender von `von` bis `bis`.
FUNCTION mittel(sp AS ARRAY OF FLOAT, von AS INTEGER, bis AS INTEGER) _
         AS FLOAT
    DIM summe AS FLOAT
    DIM i AS INTEGER
    FOR i = von TO bis
        summe = summe + sp[i]
    NEXT
    RETURN summe / (bis - von + 1)
END FUNCTION

' Bass, Mitte und Hoehen auf einmal: drei Werte, eine Rueckgabe. Der
' Bass ist das unterste Achtel der Baender, die Hoehen die oberen drei
' Achtel.
FUNCTION drei_teile(sp AS ARRAY OF FLOAT) AS TUPLE
    DIM a AS INTEGER : a = BAENDER \ 8
    DIM b AS INTEGER : b = BAENDER * 5 \ 8
    RETURN (mittel(sp, 0, a - 1), mittel(sp, a, b - 1), _
            mittel(sp, b, BAENDER - 1))
END FUNCTION

SCREEN(BREITE, HOEHE, "Ein Bild, das zuhoert")
DIM kanal AS AUDIO_CHANNEL : kanal = AUDIO_PLAY(musik(), -1)
DIM pause AS BOOLEAN

DIM spektrum[BAENDER] AS FLOAT
' Die Spitzen: jede faellt langsam, bis ein Band sie wieder hochstoesst.
DIM spitzen[BAENDER] AS FLOAT
DIM bass AS FLOAT
DIM mitte AS FLOAT
DIM hoehen AS FLOAT
' Wie laut der Bass im Schnitt der letzten Sekunde war.
DIM bass_schnitt AS FLOAT
DIM blitz AS FLOAT
DIM seit_schlag AS FLOAT

WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE)
    IF KEY_HIT(KEY_SPACE) THEN
        pause = NOT pause
        IF pause THEN AUDIO_PAUSE(kanal) ELSE AUDIO_RESUME(kanal)
    END IF

    AUDIO_FFT(spektrum)
    (bass, mitte, hoehen) = drei_teile(spektrum)

    ' Ein Schlag: Der Bass ist deutlich lauter als im Schnitt -- und der
    ' letzte ist eine Weile her, sonst zaehlte ein Schlag doppelt.
    seit_schlag = seit_schlag + DELTA()
    IF bass > bass_schnitt * 1.3 AND bass > 0.3 _
       AND seit_schlag > 0.2 THEN
        blitz = 1
        seit_schlag = 0
    END IF
    bass_schnitt = glaetten(bass_schnitt, bass, 1.0)
    blitz = MAX(0, blitz - DELTA() * 4)

    CLS(RGB(10 + blitz * 50, 8 + blitz * 20, 24 + blitz * 60))
    ' >>> neu
    DIM innen AS FLOAT : innen = 60 + bass * 30
    CIRCLE_OUTLINE(BREITE / 2, HOEHE / 2, innen, _
                   RGBA(255, 255, 255, 90))
    DIM i AS INTEGER
    FOR i = 0 TO BAENDER - 1
        ' Der Winkel: 0 oben, PI unten -- die halbe Runde fuer alle
        ' Baender, die andere Haelfte ist das Spiegelbild.
        DIM w AS FLOAT : w = (i + 0.5) / BAENDER * PI
        DIM aussen AS FLOAT : aussen = innen + spektrum[i] * 140
        spitzen[i] = MAX(spektrum[i], spitzen[i] - DELTA() * 0.5)
        DIM spitze AS FLOAT : spitze = innen + spitzen[i] * 140
        DIM farbe AS INTEGER : farbe = HSV(i / BAENDER * 280, 0.7, 1)
        DIM seite AS INTEGER
        FOR seite = -1 TO 1 STEP 2
            DIM dx AS FLOAT : dx = seite * SIN(w)
            DIM dy AS FLOAT : dy = -COS(w)
            LINEW(BREITE / 2 + dx * innen, HOEHE / 2 + dy * innen, _
                  BREITE / 2 + dx * aussen, HOEHE / 2 + dy * aussen, _
                  5, farbe)
            CIRCLE(BREITE / 2 + dx * spitze, HOEHE / 2 + dy * spitze, _
                   2, RGB(255, 255, 255))
        NEXT
    NEXT
    ' <<< neu

    ' Bass, Mitte und Hoehen als drei Kreise, oben rechts -- dort sind
    ' die Balken fast immer niedrig.
    CIRCLE(560, 60, 8 + bass * 36, RGBA(255, 90, 90, 200))
    CIRCLE(650, 60, 8 + mitte * 36, RGBA(120, 255, 120, 200))
    CIRCLE(740, 60, 8 + hoehen * 36, RGBA(110, 160, 255, 200))
    TEXT(542, 108, "Bass", RGBA(255, 255, 255, 160))
    TEXT(630, 108, "Mitte", RGBA(255, 255, 255, 160))
    TEXT(718, 108, "Hoehen", RGBA(255, 255, 255, 160))
    FLIP()
WEND
