IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM a AS GUI_WIDGET : a = GUI_LISTBOX(w, 20, 20, 160, 110, ["Apfel", "Birne", "Kirsche"])
DIM b AS GUI_WIDGET : b = GUI_LISTBOX(w, 240, 20, 160, 110, ["Dattel"])
GUI_DRAGGABLE(a, TRUE) : GUI_DROP_TARGET(a, TRUE) : GUI_DROP_TARGET(b, TRUE)
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
