pruefeText("  und bringt ihn nicht an Anna vorbei", wer, "Anna")

' ---- Ligatabelle ---------------------------------------------------------
' Die Tabelle wird gerechnet, nicht gespeichert -- sie steht schon in den
' Ergebnissen. Der Kniff: jedes Spiel liefert ZWEI Zeilen, eine je Sicht.
' Wortgleich mit tippspiel.dh.
PRINT ""
PRINT "=== Ligatabelle ==="

FUNCTION tabellenAbfrage() AS STRING
    RETURN "WITH ligaspiele AS (" + _
           "    SELECT heim, gast, tore_heim, tore_gast FROM spiele" + _
           "     WHERE saison = ? AND liga = ?" + _
           "), vereine AS (" + _
           "    SELECT heim AS verein FROM ligaspiele" + _
           "    UNION SELECT gast FROM ligaspiele" + _
           "), auftritte AS (" + _
           "    SELECT heim AS verein, tore_heim AS eigene, tore_gast AS fremde" + _
           "      FROM ligaspiele WHERE tore_heim IS NOT NULL" + _
           "    UNION ALL" + _
           "    SELECT gast, tore_gast, tore_heim" + _
           "      FROM ligaspiele WHERE tore_heim IS NOT NULL" + _
           ") " + _
           "SELECT v.verein, COUNT(a.verein) AS sp, " + _
           "  COALESCE(SUM(a.eigene > a.fremde), 0) AS s, " + _
           "  COALESCE(SUM(a.eigene = a.fremde), 0) AS u, " + _
           "  COALESCE(SUM(a.eigene < a.fremde), 0) AS n, " + _
           "  COALESCE(SUM(a.eigene), 0) AS tore, " + _
           "  COALESCE(SUM(a.fremde), 0) AS gegentore, " + _
           "  COALESCE(SUM(a.eigene) - SUM(a.fremde), 0) AS diff, " + _
           "  COALESCE(SUM(CASE WHEN a.eigene > a.fremde THEN 3 " + _
           "                    WHEN a.eigene = a.fremde THEN 1 ELSE 0 END), 0) AS punkte " + _
           "FROM vereine v LEFT JOIN auftritte a ON a.verein = v.verein " + _
           "GROUP BY v.verein " + _
           "ORDER BY punkte DESC, diff DESC, tore DESC, v.verein"
END FUNCTION

' Eine eigene kleine Liga, damit die vorherigen Pruefungen nicht hineinreden.
DB_EXEC(db, "INSERT INTO spiele (liga, spieltag, heim, gast, tore_heim, tore_gast) VALUES " + _
            "('tl', 1, 'Adler', 'Bieber', 3, 1), " + _
            "('tl', 1, 'Chamaeleon', 'Dachs', 2, 2), " + _
            "('tl', 2, 'Bieber', 'Chamaeleon', 0, 1), " + _
            "('tl', 2, 'Dachs', 'Adler', 1, 1)")
' Ein Spiel ohne Ergebnis darf nirgends mitzaehlen -- weder als Niederlage
' noch als 0:0.
DB_EXEC(db, "INSERT INTO spiele (liga, spieltag, heim, gast) VALUES " + _
            "('tl', 3, 'Adler', 'Chamaeleon')")
' Und ein Verein, der noch kein Spiel hatte, gehoert trotzdem in die Tabelle.
DB_EXEC(db, "INSERT INTO spiele (liga, spieltag, heim, gast) VALUES " + _
            "('tl', 3, 'Eichhorn', 'Bieber')")

' Die Tabelle einmal einlesen.
CONST MAXV = 20
DIM tVerein[MAXV] AS STRING
DIM tSp[MAXV] AS INTEGER
DIM tTore[MAXV] AS INTEGER
DIM tGegen[MAXV] AS INTEGER
DIM tDiff[MAXV] AS INTEGER
DIM tPunkte[MAXV] AS INTEGER
DIM tAnzahl AS INTEGER : tAnzahl = 0

r = DB_QUERY(db, tabellenAbfrage(), pruefSaison, "tl")
WHILE DB_NEXT(r)
    tVerein[tAnzahl] = DB_GET_STRING(r, 0)
    tSp[tAnzahl] = DB_GET_INT(r, 1)
    tTore[tAnzahl] = DB_GET_INT(r, 5)
    tGegen[tAnzahl] = DB_GET_INT(r, 6)
    tDiff[tAnzahl] = DB_GET_INT(r, 7)
    tPunkte[tAnzahl] = DB_GET_INT(r, 8)
    tAnzahl = tAnzahl + 1
WEND
DB_CLOSE_RESULT(r)

PRINT "  Tabelle:"
DIM ti AS INTEGER
FOR ti = 0 TO tAnzahl - 1
    PRINT "    "; ti + 1; ". "; tVerein[ti]; "  "; tSp[ti]; " Sp  "; _
          tTore[ti]; ":"; tGegen[ti]; "  "; tDiff[ti]; "  "; tPunkte[ti]; " Pkt"
NEXT

' Adler: 3:1 gewonnen, 1:1 -> 4 Punkte, 4:2, Diff +2
' Chamaeleon: 2:2, 1:0 gewonnen -> 4 Punkte, 3:2, Diff +1
' Beide 4 Punkte -- die Tordifferenz entscheidet.
pruefe("alle Vereine stehen drin, auch der ohne Spiel", tAnzahl, 5)
pruefeText("Erster ist Adler (4 Punkte, Diff +2)", tVerein[0], "Adler")
pruefeText("Zweiter ist Chamaeleon (4 Punkte, Diff +1)", tVerein[1], "Chamaeleon")
pruefe("  Adler hat 4 Punkte", tPunkte[0], 4)
pruefe("  Chamaeleon auch", tPunkte[1], 4)
pruefe("  entschieden hat die Tordifferenz", tDiff[0] - tDiff[1], 1)

pruefe("Adler hat zwei Spiele -- das dritte hat kein Ergebnis", tSp[0], 2)

' Eichhorn hat noch nicht gespielt und steht damit auf 0 Punkten, aber auf
' Tordifferenz 0. Bieber hat zwei Spiele verloren: auch 0 Punkte, aber -3.
' Der Verein OHNE Spiel steht also ueber dem, der zweimal verloren hat --
' das ist richtig so und faellt nur auf, wenn man es einmal hinschreibt.
pruefeText("wer nicht gespielt hat, steht auf Platz 4", tVerein[3], "Eichhorn")
pruefe("  mit null Spielen", tSp[3], 0)
pruefe("  und null Punkten (nicht NULL)", tPunkte[3], 0)
pruefeText("Letzter ist Bieber -- 0 Punkte UND -3 Tore", tVerein[tAnzahl - 1], "Bieber")
pruefe("  seine Differenz ist schlechter als die von Eichhorn", tDiff[tAnzahl - 1], -3)

' Die Probe, die eine Ligatabelle immer bestehen muss: was die einen
' schiessen, kassieren die anderen.
DIM summeTore AS INTEGER : summeTore = 0
DIM summeGegen AS INTEGER : summeGegen = 0
DIM summeSp AS INTEGER : summeSp = 0
FOR ti = 0 TO tAnzahl - 1
    summeTore = summeTore + tTore[ti]
    summeGegen = summeGegen + tGegen[ti]
    summeSp = summeSp + tSp[ti]
NEXT
pruefe("Tore und Gegentore gehen auf", summeTore - summeGegen, 0)
pruefe("vier gewertete Spiele, also acht Einsaetze", summeSp, 8)

' Ein Unentschieden gibt beiden einen Punkt -- zusammen 2 statt 3.
' Vier Spiele, davon zwei unentschieden: 2*3 + 2*2 = 10.
DIM summePunkte AS INTEGER : summePunkte = 0
FOR ti = 0 TO tAnzahl - 1
    summePunkte = summePunkte + tPunkte[ti]
NEXT
pruefe("Punktsumme stimmt (2 Siege a 3, 2 Remis a 2)", summePunkte, 10)

' ---- Statistik -----------------------------------------------------------
' Die Statistik fragt nach der ART eines Treffers, nicht nach seinen Punkten.
' Heute sind das dieselben Zahlen -- genau deshalb muss man einmal
' hinschreiben, dass es zwei verschiedene Fragen sind.
PRINT ""
PRINT "=== Trefferarten ==="

pruefe("2:1 auf 2:1 ist exakt", art(2, 1, 2, 1), ART_EXAKT)
pruefe("3:2 auf 2:1 ist die Tordifferenz", art(3, 2, 2, 1), ART_DIFFERENZ)
pruefe("3:0 auf 2:1 ist nur die Tendenz", art(3, 0, 2, 1), ART_TENDENZ)
pruefe("1:2 auf 2:1 ist daneben", art(1, 2, 2, 1), ART_DANEBEN)

' Der Sonderfall, der beim Tippen von Unentschieden auffaellt: zwei
' Unentschieden haben IMMER dieselbe Tordifferenz. 1:1 auf 2:2 kann also
' nie "nur Tendenz" sein.
pruefe("1:1 auf 2:2 ist die Tordifferenz, nie nur Tendenz", _
       art(1, 1, 2, 2), ART_DIFFERENZ)
pruefe("0:0 auf 0:0 ist exakt", art(0, 0, 0, 0), ART_EXAKT)

' Art und Punkte muessen zusammenpassen -- ueber alle Tipps und Ergebnisse
' von 0:0 bis 5:5. Wer eine der beiden Funktionen aendert und die andere
' vergisst, faellt hier auf.
DIM th AS INTEGER
DIM tg AS INTEGER
DIM eh AS INTEGER
DIM eg AS INTEGER
DIM schief AS INTEGER : schief = 0
DIM gezaehlt AS INTEGER : gezaehlt = 0
FOR th = 0 TO 5
    FOR tg = 0 TO 5
        FOR eh = 0 TO 5
            FOR eg = 0 TO 5
                gezaehlt = gezaehlt + 1
                DIM a AS INTEGER : a = art(th, tg, eh, eg)
                DIM p AS INTEGER : p = punkte(th, tg, eh, eg)
                DIM soll AS INTEGER : soll = 0
                IF a = ART_EXAKT THEN soll = 3
                IF a = ART_DIFFERENZ THEN soll = 2
                IF a = ART_TENDENZ THEN soll = 1
                IF p <> soll THEN schief = schief + 1
            NEXT
        NEXT
    NEXT
NEXT
pruefe("alle 1296 Paarungen von 0:0 bis 5:5 geprueft", gezaehlt, 1296)
pruefe("  Art und Punkte passen ueberall zusammen", schief, 0)

PRINT ""
PRINT "=== Statistik eines Spielers ==="

' Die Abfrage des Programms, wortgleich. Der leere Ligafilter heisst beide.
FUNCTION statAbfrage() AS STRING
    RETURN "SELECT s.spieltag, t.tipp_heim, t.tipp_gast, s.tore_heim, s.tore_gast " + _
           "FROM tipps t JOIN spiele s ON s.id = t.spiel_id " + _
           "WHERE t.spieler_id = ? AND s.saison = ? AND s.tore_heim IS NOT NULL " + _
           "  AND (? = '' OR s.liga = ?) " + _
           "ORDER BY s.spieltag"
END FUNCTION

FUNCTION statZeilen(spieler AS INTEGER, liga AS STRING, _
                    BYREF summe AS INTEGER, BYREF exakt AS INTEGER) AS INTEGER
    DIM q AS DB_RESULT
    q = DB_QUERY(db, statAbfrage(), spieler, pruefSaison, liga, liga)
    DIM n AS INTEGER : n = 0
    summe = 0
    exakt = 0
    WHILE DB_NEXT(q)
        n = n + 1
        summe = summe + punkte(DB_GET_INT(q, 1), DB_GET_INT(q, 2), _
                               DB_GET_INT(q, 3), DB_GET_INT(q, 4))
        IF art(DB_GET_INT(q, 1), DB_GET_INT(q, 2), _
               DB_GET_INT(q, 3), DB_GET_INT(q, 4)) = ART_EXAKT THEN exakt = exakt + 1
    WEND
    DB_CLOSE_RESULT(q)
    RETURN n
END FUNCTION

' Clara bekommt einen zweiten Tipp -- einen in der 2. Liga, auf ein Spiel
' mit Ergebnis (id 31, 2:0), exakt getroffen.
DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) " + _
            "VALUES (3, 31, 2, 0)")
' Und einen auf ein Spiel OHNE Ergebnis -- der darf nirgends auftauchen.
DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) " + _
            "SELECT 3, id, 1, 1 FROM spiele WHERE liga = 'tl' AND spieltag = 3 LIMIT 1")

DIM sSumme AS INTEGER
DIM sExakt AS INTEGER
pruefe("Clara hat zwei gewertete Tipps", statZeilen(3, "", sSumme, sExakt), 2)
pruefe("  der Tipp auf das Spiel ohne Ergebnis ist nicht dabei", sSumme, 5)
pruefe("  einer davon exakt (2:0 auf 2:0)", sExakt, 1)

pruefe("nur 1. Liga: einer", statZeilen(3, "bl1", sSumme, sExakt), 1)
pruefe("  und der bringt 2 Punkte", sSumme, 2)
pruefe("nur 2. Liga: auch einer", statZeilen(3, "bl2", sSumme, sExakt), 1)
pruefe("  und der bringt 3", sSumme, 3)

' Die gespeicherte Punktespalte wird dabei nicht gebraucht: die Statistik
' rechnet aus Tipp und Ergebnis. Zum Beweis eine falsche Zahl hineinschreiben
' -- die Statistik darf sich davon nicht beirren lassen.
DB_EXEC(db, "UPDATE tipps SET punkte = 99 WHERE spieler_id = 3")
pruefe("eine falsche Punktespalte aendert die Statistik nicht", _
       statZeilen(3, "", sSumme, sExakt), 2)
pruefe("  die Punkte kommen aus Tipp und Ergebnis", sSumme, 5)

' Die Spalte wieder richtigstellen. Die RANGLISTE liest sie naemlich sehr
' wohl -- sie summiert tipps.punkte, statt jeden Tipp neu zu rechnen. Liesse
' man die 99 stehen, faende der naechste Abschnitt Clara mit 198 Punkten
' vorn, und man suchte den Fehler dort, wo keiner ist.
DB_EXEC(db, "UPDATE tipps SET punkte = 2 WHERE spieler_id = 3 AND spiel_id = 11")
DB_EXEC(db, "UPDATE tipps SET punkte = 3 WHERE spieler_id = 3 AND spiel_id = 31")
DB_EXEC(db, "UPDATE tipps SET punkte = NULL " + _
            "WHERE spieler_id = 3 AND spiel_id NOT IN (11, 31)")

' ---- Saisons -------------------------------------------------------------
' Die Saison steht ueber Liga und Spieltag. Ohne sie im Schluessel waere das
' Spiel Falke gegen Gams am 1. Spieltag jedes Jahr DASSELBE Spiel -- der
' Abruf der neuen Saison wuerde die Ergebnisse der alten ueberschreiben, und
' die Tipps von damals hingen ploetzlich an einem anderen Ergebnis.
PRINT ""
PRINT "=== Saisons ==="

' Dieselbe Paarung, dieselbe Liga, derselbe Spieltag -- zwei Jahre.
