=== textfeld: rechtsklick setzt die marke, in der auswahl laesst er sie stehen
IMPORT "gui"
SCREEN(300, 120, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 120)
GUI_WINDOW_CHROME(w, FALSE)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 10, 10, 280, 28)
DIM tf2 AS GUI_WIDGET : tf2 = GUI_TEXTINPUT(w, 10, 60, 280, 28)
GUI_SET_TEXT(tf, "eins zwei drei")
GUI_SET_TEXT(tf2, "eins zwei drei")
DIM x1 AS INTEGER : x1 = 15 + TEXT_WIDTH("ei")
DIM x2 AS INTEGER : x2 = 15 + TEXT_WIDTH("eins zw")
' Oben: Doppelklick auf "zwei", Rechtsklick in "eins", Ruecktaste.
' Unten: Doppelklick auf "zwei", Rechtsklick IN "zwei", Ruecktaste.
DIM a AS STRING
a = "c 17" + CHR$(10)
a = a + "e 0 7 " + STR$(x2) + " 24 0 0" + CHR$(10)
a = a + "e 1 6 0 0 0 0" + CHR$(10) + "e 2 5 0 0 0 0" + CHR$(10)
a = a + "e 3 6 0 0 0 0" + CHR$(10) + "e 4 5 0 0 0 0" + CHR$(10)
a = a + "e 8 7 " + STR$(x1) + " 24 0 0" + CHR$(10)
a = a + "e 9 6 1 0 0 0" + CHR$(10) + "e 10 5 1 0 0 0" + CHR$(10)
a = a + "e 12 2 259 0 0 0" + CHR$(10) + "e 13 1 259 0 0 0" + CHR$(10)
a = a + "e 20 7 " + STR$(x2) + " 74 0 0" + CHR$(10)
a = a + "e 21 6 0 0 0 0" + CHR$(10) + "e 22 5 0 0 0 0" + CHR$(10)
a = a + "e 23 6 0 0 0 0" + CHR$(10) + "e 24 5 0 0 0 0" + CHR$(10)
a = a + "e 28 6 1 0 0 0" + CHR$(10) + "e 29 5 1 0 0 0" + CHR$(10)
WRITEALL("ev.txt", a)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 2 THEN AUTOMATION_PLAY("ev.txt")
    ' Die Ruecktaste fuer unten erst, wenn alles abgespielt ist.
    IF bild = 36 THEN
        WRITEALL("ev2.txt", "c 2" + CHR$(10) + "e 0 2 259 0 0 0" + CHR$(10) + "e 1 1 259 0 0 0" + CHR$(10))
        AUTOMATION_PLAY("ev2.txt")
    END IF
    IF bild = 44 THEN PRINT "[" + GUI_TEXT(tf) + "] [" + GUI_TEXT(tf2) + "]"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
