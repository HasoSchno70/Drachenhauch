PRINT zeile$(laufen$(mg, 20, ""), "schirm ")
' Erweitern 2: die Erinnerung (NOTIFY hier als Ausgabe).
DIM he AS STRING : he = CWD$() + "/kap23_erinnern/_studio/projekt/Hauptfenster.dh"
WRITEALL(he, REPLACE$(READALL(he), "NOTIFY(", "probeNotify(") + CHR$(10) + "SUB probeNotify(t AS STRING, x AS STRING)" + CHR$(10) + "    PRINT " + q$("notify ") + "; t; " + q$(" | ") + "; x" + CHR$(10) + "END SUB" + CHR$(10))
DIM me AS STRING : me = CWD$() + "/kap23_erinnern/_studio/main.dh"
