' Handbuch: Klappliste der Dokumente, Suche im Dokument, Text mit Umbruch.
' Seit 2026-09-27: links das Inhaltsverzeichnis (die Ueberschriften des
' Dokuments, es geht beim Lesen mit), oben Vor/Zurueck wie im Browser, die
' Zeile darunter ist weg -- sie wiederholte nur den Dateinamen aus der
' Klappliste, und der Quelltext-Knopf lag halb ueber dem Text. Meldungen
' stehen jetzt in einer Zeile UNTER dem Text. Die Masse setzt
' `handbuchLayout`, das Fenster waechst mit dem Schirm.
CONST HB_X = 120
CONST HB_Y = 50
CONST HB_INHALT_B = 290
DIM winHandbuch AS GUI_WINDOW : winHandbuch = GUI_WINDOW(tr$("Handbuch"), HB_X, HB_Y, 1180, 780)
GUI_WINDOW_CLOSABLE(winHandbuch, TRUE)
GUI_WINDOW_RESIZABLE(winHandbuch, TRUE)
GUI_WINDOW_SET_MIN_SIZE(winHandbuch, 1000, 500)
DIM btnHbRueck AS GUI_WIDGET : btnHbRueck = GUI_ICON_BUTTON(winHandbuch, 8, 8, 32, 28, "links")
DIM btnHbVor AS GUI_WIDGET : btnHbVor = GUI_ICON_BUTTON(winHandbuch, 44, 8, 32, 28, "rechts")
GUI_TOOLTIP(btnHbRueck, tr$("Zurück zur vorigen Stelle (Alt+Links)"))
GUI_TOOLTIP(btnHbVor, tr$("Vorwärts (Alt+Rechts)"))
DIM ddDoku AS GUI_WIDGET : ddDoku = GUI_DROPDOWN(winHandbuch, 84, 8, 340, 28, [])
DIM tfHbSuche AS GUI_WIDGET : tfHbSuche = GUI_TEXTINPUT(winHandbuch, 432, 8, 180, 28, "")
GUI_TOOLTIP(tfHbSuche, tr$("Im Dokument suchen -- Enter: nächste Fundstelle"))
DIM btnHbZurueck AS GUI_WIDGET : btnHbZurueck = GUI_BUTTON(winHandbuch, tr$("Vorige"), 620, 8, 74, 28)
DIM btnHbSuche AS GUI_WIDGET : btnHbSuche = GUI_BUTTON(winHandbuch, tr$("Nächste"), 700, 8, 74, 28)
' Suche ueber ALLE Dokumente: die Treffer stehen in der Liste links, wo
' sonst das Inhaltsverzeichnis steht; derselbe Knopf holt es zurueck.
DIM btnHbAlle AS GUI_WIDGET : btnHbAlle = GUI_BUTTON(winHandbuch, tr$("In allen"), 780, 8, 96, 28)
GUI_TOOLTIP(btnHbZurueck, tr$("Vorige Fundstelle (Umschalt+Enter)"))
GUI_TOOLTIP(btnHbSuche, tr$("Nächste Fundstelle (Enter)"))
GUI_TOOLTIP(btnHbAlle, tr$("In allen Dokumenten des Handbuchs suchen -- die Treffer stehen links"))
DIM lstHbInhalt AS GUI_WIDGET : lstHbInhalt = GUI_LISTBOX(winHandbuch, 8, 46, HB_INHALT_B, 600, [])
GUI_LISTBOX_PLACEHOLDER(lstHbInhalt, tr$("Keine Überschriften"))
GUI_TOOLTIP(lstHbInhalt, tr$("Inhalt -- ein Klick springt zum Abschnitt"))
DIM lblHbStand AS GUI_WIDGET : lblHbStand = GUI_LABEL(winHandbuch, "", 8, 700)
DIM taHandbuch AS GUI_WIDGET : taHandbuch = GUI_TEXTAREA(winHandbuch, HB_INHALT_B + 16, 46, 900, 620)
' Gesetzt statt roh: die Leinwand liegt auf derselben Flaeche wie das
' Textfeld, immer nur eine von beiden ist sichtbar.
' Gesetzt wird seit Stand 25 vom Widget der Laufzeit -- davor malte die IDE
' den Text selbst auf eine Zeichenflaeche und konnte dabei weder fett noch
' Tabellenspalten noch anklickbare Verweise.
DIM rtHandbuch AS GUI_WIDGET : rtHandbuch = GUI_RICHTEXT(winHandbuch, HB_INHALT_B + 16, 46, 900, 620, "")
DIM btnHbAnsicht AS GUI_WIDGET : btnHbAnsicht = GUI_BUTTON(winHandbuch, tr$("Quelltext"), 1060, 8, 104, 28)
GUI_TOOLTIP(btnHbAnsicht, tr$("Zwischen gesetzter Ansicht und Markdown-Quelltext wechseln"))
' Verlauf wie im Browser: je Eintrag Dokument und Rollstand.
' Ein Stand im Verlauf des Handbuchs: Dokument und Rollstand. Zurueck und
' vorwaerts sind zwei Stapel davon (bis 2026-10-30 je zwei Felder).
CLASS HandbuchStand
    DIM datei AS STRING
    DIM scroll AS INTEGER
    SUB Init(d AS STRING, sc AS INTEGER)
        datei = d : scroll = sc
    END SUB
END CLASS
DIM hbZurueck AS ARRAY OF HandbuchStand : hbZurueck = []
DIM hbVor AS ARRAY OF HandbuchStand : hbVor = []
DIM hbInhaltWahl AS INTEGER : hbInhaltWahl = -1   ' was die Liste zuletzt zeigte
DIM hbInhaltHalt AS INTEGER : hbInhaltHalt = -1   ' Rollstand nach einem Klick; -2 = noch zu lesen
DIM hbMassStand AS STRING : hbMassStand = ""
DIM stoppFrist AS FLOAT : stoppFrist = 0
' Die zuletzt geprueften Stellen (fuer den Tooltip an der Wellenlinie).
DIM probFeld AS GUI_WIDGET : probFeld = -1
' Eine Meldung der Pruefung an ihrer Stelle. Bis 2026-10-30 sieben Felder
' nebeneinander.
CLASS Problem
    DIM zeile AS INTEGER
    DIM spalte AS INTEGER
    DIM laenge AS INTEGER
    DIM meldung AS STRING
    DIM fehler AS BOOLEAN           ' sonst Warnung oder Hinweis
    DIM hinweis AS BOOLEAN
    DIM korr AS STRING              ' die Korrekturen als JSON-Text, "" = keine (CODE_CHECK$)

    ' Trifft die Spalte `sp` die Stelle (samt dem Zeichen dahinter)?
    FUNCTION trifft(sp AS INTEGER) AS BOOLEAN
        RETURN sp >= spalte AND sp <= spalte + laenge
    END FUNCTION
END CLASS
DIM probleme AS ARRAY OF Problem : probleme = []
' Die angebotenen Korrekturen der offenen Auswahl (je eine als JSON) und der
' Text, zu dem sie gehoeren: probKorr baut jede Pruefung neu, und eine
' Nummer dort zeigte nach einer Aenderung auf eine andere Meldung.
DIM korrAngebote AS ARRAY OF STRING : korrAngebote = []
DIM korrText AS STRING : korrText = ""
DIM hbGesetzt AS BOOLEAN : hbGesetzt = TRUE
' Die Liste links zeigt Treffer statt Inhalt: je Eintrag Datei und Zeile
' (0 = Kopf eines Dokuments).
DIM hbTrModus AS BOOLEAN : hbTrModus = FALSE
CLASS HandbuchTreffer
    DIM datei AS STRING
    DIM zeile AS INTEGER            ' 0 = der Kopf des Dokuments
    SUB Init(d AS STRING, z AS INTEGER)
        datei = d : zeile = z
    END SUB
END CLASS
DIM hbTreffer AS ARRAY OF HandbuchTreffer : hbTreffer = []
DIM hbTrWahl AS INTEGER : hbTrWahl = -1
DIM hbTrNadel AS STRING : hbTrNadel = ""
' Knoepfe an jedem Codeblock: ein Beispiel ausprobieren, ohne es abzutippen.
GUI_RICHTEXT_CODE_BUTTONS(rtHandbuch, "Kopieren|In neuen Reiter|Starten")
GUI_TEXTAREA_SET(taHandbuch, "umbruch", 1)
' Der Quelltext in der Schrift des Editors -- Tabellen und Einrueckung
' stehen dann, wie sie geschrieben sind.
IF codeFont >= 0 THEN GUI_SET_FONT(taHandbuch, codeFont)
GUI_WINDOW_VISIBLE(winHandbuch, FALSE)
GUI_WINDOW_CLOSABLE(winProfil, TRUE)

