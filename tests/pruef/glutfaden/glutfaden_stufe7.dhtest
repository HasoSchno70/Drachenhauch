' Glutfaden Stufe 7: der Stickpfad (PySticky core/stitch_path_optimizer.py,
' ui/dialogs/stitch_path_dialog.py, die Pfadlinien im PDF).
'
' Die Beilagen hat PySticky selbst aufgezeichnet (Stickplan als Text wie
' "Als Text exportieren", der Strategievergleich, die Story des PDFs). Beim
' naechsten Nachbarn waehlt PySticky unter gleich weiten Stichen nach der
' Reihenfolge einer Python-Menge; fuer die Aufzeichnung bekam es Glutfadens
' Regel (der obere, dann der linke) -- sonst derselbe Algorithmus. Mit ihr ist
' der Pfad Stich fuer Stich derselbe.

=== stickplan: alle fuenf strategien wie pysticky
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")

DIM s AS INTEGER
FOR s = kern.SP_ZEILEN TO kern.SP_DIAGONAL
    DIM r AS kern.Stickpfad : r = kern.stickpfadBerechnen(m, s, 14)
    PRINT kern.spKennung$(s); ": "; geAbweichungen$(geLies$("plan_" + kern.spKennung$(s) + ".txt"), kern.stickplanText$(m, r))
NEXT
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/pdftext.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- datei plan_row_by_row.txt
