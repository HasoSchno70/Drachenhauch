1 3 10 30
0 2
<ARRAY[1 TO 3] OF INTEGER>
<ARRAY[-1 TO 1,4] OF STRING>
<ARRAY[3] OF INTEGER>

=== der debugger nennt die indizes ab der untergrenze
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("d.dh", ["{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "lines" + q + ":[5]}", _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "stop" + q + "}"])
DIM h AS INTEGER : h = ersteMit("paused", 5)
DIM k AS JSON_HANDLE : k = JSON_PARSE(ereignisse[h])
' Die Globalen kommen in keiner festen Reihenfolge -- sortiert ausgeben.
DIM zeilen AS ARRAY OF STRING
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(k, "globals") - 1
    DIM p AS STRING : p = "globals." + STR$(i)
    DIM z AS STRING : z = JSON_GET_STRING(k, p + ".name") + " " + JSON_GET_STRING(k, p + ".value")
    IF JSON_HAS(k, p + ".children") THEN
        DIM j AS INTEGER
        FOR j = 0 TO JSON_LEN(k, p + ".children") - 1
            z = z + " " + JSON_GET_STRING(k, p + ".children." + STR$(j) + ".name") + "=" + JSON_GET_STRING(k, p + ".children." + STR$(j) + ".value")
        NEXT
    END IF
    ARRAY_PUSH(zeilen, z)
NEXT
SORT(zeilen)
FOR i = 0 TO LEN(zeilen) - 1 : PRINT zeilen[i] : NEXT
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
DIM tage[1 TO 3] AS INTEGER
tage[1] = 10 : tage[3] = 30
DIM f[-1 TO 0, 1 TO 2] AS INTEGER
f[-1, 1] = 5 : f[0, 2] = 6
PRINT tage[1]

--- erwartet
