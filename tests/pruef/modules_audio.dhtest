=== music seek validation
IMPORT "audio"
TRY
    AUDIO_MUSIC_SEEK(-1.0)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_MUSIC_SEEK: Position muss >= 0 sein (war -1)

=== music seek ohne musik meldet sich
' Der Sprung braucht einen laufenden Griff -- den gibt es erst ab PLAY.
IMPORT "audio"
TRY
    AUDIO_MUSIC_SEEK(1.0)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_MUSIC_SEEK: es laeuft keine Musik -- erst AUDIO_MUSIC_PLAY()

=== unloadsound zaehler und tombstone
' UNLOADSOUND gibt frei, der Handle bleibt gueltig (Tombstone) und ein
IMPORT "audio"
DIM t AS SOUND
DIM v AS SOUND
t = AUDIO_TONE(440, 30, "square", 0.3)
PRINT AUDIO_SOUND_COUNT()
UNLOADSOUND(t)
PRINT AUDIO_SOUND_COUNT()
TRY
    PLAYSOUND(t)
    PRINT "kein Fehler"
CATCH e
    PRINT e
END TRY
v = AUDIO_TONE(880, 30, "sine", 0.3)
PRINT STR$(v) = STR$(t)
--- erwartet
1
0
PLAYSOUND: Sound 0 wurde freigegeben (UNLOADSOUND)
FALSE

=== lautstaerke ist linear und wird geklemmt
' Die Doku sagt '0..1' und (im Anhang) dass Kira intern in Dezibel
IMPORT "audio"
DIM t AS SOUND
DIM ch AS AUDIO_CHANNEL
t = AUDIO_TONE(440, 50, "sine", 0.3)
ch = AUDIO_PLAY(t, -1, 1.0)
AUDIO_VOLUME(ch, 0.25)
PRINT AUDIO_GET_VOLUME(ch)
AUDIO_VOLUME(ch, 5.0)
PRINT AUDIO_GET_VOLUME(ch)
AUDIO_STOP(ch)
--- erwartet
0.25
1.0

=== loops semantik
' `0` spielt einmal, `-1` endlos -- gemessen an einem 60-ms-Ton.
IMPORT "audio"
DIM t AS SOUND
DIM ch AS AUDIO_CHANNEL
t = AUDIO_TONE(440, 60, "sine", 0.2)
ch = AUDIO_PLAY(t, 0, 0.2)
SLEEP(250)
PRINT AUDIO_IS_PLAYING(ch)
ch = AUDIO_PLAY(t, -1, 0.2)
SLEEP(250)
PRINT AUDIO_IS_PLAYING(ch)
AUDIO_STOP(ch)
--- erwartet
FALSE
TRUE

=== music seek ohne play meldet sich
' Doku: 'der Aufruf meldet dann einen Fehler, statt stillschweigend
IMPORT "audio"
TRY
    AUDIO_MUSIC_SEEK(10.0)
    PRINT "kein Fehler"
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_MUSIC_SEEK: es laeuft keine Musik -- erst AUDIO_MUSIC_PLAY()

