' Glutfaden Stufe 20: Ebene leeren und ihre Notiz bearbeiten
' (kern/bearbeiten.dh, ansicht/seitenleiste.dh), Ansichtsschalter fuer
' Rueckstiche und Fortschritt, Zentrierhilfe und Spiegelachsen
' (ansicht/leinwand.dh), Pfeiltasten und Rollbalken (ansicht/flaechenteile.dh),
' Dateien aufs Fenster ziehen und die Tastenkuerzel-Uebersicht F1
' (ansicht/ablage.dh).
'
' Der erste Fall ist gegen PySticky aufgezeichnet (ClearLayerCommand: je
' Ebene leeren und zuruecknehmen, die gefuehrten Stichzahlen, die Zellen als
' MD5) -- die Erwartung IST diese Aufzeichnung, mit einer bewussten
' Abweichung: Ebene 1 von farbprobe.pxs ist schon leer, PySticky legte dafuer
' den Schritt "Ebene 'Oben' geleert" an, der nichts tut; hier ist es keiner
' (darum '' in dieser Zeile). Danach der Kern ohne Fenster und die Probe.

=== ebene leeren wie pysticky
IMPORT "helfer.dh"
FUNCTION kurz$(t AS STRING) AS STRING
    RETURN LEFT$(LOWER$(MD5$(t)), 12)
END FUNCTION

FUNCTION zahlen$(m AS kern.Muster) AS STRING
    DIM z AS ARRAY OF STRING : z = []
    DIM f AS kern.Farbeintrag
    FOR EACH f IN m.farben
        ARRAY_PUSH(z, STR$(f.stichzahl))
    NEXT
    RETURN JOIN$(z, ",")
END FUNCTION

SUB abzug(name AS STRING, m AS kern.Muster)
    PRINT name; ": "; m.breite; "x"; m.hoehe
    DIM i AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR i = 0 TO m.ebenen.anzahl() - 1
        DIM e AS kern.Ebene : e = m.ebenen.ebenen[i]
        DIM z AS ARRAY OF STRING : z = []
        FOR y = 0 TO m.hoehe - 1
            FOR x = 0 TO m.breite - 1
                DIM q AS INTEGER : q = y * m.breite + x
                IF e.raster[q] < 0 THEN CONTINUE
                ARRAY_PUSH(z, STR$(x) + "," + STR$(y) + "," + STR$(e.raster[q]) + "," + STR$(e.art[q]) + "," + STR$(IIF(e.erledigt[q] <> 0, 1, 0)))
            NEXT
        NEXT
        PRINT "  ebene "; i; " "; e.name; " "; IIF(e.sichtbar, "an", "aus"); ": "; LEN(z); " "; kurz$(JOIN$(z, ";"))
    NEXT
    DIM b AS ARRAY OF STRING : b = []
    DIM r AS kern.Rueckstich
    FOR EACH r IN m.rueckstiche
        ARRAY_PUSH(b, STR$(r.x1) + "," + STR$(r.y1) + "," + STR$(r.x2) + "," + STR$(r.y2) + "," + STR$(r.farbe))
    NEXT
    PRINT "  rueck "; LEN(b); " "; kurz$(JOIN$(b, ";"))
END SUB

DIM pfad AS STRING
FOR EACH pfad IN ["alle.pxs", "farbprobe.pxs", GLUTORDNER + "/daten/muster/demo_kreuzstich.pxs"]
    DIM name AS STRING : name = BASENAME(pfad)
    DIM m AS kern.Muster : m = kern.pxsLaden(pfad)
    m.stichzahlenNeu()
    PRINT name; " geladen: zahlen "; zahlen$(m)
    DIM i AS INTEGER, n AS INTEGER, ok AS BOOLEAN
    FOR i = 0 TO m.ebenen.anzahl() - 1
        DIM mi AS kern.Muster : mi = kern.pxsLaden(pfad)
        mi.stichzahlenNeu()
        DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
        n = kern.ebeneLeeren(mi, v, i)
        PRINT name; " leeren "; i; " '"; v.textZurueck$(); "': zahlen "; zahlen$(mi)
        abzug(name + " leeren " + STR$(i), mi)
        ok = v.zurueckNehmen(mi)
        PRINT name; " zurueck "; i; ": zahlen "; zahlen$(mi)
        abzug(name + " zurueck " + STR$(i), mi)
    NEXT
    DIM mg AS kern.Muster : mg = kern.pxsLaden(pfad)
    mg.stichzahlenNeu()
    mg.ebenen.ebenen[0].gesperrt = TRUE
    DIM vg AS kern.Verlauf : vg = kern.neuerVerlauf()
    n = kern.ebeneLeeren(mg, vg, 0)
    PRINT name; " gesperrt: zahlen "; zahlen$(mg)
    abzug(name + " gesperrt", mg)
NEXT
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
CONST GLUTORDNER = "{sammlung}/../../examples/glutfaden"
