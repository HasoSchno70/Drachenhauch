DHRT_FRAMES=40
--- nachher
FUNCTION lesen$(pfad AS STRING, trenner AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(pfad)
    DIM r AS STRING : r = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        IF i > 0 THEN r = r + trenner
        r = r + z[i]
    NEXT
    RETURN r
END FUNCTION
FUNCTION bild(quelle AS STRING, bilder AS STRING) AS INTEGER
    ' Ein Programm N Bilder laufen lassen (dhrt bild); liefert seinen Rueckgabewert.
    DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "bild", CWD$() + "/" + quelle, CWD$() + "/lauf.png", bilder)
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    WHILE PROCESS_RUNNING(pc) AND MILLIS() < bis
        SLEEP(50)
    WEND
    RETURN PROCESS_CODE(pc)
END FUNCTION
IMPORT "json"
' Die Maschine mit dem Leser der LAUFZEIT laden und einen Schritt fahren.
DIM p AS STRING : p = "IMPORT " + CHR$(34) + "animfsm" + CHR$(34) + CHR$(10) + "IMPORT " + CHR$(34) + "sprite" + CHR$(34) + CHR$(10)
p = p + "SCREEN(320, 240, " + CHR$(34) + "Pruefer" + CHR$(34) + ", 1)" + CHR$(10)
p = p + "DIM sp AS SPRITE : sp = SPRITE_NEW(LOADIMAGE(" + CHR$(34) + "raus.png" + CHR$(34) + "), 32, 32)" + CHR$(10)
p = p + "DIM f AS ANIM_FSM : f = ANIM_FSM_LOAD(" + CHR$(34) + "raus.dhanim" + CHR$(34) + ")" + CHR$(10)
p = p + "ANIM_FSM_SETUP(f, sp)" + CHR$(10) + "ANIM_FSM_UPDATE(f, sp, 16)" + CHR$(10)
p = p + "WRITEALL(" + CHR$(34) + "zustand.txt" + CHR$(34) + ", ANIM_FSM_STATE(f))" + CHR$(10)
WRITEALL("_programm/pruef.dh", p)
PRINT "pruefer " ; bild("_programm/pruef.dh", "3")
DIM h AS JSON_HANDLE : h = JSON_LOAD("_programm/raus.dhanim")
PRINT "version " ; JSON_GET_INT(h, "version") ; " params " ; JSON_LEN(h, "params") ; " uebergaenge " ; JSON_LEN(h, "transitions") ; " zustaende " ; JSON_LEN(h, "states")
PRINT JSON_GET_INT(h, "states.0.first") ; " " ; JSON_GET_INT(h, "states.0.last") ; " " ; JSON_GET_INT(h, "states.0.fps") ; " " ; JSON_GET_BOOL(h, "states.0.loop")
PRINT "start ist der zustand " ; JSON_GET_STRING(h, "default") = JSON_GET_STRING(h, "states.0.name")
PRINT "laufzeit steht darin " ; TRIM$(lesen$("_programm/zustand.txt", "")) = JSON_GET_STRING(h, "states.0.name")
--- erwartet
pruefer 0
version 1 params 0 uebergaenge 0 zustaende 1
0 0 8 TRUE
start ist der zustand TRUE
laufzeit steht darin TRUE

