' Ein Modul: Funktionen, die kein Fenster brauchen. Hier die Eintraege,
' mit denen eine leere Mediathek anfaengt -- eines davon verliehen.

FUNCTION beispiele() AS ARRAY OF Eintrag
    DIM daten AS ARRAY OF STRING
    daten = ["Momo|Michael Ende|Buch|1973", _
             "Metropolis|Fritz Lang|Film|1927", _
             "Tetris|Alexei Paschitnow|Spiel|1984", _
             "Kind of Blue|Miles Davis|Musik|1959", _
             "Emil und die Detektive|Erich Kästner|Buch|1929"]
    DIM m AS ARRAY OF Eintrag
    DIM d AS STRING
    FOR EACH d IN daten
        DIM t AS ARRAY OF STRING : t = SPLIT$(d, "|")
        ARRAY_PUSH(m, NEW Eintrag(t[0], t[1], t[2], t[3]))
    NEXT
    ' Ein Spiel ist gerade verliehen.
    m[2].verliehen = "Lena"
    RETURN m
END FUNCTION
