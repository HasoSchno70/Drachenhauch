--- erwartet
19: TRUE TRUE
7: TRUE TRUE
zeilen zu 19: TRUE
ohne passende zeile: TRUE
nur 19: TRUE ohne 7: TRUE
mwst = 19 -> TRUE
mwst<>7 -> TRUE
name = 'O B' -> TRUE
kunde.name >= "M" -> TRUE
mwst -> FALSE
= 19 -> FALSE
