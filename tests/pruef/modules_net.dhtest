=== tcp recv reassembles multibyte char split across reads
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
DIM srv AS NET_SOCKET
DIM i AS INTEGER
FOR i = 1 TO 50
    srv = NET_TCP_ACCEPT(l)
    IF NOT IS_NIL(srv) THEN BREAK
    SLEEP(2)
NEXT
DIM msg AS STRING
msg = "a" + CHR$(228) + CHR$(246) + CHR$(252) + "b"
NET_SEND(client, msg)
DIM result AS STRING
result = ""
DIM chunk AS STRING
FOR i = 1 TO 200
    chunk = NET_RECV(srv, 1)
    result = result + chunk
    IF LEN(result) = LEN(msg) THEN BREAK
    IF chunk = "" THEN SLEEP(2)
NEXT
PRINT result = msg
PRINT (CHR$(65533) IN result)
NET_CLOSE(client)
NET_CLOSE(srv)
NET_CLOSE_LISTENER(l)
--- erwartet
TRUE
FALSE

