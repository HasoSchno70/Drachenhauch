=== die teilflaeche zeigt ihre leiste
' Das Farbfeld (magenta) steht in der Teilflaeche bei (251, 72); das Fenster
' ist so gross wie die Gruppe (400 x 180).
IMPORT "helfer.dh"
DIM kennung AS STRING : kennung = "TeilBild-" + STR$(MILLIS()) + "-" + STR$(INT(RND() * 1000000))
DIM kind AS INTEGER : kind = PROCESS_START("dhrt", "run", CWD$() + "/teil.dh", "--", kennung, "raus")
DIM ps AS INTEGER : ps = PROCESS_START("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", pixel_skript$(), kennung, "groesse;300,100")
DIM s AS STRING : s = auslesen$(ps, 30000)
DIM k AS STRING : k = auslesen$(kind, 30000)
IF INSTR(auslesenFehler, "Kein Fenster moeglich") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    END
END IF
PRINT s; k;
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fenstersender.ps1"
END FUNCTION
