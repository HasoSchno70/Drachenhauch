' Star Pilot - Kap 18: JSON-Wellen + Boss-Fight.
'
' Was sich gegenueber Kap 17 geaendert hat:
'   - IMPORT "json" - Wellen-Daten aus waves.json laden
'   - Wave-Klasse liest size/interval/bomber_chance pro Welle aus JSON
'   - Neue Boss-Klasse mit drei Phasen (HP-basiert)
'   - Bei der Boss-Welle: nur ein Boss spawnt, mit hoher HP
'   - Boss-Tod -> "win"-Scene
'   - TRY/CATCH faengt fehlende waves.json ab (Default-Werte)
'   - Boss spawnt mit Named Arguments: NEW Boss(hp: 30, target_y: 50)

IMPORT "physics"
IMPORT "particles"
IMPORT "tween"
IMPORT "scene"
IMPORT "save"
IMPORT "ui"
IMPORT "json"

CONST WIDTH        AS INTEGER = 320
CONST HEIGHT       AS INTEGER = 240
CONST BG_COLOR     AS INTEGER = &H141E3C
CONST PLAYER_C     AS INTEGER = &HFFDC00
CONST BULLET_C     AS INTEGER = &HFFFFFF
CONST GRUNT_C      AS INTEGER = &HFF6677
CONST BOMBER_C     AS INTEGER = &HFFAA33
CONST BULLET_SPEED AS INTEGER = 5
CONST BULLET_POOL  AS INTEGER = 20
CONST ENEMY_POOL   AS INTEGER = 15
CONST GRUNT_PTS    AS INTEGER = 100
CONST BOMBER_PTS   AS INTEGER = 250
CONST INTRO_FRAMES AS INTEGER = 90
CONST SAVE_PATH    AS STRING  = "starpilot.save"
CONST WAVES_PATH   AS STRING  = "waves.json"
CONST BOSS_C       AS INTEGER = &HFF44AA

' Spieler-Geschwindigkeit ist veraenderbar (Optionen-Slider).
DIM player_speed AS INTEGER
' Trail-Effekt an/aus (Optionen-Checkbox)
DIM trail_on AS BOOLEAN

' --- ENUMs ---
'   GameState ist nicht mehr noetig - das macht jetzt das scene-Modul.
ENUM EnemyType = GRUNT, BOMBER

' --- Helper ---
FUNCTION Clamp(wert AS INTEGER, lo AS INTEGER, hi AS INTEGER) AS INTEGER
    IF wert < lo THEN RETURN lo
    IF wert > hi THEN RETURN hi
    RETURN wert
END FUNCTION

' --- Klassen wie in Kap 11 ---

CLASS Entity
    DIM x      AS INTEGER
    DIM y      AS INTEGER
    DIM w      AS INTEGER
    DIM h      AS INTEGER
    DIM alive  AS BOOLEAN

    SUB Init(start_x AS INTEGER, start_y AS INTEGER)
        x = start_x
        y = start_y
        alive = TRUE
        w = 16
        h = 16
    END SUB

    SUB Update()
    END SUB

    SUB Draw()
    END SUB
END CLASS

CLASS Player EXTENDS Entity
    DIM lives AS INTEGER

    SUB Init(start_x AS INTEGER, start_y AS INTEGER)
        x = start_x
        y = start_y
        alive = TRUE
        w = 40
        h = 24
        lives = 3
    END SUB

    SUB Update()
        IF KEYPRESSED(KEY_LEFT)  THEN x = x - PLAYER_SPEED
        IF KEYPRESSED(KEY_RIGHT) THEN x = x + PLAYER_SPEED
        x = Clamp(x, 0, WIDTH - w)
    END SUB

    SUB Draw()
        BOX(x, y, x + w, y + h, PLAYER_C)
    END SUB

    SUB TakeHit()
        lives = lives - 1
        IF lives <= 0 THEN alive = FALSE
    END SUB
END CLASS

CLASS Grunt EXTENDS Entity
    SUB Spawn(at_x AS INTEGER)
        x = at_x
        y = -16
        w = 16
        h = 14
        alive = TRUE
    END SUB
    SUB Update()
        IF NOT alive THEN RETURN
        y = y + 1
        IF y > HEIGHT THEN alive = FALSE
    END SUB
    SUB Draw()
        IF alive THEN BOX(x, y, x + w, y + h, GRUNT_C)
    END SUB
END CLASS

CLASS Bomber EXTENDS Entity
    DIM spawn_x AS INTEGER
    DIM swing AS TWEEN

    SUB Spawn(at_x AS INTEGER)
        spawn_x = at_x
        x = at_x
        y = -20
        w = 22
        h = 18
        alive = TRUE
        ' Pingpong-Tween fuer sanfte Zickzack-Bewegung um die Spawn-X.
        swing = TWEEN_NEW_PINGPONG(-50.0, 50.0, 2000, "inout_sine")
    END SUB
    SUB Update()
        IF NOT alive THEN RETURN
        y = y + 1
        x = spawn_x + INT(TWEEN_VALUE(swing))
        IF y > HEIGHT THEN alive = FALSE
    END SUB
    SUB Draw()
        IF alive THEN BOX(x, y, x + w, y + h, BOMBER_C)
    END SUB
END CLASS

CLASS Bullet
    DIM x      AS INTEGER
    DIM y      AS INTEGER
    DIM w      AS INTEGER
    DIM h      AS INTEGER
    DIM alive  AS BOOLEAN

    SUB Init()
        w = 3
        h = 8
        alive = FALSE
    END SUB
    SUB Spawn(at_x AS INTEGER, at_y AS INTEGER)
        x = at_x
        y = at_y
        alive = TRUE
    END SUB
    SUB Update()
        IF NOT alive THEN RETURN
        y = y - BULLET_SPEED
        IF y < -h THEN alive = FALSE
    END SUB
    SUB Draw()
        IF alive THEN BOX(x, y, x + w, y + h, BULLET_C)
    END SUB
END CLASS

' --- Boss: dicke Drohne mit drei Phasen, HP-basiert ---
CLASS Boss
    DIM x       AS INTEGER
    DIM y       AS INTEGER
    DIM w       AS INTEGER
    DIM h       AS INTEGER
    DIM hp      AS INTEGER
    DIM hp_max  AS INTEGER
    DIM phase   AS INTEGER
    DIM alive   AS BOOLEAN
    DIM swing   AS TWEEN

    SUB Init(start_hp AS INTEGER)
        w = 60
        h = 32
        hp = start_hp
        hp_max = start_hp
        phase = 1
        alive = FALSE       ' faengt nicht aktiv an - wird per Spawn aktiviert
        x = WIDTH / 2 - w / 2
        y = 30
        swing = TWEEN_NEW_PINGPONG(-100.0, 100.0, 4000, "inout_sine")
    END SUB

    SUB Spawn()
        hp = hp_max
        phase = 1
        alive = TRUE
        x = WIDTH / 2 - w / 2
        y = 30
        swing = TWEEN_NEW_PINGPONG(-100.0, 100.0, 4000, "inout_sine")
    END SUB

    SUB TakeHit()
        IF NOT alive THEN RETURN
        hp = hp - 1
        IF hp <= 0 THEN
            alive = FALSE
            RETURN
        END IF
        UpdatePhase()         ' impliziter Methoden-Aufruf
    END SUB

    SUB UpdatePhase()
        DIM ratio AS FLOAT
        ratio = (hp + 0.0) / hp_max
        IF ratio < 0.2 AND phase < 3 THEN
            phase = 3
            swing = TWEEN_NEW_PINGPONG(-120.0, 120.0, 1500, "inout_sine")
        ELSEIF ratio < 0.5 AND phase < 2 THEN
            phase = 2
            swing = TWEEN_NEW_PINGPONG(-110.0, 110.0, 2500, "inout_sine")
        END IF
    END SUB

    SUB Update()
        IF NOT alive THEN RETURN
        x = WIDTH / 2 - w / 2 + INT(TWEEN_VALUE(swing))
    END SUB

    SUB Draw()
        IF NOT alive THEN RETURN
        BOX(x, y, x + w, y + h, BOSS_C)
        ' HP-Balken
        BOX(WIDTH - 90, 24, WIDTH - 8, 30, &H400000)
        DIM hp_w AS INTEGER
        hp_w = INT((hp + 0.0) / hp_max * 82)
        BOX(WIDTH - 90, 24, WIDTH - 90 + hp_w, 30, BOSS_C)
        TEXT(WIDTH - 88, 14, f"BOSS: {hp}/{hp_max}", BOSS_C)
    END SUB
END CLASS

' --- Wave-Manager mit JSON-Konfiguration ---
CLASS Wave
    DIM number          AS INTEGER
    DIM enemies_left    AS INTEGER
    DIM spawn_timer     AS INTEGER
    DIM spawn_interval  AS INTEGER
    DIM bomber_chance   AS INTEGER

    SUB Init()
        number = 1
        StartCurrent()
    END SUB

    SUB StartCurrent()
        ' Werte aus JSON lesen, mit Fallback fuer Wellen, die nicht in der
        ' Datei definiert sind (Endlos-Modus jenseits Welle 5).
        DIM idx     AS INTEGER
        DIM n_waves AS INTEGER
        idx = number - 1
        n_waves = JSON_LEN(wave_data, "waves")
        IF idx < n_waves THEN
            DIM prefix AS STRING
            prefix = "waves." + STR$(idx) + "."
            enemies_left   = JSON_GET_INT(wave_data, prefix + "size")
            spawn_interval = JSON_GET_INT(wave_data, prefix + "interval")
            bomber_chance  = JSON_GET_INT(wave_data, prefix + "bomber_chance")
        ELSE
            ' Endlos: weitersteigender Schwierigkeitsgrad
            enemies_left   = 14 + (number - n_waves) * 2
            spawn_interval = 30 - (number - n_waves)
            IF spawn_interval < 15 THEN spawn_interval = 15
            bomber_chance  = 50
        END IF
        spawn_timer = spawn_interval
    END SUB

    FUNCTION ShouldSpawn() AS BOOLEAN
        IF enemies_left <= 0 THEN RETURN FALSE
        spawn_timer = spawn_timer - 1
        IF spawn_timer <= 0 THEN
            spawn_timer  = spawn_interval
            enemies_left = enemies_left - 1
            RETURN TRUE
        END IF
        RETURN FALSE
    END FUNCTION

    FUNCTION Cleared() AS BOOLEAN
        RETURN enemies_left <= 0
    END FUNCTION

    SUB NextWave()
        number = number + 1
        StartCurrent()
    END SUB
END CLASS

' --- Globale Spielobjekte ---
DIM player                 AS Player
DIM bullets[BULLET_POOL]   AS Bullet
DIM grunts[ENEMY_POOL]     AS Grunt
DIM bombers[ENEMY_POOL]    AS Bomber
DIM wave                   AS Wave

DIM explosion_fx           AS PARTICLE_SYSTEM
DIM trail_fx               AS PARTICLE_SYSTEM
DIM wave_intro_slide       AS TWEEN
DIM pause_slide            AS TWEEN
DIM save_data              AS SAVE_HANDLE
DIM wave_data              AS JSON_HANDLE
DIM boss                   AS Boss
DIM boss_at_wave           AS INTEGER
DIM boss_hp_init           AS INTEGER

DIM score              AS INTEGER
DIM highscore          AS INTEGER
DIM space_was_pressed  AS BOOLEAN
DIM p_was_pressed      AS BOOLEAN
DIM intro_frames_left  AS INTEGER

' --- Setup: laeuft EINMAL beim Programm-Start ---
SUB Setup()
    ' WICHTIG: wave_data laden BEVOR NEW Wave() ausgefuehrt wird -
    ' Wave.Init ruft StartCurrent, das aus wave_data liest. Wenn
    ' wave_data zu dem Zeitpunkt noch NIL ist, kommt JSON_LEN auf NIL.
    TRY
        wave_data = JSON_LOAD(WAVES_PATH)
        boss_at_wave = JSON_GET_INT(wave_data, "boss.wave")
        boss_hp_init = JSON_GET_INT(wave_data, "boss.hp")
    CATCH err
        ' Datei fehlt oder kaputt -> mit Defaults weiterleben
        PRINT "Warnung: " + err
        wave_data = JSON_PARSE("{ ""waves"": [], ""boss"": {} }")
        boss_at_wave = 6
        boss_hp_init = 30
    END TRY

    player = NEW Player(WIDTH / 2 - 20, HEIGHT - 40)
    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        bullets[i] = NEW Bullet()
    NEXT i
    FOR i = 0 TO ENEMY_POOL - 1
        grunts[i] = NEW Grunt(0, 0)
        grunts[i].alive = FALSE
        bombers[i] = NEW Bomber(0, 0)
        bombers[i].alive = FALSE
    NEXT i
    wave = NEW Wave()        ' liest wave_data fuer Welle 1
    boss = NEW Boss(boss_hp_init)

    ' Explosion: kurze, breite Funken
    explosion_fx = PARTICLE_SYSTEM_NEW(0, 0)
    PARTICLE_SET_VELOCITY(explosion_fx, -120, 120, -120, 120)
    PARTICLE_SET_LIFETIME(explosion_fx, 300, 600)
    PARTICLE_SET_COLOR(explosion_fx, &HFFAA00)
    PARTICLE_SET_SIZE(explosion_fx, 1, 3)
    PARTICLE_SET_FADE(explosion_fx, TRUE)

    ' Trail: kontinuierliche Wolke nach unten
    trail_fx = PARTICLE_SYSTEM_NEW(0, 0)
    PARTICLE_SET_VELOCITY(trail_fx, -10, 10, 30, 60)
    PARTICLE_SET_LIFETIME(trail_fx, 200, 400)
    PARTICLE_SET_COLOR(trail_fx, &HFF8800)
    PARTICLE_SET_SIZE(trail_fx, 1, 2)
    PARTICLE_SET_FADE(trail_fx, TRUE)

    space_was_pressed = FALSE
    p_was_pressed = FALSE
    score = 0

    ' Defaults fuer die Optionen
    player_speed = 3
    trail_on = TRUE

    ' Highscore aus der Save-Datei laden (oder 0 falls noch nie gespielt)
    save_data = SAVE_LOAD_OR_NEW(SAVE_PATH)
    highscore = SAVE_GET_INT_OR(save_data, "highscore", 0)

    RANDOMIZE(MILLIS())
    SCREEN(WIDTH, HEIGHT, "Star Pilot", 2)

    ' Erst-Scene: Hauptmenue
    SCENE_SWITCH("menu")
END SUB

' Speichert den aktuellen Highscore zurueck in die Datei.
SUB SaveHighscore()
    SAVE_SET_INT(save_data, "highscore", highscore)
    SAVE_WRITE(save_data, SAVE_PATH)
END SUB

' --- ResetGame: Lauf-spezifischer Reset, vom Menue aus aufgerufen ---
SUB ResetGame()
    player.x = WIDTH / 2 - 20
    player.y = HEIGHT - 40
    player.alive = TRUE
    player.lives = 3

    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        bullets[i].alive = FALSE
    NEXT i
    FOR i = 0 TO ENEMY_POOL - 1
        grunts[i].alive = FALSE
        bombers[i].alive = FALSE
    NEXT i

    wave = NEW Wave()        ' frische Welle 1
    score = 0
    space_was_pressed = FALSE
    ' Boss zuruecksetzen (alive = FALSE, wird beim Erreichen der Boss-Welle aktiviert)
    boss.alive = FALSE
END SUB

' Helper: startet das Wave-Intro-Overlay (Push + Tween + Counter)
SUB StartWaveIntro()
    SCENE_PUSH("wave_intro")
    intro_frames_left = INTRO_FRAMES
    wave_intro_slide = TWEEN_NEW(-20.0, HEIGHT / 2 - 4.0, 600, "out_back")
END SUB

SUB SpawnBullet(at_x AS INTEGER, at_y AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        IF NOT bullets[i].alive THEN
            bullets[i].Spawn(at_x, at_y)
            RETURN
        END IF
    NEXT i
END SUB

' Spawnt einen Gegner; Typ wird per ENUM uebergeben.
SUB SpawnEnemy(typ AS EnemyType, at_x AS INTEGER)
    DIM i AS INTEGER
    SELECT CASE typ
        CASE EnemyType.GRUNT
            FOR i = 0 TO ENEMY_POOL - 1
                IF NOT grunts[i].alive THEN
                    grunts[i].Spawn(at_x)
                    RETURN
                END IF
            NEXT i
        CASE EnemyType.BOMBER
            FOR i = 0 TO ENEMY_POOL - 1
                IF NOT bombers[i].alive THEN
                    bombers[i].Spawn(at_x)
                    RETURN
                END IF
            NEXT i
    END SELECT
END SUB

' Wie viele Gegner sind aktuell auf dem Bildschirm?
FUNCTION EnemiesAlive() AS INTEGER
    DIM count AS INTEGER
    count = 0
    DIM i AS INTEGER
    FOR i = 0 TO ENEMY_POOL - 1
        IF grunts[i].alive  THEN count = count + 1
        IF bombers[i].alive THEN count = count + 1
    NEXT i
    RETURN count
END FUNCTION

' Triggert eine Explosion an (cx, cy) mit count Partikeln.
SUB Explode(cx AS INTEGER, cy AS INTEGER, count AS INTEGER)
    PARTICLE_SET_POS(explosion_fx, cx, cy)
    PARTICLE_EMIT(explosion_fx, count)
END SUB

SUB CheckBulletEnemyCollisions()
    DIM i AS INTEGER
    DIM j AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        IF NOT bullets[i].alive THEN CONTINUE
        FOR j = 0 TO ENEMY_POOL - 1
            IF grunts[j].alive THEN
                IF PHYSICS_BOX_BOX(bullets[i].x, bullets[i].y, bullets[i].w, bullets[i].h, _
                                   grunts[j].x, grunts[j].y, grunts[j].w, grunts[j].h) THEN
                    bullets[i].alive = FALSE
                    grunts[j].alive  = FALSE
                    score = score + GRUNT_PTS
                    Explode(grunts[j].x + grunts[j].w / 2, grunts[j].y + grunts[j].h / 2, 25)
                END IF
            END IF
        NEXT j
        IF NOT bullets[i].alive THEN CONTINUE
        FOR j = 0 TO ENEMY_POOL - 1
            IF bombers[j].alive THEN
                IF PHYSICS_BOX_BOX(bullets[i].x, bullets[i].y, bullets[i].w, bullets[i].h, _
                                   bombers[j].x, bombers[j].y, bombers[j].w, bombers[j].h) THEN
                    bullets[i].alive = FALSE
                    bombers[j].alive = FALSE
                    score = score + BOMBER_PTS
                    Explode(bombers[j].x + bombers[j].w / 2, bombers[j].y + bombers[j].h / 2, 40)
                END IF
            END IF
        NEXT j
    NEXT i
END SUB

SUB CheckPlayerEnemyCollisions()
    DIM j AS INTEGER
    FOR j = 0 TO ENEMY_POOL - 1
        IF grunts[j].alive THEN
            IF PHYSICS_BOX_BOX(player.x, player.y, player.w, player.h, _
                               grunts[j].x, grunts[j].y, grunts[j].w, grunts[j].h) THEN
                grunts[j].alive = FALSE
                player.TakeHit()
                Explode(player.x + player.w / 2, player.y + player.h / 2, 50)
            END IF
        END IF
        IF bombers[j].alive THEN
            IF PHYSICS_BOX_BOX(player.x, player.y, player.w, player.h, _
                               bombers[j].x, bombers[j].y, bombers[j].w, bombers[j].h) THEN
                bombers[j].alive = FALSE
                player.TakeHit()
                Explode(player.x + player.w / 2, player.y + player.h / 2, 50)
            END IF
        END IF
    NEXT j
END SUB

' Bullet trifft Boss?
SUB CheckBulletBossCollision()
    IF NOT boss.alive THEN RETURN
    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        IF NOT bullets[i].alive THEN CONTINUE
        IF PHYSICS_BOX_BOX(bullets[i].x, bullets[i].y, bullets[i].w, bullets[i].h, _
                           boss.x, boss.y, boss.w, boss.h) THEN
            bullets[i].alive = FALSE
            boss.TakeHit()
            score = score + 50
            Explode(bullets[i].x, bullets[i].y, 8)
            ' Wenn Boss gerade gestorben: dicke finale Explosion
            IF NOT boss.alive THEN
                Explode(boss.x + boss.w / 2, boss.y + boss.h / 2, 80)
            END IF
        END IF
    NEXT i
END SUB

' Player rammt Boss?
SUB CheckPlayerBossCollision()
    IF NOT boss.alive THEN RETURN
    IF PHYSICS_BOX_BOX(player.x, player.y, player.w, player.h, _
                       boss.x, boss.y, boss.w, boss.h) THEN
        player.TakeHit()
        Explode(player.x + player.w / 2, player.y + player.h / 2, 50)
    END IF
END SUB

' --- Update pro Scene ----------------------------------------------

SUB UpdateMenu()
    IF KEYPRESSED(KEY_RETURN) THEN
        ResetGame()
        SCENE_SWITCH("playing")
        StartWaveIntro()              ' direkt mit Welle 1 ins Intro
    END IF
END SUB

SUB UpdatePlaying()
    ' P toggelt Pause - Edge-Detection
    DIM p_now AS BOOLEAN
    p_now = KEYPRESSED(KEY_P)
    IF p_now AND NOT p_was_pressed THEN
        p_was_pressed = p_now
        SCENE_PUSH("pause")
        pause_slide = TWEEN_NEW(-110.0, 0.0, 250, "out_back")
        RETURN
    END IF
    p_was_pressed = p_now

    player.Update()

    ' Player-Trail: kontinuierliche Emission unter dem Schiff (wenn aktiviert)
    IF trail_on THEN
        PARTICLE_SET_POS(trail_fx, player.x + player.w / 2, player.y + player.h)
        PARTICLE_EMIT(trail_fx, 2)
    END IF

    DIM space_now AS BOOLEAN
    space_now = KEYPRESSED(KEY_SPACE)
    IF space_now AND NOT space_was_pressed THEN
        SpawnBullet(player.x + player.w / 2 - 1, player.y - 8)
    END IF
    space_was_pressed = space_now

    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        bullets[i].Update()
    NEXT i
    FOR i = 0 TO ENEMY_POOL - 1
        grunts[i].Update()
        bombers[i].Update()
    NEXT i

    boss.Update()
    CheckBulletEnemyCollisions()
    CheckPlayerEnemyCollisions()
    CheckBulletBossCollision()
    CheckPlayerBossCollision()

    IF NOT player.alive THEN
        ' Neuer Highscore? Dann sofort speichern.
        DIM is_new_hi AS BOOLEAN
        is_new_hi = FALSE
        IF score > highscore THEN
            highscore = score
            SaveHighscore()
            is_new_hi = TRUE
        END IF
        ' Werte erst NACH dem SWITCH in die neue Scene setzen
        DIM final AS INTEGER
        final = score
        SCENE_SWITCH("gameover")
        SCENE_SET_INT("final_score", final)
        SCENE_SET_BOOL("new_highscore", is_new_hi)
        RETURN
    END IF

    ' Boss erlegt? -> Win-Scene
    IF wave.number = boss_at_wave AND NOT boss.alive AND EnemiesAlive() = 0 THEN
        IF score > highscore THEN
            highscore = score
            SaveHighscore()
        END IF
        DIM win_score AS INTEGER
        win_score = score
        SCENE_SWITCH("win")
        SCENE_SET_INT("final_score", win_score)
        RETURN
    END IF

    ' Boss-Welle: keine normale Spawn-Logik, der Boss laeuft schon (oder
    ' wird gleich beim Wave-Start gespawnt - siehe StartWaveIntro-Anpassung).
    IF wave.number = boss_at_wave THEN
        RETURN
    END IF

    ' Wave-Logik: spawnen falls noetig, oder Welle abschliessen
    IF wave.ShouldSpawn() THEN
        DIM typ AS EnemyType
        IF INT(RND() * 100) < wave.bomber_chance THEN
            typ = EnemyType.BOMBER
            SpawnEnemy(typ, INT(RND() * (WIDTH - 22)))
        ELSE
            typ = EnemyType.GRUNT
            SpawnEnemy(typ, INT(RND() * (WIDTH - 16)))
        END IF
    END IF

    IF wave.Cleared() AND EnemiesAlive() = 0 THEN
        wave.NextWave()
        StartWaveIntro()              ' Push als Overlay
        ' Wenn naechste Welle die Boss-Welle ist: Boss spawnen
        IF wave.number = boss_at_wave THEN
            boss.Spawn()
        END IF
    END IF
END SUB

SUB UpdateWaveIntro()
    intro_frames_left = intro_frames_left - 1
    IF intro_frames_left <= 0 THEN
        SCENE_POP()                   ' zurueck zu "playing"
    END IF
END SUB

SUB UpdateGameOver()
    IF KEYPRESSED(KEY_RETURN) THEN
        SCENE_SWITCH("menu")
    END IF
END SUB

SUB UpdateWin()
    IF KEYPRESSED(KEY_RETURN) THEN
        SCENE_SWITCH("menu")
    END IF
END SUB

' --- Pause: keine eigentliche Update-Logik, nur die Buttons werden in
'     DrawPause angeklickt. P toggelt zurueck. ---
SUB UpdatePause()
    DIM p_now AS BOOLEAN
    p_now = KEYPRESSED(KEY_P)
    IF p_now AND NOT p_was_pressed THEN
        p_was_pressed = p_now
        SCENE_POP()
        RETURN
    END IF
    p_was_pressed = p_now
END SUB

' Optionen: Slider und Checkbox lesen die ui-Eingabe in DrawOptions.
' UpdateOptions selbst ist leer; die ui-Builtins arbeiten in der Draw-Phase.
SUB UpdateOptions()
END SUB

' --- Draw pro Scene ------------------------------------------------

SUB DrawMenu()
    CLS(BG_COLOR)
    TEXT(WIDTH / 2 - 40, 60, "STAR PILOT", PLAYER_C)
    TEXT(WIDTH / 2 - 60, 100, f"Highscore: {highscore}", &HFFDC00)
    TEXT(WIDTH / 2 - 84, 140, "ENTER zum Starten", &HFFFFFF)
    TEXT(WIDTH / 2 - 60, 160, "ESC zum Beenden", &HCCCCCC)
END SUB

SUB DrawHUD()
    TEXT(8, 8,  f"Score: {score}",        PLAYER_C)
    TEXT(8, 22, f"Lives: {player.lives}", &HFFFFFF)
    TEXT(WIDTH - 80, 8, f"Welle: {wave.number}", &HFFFFFF)
END SUB

SUB DrawGameWorld()
    ' Trail unten, Spielobjekte mitte, Explosionen oben
    PARTICLE_DRAW(trail_fx)

    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        bullets[i].Draw()
    NEXT i
    FOR i = 0 TO ENEMY_POOL - 1
        grunts[i].Draw()
        bombers[i].Draw()
    NEXT i
    boss.Draw()
    player.Draw()

    PARTICLE_DRAW(explosion_fx)
END SUB

SUB DrawPlaying()
    CLS(BG_COLOR)
    DrawGameWorld()
    DrawHUD()
END SUB

SUB DrawWaveIntro()
    ' Spielwelt unter dem Overlay anzeigen (sieht „eingefroren" aus)
    CLS(BG_COLOR)
    DrawGameWorld()
    DrawHUD()
    ' Schriftzug gleitet per Tween von oben in die Mitte
    TEXT(WIDTH / 2 - 36, INT(TWEEN_VALUE(wave_intro_slide)), _
         f"WELLE {wave.number}", PLAYER_C)
END SUB

SUB DrawGameOver()
    CLS(BG_COLOR)
    DrawGameWorld()
    DrawHUD()
    TEXT(WIDTH / 2 - 36, HEIGHT / 2 - 24, "GAME OVER", &HFF4444)
    DIM final_score AS INTEGER
    final_score = SCENE_GET_INT_OR("final_score", 0)
    TEXT(WIDTH / 2 - 70, HEIGHT / 2 - 8, _
         f"Endstand: {final_score}", &HFFFFFF)

    ' Wenn neuer Highscore: feiern!
    IF SCENE_GET_BOOL_OR("new_highscore", FALSE) THEN
        TEXT(WIDTH / 2 - 60, HEIGHT / 2 + 8, "NEUER HIGHSCORE!", PLAYER_C)
    ELSE
        TEXT(WIDTH / 2 - 70, HEIGHT / 2 + 8, _
             f"Highscore: {highscore}", &HCCCCCC)
    END IF

    TEXT(WIDTH / 2 - 84, HEIGHT / 2 + 28, "ENTER -> zurueck zum Menue", &HCCCCCC)
END SUB

SUB DrawPause()
    ' Spielwelt unten weiter zeichnen (eingefroren-Look)
    CLS(BG_COLOR)
    DrawGameWorld()
    DrawHUD()

    ' Panel-Y per Tween, Pop-In von oben
    DIM panel_y AS INTEGER
    panel_y = 60 + INT(TWEEN_VALUE(pause_slide))

    ' Halbtransparentes Panel (wir simulieren mit dunklem Block + Rahmen)
    BOX(60, panel_y, 260, panel_y + 110, &H1E2845)
    RECT(60, panel_y, 260, panel_y + 110, PLAYER_C)
    TEXT(WIDTH / 2 - 24, panel_y + 8, "PAUSE", PLAYER_C)

    IF UI_BUTTON("p_resume",  80, panel_y + 30, 160, 22, "Weiter (P)") THEN
        SCENE_POP()
    END IF
    IF UI_BUTTON("p_options", 80, panel_y + 56, 160, 22, "Optionen") THEN
        SCENE_PUSH("options")
    END IF
    IF UI_BUTTON("p_quit",    80, panel_y + 82, 160, 22, "Zurueck zum Menue") THEN
        SCENE_SWITCH("menu")
    END IF
END SUB

SUB DrawWin()
    CLS(BG_COLOR)
    DrawHUD()
    TEXT(WIDTH / 2 - 40, 60, "DU HAST GEWONNEN!", PLAYER_C)
    DIM final_score AS INTEGER
    final_score = SCENE_GET_INT_OR("final_score", 0)
    TEXT(WIDTH / 2 - 70, 100, f"Endstand: {final_score}", &HFFFFFF)
    TEXT(WIDTH / 2 - 60, 130, f"Highscore: {highscore}", &HCCCCCC)
    TEXT(WIDTH / 2 - 84, 170, "ENTER -> zurueck zum Menue", &HCCCCCC)
END SUB

SUB DrawOptions()
    CLS(BG_COLOR)
    DrawGameWorld()
    DrawHUD()

    BOX(40, 50, 280, 200, &H1E2845)
    RECT(40, 50, 280, 200, PLAYER_C)
    TEXT(WIDTH / 2 - 36, 60, "OPTIONEN", PLAYER_C)

    UI_LABEL(56, 90, "Geschwindigkeit:", &HFFFFFF)
    DIM speed_value AS FLOAT
    speed_value = UI_SLIDER("opt_speed", 56, 108, 200, 1.0, 6.0, player_speed + 0.0)
    player_speed = INT(speed_value)
    UI_LABEL(260, 108, f"{player_speed}", PLAYER_C)

    trail_on = UI_CHECKBOX("opt_trail", 56, 138, "Triebwerks-Trail an", trail_on)

    IF UI_BUTTON("opt_back", 56, 168, 200, 22, "Zurueck") THEN
        SCENE_POP()
    END IF
END SUB

' --- Hauptprogramm ----------------------------------------------------
Setup()

WHILE NOT QUITREQUESTED()
    ' Update pro Scene
    SELECT CASE SCENE_CURRENT()
        CASE "menu"
            UpdateMenu()
        CASE "playing"
            UpdatePlaying()
        CASE "wave_intro"
            UpdateWaveIntro()
        CASE "gameover"
            UpdateGameOver()
        CASE "win"
            UpdateWin()
        CASE "pause"
            UpdatePause()
        CASE "options"
            UpdateOptions()
    END SELECT

    ' Particles laufen IMMER weiter - sonst wuerden Funken einfrieren
    PARTICLE_UPDATE(explosion_fx, 16)
    PARTICLE_UPDATE(trail_fx, 16)

    ' Draw pro Scene
    SELECT CASE SCENE_CURRENT()
        CASE "menu"
            DrawMenu()
        CASE "playing"
            DrawPlaying()
        CASE "wave_intro"
            DrawWaveIntro()
        CASE "gameover"
            DrawGameOver()
        CASE "win"
            DrawWin()
        CASE "pause"
            DrawPause()
        CASE "options"
            DrawOptions()
    END SELECT
    UI_END_FRAME()
    FLIP()
    SLEEP(16)
WEND
