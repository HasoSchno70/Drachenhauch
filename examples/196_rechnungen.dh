GUI_MENU_SEPARATOR(mDatei)
DIM miPdf AS INTEGER : miPdf = GUI_MENU_ITEM(mDatei, "Rechnung als PDF ...", "Strg+P")
DIM miCsv AS INTEGER : miCsv = GUI_MENU_ITEM(mDatei, "Alle Rechnungen als CSV", "Strg+E")
GUI_MENU_SEPARATOR(mDatei)
DIM miEinst AS INTEGER : miEinst = GUI_MENU_ITEM(mDatei, "Einstellungen ...")
GUI_MENU_SEPARATOR(mDatei)
DIM miEnde AS INTEGER : miEnde = GUI_MENU_ITEM(mDatei, "Beenden", "Strg+Q")
DIM mBearb AS INTEGER : mBearb = GUI_MENU(win, "Bearbeiten")
DIM miSpeichern AS INTEGER : miSpeichern = GUI_MENU_ITEM(mBearb, "Speichern", "Strg+S")
DIM miLoeschen AS INTEGER : miLoeschen = GUI_MENU_ITEM(mBearb, "Loeschen", "Strg+Entf")
DIM mHilfe AS INTEGER : mHilfe = GUI_MENU(win, "Hilfe")
DIM miUeber AS INTEGER : miUeber = GUI_MENU_ITEM(mHilfe, "Ueber Rechnungen")

GUI_TABS(win, ["Kunden", "Artikel", "Rechnungen"])

DIM lblStatus AS GUI_WIDGET : lblStatus = GUI_LABEL(win, "Bereit.", 12, SH - KOPF - 30)
GUI_SET_BOUNDS(lblStatus, 12, SH - KOPF - 30, SW - 24, 18)
GUI_SET_ANCHOR(lblStatus, "lrb")

SUB status(t AS STRING)
    GUI_SET_TEXT(lblStatus, t)
    GUI_SET_COLOR(lblStatus, "fg", RGB(200, 200, 200))
END SUB
SUB fehler(t AS STRING)
    GUI_SET_TEXT(lblStatus, t)
    GUI_SET_COLOR(lblStatus, "fg", ROT)
END SUB

' Ein Widget auf einen Reiter legen -- die Kinder eines Behaelters muessen
' es EINZELN, der Behaelter vererbt den Reiter nicht.
SUB reiter(w AS GUI_WIDGET, seite AS INTEGER)
    GUI_SET_TAB(w, seite)
END SUB

' Ein beschriftetes Feld in einer Spalte: Beschriftung + Textfeld, beide im
' Behaelter, beide auf dem Reiter. Liefert das Textfeld.
FUNCTION feld(spalte AS GUI_WIDGET, seite AS INTEGER, titel AS STRING, platzhalter AS STRING) AS GUI_WIDGET
    DIM l AS GUI_WIDGET : l = GUI_LABEL(win, titel, 0, 0)
    DIM t AS GUI_WIDGET : t = GUI_TEXTINPUT(win, 0, 0, 0, 0, platzhalter)
    reiter(l, seite) : reiter(t, seite)
    GUI_LAYOUT_ADD(spalte, l) : GUI_LAYOUT_ADD(spalte, t)
    RETURN t
END FUNCTION

' ============================================================ Reiter 0: Kunden
DIM tabH AS INTEGER : tabH = SH - KOPF - 52
DIM formX AS INTEGER : formX = SW - 350
DIM formW AS INTEGER : formW = 338

DIM tKunden AS GUI_WIDGET
tKunden = GUI_TABLE(win, 12, 12, formX - 24, tabH, ["Name", "Ort", "E-Mail"], [])
GUI_TABLE_COL_WIDTHS(tKunden, [220, 140, 240])
GUI_TABLE_SET(tKunden, "filterzeile", 1)
GUI_SET_ANCHOR(tKunden, "lrtb")
