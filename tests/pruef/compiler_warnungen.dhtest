' (Bis Stufe 47 in test_compiler_warnungen.py.)
IMPORT "json"
' dhrt --check als Kind; jede Zusage fragt die Meldungstexte.
FUNCTION lesen$(pc AS INTEGER) AS STRING
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM r AS STRING : r = ""
    DIM stille AS INTEGER : stille = 0
    WHILE MILLIS() < bis AND stille < 5
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN r = r + zz : stille = 0
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
    WEND
    RETURN r
END FUNCTION
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", "w.dh")
DIM roh AS STRING : roh = TRIM$(lesen$(pc))
IF roh = "" THEN roh = "[]"
DIM h AS JSON_HANDLE : h = JSON_PARSE("{" + CHR$(34) + "b" + CHR$(34) + ":" + roh + "}")
DIM meldungen AS ARRAY OF STRING : meldungen = []
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(h, "b") - 1
    ARRAY_PUSH(meldungen, JSON_GET_STRING(h, "b." + STR$(i) + ".message"))
NEXT
' "A|B": gibt es EINE Meldung, die A und B enthaelt?
FUNCTION eine$(teile AS STRING) AS STRING
    DIM t AS ARRAY OF STRING : t = SPLIT$(teile, "|")
    DIM j AS INTEGER
    DIM k AS INTEGER
    FOR j = 0 TO LEN(meldungen) - 1
        DIM alle AS BOOLEAN : alle = TRUE
        FOR k = 0 TO LEN(t) - 1
            IF INSTR(meldungen[j], t[k]) < 0 THEN alle = FALSE
        NEXT
        IF alle THEN RETURN "TRUE"
    NEXT
    RETURN "FALSE"
END FUNCTION
FUNCTION wieviele(teil AS STRING) AS INTEGER
    DIM n AS INTEGER : n = 0
    DIM j AS INTEGER
    FOR j = 0 TO LEN(meldungen) - 1
        IF INSTR(meldungen[j], teil) >= 0 THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
PRINT "eine meldung mit ['p.name']: "; eine$("'p.name'")
--- datei w.dh
CLASS P
    DIM name AS STRING
END CLASS
DIM p AS P
p = NEW P()
p.name = 5

--- erwartet
eine meldung mit ['p.name']: TRUE

