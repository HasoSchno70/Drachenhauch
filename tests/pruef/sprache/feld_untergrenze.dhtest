=== zwei dimensionen negativ und gemischt
DIM f[-2 TO 2, -1 TO 1] AS STRING
f[-2, -1] = "links oben"
f[2, 1] = "rechts unten"
f[0, 0] = "mitte"
PRINT f[-2, -1]; " | "; f[0, 0]; " | "; f[2, 1]; " | "; LEN(f)
DIM g[5, 1 TO 3] AS FLOAT
g[4, 3] = 2.5
g[0, 1] = 1.5
PRINT g[0, 1] + g[4, 3]
TRY
    PRINT g[0, 0]
CATCH e
    PRINT e
END TRY
TRY
    PRINT f[-3, 0]
CATCH e
    PRINT e
END TRY
