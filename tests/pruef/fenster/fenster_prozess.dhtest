WEND

--- nachher
FUNCTION herz$() AS STRING
    IF NOT FILEEXISTS("herz.txt") THEN RETURN ""
    DIM z AS ARRAY OF STRING : z = READLINES("herz.txt")
    IF LEN(z) = 0 THEN RETURN ""
    RETURN z[0]
END FUNCTION
PRINT "vom kind " ; READLINES("vom_kind.txt")[0]
SLEEP(1000)
DIM stand AS STRING : stand = herz$()
SLEEP(1500)
PRINT "herz steht still " ; herz$() = stand
--- erwartet
vom kind angekommen
herz steht still TRUE
