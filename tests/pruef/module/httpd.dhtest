--- datei srv.dh
IMPORT "httpd"
DIM s AS HTTPD
s = HTTPD_START(0)
EPRINT("PORT=" + STR$(HTTPD_PORT(s)))
WHILE NOT HTTPD_ACCEPT(s)
    SLEEP(5)
WEND
HTTPD_SEND(s, 200, "text/plain", HTTPD_METHOD$(s) + " " + HTTPD_PATH$(s))
HTTPD_STOP(s)

