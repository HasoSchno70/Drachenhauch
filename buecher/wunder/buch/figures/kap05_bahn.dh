' Bild fuer Kapitel 5: die Bahn EINES Funkens, Schritt fuer Schritt.
' Jeder Punkt ist eine Stelle nach 0,1 Sekunden; die Striche zeigen die
' Geschwindigkeit an dieser Stelle. So sieht man, was die drei Zeilen
' der Schleife tun: die Schwere biegt die Pfeile nach unten.
CONST SCHWERE = 120.0
CONST SCHRITT = 0.1

SCREEN(800, 500, "Bahn")
DIM bild AS INTEGER
FOR bild = 1 TO 3
    CLS(RGB(8, 10, 24))
    DIM x AS FLOAT : x = 100
    DIM y AS FLOAT : y = 450
    DIM vx AS FLOAT : vx = 140
    DIM vy AS FLOAT : vy = -260
    DIM t AS INTEGER
    FOR t = 0 TO 42
        IF t MOD 6 = 0 THEN
            DIM px AS INTEGER : px = INT(x + vx * 0.35)
            DIM py AS INTEGER : py = INT(y + vy * 0.35)
            LINEW(INT(x), INT(y), px, py, 3, RGB(90, 160, 230))
            CIRCLE(px, py, 4, RGB(90, 160, 230))
        END IF
        CIRCLE(INT(x), INT(y), 3, RGB(255, 220, 120))
        vy = vy + SCHWERE * SCHRITT
        x = x + vx * SCHRITT
        y = y + vy * SCHRITT
    NEXT
    TEXT(112, 462, "Start", RGB(160, 170, 200))
    TEXT(330, 140, "hoechster Punkt: vy = 0", RGB(160, 170, 200))
    TEXT(20, 20, "Punkte: alle 0,1 Sekunden", RGB(160, 170, 200))
    TEXT(20, 44, "Pfeile: Geschwindigkeit (vx, vy)", RGB(90, 160, 230))
    FLIP()
NEXT
