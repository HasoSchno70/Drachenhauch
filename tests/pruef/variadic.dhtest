=== variadic must be last (1)
' `SUB foo(...args, x)` -> ParseError.
SUB foo(...args, x AS INTEGER)
END SUB
--- fehler
Variadic-Parameter (`...args`) muss der letzte Parameter sein

=== variadic must be last (2)
' `SUB foo(...args, x)` -> ParseError.
SUB foo(...args, x AS INTEGER)
END SUB
--- fehler
Variadic-Parameter (`...args`) muss der letzte Parameter sein

=== variadic two variadic rejected (1)
' Zwei Variadic-Params -> ParseError.
SUB foo(...a, ...b)
END SUB
--- fehler
Variadic-Parameter (`...args`) muss der letzte Parameter sein

=== variadic two variadic rejected (2)
' Zwei Variadic-Params -> ParseError.
SUB foo(...a, ...b)
END SUB
--- fehler
Variadic-Parameter (`...args`) muss der letzte Parameter sein

=== variadic passed to helper (1)
' Die gesammelten Args koennen als TUPLE an andere Funktionen
FUNCTION first_or_default(t AS TUPLE, dflt AS INTEGER) AS INTEGER
    IF t.length() = 0 THEN RETURN dflt
    RETURN t[0]
END FUNCTION

FUNCTION head(...nums) AS INTEGER
    RETURN first_or_default(nums, -1)
END FUNCTION

PRINT head()
PRINT head(42, 99)
--- erwartet
-1
42

=== variadic passed to helper (2)
' Die gesammelten Args koennen als TUPLE an andere Funktionen
FUNCTION first_or_default(t AS TUPLE, dflt AS INTEGER) AS INTEGER
    IF t.length() = 0 THEN RETURN dflt
    RETURN t[0]
END FUNCTION

FUNCTION head(...nums) AS INTEGER
    RETURN first_or_default(nums, -1)
END FUNCTION

PRINT head()
PRINT head(42, 99)
--- erwartet
-1
42

=== variadic mixed types (1)
' TUPLE kann Werte verschiedener Typen halten.
SUB describe(...items)
    DIM i AS INTEGER
    FOR i = 0 TO items.length() - 1
        PRINT items[i]
    NEXT
END SUB

describe(1, "zwei", 3.5, TRUE)
--- erwartet
1
zwei
3.5
TRUE

