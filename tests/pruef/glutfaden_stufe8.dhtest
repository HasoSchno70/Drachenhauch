' Glutfaden Stufe 8: das Muster auswerten -- Statistik, Fortschritt,
' Schwierigkeit, Garnverbrauch, Zeit, Statistik-CSV, Heatmap,
' Farbenblindheit, aehnliche Farben (kern/analyse.dh, ansicht/analyse*.dh).
'
' Die Beilagen hat PySticky selbst aufgezeichnet (ref_analyse.py: dieselben
' Rechnungen wie seine Dialoge, ohne Qt). probe.pxs hat PySticky gebaut und
' gesichert: drei Ebenen (eine unsichtbar, eine verdeckt teils die untere),
' eine ausgelassene Farbe, ein Blend, Perlen, Halb- und Viertelstiche,
' Erledigtes, Rueckstiche, eine unbenutzte Farbe, zwei aehnliche Rots.

=== analyse: alles wie pysticky am probemuster
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")

PRINT geAbweichungen$(geLies$("ref.txt"), analyseText$(m))
WRITEALL("aus.csv", kern.statistikCsv$(m, 14, 20, 1.5))
PRINT "csv byte-gleich: "; BUFFER_TO_STRING$(READALL_BYTES("aus.csv")) = BUFFER_TO_STRING$(READALL_BYTES("ref.csv"))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_analyse.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- datei probe.pxs
