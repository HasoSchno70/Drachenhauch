' Aus test_gui_text_formular.py uebertragen (24 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.
' Die Faelle laufen nacheinander: tippt ueber die Zwischenablage -- die gibt es nur einmal.
--- seriell

=== umbruch laesst die hoehe wachsen
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM l AS GUI_WIDGET
l = GUI_LABEL(w, "Ein Satz mit vielen Woertern, der nicht in eine Zeile passt", 10, 10)
PRINT GUI_GET_H(l)
GUI_SET_WRAP(l, 150)
GUI_UPDATE()
PRINT GUI_GET_W(l) : PRINT GUI_GET_H(l)
GUI_SET_WRAP(l, 0)
GUI_UPDATE()
PRINT GUI_GET_H(l)
--- umgebung
DHRT_FRAMES=1
--- erwartet
16
150
120
120

=== umbruch nur fuer beschriftungen
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "x", 10, 10, 80, 26)
TRY
    GUI_SET_WRAP(b, 100)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
GUI_SET_WRAP: nur eine Beschriftung (GUI_LABEL) kann umbrechen

=== ausrichtung wird gespeichert und geprueft
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM l AS GUI_WIDGET
l = GUI_LABEL(w, "rechts", 10, 10)
GUI_SET_BOUNDS(l, 10, 10, 200, 16)
GUI_SET_ALIGN(l, "rechts")
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "OK", 10, 40, 100, 26)
GUI_SET_ALIGN(b, "links")
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT GUI_TO_JSON(w2) = j
TRY
    GUI_SET_ALIGN(l, "oben")
CATCH e
    PRINT e
END TRY
DIM s AS GUI_WIDGET : s = GUI_SLIDER(w, 10, 80, 100, 0, 1)
TRY
    GUI_SET_ALIGN(s, "mitte")
CATCH e2
    PRINT e2
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
TRUE
GUI_SET_ALIGN: 'oben' unbekannt -- links, mitte oder rechts
GUI_SET_ALIGN: nur Beschriftung, Knopf und Textfeld haben eine Ausrichtung

=== einfuegen ueber die zwischenablage geht ueberhaupt
' Die Gegenprobe fuer alles Weitere: ohne Filter kommt an, was in der
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
GUI_FOCUS(tf)
CLIPBOARD_SET("hallo")
DIM f AS INTEGER
FOR f = 1 TO 10
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT
PRINT GUI_TEXT(tf)
--- datei ev.txt
# Test-Aufnahme
c 4
e 3 2 341 0 0 0 // Event: test
e 3 2 86 0 0 0 // Event: test
e 4 1 86 0 0 0 // Event: test
e 4 1 341 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=12
--- erwartet
hallo

