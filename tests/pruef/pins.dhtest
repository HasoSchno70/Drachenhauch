' Module `gpio`, `i2c` und `spi` (src/pins.rs): die Pins des Kernels.
'
' Ohne Raspberry Pi: die Faelle mit "sim" laufen gegen die Simulatoren des
' Kernels, die tests/pruef/_hilfen/pins_simulieren.sh auf einem Linux-
' Rechner einrichtet (die CI tut das auf dem Linux-Laeufer):
'   DH_TEST_GPIO      Beschriftung des gpio-sim-Chips ("dhsim")
'   DH_TEST_GPIO_SIM  Ordner seiner Dateien sim_gpioN/{value,pull}
'   DH_TEST_I2C       Nummer des i2c-stub-Busses (Baustein an 0x50)
' Fehlen sie, ueberspringen sich die Faelle. Fuer SPI gibt es keinen
' Simulator -- geprueft sind dort die Meldungen; die Aufbauten der Auftraege
' und die ioctl-Nummern prueft der Rust-Test in pins.rs.
' Format: docs/werkzeuge.md, dhrt test.

=== die befehle stehen im verzeichnis
FUNCTION bekannt(name AS STRING) AS BOOLEAN
    DIM v AS ARRAY OF STRING : v = CODE_COMPLETE(name, 1, LEN(name) + 1)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(v) - 1
        IF UPPER$(v[i]) = UPPER$(name) THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
DIM namen AS ARRAY OF STRING
namen = SPLIT$("GPIO_CHIPS GPIO_OPEN GPIO_CLOSE GPIO_LABEL$ GPIO_COUNT GPIO_LINE_NAME$ " + _
    "GPIO_FIND GPIO_MODE GPIO_WRITE GPIO_READ GPIO_WATCH GPIO_RELEASE GPIO_NEXT " + _
    "GPIO_EVENT_PIN GPIO_EVENT_RISING GPIO_EVENT_TIME " + _
    "I2C_OPEN I2C_CLOSE I2C_WRITE I2C_READ I2C_SCAN " + _
    "SPI_OPEN SPI_CLOSE SPI_TRANSFER SPI_WRITE SPI_READ SPI_SPEED SPI_MODE", " ")
DIM i AS INTEGER
FOR i = 0 TO LEN(namen) - 1
    IF NOT bekannt(namen[i]) THEN PRINT "fehlt: " + namen[i]
NEXT
PRINT STR$(LEN(namen)) + " geprueft"
--- erwartet
28 geprueft

