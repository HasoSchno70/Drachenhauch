' --- GObject und GLib
' g_signal_connect ist in C ein Makro; je Form des Rueckrufs ein Name.
DECLARE FUNCTION signal LIB GOBJECT ALIAS "g_signal_connect_data" _
    (objekt AS ZEIGER, name AS TEXT, rueckruf AS SUB(objekt AS ZEIGER, daten AS ZEIGER), _
     daten AS ZEIGER, freigabe AS ZEIGER, flags AS LONG) AS ULONG
DECLARE FUNCTION signalZeichnen LIB GOBJECT ALIAS "g_signal_connect_data" _
    (objekt AS ZEIGER, name AS TEXT, rueckruf AS FUNCTION(objekt AS ZEIGER, cr AS ZEIGER, daten AS ZEIGER) AS BOOLEAN, _
     daten AS ZEIGER, freigabe AS ZEIGER, flags AS LONG) AS ULONG
DECLARE FUNCTION signalEreignis LIB GOBJECT ALIAS "g_signal_connect_data" _
    (objekt AS ZEIGER, name AS TEXT, rueckruf AS FUNCTION(objekt AS ZEIGER, ereignis AS ZEIGER, daten AS ZEIGER) AS BOOLEAN, _
     daten AS ZEIGER, freigabe AS ZEIGER, flags AS LONG) AS ULONG
' Signale mit einem Wert zwischen Objekt und Daten (row-selected, row-activated)
' draw-page: Druckvorgang, Kontext, Seitennummer
DECLARE FUNCTION signalSeite LIB GOBJECT ALIAS "g_signal_connect_data" _
    (objekt AS ZEIGER, name AS TEXT, rueckruf AS SUB(objekt AS ZEIGER, kontext AS ZEIGER, seite AS LONG, daten AS ZEIGER), _
     daten AS ZEIGER, freigabe AS ZEIGER, flags AS LONG) AS ULONG
DECLARE FUNCTION signalZeile LIB GOBJECT ALIAS "g_signal_connect_data" _
    (objekt AS ZEIGER, name AS TEXT, rueckruf AS SUB(objekt AS ZEIGER, zeile AS ZEIGER, daten AS ZEIGER), _
     daten AS ZEIGER, freigabe AS ZEIGER, flags AS LONG) AS ULONG
DECLARE SUB g_object_unref LIB GOBJECT (objekt AS ZEIGER)
DECLARE FUNCTION g_timeout_add LIB GLIB (ms AS ULONG, rueckruf AS FUNCTION(daten AS ZEIGER) AS BOOLEAN, daten AS ZEIGER) AS ULONG
DECLARE SUB g_free LIB GLIB (z AS ZEIGER)
DECLARE SUB g_error_free LIB GLIB (fehler AS ZEIGER)

STRUCT GError LAYOUT C
    bereich AS ULONG
