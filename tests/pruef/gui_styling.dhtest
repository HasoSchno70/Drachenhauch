=== glas themen schalten die plastik ein
IMPORT "gui"
GUI_THEME_PRESET("glas_dunkel")
PRINT GUI_METRIC_GET("gradient")
PRINT GUI_METRIC_GET("gloss")
PRINT GUI_METRIC_GET("bevel")
PRINT GUI_METRIC_GET("corner_radius")
--- erwartet
16
26
1
5

=== flache themen bleiben flach
' Bestehende Themen duerfen sich nicht veraendern -- sonst saehen alle
IMPORT "gui"
GUI_THEME_PRESET("dark")
PRINT GUI_METRIC_GET("gradient") + GUI_METRIC_GET("gloss") + GUI_METRIC_GET("bevel")
GUI_THEME_PRESET("modern_dark")
PRINT GUI_METRIC_GET("gradient") + GUI_METRIC_GET("gloss") + GUI_METRIC_GET("bevel")
--- erwartet
0
0

