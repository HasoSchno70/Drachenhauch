=== ein menueeintrag blendet unter der maus ein
' Hover-Farbe der Menues ist title_bg_focus, hier Rot. Das Menue ist offen,
' dann faehrt die Maus auf den zweiten Eintrag (y 50..73).
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
GUI_THEME_SET("title_bg_focus", &HFF0000)
GUI_THEME_SET("widget_bg", &H000000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
GUI_MENU_ITEM(m, "Neu") : GUI_MENU_ITEM(m, "Oeffnen") : GUI_MENU_ITEM(m, "Sichern")
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
    IF bild = 20 THEN SAVESCREENSHOT("mitte.png")
WEND
