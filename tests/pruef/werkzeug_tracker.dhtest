{"format":"dhtracker-song","version":1,"bpm":120,"channels":4,"waves":["square","saw","triangle"],"patterns":[{"name":"P1","rows":16,"channels":4,"data":[[60,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,67,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]]}],"order":[0],"instruments":[{"name":"Orgel","kind":"synth","default_vol":15,"pan":0.0,"waveform":"square","loop_mode":"none","loop_start":0,"loop_end":0,"env_attack_ms":0,"env_decay_ms":0,"env_sustain":1.0,"env_release_ms":0,"vib_depth":0.0,"vib_speed":0.0,"detune_cents":0.0},{"name":"Klavier-Sample","kind":"sample","default_vol":12,"pan":-0.25,"sample_rate":22050,"base_note":60,"samples":"AADGJ01JUV9dZlVdpUUFI+b6k9M6s/Ce5JnipC++0uEyCvgwDlCRYpplrVjTPUQZvvCcyt2sLJwpm/ypUsa260oUrjkEVtdk1GMjU2Q1Qg+85i3CU6dmmm+d8q8Iz871Lh7RQR5bHGYQYcZMbSwaBfvcW7qroqOZr6CztjrYAAA=","loop_mode":"none","loop_start":0,"loop_end":0,"env_attack_ms":0,"env_decay_ms":0,"env_sustain":1.0,"env_release_ms":90},{"name":"Harfe-Keymap","kind":"keymap","default_vol":15,"pan":0.0,"zones":[{"name":"tief","sample_rate":22050,"root_note":48,"lo_key":0,"hi_key":127,"loop_mode":"forward","loop_start":4,"loop_end":30,"samples":"AADGJ01JUV9dZlVdpUUFI+b6k9M6s/Ce5JnipC++0uEyCvgwDlCRYpplrVjTPUQZvvCcyt2sLJwpm/ypUsa26w=="}],"loop_mode":"none","loop_start":0,"loop_end":0,"env_attack_ms":0,"env_decay_ms":0,"env_sustain":1.0,"env_release_ms":0}],"channel_inst":[1,0,null,null]}

--- nachher
IMPORT "json"
DIM vorher AS JSON_HANDLE : vorher = JSON_LOAD("_programm/qt.json")
DIM h AS JSON_HANDLE : h = JSON_LOAD("_programm/zurueck.json")
DIM samples AS STRING : samples = JSON_GET_STRING(vorher, "instruments.1.samples")
PRINT "instrumente "; JSON_LEN(h, "instruments")
DIM k AS INTEGER
FOR k = 0 TO JSON_LEN(h, "instruments") - 1
    DIM p AS STRING : p = "instruments." + STR$(k)
    DIM zeile AS STRING : zeile = JSON_GET_STRING(h, p + ".name") + " | " + JSON_GET_STRING(h, p + ".kind")
    IF JSON_HAS(h, p + ".samples") THEN zeile = zeile + " | samples " + IIF(JSON_GET_STRING(h, p + ".samples") = samples, "gleich", "anders")
    PRINT zeile
NEXT
