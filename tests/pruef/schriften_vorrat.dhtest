' Fremde Schriften und das Euro-Zeichen: der Grund-Zeichenvorrat reicht bis
' Kyrillisch, alles andere backt die Laufzeit auf Zuruf aus den Schriften des
' Systems nach, und LOADFONT nimmt eine Zeichenwahl.
'
' Gemessen wird am BILD: derselbe Text einmal echt und einmal als lauter
' Fragezeichen -- vor dem Bau waren beide Bilder gleich. Die Gegenprobe steht als
' eigener Fall: ein Zeichen ohne Schrift (U+E000) ergibt dasselbe Bild wie `?`.
'
' Bis 2026-09-16 tests/test_schriften_vorrat.py (Pillow). Jetzt schreibt jeder
' Fall seine zwei Programme selbst, `dhrt bild` fotografiert sie, und
' LOADIMAGE/GETPIXEL zaehlen die Unterschiede.

=== euro, griechisch und kyrillisch sind keine fragezeichen
' Seit 2026.28 wechselt in der eingebauten Pixelschrift nur das fehlende
' Zeichen in die Ausweichschrift, nicht mehr die ganze Zeile -- der Vergleich
' sieht also wirklich die Zeichen, nicht zwei Schriften.
IMPORT "helfer.dh"
foto("echt", "", "    TEXT(10, 10, " + CHR$(34) + "ä 12,50 € Ω Я ő ł" + CHR$(34) + ")" + CHR$(10))
foto("frage", "", "    TEXT(10, 10, " + CHR$(34) + "ä 12,50 ? ? ? ? ?" + CHR$(34) + ")" + CHR$(10))
PRINT "unterschiede ueber 30 "; (unterschiede("echt.png", "frage.png") > 30)
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
' Ein Programm mit Kopf und Bildschleife schreiben und ueber `dhrt bild`
' fotografieren (drittes Bild). Ohne Fenster ueberspringt sich der Fall.
SUB foto(name AS STRING, rumpf AS STRING, schleife AS STRING)
    DIM z AS STRING : z = CHR$(10)
    WRITEALL(name + ".dh", "SCREEN(400, 120, " + CHR$(34) + "Schrift" + CHR$(34) + ", 1)" + z + _
        rumpf + "WHILE NOT QUITREQUESTED()" + z + "    CLS(0)" + z + schleife + "    FLIP()" + z + "WEND" + z)
    dlStarten(["bild", CWD$() + "/" + name + ".dh", CWD$() + "/" + name + ".png", "3"])
    IF dlCode <> 0 THEN
        PRINT "UEBERSPRINGEN: " + TRIM$(SPLIT$(dlErr + dlAus + " ", CHR$(10))[0])
        EXIT(0)
    END IF
END SUB
' Wie viele Punkte zweier Bilder derselben Groesse verschieden sind.
FUNCTION unterschiede(a AS STRING, b AS STRING) AS INTEGER
    DIM ia AS IMAGE : ia = LOADIMAGE(a)
    DIM ib AS IMAGE : ib = LOADIMAGE(b)
    DIM n AS INTEGER : n = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 0 TO 119
        FOR x = 0 TO 399
            IF GETPIXEL(ia, x, y) <> GETPIXEL(ib, x, y) THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
' Punkte mit Tinte: Summe der drei Kanaele ueber 300.
FUNCTION tinte(a AS STRING) AS INTEGER
    DIM ia AS IMAGE : ia = LOADIMAGE(a)
    DIM n AS INTEGER : n = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 0 TO 119
        FOR x = 0 TO 399
            DIM f AS INTEGER : f = GETPIXEL(ia, x, y)
            IF ((f SHR 16) BAND 255) + ((f SHR 8) BAND 255) + (f BAND 255) > 300 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
--- erwartet
unterschiede ueber 30 TRUE

=== ein zeichen ohne schrift bleibt ein fragezeichen
' Gegenprobe zum Fall davor: U+E000 (Privatbereich) hat keine Schrift -- dann
' ist das Fragezeichen richtig, und beide Bilder sind gleich. Das Euro-Zeichen
' steht in BEIDEN Texten, damit beide in der Ausweichschrift stehen: Umlaute
' allein bleiben seit 2026-10-01 in der eingebauten Schrift, dann verglichen
' die Bilder zwei Schriften.
IMPORT "helfer.dh"
foto("pua", "", "    TEXT(10, 10, " + CHR$(34) + "€ ä  b" + CHR$(34) + ")" + CHR$(10))
foto("frage", "", "    TEXT(10, 10, " + CHR$(34) + "€ ä ? b" + CHR$(34) + ")" + CHR$(10))
PRINT "unterschiede "; unterschiede("pua.png", "frage.png")
