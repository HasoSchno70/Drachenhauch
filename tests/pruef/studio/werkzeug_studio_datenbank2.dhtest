--- erwartet
felder Daten.kunden ortFeld
tabelle Daten.artikel
feld ortFeld ort y=80 text ort:

=== tabelle und datenquelle im inspektor waehlen
' Fenster gewaehlt: die Auswahl Tabelle aufklappen, eins nach unten, Enter
' (der erste Eintrag ist "(keine)"). Dann die Tabelle liste im Navigator
' waehlen und ihre Datenquelle genauso -- ihr Kopf zeigt danach die Spalten.
' Strg+S sichert.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
DIM log AS STRING : log = CWD$() + "/s.log"
DIM x AS INTEGER
DIM y AS INTEGER
' Erster Lauf: messen, mit einem Klick auf die Liste, damit auch ihre Felder
' im Protokoll stehen.
slStarten(log, "", 8, p)
(x, y) = slLage(log, "knoten Hauptfenster.liste")
slHin(10, 10)
slWarten(10)
slKlick(x, y)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM tx AS INTEGER
DIM ty AS INTEGER
DIM qx AS INTEGER
DIM qy AS INTEGER
DIM lx AS INTEGER
DIM ly AS INTEGER
(tx, ty) = slLage(log, "feld studio_tabelle")
(qx, qy) = slLage(log, "feld studio_quelle")
(lx, ly) = slLage(log, "knoten Hauptfenster.liste")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slKlick(tx, ty)
slWarten(6)
slTaste(264)
slTaste(257)
slWarten(10)
slKlick(lx, ly)
slWarten(10)
slKlick(qx, qy)
slWarten(6)
slTaste(264)
slTaste(257)
slWarten(10)
slMit([341], 83)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "fenster tabelle")
    PRINT z
NEXT
DIM j AS JSON_HANDLE : j = JSON_LOAD(p + "/Hauptfenster.dhform")
PRINT "tabelle "; JSON_GET_STRING(j, "studio_tabelle")
PRINT "quelle "; JSON_GET_STRING(j, "widgets.0.studio_quelle")
PRINT "kopf "; JSON_GET_STRING(j, "widgets.0.table.headers.0"); " "; JSON_GET_STRING(j, "widgets.0.table.headers.1")
--- argumente
{sammlung}/../../../studio/studio.dh
--- datei laeufer.dh
