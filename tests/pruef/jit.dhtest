=== aussteigen in einer funktion mit locals
FUNCTION f(grenze AS INTEGER) AS INTEGER
    DIM a[5] AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER
    TRY
        FOR i = 0 TO grenze
            a[i] = i * 3
            n = n + 1
        NEXT
    CATCH e
        PRINT e
    END TRY
    RETURN n * 1000 + i * 10 + a[4]
END FUNCTION
PRINT f(10); " "; f(3)
