=== das popup zeigt hoechstens zehn zeilen
' 30 Eintraege, blaue Liste: die zehnte Zeile (y 236..257) ist blau,
' darunter (y 300) nicht mehr -- vorher reichte das Popup bis y 698.
IMPORT "gui"
SCREEN(300, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM namen AS ARRAY OF STRING : namen = []
DIM k AS INTEGER
FOR k = 1 TO 30
    ARRAY_PUSH(namen, "Stadt " + STR$(k))
NEXT
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 10, 10, 190, 28, namen)
GUI_SET_COLOR(dd, "bg", &H0000FF)
GUI_METRIC_SET("uebergang", 0)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 4
e 0 7 5 395 0 0
e 1 7 100 24 0 0
e 2 6 0 0 0 0
e 3 5 0 0 0 0

--- umgebung
DHRT_FRAMES=8
--- bild
150 250 #0000FF +-2
150 300 nicht #0000FF +-40

