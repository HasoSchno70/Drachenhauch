=== ein control auf einer reiterseite zeigt sich nur dort
' Die Instanz steht auf Seite 1 des Reiterwerks (tabctl.kinder); ihre Teile
' kommen beim Ausklappen hinter alle Controls und liegen jetzt auf derselben
' Seite -- vorher traf ihr Knopf auch auf Seite 0 (gefunden mit der
' Kuehlschrank-App, ein Reiter je Control). Ein Timer im erzeugten Programm
' fragt den Treffer auf beiden Seiten ab.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
slHin(10, 10)
slWarten(10)
slTaste(294)
slWarten(150)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_LAUF_BILDER", "20")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "ausgabe seite")
    PRINT z
NEXT
--- argumente
{sammlung}/../../../studio/studio.dh
--- datei laeufer.dh
