=== die anderen filter wie pillow
IMPORT "helfer.dh"
IMPORT "imgfx"
DIM q AS IMAGE : q = LOADIMAGE("quelle.png")
PRINT "bikubisch "; bvAbweichung$(IMAGE_SCALE(q, 11, 8, "bikubisch"), LOADIMAGE("klein_bikubisch.png"))
PRINT "bicubic "; bvAbweichung$(IMAGE_SCALE(q, 31, 9, "bicubic"), LOADIMAGE("flach_bikubisch.png"))
PRINT "box "; bvAbweichung$(IMAGE_SCALE(q, 11, 8, "box"), LOADIMAGE("klein_box.png"))
PRINT "hamming "; bvAbweichung$(IMAGE_SCALE(q, 11, 8, "hamming"), LOADIMAGE("klein_hamming.png"))
PRINT "linear "; bvAbweichung$(IMAGE_SCALE(q, 31, 9, "linear"), LOADIMAGE("flach_linear.png"))
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/bildvergleich.dh"

