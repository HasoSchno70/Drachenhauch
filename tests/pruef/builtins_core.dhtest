Unerwartetes Token SHR

=== randomize makes rnd deterministic
RANDOMIZE(42)
DIM i AS INTEGER
FOR i = 0 TO 4
    PRINT RND(100)
NEXT
RANDOMIZE(42)
FOR i = 0 TO 4
    PRINT RND(100)
NEXT
--- erwartet
35
50
39
29
91
35
50
39
29
91

=== collides overlapping
PRINT COLLIDES(0, 0, 10, 10, 5, 5, 10, 10)
--- erwartet
TRUE

=== collides disjoint
PRINT COLLIDES(0, 0, 10, 10, 100, 100, 10, 10)
--- erwartet
FALSE

=== collides touching edges dont count
PRINT COLLIDES(0, 0, 10, 10, 10, 0, 10, 10)
--- erwartet
FALSE

=== time date format
' Die Werte aendern sich, die Form nicht: TIME$ ist hh:mm:ss, DATE$ ist JJJJ-MM-TT.
DIM t AS STRING : t = TIME$()
DIM d AS STRING : d = DATE$()
PRINT LEN(t)
PRINT MID$(t, 2, 1) + MID$(t, 5, 1)
PRINT LEN(d)
PRINT MID$(d, 4, 1) + MID$(d, 7, 1)
--- erwartet
8
::
10
--

=== version ist die fassung der laufzeit
' Die Zahl aendert sich mit jeder Fassung, die FORM nicht: Jahr.Zaehler.
DIM v AS STRING : v = VERSION$()
PRINT REGEX_TEST(v, "^[0-9]+\.[0-9]+$")
PRINT LEN(v) >= 6
--- erwartet
TRUE
TRUE
