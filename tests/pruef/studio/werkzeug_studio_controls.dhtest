--- datei proj/Zaehler.dh
CLASS Zaehler EXTENDS Zaehler_Basis
    DIM n AS INTEGER

    SUB Geoeffnet()
        GUI_SET_TEXT(Self.anzeige, "0")
        PRINT "geoeffnet " + GUI_TEXT(Self.anzeige)
    END SUB

    SUB knopf_Klick()
        Self.n = Self.n + 1
        GUI_SET_TEXT(Self.anzeige, STR$(Self.n))
        PRINT "zaehler " + STR$(Self.n)
        IF Self.n = Self.Ziel THEN Self.Ausloesen("Erreicht")
    END SUB

    FUNCTION Wert() AS INTEGER
        RETURN Self.n
    END FUNCTION
END CLASS
