' 95_pbr.dh -- Physically Based Rendering (native-only, F6)
'
' Die native Beleuchtung nutzt das Cook-Torrance-PBR-Modell. Pro Modell:
'   MODEL_PBR(modell, metalness, roughness)   je 0..1
'     metalness: 0 = Dielektrikum (Plastik/Stein), 1 = Metall
'     roughness: 0 = spiegelnd-glatt, 1 = matt
'
' Klassisches Showcase: Kugel-Gitter. Zeilen = metalness (unten 0 .. oben 1),
' Spalten = roughness (links glatt .. rechts matt). Ein kreisendes Punktlicht
' und eine Sonne lassen die Reflexe wandern.

IMPORT "g3d"

SCREEN(800, 480, "PBR", 1)

LIGHT_ENABLE()
LIGHT_AMBIENT(&H303848, 1.0)                       ' dezentes blaeuliches Umgebungslicht
LIGHT_DIRECTIONAL(-0.4, -0.7, -0.5, &HFFFFFF)      ' Sonne
DIM lamp AS INTEGER
lamp = LIGHT_POINT(0, 3, 5, &HFFE0C0)              ' warmes bewegtes Punktlicht

DIM ROWS AS INTEGER
DIM COLS AS INTEGER
ROWS = 5
COLS = 6

DIM spheres[30] AS INTEGER
DIM ALBEDO AS INTEGER
ALBEDO = &HD8A038                                  ' goldener Grundton

DIM i AS INTEGER
DIM r AS INTEGER
DIM c AS INTEGER
i = 0
FOR r = 0 TO ROWS - 1
    FOR c = 0 TO COLS - 1
        DIM s AS INTEGER
        s = MESH_SPHERE(0.5, 28, 28)
        MODEL_LIT(s)
        MODEL_PBR(s, r / (ROWS - 1), 0.05 + (c / (COLS - 1)) * 0.95)
        spheres[i] = s
        i = i + 1
    NEXT
NEXT

DIM t AS FLOAT
t = 0.0

DIM frame AS INTEGER
FOR frame = 0 TO 100000
    IF QUITREQUESTED() THEN BREAK
    t = t + 0.02

    LIGHT_SET_POS(lamp, COS(t) * 6.0, 3.5, 4.0 + SIN(t) * 2.0)

    CLS(&H0A0C12)
    CAMERA3D(0, 0.5, 9.5, 0, 0.5, 0, 45)

    i = 0
    FOR r = 0 TO ROWS - 1
        FOR c = 0 TO COLS - 1
            DIM x AS FLOAT
            DIM y AS FLOAT
            x = (c - (COLS - 1) / 2.0) * 1.35
            y = (r - (ROWS - 1) / 2.0) * 1.35
            MODEL(spheres[i], x, y, 0, 1.0, ALBEDO)
            i = i + 1
        NEXT
    NEXT

    TEXT(12, 10, "PBR (Cook-Torrance): Zeilen=metalness, Spalten=roughness", WHITE)
    TEXT(12, 34, "unten Plastik .. oben Metall  |  links glatt .. rechts matt", &H88AACC)

    FLIP()
NEXT
