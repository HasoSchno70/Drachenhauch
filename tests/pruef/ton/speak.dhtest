    IF INSTR(e, "keine Systemstimme") >= 0 OR INSTR(e, "nicht verfuegbar") >= 0 THEN sprung = TRUE
    ' "nicht gefunden" heisst auch: das Werkzeug (say, espeak-ng) fehlt. Die
    ' Meldung zu einer unbekannten Stimme ist aber KEIN fehlendes Werkzeug.
    IF INSTR(e, "nicht gefunden") >= 0 AND INSTR(e, "SPEAK_VOICE: Stimme") < 0 THEN sprung = TRUE
    IF sprung THEN
        PRINT "UEBERSPRINGEN: keine Sprachausgabe: " + e
        EXIT(0)
    END IF
    PRINT "FEHLER: " + e
END SUB
--- erwartet
TRUE
TRUE

=== eine unbekannte stimme ist ein fehler im klartext
' In pytest lief dieser Test nie: seine Hilfsfunktion wertete "nicht gefunden"
' als "keine Sprachausgabe" und uebersprang ihn -- und genau das steht in der
' erwarteten Meldung. Zuerst muss es Stimmen geben, dann gilt die Meldung.
IMPORT "helfer.dh"
TRY
    DIM v AS ARRAY OF STRING
    v = SPEAK_VOICES()
CATCH e
    fehlerOderSprung(e)
END TRY
TRY
    SPEAK_VOICE("Niemand")
    PRINT "angenommen"
CATCH e2
    PRINT "klartext "; (INSTR(e2, "SPEAK_VOICE: Stimme 'Niemand' nicht gefunden") >= 0)
    PRINT "nennt die vorhandenen "; (INSTR(e2, "vorhanden:") >= 0)
END TRY
--- datei helfer.dh
IMPORT "audio"
' Fehlt die Systemstimme oder ein Audio-Geraet, ueberspringt sich der Fall --
' mit dem, was fehlt. Jeder andere Fehler bleibt einer.
SUB fehlerOderSprung(e AS STRING)
    DIM sprung AS BOOLEAN : sprung = FALSE
    IF INSTR(e, "keine Sprachausgabe") >= 0 OR INSTR(e, "Audio-Geraet") >= 0 THEN sprung = TRUE
    IF INSTR(e, "keine Systemstimme") >= 0 OR INSTR(e, "nicht verfuegbar") >= 0 THEN sprung = TRUE
    ' "nicht gefunden" heisst auch: das Werkzeug (say, espeak-ng) fehlt. Die
    ' Meldung zu einer unbekannten Stimme ist aber KEIN fehlendes Werkzeug.
    IF INSTR(e, "nicht gefunden") >= 0 AND INSTR(e, "SPEAK_VOICE: Stimme") < 0 THEN sprung = TRUE
    IF sprung THEN
        PRINT "UEBERSPRINGEN: keine Sprachausgabe: " + e
        EXIT(0)
    END IF
    PRINT "FEHLER: " + e
END SUB
--- erwartet
klartext TRUE
nennt die vorhandenen TRUE

=== das tempo hat grenzen
' Braucht keine Stimme: der Fehler kommt vor der Synthese.
IMPORT "audio"
SPEAK_RATE(5)
--- fehler
SPEAK_RATE: faktor muss 0.5 .. 2.0

=== die sprache hat einen eigenen bus
IMPORT "audio"
AUDIO_BUS_VOLUME("speech", 0.3)
PRINT AUDIO_BUS_GET_VOLUME("speech")
AUDIO_PUSH()
AUDIO_BUS_VOLUME("speech", 1.0)
AUDIO_POP()
PRINT AUDIO_BUS_GET_VOLUME("speech")
--- erwartet
0.3
0.3
