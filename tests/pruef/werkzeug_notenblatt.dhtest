--- inhalt _programm/score.log
warnung Spur 1 (Melodie), Zeile 32 (Beats 8, 8): Akkord auf hoechste Note reduziert (Tracker-Kanal ist einstimmig)
warnung Spur 1 (Melodie), Note bei Beat 14: an Pattern-Grenze gekuerzt (Reihe 64)
tracker
--- nachher
IMPORT "json"
DIM h AS JSON_HANDLE : h = JSON_LOAD("demo_tracker.json")
DIM folge AS STRING : folge = ""
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(h, "order") - 1
    IF i > 0 THEN folge = folge + ","
    folge = folge + STR$(JSON_GET_INT(h, "order." + STR$(i)))
NEXT
PRINT "bpm " + STR$(JSON_GET_INT(h, "bpm")) + " kanaele " + STR$(JSON_GET_INT(h, "channels")) + " muster " + STR$(JSON_LEN(h, "patterns")) + " folge " + folge
FOR i = 0 TO JSON_LEN(h, "patterns") - 1
    DIM pp AS STRING : pp = "patterns." + STR$(i)
    PRINT "muster " + STR$(i) + " zeilen " + STR$(JSON_GET_INT(h, pp + ".rows"))
    DIM c AS INTEGER
    FOR c = 0 TO JSON_LEN(h, pp + ".data") - 1
        DIM r AS INTEGER
        FOR r = 0 TO JSON_LEN(h, pp + ".data." + STR$(c)) - 1
            DIM zp AS STRING : zp = pp + ".data." + STR$(c) + "." + STR$(r)
            IF JSON_TYPE(h, zp) <> "null" THEN PRINT "  " + STR$(c) + " " + STR$(r) + " " + STR$(JSON_GET_INT(h, zp))
        NEXT
    NEXT
NEXT
DIM ki AS STRING : ki = ""
FOR i = 0 TO JSON_LEN(h, "channel_inst") - 1
    IF i > 0 THEN ki = ki + ","
    IF JSON_TYPE(h, "channel_inst." + STR$(i)) = "null" THEN ki = ki + "None" ELSE ki = ki + STR$(JSON_GET_INT(h, "channel_inst." + STR$(i)))
NEXT
PRINT "kanalinst " + ki
DIM namen AS STRING : namen = ""
FOR i = 0 TO JSON_LEN(h, "instruments") - 1
    IF i > 0 THEN namen = namen + "|"
    namen = namen + JSON_GET_STRING(h, "instruments." + STR$(i) + ".name")
NEXT
PRINT "inst " + namen
