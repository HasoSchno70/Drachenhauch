=== ein numpy-feld ist ein buffer
IMPORT "py.dh"
pyOderUeberspringen()
TRY
    pythonAusfuehren("import numpy as np")
CATCH e
    PRINT "UEBERSPRINGEN: kein numpy"
    END
END TRY
DIM b AS BUFFER : b = BUFFER_NEW(32)
DIM k AS INTEGER
FOR k = 0 TO 3
    BUFFER_SET_F64(b, k * 8, k * 1.5)
NEXT
pythonSetzeBytes("roh", b)
DIM r AS BUFFER : r = pythonBytes("(np.frombuffer(roh, '<f8') ** 2).astype('<f8')")
DIM zeile AS STRING : zeile = ""
FOR k = 0 TO 3
    zeile = zeile + STR$(BUFFER_GET_F64(r, k * 8)) + " "
NEXT
PRINT TRIM$(zeile)
PRINT pythonZahl("np.frombuffer(roh, '<f8').mean()")
