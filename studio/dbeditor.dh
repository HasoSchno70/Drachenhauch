' ============================================================
'  Drachenhauch Studio -- der Reiter einer Datenbank
' ============================================================
'  Links die Tabellen, rechts entweder ihre Spalten (Name, Art, Pflicht,
'  Eindeutig, Vorgabe) oder ihre Zeilen. Beide sind Gitter: geaendert wird
'  in der Zelle, und was sich geaendert hat, merkt das Studio am Vergleich
'  mit dem, was es zuletzt hineingeschrieben hat (spStand/daStand) -- erst,
'  wenn gerade keine Zelle bearbeitet wird. Jede Aenderung geht sofort an
'  die Entwicklungsdatei (datenbank.dh); geht sie nicht, steht die Meldung
'  in der Statuszeile und das Gitter wieder wie vorher.
' ============================================================

CONST DB_ZEILEN_GRENZE = 1000

CLASS DbAnsicht
    DIM kopf AS GUI_WIDGET
    DIM dateiText AS GUI_WIDGET
    DIM tfDatei AS GUI_WIDGET
    DIM lstTab AS GUI_WIDGET
    DIM btTabNeu AS GUI_WIDGET
    DIM btTabUm AS GUI_WIDGET
    DIM btTabWeg AS GUI_WIDGET
    DIM btSpalten AS GUI_WIDGET
    DIM btDaten AS GUI_WIDGET
    DIM hinweis AS GUI_WIDGET
    DIM gitSp AS GUI_WIDGET
    DIM gitDa AS GUI_WIDGET
    DIM btSpNeu AS GUI_WIDGET
    DIM btSpWeg AS GUI_WIDGET
    DIM btZeNeu AS GUI_WIDGET
    DIM btZeWeg AS GUI_WIDGET
    DIM btNeuLaden AS GUI_WIDGET
    DIM btBild AS GUI_WIDGET
    DIM btAbfNeu AS GUI_WIDGET
    DIM taSql AS GUI_WIDGET
    DIM btAusfuehren AS GUI_WIDGET
    DIM gitErg AS GUI_WIDGET
    DIM eintraege AS ARRAY OF STRING   ' je Zeile der Liste links: der Name ("" = Kopf)
    DIM eintragAbf AS ARRAY OF BOOLEAN
    DIM abfrage AS STRING              ' gewaehlte Abfrage ("" = eine Tabelle ist gewaehlt)
    DIM sqlVersucht AS STRING
    DIM seite AS INTEGER
    DIM tabelle AS STRING
    DIM modus AS STRING            ' spalten, daten
    DIM spStand AS ARRAY OF STRING
    DIM daStand AS ARRAY OF STRING
    DIM daIds AS ARRAY OF INTEGER
    DIM daSpalten AS ARRAY OF STRING
    DIM dateiStand AS STRING
END CLASS

DIM dbDlg AS GUI_WINDOW : dbDlg = -1
DIM dbDlgWas AS STRING : dbDlgWas = ""
DIM dbDlgEl AS Element
DIM dbDlgName AS STRING : dbDlgName = ""

FUNCTION dbKnopf(r AS Reiter, text AS STRING) AS GUI_WIDGET
    DIM b AS GUI_WIDGET : b = GUI_BUTTON(win, text, 0, 0, 100, 26)
    GUI_TABCONTROL_ADD_WIDGET(tcMitte, b, r.db.seite)
    RETURN b
END FUNCTION

FUNCTION dbDazu(r AS Reiter, w AS GUI_WIDGET) AS GUI_WIDGET
    GUI_TABCONTROL_ADD_WIDGET(tcMitte, w, r.db.seite)
    RETURN w
END FUNCTION

FUNCTION dbReiterNeu(e AS Element) AS INTEGER
    DIM r AS Reiter : r = NEW Reiter()
    r.art = "datenbank" : r.el = e : r.feld = -1 : r.kopf = -1 : r.info = -1
    r.db = NEW DbAnsicht()
    ARRAY_PUSH(reiter, r)
    DIM k AS INTEGER : k = GUI_TABCONTROL_ADD(tcMitte, reiterTitel$(r))
    DIM a AS DbAnsicht : a = r.db
    a.seite = k
    a.modus = "spalten"
    a.tabelle = ""
    a.abfrage = ""
    a.sqlVersucht = ""
    a.spStand = [] : a.daStand = [] : a.daIds = [] : a.daSpalten = []
    a.eintraege = [] : a.eintragAbf = []
    a.kopf = dbDazu(r, GUI_LABEL(win, trf$("Datenbank {0}", [e.name]), 0, 0))
    GUI_ADD_CLASS(a.kopf, "codekopf")
    a.dateiText = dbDazu(r, GUI_LABEL(win, tr$("Datei:"), 0, 0))
    GUI_ADD_CLASS(a.dateiText, "leise")
    a.tfDatei = dbDazu(r, GUI_TEXTINPUT(win, 0, 0, 200, 26, ""))
    a.dateiStand = dbDateiVon$(dbSchema(e))
    GUI_SET_TEXT(a.tfDatei, a.dateiStand)
    GUI_TOOLTIP(a.tfDatei, tr$("Die SQLite-Datei mit den Daten -- im Projektordner, und neben dem gebauten Programm."))
    a.lstTab = dbDazu(r, GUI_LISTBOX(win, 0, 0, 200, 200, []))
    GUI_LISTBOX_PLACEHOLDER(a.lstTab, tr$("Noch keine Tabelle -- „Tabelle …“ legt eine an."))
    a.btTabNeu = dbKnopf(r, tr$("Tabelle …"))
    a.btAbfNeu = dbKnopf(r, tr$("Abfrage …"))
    a.btTabUm = dbKnopf(r, tr$("Umbenennen …"))
    a.btTabWeg = dbKnopf(r, tr$("Löschen …"))
    a.btSpalten = dbKnopf(r, tr$("Spalten"))
    a.btDaten = dbKnopf(r, tr$("Daten"))
    a.hinweis = dbDazu(r, GUI_LABEL(win, "", 0, 0))
    GUI_ADD_CLASS(a.hinweis, "leise")
    a.gitSp = dbDazu(r, GUI_GRID(win, 0, 0, 300, 200, [tr$("Name"), tr$("Art"), tr$("Pflicht"), tr$("Eindeutig"), tr$("Vorgabe"), tr$("Verweis auf")]))
    DIM namen AS ARRAY OF STRING : namen = []
    DIM t AS STRING
    FOR EACH t IN dbTypen()
        ARRAY_PUSH(namen, dbTypName$(t))
    NEXT
    GUI_TABLE_COL_CHOICES(a.gitSp, 1, namen)
    GUI_TABLE_COL_EDIT(a.gitSp, 2, FALSE)
    GUI_TABLE_COL_EDIT(a.gitSp, 3, FALSE)
    GUI_TABLE_PLACEHOLDER(a.gitSp, tr$("Noch keine Spalte. Die Spalte id hat jede Tabelle von selbst."))
    a.gitDa = -1
    a.btSpNeu = dbKnopf(r, tr$("Spalte hinzufügen …"))
    a.btSpWeg = dbKnopf(r, tr$("Spalte löschen …"))
    a.btZeNeu = dbKnopf(r, tr$("Zeile hinzufügen"))
    a.btZeWeg = dbKnopf(r, tr$("Zeile löschen"))
    a.btNeuLaden = dbKnopf(r, tr$("Neu laden"))
    a.btBild = dbKnopf(r, tr$("Bild …"))
    GUI_TOOLTIP(a.btBild, tr$("Ein Bild aus einer Datei in die gewählte Zelle einer Bildspalte"))
    a.taSql = dbDazu(r, GUI_TEXTAREA(win, 0, 0, 300, 120, "SELECT ..."))
    feldEinrichten(a.taSql)
    a.btAusfuehren = dbKnopf(r, tr$("Ausführen"))
    GUI_BUTTON_VARIANT(a.btAusfuehren, "primaer")
    a.gitErg = dbDazu(r, GUI_TABLE(win, 0, 0, 300, 200))
    dbTabellenFuellen(r)
    dbLegen(r)
    RETURN k
END FUNCTION

SUB dbLegen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    DIM x0 AS INTEGER : x0 = mitteKx + 8
    DIM y0 AS INTEGER : y0 = mitteKy + KOPF_H + 8
    DIM b AS INTEGER : b = mitteKb - 16
    DIM h AS INTEGER : h = mitteKh - KOPF_H - 16
    GUI_SET_BOUNDS(a.kopf, x0 + 6, y0 + 3, b \ 2, 20)
    GUI_SET_BOUNDS(a.dateiText, x0 + b - 330, y0 + 3, 56, 20)
    GUI_SET_BOUNDS(a.tfDatei, x0 + b - 270, y0, 270, 26)
    DIM y1 AS INTEGER : y1 = y0 + 36
    DIM unten AS INTEGER : unten = y0 + h - 28
    ' Links zwei Reihen Knoepfe: anlegen (Tabelle, Abfrage), dann umbenennen
    ' und loeschen -- fuer das, was gewaehlt ist.
    GUI_SET_BOUNDS(a.lstTab, x0, y1, 290, unten - y1 - 42)
    GUI_SET_BOUNDS(a.btTabNeu, x0, unten - 34, 143, 28)
    GUI_SET_BOUNDS(a.btAbfNeu, x0 + 147, unten - 34, 143, 28)
    GUI_SET_BOUNDS(a.btTabUm, x0, unten, 143, 28)
    GUI_SET_BOUNDS(a.btTabWeg, x0 + 147, unten, 143, 28)
    DIM rx AS INTEGER : rx = x0 + 302
    DIM rb AS INTEGER : rb = b - 302
    GUI_SET_BOUNDS(a.btSpalten, rx, y1, 96, 28)
    GUI_SET_BOUNDS(a.btDaten, rx + 100, y1, 96, 28)
    GUI_SET_BOUNDS(a.hinweis, rx + 210, y1 + 5, rb - 210, 20)
    GUI_SET_BOUNDS(a.gitSp, rx, y1 + 36, rb, unten - y1 - 44)
    GUI_TABLE_COL_WIDTHS(a.gitSp, dbSpBreiten(rb))
    dbLegenNurDaten(r)
    GUI_SET_BOUNDS(a.btSpNeu, rx, unten, 160, 28)
    GUI_SET_BOUNDS(a.btSpWeg, rx + 164, unten, 140, 28)
    GUI_SET_BOUNDS(a.btZeNeu, rx, unten, 140, 28)
    GUI_SET_BOUNDS(a.btZeWeg, rx + 144, unten, 120, 28)
    GUI_SET_BOUNDS(a.btNeuLaden, rx + 268, unten, 100, 28)
    GUI_SET_BOUNDS(a.btBild, rx + 372, unten, 90, 28)
    ' Eine Abfrage: oben das SQL, darunter Ausfuehren und das Ergebnis.
    GUI_SET_BOUNDS(a.taSql, rx, y1, rb, 150)
    GUI_SET_BOUNDS(a.btAusfuehren, rx, y1 + 158, 130, 28)
    GUI_SET_BOUNDS(a.gitErg, rx, y1 + 194, rb, unten + 28 - y1 - 194)
    dbModusZeigen(r)
END SUB

' Die Spalten des Spalten-Gitters: fest bis auf die Vorgabe, die den Rest nimmt.
FUNCTION dbSpBreiten(rb AS INTEGER) AS ARRAY OF INTEGER
    DIM v AS INTEGER : v = MAX(460, rb - 2 - 12)
    DIM n AS INTEGER : n = v * 22 \ 100
    DIM t AS INTEGER : t = v * 17 \ 100
    DIM p AS INTEGER : p = v * 11 \ 100
    DIM e AS INTEGER : e = v * 13 \ 100
    DIM g AS INTEGER : g = v * 17 \ 100
    RETURN [n, t, p, e, g, v - n - t - p - e - g]
END FUNCTION

' Die Spalten des Daten-Gitters: id schmal, der Rest zu gleichen Teilen.
FUNCTION dbDaBreiten(rb AS INTEGER, n AS INTEGER) AS ARRAY OF INTEGER
    DIM aus AS ARRAY OF INTEGER : aus = [60]
    DIM rest AS INTEGER : rest = rb - 2 - 12 - 60
    DIM k AS INTEGER
    FOR k = 1 TO n
        ARRAY_PUSH(aus, MAX(80, rest \ MAX(1, n)))
    NEXT
    RETURN aus
END FUNCTION

' Fuer Pruefungen: wo Knoepfe, Tabellen und die ersten Zellen liegen.
SUB dbLagen(r AS Reiter)
    IF logDatei = "" THEN RETURN
    DIM a AS DbAnsicht : a = r.db
    dbLage("tabneu", a.btTabNeu) : dbLage("tabum", a.btTabUm) : dbLage("tabweg", a.btTabWeg)
    dbLage("spalten", a.btSpalten) : dbLage("daten", a.btDaten)
    dbLage("spneu", a.btSpNeu) : dbLage("spweg", a.btSpWeg)
    dbLage("zeneu", a.btZeNeu) : dbLage("zeweg", a.btZeWeg) : dbLage("neuladen", a.btNeuLaden)
    dbLage("bild", a.btBild)
    dbLage("datei", a.tfDatei)
    dbLage("abfneu", a.btAbfNeu) : dbLage("ausfuehren", a.btAusfuehren) : dbLage("sql", a.taSql)
    DIM i AS INTEGER
    FOR i = 0 TO GUI_LISTBOX_COUNT(a.lstTab) - 1
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM b AS INTEGER
        DIM h AS INTEGER
        (x, y, b, h) = GUI_LISTBOX_ITEM_RECT(a.lstTab, i)
        IF h > 0 THEN protokoll("lage dbtabelle " + GUI_LISTBOX_ITEM(a.lstTab, i) + " " + STR$(x + b \ 2) + " " + STR$(y + h \ 2))
    NEXT
    dbZellLagen("sp", a.gitSp, dbSpBreiten(GUI_GET_W(a.gitSp)))
    IF a.gitDa >= 0 THEN dbZellLagen("da", a.gitDa, dbDaBreiten(GUI_GET_W(a.gitDa), LEN(a.daSpalten)))
END SUB

SUB dbLage(was AS STRING, w AS GUI_WIDGET)
    protokoll("lage db " + was + " " + STR$(GUI_GET_X(w) + GUI_GET_W(w) \ 2) + " " + STR$(GUI_GET_Y(w) + inhaltOben + GUI_GET_H(w) \ 2))
END SUB

' Die Mitte der Zellen der ersten Zeilen (Kopf 22, Zeile 20 -- TBL_HEADER_H
' und TBL_ROW_H der Laufzeit).
SUB dbZellLagen(was AS STRING, g AS GUI_WIDGET, breiten AS ARRAY OF INTEGER)
    DIM z AS INTEGER
    FOR z = 0 TO MIN(GUI_TABLE_ROW_COUNT(g), 5) - 1
        DIM x AS INTEGER : x = GUI_GET_X(g) + 1
        DIM c AS INTEGER
        FOR c = 0 TO LEN(breiten) - 1
            protokoll("lage dbzelle " + was + " " + STR$(z) + " " + STR$(c) + " " + STR$(x + breiten[c] \ 2) + " " + STR$(GUI_GET_Y(g) + inhaltOben + 22 + z * 20 + 10))
            x = x + breiten[c]
        NEXT
    NEXT
END SUB

SUB dbModusZeigen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    DIM abf AS BOOLEAN : abf = a.abfrage <> ""
    DIM sp AS BOOLEAN : sp = a.modus = "spalten" AND NOT abf
    DIM da AS BOOLEAN : da = a.modus <> "spalten" AND NOT abf
    DIM hat AS BOOLEAN : hat = a.tabelle <> ""
    GUI_SET_VISIBLE(a.gitSp, sp)
    IF a.gitDa >= 0 THEN GUI_SET_VISIBLE(a.gitDa, da)
    GUI_SET_VISIBLE(a.btSpNeu, sp)
    GUI_SET_VISIBLE(a.btSpWeg, sp)
    GUI_SET_VISIBLE(a.btZeNeu, da)
    GUI_SET_VISIBLE(a.btZeWeg, da)
    GUI_SET_VISIBLE(a.btNeuLaden, da)
    GUI_SET_VISIBLE(a.btBild, da AND dbHatBildspalte(r))
    GUI_SET_VISIBLE(a.btSpalten, NOT abf)
    GUI_SET_VISIBLE(a.btDaten, NOT abf)
    GUI_SET_VISIBLE(a.taSql, abf)
    GUI_SET_VISIBLE(a.btAusfuehren, abf)
    GUI_SET_VISIBLE(a.gitErg, abf)
    GUI_BUTTON_VARIANT(a.btSpalten, IIF(sp, "primaer", "standard"))
    GUI_BUTTON_VARIANT(a.btDaten, IIF(sp, "standard", "primaer"))
    GUI_SET_ENABLED(a.btTabUm, hat OR abf)
    GUI_SET_ENABLED(a.btTabWeg, hat OR abf)
    GUI_SET_ENABLED(a.btSpNeu, hat)
    GUI_SET_ENABLED(a.btSpWeg, hat)
    GUI_SET_ENABLED(a.btZeNeu, hat AND projOrdner <> "")
    GUI_SET_ENABLED(a.btZeWeg, hat AND projOrdner <> "")
    dbLagen(r)
END SUB

SUB dbWidgetsWeg(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    GUI_DESTROY(a.kopf) : GUI_DESTROY(a.dateiText) : GUI_DESTROY(a.tfDatei)
    GUI_DESTROY(a.lstTab) : GUI_DESTROY(a.btTabNeu) : GUI_DESTROY(a.btTabUm)
    GUI_DESTROY(a.btTabWeg) : GUI_DESTROY(a.btSpalten) : GUI_DESTROY(a.btDaten)
    GUI_DESTROY(a.hinweis) : GUI_DESTROY(a.gitSp) : GUI_DESTROY(a.btSpNeu)
    GUI_DESTROY(a.btSpWeg) : GUI_DESTROY(a.btZeNeu) : GUI_DESTROY(a.btZeWeg)
    GUI_DESTROY(a.btNeuLaden) : GUI_DESTROY(a.btAbfNeu) : GUI_DESTROY(a.taSql)
    GUI_DESTROY(a.btAusfuehren) : GUI_DESTROY(a.gitErg)
    IF a.gitDa >= 0 THEN GUI_DESTROY(a.gitDa)
END SUB

' --- Oeffnen ----------------------------------------------------------------------
SUB dbOeffnen(e AS Element, tabelle AS STRING)
    DIM k AS INTEGER : k = reiterFinden("datenbank", e, NIL)
    IF k < 0 THEN k = dbReiterNeu(e)
    GUI_TABCONTROL_SET_PAGE(tcMitte, k)
    reiterPruefen()
    IF tabelle <> "" THEN dbTabelleWaehlen(reiter[k], tabelle)
    protokoll("datenbank " + e.name + IIF(tabelle <> "", " " + tabelle, ""))
END SUB

' Die Liste links: die Tabellen, darunter (unter einem Kopf) die Abfragen.
SUB dbTabellenFuellen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    DIM tn AS ARRAY OF STRING : tn = dbTabellenNamen(r.el)
    DIM an AS ARRAY OF STRING : an = dbAbfrageNamen(r.el)
    a.eintraege = [] : a.eintragAbf = []
    GUI_LISTBOX_CLEAR(a.lstTab)
    DIM n AS STRING
    FOR EACH n IN tn
        GUI_LISTBOX_ADD(a.lstTab, n)
        ARRAY_PUSH(a.eintraege, n) : ARRAY_PUSH(a.eintragAbf, FALSE)
    NEXT
    IF LEN(an) > 0 THEN
        GUI_LISTBOX_ADD(a.lstTab, tr$("Abfragen"))
        GUI_LISTBOX_HEADER(a.lstTab, LEN(a.eintraege), TRUE)
        ARRAY_PUSH(a.eintraege, "") : ARRAY_PUSH(a.eintragAbf, FALSE)
        FOR EACH n IN an
            GUI_LISTBOX_ADD(a.lstTab, n)
            ARRAY_PUSH(a.eintraege, n) : ARRAY_PUSH(a.eintragAbf, TRUE)
        NEXT
    END IF
    IF a.abfrage <> "" AND dbListenIndex(an, a.abfrage) < 0 THEN a.abfrage = ""
    IF a.abfrage = "" AND dbListenIndex(tn, a.tabelle) < 0 THEN a.tabelle = IIF(LEN(tn) > 0, tn[0], "")
    IF a.abfrage <> "" THEN a.tabelle = ""
    DIM w AS INTEGER : w = dbEintragZeile(a, IIF(a.abfrage <> "", a.abfrage, a.tabelle), a.abfrage <> "")
    IF w >= 0 THEN GUI_LISTBOX_SET_SELECTED(a.lstTab, w)
    dbSpaltenFuellen(r)
    dbDatenFuellen(r)
    dbAbfrageZeigen(r)
    dbModusZeigen(r)
END SUB

FUNCTION dbEintragZeile(a AS DbAnsicht, name AS STRING, abf AS BOOLEAN) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(a.eintraege) - 1
        IF a.eintragAbf[i] = abf AND LOWER$(a.eintraege[i]) = LOWER$(name) AND name <> "" THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Eine Tabelle oder Abfrage nach ihrem Namen waehlen.
SUB dbTabelleWaehlen(r AS Reiter, name AS STRING)
    DIM a AS DbAnsicht : a = r.db
    DIM s AS JSON_HANDLE : s = dbSchema(r.el)
    DIM t AS INTEGER : t = dbTabIndex(s, name)
    DIM q AS INTEGER : q = dbAbfIndex(s, name)
    IF t < 0 AND q < 0 THEN RETURN
    IF t >= 0 THEN
        a.tabelle = dbTabName$(s, t) : a.abfrage = ""
    ELSE
        a.abfrage = dbAbfName$(s, q) : a.tabelle = ""
    END IF
    DIM w AS INTEGER : w = dbEintragZeile(a, IIF(t >= 0, a.tabelle, a.abfrage), t < 0)
    IF w >= 0 THEN GUI_LISTBOX_SET_SELECTED(a.lstTab, w)
    dbSpaltenFuellen(r)
    dbDatenFuellen(r)
    dbAbfrageZeigen(r)
    dbModusZeigen(r)
END SUB

' --- Abfragen --------------------------------------------------------------------
' Das SQL der gewaehlten Abfrage ins Feld, ihr Ergebnis ins Gitter.
SUB dbAbfrageZeigen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    IF a.abfrage = "" THEN RETURN
    DIM s AS JSON_HANDLE : s = dbSchema(r.el)
    DIM q AS INTEGER : q = dbAbfIndex(s, a.abfrage)
    IF q < 0 THEN RETURN
    GUI_SET_TEXT(a.taSql, dbAbfSql$(s, q))
    a.sqlVersucht = dbAbfSql$(s, q)
    dbErgebnisZeigen(r, dbAbfSql$(s, q))
END SUB

SUB dbErgebnisZeigen(r AS Reiter, sql AS STRING)
    DIM a AS DbAnsicht : a = r.db
    DIM fehler AS STRING : fehler = dbAbfrageTesten$(r.el, sql, DB_ZEILEN_GRENZE)
    GUI_TABLE_CLEAR(a.gitErg)
    DIM kopf AS ARRAY OF STRING : kopf = dbErgSpalten
    IF LEN(kopf) = 0 THEN kopf = [""]
    GUI_TABLE_HEADERS(a.gitErg, kopf)
    DIM n AS INTEGER : n = LEN(dbErgSpalten)
    DIM z AS INTEGER
    FOR z = 0 TO dbErgZeilen - 1
        DIM zellen AS ARRAY OF STRING : zellen = []
        DIM k AS INTEGER
        FOR k = 0 TO n - 1
            ARRAY_PUSH(zellen, dbErgZellen[z * n + k])
        NEXT
        GUI_TABLE_ADD_ROW(a.gitErg, zellen)
    NEXT
    IF fehler <> "" THEN
        GUI_TABLE_PLACEHOLDER(a.gitErg, fehler)
        GUI_SET_TEXT(a.hinweis, tr$("Nicht ausführbar -- gesichert ist der Stand davor."))
    ELSEIF projOrdner = "" THEN
        GUI_TABLE_PLACEHOLDER(a.gitErg, tr$("Erst das Projekt sichern -- dann gibt es eine Datei für die Daten."))
        GUI_SET_TEXT(a.hinweis, "")
    ELSE
        GUI_TABLE_PLACEHOLDER(a.gitErg, tr$("Die Abfrage liefert keine Zeile."))
        GUI_SET_TEXT(a.hinweis, IIF(dbListenIndexKlein(dbErgSpalten, "id") < 0, tr$("Ohne Spalte id liefert IdVon für diese Abfrage 0."), IIF(dbErgZeilen = 1, tr$("1 Zeile."), trf$("{0} Zeilen.", [STR$(dbErgZeilen)]))))
    END IF
    dbLegen(r)
    protokoll("db ergebnis " + a.abfrage + " " + STR$(dbErgZeilen) + " " + JOIN$(dbErgSpalten, ",") + IIF(fehler <> "", " fehler", ""))
END SUB

FUNCTION dbListenIndexKlein(liste AS ARRAY OF STRING, name AS STRING) AS INTEGER
    RETURN dbListenIndex(liste, name)
END FUNCTION

' Das SQL uebernehmen: nur, wenn es an der Entwicklungsdatei geht.
SUB dbAbfrageUebernehmen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    DIM sql AS STRING : sql = GUI_TEXT(a.taSql)
    a.sqlVersucht = sql
    DIM f AS STRING : f = dbAbfrageSetzen$(r.el, a.abfrage, sql)
    IF f = "" THEN
        status(trf$("Abfrage {0} gesichert.", [a.abfrage]))
        protokoll("db abfrage " + a.abfrage + " " + sql)
        werkzeugeNachziehen()
    ELSE
        dbFehler(f)
    END IF
    dbErgebnisZeigen(r, sql)
    GUI_SET_TEXT(a.taSql, sql)
END SUB

' --- Spalten -----------------------------------------------------------------------
FUNCTION dbSpZeile$(name AS STRING, typname AS STRING, pflicht AS BOOLEAN, eindeutig AS BOOLEAN, vorgabe AS STRING, verweis AS STRING) AS STRING
    RETURN name + CHR$(9) + typname + CHR$(9) + IIF(pflicht, "1", "0") + CHR$(9) + IIF(eindeutig, "1", "0") + CHR$(9) + vorgabe + CHR$(9) + verweis
END FUNCTION

SUB dbSpaltenFuellen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    GUI_TABLE_CLEAR(a.gitSp)
    a.spStand = []
    IF a.tabelle = "" THEN RETURN
    DIM s AS JSON_HANDLE : s = dbSchema(r.el)
    DIM t AS INTEGER : t = dbTabIndex(s, a.tabelle)
    IF t < 0 THEN RETURN
    ' Verweisen kann eine Spalte auf jede Tabelle derselben Datenbank.
    DIM ziele AS ARRAY OF STRING : ziele = [""]
    DIM zn AS STRING
    FOR EACH zn IN dbTabellenNamen(r.el)
        ARRAY_PUSH(ziele, zn)
    NEXT
    GUI_TABLE_COL_CHOICES(a.gitSp, 5, ziele)
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        DIM tn AS STRING : tn = dbTypName$(dbSp$(s, t, k, "typ"))
        DIM z AS INTEGER : z = GUI_TABLE_ADD_ROW(a.gitSp, [dbSp$(s, t, k, "name"), tn, "", "", dbSpVorgabe$(s, t, k), dbSp$(s, t, k, "verweis")])
        GUI_TABLE_CELL_KIND(a.gitSp, z, 2, "haken")
        GUI_TABLE_CELL_KIND(a.gitSp, z, 3, "haken")
        GUI_TABLE_CELL_VALUE(a.gitSp, z, 2, IIF(dbSpAn(s, t, k, "pflicht"), 1.0, 0.0))
        GUI_TABLE_CELL_VALUE(a.gitSp, z, 3, IIF(dbSpAn(s, t, k, "eindeutig"), 1.0, 0.0))
        ARRAY_PUSH(a.spStand, dbSpZeile$(dbSp$(s, t, k, "name"), tn, dbSpAn(s, t, k, "pflicht"), dbSpAn(s, t, k, "eindeutig"), dbSpVorgabe$(s, t, k), dbSp$(s, t, k, "verweis")))
    NEXT
END SUB

FUNCTION dbSpAusGitter$(a AS DbAnsicht, z AS INTEGER) AS STRING
    RETURN dbSpZeile$(TRIM$(GUI_TABLE_GET_CELL(a.gitSp, z, 0)), GUI_TABLE_GET_CELL(a.gitSp, z, 1), GUI_TABLE_GET_VALUE(a.gitSp, z, 2) >= 0.5, GUI_TABLE_GET_VALUE(a.gitSp, z, 3) >= 0.5, TRIM$(GUI_TABLE_GET_CELL(a.gitSp, z, 4)), TRIM$(GUI_TABLE_GET_CELL(a.gitSp, z, 5)))
END FUNCTION

' Eine Zeile im Spalten-Gitter hat sich geaendert: umbenennen oder aendern.
SUB dbSpaltenPruefen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    IF GUI_TABLE_EDITING_ROW(a.gitSp) >= 0 THEN RETURN
    DIM z AS INTEGER
    FOR z = 0 TO MIN(GUI_TABLE_ROW_COUNT(a.gitSp), LEN(a.spStand)) - 1
        DIM jetzt AS STRING : jetzt = dbSpAusGitter$(a, z)
        IF jetzt = a.spStand[z] THEN CONTINUE
        DIM alt AS ARRAY OF STRING : alt = SPLIT(a.spStand[z], CHR$(9))
        DIM neu AS ARRAY OF STRING : neu = SPLIT(jetzt, CHR$(9))
        DIM fehler AS STRING
        IF neu[5] <> alt[5] THEN
            fehler = dbSpalteVerweis$(r.el, a.tabelle, alt[0], neu[5])
            IF fehler = "" THEN
                status(IIF(neu[5] = "", trf$("Spalte {0} verweist auf nichts mehr.", [alt[0]]), trf$("Spalte {0} verweist auf {1}.", [alt[0], neu[5]])))
                protokoll("db spalte verweis " + a.tabelle + "." + alt[0] + " [" + neu[5] + "]")
            END IF
        ELSEIF neu[0] <> alt[0] THEN
            fehler = dbSpalteUmbenennen$(r.el, a.tabelle, alt[0], neu[0])
            IF fehler = "" THEN
                status(trf$("Spalte {0} heißt jetzt {1}.", [alt[0], neu[0]]))
                protokoll("db spalte umbenannt " + a.tabelle + "." + alt[0] + " " + neu[0])
            END IF
        ELSE
            fehler = dbSpalteAendern$(r.el, a.tabelle, alt[0], dbTypAusName$(neu[1]), neu[2] = "1", neu[3] = "1", neu[4])
            IF fehler = "" THEN
                status(trf$("Spalte {0} geändert.", [alt[0]]))
                protokoll("db spalte geaendert " + a.tabelle + "." + alt[0] + " " + dbTypAusName$(neu[1]) + " " + neu[2] + neu[3] + " [" + neu[4] + "]")
            END IF
        END IF
        dbFehler(fehler)
        dbSpaltenFuellen(r)
        dbDatenFuellen(r)
        dbModusZeigen(r)
        werkzeugeNachziehen()
        RETURN
    NEXT
END SUB

SUB dbFehler(fehler AS STRING)
    IF fehler = "" THEN RETURN
    status(fehler)
    protokoll("db fehler " + fehler)
END SUB

' --- Daten -------------------------------------------------------------------------
SUB dbDatenFuellen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    IF a.gitDa >= 0 THEN GUI_DESTROY(a.gitDa)
    a.gitDa = -1
    a.daStand = [] : a.daIds = [] : a.daSpalten = []
    GUI_SET_TEXT(a.hinweis, "")
    IF a.tabelle = "" THEN RETURN
    DIM s AS JSON_HANDLE : s = dbSchema(r.el)
    DIM t AS INTEGER : t = dbTabIndex(s, a.tabelle)
    IF t < 0 THEN RETURN
    DIM kopf AS ARRAY OF STRING : kopf = ["id"]
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        ARRAY_PUSH(kopf, dbSp$(s, t, k, "name"))
        ARRAY_PUSH(a.daSpalten, dbSp$(s, t, k, "name"))
    NEXT
    a.gitDa = GUI_GRID(win, 0, 0, 300, 200, kopf)
    GUI_TABCONTROL_ADD_WIDGET(tcMitte, a.gitDa, a.seite)
    GUI_TABLE_COL_EDIT(a.gitDa, 0, FALSE)
    FOR k = 0 TO dbSpZahl(s, t) - 1
        SELECT CASE dbSp$(s, t, k, "typ")
            CASE "ganz" : GUI_TABLE_COL_TYPE(a.gitDa, k + 1, "ganz")
            CASE "wahr" : GUI_TABLE_COL_CHOICES(a.gitDa, k + 1, ["", tr$("ja"), tr$("nein")])
            CASE "bild" : GUI_TABLE_COL_EDIT(a.gitDa, k + 1, FALSE)
        END SELECT
    NEXT
    DIM fehler AS STRING : fehler = dbZeilenLesen$(r.el, a.tabelle, DB_ZEILEN_GRENZE)
    IF fehler <> "" THEN
        GUI_TABLE_PLACEHOLDER(a.gitDa, fehler)
    ELSE
        GUI_TABLE_PLACEHOLDER(a.gitDa, tr$("Noch keine Zeile -- „Zeile hinzufügen“ legt eine an."))
    END IF
    DIM n AS INTEGER : n = LEN(a.daSpalten)
    DIM z AS INTEGER
    FOR z = 0 TO LEN(dbIds) - 1
        DIM zellen AS ARRAY OF STRING : zellen = [STR$(dbIds[z])]
        FOR k = 0 TO n - 1
            ARRAY_PUSH(zellen, dbZellen[z * n + k])
            ARRAY_PUSH(a.daStand, dbZellen[z * n + k])
        NEXT
        GUI_TABLE_ADD_ROW(a.gitDa, zellen)
        ARRAY_PUSH(a.daIds, dbIds[z])
    NEXT
    IF fehler = "" THEN
        IF dbGesamt > LEN(dbIds) THEN
            GUI_SET_TEXT(a.hinweis, trf$("Die ersten {0} von {1} Zeilen.", [STR$(LEN(dbIds)), STR$(dbGesamt)]))
        ELSE
            GUI_SET_TEXT(a.hinweis, IIF(dbGesamt = 1, tr$("1 Zeile."), trf$("{0} Zeilen.", [STR$(dbGesamt)])))
        END IF
    END IF
    dbLegenNurDaten(r)
    GUI_SET_VISIBLE(a.btBild, a.modus <> "spalten" AND a.abfrage = "" AND dbHatBildspalte(r))
    dbLagen(r)
END SUB

' Hat die gewaehlte Tabelle eine Bildspalte? (Dann gibt es den Knopf „Bild …“.)
FUNCTION dbHatBildspalte(r AS Reiter) AS BOOLEAN
    IF r.db.tabelle = "" THEN RETURN FALSE
    RETURN LEN(dbSpaltenBild(r.el.name + "." + r.db.tabelle, TRUE)) > 0
END FUNCTION

' „Bild …“: ein Bild aus einer Datei in die gewaehlte Zelle einer Bildspalte;
' ist die Zelle schon voll, fragt die Statuszeile nicht nach -- Strg+Z gibt es
' in den Daten ohnehin nicht, und Entf macht sie wieder leer.
SUB dbBildWaehlen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    IF a.gitDa < 0 THEN RETURN
    DIM z AS INTEGER : z = GUI_TABLE_CURRENT_ROW(a.gitDa)
    DIM c AS INTEGER : c = GUI_TABLE_CURRENT_COL(a.gitDa) - 1
    DIM s AS JSON_HANDLE : s = dbSchema(r.el)
    DIM t AS INTEGER : t = dbTabIndex(s, a.tabelle)
    IF z < 0 OR z >= LEN(a.daIds) OR c < 0 OR c >= LEN(a.daSpalten) OR t < 0 THEN
        status(tr$("Erst eine Zelle einer Bildspalte wählen."))
        RETURN
    END IF
    IF dbSp$(s, t, dbSpIndex(s, t, a.daSpalten[c]), "typ") <> "bild" THEN
        status(tr$("Erst eine Zelle einer Bildspalte wählen."))
        RETURN
    END IF
    DIM q AS STRING : q = GETENV$("DH_STUDIO_DATEI")
    IF q = "" THEN q = FILE_OPEN_DIALOG(tr$("Bild wählen"), "png,jpg,jpeg,bmp,gif")
    IF q = "" THEN RETURN
    DIM id AS INTEGER : id = a.daIds[z]
    DIM f AS STRING : f = dbBildSetzen$(r.el, a.tabelle, id, a.daSpalten[c], q)
    IF f <> "" THEN
        dbFehler(f)
        RETURN
    END IF
    dbDatenFuellen(r)
    IF z < GUI_TABLE_ROW_COUNT(a.gitDa) THEN GUI_TABLE_SET_CURRENT(a.gitDa, z, c + 1)
    status(trf$("Bild in {0}, Zeile {1} gesichert.", [a.daSpalten[c], STR$(id)]))
    protokoll("db bild " + a.tabelle + " " + STR$(id) + " " + a.daSpalten[c] + " " + BASENAME(q))
END SUB

SUB dbLegenNurDaten(r AS Reiter)
    IF r.db.gitDa < 0 THEN RETURN
    GUI_SET_BOUNDS(r.db.gitDa, GUI_GET_X(r.db.gitSp), GUI_GET_Y(r.db.gitSp), GUI_GET_W(r.db.gitSp), GUI_GET_H(r.db.gitSp))
    GUI_TABLE_COL_WIDTHS(r.db.gitDa, dbDaBreiten(GUI_GET_W(r.db.gitSp), LEN(r.db.daSpalten)))
    GUI_SET_VISIBLE(r.db.gitDa, r.db.modus = "daten")
END SUB

' Zellen, die sich geaendert haben, in die Datei -- alle auf einmal (Strg+V
' kann mehrere treffen), danach neu lesen, damit jede so dasteht wie die
' Datei sie hat (12,5 -> 12,50).
SUB dbDatenPruefen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    IF a.gitDa < 0 THEN RETURN
    IF GUI_TABLE_EDITING_ROW(a.gitDa) >= 0 THEN RETURN
    DIM n AS INTEGER : n = LEN(a.daSpalten)
    IF n = 0 THEN RETURN
    DIM geschrieben AS INTEGER : geschrieben = 0
    DIM erster AS STRING : erster = ""
    DIM z AS INTEGER
    FOR z = 0 TO MIN(GUI_TABLE_ROW_COUNT(a.gitDa), LEN(a.daIds)) - 1
        DIM k AS INTEGER
        FOR k = 0 TO n - 1
            DIM jetzt AS STRING : jetzt = GUI_TABLE_GET_CELL(a.gitDa, z, k + 1)
            IF jetzt = a.daStand[z * n + k] THEN CONTINUE
            DIM fehler AS STRING : fehler = dbZelleSetzen$(r.el, a.tabelle, a.daIds[z], a.daSpalten[k], jetzt)
            IF fehler = "" THEN
                geschrieben = geschrieben + 1
                protokoll("db zelle " + a.tabelle + " " + STR$(a.daIds[z]) + " " + a.daSpalten[k] + " [" + jetzt + "]")
            ELSEIF erster = "" THEN
                erster = fehler
            END IF
        NEXT
    NEXT
    IF geschrieben = 0 AND erster = "" THEN RETURN
    DIM cz AS INTEGER : cz = GUI_TABLE_CURRENT_ROW(a.gitDa)
    DIM cc AS INTEGER : cc = GUI_TABLE_CURRENT_COL(a.gitDa)
    dbDatenFuellen(r)
    IF cz >= 0 AND cz < GUI_TABLE_ROW_COUNT(a.gitDa) THEN GUI_TABLE_SET_CURRENT(a.gitDa, cz, cc)
    IF erster <> "" THEN dbFehler(erster) ELSE status(IIF(geschrieben = 1, tr$("1 Wert gesichert."), trf$("{0} Werte gesichert.", [STR$(geschrieben)])))
END SUB

' --- Je Bild ------------------------------------------------------------------------
SUB dbAnsichtPruefen(r AS Reiter)
    DIM a AS DbAnsicht : a = r.db
    IF GUI_CHANGED(a.lstTab) THEN
        DIM i AS INTEGER : i = GUI_LISTBOX_SELECTED(a.lstTab)
        IF i >= 0 AND i < LEN(a.eintraege) THEN
            IF a.eintraege[i] <> "" THEN dbTabelleWaehlen(r, a.eintraege[i])
        END IF
    END IF
    IF GUI_CLICKED(a.btAbfNeu) THEN dbFragen(r.el, "abfrage_neu", "")
    IF a.abfrage <> "" THEN
        ' Ausfuehren -- oder das Feld verlassen, nachdem sich etwas geaendert hat.
        IF GUI_CLICKED(a.btAusfuehren) THEN
            ' Schon uebernommen (das Feld hat beim Druecken den Fokus abgegeben):
            ' dann nur noch einmal ausfuehren.
            IF GUI_TEXT(a.taSql) <> a.sqlVersucht THEN dbAbfrageUebernehmen(r) ELSE dbErgebnisZeigen(r, a.sqlVersucht)
        ELSEIF GUI_FOCUSED() <> a.taSql AND GUI_TEXT(a.taSql) <> a.sqlVersucht THEN
            dbAbfrageUebernehmen(r)
        END IF
    END IF
    IF GUI_CLICKED(a.btSpalten) THEN
        a.modus = "spalten"
        dbModusZeigen(r)
    END IF
    IF GUI_CLICKED(a.btDaten) THEN
        a.modus = "daten"
        dbDatenFuellen(r)
        dbModusZeigen(r)
    END IF
    IF GUI_CLICKED(a.btTabNeu) THEN dbFragen(r.el, "tabelle_neu", "")
    IF GUI_CLICKED(a.btTabUm) AND a.tabelle <> "" THEN dbFragen(r.el, "tabelle_um", a.tabelle)
    IF GUI_CLICKED(a.btTabWeg) AND a.tabelle <> "" THEN dbFragen(r.el, "tabelle_weg", a.tabelle)
    IF GUI_CLICKED(a.btTabUm) AND a.abfrage <> "" THEN dbFragen(r.el, "abfrage_um", a.abfrage)
    IF GUI_CLICKED(a.btTabWeg) AND a.abfrage <> "" THEN dbFragen(r.el, "abfrage_weg", a.abfrage)
    IF GUI_CLICKED(a.btSpNeu) AND a.tabelle <> "" THEN dbFragen(r.el, "spalte_neu", a.tabelle)
    IF GUI_CLICKED(a.btSpWeg) AND a.tabelle <> "" THEN
        DIM sz AS INTEGER : sz = GUI_TABLE_CURRENT_ROW(a.gitSp)
        IF sz < 0 THEN sz = GUI_TABLE_SELECTED(a.gitSp)
        IF sz >= 0 AND sz < LEN(a.spStand) THEN
            dbFragen(r.el, "spalte_weg", SPLIT(a.spStand[sz], CHR$(9))[0])
        ELSE
            status(tr$("Erst die Spalte wählen, die weg soll."))
        END IF
    END IF
    IF GUI_CLICKED(a.btZeNeu) AND a.tabelle <> "" THEN
        DIM fz AS STRING : fz = dbZeileNeu$(r.el, a.tabelle)
        dbFehler(fz)
        IF fz = "" THEN
            dbDatenFuellen(r)
            DIM nz AS INTEGER : nz = dbListenIndexZahl(a.daIds, dbNeueId)
            IF nz >= 0 THEN GUI_TABLE_SET_CURRENT(a.gitDa, nz, MIN(1, LEN(a.daSpalten)))
            status(trf$("Zeile {0} angelegt.", [STR$(dbNeueId)]))
            protokoll("db zeile neu " + a.tabelle + " " + STR$(dbNeueId))
        END IF
    END IF
    IF GUI_CLICKED(a.btZeWeg) AND a.gitDa >= 0 THEN
        DIM wz AS INTEGER : wz = GUI_TABLE_CURRENT_ROW(a.gitDa)
        IF wz < 0 THEN wz = GUI_TABLE_SELECTED(a.gitDa)
        IF wz >= 0 AND wz < LEN(a.daIds) THEN
            DIM wid AS INTEGER : wid = a.daIds[wz]
            DIM fw AS STRING : fw = dbZeileLoeschen$(r.el, a.tabelle, wid)
            dbFehler(fw)
            IF fw = "" THEN
                dbDatenFuellen(r)
                status(trf$("Zeile {0} gelöscht.", [STR$(wid)]))
                protokoll("db zeile weg " + a.tabelle + " " + STR$(wid))
            END IF
        ELSE
            status(tr$("Erst die Zeile wählen, die weg soll."))
        END IF
    END IF
    IF GUI_CLICKED(a.btNeuLaden) THEN dbDatenFuellen(r)
    IF GUI_CLICKED(a.btBild) THEN dbBildWaehlen(r)
    ' Die Datei: uebernommen mit Enter oder wenn das Feld den Fokus abgibt.
    IF GUI_TEXT(a.tfDatei) <> a.dateiStand AND (GUI_ENTERED(a.tfDatei) OR GUI_FOCUSED() <> a.tfDatei) THEN
        DIM fd AS STRING : fd = dbDateiSetzen$(r.el, GUI_TEXT(a.tfDatei))
        IF fd = "" THEN
            a.dateiStand = dbDateiVon$(dbSchema(r.el))
            status(trf$("Datei der Datenbank: {0}", [a.dateiStand]))
            protokoll("db datei " + a.dateiStand)
        END IF
        GUI_SET_TEXT(a.tfDatei, dbDateiVon$(dbSchema(r.el)))
        a.dateiStand = GUI_TEXT(a.tfDatei)
        dbFehler(fd)
        dbDatenFuellen(r)
        werkzeugeNachziehen()
    END IF
    IF a.abfrage <> "" THEN RETURN
    IF a.modus = "spalten" THEN dbSpaltenPruefen(r) ELSE dbDatenPruefen(r)
END SUB

FUNCTION dbListenIndexZahl(liste AS ARRAY OF INTEGER, wert AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(liste) - 1
        IF liste[i] = wert THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' --- Fragen ---------------------------------------------------------------------------
SUB dbFragen(e AS Element, was AS STRING, name AS STRING)
    IF GUI_MODAL() THEN RETURN
    dbDlgWas = was : dbDlgEl = e : dbDlgName = name
    SELECT CASE was
        CASE "tabelle_neu"
            dbDlg = GUI_PROMPT(tr$("Tabelle hinzufügen"), tr$("Name der Tabelle:"), dbNameFrei$(e, "", "tabelle"), tr$("Hinzufügen|Abbrechen"))
        CASE "tabelle_um"
            dbDlg = GUI_PROMPT(tr$("Tabelle umbenennen"), trf$("Neuer Name für {0}:", [name]), name, tr$("Umbenennen|Abbrechen"))
        CASE "tabelle_weg"
            dbDlg = GUI_DIALOG(tr$("Tabelle löschen"), trf$("Die Tabelle {0} mit allen Zeilen löschen? Das lässt sich nicht zurücknehmen.", [name]), tr$("Löschen|Abbrechen"))
        CASE "spalte_neu"
            dbDlg = GUI_PROMPT(tr$("Spalte hinzufügen"), trf$("Name der neuen Spalte in {0}:", [name]), dbNameFrei$(e, name, "spalte"), tr$("Hinzufügen|Abbrechen"))
        CASE "spalte_weg"
            dbDlg = GUI_DIALOG(tr$("Spalte löschen"), trf$("Die Spalte {0} samt ihren Werten löschen? Das lässt sich nicht zurücknehmen.", [name]), tr$("Löschen|Abbrechen"))
        CASE "abfrage_neu"
            dbDlg = GUI_PROMPT(tr$("Abfrage hinzufügen"), tr$("Name der Abfrage:"), dbNameFrei$(e, "", "abfrage"), tr$("Hinzufügen|Abbrechen"))
        CASE "abfrage_um"
            dbDlg = GUI_PROMPT(tr$("Abfrage umbenennen"), trf$("Neuer Name für {0}:", [name]), name, tr$("Umbenennen|Abbrechen"))
        CASE "abfrage_weg"
            dbDlg = GUI_DIALOG(tr$("Abfrage löschen"), trf$("Die Abfrage {0} löschen? Die Daten bleiben, wie sie sind.", [name]), tr$("Löschen|Abbrechen"))
    END SELECT
END SUB

FUNCTION dbNameFrei$(e AS Element, tabelle AS STRING, wofuer AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM grund AS STRING : grund = IIF(wofuer = "tabelle", tr$("tabelle"), IIF(wofuer = "abfrage", tr$("abfrage"), tr$("spalte")))
    DIM n AS INTEGER : n = 1
    IF wofuer = "tabelle" OR wofuer = "abfrage" THEN
        WHILE dbNameBelegt(s, grund + STR$(n))
            n = n + 1
        WEND
    ELSE
        DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
        IF t >= 0 THEN
            WHILE dbSpIndex(s, t, grund + STR$(n)) >= 0
                n = n + 1
            WEND
        END IF
    END IF
    RETURN grund + STR$(n)
END FUNCTION

SUB dbDialogPruefen()
    IF dbDlg < 0 THEN RETURN
    DIM a AS INTEGER : a = GUI_ANSWER(dbDlg)
    IF a = 0 THEN RETURN
    DIM text AS STRING : text = ""
    IF dbDlgWas = "tabelle_neu" OR dbDlgWas = "tabelle_um" OR dbDlgWas = "spalte_neu" OR dbDlgWas = "abfrage_neu" OR dbDlgWas = "abfrage_um" THEN text = TRIM$(GUI_DIALOG_TEXT(dbDlg))
    dbDlg = -1
    IF a <> 1 THEN RETURN
    dbAktion(dbDlgEl, dbDlgWas, dbDlgName, text)
END SUB

' Eine Aenderung am Aufbau ausfuehren und den Reiter nachziehen. Auch der Weg
' fuer Pruefungen (DH_STUDIO_DBAKTION).
SUB dbAktion(e AS Element, was AS STRING, name AS STRING, text AS STRING)
    DIM fehler AS STRING : fehler = ""
    DIM waehlen AS STRING : waehlen = ""
    SELECT CASE was
        CASE "tabelle_neu"
            fehler = dbTabelleNeu$(e, text)
            waehlen = text
            IF fehler = "" THEN status(trf$("Tabelle {0} angelegt.", [text]))
        CASE "tabelle_um"
            fehler = dbTabelleUmbenennen$(e, name, text)
            waehlen = text
            IF fehler = "" THEN status(trf$("Tabelle {0} heißt jetzt {1}.", [name, text]))
        CASE "tabelle_weg"
            fehler = dbTabelleLoeschen$(e, name)
            IF fehler = "" THEN status(trf$("Tabelle {0} gelöscht.", [name]))
        CASE "spalte_neu"
            fehler = dbSpalteNeu$(e, name, text, "text")
            waehlen = name
            IF fehler = "" THEN status(trf$("Spalte {0} angelegt.", [text]))
        CASE "spalte_weg"
            DIM k AS INTEGER : k = reiterFinden("datenbank", e, NIL)
            DIM tab AS STRING : tab = IIF(k >= 0, reiter[k].db.tabelle, "")
            fehler = dbSpalteLoeschen$(e, tab, name)
            waehlen = tab
            IF fehler = "" THEN status(trf$("Spalte {0} gelöscht.", [name]))
        CASE "abfrage_neu"
            ' Zum Anfangen: alle Zeilen der ersten Tabelle.
            DIM tns AS ARRAY OF STRING : tns = dbTabellenNamen(e)
            DIM sql AS STRING : sql = IIF(LEN(tns) > 0, "SELECT * FROM " + dbQ$(IIF(LEN(tns) > 0, tns[0], "")), "SELECT 1 AS id")
            fehler = dbAbfrageNeu$(e, text, sql)
            waehlen = text
            IF fehler = "" THEN status(trf$("Abfrage {0} angelegt.", [text]))
        CASE "abfrage_um"
            fehler = dbAbfrageUmbenennen$(e, name, text)
            waehlen = text
            IF fehler = "" THEN status(trf$("Abfrage {0} heißt jetzt {1}.", [name, text]))
        CASE "abfrage_weg"
            fehler = dbAbfrageLoeschen$(e, name)
            IF fehler = "" THEN status(trf$("Abfrage {0} gelöscht.", [name]))
    END SELECT
    dbFehler(fehler)
    IF fehler = "" THEN protokoll("db " + was + " " + name + IIF(text <> "", " " + text, ""))
    DIM r2 AS INTEGER : r2 = reiterFinden("datenbank", e, NIL)
    IF r2 >= 0 THEN
        IF was = "abfrage_weg" AND fehler = "" THEN reiter[r2].db.abfrage = ""
        dbTabellenFuellen(reiter[r2])
        IF waehlen <> "" AND fehler = "" THEN dbTabelleWaehlen(reiter[r2], waehlen)
    END IF
    navigatorFuellen()
    werkzeugeNachziehen()
END SUB

' --- Spalten ins Fenster ziehen (Stufe 2) --------------------------------------
'  Im Navigator stehen unter einer Tabelle ihre Spalten. Eine Spalte oder die
'  ganze Tabelle ins offene Fenster gezogen legt je Spalte eine Beschriftung
'  und ein passendes Feld an, an die Spalte gebunden (bind); ein Doppelklick
'  auf eine Spalte legt sie unter das letzte Control. Hat das Fenster noch
'  keine Tabelle, bekommt es diese. Ein Klick ohne Zug auf eine Tabelle
'  oeffnet ihren Reiter -- erst beim Loslassen, sonst waere das Layout weg,
'  bevor der Zug beginnt.
DIM nvDruckJetzt AS BOOLEAN : nvDruckJetzt = FALSE
DIM nvDruck AS BOOLEAN : nvDruck = FALSE
DIM nvDruckX AS INTEGER
DIM nvDruckY AS INTEGER
DIM nvKnoten AS INTEGER : nvKnoten = -1
DIM nvZug AS INTEGER : nvZug = -1

FUNCTION nvDatenKnoten(n AS INTEGER) AS BOOLEAN
    IF n < 0 OR n >= LEN(navArt) THEN RETURN FALSE
    RETURN navArt[n] = "tabelle" OR navArt[n] = "spalte" OR navArt[n] = "abfrage"
END FUNCTION

SUB navVorUpdate()
    nvDruckJetzt = MOUSE_HIT(0) AND GUI_HIT_TEST(MOUSEX(), MOUSEY()) = baum
END SUB

SUB navNachUpdate()
    IF nvDruckJetzt THEN
        nvDruck = TRUE
        nvDruckX = MOUSEX() : nvDruckY = MOUSEY()
        nvZug = -1
        nvKnoten = GUI_TREE_SELECTED(baum)
    END IF
    IF nvDruck AND MOUSEBUTTON(0) THEN
        IF nvZug < 0 AND nvDatenKnoten(nvKnoten) AND (ABS(MOUSEX() - nvDruckX) > 6 OR ABS(MOUSEY() - nvDruckY) > 6) THEN nvZug = nvKnoten
    END IF
    IF nvDruck AND NOT MOUSEBUTTON(0) THEN
        nvDruck = FALSE
        IF nvZug >= 0 THEN
            IF layoutVorn() AND imFenster(MOUSEX(), MOUSEY()) AND navArt[nvZug] = "abfrage" THEN
                abfrageAblegen(nvZug, zF(MOUSEX() - formX), zF(MOUSEY() - formY))
            ELSEIF layoutVorn() AND imFenster(MOUSEX(), MOUSEY()) THEN
                felderAblegen(nvZug, zF(MOUSEX() - formX), zF(MOUSEY() - formY))
            ELSE
                status(tr$("Felder gehören in ein Fenster -- erst sein Layout öffnen und dann hineinziehen."))
            END IF
            nvZug = -1
        ELSEIF nvDatenKnoten(nvKnoten) AND GUI_TREE_SELECTED(baum) = nvKnoten THEN
            nvKlick(nvKnoten)
        END IF
    END IF
    IF GUI_DOUBLE_CLICKED(baum) THEN
        DIM n AS INTEGER : n = GUI_TREE_SELECTED(baum)
        IF n >= 0 AND n < LEN(navArt) THEN
            IF navArt[n] = "spalte" AND layoutVorn() THEN felderAblegen(n, -1, -1)
        END IF
    END IF
END SUB

' Ein Klick ohne Zug: eine Tabelle oeffnet ihren Reiter, eine Spalte auch --
' ausser ein Layout ist vorn, dann wartet sie aufs Ziehen.
SUB nvKlick(n AS INTEGER)
    DIM e AS Element : e = elemente[navEl[n]]
    IF navArt[n] = "abfrage" THEN
        dbOeffnen(e, dbAbfName$(dbSchema(e), navCtrl[n]))
        RETURN
    END IF
    DIM tab AS STRING : tab = dbTabellenNamen(e)[navCtrl[n]]
    IF navArt[n] = "spalte" AND layoutVorn() THEN
        status(tr$("Die Spalte ins Fenster ziehen oder doppelklicken -- dann steht dort ein Feld, das an sie gebunden ist."))
        RETURN
    END IF
    dbOeffnen(e, tab)
END SUB

SUB navZugZeichnen()
    IF nvZug < 0 OR nvZug >= LEN(navArt) THEN RETURN
    DIM text AS STRING : text = GUI_TREE_LABEL(baum, nvZug)
    IF navArt[nvZug] = "tabelle" THEN text = trf$("{0} (alle Spalten)", [text])
    IF navArt[nvZug] = "abfrage" THEN text = trf$("{0} (als Tabelle)", [text])
    BOXROUND(MOUSEX() + 10, MOUSEY() + 6, MOUSEX() + 26 + LEN(text) * 8, MOUSEY() + 30, 4, RGBA(58, 168, 240, 200))
    TEXT(MOUSEX() + 18, MOUSEY() + 11, text, farbe("titeltext"))
END SUB

' Je Spalte eine Beschriftung und ein Feld; fx/fy = linke obere Ecke im
' Fenster (-1 = unter das letzte Control).
SUB felderAblegen(n AS INTEGER, fx AS INTEGER, fy AS INTEGER)
    DIM e AS Element : e = elemente[navEl[n]]
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = navCtrl[n]
    DIM tab AS STRING : tab = dbTabName$(s, t)
    DIM ref AS STRING : ref = e.name + "." + tab
    DIM spalten AS ARRAY OF INTEGER : spalten = []
    IF navArt[n] = "spalte" THEN
        ARRAY_PUSH(spalten, navMeth[n])
    ELSE
        DIM k AS INTEGER
        FOR k = 0 TO dbSpZahl(s, t) - 1
            ARRAY_PUSH(spalten, k)
        NEXT
    END IF
    IF LEN(spalten) = 0 THEN
        status(trf$("{0} hat noch keine Spalten.", [ref]))
        RETURN
    END IF
    DIM x AS INTEGER : x = fx
    DIM y AS INTEGER : y = fy
    IF fx < 0 THEN
        ' Unter das letzte Control, am linken Rand.
        x = 20 : y = 20
        DIM i AS INTEGER
        FOR i = 0 TO anzahl() - 1
            DIM lx AS INTEGER
            DIM ly AS INTEGER
            DIM lw AS INTEGER
            DIM lh AS INTEGER
            (lx, ly, lw, lh) = lageVon(i)
            y = MAX(y, ly + lh + 12)
        NEXT
    END IF
    x = MAX(0, rasterWert(x))
    y = MAX(0, rasterWert(y))
    DIM namen AS ARRAY OF STRING : namen = []
    DIM letztes AS INTEGER : letztes = -1
    DIM sp AS INTEGER
    FOR EACH sp IN spalten
        letztes = feldAnlegen(e.name, s, t, sp, x, y)
        ARRAY_PUSH(namen, feldText$(letztes, "name"))
        y = y + MAX(28, feldZahl(letztes, "h")) + 10
    NEXT
    ' Ein Fenster ohne Tabelle bekommt diese; eines mit einer anderen behaelt
    ' seine -- dann sagt es die Statuszeile.
    DIM ft AS STRING : ft = fensterText$("studio_tabelle")
    IF ft = "" AND NOT entwurfIstControl() THEN JSON_SET_STRING(doc, "studio_tabelle", ref)
    auswahlSetzen(letztes)
    nachAenderung(TRUE)
    IF ft <> "" AND ft <> ref THEN
        status(trf$("Felder für {0} angelegt -- das Fenster gehört aber zu {1} (Inspektor: Tabelle).", [ref, ft]))
    ELSE
        status(trf$("Felder für {0} angelegt: {1}", [ref, JOIN$(namen, ", ")]))
    END IF
    protokoll("felder " + ref + " " + JOIN$(namen, ","))
END SUB

' Eine Abfrage im Fenster: eine Tabelle, die ihre Zeilen zeigt.
SUB abfrageAblegen(n AS INTEGER, fx AS INTEGER, fy AS INTEGER)
    DIM e AS Element : e = elemente[navEl[n]]
    DIM ref AS STRING : ref = e.name + "." + dbAbfName$(dbSchema(e), navCtrl[n])
    DIM i AS INTEGER : i = controlAnlegen(bausteinNach("table"), MAX(0, rasterWert(fx)), MAX(0, rasterWert(fy)))
    JSON_SET_INT(doc, wz$(i, "w"), 420)
    JSON_SET_INT(doc, wz$(i, "h"), 220)
    JSON_SET_STRING(doc, wz$(i, "studio_quelle"), ref)
    quellKopfSetzen(i)
    auswahlSetzen(i)
    nachAenderung(TRUE)
    status(trf$("Tabelle für die Abfrage {0} angelegt.", [ref]))
    protokoll("abfrage abgelegt " + ref + " " + feldText$(i, "name"))
END SUB

' Ein Feld fuer eine Spalte, dazu links die Beschriftung (ausser bei Ja/Nein:
' das Kaestchen traegt den Namen selbst). Liefert die Nummer des Feldes.
FUNCTION feldAnlegen(dbName AS STRING, s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER, x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM sn AS STRING : sn = dbSp$(s, t, k, "name")
    DIM typ AS STRING : typ = dbSp$(s, t, k, "typ")
    DIM ziel AS STRING : ziel = dbSp$(s, t, k, "verweis")
    DIM i AS INTEGER
    IF ziel <> "" AND dbTabIndex(s, ziel) >= 0 THEN
        ' Ein Verweis: eine Klappliste mit der Anzeigespalte der Zieltabelle,
        ' gebunden ist die id (der Wert der Eintraege).
        DIM lv AS INTEGER : lv = controlAnlegen(bausteinNach("label"), x, y + 4)
        JSON_SET_STRING(doc, wz$(lv, "text"), sn + ":")
        JSON_SET_INT(doc, wz$(lv, "w"), 110)
        DIM lvn AS STRING : lvn = sn + "Text"
        IF nameVergeben(lvn, lv) OR NOT istBezeichner(lvn) THEN lvn = eindeutigerName$(lvn)
        JSON_SET_STRING(doc, wz$(lv, "name"), lvn)
        i = controlAnlegen(bausteinNach("dropdown"), x + 120, y)
        JSON_SET_INT(doc, wz$(i, "w"), 240)
        JSON_SET_JSON(doc, wz$(i, "items"), JSON_NEW_ARRAY())
        JSON_SET_STRING(doc, wz$(i, "studio_quelle"), dbName + "." + dbTabName$(s, dbTabIndex(s, ziel)))
        DIM anz AS STRING : anz = dbAnzeigeSpalte$(s, dbTabIndex(s, ziel))
        IF anz <> "" THEN JSON_SET_STRING(doc, wz$(i, "studio_spalten"), anz)
    ELSEIF typ = "bild" THEN
        DIM lb AS INTEGER : lb = controlAnlegen(bausteinNach("label"), x, y + 4)
        JSON_SET_STRING(doc, wz$(lb, "text"), sn + ":")
        JSON_SET_INT(doc, wz$(lb, "w"), 110)
        DIM lbn AS STRING : lbn = sn + "Text"
        IF nameVergeben(lbn, lb) OR NOT istBezeichner(lbn) THEN lbn = eindeutigerName$(lbn)
        JSON_SET_STRING(doc, wz$(lb, "name"), lbn)
        i = controlAnlegen(bausteinNach("image"), x + 120, y)
        JSON_SET_INT(doc, wz$(i, "w"), 160)
        JSON_SET_INT(doc, wz$(i, "h"), 120)
    ELSEIF typ = "wahr" THEN
        i = controlAnlegen(bausteinNach("checkbox"), x + 120, y + 4)
        JSON_SET_STRING(doc, wz$(i, "text"), sn)
        JSON_SET_INT(doc, wz$(i, "w"), 200)
    ELSE
        DIM l AS INTEGER : l = controlAnlegen(bausteinNach("label"), x, y + 4)
        JSON_SET_STRING(doc, wz$(l, "text"), sn + ":")
        JSON_SET_INT(doc, wz$(l, "w"), 110)
        DIM ln AS STRING : ln = sn + "Text"
        IF nameVergeben(ln, l) OR NOT istBezeichner(ln) THEN ln = eindeutigerName$(ln)
        JSON_SET_STRING(doc, wz$(l, "name"), ln)
        i = controlAnlegen(bausteinNach("textinput"), x + 120, y)
        JSON_SET_INT(doc, wz$(i, "w"), IIF(typ = "text", 240, 140))
        SELECT CASE typ
            CASE "ganz" : JSON_SET_INT(doc, wz$(i, "zahlen"), 1)
            CASE "zahl" : JSON_SET_INT(doc, wz$(i, "zahlen"), 2)
            CASE "geld" : JSON_SET_INT(doc, wz$(i, "zahlen"), 3)
            CASE "datum" : JSON_SET_STRING(doc, wz$(i, "placeholder"), tr$("JJJJ-MM-TT"))
        END SELECT
    END IF
    DIM n AS STRING : n = sn + "Feld"
    IF nameVergeben(n, i) OR NOT istBezeichner(n) THEN n = eindeutigerName$(n)
    JSON_SET_STRING(doc, wz$(i, "name"), n)
    ' Ein Bild haengt nicht an der Bindung des Formulars (GUI_FORM_SAVE schriebe
    ' ihm einen leeren Wert), sondern an seiner Bildspalte.
    IF typ = "bild" THEN
        JSON_SET_STRING(doc, wz$(i, "studio_bildspalte"), sn)
    ELSE
        JSON_SET_STRING(doc, wz$(i, "bind"), sn)
    END IF
    RETURN i
END FUNCTION
