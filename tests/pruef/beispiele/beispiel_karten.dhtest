=== kacheln kommen vom server liegen richtig und gehen in den zwischenspeicher
' Die Kacheln malt der Fall selbst (Farbe aus z/x/y), ein Gegenserver liefert
' sie. Geprueft wird am Bild, das die Ausfuhr zeichnet: in der Mitte liegt die
' Kachel, in der die Mitte liegt. Danach geht der Server weg, der Speicher
' wird geleert -- die Kacheln kommen von der Platte. Zuletzt wird die Grenze
' fuer Kacheln im Speicher klein gestellt und herausgezoomt: die nicht mehr
' gebrauchten werden vergessen.
FUNCTION prFarbe(z AS INTEGER, x AS INTEGER, y AS INTEGER) AS INTEGER
    RETURN RGB(60 + (x * 37 + z * 13) MOD 180, 60 + (y * 53 + z * 29) MOD 180, 60 + (x * 11 + y * 7) MOD 180)
END FUNCTION
SUB prMalen(z AS INTEGER, x0 AS INTEGER, x1 AS INTEGER, y0 AS INTEGER, y1 AS INTEGER)
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR x = x0 TO x1
        FOR y = y0 TO y1
            DIM b AS INTEGER : b = IMAGE_NEW(256, 256, prFarbe(z, x, y))
            MKDIR("srv/" + STR$(z) + "/" + STR$(x))
            IMAGE_SAVE(b, "srv/" + STR$(z) + "/" + STR$(x) + "/" + STR$(y) + ".png")
            IMAGE_FREE(b)
        NEXT
    NEXT
END SUB
prMalen(10, 546, 554, 332, 338)
prMalen(9, 272, 278, 165, 170)
DIM prSrv AS INTEGER : prSrv = PROCESS_START("dhrt", "run", GETENV$("KARTEN_SERVER"), "--", "dateien", "0", "-", CWD$() + "/port.txt")
DIM prT0 AS INTEGER : prT0 = MILLIS()
WHILE NOT FILEEXISTS("port.txt") AND MILLIS() - prT0 < 15000
    SLEEP(20)
WEND
SLEEP(50)
kUrl = "http://127.0.0.1:" + TRIM$(READLINES("port.txt")[0]) + "/srv/{z}/{x}/{y}.png"
DIM prPhase AS INTEGER
DIM prB AS INTEGER
DIM prNetz AS INTEGER
DIM prWarte AS INTEGER
' Die Mitte der Karte im Bild der Ausfuhr: welche Kachel liegt dort, und hat
' der Punkt ihre Farbe?
FUNCTION prMitteStimmt() AS BOOLEAN
    DIM bild AS IMAGE : bild = ansichtBild()
    DIM px AS INTEGER : px = karteB() \ 2
    DIM py AS INTEGER : py = karteH() \ 2
    DIM ok AS BOOLEAN : ok = GETPIXEL(bild, px, py) = prFarbe(zoom, kachelNr(mitteX), kachelNr(mitteY))
    ' und eine Kachel weiter rechts die rechte Nachbarin
    DIM rx AS INTEGER : rx = px + KACHEL
    IF rx < karteB() THEN ok = ok AND GETPIXEL(bild, rx, py) = prFarbe(zoom, kachelNr(mitteX) + 1, kachelNr(mitteY))
    IMAGE_FREE(bild)
    RETURN ok
END FUNCTION
SUB prProbe()
    prB = prB + 1
    IF prB > 900 THEN
        PRINT "zeit um in phase "; prPhase; " "; kLetzterFehler
        PROCESS_KILL(prSrv)
        EXIT(0)
    END IF
    IF prB < 3 OR kachelnLaufend() > 0 THEN RETURN
    SELECT CASE prPhase
        CASE 0
            IF kAusNetz < 12 THEN RETURN
            PRINT "netz: mitte stimmt "; prMitteStimmt(); ", von der platte "; kAusPlatte; ", fehler "; kFehler
            PRINT "zwischenspeicher hat 10/550/335: "; FILEEXISTS(PATHJOIN(kCache, "10/550/335.png"))
            prNetz = kAusNetz
            zoomUm(9, 0, 0)
            prPhase = 1
        CASE 1
            IF kAusNetz = prNetz THEN RETURN
            PRINT "zoom 9 aus dem netz: mitte stimmt "; prMitteStimmt()
            prNetz = kAusNetz
            PROCESS_KILL(prSrv)
            kachelnLeeren(FALSE)
            zoomUm(10, 0, 0)
            prPhase = 2
        CASE 2
            IF kAusPlatte < 12 THEN RETURN
            PRINT "ohne server: mitte stimmt "; prMitteStimmt(); ", neu aus dem netz "; kAusNetz - prNetz
            kMaxSpeicher = 8
            zoomUm(9, 0, 0)
            prPhase = 3
        CASE 3
            ' das Probebild eben hat die Kacheln von Zoom 10 fuer dieses Bild als
            ' gebraucht markiert -- vergessen werden sie erst danach
            prWarte = prWarte + 1
            IF prWarte < 3 THEN RETURN
            PRINT "zoom 9 von der platte: mitte stimmt "; prMitteStimmt(); ", vergessen "; kVergessenZahl > 0; ", im speicher hoechstens 8 neben den sichtbaren "; kachelnImSpeicher() <= 8 + 20
            EXIT(0)
    END SELECT
END SUB
--- programm ../../examples/karten/main.dh nach SETFONT(schrift, 16)
--- ersetzen IMPORT "kern.dh"
IMPORT "{sammlung}/../../examples/karten/kern.dh"
--- ersetzen IMPORT "kacheln.dh"
IMPORT "{sammlung}/../../examples/karten/kacheln.dh"
--- einschub nach     kachelnPumpen()
    prProbe()
--- argumente
--daten
{fall}/daten
--ort
52.5163,13.3777,10
--- umgebung
KARTEN_SERVER={sammlung}/_hilfen/gegenserver.dh
--- erwartet
netz: mitte stimmt TRUE, von der platte 0, fehler 0
zwischenspeicher hat 10/550/335: TRUE
zoom 9 aus dem netz: mitte stimmt TRUE
ohne server: mitte stimmt TRUE, neu aus dem netz 0
zoom 9 von der platte: mitte stimmt TRUE, vergessen TRUE, im speicher hoechstens 8 neben den sichtbaren TRUE

=== abrufe fuer kacheln ausser sicht werden abgebrochen
' Der Gegenserver antwortet erst nach 1,5 s. Nach ein paar Bildern springt die
' Ansicht nach Muenchen: die Abrufe fuer Berlin werden abgebrochen, keine
' Berliner Kachel kommt mehr an, nie laufen mehr als vier Abrufe zugleich, und
' HTTP_PENDING zaehlt nur noch die Muenchner. Muenchen gibt es auf dem Server
' nicht -- das sind Fehler, kein Absturz.
DIM prSrv AS INTEGER : prSrv = PROCESS_START("dhrt", "run", GETENV$("KARTEN_SERVER"), "--", "dateien", "1500", "-", CWD$() + "/port.txt")
DIM prT0 AS INTEGER : prT0 = MILLIS()
WHILE NOT FILEEXISTS("port.txt") AND MILLIS() - prT0 < 15000
    SLEEP(20)
WEND
SLEEP(50)
kUrl = "http://127.0.0.1:" + TRIM$(READLINES("port.txt")[0]) + "/srv/{z}/{x}/{y}.png"
DIM prB AS INTEGER
DIM prMax AS INTEGER
DIM prOffenGleich AS BOOLEAN : prOffenGleich = TRUE
SUB prProbe()
    prB = prB + 1
    prMax = MAX(prMax, kachelnLaufend())
    IF prB = 5 THEN
        PRINT "berlin laeuft: "; kachelnLaufend()
        ansichtSetzen(48.1374, 11.5755, 10)
    END IF
    IF prB > 6 AND HTTP_PENDING() <> kachelnLaufend() THEN prOffenGleich = FALSE
    IF prB > 6 AND kFehler >= 4 THEN
        PRINT "abgebrochen "; kAbgebrochen; ", aus dem netz "; kAusNetz; ", hoechstens zugleich "; prMax; ", offen = laufend "; prOffenGleich
        PRINT "fehler sagt 404: "; INSTR(kLetzterFehler, "404") >= 0
        PROCESS_KILL(prSrv)
        EXIT(0)
    END IF
    IF prB > 900 THEN
        PRINT "zeit um "; kFehler; " "; kLetzterFehler
        EXIT(0)
    END IF
END SUB
