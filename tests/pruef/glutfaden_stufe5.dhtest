=== oxs lesen wie pysticky
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Die eine bewusste Abweichung: ein Garn ohne Palette behaelt seinen Namen ohne
' "DMC TW1 - " davor (PySticky laesst ihn bei jedem Rundweg wachsen).
DIM g AS kern.OxsImport : g = kern.oxsLaden("probe_pysticky.oxs", pal, sym)
PRINT "probe: "; geVergleich$(geMuster$(g.muster), geLies$("gelesen.txt")); " warnungen "; LEN(g.warnungen)
' bekannte Garne kommen aus der Palette (DMC 310 hat dort eine andere Farbe)
PRINT "aus der palette: "; kern.farbeAlsHex$(g.muster.farben[0].garn.farbe); " blend "; g.muster.farben[3].garn.istBlend()
