' Menues bedienen wie eine Liste (2026-09-23): Kontextmenues per Tastatur
' (vorher nur Leistenmenues), Pos1/Ende, Tippen springt (eindeutig = gleich
' ausloesen), und am Bildschirmrand weicht ein Popup aus.
' Rechtsklick = Ereignis 6 mit Knopf 1. Tasten: ab 264, Enter 257, ESC 256,
' Ende 269, Pos1 268,
' E 69, K 75, S 83.
' Format: docs/werkzeuge.md, dhrt test.

=== ein kontextmenue laesst sich mit pfeilen und enter bedienen
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM c AS INTEGER : c = GUI_CONTEXT(w)
DIM a AS INTEGER : a = GUI_MENU_ITEM(c, "Kopieren")
DIM b AS INTEGER : b = GUI_MENU_ITEM(c, "Einfuegen")
DIM d AS INTEGER : d = GUI_MENU_ITEM(c, "Loeschen")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(a) THEN PRINT "kopieren"
    IF GUI_CLICKED(b) THEN PRINT "einfuegen"
    IF GUI_CLICKED(d) THEN PRINT "loeschen"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 10
e 0 7 5 295 0 0
e 1 7 50 50 0 0
e 2 6 1 0 0 0
e 3 5 1 0 0 0
e 5 2 264 0 0 0
e 6 1 264 0 0 0
e 8 2 264 0 0 0
e 9 1 264 0 0 0
e 11 2 257 0 0 0
e 12 1 257 0 0 0

--- umgebung
DHRT_FRAMES=16
--- erwartet
einfuegen

=== esc schliesst das kontextmenue ohne ausloesen
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM c AS INTEGER : c = GUI_CONTEXT(w)
DIM a AS INTEGER : a = GUI_MENU_ITEM(c, "Kopieren")
DIM ab AS GUI_WIDGET : ab = GUI_BUTTON(w, "Abbrechen", 10, 260, 100, 28)
GUI_WINDOW_CANCEL(w, ab)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(a) THEN PRINT "kopieren"
    IF GUI_CLICKED(ab) THEN PRINT "abbrechen"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "ende"
