--- erwartet
zweiter gast 60
gleich TRUE
wirt status Gast hat das Spiel verlassen -- warte auf einen Gast auf Port 47321 ...
rueckgabe 0 0

=== ein zweiter gast bekommt eine absage
IMPORT "hilfe.dh"
DIM w AS INTEGER : w = starten("main.dh", ["wirt", "47331", "--bot", "120", "--ohne-fenster"])
warteMs(400)
DIM g1 AS INTEGER : g1 = starten("main.dh", ["gast", "127.0.0.1", "47331", "--bot", "100", "--ohne-fenster"])
warteMs(600)
DIM g2 AS INTEGER : g2 = starten("main.dh", ["gast", "127.0.0.1", "47331", "--bot", "50", "--ohne-fenster"])
warten([w, g1, g2])
PRINT zeileMit$(g2, "gast status")
PRINT "erster spielt weiter "; zahlNach(g1, "gast eingaben", "eingaben")
PRINT "rueckgabe "; code(w); " "; code(g1); " "; code(g2)
IF fehler <> "" THEN PRINT "stderr "; fehler
--- datei hilfe.dh
