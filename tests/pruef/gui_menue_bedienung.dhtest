=== tippen geht auch im leistenmenue
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM n AS INTEGER : n = GUI_MENU_ITEM(m, "Neu")
DIM s AS INTEGER : s = GUI_MENU_ITEM(m, "Sichern")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(n) THEN PRINT "neu"
    IF GUI_CLICKED(s) THEN PRINT "sichern"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
