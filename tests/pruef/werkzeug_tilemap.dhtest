"raus.dh"

--- ersetzen DIM sk AS STRING : sk = TRIM$(GUI_TEXT(edKey))
DIM sk AS STRING : sk = "wert"

--- ersetzen eigenschaftSetzen(pg, sk, GUI_TEXT(edWert))
