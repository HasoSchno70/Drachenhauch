=== probe: start nach den einstellungen
IMPORT "helfer.dh"
' --probe-start ohne Datei im Aufruf: die Startaktion aus den Einstellungen.
' Drei Laeufe mit je einer einstellungen.json: leeres Muster mit Werkzeug
' Fuellen und gemerkter Fenstergroesse; die letzte Datei mit dem zuletzt
' benutzten Werkzeug (und einem eigenen Kuerzel, das zusammenstoesst); eine
' letzte Datei, die es nicht mehr gibt (zurueck zum Beispielmuster).
MKDIR("app/Glutfaden")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
DIM i AS INTEGER
FOR i = 0 TO 2
    WRITEALL("app/Glutfaden/einstellungen.json", REPLACE$(geLies$("start" + STR$(i + 1) + ".json"), "@ORT@", REPLACE$(CWD$(), CHR$(92), "/")))
    dlStarten(["run", BEISPIEL, "--", "--probe-start"])
    IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
        PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
        EXIT FOR
    END IF
    PRINT "lauf "; i + 1; ": rueckgabe "; dlCode
    ' die gemerkte Groesse ist fest, sonst haengt sie am Bildschirm
    PRINT REGEX_REPLACE(REPLACE$(REPLACE$(dlAus, "fenster 1150x760", "fenster wie gemerkt"), CHR$(13), ""), "fenster [0-9]+x[0-9]+", "fenster nach dem Bildschirm");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM e AS kern.Einstellungen : e = kern.einstellungenLaden("app/Glutfaden/einstellungen.json")
    PRINT "  danach: letztes werkzeug "; e.letztesWerkzeug; " | fenster gemerkt "; e.fensterB > 0; " | zuletzt "; LEN(e.zuletzt)
NEXT
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
