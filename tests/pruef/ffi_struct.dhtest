    b AS BYTE
    werte[3] AS USHORT
    t AS TEXT * 4
    l AS LONG
END STRUCT
DIM s AS S
TRY
    s.b = 200
CATCH e
    PRINT e
END TRY
TRY
    s.werte[3] = 1
CATCH e
    PRINT e
END TRY
TRY
    s.t = "Drache"
CATCH e
    PRINT e
END TRY
TRY
    s.l = 1.5
CATCH e
    PRINT e
END TRY
s.t = "abcd"
PRINT s.t
DIM kurz AS S
kurz = BUFFER_NEW(4)
TRY
    PRINT kurz.l
CATCH e
    PRINT e
END TRY
--- erwartet
s.b: 200 passt nicht in BYTE (-128 bis 127)
s.werte[]: Index 3 liegt ausserhalb 0..2
s.t: der Text braucht 6 Bytes in UTF-8, im Feld ist Platz fuer 4
s.l: erwartet eine ganze Zahl (LONG), erhalten FLOAT
abcd
kurz.l: der Puffer ist 4 Bytes lang, das Feld liegt bei 12..16 -- ist es ein Puffer des richtigen Structs?

=== windows-structs mit namen statt stellen
' Dieselben Aufrufe wie in ffi.dhtest, nur ohne ausgerechnete Stellen:
' MEMORYSTATUSEX will seine Groesse im ersten Feld, FILETIME geht weiter an
' FileTimeToSystemTime.
STRUCT MEMORYSTATUSEX LAYOUT C
    laenge AS ULONG
    auslastung AS ULONG
    gesamt AS INTEGER
    frei AS INTEGER
    seiten_gesamt AS INTEGER
    seiten_frei AS INTEGER
    virtuell_gesamt AS INTEGER
    virtuell_frei AS INTEGER
    erweitert_frei AS INTEGER
END STRUCT
STRUCT FILETIME LAYOUT C
    unten AS ULONG
    oben AS ULONG
END STRUCT
STRUCT SYSTEMTIME LAYOUT C
    jahr AS USHORT
    monat AS USHORT
    wochentag AS USHORT
    tag AS USHORT
    stunde AS USHORT
    minute AS USHORT
    sekunde AS USHORT
    ms AS USHORT
END STRUCT
DECLARE FUNCTION GlobalMemoryStatusEx LIB "kernel32" (m AS MEMORYSTATUSEX) AS BOOLEAN
DECLARE SUB GetSystemTimeAsFileTime LIB "kernel32" (ft AS FILETIME)
DECLARE FUNCTION FileTimeToSystemTime LIB "kernel32" (ft AS FILETIME, st AS SYSTEMTIME) AS BOOLEAN
DIM m AS MEMORYSTATUSEX
m.laenge = SIZEOF(MEMORYSTATUSEX)
PRINT SIZEOF(MEMORYSTATUSEX), GlobalMemoryStatusEx(m)
PRINT m.auslastung <= 100, m.gesamt > m.frei, m.frei > 0
DIM ft AS FILETIME
GetSystemTimeAsFileTime(ft)
DIM st AS SYSTEMTIME
PRINT FileTimeToSystemTime(ft, st), st.jahr >= 2026, st.monat >= 1 AND st.monat <= 12
--- system windows
--- erwartet
64 TRUE
TRUE TRUE TRUE
TRUE TRUE TRUE

=== uname und gettimeofday auf linux und macos
' struct utsname hat Felder fester Breite: 65 Zeichen unter Linux, 256 unter
' macOS. Der Aufruf bekommt den groesseren Struct; dieselben Bytes liest
' danach die Lage des Systems.
STRUCT UtsMac LAYOUT C
    sysname AS TEXT * 256
    nodename AS TEXT * 256
    release AS TEXT * 256
    version AS TEXT * 256
    machine AS TEXT * 256
END STRUCT
STRUCT UtsLinux LAYOUT C
    sysname AS TEXT * 65
    nodename AS TEXT * 65
    release AS TEXT * 65
    version AS TEXT * 65
    machine AS TEXT * 65
    domainname AS TEXT * 65
END STRUCT
STRUCT timeval LAYOUT C
    sek AS INTEGER
    usek AS LONG
END STRUCT
DECLARE FUNCTION uname LIB "c" (u AS UtsMac) AS LONG
DECLARE FUNCTION gettimeofday LIB "c" (tv AS timeval, tz AS ZEIGER) AS LONG
DECLARE FUNCTION time LIB "c" (z AS ZEIGER) AS INTEGER
DIM u AS UtsMac
PRINT uname(u)
DIM rel AS STRING
IF u.sysname = "Linux" THEN
    DIM l AS UtsLinux
    l = u
    rel = l.release
ELSE
    rel = u.release
END IF
PRINT u.sysname = "Linux" OR u.sysname = "Darwin", LEN(rel) > 0
DIM tv AS timeval
PRINT SIZEOF(timeval), gettimeofday(tv, 0)
PRINT ABS(tv.sek - time(0)) <= 2, tv.usek >= 0 AND tv.usek < 1000000
--- system posix
--- erwartet
0
TRUE TRUE
16 0
TRUE TRUE

=== qsort sortiert ein feld von structs
' Ein Feld von Structs ist selbst ein Struct; der Vergleich bekommt Zeiger
' auf zwei Elemente und liest sie durch die Lage.
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
STRUCT Punkte LAYOUT C
    e[4] AS Punkt
END STRUCT
DECLARE SUB qsort LIB "c" (feld AS Punkte, n AS ZEIGER, groesse AS ZEIGER, _
                           vergleich AS FUNCTION(a AS ZEIGER, b AS ZEIGER) AS LONG)
FUNCTION nachX(za AS INTEGER, zb AS INTEGER) AS INTEGER
    DIM a AS Punkt
    a = BUFFER_AUS_ZEIGER(za, SIZEOF(Punkt))
    DIM b AS Punkt
    b = BUFFER_AUS_ZEIGER(zb, SIZEOF(Punkt))
    RETURN SGN(a.x - b.x)
END FUNCTION
DIM ps AS Punkte
DIM xs[4] AS INTEGER
xs[0] = 30 : xs[1] = -5 : xs[2] = 12 : xs[3] = 0
FOR i = 0 TO 3
    ps.e[i].x = xs[i]
    ps.e[i].y = i
NEXT
qsort(ps, 4, SIZEOF(Punkt), nachX)
DIM t AS STRING
FOR i = 0 TO 3
    t = t + STR$(ps.e[i].x) + "/" + STR$(ps.e[i].y) + " "
NEXT
PRINT TRIM$(t)
--- erwartet
-5/1 0/3 12/2 30/0

