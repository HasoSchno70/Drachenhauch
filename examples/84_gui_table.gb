' 84_gui_table.gb -- Retained-Mode-Tabelle (GUI_TABLE) im Fenster.
' Laeuft nativ (F6/--native) UND in pygame (F5) mit denselben Builtins.
'
' Fixierte Kopfzeile, scrollbarer Body (Mausrad + Scrollbalken-Drag),
' Hover-Highlight, persistente Zeilen-Selektion. Klick auf eine Zeile
' selektiert sie; das Detail-Label zeigt den Namen. ESC beendet.

IMPORT "gui"

CONST N AS INTEGER = 14
CONST COLS AS INTEGER = 3

SCREEN(420, 320, "GUI Table", 2)

DIM headers AS ARRAY OF STRING
headers = SPLIT$("Name|Level|Punkte", "|")

DIM cells[N, COLS] AS STRING
DIM i AS INTEGER
FOR i = 0 TO N - 1
    cells[i, 0] = "Spieler_" + STR$(i + 1)
    cells[i, 1] = STR$(1 + (i * 7) MOD 30)
    cells[i, 2] = STR$(((i + 1) * 1234) MOD 9000)
NEXT

DIM win AS GUI_WINDOW
win = GUI_WINDOW("Highscores", 30, 30, 360, 250)

DIM tbl AS GUI_WIDGET
tbl = GUI_TABLE(win, 14, 12, 332, 170, headers, cells)

DIM info AS GUI_WIDGET
info = GUI_LABEL(win, "Klick auf eine Zeile ...", 14, 192)

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    CLS(&H0E1622)
    GUI_UPDATE()
    GUI_DRAW()

    IF GUI_TABLE_CLICKED(tbl) >= 0 THEN
        DIM sel AS INTEGER
        sel = GUI_TABLE_SELECTED(tbl)
        GUI_SET_TEXT(info, "Gewaehlt: " + cells[sel, 0] + " (Lvl " + cells[sel, 1] + ")")
    END IF

    FLIP()
    SLEEP(16)
WEND
