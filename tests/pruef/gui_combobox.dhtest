=== text, auswahl und formular ohne tippen
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 320, 240)
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 10, 10, 220, 28, ["Berlin", "Bremen", "Hamburg"])
PRINT "fest " + GUI_DROPDOWN_TEXT(dd) + " " + STR$(GUI_DROPDOWN_SELECTED(dd))
GUI_DROPDOWN_SET(dd, "bearbeitbar", 1)
PRINT "an " + GUI_DROPDOWN_TEXT(dd) + " " + STR$(GUI_DROPDOWN_SELECTED(dd))
GUI_SET_TEXT(dd, "bremen")
PRINT "gesetzt " + GUI_DROPDOWN_TEXT(dd) + " " + STR$(GUI_DROPDOWN_SELECTED(dd))
GUI_SET_TEXT(dd, "Kiel")
PRINT "frei " + GUI_TEXT(dd) + " " + STR$(GUI_DROPDOWN_SELECTED(dd))
GUI_SET_DROPDOWN(dd, ["Kiel", "Luebeck"])
PRINT "neue liste " + GUI_TEXT(dd) + " " + STR$(GUI_DROPDOWN_SELECTED(dd))
GUI_DROPDOWN_SET_SELECTED(dd, 1)
PRINT "gewaehlt " + GUI_DROPDOWN_TEXT(dd) + " " + STR$(GUI_DROPDOWN_SELECTED(dd))
DIM j AS STRING : j = GUI_TO_JSON(w)
PRINT "in der datei " ; INSTR(j, CHR$(34) + "bearbeitbar" + CHR$(34)) >= 0
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
DIM d2 AS GUI_WIDGET : d2 = GUI_WINDOW_WIDGET(w2, 0)
GUI_SET_TEXT(d2, "Irgendwo")
PRINT "geladen " + GUI_DROPDOWN_TEXT(d2) + " " + STR$(GUI_DROPDOWN_SELECTED(d2))
TRY
    GUI_DROPDOWN_SET(dd, "gibtsnicht", 1)
CATCH e
    PRINT e
END TRY
--- erwartet
fest Berlin 0
an Berlin 0
gesetzt bremen 1
frei Kiel -1
neue liste Kiel 0
gewaehlt Luebeck 1
in der datei TRUE
geladen Irgendwo -1
GUI_DROPDOWN_SET: unbekannter Schluessel 'gibtsnicht' (bekannt: bearbeitbar)
