=== form gilt nur ohne fluechtigen zustand und hat grenzen
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM q AS ARRAY OF STRING
q = ["button:hover { schatten: 4 }", "button { randbreite: 9 }", "button { abstand: 1 2 3 }", "button { schatten: 1 2 }", "button { uebergang: -1 }", "button:checked { schatten: 0 2 4 #000000 }"]
DIM s AS STRING
FOR EACH s IN q
    TRY
        GUI_STYLESHEET(s)
        PRINT "kein fehler"
    CATCH e
        PRINT LEFT$(e, 50)
    END TRY
NEXT
--- erwartet
GUI_STYLESHEET: Zeile 1: 'schatten' gilt nur in Re
GUI_STYLESHEET: Zeile 1: randbreite erwartet eine 
GUI_STYLESHEET: Zeile 1: abstand erwartet eine ode
GUI_STYLESHEET: Zeile 1: schatten erwartet 'weich'
GUI_STYLESHEET: Zeile 1: uebergang erwartet eine g
kein fehler

=== nachfahren in layout, panel und benanntem fenster
' `layout > button` trifft nur direkte Kinder, `panel.leiste button` jedes
' Kind des Panels, `window#neben button` alles im Fenster mit dem Namen. Ein
' Knopf im Panel des Layouts ist kein direktes Kind des Layouts.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM w2 AS GUI_WINDOW : w2 = GUI_WINDOW("Z", 0, 0, 200, 100)
GUI_WINDOW_SET_NAME(w2, "Neben")
DIM lay AS GUI_WIDGET : lay = GUI_LAYOUT(w, "zeile", 10, 10, 380, 120)
DIM b1 AS GUI_WIDGET : b1 = GUI_BUTTON(w, "a", 0, 0, 80, 30)
GUI_LAYOUT_ADD(lay, b1)
DIM pan AS GUI_WIDGET : pan = GUI_PANEL(w, 0, 0, 200, 100)
GUI_LAYOUT_ADD(lay, pan, 1)
GUI_ADD_CLASS(pan, "leiste")
DIM b2 AS GUI_WIDGET : b2 = GUI_BUTTON(w, "b", 100, 20, 80, 30)
GUI_PANEL_ADD(pan, b2)
DIM b3 AS GUI_WIDGET : b3 = GUI_BUTTON(w, "c", 20, 200, 80, 30)
DIM b4 AS GUI_WIDGET : b4 = GUI_BUTTON(w2, "d", 10, 10, 80, 30)
GUI_STYLESHEET("button { bg: #111111 } layout > button { bg: #222222 } panel.leiste button { bg: #333333 } window#neben button { bg: #444444 } layout button { fg: #555555 }")
GUI_UPDATE()
PRINT "layout " + COLOR_HEX$(GUI_GET_COLOR(b1, "bg"))
PRINT "panel " + COLOR_HEX$(GUI_GET_COLOR(b2, "bg"))
PRINT "frei " + COLOR_HEX$(GUI_GET_COLOR(b3, "bg"))
PRINT "fenster " + COLOR_HEX$(GUI_GET_COLOR(b4, "bg"))
PRINT "irgendwo " + COLOR_HEX$(GUI_GET_COLOR(b2, "fg")) + " " + STR$(GUI_GET_COLOR(b3, "fg"))
GUI_REMOVE_CLASS(pan, "leiste")
GUI_WINDOW_SET_NAME(w2, "")
GUI_UPDATE()
PRINT "ohne klasse " + COLOR_HEX$(GUI_GET_COLOR(b2, "bg"))
PRINT "ohne name " + COLOR_HEX$(GUI_GET_COLOR(b4, "bg"))
GUI_ADD_CLASS(pan, "leiste")
GUI_UPDATE()
PRINT "wieder " + COLOR_HEX$(GUI_GET_COLOR(b2, "bg"))
--- erwartet
layout #222222
panel #333333
frei #111111
fenster #444444
irgendwo #555555 -1
ohne klasse #111111
ohne name #111111
wieder #333333

=== der fenstername steht in der dhform
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 300, 200)
GUI_WINDOW_SET_NAME(w, "Haupt-1")
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 80, 30)
DIM j AS STRING : j = GUI_TO_JSON(w)
PRINT GUI_WINDOW_GET_NAME$(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT GUI_WINDOW_GET_NAME$(w2)
DIM w3 AS GUI_WINDOW : w3 = GUI_WINDOW("U", 0, 0, 100, 100)
PRINT "[" + GUI_WINDOW_GET_NAME$(w3) + "] " + STR$(INSTR(GUI_TO_JSON(w3), CHR$(34) + "name" + CHR$(34)) >= 0)
TRY
    GUI_WINDOW_SET_NAME(w, "mit leer")
CATCH e
    PRINT e
END TRY
--- erwartet
haupt-1
haupt-1
[] FALSE
GUI_WINDOW_SET_NAME: Name 'mit leer' -- erlaubt sind Buchstaben, Ziffern, _ und -

=== abstand bei beschriftung, kaestchen und listenzeile
' Beschriftung: Text plus zweimal der Abstand. Kaestchen: der waagerechte
' Abstand ist die Luecke zwischen Kaestchen und Text (sonst 8). Liste: die
' Zeile ist Schrift plus zweimal der senkrechte Abstand hoch -- derselbe
' Klick trifft in der weiten Liste die erste Zeile, in der engen die zweite.
IMPORT "gui"
SCREEN(500, 400, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM l1 AS GUI_WIDGET : l1 = GUI_LABEL(w, "Hallo", 10, 250)
DIM l2 AS GUI_WIDGET : l2 = GUI_LABEL(w, "Hallo", 10, 300)
DIM k1 AS GUI_WIDGET : k1 = GUI_CHECKBOX(w, "Haken", 250, 250)
DIM k2 AS GUI_WIDGET : k2 = GUI_CHECKBOX(w, "Haken", 250, 300)
DIM la AS GUI_WIDGET : la = GUI_LISTBOX(w, 10, 10, 200, 200, ["a", "b", "c"])
DIM lb AS GUI_WIDGET : lb = GUI_LISTBOX(w, 250, 10, 200, 200, ["a", "b", "c"])
GUI_ADD_CLASS(l2, "weit")
GUI_ADD_CLASS(k2, "weit")
GUI_ADD_CLASS(lb, "hoch")
GUI_STYLESHEET(".weit { abstand: 3 20 } .hoch { abstand: 20 }")
' GUI_AUTOSIZE misst SOFORT -- erst nach dem ersten GUI_UPDATE kennt die
' Beschriftung ihren Stil.
GUI_UPDATE()
GUI_AUTOSIZE(l1)
GUI_AUTOSIZE(l2)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
PRINT "beschriftung breiter um " + STR$(GUI_GET_W(l2) - GUI_GET_W(l1)) + ", hoeher um " + STR$(GUI_GET_H(l2) - GUI_GET_H(l1))
PRINT "kaestchen breiter um " + STR$(GUI_GET_W(k2) - GUI_GET_W(k1))
PRINT "eng " + STR$(GUI_LISTBOX_SELECTED(la)) + " weit " + STR$(GUI_LISTBOX_SELECTED(lb))
--- datei ev.txt
c 8
e 0 7 60 45 0 0
e 1 6 0 0 0 0
e 2 5 0 0 0 0
e 4 7 300 45 0 0
e 5 6 0 0 0 0
e 6 5 0 0 0 0
e 7 7 480 390 0 0
e 8 7 480 390 0 0

--- umgebung
DHRT_FRAMES=12
--- erwartet
beschriftung breiter um 40, hoeher um 6
kaestchen breiter um 12
eng 1 weit 0

=== uebergang je farbe: der grund sofort
' Alles 2000 ms, nur die Grundfarbe 0: nach dem Ueberfahren ist der Knopf
' gleich gruen.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
GUI_METRIC_SET("gradient", 0)
GUI_METRIC_SET("gloss", 0)
GUI_METRIC_SET("bevel", 0)
GUI_METRIC_SET("corner_radius", 0)
GUI_METRIC_SET("uebergang", 0)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 100, 30)
GUI_STYLESHEET("button { bg: #2050C0; uebergang: 2000, bg 0 } button:hover { bg: #00C000 }")
AUTOMATION_PLAY("ev.txt")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 2
e 0 7 60 25 0 0
e 1 7 60 25 0 0

--- umgebung
DHRT_FRAMES=8
--- bild
14 14 #00C000 +-16

=== uebergang je farbe: der grund langsam
' Die Gegenrichtung: alles 0, die Grundfarbe 2000 ms -- nach wenigen
' Bildern ist der Knopf noch fast blau, obwohl der Rest springt.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
GUI_METRIC_SET("gradient", 0)
GUI_METRIC_SET("gloss", 0)
GUI_METRIC_SET("bevel", 0)
GUI_METRIC_SET("corner_radius", 0)
GUI_METRIC_SET("uebergang", 2000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 100, 30)
GUI_STYLESHEET("button { bg: #2050C0; uebergang: 0, bg 2000 } button:hover { bg: #00C000 }")
AUTOMATION_PLAY("ev.txt")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 2
e 0 7 60 25 0 0
e 1 7 60 25 0 0

--- umgebung
DHRT_FRAMES=8
--- bild
14 14 #2050C0 +-24

=== fehler in nachfahren und uebergaengen
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM q AS ARRAY OF STRING
q = ["panel > { bg: #fff }", "> button { bg: #fff }", "panel:hover button { bg: #fff }", "window { bg: #fff }", "button { uebergang: 100, schatten 50 }", "button { uebergang: bg }", "panel.leiste > layout button:hover { bg: #fff }"]
DIM s AS STRING
FOR EACH s IN q
    TRY
        GUI_STYLESHEET(s)
        PRINT "kein fehler"
    CATCH e
        PRINT e
    END TRY
NEXT
--- erwartet
GUI_STYLESHEET: Zeile 1: 'panel >' -- hinter '>' fehlt ein Teil
GUI_STYLESHEET: Zeile 1: '> button' -- vor '>' fehlt ein Teil
GUI_STYLESHEET: Zeile 1: 'panel:hover' -- einen Zustand traegt nur der letzte Teil des Selektors, nicht ein Behaelter darueber
GUI_STYLESHEET: Zeile 1: 'window' gibt es nur als Vorfahre (window#name button) -- das Fenster selbst ist kein Widget
GUI_STYLESHEET: Zeile 1: uebergang fuer 'schatten' -- eine eigene Dauer haben bg, fg, border und accent
GUI_STYLESHEET: Zeile 1: uebergang erwartet eine ganze Zahl 0..2000, erhalten 'bg'
kein fehler
