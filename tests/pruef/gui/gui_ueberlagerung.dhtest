=== ein eigenes sinnbild meldet seinen klick und setzt keine marke
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 20, 200, 28)
GUI_TEXTINPUT_SET(tf, "passwort", 1)
GUI_TEXTINPUT_ICON(tf, "", "auge")
GUI_SET_TEXT(tf, "geheim")
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF GUI_ICON_CLICKED(tf) = 2 THEN
        GUI_TEXTINPUT_SET(tf, "passwort", 0)
        PRINT "auge geklickt, fokus im feld " + STR$(GUI_FOCUSED() = tf)
    END IF
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
