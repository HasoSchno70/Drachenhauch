DIM c AS VEC2
a = VEC2_NEW(1.0, 2.0)
b = VEC2_NEW(1.0, 2.0)
c = VEC2_NEW(1.0, 3.0)
PRINT a = b
PRINT a = c
PRINT a <> c
--- erwartet
TRUE
FALSE
TRUE

