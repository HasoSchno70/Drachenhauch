' Tabellen fuellen in linearer Zeit (Stresstest 2026-10-02).
'
' GUI_TABLE_ADD_ROW und GUI_TREETABLE_ADD bauten bei JEDER Zeile die ganze
' Ansicht neu (Filter, Sortierung, Baum) und prueften alle Elternangaben:
' 120000 Baumzeilen dauerten 38 s, 5000 Zeilen in eine sortierte Tabelle
' 2,9 s -- die Variablenliste des Debuggers hielt die IDE so bei einem
' grossen Programm 2 s fest. Jetzt nimmt das Anhaengen die Zeile selbst in
' die Ansicht, wo das Ergebnis feststeht (Rust-Test
' `anhaengen_wie_neu_gebaut` vergleicht mit dem Neubau). Die Grenzen sind
' grob: jetzt Millisekunden, vorher Dutzende Sekunden.
' Format: docs/werkzeuge.md, dhrt test.

=== baumtabelle und sortierte tabelle fuellen
IMPORT "gui"
SCREEN(400, 300, "t", 1)
DIM win AS GUI_WINDOW : win = GUI_WINDOW("w", 0, 0, 400, 300)
DIM b AS GUI_WIDGET : b = GUI_TREETABLE(win, 0, 0, 380, 280, ["Name", "Wert"])
DIM t0 AS FLOAT : t0 = GET_TIME()
DIM i AS INTEGER
DIM k AS INTEGER
DIM e AS INTEGER
DIM r AS INTEGER
FOR i = 0 TO 299
    e = GUI_TREETABLE_ADD(b, -1, ["v" + STR$(i), "ARRAY"])
    FOR k = 0 TO 399
        r = GUI_TREETABLE_ADD(b, e, ["[" + STR$(k) + "]", STR$(k)])
    NEXT
NEXT
PRINT "baum zeilen "; GUI_TABLE_ROW_COUNT(b); " sichtbar "; GUI_TABLE_VIEW_COUNT(b); " flott "; GET_TIME() - t0 < 5.0
GUI_TREETABLE_EXPAND(b, 0, TRUE)
PRINT "aufgeklappt sichtbar "; GUI_TABLE_VIEW_COUNT(b)
DIM s AS GUI_WIDGET : s = GUI_TABLE(win, 0, 0, 380, 280)
GUI_TABLE_HEADERS(s, ["A"])
GUI_TABLE_SORT(s, 0, FALSE)
t0 = GET_TIME()
FOR i = 1 TO 20000
    r = GUI_TABLE_ADD_ROW(s, [STR$((i * 7919) MOD 20000)])
NEXT
PRINT "sortiert flott "; GET_TIME() - t0 < 5.0
PRINT "erste "; GUI_TABLE_GET_CELL(s, GUI_TABLE_VIEW_ROW(s, 0), 0); " letzte "; GUI_TABLE_GET_CELL(s, GUI_TABLE_VIEW_ROW(s, 19999), 0)
--- erwartet
baum zeilen 120300 sichtbar 300 flott TRUE
aufgeklappt sichtbar 700
sortiert flott TRUE
erste 0 letzte 19999

=== zellen setzen in einer grossen sortierten und gefilterten tabelle
' Messung 2026-11-13: GUI_TABLE_SET_CELL baute die ganze Ansicht neu --
' 77 ms je Zelle bei 100000 Zeilen, 1,3 s bei einer Million; ein Programm,
' das Zellen in einer Schleife setzt, wurde quadratisch. Jetzt ordnet es nur
' die eine Zeile neu ein (Rust-Test `zelle_aendern_wie_neu_gebaut`). 2000
' Zellen in 100000 Zeilen: vorher ueber zwei Minuten, jetzt Millisekunden.
IMPORT "gui"
DIM win AS GUI_WINDOW : win = GUI_WINDOW("w", 0, 0, 400, 300)
DIM s AS GUI_WIDGET : s = GUI_TABLE(win, 0, 0, 380, 280)
GUI_TABLE_HEADERS(s, ["Wert", "Art"])
DIM i AS INTEGER
DIM r AS INTEGER
FOR i = 0 TO 99999
    r = GUI_TABLE_ADD_ROW(s, [STR$(i), IIF(i MOD 2 = 0, "x", "y")])
NEXT
GUI_TABLE_SORT(s, 0, FALSE)
GUI_TABLE_FILTER(s, 1, "x")
PRINT "sichtbar "; GUI_TABLE_VIEW_COUNT(s)
DIM t0 AS FLOAT : t0 = GET_TIME()
' Die Sortierspalte: 2000 gerade Zeilen bekommen negative Werte und
' wandern nach vorn.
FOR i = 0 TO 1999
    GUI_TABLE_SET_CELL(s, i * 2, 0, STR$(-i))
NEXT
PRINT "flott "; GET_TIME() - t0 < 5.0
PRINT "erste "; GUI_TABLE_GET_CELL(s, GUI_TABLE_VIEW_ROW(s, 0), 0); " zweite "; GUI_TABLE_GET_CELL(s, GUI_TABLE_VIEW_ROW(s, 1), 0)
' Die Filterspalte: eine ungerade Zeile passt jetzt und steht an ihrem Platz.
GUI_TABLE_SET_CELL(s, 5001, 1, "x")
PRINT "sichtbar "; GUI_TABLE_VIEW_COUNT(s)
DIM k AS INTEGER
DIM wo AS INTEGER : wo = -1
FOR k = 0 TO GUI_TABLE_VIEW_COUNT(s) - 1
    IF GUI_TABLE_VIEW_ROW(s, k) = 5001 THEN wo = k : EXIT FOR
NEXT
PRINT "davor "; GUI_TABLE_GET_CELL(s, GUI_TABLE_VIEW_ROW(s, wo - 1), 0); " danach "; GUI_TABLE_GET_CELL(s, GUI_TABLE_VIEW_ROW(s, wo + 1), 0)
--- erwartet
sichtbar 50000
flott TRUE
erste -1999 zweite -1998
sichtbar 50001
davor 5000 danach 5002
