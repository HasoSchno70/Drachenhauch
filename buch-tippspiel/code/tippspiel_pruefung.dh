' ============================================================
'  TIPPSPIEL -- Pruefung ohne Fenster
' ============================================================
'  Dieselbe Punkteregel und derselbe Datenbank-Ablauf wie in
'  tippspiel.dh, nur ohne Oberflaeche: laeuft in der Konsole,
'  prueft sich selbst und meldet am Ende, was schiefging.
'
'  Warum getrennt? Die Regel ist das Herz der Anwendung. Sie
'  darf nicht nur dann nachweisbar richtig sein, wenn jemand
'  von Hand klickt.
'
'  Start:  dhrun.py buch-tippspiel/code/tippspiel_pruefung.dh
' ============================================================
IMPORT "db"
IMPORT "json"

DIM fehler AS INTEGER : fehler = 0
DIM geprueft AS INTEGER : geprueft = 0

SUB pruefe(was AS STRING, ist AS INTEGER, soll AS INTEGER)
    geprueft = geprueft + 1
    IF ist = soll THEN
        PRINT "  ok   "; was; " = "; ist
    ELSE
        PRINT "  FEHL "; was; " = "; ist; " (erwartet "; soll; ")"
        fehler = fehler + 1
    END IF
END SUB

' Dasselbe fuer Ja/Nein. Eigene Fassung statt einer Umrechnung: INT() nimmt
' kein BOOLEAN, und "ist = TRUE" liest sich besser als "ist = 1".
SUB pruefeJa(was AS STRING, ist AS BOOLEAN, soll AS BOOLEAN)
    geprueft = geprueft + 1
    IF ist = soll THEN
        PRINT "  ok   "; was; " = "; ist
    ELSE
        PRINT "  FEHL "; was; " = "; ist; " (erwartet "; soll; ")"
        fehler = fehler + 1
    END IF
END SUB

' ---- Die Regel (wortgleich mit tippspiel.dh) -----------------------------
FUNCTION tendenz(heim AS INTEGER, gast AS INTEGER) AS INTEGER
    IF heim > gast THEN RETURN 1
    IF heim < gast THEN RETURN -1
    RETURN 0
END FUNCTION

FUNCTION punkte(tippH AS INTEGER, tippA AS INTEGER, _
                ergH AS INTEGER, ergA AS INTEGER) AS INTEGER
    IF tippH = ergH AND tippA = ergA THEN RETURN 3
    IF tendenz(tippH, tippA) <> tendenz(ergH, ergA) THEN RETURN 0
    IF (tippH - tippA) = (ergH - ergA) THEN RETURN 2
    RETURN 1
END FUNCTION

PRINT "=== Punkteregel ==="
pruefe("exakt getroffen 2:1 auf 2:1", punkte(2, 1, 2, 1), 3)
pruefe("exaktes Unentschieden 0:0", punkte(0, 0, 0, 0), 3)
pruefe("Tendenz + Differenz 3:2 auf 2:1", punkte(3, 2, 2, 1), 2)
pruefe("nur Tendenz 3:0 auf 2:1", punkte(3, 0, 2, 1), 1)
pruefe("falsche Tendenz 1:2 auf 2:1", punkte(1, 2, 2, 1), 0)
pruefe("Heimsieg getippt, Remis gespielt", punkte(2, 1, 1, 1), 0)
pruefe("Remis getippt, anderes Remis", punkte(1, 1, 2, 2), 2)

' ---- Der Ablauf gegen eine echte Datenbank -------------------------------
PRINT ""
PRINT "=== Ablauf in der Datenbank ==="

DIM db AS DB_CONN
db = DB_OPEN(":memory:")

DB_EXEC(db, "CREATE TABLE spieler (id INTEGER PRIMARY KEY, name TEXT)")
DB_EXEC(db, "CREATE TABLE spiele (id INTEGER PRIMARY KEY, spieltag INTEGER, " + _
            "heim TEXT, gast TEXT, anstoss TEXT, tore_heim INTEGER, tore_gast INTEGER)")
' Dieselbe Paarung am selben Spieltag gibt es nur einmal -- wie in
' tippspiel.dh als Index, damit die Regel auch fuer eine Datenbank gilt,
' die es schon vorher gab.
DB_EXEC(db, "CREATE UNIQUE INDEX idx_spiel ON spiele (spieltag, heim, gast)")
DB_EXEC(db, "CREATE TABLE tipps (id INTEGER PRIMARY KEY, spieler_id INTEGER, " + _
            "spiel_id INTEGER, tipp_heim INTEGER, tipp_gast INTEGER, punkte INTEGER, " + _
            "UNIQUE(spieler_id, spiel_id))")

DB_EXEC(db, "INSERT INTO spieler (id, name) VALUES (1, 'Anna'), (2, 'Ben')")
DB_EXEC(db, "INSERT INTO spiele (id, spieltag, heim, gast) VALUES " + _
            "(1, 1, 'Bayern', 'Stuttgart'), (2, 1, 'Dortmund', 'HSV')")

' Anna tippt exakt, Ben daneben
DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) VALUES (1,1,2,1)")
DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) VALUES (2,1,0,3)")

DIM r AS DB_RESULT
r = DB_QUERY(db, "SELECT COUNT(*) FROM tipps")
DB_NEXT(r)
pruefe("Tipps gespeichert", DB_GET_INT(r, 0), 2)
DB_CLOSE_RESULT(r)

' Derselbe Tipp noch einmal -- darf keine zweite Zeile geben (UNIQUE + UPSERT)
DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) " + _
            "VALUES (1,1,4,0) ON CONFLICT(spieler_id, spiel_id) DO UPDATE SET " + _
            "tipp_heim = excluded.tipp_heim, tipp_gast = excluded.tipp_gast, punkte = NULL")
r = DB_QUERY(db, "SELECT COUNT(*) FROM tipps")
DB_NEXT(r)
pruefe("Zweiter Tipp ueberschreibt, legt nicht an", DB_GET_INT(r, 0), 2)
DB_CLOSE_RESULT(r)

' Zurueck auf den exakten Tipp
DB_EXEC(db, "UPDATE tipps SET tipp_heim = 2, tipp_gast = 1 WHERE spieler_id = 1 AND spiel_id = 1")

' Ergebnis eintragen und werten
DB_EXEC(db, "UPDATE spiele SET tore_heim = 2, tore_gast = 1 WHERE id = 1")

CONST MAXT = 100
DIM ids[MAXT] AS INTEGER
DIM werte[MAXT] AS INTEGER
DIM n AS INTEGER : n = 0
r = DB_QUERY(db, "SELECT id, tipp_heim, tipp_gast FROM tipps WHERE spiel_id = 1")
WHILE DB_NEXT(r)
    ids[n] = DB_GET_INT(r, 0)
    werte[n] = punkte(DB_GET_INT(r, 1), DB_GET_INT(r, 2), 2, 1)
    n = n + 1
WEND
DB_CLOSE_RESULT(r)

DB_BEGIN(db)
DIM i AS INTEGER
FOR i = 0 TO n - 1
    DB_EXEC(db, "UPDATE tipps SET punkte = ? WHERE id = ?", werte[i], ids[i])
NEXT
DB_COMMIT(db)

r = DB_QUERY(db, "SELECT punkte FROM tipps WHERE spieler_id = 1 AND spiel_id = 1")
DB_NEXT(r)
pruefe("Anna bekommt 3 Punkte", DB_GET_INT(r, 0), 3)
DB_CLOSE_RESULT(r)

r = DB_QUERY(db, "SELECT punkte FROM tipps WHERE spieler_id = 2 AND spiel_id = 1")
DB_NEXT(r)
pruefe("Ben bekommt 0 Punkte", DB_GET_INT(r, 0), 0)
DB_CLOSE_RESULT(r)

' ---- Rangliste: nur gewertete Spiele zaehlen -----------------------------
' Anna tippt auch das zweite Spiel -- das hat noch kein Ergebnis und darf
' die Rangliste nicht beeinflussen.
DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) VALUES (1,2,1,1)")

r = DB_QUERY(db, "SELECT p.name, " + _
                 "  COALESCE(SUM(CASE WHEN s.tore_heim IS NOT NULL THEN t.punkte END), 0) AS punkte, " + _
                 "  COUNT(t.id) AS tipps " + _
                 "FROM spieler p " + _
                 "LEFT JOIN tipps t ON t.spieler_id = p.id " + _
                 "LEFT JOIN spiele s ON s.id = t.spiel_id " + _
                 "GROUP BY p.id, p.name ORDER BY punkte DESC, p.name")
PRINT ""
PRINT "  Rangliste:"
DIM platz AS INTEGER : platz = 0
WHILE DB_NEXT(r)
    platz = platz + 1
    PRINT "    "; platz; ". "; DB_GET_STRING(r, 0); "  "; DB_GET_INT(r, 1); " Punkte aus "; _
          DB_GET_INT(r, 2); " Tipps"
    IF platz = 1 THEN
        pruefe("Erster ist Anna mit 3 Punkten", DB_GET_INT(r, 1), 3)
        pruefe("Annas offener Tipp zaehlt mit als abgegeben", DB_GET_INT(r, 2), 2)
    END IF
WEND
DB_CLOSE_RESULT(r)

' ---- Mehrere Spieltage ---------------------------------------------------
' Bis hierher lag alles auf dem 1. Spieltag. Eine Saison hat 34 -- und damit
' zwei Fragen, die vorher keine waren: welche Spiele gehoeren zusammen, und
' auf welchen Spieltag schaut man beim Start?
PRINT ""
PRINT "=== Mehrere Spieltage ==="

FUNCTION anzahl(sql AS STRING) AS INTEGER
    DIM q AS DB_RESULT
    q = DB_QUERY(db, sql)
    DIM n AS INTEGER : n = 0
    IF DB_NEXT(q) THEN n = DB_GET_INT(q, 0)
    DB_CLOSE_RESULT(q)
    RETURN n
END FUNCTION

' Auf welchen Spieltag schaut man? Auf den mit dem naechsten Anpfiff.
' Die Uhrzeit kommt als Parameter herein, nicht aus ZEIT_JETZT() -- eine
' Pruefung, deren Ergebnis vom Kalender abhaengt, prueft nichts.
FUNCTION spieltagBei(jetzt AS STRING) AS INTEGER
    DIM q AS DB_RESULT
    q = DB_QUERY(db, "SELECT spieltag FROM spiele " + _
                     "WHERE anstoss IS NOT NULL AND anstoss >= ? " + _
                     "ORDER BY anstoss LIMIT 1", jetzt)
    DIM tag AS INTEGER : tag = 0
    IF DB_NEXT(q) THEN tag = DB_GET_INT(q, 0)
    DB_CLOSE_RESULT(q)
    IF tag = 0 THEN tag = anzahl("SELECT COALESCE(MAX(spieltag), 1) FROM spiele")
    RETURN tag
END FUNCTION

DB_EXEC(db, "INSERT INTO spiele (id, spieltag, heim, gast, anstoss) VALUES " + _
            "(11, 2, 'Leipzig', 'Freiburg', '2026-09-04 20:30:00'), " + _
            "(12, 2, 'Koeln', 'Bremen', '2026-09-05 15:30:00'), " + _
            "(13, 3, 'Stuttgart', 'Bayern', '2026-09-11 20:30:00')")

pruefe("Spieltag 2 hat 2 Spiele", anzahl("SELECT COUNT(*) FROM spiele WHERE spieltag = 2"), 2)
pruefe("Spieltag 3 hat 1 Spiel", anzahl("SELECT COUNT(*) FROM spiele WHERE spieltag = 3"), 1)

' Ein zweiter Abruf desselben Spielplans darf nichts verdoppeln -- dafuer
' sorgt der Index, nicht das Programm.
DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) VALUES (2, ?, ?, ?) " + _
            "ON CONFLICT(spieltag, heim, gast) DO UPDATE SET anstoss = excluded.anstoss", _
        "Leipzig", "Freiburg", "2026-09-04 18:30:00")
pruefe("zweiter Abruf legt keine Dublette an", _
       anzahl("SELECT COUNT(*) FROM spiele WHERE spieltag = 2"), 2)
pruefe("dabei wird der Anstoss aufgefrischt", _
       anzahl("SELECT COUNT(*) FROM spiele WHERE id = 11 AND anstoss = '2026-09-04 18:30:00'"), 1)

' Dieselbe Paarung an einem ANDEREN Spieltag ist ein anderes Spiel. Ohne den
' Spieltag im Index waere das Rueckspiel keins.
DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) VALUES " + _
            "(20, 'Leipzig', 'Freiburg', '2027-02-06 15:30:00')")
pruefe("dieselbe Paarung am anderen Spieltag ist ein zweites Spiel", _
       anzahl("SELECT COUNT(*) FROM spiele WHERE heim = 'Leipzig' AND gast = 'Freiburg'"), 2)

pruefe("vor dem 2. Spieltag zeigt er auf den 2.", spieltagBei("2026-09-01 12:00:00"), 2)
pruefe("zwischen den Spielen bleibt er beim 2.", spieltagBei("2026-09-04 21:00:00"), 2)
pruefe("nach dem 2. Spieltag zeigt er auf den 3.", spieltagBei("2026-09-06 00:00:00"), 3)
pruefe("ist die Saison durch, bleibt der letzte stehen", spieltagBei("2027-12-31 00:00:00"), 20)

' Die Rangliste kennt keine Spieltage -- sie zaehlt die ganze Saison.
DB_EXEC(db, "UPDATE spiele SET tore_heim = 1, tore_gast = 0 WHERE id = 11")
DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast, punkte) " + _
            "VALUES (1, 11, 1, 0, 3)")
r = DB_QUERY(db, "SELECT COALESCE(SUM(CASE WHEN s.tore_heim IS NOT NULL " + _
                 "                         THEN t.punkte END), 0) " + _
                 "FROM tipps t LEFT JOIN spiele s ON s.id = t.spiel_id " + _
                 "WHERE t.spieler_id = 1")
DB_NEXT(r)
pruefe("Annas Punkte zaehlen ueber beide Spieltage", DB_GET_INT(r, 0), 6)
DB_CLOSE_RESULT(r)

' ---- Ergebnisse aus der Antwort ------------------------------------------
' Die Stelle, an der es lautlos falsch wird. matchResults hat ZWEI Eintraege,
' und der erste ist das Halbzeitergebnis -- Gladbach gegen Leverkusen stand
' zur Pause 0:2 und endete 2:3. Wer den ersten nimmt, wertet die Saison
' falsch aus, und zwar plausibel falsch: es stehen ja Zahlen da.
'
' Geprueft wird gegen eine Antwort von Hand, nicht gegen das Netz. Eine
' Pruefung, die eine Verbindung braucht, prueft an schlechten Tagen nichts.
PRINT ""
PRINT "=== Ergebnisse aus der Antwort ==="

' Wortgleich mit tippspiel.dh.
FUNCTION endergebnis(wurzel AS JSON_HANDLE, pfad AS STRING, _
                     BYREF toreHeim AS INTEGER, BYREF toreGast AS INTEGER) AS BOOLEAN
    IF NOT JSON_HAS(wurzel, pfad + ".matchIsFinished") THEN RETURN FALSE
    IF NOT JSON_GET_BOOL(wurzel, pfad + ".matchIsFinished") THEN RETURN FALSE

    DIM m AS INTEGER : m = JSON_LEN(wurzel, pfad + ".matchResults")
    DIM k AS INTEGER
    FOR k = 0 TO m - 1
        DIM rp AS STRING : rp = pfad + ".matchResults." + STR$(k)
        IF JSON_GET_INT(wurzel, rp + ".resultTypeID") = 2 THEN
            toreHeim = JSON_GET_INT(wurzel, rp + ".pointsTeam1")
            toreGast = JSON_GET_INT(wurzel, rp + ".pointsTeam2")
            RETURN TRUE
        END IF
    NEXT
    RETURN FALSE
END FUNCTION

' Einfache Anfuehrungszeichen schreiben sich leichter -- JSON braucht
' doppelte, also einmal tauschen.
FUNCTION alsJson(s AS STRING) AS STRING
    RETURN REPLACE$(s, "'", CHR$(34))
END FUNCTION

DIM roh AS STRING
roh = "[" + _
      "{'matchIsFinished': true, 'matchResults': [" + _
      "  {'resultTypeID': 1, 'pointsTeam1': 0, 'pointsTeam2': 2}," + _
      "  {'resultTypeID': 2, 'pointsTeam1': 2, 'pointsTeam2': 3}]}," + _
      "{'matchIsFinished': false, 'matchResults': [" + _
      "  {'resultTypeID': 1, 'pointsTeam1': 1, 'pointsTeam2': 0}]}," + _
      "{'matchIsFinished': true, 'matchResults': []}," + _
      "{'matchIsFinished': true, 'matchResults': [" + _
      "  {'resultTypeID': 2, 'pointsTeam1': 0, 'pointsTeam2': 0}," + _
      "  {'resultTypeID': 1, 'pointsTeam1': 0, 'pointsTeam2': 0}]}" + _
      "]"
DIM antwort AS JSON_HANDLE
antwort = JSON_PARSE(alsJson(roh))

DIM h AS INTEGER : h = -1
DIM g AS INTEGER : g = -1
pruefeJa("abgepfiffenes Spiel hat ein Ergebnis", endergebnis(antwort, "0", h, g), TRUE)
pruefe("  und zwar das Endergebnis, nicht die Halbzeit (Heim)", h, 2)
pruefe("  Gast", g, 3)

h = -1 : g = -1
pruefeJa("laufendes Spiel gibt keins her", endergebnis(antwort, "1", h, g), FALSE)
pruefe("  und ruehrt die Werte nicht an", h, -1)

pruefeJa("abgepfiffen, aber ohne Eintrag", endergebnis(antwort, "2", h, g), FALSE)

' Die Reihenfolge in der Antwort ist nichts, worauf man sich stuetzen darf.
h = -1 : g = -1
pruefeJa("Endergebnis zuerst wird auch gefunden", endergebnis(antwort, "3", h, g), TRUE)
pruefe("  0:0 ist ein Ergebnis, kein fehlendes", h + g, 0)

' Und die Probe aufs Ganze: der Halbzeitstand haette 1 Punkt gegeben, das
' Endergebnis gibt 3. Genau daran faellt der Fehler NICHT auf.
pruefe("exakter Tipp auf 2:3 gibt 3", punkte(2, 3, 2, 3), 3)
pruefe("Tipp auf den Halbzeitstand 0:2 gaebe nur 1", punkte(0, 2, 2, 3), 1)

DB_CLOSE(db)

PRINT ""
PRINT "============================================"
IF fehler = 0 THEN
    PRINT "ALLES GRUEN -- "; geprueft; " Pruefungen"
ELSE
    PRINT "FEHLER: "; fehler; " von "; geprueft; " Pruefungen"
END IF
PRINT "============================================"
