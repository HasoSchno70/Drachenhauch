=== anmeldung mit plain
IMPORT "smtp"
IMPORT "gegen.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_SERVER(m, "127.0.0.1", starten("AUTH PLAIN LOGIN", "1", "1"), "keine")
SMTP_FROM(m, "ich@beispiel.de", "Abteilung Zahlen")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Auswertung August")
SMTP_TEXT(m, "Anbei die Zahlen.")
SMTP_LOGIN(m, "hans", "geheim")
SMTP_SEND(m)
DIM b AS ARRAY OF STRING : b = READLINES("befehle.txt")
DIM i AS INTEGER
FOR i = 0 TO LEN(b) - 1
    IF UPPER$(LEFT$(b[i], 10)) = "AUTH PLAIN" THEN
        DIM w AS ARRAY OF STRING : w = SPLIT$(TRIM$(b[i]), " ")
        ' Nullbyte, Name, Nullbyte, Kennwort -- die Nullen sichtbar gemacht
        PRINT REPLACE$(BUFFER_TO_STRING$(BUFFER_FROM_BASE64(w[2])), CHR$(0), "|")
    END IF
NEXT
beenden()
--- datei gegen.dh
IMPORT "{sammlung}/_hilfen/smtpstart.dh"

--- argumente
{sammlung}/_hilfen/smtpserver.dh
--- erwartet
|hans|geheim

=== anmeldung mit login wenn plain fehlt
IMPORT "smtp"
IMPORT "gegen.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_SERVER(m, "127.0.0.1", starten("AUTH LOGIN", "1", "1"), "keine")
SMTP_FROM(m, "ich@beispiel.de", "Abteilung Zahlen")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Auswertung August")
SMTP_TEXT(m, "Anbei die Zahlen.")
SMTP_LOGIN(m, "hans", "geheim")
SMTP_SEND(m)
DIM b AS ARRAY OF STRING : b = READLINES("befehle.txt")
DIM i AS INTEGER
FOR i = 0 TO LEN(b) - 3
    IF TRIM$(b[i]) = "AUTH LOGIN" THEN
        PRINT "AUTH LOGIN"
        PRINT BUFFER_TO_STRING$(BUFFER_FROM_BASE64(TRIM$(b[i + 1])))
        PRINT BUFFER_TO_STRING$(BUFFER_FROM_BASE64(TRIM$(b[i + 2])))
    END IF
NEXT
beenden()
--- datei gegen.dh
IMPORT "{sammlung}/_hilfen/smtpstart.dh"

--- argumente
{sammlung}/_hilfen/smtpserver.dh
--- erwartet
AUTH LOGIN
hans
geheim

=== falsches kennwort wird gemeldet
' Der Wortlaut des Servers muss durchkommen -- sonst raet der Anwender.
IMPORT "smtp"
IMPORT "gegen.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_SERVER(m, "127.0.0.1", starten("AUTH PLAIN LOGIN", "0", "1"), "keine")
SMTP_FROM(m, "ich@beispiel.de", "Abteilung Zahlen")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Auswertung August")
SMTP_TEXT(m, "Anbei die Zahlen.")
SMTP_LOGIN(m, "hans", "falsch")
TRY
    SMTP_SEND(m)
    PRINT "raus"
CATCH e
    PRINT INSTR(e, "535") >= 0 AND INSTR(e, "falsch") >= 0
END TRY
beenden()
--- datei gegen.dh
IMPORT "{sammlung}/_hilfen/smtpstart.dh"

--- argumente
{sammlung}/_hilfen/smtpserver.dh
--- erwartet
TRUE

=== ohne anmeldung wird nicht angemeldet
IMPORT "smtp"
IMPORT "gegen.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_SERVER(m, "127.0.0.1", starten("AUTH PLAIN LOGIN", "1", "1"), "keine")
SMTP_FROM(m, "ich@beispiel.de", "Abteilung Zahlen")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Auswertung August")
SMTP_TEXT(m, "Anbei die Zahlen.")
SMTP_SEND(m)
DIM b AS ARRAY OF STRING : b = READLINES("befehle.txt")
DIM auth AS INTEGER : auth = 0
DIM i AS INTEGER
FOR i = 0 TO LEN(b) - 1
    IF UPPER$(LEFT$(b[i], 4)) = "AUTH" THEN auth = auth + 1
NEXT
' Und gesendet wurde trotzdem -- sonst waere die 0 billig.
PRINT auth; " "; befehl("QUIT")
beenden()
