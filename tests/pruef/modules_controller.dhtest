=== horizontal move
IMPORT "tiled"
IMPORT "tile_collide"
IMPORT "controller"
DIM m AS TILED_MAP
m = TILED_LOAD("level.json")
DIM c AS CHAR_CONTROLLER
c = CHAR_NEW(16.0, 96.0, 8.0, 8.0)
DIM i AS INTEGER
FOR i = 1 TO 3
    CHAR_SET_INPUT(c, 1, FALSE, FALSE)
    CHAR_UPDATE(c, m, 0)
NEXT
PRINT CHAR_X(c)
PRINT CHAR_FACING(c)
