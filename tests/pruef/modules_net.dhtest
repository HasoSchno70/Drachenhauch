' Aus test_modules_net.py uebertragen (21 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== tcp listen returns listener
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
PRINT NET_LISTENER_PORT(l) > 0
NET_CLOSE_LISTENER(l)
--- erwartet
TRUE

=== tcp listen invalid port raises
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(99999)
--- fehler
NET_TCP_LISTEN: port out of range: 99999

=== tcp accept non blocking returns nil
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM s AS NET_SOCKET
s = NET_TCP_ACCEPT(l)
PRINT IS_NIL(s)
NET_CLOSE_LISTENER(l)
--- erwartet
TRUE

=== tcp full roundtrip
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
DIM srv AS NET_SOCKET
DIM i AS INTEGER
FOR i = 1 TO 50
    srv = NET_TCP_ACCEPT(l)
    IF NOT IS_NIL(srv) THEN BREAK
    SLEEP(2)
NEXT
PRINT IS_NIL(srv)
PRINT NET_SEND(client, "hallo")
DIM got AS STRING
FOR i = 1 TO 50
    got = NET_RECV(srv, 1024)
    IF got <> "" THEN BREAK
    SLEEP(2)
NEXT
PRINT got
NET_CLOSE(client)
NET_CLOSE(srv)
NET_CLOSE_LISTENER(l)
--- erwartet
FALSE
5
hallo

=== tcp peer info
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
PRINT NET_PEER_ADDR(client)
PRINT NET_PEER_PORT(client) = NET_LISTENER_PORT(l)
NET_CLOSE(client)
NET_CLOSE_LISTENER(l)
--- erwartet
127.0.0.1
TRUE

=== tcp send validates socket type
IMPORT "net"
PRINT NET_SEND("not a socket", "hi")
--- fehler
NET_SEND: erwartet INTEGER, erhalten STRING

=== tcp set timeout no crash
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
NET_SET_TIMEOUT(client, 0)
NET_SET_TIMEOUT(client, 100)
NET_SET_TIMEOUT(client, -1)
PRINT "ok"
NET_CLOSE(client)
NET_CLOSE_LISTENER(l)
--- erwartet
ok

=== tcp is connected true while open
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
PRINT NET_IS_CONNECTED(client)
NET_CLOSE(client)
NET_CLOSE_LISTENER(l)
--- erwartet
TRUE

=== tcp is connected false after peer closes
IMPORT "net"
DIM l AS NET_LISTENER
l = NET_TCP_LISTEN(0)
DIM client AS NET_SOCKET
client = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
DIM srv AS NET_SOCKET
DIM i AS INTEGER
FOR i = 1 TO 50
    srv = NET_TCP_ACCEPT(l)
    IF NOT IS_NIL(srv) THEN BREAK
    SLEEP(2)
NEXT
NET_CLOSE(srv)
DIM waited AS INTEGER
DIM dummy AS STRING
waited = 0
WHILE NET_IS_CONNECTED(client) AND waited < 2000
    dummy = NET_RECV(client, 1024)
    SLEEP(20)
    waited = waited + 20
WEND
PRINT NET_IS_CONNECTED(client)
NET_CLOSE(client)
NET_CLOSE_LISTENER(l)
--- erwartet
FALSE

