' STRUCT name LAYOUT C -- C-Structs ueber BUFFER (docs/ffi.md, Abschnitt
' Struct-Lage; cstruct.rs). Eine Variable dieses Typs ist ein BUFFER in der
' Groesse des Structs, der Compiler kennt die Lage jedes Feldes. Die Lagen
' selbst pruefen die Rust-Tests in cstruct.rs; hier geht es um Sprache,
' Laufzeit und die Wege zu echten Bibliotheken.

=== die lage folgt den regeln von c
STRUCT Gemischt LAYOUT C
    a AS BYTE
    d AS FLOAT
    s AS SHORT
END STRUCT
STRUCT Dicht LAYOUT C PACK 1
    a AS BYTE
    d AS FLOAT
    s AS SHORT
END STRUCT
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
STRUCT Linie LAYOUT C
    n AS UBYTE
    p[2] AS Punkt
    name AS TEXT * 8
    w[3] AS FLOAT
    z AS ZEIGER
END STRUCT
PRINT SIZEOF(Gemischt), OFFSETOF(Gemischt, d), OFFSETOF(Gemischt, s)
PRINT SIZEOF(Dicht), OFFSETOF(Dicht, d), OFFSETOF(Dicht, s)
PRINT SIZEOF(Linie), OFFSETOF(Linie, p), OFFSETOF(Linie, name), OFFSETOF(Linie, w), OFFSETOF(Linie, z)
PRINT SIZEOF(LONG), SIZEOF(USHORT), SIZEOF(FLOAT), SIZEOF(ZEIGER)
' Die Variable ist ein BUFFER in genau dieser Groesse, voller Nullen.
DIM l AS Linie
PRINT TYPEOF(l), BUFFER_LEN(l), BUFFER_GET(l, 0)
--- erwartet
24 8 16
11 1 9
64 4 20 32 56
4 2 8 8
BUFFER 64 0

=== felder lesen und schreiben, auch verschachtelt und als feld von elementen
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
STRUCT Linie LAYOUT C
    n AS BYTE
    p[2] AS Punkt
    name AS TEXT * 8
    w[3] AS FLOAT
    flag AS BOOLEAN
END STRUCT
DIM l AS Linie
l.n = -3
l.p[1].x = 42
l.p[0].y = 7
l.name = "Drache"
l.w[2] = 2.5
l.flag = TRUE
PRINT l.n, l.p[1].x, l.p[0].y, l.name, l.w[2], l.flag
' Die Bytes liegen dort, wo C sie erwartet: p[1].x bei 4 + 8.
PRINT BUFFER_GET_I32(l, 12), BUFFER_GET(l, 0), BUFFER_GET_F64(l, 32 + 16)
FOR i = 0 TO 1
    l.p[i].x = l.p[i].x + i * 10
NEXT
l.p[0].x += 5
PRINT l.p[0].x, l.p[1].x
WITH l
    .n = 9
    PRINT .n + 1
END WITH
--- erwartet
-3 42 7 Drache 2.5 TRUE
42 253 2.5
5 52
10

=== als parameter, als rueckgabe und als sicht auf einen puffer
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
FUNCTION summe(p AS Punkt) AS INTEGER
    RETURN p.x + p.y
END FUNCTION
FUNCTION neu(x AS INTEGER, y AS INTEGER) AS Punkt
    DIM p AS Punkt
    p.x = x
    p.y = y
    RETURN p
END FUNCTION
DIM a AS Punkt
a = neu(3, 4)
PRINT summe(a)
' Ein Struct ist ein BUFFER: Zuweisen teilt die Bytes, BUFFER_SLICE kopiert.
DIM b AS Punkt
b = a
b.x = 100
DIM c AS Punkt
c = BUFFER_SLICE(a, 0, SIZEOF(Punkt))
c.y = -1
PRINT a.x, a.y, c.x, c.y
' Ein beliebiger Puffer laesst sich durch die Lage lesen.
DIM roh AS BUFFER
roh = BUFFER_NEW(8)
BUFFER_SET_I32(roh, 4, 77)
DIM sicht AS Punkt
sicht = roh
PRINT sicht.y
--- erwartet
7
100 4 100 -1
77

=== was nicht passt, bricht beim laufen ab
