' Bilder aus Drachenhauch Studio fuer das Buch "Fenster, Formulare, Daten".
'
' Das Studio laeuft als Kind mit fester Groesse (DH_STUDIO_GROESSE), einer
' eigenen studio.json (DH_STUDIO_KONFIG, sonst schriebe jeder Lauf dem
' Nutzer eine Sitzung) und auf einer KOPIE des Projekts aus ../code --
' F5 legt _studio/ an, und das gehoert nicht ins Buch. Wo eine Bedienung
' noetig ist (ein Dialog, ein Reiter), spielt das Studio eine kleine
' Aufnahme ab (DH_STUDIO_AUFNAHME). Format: "e BILD ART P0 P1 0 0", Maus
' 7 = hin, 6 = Taste runter, 5 = hoch; Tasten 2 = runter, 1 = hoch.
'
' Die Lagen der Klicks (Navigator, Controls) gelten fuer 1280x800 und die
' Projekte unter ../code. Aendert sich das Studio, zeigt das Bild etwas
' anderes -- darum alle Bilder nach jeder Fassung neu ziehen und ansehen.
'
'     dhrt run buecher/anwendungen/buch/studio_bilder.dh [-- name ...]
IMPORT "imgfx"

CONST GROESSE = "1280x800"
' Fuer den Reiter einer Datenbank breiter: erst ab 1440 stehen alle
' sieben Spalten des Spalten-Gitters ohne Rollen da.
DIM fenstergroesse AS STRING : fenstergroesse = GROESSE
CONST BILDER_STUDIO = 60
DIM hier AS STRING : hier = CWD$()
DIM wurzel AS STRING : wurzel = hier + "/../../.."
DIM studio AS STRING : studio = wurzel + "/studio/studio.dh"
DIM bilder AS STRING : bilder = hier + "/images"
DIM arbeit AS STRING : arbeit = hier + "/_studio_bilder"

SUB ordnerKopieren(von AS STRING, nach AS STRING)
    IF NOT DIREXISTS(nach) THEN MKDIR(nach)
    DIM n AS STRING
    FOR EACH n IN DIRLIST(von)
        IF DIREXISTS(von + "/" + n) THEN
            ordnerKopieren(von + "/" + n, nach + "/" + n)
        ELSE
            COPYFILE(von + "/" + n, nach + "/" + n)
        END IF
    NEXT
END SUB

SUB ordnerWeg(pfad AS STRING)
    IF NOT DIREXISTS(pfad) THEN RETURN
    DIM n AS STRING
    FOR EACH n IN DIRLIST(pfad)
        IF DIREXISTS(pfad + "/" + n) THEN ordnerWeg(pfad + "/" + n) ELSE DELETEFILE(pfad + "/" + n)
    NEXT
    RMDIR(pfad)
END SUB

' Eine frische Kopie des Projekts aus ../code/<rel>.
FUNCTION projekt$(rel AS STRING) AS STRING
    DIM ziel AS STRING : ziel = arbeit + "/" + BASENAME(rel)
    ordnerWeg(ziel)
    ordnerKopieren(hier + "/../code/" + rel, ziel)
    RETURN ziel
END FUNCTION

FUNCTION aufnahme$(name AS STRING, zeilen AS ARRAY OF STRING) AS STRING
    DIM p AS STRING : p = arbeit + "/" + name + ".txt"
    WRITEALL(p, "c " + STR$(LEN(zeilen)) + CHR$(10) + JOIN$(zeilen, CHR$(10)) + CHR$(10))
    RETURN p
END FUNCTION

' Laeuft ein Kind bis zum Ende; liefert seine Ausgabe.
FUNCTION laufen$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(p) + PROCESS_ERR$(p)
        aus = aus + t
        IF t = "" AND NOT PROCESS_RUNNING(p) THEN leer = leer + 1
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION

' Das Studio mit einem Projekt, `bilder` Bilder lang; am Ende ein Bild.
SUB studioBild(name AS STRING, proj AS STRING, oeffnen AS STRING, ev AS STRING, n AS INTEGER)
    SETENV("DH_STUDIO_KONFIG", arbeit + "/studio.json")
    SETENV("DH_STUDIO_GROESSE", fenstergroesse)
    SETENV("DH_STUDIO_OEFFNEN", oeffnen)
    SETENV("DH_STUDIO_AUFNAHME", ev)
    SETENV("DH_STUDIO_LAUF_BILDER", "3")
    ' PROCESS_START nimmt Kindern DHRT_FRAMES/DHRT_SCREENSHOT ab -- darum
    ' `dhrt bild`, das beides selbst setzt.
    DIM ziel AS STRING : ziel = bilder + "/" + name + ".png"
    IF FILEEXISTS(ziel) THEN DELETEFILE(ziel)
    DIM p AS INTEGER : p = PROCESS_START("dhrt", "bild", studio, ziel, STR$(n), "--", proj)
    DIM aus AS STRING : aus = laufen$(p)
    IF FILEEXISTS(bilder + "/" + name + ".png") THEN
        PRINT "  "; name; ".png"
    ELSE
        PRINT "  FEHLER "; name; " "; LEFT$(TRIM$(aus), 300)
        EXIT(1)
    END IF
END SUB

' Ein Ausschnitt statt des ganzen Studios: ein Dialog in der Mitte waere
' auf der Buchseite sonst briefmarkengross.
SUB zuschneiden(name AS STRING, x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    DIM p AS STRING : p = bilder + "/" + name + ".png"
    DIM b AS IMAGE : b = IMAGE_LOAD(p)
    IMAGE_SAVE(IMAGE_CROP(b, x, y, w, h), p)
END SUB

IF NOT DIREXISTS(arbeit) THEN MKDIR(arbeit)
IF NOT DIREXISTS(bilder) THEN MKDIR(bilder)
DIM ohne AS ARRAY OF INTEGER : ohne = []

' Ein Klick an (x, y) ab Bild b: hin, Taste runter, hoch.
SUB klick(z AS ARRAY OF STRING, b AS INTEGER, x AS INTEGER, y AS INTEGER)
    ARRAY_PUSH(z, "e " + STR$(b) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(z, "e " + STR$(b + 2) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(z, "e " + STR$(b + 3) + " 6 0 0 0 0")
    ARRAY_PUSH(z, "e " + STR$(b + 5) + " 5 0 0 0 0")
END SUB

' Eine Taste ab Bild b, mit gehaltenen Umschaltern (341 Strg, 340 Umschalt).
SUB taste(z AS ARRAY OF STRING, b AS INTEGER, halten AS ARRAY OF INTEGER, code AS INTEGER)
    DIM h AS INTEGER
    FOR EACH h IN halten
        ARRAY_PUSH(z, "e " + STR$(b) + " 2 " + STR$(h) + " 0 0 0")
    NEXT
    ARRAY_PUSH(z, "e " + STR$(b + 2) + " 2 " + STR$(code) + " 0 0 0")
    ARRAY_PUSH(z, "e " + STR$(b + 4) + " 1 " + STR$(code) + " 0 0 0")
    FOR EACH h IN halten
        ARRAY_PUSH(z, "e " + STR$(b + 6) + " 1 " + STR$(h) + " 0 0 0")
    NEXT
END SUB

' Ein Studio-Projekt mit F5 uebersetzen lassen und das erzeugte Programm
' aufnehmen, auf Wunsch mit einer Bedienung (Klicklagen im Programm, ohne
' SKALIERUNG). Fuer Kapitel 8 stand das einmal von Hand weiter unten.
SUB programmBild(name AS STRING, rel AS STRING, bedienung AS ARRAY OF STRING, n AS INTEGER)
    DIM pm AS STRING : pm = projekt$(rel)
    DIM zf AS ARRAY OF STRING : zf = ["e 0 7 640 400 0 0"]
    taste(zf, 20, ohne, 294)   ' F5 -- raylibs Code, nicht KEY_F5
    studioBild("_" + name + "_f5", pm, "", aufnahme$("f5_" + name, zf), 70)
    IF FILEEXISTS(bilder + "/_" + name + "_f5.png") THEN DELETEFILE(bilder + "/_" + name + "_f5.png")
    IF NOT FILEEXISTS(pm + "/_studio/main.dh") THEN
        PRINT "  FEHLER "; name; ": F5 hat _studio/main.dh nicht erzeugt"
        EXIT(1)
    END IF
    IF LEN(bedienung) > 0 THEN
        SETENV("DHRT_ABSPIELEN", aufnahme$("bed_" + name, bedienung))
    END IF
    DIM ziel AS STRING : ziel = bilder + "/" + name + ".png"
    DIM pl AS INTEGER
    pl = PROCESS_START("dhrt", "bild", pm + "/_studio/main.dh", ziel, STR$(n))
    DIM aus AS STRING : aus = laufen$(pl)
    SETENV("DHRT_ABSPIELEN", "")
    IF FILEEXISTS(ziel) THEN
        PRINT "  "; name; ".png"
    ELSE
        PRINT "  FEHLER "; name; " "; LEFT$(aus, 300)
        EXIT(1)
    END IF
END SUB

DIM nur AS ARRAY OF STRING : nur = []
DIM a AS INTEGER
FOR a = 0 TO ARGC() - 1
    ARRAY_PUSH(nur, ARG$(a))
NEXT
FUNCTION gewuenscht(name AS STRING) AS BOOLEAN
    RETURN LEN(nur) = 0 OR ARRAY_INDEXOF(nur, name) >= 0
END FUNCTION

DIM m AS STRING
DIM z AS ARRAY OF STRING

' Kapitel 8: der Entwurf der Mediathek, ohne Bedienung.
IF gewuenscht("kap08_entwurf") THEN
    m = projekt$("kap08/mediathek")
    studioBild("kap08_entwurf", m, "Hauptfenster", "", BILDER_STUDIO)
END IF

' Kapitel 8: Strg+Umschalt+N fragt, womit ein neues Projekt anfaengt.
IF gewuenscht("kap08_neu") THEN
    m = projekt$("kap08/mediathek")
    z = ["e 0 7 640 400 0 0"]
    taste(z, 20, [341, 340], 78)   ' N
    studioBild("kap08_neu", m, "", aufnahme$("neu", z), BILDER_STUDIO)
    zuschneiden("kap08_neu", 372, 192, 536, 416)
END IF

' Kapitel 8: ein Klick auf "Klick" im Navigator oeffnet den Code.
IF gewuenscht("kap08_code") THEN
    m = projekt$("kap08/mediathek")
    z = []
    klick(z, 20, 113, 253)
    studioBild("kap08_code", m, "Hauptfenster", aufnahme$("code", z), BILDER_STUDIO)
END IF

' Kapitel 8: F5 erzeugt _studio/ und startet; das Bild zeigt danach das
' erzeugte Programm selbst, nach einem Klick auf "Aufnehmen" mit leerem
' Feld.
IF gewuenscht("kap08_laeuft") THEN
    m = projekt$("kap08/mediathek")
    z = ["e 0 7 640 400 0 0"]
    taste(z, 20, ohne, 294)   ' F5 -- raylibs Code, nicht KEY_F5
    studioBild("_kap08_f5", m, "Hauptfenster", aufnahme$("f5", z), 70)
    IF NOT FILEEXISTS(m + "/_studio/main.dh") THEN
        PRINT "  FEHLER kap08_laeuft: F5 hat _studio/main.dh nicht erzeugt"
        EXIT(1)
    END IF
    z = ["e 0 7 435 34 0 0"]
    klick(z, 10, 435, 34)
    SETENV("DHRT_ABSPIELEN", aufnahme$("klick", z))
    DIM ziel AS STRING : ziel = bilder + "/kap08_laeuft.png"
    DIM pl AS INTEGER : pl = PROCESS_START("dhrt", "bild", m + "/_studio/main.dh", ziel, "40")
    DIM aus AS STRING : aus = laufen$(pl)
    SETENV("DHRT_ABSPIELEN", "")
    IF FILEEXISTS(ziel) THEN PRINT "  kap08_laeuft.png" ELSE PRINT "  FEHLER kap08_laeuft "; LEFT$(aus, 300)
    IF FILEEXISTS(bilder + "/_kap08_f5.png") THEN DELETEFILE(bilder + "/_kap08_f5.png")
END IF
' Kapitel 9: ein Klick auf die Tabelle im Entwurf -- der Inspektor zeigt
' ihre Lage samt Anker.
IF gewuenscht("kap09_anker") THEN
    m = projekt$("kap09/mediathek")
    z = []
    klick(z, 20, 615, 385)
    ' Die Gruppe "Daten" zuklappen, damit "Lage" mit dem Anker zu sehen ist.
    klick(z, 32, 1005, 169)
    studioBild("kap09_anker", m, "Hauptfenster", aufnahme$("anker", z), BILDER_STUDIO)
    ' Entwurf und Inspektor; Navigator und Bibliothek kennt Kapitel 8.
    zuschneiden("kap09_anker", 290, 66, 980, 536)
END IF

' Kapitel 9: das erzeugte Programm.
IF gewuenscht("kap09_programm") THEN
    programmBild("kap09_programm", "kap09/mediathek", [], 12)
END IF

' Kapitel 9, Loesung Erweitern 1: F11 (raylibs Code 300) maximiert.
IF gewuenscht("kap09_vollbild") THEN
    z = ["e 0 7 600 540 0 0"]
    taste(z, 6, ohne, 300)
    programmBild("kap09_vollbild", "loesungen/kap09_vollbild", z, 30)
END IF

' Kapitel 10: das Modul Beispiele im Code-Reiter; der Navigator zeigt
' Klasse, Modul und Fenster.
IF gewuenscht("kap10_modul") THEN
    m = projekt$("kap10/mediathek")
    z = []
    klick(z, 20, 110, 271)   ' die Funktion beispiele im Navigator
    studioBild("kap10_modul", m, "", aufnahme$("modul", z), BILDER_STUDIO)
    zuschneiden("kap10_modul", 0, 66, 940, 536)
END IF

' Kapitel 11: Metropolis waehlen, "Bearbeiten ..." -- das modale Fenster.
IF gewuenscht("kap11_bearbeiten") THEN
    z = []
    klick(z, 0, 100, 71)
    klick(z, 10, 415, 427)
    programmBild("kap11_bearbeiten", "kap11/mediathek", z, 40)
END IF

' Kapitel 12: der Fehler -- Metropolis, "Ausleihen ...", "Entfernen",
' Enter. Tetris ist gewaehlt, das Ausleihfenster sagt "Kein Eintrag".
IF gewuenscht("kap12_fehler") THEN
    z = []
    klick(z, 0, 100, 71)
    klick(z, 10, 670, 427)
    klick(z, 28, 540, 427)
    taste(z, 48, ohne, 257)
    programmBild("kap12_fehler", "kap11/mediathek", z, 80)
END IF

' Kapitel 12: der Debugger haelt in knopfEntfernen_Klick vor folgen(NIL).
' Das Studio oeffnet die Methode, setzt den Haltepunkt (Strg+Pos1, neunmal
' Pfeil runter, F9) und startet mit F7. Das Programm bekommt seine Klicks
' ueber DHRT_ABSPIELEN, das es vom Studio erbt (das Studio selbst spielt
' DH_STUDIO_AUFNAHME): Metropolis, "Ausleihen ...", "Entfernen", Enter.
IF gewuenscht("kap12_halt") THEN
    m = projekt$("kap11/mediathek")
    ' Der Navigator ist kurz: 16 Raststufen am Mausrad (je eine Zeile, 22
    ' Punkte) bringen knopfEntfernen_Klick von 540 auf 188.
    z = ["e 10 7 150 200 0 0", "e 12 8 0 -16 0 0"]
    klick(z, 20, 130, 188)
    taste(z, 40, [341], 268)
    DIM k AS INTEGER
    FOR k = 1 TO 9
        taste(z, 44 + k * 6, ohne, 264)
    NEXT
    taste(z, 110, ohne, 298)
    taste(z, 120, ohne, 296)
    DIM kz AS ARRAY OF STRING : kz = ["e 0 7 600 470 0 0"]
    klick(kz, 30, 100, 71)
    klick(kz, 50, 670, 427)
    klick(kz, 80, 540, 427)
    taste(kz, 110, ohne, 257)
    SETENV("DHRT_ABSPIELEN", aufnahme$("kind_halt", kz))
    studioBild("kap12_halt", m, "", aufnahme$("halt", z), 600)
    SETENV("DHRT_ABSPIELEN", "")
    ' Ohne Menue und Werkzeugleiste.
    zuschneiden("kap12_halt", 0, 66, 1280, 709)
END IF

' Kapitel 13: der Reiter der Datenbank. Erst F5 -- der erste Start legt die
' Tabellen an und traegt die Beispiele ein --, dann die Spalten von
' ausleihe (Verweise, Beim Loeschen) und die Daten von eintrag. Lagen fuer
' 1440 x 900 (Protokoll: "lage db daten").
IF gewuenscht("kap13_spalten") OR gewuenscht("kap13_daten") THEN
    m = projekt$("kap13/mediathek")
    fenstergroesse = "1440x900"
    z = ["e 0 7 640 400 0 0"]
    taste(z, 20, ohne, 294)
    studioBild("_kap13_f5", m, "", aufnahme$("f5_kap13", z), 70)
    IF FILEEXISTS(bilder + "/_kap13_f5.png") THEN DELETEFILE(bilder + "/_kap13_f5.png")
    IF gewuenscht("kap13_spalten") THEN
        studioBild("kap13_spalten", m, "Mediathek.ausleihe", "", 30)
        zuschneiden("kap13_spalten", 290, 66, 812, 640)
    END IF
    IF gewuenscht("kap13_daten") THEN
        z = []
        klick(z, 10, 618, 150)
        studioBild("kap13_daten", m, "Mediathek.eintrag", aufnahme$("daten", z), 40)
        zuschneiden("kap13_daten", 290, 66, 812, 640)
    END IF
    fenstergroesse = GROESSE
END IF

' Kapitel 11: Tetris waehlen, "Ausleihen ..." -- das Fenster daneben.
IF gewuenscht("kap11_ausleihen") THEN
    z = []
    klick(z, 0, 100, 91)
    klick(z, 10, 670, 427)
    programmBild("kap11_ausleihen", "kap11/mediathek", z, 40)
END IF

PRINT "fertig"
