=== gespiegelt steht der knopf des schalters links und der regler fuellt von rechts
' Bildproben zu Stufe 2 (gui_zeichnen.rs, Kind::Toggle `kx`, Kind::Slider
' `lage`/`gesp`): ein eingeschalteter Schalter hat seinen Knopf links, die
' rote Rinne rechts davon; ein Regler auf einem Viertel hat den Griff bei
' drei Vierteln, und mit Verlauf ist die Rinne von rechts gefuellt.
TRY
    SCREEN(480, 260, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 480, 260)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TOGGLE(w, "", 20, 20, TRUE)
GUI_SET_NAME(t, "t")
DIM s AS GUI_WIDGET : s = GUI_SLIDER(w, 20, 100, 300, 0, 100, 25)
GUI_SET_BOUNDS(s, 20, 100, 300, 24)
GUI_SET_NAME(s, "s")
DIM v AS GUI_WIDGET : v = GUI_SLIDER(w, 20, 180, 300, 0, 100, 25)
GUI_SET_BOUNDS(v, 20, 180, 300, 24)
GUI_SET_NAME(v, "v")
GUI_STYLESHEET("#t, #s { accent: #FF0000; verlauf: 0; glanz: 0; fase: 0 }" + CHR$(10) + "#v { accent: #FF0000; verlauf: 16 }")
GUI_WINDOW_RTL(w, TRUE)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(480, 260)
DIM n AS INTEGER
FOR n = 1 TO 30
    GUI_UPDATE() : CLS(0) : FLIP()
NEXT
RENDERTARGET_BEGIN(rt) : CLS(0) : GUI_DRAW() : RENDERTARGET_END()
CLS(0) : FLIP()
DIM bild AS IMAGE : bild = RENDERTARGET_IMAGE(rt)
FUNCTION rot(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    DIM c AS INTEGER : c = GETPIXEL(bild, x, y)
    RETURN ((c \ 65536) BAND 255) > 150 AND ((c \ 256) BAND 255) < 90 AND (c BAND 255) < 90
END FUNCTION
DIM ty AS INTEGER : ty = GUI_GET_Y(t) + GUI_GET_H(t) \ 2
' gespiegelt endet das Rechteck des Schalters bei 480 - 20 = 460
PRINT "schalter rechts in der rinne rot "; rot(452, ty)
' Regler s: 160..460; Griff bei drei Vierteln, nicht bei einem
PRINT "griff bei drei vierteln "; rot(160 + 225, 112); " bei einem viertel "; rot(160 + 75, 112)
' Regler v (mit Verlauf): rechts gefuellt, links leer
PRINT "rinne rechts "; rot(450, 192); " links "; rot(175, 192)
--- umgebung
DHRT_FRAMES=40
--- erwartet
schalter rechts in der rinne rot TRUE
griff bei drei vierteln TRUE bei einem viertel FALSE
rinne rechts TRUE links FALSE

=== gespiegelt steht der textbereich rechts und der klick trifft den text
' Wie beim Feld: ohne eigene Ausrichtung rueckt jede Zeile nach rechts
' (gui_eingabe.rs `ta_versatz`). Der Klick links vom Text setzt die Marke
' vor das erste Zeichen -- ohne den Versatz im Treffer laege sie am
' Zeilenende, und Entf naehme den Zeilenumbruch.
IMPORT "gui"
SCREEN(480, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 480, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TEXTAREA(w, 20, 40, 300, 120)
GUI_SET_TEXT(t, "abc" + CHR$(10) + "xy")
GUI_SET_NAME(t, "t")
GUI_STYLESHEET("#t { fg: #FF0000 }")
GUI_WINDOW_RTL(w, TRUE)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(480, 220)
FUNCTION rot_zwischen(x0 AS INTEGER, x1 AS INTEGER) AS BOOLEAN
    RENDERTARGET_BEGIN(rt) : CLS(0) : GUI_DRAW() : RENDERTARGET_END()
    DIM bild AS IMAGE : bild = RENDERTARGET_IMAGE(rt)
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR x = x0 TO x1
        FOR y = 44 TO 80
            IF (GETPIXEL(bild, x, y) BAND &HFFFFFF) = &HFF0000 THEN RETURN TRUE
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION
GUI_UPDATE()
' Der Bereich liegt gespiegelt bei 160..460; der Text am rechten Rand.
PRINT "text links "; rot_zwischen(162, 300); " rechts "; rot_zwischen(400, 458)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER
FOR n = 1 TO 20
    GUI_UPDATE()
    CLS(0) : GUI_DRAW() : FLIP()
NEXT
PRINT "text "; REPLACE$(GUI_TEXT(t), CHR$(10), "|")
