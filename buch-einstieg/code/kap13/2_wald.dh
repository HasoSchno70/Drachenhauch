' Kapitel 13 -- derselbe Befehl, sechsundzwanzigmal.

SUB baum(x AS INTEGER, y AS INTEGER, groesse AS INTEGER)
    DIM halb AS FLOAT
    halb = groesse / 10
    BOX(x - halb, y - groesse, x + halb, y, RGB(95, 65, 45))
    CIRCLE(x, y - groesse, groesse / 2, RGB(55, 145, 75))
END SUB

SCREEN(640, 400, "Ein Wald")

DIM i AS INTEGER
DIM n AS INTEGER

RANDOMIZE(3)

WHILE NOT QUITREQUESTED() AND NOT KEYPRESSED(KEY_ESCAPE)
    RANDOMIZE(3)
    CLS(RGB(150, 200, 235))
    BOX(0, 250, 639, 399, RGB(90, 150, 80))

    FOR i = 0 TO 25
        baum(RANDINT(10, 630), RANDINT(260, 395), RANDINT(35, 95))
    NEXT

    FLIP()
WEND
