=== postgres: anlegen, gleichzeitig bearbeiten, zahlen, liste
' Ziel aus der Umgebung statt aus dem Argument, dann wie beim Start der App.
DB_CLOSE(db)
ziel = GETENV$("DH_TEST_PG")
IF ziel = "" THEN
    PRINT "UEBERSPRINGEN: kein Testserver (DH_TEST_PG)"
    END
END IF
db = DB_OPEN(ziel) : art = DB_KIND$(db) : tabellenAnlegen()
IMPORT "../ablauf.dh"
vaAblauf()
EXIT(0)
--- programm ../../examples/verein/main.dh nach DIM beenden AS BOOLEAN
--- datei ablauf.dh
IMPORT "{sammlung}/_hilfen/verein_ablauf.dh"
IMPORT "{sammlung}/_hilfen/pdftext.dh"
