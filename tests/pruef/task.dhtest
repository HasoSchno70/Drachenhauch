=== text mit leerzeichen bleibt EIN argument
' Die Argumente gehen als eigene Kommandozeilen-Worte an `dhrt call` --
FUNCTION Summe(a AS INTEGER, b AS INTEGER, c AS INTEGER) AS INTEGER
    RETURN a + b + c
END FUNCTION
FUNCTION Satz(wer AS STRING, wie AS STRING) AS STRING
    RETURN wer + " ist " + wie
END FUNCTION
DIM a AS INTEGER
a = TASK_START(Satz, "der Text mit Leerzeichen", "heil")
WHILE NOT TASK_READY(a)
    SLEEP(2)
WEND
PRINT TASK_RESULT$(a)
--- erwartet
der Text mit Leerzeichen ist heil

