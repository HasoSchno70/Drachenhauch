' Loesung zu Kapitel 11, Erweitern 1: zwei eigene Kurven neben den
' eingebauten -- eine Treppe und ein Zittern.
' Die Stellen, die neu sind, stehen zwischen >>> und <<<.
IMPORT "tween"
CONST BREITE = 800
CONST HOEHE = 500
CONST LINKS = 160
CONST RECHTS = 740
CONST ABDRUCK = 0.05

DIM namen AS ARRAY OF STRING
namen = ["linear", "in_quad", "out_quad", "inout_sine", _
         "out_back", "out_elastic", "out_bounce"]
DIM fahrt AS ARRAY OF TWEEN
DIM i AS INTEGER
FOR i = 0 TO LEN(namen) - 1
    ARRAY_PUSH(fahrt, TWEEN_NEW(LINKS, RECHTS, 1500, namen[i]))
NEXT
' >>> neu
' Vier Stufen: der Weg in Spruengen, dazwischen Stillstand.
FUNCTION treppe(p AS FLOAT) AS FLOAT
    RETURN MIN(1.0, FLOOR(p * 4 + 0.999) / 4)
END FUNCTION

' Geradeaus, aber mit einem Zittern, das zum Ende hin abklingt.
FUNCTION zittern(p AS FLOAT) AS FLOAT
    RETURN p + 0.06 * SIN(p * 40) * (1 - p)
END FUNCTION

ARRAY_PUSH(namen, "treppe")
ARRAY_PUSH(fahrt, TWEEN_NEW(LINKS, RECHTS, 1500, treppe))
ARRAY_PUSH(namen, "zittern")
ARRAY_PUSH(fahrt, TWEEN_NEW(LINKS, RECHTS, 1500, zittern))
' <<< neu
DIM n AS INTEGER : n = LEN(namen)

' Die Spur: je Kurve hoechstens 40 Abdruecke.
' >>> neu
DIM spur[0 TO 8, 0 TO 39] AS FLOAT
' <<< neu
DIM abdruecke AS INTEGER
DIM uhr AS FLOAT
DIM pause AS FLOAT

SUB zeichnen()
    CLS(RGB(24, 26, 36))
    DIM k AS INTEGER
    DIM j AS INTEGER
    FOR k = 0 TO n - 1
        ' >>> neu
        DIM y AS FLOAT : y = 40 + k * 52
        ' <<< neu
        TEXT(16, y - 8, namen[k], RGB(200, 205, 220))
        LINE(LINKS, y, RECHTS, y, RGB(60, 64, 80))
        FOR j = 0 TO abdruecke - 1
            CIRCLE(spur[k, j], y, 3, RGB(110, 140, 220))
        NEXT
        CIRCLE(TWEEN_VALUE(fahrt[k]), y, 9, RGB(250, 200, 90))
    NEXT
    FLIP()
END SUB

SCREEN(BREITE, HOEHE, "Kurven")
' Ein Tween laeuft ab dem Anlegen -- das Fenster aufzumachen dauert
' einen Moment. Darum hier noch einmal von vorn.
FOR i = 0 TO n - 1
    TWEEN_RESTART(fahrt[i])
NEXT
WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE)
    DIM dt AS FLOAT : dt = DELTA()
    ' Abdruecke, solange die Fahrt laeuft.
    uhr = uhr + dt
    IF uhr >= ABDRUCK AND NOT TWEEN_DONE(fahrt[0]) AND abdruecke < 40 THEN
        FOR i = 0 TO n - 1
            spur[i, abdruecke] = TWEEN_VALUE(fahrt[i])
        NEXT
        abdruecke = abdruecke + 1
        uhr = uhr - ABDRUCK
    END IF
    ' Am Ende eine Sekunde stehen lassen, dann von vorn.
    IF TWEEN_DONE(fahrt[0]) THEN
        pause = pause + dt
        IF pause > 1.0 THEN
            FOR i = 0 TO n - 1
                TWEEN_RESTART(fahrt[i])
            NEXT
            abdruecke = 0
            pause = 0
            uhr = 0
        END IF
    END IF
    zeichnen()
WEND
