links TRUE
rechts TRUE
--- ton s.wav
abtastrate 8000
kanaele 2
kanaele verschieden
dauer 0.25 +-0.001

=== flac als musik laeuft in der schleife um
' Musik geht einen anderen Weg (gestreamt von Platte). Mit Kiras eigenem
' Dekoder blieb eine FLAC-Musik mit Schleife STUMM: Symphonia 0.6 springt
' nach dem ersten Durchlauf nicht sauber an den Anfang (src/flac_strom.rs).
' Die Datei ist 0,25 s lang -- in 0,7 s muss die Lage mindestens einmal
' zurueckspringen, und dazwischen muss sie vorankommen.
IMPORT "audio"
AUDIO_MUSIC_LOAD("mono.flac")
AUDIO_MUSIC_PLAY()
DIM vorher AS FLOAT : vorher = 0.0
DIM hoch AS FLOAT : hoch = 0.0
DIM spruenge AS INTEGER : spruenge = 0
DIM i AS INTEGER
FOR i = 1 TO 35
    SLEEP(20)
    DIM jetzt AS FLOAT : jetzt = AUDIO_MUSIC_POSITION()
    IF jetzt < vorher - 0.1 THEN spruenge = spruenge + 1
    IF jetzt > hoch THEN hoch = jetzt
    vorher = jetzt
NEXT
PRINT "kommt voran "; hoch > 0.15
PRINT "springt zurueck "; spruenge >= 1
AUDIO_MUSIC_STOP()
