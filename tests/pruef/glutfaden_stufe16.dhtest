=== probe: ohne muster die willkommensseite
IMPORT "helfer.dh"
' Ohne Muster: Startaktion "Willkommensseite" mit einer zuletzt geoeffneten
' Datei (und einer, die es nicht mehr gibt), und eine Datei im Aufruf, die
' nicht aufgeht.
MKDIR("app/Glutfaden")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
WRITEALL("app/Glutfaden/einstellungen.json", "{" + CHR$(34) + "start_action" + CHR$(34) + ": 4, " + CHR$(34) + "recent_files" + CHR$(34) + ": [" + CHR$(34) + REPLACE$(CWD$(), CHR$(92), "/") + "/alle.pxs" + CHR$(34) + ", " + CHR$(34) + "weg.pxs" + CHR$(34) + "]}")
dlStarten(["run", BEISPIEL, "--", "--probe-start"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "lauf 1: rueckgabe "; dlCode
    PRINT REGEX_REPLACE(REPLACE$(dlAus, CHR$(13), ""), "fenster [0-9]+x[0-9]+", "fenster nach dem Bildschirm");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    WRITEALL("app/Glutfaden/einstellungen.json", "{}")
    WRITEALL("kaputt.pxs", "kein Muster")
    dlStarten(["run", BEISPIEL, "--", "--probe-start", "kaputt.pxs"])
    PRINT "lauf 2: rueckgabe "; dlCode
    PRINT REGEX_REPLACE(REPLACE$(dlAus, CHR$(13), ""), "fenster [0-9]+x[0-9]+", "fenster nach dem Bildschirm");
END IF
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_farbverwaltung.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
