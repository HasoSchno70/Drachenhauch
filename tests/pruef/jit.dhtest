=== int ausserhalb und log und asin
DIM f AS FLOAT
DIM n AS INTEGER
DIM i AS INTEGER
f = 1.0
TRY
    FOR i = 1 TO 100
        n = INT(f)
        f = f * 1000.0
    NEXT
CATCH e
    PRINT "int: "; e; " "; i
END TRY
DIM s AS FLOAT
f = 3.0
TRY
    FOR i = 1 TO 10
        s = s + LOG(f)
        f = f - 1.0
    NEXT
CATCH e
    PRINT "log: "; e; " "; s; " "; i
END TRY
s = 0.0
f = 0.5
TRY
    FOR i = 1 TO 10
        s = s + ASIN(f) + ACOS(f)
        f = f + 0.25
    NEXT
CATCH e
    PRINT "asin: "; e; " "; s; " "; i
END TRY
--- umgebung
DHRT_JIT=aus
