' ============================================================================
'  GALAGA -- Prototyp (Buch-Zielstand)
'  Vollbild (Spielfeld per Kamera-Zoom zentriert skaliert), Formation mit
'  Einflug-Schwuengen, Sturzangriffe mit Bombenabwurf (auch weiter oben), das
'  Schiff kann auch ein Stueck nach oben manoevrieren. Lebens-Balken, Sound,
'  mehrere Level. Steuerung: Pfeile/WASD bewegen, Leertaste schiessen.
' ============================================================================
IMPORT "sprite"
IMPORT "curves"
IMPORT "audio"
IMPORT "camera"
IMPORT "particles"
IMPORT "save"

CONST PW       AS INTEGER = 240         ' Spielfeld-Breite (logisch)
CONST PH       AS INTEGER = 320         ' Spielfeld-Hoehe
CONST COLS     AS INTEGER = 8
CONST ROWS     AS INTEGER = 3
CONST NBUGS    AS INTEGER = 24
CONST NBULLET  AS INTEGER = 4
CONST NBOMB    AS INTEGER = 14
CONST BG       AS INTEGER = &H070A14
CONST FULL     AS BOOLEAN = TRUE        ' Vollbild? (zum Testen auf FALSE)

ENUM St = ENTER, FORM, DIVE

CLASS Bug
    DIM x AS FLOAT : DIM y AS FLOAT
    DIM hx AS FLOAT : DIM hy AS FLOAT
    DIM row AS INTEGER
    DIM alive AS BOOLEAN
    DIM state AS INTEGER
    DIM t AS FLOAT : DIM ts AS FLOAT
    DIM delay AS INTEGER
    DIM cx0 AS FLOAT : DIM cy0 AS FLOAT
    DIM cx1 AS FLOAT : DIM cy1 AS FLOAT
    DIM cx2 AS FLOAT : DIM cy2 AS FLOAT
    DIM cx3 AS FLOAT : DIM cy3 AS FLOAT
    DIM dropAt AS FLOAT
    DIM dropped AS BOOLEAN

    SUB Init(prow AS INTEGER, phx AS FLOAT, phy AS FLOAT, pdelay AS INTEGER)
        Self.row = prow : Self.hx = phx : Self.hy = phy : Self.delay = pdelay
        Self.alive = TRUE : Self.dropAt = -1.0 : Self.dropped = FALSE
        DIM side AS INTEGER : side = IIF(prow MOD 2 = 0, -1, 1)
        Self.SetPath(0.012, _
            phx - side * 90.0, -30.0, PW / 2.0 + side * 70.0, 80.0, _
            phx + side * 40.0, 40.0, phx, phy)
        Self.state = St.ENTER
    END SUB

    SUB SetPath(spd AS FLOAT, ax AS FLOAT, ay AS FLOAT, bx AS FLOAT, by AS FLOAT, _
                ccx AS FLOAT, ccy AS FLOAT, dx AS FLOAT, dy AS FLOAT)
        Self.ts = spd : Self.t = 0.0 : Self.dropped = FALSE
        Self.cx0 = ax : Self.cy0 = ay : Self.cx1 = bx : Self.cy1 = by
        Self.cx2 = ccx : Self.cy2 = ccy : Self.cx3 = dx : Self.cy3 = dy
        Self.x = ax : Self.y = ay
    END SUB

    ' Sturzangriff Richtung Spielerspalte px starten; speed waechst pro Level.
    SUB Dive(px AS FLOAT, speed AS FLOAT)
        DIM side AS INTEGER : side = IIF(Self.hx < PW / 2.0, 1, -1)
        Self.SetPath(speed, _
            Self.hx, Self.hy, Self.hx + side * 50.0, Self.hy + 80.0, _
            px, PH - 70.0, px - side * 50.0, PH + 30.0)
        ' Bombe faellt an einem zufaelligen Punkt der Bahn -- auch weiter oben.
        Self.dropAt = 0.28 + RANDF(0.0, 0.42)
        Self.state = St.DIVE
    END SUB

    ' Bonus-Welle: ein geschwungener Bogen quer durchs Bild (oben rein, unten
    ' raus). seed staffelt Seite + Startverzoegerung, damit es lebendig wirkt.
    SUB BonusPath(seed AS INTEGER)
        DIM side AS INTEGER : side = IIF(seed MOD 2 = 0, -1, 1)
        DIM sx AS FLOAT : sx = IIF(side < 0, -20.0, PW + 20.0)
        Self.SetPath(0.010 + RANDF(0.0, 0.005), _
            sx, -10.0, PW / 2.0 + side * 90.0, 70.0, _
            PW / 2.0 - side * 90.0, 180.0, PW / 2.0 - side * 60.0, PH + 30.0)
        Self.state = St.ENTER
        Self.delay = seed MOD 50
        Self.alive = TRUE
    END SUB

    FUNCTION Update(sway AS FLOAT, isBonus AS BOOLEAN) AS BOOLEAN
        IF Self.state = St.FORM THEN
            Self.x = Self.hx + sway : Self.y = Self.hy : RETURN FALSE
        END IF
        IF Self.delay > 0 THEN
            Self.delay = Self.delay - 1
            RETURN FALSE
        END IF
        Self.t = Self.t + Self.ts
        DIM bx AS FLOAT : DIM by AS FLOAT
        (bx, by) = CURVE_BEZIER2(MIN(Self.t, 1.0), Self.cx0, Self.cy0, _
            Self.cx1, Self.cy1, Self.cx2, Self.cy2, Self.cx3, Self.cy3)
        Self.x = bx : Self.y = by
        DIM drop AS BOOLEAN : drop = FALSE
        IF Self.state = St.DIVE AND NOT Self.dropped AND Self.t >= Self.dropAt THEN
            Self.dropped = TRUE : drop = TRUE
        END IF
        IF Self.t >= 1.0 THEN
            IF isBonus THEN
                Self.BonusPath(INT(Self.x) + INT(Self.t * 100.0) + 1)   ' neuer Bogen
            ELSEIF Self.state = St.DIVE THEN
                Self.SetPath(0.014, Self.hx, -30.0, Self.hx, 60.0, _
                    Self.hx, 30.0, Self.hx, Self.hy)
                Self.state = St.ENTER
            ELSE
                Self.state = St.FORM
            END IF
        END IF
        RETURN drop
    END FUNCTION
END CLASS

' ---------------------------------------------------------------------------
SCREEN(960, 540, "Galaga", 1)
IF FULL THEN SET_FULLSCREEN(TRUE)

' Eigenes Fenstersymbol statt des Standardsymbols der Laufzeit -- das Schiff
' liegt ohnehin als Bild vor. Wirkt auch in der exportierten .exe.
WINDOW_ICON(LOADIMAGE("../assets/sprites/player.png"))

' Retro-Arcade-Look: CRT-Shader (Scanlines/Woelbung/Vignette) per F1 ein/aus.
DIM crtShader AS INTEGER : crtShader = SHADER_LOAD("../assets/shaders/crt.fs")
DIM crtOn AS BOOLEAN : crtOn = (crtShader >= 0)

DIM shipImg AS IMAGE   : shipImg = LOADIMAGE("../assets/sprites/player.png")
DIM bulletImg AS IMAGE : bulletImg = LOADIMAGE("../assets/sprites/bullet.png")
DIM bombImg AS IMAGE   : bombImg = LOADIMAGE("../assets/sprites/bomb.png")

' Pro Reihe ein eigenes, mehrfarbiges Gegner-Sprite (kein TINT mehr noetig).
DIM rowBugImg[ROWS] AS IMAGE
rowBugImg[0] = LOADIMAGE("../assets/sprites/bug0.png")
rowBugImg[1] = LOADIMAGE("../assets/sprites/bug1.png")
rowBugImg[2] = LOADIMAGE("../assets/sprites/bug2.png")
' rowTint = Themenfarbe der Reihe -- nur noch fuer Explosionen/Score-Popups.
DIM rowTint[ROWS] AS INTEGER
rowTint[0] = &HBE64F0 : rowTint[1] = &HE44040 : rowTint[2] = &H46B4FF
DIM rowSpr[ROWS] AS SPRITE
DIM r AS INTEGER
FOR r = 0 TO ROWS - 1
    rowSpr[r] = SPRITE_NEW(rowBugImg[r], 16, 16)
    SPRITE_ADD_ANIM(rowSpr[r], "fly", 0, 1, 4)
    SPRITE_PLAY(rowSpr[r], "fly")
NEXT r
DIM bombSpr AS SPRITE
bombSpr = SPRITE_NEW(bombImg, 6, 6)
SPRITE_ADD_ANIM(bombSpr, "pulse", 0, 1, 8)
SPRITE_PLAY(bombSpr, "pulse")

' --- Sound (prozedural, sfxr-Stil; AUDIO_SFX = wf,freq,slide,atk,sus,dec,vibDepth,vibSpeed,vol) ---
DIM sfxShoot AS INTEGER : sfxShoot = AUDIO_SFX("square", 1040, -700, 0, 8, 95, 0, 0, 0.30)    ' knackiger Laser
DIM sfxBoom  AS INTEGER : sfxBoom  = AUDIO_SFX("noise", 220, -120, 0, 60, 220, 0, 0, 0.58)
DIM sfxDrop  AS INTEGER : sfxDrop  = AUDIO_SFX("saw", 360, -180, 0, 24, 120, 0, 0, 0.36)
DIM sfxHit   AS INTEGER : sfxHit   = AUDIO_SFX("noise", 140, -70, 0, 120, 360, 0, 0, 0.66)
DIM sfxLevel AS INTEGER : sfxLevel = AUDIO_SFX("square", 440, 520, 4, 60, 200, 0, 0, 0.38)
' Neu: warbelnder Traktorstrahl, Sturz-Swoosh, 2-Ton-Gegner-Flap (rhythmische Praesenz).
DIM sfxBeam  AS INTEGER : sfxBeam  = AUDIO_SFX("sine", 300, 280, 20, 520, 240, 0.65, 15, 0.26)
DIM sfxDive  AS INTEGER : sfxDive  = AUDIO_SFX("square", 700, -380, 4, 210, 150, 0.5, 20, 0.22)
DIM sfxFlapA AS INTEGER : sfxFlapA = AUDIO_SFX("square", 150, 0, 2, 28, 26, 0, 0, 0.08)
DIM sfxFlapB AS INTEGER : sfxFlapB = AUDIO_SFX("square", 108, 0, 2, 28, 26, 0, 0, 0.08)

' --- Hintergrundmusik ---
' Bevorzugt der CC0-Arcade-Track (assets/music/spaceshooter.mp3 -- HydroGene,
' OpenGameArt, CC0, loopt nahtlos). Fehlt die Datei, faellt das Spiel auf eine
' prozedurale A-Moll-Arpeggio-Schleife zurueck. M schaltet die Musik um.
DIM hasMusic AS BOOLEAN : hasMusic = FILEEXISTS("../assets/music/spaceshooter.mp3")
IF hasMusic THEN PLAYMUSIC("../assets/music/spaceshooter.mp3", 0, 0.45)
DIM musTones[8] AS INTEGER
DIM musFreq[8] AS FLOAT
musFreq[0] = 110.0  : musFreq[1] = 164.81 : musFreq[2] = 220.0  : musFreq[3] = 261.63
musFreq[4] = 329.63 : musFreq[5] = 261.63 : musFreq[6] = 220.0  : musFreq[7] = 164.81
DIM mi AS INTEGER
FOR mi = 0 TO 7
    musTones[mi] = AUDIO_TONE(musFreq[mi], 190, "triangle", 0.20)
NEXT mi
DIM musOn AS BOOLEAN : musOn = TRUE
DIM musStep AS INTEGER : DIM musBeat AS INTEGER

' --- Explosionen (ein gemeinsames Partikelsystem, additiver Glow) ---
DIM explFx AS PARTICLE_SYSTEM
explFx = PARTICLE_SYSTEM_NEW(0.0, 0.0)
PARTICLE_SET_VELOCITY(explFx, -120.0, 120.0, -120.0, 120.0)  ' radial nach allen Seiten
PARTICLE_SET_LIFETIME(explFx, 220, 560)
PARTICLE_SET_GRAVITY(explFx, 0.0, 40.0)
PARTICLE_SET_SIZE(explFx, 2, 5)
PARTICLE_SET_FADE(explFx, TRUE)
PARTICLE_SET_MODE(explFx, "glow")                        ' additiv -> leuchtet
PARTICLE_SET_COLOR_END(explFx, &H200804)                 ' verglueht ins Dunkelrot

DIM bugs[NBUGS] AS Bug
DIM bx[NBULLET] AS FLOAT : DIM by[NBULLET] AS FLOAT : DIM bAlive[NBULLET] AS BOOLEAN
DIM bmx[NBOMB] AS FLOAT : DIM bmy[NBOMB] AS FLOAT : DIM bmvx[NBOMB] AS FLOAT : DIM boAlive[NBOMB] AS BOOLEAN

DIM playerX AS FLOAT : DIM playerY AS FLOAT
DIM lives AS INTEGER : DIM score AS INTEGER : DIM level AS INTEGER
DIM frame AS INTEGER : DIM invuln AS INTEGER
DIM diveTimer AS INTEGER : DIM diveSpeed AS FLOAT : DIM bombSpeed AS FLOAT
DIM levelMsg AS INTEGER : DIM bugsAlive AS INTEGER
DIM bonus AS BOOLEAN              ' ist die aktuelle Welle eine Bonus-Welle?
DIM bonusTimer AS INTEGER        ' Restdauer der Bonus-Welle (Frames)
DIM bonusHits AS INTEGER         ' Treffer in der Bonus-Welle

' --- Fangstrahl + Doppeljaeger (Boss faengt das Schiff, Befreiung = 2 Schiffe) ---
ENUM CapSt = OFF, SEEK, BEAM, BACK
DIM capState AS INTEGER          ' Phase der Fangsequenz
DIM capTimer AS INTEGER          ' Restdauer der BEAM-Phase
DIM capCool AS INTEGER           ' Frames bis zum naechsten Fang-Versuch
DIM bossIdx AS INTEGER           ' welcher Gegner ist der Boss
DIM bossHp AS INTEGER            ' Boss braucht 2 Treffer
DIM hasCaptured AS BOOLEAN       ' Boss haelt ein gefangenes Schiff
DIM dual AS BOOLEAN              ' Spieler hat den Doppeljaeger
DIM bossHoverX AS FLOAT          ' anvisierte Hover-x beim Fangen
DIM rescueOn AS BOOLEAN          ' befreites Schiff fliegt gerade herab
DIM rescueX AS FLOAT : DIM rescueY AS FLOAT

' --- Parallax-Sternenhimmel (3 Tiefen-Ebenen, von oben nach unten scrollend) ---
CONST NSTARS AS INTEGER = 90
DIM starX[NSTARS]   AS FLOAT      ' x-Position (Spielfeld-Koordinaten)
DIM starY[NSTARS]   AS FLOAT      ' y-Position (waechst -> nach unten)
DIM starSpd[NSTARS] AS FLOAT      ' Scroll-Tempo = Parallax-Tiefe
DIM starInt[NSTARS] AS INTEGER    ' Grund-Helligkeit 0..255
DIM starPh[NSTARS]  AS FLOAT      ' Phase fuers Funkeln (jeder Stern anders)

' --- Juice: Score-Popups, Screen-Shake, Muendungsblitz ---
CONST NPOP AS INTEGER = 12
DIM popX[NPOP]   AS FLOAT : DIM popY[NPOP]   AS FLOAT
DIM popVal[NPOP] AS INTEGER : DIM popLife[NPOP] AS INTEGER   ' Restframes, 0 = frei
DIM shake AS FLOAT               ' Kamera-Wackel-Staerke (klingt ab)
DIM muzzle AS INTEGER            ' Restframes Muendungsblitz

' --- Spielzustand (Titel / Spiel / Namens-Eingabe) + Highscore-Liste ---
ENUM GS = TITLE, PLAY, ENTER
DIM mode AS INTEGER

' --- Attract-Modus (wie am Spielautomaten) ---------------------------------
' Passiert auf dem Titelbild eine Weile nichts, spielt das Spiel sich selbst:
' AUTOMATION_PLAY speist eine aufgezeichnete Eingabe wieder ein, das Spiel
' merkt davon nichts (KEYPRESSED & Co. liefern die aufgezeichneten Werte).
' F2 nimmt eine neue Demo auf, jede Eingabe bricht die Wiedergabe ab.
CONST DEMO_FILE  AS STRING  = "demo.txt"
CONST ATTRACT_MS AS INTEGER = 12000       ' Ruhe vor dem Demo-Start
DIM demoExists AS BOOLEAN : demoExists = FILEEXISTS(DEMO_FILE)
DIM attract AS BOOLEAN                    ' laeuft gerade eine Demo?
DIM idleSince AS INTEGER                  ' Frame der letzten echten Eingabe
CONST NHS AS INTEGER = 8
DIM hsName[NHS] AS STRING        ' Top-NHS Namen
DIM hsScore[NHS] AS INTEGER      ' Top-NHS Punkte (absteigend)
DIM hs AS SAVE_HANDLE            ' persistente Highscore-Datei
DIM entInit[3] AS INTEGER        ' 3 Initialen als Buchstaben-Index 0..25
DIM entPos AS INTEGER            ' aktive Initiale 0..2
' Tasten und Gamepad-Knoepfe haben mit KEYHIT/JOYSTICK_HIT eine eingebaute
' Flankenerkennung. Nur der ANALOGSTICK hat keine -- er liefert eine Zahl, kein
' Gedrueckt/Losgelassen. Fuer ihn merken wir uns die Auslenkung des letzten
' Frames selbst, damit ein gehaltener Stick im Menue nicht durchrattert.
DIM axPrevX AS INTEGER : DIM axPrevY AS INTEGER

CONST PY_LOW  AS FLOAT = 288.0          ' unterste Schiffsposition
CONST PY_HIGH AS FLOAT = 196.0          ' hoechste (nach oben manoevriert)

SUB NewLevel()
    DIM i AS INTEGER
    bonus = (level MOD 3 = 0)        ' jede 3. Welle ist eine Bonus-Welle
    DIM gapX AS FLOAT : gapX = 24.0
    DIM startX AS FLOAT : startX = (PW - (COLS - 1) * gapX) / 2.0 - 8.0
    FOR i = 0 TO NBUGS - 1
        DIM col AS INTEGER : col = i MOD COLS
        DIM rw AS INTEGER  : rw = i \ COLS
        bugs[i] = NEW Bug(rw, startX + col * gapX, 40.0 + rw * 22.0, i * 4)
        IF bonus THEN bugs[i].BonusPath(i * 7 + level * 13)   ' quer durchfliegen
    NEXT i
    FOR i = 0 TO NBULLET - 1 : bAlive[i] = FALSE : NEXT i
    FOR i = 0 TO NBOMB - 1 : boAlive[i] = FALSE : NEXT i
    bugsAlive = NBUGS
    diveTimer = 110
    diveSpeed = 0.009 + level * 0.0016
    bombSpeed = 2.1 + level * 0.40
    bonusTimer = 540                 ' ~9 s Bonus-Welle
    bonusHits = 0
    ' Boss = mittlerer Gegner der obersten Reihe; haelt 2 Treffer aus.
    bossIdx = COLS \ 2
    bossHp = 2
    hasCaptured = FALSE
    capState = CapSt.OFF
    capCool = 360 + RANDINT(0, 240)
    rescueOn = FALSE
    levelMsg = 110
    PLAYSOUND(sfxLevel)
END SUB

' Partikel-Explosion an (ex,ey) in Farbe c mit n Funken ausloesen.
SUB Explode(ex AS FLOAT, ey AS FLOAT, c AS INTEGER, n AS INTEGER)
    PARTICLE_SET_POS(explFx, ex, ey)
    PARTICLE_SET_COLOR(explFx, c)
    PARTICLE_EMIT(explFx, n)
END SUB

' Schwebende "+pts"-Punkteanzeige an (px,py) in einen freien Slot legen.
SUB Popup(px AS FLOAT, py AS FLOAT, pts AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO NPOP - 1
        IF popLife[k] <= 0 THEN
            popX[k] = px : popY[k] = py : popVal[k] = pts : popLife[k] = 45
            RETURN
        END IF
    NEXT k
END SUB

' Eine Kugel an x-Position fx in einen freien Slot legen (TRUE, wenn Platz war).
FUNCTION FireBullet(fx AS FLOAT) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO NBULLET - 1
        IF NOT bAlive[i] THEN
            bAlive[i] = TRUE : bx[i] = fx : by[i] = playerY - 2.0
            RETURN TRUE
        END IF
    NEXT i
    RETURN FALSE
END FUNCTION

SUB Shoot()
    ' Doppeljaeger feuert aus beiden Schiffen gleichzeitig.
    DIM ok AS BOOLEAN : ok = FireBullet(playerX + 5.0)
    IF dual THEN ok = FireBullet(playerX + 19.0) OR ok
    IF ok THEN muzzle = 5 : PLAYSOUND(sfxShoot)
END SUB

SUB DropBomb(sx AS FLOAT, sy AS FLOAT)
    DIM i AS INTEGER
    FOR i = 0 TO NBOMB - 1
        IF NOT boAlive[i] THEN
            boAlive[i] = TRUE : bmx[i] = sx + 5.0 : bmy[i] = sy + 8.0
            bmvx[i] = MAX(-1.1, MIN(1.1, (playerX - sx) * 0.022))
            PLAYSOUND(sfxDrop)
            RETURN
        END IF
    NEXT i
END SUB

FUNCTION Overlap(ax AS FLOAT, ay AS FLOAT, aw AS FLOAT, ah AS FLOAT, _
                 cx AS FLOAT, cy AS FLOAT, cw AS FLOAT, ch AS FLOAT) AS BOOLEAN
    RETURN ax < cx + cw AND ax + aw > cx AND ay < cy + ch AND ay + ah > cy
END FUNCTION

' ===================== Highscore-Liste (persistent) =====================
SUB LoadScores()
    hs = SAVE_LOAD_OR_NEW("galaga_hs.sav")
    DIM k AS INTEGER
    FOR k = 0 TO NHS - 1
        hsName[k] = SAVE_GET_STRING_OR(hs, "name" + STR$(k), "---")
        hsScore[k] = SAVE_GET_INT_OR(hs, "score" + STR$(k), 0)
    NEXT k
END SUB

SUB SaveScores()
    DIM k AS INTEGER
    FOR k = 0 TO NHS - 1
        SAVE_SET_STRING(hs, "name" + STR$(k), hsName[k])
        SAVE_SET_INT(hs, "score" + STR$(k), hsScore[k])
    NEXT k
    SAVE_WRITE(hs, "galaga_hs.sav")
END SUB

' Reicht `sc` fuer die Liste (besser als der letzte Platz)?
FUNCTION Qualifies(sc AS INTEGER) AS BOOLEAN
    RETURN sc > hsScore[NHS - 1]
END FUNCTION

' Neuen Eintrag absteigend einsortieren (der letzte faellt heraus) und speichern.
SUB InsertScore(nm AS STRING, sc AS INTEGER)
    DIM k AS INTEGER : k = NHS - 1
    WHILE k > 0 AND hsScore[k - 1] < sc
        hsName[k] = hsName[k - 1] : hsScore[k] = hsScore[k - 1]
        k = k - 1
    WEND
    hsName[k] = nm : hsScore[k] = sc
    SaveScores()
END SUB

' Die drei gewaehlten Initialen als String ("ABC").
FUNCTION EntryName() AS STRING
    DIM letters AS STRING : letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    RETURN letters[entInit[0]] + letters[entInit[1]] + letters[entInit[2]]
END FUNCTION

' Gamepad-Flanke mit Sicherheitsnetz: OHNE angeschlossenes Pad melden die
' JOYSTICK_-Befehle einen Fehler (sie pruefen den Index). Diese Huelle liefert
' dann einfach FALSE -- so bleibt der Spielcode frei von Abfragen.
FUNCTION PadHit(btn AS INTEGER) AS BOOLEAN
    IF JOYSTICK_COUNT() = 0 THEN RETURN FALSE
    RETURN JOYSTICK_HIT(0, btn)
END FUNCTION

' Kurzer Ruettler im Gamepad -- nur wenn ueberhaupt eins angeschlossen ist.
' staerke 0..1 je Motor, dauer in SEKUNDEN (nicht Millisekunden!).
SUB Rumble(staerke AS FLOAT, dauer_s AS FLOAT)
    IF JOYSTICK_COUNT() > 0 THEN JOYSTICK_RUMBLE(0, staerke, staerke, dauer_s)
END SUB

' ===================== Modus-Wechsel =====================
SUB StartGame()
    lives = 3 : score = 0 : level = 1
    playerX = PW / 2.0 - 8.0 : playerY = PY_LOW
    invuln = 0
    dual = FALSE              ' Doppeljaeger nur durch Rettung
    NewLevel()
    mode = GS.PLAY
END SUB

SUB GameOver()
    ' Frueher mussten hier Flanken-Flags gesetzt werden, damit die beim Tod
    ' gehaltene Leertaste nicht sofort neu startet. Mit KEYHIT erledigt sich das
    ' von selbst: eine gehaltene Taste loest erst nach dem Loslassen wieder aus.
    ' Der Score bleibt erhalten (wird erst beim naechsten Start = 0).
    IF Qualifies(score) THEN
        entInit[0] = 0 : entInit[1] = 0 : entInit[2] = 0 : entPos = 0
        mode = GS.ENTER
    ELSE
        mode = GS.TITLE
    END IF
END SUB

' Namens-Eingabe: hoch/runter wechselt den Buchstaben, links/rechts die Stelle,
' Leertaste bestaetigt. Alle mit Flankenerkennung (kein Dauer-Scrollen).
SUB NameEntry()
    ' Tastatur und D-Pad liefern ihre Flanke selbst (KEYHIT/JOYSTICK_HIT), beim
    ' Analogstick berechnen wir sie aus der Auslenkung des letzten Frames.
    DIM ax AS INTEGER : DIM ay AS INTEGER
    IF JOYSTICK_COUNT() > 0 THEN
        ax = SGN2(JOYSTICK_AXIS(0, 0)) : ay = SGN2(JOYSTICK_AXIS(0, 1))
    END IF
    DIM up AS BOOLEAN : up = KEYHIT(KEY_UP) OR KEYHIT(KEY_W) OR PadHit(1) OR (ay < 0 AND axPrevY >= 0)
    DIM dn AS BOOLEAN : dn = KEYHIT(KEY_DOWN) OR KEYHIT(KEY_S) OR PadHit(3) OR (ay > 0 AND axPrevY <= 0)
    DIM lf AS BOOLEAN : lf = KEYHIT(KEY_LEFT) OR KEYHIT(KEY_A) OR PadHit(4) OR (ax < 0 AND axPrevX >= 0)
    DIM rt AS BOOLEAN : rt = KEYHIT(KEY_RIGHT) OR KEYHIT(KEY_D) OR PadHit(2) OR (ax > 0 AND axPrevX <= 0)
    DIM ok AS BOOLEAN : ok = KEYHIT(KEY_ENTER) OR KEYHIT(KEY_RETURN) OR PadHit(7) OR PadHit(9)
    axPrevX = ax : axPrevY = ay
    IF up THEN entInit[entPos] = (entInit[entPos] + 1) MOD 26
    IF dn THEN entInit[entPos] = (entInit[entPos] + 25) MOD 26
    IF rt AND entPos < 2 THEN entPos = entPos + 1
    IF lf AND entPos > 0 THEN entPos = entPos - 1
    IF ok THEN
        InsertScore(EntryName(), score)
        mode = GS.TITLE
    END IF
END SUB

' Vorzeichen einer Achse mit Totzone: -1 / 0 / +1.
FUNCTION SGN2(v AS FLOAT) AS INTEGER
    IF v < -0.35 THEN RETURN -1
    IF v > 0.35 THEN RETURN 1
    RETURN 0
END FUNCTION

' Ein Begleiter (Nachbar des Bosses) stuerzt mit, wenn er lebt + in Formation ist.
SUB EscortDive(idx AS INTEGER)
    IF idx >= 0 AND idx < NBUGS THEN
        IF bugs[idx].alive AND bugs[idx].state = St.FORM THEN
            bugs[idx].Dive(playerX, diveSpeed)
        END IF
    END IF
END SUB

' ===================== Boss-Fangsequenz =====================
' Treibt den Boss durch SEEK (zum Hover-Punkt) -> BEAM (Strahl + Fang-Kollision)
' -> BACK (zurueck in die Formation). Laeuft nur, wenn capState <> OFF; der Boss
' wird dann NICHT vom generischen Bug.Update bewegt.
SUB UpdateCapture()
    IF capState = CapSt.OFF THEN RETURN
    DIM bx AS FLOAT : bx = bugs[bossIdx].x
    DIM by AS FLOAT : by = bugs[bossIdx].y
    IF capState = CapSt.SEEK THEN
        DIM tx AS FLOAT : tx = MAX(16.0, MIN(PW - 32.0, bossHoverX - 8.0))
        bugs[bossIdx].x = bx + (tx - bx) * 0.06
        bugs[bossIdx].y = by + (120.0 - by) * 0.06
        IF ABS(bugs[bossIdx].x - tx) < 2.0 AND ABS(bugs[bossIdx].y - 120.0) < 2.0 THEN
            capState = CapSt.BEAM : capTimer = 150 : PLAYSOUND(sfxBeam)
        END IF
    ELSEIF capState = CapSt.BEAM THEN
        capTimer = capTimer - 1
        IF capTimer = 75 THEN PLAYSOUND(sfxBeam)        ' Strahl klanglich halten
        ' Fang-Kollision: Spielerschiff im (nach unten breiter werdenden) Strahl?
        IF lives > 0 AND invuln = 0 AND NOT hasCaptured THEN
            DIM beamCx AS FLOAT : beamCx = bx + 8.0
            DIM halfW AS FLOAT : halfW = 6.0 + (playerY - (by + 14.0)) * 0.18
            IF playerY > by AND ABS((playerX + 8.0) - beamCx) < halfW THEN
                hasCaptured = TRUE
                dual = FALSE                 ' ein evtl. Doppeljaeger geht dabei verloren
                lives = lives - 1
                shake = 7.0 : PLAYSOUND(sfxHit) : Rumble(0.7, 0.26)
                IF lives <= 0 THEN
                    GameOver()
                ELSE
                    playerX = PW / 2.0 - 8.0 : playerY = PY_LOW : invuln = 120
                END IF
                capState = CapSt.BACK
            END IF
        END IF
        IF capTimer <= 0 THEN capState = CapSt.BACK
    ELSEIF capState = CapSt.BACK THEN
        DIM hx AS FLOAT : hx = bugs[bossIdx].hx
        DIM hy AS FLOAT : hy = bugs[bossIdx].hy
        bugs[bossIdx].x = bx + (hx - bx) * 0.07
        bugs[bossIdx].y = by + (hy - by) * 0.07
        IF ABS(bugs[bossIdx].x - hx) < 2.0 AND ABS(bugs[bossIdx].y - hy) < 2.0 THEN
            bugs[bossIdx].state = St.FORM
            capState = CapSt.OFF
            capCool = 360 + RANDINT(0, 300)
        END IF
    END IF
END SUB

' ===================== Spiel-Update (nur im Modus PLAY) =====================
SUB UpdatePlay()
    DIM i AS INTEGER
    ' Eingabe: bewegen + schiessen -- Tastatur ODER Gamepad (Stick/D-Pad + A).
    ' `pad` kurzschliesst: ohne Controller werden die JOYSTICK_*-Aufrufe nie
    ' ausgewertet (headless voellig inaktiv).
    DIM pad AS BOOLEAN : pad = (JOYSTICK_COUNT() > 0)
    IF KEYPRESSED(KEY_LEFT)  OR KEYPRESSED(KEY_A) OR (pad AND (JOYSTICK_AXIS(0, 0) < -0.35 OR JOYSTICK_BUTTON(0, 4))) THEN playerX = playerX - 3.0
    IF KEYPRESSED(KEY_RIGHT) OR KEYPRESSED(KEY_D) OR (pad AND (JOYSTICK_AXIS(0, 0) >  0.35 OR JOYSTICK_BUTTON(0, 2))) THEN playerX = playerX + 3.0
    IF KEYPRESSED(KEY_UP)    OR KEYPRESSED(KEY_W) OR (pad AND (JOYSTICK_AXIS(0, 1) < -0.35 OR JOYSTICK_BUTTON(0, 1))) THEN playerY = playerY - 2.4
    IF KEYPRESSED(KEY_DOWN)  OR KEYPRESSED(KEY_S) OR (pad AND (JOYSTICK_AXIS(0, 1) >  0.35 OR JOYSTICK_BUTTON(0, 3))) THEN playerY = playerY + 2.4
    IF playerX < 2.0 THEN playerX = 2.0
    DIM maxX AS FLOAT : maxX = IIF(dual, PW - 34.0, PW - 18.0)
    IF playerX > maxX THEN playerX = maxX
    IF playerY < PY_HIGH THEN playerY = PY_HIGH
    IF playerY > PY_LOW THEN playerY = PY_LOW
    ' Ein Schuss pro Tastendruck -- KEYHIT/JOYSTICK_HIT liefern genau den einen
    ' Frame, in dem die Taste heruntergeht (gehalten feuert also nicht weiter).
    IF KEYHIT(KEY_SPACE) OR PadHit(7) THEN Shoot()

    ' --- Boss-Fangsequenz (nur ausserhalb der Bonus-Welle) ---
    IF NOT bonus THEN
        IF capState = CapSt.OFF AND NOT hasCaptured AND NOT dual AND lives > 0 _
           AND bugs[bossIdx].alive AND bugs[bossIdx].state = St.FORM THEN
            capCool = capCool - 1
            IF capCool <= 0 THEN capState = CapSt.SEEK : bossHoverX = playerX
        END IF
        UpdateCapture()
    END IF

    ' Sturzangriff ausloesen (in der Bonus-Welle gibt es keine Stuerze/Bomben).
    IF NOT bonus THEN
        diveTimer = diveTimer - 1
        IF diveTimer <= 0 THEN
            diveTimer = MAX(24, 64 - level * 5) + RANDINT(0, 30)
            ' Manchmal ein Boss-gefuehrter Gruppensturz (Boss + 2 flankierende
            ' Begleiter) -- das typische Galaga-Eskort-Manoever.
            IF bugs[bossIdx].alive AND bugs[bossIdx].state = St.FORM AND capState = CapSt.OFF AND RANDINT(0, 2) = 0 THEN
                bugs[bossIdx].Dive(playerX, diveSpeed) : PLAYSOUND(sfxDive)
                EscortDive(bossIdx - 1)
                EscortDive(bossIdx + 1)
            ELSE
                DIM nDive AS INTEGER : nDive = MIN(1 + level \ 2, 3)
                DIM launched AS INTEGER : launched = 0
                DIM tries AS INTEGER
                FOR tries = 0 TO 20
                    IF launched >= nDive THEN BREAK
                    DIM pick AS INTEGER : pick = RANDINT(0, NBUGS - 1)
                    IF bugs[pick].alive AND bugs[pick].state = St.FORM THEN
                        bugs[pick].Dive(playerX, diveSpeed)
                        PLAYSOUND(sfxDive)
                        launched = launched + 1
                    END IF
                NEXT tries
            END IF
        END IF
    END IF

    ' Gegner bewegen (Sturz wirft am Tiefpunkt eine Bombe; in der Bonus-Welle
    ' fliegen sie nur Boegen und werfen nichts).
    DIM sway AS FLOAT : sway = SIN(frame * 0.03) * 10.0
    FOR i = 0 TO NBUGS - 1
        IF bugs[i].alive THEN
            ' Boss waehrend der Fangsequenz wird von UpdateCapture bewegt.
            IF i = bossIdx AND capState <> CapSt.OFF THEN
                ' uebersprungen
            ELSE
                IF bugs[i].Update(sway, bonus) THEN DropBomb(bugs[i].x, bugs[i].y)
            END IF
        END IF
    NEXT i

    ' Bullets + Bomben bewegen.
    FOR i = 0 TO NBULLET - 1
        IF bAlive[i] THEN
            by[i] = by[i] - 5.0
            IF by[i] < -8.0 THEN bAlive[i] = FALSE
        END IF
    NEXT i
    FOR i = 0 TO NBOMB - 1
        IF boAlive[i] THEN
            bmy[i] = bmy[i] + bombSpeed : bmx[i] = bmx[i] + bmvx[i]
            IF bmy[i] > PH THEN boAlive[i] = FALSE
        END IF
    NEXT i

    ' Bullet trifft Gegner.
    DIM j AS INTEGER
    FOR i = 0 TO NBULLET - 1
        IF bAlive[i] THEN
            FOR j = 0 TO NBUGS - 1
                IF bugs[j].alive AND Overlap(bx[i], by[i], 6, 8, bugs[j].x, bugs[j].y, 16, 16) THEN
                    bAlive[i] = FALSE
                    ' Boss: 2 Treffer. Erster Treffer nur Funken; zweiter zerstoert.
                    IF (NOT bonus) AND j = bossIdx THEN
                        bossHp = bossHp - 1
                        Explode(bugs[j].x + 8.0, bugs[j].y + 8.0, &HFFE070, 8)
                        PLAYSOUND(sfxBoom)
                        IF bossHp <= 0 THEN
                            bugs[j].alive = FALSE : bugsAlive = bugsAlive - 1
                            ' Boss im Sturz erlegt = mehr Punkte (Galaga-Bonus).
                            DIM bg AS INTEGER : bg = IIF(bugs[j].state = St.DIVE, 400, 150)
                            score = score + bg
                            Explode(bugs[j].x + 8.0, bugs[j].y + 8.0, &HFFC040, 28)
                            Popup(bugs[j].x - 4.0, bugs[j].y, bg)
                            ' Hielt der Boss ein Schiff? -> Rettung -> Doppeljaeger.
                            IF hasCaptured THEN
                                hasCaptured = FALSE
                                rescueOn = TRUE : rescueX = bugs[j].x : rescueY = bugs[j].y
                            END IF
                            capState = CapSt.OFF
                        END IF
                        BREAK
                    END IF
                    ' Punkte je Typ: Biene(unten) 50, Schmetterling(Mitte) 80,
                    ' obere Reihe 100; im Sturz das Doppelte (wie im Original).
                    DIM base AS INTEGER : base = 50
                    IF bugs[j].row = 0 THEN base = 100
                    IF bugs[j].row = 1 THEN base = 80
                    DIM gain AS INTEGER : gain = IIF(bonus, 150, base)
                    IF (NOT bonus) AND bugs[j].state = St.DIVE THEN gain = gain * 2
                    score = score + gain
                    Explode(bugs[j].x + 8.0, bugs[j].y + 8.0, rowTint[bugs[j].row], 18)
                    Popup(bugs[j].x + 2.0, bugs[j].y, gain)
                    PLAYSOUND(sfxBoom)
                    IF bonus THEN
                        bonusHits = bonusHits + 1
                        bugs[j].BonusPath(frame + j * 17 + 1)   ' sofort neu einfliegen
                    ELSE
                        bugs[j].alive = FALSE : bugsAlive = bugsAlive - 1
                    END IF
                    BREAK
                END IF
            NEXT j
        END IF
    NEXT i

    ' Spieler getroffen? (Doppeljaeger ist breiter; ein Treffer kostet dann erst
    ' das zweite Schiff statt eines Lebens.)
    IF invuln = 0 THEN
        DIM hit AS BOOLEAN : hit = FALSE
        DIM phx AS FLOAT : phx = playerX + 3.0
        DIM phw AS FLOAT : phw = IIF(dual, 24.0, 10.0)
        FOR i = 0 TO NBOMB - 1
            IF boAlive[i] AND Overlap(bmx[i], bmy[i], 6, 6, phx, playerY + 2.0, phw, 12) THEN
                boAlive[i] = FALSE : hit = TRUE
            END IF
        NEXT i
        FOR i = 0 TO NBUGS - 1
            IF bugs[i].alive AND bugs[i].state = St.DIVE AND _
               Overlap(bugs[i].x, bugs[i].y, 14, 14, phx, playerY + 2.0, phw, 12) THEN
                hit = TRUE
            END IF
        NEXT i
        IF hit THEN
            invuln = 90 : shake = 7.0
            PLAYSOUND(sfxHit)
            Rumble(0.7, 0.26)
            IF dual THEN
                dual = FALSE                                  ' zweites Schiff verloren
                Explode(playerX + 19.0, playerY + 6.0, &HFFC040, 26)
            ELSE
                lives = lives - 1
                Explode(playerX + 5.0, playerY + 6.0, &HFFC040, 30)
                IF lives <= 0 THEN GameOver()
            END IF
        END IF
    END IF

    ' Befreites Schiff fliegt herab und dockt neben dem Spieler an -> Doppeljaeger.
    IF rescueOn THEN
        rescueY = rescueY + 3.0
        rescueX = rescueX + (playerX - rescueX) * 0.05
        IF rescueY >= playerY THEN
            rescueOn = FALSE : dual = TRUE
            PLAYSOUND(sfxLevel)
        END IF
    END IF

    ' Level geschafft? (in der Bonus-Welle endet sie per Timer, nicht durch
    ' Leerschiessen -- die Gegner fliegen immer wieder neu ein.)
    IF bonus THEN
        bonusTimer = bonusTimer - 1
        IF bonusTimer <= 0 THEN
            score = score + bonusHits * 20      ' kleiner Abschluss-Bonus
            level = level + 1 : NewLevel()
        END IF
    ELSEIF lives > 0 AND bugsAlive <= 0 THEN
        level = level + 1 : NewLevel()
    END IF
END SUB

' ===================== Titel- und Eingabe-Screen =====================
' Zeichnet s horizontal zentriert auf dem Bildschirm (misst die Textbreite bei
' der aktuellen TEXT_SIZE -- vorher TEXT_SIZE setzen).
SUB CenterText(y AS INTEGER, s AS STRING, col AS INTEGER)
    TEXT(INT(SCREENWIDTH() / 2) - INT(TEXT_WIDTH(s) / 2), y, s, col)
END SUB

' Endlos-Laufschrift am unteren Rand (rechts -> links, nahtlos durch zwei Kopien).
SUB DrawMarquee(sh AS INTEGER)
    DIM sw AS INTEGER : sw = SCREENWIDTH()
    BOX(0, sh - 60, sw - 1, sh - 28, &H0A0E1A)        ' Banner-Band (volle Breite)
    TEXT_SIZE(24)
    DIM msg AS STRING
    msg = "*** WILLKOMMEN BEI GALAGA ***   RETTE DIE GALAXIE   ***   EIN SPIEL VON HANS SCHNORRENBERGER   ***   "
    DIM w AS INTEGER : w = TEXT_WIDTH(msg)
    DIM x AS INTEGER : x = -((frame * 2) MOD w)
    TEXT(x, sh - 53, msg, &H70C0FF)
    TEXT(x + w, sh - 53, msg, &H70C0FF)
    TEXT_SIZE(20)
END SUB

' Animierte Regenbogen-Streifen in den Letterbox-Raendern links/rechts vom
' Spielfeld: vertikal fliessender HSV-Verlauf, der zum Spielfeld hin hell glueht.
SUB DrawSideRainbows(sh AS INTEGER)
    DIM sw AS INTEGER : sw = SCREENWIDTH()
    DIM zoom AS FLOAT : zoom = sh / PH
    DIM offx AS INTEGER : offx = INT((sw - PW * zoom) / 2.0)
    IF offx <= 2 THEN RETURN                ' kein Rand (schmales Fenster) -> nichts
    DIM y AS INTEGER
    FOR y = 0 TO sh - 1 STEP 3
        DIM hue AS INTEGER : hue = (y + frame * 2) MOD 360
        DIM lite AS INTEGER : lite = HSV(hue, 0.95, 0.55)        ' Gluehen zum Spielfeld
        DIM dark AS INTEGER : dark = HSV(hue, 0.85, 0.03)        ' fast schwarz am Rand
        GRADIENTH(0, y, offx - 2, y + 2, dark, lite)             ' links: aussen->innen hell
        GRADIENTH(sw - offx + 2, y, sw - 1, y + 2, lite, dark)   ' rechts: innen hell->aussen
    NEXT y
END SUB

SUB DrawTitle(cx AS INTEGER, sh AS INTEGER)
    DrawSideRainbows(sh)
    TEXT_SIZE(48)
    CenterText(64, "GALAGA", &H8FE0FF)
    TEXT_SIZE(18)
    CenterText(128, "Pfeile / WASD bewegen     Leertaste schiessen", &H8090A8)
    CenterText(150, "(auch Gamepad)", &H607088)
    TEXT_SIZE(24)
    CenterText(186, "HIGHSCORES", &HFFE070)
    TEXT_SIZE(20)
    DIM k AS INTEGER
    FOR k = 0 TO NHS - 1
        DIM cc AS INTEGER : cc = IIF(k = 0, &HFFF0B0, &HBFD0E0)
        ' Feste Spaltenbreiten (PADL$) -> alle Zeilen gleich breit -> sauber zentriert.
        CenterText(214 + k * 24, STR$(k + 1) + ".  " + hsName[k] + "   " + PADL$(STR$(hsScore[k]), 6), cc)
    NEXT k
    IF (frame \ 30) MOD 2 = 0 THEN
        TEXT_SIZE(22)
        CenterText(sh - 96, "LEERTASTE = SPIEL STARTEN", &H80FFB0)
    END IF
    DrawMarquee(sh)
END SUB

SUB DrawEntry(cx AS INTEGER, sh AS INTEGER)
    DrawSideRainbows(sh)
    DIM letters AS STRING : letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    TEXT_SIZE(28)
    CenterText(108, "NEUER HIGHSCORE!", &HFFE070)
    TEXT_SIZE(24)
    CenterText(148, PADL$(STR$(score), 1), &HFFFFFF)
    ' Die drei Initialen gross, aktive Stelle blinkt.
    TEXT_SIZE(40)
    DIM total AS INTEGER : total = 3 * 34
    DIM x0 AS INTEGER : x0 = INT(SCREENWIDTH() / 2) - INT(total / 2)
    DIM k AS INTEGER
    FOR k = 0 TO 2
        DIM cc AS INTEGER : cc = &H90A8C0
        IF k = entPos THEN cc = IIF((frame \ 12) MOD 2 = 0, &HFFF080, &H6A5020)
        TEXT(x0 + k * 34, 184, letters[entInit[k]], cc)
    NEXT k
    TEXT_SIZE(18)
    CenterText(252, "Hoch/Runter: Buchstabe    Links/Rechts: Stelle", &H8090A8)
    CenterText(274, "ENTER = bestaetigen", &H80FFB0)
END SUB

frame = 0
LoadScores()
mode = GS.TITLE          ' wir starten im Titelbild (SPACE startet das Spiel)

' Sterne zufaellig verteilen und in drei Tiefen-Ebenen einteilen: ferne Sterne
' sind dunkel und langsam, nahe hell und schnell -- das erzeugt den Parallax.
DIM s AS INTEGER
FOR s = 0 TO NSTARS - 1
    starX[s] = RANDF(0.0, PW)
    starY[s] = RANDF(0.0, PH)
    starPh[s] = RANDF(0.0, 6.28)
    DIM lyr AS INTEGER : lyr = s MOD 3
    IF lyr = 0 THEN starSpd[s] = 0.35 : starInt[s] = 70     ' fern
    IF lyr = 1 THEN starSpd[s] = 0.85 : starInt[s] = 150    ' mittel
    IF lyr = 2 THEN starSpd[s] = 1.60 : starInt[s] = 235    ' nah
NEXT s

WHILE NOT QUITREQUESTED()
    frame = frame + 1

    ' ---- Pause, wenn das Fenster nicht im Vordergrund ist ----
    ' Ohne das laeuft das Spiel munter weiter, waehrend der Spieler etwas
    ' anderes tut -- und er kommt zu einem verlorenen Leben zurueck.
    IF NOT WINDOW_FOCUSED() THEN
        CLS(BG)
        CenterText(INT(SCREENHEIGHT() / 2) - 8, "PAUSE", &HFFE070)
        FLIP()
        CONTINUE
    END IF

    ' ---- Demo aufnehmen (F2) bzw. laufende Wiedergabe abbrechen ----
    IF KEYHIT(KEY_F2) THEN
        IF AUTOMATION_RECORDING() THEN
            AUTOMATION_STOP()
            demoExists = TRUE
        ELSE
            RANDOMIZE(4711)            ' derselbe Startwert wie bei der Wiedergabe
            AUTOMATION_RECORD(DEMO_FILE)
        END IF
    END IF
    IF attract AND (KEY_ANY_HIT() <> -1 OR JOYSTICK_ANY_BUTTON() <> -1) THEN
        AUTOMATION_STOP()               ' Spieler uebernimmt -> Demo beenden
        attract = FALSE
        mode = GS.TITLE
    END IF
    IF attract AND NOT AUTOMATION_PLAYING() THEN     ' Demo zu Ende
        attract = FALSE
        mode = GS.TITLE
    END IF

    ' ---- Retro-Look (F1) und Musik (M) umschalten ----
    IF KEYHIT(KEY_F1) AND crtShader >= 0 THEN crtOn = NOT crtOn
    IF KEYHIT(KEY_M) THEN
        musOn = NOT musOn
        IF hasMusic AND musOn THEN AUDIO_MUSIC_RESUME()
        IF hasMusic AND NOT musOn THEN AUDIO_MUSIC_PAUSE()
    END IF

    ' ---- Modus-Logik ----
    DIM i AS INTEGER
    IF mode = GS.PLAY THEN
        UpdatePlay()
    ELSEIF mode = GS.TITLE THEN
        IF KEYHIT(KEY_SPACE) OR PadHit(7) OR PadHit(9) THEN
            StartGame()
            idleSince = frame
        ELSEIF demoExists AND NOT AUTOMATION_RECORDING() _
               AND (frame - idleSince) * 1000 / 60 > ATTRACT_MS THEN
            ' Lange nichts passiert -> das Spiel spielt sich selbst. Die
            ' Aufnahme enthaelt auch den Druck auf die Leertaste, startet das
            ' Spiel also von allein -- ein StartGame() hier waere sogar falsch.
            ' Fester Zufalls-Startwert, damit dieselbe Eingabe denselben
            ' Verlauf ergibt: aufgezeichnet wird die EINGABE, nicht das
            ' Ergebnis.
            RANDOMIZE(4711)
            AUTOMATION_PLAY(DEMO_FILE)
            attract = TRUE
        END IF
    ELSEIF mode = GS.ENTER THEN
        NameEntry()
    END IF

    ' ---- Timer + Animation (laufen immer, fuer fluessige Optik) ----
    IF invuln > 0 THEN invuln = invuln - 1
    IF levelMsg > 0 THEN levelMsg = levelMsg - 1
    IF muzzle > 0 THEN muzzle = muzzle - 1
    IF shake > 0.3 THEN shake = shake * 0.86 ELSE shake = 0.0
    FOR r = 0 TO ROWS - 1 : SPRITE_UPDATE(rowSpr[r], 16) : NEXT r
    SPRITE_UPDATE(bombSpr, 16)
    PARTICLE_UPDATE(explFx, 16)
    DIM p AS INTEGER
    FOR p = 0 TO NPOP - 1
        IF popLife[p] > 0 THEN popY[p] = popY[p] - 0.6 : popLife[p] = popLife[p] - 1
    NEXT p
    ' Prozedurale Fallback-Musik (nur ohne MP3-Datei): alle 22 Frames eine Note.
    IF musOn AND NOT hasMusic THEN
        musBeat = musBeat + 1
        IF musBeat >= 22 THEN
            musBeat = 0 : PLAYSOUND(musTones[musStep]) : musStep = (musStep + 1) MOD 8
        END IF
    END IF
    ' Gegner-Flap-Loop: dezente, rhythmische 2-Ton-Praesenz waehrend des Spiels.
    IF mode = GS.PLAY AND frame MOD 22 = 0 THEN
        PLAYSOUND(IIF((frame \ 22) MOD 2 = 0, sfxFlapA, sfxFlapB))
    END IF

    ' ====================== ZEICHNEN ======================
    ' Vollbild: das Spielfeld per Kamera-Zoom auf die Bildschirmhoehe skalieren
    ' und horizontal zentrieren (alle Draws + SPRITE_DRAW folgen der Kamera).
    DIM sw AS INTEGER : sw = SCREENWIDTH()
    DIM sh AS INTEGER : sh = SCREENHEIGHT()
    DIM zoom AS FLOAT : zoom = sh / PH
    DIM offx AS FLOAT : offx = (sw - PW * zoom) / 2.0

    ' Retro-Look: ganze Szene durch den CRT-Shader praesentieren (oder aus).
    IF crtShader >= 0 AND crtOn THEN
        SHADER_SET2(crtShader, "resolution", sw, sh)
        SHADER_SET(crtShader, "time", frame / 60.0)
        POSTFX(crtShader)
    ELSE
        POSTFX(-1)
    END IF

    CLS(&H000000)
    ' Screen-Shake: bei Treffern ruckelt das ganze Spielfeld kurz (Welt-Einheiten).
    DIM shx AS FLOAT : shx = 0.0
    DIM shy AS FLOAT : shy = 0.0
    IF shake > 0.3 THEN shx = RANDF(-shake, shake) : shy = RANDF(-shake, shake)
    CAMERA_SET(-offx / zoom + shx, shy, zoom)

    BOX(0, 0, PW - 1, PH - 1, BG)                     ' Spielfeld-Hintergrund
    ' Parallax-Sternenhimmel: jede Ebene scrollt mit eigenem Tempo nach unten,
    ' jeder Stern funkelt per SIN ueber seine eigene Phase.
    FOR i = 0 TO NSTARS - 1
        starY[i] = starY[i] + starSpd[i]
        IF starY[i] >= PH THEN starY[i] = starY[i] - PH : starX[i] = RANDF(0.0, PW)
        DIM tw AS FLOAT : tw = 0.55 + 0.45 * SIN(frame * 0.08 + starPh[i])
        DIM v AS INTEGER : v = INT(starInt[i] * tw)
        DIM col AS INTEGER : col = RGB(INT(v * 0.85), INT(v * 0.92), v)
        PLOT(INT(starX[i]), INT(starY[i]), col)
        ' Nahe, hell funkelnde Sterne sind 2 Pixel breit -- wirken praesenter.
        IF starSpd[i] > 1.2 AND tw > 0.85 THEN PLOT(INT(starX[i]) + 1, INT(starY[i]), col)
    NEXT i
    ' Spiel-Objekte nur im PLAY-Modus (im Titel/Eingabe nur Sterne als Kulisse).
    IF mode = GS.PLAY THEN
        ' Tractor-Beam des Bosses (additiver Glow, nach unten breiter werdend).
        IF capState = CapSt.BEAM THEN
            BLEND_MODE("add")
            DIM bcx AS FLOAT : bcx = bugs[bossIdx].x + 8.0
            DIM bty AS INTEGER : bty = INT(bugs[bossIdx].y) + 14
            DIM yb AS INTEGER
            FOR yb = bty TO PH STEP 4
                DIM hw AS FLOAT : hw = 5.0 + (yb - bty) * 0.18
                DIM bcol AS INTEGER : bcol = RGB(24, 36 + (yb + frame * 4) MOD 60, 72)
                BOX(INT(bcx - hw), yb, INT(bcx + hw), yb + 2, bcol)
            NEXT yb
            BLEND_MODE("alpha")
        END IF
        FOR i = 0 TO NBUGS - 1
            IF bugs[i].alive THEN
                IF i = bossIdx THEN
                    ' Pulsierendes Halo macht den Boss als Ziel erkennbar.
                    DIM hr AS INTEGER : hr = 11 + INT(2.0 * SIN(frame * 0.2))
                    CIRCLE(INT(bugs[i].x) + 8, INT(bugs[i].y) + 8, hr, &H243A55)
                END IF
                SPRITE_SET_POS(rowSpr[bugs[i].row], bugs[i].x, bugs[i].y)
                SPRITE_DRAW(rowSpr[bugs[i].row])
                IF i = bossIdx AND hasCaptured THEN
                    DRAWIMAGE(shipImg, bugs[i].x, bugs[i].y + 15)   ' gefangenes Schiff
                END IF
            END IF
        NEXT i
        FOR i = 0 TO NBOMB - 1
            IF boAlive[i] THEN
                SPRITE_SET_POS(bombSpr, bmx[i], bmy[i]) : SPRITE_DRAW(bombSpr)
            END IF
        NEXT i
        FOR i = 0 TO NBULLET - 1
            IF bAlive[i] THEN DRAWIMAGE(bulletImg, bx[i], by[i])
        NEXT i
    END IF
    PARTICLE_DRAW(explFx)                  ' Explosionen (folgt Kamera, auch im Uebergang)
    IF mode = GS.PLAY THEN
        IF lives > 0 AND (invuln = 0 OR frame MOD 8 < 4) THEN
            DRAWIMAGE(shipImg, playerX, playerY)
            IF dual THEN DRAWIMAGE(shipImg, playerX + 14.0, playerY)   ' Doppeljaeger
        END IF
        ' Befreites Schiff im Anflug.
        IF rescueOn THEN DRAWIMAGE(shipImg, rescueX, rescueY)
        ' Muendungsblitz an der/den Schiffspitze(n) beim Schuss.
        IF muzzle > 0 THEN CIRCLE(INT(playerX) + 8, INT(playerY) - 1, 1 + muzzle, &HFFF080)
        IF muzzle > 0 AND dual THEN CIRCLE(INT(playerX) + 22, INT(playerY) - 1, 1 + muzzle, &HFFF080)
        ' Lebens-Balken (im Spielfeld, unten links).
        DIM lifeMax AS INTEGER : lifeMax = MAX(lives, 3)
        FOR i = 0 TO lifeMax - 1
            DIM lc AS INTEGER : lc = IIF(i < lives, &H44E06A, &H32323C)
            BOX(6 + i * 14, PH - 12, 6 + i * 14 + 10, PH - 6, lc)
        NEXT i
    END IF

    CAMERA_RESET()
    TEXT_SIZE(20)                 ' Basisgroesse setzen (Titel/Eingabe bumpen sie)
    DIM cx AS INTEGER : cx = INT(sw / 2)
    ' HUD nur im Spiel (Bildschirm-Raum, nicht gezoomt).
    IF mode = GS.PLAY THEN
        ' Score-Popups: Welt-Koordinaten von Hand auf den Bildschirm umrechnen
        ' (offx + x*zoom, y*zoom), damit der Text scharf bleibt (TEXT zoomt nicht).
        FOR p = 0 TO NPOP - 1
            IF popLife[p] > 0 THEN
                DIM pcol AS INTEGER : pcol = IIF(popLife[p] > 12, &HFFE070, &H7A5C30)
                TEXT(INT(offx + popX[p] * zoom), INT(popY[p] * zoom), f"+{popVal[p]}", pcol)
            END IF
        NEXT p
        TEXT(INT(offx) + 4, 6, f"SCORE {score}")
        TEXT(cx - 24, 6, f"LEVEL {level}")
        IF bonus THEN
            TEXT(cx - 32, 24, f"HITS {bonusHits}", &H80FFB0)
            IF levelMsg > 0 THEN TEXT(cx - 56, INT(sh / 2) - 8, "BONUS STAGE!", &HFFE070)
        ELSEIF levelMsg > 0 THEN
            TEXT(cx - 28, INT(sh / 2) - 4, f"LEVEL {level}")
        END IF
    END IF
    ' Umschalt-Hinweise immer sichtbar (oben rechts im Spielfeld).
    ' Rechtsbuendig am Spielfeldrand: TEXT_WIDTH misst die tatsaechliche Breite
    ' in der aktuellen Schrift. Frueher stand hier ein geschaetztes -56 -- der
    ' Hinweis ragte dadurch in den Regenbogenrand hinein.
    DIM h1 AS STRING : h1 = IIF(crtOn, "F1:CRT*", "F1:CRT")
    DIM h2 AS STRING : h2 = IIF(musOn, "M:Mus*", "M:Mus")
    TEXT(INT(sw - offx) - TEXT_WIDTH(h1) - 4, 6, h1, &H5C7088)
    TEXT(INT(sw - offx) - TEXT_WIDTH(h2) - 4, 22, h2, &H5C7088)

    IF mode = GS.TITLE THEN
        DrawTitle(cx, sh)
    ELSEIF mode = GS.ENTER THEN
        DrawEntry(cx, sh)
    END IF

    FLIP()
WEND
