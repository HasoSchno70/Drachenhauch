' studio_laufzeit.dh -- die Laufzeit eines Projekts aus dem Drachenhauch Studio.
'
' Das Studio kopiert diese Datei bei jedem Starten und Bauen nach _studio/.
' Geaendert wird sie in studio/laufzeit.dh, nicht in der Kopie.
'
' StudioApp ist die Basis der App, StudioFenster die Basis jeder erzeugten
' Fensterklasse (<Fenster>_Basis), StudioControl die jedes eigenen Controls
' (<Control>_Basis), StudioTimer ein Timer im Fenster oder Control.
' studioLauf() dreht die Bildschleife; ein Bild ist studioBild().
'
' Die Ereignisse fragt jedes Fenster NACH dem GUI_UPDATE ab (studioTakt),
' statt sie als Rueckruf der gui laufen zu lassen. Darum darf eine
' Ereignis-Methode warten: Frage(), Meldung(), Eingabe() und
' fenster.ZeigenModal() drehen selbst Bilder, bis eine Antwort da ist, und
' kehren erst dann zurueck -- wie in Xojo oder Visual Basic.

IMPORT "gui"
IMPORT "pdf"
IMPORT "imgfx"
IMPORT "chart"

' Eine Zeichenfläche malt ihren Text in der Schrift der Oberfläche daneben:
' der eigenen der gui (GUI_FONT), sonst der eingebauten Sans in der
' Textgröße des Programms -- nicht in der Pixelschrift, die TEXT ohne SETFONT
' nimmt. Wer eine andere will, setzt sie in Zeichnen selbst. Danach gilt
' wieder genau der Stand von vorher (GFX_PUSH/GFX_POP: Schrift, Größe, Stil):
' ohne eine eigene Schrift zeichnet die gui in der Textgröße des Programms,
' und ein TEXT_SIZE aus Zeichnen liess sonst die ganze Oberfläche schrumpfen.
DIM studioSans AS INTEGER : studioSans = -1

SUB studioSchriftAn()
    GFX_PUSH()
    IF GUI_FONT_GET()[0] >= 0 THEN
        SETFONT(GUI_FONT_GET()[0], GUI_FONT_GET()[1])
        RETURN
    END IF
    IF studioSans < 0 THEN studioSans = LOADFONT("sans", 32)
    SETFONT(studioSans, TEXT_HEIGHT())
END SUB

SUB studioSchriftAus()
    GFX_POP()
END SUB

CLASS StudioApp
    ' Nach dem Start, bevor das Startfenster aufgeht.
    SUB Geoeffnet()
    END SUB

    ' Bevor das Programm endet.
    SUB Beenden()
    END SUB
END CLASS

' Ein Timer: ruft sein Ereignis Aktion alle `Intervall` Millisekunden, solange
' er aktiv ist; ohne `Wiederholen` nur einmal.
CLASS StudioTimer
    DIM Intervall AS INTEGER
    DIM Aktiv AS BOOLEAN
    DIM Wiederholen AS BOOLEAN
    DIM studioStart AS INTEGER

    SUB Starten()
        Self.Aktiv = TRUE
        Self.studioStart = MILLIS()
    END SUB

    SUB Stoppen()
        Self.Aktiv = FALSE
    END SUB

    ' Je Bild gefragt: ist die Zeit um? Dann beginnt sie von vorn.
    FUNCTION studioFaellig() AS BOOLEAN
        IF NOT Self.Aktiv THEN RETURN FALSE
        IF MILLIS() - Self.studioStart < MAX(1, Self.Intervall) THEN RETURN FALSE
        Self.studioStart = MILLIS()
        IF NOT Self.Wiederholen THEN Self.Aktiv = FALSE
        RETURN TRUE
    END FUNCTION
END CLASS

' Ein Diagramm: eine Zeichenfläche mit einem CHART aus dem Modul chart
' (Kuchen, Balken, Linie, Fläche, Tacho, Leiste, Lampen). Es zeichnet sich
' je Bild selbst, so groß wie die Fläche, in den Farben des Themas der
' Oberfläche (hell oder dunkel, auch nach einem Wechsel). Daten kommen mit
' Hinzufuegen (Kuchen, Balken: Name und Wert), Reihe (Linie, gruppierte
' Balken) oder Wert (Tacho, Leiste, Lampen); alles Weitere über das Feld
' Diagramm mit den CHART_*-Befehlen.
CLASS StudioDiagramm
    DIM Flaeche AS GUI_WIDGET
    DIM Diagramm AS CHART
    DIM Art AS STRING
    DIM studioHell AS INTEGER     ' -1 = noch kein Thema gesetzt, 0 dunkel, 1 hell

    SUB Leeren()
        CHART_CLEAR(Self.Diagramm)
    END SUB

    ' Ein Wert mit Namen (Segment, Balken); Farbe -1 = aus der Palette.
    SUB Hinzufuegen(name AS STRING, wert AS FLOAT, farbe AS INTEGER = -1)
        CHART_ADD(Self.Diagramm, name, wert, farbe)
    END SUB

    ' Eine Reihe mit ihren Werten -> ihr Index.
    FUNCTION Reihe(name AS STRING, werte AS ARRAY OF FLOAT) AS INTEGER
        DIM r AS INTEGER : r = CHART_SERIES(Self.Diagramm, name)
        CHART_DATA(Self.Diagramm, r, werte)
        RETURN r
    END FUNCTION

    SUB Beschriften(punkt AS INTEGER, text AS STRING)
        CHART_LABEL(Self.Diagramm, punkt, text)
    END SUB

    ' Der Wert von Tacho, Leiste und Lampen.
    SUB Wert(w AS FLOAT)
        CHART_VALUE(Self.Diagramm, w)
    END SUB

    SUB Titel(t AS STRING)
        CHART_SET(Self.Diagramm, "titel", t)
    END SUB

    ' Eine Eigenschaft des Diagramms beim Namen (CHART_SET, _NUM, _FLAG):
    ' Setzen("legende", "rechts"), SetzenZahl("innenradius", 0.5),
    ' SetzenSchalter("prozent", TRUE).
    SUB Setzen(name AS STRING, wert AS STRING)
        CHART_SET(Self.Diagramm, name, wert)
    END SUB

    SUB SetzenZahl(name AS STRING, wert AS FLOAT)
        CHART_SET_NUM(Self.Diagramm, name, wert)
    END SUB

    SUB SetzenSchalter(name AS STRING, an AS BOOLEAN)
        CHART_SET_FLAG(Self.Diagramm, name, an)
    END SUB

    FUNCTION Anzahl() AS INTEGER
        RETURN CHART_COUNT(Self.Diagramm)
    END FUNCTION

    SUB studioZeichnen()
        IF NOT GUI_SHOWN(Self.Flaeche) THEN RETURN
        ' Das Thema der Oberfläche: hell, wenn ihr Hintergrund hell ist.
        ' Der Hintergrund ist der des Fensters, damit es sich einfügt.
        DIM bg AS INTEGER : bg = GUI_THEME_GET("win_bg")
        DIM hell AS INTEGER : hell = IIF(((bg SHR 16) BAND 255) + ((bg SHR 8) BAND 255) + (bg BAND 255) > 382, 1, 0)
        IF hell <> Self.studioHell THEN
            CHART_THEME(Self.Diagramm, IIF(hell = 1, "hell", "dunkel"))
            CHART_SET_COLOR(Self.Diagramm, "hintergrund", bg)
            Self.studioHell = hell
        END IF
        CHART_BOUNDS(Self.Diagramm, GUI_CANVAS_X(Self.Flaeche), GUI_CANVAS_Y(Self.Flaeche), GUI_CANVAS_W(Self.Flaeche), GUI_CANVAS_H(Self.Flaeche))
        CHART_UPDATE(Self.Diagramm, DELTA())
        studioSchriftAn()
        CHART_DRAW(Self.Diagramm)
        studioSchriftAus()
    END SUB
END CLASS

' Ein Diagramm auf der Fläche (art wie bei CHART_NEW).
FUNCTION studioDiagramm(flaeche AS GUI_WIDGET, art AS STRING, titel AS STRING) AS StudioDiagramm
    DIM d AS StudioDiagramm : d = NEW StudioDiagramm()
    d.Flaeche = flaeche
    d.Art = art
    d.studioHell = -1
    d.Diagramm = CHART_NEW(art, 0, 0, 10, 10)
    IF titel <> "" THEN CHART_SET(d.Diagramm, "titel", titel)
    CHART_SET_FLAG(d.Diagramm, "komma", TRUE)
    RETURN d
END FUNCTION

' Wo ein Teil eines eigenen Controls auf einer Achse liegt, wenn das Control
' um `mehr` groesser ist als entworfen -- wie ein verankertes Widget: am
' Anfang fest (Vorgabe), am Ende mitwandernd, an beiden mitwachsend.
' Dieselbe Rechnung wie teilLage im Studio (Vorschau im Entwurf).
FUNCTION studioAchse(lage AS INTEGER, mass AS INTEGER, anfang AS BOOLEAN, ende AS BOOLEAN, mehr AS INTEGER) AS TUPLE
    IF anfang AND ende THEN RETURN (lage, MAX(1, mass + mehr))
    IF ende THEN RETURN (lage + mehr, mass)
    RETURN (lage, mass)
END FUNCTION

' Ein eigenes Control. Im Fenster ist eine Instanz ein leerer
' Layout-Behaelter -- er laesst sich verankern und in Layouts legen, nimmt
' keine Klicks und zeichnet nichts --; die Teile liegen dahinter im selben
' Fenster. studioLegen setzt sie je Bild dorthin, wo der Behaelter gerade
' liegt, nach ihren Ankern im Control. Die Ereignisse seiner Teile fragt das
' Control selbst ab (studioTakt), das Fenster ruft es dazu je Bild.
CLASS StudioControl
    DIM studioWin AS GUI_WINDOW
    DIM studioHost AS GUI_WIDGET
    DIM studioOffen AS BOOLEAN
    DIM studioEntwurfB AS INTEGER
    DIM studioEntwurfH AS INTEGER
    ' Teile, die frei im Control liegen (nicht in einem seiner Layouts),
    ' mit Lage und Anker im Control; dazu alle Teile fuer Sichtbar().
    DIM studioTeile AS ARRAY OF GUI_WIDGET
    DIM studioTx AS ARRAY OF INTEGER
    DIM studioTy AS ARRAY OF INTEGER
    DIM studioTb AS ARRAY OF INTEGER
    DIM studioTh AS ARRAY OF INTEGER
    DIM studioTa AS ARRAY OF STRING
    DIM studioAlle AS ARRAY OF GUI_WIDGET
    DIM studioWar AS STRING
    DIM studioWarB AS INTEGER
    DIM studioWarH AS INTEGER
    ' Was das Control in diesem Bild mit Ausloesen gemeldet hat; das Fenster
    ' fragt es nach seinem Takt ab und leert es dann.
    DIM studioMeldungen AS ARRAY OF STRING
    ' Die eigenen Controls in diesem Control (Controls in Controls).
    DIM studioKinder AS ARRAY OF StudioControl

    ' Von der erzeugten Basis zuerst gerufen.
    SUB studioAnfangen(win AS GUI_WINDOW, behaelter AS GUI_WIDGET, b AS INTEGER, h AS INTEGER)
        Self.studioWin = win
        Self.studioHost = behaelter
        Self.studioEntwurfB = b
        Self.studioEntwurfH = h
        Self.studioTeile = [] : Self.studioTx = [] : Self.studioTy = [] : Self.studioTb = [] : Self.studioTh = []
        Self.studioTa = [] : Self.studioAlle = [] : Self.studioMeldungen = []
        Self.studioKinder = []
        Self.studioWar = ""
        Self.studioWarB = -1
        Self.studioWarH = -1
        Self.studioOffen = TRUE
    END SUB

    SUB studioTeil(w AS GUI_WIDGET, frei AS BOOLEAN, x AS INTEGER, y AS INTEGER, b AS INTEGER, h AS INTEGER, anker AS STRING)
        ARRAY_PUSH(Self.studioAlle, w)
        IF NOT frei THEN RETURN
        ARRAY_PUSH(Self.studioTeile, w)
        ARRAY_PUSH(Self.studioTx, x) : ARRAY_PUSH(Self.studioTy, y)
        ARRAY_PUSH(Self.studioTb, b) : ARRAY_PUSH(Self.studioTh, h)
        ARRAY_PUSH(Self.studioTa, LOWER$(anker))
    END SUB

    ' Die erzeugte Basis baut hier ihre Felder (Teile, Timer).
    SUB studioEinbauen(win AS GUI_WINDOW, behaelter AS GUI_WIDGET, erster AS INTEGER)
    END SUB

    ' Je Bild nach GUI_UPDATE: die Ereignisse der Teile.
    SUB studioTakt()
    END SUB

    ' Je Bild nach GUI_DRAW: die Zeichenflaechen.
    SUB studioZeichnen()
    END SUB

    ' Nachdem das Fenster mit dem Control aufgebaut ist.
    SUB Geoeffnet()
    END SUB

    ' Die inneren Controls zuerst, dann dieses -- wie das Fenster nach seinen.
    SUB studioGeoeffnet()
        DIM c AS StudioControl
        FOR EACH c IN Self.studioKinder
            c.studioGeoeffnet()
        NEXT
        Self.Geoeffnet()
    END SUB

    ' Das Fenster geht zu: dieses Control und seine inneren tun nichts mehr.
    SUB studioSchliessen()
        Self.studioOffen = FALSE
        DIM c AS StudioControl
        FOR EACH c IN Self.studioKinder
            c.studioSchliessen()
        NEXT
    END SUB

    ' Wenn sich die Groesse des Controls geaendert hat.
    SUB Groesse()
    END SUB

    ' In jedem Bild, nach den Ereignissen seiner Teile.
    SUB Takt()
    END SUB

    ' Je Bild: die Teile zum Behaelter.
    SUB studioLegen()
        IF NOT Self.studioOffen THEN RETURN
        DIM hx AS INTEGER : hx = GUI_GET_X(Self.studioHost)
        DIM hy AS INTEGER : hy = GUI_GET_Y(Self.studioHost)
        DIM hb AS INTEGER : hb = GUI_GET_W(Self.studioHost)
        DIM hh AS INTEGER : hh = GUI_GET_H(Self.studioHost)
        DIM schl AS STRING : schl = STR$(hx) + "," + STR$(hy) + "," + STR$(hb) + "," + STR$(hh)
        IF schl = Self.studioWar THEN RETURN
        Self.studioWar = schl
        DIM k AS INTEGER
        FOR k = 0 TO LEN(Self.studioTeile) - 1
            DIM a AS STRING : a = Self.studioTa[k]
            DIM x AS INTEGER
            DIM w AS INTEGER
            DIM y AS INTEGER
            DIM h AS INTEGER
            (x, w) = studioAchse(Self.studioTx[k], Self.studioTb[k], INSTR(a, "l") >= 0, INSTR(a, "r") >= 0, hb - Self.studioEntwurfB)
            (y, h) = studioAchse(Self.studioTy[k], Self.studioTh[k], INSTR(a, "t") >= 0, INSTR(a, "b") >= 0, hh - Self.studioEntwurfH)
            GUI_SET_BOUNDS(Self.studioTeile[k], hx + x, hy + y, w, h)
        NEXT
        DIM erstes AS BOOLEAN : erstes = Self.studioWarB < 0
        DIM anders AS BOOLEAN : anders = hb <> Self.studioWarB OR hh <> Self.studioWarH
        Self.studioWarB = hb
        Self.studioWarH = hh
        IF anders AND NOT erstes THEN Self.Groesse()
    END SUB

    ' Meldet eines der Ereignisse, die das Control festlegt: das Fenster ruft
    ' dann seine Methode <Instanz>_<Ereignis> -- nach dem Takt des Controls,
    ' also auch, wenn es aus einem Ereignis eines Teils kommt.
    SUB Ausloesen(ereignis AS STRING)
        IF ARRAY_INDEXOF(Self.studioMeldungen, ereignis) < 0 THEN ARRAY_PUSH(Self.studioMeldungen, ereignis)
    END SUB

    FUNCTION studioGemeldet(ereignis AS STRING) AS BOOLEAN
        RETURN ARRAY_INDEXOF(Self.studioMeldungen, ereignis) >= 0
    END FUNCTION

    ' Gemeldet? Dann gleich abgeholt: oeffnet die Methode des Fensters ein
    ' modales Fenster, dreht dessen Schleife weiter Bilder -- ein noch
    ' stehendes Ereignis riefe sie dort wieder auf, ohne Ende (gefunden mit
    ' der Kuehlschrank-App).
    FUNCTION studioAbholen(ereignis AS STRING) AS BOOLEAN
        DIM k AS INTEGER : k = ARRAY_INDEXOF(Self.studioMeldungen, ereignis)
        IF k < 0 THEN RETURN FALSE
        ARRAY_REMOVE_AT(Self.studioMeldungen, k)
        RETURN TRUE
    END FUNCTION

    SUB studioMeldungenLeeren()
        Self.studioMeldungen = []
    END SUB

    ' Das Fenster, in dem das Control steht.
    FUNCTION Fenster() AS GUI_WINDOW
        RETURN Self.studioWin
    END FUNCTION

    ' Der Behaelter im Fenster (fuer GUI_GET_X/Y/W/H, GUI_SET_BOUNDS ...).
    FUNCTION Behaelter() AS GUI_WIDGET
        RETURN Self.studioHost
    END FUNCTION

    FUNCTION Breite() AS INTEGER
        RETURN GUI_GET_W(Self.studioHost)
    END FUNCTION

    FUNCTION Hoehe() AS INTEGER
        RETURN GUI_GET_H(Self.studioHost)
    END FUNCTION

    ' Das ganze Control zeigen oder verbergen.
    SUB Sichtbar(an AS BOOLEAN)
        GUI_SET_VISIBLE(Self.studioHost, an)
        DIM w AS GUI_WIDGET
        FOR EACH w IN Self.studioAlle
            GUI_SET_VISIBLE(w, an)
        NEXT
        DIM c AS StudioControl
        FOR EACH c IN Self.studioKinder
            c.Sichtbar(an)
        NEXT
    END SUB
END CLASS

CLASS StudioFenster
    DIM studioWin AS GUI_WINDOW
    ' Die eigenen Controls im Fenster: sie gehen mit dem Fenster zu.
    DIM studioControls AS ARRAY OF StudioControl
    DIM studioOffen AS BOOLEAN
    DIM studioHaupt AS BOOLEAN
    ' Mit ZeigenModal gezeigt: alles andere liegt hinter dem Schleier.
    DIM studioModal AS BOOLEAN
    DIM studioWarB AS INTEGER
    DIM studioWarH AS INTEGER

    ' Die erzeugte Basisklasse baut hier das Fenster.
    SUB studioAufbauen()
    END SUB

    ' Je Bild nach GUI_UPDATE: die Ereignisse des Fensters.
    SUB studioTakt()
    END SUB

    ' Je Bild nach GUI_DRAW: die Zeichenflaechen.
    SUB studioZeichnen()
    END SUB

    ' Nachdem das Fenster aufgebaut ist.
    SUB Geoeffnet()
    END SUB

    ' Wenn das Fenster geschlossen wird (Kreuz oder Zumachen).
    SUB Schliessen()
    END SUB

    ' Wenn sich die Groesse des Fensters geaendert hat.
    SUB Groesse()
    END SUB

    ' In jedem Bild, nach den Ereignissen seiner Controls -- fuer alles, was
    ' das Fenster selbst abfragen will (Kontextmenue, eigene Tasten ...).
    SUB Takt()
    END SUB

    ' Eine Taste, solange das Fenster vorn ist und kein Eingabefeld sie
    ' nimmt -- `taste` ist der Code (KEY_A, KEY_SPACE ...).
    SUB Taste(taste AS INTEGER)
    END SUB

    ' Zeigt das Fenster; beim ersten Mal wird es aufgebaut.
    SUB Zeigen()
        IF Self.studioOffen THEN
            GUI_WINDOW_VISIBLE(Self.studioWin, TRUE)
            GUI_WINDOW_FRONT(Self.studioWin)
            RETURN
        END IF
        Self.studioAufbauen()
        Self.studioOffen = TRUE
        IF Self.studioHaupt THEN
            GUI_WINDOW_CHROME(Self.studioWin, FALSE)
            GUI_WINDOW_SET_BOUNDS(Self.studioWin, 0, 0, SCREENWIDTH(), SCREENHEIGHT())
        ELSE
            DIM b AS INTEGER : b = GUI_WINDOW_GET_W(Self.studioWin)
            DIM h AS INTEGER : h = GUI_WINDOW_GET_H(Self.studioWin)
            GUI_WINDOW_SET_BOUNDS(Self.studioWin, MAX(0, (SCREENWIDTH() - b) \ 2), MAX(0, (SCREENHEIGHT() - h) \ 2), b, h)
            GUI_WINDOW_FRONT(Self.studioWin)
        END IF
        Self.studioWarB = GUI_WINDOW_GET_W(Self.studioWin)
        Self.studioWarH = GUI_WINDOW_GET_H(Self.studioWin)
        studioAnmelden(Self)
        Self.Geoeffnet()
    END SUB

    ' Zeigt das Fenster modal und kehrt erst zurueck, wenn es geschlossen ist.
    ' Solange nimmt kein anderes Fenster Klicks an.
    SUB ZeigenModal()
        Self.Zeigen()
        IF NOT Self.studioOffen THEN RETURN
        GUI_WINDOW_MODAL(Self.studioWin, TRUE)
        Self.studioModal = TRUE
        WHILE Self.studioOffen
            IF NOT studioBild() THEN RETURN
        WEND
    END SUB

    ' Schliesst das Fenster. Das Startfenster zu schliessen beendet das Programm.
    SUB Zumachen()
        IF NOT Self.studioOffen THEN RETURN
        Self.Schliessen()
        Self.studioOffen = FALSE
        DIM c AS StudioControl
        FOR EACH c IN Self.studioControls
            c.studioSchliessen()
        NEXT
        GUI_WINDOW_DESTROY(Self.studioWin)
        IF Self.studioHaupt THEN studioBeenden()
    END SUB

    ' Das Fenster der gui, fuer alles, was die Klasse nicht selbst anbietet.
    FUNCTION Fenster() AS GUI_WINDOW
        RETURN Self.studioWin
    END FUNCTION
END CLASS

DIM studioFenster AS ARRAY OF StudioFenster : studioFenster = []
DIM studioEnde AS BOOLEAN : studioEnde = FALSE
DIM studioDieStartseite AS StudioFenster
DIM studioDialoge AS ARRAY OF GUI_WINDOW : studioDialoge = []
DIM studioSchirmB AS INTEGER : studioSchirmB = 0
DIM studioSchirmH AS INTEGER : studioSchirmH = 0
' Der Tastaturfokus im vorigen und in diesem Bild -- daraus werden
' FokusRein und FokusRaus.
DIM studioFokusAlt AS INTEGER : studioFokusAlt = -1
DIM studioFokusJetzt AS INTEGER : studioFokusJetzt = -1
DIM studioTaste AS INTEGER : studioTaste = -1
' Das wievielte Bild gerade laeuft, und welches seine Eingabe an die
' Ereignisse verteilt. Ruft ein Ereignis selbst studioBild (ZeigenModal,
' Frage ...), wird erst dieses Bild fertig gezeichnet: sonst saehe die innere
' Schleife denselben Mausklick noch einmal (MOUSE_HIT gilt bis FLIP) und
' oeffnete den Dialog wieder und wieder.
DIM studioBildNr AS INTEGER : studioBildNr = 0
DIM studioVerteiltNr AS INTEGER : studioVerteiltNr = -1

' Darf ein Fenster gerade rohe Maus-Eingaben nehmen (Zeichenflaechen)?
' GUI_HIT_TEST sieht durch den Schleier eines modalen Fensters hindurch.
FUNCTION studioFrei(w AS GUI_WINDOW) AS BOOLEAN
    IF NOT GUI_MODAL() THEN RETURN TRUE
    IF LEN(studioDialoge) > 0 THEN RETURN FALSE
    DIM oben AS StudioFenster
    DIM f AS StudioFenster
    FOR EACH f IN studioFenster
        IF f.studioOffen AND f.studioModal THEN oben = f
    NEXT
    IF oben IS NIL THEN RETURN FALSE
    RETURN oben.studioWin = w
END FUNCTION

SUB studioAnmelden(f AS StudioFenster)
    ARRAY_PUSH(studioFenster, f)
END SUB

' Beendet das Programm nach dem laufenden Bild.
SUB studioBeenden()
    studioEnde = TRUE
END SUB

' Ein Bild: Eingaben, Ereignisse aller Fenster, Zeichnen. FALSE, wenn das
' Programm endet -- dann soll jede Schleife, die Bilder dreht, aufhoeren.
FUNCTION studioBild() AS BOOLEAN
    IF studioEnde THEN RETURN FALSE
    IF studioVerteiltNr = studioBildNr THEN studioMalen()
    IF WINDOW_CLOSE_REQUESTED() THEN
        studioDieStartseite.Zumachen()
        studioEnde = TRUE
        RETURN FALSE
    END IF
    IF QUITREQUESTED() THEN
        studioEnde = TRUE
        RETURN FALSE
    END IF
    IF SCREENWIDTH() <> studioSchirmB OR SCREENHEIGHT() <> studioSchirmH THEN
        studioSchirmB = SCREENWIDTH() : studioSchirmH = SCREENHEIGHT()
        IF studioDieStartseite.studioOffen THEN GUI_WINDOW_SET_BOUNDS(studioDieStartseite.studioWin, 0, 0, studioSchirmB, studioSchirmH)
    END IF
    GUI_UPDATE()
    studioVerteiltNr = studioBildNr
    studioFokusAlt = studioFokusJetzt
    studioFokusJetzt = GUI_FOCUSED()
    studioTaste = KEY_ANY_HIT()
    ' Eine Kopie der Liste: ein Ereignis kann Fenster oeffnen und schliessen.
    DIM jetzt AS ARRAY OF StudioFenster : jetzt = ARRAY_COPY(studioFenster)
    DIM f AS StudioFenster
    FOR EACH f IN jetzt
        IF studioEnde THEN BREAK
        IF NOT f.studioOffen THEN CONTINUE
        IF GUI_WINDOW_CLOSED(f.studioWin) THEN
            f.Zumachen()
            CONTINUE
        END IF
        f.studioTakt()
        IF f.studioOffen AND NOT studioEnde THEN f.Takt()
        IF f.studioOffen THEN
            IF GUI_WINDOW_GET_W(f.studioWin) <> f.studioWarB OR GUI_WINDOW_GET_H(f.studioWin) <> f.studioWarH THEN
                f.studioWarB = GUI_WINDOW_GET_W(f.studioWin)
                f.studioWarH = GUI_WINDOW_GET_H(f.studioWin)
                f.Groesse()
            END IF
        END IF
    NEXT
    ' Eine Taste gehoert dem obersten Fenster -- ausser ein Eingabefeld hat
    ' den Fokus, dann tippt man dort.
    IF studioTaste >= 0 AND NOT studioEnde THEN
        DIM feld AS BOOLEAN : feld = FALSE
        IF studioFokusJetzt >= 0 THEN
            DIM art AS STRING : art = GUI_KIND(studioFokusJetzt)
            feld = art = "textinput" OR art = "textarea" OR art = "spinner" OR art = "dropdown"
        END IF
        IF NOT feld THEN
            DIM oben AS StudioFenster
            FOR EACH f IN studioFenster
                IF f.studioOffen THEN oben = f
            NEXT
            ' Ein modales Fenster bekommt seine Tasten (ESC zum Schliessen);
            ' hinter einem Dialog oder Schleier niemand.
            IF oben IS NOT NIL THEN
                IF studioFrei(oben.studioWin) THEN oben.Taste(studioTaste)
            END IF
        END IF
    END IF
    ' Geschlossene Fenster aus der Liste nehmen.
    DIM noch AS ARRAY OF StudioFenster : noch = []
    FOR EACH f IN studioFenster
        IF f.studioOffen THEN ARRAY_PUSH(noch, f)
    NEXT
    studioFenster = noch
    IF studioEnde THEN RETURN FALSE
    studioMalen()
    RETURN TRUE
END FUNCTION

' Das Bild zeichnen und zeigen; danach gilt die naechste Eingabe.
SUB studioMalen()
    DIM f AS StudioFenster
    CLS(0)
    GUI_DRAW(FALSE)
    FOR EACH f IN studioFenster
        f.studioZeichnen()
    NEXT
    FOR EACH f IN studioFenster
        IF NOT f.studioHaupt THEN GUI_DRAW_WINDOW(f.studioWin)
    NEXT
    DIM d AS GUI_WINDOW
    FOR EACH d IN studioDialoge
        GUI_DRAW_WINDOW(d)
    NEXT
    GUI_DRAW_TOP()
    FLIP()
    studioBildNr = studioBildNr + 1
END SUB

' Der Einstieg: oeffnet das Programmfenster in der Groesse des Startfensters,
' laesst die App beginnen, zeigt das Startfenster und dreht die Bildschleife.
SUB studioLauf(app AS StudioApp, start AS StudioFenster, b AS INTEGER, h AS INTEGER, titel AS STRING, veraenderbar AS BOOLEAN)
    SCREEN(b, h, titel)
    IF veraenderbar THEN WINDOW_RESIZABLE(TRUE)
    SETFPS(60)
    studioSchirmB = SCREENWIDTH() : studioSchirmH = SCREENHEIGHT()
    studioDieStartseite = start
    app.Geoeffnet()
    start.studioHaupt = TRUE
    start.Zeigen()
    WHILE studioBild()
    WEND
    app.Beenden()
END SUB

' --- Dialoge, die warten ------------------------------------------------

' Wartet auf die Antwort eines Dialogs der gui (0 = Programm endet).
FUNCTION studioAntwort(d AS GUI_WINDOW) AS INTEGER
    ARRAY_PUSH(studioDialoge, d)
    DIM a AS INTEGER : a = 0
    WHILE a = 0
        IF NOT studioBild() THEN BREAK
        a = GUI_ANSWER(d)
    WEND
    DIM rest AS ARRAY OF GUI_WINDOW : rest = []
    DIM x AS GUI_WINDOW
    FOR EACH x IN studioDialoge
        IF NOT (x = d) THEN ARRAY_PUSH(rest, x)
    NEXT
    studioDialoge = rest
    RETURN a
END FUNCTION

' Eine Meldung mit OK.
SUB Meldung(text AS STRING, titel AS STRING = "")
    studioAntwort(GUI_DIALOG(titel, text, "ok"))
END SUB

' Eine Frage; die Antwort ist die Nummer des Knopfs (1 = der erste).
' Knoepfe mit | getrennt, Enter = der erste, ESC = der letzte.
FUNCTION Frage(text AS STRING, knoepfe AS STRING = "Ja|Nein", titel AS STRING = "") AS INTEGER
    RETURN studioAntwort(GUI_DIALOG(titel, text, knoepfe))
END FUNCTION

' Fragt nach einem Text; "" bei Abbrechen.
FUNCTION Eingabe(text AS STRING, vorgabe AS STRING = "", titel AS STRING = "") AS STRING
    DIM d AS GUI_WINDOW : d = GUI_PROMPT(titel, text, vorgabe)
    IF studioAntwort(d) <> 1 THEN RETURN ""
    RETURN GUI_DIALOG_TEXT(d)
END FUNCTION

' Ein kleines Fenster mit Text, einem Feld und OK/Abbrechen (Enter/ESC),
' modal und mittig -- fuer Auswahl und EingabeZahl. Liefert TRUE bei OK.
' Wie Frage() dreht es selbst Bilder, bis eine Antwort da ist.
' Den Fokus bekommt feld, wenn es einen soll (ein Zahlenfeld zum Tippen);
' eine Klappliste nicht -- dort oeffnet Enter die Liste, statt OK zu druecken.
FUNCTION studioFeldDialog(w AS GUI_WINDOW, feld AS GUI_WIDGET, ok AS GUI_WIDGET, ab AS GUI_WIDGET) AS BOOLEAN
    GUI_WINDOW_DEFAULT(w, ok)
    GUI_WINDOW_CANCEL(w, ab)
    GUI_WINDOW_MODAL(w, TRUE)
    IF feld >= 0 THEN GUI_FOCUS(feld)
    ARRAY_PUSH(studioDialoge, w)
    DIM ja AS BOOLEAN : ja = FALSE
    WHILE studioBild()
        IF GUI_CLICKED(ok) THEN
            ja = TRUE
            BREAK
        END IF
        IF GUI_CLICKED(ab) OR GUI_WINDOW_CLOSED(w) THEN BREAK
    WEND
    DIM rest AS ARRAY OF GUI_WINDOW : rest = []
    DIM x AS GUI_WINDOW
    FOR EACH x IN studioDialoge
        IF NOT (x = w) THEN ARRAY_PUSH(rest, x)
    NEXT
    studioDialoge = rest
    RETURN ja
END FUNCTION

FUNCTION studioKleinesFenster(titel AS STRING, text AS STRING) AS GUI_WINDOW
    DIM b AS INTEGER : b = 380
    DIM w AS GUI_WINDOW : w = GUI_WINDOW(titel, MAX(0, (SCREENWIDTH() - b) \ 2), MAX(0, (SCREENHEIGHT() - 150) \ 2), b, 150)
    GUI_LABEL(w, text, 14, 12)
    RETURN w
END FUNCTION

' Einer aus einer Liste (wie QInputDialog.getItem): der Index des gewaehlten
' Eintrags, -1 bei Abbrechen.
FUNCTION Auswahl(text AS STRING, eintraege AS ARRAY OF STRING, vorgabe AS INTEGER = 0, titel AS STRING = "") AS INTEGER
    DIM w AS GUI_WINDOW : w = studioKleinesFenster(titel, text)
    DIM feld AS GUI_WIDGET : feld = GUI_DROPDOWN(w, 14, 40, 352, 30, eintraege)
    IF LEN(eintraege) > 0 THEN GUI_DROPDOWN_SET_SELECTED(feld, MAX(0, MIN(vorgabe, LEN(eintraege) - 1)))
    DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(w, "OK", 166, 84, 96, 30)
    DIM ab AS GUI_WIDGET : ab = GUI_BUTTON(w, "Abbrechen", 270, 84, 96, 30)
    DIM i AS INTEGER : i = -1
    IF studioFeldDialog(w, -1, ok, ab) AND LEN(eintraege) > 0 THEN i = GUI_DROPDOWN_SELECTED(feld)
    GUI_WINDOW_DESTROY(w)
    RETURN i
END FUNCTION

' Eine ganze Zahl zwischen min und max (wie QInputDialog.getInt):
' (TRUE, zahl) bei OK, (FALSE, vorgabe) bei Abbrechen.
FUNCTION EingabeZahl(text AS STRING, vorgabe AS INTEGER, min AS INTEGER, max AS INTEGER, titel AS STRING = "") AS TUPLE
    DIM w AS GUI_WINDOW : w = studioKleinesFenster(titel, text)
    DIM feld AS GUI_WIDGET : feld = GUI_SPINNER(w, 14, 40, 160, min, max, vorgabe, 1)
    DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(w, "OK", 166, 84, 96, 30)
    DIM ab AS GUI_WIDGET : ab = GUI_BUTTON(w, "Abbrechen", 270, 84, 96, 30)
    DIM ja AS BOOLEAN : ja = studioFeldDialog(w, feld, ok, ab)
    DIM z AS INTEGER : z = INT(GUI_VALUE(feld))
    GUI_WINDOW_DESTROY(w)
    IF NOT ja THEN RETURN (FALSE, vorgabe)
    RETURN (TRUE, MAX(min, MIN(max, z)))
END FUNCTION

' Die Vorschau eines Berichts (studio_berichte.dh): ein Fenster mit der
' Seite, Blaettern, Drucken, Sichern und Schliessen. Kehrt zurueck, wenn es
' zu ist -- wie Frage() dreht sie dafuer selbst Bilder.
SUB studioBerichtVorschau(p AS PDF, titel AS STRING)
    DIM w AS GUI_WINDOW : w = GUI_WINDOW(titel, 40, 30, 640, MIN(860, SCREENHEIGHT() - 60))
    DIM zurueck AS GUI_WIDGET : zurueck = GUI_BUTTON(w, "<", 10, 8, 40, 26)
    DIM seite AS GUI_WIDGET : seite = GUI_LABEL(w, "", 58, 12)
    DIM weiter AS GUI_WIDGET : weiter = GUI_BUTTON(w, ">", 150, 8, 40, 26)
    DIM drucken AS GUI_WIDGET : drucken = GUI_BUTTON(w, "Drucken", 300, 8, 100, 26)
    DIM sichern AS GUI_WIDGET : sichern = GUI_BUTTON(w, "Als PDF …", 406, 8, 110, 26)
    DIM zu AS GUI_WIDGET : zu = GUI_BUTTON(w, "Schließen", 522, 8, 106, 26)
    DIM bild AS GUI_WIDGET : bild = GUI_IMAGE(w, 10, 42, 620, GUI_WINDOW_GET_H(w) - 82, -1)
    GUI_IMAGE_MODE(bild, "einpassen")
    GUI_WINDOW_MODAL(w, TRUE)
    GUI_FOCUS(zu)
    ARRAY_PUSH(studioDialoge, w)
    DIM nr AS INTEGER : nr = 1
    DIM handle AS IMAGE : handle = -1
    DIM neu AS BOOLEAN : neu = TRUE
    WHILE TRUE
        IF neu THEN
            IF handle >= 0 THEN IMAGE_FREE(handle)
            handle = PDF_PREVIEW(p, nr, 620)
            GUI_SET_IMAGE(bild, handle)
            GUI_SET_TEXT(seite, STR$(nr) + " / " + STR$(PDF_PAGE_COUNT(p)))
            neu = FALSE
        END IF
        IF NOT studioBild() THEN BREAK
        IF GUI_CLICKED(zu) OR GUI_WINDOW_CLOSED(w) THEN BREAK
        IF GUI_CLICKED(weiter) AND nr < PDF_PAGE_COUNT(p) THEN nr = nr + 1 : neu = TRUE
        IF GUI_CLICKED(zurueck) AND nr > 1 THEN nr = nr - 1 : neu = TRUE
        IF GUI_CLICKED(drucken) THEN PDF_PRINT(p)
        IF GUI_CLICKED(sichern) THEN
            DIM ziel AS STRING : ziel = FILE_SAVE_DIALOG("PDF sichern", "pdf")
            IF ziel <> "" THEN PDF_SAVE(p, ziel)
        END IF
    WEND
    DIM rest AS ARRAY OF GUI_WINDOW : rest = []
    DIM x AS GUI_WINDOW
    FOR EACH x IN studioDialoge
        IF NOT (x = w) THEN ARRAY_PUSH(rest, x)
    NEXT
    studioDialoge = rest
    GUI_WINDOW_DESTROY(w)
    IF handle >= 0 THEN IMAGE_FREE(handle)
    PDF_CLOSE(p)
END SUB

' Ein Bild aus dem Ordner bilder/ des Projekts (beim Starten und in der
' gebauten Fassung unter assets/bilder/).
FUNCTION Bild(name AS STRING) AS IMAGE
    RETURN LOADIMAGE(studioDatei$("bilder/" + name))
END FUNCTION

FUNCTION studioDatei$(rel AS STRING) AS STRING
    RETURN "assets/" + rel
END FUNCTION
