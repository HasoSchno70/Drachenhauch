' Vorgaben beim Erfassen: Lagerort, Haltbarkeit in Tagen und Kategorie aus
' Stichwörtern im Namen (sonst in den Kategorien von Open Food Facts) --
' die Listen von services/smart_defaults.py der Python-App, wörtlich. Dazu,
' was sich die App gemerkt hat (user_learning wie services/learning_service):
' das zuletzt am häufigsten Gewählte geht jeder Liste vor.
'
' Die Python-App nahm das erste Stichwort ihrer Liste, das irgendwo im Namen
' steckt: "Reis" kam in den Gefrierschrank ("eis"), "Rindersteak" hielt 180
' Tage im Vorratsraum ("tea"), "Pfefferminztee" war ein Gewürz ("pfeffer").
' Hier zählt, wo es im Wort steht: am Ende (das Grundwort, "Speise-eis",
' "Pfefferminz-tee") vor dem Anfang vor der Mitte; ein Stichwort unter vier
' Buchstaben gilt nicht mitten im Wort ("Kölsch" ist kein Öl). Gleich gut:
' das frühere Wort, dann das längere Stichwort ("Reis" vor "eis").
IMPORT "db"

' Der Wert zum besten Stichwort in text ("" = keins). Stichwörter mit
' Zeichen, die keine Buchstaben sind ("tk-", "ice cream", "crème fraîche"),
' gelten als Teil des ganzen Textes.
FUNCTION stichwort$(text AS STRING, liste AS ARRAY OF STRING) AS STRING
    DIM t AS STRING : t = LOWER$(text)
    DIM w AS ARRAY OF STRING : w = woerter(text)
    DIM wert AS STRING : wert = ""
    DIM rang AS INTEGER : rang = 0
    DIM wort AS INTEGER : wort = 0
    DIM laenge AS INTEGER : laenge = 0
    DIM e AS STRING
    FOR EACH e IN liste
        DIM p AS INTEGER : p = INSTR(e, "|")
        DIM k AS STRING : k = LEFT$(e, p)
        DIM r AS INTEGER : r = 0
        DIM wi AS INTEGER : wi = 0
        IF REGEX_TEST(k, "[^\p{L}\p{N}]") THEN
            IF INSTR(t, k) >= 0 THEN r = 2
        ELSE
            DIM i AS INTEGER
            FOR i = 0 TO LEN(w) - 1
                DIM x AS STRING : x = w[i]
                DIM ri AS INTEGER : ri = 0
                IF RIGHT$(x, LEN(k)) = k THEN
                    ri = 3
                ELSEIF LEFT$(x, LEN(k)) = k THEN
                    ri = 2
                ELSEIF LEN(k) >= 4 AND INSTR(x, k) >= 0 THEN
                    ri = 1
                END IF
                IF ri > r THEN
                    r = ri
                    wi = i
                END IF
            NEXT
        END IF
        IF r = 0 THEN CONTINUE
        DIM besser AS BOOLEAN : besser = r > rang
        IF r = rang THEN besser = wi < wort OR (wi = wort AND LEN(k) > laenge)
        IF besser THEN
            wert = MID$(e, p + 1, LEN(e))
            rang = r : wort = wi : laenge = LEN(k)
        END IF
    NEXT
    RETURN wert
END FUNCTION

' Erst der Name, dann die Kategorien von Open Food Facts (durch Komma).
FUNCTION stichwortIn$(name AS STRING, kategorien AS STRING, liste AS ARRAY OF STRING) AS STRING
    DIM v AS STRING : v = stichwort$(name, liste)
    IF v <> "" OR kategorien = "" THEN RETURN v
    DIM teil AS STRING
    FOR EACH teil IN SPLIT(kategorien, ",")
        v = stichwort$(TRIM$(teil), liste)
        IF v <> "" THEN RETURN v
    NEXT
    RETURN ""
END FUNCTION

' Der Lagerort-Vorschlag ("" = keiner) und die Tage bis zum Ablauf (sonst 7).
FUNCTION vorschlagOrt$(name AS STRING, kategorien AS STRING) AS STRING
    RETURN stichwortIn$(name, kategorien, lagerStichwoerter())
END FUNCTION

FUNCTION vorschlagTage(name AS STRING, kategorien AS STRING) AS INTEGER
    DIM v AS STRING : v = stichwortIn$(name, kategorien, tageStichwoerter())
    IF v = "" THEN RETURN 7
    RETURN INT(VAL(v))
END FUNCTION

FUNCTION vorschlagKategorie$(name AS STRING) AS STRING
    RETURN stichwort$(name, kategorieStichwoerter())
END FUNCTION

' Ein Vorschlag unter den Lagerorten, die es gibt: gleich, gleich bis auf
' Groß/klein, der eine im anderen (wie die Python-App) -- sonst der erste.
FUNCTION passenderOrt$(vorschlag AS STRING, orte AS ARRAY OF STRING) AS STRING
    IF LEN(orte) = 0 THEN RETURN IIF(vorschlag = "", "Kühlschrank", vorschlag)
    IF vorschlag = "" THEN RETURN orte[0]
    DIM o AS STRING
    FOR EACH o IN orte
        IF LOWER$(o) = LOWER$(vorschlag) THEN RETURN o
    NEXT
    FOR EACH o IN orte
        IF INSTR(LOWER$(o), LOWER$(vorschlag)) >= 0 OR INSTR(LOWER$(vorschlag), LOWER$(o)) >= 0 THEN RETURN o
    NEXT
    RETURN orte[0]
END FUNCTION

' --- Lernen ------------------------------------------------------------------
' Was der Nutzer gewählt hat, je Barcode (sonst Name) und Feld
' ("storage_location", "expiry_days"): get_learned_default -- das am
' häufigsten Gewählte, bei Gleichstand das zuletzt Gewählte; "" = nichts.
FUNCTION gelernt$(barcode AS STRING, name AS STRING, feld AS STRING) AS STRING
    DIM r AS DB_RESULT
    IF barcode <> "" THEN
        r = DB_QUERY(db, "SELECT value FROM user_learning WHERE barcode = ? AND field = ? AND confidence >= 0.1 ORDER BY choice_count DESC, last_used DESC, id DESC LIMIT 1", barcode, feld)
        IF DB_NEXT(r) THEN
            DIM v AS STRING : v = DB_GET_STRING(r, 0)
            DB_CLOSE_RESULT(r)
            RETURN v
        END IF
    END IF
    r = DB_QUERY(db, "SELECT value FROM user_learning WHERE product_name = ? AND field = ? AND confidence >= 0.1 ORDER BY choice_count DESC, last_used DESC, id DESC LIMIT 1", name, feld)
    IF DB_NEXT(r) THEN
        DIM w AS STRING : w = DB_GET_STRING(r, 0)
        DB_CLOSE_RESULT(r)
        RETURN w
    END IF
    RETURN ""
END FUNCTION

' record_user_choice: dieselbe Wahl noch einmal zählt hoch (Vertrauen
' Anzahl / 10, höchstens 1), eine neue fängt mit 0,1 an. Teil des Schritts,
' in dem gewählt wurde (verlauf).
SUB lernen(barcode AS STRING, name AS STRING, feld AS STRING, wert AS STRING)
    DIM id AS INTEGER : id = 0
    DIM n AS INTEGER : n = 0
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT id, choice_count FROM user_learning WHERE IFNULL(barcode, '') = ? AND field = ? AND value = ? ORDER BY id LIMIT 1", barcode, feld, wert)
    IF DB_NEXT(r) THEN
        id = DB_GET_INT(r, 0)
        n = DB_GET_INT(r, 1)
        DB_CLOSE_RESULT(r)
    END IF
    IF id > 0 THEN
        verlauf.merken("user_learning", id)
        DB_EXEC(db, "UPDATE user_learning SET choice_count = ?, confidence = ?, last_used = CURRENT_TIMESTAMP WHERE id = ?", n + 1, MIN(1.0, (n + 1) / 10.0), id)
    ELSE
        DB_EXEC(db, "INSERT INTO user_learning (barcode, product_name, field, value, choice_count, confidence) VALUES (?, ?, ?, ?, 1, 0.1)", IIF(barcode = "", NIL, barcode), name, feld, wert)
        verlauf.neu("user_learning", DB_LAST_ROWID(db))
    END IF
END SUB

