DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(w, 20, 20, 300, 34)
GUI_TOOLBAR_ADD(tb, "neu")
GUI_TOOLBAR_ADD(tb, "oeffnen")
DIM treffer AS INTEGER : treffer = 0
DIM f AS INTEGER
FOR f = 1 TO 20
    GUI_UPDATE()
    IF GUI_TOOLBAR_CLICKED(tb) >= 0 THEN treffer = treffer + 1
    GUI_DRAW()
    FLIP()
NEXT
PRINT treffer
