' 169_csv.dh -- CSV lesen und schreiben (WP J)
'
' Der Grund fuer diese Builtins steht in Zeile 12: ein Feld, das das
' Trennzeichen enthaelt. SPLIT$(";") liefert dort vier Felder statt drei --
' und meldet es nicht, sondern rechnet stillschweigend falsch weiter.

DIM tabelle AS ARRAY OF STRING
DIM zurueck AS ARRAY OF STRING
DIM kopf AS ARRAY OF STRING
DIM r AS INTEGER
DIM c AS INTEGER
DIM zeile AS STRING
DIM quelle AS STRING

quelle = "Name;Ort;Punkte" + CHR$(10)
quelle = quelle + "Mueller;" + CHR$(34) + "Berlin; Mitte" + CHR$(34) + ";42" + CHR$(10)
quelle = quelle + "Schmidt;Hamburg;17" + CHR$(10)

tabelle = CSV_PARSE(quelle, ";")

PRINT "Zeilen: " + STR$(DIMSIZE(tabelle, 0)) + ", Spalten: " + STR$(DIMSIZE(tabelle, 1))
PRINT ""

FOR r = 0 TO DIMSIZE(tabelle, 0) - 1
    zeile = ""
    FOR c = 0 TO DIMSIZE(tabelle, 1) - 1
        zeile = zeile + PADR$(tabelle[r, c], 16)
    NEXT
    PRINT zeile
NEXT

PRINT ""
PRINT "Das Semikolon im Ort ist erhalten: [" + tabelle[1, 1] + "]"
PRINT ""

' --- Schreiben: Anfuehrungszeichen setzt CSV_ROW$ nur, wo noetig ---
kopf = SPLIT$("Name|Ort|Notiz mit ; drin", "|")
PRINT "Eine Zeile: " + CSV_ROW$(kopf, ";")
PRINT ""

' --- Rundreise ueber eine Datei ---
CSV_SAVE("csv_beispiel.csv", tabelle, ";")
zurueck = CSV_LOAD("csv_beispiel.csv", ";")
PRINT "Nach dem Speichern und Laden wieder da: [" + zurueck[1, 1] + "]"
DELETEFILE("csv_beispiel.csv")

PRINT ""
PRINT "Ohne zweites Argument ist das Trennzeichen ein Komma."

' --- Eine Datei, die NICHT UTF-8 ist (der Excel-Fall) --------------------
'
' Excel schreibt auf einem deutschen Windows beim Export als "CSV
' (Trennzeichen-getrennt)" die alte Windows-Kodierung cp1252. Sobald ein
' Umlaut darin vorkommt, ist die Datei kein gueltiges UTF-8 -- ohne Angabe
' bricht das Lesen ab, und die Meldung sagt genau das, samt Ausweg.
'
' Die Beispiele in diesem Verzeichnis kommen ohne Umlaute im Quelltext aus;
' das "ue" bauen wir deshalb ueber seine Nummer: CHR$(252) ist "ue".
DIM ue AS STRING
ue = CHR$(252)

DIM alt AS ARRAY OF STRING
alt = CSV_PARSE("Name;Ort" + CHR$(10) + "M" + ue + "ller;Koeln", ";")
CSV_SAVE("alt_windows.csv", alt, ";", "cp1252")
PRINT ""
PRINT "Geschrieben als cp1252: " + STR$(FILESIZE("alt_windows.csv")) + " Bytes"

DIM gelesen AS ARRAY OF STRING
gelesen = CSV_LOAD("alt_windows.csv", ";", "cp1252")
PRINT "Wieder gelesen: " + gelesen[1, 0] + " aus " + gelesen[1, 1]

' Ohne die Angabe ist es ein Fehler -- mit einer Meldung, die den Weg zeigt.
TRY
    DIM ohne AS ARRAY OF STRING
    ohne = CSV_LOAD("alt_windows.csv", ";")
CATCH meldung
    PRINT "Ohne Kodierungsangabe:"
    PRINT "  " + meldung
END TRY
DELETEFILE("alt_windows.csv")
