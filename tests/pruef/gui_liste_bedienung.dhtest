=== das umbenennen steht in der dhform
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
DIM lb AS GUI_WIDGET : lb = GUI_LISTBOX(w, 10, 10, 280, 200, ["a"])
GUI_LISTBOX_SET(lb, "bearbeitbar", 1)
DIM j AS STRING : j = GUI_TO_JSON(w)
PRINT INSTR(j, CHR$(34) + "bearbeitbar" + CHR$(34)) >= 0
GUI_WINDOW_DESTROY(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT INSTR(GUI_TO_JSON(w2), CHR$(34) + "bearbeitbar" + CHR$(34)) >= 0
--- erwartet
TRUE
TRUE

=== ein menue rollt herab
' Menue "Datei" in der Leiste (y 0..25), das Popup beginnt bei y 26; der
' vierte Eintrag liegt bei y 100..123 (geprobt oben rechts, neben dem Text). Kurz nach dem Klick ist dort noch
' Fenstergrund, nach der Dauer die Farbe des Popups.
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
GUI_THEME_SET("widget_bg", &H0000FF)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
GUI_MENU_ITEM(m, "Neu") : GUI_MENU_ITEM(m, "Oeffnen") : GUI_MENU_ITEM(m, "Sichern") : GUI_MENU_ITEM(m, "Ende")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
