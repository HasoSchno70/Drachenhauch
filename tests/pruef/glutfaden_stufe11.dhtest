gleich (640 Zeilen)

=== bibliothek: alles wie pysticky -- einsortieren, eintraege, vorschaubilder, library.json
IMPORT "helfer.dh"
DIM t AS STRING : t = bibliothekText$(CWD$(), ["probe.pxs", "gross_250x40.pxs", "gross_60x45.pxs", "gross_99x96.pxs"], "library_alt.json")
PRINT geAbweichungen$(geLies$("ref.txt"), t)
DIM b AS kern.Bibliothek : b = kern.bibliothekLaden("library_alt.json")
PRINT "library.json wie pysticky: "; kern.bibliothekJson$(b) = geLies$("ref_library_neu.json")
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_harmonie.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bibliothek.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- datei probe.pxs
