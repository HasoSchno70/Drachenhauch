        {
          "name": "storage.type.drachenhauch",
          "match": "(?i)\\b(COROUTINE|BOOLEAN|FUNCREF|INTEGER|STRING|ARRAY|FLOAT|IMAGE|SOUND|TUPLE|FILE|MAP|OF)\\b"
