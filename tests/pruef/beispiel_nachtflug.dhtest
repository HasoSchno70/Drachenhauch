=== der szenenwechsel geht durch licht
' kurz vor Takt 16 fuellt das Licht des Wechsels das Bild -- ohne den
' Uebergang waere es dort so dunkel wie der Ozean (Mittel um 30)
--- programm ../../examples/nachtflug/main.dh
--- ersetzen IMPORT "musik.dh"
IMPORT "{sammlung}/../../examples/nachtflug/musik.dh"
--- ersetzen     DIM h AS INTEGER : h = SHADER_LOAD("assets/shader/" + name + ".fs")
    DIM h AS INTEGER : h = SHADER_LOAD("{sammlung}/../../examples/nachtflug/assets/shader/" + name + ".fs")
--- argumente
--fenster
--ab
15
--- umgebung
DHRT_FRAMES=80
DHRT_SCREENSHOT={fall}/bild.png
DH_OHNE_AUDIO=1
--- nachher
DIM b AS INTEGER : b = LOADIMAGE("bild.png")
DIM s AS FLOAT
DIM x AS INTEGER
DIM y AS INTEGER
FOR x = 0 TO 31
    FOR y = 0 TO 17
        DIM f AS INTEGER : f = GETPIXEL(b, 20 + x * 40, 20 + y * 40)
        s = s + ((f SHR 16) BAND 255) + ((f SHR 8) BAND 255) + (f BAND 255)
    NEXT
NEXT
PRINT "hell "; s / (32 * 18 * 3) > 120
--- erwartet
hell TRUE

=== die bilder folgen der melodie
' die Huellkurve des Melodietons: 1 auf dem Anschlag (Takt 32, das E),
' dann abklingend, 0.3 solange gehalten, 0 in einer Pause und in Takten
' ohne Melodie; tonHoehe sagt, wie hoch der Ton liegt
IMPORT "musik_hier.dh"
PRINT FORMAT$(tonBei(512), "%.2f"); " "; FORMAT$(tonHoehe, "%.2f")
PRINT FORMAT$(tonBei(514), "%.2f")
PRINT FORMAT$(tonBei(517.5), "%.2f")
PRINT FORMAT$(tonBei(518), "%.2f"); " "; FORMAT$(tonHoehe, "%.2f")
PRINT FORMAT$(tonBei(320), "%.2f")
PRINT FORMAT$(tonBei(32 * 16 + 15 * 16 + 12), "%.2f")
PRINT melodieAktiv(10); " "; melodieAktiv(20); " "; melodieAktiv(50); " "; melodieAktiv(81)
' im Wiedereintritt das Morgen-Motiv: es beginnt auf dem C (72)
PRINT FORMAT$(tonBei(96 * 16), "%.2f"); " "; FORMAT$(tonHoehe, "%.2f")
--- datei musik_hier.dh
IMPORT "{sammlung}/../../examples/nachtflug/musik.dh"
--- erwartet
1.00 0.50
0.41
0.30
1.00 0.36
0.00
0.00
TRUE FALSE TRUE TRUE
1.00 0.21

=== der mitschnitt ist stereo
' nur mit Soundkarte: der Mitschnitt nimmt den Mischer auf
--- programm ../../examples/nachtflug/main.dh
--- ersetzen IMPORT "musik.dh"
IMPORT "{sammlung}/../../examples/nachtflug/musik.dh"
--- ersetzen     DIM h AS INTEGER : h = SHADER_LOAD("assets/shader/" + name + ".fs")
    DIM h AS INTEGER : h = SHADER_LOAD("{sammlung}/../../examples/nachtflug/assets/shader/" + name + ".fs")
--- argumente
--fenster
--ab
90
--mitschnitt
{fall}/mit.wav
--- nachher
IF NOT FILEEXISTS("mit.wav") THEN
    PRINT "UEBERSPRINGEN: kein Ton, kein Mitschnitt"
    END
END IF
DIM w AS BUFFER : w = READALL_BYTES("mit.wav")
PRINT "RIFF "; BUFFER_GET(w, 0) = 82 AND BUFFER_GET(w, 8) = 87
PRINT "kanaele "; BUFFER_GET_U16(w, 22)
PRINT "laenger als 4 s "; BUFFER_LEN(w) > BUFFER_GET_U32(w, 28) * 4
--- erwartet
RIFF TRUE
kanaele 2
laenger als 4 s TRUE

=== die rueckung hebt das finale um einen ganzton
' ab Takt 72 meinen die Akkordnummern 8..15 dieselben Akkorde zwei Halbtoene
' hoeher; die Melodie folgt ueber versatzBei
IMPORT "musik_hier.dh"
PRINT akkordNr(70); " "; akkordNr(72); " "; akkordNr(79)
PRINT akkTon(0, 0); " "; akkTon(8, 0); " "; grundTon(0); " "; grundTon(8)
PRINT versatzBei(71); " "; versatzBei(72); " "; versatzBei(90)
' danach der Morgen in C-Dur (16..23), ueber den Wolken wieder die Nacht
PRINT akkordNr(80); " "; akkordNr(111); " "; akkordNr(112); " "; akkTon(16, 0); " "; grundTon(16); " "; grundTon(23)
--- datei musik_hier.dh
IMPORT "{sammlung}/../../examples/nachtflug/musik.dh"
--- erwartet
3 12 15
57 59 33 35
0 2 0
16 23 0 60 36 31

=== der lichterschwarm schreibt im abspann
' kurz vor dem Ende steht der Schriftzug aus Funken ueber dem Wasser: im
' Streifen y 520..600 viele helle, warme Punkte (ohne Schwarm liegt dort
' dunkles Wasser)
--- programm ../../examples/nachtflug/main.dh
--- ersetzen IMPORT "musik.dh"
IMPORT "{sammlung}/../../examples/nachtflug/musik.dh"
--- ersetzen     DIM h AS INTEGER : h = SHADER_LOAD("assets/shader/" + name + ".fs")
    DIM h AS INTEGER : h = SHADER_LOAD("{sammlung}/../../examples/nachtflug/assets/shader/" + name + ".fs")
--- argumente
--fenster
--ab
145
--- umgebung
DHRT_FRAMES=60
DHRT_SCREENSHOT={fall}/bild.png
DH_OHNE_AUDIO=1
--- nachher
DIM b AS INTEGER : b = LOADIMAGE("bild.png")
DIM hell AS INTEGER
DIM x AS INTEGER
DIM y AS INTEGER
FOR y = 520 TO 600 STEP 2
    FOR x = 300 TO 980 STEP 2
        DIM f AS INTEGER : f = GETPIXEL(b, x, y)
        IF ((f SHR 16) BAND 255) > 200 AND ((f SHR 8) BAND 255) > 170 THEN hell = hell + 1
    NEXT
NEXT
PRINT "schriftzug "; hell > 800
--- erwartet
schriftzug TRUE

=== wartende funken sind unsichtbar
' gleich nach dem Start des Schwarms warten die meisten Funken noch an der
' Sonne; dort darf nichts zu sehen sein (bis 2026-10-27 war die Deckkraft
' umgekehrt gerechnet, und die Wartenden bildeten ein helles Viereck).
' Verglichen wird dasselbe Bild mit und ohne Schwarm, nur um die Sonne.
--- programm ../../examples/nachtflug/main.dh
--- ersetzen IMPORT "musik.dh"
IMPORT "{sammlung}/../../examples/nachtflug/musik.dh"
--- ersetzen     DIM h AS INTEGER : h = SHADER_LOAD("assets/shader/" + name + ".fs")
    DIM h AS INTEGER : h = SHADER_LOAD("{sammlung}/../../examples/nachtflug/assets/shader/" + name + ".fs")
--- ersetzen     IF takt >= AB_AUS THEN schwarmZeichnen(takt, zeit)
    IF takt >= AB_AUS AND NOT FILEEXISTS(STARTDIR$() + "/ohne") THEN schwarmZeichnen(takt, zeit)
--- argumente
--fenster
--ab
141
--- umgebung
DHRT_FRAMES=40
DHRT_SCREENSHOT={fall}/bild.png
DH_OHNE_AUDIO=1
--- zwischen
RENAME("bild.png", "mit.png")
WRITEALL("ohne", "1")
--- nochmal
--fenster
--ab
141
--- nachher
DIM a AS INTEGER : a = LOADIMAGE("mit.png")
DIM b AS INTEGER : b = LOADIMAGE("bild.png")
DIM anders AS INTEGER
DIM x AS INTEGER
DIM y AS INTEGER
FOR y = 360 TO 470
    FOR x = 1060 TO 1240
        DIM f AS INTEGER : f = GETPIXEL(a, x, y)
        DIM g AS INTEGER : g = GETPIXEL(b, x, y)
        IF ABS(((f SHR 8) BAND 255) - ((g SHR 8) BAND 255)) > 30 THEN anders = anders + 1
    NEXT
NEXT
PRINT "wartende sichtbar "; anders > 20
--- erwartet
wartende sichtbar FALSE

