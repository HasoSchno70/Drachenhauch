IMPORT "particles"

DIM ps AS PARTICLE_SYSTEM
ps = PARTICLE_SYSTEM_NEW(160, 120)
PARTICLE_SET_VELOCITY(ps, -50, 50, -100, -50)
PARTICLE_SET_LIFETIME(ps, 500, 1000)
PARTICLE_SET_GRAVITY(ps, 0, 200)
PARTICLE_SET_SIZE(ps, 2, 4)
PARTICLE_SET_COLOR(ps, &HFFFFFF)
PARTICLE_SET_FADE(ps, TRUE)
PARTICLE_SET_MODE(ps, "circle")

