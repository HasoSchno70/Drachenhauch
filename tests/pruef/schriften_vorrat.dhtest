=== die textbreite misst dieselben laeufe
' Die Breite eines Textes mit fremden Zeichen kommt aus denselben Schriften wie
' das Zeichnen -- ein Layout darf nicht mit einer anderen Schrift rechnen.
SCREEN(400, 120, "Schrift", 1)
SET_WINDOW_POS(-3000, -3000)
DIM a AS INTEGER : a = TEXT_WIDTH("日本")
DIM b AS INTEGER : b = TEXT_WIDTH("??")
DIM c AS INTEGER : c = TEXT_WIDTH("日本日本")
PRINT "breite positiv "; (a > 0); ", doppelt breiter "; (c > a)
--- umgebung
DHRT_FRAMES=2
--- erwartet
breite positiv TRUE, doppelt breiter TRUE

=== zwei kanji sind nicht so breit wie zwei fragezeichen
' Nur unter Windows: dort gibt es die Schrift, aus der die Kanji kommen.
' Gemessen NACH einem Bild: die Glyphen backt die Laufzeit am Bildende nach,
' davor ist jede Breite eine Schaetzung. Bis 2026.27 stand der Fall vor dem
' ersten Bild und bestand nur, weil der GANZE Text in die Ausweichschrift
' wechselte, deren Fragezeichen schmaler ist als das der Pixelschrift.
SCREEN(400, 120, "Schrift", 1)
SET_WINDOW_POS(-3000, -3000)
PRINT TEXT_WIDTH("日本") > 0
CLS(0) : FLIP()
DIM a AS INTEGER : a = TEXT_WIDTH("日本")
DIM b AS INTEGER : b = TEXT_WIDTH("??")
DIM c AS INTEGER : c = TEXT_WIDTH("日本日本")
PRINT "breite positiv "; (a > 0); ", doppelt breiter "; (c > a)
PRINT "anders als fragezeichen "; (a <> b)
--- umgebung
DHRT_FRAMES=3
--- system windows
--- erwartet
TRUE
breite positiv TRUE, doppelt breiter TRUE
anders als fragezeichen TRUE

=== satzzeichen erscheinen in der pixelschrift als ihre einfachen gegenstuecke
' Bis 2026.27 setzte ein einziges „ oder – die GANZE Zeile in die
' Ausweichschrift -- im Feed-Leser sprang so jede dritte Tabellenzeile in eine
' andere Schrift. Jetzt zeichnet die Pixelschrift sie als " ' - ... (nur die
' Anzeige; der Text bleibt). Gleiches Bild wie mit den ASCII-Zeichen.
IMPORT "helfer.dh"
foto("typo", "", "    TEXT(10, 10, " + CHR$(34) + "„Silver“ – ‚x‘ …" + CHR$(34) + ")" + CHR$(10))
foto("ascii", "", "    TEXT(10, 10, " + CHR$(34) + CHR$(34) + CHR$(34) + "Silver" + CHR$(34) + CHR$(34) + " - 'x' ..." + CHR$(34) + ")" + CHR$(10))
PRINT "gleich "; unterschiede("typo.png", "ascii.png")
