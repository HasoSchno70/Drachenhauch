leinwandZeiger()

' Welche Datei? Das Argument, sonst das Beispielmuster.
DIM probe AS STRING
DIM fotoZiel AS STRING
DIM start AS STRING
DIM a AS INTEGER
FOR a = 0 TO ARGC() - 1
    IF ARG$(a) = "--probe" THEN
        probe = "ansehen"
    ELSEIF ARG$(a) = "--probe-bearbeiten" THEN
        probe = "bearbeiten"
    ELSEIF ARG$(a) = "--probe-stufe3" THEN
        probe = "stufe3"
    ELSEIF ARG$(a) = "--probe-stufe4" THEN
        probe = "stufe4"
    ELSEIF ARG$(a) = "--probe-stufe5" THEN
        probe = "stufe5"
    ELSEIF ARG$(a) = "--probe-stufe6" THEN
        probe = "stufe6"
    ELSEIF ARG$(a) = "--probe-stufe7" THEN
        probe = "stufe7"
    ELSEIF ARG$(a) = "--foto" AND a < ARGC() - 1 THEN
        fotoZiel = ARGPATH$(a + 1)
        a = a + 1
    ELSE
        start = ARGPATH$(a)
    END IF
NEXT
IF start = "" THEN start = PATHJOIN(CWD$(), "daten/muster/demo_kreuzstich.pxs")
DIM geladen AS BOOLEAN : geladen = musterOeffnen(start)

IMPORT "ansicht/vorfuehrung.dh"
IF probe = "ansehen" THEN g_timeout_add(300, vorfuehren, 0)
IF probe = "bearbeiten" THEN g_timeout_add(300, vorfuehrenBearbeiten, 0)
IF probe = "stufe3" THEN g_timeout_add(300, vorfuehrenStufe3, 0)
IF probe = "stufe4" THEN g_timeout_add(300, vorfuehrenStufe4, 0)
IF probe = "stufe5" THEN g_timeout_add(300, vorfuehrenStufe5, 0)
IF probe = "stufe6" THEN g_timeout_add(300, vorfuehrenStufe6, 0)
IF probe = "stufe7" THEN g_timeout_add(300, vorfuehrenStufe7, 0)

gtk_main()
