' Tabelle bedienen wie eine Liste (2026-09-23): Doppelklick und Enter melden
' GUI_DOUBLE_CLICKED, F2 bearbeitet im Zeilenmodus, Tippen springt,
' Rechtsklick waehlt, das Rad rollt weich, ein Leer-Hinweis.
' Tabelle bei (10, 10, 280, 200), Kopf 22 hoch, Zeilen 20: Zeile r liegt bei
' y 32 + 20 r .. + 19. Tasten: F2 291, Enter 257, B 66, 4 52.
' Format: docs/werkzeuge.md, dhrt test.

=== ein doppelklick meldet und waehlt die zeile
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 10, 10, 280, 200)
GUI_TABLE_HEADERS(tb, ["Name", "Preis"])
GUI_TABLE_ADD_ROW(tb, ["Apfel", "1"]) : GUI_TABLE_ADD_ROW(tb, ["Birne", "2"]) : GUI_TABLE_ADD_ROW(tb, ["Kirsche", "3"])
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOUBLE_CLICKED(tb) THEN PRINT "doppel "; GUI_TABLE_SELECTED(tb)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 6
e 0 7 5 215 0 0
e 1 7 60 82 0 0
e 2 6 0 0 0 0
e 3 5 0 0 0 0
e 4 6 0 0 0 0
e 5 5 0 0 0 0

--- umgebung
DHRT_FRAMES=10
--- erwartet
doppel 2

=== enter meldet die gewaehlte zeile
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 10, 10, 280, 200)
GUI_TABLE_HEADERS(tb, ["Name", "Preis"])
GUI_TABLE_ADD_ROW(tb, ["Apfel", "1"]) : GUI_TABLE_ADD_ROW(tb, ["Birne", "2"]) : GUI_TABLE_ADD_ROW(tb, ["Kirsche", "3"])
GUI_TABLE_SET_SELECTED(tb, 1)
GUI_FOCUS(tb)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOUBLE_CLICKED(tb) THEN PRINT "doppel "; GUI_TABLE_SELECTED(tb)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 3
e 0 7 5 215 0 0
e 2 2 257 0 0 0
e 3 1 257 0 0 0

--- umgebung
DHRT_FRAMES=8
--- erwartet
doppel 1

=== ein doppelklick auf eine bearbeitbare zelle bearbeitet statt zu melden
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 10, 10, 280, 200)
GUI_TABLE_HEADERS(tb, ["Name", "Preis"])
GUI_TABLE_ADD_ROW(tb, ["Apfel", "1"]) : GUI_TABLE_ADD_ROW(tb, ["Birne", "2"]) : GUI_TABLE_ADD_ROW(tb, ["Kirsche", "3"])
GUI_TABLE_COL_EDIT(tb, 0, TRUE)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOUBLE_CLICKED(tb) THEN PRINT "doppel"
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "bearbeitet "; GUI_TABLE_EDITING_ROW(tb); " "; GUI_TABLE_EDITING_COL(tb)
