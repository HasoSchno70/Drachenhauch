=== ein kontextmenue am rand weicht nach links oben aus
' Rechtsklick bei (295, 295) in einem 300x300-Fenster: das Menue steht links
' ueber der Maus, (250, 285) liegt in ihm (Popup-Grund blau). Vorher lief es
' rechts unten aus dem Bild.
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_METRIC_SET("uebergang", 0)
GUI_THEME_SET("widget_bg", &H0000FF)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM c AS INTEGER : c = GUI_CONTEXT(w)
GUI_MENU_ITEM(c, "Kopieren") : GUI_MENU_ITEM(c, "Einfuegen") : GUI_MENU_ITEM(c, "Loeschen")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 4
e 0 7 5 5 0 0
e 1 7 295 295 0 0
e 2 6 1 0 0 0
e 3 5 1 0 0 0

--- umgebung
DHRT_FRAMES=8
--- bild
250 285 #0000FF +-2

=== ein untermenue am rechten rand klappt links auf
' Kontextmenue bei (200, 20); sein Untermenue passt rechts nicht mehr hin
' und steht links davon -- (150, 35) liegt in ihm (auf der ersten Zeile,
' die die Tastatur markiert hat: dort ist nicht Fenstergrund #18222E).
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_METRIC_SET("uebergang", 0)
GUI_THEME_SET("widget_bg", &H0000FF)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM c AS INTEGER : c = GUI_CONTEXT(w)
DIM u AS INTEGER : u = GUI_SUBMENU(c, "Mehr")
GUI_MENU_ITEM(u, "Eins") : GUI_MENU_ITEM(u, "Zwei")
GUI_MENU_ITEM(c, "Kopieren")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 8
e 0 7 5 295 0 0
e 1 7 200 20 0 0
e 2 6 1 0 0 0
e 3 5 1 0 0 0
e 5 2 264 0 0 0
e 6 1 264 0 0 0
