=== sammelaktionen: alle, keine, umkehren, mhd setzen, lagerort setzen, markierte loeschen
' MHD setzen fragt die Tage (EingabeZahl, Enter = 7), Lagerort die Auswahl
' (Auswahl, Enter = der erste), danach je eine Meldung; Loeschen fragt.
' Ohne Markierung sagt jede es.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
slZeilen = [] : slBild = 0
slHin(10, 10)
DIM k AS INTEGER
FOR k = 1 TO 6
    slWarten(12)
    slTaste(257)
NEXT
slAufnahmeSchreiben(p + "/_studio/tasten.txt")
PRINT "code "; kProbe(p, "probe.dh", "tasten.txt", 200)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM sc AS ScanFenster : sc = NEW ScanFenster()
sc.Zeigen()
SUB stand(wann AS STRING)
    DIM t AS ARRAY OF STRING : t = []
    DIM z AS INTEGER
    FOR z = 0 TO GUI_TABLE_ROW_COUNT(sc.tabelle) - 1
        ARRAY_PUSH(t, STR$(GUI_TABLE_GET_VALUE(sc.tabelle, z, 0)) + ":" + GUI_TABLE_GET_CELL(sc.tabelle, z, 1) + ":" + GUI_TABLE_GET_CELL(sc.tabelle, z, 4) + ":" + GUI_TABLE_GET_CELL(sc.tabelle, z, 10))
    NEXT
    PRINT wann; " "; JOIN$(t, " / ")
END SUB
sc.hinzufuegen("1", "Milch", NIL, 1, "", -1)
sc.hinzufuegen("2", "Brot", NIL, 1, "", -1)
sc.hinzufuegen("3", "Nudeln", NIL, 1, "", -1)
stand("anfang")
sc.knopfKeine_Klick()
' Ohne Markierung: Meldung (Enter 1).
sc.knopfTage_Klick()
sc.tabelle_Zelle(0, 0)
GUI_TABLE_CELL_VALUE(sc.tabelle, 0, 0, 1)
sc.knopfUmkehren_Klick()
stand("umgekehrt")
' Tage (Enter 2 = 7), Meldung (Enter 3).
sc.knopfTage_Klick()
' Ort (Enter 4 = der erste), Meldung (Enter 5).
sc.knopfOrt_Klick()
stand("gesetzt")
' Loeschen (Enter 6 = Ja).
sc.knopfLoeschen_Klick()
stand("geloescht")
PRINT "anzahl "; GUI_TEXT(sc.anzahlText); " | speichern "; GUI_ENABLED(sc.knopfSpeichern)
sc.knopfAlle_Klick()
stand("alle")
--- erwartet
