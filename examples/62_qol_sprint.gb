' 62_qol_sprint.gb -- IN-Operator, Regex, Variadic-Functions in einem Showcase.

IMPORT "regex"

PRINT "=== IN-Operator ==="

' Substring-Test
DIM phrase AS STRING
phrase = "Hello GameBasic World"
PRINT "'GameBasic' IN phrase =>", "GameBasic" IN phrase
PRINT "'Python' IN phrase =>", "Python" IN phrase

' Tupel-Mitgliedschaft
DIM x AS INTEGER
x = 5
IF x IN (1, 3, 5, 7) THEN
    PRINT x, "ist ungerade-klein"
END IF

' Map-Key
DIM scores AS MAP OF INTEGER
scores.put("alice", 100)
scores.put("bob", 75)
PRINT "'alice' IN scores =>", "alice" IN scores
PRINT "'eve' IN scores   =>", "eve" IN scores

' Array-Element
DIM days[3] AS STRING
days[0] = "Mon"
days[1] = "Tue"
days[2] = "Wed"
PRINT "'Tue' IN days     =>", "Tue" IN days

PRINT ""
PRINT "=== Regex-Modul ==="

DIM email AS STRING
email = "alice@example.com"
PRINT "Email gueltig?       =>", REGEX_TEST(email, "^[a-z]+@[a-z]+\.[a-z]+$")

DIM log_line AS STRING
log_line = "[2026-05-07 14:32:18] ERROR: file not found"
PRINT "Datum gefunden:      =>", REGEX_FIND(log_line, "[0-9]{4}-[0-9]{2}-[0-9]{2}")

DIM cleaned AS STRING
cleaned = REGEX_REPLACE("Hallo  Welt   foo bar", "\s+", " ")
PRINT "Whitespace genormt:  =>", cleaned

DIM csv_line AS STRING
csv_line = "alice,bob;cilla, dan"
DIM names AS ARRAY OF STRING
names = REGEX_SPLIT(csv_line, "[,;]\s*")
PRINT "Splits:              =>", names.length()
DIM i AS INTEGER
FOR i = 0 TO names.length() - 1
    PRINT "  [" + STR$(i) + "] " + names[i]
NEXT

PRINT ""
PRINT "=== Variadic-Functions ==="

' Variadic mit Pflicht-Param
SUB log(level AS STRING, ...rest)
    DIM msg AS STRING
    msg = "[" + level + "]"
    DIM j AS INTEGER
    FOR j = 0 TO rest.length() - 1
        msg = msg + " " + STR$(rest[j])
    NEXT
    PRINT msg
END SUB

log("INFO", "App", "started")
log("WARN", "Slow", "render", 16, "ms")
log("ERROR")

' Variadic-Function mit Akkumulator
FUNCTION sum_all(...nums) AS INTEGER
    DIM total AS INTEGER
    DIM k AS INTEGER
    total = 0
    FOR k = 0 TO nums.length() - 1
        total = total + nums[k]
    NEXT
    RETURN total
END FUNCTION

PRINT ""
PRINT "sum_all()              =", sum_all()
PRINT "sum_all(1,2,3)         =", sum_all(1, 2, 3)
PRINT "sum_all(10,20,30,40,50)=", sum_all(10, 20, 30, 40, 50)
