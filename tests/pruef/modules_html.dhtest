=== nummern werden nicht neu vergeben
' Nach dem Abholen darf die Nummer nicht an einen neuen Abruf gehen --
' sonst holt ein Programm die Antwort eines fremden Abrufs ab.
' Gegenserver: tests/pruef/_hilfen/gegenserver.dh (Bis Stufe 48 in test_modules_html.py.)
IMPORT "html"
FUNCTION starten$(modus AS STRING, verz AS STRING, schl AS STRING) AS STRING
    ' Gegenserver als Kind: ARG$(0) ist sein Pfad, er schreibt seinen Port in
    ' diesen Ordner. Rueckgabe "basis|prozess".
    DIM portdatei AS STRING : portdatei = CWD$() + "/port.txt"
    IF FILEEXISTS(portdatei) THEN DELETEFILE(portdatei)
    DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", ARG$(0), "--", modus, verz, schl, portdatei)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS(portdatei) THEN
            DIM z AS ARRAY OF STRING : z = READLINES(portdatei)
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN "http://127.0.0.1:" + TRIM$(z[0]) + "|" + STR$(p)
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN "|" + STR$(p)
END FUNCTION
DIM srv AS ARRAY OF STRING : srv = SPLIT$(starten$("langsam", "300", "-"), "|")
DIM basis AS STRING : basis = srv[0]
DIM a AS INTEGER : a = HTTP_GET_START(basis + "/a")
WHILE NOT HTTP_READY(a) : WEND
DIM weg AS STRING : weg = HTTP_RESULT(a)
DIM b AS INTEGER : b = HTTP_GET_START(basis + "/b")
PRINT a <> b
HTTP_CANCEL(b)
PROCESS_KILL(VAL(srv[1]))
--- argumente
{sammlung}/_hilfen/gegenserver.dh
--- erwartet
TRUE

=== fehler kommt erst beim abholen
' Ein 404 laesst HTTP_GET_START durchgehen -- gemeldet wird beim
' Abholen, dort wo das Programm damit umgehen kann.
' Gegenserver: tests/pruef/_hilfen/gegenserver.dh (Bis Stufe 48 in test_modules_html.py.)
IMPORT "html"
FUNCTION starten$(modus AS STRING, verz AS STRING, schl AS STRING) AS STRING
    ' Gegenserver als Kind: ARG$(0) ist sein Pfad, er schreibt seinen Port in
    ' diesen Ordner. Rueckgabe "basis|prozess".
    DIM portdatei AS STRING : portdatei = CWD$() + "/port.txt"
    IF FILEEXISTS(portdatei) THEN DELETEFILE(portdatei)
    DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", ARG$(0), "--", modus, verz, schl, portdatei)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS(portdatei) THEN
            DIM z AS ARRAY OF STRING : z = READLINES(portdatei)
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN "http://127.0.0.1:" + TRIM$(z[0]) + "|" + STR$(p)
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN "|" + STR$(p)
END FUNCTION
DIM srv AS ARRAY OF STRING : srv = SPLIT$(starten$("routen", "0", "-"), "|")
DIM basis AS STRING : basis = srv[0]
TRY
    DIM h AS INTEGER : h = HTTP_GET_START(basis + "/nope")
    WHILE NOT HTTP_READY(h) : WEND
    PRINT HTTP_RESULT(h)
CATCH e
    PRINT "fehler: "; e
END TRY
PROCESS_KILL(VAL(srv[1]))
--- argumente
{sammlung}/_hilfen/gegenserver.dh
--- enthaelt
fehler: HTTP 404
