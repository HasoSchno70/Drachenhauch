' Eine Benachrichtigung (wie Notification der Python-App): Titel, Text und
' ob sie wichtig ist (HIGH/CRITICAL dort). Nicht "Meldung" -- so heißt in der
' Studio-Laufzeit schon das Meldungsfenster.
CLASS Nachricht
    DIM titel AS STRING
    DIM text AS STRING
    DIM wichtig AS BOOLEAN
END CLASS

FUNCTION nachrichtNeu(titel AS STRING, text AS STRING, wichtig AS BOOLEAN) AS Nachricht
    DIM m AS Nachricht : m = NEW Nachricht()
    m.titel = titel
    m.text = text
    m.wichtig = wichtig
    RETURN m
END FUNCTION
