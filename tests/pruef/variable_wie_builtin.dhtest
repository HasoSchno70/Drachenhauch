' Aus test_variable_wie_builtin.py uebertragen (6 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== globale variable mit builtin namen
DIM deg AS FLOAT
deg = DEG(3.141592653589793)
PRINT INT(deg + 0.5)
DIM len AS INTEGER
len = LEN("abc")
PRINT len
--- erwartet
180
3

=== lokale variable mit builtin namen
SUB t()
    DIM sqr AS FLOAT
    sqr = SQR(16.0)
    PRINT sqr
END SUB
t()
--- erwartet
4.0

=== parameter mit builtin namen
FUNCTION f(abs AS INTEGER) AS INTEGER
    RETURN ABS(abs) + abs
END FUNCTION
PRINT f(-3)
--- erwartet
0

=== eine funcref dieses namens ruft weiter die variable
' Der Grund, warum es nicht einfach 'immer der Builtin' heisst.
FUNCTION quadrat(x AS INTEGER) AS INTEGER
    RETURN x * x
END FUNCTION
DIM abs AS FUNCREF
abs = quadrat
PRINT abs(-5)
--- erwartet
25

=== eine leere funcref dieses namens gibt die klare meldung
DIM len AS FUNCREF
PRINT LEN("ab")
--- fehler
'len' ist eine Variable vom Typ NIL und kann nicht wie eine Funktion aufgerufen werden. Falls du den eingebauten Befehl 'LEN' meinst: benenne die Variable um -- eine Variable mit festem Wert-Typ (INTEGER, FLOAT, STRING ...) verdeckt einen Befehl nicht, eine FUNCREF schon.

=== die for each laufvariable verdeckt nicht
FOR EACH len IN (1, 2)
    PRINT LEN("ab")
NEXT
--- erwartet
2
2

=== check bleibt still
' Kein Fehlalarm fuer den Alltagsfall `deg = DEG(x)`.
' (Bis Stufe 44 in test_variable_wie_builtin.py.)
FUNCTION lesen$(pc AS INTEGER) AS STRING
    ' Alles, was der Prozess ausgibt -- mehrere leere Abfragen abwarten, der
    ' Lesefaden kann nach dem Ende noch nachliefern.
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM r AS STRING : r = ""
    DIM stille AS INTEGER : stille = 0
    WHILE MILLIS() < bis AND stille < 5
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN r = r + zz : stille = 0
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
    WEND
    RETURN r
END FUNCTION
FUNCTION jsonZeile$(pc AS INTEGER) AS STRING
    ' Die Zeile, die mit { beginnt -- davor darf das Programm ausgegeben haben.
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM r AS STRING : r = ""
    DIM stille AS INTEGER : stille = 0
    WHILE MILLIS() < bis AND stille < 5
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN
            stille = 0
            IF LEFT$(TRIM$(zz), 1) = "{" THEN r = TRIM$(zz)
        END IF
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
    WEND
    RETURN r
END FUNCTION
DIM befund AS STRING : befund = TRIM$(lesen$(PROCESS_START("dhrt", "--check", "d.dh")))
PRINT "sauber " ; befund = "" OR befund = "[]"
--- datei d.dh
DIM deg AS FLOAT
deg = DEG(1.0)
PRINT deg

--- erwartet
sauber TRUE
