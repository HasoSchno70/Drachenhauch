' FLAC ueber Kira: die Beilagen hat ein kleiner Schreiber ausserhalb der
' Laufzeit erzeugt (STREAMINFO, Bloecke zu 1000 Punkten, VERBATIM-Subframes,
' CRC-8 im Kopf und CRC-16 am Ende jedes Blocks), 8000 Hz, 16 Bit, 0,25 s.
' Links ein Sinus 440 Hz mit halber Aussteuerung, rechts 880 Hz mit einem
' Viertel. Gelesen wird ueber LOADSOUND (Symphonia in Kira), zurueck kommt
' es als WAV, und die WAV wird Punkt fuer Punkt gegen die Formel geprueft --
' ein Dekoder, der nur "irgendetwas" liefert, fiele dabei auf.
' Seit 2026-09-21.

=== flac mono laedt punktgenau
IMPORT "audio"
' Jeden Punkt der WAV gegen die Formel des Schreibers halten. Die Laufzeit
' rechnet ueber Kommazahlen (/32768 hinein, *32767 hinaus), darum +-2.
FUNCTION abweichung(pfad AS STRING, kanaele AS INTEGER, k AS INTEGER, f AS FLOAT, a AS FLOAT) AS INTEGER
    DIM w AS BUFFER : w = READALL_BYTES(pfad)
    DIM d AS INTEGER : d = BUFFER_INDEXOF(w, BUFFER_FROM_STRING("data")) + 8
    DIM n AS INTEGER : n = BUFFER_GET_U32(w, d - 4) \ (2 * kanaele)
    DIM groesste AS INTEGER : groesste = 0
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM soll AS INTEGER : soll = ROUND(a * 32767 * SIN(2 * PI * f * i / 8000))
        DIM ist AS INTEGER : ist = BUFFER_GET_I16(w, d + (i * kanaele + k) * 2)
        IF ABS(ist - soll) > groesste THEN groesste = ABS(ist - soll)
    NEXT
    RETURN groesste
END FUNCTION

DIM s AS SOUND
s = LOADSOUND("mono.flac")
AUDIO_SAVE_WAV(s, "m.wav")
PRINT "abweichung klein "; abweichung("m.wav", 1, 0, 440.0, 0.5) <= 2
