=== in array (1)
DIM nums[3] AS INTEGER
nums[0] = 10 : nums[1] = 20 : nums[2] = 30
PRINT 20 IN nums
PRINT 99 IN nums
--- erwartet
TRUE
FALSE

=== in array (2)
