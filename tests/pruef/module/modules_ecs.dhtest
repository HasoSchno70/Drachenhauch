' Aus test_modules_ecs.py uebertragen (28 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== new world is empty
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
PRINT ECS_COUNT(w)
--- erwartet
0

=== new entity returns growing ids
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
PRINT ECS_NEW_ENTITY(w)
PRINT ECS_NEW_ENTITY(w)
--- erwartet
1
2

=== count grows
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
ECS_NEW_ENTITY(w)
ECS_NEW_ENTITY(w)
ECS_NEW_ENTITY(w)
PRINT ECS_COUNT(w)
--- erwartet
3

=== destroy returns true on success
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
DIM e AS INTEGER
e = ECS_NEW_ENTITY(w)
PRINT ECS_DESTROY(w, e)
PRINT ECS_COUNT(w)
--- erwartet
TRUE
0

=== destroy returns false for unknown
IMPORT "ecs"
DIM w AS ECS_WORLD
w = ECS_NEW_WORLD()
PRINT ECS_DESTROY(w, 999)
--- erwartet
FALSE

=== alive
IMPORT "ecs"
