' S-Ausdruecke lesen (KiCad-Dateien) -- Namensraum "kern".
'
' (at 10.16 20.32 90) wird ein Knoten mit kopf "at" und werten
' ["10.16", "20.32", "90"]; Unterlisten stehen in kinder. Zeichenketten in
' Anfuehrungszeichen kennen \" und \\. Ohne Rekursion (ein Stapel), damit
' auch tief geschachtelte Dateien gehen.

CLASS SAusdruck
    DIM kopf AS STRING
    DIM werte AS ARRAY OF STRING
    DIM kinder AS ARRAY OF SAusdruck
    SUB Init()
        kopf = ""
        werte = []
        kinder = []
    END SUB
    FUNCTION hat(name AS STRING) AS BOOLEAN
        DIM i AS INTEGER
        FOR i = 0 TO LEN(kinder) - 1
            IF kinder[i].kopf = name THEN RETURN TRUE
        NEXT
        RETURN FALSE
    END FUNCTION
    ' das erste Kind mit diesem Kopf (sonst ein leerer Knoten)
    FUNCTION kind(name AS STRING) AS SAusdruck
        DIM i AS INTEGER
        FOR i = 0 TO LEN(kinder) - 1
            IF kinder[i].kopf = name THEN RETURN kinder[i]
        NEXT
        RETURN NEW SAusdruck()
    END FUNCTION
    FUNCTION alle(name AS STRING) AS ARRAY OF SAusdruck
        DIM r AS ARRAY OF SAusdruck : r = []
        DIM i AS INTEGER
        FOR i = 0 TO LEN(kinder) - 1
            IF kinder[i].kopf = name THEN ARRAY_PUSH(r, kinder[i])
        NEXT
        RETURN r
    END FUNCTION
    FUNCTION wert$(i AS INTEGER) AS STRING
        IF i < 0 OR i >= LEN(werte) THEN RETURN ""
        RETURN werte[i]
    END FUNCTION
    ' Wert einer Eigenschaft: (property "Reference" "R1" ...)
    FUNCTION eigenschaft$(name AS STRING) AS STRING
        DIM i AS INTEGER
        FOR i = 0 TO LEN(kinder) - 1
            IF kinder[i].kopf = "property" AND kinder[i].wert$(0) = name THEN RETURN kinder[i].wert$(1)
        NEXT
        RETURN ""
    END FUNCTION
END CLASS

FUNCTION istLeer(c AS STRING) AS BOOLEAN
    RETURN c = " " OR c = CHR$(9) OR c = CHR$(10) OR c = CHR$(13)
END FUNCTION

' Den ganzen Text lesen; die Wurzel ist der erste Ausdruck.
FUNCTION sLesen(text AS STRING) AS SAusdruck
    DIM wurzel AS SAusdruck : wurzel = NEW SAusdruck()
    DIM stapel AS ARRAY OF SAusdruck : stapel = [wurzel]
    DIM i AS INTEGER : i = 0
    DIM n AS INTEGER : n = LEN(text)
    WHILE i < n
        DIM c AS STRING : c = MID$(text, i, 1)
        IF istLeer(c) THEN
            i = i + 1
        ELSEIF c = "(" THEN
            DIM neu AS SAusdruck : neu = NEW SAusdruck()
            ARRAY_PUSH(stapel[LEN(stapel) - 1].kinder, neu)
            ARRAY_PUSH(stapel, neu)
            i = i + 1
        ELSEIF c = ")" THEN
            IF LEN(stapel) > 1 THEN
                DIM zu AS SAusdruck : zu = ARRAY_POP(stapel)
            END IF
            i = i + 1
        ELSE
            ' ein Atom: in Anfuehrungszeichen oder bis zum naechsten Trenner
            DIM atom AS STRING : atom = ""
            IF c = CHR$(34) THEN
                i = i + 1
                WHILE i < n
                    DIM d AS STRING : d = MID$(text, i, 1)
                    IF d = "\" AND i + 1 < n THEN
                        DIM e AS STRING : e = MID$(text, i + 1, 1)
                        IF e = "n" THEN
                            atom = atom + CHR$(10)
                        ELSE
                            atom = atom + e
                        END IF
                        i = i + 2
                    ELSEIF d = CHR$(34) THEN
                        i = i + 1
                        BREAK
                    ELSE
                        atom = atom + d
                        i = i + 1
                    END IF
                WEND
            ELSE
                DIM a0 AS INTEGER : a0 = i
                WHILE i < n
                    DIM f AS STRING : f = MID$(text, i, 1)
                    IF istLeer(f) OR f = "(" OR f = ")" THEN BREAK
                    i = i + 1
                WEND
                atom = MID$(text, a0, i - a0)
            END IF
            DIM oben AS SAusdruck : oben = stapel[LEN(stapel) - 1]
            ' das erste Atom einer Liste ist ihr Kopf
            IF oben.kopf = "" AND LEN(oben.werte) = 0 AND LEN(oben.kinder) = 0 AND LEN(stapel) > 1 THEN
                oben.kopf = atom
            ELSE
                ARRAY_PUSH(oben.werte, atom)
            END IF
        END IF
    WEND
    IF LEN(wurzel.kinder) > 0 THEN RETURN wurzel.kinder[0]
    RETURN wurzel
END FUNCTION
