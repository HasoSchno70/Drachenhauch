e 0 7 5 295 0 0
e 2 2 75 0 0 0
e 3 1 75 0 0 0

--- umgebung
DHRT_FRAMES=8
--- erwartet
Apfel
Kirsche

=== tippen markiert bei offener liste, enter uebernimmt
IMPORT "gui"
SCREEN(300, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 10, 10, 190, 28, ["Apfel", "Birne", "Kirsche"])
GUI_FOCUS(dd)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 8 THEN PRINT "offen noch "; GUI_DROPDOWN_TEXT(dd)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "danach "; GUI_DROPDOWN_TEXT(dd)
