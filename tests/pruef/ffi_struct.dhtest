IMPORT "geo.dh" AS geo
DIM p AS Punkt
p.x = 2
p.y = 5
PRINT geo.summe(p), SIZEOF(Punkt)
--- datei geo.dh
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
FUNCTION summe(p AS Punkt) AS INTEGER
    RETURN p.x + p.y
END FUNCTION
