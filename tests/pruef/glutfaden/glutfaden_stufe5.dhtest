--- erwartet
Probe_OXS.pxs, Probe_OXS.html, Probe_OXS.png, Probe_OXS.pdf, garnliste.csv, LIESMICH.txt
fehlt 0 nebendatei FALSE
garnliste wie pysticky TRUE bom 239 187 191
html TRUE
pdf %PDF
png 807871 TRUE
pxs 12x9 5
Glutfaden-Paket: Probe <&> "OXS"
============================================================
Größe: 12 × 9 Stiche
Stoffzaehlung: 16 ct
Farben: 5

Enthaltene Dateien:
  - Probe_OXS.pxs
  - Probe_OXS.html
  - Probe_OXS.png
  - Probe_OXS.pdf
  - garnliste.csv

Das .pxs öffnen Glutfaden und PySticky.

=== paket: diamond, ohne pdf, originalbild fehlt
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
m.modus = "diamond" : m.stoff = 9
m.quellBild = "gibtsnicht.png"
DIM e AS kern.PaketErgebnis : e = kern.paketExportieren(m, "dp.zip", "", FALSE, pal)
PRINT JOIN$(ZIP_LIST("dp.zip"), ", ")
PRINT JOIN$(e.fehlt, ", ")
PRINT SPLIT$(MID$(ZIP_READ$("dp.zip", "garnliste.csv"), 1, 999), CHR$(13))[0]
m.quellBild = "bild.png"
DIM b AS IMAGE : b = IMAGE_NEW(4, 3, &HFF0000)
IMAGE_SAVE(b, "bild.png")
e = kern.paketExportieren(m, "dp.zip", "", FALSE, pal)
PRINT JOIN$(ZIP_LIST("dp.zip"), ", "); " | fehlt "; LEN(e.fehlt)
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"

