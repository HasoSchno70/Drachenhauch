' Info- und Fortschritts-Leiste: zwei weitere Reiter der Seitenleiste neben
' "Muster" (PySticky ui/panels/info_panel.py und progress_panel.py).
'
' Info: die Stoffzaehlung, neun Karten (Stiche, Farben, Groesse, Masse,
' Ebenen, Stickzeit, Garnbedarf, Fortschritt, Schwierigkeit), das Quellbild
' und je Farbe Stiche und Garn. Die Texte rechnet der Kern
' (kern.infoKarten, kern.farbeInfoText$) -- dieselben Formeln wie PySticky.
' Fortschritt: der Sticken-Modus (das Fortschritts-Werkzeug), Gesamtbalken,
' je Farbe Prozent, Balken und "Alle erledigt", und "Fortschritt
' zuruecksetzen" -- hier ein Rueckgaengig-Schritt, PySticky leert dafuer den
' Verlauf.
'
' Nachgezogen wird nur der sichtbare Reiter (ilNachziehen); beim Umschalten
' holt der andere auf. Widgets entstehen nur, wenn sich der Bestand aendert --
' sonst werden Texte und Balken gesetzt.

DIM ilSeite AS INTEGER                ' Info-Reiter (Box)
DIM ilStoff AS INTEGER                ' Klappliste
DIM ilStoffe AS ARRAY OF FLOAT        ' ihre Eintraege
DIM ilSperre AS BOOLEAN
DIM ilKarten AS ARRAY OF INTEGER      ' die neun Wert-Beschriftungen
DIM ilSchwierig AS INTEGER            ' Zeile der Schwierigkeit (Tooltip)
DIM ilQuelle AS INTEGER               ' Zeile des Quellbilds
DIM ilQuelleText AS INTEGER
DIM ilFarbListe AS INTEGER
DIM ilFarbStand AS STRING             ' Bestand, zu dem die Zeilen gehoeren
DIM ilFarbTexte AS ARRAY OF INTEGER   ' rechts je Zeile
DIM ilStand AS ARRAY OF STRING        ' zuletzt gesetzte Kartentexte
' Fortschritt
DIM fsSeite AS INTEGER
DIM fsModus AS INTEGER                ' Knopf Sticken-Modus
DIM fsModusText AS STRING
DIM fsVorher AS INTEGER               ' Werkzeug vor dem Sticken-Modus
DIM fsBalken AS INTEGER
DIM fsZahl AS INTEGER
DIM fsListe AS INTEGER                ' Box der Zeilen
DIM fsStand AS STRING                 ' Bestand der Zeilen
DIM fsZeilen AS ARRAY OF INTEGER      ' die Zeilen-Widgets
DIM fsNr AS ARRAY OF INTEGER          ' je Zeile die Farbe
DIM fsProzent AS ARRAY OF INTEGER
DIM fsBalkenJe AS ARRAY OF INTEGER
DIM fsZahlJe AS ARRAY OF INTEGER

CONST IL_TITEL = "Stiche|Farben|Größe|Maße|Ebenen|Stickzeit|Garnbedarf|Fortschritt|Schwierigkeit"
CONST IL_ZEICHEN = "✦|🎨|📐|📏|📑|⏱|🧵|✅|🎯"
CONST IL_FARBEN = "#ff8a3d|#4a90d9|#2fb5a6|#a77bd8|#e05c5c|#40c8b0|#c878a8|#40c870|#e0b040"

FUNCTION ilMaske$(t AS STRING) AS STRING
    RETURN REPLACE$(REPLACE$(REPLACE$(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
END FUNCTION

FUNCTION ilModus$() AS STRING
    IF lwHat THEN RETURN lwMuster.modus
    RETURN "stitch"
END FUNCTION

' --- Info --------------------------------------------------------------------------------

FUNCTION infoleisteNeu() AS INTEGER
    ilSeite = gtk_box_new(GTK_SENKRECHT, 2)
    gtk_box_pack_start(ilSeite, slUeberschrift("Stoffzählung"), FALSE, FALSE, 0)
    ilStoff = gtk_combo_box_text_new()
    gtkKlasse(ilStoff, "innen")
    tipp(ilStoff, "Kästchen je Zoll -- bestimmt Maße und Garnbedarf")
    ilStoffe = []
    signal(ilStoff, "changed", ilStoffGeaendert, 0, 0, 0)
    gtk_box_pack_start(ilSeite, ilStoff, FALSE, FALSE, 0)

    gtk_box_pack_start(ilSeite, slUeberschrift("Muster"), FALSE, FALSE, 0)
    DIM titel AS ARRAY OF STRING : titel = SPLIT$(IL_TITEL, "|")
    DIM zeichen AS ARRAY OF STRING : zeichen = SPLIT$(IL_ZEICHEN, "|")
    DIM farben AS ARRAY OF STRING : farben = SPLIT$(IL_FARBEN, "|")
    ilKarten = []
    ilStand = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(titel) - 1
        DIM z AS INTEGER : z = gtk_box_new(GTK_WAAGERECHT, 8)
        gtkKlasse(z, "ikarte")
        DIM ic AS INTEGER : ic = gtk_label_new("")
        gtk_label_set_markup(ic, "<span foreground='" + farben[i] + "'>" + zeichen[i] + "</span>")
        gtk_widget_set_size_request(ic, 20, -1)
        DIM tl AS INTEGER : tl = gtk_label_new(titel[i])
        gtkKlasse(tl, "nebensache")
        gtk_label_set_xalign(tl, 0.0)
        DIM wl AS INTEGER : wl = gtk_label_new("")
        gtkKlasse(wl, "ikwert")
        gtk_label_set_xalign(wl, 1.0)
        gtk_label_set_ellipsize(wl, GTK_ELLIPSE_ANFANG)
        gtk_widget_set_hexpand(wl, TRUE)
        gtk_box_pack_start(z, ic, FALSE, FALSE, 0)
        gtk_box_pack_start(z, tl, FALSE, FALSE, 0)
        gtk_box_pack_end(z, wl, TRUE, TRUE, 0)
        gtk_box_pack_start(ilSeite, z, FALSE, FALSE, 0)
        ARRAY_PUSH(ilKarten, wl)
        ARRAY_PUSH(ilStand, "")
        IF i = 8 THEN ilSchwierig = z
    NEXT
    tipp(ilSchwierig, "Heuristik aus Farbanzahl, Spezial-Stichen, Backstitches und Größe.")

    ' Quellbild -- eine Zeile, die Einzelheiten im Tooltip
    ilQuelle = gtk_box_new(GTK_WAAGERECHT, 6)
    gtkKlasse(ilQuelle, "ikarte")
    DIM qi AS INTEGER : qi = gtk_label_new("📷")
    ilQuelleText = gtk_label_new("")
    gtk_label_set_xalign(ilQuelleText, 0.0)
    gtk_label_set_ellipsize(ilQuelleText, GTK_ELLIPSE_MITTE)
    gtk_widget_set_hexpand(ilQuelleText, TRUE)
    gtk_box_pack_start(ilQuelle, qi, FALSE, FALSE, 0)
    gtk_box_pack_start(ilQuelle, ilQuelleText, TRUE, TRUE, 0)
    gtk_widget_set_no_show_all(ilQuelle, TRUE)
    gtk_box_pack_start(ilSeite, ilQuelle, FALSE, FALSE, 4)

    gtk_box_pack_start(ilSeite, slUeberschrift("Farbübersicht"), FALSE, FALSE, 0)
    ilFarbListe = gtk_list_box_new()
    gtk_list_box_set_selection_mode(ilFarbListe, GTK_AUSWAHL_EINE)
    gtkKlasse(ilFarbListe, "liste")
    signalZeile(ilFarbListe, "row-selected", ilFarbeGewaehlt, 0, 0, 0)
    gtk_box_pack_start(ilSeite, ilFarbListe, FALSE, FALSE, 0)
    ilFarbStand = "-"
    RETURN ilSeite
END FUNCTION

' Das kleine Farbfeld der Listen (ohne Symbol -- das steht daneben)
FUNCTION ilFarbfeld(w AS INTEGER, cr AS INTEGER, i AS INTEGER) AS BOOLEAN
    IF NOT lwHat OR i >= lwMuster.farbanzahl() THEN RETURN TRUE
    DIM b AS FLOAT : b = gtk_widget_get_allocated_width(w)
    DIM h AS FLOAT : h = gtk_widget_get_allocated_height(w)
    cairoFarbe(cr, lwMuster.farben[i].garn.farbe)
    cairo_rectangle(cr, 0, 0, b, h)
    cairo_fill(cr)
    cairo_set_source_rgba(cr, 0.0, 0.0, 0.0, 0.35)
    cairo_set_line_width(cr, 1.0)
    cairo_rectangle(cr, 0.5, 0.5, b - 1, h - 1)
    cairo_stroke(cr)
    RETURN TRUE
END FUNCTION

' Der Bestand der Farbliste: aendert er sich, werden die Zeilen neu gebaut
FUNCTION ilFarbBestand$() AS STRING
    DIM t AS STRING : t = ilModus$()
    DIM f AS kern.Farbeintrag
    FOR EACH f IN lwMuster.farben
        t = t + "|" + f.symbol + "/" + f.garn.nummer + "/" + f.garn.name + "/" + HEX$(f.garn.farbe) + IIF(f.auslassen, "/x", "")
    NEXT
    RETURN t
END FUNCTION

SUB ilFarbenBauen()
    adLeeren(ilFarbListe)
    ilFarbTexte = []
    DIM diamant AS BOOLEAN : diamant = ilModus$() = "diamond"
    DIM i AS INTEGER
    FOR i = 0 TO lwMuster.farbanzahl() - 1
        DIM f AS kern.Farbeintrag : f = lwMuster.farben[i]
        DIM z AS INTEGER : z = gtk_box_new(GTK_WAAGERECHT, 6)
        gtkKlasse(z, "farbzeile")
        DIM feld AS INTEGER : feld = gtk_drawing_area_new()
        gtk_widget_set_size_request(feld, 16, 16)
        gtk_widget_set_valign(feld, GTK_AUSRICHTEN_MITTE)
        signalZeichnen(feld, "draw", ilFarbfeld, i, 0, 0)
        gtk_box_pack_start(z, feld, FALSE, FALSE, 0)
        IF NOT diamant THEN
            DIM sy AS INTEGER : sy = gtk_label_new(f.symbol)
            gtk_widget_set_size_request(sy, 16, -1)
            gtk_box_pack_start(z, sy, FALSE, FALSE, 0)
        END IF
        DIM nr AS INTEGER : nr = gtk_label_new(IIF(f.garn.nummer = "", "—", f.garn.nummer))
        gtkKlasse(nr, IIF(diamant, "ikwert", "nebensache"))
        gtk_widget_set_size_request(nr, IIF(diamant, 48, 38), -1)
        gtk_label_set_xalign(nr, 0.0)
        gtk_box_pack_start(z, nr, FALSE, FALSE, 0)
        DIM name AS STRING : name = f.garn.name
        IF LEN(name) > 16 THEN name = LEFT$(name, 15) + "…"
        DIM nl AS INTEGER : nl = gtk_label_new("")
        gtk_label_set_markup(nl, IIF(f.auslassen, "<s>" + ilMaske$(name) + "</s>", ilMaske$(name)))
        gtk_label_set_xalign(nl, 0.0)
        gtk_label_set_ellipsize(nl, GTK_ELLIPSE_ENDE)
        gtk_widget_set_hexpand(nl, TRUE)
        gtk_box_pack_start(z, nl, TRUE, TRUE, 0)
        DIM wl AS INTEGER : wl = gtk_label_new("")
        gtkKlasse(wl, IIF(f.auslassen, "warnung", "nebensache"))
        gtk_box_pack_end(z, wl, FALSE, FALSE, 0)
        gtk_widget_set_tooltip_text(z, f.garn.name + CHR$(10) + IIF(TRIM$(f.garn.hersteller + " " + f.garn.nummer) = "", "—", TRIM$(f.garn.hersteller + " " + f.garn.nummer)) + CHR$(10) + _
            IIF(diamant, "", "Symbol: " + f.symbol + CHR$(10)) + IIF(diamant, "Drills: ", "Stiche: ") + STR$(f.stichzahl) + IIF(f.auslassen, CHR$(10) + "Wird nicht gestickt", ""))
        gtk_list_box_insert(ilFarbListe, z, -1)
        ARRAY_PUSH(ilFarbTexte, wl)
    NEXT
    IF lwMuster.farbanzahl() = 0 THEN
        DIM leer AS INTEGER : leer = gtk_label_new("Keine Farben")
        gtkKlasse(leer, "nebensache")
        gtk_list_box_insert(ilFarbListe, leer, -1)
    END IF
    gtk_widget_show_all(ilFarbListe)
END SUB

SUB ilStoffeFuellen()
    ' Die gaengigen Zaehlungen; eine andere des Musters (10 im Diamond-Modus,
    ' aus OXS) an ihrer Stelle dazu -- PySticky zeigte dann 11 ct an
    DIM liste AS ARRAY OF FLOAT : liste = []
    DIM st AS INTEGER
    DIM dabei AS BOOLEAN
    FOR EACH st IN kern.stoffzaehlungen()
        IF NOT dabei AND lwMuster.stoff < st THEN ARRAY_PUSH(liste, lwMuster.stoff)
        IF lwMuster.stoff <= st THEN dabei = TRUE
        ARRAY_PUSH(liste, st * 1.0)
    NEXT
    IF NOT dabei THEN ARRAY_PUSH(liste, lwMuster.stoff)
    DIM gleich AS BOOLEAN : gleich = LEN(liste) = LEN(ilStoffe)
    DIM i AS INTEGER
    IF gleich THEN
        FOR i = 0 TO LEN(liste) - 1
            IF liste[i] <> ilStoffe[i] THEN gleich = FALSE
        NEXT
    END IF
    ilSperre = TRUE
    IF NOT gleich THEN
        gtk_combo_box_text_remove_all(ilStoff)
        FOR i = 0 TO LEN(liste) - 1
            gtk_combo_box_text_append_text(ilStoff, IIF(liste[i] = INT(liste[i]), STR$(INT(liste[i])), FORMAT$(liste[i], "%.1f")) + " ct Aida")
        NEXT
        ilStoffe = liste
    END IF
    FOR i = 0 TO LEN(ilStoffe) - 1
        IF ilStoffe[i] = lwMuster.stoff AND gtk_combo_box_get_active(ilStoff) <> i THEN gtk_combo_box_set_active(ilStoff, i)
    NEXT
    ilSperre = FALSE
END SUB

SUB ilStoffGeaendert(wahl AS INTEGER, daten AS INTEGER)
    IF ilSperre OR NOT lwHat THEN RETURN
    DIM i AS INTEGER : i = gtk_combo_box_get_active(ilStoff)
    IF i < 0 OR i >= LEN(ilStoffe) THEN RETURN
    stoffAendern(ilStoffe[i])
END SUB

SUB stoffAendern(stoff AS FLOAT)
    IF NOT lwHat THEN RETURN
    IF kern.stoffSetzen(lwMuster, wzVerlauf, stoff) THEN
        nachAenderung()
        statusMeldung("Stoff: " + IIF(stoff = INT(stoff), STR$(INT(stoff)), FORMAT$(stoff, "%.1f")) + " ct")
    END IF
END SUB

SUB infoleisteNachziehen()
    IF ilSeite = 0 OR NOT lwHat THEN RETURN
    ilStoffeFuellen()
    DIM k AS ARRAY OF STRING : k = kern.infoKarten(lwMuster, ilModus$())
    DIM i AS INTEGER
    FOR i = 0 TO LEN(k) - 1
        IF ilStand[i] <> k[i] THEN
            gtk_label_set_text(ilKarten[i], k[i])
            ilStand[i] = k[i]
        END IF
    NEXT
    gtk_widget_set_tooltip_text(ilSchwierig, kern.schwierigkeitTipp$(kern.schwierigkeitVon(lwMuster)))
    ' Quellbild
    IF lwMuster.quellBild = "" THEN
        gtk_widget_hide(ilQuelle)
    ELSE
        DIM da AS BOOLEAN : da = FILEEXISTS(lwMuster.quellBild)
        gtk_label_set_markup(ilQuelleText, ilMaske$(BASENAME(lwMuster.quellBild)) + IIF(da, "  <span foreground='#40c870'><b>✓</b></span>", "  <span foreground='#e0b040'><b>⚠</b></span>"))
        gtk_widget_set_tooltip_text(ilQuelle, "Importiert von:" + CHR$(10) + lwMuster.quellBild + CHR$(10) + IIF(da, "✓ Datei vorhanden", "⚠ Datei nicht gefunden") + CHR$(10) + "Palette: " + IIF(lwMuster.quellPalette = "", "—", lwMuster.quellPalette))
        gtk_widget_show(ilQuelle)
        gtk_widget_show_all(ilQuelle)
    END IF
    ' Farben
    DIM b AS STRING : b = ilFarbBestand$()
    IF b <> ilFarbStand THEN
        ilFarbenBauen()
        ilFarbStand = b
        infoleisteFarbeMarkieren()
    END IF
    DIM modus AS STRING : modus = ilModus$()
    FOR i = 0 TO MIN(LEN(ilFarbTexte), lwMuster.farbanzahl()) - 1
        DIM t AS STRING : t = kern.farbeInfoText$(lwMuster, i, modus)
        IF gtk_label_get_text(ilFarbTexte[i]) <> t THEN gtk_label_set_text(ilFarbTexte[i], t)
    NEXT
END SUB

SUB infoleisteFarbeMarkieren()
    IF ilFarbListe = 0 OR NOT lwHat THEN RETURN
    ilSperre = TRUE
    IF wzFarbe >= 0 AND wzFarbe < LEN(ilFarbTexte) THEN
        DIM z AS INTEGER : z = gtk_list_box_get_row_at_index(ilFarbListe, wzFarbe)
        IF z <> 0 THEN gtk_list_box_select_row(ilFarbListe, z)
    ELSE
        gtk_list_box_unselect_all(ilFarbListe)
    END IF
    ilSperre = FALSE
END SUB

SUB ilFarbeGewaehlt(liste AS INTEGER, zeile AS INTEGER, daten AS INTEGER)
    IF ilSperre OR zeile = 0 OR NOT lwHat THEN RETURN
    DIM i AS INTEGER : i = gtk_list_box_row_get_index(zeile)
    IF i < lwMuster.farbanzahl() THEN farbeWaehlen(i)
END SUB

' --- Fortschritt -----------------------------------------------------------------------

FUNCTION fortschrittleisteNeu() AS INTEGER
    fsSeite = gtk_box_new(GTK_SENKRECHT, 2)
    fsModus = gtk_button_new_with_label("")
    gtkKlasse(fsModus, "fs-modus")
    gtkKlasse(fsModus, "innen")
    gtk_widget_set_can_focus(fsModus, FALSE)
    tipp(fsModus, "Konzentrierter Modus zum Sticken: Klick auf Zelle = abhaken ({wz_fortschritt})")
    signal(fsModus, "clicked", fsModusGeklickt, 0, 0, 0)
    gtk_box_pack_start(fsSeite, fsModus, FALSE, FALSE, 8)
    gtk_box_pack_start(fsSeite, slUeberschrift("Fortschritt"), FALSE, FALSE, 0)
    fsBalken = gtk_progress_bar_new()
    gtk_progress_bar_set_show_text(fsBalken, TRUE)
    gtkKlasse(fsBalken, "innen")
    gtkKlasse(fsBalken, "fs-gesamt")
    gtk_box_pack_start(fsSeite, fsBalken, FALSE, FALSE, 0)
    fsZahl = gtk_label_new("0 / 0 Stiche")
    gtkKlasse(fsZahl, "nebensache")
    gtk_box_pack_start(fsSeite, fsZahl, FALSE, FALSE, 2)
    gtk_box_pack_start(fsSeite, slUeberschrift("Pro Farbe"), FALSE, FALSE, 0)
    fsListe = gtk_box_new(GTK_SENKRECHT, 4)
    gtkKlasse(fsListe, "innen")
    gtk_box_pack_start(fsSeite, fsListe, FALSE, FALSE, 0)
    DIM zk AS INTEGER : zk = slKnopf("Fortschritt zurücksetzen", "Alle Stiche wieder als offen -- ein Schritt, Rückgängig holt ihn zurück")
    gtkKlasse(zk, "innen")
    signal(zk, "clicked", fsZuruecksetzenGeklickt, 0, 0, 0)
    gtk_box_pack_start(fsSeite, zk, FALSE, FALSE, 10)
    fsStand = "-"
    fsVorher = WZ_STIFT
    fortschrittModusNachziehen()
    RETURN fsSeite
END FUNCTION

SUB fortschrittModusNachziehen()
    IF fsModus = 0 THEN RETURN
    DIM an AS BOOLEAN : an = wzAktiv = WZ_FORTSCHRITT
    DIM t AS STRING : t = IIF(an, "◼  Sticken-Modus beenden", "✓  Sticken-Modus starten")
    IF fsModusText <> t THEN
        gtk_button_set_label(fsModus, t)
        fsModusText = t
    END IF
    IF an THEN gtkKlasse(fsModus, "fs-an") ELSE gtkKlasseWeg(fsModus, "fs-an")
END SUB

SUB fsModusGeklickt(knopf AS INTEGER, daten AS INTEGER)
    stickenModusUmschalten()
END SUB

' Sticken-Modus = das Fortschritts-Werkzeug; beenden kehrt zum Werkzeug davor zurueck
SUB stickenModusUmschalten()
    IF NOT lwHat THEN RETURN
    IF wzAktiv = WZ_FORTSCHRITT THEN
        werkzeugWaehlen(IIF(fsVorher = WZ_FORTSCHRITT, WZ_STIFT, fsVorher), FALSE)
    ELSE
        fsVorher = wzAktiv
        werkzeugWaehlen(WZ_FORTSCHRITT, FALSE)
    END IF
END SUB

' Der Bestand der Zeilen: welche Farben (mit Stichen) und ob fertig
FUNCTION fsBestand$(p AS kern.Fortschritt) AS STRING
    DIM t AS STRING : t = ilModus$()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(p.farbeGesamt) - 1
        IF p.farbeGesamt[i] = 0 THEN CONTINUE
        t = t + "|" + STR$(i) + "/" + lwMuster.farben[i].symbol + "/" + HEX$(lwMuster.farben[i].garn.farbe) + "/" + lwMuster.farben[i].garn.name + IIF(p.farbeErledigt[i] = p.farbeGesamt[i], "/fertig", "")
    NEXT
    RETURN t
END FUNCTION

SUB fsZeilenBauen(p AS kern.Fortschritt)
    DIM w AS INTEGER
    FOR EACH w IN fsZeilen
        gtk_widget_destroy(w)
    NEXT
    fsZeilen = []
    fsNr = [] : fsProzent = [] : fsBalkenJe = [] : fsZahlJe = []
    DIM diamant AS BOOLEAN : diamant = ilModus$() = "diamond"
    DIM i AS INTEGER
    FOR i = 0 TO LEN(p.farbeGesamt) - 1
        IF p.farbeGesamt[i] = 0 THEN CONTINUE
        DIM f AS kern.Farbeintrag : f = lwMuster.farben[i]
        DIM zeile AS INTEGER : zeile = gtk_box_new(GTK_SENKRECHT, 2)
        gtkKlasse(zeile, "fs-zeile")
        DIM oben AS INTEGER : oben = gtk_box_new(GTK_WAAGERECHT, 6)
        DIM feld AS INTEGER : feld = gtk_drawing_area_new()
        gtk_widget_set_size_request(feld, 14, 14)
        gtk_widget_set_valign(feld, GTK_AUSRICHTEN_MITTE)
        signalZeichnen(feld, "draw", ilFarbfeld, i, 0, 0)
        gtk_box_pack_start(oben, feld, FALSE, FALSE, 0)
        IF NOT diamant THEN gtk_box_pack_start(oben, gtk_label_new(f.symbol), FALSE, FALSE, 0)
        DIM nl AS INTEGER : nl = gtk_label_new(f.garn.name)
        gtk_label_set_xalign(nl, 0.0)
        gtk_label_set_ellipsize(nl, GTK_ELLIPSE_ENDE)
        gtk_widget_set_hexpand(nl, TRUE)
        gtk_box_pack_start(oben, nl, TRUE, TRUE, 0)
        DIM pl AS INTEGER : pl = gtk_label_new("")
        gtkKlasse(pl, IIF(p.farbeErledigt[i] = p.farbeGesamt[i], "erfolg", "ikwert"))
        gtk_box_pack_end(oben, pl, FALSE, FALSE, 0)
        gtk_box_pack_start(zeile, oben, FALSE, FALSE, 0)
        DIM unten AS INTEGER : unten = gtk_box_new(GTK_WAAGERECHT, 6)
        DIM bk AS INTEGER : bk = gtk_progress_bar_new()
        gtkKlasse(bk, "fs-klein")
        gtk_widget_set_valign(bk, GTK_AUSRICHTEN_MITTE)
        gtk_widget_set_hexpand(bk, TRUE)
        gtk_box_pack_start(unten, bk, TRUE, TRUE, 0)
        DIM zl AS INTEGER : zl = gtk_label_new("")
        gtkKlasse(zl, "nebensache")
        gtk_box_pack_start(unten, zl, FALSE, FALSE, 0)
        IF p.farbeErledigt[i] < p.farbeGesamt[i] THEN
            DIM ak AS INTEGER : ak = slKnopf("✓ Alle erledigt", "Alle " + STR$(p.farbeGesamt[i] - p.farbeErledigt[i]) + " verbleibenden Stiche dieser Farbe als gestickt markieren.")
            signal(ak, "clicked", fsAlleGeklickt, i, 0, 0)
            gtk_box_pack_start(unten, ak, FALSE, FALSE, 0)
        END IF
        gtk_box_pack_start(zeile, unten, FALSE, FALSE, 0)
        gtk_box_pack_start(fsListe, zeile, FALSE, FALSE, 0)
        ARRAY_PUSH(fsZeilen, zeile)
        ARRAY_PUSH(fsNr, i)
        ARRAY_PUSH(fsProzent, pl)
        ARRAY_PUSH(fsBalkenJe, bk)
        ARRAY_PUSH(fsZahlJe, zl)
    NEXT
    IF LEN(fsNr) = 0 THEN
        DIM leer AS INTEGER : leer = gtk_label_new("Noch keine Stiche")
        gtkKlasse(leer, "nebensache")
        gtk_box_pack_start(fsListe, leer, FALSE, FALSE, 4)
        ARRAY_PUSH(fsZeilen, leer)
    END IF
    gtk_widget_show_all(fsListe)
END SUB

SUB fortschrittleisteNachziehen()
    IF fsSeite = 0 OR NOT lwHat THEN RETURN
    fortschrittModusNachziehen()
    DIM p AS kern.Fortschritt : p = kern.fortschrittVon(lwMuster)
    gtk_progress_bar_set_fraction(fsBalken, p.prozent / 100.0)
    gtk_progress_bar_set_text(fsBalken, FORMAT$(p.prozent, "%.1f") + " %")
    gtk_label_set_text(fsZahl, ZAHL$(p.erledigt, 0) + " / " + ZAHL$(p.gesamt, 0) + " Stiche")
    DIM b AS STRING : b = fsBestand$(p)
    IF b <> fsStand THEN
        fsZeilenBauen(p)
        fsStand = b
    END IF
    DIM k AS INTEGER
    FOR k = 0 TO LEN(fsNr) - 1
        DIM i AS INTEGER : i = fsNr[k]
        gtk_label_set_text(fsProzent[k], kern.farbeProzentText$(p, i))
        gtk_progress_bar_set_fraction(fsBalkenJe[k], p.farbeProzent[i] / 100.0)
        gtk_label_set_text(fsZahlJe[k], STR$(p.farbeErledigt[i]) + "/" + STR$(p.farbeGesamt[i]))
    NEXT
END SUB

SUB fsAlleGeklickt(knopf AS INTEGER, nr AS INTEGER)
    farbeAlsErledigtNr(nr)
END SUB

SUB farbeAlsErledigtNr(nr AS INTEGER)
    IF NOT lwHat OR nr < 0 OR nr >= lwMuster.farbanzahl() THEN RETURN
    DIM n AS INTEGER : n = kern.farbeErledigt(lwMuster, wzVerlauf, nr)
    leinwandAufbauen()
    gtk_widget_queue_draw(lwFlaeche)
    nachAenderung()
    statusMeldung("Farbe „" + lwMuster.farben[nr].garn.name + "“ komplett als erledigt markiert (" + STR$(n) + " Stiche).")
END SUB

SUB fsZuruecksetzenGeklickt(knopf AS INTEGER, daten AS INTEGER)
    fortschrittZuruecksetzen(TRUE)
END SUB

SUB fortschrittZuruecksetzen(fragen AS BOOLEAN)
    IF NOT lwHat THEN RETURN
    ' gezaehlt auch bei ausgelassenen Farben (die Gesamtzahl laesst sie weg)
    DIM p AS kern.Fortschritt : p = kern.fortschrittVon(lwMuster)
    DIM erl AS INTEGER, z AS INTEGER
    FOR EACH z IN p.farbeErledigt
        erl = erl + z
    NEXT
    IF erl = 0 THEN
        statusMeldung("Kein Fortschritt zum Zurücksetzen.")
        RETURN
    END IF
    IF fragen THEN
        IF NOT pdFrage(fenster, "Fortschritt zurücksetzen", "Gesamten Stickfortschritt zurücksetzen?" + CHR$(10) + "Bearbeiten → Rückgängig holt ihn zurück.") THEN RETURN
    END IF
    DIM n AS INTEGER : n = kern.fortschrittZuruecksetzen(lwMuster, wzVerlauf)
    leinwandAufbauen()
    gtk_widget_queue_draw(lwFlaeche)
    nachAenderung()
    statusMeldung("Fortschritt zurückgesetzt (" + ZAHL$(n, 0) + " Stiche).")
END SUB
