=== text in einer funktion
FUNCTION wiederholt(t AS STRING, n AS INTEGER) AS STRING
    DIM r AS STRING
    DIM i AS INTEGER
    FOR i = 1 TO n
        r = r + t
        IF LEN(r) > 20 THEN r = MID$(r, 1, 10)
    NEXT
    RETURN r
END FUNCTION
PRINT wiederholt("abc", 30); " "; wiederholt("x", 3)
--- umgebung
DHRT_JIT=aus
--- erwartet
