' Kapitel 14 -- vor dem ersten Fenster: eine leere Mediathek bekommt
' ihre Beispiele. Seit Kapitel 20 dazu das Aussehen: ein Thema und die
' Stildatei des Projekts.
CLASS App EXTENDS StudioApp
    SUB Geoeffnet()
        ' >>> neu
        ' mediathek --gross: alles anderthalbmal so gross. Der Massstab
        ' kommt vor dem ersten Fenster -- spaeter laesst die gui ihn
        ' nicht mehr aendern.
        DIM i AS INTEGER
        FOR i = 0 TO ARGC() - 1
            IF ARG$(i) = "--gross" THEN GUI_SCALE(1.5)
        NEXT
        ' <<< neu
        GUI_THEME_PRESET("modern_dark")
        StilLaden("mediathek.dhstil")
        einrichten()
    END SUB
END CLASS
