=== probe: der dialog, strategie, tooltip, zoom, vergleich und exporte
IMPORT "helfer.dh"
' --probe-stufe7: Glutfaden oeffnet das Beispielmuster und den Stickpfad-
' Dialog, waehlt den naechsten Nachbarn, fragt den Tooltip ueber Stich 3 der
' zweiten Farbe ab, zoomt mit Nummern, vergleicht bei 18 ct und exportiert
' Text, ein Bild und alle Bilder; dann der Schalter im Export-Dialog.
dlStarten(["run", BEISPIEL, "--", "--probe-stufe7", "--foto", "d"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    PRINT "fotos: "; FILEEXISTS("d_stickpfad.png"); " "; FILEEXISTS("d_stickpfad_nummern.png"); " "; FILEEXISTS("d_stickpfad_vergleich.png")
    PRINT "plan wie kern: "; geLies$("d_plan.txt") = kern.stickplanText$(kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs"), kern.stickpfadBerechnen(kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs"), kern.SP_NACHBAR, 18))
END IF
