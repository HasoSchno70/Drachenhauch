=== spalte stapelt und dehnt quer
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM s AS GUI_WIDGET : s = GUI_LAYOUT(w, "spalte", 20, 20, 200, 300)
GUI_LAYOUT_SET(s, "abstand", 4)
DIM l AS GUI_WIDGET : l = GUI_LABEL(w, "Name", 0, 0)
DIM t AS GUI_WIDGET : t = GUI_TEXTINPUT(w, 0, 0, 0, 0)
DIM f AS GUI_WIDGET : f = GUI_TEXTAREA(w, 0, 0, 50, 50)
GUI_LAYOUT_ADD(s, l) : GUI_LAYOUT_ADD(s, t) : GUI_LAYOUT_ADD(s, f, 1)
GUI_UPDATE()
PRINT GUI_GET_X(l) ; " " ; GUI_GET_Y(l) ; " " ; GUI_GET_W(l) ; " " ; GUI_GET_H(l)
PRINT GUI_GET_X(t) ; " " ; GUI_GET_Y(t) ; " " ; GUI_GET_W(t) ; " " ; GUI_GET_H(t)
PRINT GUI_GET_X(f) ; " " ; GUI_GET_Y(f) ; " " ; GUI_GET_W(f) ; " " ; GUI_GET_H(f)
