' Default-Werte: Parameter mit Vorbelegung.
'
' Wer den Default akzeptiert, gibt das Argument einfach nicht an.

SUB Greet(name AS STRING, prefix AS STRING = "Hallo")
    PRINT prefix + ", " + name + "!"
END SUB

Greet("Pilot")            ' Default greift -> "Hallo, Pilot!"
Greet("Captain", "Hi")    ' explizit                     -> "Hi, Captain!"

' Defaults duerfen sich auf vorhergehende Parameter beziehen
SUB BoxOf(width AS INTEGER, height AS INTEGER = width)
    PRINT f"Box {width}x{height}"
END SUB

PRINT ""
BoxOf(50)         ' height = width = 50  (Quadrat)
BoxOf(50, 30)     ' height explizit 30
