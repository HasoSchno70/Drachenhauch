WRITEALL("anders.dh", !"ASSERT(1 + 1 = 2, \"Addition\")\n")
dlStarten(["test", CWD$() + "/anders.dh"])
PRINT "rueckgabe "; dlCode
PRINT "bilanz "; (INSTR(dlAus, "1 Datei(en), 1 ok") >= 0)
