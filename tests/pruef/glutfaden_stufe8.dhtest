--- erwartet
gleich (101 Zeilen)
csv byte-gleich: TRUE

=== analyse: diamond-modus -- drills als grundform, csv ohne straenge
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")

m.modus = "diamond"
PRINT geAbweichungen$(geLies$("ref.txt"), analyseText$(m))
WRITEALL("aus.csv", kern.statistikCsv$(m, 14, 20, 1.5))
PRINT "csv byte-gleich: "; BUFFER_TO_STRING$(READALL_BYTES("aus.csv")) = BUFFER_TO_STRING$(READALL_BYTES("ref.csv"))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_analyse.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
