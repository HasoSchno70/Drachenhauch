' Glutfaden Stufe 21: Muster aus XSD/PAT/OXS mit Vorschau importieren
' (ansicht/fremdimport.dh, kern.fremdLaden), weitere Bildformate ueber GTKs
' Bildlader (ansicht/importdialog.dh), Zoom-Regler in der Statusleiste und
' das helle Erscheinungsbild (kern.themaTafel, Einstellung theme).
'
' Der erste Fall ist gegen PySticky aufgezeichnet: drei OXS-Dateien aus
' Glutfadens Schreiber und zwei kaputte durch import_oxs/import_pat -- Name,
' Groesse, Farben, Stiche ueber alle Ebenen, Formatname und Zentimeter, so
' wie PatternImportDialog sie zeigt. PAT und XSD nicht: PyStickys Leser lesen
' keine echte Datei (Stufe 6); sie stehen im zweiten Fall an den Dateien aus
' Stufe 6. Danach die Probe.

=== fremde muster wie pysticky
IMPORT "helfer.dh"
' PyStickys PAT- und XSD-Leser lesen keine echte Datei (Stufe 6) -- verglichen
' wird darum an OXS: drei Muster durch Glutfadens Schreiber, dazu kaputte
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(GLUTORDNER + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = ["A", "B", "C", "D"]
kern.oxsSpeichern(kern.pxsLaden("alle.pxs"), "probe.oxs")
kern.oxsSpeichern(kern.pxsLaden("farbprobe.pxs"), "farbe.oxs")
kern.oxsSpeichern(kern.pxsLaden(GLUTORDNER + "/daten/muster/demo_kreuzstich.pxs"), "demo.oxs")
WRITEALL("kaputt.oxs", "<chart><format")
WRITEALL("kaputt.pat", "PCStitch? nein")
DIM pfad AS STRING
FOR EACH pfad IN ["probe.oxs", "farbe.oxs", "demo.oxs", "kaputt.oxs", "kaputt.pat"]
    TRY
        DIM f AS kern.MusterImport : f = kern.fremdLaden(pfad, pal, sym)
        DIM m AS kern.Muster : m = f.muster
        PRINT pfad; ": "; m.name; " | "; m.breite; "x"; m.hoehe; " | farben "; m.farbanzahl(); " | stiche "; kern.statistikVon(m).sticheGesamt; " | "; f.format; " | "; FORMAT$(m.breiteCm(), "%.1f"); " x "; FORMAT$(m.hoeheCm(), "%.1f"); " cm"
    CATCH e
        PRINT pfad; ": fehler"
    END TRY
NEXT
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_pat.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_xsd.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
CONST GLUTORDNER = "{sammlung}/../../examples/glutfaden"
