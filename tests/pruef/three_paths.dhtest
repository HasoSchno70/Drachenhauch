=== foreach var named each still regular
DIM s AS INTEGER
s = 0
FOR each = 1 TO 3
  s = s + each
NEXT
PRINT s
--- erwartet
6

=== select guards
DIM hp AS INTEGER
hp = 20
DIM trank AS BOOLEAN
trank = TRUE
SELECT CASE hp
  CASE IS <= 0
    PRINT "tot"
  CASE IS <= 30 WHERE trank
    PRINT "heilen"
  CASE IS <= 30
    PRINT "fliehen"
  CASE ELSE
    PRINT "ok"
END SELECT
--- erwartet
heilen

