--- datei klein.json
{"format":"dhscore-song","version":1,"bpm":120,"tracks":[{"name":"Lied","clef":"treble","notes":[{"start":0.0,"dur":1.0,"pitch":60},{"start":0.0,"dur":1.0,"pitch":64},{"start":0.0,"dur":1.0,"pitch":67},{"start":1.3,"dur":0.5,"pitch":62},{"start":3.9,"dur":0.1,"pitch":65}]}]}
--- nachher
DIM z AS STRING
FOR EACH z IN READLINES("_programm/score.log")
    IF LEFT$(z, 7) = "warnung" OR LEFT$(z, 7) = "tracker" THEN PRINT z
NEXT
PRINT "datei "; FILEEXISTS("klein_tracker.json")
--- erwartet
warnung Spur 1 (Lied), Zeile 0 (Beats 0, 0, 0): Akkord auf hoechste Note reduziert (Tracker-Kanal ist einstimmig)
warnung Spur 1 (Lied), Note bei Beat 1.3: auf die naechste Tracker-Zeile gerundet
warnung Spur 1 (Lied), Note bei Beat 3.9: auf die naechste Tracker-Zeile gerundet
warnung Spur 1 (Lied), Note bei Beat 3.9: fiel aus dem Song heraus, uebersprungen
tracker abgebrochen
datei FALSE

=== tracker trotz warnung schreibt das gitter des konverters
' Derselbe Fall mit Enter = "Trotzdem oeffnen": die Datei entsteht, und ihr
' Kanal 0 ist Zelle fuer Zelle der von to_tracker_song (Akkord -> 67, die
' Note bei 3.9 fehlt, NOTE_OFF = -1, leer = null).
AUTOMATION_PLAY("ev.txt")
--- programm ../../examples/199_notenblatt.dh nach SETFPS(60)
--- streichen WINDOW_MAXIMIZE()
--- argumente
klein.json
--- umgebung
DHRT_FRAMES=60
DH_SCORE_LOG=score.log
--- datei _programm/ev.txt
c 6
e 20 2 341 0 0 0
e 20 2 84 0 0 0
e 22 1 84 0 0 0
e 22 1 341 0 0 0
e 30 2 257 0 0 0
e 32 1 257 0 0 0

--- datei klein.json
{"format":"dhscore-song","version":1,"bpm":120,"tracks":[{"name":"Lied","clef":"treble","notes":[{"start":0.0,"dur":1.0,"pitch":60},{"start":0.0,"dur":1.0,"pitch":64},{"start":0.0,"dur":1.0,"pitch":67},{"start":1.3,"dur":0.5,"pitch":62},{"start":3.9,"dur":0.1,"pitch":65}]}]}
--- nachher
IMPORT "json"
DIM h AS JSON_HANDLE : h = JSON_LOAD("klein_tracker.json")
DIM zeile AS STRING : zeile = ""
DIM r AS INTEGER
FOR r = 0 TO JSON_GET_INT(h, "patterns.0.rows") - 1
    DIM pf AS STRING : pf = "patterns.0.data.0." + STR$(r)
    IF r > 0 THEN zeile = zeile + ","
    IF JSON_TYPE(h, pf) = "null" THEN zeile = zeile + "." ELSE zeile = zeile + STR$(JSON_GET_INT(h, pf))
NEXT
PRINT zeile
--- erwartet
67,.,.,.,-1,62,.,-1,.,.,.,.,.,.,.,.

=== neu mit ungesicherten noten fragt und esc behaelt sie
' Eine Note setzen, dann Strg+N: der Kasten "Sichern|Verwerfen|Abbrechen"
' geht auf, ESC = Abbrechen -- die Note bleibt (bis 2026-09-21 warf [Neu] sie
' wortlos weg). Gezeigt wird das Protokoll ab der gesetzten Note; "noten"
' schreibt das Programm beim Ende.
AUTOMATION_PLAY("ev.txt")
--- programm ../../examples/199_notenblatt.dh nach SETFPS(60)
--- streichen WINDOW_MAXIMIZE()
--- argumente
neu.json
--- umgebung
DHRT_FRAMES=90
DH_SCORE_LOG=score.log
--- datei _programm/ev.txt
c 10
e 20 7 454 162 0 0
e 21 7 454 162 0 0
e 21 6 0 0 0 0
e 23 5 0 0 0 0
e 40 2 341 0 0 0
e 40 2 78 0 0 0
e 42 1 78 0 0 0
e 42 1 341 0 0 0
e 60 2 256 0 0 0
e 62 1 256 0 0 0

--- nachher
DIM z AS STRING
DIM ab AS BOOLEAN : ab = FALSE
FOR EACH z IN READLINES("_programm/score.log")
    IF LEFT$(z, 5) = "note " THEN ab = TRUE
    IF ab AND (LEFT$(z, 5) = "note " OR LEFT$(z, 5) = "frage" OR LEFT$(z, 5) = "neues" OR LEFT$(z, 5) = "noten") THEN PRINT z
NEXT
--- erwartet
note 0 2 71 1
frage neu
frage abgebrochen
noten 1

=== neu mit ungesicherten noten und verwerfen leert das blatt
' Wie oben, im Kasten aber Tab auf den zweiten Knopf ("Verwerfen") und Enter:
' jetzt entsteht das neue, leere Stueck.
AUTOMATION_PLAY("ev.txt")
