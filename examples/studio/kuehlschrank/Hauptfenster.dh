' Das Hauptfenster: Werkzeugleiste, Kopf mit drei Kennzahlen und dem Knopf
' „Einkauf erfassen“, die fünf Reiter (Bestand, Lagerorte, Einkauf,
' Statistik, Rezepte) und die Statusleiste mit Uhr. Der Timer auffrischen
' holt alle 30 Sekunden die Zahlen neu wie in der Python-App. Die Reiter sind
' eigene Controls; was sie melden (Geaendert, Bearbeiten ...), landet hier.
CLASS Hauptfenster EXTENDS Hauptfenster_Basis

    SUB Geoeffnet()
        Self.nochNichtDa()
        Self.bestand.laden()
        Self.orte.laden()
        Self.einkauf.laden()
        Self.rezepte.laden()
        Self.auffrischen()
        Self.uhr_Aktion()
    END SUB

    ' Kopf, Statusleiste, Statistik und Rückgängig neu aus der Datenbank.
    SUB auffrischen()
        DIM k AS Kennzahlen : k = NEW Kennzahlen()
        k.rechnen()
        GUI_CARD_SET_TEXT(Self.kachelGesamt, STR$(k.gesamt))
        GUI_CARD_SET_TEXT(Self.kachelBald, STR$(k.bald))
        GUI_CARD_SET_TEXT(Self.kachelAbgelaufen, STR$(k.abgelaufen))
        GUI_STATUSBAR_SET(Self.status, 1, "Produkte: " + STR$(k.produkte))
        GUI_STATUSBAR_SET(Self.status, 2, "Zuletzt: " + LEFT$(TIME$(), 5))
        Self.statistik.laden()
        Self.verlaufZeigen()
    END SUB

    ' Rückgängig und Wiederholen: an, solange es etwas gibt, mit Tipp.
    SUB verlaufZeigen()
        GUI_TOOLBAR_ENABLE(Self.werkzeuge, KNOPF_RUECKGAENGIG, verlauf.kannZurueck())
        GUI_TOOLBAR_ENABLE(Self.werkzeuge, KNOPF_WIEDERHOLEN, verlauf.kannVor())
        GUI_TOOLBAR_SET_TIP(Self.werkzeuge, KNOPF_RUECKGAENGIG, IIF(verlauf.kannZurueck(), "Rückgängig: " + verlauf.textZurueck$() + " (Strg+Z)", "Nichts rückgängig zu machen"))
        GUI_TOOLBAR_SET_TIP(Self.werkzeuge, KNOPF_WIEDERHOLEN, IIF(verlauf.kannVor(), "Wiederholen: " + verlauf.textVor$() + " (Strg+Y)", "Nichts zu wiederholen"))
        GUI_MENU_ENABLE(Self.miRueckgaengig, verlauf.kannZurueck())
        GUI_MENU_ENABLE(Self.miWiederholen, verlauf.kannVor())
    END SUB

    ' Was erst mit einer späteren Stufe kommt, ist gesperrt statt stumm.
    SUB nochNichtDa()
        GUI_TOOLBAR_ENABLE(Self.werkzeuge, KNOPF_EINSTELLUNGEN, FALSE)
        GUI_SET_ENABLED(Self.knopfEinkauf, FALSE)
        GUI_MENU_ENABLE(Self.miEinstellungen, FALSE)
    END SUB

    ' Der Vorrat hat sich geändert (im Bestand oder über Rückgängig).
    SUB geaendert()
        Self.bestand.laden()
        Self.orte.laden()
        Self.einkauf.laden()
        Self.rezepte.laden()
        Self.auffrischen()
    END SUB

    SUB bestand_Geaendert()
        Self.orte.laden()
        Self.auffrischen()
    END SUB

    ' Gekocht, angelegt, gelöscht, Fehlendes auf die Liste: alles neu.
    SUB rezepte_Geaendert()
        Self.bestand.laden()
        Self.orte.laden()
        Self.einkauf.laden()
        Self.auffrischen()
    END SUB

    SUB einkauf_Geaendert()
        Self.auffrischen()
    END SUB

    ' Der Einkaufszettel als Bericht: Vorschau mit Drucken und „Als PDF …“.
    ' KUEHL_ZETTEL nennt eine PDF-Datei ohne Vorschau (für Prüfungen).
    SUB einkauf_Drucken()
        DIM w AS MAP OF ANY : w = Self.einkauf.zettelWerte()
        DIM pfad AS STRING : pfad = GETENV$("KUEHL_ZETTEL")
        IF pfad <> "" THEN
            Einkaufszettel.Pdf(pfad, w)
            GUI_STATUSBAR_SET(Self.status, 3, "Einkaufszettel: " + BASENAME(pfad))
            RETURN
        END IF
        Einkaufszettel.Vorschau(w)
    END SUB

    ' Einkauf abschließen: die abgehakten Posten in den Bestand.
    SUB einkauf_Abschliessen()
        DIM f AS AbschlussFenster : f = NEW AbschlussFenster()
        f.vorMarkt = Self.einkauf.markt$()
        f.ZeigenModal()
        IF f.uebertragen = 0 THEN RETURN
        Self.geaendert()
        GUI_TOAST(Self.Fenster(), "✅ " + STR$(f.uebertragen) + " Artikel zum Bestand hinzugefügt!", "erfolg")
    END SUB

    ' Eine Kachel im Reiter Lagerorte: was dort liegt.
    SUB orte_Details()
        DIM f AS LagerortFenster : f = NEW LagerortFenster()
        f.ort = Self.orte.gewaehlterOrt
        f.ZeigenModal()
        IF f.geaendert THEN Self.geaendert()
    END SUB

    ' Der Dialog für einen neuen oder einen gewählten Eintrag.
    SUB bestand_Bearbeiten()
        DIM f AS ProduktFenster : f = NEW ProduktFenster()
        f.eintragId = Self.bestand.bearbeitenId
        f.barcode = Self.bestand.neuBarcode
        f.ZeigenModal()
        IF NOT f.gesichert THEN RETURN
        Self.geaendert()
        GUI_TOAST(Self.Fenster(), IIF(Self.bestand.bearbeitenId = 0, f.e.name + " hinzugefügt.", f.e.name + " gesichert."), "erfolg")
    END SUB

    SUB bestand_Mindestmenge()
        DIM f AS MindestmengeFenster : f = NEW MindestmengeFenster()
        f.eintragId = Self.bestand.mindestId
        f.ZeigenModal()
        IF f.gesichert THEN Self.geaendert()
    END SUB

    SUB bestand_Export()
        Self.miExport_Aktion()
    END SUB

    SUB werkzeuge_Knopf(nr AS INTEGER)
        SELECT CASE nr
            CASE KNOPF_HINZUFUEGEN : Self.miHinzufuegen_Aktion()
            CASE KNOPF_RUECKGAENGIG : Self.miRueckgaengig_Aktion()
            CASE KNOPF_WIEDERHOLEN : Self.miWiederholen_Aktion()
            CASE KNOPF_AKTUALISIEREN : Self.miAktualisieren_Aktion()
            CASE KNOPF_EXPORT : Self.miExport_Aktion()
        END SELECT
    END SUB

    SUB miHinzufuegen_Aktion()
        GUI_TABCONTROL_SET_PAGE(Self.reiter, 0)
        Self.bestand.knopfHinzufuegen_Klick()
    END SUB

    SUB miRueckgaengig_Aktion()
        DIM t AS STRING : t = verlauf.rueckgaengig$()
        IF t = "" THEN RETURN
        Self.geaendert()
        GUI_STATUSBAR_SET(Self.status, 3, "Rückgängig: " + t)
    END SUB

    SUB miWiederholen_Aktion()
        DIM t AS STRING : t = verlauf.wiederholen$()
        IF t = "" THEN RETURN
        Self.geaendert()
        GUI_STATUSBAR_SET(Self.status, 3, "Wiederholt: " + t)
    END SUB

    ' Der Bestand als CSV wie export_inventory_to_csv der Python-App.
    ' KUEHL_EXPORT nennt die Datei ohne Dialog (für Prüfungen).
    SUB miExport_Aktion()
        DIM pfad AS STRING : pfad = GETENV$("KUEHL_EXPORT")
        IF pfad = "" THEN pfad = FILE_SAVE_DIALOG("Bestand exportieren", "bestand.csv", "csv")
        IF pfad = "" THEN RETURN
        DIM n AS INTEGER : n = csvSchreiben(pfad)
        GUI_TOAST(Self.Fenster(), "Exportiert: " + STR$(n) + " Einträge.", "erfolg")
        GUI_STATUSBAR_SET(Self.status, 3, "Exportiert: " + BASENAME(pfad))
    END SUB

    SUB miAktualisieren_Aktion()
        Self.geaendert()
        GUI_STATUSBAR_SET(Self.status, 3, "Aktualisiert.")
    END SUB

    SUB miBeenden_Aktion()
        Self.Zumachen()
    END SUB

    SUB uhr_Aktion()
        GUI_STATUSBAR_SET(Self.status, 4, TIME$())
    END SUB

    SUB auffrischen_Aktion()
        Self.auffrischen()
    END SUB
END CLASS

' Die Knöpfe der Werkzeugleiste (ihre Nummern; Trenner und Lücke zählen mit).
CONST KNOPF_HINZUFUEGEN = 0
CONST KNOPF_RUECKGAENGIG = 1
CONST KNOPF_WIEDERHOLEN = 2
CONST KNOPF_AKTUALISIEREN = 3
CONST KNOPF_EXPORT = 5
CONST KNOPF_EINSTELLUNGEN = 7
