=== schriftgroesse und eine themenfarbe aus der stildatei
' Ein Knopf mit Breite 0 misst seinen Text in jedem Bild: mit groesse 30
' wird er breiter. Eine Themenfarbe folgt dem Thema.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM klein AS GUI_WIDGET : klein = GUI_BUTTON(w, "Breite", 10, 10, 0, 0)
DIM gross AS GUI_WIDGET : gross = GUI_BUTTON(w, "Breite", 10, 60, 0, 0)
GUI_SET_NAME(gross, "titel")
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 120, 100, 30)
GUI_STYLESHEET("#titel { groesse: 30; stil: fett } button { bg: accent }")
PRINT "vorher gleich " + STR$(GUI_GET_W(gross) = GUI_GET_W(klein))
GUI_UPDATE()
GUI_UPDATE()
PRINT "groesser " + STR$(GUI_GET_W(gross) > GUI_GET_W(klein) + 20)
GUI_THEME_SET("accent", &H123456)
GUI_UPDATE()
PRINT "thema " + COLOR_HEX$(GUI_GET_COLOR(b, "bg"))
PRINT "name " + GUI_GET_NAME$(gross)
--- erwartet
vorher gleich TRUE
groesser TRUE
thema #123456
name titel

=== eine stildatei aus einer datei
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 100, 30)
GUI_STYLESHEET_LOAD("thema.dhstil")
GUI_UPDATE()
PRINT COLOR_HEX$(GUI_GET_COLOR(b, "bg")) + " " + COLOR_HEX$(GUI_GET_COLOR(b, "fg"))
--- datei thema.dhstil
// Ein Thema als Datei
button {
    bg: #304050;
    fg: #F0E0D0
}

--- erwartet
#304050 #F0E0D0

=== name und klassen stehen in der dhform
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 100, 30)
GUI_SET_NAME(b, "Speichern")
GUI_ADD_CLASS(b, "gross")
GUI_ADD_CLASS(b, "gefahr")
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
DIM b2 AS GUI_WIDGET : b2 = GUI_WINDOW_WIDGET(w2, 0)
PRINT GUI_GET_NAME$(b2) + " " + STR$(GUI_HAS_CLASS(b2, "gross")) + " " + STR$(GUI_HAS_CLASS(b2, "gefahr")) + " " + STR$(GUI_HAS_CLASS(b2, "klein"))
PRINT "rundweg " + STR$(GUI_TO_JSON(w2) = j)
--- erwartet
speichern TRUE TRUE FALSE
rundweg TRUE

=== fehler in der stildatei nennen die zeile
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 100, 30)
DIM q AS ARRAY OF STRING
q = ["button {" + CHR$(10) + "  farb: #fff" + CHR$(10) + "}", "knopf { bg: #fff }", "button:wackeln { bg: #fff }", "button { bg: rot }", "button { radius: 99 }", "panel button { bg: #fff }", "button { bg: #fff"]
DIM s AS STRING
FOR EACH s IN q
    TRY
        GUI_STYLESHEET(s)
        PRINT "kein fehler"
    CATCH e
        PRINT LEFT$(e, 60)
    END TRY
NEXT
TRY
    GUI_STYLESHEET_LOAD("gibtsnicht.dhstil")
CATCH e
    PRINT LEFT$(e, 58)
END TRY
TRY
    GUI_SET_NAME(b, "mit leer")
CATCH e
    PRINT e
END TRY
TRY
    GUI_ADD_CLASS(b, "")
CATCH e
    PRINT e
END TRY
TRY
    PRINT GUI_GET_COLOR(b, "schatten")
CATCH e
    PRINT e
END TRY
--- erwartet
GUI_STYLESHEET: Zeile 2: Eigenschaft 'farb' gibt es nicht --
GUI_STYLESHEET: Zeile 1: eine Widget-Art 'knopf' gibt es nic
GUI_STYLESHEET: Zeile 1: Zustand ':wackeln' gibt es nicht --
GUI_STYLESHEET: Zeile 1: 'rot' ist keine Farbe -- erwartet #
GUI_STYLESHEET: Zeile 1: radius erwartet eine ganze Zahl 0..
GUI_STYLESHEET: Zeile 1: 'panel button' -- Selektoren fuer N
GUI_STYLESHEET: Zeile 1: '{' ohne '}'
GUI_STYLESHEET_LOAD: 'gibtsnicht.dhstil' laesst sich nicht
GUI_SET_NAME: Name 'mit leer' -- erlaubt sind Buchstaben, Ziffern, _ und -
GUI_ADD_CLASS: Klasse '' -- erlaubt sind Buchstaben, Ziffern, _ und -
GUI_GET_COLOR: Rolle 'schatten' gibt es nicht -- bg, fg, border oder accent
