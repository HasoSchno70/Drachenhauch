=== zurueck und vorwaerts ueber spruenge und dateien
DIM prBild AS INTEGER : prBild = 0
FUNCTION prStelle$() AS STRING
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    RETURN BASENAME(tabPfade[aktiverTab]) + ":" + STR$(z)
END FUNCTION
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 20 THEN GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 3, 1)
' ein kleiner Schritt: kein Sprung
IF prBild = 22 THEN GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 5, 1)
IF prBild = 24 THEN GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 25, 1)
IF prBild = 26 THEN dateiOeffnen(PATHJOIN(projektOrdner, "zwei.dh"))
IF prBild = 28 THEN GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 2, 1)
IF prBild = 30 THEN protokoll("pr jetzt " + prStelle$()) : befehl("nav_zurueck")
IF prBild = 32 THEN protokoll("pr nach 1 " + prStelle$()) : befehl("nav_zurueck")
IF prBild = 34 THEN protokoll("pr nach 2 " + prStelle$()) : befehl("nav_zurueck")
IF prBild = 36 THEN protokoll("pr nach 3 " + prStelle$()) : befehl("nav_zurueck")
IF prBild = 38 THEN protokoll("pr nach 4 " + prStelle$()) : befehl("nav_vor")
IF prBild = 40 THEN protokoll("pr vor 1 " + prStelle$()) : befehl("nav_vor")
IF prBild = 42 THEN protokoll("pr vor 2 " + prStelle$())
' Ein neuer Sprung nimmt die Vorwaerts-Liste weg.
IF prBild = 44 THEN GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 20, 1)
IF prBild = 46 THEN befehl("nav_vor") : protokoll("pr status " + GUI_TEXT(lblStatus))
IF prBild = 48 THEN EXIT(0)
--- argumente
eins.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- vorher
DIM t AS STRING : t = ""
DIM i AS INTEGER
FOR i = 1 TO 30
    t = t + "PRINT " + STR$(i) + CHR$(10)
NEXT
WRITEALL("eins.dh", t)
WRITEALL("zwei.dh", t)
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 4) = "nav " THEN PRINT L[i]
NEXT
--- erwartet
nav gemerkt eins.dh 5
nav gemerkt eins.dh 25
pr jetzt zwei.dh:2
nav zurueck eins.dh 25
pr nach 1 eins.dh:25
nav zurueck eins.dh 5
pr nach 2 eins.dh:5
pr nach 3 eins.dh:5
pr nach 4 eins.dh:5
nav vor eins.dh 25
pr vor 1 eins.dh:25
nav vor zwei.dh 2
pr vor 2 zwei.dh:2
nav gemerkt zwei.dh 2
pr status Keine Stelle zum Vorwärtsgehen.

=== die ausgabe laesst sich filtern und sichern
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 20 THEN befehl("start")
IF prBild = 100 THEN
    GUI_SET_TEXT(tfAusgabeFilter, "APFEL")
END IF
IF prBild = 103 THEN
    ausgabeSichernNach(PATHJOIN(projektOrdner, "gefiltert.txt"))
    GUI_SET_TEXT(tfAusgabeFilter, "")
END IF
IF prBild = 106 THEN
    ausgabeSichernNach(PATHJOIN(projektOrdner, "alles.txt"))
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
PRINT "apfel 1"
PRINT "birne 2"
PRINT "Apfelkuchen 3"

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 15) = "ausgabe filter " OR LEFT$(L[i], 18) = "ausgabe gesichert " THEN PRINT L[i]
NEXT
DIM z AS STRING
FOR EACH z IN READLINES("gefiltert.txt")
    PRINT "gefiltert |"; z
NEXT
FOR EACH z IN READLINES("alles.txt")
    PRINT "alles |"; z
NEXT
--- erwartet
ausgabe filter [APFEL] 2
ausgabe gesichert 2
ausgabe filter [] 3
ausgabe gesichert 3
gefiltert |apfel 1
gefiltert |Apfelkuchen 3
alles |apfel 1
alles |birne 2
alles |Apfelkuchen 3
