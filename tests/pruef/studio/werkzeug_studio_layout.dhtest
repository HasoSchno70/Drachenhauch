=== ein abstandhalter aus der bibliothek kommt zwischen zwei kinder
' Gesucht wird "Abstand" (die Zeile steht sonst weit unten in der Liste),
' dann in die Zeile gezogen und einmal daneben, wo kein Layout ist.
IMPORT "laeufer.dh"
SETENV("DH_STUDIO_ABLAGE", "Abstand")
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 8, CWD$() + "/f.dhform")
DIM qx AS INTEGER
DIM qy AS INTEGER
DIM ax AS INTEGER
DIM ay AS INTEGER
DIM bx AS INTEGER
DIM by AS INTEGER
DIM fx AS INTEGER
DIM fy AS INTEGER
(qx, qy) = slLage(m, "suche")
(ax, ay) = slLage(m, "control knopfA")
(bx, by) = slLage(m, "control knopfB")
(fx, fy) = slLage(m, "fenster")
slHin(10, 10)
slKlick(qx, qy)
slMit([341], 86)
slWarten(30)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(m, CWD$() + "/ev.txt", slBild + 10, CWD$() + "/f.dhform")
DIM kx AS INTEGER
DIM ky AS INTEGER
(kx, ky) = slLage(m, "zeile spacer/Abstand")
slZeilen = [] : slBild = 0
slHin(10, 10)
slKlick(qx, qy)
slMit([341], 86)
slWarten(30)
slZug(kx, ky, (ax + bx) \ 2 + 2, ay, 12, TRUE)
slWarten(8)
slZug(kx, ky, fx + 300, fy + 300, 12, TRUE)
slWarten(8)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, CWD$() + "/f.dhform")
PRINT "neu "; slHat(log, "neu abstand Zeile1 1")
PRINT "ohne layout "; slHat(log, "abstand ohne layout")
DIM b AS ARRAY OF STRING : b = slAnfang(log, "behaelter Zeile1")
PRINT b[LEN(b) - 1]
DIM nx AS INTEGER
DIM ny AS INTEGER
DIM sx AS INTEGER
DIM sy AS INTEGER
(nx, ny) = slLage(log, "control knopfB")
(sx, sy) = slLage(log, "control feldSuche")
' Gewicht 1 nimmt den Rest: knopfB rueckt bis vor das Suchfeld.
PRINT "nach rechts geschoben "; nx > bx + 100
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/_hilfen/studiolauf.dh"
slStudio = ARG$(0)
