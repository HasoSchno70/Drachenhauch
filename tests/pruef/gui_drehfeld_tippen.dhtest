' Ein Drehfeld (GUI_SPINNER) nimmt getippte Zahlen -- bis 2026.40 kannte es
' nur die Pfeile und seine zwei Knoepfe. Mit dem Fokus ist sein Text ganz
' markiert, das erste Getippte ersetzt ihn. Eine Zahl im Bereich gilt schon
' beim Tippen; beim Verlassen (Enter, Fokus weg) wird geklemmt, ESC holt den
' Wert von vorher zurueck. Getippt wird ueber die Zwischenablage (Strg+V):
' eine Aufnahme liefert Tasten, aber keine Zeichen. Format: docs/werkzeuge.md.

--- langsam
=== getippt ersetzt den wert, schon vor dem enter
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM sp AS GUI_WIDGET
sp = GUI_SPINNER(w, 10, 10, 120, 0, 100, 5, 1)
GUI_FOCUS(sp)
CLIPBOARD_SET("42")
DIM f AS INTEGER
FOR f = 1 TO 14
    GUI_UPDATE()
    ' GUI_CHANGED beobachtet ab dem ersten Aufruf -- darum in jedem Bild.
    IF GUI_CHANGED(sp) THEN PRINT f; " geaendert "; GUI_VALUE(sp)
    IF f = 12 THEN PRINT f; " "; GUI_VALUE(sp)
    GUI_DRAW()
    FLIP()
NEXT
--- datei ev.txt
# Test-Aufnahme
c 6
e 3 2 341 0 0 0
e 3 2 86 0 0 0
e 4 1 86 0 0 0
e 4 1 341 0 0 0
e 8 2 257 0 0 0
e 9 1 257 0 0 0

--- umgebung
DHRT_FRAMES=16
--- erwartet
2 geaendert 42.0
12 42.0

=== zu gross wird beim enter auf den rand geklemmt
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM sp AS GUI_WIDGET
sp = GUI_SPINNER(w, 10, 10, 120, 0, 100, 5, 1)
GUI_FOCUS(sp)
CLIPBOARD_SET("250")
DIM f AS INTEGER
FOR f = 1 TO 14
    GUI_UPDATE()
    IF f = 6 OR f = 12 THEN PRINT f; " "; GUI_VALUE(sp)
    GUI_DRAW()
    FLIP()
NEXT
