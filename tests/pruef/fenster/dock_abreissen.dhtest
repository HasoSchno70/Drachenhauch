=== der stand merkt sich das eigene fenster
' GUI_DOCK_STATE$ haelt "fenster" und die Lage auf dem Bildschirm; zurueck
' angedockt und den Stand wieder gesetzt, geht die Leiste wieder hinaus.
IMPORT "gui"
IMPORT "json"
SCREEN(700, 500, "Stand", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Dock", 0, 0, 700, 500)
GUI_WINDOW_CHROME(w, FALSE)
GUI_DOCK(w, 0, 0, 700, 500)
GUI_DOCK_PANEL(w, "plug", "Plug-Stand", "links")
DIM p AS GUI_WINDOW : p = GUI_WINDOW("P", 0, 0, 200, 150)
GUI_DOCK_WINDOW(w, "plug", p)
SUB bilder(n AS INTEGER)
    DIM i AS INTEGER
    FOR i = 1 TO n
        GUI_UPDATE() : CLS(0) : GUI_DRAW() : FLIP()
    NEXT
END SUB
GUI_DOCK_MOVE(w, "plug", "fenster")
bilder(3)
PRINT "raus "; GUI_DOCK_WHERE$(w, "plug"); " "; GUI_WINDOW_IS_NATIVE(p)
DIM stand AS STRING : stand = GUI_DOCK_STATE$(w)
DIM j AS JSON_HANDLE : j = JSON_PARSE(stand)
PRINT "im stand "; JSON_GET_BOOL(j, "schweben.0.fenster"); " lage "; JSON_LEN(j, "schweben.0.lage")
GUI_DOCK_MOVE(w, "plug", "rechts")
bilder(3)
PRINT "zurueck "; GUI_DOCK_WHERE$(w, "plug"); " "; GUI_WINDOW_IS_NATIVE(p)
GUI_DOCK_SET_STATE(w, stand)
bilder(3)
PRINT "wieder "; GUI_DOCK_WHERE$(w, "plug"); " "; GUI_WINDOW_IS_NATIVE(p)
--- umgebung
DHRT_FRAMES=40
--- system windows
--- erwartet
raus fenster TRUE
im stand TRUE lage 2
zurueck rechts FALSE
wieder fenster TRUE

=== ohne echte fenster bleibt die leiste schwebend
' Der Rueckfall: wo es keine echten Fenster gibt (Browser, macOS, hier
' DHRT_OHNE_NATIVE_FENSTER), laesst GUI_DOCK_MOVE mit "fenster" sie
' schwebend im Gastfenster.
IMPORT "gui"
SCREEN(700, 500, "Widgets", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Dock", 0, 0, 700, 500)
GUI_WINDOW_CHROME(w, FALSE)
GUI_DOCK(w, 0, 0, 700, 500)
GUI_DOCK_PANEL(w, "liste", "Liste", "links")
DIM l AS GUI_WIDGET : l = GUI_LISTBOX(w, 0, 0, 10, 10, ["a"])
GUI_DOCK_ADD(w, "liste", l)
GUI_DOCK_MOVE(w, "liste", "fenster")
GUI_UPDATE()
PRINT GUI_DOCK_WHERE$(w, "liste")
--- umgebung
DHRT_FRAMES=5
DHRT_OHNE_NATIVE_FENSTER=1
--- system windows
--- erwartet
schwebend

=== eine leiste aus widgets des gastfensters reisst ab
' Stufe 3b: die Leiste ist ein Ausschnitt des Gastfensters (GUI_DOCK_ADD).
' Ueber den rechten Rand gezogen, wird sie eine Teilflaeche: ein eigenes
' Fenster, in dem das Gastfenster verschoben gezeichnet und bedient wird.
IMPORT "helfer.dh"
PRINT sende$(skript$(), "teil.dh", "roh:512:0:7209540;roh:513:1:7209540;roh:512:1:7209520;roh:512:1:7209760;roh:512:1:9831300;roh:514:0:9831300", "haupt")
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fenstersender.ps1"
END FUNCTION
FUNCTION pixel_skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fensterpixel.ps1"
END FUNCTION
--- datei teil.dh
IMPORT "gui"
' Eine Leiste aus Widgets des Gastfensters (GUI_DOCK_ADD): Knopf, Textfeld,
' Farbfeld. ARG$(1): enthaelt "raus" = gleich als eigenes Fenster;
' beginnt mit "haupt" = das Hauptfenster traegt die Kennung (dorthin
' schickt der Sender), sonst die Leiste.
DIM kennung AS STRING : kennung = ARG$(0)
DIM art AS STRING : art = ARG$(1)
DIM haupt_ziel AS BOOLEAN : haupt_ziel = LEFT$(art, 5) = "haupt"
SCREEN(700, 500, IIF(haupt_ziel, kennung, "Haupt-" + kennung), 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Dock", 0, 0, 700, 500)
GUI_WINDOW_CHROME(w, FALSE)
GUI_DOCK(w, 0, 0, 700, 500)
GUI_DOCK_PANEL(w, "dateien", "Dateien", "links")
GUI_DOCK_PANEL(w, "liste", IIF(haupt_ziel, "Liste-" + kennung, kennung), "schwebend")
DIM lk AS GUI_WIDGET : lk = GUI_BUTTON(w, "Listen-Knopf", 0, 0, 10, 10)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 0, 0, 10, 10)
DIM farbe AS GUI_WIDGET : farbe = GUI_LABEL(w, "", 0, 0)
GUI_SET_COLOR(farbe, "bg", &HFF00FF)
GUI_DOCK_ADD(w, "liste", lk)
GUI_DOCK_ADD(w, "liste", tf)
GUI_DOCK_ADD(w, "liste", farbe)
' Im Hauptfenster, dort, wo die Leiste gedacht noch steht.
DIM hk AS GUI_WIDGET : hk = GUI_BUTTON(w, "Haupt-Knopf", 250, 140, 140, 40)
GUI_DOCK_FLOAT(w, "liste", 200, 100, 400, 180)
SUB verteilen()
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM b AS INTEGER
    DIM h AS INTEGER
    (x, y, b, h) = GUI_DOCK_RECT(w, "liste")
    IF b > 0 THEN
        GUI_SET_BOUNDS(lk, x + 10, y + 10, 140, 30)
        GUI_SET_BOUNDS(tf, x + 10, y + 50, 200, 26)
        GUI_SET_BOUNDS(farbe, x + 250, y + 50, 100, 60)
    END IF
END SUB
verteilen()
IF INSTR(art, "raus") >= 0 THEN GUI_DOCK_MOVE(w, "liste", "fenster")
DIM nl AS INTEGER
DIM nh AS INTEGER
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT QUITREQUESTED() AND MILLIS() - t0 < 6000
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN verteilen()
    IF GUI_CLICKED(lk) THEN nl = nl + 1
    IF GUI_CLICKED(hk) THEN nh = nh + 1
    CLS(&H202830) : GUI_DRAW() : FLIP()
WEND
PRINT "wo "; GUI_DOCK_WHERE$(w, "liste"); " klicks liste "; nl; " haupt "; nh
PRINT "text |"; GUI_TEXT(tf); "|"
--- system windows
--- erwartet
gesendet
wo fenster klicks liste 0 haupt 0
text ||

=== ein klick in die teilflaeche trifft den knopf der leiste
' Der Knopf liegt im Gastfenster bei (211, 132) -- in seiner Teilflaeche bei
' (11, 32). Ein Klick dort (60, 45) trifft ihn, nicht den Knopf des
' Hauptfensters, der unter der gedachten Lage der Leiste steht.
IMPORT "helfer.dh"
PRINT sende$(skript$(), "teil.dh", "roh:512:0:2949180+roh:513:1:2949180+roh:514:0:2949180", "raus")
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fenstersender.ps1"
END FUNCTION
FUNCTION pixel_skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fensterpixel.ps1"
END FUNCTION
--- datei teil.dh
IMPORT "gui"
' Eine Leiste aus Widgets des Gastfensters (GUI_DOCK_ADD): Knopf, Textfeld,
' Farbfeld. ARG$(1): enthaelt "raus" = gleich als eigenes Fenster;
' beginnt mit "haupt" = das Hauptfenster traegt die Kennung (dorthin
' schickt der Sender), sonst die Leiste.
DIM kennung AS STRING : kennung = ARG$(0)
DIM art AS STRING : art = ARG$(1)
DIM haupt_ziel AS BOOLEAN : haupt_ziel = LEFT$(art, 5) = "haupt"
SCREEN(700, 500, IIF(haupt_ziel, kennung, "Haupt-" + kennung), 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Dock", 0, 0, 700, 500)
GUI_WINDOW_CHROME(w, FALSE)
GUI_DOCK(w, 0, 0, 700, 500)
GUI_DOCK_PANEL(w, "dateien", "Dateien", "links")
GUI_DOCK_PANEL(w, "liste", IIF(haupt_ziel, "Liste-" + kennung, kennung), "schwebend")
DIM lk AS GUI_WIDGET : lk = GUI_BUTTON(w, "Listen-Knopf", 0, 0, 10, 10)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 0, 0, 10, 10)
DIM farbe AS GUI_WIDGET : farbe = GUI_LABEL(w, "", 0, 0)
GUI_SET_COLOR(farbe, "bg", &HFF00FF)
GUI_DOCK_ADD(w, "liste", lk)
GUI_DOCK_ADD(w, "liste", tf)
GUI_DOCK_ADD(w, "liste", farbe)
' Im Hauptfenster, dort, wo die Leiste gedacht noch steht.
DIM hk AS GUI_WIDGET : hk = GUI_BUTTON(w, "Haupt-Knopf", 250, 140, 140, 40)
GUI_DOCK_FLOAT(w, "liste", 200, 100, 400, 180)
SUB verteilen()
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM b AS INTEGER
    DIM h AS INTEGER
    (x, y, b, h) = GUI_DOCK_RECT(w, "liste")
    IF b > 0 THEN
        GUI_SET_BOUNDS(lk, x + 10, y + 10, 140, 30)
        GUI_SET_BOUNDS(tf, x + 10, y + 50, 200, 26)
        GUI_SET_BOUNDS(farbe, x + 250, y + 50, 100, 60)
    END IF
END SUB
verteilen()
IF INSTR(art, "raus") >= 0 THEN GUI_DOCK_MOVE(w, "liste", "fenster")
DIM nl AS INTEGER
DIM nh AS INTEGER
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT QUITREQUESTED() AND MILLIS() - t0 < 6000
    GUI_UPDATE()
    IF GUI_DOCK_CHANGED(w) THEN verteilen()
    IF GUI_CLICKED(lk) THEN nl = nl + 1
    IF GUI_CLICKED(hk) THEN nh = nh + 1
    CLS(&H202830) : GUI_DRAW() : FLIP()
WEND
PRINT "wo "; GUI_DOCK_WHERE$(w, "liste"); " klicks liste "; nl; " haupt "; nh
PRINT "text |"; GUI_TEXT(tf); "|"
