' JSON laden und Werte mit Pfad-Notation rauslesen.
'
' Das json-Modul kennt drei Auflese-Stile:
'   JSON_PARSE(s$)             - aus einem String
'   JSON_LOAD(path$)           - aus einer Datei
'   JSON_GET_INT/FLOAT/STRING/BOOL(handle, pfad$)
'
' Pfad-Notation: Punktnotation. "user.name" greift name in user.
'                "items.0" ist Index 0 eines Arrays.

IMPORT "json"

' --- Aus String parsen ---
DIM s AS STRING
s = "{ ""name"": ""Anna"", ""score"": 4200, ""levels"": [10, 20, 30] }"

DIM j AS JSON_HANDLE
j = JSON_PARSE(s)

PRINT "Aus String:"
PRINT "  Name:        " + JSON_GET_STRING(j, "name")
PRINT f"  Score:       {JSON_GET_INT(j, "score")}"
PRINT f"  Anzahl Lev:  {JSON_LEN(j, "levels")}"

DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(j, "levels") - 1
    ' Pfad als Zwischen-String (kein verschachteltes f-String)
    DIM path AS STRING
    DIM val  AS INTEGER
    path = "levels." + STR$(i)
    val  = JSON_GET_INT(j, path)
    PRINT f"    levels.{i} = {val}"
NEXT i

' --- Aus Datei laden ---
PRINT ""
PRINT "Aus Datei waves.json:"
DIM w AS JSON_HANDLE
w = JSON_LOAD("waves.json")

PRINT f"  Anzahl Wellen: {JSON_LEN(w, "waves")}"
PRINT f"  Welle 1 size:  {JSON_GET_INT(w, "waves.0.size")}"
PRINT f"  Boss-Welle:    {JSON_GET_INT(w, "boss.wave")}"
PRINT f"  Boss-HP:       {JSON_GET_INT(w, "boss.hp")}"
