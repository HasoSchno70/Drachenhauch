=== riesige karte wird abgelehnt
' Ein Tippfehler in der Kachelzahl darf nicht den Speicher fressen.
IMPORT "tiled"
TRY
    DIM m AS TILED_MAP
    m = TILED_NEW(9000, 9000, 16, 16)
    PRINT "angenommen"
CATCH e
    PRINT "abgelehnt"
END TRY
--- erwartet
abgelehnt

=== leere karte bleibt lesbar
' Ohne Ebenen und ohne Tileset -- der Grenzfall, den ein Editor beim
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(3, 3, 8, 8)
TILED_SAVE(m, "leer.json")
--- erwartet

=== ebene umbenennen fuehrt den namensindex mit
' `TILED_LAYER_INDEX` sucht ueber den Namen. Bliebe der alte Eintrag
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER : a = TILED_ADD_LAYER(m, "Boden")
DIM b AS INTEGER : b = TILED_ADD_LAYER(m, "Deko")
TILED_LAYER_RENAME(m, 1, "Vordergrund")
PRINT TILED_LAYER_NAME(m, 1); " "; TILED_LAYER_INDEX(m, "Vordergrund"); " "; _
      TILED_LAYER_INDEX(m, "Deko")
--- erwartet
Vordergrund 1 -1

=== umbenennen auf den eigenen namen ist kein fehler
' Aus einem Eingabefeld heraus ist genau das der Normalfall.
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER : a = TILED_ADD_LAYER(m, "Boden")
DIM b AS INTEGER : b = TILED_ADD_LAYER(m, "Deko")
TRY
    TILED_LAYER_RENAME(m, 0, "Boden")
    PRINT "ok"
CATCH e
    PRINT "abgelehnt"
END TRY
TRY
    TILED_LAYER_RENAME(m, 0, "Deko")
    PRINT "kollision-durch"
CATCH e
    PRINT "kollision-erkannt"
END TRY
--- erwartet
ok
kollision-erkannt

=== sichtbarkeit uebersteht die datei
' Tiled speichert `visible`. Ohne den Setter liess sich eine
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER : a = TILED_ADD_LAYER(m, "Boden")
DIM b AS INTEGER : b = TILED_ADD_LAYER(m, "Deko")
TILED_LAYER_SET_VISIBLE(m, 0, FALSE)
TILED_SAVE(m, "v.json")
DIM m2 AS TILED_MAP : m2 = TILED_LOAD("v.json")
PRINT TILED_LAYER_VISIBLE(m2, 0); " "; TILED_LAYER_VISIBLE(m2, 1)
--- erwartet
FALSE TRUE

=== ebene entfernen rueckt die dahinter auf
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER : a = TILED_ADD_LAYER(m, "Eins")
DIM b AS INTEGER : b = TILED_ADD_LAYER(m, "Zwei")
DIM c AS INTEGER : c = TILED_ADD_LAYER(m, "Drei")
TILED_TILE_SET(m, 2, 1, 1, 9)
TILED_REMOVE_LAYER(m, 0)
PRINT TILED_LAYER_COUNT(m); " "; TILED_LAYER_NAME(m, 0); " "; TILED_LAYER_NAME(m, 1)
PRINT TILED_LAYER_INDEX(m, "Drei"); " "; TILED_LAYER_INDEX(m, "Eins"); " "; _
      TILED_TILE_AT(m, 1, 1, 1)
--- erwartet
2 Zwei Drei
1 -1 9

=== ebene verschieben nimmt ihre kacheln mit
' Die Reihenfolge ist die ZEICHENreihenfolge -- verschieben aendert das
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER : a = TILED_ADD_LAYER(m, "Eins")
DIM b AS INTEGER : b = TILED_ADD_LAYER(m, "Zwei")
DIM c AS INTEGER : c = TILED_ADD_LAYER(m, "Drei")
TILED_TILE_SET(m, 2, 1, 1, 9)
TILED_MOVE_LAYER(m, 2, 0)
PRINT TILED_LAYER_NAME(m, 0); TILED_LAYER_NAME(m, 1); TILED_LAYER_NAME(m, 2)
PRINT TILED_LAYER_INDEX(m, "Drei"); " "; TILED_TILE_AT(m, 0, 1, 1)
TILED_MOVE_LAYER(m, 0, 2)
PRINT TILED_LAYER_NAME(m, 0); TILED_LAYER_NAME(m, 1); TILED_LAYER_NAME(m, 2)
PRINT TILED_TILE_AT(m, 2, 1, 1)
--- erwartet
DreiEinsZwei
0 9
EinsZweiDrei
9

=== verschobene ebenen stehen so in der datei
' Gegengelesen vom FREMDEN Leser: die Reihenfolge in der JSON IST die
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM t AS INTEGER : t = TILED_ADD_TILESET(m, "kacheln.png", 4)
DIM a AS INTEGER : a = TILED_ADD_LAYER(m, "Boden")
DIM b AS INTEGER : b = TILED_ADD_LAYER(m, "Deko")
TILED_TILE_SET(m, 1, 0, 0, 2)
TILED_MOVE_LAYER(m, 1, 0)
TILED_SAVE(m, "r.json")
--- erwartet

=== verschieben an dieselbe stelle ist kein fehler
' Aus einer Liste heraus ist `von = nach` der Normalfall (oberste Ebene
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER : a = TILED_ADD_LAYER(m, "Eins")
DIM b AS INTEGER : b = TILED_ADD_LAYER(m, "Zwei")
TILED_MOVE_LAYER(m, 1, 1)
PRINT TILED_LAYER_NAME(m, 0); TILED_LAYER_NAME(m, 1)
--- erwartet
EinsZwei

=== ebenenbefehle lehnen falsche nummern ab
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER : a = TILED_ADD_LAYER(m, "Boden")
DIM n AS INTEGER : n = 0
TRY
    TILED_LAYER_RENAME(m, 5, "x")
CATCH e
    n = n + 1
END TRY
TRY
    TILED_LAYER_SET_VISIBLE(m, -1, FALSE)
CATCH e
    n = n + 1
END TRY
TRY
    TILED_REMOVE_LAYER(m, 9)
CATCH e
    n = n + 1
END TRY
TRY
    TILED_MOVE_LAYER(m, 0, 4)
CATCH e
    n = n + 1
END TRY
TRY
    TILED_MOVE_LAYER(m, -1, 0)
CATCH e
    n = n + 1
END TRY
TRY
    DIM v AS BOOLEAN : v = TILED_LAYER_VISIBLE(m, 3)
CATCH e
    n = n + 1
END TRY
PRINT n
--- erwartet
6


=== nextobjectid und kennungen gelten fuer die ganze karte
' Tiled vergibt ein neues Objekt unter `nextobjectid` -- stand dort 1,
' obwohl es Objekte 1 und 2 gab, legte Tiled beim Bearbeiten Doppelte an.
' Und die Kennungen zaehlen ueber ALLE Ebenen, nicht je Ebene ab 1.
IMPORT "tiled"
IMPORT "json"
DIM m AS TILED_MAP : m = TILED_NEW(4, 3, 16, 16)
DIM t AS INTEGER : t = TILED_ADD_TILESET(m, "kacheln.png", 8)
DIM o AS INTEGER : o = TILED_ADD_OBJECT_LAYER(m, "spawns")
DIM o2 AS INTEGER : o2 = TILED_ADD_OBJECT_LAYER(m, "trigger")
DIM i1 AS INTEGER : i1 = TILED_ADD_OBJECT(m, "spawns", "held", "spawn", 32.0, 48.0, 16.0, 16.0)
DIM i2 AS INTEGER : i2 = TILED_ADD_OBJECT(m, "spawns", "gegner", "spawn", 64.0, 16.0, 8.0, 8.0)
DIM i3 AS INTEGER : i3 = TILED_ADD_OBJECT(m, "trigger", "tuer", "", 0.0, 0.0, 16.0, 16.0)
TILED_SAVE(m, "karte.json")
DIM j AS JSON_HANDLE : j = JSON_LOAD("karte.json")
PRINT JSON_GET_INT(j, "nextobjectid"); " "; JSON_GET_INT(j, "layers.0.objects.0.id"); " "; _
      JSON_GET_INT(j, "layers.0.objects.1.id"); " "; JSON_GET_INT(j, "layers.1.objects.0.id")
' Geladen und erweitert: das neue Objekt bekommt die naechste Kennung.
DIM m2 AS TILED_MAP : m2 = TILED_LOAD("karte.json")
DIM i4 AS INTEGER : i4 = TILED_ADD_OBJECT(m2, "trigger", "falle", "", 8.0, 8.0, 4.0, 4.0)
TILED_SAVE(m2, "karte2.json")
DIM j2 AS JSON_HANDLE : j2 = JSON_LOAD("karte2.json")
PRINT JSON_GET_INT(j2, "nextobjectid"); " "; JSON_GET_INT(j2, "layers.1.objects.1.id")
--- erwartet
4 1 2 3
5 4

=== zweimal gesichert ist dieselbe datei
' Eigenschaften nach Namen, Kacheln nach Nummer -- die Ablage ist eine
' HashMap, und ohne Ordnung gab dieselbe Karte bei jedem Sichern eine andere
' Datei. Geprueft wird auch die ORDNUNG selbst, nicht nur die Gleichheit.
IMPORT "tiled"
IMPORT "json"
DIM m AS TILED_MAP : m = TILED_NEW(4, 3, 16, 16)
DIM t AS INTEGER : t = TILED_ADD_TILESET(m, "kacheln.png", 8)
TILED_TILE_SET_PROP(m, 6, "zeta", 1)
TILED_TILE_SET_PROP(m, 3, "solid", TRUE)
TILED_TILE_SET_PROP(m, 3, "damage", 5)
TILED_TILE_SET_PROP(m, 3, "art", "stein")
TILED_TILE_SET_PROP(m, 4, "reibung", 0.5)
TILED_TILE_SET_PROP(m, 1, "alpha", 2)
DIM o AS INTEGER : o = TILED_ADD_OBJECT_LAYER(m, "spawns")
DIM i1 AS INTEGER : i1 = TILED_ADD_OBJECT(m, "spawns", "held", "spawn", 32.0, 48.0, 16.0, 16.0)
DIM i2 AS INTEGER : i2 = TILED_ADD_OBJECT(m, "spawns", "gegner", "spawn", 64.0, 16.0, 8.0, 8.0)
TILED_OBJECT_SET_PROP(m, "spawns", i2, "leben", 3)
TILED_OBJECT_SET_PROP(m, "spawns", i2, "boss", TRUE)
TILED_OBJECT_SET_PROP(m, "spawns", i2, "ziel", "tor")
TILED_SAVE(m, "a.json")
TILED_SAVE(m, "b.json")
DIM za AS ARRAY OF STRING : za = READLINES("a.json")
DIM zb AS ARRAY OF STRING : zb = READLINES("b.json")
DIM gleich AS BOOLEAN : gleich = LEN(za) = LEN(zb)
DIM k AS INTEGER
IF gleich THEN
    FOR k = 0 TO LEN(za) - 1
        IF za[k] <> zb[k] THEN gleich = FALSE
    NEXT
END IF
PRINT gleich
DIM j AS JSON_HANDLE : j = JSON_LOAD("a.json")
DIM s AS STRING
s = ""
FOR k = 0 TO JSON_LEN(j, "tilesets.0.tiles") - 1
    s = s + STR$(JSON_GET_INT(j, "tilesets.0.tiles." + STR$(k) + ".id")) + " "
NEXT
PRINT TRIM$(s)
s = ""
FOR k = 0 TO JSON_LEN(j, "tilesets.0.tiles.1.properties") - 1
    s = s + JSON_GET_STRING(j, "tilesets.0.tiles.1.properties." + STR$(k) + ".name") + " "
NEXT
PRINT TRIM$(s)
s = ""
FOR k = 0 TO JSON_LEN(j, "layers.0.objects.1.properties") - 1
    s = s + JSON_GET_STRING(j, "layers.0.objects.1.properties." + STR$(k) + ".name") + " "
NEXT
PRINT TRIM$(s)
--- erwartet
TRUE
0 2 3 5
art damage solid
boss leben ziel
