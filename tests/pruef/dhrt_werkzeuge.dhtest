=== fmt fasst eine kaputte datei nicht an
' An kaputtem Code herumzuruecken hilft niemandem.
IMPORT "helfer.dh"
DIM quelle AS STRING : quelle = "PRINT " + CHR$(34) + "unbeendete Zeichenkette" + CHR$(10)
WRITEALL("a.dh", quelle)
dlStarten(["fmt", CWD$() + "/a.dh"])
PRINT "rueckgabe "; dlCode
PRINT "unveraendert "; (dlText$("a.dh") = quelle)
PRINT "sagt es "; (INSTR(dlErr, "unveraendert") >= 0)
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 2
unveraendert TRUE
sagt es TRUE

=== der bestand der beispiele bleibt unter fmt ruhig
' Nach dem einmaligen Durchlauf muss jede .dh-Datei ruhig bleiben -- sonst
' waere die Vorgabe nicht verlustfrei. Temp-Reste der IDE (_dhtmp_) liegen
' absichtlich neben der Quelle und gehoeren nicht zum Bestand.
IMPORT "helfer.dh"
DIM ordner AS STRING : ordner = ARG$(0)
DIM dateien AS ARRAY OF STRING : dateien = DIRLIST_REC(ordner, "*.dh")
DIM unruhig AS INTEGER : unruhig = 0
DIM gezaehlt AS INTEGER : gezaehlt = 0
DIM i AS INTEGER
' Sechs Dateien je Aufruf statt einer: `fmt` nimmt beliebig viele, und 210
' Prozessstarts waeren der ganze Zeitverbrauch dieses Falls.
DIM buendel AS ARRAY OF STRING : buendel = ["fmt", "--pruefen"]
FOR i = 0 TO LEN(dateien) - 1
    IF LEFT$(BASENAME(dateien[i]), 7) = "_dhtmp_" THEN CONTINUE
    gezaehlt = gezaehlt + 1
    ARRAY_PUSH(buendel, ordner + "/" + dateien[i])
    IF LEN(buendel) = 8 OR i = LEN(dateien) - 1 THEN
        dlStarten(buendel)
        IF dlCode <> 0 THEN
            unruhig = unruhig + 1
            PRINT "unruhig: "; TRIM$(dlAus)
        END IF
        buendel = ["fmt", "--pruefen"]
    END IF
NEXT
PRINT "geprueft "; (gezaehlt > 150)
PRINT "unruhig "; unruhig
--- argumente
{sammlung}/../../examples
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
geprueft TRUE
unruhig 0

=== doku nimmt signatur, kommentar und laesst privates weg
' `PRIVATE` gehoert dem Modul -- eine Referenz, die es auffuehrt, verspricht
' etwas, das beim naechsten Umbau verschwindet.
IMPORT "helfer.dh"
WRITEALL("mathe.dh", !"' Kleine Sammlung fuer Streckenrechnung.\n\n' Der groesste erlaubte Abstand.\nCONST GRENZE AS FLOAT = 1000.0\n\n' Abstand zweier Punkte in der Ebene.\n' Liefert immer einen positiven Wert.\nFUNCTION Distanz(x1 AS FLOAT, y1 AS FLOAT) AS FLOAT\n    RETURN x1 + y1\nEND FUNCTION\n\n' Nur fuer den internen Gebrauch.\nPRIVATE SUB pruefe(wert AS FLOAT)\n    PRINT wert\nEND SUB\n")
dlStarten(["doku", "referenz", CWD$() + "/mathe.dh"])
PRINT "rueckgabe "; dlCode
PRINT "signatur "; (INSTR(dlAus, "FUNCTION Distanz(x1 AS FLOAT, y1 AS FLOAT) AS FLOAT") >= 0)
PRINT "erste zeile "; (INSTR(dlAus, "Abstand zweier Punkte in der Ebene.") >= 0)
PRINT "zweite zeile "; (INSTR(dlAus, "Liefert immer einen positiven Wert.") >= 0)
PRINT "dateikopf "; (INSTR(dlAus, "Kleine Sammlung fuer Streckenrechnung.") >= 0)
PRINT "ohne privates "; (INSTR(dlAus, "pruefe") < 0)
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0
signatur TRUE
erste zeile TRUE
zweite zeile TRUE
dateikopf TRUE
ohne privates TRUE

=== doku sagt, was es braucht
IMPORT "helfer.dh"
dlStarten(["doku", "referenz"])
PRINT "ohne datei: rueckgabe "; dlCode
PRINT "ohne datei: verwendung "; (INSTR(dlAus, "Verwendung") >= 0)
dlStarten(["doku"])
PRINT "ohne unterbefehl: rueckgabe "; dlCode
DIM woerter AS ARRAY OF STRING : woerter = ["prosa", "grammatik", "referenz"]
DIM i AS INTEGER
FOR i = 0 TO LEN(woerter) - 1
    PRINT woerter[i]; " "; (INSTR(dlAus, woerter[i]) >= 0)
NEXT
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
ohne datei: rueckgabe 2
ohne datei: verwendung TRUE
ohne unterbefehl: rueckgabe 2
prosa TRUE
grammatik TRUE
referenz TRUE
