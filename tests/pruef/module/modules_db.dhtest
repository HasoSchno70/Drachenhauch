=== close result frees rows and stays usable
IMPORT "db"
DIM c AS DB_CONN
c = DB_OPEN(":memory:")
DB_EXEC(c, "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, score INTEGER, dabei INTEGER)")
DIM r AS DB_RESULT
r = DB_QUERY(c, "SELECT 1")
DB_CLOSE_RESULT(r)
PRINT DB_NEXT(r)
--- fehler
DB_NEXT: das Ergebnis wurde mit DB_CLOSE_RESULT geschlossen


=== get buffer reads a blob byte for byte
' Bytes mit 00 und FF gehen als BUFFER hinein und kommen gleich heraus; Text
' kommt als UTF-8, NULL leer, eine Zahl ist ein Fehler.
IMPORT "db"
DIM c AS DB_CONN
c = DB_OPEN(":memory:")
DB_EXEC(c, "CREATE TABLE t (id INTEGER PRIMARY KEY, b BLOB, s TEXT, n INTEGER)")
DIM b AS BUFFER : b = BUFFER_NEW(4)
BUFFER_SET(b, 0, 0) : BUFFER_SET(b, 1, 255) : BUFFER_SET(b, 2, 7) : BUFFER_SET(b, 3, 0)
DB_EXEC(c, "INSERT INTO t (b, s, n) VALUES (?, ?, ?)", b, "ä", 5)
DB_EXEC(c, "INSERT INTO t (b, s, n) VALUES (NULL, NULL, 1)")
DIM r AS DB_RESULT
r = DB_QUERY(c, "SELECT b, s, n FROM t ORDER BY id")
DB_NEXT(r)
DIM g AS BUFFER : g = DB_GET_BUFFER(r, 0)
PRINT BUFFER_LEN(g); " "; BUFFER_GET(g, 0); " "; BUFFER_GET(g, 1); " "; BUFFER_GET(g, 2); " "; BUFFER_GET(g, 3)
PRINT BUFFER_LEN(DB_GET_BUFFER(r, 1))
TRY
    g = DB_GET_BUFFER(r, 2)
CATCH e
    PRINT e
END TRY
DB_NEXT(r)
PRINT BUFFER_LEN(DB_GET_BUFFER(r, 0)); " "; BUFFER_LEN(DB_GET_BUFFER(r, 1))
--- erwartet
4 0 255 7 0
2
DB_GET_BUFFER: Spalte 2 ist eine Zahl, keine Bytes
0 0

=== eine gesperrte datei sagt, woran es liegt
' Eine offene Transaktion auf Verbindung a sperrt die Datei; b wartet
' 5 s und gibt auf. Die Meldung nennt die Ursache dazu, nicht nur
' "database is locked" (Buch "Fenster, Formulare, Daten", Kapitel 4).
IMPORT "db"
DIM a AS DB_CONN : a = DB_OPEN("gesperrt.db")
DB_EXEC(a, "CREATE TABLE t (n INTEGER)")
DIM b AS DB_CONN : b = DB_OPEN("gesperrt.db")
DB_BEGIN(a)
DB_EXEC(a, "INSERT INTO t VALUES (1)")
TRY
    DB_EXEC(b, "INSERT INTO t VALUES (2)")
CATCH e
    PRINT e
END TRY
DB_COMMIT(a)
PRINT DB_EXEC(b, "INSERT INTO t VALUES (3)")
--- erwartet
DB_EXEC: database is locked -- eine andere Verbindung schreibt gerade in die Datei (ein zweites Programm oder eine Transaktion ohne DB_COMMIT); nach 5 Sekunden aufgegeben
1

=== ein eingeklebter wert mit apostroph bekommt den weg mit fragezeichen
' Ungerade Zahl von ' im SQL plus Syntaxfehler: fast immer ein Wert, der
' ins SQL geklebt wurde. Ein anderer Syntaxfehler bleibt ohne Hinweis.
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN(":memory:")
DB_EXEC(c, "CREATE TABLE t (titel TEXT)")
DIM t AS STRING : t = "Sgt. Pepper's"
TRY
    DB_EXEC(c, "INSERT INTO t (titel) VALUES ('" + t + "')")
CATCH e
    PRINT e
END TRY
TRY
    DB_EXEC(c, "INSERT INTO t (titel) VALUES ('a',)")
CATCH e
    PRINT e
END TRY
--- erwartet
DB_EXEC: near "s": syntax error in INSERT INTO t (titel) VALUES ('Sgt. Pepper's') at offset 43 -- steht ein ' in einem eingeklebten Wert? Werte mit ? uebergeben: DB_EXEC(db, "... VALUES (?)", wert)
DB_EXEC: near ")": syntax error in INSERT INTO t (titel) VALUES ('a',) at offset 34

=== ein verletzter verweis sagt, welcher
' "FOREIGN KEY constraint failed" nennt weder Tabelle noch Spalte. Beim
' Loeschen nennt der Hinweis, wer ohne Loeschregel noch auf die Tabelle
' zeigt (nicht, wer mitloescht); beim Einfuegen die eigenen Verweise. Ohne
' Verweis bleibt es bei der Meldung (Buch "Fenster, Formulare, Daten",
' Kapitel 13).
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN(":memory:")
DB_EXEC(c, "CREATE TABLE freund (id INTEGER PRIMARY KEY, name TEXT)")
DB_EXEC(c, "CREATE TABLE eintrag (id INTEGER PRIMARY KEY, titel TEXT)")
DB_EXEC(c, "CREATE TABLE ausleihe (id INTEGER PRIMARY KEY, " + _
           "eintrag INTEGER REFERENCES eintrag(id) ON DELETE CASCADE, " + _
           "freund INTEGER REFERENCES freund(id))")
DB_EXEC(c, "INSERT INTO freund (name) VALUES ('Lena')")
DB_EXEC(c, "INSERT INTO eintrag (titel) VALUES ('Tetris')")
DB_EXEC(c, "INSERT INTO ausleihe (eintrag, freund) VALUES (1, 1)")
TRY
    DB_EXEC(c, "DELETE FROM " + CHR$(34) + "freund" + CHR$(34) + " WHERE id = ?", 1)
CATCH e
    PRINT e
END TRY
TRY
    DB_EXEC(c, "INSERT INTO ausleihe (eintrag, freund) VALUES (1, 99)")
CATCH e2
    PRINT e2
END TRY
' Mitloeschen geht durch: Tetris und seine Ausleihe sind weg.
DB_EXEC(c, "DELETE FROM eintrag WHERE id = 1")
DIM r AS DB_RESULT : r = DB_QUERY(c, "SELECT COUNT(*) FROM ausleihe")
IF DB_NEXT(r) THEN PRINT "ausleihen "; DB_GET_INT(r, 0)
--- erwartet
DB_EXEC: FOREIGN KEY constraint failed -- auf die Zeile zeigt noch eine Zeile in ausleihe (Spalte freund); erst diese loeschen, oder der Verweis loescht mit (ON DELETE CASCADE)
DB_EXEC: FOREIGN KEY constraint failed -- eine Verweis-Spalte nennt eine id, die es in der Zieltabelle nicht gibt: freund -> freund, eintrag -> eintrag
ausleihen 0

=== ein verletzter verweis auf englisch
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN(":memory:")
DB_EXEC(c, "CREATE TABLE freund (id INTEGER PRIMARY KEY, name TEXT)")
DB_EXEC(c, "CREATE TABLE ausleihe (id INTEGER PRIMARY KEY, freund INTEGER REFERENCES freund(id))")
DB_EXEC(c, "INSERT INTO freund (name) VALUES ('Lena')")
DB_EXEC(c, "INSERT INTO ausleihe (freund) VALUES (1)")
DB_EXEC(c, "DELETE FROM freund WHERE id = 1")
--- umgebung
DHRT_LANG=en
--- fehler
DB_EXEC: FOREIGN KEY constraint failed -- another row still points to this one in ausleihe (column freund); delete it first, or let the reference delete along (ON DELETE CASCADE)
