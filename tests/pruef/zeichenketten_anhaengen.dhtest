' Anhaengen an Zeichenketten (2026-09-24): `x = x + e`, `x += e` und die
' Kette `x = x + t1 + t2 ...` haengen an Ort und Stelle an (ADD_STORE_LOCAL /
' ADD_STORE_GLOBAL_SLOT in vm.rs, Umformung der Kette in compiler.rs). Vorher
' kopierte jedes Anhaengen den ganzen Text: 400 000 Mal dauerte 7 s.
' Die Faelle pruefen vor allem, dass sich NICHTS an der Bedeutung aendert.
' Format: docs/werkzeuge.md.

=== global lokal und += liefern dasselbe wie vorher
DIM s AS STRING
s = "a"
s = s + "b"
s += "c"
s = s + 1 + 2
s = s + 0.5
s = s + TRUE
PRINT s
SUB f()
    DIM r AS STRING
    r = "x"
    r = r + "y" + STR$(7) + CHR$(33)
    r += "-" + "z"
    PRINT r
END SUB
f()
--- erwartet
abc120.5TRUE
xy7!-z

=== ein zweiter halter behaelt seinen text
DIM s AS STRING
DIM kopie AS STRING
s = "abc"
kopie = s
s = s + "d"
s = s + "e" + "f"
PRINT s; " "; kopie
DIM feld[2] AS STRING
feld[0] = s
s += "g"
PRINT s; " "; feld[0]
--- erwartet
abcdef abc
abcdefg abcdef

=== der ausdruck darf die variable lesen
DIM s AS STRING
s = "ab"
s = s + s
s = s + LEFT$(s, 1) + s
PRINT s
--- erwartet
ababaabab

=== der ausdruck darf die variable aendern und die alte wird angehaengt
' Wie vorher: x wird VOR e geladen. Aendert e die Variable, gilt der alte Text.
DIM s AS STRING
FUNCTION stoer$() AS STRING
    s = "WEG"
    RETURN "!"
END FUNCTION
s = "alt"
s = s + stoer$()
PRINT s
s = "alt"
s = s + stoer$() + "?"
PRINT s
--- erwartet
alt!
alt!?

=== zahlen bleiben zahlen
DIM z AS INTEGER
DIM f AS FLOAT
DIM i AS INTEGER
FOR i = 1 TO 10
    z = z + i
    f = f + i
NEXT
z += 5
PRINT z; " "; f; " "; TYPEOF(f)
--- erwartet
60 55.0 FLOAT

=== ueberlauf bleibt ein fehler
DIM z AS INTEGER
z = 9223372036854775807
z = z + 1
--- fehler
+

=== const bleibt unveraenderlich
CONST GRUSS = "Hallo"
GRUSS = GRUSS + " Welt"
--- fehler
CONST

=== operator einer klasse sieht den ganzen text
CLASS Marke
    DIM n AS INTEGER
    OPERATOR + (other AS STRING) AS STRING
        RETURN other + "<" + STR$(Self.n) + ">"
    END OPERATOR
END CLASS
DIM m AS Marke
m = NEW Marke()
m.n = 3
DIM s AS STRING
s = "a"
s = s + m
PRINT s
--- erwartet
a<3>

=== scheitert der operator bleibt der alte text stehen
CLASS Boese
    OPERATOR + (other AS STRING) AS STRING
        THROW "nein"
    END OPERATOR
END CLASS
DIM b AS Boese
b = NEW Boese()
DIM s AS STRING
s = "bleibt"
TRY
    s = s + b
CATCH e
    PRINT "gefangen: "; e
END TRY
PRINT s
--- erwartet
gefangen: nein
bleibt

=== feld und mitglied haengen richtig an
CLASS Protokoll
    DIM text AS STRING
    SUB schreib(z AS STRING)
        Self.text = Self.text + z + ";"
    END SUB
END CLASS
DIM p AS Protokoll
p = NEW Protokoll()
p.schreib("a")
p.schreib("b")
DIM feld[1] AS STRING
feld[0] = "x"
feld[0] = feld[0] + "y"
PRINT p.text; " "; feld[0]
--- erwartet
a;b; xy

=== 400000 mal anhaengen ist linear
' Vorher 7 s auf dem Entwicklungsrechner, jetzt ~20 ms. Die Grenze laesst
' langsamen CI-Rechnern viel Luft und faellt beim quadratischen Weg trotzdem.
DIM s AS STRING
DIM i AS INTEGER
DIM t AS INTEGER : t = MILLIS()
FOR i = 1 TO 400000
    s = s + "x"
NEXT
PRINT LEN(s)
PRINT MILLIS() - t < 2000
--- erwartet
400000
TRUE

=== eine kette in einer sub ist linear
SUB bau()
    DIM r AS STRING
    DIM k AS INTEGER
    DIM t AS INTEGER : t = MILLIS()
    FOR k = 1 TO 200000
        r = r + STR$(k MOD 10) + ","
    NEXT
    PRINT LEN(r)
    PRINT MILLIS() - t < 2000
END SUB
bau()
--- erwartet
400000
TRUE

=== alle ziele liefern dasselbe wie eine variable
' Feld, Mitglied, Element, MAP-Wert, BYREF (2026-10-20): `k.text = k.text +
' e`, `text = text + e` in einer Methode, `a[i] = a[i] + e` und `m["k"] =
' m["k"] + e` sind eigene Befehle (ADD_STORE_MEMBER/_FIELD/_INDEX); ein
' BYREF-Argument wandert, wo es niemand sieht, in den Aufgerufenen
' (LEIHE_LOCAL/_GLOBAL_SLOT). Vorher kopierte jedes Anhaengen den ganzen
' Text: 200 000 Mal ~1,3 s statt ~10 ms.
CLASS K
    DIM text AS STRING
    SUB impl(z AS STRING)
        text = text + z + "|"
    END SUB
    SUB selbst(z AS STRING)
        Self.text = Self.text + z
        Self.text += "/"
    END SUB
END CLASS
SUB anh(BYREF t AS STRING, z AS STRING)
    t = t + z
END SUB
SUB lokal()
    DIM s AS STRING
    anh(s, "p") : anh(s, "q")
    PRINT s
END SUB
DIM k AS K
k = NEW K()
DIM a[3] AS STRING
DIM m AS MAP OF STRING
m["x"] = "m"
DIM g AS STRING
DIM ref AS STRING
DIM i AS INTEGER
FOR i = 1 TO 3
    ref = ref + STR$(i) + "," + 0.5 + TRUE
    k.text = k.text + STR$(i) + "," + 0.5 + TRUE
    a[1] = a[1] + STR$(i) + "," + 0.5 + TRUE
    m["x"] = m["x"] + STR$(i) + "," + 0.5 + TRUE
    k.impl(STR$(i))
    k.selbst("s")
    anh(g, STR$(i))
NEXT
PRINT ref
PRINT k.text
PRINT a[1]; " ["; a[0]; "]"
PRINT m["x"]
PRINT g
lokal()
DIM z[2, 2] AS STRING
z[1, 0] = "z"
z[1, 0] = z[1, 0] + "w"
z[1, 0] += "v"
PRINT z[1, 0]
--- erwartet
1,0.5TRUE2,0.5TRUE3,0.5TRUE
1,0.5TRUE1|s/2,0.5TRUE2|s/3,0.5TRUE3|s/
1,0.5TRUE2,0.5TRUE3,0.5TRUE []
m1,0.5TRUE2,0.5TRUE3,0.5TRUE
123
pq
zwv

=== ein zweiter halter behaelt seinen text auch bei feld element und map
CLASS K
    DIM text AS STRING
END CLASS
DIM k AS K
k = NEW K()
k.text = "abc"
DIM kopie AS STRING
kopie = k.text
k.text = k.text + "d"
DIM a[2] AS STRING
a[0] = "x"
a[1] = a[0]
a[0] = a[0] + "y"
DIM m AS MAP OF STRING
m["a"] = "m"
DIM mk AS STRING
mk = m["a"]
m["a"] = m["a"] + "n"
PRINT k.text; " "; kopie; " "; a[0]; " "; a[1]; " "; m["a"]; " "; mk
--- erwartet
abcd abc xy x mn m

=== der ausdruck darf den platz aendern und der alte text wird angehaengt
CLASS K
    DIM text AS STRING
END CLASS
DIM k AS K
k = NEW K()
DIM a[1] AS STRING
DIM m AS MAP OF STRING
FUNCTION stoer$(n AS INTEGER) AS STRING
    IF n = 1 THEN k.text = "WEG"
    IF n = 2 THEN a[0] = "WEG"
    IF n = 3 THEN m["a"] = "WEG"
    RETURN "!"
END FUNCTION
k.text = "alt" : a[0] = "alt" : m["a"] = "alt"
k.text = k.text + stoer$(1)
a[0] = a[0] + stoer$(2)
m["a"] = m["a"] + stoer$(3)
PRINT k.text; " "; a[0]; " "; m["a"]
--- erwartet
alt! alt! alt!

=== scheitert der operator bleibt der alte text in feld element und map
CLASS Boese
    OPERATOR + (other AS STRING) AS STRING
        THROW "nein"
    END OPERATOR
END CLASS
CLASS K
    DIM text AS STRING
    SUB impl(b AS Boese)
        text = text + b
    END SUB
END CLASS
DIM b AS Boese
b = NEW Boese()
DIM k AS K
k = NEW K()
k.text = "f"
DIM a[1] AS STRING
a[0] = "e"
DIM m AS MAP OF STRING
m["a"] = "m"
TRY
    k.text = k.text + b
CATCH e
    PRINT "1 "; e
END TRY
TRY
    k.impl(b)
CATCH e
    PRINT "2 "; e
END TRY
TRY
    a[0] = a[0] + b
CATCH e
    PRINT "3 "; e
END TRY
TRY
    m["a"] = m["a"] + b
CATCH e
    PRINT "4 "; e
END TRY
PRINT k.text; " "; a[0]; " "; m["a"]
--- erwartet
1 nein
2 nein
3 nein
4 nein
f e m

=== property und zahlen bleiben wie vorher
CLASS P
    DIM _t AS STRING
    DIM n AS INTEGER
    PROPERTY GET t() AS STRING
        RETURN Self._t
    END PROPERTY
    PROPERTY SET t(v AS STRING)
        Self._t = "<" + v + ">"
    END PROPERTY
END CLASS
DIM p AS P
p = NEW P()
p.t = "a"
p.t = p.t + "b"
p.t = p.t + "c"
p.n = p.n + 2
p.n += 3
DIM zahlen[2] AS INTEGER
zahlen[1] = zahlen[1] + 7
DIM fm AS MAP OF FLOAT
fm["x"] = 1.5
fm["x"] = fm["x"] + 1
PRINT p.t; " "; p.n; " "; zahlen[1]; " "; fm["x"]
--- erwartet
<<<a>b>c> 5 7 2.5

=== ein text in einem zahlenfeld bleibt ein fehler
