=== liste: kochbar-marke, suche auch in zutaten, sortieren, schnellfilter
' Wie _apply_filters: Suche in Name und Beschreibung -- und (neu, der
' Platzhalter versprach es schon) in den Zutaten; sofort kochbar, schnell
' (bis 30 min), wenig Zutaten (bis 5); acht Sortierungen.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM k AS ARRAY OF Rezept : k = katalog()
' Kaesespaetzle, Kartoffelpuffer, Milchreis, Currywurst und ein eigenes.
rezeptAnlegen(k[12])
rezeptAnlegen(k[14])
rezeptAnlegen(k[20])
rezeptAnlegen(k[21])
DIM eigen AS Rezept : eigen = NEW Rezept()
eigen.name = "Rührei"
eigen.beschreibung = "Schnell gemacht"
eigen.portionen = 1
eigen.vorb = 2
eigen.koch = 5
eigen.zutaten = []
DIM z AS Zutat : z = NEW Zutat() : z.name = "Ei" : z.menge = 3 : z.einheit = "Stück" : ARRAY_PUSH(eigen.zutaten, z)
z = NEW Zutat() : z.name = "Butter" : z.menge = 10 : z.einheit = "g" : ARRAY_PUSH(eigen.zutaten, z)
rezeptAnlegen(eigen)
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Ei'), ('Butter'), ('Reis'), ('Milch'), ('Zucker')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 10, 'Stück', '2026-11-20'), (2, 250, 'g', '2026-11-25'), (3, 500, 'g', '2027-05-01'), (4, 2, 'Liter', '2026-11-12'), (5, 1, 'kg', '2027-01-01')")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS RezepteSeite : s = f.rezepte
f.geaendert()
SUB zeilen(s AS RezepteSeite)
    DIM i AS INTEGER
    FOR i = 0 TO GUI_TABLE_ROW_COUNT(s.tabelle) - 1
        PRINT "  "; GUI_TABLE_GET_CELL(s.tabelle, i, 0); " | "; GUI_TABLE_GET_CELL(s.tabelle, i, 1); " | "; GUI_TABLE_GET_CELL(s.tabelle, i, 2); " | "; GUI_TABLE_GET_CELL(s.tabelle, i, 5)
    NEXT
    PRINT "  "; GUI_TEXT(s.info)
END SUB
zeilen(s)
GUI_SET_TEXT(s.sucheFeld, "kirschen")
s.sucheFeld_Geaendert()
PRINT "suche kirschen (nur in den zutaten)"
zeilen(s)
GUI_SET_TEXT(s.sucheFeld, "")
DIM i AS INTEGER
FOR i = 1 TO 7
    GUI_DROPDOWN_SET_SELECTED(s.sortierWahl, i)
    s.sortierWahl_Geaendert()
    DIM n AS ARRAY OF STRING : n = []
    DIM r AS INTEGER
    FOR r = 0 TO GUI_TABLE_ROW_COUNT(s.tabelle) - 1
        ARRAY_PUSH(n, GUI_TABLE_GET_CELL(s.tabelle, r, 0))
    NEXT
    PRINT "sortiert "; GUI_DROPDOWN_TEXT(s.sortierWahl); ": "; JOIN$(n, ", ")
NEXT
GUI_SET_CHECKED(s.kochbarKasten, TRUE)
s.kochbarKasten_Geaendert()
PRINT "sofort kochbar"
zeilen(s)
s.knopfZuruecksetzen_Klick()
GUI_SET_CHECKED(s.kochbarKasten, FALSE)
GUI_SET_CHECKED(s.schnellKasten, TRUE)
s.schnellKasten_Geaendert()
PRINT "schnell"
zeilen(s)
GUI_SET_CHECKED(s.wenigKasten, TRUE)
s.wenigKasten_Geaendert()
PRINT "schnell und wenig"
zeilen(s)
--- erwartet
  Currywurst | 2 Port. | 5 Zutat(en) | 25 min
  Kartoffelpuffer | 4 Port. | 8 Zutat(en) | 40 min
  Käsespätzle | 4 Port. | 9 Zutat(en) | 50 min
  Milchreis | 4 Port. | 7 Zutat(en) | 45 min
  ✅ Rührei | 1 Port. | 2 Zutat(en) | 7 min
  📚 5 Rezept(e) gespeichert
suche kirschen (nur in den zutaten)
  Milchreis | 4 Port. | 7 Zutat(en) | 45 min
