=== dialog text nur bei prompt
IMPORT "gui"
SCREEN(520, 320, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM d AS GUI_WINDOW : d = GUI_DIALOG("F", "x")
TRY
    PRINT GUI_DIALOG_TEXT(d)
CATCH e
    PRINT e
END TRY
DIM w AS GUI_WINDOW : w = GUI_WINDOW("W", 10, 10, 100, 80)
TRY
    PRINT GUI_DIALOG_TEXT(w)
CATCH e2
    PRINT e2
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
GUI_DIALOG_TEXT: dieser Dialog hat kein Eingabefeld (nur GUI_PROMPT)
GUI_DIALOG_TEXT: das Fenster ist kein Dialog (GUI_PROMPT)

=== eigenes fenster modal verschluckt klicks daneben
IMPORT "gui"
SCREEN(520, 320, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Hinten", 4, 4, 200, 120)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "los", 8, 8, 90, 26)
DIM m AS GUI_WINDOW : m = GUI_WINDOW("Modal", 250, 150, 200, 120)
DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(m, "zu", 8, 8, 90, 26)
GUI_WINDOW_MODAL(m, TRUE)
PRINT GUI_MODAL()
AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 1 TO 10
    GUI_UPDATE()
    IF GUI_CLICKED(b) THEN PRINT "traf"
    GUI_DRAW()
    FLIP()
NEXT
--- datei ev.txt
# Test-Aufnahme
c 4
e 2 7 60 50 0 0 // Event: test
e 3 7 60 50 0 0 // Event: test
e 3 6 0 0 0 0 // Event: test
e 4 5 0 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
TRUE

