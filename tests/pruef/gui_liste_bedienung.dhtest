=== das mausrad rollt weich
' Eintrag 5 hat ein gruenes Sinnbild bei y 10 + 110 + 2 (.. + 18). Drei
' Radschritte nach unten rollen um 66: dann steht es bei y 56..74. Zwei
' Bilder nach dem Rad ist es noch unterwegs, nach der Dauer dort.
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM namen AS ARRAY OF STRING : namen = []
DIM k AS INTEGER
FOR k = 0 TO 29
    ARRAY_PUSH(namen, "Eintrag " + STR$(k))
NEXT
DIM lb AS GUI_WIDGET : lb = GUI_LISTBOX(w, 10, 10, 280, 200, namen)
DIM gruen AS IMAGE : gruen = IMAGE_NEW(16, 16, &H00FF00)
GUI_LISTBOX_ICON(lb, 5, gruen)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
