=== comprehension
DIM nums AS TUPLE
nums = (1, 2, 3, 4, 5, 6)
DIM evens AS TUPLE
evens = [n FOR n IN nums WHERE n MOD 2 = 0]
PRINT evens
--- erwartet
(2, 4, 6)

=== oop inheritance and self
CLASS Animal
  DIM name AS STRING
  FUNCTION speak() AS STRING
    RETURN "..."
  END FUNCTION
  SUB describe()
    PRINT Self.name + ": " + Self.speak()
  END SUB
END CLASS
CLASS Dog EXTENDS Animal
  FUNCTION speak() AS STRING
    RETURN "Wuff"
  END FUNCTION
END CLASS
DIM d AS Dog
d = NEW Dog()
d.name = "Rex"
d.describe()
--- erwartet
Rex: Wuff

=== property clamp
CLASS P
  DIM _hp AS INTEGER
  PROPERTY GET hp() AS INTEGER
    RETURN Self._hp
  END PROPERTY
  PROPERTY SET hp(v AS INTEGER)
    IF v > 100 THEN v = 100
    Self._hp = v
  END PROPERTY
END CLASS
DIM p AS P
p = NEW P()
p.hp = 250
PRINT p.hp
--- erwartet
100

