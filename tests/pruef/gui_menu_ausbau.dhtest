IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM s AS INTEGER : s = GUI_SUBMENU(m, "Zuletzt")
DIM z1 AS INTEGER : z1 = GUI_MENU_ITEM(s, "eins.dh")
DIM s2 AS INTEGER : s2 = GUI_SUBMENU(s, "Aeltere")
DIM z2 AS INTEGER : z2 = GUI_MENU_ITEM(s2, "alt.dh", "Strg+2")
DIM h AS INTEGER : h = GUI_MENU_ITEM(m, "Statusleiste")
GUI_MENU_CHECK(h, TRUE)
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT GUI_TO_JSON(w2) = j
PRINT INSTR(j, "alt.dh") >= 0
PRINT INSTR(j, "Strg+2") >= 0
PRINT INSTR(j, "checkable") >= 0
