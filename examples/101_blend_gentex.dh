' 101_blend_gentex.dh -- Blend-Modes (Batch 2) + prozedurale Texturen (Batch 3).
' NUR native Runtime (dhrt/F6): prozedurale Texturen + additives Blending.

SCREEN(640, 400, "Blend + GenTex", 1)

DIM perlin AS IMAGE
perlin = GENTEX_PERLIN(180, 150, 6.0)
DIM grad AS IMAGE
grad = GENTEX_GRADIENT(180, 150, &HFF6020, &H2040FF, TRUE)
DIM checked AS IMAGE
checked = GENTEX_CHECKED(180, 150, 9, 8, &H303838, &HD0D8D0)

DIM frame AS INTEGER
FOR frame = 0 TO 100000
    IF QUITREQUESTED() THEN BREAK

    CLS(&H0A0A12)

    ' Prozedurale Texturen nebeneinander
    DRAWIMAGE(perlin, 20, 40)
    DRAWIMAGE(grad, 230, 40)
    DRAWIMAGE(checked, 440, 40)

    ' Additives Blending: ueberlappende Kreise leuchten heller (Glow).
    BLEND_MODE("add")
    CIRCLE(250, 300, 70, &H402000)
    CIRCLE(320, 300, 70, &H104030)
    CIRCLE(390, 300, 70, &H201050)
    BLEND_MODE("alpha")

    TEXT(20, 12, "GenTex: Perlin / Gradient / Checked   +   additives Blending unten", &HCCDDEE)

    FLIP()
NEXT
