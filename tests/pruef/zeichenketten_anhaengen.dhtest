DIM m AS MAP OF STRING
m["neu"] = m["neu"] + "x"
--- fehler
nicht in der MAP

=== byref sieht den alten wert wo der aufgerufene die variable liest
DIM g AS STRING
FUNCTION lies$() AS STRING
    RETURN "(" + g + ")"
END FUNCTION
SUB zeig(BYREF t AS STRING)
    PRINT "g="; g
    t = t + "x"
END SUB
SUB ueber(BYREF t AS STRING)
    t = t + lies$()
END SUB
SUB zwei(BYREF t AS STRING, n AS INTEGER)
    t = t + STR$(n)
END SUB
SUB beide(BYREF t AS STRING, BYREF u AS STRING)
    t = t + "1"
    u = u + "2"
END SUB
g = "a"
zeig(g)
PRINT g
ueber(g)
PRINT g
zwei(g, LEN(g))
PRINT g
beide(g, g)
PRINT g
--- erwartet
g=a
ax
ax(ax)
ax(ax)6
ax(ax)61

=== byref nach einem fehler im aufgerufenen bleibt der alte wert
SUB kaputt(BYREF t AS STRING)
    t = t + "x"
    THROW "weg"
END SUB
SUB lokal()
    DIM s AS STRING
    s = "lokal"
    TRY
        kaputt(s)
    CATCH e
        PRINT e
    END TRY
    PRINT s
END SUB
SUB ohne_try()
    DIM s AS STRING
    s = "innen"
    kaputt(s)
    PRINT "nie"
END SUB
DIM g AS STRING
g = "global"
TRY
    kaputt(g)
CATCH e
    PRINT e
FINALLY
    PRINT g
END TRY
lokal()
TRY
    ohne_try()
CATCH e
    PRINT "aussen "; e
END TRY
PRINT g
--- erwartet
weg
global
weg
lokal
aussen weg
global

=== 600000 mal an feld element map und byref anhaengen ist linear
' Vorher ~18 s auf dem Entwicklungsrechner, jetzt ~0,2 s. Die Grenze laesst
' langsamen CI-Rechnern viel Luft und faellt beim quadratischen Weg trotzdem.
CLASS K
    DIM text AS STRING
    SUB impl(n AS INTEGER)
        DIM i AS INTEGER
        FOR i = 1 TO n
            text = text + "x"
        NEXT
    END SUB
END CLASS
SUB anh(BYREF t AS STRING)
    t = t + "x"
END SUB
SUB lokal_byref(n AS INTEGER)
    DIM s AS STRING
    DIM i AS INTEGER
    FOR i = 1 TO n
        anh(s)
    NEXT
    PRINT LEN(s)
END SUB
CONST N = 600000
DIM k AS K
k = NEW K()
DIM a[1] AS STRING
DIM m AS MAP OF STRING
m["a"] = ""
DIM g AS STRING
DIM i AS INTEGER
DIM t AS INTEGER : t = MILLIS()
FOR i = 1 TO N
    k.text = k.text + "x"
    a[0] = a[0] + "x"
    m["a"] = m["a"] + "x"
    anh(g)
NEXT
k.impl(N)
lokal_byref(N)
PRINT LEN(k.text); " "; LEN(a[0]); " "; LEN(m["a"]); " "; LEN(g)
PRINT MILLIS() - t < 4000
--- erwartet
600000
1200000 600000 600000 600000
TRUE
