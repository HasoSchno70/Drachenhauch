' Die Einstellungen des laufenden Programms (kern/einstellungen.dh) -- geladen,
' bevor irgendetwas aufgebaut wird, damit Zeichenflaeche, Werkzeuge und Dialoge
' sie von Anfang an lesen. Eine eigene Datei, weil sie VOR allen anderen
' Teilen der Ansicht eingebunden wird.

DIM einst AS kern.Einstellungen
einst = kern.einstellungenLaden(kern.einstellungsDatei$("einstellungen.json"))
DIM einstTafel AS MAP OF STRING
einstTafel = kern.kuerzelTafel(einst)

' Sichern, ohne dass ein Fehler beim Schreiben das Programm anhaelt
SUB einstellungenMerken()
    TRY
        kern.einstellungenSichern(einst)
    CATCH fehler
        PRINT "Einstellungen nicht gesichert: "; fehler
    END TRY
END SUB

' Der Ordner, in dem Datei-Dialoge anfangen ("" = was GTK will)
FUNCTION einstOrdner$() AS STRING
    IF einst.ordner <> "" AND DIREXISTS(einst.ordner) THEN RETURN einst.ordner
    RETURN ""
END FUNCTION

' --- Kuerzel in Tooltips und Meldungen ------------------------------------------------
' Ein Text nennt ein Kuerzel als {kennung}; eingesetzt wird, was gerade gilt.
' Tooltips merken sich ihren Text und werden nach jeder Aenderung der
' Einstellungen neu gesetzt -- sonst naennten sie die alte Taste.
DIM tippW AS ARRAY OF INTEGER
tippW = []
DIM tippT AS ARRAY OF STRING
tippT = []

FUNCTION mitKuerzeln$(text AS STRING) AS STRING
    IF INSTR(text, "{") < 0 THEN RETURN text
    DIM a AS kern.Kuerzelaktion
    FOR EACH a IN kern.kuerzelAktionen()
        IF INSTR(text, "{" + a.kennung + "}") >= 0 THEN text = REPLACE$(text, "{" + a.kennung + "}", kern.kuerzelVon$(einst, a.kennung))
    NEXT
    RETURN text
END FUNCTION

FUNCTION kuerzelHinweis$(kennung AS STRING) AS STRING
    DIM k AS STRING : k = kern.kuerzelVon$(einst, kennung)
    IF k = "" THEN RETURN ""
    RETURN " (" + k + ")"
END FUNCTION

' Ein Widget, das zerstoert wird (die Seitenleiste baut ihre Knoepfe neu),
' faellt aus der Liste -- sonst bekaeme ein toter Zeiger einen Tooltip.
SUB tippWeg(w AS INTEGER, daten AS INTEGER)
    DIM i AS INTEGER : i = ARRAY_INDEXOF(tippW, w)
    IF i >= 0 THEN
        ARRAY_REMOVE_AT(tippW, i)
        ARRAY_REMOVE_AT(tippT, i)
    END IF
END SUB

SUB tipp(w AS INTEGER, text AS STRING)
    DIM i AS INTEGER : i = ARRAY_INDEXOF(tippW, w)
    IF i < 0 THEN
        ARRAY_PUSH(tippW, w)
        ARRAY_PUSH(tippT, text)
        signal(w, "destroy", tippWeg, 0, 0, 0)
    ELSE
        tippT[i] = text
    END IF
    gtk_widget_set_tooltip_text(w, mitKuerzeln$(text))
END SUB

SUB tippsAuffrischen()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(tippW) - 1
        gtk_widget_set_tooltip_text(tippW[i], mitKuerzeln$(tippT[i]))
    NEXT
END SUB
