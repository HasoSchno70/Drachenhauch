DIM t AS GUI_WIDGET : t = GUI_TABLE(w, 5, 5, 280, 150)
GUI_TABLE_SET(t, "gibtsnicht", 1)
--- fehler
GUI_TABLE_SET: 'gibtsnicht' unbekannt -- zeilenhoehe, kopfhoehe, zebra, gitter, filterzeile, sortierbar, spalten_ziehbar, feste_spalten, spalten_verschiebbar, mehrfachauswahl

=== zahlenspalte wird zahlenweise sortiert
' Textweise stuende 100 vor 9 -- in einer Punktespalte die haeufigste
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM t AS GUI_WIDGET : t = GUI_TABLE(w, 10, 10, 360, 200)
DIM k AS ARRAY OF STRING : k = SPLIT$("Name|Punkte", "|")
GUI_TABLE_HEADERS(t, k)
DIM z AS ARRAY OF STRING
z = SPLIT$("Cleo|9", "|") : GUI_TABLE_ADD_ROW(t, z)
z = SPLIT$("Anna|10", "|") : GUI_TABLE_ADD_ROW(t, z)
z = SPLIT$("Bruno|100", "|") : GUI_TABLE_ADD_ROW(t, z)
SUB zeig()
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO GUI_TABLE_VIEW_COUNT(t) - 1
        s = s + GUI_TABLE_GET_CELL(t, GUI_TABLE_VIEW_ROW(t, i), 0) + " "
    NEXT
    PRINT TRIM$(s)
END SUB
GUI_TABLE_SORT(t, 1, FALSE)
zeig()
--- erwartet
Cleo Anna Bruno

=== textspalte sortiert ohne ruecksicht auf schreibweise
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM t AS GUI_WIDGET : t = GUI_TABLE(w, 10, 10, 360, 200)
DIM k AS ARRAY OF STRING : k = SPLIT$("Name|Punkte", "|")
GUI_TABLE_HEADERS(t, k)
DIM z AS ARRAY OF STRING
z = SPLIT$("bruno|1", "|") : GUI_TABLE_ADD_ROW(t, z)
z = SPLIT$("Anna|2", "|") : GUI_TABLE_ADD_ROW(t, z)
z = SPLIT$("cleo|3", "|") : GUI_TABLE_ADD_ROW(t, z)
SUB zeig()
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO GUI_TABLE_VIEW_COUNT(t) - 1
        s = s + GUI_TABLE_GET_CELL(t, GUI_TABLE_VIEW_ROW(t, i), 0) + " "
    NEXT
    PRINT TRIM$(s)
END SUB
GUI_TABLE_SORT(t, 0, FALSE)
zeig()
--- erwartet
Anna bruno cleo

=== sortierung stellt die daten nicht um
' Der entscheidende Punkt: eine gemerkte Zeilennummer muss nach dem
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM t AS GUI_WIDGET : t = GUI_TABLE(w, 10, 10, 360, 200)
DIM k AS ARRAY OF STRING : k = SPLIT$("Name|Punkte", "|")
GUI_TABLE_HEADERS(t, k)
DIM z AS ARRAY OF STRING
z = SPLIT$("Cleo|9", "|") : GUI_TABLE_ADD_ROW(t, z)
z = SPLIT$("Anna|10", "|") : GUI_TABLE_ADD_ROW(t, z)
z = SPLIT$("Bruno|100", "|") : GUI_TABLE_ADD_ROW(t, z)
SUB zeig()
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO GUI_TABLE_VIEW_COUNT(t) - 1
        s = s + GUI_TABLE_GET_CELL(t, GUI_TABLE_VIEW_ROW(t, i), 0) + " "
    NEXT
    PRINT TRIM$(s)
END SUB

PRINT GUI_TABLE_GET_CELL(t, 0, 0)
GUI_TABLE_SORT(t, 0, FALSE)
PRINT GUI_TABLE_GET_CELL(t, 0, 0)
PRINT STR$(GUI_TABLE_VIEW_ROW(t, 0))
--- erwartet
Cleo
Cleo
1

=== filter wirkt als teiltext und kombiniert
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM t AS GUI_WIDGET : t = GUI_TABLE(w, 10, 10, 360, 200)
DIM k AS ARRAY OF STRING : k = SPLIT$("Name|Punkte", "|")
GUI_TABLE_HEADERS(t, k)
DIM z AS ARRAY OF STRING
z = SPLIT$("Anna|1", "|") : GUI_TABLE_ADD_ROW(t, z)
z = SPLIT$("Bruno|2", "|") : GUI_TABLE_ADD_ROW(t, z)
z = SPLIT$("Cleo|3", "|") : GUI_TABLE_ADD_ROW(t, z)
SUB zeig()
    DIM s AS STRING : s = ""
    DIM i AS INTEGER
    FOR i = 0 TO GUI_TABLE_VIEW_COUNT(t) - 1
        s = s + GUI_TABLE_GET_CELL(t, GUI_TABLE_VIEW_ROW(t, i), 0) + " "
    NEXT
    PRINT TRIM$(s)
END SUB

GUI_TABLE_FILTER(t, 0, "o")
zeig()
PRINT STR$(GUI_TABLE_VIEW_COUNT(t)) + "/" + STR$(GUI_TABLE_ROW_COUNT(t))
GUI_TABLE_FILTER(t, 1, "3")
zeig()
GUI_TABLE_FILTER(t, 0, "")
GUI_TABLE_FILTER(t, 1, "")
zeig()
--- erwartet
Bruno Cleo
2/3
Cleo
Anna Bruno Cleo

