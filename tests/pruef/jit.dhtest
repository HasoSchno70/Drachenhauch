=== zahlbefehle in einer schleife
DIM s AS FLOAT
DIM n AS INTEGER
DIM i AS INTEGER
FOR i = -6 TO 6
    s = s + ABS(i) + ABS(i * 0.5) + SQR(ABS(i)) + INT(i / 4) + FLT(i)
    s = s + SIN(i) + COS(i) + TAN(i * 0.1) + ATAN(i) + EXP(i * 0.25)
    s = s + ATAN2(i, 3) + HYPOT(i, 4) + DEG(i) + RAD(i) + FRAC(i * 0.37)
    s = s + LERP(i, 10, 0.25)
    n = n + FLOOR(i * 0.7) + CEIL(i * 0.7) + ROUND(i * 0.5) + SGN(i) + SIGN(i * 0.1)
    n = n + INT(i) + FLOOR(i) + MIN(i, 2) + MAX(i, -2) + MIN(i, 3, -1) + CLAMP(i, -3, 4)
    s = s + MIN(i * 1.5, 2.5) + MAX(i * 1.5, -2.5) + CLAMP(i * 1.5, -3.0, 4.0)
NEXT
PRINT s; " "; n
