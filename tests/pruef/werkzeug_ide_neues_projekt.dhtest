' Neues Projekt aus Vorlage (Strg+Alt+N): vier Vorlagen, jede ein
' lauffaehiges main.dh samt LIESMICH.md; das Spiel bringt assets/figur.png
' mit, das Konsolenprogramm rechnen.dh und eine Pruefsammlung. Danach ist
' der neue Ordner das Projekt und main.dh offen. Ein unbrauchbarer Name und
' ein belegter Ordner werden abgelehnt. Das `--- nachher` uebersetzt jedes
' main.dh, laeuft die Pruefsammlung und das Konsolenprogramm mit Eingabe.
--- seriell

=== vier vorlagen, zwei ablehnungen
DIM prBild AS INTEGER : prBild = 0
DIM prOrt AS STRING : prOrt = ""
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 40 THEN
    prOrt = projektOrdner
    befehl("neues_projekt")
    DIM prI AS INTEGER
    FOR prI = 0 TO 3
        protokoll("pr anlegen " + STR$(prI) + " " + STR$(neuProjektAnlegen(prI, "p" + STR$(prI), prOrt)))
        protokoll("pr projekt " + BASENAME(projektOrdner) + " reiter " + BASENAME(tabPfade[aktiverTab]))
    NEXT
    protokoll("pr schraeg " + STR$(neuProjektAnlegen(0, "a/b", prOrt)) + " " + GUI_TEXT(lblNpMeldung))
    protokoll("pr belegt " + STR$(neuProjektAnlegen(3, "p1", prOrt)) + " " + GUI_TEXT(lblNpMeldung))
    EXIT(0)
END IF
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
FUNCTION lauf$(a AS STRING, b AS STRING, eingabe AS STRING) AS STRING
    DIM p AS INTEGER : p = PROCESS_START("dhrt", a, b)
    IF eingabe <> "" THEN PROCESS_WRITE(p, eingabe + CHR$(10))
    PROCESS_CLOSE_INPUT(p)
    DIM t AS STRING : t = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM s AS STRING : s = PROCESS_READ$(p)
        IF s = "" AND NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1 : SLEEP(30)
        ELSE
            t = t + s
        END IF
    WEND
    RETURN TRIM$(REPLACE$(REPLACE$(t, CHR$(13), ""), CHR$(10), " / "))
END FUNCTION
DIM k AS INTEGER
FOR k = 0 TO 3
    PRINT "p"; k; " check "; lauf$("--check", "p" + STR$(k) + "/main.dh", ""); " liesmich "; FILEEXISTS("p" + STR$(k) + "/LIESMICH.md")
NEXT
PRINT "figur "; FILEEXISTS("p0/assets/figur.png")
PRINT "test "; INSTR(lauf$("test", "p2/tests.dhtest", ""), "1 Faelle, 1 ok, 0 fehl") >= 0
CHDIR("p2")
PRINT "lauf "; lauf$("run", "main.dh", "Anna")
--- erwartet
pr anlegen 0 TRUE
pr projekt p0 reiter main.dh
pr anlegen 1 TRUE
pr projekt p1 reiter main.dh
pr anlegen 2 TRUE
pr projekt p2 reiter main.dh
pr anlegen 3 TRUE
pr projekt p3 reiter main.dh
pr schraeg FALSE Der Name braucht Buchstaben, Ziffern, _ oder -.
pr belegt FALSE Den Ordner p1 gibt es schon, und er ist nicht leer.
p0 check [] / liesmich TRUE
p1 check [] / liesmich TRUE
p2 check [] / liesmich TRUE
p3 check [] / liesmich TRUE
figur TRUE
test TRUE
lauf Wie heißt du? Hallo, Anna! 6 mal 7 ist 42. /

=== ein ordner, den die platte nicht anlegt, beendet die ide nicht
' Stresstest 2026-10-02: MKDIR scheiterte (kein Schreibrecht am Ort, ein
' Name, den Windows nicht nimmt, oder -- wie hier -- eine DATEI dieses
' Namens) und der Fehler beendete die ganze IDE. Jetzt steht er im
' Fenster, und die IDE laeuft weiter.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 40 THEN
    befehl("neues_projekt")
    protokoll("pr datei " + STR$(neuProjektAnlegen(0, "belegt", startOrdner)) + " " + LEFT$(GUI_TEXT(lblNpMeldung), 19))
END IF
IF prBild = 60 THEN
    protokoll("pr laeuft weiter")
    EXIT(0)
END IF
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei belegt
eine Datei, kein Ordner
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR L[i] = "neues projekt fehler" THEN PRINT L[i]
NEXT
--- erwartet
neues projekt fehler
pr datei FALSE Anlegen ging nicht:
pr laeuft weiter
