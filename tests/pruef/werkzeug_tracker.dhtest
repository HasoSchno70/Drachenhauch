=== die datei hat das format der qt-fassung
' Strg+S schreibt song.json. Gelesen wird mit dem json-Modul, Schluessel fuer
' Schluessel wie `drachenhauch.tracker.Song` sie liest (dort bis Stufe 40 der
' fremde Leser): data[kanal][reihe], leere Plaetze als null.
SET_WINDOW_POS(-3000, -3000)
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
DIM prFlag AS STRING : prFlag = ""
DIM prMax AS INTEGER : prMax = -1
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prEinmal(schluessel AS STRING, z AS STRING)
    IF INSTR(prFlag, "|" + schluessel + " ") < 0 THEN prFlag = prFlag + "|" + schluessel + " " + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
--- programm ../../examples/190_tracker.dh nach SETFPS(60)
--- einschub nach FLIP()
prSchreib("")

--- einschub nach bildNr = bildNr + 1
IF bildNr = 2 THEN dateiPfad = "song.json"

