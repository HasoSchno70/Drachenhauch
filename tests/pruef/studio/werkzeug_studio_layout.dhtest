=== ein kind wird umgesetzt und herausgezogen
' knopfB vor knopfA, dann das Suchfeld unter die Zeile -- dort ist kein
' Layout, es steht danach frei.
IMPORT "laeufer.dh"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 8, CWD$() + "/f.dhform")
DIM ax AS INTEGER
DIM ay AS INTEGER
DIM bx AS INTEGER
DIM by AS INTEGER
DIM sx AS INTEGER
DIM sy AS INTEGER
(ax, ay) = slLage(m, "control knopfA")
(bx, by) = slLage(m, "control knopfB")
(sx, sy) = slLage(m, "control feldSuche")
slHin(10, 10)
slZug(bx, by, ax - 30, ay, 12, TRUE)
slWarten(8)
slZug(sx, sy, sx, sy + 280, 12, TRUE)
slWarten(8)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, CWD$() + "/f.dhform")
DIM z AS STRING
FOR EACH z IN slAnfang(log, "eingesetzt ")
    PRINT z
NEXT
PRINT "frei "; LEN(slAnfang(log, "herausgenommen feldSuche ")) = 1
DIM b AS ARRAY OF STRING : b = slAnfang(log, "behaelter Zeile1")
PRINT b[LEN(b) - 1]
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
