=== der rollbalken laesst sich ziehen
' 30 Eintraege: rollen kann die Liste 30 * 22 - 200 = 460. Der Griff sitzt
' bei x 281..288 oben; nach unten gezogen, und ein Klick in die erste
' sichtbare Zeile (y 12) trifft Eintrag (2 + 460) / 22 = 21.
IMPORT "gui"
SCREEN(300, 450, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 450)
GUI_WINDOW_CHROME(w, FALSE)
DIM namen AS ARRAY OF STRING : namen = []
DIM k AS INTEGER
FOR k = 0 TO 29
    ARRAY_PUSH(namen, "Eintrag " + STR$(k))
NEXT
DIM lb AS GUI_WIDGET : lb = GUI_LISTBOX(w, 10, 10, 280, 200, namen)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "gewaehlt "; GUI_LISTBOX_SELECTED(lb)
--- datei ev.txt
c 8
e 0 7 5 440 0 0
e 1 7 285 20 0 0
e 2 6 0 0 0 0
e 4 7 285 420 0 0
e 6 5 0 0 0 0
e 8 7 60 12 0 0
e 9 6 0 0 0 0
e 10 5 0 0 0 0

--- umgebung
DHRT_FRAMES=14
--- erwartet
gewaehlt 21

