' ============================================================================
'  85_cybermatic_demo.dh  --  "CYBERMATIC"  (native Drachenhauch Showcase, HiRes)
'
'  Beat- UND audio-reaktive Demoscene-Nummer fuer die native Runtime (dhrt).
'  Das Spektrum + die 3D-Szenen reagieren auf eine ECHTE FFT der laufenden
'  Musik (AUDIO_FFT -> raylib-Mix-Tap). Alle 16 Takte wechselt die Szene:
'      TUNNEL  ->  RING  ->  PLASMA
'
'  3D (g3d): orbitierende Kamera mit Beat-Zoom-Punch + Shake, drei Szenen,
'            audio-modulierte Geometrie, Lichtsaeulen.
'  2D:       FFT-Spektrum (BOXES-Bulk, oben+unten), Glow-Funken + Cyber-Regen,
'            pulsierender Titel, Credits-Laufschrift, Beat-Flash.
'
'  NUR NATIV:  dhrun.py --native examples\85_cybermatic_demo.dh   (oder F6)
'  ESC beendet.
'
'  Musik: "Cybermatic pulse" von Alexandr Zhelanov (opengameart.org), CC-BY 4.0.
'  Fehlt die Datei:  py examples\assets\download_cybermatic.py
'  Credits: examples/assets/CREDITS_cybermatic.txt
' ============================================================================

IMPORT "g3d"
IMPORT "particles"
IMPORT "audio"

CONST W AS INTEGER = 1280
CONST H AS INTEGER = 720
CONST TWO_PI AS FLOAT = 6.2831853
CONST NB AS INTEGER = 64            ' FFT-Baender = Spektrum-Balken
CONST BPS AS FLOAT = 2.0833         ' Beats/Sekunde (~125 BPM)
CONST SCENE_BARS AS INTEGER = 16    ' Takte pro Szene

' --- Globaler Zustand (von den Szenen-SUBs gelesen) -------------------------
DIM fft[NB] AS FLOAT
DIM t AS FLOAT
DIM kick AS FLOAT
DIM pulse AS FLOAT
DIM bass AS FLOAT
DIM beat AS INTEGER

SCREEN(W, H, "Drachenhauch -- CYBERMATIC (native)", 1)

IF FILEEXISTS("assets/cybermatic_pulse.ogg") THEN
    PLAYMUSIC("assets/cybermatic_pulse.ogg", -1, 0.8)
END IF

' --- Partikel ---------------------------------------------------------------
DIM sparks AS PARTICLE_SYSTEM
sparks = PARTICLE_SYSTEM_NEW(W / 2, H / 2)
PARTICLE_SET_VELOCITY(sparks, -360.0, 360.0, -360.0, 360.0)
PARTICLE_SET_LIFETIME(sparks, 350, 850)
PARTICLE_SET_GRAVITY(sparks, 0.0, 80.0)
PARTICLE_SET_SIZE(sparks, 2, 6)
PARTICLE_SET_MODE(sparks, "glow")
PARTICLE_SET_FADE(sparks, TRUE)

DIM rain AS PARTICLE_SYSTEM
rain = PARTICLE_SYSTEM_NEW(W / 2, -10)
PARTICLE_SET_VELOCITY(rain, -30.0, 30.0, 320.0, 620.0)
PARTICLE_SET_LIFETIME(rain, 700, 1500)
PARTICLE_SET_GRAVITY(rain, 0.0, 70.0)
PARTICLE_SET_SIZE(rain, 1, 2)
PARTICLE_SET_MODE(rain, "streak")
PARTICLE_SET_FADE(rain, TRUE)
PARTICLE_SET_COLOR(rain, &H1E50C0)
PARTICLE_SET_COLOR_END(rain, &H0A1840)

' --- Spektrum-Arrays --------------------------------------------------------
DIM bx1[NB] AS INTEGER
DIM bx2[NB] AS INTEGER
DIM bbot1[NB] AS INTEGER
DIM bbot2[NB] AS INTEGER
DIM btop1[NB] AS INTEGER
DIM btop2[NB] AS INTEGER
DIM bcol[NB] AS INTEGER

DIM last_beat AS INTEGER
last_beat = -1
DIM t0 AS INTEGER
t0 = MILLIS()

DIM scroll_msg AS STRING
scroll_msg = "DRACHENHAUCH NATIVE RUNTIME  ***  ECHTE FFT-AUDIOREAKTIVITAET (raylib Mix-Tap)  ***  3D + PARTIKEL + BULK-2D + STREAM-AUDIO  ***  SZENEN: TUNNEL . RING . PLASMA  ***  MUSIK: CYBERMATIC PULSE / ALEXANDR ZHELANOV (CC-BY 4.0)  ***  ESC = ENDE  ***   "

' ---------------------------------------------------------------------------
'  Hilfsfunktionen
' ---------------------------------------------------------------------------
FUNCTION hue(p AS FLOAT, bright AS FLOAT) AS INTEGER
    DIM r AS INTEGER
    DIM g AS INTEGER
    DIM b AS INTEGER
    r = INT((0.5 + 0.5 * SIN(p)) * bright * 255.0)
    g = INT((0.5 + 0.5 * SIN(p + 2.094)) * bright * 255.0)
    b = INT((0.5 + 0.5 * SIN(p + 4.188)) * bright * 255.0)
    RETURN RGB(MIN(255, r), MIN(255, g), MIN(255, b))
END FUNCTION

FUNCTION fmod(a AS FLOAT, m AS FLOAT) AS FLOAT
    RETURN a - FLOOR(a / m) * m
END FUNCTION

' Band-Pegel (0..1) aus dem FFT-Array, gegen Bereichsfehler abgesichert.
FUNCTION fband(i AS INTEGER) AS FLOAT
    DIM k AS INTEGER
    k = i MOD NB
    RETURN fft[k]
END FUNCTION

' ---------------------------------------------------------------------------
'  Szene 0: TUNNEL  -- Ringe aus Wuerfeln fliegen auf die Kamera zu
' ---------------------------------------------------------------------------
SUB scene_tunnel()
    CAMERA3D(SIN(t * 0.4) * 2.0, 1.0 + SIN(t * 0.7) * 0.6, -9.0 - kick * 2.5, 0.0, 1.0, 14.0, 62.0 - kick * 10.0)
    DIM seg AS INTEGER
    FOR seg = 0 TO 23
        DIM zz AS FLOAT
        zz = 26.0 - fmod(seg * 1.7 + t * 10.0, 40.8)
        DIM rr AS FLOAT
        rr = 4.2 + fband(seg) * 3.0
        DIM k AS INTEGER
        FOR k = 0 TO 7
            DIM aa AS FLOAT
            aa = (k / 8) * TWO_PI + zz * 0.25 + t * 0.3
            DIM cc AS INTEGER
            cc = hue(seg * 0.32 + t, 0.6 + 0.4 * fband(seg))
            CUBE_WIRES(COS(aa) * rr, SIN(aa) * rr + 1.0, zz, 0.5, 0.5, 0.5, cc)
        NEXT
    NEXT
END SUB

' ---------------------------------------------------------------------------
'  Szene 1: RING  -- Doppelring + Kugel + Saeule, orbitierende Kamera
' ---------------------------------------------------------------------------
SUB scene_ring()
    DIM camr AS FLOAT
    camr = 18.0 - kick * 3.5
    CAMERA3D(COS(t * 0.32) * camr + (RND() - 0.5) * kick * 0.4, 8.0 + SIN(t * 0.6) * 3.0, SIN(t * 0.32) * camr, 0.0, 1.5, 0.0, 55.0 - kick * 8.0)
    GRID3D(48, 1.0)
    DIM sr AS FLOAT
    sr = 2.0 + pulse * 1.0 + bass * 2.5
    SPHERE(0.0, 1.5, 0.0, sr, hue(t * 0.8, 1.0))
    SPHERE_WIRES(0.0, 1.5, 0.0, sr + 0.15, &H0A1830)
    DIM i AS INTEGER
    FOR i = 0 TO 15
        DIM a1 AS FLOAT
        a1 = (i / 16) * TWO_PI + t * 0.6
        DIM lv AS FLOAT
        lv = fband(i * 3)
        DIM y1 AS FLOAT
        y1 = 1.2 + lv * 4.0
        DIM s1 AS FLOAT
        s1 = 0.8 + lv * 1.2
        DIM c1 AS INTEGER
        c1 = hue(i * 0.4 + t, 1.0)
        CUBE(COS(a1) * 7.5, y1, SIN(a1) * 7.5, s1, s1, s1, c1)
        CUBE_WIRES(COS(a1) * 7.5, y1, SIN(a1) * 7.5, s1, s1, s1, &H0A1830)
        IF i MOD 2 = 0 THEN LINE3D(COS(a1) * 7.5, 0.0, SIN(a1) * 7.5, COS(a1) * 7.5, y1 + 2.0, SIN(a1) * 7.5, c1)
    NEXT
    FOR i = 0 TO 11
        DIM a2 AS FLOAT
        a2 = (i / 12) * TWO_PI - t * 0.9
        CUBE_WIRES(COS(a2) * 11.0, 2.5 + COS(t * 2.0 + i * 0.7) * 1.2, SIN(a2) * 11.0, 0.6, 0.6, 0.6, hue(i * 0.5 - t * 1.3, 1.0))
    NEXT
END SUB

' ---------------------------------------------------------------------------
'  Szene 2: PLASMA  -- audio-reaktives Wuerfel-Terrain (15x15 EQ-Feld)
' ---------------------------------------------------------------------------
SUB scene_plasma()
    CAMERA3D(COS(t * 0.25) * 15.0, 12.0 + SIN(t * 0.4) * 2.0, SIN(t * 0.25) * 15.0, 0.0, 0.0, 0.0, 55.0 - kick * 6.0)
    DIM gx AS INTEGER
    DIM gz AS INTEGER
    FOR gx = -7 TO 7
        FOR gz = -7 TO 7
            DIM d AS FLOAT
            d = SQR(gx * gx + gz * gz)
            DIM lv AS FLOAT
            lv = fband(INT(d * 4.0))
            DIM wv AS FLOAT
            wv = 0.5 + 0.5 * SIN(d * 0.9 - t * 3.0)
            DIM hgt AS FLOAT
            hgt = 0.4 + (wv * 1.5 + lv * 6.0) * (0.5 + bass * 2.0)
            CUBE(gx * 1.4, hgt * 0.5, gz * 1.4, 1.1, hgt, 1.1, hue(d * 0.35 - t + lv * 3.0, 1.0))
        NEXT
    NEXT
END SUB

' ---------------------------------------------------------------------------
'  Hauptschleife
' ---------------------------------------------------------------------------
WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK

    t = (MILLIS() - t0) / 1000.0

    ' Echte FFT der laufenden Musik holen.
    AUDIO_FFT(fft)
    bass = (fft[0] + fft[1] + fft[2] + fft[3]) * 0.25

    ' Beat-Mathe.
    DIM beatf AS FLOAT
    beatf = t * BPS
    beat = INT(beatf)
    DIM frac AS FLOAT
    frac = beatf - beat
    kick = (1.0 - frac) * (1.0 - frac)
    pulse = 0.5 + 0.5 * SIN(beatf * TWO_PI)
    DIM downbeat AS BOOLEAN
    downbeat = (beat MOD 4 = 0)

    ' Szene aus Takt-Zaehler.
    DIM bar AS INTEGER
    bar = beat \ 4
    DIM scene AS INTEGER
    scene = (bar \ SCENE_BARS) MOD 3

    IF beat <> last_beat THEN
        PARTICLE_SET_COLOR(sparks, hue(beat * 0.7, 1.0))
        PARTICLE_SET_COLOR_END(sparks, hue(beat * 0.7 + 2.0, 1.0))
        DIM burst AS INTEGER
        burst = 60 + INT(bass * 200.0)
        IF downbeat THEN burst = burst + 80
        PARTICLE_EMIT(sparks, burst)
        last_beat = beat
    END IF

    ' Beat-Flash ueber die Hintergrundfarbe (dezent, damit die Szene lesbar bleibt).
    DIM fl AS INTEGER
    fl = INT(kick * 12.0 + bass * 26.0)
    IF downbeat THEN fl = fl + INT(kick * 22.0)
    CLS(RGB(MIN(120, 5 + fl), MIN(120, 7 + fl), MIN(160, 14 + fl * 2)))

    ' ---------------- 3D-Szene ----------------
    SELECT CASE scene
        CASE 0
            scene_tunnel()
        CASE 1
            scene_ring()
        CASE ELSE
            scene_plasma()
    END SELECT

    ' ---------------- 2D-Overlay ----------------
    PARTICLE_SET_POS(rain, INT(RND() * W), -10.0)
    PARTICLE_EMIT(rain, 3)
    PARTICLE_UPDATE(rain, 16)
    PARTICLE_DRAW(rain)

    ' FFT-Spektrum, oben + unten gespiegelt.
    DIM bw AS INTEGER
    bw = W \ NB
    DIM i AS INTEGER
    FOR i = 0 TO NB - 1
        DIM bh AS INTEGER
        bh = INT(fft[i] * 210.0) + 2
        bx1[i] = i * bw + 2
        bx2[i] = i * bw + bw - 2
        bbot2[i] = H - 64
        bbot1[i] = H - 64 - bh
        btop1[i] = 110
        btop2[i] = 110 + bh
        bcol[i] = hue(i * 0.18 + t * 1.5, 0.45 + 0.55 * fft[i])
    NEXT
    BOXES(bx1, bbot1, bx2, bbot2, bcol)
    BOXES(bx1, btop1, bx2, btop2, bcol)

    PARTICLE_UPDATE(sparks, 16)
    PARTICLE_DRAW(sparks)

    ' Titel pulsiert in Groesse + Farbe.
    TEXT_SIZE(52 + INT(kick * 22.0))
    TEXT(W / 2 - 210, 26, "C Y B E R M A T I C", hue(t * 1.2, 0.55 + 0.45 * pulse))
    TEXT_SIZE(20)

    DIM names AS ARRAY OF STRING
    names = SPLIT$("TUNNEL|RING|PLASMA", "|")
    TEXT(W / 2 - 150, 90, "native demo  --  szene: " + names[scene], &H6FA8C8)

    DIM mw AS INTEGER
    mw = TEXT_WIDTH(scroll_msg)
    DIM sx AS INTEGER
    sx = W - (INT(t * 165.0) MOD (mw + W))
    TEXT(sx, H - 30, scroll_msg, &H30C0E0)

    TEXT(14, H - 54, f"t={t:.1f}s  beat={beat}  bass={bass:.2f}", &H507088)

    FLIP()
    SLEEP(8)
WEND

STOPMUSIC()
