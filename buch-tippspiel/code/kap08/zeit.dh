' ============================================================
'  Kapitel 8 - Zeit
'  Start:  dhrun.py buch-tippspiel/code/kap08/zeit.dh
' ============================================================
'  Bis jetzt durfte man jederzeit tippen -- auch nach dem
'  Abpfiff. Jetzt bekommen die Spiele einen Anstoss, und daraus
'  folgt alles Weitere: Tippschluss, Countdown, Wochentag.
'
'  Der Trick ist immer derselbe: ZEIT IST EINE ZAHL. Der Anstoss
'  steht als Text in der Datenbank (so sortiert SQLite ihn
'  richtig) und wird zum Rechnen einmal in Sekunden umgewandelt.
' ============================================================
IMPORT "gui"
IMPORT "db"
IMPORT "zeit"

' ---- Die Regel aus Kapitel 3 --------------------------------------------
' Unveraendert uebernommen. Sie steht hier einmal und wird von der Anzeige
' wie von der Neuberechnung gefragt -- eine Regel, eine Stelle.
FUNCTION tendenz(heim AS INTEGER, gast AS INTEGER) AS INTEGER
    IF heim > gast THEN RETURN 1
    IF heim < gast THEN RETURN -1
    RETURN 0
END FUNCTION

FUNCTION punkte(tippH AS INTEGER, tippA AS INTEGER, _
                ergH AS INTEGER, ergA AS INTEGER) AS INTEGER
    IF tippH = ergH AND tippA = ergA THEN RETURN 3
    IF tendenz(tippH, tippA) <> tendenz(ergH, ergA) THEN RETURN 0
    IF (tippH - tippA) = (ergH - ergA) THEN RETURN 2
    RETURN 1
END FUNCTION

CONST DATEI = "kap08.db"

' Getippt wird bis eine Viertelstunde vor Anpfiff.
CONST TIPPSCHLUSS_VOR = 15 * 60

DIM db AS DB_CONN
db = DB_OPEN(DATEI)

DB_EXEC(db, "CREATE TABLE IF NOT EXISTS spieler (" + _
            "id INTEGER PRIMARY KEY, name TEXT NOT NULL)")
' anstoss als "JJJJ-MM-TT hh:mm:ss": in dieser Schreibweise sortiert SQLite
' den Text richtig, und ZEIT_PARSE macht daraus eine Zahl zum Rechnen.
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS spiele (" + _
            "id INTEGER PRIMARY KEY, spieltag INTEGER NOT NULL, " + _
            "heim TEXT NOT NULL, gast TEXT NOT NULL, anstoss TEXT, " + _
            "tore_heim INTEGER, tore_gast INTEGER)")
' UNIQUE(spieler_id, spiel_id): die Datenbank laesst einen zweiten Tipp
' desselben Spielers auf dasselbe Spiel gar nicht erst zu.
DB_EXEC(db, "CREATE TABLE IF NOT EXISTS tipps (" + _
            "id INTEGER PRIMARY KEY, spieler_id INTEGER NOT NULL, " + _
            "spiel_id INTEGER NOT NULL, tipp_heim INTEGER NOT NULL, " + _
            "tipp_gast INTEGER NOT NULL, punkte INTEGER, " + _
            "UNIQUE(spieler_id, spiel_id))")

FUNCTION anzahl(sql AS STRING) AS INTEGER
    DIM r AS DB_RESULT
    r = DB_QUERY(db, sql)
    DIM n AS INTEGER : n = 0
    IF DB_NEXT(r) THEN n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN n
END FUNCTION

IF anzahl("SELECT COUNT(*) FROM spieler") = 0 THEN
    DB_BEGIN(db)
    DIM name AS STRING
    FOR EACH name IN ("Anna", "Ben", "Clara")
        DB_EXEC(db, "INSERT INTO spieler (name) VALUES (?)", name)
    NEXT
    ' Ein Spieltag: Freitagabend, Samstag, Sonntag.
    ' Das erste Spiel liegt bewusst in der VERGANGENHEIT (deshalb steht dort
    ' auch schon ein Ergebnis), die uebrigen in der Zukunft.
    DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) VALUES (1,?,?,?)", _
            "FC Bayern München", "VfB Stuttgart", "2026-08-14 20:30:00")
    DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) VALUES (1,?,?,?)", _
            "Borussia Dortmund", "Hamburger SV", "2026-08-29 15:30:00")
    DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) VALUES (1,?,?,?)", _
            "RB Leipzig", "Bor. Mönchengladbach", "2026-08-29 15:30:00")
    DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) VALUES (1,?,?,?)", _
            "SC Freiburg", "SV Werder Bremen", "2026-08-29 18:30:00")
    DB_EXEC(db, "INSERT INTO spiele (spieltag, heim, gast, anstoss) VALUES (1,?,?,?)", _
            "1. FC Köln", "TSG Hoffenheim", "2026-08-30 17:30:00")

    ' Ein paar Tipps und ein Ergebnis, damit beim ersten Start schon etwas
    ' zu sehen ist: 3 Punkte gruen, 2 gelb, 0 rot.
    DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) VALUES (1,1,3,1)")
    DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) VALUES (2,1,2,0)")
    DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) VALUES (3,1,0,2)")
    DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) VALUES (1,2,2,1)")
    DB_EXEC(db, "UPDATE spiele SET tore_heim = 3, tore_gast = 1 WHERE id = 1")
    DB_COMMIT(db)
END IF

