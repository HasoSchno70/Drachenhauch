' IMPORT "modul" OPTIONAL und MODULE_AVAILABLE (2026-11-04): ein Programm,
' das ein Hardware-Modul nur benutzt, wenn es im Bau ist, soll in einem Bau
' ohne --hardware nicht warnen -- weder beim Import noch an den Aufrufen.
' Die Faelle gelten in beiden Bauten; was nur ohne das Modul zu sehen ist,
' ueberspringt sich im Hardware-Bau.

=== optional importiert warnt nicht, auch nicht an den aufrufen
IMPORT "helfer.dh"
IMPORT "json"
DIM d AS JSON_HANDLE : d = dlCheck(!"IMPORT \"serial\" OPTIONAL\nIF MODULE_AVAILABLE(\"serial\") THEN PRINT SERIAL_PORTS()\nPRINT 1\n")
PRINT "befunde "; JSON_LEN(d, "d")
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
befunde 0

=== ohne optional warnt der bau ohne das modul weiter
' Gegenprobe: dieselbe Zeile ohne OPTIONAL. Auch ein zweiter, schlichter
' Import desselben Moduls hebt das OPTIONAL wieder auf.
IMPORT "helfer.dh"
IMPORT "json"
DIM a AS JSON_HANDLE : a = dlCheck(!"IMPORT \"serial\"\nPRINT 1\n")
DIM b AS JSON_HANDLE : b = dlCheck(!"IMPORT \"serial\" OPTIONAL\nIMPORT \"serial\"\nPRINT 1\n")
IF MODULE_AVAILABLE("serial") THEN
    PRINT "UEBERSPRINGEN: Hardware-Bau, das Modul ist dabei -- keine Warnung zu pruefen"
ELSE
    PRINT "schlicht "; JSON_LEN(a, "d"); " Zeile "; JSON_GET_INT(a, "d.0.line")
    PRINT "beide "; JSON_LEN(b, "d"); " Zeile "; JSON_GET_INT(b, "d.0.line")
END IF
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
schlicht 1 Zeile 1
beide 1 Zeile 2

=== der lauf warnt nicht auf stderr
IMPORT "helfer.dh"
dlStarten(["run", CWD$() + "/prog.dh"])
PRINT "aus "; TRIM$(dlAus); " code "; dlCode
PRINT "stderr leer "; (TRIM$(dlErr) = "")
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- datei prog.dh
IMPORT "serial" OPTIONAL
IMPORT "usb" OPTIONAL
PRINT "ok"
--- erwartet
aus ok code 0
stderr leer TRUE

=== module_available kennt die module dieses baus
' json ist immer dabei, ein erfundener Name nie. Fuer serial muss die Antwort
' zu dem passen, was `dhrt --version` unter "dabei" nennt. Firmata gibt es
' seit 2026-11-05 in jedem Bau (ueber das Netz, tcp:host:port).
IMPORT "helfer.dh"
dlStarten(["--version"])
DIM dabei AS STRING : dabei = ""
DIM z AS STRING
FOR EACH z IN SPLIT(dlAus, CHR$(10))
    IF LEFT$(TRIM$(z), 6) = "dabei:" THEN dabei = TRIM$(z)
NEXT
PRINT "json "; MODULE_AVAILABLE("json"); " JSON "; MODULE_AVAILABLE("JSON")
PRINT "quatsch "; MODULE_AVAILABLE("quatsch")
PRINT "serial passt "; (MODULE_AVAILABLE("serial") = (INSTR(dabei, "seriell") >= 0))
PRINT "firmata "; MODULE_AVAILABLE("firmata")
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
json TRUE JSON TRUE
quatsch FALSE
serial passt TRUE
firmata TRUE

=== optional an einer datei: fehlt sie, faellt die zeile weg
IMPORT "da.dh" OPTIONAL
IMPORT "fehlt.dh" OPTIONAL
PRINT gruss$()
--- datei da.dh
FUNCTION gruss$() AS STRING
    RETURN "aus da.dh"
END FUNCTION
--- erwartet
aus da.dh

=== ohne optional ist eine fehlende datei weiter ein fehler
IMPORT "fehlt.dh"
PRINT 1
--- fehler
Datei nicht gefunden: fehlt.dh
