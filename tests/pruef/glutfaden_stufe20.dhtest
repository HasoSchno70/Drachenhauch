=== ebene leeren und notiz im kern
IMPORT "helfer.dh"
' Ebene leeren: Rueckgabe, Schritte, was bleibt
DIM m AS kern.Muster : m = kern.pxsLaden("alle.pxs")
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM n AS INTEGER : n = kern.ebeneLeeren(m, v, 1)
PRINT "geleert: "; n; " stiche | schritte "; LEN(v.rueck); " | rueckstiche "; LEN(m.rueckstiche); " | notiz bleibt '"; m.ebenen.ebenen[1].notiz; "'"
PRINT "leere ebene: "; kern.ebeneLeeren(m, v, 1); " | schritte "; LEN(v.rueck)
PRINT "ausserhalb: "; kern.ebeneLeeren(m, v, 7); " "; kern.ebeneLeeren(m, v, -1)
m.ebenen.ebenen[2].gesperrt = TRUE
PRINT "gesperrt: "; kern.ebeneLeeren(m, v, 2); " | stiche dort "; m.ebenen.ebenen[2].stichzahl()
DIM ok AS BOOLEAN : ok = v.zurueckNehmen(m)
PRINT "zurueck: oben "; m.ebenen.ebenen[1].stichzahl(); " | erledigt dort "; m.ebenen.ebenen[1].erledigt[1 * m.breite + 1]
' Notiz: ein Schritt, gleich = keiner
PRINT "notiz: "; kern.ebeneNotizSetzen(m, v, 0, "Grund und Himmel"); " '"; m.ebenen.ebenen[0].notiz; "' | '"; v.textZurueck$(); "'"
PRINT "gleich: "; kern.ebeneNotizSetzen(m, v, 0, "Grund und Himmel"); " | ausserhalb "; kern.ebeneNotizSetzen(m, v, 9, "x")
ok = v.zurueckNehmen(m)
PRINT "zurueck: '"; m.ebenen.ebenen[0].notiz; "'"
ok = v.wiederholen(m)
PRINT "wieder: '"; m.ebenen.ebenen[0].notiz; "'"
' Die Notiz geht mit in die Datei
kern.pxsSpeichern(m, "notiz.pxs")
PRINT "gesichert und gelesen: '"; kern.pxsLaden("notiz.pxs").ebenen.ebenen[0].notiz; "'"
