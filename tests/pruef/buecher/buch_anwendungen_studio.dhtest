    "            PRINT " + CHR$(34) + "system " + CHR$(34) + "; IIF(((bg SHR 16) BAND 255) + ((bg SHR 8) BAND 255) + (bg BAND 255) > 382, " + CHR$(34) + "hell" + CHR$(34) + ", " + CHR$(34) + "dunkel" + CHR$(34) + ")", _
    "            END", _
