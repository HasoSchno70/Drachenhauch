=== mehrere funktionen teilen einen schatten
DIM stand AS INTEGER
FUNCTION plus(n AS INTEGER) AS INTEGER
    stand = stand + n
    RETURN stand
END FUNCTION
FUNCTION doppelt() AS INTEGER
    DIM a AS INTEGER
    a = plus(3)
    stand = stand * 2
    RETURN a + plus(1) + stand
END FUNCTION
