DIM breiteLinks AS INTEGER : breiteLinks = 220
DIM hoeheUnten AS INTEGER : hoeheUnten = 200

SUB willkommenZeigen(an AS BOOLEAN)
    GUI_SET_VISIBLE(lblWkTitel, an) : GUI_SET_VISIBLE(lblWkUnter, an)
    GUI_SET_VISIBLE(btnWkNeu, an) : GUI_SET_VISIBLE(btnWkOeffnen, an) : GUI_SET_VISIBLE(btnWkBeispiele, an)
    GUI_SET_VISIBLE(lblWkZuletzt, an) : GUI_SET_VISIBLE(lstWkZuletzt, an) : GUI_SET_VISIBLE(lblWkKuerzel, an)
END SUB

' --- Einstellungen, Sitzung, zuletzt geoeffnet -----------------------
SUB konfigSichern()
    JSON_SET_BOOL(konfig, "hell", hell)
    JSON_SET_INT(konfig, "schrift", codeGroesse)
    JSON_SET_BOOL(konfig, "umbruch", umbruchAn)
    JSON_SET_BOOL(konfig, "karte", minimapAn)
    JSON_SET_BOOL(konfig, "git_rand", gitRandAn)
    JSON_SET_BOOL(konfig, "regex", regexAn)
    JSON_SET_BOOL(konfig, "vorschlag", vorschlagAn)
    JSON_SET_BOOL(konfig, "linien", linienAn)
    JSON_SET_INT(konfig, "autosichern", autoSichern)
    JSON_SET_JSON(konfig, "zuletzt", JSON_PARSE("[]"))
    DIM p AS STRING
    FOR EACH p IN zuletzt
        JSON_APPEND_STRING(konfig, "zuletzt", p)
    NEXT
    JSON_SET_JSON(konfig, "sitzung", JSON_PARSE("[]"))
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF tabPfade[i] <> "" THEN JSON_APPEND_STRING(konfig, "sitzung", tabPfade[i])
    NEXT
    JSON_SET_INT(konfig, "aktiv", aktiverTab)
    ' Dieselbe Sitzung noch einmal unter dem PROJEKTordner: wer an zwei
    ' Sachen arbeitet, will beim Wechsel nicht die Reiter der anderen
    ' wiederfinden. Der laufende Ordner kommt nach vorn, alte fallen hinten
    ' heraus -- eine Datei, die jeden je besuchten Ordner behaelt, waechst
    ' fuer immer.
    DIM offen AS ARRAY OF STRING : offen = []
    DIM pi AS INTEGER
    FOR pi = 0 TO tabAnzahl - 1
        IF tabPfade[pi] <> "" THEN ARRAY_PUSH(offen, tabPfade[pi])
    NEXT
    DIM alt AS INTEGER : alt = ARRAY_INDEXOF(projOrdner, projektOrdner)
    IF alt >= 0 THEN
        ARRAY_REMOVE_AT(projOrdner, alt) : ARRAY_REMOVE_AT(projDateien, alt) : ARRAY_REMOVE_AT(projAktiv, alt)
    END IF
    ARRAY_INSERT(projOrdner, 0, projektOrdner)
    ARRAY_INSERT(projDateien, 0, JOIN$(offen, "|"))
    ARRAY_INSERT(projAktiv, 0, aktiverTab)
    WHILE LEN(projOrdner) > PROJEKTE_MAX
        DIM letzt AS INTEGER : letzt = LEN(projOrdner) - 1
        ARRAY_REMOVE_AT(projOrdner, letzt) : ARRAY_REMOVE_AT(projDateien, letzt) : ARRAY_REMOVE_AT(projAktiv, letzt)
    WEND
    JSON_SET_JSON(konfig, "projekte", JSON_NEW_ARRAY())
    DIM pk AS INTEGER
    FOR pk = 0 TO LEN(projOrdner) - 1
        DIM e AS JSON_HANDLE : e = JSON_NEW_OBJECT()
        JSON_SET_STRING(e, "ordner", projOrdner[pk])
        JSON_SET_INT(e, "aktiv", projAktiv[pk])
        JSON_SET_JSON(e, "sitzung", JSON_NEW_ARRAY())
        DIM sp AS STRING
        IF projDateien[pk] <> "" THEN
            FOR EACH sp IN SPLIT$(projDateien[pk], "|")
                JSON_APPEND_STRING(e, "sitzung", sp)
            NEXT
        END IF
        JSON_APPEND_JSON(konfig, "projekte", e)
    NEXT
    TRY
        MKDIR(DIRNAME(konfigPfad))
        WRITEALL(konfigPfad, JSON_STRINGIFY(konfig))
    CATCH e
        ' ein schreibgeschuetztes Profil ist kein Grund, die Arbeit zu stoeren
    END TRY
END SUB

SUB zuletztAnzeigen()
    DIM k AS INTEGER
    FOR k = 0 TO ZULETZT_MAX - 1
        IF k < LEN(zuletzt) THEN
            GUI_MENU_TEXT(miZuletzt[k], BASENAME(zuletzt[k]) + "   (" + DIRNAME(zuletzt[k]) + ")")
            GUI_MENU_ENABLE(miZuletzt[k], TRUE)
        ELSE
            GUI_MENU_TEXT(miZuletzt[k], "-")
            GUI_MENU_ENABLE(miZuletzt[k], FALSE)
        END IF
    NEXT
    GUI_LISTBOX_CLEAR(lstWkZuletzt)
    FOR k = 0 TO LEN(zuletzt) - 1
        GUI_LISTBOX_ADD(lstWkZuletzt, BASENAME(zuletzt[k]) + "   (" + DIRNAME(zuletzt[k]) + ")")
    NEXT
END SUB

SUB zuletztMerken(pfad AS STRING)
    IF pfad = "" THEN RETURN
    DIM k AS INTEGER : k = ARRAY_INDEXOF(zuletzt, pfad)
    IF k >= 0 THEN ARRAY_REMOVE_AT(zuletzt, k)
    ARRAY_INSERT(zuletzt, 0, pfad)
    WHILE LEN(zuletzt) > ZULETZT_MAX : ARRAY_REMOVE_AT(zuletzt, LEN(zuletzt) - 1) : WEND
    zuletztAnzeigen()
    konfigSichern()
END SUB

SUB schriftSetzen(groesse AS INTEGER)
    codeGroesse = MAX(10, MIN(32, groesse))
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_SET_FONT_SIZE(tabFelder[i], codeGroesse)
    NEXT
    GUI_SET_TEXT(lblStatus, "Schrift: " + STR$(codeGroesse) + " px")
    konfigSichern()
END SUB

SUB debugPanelZeigen(an AS BOOLEAN)
    debugSichtbar = an
    GUI_SET_VISIBLE(lblProbleme, NOT an) : GUI_SET_VISIBLE(lstProbleme, NOT an) : GUI_SET_VISIBLE(lblHilfe, NOT an)
    GUI_SET_VISIBLE(lblDebug, an) : GUI_SET_VISIBLE(tblVars, an)
    GUI_SET_VISIBLE(btnWeiter, an) : GUI_SET_VISIBLE(btnDrueber, an) : GUI_SET_VISIBLE(btnHinein, an)
    GUI_SET_VISIBLE(btnHeraus, an) : GUI_SET_VISIBLE(btnStoppD, an)
END SUB

SUB layout()
    DIM w AS INTEGER : w = SCREENWIDTH()
    DIM h AS INTEGER : h = SCREENHEIGHT()
    GUI_WINDOW_SET_BOUNDS(win, 0, 0, w, h)
    ' Widget-Koordinaten zaehlen ab dem INHALT: Menueleiste und Reiterleiste
    ' liegen darueber (zusammen 56 px) und gehen von der Hoehe ab -- sonst
    ' rutschen Eingabezeile und Status unter den Fensterrand (Stand 1 tat das).
    DIM kopf AS INTEGER : kopf = 56
    DIM hi AS INTEGER : hi = h - kopf
    DIM oben AS INTEGER : oben = 4
    DIM statusH AS INTEGER : statusH = 24
    DIM eingabeH AS INTEGER : eingabeH = 30
    DIM mitteH AS INTEGER : mitteH = hi - oben - hoeheUnten - statusH - eingabeH - 12
    ' links: Projektbaum oben, Gliederung darunter
    DIM baumH AS INTEGER : baumH = (mitteH - 22) * 3 \ 5
    GUI_SET_BOUNDS(lblProjekt, 8, oben, breiteLinks - 16, 18)
    GUI_SET_BOUNDS(baum, 8, oben + 22, breiteLinks - 16, baumH)
    GUI_SET_BOUNDS(lblGliederung, 8, oben + 30 + baumH, breiteLinks - 16, 18)
    GUI_SET_BOUNDS(lstGliederung, 8, oben + 52 + baumH, breiteLinks - 16, mitteH - baumH - 52)
    DIM ex AS INTEGER : ex = breiteLinks
    DIM ew AS INTEGER : ew = w - breiteLinks - 8
    ' Die Spur steht ueber dem Code und nimmt sich 20 Punkte von seiner Hoehe.
    DIM spurH AS INTEGER : spurH = 20
    GUI_SET_BOUNDS(lblSpur, ex + 4, oben, ew - 8, 18)
    GUI_SET_VISIBLE(lblSpur, tabAnzahl > 0)
    oben = oben + spurH
    mitteH = mitteH - spurH
    ' Die Uebersichtskarte nimmt sich einen Streifen am rechten Rand.
    DIM kartenB AS INTEGER : kartenB = 0
    IF minimapAn THEN kartenB = 92
    GUI_SET_VISIBLE(karte, minimapAn)
    IF minimapAn THEN GUI_SET_BOUNDS(karte, ex + ew - kartenB, oben, kartenB - 6, mitteH)
    ew = ew - kartenB
    ' Geteilt: der linke Reiter bekommt die linke Haelfte, alle anderen die
    ' rechte -- so hat jede Haelfte ein ECHTES Feld, keine Spiegelung.
    DIM halbeB AS INTEGER : halbeB = (ew - 6) \ 2
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF geteilt AND linkerTab >= 0 AND linkerTab < tabAnzahl AND i = linkerTab THEN
            GUI_SET_BOUNDS(tabFelder[i], ex, oben, halbeB, mitteH)
        ELSEIF geteilt AND linkerTab >= 0 AND linkerTab < tabAnzahl THEN
            GUI_SET_BOUNDS(tabFelder[i], ex + halbeB + 6, oben, ew - halbeB - 6, mitteH)
        ELSE
            GUI_SET_BOUNDS(tabFelder[i], ex, oben, ew, mitteH)
        END IF
    NEXT
    ' Willkommensseite auf derselben Flaeche
    DIM wx AS INTEGER : wx = ex + 40
    GUI_SET_BOUNDS(lblWkTitel, wx, oben + 30, ew - 80, 44)
    GUI_SET_BOUNDS(lblWkUnter, wx, oben + 84, ew - 80, 18)
    GUI_SET_WRAP(lblWkUnter, ew - 80)
    GUI_SET_BOUNDS(btnWkNeu, wx, oben + 130, 130, 30)
    GUI_SET_BOUNDS(btnWkOeffnen, wx + 140, oben + 130, 150, 30)
    GUI_SET_BOUNDS(btnWkBeispiele, wx + 300, oben + 130, 180, 30)
    GUI_SET_BOUNDS(lblWkZuletzt, wx, oben + 180, ew - 80, 18)
    DIM zlH AS INTEGER : zlH = MAX(60, MIN(230, mitteH - 320))
    GUI_SET_BOUNDS(lstWkZuletzt, wx, oben + 202, MIN(ew - 80, 620), zlH)
    GUI_SET_BOUNDS(lblWkKuerzel, wx, oben + 214 + zlH, MIN(ew - 80, 620), 18)
    GUI_SET_WRAP(lblWkKuerzel, MIN(ew - 80, 620))
    willkommenZeigen(tabAnzahl = 0)
    DIM uy AS INTEGER : uy = oben + mitteH + 4
    DIM halb AS INTEGER : halb = (w - 24) \ 2
    GUI_SET_BOUNDS(lblAusgabe, 8, uy, 200, 18)
    GUI_SET_BOUNDS(lstAusgabe, 8, uy + 20, halb, hoeheUnten - 20)
    GUI_SET_BOUNDS(lblProbleme, 16 + halb, uy, halb, 18)
    GUI_SET_BOUNDS(lstProbleme, 16 + halb, uy + 20, halb, (hoeheUnten - 20) \ 2 - 4)
    GUI_SET_BOUNDS(lblHilfe, 16 + halb, uy + 20 + (hoeheUnten - 20) \ 2, halb, (hoeheUnten - 20) \ 2)
    GUI_SET_WRAP(lblHilfe, halb - 8)
    ' Debugger-Panel auf derselben Flaeche
    GUI_SET_BOUNDS(lblDebug, 16 + halb, uy, halb, 18)
    GUI_SET_BOUNDS(btnWeiter, 16 + halb, uy + 20, 100, 26)
    GUI_SET_BOUNDS(btnDrueber, 122 + halb, uy + 20, 108, 26)
    GUI_SET_BOUNDS(btnHinein, 236 + halb, uy + 20, 104, 26)
    GUI_SET_BOUNDS(btnHeraus, 346 + halb, uy + 20, 70, 26)
    GUI_SET_BOUNDS(btnStoppD, 422 + halb, uy + 20, 60, 26)
    GUI_SET_BOUNDS(tblVars, 16 + halb, uy + 52, halb, hoeheUnten - 52)
    debugPanelZeigen(debugSichtbar)
    DIM ey AS INTEGER : ey = hi - statusH - eingabeH - 4
    GUI_SET_BOUNDS(tfEingabe, 8, ey, w - 108, 26)
    GUI_SET_BOUNDS(btnEingabe, w - 92, ey, 84, 26)
    GUI_SET_BOUNDS(lblStatus, 8, hi - statusH, w - 16, 18)
END SUB

' --- Reiter ------------------------------------------------------------
SUB reiterNeuSetzen()
    DIM titel[MAX(tabAnzahl, 1)] AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        DIM t AS STRING
        IF tabPfade[i] = "" THEN t = "Unbenannt" ELSE t = BASENAME(tabPfade[i])
        IF GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN t = t + " *"
        titel[i] = t
    NEXT
    IF tabAnzahl = 0 THEN titel[0] = "Drachenhauch"
    GUI_TABS(win, titel)
    IF aktiverTab >= 0 THEN GUI_SET_ACTIVE_TAB(win, aktiverTab)
END SUB

SUB feldEinrichten(ta AS GUI_WIDGET)
    IF codeFont >= 0 THEN GUI_SET_FONT(ta, codeFont)
    GUI_SET_FONT_SIZE(ta, codeGroesse)
    GUI_TEXTAREA_SET(ta, "zeilennummern", 1)
    GUI_TEXTAREA_SET(ta, "aktive_zeile", 1)
    GUI_TEXTAREA_SET(ta, "tab_fuegt_ein", 1)
    GUI_TEXTAREA_SET(ta, "tabbreite", 4)
    GUI_TEXTAREA_SET(ta, "umbruch", IIF(umbruchAn, 1, 0))
    GUI_TEXTAREA_SET(ta, "einzugslinien", IIF(linienAn, 1, 0))
    ' Einrueckung beim Umbruch: die Laufzeit uebernimmt die der laufenden
    ' Zeile, die Woerter der SPRACHE kommen von hier. `THEN` steht in der
    ' Ende-Liste, weil `IF x THEN y = 1` sonst auch einruecken wuerde.
    GUI_TEXTAREA_SET(ta, "auto_einzug", 1)
    ' Der Tabulator klappt einen Schnipsel auf, wenn sein Kuerzel links der
    ' Marke steht -- sonst rueckt er ein wie immer.
    GUI_TEXTAREA_ABBREV(ta, schnipselAbk)
    GUI_TEXTAREA_INDENT_WORDS(ta, _
        ["SUB", "FUNCTION", "CLASS", "STRUCT", "PROPERTY", "OPERATOR", "FOR", _
         "WHILE", "REPEAT", "DO", "SELECT", "CASE", "TRY", "WITH", "ELSE", _
         "ELSEIF", "ELIF", "CATCH", "FINALLY", "ENUM"], _
        ["THEN"], _
        ["END", "NEXT", "WEND", "UNTIL", "LOOP", "ELSE", "ELSEIF", "ELIF", _
         "CATCH", "FINALLY", "CASE"])
END SUB

' Einrueckungslinien: ein Strich je Stufe, unter dem Text. Wie der Umbruch
' fuer ALLE Reiter.
SUB linienSetzen(an AS BOOLEAN)
    linienAn = an
    GUI_MENU_CHECK(miLinien, an)
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_TEXTAREA_SET(tabFelder[i], "einzugslinien", IIF(an, 1, 0))
    NEXT
    GUI_SET_TEXT(lblStatus, IIF(an, "Einrueckungslinien an.", "Einrueckungslinien aus."))
    protokoll("linien " + IIF(an, "an", "aus"))
    konfigSichern()
END SUB

' Der Umbruch gilt fuer ALLE Reiter, nicht nur den vorderen -- ein Schalter,
' der je Datei etwas anderes tut, ist einer, den man vergisst.
SUB umbruchSetzen(an AS BOOLEAN)
    umbruchAn = an
    GUI_MENU_CHECK(miUmbruch, an)
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        GUI_TEXTAREA_SET(tabFelder[i], "umbruch", IIF(an, 1, 0))
    NEXT
    GUI_SET_TEXT(lblStatus, IIF(an, "Zeilenumbruch an.", "Zeilenumbruch aus."))
    konfigSichern()
END SUB

' --- Einstellungen ----------------------------------------------------
' Was im Ueber-Kasten steht. Die Fassung kommt von der LAUFZEIT (VERSION$),
' nicht aus einem Text im Quelltext -- der stand hier auf "Stand 7", als die
' IDE laengst weiter war.
FUNCTION ueberText$() AS STRING
    RETURN "Drachenhauch-IDE -- geschrieben in Drachenhauch." + NL + _
           "Laufzeit: dhrt " + VERSION$() + NL + _
           "Handbuch: " + docsOrdner + NL + _
           "Beispiele: " + beispielOrdner
END FUNCTION

SUB einstellungenZeigen()
    GUI_SET_CHECKED(cbHell, hell)
    GUI_SET_CHECKED(cbUmbruch, umbruchAn)
    GUI_SET_CHECKED(cbKarte, minimapAn)
    GUI_SET_CHECKED(cbGit, gitRandAn)
    GUI_SET_CHECKED(cbRegex, regexAn)
    GUI_SET_CHECKED(cbVorschlag, vorschlagAn)
    GUI_SET_CHECKED(cbLinien, linienAn)
    GUI_SET_VALUE(spSchrift, codeGroesse)
    GUI_SET_VALUE(spAuto, autoSichern)
    GUI_WINDOW_SET_BOUNDS(winEinst, (SCREENWIDTH() - 420) \ 2, 150, 420, 400)
    GUI_WINDOW_VISIBLE(winEinst, TRUE)
    einstOffen = TRUE
    GUI_FOCUS(cbHell)
    protokoll("einstellungen auf")
END SUB

' Die Schalter wirken SOFORT, ohne [Uebernehmen]: ein Thema, das man erst
' nach dem Schliessen sieht, waehlt man blind.
SUB einstellungenNachziehen()
    IF NOT einstOffen THEN RETURN
    IF GUI_CHECKED(cbHell) <> hell THEN befehl("thema")
    IF GUI_CHECKED(cbUmbruch) <> umbruchAn THEN umbruchSetzen(GUI_CHECKED(cbUmbruch))
    IF GUI_CHECKED(cbKarte) <> minimapAn THEN minimapSetzen(GUI_CHECKED(cbKarte))
    IF GUI_CHECKED(cbGit) <> gitRandAn THEN befehl("git_rand")
    IF GUI_CHECKED(cbRegex) <> regexAn THEN befehl("regex")
    IF GUI_CHECKED(cbVorschlag) <> vorschlagAn THEN
        vorschlagAn = GUI_CHECKED(cbVorschlag)
        IF NOT vorschlagAn THEN vervollSchliessen()
        konfigSichern()
    END IF
    IF GUI_CHECKED(cbLinien) <> linienAn THEN linienSetzen(GUI_CHECKED(cbLinien))
    IF INT(GUI_VALUE(spSchrift)) <> codeGroesse THEN schriftSetzen(INT(GUI_VALUE(spSchrift)))
    IF INT(GUI_VALUE(spAuto)) <> autoSichern THEN
        autoSichern = INT(GUI_VALUE(spAuto))
        konfigSichern()
        protokoll("autosichern " + STR$(autoSichern))
    END IF
END SUB

' --- Eingebaute Befehle nachschlagen ----------------------------------
' Die Liste kommt aus CODE_COMPLETE mit leerem Text: das sind alle Namen,
' die die Vervollstaendigung ueberhaupt kennt. Die Beschreibung holt
' derselbe CODE_HOVER$ wie die Statuszeile -- ueber einen Text, der nur
' aus dem Namen besteht.
SUB befehleFuellen(filter AS STRING)
    IF LEN(alleBefehle) = 0 THEN alleBefehle = CODE_COMPLETE("", 1, 1)
    GUI_LISTBOX_CLEAR(lstBefehle)
    gezeigteBefehle = []
    DIM klein AS STRING : klein = LOWER$(filter)
    DIM b AS STRING
    FOR EACH b IN alleBefehle
        IF LEN(gezeigteBefehle) >= 400 THEN BREAK
        IF klein = "" OR passtUnscharf(b, klein) THEN
            GUI_LISTBOX_ADD(lstBefehle, b)
            ARRAY_PUSH(gezeigteBefehle, b)
        END IF
    NEXT
    GUI_SET_TEXT(lblBefehlZahl, STR$(LEN(gezeigteBefehle)) + " von " + STR$(LEN(alleBefehle)))
    IF LEN(gezeigteBefehle) > 0 THEN GUI_LISTBOX_SET_SELECTED(lstBefehle, 0)
    befehlWahlZuletzt = -2
END SUB

SUB befehleZeigen()
    GUI_SET_TEXT(tfBefehlFilter, "")
    befehlFilterZuletzt = ""
    befehleFuellen("")
    GUI_WINDOW_VISIBLE(winBefehle, TRUE)
    GUI_FOCUS(tfBefehlFilter)
    protokoll("befehle " + STR$(LEN(alleBefehle)))
END SUB

SUB befehleNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winBefehle) THEN RETURN
    IF GUI_TEXT(tfBefehlFilter) <> befehlFilterZuletzt THEN
        befehlFilterZuletzt = GUI_TEXT(tfBefehlFilter)
        befehleFuellen(befehlFilterZuletzt)
    END IF
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstBefehle)
    IF sel = befehlWahlZuletzt THEN RETURN
    befehlWahlZuletzt = sel
    IF sel < 0 OR sel >= LEN(gezeigteBefehle) THEN RETURN
    DIM name AS STRING : name = gezeigteBefehle[sel]
    DIM md AS STRING : md = CODE_HOVER$(name, 1, 1)
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, "```", "")
    IF TRIM$(md) = "" THEN md = name + NL + NL + "(keine Beschreibung -- meist ein Schluesselwort der Sprache)"
    GUI_SET_TEXT(taBefehlDoku, TRIM$(md))
END SUB

SUB befehlEinfuegen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstBefehle)
    IF sel < 0 OR sel >= LEN(gezeigteBefehle) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_WINDOW_VISIBLE(winBefehle, FALSE)
    GUI_FOCUS(ta)
    GUI_TEXTAREA_INSERT(ta, gezeigteBefehle[sel])
    protokoll("befehl eingefuegt " + gezeigteBefehle[sel])
END SUB

' --- Definition hier zeigen (Peek) -------------------------------------
' Zehn Zeilen um die Definition, ohne die Datei zu verlassen. Wer doch
' hin will, hat den Knopf -- das ist F12.
SUB peekZeigen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM dz AS INTEGER
    DIM ds AS INTEGER
    (dz, ds) = CODE_DEFINITION(q, z, s)
    peekPfad = ""
    IF dz < 1 THEN
        ' Nicht in dieser Datei -- der Symbolindex sieht das ganze Projekt.
        DIM k AS INTEGER : k = symbolSuchen(wortUnterMarke$())
        IF k < 0 THEN
            GUI_SET_TEXT(lblStatus, "Keine Definition zu '" + wortUnterMarke$() + "' -- auch nicht im Projekt.")
            RETURN
        END IF
        peekPfad = symPfade[k]
        dz = symZeilen[k]
        DIM offen AS INTEGER : offen = tabMitPfad(peekPfad)
        IF offen >= 0 THEN
            q = GUI_TEXT(tabFelder[offen])
        ELSE
            q = dateiLesen(peekPfad)
        END IF
    END IF
    peekZeile = dz
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(q, NL)
    DIM von AS INTEGER : von = MAX(1, dz - 1)
    DIM bis AS INTEGER : bis = MIN(LEN(zeilen), dz + 9)
    DIM text AS STRING : text = ""
    DIM i AS INTEGER
    FOR i = von TO bis
        text = text + PADL$(STR$(i), 5) + "  " + zeilen[i - 1] + NL
    NEXT
    GUI_SET_TEXT(taPeek, text)
    GUI_SET_TEXT(lblPeek, wortUnterMarke$() + " -- " + IIF(peekPfad = "", "", BASENAME(peekPfad) + ", ") + "Zeile " + STR$(dz))
    GUI_WINDOW_SET_BOUNDS(winPeek, (SCREENWIDTH() - 720) \ 2, 240, 720, 300)
    GUI_WINDOW_VISIBLE(winPeek, TRUE)
    GUI_FOCUS(taPeek)
    ' Die Datei steht nur dann dabei, wenn es eine ANDERE ist -- sonst
    ' haette eine neue Zeilenform die Proben von Stand 7 gebrochen.
    protokoll("peek " + STR$(dz) + IIF(peekPfad = "", "", " " + BASENAME(peekPfad)))
END SUB

' --- Farbwaehler am Literal -------------------------------------------
SUB farbfeldNachziehen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM k AS INTEGER : k = GUI_TEXTAREA_SWATCH_CLICKED(ta)
    IF k < 0 OR k >= LEN(farbStellen) THEN RETURN
    farbStart = farbStellen[k]
    farbLaenge = farbLaengen[k]
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM roh AS STRING : roh = MID$(q, farbStart + 2, farbLaenge - 2)
    IF LEN(roh) = 8 THEN roh = RIGHT$(roh, 6)
    GUI_SET_PICKED_COLOR(cpFarbe, COLOR_FROM_HEX("#" + roh))
    GUI_SET_TEXT(lblFarbe, "&H" + roh)
    GUI_WINDOW_SET_BOUNDS(winFarbe, (SCREENWIDTH() - 320) \ 2, 200, 320, 300)
    GUI_WINDOW_VISIBLE(winFarbe, TRUE)
    GUI_FOCUS(cpFarbe)
    protokoll("farbfeld " + STR$(farbStart))
END SUB

SUB farbeUebernehmen()
    GUI_WINDOW_VISIBLE(winFarbe, FALSE)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR farbStart < 0 THEN RETURN
    DIM neu AS STRING : neu = "&H" + UPPER$(RIGHT$(COLOR_HEX$(GUI_PICKED_COLOR(cpFarbe)), 6))
    ' Aus der Zeichenstelle wieder Zeile und Spalte machen -- GUI_TEXTAREA_SELECT
    ' rechnet in Zeilen, die Abschnitte in Zeichen.
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(LEFT$(q, farbStart), NL)
    DIM z AS INTEGER : z = LEN(zeilen)
    DIM s AS INTEGER : s = LEN(zeilen[z - 1]) + 1
    GUI_TEXTAREA_SELECT(ta, z, s, z, s + farbLaenge)
    GUI_TEXTAREA_INSERT(ta, neu)
    GUI_FOCUS(ta)
    faerbSchluessel = "-"
    GUI_SET_TEXT(lblStatus, "Farbe: " + neu)
    protokoll("farbe " + neu)
    farbStart = -1
END SUB

' --- Geteilte Ansicht -------------------------------------------------
' Links ein zweiter Reiter, rechts der aktive. Beide sind ECHTE Code-Felder;
' zwei Ansichten auf DIESELBE Datei waeren ein Abgleich, den man bei jedem
' Anschlag fuehren muesste -- und GUI_SET_TEXT leerte dabei jedes Mal den
' Verlauf und schoebe die Marke ans Ende.
SUB geteiltSetzen(an AS BOOLEAN)
    IF an AND tabAnzahl < 2 THEN
        GUI_SET_TEXT(lblStatus, "Geteilte Ansicht: dafuer braucht es zwei offene Dateien.")
        RETURN
    END IF
    IF NOT an AND linkerTab >= 0 AND linkerTab < tabAnzahl THEN
        ' Zurueck auf seinen eigenen Reiter -- sonst bliebe das Feld
        ' ueber allen Reitern stehen.
        GUI_SET_TAB(tabFelder[linkerTab], linkerTab)
    END IF
    geteilt = an
    IF an THEN
        linkerTab = IIF(aktiverTab = 0, 1, 0)
        ' -1 heisst "auf jedem Reiter sichtbar" -- nur so stehen zwei
        ' Felder gleichzeitig im Bild.
        GUI_SET_TAB(tabFelder[linkerTab], -1)
    ELSE
        linkerTab = -1
    END IF
    GUI_MENU_CHECK(miGeteilt, geteilt)
    layout()
    GUI_SET_TEXT(lblStatus, IIF(geteilt, "Geteilt: links " + BASENAME(tabPfade[linkerTab]), "Geteilte Ansicht aus."))
    ' Die Lagen mitschreiben: dass der Befehl LIEF, sagt nichts darueber, ob
    ' die beiden Felder auch nebeneinander liegen.
    IF geteilt THEN
        protokoll("geteilt " + STR$(linkerTab) + " x " + STR$(GUI_GET_X(tabFelder[linkerTab])) + "+" + STR$(GUI_GET_W(tabFelder[linkerTab])) + " " + STR$(GUI_GET_X(tabFelder[aktiverTab])) + "+" + STR$(GUI_GET_W(tabFelder[aktiverTab])))
    ELSE
        protokoll("geteilt aus")
    END IF
END SUB

' Der linke Reiter darf nicht derselbe sein wie der aktive -- ein Widget
' kann nicht zweimal im Bild stehen. Beim Wechsel tauschen die beiden.
SUB geteiltNachziehen(vorher AS INTEGER)
    IF NOT geteilt THEN RETURN
    IF linkerTab <> aktiverTab THEN RETURN
    IF vorher < 0 OR vorher >= tabAnzahl OR vorher = aktiverTab THEN
        geteiltSetzen(FALSE)
        RETURN
    END IF
    GUI_SET_TAB(tabFelder[linkerTab], linkerTab)
    linkerTab = vorher
    GUI_SET_TAB(tabFelder[linkerTab], -1)
    layout()
END SUB

' --- Uebersichtskarte --------------------------------------------------
' Eine Zeile ist ein Strich, so breit wie sie lang ist; der sichtbare
' Ausschnitt liegt als heller Kasten darueber. Ein Klick springt.
SUB minimapZeichnen()
    IF NOT minimapAn THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM cx AS INTEGER : cx = GUI_CANVAS_X(karte)
    DIM cy AS INTEGER : cy = GUI_CANVAS_Y(karte)
    DIM cw AS INTEGER : cw = GUI_CANVAS_W(karte)
    DIM ch AS INTEGER : ch = GUI_CANVAS_H(karte)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM n AS INTEGER : n = LEN(zeilen)
    IF n = 0 THEN RETURN
    ' So viele Zeilen wie Platz ist, sonst zusammengefasst: bei 3000 Zeilen
    ' und 600 Punkten Hoehe steht eine Zeile fuer fuenf.
    DIM proZeile AS INTEGER : proZeile = MAX(1, (n + ch - 1) \ ch)
    DIM y AS INTEGER : y = 0
    DIM i AS INTEGER
    FOR i = 0 TO n - 1 STEP proZeile
        DIM zt AS STRING : zt = zeilen[i]
        DIM roh AS STRING : roh = LTRIM$(zt)
        IF roh <> "" THEN
            ' Wort fuer Wort statt ein Strich je Zeile: so sieht man in der
            ' Karte, WO in der Datei man ist -- ein gleichmaessiger Balken
            ' sieht ueberall gleich aus.
            DIM einzugX AS INTEGER : einzugX = MIN(cw \ 3, (LEN(zt) - LEN(roh)) * 2)
            DIM x AS INTEGER : x = cx + 2 + einzugX
            DIM grund AS INTEGER : grund = &H60708A
            IF LEFT$(roh, 1) = "'" THEN grund = F_KOMMENTAR
            DIM wt AS STRING
            FOR EACH wt IN SPLIT$(roh, " ")
                DIM bw AS INTEGER : bw = LEN(wt) * 2
                IF wt <> "" AND x < cx + cw - 3 THEN
                    BOX(x, cy + y, MIN(x + bw - 2, cx + cw - 3), cy + y, grund)
                END IF
                x = x + bw + 2
            NEXT
        END IF
        y = y + 1
        IF y >= ch THEN BREAK
    NEXT
    ' Der sichtbare Ausschnitt als heller Rahmen.
    DIM erste AS INTEGER
    DIM sicht AS INTEGER
    DIM von AS INTEGER
    DIM laenge AS INTEGER
    (erste, sicht, von, laenge) = GUI_TEXTAREA_VIEW(ta)
    DIM y0 AS INTEGER : y0 = cy + erste \ proZeile
    DIM y1 AS INTEGER : y1 = cy + MIN(ch, (erste + sicht) \ proZeile)
    BOX(cx + 1, y0, cx + cw - 2, y1, &H20FFFFFF)
    RECT(cx + 1, y0, cx + cw - 2, y1, &H60A8C8E0)
    ' Klick: dorthin springen. Die Leinwand nimmt selbst keine Klicks an,
    ' der Treffertest ist deshalb von Hand.
    IF MOUSE_HIT(1) AND MOUSEX() >= cx AND MOUSEX() < cx + cw AND MOUSEY() >= cy AND MOUSEY() < cy + ch THEN
        DIM ziel AS INTEGER : ziel = (MOUSEY() - cy) * proZeile + 1
        GUI_TEXTAREA_GOTO(ta, MAX(1, MIN(n, ziel)), 1)
        GUI_FOCUS(ta)
        protokoll("karte sprung " + STR$(MAX(1, MIN(n, ziel))))
    END IF
END SUB

SUB minimapSetzen(an AS BOOLEAN)
    minimapAn = an
    GUI_MENU_CHECK(miMinimap, an)
    layout()
    konfigSichern()
    protokoll("karte " + IIF(an, "an", "aus"))
END SUB

' --- Faltung ----------------------------------------------------------
SUB faltenUmschalten()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF faltSchluessel = "-" THEN gliederungFuellen(GUI_TEXT(ta))
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zu AS BOOLEAN : zu = GUI_TEXTAREA_FOLD(ta, z)
    GUI_FOCUS(ta)
    protokoll("falte " + STR$(z) + IIF(zu, " zu", " auf"))
END SUB

SUB faltenAlle(zu AS BOOLEAN)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF faltSchluessel = "-" THEN gliederungFuellen(GUI_TEXT(ta))
    DIM n AS INTEGER : n = GUI_TEXTAREA_FOLD_ALL(ta, zu)
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, IIF(zu, STR$(n) + " Bloecke zugeklappt.", "Alles aufgeklappt."))
    protokoll("falten alle " + STR$(n))
END SUB

FUNCTION dateiLesen(pfad AS STRING) AS STRING
    DIM zeilen AS ARRAY OF STRING
    zeilen = READLINES(pfad)
    RETURN JOIN$(zeilen, NL)
END FUNCTION

' Derselbe Weg, EINE Schreibweise. Von der Kommandozeile kommt er mit
' Rueckstrichen, aus PATHJOIN mit Schraegstrichen -- verglichen wurde bis
' hierher wortwoertlich, und dieselbe Datei bekam aus dem Projektbaum einen
' ZWEITEN Reiter. Gross/klein bleibt, wie es ist: unter Linux sind es zwei
' verschiedene Dateien.
FUNCTION wegGleich$(pfad AS STRING) AS STRING
    RETURN REPLACE$(pfad, CHR$(92), "/")
END FUNCTION

SUB tabOeffnen(pfad AS STRING, inhalt AS STRING)
    IF tabAnzahl >= MAX_TABS THEN
        GUI_SET_TEXT(lblStatus, "Hoechstens " + STR$(MAX_TABS) + " Reiter -- erst einen schliessen.")
        RETURN
    END IF
    ' Schon offen? Dann nur hin.
    DIM i AS INTEGER
    IF pfad <> "" THEN
        FOR i = 0 TO tabAnzahl - 1
            IF wegGleich$(tabPfade[i]) = wegGleich$(pfad) THEN
                aktiverTab = i
                reiterNeuSetzen()
                GUI_FOCUS(tabFelder[i])
                RETURN
            END IF
        NEXT
    END IF
    DIM ta AS GUI_WIDGET
    ta = GUI_TEXTAREA(win, 0, 0, 10, 10)
    feldEinrichten(ta)
    GUI_SET_TEXT(ta, inhalt)
    GUI_SET_TAB(ta, tabAnzahl)
    tabPfade[tabAnzahl] = pfad
    tabFelder[tabAnzahl] = ta
    tabGesichert[tabAnzahl] = inhalt
    tabLetzterText[tabAnzahl] = ""
    aktiverTab = tabAnzahl
    tabAnzahl = tabAnzahl + 1
    reiterNeuSetzen()
    layout()
    GUI_FOCUS(ta)
    GUI_TEXTAREA_GOTO(ta, 1, 1)
    pruefungFaellig = GET_TIME()
    protokoll("geoeffnet " + pfad)
END SUB

SUB dateiOeffnen(pfad AS STRING)
    IF NOT FILEEXISTS(pfad) THEN
        GUI_SET_TEXT(lblStatus, "Gibt es nicht: " + pfad)
        RETURN
    END IF
    tabOeffnen(pfad, dateiLesen(pfad))
    projektOrdner = DIRNAME(pfad)
    baumFuellen()
    zuletztMerken(pfad)
    GUI_SET_TEXT(lblStatus, pfad)
END SUB

FUNCTION aktivesFeld() AS GUI_WIDGET
    IF aktiverTab < 0 THEN RETURN -1
    RETURN tabFelder[aktiverTab]
END FUNCTION

FUNCTION sichern(i AS INTEGER, alsNeu AS BOOLEAN) AS BOOLEAN
    IF i < 0 THEN RETURN FALSE
    DIM pfad AS STRING : pfad = tabPfade[i]
    IF pfad = "" OR alsNeu THEN
        pfad = FILE_SAVE_DIALOG("Sichern unter", "programm.dh", "dh")
        IF pfad = "" THEN RETURN FALSE
        tabPfade[i] = pfad
    END IF
    DIM text AS STRING : text = GUI_TEXT(tabFelder[i])
    tabGesichert[i] = text
    ' Die Datei endet mit einem Umbruch (dateiLesen laesst ihn weg, das Feld
    ' kennt ihn nicht) -- sonst verloere jede gesicherte Datei ihre letzte
    ' Zeile im Diff ("no newline at end of file"). Bis Stand 3 war das so.
    IF text <> "" AND RIGHT$(text, 1) <> NL THEN text = text + NL
    WRITEALL(pfad, text)
    reiterNeuSetzen()
    zuletztMerken(pfad)
    GUI_SET_TEXT(lblStatus, "Gesichert: " + pfad)
    protokoll("gesichert " + pfad)
    IF DIRNAME(pfad) <> projektOrdner THEN
        projektOrdner = DIRNAME(pfad)
        baumFuellen()
    END IF
    RETURN TRUE
END FUNCTION

' Alle Reiter ausser dem vorderen zumachen. Von HINTEN nach vorn, damit die
' Nummern der noch offenen gueltig bleiben -- tabSchliessen rueckt sie auf.
SUB andereSchliessen()
    IF aktiverTab < 0 THEN RETURN
    DIM behalten AS GUI_WIDGET : behalten = tabFelder[aktiverTab]
    DIM weg AS INTEGER : weg = 0
    DIM i AS INTEGER
    FOR i = tabAnzahl - 1 TO 0 STEP -1
        IF tabFelder[i] <> behalten THEN
            tabSchliessen(i)
            weg = weg + 1
        END IF
    NEXT
    GUI_SET_TEXT(lblStatus, STR$(weg) + " Reiter geschlossen.")
    protokoll("andere zu " + STR$(weg))
END SUB

SUB tabSchliessen(i AS INTEGER)
    IF i < 0 OR i >= tabAnzahl THEN RETURN
    ' Den Pfad merken: Strg+Umschalt+T holt ihn zurueck. Nur gesicherte
    ' Dateien -- ein leerer Reiter haette nichts, was wiederzufinden waere.
    IF tabPfade[i] <> "" THEN ARRAY_PUSH(zuGemacht, tabPfade[i])
    ' Die Reiter ruecken auf, der linke der geteilten Ansicht zeigte danach
    ' auf eine andere Datei -- lieber ganz aus als still auf die falsche.
    IF geteilt THEN geteiltSetzen(FALSE)
    GUI_DESTROY(tabFelder[i])
    DIM k AS INTEGER
    FOR k = i TO tabAnzahl - 2
        tabPfade[k] = tabPfade[k + 1]
        tabFelder[k] = tabFelder[k + 1]
        tabGesichert[k] = tabGesichert[k + 1]
        tabLetzterText[k] = tabLetzterText[k + 1]
        GUI_SET_TAB(tabFelder[k], k)
    NEXT
    tabAnzahl = tabAnzahl - 1
    IF aktiverTab >= tabAnzahl THEN aktiverTab = tabAnzahl - 1
    reiterNeuSetzen()
    layout()
    GUI_LISTBOX_CLEAR(lstProbleme)
    protokoll("geschlossen")
END SUB

' --- Projektbaum -------------------------------------------------------
DIM baumLetzteWahl AS INTEGER : baumLetzteWahl = -1
DIM baumDateien AS ARRAY OF STRING
DIM baumKnoten AS ARRAY OF INTEGER
DIM baumSchluessel AS STRING : baumSchluessel = "-"

SUB baumFuellen()
    DIM neue AS ARRAY OF STRING : neue = DIRLIST(projektOrdner, "*.dh")
    DIM schl AS STRING : schl = projektOrdner + "|" + JOIN$(neue, ";")
    ' Steht dieselbe Liste schon da, bleibt der Baum, WIE er ist -- ein
    ' Neuaufbau raeumt die Auswahl weg, und genau die sammelt man gerade
    ' ein, wenn man mit Strg mehrere Dateien anklickt. (Vorher baute jedes
    ' Oeffnen den Baum neu auf, und die Mehrfachauswahl kam nie ueber eine
    ' Datei hinaus.)
    IF schl = baumSchluessel THEN RETURN
    baumSchluessel = schl
    GUI_TREE_CLEAR(baum)
    baumLetzteWahl = -1
    GUI_SET_TEXT(lblProjekt, BASENAME(projektOrdner))
    baumDateien = neue
    DIM n AS INTEGER : n = LEN(baumDateien)
    DIM knoten[MAX(n, 1)] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        knoten[i] = GUI_TREE_ADD(baum, -1, baumDateien[i])
    NEXT
    baumKnoten = knoten
END SUB

' Alle gewaehlten Dateien oeffnen (Strg+Umschalt+E).
SUB baumAuswahlOeffnen()
    DIM n AS INTEGER : n = GUI_TREE_SEL_COUNT(baum)
    IF n < 1 THEN
        GUI_SET_TEXT(lblStatus, "Keine Datei gewaehlt -- Strg+Klick sammelt, Umschalt+Klick spannt.")
        RETURN
    END IF
    ' Erst alle Wege einsammeln, dann oeffnen: dateiOeffnen baut den Baum
    ' neu auf, und mitten in der Schleife waeren Knoten und Auswahl weg.
    DIM pfade AS ARRAY OF STRING : pfade = []
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        DIM knoten AS INTEGER : knoten = GUI_TREE_SEL_NODE(baum, k)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(baumDateien) - 1
            IF baumKnoten[i] = knoten THEN ARRAY_PUSH(pfade, PATHJOIN(projektOrdner, baumDateien[i]))
        NEXT
    NEXT
    DIM p AS STRING
    FOR EACH p IN pfade
        dateiOeffnen(p)
    NEXT
    GUI_SET_TEXT(lblStatus, STR$(LEN(pfade)) + " Datei(en) geoeffnet.")
    protokoll("baum offen " + STR$(LEN(pfade)))
END SUB

SUB baumAbfragen()
    DIM sel AS INTEGER : sel = GUI_TREE_SELECTED(baum)
    IF sel < 0 OR sel = baumLetzteWahl THEN RETURN
    baumLetzteWahl = sel
    ' Beim SAMMELN wird nicht geoeffnet -- sonst kaeme mit jedem Strg+Klick
    ' ein Reiter dazu, den niemand wollte. Geoeffnet wird nur, wenn genau
    ' eine Zeile gewaehlt ist und es die angeklickte ist (beim Abwaehlen
    ' zeigt die angeklickte woanders hin als die eine uebriggebliebene).
    IF GUI_TREE_SEL_COUNT(baum) <> 1 OR GUI_TREE_SEL_NODE(baum, 0) <> sel THEN RETURN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(baumDateien) - 1
        IF baumKnoten[i] = sel THEN dateiOeffnen(PATHJOIN(projektOrdner, baumDateien[i]))
    NEXT
END SUB

' --- Einfaerben (nur der sichtbare Ausschnitt) ------------------------
FUNCTION farbeFuer(art AS STRING) AS INTEGER
    IF art = "kommentar" THEN RETURN F_KOMMENTAR
    IF art = "text" THEN RETURN F_TEXT
    IF art = "zahl" THEN RETURN F_ZAHL
    IF art = "schluessel" THEN RETURN F_SCHLUESSEL
    IF art = "operator" THEN RETURN F_OPERATOR
    RETURN F_GRUND
END FUNCTION

' Klammer-Gegenstueck IM AUSSCHNITT suchen -- -1, wenn es keins gibt oder
' es ausserhalb liegt. Der Ausschnitt reicht: was man nicht sieht, muss
' auch nicht leuchten.
FUNCTION klammerPartner(s AS STRING, pos AS INTEGER) AS INTEGER
    DIM auf AS STRING : auf = "([{"
    DIM zu AS STRING : zu = ")]}"
    DIM c AS STRING : c = MID$(s, pos, 1)
    DIM k AS INTEGER : k = INSTR(auf, c)
    DIM richtung AS INTEGER : richtung = 1
    DIM partner AS STRING : partner = ""
    IF k >= 0 THEN
        partner = MID$(zu, k, 1)
    ELSE
        k = INSTR(zu, c)
        IF k < 0 THEN RETURN -1
        partner = MID$(auf, k, 1)
        richtung = -1
    END IF
    DIM tiefe AS INTEGER : tiefe = 0
    DIM i AS INTEGER : i = pos
    WHILE i >= 0 AND i < LEN(s)
        DIM d AS STRING : d = MID$(s, i, 1)
        IF d = c THEN
            tiefe = tiefe + 1
        ELSEIF d = partner THEN
            tiefe = tiefe - 1
            IF tiefe = 0 THEN RETURN i
        END IF
        i = i + richtung
    WEND
    RETURN -1
END FUNCTION

' Ist das Zeichen an dieser Stelle Teil eines Namens?
FUNCTION wortzeichenAn(s AS STRING, i AS INTEGER) AS BOOLEAN
    IF i < 0 OR i >= LEN(s) THEN RETURN FALSE
    RETURN istWortzeichen(MID$(s, i, 1))
END FUNCTION

DIM faerbSchluessel AS STRING : faerbSchluessel = ""

' &H-Literale im Ausschnitt: Anfang, Laenge und Farbe. Sechs oder acht
' Stellen -- kuerzere Zahlen (`&HFF`) sind keine Farbe, sondern eine Zahl,
' und ein Feld daneben waere nur Verwirrung.
SUB farbliteraleSuchen(stueck AS STRING, von AS INTEGER, s AS ARRAY OF INTEGER, _
                       l AS ARRAY OF INTEGER, f AS ARRAY OF INTEGER)
    farbStellen = [] : farbLaengen = []
    DIM ab AS INTEGER : ab = 0
    WHILE ab < LEN(stueck)
        DIM p AS INTEGER : p = INSTR(MID$(stueck, ab, LEN(stueck)), "&H")
        IF p < 0 THEN BREAK
        p = ab + p
        DIM k AS INTEGER : k = p + 2
        WHILE k < LEN(stueck) AND INSTR("0123456789ABCDEFabcdef", MID$(stueck, k, 1)) >= 0
            k = k + 1
        WEND
        DIM stellen AS INTEGER : stellen = k - p - 2
        IF stellen = 6 OR stellen = 8 THEN
            DIM roh AS STRING : roh = MID$(stueck, p + 2, stellen)
            IF stellen = 8 THEN roh = RIGHT$(roh, 6)
            ARRAY_PUSH(s, p + von) : ARRAY_PUSH(l, k - p) : ARRAY_PUSH(f, COLOR_FROM_HEX("#" + roh))
            ARRAY_PUSH(farbStellen, p + von) : ARRAY_PUSH(farbLaengen, k - p)
        END IF
        ab = MAX(k, p + 2)
    WEND
END SUB

SUB faerben(ta AS GUI_WIDGET)
    DIM erste AS INTEGER
    DIM zeilen AS INTEGER
    DIM von AS INTEGER
    DIM laenge AS INTEGER
    (erste, zeilen, von, laenge) = GUI_TEXTAREA_VIEW(ta)
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM stueck AS STRING : stueck = MID$(q, von, laenge)
    DIM cz AS INTEGER
    DIM cs AS INTEGER
    (cz, cs) = GUI_TEXTAREA_CURSOR(ta)
    ' Hat sich nichts geaendert, ist auch nichts neu zu rechnen. Ohne den
    ' Riegel liefen Einfaerbung UND Fundstellensuche in jedem Bild, auch
    ' wenn das Fenster nur dasteht.
    DIM schl AS STRING : schl = STR$(von) + ":" + STR$(cz) + ":" + STR$(cs) + ":" + stueck
    IF schl = faerbSchluessel THEN RETURN
    faerbSchluessel = schl
    DIM starts AS ARRAY OF INTEGER
    DIM laengen AS ARRAY OF INTEGER
    DIM arten AS ARRAY OF STRING
    (starts, laengen, arten) = SYNTAX_SPANS(stueck)
    DIM n AS INTEGER : n = LEN(starts)
    IF n = 0 THEN RETURN
    DIM s2 AS ARRAY OF INTEGER : s2 = []
    DIM l2 AS ARRAY OF INTEGER : l2 = []
    DIM f2 AS ARRAY OF INTEGER : f2 = []
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        ARRAY_PUSH(s2, starts[i] + von) : ARRAY_PUSH(l2, laengen[i])
        ARRAY_PUSH(f2, farbeFuer(arten[i]))
    NEXT
    ' Das Wort unter der Marke ueberall im Ausschnitt. Erst ab zwei
    ' Zeichen: ein einzelnes `i` faerbte die halbe Datei.
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF LEN(wort) >= 2 THEN
        DIM klein AS STRING : klein = LOWER$(stueck)
        DIM kwort AS STRING : kwort = LOWER$(wort)
        DIM ab AS INTEGER : ab = 0
        WHILE ab < LEN(klein)
            DIM p AS INTEGER : p = INSTR(MID$(klein, ab, LEN(klein)), kwort)
            IF p < 0 THEN BREAK
            p = ab + p
            IF NOT wortzeichenAn(stueck, p - 1) AND NOT wortzeichenAn(stueck, p + LEN(wort)) THEN
                ARRAY_PUSH(s2, p + von) : ARRAY_PUSH(l2, LEN(wort)) : ARRAY_PUSH(f2, F_FUNDSTELLE)
            END IF
            ab = p + LEN(wort)
        WEND
    END IF
    ' Das Klammernpaar um die Marke: erst links davon schauen, dann rechts
    ' -- so wie man es beim Tippen erwartet, wenn man gerade eine Klammer
    ' geschrieben hat.
    DIM sz AS ARRAY OF STRING : sz = SPLIT$(stueck, NL)
    DIM rel AS INTEGER : rel = cz - 1 - erste
    IF rel >= 0 AND rel < LEN(sz) THEN
        DIM markePos AS INTEGER : markePos = cs - 1
        DIM r AS INTEGER
        FOR r = 0 TO rel - 1
            markePos = markePos + LEN(sz[r]) + 1
        NEXT
        DIM kp AS INTEGER : kp = markePos - 1
        DIM gegen AS INTEGER : gegen = -1
        IF kp >= 0 THEN gegen = klammerPartner(stueck, kp)
        IF gegen < 0 AND markePos < LEN(stueck) THEN
            kp = markePos
            gegen = klammerPartner(stueck, kp)
        END IF
        IF gegen >= 0 THEN
            ARRAY_PUSH(s2, kp + von) : ARRAY_PUSH(l2, 1) : ARRAY_PUSH(f2, F_KLAMMER)
            ARRAY_PUSH(s2, gegen + von) : ARRAY_PUSH(l2, 1) : ARRAY_PUSH(f2, F_KLAMMER)
        END IF
    END IF
    GUI_TEXTAREA_SPANS(ta, s2, l2, f2)
    ' Farbfelder neben den &H-Literalen -- eine Farbe sieht man nicht, man
    ' rechnet sie sonst im Kopf aus.
    DIM fs AS ARRAY OF INTEGER : fs = []
    DIM fl AS ARRAY OF INTEGER : fl = []
    DIM ff AS ARRAY OF INTEGER : ff = []
    farbliteraleSuchen(stueck, von, fs, fl, ff)
    GUI_TEXTAREA_SWATCHES(ta, fs, fl, ff)
END SUB

' --- Pruefen -----------------------------------------------------------
DIM problemZeilen AS ARRAY OF INTEGER : problemZeilen = []

SUB pruefen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF problemModus = 0 THEN GUI_LISTBOX_CLEAR(lstProbleme)
    IF ta < 0 THEN RETURN
    DIM basis AS STRING : basis = projektOrdner
    IF tabPfade[aktiverTab] <> "" THEN basis = DIRNAME(tabPfade[aktiverTab])
    DIM j AS JSON_HANDLE
    j = JSON_PARSE(CODE_CHECK$(GUI_TEXT(ta), basis))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM zeilen[MAX(n, 1)] AS INTEGER
    DIM i AS INTEGER
    DIM fehler AS INTEGER : fehler = 0
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        zeilen[i] = JSON_GET_INT(j, p + ".zeile")
        DIM art AS STRING : art = JSON_GET_STRING(j, p + ".schwere")
        IF art = "fehler" THEN fehler = fehler + 1
        IF problemModus = 0 THEN
            GUI_LISTBOX_ADD(lstProbleme, "Zeile " + STR$(zeilen[i]) + ": " + JSON_GET_STRING(j, p + ".meldung"))
            IF art = "fehler" THEN GUI_LISTBOX_COLOR(lstProbleme, i, &HE06060) ELSE GUI_LISTBOX_COLOR(lstProbleme, i, &HE0C060)
        END IF
    NEXT
    problemZeilen = zeilen
    IF problemModus = 0 THEN
        IF n = 0 THEN
            GUI_SET_TEXT(lblProbleme, "Probleme: keine")
        ELSE
            GUI_SET_TEXT(lblProbleme, "Probleme: " + STR$(fehler) + " Fehler, " + STR$(n - fehler) + " Warnungen")
        END IF
    END IF
    protokoll("geprueft " + STR$(n))
    gliederungFuellen(GUI_TEXT(ta))
END SUB

' --- Gliederung: SUB/FUNCTION/CLASS der aktiven Datei (CODE_SYMBOLS$) ---
' Faltbare Bloecke aus der EINRUECKUNG -- alles, was CODE_SYMBOLS$ nicht
' kennt: eine FOR-Schleife, ein IF-Zweig, ein von Hand eingerueckter
' Abschnitt. Ein Block ist eine Zeile, unter der mindestens eine tiefer
' eingerueckte steht; er endet an der letzten davon.
'
' Leerzeilen zaehlen nicht mit (sie haben gar keine Einrueckung), und was
' die Gliederung schon nennt, kommt nicht doppelt: sonst haette jede
' Kopfzeile zwei Bereiche, und der engere -- der aus der Einrueckung --
' gewaenne, obwohl der Block derselbe ist.
SUB einzugBloecke(quelle AS STRING, fv AS ARRAY OF INTEGER, fb AS ARRAY OF INTEGER)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM n AS INTEGER : n = LEN(zeilen)
    IF n > 4000 THEN RETURN        ' bei sehr grossen Dateien nicht je Pruefung
    DIM tiefe[MAX(n, 1)] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        IF TRIM$(zeilen[i]) = "" THEN
            tiefe[i] = -1
        ELSE
            tiefe[i] = LEN(zeilen[i]) - LEN(LTRIM$(zeilen[i]))
        END IF
    NEXT
    FOR i = 0 TO n - 2
        IF tiefe[i] < 0 THEN CONTINUE
        DIM k AS INTEGER : k = i + 1
        DIM ende AS INTEGER : ende = i
        WHILE k < n
            IF tiefe[k] < 0 THEN
                k = k + 1
                CONTINUE
            END IF
            IF tiefe[k] <= tiefe[i] THEN BREAK
            ende = k
            k = k + 1
        WEND
        IF ende <= i THEN CONTINUE
        IF ARRAY_INDEXOF(fv, i + 1) >= 0 THEN CONTINUE
        ARRAY_PUSH(fv, i + 1) : ARRAY_PUSH(fb, ende + 1)
    NEXT
END SUB

SUB gliederungFuellen(quelle AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM namen AS ARRAY OF STRING : namen = []
    DIM zeilen AS ARRAY OF INTEGER : zeilen = []
    DIM schl AS STRING : schl = ""
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        DIM eintrag AS STRING : eintrag = JSON_GET_STRING(j, p + ".art") + " " + JSON_GET_STRING(j, p + ".name")
        ARRAY_PUSH(namen, eintrag) : ARRAY_PUSH(zeilen, JSON_GET_INT(j, p + ".von"))
        schl = schl + eintrag + ":" + STR$(JSON_GET_INT(j, p + ".von")) + ";"
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            ARRAY_PUSH(namen, "    " + JSON_GET_STRING(j, pk + ".name")) : ARRAY_PUSH(zeilen, JSON_GET_INT(j, pk + ".von"))
            schl = schl + JSON_GET_STRING(j, pk + ".name") + ":" + STR$(JSON_GET_INT(j, pk + ".von")) + ";"
        NEXT
    NEXT
    ' Dieselben Bloecke sind die faltbaren -- die Laufzeit kennt keine
    ' Sprache und erfaehrt sie nur so.
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 AND schl <> faltSchluessel THEN
        faltSchluessel = schl
        DIM fv AS ARRAY OF INTEGER : fv = []
        DIM fb AS ARRAY OF INTEGER : fb = []
        FOR i = 0 TO n - 1
            DIM pf AS STRING : pf = STR$(i)
            ARRAY_PUSH(fv, JSON_GET_INT(j, pf + ".von")) : ARRAY_PUSH(fb, JSON_GET_INT(j, pf + ".bis"))
            DIM mf AS INTEGER
            FOR mf = 0 TO JSON_LEN(j, pf + ".kinder") - 1
                DIM pkf AS STRING : pkf = pf + ".kinder." + STR$(mf)
                ARRAY_PUSH(fv, JSON_GET_INT(j, pkf + ".von")) : ARRAY_PUSH(fb, JSON_GET_INT(j, pkf + ".bis"))
            NEXT
        NEXT
        einzugBloecke(quelle, fv, fb)
        GUI_TEXTAREA_FOLDABLE(ta, fv, fb)
    END IF
    IF schl = gliederungSchluessel THEN RETURN
    gliederungSchluessel = schl
    gliederungZeilen = zeilen
    GUI_LISTBOX_CLEAR(lstGliederung)
    DIM e AS STRING
    FOR EACH e IN namen
        GUI_LISTBOX_ADD(lstGliederung, e)
    NEXT
    protokoll("gliederung " + STR$(n))
END SUB

' --- Verzeichnis der eigenen Symbole ueber ALLE Dateien des Projekts ---
' Die Gliederung kennt nur die vordere Datei. Ueber das ganze Projekt ist
' der Index eine eigene Sache, und er wird auf ZURUF gebaut statt je Bild:
' ein paar hundert Dateien lesen und zerlegen dauert seine Zeit, und der
' Nutzen faengt erst an, wenn jemand danach fragt.
DIM symPfade AS ARRAY OF STRING : symPfade = []
DIM symZeilen AS ARRAY OF INTEGER : symZeilen = []
DIM symNamen AS ARRAY OF STRING : symNamen = []       ' der blanke Name, fuer die Suche
DIM symAnzeige AS ARRAY OF STRING : symAnzeige = []   ' was in der Liste steht
DIM symSchluessel AS STRING : symSchluessel = "-"

FUNCTION tabMitPfad(pfad AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF wegGleich$(tabPfade[i]) = wegGleich$(pfad) THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB symbolMerken(pfad AS STRING, anzeige AS STRING, name AS STRING, zeile AS INTEGER)
    IF name = "" THEN RETURN
    ARRAY_PUSH(symPfade, pfad)
    ARRAY_PUSH(symZeilen, zeile)
    ARRAY_PUSH(symNamen, name)
    ARRAY_PUSH(symAnzeige, anzeige)
END SUB

SUB symbolEinerDatei(pfad AS STRING, kurz AS STRING, quelle AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(quelle))
    DIM n AS INTEGER : n = JSON_LEN(j, "")
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = STR$(i)
        DIM art AS STRING : art = JSON_GET_STRING(j, p + ".art")
        DIM name AS STRING : name = JSON_GET_STRING(j, p + ".name")
        DIM zeile AS INTEGER : zeile = JSON_GET_INT(j, p + ".von")
        symbolMerken(pfad, art + " " + name + "   " + kurz + ":" + STR$(zeile), name, zeile)
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            DIM kn AS STRING : kn = JSON_GET_STRING(j, pk + ".name")
            DIM kz AS INTEGER : kz = JSON_GET_INT(j, pk + ".von")
            symbolMerken(pfad, kn + " (" + name + ")   " + kurz + ":" + STR$(kz), kn, kz)
        NEXT
    NEXT
END SUB

SUB symbolIndexBauen(erzwingen AS BOOLEAN)
    DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(projektOrdner, "*.dh")
    DIM schl AS STRING : schl = projektOrdner + "|" + STR$(LEN(dateien))
    IF NOT erzwingen AND schl = symSchluessel THEN RETURN
    symSchluessel = schl
    symPfade = [] : symZeilen = [] : symNamen = [] : symAnzeige = []
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        ' Ein offener Reiter zaehlt mit dem Stand IM Editor, nicht mit dem auf
        ' der Platte -- sonst zeigte das Verzeichnis auf Zeilen, die es seit
        ' der letzten Aenderung nicht mehr gibt.
        DIM t AS INTEGER : t = tabMitPfad(pfad)
        DIM quelle AS STRING : quelle = ""
        DIM gut AS BOOLEAN : gut = TRUE
        IF t >= 0 THEN
            quelle = GUI_TEXT(tabFelder[t])
        ELSE
            TRY
                quelle = dateiLesen(pfad)
            CATCH e
                gut = FALSE
            END TRY
        END IF
        IF gut THEN symbolEinerDatei(pfad, d, quelle)
    NEXT
    protokoll("symbolindex " + STR$(LEN(symNamen)))
END SUB

' Den Namen im ganzen Projekt suchen -- die Nummer im Index oder -1.
FUNCTION symbolSuchen(name AS STRING) AS INTEGER
    IF name = "" THEN RETURN -1
    symbolIndexBauen(FALSE)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(symNamen) - 1
        IF LOWER$(symNamen[i]) = LOWER$(name) THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB symbolAnspringen(nummer AS INTEGER)
    IF nummer < 0 OR nummer >= LEN(symPfade) THEN RETURN
    DIM pfad AS STRING : pfad = symPfade[nummer]
    DIM zeile AS INTEGER : zeile = symZeilen[nummer]
    IF aktiverTab < 0 OR tabPfade[aktiverTab] <> pfad THEN dateiOeffnen(pfad)
    IF aktivesFeld() >= 0 THEN GUI_TEXTAREA_GOTO(aktivesFeld(), zeile, 1)
    GUI_SET_TEXT(lblStatus, symAnzeige[nummer])
    protokoll("symbol " + BASENAME(pfad) + " " + STR$(zeile))
END SUB

SUB symbolVerzeichnis()
    symbolIndexBauen(TRUE)
    IF LEN(symNamen) = 0 THEN
        GUI_SET_TEXT(lblStatus, "Keine Symbole in " + projektOrdner + ".")
        RETURN
    END IF
    paletteNamen = []
    paletteKennungen = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(symAnzeige) - 1
        ARRAY_PUSH(paletteNamen, symAnzeige[i]) : ARRAY_PUSH(paletteKennungen, STR$(i))
    NEXT
    waehlerOeffnen("symbol", "Symbole im Projekt (" + STR$(LEN(symNamen)) + ")")
    ' Wie beim Schnipsel: das Wort unter der Marke fuellt den Filter aus.
    DIM anfang AS STRING : anfang = wortUnterMarke$()
    IF anfang <> "" THEN
        GUI_SET_TEXT(tfPalette, anfang)
        paletteLetzterFilter = anfang
        paletteFuellen(anfang)
    END IF
END SUB

' Die Symbolspur zur Marke: welcher Block umschliesst sie? Die Gliederung
' hat schon Anfang und Ende jedes Symbols -- gesucht ist der ENGSTE, der
' die Zeile enthaelt, samt seinem Elternteil.
DIM spurSchluessel AS STRING : spurSchluessel = "-"

SUB spurNachziehen()
    IF aktiverTab < 0 THEN RETURN
    DIM ta AS GUI_WIDGET : ta = tabFelder[aktiverTab]
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM schl AS STRING : schl = STR$(aktiverTab) + ":" + STR$(z) + ":" + gliederungSchluessel
    IF schl = spurSchluessel THEN RETURN
    spurSchluessel = schl
    DIM datei AS STRING : datei = IIF(tabPfade[aktiverTab] = "", "Unbenannt", BASENAME(tabPfade[aktiverTab]))
    DIM spur AS STRING : spur = datei
    DIM j AS JSON_HANDLE : j = JSON_PARSE(CODE_SYMBOLS$(GUI_TEXT(ta)))
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "") - 1
        DIM p AS STRING : p = STR$(i)
        IF z < JSON_GET_INT(j, p + ".von") OR z > JSON_GET_INT(j, p + ".bis") THEN CONTINUE
        spur = spur + "  >  " + JSON_GET_STRING(j, p + ".art") + " " + JSON_GET_STRING(j, p + ".name")
        DIM m AS INTEGER
        FOR m = 0 TO JSON_LEN(j, p + ".kinder") - 1
            DIM pk AS STRING : pk = p + ".kinder." + STR$(m)
            IF z >= JSON_GET_INT(j, pk + ".von") AND z <= JSON_GET_INT(j, pk + ".bis") THEN
                spur = spur + "  >  " + JSON_GET_STRING(j, pk + ".name")
            END IF
        NEXT
    NEXT
    GUI_SET_TEXT(lblSpur, spur)
    protokoll("spur " + spur)
END SUB

SUB gliederungAnspringen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstGliederung)
    IF sel < 0 OR sel >= LEN(gliederungZeilen) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_TEXTAREA_GOTO(ta, gliederungZeilen[sel], 1)
    GUI_FOCUS(ta)
END SUB

SUB problemAnspringen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstProbleme)
    IF problemModus = 1 THEN
        IF sel < 0 OR sel >= LEN(sucheZeilen) THEN RETURN
        dateiOeffnen(PATHJOIN(projektOrdner, sucheDateien[sel]))
        DIM tf AS GUI_WIDGET : tf = aktivesFeld()
        IF tf >= 0 THEN GUI_TEXTAREA_GOTO(tf, sucheZeilen[sel], 1) : GUI_FOCUS(tf)
        RETURN
    END IF
    IF sel < 0 OR sel >= LEN(problemZeilen) THEN RETURN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    GUI_TEXTAREA_GOTO(ta, problemZeilen[sel], 1)
    GUI_FOCUS(ta)
END SUB

' --- Suche im Projekt --------------------------------------------------
' `zweitens` ist ein zweiter Suchtext (ODER) -- fuer die TODO/FIXME-Liste.
SUB projektSuchen(gesucht AS STRING, zweitens AS STRING)
    IF gesucht = "" THEN RETURN
    GUI_LISTBOX_CLEAR(lstProbleme)
    DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(projektOrdner, "*.dh")
    DIM sd AS ARRAY OF STRING : sd = []
    DIM sz AS ARRAY OF INTEGER : sz = []
    DIM klein AS STRING : klein = LOWER$(gesucht)
    DIM klein2 AS STRING : klein2 = LOWER$(zweitens)
    DIM treffer AS INTEGER : treffer = 0
    DIM inDateien AS INTEGER : inDateien = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(projektOrdner, d))
        DIM vorher AS INTEGER : vorher = treffer
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            IF treffer >= 500 THEN BREAK
            IF passtSuche(zeilen[i], gesucht) OR (zweitens <> "" AND passtSuche(zeilen[i], zweitens)) THEN
                ARRAY_PUSH(sd, d)
                ARRAY_PUSH(sz, i + 1)
                GUI_LISTBOX_ADD(lstProbleme, d + ":" + STR$(i + 1) + ": " + TRIM$(zeilen[i]))
                treffer = treffer + 1
            END IF
        NEXT
        IF treffer > vorher THEN inDateien = inDateien + 1
    NEXT
    sucheDateien = sd
    sucheZeilen = sz
    problemModus = 1
    DIM was AS STRING : was = gesucht
    IF zweitens <> "" THEN was = gesucht + "/" + zweitens
    GUI_SET_TEXT(lblProbleme, "Suche '" + was + "': " + STR$(treffer) + " Treffer in " + STR$(inDateien) + " Dateien -- Umschalt+F7 zeigt wieder die Probleme")
    protokoll("suche " + STR$(treffer))
END SUB

' --- Haltepunkte und Marken in der Nummernspalte ---------------------
' --- Wer hat das geschrieben? (git blame) -----------------------------
' Die Trefferliste unten rechts, wie die Projektsuche -- ein eigener
' Bereich waere ein zweites Panel fuer dieselbe Frage "welche Zeile?".
' `git blame` laeuft synchron ueber SHELL_OUT$: eine Datei dauert
' Millisekunden, und ein eigener Prozess mit Warteschlange waere hier
' mehr Buchfuehrung als Nutzen.
SUB blameZeigen()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN
        GUI_SET_TEXT(lblStatus, "Git-Blame: die Datei ist noch nicht gesichert.")
        RETURN
    END IF
    DIM ausgabe AS STRING : ausgabe = ""
    TRY
        ausgabe = SHELL_OUT$("git", "-C", DIRNAME(pfad), "blame", "--date=short", "-w", "--", BASENAME(pfad))
    CATCH e
        ausgabe = ""
    END TRY
    IF TRIM$(ausgabe) = "" THEN
        GUI_SET_TEXT(lblStatus, "Git-Blame: keine Antwort -- liegt die Datei in einem git-Verzeichnis, und ist `git` da?")
        protokoll("blame 0")
        RETURN
    END IF
    GUI_LISTBOX_CLEAR(lstProbleme)
    DIM sd AS ARRAY OF STRING : sd = []
    DIM sz AS ARRAY OF INTEGER : sz = []
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(ausgabe, NL)
    DIM n AS INTEGER : n = 0
    DIM z AS STRING
    FOR EACH z IN zeilen
        z = RTRIM$(z)
        IF z = "" THEN CONTINUE
        ' Format: <hash> (<Wer>  <Datum> <Zeile>) <Quelltext>
        DIM auf AS INTEGER : auf = INSTR(z, "(")
        DIM zu AS INTEGER : zu = INSTR(z, ")")
        IF auf < 0 OR zu <= auf THEN CONTINUE
        DIM kopf AS STRING : kopf = TRIM$(MID$(z, auf + 1, zu - auf - 1))
        DIM felder AS ARRAY OF STRING : felder = SPLIT$(kopf, " ")
        DIM nr AS INTEGER : nr = 0
        DIM wer AS STRING : wer = ""
        DIM datum AS STRING : datum = ""
        DIM k AS INTEGER
        FOR k = 0 TO LEN(felder) - 1
            IF felder[k] = "" THEN CONTINUE
            IF k = LEN(felder) - 1 THEN
                nr = INT(VAL(felder[k]))
            ELSEIF LEN(felder[k]) = 10 AND MID$(felder[k], 4, 1) = "-" THEN
                datum = felder[k]
            ELSE
                wer = TRIM$(wer + " " + felder[k])
            END IF
        NEXT
        IF nr <= 0 THEN CONTINUE
        n = n + 1
        ARRAY_PUSH(sd, BASENAME(pfad))
        ARRAY_PUSH(sz, nr)
        GUI_LISTBOX_ADD(lstProbleme, PADL$(STR$(nr), 5) + "  " + datum + "  " + wer + "  " + TRIM$(MID$(z, zu + 1, LEN(z))))
    NEXT
    sucheDateien = sd
    sucheZeilen = sz
    problemModus = 1
    GUI_SET_TEXT(lblProbleme, "git blame " + BASENAME(pfad) + ": " + STR$(n) + " Zeilen -- Umschalt+F7 zeigt wieder die Probleme")
    protokoll("blame " + STR$(n))
END SUB

' `git` fuer die aktive Datei laufen lassen -- leer, wenn es nicht geht.
' Synchron ueber SHELL_OUT$: eine Datei dauert Millisekunden.
FUNCTION gitAusgabe$(erst AS STRING, zweit AS STRING, dritt AS STRING) AS STRING
    IF aktiverTab < 0 THEN RETURN ""
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN RETURN ""
    TRY
        IF dritt = "" THEN
            RETURN SHELL_OUT$("git", "-C", DIRNAME(pfad), erst, zweit, "--", BASENAME(pfad))
        END IF
        RETURN SHELL_OUT$("git", "-C", DIRNAME(pfad), erst, zweit, dritt, "--", BASENAME(pfad))
    CATCH e
        RETURN ""
    END TRY
END FUNCTION

' Diff und Verlauf im selben Fenster: es ist dieselbe Frage ("was ist mit
' dieser Datei passiert?"), nur einmal seit dem letzten Sichern und einmal
' ueber die Zeit.
SUB gitZeigen(art AS STRING)
    IF aktiverTab < 0 OR tabPfade[aktiverTab] = "" THEN
        GUI_SET_TEXT(lblStatus, "git: die Datei ist noch nicht gesichert.")
        RETURN
    END IF
    DIM text AS STRING
    IF art = "diff" THEN
        text = gitAusgabe$("diff", "--no-color", "")
        IF TRIM$(text) = "" THEN text = gitAusgabe$("diff", "--no-color", "--staged")
    ELSE
        text = gitAusgabe$("log", "--no-color", "--pretty=format:%h  %ad  %an%n    %s%n")
    END IF
    IF TRIM$(text) = "" THEN
        GUI_SET_TEXT(lblStatus, IIF(art = "diff", "git diff: keine Aenderungen an dieser Datei.", "git log: kein Verlauf -- liegt sie in einem git-Verzeichnis?"))
        protokoll("git " + art + " 0")
        RETURN
    END IF
    GUI_SET_TEXT(taGit, text)
    GUI_WINDOW_TITLE(winGit, IIF(art = "diff", "Aenderungen", "Verlauf") + ": " + BASENAME(tabPfade[aktiverTab]))
    GUI_SET_TEXT(lblGit, STR$(LEN(SPLIT$(text, NL))) + " Zeilen")
    GUI_WINDOW_VISIBLE(winGit, TRUE)
    GUI_FOCUS(taGit)
    gitFaerben()
    protokoll("git " + art + " " + STR$(LEN(SPLIT$(text, NL))))
END SUB

' Ein Diff liest sich nur mit Farbe: Zugaenge gruen, Abgaenge rot, die
' @@-Koepfe blau. Zeilenweise ueber die Abschnitte, wie im Code-Feld.
SUB gitFaerben()
    DIM text AS STRING : text = GUI_TEXT(taGit)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(text, NL)
    DIM s AS ARRAY OF INTEGER : s = []
    DIM l AS ARRAY OF INTEGER : l = []
    DIM f AS ARRAY OF INTEGER : f = []
    DIM pos AS INTEGER : pos = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM z AS STRING : z = zeilen[i]
        DIM farbe AS INTEGER : farbe = -1
        IF LEFT$(z, 2) = "@@" THEN
            farbe = &H60B0E0
        ELSEIF LEFT$(z, 3) = "+++" OR LEFT$(z, 3) = "---" THEN
            farbe = &H90A0B0
        ELSEIF LEFT$(z, 1) = "+" THEN
            farbe = &H70D080
        ELSEIF LEFT$(z, 1) = "-" THEN
            farbe = &HE07070
        ELSEIF LEN(z) >= 7 AND MID$(z, 7, 1) = " " AND LEFT$(z, 1) <> " " THEN
            farbe = &HE0C060        ' die Kennung einer Uebergabe im Verlauf
        END IF
        IF farbe >= 0 AND LEN(z) > 0 THEN
            ARRAY_PUSH(s, pos) : ARRAY_PUSH(l, LEN(z)) : ARRAY_PUSH(f, farbe)
        END IF
        pos = pos + LEN(z) + 1
    NEXT
    GUI_TEXTAREA_SPANS(taGit, s, l, f)
END SUB

' Die geaenderten Zeilen am Rand: `git diff -U0` nennt sie in den
' @@-Koepfen (`@@ -alt,n +neu,m @@`). Nur die NEUE Seite zaehlt -- was
' geloescht wurde, steht in der Datei nicht mehr.
DIM gitZeilen AS ARRAY OF INTEGER : gitZeilen = []
DIM gitDateiStand AS STRING : gitDateiStand = "-"

SUB gitRandNachziehen(erzwingen AS BOOLEAN)
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF NOT gitRandAn OR pfad = "" THEN
        IF LEN(gitZeilen) > 0 THEN gitZeilen = [] : markenSchluessel = ""
        RETURN
    END IF
    ' Nur nach dem Sichern oder Oeffnen neu fragen: ein Prozessstart je
    ' Bild waere die IDE zum Stillstand gebracht.
    DIM stand AS STRING : stand = pfad + "|" + STR$(LEN(tabGesichert[aktiverTab]))
    IF NOT erzwingen AND stand = gitDateiStand THEN RETURN
    gitDateiStand = stand
    DIM text AS STRING : text = gitAusgabe$("diff", "--no-color", "-U0")
    DIM neu AS ARRAY OF INTEGER : neu = []
    DIM z AS STRING
    FOR EACH z IN SPLIT$(text, NL)
        IF LEFT$(z, 2) <> "@@" THEN CONTINUE
        DIM p AS INTEGER : p = INSTR(z, "+")
        IF p < 0 THEN CONTINUE
        DIM rest AS STRING : rest = MID$(z, p + 1, LEN(z))
        DIM ende AS INTEGER : ende = INSTR(rest, " ")
        IF ende >= 0 THEN rest = LEFT$(rest, ende)
        DIM komma AS INTEGER : komma = INSTR(rest, ",")
        DIM von AS INTEGER : von = INT(VAL(IIF(komma >= 0, LEFT$(rest, komma), rest)))
        DIM anzahl AS INTEGER : anzahl = 1
        IF komma >= 0 THEN anzahl = INT(VAL(MID$(rest, komma + 1, LEN(rest))))
        DIM k AS INTEGER
        FOR k = 0 TO MIN(anzahl, 2000) - 1
            ARRAY_PUSH(neu, von + k)
        NEXT
    NEXT
    gitZeilen = neu
    markenSchluessel = ""
    protokoll("git rand " + STR$(LEN(neu)))
END SUB

FUNCTION haltepunktIndex(pfad AS STRING, zeile AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF hpDateien[i] = pfad AND hpZeilen[i] = zeile THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB haltepunktUmschalten()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, "Erst sichern -- Haltepunkte gehoeren zu einer Datei.") : RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    DIM k AS INTEGER : k = haltepunktIndex(pfad, z)
    IF k >= 0 THEN
        ARRAY_REMOVE_AT(hpDateien, k)
        ARRAY_REMOVE_AT(hpZeilen, k)
        ARRAY_REMOVE_AT(hpBedingungen, k)
        protokoll("haltepunkt " + STR$(z) + " aus")
    ELSE
        ARRAY_PUSH(hpDateien, pfad)
        ARRAY_PUSH(hpZeilen, z)
        ARRAY_PUSH(hpBedingungen, "")
        protokoll("haltepunkt " + STR$(z) + " an")
    END IF
    ' Laeuft der Debugger gerade an dieser Datei und steht, gilt es sofort.
    IF prozessArt = "debug" AND debugPause AND prozessDatei = pfad THEN debugHaltepunkteSenden()
END SUB

' Umschalt+F9: ein Haltepunkt, der nur haelt, wenn ein Ausdruck wahr ist
' (`i = 3`, `hp < 10`). Der Debugger-Kern kennt das schon (`conditions` im
' set-breakpoints-Kommando), die IDE fragt nur nach dem Ausdruck.
SUB haltepunktBedingungFragen()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, "Erst sichern -- Haltepunkte gehoeren zu einer Datei.") : RETURN
    DIM s AS INTEGER
    (bedingungZeile, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    DIM vorgabe AS STRING : vorgabe = ""
    DIM k AS INTEGER : k = haltepunktIndex(pfad, bedingungZeile)
    IF k >= 0 THEN vorgabe = hpBedingungen[k]
    dlgBedingung = GUI_PROMPT("Bedingter Haltepunkt", "Halten in Zeile " + STR$(bedingungZeile) + ", wenn (leer = immer):", vorgabe)
END SUB

SUB haltepunktBedingungSetzen(ausdruck AS STRING)
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM k AS INTEGER : k = haltepunktIndex(pfad, bedingungZeile)
    IF k < 0 THEN
        ARRAY_PUSH(hpDateien, pfad) : ARRAY_PUSH(hpZeilen, bedingungZeile) : ARRAY_PUSH(hpBedingungen, TRIM$(ausdruck))
    ELSE
        hpBedingungen[k] = TRIM$(ausdruck)
    END IF
    IF TRIM$(ausdruck) = "" THEN
        protokoll("haltepunkt " + STR$(bedingungZeile) + " an")
    ELSE
        protokoll("haltepunkt " + STR$(bedingungZeile) + " bedingt " + TRIM$(ausdruck))
    END IF
    markenSchluessel = ""
    IF prozessArt = "debug" AND debugPause AND prozessDatei = pfad THEN debugHaltepunkteSenden()
END SUB

' --- Lesezeichen -------------------------------------------------------
FUNCTION lesezeichenIndex(pfad AS STRING, zeile AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lzZeilen) - 1
        IF lzDateien[i] = pfad AND lzZeilen[i] = zeile THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB lesezeichenUmschalten()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    DIM k AS INTEGER : k = lesezeichenIndex(pfad, z)
    IF k >= 0 THEN
        ARRAY_REMOVE_AT(lzDateien, k) : ARRAY_REMOVE_AT(lzZeilen, k)
        protokoll("lesezeichen " + STR$(z) + " aus")
    ELSE
        ARRAY_PUSH(lzDateien, pfad) : ARRAY_PUSH(lzZeilen, z)
        protokoll("lesezeichen " + STR$(z) + " an")
    END IF
    markenSchluessel = ""
END SUB

' F2: zum naechsten Lesezeichen hinter der Marke, am Ende wieder von vorn.
' Lesezeichen der Reihe nach -- ueber DATEIEN hinweg: erst die restlichen
' in dieser Datei, dann die naechste Datei, die eins hat. Ein Lesezeichen,
' das man nur in seiner Datei wiederfindet, ist eins zu wenig.
SUB lesezeichenSpringen(vorwaerts AS BOOLEAN)
    IF aktiverTab < 0 THEN RETURN
    IF LEN(lzZeilen) = 0 THEN
        GUI_SET_TEXT(lblStatus, "Kein Lesezeichen gesetzt -- Strg+F2 setzt eins.")
        RETURN
    END IF
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(tabFelder[aktiverTab])
    ' Alle Marken in EINE Reihenfolge bringen: erst nach Datei, dann nach
    ' Zeile. So ist "das naechste" auch ueber die Dateigrenze eindeutig.
    DIM reihe AS ARRAY OF INTEGER : reihe = []
    DIM i AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO LEN(lzZeilen) - 1
        DIM platz AS INTEGER : platz = LEN(reihe)
        FOR k = 0 TO LEN(reihe) - 1
            DIM j AS INTEGER : j = reihe[k]
            IF lzDateien[j] > lzDateien[i] OR (lzDateien[j] = lzDateien[i] AND lzZeilen[j] > lzZeilen[i]) THEN
                platz = k
                BREAK
            END IF
        NEXT
        ARRAY_INSERT(reihe, platz, i)
    NEXT
    ' Wo stehen wir in dieser Reihe?
    DIM hier AS INTEGER : hier = -1
    FOR k = 0 TO LEN(reihe) - 1
        DIM m AS INTEGER : m = reihe[k]
        IF lzDateien[m] < pfad OR (lzDateien[m] = pfad AND lzZeilen[m] <= z) THEN hier = k
    NEXT
    DIM ziel AS INTEGER
    IF vorwaerts THEN
        ziel = (hier + 1) MOD LEN(reihe)
    ELSE
        ziel = hier
        IF ziel < 0 THEN ziel = 0
        ' Steht die Marke GENAU auf einem Lesezeichen, ist "zurueck" das
        ' davor -- sonst kaeme man nie von der Stelle.
        DIM h AS INTEGER : h = reihe[ziel]
        IF lzDateien[h] = pfad AND lzZeilen[h] = z THEN ziel = ziel - 1
        IF ziel < 0 THEN ziel = LEN(reihe) - 1
    END IF
    DIM t AS INTEGER : t = reihe[ziel]
    IF lzDateien[t] <> pfad THEN
        IF NOT FILEEXISTS(lzDateien[t]) THEN
            GUI_SET_TEXT(lblStatus, "Die Datei des Lesezeichens gibt es nicht mehr: " + lzDateien[t])
            RETURN
        END IF
        dateiOeffnen(lzDateien[t])
    END IF
    GUI_TEXTAREA_GOTO(aktivesFeld(), lzZeilen[t], 1)
    GUI_FOCUS(aktivesFeld())
    ' Nur die Zeile ins Protokoll: welche Datei, sagt die "geoeffnet"-Zeile
    ' davor, wenn der Sprung ueber die Grenze ging.
    protokoll("lesezeichen sprung " + STR$(lzZeilen[t]))
END SUB

' Alle Lesezeichen in der Liste unten rechts -- dieselbe wie Suche und
' blame; ein eigenes Panel fuer dieselbe Frage waere eins zu viel.
SUB lesezeichenListe()
    GUI_LISTBOX_CLEAR(lstProbleme)
    DIM sd AS ARRAY OF STRING : sd = []
    DIM sz AS ARRAY OF INTEGER : sz = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(lzZeilen) - 1
        ARRAY_PUSH(sd, lzDateien[i]) : ARRAY_PUSH(sz, lzZeilen[i])
        DIM text AS STRING : text = ""
        TRY
            DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(lzDateien[i])
            IF lzZeilen[i] <= LEN(zeilen) THEN text = TRIM$(zeilen[lzZeilen[i] - 1])
        CATCH e
            text = ""
        END TRY
        GUI_LISTBOX_ADD(lstProbleme, BASENAME(lzDateien[i]) + ":" + STR$(lzZeilen[i]) + ": " + text)
    NEXT
    sucheDateien = sd
    sucheZeilen = sz
    problemModus = 1
    GUI_SET_TEXT(lblProbleme, STR$(LEN(sz)) + " Lesezeichen -- Umschalt+F7 zeigt wieder die Probleme")
    protokoll("lesezeichen liste " + STR$(LEN(sz)))
END SUB

SUB markenNachziehen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    DIM zeilen AS ARRAY OF INTEGER : zeilen = []
    DIM farben AS ARRAY OF INTEGER : farben = []
    DIM schl AS STRING : schl = pfad + "|"
    ' Reihenfolge = Vorrang: die angehaltene Zeile vor dem Haltepunkt vor dem
    ' Fehler vor dem Lesezeichen. Ein bedingter Haltepunkt ist violett.
    IF prozessArt = "debug" AND debugPause AND prozessDatei = pfad AND debugZeile > 0 THEN
        ARRAY_PUSH(zeilen, debugZeile) : ARRAY_PUSH(farben, &HFFD040) : schl = schl + "p" + STR$(debugZeile)
    END IF
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF hpDateien[i] = pfad THEN
            ARRAY_PUSH(zeilen, hpZeilen[i])
            IF hpBedingungen[i] = "" THEN ARRAY_PUSH(farben, &HE05050) ELSE ARRAY_PUSH(farben, &HC060E0)
            schl = schl + "h" + STR$(hpZeilen[i]) + hpBedingungen[i]
        END IF
    NEXT
    FOR i = 0 TO LEN(problemZeilen) - 1
        ARRAY_PUSH(zeilen, problemZeilen[i]) : ARRAY_PUSH(farben, &HD08040) : schl = schl + "f" + STR$(problemZeilen[i])
    NEXT
    FOR i = 0 TO LEN(lzZeilen) - 1
        IF lzDateien[i] = pfad THEN ARRAY_PUSH(zeilen, lzZeilen[i]) : ARRAY_PUSH(farben, &H5090E0) : schl = schl + "l" + STR$(lzZeilen[i])
    NEXT
    ' Geaenderte Zeilen ganz zuletzt: sie sind die schwaechste Aussage und
    ' sollen keinen Haltepunkt zudecken.
    FOR i = 0 TO LEN(gitZeilen) - 1
        ARRAY_PUSH(zeilen, gitZeilen[i]) : ARRAY_PUSH(farben, &H50A070) : schl = schl + "g" + STR$(gitZeilen[i])
    NEXT
    IF schl = markenSchluessel THEN RETURN
    markenSchluessel = schl
    GUI_TEXTAREA_MARKS(ta, zeilen, farben)
END SUB

' --- Hilfe zum Wort unter der Marke ----------------------------------
' Der Aufruf, in dem die Marke gerade steht: rueckwaerts durch die Zeile,
' Klammern zaehlen. Liefert (name, spalte_des_namens, argumentnummer);
' name leer heisst: die Marke steht in keiner Argumentliste.
FUNCTION aufrufUmDieMarke(zeile AS STRING, spalte AS INTEGER) AS TUPLE
    ' MID$ zaehlt ab 0, `spalte` ab 1: die Marke steht VOR Zeichen spalte-1.
    ' Erst zaehlen, wie viele Anfuehrungszeichen links von ihr stehen -- eine
    ' ungerade Zahl heisst: die Marke steht in einer Zeichenkette, und dort
    ' ist jede Klammer nur ein Zeichen.
    DIM q AS INTEGER : q = 0
    DIM k AS INTEGER
    FOR k = 0 TO spalte - 2
        IF MID$(zeile, k, 1) = CHR$(34) THEN q = q + 1
    NEXT
    IF q MOD 2 = 1 THEN RETURN ("", 0, 0)
    DIM tiefe AS INTEGER : tiefe = 0
    DIM arg AS INTEGER : arg = 0
    DIM inText AS BOOLEAN : inText = FALSE
    DIM i AS INTEGER : i = spalte - 2
    WHILE i >= 0
        DIM c AS STRING : c = MID$(zeile, i, 1)
        IF c = CHR$(34) THEN
            inText = NOT inText
        ELSEIF NOT inText THEN
            IF c = ")" THEN
                tiefe = tiefe + 1
            ELSEIF c = "(" THEN
                IF tiefe = 0 THEN
                    ' Gefunden: der Name links davon.
                    DIM e AS INTEGER : e = i - 1
                    WHILE e >= 0 AND MID$(zeile, e, 1) = " " : e = e - 1 : WEND
                    DIM a AS INTEGER : a = e
                    WHILE a >= 0 AND istWortzeichen(MID$(zeile, a, 1)) : a = a - 1 : WEND
                    IF e > a THEN RETURN (MID$(zeile, a + 1, e - a), a + 2, arg)
                    RETURN ("", 0, 0)
                END IF
                tiefe = tiefe - 1
            ELSEIF c = "," AND tiefe = 0 THEN
                arg = arg + 1
            END IF
        END IF
        i = i - 1
    WEND
    RETURN ("", 0, 0)
END FUNCTION

' Signatur des Aufrufs, in dem die Marke steht -- "" wenn keiner.
FUNCTION signaturHilfe$(ta AS GUI_WIDGET, z AS INTEGER, s AS INTEGER) AS STRING
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN ""
    DIM name AS STRING
    DIM spalte AS INTEGER
    DIM arg AS INTEGER
    (name, spalte, arg) = aufrufUmDieMarke(zeilen[z - 1], s)
    IF name = "" THEN RETURN ""
    DIM md AS STRING : md = CODE_HOVER$(GUI_TEXT(ta), z, spalte)
    IF md = "" THEN RETURN ""
    ' Die erste Zeile im Codeblock ist die Signatur.
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, "```", "")
    DIM erste AS STRING : erste = TRIM$(SPLIT$(TRIM$(md), NL)[0])
    IF erste = "" THEN RETURN ""
    RETURN erste + "   -- Argument " + STR$(arg + 1)
END FUNCTION

SUB hilfeNachziehen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM marke AS STRING : marke = STR$(z) + ":" + STR$(s)
    IF marke = letzteMarke THEN RETURN
    letzteMarke = marke
    GUI_SET_TEXT(lblStatus, "Zeile " + STR$(z) + ", Spalte " + STR$(s))
    ' Steht die Marke in einer Argumentliste, gilt die Signatur des Aufrufs:
    ' dort steht sie auf einem Komma oder einer Zahl, und die Hilfe zum Wort
    ' schwiege genau dann, wenn man sie braucht.
    DIM sig AS STRING : sig = signaturHilfe$(ta, z, s)
    IF sig <> "" THEN
        GUI_SET_TEXT(lblHilfe, sig)
        protokoll("signatur " + sig)
        RETURN
    END IF
    DIM md AS STRING : md = CODE_HOVER$(GUI_TEXT(ta), z, s)
    ' Die Markdown-Zaeune weglassen -- die Beschriftung zeigt Text.
    md = REPLACE$(md, "```drachenhauch" + NL, "")
    md = REPLACE$(md, NL + "```", "")
    md = REPLACE$(md, "```", "")
    GUI_SET_TEXT(lblHilfe, md)
END SUB

' --- Vervollstaendigen -------------------------------------------------
' `fokus` entscheidet, wer danach die Tasten bekommt. Beim Tippen bleibt
' die Marke im Code-Feld -- sonst tippte man in die Liste weiter; Strg+Leer
' holt sie dann herein, wenn man etwas auswaehlen will.
SUB vervollstaendigen(fokus AS BOOLEAN)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM namen AS ARRAY OF STRING
    namen = CODE_COMPLETE(q, z, s)
    ' Laenge des Praefixes links der Marke -- so viel wird beim Uebernehmen ersetzt.
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(q, NL)
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    DIM k AS INTEGER : k = s - 1
    vervollPraefixLaenge = 0
    WHILE k > 0
        DIM c AS STRING : c = MID$(zeile, k - 1, 1)
        IF NOT (c = "_" OR (c >= "a" AND c <= "z") OR (c >= "A" AND c <= "Z") OR (c >= "0" AND c <= "9")) THEN BREAK
        vervollPraefixLaenge = vervollPraefixLaenge + 1
        k = k - 1
    WEND
    GUI_LISTBOX_CLEAR(lstVervoll)
    DIM i AS INTEGER
    FOR i = 0 TO MIN(LEN(namen), 200) - 1
        GUI_LISTBOX_ADD(lstVervoll, namen[i])
    NEXT
    IF LEN(namen) = 0 THEN RETURN
    GUI_LISTBOX_SET_SELECTED(lstVervoll, 0)
    GUI_WINDOW_SET_BOUNDS(winVervoll, breiteLinks + 40, 120, 320, 240)
    GUI_WINDOW_VISIBLE(winVervoll, TRUE)
    vervollOffen = TRUE
    vervollWort = wortAnfang$()
    IF fokus THEN GUI_FOCUS(lstVervoll)
END SUB

SUB vervollSchliessen()
    IF NOT vervollOffen THEN RETURN
    GUI_WINDOW_VISIBLE(winVervoll, FALSE)
    vervollOffen = FALSE
    vervollWort = ""
END SUB

' Beim Tippen von selbst: ab drei Zeichen zeigt die Liste, was passt. Der
' Fokus bleibt im Code-Feld -- die Liste ist ein Vorschlag, keine Sperre.
SUB vervollNachziehen()
    IF NOT vorschlagAn OR aktiverTab < 0 OR paletteOffen THEN RETURN
    DIM wort AS STRING : wort = wortAnfang$()
    IF wort = vervollAus THEN RETURN
    vervollAus = "-"
    IF LEN(wort) < 3 THEN
        vervollSchliessen()
        RETURN
    END IF
    IF wort = vervollWort THEN RETURN
    IF GUI_FOCUSED() <> aktivesFeld() THEN RETURN
    vervollstaendigen(FALSE)
END SUB

SUB vervollUebernehmen()
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstVervoll)
    vervollSchliessen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    IF sel >= 0 THEN
        DIM z AS INTEGER
        DIM s AS INTEGER
        (z, s) = GUI_TEXTAREA_CURSOR(ta)
        GUI_TEXTAREA_SELECT(ta, z, s - vervollPraefixLaenge, z, s)
        GUI_TEXTAREA_INSERT(ta, GUI_LISTBOX_ITEM(lstVervoll, sel))
        protokoll("vervollstaendigt " + GUI_LISTBOX_ITEM(lstVervoll, sel))
    END IF
    GUI_FOCUS(ta)
END SUB

' --- Suchen / Ersetzen / Zeile ----------------------------------------
' Passt die Zeile? Mit `regexAn` ueber das regex-Modul, sonst als
' Teiltext ohne Ruecksicht auf Gross/Klein. EINE Stelle fuer Suchen,
' Ersetzen und die Projektsuche -- liefen sie auseinander, faende die eine
' etwas anderes als die andere.
FUNCTION passtSuche(zeile AS STRING, muster AS STRING) AS BOOLEAN
    IF muster = "" THEN RETURN FALSE
    IF NOT regexAn THEN RETURN INSTR(LOWER$(zeile), LOWER$(muster)) >= 0
    TRY
        RETURN REGEX_TEST(zeile, muster)
    CATCH e
        RETURN FALSE
    END TRY
END FUNCTION

FUNCTION weitersuchen(abNaechstem AS BOOLEAN) AS BOOLEAN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR suchtext = "" THEN RETURN FALSE
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    IF regexAn THEN
        ' Zeilenweise: ein regulaerer Ausdruck kann alles Moegliche treffen,
        ' und GUI_TEXTAREA_FIND kennt nur Teiltexte.
        DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
        DIM n AS INTEGER : n = LEN(zeilen)
        DIM k AS INTEGER
        FOR k = 1 TO n
            DIM zi AS INTEGER : zi = ((z - 1 + k) MOD n) + 1
            IF passtSuche(zeilen[zi - 1], suchtext) THEN
                DIM tr AS STRING : tr = ""
                TRY
                    tr = REGEX_FIND(zeilen[zi - 1], suchtext)
                CATCH e
                    tr = ""
                END TRY
                DIM sp AS INTEGER : sp = 1
                IF tr <> "" THEN sp = INSTR(zeilen[zi - 1], tr) + 1
                GUI_TEXTAREA_SELECT(ta, zi, sp, zi, sp + MAX(LEN(tr), 1))
                GUI_FOCUS(ta)
                RETURN TRUE
            END IF
        NEXT
        GUI_SET_TEXT(lblStatus, "Kein Treffer fuer den Ausdruck: " + suchtext)
        RETURN FALSE
    END IF
    IF abNaechstem THEN s = s + 1
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = GUI_TEXTAREA_FIND(ta, suchtext, z, s)
    IF tz < 0 THEN (tz, ts) = GUI_TEXTAREA_FIND(ta, suchtext, 1, 1)
    IF tz < 0 THEN
        GUI_SET_TEXT(lblStatus, "Nicht gefunden: " + suchtext)
        RETURN FALSE
    END IF
    GUI_TEXTAREA_SELECT(ta, tz, ts, tz, ts + LEN(suchtext))
    GUI_FOCUS(ta)
    RETURN TRUE
END FUNCTION

SUB zurDefinition()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM dz AS INTEGER
    DIM ds AS INTEGER
    (dz, ds) = CODE_DEFINITION(GUI_TEXT(ta), z, s)
    IF dz < 1 THEN
        ' CODE_DEFINITION sieht nur DIESEN Text -- was hier fehlt, steht
        ' vielleicht in einer anderen Datei des Projekts.
        DIM k AS INTEGER : k = symbolSuchen(wortUnterMarke$())
        IF k >= 0 THEN
            symbolAnspringen(k)
            RETURN
        END IF
        GUI_SET_TEXT(lblStatus, "Keine Definition zu '" + wortUnterMarke$() + "' -- auch nicht im Projekt.")
        RETURN
    END IF
    GUI_TEXTAREA_GOTO(ta, dz, ds)
END SUB

' --- Handgriffe im Text: Kommentar, Zeilen, Einrueckung, Formatieren -------
' Alle arbeiten auf ganzen ZEILEN: der Auswahl, sonst der Zeile der Marke.
' Geschrieben wird ueber SELECT + INSERT, damit jeder Handgriff ein eigener
' Undo-Schritt bleibt (GUI_SET_TEXT wuerde den Verlauf leeren).
CONST SPALTE_ENDE = 1000000          ' GUI_TEXTAREA_SELECT klemmt ans Zeilenende

FUNCTION zeilenBereich(ta AS GUI_WIDGET) AS TUPLE
    DIM z1 AS INTEGER
    DIM s1 AS INTEGER
    DIM z2 AS INTEGER
    DIM s2 AS INTEGER
    (z1, s1, z2, s2) = GUI_TEXTAREA_SELECTION_RANGE(ta)
    ' Endet die Auswahl am Anfang einer Zeile, gehoert die nicht mehr dazu.
    IF z2 > z1 AND s2 = 1 THEN z2 = z2 - 1
    RETURN (z1, z2)
END FUNCTION

FUNCTION zeilenHolen(alle AS ARRAY OF STRING, z1 AS INTEGER, z2 AS INTEGER) AS ARRAY OF STRING
    DIM block AS ARRAY OF STRING : block = []
    DIM i AS INTEGER
    FOR i = z1 - 1 TO z2 - 1
        IF i >= 0 AND i < LEN(alle) THEN ARRAY_PUSH(block, alle[i])
    NEXT
    RETURN block
END FUNCTION

' --- Mehrere Schreibmarken --------------------------------------------
' Alt+Klick legt eine Marke dazu (das kann der Textbereich selbst), ESC
' raeumt sie weg. Hier kommt der Griff dazu, den man wirklich braucht: eine
' Marke auf JEDE Stelle, an der das Wort unter der Marke steht -- danach
' aendert ein Tippen sie alle auf einmal.
' --- Die Ausgabe durchsuchen ------------------------------------------
' Ein laufendes Programm schreibt hunderte Zeilen; die eine, die man sucht,
' findet man sonst nur durch Scrollen. Gesucht wird AB der gewaehlten Zeile
' weiter -- derselbe Aufruf noch einmal ist "weitersuchen".
SUB ausgabeSuchen(ab AS INTEGER)
    DIM n AS INTEGER : n = GUI_LISTBOX_COUNT(lstAusgabe)
    IF n = 0 THEN
        GUI_SET_TEXT(lblStatus, "Die Ausgabe ist leer.")
        RETURN
    END IF
    DIM klein AS STRING : klein = LOWER$(ausgabeSuchtext)
    DIM i AS INTEGER
    FOR i = MAX(0, ab) TO n - 1
        IF INSTR(LOWER$(GUI_LISTBOX_ITEM(lstAusgabe, i)), klein) >= 0 THEN
            GUI_LISTBOX_SET_SELECTED(lstAusgabe, i)
            GUI_SET_TEXT(lblStatus, "Ausgabe, Zeile " + STR$(i + 1) + ": " + GUI_LISTBOX_ITEM(lstAusgabe, i))
            protokoll("ausgabe treffer " + STR$(i + 1))
            RETURN
        END IF
    NEXT
    GUI_SET_TEXT(lblStatus, "Nicht in der Ausgabe: " + ausgabeSuchtext + " (ab Zeile " + STR$(MAX(0, ab) + 1) + ")")
    protokoll("ausgabe treffer 0")
END SUB

' --- Eine Marke auf die NAECHSTE Fundstelle ---------------------------
' Strg+Umschalt+L setzt sie auf alle auf einmal. Schrittweise ist das
' andere, oft bessere Werkzeug: man sieht jede Stelle, bevor sie dazukommt.
DIM mcWort AS STRING : mcWort = ""
DIM mcZeile AS INTEGER : mcZeile = 0
DIM mcSpalte AS INTEGER : mcSpalte = 0

' Die naechste Fundstelle ab (vonZ, vonS) als (zeile, spalte), sonst (-1, -1).
' GANZE Woerter: GUI_TEXTAREA_FIND sucht Teiltexte, und aus `hp` waere sonst
' auch das in `hpmax` eine Marke.
FUNCTION naechsteFundstelle(ta AS GUI_WIDGET, wort AS STRING, vonZ AS INTEGER, vonS AS INTEGER) AS TUPLE
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = GUI_TEXTAREA_FIND(ta, wort, vonZ, vonS, TRUE)
    WHILE tz >= 1 AND tz <= LEN(zeilen)
        DIM zl AS STRING : zl = zeilen[tz - 1]
        DIM davor AS BOOLEAN : davor = ts > 1 AND istWortzeichen(MID$(zl, ts - 2, 1))
        DIM danach AS BOOLEAN : danach = istWortzeichen(MID$(zl, ts - 1 + LEN(wort), 1))
        IF NOT davor AND NOT danach THEN RETURN (tz, ts)
        (tz, ts) = GUI_TEXTAREA_FIND(ta, wort, tz, ts + 1, TRUE)
    WEND
    RETURN (-1, -1)
END FUNCTION

SUB markeNaechste()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF wort = "" THEN
        GUI_SET_TEXT(lblStatus, "Unter der Marke steht kein Wort.")
        RETURN
    END IF
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    ' Ein anderes Wort faengt von vorn an -- sonst suchte man mitten in der
    ' Datei weiter nach etwas, das man gerade erst angeklickt hat. Die
    ' fuehrende Marke rueckt dabei an den ANFANG des Wortes: von dort sucht
    ' die naechste Runde weiter, und jede Marke steht an derselben Stelle
    ' ihres Wortes.
    IF wort <> mcWort THEN
        mcWort = wort
        GUI_TEXTAREA_CLEAR_CARETS(ta)
        DIM anf AS INTEGER : anf = wortSpalte(ta)
        IF anf > 0 THEN
            GUI_TEXTAREA_GOTO(ta, z, anf)
            s = anf
        END IF
        mcZeile = z
        mcSpalte = s
    END IF
    DIM vorher AS INTEGER : vorher = GUI_TEXTAREA_CARETS(ta)
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = naechsteFundstelle(ta, wort, mcZeile, mcSpalte + 1)
    ' Nichts mehr dahinter: von vorn.
    IF tz < 0 THEN (tz, ts) = naechsteFundstelle(ta, wort, 1, 1)
    IF tz < 0 THEN
        GUI_SET_TEXT(lblStatus, "'" + wort + "' steht nur an dieser einen Stelle.")
        mcWort = ""
        protokoll("marke naechste 0")
        RETURN
    END IF
    mcZeile = tz
    mcSpalte = ts
    GUI_TEXTAREA_ADD_CARET(ta, tz, ts)
    DIM jetzt AS INTEGER : jetzt = GUI_TEXTAREA_CARETS(ta)
    ' Dieselbe Stelle noch einmal ist keine neue Marke -- dann sind alle
    ' Fundstellen schon markiert, und das sagen wir, statt stumm zu kreisen.
    IF jetzt = vorher THEN
        GUI_SET_TEXT(lblStatus, "Jede Fundstelle von '" + wort + "' hat eine Marke (" + STR$(jetzt) + ").")
    ELSE
        GUI_SET_TEXT(lblStatus, STR$(jetzt) + " Marken auf '" + wort + "'.")
    END IF
    protokoll("marke naechste " + STR$(jetzt))
END SUB

' --- Ersetzen im ganzen Projekt ---------------------------------------
' Wortwoertlich, oder mit regulaerem Ausdruck, wenn der Schalter an ist --
' dieselbe Wahl wie bei der Suche. Gearbeitet wird auf den DATEIEN; ein
' Reiter mit ungesicherten Aenderungen bricht ab, statt sie zu ueberschreiben.
FUNCTION projektErsetzenZaehlen(gesucht AS STRING) AS TUPLE
    DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(projektOrdner, "*.dh")
    DIM stellen AS INTEGER : stellen = 0
    DIM wieViele AS INTEGER : wieViele = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(projektOrdner, d))
        DIM hier AS INTEGER : hier = 0
        DIM z AS STRING
        FOR EACH z IN zeilen
            IF passtSuche(z, gesucht) THEN hier = hier + 1
        NEXT
        IF hier > 0 THEN
            stellen = stellen + hier
            wieViele = wieViele + 1
        END IF
    NEXT
    RETURN (stellen, wieViele)
END FUNCTION

FUNCTION projektUngesichert() AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF tabPfade[i] <> "" AND GUI_TEXT(tabFelder[i]) <> tabGesichert[i] THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

SUB projektErsetzenAusfuehren()
    DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(projektOrdner, "*.dh")
    DIM geaendert AS INTEGER : geaendert = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM alt AS STRING : alt = JOIN$(READLINES(pfad), NL)
        DIM neu AS STRING
        IF regexAn THEN
            neu = REGEX_REPLACE(alt, suchtext, ersatztext)
        ELSE
            neu = REPLACE$(alt, suchtext, ersatztext)
        END IF
        IF neu = alt THEN CONTINUE
        WRITEALL(pfad, neu + NL)
        geaendert = geaendert + 1
        ' Offene Reiter zeigen sonst den alten Text und schrieben ihn beim
        ' naechsten Sichern zurueck.
        DIM t AS INTEGER : t = tabMitPfad(pfad)
        IF t >= 0 THEN
            GUI_SET_TEXT(tabFelder[t], neu)
            tabGesichert[t] = neu
            tabLetzterText[t] = ""
        END IF
    NEXT
    reiterNeuSetzen()
    GUI_SET_TEXT(lblStatus, "Ersetzt in " + STR$(geaendert) + " Datei(en).")
    protokoll("projekt ersetzt " + STR$(geaendert))
END SUB

' --- Marke an jedes Zeilenende der Auswahl ----------------------------
' Der Griff, mit dem man eine Liste in einem Zug umschreibt: markieren,
' Strg+Umschalt+I, tippen -- und jede Zeile bekommt dasselbe ans Ende.
SUB markenAnZeilenenden()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    IF z2 <= z1 THEN
        GUI_SET_TEXT(lblStatus, "Erst mehrere Zeilen markieren.")
        protokoll("marken enden 0")
        RETURN
    END IF
    GUI_TEXTAREA_CLEAR_CARETS(ta)
    GUI_TEXTAREA_GOTO(ta, z1, SPALTE_ENDE)
    DIM z AS INTEGER
    FOR z = z1 + 1 TO z2
        GUI_TEXTAREA_ADD_CARET(ta, z, SPALTE_ENDE)
    NEXT
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, STR$(GUI_TEXTAREA_CARETS(ta)) + " Marken, je eine am Zeilenende.")
    protokoll("marken enden " + STR$(GUI_TEXTAREA_CARETS(ta)))
END SUB

' --- Zeilen-Werkzeuge -------------------------------------------------
' Sortieren, Doppelte entfernen, Leerraum am Ende weg: auf der Auswahl,
' und ohne Auswahl auf der ganzen Datei -- eine einzelne Zeile zu
' sortieren ergibt nichts. Geschrieben wird ueber zeilenErsetzen, damit
' jeder Griff EIN Undo-Schritt bleibt.
SUB zeilenWerkzeug(art AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM alle AS ARRAY OF STRING : alle = SPLIT$(GUI_TEXT(ta), NL)
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    IF z1 = z2 THEN
        z1 = 1
        z2 = LEN(alle)
    END IF
    DIM block AS ARRAY OF STRING : block = zeilenHolen(alle, z1, z2)
    DIM raus AS ARRAY OF STRING : raus = []
    DIM z AS STRING
    IF art = "sortieren" THEN
        FOR EACH z IN block
            ARRAY_PUSH(raus, z)
        NEXT
        SORT(raus)
    ELSEIF art = "doppelte" THEN
        DIM gesehen AS MAP OF INTEGER : gesehen = {}
        FOR EACH z IN block
            IF NOT MAPHAS(gesehen, z) THEN
                MAPPUT(gesehen, z, 1)
                ARRAY_PUSH(raus, z)
            END IF
        NEXT
    ELSE
        FOR EACH z IN block
            ARRAY_PUSH(raus, RTRIM$(z))
        NEXT
    END IF
    zeilenErsetzen(ta, z1, z2, raus)
    GUI_SET_TEXT(lblStatus, STR$(LEN(block)) + " Zeilen -> " + STR$(LEN(raus)) + " (" + art + ").")
    protokoll("zeilen " + art + " " + STR$(LEN(raus)))
END SUB

' --- Umbenennen im ganzen Projekt -------------------------------------
' CODE_RENAME$ arbeitet auf EINEM Text und braucht eine Stelle, an der der
' Name steht. In einer fremden Datei kennen wir sie nicht -- also werden
' die Fundstellen der Reihe nach probiert, bis eine den Text wirklich
' aendert. Eine Stelle in einem Kommentar oder in einer Zeichenkette
' aendert nichts, und dann kommt eben die naechste dran.
FUNCTION umbenennenInText$(quelle AS STRING, wort AS STRING, neu AS STRING) AS STRING
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(quelle, NL)
    DIM versuche AS INTEGER : versuche = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM zl AS STRING : zl = zeilen[i]
        DIM s AS INTEGER : s = INSTR(zl, wort)
        WHILE s >= 0 AND versuche < 200
            DIM davor AS BOOLEAN : davor = s > 0 AND istWortzeichen(MID$(zl, s - 1, 1))
            DIM danach AS BOOLEAN : danach = istWortzeichen(MID$(zl, s + LEN(wort), 1))
            IF NOT davor AND NOT danach THEN
                versuche = versuche + 1
                DIM ergebnis AS STRING : ergebnis = ""
                TRY
                    ergebnis = CODE_RENAME$(quelle, i + 1, s + 1, neu)
                CATCH e
                    ergebnis = ""
                END TRY
                IF ergebnis <> "" AND ergebnis <> quelle THEN RETURN ergebnis
            END IF
            s = INSTR(zl, wort, s + 1)
        WEND
    NEXT
    RETURN quelle
END FUNCTION

SUB umbenennenImProjekt(neu AS STRING)
    IF projektUngesichert() THEN
        GUI_SET_TEXT(lblStatus, "Erst sichern: ein Reiter hat ungesicherte Aenderungen.")
        protokoll("projekt umbenannt -1")
        RETURN
    END IF
    DIM wort AS STRING : wort = umbenennWort
    IF wort = "" OR neu = "" OR wort = neu THEN RETURN
    DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(projektOrdner, "*.dh")
    DIM geaendert AS INTEGER : geaendert = 0
    DIM d AS STRING
    FOR EACH d IN dateien
        DIM pfad AS STRING : pfad = PATHJOIN(projektOrdner, d)
        DIM alt AS STRING : alt = JOIN$(READLINES(pfad), NL)
        IF INSTR(alt, wort) < 0 THEN CONTINUE
        DIM frisch AS STRING : frisch = umbenennenInText$(alt, wort, neu)
        IF frisch = alt THEN CONTINUE
        WRITEALL(pfad, frisch + NL)
        geaendert = geaendert + 1
        DIM t AS INTEGER : t = tabMitPfad(pfad)
        IF t >= 0 THEN
            GUI_SET_TEXT(tabFelder[t], frisch)
            tabGesichert[t] = frisch
            tabLetzterText[t] = ""
        END IF
    NEXT
    reiterNeuSetzen()
    symSchluessel = "-"
    GUI_SET_TEXT(lblStatus, "'" + wort + "' -> '" + neu + "' in " + STR$(geaendert) + " Datei(en).")
    protokoll("projekt umbenannt " + STR$(geaendert))
END SUB

' --- Zwei Dateien vergleichen -----------------------------------------
' `git diff --no-index` kann das auch fuer Dateien, die gar nicht in einem
' Verzeichnis unter Versionsverwaltung liegen. Gezeigt wird es im selben
' Fenster und mit derselben Faerbung wie git diff.
SUB dateienVergleichen()
    IF aktiverTab < 0 OR tabPfade[aktiverTab] = "" THEN
        GUI_SET_TEXT(lblStatus, "Vergleichen: diese Datei ist noch nicht gesichert.")
        RETURN
    END IF
    ' Steht im Projektbaum eine ANDERE Datei gewaehlt, ist sie gemeint --
    ' sonst fragt der Datei-Dialog. Ein Dialog, den man jedes Mal bekommt,
    ' auch wenn die Antwort schon dasteht, ist einer zu viel.
    DIM anderer AS STRING : anderer = ""
    DIM sel AS INTEGER : sel = GUI_TREE_SELECTED(baum)
    DIM bi AS INTEGER
    FOR bi = 0 TO LEN(baumDateien) - 1
        IF baumKnoten[bi] = sel THEN anderer = PATHJOIN(projektOrdner, baumDateien[bi])
    NEXT
    IF anderer <> "" AND wegGleich$(anderer) = wegGleich$(tabPfade[aktiverTab]) THEN anderer = ""
    IF anderer = "" THEN anderer = FILE_OPEN_DIALOG("Womit vergleichen?", "dh")
    IF anderer = "" THEN RETURN
    DIM meiner AS STRING : meiner = tabPfade[aktiverTab]
    DIM text AS STRING : text = ""
    TRY
        text = SHELL_OUT$("git", "diff", "--no-index", "--no-color", "--", meiner, anderer)
    CATCH e
        text = ""
    END TRY
    IF TRIM$(text) = "" THEN
        GUI_SET_TEXT(lblStatus, "Kein Unterschied zu " + BASENAME(anderer) + ".")
        protokoll("vergleich 0")
        RETURN
    END IF
    GUI_SET_TEXT(taGit, text)
    GUI_WINDOW_TITLE(winGit, BASENAME(meiner) + " gegen " + BASENAME(anderer))
    GUI_SET_TEXT(lblGit, STR$(LEN(SPLIT$(text, NL))) + " Zeilen")
    GUI_WINDOW_VISIBLE(winGit, TRUE)
    GUI_FOCUS(taGit)
    gitFaerben()
    protokoll("vergleich " + STR$(LEN(SPLIT$(text, NL))))
END SUB

SUB markenAufFundstellen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF wort = "" THEN
        GUI_SET_TEXT(lblStatus, "Unter der Marke steht kein Wort.")
        RETURN
    END IF
    GUI_TEXTAREA_CLEAR_CARETS(ta)
    ' GUI_TEXTAREA_FIND sucht Teiltexte -- aus `hp` wuerde sonst auch das
    ' `hp` in `hpmax` eine Marke, und ein Tippen aenderte einen Namen, der
    ' gar nicht gemeint war. Die Grenzen prueft die IDE selbst.
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM erste AS BOOLEAN : erste = TRUE
    DIM n AS INTEGER : n = 0
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = GUI_TEXTAREA_FIND(ta, wort, 1, 1, TRUE)
    WHILE tz >= 0 AND n < 200
        DIM zl AS STRING : zl = zeilen[tz - 1]
        DIM davor AS BOOLEAN : davor = ts > 1 AND istWortzeichen(MID$(zl, ts - 2, 1))
        DIM danach AS BOOLEAN : danach = istWortzeichen(MID$(zl, ts - 1 + LEN(wort), 1))
        IF NOT davor AND NOT danach THEN
            IF erste THEN
                GUI_TEXTAREA_GOTO(ta, tz, ts)
                erste = FALSE
            ELSE
                GUI_TEXTAREA_ADD_CARET(ta, tz, ts)
            END IF
            n = n + 1
        END IF
        (tz, ts) = GUI_TEXTAREA_FIND(ta, wort, tz, ts + LEN(wort), TRUE)
    WEND
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, STR$(n) + " Marken auf '" + wort + "' -- tippen aendert alle, ESC raeumt sie weg.")
    protokoll("marken " + STR$(n))
END SUB

' --- Umbenennen (Umschalt+F6) ----------------------------------------
' Das Umbenennen selbst macht CODE_RENAME$: ganze Woerter, ohne Kommentare
' und Zeichenketten. Die IDE fragt nur den neuen Namen und schreibt das
' Ergebnis als EINEN Undo-Schritt zurueck (Auswahl ueber alles + INSERT --
' GUI_SET_TEXT leerte den Verlauf).
SUB umbenennenFragen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM alt AS STRING : alt = wortUnterMarke$()
    IF alt = "" THEN
        GUI_SET_TEXT(lblStatus, "Umbenennen: unter der Marke steht kein Name.")
        RETURN
    END IF
    (umbenennZeile, umbenennSpalte) = GUI_TEXTAREA_CURSOR(ta)
    dlgUmbenennen = GUI_PROMPT("Umbenennen", "'" + alt + "' ueberall nennen in:", alt)
END SUB

SUB umbenennenAusfuehren(neu AS STRING)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM q AS STRING : q = GUI_TEXT(ta)
    DIM neuText AS STRING : neuText = CODE_RENAME$(q, umbenennZeile, umbenennSpalte, neu)
    IF neuText = "" THEN
        GUI_SET_TEXT(lblStatus, "Umbenennen: '" + neu + "' geht nicht -- ein Name faengt mit Buchstabe oder _ an, und Schluesselwoerter bleiben, wie sie sind.")
        RETURN
    END IF
    IF neuText = q THEN
        GUI_SET_TEXT(lblStatus, "Umbenennen: nichts zu tun.")
        RETURN
    END IF
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(q, NL)
    DIM letzte AS INTEGER : letzte = LEN(zeilen)
    GUI_TEXTAREA_SELECT(ta, 1, 1, letzte, LEN(zeilen[letzte - 1]) + 1)
    GUI_TEXTAREA_INSERT(ta, neuText)
    GUI_TEXTAREA_GOTO(ta, umbenennZeile, umbenennSpalte)
    GUI_FOCUS(ta)
    ' Die Zahl der Fundstellen sagt CODE_REFERENCES -- am ALTEN Text, denn
    ' im neuen heisst der Name schon anders.
    DIM n AS INTEGER : n = LEN(CODE_REFERENCES(q, umbenennZeile, umbenennSpalte))
    GUI_SET_TEXT(lblStatus, STR$(n) + " Stellen umbenannt in '" + neu + "'.")
    protokoll("umbenannt " + STR$(n) + " " + neu)
END SUB

' --- Schnipsel (Strg+J) -----------------------------------------------
' Vorlagen mit einem Platzhalter `|` fuer die Schreibmarke. Die Einrueckung
' der laufenden Zeile wird auf jede weitere Zeile uebernommen -- sonst
' klebte ein eingefuegter Block am linken Rand.
DIM schnipselNamen AS ARRAY OF STRING : schnipselNamen = []
DIM schnipselText AS ARRAY OF STRING : schnipselText = []
' Das kurze Wort, das den Schnipsel am Tabulator aufklappt. Die Laufzeit
' meldet nur, DASS eines links der Marke steht (GUI_TEXTAREA_ABBREV) --
' was an seine Stelle kommt, steht hier.
DIM schnipselAbk AS ARRAY OF STRING : schnipselAbk = []

SUB schnipsel(name AS STRING, abk AS STRING, text AS STRING)
    ARRAY_PUSH(schnipselNamen, name + "   [" + abk + "]")
    ARRAY_PUSH(schnipselAbk, abk)
    ARRAY_PUSH(schnipselText, text)
END SUB

' `weg` = so viele Zeichen links der Marke weichen (das getippte Kuerzel).
SUB schnipselEinfuegen(nummer AS INTEGER, weg AS INTEGER = 0)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 OR nummer < 0 OR nummer >= LEN(schnipselText) THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    IF weg > 0 AND s - weg >= 1 THEN
        ' Das Kuerzel markieren -- GUI_TEXTAREA_INSERT ersetzt die Auswahl,
        ' und die Marke steht danach dort, wo das Wort anfing.
        GUI_TEXTAREA_SELECT(ta, z, s - weg, z, s)
        s = s - weg
    END IF
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM einzug AS STRING : einzug = ""
    IF z >= 1 AND z <= LEN(zeilen) THEN
        ' MID$ zaehlt ab 0 -- Zeichen k ist MID$(s, k, 1).
        DIM k AS INTEGER : k = 0
        WHILE k < LEN(zeilen[z - 1]) AND MID$(zeilen[z - 1], k, 1) = " "
            einzug = einzug + " " : k = k + 1
        WEND
    END IF
    ' Eingerueckt wird Zeile fuer Zeile, LEERE ausgenommen: ein blindes
    ' REPLACE$ machte aus jeder Leerzeile vier Leerzeichen, und die sieht man
    ' erst im Diff.
    DIM roh AS ARRAY OF STRING : roh = SPLIT$(schnipselText[nummer], NL)
    DIM zusammen AS ARRAY OF STRING : zusammen = []
    DIM ri AS INTEGER
    FOR ri = 0 TO LEN(roh) - 1
        IF ri = 0 OR roh[ri] = "" THEN
            ARRAY_PUSH(zusammen, roh[ri])
        ELSE
            ARRAY_PUSH(zusammen, einzug + roh[ri])
        END IF
    NEXT
    DIM text AS STRING : text = JOIN$(zusammen, NL)
    ' Wohin die Marke danach gehoert: der Platzhalter | wird gezaehlt und
    ' entfernt. Ohne ihn steht sie am Ende, wie nach jedem Einfuegen.
    ' INSTR zaehlt ab 0 und liefert -1, wenn es den Platzhalter nicht gibt.
    DIM marke AS INTEGER : marke = INSTR(text, "|")
    text = REPLACE$(text, "|", "")
    GUI_TEXTAREA_INSERT(ta, text)
    IF marke >= 0 THEN
        DIM vor AS STRING : vor = LEFT$(text, marke)
        DIM neueZ AS INTEGER : neueZ = z + LEN(SPLIT$(vor, NL)) - 1
        DIM letzteZ AS STRING : letzteZ = SPLIT$(vor, NL)[LEN(SPLIT$(vor, NL)) - 1]
        DIM neueS AS INTEGER : neueS = LEN(letzteZ) + 1
        IF neueZ = z THEN neueS = s + LEN(letzteZ)
        GUI_TEXTAREA_GOTO(ta, neueZ, neueS)
    END IF
    GUI_FOCUS(ta)
    GUI_SET_TEXT(lblStatus, "Schnipsel: " + schnipselNamen[nummer])
    protokoll("schnipsel " + schnipselNamen[nummer])
END SUB

SUB schnipselWaehlen()
    IF aktivesFeld() < 0 THEN RETURN
    paletteNamen = []
    paletteKennungen = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(schnipselNamen) - 1
        ARRAY_PUSH(paletteNamen, schnipselNamen[i]) : ARRAY_PUSH(paletteKennungen, STR$(i))
    NEXT
    waehlerOeffnen("schnipsel", "Schnipsel einfuegen")
    ' Der Wortanfang links der Marke fuellt den Filter schon aus: wer `for`
    ' getippt hat und Strg+J drueckt, hat die FOR-Schleife vor sich.
    DIM anfang AS STRING : anfang = wortAnfang$()
    IF anfang <> "" THEN
        GUI_SET_TEXT(tfPalette, anfang)
        paletteLetzterFilter = anfang
        paletteFuellen(anfang)
    END IF
END SUB

SUB zeilenErsetzen(ta AS GUI_WIDGET, z1 AS INTEGER, z2 AS INTEGER, neu AS ARRAY OF STRING)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
    GUI_TEXTAREA_INSERT(ta, JOIN$(neu, NL))
END SUB

SUB kommentarUmschalten()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM alleKommentiert AS BOOLEAN : alleKommentiert = TRUE
    DIM einzug AS INTEGER : einzug = -1
    DIM i AS INTEGER
    FOR i = 0 TO LEN(block) - 1
        DIM t AS STRING : t = LTRIM$(block[i])
        IF t = "" THEN CONTINUE
        IF LEFT$(t, 1) <> "'" THEN alleKommentiert = FALSE
        DIM e AS INTEGER : e = LEN(block[i]) - LEN(t)
        IF einzug < 0 OR e < einzug THEN einzug = e
    NEXT
    IF einzug < 0 THEN RETURN                      ' nur Leerzeilen
    FOR i = 0 TO LEN(block) - 1
        DIM t2 AS STRING : t2 = LTRIM$(block[i])
        IF t2 = "" THEN CONTINUE
        IF alleKommentiert THEN
            DIM rest AS STRING : rest = MID$(t2, 1)
            IF LEFT$(rest, 1) = " " THEN rest = MID$(rest, 1)
            block[i] = LEFT$(block[i], LEN(block[i]) - LEN(t2)) + rest
        ELSE
            block[i] = LEFT$(block[i], einzug) + "' " + MID$(block[i], einzug)
        END IF
    NEXT
    zeilenErsetzen(ta, z1, z2, block)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
    protokoll("kommentar " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenDuplizieren()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM doppelt AS ARRAY OF STRING : doppelt = []
    DIM z AS STRING
    FOR EACH z IN block : ARRAY_PUSH(doppelt, z) : NEXT
    FOR EACH z IN block : ARRAY_PUSH(doppelt, z) : NEXT
    zeilenErsetzen(ta, z1, z2, doppelt)
    GUI_TEXTAREA_GOTO(ta, z2 + 1, 1)
    protokoll("dupliziert " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenLoeschen()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM anzahl AS INTEGER : anzahl = LEN(SPLIT$(GUI_TEXT(ta), NL))
    IF z2 < anzahl THEN
        GUI_TEXTAREA_SELECT(ta, z1, 1, z2 + 1, 1)          ' samt dem Umbruch dahinter
    ELSEIF z1 > 1 THEN
        GUI_TEXTAREA_SELECT(ta, z1 - 1, SPALTE_ENDE, z2, SPALTE_ENDE)   ' die letzte: samt dem Umbruch davor
    ELSE
        GUI_TEXTAREA_SELECT(ta, 1, 1, z2, SPALTE_ENDE)
    END IF
    GUI_TEXTAREA_INSERT(ta, "")
    GUI_TEXTAREA_GOTO(ta, MIN(z1, MAX(anzahl - (z2 - z1 + 1), 1)), 1)
    protokoll("geloescht " + STR$(z1) + "-" + STR$(z2))
END SUB

SUB zeilenVerschieben(richtung AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM alle AS ARRAY OF STRING : alle = SPLIT$(GUI_TEXT(ta), NL)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(alle, z1, z2)
    DIM neu AS ARRAY OF STRING : neu = []
    DIM z AS STRING
    IF richtung < 0 THEN
        IF z1 <= 1 THEN RETURN
        FOR EACH z IN block : ARRAY_PUSH(neu, z) : NEXT
        ARRAY_PUSH(neu, alle[z1 - 2])
        zeilenErsetzen(ta, z1 - 1, z2, neu)
        GUI_TEXTAREA_SELECT(ta, z1 - 1, 1, z2 - 1, SPALTE_ENDE)
    ELSE
        IF z2 >= LEN(alle) THEN RETURN
        ARRAY_PUSH(neu, alle[z2])
        FOR EACH z IN block : ARRAY_PUSH(neu, z) : NEXT
        zeilenErsetzen(ta, z1, z2 + 1, neu)
        GUI_TEXTAREA_SELECT(ta, z1 + 1, 1, z2 + 1, SPALTE_ENDE)
    END IF
    protokoll("verschoben " + STR$(z1) + "-" + STR$(z2) + " " + STR$(richtung))
END SUB

SUB einruecken(richtung AS INTEGER)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM z1 AS INTEGER
    DIM z2 AS INTEGER
    (z1, z2) = zeilenBereich(ta)
    DIM block AS ARRAY OF STRING : block = zeilenHolen(SPLIT$(GUI_TEXT(ta), NL), z1, z2)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(block) - 1
        IF TRIM$(block[i]) = "" THEN CONTINUE
        IF richtung > 0 THEN
            block[i] = "    " + block[i]
        ELSE
            DIM weg AS INTEGER : weg = 0
            WHILE weg < 4 AND weg < LEN(block[i]) AND MID$(block[i], weg, 1) = " " : weg = weg + 1 : WEND
            block[i] = MID$(block[i], weg)
        END IF
    NEXT
    zeilenErsetzen(ta, z1, z2, block)
    GUI_TEXTAREA_SELECT(ta, z1, 1, z2, SPALTE_ENDE)
END SUB

' Umschalt+Alt+F: derselbe Formatierer wie `dhrt fmt` -- Schluesselwoerter
' gross, Bloecke eingerueckt, Leerraum am Zeilenende weg.
SUB formatieren()
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN
    DIM text AS STRING : text = GUI_TEXT(ta)
    DIM neu AS STRING : neu = CODE_FORMAT$(text)
    IF neu = "" AND TRIM$(text) <> "" THEN
        GUI_SET_TEXT(lblStatus, "Nicht formatiert: die Quelle laesst sich nicht lesen (Syntaxfehler, siehe Probleme).")
        RETURN
    END IF
    IF RIGHT$(text, 1) = NL THEN neu = neu + NL
    IF neu = text THEN GUI_SET_TEXT(lblStatus, "Schon formatiert.") : RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    GUI_TEXTAREA_SELECT(ta, 1, 1, LEN(SPLIT$(text, NL)), SPALTE_ENDE)
    GUI_TEXTAREA_INSERT(ta, neu)
    GUI_TEXTAREA_GOTO(ta, z, s)
    GUI_SET_TEXT(lblStatus, "Formatiert.")
    protokoll("formatiert")
END SUB

' --- Export als eigenstaendiges Programm (dhrt --export) ----------------
SUB exportieren()
    IF aktiverTab < 0 THEN RETURN
    IF exportProzess >= 0 THEN GUI_SET_TEXT(lblStatus, "Ein Export laeuft noch.") : RETURN
    IF tabPfade[aktiverTab] = "" OR GUI_TEXT(tabFelder[aktiverTab]) <> tabGesichert[aktiverTab] THEN
        IF NOT sichern(aktiverTab, FALSE) THEN RETURN
    END IF
    exportDatei = tabPfade[aktiverTab]
    exportProzess = PROCESS_START("dhrt", "--export", exportDatei)
    GUI_SET_TEXT(lblStatus, "Export laeuft: " + BASENAME(exportDatei) + " ...")
    protokoll("export " + exportDatei)
END SUB

SUB exportNachsehen()
    IF exportProzess < 0 THEN RETURN
    DIM t AS STRING : t = PROCESS_READ$(exportProzess) + PROCESS_ERR$(exportProzess)
    IF t <> "" THEN ausgabeVerteilen(t)
    IF PROCESS_RUNNING(exportProzess) THEN RETURN
    DIM code AS INTEGER : code = PROCESS_CODE(exportProzess)
    PROCESS_CLOSE(exportProzess)
    exportProzess = -1
    DIM stamm AS STRING : stamm = BASENAME(exportDatei)
    IF LOWER$(RIGHT$(stamm, 3)) = ".dh" THEN stamm = LEFT$(stamm, LEN(stamm) - 3)
    DIM ziel AS STRING : ziel = PATHJOIN(DIRNAME(exportDatei), stamm + "_dist")
    IF code = 0 THEN
        GUI_SET_TEXT(lblStatus, "Exportiert nach " + ziel)
    ELSE
        GUI_SET_TEXT(lblStatus, "Export fehlgeschlagen (Code " + STR$(code) + ") -- siehe Ausgabe.")
    END IF
    protokoll("exportiert " + STR$(code) + " " + ziel)
END SUB

' --- Ausfuehren --------------------------------------------------------
SUB ausgabe(zeile AS STRING)
    GUI_LISTBOX_ADD(lstAusgabe, zeile)
    IF GUI_LISTBOX_COUNT(lstAusgabe) > 2000 THEN GUI_LISTBOX_REMOVE(lstAusgabe, 0)
    GUI_LISTBOX_SET_SELECTED(lstAusgabe, GUI_LISTBOX_COUNT(lstAusgabe) - 1)
END SUB

DIM ausgabeRest AS STRING : ausgabeRest = ""

SUB ausgabeVerteilen(text AS STRING)
    IF text = "" THEN RETURN
    ausgabeRest = ausgabeRest + text
    WHILE INSTR(ausgabeRest, NL) >= 0
        DIM p AS INTEGER : p = INSTR(ausgabeRest, NL)
        DIM z AS STRING : z = LEFT$(ausgabeRest, p)
        z = REPLACE$(z, CHR$(13), "")
        ausgabe(z)
        ausgabeRest = MID$(ausgabeRest, p + 1)
    WEND
END SUB

' Ein Programm starten -- als Lauf, im Debugger oder unter dem Profiler.
' Alle drei sind derselbe Kindprozess mit einem anderen Unterbefehl.
FUNCTION prozessStarten(art AS STRING) AS BOOLEAN
    IF aktiverTab < 0 THEN RETURN FALSE
    IF prozess >= 0 THEN
        GUI_SET_TEXT(lblStatus, "Es laeuft noch ein Programm -- erst stoppen (Umschalt+F5).")
        RETURN FALSE
    END IF
    IF tabPfade[aktiverTab] = "" OR GUI_TEXT(tabFelder[aktiverTab]) <> tabGesichert[aktiverTab] THEN
        IF NOT sichern(aktiverTab, FALSE) THEN RETURN FALSE
    END IF
    GUI_LISTBOX_CLEAR(lstAusgabe)
    ausgabeRest = "" : prozessRest = ""
    prozessDatei = tabPfade[aktiverTab]
    prozessArt = art
    prozess = PROCESS_START("dhrt", art, prozessDatei)
    GUI_SET_TEXT(lblAusgabe, "Ausgabe: " + BASENAME(prozessDatei) + " laeuft ...")
    GUI_SET_TEXT(lblStatus, "Gestartet: " + prozessDatei)
    RETURN TRUE
END FUNCTION

SUB starten()
    IF prozessStarten("run") THEN protokoll("gestartet " + prozessDatei)
END SUB

SUB stoppen()
    IF prozess < 0 THEN RETURN
    IF prozessArt = "debug" AND debugPause THEN debugSenden("stop")
    PROCESS_KILL(prozess)
    fertigNachStopp = TRUE
END SUB

' --- Debugger: Client von `dhrt debug` (JSON-Zeilen: stdin Kommandos,
' stdout Ereignisse). Kommandos nimmt das Kind nur an, solange es steht.
SUB debuggen()
    IF NOT prozessStarten("debug") THEN RETURN
    debugPause = FALSE : debugErst = TRUE : debugZeile = 0
    GUI_SET_TEXT(lblDebug, "Debugger: laeuft ...")
    GUI_TABLE_CLEAR(tblVars)
    debugPanelZeigen(TRUE)
    protokoll("debug gestartet")
END SUB

SUB debugSenden(cmd AS STRING)
    IF prozess < 0 OR prozessArt <> "debug" THEN RETURN
    PROCESS_WRITE(prozess, "{" + CHR$(34) + "cmd" + CHR$(34) + ":" + CHR$(34) + cmd + CHR$(34) + "}" + NL)
END SUB

' Ein Text als JSON-Zeichenkette (mit Anfuehrungszeichen).
FUNCTION jsonText$(s AS STRING) AS STRING
    DIM j AS STRING : j = REPLACE$(s, "\", "\\")
    j = REPLACE$(j, CHR$(34), "\" + CHR$(34))
    RETURN CHR$(34) + j + CHR$(34)
END FUNCTION

SUB debugHaltepunkteSenden()
    IF prozess < 0 OR prozessArt <> "debug" THEN RETURN
    DIM liste AS STRING : liste = ""
    DIM bedingungen AS STRING : bedingungen = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hpZeilen) - 1
        IF hpDateien[i] = prozessDatei THEN
            IF liste <> "" THEN liste = liste + ","
            liste = liste + STR$(hpZeilen[i])
            IF hpBedingungen[i] <> "" THEN
                IF bedingungen <> "" THEN bedingungen = bedingungen + ","
                bedingungen = bedingungen + jsonText$(STR$(hpZeilen[i])) + ":" + jsonText$(hpBedingungen[i])
            END IF
        END IF
    NEXT
    PROCESS_WRITE(prozess, "{" + jsonText$("cmd") + ":" + jsonText$("set-breakpoints") + "," + jsonText$("lines") + ":[" + liste + "]," + jsonText$("conditions") + ":{" + bedingungen + "}}" + NL)
END SUB

' Ein Schritt-Kommando: nur, wenn das Kind steht.
SUB debugSchritt(cmd AS STRING)
    IF prozessArt <> "debug" OR NOT debugPause THEN
        GUI_SET_TEXT(lblStatus, "Der Debugger steht gerade nicht -- F7 startet ihn, F9 setzt einen Haltepunkt.")
        RETURN
    END IF
    debugSenden(cmd)
    debugPause = FALSE
    GUI_SET_TEXT(lblDebug, "Debugger: laeuft ...")
END SUB

SUB variablenZeigen(j AS JSON_HANDLE)
    GUI_TABLE_CLEAR(tblVars)
    DIM bereich AS STRING
    FOR EACH bereich IN ("locals", "globals")
        IF NOT JSON_HAS(j, bereich) THEN CONTINUE
        DIM n AS INTEGER : n = JSON_LEN(j, bereich)
        DIM i AS INTEGER
        FOR i = 0 TO n - 1
            DIM p AS STRING : p = bereich + "." + STR$(i)
            DIM wo AS STRING : wo = "lokal"
            IF bereich = "globals" THEN wo = "global"
            GUI_TABLE_ADD_ROW(tblVars, [JSON_GET_STRING(j, p + ".name"), JSON_GET_STRING(j, p + ".type"), JSON_GET_STRING(j, p + ".value"), wo])
        NEXT
    NEXT
END SUB

SUB debugEreignis(zeile AS STRING)
    IF LEFT$(zeile, 1) <> "{" THEN ausgabe(zeile) : RETURN
    DIM j AS JSON_HANDLE : j = JSON_PARSE(zeile)
    DIM ev AS STRING : ev = JSON_GET_STRING(j, "event")
    SELECT CASE ev
        CASE "output"
            ausgabeVerteilen(JSON_GET_STRING(j, "text"))
        CASE "paused"
            debugZeile = JSON_GET_INT(j, "line")
            IF debugErst THEN
                ' Der erste Halt ist die erste Zeile: jetzt kennt das Kind
                ' seine Haltepunkte. Gibt es welche, laeuft es bis dorthin;
                ' ohne Haltepunkte bleibt es stehen -- sonst saehe man nichts.
                debugErst = FALSE
                debugHaltepunkteSenden()
                DIM hat AS BOOLEAN : hat = FALSE
                DIM i AS INTEGER
                FOR i = 0 TO LEN(hpZeilen) - 1
                    IF hpDateien[i] = prozessDatei THEN hat = TRUE
                NEXT
                IF hat AND haltepunktIndex(prozessDatei, debugZeile) < 0 THEN debugSenden("continue") : RETURN
            END IF
            debugPause = TRUE
            variablenZeigen(j)
            GUI_SET_TEXT(lblDebug, "Debugger steht in Zeile " + STR$(debugZeile) + " (Tiefe " + STR$(JSON_GET_INT(j, "depth")) + ")")
            dateiOeffnen(prozessDatei)
            DIM ta AS GUI_WIDGET : ta = aktivesFeld()
            IF ta >= 0 THEN GUI_TEXTAREA_GOTO(ta, debugZeile, 1)
            protokoll("debug pause " + STR$(debugZeile))
        CASE "finished"
            ausgabe("-- Debugger: " + JSON_GET_STRING(j, "reason"))
            protokoll("debug beendet")
        CASE "error"
            debugZeile = JSON_GET_INT(j, "line")
            ausgabe("-- Fehler in Zeile " + STR$(debugZeile) + ": " + JSON_GET_STRING(j, "message"))
            protokoll("debug fehler " + STR$(debugZeile))
        CASE "eval-result"
            ausgabe("= " + JSON_GET_STRING(j, "value") + "   (" + JSON_GET_STRING(j, "type") + ")")
            protokoll("eval " + JSON_GET_STRING(j, "value"))
        CASE "eval-error"
            ausgabe("Fehler: " + JSON_GET_STRING(j, "message"))
    END SELECT
END SUB

' --- Profil: `dhrt profile` liefert am Ende EINE JSON-Zeile --------------
SUB profilAufnehmen()
    IF prozessStarten("profile") THEN protokoll("profil gestartet")
END SUB

SUB profilAnzeigen(zeile AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE(zeile)
    ausgabeVerteilen(JSON_GET_STRING(j, "output"))
    DIM gesamt AS FLOAT : gesamt = JSON_GET_FLOAT(j, "total_time")
    DIM n AS INTEGER : n = JSON_LEN(j, "lines")
    DIM zl[MAX(n, 1)] AS INTEGER
    DIM za[MAX(n, 1)] AS INTEGER
    DIM zt[MAX(n, 1)] AS FLOAT
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM p AS STRING : p = "lines." + STR$(i)
        zl[i] = JSON_GET_INT(j, p + ".line")
        za[i] = JSON_GET_INT(j, p + ".count")
        zt[i] = JSON_GET_FLOAT(j, p + ".time")
    NEXT
    ' Nach Zeit absteigend -- die teuerste Zeile zuerst.
    DIM k AS INTEGER
    FOR i = 0 TO n - 2
        DIM best AS INTEGER : best = i
        FOR k = i + 1 TO n - 1
            IF zt[k] > zt[best] THEN best = k
        NEXT
        IF best <> i THEN
            DIM t1 AS INTEGER : t1 = zl[i] : zl[i] = zl[best] : zl[best] = t1
            t1 = za[i] : za[i] = za[best] : za[best] = t1
            DIM t2 AS FLOAT : t2 = zt[i] : zt[i] = zt[best] : zt[best] = t2
        END IF
    NEXT
    DIM quelle AS ARRAY OF STRING : quelle = []
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 AND tabPfade[aktiverTab] = prozessDatei THEN quelle = SPLIT$(GUI_TEXT(ta), NL)
    GUI_TABLE_CLEAR(tblProfil)
    DIM pz AS ARRAY OF INTEGER : pz = []
    FOR i = 0 TO MIN(n, 300) - 1
        DIM anteil AS STRING : anteil = "-"
        IF gesamt > 0.0 THEN anteil = FORMAT$(zt[i] / gesamt * 100.0, "%.1f") + " %"
        DIM q AS STRING : q = ""
        IF zl[i] >= 1 AND zl[i] <= LEN(quelle) THEN q = TRIM$(quelle[zl[i] - 1])
        GUI_TABLE_ADD_ROW(tblProfil, [STR$(zl[i]), STR$(za[i]), FORMAT$(zt[i] * 1000.0, "%.2f"), anteil, q])
        ARRAY_PUSH(pz, zl[i])
    NEXT
    profilZeilen = pz
    GUI_SET_TEXT(lblProfil, BASENAME(prozessDatei) + ": " + FORMAT$(gesamt * 1000.0, "%.2f") + " ms gesamt, " + STR$(n) + " Zeilen gemessen")
    IF JSON_HAS(j, "error") THEN ausgabe("-- Fehler in Zeile " + STR$(JSON_GET_INT(j, "error_line")) + ": " + JSON_GET_STRING(j, "error"))
    GUI_WINDOW_VISIBLE(winProfil, TRUE)
    GUI_FOCUS(tblProfil)          ' holt das Fenster vor das Hauptfenster
    protokoll("profil " + STR$(n))
END SUB

SUB profilAnspringen()
    DIM r AS INTEGER : r = GUI_TABLE_SELECTED(tblProfil)
    IF r < 0 OR r >= LEN(profilZeilen) THEN RETURN
    dateiOeffnen(prozessDatei)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta >= 0 THEN GUI_TEXTAREA_GOTO(ta, profilZeilen[r], 1) : GUI_FOCUS(ta)
END SUB

' stdout des Kindes: beim Lauf Text, beim Debugger Ereignisse, beim Profil
' am Ende die eine JSON-Zeile -- alles zeilenweise, halbe Zeilen warten.
SUB stdoutVerteilen(text AS STRING)
    IF text = "" THEN RETURN
    IF prozessArt = "run" THEN ausgabeVerteilen(text) : RETURN
    prozessRest = prozessRest + text
    WHILE INSTR(prozessRest, NL) >= 0
        DIM p AS INTEGER : p = INSTR(prozessRest, NL)
        DIM z AS STRING : z = REPLACE$(LEFT$(prozessRest, p), CHR$(13), "")
        prozessRest = MID$(prozessRest, p + 1)
        IF prozessArt = "debug" THEN
            debugEreignis(z)
        ELSEIF LEFT$(z, 1) = "{" AND INSTR(z, CHR$(34) + "total_time" + CHR$(34)) >= 0 THEN
            ' die eine Ergebniszeile des Profilers (Schluessel sortiert, also
            ' nicht am Anfang zu erkennen)
            profilAnzeigen(z)
        ELSE
            ausgabe(z)
        END IF
    WEND
END SUB

SUB prozessNachsehen()
    IF prozess < 0 THEN RETURN
    stdoutVerteilen(PROCESS_READ$(prozess))
    DIM err AS STRING : err = PROCESS_ERR$(prozess)
    IF err <> "" THEN ausgabeVerteilen(err)
    IF NOT PROCESS_RUNNING(prozess) THEN
        stdoutVerteilen(PROCESS_READ$(prozess))
        IF prozessRest <> "" THEN stdoutVerteilen(NL)
        IF ausgabeRest <> "" THEN ausgabe(ausgabeRest) : ausgabeRest = ""
        DIM code AS INTEGER : code = PROCESS_CODE(prozess)
        PROCESS_CLOSE(prozess)
        prozess = -1
        IF prozessArt = "debug" THEN
            debugPause = FALSE : debugZeile = 0
            debugPanelZeigen(FALSE)
        END IF
        IF fertigNachStopp THEN
            GUI_SET_TEXT(lblAusgabe, "Ausgabe: gestoppt")
            protokoll("gestoppt")
        ELSE
            GUI_SET_TEXT(lblAusgabe, "Ausgabe: beendet mit Code " + STR$(code))
            protokoll("beendet " + STR$(code))
        END IF
        fertigNachStopp = FALSE
        prozessArt = ""
    END IF
END SUB

' --- Handbuch: docs/*.md im Fenster -----------------------------------
FUNCTION wortUnterMarke$() AS STRING
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN ""
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN ""
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    ' Spalte ist 1-basiert und steht HINTER dem Zeichen links der Marke.
    DIM a AS INTEGER : a = s - 1
    DIM e AS INTEGER : e = s - 1
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    WHILE e < LEN(zeile) AND istWortzeichen(MID$(zeile, e, 1)) : e = e + 1 : WEND
    RETURN MID$(zeile, a, e - a)
END FUNCTION

FUNCTION wortSpalte(ta AS GUI_WIDGET) AS INTEGER
    IF ta < 0 THEN RETURN 0
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    IF z < 1 OR z > LEN(zeilen) THEN RETURN 0
    DIM zeile AS STRING : zeile = zeilen[z - 1]
    DIM a AS INTEGER : a = s - 1
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    RETURN a + 1
END FUNCTION

FUNCTION istWortzeichen(c AS STRING) AS BOOLEAN
    IF c = "" THEN RETURN FALSE
    RETURN c = "_" OR c = "$" OR (c >= "a" AND c <= "z") OR (c >= "A" AND c <= "Z") OR (c >= "0" AND c <= "9")
END FUNCTION

SUB handbuchDokumente()
    IF LEN(docNamen) > 0 THEN RETURN
    docNamen = DIRLIST(docsOrdner, "*.md")
    GUI_SET_DROPDOWN(ddDoku, docNamen)
END SUB

' --- Handbuch gesetzt statt roh ---------------------------------------
' Markdown im Bild: Ueberschriften gross, Aufzaehlungen mit Punkt,
' Code-Bloecke in der dicktengleichen Schrift auf dunklem Grund, Tabellen
' in Spalten. Kein vollstaendiger Markdown-Setzer -- gerade genug fuer die
' Dokumente in docs/, und was er nicht kennt, zeigt er als Text.
FUNCTION mdInline$(z AS STRING) AS STRING
    ' Auszeichnungen fallen weg: fett und kursiv kann die Zeichenroutine
    ' nicht mitten im Text, und ** im Fliesstext liest sich schlechter als
    ' gar keine Auszeichnung.
    z = REPLACE$(z, "**", "")
    z = REPLACE$(z, "`", "")
    ' [Text](Ziel) -> Text: der Pfad hilft im Bild niemandem.
    DIM auf AS INTEGER : auf = INSTR(z, "](")
    WHILE auf > 0
        DIM anfang AS INTEGER : anfang = -1
        DIM i AS INTEGER
        FOR i = auf - 1 TO 0 STEP -1
            IF MID$(z, i, 1) = "[" THEN
                anfang = i
                BREAK
            END IF
        NEXT
        DIM zu AS INTEGER : zu = INSTR(MID$(z, auf, LEN(z)), ")")
        IF anfang < 0 OR zu < 0 THEN BREAK
        z = LEFT$(z, anfang) + MID$(z, anfang + 1, auf - anfang - 1) + MID$(z, auf + zu + 1, LEN(z))
        auf = INSTR(z, "](")
    WEND
    RETURN z
END FUNCTION

' Eine Zeile auf `breite` umbrechen -- als Feld der Teilzeilen.
FUNCTION mdUmbruch(z AS STRING, breite AS INTEGER) AS ARRAY OF STRING
    DIM raus AS ARRAY OF STRING : raus = []
    IF z = "" THEN
        ARRAY_PUSH(raus, "")
        RETURN raus
    END IF
    DIM zeile AS STRING : zeile = ""
    DIM wort AS STRING
    FOR EACH wort IN SPLIT$(z, " ")
        DIM neu AS STRING : neu = IIF(zeile = "", wort, zeile + " " + wort)
        IF TEXT_WIDTH(neu) > breite AND zeile <> "" THEN
            ARRAY_PUSH(raus, zeile)
            zeile = wort
        ELSE
            zeile = neu
        END IF
    NEXT
    ARRAY_PUSH(raus, zeile)
    RETURN raus
END FUNCTION

SUB handbuchSetzen()
    IF NOT hbGesetzt OR NOT GUI_WINDOW_SHOWN(winHandbuch) THEN RETURN
    DIM cx AS INTEGER : cx = GUI_CANVAS_X(cvHandbuch)
    DIM cy AS INTEGER : cy = GUI_CANVAS_Y(cvHandbuch)
    DIM cw AS INTEGER : cw = GUI_CANVAS_W(cvHandbuch)
    DIM ch AS INTEGER : ch = GUI_CANVAS_H(cvHandbuch)
    BOX(cx, cy, cx + cw, cy + ch, IIF(hell, &HF4F6F8, &H121A22))
    SCISSOR(cx, cy, cw, ch)
    DIM grund AS INTEGER : grund = IIF(hell, &H203040, &HD8E4F0)
    DIM leise AS INTEGER : leise = IIF(hell, &H607080, &H90A0B0)
    DIM x0 AS INTEGER : x0 = cx + 16
    DIM breite AS INTEGER : breite = cw - 40
    DIM y AS INTEGER : y = cy + 12 - hbScroll
    DIM imCode AS BOOLEAN : imCode = FALSE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hbZeilen) - 1
        DIM roh AS STRING : roh = hbZeilen[i]
        DIM z AS STRING : z = RTRIM$(roh)
        IF LEFT$(TRIM$(z), 3) = "```" THEN
            imCode = NOT imCode
            y = y + 6
            CONTINUE
        END IF
        ' Alles ausserhalb des Fensters ueberspringen -- ein Dokument mit
        ' 2000 Zeilen darf nicht 2000 Textaufrufe je Bild kosten.
        IF y > cy + ch THEN BREAK
        IF imCode THEN
            IF y + 20 >= cy THEN
                BOX(x0 - 8, y - 2, cx + cw - 16, y + 19, IIF(hell, &HE8ECF0, &H1A2430))
                IF codeFont >= 0 THEN SETFONT(codeFont)
                TEXT_SIZE(15)
                TEXT(x0, y, z, &H8BD0E8)
                IF uiFont >= 0 THEN SETFONT(uiFont)
            END IF
            y = y + 21
            CONTINUE
        END IF
        DIM t AS STRING : t = TRIM$(z)
        IF t = "" THEN
            y = y + 10
            CONTINUE
        END IF
        IF LEFT$(t, 4) = "### " THEN
            TEXT_SIZE(19) : IF y + 26 >= cy THEN TEXT(x0, y + 8, mdInline$(MID$(t, 4, LEN(t))), grund)
            y = y + 36 : TEXT_SIZE(16)
        ELSEIF LEFT$(t, 3) = "## " THEN
            TEXT_SIZE(23)
            IF y + 34 >= cy THEN
                TEXT(x0, y + 12, mdInline$(MID$(t, 3, LEN(t))), &H2BC4E8)
                LINE(x0, y + 40, cx + cw - 16, y + 40, IIF(hell, &HD0D8E0, &H2A3644))
            END IF
            y = y + 50 : TEXT_SIZE(16)
        ELSEIF LEFT$(t, 2) = "# " THEN
            TEXT_SIZE(28) : IF y + 40 >= cy THEN TEXT(x0, y + 12, mdInline$(MID$(t, 2, LEN(t))), &H2BC4E8)
            y = y + 56 : TEXT_SIZE(16)
        ELSEIF LEFT$(t, 3) = "---" AND TRIM$(REPLACE$(t, "-", "")) = "" THEN
            IF y >= cy THEN LINE(x0, y + 8, cx + cw - 16, y + 8, leise)
            y = y + 18
        ELSEIF LEFT$(t, 1) = "|" THEN
            ' Tabelle: die Trennzeile weglassen, den Rest dicktengleich --
            ' Spalten auszurechnen waere ein zweiter Durchlauf durch das
            ' ganze Dokument, und die Zellen sind ohnehin lang.
            IF TRIM$(REPLACE$(REPLACE$(REPLACE$(t, "|", ""), "-", ""), ":", "")) = "" THEN
                y = y + 4
                CONTINUE
            END IF
            ' Eine Zeile je Zelle waere zu breit -- die Tabellen in docs/
            ' sind fuer eine Textdatei gesetzt, nicht fuer 900 Punkte. Also
            ' wie eine Begriffsliste: die erste Zelle als Stichwort, der
            ' Rest darunter umgebrochen.
            DIM innen AS STRING : innen = TRIM$(t)
            IF LEFT$(innen, 1) = "|" THEN innen = MID$(innen, 1, LEN(innen))
            IF RIGHT$(innen, 1) = "|" THEN innen = LEFT$(innen, LEN(innen) - 1)
            DIM zellen AS ARRAY OF STRING : zellen = SPLIT$(innen, "|")
            IF LEN(zellen) > 0 AND TRIM$(zellen[0]) <> "" THEN
                IF y + 20 >= cy THEN
                    IF codeFont >= 0 THEN SETFONT(codeFont)
                    TEXT_SIZE(14)
                    TEXT(x0, y, mdInline$(TRIM$(zellen[0])), &H8BD0E8)
                    IF uiFont >= 0 THEN SETFONT(uiFont)
                    TEXT_SIZE(16)
                END IF
                y = y + 20
            END IF
            DIM rest AS ARRAY OF STRING : rest = []
            DIM zi AS INTEGER
            FOR zi = 1 TO LEN(zellen) - 1
                IF TRIM$(zellen[zi]) <> "" THEN ARRAY_PUSH(rest, TRIM$(zellen[zi]))
            NEXT
            IF LEN(rest) > 0 THEN
                DIM rt AS ARRAY OF STRING : rt = mdUmbruch(mdInline$(JOIN$(rest, "  --  ")), breite - 24)
                DIM rk AS INTEGER
                FOR rk = 0 TO LEN(rt) - 1
                    IF y + 20 >= cy AND y <= cy + ch THEN TEXT(x0 + 24, y, rt[rk], grund)
                    y = y + 21
                NEXT
            END IF
            y = y + 4
        ELSE
            DIM einzug AS INTEGER : einzug = 0
            DIM punkt AS BOOLEAN : punkt = FALSE
            IF LEFT$(t, 2) = "- " OR LEFT$(t, 2) = "* " THEN
                einzug = 18 : punkt = TRUE
                t = MID$(t, 2, LEN(t))
            ELSEIF LEFT$(t, 2) = "> " THEN
                einzug = 14
                t = MID$(t, 2, LEN(t))
            END IF
            DIM teile AS ARRAY OF STRING : teile = mdUmbruch(mdInline$(TRIM$(t)), breite - einzug)
            DIM k AS INTEGER
            FOR k = 0 TO LEN(teile) - 1
                IF y + 20 >= cy AND y <= cy + ch THEN
                    IF k = 0 AND punkt THEN CIRCLE(x0 + 6, y + 9, 3, leise)
                    TEXT(x0 + einzug, y, teile[k], grund)
                END IF
                y = y + 21
            NEXT
        END IF
    NEXT
    SCISSOR_END()
    ' Rollen mit dem Rad, solange die Maus ueber der Flaeche steht.
    IF MOUSEX() >= cx AND MOUSEX() < cx + cw AND MOUSEY() >= cy AND MOUSEY() < cy + ch THEN
        IF MOUSEWHEEL() <> 0 THEN hbScroll = MAX(0, hbScroll - MOUSEWHEEL() * 60)
    END IF
END SUB

SUB handbuchAnsicht(gesetzt AS BOOLEAN)
    hbGesetzt = gesetzt
    GUI_SET_VISIBLE(cvHandbuch, gesetzt)
    GUI_SET_VISIBLE(taHandbuch, NOT gesetzt)
    GUI_SET_TEXT(btnHbAnsicht, IIF(gesetzt, "Quelltext", "Gesetzt"))
    protokoll("hbansicht " + IIF(gesetzt, "gesetzt", "quelltext"))
END SUB

SUB handbuchZeigen(datei AS STRING, zeile AS INTEGER)
    handbuchDokumente()
    DIM i AS INTEGER
    DIM k AS INTEGER : k = -1
    FOR i = 0 TO LEN(docNamen) - 1
        IF docNamen[i] = datei THEN k = i
    NEXT
    IF k < 0 THEN GUI_SET_TEXT(lblStatus, "Kein Handbuch gefunden in " + docsOrdner) : RETURN
    GUI_SET_TEXT(taHandbuch, dateiLesen(PATHJOIN(docsOrdner, datei)))
    GUI_DROPDOWN_SET_SELECTED(ddDoku, k)
    docLetzteWahl = k
    GUI_SET_TEXT(lblHbStand, datei)
    GUI_WINDOW_VISIBLE(winHandbuch, TRUE)
    GUI_TEXTAREA_GOTO(taHandbuch, MAX(zeile, 1), 1)
    hbZeilen = SPLIT$(GUI_TEXT(taHandbuch), NL)
    ' Die gesetzte Ansicht kennt keine Zeilennummern -- 21 Punkte je Zeile
    ' ist die Naeherung, die eine Fundstelle ins Bild bringt.
    hbScroll = MAX(0, (MAX(zeile, 1) - 3) * 21)
    handbuchAnsicht(hbGesetzt)
    GUI_FOCUS(taHandbuch)            ' holt das Fenster nach vorn
    protokoll("handbuch " + datei + " " + STR$(zeile))
END SUB

' F1: das Wort unter der Marke in allen Dokumenten suchen; das Dokument mit
' den meisten Fundstellen in Codeschrift (`WORT) gewinnt, sonst Klartext.
SUB handbuch()
    handbuchDokumente()
    IF LEN(docNamen) = 0 THEN GUI_SET_TEXT(lblStatus, "Kein Handbuch gefunden in " + docsOrdner) : RETURN
    DIM wort AS STRING : wort = wortUnterMarke$()
    IF wort = "" THEN handbuchZeigen("README.md", 1) : RETURN
    DIM klein AS STRING : klein = LOWER$(wort)
    DIM besteDatei AS STRING : besteDatei = ""
    DIM besteZeile AS INTEGER : besteZeile = 1
    DIM besteZahl AS INTEGER : besteZahl = 0
    DIM d AS STRING
    FOR EACH d IN docNamen
        DIM zeilen AS ARRAY OF STRING : zeilen = READLINES(PATHJOIN(docsOrdner, d))
        DIM zahl AS INTEGER : zahl = 0
        DIM erste AS INTEGER : erste = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(zeilen) - 1
            DIM lz AS STRING : lz = LOWER$(zeilen[i])
            IF LEFT$(lz, LEN(klein) + 3) = "| `" + klein THEN
                ' die Tabellenzeile, die den Befehl BESCHREIBT -- das Referenzdokument
                zahl = zahl + 10
                IF erste = 0 THEN erste = i + 1
            ELSEIF INSTR(lz, "`" + klein) >= 0 THEN
                zahl = zahl + 2
                IF erste = 0 THEN erste = i + 1
            ELSEIF INSTR(lz, klein) >= 0 THEN
                zahl = zahl + 1
                IF erste = 0 THEN erste = i + 1
            END IF
        NEXT
        IF zahl > besteZahl THEN besteZahl = zahl : besteDatei = d : besteZeile = erste
    NEXT
    IF besteDatei = "" THEN
        GUI_SET_TEXT(lblStatus, "'" + wort + "' steht in keinem Dokument.")
        handbuchZeigen("README.md", 1)
        RETURN
    END IF
    GUI_SET_TEXT(tfHbSuche, wort)
    handbuchZeigen(besteDatei, besteZeile)
END SUB

SUB handbuchSuchen()
    DIM gesucht AS STRING : gesucht = GUI_TEXT(tfHbSuche)
    IF gesucht = "" THEN RETURN
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(taHandbuch)
    DIM tz AS INTEGER
    DIM ts AS INTEGER
    (tz, ts) = GUI_TEXTAREA_FIND(taHandbuch, gesucht, z, s + 1)
    IF tz < 0 THEN (tz, ts) = GUI_TEXTAREA_FIND(taHandbuch, gesucht, 1, 1)
    IF tz < 0 THEN GUI_SET_TEXT(lblHbStand, "'" + gesucht + "' nicht in diesem Dokument") : RETURN
    GUI_TEXTAREA_GOTO(taHandbuch, tz, ts)
    GUI_TEXTAREA_SELECT(taHandbuch, tz, ts, tz, ts + LEN(gesucht))
    hbScroll = MAX(0, (tz - 3) * 21)
    GUI_SET_TEXT(lblHbStand, docNamen[docLetzteWahl] + " -- Zeile " + STR$(tz))
END SUB

' --- Listing drucken / als PDF (pdf-Modul) -----------------------------
FUNCTION listingPdf() AS PDF
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    DIM name AS STRING : name = "Unbenannt"
    IF tabPfade[aktiverTab] <> "" THEN name = BASENAME(tabPfade[aktiverTab])
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(GUI_TEXT(ta), NL)
    DIM p AS PDF : p = PDF_NEW()
    PDF_TITLE(p, name)
    CONST BREITE = 92                   ' Zeichen je Zeile in Courier 9 pt auf A4
    CONST JE_SEITE = 66
    DIM reihe AS INTEGER : reihe = JE_SEITE
    DIM seite AS INTEGER : seite = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM rest AS STRING : rest = REPLACE$(zeilen[i], CHR$(9), "    ")
        DIM nummer AS STRING : nummer = RIGHT$("     " + STR$(i + 1), 5)
        DIM ersteHaelfte AS BOOLEAN : ersteHaelfte = TRUE
        REPEAT
            IF reihe >= JE_SEITE THEN
                ' PDF_NEW bringt die erste Seite schon mit -- ein PDF_PAGE davor
                ' liesse ein leeres Blatt vorn (so war es zuerst).
                IF seite > 0 THEN PDF_PAGE(p)
                seite = seite + 1
                PDF_FONT(p, "helvetica", 9)
                PDF_TEXT(p, 20, 12, name + "   Seite " + STR$(seite))
                PDF_LINE(p, 20, 15, 190, 15)
                PDF_FONT(p, "courier", 9)
                reihe = 0
            END IF
            DIM stueck AS STRING : stueck = LEFT$(rest, BREITE)
            rest = MID$(rest, LEN(stueck))
            DIM vorspann AS STRING : vorspann = nummer + "  "
            IF NOT ersteHaelfte THEN vorspann = "       "
            TRY
                PDF_TEXT(p, 20, 22 + reihe * 3.9, vorspann + stueck)
            CATCH e
                ' Ein Zeichen ausserhalb von cp1252 -- die Zeile kommt gekennzeichnet.
                PDF_TEXT(p, 20, 22 + reihe * 3.9, vorspann + "[Zeile mit Zeichen ausserhalb von cp1252]")
            END TRY
            reihe = reihe + 1
            ersteHaelfte = FALSE
        UNTIL rest = ""
    NEXT
    RETURN p
END FUNCTION

SUB listingAlsPdf()
    IF aktiverTab < 0 THEN RETURN
    DIM pfad AS STRING : pfad = tabPfade[aktiverTab]
    IF pfad = "" THEN GUI_SET_TEXT(lblStatus, "Erst sichern -- die PDF kommt neben die Quelle.") : RETURN
    DIM ziel AS STRING : ziel = pfad
    IF LOWER$(RIGHT$(ziel, 3)) = ".dh" THEN ziel = LEFT$(ziel, LEN(ziel) - 3)
    ziel = ziel + ".pdf"
    DIM p AS PDF : p = listingPdf()
    PDF_SAVE(p, ziel)
    GUI_SET_TEXT(lblStatus, "PDF geschrieben: " + ziel + " (" + STR$(PDF_PAGE_COUNT(p)) + " Seiten)")
    PDF_CLOSE(p)
    protokoll("pdf " + ziel)
END SUB

' Strg+P oeffnet den Druckdialog: Drucker (Standard vorgewaehlt), Kopien,
' oder doch als PDF. Ohne Drucker gibt es gleich den PDF-Weg.
SUB listingDrucken()
    IF aktiverTab < 0 THEN RETURN
    druckerNamen = PRINTERS()
    IF LEN(druckerNamen) = 0 THEN GUI_SET_TEXT(lblStatus, "Kein Drucker eingerichtet -- nimm 'Listing als PDF'.") : RETURN
    GUI_SET_DROPDOWN(ddDrucker, druckerNamen)
    DIM k AS INTEGER : k = ARRAY_INDEXOF(druckerNamen, PRINTER_DEFAULT$())
    GUI_DROPDOWN_SET_SELECTED(ddDrucker, MAX(k, 0))
    GUI_WINDOW_SET_BOUNDS(winDruck, (SCREENWIDTH() - 400) \ 2, (SCREENHEIGHT() - 170) \ 2, 400, 170)
    GUI_WINDOW_VISIBLE(winDruck, TRUE)
    GUI_FOCUS(btnDruckOk)              ' holt das Fenster nach vorn
END SUB

SUB druckenAusfuehren()
    GUI_WINDOW_VISIBLE(winDruck, FALSE)
    IF aktiverTab < 0 THEN RETURN
    DIM sel AS INTEGER : sel = GUI_DROPDOWN_SELECTED(ddDrucker)
    IF sel < 0 OR sel >= LEN(druckerNamen) THEN RETURN
    DIM drucker AS STRING : drucker = druckerNamen[sel]
    DIM kopien AS INTEGER : kopien = MAX(1, INT(GUI_VALUE(spKopien)))
    DIM p AS PDF : p = listingPdf()
    TRY
        PDF_PRINT(p, drucker, kopien)
        GUI_SET_TEXT(lblStatus, "Gedruckt auf " + drucker + " (" + STR$(PDF_PAGE_COUNT(p)) + " Seiten, " + STR$(kopien) + "x)")
        protokoll("gedruckt " + drucker + " " + STR$(kopien))
    CATCH e
        GUI_SET_TEXT(lblStatus, "Drucken: " + e)
    END TRY
    PDF_CLOSE(p)
    GUI_FOCUS(aktivesFeld())
END SUB

' Strg+F1: alle Befehle mit Kuerzel im Handbuch-Fenster.
SUB kuerzelZeigen()
    DIM text AS STRING : text = "TASTENKUERZEL DER IDE" + NL + NL
    DIM i AS INTEGER
    FOR i = 0 TO LEN(befehlNamen) - 1
        IF befehlKuerzel[i] <> "" THEN text = text + LEFT$(befehlKuerzel[i] + "                    ", 20) + befehlNamen[i] + NL
    NEXT
    text = text + NL + "Im Code-Feld: Tab rueckt bis zur naechsten Spalte ein, Strg+Z/Y nimmt zurueck und wiederholt, Strg+A/C/V/X wie ueblich, Pos1/Ende, Bild auf/ab." + NL
    text = text + "Alle Befehle ohne Kuerzel stehen in der Befehlspalette (Strg+Umschalt+P)." + NL
    GUI_SET_TEXT(taHandbuch, text)
    GUI_SET_TEXT(lblHbStand, "Tastenkuerzel")
    GUI_WINDOW_VISIBLE(winHandbuch, TRUE)
    GUI_TEXTAREA_GOTO(taHandbuch, 1, 1)
    GUI_FOCUS(taHandbuch)
    protokoll("kuerzel " + STR$(LEN(befehlNamen)))
END SUB

' --- Werkzeuge: die Begleit-Editoren in Drachenhauch --------------------
SUB werkzeugStarten(datei AS STRING)
    DIM pfad AS STRING : pfad = PATHJOIN(beispielOrdner, datei)
    IF NOT FILEEXISTS(pfad) THEN
        GUI_SET_TEXT(lblStatus, "Nicht gefunden: " + pfad)
        protokoll("werkzeug fehlt " + datei)
        RETURN
    END IF
    ARRAY_PUSH(werkzeuge, PROCESS_START("dhrt", "run", pfad))
    GUI_SET_TEXT(lblStatus, "Gestartet: " + datei)
    protokoll("werkzeug " + datei)
END SUB

SUB werkzeugeAufraeumen()
    DIM i AS INTEGER : i = 0
    WHILE i < LEN(werkzeuge)
        IF PROCESS_RUNNING(werkzeuge[i]) THEN
            i = i + 1
        ELSE
            PROCESS_CLOSE(werkzeuge[i])
            ARRAY_REMOVE_AT(werkzeuge, i)
        END IF
    WEND
END SUB

SUB beispieleOeffnen()
    IF NOT FILEEXISTS(PATHJOIN(beispielOrdner, "01_hello.dh")) THEN
        GUI_SET_TEXT(lblStatus, "Keine Beispiele in " + beispielOrdner)
        RETURN
    END IF
    projektOrdner = beispielOrdner
    baumFuellen()
    GUI_SET_TEXT(lblStatus, "Projekt: " + beispielOrdner)
    protokoll("projekt " + projektOrdner)
END SUB

' --- Befehlspalette und Datei-Waehler ------------------------------------
' EINE Liste aller Befehle mit Kuerzel: Palette, Tastenkuerzel-Uebersicht.
SUB paletteEintrag(name AS STRING, kennung AS STRING, kuerzel AS STRING)
    ARRAY_PUSH(befehlNamen, name)
    ARRAY_PUSH(befehlKennungen, kennung)
    ARRAY_PUSH(befehlKuerzel, kuerzel)
END SUB

