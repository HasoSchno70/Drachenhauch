=== ziehen von liste zu liste (2)
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM a AS GUI_WIDGET : a = GUI_LISTBOX(w, 20, 20, 160, 110, ["Apfel", "Birne", "Kirsche"])
DIM b AS GUI_WIDGET : b = GUI_LISTBOX(w, 240, 20, 160, 110, ["Dattel"])
GUI_DRAGGABLE(a, TRUE) : GUI_DROP_TARGET(a, TRUE) : GUI_DROP_TARGET(b, TRUE)
DIM f AS INTEGER
FOR f = 1 TO 16
    GUI_UPDATE()
    IF GUI_DROPPED(b) THEN PRINT "B " + GUI_DROP_TEXT() + " " + STR$(GUI_DRAG_INDEX()) + " " + STR$(GUI_DROP_INDEX()) + " " + STR$(GUI_DROP_SOURCE() = a)
    IF GUI_DROPPED(a) THEN PRINT "A " + GUI_DROP_TEXT() + " " + STR$(GUI_DRAG_INDEX()) + " " + STR$(GUI_DROP_INDEX())
    IF GUI_DRAGGING() = a THEN PRINT "Z " + GUI_DROP_TEXT()
    PRINT "L " + GUI_LISTBOX_ITEM(a, 0) + " " + GUI_LISTBOX_ITEM(a, 2)
    GUI_DRAW()
    FLIP()
NEXT
