' Stildatei (GUI_STYLESHEET, gui_stil.rs; docs/entwurf-gui-wie-gtk.md
' Paket 4): Selektoren nach Art, Klasse, Name und Zustand, Vorrang wie in
' CSS, GUI_SET_COLOR vor allem. Format: docs/werkzeuge.md.
'
' Die Bildfaelle schalten Verlauf, Glanz, Fase und Rundung ab und proben
' nahe der linken oberen Ecke eines Knopfs -- dort steht keine Schrift.

=== die stildatei faerbt nach art, klasse und name, set_color schlaegt alles
IMPORT "gui"
SCREEN(400, 300, "T", 1)
GUI_METRIC_SET("gradient", 0)
GUI_METRIC_SET("gloss", 0)
GUI_METRIC_SET("bevel", 0)
GUI_METRIC_SET("corner_radius", 0)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM b1 AS GUI_WIDGET : b1 = GUI_BUTTON(w, "eins", 10, 10, 100, 30)
DIM b2 AS GUI_WIDGET : b2 = GUI_BUTTON(w, "zwei", 10, 50, 100, 30)
DIM b3 AS GUI_WIDGET : b3 = GUI_BUTTON(w, "drei", 10, 90, 100, 30)
DIM b4 AS GUI_WIDGET : b4 = GUI_BUTTON(w, "vier", 10, 130, 100, 30)
DIM b5 AS GUI_WIDGET : b5 = GUI_BUTTON(w, "fuenf", 10, 170, 100, 30)
GUI_ADD_CLASS(b2, "gefahr")
GUI_ADD_CLASS(b3, "Gefahr")
GUI_SET_NAME(b3, "ok")
GUI_ADD_CLASS(b4, "gefahr")
GUI_SET_COLOR(b4, "bg", &HFFFFFF)
GUI_BUTTON_VARIANT(b5, "primaer")
GUI_STYLESHEET("/* Grundregel */" + CHR$(10) + "button { bg: #2050C0 }" + CHR$(10) + "button.gefahr { bg: #C0392B }" + CHR$(10) + "#ok { bg: #00A000 }" + CHR$(10) + ".primaer { bg: #808000 }")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
