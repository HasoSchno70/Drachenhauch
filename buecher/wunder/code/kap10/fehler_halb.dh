' Kapitel 10, was schiefgehen kann: ganze statt halbe Masse.
IMPORT "physics2d"
CONST STEIN = 28
DIM welt AS PHYS2D_WORLD : welt = PHYS2D_NEW()
PHYS2D_ADD_BOX(welt, 400, 490, 400, 10, FALSE, 0.2)
DIM steine AS ARRAY OF INTEGER
DIM i AS INTEGER
FOR i = 0 TO 5
    ' FALSCH: PHYS2D_ADD_BOX will die HALBE Breite und Hoehe.
    ARRAY_PUSH(steine, PHYS2D_ADD_BOX(welt, 400, 466 - i * STEIN, _
                                      STEIN, STEIN, TRUE, 0.05))
NEXT

SCREEN(800, 500, "Ganze statt halbe Masse")
WHILE NOT QUITREQUESTED() AND NOT KEY_DOWN(KEY_ESCAPE)
    PHYS2D_STEP(welt, 1.0 / 60)
    CLS(RGB(150, 190, 225))
    BOX(0, 480, 800, 500, RGB(90, 140, 70))
    FOR EACH s IN steine
        DIM x AS FLOAT : x = PHYS2D_BODY_X(welt, s)
        DIM y AS FLOAT : y = PHYS2D_BODY_Y(welt, s)
        DIM w AS FLOAT : w = DEG(PHYS2D_BODY_ANGLE(welt, s))
        BOXROT(x, y, STEIN, STEIN, w, RGB(220, 150, 80))
    NEXT
    FLIP()
WEND
