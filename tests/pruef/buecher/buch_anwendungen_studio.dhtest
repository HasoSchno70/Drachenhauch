' Eine Liste mit Book, auf Englisch eingelesen.
WRITEALL(CWD$() + "/dublin.csv", "titel;art" + CHR$(10) + "Dubliners;Book" + CHR$(10) + "Ulysses;Gedicht" + CHR$(10))
einschieben("kap22_mediathek", ["    DIM probeN AS INTEGER", _
    "    SUB Takt()", _
    "        Self.probeN = Self.probeN + 1", _
    "        IF Self.probeN = 3 THEN", _
    "            DIM e AS Einlesung : e = einlesen(" + q$(CWD$() + "/dublin.csv") + ")", _
