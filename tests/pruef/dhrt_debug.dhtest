=== eval kennt felder und indizes aber keine aufrufe
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
FUNCTION ev$(ausdruck AS STRING) AS STRING
    RETURN "{" + q + "cmd" + q + ":" + q + "eval" + q + "," + q + "expr" + q + ":" + q + REPLACE$(ausdruck, q, "\" + q) + q + "}"
END FUNCTION
sitzung("d.dh", ["{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "lines" + q + ":[9]}", _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    ev$("held.hp * 2"), ev$("f[1] + m[" + q + "a" + q + "]"), ev$("held.gibts"), ev$("zweimal(3)"), _
    "{" + q + "cmd" + q + ":" + q + "stop" + q + "}"])
DIM i AS INTEGER
FOR i = 0 TO LEN(ereignisse) - 1
    IF art$(i) = "eval-result" THEN PRINT "wert "; feld$(i, "value")
    IF art$(i) = "eval-error" THEN PRINT "fehler "; LEFT$(feld$(i, "message"), 30)
NEXT
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
CLASS Held
    DIM hp AS INTEGER
END CLASS
DIM held AS Held : held = NEW Held()
held.hp = 7
DIM f AS ARRAY OF INTEGER : f = [4, 5, 6]
DIM m AS MAP OF INTEGER : m = {"a": 9}
