' Kapitel 10 -- eine Tonleiter aus acht Zahlen.

DIM noten[8] AS INTEGER
DIM i AS INTEGER
DIM ton AS SOUND

noten[0] = 262      ' c
noten[1] = 294      ' d
noten[2] = 330      ' e
noten[3] = 349      ' f
noten[4] = 392      ' g
noten[5] = 440      ' a
noten[6] = 494      ' h
noten[7] = 523      ' c'

FOR i = 0 TO 7
    ton = AUDIO_TONE(noten[i], 250)
    PLAYSOUND(ton)
    SLEEP(300)
NEXT
