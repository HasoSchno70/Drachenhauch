projekt unterordner tabs 0
status Projekt:

=== ausserhalb von git fragt der rand git gar nicht
' Ausserhalb eines Repositorys faellt `git diff` in den Vergleich zweier
' Dateien und schrieb bei jedem Sichern seine Hilfe auf die Konsole.
gitRandNachziehen(TRUE)
protokoll("probe repo " + STR$(gitRepo(projektOrdner)) + " " + STR$(gitRepo(wurzel)))
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=60
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT "a"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 6) = "probe " OR LEFT$(L[i], 8) = "git rand" THEN PRINT L[i]
NEXT
--- erwartet
probe repo FALSE TRUE
