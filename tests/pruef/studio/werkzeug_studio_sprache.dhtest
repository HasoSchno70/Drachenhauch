--- datei proj/Hauptfenster.dh
CLASS Hauptfenster EXTENDS Hauptfenster_Basis

    SUB messen_Aktion()
        PRINT "sprache '"; Sprache$(); "'"
        PRINT "label "; GUI_TEXT(Self.lab); " knopf "; GUI_TEXT(Self.knopf)
        DIM j AS STRING : j = GUI_TO_JSON(Self.Fenster())
        DIM w AS STRING
        FOR EACH w IN ["Haupt", "Main", "Sichert alles", "Saves everything", "Name eingeben", "Enter a name", "Produkt", "Product", "Grün", "Green", "42 ✓", "Fehlt hier"]
            IF INSTR(j, CHR$(34) + w + CHR$(34)) >= 0 THEN PRINT "im fenster "; w
        NEXT
        PRINT "einmal "; trf$("{0} und {1}", ["a{1}", "b"])
        PRINT "trf "; trf$("{0} Stück", ["3"]); " eingebaut "; tr$("Abbrechen"); " kuerzel "; studioKuerzel$("Strg+Umschalt+Q")
        Liste.Pdf("liste.pdf", {})
        PRINT "fr "; SpracheWaehlen("fr"); " '"; Sprache$(); "'"
        Self.Zumachen()
    END SUB
END CLASS
--- datei proj/App.dh
CLASS App EXTENDS StudioApp
    SUB Geoeffnet()
        IF GETENV$("PROBE_SPRACHE") <> "" THEN SpracheWaehlen(GETENV$("PROBE_SPRACHE"))
    END SUB
END CLASS
--- erwartet
erzeugt TRUE
tafel kopiert TRUE
menue TRUE kuerzel TRUE diagramm TRUE
