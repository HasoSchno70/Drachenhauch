=== ein umbau, dessen datei die platte ablehnt, schreibt die uebrigen
' Stresstest 2026-10-02: der Umbau schrieb seine Dateien ohne TRY; eine,
' die die Platte ablehnt (hier ein ORDNER an ihrer Stelle), beendete die
' IDE mitten im Umbau -- die Dateien davor geschrieben, die danach nicht.
' Jetzt werden die uebrigen geschrieben, und die Statuszeile nennt die
' abgelehnte.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 30 THEN
    DELETEFILE(PATHJOIN(projektOrdner, "b.dh"))
    MKDIR(PATHJOIN(projektOrdner, "b.dh"))
    umbauLeeren()
    umbauVormerken(-1, PATHJOIN(projektOrdner, "a.dh"), "PRINT 2")
    umbauVormerken(-1, PATHJOIN(projektOrdner, "b.dh"), "PRINT 2")
    umbauVormerken(-1, PATHJOIN(projektOrdner, "c.dh"), "PRINT 2")
    umbauMeldung = "Umbau fertig."
    umbauSchreiben()
    protokoll("pr status " + GUI_STATUSBAR_TEXT$(lblStatus, 0))
END IF
IF prBild = 50 THEN
    protokoll("pr laeuft weiter")
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
PRINT 0
--- datei a.dh
PRINT 1
--- datei b.dh
PRINT 1
--- datei c.dh
PRINT 1
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
PRINT "a "; READLINES("a.dh")[0]
PRINT "c "; READLINES("c.dh")[0]
--- erwartet
pr status Umbau fertig. Nicht geschrieben: b.dh
pr laeuft weiter
a PRINT 2
c PRINT 2

