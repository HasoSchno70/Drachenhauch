' Aus test_rendertarget_persistenz.py uebertragen (5 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== ohne behalten ist der alte inhalt weg
SCREEN(64, 64, "rt", 1)
DIM rt AS INTEGER
rt = RENDERTARGET_NEW(64, 64)
DIM f AS INTEGER
FOR f = 0 TO 5
    RENDERTARGET_BEGIN(rt)

    IF f = 0 THEN PLOT(10, 10, &HFF0000)
    PLOT(40, 10, &H00FF00)
    RENDERTARGET_END()
    CLS(0)
    RENDERTARGET_DRAW(rt, 0, 0)
    FLIP()
NEXT
SAVESCREENSHOT("out.png")
--- erwartet

=== mit behalten steht der alte inhalt noch da
SCREEN(64, 64, "rt", 1)
DIM rt AS INTEGER
rt = RENDERTARGET_NEW(64, 64, TRUE)
DIM f AS INTEGER
FOR f = 0 TO 5
    RENDERTARGET_BEGIN(rt)

    IF f = 0 THEN PLOT(10, 10, &HFF0000)
    PLOT(40, 10, &H00FF00)
    RENDERTARGET_END()
    CLS(0)
    RENDERTARGET_DRAW(rt, 0, 0)
    FLIP()
NEXT
SAVESCREENSHOT("out.png")
--- erwartet

=== rendertarget clear raeumt ein behaltenes target
SCREEN(64, 64, "rt", 1)
DIM rt AS INTEGER
rt = RENDERTARGET_NEW(64, 64, TRUE)
DIM f AS INTEGER
FOR f = 0 TO 5
    RENDERTARGET_BEGIN(rt)
    IF f = 3 THEN RENDERTARGET_CLEAR(rt)
    IF f = 0 THEN PLOT(10, 10, &HFF0000)
    PLOT(40, 10, &H00FF00)
    RENDERTARGET_END()
    CLS(0)
    RENDERTARGET_DRAW(rt, 0, 0)
    FLIP()
NEXT
SAVESCREENSHOT("out.png")
--- erwartet

=== verblassen ueber multiplizieren
SCREEN(64, 64, "rt", 1)
DIM rt AS INTEGER
rt = RENDERTARGET_NEW(64, 64, TRUE)
DIM f AS INTEGER
FOR f = 0 TO 9
    RENDERTARGET_BEGIN(rt)
    BLEND_MODE("mult")
    BOX(0, 0, 64, 64, RGB(200, 200, 200))
    BLEND_MODE("alpha")
    IF f = 0 THEN PLOT(10, 10, &HFF0000)
    RENDERTARGET_END()
    CLS(0)
    RENDERTARGET_DRAW(rt, 0, 0)
    FLIP()
NEXT
SAVESCREENSHOT("out.png")
--- erwartet

=== abziehen nimmt die farbe vom hintergrund und laesst die deckkraft
' BLEND_MODE("subtract") rechnete bis 2026-11-20 Farbe minus Hintergrund
' (raylibs BLEND_SUBTRACT_COLORS) und zog die Deckkraft mit ab.
SCREEN(64, 64, "rt", 1)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(64, 64, TRUE)
RENDERTARGET_BEGIN(rt)
BOX(0, 0, 64, 64, RGB(200, 100, 20))
BLEND_MODE("subtract")
BOX(0, 0, 32, 64, RGB(50, 50, 50))
' Halb deckend zieht halb so viel ab.
BOX(32, 0, 64, 64, RGBA(100, 100, 100, 128))
BLEND_MODE("alpha")
RENDERTARGET_END()
DIM b AS INTEGER : b = RENDERTARGET_IMAGE(rt)
PRINT HEX$(IMAGE_GET_PIXEL(b, 10, 10)); " "; IMAGE_GET_ALPHA(b, 10, 10)
DIM c AS INTEGER : c = IMAGE_GET_PIXEL(b, 50, 10)
PRINT (c SHR 16) BAND 255; " "; (c SHR 8) BAND 255; " "; c BAND 255; " "; IMAGE_GET_ALPHA(b, 50, 10)
--- umgebung
DHRT_FRAMES=2
--- erwartet
963200 255
150 50 0 255

=== verblassen mit abziehen kommt bei schwarz an
' Nur multiplizieren bleibt bei einem dunklen Grau stehen (die Rundung
' haelt 15 * 247 / 255 bei 15); 1 abziehen zieht es auf null.
SCREEN(64, 64, "rt", 1)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(64, 64, TRUE)
RENDERTARGET_BEGIN(rt)
BOX(0, 0, 64, 64, RGB(255, 200, 40))
RENDERTARGET_END()
DIM i AS INTEGER
FOR i = 1 TO 400
    RENDERTARGET_BEGIN(rt)
    BLEND_MODE("mult")
    BOX(0, 0, 64, 64, RGB(247, 247, 247))
    IF i MOD 2 = 0 THEN
        BLEND_MODE("subtract")
        BOX(0, 0, 32, 64, RGB(1, 1, 1))
    END IF
    BLEND_MODE("alpha")
    RENDERTARGET_END()
NEXT
DIM b AS INTEGER : b = RENDERTARGET_IMAGE(rt)
PRINT "mit abziehen "; HEX$(IMAGE_GET_PIXEL(b, 10, 10)); " "; IMAGE_GET_ALPHA(b, 10, 10)
PRINT "nur mult "; HEX$(IMAGE_GET_PIXEL(b, 50, 10))
--- umgebung
DHRT_FRAMES=2
--- erwartet
mit abziehen 0 255
nur mult F0F0F

=== inhalt wird nicht vom fenster massstab verzerrt
SCREEN(64, 64, "rt", 2)
DIM rt AS INTEGER
rt = RENDERTARGET_NEW(64, 64)
DIM f AS INTEGER
FOR f = 0 TO 3
    RENDERTARGET_BEGIN(rt)
    PLOT(50, 50, &HFF0000)
    RENDERTARGET_END()
    CLS(0)
    RENDERTARGET_DRAW(rt, 0, 0)
    FLIP()
NEXT
SAVESCREENSHOT("out.png")
--- erwartet


=== flip mit offenem render-ziel nennt die zeile
' RENDERTARGET_BEGIN ohne END: alles danach -- auch das RENDERTARGET_DRAW,
' das das Ziel zeigen sollte -- ging ins Ziel, der Schirm blieb schwarz,
' ohne Meldung (gefunden 2026-11-19 am Buch "Kleine Wunder"). Jetzt haelt
' FLIP an und sagt, was fehlt.
SCREEN(64, 64, "rt", 1)
DIM rt AS INTEGER
rt = RENDERTARGET_NEW(64, 64)
RENDERTARGET_BEGIN(rt)
PLOT(10, 10, &HFF0000)
RENDERTARGET_DRAW(rt, 0, 0)
FLIP()
--- fehler
fall.dh:11: FLIP: ein Render-Ziel ist noch offen -- nach RENDERTARGET_BEGIN fehlt RENDERTARGET_END()
