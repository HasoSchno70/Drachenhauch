' Star Pilot - Kap 9: Player und Bullet als Klassen.
'
' Was sich gegenueber Kap 8 geaendert hat:
'   - Statt drei parallel-Arrays (bullets_x, bullets_y, bullets_alive)
'     gibt es jetzt EIN Array DIM bullets[POOL_SIZE] AS Bullet.
'   - Statt freier Funktionen (UpdatePlayer, DrawBullets) leben Update
'     und Draw jetzt als Methoden in den Klassen.
'   - Der Player ist nicht mehr eine Sammlung globaler Variablen,
'     sondern eine Player-Instanz.
'
' Die Hauptschleife wird dadurch wieder ein bisschen dichter, aber jede
' Klasse weiss selbst, wie sie sich bewegt und zeichnet.

CONST WIDTH        AS INTEGER = 320
CONST HEIGHT       AS INTEGER = 240
CONST BG_COLOR     AS INTEGER = &H141E3C
CONST PLAYER_C     AS INTEGER = &HFFDC00
CONST BULLET_C     AS INTEGER = &HFFFFFF
CONST PLAYER_SPEED AS INTEGER = 3
CONST BULLET_SPEED AS INTEGER = 5
CONST POOL_SIZE    AS INTEGER = 20

' --- Helfer-Funktion ---
FUNCTION Clamp(wert AS INTEGER, lo AS INTEGER, hi AS INTEGER) AS INTEGER
    IF wert < lo THEN RETURN lo
    IF wert > hi THEN RETURN hi
    RETURN wert
END FUNCTION

' --- Player-Klasse ---
CLASS Player
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM w AS INTEGER
    DIM h AS INTEGER

    SUB Init(start_x AS INTEGER, start_y AS INTEGER)
        x = start_x
        y = start_y
        w = 40
        h = 24
    END SUB

    SUB Update()
        IF KEYPRESSED(KEY_LEFT) THEN
            x = x - PLAYER_SPEED
        END IF
        IF KEYPRESSED(KEY_RIGHT) THEN
            x = x + PLAYER_SPEED
        END IF
        x = Clamp(x, 0, WIDTH - w)
    END SUB

    SUB Draw()
        BOX(x, y, x + w, y + h, PLAYER_C)
    END SUB
END CLASS

' --- Bullet-Klasse ---
CLASS Bullet
    DIM x      AS INTEGER
    DIM y      AS INTEGER
    DIM w      AS INTEGER
    DIM h      AS INTEGER
    DIM alive  AS BOOLEAN

    SUB Init()
        ' Der frisch erzeugte Bullet ist tot - er wartet auf Spawn.
        w = 3
        h = 8
        alive = FALSE
    END SUB

    SUB Spawn(at_x AS INTEGER, at_y AS INTEGER)
        x = at_x
        y = at_y
        alive = TRUE
    END SUB

    SUB Update()
        IF NOT alive THEN RETURN
        y = y - BULLET_SPEED
        IF y < -h THEN
            alive = FALSE
        END IF
    END SUB

    SUB Draw()
        IF alive THEN
            BOX(x, y, x + w, y + h, BULLET_C)
        END IF
    END SUB
END CLASS

' --- Globale Spielobjekte ---
DIM player AS Player
DIM bullets[POOL_SIZE] AS Bullet
DIM space_was_pressed AS BOOLEAN

' --- Setup ---
SUB Setup()
    player = NEW Player(WIDTH / 2 - 20, HEIGHT - 24 - 16)

    DIM i AS INTEGER
    FOR i = 0 TO POOL_SIZE - 1
        bullets[i] = NEW Bullet()
    NEXT i

    space_was_pressed = FALSE
    SCREEN(WIDTH, HEIGHT, "Star Pilot", 2)
END SUB

' --- Schiessen: ersten toten Bullet finden, Spawn aufrufen ---
SUB SpawnBullet(at_x AS INTEGER, at_y AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO POOL_SIZE - 1
        IF NOT bullets[i].alive THEN
            bullets[i].Spawn(at_x, at_y)
            RETURN
        END IF
    NEXT i
END SUB

' --- Pro Frame: alles aktualisieren ---
SUB UpdateAll()
    player.Update()

    DIM space_now AS BOOLEAN
    space_now = KEYPRESSED(KEY_SPACE)
    IF space_now AND NOT space_was_pressed THEN
        SpawnBullet(player.x + player.w / 2 - 1, player.y - 8)
    END IF
    space_was_pressed = space_now

    DIM i AS INTEGER
    FOR i = 0 TO POOL_SIZE - 1
        bullets[i].Update()
    NEXT i
END SUB

' --- Pro Frame: alles zeichnen ---
SUB DrawAll()
    player.Draw()
    DIM i AS INTEGER
    FOR i = 0 TO POOL_SIZE - 1
        bullets[i].Draw()
    NEXT i
END SUB

' --- Hauptprogramm ---
Setup()

WHILE NOT QUITREQUESTED()
    UpdateAll()

    CLS(BG_COLOR)
    DrawAll()
    FLIP()
    SLEEP(16)
WEND
