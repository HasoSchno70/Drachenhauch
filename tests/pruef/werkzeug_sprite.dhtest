END FUNCTION
SUB prAbspielen()
    ' Ein Ereignis in Bild 0 -- die Wiedergabe setzt beim ERSTEN an.
    prE(0, 7, 0, 0)
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM weiter AS BOOLEAN
    DIM tf AS INTEGER
    DIM tz AS STRING
    FOR i = 1 TO LEN(prF) - 1
