=== ein gespeichertes png liest ein fremder leser
' (Bis Stufe 46 in test_image_io.py.)
IMPORT "imgfx"
SCREEN(160, 80, "t", 1)
DIM b AS IMAGE : b = IMAGE_NEW(6, 4, &H0000FF)
IMAGE_DRAW_RECT(b, 1, 1, 2, 2, &H00FF00)
IMAGE_SAVE(b, "raus.png")
DIM kb AS BUFFER : kb = READALL_BYTES("raus.png")
PRINT "png "; BUFFER_GET(kb, 1) = 80 AND BUFFER_GET(kb, 2) = 78 AND BUFFER_GET(kb, 3) = 71
DIM g AS IMAGE : g = LOADIMAGE("raus.png")
PRINT IMAGEWIDTH(g); " "; IMAGEHEIGHT(g)
PRINT GETPIXEL(g, 2, 2) = &H00FF00; " "; GETALPHA(g, 2, 2)
PRINT GETPIXEL(g, 5, 3) = &H0000FF; " "; GETALPHA(g, 5, 3)
--- umgebung
DHRT_FRAMES=2
--- erwartet
png TRUE
6 4
TRUE 255
TRUE 255

