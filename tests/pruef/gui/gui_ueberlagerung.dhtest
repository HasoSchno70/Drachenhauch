=== vorschlaege unter dem textfeld, mit pfeilen und enter genommen
' Was so anfaengt, steht vorn; Enter nimmt den markierten und loest den
' Standard-Knopf NICHT aus (das zweite Enter tut es).
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM ok AS GUI_WIDGET
ok = GUI_BUTTON(w, "OK", 400, 300, 120, 30)
GUI_WINDOW_DEFAULT(w, ok)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 20, 200, 28)
GUI_TEXTINPUT_COMPLETION(tf, ["Banane", "Papaya", "Apfel", "Aprikose"])
GUI_FOCUS(tf)
CLIPBOARD_SET("ap")
AUTOMATION_PLAY("ev.txt")
DIM oks AS INTEGER : oks = 0
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF GUI_CLICKED(ok) THEN oks = oks + 1
    IF GUI_COMPLETION_CHOSEN(tf) >= 0 THEN PRINT "gewaehlt " + STR$(GUI_COMPLETION_CHOSEN(tf)) + " text " + GUI_TEXT(tf) + " ok " + STR$(oks)
    IF n = 15 THEN PRINT "offen " + STR$(GUI_COMPLETION_OPEN(tf))
    IF n = 50 THEN PRINT "zu " + STR$(NOT GUI_COMPLETION_OPEN(tf)) + " ok " + STR$(oks)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
