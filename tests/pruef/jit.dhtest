=== spielschleife mit not und vorbelegten namen
DIM runde AS INTEGER
DIM s AS FLOAT
DIM n AS INTEGER
DIM log AS STRING
FUNCTION fertig(r AS INTEGER) AS BOOLEAN
    RETURN r >= 5
END FUNCTION
DIM m AS MAP OF INTEGER
MAPPUT(m, "x", 1)
WHILE NOT fertig(runde) AND NOT MAPHAS(m, STR$(runde))
    n = n + RED + KEY_ESCAPE + KEY_SPACE - WHITE + BLUE
    s = s + PI * runde + TAU
    log = log + STR$(runde)
    runde = runde + 1
WEND
PRINT n; " "; s; " "; log
--- umgebung
DHRT_JIT=aus
--- erwartet
-326105 62.83185307179586 01234

