=== der leer-hinweis steht da, wenn keine zeile zu sehen ist
' Gezaehlt werden Punkte, die nicht die Tabellenflaeche sind, im Band, in
' dem der Hinweis steht -- einmal mit, einmal ohne Hinweis.
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM mit AS GUI_WIDGET : mit = GUI_TABLE(w, 10, 10, 280, 90)
GUI_TABLE_HEADERS(mit, ["Name"])
GUI_TABLE_PLACEHOLDER(mit, "Keine Treffer")
DIM ohne AS GUI_WIDGET : ohne = GUI_TABLE(w, 10, 110, 280, 90)
GUI_TABLE_HEADERS(ohne, ["Name"])
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
    IF bild = 3 THEN SAVESCREENSHOT("t.png")
WEND
DIM b AS IMAGE : b = LOADIMAGE("t.png")
FUNCTION punkte(y0 AS INTEGER) AS INTEGER
    DIM n AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = y0 TO y0 + 20
        FOR x = 20 TO 280
            IF GETPIXEL(b, x, y) <> GETPIXEL(b, 150, y0 + 40) THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
PRINT "mit "; punkte(38) > 20; " ohne "; punkte(138) > 20
--- umgebung
DHRT_FRAMES=5
--- erwartet
mit TRUE ohne FALSE

=== der leer-hinweis steht in der dhform
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 10, 10, 280, 200)
GUI_TABLE_PLACEHOLDER(tb, "Keine Treffer")
DIM j AS STRING : j = GUI_TO_JSON(w)
GUI_WINDOW_DESTROY(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT INSTR(GUI_TO_JSON(w2), "Keine Treffer") >= 0
--- erwartet
TRUE

=== das mausrad rollt die tabelle weich
' Zeile 5 ist gruen und liegt bei y 132..151. Drei Radschritte rollen um 60:
' dann steht sie bei y 72..91. Zwei Bilder nach dem Rad ist sie unterwegs.
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 10, 10, 280, 200)
GUI_TABLE_HEADERS(tb, ["Name"])
DIM k AS INTEGER
FOR k = 0 TO 39
    GUI_TABLE_ADD_ROW(tb, ["Zeile " + STR$(k)])
NEXT
GUI_TABLE_CELL_COLOR(tb, 5, 0, -1, &H00FF00)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 3
e 0 7 5 215 0 0
e 1 7 150 100 0 0
e 2 8 0 -3 0 0

--- umgebung
DHRT_FRAMES=5
--- bild
200 81 nicht #00FF00 +-60

