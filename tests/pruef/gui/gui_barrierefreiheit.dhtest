=== alt mit einer taste oeffnet das menue nicht
' Alt+Rechts ist ein Kuerzel, kein "Alt allein" -- das Menue darf danach nicht
' aufstehen, ein Enter loest keinen Eintrag aus. Der Fall davor ist die
' Gegenprobe: Alt allein und Enter trifft "Neu".
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM iNeu AS INTEGER : iNeu = GUI_MENU_ITEM(m, "Neu")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(iNeu) THEN PRINT "klick Neu"
    CLS(0) : GUI_DRAW() : FLIP()
WEND
PRINT "ende"
