' ============================================================
'  TIPPSPIEL -- Schnitt durch eine ganze Anwendung
' ============================================================
'  Ein Bundesliga-Tippspiel in Drachenhauch: Spiele aus SQLite,
'  Tipps eingeben und speichern, Ergebnisse eintragen, Punkte
'  rechnen, Rangliste.
'
'  Das ist der senkrechte Schnitt: von der Datenbank bis zum
'  Fenster, jede Schicht einmal -- klein gehalten, aber nichts
'  weggelassen, was eine echte Anwendung braucht.
'
'  Bedienung:
'    * Liga und Spieltag -> die Liste zeigt die Spiele dieses Spieltags
'    * Zeile anklicken   -> Tipp der Zeile kommt in die Felder
'    * Tipp speichern    -> schreibt in die Datenbank (INSERT/UPDATE)
'    * Aktualisieren     -> holt Spielplan UND Ergebnisse beider Ligen
'                           fuer die ganze Saison, rechnet alle Punkte neu
'    * Ergebnis eintragen-> von Hand, fuer das, was die Liga (noch)
'                           nicht meldet; rechnet die Punkte des Spiels neu
'    * Rangliste         -> zweiter Reiter, ueber alle Spieltage
'    [ESC] Ende
'
'  Die Datenbank legt das Programm beim ersten Start selbst an.
' ============================================================
IMPORT "gui"
IMPORT "db"
IMPORT "zeit"
IMPORT "html"
IMPORT "json"

CONST DATEI = "tippspiel.db"

' Getippt wird bis eine Viertelstunde vor Anpfiff.
CONST TIPPSCHLUSS_VOR = 15 * 60
' Woher der Spielplan kommt, wenn man ihn holt: je Liga die GANZE Saison in
' einem Abruf. 306 Spiele, 246 KB, keine 200 ms -- 34 einzelne Abrufe waeren
' langsamer und koennten mittendrin abbrechen. Welcher Spieltag und welche
' Liga ein Spiel ist, steht in der Antwort (group.groupOrderID,
' leagueShortcut) -- die URL muss man dafuer nicht zurueckrechnen.
CONST API = "https://api.openligadb.de/getmatchdata/"
CONST SAISON = "2026"
' Beide Bundesligen haben 18 Vereine und damit 34 Spieltage.
CONST MAX_SPIELTAG = 34
' Die Kuerzel sind die der API und stehen so auch in der Datenbank.
CONST LIGEN = 2
DIM ligaKuerzel[LIGEN] AS STRING
DIM ligaName[LIGEN] AS STRING
ligaKuerzel[0] = "bl1" : ligaName[0] = "1. Bundesliga"
ligaKuerzel[1] = "bl2" : ligaName[1] = "2. Bundesliga"

' ---- Punkteregel ---------------------------------------------------------
' Die einzige Stelle, an der die Regel steht. Alles andere fragt hier nach.
'   3 Punkte  exaktes Ergebnis
'   2 Punkte  richtige Tendenz + richtige Tordifferenz
'   1 Punkt   richtige Tendenz
'   0 Punkte  daneben
FUNCTION tendenz(heim AS INTEGER, gast AS INTEGER) AS INTEGER
    IF heim > gast THEN RETURN 1
    IF heim < gast THEN RETURN -1
    RETURN 0
END FUNCTION

FUNCTION punkte(tippH AS INTEGER, tippA AS INTEGER, _
                ergH AS INTEGER, ergA AS INTEGER) AS INTEGER
    IF tippH = ergH AND tippA = ergA THEN RETURN 3
    IF tendenz(tippH, tippA) <> tendenz(ergH, ergA) THEN RETURN 0
    IF (tippH - tippA) = (ergH - ergA) THEN RETURN 2
    RETURN 1
END FUNCTION

' ---- Datenbank -----------------------------------------------------------
DIM db AS DB_CONN

' Gibt es die Spalte schon? PRAGMA table_info listet die Spalten einer
' Tabelle -- die Datenbank weiss selbst am besten, wie sie aussieht.
FUNCTION spalteDa(tabelle AS STRING, spalte AS STRING) AS BOOLEAN
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "PRAGMA table_info(" + tabelle + ")")
    DIM gefunden AS BOOLEAN : gefunden = FALSE
    WHILE DB_NEXT(r)
        IF DB_GET_STRING(r, 1) = spalte THEN gefunden = TRUE
    WEND
    DB_CLOSE_RESULT(r)
    RETURN gefunden
END FUNCTION

SUB anlegen()
    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS spieler (" + _
                "id INTEGER PRIMARY KEY, name TEXT NOT NULL)")
    ' anstoss steht als "JJJJ-MM-TT hh:mm:ss" da: so sortiert SQLite es als
    ' Text richtig, und ZEIT_PARSE macht daraus eine Zahl zum Rechnen.
    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS spiele (" + _
                "id INTEGER PRIMARY KEY, " + _
                "liga TEXT NOT NULL DEFAULT 'bl1', " + _
                "spieltag INTEGER NOT NULL, " + _
                "heim TEXT NOT NULL, gast TEXT NOT NULL, " + _
                "anstoss TEXT, " + _
                "tore_heim INTEGER, tore_gast INTEGER)")
    ' Eine aeltere Datenbank kennt die Spalte noch nicht. Nachruesten statt
    ' neu anfangen -- die Tipps darin sollen erhalten bleiben.
    IF NOT spalteDa("spiele", "anstoss") THEN
        DB_EXEC(db, "ALTER TABLE spiele ADD COLUMN anstoss TEXT")
    END IF
    ' Dasselbe fuer die Liga. Der Vorgabewert fuellt die vorhandenen Zeilen
    ' gleich mit auf -- bis hierher gab es nur die 1. Bundesliga, also ist
    ' 'bl1' fuer sie nicht geraten, sondern richtig.
    IF NOT spalteDa("spiele", "liga") THEN
        DB_EXEC(db, "ALTER TABLE spiele ADD COLUMN liga TEXT NOT NULL DEFAULT 'bl1'")
        ' Der alte Index ohne Liga muss weg -- der neue kommt gleich darunter.
        DB_EXEC(db, "DROP INDEX IF EXISTS idx_spiel")
    END IF
    ' Ein Spiel ist eindeutig durch Liga, Spieltag und die beiden Vereine.
    ' Die Liga muss mit in den Index, auch wenn dieselbe Paarung in beiden
    ' Ligen praktisch nie vorkommt (ein Verein spielt in genau einer): das
    ' UPSERT beim Abruf sagt ON CONFLICT(liga, spieltag, heim, gast), und
    ' dafuer muss es einen Index ueber genau diese vier Spalten geben.
    ' Als Index, nicht als Tabellen-Bedingung -- so gilt die Regel auch fuer
    ' Datenbanken, die es schon vorher gab.
    DB_EXEC(db, "CREATE UNIQUE INDEX IF NOT EXISTS idx_spiel " + _
                "ON spiele (liga, spieltag, heim, gast)")
    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS tipps (" + _
                "id INTEGER PRIMARY KEY, spieler_id INTEGER NOT NULL, " + _
                "spiel_id INTEGER NOT NULL, tipp_heim INTEGER NOT NULL, " + _
                "tipp_gast INTEGER NOT NULL, punkte INTEGER, " + _
                "UNIQUE(spieler_id, spiel_id))")

    ' Tippgemeinschaften: das Buero tippt gegen das Buero, die Familie gegen
    ' die Familie. Ein Spieler kann in mehreren sein -- die Zugehoerigkeit
    ' steht deshalb in einer eigenen Tabelle und nicht als Spalte am Spieler.
    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS gruppen (" + _
                "id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE)")
    ' Kein eigener Schluessel: die Zeile IST das Paar. Zweimal dasselbe
    ' Mitglied laesst die Datenbank damit gar nicht erst zu.
    DB_EXEC(db, "CREATE TABLE IF NOT EXISTS gruppen_mitglieder (" + _
                "gruppe_id INTEGER NOT NULL, spieler_id INTEGER NOT NULL, " + _
                "PRIMARY KEY (gruppe_id, spieler_id))")
END SUB

FUNCTION anzahl(sql AS STRING) AS INTEGER
    DIM r AS DB_RESULT
    r = DB_QUERY(db, sql)
    DIM n AS INTEGER : n = 0
    IF DB_NEXT(r) THEN n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN n
END FUNCTION

SUB grunddaten()
    DB_BEGIN(db)
    IF anzahl("SELECT COUNT(*) FROM spieler") = 0 THEN
        DIM name AS STRING
        FOR EACH name IN ("Anna", "Ben", "Clara")
            DB_EXEC(db, "INSERT INTO spieler (name) VALUES (?)", name)
        NEXT
    END IF

    ' Ein Spieltag der 1. Bundesliga, damit der erste Start nicht leer ist --
    ' auch ohne Netz. Termin nur eintragen, wo noch keiner steht: ein
    ' geholter Spielplan soll beim naechsten Start nicht wieder
    ' ueberschrieben werden.
    '
    ' Die Vereine muessen GENAU so heissen wie beim Spielplan-Abruf. Sie sind
    ' der halbe Schluessel (spieltag, heim, gast): "Bor. Mönchengladbach" und
    ' "Borussia Mönchengladbach" sind fuer die Datenbank zwei Vereine, und
    ' der 1. Spieltag haette nach dem ersten Abruf zehn Spiele statt neun.
    terminVorgabe("bl1", "FC Bayern München", "VfB Stuttgart", "2026-08-28 20:30:00")
    terminVorgabe("bl1", "Borussia Dortmund", "Hamburger SV", "2026-08-29 18:30:00")
    terminVorgabe("bl1", "RB Leipzig", "Borussia Mönchengladbach", "2026-08-29 15:30:00")
    terminVorgabe("bl1", "SC Freiburg", "SV Werder Bremen", "2026-08-30 15:30:00")
    terminVorgabe("bl1", "1. FC Köln", "TSG Hoffenheim", "2026-08-29 15:30:00")
    terminVorgabe("bl2", "VfL Bochum", "Hertha BSC", "2026-08-07 20:30:00")
    terminVorgabe("bl2", "VfL Wolfsburg", "1. FC Kaiserslautern", "2026-08-08 20:30:00")
    terminVorgabe("bl2", "FC St. Pauli", "SpVgg Greuther Fürth", "2026-08-09 13:30:00")

    ' Eine Tippgemeinschaft zum Anschauen -- nicht alle sind drin, sonst
    ' waere sie von der Gesamtwertung nicht zu unterscheiden.
    IF anzahl("SELECT COUNT(*) FROM gruppen") = 0 THEN
        DB_EXEC(db, "INSERT INTO gruppen (name) VALUES ('Büro')")
        DB_EXEC(db, "INSERT INTO gruppen_mitglieder (gruppe_id, spieler_id) " + _
                    "SELECT g.id, p.id FROM gruppen g, spieler p " + _
                    "WHERE g.name = 'Büro' AND p.name IN ('Anna', 'Ben')")
    END IF
    DB_COMMIT(db)
END SUB

' Wie spielAnlegen, aber zurueckhaltend: ein vorhandener Termin bleibt
' stehen. COALESCE nimmt den alten Wert, wenn es einen gibt.
SUB terminVorgabe(liga AS STRING, heim AS STRING, gast AS STRING, anstoss AS STRING)
    DB_EXEC(db, "INSERT INTO spiele (liga, spieltag, heim, gast, anstoss) " + _
                "VALUES (?, 1, ?, ?, ?) " + _
                "ON CONFLICT(liga, spieltag, heim, gast) DO UPDATE SET " + _
                "  anstoss = COALESCE(spiele.anstoss, excluded.anstoss)", _
            liga, heim, gast, anstoss)
END SUB

' Ein Spiel anlegen oder seinen Anstoss auffrischen. Dieselbe Paarung am
' selben Spieltag gibt es nur einmal (UNIQUE) -- ein zweiter Abruf des
' Spielplans legt also keine Dubletten an.
SUB spielAnlegen(liga AS STRING, spieltag AS INTEGER, _
                 heim AS STRING, gast AS STRING, anstoss AS STRING)
    DB_EXEC(db, "INSERT INTO spiele (liga, spieltag, heim, gast, anstoss) " + _
                "VALUES (?, ?, ?, ?, ?) " + _
                "ON CONFLICT(liga, spieltag, heim, gast) DO UPDATE SET " + _
                "  anstoss = excluded.anstoss", liga, spieltag, heim, gast, anstoss)
END SUB

' Das Ergebnis eines abgerufenen Spiels eintragen. Angesprochen wird es ueber
' denselben Schluessel wie beim Anlegen -- die Zeile gibt es an dieser Stelle
' schon. Ein von Hand eingetragenes Ergebnis wird dabei ueberschrieben: was
' die Liga meldet, gilt.
SUB ergebnisSetzen(liga AS STRING, spieltag AS INTEGER, heim AS STRING, gast AS STRING, _
                   toreHeim AS INTEGER, toreGast AS INTEGER)
    DB_EXEC(db, "UPDATE spiele SET tore_heim = ?, tore_gast = ? " + _
                "WHERE liga = ? AND spieltag = ? AND heim = ? AND gast = ?", _
            toreHeim, toreGast, liga, spieltag, heim, gast)
END SUB

db = DB_OPEN(DATEI)
anlegen()
grunddaten()

