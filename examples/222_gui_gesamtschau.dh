DIM pruef6 AS GUI_WIDGET : pruef6 = GUI_BUTTON(s6, "Pruefen", 560, 330, 160, 34)
DIM leben6 AS GUI_WIDGET : leben6 = GUI_LABEL(s6, "Jede Bewegung kommt aus der Stildatei (Station 'Stildatei live') oder aus GUI_ANIMATE," + CHR$(10) + "auch der wandernde Farbverlauf. 'Bewegung' oben haelt alles an -- auch die Kugeln im Hintergrund.", 32, 420)

' --------------------------------------------------- 7 Stildatei live
DIM s7 AS GUI_WINDOW : s7 = seite("Stildatei live")
DIM stilFeld AS GUI_WIDGET : stilFeld = GUI_TEXTAREA(s7, 20, 20, 640, 600)
GUI_TEXTAREA_SET(stilFeld, "zeilennummern", 1)
DIM anwenden AS GUI_WIDGET : anwenden = GUI_BUTTON(s7, "Anwenden", 680, 20, 160, 38)
GUI_BUTTON_VARIANT(anwenden, "primaer")
DIM stilFehler AS GUI_WIDGET : stilFehler = GUI_LABEL(s7, "", 680, 70)
DIM stilHilfe AS GUI_WIDGET : stilHilfe = GUI_RICHTEXT(s7, 680, 110, 340, 510, "## Ausprobieren" + CHR$(10) + CHR$(10) + "- Eine Farbe aendern, **Anwenden**" + CHR$(10) + "- `@breite < 1000`: das Fenster schmal ziehen -- der Titel wird klein" + CHR$(10) + "- `@hell` / `@dunkel`: oben ein anderes Thema waehlen" + CHR$(10) + "- `@hochkontrast`: oben **Kontrast** einschalten" + CHR$(10) + "- `@zeit` und `@datum`: Regeln nach der Uhr" + CHR$(10) + CHR$(10) + "Ein Fehler steht mit Zeile oben -- die alte Stildatei gilt weiter.")

DIM stil AS STRING = ""
stil = stil + "/* Die Stildatei dieser Schau -- aendern und Anwenden */" + CHR$(10)
stil = stil + "* { gleiten: 260 }" + CHR$(10)
stil = stil + "button { klang: klick; radius: 9 }" + CHR$(10)
stil = stil + "button:hover { klang: tick 30% }" + CHR$(10)
stil = stil + "#titel { groesse: 30; stil: fett; fg: #FFD166 }" + CHR$(10)
stil = stil + "@hell #titel { fg: #7B3FC4 }" + CHR$(10)
stil = stil + "@breite < 1000 #titel { groesse: 20 }" + CHR$(10)
stil = stil + "#gruss { groesse: 40; stil: fett; fg: #FFFFFF; animation: weich 2600ms immer }" + CHR$(10)
stil = stil + "@hell #gruss { fg: #2B2140 }" + CHR$(10)
stil = stil + "panel.glas { unschaerfe: 16; bg: #40FFFFFF; radius: 18 }" + CHR$(10)
stil = stil + "card { radius: 14; bg: #30FFFFFF; animation: schweben 3400ms }" + CHR$(10)
stil = stil + "#nav { bg: #28FFFFFF; radius: 12 }" + CHR$(10)
stil = stil + "#k2 { animation: schweben 3900ms }" + CHR$(10)
stil = stil + "#k3 { animation: schweben 4400ms }" + CHR$(10)
stil = stil + "button.los { form: pille; bg: #E0457B; farbverlauf: #FF6F91 #FF9671 #F9C74F #FF6F91 0 wandert 4s; groesse: 22; animation: puls 1500ms; effekt: konfetti; klang: erfolg }" + CHR$(10)
stil = stil + "#emoji { groesse: 34 }" + CHR$(10)
stil = stil + "#emojigross { groesse: 30 }" + CHR$(10)
stil = stil + "#schriften { groesse: 20 }" + CHR$(10)
stil = stil + "#kreis { bg: #6C3483; animation: drehen 6000ms }" + CHR$(10)
stil = stil + "#raute { bg: #1E8449 }" + CHR$(10)
stil = stil + "#raute:hover { animation: wackeln 400ms einmal }" + CHR$(10)
stil = stil + "#pa { bg: #3A2E6E; farbverlauf: #3A2E6E #845EC2 #2C73D2 #00C9A7 45 wandert 5s; radius: 16; animation: schweben 2400ms }" + CHR$(10)
stil = stil + "#pb { bg: #6E2E4A; radius: 16; animation: puls 1200ms }" + CHR$(10)
stil = stil + "#pc { bg: #2E6E5A; radius: 16; animation: huepfen 1600ms }" + CHR$(10)
stil = stil + "#pd { bg: #6E5A2E; radius: 16; animation: kreisen 3000ms }" + CHR$(10)
stil = stil + "#rad { form: kreis; bg: #2A6FB0; animation: drehen 4000ms }" + CHR$(10)
stil = stil + "button.fest { form: pille }" + CHR$(10)
stil = stil + "#fps { fg: #8FE3A1 }" + CHR$(10)
stil = stil + "@hell #fps { fg: #1E7A3A }" + CHR$(10)
stil = stil + "@hochkontrast button { border: #FFFF00; fg: #FFFFFF; bg: #000000 }" + CHR$(10)
stil = stil + "@datum 12-01..12-26 #titel { fg: #E74C3C }" + CHR$(10)
stil = stil + "@ablauf weich { 0%: deckkraft 1; 50%: deckkraft 0.75, y -4; 100%: deckkraft 1 }" + CHR$(10)
stil = stil + "@ablauf kreisen { 0%: x 0, y 0; 25%: x 8, y -6; 50%: x 0, y -12; 75%: x -8, y -6; 100%: x 0, y 0 }" + CHR$(10)
GUI_SET_TEXT(stilFeld, stil)
TRY
    GUI_STYLESHEET(stil)
CATCH e
    GUI_SET_TEXT(stilFehler, e)
END TRY

' --------------------------------------------------- 8 Werkzeuge
DIM s8 AS GUI_WINDOW : s8 = seite("Werkzeuge")
DIM bPal AS GUI_WIDGET : bPal = GUI_BUTTON(s8, "Befehlspalette", 20, 20, 220, 44)
DIM bIns AS GUI_WIDGET : bIns = GUI_BUTTON(s8, "Inspektor", 260, 20, 220, 44)
DIM bToast AS GUI_WIDGET : bToast = GUI_BUTTON(s8, "Toast", 500, 20, 220, 44)
DIM bInfo AS GUI_WIDGET : bInfo = GUI_BUTTON(s8, "Infoleiste", 20, 84, 220, 44)
DIM bDialog AS GUI_WIDGET : bDialog = GUI_BUTTON(s8, "Dialog", 260, 84, 220, 44)
DIM bFenster AS GUI_WIDGET : bFenster = GUI_BUTTON(s8, "Echtes Fenster", 500, 84, 220, 44)
DIM werkzeugText AS GUI_WIDGET : werkzeugText = GUI_RICHTEXT(s8, 20, 160, 700, 420, "## Werkzeuge, die jedes Programm hat" + CHR$(10) + CHR$(10) + "- **Befehlspalette** (Strg+Umschalt+P): sucht in allen Menues und Werkzeugleisten -- ohne eine Zeile Code" + CHR$(10) + "- **Inspektor**: das Widget unter dem Zeiger, die Regeln der Stildatei mit Zeile, Befunde der Barrierefreiheit" + CHR$(10) + "- **Toast** und **Infoleiste**: Meldungen, die von selbst gehen bzw. eine Antwort wollen" + CHR$(10) + "- **Dialog**: modal, mit Enter und ESC" + CHR$(10) + "- **Echtes Fenster**: ein gui-Fenster als eigenes Fenster des Systems -- ueber den Rand, auf den zweiten Schirm")
DIM antwort AS GUI_WIDGET : antwort = GUI_LABEL(s8, "", 740, 30)
DIM dlg AS GUI_WINDOW : dlg = -1
DIM zweit AS GUI_WINDOW : zweit = GUI_WINDOW("Zweites Fenster", 820, 300, 320, 200)
GUI_WINDOW_VISIBLE(zweit, FALSE)
GUI_WINDOW_CLOSABLE(zweit, TRUE)
DIM zweitText AS GUI_WIDGET : zweitText = GUI_LABEL(zweit, "Ich bin ein eigenes Fenster" + CHR$(10) + "des Systems -- zieh mich" + CHR$(10) + "ueber den Rand.", 20, 20)
DIM zweitKnopf AS GUI_WIDGET : zweitKnopf = GUI_BUTTON(zweit, "Feiern", 20, 110, 140, 40)

' --------------------------------------------------- 9 Barrierefreiheit
DIM s9 AS GUI_WINDOW : s9 = seite("Barrierefreiheit")
DIM bPruef AS GUI_WIDGET : bPruef = GUI_BUTTON(s9, "Oberflaeche pruefen", 20, 20, 240, 44)
GUI_BUTTON_VARIANT(bPruef, "primaer")
DIM bHeilen AS GUI_WIDGET : bHeilen = GUI_TOGGLE(s9, "Fehler beheben", 290, 30, FALSE)
DIM befunde AS GUI_WIDGET : befunde = GUI_TEXTAREA(s9, 20, 90, 640, 530)
GUI_TEXTAREA_SET(befunde, "umbruch", 1)
GUI_TOOLTIP(befunde, "Befunde der Pruefung")   ' sonst waere das Feld selbst ein Befund (ohne Namen)
GUI_SET_TEXT(befunde, "Rechts stehen vier Widgets, die es Menschen schwer machen." + CHR$(10) + CHR$(10) + "'Oberflaeche pruefen' zaehlt auf, was daran fehlt -- 'Fehler beheben' repariert sie, und die Pruefung laeuft gleich noch einmal.")
DIM schlecht AS GUI_WIDGET : schlecht = GUI_GROUPBOX(s9, 690, 90, 330, 210, "Absichtlich schlecht")
DIM blass AS GUI_WIDGET : blass = GUI_BUTTON(s9, "Blass", 710, 130, 140, 40)
GUI_SET_COLOR(blass, "fg", &H8890A0) : GUI_SET_COLOR(blass, "bg", &HA0A8B0)
DIM ohneName AS GUI_WIDGET : ohneName = GUI_BUTTON(s9, "", 870, 130, 40, 40)
GUI_SET_ICON(ohneName, "schliessen")
DIM winzig1 AS GUI_WIDGET : winzig1 = GUI_BUTTON(s9, "a", 710, 200, 16, 16)
DIM winzig2 AS GUI_WIDGET : winzig2 = GUI_BUTTON(s9, "b", 728, 200, 16, 16)
DIM ohneLabel AS GUI_WIDGET : ohneLabel = GUI_TEXTINPUT(s9, 710, 250, 280, 30)
DIM a11yHinweis AS GUI_WIDGET : a11yHinweis = GUI_RICHTEXT(s9, 690, 320, 330, 300,"## Die eingebaute Pruefung" + CHR$(10) + CHR$(10) + "`GUI_A11Y_CHECK$` findet zu wenig Kontrast, Widgets ohne Namen fuer den Bildschirmleser, zu kleine Ziele und eine Tab-Reihenfolge, die springt." + CHR$(10) + CHR$(10) + "Der Inspektor nennt die Befunde je Widget.")

' --------------------------------------------------- Ablauf
DIM aktiv AS INTEGER : aktiv = -1
SUB zeige(k AS INTEGER)
    IF k < 0 OR k >= LEN(seiten) OR k = aktiv THEN EXIT SUB
    DIM j AS INTEGER
    FOR j = 0 TO LEN(seiten) - 1
        GUI_WINDOW_VISIBLE(seiten[j], j = k)
    NEXT
    aktiv = k
    GUI_LISTBOX_SET_SELECTED(nav, k)
    GUI_STATUSBAR_SET(fuss, 0, "Station " + STR$(k + 1) + " von " + STR$(LEN(seiten)) + ": " + stationen[k])
    ' Ein Lichtstreif zieht ueber die neue Station.
    GUI_WINDOW_GLOW(seiten[k])
END SUB

' Fenster und Stationen an die Groesse des Bildschirms und die Richtung legen.
SUB anordnen()
    DIM b AS INTEGER : b = SCREENWIDTH()
    DIM h AS INTEGER : h = SCREENHEIGHT()
    GUI_WINDOW_SET_BOUNDS(haupt, 0, 0, b, h)
    GUI_SET_BOUNDS(nav, 12, KOPF_H - MENUE_H + 6, NAV_B - 22, h - KOPF_H - FUSS_H - 18)
    GUI_SET_BOUNDS(fuss, 0, h - MENUE_H - FUSS_H, b, FUSS_H)
    DIM x AS INTEGER : x = IIF(GUI_CHECKED(sRtl), 10, NAV_B)
    DIM j AS INTEGER
    FOR j = 0 TO LEN(seiten) - 1
        GUI_WINDOW_SET_BOUNDS(seiten[j], x, KOPF_H, b - NAV_B - 10, h - KOPF_H - FUSS_H - 6)
    NEXT
END SUB

' Der bewegte Hintergrund: ein Verlauf, dessen Ecken langsam die Farbe
' wechseln, und weiche Lichtkugeln, die darueber treiben.
DIM zeit AS FLOAT = 0
SUB hintergrund()
    DIM b AS INTEGER : b = SCREENWIDTH()
    DIM h AS INTEGER : h = SCREENHEIGHT()
    DIM t AS FLOAT : t = zeit
    DIM a AS INTEGER : a = INT(50 + 40 * SIN(t * 0.31))
    GRADIENT4(0, 0, b, h, RGB(110 + a, 40, 170), RGB(30, 90 + a, 200), RGB(180, 40, 110 + a), RGB(30, 150, 160))
    DIM j AS INTEGER
    FOR j = 0 TO 5
        DIM px AS FLOAT : px = b * (0.5 + 0.42 * SIN(t * (0.11 + j * 0.03) + j * 1.7))
        DIM py AS FLOAT : py = h * (0.5 + 0.40 * COS(t * (0.09 + j * 0.025) + j * 2.3))
        DIM r AS INTEGER : r = 220 + 90 * (j MOD 3)
        DIM farben AS ARRAY OF INTEGER : farben = [RGBA(255, 120, 200, 200), RGBA(90, 200, 255, 200), RGBA(255, 210, 90, 180), RGBA(140, 110, 255, 200), RGBA(80, 255, 180, 170), RGBA(255, 90, 90, 170)]
        CIRCLE_GRADIENT(INT(px), INT(py), r, farben[j], RGBA(0, 0, 0, 1))
    NEXT
    ' Im hellen Thema ein weisser Schleier darueber: dunkle Schrift bleibt lesbar.
    IF hellerGrund THEN BOX(0, 0, b - 1, h - 1, RGBA(255, 255, 255, 190))
END SUB

' Rechts nach links: alle Fenster spiegeln, die Stationen wechseln die Seite.
SUB richtung()
    DIM j AS INTEGER
    GUI_WINDOW_RTL(haupt, GUI_CHECKED(sRtl))
    FOR j = 0 TO LEN(seiten) - 1
        GUI_WINDOW_RTL(seiten[j], GUI_CHECKED(sRtl))
    NEXT
    anordnen()
END SUB

' Aufruf: dhrt run 222_gui_gesamtschau.dh -- [station] [thema] [rtl]
' (fuer Bilder der einzelnen Stationen; ohne Argumente beginnt der Rundgang vorn)
anordnen()
DIM start AS INTEGER : start = 0
IF ARGC() > 0 THEN start = VAL(ARG$(0))
IF ARGC() > 1 THEN
    GUI_DROPDOWN_SET_SELECTED(themaWahl, VAL(ARG$(1)))
    thema(VAL(ARG$(1)))
END IF
IF ARGC() > 2 AND ARG$(2) = "rtl" THEN
    GUI_SET_CHECKED(sRtl, TRUE)
    richtung()
END IF
zeige(start)
GUI_WINDOW_GLOW(haupt)
GUI_BURST(titel, "sterne")

DIM warB AS INTEGER : warB = SCREENWIDTH()
DIM warH AS INTEGER : warH = SCREENHEIGHT()
DIM bilder AS INTEGER = 0
DIM sekunde AS FLOAT : sekunde = TIMER()
DIM wahlStand AS STRING = ""

WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF SCREENWIDTH() <> warB OR SCREENHEIGHT() <> warH THEN
        warB = SCREENWIDTH() : warH = SCREENHEIGHT()
        anordnen()
    END IF

    ' --- die Leiste oben
    IF GUI_CHANGED(nav) THEN zeige(GUI_LISTBOX_SELECTED(nav))
    IF GUI_CLICKED(miWeiter) THEN zeige((aktiv + 1) MOD LEN(seiten))
    IF GUI_CLICKED(miZurueck) THEN zeige((aktiv + LEN(seiten) - 1) MOD LEN(seiten))
    IF GUI_CLICKED(miEnde) THEN EXIT WHILE
    IF GUI_CLICKED(miPalette) THEN GUI_PALETTE(TRUE)
    IF GUI_CLICKED(miInspektor) THEN GUI_INSPECTOR(TRUE)
    IF GUI_CLICKED(miFeier) THEN GUI_BURST(titel, "konfetti") : GUI_SOUND("erfolg")
    IF GUI_CHANGED(themaWahl) THEN
        thema(GUI_DROPDOWN_SELECTED(themaWahl))
        GUI_WINDOW_GLOW(haupt)
    END IF
    IF GUI_CHANGED(sRtl) THEN richtung()
    IF GUI_CHANGED(sBewegung) THEN GUI_SET_MOTION(IIF(GUI_CHECKED(sBewegung), "system", "aus"))
    IF GUI_CHANGED(sToene) THEN GUI_SET_SOUNDS(GUI_CHECKED(sToene))
    IF GUI_CHANGED(sKontrast) THEN GUI_SET_CONTRAST(IIF(GUI_CHECKED(sKontrast), "hoch", "system"))
    ' Sparsam: der Hintergrund steht, FLIP schlaeft bis zur naechsten
    ' Eingabe oder bis die gui ein Bild braucht.
    WINDOW_WAIT_EVENTS(IIF(GUI_CHECKED(sSparsam), 1, 0))

    ' --- die Stationen
    IF GUI_CLICKED(los) THEN zeige(1)
    IF GUI_CLICKED(k1) THEN zeige(6)
    IF GUI_CLICKED(k2) THEN zeige(9)
    IF GUI_CLICKED(k3) THEN GUI_SET_CHECKED(sSparsam, TRUE) : GUI_TOAST(haupt, "Sparsam ist an -- sieh oben rechts", "info", 3000)
    GUI_SET_VALUE(fort, GUI_VALUE(regler))
    IF GUI_CLICKED(kreis) THEN GUI_SET_TEXT(meldung1, "Getroffen: der Kreis")
    IF GUI_CLICKED(raute) THEN GUI_SET_TEXT(meldung1, "Getroffen: die Raute")
    IF GUI_CHANGED(name) THEN GUI_SET_TEXT(hallo, IIF(TRIM$(GUI_TEXT(name)) = "", "", "Hallo, " + GUI_TEXT(name) + "! " + CHR$(&H1F44B)))
    IF aktiv = 3 THEN tabelleLiefern()
    DIM fw AS INTEGER : fw = GUI_PICKED_COLOR(farbe)
    GUI_SET_COLOR(farbFeld, "bg", fw BAND &HFFFFFF)
    GUI_SET_TEXT(farbText, "Gewaehlt: #" + RIGHT$("000000" + HEX$(fw BAND &HFFFFFF), 6))
    DIM wahl AS STRING : wahl = "Datum " + GUI_DATE(kalender) + "   Uhrzeit " + GUI_TIME$(uhr)
    IF wahl <> wahlStand THEN wahlStand = wahl : GUI_SET_TEXT(wahlText, wahl)
    IF GUI_BREADCRUMB_CLICKED(pfad) >= 0 THEN GUI_TOAST(haupt, "Pfad: " + GUI_BREADCRUMB_TEXT$(pfad, GUI_BREADCRUMB_CLICKED(pfad)), "info", 1800)
    IF GUI_WIZARD_FINISHED(wz) THEN GUI_BURST(wz, "konfetti") : GUI_SOUND("erfolg") : GUI_WIZARD_SET_STEP(wz, 0)
    IF GUI_CLICKED(funken) THEN GUI_BURST(funken, "funken")
    IF GUI_CLICKED(konfetti) THEN GUI_BURST(konfetti, "konfetti")
    IF GUI_CLICKED(sterne) THEN GUI_BURST(sterne, "sterne")
    IF GUI_CLICKED(streif) THEN GUI_WINDOW_GLOW(s6)
    IF GUI_CLICKED(pruef6) THEN
        IF TRIM$(GUI_TEXT(wackel)) = "" THEN
            GUI_ANIMATE(wackel, "wackeln", 320)
            GUI_SOUND("fehler")
        ELSE
            GUI_BURST(pruef6, "sterne")
            GUI_SOUND("erfolg")
        END IF
    END IF
    IF GUI_CLICKED(anwenden) THEN
        TRY
            GUI_STYLESHEET(GUI_TEXT(stilFeld))
            GUI_SET_TEXT(stilFehler, "Angewendet.")
            GUI_BURST(anwenden, "sterne")
        CATCH e
            GUI_SET_TEXT(stilFehler, e)
            GUI_ANIMATE(stilFeld, "wackeln", 300)
        END TRY
    END IF
    IF GUI_CLICKED(bPal) THEN GUI_PALETTE(TRUE)
    IF GUI_CLICKED(bIns) THEN GUI_INSPECTOR(TRUE)
    IF GUI_CLICKED(bToast) THEN GUI_TOAST(haupt, "Ein Toast geht von selbst " + CHR$(&H2728), "erfolg", 2500)
    IF GUI_CLICKED(bInfo) THEN GUI_INFOBAR(s8, "Eine Infoleiste wartet auf eine Antwort.", "info", "Gut|Spaeter")
    IF GUI_INFOBAR_ANSWER(s8) > 0 THEN GUI_SET_TEXT(antwort, "Infoleiste: Antwort " + STR$(GUI_INFOBAR_ANSWER(s8)))
    IF GUI_CLICKED(bDialog) THEN dlg = GUI_DIALOG("Frage", "Gefaellt dir die Schau?", "janein")
    IF dlg >= 0 THEN
        IF GUI_ANSWER(dlg) <> 0 THEN
            GUI_SET_TEXT(antwort, IIF(GUI_ANSWER(dlg) = 1, "Dialog: Ja " + CHR$(&H1F60A), "Dialog: Nein"))
            IF GUI_ANSWER(dlg) = 1 THEN GUI_BURST(bDialog, "konfetti")
            dlg = -1
        END IF
    END IF
    IF GUI_CLICKED(bFenster) THEN
        GUI_WINDOW_VISIBLE(zweit, TRUE)
        IF NOT GUI_WINDOW_NATIVE(zweit, TRUE) THEN GUI_SET_TEXT(antwort, "Hier gibt es keine echten Fenster -- es bleibt im Hauptfenster.")
        GUI_WINDOW_FRONT(zweit)
    END IF
    IF GUI_CLICKED(zweitKnopf) THEN GUI_BURST(zweitKnopf, "konfetti") : GUI_SOUND("ping")
    IF GUI_CHANGED(bHeilen) THEN
        IF GUI_CHECKED(bHeilen) THEN
            GUI_SET_COLOR(blass, "fg", &H101418)
            GUI_TOOLTIP(ohneName, "Loeschen")
            GUI_SET_BOUNDS(winzig2, 760, 200, 16, 16)
            GUI_TOOLTIP(ohneLabel, "Bemerkung")
        ELSE
            GUI_SET_COLOR(blass, "fg", &H8890A0)
            GUI_TOOLTIP(ohneName, "")
            GUI_SET_BOUNDS(winzig2, 728, 200, 16, 16)
            GUI_TOOLTIP(ohneLabel, "")
        END IF
    END IF
    IF GUI_CLICKED(bPruef) OR GUI_CHANGED(bHeilen) THEN
        DIM bef AS STRING : bef = GUI_A11Y_CHECK$(s9)
        IF bef = "" THEN
            GUI_SET_TEXT(befunde, "Keine Befunde " + CHR$(&H2705))
            GUI_BURST(bPruef, "sterne")
        ELSE
            GUI_SET_TEXT(befunde, bef)
        END IF
    END IF

    ' --- zeichnen
    IF NOT GUI_CHECKED(sSparsam) AND GUI_MOTION() THEN zeit = zeit + DELTA()
    hintergrund()
    GUI_DRAW()
    FLIP()

    ' Bilder je Sekunde -- im Sparsam-Modus faellt die Zahl.
    bilder = bilder + 1
    IF TIMER() - sekunde >= 1 THEN
        GUI_SET_TEXT(fpsAnzeige, STR$(bilder) + " Bilder/s")
        bilder = 0
        sekunde = TIMER()
    END IF
WEND
