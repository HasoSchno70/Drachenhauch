' Abfragen zu Settern der gui (seit 2026.47): was ein Programm setzt, kann es
' auch zuruecklesen -- vorher mussten Tests der IDE sich den Zustand selbst
' merken oder die Form aus GUI_SAVE nach Text durchsuchen.
' GUI_TOOLTIP$, GUI_TEXTINPUT_GET, GUI_TEXTINPUT_PLACEHOLDER$,
' GUI_STATUSBAR_TIP$, GUI_TOOLBAR_GET, GUI_DOCK_TITLE$, GUI_TEXTAREA_HINT$,
' GUI_TEXTAREA_HINT_COUNT.

=== hilfetext eines widgets
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w, "OK", 10, 10, 80, 26)
PRINT "leer |"; GUI_TOOLTIP$(k); "|"
GUI_TOOLTIP(k, "Speichert die Datei")
PRINT "gesetzt "; GUI_TOOLTIP$(k)
GUI_TOOLTIP(k, "")
PRINT "entfernt |"; GUI_TOOLTIP$(k); "|"
--- umgebung
DHRT_FRAMES=2
--- erwartet
leer ||
gesetzt Speichert die Datei
entfernt ||

=== einstellungen und platzhalter eines textfelds
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 10, 10, 200, 26, "Name ...")
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 50, 200, 80, "Notizen")
PRINT "platzhalter "; GUI_TEXTINPUT_PLACEHOLDER$(tf); " / "; GUI_TEXTINPUT_PLACEHOLDER$(ta)
PRINT "vorher "; GUI_TEXTINPUT_GET(tf, "suche"); GUI_TEXTINPUT_GET(tf, "passwort"); GUI_TEXTINPUT_GET(tf, "nur_lesen"); GUI_TEXTINPUT_GET(tf, "maxlaenge"); GUI_TEXTINPUT_GET(tf, "zahlen")
GUI_TEXTINPUT_SET(tf, "suche", 1)
GUI_TEXTINPUT_SET(tf, "passwort", 1)
GUI_TEXTINPUT_SET(tf, "nur_lesen", 1)
GUI_TEXTINPUT_SET(tf, "maxlaenge", 12)
GUI_TEXTINPUT_SET(tf, "zahlen", 3)
PRINT "nachher "; GUI_TEXTINPUT_GET(tf, "suche"); GUI_TEXTINPUT_GET(tf, "passwort"); GUI_TEXTINPUT_GET(tf, "nur_lesen"); GUI_TEXTINPUT_GET(tf, "maxlaenge"); GUI_TEXTINPUT_GET(tf, "zahlen")
GUI_TEXTINPUT_SET(tf, "suche", 0)
PRINT "suche aus "; GUI_TEXTINPUT_GET(tf, "search")
--- umgebung
DHRT_FRAMES=2
--- erwartet
platzhalter Name ... / Notizen
vorher 00000
nachher 111123
suche aus 0

=== ein unbekannter schluessel ist ein fehler
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
PRINT GUI_TEXTINPUT_GET(tf, "farbe")
--- umgebung
DHRT_FRAMES=2
--- fehler
GUI_TEXTINPUT_GET: unbekannter Schluessel 'farbe'

=== nur ein textfeld hat textfeld-einstellungen
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w, "OK", 10, 10, 80, 26)
PRINT GUI_TEXTINPUT_GET(k, "suche")
--- umgebung
DHRT_FRAMES=2
--- fehler
GUI_TEXTINPUT_GET: das Widget ist kein GUI_TEXTINPUT

=== hilfetext eines feldes der statusleiste
IMPORT "gui"
SCREEN(400, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
DIM sb AS GUI_WIDGET : sb = GUI_STATUSBAR(w, 0, 170, 400, 24, "Bereit.")
DIM pos AS INTEGER : pos = GUI_STATUSBAR_ADD(sb, "Zeile 1", 100, "mitte")
GUI_STATUSBAR_TIP(sb, 0, "C:/projekt/haupt.dh")
GUI_STATUSBAR_TIP(sb, pos, "Gehe zu Zeile")
PRINT "feld 0 "; GUI_STATUSBAR_TIP$(sb, 0)
PRINT "feld 1 "; GUI_STATUSBAR_TIP$(sb, pos)
--- umgebung
DHRT_FRAMES=2
--- erwartet
feld 0 C:/projekt/haupt.dh
feld 1 Gehe zu Zeile

=== einstellungen der werkzeugleiste
IMPORT "gui"
SCREEN(400, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(w, 0, 0, 400, 34)
GUI_TOOLBAR_ADD(tb, "neu", "Neu")
PRINT "vorgabe "; GUI_TOOLBAR_GET(tb, "symbolgroesse"); " "; GUI_TOOLBAR_GET(tb, "beschriftung")
GUI_TOOLBAR_SET(tb, "symbolgroesse", 22)
GUI_TOOLBAR_SET(tb, "beschriftung", 1)
PRINT "gesetzt "; GUI_TOOLBAR_GET(tb, "symbol"); " "; GUI_TOOLBAR_GET(tb, "text")
--- umgebung
DHRT_FRAMES=2
--- erwartet
vorgabe 0 0
gesetzt 22 1

=== titel einer dock-leiste
IMPORT "gui"
SCREEN(600, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_DOCK(w, 0, 0, 600, 400)
GUI_DOCK_PANEL(w, "probleme", "Probleme", "unten")
PRINT "anfang "; GUI_DOCK_TITLE$(w, "probleme")
GUI_DOCK_TITLE(w, "probleme", "Probleme (3)")
PRINT "neu "; GUI_DOCK_TITLE$(w, "probleme")
--- umgebung
DHRT_FRAMES=2
--- erwartet
anfang Probleme
neu Probleme (3)

=== eine leiste, die es nicht gibt
IMPORT "gui"
SCREEN(600, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_DOCK(w, 0, 0, 600, 400)
PRINT GUI_DOCK_TITLE$(w, "gibtsnicht")
--- umgebung
DHRT_FRAMES=2
--- fehler
GUI_DOCK_TITLE$

=== hinweise im textbereich, auch nachdem sie mitgewandert sind
IMPORT "gui"
SCREEN(400, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 0, 0, 380, 180)
GUI_SET_TEXT(ta, "a = 1" + CHR$(10) + "b = 2" + CHR$(10) + "c = 3")
PRINT "ohne "; GUI_TEXTAREA_HINT_COUNT(ta); " |"; GUI_TEXTAREA_HINT$(ta, 2); "|"
GUI_TEXTAREA_HINTS(ta, [2, 3], ["zwei", "drei"])
PRINT "anzahl "; GUI_TEXTAREA_HINT_COUNT(ta)
PRINT "zeile 1 |"; GUI_TEXTAREA_HINT$(ta, 1); "|"
PRINT "zeile 2 "; GUI_TEXTAREA_HINT$(ta, 2)
PRINT "zeile 3 "; GUI_TEXTAREA_HINT$(ta, 3)
' Eine Zeile darueber: die Hinweise wandern mit, die Abfrage sieht es sofort.
GUI_TEXTAREA_SELECT(ta, 1, 1, 1, 1)
GUI_TEXTAREA_INSERT(ta, "neu = 0" + CHR$(10))
PRINT "danach 2 |"; GUI_TEXTAREA_HINT$(ta, 2); "|"
PRINT "danach 3 "; GUI_TEXTAREA_HINT$(ta, 3)
PRINT "danach 4 "; GUI_TEXTAREA_HINT$(ta, 4)
PRINT "zeile 0 |"; GUI_TEXTAREA_HINT$(ta, 0); "|"
GUI_TEXTAREA_HINTS(ta, [], [])
PRINT "geloescht "; GUI_TEXTAREA_HINT_COUNT(ta)
--- umgebung
DHRT_FRAMES=2
--- erwartet
ohne 0 ||
anzahl 2
zeile 1 ||
zeile 2 zwei
zeile 3 drei
danach 2 ||
danach 3 zwei
danach 4 drei
zeile 0 ||
geloescht 0

=== die uebrigen setter lassen sich zuruecklesen
' Ausrichtung, Anker, Schriftgroesse, Sinnbild, rund, Mindestmass, Umbruch,
' Tab-Reihenfolge und benannter Stil -- je vorher und nachher.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w, "OK", 10, 10, 80, 26)
DIM l AS GUI_WIDGET : l = GUI_LABEL(w, "Ein langer Text zum Umbrechen", 10, 50)
PRINT "vorher |"; GUI_GET_ALIGN$(k); "| "; GUI_GET_ANCHOR$(k); " "; GUI_GET_FONT_SIZE(k); " |"; GUI_GET_ICON$(k); "| "; GUI_GET_ICON(k); " "; GUI_GET_ROUND(k)
PRINT "vorher "; GUI_GET_MIN_W(k); " "; GUI_GET_MIN_H(k); " "; GUI_GET_WRAP(l); " "; GUI_GET_TAB_INDEX(k)
GUI_SET_ALIGN(k, "rechts")
GUI_SET_ANCHOR(k, "brl")
GUI_SET_FONT_SIZE(k, 22)
GUI_SET_ICON(k, "start")
GUI_SET_ROUND(k, TRUE)
GUI_SET_MIN_SIZE(k, 60, 30)
GUI_SET_WRAP(l, 120)
GUI_SET_TAB_INDEX(k, 3)
PRINT "nachher "; GUI_GET_ALIGN$(k); " "; GUI_GET_ANCHOR$(k); " "; GUI_GET_FONT_SIZE(k); " "; GUI_GET_ICON$(k); " "; GUI_GET_ICON(k); " "; GUI_GET_ROUND(k)
PRINT "nachher "; GUI_GET_MIN_W(k); " "; GUI_GET_MIN_H(k); " "; GUI_GET_WRAP(l); " "; GUI_GET_TAB_INDEX(k)
GUI_SET_WRAP(l, 0)
PRINT "umbruch aus "; GUI_GET_WRAP(l)
GUI_STYLE_SET("warn", "bg", &HC03030)
PRINT "stil "; HEX$(GUI_STYLE_GET("warn", "bg")); " "; GUI_STYLE_GET("warn", "fg")
--- umgebung
DHRT_FRAMES=2
--- erwartet
vorher || lt 0 || -1 FALSE
vorher 0 0 0 0
nachher rechts lrb 22 start -1 TRUE
nachher 60 30 120 3
umbruch aus 0
stil C03030 -1

=== ein unbekannter stil ist ein fehler
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
PRINT GUI_STYLE_GET("gibtsnicht", "bg")
--- umgebung
DHRT_FRAMES=2
--- fehler
GUI_STYLE_GET: unbekannter Style 'gibtsnicht'

=== rueckgaengig und wieder vor ueber die api
' GUI_UNDO/GUI_REDO nehmen denselben Weg wie Strg+Z/Strg+Y; GUI_CAN_UNDO
' und GUI_CAN_REDO sagen, ob es einen Schritt gibt (fuer Menueeintraege).
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 300, 200)
GUI_SET_TEXT(ta, "abc")
PRINT "frisch "; GUI_CAN_UNDO(ta); " "; GUI_CAN_REDO(ta); " "; GUI_UNDO(ta)
GUI_TEXTAREA_SELECT(ta, 1, 4, 1, 4)
GUI_TEXTAREA_INSERT(ta, "def")
PRINT "eingefuegt "; GUI_TEXT(ta); " "; GUI_CAN_UNDO(ta); " "; GUI_CAN_REDO(ta)
PRINT "zurueck "; GUI_UNDO(ta); " "; GUI_TEXT(ta); " "; GUI_CAN_UNDO(ta); " "; GUI_CAN_REDO(ta)
PRINT "vor "; GUI_REDO(ta); " "; GUI_TEXT(ta); " "; GUI_CAN_REDO(ta)
GUI_UNDO_CLEAR(ta)
PRINT "vergessen "; GUI_CAN_UNDO(ta); " "; GUI_UNDO(ta); " "; GUI_TEXT(ta)
--- umgebung
DHRT_FRAMES=2
--- erwartet
frisch FALSE FALSE FALSE
eingefuegt abcdef TRUE FALSE
zurueck TRUE abc FALSE TRUE
vor TRUE abcdef FALSE
vergessen FALSE FALSE abcdef

=== nur textfeld und textbereich haben einen verlauf
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM k AS GUI_WIDGET : k = GUI_BUTTON(w, "OK", 10, 10, 80, 26)
PRINT GUI_CAN_UNDO(k)
--- umgebung
DHRT_FRAMES=2
--- fehler
GUI_CAN_UNDO: nur ein Textfeld oder Textbereich hat einen Verlauf

=== das thema system folgt einem hellen system mit eigenem akzent
' DHRT_SYSTEM_DUNKEL/DHRT_SYSTEM_AKZENT legen die Antwort des Systems fest.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
PRINT "dunkel "; GUI_SYSTEM_DARK(); " akzent "; HEX$(GUI_SYSTEM_ACCENT())
GUI_THEME_PRESET("system")
PRINT "grund "; HEX$(GUI_THEME_GET("widget_bg")); " akzent "; HEX$(GUI_THEME_GET("accent")); " rund "; GUI_METRIC_GET("corner_radius") > 0
--- umgebung
DHRT_FRAMES=2
DHRT_SYSTEM_DUNKEL=0
DHRT_SYSTEM_AKZENT=#FF8800
--- erwartet
dunkel FALSE akzent FF8800
grund FFFFFF akzent FF8800 rund TRUE

=== das thema system folgt einem dunklen system ohne bekannten akzent
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
PRINT "dunkel "; GUI_SYSTEM_DARK(); " akzent "; GUI_SYSTEM_ACCENT()
GUI_THEME_PRESET("system")
PRINT "grund "; HEX$(GUI_THEME_GET("widget_bg")); " akzent "; HEX$(GUI_THEME_GET("accent"))
--- umgebung
DHRT_FRAMES=2
DHRT_SYSTEM_DUNKEL=1
DHRT_SYSTEM_AKZENT=-
--- erwartet
dunkel TRUE akzent -1
grund 2A3542 akzent 2BC4E8

=== die echte abfrage des systems laeuft ohne fehler
' Was das System antwortet, haengt von der Maschine ab -- geprueft wird,
' dass die Abfrage gelingt und eine Farbe in Ordnung ist.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM d AS BOOLEAN : d = GUI_SYSTEM_DARK()
DIM a AS INTEGER : a = GUI_SYSTEM_ACCENT()
PRINT "akzent gueltig "; a >= -1 AND a <= &HFFFFFF
GUI_THEME_PRESET("system")
' Unbekannt heisst fuer das Preset dunkel, fuer GUI_SYSTEM_DARK aber FALSE.
DIM g AS INTEGER : g = GUI_THEME_GET("widget_bg")
PRINT "passt "; IIF(d, g = &H2A3542, g = &H2A3542 OR g = &HFFFFFF)
--- umgebung
DHRT_FRAMES=2
--- erwartet
akzent gueltig TRUE
passt TRUE
