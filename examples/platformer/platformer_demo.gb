' Plattformer-Demo (Twilight-Sprites) (32x32) -- zeigt die mit examples/platformer/make_sprites.py
' gebauten Sprites + Tiles in Aktion:
'   * Held (player.png) laeuft (Pfeile), springt (Leer/Hoch), duckt (Runter), Flip
'   * Walker (walker.png) patrouilliert und laesst sich per Stomp plattmachen
'   * Level aus dem Master-Atlas sheet.json: Boden, Roehre, Item-Boxen, Wasser,
'     animierte Muenzen, Wolken/Busch/Huegel
' Voraussetzung: erst `py examples/platformer/make_sprites.py` ausfuehren.
IMPORT "sprite"

CONST TS AS INTEGER = 32
CONST W AS INTEGER = 384
CONST H AS INTEGER = 288
CONST GROUND AS FLOAT = 192.0          ' Sprite-Oberkante der Figuren am Boden
SCREEN(W, H, "Plattformer 32x32 (Pfeile/Leer, ESC)", 2)

' --- Level-Atlas (Master-Spritesheet) ---
DIM atlas AS SPRITE_ATLAS
atlas = ATLAS_LOAD("sheet.json")

' --- Held ---
DIM hsheet AS IMAGE
hsheet = LOADIMAGE("player.png")
DIM hero AS SPRITE
hero = SPRITE_NEW(hsheet, TS, TS)
SPRITE_ADD_ANIM(hero, "idle", 0, 0, 1.0)
SPRITE_ADD_ANIM(hero, "run",  1, 3, 12.0)
SPRITE_ADD_ANIM(hero, "jump", 4, 4, 1.0)
SPRITE_ADD_ANIM(hero, "duck", 6, 6, 1.0)
SPRITE_PLAY(hero, "idle")
DIM hx AS FLOAT
DIM hy AS FLOAT
DIM hvy AS FLOAT
DIM on_ground AS BOOLEAN
DIM face_left AS BOOLEAN
hx = 48.0
hy = GROUND
hvy = 0.0
on_ground = TRUE
face_left = FALSE

' --- Walker ---
DIM gsheet AS IMAGE
gsheet = LOADIMAGE("walker.png")
DIM goo AS SPRITE
goo = SPRITE_NEW(gsheet, TS, TS)
SPRITE_ADD_ANIM(goo, "walk", 0, 1, 6.0)
SPRITE_ADD_ANIM(goo, "squash", 2, 2, 1.0)
SPRITE_PLAY(goo, "walk")
DIM gx AS FLOAT
DIM gdir AS FLOAT
DIM g_dead AS INTEGER
gx = 220.0
gdir = -1.0
g_dead = 0

DIM coinf AS INTEGER
coinf = 0
DIM t AS FLOAT
t = 0.0
DIM last_ms AS INTEGER
last_ms = MILLIS()

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    DIM now_ms AS INTEGER
    now_ms = MILLIS()
    DIM dt AS INTEGER
    dt = now_ms - last_ms
    last_ms = now_ms
    IF dt > 60 THEN dt = 60
    DIM dts AS FLOAT
    dts = dt / 1000.0
    t = t + dts

    ' --- Eingabe + Physik Held ---
    DIM vx AS FLOAT
    DIM ducking AS BOOLEAN
    vx = 0.0
    ducking = FALSE
    IF KEYPRESSED(1073741904) THEN
        vx = -100.0
        face_left = TRUE
    END IF
    IF KEYPRESSED(1073741903) THEN
        vx = 100.0
        face_left = FALSE
    END IF
    IF on_ground AND KEYPRESSED(1073741905) THEN
        ducking = TRUE
        vx = 0.0
    END IF
    IF on_ground AND (KEYPRESSED(32) OR KEYPRESSED(1073741906)) AND NOT ducking THEN
        hvy = -300.0
        on_ground = FALSE
    END IF
    hvy = hvy + 800.0 * dts
    hx = hx + vx * dts
    hy = hy + hvy * dts
    IF hx < 0.0 THEN hx = 0.0
    IF hx > W - TS THEN hx = W - TS
    IF hy >= GROUND THEN
        hy = GROUND
        hvy = 0.0
        on_ground = TRUE
    END IF

    SPRITE_SET_FLIP(hero, face_left, FALSE)
    IF NOT on_ground THEN
        SPRITE_PLAY(hero, "jump")
    ELSEIF ducking THEN
        SPRITE_PLAY(hero, "duck")
    ELSEIF vx <> 0.0 THEN
        SPRITE_PLAY(hero, "run")
    ELSE
        SPRITE_PLAY(hero, "idle")
    END IF
    SPRITE_SET_POS(hero, hx, hy)
    SPRITE_UPDATE(hero, dt)

    ' --- Walker ---
    IF g_dead = 0 THEN
        gx = gx + gdir * 36.0 * dts
        IF gx < 96.0 THEN gdir = 1.0
        IF gx > 300.0 THEN gdir = -1.0
        SPRITE_SET_FLIP(goo, gdir > 0.0, FALSE)
        IF hvy > 0.0 AND SPRITE_COLLIDES(hero, goo) THEN
            SPRITE_PLAY(goo, "squash")
            g_dead = 700
            hvy = -220.0
        END IF
    ELSE
        g_dead = g_dead - dt
    END IF
    SPRITE_SET_POS(goo, gx, GROUND)
    SPRITE_UPDATE(goo, dt)

    ' --- Muenz-Animation ---
    coinf = INT(t * 10.0) MOD 4

    ' =================== Zeichnen ===================
    CLS(RGB(104, 168, 252))                 ' Himmel
    ' Deko-Hintergrund
    ATLAS_DRAW(atlas, "cloud", 40, 30)
    ATLAS_DRAW(atlas, "cloud", 250, 50)
    ATLAS_DRAW(atlas, "hill", 150, GROUND - 8)
    ATLAS_DRAW(atlas, "bush", 70, GROUND + 8)
    ATLAS_DRAW(atlas, "bush", 300, GROUND + 8)

    ' Boden (zwei Reihen)
    DIM bx AS INTEGER
    FOR bx = 0 TO W STEP TS
        ATLAS_DRAW(atlas, "ground", bx, 224)
        ATLAS_DRAW(atlas, "ground", bx, 256)
    NEXT

    ' Schwebende Bloecke: Brick, ?-Block, Brick
    ATLAS_DRAW(atlas, "brick", 96, 120)
    ATLAS_DRAW(atlas, "itembox_q0", 128, 120)
    ATLAS_DRAW(atlas, "brick", 160, 120)

    ' Roehre (2 Tiles breit, 2 hoch) bei x=256
    ATLAS_DRAW(atlas, "tube_tl", 256, 160)
    ATLAS_DRAW(atlas, "tube_tr", 288, 160)
    ATLAS_DRAW(atlas, "tube_bl", 256, 192)
    ATLAS_DRAW(atlas, "tube_br", 288, 192)

    ' Wasserbecken rechts (auf Bodenhoehe)
    ATLAS_DRAW(atlas, "water_w0", 352, 224)
    ATLAS_DRAW(atlas, "water_body", 352, 256)

    ' Animierte Muenzen ueber den Bloecken
    DIM cname AS STRING
    cname = "coin_c" + STR$(coinf)
    ATLAS_DRAW(atlas, cname, 100, 80)
    ATLAS_DRAW(atlas, cname, 196, 80)

    ' Figuren
    IF g_dead = 0 OR g_dead > 0 THEN SPRITE_DRAW(goo)
    SPRITE_DRAW(hero)

    TEXT(4, 4, "Pfeile / Leer", RGB(255, 255, 255))
    FLIP()
    SLEEP(16)
WEND
