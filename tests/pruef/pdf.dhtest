PDF_FONT(p, "hausschrift", 12)
PRINT PDF_TEXT_WIDTH(p, "Rechnung") > 0
PDF_TEXT(p, 20, 25, "Rechnung")
PDF_SAVE(p, "a.pdf")
PRINT FILEEXISTS("a.pdf")
--- system windows
