SET_WINDOW_POS(-3000, -3000)

--- ersetzen DIM neuOffen
GUI_WINDOW_CHROME(winNeu, FALSE)
GUI_WINDOW_SET_BOUNDS(winNeu, 100, 100, 300, 170)
DIM neuOffen

--- ersetzen FILE_SAVE_DIALOG("Sichern", "sprite.dhsprite", "dhsprite")
"r.dhsprite"

--- ersetzen FILE_OPEN_DIALOG("Oeffnen", "dhsprite,png")
"r.dhsprite"

--- einschub nach FLIP()
prBild = prBild + 1
IF prBild = 3 THEN prFall()
IF prStart >= 0 THEN prProbe(prBild - prStart)

