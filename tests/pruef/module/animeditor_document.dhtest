      "loop": true,
      "first": 1,
      "last": 1,
      "fps": 8.0,
      "x": 320,
      "y": 120
    },
    {
      "name": "jump",
      "anim": "jump",
      "loop": false,
      "first": 0,
      "last": 3,
      "fps": 14.0,
      "x": 200,
      "y": 30
    }
  ],
