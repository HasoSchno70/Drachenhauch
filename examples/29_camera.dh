' Camera/Viewport: Logik-Test ohne Grafik-Fenster.
' Testet CAMERA_SET, CAMERA_RESET, CAMERA_FOLLOW, S2W-Konvertierung.
IMPORT "camera"

PRINT "=== Default-Camera ==="
PRINT "x:", CAMERA_X()
PRINT "y:", CAMERA_Y()
PRINT "zoom:", CAMERA_ZOOM()

PRINT ""
PRINT "=== CAMERA_SET(100, 200, 2.0) ==="
CAMERA_SET(100.0, 200.0, 2.0)
PRINT "x:", CAMERA_X()
PRINT "y:", CAMERA_Y()
PRINT "zoom:", CAMERA_ZOOM()

PRINT ""
PRINT "=== Screen -> World mit zoom=2 ==="
PRINT "Screen 0 -> World x:", CAMERA_S2W_X(0.0), " (erwartet 100.0)"
PRINT "Screen 200 -> World x:", CAMERA_S2W_X(200.0), " (erwartet 200.0)"
PRINT "Screen 0 -> World y:", CAMERA_S2W_Y(0.0), " (erwartet 200.0)"

PRINT ""
PRINT "=== CAMERA_FOLLOW(target=500,500, screen=200x200) bei zoom=2 ==="
CAMERA_FOLLOW(500.0, 500.0, 200.0, 200.0)
PRINT "x:", CAMERA_X(), " (erwartet 450.0 - sw/zoom/2 = 50 unter target)"
PRINT "y:", CAMERA_Y(), " (erwartet 450.0)"
PRINT "zoom unveraendert:", CAMERA_ZOOM()

PRINT ""
PRINT "=== CAMERA_RESET ==="
CAMERA_RESET()
PRINT "x:", CAMERA_X(), "  y:", CAMERA_Y(), "  zoom:", CAMERA_ZOOM()

PRINT ""
PRINT "=== Fehlerfall: zoom <= 0 ==="
TRY
    CAMERA_SET(0.0, 0.0, -1.0)
CATCH e
    PRINT "Erwarteter Fehler: ", e
END TRY

PRINT ""
PRINT "=== Rotation (um Bildschirm-Mitte, 200x200 -> Pivot 100,100) ==="
SCREEN(200, 200, "Camera-Rotation-Test")
CAMERA_RESET()
PRINT "Startwert:", CAMERA_ROTATION(), " (erwartet 0.0)"

CAMERA_SET_ROTATION(90.0)
PRINT "nach SET_ROTATION(90):", CAMERA_ROTATION()
' Weltpunkt (50,0) landet bei Rotation=90 auf Screen (0,150) -- die
' Ein-Argument-Form von S2W_X/Y ignoriert Rotation (Abwaertskompatibel);
' die korrekte Umkehrung braucht BEIDE Screen-Koordinaten. ROUND() nur fuers
' Beispiel (SIN/COS von 90 Grad liefert intern ein Float-Epsilon statt exakt
' 0.0 -- reine Anzeigesache, keine Ungenauigkeit im Feature selbst).
PRINT "S2W_X(0,150):", ROUND(CAMERA_S2W_X(0.0, 150.0)), " (erwartet 50)"
PRINT "S2W_Y(150,0):", ROUND(CAMERA_S2W_Y(150.0, 0.0)), " (erwartet 0)"

CAMERA_SET_ROTATION(180.0)
PRINT "S2W_X(200,200):", ROUND(CAMERA_S2W_X(200.0, 200.0)), " (erwartet 0)"
PRINT "S2W_Y(200,200):", ROUND(CAMERA_S2W_Y(200.0, 200.0)), " (erwartet 0)"

' CAMERA_SET(x, y[, zoom[, rotation]]) setzt Rotation optional gleich mit.
CAMERA_SET(0.0, 0.0, 1.0, 45.0)
PRINT "CAMERA_SET(...,45):", CAMERA_ROTATION()

CAMERA_RESET()
PRINT "nach RESET:", CAMERA_ROTATION(), " (erwartet 0.0)"
