=== text und html ergeben zwei teile
IMPORT "smtp"
IMPORT "mime_leser.dh"
DIM m AS SMTP
m = SMTP_NEW()
SMTP_FROM(m, "ich@beispiel.de")
SMTP_TO(m, "du@beispiel.de")
SMTP_SUBJECT(m, "Test")
SMTP_TEXT(m, "Hallo")
SMTP_HTML(m, "<b>Hallo</b>")
DIM n AS STRING : n = SMTP_MESSAGE$(m)
PRINT mimeArt$(n)
DIM t AS ARRAY OF STRING : t = mimeTeile(n)
DIM i AS INTEGER
FOR i = 0 TO LEN(t) - 1
    PRINT mimeArt$(t[i]); " "; BUFFER_TO_STRING$(mimeInhalt(t[i]))
NEXT
