=== ein unbekannter bereich ist ein fehler
IMPORT "gui"
SCREEN(200, 200, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 200, 200)
GUI_DOCK(w, 0, 0, 200, 200)
GUI_DOCK_PANEL(w, "x", "X", "oben")
--- fehler
unbekannter Bereich 'oben'

=== ein name gibt es nur einmal
IMPORT "gui"
SCREEN(200, 200, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 200, 200)
GUI_DOCK(w, 0, 0, 200, 200)
GUI_DOCK_PANEL(w, "x", "X", "links")
GUI_DOCK_PANEL(w, "X", "Noch eins", "unten")
--- fehler
eine Leiste 'X' gibt es schon

=== ohne dock sagt die meldung, was fehlt
IMPORT "gui"
SCREEN(200, 200, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 200, 200)
GUI_DOCK_PANEL(w, "x", "X", "links")
--- fehler
das Fenster hat kein Dock -- erst GUI_DOCK(win, x, y, w, h)

=== eine leiste, die es nicht gibt, nennt die vorhandenen
IMPORT "gui"
SCREEN(200, 200, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 200, 200)
GUI_DOCK(w, 0, 0, 200, 200)
GUI_DOCK_PANEL(w, "eins", "Eins", "links")
PRINT GUI_DOCK_SHOWN(w, "zwei")
--- fehler
keine Leiste 'zwei' im Dock (da sind: eins)
