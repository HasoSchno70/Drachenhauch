' Baum bedienen wie eine Liste (2026-09-23): Doppelklick und Enter melden
' GUI_DOUBLE_CLICKED, F2 benennt um, Tippen springt, Pos1/Ende/Bild,
' Rechtsklick waehlt, Rollbalken, weiches Rad, Leer-Hinweis.
' Baum bei (10, 10, 280, 200), Zeilen 22 hoch: Zeile r liegt bei
' y 11 + 22 r .. + 21. Getippt wird ueber die Zwischenablage (die Wiedergabe
' speist keine Zeichen ein) -- darum seriell.
' Tasten: F2 291, Enter 257, ESC 256, Strg 341, V 86, B 66, Pos1 268, Ende 269.
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

=== ein doppelklick auf ein blatt meldet und waehlt
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 280, 200)
DIM r AS INTEGER : r = GUI_TREE_ADD(t, -1, "Obst")
GUI_TREE_ADD(t, r, "Apfel") : GUI_TREE_ADD(t, r, "Birne")
GUI_TREE_EXPAND(t, r, TRUE)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_DOUBLE_CLICKED(t) THEN PRINT "doppel "; GUI_TREE_LABEL(t, GUI_TREE_SELECTED(t))
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 6
e 0 7 5 215 0 0
e 1 7 120 44 0 0
e 2 6 0 0 0 0
e 3 5 0 0 0 0
e 4 6 0 0 0 0
e 5 5 0 0 0 0

--- umgebung
DHRT_FRAMES=10
--- erwartet
doppel Apfel

=== enter auf einem blatt meldet, auf einem ast klappt es
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 280, 200)
DIM r AS INTEGER : r = GUI_TREE_ADD(t, -1, "Obst")
DIM a AS INTEGER : a = GUI_TREE_ADD(t, r, "Apfel")
GUI_TREE_EXPAND(t, r, TRUE)
GUI_TREE_SET_SELECTED(t, r)
GUI_FOCUS(t)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    IF bild = 6 THEN GUI_TREE_SET_SELECTED(t, a)
    GUI_UPDATE()
    IF GUI_DOUBLE_CLICKED(t) THEN PRINT "doppel "; GUI_TREE_LABEL(t, GUI_TREE_SELECTED(t))
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
