=== palette lesen: rundweg, schon da, fremdes symbol, keine palette
IMPORT "helfer.dh"
' Die exportierte Palette in ein leeres Muster: dieselben Garne, Farben und
' Symbole; ein Schritt, Rueckgaengig nimmt alles
DIM quelle AS kern.Muster : quelle = kern.pxsLaden("farbprobe.pxs")
DIM text AS STRING : text = kern.paletteDateiText$(quelle)
DIM sy AS ARRAY OF STRING : sy = kern.symboleLaden(GLUTORDNER + "/daten/symbole.txt")
DIM m AS kern.Muster : m = kern.neuesMuster("Leer", 10, 10)
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
PRINT "gelesen: "; kern.paletteImportieren(m, v, text, sy); " | farben "; m.farbanzahl(); " | schritte "; LEN(v.rueck); " '"; v.textZurueck$(); "'"
DIM i AS INTEGER, gleich AS BOOLEAN : gleich = m.farbanzahl() = quelle.farbanzahl()
FOR i = 0 TO MIN(m.farbanzahl(), quelle.farbanzahl()) - 1
    DIM a AS kern.Farbeintrag : a = m.farben[i]
    DIM b AS kern.Farbeintrag : b = quelle.farben[i]
    IF a.garn.name <> b.garn.name OR a.garn.farbe <> b.garn.farbe OR a.garn.hersteller <> b.garn.hersteller OR a.garn.nummer <> b.garn.nummer OR a.symbol <> b.symbol THEN gleich = FALSE
NEXT
PRINT "wie die quelle: "; gleich; " | wieder geschrieben gleich "; kern.paletteDateiText$(m) = REPLACE$(text, CHR$(34) + quelle.name + CHR$(34), CHR$(34) + "Leer" + CHR$(34))
DIM ok AS BOOLEAN : ok = v.zurueckNehmen(m)
PRINT "zurueck: farben "; m.farbanzahl()
' Noch einmal in ein Muster, das sie schon hat: nichts Neues, kein Schritt
ok = v.wiederholen(m)
DIM n0 AS INTEGER : n0 = LEN(v.rueck)
PRINT "schon da: "; kern.paletteImportieren(m, v, text, sy); " gelesen | farben "; m.farbanzahl(); " | neue schritte "; LEN(v.rueck) - n0
' Ein Symbol, das eine andere Farbe traegt, kommt nicht (PySticky setzte es)
DIM q AS STRING : q = "{" + CHR$(34) + "format" + CHR$(34) + ":" + CHR$(34) + "pysticky_palette" + CHR$(34) + "," + CHR$(34) + "colors" + CHR$(34) + ":[{" + CHR$(34) + "name" + CHR$(34) + ":" + CHR$(34) + "Neu" + CHR$(34) + "," + CHR$(34) + "color" + CHR$(34) + ":{" + CHR$(34) + "r" + CHR$(34) + ":1," + CHR$(34) + "g" + CHR$(34) + ":2," + CHR$(34) + "b" + CHR$(34) + ":3}," + CHR$(34) + "symbol" + CHR$(34) + ":" + CHR$(34) + m.farben[0].symbol + CHR$(34) + "}]}"
PRINT "fremdes symbol: "; kern.paletteImportieren(m, v, q, sy); " | neu "; m.farben[m.farbanzahl() - 1].garn.name; " "; HEX$(m.farben[m.farbanzahl() - 1].garn.farbe); " symbol anders "; m.farben[m.farbanzahl() - 1].symbol <> m.farben[0].symbol
' Was fehlt, nimmt die Vorgabe des Originals: Name Unbekannt, Farbe 128
q = "{" + CHR$(34) + "format" + CHR$(34) + ":" + CHR$(34) + "pysticky_palette" + CHR$(34) + "," + CHR$(34) + "colors" + CHR$(34) + ":[{}]}"
PRINT "leerer eintrag: "; kern.paletteImportieren(m, v, q, sy); " | "; m.farben[m.farbanzahl() - 1].garn.name; " "; HEX$(m.farben[m.farbanzahl() - 1].garn.farbe)
' Was keine Palette ist
DIM t AS STRING
FOR EACH t IN ["kein json", "[1, 2]", "{" + CHR$(34) + "format" + CHR$(34) + ":" + CHR$(34) + "andere" + CHR$(34) + "}", "{" + CHR$(34) + "format" + CHR$(34) + ":" + CHR$(34) + "pysticky_palette" + CHR$(34) + "," + CHR$(34) + "colors" + CHR$(34) + ":[]}", "{" + CHR$(34) + "format" + CHR$(34) + ":" + CHR$(34) + "pysticky_palette" + CHR$(34) + "}"]
    TRY
        PRINT "angenommen?? "; kern.paletteImportieren(m, v, t, sy)
    CATCH f
        PRINT "abgewiesen: "; LEFT$(f, 52)
    END TRY
NEXT
