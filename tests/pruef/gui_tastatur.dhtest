=== grenze haelt die taste auf
' Eine gesperrte Richtung darf die Marke nicht hinausschieben.
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM dp AS GUI_WIDGET
dp = GUI_DATEPICKER(w, 10, 10, 300, 200)
GUI_SET_DATE(dp, "2026-09-25")
GUI_DATE_RANGE(dp, "2026-09-05", "2026-09-25")
GUI_FOCUS(dp)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

PRINT GUI_DATE(dp)
--- datei ev.txt
# Test-Aufnahme
c 2
e 2 2 262 0 0 0 // Event: test
e 3 1 262 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
2026-09-25

