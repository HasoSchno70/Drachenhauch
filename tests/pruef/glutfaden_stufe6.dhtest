=== pat: fremde und kaputte dateien
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = ["A", "B", "C", "D"]
DIM fa AS STRING : fa = phFarbe$("DMC", "310", "black", &H000000, ASC("X"))
fa = fa + phFarbe$("Foo", "9999", "Testgarn", &H0C2238, &H8A)
fa = fa + phFarbe$("DMC", "5200", "snow white", &HE6E6E6, ASC("X"))

SUB versuch(name AS STRING, b AS BUFFER)
    WRITEALL_BYTES("x.pat", b)
    TRY
        DIM imp AS kern.PatImport : imp = kern.patLaden("x.pat", pal, sym)
        PRINT name; ": gelesen"
    CATCH e
        PRINT name; ": "; e
    END TRY
END SUB
DIM gi AS STRING : gi = phLauf$(1, 1, phStich$(0, 0, 5, 0, 1))
DIM gut AS BUFFER : gut = phDatei("8", 1, 1, 14, "", "T", "", 3, fa, gi, 0, "", "")
versuch("gut", gut)
versuch("kennung", BUFFER_FROM_STRING("PAT" + " " * 100))
versuch("fassung 9", phDatei("9", 1, 1, 14, "", "T", "", 3, fa, gi, 0, "", ""))
versuch("abgeschnitten", BUFFER_SLICE(gut, 0, BUFFER_LEN(gut) - 10))
versuch("zu lauf", phDatei("8", 1, 1, 14, "", "T", "", 3, fa, phLauf$(2, 1, phStich$(0, 0, 5, 0, 1)), 0, "", ""))
versuch("zu gross", phDatei("8", 2001, 1, 14, "", "T", "", 3, fa, gi, 0, "", ""))
versuch("farbe kaputt", BUFFER_FROM_HEX(REPLACE$(UPPER$(BUFFER_TO_HEX$(gut)), "FFFFFFFF020000000200000002000000020000000200000002000000FFFFFFFF02000000", "EEFFFFFF020000000200000002000000020000000200000002000000FFFFFFFF02000000")))
versuch("fehlt", BUFFER_FROM_STRING(""))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_pat.dh"
--- erwartet
gut: gelesen
kennung: PAT: keine PCStitch-Datei (die Kennung 'PCStitch' fehlt)
fassung 9: PAT: PCStitch 9 wird noch nicht gelesen (bekannt ist PCStitch 8)
abgeschnitten: PAT: Datei endet vorzeitig (bei Byte 2218)
zu lauf: PAT: kaputter Lauf im Gitter bei Byte 2204
zu gross: PAT: Muster zu groß: 2001x1 (höchstens 2000)
farbe kaputt: PAT: unbekannter Aufbau der Farbe 1 (DMC 310)
fehlt: PAT: keine PCStitch-Datei (die Kennung 'PCStitch' fehlt)
