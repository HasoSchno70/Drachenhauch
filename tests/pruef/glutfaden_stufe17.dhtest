=== grenzen der texte, stoff und fortschritt als schritte
IMPORT "helfer.dh"
' Grenzen der Texte, die die Aufzeichnung nicht trifft
PRINT "zeit: "; kern.stickzeitText$(0, "stitch"); " | "; kern.stickzeitText$(2, "stitch"); " | "; kern.stickzeitText$(3, "stitch"); " | "; kern.stickzeitText$(180, "stitch"); " | "; kern.stickzeitText$(17999, "stitch"); " | "; kern.stickzeitText$(18000, "stitch"); " | diamond "; kern.stickzeitText$(19, "diamond"); " "; kern.stickzeitText$(20, "diamond")
PRINT "je farbe: "; kern.garnJeFarbeText$(0, 14, "stitch"); "|"; kern.garnJeFarbeText$(17, 14, "stitch"); "|"; kern.garnJeFarbeText$(18, 14, "stitch"); "|"; kern.garnJeFarbeText$(174, 14, "stitch"); "|"; kern.garnJeFarbeText$(2000, 14, "diamond")
' Gezaehlt werden die Stichzahlen der Farbliste (ohne ausgelassene)
DIM m AS kern.Muster : m = kern.pxsLaden("alle.pxs")
DIM fe AS kern.Farbeintrag
FOR EACH fe IN m.farben
    fe.stichzahl = 0
NEXT
m.farben[0].stichzahl = 2000
PRINT "garn: "; kern.garnbedarfText$(m, "stitch"); " | "; kern.garnbedarfText$(m, "diamond")
m.farben[0].stichzahl = 174
PRINT "garn: "; kern.garnbedarfText$(m, "stitch")
m.farben[0].stichzahl = 1739
PRINT "garn: "; kern.garnbedarfText$(m, "stitch")
m.farben[0].auslassen = TRUE
PRINT "nur ausgelassene: "; kern.garnbedarfText$(m, "stitch"); " | zeit "; kern.infoKarten(m, "stitch")[5]
' Stoff und Fortschritt zuruecksetzen sind Schritte
DIM p AS kern.Muster : p = kern.pxsLaden("alle.pxs")
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
PRINT "stoff 14: "; kern.stoffSetzen(p, v, 14); " | 0: "; kern.stoffSetzen(p, v, 0); " | 18: "; kern.stoffSetzen(p, v, 18); " "; p.stoff; " '"; v.textZurueck$(); "'"
DIM ok AS BOOLEAN : ok = v.zurueckNehmen(p)
PRINT "zurueck: "; p.stoff; " | vor: "; v.wiederholen(p); " "; p.stoff
DIM f0 AS kern.Fortschritt : f0 = kern.fortschrittVon(p)
PRINT "erledigt "; f0.erledigt; " -> zurueckgesetzt "; kern.fortschrittZuruecksetzen(p, v); " '"; v.textZurueck$(); "' -> "; kern.fortschrittVon(p).erledigt; " | nochmal "; kern.fortschrittZuruecksetzen(p, v); " schritte "; LEN(v.rueck)
ok = v.zurueckNehmen(p)
PRINT "zurueck: "; kern.fortschrittVon(p).erledigt; " | je farbe gleich "; JOIN$(kern.fortschrittVon(p).farbeErledigt, ",") = JOIN$(f0.farbeErledigt, ",")
' Auch ausgelassene Farben und unsichtbare Ebenen
p.farben[5].auslassen = TRUE
p.ebenen.ebenen[0].sichtbar = FALSE
PRINT "ausgelassen/unsichtbar: "; kern.fortschrittZuruecksetzen(p, v); " | danach "; JOIN$(kern.fortschrittVon(p).farbeErledigt, ",")
PRINT "symbolnamen: "; LEN(MAPKEYS(kern.symbolnamenLaden(GLUTORDNER + "/daten/symbolnamen.txt"))); " | ohne datei "; LEN(MAPKEYS(kern.symbolnamenLaden("gibt_es_nicht.txt")))
