=== fehler eines spaet gebundenen befehls
IMPORT "json"
DIM h AS JSON_HANDLE
DIM i AS INTEGER
DIM s AS STRING
h = JSON_PARSE("[4, 7]")
TRY
    FOR i = 1 TO 10
        s = s + "."
        IF i = 6 THEN s = s + STR$(JSON_GET_INT(h, "9"))
    NEXT
CATCH e
    PRINT "gefangen: "; e; " zeile "; ERROR_LINE()
END TRY
PRINT s; " "; i
