' Netz-Erkennung -- EINE reine Funktion ueber das Blatt, von allen genutzt
' (Hervorhebung, spaeter ERC/Netzliste). SparkNode-Lehre: nie zwei Quellen.
'
' Regeln: alle Punkte aufs RASTER quantisiert. Zwei Drahtecken eines Drahtes
' sind verbunden (Segment). Ein Drahtende/Pin auf einem fremden Segment =
' T-Verbindung (verbunden). Reine Kreuzung ohne gemeinsamen Punkt = NICHT
' verbunden. Ein Knoten entsteht automatisch, wo >=3 Enden treffen oder ein
' Ende auf einem Segment liegt.
'
' Namen: gleichnamige Labels UND gleichnamige Versorgungssymbole (GND, VCC,
' +5V ...) sind jeweils EIN Netz, auch ohne Draht; ein Label "VCC" gehoert
' zum Netz des VCC-Symbols. Der Netzname kommt von der Versorgung, sonst vom
' Label, sonst automatisch (N1, N2 ...).

' Ein Pin in einem Netz (fuer Netzliste und ERC)
CLASS NetzPin
    DIM bauteil AS INTEGER            ' Index in blatt.bauteile
    DIM pin AS INTEGER                ' Index in sym.pins
    DIM ref AS STRING
    DIM nummer AS STRING
    DIM pinName AS STRING
    DIM typ AS INTEGER
    DIM versorgung AS BOOLEAN         ' Pin eines Versorgungssymbols, kein echtes Bauteil
    DIM x AS INTEGER
    DIM y AS INTEGER
END CLASS

CLASS Netz
    DIM name AS STRING
    DIM automatisch AS BOOLEAN
    DIM pins AS ARRAY OF NetzPin
    DIM labelNamen AS ARRAY OF STRING ' verschiedene Label-Texte an diesem Netz
    DIM versorgungen AS ARRAY OF STRING
    SUB Init()
        pins = []
        labelNamen = []
        versorgungen = []
    END SUB
    SUB labelDazu(t AS STRING)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(labelNamen) - 1
            IF labelNamen[i] = t THEN RETURN
        NEXT
        ARRAY_PUSH(labelNamen, t)
    END SUB
    SUB versorgungDazu(t AS STRING)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(versorgungen) - 1
            IF versorgungen[i] = t THEN RETURN
        NEXT
        ARRAY_PUSH(versorgungen, t)
    END SUB
    ' Pins echter Bauteile (ohne Versorgungssymbole)
    FUNCTION echtePins() AS INTEGER
        DIM c AS INTEGER : c = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(pins) - 1
            IF NOT pins[i].versorgung THEN c = c + 1
        NEXT
        RETURN c
    END FUNCTION
END CLASS

' Der Netzname, den ein Versorgungssymbol stiftet: sein Wert (VCC, +5V),
' sonst die Symbol-Id (GND).
FUNCTION versorgungsName(b AS Bauteil) AS STRING
    IF b.wert <> "" THEN RETURN b.wert
    RETURN b.sym.id
END FUNCTION

FUNCTION netzKey(x AS INTEGER, y AS INTEGER) AS STRING
    RETURN STR$(rastern(x, RASTER)) + ":" + STR$(rastern(y, RASTER))
END FUNCTION

' Liegt q (quantisiert) echt INNEN auf der Strecke a..b (ohne die Enden)?
FUNCTION aufSegment(ax AS INTEGER, ay AS INTEGER, bx AS INTEGER, by AS INTEGER, qx AS INTEGER, qy AS INTEGER) AS BOOLEAN
    IF (qx = ax AND qy = ay) OR (qx = bx AND qy = by) THEN RETURN FALSE
    DIM kreuz AS INTEGER : kreuz = (bx - ax) * (qy - ay) - (by - ay) * (qx - ax)
    IF kreuz <> 0 THEN RETURN FALSE
    IF qx < MIN(ax, bx) OR qx > MAX(ax, bx) THEN RETURN FALSE
    IF qy < MIN(ay, by) OR qy > MAX(ay, by) THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

CLASS Netze
    DIM idx AS MAP OF INTEGER         ' key -> Index
    DIM schluessel AS ARRAY OF STRING
    DIM eltern AS ARRAY OF INTEGER
    DIM liste AS ARRAY OF Netz        ' die benannten Netze (nach benennen())
    DIM wurzelZuNetz AS MAP OF INTEGER

    SUB Init()
        idx = {}
        schluessel = []
        eltern = []
        liste = []
        wurzelZuNetz = {}
    END SUB

    ' Das Netz zu einer Wurzel, bei Bedarf neu angelegt.
    FUNCTION netzFuerWurzel(r AS INTEGER) AS INTEGER
        DIM k AS STRING : k = STR$(r)
        IF MAPHAS(wurzelZuNetz, k) THEN RETURN MAPGET(wurzelZuNetz, k)
        DIM i AS INTEGER : i = LEN(liste)
        ARRAY_PUSH(liste, NEW Netz())
        MAPPUT(wurzelZuNetz, k, i)
        RETURN i
    END FUNCTION

    ' Index des benannten Netzes an einem Blattpunkt, -1 wenn keins (etwa ein
    ' Draht ohne Pin und Label).
    FUNCTION netzAn(x AS INTEGER, y AS INTEGER) AS INTEGER
        DIM k AS STRING : k = netzKey(x, y)
        IF NOT MAPHAS(idx, k) THEN RETURN -1
        DIM w AS STRING : w = STR$(wurzel(MAPGET(idx, k)))
        IF NOT MAPHAS(wurzelZuNetz, w) THEN RETURN -1
        RETURN MAPGET(wurzelZuNetz, w)
    END FUNCTION

    ' Wurzel eines Blattpunkts, -1 wenn der Punkt nicht vorkommt.
    FUNCTION wurzelAn(x AS INTEGER, y AS INTEGER) AS INTEGER
        DIM k AS STRING : k = netzKey(x, y)
        IF NOT MAPHAS(idx, k) THEN RETURN -1
        RETURN wurzel(MAPGET(idx, k))
    END FUNCTION

    FUNCTION punkt(x AS INTEGER, y AS INTEGER) AS INTEGER
        DIM k AS STRING : k = netzKey(x, y)
        IF MAPHAS(idx, k) THEN RETURN MAPGET(idx, k)
        DIM i AS INTEGER : i = LEN(schluessel)
        ARRAY_PUSH(schluessel, k)
        ARRAY_PUSH(eltern, i)
        MAPPUT(idx, k, i)
        RETURN i
    END FUNCTION

    FUNCTION wurzel(i AS INTEGER) AS INTEGER
        WHILE eltern[i] <> i
            eltern[i] = eltern[eltern[i]]
            i = eltern[i]
        WEND
        RETURN i
    END FUNCTION

    SUB eins(a AS INTEGER, b AS INTEGER)
        DIM ra AS INTEGER : ra = wurzel(a)
        DIM rb AS INTEGER : rb = wurzel(b)
        IF ra <> rb THEN eltern[rb] = ra
    END SUB

    ' Gehoeren zwei Blattpunkte zum selben Netz?
    FUNCTION gleich(ax AS INTEGER, ay AS INTEGER, bx AS INTEGER, by AS INTEGER) AS BOOLEAN
        DIM ka AS STRING : ka = netzKey(ax, ay)
        DIM kb AS STRING : kb = netzKey(bx, by)
        IF NOT MAPHAS(idx, ka) OR NOT MAPHAS(idx, kb) THEN RETURN FALSE
        RETURN wurzel(MAPGET(idx, ka)) = wurzel(MAPGET(idx, kb))
    END FUNCTION
END CLASS

' Alle Punkte verknuepfen und das Ergebnis zurueckgeben.
FUNCTION netzeBerechnen(bl AS Blatt) AS Netze
    DIM n AS Netze : n = NEW Netze()
    DIM w AS Draht, b AS Bauteil, j AS INTEGER, i AS INTEGER
    ' Drahtsegmente verbinden ihre Ecken
    FOR i = 0 TO LEN(bl.draehte) - 1
        w = bl.draehte[i]
        FOR j = 0 TO LEN(w.punkte) - 2
            n.eins(n.punkt(w.punkte[j].x, w.punkte[j].y), n.punkt(w.punkte[j + 1].x, w.punkte[j + 1].y))
        NEXT
    NEXT
    ' Pins als Punkte aufnehmen; Versorgungssymbole verbinden sich ueber den
    ' Namen (in derselben Tabelle wie die Labels).
    DIM ersterMitText AS MAP OF INTEGER
    FOR i = 0 TO LEN(bl.bauteile) - 1
        b = bl.bauteile[i]
        FOR j = 0 TO LEN(b.sym.pins) - 1
            DIM pp AS Punkt : pp = b.pinPunkt(j)
            DIM pidx AS INTEGER : pidx = n.punkt(pp.x, pp.y)
            IF b.sym.einheitLeistung THEN
                DIM vn AS STRING : vn = versorgungsName(b)
                IF MAPHAS(ersterMitText, vn) THEN
                    n.eins(MAPGET(ersterMitText, vn), pidx)
                ELSE
                    MAPPUT(ersterMitText, vn, pidx)
                END IF
            END IF
        NEXT
    NEXT
    ' Labels: der Anker ist ein Netzpunkt; gleichnamige Labels sind EIN Netz.
    FOR i = 0 TO LEN(bl.labels) - 1
        DIM la AS Label : la = bl.labels[i]
        DIM li AS INTEGER : li = n.punkt(la.anker.x, la.anker.y)
        IF MAPHAS(ersterMitText, la.text) THEN
            n.eins(MAPGET(ersterMitText, la.text), li)
        ELSE
            MAPPUT(ersterMitText, la.text, li)
        END IF
    NEXT
    ' T-Verbindungen: jeder Punkt, der innen auf einem Segment liegt, wird mit
    ' dessen Enden verbunden.
    DIM alle AS ARRAY OF STRING : alle = MAPKEYS(n.idx)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(alle) - 1
        DIM teile AS ARRAY OF STRING : teile = SPLIT$(alle[k], ":")
        DIM qx AS INTEGER : qx = VAL(teile[0])
        DIM qy AS INTEGER : qy = VAL(teile[1])
        FOR i = 0 TO LEN(bl.draehte) - 1
            w = bl.draehte[i]
            FOR j = 0 TO LEN(w.punkte) - 2
                IF aufSegment(w.punkte[j].x, w.punkte[j].y, w.punkte[j + 1].x, w.punkte[j + 1].y, qx, qy) THEN
                    n.eins(n.punkt(qx, qy), n.punkt(w.punkte[j].x, w.punkte[j].y))
                END IF
            NEXT
        NEXT
    NEXT
    netzeBenennen(bl, n)
    RETURN n
END FUNCTION

' Die Netze mit Pins, Labels und Namen fuellen.
SUB netzeBenennen(bl AS Blatt, n AS Netze)
    DIM i AS INTEGER, j AS INTEGER, ni AS INTEGER
    FOR i = 0 TO LEN(bl.bauteile) - 1
        DIM b AS Bauteil : b = bl.bauteile[i]
        FOR j = 0 TO LEN(b.sym.pins) - 1
            DIM pp AS Punkt : pp = b.pinPunkt(j)
            ni = n.netzFuerWurzel(n.wurzelAn(pp.x, pp.y))
            DIM np AS NetzPin : np = NEW NetzPin()
            np.bauteil = i
            np.pin = j
            np.ref = b.referenz
            np.nummer = b.sym.pins[j].nummer
            np.pinName = b.sym.pins[j].name
            np.typ = b.sym.pins[j].typ
            np.versorgung = b.sym.einheitLeistung
            np.x = pp.x
            np.y = pp.y
            ARRAY_PUSH(n.liste[ni].pins, np)
            IF b.sym.einheitLeistung THEN n.liste[ni].versorgungDazu(versorgungsName(b))
        NEXT
    NEXT
    FOR i = 0 TO LEN(bl.labels) - 1
        ni = n.netzFuerWurzel(n.wurzelAn(bl.labels[i].anker.x, bl.labels[i].anker.y))
        n.liste[ni].labelDazu(bl.labels[i].text)
    NEXT
    ' Namen: Versorgung > Label > automatisch. Automatische Namen weichen
    ' vergebenen aus (ein Label "N1" bleibt eindeutig).
    DIM vergeben AS MAP OF INTEGER
    FOR i = 0 TO LEN(n.liste) - 1
        DIM nz AS Netz : nz = n.liste[i]
        IF LEN(nz.versorgungen) > 0 THEN
            nz.name = nz.versorgungen[0]
        ELSEIF LEN(nz.labelNamen) > 0 THEN
            nz.name = nz.labelNamen[0]
        END IF
        IF nz.name <> "" THEN MAPPUT(vergeben, nz.name, 1)
    NEXT
    DIM zaehler AS INTEGER : zaehler = 0
    FOR i = 0 TO LEN(n.liste) - 1
        IF n.liste[i].name = "" THEN
            zaehler = zaehler + 1
            DIM kandidat AS STRING : kandidat = "N" + STR$(zaehler)
            WHILE MAPHAS(vergeben, kandidat)
                zaehler = zaehler + 1
                kandidat = "N" + STR$(zaehler)
            WEND
            n.liste[i].name = kandidat
            n.liste[i].automatisch = TRUE
            MAPPUT(vergeben, kandidat, 1)
        END IF
    NEXT
END SUB

' Wie oft endet ein Draht genau an diesem Blattpunkt?
FUNCTION endenAn(bl AS Blatt, x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM c AS INTEGER : c = 0
    DIM w AS Draht, i AS INTEGER, j AS INTEGER
    FOR i = 0 TO LEN(bl.draehte) - 1
        w = bl.draehte[i]
        FOR j = 0 TO LEN(w.punkte) - 1
            IF rastern(w.punkte[j].x, RASTER) = rastern(x, RASTER) AND rastern(w.punkte[j].y, RASTER) = rastern(y, RASTER) THEN c = c + 1
        NEXT
    NEXT
    RETURN c
END FUNCTION

' Liegt irgendein Drahtende innen auf einem anderen Segment, am Punkt (x,y)?
FUNCTION istTPunkt(bl AS Blatt, x AS INTEGER, y AS INTEGER) AS BOOLEAN
    DIM w AS Draht, i AS INTEGER, j AS INTEGER
    FOR i = 0 TO LEN(bl.draehte) - 1
        w = bl.draehte[i]
        FOR j = 0 TO LEN(w.punkte) - 2
            IF aufSegment(w.punkte[j].x, w.punkte[j].y, w.punkte[j + 1].x, w.punkte[j + 1].y, rastern(x, RASTER), rastern(y, RASTER)) THEN RETURN TRUE
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Einen Draht saeubern: doppelte Ecken weg, Ecken mitten auf einer Geraden
' weg (eine Spitze, die zurueckfuehrt, bleibt). Ein T-Anschluss an einer
' entfernten Ecke bleibt verbunden -- die T-Regel greift auf dem Segment.
SUB drahtAufraeumen(w AS Draht)
    DIM p AS ARRAY OF Punkt : p = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(w.punkte) - 1
        IF LEN(p) = 0 THEN
            ARRAY_PUSH(p, w.punkte[i])
        ELSEIF NOT punktGleich(p[LEN(p) - 1], w.punkte[i]) THEN
            ARRAY_PUSH(p, w.punkte[i])
        END IF
    NEXT
    DIM weiter AS BOOLEAN : weiter = TRUE
    WHILE weiter
        weiter = FALSE
        FOR i = 1 TO LEN(p) - 2
            DIM a AS Punkt : a = p[i - 1]
            DIM m AS Punkt : m = p[i]
            DIM c AS Punkt : c = p[i + 1]
            DIM kreuz AS INTEGER : kreuz = (m.x - a.x) * (c.y - a.y) - (m.y - a.y) * (c.x - a.x)
            IF kreuz = 0 AND m.x >= MIN(a.x, c.x) AND m.x <= MAX(a.x, c.x) AND m.y >= MIN(a.y, c.y) AND m.y <= MAX(a.y, c.y) THEN
                ARRAY_REMOVE_AT(p, i)
                weiter = TRUE
                BREAK
            END IF
        NEXT
    WEND
    w.punkte = p
END SUB

' --- Gummiband: ein Drahtende folgt einem bewegten Pin --------------------
'
' art: 1 = der Anfang folgt, 2 = das Ende folgt, 3 = beide (starr verschieben).
' Damit die Leitung rechtwinklig bleibt: liegt das Endsegment waagrecht und
' der Pin wandert senkrecht, rueckt die Nachbarecke mit, wenn das Segment
' davor senkrecht ist -- sonst entsteht ein Knick. Senkrecht entsprechend.
' Immer ab den Ecken bei Zugbeginn rechnen, nie aufaddieren.

FUNCTION punkteVerschoben(p AS ARRAY OF Punkt, dx AS INTEGER, dy AS INTEGER) AS ARRAY OF Punkt
    DIM r AS ARRAY OF Punkt : r = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(p) - 1
        ARRAY_PUSH(r, NEW Punkt(p[i].x + dx, p[i].y + dy))
    NEXT
    RETURN r
END FUNCTION

FUNCTION gummibandEnde(q AS ARRAY OF Punkt, dx AS INTEGER, dy AS INTEGER) AS ARRAY OF Punkt
    RETURN gummibandEndeModus(q, dx, dy, 0)
END FUNCTION

' modus 0: wie oben beschrieben; 1: den Knick andersherum legen (ohne die
' Nachbarecke zu ruecken); 2: schraeg, nur das Ende versetzen.
FUNCTION gummibandEndeModus(q AS ARRAY OF Punkt, dx AS INTEGER, dy AS INTEGER, modus AS INTEGER) AS ARRAY OF Punkt
    DIM n AS INTEGER : n = LEN(q)
    IF n < 2 THEN RETURN q
    DIM e AS Punkt : e = q[n - 1]
    DIM nb AS Punkt : nb = q[n - 2]
    DIM e2 AS Punkt : e2 = NEW Punkt(e.x + dx, e.y + dy)
    DIM r AS ARRAY OF Punkt : r = []
    DIM i AS INTEGER
    FOR i = 0 TO n - 3
        ARRAY_PUSH(r, q[i])
    NEXT
    IF modus = 2 THEN
        ARRAY_PUSH(r, nb)
    ELSEIF e.y = nb.y AND dy <> 0 THEN
        IF modus = 0 AND n >= 3 AND q[n - 3].x = nb.x THEN
            ARRAY_PUSH(r, NEW Punkt(nb.x, nb.y + dy))
        ELSEIF modus = 0 THEN
            ARRAY_PUSH(r, nb)
            ARRAY_PUSH(r, NEW Punkt(e2.x, nb.y))
        ELSE
            ARRAY_PUSH(r, nb)
            ARRAY_PUSH(r, NEW Punkt(nb.x, e2.y))
        END IF
    ELSEIF e.x = nb.x AND dx <> 0 THEN
        IF modus = 0 AND n >= 3 AND q[n - 3].y = nb.y THEN
            ARRAY_PUSH(r, NEW Punkt(nb.x + dx, nb.y))
        ELSEIF modus = 0 THEN
            ARRAY_PUSH(r, nb)
            ARRAY_PUSH(r, NEW Punkt(nb.x, e2.y))
        ELSE
            ARRAY_PUSH(r, nb)
            ARRAY_PUSH(r, NEW Punkt(e2.x, nb.y))
        END IF
    ELSE
        ARRAY_PUSH(r, nb)
    END IF
    ARRAY_PUSH(r, e2)
    RETURN r
END FUNCTION

FUNCTION gummiband(p AS ARRAY OF Punkt, art AS INTEGER, dx AS INTEGER, dy AS INTEGER) AS ARRAY OF Punkt
    RETURN gummibandModus(p, art, dx, dy, 0)
END FUNCTION

FUNCTION gummibandModus(p AS ARRAY OF Punkt, art AS INTEGER, dx AS INTEGER, dy AS INTEGER, modus AS INTEGER) AS ARRAY OF Punkt
    IF art = 3 THEN RETURN punkteVerschoben(p, dx, dy)
    DIM q AS ARRAY OF Punkt : q = ARRAY_COPY(p)
    IF art = 1 THEN REVERSE(q)
    q = gummibandEndeModus(q, dx, dy, modus)
    IF art = 1 THEN REVERSE(q)
    RETURN q
END FUNCTION

' Liegt p auf der Polylinie (auf einer Ecke oder innen auf einem Segment)?
FUNCTION aufPolylinie(p AS Punkt, q AS ARRAY OF Punkt) AS BOOLEAN
    DIM j AS INTEGER
    FOR j = 0 TO LEN(q) - 1
        IF punktGleich(p, q[j]) THEN RETURN TRUE
        IF j < LEN(q) - 1 THEN
            IF aufSegment(q[j].x, q[j].y, q[j + 1].x, q[j + 1].y, p.x, p.y) THEN RETURN TRUE
        END IF
    NEXT
    RETURN FALSE
END FUNCTION

' Beruehrt der neue Verlauf q des Drahtes w etwas NEU -- etwas, das weder
' eins seiner beiden Enden ist noch schon vorher (orig) auf dem Draht lag?
' Dann wuerde das Gummiband eine Verbindung erfinden. Was vorher schon
' darauf sass (ein Label auf dem Draht, ein T-Anschluss), bleibt erlaubt.
FUNCTION neuBeruehrt(p AS Punkt, a AS Punkt, e AS Punkt, q AS ARRAY OF Punkt, orig AS ARRAY OF Punkt) AS BOOLEAN
    IF punktGleich(p, a) OR punktGleich(p, e) THEN RETURN FALSE
    IF NOT aufPolylinie(p, q) THEN RETURN FALSE
    RETURN NOT aufPolylinie(p, orig)
END FUNCTION

FUNCTION gummibandKollision(bl AS Blatt, w AS Draht, q AS ARRAY OF Punkt, orig AS ARRAY OF Punkt) AS BOOLEAN
    DIM a AS Punkt : a = q[0]
    DIM e AS Punkt : e = q[LEN(q) - 1]
    DIM i AS INTEGER, j AS INTEGER
    FOR i = 0 TO LEN(bl.bauteile) - 1
        FOR j = 0 TO LEN(bl.bauteile[i].sym.pins) - 1
            IF neuBeruehrt(bl.bauteile[i].pinPunkt(j), a, e, q, orig) THEN RETURN TRUE
        NEXT
    NEXT
    FOR i = 0 TO LEN(bl.labels) - 1
        IF neuBeruehrt(bl.labels[i].anker, a, e, q, orig) THEN RETURN TRUE
    NEXT
    FOR i = 0 TO LEN(bl.draehte) - 1
        DIM ow AS Draht : ow = bl.draehte[i]
        IF ow = w THEN CONTINUE
        ' fremde Ecken auf dem neuen Verlauf
        FOR j = 0 TO LEN(ow.punkte) - 1
            IF neuBeruehrt(ow.punkte[j], a, e, q, orig) THEN RETURN TRUE
        NEXT
        ' eigene neue Ecken auf einem fremden Draht
        FOR j = 1 TO LEN(q) - 2
            IF aufPolylinie(q[j], ow.punkte) AND NOT aufPolylinie(q[j], orig) THEN RETURN TRUE
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Gummiband, das nie eine Verbindung erfindet: versucht den gewohnten Knick,
' dann den anderen herum (je Ende), zuletzt schraeg -- und nimmt den ersten
' Verlauf, der nichts beruehrt ausser seinen beiden Enden. Rechnet ab orig
' (den Ecken bei Zugbeginn).
FUNCTION gummibandSicher(bl AS Blatt, w AS Draht, orig AS ARRAY OF Punkt, dxA AS INTEGER, dyA AS INTEGER, dxE AS INTEGER, dyE AS INTEGER) AS ARRAY OF Punkt
    IF dxA = dxE AND dyA = dyE THEN RETURN punkteVerschoben(orig, dxA, dyA)
    DIM mA AS ARRAY OF INTEGER : mA = [0, 1, 0, 1, 2]
    DIM mE AS ARRAY OF INTEGER : mE = [0, 0, 1, 1, 2]
    DIM k AS INTEGER
    DIM tmp AS Draht : tmp = NEW Draht()
    FOR k = 0 TO LEN(mA) - 1
        DIM q AS ARRAY OF Punkt : q = orig
        IF dxA <> 0 OR dyA <> 0 THEN q = gummibandModus(q, 1, dxA, dyA, mA[k])
        IF dxE <> 0 OR dyE <> 0 THEN q = gummibandModus(q, 2, dxE, dyE, mE[k])
        tmp.punkte = q
        drahtAufraeumen(tmp)
        IF NOT gummibandKollision(bl, w, tmp.punkte, orig) THEN RETURN tmp.punkte
    NEXT
    RETURN tmp.punkte
END FUNCTION

' Beide Enden folgen je ihrem Pin (beim Drehen wandern sie verschieden).
' Wandern beide gleich weit, geht der Draht starr mit.
FUNCTION gummibandEnden(p AS ARRAY OF Punkt, dxA AS INTEGER, dyA AS INTEGER, dxE AS INTEGER, dyE AS INTEGER) AS ARRAY OF Punkt
    IF dxA = dxE AND dyA = dyE THEN RETURN punkteVerschoben(p, dxA, dyA)
    DIM q AS ARRAY OF Punkt : q = p
    IF dxA <> 0 OR dyA <> 0 THEN q = gummiband(q, 1, dxA, dyA)
    IF dxE <> 0 OR dyE <> 0 THEN q = gummiband(q, 2, dxE, dyE)
    RETURN q
END FUNCTION

' Haengt am Blattpunkt etwas anderes als der Draht "ohne"? Pin, Label,
' Ecke oder Segment eines anderen Drahtes.
FUNCTION punktAngeschlossen(bl AS Blatt, x AS INTEGER, y AS INTEGER, ohne AS Draht) AS BOOLEAN
    DIM i AS INTEGER, j AS INTEGER
    FOR i = 0 TO LEN(bl.bauteile) - 1
        FOR j = 0 TO LEN(bl.bauteile[i].sym.pins) - 1
            DIM pp AS Punkt : pp = bl.bauteile[i].pinPunkt(j)
            IF pp.x = x AND pp.y = y THEN RETURN TRUE
        NEXT
    NEXT
    FOR i = 0 TO LEN(bl.labels) - 1
        IF bl.labels[i].anker.x = x AND bl.labels[i].anker.y = y THEN RETURN TRUE
    NEXT
    FOR i = 0 TO LEN(bl.draehte) - 1
        DIM w AS Draht : w = bl.draehte[i]
        IF w = ohne THEN CONTINUE
        FOR j = 0 TO LEN(w.punkte) - 1
            IF w.punkte[j].x = x AND w.punkte[j].y = y THEN RETURN TRUE
            IF j < LEN(w.punkte) - 1 THEN
                IF aufSegment(w.punkte[j].x, w.punkte[j].y, w.punkte[j + 1].x, w.punkte[j + 1].y, x, y) THEN RETURN TRUE
            END IF
        NEXT
    NEXT
    RETURN FALSE
END FUNCTION

' Wie viele Stellen tragen diesen Netznamen? (Labels und Versorgungssymbole)
FUNCTION namensStellen(bl AS Blatt, name AS STRING) AS INTEGER
    DIM c AS INTEGER : c = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(bl.labels) - 1
        IF bl.labels[i].text = name THEN c = c + 1
    NEXT
    FOR i = 0 TO LEN(bl.bauteile) - 1
        IF bl.bauteile[i].sym.einheitLeistung THEN
            IF versorgungsName(bl.bauteile[i]) = name THEN c = c + 1
        END IF
    NEXT
    RETURN c
END FUNCTION

' Einen Netznamen an allen Stellen ersetzen; liefert die Zahl der Stellen.
FUNCTION namenUmbenennen(bl AS Blatt, alt AS STRING, neu AS STRING) AS INTEGER
    DIM c AS INTEGER : c = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(bl.labels) - 1
        IF bl.labels[i].text = alt THEN
            bl.labels[i].text = neu
            c = c + 1
        END IF
    NEXT
    FOR i = 0 TO LEN(bl.bauteile) - 1
        IF bl.bauteile[i].sym.einheitLeistung THEN
            IF versorgungsName(bl.bauteile[i]) = alt THEN
                bl.bauteile[i].wert = neu
                c = c + 1
            END IF
        END IF
    NEXT
    RETURN c
END FUNCTION

' Knoten neu bestimmen: wo >=3 Enden treffen oder ein Ende auf einem Segment.
SUB autoKnoten(bl AS Blatt)
    DIM neu AS ARRAY OF Knoten : neu = []
    DIM gesehen AS MAP OF INTEGER
    DIM w AS Draht, i AS INTEGER, j AS INTEGER
    FOR i = 0 TO LEN(bl.draehte) - 1
        w = bl.draehte[i]
        FOR j = 0 TO LEN(w.punkte) - 1
            DIM x AS INTEGER : x = rastern(w.punkte[j].x, RASTER)
            DIM y AS INTEGER : y = rastern(w.punkte[j].y, RASTER)
            DIM k AS STRING : k = netzKey(x, y)
            IF MAPHAS(gesehen, k) THEN CONTINUE
            IF endenAn(bl, x, y) >= 3 OR istTPunkt(bl, x, y) THEN
                MAPPUT(gesehen, k, 1)
                ARRAY_PUSH(neu, NEW Knoten(NEW Punkt(x, y)))
            END IF
        NEXT
    NEXT
    bl.knoten = neu
END SUB
