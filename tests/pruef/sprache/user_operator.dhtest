=== inherited operator used (1)
' Operator-Methoden werden ueber die Vererbungs-Kette gesucht --
CLASS Base
    DIM x AS INTEGER
    OPERATOR + (other AS Base) AS Base
        DIM r AS Base
        r = NEW Base()
        r.x = Self.x + other.x
        RETURN r
    END OPERATOR
END CLASS

CLASS Child EXTENDS Base
END CLASS

DIM a AS Child
DIM b AS Child
DIM r AS Base
a = NEW Child()
b = NEW Child()
a.x = 5
b.x = 7
r = a + b
PRINT r.x
--- erwartet
12

