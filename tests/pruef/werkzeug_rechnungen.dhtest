    RETURN IIF(b, "ja", "nein")
END FUNCTION
SUB prFall()
    prKlick(3, prMx(tfKName), prMy(tfKName))
    prTaste(7, 86, 341)
    prKlick(12, prMx(bKSpeichern), prMy(bKSpeichern))
