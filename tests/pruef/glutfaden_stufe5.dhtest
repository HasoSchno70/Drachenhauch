=== eine krumme oxs wie pysticky, warnungen eingeschlossen
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Kommazahl-Koordinaten, unbekannter und doppelter palindex, kaputte Farbe und
' Index, Ornamente unter dem kurzen Namen, Rueckstich ausserhalb, fehlender Titel
DIM g AS kern.OxsImport : g = kern.oxsLaden("krumm.oxs", pal, sym)
DIM t AS STRING : t = geMuster$(g.muster)
DIM w AS STRING
FOR EACH w IN g.warnungen
    t = t + "warnung " + w + CHR$(10)
NEXT
PRINT geVergleich$(t, geLies$("krumm_py.txt"))
