' Kuehlschrank-App im Drachenhauch Studio, Stufe 0: Geruest und Datenbank
' (examples/studio/kuehlschrank). Das Projekt steht so im Ordner, wie das
' Studio es schreibt; F5 erzeugt ein Programm, das sich ohne Befund
' uebersetzt; eine neue Datei bekommt die Startdaten der Python-App; die
' Datei der Python-App (fridge_database.db) bleibt beim Start, wie sie ist,
' und der Kopf zeigt ihre Kennzahlen.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== das projekt steht so im ordner, wie das studio es schreibt
' Laden und wieder setzen gibt jede Datei Zeichen fuer Zeichen zurueck.
IMPORT "modell_imp.dh"
DIM o AS STRING : o = ARG$(0)
PRINT "laden ["; projektLaden$(o); "]"
PRINT "elemente "; LEN(elemente); " start "; projStart
DIM e AS Element
FOR EACH e IN elemente
    DIM gleich AS BOOLEAN : gleich = TRUE
    IF hatCode(e) THEN gleich = codeSetzen$(e) = JOIN$(READLINES(PATHJOIN(o, codeDatei$(e))), CHR$(10)) + CHR$(10)
    IF e.art = "datenbank" THEN gleich = JSON_PRETTY(dbSchema(e)) = JOIN$(READLINES(PATHJOIN(o, schemaDatei$(e))), CHR$(10))
    IF e.art = "bericht" THEN gleich = JSON_PRETTY(berichtJ(e)) = JOIN$(READLINES(PATHJOIN(o, berichtDatei$(e))), CHR$(10))
    IF hatLayout(e) THEN gleich = gleich AND JSON_PRETTY(JSON_PARSE(e.layout)) = JOIN$(READLINES(PATHJOIN(o, layoutDatei$(e))), CHR$(10))
    PRINT e.art; " "; e.name; " "; gleich
NEXT
PRINT "projektdatei "; projektJson$() = JOIN$(READLINES(PATHJOIN(o, PROJEKT_DATEI)), CHR$(10))
DIM s AS JSON_HANDLE : s = dbSchema(elemente[elementIndex("Daten")])
PRINT "daten "; dbDateiVon$(s); " tabellen "; dbTabZahl(s)
