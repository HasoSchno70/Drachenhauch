IMPORT "json"
FUNCTION zahl$(f AS FLOAT) AS STRING
    IF f = INT(f) THEN RETURN STR$(INT(f))
    RETURN STR$(f)
END FUNCTION
SUB noten(h AS JSON_HANDLE, spur AS INTEGER)
    DIM p AS STRING : p = "tracks." + STR$(spur) + ".notes"
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(h, p) - 1
        DIM q AS STRING : q = p + "." + STR$(i)
        DIM ton AS STRING : ton = "pause"
        DIM pause AS BOOLEAN : pause = FALSE
        IF JSON_HAS(h, q + ".rest") THEN pause = JSON_GET_BOOL(h, q + ".rest")
        IF NOT pause THEN ton = STR$(JSON_GET_INT(h, q + ".pitch"))
        PRINT "note " + zahl$(JSON_GET_FLOAT(h, q + ".start")) + " " + zahl$(JSON_GET_FLOAT(h, q + ".dur")) + " " + ton
