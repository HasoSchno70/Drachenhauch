--- nachher
DIM b AS IMAGE : b = LOADIMAGE("bild.png")
' Hell ist die Schrift, der Grund ist dunkel -- gezaehlt wird im Innern
' der drei Felder, ohne Rand.
FUNCTION tinte(y0 AS INTEGER) AS INTEGER
    DIM n AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM c AS INTEGER
    FOR y = y0 + 4 TO y0 + 44
        FOR x = 14 TO 280
            c = GETPIXEL(b, x, y)
            IF ((c SHR 16) BAND 255) + ((c SHR 8) BAND 255) + (c BAND 255) > 450 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
DIM n0 AS INTEGER : n0 = tinte(10)
DIM n1 AS INTEGER : n1 = tinte(70)
DIM n2 AS INTEGER : n2 = tinte(130)
PRINT "ungeformt hat tinte " ; n0 > 20
PRINT "fett mehr " ; n1 > n0 + 10
PRINT "unterstrichen mehr " ; n2 > n0 + 10
--- erwartet
ungeformt hat tinte TRUE
fett mehr TRUE
unterstrichen mehr TRUE
