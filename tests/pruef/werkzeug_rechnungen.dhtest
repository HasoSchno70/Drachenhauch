--- einschub nach GUI_FOCUS(tfKName)
GUI_SET_ACTIVE_TAB(win, 2)

--- einschub nach FLIP()
prBild = prBild + 1
IF prBild = 3 THEN prFall()
prSchreib("posAnz " + STR$(posAnz) + " brutto " + GUI_TEXT(vSBrutto) + " gespeichert " + prJa$(INSTR(GUI_TEXT(lblStatus), "gespeichert") >= 0))

