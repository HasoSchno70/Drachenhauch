=== probe: info, fortschritt, symbol-editor
IMPORT "helfer.dh"
' Punkte im Gruen des Gesamtbalkens (40C870, +-14) in der Seitenleiste
FUNCTION gruenRechts(pfad AS STRING) AS INTEGER
    DIM b AS IMAGE : b = LOADIMAGE(pfad)
    DIM n AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR y = 300 TO 600 STEP 2
        FOR x = IMAGE_WIDTH(b) - 400 TO IMAGE_WIDTH(b) - 1 STEP 2
            DIM c AS INTEGER : c = GETPIXEL(b, x, y)
            IF ABS(((c SHR 16) BAND 255) - &H40) < 14 AND ABS(((c SHR 8) BAND 255) - &HC8) < 14 AND ABS((c BAND 255) - &H70) < 14 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION

' --probe-stufe17 mit alle.pxs: Reiter Info (Karten wie der Kern, Stoff als
' Schritt, Liste waehlt), Fortschritt (Sticken-Modus, Alle erledigt,
' Zuruecksetzen samt Rueckgaengig) und der Symbol-Editor (Suche, doppeltes
' Symbol abgewiesen, eigenes Zeichen).
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe17", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["info", "fortschritt", "symboleditor"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    ' Der Balken im Reiter Fortschritt: gruen (40C870) rechts im Fenster
    PRINT "gruener balken: "; gruenRechts("d_fortschritt.png") > 100; " | im info-reiter keiner "; gruenRechts("d_info.png") < 40
    PRINT "datei unveraendert: "; READLINES("alle.pxs")[0] = READLINES("vorher.pxs")[0]
END IF
