' Die Selbstvorfuehrung fuer Pruefungen (--probe, --probe-bearbeiten): ein
' Zeitgeber geht Schritt fuer Schritt durch, schreibt, was er sieht, und sichert
' mit --foto Bilder des Fensters. Die Werkzeuge bekommen dieselben Zellen und
' Knoepfe gemeldet wie von der Maus (wzDruck/wzZiehen/wzLos).

DIM schritt AS INTEGER
SUB foto(name AS STRING)
    IF fotoZiel = "" THEN RETURN
    IF NOT gtkFoto(fenster, fotoZiel + "_" + name + ".png") THEN PRINT "Foto nicht gesichert: "; name
END SUB

' Stufe 1: ansehen, zoomen, eine Ebene aus- und einblenden
FUNCTION vorfuehren(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    SELECT CASE schritt
        CASE 1
            ' Das erste Zeichnen hat eingepasst
            PRINT "geladen: "; geladen; ", eingepasst: "; lwEingepasst
            PRINT lwMuster.breite; " x "; lwMuster.hoehe; ", "; ZAHL$(lwMuster.breiteCm(), 1); " cm"
        CASE 2
            foto("eingepasst")
            leinwandZoom(30.0, lwX + 5.5 * lwZelle, lwY + 5.5 * lwZelle)
            PRINT "zoom: "; leinwandZoomProzent(); " %"
        CASE 3
            foto("nah")
            ' Die Ebene "Herz" ausblenden -- die Stiche verschwinden aus dem Bild
            IF LEN(slEbenenKnoepfe) < 2 THEN RETURN TRUE
            DIM vorher AS INTEGER : vorher = lwFarbe[12 * lwMuster.breite + 17]
            gtk_toggle_button_set_active(slEbenenKnoepfe[1], FALSE)
            PRINT "zelle 17,12: "; vorher; " -> "; lwFarbe[12 * lwMuster.breite + 17]
        CASE 4
            IF LEN(slEbenenKnoepfe) < 2 THEN RETURN TRUE
            foto("ohne_herz")
            gtk_toggle_button_set_active(slEbenenKnoepfe[1], TRUE)
            PRINT "wieder da: "; lwFarbe[12 * lwMuster.breite + 17]
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Ein Zug mit der Maus: druecken, ueber die Zellen ziehen, loslassen.
SUB zug(taste AS INTEGER, punkte AS ARRAY OF INTEGER, umschalt AS BOOLEAN)
    DIM n AS INTEGER : n = LEN(punkte)
    DIM z AS INTEGER : z = wzDruck(punkte[0], punkte[1], taste, umschalt)
    DIM k AS INTEGER
    FOR k = 2 TO n - 2 STEP 2
        wzZiehen(punkte[k], punkte[k + 1], umschalt)
    NEXT
    wzLos(punkte[n - 2], punkte[n - 1], umschalt)
END SUB

' Stufe 2: bearbeiten
DIM vfBlau AS INTEGER
DIM vfDatei AS STRING
FUNCTION vorfuehrenBearbeiten(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM i AS INTEGER, p AS INTEGER
    SELECT CASE schritt
        CASE 1
            PRINT "geladen: "; geladen; " farben "; lwMuster.farbanzahl(); " geaendert "; istGeaendert()
            ' DMC 996 (Electric Blue) aus dem Katalog ins Muster
            FOR p = 0 TO LEN(slPaletten) - 1
                IF slPaletten[p].hersteller = "DMC" THEN
                    FOR i = 0 TO LEN(slPaletten[p].garne) - 1
                        IF slPaletten[p].garne[i].nummer = "996" THEN garnHinzufuegen(p, i)
                    NEXT
                END IF
            NEXT
            vfBlau = wzFarbe
            PRINT "farbe "; vfBlau; " "; lwMuster.farben[vfBlau].garn.name; " symbol "; lwMuster.farben[vfBlau].symbol; " farben "; lwMuster.farbanzahl()
            ' dasselbe Garn noch einmal: keine neue Farbe
            FOR p = 0 TO LEN(slPaletten) - 1
                IF slPaletten[p].hersteller = "DMC" THEN
                    FOR i = 0 TO LEN(slPaletten[p].garne) - 1
                        IF slPaletten[p].garne[i].nummer = "996" THEN garnHinzufuegen(p, i)
                    NEXT
                END IF
            NEXT
            PRINT "noch einmal: farben "; lwMuster.farbanzahl(); " katalogzeilen "; LEN(slKatZeilen) > 100
        CASE 2
            ' neue Ebene, gefuelltes Rechteck in Blau
            ebenenBefehl(0)
            werkzeugWaehlen(WZ_RECHTECK, TRUE)
            zug(1, [2, 2, 6, 5, 9, 7], FALSE)
            PRINT "ebenen "; lwMuster.ebenen.anzahl(); " aktiv "; lwMuster.ebenen.aktiveEbene().name; " blau "; lwMuster.farben[vfBlau].stichzahl
            PRINT "schritte "; LEN(wzVerlauf.rueck); " oben "; wzVerlauf.textZurueck$(); " geaendert "; istGeaendert()
            PRINT "titel "; gtk_label_get_text_titel()
            leinwandEinpassen()
        CASE 3
            foto("rechteck")
            werkzeugZurueck()
            PRINT "zurueck: blau "; lwMuster.farben[vfBlau].stichzahl; " ebenen "; lwMuster.ebenen.anzahl()
        CASE 4
            foto("zurueck")
            werkzeugVor()
            ' Stift mit Umschalt-Linie und Ellipse: Umschalt haelt die Linie gerade
            werkzeugWaehlen(WZ_LINIE, FALSE)
            zug(1, [0, 10, 15, 12], TRUE)
            PRINT "linie gerade: "; lwMuster.stich(15, 10) = vfBlau; " "; lwMuster.stich(15, 12)
            werkzeugWaehlen(WZ_STIFT, FALSE)
            stichartWaehlen(kern.HALB_OL_UR)
            zug(1, [20, 20, 24, 24], FALSE)
            PRINT "stift: "; lwMuster.stich(22, 22) = vfBlau; " art "; lwMuster.ebenen.aktiveEbene().stichArt(22, 22)
            stichartWaehlen(kern.VOLL)
            ' rechte Maustaste radiert -- auch mit dem Stift
            zug(3, [22, 22], FALSE)
            PRINT "radiert: "; lwMuster.stich(22, 22) = vfBlau
            ' Pipette nimmt die Farbe darunter
            werkzeugWaehlen(WZ_PIPETTE, FALSE)
            zug(1, [17, 12], FALSE)
            PRINT "pipette: "; wzFarbe; " "; lwMuster.stich(17, 12)
            ' Fuellen auf der leeren Ebene in einem Schritt
            farbeWaehlen(vfBlau)
            werkzeugWaehlen(WZ_FUELLEN, FALSE)
            DIM vorher AS INTEGER : vorher = LEN(wzVerlauf.rueck)
            zug(1, [30, 30], FALSE)
            PRINT "gefuellt: "; lwMuster.ebenen.aktiveEbene().stichzahl(); " schritte +"; LEN(wzVerlauf.rueck) - vorher
            werkzeugZurueck()
            PRINT "fuellen zurueck: "; lwMuster.ebenen.aktiveEbene().stichzahl()
        CASE 5
            foto("wieder")
            ' Ebene sperren: Stift setzt nichts
            lwMuster.ebenen.aktiveEbene().gesperrt = TRUE
            werkzeugWaehlen(WZ_STIFT, FALSE)
            DIM n AS INTEGER : n = lwMuster.ebenen.aktiveEbene().stichzahl()
            zug(1, [35, 35, 38, 38], FALSE)
            PRINT "gesperrt: "; lwMuster.ebenen.aktiveEbene().stichzahl() = n
            lwMuster.ebenen.aktiveEbene().gesperrt = FALSE
            ' Ebene loeschen und zurueckholen
            ebenenBefehl(1)
            PRINT "geloescht: ebenen "; lwMuster.ebenen.anzahl(); " blau "; lwMuster.farben[vfBlau].stichzahl
            werkzeugZurueck()
            PRINT "zurueckgeholt: ebenen "; lwMuster.ebenen.anzahl(); " blau "; lwMuster.farben[vfBlau].stichzahl
            ' Deckkraft halb: das Blau mischt sich mit dem Stoff
            gtk_range_set_value(slDeckkraft, 50.0)
            PRINT "deckkraft "; lwMuster.ebenen.aktiveEbene().deckkraft; " geaendert "; istGeaendert()
        CASE 6
            foto("halb")
            gtk_range_set_value(slDeckkraft, 100.0)
            ' sichern und wieder laden
            vfDatei = fotoZiel + "_gesichert.pxs"
            IF fotoZiel = "" THEN vfDatei = PATHJOIN(TEMPDIR$(), "glutfaden_probe.pxs")
            PRINT "gesichert: "; musterSichern(vfDatei); " geaendert "; istGeaendert(); " titel "; gtk_label_get_text_titel()
            DIM m AS kern.Muster : m = kern.pxsLaden(vfDatei)
            PRINT "geladen: ebenen "; m.ebenen.anzahl(); " farben "; m.farbanzahl(); " stiche "; m.sticheGesamt(); " = "; lwMuster.sticheGesamt()
            PRINT "zelle 5,4: "; m.stich(5, 4) = vfBlau; " "; m.farben[vfBlau].garn.hersteller; " "; m.farben[vfBlau].garn.nummer
            ' zurueck nach dem Sichern: wieder ungesichert, und vor: wieder gesichert
            werkzeugZurueck()
            PRINT "nach zurueck "; istGeaendert()
            werkzeugVor()
            PRINT "nach vor "; istGeaendert()
            ' unbenutzte Farben entfernen (die Demo hat keine), umbenennen
            PRINT "ebene umbenannt: "; kern.ebeneUmbenennen(lwMuster, wzVerlauf, lwMuster.ebenen.aktiv, "Blau")
            allesNeu()
            PRINT "oben "; wzVerlauf.textZurueck$(); " liste "; gtk_label_get_text(slEbenenTexte[lwMuster.ebenen.anzahl() - 1 - lwMuster.ebenen.aktiv])
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

FUNCTION gtk_label_get_text_titel() AS STRING
    RETURN musterTitel + IIF(istGeaendert(), " •", "")
END FUNCTION

' Stufe 3: Auswahl, Vieleck, Symmetrie, Rueckstich, Fortschritt, Text
FUNCTION blauHolen() AS INTEGER
    DIM p AS INTEGER, i AS INTEGER
    FOR p = 0 TO LEN(slPaletten) - 1
        IF slPaletten[p].hersteller = "DMC" THEN
            FOR i = 0 TO LEN(slPaletten[p].garne) - 1
                IF slPaletten[p].garne[i].nummer = "996" THEN garnHinzufuegen(p, i)
            NEXT
        END IF
    NEXT
    RETURN wzFarbe
END FUNCTION

FUNCTION vorfuehrenStufe3(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM n AS INTEGER, vorher AS INTEGER
    SELECT CASE schritt
        CASE 1
            vfBlau = blauHolen()
            PRINT "geladen: "; geladen; " blau "; vfBlau; " stiche "; lwMuster.sticheGesamt()
            ' Auswahl ueber das Herz (Zeilen 12..20) auf der Ebene "Herz" -- die
            ' Auswahl nimmt wie im Original nur die AKTIVE Ebene --, kopieren,
            ' links oben einfuegen
            lwMuster.ebenen.aktiv = 1
            slEbeneMarkieren()
            PRINT "aktive ebene "; lwMuster.ebenen.aktiveEbene().name
            werkzeugWaehlen(WZ_AUSWAHL, FALSE)
            zug(1, [14, 12, 20, 16, 25, 20], FALSE)
            PRINT "auswahl "; mrAuswahl.anzahl; " "; mrAuswahl.x0; ","; mrAuswahl.y0; "-"; mrAuswahl.x1; ","; mrAuswahl.y1
            auswahlKopieren()
            vorher = lwMuster.sticheGesamt()
            einfuegenBeginnen()
            DIM z AS INTEGER : z = wzDruck(3, 3, 1, FALSE)
            PRINT "eingefuegt: +"; lwMuster.sticheGesamt() - vorher; " oben "; wzVerlauf.textZurueck$(); " auswahl jetzt "; mrAuswahl.x0; ","; mrAuswahl.y0
        CASE 2
            foto("eingefuegt")
            ' die eingefuegte Auswahl um 5 nach rechts ziehen: ein Schritt
            DIM s0 AS INTEGER : s0 = LEN(wzVerlauf.rueck)
            zug(1, [5, 5, 8, 5, 10, 5], FALSE)
            PRINT "verschoben: auswahl "; mrAuswahl.x0; ","; mrAuswahl.y0; " schritte +"; LEN(wzVerlauf.rueck) - s0; " zelle 4,5 "; lwMuster.stich(4, 5)
            ' drehen (r) und zurueck
            vorher = lwMuster.sticheGesamt()
            DIM ok AS BOOLEAN : ok = werkzeugTaste(&H72, FALSE, FALSE)
            PRINT "gedreht: "; wzVerlauf.textZurueck$(); " breite "; mrAuswahl.x1 - mrAuswahl.x0 + 1; " hoehe "; mrAuswahl.y1 - mrAuswahl.y0 + 1; " stiche gleich "; lwMuster.sticheGesamt() = vorher
            werkzeugZurueck()
            ' Entf und ESC
            ok = werkzeugTaste(&HFFFF, FALSE, FALSE)
            PRINT "geloescht: "; wzVerlauf.textZurueck$(); " stiche "; lwMuster.sticheGesamt() - vorher
            werkzeugZurueck()
            ok = werkzeugTaste(&HFF1B, FALSE, FALSE)
            PRINT "esc: auswahl weg "; NOT mehrHatAuswahl()
        CASE 3
            ' gefuelltes Vieleck in Blau: drei Ecken, rechte Taste schliesst
            farbeWaehlen(vfBlau)
            werkzeugWaehlen(WZ_VIELECK, TRUE)
            n = wzDruck(28, 26, 1, FALSE)
            n = wzDruck(36, 28, 1, FALSE)
            n = wzDruck(30, 35, 1, FALSE)
            n = wzDruck(30, 35, 3, FALSE)
            PRINT "vieleck: blau "; lwMuster.farben[vfBlau].stichzahl; " oben "; wzVerlauf.textZurueck$(); " ecken "; LEN(mrEcken)
            ' Symmetrie vierfach: ein Punkt mit dem Stift ergibt vier
            spiegelWaehlen(kern.SPIEGEL_VIERFACH)
            werkzeugWaehlen(WZ_STIFT, FALSE)
            vorher = lwMuster.farben[vfBlau].stichzahl
            zug(1, [2, 37], FALSE)
            PRINT "vierfach: +"; lwMuster.farben[vfBlau].stichzahl - vorher; " "; lwMuster.stich(37, 37) = vfBlau; " "; lwMuster.stich(2, 2) = vfBlau; " "; lwMuster.stich(37, 2) = vfBlau
            spiegelWaehlen(kern.SPIEGEL_AUS)
        CASE 4
            foto("vieleck")
            ' Rueckstich: zwei Klicks auf Rasterpunkte (Halbstich-Einheiten)
            werkzeugWaehlen(WZ_RUECKSTICH, FALSE)
            lwHalbX = 4 : lwHalbY = 60
            n = wzDruck(2, 30, 1, FALSE)
            lwHalbX = 30 : lwHalbY = 60
            n = wzDruck(15, 30, 1, FALSE)
            lwHalbX = 30 : lwHalbY = 70
            n = wzDruck(15, 35, 1, FALSE)
            n = wzDruck(15, 35, 3, FALSE)
            PRINT "rueckstiche "; LEN(lwMuster.rueckstiche); " oben "; wzVerlauf.textZurueck$()
            ' rechts auf eine Linie: entfernt
            lwHalbGenauX = 17.2 : lwHalbGenauY = 60.4
            n = wzDruck(8, 30, 3, FALSE)
            PRINT "entfernt: "; LEN(lwMuster.rueckstiche); " oben "; wzVerlauf.textZurueck$()
            werkzeugZurueck()
            PRINT "zurueck: "; LEN(lwMuster.rueckstiche)
        CASE 5
            foto("rueckstich")
            ' Fortschritt: die Zeile des Rahmens ziehen, dann Pfeile und Enter
            werkzeugWaehlen(WZ_FORTSCHRITT, FALSE)
            zug(1, [5, 5, 30, 5], FALSE)
            PRINT "erledigt "; lwFertig[5 * lwMuster.breite + 10]; " "; lwFertig[5 * lwMuster.breite + 30]; " oben "; wzVerlauf.textZurueck$()
            farbeWaehlen(lwMuster.stich(10, 5))
            DIM ok2 AS BOOLEAN : ok2 = werkzeugTaste(&HFF53, FALSE, FALSE)
            PRINT "naechster offen "; mrCursor MOD lwMuster.breite; ","; mrCursor \ lwMuster.breite
            ok2 = werkzeugTaste(&HFF0D, FALSE, FALSE)
            DIM c AS INTEGER : c = kern.naechsterOffen(lwMuster, wzFarbe, -1, TRUE)
            PRINT "nach enter "; mrCursor MOD lwMuster.breite; ","; mrCursor \ lwMuster.breite; " erster offen "; c MOD lwMuster.breite; ","; c \ lwMuster.breite
            ' rechts nimmt zurueck
            zug(3, [10, 5], FALSE)
            PRINT "zurueckgenommen 10,5: "; lwFertig[5 * lwMuster.breite + 10]
        CASE 6
            foto("fortschritt")
            ' Text, ohne Dialog: groesse 12 -> etwa 16 hoch
            farbeWaehlen(vfBlau)
            werkzeugWaehlen(WZ_TEXT, FALSE)
            txText = "Hi" : txSchrift = "Sans" : txGroesse = 12 : txFett = TRUE : txKursiv = FALSE
            textAnhaengen()
            PRINT "text: an der maus "; mrEinfuegen; " groesse "; mrEinfuegenAus.breite; "x"; mrEinfuegenAus.hoehe; " stiche > 20 "; mrEinfuegenAus.stiche() > 20
            vorher = lwMuster.farben[vfBlau].stichzahl
            n = wzDruck(6, 18, 1, FALSE)
            PRINT "text gesetzt: +"; lwMuster.farben[vfBlau].stichzahl - vorher = mrEinfuegenAus.stiche(); " oben "; wzVerlauf.textZurueck$(); " haengt "; mrEinfuegen
            ' seltene Farben zusammenlegen (die Demo hat Anchor 309 mit 17)
            n = seltenZusammenlegen(20)
            allesNeu()
            PRINT "selten: "; n; " oben "; wzVerlauf.textZurueck$()
        CASE 7
            foto("text")
            ' sichern und laden: Rueckstiche und erledigt kommen mit
            vfDatei = fotoZiel + "_stufe3.pxs"
            IF fotoZiel = "" THEN vfDatei = PATHJOIN(TEMPDIR$(), "glutfaden_stufe3.pxs")
            DIM ok3 AS BOOLEAN : ok3 = musterSichern(vfDatei)
            DIM m AS kern.Muster : m = kern.pxsLaden(vfDatei)
            DIM e AS kern.Ebene : e = kern.ebeneMitStich(m, 30, 5)
            PRINT "geladen: rueckstiche "; LEN(m.rueckstiche); " erledigt 30,5 "; e.istErledigt(30, 5); " stiche "; m.sticheGesamt() = lwMuster.sticheGesamt()
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 4: Bildimport -- Dialog bauen und einstellen, Vorschau, uebernehmen,
' erneut aus dem Quellbild (mit den Einstellungen von damals), eine
' Voreinstellung, sichern und laden.
DIM vfMuster AS kern.Muster
FUNCTION vorfuehrenStufe4(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM logoBild AS STRING : logoBild = PATHJOIN(CWD$(), "daten/bilder/glutfaden_256.png")
    DIM ok AS BOOLEAN
    SELECT CASE schritt
        CASE 1
            PRINT "dialog: "; imDialogBauen(logoBild, NIL); " bild "; imBildB; "x"; imBildH
            gtk_spin_button_set_value(imBreite, 60)
            gtk_spin_button_set_value(imHoehe, 60)
            gtk_spin_button_set_value(imFarben, 12)
            gtk_combo_box_set_active(imDither, 1)
            gtk_spin_button_set_value(imConfetti, 2)
            imAusschnitt = [0.1, 0.1, 0.9, 0.9]
            imAusschnittGeaendert()
            PRINT "info: "; gtk_label_get_text(imInfo)
        CASE 2
            imVorschauGeklickt(0, 0)
            PRINT "vorschau: "; imErgebnis.breite; "x"; imErgebnis.hoehe; " farben "; imErgebnis.farbanzahl(); " stiche "; imErgebnis.sticheGesamt()
        CASE 3
            IF fotoZiel <> "" THEN ok = gtkFoto(imDialog, fotoZiel + "_importdialog.png")
            DIM m AS kern.Muster : m = imRechnen()
            musterUebernehmen(m)
            imDialogWeg()
            PRINT "importiert: "; lwMuster.breite; "x"; lwMuster.hoehe; " farben "; lwMuster.farbanzahl(); " titel "; musterTitel; " ungesichert "; istGeaendert(); " datei leer "; musterPfad = ""
            PRINT "quelle: "; BASENAME(lwMuster.quellBild); " palette "; lwMuster.quellPalette; " dithering "; JSON_GET_STRING(lwMuster.metadaten, "dithering_mode")
        CASE 4
            foto("importiert")
            ' erneut aus dem Quellbild: dieselben Einstellungen, dasselbe Muster
            DIM e AS kern.Importeinstellung : e = imEinstellungAusMuster(lwMuster)
            PRINT "wieder: "; e.breite; "x"; e.hoehe; " farben "; e.maxFarben; " dither "; e.dithering; " confetti "; e.confetti; " ausschnitt "; e.ausschnitt[0]; " palette "; e.palette.name
            ok = imDialogBauen(lwMuster.quellBild, e)
            DIM m2 AS kern.Muster : m2 = imRechnen()
            imDialogWeg()
            DIM gleich AS BOOLEAN : gleich = m2.breite = lwMuster.breite AND m2.hoehe = lwMuster.hoehe
            DIM i AS INTEGER
            IF gleich THEN
                FOR i = 0 TO m2.breite * m2.hoehe - 1
                    DIM a1 AS INTEGER : a1 = m2.ebenen.aktiveEbene().raster[i]
                    DIM a2 AS INTEGER : a2 = lwMuster.ebenen.aktiveEbene().raster[i]
                    IF m2.farben[a1].garn.nummer <> lwMuster.farben[a2].garn.nummer THEN gleich = FALSE
                NEXT
            END IF
            PRINT "dasselbe muster: "; gleich
        CASE 5
            ' Voreinstellung "DP A4" setzt Groesse, Farben und die Diamant-Palette
            ok = imDialogBauen(logoBild, NIL)
            gtk_combo_box_set_active(imVorein, 5)
            DIM ein AS kern.Importeinstellung : ein = imEinstellung()
            PRINT "vorlage: "; ein.breite; "x"; ein.hoehe; " farben "; ein.maxFarben; " dither "; ein.dithering; " median "; ein.farbwahl = kern.WAHL_MEDIAN; " palette "; ein.palette.name
            imDialogWeg()
        CASE 6
            vfDatei = fotoZiel + "_stufe4.pxs"
            IF fotoZiel = "" THEN vfDatei = PATHJOIN(TEMPDIR$(), "glutfaden_stufe4.pxs")
            ok = musterSichern(vfDatei)
            DIM g AS kern.Muster : g = kern.pxsLaden(vfDatei)
            PRINT "geladen: quelle "; BASENAME(g.quellBild); " palette "; g.quellPalette; " max "; JSON_GET_INT(g.metadaten, "max_colors"); " ausschnitt "; g.quellAusschnitt[2]; " stiche "; g.sticheGesamt() = lwMuster.sticheGesamt(); " gesichert "; NOT istGeaendert()
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 5: Export -- der Dialog mit allen Zeilen, dann PDF, HTML, Bild, OXS
' (und wieder eingelesen) und das Paket, je in eine Datei neben die Fotos.
DIM vfVorher AS STRING

' Der Platz eines Garns in der Garnliste einer Palette des Blend-Dialogs.
FUNCTION vfGarnNr(palWahl AS INTEGER, nummer AS STRING) AS INTEGER
    DIM g AS ARRAY OF kern.Garn : g = slPaletten[blPal[gtk_combo_box_get_active(palWahl)]].garne
    DIM i AS INTEGER
    FOR i = 0 TO LEN(g) - 1
        IF g[i].nummer = nummer THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION vfZiel$(name AS STRING) AS STRING
    IF fotoZiel <> "" THEN RETURN fotoZiel + "_" + name
    RETURN PATHJOIN(TEMPDIR$(), "glutfaden_stufe5_" + name)
END FUNCTION

FUNCTION vorfuehrenStufe5(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    DIM d AS INTEGER
    SELECT CASE schritt
        CASE 1
            d = exDialogBauen()
            DIM f AS INTEGER, zeilen AS STRING
            FOR f = EX_PDF TO EX_PAKET
                gtk_combo_box_set_active(exFormat, f)
                zeilen = zeilen + " " + STR$(exZeilenAktiv())
            NEXT
            PRINT "dialog: zeilen je format"; zeilen; " papiere "; LEN(kern.papierNamen()); " entsprechungen "; LEN(exKreuz)
            gtk_combo_box_set_active(exFormat, EX_PDF)
            gtk_spin_button_set_value(exUeb, 2)
            gtk_entry_set_text(exWasser, "ENTWURF")
            gtk_toggle_button_set_active(exKreuz[0], TRUE)
            gtk_text_buffer_set_text(gtk_text_view_get_buffer(exNotizen), "Mit dem Rand beginnen." + CHR$(10) + "Rot zuletzt.", -1)
            IF fotoZiel <> "" THEN ok = gtkFoto(d, fotoZiel + "_exportdialog.png")
            exWahlMerken()
            DIM nz AS STRING : nz = exNotizenText$()
            gtk_widget_destroy(d)
            exExportieren(EX_PDF, vfZiel$("muster.pdf"), nz)
            PRINT "pdf: "; meldung; " | "; exWahlKreuz[0]; " ueb "; exWahlUeb
        CASE 2
            exExportieren(EX_HTML, vfZiel$("muster.html"), "")
            PRINT "html: "; meldung; " | beginnt "; LEFT$(READALL$(vfZiel$("muster.html")), 15)
        CASE 3
            exWahlZelle = 8 : exWahlSymbole = TRUE
            exExportieren(EX_BILD, vfZiel$("muster.png"), "")
            DIM b AS IMAGE : b = LOADIMAGE(vfZiel$("muster.png"))
            PRINT "bild: "; meldung; " | "; IMAGE_WIDTH(b); "x"; IMAGE_HEIGHT(b)
        CASE 4
            DIM vorher AS INTEGER : vorher = lwMuster.sticheGesamt()
            DIM alt AS STRING : alt = musterPfad
            exExportieren(EX_OXS, vfZiel$("muster.oxs"), "")
            PRINT "oxs: "; meldung
            ok = musterOeffnen(vfZiel$("muster.oxs"))
            PRINT "wieder eingelesen: "; ok; " stiche gleich "; lwMuster.sticheGesamt() = vorher; " datei leer "; musterPfad = ""; " | "; LEFT$(meldung, 29)
            foto("aus_oxs")
            ok = musterOeffnen(alt)
        CASE 5
            exWahlPapier = 0
            exExportieren(EX_PAKET, vfZiel$("muster.zip"), "")
            PRINT "paket: "; meldung
            PRINT "  "; JOIN$(ZIP_LIST(vfZiel$("muster.zip")), ", ")
        CASE 6
            ' Diamond: der Papierwaehler empfiehlt das Format fuer 1:1
            lwMuster.modus = "diamond" : lwMuster.stoff = 10
            exWahlPapier = -1
            d = exDialogBauen()
            DIM wahl AS INTEGER : wahl = gtk_combo_box_get_active(exPapier)
            PRINT "diamond: vorgewaehlt "; kern.papierNamen()[wahl]; " = empfehlung "; kern.papierEmpfehlung$(lwMuster, 1)
            gtk_widget_destroy(d)
            lwMuster.modus = "stitch" : lwMuster.stoff = 14
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 6: eine PCStitch-Datei ist geoeffnet (das Startargument), daneben
' liegt dieselbe als .xsd; dann Diamond Painting hin und zurueck (Strg+D).
FUNCTION vorfuehrenStufe6(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    SELECT CASE schritt
        CASE 1
            PRINT "pat: "; LEFT$(meldung, 32); " | ebenen "; lwMuster.ebenen.anzahl(); " stiche "; lwMuster.sticheGesamt(); " rueckstiche "; LEN(lwMuster.rueckstiche); " datei leer "; musterPfad = ""
            foto("aus_pat")
        CASE 2
            ok = musterOeffnen(LEFT$(start, LEN(start) - 4) + ".xsd")
            PRINT "xsd: "; ok; " "; LEFT$(meldung, 36); " | farben "; lwMuster.farbanzahl(); " blend "; lwMuster.farben[2].garn.istBlend()
            foto("aus_xsd")
        CASE 3
            ' Tweed-Blend: DMC 310 + DMC 321 (1:2), zweimal derselbe, dann 1:1
            DIM bd AS INTEGER : bd = blDialogBauen()
            gtk_combo_box_set_active(blGarnA, vfGarnNr(blPalA, "310"))
            gtk_combo_box_set_active(blGarnB, vfGarnNr(blPalB, "321"))
            gtk_spin_button_set_value(blStrB, 2)
            PRINT "blend: "; REPLACE$(gtk_label_get_text(blText), CHR$(10), " | ")
            IF fotoZiel <> "" THEN ok = gtkFoto(bd, fotoZiel + "_blend.png")
            DIM n0 AS INTEGER : n0 = lwMuster.farbanzahl()
            blUebernehmen()
            DIM n1 AS INTEGER : n1 = lwMuster.farbanzahl()
            blUebernehmen()
            DIM n2 AS INTEGER : n2 = lwMuster.farbanzahl()
            gtk_spin_button_set_value(blStrB, 1)
            blUebernehmen()
            PRINT "farben "; n0; " -> "; n1; " -> "; n2; " -> "; lwMuster.farbanzahl(); " | aktuell "; lwMuster.farben[wzFarbe].garn.name; " | rueckgaengig: "; wzVerlauf.textZurueck$()
            gtk_widget_destroy(bd)
        CASE 4
            DIM vorher AS STRING : vorher = lwMuster.farben[0].garn.hersteller + " " + lwMuster.farben[0].garn.nummer
            modusUmschalten()
            PRINT "diamond: "; lwMuster.modus; " stoff "; lwMuster.stoff; " | "; TEXT_AUS_ZEIGER$(gtk_button_get_label(kModus)); " | "; lwMuster.farben[0].garn.hersteller; " | verlauf leer "; NOT wzVerlauf.kannZurueck(); " ungesichert "; istGeaendert()
            foto("diamond")
            vfVorher = vorher
            blendDialog()
            PRINT "blend im diamond-modus: "; meldung
        CASE 5
            modusUmschalten()
            PRINT "zurueck: "; lwMuster.modus; " stoff "; lwMuster.stoff; " | "; TEXT_AUS_ZEIGER$(gtk_button_get_label(kModus)); " | dasselbe garn "; lwMuster.farben[0].garn.hersteller + " " + lwMuster.farben[0].garn.nummer = vfVorher
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 7: der Stickpfad -- Dialog, Strategie wechseln, Tooltip, Zoom mit
' Nummern, alle vergleichen, die drei Exporte; dazu der Schalter im
' Export-Dialog.
FUNCTION vfDialogFoto(name AS STRING) AS BOOLEAN
    IF fotoZiel = "" THEN RETURN TRUE
    DIM ok AS BOOLEAN : ok = gtkFoto(sdDialog, fotoZiel + "_" + name + ".png")
    IF NOT ok THEN PRINT "Foto nicht gesichert: "; name
    RETURN ok
END FUNCTION

FUNCTION vfSumme$() AS STRING
    DIM t AS STRING
    DIM w AS INTEGER
    FOR EACH w IN sdSumme
        t = t + " | " + gtk_label_get_text(w)
    NEXT
    RETURN MID$(t, 3, 999)
END FUNCTION

FUNCTION vorfuehrenStufe7(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    SELECT CASE schritt
        CASE 1
            DIM d AS INTEGER : d = sdDialogBauen()
            PRINT "dialog: "; kern.spName$(gtk_combo_box_get_active(sdStrategie)); " stoff "; gtk_spin_button_get_value_as_int(sdStoff); " | "; vfSumme$()
            PRINT "farben "; LEN(sdZeilen); " gewaehlt "; sdAktiv; " "; sdGarnName$(sdErg.pfade[sdAktiv]); " | vergleich sichtbar "; gtk_widget_get_visible(sdVergleich)
        CASE 2
            ok = vfDialogFoto("stickpfad")
            gtk_combo_box_set_active(sdStrategie, kern.SP_NACHBAR)
            PRINT "naechster nachbar: "; vfSumme$()
            gtk_list_box_select_row(sdListe, sdZeilen[1])
            DIM p AS kern.Farbpfad : p = sdErg.pfade[sdAktiv]
            DIM z AS FLOAT : z = SD_ZELLE * sdZoom
            DIM i AS INTEGER : i = sdStichBei(sdOx + (p.xs[2] + 0.5) * z, sdOy + (p.ys[2] + 0.5) * z)
            PRINT "farbe 2 "; sdGarnName$(p); " | maus auf stich 3: "; sdTipp$(i); " | daneben "; sdStichBei(sdOx - 5, sdOy - 5)
            ' einen Sprung suchen
            FOR i = 1 TO p.stiche() - 1
                IF p.istSprung(i) THEN
                    PRINT "sprung: "; sdTipp$(i)
                    EXIT FOR
                END IF
            NEXT
        CASE 3
            gtk_toggle_button_set_active(sdNummern, TRUE)
            DIM vorher AS FLOAT : vorher = sdZoom
            sdZoomKnopf(0, 1) : sdZoomKnopf(0, 1) : sdZoomKnopf(0, 1)
            PRINT "zoom x1.25^3: "; ABS(sdZoom / vorher - 1.953125) < 0.0001; " | "; gtk_label_get_text(sdZoomText) <> ""
            ok = vfDialogFoto("stickpfad_nummern")
            sdZoomKnopf(0, 0)
            PRINT "eingepasst: "; ABS(sdZoom - vorher) < 0.0001
        CASE 4
            gtk_spin_button_set_value(sdStoff, 18)
            ' vorher eine andere Strategie -- der Vergleich soll die beste waehlen
            gtk_combo_box_set_active(sdStrategie, kern.SP_DIAGONAL)
            PRINT "vor dem vergleich: "; kern.spName$(gtk_combo_box_get_active(sdStrategie)); " | "; vfSumme$()
            sdAlleVergleichen(0, 0)
            PRINT "verglichen: "; kern.spName$(gtk_combo_box_get_active(sdStrategie)); " | "; vfSumme$(); " | vergleich sichtbar "; gtk_widget_get_visible(sdVergleich)
            DIM r AS kern.Stickpfad
            FOR EACH r IN sdVergleiche
                PRINT "  "; sdKurzname$(r.strategie); " "; FORMAT$(r.distanz, "%.1f"); " "; r.spruenge; " "; FORMAT$(r.garnCm, "%.0f"); " "; kern.spBewertung$(r.distanz, sdVergleiche[0].distanz)
            NEXT
        CASE 5
            ' erst jetzt: die eben gezeigte Tabelle hat im selben Schritt noch keine Groesse
            ok = vfDialogFoto("stickpfad_vergleich")
            DIM ziel AS STRING : ziel = IIF(fotoZiel <> "", fotoZiel, PATHJOIN(TEMPDIR$(), "glutfaden_stufe7"))
            PRINT "text: ["; sdTextSichern$(ziel + "_plan.txt"); "] "; LEFT$(READLINES(ziel + "_plan.txt")[4], 99)
            PRINT "bild: "; sdBildSichern(ziel + "_pfad.png")
            DIM b AS IMAGE : b = LOADIMAGE(ziel + "_pfad.png")
            PRINT "  "; IMAGE_WIDTH(b); " x "; IMAGE_HEIGHT(b); " = "; lwMuster.breite * 15 + 60; " x "; lwMuster.hoehe * 15 + 120
            DIM ordner AS STRING : ordner = ziel + "_alle"
            IF NOT DIREXISTS(ordner) THEN MKDIR(ordner)
            DIM fehler AS ARRAY OF STRING
            PRINT "alle: "; sdAlleBilder(ordner, fehler); " fehler "; LEN(fehler)
            DIM namen AS ARRAY OF STRING : namen = DIRLIST(ordner)
            SORT(namen)
            PRINT "  "; JOIN$(namen, ", ")
            ' Grund nach der Helligkeit des Garns (dunkel -> hell, hell -> dunkel),
            ' ein Stich in seiner Farbe, die Legende unten
            DIM k AS INTEGER
            FOR k = 0 TO 1
                DIM pb AS IMAGE : pb = LOADIMAGE(PATHJOIN(ordner, namen[k]))
                DIM q AS kern.Farbpfad : q = sdErg.pfade[k]
                PRINT "  "; namen[k]; ": grund "; kern.farbeAlsHex$(GETPIXEL(pb, 3, 3)); " stich 3 "; kern.farbeAlsHex$(GETPIXEL(pb, 30 + q.xs[2] * 15 + 13, 30 + q.ys[2] * 15 + 2)); " garn "; kern.farbeAlsHex$(lwMuster.farben[q.farbe].garn.farbe)
            NEXT
            gtk_widget_destroy(sdDialog)
            sdDialog = 0
        CASE 6
            DIM ed AS INTEGER : ed = exDialogBauen()
            PRINT "export: stickpfad vorgewaehlt "; gtk_toggle_button_get_active(exStickpfad)
            gtk_toggle_button_set_active(exStickpfad, FALSE)
            exWahlMerken()
            gtk_widget_destroy(ed)
            PRINT "abgewaehlt gemerkt: "; NOT exWahlStickpfad
            exWahlStickpfad = TRUE
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' Stufe 8: auswerten -- Statistik (alle Reiter, CSV), Heatmap, aehnliche
' Farben zusammenfuehren und zuruecknehmen, Farbenblindheit der Ansicht.
FUNCTION vfFoto(w AS INTEGER, name AS STRING) AS BOOLEAN
    IF fotoZiel = "" THEN RETURN TRUE
    DIM ok AS BOOLEAN : ok = gtkFoto(w, fotoZiel + "_" + name + ".png")
    IF NOT ok THEN PRINT "Foto nicht gesichert: "; name
    RETURN ok
END FUNCTION

FUNCTION vfKarten$(namen AS ARRAY OF STRING) AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM n AS STRING
    FOR EACH n IN namen
        ARRAY_PUSH(t, n + "=" + adWort$(n))
    NEXT
    RETURN JOIN$(t, " | ")
END FUNCTION

FUNCTION vorfuehrenStufe8(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    DIM ziel AS STRING : ziel = IIF(fotoZiel <> "", fotoZiel, PATHJOIN(TEMPDIR$(), "glutfaden_stufe8"))
    SELECT CASE schritt
        CASE 1
            DIM d AS INTEGER : d = adStatistikBauen()
            PRINT "statistik: "; vfKarten$(["groesse", "stiche", "farben", "rueckstiche", "abdeckung", "ebenen", "schwierigkeit"])
            PRINT "  tipp: "; REPLACE$(TEXT_AUS_ZEIGER$(gtk_widget_get_tooltip_text(MAPGET(adKarten, "schwierigkeit"))), CHR$(10), " / ")
            DIM i AS INTEGER
            FOR i = 0 TO 4
                PRINT "  top: "; gtk_label_get_text(adTop[3 * i + 1]); " "; TEXT_AUS_ZEIGER$(gtk_progress_bar_get_text(adTop[3 * i + 2]))
            NEXT
        CASE 2
            ok = vfFoto(adDialog, "statistik")
            gtk_combo_box_set_active(adStoff, 3)
            gtk_spin_button_set_value(adZuschlag, 0)
            gtk_spin_button_set_value(adPreis, 0.95)
            PRINT "garn 18/0/0.95: "; gtk_label_get_text(adGarnSumme); " | "; gtk_label_get_text(adGarnKosten); " | "; adGarnLetzte.zeilen[1].garn.name; " "; FORMAT$(adGarnLetzte.zeilen[1].genau, "%.2f"); " Stränge"
            gtk_notebook_set_current_page(adReiter, 2)
        CASE 3
            ok = vfFoto(adDialog, "statistik_garn")
            gtk_combo_box_set_active(adErfahrung, 3)
            gtk_spin_button_set_value(adStunden, 12)
            PRINT "zeit Profi 12 h: "; vfKarten$(["gesamtzeit", "tage", "jestunde", "jefarbe"])
            PRINT "fortschritt: "; TEXT_AUS_ZEIGER$(gtk_progress_bar_get_text(adBalken)); " | "; gtk_label_get_text(adBalkenText); " | "; vfKarten$(["erledigt", "verbleibend", "farbenfertig"])
            PRINT "csv: ["; adCsvSichern$(ziel + "_statistik.csv"); "] wie kern bei 18/0/0.95: "; BUFFER_TO_STRING$(READALL_BYTES(ziel + "_statistik.csv")) = kern.statistikCsv$(lwMuster, 18, 0, 0.95)
            gtk_notebook_set_current_page(adReiter, 4)
        CASE 4
            ok = vfFoto(adDialog, "statistik_fortschritt")
            gtk_widget_destroy(adDialog)
            adDialog = 0
            DIM hd AS INTEGER : hd = hmBauen()
            PRINT "heatmap: "; gtk_label_get_text(hmText)
            gtk_combo_box_set_active(hmAchse, 1)
            gtk_range_set_value(hmBloecke, 3)
            PRINT "heatmap: "; gtk_label_get_text(hmText); " | "; gtk_label_get_text(hmBlockText)
        CASE 5
            ok = vfFoto(hmDialog, "heatmap")
            gtk_widget_destroy(hmDialog)
            hmDialog = 0
            DIM ad AS INTEGER : ad = aeBauen()
            PRINT "aehnlich 10: "; gtk_label_get_text(aeZahl); " | knopf "; gtk_widget_get_sensitive(aeKnopf)
            gtk_range_set_value(aeSchwelle, 3)
            PRINT "aehnlich 3: "; gtk_label_get_text(aeZahl)
            gtk_range_set_value(aeSchwelle, 25)
            PRINT "aehnlich 25: "; gtk_label_get_text(aeZahl)
            aeAlle(0, 1)
            PRINT "alle gewaehlt, widerspruch: "; LEFT$(aeZusammenfuehren$(), 40)
            aeAlle(0, 0)
            PRINT "keins gewaehlt: "; aeZusammenfuehren$()
            gtk_range_set_value(aeSchwelle, 10)
            aeAlle(0, 1)
        CASE 6
            ok = vfFoto(aeDialog, "aehnlich")
            DIM vorher AS INTEGER : vorher = lwMuster.farbanzahl()
            PRINT "zusammenfuehren: ["; aeZusammenfuehren$(); "] "; vorher; " -> "; lwMuster.farbanzahl(); " | "; meldung
            gtk_widget_destroy(aeDialog)
            aeDialog = 0
            werkzeugZurueck()
            PRINT "rueckgaengig: "; lwMuster.farbanzahl(); " farben, "; LEN(lwMuster.rueckstiche); " rueckstiche"
        CASE 7
            gtk_toggle_button_set_active(fbKnoepfe[2], TRUE)
            PRINT "farbenblind: "; fbArt; " | "; LEFT$(meldung, 40); " | anzeige wie kern "; lwRgb[2] = kern.farbenblind(lwMuster.farben[2].garn.farbe, kern.FARBENBLIND_DEUTERANOPIE); " | muster unveraendert "; NOT istGeaendert()
        CASE 8
            foto("farbenblind")
            gtk_toggle_button_set_active(fbKnoepfe[0], TRUE)
            PRINT "zurueck: "; fbArt; " | anzeige "; lwRgb[2] = lwMuster.farben[2].garn.farbe
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION


' Stufe 9: planen und Vorrat -- Garn-Vorrat (drei Reiter, sichern),
' Einkaufsliste in der Statistik, Palette konvertieren und zuruecknehmen,
' Farben tauschen und zuruecknehmen, Rahmenaufteilung. Der Vorrat liegt im
' Einstellungsordner (APPDATA bzw. HOME) -- eine Pruefung setzt ihn um.
FUNCTION vfZeilen$(liste AS ARRAY OF kern.Einkaufszeile) AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM z AS kern.Einkaufszeile
    FOR EACH z IN liste
        ARRAY_PUSH(t, z.schluessel + " " + STR$(z.benoetigt) + "/" + STR$(z.vorhanden) + "/" + STR$(z.kaufen))
    NEXT
    RETURN JOIN$(t, " | ")
END FUNCTION

FUNCTION vfSichtbar(zeilen AS ARRAY OF INTEGER) AS INTEGER
    DIM n AS INTEGER
    DIM z AS INTEGER
    FOR EACH z IN zeilen
        IF gtk_widget_get_visible(z) THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION

DIM vfTausch AS INTEGER

FUNCTION vorfuehrenStufe9(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    DIM i AS INTEGER
    SELECT CASE schritt
        CASE 1
            DIM d AS INTEGER : d = vdBauen()
            PRINT "vorrat datei: "; BASENAME(pdVorratDatei$()); " | "; BASENAME(DIRNAME(pdVorratDatei$()))
            PRINT "im muster: "; LEN(vdMSchl); " zeilen"
            FOR i = 0 TO LEN(vdMSchl) - 1
                PRINT "  "; vdMSchl[i]; " bedarf "; vdMBedarf[i]; " bestand "; gtk_spin_button_get_value_as_int(vdMSpin[i]); " kaufen "; gtk_label_get_text(vdMKauf[i])
            NEXT
            PRINT "alle: "; JOIN$(vdASchl, " | ")
            gtk_spin_button_set_value(vdMSpin[0], 5)
            PRINT "gesetzt "; vdMSchl[0]; " = 5: vorrat "; vdVorrat.holeSchluessel(vdMSchl[0]); " | kaufen "; gtk_label_get_text(vdMKauf[0]); " | geaendert "; vdGeaendert
            DIM j AS INTEGER
            FOR j = 0 TO LEN(vdASchl) - 1
                IF vdASchl[j] = vdMSchl[0] THEN PRINT "  im zweiten reiter: "; gtk_spin_button_get_value_as_int(vdASpin[j])
            NEXT
            gtk_spin_button_set_value(vdMSpin[1], 0)
            PRINT "auf 0: "; vdMSchl[1]; " im vorrat "; MAPHAS(vdVorrat.daten, vdMSchl[1])
        CASE 2
            ok = vfFoto(vdDialog, "vorrat")
            gtk_notebook_set_current_page(vdReiter, 1)
            gtk_entry_set_text(vdASuche, "dmc")
            vdFiltern(0, 0)
            PRINT "suche dmc: "; vfSichtbar(vdAZeile); " von "; LEN(vdAZeile)
            gtk_entry_set_text(vdASuche, "")
            vdFiltern(0, 0)
            gtk_spin_button_set_value(vdASpin[0], 7)
            PRINT "zweiter reiter "; vdASchl[0]; " = 7: vorrat "; vdVorrat.holeSchluessel(vdASchl[0])
            PRINT "leere entfernt: "; vdVorrat.leereEntfernen(); " | "; JOIN$(vdVorrat.schluessel(), " | ")
            vdAlleFuellen()
        CASE 3
            ok = vfFoto(vdDialog, "vorrat_alle")
            vdProjektAufnehmen(musterPfad)
            vdProjektAufnehmen(musterPfad)
            PRINT "projekte: "; LEN(vdProjekte.pfade); " | "; BASENAME(vdProjekte.pfade[0]); " | warnung "; gtk_widget_get_visible(vdPWarnung)
            PRINT "mehrere: "; gtk_label_get_text(vdPSumme)
            PRINT "  wie kern: "; vfZeilen$(kern.einkaufslisteMehrere(vdPMuster, vdVorrat, 20)) = vfZeilen$(kern.einkaufsliste(lwMuster, vdVorrat, 20))
            vdProjektAufnehmen(PATHJOIN(DIRNAME(musterPfad), "gibt_es_nicht.pxs"))
            PRINT "fehlt: "; gtk_widget_get_visible(vdPWarnung); " | "; LEFT$(gtk_label_get_text(vdPWarnung), 40)
            vdProjekte.entfernen(PATHJOIN(DIRNAME(musterPfad), "gibt_es_nicht.pxs"))
            vdProjekteFuellen()
            gtk_notebook_set_current_page(vdReiter, 2)
        CASE 4
            ok = vfFoto(vdDialog, "vorrat_projekte")
            PRINT "sichern: "; vdAntwort(GTK_ANTWORT_OK)
            gtk_widget_destroy(vdDialog)
            vdDialog = 0
            vdPTabelle = 0
            DIM gelesen AS kern.Vorrat : gelesen = kern.vorratLaden(pdVorratDatei$())
            PRINT "gelesen: "; JOIN$(gelesen.schluessel(), " | ")
            PRINT "projekte gelesen: "; LEN(kern.projektlisteLaden(pdProjekteDatei$()).pfade)
            ' bei 32 ct liegt Rot zwischen 0 und 50 % Zuschlag ueber einer Stranggrenze
            lwMuster.stoff = 32
            d = adStatistikBauen()
            gtk_notebook_set_current_page(adReiter, 5)
            PRINT "einkauf 32 ct 20 %: "; gtk_label_get_text(adEinkaufSumme); " | wie kern "; vfZeilen$(adEinkaufLetzte) = vfZeilen$(kern.einkaufsliste(lwMuster, gelesen, 20))
            gtk_spin_button_set_value(adZuschlag, 0)
            PRINT "einkauf 0 %: "; gtk_label_get_text(adEinkaufSumme); " | "; vfZeilen$(adEinkaufLetzte)
            gtk_spin_button_set_value(adZuschlag, 50)
            PRINT "einkauf 50 %: "; gtk_label_get_text(adEinkaufSumme); " | "; vfZeilen$(adEinkaufLetzte)
            PRINT "  wie kern: "; vfZeilen$(adEinkaufLetzte) = vfZeilen$(kern.einkaufsliste(lwMuster, gelesen, 50))
        CASE 5
            ok = vfFoto(adDialog, "statistik_einkauf")
            gtk_widget_destroy(adDialog)
            adDialog = 0
            lwMuster.stoff = 16
            DIM pd AS INTEGER : pd = pkBauen()
            PRINT "palette: "; pkNamen[gtk_combo_box_get_active(pkWahl)]; " "; gtk_label_get_text(pkInfo)
            FOR i = 0 TO LEN(pkNamen) - 1
                IF pkNamen[i] = "Anchor" THEN gtk_combo_box_set_active(pkWahl, i)
            NEXT
            PRINT "anchor: "; gtk_label_get_text(pkInfo); " | "; gtk_label_get_text(pkSumme)
            PRINT "  ziel 1: "; pkPalette.garne[pkZiele[1]].nummer; " "; FORMAT$(pkAbstaende[1], "%.1f"); " | kollisionen "; JOIN$(kern.umwandlungKollisionen(lwMuster, pkPalette, pkZiele), " / ")
        CASE 6
            ok = vfFoto(pkDialog, "palette")
            DIM alt AS STRING : alt = lwMuster.farben[1].garn.hersteller + " " + lwMuster.farben[1].garn.nummer
            DIM sym AS STRING : sym = lwMuster.farben[1].symbol
            pkKonvertieren()
            PRINT "konvertiert: "; alt; " -> "; lwMuster.farben[1].garn.hersteller; " "; lwMuster.farben[1].garn.nummer; " | symbol bleibt "; lwMuster.farben[1].symbol = sym; " | "; meldung
            gtk_widget_destroy(pkDialog)
            pkDialog = 0
            werkzeugZurueck()
            PRINT "rueckgaengig: "; lwMuster.farben[1].garn.hersteller; " "; lwMuster.farben[1].garn.nummer
            vfTausch = ftBauen()
            gtk_combo_box_set_active(ftA, 1)
            gtk_combo_box_set_active(ftB, 3)
            PRINT "tauschen: "; gtk_label_get_text(ftInfo)
        CASE 7
            ok = vfFoto(vfTausch, "tauschen")
            gtk_widget_destroy(vfTausch)
            DIM vor1 AS INTEGER : vor1 = lwMuster.farben[1].stichzahl
            DIM vor3 AS INTEGER : vor3 = lwMuster.farben[3].stichzahl
            tauschenAusfuehren(1, 3)
            PRINT "getauscht: "; meldung; " | zahlen "; vor1; " "; vor3; " -> "; lwMuster.farben[1].stichzahl; " "; lwMuster.farben[3].stichzahl
            werkzeugZurueck()
            PRINT "rueckgaengig: "; lwMuster.farben[1].stichzahl; " "; lwMuster.farben[3].stichzahl
            DIM rd AS INTEGER : rd = rdBauen()
            PRINT "rahmen: "; gtk_label_get_text(rdSumme)
            gtk_spin_button_set_value(rdBreite, 12)
            gtk_spin_button_set_value(rdHoehe, 10)
            gtk_spin_button_set_value(rdUeber, 2)
            PRINT "rahmen 12x10/2: "; gtk_label_get_text(rdSumme); " | sektoren "; LEN(rdPlan.sektoren)
            DIM letzt AS INTEGER : letzt = LEN(rdPlan.sektoren) - 1
            PRINT "  erster "; rdPlan.sektoren[0].x0; ".."; rdPlan.sektoren[0].x1 - 1; " letzter "; rdPlan.sektoren[letzt].x0; ".."; rdPlan.sektoren[letzt].x1 - 1
        CASE 8
            ok = vfFoto(rdDialog, "rahmen")
            gtk_spin_button_set_value(rdUeber, 20)
            PRINT "ueberlappung geklemmt: "; gtk_spin_button_get_value_as_int(rdUeber)
            rdVorlage(0, 0)
            PRINT "vorlage 4 zoll: "; gtk_spin_button_get_value_as_int(rdBreite); " | "; gtk_label_get_text(rdSumme)
            gtk_spin_button_set_value(rdHoehe, 5)
            PRINT "hoehe unter 10: "; gtk_spin_button_get_value_as_int(rdHoehe)
            gtk_widget_destroy(rdDialog)
            rdDialog = 0
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' --- Stufe 10: Muster anlegen und verwalten -----------------------------------------
DIM vfVgl AS INTEGER

FUNCTION vfListeZahl(liste AS INTEGER) AS INTEGER
    DIM n AS INTEGER
    WHILE gtk_list_box_get_row_at_index(liste, n) <> 0
        n = n + 1
    WEND
    RETURN n
END FUNCTION

FUNCTION vorfuehrenStufe10(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    DIM f AS STRING
    DIM i AS INTEGER
    DIM d AS INTEGER
    SELECT CASE schritt
        CASE 1
            d = ehBauen()
            PRINT "eigenschaften: stoff "; kern.stoffBezeichnung$(lwMuster); " | autor '"; gtk_entry_get_text(ehAutor); "' | begonnen "; gtk_toggle_button_get_active(ehBegonnen)
            gtk_entry_set_text(ehAutor, "Anna Schmidt")
            gtk_entry_set_text(ehCopyright, "© 2026 Anna Schmidt")
            gtk_text_buffer_set_text(gtk_text_view_get_buffer(ehNotizen), "Zeile eins" + CHR$(10) + "Zeile zwei", -1)
            gtk_toggle_button_set_active(ehBegonnen, TRUE)
            gtk_entry_set_text(ehDatum, "31.02.2026")
            DIM geaendert AS BOOLEAN
            PRINT "31.02.: "; ehUebernehmen$(geaendert); " | autor im muster '"; kern.eigenschaft$(lwMuster, "author"); "'"
            gtk_entry_set_text(ehDatum, "3.2.2026")
            PRINT "3.2.: '"; ehUebernehmen$(geaendert); "' geaendert "; geaendert
            PRINT "  im muster: "; kern.eigenschaft$(lwMuster, "author"); " | "; kern.eigenschaft$(lwMuster, "copyright"); " | "; kern.eigenschaft$(lwMuster, "started_date"); " | notizen "; LEN(SPLIT$(kern.notizen$(lwMuster), CHR$(10))); " zeilen"
            PRINT "  nochmal: '"; ehUebernehmen$(geaendert); "' geaendert "; geaendert
        CASE 2
            ok = vfFoto(ehDialog, "eigenschaften")
            gtk_widget_destroy(ehDialog)
            ehDialog = 0
            d = ehBauen()
            PRINT "wieder geoeffnet: "; gtk_entry_get_text(ehDatum); " "; gtk_toggle_button_get_active(ehBegonnen)
            gtk_widget_destroy(ehDialog)
            ehDialog = 0
            DIM b0 AS INTEGER : b0 = lwMuster.breite
            DIM h0 AS INTEGER : h0 = lwMuster.hoehe
            d = grBauen()
            PRINT "groesse: "; gtk_spin_button_get_value_as_int(grBreite); " x "; gtk_spin_button_get_value_as_int(grHoehe)
            gtk_widget_destroy(grDialog)
            grDialog = 0
            PRINT "gleich: "; grAusfuehren(b0, h0, FALSE)
            ok = grAusfuehren(b0 + 10, h0 + 6, FALSE)
            PRINT "groesser: "; lwMuster.breite; " x "; lwMuster.hoehe; " | "; meldung
            werkzeugZurueck()
            PRINT "rueckgaengig: "; lwMuster.breite; " x "; lwMuster.hoehe
            werkzeugVor()
            PRINT "wiederholt: "; lwMuster.breite; " x "; lwMuster.hoehe
            werkzeugZurueck()
            d = grBauen()
            gtk_spin_button_set_value(grBreite, 20)
            gtk_toggle_button_set_active(grSmart, TRUE)
        CASE 3
            ok = vfFoto(grDialog, "groesse")
            PRINT "dialog: "; gtk_spin_button_get_value_as_int(grBreite); " x "; gtk_spin_button_get_value_as_int(grHoehe); " smart "; gtk_toggle_button_get_active(grSmart)
            gtk_widget_destroy(grDialog)
            grDialog = 0
            DIM st0 AS INTEGER : st0 = lwMuster.sticheGesamt()
            ok = grAusfuehren(20, 15, TRUE)
            PRINT "smart: "; lwMuster.breite; " x "; lwMuster.hoehe; " stiche "; st0; " -> "; lwMuster.sticheGesamt(); " | "; meldung
            werkzeugZurueck()
            PRINT "rueckgaengig: "; lwMuster.breite; " x "; lwMuster.hoehe; " stiche "; lwMuster.sticheGesamt()
            ' Schnappschuesse
            PRINT "schluessel: "; vwSchluessel$(); " | ordner "; BASENAME(DIRNAME(kern.schnappschussOrdner$(vwSchluessel$())))
            PRINT "vorher: "; LEN(kern.schnappschuesse(vwSchluessel$()))
            vwSchnappschussWennFaellig()
            vwSchnappschussWennFaellig()
            PRINT "zweimal faellig: "; LEN(kern.schnappschuesse(vwSchluessel$()))
            f = kern.schnappschussAnlegen(lwMuster, vwSchluessel$(), ZEIT_JETZT() - 3600, kern.SCHNAPPSCHUESSE_HOECHSTENS)
            PRINT "aelter angelegt: "; LEN(kern.schnappschuesse(vwSchluessel$())); " | neuester zuerst "; kern.schnappschussZeit(kern.schnappschuesse(vwSchluessel$())[0]) > kern.schnappschussZeit(f)
            d = vsBauen()
            PRINT "versionen: "; vfListeZahl(vsListe); " eintraege | knoepfe "; gtk_widget_get_sensitive(vsKnoepfe[0])
            gtk_list_box_select_row(vsListe, gtk_list_box_get_row_at_index(vsListe, 0))
            ' das Datum ist das von heute -- die Uhrzeit wechselt, darum nur der Tag
            DIM detail AS ARRAY OF STRING : detail = SPLIT$(gtk_label_get_text(vsDetail), CHR$(10))
            PRINT "gewaehlt: "; gtk_widget_get_sensitive(vsKnoepfe[0]); " | heute "; LEFT$(detail[0], 17) = "Datum: " + ZEIT_FORMAT$(ZEIT_JETZT(), "TT.MM.JJJJ"); " | "; detail[1]
        CASE 4
            ok = vfFoto(vsDialog, "versionen")
            ' eine Zelle aendern, eine wegnehmen, dann vergleichen
            DIM e0 AS kern.Ebene : e0 = lwMuster.ebenen.ebenen[0]
            DIM k AS INTEGER
            DIM erst AS INTEGER : erst = -1
            FOR k = 0 TO LEN(e0.raster) - 1
                IF e0.raster[k] >= 0 AND erst < 0 THEN erst = k
            NEXT
            e0.raster[erst] = -1
            e0.raster[LEN(e0.raster) - 1] = 1
            lwMuster.stichzahlenNeu()
            PRINT "vergleich offen: "; vsAntwort(VS_VERGLEICH, FALSE)
            vfVgl = vgFenster
            PRINT "vergleich: neu "; vgErgebnis.neu; " weg "; vgErgebnis.weg; " anders "; vgErgebnis.anders; " | "; vgErgebnis.breite; " x "; vgErgebnis.hoehe
        CASE 5
            ok = vfFoto(vfVgl, "vergleich")
            gtk_widget_destroy(vfVgl)
            vgFenster = 0
            DIM vorher AS INTEGER : vorher = LEN(vsDateien)
            gtk_list_box_select_row(vsListe, gtk_list_box_get_row_at_index(vsListe, vorher - 1))
            PRINT "loeschen bleibt offen: "; vsAntwort(VS_LOESCHEN, FALSE); " | "; vorher; " -> "; LEN(vsDateien); " | eintraege "; vfListeZahl(vsListe)
            gtk_list_box_select_row(vsListe, gtk_list_box_get_row_at_index(vsListe, 0))
            DIM pfadVorher AS STRING : pfadVorher = musterPfad
            PRINT "wiederherstellen schliesst: "; NOT vsAntwort(VS_WIEDER, FALSE)
            PRINT "  pfad leer "; musterPfad = ""; " | ungesichert "; istGeaendert(); " | kennung bleibt "; vwSchluessel$() <> ""; " | "; LEFT$(meldung, 15)
            gtk_widget_destroy(vsDialog)
            vsDialog = 0
            ' Stickzeit
            werkzeugWaehlen(WZ_FORTSCHRITT, FALSE)
            PRINT "stickzeit laeuft: "; kern.stickzeitLaeuft(lwMuster)
            kern.stickzeitStart(lwMuster, ZEIT_UNIX() - 125)
            werkzeugWaehlen(WZ_STIFT, FALSE)
            PRINT "stickzeit: "; meldung; " | laeuft "; kern.stickzeitLaeuft(lwMuster)
            werkzeugWaehlen(WZ_FORTSCHRITT, FALSE)
            werkzeugWaehlen(WZ_STIFT, FALSE)
            PRINT "sofort wieder weg: "; meldung
            ' eigene Vorlagen
            PRINT "vorlage leer: "; vlSichern$("  ", "Eigene", "")
            PRINT "vorlage: '"; vlSichern$("Probe", "", "Ein Test"); "' | doppelt: "; vlSichern$("Probe", "Eigene", "")
            PRINT "vorlage 2: '"; vlSichern$("Zweite", "Kissen", ""); "' | datei "; BASENAME(vwVorlagenDatei$())
            vlDaten = kern.eigeneVorlagen(vwVorlagenDatei$())
            PRINT "umbenennen auf vergeben: "; vlAendern$(0, "Zweite", FALSE)
            PRINT "umbenennen: '"; vlAendern$(0, "Erste", FALSE); "'"
            PRINT "loeschen: '"; vlAendern$(1, "", TRUE); "'"
            DIM vv AS kern.Vorlage
            FOR EACH vv IN kern.eigeneVorlagen(vwVorlagenDatei$())
                PRINT "  "; vv.name; " "; vv.breite; "x"; vv.hoehe; " "; vv.stoff; " "; vv.kategorie; " '"; vv.beschreibung; "'"
            NEXT
            ' Neues Muster
            d = nmBauen()
            PRINT "neu: karten "; LEN(nmListe); " | breite "; gtk_spin_button_get_value_as_int(nmBreite); " | "; REPLACE$(gtk_label_get_text(nmInfo), CHR$(10), " / ")
            gtk_toggle_button_set_active(nmKategorien[1], TRUE)
            PRINT "eigene: "; LEN(nmListe); " | gewaehlt "; nmName$(); " "; gtk_spin_button_get_value_as_int(nmBreite); "x"; gtk_spin_button_get_value_as_int(nmHoehe); " | felder frei "; gtk_widget_get_sensitive(nmBreite)
            gtk_toggle_button_set_active(nmKategorien[2], TRUE)
        CASE 6
            ok = vfFoto(nmDialog, "neu")
            PRINT "kategorie "; kern.vorlagenKategorien()[0]; ": "; LEN(nmListe); " karten | "; nmName$(); " "; gtk_spin_button_get_value_as_int(nmBreite); "x"; gtk_spin_button_get_value_as_int(nmHoehe)
            gtk_toggle_button_set_active(nmKarten[1], TRUE)
            PRINT "zweite karte: "; nmName$(); " "; gtk_spin_button_get_value_as_int(nmBreite); "x"; gtk_spin_button_get_value_as_int(nmHoehe)
            gtk_toggle_button_set_active(nmKategorien[0], TRUE)
            gtk_combo_box_set_active(nmDpWahl, 2)
            PRINT "dp: "; kern.dpVorlagenNamen()[2]; " "; gtk_spin_button_get_value_as_int(nmBreite); "x"; gtk_spin_button_get_value_as_int(nmHoehe); " dp "; nmDp
            nmAnlegen()
            PRINT "angelegt: "; lwMuster.breite; "x"; lwMuster.hoehe; " "; lwMuster.modus; " stoff "; INT(lwMuster.stoff); " farben "; lwMuster.farbanzahl(); " | "; meldung; " | pfad leer "; musterPfad = ""; " | geaendert "; istGeaendert()
            gtk_combo_box_set_active(nmDpWahl, 0)
            gtk_spin_button_set_value(nmBreite, 40)
            gtk_spin_button_set_value(nmHoehe, 30)
            gtk_combo_box_set_active(nmStoff, 0)
            PRINT "eigene werte: "; REPLACE$(gtk_label_get_text(nmInfo), CHR$(10), " / ")
            nmAnlegen()
            PRINT "angelegt: "; lwMuster.breite; "x"; lwMuster.hoehe; " "; lwMuster.modus; " stoff "; INT(lwMuster.stoff); " | "; meldung
            gtk_widget_destroy(nmDialog)
            nmDialog = 0
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' --- Stufe 11: Farb-Harmonien und Bibliothek -------------------------------------------
' Die Bibliothek nimmt die Muster im Ordner "sammlung" neben dem Arbeitsordner auf.
DIM vfHinzu AS INTEGER
DIM vfGewaehlt AS INTEGER

FUNCTION vfHarmonien$() AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(hdVorschlaege) - 1
        DIM v AS kern.Harmonievorschlag : v = hdVorschlaege[i]
        DIM p AS STRING, b AS STRING, st AS INTEGER
        (p, b, st) = kern.harmonieBewertung(v.abstand)
        DIM g AS kern.Garn : g = hdGarn(i)
        ARRAY_PUSH(t, v.name + " " + IIF(g IS NIL, "-", g.hersteller + " " + g.nummer) + " " + b)
    NEXT
    RETURN JOIN$(t, " | ")
END FUNCTION

FUNCTION vfBibliothek$() AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM p AS INTEGER
    FOR EACH p IN bbPlaetze
        ARRAY_PUSH(t, bbBib.eintraege[p].name)
    NEXT
    RETURN JOIN$(t, " | ")
END FUNCTION

FUNCTION vfKategorien$() AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(bbBib.kategorien) - 1
        DIM n AS INTEGER : n = kern.kategorieZahl(bbBib, bbBib.kategorien[i])
        IF n > 0 OR i < 2 THEN ARRAY_PUSH(t, bbBib.kategorien[i] + " " + STR$(n))
    NEXT
    RETURN JOIN$(t, ", ")
END FUNCTION

FUNCTION vorfuehrenStufe11(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    DIM i AS INTEGER
    SELECT CASE schritt
        CASE 1
            wzFarbe = 2
            DIM d AS INTEGER : d = hdBauen()
            DIM q AS kern.Garn : q = lwMuster.farben[hdQuelle].garn
            PRINT "harmonie: quelle "; q.hersteller; " "; q.nummer; " | palette "; slPaletten[gtk_combo_box_get_active(hdPalWahl)].name; " | "; gtk_label_get_text(hdInfo)
            PRINT "  "; gtk_label_get_text(hdBeschreibung); " | "; vfHarmonien$()
            gtk_combo_box_set_active(hdArt, 4)
            PRINT "tetrade: "; vfHarmonien$()
            hdKarteKippen(0)
            hdKarteKippen(2)
            PRINT "zwei gewaehlt: "; TEXT_AUS_ZEIGER$(gtk_button_get_label(hdHinzu)); " "; gtk_widget_get_sensitive(hdHinzu)
        CASE 2
            ok = vfFoto(hdDialog, "harmonie")
            hdAlle(0, 0)
            PRINT "keine: "; TEXT_AUS_ZEIGER$(gtk_button_get_label(hdHinzu)); " "; gtk_widget_get_sensitive(hdHinzu)
            hdAlle(0, 1)
            PRINT "alle: "; TEXT_AUS_ZEIGER$(gtk_button_get_label(hdHinzu))
            DIM vorher AS INTEGER : vorher = lwMuster.farbanzahl()
            vfHinzu = hdHinzufuegen()
            PRINT "hinzugefuegt: "; vfHinzu; " | farben "; vorher; " -> "; lwMuster.farbanzahl(); " | "; meldung
            PRINT "  nochmal: "; hdHinzufuegen(); " | "; meldung
            gtk_widget_destroy(hdDialog)
            hdDialog = 0
            FOR i = 1 TO vfHinzu
                werkzeugZurueck()
            NEXT
            PRINT "rueckgaengig: farben "; lwMuster.farbanzahl(); " | ungesichert "; istGeaendert()
            ' Bibliothek
            d = bbBauen()
            PRINT "bibliothek leer: "; gtk_label_get_text(bbInfo); " | "; vfKategorien$()
            PRINT "aufgenommen: "; bbAufnehmenAlle(kern.musterDateien(PATHJOIN(STARTDIR$(), "sammlung"))); " | nochmal: "; bbAufnehmenAlle(kern.musterDateien(PATHJOIN(STARTDIR$(), "sammlung")))
            PRINT "  "; vfBibliothek$(); " | "; gtk_label_get_text(bbInfo)
            PRINT "  "; vfKategorien$()
            bbVorschauAlle()
            PRINT "vorschaubilder: "; LEN(DIRLIST(bbThumbOrdner$(), "*.png"))
        CASE 3
            ok = vfFoto(bbDialog, "bibliothek")
            gtk_combo_box_set_active(bbSort, 2)
            PRINT "nach groesse: "; vfBibliothek$()
            bbWaehlen(bbPlaetze[0])
            PRINT "gewaehlt: "; gtk_label_get_text(bbDetail); " | oeffnen "; gtk_widget_get_sensitive(bbOeffnen)
            gtk_entry_set_text(bbTags, " rot, gross ,, ")
            gtk_text_buffer_set_text(gtk_text_view_get_buffer(bbNotizen), "Für den Flur  ", -1)
            vfGewaehlt = bbGewaehlt
            bbWaehlen(bbPlaetze[1])
            PRINT "uebernommen: "; JOIN$(bbBib.eintraege[vfGewaehlt].tags, "|"); " | '"; bbBib.eintraege[vfGewaehlt].notizen; "'"
            gtk_entry_set_text(bbSuche, "ROT")
            bbFuellen()
            PRINT "suche rot: "; vfBibliothek$(); " | "; gtk_label_get_text(bbInfo)
            gtk_entry_set_text(bbSuche, "")
            bbFavorit(vfGewaehlt)
            bbKategorieKippen(vfGewaehlt, "Tiere")
            PRINT "favorit und tiere: "; vfKategorien$()
            gtk_list_box_select_row(bbKatListe, gtk_list_box_get_row_at_index(bbKatListe, 1))
            PRINT "favoriten: "; vfBibliothek$()
            PRINT "alle loeschen: "; bbKategorieLoeschen(0, FALSE); " | tiere loeschen: "; bbKategorieLoeschen(ARRAY_INDEXOF(bbBib.kategorien, "Tiere"), FALSE); " | "; vfKategorien$()
            gtk_list_box_select_row(bbKatListe, gtk_list_box_get_row_at_index(bbKatListe, 0))
            bbWaehlen(vfGewaehlt)
        CASE 4
            ok = vfFoto(bbDialog, "bibliothek_auswahl")
            PRINT "vor dem oeffnen: "; musterTitel
            bbOeffnenGeklickt(0, 0)
            PRINT "geoeffnet: "; musterTitel; " | "; meldung; " | zuletzt "; bbBib.eintraege[vfGewaehlt].geoeffnet <> ""
            bbSchliessen()
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' --- Stufe 12: Muster-Vorschau ---------------------------------------------------------
' Das Muster aus dem Aufruf; "drills.pxs" neben dem Arbeitsordner fuer das
' Diamond Painting.
FUNCTION vfVorschauInfo$() AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM l AS INTEGER
    FOR EACH l IN vdlInfo
        IF gtk_widget_get_visible(l) THEN ARRAY_PUSH(t, gtk_label_get_text(l))
    NEXT
    RETURN JOIN$(t, " | ")
END FUNCTION

FUNCTION vorfuehrenStufe12(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    DIM i AS INTEGER
    SELECT CASE schritt
        CASE 1
            DIM d AS INTEGER : d = vdlBauen(lwMuster)
            PRINT "vorschau: "; TEXT_AUS_ZEIGER$(gtk_window_get_title(vdlDialog)); " | "; vfVorschauInfo$()
            PRINT "  "; gtk_label_get_text(vdlArtText)
        CASE 2
            PRINT "eingepasst: zoom "; vdlZoom; " zelle "; vdlZelle(); " | regler "; INT(gtk_range_get_value(vdlRegler)); " | "; gtk_label_get_text(vdlZoomText)
            ok = vfFoto(vdlDialog, "vorschau_stoff")
            gtk_combo_box_set_active(vdlArt, 1)
            gtk_combo_box_set_active(vdlStoff, 0)
            PRINT "pixel, aida 11: "; vfVorschauInfo$(); " | "; LEFT$(gtk_label_get_text(vdlArtText), 14)
            gtk_combo_box_set_active(vdlStoffFarbe, 6)
        CASE 3
            ok = vfFoto(vdlDialog, "vorschau_pixel")
            gtk_combo_box_set_active(vdlArt, 2)
            gtk_toggle_button_set_active(vdlFertig, TRUE)
            PRINT "symbol: stoff waehlbar "; gtk_widget_get_sensitive(vdlStoff); " "; gtk_widget_get_sensitive(vdlStoffFarbe); " | stil "; vdlStil().art; " erledigt "; vdlStil().erledigt
            vdlKnopf(0, 1)
            PRINT "1:1: zoom "; vdlZoom; " | "; gtk_label_get_text(vdlZoomText)
            vdlRadZoom(TRUE, FALSE, 100, 100)
            PRINT "rad rein: "; vdlZoom; " | rein fein: ";
            vdlRadZoom(TRUE, TRUE, 100, 100)
            PRINT vdlZoom; " | raus: ";
            vdlRadZoom(FALSE, FALSE, 100, 100)
            PRINT vdlZoom
            ' gezoomt wird um den Punkt unter der Maus
            DIM gx AS FLOAT : gx = (100 - vdlPanX) / vdlZelle()
            DIM gy AS FLOAT : gy = (60 - vdlPanY) / vdlZelle()
            vdlRadZoom(TRUE, FALSE, 100, 60)
            PRINT "punkt unter der maus bleibt: "; ABS((100 - vdlPanX) / vdlZelle() - gx) < 0.001 AND ABS((60 - vdlPanY) / vdlZelle() - gy) < 0.001; " | zelle "; vdlZelle()
            FOR i = 1 TO 40
                vdlRadZoom(TRUE, FALSE, 0, 0)
            NEXT
            PRINT "ganz rein: "; vdlZoom; " zelle "; vdlZelle()
            FOR i = 1 TO 60
                vdlRadZoom(FALSE, FALSE, 0, 0)
            NEXT
            PRINT "ganz raus: "; vdlZoom; " zelle "; vdlZelle()
            gtk_range_set_value(vdlRegler, 150)
            PRINT "regler 150: "; vdlZoom; " | "; gtk_label_get_text(vdlZoomText)
            vdlEinpassen()
        CASE 4
            ok = vfFoto(vdlDialog, "vorschau_symbol")
            DIM ziel AS STRING : ziel = PATHJOIN(STARTDIR$(), "vorschau_export.png")
            PRINT "bild: '"; vdlBildSchreiben$(12, ziel); "' | da "; FILEEXISTS(ziel)
            gtk_widget_destroy(vdlDialog)
            vdlDialog = 0
            DIM dp AS kern.Muster : dp = kern.pxsLaden(PATHJOIN(STARTDIR$(), "drills.pxs"))
            d = vdlBauen(dp)
            PRINT "drills: arten "; gtk_tree_model_iter_n_children(gtk_combo_box_get_model(vdlArt), 0); " | stoff sichtbar "; gtk_widget_get_visible(vdlStoff); " rueck "; gtk_widget_get_visible(vdlRueck); " | "; vfVorschauInfo$()
            PRINT "  "; gtk_label_get_text(vdlArtText)
        CASE 5
            ok = vfFoto(vdlDialog, "vorschau_drills")
            gtk_widget_destroy(vdlDialog)
            vdlDialog = 0
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' --- Stufe 13: Einstellungen -----------------------------------------------------------
' Der Einstellungsordner kommt aus APPDATA/HOME (die Pruefung setzt ihn um);
' sie liest danach die einstellungen.json.
FUNCTION vfKu(kennung AS STRING) AS INTEGER
    DIM a AS ARRAY OF kern.Kuerzelaktion : a = kern.kuerzelAktionen()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(a) - 1
        IF a[i].kennung = kennung THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION vfHex$(f AS INTEGER) AS STRING
    RETURN RIGHT$("000000" + HEX$(f), 6)
END FUNCTION

FUNCTION vorfuehrenStufe13(daten AS INTEGER) AS BOOLEAN
    schritt = schritt + 1
    DIM ok AS BOOLEAN
    DIM d AS INTEGER
    SELECT CASE schritt
        CASE 1
            d = edBauen()
            PRINT "vorgaben: raster "; gtk_spin_button_get_value_as_int(edHaupt); "/"; gtk_spin_button_get_value_as_int(edNeben); " zelle "; gtk_spin_button_get_value_as_int(edZelle); " zoom "; gtk_spin_button_get_value(edZoom); " pipette "; gtk_combo_box_get_active(edPipette); " anzeige "; gtk_combo_box_get_active(edAnzeige); " palette "; edPalNamen[gtk_combo_box_get_active(edPalette)]
            PRINT "farben: "; vfHex$(edFarbe(edFarbeNormal)); " "; vfHex$(edFarbe(edFarbeNeben)); " "; vfHex$(edFarbe(edFarbeHaupt)); " | stoff "; vfHex$(edFarbe(edStoff))
            PRINT "kuerzel: sichern "; gtk_label_get_text(edKuText[vfKu("sichern")]); " | vor "; gtk_label_get_text(edKuText[vfKu("vor")]); " | zoom_rein "; gtk_label_get_text(edKuText[vfKu("zoom_rein")]); " | "; LEN(edKuText); " Befehle"
            ok = vfFoto(edDialog, "einstellungen")
        CASE 2, 3, 4, 5, 6
            ' jeder Reiter einmal im Bild (gezeichnet wird erst im naechsten Takt)
            IF schritt > 2 THEN ok = vfFoto(edDialog, "einstellungen_" + STR$(schritt - 2))
            gtk_notebook_set_current_page(edReiter, schritt - 1)
        CASE 7
            ok = vfFoto(edDialog, "einstellungen_kuerzel")
            gtk_spin_button_set_value(edNeben, 9)
            gtk_spin_button_set_value(edHaupt, 8)
            PRINT "neben nach haupt 8: "; gtk_spin_button_get_value_as_int(edNeben)
            gtk_spin_button_set_value(edNeben, 4)
            edFarbeSetzen(edFarbeHaupt, &HC00000)
            gtk_spin_button_set_value(edZelle, 30)
            gtk_spin_button_set_value(edZoom, 1.5)
            gtk_combo_box_set_active(edPipette, 1)
            gtk_spin_button_set_value(edToleranz, 100)
            gtk_toggle_button_set_active(edDiagonal, TRUE)
            gtk_toggle_button_set_active(edKatalog, FALSE)
            gtk_spin_button_set_value(edSymGroesse, 14)
            gtk_combo_box_set_active(edAnzeige, 2)
            gtk_spin_button_set_value(edMeldung, 7)
            gtk_entry_set_text(edAutor, " Anna Müller ")
            PRINT "kuerzel setzen: '"; edKuSetzen$(vfKu("sichern"), "f2"); "' | '"; edKuSetzen$(vfKu("export"), "F2"); "' | '"; edKuSetzen$(vfKu("export"), "Hyper+X"); "' | '"; edKuSetzen$(vfKu("vorschau"), "Strg+S"); "'"
            PRINT "angezeigt: "; gtk_label_get_text(edKuText[vfKu("sichern")]); " | "; gtk_label_get_text(edKuText[vfKu("vorschau")])
            edUebernehmen()
            PRINT "uebernommen: raster "; einst.rasterHaupt; "/"; einst.rasterNeben; " haupt "; vfHex$(einst.hauptFarbe); " zelle "; einst.zelleStandard; " zoom "; einst.zoomTempo; " pipette "; einst.pipetteDanach; " toleranz "; einst.fuellToleranz; " diagonal "; einst.fuellenDiagonal; " katalog "; einst.katalog; " symbol "; einst.symbolGroesse; " anzeige "; einst.farbAnzeige; " meldung "; einst.meldungSekunden; " autor '"; einst.autor; "'"
            PRINT "tafel: F2 "; MAPGETOR(einstTafel, "F2", "-"); " | Strg+S "; MAPGETOR(einstTafel, "Strg+S", "-"); " | sichern "; kern.kuerzelVon$(einst, "sichern")
            PRINT "tooltip: "; TEXT_AUS_ZEIGER$(gtk_widget_get_tooltip_text(kSichern))
            PRINT "datei: "; FILEEXISTS(einst.pfad)
            gtk_widget_destroy(edDialog)
            edDialog = 0
        CASE 8
            ok = vfFoto(fenster, "nur_symbol")
            befehlAusfuehren("zoom_100")
            PRINT "100 %: zelle "; lwZelle; " | "; leinwandZoomProzent(); " %"
            befehlAusfuehren("zoom_rein")
            PRINT "zoom rein: "; leinwandZoomProzent(); " %"
            ' Fuellen auf der untersten Ebene: gleiche Farben liegen dort auf
            ' Schraegen -- diagonal haengen sie zusammen, gerade nicht
            lwMuster.ebenen.aktiv = 0
            DIM e AS kern.Ebene : e = lwMuster.ebenen.aktiveEbene()
            DIM fx AS INTEGER : fx = 4
            DIM fy AS INTEGER : fy = 1
            wzFarbe = lwMuster.farbanzahl() - 1
            IF e.raster[fy * e.breite + fx] = wzFarbe THEN wzFarbe = 0
            PRINT "fuellen: gerade "; LEN(kern.fuellung(e, fx, fy, wzFarbe)) \ 2; " | diagonal mit toleranz "; LEN(wzFuellung(e, fx, fy)) \ 2; " | ziel "; e.raster[fy * e.breite + fx]
            werkzeugWaehlen(WZ_PIPETTE, FALSE)
            DIM zug AS INTEGER : zug = wzDruck(fx, fy, 1, FALSE)
            wzLos(fx, fy, FALSE)
            PRINT "pipette: werkzeug "; wzAktiv; " | farbe "; wzFarbe; " = "; lwMuster.stich(fx, fy); " | "; meldung
        CASE 9
            d = roBauen()
            roVoreinstellung(0, 2)
            PRINT "raster-optionen blau: "; gtk_spin_button_get_value_as_int(roHaupt); "/"; gtk_spin_button_get_value_as_int(roNeben); " "; vfHex$(edFarbe(roNormal)); " "; vfHex$(edFarbe(roNebenFarbe)); " "; vfHex$(edFarbe(roHauptFarbe))
            ok = vfFoto(roDialog, "raster_optionen")
            roUebernehmen()
            PRINT "uebernommen: "; einst.rasterHaupt; "/"; einst.rasterNeben; " "; vfHex$(einst.rasterFarbe); " "; vfHex$(einst.nebenFarbe); " "; vfHex$(einst.hauptFarbe)
            gtk_widget_destroy(roDialog)
            roDialog = 0
            ok = vfFoto(fenster, "raster_blau")
        CASE 10
            d = edBauen()
            DIM v AS kern.Einstellungen : v = NEW kern.Einstellungen()
            edFuellen(v)
            edUebernehmen()
            PRINT "zurueckgesetzt: raster "; einst.rasterHaupt; "/"; einst.rasterNeben; " zoom "; einst.zoomTempo; " anzeige "; einst.farbAnzeige; " sichern "; kern.kuerzelVon$(einst, "sichern"); " | eigene kuerzel "; LEN(MAPKEYS(einst.kuerzel)); " | autor '"; einst.autor; "'"
            gtk_widget_destroy(edDialog)
            edDialog = 0
        CASE 11
            PRINT "zuletzt: "; LEN(zlPfade); " "; BASENAME(zlPfade[0])
            werkzeugWaehlen(WZ_STIFT, FALSE)
            wzFarbe = 0
            DIM zug2 AS INTEGER : zug2 = wzDruck(0, 0, 1, FALSE)
            wzLos(0, 0, FALSE)
            PRINT "automatisch: "; autosichernJetzt(); " | "; RIGHT$(asZiel$(), 16); " da "; FILEEXISTS(asZiel$())
            DIM ord AS STRING : ord = asOrdner$()
            COPYFILE(musterPfad, PATHJOIN(ord, "tot.pxs"))
            COPYFILE(musterPfad, PATHJOIN(ord, "lebend.pxs"))
            WRITEALL(PATHJOIN(ord, "lebend.lebt"), "x")
            DIM v2 AS STRING
            DIM liste AS ARRAY OF STRING : liste = []
            FOR EACH v2 IN asVerwaist()
                ARRAY_PUSH(liste, BASENAME(v2))
            NEXT
            PRINT "verwaist: "; JOIN$(liste, " ")
            DIM gesichert AS BOOLEAN : gesichert = musterSichern(musterPfad)
            PRINT "gesichert: "; gesichert; " | autosave weg "; NOT FILEEXISTS(musterPfad + ".autosave"); " | bak "; FILEEXISTS(musterPfad + ".bak")
        CASE ELSE
            schliessenErlaubt = TRUE
            gtk_widget_destroy(fenster)
            RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION

' --probe-start: was der Start aus den Einstellungen gemacht hat (ohne Datei
' im Aufruf -- dann gilt die Startaktion), danach zu.
FUNCTION vorfuehrenStart(daten AS INTEGER) AS BOOLEAN
    DIM b AS INTEGER, h AS INTEGER
    gtk_window_get_size(fenster, b, h)
    PRINT "start: "; musterTitel; " | "; lwMuster.breite; "x"; lwMuster.hoehe; " | datei "; BASENAME(musterPfad); " | werkzeug "; wzAktiv; " | fenster "; b; "x"; h; " | zuletzt "; LEN(zlPfade)
    PRINT "kuerzel: "; TEXT_AUS_ZEIGER$(gtk_widget_get_tooltip_text(kSichern)); " | export "; kern.kuerzelVon$(einst, "export"); " | F2 "; MAPGETOR(einstTafel, "F2", "-")
    ' wie das Kreuz: Fenster messen, dann zu (gemerkt wird beim Ende)
    werkzeugWaehlen(WZ_LINIE, FALSE)
    fensterMessen()
    schliessenErlaubt = TRUE
    gtk_widget_destroy(fenster)
    RETURN FALSE
END FUNCTION
