' Schriftstile: TEXT_STYLE/TEXT_BOLD/TEXT_ITALIC fuer TEXT, FONT_STYLE und
' FONT_HAS_STYLE fuer die echten Schnitte, GUI_SET_FONT_STYLE je Widget.
' Wo es keinen Schnitt als Datei gibt (die eingebaute Schrift), bildet die
' Laufzeit ihn nach -- die Bildfaelle pruefen genau diesen Ersatz.
' Format: docs/werkzeuge.md.

=== stil setzen lesen und mit gfx push pop zurueckholen
SCREEN(200, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
PRINT TEXT_GET_STYLE$()
TEXT_STYLE("fett+kursiv")
PRINT TEXT_GET_STYLE$()
TEXT_BOLD(FALSE)
PRINT TEXT_GET_STYLE$()
TEXT_BOLD(TRUE) : TEXT_ITALIC(FALSE)
PRINT TEXT_GET_STYLE$()
TEXT_STYLE("bold, underline, strikethrough")
PRINT TEXT_GET_STYLE$()
GFX_PUSH()
TEXT_STYLE("normal")
PRINT TEXT_GET_STYLE$()
GFX_POP()
PRINT TEXT_GET_STYLE$()
--- erwartet
normal
fett+kursiv
kursiv
fett
fett+unterstrichen+durchgestrichen
normal
fett+unterstrichen+durchgestrichen

=== ein unbekannter stil ist ein fehler
SCREEN(200, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
TEXT_STYLE("fett+fet")
--- fehler
TEXT_STYLE: unbekannter Schriftstil 'fet'

=== die eingebaute schrift hat keine schnitte
SCREEN(200, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
PRINT FONT_HAS_STYLE(-1, "fett"); " "; FONT_STYLE(-1, "fett")
PRINT FONT_HAS_STYLE(-1, "unterstrichen")
--- erwartet
FALSE -1
TRUE

=== segoe ui bringt ihre schnitte mit
' Unterstrichen braucht keinen Schnitt, darum TRUE und dasselbe Handle.
' Tahoma hat keinen Kursivschnitt -- dort bleibt es beim Ersatz.
SCREEN(200, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM f AS INTEGER : f = LOADFONT("C:/Windows/Fonts/segoeui.ttf", 32)
PRINT FONT_HAS_STYLE(f, "fett"); " "; FONT_HAS_STYLE(f, "kursiv"); " "; FONT_HAS_STYLE(f, "fett+kursiv")
PRINT (FONT_STYLE(f, "fett") <> f); " "; (FONT_STYLE(f, "fett") <> FONT_STYLE(f, "kursiv"))
PRINT (FONT_STYLE(f, "unterstrichen") = f)
DIM t AS INTEGER : t = LOADFONT("C:/Windows/Fonts/tahoma.ttf", 32)
PRINT FONT_HAS_STYLE(t, "fett"); " "; FONT_HAS_STYLE(t, "kursiv")
SETFONT(f)
DIM w0 AS INTEGER : w0 = TEXT_WIDTH("Wolkenkratzer")
TEXT_STYLE("fett")
DIM w1 AS INTEGER : w1 = TEXT_WIDTH("Wolkenkratzer")
PRINT "fett breiter "; (w1 > w0)
--- system windows
--- erwartet
TRUE TRUE TRUE
TRUE TRUE
TRUE
TRUE FALSE
fett breiter TRUE

=== ersatz fett kursiv und linien im bild
' Links normal, rechts mit Stil -- jeweils dasselbe Wort in der eingebauten
' Schrift. Gezaehlt wird im Bild: Fett hat mehr Punkte, Kursiv liegt oben
' weiter rechts als unten, die Linien stehen unter bzw. mitten im Text.
SCREEN(400, 400, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
WHILE NOT QUITREQUESTED()
    CLS(0)
    TEXT_SIZE(40)
    TEXT_STYLE("normal") : TEXT(10, 10, "III", WHITE)
    TEXT_STYLE("fett") : TEXT(210, 10, "III", WHITE)
    TEXT_STYLE("normal") : TEXT(10, 110, "I", WHITE)
    TEXT_STYLE("kursiv") : TEXT(210, 110, "I", WHITE)
    TEXT_STYLE("normal") : TEXT(10, 210, "III", WHITE)
    TEXT_STYLE("unterstrichen") : TEXT(210, 210, "III", WHITE)
    TEXT_STYLE("durchgestrichen") : TEXT(210, 310, "I  I", WHITE)
    TEXT_STYLE("normal") : TEXT(10, 310, "I  I", WHITE)
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=4
DHRT_SCREENSHOT={fall}/bild.png
--- nachher
DIM b AS IMAGE : b = LOADIMAGE("bild.png")
FUNCTION hell(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    RETURN (GETPIXEL(b, x, y) BAND &HFF) > 128
END FUNCTION
FUNCTION zahl(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER) AS INTEGER
    DIM n AS INTEGER : n = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = y0 TO y1
        FOR x = x0 TO x1
            IF hell(x, y) THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
' Mittlere x-Lage der hellen Punkte in einem Streifen.
FUNCTION mitte(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER) AS FLOAT
    DIM s AS FLOAT : s = 0
    DIM n AS INTEGER : n = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = y0 TO y1
        FOR x = x0 TO x1
            IF hell(x, y) THEN s = s + x : n = n + 1
        NEXT
    NEXT
    IF n = 0 THEN RETURN 0
    RETURN s / n
END FUNCTION
DIM normal AS INTEGER : normal = zahl(0, 0, 199, 99)
DIM fett AS INTEGER : fett = zahl(200, 0, 399, 99)
PRINT "fett hat mehr punkte "; (fett > normal * 5 \ 4)
DIM nOben AS FLOAT : nOben = mitte(0, 110, 199, 125)
DIM nUnten AS FLOAT : nUnten = mitte(0, 135, 199, 148)
DIM kOben AS FLOAT : kOben = mitte(200, 110, 399, 125)
DIM kUnten AS FLOAT : kUnten = mitte(200, 135, 399, 148)
PRINT "normal steht gerade "; (ABS(nOben - nUnten) < 1)
PRINT "kursiv neigt sich "; (kOben - kUnten > 3)
' Unter dem Text (y 10+36 .. 10+40 der Zeile bei 210) nur mit Linie Punkte.
PRINT "ohne linie leer "; (zahl(0, 246, 199, 252) = 0)
PRINT "unterstrichen "; (zahl(200, 246, 399, 252) > 30)
' Zwischen den beiden I liegt nur beim Durchstreichen etwas.
' "I" ist 12 breit, die zwei Leerzeichen 28 -- die Luecke liegt bei 28..50.
DIM lueckeN AS INTEGER : lueckeN = zahl(28, 310, 50, 349)
DIM lueckeD AS INTEGER : lueckeD = zahl(228, 310, 250, 349)
PRINT "luecke normal leer "; (lueckeN = 0)
PRINT "durchgestrichen "; (lueckeD > 10)
--- erwartet
fett hat mehr punkte TRUE
normal steht gerade TRUE
kursiv neigt sich TRUE
ohne linie leer TRUE
unterstrichen TRUE
luecke normal leer TRUE
durchgestrichen TRUE

=== stil je widget und in der dhform
IMPORT "gui"
SCREEN(300, 200, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Kasten", 10, 10, 280, 180)
DIM l AS GUI_WIDGET : l = GUI_LABEL(w, "Hallo", 10, 10)
PRINT GUI_GET_FONT_STYLE$(l)
GUI_SET_FONT_STYLE(l, "kursiv+fett")
PRINT GUI_GET_FONT_STYLE$(l)
DIM j AS STRING : j = GUI_TO_JSON(w)
PRINT "in der form "; (INSTR(j, CHR$(34) + "font_style" + CHR$(34)) >= 0 AND INSTR(j, CHR$(34) + "fett+kursiv" + CHR$(34)) >= 0)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT GUI_GET_FONT_STYLE$(GUI_WINDOW_WIDGET(w2, 0))
GUI_SET_FONT_STYLE(l, "normal")
PRINT "normal nicht in der form "; (INSTR(GUI_TO_JSON(w), "font_style") < 0)
TRY
    GUI_SET_FONT_STYLE(l, "dick")
CATCH e
    PRINT e
END TRY
--- erwartet
normal
fett+kursiv
in der form TRUE
fett+kursiv
normal nicht in der form TRUE
GUI_SET_FONT_STYLE: unbekannter Schriftstil 'dick' (erlaubt: normal, fett, kursiv, unterstrichen, durchgestrichen -- verbunden mit + oder Komma)

=== ein widget mit stil zeichnet unterstrichen
' Eine Beschriftung mit Linie gegen dieselbe ohne, gleiche Lage in zwei
' Fenstern: nur unter der einen stehen Punkte in der Textfarbe.
IMPORT "gui"
SCREEN(400, 200, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM wa AS GUI_WINDOW : wa = GUI_WINDOW("A", 0, 0, 200, 200)
DIM wb AS GUI_WINDOW : wb = GUI_WINDOW("B", 200, 0, 200, 200)
DIM la AS GUI_WIDGET : la = GUI_LABEL(wa, "IIIIII", 10, 40)
DIM lb AS GUI_WIDGET : lb = GUI_LABEL(wb, "IIIIII", 10, 40)
GUI_SET_FONT_SIZE(la, 30) : GUI_SET_FONT_SIZE(lb, 30)
GUI_SET_COLOR(la, "fg", &HFF0000) : GUI_SET_COLOR(lb, "fg", &HFF0000)
GUI_SET_FONT_STYLE(lb, "unterstrichen")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=4
DHRT_SCREENSHOT={fall}/bild.png
--- nachher
DIM b AS IMAGE : b = LOADIMAGE("bild.png")
FUNCTION rot(x0 AS INTEGER, x1 AS INTEGER) AS INTEGER
    ' die unterste Zeile mit roten Punkten
    DIM y AS INTEGER
    DIM x AS INTEGER
    DIM tief AS INTEGER : tief = -1
    FOR y = 0 TO 199
        FOR x = x0 TO x1
            DIM c AS INTEGER : c = GETPIXEL(b, x, y)
            IF ((c SHR 16) BAND 255) > 180 AND ((c SHR 8) BAND 255) < 80 THEN tief = y
        NEXT
    NEXT
    RETURN tief
END FUNCTION
' Die Linie liegt unter den Buchstaben, also tiefer als deren Fuss.
PRINT "linie tiefer "; (rot(200, 399) > rot(0, 199))
--- erwartet
linie tiefer TRUE
