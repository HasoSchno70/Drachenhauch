DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 200, 100)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 0, 0, 180, 80)
GUI_TEXTAREA_HINTS(ta, [1, 2], ["x"])
