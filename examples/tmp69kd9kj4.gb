' === GameBasic Sprite-Editor Demo ===
'
' Zeigt, wie ein Sprite-Sheet, das mit dem Sprite-Editor (gbsprites)
' erstellt wurde, in einem Programm verwendet wird.
'
' Das Sheet "assets/coin_anim.png" enthaelt 4 Frames a 16x16 Pixel
' (mit Alpha-Kanal). Es wurde so erzeugt, wie es der Sprite-Editor
' beim "Sheet-PNG exportieren" auch tut.
'
' Eigene Sprites erstellen:
'   gbsprites              -- Editor leer starten
'   gbsprites <datei.png>  -- bestehendes PNG laden
'
' Im Code-Editor: Werkzeuge -> Sprite-Editor oeffnen
'

IMPORT "sprite"

Screen(320, 240, "Sprite-Editor Demo")

DIM sheet AS IMAGE
sheet = LoadImage("assets/coin_anim.png")

' Zentrales Coin: Animation registrieren -- Frames 0..3 mit 8 fps,
' looped (SPRITE_PLAY statt SPRITE_PLAY_ONCE).
DIM coin AS SPRITE
coin = SPRITE_NEW(sheet, 16, 16)
SPRITE_ADD_ANIM(coin, "spin", 0, 3, 8)
SPRITE_PLAY(coin, "spin")
SPRITE_SET_POS(coin, 152, 112)

' Zwei Begleit-Coins (zur Veranschaulichung von mehreren Instanzen
' aus einem Sheet -- nicht ARRAY OF SPRITE, das macht Demo 31).
DIM coin_l AS SPRITE
coin_l = SPRITE_NEW(sheet, 16, 16)
SPRITE_ADD_ANIM(coin_l, "spin", 0, 3, 6)
SPRITE_PLAY(coin_l, "spin")

DIM coin_r AS SPRITE
coin_r = SPRITE_NEW(sheet, 16, 16)
SPRITE_ADD_ANIM(coin_r, "spin", 0, 3, 10)
SPRITE_PLAY(coin_r, "spin")

DIM running AS BOOLEAN
DIM t AS INTEGER
running = TRUE
t = 0

WHILE running
    Cls(RGB(20, 20, 40))

    ' Hintergrund-Pattern fuer Kontrast (zeigt, dass Alpha funktioniert).
    DIM gx AS INTEGER
    DIM gy AS INTEGER
    FOR gy = 0 TO 6
        FOR gx = 0 TO 9
            Box(gx * 32, gy * 32, gx * 32 + 31, gy * 32 + 31, RGB(28, 28, 50), FALSE)
        NEXT gx
    NEXT gy

    ' Header
    Text(8, 8, "Sprite-Editor Demo - 4 Frames @ 16x16", WHITE)
    Text(8, 24, "Werkzeuge -> Sprite-Editor oeffnen", RGB(160, 200, 255))
    Text(8, 40, "ESC = Ende", RGB(140, 140, 140))

    ' Begleit-Coins schwingen sinusfoermig.
    DIM ang AS FLOAT
    ang = t / 30.0
    SPRITE_SET_POS(coin_l, 80 + INT(20 * SIN(ang)),       112 + INT(30 * COS(ang)))
    SPRITE_SET_POS(coin_r, 224 + INT(20 * SIN(ang + 1.0)), 112 + INT(30 * COS(ang + 1.0)))

    SPRITE_UPDATE(coin,   16)
    SPRITE_UPDATE(coin_l, 16)
    SPRITE_UPDATE(coin_r, 16)
    SPRITE_DRAW(coin)
    SPRITE_DRAW(coin_l)
    SPRITE_DRAW(coin_r)

    Flip()
    t = t + 1

    IF t > 5 THEN running = FALSE
WEND
