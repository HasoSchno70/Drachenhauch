=== echte klicks auf -1 und +1, strg+z und strg+y
' Ein erster Lauf misst die Tabelle (Lage im Fenster unter der Menueleiste,
' Kopf- und Zeilenhoehe), ein zweiter klickt -1, +1, +1 in Zeile 0 und
' drueckt dann Strg+Z und Strg+Y -- die Bildschleife des Programms laeuft
' dabei wie sonst (Zelle, Geaendert, Kuerzel im Menue).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 8)
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
DIM tx AS INTEGER : tx = INT(VAL(w[0]))
DIM ty AS INTEGER : ty = INT(VAL(w[1]))
DIM zy AS INTEGER : zy = ty + INT(VAL(w[2])) + INT(VAL(w[3])) \ 2
DIM mx AS INTEGER : mx = tx + 220 + 120 + 100 + 22
DIM px AS INTEGER : px = mx + 44
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slKlick(mx, zy)
slWarten(6)
slKlick(px, zy)
slWarten(6)
slKlick(px, zy)
slWarten(6)
slMit([341], 90)
slWarten(6)
slMit([341], 89)
slWarten(10)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 20)
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei mess.dh
DIM f AS Hauptfenster : f = studioStartFenster
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
WRITEALL("lage.txt", STR$(GUI_GET_X(f.bestand.tabelle)) + " " + STR$(GUI_GET_Y(f.bestand.tabelle) + 26) + " " + STR$(INT(GUI_TABLE_GET(f.bestand.tabelle, "kopfhoehe"))) + " " + STR$(INT(GUI_TABLE_GET(f.bestand.tabelle, "zeilenhoehe"))))
--- datei klick.dh
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 2, 'Liter', '2026-11-20')")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
DIM mengen AS ARRAY OF STRING : mengen = []
DIM war AS STRING : war = ""
WHILE studioBild()
    DIM jetzt AS STRING : jetzt = GUI_TABLE_GET_CELL(f.bestand.tabelle, 0, 2)
    IF jetzt <> war THEN ARRAY_PUSH(mengen, jetzt)
    war = jetzt
WEND
PRINT "mengen "; JOIN$(mengen, " -> ")
PRINT "kachel "; GUI_CARD_TEXT$(f.kachelGesamt); " status "; GUI_STATUSBAR_TEXT$(f.status, 3)
--- erwartet
mengen 2 Liter -> 1 Liter -> 2 Liter -> 3 Liter -> 2 Liter -> 3 Liter
kachel 1 status Wiederholt: Milch: 3 Liter
code 0

=== rueckgaengig in der datei der python-app laesst den bestand stehen
' Dort haengt inventory mit FOREIGN KEY ... ON DELETE CASCADE an products.
' Rueckgaengig setzt eine Zeile per UPDATE zurueck -- ein INSERT OR REPLACE
' loeschte das Produkt erst und naehme seinen Bestand mit.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM db AS DB_CONN : db = DB_OPEN(p + "/fridge_database.db")
DB_EXEC(db, "CREATE TABLE products ( id INTEGER PRIMARY KEY AUTOINCREMENT, barcode TEXT UNIQUE, name TEXT NOT NULL, brand TEXT, category TEXT, image_url TEXT, min_quantity REAL, min_unit TEXT, default_storage_location TEXT, default_shelf_life_days INTEGER, nutritional_info TEXT, allergens TEXT, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP )")
DB_EXEC(db, "CREATE TABLE inventory ( id INTEGER PRIMARY KEY AUTOINCREMENT, product_id INTEGER NOT NULL, quantity REAL NOT NULL DEFAULT 1, unit TEXT DEFAULT 'Stück', purchase_date DATE, expiry_date DATE, storage_location TEXT, storage_area TEXT, notes TEXT, status TEXT DEFAULT 'fresh', created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, purchased_at_store TEXT, FOREIGN KEY (product_id) REFERENCES products (id) ON DELETE CASCADE )")
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 2, 'Liter', '2026-11-20')")
DB_CLOSE(db)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
SETENV("DH_STUDIO_DATEN", p)
PRINT "code "; kProbe(p, "probe.dh", "", 5)
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM e AS Eintrag : e = eintragLaden(1)
e.name = "Vollmilch"
eintragAendern(e)
mindestmengeSetzen(1, "Vollmilch", 2.0, "Liter")
verlauf.rueckgaengig$()
PRINT "nach einem schritt "; dbZahl("SELECT COUNT(*) FROM inventory")
verlauf.rueckgaengig$()
PRINT "eintraege "; dbZahl("SELECT COUNT(*) FROM inventory"); " name "; eintragLaden(1).name; " min "; eintragLaden(1).minMenge
--- erwartet
nach einem schritt 1
eintraege 1 name Milch min 0.0
code 0
