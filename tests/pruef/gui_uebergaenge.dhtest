=== der fokusring erscheint sofort und blendet beim wechsel aus
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 200)
GUI_WINDOW_CHROME(w, FALSE)
GUI_THEME_SET("accent", &HFF0000)
DIM b1 AS GUI_WIDGET : b1 = GUI_BUTTON(w, "", 50, 50, 60, 30)
DIM b2 AS GUI_WIDGET : b2 = GUI_BUTTON(w, "", 170, 50, 60, 30)
DIM bild AS INTEGER
GUI_FOCUS(b1)
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    IF bild = 10 THEN GUI_FOCUS(b2)
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=12
--- bild
167 60 #FF0000 +-2
47 60 nicht #FF0000 +-20
47 60 nicht #18222E +-20

=== ein baum klappt ueber die dauer auf
' Drei Kinder mit gruenem Sinnbild. Das dritte steht nach dem Aufklappen bei
' y 77..99 (Zeile 3), sein Sinnbild bei x 48. Zwei Bilder nach dem
' Aufklappen wachsen die Zeilen noch aus der Wurzel heraus, dort ist noch
' Grund -- nach der Dauer steht das Sinnbild da.
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 200, 180)
DIM gruen AS IMAGE : gruen = IMAGE_NEW(16, 16, &H00FF00)
DIM r AS INTEGER : r = GUI_TREE_ADD(t, -1, "Wurzel")
DIM k AS INTEGER
FOR k = 1 TO 3
    GUI_TREE_ICON(t, GUI_TREE_ADD(t, r, "Kind"), gruen)
NEXT
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    IF bild = 3 THEN GUI_TREE_EXPAND(t, r, TRUE)
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=5
--- bild
57 88 nicht #00FF00 +-40

