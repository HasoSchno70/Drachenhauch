=== leertaste kippt den haken der gewaehlten zeile
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM lb AS GUI_WIDGET
lb = GUI_LISTBOX(w, 20, 20, 200, 120, SPLIT$("Apfel|Birne|Kirsche|Dattel", "|"))
GUI_LISTBOX_SET(lb, "kaestchen", 1)
GUI_LISTBOX_SET_SELECTED(lb, 2)
GUI_FOCUS(lb)
DIM f AS INTEGER
FOR f = 1 TO 14
    GUI_UPDATE()
    IF f = 5 OR f = 12 THEN PRINT GUI_LISTBOX_CHECKED(lb, 2)
    GUI_DRAW()
    FLIP()
NEXT
