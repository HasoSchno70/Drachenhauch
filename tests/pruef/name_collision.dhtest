=== in jeder blockart[IF TRUE THEN-END IF]
DIM n AS INTEGER : n = 0
IF TRUE THEN
    DIM pi AS INTEGER
    pi = 5
    PRINT pi
    n = 1
END IF
--- erwartet
5

=== in jeder blockart[WHILE n < 1-WEND]
DIM n AS INTEGER : n = 0
WHILE n < 1
    DIM pi AS INTEGER
    pi = 5
    PRINT pi
    n = 1
WEND
--- erwartet
5

=== in jeder blockart[FOR n = 1 TO 1-NEXT]
DIM n AS INTEGER : n = 0
FOR n = 1 TO 1
    DIM pi AS INTEGER
    pi = 5
    PRINT pi
    n = 1
NEXT
--- erwartet
5

=== in jeder blockart[SELECT CASE 1\n    CASE 1-END SELECT]
DIM n AS INTEGER : n = 0
SELECT CASE 1
    CASE 1
    DIM pi AS INTEGER
    pi = 5
    PRINT pi
    n = 1
END SELECT
--- erwartet
5

=== in jeder blockart[TRY-CATCH e\n    PRINT "x"\nEND TRY]
DIM n AS INTEGER : n = 0
TRY
    DIM pi AS INTEGER
    pi = 5
    PRINT pi
    n = 1
CATCH e
    PRINT "x"
END TRY
--- erwartet
5

=== unverschattet gilt die konstante weiter
' Gegenprobe -- verschattet wird nur, wo wirklich ein DIM steht.
PRINT INT(PI * 100)
PRINT RED
PRINT KEY_SPACE
--- erwartet
314
16711680
32

=== wiederholtes dim setzt den wert nicht zurueck
' Ein `DIM` in einer Schleife laeuft bei jedem Durchlauf -- es darf den
DIM n AS INTEGER
FOR n = 1 TO 3
    DIM z AS INTEGER
    z = z + 1
NEXT
PRINT z
--- erwartet
3

=== kollision wird auch ueber blockgrenzen erkannt
' Nebenertrag derselben Ursache: die Kollisions-Erkennung sah bis dahin
CONST Modus = 3
IF TRUE THEN
    DIM modus AS INTEGER
END IF
--- fehler
Namens-Kollision: 'modus' ist zugleich eine Variable und eine CONST -- das geht nicht, weil Drachenhauch Gross-/Kleinschreibung ignoriert. Benenne eines um.

