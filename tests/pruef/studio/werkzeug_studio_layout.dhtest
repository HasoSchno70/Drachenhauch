=== ein abstandhalter wird gewaehlt, rueckt mit dem pfeil und geht mit entf
IMPORT "laeufer.dh"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 8, CWD$() + "/f.dhform")
DIM sx AS INTEGER
DIM sy AS INTEGER
(sx, sy) = slLage(m, "abstand Zeile1 1")
slHin(10, 10)
slKlick(sx, sy)
slWarten(6)
slTaste(262)
slWarten(6)
slTaste(261)
slWarten(8)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, CWD$() + "/f.dhform")
PRINT "gewaehlt "; slHat(log, "gewaehlt abstand Zeile1 1")
PRINT "gewicht im inspektor "; LEN(slAnfang(log, "lage feld studio_gewicht ")) > 0
PRINT "umgesetzt "; slHat(log, "umgesetzt abstand 2")
PRINT "geloescht "; slHat(log, "geloescht abstand Zeile1")
DIM staende AS ARRAY OF STRING : staende = slAnfang(log, "behaelter Zeile1")
DIM vorher AS STRING : vorher = ""
DIM z AS STRING
FOR EACH z IN staende
    IF z <> vorher THEN PRINT z
    vorher = z
NEXT
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/_hilfen/studiolauf.dh"
slStudio = ARG$(0)
