DIM p AS GUI_WINDOW : p = GUI_WINDOW(kennung, 40, 40, 240, 160)
GUI_WINDOW_CLOSABLE(p, TRUE)
DIM pk AS GUI_WIDGET : pk = GUI_BUTTON(p, "Paletten-Knopf", 20, 40, 140, 30)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(p, 20, 90, 180, 26)
DIM nativ AS BOOLEAN : nativ = GUI_WINDOW_NATIVE(p, TRUE)
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT QUITREQUESTED() AND MILLIS() - t0 < 6000
    GUI_UPDATE()
    CLS(&H202830) : GUI_DRAW() : FLIP()
WEND
PRINT "nativ "; nativ
PRINT "text |"; GUI_TEXT(tf); "|"
--- system windows
--- erwartet
gesendet
nativ TRUE
text |hi|

=== das kreuz des systems schliesst das gui-fenster
' WM_CLOSE (16) -- was das Kreuz der Titelleiste und Alt+F4 ausloesen. Das
' gui-Fenster gilt danach als geschlossen wie nach seinem eigenen Kreuz.
IMPORT "helfer.dh"
PRINT sende$(skript$(), "probe.dh", "roh:16:0:0", "palette")
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fenstersender.ps1"
END FUNCTION
--- datei probe.dh
IMPORT "gui"
DIM kennung AS STRING : kennung = ARG$(0)
SCREEN(500, 300, "Haupt-" + kennung, 1)
DIM p AS GUI_WINDOW : p = GUI_WINDOW(kennung, 40, 40, 240, 160)
GUI_WINDOW_CLOSABLE(p, TRUE)
DIM pk AS GUI_WIDGET : pk = GUI_BUTTON(p, "Paletten-Knopf", 20, 40, 140, 30)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(p, 20, 90, 180, 26)
DIM nativ AS BOOLEAN : nativ = GUI_WINDOW_NATIVE(p, TRUE)
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT QUITREQUESTED() AND MILLIS() - t0 < 6000
    GUI_UPDATE()
    CLS(&H202830) : GUI_DRAW() : FLIP()
WEND
PRINT "nativ "; nativ
PRINT "geschlossen "; GUI_WINDOW_CLOSED(p)
PRINT "text |"; GUI_TEXT(tf); "|"
--- system windows
--- erwartet
gesendet
nativ TRUE
geschlossen TRUE
text ||

=== das native fenster zeigt das bild richtig herum
' Gefunden beim Bau: das Bild stand auf dem Kopf (der Spike spiegelte, seine
' Proben lagen symmetrisch und sahen es nicht). Oben ein magenta Streifen,
' unten ein gruener; fensterpixel.ps1 liest beide aus dem Inhalt des
' nativen Fensters vom Bildschirm.
IMPORT "helfer.dh"
DIM kennung AS STRING : kennung = "Bild-" + STR$(MILLIS()) + "-" + STR$(INT(RND() * 1000000))
DIM kind AS INTEGER : kind = PROCESS_START("dhrt", "run", CWD$() + "/bild.dh", "--", kennung)
DIM ps AS INTEGER : ps = PROCESS_START("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", pixel_skript$(), kennung, "120,15;120,145")
DIM s AS STRING : s = auslesen$(ps, 30000)
DIM k AS STRING : k = auslesen$(kind, 30000)
IF INSTR(auslesenFehler, "Kein Fenster moeglich") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    END
END IF
PRINT s; k;
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/fenstersender.dh"
FUNCTION pixel_skript$() AS STRING
    RETURN "{sammlung}/../_hilfen/fensterpixel.ps1"
END FUNCTION
--- datei bild.dh
IMPORT "gui"
SCREEN(400, 300, "Haupt-" + ARG$(0), 1)
DIM p AS GUI_WINDOW : p = GUI_WINDOW(ARG$(0), 40, 40, 240, 160)
DIM oben AS GUI_WIDGET : oben = GUI_LABEL(p, "", 0, 0)
GUI_SET_BOUNDS(oben, 0, 0, 240, 40)
GUI_SET_COLOR(oben, "bg", &HFF00FF)
DIM unten AS GUI_WIDGET : unten = GUI_LABEL(p, "", 0, 0)
GUI_SET_BOUNDS(unten, 0, 120, 240, 40)
GUI_SET_COLOR(unten, "bg", &H00FF00)
PRINT "nativ "; GUI_WINDOW_NATIVE(p, TRUE)
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT QUITREQUESTED() AND MILLIS() - t0 < 5000
    GUI_UPDATE()
    CLS(&H202830) : GUI_DRAW() : FLIP()
WEND
--- system windows
--- erwartet
120,15 #FF00FF
120,145 #00FF00
nativ TRUE
