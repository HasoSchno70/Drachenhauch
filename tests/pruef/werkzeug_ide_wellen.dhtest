' Fehler und Warnungen im Code-Feld der IDE: unterstrichen an ihrer Stelle,
' und die Meldung gehoert dorthin, wo die Maus darauf steht (meldungBei$ ist
' dieselbe Frage, die der Tooltip stellt).

=== die pruefung unterstreicht und kennt die meldung an der stelle
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 80 THEN
    DIM prTa AS GUI_WIDGET : prTa = tabFelder[aktiverTab]
    protokoll("pr auf zaehlr " + STR$(INSTR(meldungBei$(prTa, 2, 4), "zaehlr") >= 0))
    protokoll("pr daneben " + STR$(meldungBei$(prTa, 2, 12) = ""))
    protokoll("pr andere zeile " + STR$(meldungBei$(prTa, 1, 4) = ""))
    EXIT(0)
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=120
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
DIM zaehler AS INTEGER
  zaehlr = zaehler + 1
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
DIM wellen AS STRING : wellen = ""
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 7) = "wellen " THEN wellen = L[i]
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
PRINT wellen
--- erwartet
pr auf zaehlr TRUE
pr daneben TRUE
pr andere zeile TRUE
wellen 1
