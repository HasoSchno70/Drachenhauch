END FUNCTION
PRINT "drei laeufe " ; zahl("bereit") = 3
DIM gl AS STRING : gl = letzte$("geoeffnet ")
PRINT "zuletzt eins.dh " ; RIGHT$(gl, 7) = "eins.dh"
DIM zi AS INTEGER
DIM zweiNach AS BOOLEAN : zweiNach = FALSE
DIM dritter AS BOOLEAN : dritter = FALSE
DIM laeufe AS INTEGER : laeufe = 0
FOR zi = 0 TO LEN(L) - 1
    IF L[zi] = "bereit" THEN laeufe = laeufe + 1
    IF laeufe = 3 AND LEFT$(L[zi], 10) = "geoeffnet " AND RIGHT$(L[zi], 7) = "zwei.dh" THEN zweiNach = TRUE
NEXT
PRINT "zwei.dh nicht im dritten lauf " ; NOT zweiNach
--- erwartet
drei laeufe TRUE
zuletzt eins.dh TRUE
zwei.dh nicht im dritten lauf TRUE

=== git blame listet wer welche zeile geschrieben hat
' Das Repository legt `--- vorher` an (git init/add/commit).
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=140
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT 1
PRINT 2
PRINT 3
--- datei _programm/ev.txt
c 6
e 40 2 341 0 0 0
e 40 2 340 0 0 0
e 40 2 66 0 0 0
e 42 1 66 0 0 0
e 42 1 341 0 0 0
e 42 1 340 0 0 0

--- vorher
FUNCTION git(a AS STRING, b AS STRING, c AS STRING, d AS STRING, e AS STRING, f AS STRING) AS INTEGER
    DIM p AS INTEGER
    IF f <> "" THEN
        p = PROCESS_START("git", a, b, c, d, e, f)
    ELSEIF d <> "" THEN
        p = PROCESS_START("git", a, b, c, d)
    ELSEIF c <> "" THEN
        p = PROCESS_START("git", a, b, c)
    ELSE
        p = PROCESS_START("git", a, b)
    END IF
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    WHILE PROCESS_RUNNING(p) AND MILLIS() < bis
        SLEEP(20)
    WEND
    RETURN PROCESS_CODE(p)
END FUNCTION
IF git("init", "-q", "", "", "", "") <> 0 THEN EXIT(3)
IF git("config", "user.name", "Test", "", "", "") <> 0 THEN EXIT(4)
IF git("config", "user.email", "t@t", "", "", "") <> 0 THEN EXIT(5)
IF git("add", "spiel.dh", "", "", "", "") <> 0 THEN EXIT(6)
IF git("commit", "-q", "-m", "erst", "", "") <> 0 THEN EXIT(7)
--- nachher
