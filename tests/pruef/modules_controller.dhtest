' Aus test_modules_controller.py uebertragen (18 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== char new initializes
IMPORT "tiled"
IMPORT "tile_collide"
IMPORT "controller"
DIM m AS TILED_MAP
m = TILED_LOAD("level.json")
DIM c AS CHAR_CONTROLLER
c = CHAR_NEW(10.0, 20.0, 12.0, 14.0)
PRINT CHAR_X(c)
PRINT CHAR_Y(c)
PRINT CHAR_W(c)
PRINT CHAR_H(c)
PRINT CHAR_VX(c)
PRINT CHAR_VY(c)
PRINT CHAR_ON_GROUND(c)
PRINT CHAR_FACING(c)
