DHRT_FRAMES=2
--- erwartet
TRUE 255
0

=== anzahl begrenzt ein festes feld
' DIM b[16] mit drei belegten Plaetzen ist der Normalfall.
' (Bis Stufe 46 in test_image_io.py.)
IMPORT "imgfx"
SCREEN(160, 80, "t", 1)
DIM gb AS BUFFER
FUNCTION zaehle(hex AS STRING) AS INTEGER
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_HEX(hex)
    DIM z AS INTEGER : z = 0
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, nadel)
    WHILE p >= 0
        z = z + 1
        p = BUFFER_INDEXOF(gb, nadel, p + 1)
    WEND
    RETURN z
END FUNCTION
FUNCTION dauern$() AS STRING
    ' Graphic Control Extension: 21 F9 04, Schalter, Verzoegerung (Hundertstel, LE)
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_HEX("21F904")
    DIM r AS STRING : r = ""
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, nadel)
    WHILE p >= 0
        r = r + STR$((BUFFER_GET(gb, p + 4) + BUFFER_GET(gb, p + 5) * 256) * 10) + " "
        p = BUFFER_INDEXOF(gb, nadel, p + 1)
    WEND
    RETURN TRIM$(r)
END FUNCTION
FUNCTION schleife$() AS STRING
    ' NETSCAPE2.0, dann 03 01 und die Wiederholzahl (0 = endlos)
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, BUFFER_FROM_STRING("NETSCAPE2.0"))
    IF p < 0 THEN RETURN "keine"
    RETURN STR$(BUFFER_GET(gb, p + 13) + BUFFER_GET(gb, p + 14) * 256)
END FUNCTION
DIM b[16] AS IMAGE
DIM i AS INTEGER
FOR i = 0 TO 2
    b[i] = IMAGE_NEW(4, 4, &HFF0000)
NEXT
IMAGE_SAVE_GIF(b, "a.gif", 10, TRUE, 3)
gb = READALL_BYTES("a.gif")
PRINT zaehle("21F904")
--- umgebung
DHRT_FRAMES=2
--- erwartet
3

=== wiederholen laesst sich abschalten
' (Bis Stufe 46 in test_image_io.py.)
IMPORT "imgfx"
SCREEN(160, 80, "t", 1)
DIM gb AS BUFFER
FUNCTION zaehle(hex AS STRING) AS INTEGER
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_HEX(hex)
    DIM z AS INTEGER : z = 0
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, nadel)
    WHILE p >= 0
        z = z + 1
        p = BUFFER_INDEXOF(gb, nadel, p + 1)
    WEND
    RETURN z
END FUNCTION
FUNCTION dauern$() AS STRING
    ' Graphic Control Extension: 21 F9 04, Schalter, Verzoegerung (Hundertstel, LE)
    DIM nadel AS BUFFER : nadel = BUFFER_FROM_HEX("21F904")
    DIM r AS STRING : r = ""
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, nadel)
    WHILE p >= 0
        r = r + STR$((BUFFER_GET(gb, p + 4) + BUFFER_GET(gb, p + 5) * 256) * 10) + " "
        p = BUFFER_INDEXOF(gb, nadel, p + 1)
    WEND
    RETURN TRIM$(r)
END FUNCTION
FUNCTION schleife$() AS STRING
    ' NETSCAPE2.0, dann 03 01 und die Wiederholzahl (0 = endlos)
    DIM p AS INTEGER : p = BUFFER_INDEXOF(gb, BUFFER_FROM_STRING("NETSCAPE2.0"))
    IF p < 0 THEN RETURN "keine"
    RETURN STR$(BUFFER_GET(gb, p + 13) + BUFFER_GET(gb, p + 14) * 256)
END FUNCTION
DIM b[1] AS IMAGE
b[0] = IMAGE_NEW(4, 4, &HFF0000)
IMAGE_SAVE_GIF(b, "a.gif", 10, FALSE)
gb = READALL_BYTES("a.gif")
PRINT schleife$()
--- umgebung
DHRT_FRAMES=2
--- erwartet
keine

=== viele farben werden zusammengefasst
' Ueber 255 Farben kann GIF nicht -- der Zweig darf nicht abstuerzen.
' (Bis Stufe 46 in test_image_io.py.)
IMPORT "imgfx"
SCREEN(160, 80, "t", 1)
DIM b[1] AS IMAGE
b[0] = GENTEX_PERLIN(48, 48, 8.0)
IMAGE_SAVE_GIF(b, "a.gif", 5)
DIM g AS IMAGE : g = LOADIMAGE("a.gif")
PRINT IMAGEWIDTH(g); " "; IMAGEHEIGHT(g)
DIM farben AS MAP OF INTEGER
DIM x AS INTEGER
DIM y AS INTEGER
FOR y = 0 TO 47
    FOR x = 0 TO 47
        MAPPUT(farben, HEX$(GETPIXEL(g, x, y)), 1)
    NEXT
NEXT
PRINT "hoechstens 256 "; LEN(MAPKEYS(farben)) <= 256
--- umgebung
DHRT_FRAMES=2
--- erwartet
48 48
hoechstens 256 TRUE
