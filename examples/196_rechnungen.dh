DIM kundenId[MAXZ] AS INTEGER
DIM kundenAnz AS INTEGER : kundenAnz = 0

DIM fK AS GUI_WIDGET : fK = GUI_LAYOUT(win, "spalte", formX, 12, formW, 440)
