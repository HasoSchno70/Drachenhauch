' Produktdaten zu einem Barcode aus Open Food Facts, wie
' services/api/worker.py der Python-App: erst der Cache (gefunden oder
' "nicht gefunden"), dann im Hintergrund das Netz (HTTP_GET_START, das
' Fenster friert nicht ein); ein Fund kommt in den Cache, ein "status 0"
' als nicht gefunden, ein Netzfehler gar nicht. KUEHL_OFF_URL ersetzt die
' Adresse (für Prüfungen ein Server auf diesem Rechner).
IMPORT "html"
IMPORT "json"

FUNCTION offBasis$() AS STRING
    DIM u AS STRING : u = GETENV$("KUEHL_OFF_URL")
    IF u = "" THEN RETURN "https://world.openfoodfacts.org"
    RETURN u
END FUNCTION

' Was der Cache schon weiß -- NIL, wenn das Netz gefragt werden muss.
FUNCTION offAusCache(barcode AS STRING) AS Fund
    IF cacheNichtGefunden(barcode) THEN
        DIM n AS Fund : n = NEW Fund()
        n.barcode = barcode
        n.ausCache = TRUE
        n.fehler = "Produkt wurde zuvor nicht gefunden (aus Cache)"
        n.allergene = []
        RETURN n
    END IF
    DIM d AS STRING : d = cacheProdukt$(barcode)
    IF d = "" THEN RETURN NIL
    DIM f AS Fund : f = fundAus(barcode, JSON_PARSE(d))
    f.ausCache = TRUE
    RETURN f
END FUNCTION

' Startet die Anfrage; die Nummer fragt das Fenster je Bild mit HTTP_READY.
FUNCTION offStarten(barcode AS STRING) AS INTEGER
    DIM kopf AS MAP OF STRING
    MAPPUT(kopf, "User-Agent", "Kuehlschrank-App/1.0 (Drachenhauch)")
    MAPPUT(kopf, "Accept", "application/json")
    HTTP_TIMEOUT(10)
    RETURN HTTP_REQUEST_START("GET", offBasis$() + "/api/v0/product/" + barcode + ".json", "", kopf)
END FUNCTION

' Die Antwort abholen (nach HTTP_READY) und auswerten.
FUNCTION offAbholen(abruf AS INTEGER, barcode AS STRING) AS Fund
    DIM f AS Fund
    DIM antwort AS STRING
    TRY
        antwort = HTTP_RESULT(abruf)
    CATCH fehler
        f = NEW Fund()
        f.barcode = barcode
        f.allergene = []
        f.fehler = "Netzwerkfehler: " + fehler
        RETURN f
    END TRY
    DIM j AS JSON_HANDLE
    TRY
        j = JSON_PARSE(antwort)
    CATCH fehler2
        f = NEW Fund()
        f.barcode = barcode
        f.allergene = []
        f.fehler = "Ungültige Antwort von Open Food Facts"
        RETURN f
    END TRY
    DIM gefunden AS BOOLEAN : gefunden = FALSE
    IF JSON_HAS(j, "status") THEN
        IF JSON_TYPE(j, "status") = "number" THEN gefunden = JSON_GET_INT(j, "status") = 1
    END IF
    IF gefunden AND JSON_HAS(j, "product") THEN
        DIM d AS JSON_HANDLE : d = produktDaten(JSON_GET_JSON(j, "product"))
        cacheMerken(barcode, d)
        RETURN fundAus(barcode, d)
    END IF
    cacheMerkenNicht(barcode)
    f = NEW Fund()
    f.barcode = barcode
    f.allergene = []
    f.fehler = "Produkt nicht in Open Food Facts gefunden"
    RETURN f
END FUNCTION

FUNCTION jText$(j AS JSON_HANDLE, pfad AS STRING) AS STRING
    IF NOT JSON_HAS(j, pfad) THEN RETURN ""
    IF JSON_TYPE(j, pfad) = "string" THEN RETURN JSON_GET_STRING(j, pfad)
    IF JSON_TYPE(j, pfad) = "number" THEN RETURN STR$(JSON_GET_INT(j, pfad))
    RETURN ""
END FUNCTION

' product_data wie _fetch_from_api: die Felder, dazu raw_data (für die
' Vorgaben aus categories_tags).
FUNCTION produktDaten(p AS JSON_HANDLE) AS JSON_HANDLE
    DIM d AS JSON_HANDLE : d = JSON_NEW_OBJECT()
    DIM n AS STRING : n = jText$(p, "product_name")
    IF n = "" THEN n = jText$(p, "product_name_de")
    JSON_SET_STRING(d, "name", n)
    JSON_SET_STRING(d, "brand", TRIM$(SPLIT(jText$(p, "brands") + ",", ",")[0]))
    JSON_SET_STRING(d, "categories", jText$(p, "categories"))
    JSON_SET_STRING(d, "quantity", jText$(p, "quantity"))
    JSON_SET_STRING(d, "nutrition_grades", jText$(p, "nutrition_grades"))
    IF JSON_HAS(p, "allergens_tags") THEN
        JSON_SET_JSON(d, "allergens", JSON_GET_JSON(p, "allergens_tags"))
    ELSE
        JSON_SET_JSON(d, "allergens", JSON_NEW_ARRAY())
    END IF
    DIM b AS STRING : b = jText$(p, "image_front_small_url")
    IF b = "" THEN b = jText$(p, "image_url")
    JSON_SET_STRING(d, "image_url", b)
    DIM z AS STRING : z = jText$(p, "ingredients_text_de")
    IF z = "" THEN z = jText$(p, "ingredients_text")
    JSON_SET_STRING(d, "ingredients", z)
    JSON_SET_STRING(d, "nutriscore", jText$(p, "nutriscore_grade"))
    JSON_SET_JSON(d, "raw_data", p)
    RETURN d
END FUNCTION

' Ein Fund aus product_data. Ohne Namen wie on_api_result: deutsch,
' allgemein, Marke aus den Rohdaten.
FUNCTION fundAus(barcode AS STRING, d AS JSON_HANDLE) AS Fund
    DIM f AS Fund : f = NEW Fund()
    f.barcode = barcode
    f.gefunden = TRUE
    f.name = TRIM$(jText$(d, "name"))
    IF f.name = "" THEN
        DIM k AS STRING
        FOR EACH k IN ["raw_data.product_name_de", "raw_data.product_name", "raw_data.generic_name", "raw_data.brands"]
            IF f.name = "" THEN f.name = TRIM$(jText$(d, k))
        NEXT
    END IF
    f.marke = jText$(d, "brand")
    f.kategorien = jText$(d, "categories")
    f.menge = jText$(d, "quantity")
    f.nutriScore = jText$(d, "nutrition_grades")
    f.bildUrl = jText$(d, "image_url")
    f.allergene = []
    IF JSON_HAS(d, "allergens") THEN
        DIM i AS INTEGER
        FOR i = 0 TO JSON_LEN(d, "allergens") - 1
            ARRAY_PUSH(f.allergene, jText$(d, "allergens." + STR$(i)))
        NEXT
    END IF
    f.daten = JSON_STRINGIFY(d)
    RETURN f
END FUNCTION

' Die Kategorien eines Funds für die Vorgaben: categories, sonst die Tags
' aus den Rohdaten ("en:dairies" -> "dairies").
FUNCTION fundKategorien$(f AS Fund) AS STRING
    IF f IS NIL THEN RETURN ""
    IF f.kategorien <> "" THEN RETURN f.kategorien
    IF f.daten = "" THEN RETURN ""
    DIM d AS JSON_HANDLE : d = JSON_PARSE(f.daten)
    IF NOT JSON_HAS(d, "raw_data.categories_tags") THEN RETURN ""
    DIM t AS ARRAY OF STRING : t = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(d, "raw_data.categories_tags") - 1
        DIM s AS STRING : s = jText$(d, "raw_data.categories_tags." + STR$(i))
        IF INSTR(s, ":") >= 0 THEN s = MID$(s, INSTR(s, ":") + 1, LEN(s))
        ARRAY_PUSH(t, REPLACE$(s, "-", " "))
    NEXT
    RETURN JOIN$(t, ", ")
END FUNCTION
