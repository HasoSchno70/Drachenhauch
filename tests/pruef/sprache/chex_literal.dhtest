' Aus test_chex_literal.py uebertragen (6 Faelle). Format: docs/werkzeuge.md, dhrt test.
' C-Stil Hex-/Binaer-Literale: 0xFF / 0b1010.
'
' Zusaetzlich zur klassischen BASIC-Form &H/&B akzeptieren beide Lexer
' (Python-Front-End + dhrt) jetzt auch die C-Schreibweise. `0`/`0.5` duerfen
' dabei NICHT als Praefix fehlgedeutet werden.

=== hex literal value
PRINT 0xFF
--- erwartet
255

=== binary literal value
PRINT 0b1010
--- erwartet
10

=== uppercase prefix
PRINT 0XCAFE
--- erwartet
51966

=== equivalent to basic form
PRINT 0xFF8000 = &HFF8000
--- erwartet
TRUE

=== hex in const
CONST C AS INTEGER = 0x141E3C
PRINT C
--- erwartet
1318460

=== zero and float unaffected
PRINT 0
PRINT 0.5
--- erwartet
0
0.5


=== exponent im literal
' Bis 2026.27 ein Parse-Fehler, obwohl VAL("1e3") es las und der
' Hervorheber es als Zahl faerbte.
PRINT 1e3
PRINT 2.5E-3
PRINT 1.5e+2 * 2
PRINT TYPEOF(1e3)
DIM best AS FLOAT
best = 1.0E9
PRINT best > 999999999.0
--- erwartet
1000.0
0.0025
300.0
FLOAT
TRUE

=== e ohne ziffer bleibt ein name
DIM e AS INTEGER
e = 4
PRINT 3 * e
PRINT 2 + e
--- erwartet
12
6

=== zu grosser exponent ist ein fehler
PRINT 1e400
--- fehler
Kommazahl-Literal zu gross
