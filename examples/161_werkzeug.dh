' 161 -- Ein Werkzeug statt eines Spiels (WP A: Betriebssystem-Anbindung)
'
' Zaehlt Zeilen, Woerter und Zeichen in Textdateien -- wie das uralte `wc`.
' Kein Fenster, keine Grafik: das hier laeuft in der Konsole, nimmt Argumente
' entgegen und sagt seinem Aufrufer per Rueckgabewert, ob es geklappt hat.
'
' Aufruf:
'   dhrt run 161_werkzeug.dh -- datei.txt [weitere.txt ...]
'   dhrt run 161_werkzeug.dh -- --nur-zeilen datei.txt
'
' Alles hinter `--` gehoert dem PROGRAMM, alles davor der Runtime. Als
' exportierte .exe entfaellt das `--`:
'   dhrt --export 161_werkzeug.dh
'   161_werkzeug.exe datei.txt

CONST FEHLER AS INTEGER = 1
CONST FALSCH_AUFGERUFEN AS INTEGER = 2
CONST TAB AS STRING = "	"

FUNCTION woerter_in(zeile AS STRING) AS INTEGER
    DIM teile AS ARRAY OF STRING
    DIM i AS INTEGER
    DIM n AS INTEGER
    teile = SPLIT$(zeile, " ")
    n = 0
    FOR i = 0 TO LEN(teile) - 1
        IF TRIM$(teile[i]) <> "" THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION

DIM i AS INTEGER
DIM nur_zeilen AS BOOLEAN
DIM dateien AS ARRAY OF STRING
DIM a AS STRING

' --- Argumente einsammeln -------------------------------------------------
' ARG$(n) ist 0-basiert und liefert ausserhalb einen Leerstring statt eines
' Fehlers -- darum braucht die Schleife kein Geruest.
nur_zeilen = FALSE
dateien = []
FOR i = 0 TO ARGC() - 1
    a = ARG$(i)
    IF a = "--nur-zeilen" THEN
        nur_zeilen = TRUE
    ELSE
        ARRAY_PUSH(dateien, a)
    END IF
NEXT

IF LEN(dateien) = 0 THEN
    ' Hinweise gehoeren nach stderr, nicht in die Nutzdaten: so kann jemand
    ' `... > ergebnis.txt` schreiben und sieht die Meldung trotzdem.
    EPRINT("Verwendung: 161_werkzeug [--nur-zeilen] <datei> [datei ...]")
    EXIT(FALSCH_AUFGERUFEN)
END IF

' --- Arbeiten -------------------------------------------------------------
DIM zeilen AS ARRAY OF STRING
DIM z AS INTEGER
DIM w AS INTEGER
DIM c AS INTEGER
DIM summe_z AS INTEGER
DIM fehlend AS INTEGER
DIM pfad AS STRING

summe_z = 0
fehlend = 0

FOR i = 0 TO LEN(dateien) - 1
    pfad = dateien[i]
    ' Achtung: dhrt wechselt beim Start ins Verzeichnis der .dh-Datei. Ein
    ' relativer Pfad vom Aufrufer ist relativ zu DESSEN Verzeichnis -- bei
    ' einem Werkzeug also lieber absolute Pfade uebergeben.
    IF NOT FILEEXISTS(pfad) THEN
        EPRINT("Nicht gefunden: " + pfad)
        fehlend = fehlend + 1
        CONTINUE
    END IF

    zeilen = READLINES(pfad)
    z = LEN(zeilen)
    w = 0
    c = 0
    FOR z = 0 TO LEN(zeilen) - 1
        w = w + woerter_in(zeilen[z])
        c = c + LEN(zeilen[z])
    NEXT
    z = LEN(zeilen)
    summe_z = summe_z + z

    ' Drachenhauch-Strings kennen KEINE Escapes wie \t -- ein Tabulator kommt
    ' ueber CHR$(9). (Das einzige Escape ist "" fuer ein Anfuehrungszeichen.)
    IF nur_zeilen THEN
        PRINT f"{z}{TAB}{pfad}"
    ELSE
        PRINT f"{z}{TAB}{w}{TAB}{c}{TAB}{pfad}"
    END IF
NEXT

IF LEN(dateien) > 1 THEN
    PRINT f"{summe_z}{TAB}insgesamt"
END IF

' --- Bescheid geben -------------------------------------------------------
' Der Rueckgabewert ist das, woran ein Skript erkennt, ob es weitergehen darf.
' Ohne EXIT endet das Programm mit 0 -- also nur im Fehlerfall etwas anderes.
IF fehlend > 0 THEN
    EXIT(FEHLER)
END IF
