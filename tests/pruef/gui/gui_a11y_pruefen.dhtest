' GUI_A11Y_CHECK$ (gui_pruefen.rs): Kontrast der Schrift (WCAG 4,5:1),
' Name fuer den Bildschirmleser, Zielgroesse 24 x 24 mit Ausnahme fuer
' Abstand (WCAG 2.5.8). Dazu die eingebauten Themen: sie bestehen ihre
' eigene Pruefung.
' Format: docs/werkzeuge.md, dhrt test.

=== blasse schrift ist ein befund, kraeftige nicht
TRY
    SCREEN(600, 400, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Form", 0, 0, 600, 400)
DIM blass AS GUI_WIDGET : blass = GUI_BUTTON(w, "Blass", 160, 20, 120, 32)
GUI_SET_COLOR(blass, "fg", &H8890A0)
GUI_SET_COLOR(blass, "bg", &HA0A8B0)
GUI_UPDATE()
PRINT GUI_A11Y_CHECK$()
GUI_SET_COLOR(blass, "fg", &H101418)
GUI_UPDATE()
PRINT "danach ["; GUI_A11Y_CHECK$(); "]"
' Abgeschaltet zaehlt nicht (WCAG nimmt inaktive aus).
GUI_SET_COLOR(blass, "fg", &H8890A0)
GUI_SET_ENABLED(blass, FALSE)
GUI_UPDATE()
PRINT "aus ["; GUI_A11Y_CHECK$(); "]"
--- umgebung
DHRT_FRAMES=1
--- erwartet
button "Blass" in "Form": Kontrast 1,3:1 -- mindestens 4,5:1 (Schrift #8890A0 auf #A0A8B0)
danach []
aus []

=== ein knopf ohne text braucht einen hilfetext
TRY
    SCREEN(600, 400, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Form", 0, 0, 600, 400)
DIM leer AS GUI_WIDGET : leer = GUI_BUTTON(w, "", 300, 20, 32, 32)
GUI_UPDATE()
PRINT GUI_A11Y_CHECK$(w)
GUI_TOOLTIP(leer, "Loeschen")
GUI_UPDATE()
PRINT "mit hilfetext ["; GUI_A11Y_CHECK$(w); "]"
--- umgebung
DHRT_FRAMES=1
--- erwartet
button bei 300,20 in "Form": kein Name fuer den Bildschirmleser -- Text, eine Beschriftung davor (GUI_LABEL) oder GUI_TOOLTIP
mit hilfetext []

=== ein feld mit beschriftung davor hat einen namen
TRY
    SCREEN(600, 400, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Form", 0, 0, 600, 400)
DIM name AS GUI_WIDGET : name = GUI_TEXTINPUT(w, 20, 80, 200, 28)
DIM lbl AS GUI_WIDGET : lbl = GUI_LABEL(w, "Ort", 20, 130)
DIM ort AS GUI_WIDGET : ort = GUI_TEXTINPUT(w, 60, 126, 200, 28)
GUI_UPDATE()
PRINT GUI_A11Y_CHECK$()
--- umgebung
DHRT_FRAMES=1
--- erwartet
textinput bei 20,80 in "Form": kein Name fuer den Bildschirmleser -- Text, eine Beschriftung davor (GUI_LABEL) oder GUI_TOOLTIP

