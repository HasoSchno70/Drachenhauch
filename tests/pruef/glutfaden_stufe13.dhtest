--- erwartet
gleich (712 Zeilen)

=== einstellungen: vorgaben, krumme werte, ordnen, rundweg
IMPORT "helfer.dh"
DIM v AS kern.Einstellungen : v = NEW kern.Einstellungen()
PRINT kern.einstellungenJson$(v)
' fehlt, kaputt, kein Objekt: die Vorgaben
PRINT "fehlt: "; kern.einstellungenJson$(kern.einstellungenLaden("gibtsnicht.json")) = kern.einstellungenJson$(v)
WRITEALL("kaputt.json", "{1, 2")
PRINT "kaputt: "; kern.einstellungenJson$(kern.einstellungenLaden("kaputt.json")) = kern.einstellungenJson$(v)
WRITEALL("liste.json", "[1, 2]")
PRINT "liste: "; kern.einstellungenJson$(kern.einstellungenLaden("liste.json")) = kern.einstellungenJson$(v)
' was nicht passt, bleibt bei der Vorgabe; Zahlen werden geklemmt
DIM e AS kern.Einstellungen : e = kern.einstellungenLaden("krumm.json")
PRINT "krumm: autosave "; e.autosichernMinuten; " confirm_exit "; e.beendenFragen; " grid "; e.raster; " haupt "; e.rasterHaupt; " neben "; e.rasterNeben
PRINT "farben: haupt "; geHex6$(e.hauptFarbe); " hintergrund "; geHex6$(e.hintergrund); " | zelle "; e.zelleStandard; " "; e.zelleMin; ".."; e.zelleMax; " | zoom "; e.zoomTempo; " faktor "; kern.zoomFaktor(e)
PRINT "werkzeug "; e.startWerkzeug; " letztes "; e.letztesWerkzeug; " | pdf "; e.pdfZellen; " | palette "; e.palette; " | zuletzt "; JOIN$(e.zuletzt, ","); " | kuerzel "; JOIN$(MAPKEYS(e.kuerzel), ",")
' kleiner Abstand der kraeftigen Linien zieht das Neben-Raster mit
e.rasterHaupt = 5
e.rasterNeben = 5
kern.einstellungenOrdnen(e)
PRINT "haupt 5: neben "; e.rasterNeben
' Rundweg
e.pfad = "unter/einstellungen.json"
e.autor = "Anna Müller"
e.copyright = "© 2026 Anna"
MAPPUT(e.kuerzel, "export", "Strg+Umschalt+X")
kern.einstellungenSichern(e)
DIM f AS kern.Einstellungen : f = kern.einstellungenLaden("unter/einstellungen.json")
PRINT "rundweg gleich: "; kern.einstellungenJson$(f) = kern.einstellungenJson$(e); " | autor "; f.autor; " | "; f.copyright
' Zuletzt geoeffnet: vorn, ohne Doppelte, gekuerzt
DIM z AS kern.Einstellungen : z = NEW kern.Einstellungen()
z.zuletzt = []
z.zuletztAnzahl = 3
DIM i AS INTEGER
FOR i = 1 TO 5
    WRITEALL("m" + STR$(i) + ".pxs", "x")
    kern.zuletztHinzufuegen(z, "m" + STR$(i) + ".pxs")
NEXT
kern.zuletztHinzufuegen(z, "m4.pxs")
DIM n AS ARRAY OF STRING : n = []
DIM p AS STRING
FOR EACH p IN z.zuletzt
    ARRAY_PUSH(n, BASENAME(p))
NEXT
PRINT "zuletzt: "; JOIN$(n, " ")
DELETEFILE("m4.pxs")
PRINT "vorhanden: "; LEN(kern.zuletztVorhanden(z))
z.zuletztAnzahl = 1
kern.einstellungenOrdnen(z)
PRINT "auf 1: "; LEN(z.zuletzt)
' Voreinstellungen der Raster-Optionen (grid_options_dialog.py)
FOR i = 0 TO 3
    DIM r AS kern.Einstellungen : r = NEW kern.Einstellungen()
    kern.rasterVoreinstellung(r, i)
    PRINT kern.rasterVoreinstellungen()[i]; ": "; r.rasterHaupt; "/"; r.rasterNeben; " "; geHex6$(r.rasterFarbe); " "; geHex6$(r.nebenFarbe); " "; geHex6$(r.hauptFarbe)
NEXT
