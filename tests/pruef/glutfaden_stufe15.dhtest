=== probe: lineale, uebersicht, farbverlauf, kacheln
IMPORT "helfer.dh"
' --probe-stufe15 mit alle.pxs: Lineale (Springen, Zentrieren), Uebersicht
' (Ausschnitt, Springen), Farbverlauf (Leiste, Vorschau, ueber den Rand,
' gesetzt wie geplant, Rueckgaengig, Spiegel und Stichart, gesperrte Ebene,
' Farben verwalten), Kachel-Vorschau, Lineale/Uebersicht aus und gemerkt.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
' Gruene Punkte links am Rand (Schatten des Fensters + 25 Punkte Lineal);
' das Muster beginnt dort weiter rechts, die Statuszeile bleibt draussen
FUNCTION streifenGruen(pfad AS STRING) AS INTEGER
    DIM b AS IMAGE : b = LOADIMAGE(pfad)
    DIM n AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR y = 120 TO IMAGE_HEIGHT(b) - 80
        FOR x = 0 TO 70
            DIM f AS INTEGER : f = GETPIXEL(b, x, y)
            DIM r AS INTEGER : r = (f SHR 16) BAND 255
            DIM g AS INTEGER : g = (f SHR 8) BAND 255
            DIM bl AS INTEGER : bl = f BAND 255
            IF g - r > 40 AND g - bl > 25 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION

dlStarten(["run", BEISPIEL, "--", "--probe-stufe15", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["flaeche", "verlauf_vorschau", "kacheln", "kacheln_5x4", "ohne_lineale"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    ' die gruene Marke der Zeile unter dem Zeiger im Streifen des linken Lineals
    PRINT "lineal-marke: mit "; streifenGruen("d_flaeche.png") > 20; " | ohne lineale "; streifenGruen("d_ohne_lineale.png")
    ' 5 x 4 Kacheln zeigen mehr Stoff als 3 x 3
    PRINT "kacheln: mehr stoff bei 5x4 "; punkteGanz("d_kacheln_5x4.png", &HFAFAF5) > punkteGanz("d_kacheln.png", &HFAFAF5)
    PRINT "datei unveraendert: "; geLies$("alle.pxs") = geLies$("vorher.pxs")
END IF
