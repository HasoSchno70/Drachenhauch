=== symbolsuche wie pysticky
IMPORT "helfer.dh"
' Die Symbolsuche ueber alle Symbole aus daten/symbole.txt, mit den
' Unicode-Namen aus daten/symbolnamen.txt
DIM sy AS ARRAY OF STRING : sy = kern.symboleLaden(GLUTORDNER + "/daten/symbole.txt")
DIM nm AS MAP OF STRING : nm = kern.symbolnamenLaden(GLUTORDNER + "/daten/symbolnamen.txt")
DIM q AS STRING
FOR EACH q IN ["", "  ", "circle", "Black", "u+25cf", "U+25CF", "25CF", "25cf", "9679", "25", "black up", "x", "@", "  star ", "u+0041", "0041", "65", "2", "heart", "square", "white", "u+", "#", "triangle", "diamond", "65 ", "0", "a", "1", "99999999999999999999", "u+2665", "x2665"]
    DIM t AS STRING : t = ""
    DIM n AS INTEGER : n = 0
    DIM s AS STRING
    FOR EACH s IN sy
        IF kern.symbolPasst(s, IIF(MAPHAS(nm, s), MAPGET(nm, s), ""), q) THEN
            t = t + s
            n = n + 1
        END IF
    NEXT
    PRINT "'"; q; "' -> "; n; ": "; t
NEXT
