=== vorlagen: speichern mit menge, ort und haltbarkeit, laden
' Wie TemplateService: shopping_templates mit items_json. Laden setzt Menge,
' Lagerort und Haltbarkeit aus der Vorlage (die Python-App las sie und nahm
' doch die Vorgaben). Ohne Vorlage sagt es das (Enter).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
slZeilen = [] : slBild = 0
slHin(10, 10)
DIM k AS INTEGER
FOR k = 1 TO 6
    slWarten(12)
    slTaste(257)
NEXT
slAufnahmeSchreiben(p + "/_studio/tasten.txt")
PRINT "code "; kProbe(p, "probe.dh", "tasten.txt", 200)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "DELETE FROM shopping_templates")
DIM f AS Hauptfenster : f = studioStartFenster
DIM sc AS ScanFenster : sc = NEW ScanFenster()
sc.Zeigen()
' Ohne Vorlage: Meldung (Enter 1).
sc.knopfVorlageLaden_Klick()
sc.hinzufuegen("4001", "Vollmilch", NIL, 3, "Gefrierschrank", 5)
sc.hinzufuegen("", "Brot", NIL, 1, "", -1)
' Name (Enter 2 nimmt "Mein Einkauf"), Meldung (Enter 3).
sc.knopfVorlageSpeichern_Klick()
PRINT "vorlage "; JOIN$(textListe("SELECT name || ':' || IFNULL(usage_count, 0) FROM shopping_templates"), " ")
PRINT "inhalt "; textEin$("SELECT items_json FROM shopping_templates WHERE id = ?", STR$(dbZahl("SELECT MAX(id) FROM shopping_templates")))
PRINT "schritt "; verlauf.textZurueck$()
sc.Zumachen()
DIM s2 AS ScanFenster : s2 = NEW ScanFenster()
s2.Zeigen()
' Auswahl (Enter 4 = die erste), Meldung (Enter 5).
s2.knopfVorlageLaden_Klick()
DIM z AS INTEGER
FOR z = 0 TO GUI_TABLE_ROW_COUNT(s2.tabelle) - 1
    PRINT "  "; GUI_TABLE_GET_CELL(s2.tabelle, z, 1); " | "; GUI_TABLE_GET_CELL(s2.tabelle, z, 2); " | "; GUI_TABLE_GET_CELL(s2.tabelle, z, 3); " | "; GUI_TABLE_GET_CELL(s2.tabelle, z, 4); " | "; GUI_TABLE_GET_CELL(s2.tabelle, z, 10)
NEXT
PRINT "benutzt "; dbZahl("SELECT usage_count FROM shopping_templates")
--- erwartet
vorlage Mein Einkauf:0
inhalt [{"name":"Vollmilch","barcode":"4001","quantity":3,"storage_location":"Gefrierschrank","expiry_days":5,"category":"Milchprodukte","notes":null},{"name":"Brot","barcode":null,"quantity":1,"storage_location":"Kühlschrank","expiry_days":5,"category":"Backwaren","notes":null}]
schritt Template Mein Einkauf gespeichert
  Vollmilch | 4001 | 3 | 2026-11-13 | Gefrierschrank
  Brot |  | 1 | 2026-11-13 | Kühlschrank
benutzt 1
