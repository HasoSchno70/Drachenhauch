' Drachenhauch Studio: Datenbanken im Projekt (studio/datenbank.dh,
' studio/dbeditor.dh, docs/studio.md). Eine Datenbank ist ein Element mit
' ihrem Aufbau in <Name>.dhdb; die SQLite-Datei im Projektordner haelt die
' Entwicklungsdaten, jede Aenderung am Aufbau gilt dort sofort. Das erzeugte
' Programm hat die Verbindung als globale Variable unter dem Namen der
' Datenbank und ergaenzt fehlende Tabellen und Spalten selbst.
'
' Die ersten Faelle pruefen den Kern ohne Fenster -- gelesen wird die Datei
' mit PRAGMA table_info, also so, wie SQLite sie sieht. Die uebrigen starten
' das Studio als Kind (_hilfen/studiolauf.dh): ein erster Lauf misst die
' Lagen, ein zweiter klickt.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== den aufbau aendern gilt sofort in der datei
' Anlegen, Pflicht und Eindeutig (ein eigener Index), umbenennen (die Werte
' bleiben, der Index zieht mit), die Art aendern (die Tabelle wird neu
' aufgebaut), loeschen. Jeder Schritt in einer Transaktion.
IMPORT "kern.dh"
projOrdner = CWD$()
DIM e AS Element : e = elementNeu("datenbank", "Daten")
PRINT "datei "; dbDateiVon$(dbSchema(e))
PRINT "[" + dbTabelleNeu$(e, "kunden") + "]"
PRINT "[" + dbSpalteNeu$(e, "kunden", "name", "text") + "]"
PRINT "[" + dbSpalteAendern$(e, "kunden", "name", "text", TRUE, TRUE, "") + "]"
PRINT "[" + dbSpalteNeu$(e, "kunden", "umsatz", "geld") + "]"
zeige("kunden")
PRINT "[" + dbZeileNeu$(e, "kunden") + "] "; dbNeueId
PRINT "[" + dbZelleSetzen$(e, "kunden", 1, "name", "Anna") + "]"
PRINT "[" + dbZelleSetzen$(e, "kunden", 1, "umsatz", "12,5") + "]"
PRINT "[" + dbSpalteUmbenennen$(e, "kunden", "umsatz", "summe") + "]"
PRINT "[" + dbSpalteAendern$(e, "kunden", "summe", "zahl", TRUE, FALSE, "1,5") + "]"
PRINT "[" + dbTabelleUmbenennen$(e, "kunden", "kundschaft") + "]"
zeige("kundschaft")
PRINT "[" + dbZeilenLesen$(e, "kundschaft", 10) + "] "; dbGesamt; " "; JOIN$(dbZellen, "|")
PRINT "[" + dbSpalteLoeschen$(e, "kundschaft", "name") + "]"
zeige("kundschaft")
PRINT "[" + dbTabelleLoeschen$(e, "kundschaft") + "] "; dbTabZahl(dbSchema(e))
zeige("kundschaft")
--- datei kern.dh
IMPORT "json"
IMPORT "regex"
IMPORT "imgfx"
IMPORT "db"
IMPORT "{sammlung}/../../../studio/sprache.dh"
IMPORT "{sammlung}/../../../studio/bibliothek.dh"
IMPORT "{sammlung}/../../../studio/modell.dh"
IMPORT "{sammlung}/../../../studio/projekt.dh"
IMPORT "{sammlung}/../../../studio/datenbank.dh"
SUB zeige(tab AS STRING)
    DIM db AS DB_CONN : db = DB_OPEN("daten.sqlite")
    DIM r AS DB_RESULT : r = DB_QUERY(db, "PRAGMA table_info(" + tab + ")")
    WHILE DB_NEXT(r)
        PRINT "  "; DB_GET_STRING(r, 1); " "; DB_GET_STRING(r, 2); IIF(DB_GET_INT(r, 3) = 1, " NOT NULL", ""); IIF(DB_IS_NULL(r, 4), "", " DEFAULT " + DB_GET_STRING(r, 4))
    WEND
    r = DB_QUERY(db, "SELECT name FROM sqlite_master WHERE type = 'index' AND tbl_name = ? ORDER BY name", tab)
    WHILE DB_NEXT(r)
        PRINT "  index "; DB_GET_STRING(r, 0)
    WEND
    DB_CLOSE(db)
END SUB
--- erwartet
datei daten.sqlite
[]
[]
[]
[]
  id INTEGER
  name TEXT NOT NULL DEFAULT ''
  umsatz INTEGER
  index studio_u_kunden_name
[] 1
[]
[]
[]
[]
[]
  id INTEGER
  name TEXT NOT NULL DEFAULT ''
  summe REAL NOT NULL DEFAULT 1.5
  index studio_u_kundschaft_name
[] 1 Anna|1250
[]
  id INTEGER
  summe REAL NOT NULL DEFAULT 1.5
[] 0

=== ein geaenderter aufbau behaelt zeilen und fremde spalten
' Die Datei ist aelter als der Aufbau: name war keine Pflicht (eine Zeile hat
' NULL), ort fehlt, notiz hat das Programm selbst angelegt. Danach steht in
' der leeren Zeile die Vorgabe, ort ist da, notiz mit ihren Werten auch. Ein
' Eindeutig auf doppelte Werte geht nicht -- dann bleibt alles, wie es war,
' Datei UND Aufbau.
IMPORT "kern.dh"
projOrdner = CWD$()
DIM db AS DB_CONN : db = DB_OPEN("daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT, notiz TEXT)")
DB_EXEC(db, "INSERT INTO kunden (name, notiz) VALUES ('Anna', 'erste')")
DB_EXEC(db, "INSERT INTO kunden (name, notiz) VALUES (NULL, 'zweite')")
DB_EXEC(db, "INSERT INTO kunden (name, notiz) VALUES ('Anna', 'dritte')")
DB_CLOSE(db)
DIM e AS Element : e = elementNeu("datenbank", "Daten")
e.schema = READLINES("Daten.dhdb")[0]
PRINT "[" + dbAbgleichen$(e) + "]"
zeige("kunden")
liste()
DIM vorher AS STRING : vorher = e.schema
DIM f AS STRING : f = dbSpalteAendern$(e, "kunden", "name", "text", TRUE, TRUE, "?")
PRINT "eindeutig geht nicht "; f <> ""; " "; INSTR(f, "name") >= 0
PRINT "aufbau gleich "; e.schema = vorher
zeige("kunden")
--- datei Daten.dhdb
{"datei":"daten.sqlite","tabellen":[{"name":"kunden","spalten":[{"name":"name","typ":"text","pflicht":true,"eindeutig":false,"vorgabe":"?"},{"name":"ort","typ":"text","pflicht":false,"eindeutig":false,"vorgabe":""}]}]}
--- datei kern.dh
IMPORT "json"
IMPORT "regex"
IMPORT "imgfx"
IMPORT "db"
IMPORT "{sammlung}/../../../studio/sprache.dh"
IMPORT "{sammlung}/../../../studio/bibliothek.dh"
IMPORT "{sammlung}/../../../studio/modell.dh"
IMPORT "{sammlung}/../../../studio/projekt.dh"
IMPORT "{sammlung}/../../../studio/datenbank.dh"
SUB zeige(tab AS STRING)
    DIM db AS DB_CONN : db = DB_OPEN("daten.sqlite")
    DIM r AS DB_RESULT : r = DB_QUERY(db, "PRAGMA table_info(" + tab + ")")
    WHILE DB_NEXT(r)
        PRINT "  "; DB_GET_STRING(r, 1); " "; DB_GET_STRING(r, 2); IIF(DB_GET_INT(r, 3) = 1, " NOT NULL", ""); IIF(DB_IS_NULL(r, 4), "", " DEFAULT " + DB_GET_STRING(r, 4))
    WEND
    r = DB_QUERY(db, "SELECT name FROM sqlite_master WHERE type = 'index' AND tbl_name = ? ORDER BY name", tab)
    WHILE DB_NEXT(r)
        PRINT "  index "; DB_GET_STRING(r, 0)
    WEND
    DB_CLOSE(db)
END SUB
SUB liste()
    DIM db AS DB_CONN : db = DB_OPEN("daten.sqlite")
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT id, name, notiz, ort FROM kunden ORDER BY id")
    WHILE DB_NEXT(r)
        PRINT "  "; DB_GET_INT(r, 0); " "; DB_GET_STRING(r, 1); " "; DB_GET_STRING(r, 2); " "; IIF(DB_IS_NULL(r, 3), "NULL", DB_GET_STRING(r, 3))
    WEND
    DB_CLOSE(db)
END SUB
--- erwartet
[]
  id INTEGER
  name TEXT NOT NULL DEFAULT '?'
  ort TEXT
  notiz TEXT
  1 Anna erste NULL
  2 ? zweite NULL
  3 Anna dritte NULL
eindeutig geht nicht TRUE TRUE
aufbau gleich TRUE
  id INTEGER
  name TEXT NOT NULL DEFAULT '?'
  ort TEXT
  notiz TEXT

=== werte werden nach ihrer art geschrieben und gelesen
' Geld in Cent, Kommazahl mit Komma, Ja/Nein als 0/1, Datum als JJJJ-MM-TT.
' Leer ist NULL, ausser bei einer Pflichtspalte; was nicht passt, wird nicht
' geschrieben.
IMPORT "kern.dh"
projOrdner = CWD$()
DIM e AS Element : e = elementNeu("datenbank", "Daten")
e.schema = READLINES("Daten.dhdb")[0]
PRINT "[" + dbAbgleichen$(e) + "]"
PRINT "[" + dbZeileNeu$(e, "posten") + "] "; dbNeueId
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "preis", "19,99") + "]"
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "gewicht", "2.5") + "]"
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "lager", "nein") + "]"
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "seit", "2026-11-03") + "]"
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "menge", "-4") + "]"
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "menge", "4,5") + "]"
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "seit", "3.11.2026") + "]"
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "name", "") + "]"
PRINT "[" + dbZelleSetzen$(e, "posten", 1, "gewicht", "") + "]"
PRINT "[" + dbZeilenLesen$(e, "posten", 10) + "] "; JOIN$(dbZellen, "|")
DIM db AS DB_CONN : db = DB_OPEN("daten.sqlite")
DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT preis, typeof(preis), lager, typeof(gewicht), menge FROM posten")
IF DB_NEXT(r) THEN PRINT DB_GET_INT(r, 0); " "; DB_GET_STRING(r, 1); " "; DB_GET_INT(r, 2); " "; DB_GET_STRING(r, 3); " "; DB_GET_INT(r, 4)
DB_CLOSE(db)
--- datei Daten.dhdb
{"datei":"daten.sqlite","tabellen":[{"name":"posten","spalten":[{"name":"name","typ":"text","pflicht":true,"eindeutig":false,"vorgabe":"neu"},{"name":"preis","typ":"geld","pflicht":false,"eindeutig":false,"vorgabe":""},{"name":"gewicht","typ":"zahl","pflicht":false,"eindeutig":false,"vorgabe":""},{"name":"lager","typ":"wahr","pflicht":true,"eindeutig":false,"vorgabe":"ja"},{"name":"seit","typ":"datum","pflicht":false,"eindeutig":false,"vorgabe":""},{"name":"menge","typ":"ganz","pflicht":false,"eindeutig":false,"vorgabe":""}]}]}
--- datei kern.dh
