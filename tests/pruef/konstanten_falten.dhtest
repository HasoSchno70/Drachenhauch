' Konstanten falten (2026-09-24): der Compiler rechnet `2 * 3`, `BREITE \ 2`
' oder `-GRENZE` schon beim Uebersetzen aus, mit denselben Funktionen wie die
' Laufzeit (`vm::konstant_rechnen`). Globale CONSTs mit festem Wert setzt er
' ein. Die Faelle pruefen, dass das Ergebnis GENAU dem der Laufzeit gleicht.
' Format: docs/werkzeuge.md.

=== gefaltet und zur laufzeit gerechnet sind gleich
' Links Literale (gefaltet), rechts dieselben Werte ueber Variablen (Laufzeit).
DIM a AS INTEGER
DIM b AS INTEGER
DIM x AS FLOAT
DIM y AS FLOAT
DIM s AS STRING
a = 17 : b = 5 : x = 2.5 : y = 0.4 : s = "ab"
PRINT 17 + 5; " "; a + b
PRINT 17 - 5; " "; a - b
PRINT 17 * 5; " "; a * b
PRINT 17 / 5; " "; a / b
PRINT 17 \ 5; " "; a \ b
PRINT 17 MOD 5; " "; a MOD b
PRINT -17 MOD 5; " "; -a MOD b
PRINT 17 ^ 2; " "; a ^ 2
PRINT 2.5 * 0.4; " "; x * y
PRINT 2.5 + 17; " "; x + a
PRINT "ab" + 5; " "; s + b
PRINT "ab" * 3; " "; s * 3
PRINT -(17 - 20); " "; -(a - 20)
PRINT TYPEOF(17 / 5); " "; TYPEOF(a / b); " "; TYPEOF(17 \ 5); " "; TYPEOF(a \ b)
--- erwartet
22 22
12 12
85 85
3.4 3.4
3 3
2 2
3 3
289 289
1.0 1.0
19.5 19.5
ab5 ab5
ababab ababab
3 3
FLOAT FLOAT INTEGER INTEGER

=== eine const wird eingesetzt und mitgerechnet
CONST BREITE = 640
CONST HOEHE AS INTEGER = 480
CONST MITTE_X = BREITE \ 2
CONST SKALA AS FLOAT = 2
CONST TITEL = "Spiel " + "1"
PRINT MITTE_X; " "; HOEHE / 2; " "; SKALA; " "; TYPEOF(SKALA); " "; TITEL
SUB innen()
    PRINT BREITE - MITTE_X; " "; -HOEHE
END SUB
innen()
--- erwartet
320 240.0 2.0 FLOAT Spiel 1
320 -480

=== ueberlauf bleibt ein laufzeitfehler
DIM x AS INTEGER
x = 9223372036854775807 + 1
--- fehler
+

=== division durch 0 in einem nie genommenen zweig stoert nicht
' Faltet der Compiler einen Fehler nicht, bleibt er dort, wo er hingehoert:
' in der Zeile, die auch laeuft.
IF FALSE THEN PRINT 1 \ 0
PRINT "weiter"
PRINT 1 \ 0
--- fehler
Division

=== eine const in zwei zweigen wird nicht eingesetzt
DIM modus AS INTEGER
modus = 2
IF modus = 1 THEN
    CONST TEMPO = 10
ELSE
    CONST TEMPO = 20
END IF
PRINT TEMPO * 2
--- erwartet
40

=== ein lokaler name verdeckt die const
CONST WERT = 5
FUNCTION f(wert AS INTEGER) AS INTEGER
    RETURN wert * 2
END FUNCTION
SUB g()
    DIM wert AS INTEGER
    wert = 7
    PRINT wert + 1
END SUB
PRINT f(3); " "; WERT * 2
g()
--- erwartet
6 10
8

=== eine const mit falschem typ bleibt ein laufzeitfehler
CONST ZAHL AS INTEGER = "sieben"
PRINT ZAHL
--- fehler
Erwartet INTEGER

=== ein gefalteter ausdruck wird zur fertigen zahl
' Bis 2026-10-30 gemessen (`x + 2 * FAKTOR` gegen `x + 6`, bester von drei
' Laeufen) -- auf einem ausgelasteten Laeufer kippte der Vergleich trotzdem.
' Jetzt der Bytecode selbst: gefaltet hat er genau so viele Befehle wie die
' fertige Zahl, und die 2 steht nicht mehr unter den Konstanten.
IMPORT "helfer.dh"
FUNCTION befehle(datei AS STRING) AS INTEGER
    dlStarten(["--dumpbc", datei])
    DIM h AS JSON_HANDLE : h = JSON_PARSE(dlAus)
    RETURN JSON_LEN(h, "main.code")
END FUNCTION
FUNCTION hatKonstante(datei AS STRING, wert AS INTEGER) AS BOOLEAN
    dlStarten(["--dumpbc", datei])
    DIM h AS JSON_HANDLE : h = JSON_PARSE(dlAus)
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(h, "main.constants") - 1
        IF JSON_TYPE(h, "main.constants." + STR$(i)) = "number" THEN
            IF JSON_GET_FLOAT(h, "main.constants." + STR$(i)) = wert THEN RETURN TRUE
        END IF
    NEXT
    RETURN FALSE
END FUNCTION
PRINT befehle("gefaltet.dh") = befehle("fertig.dh"); " "; befehle("gefaltet.dh") < befehle("offen.dh")
PRINT hatKonstante("gefaltet.dh", 2); " "; hatKonstante("gefaltet.dh", 6)
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- datei fertig.dh
CONST FAKTOR = 3
DIM x AS INTEGER
DIM y AS INTEGER : y = 3
x = x + 6
--- datei gefaltet.dh
CONST FAKTOR = 3
DIM x AS INTEGER
DIM y AS INTEGER : y = 3
x = x + 2 * FAKTOR
--- datei offen.dh
CONST FAKTOR = 3
DIM x AS INTEGER
DIM y AS INTEGER : y = 3
x = x + 2 * y
--- erwartet
TRUE TRUE
FALSE TRUE
