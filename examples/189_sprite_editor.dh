' ------------------------------------------------- Fenster "Bild benennen"
' Ein eigenes Fenster statt eines Feldes in der Spalte: die rechte Spalte ist
' bis zur Statuszeile voll, und ein Umbau von ihr waere ein hoher Preis fuer
' ein Feld, das man selten braucht.
DIM winName AS GUI_WINDOW
winName = GUI_WINDOW("Bild benennen", SW \ 2 - 170, SH \ 2 - 70, 340, 140)
lbl = GUI_LABEL(winName, "Name", 16, 18)
DIM tiBild AS GUI_WIDGET : tiBild = GUI_TEXTINPUT(winName, 16, 42, 308, 30, "")
DIM bNamOk AS GUI_WIDGET : bNamOk = GUI_BUTTON(winName, "Uebernehmen", 130, 84, 110, 30)
DIM bNamAb AS GUI_WIDGET : bNamAb = GUI_BUTTON(winName, "Abbrechen", 246, 84, 90, 30)
GUI_WINDOW_VISIBLE(winName, FALSE)
DIM namOffen AS BOOLEAN : namOffen = FALSE

DIM statOffen AS BOOLEAN : statOffen = FALSE
DIM statDlg AS GUI_WINDOW

' ============================================================ Listen

SUB listenAuffrischen()
    DIM namen[MAX(anzBild, 1)] AS STRING
    DIM k AS INTEGER
    FOR k = 0 TO anzBild - 1
        ' Die Nummer bleibt sichtbar -- ein Bild nur ueber seinen Namen zu
        ' zeigen, macht die Reihenfolge unlesbar, und die ist beim Abspielen
        ' das Entscheidende.
        namen[k] = "Bild " + STR$(k + 1)
        IF bildName[k] <> "" THEN namen[k] = namen[k] + "  (" + bildName[k] + ")"
    NEXT
    GUI_SET_LISTBOX(lstBild, namen)
    GUI_LISTBOX_SET_SELECTED(lstBild, aktBild)

    DIM en[MAX(anzEb, 1)] AS STRING
    FOR k = 0 TO anzEb - 1
        en[k] = IIF(ebSicht[k] = 1, "", "(aus)  ") + ebName[k]
    NEXT
    GUI_SET_LISTBOX(lstEb, en)
    GUI_LISTBOX_SET_SELECTED(lstEb, aktEb)
    GUI_SET_CHECKED(cbEbSicht, ebSicht[aktEb] = 1)

    DIM an[MAX(anzAnim, 1)] AS STRING
    an[0] = ""
    FOR k = 0 TO anzAnim - 1
        an[k] = anName[k] + "   " + STR$(anVon[k] + 1) + "-" + STR$(anBis[k] + 1) + _
                "  @" + STR$(anFps[k])
    NEXT
    GUI_SET_LISTBOX(lstAnim, an)
    GUI_LISTBOX_SET_SELECTED(lstAnim, aktAnim)
END SUB

' Was in den Feldern steht, in Platz `idx` schreiben. EINE Stelle fuer
' [Hinzu] und [Aendern] -- die beiden unterscheiden sich nur im Platz.
SUB bereichSchreiben(idx AS INTEGER)
    DIM nm AS STRING : nm = TRIM$(GUI_TEXT(tiAnim))
    IF nm = "" THEN nm = "bereich" + STR$(idx + 1)
    DIM v AS INTEGER : v = INT(GUI_VALUE(spVon)) - 1
    DIM b AS INTEGER : b = INT(GUI_VALUE(spBis)) - 1
    ' Verdrehte Grenzen tauschen statt melden: gemeint ist offensichtlich
    ' der Bereich dazwischen.
    IF v > b THEN
        DIM t AS INTEGER : t = v : v = b : b = t
    END IF
    ' Auf vorhandene Bilder klemmen -- ein Bereich, der ins Leere zeigt,
    ' liesse die Vorschau auf ein Bild greifen, das es nicht gibt.
    v = MAX(0, MIN(anzBild - 1, v))
    b = MAX(0, MIN(anzBild - 1, b))
    anName[idx] = nm : anVon[idx] = v : anBis[idx] = b
    anFps[idx] = MAX(1, INT(GUI_VALUE(spFps)))
END SUB

' Bereiche nachziehen, nachdem Bild `at` geloescht wurde (anzBild ist da
' schon kleiner). `von` rueckt NUR nach, wenn das geloeschte Bild davor lag;
' lag es genau auf `von`, ruecht das naechste Bild an dessen Stelle und der
' Bereich beginnt weiterhin dort. Ein Bereich, der nur aus dem geloeschten
' Bild bestand, faellt beim Vergleich unten von selbst heraus.
SUB bereicheNachLoeschen(at AS INTEGER)
    DIM n AS INTEGER : n = 0
    DIM i AS INTEGER
    FOR i = 0 TO anzAnim - 1
        DIM v AS INTEGER : v = anVon[i]
        DIM b AS INTEGER : b = anBis[i]
        IF v > at THEN v = v - 1
        IF b >= at THEN b = b - 1
        IF b >= v AND v >= 0 THEN
            anName[n] = anName[i]
            anVon[n] = v
            anBis[n] = MIN(b, anzBild - 1)
            anFps[n] = anFps[i]
            n = n + 1
        END IF
    NEXT
    anzAnim = n
    IF aktAnim >= anzAnim THEN aktAnim = anzAnim - 1
END SUB

' ============================================================ Hauptschleife

neuesSprite(gw, gh)
listenAuffrischen()

DIM zeit AS FLOAT : zeit = 0.0

WHILE NOT QUITREQUESTED()
    ' Solange ein Fenster obenauf liegt, gehoert die Eingabe ihm. ESC waere
    ' sonst nicht "Dialog zu", sondern "Programm zu" -- und Tastenkuerzel
    ' wuerden hinter dem Dialog Werkzeuge umschalten.
    DIM sperre AS BOOLEAN : sperre = neuOffen OR statOffen OR grOffen OR namOffen
    IF KEYHIT(KEY_ESCAPE) AND NOT sperre THEN BREAK
    zeit = zeit + DELTA()
    SW = SCREENWIDTH() : SH = SCREENHEIGHT()
    GUI_WINDOW_SET_BOUNDS(win, 0, 0, SW, SH)
    GUI_UPDATE()

    DIM strg AS BOOLEAN
    strg = KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)

    farbe = GUI_PICKED_COLOR(cp)
    pinsel = INT(GUI_VALUE(spPinsel))
    symX = GUI_CHECKED(cbSymX)
    symY = GUI_CHECKED(cbSymY)
    DIM kachelnJetzt AS BOOLEAN : kachelnJetzt = GUI_CHECKED(cbKacheln)
    IF kachelnJetzt <> kacheln THEN
        kacheln = kachelnJetzt
        ' Neu einpassen: 3x3 braucht die dreifache Kantenlaenge. Ohne das
        ' waere die Kachel-Ansicht bei eingepasstem Zoom gar nicht zu sehen.
        anpassen = TRUE
    END IF

    ' ------------------------------------------------------ Werkzeugwahl
    FOR i = 0 TO WZ_ANZ - 1
        IF GUI_CLICKED(wzKnopf[i]) THEN werkzeug = i
        GUI_SET_COLOR(wzKnopf[i], "bg", IIF(i = werkzeug, &H1B5C74, &H1A2430))
    NEXT
    IF NOT sperre AND NOT strg THEN
        IF KEYHIT(KEY_P) THEN werkzeug = WZ_STIFT
        IF KEYHIT(KEY_E) THEN werkzeug = WZ_RADIER
        IF KEYHIT(KEY_F) THEN werkzeug = WZ_FUELL
        IF KEYHIT(KEY_L) THEN werkzeug = WZ_LINIE
        IF KEYHIT(KEY_R) THEN werkzeug = WZ_RECHT
        IF KEYHIT(KEY_O) THEN werkzeug = WZ_ELLIPSE
        IF KEYHIT(KEY_I) THEN werkzeug = WZ_PIPETTE
        IF KEYHIT(KEY_S) THEN werkzeug = WZ_AUSWAHL
        IF KEYHIT(KEY_Y) THEN werkzeug = WZ_SPRUEH
        IF KEYHIT(KEY_Q) THEN werkzeug = WZ_LASSO
        IF KEYHIT(KEY_Z) THEN werkzeug = WZ_ZAUBER
        IF KEYHIT(KEY_V) THEN werkzeug = WZ_VERSCHIEB
        IF KEYHIT(KEY_T) THEN GUI_SET_CHECKED(cbKacheln, NOT kacheln)
        FOR i = 0 TO 5
            IF KEYHIT(KEY_1 + i) THEN
                farbe = pal[i]
                GUI_SET_PICKED_COLOR(cp, farbe)
            END IF
        NEXT
        IF KEYHIT(43) THEN GUI_SET_VALUE(spPinsel, MIN(6, pinsel + 1))
        IF KEYHIT(45) THEN GUI_SET_VALUE(spPinsel, MAX(1, pinsel - 1))
    END IF

    ' ------------------------------------------------------------ Datei
    IF GUI_CLICKED(bNeu) THEN
        GUI_WINDOW_VISIBLE(winNeu, TRUE) : neuOffen = TRUE
        ' Nach VORNE holen, sonst ist es nicht bedienbar: ein Klick bringt
        ' immer sein Fenster nach oben, und der Klick auf [Neu] war einer
        ' auf das Hauptfenster -- das den ganzen Schirm fuellt. Danach
        ' liegt es ueber dem Kasten und faengt jeden Klick ab.
        ' GUI_FOCUS holt das Fenster nach vorn UND setzt die Schreibmarke
        ' ins erste Feld.
        GUI_FOCUS(spB)
    END IF
    IF GUI_CLICKED(bNeuAb) THEN
        GUI_WINDOW_VISIBLE(winNeu, FALSE) : neuOffen = FALSE
    END IF
    IF GUI_CLICKED(bNeuOk) THEN
        neuesSprite(INT(GUI_VALUE(spB)), INT(GUI_VALUE(spH)))
        listenAuffrischen()
        GUI_WINDOW_VISIBLE(winNeu, FALSE) : neuOffen = FALSE
    END IF
    IF GUI_CLICKED(bPng) THEN
        DIM p AS STRING : p = FILE_SAVE_DIALOG("Bild sichern", "sprite.png", "png")
        IF p <> "" THEN
            ' Nur das aktuelle Einzelbild -- ueber den Streifen gebaut und
            ' wieder ausgeschnitten waere ein Umweg; hier reicht ein Ziel.
            DIM eins AS IMAGE : eins = IMAGE_NEW(gw, gh)
            DIM k AS INTEGER
            FOR k = 0 TO anzEb - 1
                IF ebSicht[k] = 1 THEN IMAGE_DRAW_IMAGE(eins, ebene[aktBild, k], 0, 0)
            NEXT
            TRY
                IMAGE_SAVE(eins, p)
                meldung = "gesichert: " + p
            CATCH e
                meldung = e
            END TRY
            IMAGE_FREE(eins)             ' nur zum Schreiben gebraucht
        END IF
    END IF
    IF GUI_CLICKED(bOeffnen) THEN
        DIM po AS STRING
        po = FILE_OPEN_DIALOG("Oeffnen", "dhsprite,png")
        IF po <> "" THEN
            TRY
                ' Die Endung entscheidet -- zwei Knoepfe fuer "oeffnen" waeren
                ' eine Frage, die der Rechner selbst beantworten kann.
                IF RIGHT$(LOWER$(po), 9) = ".dhsprite" THEN
                    nativLaden(po)
                ELSE
                    streifenLaden(po)
                END IF
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF
    IF GUI_CLICKED(bGbCode) THEN
        DIM pc AS STRING
        pc = FILE_SAVE_DIALOG("GB-Code sichern", "sprite.dh", "dh")
        IF pc <> "" THEN
            TRY
                gbCodeSichern(pc)
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF
    IF GUI_CLICKED(bDhanim) THEN
        DIM pa AS STRING
        pa = FILE_SAVE_DIALOG("Zustandsmaschine sichern", "sprite.dhanim", "dhanim")
        IF pa <> "" THEN
            TRY
                dhanimSichern(pa)
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF
    IF GUI_CLICKED(bZuschnitt) THEN zuschneiden()
    IF GUI_CLICKED(bGroesse) THEN
        ' Mit der AKTUELLEN Groesse vorbelegen -- wer nur die Breite aendern
        ' will, soll die Hoehe nicht von Hand nachstellen muessen.
        GUI_SET_VALUE(spGrB, gw)
        GUI_SET_VALUE(spGrH, gh)
        GUI_WINDOW_VISIBLE(winGr, TRUE) : grOffen = TRUE
        GUI_FOCUS(spGrB)                 ' nach vorn -- siehe [Neu]
    END IF
    IF GUI_CLICKED(bGrAb) THEN
        GUI_WINDOW_VISIBLE(winGr, FALSE) : grOffen = FALSE
    END IF
    IF GUI_CLICKED(bGrOk) THEN
        DIM ngb AS INTEGER : ngb = INT(GUI_VALUE(spGrB))
        DIM ngh AS INTEGER : ngh = INT(GUI_VALUE(spGrH))
        IF ngb <> gw OR ngh <> gh THEN
            groesseAendern(ngb, ngh, 0, 0)
            meldung = "Groesse: " + STR$(ngb) + "x" + STR$(ngh)
        END IF
        GUI_WINDOW_VISIBLE(winGr, FALSE) : grOffen = FALSE
    END IF
    IF GUI_CLICKED(bStat) AND NOT statOffen THEN
        statDlg = GUI_DIALOG("Statistik", statistik$())
        statOffen = TRUE
    END IF
    IF statOffen THEN
        ' Die Antwort gilt genau EIN Bild -- danach ist das Fenster weg.
        IF GUI_ANSWER(statDlg) <> 0 THEN statOffen = FALSE
    END IF
    IF GUI_CLICKED(bPalLaden) THEN
        DIM pl AS STRING
        pl = FILE_OPEN_DIALOG("Palette laden", "gpl")
        IF pl <> "" THEN
            TRY
                paletteLaden(pl)
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF
    IF GUI_CLICKED(bPalSichern) THEN
        DIM pv AS STRING
        pv = FILE_SAVE_DIALOG("Palette sichern", "palette.gpl", "gpl")
        IF pv <> "" THEN
            TRY
                paletteSichern(pv)
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF
    IF GUI_CLICKED(bGif) THEN
        DIM pg AS STRING
        pg = FILE_SAVE_DIALOG("Bewegtes GIF sichern", "sprite.gif", "gif")
        IF pg <> "" THEN
            TRY
                gifSichern(pg, GUI_VALUE(slTempo))
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF
    IF GUI_CLICKED(bSichern) THEN
        DIM ps AS STRING
        ps = FILE_SAVE_DIALOG("Sichern", "sprite.dhsprite", "dhsprite")
        IF ps <> "" THEN
            TRY
                nativSichern(ps)
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF
    IF GUI_CLICKED(bBlatt) THEN
        DIM pb AS STRING : pb = FILE_SAVE_DIALOG("Streifen sichern", "sprites.png", "png")
        IF pb <> "" THEN
            baueStreifen()
            TRY
                ' Der Streifen ist so breit wie MAXBILD -- fuer die Datei
                ' auf die belegten Bilder zuschneiden, sonst schleppt jede
                ' Ausgabe leere Felder mit.
                DIM eng AS IMAGE : eng = IMAGE_CROP(streifen, 0, 0, gw * anzBild, gh)
                IMAGE_SAVE(eng, pb)
                IMAGE_FREE(eng)          ' nur zum Schreiben gebraucht
                DIM pj AS STRING : pj = REPLACE$(pb, ".png", ".json")
                WRITEALL(pj, atlasJson$(BASENAME(pb)))
                meldung = "Streifen + Atlas: " + pj
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF

    ' ---------------------------------------------------------- Verlauf
    IF GUI_CLICKED(bZur) OR (strg AND KEYHIT(KEY_Z)) THEN zurueck()
    IF GUI_CLICKED(bVor) OR (strg AND KEYHIT(KEY_Y)) THEN wieder()
    GUI_SET_ENABLED(bZur, uPos > 0)
    GUI_SET_ENABLED(bVor, uPos < uAnz)

    ' ------------------------------------------------- Einzelbilder/Ebenen
    DIM sel AS INTEGER : sel = GUI_LISTBOX_SELECTED(lstBild)
    IF sel >= 0 AND sel < anzBild AND sel <> aktBild THEN
        aktBild = sel
        listenAuffrischen()
    END IF
    IF GUI_CLICKED(bBildNeu) AND anzBild < MAXBILD THEN
        anzBild = anzBild + 1
        aktBild = anzBild - 1
        DIM k2 AS INTEGER
        FOR k2 = 0 TO MAXEB - 1
            IMAGE_CLEAR(ebene[aktBild, k2])
        NEXT
        bildName[aktBild] = ""
        listenAuffrischen()
    END IF
    IF GUI_CLICKED(bBildKopie) AND anzBild < MAXBILD THEN
        DIM q AS INTEGER : q = aktBild
        anzBild = anzBild + 1
        aktBild = anzBild - 1
        DIM k3 AS INTEGER
        FOR k3 = 0 TO MAXEB - 1
            kopiere(ebene[aktBild, k3], ebene[q, k3])
        NEXT
        ' Der Name wird NICHT mitkopiert: zwei Bilder mit demselben Namen
        ' waeren zwei Atlas-Schluessel, von denen einer verlorenginge.
        bildName[aktBild] = ""
        listenAuffrischen()
    END IF
    IF GUI_CLICKED(bBildName) THEN
        GUI_SET_TEXT(tiBild, bildName[aktBild])
        GUI_WINDOW_VISIBLE(winName, TRUE) : namOffen = TRUE
        GUI_FOCUS(tiBild)                ' nach vorn -- siehe [Neu]
    END IF
    IF GUI_CLICKED(bNamAb) THEN
        GUI_WINDOW_VISIBLE(winName, FALSE) : namOffen = FALSE
    END IF
    IF GUI_CLICKED(bNamOk) THEN
        DIM nn AS STRING : nn = alsName$(GUI_TEXT(tiBild))
        ' Sagen, wenn etwas geaendert wurde -- still zu saeubern waere die
        ' unangenehmere Ueberraschung.
        IF nn <> TRIM$(GUI_TEXT(tiBild)) THEN
            meldung = "Name auf Kennung gebracht: " + IIF(nn = "", "(leer)", nn)
        ELSE
            meldung = IIF(nn = "", "Name entfernt", "Bild heisst jetzt " + nn)
        END IF
        bildName[aktBild] = nn
        GUI_WINDOW_VISIBLE(winName, FALSE) : namOffen = FALSE
        listenAuffrischen()
    END IF
    IF GUI_CLICKED(bBildWeg) THEN
        IF anzBild > 1 THEN
            DIM weg AS INTEGER : weg = aktBild
            DIM j AS INTEGER
            DIM k4 AS INTEGER
            FOR j = aktBild TO anzBild - 2
                FOR k4 = 0 TO MAXEB - 1
                    kopiere(ebene[j, k4], ebene[j + 1, k4])
                NEXT
                bildName[j] = bildName[j + 1]
            NEXT
            bildName[anzBild - 1] = ""
            anzBild = anzBild - 1
            IF aktBild >= anzBild THEN aktBild = anzBild - 1
            uStart = 0 : uAnz = 0 : uPos = 0
            bereicheNachLoeschen(weg)
            listenAuffrischen()
        ELSE
            meldung = "Das letzte Bild bleibt."
        END IF
    END IF

    ' --------------------------------------------------- Animationsbereiche
    DIM selA AS INTEGER : selA = GUI_LISTBOX_SELECTED(lstAnim)
    IF selA >= 0 AND selA < anzAnim AND selA <> aktAnim THEN
        ' Die Auswahl fuellt die Felder -- sonst muesste man zum Aendern
        ' alles noch einmal eintippen.
        aktAnim = selA
        GUI_SET_TEXT(tiAnim, anName[aktAnim])
        GUI_SET_VALUE(spVon, anVon[aktAnim] + 1)
        GUI_SET_VALUE(spBis, anBis[aktAnim] + 1)
        GUI_SET_VALUE(spFps, anFps[aktAnim])
    END IF
    IF GUI_CLICKED(bAnimNeu) THEN
        IF anzAnim >= MAXANIM THEN
            meldung = "Mehr als " + STR$(MAXANIM) + " Bereiche gehen nicht."
        ELSE
            bereichSchreiben(anzAnim)
            aktAnim = anzAnim
            anzAnim = anzAnim + 1
            listenAuffrischen()
        END IF
    END IF
    IF GUI_CLICKED(bAnimAend) AND aktAnim >= 0 THEN
        bereichSchreiben(aktAnim)
        listenAuffrischen()
    END IF
    IF GUI_CLICKED(bAnimWeg) AND aktAnim >= 0 THEN
        DIM q2 AS INTEGER
        FOR q2 = aktAnim TO anzAnim - 2
            anName[q2] = anName[q2 + 1] : anVon[q2] = anVon[q2 + 1]
            anBis[q2] = anBis[q2 + 1] : anFps[q2] = anFps[q2 + 1]
        NEXT
        anzAnim = anzAnim - 1
        aktAnim = MIN(aktAnim, anzAnim - 1)
        listenAuffrischen()
    END IF

    DIM selE AS INTEGER : selE = GUI_LISTBOX_SELECTED(lstEb)
    IF selE >= 0 AND selE < anzEb AND selE <> aktEb THEN
        aktEb = selE
        listenAuffrischen()
    END IF
    IF GUI_CLICKED(bEbNeu) AND anzEb < MAXEB THEN
        anzEb = anzEb + 1
        aktEb = anzEb - 1
        DIM j2 AS INTEGER
        FOR j2 = 0 TO MAXBILD - 1
            IMAGE_CLEAR(ebene[j2, aktEb])
        NEXT
        ebSicht[aktEb] = 1
        listenAuffrischen()
    END IF
    IF GUI_CLICKED(bEbWeg) THEN
        IF anzEb > 1 THEN
            DIM j3 AS INTEGER
            DIM k5 AS INTEGER
            FOR k5 = aktEb TO anzEb - 2
                FOR j3 = 0 TO MAXBILD - 1
                    kopiere(ebene[j3, k5], ebene[j3, k5 + 1])
                NEXT
                ebSicht[k5] = ebSicht[k5 + 1]
            NEXT
            anzEb = anzEb - 1
            IF aktEb >= anzEb THEN aktEb = anzEb - 1
            uStart = 0 : uAnz = 0 : uPos = 0
            listenAuffrischen()
        ELSE
            meldung = "Die letzte Ebene bleibt."
        END IF
    END IF
    IF GUI_CLICKED(cbEbSicht) THEN
        ebSicht[aktEb] = IIF(GUI_CHECKED(cbEbSicht), 1, 0)
        listenAuffrischen()
    END IF

    ' ------------------------------------------------------------- Maus
    DIM cx AS INTEGER : cx = GUI_CANVAS_X(leinwand)
    DIM cy AS INTEGER : cy = GUI_CANVAS_Y(leinwand)
    DIM cw AS INTEGER : cw = GUI_CANVAS_W(leinwand)
    DIM ch AS INTEGER : ch = GUI_CANVAS_H(leinwand)
    DIM mx AS INTEGER : mx = MOUSEX()
    DIM my AS INTEGER : my = MOUSEY()
    ' Das Sprite liegt mittig in der Flaeche; panX/panY verschiebt es.
    DIM ox AS INTEGER : ox = cx + (cw - gw * zoom) \ 2 + panX
    DIM oy AS INTEGER : oy = cy + (ch - gh * zoom) \ 2 + panY
    IF anpassen AND cw > 0 AND ch > 0 THEN
        ' Einpassen mit etwas Luft, damit der Rand sichtbar bleibt.
        ' Bei Kachel-Ansicht muss die dreifache Kantenlaenge hineinpassen.
        DIM kf AS INTEGER : kf = IIF(kacheln, 3, 1)
        zoom = MAX(1, MIN(32, MIN((cw - 40) \ (gw * kf), (ch - 40) \ (gh * kf))))
        ox = cx + (cw - gw * zoom) \ 2
        oy = cy + (ch - gh * zoom) \ 2
        anpassen = FALSE
    END IF
    DIM ueber AS BOOLEAN
    ueber = mx >= cx AND mx < cx + cw AND my >= cy AND my < cy + ch AND NOT sperre
    DIM tx AS INTEGER : tx = FLOOR((mx - ox) / zoom)
    DIM ty AS INTEGER : ty = FLOOR((my - oy) / zoom)
    DIM drauf AS BOOLEAN
    drauf = ueber AND tx >= 0 AND tx < gw AND ty >= 0 AND ty < gh

    IF ueber AND MOUSEWHEEL() <> 0 THEN
        zoom = MAX(1, MIN(32, zoom + SGN(MOUSEWHEEL())))
    END IF
    IF ueber AND MOUSE_HIT(1) THEN
        schiebt = TRUE : schiebX = mx : schiebY = my
    END IF
    IF schiebt THEN
        IF MOUSEBUTTON(1) THEN
            panX = panX + (mx - schiebX)
            panY = panY + (my - schiebY)
            schiebX = mx : schiebY = my
        ELSE
            schiebt = FALSE
        END IF
    END IF

    ' -------------------------------------------------------- Palette
    DIM px2 AS INTEGER : px2 = GUI_CANVAS_X(palette)
    DIM py2 AS INTEGER : py2 = GUI_CANVAS_Y(palette)
    IF MOUSE_HIT(0) AND NOT sperre THEN
        ' Nicht `pi` nennen -- das ist die eingebaute Kreiszahl, und die
        ' Kollision meldet sich erst zur LAUFZEIT, nicht beim Uebersetzen.
        DIM pSp AS INTEGER : pSp = (mx - px2) \ 34
        DIM pZe AS INTEGER : pZe = (my - py2) \ 34
        IF mx >= px2 AND my >= py2 AND pSp < 8 AND pZe < 2 THEN
            farbe = pal[pZe * 8 + pSp]
            GUI_SET_PICKED_COLOR(cp, farbe)
        END IF
    END IF

    ' ------------------------------------------------------- Werkzeuge
    IF drauf AND MOUSE_HIT(0) THEN
        zieht = TRUE
        ziehWz = werkzeug
        ankerX = tx : ankerY = ty
        letztX = tx : letztY = ty
        SELECT CASE werkzeug
            CASE WZ_STIFT
                schrittBeginn() : punkt(tx, ty, farbe, FALSE)
            CASE WZ_RADIER
                schrittBeginn() : punkt(tx, ty, 0, TRUE)
            CASE WZ_SPRUEH
                schrittBeginn()
            CASE WZ_FUELL
                schrittBeginn()
                fluten(tx, ty, farbe)
                schrittEnde()
                zieht = FALSE
            CASE WZ_LINIE, WZ_RECHT, WZ_ELLIPSE
                schrittBeginn()
            CASE WZ_PIPETTE
                IF GETALPHA(ebene[aktBild, aktEb], tx, ty) > 0 THEN
                    farbe = GETPIXEL(ebene[aktBild, aktEb], tx, ty)
                    GUI_SET_PICKED_COLOR(cp, farbe)
                END IF
                zieht = FALSE
            CASE WZ_AUSWAHL
                ' Die Maske entsteht erst beim LOSLASSEN. Waehrend des Zugs
                ' ist nur ein Gummiband zu sehen -- sie bei jedem Bild neu
                ' zu bauen waere bei 128x128 sechzehntausend Schritte, und
                ' zu sehen gaebe es davon nichts.
                lasN = 0
            CASE WZ_LASSO
                lasN = 0
                lassoPunkt(tx, ty)
            CASE WZ_ZAUBER
                zauberMaske(tx, ty)
                zieht = FALSE
            CASE WZ_VERSCHIEB
                schrittBeginn()
                abheben()
        END SELECT
    END IF

    IF zieht AND MOUSEBUTTON(0) THEN
        SELECT CASE ziehWz
            CASE WZ_STIFT, WZ_RADIER
                ' Ueber die Linie vom letzten Punkt -- bei schneller Maus
                ' liegen zwischen zwei Bildern sonst Luecken im Strich.
                formPunkte(WZ_LINIE, letztX, letztY, tx, ty, FALSE)
                FOR i = 0 TO pN - 1
                    punkt(pX[i], pY[i], farbe, ziehWz = WZ_RADIER)
                NEXT
                letztX = tx : letztY = ty
            CASE WZ_SPRUEH
                FOR i = 0 TO 6
                    DIM sx2 AS INTEGER : sx2 = tx + RND(7) - 3
                    DIM sy2 AS INTEGER : sy2 = ty + RND(7) - 3
                    IF RND(100) < 40 THEN punkt(sx2, sy2, farbe, FALSE)
                NEXT
            CASE WZ_LASSO
                lassoPunkt(tx, ty)
            CASE WZ_VERSCHIEB
                verX = tx - ankerX : verY = ty - ankerY
        END SELECT
    END IF

    IF zieht AND NOT MOUSEBUTTON(0) THEN
        zieht = FALSE
        SELECT CASE ziehWz
            CASE WZ_STIFT, WZ_RADIER, WZ_SPRUEH
                schrittEnde()
            CASE WZ_LINIE, WZ_RECHT, WZ_ELLIPSE
                formPunkte(ziehWz, ankerX, ankerY, _
                           MAX(0, MIN(gw - 1, tx)), MAX(0, MIN(gh - 1, ty)), _
                           GUI_CHECKED(cbGefuellt))
                FOR i = 0 TO pN - 1
                    punkt(pX[i], pY[i], farbe, FALSE)
                NEXT
                schrittEnde()
            CASE WZ_AUSWAHL
                IF tx = ankerX AND ty = ankerY THEN
                    ' Ein Klick ohne Zug hebt die Auswahl auf. Ohne das
                    ' bliebe ein Ein-Punkt-Rahmen stehen, und weil die
                    ' Auswahl das Zeichnen begrenzt, traefe danach kein
                    ' Strich mehr -- ohne dass man saehe, warum.
                    maskeBeginn() : maskeEnde()
                ELSE
                    rechteckMaske(ankerX, ankerY, MAX(0, MIN(gw - 1, tx)), _
                                  MAX(0, MIN(gh - 1, ty)))
                END IF
            CASE WZ_LASSO
                lassoMaske()
            CASE WZ_VERSCHIEB
                absetzen()
                schrittEnde()
        END SELECT
    END IF

    ' ------------------------------------------------------ Zwischenablage
    IF strg AND NOT sperre THEN
        IF (KEYHIT(KEY_C) OR KEYHIT(KEY_X)) AND selAn THEN
            clipB = selB : clipH = selH
            DIM ax2 AS INTEGER
            DIM ay2 AS INTEGER
            ' Kopiert wird der RAHMEN der Maske -- die Ablage ist ein
            ' Rechteck. Was nicht gewaehlt ist, bekommt Deckkraft 0 und
            ' wird beim Einfuegen uebergangen; sonst brachte eine
            ' Lasso-Auswahl die Ecken ihres Rahmens mit.
            FOR ay2 = 0 TO selH - 1
                FOR ax2 = 0 TO selB - 1
                    clipF[ay2 * clipB + ax2] = GETPIXEL(ebene[aktBild, aktEb], selX + ax2, selY + ay2)
                    IF gewaehlt(selX + ax2, selY + ay2) THEN
                        clipA[ay2 * clipB + ax2] = GETALPHA(ebene[aktBild, aktEb], selX + ax2, selY + ay2)
                    ELSE
                        clipA[ay2 * clipB + ax2] = 0
                    END IF
                NEXT
            NEXT
            IF KEYHIT(KEY_X) THEN
                schrittBeginn()
                auswahlLeeren()
                schrittEnde()
            END IF
        END IF
        IF KEYHIT(KEY_D) THEN
            maskeBeginn() : maskeEnde()
            meldung = "Auswahl aufgehoben"
        END IF
        IF KEYHIT(KEY_V) AND clipB > 0 THEN
            schrittBeginn()
            DIM zx AS INTEGER : zx = IIF(selAn, selX, 0)
            DIM zy AS INTEGER : zy = IIF(selAn, selY, 0)
            DIM ax3 AS INTEGER
            DIM ay3 AS INTEGER
            FOR ay3 = 0 TO clipH - 1
                FOR ax3 = 0 TO clipB - 1
                    IF zx + ax3 < gw AND zy + ay3 < gh THEN
                        ' Leere Punkte der Ablage bleiben leer -- ein Ausschnitt
                        ' soll nicht als schwarzer Klotz landen.
                        IF clipA[ay3 * clipB + ax3] > 0 THEN
                            IMAGE_DRAW_RECT(ebene[aktBild, aktEb], zx + ax3, zy + ay3, 1, 1, _
                                            mitAlpha(clipF[ay3 * clipB + ax3], _
                                                     clipA[ay3 * clipB + ax3]))
                        END IF
                    END IF
                NEXT
            NEXT
            schrittEnde()
        END IF
    END IF
    IF KEYHIT(KEY_DELETE) AND selAn AND NOT sperre THEN
        schrittBeginn()
        auswahlLeeren()
        schrittEnde()
    END IF

    ' ============================================================== Bild
    GRADIENTV(0, 0, SW - 1, SH - 1, &H0A0F16, &H161E29)
    ' Ohne die obenauf-Schicht: Kontextmenue und Tooltip kommen ganz zum
    ' Schluss, sonst laegen sie unter der Zeichenflaeche. Der Tooltip
    ' folgt der Maus und ist damit staendig ueber ihr.
    GUI_DRAW(FALSE)

    ' ------------------------------------------------------------ Palette
    FOR i = 0 TO 15
        DIM qx AS INTEGER : qx = px2 + (i MOD 8) * 34
        DIM qy AS INTEGER : qy = py2 + (i \ 8) * 34
        BOX(qx, qy, qx + 30, qy + 30, pal[i])
        IF pal[i] = farbe THEN RECT(qx - 1, qy - 1, qx + 31, qy + 31, &HFFFFFF)
    NEXT

    ' -------------------------------------------------------- Zeichenflaeche
    SCISSOR(cx, cy, cw, ch)
    BOX(cx, cy, cx + cw - 1, cy + ch - 1, &H070A0F)

    ' Kachel-Ansicht: dasselbe Bild acht Mal ringsum. Ein Sprite, das sich
    ' nahtlos wiederholen soll, zeigt seine Naht erst NEBEN ihrer
    ' Wiederholung -- an einem einzelnen Bild ist sie nicht zu sehen.
    IF kacheln THEN
        DIM kx AS INTEGER
        DIM ky AS INTEGER
        FOR ky = -1 TO 1
            FOR kx = -1 TO 1
                IF kx <> 0 OR ky <> 0 THEN
                    DIM rx2 AS INTEGER : rx2 = ox + kx * gw * zoom
                    DIM ry2 AS INTEGER : ry2 = oy + ky * gh * zoom
                    DRAWIMAGEPARTEX(schachbrett, 0, 0, gw, gh, rx2, ry2, gw * zoom, gh * zoom)
                    DIM kk AS INTEGER
                    FOR kk = 0 TO anzEb - 1
                        IF ebSicht[kk] = 1 THEN
                            DRAWIMAGEPARTEX(ebene[aktBild, kk], 0, 0, gw, gh, _
                                            rx2, ry2, gw * zoom, gh * zoom)
                        END IF
                    NEXT
                    ' Gedaempft. Ohne das saehe man neun gleichwertige Bilder
                    ' und wuesste nicht mehr, welches davon man bearbeitet.
                    BOX(rx2, ry2, rx2 + gw * zoom - 1, ry2 + gh * zoom - 1, &H70101820)
                END IF
            NEXT
        NEXT
    END IF

    DRAWIMAGEPARTEX(schachbrett, 0, 0, gw, gh, ox, oy, gw * zoom, gh * zoom)

    ' Zwiebelhaut: das vorige Bild blass darunter.
    IF GUI_CHECKED(cbZwiebel) AND aktBild > 0 THEN
        DIM k6 AS INTEGER
        FOR k6 = 0 TO anzEb - 1
            IF ebSicht[k6] = 1 THEN
                DRAWIMAGEROT(ebene[aktBild - 1, k6], ox + gw * zoom \ 2, oy + gh * zoom \ 2, _
                             0, zoom, RGBA(255, 255, 255, 70))
            END IF
        NEXT
    END IF

    DIM k7 AS INTEGER
    FOR k7 = 0 TO anzEb - 1
        IF ebSicht[k7] = 1 THEN
            DRAWIMAGEPARTEX(ebene[aktBild, k7], 0, 0, gw, gh, ox, oy, gw * zoom, gh * zoom)
        END IF
    NEXT

    ' Raster erst, wenn eine Linie noch etwas trennt.
    IF GUI_CHECKED(cbRaster) AND zoom >= 6 THEN
        DIM g AS INTEGER
        FOR g = 0 TO gw
            LINE(ox + g * zoom, oy, ox + g * zoom, oy + gh * zoom - 1, &H1E2A38)
        NEXT
        FOR g = 0 TO gh
            LINE(ox, oy + g * zoom, ox + gw * zoom - 1, oy + g * zoom, &H1E2A38)
        NEXT
    END IF
    RECT(ox, oy, ox + gw * zoom - 1, oy + gh * zoom - 1, &H33455A)

    ' Vorschau der laufenden Form -- dieselben Punkte, die gleich ins Bild
    ' geschrieben werden.
    IF zieht AND drauf THEN
        IF ziehWz = WZ_LINIE OR ziehWz = WZ_RECHT OR ziehWz = WZ_ELLIPSE THEN
            formPunkte(ziehWz, ankerX, ankerY, tx, ty, GUI_CHECKED(cbGefuellt))
            FOR i = 0 TO pN - 1
                IF pX[i] >= 0 AND pY[i] >= 0 AND pX[i] < gw AND pY[i] < gh THEN
                    BOX(ox + pX[i] * zoom, oy + pY[i] * zoom, _
                        ox + pX[i] * zoom + zoom - 1, oy + pY[i] * zoom + zoom - 1, farbe)
                END IF
            NEXT
        END IF
    END IF

    ' Das Abgehobene, waehrend es gezogen wird. Es steht nicht mehr im Bild
    ' (`abheben` hat es dort geloescht), also ist das hier das Einzige, was
    ' davon zu sehen ist -- und es sitzt schon dort, wo es beim Loslassen
    ' landen wird.
    IF schwebt THEN
        DIM vsY AS INTEGER
        DIM vsX AS INTEGER
        FOR vsY = 0 TO movH - 1
            FOR vsX = 0 TO movB - 1
                DIM vi AS INTEGER : vi = vsY * movB + vsX
                IF movM[vi] = 1 AND movA[vi] > 0 THEN
                    DIM zx3 AS INTEGER : zx3 = movX + vsX + verX
                    DIM zy3 AS INTEGER : zy3 = movY + vsY + verY
                    IF zx3 >= 0 AND zy3 >= 0 AND zx3 < gw AND zy3 < gh THEN
                        BOX(ox + zx3 * zoom, oy + zy3 * zoom, _
                            ox + (zx3 + 1) * zoom - 1, oy + (zy3 + 1) * zoom - 1, _
                            mitAlpha(movF[vi], movA[vi]))
                    END IF
                END IF
            NEXT
        NEXT
    END IF

    ' Die Auswahl. Zeilenweise in LAEUFEN gezeichnet -- je zusammenhaengendem
    ' Stueck ein Rechteck statt eines je Punkt. Punktweise waeren es im
    ' schlimmsten Fall 16384 Aufrufe, und zwar in JEDEM Bild (gemessen 3 ms);
    ' bei einer Auswahl, die meist am Stueck liegt, sind es so ein paar.
    '
    ' Waehrend eines Verschiebens wird sie um denselben Versatz MITgezeichnet:
    ' die Maske selbst wandert erst beim Absetzen (vorher waere sie bei einem
    ' Abbruch nicht mehr zurueckzuholen), zu sehen sein muss sie aber dort,
    ' wo das Abgehobene gerade liegt.
    IF selAn THEN
        DIM avX AS INTEGER : avX = IIF(schwebt, verX, 0)
        DIM avY AS INTEGER : avY = IIF(schwebt, verY, 0)
        DIM azY AS INTEGER
        DIM azX AS INTEGER
        FOR azY = selY TO selY + selH - 1
            DIM azLauf AS INTEGER : azLauf = -1
            FOR azX = selX TO selX + selB
                ' Eine Spalte ueber den Rahmen hinaus schliesst den letzten
                ' Lauf -- sonst braeuchte es hinter der Schleife eine zweite
                ' Fassung derselben drei Zeilen.
                DIM azDrin AS BOOLEAN
                azDrin = azX < selX + selB AND gewaehlt(azX, azY)
                IF azDrin AND azLauf < 0 THEN azLauf = azX
                IF NOT azDrin AND azLauf >= 0 THEN
                    BOX(ox + (azLauf + avX) * zoom, oy + (azY + avY) * zoom, _
                        ox + (azX + avX) * zoom - 1, oy + (azY + avY + 1) * zoom - 1, _
                        &H302BC4E8)
                    azLauf = -1
                END IF
            NEXT
        NEXT
        ' Der Rahmen nur, wenn die Maske wirklich ihr Rechteck ist. Um eine
        ' Freiform gezogen zeigte er einen Bereich, der gar nicht gewaehlt
        ' ist -- die Flaeche sagt dort schon alles.
        IF istRechteck() THEN
            RECT(ox + (selX + avX) * zoom, oy + (selY + avY) * zoom, _
                 ox + (selX + avX + selB) * zoom - 1, _
                 oy + (selY + avY + selH) * zoom - 1, &HE8C44B)
        END IF
    END IF

    ' Was gerade gezogen wird: beim Rechteck das Gummiband, beim Lasso der
    ' Weg. Die Maske entsteht erst beim Loslassen, also ist das hier das
    ' einzige, was waehrenddessen zu sehen ist.
    IF zieht AND ziehWz = WZ_AUSWAHL THEN
        DIM gbX AS INTEGER : gbX = MIN(ankerX, MAX(0, MIN(gw - 1, tx)))
        DIM gbY AS INTEGER : gbY = MIN(ankerY, MAX(0, MIN(gh - 1, ty)))
        DIM gbB AS INTEGER : gbB = ABS(MAX(0, MIN(gw - 1, tx)) - ankerX) + 1
        DIM gbH AS INTEGER : gbH = ABS(MAX(0, MIN(gh - 1, ty)) - ankerY) + 1
        BOX(ox + gbX * zoom, oy + gbY * zoom, _
            ox + (gbX + gbB) * zoom - 1, oy + (gbY + gbH) * zoom - 1, &H502BC4E8)
        RECT(ox + gbX * zoom, oy + gbY * zoom, _
             ox + (gbX + gbB) * zoom - 1, oy + (gbY + gbH) * zoom - 1, &HE8C44B)
    END IF
    IF zieht AND ziehWz = WZ_LASSO AND lasN > 1 THEN
        DIM li AS INTEGER
        DIM h2 AS INTEGER : h2 = zoom \ 2
        FOR li = 0 TO lasN - 2
            LINE(ox + lasX[li] * zoom + h2, oy + lasY[li] * zoom + h2, _
                 ox + lasX[li + 1] * zoom + h2, oy + lasY[li + 1] * zoom + h2, &HE8C44B)
        NEXT
        ' Der Schluss-Strich zum Anfang zurueck. Er gehoert zum Vieleck,
        ' also gehoert er auch ins Bild -- sonst ueberrascht die Auswahl.
        LINE(ox + lasX[lasN - 1] * zoom + h2, oy + lasY[lasN - 1] * zoom + h2, _
             ox + lasX[0] * zoom + h2, oy + lasY[0] * zoom + h2, &H802BC4E8)
    END IF
    IF drauf THEN
        RECT(ox + tx * zoom, oy + ty * zoom, _
             ox + (tx + pinsel) * zoom - 1, oy + (ty + pinsel) * zoom - 1, &HFFFFFF)
    END IF
    SCISSOR_END()

    ' ---------------------------------------------------------- Vorschau
    DIM vx AS INTEGER : vx = GUI_CANVAS_X(vorschau)
    DIM vy AS INTEGER : vy = GUI_CANVAS_Y(vorschau)
    DIM vw AS INTEGER : vw = GUI_CANVAS_W(vorschau)
    DIM vh AS INTEGER : vh = GUI_CANVAS_H(vorschau)
    BOX(vx, vy, vx + vw - 1, vy + vh - 1, &H070A0F)
    DIM vz AS INTEGER : vz = MAX(1, MIN((vw - 8) \ gw, (vh - 8) \ gh))
    DIM vox AS INTEGER : vox = vx + (vw - gw * vz) \ 2
    DIM voy AS INTEGER : voy = vy + (vh - gh * vz) \ 2
    ' Ist ein Bereich gewaehlt, spielt die Vorschau IHN -- mit seinem Tempo.
    ' Das ist der eigentliche Nutzen der Bereiche: man sieht den Lauf, nicht
    ' das ganze Blatt.
    DIM tempo AS FLOAT : tempo = GUI_VALUE(slTempo)
    DIM vb AS INTEGER
    IF aktAnim >= 0 AND aktAnim < anzAnim THEN
        DIM alo AS INTEGER : alo = MIN(anVon[aktAnim], anzBild - 1)
        DIM ahi AS INTEGER : ahi = MIN(anBis[aktAnim], anzBild - 1)
        vb = alo + INT(zeit * anFps[aktAnim]) MOD (ahi - alo + 1)
    ELSE
        vb = INT(zeit * tempo) MOD anzBild
    END IF
    DRAWIMAGEPARTEX(schachbrett, 0, 0, gw, gh, vox, voy, gw * vz, gh * vz)
    DIM k8 AS INTEGER
    FOR k8 = 0 TO anzEb - 1
        IF ebSicht[k8] = 1 THEN
            DRAWIMAGEPARTEX(ebene[vb, k8], 0, 0, gw, gh, vox, voy, gw * vz, gh * vz)
        END IF
    NEXT

    ' -------------------------------------------------------- Statuszeile
    DIM info AS STRING
    info = wzName[werkzeug] + "   " + STR$(gw) + "x" + STR$(gh) + _
           "   Bild " + STR$(aktBild + 1) + "/" + STR$(anzBild) + _
           "   " + ebName[aktEb] + "   Pinsel " + STR$(pinsel) + _
           "   Zoom " + STR$(zoom) + "x   Farbe " + COLOR_HEX$(farbe)
    IF drauf THEN info = info + "   [" + STR$(tx) + ", " + STR$(ty) + "]"
    IF selAn THEN
        ' Bei einer Freiform sagt BxH nichts -- der Rahmen ist gross, die
        ' Auswahl darin klein. Also die Zahl der Punkte.
        IF istRechteck() THEN
            info = info + "   Auswahl " + STR$(selB) + "x" + STR$(selH)
        ELSE
            info = info + "   Auswahl " + STR$(selN) + " Punkte"
        END IF
    END IF
    IF meldung <> "" THEN info = info + "   |   " + meldung
    GUI_SET_TEXT(status, info)


    ' Fenster zum Schluss noch einmal obenauf. Was in die Zeichenflaeche
    ' gemalt wurde, ist erst NACH GUI_DRAW entstanden und laege sonst
    ' darueber -- genau daran war der Kasten "Neues Sprite" unsichtbar: er
    ' ging auf, sperrte die Eingabe und war nicht zu sehen.
    IF neuOffen THEN GUI_DRAW_WINDOW(winNeu)
    IF grOffen THEN GUI_DRAW_WINDOW(winGr)
    IF namOffen THEN GUI_DRAW_WINDOW(winName)
    IF statOffen THEN GUI_DRAW_WINDOW(statDlg)
    GUI_DRAW_TOP()

    FLIP()
WEND
