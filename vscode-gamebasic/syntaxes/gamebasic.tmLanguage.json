{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GameBasic",
  "scopeName": "source.gamebasic",
  "patterns": [
    {
      "include": "#root"
    }
  ],
  "repository": {
    "root": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.gamebasic",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.gamebasic",
          "match": "(?i)\\bREM\\b.*$"
        },
        {
          "name": "string.quoted.double.gamebasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gamebasic",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "constant.numeric.gamebasic",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.gamebasic",
          "match": "(?i)\\b(FALSE|TRUE)\\b"
        },
        {
          "name": "storage.type.gamebasic",
          "match": "(?i)\\b(COROUTINE|FUNCREF|INTEGER|BOOLEAN|STRING|TUPLE|IMAGE|FLOAT|ARRAY|SOUND|FILE|MAP|OF)\\b"
        },
        {
          "name": "keyword.declaration.gamebasic",
          "match": "(?i)\\b(FUNCTION|PROPERTY|OPERATOR|EXTENDS|STATIC|STRUCT|IMPORT|CONST|CLASS|BYREF|ENUM|DIM|SUB|AS)\\b"
        },
        {
          "name": "keyword.control.gamebasic",
          "match": "(?i)\\b(CONTINUE|RESTORE|REPEAT|RETURN|SELECT|ELSEIF|INPUT|BREAK|UNTIL|WHERE|THROW|WHILE|PRINT|CATCH|YIELD|ELIF|READ|THEN|WEND|BNOT|STEP|WITH|CASE|DATA|BXOR|NEXT|ELSE|BAND|AND|NEW|BOR|SHL|END|MOD|TRY|NOT|SHR|FOR|IS|OR|TO|IN|IF)\\b"
        },
        {
          "name": "support.function.dollar.gamebasic",
          "match": "(?i)\\b(REVERSE|REPLACE|READALL|REPEAT|FORMAT|LOWER|UPPER|SPLIT|RIGHT|LTRIM|INKEY|RTRIM|SPACE|PADR|TRIM|TIME|LEFT|JOIN|DATE|PADL|OCT|MID|STR|HEX|BIN|CHR)\\$"
        },
        {
          "name": "support.function.gamebasic",
          "match": "(?i)\\b(AUDIO_SET_NUM_CHANNELS|AUDIO_MUSIC_GET_VOLUME|AUDIO_MUSIC_POSITION|NET_UDP_SET_TIMEOUT|AUDIO_BUSY_CHANNELS|NET_CLOSE_LISTENER|AUDIO_MUSIC_RESUME|RENDERTARGET_BEGIN|ATLAS_DRAW_FLIPPED|AUDIO_NUM_CHANNELS|AUDIO_MUSIC_VOLUME|CURVE_SMOOTHERSTEP|AUDIO_MUSIC_PAUSE|__DICT_FROM_PAIRS|AUDIO_MUSIC_QUEUE|NET_UDP_LAST_FROM|ECS_GET_OR_STRING|RENDERTARGET_DRAW|ECS_GET_OR_FLOAT|AUDIO_GET_VOLUME|RENDERTARGET_NEW|CURVE_SMOOTHSTEP|AUDIO_MUSIC_STOP|AUDIO_MUSIC_LOAD|AUDIO_RESUME_ALL|AUDIO_IS_PLAYING|AUDIO_MUSIC_PLAY|AUDIO_MUSIC_BUSY|DRAWIMAGEFLIPPED|RENDERTARGET_END|NET_TCP_CONNECT|ARRAY_REMOVE_AT|TRIANGLEOUTLINE|NET_SET_TIMEOUT|ECS_GET_OR_BOOL|JOYSTICK_BUTTON|GENTEX_GRADIENT|AUDIO_PAUSE_ALL|SETWINDOWTITLE|SAVESCREENSHOT|ECS_ADD_STRING|SET_FULLSCREEN|NET_TCP_ACCEPT|JOYSTICK_HAT_Y|AUDIO_STOP_ALL|NET_TCP_LISTEN|ECS_GET_STRING|JOYSTICK_COUNT|ECS_GET_OR_INT|CURVE_CATMULL2|JOYSTICK_HAT_X|POLYGONOUTLINE|GENTEX_CHECKED|ECS_NEW_ENTITY|ELLIPSEOUTLINE|ECS_NEW_WORLD|ECS_ADD_FLOAT|CLIPBOARD_GET|FILES_DROPPED|CLIPBOARD_SET|JOYSTICK_AXIS|NET_PEER_ADDR|JOYSTICK_NAME|CURVE_HERMITE|NET_PEER_PORT|QUITREQUESTED|ECS_GET_FLOAT|GENTEX_PERLIN|CURVE_BEZIER2|CURVE_CATMULL|ARRAY_INDEXOF|NET_UDP_CLOSE|DRAWIMAGEPART|AUDIO_VOLUME|LAYER_DEFINE|NET_UDP_OPEN|CURVE_BEZIER|NET_UDP_SEND|ARRAY_INSERT|GENTEX_COLOR|FILE_DROPPED|AUDIO_RESUME|SCREENHEIGHT|ECS_GET_BOOL|TEXT_SPACING|NET_UDP_BIND|NET_UDP_RECV|ECS_ADD_BOOL|SHADER_SET2|TEXT_HEIGHT|DRAWTILEMAP|ECS_ADD_OBJ|AUDIO_NOISE|SHADER_SET3|ECS_DESTROY|SCREENWIDTH|BATCH_FLUSH|MOUSEBUTTON|SHADER_LOAD|LOAD_ASSETS|IMAGEHEIGHT|TEXT_ITALIC|AUDIO_PAUSE|CORO_RESULT|CORO_RESUME|ECS_GET_INT|__COMP_ITER|LAYER_CLEAR|__SET_DEDUP|ECS_ADD_INT|SHADER_SET|COLOR_LERP|ARRAY_PUSH|KEYPRESSED|AUDIO_TONE|AUDIO_PLAY|ECS_QUERY2|BLEND_MODE|ATLAS_DRAW|AUDIO_STOP|ECS_QUERY3|TEXT_WIDTH|FILEEXISTS|ARRAY_FILL|AUDIO_INIT|IMAGEWIDTH|STARTSWITH|BATCH_DRAW|DELETEFILE|ECS_REMOVE|MOUSEWHEEL|CURVE_LERP|ARRAY_COPY|ATLAS_LOAD|CORO_CLOSE|LOADSOUND|NET_CLOSE|ISNUMERIC|ECS_ALIVE|ARRAY_POP|TEXT_SIZE|ARRAY_AVG|ECS_COUNT|MAPREMOVE|STOPSOUND|RANDOMIZE|PLAYSOUND|STOPMUSIC|CLOSEFILE|TEXT_BOLD|ARRAY_MIN|READLINES|PLAYMUSIC|LAYER_END|WRITELINE|ARRAY_SUM|ECS_QUERY|ARRAY_MAX|CORO_SEND|ENDOFFILE|GRADIENTH|AUDIO_PAN|DIREXISTS|CORO_DONE|MAPVALUES|GRADIENTV|RECTROUND|LOADIMAGE|DRAWIMAGE|OPENFILE|ENDSWITH|COLLIDES|READLINE|DIMCOUNT|MAPCLEAR|MAPGETOR|NET_SEND|CONTAINS|MAPITEMS|TRIANGLE|LOADFONT|NET_RECV|FILESIZE|PATHJOIN|BOXROUND|WRITEALL|MAPKEYS|ELLIPSE|CIRCLES|DIMSIZE|POLYGON|MAPSIZE|REPLACE|WAITKEY|ECS_GET|DIRLIST|READALL|SETFONT|RANDINT|REVERSE|ECS_HAS|SHUFFLE|CHOICE|MAPHAS|MAPGET|MILLIS|SPLINE|MOUSEY|SCROLL|RENAME|CIRCLE|MAPPUT|IS_NIL|SETFPS|SCREEN|MOUSEX|TRYVAL|POSTFX|TIMER|CLAMP|PLOTS|RIGHT|SLEEP|WRITE|SPACE|LOWER|INSTR|UPPER|ATAN2|SPLIT|GREEN|FLOOR|DELTA|MKDIR|REMAP|RANGE|ROUND|REDIM|HYPOT|LAYER|LINES|RANDF|BOXES|LINEW|ATAN|TRIM|LERP|ASIN|JOIN|SORT|DATE|ACOS|SIGN|PADL|CEIL|RECT|TEXT|FRAC|FLIP|PADR|TIME|LEFT|LINE|PLOT|BLUE|COS|RGB|TAN|MIN|DEG|ASC|BOX|EXP|VAL|HSV|RAD|INT|RED|MID|CLS|LOG|HEX|LEN|MAX|CHR|ABS|FPS|RND|POW|SQR|STR|ARC|SIN)\\b"
        },
        {
          "name": "constant.language.gamebasic",
          "match": "(?i)\\b(JOY_BUTTON_LSTICK|JOY_BUTTON_RSTICK|JOY_BUTTON_START|JOY_BUTTON_BACK|JOY_DPAD_RIGHT|JOY_DPAD_LEFT|JOY_DPAD_DOWN|JOY_BUTTON_RB|KEY_BACKSPACE|JOY_BUTTON_LB|JOY_BUTTON_B|JOY_BUTTON_X|JOY_BUTTON_A|JOY_BUTTON_Y|JOY_DPAD_UP|KEY_ESCAPE|KEY_RETURN|LIGHTGRAY|KEY_RIGHT|KEY_ENTER|DARKGREEN|KEY_SPACE|KEY_LEFT|KEY_DOWN|DARKBLUE|DARKGRAY|DARKRED|KEY_F11|KEY_F12|KEY_TAB|MAGENTA|KEY_F10|KEY_F4|KEY_F3|KEY_UP|ORANGE|KEY_F6|KEY_F8|YELLOW|KEY_F1|KEY_F7|PURPLE|KEY_F5|KEY_F9|KEY_F2|KEY_V|KEY_H|WHITE|KEY_4|KEY_Z|KEY_Y|KEY_N|KEY_L|KEY_0|KEY_A|KEY_D|KEY_K|KEY_F|KEY_P|GREEN|KEY_9|KEY_M|KEY_8|KEY_1|KEY_I|BROWN|KEY_J|KEY_5|KEY_G|KEY_W|KEY_T|KEY_X|KEY_S|KEY_C|KEY_B|KEY_6|KEY_7|KEY_E|KEY_Q|BLACK|KEY_3|KEY_O|KEY_U|KEY_2|KEY_R|CYAN|GRAY|PINK|BLUE|RED|PI)\\b"
        },
        {
          "name": "keyword.operator.gamebasic",
          "match": "<=|>=|<>|[-+*/\\\\=<>^]"
        }
      ]
    }
  }
}
