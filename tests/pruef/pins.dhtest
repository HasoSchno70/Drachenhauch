=== --check warnt ausserhalb von linux, mit OPTIONAL nicht
' Unter Linux gibt es keine Warnung (eigener Fall unten).
FUNCTION pruefe(datei AS STRING) AS STRING
    DIM p AS INTEGER : p = PROCESS_START("dhrt", "--check", datei)
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM z AS STRING : z = PROCESS_READ$(p)
        IF z = "" THEN
            IF NOT PROCESS_RUNNING(p) THEN leer = leer + 1
            SLEEP(30)
        ELSE
            aus = aus + TRIM$(z)
        END IF
    WEND
    RETURN aus
END FUNCTION
PRINT INSTR(pruefe("mit.dh"), "gibt es nur unter Linux") >= 0
PRINT INSTR(pruefe("optional.dh"), "gibt es nur unter Linux") >= 0
--- system windows
--- datei mit.dh
IMPORT "gpio"
PRINT 1
--- datei optional.dh
IMPORT "gpio" OPTIONAL
PRINT 1
--- erwartet
TRUE
FALSE

