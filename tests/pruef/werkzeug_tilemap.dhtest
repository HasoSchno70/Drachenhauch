    END IF
END SUB
SUB prFall()
    prKlick(3, GUI_GET_X(bObjEbene) + 70, GUI_GET_Y(bObjEbene) + 14)
    prZiehen(10, prKx(16), prKy(16), prKx(48), prKy(48))
    prE(20, 2, 261, 0)
    prE(21, 1, 261, 0)
