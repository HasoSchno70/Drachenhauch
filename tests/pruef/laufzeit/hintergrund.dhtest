' Aus test_hintergrund.py uebertragen (9 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== fehlende datei wird von sqlite angelegt
' Gemessen statt angenommen: SQLite legt eine fehlende Datei einfach an.
IMPORT "db"
DIM a AS INTEGER
a = DB_QUERY_START("neu.db", "SELECT * FROM gibtsnicht")
WHILE NOT DB_QUERY_READY(a)
    SLEEP(1)
WEND
TRY
    PRINT DB_QUERY_RESULT(a)
CATCH e
    PRINT "gefangen"
END TRY
PRINT FILEEXISTS("neu.db")
--- erwartet
gefangen
TRUE

=== prozess im hintergrund
DIM p AS INTEGER
p = SHELL_START("cmd", "/c", "echo hallo")
WHILE NOT SHELL_READY(p)
    SLEEP(1)
WEND
PRINT TRIM$(SHELL_RESULT$(p))
--- system windows
--- erwartet
hallo

=== rueckgabewert nach dem abholen
DIM p AS INTEGER
DIM t AS STRING
p = SHELL_START("cmd", "/c", "exit 7")
WHILE NOT SHELL_READY(p)
    SLEEP(1)
WEND
t = SHELL_RESULT$(p)
PRINT SHELL_CODE()
--- system windows
--- erwartet
7

=== stderr getrennt von stdout
DIM p AS INTEGER
DIM t AS STRING
p = SHELL_START("cmd", "/c", "echo fehler 1>&2")
WHILE NOT SHELL_READY(p)
    SLEEP(1)
WEND
t = SHELL_RESULT$(p)
PRINT "[" + TRIM$(t) + "]"
PRINT INSTR(SHELL_ERR$(), "fehler") >= 0
--- system windows
--- erwartet
[]
TRUE

=== das programm laeuft waehrend der prozess arbeitet
DIM p AS INTEGER
DIM runden AS INTEGER
p = SHELL_START("cmd", "/c", "ping -n 2 127.0.0.1 > nul")
WHILE NOT SHELL_READY(p)
    runden = runden + 1
WEND
PRINT runden > 0
--- system windows
--- erwartet
TRUE

=== unbekanntes programm meldet sich beim abholen
DIM p AS INTEGER
p = SHELL_START("gibt_es_ganz_sicher_nicht_xyz123")
WHILE NOT SHELL_READY(p)
    SLEEP(1)
WEND
TRY
    PRINT SHELL_RESULT$(p)
CATCH e
    PRINT "gefangen"
END TRY
--- erwartet
gefangen

=== abholen ohne ready sagt auch hier was fehlt
DIM p AS INTEGER
p = SHELL_START("cmd", "/c", "ping -n 3 127.0.0.1 > nul")
PRINT SHELL_RESULT$(p)
--- system windows
--- fehler
SHELL_RESULT$: Auftrag 0 ist nicht fertig (oder schon abgeholt) -- erst SHELL_READY(0) abfragen

=== pending zaehlt und cancel raeumt auf
DIM p AS INTEGER
p = SHELL_START("cmd", "/c", "ping -n 3 127.0.0.1 > nul")
PRINT SHELL_PENDING()
SHELL_CANCEL(p)
PRINT SHELL_PENDING()
--- system windows
--- erwartet
1
0

=== blockierendes shell bleibt daneben bestehen
' SHELL aus WP A ist unveraendert -- SHELL_START ist ein Zusatz, kein
PRINT SHELL("cmd", "/c", "exit 4")
--- system windows
--- erwartet
4

=== die abfrage laeuft und liefert dieselben zeilen
' (Bis Stufe 46 in test_hintergrund.py.)
IMPORT "db"
DIM auftrag AS INTEGER
DIM erg AS INTEGER
DIM n AS INTEGER
auftrag = DB_QUERY_START("d.db", "SELECT a FROM zahlen")
WHILE NOT DB_QUERY_READY(auftrag)
    SLEEP(1)
WEND
erg = DB_QUERY_RESULT(auftrag)
WHILE DB_NEXT(erg)
    n = n + 1
WEND
PRINT n
--- vorher
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN("d.db")
DB_EXEC(c, "CREATE TABLE zahlen (a INTEGER, b TEXT)")
DB_BEGIN(c)
DIM i AS INTEGER
FOR i = 0 TO 2000 - 1
    DB_EXEC(c, "INSERT INTO zahlen VALUES (?, ?)", i, "zeile " + STR$(i))
NEXT
DB_COMMIT(c)
DB_CLOSE(c)
--- erwartet
2000

=== das programm kommt waehrenddessen zum zug
' Die Schleife laeuft weiter, waehrend die Abfrage arbeitet -- vorher hielt
' DB_QUERY alles an.
' (Bis Stufe 46 in test_hintergrund.py.)
'
' Die Abfrage zaehlt absichtlich lange (rekursiv bis drei Millionen, hier rund
' 0,3 s). Bis 2026-09-16 las sie 20000 Zeilen -- und auf dem schnellen
' macOS-Runner war sie fertig, bevor die Schleife das erste Mal fragte: runden
' blieb 0, der Fall fiel im main-Lauf nach #176, ohne dass sich etwas geaendert
' hatte.
IMPORT "db"
DIM auftrag AS INTEGER
DIM runden AS INTEGER
auftrag = DB_QUERY_START("d.db", "WITH RECURSIVE r(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM r WHERE x < ?) SELECT COUNT(*) FROM r", 3000000)
WHILE NOT DB_QUERY_READY(auftrag)
    runden = runden + 1
WEND
PRINT runden > 0
PRINT DB_QUERY_PENDING()
DIM r AS DB_RESULT : r = DB_QUERY_RESULT(auftrag)
IF DB_NEXT(r) THEN PRINT DB_GET_INT(r, 0)
--- vorher
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN("d.db")
DB_EXEC(c, "CREATE TABLE leer (a INTEGER)")
DB_CLOSE(c)
--- erwartet
TRUE
1
3000000

=== parameter werden gebunden
' (Bis Stufe 46 in test_hintergrund.py.)
IMPORT "db"
DIM auftrag AS INTEGER
DIM erg AS INTEGER
auftrag = DB_QUERY_START("d.db", "SELECT b FROM zahlen WHERE a = ?", 42)
WHILE NOT DB_QUERY_READY(auftrag)
    SLEEP(1)
WEND
erg = DB_QUERY_RESULT(auftrag)
PRINT DB_NEXT(erg)
PRINT DB_GET_STRING(erg, 0)
--- vorher
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN("d.db")
DB_EXEC(c, "CREATE TABLE zahlen (a INTEGER, b TEXT)")
DB_BEGIN(c)
DIM i AS INTEGER
FOR i = 0 TO 100 - 1
    DB_EXEC(c, "INSERT INTO zahlen VALUES (?, ?)", i, "zeile " + STR$(i))
NEXT
DB_COMMIT(c)
DB_CLOSE(c)
--- erwartet
TRUE
zeile 42

=== mehrere auftraege gleichzeitig
' Die Nummern bleiben gueltig, auch wenn der zweite zuerst abgeholt wird.
' (Bis Stufe 46 in test_hintergrund.py.)
IMPORT "db"
DIM a1 AS INTEGER
DIM a2 AS INTEGER
DIM e AS INTEGER
DIM n AS INTEGER
a1 = DB_QUERY_START("d.db", "SELECT a FROM zahlen WHERE a < 100")
a2 = DB_QUERY_START("d.db", "SELECT a FROM zahlen WHERE a < 10")
PRINT DB_QUERY_PENDING()
WHILE NOT DB_QUERY_READY(a2)
    SLEEP(1)
WEND
e = DB_QUERY_RESULT(a2)
WHILE DB_NEXT(e)
    n = n + 1
WEND
PRINT n
WHILE NOT DB_QUERY_READY(a1)
    SLEEP(1)
WEND
e = DB_QUERY_RESULT(a1)
n = 0
WHILE DB_NEXT(e)
    n = n + 1
WEND
PRINT n
--- vorher
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN("d.db")
DB_EXEC(c, "CREATE TABLE zahlen (a INTEGER, b TEXT)")
DB_BEGIN(c)
DIM i AS INTEGER
FOR i = 0 TO 500 - 1
    DB_EXEC(c, "INSERT INTO zahlen VALUES (?, ?)", i, "zeile " + STR$(i))
NEXT
DB_COMMIT(c)
DB_CLOSE(c)
--- erwartet
2
10
100

=== zweimal abholen sagt was fehlt
' Ueber das zweite Abholen ist die Meldung ohne jede Zeitannahme zu erreichen
' ("ohne READY abholen" war ein Wettlauf, den Linux verlor).
' (Bis Stufe 46 in test_hintergrund.py.)
IMPORT "db"
DIM a AS INTEGER
a = DB_QUERY_START("d.db", "SELECT a FROM zahlen")
WHILE NOT DB_QUERY_READY(a)
    SLEEP(1)
WEND
PRINT DB_QUERY_RESULT(a)
PRINT DB_QUERY_RESULT(a)
--- vorher
IMPORT "db"
DIM c AS DB_CONN : c = DB_OPEN("d.db")
DB_EXEC(c, "CREATE TABLE zahlen (a INTEGER, b TEXT)")
DB_BEGIN(c)
DIM i AS INTEGER
FOR i = 0 TO 10 - 1
    DB_EXEC(c, "INSERT INTO zahlen VALUES (?, ?)", i, "zeile " + STR$(i))
NEXT
DB_COMMIT(c)
DB_CLOSE(c)
--- fehler
erst DB_QUERY_READY

=== kaputtes sql meldet sich beim abholen
