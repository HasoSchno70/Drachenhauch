=== self-felder in einer schleife einer methode
CLASS Konto
    DIM stand AS INTEGER
    DIM zins AS FLOAT
    DIM verlauf AS FLOAT
    SUB jahre(n AS INTEGER)
        DIM j AS INTEGER
        FOR j = 1 TO n
            stand = stand + 10
            Self.verlauf = Self.verlauf + stand * zins
        NEXT
    END SUB
END CLASS
DIM k AS Konto : k = NEW Konto()
k.zins = 0.5
k.jahre(4)
k.jahre(3)
PRINT k.stand; " "; k.verlauf
--- umgebung
DHRT_JIT=aus
--- erwartet
