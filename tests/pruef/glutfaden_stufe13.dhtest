=== export: autor und copyright aus den einstellungen, das muster geht vor
IMPORT "helfer.dh"
IMPORT "pdftext.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM m AS kern.Muster : m = kern.pxsLaden("alle.pxs")
DIM h AS kern.HtmlOptionen : h = NEW kern.HtmlOptionen()
h.paletten = pal
h.autor = "Anna Müller"
h.copyright = "© 2026 Anna"
DIM t AS STRING : t = kern.htmlText$(m, h, "alle")
PRINT "html: "; INSTR(t, "von Anna Müller") >= 0; " "; INSTR(t, "© 2026 Anna") >= 0
DIM o AS kern.PdfOptionen : o = NEW kern.PdfOptionen()
o.paletten = pal
o.autor = "Anna Müller"
o.copyright = "© 2026 Anna"
DIM ab AS ARRAY OF STRING : ab = kern.pdfExportieren(m, "vorgabe.pdf", o)
' Der Leser liefert die Woerter zeilenweise -- fuer Fliesstext zusammenhaengen
DIM s AS ARRAY OF STRING : s = pdfSeiten("vorgabe.pdf")
DIM d AS STRING : d = REPLACE$(s[0], CHR$(10), "")
PRINT "pdf: "; INSTR(d, "von Anna Müller") >= 0; " "; INSTR(d, "© 2026 Anna") >= 0
JSON_SET_STRING(m.metadaten, "author", "Muster-Autor")
JSON_SET_STRING(m.metadaten, "copyright", "(c) Muster")
t = kern.htmlText$(m, h, "alle")
PRINT "html mit eigenem: "; INSTR(t, "von Muster-Autor") >= 0; " "; INSTR(t, "(c) Muster") >= 0; " | vorgabe "; INSTR(t, "Anna") >= 0
ab = kern.pdfExportieren(m, "eigen.pdf", o)
s = pdfSeiten("eigen.pdf")
d = REPLACE$(s[0], CHR$(10), "")
PRINT "pdf mit eigenem: "; INSTR(d, "von Muster-Autor") >= 0; " "; INSTR(d, "(c) Muster") >= 0; " | vorgabe "; INSTR(d, "Anna") >= 0
