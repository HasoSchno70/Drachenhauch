DIM kennung AS STRING : kennung = ARG$(0)
DIM art AS STRING : art = ARG$(1)
SCREEN(500, 320, IIF(art = "nativ", "Haupt-" + kennung, kennung), 1)
DIM haupt AS GUI_WINDOW : haupt = GUI_WINDOW("Haupt", 10, 10, 300, 220)
DIM hk AS GUI_WIDGET : hk = GUI_BUTTON(haupt, "Haupt-Knopf", 20, 40, 120, 30)
DIM hm AS INTEGER : hm = GUI_CONTEXT(haupt)
DIM heintrag AS INTEGER : heintrag = GUI_MENU_ITEM(hm, "Haupt-Eintrag")
DIM d AS GUI_WINDOW : d = GUI_WINDOW(IIF(art = "nativ", kennung, IIF(art = "leiste", "Leiste-" + kennung, "Dialog")), 60, 60, 260, 140)
DIM feld AS GUI_WIDGET : feld = GUI_TEXTINPUT(d, 30, 30, 200, 26)
DIM dm AS INTEGER : dm = GUI_CONTEXT(d)
DIM deintrag AS INTEGER : deintrag = GUI_MENU_ITEM(dm, "Einfuegen")
GUI_CONTEXT_WIDGET(dm, feld)
DIM leiste AS INTEGER
DIM lneu AS INTEGER
IF art = "leiste" THEN
    leiste = GUI_MENU(d, "Datei")
    lneu = GUI_MENU_ITEM(leiste, "Neu")
    PRINT "nativ "; GUI_WINDOW_NATIVE(d, TRUE)
ELSE
    GUI_WINDOW_MODAL(d, TRUE)
    IF art = "nativ" THEN PRINT "nativ "; GUI_WINDOW_NATIVE(d, TRUE) ELSE PRINT "nativ FALSE"
END IF
DIM dauer AS INTEGER : dauer = 8000
DIM t0 AS INTEGER : t0 = MILLIS()
DIM nd AS INTEGER
DIM nh AS INTEGER
DIM nl AS INTEGER
WHILE NOT QUITREQUESTED() AND MILLIS() - t0 < dauer
    GUI_UPDATE()
    IF GUI_CLICKED(deintrag) THEN nd = nd + 1
    IF GUI_CLICKED(heintrag) THEN nh = nh + 1
    IF art = "leiste" THEN
        IF GUI_CLICKED(lneu) THEN nl = nl + 1
    END IF
    CLS(&H202830) : GUI_DRAW() : FLIP()
WEND
PRINT "dialog-eintrag "; nd; " haupt-eintrag "; nh; " leisten-eintrag "; nl
--- system windows
--- erwartet
gelesen TRUE
leiste zu TRUE
