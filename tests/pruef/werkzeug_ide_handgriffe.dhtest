=== druckoptionen: schrift, rand, zeilennummern, auswahl
' Mit den Vorgaben ist es das Listing von vorher (66 Zeilen je Seite); mit
' 12 pt, 30 mm und ohne Nummern passen weniger Zeilen auf eine Seite, und
' "Nur die Auswahl" nimmt die ganzen Zeilen 2 bis 3.
DIM p AS PDF : p = listingPdf(FALSE)
PDF_CLOSE(p)
GUI_SET_VALUE(spDruckGr, 12)
GUI_SET_VALUE(spDruckRand, 30)
GUI_SET_CHECKED(cbDruckNr, FALSE)
druckOptionenLesen()
GUI_TEXTAREA_SELECT(tabFelder[0], 2, 3, 3, 2)
p = listingPdf(TRUE)
PDF_SAVE(p, "auswahl.pdf")
PDF_CLOSE(p)
