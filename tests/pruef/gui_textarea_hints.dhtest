' GUI_TEXTAREA_HINTS: gedaempfter Text hinter dem Ende einer Zeile (die IDE
' zeigt so die Werte im Debugger-Halt). Geprueft am Bild: rechts vom Text der
' Zeile erscheinen helle Punkte, in der Zeile ohne Hinweis nicht; eine
' eingefuegte Zeile darueber nimmt den Hinweis mit.

=== der hinweis steht hinter seiner zeile und wandert mit
IMPORT "gui"
SCREEN(500, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_THEME_PRESET("dark")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 500, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 0, 0, 480, 180)
GUI_SET_TEXT(ta, "a = 1" + CHR$(10) + "b = 2" + CHR$(10) + "c = 3")
FUNCTION punkte(zeile AS INTEGER) AS INTEGER
    DIM f AS INTEGER
    FOR f = 1 TO 2
        GUI_UPDATE() : CLS(BLACK) : GUI_DRAW() : FLIP()
    NEXT
    SAVESCREENSHOT("bild.png")
    DIM b AS IMAGE : b = LOADIMAGE("bild.png")
    DIM erste AS INTEGER
    DIM sicht AS INTEGER
    DIM von AS INTEGER
    DIM laenge AS INTEGER
    (erste, sicht, von, laenge) = GUI_TEXTAREA_VIEW(ta)
    ' Zeilenhoehe aus dem Bild zu raten waere unsicher -- die Lage kommt aus
    ' GUI_TEXTAREA_POS_AT: welche Zeile liegt unter y?
    DIM n AS INTEGER : n = 0
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 2 TO 120
        DIM zz AS INTEGER
        DIM ss AS INTEGER
        (zz, ss) = GUI_TEXTAREA_POS_AT(ta, 12, y)
        IF zz <> zeile THEN CONTINUE
        FOR x = 150 TO 470
            DIM c AS INTEGER : c = GETPIXEL(b, x, y)
            IF ((c SHR 16) BAND 255) + ((c SHR 8) BAND 255) + (c BAND 255) > 300 THEN n = n + 1
        NEXT
    NEXT
    IMAGE_FREE(b)
    DELETEFILE("bild.png")
    RETURN n
END FUNCTION
PRINT "ohne "; punkte(2)
GUI_TEXTAREA_HINTS(ta, [2], ["b = 2 (INTEGER), weit rechts"])
PRINT "zeile 2 "; punkte(2) > 20
PRINT "zeile 1 "; punkte(1)
' Eine Zeile darueber einfuegen: der Hinweis wandert nach Zeile 3.
GUI_TEXTAREA_SELECT(ta, 1, 1, 1, 1)
GUI_TEXTAREA_INSERT(ta, "neu = 0" + CHR$(10))
PRINT "danach zeile 3 "; punkte(3) > 20
PRINT "danach zeile 2 "; punkte(2)
GUI_TEXTAREA_HINTS(ta, [], [])
PRINT "geloescht "; punkte(3)
--- umgebung
DHRT_FRAMES=40
--- erwartet
ohne 0
zeile 2 TRUE
zeile 1 0
danach zeile 3 TRUE
danach zeile 2 0
geloescht 0

