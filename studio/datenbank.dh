' ============================================================
'  Drachenhauch Studio -- Datenbanken im Projekt
' ============================================================
'  Ein Element der Art "datenbank" ist eine SQLite-Datenbank. Ihr Aufbau
'  steht als JSON in <Name>.dhdb und im Speicher in e.schema:
'
'    {"datei": "daten.sqlite",
'     "tabellen": [{"name": "kunden",
'                   "spalten": [{"name": "name", "typ": "text",
'                                "pflicht": true, "eindeutig": false,
'                                "vorgabe": ""}]}]}
'
'  Jede Tabelle hat zusaetzlich die Spalte id INTEGER PRIMARY KEY -- sie
'  steht nicht im Schema, GUI_FORM_LOAD/SAVE brauchen genau sie.
'
'  Die Datei im Projektordner haelt die Entwicklungsdaten: das Studio zeigt
'  und bearbeitet sie, ein Programm, das aus dem Studio startet, arbeitet
'  auf ihr (DH_STUDIO_DATEN). Eine Aenderung am Aufbau gilt sofort fuer
'  diese Datei (dbAusfuehren$). Das gebaute Programm legt seine eigene
'  Datei neben sich an und ergaenzt fehlende Tabellen und Spalten selbst
'  (datenbankCode$). Umbenennen zieht es dort nach: jede Umbenennung steht
'  in "umbenannt" ([{"art": "tabelle"|"spalte", "tabelle", "alt", "neu"}]),
'  und das Programm wendet sie der Reihe nach an, solange es den alten Namen
'  noch gibt und den neuen nicht. Loeschen tut es dort nicht.
'
'  Eindeutig ist immer ein eigener Index (studio_u_<tabelle>_<spalte>):
'  ALTER TABLE ADD COLUMN kann keine UNIQUE-Spalte anlegen.
' ============================================================

CONST DB_INDEX_VOR = "studio_u_"

' Die Arten einer Spalte und wie SQLite sie speichert. Geld steht in Cent
' (19,99 = 1999), Datum als JJJJ-MM-TT, Ja/Nein als 0/1, ein Bild als BLOB
' mit den Bytes der Bilddatei (PNG, JPG, BMP, GIF).
FUNCTION dbTypen() AS ARRAY OF STRING
    RETURN ["text", "ganz", "zahl", "geld", "datum", "wahr", "bild"]
END FUNCTION

FUNCTION dbTypName$(typ AS STRING) AS STRING
    SELECT CASE typ
        CASE "ganz" : RETURN tr$("Ganze Zahl")
        CASE "zahl" : RETURN tr$("Kommazahl")
        CASE "geld" : RETURN tr$("Geld")
        CASE "datum" : RETURN tr$("Datum")
        CASE "wahr" : RETURN tr$("Ja/Nein")
        CASE "bild" : RETURN tr$("Bild")
    END SELECT
    RETURN tr$("Text")
END FUNCTION

' Aus dem angezeigten Namen die Art (fuer die Auswahlspalte).
FUNCTION dbTypAusName$(name AS STRING) AS STRING
    DIM t AS STRING
    FOR EACH t IN dbTypen()
        IF dbTypName$(t) = name OR t = name THEN RETURN t
    NEXT
    RETURN ""
END FUNCTION

FUNCTION dbTypSql$(typ AS STRING) AS STRING
    SELECT CASE typ
        CASE "ganz", "geld", "wahr" : RETURN "INTEGER"
        CASE "zahl" : RETURN "REAL"
        CASE "bild" : RETURN "BLOB"
    END SELECT
    RETURN "TEXT"
END FUNCTION

' --- Schema ---------------------------------------------------------------------
FUNCTION dbSchemaNeu$(name AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = JSON_PARSE("{}")
    JSON_SET_STRING(s, "datei", LOWER$(name) + ".sqlite")
    JSON_SET_JSON(s, "tabellen", JSON_NEW_ARRAY())
    RETURN JSON_STRINGIFY(s)
END FUNCTION

FUNCTION dbSchema(e AS Element) AS JSON_HANDLE
    DIM s AS JSON_HANDLE : s = JSON_PARSE(IIF(e.schema = "", dbSchemaNeu$(e.name), e.schema))
    IF NOT JSON_HAS(s, "tabellen") THEN JSON_SET_JSON(s, "tabellen", JSON_NEW_ARRAY())
    IF NOT JSON_HAS(s, "datei") THEN JSON_SET_STRING(s, "datei", LOWER$(e.name) + ".sqlite")
    RETURN s
END FUNCTION

' Eine Umbenennung fuer das gebaute Programm merken (nur, wenn sich mehr als
' Gross/klein aendert -- SQLite sieht darin denselben Namen).
SUB dbUmbenennungMerken(s AS JSON_HANDLE, art AS STRING, tabelle AS STRING, alt AS STRING, neu AS STRING)
    IF LOWER$(alt) = LOWER$(neu) THEN RETURN
    IF NOT JSON_HAS(s, "umbenannt") THEN JSON_SET_JSON(s, "umbenannt", JSON_NEW_ARRAY())
    DIM o AS JSON_HANDLE : o = JSON_PARSE("{}")
    JSON_SET_STRING(o, "art", art)
    JSON_SET_STRING(o, "tabelle", tabelle)
    JSON_SET_STRING(o, "alt", alt)
    JSON_SET_STRING(o, "neu", neu)
    JSON_APPEND_JSON(s, "umbenannt", o)
END SUB

FUNCTION dbDateiVon$(s AS JSON_HANDLE) AS STRING
    RETURN JSON_GET_STRING(s, "datei")
END FUNCTION

' Die Entwicklungsdatei; leer, solange das Projekt keinen Ordner hat (oder
' der Ordner erst beim Sichern entsteht).
FUNCTION dbPfad$(e AS Element) AS STRING
    IF projOrdner = "" THEN RETURN ""
    IF NOT DIREXISTS(projOrdner) THEN RETURN ""
    RETURN PATHJOIN(projOrdner, dbDateiVon$(dbSchema(e)))
END FUNCTION

FUNCTION dbTabZahl(s AS JSON_HANDLE) AS INTEGER
    RETURN JSON_LEN(s, "tabellen")
END FUNCTION

FUNCTION dbTabName$(s AS JSON_HANDLE, t AS INTEGER) AS STRING
    RETURN JSON_GET_STRING(s, "tabellen." + STR$(t) + ".name")
END FUNCTION

FUNCTION dbTabIndex(s AS JSON_HANDLE, name AS STRING) AS INTEGER
    DIM t AS INTEGER
    FOR t = 0 TO dbTabZahl(s) - 1
        IF LOWER$(dbTabName$(s, t)) = LOWER$(name) THEN RETURN t
    NEXT
    RETURN -1
END FUNCTION

FUNCTION dbTabellenNamen(e AS Element) AS ARRAY OF STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM aus AS ARRAY OF STRING : aus = []
    DIM t AS INTEGER
    FOR t = 0 TO dbTabZahl(s) - 1
        ARRAY_PUSH(aus, dbTabName$(s, t))
    NEXT
    RETURN aus
END FUNCTION

FUNCTION dbSpZahl(s AS JSON_HANDLE, t AS INTEGER) AS INTEGER
    RETURN JSON_LEN(s, "tabellen." + STR$(t) + ".spalten")
END FUNCTION

FUNCTION dbSpPfad$(t AS INTEGER, k AS INTEGER) AS STRING
    RETURN "tabellen." + STR$(t) + ".spalten." + STR$(k)
END FUNCTION

FUNCTION dbSp$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER, feld AS STRING) AS STRING
    DIM p AS STRING : p = dbSpPfad$(t, k) + "." + feld
    IF NOT JSON_HAS(s, p) THEN RETURN IIF(feld = "typ", "text", "")
    RETURN JSON_GET_STRING(s, p)
END FUNCTION

FUNCTION dbSpAn(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER, feld AS STRING) AS BOOLEAN
    DIM p AS STRING : p = dbSpPfad$(t, k) + "." + feld
    IF NOT JSON_HAS(s, p) THEN RETURN FALSE
    RETURN JSON_GET_BOOL(s, p)
END FUNCTION

FUNCTION dbSpIndex(s AS JSON_HANDLE, t AS INTEGER, name AS STRING) AS INTEGER
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        IF LOWER$(dbSp$(s, t, k, "name")) = LOWER$(name) THEN RETURN k
    NEXT
    RETURN -1
END FUNCTION

' Ein Name fuer Tabelle oder Spalte: wie ein Bezeichner, und keiner, den
' SQLite oder das Studio selbst braucht.
FUNCTION dbNameFehler$(name AS STRING, wofuer AS STRING) AS STRING
    IF NOT istBezeichner(name) THEN RETURN trf$("'{0}' ist kein Name: ein Buchstabe vorn, dann Buchstaben, Ziffern und _.", [name])
    DIM kl AS STRING : kl = LOWER$(name)
    IF LEFT$(kl, 7) = "sqlite_" OR LEFT$(kl, 7) = "studio_" THEN RETURN trf$("Namen mit {0} vorn sind vergeben.", [LEFT$(name, 7)])
    IF wofuer = "spalte" AND (kl = "id" OR kl = "rowid") THEN RETURN tr$("Die Spalte id hat jede Tabelle schon.")
    RETURN ""
END FUNCTION

' Eine Meldung der Datenbank so, dass man weiss, was zu tun ist.
FUNCTION dbMeldung$(f AS STRING) AS STRING
    DIM m AS STRING : m = f
    DIM k AS INTEGER : k = INSTR(m, ": ")
    IF k >= 0 AND LEFT$(m, 3) = "DB_" THEN m = MID$(m, k + 2, LEN(m))
    DIM u AS STRING : u = "UNIQUE constraint failed: "
    IF LEFT$(m, LEN(u)) = u THEN RETURN trf$("In {0} gibt es einen Wert doppelt -- die Spalte ist eindeutig.", [MID$(m, LEN(u), LEN(m))])
    RETURN m
END FUNCTION

' --- Werte -------------------------------------------------------------------
FUNCTION dbQ$(name AS STRING) AS STRING
    RETURN CHR$(34) + name + CHR$(34)
END FUNCTION

' "12,34" -> "1234"; "" = kein Geldbetrag.
FUNCTION dbGeldCent$(text AS STRING) AS STRING
    DIM t AS STRING : t = REPLACE$(REPLACE$(TRIM$(text), " ", ""), ".", ",")
    IF NOT REGEX_TEST(t, "^-?[0-9]+(,[0-9]{1,2})?$") THEN RETURN ""
    DIM minus AS BOOLEAN : minus = LEFT$(t, 1) = "-"
    IF minus THEN t = MID$(t, 1, LEN(t))
    DIM k AS INTEGER : k = INSTR(t, ",")
    DIM euro AS STRING : euro = t
    DIM cent AS STRING : cent = "00"
    IF k >= 0 THEN
        euro = LEFT$(t, k)
        cent = LEFT$(MID$(t, k + 1, LEN(t)) + "0", 2)
    END IF
    DIM n AS INTEGER : n = INT(VAL(euro)) * 100 + INT(VAL(cent))
    IF minus THEN n = -n
    RETURN STR$(n)
END FUNCTION

FUNCTION dbGeldText$(cent AS INTEGER) AS STRING
    DIM a AS INTEGER : a = ABS(cent)
    RETURN IIF(cent < 0, "-", "") + STR$(a \ 100) + "," + RIGHT$("0" + STR$(a MOD 100), 2)
END FUNCTION

' "ja"/"nein" (auch englisch, 1/0) -> "1"/"0"; "" = kein Wahrheitswert.
FUNCTION dbWahr$(text AS STRING) AS STRING
    DIM t AS STRING : t = LOWER$(TRIM$(text))
    IF t = "ja" OR t = "yes" OR t = "1" OR t = "true" OR t = "wahr" OR t = LOWER$(tr$("ja")) THEN RETURN "1"
    IF t = "nein" OR t = "no" OR t = "0" OR t = "false" OR t = "falsch" OR t = LOWER$(tr$("nein")) THEN RETURN "0"
    RETURN ""
END FUNCTION

FUNCTION dbIstDatum(text AS STRING) AS BOOLEAN
    IF NOT REGEX_TEST(text, "^[0-9]{4}-[0-9]{2}-[0-9]{2}$") THEN RETURN FALSE
    DIM m AS INTEGER : m = INT(VAL(MID$(text, 5, 2)))
    DIM d AS INTEGER : d = INT(VAL(MID$(text, 8, 2)))
    RETURN m >= 1 AND m <= 12 AND d >= 1 AND d <= 31
END FUNCTION

' Ein Wert, wie man ihn tippt, als SQL-Literal; "" = passt nicht zur Art.
FUNCTION dbLiteral$(typ AS STRING, wert AS STRING) AS STRING
    DIM w AS STRING : w = TRIM$(wert)
    SELECT CASE typ
        CASE "ganz"
            IF REGEX_TEST(w, "^-?[0-9]+$") THEN RETURN STR$(INT(VAL(w)))
            RETURN ""
        CASE "zahl"
            w = REPLACE$(w, ",", ".")
            IF REGEX_TEST(w, "^-?[0-9]+(\.[0-9]+)?$") THEN RETURN w
            RETURN ""
        CASE "geld" : RETURN dbGeldCent$(w)
        CASE "wahr" : RETURN dbWahr$(w)
        CASE "datum"
            IF dbIstDatum(w) THEN RETURN "'" + w + "'"
            RETURN ""
        CASE "bild" : RETURN ""
    END SELECT
    RETURN "'" + REPLACE$(wert, "'", "''") + "'"
END FUNCTION

' Was in DEFAULT steht: die Vorgabe, sonst bei einer Pflichtspalte der
' leere Wert ihrer Art (ADD COLUMN ... NOT NULL braucht einen), sonst nichts.
FUNCTION dbDefault$(typ AS STRING, pflicht AS BOOLEAN, vorgabe AS STRING) AS STRING
    IF vorgabe <> "" THEN RETURN dbLiteral$(typ, vorgabe)
    IF pflicht THEN RETURN IIF(dbTypSql$(typ) = "TEXT", "''", IIF(dbTypSql$(typ) = "BLOB", "X''", "0"))
    RETURN ""
END FUNCTION

' Steht das Feld in der Spalte (auch leer)?
FUNCTION dbSpHat(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER, feld AS STRING) AS BOOLEAN
    RETURN JSON_HAS(s, dbSpPfad$(t, k) + "." + feld)
END FUNCTION

' Aus einer uebernommenen Datei: "sql" = die Art, wie sie dort steht (DATE,
' TIMESTAMP, VARCHAR(20)), "sqlvorgabe" = DEFAULT woertlich (CURRENT_TIMESTAMP,
' auch leer: eine Pflichtspalte ganz ohne Vorgabe). Beides gilt, bis man Art
' bzw. Vorgabe im Studio aendert -- so baut der Abgleich die Tabelle nicht um.
FUNCTION dbSpSqlTyp$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER) AS STRING
    IF dbSpHat(s, t, k, "sql") THEN RETURN dbSp$(s, t, k, "sql")
    RETURN dbTypSql$(dbSp$(s, t, k, "typ"))
END FUNCTION

FUNCTION dbSpDefault$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER) AS STRING
    IF dbSp$(s, t, k, "vorgabe") = "" AND dbSpHat(s, t, k, "sqlvorgabe") THEN RETURN dbSp$(s, t, k, "sqlvorgabe")
    RETURN dbDefault$(dbSp$(s, t, k, "typ"), dbSpAn(s, t, k, "pflicht"), dbSp$(s, t, k, "vorgabe"))
END FUNCTION

' Was das Spalten-Gitter als Vorgabe zeigt.
FUNCTION dbSpVorgabe$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER) AS STRING
    IF dbSp$(s, t, k, "vorgabe") = "" AND dbSpHat(s, t, k, "sqlvorgabe") THEN RETURN dbSp$(s, t, k, "sqlvorgabe")
    RETURN dbSp$(s, t, k, "vorgabe")
END FUNCTION

FUNCTION dbSpalteSql$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER) AS STRING
    DIM z AS STRING : z = dbQ$(dbSp$(s, t, k, "name")) + " " + dbSpSqlTyp$(s, t, k)
    IF dbSpAn(s, t, k, "pflicht") THEN z = z + " NOT NULL"
    DIM d AS STRING : d = dbSpDefault$(s, t, k)
    IF d <> "" THEN z = z + " DEFAULT " + d
    RETURN z + dbFkSql$(s, t, k)
END FUNCTION

' Ein Verweis als Fremdschluessel. "beimLoeschen" sagt, was mit einer Zeile
' geschieht, wenn die Zeile geloescht wird, auf die sie zeigt: "verbieten"
' (das Loeschen scheitert), "loeschen" (sie geht mit, ON DELETE CASCADE),
' "leeren" (der Verweis wird NULL). "" = kein Fremdschluessel, nur die
' Spalte. Fehlt das Feld (ein Aufbau von vor 2026-11-09), bleibt die Datei,
' wie sie ist -- sonst baute der Abgleich jede uebernommene Tabelle um.
FUNCTION dbFkSql$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER) AS STRING
    DIM ziel AS STRING : ziel = dbSp$(s, t, k, "verweis")
    DIM a AS STRING : a = dbSp$(s, t, k, "beimLoeschen")
    IF ziel = "" OR a = "" THEN RETURN ""
    DIM z AS STRING : z = " REFERENCES " + dbQ$(ziel) + "(id)"
    IF a = "loeschen" THEN z = z + " ON DELETE CASCADE"
    IF a = "leeren" THEN z = z + " ON DELETE SET NULL"
    RETURN z
END FUNCTION

' Was der Abgleich an der Datei sehen will: "ziel|aktion", "" = keinen
' Fremdschluessel.
FUNCTION dbFkSoll$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER) AS STRING
    IF dbFkSql$(s, t, k) = "" THEN RETURN ""
    RETURN LOWER$(dbSp$(s, t, k, "verweis")) + "|" + dbSp$(s, t, k, "beimLoeschen")
END FUNCTION

' ON DELETE, wie SQLite es meldet, als Wert von "beimLoeschen".
FUNCTION dbFkAktion$(roh AS STRING) AS STRING
    SELECT CASE UPPER$(TRIM$(roh))
        CASE "CASCADE" : RETURN "loeschen"
        CASE "SET NULL" : RETURN "leeren"
    END SELECT
    RETURN "verbieten"
END FUNCTION

' Was beim Umkopieren in einer Pflichtspalte steht, wo die alte Tabelle NULL
' hat -- auch dann, wenn die Spalte selbst keine Vorgabe hat.
FUNCTION dbSpLeerwert$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER) AS STRING
    DIM d AS STRING : d = dbSpDefault$(s, t, k)
    IF d <> "" THEN RETURN d
    RETURN dbDefault$(dbSp$(s, t, k, "typ"), TRUE, "")
END FUNCTION

' Eine Vorgabe, die ALTER TABLE ADD COLUMN nimmt: ein fester Wert, kein
' CURRENT_TIMESTAMP und kein Ausdruck in Klammern.
FUNCTION dbVorgabeFest(d AS STRING) AS BOOLEAN
    DIM u AS STRING : u = UPPER$(TRIM$(d))
    IF LEFT$(u, 8) = "CURRENT_" THEN RETURN FALSE
    RETURN INSTR(u, "(") < 0
END FUNCTION

' Die Spalte fuer ALTER TABLE ADD COLUMN: dort will SQLite eine feste
' Vorgabe und bei NOT NULL ueberhaupt eine. Weicht das von dbSpalteSql$ ab,
' baut der Abgleich die Tabelle lieber neu auf; das gebaute Programm ergaenzt
' damit eine aeltere Datei.
FUNCTION dbSpalteSqlDazu$(s AS JSON_HANDLE, t AS INTEGER, k AS INTEGER) AS STRING
    DIM z AS STRING : z = dbQ$(dbSp$(s, t, k, "name")) + " " + dbSpSqlTyp$(s, t, k)
    DIM d AS STRING : d = dbSpDefault$(s, t, k)
    IF NOT dbVorgabeFest(d) THEN d = ""
    IF dbSpAn(s, t, k, "pflicht") THEN
        z = z + " NOT NULL"
        IF d = "" THEN d = dbDefault$(dbSp$(s, t, k, "typ"), TRUE, "")
    END IF
    IF d <> "" THEN z = z + " DEFAULT " + d
    ' Ohne Fremdschluessel: ADD COLUMN ... REFERENCES verweigert SQLite bei
    ' eingeschalteten Fremdschluesseln mit einer Vorgabe ungleich NULL. Im
    ' Studio baut der Abgleich die Tabelle dafuer um.
    RETURN z
END FUNCTION

FUNCTION dbTabelleSql$(s AS JSON_HANDLE, t AS INTEGER, name AS STRING) AS STRING
    DIM teile AS ARRAY OF STRING : teile = ["id INTEGER PRIMARY KEY"]
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        ARRAY_PUSH(teile, dbSpalteSql$(s, t, k))
    NEXT
    RETURN "CREATE TABLE IF NOT EXISTS " + dbQ$(name) + " (" + JOIN$(teile, ", ") + ")"
END FUNCTION

FUNCTION dbIndexName$(tabelle AS STRING, spalte AS STRING) AS STRING
    RETURN DB_INDEX_VOR + LOWER$(tabelle) + "_" + LOWER$(spalte)
END FUNCTION

FUNCTION dbIndexSql$(tabelle AS STRING, spalte AS STRING) AS STRING
    RETURN "CREATE UNIQUE INDEX IF NOT EXISTS " + dbQ$(dbIndexName$(tabelle, spalte)) + " ON " + dbQ$(tabelle) + " (" + dbQ$(spalte) + ")"
END FUNCTION

' --- Die Entwicklungsdatei an das Schema angleichen ----------------------------
'  Fehlt eine Tabelle, entsteht sie; fehlt eine Spalte, kommt sie dazu. Hat
'  sich eine Spalte geaendert (Art, Pflicht, Vorgabe), wird die Tabelle neu
'  aufgebaut und ihre Zeilen umkopiert -- SQLite kann eine Spalte nicht
'  aendern. Spalten und Tabellen, die nicht im Schema stehen (vom Programm
'  selbst angelegt), bleiben. Laeuft in der Transaktion des Aufrufers.
FUNCTION dbTabelleDa(db AS DB_CONN, name AS STRING) AS BOOLEAN
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT name FROM sqlite_master WHERE type = 'table' AND lower(name) = lower(?)", name)
    DIM da AS BOOLEAN : da = DB_NEXT(r)
    IF da THEN DB_CLOSE_RESULT(r)
    RETURN da
END FUNCTION

FUNCTION dbSpalteDa(db AS DB_CONN, tabelle AS STRING, spalte AS STRING) AS BOOLEAN
    IF NOT dbTabelleDa(db, tabelle) THEN RETURN FALSE
    DIM r AS DB_RESULT : r = DB_QUERY(db, "PRAGMA table_info(" + dbQ$(tabelle) + ")")
    WHILE DB_NEXT(r)
        IF LOWER$(DB_GET_STRING(r, 1)) = LOWER$(spalte) THEN
            DB_CLOSE_RESULT(r)
            RETURN TRUE
        END IF
    WEND
    RETURN FALSE
END FUNCTION

SUB dbAbgleichenMit(db AS DB_CONN, s AS JSON_HANDLE)
    DIM t AS INTEGER
    FOR t = 0 TO dbTabZahl(s) - 1
        DIM name AS STRING : name = dbTabName$(s, t)
        IF NOT dbTabelleDa(db, name) THEN
            DB_EXEC(db, dbTabelleSql$(s, t, name))
        ELSE
            DIM inamen AS ARRAY OF STRING : inamen = []
            DIM ityp AS ARRAY OF STRING : ityp = []
            DIM inn AS ARRAY OF BOOLEAN : inn = []
            DIM idf AS ARRAY OF STRING : idf = []
            DIM r AS DB_RESULT : r = DB_QUERY(db, "PRAGMA table_info(" + dbQ$(name) + ")")
            WHILE DB_NEXT(r)
                ARRAY_PUSH(inamen, DB_GET_STRING(r, 1))
                ARRAY_PUSH(ityp, UPPER$(DB_GET_STRING(r, 2)))
                ARRAY_PUSH(inn, DB_GET_INT(r, 3) <> 0)
                ARRAY_PUSH(idf, IIF(DB_IS_NULL(r, 4), "", DB_GET_STRING(r, 4)))
            WEND
            ' Die Fremdschluessel der Datei, je Spalte "ziel|aktion".
            DIM fkSp AS ARRAY OF STRING : fkSp = []
            DIM fkIst AS ARRAY OF STRING : fkIst = []
            DIM rf AS DB_RESULT : rf = DB_QUERY(db, "PRAGMA foreign_key_list(" + dbQ$(name) + ")")
            WHILE DB_NEXT(rf)
                ARRAY_PUSH(fkSp, DB_GET_STRING(rf, 3))
                ARRAY_PUSH(fkIst, LOWER$(DB_GET_STRING(rf, 2)) + "|" + dbFkAktion$(DB_GET_STRING(rf, 6)))
            WEND
            DIM neu AS BOOLEAN : neu = FALSE
            DIM fehlt AS ARRAY OF INTEGER : fehlt = []
            DIM k AS INTEGER
            FOR k = 0 TO dbSpZahl(s, t) - 1
                DIM i AS INTEGER : i = dbListenIndex(inamen, dbSp$(s, t, k, "name"))
                IF i < 0 THEN
                    ARRAY_PUSH(fehlt, k)
                    ' Mit Fremdschluessel lieber neu: ADD COLUMN ... REFERENCES
                    ' nimmt SQLite nur unter Bedingungen.
                    IF dbSpalteSqlDazu$(s, t, k) <> dbSpalteSql$(s, t, k) OR dbFkSql$(s, t, k) <> "" THEN neu = TRUE
                ELSEIF ityp[i] <> UPPER$(dbSpSqlTyp$(s, t, k)) OR inn[i] <> dbSpAn(s, t, k, "pflicht") OR idf[i] <> dbSpDefault$(s, t, k) THEN
                    neu = TRUE
                ELSEIF dbSpHat(s, t, k, "beimLoeschen") THEN
                    DIM fi AS INTEGER : fi = dbListenIndex(fkSp, dbSp$(s, t, k, "name"))
                    IF IIF(fi >= 0, fkIst[MAX(0, fi)], "") <> dbFkSoll$(s, t, k) THEN neu = TRUE
                END IF
            NEXT
            IF neu THEN
                dbNeuAufbauen(db, s, t, name, inamen, ityp, inn, idf)
            ELSE
                DIM f AS INTEGER
                FOR EACH f IN fehlt
                    DB_EXEC(db, "ALTER TABLE " + dbQ$(name) + " ADD COLUMN " + dbSpalteSql$(s, t, f))
                NEXT
            END IF
        END IF
        dbIndexeAbgleichen(db, s, t, name)
    NEXT
END SUB

FUNCTION dbListenIndex(liste AS ARRAY OF STRING, name AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(liste) - 1
        IF LOWER$(liste[i]) = LOWER$(name) THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB dbNeuAufbauen(db AS DB_CONN, s AS JSON_HANDLE, t AS INTEGER, name AS STRING, inamen AS ARRAY OF STRING, ityp AS ARRAY OF STRING, inn AS ARRAY OF BOOLEAN, idf AS ARRAY OF STRING)
    DIM teile AS ARRAY OF STRING : teile = ["id INTEGER PRIMARY KEY"]
    DIM ziel AS ARRAY OF STRING : ziel = ["id"]
    DIM quelle AS ARRAY OF STRING : quelle = [IIF(dbListenIndex(inamen, "id") >= 0, "id", "rowid")]
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        ARRAY_PUSH(teile, dbSpalteSql$(s, t, k))
        DIM sn AS STRING : sn = dbSp$(s, t, k, "name")
        DIM i AS INTEGER : i = dbListenIndex(inamen, sn)
        IF i < 0 THEN CONTINUE
        ARRAY_PUSH(ziel, dbQ$(sn))
        ' Eine Pflichtspalte nimmt keine NULL -- dort steht dann ihr Leerwert.
        IF dbSpAn(s, t, k, "pflicht") THEN
            ARRAY_PUSH(quelle, "COALESCE(" + dbQ$(inamen[i]) + ", " + dbSpLeerwert$(s, t, k) + ")")
        ELSE
            ARRAY_PUSH(quelle, dbQ$(inamen[i]))
        END IF
    NEXT
    ' Was das Programm selbst dazugelegt hat, bleibt mit seiner Erklaerung.
    DIM i2 AS INTEGER
    FOR i2 = 0 TO LEN(inamen) - 1
        IF LOWER$(inamen[i2]) = "id" OR dbSpIndex(s, t, inamen[i2]) >= 0 THEN CONTINUE
        DIM z AS STRING : z = dbQ$(inamen[i2]) + " " + ityp[i2]
        IF inn[i2] THEN z = z + " NOT NULL"
        IF idf[i2] <> "" THEN z = z + " DEFAULT " + idf[i2]
        ARRAY_PUSH(teile, z)
        ARRAY_PUSH(ziel, dbQ$(inamen[i2]))
        ARRAY_PUSH(quelle, dbQ$(inamen[i2]))
    NEXT
    DB_EXEC(db, "CREATE TABLE " + dbQ$("studio_neu") + " (" + JOIN$(teile, ", ") + ")")
    DB_EXEC(db, "INSERT INTO " + dbQ$("studio_neu") + " (" + JOIN$(ziel, ", ") + ") SELECT " + JOIN$(quelle, ", ") + " FROM " + dbQ$(name))
    DB_EXEC(db, "DROP TABLE " + dbQ$(name))
    DB_EXEC(db, "ALTER TABLE " + dbQ$("studio_neu") + " RENAME TO " + dbQ$(name))
END SUB

' Eindeutig ist ein eigener Index -- ausser die Datei hat die Spalte schon
' allein eindeutig (UNIQUE in CREATE TABLE, eine uebernommene Datei).
SUB dbIndexeAbgleichen(db AS DB_CONN, s AS JSON_HANDLE, t AS INTEGER, name AS STRING)
    DIM fremd AS ARRAY OF STRING : fremd = dbEindeutigeSpalten(db, name, FALSE)
    DIM soll AS ARRAY OF STRING : soll = []
    DIM brauchen AS ARRAY OF BOOLEAN : brauchen = []
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        ARRAY_PUSH(brauchen, dbSpAn(s, t, k, "eindeutig") AND dbListenIndex(fremd, dbSp$(s, t, k, "name")) < 0)
        IF brauchen[k] THEN ARRAY_PUSH(soll, dbIndexName$(name, dbSp$(s, t, k, "name")))
    NEXT
    DIM ist AS ARRAY OF STRING : ist = []
    DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT name FROM sqlite_master WHERE type = 'index' AND lower(tbl_name) = lower(?)", name)
    WHILE DB_NEXT(r)
        DIM n AS STRING : n = DB_GET_STRING(r, 0)
        IF LEFT$(n, LEN(DB_INDEX_VOR)) = DB_INDEX_VOR THEN ARRAY_PUSH(ist, n)
    WEND
    DIM n2 AS STRING
    FOR EACH n2 IN ist
        IF dbListenIndex(soll, n2) < 0 THEN DB_EXEC(db, "DROP INDEX " + dbQ$(n2))
    NEXT
    FOR k = 0 TO dbSpZahl(s, t) - 1
        IF brauchen[k] THEN DB_EXEC(db, dbIndexSql$(name, dbSp$(s, t, k, "name")))
    NEXT
END SUB

' Ein neues Schema samt einigen Befehlen davor (umbenennen, loeschen) in EINER
' Transaktion auf die Entwicklungsdatei. Geht etwas schief, bleibt alles, wie
' es war -- die Datei UND das Schema. Liefert "" oder die Meldung.
FUNCTION dbAusfuehren$(e AS Element, neu AS STRING, vorher AS ARRAY OF STRING) AS STRING
    DIM p AS STRING : p = dbPfad$(e)
    IF p = "" THEN
        e.schema = neu
        e.geaendert = TRUE
        RETURN ""
    END IF
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(p)
    CATCH ofehler
        RETURN dbMeldung$(ofehler)
    END TRY
    DIM fehler AS STRING : fehler = ""
    ' Fremdschluessel aus, solange der Aufbau sich aendert (dhrt baut SQLite
    ' mit SQLITE_DEFAULT_FOREIGN_KEYS, sie sind sonst an): der Umbau einer
    ' Tabelle loescht sie mit DROP TABLE -- ein ON DELETE CASCADE nahm dabei
    ' alle Zeilen der Tabellen mit, die auf sie zeigen, und ein neuer
    ' Fremdschluessel scheiterte an einem Verweis ins Leere. In einer
    ' Transaktion laesst SQLite das nicht mehr umschalten, darum davor.
    DB_EXEC(db, "PRAGMA foreign_keys = OFF")
    TRY
        DB_BEGIN(db)
        DIM sql AS STRING
        FOR EACH sql IN vorher
            DB_EXEC(db, sql)
        NEXT
        dbAbgleichenMit(db, JSON_PARSE(neu))
        DB_COMMIT(db)
    CATCH afehler
        fehler = dbMeldung$(afehler)
        TRY
            DB_ROLLBACK(db)
        CATCH rfehler
        END TRY
    END TRY
    DB_CLOSE(db)
    IF fehler = "" THEN
        e.schema = neu
        e.geaendert = TRUE
    END IF
    RETURN fehler
END FUNCTION

' Die Datei an das gespeicherte Schema angleichen (nach Laden und Sichern).
FUNCTION dbAbgleichen$(e AS Element) AS STRING
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(dbSchema(e)), [])
END FUNCTION

' Steht die Tabelle bzw. Spalte schon in der Entwicklungsdatei? Dann wird sie
' umbenannt statt neu angelegt.
FUNCTION dbInDatei(e AS Element, tabelle AS STRING, spalte AS STRING) AS BOOLEAN
    DIM p AS STRING : p = dbPfad$(e)
    IF p = "" THEN RETURN FALSE
    IF NOT FILEEXISTS(p) THEN RETURN FALSE
    DIM db AS DB_CONN : db = DB_OPEN(p)
    DIM da AS BOOLEAN
    IF spalte = "" THEN da = dbTabelleDa(db, tabelle) ELSE da = dbSpalteDa(db, tabelle, spalte)
    DB_CLOSE(db)
    RETURN da
END FUNCTION

' --- Den Aufbau aendern -----------------------------------------------------------
FUNCTION dbTabelleNeu$(e AS Element, name AS STRING) AS STRING
    DIM f AS STRING : f = dbNameFehler$(name, "tabelle")
    IF f <> "" THEN RETURN f
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    IF dbTabIndex(s, name) >= 0 THEN RETURN trf$("Eine Tabelle {0} gibt es schon.", [name])
    IF dbAbfIndex(s, name) >= 0 THEN RETURN trf$("Den Namen {0} gibt es in {1} schon.", [name, e.name])
    DIM o AS JSON_HANDLE : o = JSON_PARSE("{}")
    JSON_SET_STRING(o, "name", name)
    JSON_SET_JSON(o, "spalten", JSON_NEW_ARRAY())
    JSON_APPEND_JSON(s, "tabellen", o)
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), [])
END FUNCTION

FUNCTION dbTabelleUmbenennen$(e AS Element, alt AS STRING, neu AS STRING) AS STRING
    IF alt = neu THEN RETURN ""
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, alt)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [alt])
    DIM f AS STRING : f = dbNameFehler$(neu, "tabelle")
    IF f <> "" THEN RETURN f
    DIM t2 AS INTEGER : t2 = dbTabIndex(s, neu)
    IF t2 >= 0 AND t2 <> t THEN RETURN trf$("Eine Tabelle {0} gibt es schon.", [neu])
    IF dbAbfIndex(s, neu) >= 0 THEN RETURN trf$("Den Namen {0} gibt es in {1} schon.", [neu, e.name])
    JSON_SET_STRING(s, "tabellen." + STR$(t) + ".name", neu)
    dbUmbenennungMerken(s, "tabelle", alt, alt, neu)
    DIM vorher AS ARRAY OF STRING : vorher = []
    IF dbInDatei(e, alt, "") AND LOWER$(alt) <> LOWER$(neu) THEN ARRAY_PUSH(vorher, "ALTER TABLE " + dbQ$(alt) + " RENAME TO " + dbQ$(neu))
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), vorher)
END FUNCTION

FUNCTION dbTabelleLoeschen$(e AS Element, name AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, name)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [name])
    JSON_REMOVE(s, "tabellen." + STR$(t))
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), ["DROP TABLE IF EXISTS " + dbQ$(name)])
END FUNCTION

FUNCTION dbSpalteNeu$(e AS Element, tabelle AS STRING, name AS STRING, typ AS STRING) AS STRING
    DIM f AS STRING : f = dbNameFehler$(name, "spalte")
    IF f <> "" THEN RETURN f
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    IF dbSpIndex(s, t, name) >= 0 THEN RETURN trf$("Eine Spalte {0} gibt es in {1} schon.", [name, tabelle])
    IF dbListenIndex(dbTypen(), typ) < 0 THEN typ = "text"
    DIM o AS JSON_HANDLE : o = JSON_PARSE("{}")
    JSON_SET_STRING(o, "name", name)
    JSON_SET_STRING(o, "typ", typ)
    JSON_SET_BOOL(o, "pflicht", FALSE)
    JSON_SET_BOOL(o, "eindeutig", FALSE)
    JSON_SET_STRING(o, "vorgabe", "")
    JSON_APPEND_JSON(s, "tabellen." + STR$(t) + ".spalten", o)
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), [])
END FUNCTION

FUNCTION dbSpalteUmbenennen$(e AS Element, tabelle AS STRING, alt AS STRING, neu AS STRING) AS STRING
    IF alt = neu THEN RETURN ""
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    DIM k AS INTEGER : k = dbSpIndex(s, t, alt)
    IF k < 0 THEN RETURN trf$("Die Spalte {0} gibt es nicht.", [alt])
    DIM f AS STRING : f = dbNameFehler$(neu, "spalte")
    IF f <> "" THEN RETURN f
    DIM k2 AS INTEGER : k2 = dbSpIndex(s, t, neu)
    IF k2 >= 0 AND k2 <> k THEN RETURN trf$("Eine Spalte {0} gibt es in {1} schon.", [neu, tabelle])
    JSON_SET_STRING(s, dbSpPfad$(t, k) + ".name", neu)
    dbUmbenennungMerken(s, "spalte", tabelle, alt, neu)
    DIM vorher AS ARRAY OF STRING : vorher = []
    IF dbInDatei(e, tabelle, alt) AND LOWER$(alt) <> LOWER$(neu) THEN ARRAY_PUSH(vorher, "ALTER TABLE " + dbQ$(tabelle) + " RENAME COLUMN " + dbQ$(alt) + " TO " + dbQ$(neu))
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), vorher)
END FUNCTION

FUNCTION dbSpalteLoeschen$(e AS Element, tabelle AS STRING, name AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    DIM k AS INTEGER : k = dbSpIndex(s, t, name)
    IF k < 0 THEN RETURN trf$("Die Spalte {0} gibt es nicht.", [name])
    JSON_REMOVE(s, dbSpPfad$(t, k))
    DIM vorher AS ARRAY OF STRING : vorher = ["DROP INDEX IF EXISTS " + dbQ$(dbIndexName$(tabelle, name))]
    IF dbInDatei(e, tabelle, name) THEN ARRAY_PUSH(vorher, "ALTER TABLE " + dbQ$(tabelle) + " DROP COLUMN " + dbQ$(name))
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), vorher)
END FUNCTION

FUNCTION dbSpalteAendern$(e AS Element, tabelle AS STRING, name AS STRING, typ AS STRING, pflicht AS BOOLEAN, eindeutig AS BOOLEAN, vorgabe AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    DIM k AS INTEGER : k = dbSpIndex(s, t, name)
    IF k < 0 THEN RETURN trf$("Die Spalte {0} gibt es nicht.", [name])
    IF dbListenIndex(dbTypen(), typ) < 0 THEN RETURN trf$("'{0}' ist keine Art.", [typ])
    DIM p AS STRING : p = dbSpPfad$(t, k)
    ' Was aus einer uebernommenen Datei woertlich dasteht, bleibt, solange man
    ' es nicht aendert: die Art bis zu einer anderen Art, die Vorgabe, solange
    ' im Gitter derselbe Text steht.
    IF typ <> dbSp$(s, t, k, "typ") AND dbSpHat(s, t, k, "sql") THEN JSON_REMOVE(s, p + ".sql")
    IF dbSpHat(s, t, k, "sqlvorgabe") THEN
        IF vorgabe = dbSp$(s, t, k, "sqlvorgabe") AND dbSp$(s, t, k, "vorgabe") = "" THEN
            vorgabe = ""
        ELSE
            JSON_REMOVE(s, p + ".sqlvorgabe")
        END IF
    END IF
    IF vorgabe <> "" AND dbLiteral$(typ, vorgabe) = "" THEN RETURN trf$("Die Vorgabe '{0}' passt nicht zu {1}.", [vorgabe, dbTypName$(typ)])
    JSON_SET_STRING(s, p + ".typ", typ)
    JSON_SET_BOOL(s, p + ".pflicht", pflicht)
    JSON_SET_BOOL(s, p + ".eindeutig", eindeutig)
    JSON_SET_STRING(s, p + ".vorgabe", vorgabe)
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), [])
END FUNCTION

' Eine andere Datei: die Entwicklungsdaten ziehen mit, wenn es dort noch
' keine gibt.
FUNCTION dbDateiSetzen$(e AS Element, datei AS STRING) AS STRING
    DIM d AS STRING : d = TRIM$(datei)
    IF d = "" THEN RETURN tr$("Die Datei braucht einen Namen.")
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    IF d = dbDateiVon$(s) THEN RETURN ""
    DIM alt AS STRING : alt = dbPfad$(e)
    JSON_SET_STRING(s, "datei", d)
    e.schema = JSON_STRINGIFY(s)
    e.geaendert = TRUE
    IF alt <> "" THEN
        DIM neu AS STRING : neu = PATHJOIN(projOrdner, d)
        IF FILEEXISTS(alt) AND NOT FILEEXISTS(neu) THEN RENAME(alt, neu)
    END IF
    RETURN dbAbgleichen$(e)
END FUNCTION

' --- Eine vorhandene Datei uebernehmen ---------------------------------------------
'  Liest den Aufbau einer SQLite-Datei, die nicht aus dem Studio kommt, in ein
'  Schema: je Tabelle die Spalten mit Art, Pflicht, Vorgabe, Eindeutig (ein
'  UNIQUE oder PRIMARY KEY ueber genau diese Spalte) und Verweis (FOREIGN KEY
'  auf die id einer anderen Tabelle). Was die Arten des Studios nicht genau
'  treffen, steht woertlich daneben ("sql", "sqlvorgabe", siehe dbSpSqlTyp$)
'  -- der Abgleich danach laesst die Datei, wie sie ist. Was das Schema nicht
'  fassen kann (UNIQUE ueber zwei Spalten, eine Tabelle ohne id), bleibt in der
'  Datei und steht in dbUebHinweise.
DIM dbUebHinweise AS ARRAY OF STRING : dbUebHinweise = []

FUNCTION dbArtAusSql$(typ AS STRING) AS STRING
    DIM u AS STRING : u = UPPER$(TRIM$(typ))
    IF INSTR(u, "INT") >= 0 THEN RETURN "ganz"
    IF u = "DATE" THEN RETURN "datum"
    IF INSTR(u, "BOOL") >= 0 THEN RETURN "wahr"
    IF INSTR(u, "REAL") >= 0 OR INSTR(u, "FLOA") >= 0 OR INSTR(u, "DOUB") >= 0 OR INSTR(u, "NUMERIC") >= 0 OR INSTR(u, "DECIMAL") >= 0 THEN RETURN "zahl"
    IF INSTR(u, "BLOB") >= 0 THEN RETURN "bild"
    RETURN "text"
END FUNCTION

' DEFAULT, wie SQLite ihn meldet ('Stück', 1, CURRENT_TIMESTAMP), als Vorgabe
' zum Tippen -- oder "", wenn er sich so nicht schreiben laesst.
FUNCTION dbVorgabeAusSql$(typ AS STRING, roh AS STRING) AS STRING
    DIM v AS STRING : v = roh
    IF LEN(v) >= 2 AND LEFT$(v, 1) = "'" AND RIGHT$(v, 1) = "'" THEN v = REPLACE$(MID$(v, 1, LEN(v) - 2), "''", "'")
    IF v = "" THEN RETURN ""
    IF dbLiteral$(typ, v) = roh THEN RETURN v
    RETURN ""
END FUNCTION

' Spalten, die allein eindeutig sind (UNIQUE, PRIMARY KEY ausser der id).
' Beim Uebernehmen zaehlen auch die Indexe des Studios, und ein UNIQUE ueber
' mehrere Spalten wird ein Hinweis; sonst nur, was nicht vom Studio ist.
FUNCTION dbEindeutigeSpalten(db AS DB_CONN, tabelle AS STRING, uebernehmen AS BOOLEAN) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM namen AS ARRAY OF STRING : namen = []
    DIM r AS DB_RESULT : r = DB_QUERY(db, "PRAGMA index_list(" + dbQ$(tabelle) + ")")
    WHILE DB_NEXT(r)
        DIM iname AS STRING : iname = DB_GET_STRING(r, 1)
        IF NOT uebernehmen AND LEFT$(iname, LEN(DB_INDEX_VOR)) = DB_INDEX_VOR THEN CONTINUE
        IF DB_GET_INT(r, 2) <> 0 AND DB_GET_INT(r, 4) = 0 THEN ARRAY_PUSH(namen, iname)
    WEND
    DIM n AS STRING
    FOR EACH n IN namen
        DIM sp AS ARRAY OF STRING : sp = []
        DIM ri AS DB_RESULT : ri = DB_QUERY(db, "PRAGMA index_info(" + dbQ$(n) + ")")
        WHILE DB_NEXT(ri)
            ARRAY_PUSH(sp, IIF(DB_IS_NULL(ri, 2), "", DB_GET_STRING(ri, 2)))
        WEND
        IF LEN(sp) = 1 THEN
            ARRAY_PUSH(aus, sp[0])
        ELSEIF uebernehmen THEN
            ARRAY_PUSH(dbUebHinweise, trf$("{0}: eindeutig über ({1}) bleibt in der Datei -- das Studio kennt nur eindeutige Einzelspalten.", [tabelle, JOIN$(sp, ", ")]))
        END IF
    NEXT
    RETURN aus
END FUNCTION

' Das Schema aus der Datei (JSON-Text; "" und die Meldung in dbUebHinweise[0],
' wenn sie sich nicht lesen laesst). datei = wie das Schema sie nennt.
FUNCTION dbSchemaAusDatei$(pfad AS STRING, datei AS STRING) AS STRING
    dbUebHinweise = []
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(pfad)
    CATCH ofehler
        dbUebHinweise = [dbMeldung$(ofehler)]
        RETURN ""
    END TRY
    DIM s AS JSON_HANDLE : s = JSON_PARSE(dbSchemaNeu$("x"))
    JSON_SET_STRING(s, "datei", datei)
    DIM tabellen AS ARRAY OF STRING : tabellen = []
    DIM tn AS STRING
    TRY
        DIM rt AS DB_RESULT : rt = DB_QUERY(db, "SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY rowid")
        WHILE DB_NEXT(rt)
            tn = DB_GET_STRING(rt, 0)
            IF LEFT$(LOWER$(tn), 7) = "sqlite_" THEN CONTINUE
            DIM tf AS STRING : tf = dbNameFehler$(tn, "tabelle")
            IF tf <> "" THEN
                ARRAY_PUSH(dbUebHinweise, trf$("Tabelle {0} bleibt in der Datei, aber nicht im Aufbau: {1}", [tn, tf]))
                CONTINUE
            END IF
            ARRAY_PUSH(tabellen, tn)
        WEND
        FOR EACH tn IN tabellen
            DIM o AS JSON_HANDLE : o = JSON_PARSE("{}")
            JSON_SET_STRING(o, "name", tn)
            JSON_SET_JSON(o, "spalten", JSON_NEW_ARRAY())
            DIM eindeutig AS ARRAY OF STRING : eindeutig = dbEindeutigeSpalten(db, tn, TRUE)
            DIM fkVon AS ARRAY OF STRING : fkVon = []
            DIM fkNach AS ARRAY OF STRING : fkNach = []
            DIM fkAkt AS ARRAY OF STRING : fkAkt = []
            DIM rf AS DB_RESULT : rf = DB_QUERY(db, "PRAGMA foreign_key_list(" + dbQ$(tn) + ")")
            WHILE DB_NEXT(rf)
                DIM ziel AS STRING : ziel = DB_GET_STRING(rf, 2)
                DIM zu AS STRING : zu = IIF(DB_IS_NULL(rf, 4), "id", DB_GET_STRING(rf, 4))
                IF LOWER$(zu) = "id" AND dbListenIndex(tabellen, ziel) >= 0 THEN
                    ARRAY_PUSH(fkVon, DB_GET_STRING(rf, 3))
                    ARRAY_PUSH(fkNach, tabellen[dbListenIndex(tabellen, ziel)])
                    ARRAY_PUSH(fkAkt, dbFkAktion$(DB_GET_STRING(rf, 6)))
                END IF
            WEND
            DIM hatId AS BOOLEAN : hatId = FALSE
            DIM rs AS DB_RESULT : rs = DB_QUERY(db, "PRAGMA table_info(" + dbQ$(tn) + ")")
            WHILE DB_NEXT(rs)
                DIM sn AS STRING : sn = DB_GET_STRING(rs, 1)
                DIM roh AS STRING : roh = IIF(DB_IS_NULL(rs, 2), "", DB_GET_STRING(rs, 2))
                IF LOWER$(sn) = "id" THEN
                    hatId = DB_GET_INT(rs, 5) = 1 AND UPPER$(roh) = "INTEGER"
                    CONTINUE
                END IF
                DIM sf AS STRING : sf = dbNameFehler$(sn, "spalte")
                IF sf <> "" THEN
                    ARRAY_PUSH(dbUebHinweise, trf$("Spalte {0}.{1} bleibt in der Datei, aber nicht im Aufbau: {2}", [tn, sn, sf]))
                    CONTINUE
                END IF
                DIM typ AS STRING : typ = dbArtAusSql$(roh)
                DIM pflicht AS BOOLEAN : pflicht = DB_GET_INT(rs, 3) <> 0
                DIM sp AS JSON_HANDLE : sp = JSON_PARSE("{}")
                JSON_SET_STRING(sp, "name", sn)
                JSON_SET_STRING(sp, "typ", typ)
                JSON_SET_BOOL(sp, "pflicht", pflicht)
                JSON_SET_BOOL(sp, "eindeutig", dbListenIndex(eindeutig, sn) >= 0)
                DIM vorgabe AS STRING : vorgabe = ""
                DIM dflt AS STRING : dflt = IIF(DB_IS_NULL(rs, 4), "", DB_GET_STRING(rs, 4))
                IF dflt <> "" THEN vorgabe = dbVorgabeAusSql$(typ, dflt)
                JSON_SET_STRING(sp, "vorgabe", vorgabe)
                IF UPPER$(roh) <> dbTypSql$(typ) THEN JSON_SET_STRING(sp, "sql", roh)
                ' Was dbDefault$ aus der Vorgabe machte, muss genau DEFAULT der Datei sein.
                IF dbDefault$(typ, pflicht, vorgabe) <> dflt THEN JSON_SET_STRING(sp, "sqlvorgabe", dflt)
                DIM fi AS INTEGER : fi = dbListenIndex(fkVon, sn)
                IF fi >= 0 AND typ = "ganz" THEN
                    JSON_SET_STRING(sp, "verweis", fkNach[fi])
                    JSON_SET_STRING(sp, "beimLoeschen", fkAkt[fi])
                END IF
                JSON_APPEND_JSON(o, "spalten", sp)
            WEND
            IF NOT hatId THEN ARRAY_PUSH(dbUebHinweise, trf$("{0} hat keine Spalte id INTEGER PRIMARY KEY -- das Studio zeigt sie, binden lässt sie sich nicht.", [tn]))
            JSON_APPEND_JSON(s, "tabellen", o)
        NEXT
    CATCH lfehler
        dbUebHinweise = [dbMeldung$(lfehler)]
        DB_CLOSE(db)
        RETURN ""
    END TRY
    DB_CLOSE(db)
    RETURN JSON_STRINGIFY(s)
END FUNCTION

' --- Daten ------------------------------------------------------------------------
'  Die Zeilen einer Tabelle zum Anzeigen: je Zeile die id und je Spalte des
'  Schemas der Text, wie man ihn tippt (Geld 12,34, Ja/Nein, Kommazahl mit
'  Komma). NULL ist leer.
DIM dbIds AS ARRAY OF INTEGER : dbIds = []
DIM dbZellen AS ARRAY OF STRING : dbZellen = []
DIM dbGesamt AS INTEGER : dbGesamt = 0
DIM dbNeueId AS INTEGER : dbNeueId = 0

FUNCTION dbAnzeige$(typ AS STRING, r AS DB_RESULT, i AS INTEGER) AS STRING
    IF DB_IS_NULL(r, i) THEN RETURN ""
    SELECT CASE typ
        CASE "geld" : RETURN dbGeldText$(DB_GET_INT(r, i))
        CASE "wahr" : RETURN IIF(DB_GET_INT(r, i) <> 0, tr$("ja"), tr$("nein"))
        CASE "bild"
            ' Ein Bild als Zeile Text: seine Groesse (leer = keins).
            DIM bn AS INTEGER : bn = BUFFER_LEN(DB_GET_BUFFER(r, i))
            IF bn = 0 THEN RETURN ""
            RETURN trf$("Bild ({0} KB)", [STR$((bn + 1023) \ 1024)])
        CASE "zahl"
            ' 1250.0 steht als 1250 da -- die Null hinter dem Komma sagt nichts.
            DIM z AS STRING : z = DB_GET_STRING(r, i)
            IF RIGHT$(z, 2) = ".0" THEN z = LEFT$(z, LEN(z) - 2)
            RETURN REPLACE$(z, ".", ",")
    END SELECT
    RETURN DB_GET_STRING(r, i)
END FUNCTION

FUNCTION dbZeilenLesen$(e AS Element, tabelle AS STRING, grenze AS INTEGER) AS STRING
    dbIds = [] : dbZellen = [] : dbGesamt = 0
    DIM p AS STRING : p = dbPfad$(e)
    IF p = "" THEN RETURN tr$("Erst das Projekt sichern -- dann gibt es eine Datei für die Daten.")
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    DIM spalten AS ARRAY OF STRING : spalten = ["rowid"]
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        ARRAY_PUSH(spalten, dbQ$(dbSp$(s, t, k, "name")))
    NEXT
    DIM fehler AS STRING : fehler = ""
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(p)
        DIM rz AS DB_RESULT : rz = DB_QUERY(db, "SELECT COUNT(*) FROM " + dbQ$(tabelle))
        IF DB_NEXT(rz) THEN dbGesamt = DB_GET_INT(rz, 0)
        DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT " + JOIN$(spalten, ", ") + " FROM " + dbQ$(tabelle) + " ORDER BY rowid LIMIT " + STR$(grenze))
        WHILE DB_NEXT(r)
            ARRAY_PUSH(dbIds, DB_GET_INT(r, 0))
            FOR k = 0 TO dbSpZahl(s, t) - 1
                ARRAY_PUSH(dbZellen, dbAnzeige$(dbSp$(s, t, k, "typ"), r, k + 1))
            NEXT
        WEND
    CATCH lfehler
        fehler = dbMeldung$(lfehler)
    END TRY
    TRY
        DB_CLOSE(db)
    CATCH zfehler
    END TRY
    RETURN fehler
END FUNCTION

' Einen getippten Wert in eine Zelle schreiben. Leer ist NULL -- ausser bei
' einer Pflichtspalte.
FUNCTION dbZelleSetzen$(e AS Element, tabelle AS STRING, id AS INTEGER, spalte AS STRING, text AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    DIM k AS INTEGER : k = dbSpIndex(s, t, spalte)
    IF k < 0 THEN RETURN trf$("Die Spalte {0} gibt es nicht.", [spalte])
    DIM typ AS STRING : typ = dbSp$(s, t, k, "typ")
    DIM p AS STRING : p = dbPfad$(e)
    IF p = "" THEN RETURN tr$("Erst das Projekt sichern -- dann gibt es eine Datei für die Daten.")
    DIM leer AS BOOLEAN : leer = TRIM$(text) = ""
    IF leer AND dbSpAn(s, t, k, "pflicht") THEN RETURN trf$("{0} ist ein Pflichtfeld.", [spalte])
    IF typ = "bild" AND NOT leer THEN RETURN trf$("{0} ist eine Bildspalte -- ein Bild setzt „Bild …“.", [spalte])
    DIM lit AS STRING : lit = ""
    IF NOT leer THEN
        lit = dbLiteral$(typ, text)
        IF lit = "" THEN RETURN trf$("'{0}' passt nicht zu {1} ({2}).", [text, spalte, dbTypName$(typ)])
    END IF
    DIM sql AS STRING : sql = "UPDATE " + dbQ$(tabelle) + " SET " + dbQ$(spalte) + " = ? WHERE rowid = ?"
    DIM fehler AS STRING : fehler = ""
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(p)
        IF leer THEN
            DB_EXEC(db, sql, NIL, id)
        ELSEIF dbTypSql$(typ) = "INTEGER" THEN
            DB_EXEC(db, sql, INT(VAL(lit)), id)
        ELSEIF typ = "zahl" THEN
            DB_EXEC(db, sql, VAL(lit), id)
        ELSEIF typ = "datum" THEN
            DB_EXEC(db, sql, TRIM$(text), id)
        ELSE
            DB_EXEC(db, sql, text, id)
        END IF
    CATCH sfehler
        fehler = dbMeldung$(sfehler)
    END TRY
    TRY
        DB_CLOSE(db)
    CATCH zfehler
    END TRY
    RETURN fehler
END FUNCTION

' Sind das die Bytes eines Bildes, das die Laufzeit lesen kann? Gefragt wird
' am Anfang der Datei -- ohne Fenster, also auch beim Pruefen.
FUNCTION dbIstBild(b AS BUFFER) AS BOOLEAN
    IF BUFFER_LEN(b) < 4 THEN RETURN FALSE
    DIM b0 AS INTEGER : b0 = BUFFER_GET(b, 0)
    DIM b1 AS INTEGER : b1 = BUFFER_GET(b, 1)
    IF b0 = 137 AND b1 = 80 AND BUFFER_GET(b, 2) = 78 AND BUFFER_GET(b, 3) = 71 THEN RETURN TRUE
    IF b0 = 255 AND b1 = 216 THEN RETURN TRUE
    IF b0 = 66 AND b1 = 77 THEN RETURN TRUE
    IF b0 = 71 AND b1 = 73 AND BUFFER_GET(b, 2) = 70 THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' Ein Bild aus einer Datei in eine Zelle einer Bildspalte ("" = leer machen).
FUNCTION dbBildSetzen$(e AS Element, tabelle AS STRING, id AS INTEGER, spalte AS STRING, pfad AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    DIM k AS INTEGER : k = dbSpIndex(s, t, spalte)
    IF k < 0 THEN RETURN trf$("Die Spalte {0} gibt es nicht.", [spalte])
    IF dbSp$(s, t, k, "typ") <> "bild" THEN RETURN trf$("{0} ist keine Bildspalte.", [spalte])
    DIM p AS STRING : p = dbPfad$(e)
    IF p = "" THEN RETURN tr$("Erst das Projekt sichern -- dann gibt es eine Datei für die Daten.")
    DIM b AS BUFFER : b = BUFFER_NEW(0)
    IF pfad <> "" THEN
        IF NOT FILEEXISTS(pfad) THEN RETURN trf$("Die Datei gibt es nicht: {0}", [pfad])
        b = READALL_BYTES(pfad)
        IF NOT dbIstBild(b) THEN RETURN trf$("{0} ist kein Bild (PNG, JPG, BMP oder GIF).", [BASENAME(pfad)])
    ELSEIF dbSpAn(s, t, k, "pflicht") THEN
        RETURN trf$("{0} ist ein Pflichtfeld.", [spalte])
    END IF
    DIM sql AS STRING : sql = "UPDATE " + dbQ$(tabelle) + " SET " + dbQ$(spalte) + " = ? WHERE rowid = ?"
    DIM fehler AS STRING : fehler = ""
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(p)
        IF pfad = "" THEN DB_EXEC(db, sql, NIL, id) ELSE DB_EXEC(db, sql, b, id)
    CATCH bfehler
        fehler = dbMeldung$(bfehler)
    END TRY
    TRY
        DB_CLOSE(db)
    CATCH zfehler
    END TRY
    RETURN fehler
END FUNCTION

' Die Spalten einer Tabelle einer Art: nur Bilder oder alles ausser Bildern
' (ein Feld bindet keinen BLOB, ein Bild-Control nur einen).
FUNCTION dbSpaltenBild(ref AS STRING, bilder AS BOOLEAN) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    IF NOT dbRef(ref) THEN RETURN aus
    DIM s AS JSON_HANDLE : s = dbSchema(dbRefEl)
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, dbRefT) - 1
        IF (dbSp$(s, dbRefT, k, "typ") = "bild") = bilder THEN ARRAY_PUSH(aus, dbSp$(s, dbRefT, k, "name"))
    NEXT
    RETURN aus
END FUNCTION

FUNCTION dbZeileNeu$(e AS Element, tabelle AS STRING) AS STRING
    DIM p AS STRING : p = dbPfad$(e)
    IF p = "" THEN RETURN tr$("Erst das Projekt sichern -- dann gibt es eine Datei für die Daten.")
    DIM fehler AS STRING : fehler = ""
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(p)
        DB_EXEC(db, "INSERT INTO " + dbQ$(tabelle) + " DEFAULT VALUES")
        dbNeueId = DB_LAST_ROWID(db)
    CATCH nfehler
        fehler = dbMeldung$(nfehler)
    END TRY
    TRY
        DB_CLOSE(db)
    CATCH zfehler
    END TRY
    RETURN fehler
END FUNCTION

FUNCTION dbZeileLoeschen$(e AS Element, tabelle AS STRING, id AS INTEGER) AS STRING
    DIM p AS STRING : p = dbPfad$(e)
    IF p = "" THEN RETURN ""
    DIM fehler AS STRING : fehler = ""
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(p)
        DB_EXEC(db, "DELETE FROM " + dbQ$(tabelle) + " WHERE rowid = ?", id)
    CATCH dfehler
        fehler = dbMeldung$(dfehler)
    END TRY
    TRY
        DB_CLOSE(db)
    CATCH zfehler
    END TRY
    RETURN fehler
END FUNCTION

' --- Im erzeugten Programm --------------------------------------------------------
'  _studio/studio_datenbanken.dh: je Datenbank eine globale Verbindung unter
'  ihrem Namen, beim Start geoeffnet; fehlende Tabellen, Spalten und Indexe
'  legt das Programm selbst an. Ohne Datenbank im Projekt: "".
FUNCTION dbText$(roh AS STRING) AS STRING
    RETURN "!" + CHR$(34) + REPLACE$(REPLACE$(roh, "\", "\\"), CHR$(34), "\" + CHR$(34)) + CHR$(34)
END FUNCTION

FUNCTION datenbankCode$() AS STRING
    DIM z AS ARRAY OF STRING : z = []
    DIM e AS Element
    FOR EACH e IN elemente
        IF e.art <> "datenbank" THEN CONTINUE
        IF LEN(z) = 0 THEN
            ARRAY_PUSH(z, "' Erzeugt vom Drachenhauch Studio -- die Datenbanken des Projekts.")
            ARRAY_PUSH(z, "IMPORT " + CHR$(34) + "db" + CHR$(34))
            ARRAY_PUSH(z, "IMPORT " + CHR$(34) + "imgfx" + CHR$(34))
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Aus dem Studio gestartet: die Entwicklungsdaten im Projektordner.")
            ARRAY_PUSH(z, "FUNCTION studioDbPfad$(datei AS STRING) AS STRING")
            ARRAY_PUSH(z, "    DIM o AS STRING : o = GETENV$(" + CHR$(34) + "DH_STUDIO_DATEN" + CHR$(34) + ")")
            ARRAY_PUSH(z, "    IF o = " + CHR$(34) + CHR$(34) + " THEN RETURN datei")
            ARRAY_PUSH(z, "    RETURN PATHJOIN(o, datei)")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "SUB studioDbSpalte(db AS DB_CONN, tabelle AS STRING, spalte AS STRING, def AS STRING)")
            ARRAY_PUSH(z, "    DIM r AS DB_RESULT : r = DB_QUERY(db, " + dbText$("PRAGMA table_info(" + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + ")") + ")")
            ARRAY_PUSH(z, "    WHILE DB_NEXT(r)")
            ARRAY_PUSH(z, "        IF LOWER$(DB_GET_STRING(r, 1)) = LOWER$(spalte) THEN")
            ARRAY_PUSH(z, "            DB_CLOSE_RESULT(r)")
            ARRAY_PUSH(z, "            RETURN")
            ARRAY_PUSH(z, "        END IF")
            ARRAY_PUSH(z, "    WEND")
            ARRAY_PUSH(z, "    DB_EXEC(db, " + dbText$("ALTER TABLE " + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + " ADD COLUMN ") + " + def)")
            ARRAY_PUSH(z, "END SUB")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Eindeutig: ein eigener Index -- ausser die Datei hat die Spalte schon allein")
            ARRAY_PUSH(z, "' eindeutig (UNIQUE in CREATE TABLE).")
            ARRAY_PUSH(z, "SUB studioDbEindeutig(db AS DB_CONN, tabelle AS STRING, spalte AS STRING)")
            ARRAY_PUSH(z, "    DIM namen AS ARRAY OF STRING : namen = []")
            ARRAY_PUSH(z, "    DIM r AS DB_RESULT : r = DB_QUERY(db, " + dbText$("PRAGMA index_list(" + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + ")") + ")")
            ARRAY_PUSH(z, "    WHILE DB_NEXT(r)")
            ARRAY_PUSH(z, "        IF DB_GET_INT(r, 2) <> 0 AND DB_GET_INT(r, 4) = 0 AND LEFT$(DB_GET_STRING(r, 1), " + STR$(LEN(DB_INDEX_VOR)) + ") <> " + dbText$(DB_INDEX_VOR) + " THEN ARRAY_PUSH(namen, DB_GET_STRING(r, 1))")
            ARRAY_PUSH(z, "    WEND")
            ARRAY_PUSH(z, "    DIM n AS STRING")
            ARRAY_PUSH(z, "    FOR EACH n IN namen")
            ARRAY_PUSH(z, "        DIM sp AS ARRAY OF STRING : sp = []")
            ARRAY_PUSH(z, "        r = DB_QUERY(db, " + dbText$("PRAGMA index_info(" + CHR$(34)) + " + n + " + dbText$(CHR$(34) + ")") + ")")
            ARRAY_PUSH(z, "        WHILE DB_NEXT(r)")
            ARRAY_PUSH(z, "            ARRAY_PUSH(sp, IIF(DB_IS_NULL(r, 2), " + dbText$("") + ", LOWER$(DB_GET_STRING(r, 2))))")
            ARRAY_PUSH(z, "        WEND")
            ARRAY_PUSH(z, "        IF LEN(sp) = 1 AND sp[0] = LOWER$(spalte) THEN RETURN")
            ARRAY_PUSH(z, "    NEXT")
            ARRAY_PUSH(z, "    DB_EXEC(db, " + dbText$("CREATE UNIQUE INDEX IF NOT EXISTS " + CHR$(34) + DB_INDEX_VOR) + " + LOWER$(tabelle) + " + dbText$("_") + " + LOWER$(spalte) + " + dbText$(CHR$(34) + " ON " + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + " (" + CHR$(34)) + " + spalte + " + dbText$(CHR$(34) + ")") + ")")
            ARRAY_PUSH(z, "END SUB")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Was im Studio umbenannt wurde, auch in einer aelteren Datei umbenennen --")
            ARRAY_PUSH(z, "' nur, solange es den alten Namen noch gibt und den neuen nicht.")
            ARRAY_PUSH(z, "FUNCTION studioDbTabDa(db AS DB_CONN, name AS STRING) AS BOOLEAN")
            ARRAY_PUSH(z, "    DIM r AS DB_RESULT : r = DB_QUERY(db, " + dbText$("SELECT name FROM sqlite_master WHERE type = 'table' AND lower(name) = lower(?)") + ", name)")
            ARRAY_PUSH(z, "    DIM da AS BOOLEAN : da = DB_NEXT(r)")
            ARRAY_PUSH(z, "    IF da THEN DB_CLOSE_RESULT(r)")
            ARRAY_PUSH(z, "    RETURN da")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "FUNCTION studioDbSpDa(db AS DB_CONN, tabelle AS STRING, spalte AS STRING) AS BOOLEAN")
            ARRAY_PUSH(z, "    IF NOT studioDbTabDa(db, tabelle) THEN RETURN FALSE")
            ARRAY_PUSH(z, "    DIM r AS DB_RESULT : r = DB_QUERY(db, " + dbText$("PRAGMA table_info(" + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + ")") + ")")
            ARRAY_PUSH(z, "    WHILE DB_NEXT(r)")
            ARRAY_PUSH(z, "        IF LOWER$(DB_GET_STRING(r, 1)) = LOWER$(spalte) THEN")
            ARRAY_PUSH(z, "            DB_CLOSE_RESULT(r)")
            ARRAY_PUSH(z, "            RETURN TRUE")
            ARRAY_PUSH(z, "        END IF")
            ARRAY_PUSH(z, "    WEND")
            ARRAY_PUSH(z, "    RETURN FALSE")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "SUB studioDbTabUm(db AS DB_CONN, alt AS STRING, neu AS STRING)")
            ARRAY_PUSH(z, "    IF NOT studioDbTabDa(db, alt) OR studioDbTabDa(db, neu) THEN RETURN")
            ARRAY_PUSH(z, "    DB_EXEC(db, " + dbText$("ALTER TABLE " + CHR$(34)) + " + alt + " + dbText$(CHR$(34) + " RENAME TO " + CHR$(34)) + " + neu + CHR$(34))")
            ARRAY_PUSH(z, "    ' Die Indexe fuer Eindeutig behalten ihren alten Namen; sie entstehen gleich neu.")
            ARRAY_PUSH(z, "    DIM vor AS STRING : vor = " + dbText$(DB_INDEX_VOR) + " + LOWER$(neu) + " + dbText$("_"))
            ARRAY_PUSH(z, "    DIM weg AS ARRAY OF STRING : weg = []")
            ARRAY_PUSH(z, "    DIM r AS DB_RESULT : r = DB_QUERY(db, " + dbText$("SELECT name FROM sqlite_master WHERE type = 'index' AND lower(tbl_name) = lower(?)") + ", neu)")
            ARRAY_PUSH(z, "    WHILE DB_NEXT(r)")
            ARRAY_PUSH(z, "        DIM n AS STRING : n = DB_GET_STRING(r, 0)")
            ARRAY_PUSH(z, "        IF LEFT$(n, " + STR$(LEN(DB_INDEX_VOR)) + ") = " + dbText$(DB_INDEX_VOR) + " AND LEFT$(n, LEN(vor)) <> vor THEN ARRAY_PUSH(weg, n)")
            ARRAY_PUSH(z, "    WEND")
            ARRAY_PUSH(z, "    DIM w AS STRING")
            ARRAY_PUSH(z, "    FOR EACH w IN weg")
            ARRAY_PUSH(z, "        DB_EXEC(db, " + dbText$("DROP INDEX " + CHR$(34)) + " + w + CHR$(34))")
            ARRAY_PUSH(z, "    NEXT")
            ARRAY_PUSH(z, "END SUB")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "SUB studioDbSpUm(db AS DB_CONN, tabelle AS STRING, alt AS STRING, neu AS STRING)")
            ARRAY_PUSH(z, "    IF NOT studioDbSpDa(db, tabelle, alt) OR studioDbSpDa(db, tabelle, neu) THEN RETURN")
            ARRAY_PUSH(z, "    DB_EXEC(db, " + dbText$("DROP INDEX IF EXISTS " + CHR$(34) + DB_INDEX_VOR) + " + LOWER$(tabelle) + " + dbText$("_") + " + LOWER$(alt) + CHR$(34))")
            ARRAY_PUSH(z, "    DB_EXEC(db, " + dbText$("ALTER TABLE " + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + " RENAME COLUMN " + CHR$(34)) + " + alt + " + dbText$(CHR$(34) + " TO " + CHR$(34)) + " + neu + CHR$(34))")
            ARRAY_PUSH(z, "END SUB")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Ein Wert zum Anzeigen: Geld 12,34, Ja/Nein, Kommazahl mit Komma.")
            ARRAY_PUSH(z, "FUNCTION studioDbText$(r AS DB_RESULT, i AS INTEGER, art AS STRING) AS STRING")
            ARRAY_PUSH(z, "    IF DB_IS_NULL(r, i) THEN RETURN " + CHR$(34) + CHR$(34))
            ARRAY_PUSH(z, "    IF art = " + dbText$("geld") + " THEN")
            ARRAY_PUSH(z, "        DIM c AS INTEGER : c = DB_GET_INT(r, i)")
            ARRAY_PUSH(z, "        RETURN IIF(c < 0, " + dbText$("-") + ", " + dbText$("") + ") + STR$(ABS(c) \ 100) + " + dbText$(",") + " + RIGHT$(" + dbText$("0") + " + STR$(ABS(c) MOD 100), 2)")
            ARRAY_PUSH(z, "    END IF")
            ARRAY_PUSH(z, "    IF art = " + dbText$("wahr") + " THEN RETURN IIF(DB_GET_INT(r, i) <> 0, " + dbText$("ja") + ", " + dbText$("nein") + ")")
            ARRAY_PUSH(z, "    IF art = " + dbText$("bild") + " THEN RETURN " + dbText$(""))
            ARRAY_PUSH(z, "    IF art = " + dbText$("zahl") + " THEN")
            ARRAY_PUSH(z, "        DIM t AS STRING : t = DB_GET_STRING(r, i)")
            ARRAY_PUSH(z, "        IF RIGHT$(t, 2) = " + dbText$(".0") + " THEN t = LEFT$(t, LEN(t) - 2)")
            ARRAY_PUSH(z, "        RETURN REPLACE$(t, " + dbText$(".") + ", " + dbText$(",") + ")")
            ARRAY_PUSH(z, "    END IF")
            ARRAY_PUSH(z, "    RETURN DB_GET_STRING(r, i)")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Die Zeilen einer Datenquelle (Tabelle oder Abfrage in Klammern): id zuerst,")
            ARRAY_PUSH(z, "' dann die genannten Spalten (leer = alle ausser id), mit Bedingung, Suche")
            ARRAY_PUSH(z, "' ueber die gezeigten Spalten und Sortierung. Die Namen der Spalten stehen")
            ARRAY_PUSH(z, "' danach in studioQuelleSpalten.")
            ARRAY_PUSH(z, "DIM studioQuelleSpalten AS ARRAY OF STRING : studioQuelleSpalten = []")
            ARRAY_PUSH(z, "FUNCTION studioQuelle(db AS DB_CONN, quelle AS STRING, spalten AS STRING, filter AS STRING, sortieren AS STRING, absteigend AS BOOLEAN, such AS STRING) AS DB_RESULT")
            ARRAY_PUSH(z, "    DIM namen AS ARRAY OF STRING : namen = []")
            ARRAY_PUSH(z, "    DIM hatId AS BOOLEAN : hatId = FALSE")
            ARRAY_PUSH(z, "    DIM r AS DB_RESULT : r = DB_QUERY(db, " + dbText$("SELECT * FROM ") + " + quelle + " + dbText$(" AS studio_q LIMIT 0") + ")")
            ARRAY_PUSH(z, "    DIM i AS INTEGER")
            ARRAY_PUSH(z, "    FOR i = 0 TO DB_COL_COUNT(r) - 1")
            ARRAY_PUSH(z, "        IF LOWER$(DB_COL_NAME(r, i)) = " + dbText$("id") + " THEN hatId = TRUE ELSE ARRAY_PUSH(namen, DB_COL_NAME(r, i))")
            ARRAY_PUSH(z, "    NEXT")
            ARRAY_PUSH(z, "    DIM w AS STRING")
            ARRAY_PUSH(z, "    IF spalten <> " + dbText$("") + " THEN")
            ARRAY_PUSH(z, "        DIM gewaehlt AS ARRAY OF STRING : gewaehlt = []")
            ARRAY_PUSH(z, "        FOR EACH w IN SPLIT(spalten, " + dbText$(";") + ")")
            ARRAY_PUSH(z, "            IF ARRAY_INDEXOF(namen, TRIM$(w)) >= 0 THEN ARRAY_PUSH(gewaehlt, TRIM$(w))")
            ARRAY_PUSH(z, "        NEXT")
            ARRAY_PUSH(z, "        IF LEN(gewaehlt) > 0 THEN namen = gewaehlt")
            ARRAY_PUSH(z, "    END IF")
            ARRAY_PUSH(z, "    studioQuelleSpalten = namen")
            ARRAY_PUSH(z, "    DIM teile AS ARRAY OF STRING : teile = [IIF(hatId, " + dbText$("id") + ", " + dbText$("0 AS id") + ")]")
            ARRAY_PUSH(z, "    FOR EACH w IN namen")
            ARRAY_PUSH(z, "        ARRAY_PUSH(teile, CHR$(34) + w + CHR$(34))")
            ARRAY_PUSH(z, "    NEXT")
            ARRAY_PUSH(z, "    DIM sql AS STRING : sql = " + dbText$("SELECT ") + " + JOIN$(teile, " + dbText$(", ") + ") + " + dbText$(" FROM ") + " + quelle + " + dbText$(" AS studio_q") + "")
            ARRAY_PUSH(z, "    DIM wo AS ARRAY OF STRING : wo = []")
            ARRAY_PUSH(z, "    IF filter <> " + dbText$("") + " THEN ARRAY_PUSH(wo, " + dbText$("(") + " + filter + " + dbText$(")") + ")")
            ARRAY_PUSH(z, "    IF such <> " + dbText$("") + " AND LEN(namen) > 0 THEN")
            ARRAY_PUSH(z, "        DIM oder AS ARRAY OF STRING : oder = []")
            ARRAY_PUSH(z, "        FOR EACH w IN namen")
            ARRAY_PUSH(z, "            ARRAY_PUSH(oder, CHR$(34) + w + CHR$(34) + " + dbText$(" LIKE '%") + " + REPLACE$(such, " + dbText$("'") + ", " + dbText$("''") + ") + " + dbText$("%'") + ")")
            ARRAY_PUSH(z, "        NEXT")
            ARRAY_PUSH(z, "        ARRAY_PUSH(wo, " + dbText$("(") + " + JOIN$(oder, " + dbText$(" OR ") + ") + " + dbText$(")") + ")")
            ARRAY_PUSH(z, "    END IF")
            ARRAY_PUSH(z, "    IF LEN(wo) > 0 THEN sql = sql + " + dbText$(" WHERE ") + " + JOIN$(wo, " + dbText$(" AND ") + ")")
            ARRAY_PUSH(z, "    IF sortieren <> " + dbText$("") + " THEN")
            ARRAY_PUSH(z, "        sql = sql + " + dbText$(" ORDER BY ") + " + CHR$(34) + sortieren + CHR$(34) + IIF(absteigend, " + dbText$(" DESC") + ", " + dbText$("") + ")")
            ARRAY_PUSH(z, "    ELSEIF hatId THEN")
            ARRAY_PUSH(z, "        sql = sql + " + dbText$(" ORDER BY id") + " + IIF(absteigend, " + dbText$(" DESC") + ", " + dbText$("") + ")")
            ARRAY_PUSH(z, "    END IF")
            ARRAY_PUSH(z, "    RETURN DB_QUERY(db, sql)")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Ein Bild aus einer Spalte (-1 = keins oder keins, das sich lesen laesst).")
            ARRAY_PUSH(z, "FUNCTION studioDbBild(r AS DB_RESULT, i AS INTEGER) AS IMAGE")
            ARRAY_PUSH(z, "    IF DB_IS_NULL(r, i) THEN RETURN -1")
            ARRAY_PUSH(z, "    DIM b AS BUFFER : b = DB_GET_BUFFER(r, i)")
            ARRAY_PUSH(z, "    IF BUFFER_LEN(b) = 0 THEN RETURN -1")
            ARRAY_PUSH(z, "    TRY")
            ARRAY_PUSH(z, "        RETURN IMAGE_FROM_BUFFER(b)")
            ARRAY_PUSH(z, "    CATCH studioFehler")
            ARRAY_PUSH(z, "    END TRY")
            ARRAY_PUSH(z, "    RETURN -1")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Ohne gebundenes Feld: gibt es die Zeile, und eine neue anlegen.")
            ARRAY_PUSH(z, "FUNCTION studioDbZeileDa(db AS DB_CONN, tabelle AS STRING, id AS INTEGER) AS BOOLEAN")
            ARRAY_PUSH(z, "    DIM r AS DB_RESULT : r = DB_QUERY(db, " + dbText$("SELECT id FROM " + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + " WHERE id = ?") + ", id)")
            ARRAY_PUSH(z, "    DIM da AS BOOLEAN : da = DB_NEXT(r)")
            ARRAY_PUSH(z, "    IF da THEN DB_CLOSE_RESULT(r)")
            ARRAY_PUSH(z, "    RETURN da")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "FUNCTION studioDbZeileNeu(db AS DB_CONN, tabelle AS STRING) AS INTEGER")
            ARRAY_PUSH(z, "    DB_EXEC(db, " + dbText$("INSERT INTO " + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + " DEFAULT VALUES") + ")")
            ARRAY_PUSH(z, "    RETURN DB_LAST_ROWID(db)")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Das Bild einer Zeile aus einer Bildspalte (-1 = keins).")
            ARRAY_PUSH(z, "FUNCTION studioDbBildLesen(db AS DB_CONN, tabelle AS STRING, spalte AS STRING, id AS INTEGER) AS IMAGE")
            ARRAY_PUSH(z, "    DIM r AS DB_RESULT : r = DB_QUERY(db, " + dbText$("SELECT " + CHR$(34)) + " + spalte + " + dbText$(CHR$(34) + " FROM " + CHR$(34)) + " + tabelle + " + dbText$(CHR$(34) + " WHERE id = ?") + ", id)")
            ARRAY_PUSH(z, "    IF NOT DB_NEXT(r) THEN RETURN -1")
            ARRAY_PUSH(z, "    DIM bild AS IMAGE : bild = studioDbBild(r, 0)")
            ARRAY_PUSH(z, "    DB_CLOSE_RESULT(r)")
            ARRAY_PUSH(z, "    RETURN bild")
            ARRAY_PUSH(z, "END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "' Eine Zeile aus studioQuelle zum Anzeigen (ohne die id vorn).")
            ARRAY_PUSH(z, "FUNCTION studioZeile(r AS DB_RESULT, typen AS STRING) AS ARRAY OF STRING")
            ARRAY_PUSH(z, "    DIM t AS ARRAY OF STRING : t = SPLIT(typen, " + dbText$(";") + ")")
            ARRAY_PUSH(z, "    DIM aus AS ARRAY OF STRING : aus = []")
            ARRAY_PUSH(z, "    DIM i AS INTEGER")
            ARRAY_PUSH(z, "    FOR i = 1 TO DB_COL_COUNT(r) - 1")
            ARRAY_PUSH(z, "        ARRAY_PUSH(aus, studioDbText$(r, i, IIF(i - 1 < LEN(t), t[i - 1], " + dbText$("") + ")))")
            ARRAY_PUSH(z, "    NEXT")
            ARRAY_PUSH(z, "    IF LEN(aus) = 0 THEN ARRAY_PUSH(aus, STR$(DB_GET_INT(r, 0)))")
            ARRAY_PUSH(z, "    RETURN aus")
            ARRAY_PUSH(z, "END FUNCTION")
        END IF
        DIM s AS JSON_HANDLE : s = dbSchema(e)
        ARRAY_PUSH(z, "")
        ARRAY_PUSH(z, "' Datenbank " + e.name)
        ARRAY_PUSH(z, "DIM " + e.name + " AS DB_CONN : " + e.name + " = DB_OPEN(studioDbPfad$(" + dbText$(dbDateiVon$(s)) + "))")
        DIM u AS INTEGER
        IF JSON_HAS(s, "umbenannt") THEN
            FOR u = 0 TO JSON_LEN(s, "umbenannt") - 1
                DIM up AS STRING : up = "umbenannt." + STR$(u)
                DIM ualt AS STRING : ualt = dbText$(JSON_GET_STRING(s, up + ".alt"))
                DIM uneu AS STRING : uneu = dbText$(JSON_GET_STRING(s, up + ".neu"))
                IF JSON_GET_STRING(s, up + ".art") = "tabelle" THEN
                    ARRAY_PUSH(z, "studioDbTabUm(" + e.name + ", " + ualt + ", " + uneu + ")")
                ELSE
                    ARRAY_PUSH(z, "studioDbSpUm(" + e.name + ", " + dbText$(JSON_GET_STRING(s, up + ".tabelle")) + ", " + ualt + ", " + uneu + ")")
                END IF
            NEXT
        END IF
        DIM t AS INTEGER
        FOR t = 0 TO dbTabZahl(s) - 1
            DIM tn AS STRING : tn = dbTabName$(s, t)
            ARRAY_PUSH(z, "DB_EXEC(" + e.name + ", " + dbText$(dbTabelleSql$(s, t, tn)) + ")")
            DIM k AS INTEGER
            FOR k = 0 TO dbSpZahl(s, t) - 1
                ARRAY_PUSH(z, "studioDbSpalte(" + e.name + ", " + dbText$(tn) + ", " + dbText$(dbSp$(s, t, k, "name")) + ", " + dbText$(dbSpalteSqlDazu$(s, t, k)) + ")")
            NEXT
            FOR k = 0 TO dbSpZahl(s, t) - 1
                IF dbSpAn(s, t, k, "eindeutig") THEN ARRAY_PUSH(z, "studioDbEindeutig(" + e.name + ", " + dbText$(tn) + ", " + dbText$(dbSp$(s, t, k, "name")) + ")")
            NEXT
        NEXT
    NEXT
    IF LEN(z) = 0 THEN RETURN ""
    ' Die Abfragen der Datenbanken: Abfrage("name") bzw. Abfrage("Daten.name").
    DIM fall AS ARRAY OF STRING : fall = []
    FOR EACH e IN elemente
        IF e.art <> "datenbank" THEN CONTINUE
        DIM sa AS JSON_HANDLE : sa = dbSchema(e)
        DIM a AS INTEGER
        FOR a = 0 TO dbAbfZahl(sa) - 1
            DIM an AS STRING : an = LOWER$(dbAbfName$(sa, a))
            ARRAY_PUSH(fall, "        CASE " + dbText$(an) + ", " + dbText$(LOWER$(e.name) + "." + an) + " : RETURN DB_QUERY(" + e.name + ", " + dbText$(dbAbfSql$(sa, a)) + ")")
        NEXT
    NEXT
    IF LEN(fall) > 0 THEN
        ARRAY_PUSH(z, "")
        ARRAY_PUSH(z, "' Eine Abfrage der Datenbanken nach ihrem Namen ausfuehren.")
        ARRAY_PUSH(z, "FUNCTION Abfrage(name AS STRING) AS DB_RESULT")
        ARRAY_PUSH(z, "    SELECT CASE LOWER$(name)")
        DIM fz AS STRING
        FOR EACH fz IN fall
            ARRAY_PUSH(z, fz)
        NEXT
        ARRAY_PUSH(z, "    END SELECT")
        ARRAY_PUSH(z, "    THROW " + dbText$("Abfrage: eine Abfrage ") + " + name + " + dbText$(" gibt es nicht."))
        ARRAY_PUSH(z, "END FUNCTION")
    END IF
    RETURN JOIN$(z, CHR$(10)) + CHR$(10)
END FUNCTION

' Gibt es eine Datenbank im Projekt?
FUNCTION hatDatenbank() AS BOOLEAN
    DIM e AS Element
    FOR EACH e IN elemente
        IF e.art = "datenbank" THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Alle Datenbanken an ihr Schema angleichen; liefert die erste Meldung.
FUNCTION datenbankenAbgleichen$() AS STRING
    DIM e AS Element
    FOR EACH e IN elemente
        IF e.art <> "datenbank" THEN CONTINUE
        DIM f AS STRING : f = dbAbgleichen$(e)
        IF f <> "" THEN RETURN e.name + ": " + f
    NEXT
    RETURN ""
END FUNCTION

' --- Bindung: Fenster und Listen an Tabellen (Stufe 2 und 3) ---------------------
'  Ein Fenster nennt seine Tabelle in "studio_tabelle" (Datenbank.tabelle),
'  ein Feld seine Spalte in "bind" (GUI_BIND der Laufzeit). Eine Liste, eine
'  Tabelle oder eine Klappliste nennt in "studio_quelle" eine Tabelle oder
'  Abfrage, deren Zeilen sie zeigt, in "studio_spalten" welche Spalten (leer
'  = alle bzw. die erste), dazu "studio_sortieren", "studio_absteigend",
'  "studio_filter" (eine Bedingung wie in WHERE) und "studio_suchfeld" (ein
'  Textfeld im Fenster, das beim Tippen filtert). Die Basisklasse des
'  Fensters bekommt daraus Laden/Sichern/Neu/Loeschen/Ungesichert und
'  Neuladen/IdVon (erzeugen.dh ruft die SUBs hier); gelesen wird im Programm
'  ueber studioQuelle (datenbankCode$).
DIM dbRefEl AS Element
DIM dbRefT AS INTEGER : dbRefT = -1
DIM dbRefA AS INTEGER : dbRefA = -1

' "Daten.kunden" aufloesen: TRUE, wenn es Datenbank und Tabelle gibt.
FUNCTION dbRef(ref AS STRING) AS BOOLEAN
    RETURN dbQuelle(ref) AND dbRefT >= 0
END FUNCTION

' Wie dbRef, aber auch eine Abfrage (dbRefA) zaehlt.
FUNCTION dbQuelle(ref AS STRING) AS BOOLEAN
    dbRefT = -1 : dbRefA = -1
    DIM k AS INTEGER : k = INSTR(ref, ".")
    IF k <= 0 THEN RETURN FALSE
    DIM ei AS INTEGER : ei = elementIndex(LEFT$(ref, k))
    IF ei < 0 THEN RETURN FALSE
    IF elemente[ei].art <> "datenbank" THEN RETURN FALSE
    dbRefEl = elemente[ei]
    DIM s AS JSON_HANDLE : s = dbSchema(dbRefEl)
    DIM n AS STRING : n = MID$(ref, k + 1, LEN(ref))
    dbRefT = dbTabIndex(s, n)
    IF dbRefT < 0 THEN dbRefA = dbAbfIndex(s, n)
    RETURN dbRefT >= 0 OR dbRefA >= 0
END FUNCTION

' Alle Tabellen des Projekts als "Datenbank.tabelle".
FUNCTION dbAlleTabellen() AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM e AS Element
    FOR EACH e IN elemente
        IF e.art <> "datenbank" THEN CONTINUE
        DIM tn AS STRING
        FOR EACH tn IN dbTabellenNamen(e)
            ARRAY_PUSH(aus, e.name + "." + tn)
        NEXT
    NEXT
    RETURN aus
END FUNCTION

' Tabellen und Abfragen -- was eine Liste zeigen kann.
FUNCTION dbAlleQuellen() AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = dbAlleTabellen()
    DIM e AS Element
    FOR EACH e IN elemente
        IF e.art <> "datenbank" THEN CONTINUE
        DIM an AS STRING
        FOR EACH an IN dbAbfrageNamen(e)
            ARRAY_PUSH(aus, e.name + "." + an)
        NEXT
    NEXT
    RETURN aus
END FUNCTION

' Die Spalten einer Tabelle (ohne id), leer = gibt es nicht.
FUNCTION dbSpaltenVon(ref AS STRING) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    IF NOT dbRef(ref) THEN RETURN aus
    DIM s AS JSON_HANDLE : s = dbSchema(dbRefEl)
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, dbRefT) - 1
        ARRAY_PUSH(aus, dbSp$(s, dbRefT, k, "name"))
    NEXT
    RETURN aus
END FUNCTION

' Die Spalten einer Datenquelle (ohne id): einer Tabelle aus dem Schema,
' einer Abfrage aus ihrem Ergebnis in der Entwicklungsdatei.
FUNCTION dbQuellSpalten(ref AS STRING) AS ARRAY OF STRING
    IF NOT dbQuelle(ref) THEN RETURN []
    IF dbRefT >= 0 THEN RETURN dbSpaltenVon(ref)
    DIM e AS Element : e = dbRefEl
    DIM sql AS STRING : sql = dbAbfSql$(dbSchema(e), dbRefA)
    IF dbAbfrageTesten$(e, sql, 0) <> "" THEN RETURN []
    DIM aus AS ARRAY OF STRING : aus = []
    DIM n AS STRING
    FOR EACH n IN dbErgSpalten
        IF LOWER$(n) <> "id" THEN ARRAY_PUSH(aus, n)
    NEXT
    RETURN aus
END FUNCTION

' Welche Spalten eine Liste zeigt: die genannten, soweit es sie gibt; ohne
' Angabe bei einer Tabelle alle, sonst die erste. Nummern im Schema.
FUNCTION dbListSpalten(s AS JSON_HANDLE, t AS INTEGER, angabe AS STRING, art AS STRING) AS ARRAY OF INTEGER
    DIM aus AS ARRAY OF INTEGER : aus = []
    DIM w AS STRING
    FOR EACH w IN SPLIT(angabe, ";")
        DIM k AS INTEGER : k = dbSpIndex(s, t, TRIM$(w))
        IF k >= 0 THEN ARRAY_PUSH(aus, k)
    NEXT
    IF LEN(aus) = 0 THEN
        FOR k = 0 TO dbSpZahl(s, t) - 1
            ARRAY_PUSH(aus, k)
            IF art <> "table" THEN BREAK
        NEXT
    END IF
    RETURN aus
END FUNCTION

FUNCTION dbBindText$(d AS JSON_HANDLE, pfad AS STRING) AS STRING
    IF NOT JSON_HAS(d, pfad) THEN RETURN ""
    IF JSON_TYPE(d, pfad) <> "string" THEN RETURN ""
    RETURN JSON_GET_STRING(d, pfad)
END FUNCTION

FUNCTION dbBindAn(d AS JSON_HANDLE, pfad AS STRING) AS BOOLEAN
    IF NOT JSON_HAS(d, pfad) THEN RETURN FALSE
    IF JSON_TYPE(d, pfad) <> "boolean" THEN RETURN FALSE
    RETURN JSON_GET_BOOL(d, pfad)
END FUNCTION

' Die Tabelle eines Fensters, "" = keine (oder es gibt sie nicht mehr).
FUNCTION dbFensterTabelle$(d AS JSON_HANDLE) AS STRING
    DIM ref AS STRING : ref = dbBindText$(d, "studio_tabelle")
    IF ref = "" OR NOT dbRef(ref) THEN RETURN ""
    RETURN ref
END FUNCTION

' Die Listen eines Fensters mit Datenquelle: ihre Nummern im Layout.
FUNCTION dbQuellListen(d AS JSON_HANDLE, namen AS ARRAY OF STRING, arten AS ARRAY OF STRING) AS ARRAY OF INTEGER
    DIM aus AS ARRAY OF INTEGER : aus = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(d, "widgets") - 1
        IF i >= LEN(namen) THEN BREAK
        IF NOT istBezeichner(namen[i]) THEN CONTINUE
        IF arten[i] <> "table" AND arten[i] <> "listbox" AND arten[i] <> "dropdown" THEN CONTINUE
        IF dbQuelle(dbBindText$(d, "widgets." + STR$(i) + ".studio_quelle")) THEN ARRAY_PUSH(aus, i)
    NEXT
    RETURN aus
END FUNCTION

' Das Suchfeld einer Liste, "" = keins (oder kein Textfeld dieses Namens).
FUNCTION dbSuchfeld$(d AS JSON_HANDLE, i AS INTEGER, namen AS ARRAY OF STRING, arten AS ARRAY OF STRING) AS STRING
    DIM n AS STRING : n = dbBindText$(d, "widgets." + STR$(i) + ".studio_suchfeld")
    IF n = "" THEN RETURN ""
    DIM k AS INTEGER
    FOR k = 0 TO LEN(namen) - 1
        IF LOWER$(namen[k]) = LOWER$(n) AND (arten[k] = "textinput" OR arten[k] = "textarea") THEN RETURN namen[k]
    NEXT
    RETURN ""
END FUNCTION

' SQLite nennt die Stelle im SQL, das das Studio um die Angabe legt -- die
' meint niemand; die Meldung endet davor.
FUNCTION dbOhneHuelle$(fehler AS STRING) AS STRING
    DIM k AS INTEGER : k = INSTR(fehler, " in SELECT ")
    IF k > 0 THEN RETURN LEFT$(fehler, k)
    RETURN fehler
END FUNCTION

' Prueft eine Bedingung an der Entwicklungsdatei: "" = geht (oder es gibt
' noch keine Datei), sonst die Meldung.
FUNCTION dbFilterFehler$(ref AS STRING, filter AS STRING) AS STRING
    IF TRIM$(filter) = "" OR NOT dbQuelle(ref) THEN RETURN ""
    ' Einen Namen in doppelten Anfuehrungszeichen, den es nicht gibt, nimmt
    ' SQLite still als Text -- die Liste waere leer, ohne Fehler. Darum
    ' vorher: jeder solche Name muss eine Spalte der Quelle sein.
    DIM bekannt AS ARRAY OF STRING : bekannt = ["id"]
    DIM bn AS STRING
    FOR EACH bn IN dbQuellSpaltenMit(ref)
        ARRAY_PUSH(bekannt, LOWER$(bn))
    NEXT
    DIM fname AS STRING : fname = dbFilterNamePruefen$(filter, bekannt)
    IF fname <> "" THEN RETURN trf$("Die Spalte {0} gibt es in der Quelle nicht.", [fname])
    dbQuelle(ref)
    DIM p AS STRING : p = dbPfad$(dbRefEl)
    IF p = "" THEN RETURN ""
    IF NOT FILEEXISTS(p) THEN RETURN ""
    DIM q AS STRING : q = dbQuellSql$(dbRefEl, dbRefT, dbRefA, filter)
    DIM fehler AS STRING : fehler = ""
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(p)
        DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT COUNT(*) FROM " + q + " AS studio_q WHERE (" + filter + ")")
        DB_CLOSE_RESULT(r)
    CATCH ffehler
        fehler = dbOhneHuelle$(dbMeldung$(ffehler))
    END TRY
    TRY
        DB_CLOSE(db)
    CATCH zfehler
    END TRY
    RETURN fehler
END FUNCTION

' Der erste Name in doppelten Anfuehrungszeichen, der nicht bekannt ist ("" =
' alle bekannt); in einfachen Anfuehrungszeichen steht Text und zaehlt nicht.
FUNCTION dbFilterNamePruefen$(filter AS STRING, bekannt AS ARRAY OF STRING) AS STRING
    DIM i AS INTEGER : i = 0
    DIM n AS INTEGER : n = LEN(filter)
    WHILE i < n
        DIM c AS STRING : c = MID$(filter, i, 1)
        IF c = "'" THEN
            DIM e AS INTEGER : e = INSTR(filter, "'", i + 1)
            IF e < 0 THEN RETURN ""
            i = e + 1
        ELSEIF c = CHR$(34) THEN
            DIM ende AS INTEGER : ende = INSTR(filter, CHR$(34), i + 1)
            IF ende < 0 THEN RETURN ""
            DIM name AS STRING : name = MID$(filter, i + 1, ende - i - 1)
            IF ARRAY_INDEXOF(bekannt, LOWER$(name)) < 0 THEN RETURN name
            i = ende + 1
        ELSE
            i = i + 1
        END IF
    WEND
    RETURN ""
END FUNCTION

' Was im FROM steht: der Name der Tabelle oder die Abfrage in Klammern.
FUNCTION dbQuellSql$(e AS Element, t AS INTEGER, a AS INTEGER, bedarf AS STRING = "") AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    IF t >= 0 THEN
        DIM j AS STRING : j = dbVerweisJoin$(s, t, bedarf)
        IF j <> "" THEN RETURN j
        RETURN dbQ$(dbTabName$(s, t))
    END IF
    RETURN "(" + dbAbfSql$(s, a) + ")"
END FUNCTION

' --- Verbunde ueber Verweise -----------------------------------------------------------
'  Eine Liste an einer Tabelle zeigt auch Spalten der Tabellen, auf die eine
'  ihrer Spalten verweist: "kunde.name" ist die Spalte name der Zeile, deren id
'  in kunde steht. Das Studio legt dafuer einen LEFT JOIN um die Tabelle (eine
'  Zeile ohne Verweis bleibt, mit leerem Wert); die Spalte heisst im Ergebnis
'  "kunde.name", Sortierung, Bedingung und Suche nennen sie genauso.

' Was "verweis.spalte" meint: die Art der Zielspalte ("" = kein solcher
' Verweis) -- dbVwName haelt danach den Namen in der Schreibweise des Schemas.
DIM dbVwName AS STRING : dbVwName = ""
FUNCTION dbVerweisTyp$(s AS JSON_HANDLE, t AS INTEGER, angabe AS STRING) AS STRING
    dbVwName = ""
    DIM k AS INTEGER : k = INSTR(angabe, ".")
    IF k <= 0 THEN RETURN ""
    DIM vk AS INTEGER : vk = dbSpIndex(s, t, LEFT$(angabe, k))
    IF vk < 0 THEN RETURN ""
    DIM zt AS INTEGER : zt = dbTabIndex(s, dbSp$(s, t, vk, "verweis"))
    IF zt < 0 OR dbSp$(s, t, vk, "verweis") = "" THEN RETURN ""
    DIM zk AS INTEGER : zk = dbSpIndex(s, zt, MID$(angabe, k + 1))
    IF zk < 0 THEN RETURN ""
    dbVwName = dbSp$(s, t, vk, "name") + "." + dbSp$(s, zt, zk, "name")
    RETURN dbSp$(s, zt, zk, "typ")
END FUNCTION

' Alle "verweis.spalte" einer Tabelle (fuer die Auswahlen im Inspektor).
FUNCTION dbVerweisSpalten(s AS JSON_HANDLE, t AS INTEGER) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = []
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        DIM zt AS INTEGER : zt = dbTabIndex(s, dbSp$(s, t, k, "verweis"))
        IF zt < 0 OR dbSp$(s, t, k, "verweis") = "" THEN CONTINUE
        DIM zk AS INTEGER
        FOR zk = 0 TO dbSpZahl(s, zt) - 1
            ARRAY_PUSH(aus, dbSp$(s, t, k, "name") + "." + dbSp$(s, zt, zk, "name"))
        NEXT
    NEXT
    RETURN aus
END FUNCTION

' Die Tabelle samt den Verbunden, die "bedarf" (angezeigte Spalten, Sortierung,
' Bedingung) nennt; "" = keiner noetig, dann bleibt es beim Namen der Tabelle.
FUNCTION dbVerweisJoin$(s AS JSON_HANDLE, t AS INTEGER, bedarf AS STRING) AS STRING
    IF bedarf = "" THEN RETURN ""
    DIM klein AS STRING : klein = LOWER$(bedarf)
    DIM sel AS ARRAY OF STRING : sel = ["q.*"]
    DIM joins AS STRING : joins = ""
    DIM n AS INTEGER : n = 0
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        DIM ziel AS STRING : ziel = dbSp$(s, t, k, "verweis")
        DIM zt AS INTEGER : zt = dbTabIndex(s, ziel)
        IF ziel = "" OR zt < 0 THEN CONTINUE
        DIM v AS STRING : v = dbSp$(s, t, k, "name")
        IF INSTR(klein, LOWER$(v) + ".") < 0 THEN CONTINUE
        DIM al AS STRING : al = "j" + STR$(n)
        n = n + 1
        joins = joins + " LEFT JOIN " + dbQ$(dbTabName$(s, zt)) + " AS " + al + " ON " + al + ".id = q." + dbQ$(v)
        DIM zk AS INTEGER
        FOR zk = 0 TO dbSpZahl(s, zt) - 1
            ARRAY_PUSH(sel, al + "." + dbQ$(dbSp$(s, zt, zk, "name")) + " AS " + dbQ$(v + "." + dbSp$(s, zt, zk, "name")))
        NEXT
    NEXT
    IF n = 0 THEN RETURN ""
    RETURN "(SELECT " + JOIN$(sel, ", ") + " FROM " + dbQ$(dbTabName$(s, t)) + " AS q" + joins + ")"
END FUNCTION

' Welche Spalten eine Liste zeigt, samt Art -- eigene und "verweis.spalte"
' in der Schreibweise des Schemas; ohne Angabe wie dbListSpalten.
DIM dbLsNamen AS ARRAY OF STRING : dbLsNamen = []
DIM dbLsTypen AS ARRAY OF STRING : dbLsTypen = []
SUB dbListSpaltenMit(s AS JSON_HANDLE, t AS INTEGER, angabe AS STRING, art AS STRING)
    dbLsNamen = [] : dbLsTypen = []
    DIM w AS STRING
    FOR EACH w IN SPLIT(angabe, ";")
        DIM n AS STRING : n = TRIM$(w)
        IF n = "" THEN CONTINUE
        DIM k AS INTEGER : k = dbSpIndex(s, t, n)
        IF k >= 0 THEN
            ARRAY_PUSH(dbLsNamen, dbSp$(s, t, k, "name"))
            ARRAY_PUSH(dbLsTypen, dbSp$(s, t, k, "typ"))
        ELSE
            DIM vt AS STRING : vt = dbVerweisTyp$(s, t, n)
            IF dbVwName <> "" THEN
                ARRAY_PUSH(dbLsNamen, dbVwName)
                ARRAY_PUSH(dbLsTypen, vt)
            END IF
        END IF
    NEXT
    IF LEN(dbLsNamen) > 0 THEN RETURN
    DIM q AS INTEGER
    FOR EACH q IN dbListSpalten(s, t, "", art)
        ARRAY_PUSH(dbLsNamen, dbSp$(s, t, q, "name"))
        ARRAY_PUSH(dbLsTypen, dbSp$(s, t, q, "typ"))
    NEXT
END SUB

' Die Spalten einer Datenquelle samt "verweis.spalte" (bei einer Tabelle).
FUNCTION dbQuellSpaltenMit(ref AS STRING) AS ARRAY OF STRING
    DIM aus AS ARRAY OF STRING : aus = dbQuellSpalten(ref)
    IF NOT dbQuelle(ref) THEN RETURN aus
    IF dbRefT < 0 THEN RETURN aus
    DIM v AS STRING
    FOR EACH v IN dbVerweisSpalten(dbSchema(dbRefEl), dbRefT)
        ARRAY_PUSH(aus, v)
    NEXT
    RETURN aus
END FUNCTION

SUB dbBasisFelder(z AS ARRAY OF STRING, d AS JSON_HANDLE, namen AS ARRAY OF STRING, arten AS ARRAY OF STRING)
    IF dbFensterTabelle$(d) <> "" THEN ARRAY_PUSH(z, "    DIM DatensatzId AS INTEGER")
    DIM i AS INTEGER
    FOR EACH i IN dbQuellListen(d, namen, arten)
        ARRAY_PUSH(z, "    DIM studioIds_" + namen[i] + " AS ARRAY OF INTEGER")
        IF arten[i] = "table" THEN ARRAY_PUSH(z, "    DIM studioBilder_" + namen[i] + " AS ARRAY OF IMAGE")
    NEXT
    ' Ein Bild-Control an einer Bildspalte: das gezeigte Bild und, bis zum
    ' Sichern, die neuen Bytes.
    FOR EACH i IN dbBildFelder(d, namen, arten)
        ARRAY_PUSH(z, "    DIM studioBild_" + namen[i] + " AS IMAGE")
        ARRAY_PUSH(z, "    DIM studioBildNeu_" + namen[i] + " AS BUFFER")
        ARRAY_PUSH(z, "    DIM studioBildGeaendert_" + namen[i] + " AS BOOLEAN")
    NEXT
END SUB

' Die Bild-Controls des Fensters an einer Bildspalte seiner Tabelle.
FUNCTION dbBildFelder(d AS JSON_HANDLE, namen AS ARRAY OF STRING, arten AS ARRAY OF STRING) AS ARRAY OF INTEGER
    DIM aus AS ARRAY OF INTEGER : aus = []
    DIM ft AS STRING : ft = dbFensterTabelle$(d)
    IF ft = "" THEN RETURN aus
    IF NOT dbRef(ft) THEN RETURN aus
    DIM s AS JSON_HANDLE : s = dbSchema(dbRefEl)
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(d, "widgets") - 1
        IF i >= LEN(namen) THEN BREAK
        IF arten[i] <> "image" OR NOT istBezeichner(namen[i]) THEN CONTINUE
        DIM sp AS STRING : sp = dbBindText$(d, "widgets." + STR$(i) + ".studio_bildspalte")
        IF sp = "" THEN CONTINUE
        DIM k AS INTEGER : k = dbSpIndex(s, dbRefT, sp)
        IF k < 0 THEN CONTINUE
        IF dbSp$(s, dbRefT, k, "typ") = "bild" THEN ARRAY_PUSH(aus, i)
    NEXT
    RETURN aus
END FUNCTION

' Das Bild eines Bild-Controls tauschen (das alte geben wir frei).
SUB dbBildZeile(z AS ARRAY OF STRING, n AS STRING, neu AS STRING)
    ARRAY_PUSH(z, "        IF Self.studioBild_" + n + " >= 0 THEN IMAGE_FREE(Self.studioBild_" + n + ")")
    ARRAY_PUSH(z, "        Self.studioBild_" + n + " = " + neu)
    ARRAY_PUSH(z, "        GUI_SET_IMAGE(Self." + n + ", Self.studioBild_" + n + ")")
END SUB

' Am Ende von studioAufbauen: erst die Listen (eine Klappliste mit Verweis
' muss ihre Eintraege haben, bevor eine Vorgabe sie waehlen kann), dann ein
' leerer Datensatz mit den Vorgaben.
SUB dbBasisAufbau(z AS ARRAY OF STRING, d AS JSON_HANDLE, namen AS ARRAY OF STRING, arten AS ARRAY OF STRING)
    DIM bi AS INTEGER
    FOR EACH bi IN dbBildFelder(d, namen, arten)
        ARRAY_PUSH(z, "        Self.studioBild_" + namen[bi] + " = -1")
        ARRAY_PUSH(z, "        Self.studioBildNeu_" + namen[bi] + " = BUFFER_NEW(0)")
    NEXT
    IF LEN(dbQuellListen(d, namen, arten)) > 0 THEN ARRAY_PUSH(z, "        Self.Neuladen()")
    IF dbFensterTabelle$(d) <> "" THEN ARRAY_PUSH(z, "        Self.Neu()")
END SUB

SUB dbBasisMethoden(z AS ARRAY OF STRING, d AS JSON_HANDLE, namen AS ARRAY OF STRING, arten AS ARRAY OF STRING)
    DIM ft AS STRING : ft = dbFensterTabelle$(d)
    DIM listen AS ARRAY OF INTEGER : listen = dbQuellListen(d, namen, arten)
    DIM neuladen AS STRING : neuladen = IIF(LEN(listen) > 0, "        Self.Neuladen()", "")
    DIM bilder AS ARRAY OF INTEGER : bilder = dbBildFelder(d, namen, arten)
    DIM bi AS INTEGER
    ' Ohne gebundenes Feld (etwa nur ein Bild) kennt GUI_FORM_* kein Formular.
    DIM gebunden AS BOOLEAN : gebunden = FALSE
    FOR bi = 0 TO JSON_LEN(d, "widgets") - 1
        IF dbBindText$(d, "widgets." + STR$(bi) + ".bind") <> "" THEN gebunden = TRUE
    NEXT
    IF ft <> "" THEN
        dbRef(ft)
        DIM con AS STRING : con = dbRefEl.name
        DIM tab AS STRING : tab = dbTabName$(dbSchema(dbRefEl), dbRefT)
        DIM s AS JSON_HANDLE : s = dbSchema(dbRefEl)
        ARRAY_PUSH(z, "")
        ARRAY_PUSH(z, "    ' Das Fenster gehoert zur Tabelle " + ft + ": DatensatzId ist die Zeile,")
        ARRAY_PUSH(z, "    ' die gerade dasteht (0 = eine neue, noch nicht gesichert).")
        ARRAY_PUSH(z, "    FUNCTION Laden(id AS INTEGER) AS BOOLEAN")
        IF gebunden THEN
            ARRAY_PUSH(z, "        IF NOT GUI_FORM_LOAD(Self.studioWin, " + con + ", " + dbText$(tab) + ", id) THEN RETURN FALSE")
        ELSE
            ARRAY_PUSH(z, "        IF NOT studioDbZeileDa(" + con + ", " + dbText$(tab) + ", id) THEN RETURN FALSE")
        END IF
        ARRAY_PUSH(z, "        Self.DatensatzId = id")
        FOR EACH bi IN bilder
            dbBildZeile(z, namen[bi], "studioDbBildLesen(" + con + ", " + dbText$(tab) + ", " + dbText$(dbBindText$(d, "widgets." + STR$(bi) + ".studio_bildspalte")) + ", id)")
            ARRAY_PUSH(z, "        Self.studioBildGeaendert_" + namen[bi] + " = FALSE")
        NEXT
        ARRAY_PUSH(z, "        RETURN TRUE")
        ARRAY_PUSH(z, "    END FUNCTION")
        ARRAY_PUSH(z, "")
        ARRAY_PUSH(z, "    FUNCTION Sichern() AS BOOLEAN")
        ARRAY_PUSH(z, "        IF GUI_VALIDATE(Self.studioWin) > 0 THEN RETURN FALSE")
        IF gebunden THEN
            ARRAY_PUSH(z, "        DIM id AS INTEGER : id = GUI_FORM_SAVE(Self.studioWin, " + con + ", " + dbText$(tab) + ", IIF(Self.DatensatzId > 0, Self.DatensatzId, -1))")
        ELSE
            ARRAY_PUSH(z, "        DIM id AS INTEGER : id = Self.DatensatzId")
            ARRAY_PUSH(z, "        IF id <= 0 THEN id = studioDbZeileNeu(" + con + ", " + dbText$(tab) + ")")
        END IF
        ARRAY_PUSH(z, "        IF id = 0 THEN RETURN FALSE")
        ARRAY_PUSH(z, "        Self.DatensatzId = id")
        FOR EACH bi IN bilder
            DIM bsp AS STRING : bsp = dbQ$(dbBindText$(d, "widgets." + STR$(bi) + ".studio_bildspalte"))
            ARRAY_PUSH(z, "        IF Self.studioBildGeaendert_" + namen[bi] + " THEN")
            ARRAY_PUSH(z, "            IF BUFFER_LEN(Self.studioBildNeu_" + namen[bi] + ") > 0 THEN")
            ARRAY_PUSH(z, "                DB_EXEC(" + con + ", " + dbText$("UPDATE " + dbQ$(tab) + " SET " + bsp + " = ? WHERE id = ?") + ", Self.studioBildNeu_" + namen[bi] + ", id)")
            ARRAY_PUSH(z, "            ELSE")
            ARRAY_PUSH(z, "                DB_EXEC(" + con + ", " + dbText$("UPDATE " + dbQ$(tab) + " SET " + bsp + " = NULL WHERE id = ?") + ", id)")
            ARRAY_PUSH(z, "            END IF")
            ARRAY_PUSH(z, "            Self.studioBildGeaendert_" + namen[bi] + " = FALSE")
            ARRAY_PUSH(z, "        END IF")
        NEXT
        IF neuladen <> "" THEN ARRAY_PUSH(z, neuladen)
        ARRAY_PUSH(z, "        RETURN TRUE")
        ARRAY_PUSH(z, "    END FUNCTION")
        ARRAY_PUSH(z, "")
        ' Neu: die Felder leer, dann die Vorgaben der gebundenen Spalten.
        DIM vor AS ARRAY OF STRING : vor = []
        DIM i AS INTEGER
        FOR i = 0 TO JSON_LEN(d, "widgets") - 1
            DIM sp AS STRING : sp = dbBindText$(d, "widgets." + STR$(i) + ".bind")
            IF sp = "" THEN CONTINUE
            DIM k AS INTEGER : k = dbSpIndex(s, dbRefT, sp)
            IF k < 0 THEN CONTINUE
            IF dbSp$(s, dbRefT, k, "vorgabe") = "" THEN CONTINUE
            ARRAY_PUSH(vor, dbText$(sp) + ": " + dbText$(dbSp$(s, dbRefT, k, "vorgabe")))
        NEXT
        ARRAY_PUSH(z, "    SUB Neu()")
        IF gebunden THEN
            ARRAY_PUSH(z, "        GUI_FORM_CLEAR(Self.studioWin)")
            IF LEN(vor) > 0 THEN ARRAY_PUSH(z, "        GUI_FORM_SET(Self.studioWin, {" + JOIN$(vor, ", ") + "})")
            ARRAY_PUSH(z, "        GUI_FORM_CLEAN(Self.studioWin)")
        END IF
        ARRAY_PUSH(z, "        Self.DatensatzId = 0")
        FOR EACH bi IN bilder
            dbBildZeile(z, namen[bi], "-1")
            ARRAY_PUSH(z, "        Self.studioBildNeu_" + namen[bi] + " = BUFFER_NEW(0)")
            ARRAY_PUSH(z, "        Self.studioBildGeaendert_" + namen[bi] + " = FALSE")
        NEXT
        ARRAY_PUSH(z, "    END SUB")
        ARRAY_PUSH(z, "")
        ARRAY_PUSH(z, "    FUNCTION Loeschen() AS BOOLEAN")
        ARRAY_PUSH(z, "        IF Self.DatensatzId <= 0 THEN RETURN FALSE")
        ARRAY_PUSH(z, "        DB_EXEC(" + con + ", " + dbText$("DELETE FROM " + dbQ$(tab) + " WHERE id = ?") + ", Self.DatensatzId)")
        ARRAY_PUSH(z, "        Self.Neu()")
        IF neuladen <> "" THEN ARRAY_PUSH(z, neuladen)
        ARRAY_PUSH(z, "        RETURN TRUE")
        ARRAY_PUSH(z, "    END FUNCTION")
        ARRAY_PUSH(z, "")
        ARRAY_PUSH(z, "    FUNCTION Ungesichert() AS BOOLEAN")
        FOR EACH bi IN bilder
            ARRAY_PUSH(z, "        IF Self.studioBildGeaendert_" + namen[bi] + " THEN RETURN TRUE")
        NEXT
        ARRAY_PUSH(z, "        RETURN " + IIF(gebunden, "GUI_FORM_CHANGED(Self.studioWin)", "FALSE"))
        ARRAY_PUSH(z, "    END FUNCTION")
        IF LEN(bilder) > 0 THEN
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "    ' Ein Bild aus einer Datei in ein Bild-Control an einer Bildspalte;")
            ARRAY_PUSH(z, "    ' in die Datenbank kommt es mit Sichern().")
            ARRAY_PUSH(z, "    FUNCTION BildSetzen(w AS GUI_WIDGET, pfad AS STRING) AS BOOLEAN")
            ARRAY_PUSH(z, "        IF NOT FILEEXISTS(pfad) THEN RETURN FALSE")
            ARRAY_PUSH(z, "        DIM b AS BUFFER : b = READALL_BYTES(pfad)")
            ARRAY_PUSH(z, "        DIM bild AS IMAGE")
            ARRAY_PUSH(z, "        TRY")
            ARRAY_PUSH(z, "            bild = IMAGE_FROM_BUFFER(b)")
            ARRAY_PUSH(z, "        CATCH studioFehler")
            ARRAY_PUSH(z, "            RETURN FALSE")
            ARRAY_PUSH(z, "        END TRY")
            FOR EACH bi IN bilder
                ARRAY_PUSH(z, "        IF w = Self." + namen[bi] + " THEN")
                dbBildZeile(z, namen[bi], "bild")
                ARRAY_PUSH(z, "            Self.studioBildNeu_" + namen[bi] + " = b")
                ARRAY_PUSH(z, "            Self.studioBildGeaendert_" + namen[bi] + " = TRUE")
                ARRAY_PUSH(z, "            RETURN TRUE")
                ARRAY_PUSH(z, "        END IF")
            NEXT
            ARRAY_PUSH(z, "        IMAGE_FREE(bild)")
            ARRAY_PUSH(z, "        RETURN FALSE")
            ARRAY_PUSH(z, "    END FUNCTION")
            ARRAY_PUSH(z, "")
            ARRAY_PUSH(z, "    SUB BildLeeren(w AS GUI_WIDGET)")
            FOR EACH bi IN bilder
                ARRAY_PUSH(z, "        IF w = Self." + namen[bi] + " THEN")
                dbBildZeile(z, namen[bi], "-1")
                ARRAY_PUSH(z, "            Self.studioBildNeu_" + namen[bi] + " = BUFFER_NEW(0)")
                ARRAY_PUSH(z, "            Self.studioBildGeaendert_" + namen[bi] + " = TRUE")
                ARRAY_PUSH(z, "        END IF")
            NEXT
            ARRAY_PUSH(z, "    END SUB")
        END IF
    END IF
    IF LEN(listen) = 0 THEN RETURN
    ARRAY_PUSH(z, "")
    ARRAY_PUSH(z, "    ' Die Listen mit Datenquelle neu aus der Datenbank fuellen.")
    ARRAY_PUSH(z, "    SUB Neuladen()")
    ARRAY_PUSH(z, "        DIM r AS DB_RESULT")
    DIM li AS INTEGER
    FOR EACH li IN listen
        DIM wp AS STRING : wp = "widgets." + STR$(li) + "."
        DIM ref AS STRING : ref = dbBindText$(d, wp + "studio_quelle")
        dbQuelle(ref)
        DIM le AS Element : le = dbRefEl
        DIM ls AS JSON_HANDLE : ls = dbSchema(le)
        DIM quelle AS STRING : quelle = dbQuellSql$(le, dbRefT, dbRefA)
        ' Bei einer Tabelle sind Spalten und Arten bekannt; eine Abfrage
        ' nennt ihre Spalten erst im Programm.
        DIM spalten AS STRING : spalten = dbBindText$(d, wp + "studio_spalten")
        DIM typen AS STRING : typen = ""
        DIM bildSp AS ARRAY OF INTEGER : bildSp = []
        IF dbRefT >= 0 THEN
            ' Nennen Spalten, Sortierung oder Bedingung "verweis.spalte", liest
            ' die Liste aus der Tabelle samt Verbund.
            quelle = dbQuellSql$(le, dbRefT, -1, spalten + ";" + dbBindText$(d, wp + "studio_sortieren") + ";" + dbBindText$(d, wp + "studio_filter"))
            dbListSpaltenMit(ls, dbRefT, spalten, arten[li])
            spalten = JOIN$(dbLsNamen, ";")
            typen = JOIN$(dbLsTypen, ";")
            DIM q AS INTEGER
            FOR q = 0 TO LEN(dbLsTypen) - 1
                IF dbLsTypen[q] = "bild" THEN ARRAY_PUSH(bildSp, q)
            NEXT
        END IF
        DIM such AS STRING : such = dbSuchfeld$(d, li, namen, arten)
        DIM w AS STRING : w = "Self." + namen[li]
        DIM ids AS STRING : ids = "Self.studioIds_" + namen[li]
        DIM war AS STRING : war = "studioWar_" + namen[li]
        ARRAY_PUSH(z, "        ' " + namen[li] + ": " + ref)
        IF arten[li] = "dropdown" THEN
            ' Eine Klappliste traegt je Eintrag die id als Wert (gebunden wird
            ' der Wert) und behaelt ihre Wahl ueber das Neuladen.
            ARRAY_PUSH(z, "        DIM " + war + " AS STRING : " + war + " = " + CHR$(34) + CHR$(34))
            ARRAY_PUSH(z, "        IF GUI_DROPDOWN_SELECTED(" + w + ") >= 0 THEN " + war + " = GUI_LISTBOX_DATA$(" + w + ", GUI_DROPDOWN_SELECTED(" + w + "))")
        END IF
        ARRAY_PUSH(z, "        " + ids + " = []")
        ARRAY_PUSH(z, "        r = studioQuelle(" + le.name + ", " + dbText$(quelle) + ", " + dbText$(spalten) + ", " + dbText$(dbBindText$(d, wp + "studio_filter")) + ", " + dbText$(dbBindText$(d, wp + "studio_sortieren")) + ", " + IIF(dbBindAn(d, wp + "studio_absteigend"), "TRUE", "FALSE") + ", " + IIF(such = "", dbText$(""), "GUI_TEXT(Self." + such + ")") + ")")
        IF arten[li] = "table" THEN
            ARRAY_PUSH(z, "        DIM studioAlt_" + namen[li] + " AS IMAGE")
            ARRAY_PUSH(z, "        FOR EACH studioAlt_" + namen[li] + " IN Self.studioBilder_" + namen[li])
            ARRAY_PUSH(z, "            IMAGE_FREE(studioAlt_" + namen[li] + ")")
            ARRAY_PUSH(z, "        NEXT")
            ARRAY_PUSH(z, "        Self.studioBilder_" + namen[li] + " = []")
            ARRAY_PUSH(z, "        GUI_TABLE_CLEAR(" + w + ")")
            ARRAY_PUSH(z, "        GUI_TABLE_HEADERS(" + w + ", studioQuelleSpalten)")
        ELSE
            ARRAY_PUSH(z, "        GUI_LISTBOX_CLEAR(" + w + ")")
        END IF
        ARRAY_PUSH(z, "        WHILE DB_NEXT(r)")
        ARRAY_PUSH(z, "            ARRAY_PUSH(" + ids + ", DB_GET_INT(r, 0))")
        IF arten[li] = "table" THEN
            ARRAY_PUSH(z, "            GUI_TABLE_ADD_ROW(" + w + ", studioZeile(r, " + dbText$(typen) + "))")
            DIM bq AS INTEGER
            FOR EACH bq IN bildSp
                DIM bv AS STRING : bv = "studioB_" + namen[li] + "_" + STR$(bq)
                ARRAY_PUSH(z, "            DIM " + bv + " AS IMAGE : " + bv + " = studioDbBild(r, " + STR$(bq + 1) + ")")
                ARRAY_PUSH(z, "            IF " + bv + " >= 0 THEN")
                ARRAY_PUSH(z, "                ARRAY_PUSH(Self.studioBilder_" + namen[li] + ", " + bv + ")")
                ARRAY_PUSH(z, "                GUI_TABLE_CELL_KIND(" + w + ", GUI_TABLE_ROW_COUNT(" + w + ") - 1, " + STR$(bq) + ", " + dbText$("bild") + ")")
                ARRAY_PUSH(z, "                GUI_TABLE_CELL_IMAGE(" + w + ", GUI_TABLE_ROW_COUNT(" + w + ") - 1, " + STR$(bq) + ", " + bv + ")")
                ARRAY_PUSH(z, "            END IF")
            NEXT
        ELSE
            ARRAY_PUSH(z, "            GUI_LISTBOX_ADD(" + w + ", studioZeile(r, " + dbText$(typen) + ")[0])")
            IF arten[li] = "dropdown" THEN ARRAY_PUSH(z, "            GUI_LISTBOX_SET_DATA(" + w + ", GUI_LISTBOX_COUNT(" + w + ") - 1, STR$(DB_GET_INT(r, 0)))")
        END IF
        ARRAY_PUSH(z, "        WEND")
        IF arten[li] = "dropdown" THEN
            ARRAY_PUSH(z, "        IF " + war + " <> " + CHR$(34) + CHR$(34) + " AND GUI_LISTBOX_FIND_DATA(" + w + ", " + war + ") >= 0 THEN GUI_DROPDOWN_SET_SELECTED(" + w + ", GUI_LISTBOX_FIND_DATA(" + w + ", " + war + "))")
        END IF
        ' Zeigt die Liste die Tabelle des Fensters, bleibt der Datensatz gewaehlt.
        IF ref = ft THEN
            DIM setzen AS STRING : setzen = IIF(arten[li] = "table", "GUI_TABLE_SET_SELECTED", IIF(arten[li] = "dropdown", "GUI_DROPDOWN_SET_SELECTED", "GUI_LISTBOX_SET_SELECTED"))
            ARRAY_PUSH(z, "        IF Self.DatensatzId > 0 AND ARRAY_INDEXOF(" + ids + ", Self.DatensatzId) >= 0 THEN " + setzen + "(" + w + ", ARRAY_INDEXOF(" + ids + ", Self.DatensatzId))")
        END IF
    NEXT
    ARRAY_PUSH(z, "    END SUB")
    ARRAY_PUSH(z, "")
    ARRAY_PUSH(z, "    ' Die id der gewaehlten Zeile einer Liste mit Datenquelle (0 = keine).")
    ARRAY_PUSH(z, "    FUNCTION IdVon(w AS GUI_WIDGET) AS INTEGER")
    ARRAY_PUSH(z, "        DIM i AS INTEGER : i = -1")
    FOR EACH li IN listen
        DIM wahl AS STRING : wahl = IIF(arten[li] = "table", "GUI_TABLE_SELECTED", IIF(arten[li] = "dropdown", "GUI_DROPDOWN_SELECTED", "GUI_LISTBOX_SELECTED"))
        ARRAY_PUSH(z, "        IF w = Self." + namen[li] + " THEN")
        ARRAY_PUSH(z, "            i = " + wahl + "(w)")
        ARRAY_PUSH(z, "            IF i >= 0 AND i < LEN(Self.studioIds_" + namen[li] + ") THEN RETURN Self.studioIds_" + namen[li] + "[i]")
        ARRAY_PUSH(z, "        END IF")
    NEXT
    ARRAY_PUSH(z, "        RETURN 0")
    ARRAY_PUSH(z, "    END FUNCTION")
END SUB

' Je Bild: waehlt man in einer Liste der eigenen Tabelle eine Zeile, laedt
' das Fenster sie; tippt man in ein Suchfeld, laden die Listen neu.
SUB dbBasisTakt(takt AS ARRAY OF STRING, d AS JSON_HANDLE, namen AS ARRAY OF STRING, arten AS ARRAY OF STRING)
    DIM ft AS STRING : ft = dbFensterTabelle$(d)
    DIM li AS INTEGER
    DIM gesehen AS ARRAY OF STRING : gesehen = []
    FOR EACH li IN dbQuellListen(d, namen, arten)
        DIM such AS STRING : such = dbSuchfeld$(d, li, namen, arten)
        IF such <> "" AND ARRAY_INDEXOF(gesehen, such) < 0 THEN
            ARRAY_PUSH(gesehen, such)
            ARRAY_PUSH(takt, "        IF NOT Self.studioOffen THEN RETURN")
            ARRAY_PUSH(takt, "        IF GUI_CHANGED(Self." + such + ") THEN Self.Neuladen()")
        END IF
        IF ft = "" THEN CONTINUE
        IF dbBindText$(d, "widgets." + STR$(li) + ".studio_quelle") <> ft THEN CONTINUE
        ARRAY_PUSH(takt, "        IF NOT Self.studioOffen THEN RETURN")
        ARRAY_PUSH(takt, "        IF GUI_CHANGED(Self." + namen[li] + ") THEN")
        ARRAY_PUSH(takt, "            IF Self.IdVon(Self." + namen[li] + ") > 0 THEN")
        ARRAY_PUSH(takt, "                DIM studioGel_" + namen[li] + " AS BOOLEAN : studioGel_" + namen[li] + " = Self.Laden(Self.IdVon(Self." + namen[li] + "))")
        ARRAY_PUSH(takt, "            END IF")
        ARRAY_PUSH(takt, "        END IF")
    NEXT
END SUB

' --- Verweise (Fremdschluessel) ----------------------------------------------------
'  Eine Spalte kann auf eine andere Tabelle derselben Datenbank zeigen
'  ("verweis"): sie haelt deren id. Gezogen wird sie zu einer Klappliste mit
'  der Anzeigespalte der Zieltabelle; gebunden ist der Wert, also die id.
FUNCTION dbSpalteVerweis$(e AS Element, tabelle AS STRING, name AS STRING, ziel AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    DIM k AS INTEGER : k = dbSpIndex(s, t, name)
    IF k < 0 THEN RETURN trf$("Die Spalte {0} gibt es nicht.", [name])
    DIM p AS STRING : p = dbSpPfad$(t, k)
    IF ziel = "" THEN
        IF JSON_HAS(s, p + ".verweis") THEN JSON_REMOVE(s, p + ".verweis")
        ' Ohne Ziel kein Fremdschluessel mehr -- ausdruecklich, damit der
        ' Abgleich einen vorhandenen aus der Datei nimmt.
        JSON_SET_STRING(s, p + ".beimLoeschen", "")
    ELSE
        DIM zt AS INTEGER : zt = dbTabIndex(s, ziel)
        IF zt < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [ziel])
        JSON_SET_STRING(s, p + ".verweis", dbTabName$(s, zt))
        ' Ein Verweis haelt eine id -- eine ganze Zahl.
        JSON_SET_STRING(s, p + ".typ", "ganz")
        IF NOT JSON_HAS(s, p + ".beimLoeschen") THEN JSON_SET_STRING(s, p + ".beimLoeschen", "")
    END IF
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), [])
END FUNCTION

' Was mit einer Zeile geschieht, wenn die Zeile geloescht wird, auf die ihr
' Verweis zeigt ("", "verbieten", "loeschen", "leeren"; siehe dbFkSql$).
FUNCTION dbSpalteBeimLoeschen$(e AS Element, tabelle AS STRING, name AS STRING, wert AS STRING) AS STRING
    IF ARRAY_INDEXOF(["", "verbieten", "loeschen", "leeren"], wert) < 0 THEN RETURN trf$("„{0}“ ist keine Wahl -- möglich sind verbieten, loeschen und leeren.", [wert])
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM t AS INTEGER : t = dbTabIndex(s, tabelle)
    IF t < 0 THEN RETURN trf$("Die Tabelle {0} gibt es nicht.", [tabelle])
    DIM k AS INTEGER : k = dbSpIndex(s, t, name)
    IF k < 0 THEN RETURN trf$("Die Spalte {0} gibt es nicht.", [name])
    IF wert <> "" AND dbSp$(s, t, k, "verweis") = "" THEN RETURN trf$("Die Spalte {0} verweist auf nichts -- erst unter „Verweis auf“ eine Tabelle wählen.", [name])
    IF wert = "leeren" AND dbSpAn(s, t, k, "pflicht") THEN RETURN trf$("Die Spalte {0} ist Pflicht -- leeren geht nur ohne.", [name])
    JSON_SET_STRING(s, dbSpPfad$(t, k) + ".beimLoeschen", wert)
    RETURN dbAusfuehren$(e, JSON_STRINGIFY(s), [])
END FUNCTION

' Die Wahl im Spalten-Gitter und ihr Wert.
FUNCTION dbLoeschenNamen() AS ARRAY OF STRING
    RETURN ["", tr$("verbieten"), tr$("mitlöschen"), tr$("leeren")]
END FUNCTION

FUNCTION dbLoeschenName$(wert AS STRING) AS STRING
    DIM i AS INTEGER : i = ARRAY_INDEXOF(["", "verbieten", "loeschen", "leeren"], wert)
    RETURN dbLoeschenNamen()[MAX(0, i)]
END FUNCTION

FUNCTION dbLoeschenWert$(name AS STRING) AS STRING
    DIM i AS INTEGER : i = ARRAY_INDEXOF(dbLoeschenNamen(), name)
    RETURN ["", "verbieten", "loeschen", "leeren"][MAX(0, i)]
END FUNCTION

' Was eine Klappliste mit Verweis zeigt: die erste Textspalte der
' Zieltabelle, sonst ihre erste Spalte, sonst nichts (dann die id).
FUNCTION dbAnzeigeSpalte$(s AS JSON_HANDLE, t AS INTEGER) AS STRING
    DIM k AS INTEGER
    FOR k = 0 TO dbSpZahl(s, t) - 1
        IF dbSp$(s, t, k, "typ") = "text" THEN RETURN dbSp$(s, t, k, "name")
    NEXT
    IF dbSpZahl(s, t) > 0 THEN RETURN dbSp$(s, t, 0, "name")
    RETURN ""
END FUNCTION

' --- Abfragen ------------------------------------------------------------------------
'  Eine Abfrage ist ein benanntes SELECT (oder WITH ... SELECT) in der
'  Datenbank -- als Datenquelle einer Liste (traegt sie eine Spalte id, liefert
'  IdVon sie) oder im Code ueber Abfrage("name"). Namen teilen sich Tabellen
'  und Abfragen.
DIM dbErgSpalten AS ARRAY OF STRING : dbErgSpalten = []
DIM dbErgZellen AS ARRAY OF STRING : dbErgZellen = []
DIM dbErgZeilen AS INTEGER : dbErgZeilen = 0

FUNCTION dbAbfZahl(s AS JSON_HANDLE) AS INTEGER
    IF NOT JSON_HAS(s, "abfragen") THEN RETURN 0
    RETURN JSON_LEN(s, "abfragen")
END FUNCTION

FUNCTION dbAbfName$(s AS JSON_HANDLE, a AS INTEGER) AS STRING
    RETURN JSON_GET_STRING(s, "abfragen." + STR$(a) + ".name")
END FUNCTION

FUNCTION dbAbfSql$(s AS JSON_HANDLE, a AS INTEGER) AS STRING
    RETURN JSON_GET_STRING(s, "abfragen." + STR$(a) + ".sql")
END FUNCTION

FUNCTION dbAbfIndex(s AS JSON_HANDLE, name AS STRING) AS INTEGER
    DIM a AS INTEGER
    FOR a = 0 TO dbAbfZahl(s) - 1
        IF LOWER$(dbAbfName$(s, a)) = LOWER$(name) THEN RETURN a
    NEXT
    RETURN -1
END FUNCTION

FUNCTION dbAbfrageNamen(e AS Element) AS ARRAY OF STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM aus AS ARRAY OF STRING : aus = []
    DIM a AS INTEGER
    FOR a = 0 TO dbAbfZahl(s) - 1
        ARRAY_PUSH(aus, dbAbfName$(s, a))
    NEXT
    RETURN aus
END FUNCTION

' Ein Name ist frei, wenn ihn weder eine Tabelle noch eine Abfrage traegt.
FUNCTION dbNameBelegt(s AS JSON_HANDLE, name AS STRING) AS BOOLEAN
    RETURN dbTabIndex(s, name) >= 0 OR dbAbfIndex(s, name) >= 0
END FUNCTION

' Fuehrt eine Abfrage auf der Entwicklungsdatei aus: "" = geht, sonst die
' Meldung. Fuellt dbErgSpalten und hoechstens `grenze` Zeilen in dbErgZellen.
FUNCTION dbAbfrageTesten$(e AS Element, sql AS STRING, grenze AS INTEGER) AS STRING
    dbErgSpalten = [] : dbErgZellen = [] : dbErgZeilen = 0
    DIM a AS STRING : a = UPPER$(LTRIM$(sql))
    IF LEFT$(a, 6) <> "SELECT" AND LEFT$(a, 4) <> "WITH" THEN RETURN tr$("Eine Abfrage beginnt mit SELECT (oder WITH).")
    DIM p AS STRING : p = dbPfad$(e)
    IF p = "" THEN RETURN ""
    DIM fehler AS STRING : fehler = ""
    DIM db AS DB_CONN
    TRY
        db = DB_OPEN(p)
        DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT * FROM (" + sql + ") AS studio_q LIMIT " + STR$(grenze))
        DIM i AS INTEGER
        FOR i = 0 TO DB_COL_COUNT(r) - 1
            ARRAY_PUSH(dbErgSpalten, DB_COL_NAME(r, i))
        NEXT
        WHILE DB_NEXT(r)
            dbErgZeilen = dbErgZeilen + 1
            FOR i = 0 TO LEN(dbErgSpalten) - 1
                ARRAY_PUSH(dbErgZellen, IIF(DB_IS_NULL(r, i), "", DB_GET_STRING(r, i)))
            NEXT
        WEND
    CATCH qfehler
        fehler = dbMeldung$(qfehler)
        fehler = dbOhneHuelle$(fehler)
    END TRY
    TRY
        DB_CLOSE(db)
    CATCH zfehler
    END TRY
    RETURN fehler
END FUNCTION

FUNCTION dbAbfrageNeu$(e AS Element, name AS STRING, sql AS STRING) AS STRING
    DIM f AS STRING : f = dbNameFehler$(name, "tabelle")
    IF f <> "" THEN RETURN f
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    IF dbNameBelegt(s, name) THEN RETURN trf$("Den Namen {0} gibt es in {1} schon.", [name, e.name])
    f = dbAbfrageTesten$(e, sql, 0)
    IF f <> "" THEN RETURN f
    IF NOT JSON_HAS(s, "abfragen") THEN JSON_SET_JSON(s, "abfragen", JSON_NEW_ARRAY())
    DIM o AS JSON_HANDLE : o = JSON_PARSE("{}")
    JSON_SET_STRING(o, "name", name)
    JSON_SET_STRING(o, "sql", sql)
    JSON_APPEND_JSON(s, "abfragen", o)
    e.schema = JSON_STRINGIFY(s)
    e.geaendert = TRUE
    RETURN ""
END FUNCTION

' Eine Abfrage aendern: nur, wenn sie an der Entwicklungsdatei geht.
FUNCTION dbAbfrageSetzen$(e AS Element, name AS STRING, sql AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM a AS INTEGER : a = dbAbfIndex(s, name)
    IF a < 0 THEN RETURN trf$("Die Abfrage {0} gibt es nicht.", [name])
    DIM f AS STRING : f = dbAbfrageTesten$(e, sql, 0)
    IF f <> "" THEN RETURN f
    JSON_SET_STRING(s, "abfragen." + STR$(a) + ".sql", sql)
    e.schema = JSON_STRINGIFY(s)
    e.geaendert = TRUE
    RETURN ""
END FUNCTION

FUNCTION dbAbfrageUmbenennen$(e AS Element, alt AS STRING, neu AS STRING) AS STRING
    IF alt = neu THEN RETURN ""
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM a AS INTEGER : a = dbAbfIndex(s, alt)
    IF a < 0 THEN RETURN trf$("Die Abfrage {0} gibt es nicht.", [alt])
    DIM f AS STRING : f = dbNameFehler$(neu, "tabelle")
    IF f <> "" THEN RETURN f
    IF LOWER$(alt) <> LOWER$(neu) AND dbNameBelegt(s, neu) THEN RETURN trf$("Den Namen {0} gibt es in {1} schon.", [neu, e.name])
    JSON_SET_STRING(s, "abfragen." + STR$(a) + ".name", neu)
    e.schema = JSON_STRINGIFY(s)
    e.geaendert = TRUE
    RETURN ""
END FUNCTION

FUNCTION dbAbfrageLoeschen$(e AS Element, name AS STRING) AS STRING
    DIM s AS JSON_HANDLE : s = dbSchema(e)
    DIM a AS INTEGER : a = dbAbfIndex(s, name)
    IF a < 0 THEN RETURN trf$("Die Abfrage {0} gibt es nicht.", [name])
    JSON_REMOVE(s, "abfragen." + STR$(a))
    e.schema = JSON_STRINGIFY(s)
    e.geaendert = TRUE
    RETURN ""
END FUNCTION
