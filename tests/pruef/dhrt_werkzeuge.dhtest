IMPORT "helfer.dh"
WRITEALL("ordner/eins/zwei/tief_pruefung.dh", !"ASSERT(1 + 1 = 2, \"Addition\")\n")
WRITEALL("ordner/normal.dh", !"PRINT \"kein Pruefprogramm\"\n")
dlStarten(["test", CWD$() + "/ordner"])
PRINT "rueckgabe "; dlCode
PRINT "eine datei "; (INSTR(dlAus, "1 Datei(en)") >= 0)
PRINT "ohne normal.dh "; (INSTR(dlAus, "normal.dh") < 0)
--- verzeichnis ordner/eins/zwei
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0
eine datei TRUE
ohne normal.dh TRUE

