{"datei":"daten.sqlite","tabellen":[{"name":"produkte","spalten":[{"name":"name","typ":"text","pflicht":false,"eindeutig":false,"vorgabe":""},{"name":"foto","typ":"bild","pflicht":false,"eindeutig":false,"vorgabe":""}]}]}
--- erwartet
ausgabe zellen 2 Tasse bilder 1
ausgabe laden TRUE 2 FALSE
ausgabe laden TRUE -1
ausgabe kein bild FALSE FALSE
ausgabe setzen TRUE 3 TRUE
ausgabe sichern TRUE FALSE bilder 2
ausgabe datei 70
ausgabe leeren TRUE TRUE
ausgabe null 1 bilder 1
ausgabe neu -1 FALSE
rot im bild TRUE

=== bild im daten-gitter setzen und eine bildspalte ins fenster legen
' Im Reiter der Datenbank: Daten, die Zelle foto der ersten Zeile, „Bild …“
' (die Datei kommt aus DH_STUDIO_DATEI). Danach ein Doppelklick auf die
' Spalte foto im Navigator (mit dem Fenster vorn): ein Bild-Control an der Bildspalte, ohne Bindung.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
DIM log AS STRING : log = CWD$() + "/s.log"
SETENV("DH_STUDIO_OEFFNEN", "Daten.produkte")
SETENV("DH_STUDIO_DATEI", CWD$() + "/blau.png")
slStarten(log, "", 12, p)
DIM x AS INTEGER
DIM y AS INTEGER
(x, y) = slLage(log, "db daten")
slHin(10, 10)
slWarten(14)
slKlick(x, y)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM cx AS INTEGER
DIM cy AS INTEGER
DIM bx AS INTEGER
DIM by AS INTEGER
DIM nx AS INTEGER
DIM ny AS INTEGER
(cx, cy) = slLage(log, "dbzelle da 0 2")
(bx, by) = slLage(log, "db bild")
(nx, ny) = slLage(log, "knoten Daten.produkte.foto")
DIM rx AS INTEGER
DIM ry AS INTEGER
(rx, ry) = slLage(log, "reiter 0")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(14)
slKlick(x, y)
slWarten(10)
slKlick(cx, cy)
slWarten(10)
slKlick(bx, by)
slWarten(10)
slKlick(rx, ry)
slWarten(10)
slKlick(nx, ny)
slWarten(3)
slKlick(nx, ny)
slWarten(10)
slMit([341], 83)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "db bild ")
    PRINT z
NEXT
FOR EACH z IN slAnfang(log, "felder ")
    PRINT z
NEXT
DIM db AS DB_CONN : db = DB_OPEN(p + "/daten.sqlite")
DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT length(foto) FROM produkte WHERE id = 1")
DB_NEXT(r)
PRINT "datei "; DB_GET_INT(r, 0)
DB_CLOSE(db)
DIM j AS JSON_HANDLE : j = JSON_LOAD(p + "/Hauptfenster.dhform")
PRINT "feld "; JSON_GET_STRING(j, "widgets.1.kind"); " "; JSON_GET_STRING(j, "widgets.1.name"); " "; JSON_GET_STRING(j, "widgets.1.studio_bildspalte"); " bind "; JSON_HAS(j, "widgets.1.bind")
--- argumente
{sammlung}/../../../studio/studio.dh
--- vorher
IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE produkte (id INTEGER PRIMARY KEY, name TEXT, foto BLOB)")
DB_EXEC(db, "INSERT INTO produkte (name) VALUES ('Tasse')")
DB_CLOSE(db)
