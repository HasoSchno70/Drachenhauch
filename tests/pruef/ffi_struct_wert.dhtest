' Structs als Wert an fremde Funktionen (docs/ffi.md, Abschnitt "Structs
' als Wert"; ffi.rs `plan`). BYVAL vor einem STRUCT ... LAYOUT C uebergibt
' ihn als Wert, eine Rueckgabe AS name liefert ihn als Wert. Wie jedes
' System ihn zerlegt, pruefen die Rust-Tests in ffi.rs gegen Funktionen mit
' der C-Aufrufkonvention; hier geht es um echte Bibliotheken.

=== teilen mit rest: div und lldiv liefern einen struct
' div_t hat 8 Bytes (ein Register), lldiv_t 16 -- unter Windows kommt er
' ueber eine versteckte Adresse zurueck, unter System V in RAX:RDX, auf ARM
' in X0:X1.
STRUCT DivT LAYOUT C
    quot AS LONG
    rest AS LONG
END STRUCT
STRUCT LLDivT LAYOUT C
    quot AS INTEGER
    rest AS INTEGER
END STRUCT
DECLARE FUNCTION div LIB "c" (a AS LONG, b AS LONG) AS DivT
DECLARE FUNCTION lldiv LIB "c" (a AS INTEGER, b AS INTEGER) AS LLDivT
DIM d AS DivT
d = div(17, 5)
PRINT d.quot, d.rest, TYPEOF(d), BUFFER_LEN(d)
d = div(-17, 5)
PRINT d.quot, d.rest
DIM e AS LLDivT
e = lldiv(10000000000123, 1000)
PRINT e.quot, e.rest
--- erwartet
3 2 BUFFER 8
-3 -2
10000000000 123

=== komplexe zahlen gehen als struct aus zwei kommazahlen
' C behandelt double complex wie einen Struct aus zwei Kommazahlen: unter
' System V in zwei SSE-Registern, auf ARM als HFA, unter Windows (16 Bytes)
' ueber einen Zeiger auf eine Kopie. float complex hat 8 Bytes: unter
' System V beide Teile in EINEM SSE-Register, unter Windows in einem
' Ganzzahl-Register.
STRUCT Komplex LAYOUT C
    re AS FLOAT
    im AS FLOAT
END STRUCT
STRUCT Komplex32 LAYOUT C
    re AS SINGLE
    im AS SINGLE
END STRUCT
DECLARE FUNCTION csqrt LIB "m" (BYVAL z AS Komplex) AS Komplex
DECLARE FUNCTION cabs LIB "m" (BYVAL z AS Komplex) AS FLOAT
DECLARE FUNCTION csqrtf LIB "m" (BYVAL z AS Komplex32) AS Komplex32
DECLARE FUNCTION cabsf LIB "m" (BYVAL z AS Komplex32) AS SINGLE
DIM z AS Komplex
z.re = -4
z.im = 0
DIM w AS Komplex
w = csqrt(z)
PRINT w.re, w.im
z.re = 3
z.im = -4
PRINT cabs(z)
w = csqrt(z)
PRINT w.re, w.im
' Die Funktion bekam eine Kopie -- z ist unveraendert.
PRINT z.re, z.im
DIM f AS Komplex32
f.re = -9
f.im = 0
DIM g AS Komplex32
g = csqrtf(f)
PRINT g.re, g.im
f.re = 6
f.im = 8
PRINT cabsf(f)
--- erwartet
0.0 2.0
5.0
2.0 -1.0
3.0 -4.0
0.0 3.0
10.0

=== windows: ein punkt als wert
' POINT hat 8 Bytes und geht in einem Register; das Rechteck geht wie
' bisher als Zeiger auf seine Bytes.
STRUCT POINT LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
STRUCT RECT LAYOUT C
    links AS LONG
    oben AS LONG
    rechts AS LONG
    unten AS LONG
END STRUCT
DECLARE FUNCTION PtInRect LIB "user32" (r AS RECT, BYVAL p AS POINT) AS BOOLEAN
DIM r AS RECT
r.links = 10
r.oben = 20
r.rechts = 110
r.unten = 70
DIM p AS POINT
p.x = 50
p.y = 30
PRINT PtInRect(r, p)
p.y = 70
PRINT PtInRect(r, p)
p.x = 9
p.y = 21
PRINT PtInRect(r, p)
--- system windows
--- erwartet
TRUE
FALSE
FALSE

=== macos: rechtecke aus core graphics
' CGRect sind vier Doubles (32 Bytes, eine HFA): als Argument in vier
' V-Registern, zwei davon fuellen alle acht; zurueck kommt er in V0..V3.
STRUCT CGPoint LAYOUT C
    x AS FLOAT
    y AS FLOAT
END STRUCT
STRUCT CGRect LAYOUT C
    x AS FLOAT
    y AS FLOAT
    b AS FLOAT
    h AS FLOAT
END STRUCT
CONST CG = "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics"
DECLARE FUNCTION CGRectUnion LIB CG (BYVAL a AS CGRect, BYVAL b AS CGRect) AS CGRect
DECLARE FUNCTION CGRectContainsPoint LIB CG (BYVAL r AS CGRect, BYVAL p AS CGPoint) AS BOOLEAN
DECLARE FUNCTION CGRectGetMidX LIB CG (BYVAL r AS CGRect) AS FLOAT
DIM a AS CGRect
a.x = 0 : a.y = 0 : a.b = 10 : a.h = 10
DIM b AS CGRect
b.x = 20 : b.y = 5 : b.b = 5 : b.h = 20
DIM u AS CGRect
u = CGRectUnion(a, b)
PRINT u.x, u.y, u.b, u.h
PRINT CGRectGetMidX(u)
DIM p AS CGPoint
p.x = 24 : p.y = 24
PRINT CGRectContainsPoint(u, p), CGRectContainsPoint(a, p)
--- system macos
--- erwartet
0.0 0.0 25.0 25.0
12.5
TRUE FALSE

=== was beim laufen nicht passt
STRUCT Komplex LAYOUT C
    re AS FLOAT
    im AS FLOAT
END STRUCT
DECLARE FUNCTION cabs LIB "m" (BYVAL z AS Komplex) AS FLOAT
DECLARE FUNCTION printf LIB "msvcrt|c" (f AS TEXT, BYVAL z AS Komplex, ...) AS LONG
TRY
    PRINT cabs(BUFFER_NEW(8))
CATCH e
    PRINT e
END TRY
DIM nix AS BUFFER
TRY
    PRINT cabs(nix)
CATCH e
    PRINT e
END TRY
DIM z AS Komplex
TRY
    PRINT printf("%d", z, 1)
CATCH e
    PRINT e
END TRY
--- erwartet
cabs: Argument 1 (z AS KOMPLEX): der Puffer ist 8 Bytes lang, der Struct braucht 16
cabs: Argument 1 (z AS KOMPLEX): der Struct ist NIL -- er bekommt seinen Speicher mit DIM
printf: ein Struct als Wert geht (noch) nicht in einer Funktion mit ... -- uebergib ihn dort als Zeiger (ohne BYVAL)

=== was nicht geht, sagt der uebersetzer
IMPORT "json"
DIM p AS INTEGER
SUB pruefe(text AS STRING)
    WRITEALL("probe.dh", text)
    p = PROCESS_START("dhrt", "--check", "probe.dh")
    DIM aus AS STRING
    DIM leer AS INTEGER
    WHILE leer < 5
        DIM z AS STRING
        z = PROCESS_READ$(p)
        IF z = "" THEN
            IF NOT PROCESS_RUNNING(p) THEN leer = leer + 1
            SLEEP(30)
        ELSE
            aus = aus + z
        END IF
    WEND
    DIM j AS JSON_HANDLE
    j = JSON_PARSE("{" + CHR$(34) + "m" + CHR$(34) + ":" + aus + "}")
    IF JSON_LEN(j, "m") = 0 THEN
        PRINT "ok"
    ELSE
        PRINT JSON_GET_STRING(j, "m.0.message")
    END IF
END SUB
DIM nl AS STRING
nl = CHR$(10)
DIM q AS STRING
q = CHR$(34)
DIM kopf AS STRING
kopf = "STRUCT Punkt LAYOUT C" + nl + "  x AS LONG" + nl + "  y AS LONG" + nl + "END STRUCT" + nl
pruefe(kopf + "DECLARE FUNCTION f LIB " + q + "c" + q + " (BYVAL p AS Punkt) AS Punkt")
pruefe(kopf + "DECLARE FUNCTION f LIB " + q + "c" + q + " (BYVAL p AS Gibts) AS LONG")
pruefe(kopf + "DECLARE FUNCTION f LIB " + q + "c" + q + " (p AS LONG) AS Gibts")
pruefe(kopf + "DECLARE SUB f LIB " + q + "c" + q + " (r AS FUNCTION(p AS Punkt) AS LONG)")
pruefe(kopf + "DECLARE FUNCTION f LIB " + q + "c" + q + " (BYVAL p AS Punkt) AS LONG" + nl + "PRINT f(" + q + "x" + q + ")")
--- erwartet
ok
'GIBTS' ist kein Typ fuer fremde Bibliotheken (moeglich: ein STRUCT ... LAYOUT C oder BYTE, UBYTE, SHORT, USHORT, LONG, ULONG, INTEGER, ZEIGER, SINGLE, FLOAT, BOOLEAN, TEXT, WTEXT, BUFFER)
'GIBTS' ist kein Typ fuer fremde Bibliotheken (moeglich: ein STRUCT ... LAYOUT C oder BYTE, UBYTE, SHORT, USHORT, LONG, ULONG, INTEGER, ZEIGER, SINGLE, FLOAT, BOOLEAN, TEXT, WTEXT, BUFFER)
'PUNKT' ist kein Typ fuer fremde Bibliotheken (moeglich: BYTE, UBYTE, SHORT, USHORT, LONG, ULONG, INTEGER, ZEIGER, SINGLE, FLOAT, BOOLEAN, TEXT, WTEXT, BUFFER) -- ein Struct geht in einem Rueckruf (noch) nicht: einen Zeiger darauf bekommt er als ZEIGER, BUFFER_AUS_ZEIGER liest ihn
f: Argument 1 (p AS PUNKT) bekommt STRING -- beim Laufen bricht diese Zeile ab
