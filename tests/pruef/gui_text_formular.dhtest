=== enter meldet sich ein bild lang und ruft den handler
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
SUB fertig()
    PRINT "handler"
END SUB
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
GUI_FOCUS(tf)
GUI_ON_ENTER(tf, fertig)
DIM f AS INTEGER
FOR f = 1 TO 10
    GUI_UPDATE()
    GUI_DRAW()
    IF GUI_ENTERED(tf) THEN PRINT "enter " + STR$(f)
    FLIP()
NEXT
--- datei ev.txt
# Test-Aufnahme
c 2
e 4 2 257 0 0 0 // Event: test
e 5 1 257 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=12
--- erwartet
handler
enter 2

=== strg z nimmt einen schritt zurueck und strg y holt ihn
' Zwei Einfuegungen mehr als 0,8 s auseinander sind zwei Schritte.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
GUI_FOCUS(tf)
CLIPBOARD_SET("ab")
DIM f AS INTEGER
FOR f = 1 TO 120
    GUI_UPDATE()
    GUI_DRAW()
    IF f = 85 OR f = 95 OR f = 105 OR f = 115 THEN PRINT "[" + GUI_TEXT(tf) + "]"
    FLIP()
NEXT
