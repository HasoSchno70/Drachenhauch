' ======================================================================
'  G A M E   B A S I C   --   D E M O
' ======================================================================
'
'  Eine Demo im Sinne der Demoszene: ein durchlaufendes Stueck, das Szene
'  fuer Szene zeigt, was die Laufzeit kann -- und dabei auf die Musik
'  reagiert statt bloss daneben zu laufen.
'
'  Zwei Bausteine tragen das Ganze:
'
'    AUDIO_FFT              greift das echte Spektrum vom Master ab. Alles,
'                           was hier pulsiert, pulsiert auf dem tatsaechlich
'                           hoerbaren Mix -- nicht auf einem nachgebauten
'                           Zaehler.
'    AUDIO_MUSIC_POSITION   liefert die Sekunde IM STUECK. Daran haengt der
'                           Ablaufplan, nicht an der Wanduhr: bricht die
'                           Bildrate ein, verrutschen die Szenen trotzdem
'                           nicht gegen die Musik.
'
'  Musik: "Stardust Jam" von Drozerix, gemeinfrei (The Mod Archive).
'  Ein echtes ProTracker-Modul, in Echtzeit gestreamt -- kein OGG.
'
'  Steuerung:  LEER = Szene weiter    F11 = Vollbild    ESC = Ende
'
'  Start:  dhrun.py gbdemo\gbdemo.dh
' ======================================================================

IMPORT "audio"
IMPORT "m3d"
IMPORT "g3d"
IMPORT "particles"
IMPORT "physics2d"
IMPORT "timer"

CONST BREITE AS INTEGER = 1280
CONST HOEHE AS INTEGER = 720
CONST MUSIK AS STRING = "assets/music/stardust_jam.mod"
' Alle acht liegen bei und sind gemeinfrei -- M schaltet im Betrieb um.
CONST STUECKE AS INTEGER = 8
CONST BAENDER AS INTEGER = 32

' Szenen-Grenzen in Sekunden des Stuecks (Stardust Jam laeuft ~6:24).
CONST T1 AS FLOAT = 42.0        ' Titel
CONST T2 AS FLOAT = 84.0        ' Sternenfeld
CONST T3 AS FLOAT = 128.0       ' Instancing
CONST T4 AS FLOAT = 172.0       ' PBR + HDR
CONST T5 AS FLOAT = 214.0       ' Physik
CONST T6 AS FLOAT = 256.0       ' Tunnel
CONST T7 AS FLOAT = 300.0       ' Audio-Effekte
CONST T8 AS FLOAT = 384.0       ' Abspann

SCREEN(BREITE, HOEHE, "Drachenhauch -- Demo", 1)
SETFPS(60)
WINDOW_ESC_QUIT(FALSE)
' Vollbild von Anfang an -- eine Demo schaut man nicht im Fenster an.
' Gezeichnet wird weiter in 1280x720; die Laufzeit skaliert ganzzahlig auf
' den Bildschirm (auf 2560x1440 also exakt 2x, ohne Unschaerfe). F11 schaltet
' zurueck, falls doch ein Fenster gebraucht wird.
SET_FULLSCREEN(TRUE)

' ----------------------------------------------------------------------
'  Globaler Zustand
' ----------------------------------------------------------------------
DIM fnt AS INTEGER
fnt = LOADFONT("assets/font.ttf", 48)
SETFONT(fnt)

DIM sh AS INTEGER
sh = SHADER_LOAD("assets/shaders/demo.fs")
SHADER_SET2(sh, "resolution", BREITE, HOEHE)

DIM spek[BAENDER] AS FLOAT      ' rohes Spektrum dieses Bildes
DIM glatt[BAENDER] AS FLOAT     ' nachfallend geglaettet (ruhigere Optik)
DIM bass AS FLOAT               ' 0..1, unteres Drittel
DIM mitten AS FLOAT
DIM hoehen AS FLOAT
DIM bass_lang AS FLOAT          ' langsamer Mittelwert -> Bezug fuer den Beat
DIM beat AS BOOLEAN             ' schlaegt dieses Bild ein Schlag ein?
DIM beat_alter AS FLOAT         ' Sekunden seit dem letzten Schlag

DIM zeit AS FLOAT               ' Sekunde im Stueck (= Ablaufplan)
DIM dt AS FLOAT
DIM szene AS INTEGER
DIM szene_t AS FLOAT            ' Sekunden IN der laufenden Szene
DIM szene_p AS FLOAT            ' 0..1 Fortschritt in der Szene
DIM versatz AS FLOAT            ' manuelles Vorspulen (Leertaste)
DIM modus AS FLOAT              ' Post-Effekt-Modus (siehe demo.fs)
DIM blende AS FLOAT             ' 1 = sichtbar, 0 = schwarz
DIM gestapelt AS BOOLEAN        ' liegt ein Szenen-Zustand auf den Stapeln?

DIM i AS INTEGER
FOR i = 0 TO BAENDER - 1
    glatt[i] = 0.0
NEXT

' ----------------------------------------------------------------------
'  Werkzeug
' ----------------------------------------------------------------------

' Text mittig auf (cx, cy), Groesse ueber die Skalierung.
SUB mtext(cx AS INTEGER, cy AS INTEGER, s AS STRING, skala AS FLOAT, farbe AS INTEGER)
    TEXTROT(cx, cy, s, 0, skala, farbe)
END SUB

' Kurzer Ruettler im Gamepad -- nur wenn ueberhaupt eins angeschlossen ist,
' sonst meldet JOYSTICK_RUMBLE einen ungueltigen Index. Dauer in SEKUNDEN.
SUB rumble(staerke AS FLOAT, dauer_s AS FLOAT)
    IF JOYSTICK_COUNT() > 0 THEN JOYSTICK_RUMBLE(0, staerke, staerke, dauer_s)
END SUB

' Farbe aus HSV-artigem Umlauf -- spart Paletten-Tabellen.
FUNCTION regenbogen(phase AS FLOAT, helligkeit AS FLOAT) AS INTEGER
    DIM r AS INTEGER
    DIM g AS INTEGER
    DIM b AS INTEGER
    r = INT((0.5 + 0.5 * SIN(phase)) * 255.0 * helligkeit)
    g = INT((0.5 + 0.5 * SIN(phase + 2.09)) * 255.0 * helligkeit)
    b = INT((0.5 + 0.5 * SIN(phase + 4.19)) * 255.0 * helligkeit)
    IF r < 0 THEN r = 0
    IF g < 0 THEN g = 0
    IF b < 0 THEN b = 0
    IF r > 255 THEN r = 255
    IF g > 255 THEN g = 255
    IF b > 255 THEN b = 255
    RETURN RGB(r, g, b)
END FUNCTION

' Eine Farbe abdunkeln (0 = schwarz, 1 = unveraendert).
FUNCTION dunkler(c AS INTEGER, f AS FLOAT) AS INTEGER
    RETURN RGB(INT(((c SHR 16) BAND 255) * f), _
               INT(((c SHR 8) BAND 255) * f), _
               INT((c BAND 255) * f))
END FUNCTION

' Weicher Ein-/Ausblender am Rand einer Szene.
FUNCTION randblende(t AS FLOAT, dauer AS FLOAT, rand AS FLOAT) AS FLOAT
    DIM v AS FLOAT
    v = 1.0
    IF t < rand THEN v = t / rand
    IF t > dauer - rand THEN v = (dauer - t) / rand
    ' Begrenzen: ohne das wird der Wert beim Ueberlaufen negativ, und der
    ' Shader multipliziert die Farbe mit einer negativen Zahl.
    IF v < 0.0 THEN v = 0.0
    IF v > 1.0 THEN v = 1.0
    RETURN v
END FUNCTION

' Spektrum lesen und in bass/mitten/hoehen zusammenfassen.
'
' Zwei Wege, absichtlich getrennt:
'   glatt[]  haelt Spitzen und faellt langsam nach -- ruhige Saeulen, schoene
'            Optik, aber TRAEGE.
'   roh_*    ist das ungeglaettete Bild dieses Augenblicks.
' Der Schlag muss aus den ROHEN Werten kommen. Auf den geglaetteten liegt er
' dauerhaft dicht an seinem eigenen Mittel und schlaegt nie an -- genau das
' war hier zuerst der Fehler.
SUB spektrum_lesen()
    AUDIO_FFT(spek)
    DIM k AS INTEGER
    DIM rb AS FLOAT
    DIM rm AS FLOAT
    DIM rh AS FLOAT
    rb = 0.0
    rm = 0.0
    rh = 0.0
    FOR k = 0 TO BAENDER - 1
        IF spek[k] > glatt[k] THEN
            glatt[k] = spek[k]
        ELSE
            glatt[k] = glatt[k] * 0.86 + spek[k] * 0.14
        END IF
        IF k < 6 THEN
            rb = rb + spek[k]
        ELSEIF k < 16 THEN
            rm = rm + spek[k]
        ELSE
            rh = rh + spek[k]
        END IF
    NEXT
    rb = rb / 6.0
    rm = rm / 10.0
    rh = rh / 16.0

    ' Leicht geglaettet fuers Bild -- gerade so viel, dass nichts flackert.
    bass = bass * 0.55 + rb * 0.45
    mitten = mitten * 0.55 + rm * 0.45
    hoehen = hoehen * 0.55 + rh * 0.45
    IF bass > 1.0 THEN bass = 1.0
    IF mitten > 1.0 THEN mitten = 1.0
    IF hoehen > 1.0 THEN hoehen = 1.0

    ' Schlag = roher Bass deutlich ueber seinem eigenen gleitenden Mittel,
    ' mit Sperrzeit gegen Doppelausloesung.
    bass_lang = bass_lang * 0.94 + rb * 0.06
    beat = FALSE
    IF rb > bass_lang * 1.18 AND rb > 0.12 THEN
        IF COOLDOWN("beat", 170) THEN
            beat = TRUE
            beat_alter = 0.0
        END IF
    END IF
    beat_alter = beat_alter + dt
END SUB

' ----------------------------------------------------------------------
'  SZENE 1 -- Titel: Plasma, Logo, Sinus-Scroller
' ----------------------------------------------------------------------
CONST SCROLLTEXT AS STRING = "GAME BASIC GRUESST DIE WELT ...   EIN BASIC MIT PASCAL-STRENGER TYPISIERUNG UND OOP, GEBAUT FUER SPIELE ...   ALLES, WAS DU HIER SIEHST UND HOERST, LAEUFT IN EINER EINZIGEN LAUFZEIT: DHRT, IN RUST GESCHRIEBEN, MIT RAYLIB UND KIRA ...   DIE MUSIK IST EIN ECHTES PROTRACKER-MODUL, IN ECHTZEIT GESTREAMT ...   UND DAS BILD TANZT AUF DEM ECHTEN SPEKTRUM, NICHT AUF EINEM ZAEHLER ...   VIEL SPASS!        "

SUB szene_titel()
    modus = 1.0                     ' Plasma-Hintergrund im Post-Effekt

    ' --- Logo, auf dem Schlag kurz groesser ---
    DIM puls AS FLOAT
    puls = 1.0 + 0.10 * EXP(-beat_alter * 6.0) + 0.05 * bass
    DIM cy AS INTEGER
    cy = INT(HOEHE * 0.34)
    DIM s AS STRING
    s = "DRACHENHAUCH"
    DIM n AS INTEGER
    n = LEN(s)
    DIM breite_ges AS FLOAT
    breite_ges = n * 62.0 * puls
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        DIM x AS INTEGER
        x = INT(BREITE / 2 - breite_ges / 2 + (k + 0.5) * 62.0 * puls)
        DIM y AS INTEGER
        y = cy + INT(SIN(zeit * 2.2 + k * 0.55) * 16.0)
        mtext(x, y, MID$(s, k, 1), 1.5 * puls, regenbogen(zeit * 1.1 + k * 0.35, 1.0))
    NEXT

    mtext(BREITE \ 2, cy + 78, "eine demo", 0.62, RGB(150, 200, 230))

    ' --- Spektrum als Saeulenpaar, gespiegelt ---
    DIM bw AS INTEGER
    bw = BREITE \ BAENDER
    FOR k = 0 TO BAENDER - 1
        DIM h AS INTEGER
        h = INT(glatt[k] * HOEHE * 0.20)
        DIM c AS INTEGER
        c = regenbogen(k * 0.19 + zeit * 0.7, 0.55 + 0.45 * glatt[k])
        BOX(k * bw + 2, HOEHE - h, k * bw + bw - 2, HOEHE, c)
        BOX(k * bw + 2, 0, k * bw + bw - 2, h \ 2, c)
    NEXT

    ' --- Sinus-Scroller ---
    DIM sx AS FLOAT
    sx = BREITE - (zeit - 2.0) * 210.0
    DIM zeichen AS INTEGER
    zeichen = LEN(SCROLLTEXT)
    FOR k = 0 TO zeichen - 1
        DIM px AS FLOAT
        px = sx + k * 26.0
        IF px > -40.0 AND px < BREITE + 40.0 THEN
            DIM py AS FLOAT
            py = HOEHE * 0.68 + SIN(px * 0.012 + zeit * 2.0) * 42.0
            mtext(INT(px), INT(py), MID$(SCROLLTEXT, k, 1), 0.72, _
                  regenbogen(px * 0.01 + zeit, 1.0))
        END IF
    NEXT
END SUB

' ----------------------------------------------------------------------
'  SZENE 2 -- Sternenflug: Streifen statt Punkte
' ----------------------------------------------------------------------
' Jeder Stern wird ZWEIMAL projiziert: an seiner Position vor diesem Bild
' und an seiner jetzigen. Die Strecke dazwischen ist der Streifen -- je
' schneller (also je mehr Bass), desto laenger. Gezeichnet wird alles mit
' EINEM LINES-Aufruf.
'
' Achtung, echte Falle: LINES und PLOTS nehmen KEINE Stueckzahl entgegen --
' sie zeichnen immer das GANZE Array. Unbenutzte Plaetze muessen also aus
' dem Bild geschoben werden (-10), sonst bleiben alte Werte stehen.
CONST STERNE AS INTEGER = 1400

DIM stx[STERNE] AS FLOAT
DIM sty[STERNE] AS FLOAT
DIM stz[STERNE] AS FLOAT
DIM lx1[STERNE] AS INTEGER
DIM ly1[STERNE] AS INTEGER
DIM lx2[STERNE] AS INTEGER
DIM ly2[STERNE] AS INTEGER
DIM lc[STERNE] AS INTEGER
DIM sterne_bereit AS BOOLEAN
DIM glow AS IMAGE
DIM psys AS PARTICLE_SYSTEM

SUB sterne_setzen()
    DIM k AS INTEGER
    FOR k = 0 TO STERNE - 1
        stx[k] = RND() * 2.0 - 1.0
        sty[k] = RND() * 2.0 - 1.0
        stz[k] = RND() * 0.98 + 0.02
    NEXT
    sterne_bereit = TRUE
END SUB

SUB szene_sterne()
    modus = 0.0
    IF NOT sterne_bereit THEN sterne_setzen()

    DIM tempo AS FLOAT
    tempo = (0.30 + bass * 2.4) * dt
    DIM k AS INTEGER
    FOR k = 0 TO STERNE - 1
        DIM z_vor AS FLOAT
        z_vor = stz[k]
        stz[k] = stz[k] - tempo
        IF stz[k] <= 0.04 THEN
            stx[k] = RND() * 2.0 - 1.0
            sty[k] = RND() * 2.0 - 1.0
            stz[k] = 1.0
            z_vor = 1.0
        END IF

        ' Zentralprojektion: naeher am Auge = weiter aussen.
        DIM ax AS FLOAT
        DIM ay AS FLOAT
        DIM bx AS FLOAT
        DIM by AS FLOAT
        ax = BREITE / 2.0 + stx[k] / z_vor * BREITE * 0.46
        ay = HOEHE / 2.0 + sty[k] / z_vor * HOEHE * 0.46
        bx = BREITE / 2.0 + stx[k] / stz[k] * BREITE * 0.46
        by = HOEHE / 2.0 + sty[k] / stz[k] * HOEHE * 0.46

        IF bx > -60.0 AND bx < BREITE + 60.0 AND by > -60.0 AND by < HOEHE + 60.0 THEN
            lx1[k] = INT(ax)
            ly1[k] = INT(ay)
            lx2[k] = INT(bx)
            ly2[k] = INT(by)
            ' Naehe bestimmt die Helligkeit: hinten blaugrau, vorne weiss.
            DIM naehe AS FLOAT
            naehe = 1.0 - stz[k]
            DIM w AS INTEGER
            w = INT(70.0 + 185.0 * naehe * naehe)
            lc[k] = RGB(INT(w * 0.72 + 40.0 * hoehen), INT(w * 0.85), 255 - INT(30.0 * naehe))
        ELSE
            lx1[k] = -10
            ly1[k] = -10
            lx2[k] = -10
            ly2[k] = -10
            lc[k] = 0
        END IF
    NEXT

    BLEND_MODE("add")
    LINES(lx1, ly1, lx2, ly2, lc)

    ' --- Glut auf den Schlag ---
    IF beat THEN
        PARTICLE_SET_POS(psys, BREITE \ 2, HOEHE \ 2)
        PARTICLE_SET_COLOR(psys, regenbogen(zeit * 2.0, 1.0))
        PARTICLE_SET_COLOR_END(psys, RGB(30, 0, 70))
        PARTICLE_EMIT(psys, 120)
    END IF
    PARTICLE_UPDATE(psys, dt * 1000.0)
    PARTICLE_DRAW(psys)

    ' Kern, der auf dem Bass atmet
    DIM r AS FLOAT
    r = 0.35 + 1.5 * bass
    DRAWIMAGEROT(glow, BREITE \ 2, HOEHE \ 2, zeit * 20.0, r, regenbogen(zeit * 0.8, 0.9))
    BLEND_MODE("alpha")

    mtext(BREITE \ 2, HOEHE - 54, "LINES  -  " + STR$(STERNE) + " Streifen in EINEM Aufruf", 0.5, RGB(140, 180, 210))
END SUB

' ----------------------------------------------------------------------
'  SZENE 3 -- GPU-Instancing: ein Wuerfelfeld tanzt auf dem Spektrum
' ----------------------------------------------------------------------
CONST GITTER AS INTEGER = 40
CONST WUERFEL AS INTEGER = GITTER * GITTER

DIM mesh_box AS INTEGER
' Eine Matrix-Liste und eine Farb-Liste. MODEL_INSTANCED gruppiert selbst
' nach Farben -- der Instancing-Shader kennt nur EINE Farbe je Draw-Call
' (raylibs DrawMeshInstanced uebertraegt nur Matrizen), also wird daraus
' ein Draw-Call je VERSCHIEDENER Farbe. Hier: drei.
DIM mats[WUERFEL] AS MAT4
DIM mcol[WUERFEL] AS INTEGER

SUB szene_instancing()
    modus = 0.0
    DIM w AS FLOAT
    w = zeit * 0.20
    CAMERA3D(SIN(w) * 52.0, 30.0 + SIN(zeit * 0.35) * 9.0, COS(w) * 52.0, 0, 2, 0, 50)

    ' Nah beieinander liegende Phasen -> verwandte Farben. Ein Abstand von
    ' 2.1 waere reines Rot/Gruen/Blau und sieht nach Testbild aus.
    DIM c0 AS INTEGER
    DIM c1 AS INTEGER
    DIM c2 AS INTEGER
    c0 = regenbogen(zeit * 0.5, 1.0)
    c1 = regenbogen(zeit * 0.5 + 0.8, 1.0)
    c2 = regenbogen(zeit * 0.5 + 1.6, 1.0)

    DIM gx AS INTEGER
    DIM gz AS INTEGER
    DIM idx AS INTEGER
    idx = 0
    FOR gx = 0 TO GITTER - 1
        FOR gz = 0 TO GITTER - 1
            DIM wx AS FLOAT
            DIM wz AS FLOAT
            wx = (gx - GITTER / 2) * 1.5
            wz = (gz - GITTER / 2) * 1.5
            ' Der Abstand zur Mitte waehlt das Frequenzband -- so laeuft die
            ' Welle von innen nach aussen mit der Musik.
            DIM ring AS INTEGER
            ring = INT(SQR(wx * wx + wz * wz) * 0.55) MOD BAENDER
            DIM hoch AS FLOAT
            hoch = glatt[ring] * 18.0 + SIN(zeit * 1.6 + gx * 0.3 + gz * 0.3) * 0.9
            mats[idx] = MAT4_MUL(MAT4_TRANSLATE(wx, hoch, wz), _
                                 QUAT_TO_MAT4(QUAT_FROM_AXIS_ANGLE(0, 1, 0, zeit * 0.8 + ring * 0.4)))
            IF ring MOD 3 = 0 THEN
                mcol[idx] = c0
            ELSEIF ring MOD 3 = 1 THEN
                mcol[idx] = c1
            ELSE
                mcol[idx] = c2
            END IF
            idx = idx + 1
        NEXT
    NEXT

    MODEL_INSTANCED(mesh_box, mats, mcol, idx)

    mtext(BREITE \ 2, HOEHE - 54, _
          "MODEL_INSTANCED  -  " + STR$(WUERFEL) + " Wuerfel, 3 Farben, 3 Draw-Calls", _
          0.5, RGB(140, 180, 210))
END SUB

' ----------------------------------------------------------------------
'  SZENE 4 -- PBR unter echtem HDR-Himmel, mit Schatten
' ----------------------------------------------------------------------
' Hier zeigt die Laufzeit ihre schwerste Artillerie auf einmal: ein echtes
' HDR-Panorama als Umgebungslicht (LIGHT_ENV_HDR berechnet daraus einmalig
' Irradiance-, Prefilter- und BRDF-Maps), dieselbe Umgebung als sichtbarer
' Hintergrund (SKYBOX), Cook-Torrance-Material je Modell (MODEL_PBR) und
' Schattenwurf aus dem Sonnenlicht (SHADOW_*).
'
' Die Kugeln stehen im Ring von SPIEGELND bis MATT -- an ihnen sieht man den
' Unterschied, den die Rauheit macht, besser als an jedem Text.
CONST N_KUGELN AS INTEGER = 9

DIM kugeln[N_KUGELN] AS INTEGER
DIM boden AS INTEGER
DIM kern AS INTEGER
DIM hdr_da AS BOOLEAN

SUB szene_pbr()
    modus = 0.0

    DIM w AS FLOAT
    w = zeit * 0.22
    CAMERA3D(SIN(w) * 10.5, 3.4 + SIN(zeit * 0.45) * 1.4, COS(w) * 10.5, 0, 1.2, 0, 50)
    SHADOW_TARGET(0, 1, 0)

    ' Farbe aus dem Panorama gemessen (Mittelwert des Gelaendes direkt
    ' unter dem Horizont): ein warmes Braungrau.
    MODEL(boden, 0, -1.4, 0, 1.0, &H87735A)

    ' Ring aus Metallkugeln -- jede haengt an ihrem eigenen Frequenzband.
    DIM k AS INTEGER
    FOR k = 0 TO N_KUGELN - 1
        DIM a AS FLOAT
        a = k * 6.28318 / N_KUGELN + zeit * 0.30
        DIM bnd AS INTEGER
        bnd = 3 + k * 3
        ' NICHT "hoehe" nennen: Drachenhauch ignoriert Gross-/Kleinschreibung,
        ' eine lokale "hoehe" verdeckt also die Konstante HOEHE -- und aus
        ' HOEHE - 54 wird lautlos 0.6 - 54.
        DIM hoch AS FLOAT
        hoch = 0.6 + glatt[bnd] * 3.4
        MODEL(kugeln[k], COS(a) * 4.6, hoch, SIN(a) * 4.6, 1.0, &HDCE0E8)
    NEXT

    ' Kern in der Mitte: leuchtet aus sich selbst heraus, auf dem Bass.
    ' MODEL_EMISSIVE schlaegt durch den Fog und wird vom Bloom im Post-Effekt
    ' zum echten Glimmen -- deshalb steht hier keine zusaetzliche Grafik.
    DIM kernfarbe AS INTEGER
    kernfarbe = regenbogen(zeit * 0.7, 1.0)
    ' Zurueckhaltend dosieren: der Bloom im Post-Effekt legt noch einmal drauf,
    ' und ab etwa 1.5 ist von der Farbe nur noch eine weisse Scheibe uebrig.
    MODEL_EMISSIVE(kern, kernfarbe, 0.25 + 1.1 * bass)
    MODEL(kern, 0, 1.6 + SIN(zeit * 1.3) * 0.35, 0, 0.75 + 0.4 * bass, kernfarbe)

    DIM hinweis AS STRING
    IF hdr_da THEN
        hinweis = "MODEL_PBR + LIGHT_ENV_HDR + SKYBOX + SHADOW  -  spiegelnd bis matt"
    ELSE
        hinweis = "MODEL_PBR + LIGHT_ENV (kein .hdr gefunden)  -  spiegelnd bis matt"
    END IF
    mtext(BREITE \ 2, HOEHE - 54, hinweis, 0.46, RGB(140, 180, 210))
END SUB

' ----------------------------------------------------------------------
'  SZENE 5 -- Physik: das Logo faellt in sich zusammen
' ----------------------------------------------------------------------
' physics2d ist KEINE Kollisions-Mathematik, sondern ein echter
' Starrkoerper-Solver (Rapier2D): Schwerkraft, Stapeln, Reibung, Abprallen
' rechnet die Laufzeit. Die Demo baut nur die Kloetze auf und schaut zu.
'
' Die Buchstaben stehen als Muster da -- ein '#' wird ein Klotz. So laesst
' sich das Logo aendern, ohne eine einzige Koordinate anzufassen.
CONST KLOTZ AS INTEGER = 26          ' Kantenlaenge eines Klotzes in Pixeln
CONST MAXK AS INTEGER = 460
CONST LOGO_ZEILEN AS INTEGER = 7

DIM logo_g[LOGO_ZEILEN] AS STRING
DIM logo_b[LOGO_ZEILEN] AS STRING

DIM welt AS PHYS2D_WORLD
DIM kid[MAXK] AS INTEGER             ' Koerper-Nummern in der Welt
DIM kfarbe[MAXK] AS INTEGER
DIM ist_kugel[MAXK] AS BOOLEAN
DIM ist_regen[MAXK] AS BOOLEAN       ' Hintergrund-Truemmer (kleiner, dunkler)
DIM nk AS INTEGER
DIM naechster_aufbau AS FLOAT
DIM aufbau_zeit AS FLOAT
DIM n_logo AS INTEGER                ' wie viele Koerper zum Logo gehoeren
' Jeder Buchstabe wird EINZELN umgeworfen. Vorher kippte ein Treffer das
' ganze Logo um -- auch das B, das gar niemand angefasst hatte.
CONST BUCHSTABEN AS INTEGER = 2
DIM steht[BUCHSTABEN] AS BOOLEAN     ' steht dieser Buchstabe noch?
DIM bu_x0[BUCHSTABEN] AS INTEGER     ' seine Ausdehnung (fuer den Einschlag)
DIM bu_x1[BUCHSTABEN] AS INTEGER
DIM kbuchstabe[MAXK] AS INTEGER      ' zu welchem Buchstaben gehoert der Koerper?
DIM logo_y0 AS INTEGER
DIM weiss AS IMAGE
DIM welt_bereit AS BOOLEAN
DIM funken AS PARTICLE_SYSTEM        ' Einschlag-Funken
DIM ruckeln AS FLOAT                 ' Erschuetterung nach einem Einschlag

' Eine Buchstaben-Schablone in Kloetze uebersetzen.
SUB logo_setzen(muster AS ARRAY OF STRING, x0 AS INTEGER, y0 AS INTEGER, _
                farbe AS INTEGER, nummer AS INTEGER)
    DIM erster AS BOOLEAN
    erster = TRUE
    DIM r AS INTEGER
    FOR r = 0 TO LOGO_ZEILEN - 1
        DIM zeile AS STRING
        zeile = muster[r]
        DIM c AS INTEGER
        FOR c = 0 TO LEN(zeile) - 1
            IF MID$(zeile, c, 1) = "#" AND nk < MAXK THEN
                ' Ausdehnung mitfuehren statt sie zu schaetzen -- der
                ' Einschlag-Bereich unten haengt daran, und der soll auch
                ' stimmen, wenn jemand die Buchstaben aendert.
                DIM bx AS INTEGER
                bx = x0 + c * KLOTZ
                IF erster OR bx < bu_x0[nummer] THEN bu_x0[nummer] = bx
                IF erster OR bx > bu_x1[nummer] THEN bu_x1[nummer] = bx
                erster = FALSE
                ' Erst einmal STATISCH: sonst faellt der Querbalken des G in
                ' dem Moment herunter, in dem die Szene beginnt -- man saehe
                ' das Logo nie. Umgekippt wird es unten auf den Einschlag.
                kid[nk] = PHYS2D_ADD_BOX(welt, x0 + c * KLOTZ, y0 + r * KLOTZ, _
                                         KLOTZ / 2 - 1, KLOTZ / 2 - 1, FALSE, 0.05)
                kfarbe[nk] = farbe
                ist_kugel[nk] = FALSE
                ist_regen[nk] = FALSE
                kbuchstabe[nk] = nummer
                nk = nk + 1
            END IF
        NEXT
    NEXT
END SUB

SUB physik_aufbauen()
    ' Eine frische Welt ist der einfachste Weg zurueck auf Anfang -- die alte
    ' gibt die Laufzeit selbst frei.
    welt = PHYS2D_NEW()
    PHYS2D_SET_GRAVITY(welt, 0.0, 1600.0)
    nk = 0

    ' Boden und zwei Waende, statisch (dynamic = FALSE).
    PHYS2D_ADD_BOX(welt, BREITE \ 2, HOEHE - 20, BREITE \ 2, 20, FALSE, 0.1)
    PHYS2D_ADD_BOX(welt, -20, HOEHE \ 2, 20, HOEHE, FALSE, 0.1)
    PHYS2D_ADD_BOX(welt, BREITE + 20, HOEHE \ 2, 20, HOEHE, FALSE, 0.1)

    DIM y0 AS INTEGER
    y0 = HOEHE - 60 - LOGO_ZEILEN * KLOTZ
    logo_setzen(logo_g, BREITE \ 2 - 6 * KLOTZ, y0, RGB(90, 220, 210), 0)
    logo_setzen(logo_b, BREITE \ 2 + 1 * KLOTZ, y0, RGB(230, 110, 190), 1)
    n_logo = nk
    ' Halbe Klotzbreite plus Kugelradius Toleranz -- so loest der Einschlag
    ' genau dann aus, wenn die Kugel die aeusserste Saeule beruehrt.
    DIM bi AS INTEGER
    FOR bi = 0 TO BUCHSTABEN - 1
        bu_x0[bi] = bu_x0[bi] - KLOTZ \ 2 - 16
        bu_x1[bi] = bu_x1[bi] + KLOTZ \ 2 + 16
        steht[bi] = TRUE
    NEXT
    logo_y0 = y0 - KLOTZ
    welt_bereit = TRUE
END SUB

' Nur die Kloetze EINES Buchstabens beweglich machen.
SUB logo_umkippen(nummer AS INTEGER)
    DIM k AS INTEGER
    FOR k = 0 TO n_logo - 1
        IF kbuchstabe[k] = nummer THEN PHYS2D_SET_DYNAMIC(welt, kid[k], TRUE)
    NEXT
    steht[nummer] = FALSE
END SUB

SUB szene_physik()
    modus = 0.0
    IF NOT welt_bereit THEN
        physik_aufbauen()
        aufbau_zeit = zeit
        naechster_aufbau = zeit + 14.0
    END IF

    ' Auf dem Schlag von der Seite eine Kugel hineinwerfen -- die Musik
    ' raeumt das Logo also selbst ab.
    ' Die ERSTE Kugel kippt das Logo um; vorher bekommt der Zuschauer drei
    ' Sekunden, es ueberhaupt zu sehen.
    ' COOLDOWN bremst den Nachschub: der Schlagerkenner meldet oefter als
    ' hier eine Kugel gebraucht wird.
    IF beat AND bass > 0.20 AND nk < MAXK AND zeit - aufbau_zeit > 3.0 _
       AND COOLDOWN("wurf", 650) THEN
        DIM von_links AS BOOLEAN
        von_links = (INT(zeit * 3.0) MOD 2) = 0
        DIM sx AS INTEGER
        DIM v AS FLOAT
        IF von_links THEN
            sx = 40
            v = 900.0 + 700.0 * bass
        ELSE
            sx = BREITE - 40
            v = -900.0 - 700.0 * bass
        END IF
        kid[nk] = PHYS2D_ADD_CIRCLE(welt, sx, HOEHE - 250, 16, TRUE, 0.45)
        kfarbe[nk] = regenbogen(zeit * 2.0, 1.0)
        ist_kugel[nk] = TRUE
        ist_regen[nk] = FALSE
        PHYS2D_SET_VEL(welt, kid[nk], v, -260.0)
        nk = nk + 1
    END IF

    ' Umgekippt wird beim EINSCHLAG, nicht beim Abschuss: die Kugel braucht
    ' eine halbe Sekunde bis zum Logo, und faellt es schon vorher zusammen,
    ' sieht es aus, als kippe es von selbst. Und es faellt nur DER Buchstabe,
    ' den die Kugel wirklich erreicht -- der andere steht weiter, bis ihn
    ' selbst etwas trifft.
    DIM j AS INTEGER
    FOR j = n_logo TO nk - 1
        IF ist_kugel[j] THEN
            DIM bx AS FLOAT
            DIM by AS FLOAT
            bx = PHYS2D_BODY_X(welt, kid[j])
            by = PHYS2D_BODY_Y(welt, kid[j])
            IF by > logo_y0 THEN
                DIM bi2 AS INTEGER
                FOR bi2 = 0 TO BUCHSTABEN - 1
                    IF steht[bi2] AND bx > bu_x0[bi2] AND bx < bu_x1[bi2] THEN
                        logo_umkippen(bi2)
                        ' Funken am Einschlagpunkt + Erschuetterung: erst das
                        ' macht aus dem Umschalten einen Treffer.
                        PARTICLE_SET_POS(funken, INT(bx), INT(by))
                        PARTICLE_SET_COLOR(funken, RGB(255, 240, 180))
                        PARTICLE_SET_COLOR_END(funken, RGB(200, 60, 20))
                        PARTICLE_EMIT(funken, 70)
                        ruckeln = 1.0
                        rumble(0.5, 0.2)
                    END IF
                NEXT
            END IF
        END IF
    NEXT

    PHYS2D_STEP(welt, dt)

    ' Neu aufbauen, bevor der Platz ausgeht oder nichts mehr steht.
    IF zeit > naechster_aufbau OR nk >= MAXK - 4 THEN
        physik_aufbauen()
        aufbau_zeit = zeit
        naechster_aufbau = zeit + 14.0
    END IF

    ' --- Hintergrund: es regnet Truemmer ---
    ' Der eigentliche Wow-Effekt ist die MENGE: waehrend vorne das Logo
    ' zerlegt wird, rechnet derselbe Solver im Hintergrund ein paar hundert
    ' weitere Koerper, die sich am Boden zu Haufen stapeln.
    IF nk < MAXK - 8 AND COOLDOWN("regen", 70) THEN
        DIM wieviel AS INTEGER
        wieviel = 1
        IF beat THEN wieviel = 4          ' auf den Schlag ein Schwall
        DIM rr AS INTEGER
        FOR rr = 1 TO wieviel
            IF nk < MAXK - 2 THEN
                DIM rx AS INTEGER
                rx = RANDINT(30, BREITE - 30)
                kid[nk] = PHYS2D_ADD_BOX(welt, rx, -30 - rr * 30, 7, 7, TRUE, 0.25)
                kfarbe[nk] = dunkler(regenbogen(zeit * 0.4 + rx * 0.01, 1.0), 0.45)
                ist_kugel[nk] = FALSE
                ist_regen[nk] = TRUE
                kbuchstabe[nk] = -1
                nk = nk + 1
            END IF
        NEXT
    END IF

    PARTICLE_UPDATE(funken, dt * 1000.0)
    ruckeln = ruckeln * 0.90

    ' --- Zeichnen ---
    ' Hintergrund: Verlauf + Fluchtlinien geben der flachen Buehne Tiefe.
    GRADIENTV(0, 0, BREITE, HOEHE - 40, RGB(10, 12, 22), RGB(20, 24, 40))
    DIM g AS INTEGER
    FOR g = -6 TO 6
        LINE(BREITE \ 2 + g * 40, HOEHE - 40, BREITE \ 2 + g * 300, HOEHE \ 3, _
             RGB(24, 30, 48))
    NEXT
    DIM gy AS INTEGER
    FOR gy = 1 TO 5
        DIM ly AS INTEGER
        ly = HOEHE - 40 - gy * gy * 9
        LINE(0, ly, BREITE, ly, RGB(22, 27, 44))
    NEXT

    ' Erschuetterung: die Kamera versetzt ALLE folgenden Zeichenbefehle --
    ' vor der Beschriftung wieder zuruecksetzen, sonst wackelt auch die.
    IF ruckeln > 0.01 THEN
        CAMERA_SET(SIN(zeit * 91.0) * 9.0 * ruckeln, COS(zeit * 77.0) * 7.0 * ruckeln, 1.0)
    END IF

    ' Boden mit leuchtender Kante -- ohne die schweben die Kloetze im Nichts.
    BOX(0, HOEHE - 40, BREITE, HOEHE, RGB(18, 22, 34))
    BLEND_MODE("add")
    LINEW(0, HOEHE - 40, BREITE, HOEHE - 40, 3.0, RGB(40, 90, 120))
    BLEND_MODE("alpha")
    ' Zwei Durchgaenge: erst die Truemmer (Hintergrund), dann Logo und
    ' Kugeln davor. Sonst legen sich die kleinen Kloetze ueber das Logo.
    DIM durchgang AS INTEGER
    DIM k AS INTEGER
    FOR durchgang = 0 TO 1
    FOR k = 0 TO nk - 1
        IF (durchgang = 0) <> ist_regen[k] THEN CONTINUE
        DIM cx AS FLOAT
        DIM cy AS FLOAT
        cx = PHYS2D_BODY_X(welt, kid[k])
        cy = PHYS2D_BODY_Y(welt, kid[k])
        IF cy < HOEHE + 100 THEN
            ' Neon-Schein hinter jedem Koerper -- additiv, damit sich
            ' ueberlappende Kloetze gegenseitig aufhellen.
            BLEND_MODE("add")
            ' Gedaempft und knapp: bei voller Farbe frisst der Schein die
            ' Kloetze auf, statt sie zu umgeben.
            DIM gs AS FLOAT
            gs = KLOTZ / 58.0
            IF ist_regen[k] THEN gs = KLOTZ / 150.0
            DRAWIMAGEROT(glow, INT(cx), INT(cy), 0, gs, dunkler(kfarbe[k], 0.55))
            BLEND_MODE("alpha")
            IF ist_regen[k] THEN
                DRAWIMAGEROT(weiss, INT(cx), INT(cy), _
                             DEG(PHYS2D_BODY_ANGLE(welt, kid[k])), 14.0 / 32.0, kfarbe[k])
            ELSEIF ist_kugel[k] THEN
                DIM ang AS FLOAT
                ang = PHYS2D_BODY_ANGLE(welt, kid[k])
                CIRCLE(INT(cx), INT(cy), 16, kfarbe[k])
                ' Ein Radiusstrich macht die Eigendrehung sichtbar -- sonst
                ' saehe man einer rollenden Kugel gar nicht an, dass sie rollt.
                LINE(INT(cx), INT(cy), INT(cx + 15.0 * COS(ang)), INT(cy + 15.0 * SIN(ang)), _
                     RGB(20, 20, 30))
            ELSE
                ' BODY_ANGLE ist Radiant, der Blit will Grad.
                DRAWIMAGEROT(weiss, INT(cx), INT(cy), DEG(PHYS2D_BODY_ANGLE(welt, kid[k])), _
                             KLOTZ / 32.0, kfarbe[k])
            END IF
        END IF
    NEXT
    NEXT

    BLEND_MODE("add")
    PARTICLE_DRAW(funken)
    BLEND_MODE("alpha")
    CAMERA_RESET()

    mtext(BREITE \ 2, 46, "physics2d (Rapier)  -  " + STR$(PHYS2D_COUNT(welt)) + " Koerper", _
          0.5, RGB(140, 180, 210))
END SUB

' ----------------------------------------------------------------------
'  SZENE 6 -- Tunnel + Nachhall aus dem Render-Target
' ----------------------------------------------------------------------
' Den Tunnel selbst zeichnet der Post-Effekt (mode 2, siehe demo.fs) --
' 1/r-Abbildung, der klassische Demo-Tunnel. Davor liegt ein Ring, dessen
' Radius Band fuer Band aus dem Spektrum kommt: die Musik als Gestalt.
'
' Der Nachhall ist ECHT: das Render-Target wird mit RENDERTARGET_NEW(w, h,
' TRUE) angelegt und bleibt damit ueber das Bild hinaus stehen. Verblasst
' wird, indem der Inhalt jedes Bild mit einem dunklen Grau MULTIPLIZIERT
' wird -- ein Target kann sich nicht selbst zeichnen, das ist der Weg.
' Zusaetzlich wird das Ergebnis dreimal gestaffelt gestempelt: das gibt dem
' Ganzen Tiefe in den Tunnel hinein.
' Der Ring hat DOPPELT so viele Punkte wie Baender: das Spektrum laeuft von
' 0 bis 31 die eine Haelfte hoch und gespiegelt wieder herunter. Ohne diese
' Spiegelung stossen im Ring Band 31 (Hoehen, klein) und Band 0 (Bass, gross)
' direkt aneinander -- ein Sprung von ueber 150 Pixeln zwischen zwei
' Nachbarpunkten, aus dem die Catmull-Rom einen weit hinausschiessenden
' Zacken macht. (Der Spline selbst schliesst sauber; nachgemessen.)
'
' Dazu vier Punkte extra: eine geschlossene Catmull-Rom braucht Stuetzpunkte
' auf BEIDEN Seiten -- vor dem ersten den letzten, hinter dem letzten die
' ersten.
CONST RINGN AS INTEGER = BAENDER * 2       ' Punkte rund herum
CONST RINGP AS INTEGER = RINGN + 4         ' plus Stuetzpunkte
CONST ECHOS AS INTEGER = 3

DIM rt_ring AS INTEGER
DIM ringx[RINGP] AS INTEGER
DIM ringy[RINGP] AS INTEGER

' Punkt k des Rings -> gespiegelter Band-Index (0..BAENDER-1).
FUNCTION ringband(k AS INTEGER) AS INTEGER
    DIM p AS INTEGER
    p = (k + RINGN - 1) MOD RINGN
    IF p < BAENDER THEN RETURN p
    RETURN RINGN - 1 - p
END FUNCTION

FUNCTION ringwinkel(k AS INTEGER) AS FLOAT
    RETURN ((k + RINGN - 1) MOD RINGN) * 6.28318 / RINGN
END FUNCTION

SUB szene_tunnel()
    modus = 2.0

    ' --- Den Ring in das Render-Target zeichnen ---
    RENDERTARGET_BEGIN(rt_ring)
    ' Verblassen: das Stehengebliebene abdunkeln, statt es zu loeschen.
    BLEND_MODE("mult")
    BOX(0, 0, BREITE, HOEHE, RGB(214, 214, 220))
    BLEND_MODE("alpha")
    DIM k AS INTEGER
    FOR k = 0 TO RINGP - 1
        DIM b AS INTEGER
        b = ringband(k)
        DIM a AS FLOAT
        a = ringwinkel(k) + zeit * 0.25
        DIM r AS FLOAT
        r = 120.0 + glatt[b] * 190.0
        ringx[k] = INT(BREITE / 2.0 + COS(a) * r)
        ringy[k] = INT(HOEHE / 2.0 + SIN(a) * r * 0.86)
    NEXT
    SPLINE(ringx, ringy, regenbogen(zeit * 0.9, 1.0), 5.0 + 8.0 * bass)

    ' Ein zweiter, kleinerer Ring gegenlaeufig -- gibt dem Ganzen Tiefe.
    FOR k = 0 TO RINGP - 1
        DIM b2 AS INTEGER
        b2 = ringband(k)
        DIM a2 AS FLOAT
        a2 = ringwinkel(k) - zeit * 0.4
        DIM r2 AS FLOAT
        r2 = 56.0 + glatt[b2] * 80.0
        ringx[k] = INT(BREITE / 2.0 + COS(a2) * r2)
        ringy[k] = INT(HOEHE / 2.0 + SIN(a2) * r2 * 0.86)
    NEXT
    SPLINE(ringx, ringy, regenbogen(zeit * 0.9 + 2.4, 1.0), 3.0 + 4.0 * hoehen)
    RENDERTARGET_END()

    ' --- Nachhall: dasselbe Bild mehrfach, von gross nach klein ---
    BLEND_MODE("add")
    DIM e AS INTEGER
    FOR e = ECHOS - 1 TO 0 STEP -1
        DIM sk AS FLOAT
        ' In den Tunnel hinein: jedes Echo kleiner, das aeusserste zuerst.
        sk = 1.30 - e * 0.34 + SIN(zeit * 1.2 - e * 0.5) * 0.03
        IF sk > 0.05 THEN
            DIM hell AS FLOAT
            hell = 1.0 - e / (ECHOS * 1.15)
            RENDERTARGET_DRAW(rt_ring, INT((BREITE - BREITE * sk) / 2.0), _
                              INT((HOEHE - HOEHE * sk) / 2.0), sk, _
                              regenbogen(zeit * 0.6 + e * 0.35, hell))
        END IF
    NEXT
    BLEND_MODE("alpha")

    mtext(BREITE \ 2, HOEHE - 54, _
          "RENDERTARGET (behalten) + SPLINE  -  echte Schweife", _
          0.5, RGB(140, 180, 210))
END SUB

' ----------------------------------------------------------------------
'  SZENE 7 -- Klangfarben: die Effektkette bei der Arbeit
' ----------------------------------------------------------------------
' Die einzige Szene, in der die Demo den KLANG anfasst. Kira faehrt die
' Effekte auf dem Audio-Thread; das Programm setzt nur Werte und rechnet pro
' Bild NICHTS nach -- ein Filter-Sweep laeuft also sample-genau weiter, auch
' wenn die Bildrate einbricht.
'
' Der Beweis steht im Bild: die Saeulen sind das ECHTE Spektrum hinter der
' Kette. Faehrt der Tiefpass herunter, sieht man die rechten Saeulen
' verschwinden -- nicht als Animation, sondern weil sie wirklich weg sind.
CONST STUFEN AS INTEGER = 6

DIM lfo AS AUDIO_MOD
DIM lfo_aktiv AS BOOLEAN
DIM stufe AS INTEGER
DIM stufe_alt AS INTEGER

FUNCTION stufenname(n AS INTEGER) AS STRING
    IF n = 0 THEN RETURN "TIEFPASS-SWEEP"
    IF n = 1 THEN RETURN "WOBBLE  (LFO auf den Filter)"
    IF n = 2 THEN RETURN "ECHO  (Delay)"
    IF n = 3 THEN RETURN "HALL  (Reverb)"
    IF n = 4 THEN RETURN "VERZERRER  (Distortion)"
    RETURN "AUTO-PAN  (LFO auf die Balance)"
END FUNCTION

FUNCTION stufenzeile(n AS INTEGER) AS STRING
    IF n = 0 THEN RETURN "AUDIO_FILTER(bus$, cutoff_hz, resonance)"
    IF n = 1 THEN RETURN "AUDIO_LFO_NEW + AUDIO_MODULATE(bus$, ""filter"", ...)"
    IF n = 2 THEN RETURN "AUDIO_DELAY(bus$, mix, feedback, time_ms)"
    IF n = 3 THEN RETURN "AUDIO_REVERB(bus$, mix, feedback, damping)"
    IF n = 4 THEN RETURN "AUDIO_DISTORTION(bus$, amount, mix)"
    RETURN "AUDIO_MODULATE(bus$, ""pan"", lfo, -1, +1)"
END FUNCTION

' Alles auf neutral -- vor jeder Stufe. Beim VERLASSEN der Szene braucht es
' das nicht mehr: AUDIO_POP im Szenenwechsel holt den Zustand von selbst
' zurueck (frueher stand hier der einzige Schutz davor, dass der Abspann durch
' den Verzerrer laeuft).
SUB klang_neutral()
    IF lfo_aktiv THEN
        AUDIO_MOD_REMOVE(lfo)
        lfo_aktiv = FALSE
    END IF
    AUDIO_FILTER("music", 0, 0)          ' 0 = offen
    AUDIO_DELAY("music", 0.0)
    AUDIO_REVERB("music", 0.0)
    AUDIO_DISTORTION("music", 0.0)
    AUDIO_BUS_PAN("music", 0.0)
END SUB

SUB klang_stufe_setzen(n AS INTEGER)
    klang_neutral()
    IF n = 1 THEN
        lfo = AUDIO_LFO_NEW("sine", 5.5)
        AUDIO_MODULATE("music", "filter", lfo, 260.0, 5200.0)
        lfo_aktiv = TRUE
    ELSEIF n = 2 THEN
        AUDIO_DELAY("music", 0.42, 0.55, 300)
    ELSEIF n = 3 THEN
        AUDIO_REVERB("music", 0.55, 0.88, 0.25)
    ELSEIF n = 4 THEN
        AUDIO_DISTORTION("music", 0.45, 0.7)
    ELSEIF n = 5 THEN
        lfo = AUDIO_LFO_NEW("triangle", 0.7)
        AUDIO_MODULATE("music", "pan", lfo, -0.9, 0.9)
        lfo_aktiv = TRUE
    END IF
END SUB

SUB szene_klang()
    modus = 0.0
    DIM dauer AS FLOAT
    dauer = (T7 - T6) / STUFEN
    stufe = INT(szene_t / dauer)
    IF stufe > STUFEN - 1 THEN stufe = STUFEN - 1
    IF stufe <> stufe_alt THEN
        klang_stufe_setzen(stufe)
        stufe_alt = stufe
    END IF

    ' Stufe 0 faehrt den Cutoff von Hand -- der einzige Wert, den die Demo
    ' hier pro Bild nachzieht; alle anderen laufen von selbst weiter.
    DIM cutoff AS FLOAT
    cutoff = 0.0
    IF stufe = 0 THEN
        DIM ph AS FLOAT
        ph = (szene_t / dauer) * 6.28318 * 2.0
        cutoff = 300.0 + (0.5 + 0.5 * SIN(ph - 1.57)) * 7000.0
        AUDIO_FILTER("music", cutoff, 0.55)
    END IF

    ' --- Spektrum gross in die Mitte: DAS ist der Beweis ---
    DIM bw AS INTEGER
    bw = (BREITE - 160) \ BAENDER
    DIM k AS INTEGER
    FOR k = 0 TO BAENDER - 1
        DIM h AS INTEGER
        h = INT(glatt[k] * HOEHE * 0.42)
        DIM x0 AS INTEGER
        x0 = 80 + k * bw
        DIM c AS INTEGER
        c = regenbogen(k * 0.16 + zeit * 0.5, 0.45 + 0.55 * glatt[k])
        BOXROUND(x0 + 2, HOEHE \ 2 + 150 - h, x0 + bw - 3, HOEHE \ 2 + 150, 4, c)
    NEXT
    LINE(80, HOEHE \ 2 + 151, BREITE - 80, HOEHE \ 2 + 151, RGB(60, 72, 96))

    ' --- Was gerade laeuft ---
    mtext(BREITE \ 2, 120, stufenname(stufe), 1.0, regenbogen(zeit * 0.8, 1.0))
    mtext(BREITE \ 2, 176, stufenzeile(stufe), 0.5, RGB(150, 190, 220))

    ' Fortschritt durch die Kette
    DIM e AS INTEGER
    FOR e = 0 TO STUFEN - 1
        DIM px AS INTEGER
        px = BREITE \ 2 + (e - (STUFEN - 1) / 2.0) * 46
        IF e = stufe THEN
            CIRCLE(px, 226, 9, regenbogen(zeit * 0.8, 1.0))
        ELSE
            CIRCLE(px, 226, 5, RGB(60, 72, 96))
        END IF
    NEXT

    IF stufe = 0 THEN
        mtext(BREITE \ 2, HOEHE - 96, "Cutoff " + STR$(INT(cutoff)) + " Hz  -  " + _
              "die rechten Saeulen verschwinden wirklich", 0.46, RGB(140, 180, 210))
    ELSE
        mtext(BREITE \ 2, HOEHE - 96, _
              "Kira faehrt das auf dem Audio-Thread  -  das Programm rechnet nichts nach", _
              0.46, RGB(140, 180, 210))
    END IF
END SUB

' ----------------------------------------------------------------------
'  SZENE 8 -- Abspann
' ----------------------------------------------------------------------
' Ruhiger Ausklang: ein Drahtgitter-Knoten dreht sich, die Sterne ziehen
' langsam vorbei, der Abspann laeuft hoch. Dazu ein Ping, der WIRKLICH um
' den Zuhoerer kreist -- AUDIO_EMITTER/LISTENER, Kira rechnet Panorama und
' Entfernung selbst. Der Punkt auf dem Bild zeigt, wo der Klang gerade ist.
CONST ZEILEN AS INTEGER = 22

DIM abspann[ZEILEN] AS STRING
DIM knoten AS INTEGER
DIM ohr AS AUDIO_LISTENER
DIM quelle AS AUDIO_EMITTER
DIM ping AS SOUND
DIM audio_raum_bereit AS BOOLEAN

SUB raum_aufbauen()
    ' Das Ohr sitzt im Ursprung, die Quelle kreist in 6 Metern Abstand.
    ohr = AUDIO_LISTENER_NEW(0.0, 0.0, 0.0)
    quelle = AUDIO_EMITTER_NEW(ohr, 6.0, 0.0, 0.0, 1.0, 22.0)
    ping = AUDIO_SFX("sine", 660.0, 0.15, 0.005, 0.05, 0.45, 0.0, 0.0, 0.5)
    audio_raum_bereit = TRUE
END SUB

SUB szene_abspann()
    modus = 0.0
    IF NOT audio_raum_bereit THEN raum_aufbauen()
    IF NOT sterne_bereit THEN sterne_setzen()

    ' --- Sterne, jetzt gemaechlich ---
    DIM k AS INTEGER
    FOR k = 0 TO STERNE - 1
        stz[k] = stz[k] - 0.06 * dt
        IF stz[k] <= 0.04 THEN
            stx[k] = RND() * 2.0 - 1.0
            sty[k] = RND() * 2.0 - 1.0
            stz[k] = 1.0
        END IF
        DIM px AS FLOAT
        DIM py AS FLOAT
        px = BREITE / 2.0 + stx[k] / stz[k] * BREITE * 0.46
        py = HOEHE / 2.0 + sty[k] / stz[k] * HOEHE * 0.46
        IF px > 0.0 AND px < BREITE AND py > 0.0 AND py < HOEHE THEN
            lx1[k] = INT(px)
            ly1[k] = INT(py)
        ELSE
            lx1[k] = -10
            ly1[k] = -10
        END IF
        DIM g AS INTEGER
        g = INT(60.0 + 150.0 * (1.0 - stz[k]))
        lc[k] = RGB(g, g, INT(g * 1.15))
    NEXT
    PLOTS(lx1, ly1, lc)

    ' --- Drahtgitter-Knoten, langsam kreisende Kamera ---
    ' Zielpunkt nach unten -> der Knoten sitzt im oberen Drittel und laesst
    ' dem Abspann den Platz, den er braucht.
    CAMERA3D(SIN(zeit * 0.12) * 7.5, 2.4, COS(zeit * 0.12) * 7.5, 0, -1.6, 0, 45)
    MODEL_WIRES(knoten, 0, 0, 0, 2.3 + 0.2 * bass, _
                regenbogen(zeit * 0.35, 0.20 + 0.22 * bass))

    ' --- Der kreisende Ping: hoerbar links/rechts, sichtbar als Punkt ---
    DIM w AS FLOAT
    w = szene_t * 0.9
    AUDIO_EMITTER_SET_POSITION(quelle, COS(w) * 6.0, 0.0, SIN(w) * 6.0)
    IF COOLDOWN("ping", 2400) AND szene_t > 1.0 THEN AUDIO_PLAY_ON(ping, quelle, 0, 0.55)
    DIM qx AS INTEGER
    DIM qy AS INTEGER
    qx = INT(BREITE / 2.0 + COS(w) * 210.0)
    qy = INT(HOEHE * 0.26 + SIN(w) * 46.0)
    BLEND_MODE("add")
    DRAWIMAGEROT(glow, qx, qy, 0, 0.45, RGB(120, 220, 255))
    BLEND_MODE("alpha")
    ' Ohne Beschriftung bleibt der kreisende Punkt raetselhaft -- er ist die
    ' SCHALLQUELLE, und der Ping wandert hoerbar mit ihm von links nach rechts.
    IF szene_t < 26.0 THEN
        DIM b AS FLOAT
        b = 1.0
        IF szene_t > 22.0 THEN b = (26.0 - szene_t) / 4.0
        mtext(BREITE \ 2, INT(HOEHE * 0.26) - 92, _
              "AUDIO_EMITTER  -  der Ping kreist wirklich um dich herum", _
              0.44, RGB(INT(120 * b), INT(170 * b), INT(200 * b)))
    END IF

    ' --- Abspann laeuft hoch ---
    DIM y0 AS FLOAT
    ' Langsam genug, dass man mitliest, schnell genug, dass alles durch ist,
    ' bevor das Logo kommt.
    y0 = HOEHE + 40.0 - szene_t * 26.0
    FOR k = 0 TO ZEILEN - 1
        DIM y AS FLOAT
        y = y0 + k * 42.0
        IF y > -40.0 AND y < HOEHE + 40.0 THEN
            DIM sk AS FLOAT
            DIM c AS INTEGER
            IF LEFT$(abspann[k], 1) = "*" THEN
                sk = 0.72                          ' Ueberschrift
                c = regenbogen(zeit * 0.6 + k * 0.2, 1.0)
                ' MID$ ist 0-basiert: ab Zeichen 1, und ZWEI Zeichen kuerzer
                ' -- sonst bleibt der Stern am Ende stehen.
                mtext(BREITE \ 2, INT(y), MID$(abspann[k], 1, LEN(abspann[k]) - 2), sk, c)
            ELSE
                sk = 0.5
                c = RGB(170, 195, 220)
                mtext(BREITE \ 2, INT(y), abspann[k], sk, c)
            END IF
        END IF
    NEXT

    ' --- Zum Schluss das Logo ---
    IF szene_t > (T8 - T7) - 26.0 THEN
        DIM ein AS FLOAT
        ein = (szene_t - ((T8 - T7) - 26.0)) / 5.0
        IF ein > 1.0 THEN ein = 1.0
        mtext(BREITE \ 2, HOEHE \ 2 - 20, "DRACHENHAUCH", 1.6 * (0.9 + 0.1 * ein), _
              regenbogen(zeit * 1.1, ein))
        mtext(BREITE \ 2, HOEHE \ 2 + 54, "danke fuers Zuschauen", 0.6, _
              RGB(INT(150 * ein), INT(190 * ein), INT(215 * ein)))
    END IF
END SUB

' ----------------------------------------------------------------------
'  Platzhalter fuer die noch nicht gebauten Szenen
' ----------------------------------------------------------------------
' Beim Szenenwechsel den Zustand umstellen.
'
' Licht, Himmel, Schatten, Nebel und die Audio-Bus-Effekte sind GLOBAL. Frueher
' musste hier jede Einstellung von Hand zurueckgedreht werden -- und eine
' vergessene Zeile fiel erst zwei Szenen spaeter auf (der HDR-Himmel hinter dem
' Wuerfelfeld, der Verzerrer im Abspann). GFX_PUSH/GFX_POP und AUDIO_PUSH/
' AUDIO_POP nehmen einem das ab: die Szene stellt um, was sie braucht, und der
' Wechsel holt alles zurueck -- ohne dass irgendwo eine Liste gepflegt wird.
SUB szene_start(neu AS INTEGER)
    IF gestapelt THEN
        GFX_POP()
        AUDIO_POP()
        gestapelt = FALSE
    END IF
    GFX_PUSH()
    AUDIO_PUSH()
    gestapelt = TRUE

    IF neu = 4 THEN
        LIGHT_AMBIENT(0, 0)                       ' Licht kommt allein aus der Umgebung
        LIGHT_DIRECTIONAL(-0.4, -0.75, -0.5, &H50504C)
        IF hdr_da THEN SKYBOX(TRUE)
        SHADOW_ENABLE(2048)
        SHADOW_AREA(14.0, 40.0)
        ' Dunst in der Farbe des Horizonts: der Boden laeuft ins Panorama
        ' aus, statt an einer sichtbaren Kante zu enden.
        LIGHT_FOG(&H7D6D62, 0.030)
    END IF

    IF neu = 7 THEN stufe_alt = -1
END SUB

SUB szene_platzhalter(titel AS STRING)
    modus = 0.0
    mtext(BREITE \ 2, HOEHE \ 2, titel, 1.0, RGB(90, 120, 150))
    DIM k AS INTEGER
    DIM bw AS INTEGER
    bw = BREITE \ BAENDER
    FOR k = 0 TO BAENDER - 1
        DIM h AS INTEGER
        h = INT(glatt[k] * HOEHE * 0.14)
        BOX(k * bw + 3, HOEHE - h, k * bw + bw - 3, HOEHE, regenbogen(k * 0.2, 0.8))
    NEXT
END SUB

' ----------------------------------------------------------------------
'  Einmaliger Aufbau
' ----------------------------------------------------------------------
glow = GENTEX_RADIAL(128, 128, RGB(255, 255, 255), RGB(0, 0, 0))
psys = PARTICLE_SYSTEM_NEW(BREITE \ 2, HOEHE \ 2)
PARTICLE_SET_VELOCITY(psys, -260.0, 260.0, -260.0, 260.0)
PARTICLE_SET_LIFETIME(psys, 500, 1300)
PARTICLE_SET_SIZE(psys, 2, 7)
PARTICLE_SET_GRAVITY(psys, 0.0, 30.0)
PARTICLE_SET_FADE(psys, TRUE)
PARTICLE_SET_MODE(psys, "glow")

' Einschlag-Funken fuer Szene 5: kurz, schnell, mit Schwerkraft.
funken = PARTICLE_SYSTEM_NEW(0, 0)
PARTICLE_SET_VELOCITY(funken, -420.0, 420.0, -520.0, 60.0)
PARTICLE_SET_LIFETIME(funken, 250, 750)
PARTICLE_SET_SIZE(funken, 2, 5)
PARTICLE_SET_GRAVITY(funken, 0.0, 900.0)
PARTICLE_SET_FADE(funken, TRUE)
PARTICLE_SET_MODE(funken, "glow")

' Buchstaben-Schablonen fuer Szene 5 (ein '#' wird ein Klotz)
logo_g[0] = "#####"
logo_g[1] = "#...."
logo_g[2] = "#...."
logo_g[3] = "#.###"
logo_g[4] = "#...#"
logo_g[5] = "#...#"
logo_g[6] = "#####"
logo_b[0] = "####."
logo_b[1] = "#...#"
logo_b[2] = "#...#"
logo_b[3] = "####."
logo_b[4] = "#...#"
logo_b[5] = "#...#"
logo_b[6] = "####."
weiss = GENTEX_COLOR(32, 32, &HFFFFFF)
' TRUE = der Inhalt bleibt ueber das Bild hinaus stehen -> echte Schweife.
rt_ring = RENDERTARGET_NEW(BREITE, HOEHE, TRUE)

mesh_box = MESH_CUBE(0.8, 0.8, 0.8)

LIGHT_ENABLE()
LIGHT_AMBIENT(&H1A2030, 0.55)
LIGHT_DIRECTIONAL(-0.5, -0.8, -0.4, &HFFE0B0)

' --- Szene 4: Umgebung + Modelle (einmalig; das HDR-Panorama zu
' --- durchrechnen kostet einen Moment, deshalb hier und nicht pro Bild) ---
' Das HDR-Panorama ist ein Wunsch, keine Bedingung: im Browser (WebGL) laesst
' sich der Cubemap-Shader nicht uebersetzen -- er ist fuer Desktop-GLSL
' geschrieben. Statt daran zu scheitern, faellt die Szene auf das analytische
' LIGHT_ENV zurueck. Dasselbe greift, wenn die .hdr-Datei fehlt.
hdr_da = FALSE
IF FILEEXISTS("assets/ibl_env.hdr") THEN
    TRY
        LIGHT_ENV_HDR("assets/ibl_env.hdr", 1.0)
        hdr_da = TRUE
    CATCH e
        PRINT "HDR-Umgebung nicht nutzbar (" + e + ") -- nehme die Naeherung."
    END TRY
END IF
IF NOT hdr_da THEN
    LIGHT_ENV(&H6090E0, &H201810, 1.0)        ' analytische Naeherung als Rueckfall
END IF

DIM kk AS INTEGER
FOR kk = 0 TO N_KUGELN - 1
    kugeln[kk] = MESH_SPHERE(0.62, 40, 40)
    MODEL_LIT(kugeln[kk])
    ' Rauheit von 0.03 (Spiegel) bis 0.85 (matt) ueber den Ring verteilt
    MODEL_PBR(kugeln[kk], 1.0, 0.03 + kk / (N_KUGELN - 1.0) * 0.82)
NEXT

' Der Boden muss GELAENDE sein, keine Farbflaeche. Die Kugeln spiegeln die
' Umgebung aus dem HDR, und darin ist unter dem Horizont bewachsenes Land --
' eine einfarbige Platte darunter widerspricht dem sofort. Also: eine
' prozedurale Struktur als Diffuse-Map (Perlin-Rauschen, in der gemessenen
' Gelaendefarbe getoent) und Dunst in die Ferne, damit der Boden am Horizont
' ins Panorama uebergeht statt an einer Kante zu enden.
' Die Flaeche NICHT riesig machen: eine Textur wird ueber die ganze Ebene
' EINMAL gespannt (MESH_PLANE hat keine Kachelung), 400 Einheiten breit heisst
' also 400 Einheiten fuer ein Bild -- die Struktur verschwimmt zu einer Flaeche.
' 130 Einheiten plus Dunst zum Horizont zeigen Struktur UND verstecken die Kante.
boden = MESH_PLANE(130.0, 130.0, 1, 1)
MODEL_LIT(boden)
MODEL_PBR(boden, 0.05, 0.78)
DIM bodentex AS IMAGE
bodentex = GENTEX_CELLULAR(1024, 1024, 44)     ' Zellrauschen = Steppenboden
MODEL_TEXTURE(boden, bodentex)

' Ein Ring statt eines Knotens: der Knoten war bei dieser Groesse nur ein
' undeutliches Gebilde. Ein Torus ist auf einen Blick als Form erkennbar --
' und passt zum Spektrum-Ring aus Szene 6.
knoten = MESH_TORUS(1.6, 0.42, 48, 24)

abspann[0] = "*DRACHENHAUCH - DEMO*"
abspann[1] = ""
abspann[2] = "*Was du gesehen hast*"
abspann[3] = "Plasma, Sinus-Scroller und Spektrum-Saeulen"
abspann[4] = "1400 Streifen in EINEM LINES-Aufruf"
abspann[5] = "1600 Wuerfel in drei Draw-Calls (MODEL_INSTANCED)"
abspann[6] = "PBR-Metall unter echtem HDR-Himmel, mit Schatten"
abspann[7] = "ein Logo aus Kloetzen, von Rapier2D umgeworfen"
abspann[8] = "Tunnel, Spektrum-Ring und Render-Target-Stempel"
abspann[9] = "eine Effektkette, die man am Spektrum sieht"
abspann[10] = ""
abspann[11] = "*Alles in einer Laufzeit*"
abspann[12] = "dhrt - Rust, raylib und Kira"
abspann[13] = "Lexer, Parser, Compiler und VM in einem"
abspann[14] = ""
abspann[15] = "*Musik*"
abspann[16] = "Drozerix - Stardust Jam"
abspann[17] = "gemeinfrei, The Mod Archive"
abspann[18] = "ein echtes ProTracker-Modul, live gestreamt"
abspann[19] = ""
abspann[20] = "*Material*"
abspann[21] = "HDR: Poly Haven (CC0)   Schrift: Roboto (Apache 2.0)"

kern = MESH_SPHERE(0.9, 36, 36)
MODEL_LIT(kern)
MODEL_PBR(kern, 0.2, 0.35)

AUDIO_MUSIC_LOAD(MUSIK)
AUDIO_MUSIC_PLAY(-1, 1200)

' ----------------------------------------------------------------------
'  KLANG-TASTATUR
' ----------------------------------------------------------------------
' Acht Klaenge, die jederzeit auf Tastendruck laufen -- egal welche Szene
' gerade zu sehen ist. Alle sind PROZEDURAL: AUDIO_SFX baut sie aus
' Wellenform, Tonhoehe, Pitch-Slide, ADSR, Vibrato und (SID-Erweiterung)
' Pulsbreite + resonantem Filter-Sweep. Keine einzige Klangdatei.
CONST KLAENGE AS INTEGER = 8

DIM klang[KLAENGE] AS SOUND
DIM klangname[KLAENGE] AS STRING
DIM klangtaste[KLAENGE] AS INTEGER
DIM klangfarbe[KLAENGE] AS INTEGER
DIM letzter_klang AS INTEGER
DIM klang_alter AS FLOAT

DIM stueck_datei[STUECKE] AS STRING
DIM stueck_name[STUECKE] AS STRING
DIM stueck AS INTEGER
DIM stueck_alter AS FLOAT

SUB klaviatur_bauen()
    ' Wellenform, Frequenz, Slide, Attack, Sustain, Decay, Vib-Tiefe,
    ' Vib-Tempo, Lautstaerke [, Stereo, Duty, PWM-Tiefe, PWM-Tempo,
    '  Filter-Cutoff, Filter-Sweep, Resonanz]
    klang[0] = AUDIO_SFX("sine", 150, -110, 0, 60, 220, 0, 0, 0.9)
    klangname[0] = "KICK"
    klang[1] = AUDIO_SFX("noise", 900, -300, 0, 40, 180, 0, 0, 0.7)
    klangname[1] = "SNARE"
    klang[2] = AUDIO_SFX("square", 880, 900, 0, 90, 90, 0, 0, 0.6, 0.0, 0.25, 0.2, 8.0)
    klangname[2] = "ZAP"
    klang[3] = AUDIO_SFX("saw", 1200, -900, 0, 140, 120, 0, 0, 0.6, 0.0, 0.5, 0.0, 0.0, 5000, -9000, 0.75)
    klangname[3] = "LASER"
    klang[4] = AUDIO_SFX("square", 660, 260, 0, 70, 110, 0, 0, 0.55, 0.0, 0.5)
    klangname[4] = "COIN"
    klang[5] = AUDIO_SFX("noise", 300, -160, 0, 260, 620, 0, 0, 0.8)
    klangname[5] = "BOOM"
    klang[6] = AUDIO_SFX("triangle", 1400, 0, 0, 45, 60, 0, 0, 0.5)
    klangname[6] = "BLIP"
    klang[7] = AUDIO_SFX("saw", 110, 0, 20, 700, 260, 0.4, 5.0, 0.75, 0.35, 0.28, 0.2, 4.5, 3200, -2600, 0.8)
    klangname[7] = "SID-BASS"

    klangtaste[0] = KEY_A
    klangtaste[1] = KEY_S
    klangtaste[2] = KEY_D
    klangtaste[3] = KEY_F
    klangtaste[4] = KEY_G
    klangtaste[5] = KEY_H
    klangtaste[6] = KEY_J
    klangtaste[7] = KEY_K

    DIM t AS INTEGER
    FOR t = 0 TO KLAENGE - 1
        klangfarbe[t] = regenbogen(t * 0.78, 1.0)
    NEXT
    letzter_klang = -1
    klang_alter = 99.0

    ' Alle acht sind von Drozerix und gemeinfrei (The Mod Archive).
    ' Der Zusatz nennt Kanaele und Laenge -- daran hoert man den Unterschied
    ' zwischen einem 4-Kanal-Amiga-Modul und einem 24-Kanal-Satz am ehesten.
    stueck_datei[0] = "assets/music/stardust_jam.mod"
    stueck_name[0] = "Stardust Jam  (4 Kanaele, 6:24)"
    stueck_datei[1] = "assets/music/silicon_dancer.mod"
    stueck_name[1] = "Silicon Dancer  (4 Kanaele, 4:05)"
    stueck_datei[2] = "assets/music/neon_techno.mod"
    stueck_name[2] = "Neon Techno  (4 Kanaele, 3:58)"
    stueck_datei[3] = "assets/music/mecanum_overdrive.xm"
    stueck_name[3] = "Mecanum Overdrive  (4 Kanaele, 2:57)"
    stueck_datei[4] = "assets/music/assembly.xm"
    stueck_name[4] = "Assembly!  (4 Kanaele, 1:55)"
    stueck_datei[5] = "assets/music/keygen_wraith.xm"
    stueck_name[5] = "Keygen Wraith  (6 Kanaele, 1:33)"
    stueck_datei[6] = "assets/music/building_energy.xm"
    stueck_name[6] = "Building Energy  (24 Kanaele, 1:29)"
    stueck_datei[7] = "assets/music/cyber_spider.xm"
    stueck_name[7] = "Cyber Spider  (10 Kanaele, 1:03)"
    stueck = 0
    stueck_alter = 99.0
END SUB

' Wird jedes Bild gerufen: Tasten abfragen und den zuletzt gespielten
' Klang kurz einblenden.
SUB klaviatur_bedienen()
    DIM t AS INTEGER
    FOR t = 0 TO KLAENGE - 1
        IF KEYHIT(klangtaste[t]) THEN
            AUDIO_PLAY(klang[t], 0, 0.85)
            letzter_klang = t
            klang_alter = 0.0
        END IF
    NEXT
    klang_alter = klang_alter + dt
    stueck_alter = stueck_alter + dt

    ' M schaltet das Musikstueck um. Wichtig dabei: der Ablaufplan haengt an
    ' AUDIO_MUSIC_POSITION, und die springt beim Laden auf 0 zurueck. Ohne
    ' Korrektur finge die Demo also wieder bei Szene 1 an. Deshalb wandert
    ' die aktuelle Stelle in `versatz` -- die Szenen laufen unbeirrt weiter.
    IF KEYHIT(KEY_M) THEN
        stueck = (stueck + 1) MOD STUECKE
        versatz = zeit
        AUDIO_MUSIC_LOAD(stueck_datei[stueck])
        AUDIO_MUSIC_PLAY(-1, 400)
        stueck_alter = 0.0
    END IF
END SUB

SUB klaviatur_zeigen()
    ' Dauerhafte, dezente Zeile -- man soll wissen, dass es sie gibt.
    DIM t AS INTEGER
    DIM zeile AS STRING
    zeile = ""
    FOR t = 0 TO KLAENGE - 1
        zeile = zeile + KEY_NAME$(klangtaste[t]) + " " + klangname[t] + "   "
    NEXT
    ' Abdunkeln statt uebermalen: MULT laesst durchscheinen, was darunter
    ' liegt, macht die Zeile aber in jeder Szene lesbar -- ohne den Streifen
    ' verschwindet sie in den Spektrum-Saeulen.
    BLEND_MODE("mult")
    BOX(0, HOEHE - 34, BREITE, HOEHE, RGB(60, 62, 74))
    BLEND_MODE("alpha")
    mtext(BREITE \ 2, HOEHE - 17, zeile + "   M MUSIK", 0.34, RGB(120, 140, 170))

    ' Nach einem Musikwechsel kurz nennen, was jetzt laeuft.
    IF stueck_alter < 3.5 THEN
        DIM mb AS FLOAT
        mb = 1.0
        IF stueck_alter > 2.5 THEN mb = 3.5 - stueck_alter
        BLEND_MODE("mult")
        BOX(0, 6, BREITE, 44, RGB(60, 62, 74))
        BLEND_MODE("alpha")
        mtext(BREITE \ 2, 25, _
              STR$(stueck + 1) + "/" + STR$(STUECKE) + "  Drozerix - " + stueck_name[stueck], _
              0.42, RGB(INT(170 * mb), INT(200 * mb), INT(230 * mb)))
    END IF

    ' Der zuletzt gedrueckte Klang blitzt kurz auf.
    IF letzter_klang >= 0 AND klang_alter < 1.1 THEN
        DIM b AS FLOAT
        b = 1.0 - klang_alter / 1.1
        mtext(BREITE \ 2, HOEHE - 108, klangname[letzter_klang], _
              0.7 + 0.5 * b, dunkler(klangfarbe[letzter_klang], b))
    END IF
END SUB

DIM letzte_szene AS INTEGER
letzte_szene = -1

' NACH den Deklarationen: Top-Level-Anweisungen laufen der Reihe nach, ein
' Aufruf davor faende die Arrays noch nicht.
klaviatur_bauen()

' ----------------------------------------------------------------------
'  HAUPTSCHLEIFE
' ----------------------------------------------------------------------
WHILE NOT QUITREQUESTED()
    IF KEYHIT(KEY_ESCAPE) THEN BREAK
    IF KEYHIT(KEY_F11) THEN SET_FULLSCREEN(NOT WINDOW_IS_FULLSCREEN())

    dt = DELTA()
    IF dt > 0.1 THEN dt = 0.1
    zeit = AUDIO_MUSIC_POSITION() + versatz

    ' Zifferntasten 1-8 springen direkt in eine Szene (zum Vorfuehren).
    ' versatz verschiebt nur den ABLAUFPLAN -- die Musik laeuft weiter, wo
    ' sie ist. Fuer ein Vorfuehren reicht das; die Demo bleibt in sich rund.
    IF KEYHIT(KEY_1) THEN versatz = versatz - zeit
    IF KEYHIT(KEY_2) THEN versatz = versatz + (T1 - zeit)
    IF KEYHIT(KEY_3) THEN versatz = versatz + (T2 - zeit)
    IF KEYHIT(KEY_4) THEN versatz = versatz + (T3 - zeit)
    IF KEYHIT(KEY_5) THEN versatz = versatz + (T4 - zeit)
    IF KEYHIT(KEY_6) THEN versatz = versatz + (T5 - zeit)
    IF KEYHIT(KEY_7) THEN versatz = versatz + (T6 - zeit)
    IF KEYHIT(KEY_8) THEN versatz = versatz + (T7 - zeit)

    ' Leertaste = zur naechsten Szene springen (zum Vorfuehren)
    IF KEYHIT(KEY_SPACE) THEN
        IF zeit < T1 THEN
            versatz = versatz + (T1 - zeit)
        ELSEIF zeit < T2 THEN
            versatz = versatz + (T2 - zeit)
        ELSEIF zeit < T3 THEN
            versatz = versatz + (T3 - zeit)
        ELSEIF zeit < T4 THEN
            versatz = versatz + (T4 - zeit)
        ELSEIF zeit < T5 THEN
            versatz = versatz + (T5 - zeit)
        ELSEIF zeit < T6 THEN
            versatz = versatz + (T6 - zeit)
        ELSEIF zeit < T7 THEN
            versatz = versatz + (T7 - zeit)
        END IF
    END IF

    ' Am Ende wieder von vorn: die Musik loopt endlos, der Ablaufplan muss
    ' mit. (Sich auf ein Zurueckspringen der Musik-Position zu verlassen
    ' waere heikel -- diese Zeile funktioniert so oder so.)
    IF zeit >= T8 THEN
        versatz = versatz - T8
        zeit = zeit - T8
    END IF

    klaviatur_bedienen()
    spektrum_lesen()

    ' Szenennummer aus der Zeit ableiten und den 3D-Zustand nur bei einem
    ' echten Wechsel umstellen (Skybox/Schatten jedes Bild neu zu setzen
    ' waere Verschwendung).
    DIM neue AS INTEGER
    neue = 1
    IF zeit >= T1 THEN neue = 2
    IF zeit >= T2 THEN neue = 3
    IF zeit >= T3 THEN neue = 4
    IF zeit >= T4 THEN neue = 5
    IF zeit >= T5 THEN neue = 6
    IF zeit >= T6 THEN neue = 7
    IF zeit >= T7 THEN neue = 8
    IF neue <> letzte_szene THEN
        szene_start(neue)
        letzte_szene = neue
    END IF

    CLS(&H05070C)

    IF zeit < T1 THEN
        szene = 1
        szene_t = zeit
        blende = randblende(szene_t, T1, 1.5)
        szene_titel()
    ELSEIF zeit < T2 THEN
        szene = 2
        szene_t = zeit - T1
        blende = randblende(szene_t, T2 - T1, 1.5)
        szene_sterne()
    ELSEIF zeit < T3 THEN
        szene = 3
        szene_t = zeit - T2
        blende = randblende(szene_t, T3 - T2, 1.5)
        szene_instancing()
    ELSEIF zeit < T4 THEN
        szene = 4
        szene_t = zeit - T3
        blende = randblende(szene_t, T4 - T3, 1.5)
        szene_pbr()
    ELSEIF zeit < T5 THEN
        szene = 5
        szene_t = zeit - T4
        blende = randblende(szene_t, T5 - T4, 1.5)
        szene_physik()
    ELSEIF zeit < T6 THEN
        szene = 6
        szene_t = zeit - T5
        blende = randblende(szene_t, T6 - T5, 1.5)
        szene_tunnel()
    ELSEIF zeit < T7 THEN
        szene = 7
        szene_t = zeit - T6
        blende = randblende(szene_t, T7 - T6, 1.5)
        szene_klang()
    ELSE
        szene = 8
        szene_t = zeit - T7
        blende = randblende(szene_t, T8 - T7, 2.5)
        szene_abspann()
    END IF

    klaviatur_zeigen()

    ' Post-Effekt mit den Werten dieses Bildes fuettern
    SHADER_SET(sh, "time", zeit)
    SHADER_SET(sh, "bass", bass)
    SHADER_SET(sh, "hoehen", hoehen)
    SHADER_SET(sh, "fade", blende)
    SHADER_SET(sh, "mode", modus)
    POSTFX(sh)

    FLIP()
WEND
