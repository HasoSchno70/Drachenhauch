IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("_programm/rechnungen.db")
FUNCTION zahl(sql AS STRING) AS INTEGER
    DIM r AS DB_RESULT : r = DB_QUERY(db, sql)
    DIM n AS INTEGER : n = -1
    IF DB_NEXT(r) THEN n = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN n
END FUNCTION
FUNCTION text$(sql AS STRING) AS STRING
    DIM r AS DB_RESULT : r = DB_QUERY(db, sql)
    DIM s AS STRING : s = ""
    IF DB_NEXT(r) THEN s = DB_GET_STRING(r, 0)
    DB_CLOSE_RESULT(r)
    RETURN s
END FUNCTION
PRINT zahl("SELECT COUNT(*) FROM kunden")
--- erwartet
3

=== wechsel mit aenderung fragt nach und esc bricht ab
' Eine Eingabe, dann ein Klick auf einen anderen Kunden: die Rueckfrage steht
' offen, ESC bricht ab -- die Eingabe bleibt, und man bleibt beim neuen Kunden.
SET_WINDOW_POS(-3000, -3000)
DIM prBild AS INTEGER : prBild = 0
DIM prStart AS INTEGER : prStart = -1
DIM prF AS ARRAY OF INTEGER : prF = []
DIM prZ AS ARRAY OF STRING : prZ = []
DIM prFlag AS STRING : prFlag = ""
DIM prA AS INTEGER : prA = 0
DIM prB AS INTEGER : prB = 0
DIM prC AS INTEGER : prC = 0
DIM prD AS INTEGER : prD = 0
SUB prE(f AS INTEGER, typ AS INTEGER, a AS INTEGER, b AS INTEGER)
    ARRAY_PUSH(prF, f)
    ARRAY_PUSH(prZ, STR$(typ) + " " + STR$(a) + " " + STR$(b) + " 0 0")
END SUB
SUB prKlick(f AS INTEGER, x AS INTEGER, y AS INTEGER)
    prE(f, 7, x, y)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 5, 0, 0)
END SUB
SUB prTaste(f AS INTEGER, code AS INTEGER, modifier AS INTEGER)
    IF modifier > 0 THEN prE(f, 2, modifier, 0)
    prE(f + 1, 2, code, 0)
    prE(f + 2, 1, code, 0)
    IF modifier > 0 THEN prE(f + 3, 1, modifier, 0)
END SUB
FUNCTION prMx(w AS GUI_WIDGET) AS INTEGER
    RETURN GUI_CANVAS_X(nullpunkt) + GUI_GET_X(w) + GUI_GET_W(w) \ 2
END FUNCTION
FUNCTION prMy(w AS GUI_WIDGET) AS INTEGER
    RETURN GUI_CANVAS_Y(nullpunkt) + GUI_GET_Y(w) + GUI_GET_H(w) \ 2
END FUNCTION
SUB prAbspielen()
    ' Ein Ereignis in Bild 0 -- die Wiedergabe setzt beim ERSTEN an.
    prE(0, 7, 0, 0)
    DIM i AS INTEGER
    DIM j AS INTEGER
    DIM weiter AS BOOLEAN
    DIM tf AS INTEGER
    DIM tz AS STRING
    FOR i = 1 TO LEN(prF) - 1
        j = i
        weiter = TRUE
        WHILE weiter
            weiter = FALSE
            IF j > 0 THEN
                IF prF[j - 1] > prF[j] THEN
                    tf = prF[j] : prF[j] = prF[j - 1] : prF[j - 1] = tf
                    tz = prZ[j] : prZ[j] = prZ[j - 1] : prZ[j - 1] = tz
                    j = j - 1
                    weiter = TRUE
                END IF
            END IF
        WEND
    NEXT
    DIM t AS STRING : t = "# Test-Aufnahme" + CHR$(10) + "c " + STR$(LEN(prF)) + CHR$(10)
    FOR i = 0 TO LEN(prF) - 1
        t = t + "e " + STR$(prF[i]) + " " + prZ[i] + CHR$(10)
    NEXT
    WRITEALL("ev.txt", t)
    AUTOMATION_PLAY("ev.txt")
    prStart = prBild
END SUB
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
SUB prFall()
    prKlick(3, prMx(tfKName), prMy(tfKName))
    prTaste(7, 86, 341)
    prKlick(12, GUI_CANVAS_X(nullpunkt) + GUI_GET_X(tKunden) + 60, GUI_CANVAS_Y(nullpunkt) + GUI_GET_Y(tKunden) + 52)
    prTaste(18, 256, 0)
    prAbspielen()
END SUB
--- programm ../../examples/196_rechnungen.dh nach SETFPS(60)
--- einschub nach GUI_WINDOW_CHROME(win, FALSE)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(win, 0, 0, 1, 1)

--- einschub nach GUI_FOCUS(tfKName)
CLIPBOARD_SET("Geaendert")

--- einschub nach FLIP()
prBild = prBild + 1
IF prBild = 3 THEN prFall()
IF GUI_MODAL() THEN prMerke("rueckfrage stand offen")
prSchreib("modal " + prJa$(GUI_MODAL()) + " kName " + GUI_TEXT(tfKName) + " kundeId " + STR$(kundeId) + " kSel " + STR$(GUI_TABLE_SELECTED(tKunden)))

