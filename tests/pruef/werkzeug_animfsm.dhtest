' Der Anim-FSM-Editor in Drachenhauch (examples/198_anim_fsm_editor.dh) --
' ohne Python geprueft. Bis Stufe 33 stand das in tests/test_pilot_animfsm.py.
'
' Echte Klicks ueber eine Aufnahme (Einschub hinter SETFPS(60)); die Kopie
' laeuft ohne WINDOW_MAXIMIZE, damit die Lagen fest sind (1280 x 800:
' Graph-Ursprung 290/20, Inspektor ab x = 940). Was der Editor sichert, liest
' danach die LAUFZEIT (--- nachher: JSON_* und ANIM_FSM_LOAD plus ein Schritt
' der Maschine) -- dass die JSON gueltig ist, waere die schwaechere Aussage;
' ein Uebergang zu einem geloeschten Zustand laedt nicht.
' In der Aufnahme: 7 Mauslage, 6 Taste runter, 5 hoch, 2 Taste runter, 1 hoch.
--- seriell

=== doppelklick legt einen zustand an
' Doppelklick auf freie Flaeche (700,500) -> (700-290-75, 500-20-25) aufs Raster.
AUTOMATION_PLAY("ev.txt")
--- programm ../../examples/198_anim_fsm_editor.dh nach SETFPS(60)
--- streichen WINDOW_MAXIMIZE()
--- argumente
neu.dhanim
--- umgebung
DHRT_FRAMES=100
DH_ANIM_LOG=anim.log
--- datei _programm/ev.txt
c 12
e 20 7 700 500 0 0
e 21 7 700 500 0 0
e 21 6 0 0 0 0
e 23 5 0 0 0 0
e 26 7 700 500 0 0
e 27 7 700 500 0 0
e 27 6 0 0 0 0
e 29 5 0 0 0 0
e 60 2 341 0 0 0
e 60 2 83 0 0 0
e 62 1 83 0 0 0
e 62 1 341 0 0 0

--- inhalt _programm/anim.log
neu-datei
zustand state 336 456
gesichert
--- nachher
IMPORT "json"
IMPORT "animfsm"
IMPORT "sprite"
FUNCTION zustand$(datei AS STRING, speed AS FLOAT, schritt AS BOOLEAN) AS STRING
    DIM sp AS SPRITE : sp = SPRITE_NEW(0, 16, 16)
    DIM fsm AS ANIM_FSM : fsm = ANIM_FSM_LOAD(datei)
    ANIM_FSM_SETUP(fsm, sp)
    IF schritt THEN
        ANIM_FSM_SET_FLOAT(fsm, "speed", speed)
        ANIM_FSM_UPDATE(fsm, sp, 16)
    END IF
    RETURN ANIM_FSM_STATE(fsm)
END FUNCTION
DIM h AS JSON_HANDLE : h = JSON_LOAD("neu.dhanim")
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(h, "states") - 1
    DIM p AS STRING : p = "states." + STR$(i)
    PRINT JSON_GET_STRING(h, p + ".name") ; " " ; JSON_GET_INT(h, p + ".x") ; " " ; JSON_GET_INT(h, p + ".y") ; " " ; JSON_GET_INT(h, p + ".first") ; " " ; JSON_GET_INT(h, p + ".last")
NEXT
PRINT "laufzeit " + zustand$("neu.dhanim", 0.0, FALSE)
--- erwartet
state 336 456 0 0
laufzeit state

