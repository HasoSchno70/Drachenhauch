' Was eine neue Datei beim ersten Start bekommt -- die Startdaten der
' Python-App (database_initializer.py), auf den Aufbau ihrer echten Datei
' gebracht: neun Lagerorte (Temperatur -> Zone frozen/cold/cool/room_temp),
' 18 Kategorien mit Lagerort und Haltbarkeit, 20 Einheiten und die
' Einstellungen, wie config.py sie vorgibt. Je Eintrag eine Zeile mit |.
IMPORT "db"

FUNCTION startLagerorte() AS ARRAY OF STRING
    RETURN ["Kühlschrank|❄️|Hauptfach für verderbliche Lebensmittel|4|refrigerator", _
            "Gefrierschrank|🧊|Tiefgekühlte Lebensmittel|-18|freezer", _
            "Vorratsraum|🏠|Trockene Lebensmittel und Konserven|18|pantry", _
            "Gemüsefach|🥬|Obst und Gemüse bei optimaler Feuchtigkeit|8|refrigerator", _
            "Obstschale|🍎|Reifendes Obst bei Raumtemperatur|20|custom", _
            "Speisekammer|🗄️|Vorräte und haltbare Lebensmittel|16|pantry", _
            "Kühlschranktür|🚪|Getränke, Saucen, Butter|6|refrigerator", _
            "Brotkasten|🍞|Brot und Backwaren|18|container", _
            "Gewürzregal|🧂|Gewürze und Kräuter|18|pantry"]
END FUNCTION

FUNCTION startKategorien() AS ARRAY OF STRING
    RETURN ["Milchprodukte|🥛|Kühlschrank|7", "Fleisch & Wurst|🥩|Kühlschrank|4", _
            "Fisch & Meeresfrüchte|🐟|Kühlschrank|2", "Obst|🍎|Obstschale|7", _
            "Gemüse|🥬|Gemüsefach|7", "Backwaren|🍞|Brotkasten|5", _
            "Tiefkühlkost|🧊|Gefrierschrank|90", "Getränke|🥤|Vorratsraum|180", _
            "Konserven|🥫|Vorratsraum|365", "Grundnahrungsmittel|🌾|Vorratsraum|180", _
            "Süßwaren|🍬|Vorratsraum|90", "Saucen & Gewürze|🧂|Gewürzregal|365", _
            "Eier|🥚|Kühlschrank|21", "Kaffee & Tee|☕|Vorratsraum|365", _
            "Fertiggerichte|🍱|Kühlschrank|5", "Bio-Produkte|🌿|Kühlschrank|5", _
            "Snacks|🍿|Vorratsraum|60", "Aufstriche|🧈|Kühlschrank|14"]
END FUNCTION

' Die Einheiten, die die Python-App ohne eigene Tabelle anbietet (inventory.py).
FUNCTION startEinheiten() AS ARRAY OF STRING
    RETURN ["Stück", "Stk", "g", "kg", "ml", "l", "Liter", "Packung", "Pkg", "Flasche", _
            "Dose", "Glas", "Beutel", "Becher", "Schale", "Bund", "Tube", "Tafel", "Riegel", "Scheibe"]
END FUNCTION

' Schlüssel und Wert (JSON) wie in app_settings der Python-App.
FUNCTION startEinstellungen() AS ARRAY OF STRING
    RETURN ["expiring_days_threshold|3", "auto_refresh_interval_ms|30000", _
            "default_expiry_days|7", "default_unit|" + CHR$(34) + "Stück" + CHR$(34), _
            "notifications_enabled|true", "notify_on_expired|true", _
            "notify_on_expiring_today|true", "notify_on_expiring_tomorrow|true", _
            "notify_on_expiring_soon|true", "notify_on_below_minimum|true", _
            "notification_check_interval_ms|3600000", "daily_summary_enabled|true", _
            "daily_summary_hour|9"]
END FUNCTION

' Die Temperatur eines Lagerorts als Zone, wie die Python-App sie speichert.
FUNCTION temperaturZone$(grad AS INTEGER) AS STRING
    IF grad < 0 THEN RETURN "frozen"
    IF grad <= 8 THEN RETURN "cold"
    IF grad <= 16 THEN RETURN "cool"
    RETURN "room_temp"
END FUNCTION

SUB startdatenAnlegen()
    DB_BEGIN(db)
    DIM z AS STRING
    DIM n AS INTEGER : n = 0
    FOR EACH z IN startLagerorte()
        DIM f AS ARRAY OF STRING : f = SPLIT(z, "|")
        DIM zone AS STRING : zone = temperaturZone$(INT(VAL(f[3])))
        n = n + 1
        DB_EXEC(db, "INSERT OR IGNORE INTO storage_locations (name, icon, temperature_zone, description) VALUES (?, ?, ?, ?)", f[0], f[1], zone, f[2])
        DB_EXEC(db, "INSERT OR IGNORE INTO locations (name, type, temperature_zone, icon, sort_order) VALUES (?, ?, ?, ?, ?)", f[0], f[4], zone, f[1], n)
    NEXT
    FOR EACH z IN startKategorien()
        DIM k AS ARRAY OF STRING : k = SPLIT(z, "|")
        DB_EXEC(db, "INSERT OR IGNORE INTO categories (name, icon, recommended_storage, typical_shelf_life_days) VALUES (?, ?, ?, ?)", k[0], k[1], k[2], INT(VAL(k[3])))
    NEXT
    FOR EACH z IN startEinheiten()
        DB_EXEC(db, "INSERT OR IGNORE INTO units (name) VALUES (?)", z)
    NEXT
    FOR EACH z IN startEinstellungen()
        DIM p AS INTEGER : p = INSTR(z, "|")
        DB_EXEC(db, "INSERT OR IGNORE INTO app_settings (key, value) VALUES (?, ?)", LEFT$(z, p), MID$(z, p + 1, LEN(z)))
    NEXT
    DB_COMMIT(db)
END SUB
