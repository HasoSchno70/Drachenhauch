=== loeschen und zurueck in einer datei mit fremdschluessel
' Im Aufbau der Python-App haengen die Zutaten mit FOREIGN KEY ... ON DELETE
' CASCADE am Rezept, foreign_keys ist an. Rueckgaengig muss das Rezept vor
' seinen Zutaten wieder einsetzen -- darum merkt das Loeschen erst die
' Zutaten, dann das Rezept (Rueckgaengig geht rueckwaerts).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM db AS DB_CONN : db = DB_OPEN(p + "/fridge_database.db")
DB_EXEC(db, "CREATE TABLE recipes ( id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, description TEXT, servings INTEGER DEFAULT 1, instructions TEXT, prep_time_minutes INTEGER, cook_time_minutes INTEGER, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP )")
DB_EXEC(db, "CREATE TABLE products ( id INTEGER PRIMARY KEY AUTOINCREMENT, barcode TEXT UNIQUE, name TEXT NOT NULL, brand TEXT, category TEXT, image_url TEXT, min_quantity REAL, min_unit TEXT, default_storage_location TEXT, default_shelf_life_days INTEGER, nutritional_info TEXT, allergens TEXT, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP )")
DB_EXEC(db, "CREATE TABLE recipe_ingredients ( id INTEGER PRIMARY KEY AUTOINCREMENT, recipe_id INTEGER NOT NULL, product_id INTEGER, product_name TEXT NOT NULL, quantity REAL NOT NULL, unit TEXT NOT NULL, notes TEXT, FOREIGN KEY (recipe_id) REFERENCES recipes (id) ON DELETE CASCADE, FOREIGN KEY (product_id) REFERENCES products (id) ON DELETE SET NULL )")
DB_EXEC(db, "INSERT INTO recipes (name, servings) VALUES ('Rührei', 1)")
DB_EXEC(db, "INSERT INTO recipe_ingredients (recipe_id, product_name, quantity, unit) VALUES (1, 'Ei', 3, 'Stück'), (1, 'Butter', 10, 'g')")
DB_CLOSE(db)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
' Die Probe soll die Datei im Projektordner nehmen, nicht eine eigene in _studio.
SETENV("DH_STUDIO_DATEN", p)
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
FUNCTION stand$() AS STRING
    RETURN JOIN$(textListe("SELECT id || ':' || name FROM recipes ORDER BY id"), " ") + " | " + JOIN$(textListe("SELECT id || ':' || recipe_id || ':' || product_name FROM recipe_ingredients ORDER BY id"), " ")
END FUNCTION
PRINT "fremdschluessel "; dbZahl("PRAGMA foreign_keys"); " | "; stand$()
rezeptLoeschen(1, "Rührei")
PRINT "geloescht ["; stand$(); "]"
PRINT "zurueck "; verlauf.rueckgaengig$(); " | "; stand$()
PRINT "wieder "; verlauf.wiederholen$(); " | ["; stand$(); "]"
--- erwartet
fremdschluessel 1 | 1:Rührei | 1:1:Ei 2:1:Butter
geloescht [ | ]
zurueck Rührei gelöscht | 1:Rührei | 1:1:Ei 2:1:Butter
wieder Rührei gelöscht | [ | ]
code 0

=== echt: doppelklick, details, kochen mit enter, papierkorb, strg+z
' Doppelklick auf Ruehrei oeffnet die Details; Enter ist dort und im
' Kochen-Dialog "Jetzt kochen!" (Standard-Knopf), dann Enter fuer die Frage
' und die Meldung -- Ei 10 -> 7, Butter 250 -> 240. Der Papierkorb bei Toast
' fragt (Enter), Strg+Z holt Toast zurueck.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 10)
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
FUNCTION z(i AS INTEGER) AS INTEGER
    RETURN INT(VAL(w[i]))
END FUNCTION
DIM zy0 AS INTEGER : zy0 = z(3) + z(4) + z(5) \ 2
DIM sx AS INTEGER : sx = z(2) + kSpalteMitte(p, "RezepteSeite", "tabelle", 0)
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slKlick(z(0), z(1))
slWarten(10)
slHin(sx, zy0)
slHin(sx, zy0)
slRunter()
slHoch()
slRunter()
slHoch()
slWarten(20)
slTaste(257)
slWarten(20)
slTaste(257)
slWarten(20)
slTaste(257)
slWarten(20)
slTaste(257)
slWarten(20)
slKlick(z(2) + kSpalteMitte(p, "RezepteSeite", "tabelle", SP_R_WEG_PROBE), zy0 + z(5))
slWarten(15)
slTaste(257)
slWarten(15)
slMit([341], 90)
slWarten(10)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 30)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
' Die Spalte des Papierkorbs (SP_R_WEG in RezepteSeite.dh).
CONST SP_R_WEG_PROBE = 7
--- datei daten.dh
' Messlauf und Abspiellauf teilen die Datei: jedes Mal frisch.
DB_EXEC(db, "DELETE FROM recipe_ingredients")
DB_EXEC(db, "DELETE FROM recipes")
DB_EXEC(db, "DELETE FROM inventory")
DB_EXEC(db, "DELETE FROM products")
DB_EXEC(db, "DELETE FROM consumption_history")
DB_EXEC(db, "INSERT INTO recipes (name, servings, prep_time_minutes, cook_time_minutes) VALUES ('Rührei', 1, 2, 5), ('Toast', 1, 1, 3)")
DB_EXEC(db, "INSERT INTO recipe_ingredients (recipe_id, product_name, quantity, unit) VALUES (1, 'Ei', 3, 'Stück'), (1, 'Butter', 10, 'g'), (2, 'Brot', 2, 'Scheiben')")
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Ei'), ('Butter')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 10, 'Stück', '2026-11-20'), (2, 250, 'g', '2026-11-25')")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS RezepteSeite : s = f.rezepte
f.geaendert()
--- datei mess.dh
IMPORT "../../daten.dh"
GUI_TABCONTROL_SET_PAGE(f.reiter, 4)
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
DIM rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER
(rx, ry, rw, rh) = GUI_TABCONTROL_ITEM_RECT(f.reiter, 4)
WRITEALL("lage.txt", STR$(rx + rw \ 2) + " " + STR$(ry + rh \ 2) + " " + _
    STR$(GUI_GET_X(s.tabelle)) + " " + STR$(GUI_GET_Y(s.tabelle) + 26) + " " + STR$(INT(GUI_TABLE_GET(s.tabelle, "kopfhoehe"))) + " " + STR$(INT(GUI_TABLE_GET(s.tabelle, "zeilenhoehe"))))
--- datei klick.dh
IMPORT "../../daten.dh"
FUNCTION stand$() AS STRING
    RETURN JOIN$(textListe("SELECT p.name || ':' || i.quantity FROM inventory i JOIN products p ON p.id = i.product_id ORDER BY i.id"), " ") + " | " + JOIN$(textListe("SELECT name FROM recipes ORDER BY id"), " ") + " / Seite " + STR$(GUI_TABCONTROL_PAGE(f.reiter))
END FUNCTION
DIM folge AS ARRAY OF STRING : folge = []
DIM war AS STRING : war = ""
WHILE studioBild()
    DIM jetzt AS STRING : jetzt = stand$()
    IF jetzt <> war THEN ARRAY_PUSH(folge, jetzt)
    war = jetzt
WEND
PRINT JOIN$(folge, " -> ")
PRINT "verlauf "; JOIN$(textListe("SELECT product_name || ':' || quantity || ':' || reason FROM consumption_history ORDER BY id"), " "); " | status "; GUI_STATUSBAR_TEXT$(f.status, 3)
--- erwartet
Ei:10.0 Butter:250.0 | Rührei Toast / Seite 0 -> Ei:10.0 Butter:250.0 | Rührei Toast / Seite 4 -> Ei:7.0 Butter:240.0 | Rührei Toast / Seite 4 -> Ei:7.0 Butter:240.0 | Rührei / Seite 4 -> Ei:7.0 Butter:240.0 | Rührei Toast / Seite 4
verlauf  | status Rückgängig: Toast gelöscht
