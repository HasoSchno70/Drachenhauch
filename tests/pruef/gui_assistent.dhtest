' GUI_WIZARD -- Schritte mit Schrittanzeige und Zurueck/Weiter/Fertig/
' Abbrechen. Randloses Fenster bei (0,0); der Assistent liegt bei (10,10)
' mit 400x250: die Knopfreihe beginnt bei y 212, die Knoepfe sind 112x30
' bei y 221 -- Weiter ab x 288, Zurueck ab x 168, Abbrechen ab x 20.
' Format: docs/werkzeuge.md.

=== schritte zaehlen setzen und fehler
IMPORT "gui"
SCREEN(440, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 440, 300)
DIM wz AS GUI_WIDGET : wz = GUI_WIZARD(w, 10, 10, 400, 250)
GUI_WIZARD_ADD(wz, "Konto")
GUI_WIZARD_ADD(wz, "Adresse")
GUI_WIZARD_ADD(wz, "Fertig")
PRINT GUI_WIZARD_COUNT(wz); " "; GUI_WIZARD_STEP(wz)
GUI_WIZARD_SET_STEP(wz, 2)
PRINT GUI_WIZARD_STEP(wz)
PRINT "zurueck "; GUI_WIZARD_BACK(wz); " "; GUI_WIZARD_STEP(wz)
PRINT "weiter "; GUI_WIZARD_NEXT(wz); " "; GUI_WIZARD_STEP(wz)
PRINT "am ende "; GUI_WIZARD_NEXT(wz); " "; GUI_WIZARD_STEP(wz)
GUI_WIZARD_SET_STEP(wz, 0)
PRINT "am anfang zurueck "; GUI_WIZARD_BACK(wz)
GUI_WIZARD_ENABLE_NEXT(wz, FALSE)
PRINT "gesperrt "; GUI_WIZARD_NEXT(wz); " "; GUI_WIZARD_STEP(wz)
TRY
    GUI_WIZARD_SET_STEP(wz, 7)
CATCH e
    PRINT e
END TRY
TRY
    GUI_WIZARD_SET(wz, "schnell", 1)
CATCH e
    PRINT e
END TRY
--- erwartet
3 0
2
zurueck TRUE 1
weiter TRUE 2
am ende TRUE 2
am anfang zurueck FALSE
gesperrt FALSE 0
GUI_WIZARD_SET_STEP: Schritt 7 gibt es nicht
GUI_WIZARD_SET: unbekannter Schluessel 'schnell' (erlaubt: pruefen)

=== die knoepfe blaettern und melden je ein bild
IMPORT "gui"
SCREEN(440, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 440, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM wz AS GUI_WIDGET : wz = GUI_WIZARD(w, 10, 10, 400, 250)
GUI_WIZARD_ADD(wz, "Eins")
GUI_WIZARD_ADD(wz, "Zwei")
DIM bild AS INTEGER : bild = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_WIZARD_CHANGED(wz) THEN PRINT "bild "; bild; " schritt "; GUI_WIZARD_STEP(wz)
    IF GUI_WIZARD_FINISHED(wz) THEN PRINT "bild "; bild; " fertig"
    IF GUI_WIZARD_CANCELLED(wz) THEN PRINT "bild "; bild; " abgebrochen"
    bild = bild + 1
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
