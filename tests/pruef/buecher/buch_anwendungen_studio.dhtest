' Buch "Fenster, Formulare, Daten", Kapitel 8: das Studio-Projekt der
' Mediathek und die Loesung mit dem Info-Fenster. Das Studio laeuft als
' Kind (_hilfen/studiolauf.dh) auf einer Kopie, drueckt F5 und laesst das
' erzeugte Programm einige Bilder laufen.
'
' Das Kapitel zitiert eine Zeile aus dem erzeugten Code und eine Meldung
' zu einem vertippten Namen -- beide prueft der Fall am echten Ergebnis.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== f5 auf mediathek und loesung, die zitierte zeile, der vertippte name
IMPORT "laeufer.dh"
IMPORT "imgfx"
SUB kopieren(von AS STRING, nach AS STRING)
    IF NOT DIREXISTS(nach) THEN MKDIR(nach)
    DIM n AS STRING
    FOR EACH n IN DIRLIST(von)
        IF DIREXISTS(von + "/" + n) THEN
            IF n <> "_studio" THEN kopieren(von + "/" + n, nach + "/" + n)
        ELSE
            COPYFILE(von + "/" + n, nach + "/" + n)
        END IF
    NEXT
END SUB

DIM code AS STRING : code = ARG$(1) + "/buecher/anwendungen/code/"
DIM proj AS STRING
FOR EACH proj IN ["kap08/mediathek", "loesungen/kap08_info", "kap09/mediathek", _
                  "loesungen/kap09_vollbild", "loesungen/kap09_entfernen", _
                  "kap10/mediathek", "loesungen/kap10_statistik", _
                  "loesungen/kap10_alstext"]
    ' Zwei Projekte heissen mediathek (Kapitel 8 und 9): der Ordner der
    ' Kopie bekommt den Namen des Kapitels davor.
    DIM nm AS STRING : nm = BASENAME(proj)
    IF nm = "mediathek" AND LEFT$(proj, 5) <> "kap08" THEN nm = LEFT$(proj, 5) + "_" + nm
    DIM p AS STRING : p = CWD$() + "/" + nm
    kopieren(code + proj, p)
    slZeilen = []
    slBild = 0
    slHin(10, 10)
    slWarten(10)
    slTaste(294)
    slWarten(150)
    slAufnahmeSchreiben(CWD$() + "/ev.txt")
    SETENV("DH_STUDIO_LAUF_BILDER", "20")
    DIM log AS STRING : log = CWD$() + "/" + nm + ".log"
    DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
    PRINT nm; " geprueft "; slHat(log, "geprueft 0 0"); " beendet "; slHat(log, "beendet 0")
    IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
NEXT

' Kapitel 9: das erzeugte Programm mit echter Bedienung. Die Aufnahme
' spielt Tasten und Klicks ab (Lagen im Fenster), DHRT_GUI_ZUSTAND schreibt
' am Ende den Zustand der Widgets.
FUNCTION bedienen$(main AS STRING, ev AS ARRAY OF STRING, bilder AS INTEGER) AS STRING
    DIM pf AS STRING : pf = CWD$() + "/bedienung.txt"
    WRITEALL(pf, "c " + STR$(LEN(ev)) + CHR$(10) + JOIN$(ev, CHR$(10)) + CHR$(10) + CHR$(10))
    SETENV("DHRT_ABSPIELEN", pf)
    SETENV("DHRT_GUI_ZUSTAND", "1")
    DIM q AS INTEGER : q = PROCESS_START("dhrt", "run", "--bilder", STR$(bilder), main)
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(q) + PROCESS_ERR$(q)
        aus = aus + t
        IF t = "" AND NOT PROCESS_RUNNING(q) THEN leer = leer + 1
        SLEEP(20)
    WEND
    SETENV("DHRT_ABSPIELEN", "")
    SETENV("DHRT_GUI_ZUSTAND", "")
    RETURN aus
END FUNCTION
FUNCTION tabs(n AS INTEGER) AS ARRAY OF STRING
    DIM ev AS ARRAY OF STRING : ev = ["e 0 7 600 540 0 0"]
    DIM b AS INTEGER : b = 6
    DIM k AS INTEGER
    FOR k = 1 TO n
        ARRAY_PUSH(ev, "e " + STR$(b) + " 2 258 0 0 0")
        ARRAY_PUSH(ev, "e " + STR$(b + 1) + " 1 258 0 0 0")
        b = b + 4
    NEXT
    ARRAY_PUSH(ev, "e " + STR$(b) + " 2 32 0 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 1) + " 1 32 0 0 0")
    RETURN ev
END FUNCTION
DIM m9 AS STRING : m9 = CWD$() + "/kap09_mediathek/_studio/main.dh"
' Vier Tabs vom Titel aus und die Leertaste: Speichern (Tab-Folge 5)
' meldet den leeren Titel. Nach drei Tabs steht der Fokus im Jahr.
PRINT "tab 4 "; INSTR(bedienen$(m9, tabs(4), 40), "Bitte einen Titel eingeben.") >= 0
PRINT "tab 3 "; INSTR(bedienen$(m9, tabs(3), 40), "3 Eintr") >= 0
' Erweitern 1: F11 aus dem Menue maximiert -- das Fenster wird breiter
' als im Entwurf (760).
DIM mv AS STRING : mv = CWD$() + "/kap09_vollbild/_studio/main.dh"
DIM vev AS STRING : vev = CWD$() + "/f11.txt"
WRITEALL(vev, "c 3" + CHR$(10) + "e 0 7 600 540 0 0" + CHR$(10) + "e 6 2 300 0 0 0" + _
              CHR$(10) + "e 8 1 300 0 0 0" + CHR$(10) + CHR$(10))
SETENV("DHRT_ABSPIELEN", vev)
DIM vpng AS STRING : vpng = CWD$() + "/vollbild.png"
DIM vq AS INTEGER : vq = PROCESS_START("dhrt", "bild", mv, vpng, "40")
WHILE PROCESS_RUNNING(vq)
    SLEEP(50)
WEND
SETENV("DHRT_ABSPIELEN", "")
DIM vbild AS IMAGE : vbild = IMAGE_LOAD(vpng)
PRINT "vollbild "; IMAGE_WIDTH(vbild) > 760
' Erweitern 2: ein Klick auf "Entfernen" ohne Auswahl, dann auf Momo und
' wieder auf "Entfernen": erst jetzt ist er frei und entfernt eine Zeile.
DIM me AS STRING : me = CWD$() + "/kap09_entfernen/_studio/main.dh"
DIM ee AS ARRAY OF STRING
ee = ["e 0 7 470 503 0 0", "e 2 7 470 503 0 0", "e 4 6 0 0 0 0", "e 6 5 0 0 0 0"]
ARRAY_PUSH(ee, "e 10 7 100 203 0 0") : ARRAY_PUSH(ee, "e 12 7 100 203 0 0")
ARRAY_PUSH(ee, "e 14 6 0 0 0 0") : ARRAY_PUSH(ee, "e 16 5 0 0 0 0")
ARRAY_PUSH(ee, "e 20 7 470 503 0 0") : ARRAY_PUSH(ee, "e 22 7 470 503 0 0")
ARRAY_PUSH(ee, "e 24 6 0 0 0 0") : ARRAY_PUSH(ee, "e 26 5 0 0 0 0")
PRINT "frei "; INSTR(bedienen$(me, ee, 40), "2 Eintr") >= 0

' Kapitel 10: ein Doppelklick auf Metropolis laedt es ins Formular; die
' Loesungen zaehlen je Art und zeigen einen Eintrag als Satz.
DIM m10 AS STRING : m10 = CWD$() + "/kap10_mediathek/_studio/main.dh"
DIM dk AS ARRAY OF STRING
dk = ["e 0 7 100 223 0 0", "e 2 7 100 223 0 0", "e 4 6 0 0 0 0", "e 5 5 0 0 0 0", _
      "e 7 6 0 0 0 0", "e 8 5 0 0 0 0", "e 12 7 600 540 0 0", "e 14 7 600 540 0 0"]
PRINT "doppelklick "; INSTR(bedienen$(m10, dk, 30), "feldtitel " + CHR$(34) + "Metropolis") >= 0
DIM ms AS STRING : ms = CWD$() + "/kap10_statistik/_studio/main.dh"
PRINT "statistik "; INSTR(bedienen$(ms, ["e 0 7 600 540 0 0"], 5), "Buch 2, Film 1, Spiel 1, Musik 1") >= 0
DIM ma AS STRING : ma = CWD$() + "/kap10_alstext/_studio/main.dh"
DIM kl AS ARRAY OF STRING
kl = ["e 0 7 100 223 0 0", "e 2 7 100 223 0 0", "e 4 6 0 0 0 0", "e 5 5 0 0 0 0", "e 9 7 600 540 0 0"]
