=== select treewalker[DIM x AS INTEGER\nx = 2\nSELECT CASE x\n    CASE 1\n        PRINT "eins"\n    CASE 2\n        PRINT "zwei"\n    CASE 3\n        PRINT "drei"\n    CASE ELSE\n        PRINT "anders"\nEND SELECT\n-zwei\n]
DIM x AS INTEGER
x = 2
SELECT CASE x
    CASE 1
        PRINT "eins"
    CASE 2
        PRINT "zwei"
    CASE 3
        PRINT "drei"
    CASE ELSE
        PRINT "anders"
END SELECT
--- erwartet
zwei

=== select treewalker[DIM x AS INTEGER\nx = 3\nSELECT CASE x\n    CASE 1, 2, 3\n        PRINT "klein"\n    CASE 4, 5, 6\n        PRINT "mittel"\n    CASE ELSE\n        PRINT "anders"\nEND SELECT\n-klein\n]
DIM x AS INTEGER
x = 3
SELECT CASE x
    CASE 1, 2, 3
        PRINT "klein"
    CASE 4, 5, 6
        PRINT "mittel"
    CASE ELSE
        PRINT "anders"
END SELECT
--- erwartet
klein

