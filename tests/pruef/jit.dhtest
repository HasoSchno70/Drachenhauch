=== befehl in einem seltenen zweig wird spaet gebunden
IMPORT "json"
DIM h AS JSON_HANDLE
DIM i AS INTEGER
DIM s AS INTEGER
DIM t AS STRING
h = JSON_PARSE("[4, 7]")
FOR i = 1 TO 30
    t = t + "."
    IF i MOD 10 = 0 THEN s = s + JSON_GET_INT(h, "1") * i
    IF i = 25 THEN s = s + LEN(STR$(i * 1000))
NEXT
PRINT s; " "; LEN(t)
--- umgebung
DHRT_JIT=aus
--- erwartet
425 30

