END FUNCTION
SUB prZugPunkte(f AS INTEGER, xs AS ARRAY OF INTEGER, ys AS ARRAY OF INTEGER)
    ' Ein Mausweg in Bildpunkten; der Knopf wird in JEDEM Bild gemeldet.
    DIM i AS INTEGER
