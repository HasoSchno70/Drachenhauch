' Eigene Symbole -- Namensraum "kern".
'
' Ein eigenes Symbol entsteht aus einer Pinliste (IC-Generator), wird mit
' seiner vollen Geometrie gespeichert (nicht nur die Pinliste: aendert sich
' der Generator spaeter, bleiben alte Schaltplaene unberuehrt) und steckt in
' jeder .fkn, die es benutzt. SparkNode verwies nur auf Bibliotheks-Ids und
' riet bei fehlenden per Referenz-Praefix -- hier ist die Datei eigenstaendig,
' und ein wirklich fehlendes Symbol wird ein sichtbarer Platzhalter.
'
' Pinliste: eine Zeile je Pin, durch Leerraum getrennt:
'     Nummer  [Name  [Seite  [Typ]]]
' Seite: links rechts oben unten (auch l r o u)        -- Vorgabe links
' Typ:   passiv ein aus bidir vin vout nc (und Langformen) -- Vorgabe passiv
' Leere Zeilen und Zeilen mit # oder ' sind Kommentare.

CONST SEITE_LINKS = 0
CONST SEITE_RECHTS = 1
CONST SEITE_OBEN = 2
CONST SEITE_UNTEN = 3

CONST IC_ABSTAND = 200            ' Pin-Abstand (2 Raster)
CONST IC_PINLAENGE = 300
CONST IC_ZEICHEN = 70             ' geschaetzte Breite je Zeichen der Pin-Namen

CLASS PinAngabe
    DIM nummer AS STRING
    DIM name AS STRING
    DIM seite AS INTEGER
    DIM typ AS INTEGER
END CLASS

CLASS Pinliste
    DIM pins AS ARRAY OF PinAngabe
    DIM fehler AS ARRAY OF STRING
    SUB Init()
        pins = []
        fehler = []
    END SUB
END CLASS

FUNCTION pinTypAusWort(w AS STRING) AS INTEGER
    SELECT CASE LOWER$(w)
        CASE "passiv", "pas", "p", "passive" : RETURN PIN_PASSIV
        CASE "ein", "eingang", "in", "i", "input" : RETURN PIN_EINGANG
        CASE "aus", "ausgang", "out", "o", "output" : RETURN PIN_AUSGANG
        CASE "bidir", "bi", "io", "b", "bidirektional" : RETURN PIN_BIDIR
        CASE "vin", "versorgung", "pwr", "power", "pwr_in", "v" : RETURN PIN_LEISTUNG_EIN
        CASE "vout", "pwr_out", "quelle", "regler" : RETURN PIN_LEISTUNG_AUS
        CASE "nc", "frei", "n" : RETURN PIN_FREI
    END SELECT
    RETURN -1
END FUNCTION

FUNCTION pinTypName$(t AS INTEGER) AS STRING
    SELECT CASE t
        CASE PIN_EINGANG : RETURN "ein"
        CASE PIN_AUSGANG : RETURN "aus"
        CASE PIN_BIDIR : RETURN "bidir"
        CASE PIN_LEISTUNG_EIN : RETURN "vin"
        CASE PIN_LEISTUNG_AUS : RETURN "vout"
        CASE PIN_FREI : RETURN "nc"
    END SELECT
    RETURN "passiv"
END FUNCTION

FUNCTION seiteAusWort(w AS STRING) AS INTEGER
    SELECT CASE LOWER$(w)
        CASE "l", "links", "left", "w" : RETURN SEITE_LINKS
        CASE "r", "rechts", "right", "e" : RETURN SEITE_RECHTS
        CASE "o", "oben", "top", "t", "n" : RETURN SEITE_OBEN
        CASE "u", "unten", "bottom", "s" : RETURN SEITE_UNTEN
    END SELECT
    RETURN -1
END FUNCTION

FUNCTION pinlisteLesen(text AS STRING) AS Pinliste
    DIM pl AS Pinliste : pl = NEW Pinliste()
    DIM gesehen AS MAP OF INTEGER
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(REPLACE$(text, CHR$(13), ""), CHR$(10))
    DIM i AS INTEGER, k AS INTEGER
    FOR i = 0 TO LEN(zeilen) - 1
        DIM z AS STRING : z = TRIM$(REPLACE$(zeilen[i], CHR$(9), " "))
        IF z = "" THEN CONTINUE
        IF LEFT$(z, 1) = "#" OR LEFT$(z, 1) = "'" THEN CONTINUE
        DIM roh AS ARRAY OF STRING : roh = SPLIT$(z, " ")
        DIM t AS ARRAY OF STRING : t = []
        FOR k = 0 TO LEN(roh) - 1
            IF roh[k] <> "" THEN ARRAY_PUSH(t, roh[k])
        NEXT
        DIM nr AS STRING : nr = "Zeile " + STR$(i + 1) + ": "
        IF LEN(t) > 4 THEN
            ARRAY_PUSH(pl.fehler, nr + "zu viele Angaben (Nummer Name Seite Typ)")
            CONTINUE
        END IF
        DIM p AS PinAngabe : p = NEW PinAngabe()
        p.nummer = t[0]
        p.name = ""
        p.seite = SEITE_LINKS
        p.typ = PIN_PASSIV
        IF LEN(t) >= 2 THEN p.name = t[1]
        IF LEN(t) >= 3 THEN
            p.seite = seiteAusWort(t[2])
            IF p.seite < 0 THEN
                ARRAY_PUSH(pl.fehler, nr + "unbekannte Seite '" + t[2] + "' (links, rechts, oben, unten)")
                CONTINUE
            END IF
        END IF
        IF LEN(t) = 4 THEN
            p.typ = pinTypAusWort(t[3])
            IF p.typ < 0 THEN
                ARRAY_PUSH(pl.fehler, nr + "unbekannter Typ '" + t[3] + "' (passiv, ein, aus, bidir, vin, vout, nc)")
                CONTINUE
            END IF
        END IF
        IF MAPHAS(gesehen, p.nummer) THEN
            ARRAY_PUSH(pl.fehler, nr + "Pin-Nummer " + p.nummer + " gibt es schon (Zeile " + STR$(MAPGET(gesehen, p.nummer)) + ")")
            CONTINUE
        END IF
        MAPPUT(gesehen, p.nummer, i + 1)
        ARRAY_PUSH(pl.pins, p)
    NEXT
    RETURN pl
END FUNCTION

FUNCTION aufRunden(wert AS INTEGER, schritt AS INTEGER) AS INTEGER
    RETURN ((wert + schritt - 1) \ schritt) * schritt
END FUNCTION

' Ein IC-Symbol aus der Pinliste bauen: Rechteck, Pins je Seite von oben
' bzw. links her im Abstand 2 Raster. Breite und Hoehe sind Vielfache von
' 2 Raster -- so liegen alle Pin-Spitzen auf dem Raster.
FUNCTION icErzeugen(id AS STRING, name AS STRING, praefix AS STRING, wert AS STRING, text AS STRING) AS Symbol
    DIM pl AS Pinliste : pl = pinlisteLesen(text)
    DIM s AS Symbol : s = NEW Symbol(id, name, praefix)
    s.wertVorgabe = wert
    s.eigen = TRUE
    s.pinTexte = TRUE
    s.textOrte = TRUE
    s.quelltext = text
    DIM anz[4] AS INTEGER
    DIM lang[4] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(pl.pins) - 1
        DIM se AS INTEGER : se = pl.pins[i].seite
        anz[se] = anz[se] + 1
        IF LEN(sichtbarerText$(pl.pins[i].name)) > lang[se] THEN lang[se] = LEN(sichtbarerText$(pl.pins[i].name))
    NEXT
    DIM oben AS INTEGER : oben = IIF(anz[SEITE_OBEN] > 0, IC_ABSTAND, 0)
    DIM unten AS INTEGER : unten = IIF(anz[SEITE_UNTEN] > 0, IC_ABSTAND, 0)
    DIM w AS INTEGER : w = MAX((MAX(anz[SEITE_OBEN], anz[SEITE_UNTEN]) + 1) * IC_ABSTAND, (lang[SEITE_LINKS] + lang[SEITE_RECHTS]) * IC_ZEICHEN + 400)
    w = aufRunden(MAX(w, 600), IC_ABSTAND)          ' Vielfaches von 200: w/2 liegt auf dem Raster
    DIM h AS INTEGER : h = (MAX(anz[SEITE_LINKS], anz[SEITE_RECHTS]) + 1) * IC_ABSTAND + oben + unten
    h = MAX(h, 400)
    DIM hw AS INTEGER : hw = w \ 2
    DIM hh AS INTEGER : hh = h \ 2
    s.grafikHinzu(prRechteck(-hw, -hh, hw, hh))
    DIM nr[4] AS INTEGER
    FOR i = 0 TO LEN(pl.pins) - 1
        DIM p AS PinAngabe : p = pl.pins[i]
        DIM k AS INTEGER : k = nr[p.seite]
        nr[p.seite] = k + 1
        SELECT CASE p.seite
            CASE SEITE_LINKS
                s.pinHinzu(p.nummer, p.name, NEW Punkt(-hw - IC_PINLAENGE, -hh + oben + IC_ABSTAND * (k + 1)), IC_PINLAENGE, 0, p.typ)
            CASE SEITE_RECHTS
                s.pinHinzu(p.nummer, p.name, NEW Punkt(hw + IC_PINLAENGE, -hh + oben + IC_ABSTAND * (k + 1)), IC_PINLAENGE, 180, p.typ)
            CASE SEITE_OBEN
                s.pinHinzu(p.nummer, p.name, NEW Punkt(-hw + IC_ABSTAND * (k + 1), -hh - IC_PINLAENGE), IC_PINLAENGE, 90, p.typ)
            CASE SEITE_UNTEN
                s.pinHinzu(p.nummer, p.name, NEW Punkt(-hw + IC_ABSTAND * (k + 1), hh + IC_PINLAENGE), IC_PINLAENGE, 270, p.typ)
        END SELECT
    NEXT
    s.refOrt = NEW Punkt(-hw, -hh - 80 - IIF(anz[SEITE_OBEN] > 0, IC_PINLAENGE, 0))
    s.wertOrt = NEW Punkt(-hw, hh + 80 + IIF(anz[SEITE_UNTEN] > 0, IC_PINLAENGE, 0))
    RETURN s
END FUNCTION

' Eine neue, praktisch kollisionsfreie Id fuer ein eigenes Symbol.
FUNCTION neueSymbolId$() AS STRING
    RETURN "E_" + LEFT$(UUID4$(), 8)
END FUNCTION

' --- JSON -------------------------------------------------------------------

FUNCTION symbolNachJson(s AS Symbol) AS JSON_HANDLE
    DIM j AS JSON_HANDLE : j = JSON_NEW_OBJECT()
    JSON_SET_STRING(j, "id", s.id)
    JSON_SET_STRING(j, "name", s.name)
    JSON_SET_STRING(j, "beschreibung", s.beschreibung)
    JSON_SET_STRING(j, "praefix", s.praefix)
    JSON_SET_STRING(j, "wert", s.wertVorgabe)
    JSON_SET_STRING(j, "quelle", s.quelltext)
    JSON_SET_BOOL(j, "pinTexte", s.pinTexte)
    IF s.textOrte THEN
        JSON_SET_JSON(j, "refOrt", JSON_NEW_ARRAY())
        JSON_APPEND_INT(j, "refOrt", s.refOrt.x)
        JSON_APPEND_INT(j, "refOrt", s.refOrt.y)
        JSON_SET_JSON(j, "wertOrt", JSON_NEW_ARRAY())
        JSON_APPEND_INT(j, "wertOrt", s.wertOrt.x)
        JSON_APPEND_INT(j, "wertOrt", s.wertOrt.y)
    END IF
    JSON_SET_JSON(j, "pins", JSON_NEW_ARRAY())
    DIM i AS INTEGER, k AS INTEGER
    FOR i = 0 TO LEN(s.pins) - 1
        DIM p AS Pin : p = s.pins[i]
        DIM pj AS JSON_HANDLE : pj = JSON_NEW_OBJECT()
        JSON_SET_STRING(pj, "nr", p.nummer)
        JSON_SET_STRING(pj, "name", p.name)
        JSON_SET_INT(pj, "x", p.pos.x)
        JSON_SET_INT(pj, "y", p.pos.y)
        JSON_SET_INT(pj, "len", p.laenge)
        JSON_SET_INT(pj, "ri", p.richtung)
        JSON_SET_INT(pj, "typ", p.typ)
        JSON_APPEND_JSON(j, "pins", pj)
    NEXT
    JSON_SET_JSON(j, "grafik", JSON_NEW_ARRAY())
    FOR i = 0 TO LEN(s.grafik) - 1
        DIM g AS Primitiv : g = s.grafik[i]
        DIM gj AS JSON_HANDLE : gj = JSON_NEW_OBJECT()
        JSON_SET_INT(gj, "art", g.art)
        JSON_SET_JSON(gj, "pts", JSON_NEW_ARRAY())
        FOR k = 0 TO LEN(g.punkte) - 1
            JSON_APPEND_INT(gj, "pts", g.punkte[k].x)
            JSON_APPEND_INT(gj, "pts", g.punkte[k].y)
        NEXT
        IF g.radius <> 0 THEN JSON_SET_INT(gj, "r", g.radius)
        IF g.winkel1 <> 0 OR g.winkel2 <> 0 THEN
            JSON_SET_FLOAT(gj, "w1", g.winkel1)
            JSON_SET_FLOAT(gj, "w2", g.winkel2)
        END IF
        IF g.text <> "" THEN JSON_SET_STRING(gj, "text", g.text)
        IF g.fuellen THEN JSON_SET_BOOL(gj, "fuellen", TRUE)
        JSON_APPEND_JSON(j, "grafik", gj)
    NEXT
    RETURN j
END FUNCTION

FUNCTION jsonText$(j AS JSON_HANDLE, pfad AS STRING, vorgabe AS STRING) AS STRING
    IF JSON_HAS(j, pfad) THEN RETURN JSON_GET_STRING(j, pfad)
    RETURN vorgabe
END FUNCTION

' Ein Symbol aus dem JSON-Baum am Pfad b ("" = Wurzel, sonst "symbole.3").
FUNCTION symbolAusJson(j AS JSON_HANDLE, b AS STRING) AS Symbol
    DIM v AS STRING : v = b
    IF v <> "" THEN v = v + "."
    DIM s AS Symbol : s = NEW Symbol(JSON_GET_STRING(j, v + "id"), jsonText$(j, v + "name", "?"), jsonText$(j, v + "praefix", "U"))
    s.eigen = TRUE
    s.beschreibung = jsonText$(j, v + "beschreibung", "")
    s.wertVorgabe = jsonText$(j, v + "wert", "")
    s.quelltext = jsonText$(j, v + "quelle", "")
    IF JSON_HAS(j, v + "pinTexte") THEN s.pinTexte = JSON_GET_BOOL(j, v + "pinTexte")
    IF JSON_HAS(j, v + "refOrt") THEN
        s.textOrte = TRUE
        s.refOrt = NEW Punkt(JSON_GET_INT(j, v + "refOrt.0"), JSON_GET_INT(j, v + "refOrt.1"))
        s.wertOrt = NEW Punkt(JSON_GET_INT(j, v + "wertOrt.0"), JSON_GET_INT(j, v + "wertOrt.1"))
    END IF
    DIM i AS INTEGER, k AS INTEGER
    FOR i = 0 TO JSON_LEN(j, v + "pins") - 1
        DIM pv AS STRING : pv = v + "pins." + STR$(i) + "."
        s.pinHinzu(JSON_GET_STRING(j, pv + "nr"), jsonText$(j, pv + "name", ""), NEW Punkt(JSON_GET_INT(j, pv + "x"), JSON_GET_INT(j, pv + "y")), JSON_GET_INT(j, pv + "len"), JSON_GET_INT(j, pv + "ri"), JSON_GET_INT(j, pv + "typ"))
    NEXT
    FOR i = 0 TO JSON_LEN(j, v + "grafik") - 1
        DIM gv AS STRING : gv = v + "grafik." + STR$(i) + "."
        DIM g AS Primitiv : g = NEW Primitiv(JSON_GET_INT(j, gv + "art"))
        DIM n AS INTEGER : n = JSON_LEN(j, gv + "pts")
        k = 0
        WHILE k + 1 < n
            ARRAY_PUSH(g.punkte, NEW Punkt(JSON_GET_INT(j, gv + "pts." + STR$(k)), JSON_GET_INT(j, gv + "pts." + STR$(k + 1))))
            k = k + 2
        WEND
        IF JSON_HAS(j, gv + "r") THEN g.radius = JSON_GET_INT(j, gv + "r")
        IF JSON_HAS(j, gv + "w1") THEN g.winkel1 = JSON_GET_FLOAT(j, gv + "w1")
        IF JSON_HAS(j, gv + "w2") THEN g.winkel2 = JSON_GET_FLOAT(j, gv + "w2")
        g.text = jsonText$(j, gv + "text", "")
        IF JSON_HAS(j, gv + "fuellen") THEN g.fuellen = JSON_GET_BOOL(j, gv + "fuellen")
        s.grafikHinzu(g)
    NEXT
    RETURN s
END FUNCTION

' --- Register: alle eigenen Symbole, die das Programm gerade kennt ----------
' (persoenliche Bibliothek + aus geladenen Dokumenten). Ein schon bekanntes
' Symbol wird an Ort und Stelle ueberschrieben -- alle Bauteile, die darauf
' zeigen, sehen die neue Fassung sofort (auch beim Rueckgaengig).

DIM gEigene AS ARRAY OF Symbol

SUB symbolFelderKopieren(ziel AS Symbol, q AS Symbol)
    ziel.name = q.name
    ziel.beschreibung = q.beschreibung
    ziel.praefix = q.praefix
    ziel.wertVorgabe = q.wertVorgabe
    ziel.pins = q.pins
    ziel.grafik = q.grafik
    ziel.einheitLeistung = q.einheitLeistung
    ziel.eigen = q.eigen
    ziel.fehlt = q.fehlt
    ziel.pinTexte = q.pinTexte
    ziel.quelltext = q.quelltext
    ziel.textOrte = q.textOrte
    ziel.refOrt = q.refOrt
    ziel.wertOrt = q.wertOrt
END SUB

FUNCTION eigenesSymbol(id AS STRING) AS Symbol
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gEigene) - 1
        IF gEigene[i].id = id THEN RETURN gEigene[i]
    NEXT
    RETURN NEW Symbol("", "", "")
END FUNCTION

FUNCTION istEigenBekannt(id AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gEigene) - 1
        IF gEigene[i].id = id THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

FUNCTION symbolRegistrieren(s AS Symbol) AS Symbol
    IF istEigenBekannt(s.id) THEN
        DIM alt AS Symbol : alt = eigenesSymbol(s.id)
        symbolFelderKopieren(alt, s)
        RETURN alt
    END IF
    ARRAY_PUSH(gEigene, s)
    RETURN s
END FUNCTION

FUNCTION eigeneSymbole() AS ARRAY OF Symbol
    RETURN gEigene
END FUNCTION

' Ein sichtbarer Ersatz fuer ein unbekanntes Symbol (statt still ein anderes
' Bauteil). Taucht das echte Symbol spaeter auf (Einfuegen, Laden), wird der
' Platzhalter an Ort und Stelle ersetzt.
FUNCTION symbolPlatzhalter(id AS STRING) AS Symbol
    DIM s AS Symbol : s = NEW Symbol(id, "Fehlt: " + id, "?")
    s.fehlt = TRUE
    s.eigen = TRUE
    s.grafikHinzu(prRechteck(-300, -200, 300, 200))
    s.grafikHinzu(prLinie(-300, -200, 300, 200))
    s.grafikHinzu(prLinie(-300, 200, 300, -200))
    RETURN symbolRegistrieren(s)
END FUNCTION

' --- Persoenliche Bibliothek (eine JSON-Datei) ------------------------------

DIM gBibDatei AS ARRAY OF Symbol

FUNCTION bibliothekLaden(pfad AS STRING) AS INTEGER
    gBibDatei = []
    IF NOT FILEEXISTS(pfad) THEN RETURN 0
    DIM j AS JSON_HANDLE
    TRY
        j = JSON_LOAD(pfad)
    CATCH e
        RETURN -1
    END TRY
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "symbole") - 1
        ARRAY_PUSH(gBibDatei, symbolRegistrieren(symbolAusJson(j, "symbole." + STR$(i))))
    NEXT
    RETURN LEN(gBibDatei)
END FUNCTION

FUNCTION inBibliothek(id AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gBibDatei) - 1
        IF gBibDatei[i].id = id THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

FUNCTION bibliothekAufnehmen(s AS Symbol, pfad AS STRING) AS BOOLEAN
    IF NOT inBibliothek(s.id) THEN ARRAY_PUSH(gBibDatei, s)
    DIM j AS JSON_HANDLE : j = JSON_NEW_OBJECT()
    JSON_SET_INT(j, "funkenflugBibliothek", 1)
    JSON_SET_JSON(j, "symbole", JSON_NEW_ARRAY())
    DIM i AS INTEGER
    FOR i = 0 TO LEN(gBibDatei) - 1
        JSON_APPEND_JSON(j, "symbole", symbolNachJson(gBibDatei[i]))
    NEXT
    TRY
        WRITEALL(pfad, JSON_PRETTY(j))
    CATCH e
        RETURN FALSE
    END TRY
    RETURN TRUE
END FUNCTION
