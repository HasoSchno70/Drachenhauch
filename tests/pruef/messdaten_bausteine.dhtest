' Die Bausteine aus der Messdaten-Runde (2026-10-13, examples/messdaten):
' ZEIT_FORMAT$ mit %-Mustern, CHART_X und luecke_ab, CHART_DATA kuerzt,
' Beschriftung einzelner Punkte, RENDERTARGET_IMAGE, PDF_IMAGE, LOADFONT mit
' den eingebauten Schriften, GUI_CHANGED. Jeder Fall faellt mit 2026.30.
' Format: docs/werkzeuge.md, dhrt test.

=== zeit format versteht prozent muster
' Bis 2026.30 kam "%Y-%m-%d" woertlich wieder heraus -- ohne ein Wort.
IMPORT "zeit"
DIM t AS INTEGER : t = ZEIT_PARSE("2026-10-07 14:05:09")
PRINT ZEIT_FORMAT$(t, "%Y-%m-%d %H:%M:%S")
PRINT ZEIT_FORMAT$(t, "%d.%m.%y %a %A 100%%")
PRINT ZEIT_FORMAT$(t, "TT.MM.JJJJ")
--- erwartet
2026-10-07 14:05:09
07.10.26 Mi Mittwoch 100%
07.10.2026

=== zeit format meldet unbekanntes prozent muster
IMPORT "zeit"
TRY
    PRINT ZEIT_FORMAT$(0, "%Y-%j")
CATCH e
    PRINT e
END TRY
--- erwartet
ZEIT_FORMAT$: '%j' kennt das Muster nicht -- %Y %y %m %d %H %M %S %a %A %% oder JJJJ MM TT hh mm ss WT WTAG

=== chart data mit weniger punkten kuerzt
' Bis 2026.30 blieb die Punktzahl stehen: eine Woche, dann ein Tag -- und
' hinter dem Tag hingen Nullen.
IMPORT "chart"
DIM c AS CHART : c = CHART_NEW("linie", 0, 0, 200, 100)
DIM s AS INTEGER : s = CHART_SERIES(c, "a")
DIM viele AS ARRAY OF FLOAT : viele = []
DIM i AS INTEGER
FOR i = 1 TO 100 : ARRAY_PUSH(viele, 1.0) : NEXT
CHART_DATA(c, s, viele)
CHART_LABEL(c, 50, "Mitte")
CHART_DATA(c, s, [2.0, 3.0, 4.0])
PRINT CHART_COUNT(c)
--- erwartet
3

=== chart x prueft anzahl und reihenfolge
IMPORT "chart"
DIM c AS CHART : c = CHART_NEW("linie", 0, 0, 200, 100)
DIM s AS INTEGER : s = CHART_SERIES(c, "a")
CHART_DATA(c, s, [1.0, 2.0, 3.0])
TRY
    CHART_X(c, [1, 2])
CATCH e
    PRINT e
END TRY
TRY
    CHART_X(c, [1, 3, 2])
CATCH e
    PRINT e
END TRY
CHART_X(c, [10, 20, 40])
CHART_X(c, [])
PRINT "ok"
--- erwartet
CHART_X: 2 x-Werte fuer 3 Punkte -- erst CHART_DATA, dann CHART_X mit gleich vielen
CHART_X: der x-Wert von Punkt 2 ist kleiner als der davor -- die Werte muessen aufsteigen
ok

=== chart x mit luecke unterbricht die linie
' Fuenf Punkte auf gleicher Hoehe, zwischen dem dritten und vierten eine
' Luecke: im Bild steht dort keine Linie. Gezeichnet in ein Render-Ziel und
' als Bild gelesen (RENDERTARGET_IMAGE).
IMPORT "chart"
SCREEN(320, 200, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM c AS CHART : c = CHART_NEW("linie", 0, 0, 300, 160)
CHART_THEME(c, "hell")
DIM s AS INTEGER : s = CHART_SERIES(c, "a", &HFF0000)
CHART_SET_NUM(c, "min", 0) : CHART_SET_NUM(c, "max", 10)
CHART_DATA(c, s, [5.0, 5.0, 5.0, 5.0, 5.0])
CHART_X(c, [0, 10, 20, 90, 100])
CHART_SET_NUM(c, "luecke_ab", 30)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(300, 160)
RENDERTARGET_BEGIN(rt) : CHART_DRAW(c) : RENDERTARGET_END()
DIM b AS IMAGE : b = RENDERTARGET_IMAGE(rt)
' je Spalte: steht irgendwo Rot?
DIM x AS INTEGER, y AS INTEGER, erste AS INTEGER, letzte AS INTEGER, luecke AS INTEGER, lauf AS INTEGER
erste = -1
FOR x = 0 TO 299
    DIM rot AS BOOLEAN : rot = FALSE
    FOR y = 0 TO 159
        DIM p AS INTEGER : p = GETPIXEL(b, x, y)
        IF (p SHR 16) BAND 255 > 200 AND (p SHR 8) BAND 255 < 90 THEN rot = TRUE
    NEXT
    IF rot THEN
        IF erste < 0 THEN erste = x
        letzte = x : lauf = 0
    ELSEIF erste >= 0 THEN
        lauf = lauf + 1 : luecke = MAX(luecke, lauf)
    END IF
NEXT
PRINT "linie da: "; erste >= 0
PRINT "luecke ueber 100 punkte: "; luecke > 100
--- erwartet
linie da: TRUE
luecke ueber 100 punkte: TRUE

=== chart ohne luecke_ab zieht durch
' Gegenprobe zum Fall davor: dieselben Punkte ohne luecke_ab.
IMPORT "chart"
SCREEN(320, 200, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM c AS CHART : c = CHART_NEW("linie", 0, 0, 300, 160)
CHART_THEME(c, "hell")
DIM s AS INTEGER : s = CHART_SERIES(c, "a", &HFF0000)
CHART_SET_NUM(c, "min", 0) : CHART_SET_NUM(c, "max", 10)
CHART_DATA(c, s, [5.0, 5.0, 5.0, 5.0, 5.0])
CHART_X(c, [0, 10, 20, 90, 100])
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(300, 160)
RENDERTARGET_BEGIN(rt) : CHART_DRAW(c) : RENDERTARGET_END()
DIM b AS IMAGE : b = RENDERTARGET_IMAGE(rt)
DIM x AS INTEGER, y AS INTEGER, erste AS INTEGER, luecke AS INTEGER, lauf AS INTEGER
erste = -1
FOR x = 0 TO 299
    DIM rot AS BOOLEAN : rot = FALSE
    FOR y = 0 TO 159
        DIM p AS INTEGER : p = GETPIXEL(b, x, y)
        IF (p SHR 16) BAND 255 > 200 AND (p SHR 8) BAND 255 < 90 THEN rot = TRUE
    NEXT
    IF rot THEN
        IF erste < 0 THEN erste = x
        lauf = 0
    ELSEIF erste >= 0 THEN
        lauf = lauf + 1 : luecke = MAX(luecke, lauf)
    END IF
NEXT
PRINT "linie da: "; erste >= 0
PRINT "luecke ueber 100 punkte: "; luecke > 100
--- erwartet
linie da: TRUE
luecke ueber 100 punkte: FALSE

=== einzelne beschriftungen stehen alle da
' 300 Punkte, beschriftet nur 37, 143 und 251 (wie Tagesanfaenge unter
' Messwerten). Bis 2026.30 galt nur jede k-te Stelle, und die drei fielen
' in die Luecken dazwischen. Gezaehlt werden die Schriftbloecke unter dem
' Diagramm, rechts der y-Achse.
IMPORT "chart"
SCREEN(420, 220, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM c AS CHART : c = CHART_NEW("linie", 0, 0, 400, 200)
CHART_THEME(c, "hell")
CHART_SET_COLOR(c, "text", &H000000)
DIM s AS INTEGER : s = CHART_SERIES(c, "a", &H00AA00)
DIM w AS ARRAY OF FLOAT : w = []
DIM i AS INTEGER
FOR i = 0 TO 299 : ARRAY_PUSH(w, SIN(i / 20.0)) : NEXT
CHART_DATA(c, s, w)
CHART_LABEL(c, 37, "Mo") : CHART_LABEL(c, 143, "Di") : CHART_LABEL(c, 251, "Mi")
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(400, 200)
RENDERTARGET_BEGIN(rt) : CHART_DRAW(c) : RENDERTARGET_END()
DIM b AS IMAGE : b = RENDERTARGET_IMAGE(rt)
DIM x AS INTEGER, y AS INTEGER, bloecke AS INTEGER, leer AS INTEGER
leer = 99
FOR x = 70 TO 399
    DIM dunkel AS BOOLEAN : dunkel = FALSE
    FOR y = 170 TO 199
        IF GETPIXEL(b, x, y) BAND &HFFFFFF < &H505050 THEN dunkel = TRUE
    NEXT
    IF dunkel THEN
        IF leer > 12 THEN bloecke = bloecke + 1
        leer = 0
    ELSE
        leer = leer + 1
    END IF
NEXT
PRINT "beschriftungen: "; bloecke
--- erwartet
beschriftungen: 3

=== rendertarget image liefert das gezeichnete ohne flip
' Oben ein rotes Band, sonst Blau. Eine RenderTexture steht in OpenGL auf
' dem Kopf -- das Bild muss richtig herum ankommen.
SCREEN(100, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(40, 30)
RENDERTARGET_BEGIN(rt)
BOX(0, 0, 40, 30, &H0000FF)
BOX(0, 0, 40, 8, &HFF0000)
RENDERTARGET_END()
DIM b AS IMAGE : b = RENDERTARGET_IMAGE(rt)
PRINT IMAGEWIDTH(b); " x "; IMAGEHEIGHT(b)
PRINT HEX$(GETPIXEL(b, 20, 3) BAND &HFFFFFF)
PRINT HEX$(GETPIXEL(b, 20, 25) BAND &HFFFFFF)
--- erwartet
40 x 30
FF0000
FF

=== rendertarget image verlangt ein geschlossenes ziel
SCREEN(100, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM rt AS INTEGER : rt = RENDERTARGET_NEW(40, 30)
RENDERTARGET_BEGIN(rt)
TRY
    DIM b AS IMAGE : b = RENDERTARGET_IMAGE(rt)
CATCH e
    PRINT e
END TRY
--- erwartet
RENDERTARGET_IMAGE: das Ziel ist noch offen -- erst RENDERTARGET_END

=== pdf image setzt ein bild in die seite
' Ein rotes Bild 20 x 10 Punkte, 40 mm breit bei (20, 20) -- die Hoehe
' folgt dem Seitenverhaeltnis (20 mm). Geprueft an der Vorschau (1 Punkt je
' mm) und an den Bytes.
IMPORT "pdf"
SCREEN(100, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM img AS IMAGE : img = IMAGE_NEW(20, 10, &HFF0000)
DIM p AS PDF : p = PDF_NEW()
PDF_IMAGE(p, img, 20, 20, 40)
DIM v AS IMAGE : v = PDF_PREVIEW(p, 1, 210)
PRINT HEX$(GETPIXEL(v, 40, 30) BAND &HFFFFFF)
PRINT HEX$(GETPIXEL(v, 40, 45) BAND &HFFFFFF)
PRINT HEX$(GETPIXEL(v, 10, 30) BAND &HFFFFFF)
PDF_SAVE(p, "bild.pdf")
PRINT "Bild im PDF: "; BUFFER_INDEXOF(READALL_BYTES("bild.pdf"), BUFFER_FROM_STRING("/Image")) >= 0
--- erwartet
FF0000
FFFFFF
FFFFFF
Bild im PDF: TRUE

=== pdf image mit eigener hoehe und fehlern
IMPORT "pdf"
SCREEN(100, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM img AS IMAGE : img = IMAGE_NEW(20, 10, &H00FF00)
DIM p AS PDF : p = PDF_NEW()
PDF_IMAGE(p, img, 20, 20, 40, 60)
DIM v AS IMAGE : v = PDF_PREVIEW(p, 1, 210)
PRINT HEX$(GETPIXEL(v, 40, 75) BAND &HFFFFFF)
TRY
    PDF_IMAGE(p, img, 20, 20, 0)
CATCH e
    PRINT e
END TRY
TRY
    PDF_IMAGE(p, 9999, 20, 20, 40)
CATCH e
    PRINT LEFT$(e, 10)
END TRY
--- erwartet
FF00
PDF_IMAGE: die Breite muss groesser als 0 sein, nicht 0
PDF_IMAGE:

=== loadfont kennt die eingebauten schriften
' Eine richtige Schrift ohne Pfad -- auf jedem System dieselbe. Die
' Familie hat alle vier Schnitte.
SCREEN(200, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM pixel AS INTEGER : pixel = TEXT_WIDTH("Messdaten")
DIM f AS INTEGER : f = LOADFONT("sans", 32)
SETFONT(f)
TEXT_SIZE(20)
PRINT "andere Breite: "; TEXT_WIDTH("Messdaten") <> pixel
PRINT FONT_HAS_STYLE(f, "fett"); " "; FONT_HAS_STYLE(f, "kursiv"); " "; FONT_HAS_STYLE(f, "fett+kursiv")
DIM m AS INTEGER : m = LOADFONT("mono-fett", 20)
PRINT "mono-fett: "; m > f
TRY
    DIM x AS INTEGER : x = LOADFONT("sanz", 20)
CATCH e
    PRINT "unbekannt: "; INSTR(e, "sanz") >= 0
END TRY
--- erwartet
andere Breite: TRUE
TRUE TRUE TRUE
mono-fett: TRUE
unbekannt: TRUE

=== gui changed meldet die bedienung genau ein bild
' Der erste Aufruf beginnt zu beobachten und meldet FALSE. Der Klick aufs
' Kaestchen zaehlt in dem Bild, in dem GUI_UPDATE ihn verarbeitet; was das
' Programm selbst setzt (Bild 6), zaehlt nicht.
IMPORT "gui"
SCREEN(320, 240, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("Kasten", 10, 10, 300, 200)
DIM cb AS GUI_WIDGET : cb = GUI_CHECKBOX(w, "an", 20, 20, FALSE)
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 20, 80, 120, 24, ["eins", "zwei"])
DIM n AS INTEGER
WHILE NOT QUITREQUESTED()
    n = n + 1
    IF n = 6 THEN GUI_SET_CHECKED(cb, FALSE) : GUI_DROPDOWN_SET_SELECTED(dd, 1)
    GUI_UPDATE()
    PRINT n; " "; GUI_CHANGED(cb); " "; GUI_CHANGED(dd); " "; GUI_CHECKED(cb)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
# Test-Aufnahme
c 4
e 1 7 36 62 0 0 // Event: test
e 2 7 36 62 0 0 // Event: test
e 2 6 0 0 0 0 // Event: test
e 3 5 0 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=8
--- erwartet
1 FALSE FALSE FALSE
2 FALSE FALSE FALSE
3 TRUE FALSE TRUE
4 FALSE FALSE TRUE
5 FALSE FALSE TRUE
6 FALSE FALSE FALSE
7 FALSE FALSE FALSE
8 FALSE FALSE FALSE

=== gui changed beim kippschalter zaehlt nicht das nachgleiten
' Ein Kippschalter gleitet nach einem Wechsel einige Bilder lang in seine
' neue Lage -- auch nach GUI_SET_CHECKED aus dem Programm. Das ist keine
' Bedienung; bis 2026.39 meldete GUI_CHANGED es in jedem Bild des Gleitens.
IMPORT "gui"
SCREEN(320, 240, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_METRIC_SET("uebergang", 300)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("Kasten", 10, 10, 300, 200)
DIM ks AS GUI_WIDGET : ks = GUI_TOGGLE(w, "an", 20, 20, FALSE)
DIM n AS INTEGER
DIM gemeldet AS INTEGER : gemeldet = 0
WHILE NOT QUITREQUESTED()
    n = n + 1
    IF n = 3 THEN GUI_SET_CHECKED(ks, TRUE)
    GUI_UPDATE()
    IF GUI_CHANGED(ks) THEN gemeldet = gemeldet + 1
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "gemeldet "; gemeldet; " an "; GUI_CHECKED(ks)
--- umgebung
DHRT_FRAMES=20
--- erwartet
gemeldet 0 an TRUE

=== glatte kommazahl gilt als integer
' Aus der Web-Runde: "/" liefert immer FLOAT, und GUI_WINDOW("...", BREITE / 2
' - 170, ...) brach mit "erwartet INTEGER" ab -- obwohl x = BREITE / 2 in eine
' INTEGER-Variable geht. Jetzt dieselbe Regel: glatt geht, sonst ein Fehler
' mit dem Weg dorthin.
IMPORT "gui"
CONST BREITE = 800
DIM w AS GUI_WINDOW : w = GUI_WINDOW("x", BREITE / 2 - 170, 330 / 1, 340, 120)
PRINT GUI_WINDOW_GET_X(w); " "; GUI_WINDOW_GET_Y(w)
PRINT CHR$(130 / 2); LEFT$("abcd", 6 / 3)
TRY
    PRINT LEFT$("abcd", 5 / 2)
CATCH e
    PRINT e
END TRY
TRY
    DIM v AS GUI_WINDOW : v = GUI_WINDOW("y", 2.5, 0, 10, 10)
CATCH e
    PRINT e
END TRY
--- erwartet
230 330
Aab
LEFT$ erwartet INTEGER, erhalten FLOAT 2.5 -- keine ganze Zahl; INT(x) schneidet ab, ROUND(x) rundet, \ teilt ganzzahlig
GUI_WINDOW: erwartet INTEGER (Arg 2), erhalten 2.5 -- keine ganze Zahl; INT(x) schneidet ab, ROUND(x) rundet, \ teilt ganzzahlig

=== gentex radial prueft die dichte
' 1.6 sah nach "dichter" aus und gab still eine harte Scheibe.
SCREEN(100, 100, "Test", 1)
SET_WINDOW_POS(-3000, -3000)
DIM b AS IMAGE : b = GENTEX_RADIAL(64, 64, WHITE, BLACK, 0.5)
PRINT IMAGEWIDTH(b)
TRY
    b = GENTEX_RADIAL(64, 64, WHITE, BLACK, 1.6)
CATCH e
    PRINT e
END TRY
--- erwartet
64
GENTEX_RADIAL: dichte 1.6 liegt nicht in 0..1 -- sie ist der Anteil des Radius in voller Innenfarbe (0 = weicher Verlauf ab der Mitte, 1 = Scheibe)
