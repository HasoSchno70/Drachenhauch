SUB pluginListeFuellen()
    GUI_LISTBOX_CLEAR(lstPlug)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(plugins) - 1
        DIM zeile AS STRING : zeile = plugins[k].titel
        IF plugins[k].fassung <> "" THEN zeile = zeile + " " + plugins[k].fassung
        IF plugins[k].mitgeliefert THEN zeile = zeile + tr$(" (mitgeliefert)")
        IF plugins[k].geholt THEN zeile = zeile + tr$(" (geholt)")
        DIM z AS INTEGER : z = GUI_LISTBOX_ADD(lstPlug, zeile)
        GUI_LISTBOX_DETAIL(lstPlug, z, plugins[k].zustand)
        GUI_LISTBOX_SET_CHECKED(lstPlug, z, pluginGewollt(k))
        DIM tipp AS STRING : tipp = plugins[k].info
        IF plugins[k].autor <> "" THEN tipp = tipp + IIF(tipp = "", "", NL) + tr$("Von: ") + plugins[k].autor
        tipp = tipp + IIF(tipp = "", "", NL) + plugins[k].pfad
        GUI_LISTBOX_TIP(lstPlug, z, tipp)
    NEXT
END SUB

' --- Neues Plugin aus der Vorlage -------------------------------------------
DIM dlgPlugName AS GUI_WINDOW : dlgPlugName = 0

SUB pluginAnlegenFragen()
    dlgPlugName = GUI_PROMPT(tr$("Neues Plugin"), tr$("Name des Plugins (Buchstaben, Ziffern, _ und -):"), "mein_plugin")
END SUB

SUB pluginAnlegenNachziehen()
    IF dlgPlugName = 0 THEN RETURN
    DIM a AS INTEGER : a = GUI_ANSWER(dlgPlugName)
    IF a = 0 THEN RETURN
    DIM name AS STRING : name = TRIM$(GUI_DIALOG_TEXT(dlgPlugName))
    dlgPlugName = 0
    IF a = 1 THEN pluginAnlegen(name)
END SUB

' Legt plugins/<name>/ mit plugin.dh, plugin.json, leiste.dhform und test.dhtest an,
' oeffnet plugin.dh und startet das Plugin. FALSE, wenn der Name krumm ist
' oder den Ordner gibt.
FUNCTION pluginAnlegen(name AS STRING) AS BOOLEAN
    IF name = "" OR NOT REGEX_TEST(name, "^[A-Za-z0-9_-]+$") THEN
        GUI_SET_TEXT(lblStatus, tr$("Ein Plugin-Name besteht aus Buchstaben, Ziffern, _ und -."))
        protokoll("plugin anlegen krumm " + name)
        RETURN FALSE
    END IF
    DIM ordner AS STRING : ordner = PATHJOIN(pluginOrdner$(), name)
    IF DIREXISTS(ordner) THEN
        GUI_SET_TEXT(lblStatus, tr$("Das Plugin gibt es schon: ") + ordner)
        protokoll("plugin anlegen gibt es " + name)
        RETURN FALSE
    END IF
    IF NOT DIREXISTS(pluginOrdner$()) THEN MKDIR(pluginOrdner$())
    MKDIR(ordner)
    DIM q AS STRING : q = CHR$(34)
    DIM sb AS JSON_HANDLE : sb = JSON_PARSE("{}")
    JSON_SET_STRING(sb, "name", name)
    JSON_SET_STRING(sb, "fassung", "0.1")
    JSON_SET_STRING(sb, "beschreibung", tr$("Was das Plugin tut."))
    JSON_SET_STRING(sb, "autor", "")
    JSON_SET_STRING(sb, "ide", VERSION$())
    WRITEALL(PATHJOIN(ordner, "plugin.json"), JSON_STRINGIFY(sb) + NL)
    DIM form AS STRING : form = "{" + q + "title" + q + ": " + q + name + q + ", " + q + "w" + q + ": 240, " + q + "h" + q + ": 160, " + q + "chrome" + q + ": false, " + q + "widgets" + q + ": [" + NL
    form = form + "  {" + q + "kind" + q + ": " + q + "label" + q + ", " + q + "name" + q + ": " + q + "kopf" + q + ", " + q + "text" + q + ": " + q + name + q + ", " + q + "x" + q + ": 6, " + q + "y" + q + ": 6, " + q + "w" + q + ": 228, " + q + "h" + q + ": 18, " + q + "anchor" + q + ": " + q + "lrt" + q + "}," + NL
    form = form + "  {" + q + "kind" + q + ": " + q + "button" + q + ", " + q + "name" + q + ": " + q + "knopf" + q + ", " + q + "text" + q + ": " + q + "Wort zählen" + q + ", " + q + "x" + q + ": 6, " + q + "y" + q + ": 30, " + q + "w" + q + ": 140, " + q + "h" + q + ": 28}" + NL
    form = form + "]}" + NL
    WRITEALL(PATHJOIN(ordner, "leiste.dhform"), form)
    DIM c AS STRING : c = "' Plugin " + q + name + q + " -- angelegt aus der Vorlage der IDE." + NL
    c = c + "' Handbuch: docs/ide-plugins.md. Nach einer Aenderung: Plugins -> Plugins neu laden." + NL
    c = c + "IMPORT " + q + "dh_plugin.dh" + q + NL + NL
    c = c + "SUB zaehlen()" + NL
    c = c + "    DIM text AS STRING : text = PLUGIN_TEXT$()" + NL
    c = c + "    DIM wort AS STRING : wort = PLUGIN_WORT$()" + NL
    c = c + "    IF wort = " + q + q + " THEN" + NL
    c = c + "        PLUGIN_MELDUNG(" + q + "An der Schreibmarke steht kein Wort." + q + ")" + NL
    c = c + "        RETURN" + NL
    c = c + "    END IF" + NL
    c = c + "    DIM n AS INTEGER : n = LEN(REGEX_FIND_ALL(text, " + q + "\b" + q + " + wort + " + q + "\b" + q + "))" + NL
    c = c + "    PLUGIN_SETZE(" + q + "leiste" + q + ", " + q + "kopf" + q + ", " + q + "text" + q + ", wort + " + q + ": " + q + " + STR$(n) + " + q + " mal" + q + ")" + NL
    c = c + "END SUB" + NL + NL
    c = c + "PLUGIN_BEFEHL(" + q + "zaehlen" + q + ", " + q + "Wort an der Marke zählen" + q + ")" + NL
    c = c + "PLUGIN_KONTEXT(" + q + "zaehlen" + q + ", " + q + "Wie oft steht das Wort hier?" + q + ")" + NL
    c = c + "PLUGIN_LEISTE(" + q + "leiste" + q + ", " + q + name + q + ", " + q + "leiste.dhform" + q + ", " + q + "rechts" + q + ")" + NL + NL
    c = c + "WHILE PLUGIN_LAEUFT()" + NL
    c = c + "    SELECT CASE PLUGIN_EREIGNIS$()" + NL
    c = c + "        CASE " + q + "befehl" + q + NL
    c = c + "            IF PLUGIN_ID$() = " + q + "zaehlen" + q + " THEN zaehlen()" + NL
    c = c + "        CASE " + q + "klick" + q + NL
    c = c + "            IF PLUGIN_WIDGET$() = " + q + "knopf" + q + " THEN zaehlen()" + NL
    c = c + "        CASE " + q + "ende" + q + NL
    c = c + "            EXIT(0)" + NL
    c = c + "    END SELECT" + NL
    c = c + "WEND" + NL
    WRITEALL(PATHJOIN(ordner, "plugin.dh"), c)
    ' Eine Pruefung mit der Schein-IDE (ide/dh_plugin_probe.dh): sie laeuft
    ' ohne Fenster und ohne IDE, mit dhrt test oder Strg+Alt+F5. DH_PATH
    ' zeigt auf den Ordner dieser IDE, dort liegen dh_plugin.dh und die Probe.
    DIM t AS STRING : t = "' Pruefung des Plugins " + q + name + q + " mit der Schein-IDE (dh_plugin_probe.dh)." + NL
    t = t + "' Laufen lassen: dhrt test <dieser Ordner>, in der IDE Strg+Alt+F5." + NL
    t = t + "' Handbuch: docs/ide-plugins.md, Abschnitt " + q + "Ein Plugin pruefen" + q + "." + NL + NL
    t = t + "=== das wort an der marke wird gezaehlt" + NL
    t = t + "IMPORT " + q + "dh_plugin_probe.dh" + q + NL
    t = t + "PROBE_SETZE_TEXT(" + q + "a = 1" + q + " + CHR$(10) + " + q + "PRINT a + a" + q + " + CHR$(10), CWD$() + " + q + "/haupt.dh" + q + ", 2, 7)" + NL
    t = t + "PRINT PROBE_START(ARG$(0) + " + q + "/plugin.dh" + q + ")" + NL
    t = t + "PRINT PROBE_WARTEN(" + q + "leiste" + q + ")" + NL
    t = t + "PROBE_BEFEHL(" + q + "zaehlen" + q + ")" + NL
    t = t + "PRINT PROBE_WARTEN(" + q + "setze" + q + ")" + NL
    t = t + "PRINT PROBE_WIDGET$(" + q + "leiste" + q + ", " + q + "kopf" + q + ", " + q + "text" + q + ")" + NL
    t = t + "PROBE_ENDE()" + NL
    t = t + "--- argumente" + NL + "{sammlung}" + NL
    t = t + "--- umgebung" + NL + "DH_PATH=" + REALPATH$(pluginBibOrdner$()) + NL
    t = t + "--- erwartet" + NL + "TRUE" + NL + "TRUE" + NL + "TRUE" + NL + "a: 3 mal" + NL
    WRITEALL(PATHJOIN(ordner, "test.dhtest"), t)
    protokoll("plugin angelegt " + name)
    ' Anmelden und starten wie beim Start der IDE, dann zum Bearbeiten oeffnen.
    pluginsAusOrdner(pluginOrdner$(), FALSE)
    IF GUI_WINDOW_SHOWN(winPlug) THEN pluginListeFuellen()
    dateiOeffnen(PATHJOIN(ordner, "plugin.dh"))
    GUI_SET_TEXT(lblStatus, tr$("Plugin angelegt: ") + ordner)
    RETURN TRUE
END FUNCTION

SUB pluginsVerwalten()
    IF LEN(plugins) = 0 THEN pluginsStarten()
    pluginListeFuellen()
    GUI_WINDOW_VISIBLE(winPlug, TRUE)
    GUI_FOCUS(lstPlug)
END SUB

' Je Bild, solange das Fenster offen ist.
' --- Plugins holen (dhrt paket in den Plugin-Ordner) -------------------------
DIM dlgPlugQuelle AS GUI_WINDOW : dlgPlugQuelle = 0

SUB pluginHolenFragen()
    dlgPlugQuelle = GUI_PROMPT(tr$("Plugin holen"), tr$("Quelle (github:nutzer/repo@stand, https-Adresse oder Ordner), dahinter wahlweise --als name:"), "github:")
END SUB

' `dhrt paket -C <plugin-ordner> ...` als Prozess -- das Plugin landet in
' plugins/pakete/<name>/, Quelle und Pruefsumme in paket.json und
' paket.lock.json daneben.
SUB pluginHolenStarten(mehr AS ARRAY OF STRING)
    IF plugHolProz >= 0 THEN
        GUI_SET_TEXT(lblStatus, tr$("dhrt paket läuft noch."))
        RETURN
    END IF
    IF NOT DIREXISTS(pluginOrdner$()) THEN MKDIR(pluginOrdner$())
    ' Ein laufendes geholtes Plugin hat seinen Ordner als Arbeitsordner, und
    ' Windows ersetzt keinen Ordner, der in Gebrauch ist -- Aktualisieren
    ' und Entfernen scheiterten sonst. Danach startet pluginHolenNachziehen
    ' alle neu, auch nach einem Fehler (dann laeuft das alte weiter).
    DIM gk AS INTEGER
    FOR gk = 0 TO LEN(plugins) - 1
        IF plugins[gk].geholt AND plugins[gk].laeuft() THEN pluginStoppen(gk, "aus")
    NEXT
    DIM a AS ARRAY OF STRING : a = ["paket", "-C", pluginOrdner$()]
    DIM m AS STRING
    FOR EACH m IN mehr
        ARRAY_PUSH(a, m)
    NEXT
    ausgabe("dhrt " + JOIN$(a, " "))
    plugHolProz = PROCESS_START("dhrt", a)
    PROCESS_CLOSE_INPUT(plugHolProz)
    protokoll("plugin holen start " + JOIN$(mehr, " "))
END SUB

' Alle geholten Plugins neu holen. Ohne --erneuern ist ein geaenderter
' Inhalt ein Fehler (die Pruefsumme passt nicht) -- hier ist er gewollt: ein
' Plugin von einem Zweig (github:nutzer/repo@main) bekommt so den neuen Stand.
SUB pluginsAktualisieren()
    IF NOT FILEEXISTS(PATHJOIN(pluginOrdner$(), "paket.json")) THEN
        GUI_SET_TEXT(lblStatus, tr$("Es gibt keine geholten Plugins."))
        RETURN
    END IF
    pluginHolenStarten(["hole", "--erneuern"])
END SUB

SUB pluginHolenNachziehen()
    IF dlgPlugQuelle <> 0 THEN
        DIM aq AS INTEGER : aq = GUI_ANSWER(dlgPlugQuelle)
        IF aq <> 0 THEN
            DIM q AS STRING : q = TRIM$(GUI_DIALOG_TEXT(dlgPlugQuelle))
            dlgPlugQuelle = 0
            IF aq = 1 AND q <> "" THEN
                DIM teile AS ARRAY OF STRING : teile = ["hole"]
                DIM w AS STRING
                FOR EACH w IN SPLIT$(q, " ")
                    IF w <> "" THEN ARRAY_PUSH(teile, w)
                NEXT
                pluginHolenStarten(teile)
            END IF
        END IF
    END IF
    IF plugHolProz < 0 THEN RETURN
    DIM aus AS STRING : aus = PROCESS_READ$(plugHolProz) + PROCESS_ERR$(plugHolProz)
    IF aus <> "" THEN
        DIM zl AS STRING
        FOR EACH zl IN SPLIT$(aus, NL)
            IF TRIM$(zl) <> "" THEN ausgabe(TRIM$(REPLACE$(zl, CHR$(13), "")))
        NEXT
    END IF
    IF PROCESS_RUNNING(plugHolProz) THEN RETURN
    ' Bis zu fuenf leere Abfragen: die letzte Zeile kommt womoeglich nach.
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM rest AS STRING : rest = PROCESS_READ$(plugHolProz) + PROCESS_ERR$(plugHolProz)
        IF rest = "" THEN
            leer = leer + 1
        ELSE
            ausgabe(TRIM$(REPLACE$(rest, CHR$(13), "")))
        END IF
        SLEEP(20)
    WEND
    DIM code AS INTEGER : code = PROCESS_CODE(plugHolProz)
    PROCESS_CLOSE(plugHolProz)
    plugHolProz = -1
    protokoll("plugin holen " + STR$(code))
    pluginsNeuLaden()
    GUI_SET_TEXT(lblStatus, IIF(code = 0, tr$("Plugins: fertig -- neu geladen."), tr$("Plugins holen fehlgeschlagen -- siehe Ausgabe.")))
END SUB

SUB pluginsVerwaltenNachziehen()
    pluginAnlegenNachziehen()
    pluginHolenNachziehen()
    IF NOT GUI_WINDOW_SHOWN(winPlug) THEN RETURN
    IF GUI_CLICKED(btnPlugZu) THEN GUI_WINDOW_VISIBLE(winPlug, FALSE) : RETURN
    IF GUI_CLICKED(btnPlugNeu) THEN pluginsNeuLaden()
    IF GUI_CLICKED(btnPlugOrdner) THEN befehl("plugins_ordner")
    IF GUI_CLICKED(btnPlugAnlegen) THEN befehl("plugin_anlegen")
    IF GUI_CLICKED(btnPlugHolen) THEN pluginHolenFragen()
    IF GUI_CLICKED(btnPlugAktuell) THEN pluginsAktualisieren()
    IF GUI_CLICKED(btnPlugEntfernen) THEN
        DIM wk AS INTEGER : wk = GUI_LISTBOX_SELECTED(lstPlug)
        IF wk >= 0 AND wk < LEN(plugins) THEN
            IF plugins[wk].geholt THEN
                pluginHolenStarten(["entferne", plugins[wk].name])
            ELSE
                GUI_SET_TEXT(lblStatus, tr$("Entfernen geht nur bei geholten Plugins -- eigene liegen im Plugin-Ordner."))
            END IF
        END IF
    END IF
    DIM k AS INTEGER
    FOR k = 0 TO MIN(LEN(plugins), GUI_LISTBOX_COUNT(lstPlug)) - 1
        DIM an AS BOOLEAN : an = GUI_LISTBOX_CHECKED(lstPlug, k)
        IF an <> pluginGewollt(k) THEN
            pluginGewolltSetzen(k, an)
            IF an THEN pluginStarten(k) ELSE pluginStoppen(k, "aus")
            GUI_LISTBOX_DETAIL(lstPlug, k, plugins[k].zustand)
        END IF
    NEXT
END SUB

SUB paletteEintrag(name AS STRING, kennung AS STRING, kuerzel AS STRING)
    ARRAY_PUSH(befehle, NEW BefehlEintrag(tr$(name), kennung, kz$(kuerzel)))
END SUB

