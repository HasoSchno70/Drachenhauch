' Die ersten eigenen Funktionen.
'
' SUB:      ohne Rueckgabewert (= "macht etwas")
' FUNCTION: mit Rueckgabewert (= "berechnet etwas")

SUB Greet(name AS STRING)
    PRINT "Hallo, " + name + "!"
END SUB

FUNCTION Add(a AS INTEGER, b AS INTEGER) AS INTEGER
    RETURN a + b
END FUNCTION

Greet("Pilot")
Greet("Captain")

DIM summe AS INTEGER
summe = Add(3, 4)
PRINT f"3 + 4 = {summe}"
PRINT f"Direkt eingebettet: {Add(10, 20)}"
