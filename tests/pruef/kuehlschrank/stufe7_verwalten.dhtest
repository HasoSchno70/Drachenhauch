' Kuehlschrank-App im Drachenhauch Studio, Stufe 7 (zweiter Teil): die
' Reiter Lagerorte, Supermaerkte und Datenbank der Einstellungen
' (examples/studio/kuehlschrank: EinstellungenFenster, GangplanFenster,
' Module Lagerorte, Einkauf, Datenpflege). Proben wie in den Stufen davor:
' F5 im Studio, dann main.dh mit einer Probe statt der Bildschleife; Heute
' ist fest.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== lagerorte: anlegen, sinnbild auf der kachel, farbe, nur leer loeschen, zuruecksetzen
' Ein neuer Ort steht in storage_locations (dort lesen ihn alle Teile der
' App) und locations; sein Sinnbild auch in location_settings -- die
' Python-App schrieb es nur nach locations, die Kachel zeigte es nie.
' Loeschen nur ohne Eintraege (dort blieben sie mit einem Ort zurueck, den es
' nicht mehr gab). Zuruecksetzen gilt sofort, ohne Neustart.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
SUB ort(n AS STRING)
    PRINT n; ": "; ortSinnbild$(n); " "; HEX$(ortFarbe(n)); " | storage "; dbZahlEin("SELECT COUNT(*) FROM storage_locations WHERE name = ?", n); " locations "; dbZahlEin("SELECT COUNT(*) FROM locations WHERE name = ?", n); " settings "; dbZahlEin("SELECT COUNT(*) FROM location_settings WHERE keyword = ?", n)
END SUB
PRINT "neu ["; ortAnlegen$("Keller", "🧀"); "]"
ort("Keller")
PRINT "doppelt ["; ortAnlegen$("keller", "📦"); "] leer ["; ortAnlegen$("  ", "📦"); "]"
ortAussehenSetzen("Kühlschrank", &H112233, "🥛")
ort("Kühlschrank")
PRINT "symbol in storage "; JOIN$(textListe("SELECT icon FROM storage_locations WHERE name = 'Kühlschrank'"), "")
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Wein')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, storage_location) VALUES (1, 2, 'Flasche', 'Keller - Regal')")
PRINT "voll ["; ortLoeschen$("Keller"); "]"
DB_EXEC(db, "DELETE FROM inventory")
PRINT "leer ["; ortLoeschen$("Keller"); "]"
ort("Keller")
ortAussehenZuruecksetzen()
ort("Kühlschrank")
' Im Fenster: die Tabelle, ein neuer Ort ueber Feld und Knopf.
DIM ef AS EinstellungenFenster : ef = NEW EinstellungenFenster()
ef.Zeigen()
PRINT "zeilen "; GUI_TABLE_ROW_COUNT(ef.ortTabelle); " | "; GUI_TABLE_GET_CELL(ef.ortTabelle, 0, 0); " "; GUI_TABLE_GET_CELL(ef.ortTabelle, 0, 1); " "; GUI_TABLE_GET_CELL(ef.ortTabelle, 0, 2); " "; GUI_TABLE_GET_CELL(ef.ortTabelle, 0, 3)
GUI_SET_TEXT(ef.ortNameFeld, "Dachboden")
ef.neuSinnbild = "🍹"
ef.knopfOrtNeu_Klick()
DIM z AS INTEGER : z = GUI_TABLE_ROW_COUNT(ef.ortTabelle) - 1
PRINT "danach "; z + 1; " | "; GUI_TABLE_GET_CELL(ef.ortTabelle, z, 0); " "; GUI_TABLE_GET_CELL(ef.ortTabelle, z, 1); " | feld ["; GUI_TEXT(ef.ortNameFeld); "] knopf "; GUI_TEXT(ef.ortSinnbildKnopf); " | geaendert "; ef.datenGeaendert
PRINT "im bestand waehlbar "; ARRAY_INDEXOF(lagerorte(), "Dachboden") >= 0
--- erwartet
geprueft TRUE
neu []
Keller: 🧀 4682B4 | storage 1 locations 1 settings 1
doppelt [Lagerort „keller“ gibt es schon.] leer [Bitte gib einen Namen ein!]
Kühlschrank: 🥛 112233 | storage 1 locations 1 settings 1
symbol in storage 🥛
voll [An „Keller“ liegen noch 1 Eintrag -- erst woandershin verlegen.]
leer []
Keller: 📦 4682B4 | storage 0 locations 0 settings 0
Kühlschrank: 🧊 3498DB | storage 1 locations 1 settings 0
zeilen 9 | 🧊 Kühlschrank #3498DB 0
danach 10 | 🍹 Dachboden | feld [] knopf 📦 | geaendert TRUE
im bestand waehlbar TRUE
