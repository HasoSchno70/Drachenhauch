=== rechts fragt nach der bedingung
' Die Bedingung kommt ueber die Zwischenablage (Strg+V in den Kasten, Enter);
' ohne sie hielte der Debugger fuenfmal in Zeile 3.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
prBild = prBild + 1
IF prBild = 40 THEN prRand(3, 1, "e 30 2 341 0 0" + CHR$(10) + "e 30 2 86 0 0" + CHR$(10) + "e 32 1 86 0 0" + CHR$(10) + "e 32 1 341 0 0" + CHR$(10) + "e 50 2 257 0 0" + CHR$(10) + "e 52 1 257 0 0" + CHR$(10) + "e 80 2 296 0 0" + CHR$(10) + "e 82 1 296 0 0" + CHR$(10) + "e 230 2 297 0 0" + CHR$(10) + "e 232 1 297 0 0" + CHR$(10), 10)
--- einschub nach protokoll("bereit")
IMPORT "hilfe.dh"
CLIPBOARD_SET("i = 3")
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=430
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
DIM i AS INTEGER
FOR i = 1 TO 5
PRINT i
NEXT
--- datei _programm/hilfe.dh
IMPORT "{sammlung}/_hilfen/idemaus.dh"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
PRINT alle$("rand ")
PRINT alle$("haltepunkt ")
PRINT alle$("debug pause ")
PRINT "debug beendet "; hat("debug beendet")
--- erwartet
rand rechts 3
haltepunkt 3 bedingt i = 3
debug pause 3
debug beendet TRUE

=== haltepunkte in einer importierten datei halten dort
' Bis 2026-09-27 zaehlte der Debugger Zeilen der zusammengefuegten Quelle
' und die IDE schickte nur Haltepunkte der gestarteten Datei: beide Haltepunkte
' hier hielten nie. Der auf dem SUB-Kopf rutscht in die erste Zeile mit Code.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
prBild = prBild + 1
IF prBild = 30 THEN
    haltepunktUmschaltenIn(tabPfade[aktiverTab], 4)
    haltepunktUmschaltenIn(PATHJOIN(DIRNAME(tabPfade[aktiverTab]), "helfer.dh"), 2)
    befehl("debug")
END IF
IF (prBild = 150 OR prBild = 230) AND debugPause THEN befehl("weiter_d")
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=340
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
IMPORT "helfer.dh"
DIM x AS INTEGER
x = 1
x = 2
hallo()
PRINT x
--- datei helfer.dh
' eine Hilfe
SUB hallo()
    PRINT "hallo"
END SUB
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
PRINT alle$("haltepunkt ")
PRINT alle$("debug ")
--- erwartet
haltepunkt 4 an|haltepunkt 2 an|haltepunkt verschoben 2 3
debug gestartet|debug pause 4|debug pause 3|debug datei helfer.dh|debug beendet

=== ein haltepunkt wandert mit seiner zeile
' Eine Zeile ueber dem Haltepunkt eingefuegt: der rote Punkt rutscht mit,
' und der Debugger haelt an der Zeile, die gemeint war -- vorher blieb er
' auf seiner Nummer und hielt eine Zeile zu frueh.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
prBild = prBild + 1
IF prBild = 30 THEN haltepunktUmschaltenIn(tabPfade[aktiverTab], 3)
IF prBild = 40 THEN
    GUI_TEXTAREA_SELECT(tabFelder[aktiverTab], 1, 1, 1, 1)
    GUI_TEXTAREA_INSERT(tabFelder[aktiverTab], "PRINT " + CHR$(34) + "neu" + CHR$(34) + CHR$(10))
END IF
IF prBild = 60 THEN
    sichern(aktiverTab, FALSE)
    befehl("debug")
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=240
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT "a"
PRINT "b"
PRINT "c"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
PRINT alle$("marken gewandert")
PRINT alle$("debug pause")
--- erwartet
marken gewandert 4
debug pause 4

=== input im debugger nimmt die eingabezeile
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
prBild = prBild + 1
IF prBild = 30 THEN befehl("debug")
IF prBild = 100 AND debugPause THEN befehl("weiter_d")
IF prBild = 170 AND debugEingabe THEN
    GUI_SET_TEXT(tfEingabe, "21")
    eingabeSenden()
END IF
IF prBild = 250 THEN
    DIM prK AS INTEGER
    FOR prK = 0 TO GUI_LISTBOX_COUNT(lstAusgabe) - 1
        IF INSTR(GUI_LISTBOX_ITEM(lstAusgabe, prK), "doppelt 42") >= 0 THEN protokoll("gefunden doppelt")
    NEXT
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=260
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
DIM n AS INTEGER
INPUT "Zahl"; n
PRINT "doppelt "; n * 2
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
PRINT alle$("debug ")
PRINT alle$("gefunden")
--- erwartet
debug gestartet|debug pause 1|debug eingabe 2|debug eingabe gesendet|debug beendet
gefunden doppelt

=== anhalten haelt ein laufendes programm
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
prBild = prBild + 1
IF prBild = 30 THEN befehl("debug")
IF prBild = 100 AND debugPause THEN befehl("weiter_d")
IF prBild = 140 THEN befehl("anhalten")
IF prBild = 200 AND debugPause THEN befehl("stopp")
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=280
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
DIM i AS INTEGER
WHILE TRUE
    SLEEP(5)
    i = i + 1
WEND
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM n AS INTEGER : n = 0
DIM a AS BOOLEAN : a = FALSE
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 12) = "debug pause " THEN n = n + 1
    IF L[i] = "anhalten" THEN a = TRUE
NEXT
PRINT a; " "; n
--- erwartet
TRUE 2

=== ein haltepunkt in einer fremden datei meldet nicht haelt nie
' Beim Dogfooding 2026-09-30: die Statuszeile sagte "Haltepunkt haelt nie
' ... test.dh:5" -- ein Haltepunkt aus einem ganz anderen Projekt. Die IDE
' schickt alle Haltepunkte; einer in einer Datei, die das Programm nicht
' enthaelt, ist kein Befund (`in_program` FALSE). Einer ohne Code darunter in
' der eigenen Datei bleibt es.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
prBild = prBild + 1
IF prBild = 30 THEN
    hpNeu(PATHJOIN(projektOrdner, "anders.dh"), 1, "")
    hpNeu(tabPfade[aktiverTab], 99, "")
    befehl("debug")
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=300
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT "a"
PRINT "b"
PRINT "c"
--- datei anders.dh
PRINT "gehoert nicht dazu"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 15) = "haltepunkt nie " THEN PRINT L[i]
NEXT
--- erwartet
haltepunkt nie spiel.dh:99

=== nach weiter holt die ide das programmfenster nach vorn
' Beim Dogfooding gefunden: nach "Weiter" (F8) lag das Programmfenster
' hinter der IDE -- ein Programm im Hintergrund darf sich unter Windows
' nicht selbst nach vorn holen. Die IDE holt es mit PROCESS_FRONT; ein
' Einzelschritt tut das nicht (das Fenster sprang sonst bei jedem F10).
' Beim ersten Weiter (zum Haltepunkt) gibt es noch kein Fenster: FALSE,
' das Kind bekommt nur die Erlaubnis fuer sein erstes.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     IF GUI_DOUBLE_CLICKED(lstProbleme) THEN problemAnspringen()
prBild = prBild + 1
IF prBild = 40 THEN
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 3, 1)
    haltepunktUmschalten()
    WRITEALL("prtasten.txt", "c 6" + CHR$(10) + "e 0 2 296 0 0" + CHR$(10) + "e 2 1 296 0 0" + CHR$(10) + "e 100 2 299 0 0" + CHR$(10) + "e 102 1 299 0 0" + CHR$(10) + "e 160 2 297 0 0" + CHR$(10) + "e 162 1 297 0 0" + CHR$(10) + CHR$(10))
    AUTOMATION_PLAY("prtasten.txt")
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=500
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
SCREEN(160, 100, "Spiel", 1)
SET_WINDOW_POS(-3000, -3000)
PRINT "halt"
PRINT "schritt"
DIM i AS INTEGER
FOR i = 1 TO 120
    CLS(0) : FLIP()
NEXT
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 12) = "debug pause " OR LEFT$(L[i], 14) = "programm vorn " THEN PRINT L[i]
NEXT
--- erwartet
programm vorn FALSE
debug pause 3
debug pause 4
programm vorn TRUE
