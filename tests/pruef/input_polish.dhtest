' Aus test_input_polish.py uebertragen (11 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== special keys have readable names
SCREEN(160, 120, "In", 1)
PRINT KEY_NAME$(KEY_SPACE)
PRINT KEY_NAME$(KEY_LEFT)
PRINT KEY_NAME$(KEY_F5)
PRINT KEY_NAME$(KEY_LSHIFT)
PRINT KEY_NAME$(KEY_KP_ENTER)
--- umgebung
DHRT_FRAMES=1
--- erwartet
LEER
LINKS
F5
UMSCHALT
ENTER

=== printable key uses the keyboard layout
SCREEN(160, 120, "In", 1)
PRINT KEY_NAME$(KEY_A)
--- umgebung
DHRT_FRAMES=1
--- erwartet
A

=== unknown code yields an empty name
SCREEN(160, 120, "In", 1)
PRINT "[" + KEY_NAME$(JOY_BUTTON_A) + "]"
PRINT "[" + KEY_NAME$(999999) + "]"
--- umgebung
DHRT_FRAMES=1
--- erwartet
[]
[]

=== key any hit is idle without input
SCREEN(160, 120, "In", 1)
PRINT KEY_ANY_HIT()
--- umgebung
DHRT_FRAMES=1
--- erwartet
-1

=== every new key constant maps to a real key
SCREEN(160, 120, "In", 1)
PRINT "KEY_LSHIFT=" + KEY_NAME$(KEY_LSHIFT)
PRINT "KEY_RSHIFT=" + KEY_NAME$(KEY_RSHIFT)
PRINT "KEY_LCTRL=" + KEY_NAME$(KEY_LCTRL)
PRINT "KEY_RCTRL=" + KEY_NAME$(KEY_RCTRL)
PRINT "KEY_LALT=" + KEY_NAME$(KEY_LALT)
PRINT "KEY_RALT=" + KEY_NAME$(KEY_RALT)
PRINT "KEY_LSUPER=" + KEY_NAME$(KEY_LSUPER)
PRINT "KEY_RSUPER=" + KEY_NAME$(KEY_RSUPER)
PRINT "KEY_CAPSLOCK=" + KEY_NAME$(KEY_CAPSLOCK)
PRINT "KEY_INSERT=" + KEY_NAME$(KEY_INSERT)
PRINT "KEY_DELETE=" + KEY_NAME$(KEY_DELETE)
PRINT "KEY_HOME=" + KEY_NAME$(KEY_HOME)
PRINT "KEY_END=" + KEY_NAME$(KEY_END)
PRINT "KEY_PAGEUP=" + KEY_NAME$(KEY_PAGEUP)
PRINT "KEY_PAGEDOWN=" + KEY_NAME$(KEY_PAGEDOWN)
PRINT "KEY_KP0=" + KEY_NAME$(KEY_KP0)
PRINT "KEY_KP1=" + KEY_NAME$(KEY_KP1)
PRINT "KEY_KP2=" + KEY_NAME$(KEY_KP2)
PRINT "KEY_KP3=" + KEY_NAME$(KEY_KP3)
PRINT "KEY_KP4=" + KEY_NAME$(KEY_KP4)
PRINT "KEY_KP5=" + KEY_NAME$(KEY_KP5)
PRINT "KEY_KP6=" + KEY_NAME$(KEY_KP6)
PRINT "KEY_KP7=" + KEY_NAME$(KEY_KP7)
PRINT "KEY_KP8=" + KEY_NAME$(KEY_KP8)
PRINT "KEY_KP9=" + KEY_NAME$(KEY_KP9)
PRINT "KEY_KP_ENTER=" + KEY_NAME$(KEY_KP_ENTER)
PRINT "KEY_KP_PLUS=" + KEY_NAME$(KEY_KP_PLUS)
PRINT "KEY_KP_MINUS=" + KEY_NAME$(KEY_KP_MINUS)
PRINT "KEY_KP_MULTIPLY=" + KEY_NAME$(KEY_KP_MULTIPLY)
PRINT "KEY_KP_DIVIDE=" + KEY_NAME$(KEY_KP_DIVIDE)
PRINT "KEY_KP_PERIOD=" + KEY_NAME$(KEY_KP_PERIOD)
--- umgebung
DHRT_FRAMES=1
--- erwartet
KEY_LSHIFT=UMSCHALT
KEY_RSHIFT=UMSCHALT
KEY_LCTRL=STRG
KEY_RCTRL=STRG
KEY_LALT=ALT
KEY_RALT=ALT
KEY_LSUPER=SUPER
KEY_RSUPER=SUPER
KEY_CAPSLOCK=FESTSTELL
KEY_INSERT=EINFG
KEY_DELETE=ENTF
KEY_HOME=POS1
KEY_END=ENDE
KEY_PAGEUP=BILD-AUF
KEY_PAGEDOWN=BILD-AB
KEY_KP0=0
KEY_KP1=1
KEY_KP2=2
KEY_KP3=3
KEY_KP4=4
KEY_KP5=5
KEY_KP6=6
KEY_KP7=7
KEY_KP8=8
KEY_KP9=9
KEY_KP_ENTER=ENTER
