' Mikrofon (MIC_*, src/mikrofon.rs). Die Laeufer der CI haben keinen Eingang,
' darum spielt eine WAV-Datei das Mikrofon: `DHRT_MIKROFON=datei.wav` speist
' sie in Echtzeit und in Schleife ueber denselben Puffer ein wie der Rueckruf
' des echten Geraets. Jeder Fall schreibt seinen Ton selbst
' (_hilfen/tonwav.dh) und setzt die Variable mit SETENV. Nicht geprueft ist
' der cpal-Weg selbst -- dazu braucht es ein Mikrofon.
' Format: docs/werkzeuge.md, dhrt test.

=== die datei ist das einzige geraet
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "sinus", 440.0, 0.5, 0.5, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
DIM g AS ARRAY OF STRING
g = MIC_DEVICES()
PRINT LEN(g); " "; g[0]
PRINT MIC_ACTIVE(); " "; MIC_RATE(); " ["; MIC_DEVICE$(); "]"
MIC_START()
PRINT MIC_ACTIVE(); " "; MIC_RATE(); " ["; MIC_DEVICE$(); "]"
MIC_STOP()
PRINT MIC_ACTIVE(); " "; MIC_RATE()
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- erwartet
1 Datei: ton.wav
FALSE 0 []
TRUE 48000 [Datei: ton.wav]
FALSE 0

=== pegel und effektivwert eines sinus
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "sinus", 440.0, 0.5, 0.5, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
MIC_START()
SLEEP(200)
DIM sp AS FLOAT : sp = MIC_LEVEL()
PRINT "spitze "; ABS(sp - 0.5) < 0.01
PRINT "effektivwert "; ABS(MIC_RMS() - 0.5 / SQR(2.0)) < 0.01
' Die Spitze gilt seit der letzten Frage -- gleich danach ist sie klein.
PRINT "danach "; MIC_LEVEL() < 0.5
PRINT "werte "; MIC_SAMPLES() > 48000 \ 10
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- erwartet
spitze TRUE
effektivwert TRUE
danach TRUE
werte TRUE

=== die tonhoehe von sinus und saege
' Die Saege hat starke Obertoene; gemeint ist trotzdem der Grundton. Auf
' 0,2 % genau -- ohne die Feinrechnung zwischen zwei Abtastwerten waeren es
' bei 1250 Hz 0,8 %.
IMPORT "audio"
IMPORT "ton.dh"
DIM paare AS ARRAY OF STRING
paare = ["sinus 440", "sinus 110", "saege 196", "sinus 1250"]
DIM p AS STRING
FOR EACH p IN paare
    DIM teile AS ARRAY OF STRING
    teile = SPLIT(p, " ")
    DIM hz AS FLOAT : hz = VAL(teile[1])
    tonWav("ton.wav", teile[0], hz, 0.3, 0.4, 44100)
    SETENV("DHRT_MIKROFON", "ton.wav")
    MIC_START()
    SLEEP(150)
    DIM f AS FLOAT : f = MIC_PITCH()
    PRINT p; " "; ABS(f - hz) / hz < 0.002
    MIC_STOP()
NEXT
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- erwartet
sinus 440 TRUE
sinus 110 TRUE
saege 196 TRUE
sinus 1250 TRUE

=== stille hat weder pegel noch ton
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "stille", 0.0, 0.3, 0.0, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
MIC_START()
SLEEP(150)
PRINT MIC_LEVEL(); " "; MIC_RMS(); " "; MIC_PITCH()
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- erwartet
0.0 0.0 0.0

=== das spektrum folgt der frequenz
' 16 Baender, logarithmisch: ein hoher Ton hebt ein weiter rechts liegendes
' Band als ein tiefer.
IMPORT "audio"
IMPORT "ton.dh"
FUNCTION staerkstes(hz AS FLOAT) AS INTEGER
    tonWav("ton.wav", "sinus", hz, 0.3, 0.5, 48000)
    SETENV("DHRT_MIKROFON", "ton.wav")
    MIC_START()
    SLEEP(150)
    DIM b[16] AS FLOAT
    MIC_FFT(b)
    MIC_STOP()
    DIM best AS INTEGER : best = 0
    DIM i AS INTEGER
    FOR i = 1 TO 15
        IF b[i] > b[best] THEN best = i
    NEXT
    PRINT "staerkstes "; b[best] = 1.0
    RETURN best
END FUNCTION
DIM tief AS INTEGER : tief = staerkstes(200.0)
DIM hoch AS INTEGER : hoch = staerkstes(5000.0)
PRINT "hoch rechts von tief "; hoch > tief + 3
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- erwartet
staerkstes TRUE
staerkstes TRUE
hoch rechts von tief TRUE

=== die wellenform sind die juengsten werte
' 480 Werte bei 48 kHz sind 10 ms -- vier ganze Perioden von 400 Hz: der
' erste Wert und der 121. liegen eine Periode auseinander.
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "sinus", 400.0, 0.3, 0.5, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
MIC_START()
SLEEP(150)
DIM w[480] AS FLOAT
MIC_WAVE(w)
DIM gross AS FLOAT : gross = 0.0
DIM i AS INTEGER
FOR i = 0 TO 479
    gross = MAX(gross, ABS(w[i]))
NEXT
PRINT "ausschlag "; ABS(gross - 0.5) < 0.01
PRINT "periode "; ABS(w[0] - w[120]) < 0.01; " "; ABS(w[17] - w[137]) < 0.01
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- erwartet
ausschlag TRUE
periode TRUE TRUE

=== die aufnahme als wav
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "sinus", 440.0, 0.25, 0.5, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
MIC_START()
MIC_RECORD_START(0.5)
PRINT MIC_RECORDING()
SLEEP(800)
' Hoechstens eine halbe Sekunde -- auch wenn laenger gewartet wurde.
PRINT MIC_RECORD_SAVE("aufnahme.wav")
PRINT MIC_RECORDING()
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- erwartet
TRUE
24000
FALSE
--- ton aufnahme.wav
kanaele 1
bits 16
abtastrate 48000
dauer 0.5 +-0.001
spitze 0.5 +-0.01

=== die aufnahme als klang
' Ein SOUND braucht die Audio-Ausgabe -- ohne Soundkarte ist der Fall
' uebersprungen (NoDefaultOutputDevice), MIC_RECORD_SAVE geht ohne.
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "sinus", 440.0, 0.25, 0.5, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
MIC_START()
MIC_RECORD_START(0.3)
SLEEP(500)
DIM s AS SOUND
s = MIC_RECORD_STOP()
AUDIO_SAVE_WAV(s, "klang.wav")
PRINT "gesichert"
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- erwartet
gesichert
--- ton klang.wav
kanaele 1
abtastrate 48000
dauer 0.3 +-0.02
spitze 0.5 +-0.01

=== ohne mic_start ist es ein fehler
' Eine stille Null waere von "es ist leise" nicht zu unterscheiden.
IMPORT "audio"
PRINT MIC_ACTIVE()
PRINT MIC_LEVEL()
--- fehler
MIC_LEVEL: es laeuft kein Mikrofon -- erst MIC_START

=== nach mic_stop ist es wieder ein fehler
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "sinus", 440.0, 0.25, 0.5, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
MIC_START()
MIC_STOP()
DIM b[8] AS FLOAT
MIC_FFT(b)
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- fehler
MIC_FFT: es laeuft kein Mikrofon -- erst MIC_START

=== ein unbekanntes geraet nennt die vorhandenen
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "sinus", 440.0, 0.25, 0.5, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
MIC_START("Studiomikrofon")
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- fehler
MIC_START: kein Eingang 'Studiomikrofon' -- es gibt: Datei: ton.wav

=== eine aufnahme ohne start ist ein fehler
IMPORT "audio"
IMPORT "ton.dh"
tonWav("ton.wav", "sinus", 440.0, 0.25, 0.5, 48000)
SETENV("DHRT_MIKROFON", "ton.wav")
MIC_START()
PRINT MIC_RECORD_SAVE("x.wav")
--- datei ton.dh
IMPORT "{sammlung}/../_hilfen/tonwav.dh"
--- fehler
MIC_RECORD_SAVE: es laeuft keine Aufnahme -- erst MIC_RECORD_START

=== mic_fft will ein feld aus kommazahlen
IMPORT "audio"
DIM b[8] AS INTEGER
MIC_FFT(b)
--- fehler
MIC_FFT: erwartet 1D ARRAY OF FLOAT
