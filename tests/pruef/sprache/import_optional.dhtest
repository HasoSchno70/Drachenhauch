' IMPORT "modul" OPTIONAL und MODULE_AVAILABLE (2026-11-04): ein Programm,
' das ein Hardware-Modul nur benutzt, wenn es im Bau ist, soll in einem Bau
' ohne --hardware nicht warnen -- weder beim Import noch an den Aufrufen.
' Die Faelle gelten in beiden Bauten; was nur ohne das Modul zu sehen ist,
' ueberspringt sich im Hardware-Bau.

=== optional importiert warnt nicht, auch nicht an den aufrufen
IMPORT "helfer.dh"
IMPORT "json"
DIM d AS JSON_HANDLE : d = dlCheck(!"IMPORT \"serial\" OPTIONAL\nIF MODULE_AVAILABLE(\"serial\") THEN PRINT SERIAL_PORTS()\nPRINT 1\n")
PRINT "befunde "; JSON_LEN(d, "d")
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- erwartet
befunde 0

=== ohne optional warnt der bau ohne das modul weiter
' Gegenprobe: dieselbe Zeile ohne OPTIONAL. Auch ein zweiter, schlichter
' Import desselben Moduls hebt das OPTIONAL wieder auf.
IMPORT "helfer.dh"
IMPORT "json"
DIM a AS JSON_HANDLE : a = dlCheck(!"IMPORT \"serial\"\nPRINT 1\n")
DIM b AS JSON_HANDLE : b = dlCheck(!"IMPORT \"serial\" OPTIONAL\nIMPORT \"serial\"\nPRINT 1\n")
IF MODULE_AVAILABLE("serial") THEN
    PRINT "UEBERSPRINGEN: Hardware-Bau, das Modul ist dabei -- keine Warnung zu pruefen"
ELSE
    PRINT "schlicht "; JSON_LEN(a, "d"); " Zeile "; JSON_GET_INT(a, "d.0.line")
    PRINT "beide "; JSON_LEN(b, "d"); " Zeile "; JSON_GET_INT(b, "d.0.line")
END IF
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- erwartet
schlicht 1 Zeile 1
beide 1 Zeile 2

=== der lauf warnt nicht auf stderr
IMPORT "helfer.dh"
dlStarten(["run", CWD$() + "/prog.dh"])
PRINT "aus "; TRIM$(dlAus); " code "; dlCode
PRINT "stderr leer "; (TRIM$(dlErr) = "")
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- datei prog.dh
IMPORT "serial" OPTIONAL
IMPORT "usb" OPTIONAL
PRINT "ok"
--- erwartet
aus ok code 0
stderr leer TRUE

=== module_available kennt die module dieses baus
' json ist immer dabei, ein erfundener Name nie. Fuer serial muss die Antwort
' zu dem passen, was `dhrt --version` unter "dabei" nennt. Firmata gibt es
' seit 2026-11-05 in jedem Bau (ueber das Netz, tcp:host:port).
IMPORT "helfer.dh"
dlStarten(["--version"])
DIM dabei AS STRING : dabei = ""
DIM z AS STRING
FOR EACH z IN SPLIT(dlAus, CHR$(10))
    IF LEFT$(TRIM$(z), 6) = "dabei:" THEN dabei = TRIM$(z)
NEXT
PRINT "json "; MODULE_AVAILABLE("json"); " JSON "; MODULE_AVAILABLE("JSON")
PRINT "quatsch "; MODULE_AVAILABLE("quatsch")
PRINT "serial passt "; (MODULE_AVAILABLE("serial") = (INSTR(dabei, "seriell") >= 0))
PRINT "firmata "; MODULE_AVAILABLE("firmata")
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- erwartet
json TRUE JSON TRUE
quatsch FALSE
serial passt TRUE
firmata TRUE

=== optional an einer datei: fehlt sie, faellt die zeile weg
IMPORT "da.dh" OPTIONAL
IMPORT "fehlt.dh" OPTIONAL
PRINT gruss$()
--- datei da.dh
FUNCTION gruss$() AS STRING
    RETURN "aus da.dh"
END FUNCTION
--- erwartet
aus da.dh

=== ohne optional ist eine fehlende datei weiter ein fehler
IMPORT "fehlt.dh"
PRINT 1
--- fehler
Datei nicht gefunden: fehlt.dh

=== module_available passt in jedem bau zu dabei
' Bis 2026.53 kannte MODULE_AVAILABLE nur die Hardware-Module: in einem Bau
' ohne Grafik oder Netz (dhrt-mini, die CI auf Linux und macOS) sagte es
' TRUE zu gui, db, net, pdf, websocket ... und der erste Aufruf scheiterte.
' Jetzt fragt es dieselbe Tabelle wie `dhrt --version` (bau.rs). Ausgegeben
' wird nur, was NICHT passt.
IMPORT "helfer.dh"
dlStarten(["--version"])
DIM dabei AS STRING : dabei = ""
DIM z AS STRING
FOR EACH z IN SPLIT(dlAus, CHR$(10))
    IF LEFT$(TRIM$(z), 6) = "dabei:" THEN dabei = TRIM$(z) + ","
NEXT
' Modul = das Wort, das --version fuer sein Feature nennt.
DIM paare AS ARRAY OF STRING
paare = ["db=datenbank", "net=netz", "mqtt=netz", "websocket=netz", "httpd=netz",
         "html=http", "cloud=http", "smtp=mail", "pdf=pdf", "physics2d=physik", "physics3d=physik",
         "serial=seriell", "usb=usb", "bt=bluetooth", "wifi=wlan",
         "gui=grafik", "audio=grafik", "ui=grafik", "imgfx=grafik", "g3d=grafik", "input=grafik", "webcam=grafik"]
DIM p AS STRING
DIM falsch AS INTEGER : falsch = 0
FOR EACH p IN paare
    DIM teile AS ARRAY OF STRING : teile = SPLIT(p, "=")
    DIM soll AS BOOLEAN : soll = (INSTR(dabei, " " + teile[1]) >= 0)
    IF MODULE_AVAILABLE(teile[0]) <> soll THEN
        PRINT teile[0]; ": MODULE_AVAILABLE "; MODULE_AVAILABLE(teile[0]); ", --version "; soll
        falsch = falsch + 1
    END IF
NEXT
' Was ohne Feature immer geht.
PRINT "json "; MODULE_AVAILABLE("json"); " m3d "; MODULE_AVAILABLE("m3d"); " geld "; MODULE_AVAILABLE("geld")
PRINT "falsch "; falsch
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- erwartet
json TRUE m3d TRUE geld TRUE
falsch 0

=== ein fehlender befehl sagt es mit einem satz
' Bis 2026.53 acht Wortlaute: "Builtin 'X' gehoert zum Hardware-Modul ...",
' "... im Rust-Kern noch nicht verfuegbar (Schritt 4)", "httpd: dieser
' dhrt-Build hat das Netz-Feature nicht", "... ist ohne das Feature `pdf`
' gebaut" ... Jetzt einer: "NAME: gibt es in dieser Laufzeit nicht (ohne x
' gebaut)" -- und `dhrt --fehlende` erkennt ihn.
IMPORT "helfer.dh"
IF MODULE_AVAILABLE("serial") AND MODULE_AVAILABLE("bt") THEN
    PRINT "UEBERSPRINGEN: Hardware-Bau, die Module sind dabei"
ELSE
    TRY
        PRINT SERIAL_PORTS()
    CATCH e
        PRINT LEFT$(e, INSTR(e, ")") + 1)
    END TRY
    TRY
        PRINT BT_SCAN(1)
    CATCH e
        PRINT LEFT$(e, INSTR(e, ")") + 1)
    END TRY
    dlStarten(["--fehlende", "serial_ports", "bt_scan", "json_parse"])
    PRINT "fehlende "; REPLACE$(TRIM$(dlAus), CHR$(10), " ")
END IF
--- datei helfer.dh
IMPORT "{sammlung}/../_hilfen/dhrtlauf.dh"
--- erwartet
SERIAL_PORTS: gibt es in dieser Laufzeit nicht (ohne seriell gebaut)
BT_SCAN: gibt es in dieser Laufzeit nicht (ohne bluetooth gebaut)
fehlende serial_ports bt_scan
