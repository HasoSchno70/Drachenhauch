=== new keys are queryable and idle
SCREEN(160, 120, "In", 1)
PRINT KEYPRESSED(KEY_LSHIFT)
PRINT KEYHIT(KEY_KP_ENTER)
PRINT KEYRELEASED(KEY_PAGEUP)
--- umgebung
DHRT_FRAMES=1
--- erwartet
FALSE
FALSE
FALSE

=== mouse wheel has both axes and is fractional
SCREEN(160, 120, "In", 1)
PRINT MOUSEWHEEL_X()
PRINT MOUSEWHEEL_Y()
--- umgebung
DHRT_FRAMES=1
--- erwartet
0.0
0.0

=== mouse wheel axes work without a window
PRINT MOUSEWHEEL_X()
PRINT MOUSEWHEEL_Y()
--- umgebung
DHRT_FRAMES=1
--- erwartet
0.0
0.0

=== gamepad mappings accepts an sdl line
SCREEN(160, 120, "In", 1)
PRINT JOYSTICK_MAPPINGS("030000005e0400008e02000014010000,Xbox 360 Controller,a:b0,b:b1,x:b2,y:b3,platform:Windows,")
--- umgebung
DHRT_FRAMES=1
--- erwartet
1

=== garbage mappings do not crash
SCREEN(160, 120, "In", 1)
PRINT JOYSTICK_MAPPINGS("")
PRINT JOYSTICK_MAPPINGS("kein mapping")
--- umgebung
DHRT_FRAMES=1
--- erwartet
1
1

=== window dpi scale is positive
SCREEN(160, 120, "In", 1)
PRINT WINDOW_DPI_X() > 0.0
PRINT WINDOW_DPI_Y() > 0.0
--- umgebung
DHRT_FRAMES=1
--- erwartet
TRUE
TRUE

