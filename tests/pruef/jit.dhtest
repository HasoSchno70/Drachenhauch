=== feld in einer funktion
FUNCTION summe(n AS INTEGER) AS INTEGER
    DIM a[n] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        a[i] = i * i
    NEXT
    DIM s AS INTEGER
    FOR i = 0 TO n - 1
        s = s + a[i]
    NEXT
    RETURN s
END FUNCTION
PRINT summe(10); " "; summe(100)
