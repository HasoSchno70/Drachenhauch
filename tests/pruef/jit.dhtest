=== kleinste zahl durch minus eins
FUNCTION q(a AS INTEGER, b AS INTEGER) AS INTEGER
    RETURN a \ b
END FUNCTION
FUNCTION r(a AS INTEGER, b AS INTEGER) AS INTEGER
    RETURN a MOD b
END FUNCTION
FUNCTION n(a AS INTEGER) AS INTEGER
    RETURN -a
END FUNCTION
DIM m AS INTEGER : m = -9223372036854775807 - 1
PRINT q(m, 2); " "; r(m, 3); " "; n(m + 1)
TRY
    PRINT q(m, -1)
CATCH e
    PRINT e
END TRY
TRY
    PRINT r(m, -1)
CATCH e
    PRINT e
END TRY
TRY
    PRINT n(m)
CATCH e
    PRINT e
END TRY
--- erwartet
-4611686018427387904 1 9223372036854775807
Ganzzahl-Ueberlauf bei '\' (INTEGER ist 64-bit; Wertebereich ueberschritten)
Ganzzahl-Ueberlauf bei 'MOD' (INTEGER ist 64-bit; Wertebereich ueberschritten)
Ganzzahl-Ueberlauf bei '-' (INTEGER ist 64-bit; Wertebereich ueberschritten)

