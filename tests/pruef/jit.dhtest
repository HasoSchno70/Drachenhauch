=== zahlbefehle in einer funktion (maschinencode)
FUNCTION weg(x AS FLOAT, y AS FLOAT) AS FLOAT
    RETURN SQR(x * x + y * y) + ABS(x) - FLOOR(y)
END FUNCTION
FUNCTION wurzelsumme(n AS INTEGER) AS FLOAT
    DIM s AS FLOAT
    DIM i AS INTEGER
    FOR i = n TO -1 STEP -1
        s = s + SQR(i)
    NEXT
    RETURN s
END FUNCTION
