' Die Doku gegen die Wirklichkeit: Codebloecke, Befehlsnamen, Zaehlungen,
' Tastenkonstanten, Pfade und Links (`dhrt pruef`), die erzeugten Dateien
' builtin_prosa.json und die VS-Code-Grammatik (`dhrt doku ... --pruefen`).
'
' Bis 2026-09-16 tests/test_doku_aussagen.py, test_docs_codebloecke.py,
' test_vscode_grammatik.py und test_builtin_prosa.py. Jeder Fall bekommt die
' Repo-Wurzel als Argument und wechselt dorthin, bevor er dhrt startet --
' `dhrt pruef` und `dhrt doku` suchen die Wurzel vom Arbeitsordner aus. Proben
' mit eigenen Markdown-Dateien legen sie VORHER in den Fallordner.
'
' Entstanden sind die Pruefungen aus Durchgaengen durch docs/: elf
' Codebeispiele, die beim Abtippen abbrachen, sieben falsche Aussagen, vier
' tote Links in CLAUDE.md und eine Grammatik, die 223 Befehle nicht kannte.

=== alle codebloecke der doku uebersetzen
IMPORT "helfer.dh"
CHDIR(ARG$(0))
dlStarten(["pruef", "bloecke"])
DIM alles AS STRING : alles = dlAus + dlErr
' Die Schranke gegen eine kaputte Erkennung, die gar nichts findet.
PRINT "ueber 100 bloecke "; (zahlVor(alles, " Codebloecke") > 100)
IF dlCode <> 0 THEN PRINT alles
PRINT "rueckgabe "; dlCode
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
' Die Zahl direkt vor einem Wort ("1234 Codebloecke").
FUNCTION zahlVor(text AS STRING, wort AS STRING) AS INTEGER
    DIM wo AS INTEGER : wo = INSTR(text, wort)
    IF wo < 0 THEN RETURN -1
    DIM anfang AS INTEGER : anfang = wo
    WHILE anfang > 0 AND INSTR("0123456789", MID$(text, anfang - 1, 1)) >= 0
        anfang = anfang - 1
    WEND
    RETURN VAL(MID$(text, anfang, wo - anfang))
END FUNCTION
--- erwartet
ueber 100 bloecke TRUE
rueckgabe 0

=== notation in codebloecken gilt nicht als fehler
' `...`, `[optional]` und `FOR each` sind Schreibweise, kein Programm -- ohne
' den Filter meldete der Pruefer 27 Fehler, die mit Absicht so dastehen. Ein
' echter Fehler wird weiter gemeldet, samt Datei und Zeile.
IMPORT "helfer.dh"
DIM fall AS STRING : fall = CWD$()
MKDIR("probe")
WRITEALL("probe/probe.md", "```basic" + CHR$(10) + "PRINT ..." + CHR$(10) + _
    "SPEAK(text$ [, unterbrechen])" + CHR$(10) + "```" + CHR$(10) + CHR$(10) + _
    "```basic" + CHR$(10) + "PRINT 1" + CHR$(10) + "```" + CHR$(10))
CHDIR(ARG$(0))
dlStarten(["pruef", "bloecke", fall + "/probe"])
PRINT "ohne kaputt: rueckgabe "; dlCode; ", zwei bloecke "; (INSTR(dlAus + dlErr, "2 Codebloecke") >= 0)
WRITEALL(fall + "/probe/kaputt.md", "```basic" + CHR$(10) + "DIM x AS" + CHR$(10) + "```" + CHR$(10))
dlStarten(["pruef", "bloecke", fall + "/probe"])
PRINT "mit kaputt: rueckgabe "; dlCode; ", zeile genannt "; (INSTR(dlAus + dlErr, "kaputt.md:2") >= 0)
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
ohne kaputt: rueckgabe 0, zwei bloecke TRUE
mit kaputt: rueckgabe 1, zeile genannt TRUE

=== relative links in docs zeigen auf etwas
' Gefunden hatte das acht Stueck: dreimal ein Pfad relativ zum falschen
' Ordner, fuenfmal Python-Dateien, die mit Stufe B geloescht wurden.
IMPORT "regex"
DIM docs AS STRING : docs = ARG$(0) + "/docs"
DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(docs, "*.md")
SORT(dateien)
DIM geprueft AS INTEGER : geprueft = 0
DIM i AS INTEGER
FOR i = 0 TO LEN(dateien) - 1
    DIM text AS STRING : text = BUFFER_TO_STRING$(READALL_BYTES(docs + "/" + dateien[i]))
    DIM links AS ARRAY OF STRING : links = REGEX_FIND_ALL(text, "\[[^\]]*\]\([^)\s]+\)")
    DIM k AS INTEGER
    FOR k = 0 TO LEN(links) - 1
        DIM ziel AS STRING : ziel = links[k]
        ziel = MID$(ziel, INSTR(ziel, "](") + 2)
        ziel = LEFT$(ziel, LEN(ziel) - 1)
        IF LEFT$(ziel, 7) = "http://" OR LEFT$(ziel, 8) = "https://" OR LEFT$(ziel, 1) = "#" OR LEFT$(ziel, 7) = "mailto:" THEN CONTINUE
        IF INSTR(ziel, "#") >= 0 THEN ziel = LEFT$(ziel, INSTR(ziel, "#"))
        IF ziel = "" THEN CONTINUE
        geprueft = geprueft + 1
        DIM pfad AS STRING : pfad = docs + "/" + ziel
        IF NOT FILEEXISTS(pfad) AND NOT DIREXISTS(pfad) THEN PRINT "tot: "; dateien[i]; " -> "; links[k]
    NEXT
NEXT
' Die Schranke: ohne sie waere ein Muster, das nichts mehr trifft, gruen.
PRINT "links gefunden "; (geprueft > 50)
--- argumente
{sammlung}/../..
--- erwartet
links gefunden TRUE

=== jede doku ist vom index erreichbar
' Sonst schreibt jemand 181 Zeilen, die niemand findet (scope.md).
IMPORT "regex"
DIM docs AS STRING : docs = ARG$(0) + "/docs"
DIM index AS STRING : index = BUFFER_TO_STRING$(READALL_BYTES(docs + "/README.md"))
DIM verlinkt AS MAP OF BOOLEAN
DIM treffer AS ARRAY OF STRING : treffer = REGEX_FIND_ALL(index, "\(([A-Za-z0-9_.-]+\.md)\)")
DIM i AS INTEGER
FOR i = 0 TO LEN(treffer) - 1
    ' Mit einer Gruppe im Muster liefert REGEX_FIND_ALL die Gruppe, nicht den Treffer.
    MAPPUT(verlinkt, treffer[i], TRUE)
NEXT
DIM alle AS ARRAY OF STRING : alle = DIRLIST(docs, "*.md")
SORT(alle)
DIM fehlen AS INTEGER : fehlen = 0
FOR i = 0 TO LEN(alle) - 1
    IF alle[i] = "README.md" THEN CONTINUE
    IF NOT MAPHAS(verlinkt, alle[i]) THEN
        PRINT "nicht im index: "; alle[i]
        fehlen = fehlen + 1
    END IF
NEXT
PRINT "dokumente "; (LEN(alle) > 20); ", fehlen "; fehlen
--- argumente
{sammlung}/../..
--- erwartet
dokumente TRUE, fehlen 0

