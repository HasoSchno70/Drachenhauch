IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = ["A", "B", "C", "D"]
DIM fa AS STRING : fa = phFarbe$("DMC", "310", "black", &H000000, ASC("X"))
