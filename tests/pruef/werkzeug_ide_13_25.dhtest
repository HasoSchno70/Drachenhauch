aus der quelle weg TRUE
import in der quelle TRUE
im ziel samt kommentar TRUE
uebersetzt []

=== die marke in einer methode verschiebt die ganze klasse
AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
a_spiel.dh
--- umgebung
DHRT_FRAMES=320
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei a_spiel.dh
CLASS Held
    SUB setze()
        PRINT 1
    END SUB
END CLASS
--- datei b_helfer.dh
' Helfer
--- datei _programm/ev.txt
c 20
e 30 2 264 0 0 0
e 32 1 264 0 0 0
e 45 2 264 0 0 0
e 47 1 264 0 0 0
e 75 2 341 0 0 0
e 75 2 340 0 0 0
e 75 2 86 0 0 0
e 77 1 86 0 0 0
e 77 1 341 0 0 0
e 77 1 340 0 0 0
e 105 2 264 0 0 0
e 107 1 264 0 0 0
e 125 2 257 0 0 0
e 127 1 257 0 0 0
e 175 2 257 0 0 0
e 177 1 257 0 0 0
e 225 2 341 0 0 0
e 225 2 83 0 0 0
e 227 1 83 0 0 0
e 227 1 341 0 0 0

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(p AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION alleEnden(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            n = n + 1
            IF RIGHT$(L[i], LEN(e)) <> e THEN RETURN FALSE
        END IF
    NEXT
    RETURN n > 0
END FUNCTION
FUNCTION inhalt$(datei AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(z) - 1
        r = r + z[i] + CHR$(10)
    NEXT
    RETURN r
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION pruefe$(datei AS STRING) AS STRING
    DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", datei)
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM befund AS STRING : befund = ""
    WHILE MILLIS() < bis
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN befund = befund + zz
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN BREAK
    WEND
    RETURN TRIM$(befund)
END FUNCTION
FUNCTION steht(datei AS STRING, t AS STRING) AS BOOLEAN
    RETURN INSTR(inhalt$(datei), t) >= 0
END FUNCTION
PRINT "verschoben " ; erste$("verschieben Held ") <> ""
PRINT "aus der quelle " ; NOT steht("a_spiel.dh", "CLASS Held")
PRINT "im ziel " ; steht("b_helfer.dh", "CLASS Held")
--- erwartet
verschoben TRUE
aus der quelle TRUE
im ziel TRUE

