' Aus test_task.py uebertragen (18 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== auftrag rechnet und liefert
FUNCTION Langsam(x AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    DIM s AS INTEGER
    s = 0
    FOR i = 1 TO 2000
        s = s + i MOD 7
    NEXT
    RETURN x * 2
END FUNCTION
DIM a AS INTEGER
a = TASK_START(Langsam, 21)
WHILE NOT TASK_READY(a)
    SLEEP(2)
WEND
PRINT TASK_RESULT$(a)
--- erwartet
42

=== die hauptschleife laeuft weiter
' Der ganze Zweck: waehrend der Auftrag rechnet, blockiert nichts.
FUNCTION Langsam(x AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    DIM s AS INTEGER
    s = 0
    FOR i = 1 TO 2000
        s = s + i MOD 7
    NEXT
    RETURN x * 2
END FUNCTION
DIM a AS INTEGER
DIM runden AS INTEGER
a = TASK_START(Langsam, 1)
runden = 0
WHILE NOT TASK_READY(a)
    runden = runden + 1
WEND
PRINT STR$(runden > 0)
--- erwartet
TRUE

