IMPORT "helfer.dh"
DIM b AS kern.Bibliothek : b = kern.leereBibliothek("x/library.json")
DIM namen AS ARRAY OF STRING : namen = ["beta", "Alpha", "gamma", "Älter", "delta"]
DIM masse AS ARRAY OF INTEGER : masse = [10, 10, 20, 5, 30, 30, 10, 10, 15, 40]
DIM farben AS ARRAY OF INTEGER : farben = [3, 7, 7, 1, 2]
DIM daten AS ARRAY OF STRING : daten = ["2026-01-02T00:00:00", "2026-03-01T00:00:00", "2025-12-31T23:59:59", "2026-03-01T00:00:00", "2026-02-01T10:00:00"]
DIM i AS INTEGER
FOR i = 0 TO 4
    DIM e AS kern.Bibliothekseintrag : e = kern.neuerBibliothekseintrag("/m/" + namen[i] + ".pxs")
    e.name = namen[i]
    e.breite = masse[2 * i]
    e.hoehe = masse[2 * i + 1]
    e.farben = farben[i]
    e.hinzugefuegt = daten[i]
    e.kategorien = kern.autoKategorien(e.pfad)
    ARRAY_PUSH(b.eintraege, e)
NEXT
b.eintraege[0].tags = kern.tagsLesen(" Rot , klein,,  ")
b.eintraege[1].favorit = TRUE
b.eintraege[2].kategorien = ["Tiere", "Blumen"]
FUNCTION namenVon$(b AS kern.Bibliothek, p AS ARRAY OF INTEGER) AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM i AS INTEGER
    FOR EACH i IN p
        ARRAY_PUSH(t, b.eintraege[i].name)
    NEXT
    RETURN JOIN$(t, " ")
END FUNCTION
DIM alle AS ARRAY OF INTEGER : alle = kern.bibliothekFiltern(b, "Alle", "")
DIM art AS STRING
FOR EACH art IN kern.bibliothekSortierungen()
    PRINT "sortiert nach "; art; ": "; namenVon$(b, kern.bibliothekSortieren(b, alle, art))
NEXT
PRINT "favoriten: "; namenVon$(b, kern.bibliothekFiltern(b, "Favoriten", ""))
PRINT "tiere: "; namenVon$(b, kern.bibliothekFiltern(b, "Tiere", "")); " | zahl "; kern.kategorieZahl(b, "Tiere"); " | sonstiges "; kern.kategorieZahl(b, "Sonstiges")
PRINT "suche rot: "; namenVon$(b, kern.bibliothekFiltern(b, "Alle", "ROT")); " | suche blumen: "; namenVon$(b, kern.bibliothekFiltern(b, "Alle", "blumen"))
PRINT "suche ueber die naht: "; namenVon$(b, kern.bibliothekFiltern(b, "Alle", "beta rot"))
PRINT "tags: "; JOIN$(b.eintraege[0].tags, "|"); " | leer "; LEN(kern.tagsLesen(" , ,"))
b.eintraege[0].stiche = 1234567
b.eintraege[0].stoff = 0
PRINT "detail: "; kern.eintragDetail$(b.eintraege[0])
b.eintraege[0].stoff = 16
PRINT "detail 16: "; kern.eintragDetail$(b.eintraege[0])
PRINT "index: "; kern.eintragIndex(b, "/m/gamma.pxs"); " "; kern.eintragIndex(b, "/m/GAMMA.pxs")
PRINT "formate: "; kern.bibliothekFormat("a.PXS"); " "; kern.bibliothekFormat("a.pat"); " "; kern.bibliothekFormat("a.png"); " "; kern.bibliothekFormat("pxs")
MKDIR("ordner/unter/tief")
DIM d AS STRING
FOR EACH d IN ["ordner/b.oxs", "ordner/a.pxs", "ordner/unter/c.PXS", "ordner/unter/tief/d.xsd", "ordner/e.txt", "ordner/unter/f.pat"]
    WRITEALL(d, "x")
NEXT
DIM gefunden AS ARRAY OF STRING : gefunden = []
FOR EACH d IN kern.musterDateien("ordner")
    ARRAY_PUSH(gefunden, MID$(REPLACE$(d, CHR$(92), "/"), 7))
NEXT
PRINT "ordner: "; JOIN$(gefunden, " ")
WRITEALL("kaputt.json", "[1, 2")
PRINT "kaputt: "; LEN(kern.bibliothekLaden("kaputt.json").eintraege); " "; LEN(kern.bibliothekLaden("kaputt.json").kategorien)
WRITEALL("liste.json", "[]")
PRINT "keine objekt: "; LEN(kern.bibliothekLaden("liste.json").kategorien)
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_harmonie.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bibliothek.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- erwartet
sortiert nach Name: Alpha beta delta gamma Älter
sortiert nach Datum: Alpha Älter delta beta gamma
sortiert nach Größe: gamma delta beta Alpha Älter
sortiert nach Farben: Alpha gamma beta delta Älter
favoriten: Alpha
tiere: gamma | zahl 1 | sonstiges 4
suche rot: beta | suche blumen: gamma
suche ueber die naht: beta
tags: Rot|klein | leer 0
detail: <b>beta</b> | 10×10 Stiche (1.8×1.8 cm) | 3 Farben | 1.234.567 Stiche
detail 16: <b>beta</b> | 10×10 Stiche (1.6×1.6 cm) | 3 Farben | 1.234.567 Stiche
index: 2 -1
formate: TRUE TRUE FALSE FALSE
ordner: a.pxs unter/c.PXS unter/tief/d.xsd unter/f.pat b.oxs
kaputt: 0 10
keine objekt: 10

=== harmonie: bewertung, startpalette, grau, leere palette, unbekannte art
IMPORT "helfer.dh"
DIM d AS FLOAT
FOR EACH d IN [0.0, 4.999, 5.0, 9.99, 10.0, 19.99, 20.0, 1000.0]
    DIM p AS STRING, t AS STRING, s AS INTEGER
    (p, t, s) = kern.harmonieBewertung(d)
    PRINT d; " -> "; p; " "; t; " "; s
NEXT
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
PRINT "palette anchor: "; pal[kern.harmoniePalette(pal, "Anchor")].name; " | dmc klein: "; pal[kern.harmoniePalette(pal, "dmc")].name; " | leer: "; pal[kern.harmoniePalette(pal, "")].name
DIM ohne AS ARRAY OF kern.Palette : ohne = [pal[0], pal[1]]
PRINT "ohne dmc: "; kern.harmoniePalette(ohne, "Gibt es nicht"); " | keine: "; kern.harmoniePalette([], "DMC")
DIM dmc AS kern.Palette : dmc = kern.paletteNamens(pal, "DMC")
DIM v AS kern.Harmonievorschlag
FOR EACH v IN kern.harmonieVorschlaege(&H808080, "Tetrade", dmc)
    PRINT "grau: "; v.name; " "; HEX$(v.ziel); " "; dmc.garne[v.garn].nummer
NEXT
DIM leer AS kern.Palette : leer = NEW kern.Palette()
leer.garne = []
FOR EACH v IN kern.harmonieVorschlaege(&HC72B3B, "Analog", leer)
    PRINT "leere palette: "; v.name; " "; HEX$(v.ziel); " garn "; v.garn; " "; v.abstand > 1E299
NEXT
' Gleichstand: zwei Garne derselben Farbe -- das erste gewinnt (strenges <)
DIM zwei AS kern.Palette : zwei = NEW kern.Palette()
zwei.garne = [kern.neuesGarn("Erstes", &H808080, "X", "1"), kern.neuesGarn("Zweites", &H808080, "X", "2"), kern.neuesGarn("Rot", &HFF0000, "X", "3")]
FOR EACH v IN kern.harmonieVorschlaege(&H808080, "Komplementär", zwei)
    PRINT "gleichstand: "; zwei.garne[v.garn].nummer; " "; v.abstand
NEXT
PRINT "unbekannt: "; LEN(kern.harmonieVorschlaege(&HC72B3B, "Pentade", dmc)); " | "; kern.harmonieBeschreibung$("Pentade") = ""
PRINT "arten: "; JOIN$(kern.harmonieArten(), " | ")
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_harmonie.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bibliothek.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- erwartet
0.0 -> ●●●● Perfekt 4
4.999 -> ●●●● Perfekt 4
5.0 -> ●●●○ Sehr nah 3
9.99 -> ●●●○ Sehr nah 3
10.0 -> ●●○○ Akzeptabel 2
19.99 -> ●●○○ Akzeptabel 2
20.0 -> ●○○○ Weit weg 1
1000.0 -> ●○○○ Weit weg 1
palette anchor: Anchor | dmc klein: DMC | leer: DMC
ohne dmc: 0 | keine: -1
grau: Tetrade +90° 808080 03
grau: Tetrade +180° 808080 03
grau: Tetrade +270° 808080 03
leere palette: Analog −30° C72A88 garn -1 TRUE
leere palette: Analog +30° C7692A garn -1 TRUE
gleichstand: 1 0.0
unbekannt: 0 | TRUE
arten: Komplementär | Analog | Triade | Split-Komplementär | Tetrade

=== probe: harmonien und bibliothek
IMPORT "helfer.dh"
' --probe-stufe11 mit dem Probemuster, einem eigenen Einstellungsordner
' (APPDATA/HOME) und einem Ordner "sammlung" mit drei Mustern und einer
' kaputten Datei: Harmonien (Tetrade, zwei gewaehlt, alle, hinzufuegen,
' nochmal, rueckgaengig), Bibliothek (aufnehmen, doppelt, Vorschaubilder,
' sortieren, waehlen, Schlagwoerter und Notizen, Suche, Favorit, Kategorie,
' Loeschen, Oeffnen). Danach liest der Fall die library.json.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe11", "--foto", "d", "probe.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["harmonie", "bibliothek", "bibliothek_auswahl"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    DIM b AS kern.Bibliothek : b = kern.bibliothekLaden("app/Glutfaden/Bibliothek/library.json")
    DIM e AS kern.Bibliothekseintrag
    FOR EACH e IN b.eintraege
        PRINT "gesichert: "; e.name; " | "; BASENAME(e.pfad); " | "; JOIN$(e.kategorien, ","); " | tags "; JOIN$(e.tags, ","); " | '"; e.notizen; "' | favorit "; e.favorit; " | geoeffnet "; e.geoeffnet <> ""; " | vorschau "; FILEEXISTS(e.vorschau)
    NEXT
    PRINT "kategorien: "; JOIN$(b.kategorien, " ")
END IF
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_harmonie.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bibliothek.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
