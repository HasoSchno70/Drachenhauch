=== ein unbekanntes sinnbild sagt, welche es gibt
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(w, 20, 20, 300, 34)
TRY
    GUI_TOOLBAR_ADD(tb, "diskette")
CATCH e
    PRINT e
END TRY
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "A", 10, 100, 80, 30)
TRY
    GUI_TOOLBAR_ADD(b, "neu")
CATCH e
    PRINT e
END TRY
TRY
    GUI_TOOLBAR_SET_CHECKED(tb, 7, TRUE)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_FRAMES=1
--- enthaelt
Sinnbild 'diskette' gibt es nicht
bekannt sind: neu, datei, oeffnen, sichern
keine Werkzeugleiste
Eintrag 7 gibt es nicht

=== die eintraege ueberleben das speichern
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(w, 20, 20, 300, 34)
GUI_TOOLBAR_ADD(tb, "sichern", "Sichern", "Sichern")
GUI_TOOLBAR_SEPARATOR(tb)
GUI_TOOLBAR_ADD(tb, "umbruch", "Umbruch")
GUI_TOOLBAR_CHECKABLE(tb, 2, TRUE)
GUI_TOOLBAR_SET_CHECKED(tb, 2, TRUE)
GUI_TOOLBAR_ENABLE(tb, 0, FALSE)
GUI_TOOLBAR_SET(tb, "beschriftung", 1)
DIM text AS STRING : text = GUI_TO_JSON(w)
GUI_WINDOW_DESTROY(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(text)
DIM tb2 AS GUI_WIDGET : tb2 = GUI_WINDOW_WIDGET(w2, 0)
PRINT GUI_KIND(tb2) ; " " ; GUI_TOOLBAR_COUNT(tb2)
PRINT GUI_TOOLBAR_CHECKED(tb2, 2) ; " " ; GUI_TOOLBAR_ENABLED(tb2, 0)
' Mit Beschriftung ist der erste Knopf breiter als hoch.
PRINT GUI_TOOLBAR_ITEM_W(tb2, 0) > 28
--- umgebung
DHRT_FRAMES=1
--- erwartet
toolbar 3
TRUE FALSE
TRUE

=== ohne eintraege bleibt die leiste luft fuer klicks
' Alte Programme legen Knoepfe AUF den Streifen -- die muessen weiter treffen.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(w, 20, 20, 300, 34)
DIM b AS GUI_WIDGET : b = GUI_ICON_BUTTON(w, 24, 23, 28, 28, -1)
GUI_UPDATE()
PRINT GUI_ENABLED(tb) ; " " ; GUI_HIT_TEST(44, 71) = b
--- umgebung
DHRT_FRAMES=2
--- erwartet
FALSE TRUE

=== sinnbilder werden gezeichnet
' Am BILD: in der Mitte des Start-Knopfes steht das gruene Dreieck, im Stopp
' daneben das rote Viereck; ein Knopf mit Sinnbild-NAMEN (GUI_ICON_BUTTON)
' zeichnet genauso. Gegenprobe: der leere Streifen rechts hat keines.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_THEME_PRESET("dark")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(w, 0, 0, 400, 40)
GUI_TOOLBAR_ADD(tb, "start")
GUI_TOOLBAR_ADD(tb, "stopp")
DIM kn AS GUI_WIDGET : kn = GUI_ICON_BUTTON(w, 20, 100, 40, 40, "haltepunkt")
DIM f AS INTEGER
FOR f = 1 TO 3
    GUI_UPDATE()
    CLS(BLACK)
    GUI_DRAW()
    FLIP()
NEXT
--- umgebung
DHRT_FRAMES=3
--- bild
' Start: Knopf 4..38, Mitte 21; Stopp: 40..74, Mitte 57; y-Mitte 20.
19 20 #4CC38A +-40
57 20 #E0605A +-40
40 120 #E0605A +-40
300 20 = 350 20
--- erwartet
