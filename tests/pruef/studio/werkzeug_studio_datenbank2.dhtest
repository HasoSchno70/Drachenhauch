DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '', umsatz INTEGER, aktiv INTEGER NOT NULL DEFAULT 1)")
DB_EXEC(db, "INSERT INTO kunden (name, umsatz, aktiv) VALUES ('Anna', 1250, 1)")
DB_CLOSE(db)
