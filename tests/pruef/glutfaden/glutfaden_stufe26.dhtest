' Glutfaden Stufe 26: andockbare Leisten (ansicht/leisten.dh -- vier
' GTK-Notizbuecher einer Gruppe, Reiter ziehbar, ausserhalb losgelassen ein
' eigenes Fenster) und Plugins (ansicht/plugins.dh -- dieselbe Leitung und
' Bibliothek wie die IDE, ide/dh_plugin.dh, docs/ide-plugins.md).
'
' Das Ziehen selbst laesst sich ohne Maus nicht ausloesen; die Probe ruft
' dieselben Wege (lsNach, leisteAbtrennen) und prueft Ort, Sichtbarkeit und
' Stand. Das Plugin ist echt: ein zweiter Prozess, der ueber die Leitung
' Befehle anmeldet, eine Leiste aus einer .dhform baut, das Muster liest,
' Stiche setzt und am Ende absichtlich abstuerzt.

=== einstellungen: anordnung der leisten und ausgeschaltete plugins
IMPORT "helfer.dh"
MKDIR("app")
DIM e AS kern.Einstellungen : e = kern.einstellungenLaden(CWD$() + "/gibt-es-nicht.json")
PRINT "vorgabe: '"; e.leistenStand; "' | '"; e.pluginsAus; "'"
e = kern.einstellungenLaden(CWD$() + "/mit.json")
PRINT "gelesen: "; e.leistenStand; " | "; e.pluginsAus
DIM j AS JSON_HANDLE : j = JSON_PARSE(kern.einstellungenJson$(e))
PRINT "geschrieben: "; JSON_GET_STRING(j, "panel_layout"); " | "; JSON_GET_STRING(j, "plugins_disabled")
e = kern.einstellungenLaden(CWD$() + "/krumm.json")
PRINT "krumm: '"; e.leistenStand; "' | '"; e.pluginsAus; "'"
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
--- datei mit.json
{"panel_layout": "{\"orte\":{}}", "plugins_disabled": "todo,probe"}
--- datei krumm.json
{"panel_layout": 5, "plugins_disabled": ["a"]}
--- erwartet
vorgabe: '' | ''
gelesen: {"orte":{}} | todo,probe
geschrieben: {"orte":{}} | todo,probe
krumm: '' | ''

=== probe: leisten verschieben, abtrennen, zuruecksetzen und ein plugin
IMPORT "helfer.dh"
' --probe-stufe26 mit alle.pxs und dem Plugin "probe" im Einstellungsordner
' (APPDATA/Glutfaden/plugins/probe): Leisten an andere Plaetze, Stand als
' JSON und zurueck; das Plugin meldet drei Befehle und eine Leiste unten an,
' der Kuerzel trifft (Teile in anderer Reihenfolge), Klick und Eingabe in
' seiner Leiste kommen an, Stiche sind ein Schritt fuer Rueckgaengig, es
' hoert "gesichert", ein Absturz blendet seine Leiste aus, ein Neustart
' bringt sie wieder, ausgeschaltet startet es nicht.
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe26", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; REPLACE$(dlErr, CHR$(13), "");
    PRINT "leisten "; FILEEXISTS("d_leisten.png")
    PRINT "datei unveraendert: "; READLINES("alle.pxs")[0] = READLINES("vorher.pxs")[0]
    PRINT "kopie gesichert: "; FILEEXISTS("kopie.pxs")
END IF
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- datei app/Glutfaden/plugins/probe/plugin.dh
IMPORT "dh_plugin.dh"
PLUGIN_BEFEHL("zaehlen", "Farben zählen", "Strg+Alt+K")
PLUGIN_BEFEHL("sticken", "Ecke sticken")
PLUGIN_BEFEHL("absturz", "Abstürzen")
PLUGIN_LEISTE("leiste", "Probe", "leiste.dhform", "unten")
PLUGIN_HOERE("gesichert")
WHILE PLUGIN_LAEUFT()
    SELECT CASE PLUGIN_EREIGNIS$()
        CASE "befehl"
            SELECT CASE PLUGIN_ID$()
                CASE "zaehlen"
                    DIM m AS JSON_HANDLE : m = JSON_PARSE(PLUGIN_MUSTER$())
                    PLUGIN_SETZE("leiste", "info", "text", "farben " + STR$(JSON_LEN(m, "farben")) + " | " + STR$(JSON_GET_INT(m, "breite")) + "x" + STR$(JSON_GET_INT(m, "hoehe")) + " | " + JSON_GET_STRING(m, "name"))
                CASE "sticken" : PLUGIN_STICHE([0, 0, 1, 0, 2, 0], [1, 1, 1], "Ecke")
                CASE "absturz" : THROW "absichtlich"
            END SELECT
        CASE "klick" : PLUGIN_SETZE("leiste", "info", "text", "geklickt " + PLUGIN_WIDGET$())
        CASE "geaendert" : PLUGIN_SETZE("leiste", "info", "text", "wert " + PLUGIN_WIDGET$() + " " + PLUGIN_WERT$())
        CASE "ereignis" : PLUGIN_MELDUNG("gehoert " + PLUGIN_ID$() + " " + BASENAME(PLUGIN_DATEI$()))
    END SELECT
WEND
--- datei app/Glutfaden/plugins/probe/leiste.dhform
{"title": "Probe", "w": 260, "h": 120, "widgets": [
 {"kind": "label", "name": "info", "text": "bereit", "x": 6, "y": 6, "w": 250, "h": 20},
 {"kind": "button", "name": "knopf", "text": "Drücken", "x": 6, "y": 30, "w": 100, "h": 28},
 {"kind": "textinput", "name": "feld", "text": "", "x": 112, "y": 30, "w": 140, "h": 28},
 {"kind": "listbox", "name": "liste", "x": 6, "y": 62, "w": 250, "h": 52, "items": ["a", "b"]}
]}
