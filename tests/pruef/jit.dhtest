=== teilen durch null in allen formen
FUNCTION t1(a AS INTEGER, b AS INTEGER) AS FLOAT
    RETURN a / b
END FUNCTION
FUNCTION t2(a AS INTEGER, b AS INTEGER) AS INTEGER
    RETURN a \ b
END FUNCTION
FUNCTION t3(a AS INTEGER, b AS INTEGER) AS INTEGER
    RETURN a MOD b
END FUNCTION
FUNCTION t4(a AS FLOAT, b AS FLOAT) AS FLOAT
    RETURN a MOD b
END FUNCTION
FUNCTION t5(a AS FLOAT, b AS FLOAT) AS FLOAT
    RETURN a / b
END FUNCTION
PRINT t1(7, 2); " "; t2(7, 2); " "; t3(7, 2); " "; t4(7.5, 2.0); " "; t5(1.0, 4.0)
TRY
    PRINT t1(1, 0)
CATCH e
    PRINT e
END TRY
TRY
    PRINT t2(1, 0)
CATCH e
    PRINT e
END TRY
TRY
    PRINT t3(1, 0)
CATCH e
    PRINT e
END TRY
TRY
    PRINT t4(1.0, 0.0)
CATCH e
    PRINT e
END TRY
TRY
    PRINT t5(1.0, -0.0)
CATCH e
    PRINT e
END TRY
--- erwartet
3.5 3 1 1.5 0.25
Division durch 0
Integer-Division durch 0
MOD durch 0
MOD durch 0
Division durch 0

