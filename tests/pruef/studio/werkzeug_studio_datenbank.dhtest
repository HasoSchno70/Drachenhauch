=== das erzeugte programm legt fehlende tabellen und spalten selbst an
' Die Datei neben dem Programm kennt die Tabelle kunden nur ohne ort; das
' Programm ergaenzt die Spalte und den Index, legt artikel an und arbeitet
' danach ueber die globale Verbindung Daten. Kein DH_STUDIO_DATEN: die Datei
' liegt neben dem Programm.
IMPORT "kern.dh"
projOrdner = CWD$() + "/proj"
DIM e AS Element : e = elementNeu("datenbank", "Daten")
e.schema = READLINES("Daten.dhdb")[0]
MKDIR("prog")
WRITEALL("prog/studio_datenbanken.dh", datenbankCode$())
DIM db AS DB_CONN : db = DB_OPEN("prog/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '')")
DB_EXEC(db, "INSERT INTO kunden (name) VALUES ('Anna')")
DB_CLOSE(db)
DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", CWD$() + "/prog/main.dh")
DIM aus AS STRING : aus = ""
DIM leer AS INTEGER : leer = 0
WHILE leer < 5
    DIM t AS STRING : t = PROCESS_READ$(p) + PROCESS_ERR$(p)
    IF t <> "" THEN
        aus = aus + t
        leer = 0
    ELSEIF NOT PROCESS_RUNNING(p) THEN
        leer = leer + 1
    END IF
    SLEEP(30)
WEND
PRINT TRIM$(REPLACE$(aus, CHR$(13), ""))
db = DB_OPEN("prog/daten.sqlite")
DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT name FROM sqlite_master WHERE type IN ('table', 'index') ORDER BY name")
WHILE DB_NEXT(r)
    PRINT "  "; DB_GET_STRING(r, 0)
WEND
DB_CLOSE(db)
DIM c AS INTEGER : c = PROCESS_START("dhrt", "--check", CWD$() + "/prog/main.dh")
DIM cz AS STRING : cz = ""
leer = 0
WHILE leer < 5
    DIM t2 AS STRING : t2 = PROCESS_READ$(c)
    IF t2 <> "" THEN
        cz = cz + t2
        leer = 0
    ELSEIF NOT PROCESS_RUNNING(c) THEN
        leer = leer + 1
    END IF
    SLEEP(30)
WEND
PRINT "check "; TRIM$(cz)
--- datei Daten.dhdb
{"datei":"daten.sqlite","tabellen":[{"name":"kunden","spalten":[{"name":"name","typ":"text","pflicht":true,"eindeutig":false,"vorgabe":""},{"name":"ort","typ":"text","pflicht":false,"eindeutig":true,"vorgabe":""}]},{"name":"artikel","spalten":[{"name":"preis","typ":"geld","pflicht":true,"eindeutig":false,"vorgabe":"0"}]}]}
--- datei prog/main.dh
IMPORT "studio_datenbanken.dh"
DB_EXEC(Daten, "UPDATE kunden SET ort = ? WHERE id = 1", "Bremen")
DB_EXEC(Daten, "INSERT INTO artikel (preis) VALUES (?)", 1999)
DIM r AS DB_RESULT : r = DB_QUERY(Daten, "SELECT k.name, k.ort, a.preis FROM kunden k, artikel a")
WHILE DB_NEXT(r)
    PRINT DB_GET_STRING(r, 0); " "; DB_GET_STRING(r, 1); " "; DB_GET_INT(r, 2)
WEND
--- datei kern.dh
IMPORT "json"
IMPORT "regex"
IMPORT "imgfx"
IMPORT "db"
IMPORT "{sammlung}/../../../studio/sprache.dh"
IMPORT "{sammlung}/../../../studio/bibliothek.dh"
IMPORT "{sammlung}/../../../studio/modell.dh"
IMPORT "{sammlung}/../../../studio/projekt.dh"
IMPORT "{sammlung}/../../../studio/datenbank.dh"
--- erwartet
Anna Bremen 1999
  artikel
  kunden
  studio_u_kunden_ort
check []

=== umbenennen im studio zieht das gebaute programm nach
' Eine aeltere Datei neben dem Programm kennt noch kunden.name/ort samt Index.
' Im Studio werden ort -> stadt, kunden -> kundschaft und name -> vorname
' umbenannt (artikel -> Artikel ist nur Gross/klein: SQLite sieht denselben
' Namen, gemerkt wird es nicht, die Datei behaelt artikel).
' Das Programm benennt der Reihe nach um, die Zeile behaelt ihre Werte, die
' Indexe heissen danach nach Tabelle und Spalte (auch der von nr, die selbst
' nicht umbenannt wurde); ein zweiter Lauf aendert nichts.
IMPORT "kern.dh"
projOrdner = CWD$() + "/proj"
DIM e AS Element : e = elementNeu("datenbank", "Daten")
e.schema = READLINES("Daten.dhdb")[0]
PRINT "[" + dbSpalteUmbenennen$(e, "kunden", "ort", "stadt") + dbTabelleUmbenennen$(e, "kunden", "kundschaft") + dbSpalteUmbenennen$(e, "kundschaft", "name", "vorname") + dbTabelleUmbenennen$(e, "artikel", "Artikel") + "]"
DIM s AS JSON_HANDLE : s = dbSchema(e)
DIM u AS INTEGER
FOR u = 0 TO JSON_LEN(s, "umbenannt") - 1
    DIM up AS STRING : up = "umbenannt." + STR$(u)
    PRINT "  "; JSON_GET_STRING(s, up + ".art"); " "; JSON_GET_STRING(s, up + ".tabelle"); " "; JSON_GET_STRING(s, up + ".alt"); " -> "; JSON_GET_STRING(s, up + ".neu")
NEXT
MKDIR("prog")
WRITEALL("prog/studio_datenbanken.dh", datenbankCode$())
DIM db AS DB_CONN : db = DB_OPEN("prog/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '', ort TEXT, nr TEXT)")
DB_EXEC(db, "CREATE UNIQUE INDEX studio_u_kunden_nr ON kunden (nr)")
DB_EXEC(db, "CREATE UNIQUE INDEX studio_u_kunden_ort ON kunden (ort)")
DB_EXEC(db, "CREATE TABLE artikel (id INTEGER PRIMARY KEY, preis INTEGER NOT NULL DEFAULT 0)")
DB_EXEC(db, "INSERT INTO kunden (name, ort, nr) VALUES ('Anna', 'Bremen', 'K1')")
DB_CLOSE(db)
DIM lauf AS INTEGER
FOR lauf = 1 TO 2
    DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", CWD$() + "/prog/main.dh")
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF t <> "" THEN
            aus = aus + t
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(30)
    WEND
    PRINT "lauf "; lauf; ": "; TRIM$(REPLACE$(aus, CHR$(13), ""))
NEXT
db = DB_OPEN("prog/daten.sqlite")
DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT name FROM sqlite_master WHERE type IN ('table', 'index') ORDER BY name")
WHILE DB_NEXT(r)
    PRINT "  "; DB_GET_STRING(r, 0)
WEND
r = DB_QUERY(db, "PRAGMA table_info(kundschaft)")
DIM sp AS ARRAY OF STRING : sp = []
WHILE DB_NEXT(r)
    ARRAY_PUSH(sp, DB_GET_STRING(r, 1))
WEND
PRINT "spalten "; JOIN$(sp, ",")
DB_CLOSE(db)
--- datei Daten.dhdb
{"datei":"daten.sqlite","tabellen":[{"name":"kunden","spalten":[{"name":"name","typ":"text","pflicht":true,"eindeutig":false,"vorgabe":""},{"name":"ort","typ":"text","pflicht":false,"eindeutig":true,"vorgabe":""},{"name":"nr","typ":"text","pflicht":false,"eindeutig":true,"vorgabe":""}]},{"name":"artikel","spalten":[{"name":"preis","typ":"geld","pflicht":true,"eindeutig":false,"vorgabe":"0"}]}]}
--- datei prog/main.dh
IMPORT "studio_datenbanken.dh"
DIM r AS DB_RESULT : r = DB_QUERY(Daten, "SELECT vorname, stadt FROM kundschaft")
WHILE DB_NEXT(r)
    PRINT DB_GET_STRING(r, 0); " "; DB_GET_STRING(r, 1)
WEND
--- datei kern.dh
IMPORT "json"
IMPORT "regex"
IMPORT "imgfx"
IMPORT "db"
IMPORT "{sammlung}/../../../studio/sprache.dh"
IMPORT "{sammlung}/../../../studio/bibliothek.dh"
IMPORT "{sammlung}/../../../studio/modell.dh"
IMPORT "{sammlung}/../../../studio/projekt.dh"
IMPORT "{sammlung}/../../../studio/datenbank.dh"
--- erwartet
[]
  spalte kunden ort -> stadt
  tabelle kunden kunden -> kundschaft
  spalte kundschaft name -> vorname
lauf 1: Anna Bremen
lauf 2: Anna Bremen
  artikel
  kundschaft
  studio_u_kundschaft_nr
  studio_u_kundschaft_stadt
spalten id,vorname,stadt,nr

=== das projekt schreibt den aufbau als dhdb und liest ihn wieder
' Eine Datenbank hat keine .dh. Beim Umbenennen geht die alte .dhdb weg; die
' Datei mit den Daten bleibt, wie sie heisst.
IMPORT "kern.dh"
DIM ordner AS STRING : ordner = CWD$() + "/neu"
projektNeu(ordner)
DIM e AS Element : e = elementNeu("datenbank", "Daten")
PRINT "anlegen ["; dbTabelleNeu$(e, "kunden"); dbSpalteNeu$(e, "kunden", "name", "text"); "]"
projektSchreiben()
PRINT "dateien "; FILEEXISTS(ordner + "/Daten.dhdb"); " "; FILEEXISTS(ordner + "/Daten.dh")
DIM j AS JSON_HANDLE : j = JSON_LOAD(ordner + "/projekt.dhstudio")
PRINT "eintrag "; JSON_GET_STRING(j, "elemente.2.art"); " "; JSON_GET_STRING(j, "elemente.2.schema"); " "; JSON_HAS(j, "elemente.2.code")
e.name = "Lager"
projektSchreiben()
PRINT "umbenannt "; FILEEXISTS(ordner + "/Lager.dhdb"); " "; FILEEXISTS(ordner + "/Daten.dhdb")
PRINT projektLaden$(ordner); "geladen "; LEN(elemente); " "; elemente[2].art; " "; elemente[2].name
PRINT "tabellen "; JOIN$(dbTabellenNamen(elemente[2]), ","); " datei "; dbDateiVon$(dbSchema(elemente[2]))
PRINT "abgleich ["; datenbankenAbgleichen$(); "] "; FILEEXISTS(ordner + "/daten.sqlite")
--- datei kern.dh
IMPORT "json"
IMPORT "regex"
IMPORT "imgfx"
IMPORT "db"
IMPORT "{sammlung}/../../../studio/sprache.dh"
IMPORT "{sammlung}/../../../studio/bibliothek.dh"
IMPORT "{sammlung}/../../../studio/modell.dh"
IMPORT "{sammlung}/../../../studio/projekt.dh"
IMPORT "{sammlung}/../../../studio/datenbank.dh"
--- erwartet
anlegen []
dateien TRUE FALSE
eintrag datenbank Daten.dhdb FALSE
umbenannt TRUE FALSE
geladen 3 datenbank Lager
tabellen kunden datei daten.sqlite
abgleich [] TRUE

=== eine zelle tippen und eine zeile anlegen landet in der datei
' Erster Lauf misst (DH_STUDIO_OEFFNEN oeffnet die Tabelle wie ein Klick im
' Navigator), der zweite klickt auf [Daten], in die Zelle ort der ersten
' Zeile, fuegt "Bremen" ein (Strg+V schreibt im Gitter direkt in die Zelle)
' und legt eine Zeile an -- sie bekommt die Vorgaben.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
SETENV("DH_STUDIO_OEFFNEN", "Daten.kunden")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, "", 12, p)
DIM x AS INTEGER
DIM y AS INTEGER
slHin(10, 10)
slWarten(10)
(x, y) = slLage(log, "db daten")
slKlick(x, y)
slWarten(6)
(x, y) = slLage(log, "dbzelle da 0 2")
slKlick(x, y)
slWarten(4)
slMit([341], 86)
slWarten(10)
(x, y) = slLage(log, "db zeneu")
slKlick(x, y)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_ABLAGE", "Bremen")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "db ")
    PRINT z
NEXT
DIM db AS DB_CONN : db = DB_OPEN(p + "/daten.sqlite")
DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT id, name, ort, aktiv FROM kunden ORDER BY id")
WHILE DB_NEXT(r)
    PRINT DB_GET_INT(r, 0); " ["; DB_GET_STRING(r, 1); "] "; DB_GET_STRING(r, 2); " "; DB_GET_INT(r, 3)
WEND
DB_CLOSE(db)
--- argumente
{sammlung}/../../../studio/studio.dh
--- vorher
IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '', ort TEXT DEFAULT 'Berlin', aktiv INTEGER NOT NULL DEFAULT 1)")
DB_EXEC(db, "INSERT INTO kunden (name, ort) VALUES ('Anna', NULL)")
DB_CLOSE(db)
--- datei laeufer.dh
IMPORT "db"
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
