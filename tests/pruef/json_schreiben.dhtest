' Aus test_json_schreiben.py uebertragen (28 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== leeres objekt und array
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
PRINT JSON_STRINGIFY(h)
h = JSON_NEW_ARRAY()
PRINT JSON_STRINGIFY(h)
--- erwartet
{}
[]

=== alle werttypen
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_STRING(h, "s", "text")
JSON_SET_INT(h, "i", 42)
JSON_SET_FLOAT(h, "f", 1.5)
JSON_SET_BOOL(h, "b", TRUE)
JSON_SET_NULL(h, "n")
PRINT JSON_STRINGIFY(h)
--- erwartet
{"s":"text","i":42,"f":1.5,"b":true,"n":null}

=== reihenfolge bleibt die einfuege reihenfolge
' `preserve_order` in Cargo.toml -- und das gilt auch nach REMOVE.
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "a", 1)
JSON_SET_INT(h, "b", 2)
JSON_SET_INT(h, "c", 3)
PRINT JSON_REMOVE(h, "b")
PRINT JSON_STRINGIFY(h)
--- erwartet
TRUE
{"a":1,"c":3}

=== setzen ersetzt
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "a", 1)
JSON_SET_INT(h, "a", 2)
PRINT JSON_STRINGIFY(h)
--- erwartet
{"a":2}

=== sonderzeichen werden richtig maskiert (1)
' Der Grund, warum es diese Builtins gibt: von Hand geklebtes JSON
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_STRING(h, "wert", "Anna "" mit ""Zitat"" und \ und ")
PRINT JSON_STRINGIFY(h)
--- erwartet
{"wert":"Anna \" mit \"Zitat\" und \\ und "}

=== sonderzeichen werden richtig maskiert (2)
' Der Grund, warum es diese Builtins gibt: von Hand geklebtes JSON
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_STRING(h, "wert", "Anna "" mit ""Zitat"" und \ und ")
DIM zwei AS JSON_HANDLE
zwei = JSON_PARSE(JSON_STRINGIFY(h))
PRINT JSON_GET_STRING(zwei, "wert")
--- erwartet
Anna " mit "Zitat" und \ und 

=== zeilenumbruch ueberlebt den umweg
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_STRING(h, "t", "a" + CHR$(10) + "b")
DIM zwei AS JSON_HANDLE
zwei = JSON_PARSE(JSON_STRINGIFY(h))
PRINT JSON_LEN(zwei, "t")
--- erwartet
3

=== zwischenstufen entstehen von selbst
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_STRING(h, "kunde.adresse.ort", "Koeln")
PRINT JSON_STRINGIFY(h)
PRINT JSON_GET_STRING(h, "kunde.adresse.ort")
--- erwartet
{"kunde":{"adresse":{"ort":"Koeln"}}}
Koeln

=== json einhaengen ist eine kopie
' Ein JSON-Baum kann sich keinen Teilbaum mit einem anderen teilen --
IMPORT "json"
DIM h AS JSON_HANDLE
DIM teil AS JSON_HANDLE
h = JSON_NEW_OBJECT()
teil = JSON_NEW_OBJECT()
JSON_SET_INT(teil, "x", 1)
JSON_SET_JSON(h, "unten", teil)
JSON_SET_INT(teil, "x", 999)
PRINT JSON_GET_INT(h, "unten.x")
--- erwartet
1

=== sich selbst einhaengen geht
' Quelle und Ziel duerfen dasselbe Handle sein (RefCell-Falle).
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "a", 1)
JSON_SET_JSON(h, "kopie", h)
PRINT JSON_STRINGIFY(h)
--- erwartet
{"a":1,"kopie":{"a":1}}

=== anhaengen an die wurzel
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_ARRAY()
JSON_APPEND_INT(h, "", 1)
JSON_APPEND_STRING(h, "", "zwei")
JSON_APPEND_BOOL(h, "", FALSE)
JSON_APPEND_FLOAT(h, "", 0.5)
PRINT JSON_STRINGIFY(h)
--- erwartet
[1,"zwei",false,0.5]

=== anhaengen an ein feld
IMPORT "json"
DIM h AS JSON_HANDLE
DIM liste AS JSON_HANDLE
h = JSON_NEW_OBJECT()
liste = JSON_NEW_ARRAY()
JSON_SET_JSON(h, "posten", liste)
JSON_APPEND_INT(h, "posten", 7)
JSON_APPEND_INT(h, "posten", 8)
PRINT JSON_LEN(h, "posten")
PRINT JSON_STRINGIFY(h)
--- erwartet
2
{"posten":[7,8]}

=== objekte an ein array haengen
' Das Muster fuer eine Liste von Datensaetzen.
IMPORT "json"
DIM h AS JSON_HANDLE
DIM zeile AS JSON_HANDLE
DIM i AS INTEGER
h = JSON_NEW_ARRAY()
FOR i = 1 TO 2
    zeile = JSON_NEW_OBJECT()
    JSON_SET_INT(zeile, "nr", i)
    JSON_APPEND_JSON(h, "", zeile)
NEXT
PRINT JSON_STRINGIFY(h)
--- erwartet
[{"nr":1},{"nr":2}]

=== array element ersetzen
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_ARRAY()
JSON_APPEND_INT(h, "", 1)
JSON_APPEND_INT(h, "", 2)
JSON_SET_INT(h, "1", 99)
PRINT JSON_STRINGIFY(h)
--- erwartet
[1,99]

=== array element entfernen rueckt auf
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_ARRAY()
JSON_APPEND_INT(h, "", 1)
JSON_APPEND_INT(h, "", 2)
JSON_APPEND_INT(h, "", 3)
PRINT JSON_REMOVE(h, "1")
PRINT JSON_STRINGIFY(h)
--- erwartet
TRUE
[1,3]

=== keys liefert die schluessel
IMPORT "json"
DIM h AS JSON_HANDLE
DIM k AS ARRAY OF STRING
h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "eins", 1)
JSON_SET_INT(h, "zwei", 2)
k = JSON_KEYS(h, "")
PRINT JOIN$(k, ",")
--- erwartet
eins,zwei

=== keys auf einem pfad
IMPORT "json"
DIM h AS JSON_HANDLE
DIM k AS ARRAY OF STRING
h = JSON_PARSE("{""a"": {""x"": 1, ""y"": 2}}")
k = JSON_KEYS(h, "a")
PRINT JOIN$(k, ",")
--- erwartet
x,y

=== keys auf einem array ist ein fehler
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_ARRAY()
DIM k AS ARRAY OF STRING
k = JSON_KEYS(h, "")
--- fehler
JSON_KEYS: '' ist ein Array, kein Objekt

=== handles sind referenzen
' Wie MAP und ARRAY: `b = a` legt keine Kopie an.
IMPORT "json"
DIM a AS JSON_HANDLE
DIM b AS JSON_HANDLE
a = JSON_NEW_OBJECT()
b = a
JSON_SET_INT(b, "x", 5)
PRINT JSON_STRINGIFY(a)
--- erwartet
{"x":5}

=== geparstes dokument ist veraenderbar
' Lesen und Schreiben auf demselben Handle -- der uebliche Fall:
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_PARSE("{""a"": 1}")
JSON_SET_INT(h, "b", 2)
PRINT JSON_STRINGIFY(h)
--- erwartet
{"a":1,"b":2}

=== leerer pfad beim setzen ist ein fehler
' Beim LESEN meint der leere Pfad die Wurzel. Beim Schreiben hiesse er
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "", 1)
--- fehler
JSON_SET_INT: leerer Pfad -- das Dokument selbst laesst sich nicht ersetzen

=== zahl segment ohne array erklaert sich
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_STRING(h, "posten.0", "x")
--- fehler
JSON_SET_STRING: 'posten.0' gibt es noch nicht, und '0' ist eine Zahl -- meintest du ein Array? Dann zuerst anlegen (JSON_SET_JSON(h, "posten", JSON_NEW_ARRAY())), danach mit JSON_APPEND_* fuellen. Ein Objekt-Schluessel darf keine reine Zahl sein.

=== zahl als schluessel im bestehenden objekt ist erlaubt
' Nur eine FRISCH angelegte Zwischenstufe ist zweideutig.
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_STRING(h, "t.name", "a")
JSON_SET_STRING(h, "t.0", "erlaubt")
PRINT JSON_STRINGIFY(h)
--- erwartet
{"t":{"name":"a","0":"erlaubt"}}

=== in einen skalar schreiben ist ein fehler
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_STRING(h, "a", "text")
JSON_SET_INT(h, "a.b", 1)
--- fehler
JSON_SET_INT: 'a.b' ist ein Text -- da laesst sich kein Feld setzen

=== index ausserhalb verweist auf append
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_ARRAY()
JSON_SET_INT(h, "0", 1)
--- fehler
JSON_SET_INT: Index 0 liegt ausserhalb (Laenge 0) -- zum Anhaengen JSON_APPEND_* nehmen

=== anhaengen an ein nicht array ist ein fehler
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "a", 1)
JSON_APPEND_INT(h, "a", 2)
--- fehler
JSON_APPEND_INT: 'a' ist eine Zahl, kein Array

=== remove meldet ob etwas da war
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "a", 1)
PRINT JSON_REMOVE(h, "a")
PRINT JSON_REMOVE(h, "a")
--- erwartet
TRUE
FALSE

=== null laesst sich anhaengen
' Eine Liste mit LEEREN Plaetzen -- so notiert der Tracker eine Zeile
IMPORT "json"
DIM h AS JSON_HANDLE
h = JSON_NEW_ARRAY()
JSON_APPEND_INT(h, "", 60)
JSON_APPEND_NULL(h, "")
JSON_APPEND_INT(h, "", 62)
PRINT JSON_STRINGIFY(h)
PRINT JSON_TYPE(h, "1")
--- erwartet
[60,null,62]
null

