=== formate ueber die befehle
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 280, 200)
GUI_TEXTAREA_SET(ta, "formatiert", 1)
GUI_SET_TEXT(ta, "hallo schoene welt")
GUI_TEXTAREA_SELECT(ta, 1, 1, 1, 6)
GUI_TEXTAREA_STYLE(ta, "fett")
PRINT GUI_TEXTAREA_MARKDOWN$(ta)
PRINT GUI_TEXTAREA_GET_STYLE$(ta)
GUI_TEXTAREA_SELECT(ta, 1, 3, 1, 15)
GUI_TEXTAREA_STYLE(ta, "kursiv+unterstrichen")
PRINT GUI_TEXTAREA_MARKDOWN$(ta)
PRINT GUI_TEXTAREA_GET_STYLE$(ta)
GUI_TEXTAREA_STYLE(ta, "fett", FALSE)
GUI_TEXTAREA_STYLE(ta, "unterstrichen", FALSE)
PRINT GUI_TEXTAREA_MARKDOWN$(ta)
GUI_TEXTAREA_SELECT(ta, 1, 1, 1, 19)
GUI_TEXTAREA_STYLE(ta, "durchgestrichen")
PRINT GUI_TEXTAREA_MARKDOWN$(ta)
PRINT GUI_TEXT(ta)
--- erwartet
**hallo** schoene welt
fett
**ha<u>*llo** schoene *</u>welt
kursiv+unterstrichen
**ha***llo schoene *welt
~~**ha***llo schoene *welt~~
hallo schoene welt

=== markdown hinein und heraus
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 280, 200)
' SET_MARKDOWN schaltet die Formate selbst ein.
GUI_TEXTAREA_SET_MARKDOWN(ta, "Ein **fetter** Satz," + CHR$(10) + "*schief* und <u>unter</u>, ~~weg~~ \*Stern\*")
PRINT GUI_TEXT(ta)
PRINT GUI_TEXTAREA_MARKDOWN$(ta)
GUI_TEXTAREA_SELECT(ta, 1, 6, 1, 7)
PRINT GUI_TEXTAREA_GET_STYLE$(ta)
GUI_TEXTAREA_SELECT(ta, 1, 1, 1, 2)
PRINT GUI_TEXTAREA_GET_STYLE$(ta)
' GUI_SET_TEXT setzt ungeformt.
GUI_SET_TEXT(ta, "neu")
PRINT GUI_TEXTAREA_MARKDOWN$(ta)
--- erwartet
Ein fetter Satz,
schief und unter, weg *Stern*
Ein **fetter** Satz,
*schief* und <u>unter</u>, ~~weg~~ \*Stern\*
fett
normal
neu

