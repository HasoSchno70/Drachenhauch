=== tabulator rueckt im codefeld ein
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 260, 120)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "ok", 10, 140, 80, 24)
GUI_FOCUS(ta)

GUI_TEXTAREA_SET(ta, "tab_fuegt_ein", 1)
GUI_TEXTAREA_SET(ta, "tabbreite", 4)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

PRINT "["; GUI_TEXT(ta); "]"
--- datei ev.txt
# Test-Aufnahme
c 2
e 2 2 258 0 0 0 // Event: test
e 3 1 258 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
[    ]

=== tabulator wechselt ohne den schalter weiter
' Gegenprobe: ohne `tab_fuegt_ein` bleibt der Tabulator die
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 260, 120)
DIM b AS GUI_WIDGET
b = GUI_BUTTON(w, "ok", 10, 140, 80, 24)
GUI_FOCUS(ta)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

PRINT "["; GUI_TEXT(ta); "]"; IIF(GUI_FOCUSED() = b, " knopf", " woanders")
