e 4 1 257 0 0 0 // Event: test
e 5 2 264 0 0 0 // Event: test
e 6 1 264 0 0 0 // Event: test
e 7 2 257 0 0 0 // Event: test
e 8 1 257 0 0 0 // Event: test

--- umgebung
DHRT_FRAMES=16
--- erwartet
gruen

=== baum pfeiltasten klappen und waehlen
' Rechts klappt auf, Ab geht ins Kind -- wie in jedem Dateibaum.
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM t AS GUI_WIDGET
t = GUI_TREE(w, 10, 10, 200, 120)
DIM wurzel AS INTEGER
wurzel = GUI_TREE_ADD(t, -1, "Ordner")
DIM kind AS INTEGER
kind = GUI_TREE_ADD(t, wurzel, "Datei")

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

PRINT GUI_TREE_LABEL(t, GUI_TREE_SELECTED(t))
--- datei ev.txt
# Test-Aufnahme
c 8
e 1 2 258 0 0 0 // Event: test
e 2 1 258 0 0 0 // Event: test
e 3 2 264 0 0 0 // Event: test
e 4 1 264 0 0 0 // Event: test
e 5 2 262 0 0 0 // Event: test
e 6 1 262 0 0 0 // Event: test
e 7 2 264 0 0 0 // Event: test
e 8 1 264 0 0 0 // Event: test

--- umgebung
