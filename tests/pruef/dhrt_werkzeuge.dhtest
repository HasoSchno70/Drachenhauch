leer: rueckgabe 0
leer: meldet sich TRUE
weg: rueckgabe 2
weg: meldet sich TRUE

=== ein vergessenes input haengt nicht
' Die Standardeingabe des Kindes ist leer -- ein Pruefprogramm mit einem
' vergessenen INPUT wuerde sonst auf eine Eingabe warten, die nie kommt.
IMPORT "helfer.dh"
WRITEALL("ordner/x_pruefung.dh", !"DIM s AS STRING\nINPUT \"Name: \", s\nASSERT(s = \"\", \"leer bei EOF\")\n")
DIM t0 AS INTEGER : t0 = MILLIS()
dlStarten(["test", CWD$() + "/ordner"])
PRINT "rueckgabe "; dlCode
PRINT "unter 30 s "; (MILLIS() - t0 < 30000)
--- verzeichnis ordner
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0
unter 30 s TRUE

