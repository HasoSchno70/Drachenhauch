=== argumente werden wie in der vm gewandelt
FUNCTION f(x AS FLOAT, n AS INTEGER, b AS BOOLEAN) AS FLOAT
    IF b THEN RETURN x * n
    RETURN x + n
END FUNCTION
FUNCTION rufer(k AS INTEGER) AS FLOAT
    RETURN f(k, 3, k > 2) + f(0.5, k, FALSE)
END FUNCTION
SUB nichts(a AS INTEGER)
    DIM b AS INTEGER
    b = a + 1
END SUB
FUNCTION mit_sub(a AS INTEGER) AS INTEGER
    nichts(a)
    RETURN a
END FUNCTION
PRINT f(2, 3, TRUE); " "; f(2.5, 4.0, FALSE); " "; rufer(1); " "; rufer(5); " "; mit_sub(9)
TRY
    PRINT f(1.0, 2.5, TRUE)
CATCH e
    PRINT LEFT$(e, 40)
END TRY
--- erwartet
6.0 6.5 5.5 20.5 9
Parameter: FLOAT 2.5 passt nicht verlust

