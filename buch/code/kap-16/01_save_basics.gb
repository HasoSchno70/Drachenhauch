' Save-Modul-Grundlagen: Highscore speichern und wieder laden.
'
' Erst-Lauf: Datei existiert nicht, SAVE_LOAD_OR_NEW liefert leeren Save.
' Wir holen den Highscore mit Default 0, addieren 1000, speichern,
' laden neu - der Wert ist persistent.

IMPORT "save"

CONST SAVE_PATH AS STRING = "kap16_demo.save"

DIM s AS SAVE_HANDLE
s = SAVE_LOAD_OR_NEW(SAVE_PATH)

DIM hi AS INTEGER
hi = SAVE_GET_INT_OR(s, "highscore", 0)
PRINT f"Aktueller Highscore: {hi}"

' Neuen Wert setzen und speichern
SAVE_SET_INT(s, "highscore", hi + 1000)
SAVE_WRITE(s, SAVE_PATH)
PRINT f"Neuer Wert: {hi + 1000} - gespeichert."

' Frischer Load - sollten den neuen Wert sehen
DIM s2 AS SAVE_HANDLE
s2 = SAVE_LOAD(SAVE_PATH)
DIM hi2 AS INTEGER
hi2 = SAVE_GET_INT(s2, "highscore")
PRINT f"Geladen: {hi2}"

' Aufraeumen, damit das Demo wiederholbar ist
SAVE_DELETE_FILE(SAVE_PATH)
PRINT "Datei geloescht."
