' ============================================================
'  DRACHENHAUCH -- Form-Designer (Weg B, der erste der vier fehlenden Editoren)
' ============================================================
'  Oberflaechen fuer das gui-Modul zusammenklicken, wie im Qt-Form-Designer
'  (docs/form-designer.md), aber IN Drachenhauch: die Entwurfsflaeche ist
'  ein echtes GUI_WINDOW im Entwurfsmodus (GUI_WINDOW_DESIGN) -- die Laufzeit
'  zeichnet die Controls genau so, wie das Programm sie spaeter bekommt,
'  nimmt ihnen aber die Eingabe; die Maus verwaltet der Designer selbst.
'
'  Das Modell ist das .dhform-JSON (json-Modul), das Fenster nur die
'  Ansicht: jede Aenderung schreibt ins JSON und baut die Ansicht neu.
'  Damit sind Sichern (JSON_PRETTY), Laden (JSON_LOAD) und Rueckgaengig
'  (JSON-Text je Stand) dasselbe Format, das GUI_SAVE/GUI_LOAD und der
'  Qt-Designer lesen; Designer-Felder (`name`, `code`) laufen mit durch.
'
'  Links die Palette (alle 30 Arten der Laufzeit, dazu das Gitter), in der
'  Mitte die Form, rechts der Inspektor -- mit Feldern je Art (Eintraege,
'  Spalten und Gitter der Tabelle, Min/Max/Wert). Palette anklicken, dann
'  auf die Form klicken = ablegen; ziehen = verschieben; an den acht Griffen
'  = Groesse; Entf = loeschen; Strg+Z/Y = Rueckgaengig/Wiederholen; Strg+D =
'  verdoppeln; Pfeile = um ein Raster schieben; Umschalt/Strg+Klick oder ein
'  Rahmen ueber leere Flaeche waehlt mehrere (Strg+A alle), das Menue
'  "Anordnen" richtet sie am zuletzt angeklickten aus; "Reiterseite" legt
'  ein Control auf eine Seite eines Reiterwerks; F5 = Formular laufen lassen
'  (erzeugt <name>_lauf.dh mit Handler-Ruempfen neben der .dhform);
'  Strg+G = DH-Code: <name>_code.dh baut das Formular Aufruf fuer Aufruf,
'  ohne GUI_LOAD und ohne .dhform zur Laufzeit.
'
'  Aufruf:  dhrt run examples/197_form_designer.dh [-- formular.dhform]
'  Test:    DH_FORM_LOG=<datei> protokolliert die Ereignisse zeilenweise.
' ============================================================
IMPORT "gui"
IMPORT "json"

CONST RASTER = 8
CONST LINKS = 0                 ' Maustaste
CONST PAL_B = 230               ' Breite der Palette
CONST INSP_B = 330              ' Breite des Inspektors
CONST NL = CHR$(10)

SCREEN(1280, 800, "Drachenhauch - Form-Designer", 1)
WINDOW_RESIZABLE(TRUE)
WINDOW_MIN_SIZE(960, 600)
SETFPS(60)
WINDOW_MAXIMIZE()
GUI_THEME_PRESET("glas_dunkel")

DIM uiFont AS INTEGER : uiFont = -1
DIM fp AS STRING
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "/System/Library/Fonts/Supplemental/Arial.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    IF uiFont < 0 AND FILEEXISTS(fp) THEN uiFont = LOADFONT(fp, 32)
NEXT
IF uiFont >= 0 THEN SETFONT(uiFont) : TEXT_SIZE(16)

DIM logDatei AS STRING : logDatei = GETENV$("DH_FORM_LOG")
SUB protokoll(text AS STRING)
    IF logDatei = "" THEN RETURN
    DIM f AS FILE
    f = OPENFILE(logDatei, "a")
    WRITELINE(f, text)
    CLOSEFILE(f)
END SUB

' --- Palette: Art, Anzeigename, Vorgabegroesse, Ereignisse -------------------
DIM palArt AS ARRAY OF STRING : palArt = []
DIM palName AS ARRAY OF STRING : palName = []
DIM palB AS ARRAY OF INTEGER : palB = []
DIM palH AS ARRAY OF INTEGER : palH = []
DIM palText AS ARRAY OF BOOLEAN : palText = []

SUB palette(art AS STRING, name AS STRING, b AS INTEGER, h AS INTEGER, hatText AS BOOLEAN)
    ARRAY_PUSH(palArt, art) : ARRAY_PUSH(palName, name)
    ARRAY_PUSH(palB, b) : ARRAY_PUSH(palH, h) : ARRAY_PUSH(palText, hatText)
END SUB

palette("button", "Button", 100, 28, TRUE)
palette("label", "Label", 80, 16, TRUE)
palette("checkbox", "Checkbox", 16, 16, TRUE)
