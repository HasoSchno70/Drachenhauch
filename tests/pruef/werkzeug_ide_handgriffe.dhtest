DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT 1
--- datei _programm/profilquelle.dh
FUNCTION READLINES_JOIN$() AS STRING
    RETURN JOIN$(["DIM x AS INTEGER", "CLASS Held", "    SUB lauf()", "        x = x + 1", "    END SUB", "END CLASS", "SUB zeige()", "    PRINT x", "    PRINT x", "END SUB"], CHR$(10))
END FUNCTION
--- ersetzen protokoll("bereit")
IMPORT "profilquelle.dh"
protokoll("bereit")
--- nachher
DIM P AS ARRAY OF STRING : P = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(P) - 1
    IF LEFT$(P[i], 13) = "profiltabelle" THEN PRINT P[i]
NEXT
--- erwartet
profiltabelle funktion Held.lauf 2
profiltabelle funktion zeige 2
profiltabelle funktion (Hauptprogramm) 1
profiltabelle funktionen 3
profiltabelle zeilen 5

