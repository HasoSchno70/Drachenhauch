=== mid an spaeter stelle ist nicht teurer als vorn
' Die Schranke ist grosszuegig: vorher kostete jeder Aufruf gleich viel,
' egal wo -- 28 000 Aufrufe auf 200 000 Zeichen dauerten ueber 2 s.
DIM s AS STRING : s = "x" * 200000
DIM t0 AS FLOAT : t0 = TIMER()
DIM i AS INTEGER
DIM n AS INTEGER
FOR i = 0 TO 20000
    IF MID$(s, 5, 1) = "x" THEN n = n + 1
    IF LEFT$(s, 3) = "xxx" THEN n = n + 1
    IF INSTR(s, "x", 7) = 7 THEN n = n + 1
NEXT
PRINT n; " schnell "; (TIMER() - t0) < 0.5
--- erwartet
60003 schnell TRUE
