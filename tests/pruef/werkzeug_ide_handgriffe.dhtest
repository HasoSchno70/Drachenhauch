=== jedes beispiel steht genau einmal in einem thema
' examples/kategorien.json ist von Hand gepflegt -- ein neues Beispiel
' faellt sonst still aus der Themenliste heraus, und ein umbenanntes
' laesst einen Eintrag stehen, der auf nichts zeigt.
IMPORT "json"
DIM ord AS STRING : ord = PATHJOIN(ARG$(0), "../../examples")
DIM h AS JSON_HANDLE : h = JSON_PARSE("{" + CHR$(34) + "t" + CHR$(34) + ":" + JOIN$(READLINES(PATHJOIN(ord, "kategorien.json")), CHR$(10)) + "}")
DIM gesehen AS MAP OF INTEGER
DIM t AS INTEGER
DIM k AS INTEGER
DIM doppelt AS INTEGER : doppelt = 0
DIM fehlt AS INTEGER : fehlt = 0
FOR t = 0 TO JSON_LEN(h, "t") - 1
    FOR k = 0 TO JSON_LEN(h, "t." + STR$(t) + ".dateien") - 1
        DIM d AS STRING : d = JSON_GET_STRING(h, "t." + STR$(t) + ".dateien." + STR$(k))
        IF MAPHAS(gesehen, d) THEN
            doppelt = doppelt + 1 : PRINT "doppelt " ; d
        END IF
        MAPPUT(gesehen, d, 1)
        IF NOT FILEEXISTS(PATHJOIN(ord, d)) THEN
            fehlt = fehlt + 1 : PRINT "fehlt " ; d
        END IF
    NEXT
NEXT
DIM ohne AS INTEGER : ohne = 0
DIM f AS STRING
FOR EACH f IN DIRLIST(ord, "*.dh")
    IF LEFT$(f, 1) = "_" OR LEFT$(f, 6) = "bench_" THEN CONTINUE
    IF NOT MAPHAS(gesehen, f) THEN
        ohne = ohne + 1 : PRINT "ohne thema " ; f
    END IF
NEXT
PRINT "themen " ; JSON_LEN(h, "t") ; " doppelt " ; doppelt ; " fehlt " ; fehlt ; " ohne " ; ohne
--- argumente
{sammlung}
--- erwartet
themen 16 doppelt 0 fehlt 0 ohne 0

