  ],
  "abfragen": [
    {
      "name": "Belegzeilen",
      "sql": "SELECT p.id AS id, p.rechnung AS rechnung, ROW_NUMBER() OVER (PARTITION BY p.rechnung ORDER BY p.id) AS pos, 'Rechnung ' || r.nummer AS titel, r.nummer AS nummer, r.datum AS datum, k.name AS kunde, k.strasse AS strasse, k.plz || ' ' || k.ort AS ort, p.bezeichnung AS bezeichnung, p.menge AS menge, p.preis AS preis, p.mwst AS mwst, p.mwst || ' %' AS satz, p.menge * p.preis AS netto, (p.menge * p.preis * p.mwst + 50) / 100 AS steuer, p.menge * p.preis + (p.menge * p.preis * p.mwst + 50) / 100 AS brutto FROM positionen AS p JOIN rechnungen AS r ON r.id = p.rechnung LEFT JOIN kunden AS k ON k.id = r.kunde"
    }
  ]
}