=== dirlist
DIM names AS ARRAY OF STRING
names = DIRLIST(".")
DIM i AS INTEGER
FOR i = 0 TO LEN(names) - 1
    IF names[i] = "a.txt" OR names[i] = "b.txt" OR names[i] = "sub" THEN PRINT names[i]
NEXT
--- datei a.txt
y
--- datei b.txt
x
--- verzeichnis sub
--- erwartet
a.txt
b.txt
sub

=== path helpers
PRINT BASENAME("a/b/c.txt")
PRINT DIRNAME("a/b/c.txt")
--- erwartet
c.txt
a/b

=== copy rename append
COPYFILE("src.txt", "dst.txt")
APPENDFILE("dst.txt", " welt")
RENAME("dst.txt", "final.txt")
DIM f AS FILE
f = OpenFile("final.txt", "r")
PRINT ReadLine(f)
CloseFile(f)
PRINT FILEEXISTS("dst.txt")
PRINT FILEEXISTS("final.txt")
--- datei src.txt
hallo
--- erwartet
hallo welt
FALSE
TRUE

=== dirlist missing dir raises
