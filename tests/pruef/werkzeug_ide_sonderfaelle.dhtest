IMPORT "json"
DIM kh AS JSON_HANDLE : kh = JSON_LOAD("_programm/ide.json")
PRINT "umbruch gemerkt " ; JSON_HAS(kh, "umbruch") AND JSON_GET_BOOL(kh, "umbruch")
PRINT "zweimal gestartet " ; zahl("bereit") = 2
--- erwartet
umbruch gemerkt TRUE
zweimal gestartet TRUE

=== sitzung haengt am projektordner
' Drei Laeufe, EINE ide.json (sie liegt in _programm/, alle Laeufe sehen sie):
' im Fallordner mit eins.dh, im Unterordner b mit zwei.dh, dann wieder im
' Fallordner. Der dritte bekommt die Reiter SEINES Ordners, nicht die zuletzt
' offenen -- zugleich die Gegenprobe zur globalen Sitzung aus Stand 4.
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
eins.dh
--- umgebung
DHRT_FRAMES=60
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei eins.dh
PRINT 1
--- datei b/zwei.dh
PRINT 2
--- nochmal in b
zwei.dh
--- nochmal
gibt_es_nicht.dh
--- nachher
