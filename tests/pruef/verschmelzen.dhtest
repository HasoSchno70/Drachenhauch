' Superinstruktionen (M2, docs/entwurf-maschinencode.md): beim Laden markiert
' `model::verschmelzen` Folgen wie `LOAD a, LOAD b, ADD, STORE c`, und
' `dispatch` fuehrt sie in einem Schritt aus -- aber nur den sicheren Fall.
' Alles andere (Ueberlauf, Division durch 0, eine Umwandlung beim Speichern,
' ein konstanter oder leerer Platz, Kommazahl-Vergleiche) laeuft Befehl fuer
' Befehl. Jeder Fall steht zweimal: einmal mit, einmal ohne
' (`DHRT_OHNE_VERSCHMELZEN`) -- die Erwartung ist dieselbe.
' Format: docs/werkzeuge.md.

=== rechnen und vergleichen wie ohne
SUB lauf()
    DIM a AS INTEGER : a = 7
    DIM b AS INTEGER : b = 3
    DIM f AS FLOAT : f = 2.5
    DIM c AS INTEGER
    DIM g AS FLOAT
    c = a + b : PRINT c;
    c = a - b : PRINT " "; c;
    c = a * b : PRINT " "; c;
    c = a MOD b : PRINT " "; c;
    c = -7 MOD b : PRINT " "; c;
    g = a / b : PRINT " "; g;
    g = a * f : PRINT " "; g;
    g = a + b : PRINT " "; g
    IF a < b THEN PRINT "lt" ELSE PRINT "ge"
    IF a <= 7 THEN PRINT "le"
    IF f > a THEN PRINT "gt" ELSE PRINT "ngt"
    IF a = 7 AND b <> 7 THEN PRINT "eq"
    DIM i AS INTEGER
    DIM s AS INTEGER
    FOR i = 1 TO 10
        IF i MOD 2 = 0 THEN s = s + i
    NEXT
    PRINT s
END SUB
lauf()
--- erwartet
10 4 21 1 2 2.3333333333333335 17.5 10.0
ge
le
ngt
eq
30

=== rechnen und vergleichen wie ohne (ohne verschmelzen)
SUB lauf()
    DIM a AS INTEGER : a = 7
    DIM b AS INTEGER : b = 3
    DIM f AS FLOAT : f = 2.5
    DIM c AS INTEGER
    DIM g AS FLOAT
    c = a + b : PRINT c;
    c = a - b : PRINT " "; c;
    c = a * b : PRINT " "; c;
    c = a MOD b : PRINT " "; c;
    c = -7 MOD b : PRINT " "; c;
    g = a / b : PRINT " "; g;
    g = a * f : PRINT " "; g;
    g = a + b : PRINT " "; g
    IF a < b THEN PRINT "lt" ELSE PRINT "ge"
    IF a <= 7 THEN PRINT "le"
    IF f > a THEN PRINT "gt" ELSE PRINT "ngt"
    IF a = 7 AND b <> 7 THEN PRINT "eq"
    DIM i AS INTEGER
    DIM s AS INTEGER
    FOR i = 1 TO 10
        IF i MOD 2 = 0 THEN s = s + i
    NEXT
    PRINT s
END SUB
lauf()
--- umgebung
DHRT_OHNE_VERSCHMELZEN=1
--- erwartet
10 4 21 1 2 2.3333333333333335 17.5 10.0
ge
le
ngt
eq
30

=== ueberlauf meldet sich in seiner zeile
' Der schnelle Weg gibt beim Ueberlauf ab; die Meldung kommt vom Einzelbefehl.
SUB lauf()
    DIM a AS INTEGER : a = 9223372036854775807
    DIM b AS INTEGER : b = 1
    DIM c AS INTEGER
    TRY
        c = a + b
    CATCH e
        PRINT "gefangen: "; e
    END TRY
    c = a * b
    PRINT c
    c = a + b
END SUB
lauf()
--- erwartet
gefangen: Ganzzahl-Ueberlauf bei '+' (INTEGER ist 64-bit; Wertebereich ueberschritten)
9223372036854775807
--- fehler
fall.dh:13: Ganzzahl-Ueberlauf bei '+'

