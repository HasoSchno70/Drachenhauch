' Das Einstiegsbuch: Kapitelnummern, Querverweise, Bausteine, Code im Buch.
'
' Anders als das Referenzbuch ist der Einstieg ein LINEARER Kurs und verweist
' an ueber hundert Stellen auf "Kapitel 12" und aehnliche Zahlen. Bis zum
' Gegenlesen am 2026-08-30 druckte er die Nummern nirgends. Seither nummeriert
' build_book.js die Kapitel durch ZAEHLEN, die Verweise meinen von Hand die
' DATEINUMMER -- beide muessen uebereinstimmen, sonst verschiebt ein
' eingeschobenes Kapitel alle Verweise lautlos.
'
' Die Kapitel sind JavaScript-Module: tools/einstieg_kapitel_export.js liest
' sie, die drei Werkzeuge im Buchverzeichnis pruefen den Code (bis 2026-08-30
' rief sie weder die Suite noch die CI auf). Ohne Node ueberspringen sich
' die Faelle.
'
' Bis 2026-09-17 tests/test_einstieg_buch.py. Format: docs/werkzeuge.md.

=== die gedruckte nummer ist die dateinummer
IMPORT "helfer.dh"
DIM d AS JSON_HANDLE : d = kapitelExport(ARG$(0))
DIM schief AS INTEGER : schief = 0
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(d, "kapitel") - 1
    DIM p AS STRING : p = "kapitel." + STR$(i)
    IF JSON_TYPE(d, p + ".nr") = "null" THEN CONTINUE
    DIM datei AS STRING : datei = JSON_GET_STRING(d, p + ".datei")
    DIM dateiNr AS INTEGER : dateiNr = VAL(LEFT$(datei, INSTR(datei, "_")))
    IF dateiNr <> JSON_GET_INT(d, p + ".nr") THEN
        PRINT datei; ": gedruckt als Kapitel "; JSON_GET_INT(d, p + ".nr")
        schief = schief + 1
    END IF
NEXT
PRINT "genug kapitel "; (JSON_LEN(d, "kapitel") > 30)
PRINT "abweichend "; schief
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/einstieg.dh"
--- erwartet
genug kapitel TRUE
abweichend 0

=== jeder verweis trifft ein kapitel
' Die Verweise kommen aus dem ROHTEXT der Kapiteldateien, nicht ueber die
' Bausteine: sie stehen auch in Bildunterschriften und Tabellenzellen, und ein
' Sammler, der die uebersieht, prueft weniger als er verspricht -- beim ersten
' Anlauf fand er 93 von 134.
IMPORT "helfer.dh"
DIM d AS JSON_HANDLE : d = kapitelExport(ARG$(0))
DIM hoechste AS INTEGER : hoechste = JSON_GET_INT(d, "hoechste")
DIM ordner AS STRING : ordner = ARG$(0) + "/buch-einstieg/buch/content"
DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(ordner, "*.js")
SORT(dateien)
DIM zahl AS INTEGER : zahl = 0
DIM tot AS MAP OF BOOLEAN
DIM i AS INTEGER
FOR i = 0 TO LEN(dateien) - 1
    DIM text AS STRING : text = BUFFER_TO_STRING$(READALL_BYTES(ordner + "/" + dateien[i]))
    DIM nummern AS ARRAY OF STRING : nummern = REGEX_FIND_ALL(text, "Kapitel (\d+)")
    DIM k AS INTEGER
    FOR k = 0 TO LEN(nummern) - 1
        zahl = zahl + 1
        DIM n AS INTEGER : n = VAL(nummern[k])
        DIM schl AS STRING : schl = dateien[i] + ": Kapitel " + nummern[k]
        IF (n < 1 OR n > hoechste) AND NOT MAPHAS(tot, schl) THEN
            MAPPUT(tot, schl, TRUE)
            PRINT "ausserhalb 1.."; hoechste; ": "; schl
        END IF
    NEXT
NEXT
PRINT "genug verweise "; (zahl > 100)
PRINT "geprueft"
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/einstieg.dh"
--- erwartet
genug verweise TRUE
geprueft

