=== laeuft einmal oder kehrt wieder und laesst sich anhalten
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM a AS GUI_WINDOW : a = GUI_WINDOW("A", 0, 0, 140, 100)
DIM b AS GUI_WINDOW : b = GUI_WINDOW("B", 150, 0, 140, 100)
PRINT GUI_WINDOW_GLOWING(a)
GUI_WINDOW_GLOW(a, -1, 500)
GUI_WINDOW_GLOW_SET(b, "pause", 200)
GUI_WINDOW_GLOW(b, -1, 500)
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 10 THEN PRINT n; " "; GUI_WINDOW_GLOWING(a); " "; GUI_WINDOW_GLOWING(b)
    IF n = 60 THEN PRINT n; " "; GUI_WINDOW_GLOWING(a); " "; GUI_WINDOW_GLOWING(b)
    IF n = 61 THEN GUI_WINDOW_GLOW_STOP(b)
    IF n = 62 THEN PRINT n; " "; GUI_WINDOW_GLOWING(b)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=70
--- erwartet
FALSE
10 TRUE TRUE
60 FALSE TRUE
62 FALSE

=== falsche angaben sind ein fehler mit der liste
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 100, 100)
TRY
    GUI_WINDOW_GLOW_SET(w, "farbton", 1)
CATCH e
    PRINT e
END TRY
TRY
    GUI_WINDOW_GLOW_SET(w, "richtung", "quer")
CATCH e
    PRINT e
END TRY
TRY
    GUI_WINDOW_GLOW(w, -1, 0)
CATCH e
    PRINT e
END TRY
TRY
    GUI_WINDOW_GLOW_SET(w, "art", "nebel")
CATCH e
    PRINT e
END TRY
GUI_WINDOW_GLOW_SET(w, "art", "taschenlampe")
GUI_WINDOW_GLOW_SET(w, "art", "streif")
GUI_WINDOW_GLOW_SET(w, "richtung", 2)
GUI_WINDOW_GLOW_SET(w, "staerke", 5.0)
GUI_WINDOW_GLOW_SET(w, "rand", FALSE)
PRINT "ok"
--- erwartet
GUI_WINDOW_GLOW_SET: unbekannter Schluessel 'farbton' (bekannt: farbe, dauer, pause, richtung, breite, staerke, rand, art)
GUI_WINDOW_GLOW_SET: richtung ist rechts, links, unten oder oben (nicht 'quer')
GUI_WINDOW_GLOW: die Dauer muss groesser als 0 ms sein
GUI_WINDOW_GLOW_SET: art ist streif, lampe oder rahmen (nicht 'nebel')
ok

=== die lampe hellt den kegel auf und dunkelt den rest ab
' Ein Durchgang nach links ueber 1200 ms: in der Mitte (Bild 36) steht der
' Kegel mittig im flachen Bogen (y = 0,40 der Hoehe). Verglichen wird mit
' demselben Fenster ohne Lampe -- am Kegel heller, in der Ecke dunkler, und
' nach dem Durchgang wieder gleich.
IMPORT "gui"
SCREEN(500, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_THEME_PRESET("glas_dunkel")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 500, 300)
FUNCTION hell(b AS IMAGE, x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM c AS INTEGER : c = GETPIXEL(b, x, y)
    RETURN ((c SHR 16) BAND 255) + ((c SHR 8) BAND 255) + (c BAND 255)
END FUNCTION
FUNCTION bild(n AS INTEGER, name AS STRING) AS IMAGE
    DIM f AS INTEGER
    FOR f = 1 TO n
        GUI_UPDATE() : CLS(&H101820) : GUI_DRAW() : FLIP()
    NEXT
    SAVESCREENSHOT(name)
    RETURN LOADIMAGE(name)
END FUNCTION
DIM ohne AS IMAGE : ohne = bild(2, "ohne.png")
GUI_WINDOW_GLOW_SET(w, "art", "lampe")
GUI_WINDOW_GLOW_SET(w, "richtung", "links")
GUI_WINDOW_GLOW(w, &HFFB050, 1200)
DIM frueh AS IMAGE : frueh = bild(22, "frueh.png")
' Frueh steht er rechts: rechts heller als ohne, links noch nicht.
PRINT "frueh rechts "; hell(frueh, 440, 130) > hell(ohne, 440, 130) + 30
PRINT "frueh links dunkler "; hell(frueh, 60, 130) < hell(ohne, 60, 130)
DIM mitte AS IMAGE : mitte = bild(12, "mitte.png")
PRINT "mitte hell "; hell(mitte, 250, 120) > hell(ohne, 250, 120) + 60
PRINT "ecke dunkel "; hell(mitte, 20, 285) < hell(ohne, 20, 285)
DIM danach AS IMAGE : danach = bild(60, "danach.png")
PRINT "danach gleich "; hell(danach, 250, 120) = hell(ohne, 250, 120) AND hell(danach, 20, 285) = hell(ohne, 20, 285)
--- umgebung
DHRT_FRAMES=200
--- erwartet
frueh rechts TRUE
frueh links dunkler TRUE
mitte hell TRUE
ecke dunkel TRUE
danach gleich TRUE

=== das streiflicht laesst die rahmen aufblitzen
' Art "rahmen", nach links ueber 1200 ms, Fenster 500 x 300. Gesucht wird
' die hellste Stelle an Ober- und Unterkante (gegen dasselbe Fenster ohne
' Licht): oben liegt sie weiter links als unten (die Kante ist schraeg und
' laeuft nach links voraus), ein paar Bilder spaeter liegen beide weiter
' links, und der Inhalt abseits der Linie bleibt, wie er ist -- abgedunkelt
' wird nichts.
IMPORT "gui"
SCREEN(500, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_THEME_PRESET("glas_dunkel")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 500, 300)
FUNCTION hell(b AS IMAGE, x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM c AS INTEGER : c = GETPIXEL(b, x, y)
    RETURN ((c SHR 16) BAND 255) + ((c SHR 8) BAND 255) + (c BAND 255)
END FUNCTION
FUNCTION bild(n AS INTEGER, name AS STRING) AS IMAGE
    DIM f AS INTEGER
    FOR f = 1 TO n
        GUI_UPDATE() : CLS(&H101820) : GUI_DRAW() : FLIP()
    NEXT
    SAVESCREENSHOT(name)
    RETURN LOADIMAGE(name)
END FUNCTION
DIM ohne AS IMAGE : ohne = bild(2, "ohne.png")
DIM spitze AS INTEGER
' Die x-Lage der hellsten Stelle in Zeile y; setzt `spitze` auf den Zuwachs.
FUNCTION hellste(b AS IMAGE, y AS INTEGER) AS INTEGER
    DIM bx AS INTEGER : bx = -1
    spitze = 0
    DIM x AS INTEGER
    FOR x = 0 TO 499
        DIM z AS INTEGER : z = hell(b, x, y) - hell(ohne, x, y)
        IF z > spitze THEN spitze = z : bx = x
    NEXT
    RETURN bx
END FUNCTION
GUI_WINDOW_GLOW_SET(w, "art", "rahmen")
GUI_WINDOW_GLOW_SET(w, "richtung", "links")
GUI_WINDOW_GLOW(w, &HFFB050, 1200)
DIM a AS IMAGE : a = bild(34, "a.png")
DIM oben1 AS INTEGER : oben1 = hellste(a, 1)
PRINT "oben hell "; spitze > 100
DIM unten1 AS INTEGER : unten1 = hellste(a, 298)
PRINT "unten hell "; spitze > 100
PRINT "schraeg "; oben1 < unten1 - 60
PRINT "inhalt unberuehrt "; hell(a, 30, 200) = hell(ohne, 30, 200)
DIM b AS IMAGE : b = bild(6, "b.png")
PRINT "wandert nach links "; hellste(b, 1) < oben1 AND hellste(b, 298) < unten1
--- umgebung
DHRT_FRAMES=100
--- erwartet
oben hell TRUE
unten hell TRUE
schraeg TRUE
inhalt unberuehrt TRUE
wandert nach links TRUE
