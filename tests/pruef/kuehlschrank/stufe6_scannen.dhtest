' Kuehlschrank-App im Drachenhauch Studio, Stufe 6: Scannen
' (examples/studio/kuehlschrank: ScanFenster, Suche im ProduktFenster,
' Module OpenFoodFacts, Vorgaben und Barcodecache, Klasse Fund). Proben wie
' in den Stufen davor: F5 im Studio, dann main.dh mit einer Probe statt der
' Bildschleife; Heute ist fest. Open Food Facts ist ein falscher Server auf
' diesem Rechner (_hilfen/off_server.dh) -- nie das echte.
' Proben mit Netzverkehr bekommen 1500 Bilder und enden selbst (END): mit
' fuenf endete studioBild() unter Last mitten im Warten auf die Antwort.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== vorgaben: stichwort am wortende, laenger vor kuerzer, lernen
' Die Listen der Python-App, die Regel nicht: dort kam "Reis" in den
' Gefrierschrank ("eis"), "Rindersteak" hielt 180 Tage im Vorratsraum
' ("tea"), "Pfefferminztee" war ein Gewuerz ("pfeffer"), "Koelsch" Oel.
' Gelerntes geht vor (das Haeufigere, bei Gleichstand das Neuere), je
' Barcode, ohne Barcode je Name.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DIM n AS STRING
FOR EACH n IN ["Reis", "Basmati Reis", "Milchreis", "Vollmilch", "Rindersteak", "Speiseeis", "Rapsöl", "Kölsch", "Pfefferminztee", "Eisbergsalat", "Hackfleisch", "Tiefkühlpizza", "TK-Erbsen", "Crème fraîche", "Frühstücksei", "Erdbeeren", "Tellerlinsen", "Joghurt mit Erdbeeren"]
    PRINT n; ": "; vorschlagOrt$(n, ""); " | "; vorschlagTage(n, ""); " | "; vorschlagKategorie$(n)
NEXT
PRINT "kategorien: "; vorschlagOrt$("Basmati", "Getreide, Reis"); " | "; vorschlagTage("Ding", "en:frozen-foods")
DIM orte AS ARRAY OF STRING : orte = ["Kühlschrank", "Kühlschrank - Tür", "Gefrierschrank", "Vorratsschrank"]
PRINT "passend: "; passenderOrt$("kühlschrank", orte); " | "; passenderOrt$("Vorratsraum", orte); " | "; passenderOrt$("Tür", orte); " | "; passenderOrt$("", orte); " | "; passenderOrt$("Gemüsefach", ["Keller"])
DB_EXEC(db, "DELETE FROM user_learning")
PRINT "nichts ["; gelernt$("4001", "Milch", "storage_location"); "]"
verlauf.beginnen("lernen")
lernen("4001", "Milch", "storage_location", "Kühlschrank - Tür")
lernen("4001", "Milch", "storage_location", "Kühlschrank")
lernen("4001", "Milch", "storage_location", "Kühlschrank")
lernen("", "Brot", "expiry_days", "5")
verlauf.abschliessen()
PRINT "gelernt "; gelernt$("4001", "Egal", "storage_location"); " | "; gelernt$("", "Brot", "expiry_days"); " | andere ["; gelernt$("4999", "Käse", "storage_location"); "]"
PRINT "zeilen "; JOIN$(textListe("SELECT IFNULL(barcode, '-') || ':' || product_name || ':' || value || ':' || choice_count || ':' || confidence FROM user_learning ORDER BY id"), " ")
PRINT "zurueck "; verlauf.rueckgaengig$(); " | "; dbZahl("SELECT COUNT(*) FROM user_learning")
--- erwartet
geprueft TRUE
Reis: Vorratsraum | 90 | Grundnahrungsmittel
Basmati Reis: Vorratsraum | 90 | Grundnahrungsmittel
