GUI_SET_NAME(rad, "rad") : GUI_SET_ICON(rad, "einstellungen") : GUI_TOOLTIP(rad, "dreht sich")
DIM funken AS GUI_WIDGET : funken = GUI_BUTTON(s6, "Funken", 200, 240, 160, 50)
DIM konfetti AS GUI_WIDGET : konfetti = GUI_BUTTON(s6, "Konfetti", 380, 240, 160, 50)
DIM sterne AS GUI_WIDGET : sterne = GUI_BUTTON(s6, "Sterne", 560, 240, 160, 50)
