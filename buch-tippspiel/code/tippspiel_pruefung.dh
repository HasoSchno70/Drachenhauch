' nun einmal alle vier Spalten, und das UPSERT beim Abruf nennt sie auch so.
DB_EXEC(db, "INSERT INTO spiele (liga, spieltag, heim, gast) " + _
            "VALUES ('bl1', 1, 'VfL Bochum', 'Hertha BSC')")
