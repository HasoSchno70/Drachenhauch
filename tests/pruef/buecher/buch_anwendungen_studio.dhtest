DIM w AS STRING : w = ARG$(1)
DIM teil1 AS STRING : teil1 = ""
DIM o AS STRING
FOR EACH o IN ["kap01", "kap02", "kap03", "kap04", "kap05", "kap06"]
    DIM f AS STRING
    FOR EACH f IN DIRLIST(w + "/buecher/anwendungen/code/" + o)
        IF RIGHT$(f, 3) = ".dh" THEN teil1 = teil1 + UPPER$(READALL(w + "/buecher/anwendungen/code/" + o + "/" + f))
    NEXT
NEXT
DIM pm AS STRING : pm = CWD$() + "/kap24_mediathek"
benutzer(CWD$() + "/benutzer")
kopieren(w + "/buecher/anwendungen/code/kap24/mediathek", pm)
f5("kap24_mediathek", pm)
DIM erzeugt AS STRING : erzeugt = ""
FOR EACH o IN DIRLIST(pm + "/_studio")
    IF RIGHT$(o, 3) = ".dh" THEN erzeugt = erzeugt + READALL(pm + "/_studio/" + o)
NEXT
DIM j AS JSON_HANDLE : j = JSON_PARSE(READALL(w + "/buecher/anwendungen/buch/spickzettel.json"))
DIM n AS INTEGER
DIM g AS INTEGER
DIM e AS INTEGER
DIM befehle AS INTEGER : befehle = 0
FOR g = 0 TO JSON_LEN(j, "gui") - 1
    FOR e = 0 TO JSON_LEN(j, "gui." + STR$(g) + ".1") - 1
        DIM zeile AS STRING : zeile = JSON_GET_STRING(j, "gui." + STR$(g) + ".1." + STR$(e) + ".0")
        DIM name AS STRING
        FOR EACH name IN REGEX_FIND_ALL(zeile, "[A-Z][A-Z_]+\(")
            name = LEFT$(name, LEN(name) - 1)
            befehle = befehle + 1
            IF INSTR(teil1, name + "(") < 0 THEN PRINT "nicht in Teil I: "; name
        NEXT
    NEXT
NEXT
DIM sigs AS INTEGER : sigs = 0
FOR g = 0 TO JSON_LEN(j, "studio") - 1
    FOR e = 0 TO JSON_LEN(j, "studio." + STR$(g) + ".1") - 1
        DIM sig AS STRING : sig = JSON_GET_STRING(j, "studio." + STR$(g) + ".1." + STR$(e) + ".0")
        sigs = sigs + 1
        IF INSTR(erzeugt, sig) < 0 THEN PRINT "nicht erzeugt: "; sig
    NEXT
NEXT
PRINT "befehle genug "; befehle >= 40; ", signaturen genug "; sigs >= 25
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../..
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
--- erwartet
kap24_mediathek geprueft TRUE beendet TRUE
befehle genug TRUE, signaturen genug TRUE
