=== break und continue verlassen die schleife
DIM i AS INTEGER
DIM s AS INTEGER
FOR i = 1 TO 1000
    IF i MOD 2 = 0 THEN CONTINUE
    IF i > 500 THEN BREAK
    s = s + i
NEXT
PRINT s; " "; i
DIM w AS INTEGER
WHILE TRUE
    w = w + 3
    IF w > 100 THEN BREAK
WEND
PRINT w
