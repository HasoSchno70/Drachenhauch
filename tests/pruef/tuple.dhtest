=== call with paren args unaffected (1)
' `func(a, b)` ist Aufruf mit 2 Args, kein Tupel-Argument.
FUNCTION add2(x AS INTEGER, y AS INTEGER) AS INTEGER
    RETURN x + y
END FUNCTION

PRINT add2(3, 4)
--- erwartet
7

=== call with paren args unaffected (2)
' `func(a, b)` ist Aufruf mit 2 Args, kein Tupel-Argument.
FUNCTION add2(x AS INTEGER, y AS INTEGER) AS INTEGER
    RETURN x + y
END FUNCTION

PRINT add2(3, 4)
--- erwartet
7

=== destructuring im einzeiligen if
FUNCTION zwei() AS TUPLE
    RETURN (7, 8)
END FUNCTION
DIM x AS INTEGER
DIM y AS INTEGER
DIM b AS BOOLEAN

b = TRUE
IF b THEN (x, y) = zwei()
PRINT x; " "; y
--- erwartet
7 8

=== destructuring im else zweig
FUNCTION zwei() AS TUPLE
    RETURN (7, 8)
END FUNCTION
DIM x AS INTEGER
DIM y AS INTEGER
DIM b AS BOOLEAN

b = FALSE
IF b THEN (x, y) = (1, 2) ELSE (x, y) = (30, 40)
PRINT x; " "; y
--- erwartet
30 40

=== destructuring mit doppelpunkt verkettet
' Der Doppelpunkt trennt Anweisungen -- die Zuweisung darf ihn nicht
FUNCTION zwei() AS TUPLE
    RETURN (7, 8)
END FUNCTION
DIM x AS INTEGER
DIM y AS INTEGER
DIM b AS BOOLEAN

b = TRUE
IF b THEN (x, y) = zwei() : x = x + 100
PRINT x; " "; y
--- erwartet
107 8

=== destructuring wird nicht ausgefuehrt wenn falsch
' Gegenprobe: die Zuweisung haengt wirklich an der Bedingung und laeuft
FUNCTION zwei() AS TUPLE
    RETURN (7, 8)
END FUNCTION
DIM x AS INTEGER
DIM y AS INTEGER
DIM b AS BOOLEAN

b = FALSE
x = 5 : y = 6
IF b THEN (x, y) = zwei()
PRINT x; " "; y
--- erwartet
5 6

