' Die Kaestchen im Projektbaum: angehakte Dateien und Ordner schraenken
' Projektsuche, Umbenennen, Ersetzen und Symbolverzeichnis ein
' (projektDateien in ide/ide.dh). Bis 2026-09-27 zaehlte nur der genaue Weg
' einer DATEI -- ein angehakter Ordner machte das Projekt leer, und es sah
' aus, als taete der Haken nichts.
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

--- langsam
=== ein angehakter ordner nimmt seine dateien mit
DIM prD AS STRING
FOR EACH prD IN projektDateien("*.dh")
    protokoll("probe ohne " + REPLACE$(prD, CHR$(92), "/"))
NEXT
GUI_FILETREE_SET_CHECKED(baum, PATHJOIN(projektOrdner, "lib"), TRUE)
FOR EACH prD IN projektDateien("*.dh")
    protokoll("probe mit " + REPLACE$(prD, CHR$(92), "/"))
NEXT
projektBeschriften()
protokoll("probe text " + MID$(GUI_TEXT(lblProjekt), INSTR(GUI_TEXT(lblProjekt), "--"), 99))
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- argumente
c.dh
--- umgebung
DHRT_FRAMES=300
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei c.dh
PRINT "c"
--- datei lib/a.dh
PRINT "a"
--- datei lib/b.dh
PRINT "b"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 6) = "probe " THEN PRINT MID$(L[i], 6, LEN(L[i]))
NEXT
--- erwartet
ohne c.dh
ohne lib/a.dh
ohne lib/b.dh
mit lib/a.dh
mit lib/b.dh
text -- Suche/Umbau nur in 1 angehakten
