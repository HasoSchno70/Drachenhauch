' =====================================================================
'  Kaminfeuer -- gemuetliches Grafik-Demo (Vollbild, interaktiv)
'
'  Ein prozedurales, geschichtetes Partikel-Feuer (Flammen + heisser Kern +
'  Funken + Rauch) brennt vor einem echten Kaminbild, mit knisterndem
'  Feuer-Sound, warm flackerndem Licht und gelegentlichen Wind-Boeen.
'
'  Steuerung:
'    Linke Maustaste ziehen  -> Feuer an die gewuenschte Stelle setzen
'    Mausrad                 -> Feuer groesser / kleiner
'    ESC                     -> beenden
'
'  Assets (frei, einmalig holen):   py fireplace\assets\download.py
'    fireplace.jpg  -- Steinkamin, Wikimedia Commons / CEllen (CC BY-SA 4.0)
'    fire.ogg       -- Knistern, Wikimedia Commons / Glaneur de sons (CC BY 3.0)
'    wind.mp3       -- optional, selbst beilegen (siehe CREDITS.txt)
'  Laeuft auch OHNE die Dateien (prozeduraler Ersatz-Kamin, stumm).
'
'  Native:  gbrun.py --native fireplace\fireplace.gb
' =====================================================================

IMPORT "particles"
IMPORT "imgfx"
IMPORT "audio"

CONST W = 1280
CONST H = 720
CONST IMGW = 960          ' 4:3-Kaminbild hoehenfuellend, zentriert (Letterbox)
CONST IMGX = 160
CONST FIRE_W0 = 44.0      ' Basis-Breite der Feuerbasis (mal Skalierung)
CONST WIND_PEAK = 0.14    ' max. Wind-Lautstaerke (sehr leise -> Feuer dominiert klar)

SCREEN(W, H, "Kaminfeuer")
SET_FULLSCREEN(TRUE)
RANDOMIZE(MILLIS())

' Veraenderbare Feuer-Lage + -Groesse (per Maus steuerbar).
DIM fire_x AS FLOAT
DIM fire_y AS FLOAT
DIM fire_scale AS FLOAT
fire_x = 620.0
fire_y = 516.0
fire_scale = 1.0

' --- Hintergrund ---
DIM has_bg AS BOOLEAN
DIM bg AS IMAGE
has_bg = FALSE
IF FILEEXISTS("assets/fireplace.jpg") THEN
    DIM raw AS IMAGE
    raw = LOADIMAGE("assets/fireplace.jpg")
    bg = IMAGE_SCALE(raw, IMGW, H)
    has_bg = TRUE
END IF

' --- Sound: knisterndes Feuer im Loop ---
IF FILEEXISTS("assets/fire.ogg") THEN PLAYMUSIC("assets/fire.ogg", 0, 1.0)

' --- Wind: echtes Sample, leise + in sanft ein-/ausgeblendeten Boeen ---
DIM has_wind AS BOOLEAN
DIM wind_snd AS SOUND
DIM wind_state AS INTEGER
DIM wind_t AS FLOAT
has_wind = FALSE
IF FILEEXISTS("assets/wind.mp3") THEN
    wind_snd = LOADSOUND("assets/wind.mp3")
    has_wind = TRUE
END IF
wind_state = 0
wind_t = RANDF(8.0, 16.0)

' --- Feuer-Schichten (Farbe/Modus fest, Groesse/Tempo skaliert) ---
DIM ps_flame AS PARTICLE_SYSTEM
ps_flame = PARTICLE_SYSTEM_NEW(fire_x, fire_y)
PARTICLE_SET_LIFETIME(ps_flame, 460, 850)
PARTICLE_SET_COLOR(ps_flame, &HFFD050)
PARTICLE_SET_COLOR_END(ps_flame, &HC81400)
PARTICLE_SET_FADE(ps_flame, TRUE)
PARTICLE_SET_MODE(ps_flame, "glow")

DIM ps_core AS PARTICLE_SYSTEM
ps_core = PARTICLE_SYSTEM_NEW(fire_x, fire_y)
PARTICLE_SET_LIFETIME(ps_core, 260, 460)
PARTICLE_SET_COLOR(ps_core, &HFFF6C8)
PARTICLE_SET_COLOR_END(ps_core, &HFF7000)
PARTICLE_SET_FADE(ps_core, TRUE)
PARTICLE_SET_MODE(ps_core, "glow")

DIM ps_spark AS PARTICLE_SYSTEM
ps_spark = PARTICLE_SYSTEM_NEW(fire_x, fire_y)
PARTICLE_SET_LIFETIME(ps_spark, 450, 1000)
PARTICLE_SET_COLOR(ps_spark, &HFFF0A0)
PARTICLE_SET_COLOR_END(ps_spark, &HFF4000)
PARTICLE_SET_FADE(ps_spark, TRUE)
PARTICLE_SET_MODE(ps_spark, "streak")

' Groessen-/Tempo-Parameter aus fire_scale ableiten (bei Aenderung neu setzen).
SUB apply_scale()
    DIM s AS FLOAT
    s = fire_scale
    PARTICLE_SET_VELOCITY(ps_flame, -22.0 * s, 22.0 * s, -205.0 * s, -130.0 * s)
    PARTICLE_SET_GRAVITY(ps_flame, 0.0, -45.0 * s)
    PARTICLE_SET_SIZE(ps_flame, INT(5.0 * s) + 1, INT(12.0 * s) + 1)
    PARTICLE_SET_VELOCITY(ps_core, -12.0 * s, 12.0 * s, -150.0 * s, -105.0 * s)
    PARTICLE_SET_GRAVITY(ps_core, 0.0, -42.0 * s)
    PARTICLE_SET_SIZE(ps_core, INT(3.0 * s) + 1, INT(6.0 * s) + 1)
    PARTICLE_SET_VELOCITY(ps_spark, -45.0 * s, 45.0 * s, -210.0 * s, -110.0 * s)
    PARTICLE_SET_GRAVITY(ps_spark, 0.0, 90.0)
    PARTICLE_SET_SIZE(ps_spark, 2, 2)
END SUB
apply_scale()

' --- Weicher Licht-Schein: EIN radialer Glow-Sprite (Mitte warm -> Rand
'     schwarz), additiv + pulsierend gezeichnet. Ersetzt die frueheren
'     gestapelten Kreise (deren harte Kanten als Ringe sichtbar waren). ---
DIM glow AS IMAGE
glow = GENTEX_RADIAL(256, 256, RGB(255, 150, 60), RGB(0, 0, 0), 0.16)

DIM t AS FLOAT
t = 0.0
DIM last AS INTEGER
last = MILLIS()

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(KEY_ESCAPE) THEN BREAK
    DIM now AS INTEGER
    now = MILLIS()
    DIM dt AS INTEGER
    dt = now - last
    last = now
    IF dt < 1 THEN dt = 1
    IF dt > 80 THEN dt = 80
    DIM dts AS FLOAT
    dts = dt * 0.001
    t = t + dts

    ' --- Interaktion: Feuer ziehen (linke Maustaste) + skalieren (Mausrad) ---
    IF MOUSEBUTTON(0) THEN
        fire_x = MOUSEX()
        fire_y = MOUSEY()
    END IF
    DIM wheel AS INTEGER
    wheel = MOUSEWHEEL()
    IF wheel <> 0 THEN
        fire_scale = fire_scale + wheel * 0.08
        IF fire_scale < 0.35 THEN fire_scale = 0.35
        IF fire_scale > 1.6 THEN fire_scale = 1.6
        apply_scale()
    END IF

    ' --- Wind-Boeen (sanft ein-/ausgeblendet) ---
    IF has_wind THEN
        IF wind_state = 0 THEN
            wind_t = wind_t - dts
            IF wind_t <= 0.0 THEN
                PLAYSOUND(wind_snd)
                AUDIO_SET_VOLUME(wind_snd, 0.0)
                wind_state = 1 : wind_t = 0.0
            END IF
        ELSEIF wind_state = 1 THEN
            wind_t = wind_t + dts
            DIM lv AS FLOAT
            lv = WIND_PEAK * (wind_t / 2.5)
            IF lv > WIND_PEAK THEN lv = WIND_PEAK
            AUDIO_SET_VOLUME(wind_snd, lv)
            IF wind_t >= 2.5 THEN
                wind_state = 2 : wind_t = RANDF(3.0, 7.0)
            END IF
        ELSEIF wind_state = 2 THEN
            wind_t = wind_t - dts
            IF wind_t <= 0.0 THEN
                wind_state = 3 : wind_t = 0.0
            END IF
        ELSE
            wind_t = wind_t + dts
            DIM lo AS FLOAT
            lo = WIND_PEAK * (1.0 - wind_t / 3.5)
            IF lo < 0.0 THEN lo = 0.0
            AUDIO_SET_VOLUME(wind_snd, lo)
            IF wind_t >= 3.5 THEN
                STOPSOUND(wind_snd)
                wind_state = 0 : wind_t = RANDF(15.0, 30.0)
            END IF
        END IF
    END IF

    ' Ruhiges, langsames Flackern: zwei gemaechliche Sinus-Wellen + nur ein
    ' Hauch Zufalls-Jitter (frueher zu schnell/hektisch).
    DIM fl AS FLOAT
    fl = 0.80 + 0.13 * SIN(t * 2.4) + 0.06 * SIN(t * 5.1) + RANDF(-0.015, 0.015)
    IF fl < 0.45 THEN fl = 0.45
    IF fl > 1.15 THEN fl = 1.15

    ' --- Emission (Basisbreite skaliert mit) ---
    DIM fw AS FLOAT
    fw = FIRE_W0 * fire_scale
    DIM j AS INTEGER
    FOR j = 0 TO 3
        DIM jx AS FLOAT
        jx = RANDF(-fw, fw)
        PARTICLE_SET_POS(ps_flame, fire_x + jx, fire_y - RANDF(0.0, 10.0))
        PARTICLE_EMIT(ps_flame, INT(2.5 * fl) + 1)
        PARTICLE_SET_POS(ps_core, fire_x + jx * 0.5, fire_y)
        PARTICLE_EMIT(ps_core, 2)
    NEXT
    PARTICLE_SET_POS(ps_spark, fire_x + RANDF(-32.0, 32.0) * fire_scale, fire_y - RANDF(0.0, 40.0) * fire_scale)
    IF RANDF(0.0, 1.0) < 0.5 THEN PARTICLE_EMIT(ps_spark, 1)

    PARTICLE_UPDATE(ps_flame, dt)
    PARTICLE_UPDATE(ps_core, dt)
    PARTICLE_UPDATE(ps_spark, dt)

    ' ================= ZEICHNEN =================
    CLS(&H000000)
    IF has_bg THEN
        DRAWIMAGE(bg, IMGX, 0)
    ELSE
        BOX(fire_x - 240, 150, fire_x + 240, 660, &H3A302A)
        BOX(fire_x - 185, 230, fire_x + 185, 640, &H040302)
    END IF

    ' Warmes, mitskalierendes Flackerlicht: weicher Glow-Sprite, additiv.
    ' Zwei Lagen (grosser Hof + heisser Kern) + Flacker-Puls in Groesse/Helligkeit
    ' ergeben einen lebendigen, kantenfreien Schein statt sichtbarer Ringe.
    BLEND_MODE("add")
    DIM gx AS INTEGER
    gx = INT(fire_x)
    DIM gy AS INTEGER
    gy = INT(fire_y - 45.0 * fire_scale)
    ' grosser, sehr weicher Raum-Schein: waermt die ganze Kaminnische + pulsiert
    DIM amb AS FLOAT
    amb = (3.2 + fl * 1.0) * fire_scale
    DIM ab AS INTEGER
    ab = INT(20 + fl * 34)
    DRAWIMAGEROT(glow, gx, INT(fire_y - 70.0 * fire_scale), 0.0, amb, RGB(ab, INT(ab * 0.5), INT(ab * 0.18)))
    ' mittlerer, weicher Lichthof
    DIM halo AS FLOAT
    halo = (1.55 + fl * 0.55) * fire_scale
    DIM hb AS INTEGER
    hb = INT(55 + fl * 80)
    DRAWIMAGEROT(glow, gx, gy, 0.0, halo, RGB(hb, INT(hb * 0.55), INT(hb * 0.22)))
    ' heisser, kleinerer Kern (heller, pulsiert staerker)
    DIM core AS FLOAT
    core = (0.70 + fl * 0.30) * fire_scale
    DIM cb AS INTEGER
    cb = INT(120 + fl * 120)
    DRAWIMAGEROT(glow, gx, INT(fire_y - 28.0 * fire_scale), 0.0, core, RGB(cb, INT(cb * 0.62), INT(cb * 0.28)))
    BLEND_MODE("alpha")

    PARTICLE_DRAW(ps_flame)
    PARTICLE_DRAW(ps_core)
    PARTICLE_DRAW(ps_spark)

    TEXT(10, H - 44, "Linke Maustaste ziehen = Feuer setzen   .   Mausrad = Groesse", &HC8B080)
    TEXT(10, H - 22, "Kamin: CEllen (CC BY-SA 4.0)  .  Feuer-Sound: Glaneur de sons (CC BY 3.0)  .  ESC", &H80706A)

    FLIP()
WEND
