=== eine spalte mit verweis ins fenster ziehen gibt eine klappliste
' Die Spalte kunde verweist auf kunden: im Fenster wird sie eine Klappliste,
' die die Namen zeigt und die id bindet; das Fenster bekommt rechnungen.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, "", 8, p)
DIM x AS INTEGER
DIM y AS INTEGER
DIM fx AS INTEGER
DIM fy AS INTEGER
(x, y) = slLage(log, "knoten Daten.rechnungen.kunde")
(fx, fy) = slLage(log, "fenster")
slHin(10, 10)
slWarten(10)
slZug(x, y, fx + 30, fy + 30, 12, TRUE)
slWarten(10)
slMit([341], 83)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "felder ")
    PRINT z
NEXT
DIM j AS JSON_HANDLE : j = JSON_LOAD(p + "/Hauptfenster.dhform")
PRINT "tabelle "; JSON_GET_STRING(j, "studio_tabelle")
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(j, "widgets") - 1
    DIM w AS STRING : w = "widgets." + STR$(i)
    PRINT "  "; JSON_GET_STRING(j, w + ".kind"); " "; JSON_GET_STRING(j, w + ".name"); IIF(JSON_HAS(j, w + ".bind"), " bind=" + JSON_GET_STRING(j, w + ".bind"), ""); IIF(JSON_HAS(j, w + ".studio_quelle"), " quelle=" + JSON_GET_STRING(j, w + ".studio_quelle"), ""); IIF(JSON_HAS(j, w + ".studio_spalten"), " spalten=" + JSON_GET_STRING(j, w + ".studio_spalten"), ""); IIF(JSON_HAS(j, w + ".table.headers"), " kopf=" + JSON_STRINGIFY(JSON_GET_JSON(j, w + ".table.headers")), "")
NEXT
--- argumente
{sammlung}/../../studio/studio.dh
--- vorher
IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '', ort TEXT)")
DB_EXEC(db, "CREATE TABLE rechnungen (id INTEGER PRIMARY KEY, betrag INTEGER, kunde INTEGER)")
DB_CLOSE(db)
