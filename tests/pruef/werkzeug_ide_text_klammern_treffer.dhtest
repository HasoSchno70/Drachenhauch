=== klammern je tiefe farbig, abschaltbar
DIM prBild AS INTEGER : prBild = 0
' Punkte in Farbe f (+-25 je Kanal) in dem Zeichen von Zeile z, Spalte s.
FUNCTION prFarbe(z AS INTEGER, s AS INTEGER, f AS INTEGER) AS INTEGER
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    SAVESCREENSHOT("prbild.png")
    DIM b AS IMAGE : b = LOADIMAGE("prbild.png")
    DIM n AS INTEGER : n = 0
    DIM y AS INTEGER
    DIM x AS INTEGER
    DIM zz AS INTEGER
    DIM ss AS INTEGER
    FOR y = 0 TO SCREENHEIGHT() - 1
        FOR x = 0 TO SCREENWIDTH() - 1
            (zz, ss) = GUI_TEXTAREA_POS_AT(ta, x, y)
            IF zz <> z OR ss <> s THEN CONTINUE
            DIM c AS INTEGER : c = GETPIXEL(b, x, y)
            IF ABS(((c SHR 16) BAND 255) - ((f SHR 16) BAND 255)) < 25 AND ABS(((c SHR 8) BAND 255) - ((f SHR 8) BAND 255)) < 25 AND ABS((c BAND 255) - (f BAND 255)) < 25 THEN n = n + 1
        NEXT
    NEXT
    IMAGE_FREE(b)
    DELETEFILE("prbild.png")
    RETURN n
END FUNCTION
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
' Die Marke ans Ende von Zeile 2 -- sonst faerbt das Paar um die Marke mit.
IF prBild = 20 THEN GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 2, 3)
IF prBild = 30 THEN
    protokoll("pr aussen gold " + STR$(prFarbe(1, 6, F_KLAMMER1) > 3) + " violett " + STR$(prFarbe(1, 6, F_KLAMMER2)))
    protokoll("pr innen violett " + STR$(prFarbe(1, 7, F_KLAMMER2) > 3) + " gold " + STR$(prFarbe(1, 7, F_KLAMMER1)))
    protokoll("pr zu gold " + STR$(prFarbe(1, 10, F_KLAMMER1) > 3))
    protokoll("pr im text " + STR$(prFarbe(1, 17, F_KLAMMER1)))
    befehl("klammer_farben")
END IF
IF prBild = 36 THEN
    protokoll("pr aus gold " + STR$(prFarbe(1, 6, F_KLAMMER1)))
    EXIT(0)
END IF
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=150
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
x = f((1)) + g("(")
y

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 15) = "klammer farben " THEN PRINT L[i]
NEXT
--- erwartet
pr aussen gold TRUE violett 0
pr innen violett TRUE gold 0
pr zu gold TRUE
pr im text 0
klammer farben aus
pr aus gold 0

=== suchtreffer: nur die angehakten werden ersetzt
vorschauAn = FALSE
projektSuchen("alt", "")
protokoll("pr treffer " + STR$(GUI_LISTBOX_COUNT(lstProbleme)) + " haken " + STR$(trefferAn))
DIM prI AS INTEGER
FOR prI = 0 TO GUI_LISTBOX_COUNT(lstProbleme) - 1
    protokoll("pr zeile " + GUI_LISTBOX_ITEM(lstProbleme, prI) + " " + STR$(GUI_LISTBOX_CHECKED(lstProbleme, prI)))
NEXT
' Den zweiten Treffer (a.dh Zeile 2) abhaken.
GUI_LISTBOX_SET_CHECKED(lstProbleme, 1, FALSE)
trefferErsetzen(FALSE, "neu")
' a.dh ist offen: der Text steht im Reiter (ungesichert), b.dh auf der Platte.
DIM prZ AS STRING
FOR EACH prZ IN SPLIT$(GUI_TEXT(tabFelder[aktiverTab]), NL)
    protokoll("pr reiter |" + prZ + "|")
NEXT
' Einzeln: nur der gewaehlte Treffer (die Suche liest die Platte, dort steht
' "neu" nur in b.dh).
projektSuchen("neu", "")
GUI_LISTBOX_SET_SELECTED(lstProbleme, 0)
trefferErsetzen(TRUE, "zurueck")
' Eine andere Liste nimmt die Haken weg.
problemModus = 0
trefferNachziehen()
protokoll("pr danach haken " + STR$(trefferAn))
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- argumente
a.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei a.dh
DIM alt AS INTEGER : alt = 1
PRINT alt
--- datei b.dh
PRINT "alt"
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 15) = "treffer ersetzt" THEN PRINT L[i]
NEXT
DIM z AS STRING
FOR EACH z IN READLINES("a.dh")
    PRINT "a |"; z
NEXT
FOR EACH z IN READLINES("b.dh")
    PRINT "b |"; z
NEXT
--- erwartet
pr treffer 3 haken TRUE
pr zeile a.dh:1: DIM alt AS INTEGER : alt = 1 TRUE
pr zeile a.dh:2: PRINT alt TRUE
pr zeile b.dh:1: PRINT "alt" TRUE
treffer ersetzt 2 2
pr reiter |DIM neu AS INTEGER : neu = 1|
pr reiter |PRINT alt|
treffer ersetzt 1 1
pr danach haken FALSE
a |DIM alt AS INTEGER : alt = 1
a |PRINT alt
b |PRINT "zurueck"
