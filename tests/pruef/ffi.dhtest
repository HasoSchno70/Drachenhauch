=== gtk ueber mehrere namen, auch ohne bildschirm
' gtk_get_major_version braucht keinen Bildschirm -- so laeuft der Fall auch
' auf den Rechnern der CI, sofern dort GTK 3 liegt. Unter Windows nimmt er
' das GTK von Inkscape ueber den vollen Pfad: dessen glib und gobject liegen
' daneben und muessen ohne PATH gefunden werden.
CONST GTK = "libgtk-3-0.dll|C:/Program Files/Inkscape/bin/libgtk-3-0.dll|libgtk-3.so.0|libgtk-3.0.dylib|/opt/homebrew/lib/libgtk-3.0.dylib"
DECLARE FUNCTION gtk_get_major_version LIB GTK () AS ULONG
DECLARE FUNCTION gtk_check_version LIB GTK (gross AS ULONG, klein AS ULONG, mikro AS ULONG) AS TEXT
TRY
    PRINT gtk_get_major_version()
    PRINT "[" + gtk_check_version(3, 0, 0) + "]"
CATCH e
    IF INSTR(e, "nicht gefunden") >= 0 THEN
        PRINT "UEBERSPRINGEN: kein GTK 3 auf diesem Rechner"
    ELSE
        PRINT e
    END IF
END TRY
--- erwartet
3
[]

=== das gtk-beispiel laeuft
' examples/207_gtk.dh mit --probe: es traegt einen Namen ein, drueckt zweimal
' "Gruessen" und dann "Beenden" -- alles ueber Signale und Rueckrufe.
IMPORT "helfer.dh"
dlStarten(["run", BEISPIEL, "--", "--probe"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
END IF
--- datei helfer.dh
