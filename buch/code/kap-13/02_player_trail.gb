' Player mit Triebwerks-Trail: kontinuierliche Emission unter dem Schiff.
'
' Pro Frame:
'   - Player nach Tasten verschieben
'   - Emitter-Position auf die Schiffs-Unterseite setzen
'   - 2 Partikel emittieren
'   - Update + Draw

IMPORT "particles"

CONST WIDTH    AS INTEGER = 320
CONST HEIGHT   AS INTEGER = 240
CONST BG_COLOR AS INTEGER = &H141E3C
CONST PLAYER_C AS INTEGER = &HFFDC00

DIM player_x AS INTEGER
DIM player_y AS INTEGER
player_x = WIDTH / 2 - 20
player_y = HEIGHT - 40

DIM trail AS PARTICLE_SYSTEM
trail = PARTICLE_SYSTEM_NEW(player_x, player_y)
PARTICLE_SET_VELOCITY(trail, -10, 10, 30, 60)    ' nach unten, leicht streuend
PARTICLE_SET_LIFETIME(trail, 200, 400)
PARTICLE_SET_COLOR(trail, &HFF8800)              ' orange
PARTICLE_SET_SIZE(trail, 1, 2)
PARTICLE_SET_FADE(trail, TRUE)

SCREEN(WIDTH, HEIGHT, "Player Trail", 2)

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(KEY_LEFT)  THEN player_x = player_x - 3
    IF KEYPRESSED(KEY_RIGHT) THEN player_x = player_x + 3
    IF player_x < 0 THEN player_x = 0
    IF player_x > WIDTH - 40 THEN player_x = WIDTH - 40

    ' Trail folgt dem Player: Position auf Mitte unter dem Schiff
    PARTICLE_SET_POS(trail, player_x + 20, player_y + 24)
    PARTICLE_EMIT(trail, 2)
    PARTICLE_UPDATE(trail, 16)

    CLS(BG_COLOR)
    PARTICLE_DRAW(trail)
    BOX(player_x, player_y, player_x + 40, player_y + 24, PLAYER_C)
    FLIP()
    SLEEP(16)
WEND
