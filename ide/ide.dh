' --- Werkzeugleiste ---------------------------------------------------
' Was man am haeufigsten braucht, als Sinnbild unter dem Menue. Seit Stand
' 26 ist das EIN Widget der Laufzeit: die Leiste verteilt ihre Knoepfe
' selbst und zeichnet die Sinnbilder in ihrer Groesse -- vorher lagen hier
' zwoelf Einzelknoepfe mit 16-Punkt-Bildern, die krumm auf 20 gestreckt
' wurden, und ein Text-"|" als Trenner. Der Befehl je Eintrag steht in
' wzBefehle unter derselben Nummer.
DIM leiste AS GUI_WIDGET : leiste = GUI_TOOLBAR(win, 0, 0, 10, 34)
DIM wzBefehle AS ARRAY OF STRING : wzBefehle = []
SUB wzKnopf(sinnbild AS STRING, tip AS STRING, bef AS STRING)
    GUI_TOOLBAR_ADD(leiste, sinnbild, tr$(tip))
    ARRAY_PUSH(wzBefehle, bef)
END SUB
SUB wzTrenner()
    GUI_TOOLBAR_SEPARATOR(leiste)
    ARRAY_PUSH(wzBefehle, "")
END SUB
wzKnopf("neu", "Neue Datei (Strg+N)", "neu")
wzKnopf("oeffnen", "Öffnen (Strg+O)", "oeffnen")
wzKnopf("sichern", "Sichern (Strg+S)", "sichern")
wzTrenner()
wzKnopf("start", "Starten (F5)", "start")
wzKnopf("stopp", "Stoppen (Umschalt+F5)", "stopp")
wzKnopf("debug", "Debuggen (F7)", "debuggen")
wzKnopf("pruefen", "Prüfen (Umschalt+F7)", "pruefen")
wzTrenner()
wzKnopf("suchen", "Suchen (Strg+F)", "suchen")
wzKnopf("umbruch", "Zeilenumbruch (Alt+Z)", "umbruch")
DIM wzUmbruch AS INTEGER : wzUmbruch = LEN(wzBefehle) - 1
GUI_TOOLBAR_CHECKABLE(leiste, wzUmbruch, TRUE)
GUI_TOOLBAR_SPACER(leiste)
ARRAY_PUSH(wzBefehle, "")
wzKnopf("handbuch", "Handbuch (F1)", "handbuch")
wzKnopf("einstellungen", "Einstellungen (Strg+U)", "einstellungen")

' --- Showcase: Kacheln mit Vorschaubildern -----------------------------
' Beispiele, die zeigen, was die Sprache kann -- mit einem BILD davon,
' Titel und Kurzbeschreibung. Die Liste steht in examples/showcase.json,
' derselben Datei, aus der tools/showcase_bilder.dh die Bilder unter
' examples/screenshots/ erzeugt (und das Qt-Welcome-Panel liest). Fehlt ein
' Bild dort, entsteht es wie seit Stand 11: das Beispiel laeuft wirklich
' (`dhrt bild`), eines nach dem anderen und unsichtbar, und das Bild liegt
' danach neben der Sitzung. Ohne showcase.json gelten die acht von frueher.
CONST KACHEL_PLAETZE = 32
DIM kachelDatei AS ARRAY OF STRING : kachelDatei = []
DIM kachelName AS ARRAY OF STRING : kachelName = []
DIM kachelBeschr AS ARRAY OF STRING : kachelBeschr = []
DIM kachelBilderZahl AS ARRAY OF INTEGER : kachelBilderZahl = []
DIM kai AS INTEGER
DIM showcasePfad AS STRING : showcasePfad = PATHJOIN(beispielOrdner, "showcase.json")
IF FILEEXISTS(showcasePfad) THEN
    TRY
        DIM scListe AS JSON_HANDLE : scListe = JSON_PARSE("{""l"":" + JOIN$(READLINES(showcasePfad), CHR$(10)) + "}")
        FOR kai = 0 TO MIN(JSON_LEN(scListe, "l"), KACHEL_PLAETZE) - 1
            DIM scWo AS STRING : scWo = "l." + STR$(kai) + "."
            ARRAY_PUSH(kachelDatei, JSON_GET_STRING(scListe, scWo + "file"))
            ARRAY_PUSH(kachelName, JSON_GET_STRING(scListe, scWo + "title"))
            IF JSON_HAS(scListe, scWo + "desc") THEN ARRAY_PUSH(kachelBeschr, JSON_GET_STRING(scListe, scWo + "desc")) ELSE ARRAY_PUSH(kachelBeschr, "")
            IF JSON_HAS(scListe, scWo + "frames") THEN ARRAY_PUSH(kachelBilderZahl, JSON_GET_INT(scListe, scWo + "frames")) ELSE ARRAY_PUSH(kachelBilderZahl, 90)
        NEXT
    CATCH scFehler
        ' Eine kaputte Liste darf die IDE nicht aufhalten: dann die acht.
        kachelDatei = [] : kachelName = [] : kachelBeschr = [] : kachelBilderZahl = []
    END TRY
END IF
IF LEN(kachelDatei) = 0 THEN
    kachelDatei = ["09_shapes.dh", "10_pong.dh", "100_2d_extras.dh", "112_physics2d.dh", _
                   "154_chart.dh", "156_gui_alle_widgets.dh", "95_pbr.dh", "119_vortex.dh"]
    kachelName = ["Formen zeichnen", "Pong", "2D-Extras", "Physik", _
                  "Diagramme", "Oberflächen", "3D mit Licht", "Effekte"]
    kachelBeschr = ["", "", "", "", "", "", "", ""]
    kachelBilderZahl = [90, 90, 90, 90, 90, 90, 90, 90]
END IF
DIM kachelAnzahl AS INTEGER : kachelAnzahl = LEN(kachelDatei)
' Eine Beschreibung braucht eine eigene Zeile unter dem Titel -- ohne eine
' einzige bleibt die Kachel so hoch wie vorher.
DIM kachelMitText AS BOOLEAN : kachelMitText = FALSE
' Eine Kachel ist EIN Widget (GUI_CARD): Bild, Titel und Beschreibung, und
' ueberall darauf nimmt sie den Klick an. Bis 2026-09-21 waren es drei --
' Bild, Knopf, Beschriftung --, und nur der schmale Knopf reagierte.
DIM kachelKarte[KACHEL_PLAETZE] AS GUI_WIDGET
DIM kachelTextur[KACHEL_PLAETZE] AS IMAGE
' Weggeblaetterte Reihen (Mausrad ueber den Kacheln) und das Feld, in dem
' das Rad zaehlt -- beides setzt `layout`.
DIM kachelVersatz AS INTEGER : kachelVersatz = 0
DIM kachelReihenSichtbar AS INTEGER : kachelReihenSichtbar = 0
DIM kfX AS INTEGER : kfX = 0
DIM kfY AS INTEGER : kfY = 0
DIM kfB AS INTEGER : kfB = 0
DIM kfH AS INTEGER : kfH = 0
DIM lblKacheln AS GUI_WIDGET : lblKacheln = GUI_LABEL(win, tr$("Showcase -- ein Klick öffnet das Beispiel"), 0, 0)
FOR kai = 0 TO kachelAnzahl - 1
    kachelKarte[kai] = GUI_CARD(win, 0, 0, 10, 10, -1, kachelName[kai], kachelBeschr[kai])
    IF kachelBeschr[kai] <> "" THEN
        kachelMitText = TRUE
        GUI_TOOLTIP(kachelKarte[kai], kachelBeschr[kai] + "  (" + kachelDatei[kai] + ")")
    ELSE
        GUI_TOOLTIP(kachelKarte[kai], kachelDatei[kai])
    END IF
NEXT

' Bereiche -- die Masse setzt `layout` bei jeder Groessenaenderung.
' Der Projektbaum ist seit Stand 24 ein DATEIbaum der Laufzeit: er liest
' seinen Ordner selbst, und zwar nur die Aeste, die offen sind. Vorher stand
' hier eine Buchfuehrung aus Dateiliste und Knoten-Nummern, die bei jedem
' Aufbau auseinanderlaufen konnte.
DIM baum AS GUI_WIDGET : baum = GUI_FILETREE(win, 0, 0, 10, 10, ".")
' Rechtsklick im Projektbaum: Dateien und Ordner anlegen, umbenennen,
' loeschen. Das Menue gehoert nur dem Baum (GUI_CONTEXT_WIDGET), der
' Rechtsklick waehlt dabei die Zeile darunter.
DIM ctxBaum AS INTEGER : ctxBaum = GUI_CONTEXT(win)
DIM miBNeuDatei AS INTEGER : miBNeuDatei = GUI_MENU_ITEM(ctxBaum, tr$("Neue Datei ..."))
DIM miBNeuOrdner AS INTEGER : miBNeuOrdner = GUI_MENU_ITEM(ctxBaum, tr$("Neuer Ordner ..."))
GUI_MENU_SEPARATOR(ctxBaum)
DIM miBUmbenennen AS INTEGER : miBUmbenennen = GUI_MENU_ITEM(ctxBaum, tr$("Umbenennen ..."))
DIM miBLoeschen AS INTEGER : miBLoeschen = GUI_MENU_ITEM(ctxBaum, tr$("Löschen ..."))
GUI_MENU_SEPARATOR(ctxBaum)
DIM miBPfad AS INTEGER : miBPfad = GUI_MENU_ITEM(ctxBaum, tr$("Pfad kopieren"))
GUI_CONTEXT_WIDGET(ctxBaum, baum)
' Strg+Klick sammelt, Umschalt+Klick spannt -- damit sich mehrere Dateien
' auf einmal oeffnen lassen (Datei -> Gewaehlte Dateien oeffnen).
GUI_FILETREE_SET(baum, "mehrfachauswahl", 1)
DIM lblProjekt AS GUI_WIDGET : lblProjekt = GUI_LABEL(win, tr$("Projekt"), 0, 0)
' Filter ueber dem Baum, in der Zeile des Projektnamens -- der Baum bleibt,
' wo er war. Ein Teil des Dateinamens, Gross/klein egal; Ordner bleiben
' stehen (ihr Inhalt wird beim Aufklappen gefiltert).
DIM tfBaumFilter AS GUI_WIDGET : tfBaumFilter = GUI_TEXTINPUT(win, 0, 0, 10, 10, tr$("Filter ..."))
GUI_TOOLTIP(tfBaumFilter, tr$("Nur Dateien, deren Name das enthält"))
DIM baumFilterZuletzt AS STRING : baumFilterZuletzt = ""
DIM lblGliederung AS GUI_WIDGET : lblGliederung = GUI_LABEL(win, tr$("Gliederung"), 0, 0)
DIM lstGliederung AS GUI_WIDGET : lstGliederung = GUI_LISTBOX(win, 0, 0, 10, 10, [])
' Leer sah sie aus wie ein vergessenes Feld.
GUI_LISTBOX_PLACEHOLDER(lstGliederung, tr$("Keine Unterprogramme"))
' Willkommensseite -- sie steht dort, wo sonst die Code-Felder liegen, und
' verschwindet mit dem ersten Reiter.
DIM lblWkTitel AS GUI_WIDGET : lblWkTitel = GUI_LABEL(win, tr$("Drachenhauch"), 0, 0)
GUI_SET_FONT_SIZE(lblWkTitel, 34)
' Ein Bild vorab so verkleinert, dass es in b x h passt, OHNE es zu
' verzerren -- der Kasten bleibt, das Bild steht in seiner Mitte.
FUNCTION bildEingepasst(pfad AS STRING, b AS INTEGER, h AS INTEGER) AS IMAGE
    DIM roh AS IMAGE : roh = LOADIMAGE(pfad)
    DIM f AS FLOAT : f = MIN(b / IMAGEWIDTH(roh), h / IMAGEHEIGHT(roh))
    RETURN IMAGE_SCALE(roh, MAX(1, INT(IMAGEWIDTH(roh) * f + 0.5)), MAX(1, INT(IMAGEHEIGHT(roh) * f + 0.5)))
END FUNCTION

' Der Schriftzug statt des Titels -- vorab auf seine Anzeigegroesse gebracht:
' 1200 Punkte breit beim Zeichnen auf ein Fuenftel gestaucht flimmerten die
' feinen Linien. Ohne Bilddatei bleibt der Titel als Text.
CONST WK_BILD_B = 240
CONST WK_BILD_H = 112
DIM wkSchriftzug AS BOOLEAN : wkSchriftzug = FILEEXISTS(PATHJOIN(bilderOrdner, "schriftzug.png"))
DIM imgWkTitel AS GUI_WIDGET
IF wkSchriftzug THEN
    imgWkTitel = GUI_IMAGE(win, 0, 0, WK_BILD_B, WK_BILD_H, bildEingepasst(PATHJOIN(bilderOrdner, "schriftzug.png"), WK_BILD_B, WK_BILD_H))
    GUI_IMAGE_MODE(imgWkTitel, "mitte")
    GUI_TOOLTIP(imgWkTitel, tr$("Drachenhauch ") + VERSION$())
    GUI_SET_VISIBLE(lblWkTitel, FALSE)
    protokoll("schriftzug")
END IF
DIM lblWkUnter AS GUI_WIDGET : lblWkUnter = GUI_LABEL(win, tr$("BASIC für Spiele -- mit Pascal-strikter Typisierung und OOP. Diese IDE ist selbst in Drachenhauch geschrieben."), 0, 0)
DIM btnWkNeu AS GUI_WIDGET : btnWkNeu = GUI_BUTTON(win, tr$("Neue Datei"), 0, 0, 130, 30)
GUI_BUTTON_VARIANT(btnWkNeu, "primaer")
DIM btnWkOeffnen AS GUI_WIDGET : btnWkOeffnen = GUI_BUTTON(win, tr$("Datei öffnen ..."), 0, 0, 150, 30)
DIM btnWkBeispiele AS GUI_WIDGET : btnWkBeispiele = GUI_BUTTON(win, tr$("Beispiele als Projekt"), 0, 0, 180, 30)
DIM btnWkThemen AS GUI_WIDGET : btnWkThemen = GUI_BUTTON(win, tr$("Beispiele nach Themen"), 0, 0, 190, 30)
DIM lblWkZuletzt AS GUI_WIDGET : lblWkZuletzt = GUI_LABEL(win, tr$("Zuletzt geöffnet -- Doppelklick öffnet"), 0, 0)
DIM lstWkZuletzt AS GUI_WIDGET : lstWkZuletzt = GUI_LISTBOX(win, 0, 0, 10, 10, [])
DIM lblWkKuerzel AS GUI_WIDGET : lblWkKuerzel = GUI_LABEL(win, tr$("F5 startet das Programm, F7 debuggt es, Umschalt+F7 prüft. F1 schlägt das Wort unter der Marke im Handbuch nach, Strg+Umschalt+P öffnet die Befehlspalette, Strg+Umschalt+O eine Datei des Projekts. Alle Kürzel: Hilfe -> Tastenkürzel (Strg+F1)."), 0, 0)
' Uebersichtskarte: eine Zeichenflaeche rechts neben dem Code -- gezeichnet
' wird nach GUI_DRAW, wie bei jeder Leinwand.
' Symbolspur ueber dem Code: Datei > Klasse > Unterprogramm. Sie sagt,
' WO man ist, wenn der Kopf des Blocks schon aus dem Bild gerollt ist.
DIM lblSpur AS GUI_WIDGET : lblSpur = GUI_BREADCRUMB(win, 0, 0, 10, 20)
DIM karte AS GUI_WIDGET : karte = GUI_CANVAS(win, 0, 0, 10, 10)
GUI_SET_VISIBLE(karte, FALSE)
GUI_SET_CURSOR(karte, "hand")
GUI_TOOLTIP(karte, tr$("Klicken oder ziehen: dorthin rollen"))
' Ein Zug ueber die Karte: solange die Taste haengt, folgt der Ausschnitt.
DIM kartenZug AS BOOLEAN : kartenZug = FALSE
DIM kartenZiel AS INTEGER : kartenZiel = -1
DIM lblAusgabe AS GUI_WIDGET : lblAusgabe = GUI_LABEL(win, "", 0, 0)   ' der Reiterknopf sagt schon "Ausgabe"
DIM lstAusgabe AS GUI_WIDGET : lstAusgabe = GUI_LISTBOX(win, 0, 0, 10, 10, [])
' Nur passende Zeilen zeigen (Teiltext, Gross/klein egal); die Zeilen selbst
' bleiben, leer zeigt wieder alle.
DIM tfAusgabeFilter AS GUI_WIDGET : tfAusgabeFilter = GUI_TEXTINPUT(win, 0, 0, 10, 10, tr$("Filter ..."))
GUI_TOOLTIP(tfAusgabeFilter, tr$("Nur Zeilen der Ausgabe zeigen, die diesen Text enthalten"))
DIM ausgabeFilterAlt AS STRING : ausgabeFilterAlt = ""
DIM ctxAusgabe AS INTEGER : ctxAusgabe = GUI_CONTEXT(win)
DIM miAZeile AS INTEGER : miAZeile = GUI_MENU_ITEM(ctxAusgabe, tr$("Zeile kopieren"))
DIM miAKopieren AS INTEGER : miAKopieren = GUI_MENU_ITEM(ctxAusgabe, tr$("Angezeigte Zeilen kopieren"))
DIM miASichern AS INTEGER : miASichern = GUI_MENU_ITEM(ctxAusgabe, tr$("Ausgabe sichern ..."))
GUI_MENU_SEPARATOR(ctxAusgabe)
DIM miALeeren AS INTEGER : miALeeren = GUI_MENU_ITEM(ctxAusgabe, tr$("Ausgabe leeren"))
GUI_CONTEXT_WIDGET(ctxAusgabe, lstAusgabe)
' Terminal (Alt+3): dieselbe Flaeche wie die Ausgabe, zwei Reiterknoepfe
' darueber schalten um. Die Eingabezeile unten gehoert dann dem Terminal.
DIM lstTerminal AS GUI_WIDGET : lstTerminal = GUI_LISTBOX(win, 0, 0, 10, 10, [])
GUI_LISTBOX_PLACEHOLDER(lstTerminal, tr$("Befehl unten eingeben, Enter führt ihn aus -- cd, dir/ls, git, dhrt ..."))
GUI_SET_VISIBLE(lstTerminal, FALSE)
DIM btnReiterAusgabe AS GUI_WIDGET : btnReiterAusgabe = GUI_BUTTON(win, tr$("Ausgabe"), 0, 0, 90, 20)
DIM btnReiterTerminal AS GUI_WIDGET : btnReiterTerminal = GUI_BUTTON(win, tr$("Terminal"), 0, 0, 90, 20)
GUI_TOOLTIP(btnReiterTerminal, tr$("Terminal (Alt+3)"))
DIM btnTermStopp AS GUI_WIDGET : btnTermStopp = GUI_BUTTON(win, tr$("Abbrechen"), 0, 0, 90, 20)
GUI_BUTTON_VARIANT(btnTermStopp, "gefahr")
GUI_SET_VISIBLE(btnTermStopp, FALSE)
' Hier oben, weil layout() sie liest -- es laeuft vor dem Terminal-Abschnitt.
DIM terminalAn AS BOOLEAN : terminalAn = FALSE
DIM termProz AS INTEGER : termProz = -1
DIM lblProbleme AS GUI_WIDGET : lblProbleme = GUI_LABEL(win, tr$("Probleme"), 0, 0)
DIM lstProbleme AS GUI_WIDGET : lstProbleme = GUI_LISTBOX(win, 0, 0, 10, 10, [])
GUI_LISTBOX_PLACEHOLDER(lstProbleme, tr$("Keine Probleme gefunden"))
' Unter den Problemen steht die Hilfe zum Wort unter der Schreibmarke. Leer
' sah der Streifen wie ein Lagefehler aus -- darum ein eigener Kopf und ein
' Hinweis, solange es nichts zu sagen gibt.
DIM lblHilfeKopf AS GUI_WIDGET : lblHilfeKopf = GUI_LABEL(win, tr$("Hilfe zum Wort unter der Schreibmarke"), 0, 0)
DIM lblHilfe AS GUI_WIDGET : lblHilfe = GUI_LABEL(win, "", 0, 0)
CONST HILFE_LEER = "Schreibmarke auf einen Befehl oder Namen stellen -- hier steht dann, was er tut und wie er aufgerufen wird."
GUI_SET_TEXT(lblHilfe, tr$(HILFE_LEER))
' Statusleiste mit Feldern (seit Stand 28): links die Meldung, rechts die
' Stelle der Marke und der Umbruch -- beide anklickbar. Bis dahin schrieb
' die IDE alles in EINE Beschriftung, und jeder Pfeil ueberschrieb die
' letzte Meldung mit "Zeile, Spalte". GUI_SET_TEXT meint weiter das erste Feld.
DIM lblStatus AS GUI_WIDGET : lblStatus = GUI_STATUSBAR(win, 0, 0, 10, 24, tr$("Bereit."))
DIM sfPos AS INTEGER : sfPos = GUI_STATUSBAR_ADD(lblStatus, tr$("Zeile 1, Spalte 1"), 150, "mitte")
