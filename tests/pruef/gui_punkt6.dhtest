' Aus test_gui_punkt6.py uebertragen (16 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== senkrechter schieber waechst nach oben (1)
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM f AS INTEGER
FOR f = 1 TO 2
    GUI_UPDATE()
    PRINT "O " + STR$(GUI_CANVAS_X(nullpunkt)) + " " + STR$(GUI_CANVAS_Y(nullpunkt))
    GUI_DRAW()
    FLIP()
NEXT
--- umgebung
DHRT_FRAMES=3
--- erwartet
O 1 1
O 1 1

