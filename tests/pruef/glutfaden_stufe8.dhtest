NEXT
FOR EACH n IN [0, 1, 30, 31, 150, 151]
    ARRAY_PUSH(z, "rueck " + STR$(n) + " " + STR$(kern.punkteRueck(n)))
NEXT
FOR n = 0 TO 12
    ARRAY_PUSH(z, "stufe " + STR$(n) + " " + kern.stufeFuer$(n))
NEXT
PRINT geAbweichungen$(geLies$("ref.txt"), JOIN$(z, CHR$(10)))
