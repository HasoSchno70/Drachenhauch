=== comp over array (1)
DIM nums[4] AS INTEGER
nums[0] = 10 : nums[1] = 20 : nums[2] = 30 : nums[3] = 40
DIM tripled AS TUPLE
tripled = [n * 3 FOR n IN nums]
PRINT tripled
--- erwartet
