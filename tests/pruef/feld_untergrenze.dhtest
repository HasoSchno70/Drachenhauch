=== obergrenze unter der untergrenze
DIM a[5 TO 3] AS INTEGER
--- fehler
DIM: in Dimension 1 liegt die Obergrenze 3 unter der Untergrenze 5

=== grenzen muessen ganzzahlen sein
DIM a[1.5 TO 3] AS INTEGER
--- fehler
DIM: die Grenzen eines Feldes muessen INTEGER sein

=== feld von structs bleibt ab 0
STRUCT Punkt LAYOUT C
    x AS LONG
END STRUCT
DIM p[1 TO 3] AS Punkt
--- fehler
ein Feld von Structs liegt wie in C und zaehlt ab 0

=== runde klammern nennen die form mit untergrenze
DIM a(1 TO 10) AS INTEGER
--- fehler
mit eigener Untergrenze DIM a[1 TO 10]

=== klassenfeld braucht feste grenzen
DIM n AS INTEGER
CLASS K
    DIM a[1 TO n] AS INTEGER
END CLASS
--- fehler
braucht konstante INTEGER-Grenzen

=== ein dhc von 2026.38 ohne das neue argument laeuft unveraendert
' Die Beilage hat dhrt 2026.38 aus diesem Programm geschrieben:
' CLASS K
'     DIM w[2] AS INTEGER
' END CLASS
' DIM a[3] AS INTEGER
' a[2] = 7
' DIM k AS K
' k = NEW K()
' k.w[1] = 4
' PRINT a[2] + k.w[1], LEN(a), LBOUND(a)
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 30000 AND leer < 5
        DIM teil AS STRING : teil = PROCESS_READ$(p)
        IF teil <> "" THEN
            aus = aus + teil
            leer = 0
        ELSEIF NOT PROCESS_RUNNING(p) THEN
            leer = leer + 1
        END IF
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
DIM p AS INTEGER : p = PROCESS_START("dhrt", CWD$() + "/alt.dhc")
PRINT TRIM$(lauf$(p))
