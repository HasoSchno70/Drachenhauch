' Das Referenzbuch gegen sich selbst: Struktur, Querverweise, Kapitelnummern.
'
' Die Kapitel sind JavaScript-Module; zwei Werkzeuge unter tools/ exportieren
' daraus JSON (`buch_struktur_export.js`, `buch_verweise_export.js`), und
' dieser Test stellt die Fragen an das Ergebnis. Ohne Node laesst sich das
' Buch gar nicht lesen -- dann meldet der Fall `UEBERSPRINGEN: node fehlt`
' und gilt als uebersprungen, wie die pytest-Fassung, die sich dort uebersprang.
'
' Bis 2026-09-16 tests/test_buch_struktur.py und tests/test_buch_verweise.py.

=== die struktur des referenzbuchs stimmt
IMPORT "helfer.dh"
IMPORT "json"
DIM wurzel AS STRING : wurzel = ARG$(0)
IF NOT nodeDa() THEN
    PRINT "UEBERSPRINGEN: node fehlt"
    EXIT(0)
END IF
DIM roh AS STRING : roh = nodeLauf$(wurzel, wurzel + "/tools/buch_struktur_export.js")
IF roh = "" THEN
    PRINT "UEBERSPRINGEN: node fehlt"
    EXIT(0)
END IF
DIM h AS JSON_HANDLE : h = JSON_PARSE(roh)
' Ohne diese Schranke liefen alle Pruefungen bei einem kaputten Export leer
' durch und meldeten Erfolg.
PRINT "genug kapitel "; (JSON_GET_INT(h, "kapitel") > 50)
' H.tip(TITEL, text) -- mit nur einem Argument wird der Text zur Ueberschrift
' und ganz fett gesetzt.
PRINT "tips ohne rumpf "; JSON_LEN(h, "tips_ohne_rumpf")
PRINT "befehle ohne text "; JSON_LEN(h, "cmds_ohne_text")
PRINT "befehle ohne signatur "; JSON_LEN(h, "cmds_ohne_sig")
' Eine Ueberschrift ueber 70 Zeichen ist meist ein verrutschter Absatz.
PRINT "zu lange zwischenueberschriften "; JSON_LEN(h, "lange_h2")
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/nodelauf.dh"
--- erwartet
genug kapitel TRUE
tips ohne rumpf 0
befehle ohne text 0
befehle ohne signatur 0
zu lange zwischenueberschriften 0

=== jeder querverweis trifft ein kapitel
' Das Buch nummeriert seine Kapitel NICHT -- die Ueberschrift ist der Titel.
' Beim Gegenlesen am 2026-08-30 zeigten zwei Titel-Verweise auf gar kein
' Kapitel ("Strings" statt "Strings im Detail"). Ein Verweis ins Leere sieht
' im gesetzten Buch aus wie jeder andere.
IMPORT "helfer.dh"
IMPORT "json"
DIM wurzel AS STRING : wurzel = ARG$(0)
IF NOT nodeDa() THEN
    PRINT "UEBERSPRINGEN: node fehlt"
    EXIT(0)
END IF
DIM roh AS STRING : roh = nodeLauf$(wurzel, wurzel + "/tools/buch_verweise_export.js")
IF roh = "" THEN
    PRINT "UEBERSPRINGEN: node fehlt"
    EXIT(0)
END IF
DIM h AS JSON_HANDLE : h = JSON_PARSE(roh)
PRINT "genug kapitel "; (JSON_LEN(h, "titel") > 50)
PRINT "genug verweise "; (JSON_LEN(h, "verweise") > 20)
DIM titel AS MAP OF BOOLEAN
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(h, "titel") - 1
    MAPPUT(titel, JSON_GET_STRING(h, "titel." + STR$(i)), TRUE)
NEXT
DIM tot AS INTEGER : tot = 0
FOR i = 0 TO JSON_LEN(h, "verweise") - 1
    DIM ziel AS STRING : ziel = JSON_GET_STRING(h, "verweise." + STR$(i) + ".ziel")
    IF NOT MAPHAS(titel, ziel) THEN
        tot = tot + 1
        PRINT "ins leere: "; JSON_GET_STRING(h, "verweise." + STR$(i) + ".datei"); ": "; ziel
    END IF
NEXT
PRINT "verweise ins leere "; tot
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/nodelauf.dh"
--- erwartet
genug kapitel TRUE
genug verweise TRUE
verweise ins leere 0

=== kein verweis nennt eine kapitelnummer
' Nummern zeigen ins Nichts -- der Leser sieht sie nirgends. Beim Gegenlesen
' standen 20 solche Stellen im Buch; es waren die DATEInummern der Quelle.
IMPORT "regex"
DIM inhalt AS STRING : inhalt = ARG$(0) + "/buch-referenz/buch/content"
DIM dateien AS ARRAY OF STRING : dateien = DIRLIST(inhalt, "*.js")
DIM treffer AS INTEGER : treffer = 0
DIM i AS INTEGER
FOR i = 0 TO LEN(dateien) - 1
    DIM text AS STRING : text = JOIN$(READLINES(inhalt + "/" + dateien[i]), CHR$(10))
    DIM gefunden AS ARRAY OF STRING : gefunden = REGEX_FIND_ALL(text, "Kapitel \d+")
    DIM k AS INTEGER
    FOR k = 0 TO LEN(gefunden) - 1
        treffer = treffer + 1
        PRINT "nummer: "; dateien[i]; ": "; gefunden[k]
    NEXT
NEXT
PRINT "geprueft "; (LEN(dateien) > 50)
PRINT "kapitelnummern "; treffer
--- argumente
{sammlung}/../..
--- erwartet
geprueft TRUE
kapitelnummern 0

=== alle codebloecke des buches uebersetzen
' `pruef_codebloecke.js` schickt jeden Block durch `dhrt --check`. Ein
' Tippfehler im Buch faellt sonst erst dem Leser auf, der ihn abtippt.
IMPORT "helfer.dh"
DIM buch AS STRING : buch = ARG$(0) + "/buch-referenz/buch"
IF NOT nodeDa() THEN
    PRINT "UEBERSPRINGEN: node fehlt"
    EXIT(0)
END IF
nlStarten(buch, buch + "/pruef_codebloecke.js")
PRINT "rueckgabe "; nlCode
PRINT "ohne befund "; (INSTR(nlAus, "0 mit Befund") >= 0)
' Schranke gegen den leeren Lauf: ohne sie meldete ein kaputter Sammler
' Erfolg, weil er nichts zu pruefen fand.
PRINT "genug bloecke "; (zahlVor(nlAus, "Codebloecke") > 800)
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/nodelauf.dh"
--- erwartet
rueckgabe 0
ohne befund TRUE
genug bloecke TRUE

=== die behaupteten ausgaben des buches stimmen
' `pruef_ausgaben.js` FUEHRT die Bloecke aus und vergleicht mit der
' `{ out: [...] }`-Angabe. Die stand fuer 332 Bloecke im Buch und war nie
' nachgemessen -- sieben davon waren falsch (LEN("Drachenhauch") als 9).
IMPORT "helfer.dh"
DIM buch AS STRING : buch = ARG$(0) + "/buch-referenz/buch"
IF NOT nodeDa() THEN
    PRINT "UEBERSPRINGEN: node fehlt"
    EXIT(0)
END IF
nlStarten(buch, buch + "/pruef_ausgaben.js")
PRINT "rueckgabe "; nlCode
PRINT "ohne befund "; (INSTR(nlAus, "0 mit Befund") >= 0)
' Die Schranke faengt den LEEREN Lauf, sie nagelt die Zahl nicht fest: die CI
' baut dhrt ohne Grafik und ohne Hardware-Module, dort faellt mehr als
' Bruchstueck weg. Auf dieser Maschine sind es 212.
PRINT "genug ausgefuehrt "; (zahlVor(nlAus, "ausgefuehrt") > 100)
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/nodelauf.dh"
--- erwartet
rueckgabe 0
ohne befund TRUE
genug ausgefuehrt TRUE

=== der signaturleser liest die bekannten formen
' Bis 2026-09-17 tests/test_buch_signaturen.py. Der Leser selbst -- sonst
' faellt eine Regression im Abgleich unten stumm aus.
IMPORT "helfer.dh"
PRINT arity$("MID$(s$, start[, n])")
PRINT arity$("ARC(6..8 Argumente)")
PRINT arity$("GUI_SPLITTER(7 Argumente)")
PRINT arity$("GUI_TOGGLE(win, text: STRING, x, y, an: BOOLEAN = FALSE)")
PRINT arity$("RND()        RND(n)")
PRINT arity$("SCREENWIDTH()")
PRINT "["; arity$("PLOTS(xs, ys, farbe, ...)"); "]"
PRINT arity$("LEN(s$) → INTEGER")
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/signatur.dh"
--- erwartet
2,3
6,8
7,7
4,5
0,1
0,0
[]
1,1

=== der zerleger trennt sammel-eintraege
' Das Buch fasst verwandte Befehle in EINEM Eintrag zusammen. Ohne Zerlegung
' blieben solche Eintraege ungeprueft -- darin steckte am 2026-08-30 ein
' Fehler (TEMPFILE$ mit der Endung als erstem Argument). Alternativen desselben
' Befehls ergeben eine Spanne; eine Familie hinter dem Schraegstrich zaehlt
' nicht, vor ihrer Klammer steht nur das letzte Stueck des Namens.
IMPORT "helfer.dh"
DIM bekannt AS MAP OF BOOLEAN
MAPPUT(bekannt, "TEMPDIR$", TRUE)
MAPPUT(bekannt, "TEMPFILE$", TRUE)
MAPPUT(bekannt, "RANGE", TRUE)
MAPPUT(bekannt, "ECS_FILL_FLOAT", TRUE)
' INT ist ein echter Befehl -- ohne die Schraegstrich-Regel wuerde die Familie
' unten als INT(w, ziel$, wert) mit drei Argumenten geprueft.
MAPPUT(bekannt, "INT", TRUE)
DIM z AS ARRAY OF STRING : z = formenJeBefehl("TEMPDIR$()   TEMPFILE$([praefix$[, endung$]])", bekannt)
DIM i AS INTEGER
FOR i = 0 TO LEN(z) - 1
    PRINT z[i]
NEXT
z = formenJeBefehl("RANGE(ende)   RANGE(start, ende)", bekannt)
PRINT z[0]; " -> "; arity$(MID$(z[0], INSTR(z[0], "|") + 1))
PRINT "familie "; LEN(formenJeBefehl("ECS_FILL_FLOAT/INT(w, ziel$, wert)", bekannt))
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/signatur.dh"
--- erwartet
TEMPDIR$|TEMPDIR$()
TEMPFILE$|TEMPFILE$([praefix$[, endung$]])
RANGE|RANGE(ende)   RANGE(start, ende) -> 1,2
familie 0

=== die signaturen im buch passen zum index
' Das Buch fuehrt jeden Befehl mit seiner Aufrufform. Die altert still: beim
' Abgleich am 2026-08-30 fehlte sechsmal ein spaeter ergaenztes Argument.
' Verglichen wird nur die ARGUMENTZAHL -- die Namen sind im Buch bewusst
' deutsch und erklaerend.
IMPORT "helfer.dh"
IMPORT "json"
DIM wurzel AS STRING : wurzel = ARG$(0)
IF NOT nodeDa() THEN
    PRINT "UEBERSPRINGEN: node fehlt"
    EXIT(0)
END IF
DIM roh AS STRING : roh = nodeLauf$(wurzel, wurzel + "/tools/buch_sig_export.js")
IF roh = "" THEN
    PRINT "UEBERSPRINGEN: Buch-Export fehlgeschlagen"
    EXIT(0)
END IF
DIM buch AS JSON_HANDLE : buch = JSON_PARSE("{""e"":" + roh + "}")
' Ohne diese Schranke liefe der Vergleich bei einem kaputten Export leer durch.
PRINT "genug eintraege "; (JSON_LEN(buch, "e") > 500)
DIM idx AS JSON_HANDLE : idx = JSON_LOAD(wurzel + "/daten/builtin_index.json")
DIM bekannt AS MAP OF BOOLEAN
DIM sigs AS MAP OF STRING
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(idx, "builtins") - 1
    DIM p AS STRING : p = "builtins." + STR$(i)
    IF NOT JSON_HAS(idx, p + ".name") THEN CONTINUE
    DIM nm AS STRING : nm = UPPER$(JSON_GET_STRING(idx, p + ".name"))
    IF nm = "" THEN CONTINUE
    MAPPUT(bekannt, nm, TRUE)
    IF JSON_HAS(idx, p + ".signature") THEN MAPPUT(sigs, nm, JSON_GET_STRING(idx, p + ".signature")) ELSE MAPPUT(sigs, nm, "")
NEXT
DIM geprueft AS INTEGER : geprueft = 0
DIM befund AS INTEGER : befund = 0
FOR i = 0 TO JSON_LEN(buch, "e") - 1
    DIM sig AS STRING : sig = JSON_GET_STRING(buch, "e." + STR$(i) + ".sig")
    IF TRIM$(sig) = "" THEN CONTINUE
    DIM formen AS ARRAY OF STRING : formen = formenJeBefehl(sig, bekannt)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(formen) - 1
        DIM name AS STRING : name = LEFT$(formen[k], INSTR(formen[k], "|"))
        DIM form AS STRING : form = MID$(formen[k], INSTR(formen[k], "|") + 1)
        DIM imBuch AS STRING : imBuch = arity$(form)
        DIM imIndex AS STRING : imIndex = arity$(MAPGET(sigs, name))
        IF imBuch = "" OR imIndex = "" THEN CONTINUE
        geprueft = geprueft + 1
        IF imBuch <> imIndex THEN
            befund = befund + 1
            PRINT name; " ("; JSON_GET_STRING(buch, "e." + STR$(i) + ".datei"); "): Buch "; imBuch; " -- Index "; imIndex
            PRINT "    Buch : "; TRIM$(form)
            PRINT "    Index: "; MAPGET(sigs, name)
        END IF
    NEXT
NEXT
PRINT "genug verglichen "; (geprueft > 500)
PRINT "abweichungen "; befund
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/nodelauf.dh"
IMPORT "{sammlung}/_hilfen/signatur.dh"
--- erwartet
genug eintraege TRUE
genug verglichen TRUE
abweichungen 0
