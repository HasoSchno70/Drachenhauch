=== das kaestchen einer haken-zelle ist im hellen thema hell
IMPORT "gui"
SCREEN(320, 160, "H", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_THEME_PRESET("light")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("H", 0, 0, 320, 160)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TABLE(w, 10, 10, 300, 140)
GUI_TABLE_HEADERS(t, ["Name", "Aktiv"])
GUI_TABLE_COL_ALIGN(t, 1, "mitte")
GUI_TABLE_ADD_ROW(t, ["Müller", ""])
GUI_TABLE_CELL_KIND(t, 0, 1, "haken")
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(RGB(200, 200, 200))
    GUI_DRAW()
    FLIP()
WEND
--- bild
