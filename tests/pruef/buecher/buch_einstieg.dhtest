=== die behaupteten ausgaben stimmen
' Die Schranke faengt den LEEREN Lauf: die meisten Beispiele oeffnen ein
' Fenster, uebrig bleiben die Konsolen-Beispiele.
IMPORT "helfer.dh"
buchWerkzeug(ARG$(0), "pruef_ausgaben.js")
PRINT "rueckgabe "; nlCode
PRINT "genug ausgefuehrt "; (zahlVor(nlAus, "ausgefuehrt") >= 5)
IF nlCode <> 0 THEN PRINT nlAus; nlErr
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/einstieg.dh"
--- erwartet
rueckgabe 0
genug ausgefuehrt TRUE

=== die zahlen ueber die anderen baende stimmen
' Anhang C nennt die Kapitelzahlen der Nachbarbaende von Hand -- und die
' veralten, sobald einer waechst. Am 2026-08-30 stand das Lehrbuch mit 75 statt
' 84 Kapiteln da, Galaga mit 12 statt 13. Im Lehrbuch zaehlen Vorwort und
' Anhaenge mit: die Angabe meint alle Kapiteldateien.
IMPORT "regex"
DIM w AS STRING : w = ARG$(0)
DIM anhang AS STRING : anhang = BUFFER_TO_STRING$(READALL_BYTES(w + "/buch-einstieg/buch/content/36_anhang_c_weiter.js"))
DIM q AS STRING : q = CHR$(34)
DIM ist AS ARRAY OF INTEGER
ist = [LEN(DIRLIST(w + "/buch-referenz/buch/content", "*.js")), _
       LEN(REGEX_FIND_ALL(BUFFER_TO_STRING$(READALL_BYTES(w + "/buch-galaga/buch/build_book.js")), "chapter\(" + q + "Kapitel \d+:")), _
       LEN(REGEX_FIND_ALL(BUFFER_TO_STRING$(READALL_BYTES(w + "/buch-tippspiel/buch/build_book.js")), "chapter\(" + q + "Kapitel \d+:"))]
DIM namen AS ARRAY OF STRING : namen = ["Lehrbuch", "Galaga", "Tippspiel"]
DIM muster AS ARRAY OF STRING : muster = ["die ganze Sprache, (\d+) Kapitel", "Arcade-Shooter in (\d+) Kapiteln", "Rangliste in (\d+) Kapiteln"]
DIM i AS INTEGER
FOR i = 0 TO 2
    DIM t AS ARRAY OF STRING : t = REGEX_FIND_ALL(anhang, muster[i])
    IF LEN(t) = 0 THEN
        PRINT namen[i]; ": Angabe nicht mehr gefunden -- Muster anpassen"
    ELSEIF VAL(t[0]) <> ist[i] THEN
        PRINT namen[i]; ": Anhang C nennt "; t[0]; ", gezaehlt sind "; ist[i]
    ELSE
        PRINT namen[i]; " stimmt"
    END IF
NEXT
--- argumente
{sammlung}/../..
--- erwartet
Lehrbuch stimmt
Galaga stimmt
Tippspiel stimmt
