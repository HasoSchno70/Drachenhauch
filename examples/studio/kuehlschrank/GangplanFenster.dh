' Einen Gangplan bearbeiten -- wie StoreLayoutEditDialog der Python-App: je
' Abteilung ihr Gang (in der Tabelle änderbar, 1 bis 50), ✖ entfernt sie,
' unten kommt eine neue dazu. Gespeichert wird als eigener Plan
' (store_layouts); ein eingebauter Markt behält seinen eingebauten dahinter.
' Ein Plan ohne Abteilung lässt sich nicht speichern (dort ging es, und der
' Markt hatte danach keinen Plan mehr, den man öffnen konnte).
CLASS GangplanFenster EXTENDS GangplanFenster_Basis
    DIM markt AS STRING
    DIM gesichert AS BOOLEAN

    SUB Geoeffnet()
        GUI_SET_TEXT(Self.titel, trf$("🏪 {0} -- Gang-Zuordnungen", [Self.markt]))
        GUI_TABLE_COL_TYPE(Self.tabelle, SP_G_GANG, "zahl")
        GUI_TABLE_COL_EDIT(Self.tabelle, SP_G_GANG, TRUE)
        ' Nach Gang (wie sorted(..., key=Gang)), gleiche in ihrer Reihenfolge.
        DIM plan AS ARRAY OF STRING : plan = gangplan(Self.markt)
        DIM g AS INTEGER
        FOR g = 0 TO gangZahl(plan)
            DIM e AS STRING
            FOR EACH e IN plan
                DIM f AS ARRAY OF STRING : f = SPLIT(e, "=")
                IF INT(VAL(f[1])) = g THEN Self.zeileDazu(f[0], g)
            NEXT
        NEXT
        GUI_SET_VALUE(Self.neuGang, 1)
        GUI_FOCUS(Self.neuFeld)
    END SUB

    SUB zeileDazu(abteilung AS STRING, gang AS INTEGER)
        DIM z AS INTEGER : z = GUI_TABLE_ADD_ROW(Self.tabelle, [abteilung, STR$(gang), "✖"])
        GUI_TABLE_CELL_KIND(Self.tabelle, z, SP_G_WEG, "knopf")
    END SUB

    FUNCTION abteilungen() AS ARRAY OF STRING
        DIM aus AS ARRAY OF STRING : aus = []
        DIM z AS INTEGER
        FOR z = 0 TO GUI_TABLE_ROW_COUNT(Self.tabelle) - 1
            ARRAY_PUSH(aus, GUI_TABLE_GET_CELL(Self.tabelle, z, SP_G_NAME))
        NEXT
        RETURN aus
    END FUNCTION

    SUB tabelle_Zelle(zeile AS INTEGER, spalte AS INTEGER)
        IF spalte = SP_G_WEG THEN GUI_TABLE_REMOVE_ROW(Self.tabelle, zeile)
    END SUB

    SUB neuFeld_Enter()
        Self.knopfNeu_Klick()
    END SUB

    SUB knopfNeu_Klick()
        DIM a AS STRING : a = TRIM$(GUI_TEXT(Self.neuFeld))
        IF a = "" THEN RETURN
        DIM x AS STRING
        FOR EACH x IN Self.abteilungen()
            IF LOWER$(x) = LOWER$(a) THEN
                Meldung(trf$("„{0}“ gibt es schon.", [a]), tr$("Gangplan"))
                RETURN
            END IF
        NEXT
        Self.zeileDazu(a, grenzen(INT(GUI_VALUE(Self.neuGang)), 1, 50))
        GUI_SET_TEXT(Self.neuFeld, "")
        GUI_FOCUS(Self.neuFeld)
    END SUB

    ' "Abteilung=Gang" je Zeile, wie get_layout.
    FUNCTION plan() AS ARRAY OF STRING
        DIM aus AS ARRAY OF STRING : aus = []
        DIM z AS INTEGER
        FOR z = 0 TO GUI_TABLE_ROW_COUNT(Self.tabelle) - 1
            DIM g AS INTEGER : g = grenzen(INT(VAL(GUI_TABLE_GET_CELL(Self.tabelle, z, SP_G_GANG))), 1, 50)
            ARRAY_PUSH(aus, GUI_TABLE_GET_CELL(Self.tabelle, z, SP_G_NAME) + "=" + STR$(g))
        NEXT
        RETURN aus
    END FUNCTION

    SUB knopfSpeichern_Klick()
        DIM p AS ARRAY OF STRING : p = Self.plan()
        IF LEN(p) = 0 THEN
            Meldung(tr$("Ein Gangplan braucht mindestens eine Abteilung."), tr$("Gangplan"))
            RETURN
        END IF
        planSpeichern(Self.markt, p)
        Self.gesichert = TRUE
        Self.Zumachen()
    END SUB

    SUB knopfAbbrechen_Klick()
        Self.Zumachen()
    END SUB
END CLASS

CONST SP_G_NAME = 0
CONST SP_G_GANG = 1
CONST SP_G_WEG = 2
