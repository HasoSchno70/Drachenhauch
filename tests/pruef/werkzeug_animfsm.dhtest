--- inhalt held_vorschau.dh
ANIM_FSM_LOAD("held.dhanim")
UI_SLIDER
UI_BUTTON
hero_walk.png
--- nachher
' Nicht nur uebersetzen: ein paar Bilder laufen lassen -- ob das Blatt
' geladen und die Maschine aufgesetzt wird, zeigt erst der Lauf.
DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", "held_vorschau.dh")
DIM bis AS INTEGER : bis = MILLIS() + 60000
DIM befund AS STRING : befund = ""
DIM stille AS INTEGER : stille = 0
WHILE MILLIS() < bis AND stille < 5
    DIM z AS STRING : z = PROCESS_READ$(pc)
    IF z <> "" THEN befund = befund + z : stille = 0
    IF z = "" AND NOT PROCESS_RUNNING(pc) THEN stille = stille + 1 : SLEEP(30)
WEND
PRINT "check " + TRIM$(befund)
DIM pb AS INTEGER : pb = PROCESS_START("dhrt", "bild", "held_vorschau.dh", "v.png", "5")
bis = MILLIS() + 60000
WHILE PROCESS_RUNNING(pb) AND MILLIS() < bis
WEND
PRINT "lauf " ; PROCESS_CODE(pb)
--- erwartet
check []
lauf 0

