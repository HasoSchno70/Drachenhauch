=== vergleich: reihenfolge, garn und bewertung wie pysticky
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")

SUB vergleichZeigen(m AS kern.Muster, stoff AS FLOAT, datei AS STRING)
    DIM v AS ARRAY OF kern.Stickpfad : v = kern.spVergleich(m, stoff)
    DIM z AS ARRAY OF STRING : z = []
    DIM r AS kern.Stickpfad
    FOR EACH r IN v
        ARRAY_PUSH(z, kern.spKennung$(r.strategie) + " | " + FORMAT$(r.distanz, "%.1f") + " | " + STR$(r.spruenge) + " | " + FORMAT$(r.garnCm, "%.0f") + " | " + kern.spBewertung$(r.distanz, v[0].distanz))
    NEXT
    PRINT stoff; " ct: "; geAbweichungen$(geLies$(datei), JOIN$(z, CHR$(10)))
END SUB

vergleichZeigen(m, 14, "vergleich_14.txt")
vergleichZeigen(m, 18, "vergleich_18.txt")
