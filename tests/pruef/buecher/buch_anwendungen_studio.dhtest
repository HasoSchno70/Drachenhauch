=== kapitel 16: aus dem netz
' Kapitel 16: das Bearbeitungsfenster schlaegt eine ISBN nach -- gegen einen
' Server, der Open Library spielt (server.dh, Port in port.txt). Die Kopien
' der Programme bekommen dessen Adresse als QUELLE und legen die ISBN
' (Umgebung ISBN) in die Zwischenablage. Bekannt mit Bindestrichen, mit
' Cover und Sichern; unbekannt; zu kurz; Abbrechen einer langsamen Antwort;
' kein Netz. Dazu die Loesungen (Cache, Sekunden).
IMPORT "laeufer.dh"
IMPORT "db"
IMPORT "json"
SUB kopieren(von AS STRING, nach AS STRING)
    IF NOT DIREXISTS(nach) THEN MKDIR(nach)
    DIM n AS STRING
    FOR EACH n IN DIRLIST(von)
        IF DIREXISTS(von + "/" + n) THEN
            IF n <> "_studio" THEN kopieren(von + "/" + n, nach + "/" + n)
        ELSEIF RIGHT$(n, 3) <> ".db" THEN
            COPYFILE(von + "/" + n, nach + "/" + n)
        END IF
    NEXT
END SUB
FUNCTION bedienen$(main AS STRING, ev AS ARRAY OF STRING, bilder AS INTEGER) AS STRING
    DIM pf AS STRING : pf = CWD$() + "/bedienung.txt"
    WRITEALL(pf, "c " + STR$(LEN(ev)) + CHR$(10) + JOIN$(ev, CHR$(10)) + CHR$(10) + CHR$(10))
    SETENV("DHRT_ABSPIELEN", pf)
    SETENV("DHRT_GUI_ZUSTAND", "1")
    DIM q AS INTEGER : q = PROCESS_START("dhrt", "run", "--bilder", STR$(bilder), main)
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(q) + PROCESS_ERR$(q)
        aus = aus + t
        IF t = "" AND NOT PROCESS_RUNNING(q) THEN leer = leer + 1
        SLEEP(20)
    WEND
    SETENV("DHRT_ABSPIELEN", "")
    SETENV("DHRT_GUI_ZUSTAND", "")
    RETURN aus
END FUNCTION
SUB klick(ev AS ARRAY OF STRING, b AS INTEGER, x AS INTEGER, y AS INTEGER)
    ARRAY_PUSH(ev, "e " + STR$(b) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 2) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 4) + " 6 0 0 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 6) + " 5 0 0 0 0")
END SUB
' Die Zeile des Zustands zu einem Widget.
FUNCTION zeile$(aus AS STRING, was AS STRING) AS STRING
    DIM z AS STRING
    FOR EACH z IN SPLIT$(REPLACE$(aus, CHR$(13), ""), CHR$(10))
        IF INSTR(z, was) >= 0 THEN RETURN TRIM$(z)
    NEXT
    RETURN ""
END FUNCTION
FUNCTION wert$(datei AS STRING, sql AS STRING) AS STRING
    DIM d AS DB_CONN : d = DB_OPEN(datei)
    DIM r AS DB_RESULT : r = DB_QUERY(d, sql)
    DIM w AS STRING : w = "?"
    IF DB_NEXT(r) THEN w = DB_GET_STRING(r, 0)
    DB_CLOSE(d)
    RETURN w
END FUNCTION
SUB f5(nm AS STRING, p AS STRING)
    slZeilen = []
    slBild = 0
    slHin(10, 10)
    slWarten(10)
    slTaste(294)
    slWarten(150)
    slAufnahmeSchreiben(CWD$() + "/f5.txt")
    SETENV("DH_STUDIO_LAUF_BILDER", "20")
    DIM lg AS STRING : lg = CWD$() + "/" + nm + ".log"
    DIM aus AS STRING : aus = slStarten(lg, CWD$() + "/f5.txt", slBild + 20, p)
    PRINT nm; " geprueft "; slHat(lg, "geprueft 0 0"); " beendet "; slHat(lg, "beendet 0")
    IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
END SUB
SUB ersetzen(datei AS STRING, alt AS STRING, neu AS STRING)
    DIM t AS STRING : t = READALL(datei)
    IF INSTR(t, alt) < 0 THEN PRINT "nicht gefunden: "; alt
    WRITEALL(datei, REPLACE$(t, alt, neu))
END SUB

SUB umleiten(main AS STRING, quelle AS STRING)
    DIM f AS STRING : f = main + "/../projekt/EintragFenster.dh"
    ersetzen(f, "CONST QUELLE = " + CHR$(34) + "https://openlibrary.org" + CHR$(34), "CONST QUELLE = " + CHR$(34) + quelle + CHR$(34))
    ersetzen(f, "        GUI_FOCUS(Self.feldIsbn)" + CHR$(10) + "    END SUB", "        GUI_FOCUS(Self.feldIsbn)" + CHR$(10) + "        CLIPBOARD_SET(GETENV$(" + CHR$(34) + "ISBN" + CHR$(34) + "))" + CHR$(10) + "    END SUB")
END SUB
' Neu, ISBN einfuegen, Nachschlagen (Lagen mit Menueleiste).
FUNCTION nachschlagen(isbn AS STRING, nochmal AS BOOLEAN) AS ARRAY OF STRING
    SETENV("ISBN", isbn)
    DIM ev AS ARRAY OF STRING : ev = []
    klick(ev, 0, 295, 453)
    klick(ev, 20, 320, 148)
    ARRAY_PUSH(ev, "e 30 2 341 0 0 0")
    ARRAY_PUSH(ev, "e 32 2 86 0 0 0")
    ARRAY_PUSH(ev, "e 34 1 86 0 0 0")
    ARRAY_PUSH(ev, "e 36 1 341 0 0 0")
    klick(ev, 42, 474, 148)
    IF nochmal THEN klick(ev, 70, 474, 148)
    RETURN ev
END FUNCTION
FUNCTION zeilen$(aus AS STRING, was AS ARRAY OF STRING) AS STRING
    DIM t AS ARRAY OF STRING : t = []
    DIM w AS STRING
    FOR EACH w IN was
        ARRAY_PUSH(t, zeile$(aus, w))
    NEXT
    RETURN JOIN$(t, " | ")
END FUNCTION

DIM code AS STRING : code = ARG$(1) + "/buecher/anwendungen/code/"
DIM proj AS STRING
FOR EACH proj IN ["kap16/mediathek", "loesungen/kap16_cache", "loesungen/kap16_sekunden"]
    DIM nm AS STRING : nm = BASENAME(proj)
    IF nm = "mediathek" THEN nm = "kap16_mediathek"
    kopieren(code + proj, CWD$() + "/" + nm)
    f5(nm, CWD$() + "/" + nm)
NEXT
COPYFILE(ARG$(1) + "/daten/bilder/logo.png", CWD$() + "/cover.png")
WRITEALL(CWD$() + "/anfragen.txt", "")
DIM sp AS INTEGER : sp = PROCESS_START("dhrt", "run", CWD$() + "/server.dh", "--", "150")
DIM t0 AS INTEGER : t0 = MILLIS()
WHILE NOT FILEEXISTS(CWD$() + "/port.txt") AND MILLIS() - t0 < 15000
    SLEEP(20)
WEND
DIM quelle AS STRING : quelle = "http://127.0.0.1:" + TRIM$(READALL(CWD$() + "/port.txt"))
DIM nm2 AS STRING
FOR EACH nm2 IN ["kap16_mediathek", "kap16_cache", "kap16_sekunden"]
    umleiten(CWD$() + "/" + nm2 + "/_studio/main.dh", quelle)
NEXT
DIM m AS STRING : m = CWD$() + "/kap16_mediathek/_studio/main.dh"
DIM felder AS ARRAY OF STRING
felder = ["textinput#feldtitel", "textinput#feldurheber", "textinput#feldjahr", "label#hinweis"]
DIM ev AS ARRAY OF STRING
DIM a AS STRING
' Bekannt, mit Bindestrichen (Drehen 2), dann OK: isbn und Cover in der Datei.
PRINT zeilen$(bedienen$(m, nachschlagen("978-3-522-20260-2", FALSE), 120), felder)
ev = nachschlagen("978-3-522-20260-2", FALSE)
klick(ev, 90, 510, 379)
a = bedienen$(m, ev, 120)
DIM d AS DB_CONN : d = DB_OPEN(CWD$() + "/kap16_mediathek/_studio/mediathek.db")
DIM r AS DB_RESULT : r = DB_QUERY(d, "SELECT isbn, length(cover) > 1000 FROM eintrag WHERE titel = 'Die unendliche Geschichte'")
IF DB_NEXT(r) THEN PRINT "gesichert "; DB_GET_STRING(r, 0); " cover "; DB_GET_STRING(r, 1)
DB_CLOSE(d)
PRINT zeile$(bedienen$(m, nachschlagen("9783000000001", FALSE), 80), "label#hinweis")
PRINT zeile$(bedienen$(m, nachschlagen("123", FALSE), 60), "label#hinweis")
' Erweitern 1: zweimal dieselbe ISBN -- der Server sieht eine Anfrage.
DIM mc AS STRING : mc = CWD$() + "/kap16_cache/_studio/main.dh"
DIM vorher AS INTEGER : vorher = LEN(READLINES(CWD$() + "/anfragen.txt"))
a = bedienen$(mc, nachschlagen("9783522202602", FALSE), 100)
a = bedienen$(mc, nachschlagen("9783522202602", FALSE), 100)
DIM api AS INTEGER : api = 0
DIM z AS STRING
DIM alle AS ARRAY OF STRING : alle = READLINES(CWD$() + "/anfragen.txt")
DIM i AS INTEGER
FOR i = vorher TO LEN(alle) - 1
    IF LEFT$(alle[i], 10) = "/api/books" THEN api = api + 1
NEXT
PRINT "cache "; api; " "; zeile$(a, "textinput#feldtitel")
' Langsame Antwort (der Server schlaeft 15 s und bedient solange keinen
' anderen -- darum am Schluss), zweiter Klick bricht ab.
PRINT zeile$(bedienen$(m, nachschlagen("9783000000002", TRUE), 100), "label#hinweis")
' Erweitern 2: waehrend der langsamen Antwort zaehlt der Hinweis.
a = zeile$(bedienen$(CWD$() + "/kap16_sekunden/_studio/main.dh", nachschlagen("9783000000002", FALSE), 200), "label#hinweis")
PRINT "sekunden "; INSTR(a, "Frage Open Library ... ") >= 0 AND INSTR(a, " s" + CHR$(34)) >= 0
PROCESS_KILL(sp)
' Kein Netz: niemand lauscht.
ersetzen(m + "/../projekt/EintragFenster.dh", quelle, "http://127.0.0.1:9")
a = zeile$(bedienen$(m, nachschlagen("9783522202602", FALSE), 200), "label#hinweis")
PRINT "kein netz "; INSTR(a, "Keine Antwort: HTTP-Fehler: http://127.0.0.1:9/api/books") >= 0
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../..
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
--- datei server.dh
' Spielt Open Library fuer die Pruefung: /api/books?bibkeys=ISBN:...
' 9783522202602 -> Daten mit Cover, 9783000000001 -> {} (unbekannt),
' 9783000000002 -> antwortet erst nach 15 s (Zeitgrenze), /cover.png.
' Laeuft hoechstens ARG$(0) Sekunden; schreibt "port N" in port.txt.
IMPORT "httpd"
DIM s AS HTTPD : s = HTTPD_START(0, "127.0.0.1")
DIM port AS INTEGER : port = HTTPD_PORT(s)
WRITEALL("port.txt", STR$(port))
DIM q AS STRING : q = CHR$(34)
DIM bis AS INTEGER : bis = MILLIS() + INT(VAL(ARG$(0))) * 1000
WHILE MILLIS() < bis
    IF HTTPD_ACCEPT(s) THEN
        DIM pfad AS STRING : pfad = HTTPD_PATH$(s)
        DIM k AS STRING : k = HTTPD_QUERY$(s, "bibkeys")
        APPENDFILE("anfragen.txt", pfad + " " + k + CHR$(10))
        IF pfad = "/cover.png" THEN
            HTTPD_SEND_FILE(s, 200, "cover.png")
        ELSEIF k = "ISBN:9783522202602" THEN
            DIM j AS STRING
            j = "{" + q + k + q + ": {" + q + "title" + q + ": " + q + "Die unendliche Geschichte" + q + ", "
            j = j + q + "authors" + q + ": [{" + q + "name" + q + ": " + q + "Michael Ende" + q + "}], "
            j = j + q + "publish_date" + q + ": " + q + "Jan 15, 2019" + q + ", "
            j = j + q + "cover" + q + ": {" + q + "medium" + q + ": " + q + "http://127.0.0.1:" + STR$(port) + "/cover.png" + q + "}}}"
            HTTPD_SEND(s, 200, "application/json", j)
        ELSEIF k = "ISBN:9783000000002" THEN
            SLEEP(15000)
            HTTPD_SEND(s, 200, "application/json", "{}")
        ELSE
            HTTPD_SEND(s, 200, "application/json", "{}")
        END IF
    END IF
    SLEEP(5)
WEND
HTTPD_STOP(s)
--- erwartet
kap16_mediathek geprueft TRUE beendet TRUE
kap16_cache geprueft TRUE beendet TRUE
kap16_sekunden geprueft TRUE beendet TRUE
textinput#feldtitel "Die unendliche Geschichte" | textinput#feldurheber "Michael Ende" | textinput#feldjahr "2019" | label#hinweis "Gefunden, mit Cover."
gesichert 978-3-522-20260-2 cover 1
label#hinweis "Unter dieser ISBN kennt Open Library nichts."
label#hinweis "Eine ISBN hat 10 oder 13 Ziffern."
cache 1 textinput#feldtitel "Die unendliche Geschichte"
label#hinweis "Abgebrochen."
sekunden TRUE
kein netz TRUE

=== kapitel 17: berichte und drucken
' Kapitel 17: die Berichte Ausleihliste (gruppiert nach Freund) und
' Karteikarte (A6 quer, Parameter :id). Datei -> Karteikarte ohne gewaehlte
' Zeile sagt es in der Statuszeile. Die Berichte selbst prueft der Fall an
' den PDFs: berichte.dh kommt hinten an das Modul Bestand der Kopie, traegt
' "Die unendliche Geschichte" mit ISBN ein, sichert die PDFs (ZIEL) und
' laesst einmal den Parameter weg. Dazu die Loesungen: Strichcode auf der
' Karte, Jahresrueckblick (Jahr als Text und, zum Vergleich, als Zahl).
IMPORT "laeufer.dh"
SUB kopieren(von AS STRING, nach AS STRING)
    IF NOT DIREXISTS(nach) THEN MKDIR(nach)
    DIM n AS STRING
    FOR EACH n IN DIRLIST(von)
        IF DIREXISTS(von + "/" + n) THEN
            IF n <> "_studio" THEN kopieren(von + "/" + n, nach + "/" + n)
        ELSEIF RIGHT$(n, 3) <> ".db" THEN
            COPYFILE(von + "/" + n, nach + "/" + n)
        END IF
    NEXT
END SUB
FUNCTION laufen$(main AS STRING, bilder AS INTEGER) AS STRING
    DIM q AS INTEGER : q = PROCESS_START("dhrt", "run", "--bilder", STR$(bilder), main)
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(q) + PROCESS_ERR$(q)
        aus = aus + t
        IF t = "" AND NOT PROCESS_RUNNING(q) THEN leer = leer + 1
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
FUNCTION bedienen$(main AS STRING, ev AS ARRAY OF STRING, bilder AS INTEGER) AS STRING
    DIM pf AS STRING : pf = CWD$() + "/bedienung.txt"
    WRITEALL(pf, "c " + STR$(LEN(ev)) + CHR$(10) + JOIN$(ev, CHR$(10)) + CHR$(10) + CHR$(10))
    SETENV("DHRT_ABSPIELEN", pf)
    SETENV("DHRT_GUI_ZUSTAND", "1")
    DIM aus AS STRING : aus = laufen$(main, bilder)
    SETENV("DHRT_ABSPIELEN", "")
    SETENV("DHRT_GUI_ZUSTAND", "")
    RETURN aus
END FUNCTION
SUB klick(ev AS ARRAY OF STRING, b AS INTEGER, x AS INTEGER, y AS INTEGER)
    ARRAY_PUSH(ev, "e " + STR$(b) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 2) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 4) + " 6 0 0 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 6) + " 5 0 0 0 0")
END SUB
FUNCTION zeile$(aus AS STRING, was AS STRING) AS STRING
    DIM z AS STRING
    FOR EACH z IN SPLIT$(REPLACE$(aus, CHR$(13), ""), CHR$(10))
        IF INSTR(z, was) >= 0 THEN RETURN TRIM$(z)
    NEXT
    RETURN ""
END FUNCTION
SUB f5(nm AS STRING, p AS STRING)
    slZeilen = []
    slBild = 0
    slHin(10, 10)
    slWarten(10)
    slTaste(294)
    slWarten(150)
    slAufnahmeSchreiben(CWD$() + "/f5.txt")
    SETENV("DH_STUDIO_LAUF_BILDER", "20")
    DIM lg AS STRING : lg = CWD$() + "/" + nm + ".log"
    DIM aus AS STRING : aus = slStarten(lg, CWD$() + "/f5.txt", slBild + 20, p)
    PRINT nm; " geprueft "; slHat(lg, "geprueft 0 0"); " beendet "; slHat(lg, "beendet 0")
    IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
END SUB
' Haengt eine Datei an das Modul Bestand der Kopie, ruft ihre SUB am Ende
' von Hauptfenster.Geoeffnet und laesst das Programm laufen; die PDFs
' landen in <nm>_pdf.
SUB drucken(nm AS STRING, datei AS STRING, aufruf AS STRING)
    DIM pr AS STRING : pr = CWD$() + "/" + nm + "/_studio/projekt/"
    WRITEALL(pr + "Bestand.dh", READALL(pr + "Bestand.dh") + CHR$(10) + READALL(CWD$() + "/" + datei))
    DIM h AS STRING : h = READALL(pr + "Hauptfenster.dh")
    DIM alt AS STRING : alt = "        Self.statusZeigen()" + CHR$(10) + "    END SUB"
    IF INSTR(h, alt) < 0 THEN PRINT "nicht gefunden: Geoeffnet"
    WRITEALL(pr + "Hauptfenster.dh", REPLACE$(h, alt, "        Self.statusZeigen()" + CHR$(10) + "        " + aufruf + "()" + CHR$(10) + "    END SUB"))
    MKDIR(CWD$() + "/" + nm + "_pdf")
    SETENV("ZIEL", CWD$() + "/" + nm + "_pdf")
    DIM aus AS STRING : aus = laufen$(CWD$() + "/" + nm + "/_studio/main.dh", 20)
    SETENV("ZIEL", "")
    IF INSTR(LOWER$(aus), "fehler") >= 0 THEN PRINT aus
END SUB
FUNCTION text$(datei AS STRING) AS STRING
    IF NOT FILEEXISTS(datei) THEN RETURN "(keine Datei " + BASENAME(datei) + ")"
    RETURN JOIN$(pdfSeiten(datei), CHR$(10))
END FUNCTION
FUNCTION hat(t AS STRING, s AS STRING) AS BOOLEAN
    RETURN INSTR(t, s) >= 0
END FUNCTION

DIM code AS STRING : code = ARG$(1) + "/buecher/anwendungen/code/"
DIM proj AS STRING
FOR EACH proj IN ["kap17/mediathek", "loesungen/kap17_strichcode", "loesungen/kap17_rueckblick"]
    DIM nm AS STRING : nm = BASENAME(proj)
    IF nm = "mediathek" THEN nm = "kap17_mediathek"
    kopieren(code + proj, CWD$() + "/" + nm)
    f5(nm, CWD$() + "/" + nm)
NEXT
' Datei -> Karteikarte, ohne dass eine Zeile gewaehlt ist.
DIM ev AS ARRAY OF STRING : ev = []
klick(ev, 4, 20, 13)
klick(ev, 14, 60, 63)
PRINT zeile$(bedienen$(CWD$() + "/kap17_mediathek/_studio/main.dh", ev, 50), "label#status")
' Die Berichte als PDF.
drucken("kap17_mediathek", "berichte.dh", "berichteSichern")
DIM d AS STRING : d = CWD$() + "/kap17_mediathek_pdf/"
DIM t AS STRING : t = text$(d + "liste.pdf")
PRINT "liste "; hat(t, "Jonas") AND INSTR(t, "Jonas") < INSTR(t, "Lena"); " "; hat(t, "Momo"); " "; hat(t, "Tetris"); " noch da "; hat(t, "noch da")
PRINT "tage "; hat(t, CHR$(10) + "15" + CHR$(10)); " "; hat(t, CHR$(10) + "40" + CHR$(10)); " "; hat(t, CHR$(10) + "55" + CHR$(10)); " "; hat(t, "Seite 1 von 1")
t = text$(d + "karte_neu.pdf")
PRINT "karte "; hat(t, "Die unendliche Geschichte"); " "; hat(t, "Michael Ende"); " isbn "; hat(t, "ISBN"); " "; hat(t, "978-3-522-20260-2")
PRINT "karte momo isbn "; hat(text$(d + "karte_momo.pdf"), "ISBN"); " seiten "; LEN(pdfSeiten(d + "karte_momo.pdf"))
PRINT READALL(d + "fehler.txt")
' Erweitern 1: der Strichcode -- seine Ziffern stehen als Text im PDF.
drucken("kap17_strichcode", "berichte.dh", "berichteSichern")
d = CWD$() + "/kap17_strichcode_pdf/"
PRINT "strichcode "; hat(REPLACE$(text$(d + "karte_neu.pdf"), CHR$(10), ""), "9783522202602"); " momo "; hat(REPLACE$(text$(d + "karte_momo.pdf"), CHR$(10), ""), "978")
' Erweitern 2: der Rueckblick des Jahres, in dem Tetris verliehen wurde.
drucken("kap17_rueckblick", "rueckblick.dh", "rueckblickSichern")
d = CWD$() + "/kap17_rueckblick_pdf/"
t = text$(d + "text.pdf")
PRINT "rueckblick "; hat(t, "Tetris"); " "; hat(t, READALL(d + "monat.txt")); " zahl "; hat(text$(d + "zahl.pdf"), "Tetris")
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../..
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
IMPORT "{sammlung}/../_hilfen/pdftext.dh"
slStudio = ARG$(0)
--- datei berichte.dh
SUB berichteSichern()
    DIM ziel AS STRING : ziel = GETENV$("ZIEL")
    DB_EXEC(Mediathek, "INSERT INTO eintrag (titel, urheber, art, jahr, isbn) VALUES (?, ?, ?, ?, ?)", "Die unendliche Geschichte", "Michael Ende", "Buch", 2019, "978-3-522-20260-2")
    DIM neu AS INTEGER : neu = DB_LAST_ROWID(Mediathek)
    DIM momo AS INTEGER : momo = 0
    DIM r AS DB_RESULT : r = DB_QUERY(Mediathek, "SELECT id FROM eintrag WHERE titel = 'Momo'")
    IF DB_NEXT(r) THEN momo = DB_GET_INT(r, 0)
    Ausleihliste.Pdf(ziel + "/liste.pdf", {})
    Karteikarte.Pdf(ziel + "/karte_neu.pdf", {"id": neu})
    Karteikarte.Pdf(ziel + "/karte_momo.pdf", {"id": momo})
    TRY
        Karteikarte.Pdf(ziel + "/ohne.pdf", {})
    CATCH e
        WRITEALL(ziel + "/fehler.txt", e)
    END TRY
    END
END SUB
--- datei rueckblick.dh
SUB rueckblickSichern()
    DIM ziel AS STRING : ziel = GETENV$("ZIEL")
    DIM r AS DB_RESULT
    r = DB_QUERY(Mediathek, "SELECT strftime('%Y', von), strftime('%Y-%m', von) FROM ausleihe WHERE zurueck IS NULL")
    IF DB_NEXT(r) THEN
        WRITEALL(ziel + "/monat.txt", DB_GET_STRING(r, 1))
        Rueckblick.Pdf(ziel + "/text.pdf", {"jahr": DB_GET_STRING(r, 0)})
        Rueckblick.Pdf(ziel + "/zahl.pdf", {"jahr": INT(VAL(DB_GET_STRING(r, 0)))})
    END IF
    END
END SUB
--- erwartet
kap17_mediathek geprueft TRUE beendet TRUE
kap17_strichcode geprueft TRUE beendet TRUE
kap17_rueckblick geprueft TRUE beendet TRUE
label#status "Erst einen Eintrag wählen."
liste TRUE TRUE TRUE noch da TRUE
tage TRUE TRUE TRUE TRUE
karte TRUE TRUE isbn TRUE TRUE
karte momo isbn FALSE seiten 1
Bericht: Parameter :id fehlt
strichcode TRUE momo FALSE
rueckblick TRUE TRUE zahl FALSE

=== kapitel 18: diagramme
' Kapitel 18: Ansicht -> Statistik zeigt zwei Diagramme in einem zweiten
' Fenster (bis 2026-11-22 blieben sie dort leer). Ein Klick auf das Stueck
' Musik und auf den Balken des Monats, in dem Tetris verliehen wurde (40
' Tage vor heute -- seine Lage rechnet der Fall aus), fuellt Hinweis und
' Liste. Dazu die Loesungen: 12 Monate in der Klappliste (der Balken
' wandert), und die Leiste "verliehen" (1 von 5 = 20 %).
IMPORT "laeufer.dh"
IMPORT "zeit"
SUB kopieren(von AS STRING, nach AS STRING)
    IF NOT DIREXISTS(nach) THEN MKDIR(nach)
    DIM n AS STRING
    FOR EACH n IN DIRLIST(von)
        IF DIREXISTS(von + "/" + n) THEN
            IF n <> "_studio" THEN kopieren(von + "/" + n, nach + "/" + n)
        ELSEIF RIGHT$(n, 3) <> ".db" THEN
            COPYFILE(von + "/" + n, nach + "/" + n)
        END IF
    NEXT
END SUB
FUNCTION laufen$(main AS STRING, bilder AS INTEGER) AS STRING
    DIM q AS INTEGER : q = PROCESS_START("dhrt", "run", "--bilder", STR$(bilder), main)
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(q) + PROCESS_ERR$(q)
        aus = aus + t
        IF t = "" AND NOT PROCESS_RUNNING(q) THEN leer = leer + 1
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
FUNCTION bedienen$(main AS STRING, ev AS ARRAY OF STRING, bilder AS INTEGER) AS STRING
    DIM pf AS STRING : pf = CWD$() + "/bedienung.txt"
    WRITEALL(pf, "c " + STR$(LEN(ev)) + CHR$(10) + JOIN$(ev, CHR$(10)) + CHR$(10) + CHR$(10))
    SETENV("DHRT_ABSPIELEN", pf)
    SETENV("DHRT_GUI_ZUSTAND", "1")
    DIM aus AS STRING : aus = laufen$(main, bilder)
    SETENV("DHRT_ABSPIELEN", "")
    SETENV("DHRT_GUI_ZUSTAND", "")
    RETURN aus
END FUNCTION
SUB klick(ev AS ARRAY OF STRING, b AS INTEGER, x AS INTEGER, y AS INTEGER)
    ARRAY_PUSH(ev, "e " + STR$(b) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 2) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 4) + " 6 0 0 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 6) + " 5 0 0 0 0")
END SUB
FUNCTION zeile$(aus AS STRING, was AS STRING) AS STRING
    DIM z AS STRING
    FOR EACH z IN SPLIT$(REPLACE$(aus, CHR$(13), ""), CHR$(10))
        IF INSTR(z, was) >= 0 THEN RETURN TRIM$(z)
    NEXT
    RETURN ""
END FUNCTION
SUB f5(nm AS STRING, p AS STRING)
    slZeilen = []
    slBild = 0
    slHin(10, 10)
    slWarten(10)
    slTaste(294)
    slWarten(150)
    slAufnahmeSchreiben(CWD$() + "/f5.txt")
    SETENV("DH_STUDIO_LAUF_BILDER", "20")
    DIM lg AS STRING : lg = CWD$() + "/" + nm + ".log"
    DIM aus AS STRING : aus = slStarten(lg, CWD$() + "/f5.txt", slBild + 20, p)
    PRINT nm; " geprueft "; slHat(lg, "geprueft 0 0"); " beendet "; slHat(lg, "beendet 0")
    IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
END SUB
' Ansicht -> Statistik ...
FUNCTION statistik() AS ARRAY OF STRING
    DIM ev AS ARRAY OF STRING : ev = []
    klick(ev, 4, 70, 13)
    klick(ev, 14, 110, 63)
    RETURN ev
END FUNCTION
FUNCTION monatsnummer(t AS STRING) AS INTEGER
    RETURN INT(VAL(LEFT$(t, 4))) * 12 + INT(VAL(MID$(t, 5, 2))) - 1
END FUNCTION

DIM code AS STRING : code = ARG$(1) + "/buecher/anwendungen/code/"
DIM proj AS STRING
FOR EACH proj IN ["kap18/mediathek", "loesungen/kap18_zeitraum", "loesungen/kap18_verliehen"]
    DIM nm AS STRING : nm = BASENAME(proj)
    IF nm = "mediathek" THEN nm = "kap18_mediathek"
    kopieren(code + proj, CWD$() + "/" + nm)
    f5(nm, CWD$() + "/" + nm)
NEXT
' Der Monat, in dem Tetris verliehen wurde, und wie viele Monate davor.
DIM heute AS STRING : heute = ZEIT_TEXT$(ZEIT_JETZT())
DIM tetris AS STRING : tetris = ZEIT_TEXT$(ZEIT_PLUS(ZEIT_JETZT(), -40 * 86400))
DIM zurueck AS INTEGER : zurueck = monatsnummer(heute) - monatsnummer(tetris)
DIM monat AS STRING : monat = LEFT$(tetris, 7)
DIM m AS STRING : m = CWD$() + "/kap18_mediathek/_studio/main.dh"
DIM ev AS ARRAY OF STRING
DIM a AS STRING
' Das Stueck Musik (unten links im Kuchen).
ev = statistik()
klick(ev, 30, 170, 210)
PRINT zeile$(bedienen$(m, ev, 50), "label#hinweis")
' Der Balken des Tetris-Monats (sechs Faecher zu 46,5 Punkten ab 418),
' dann die erste Zeile der Liste.
ev = statistik()
klick(ev, 30, 441 + INT(46.5 * (5 - zurueck)), 250)
klick(ev, 40, 150, 362)
a = bedienen$(m, ev, 60)
PRINT "monat "; zeile$(a, "label#hinweis") = "label#hinweis " + CHR$(34) + monat + ": 1 Ausleihe" + CHR$(34)
PRINT zeile$(a, "listbox#liste")
' Erweitern 1: 12 Monate -- zwoelf Faecher zu 23,25 Punkten.
ev = statistik()
klick(ev, 30, 655, 365)
klick(ev, 40, 650, 411)
klick(ev, 50, 430 + INT(23.25 * (11 - zurueck)), 250)
a = bedienen$(CWD$() + "/kap18_zeitraum/_studio/main.dh", ev, 70)
PRINT "zwoelf "; zeile$(a, "label#hinweis") = "label#hinweis " + CHR$(34) + monat + ": 1 Ausleihe" + CHR$(34); " "; zeile$(a, "dropdown#wahlzeitraum")
' Erweitern 2: die Leiste bekommt 20 (ein Eintrag von fuenf verliehen).
DIM sf AS STRING : sf = CWD$() + "/kap18_verliehen/_studio/projekt/StatistikFenster.dh"
DIM st AS STRING : st = READALL(sf)
IF INSTR(st, "        Self.anteil.Wert(prozent)") < 0 THEN PRINT "nicht gefunden: Wert"
WRITEALL(sf, REPLACE$(st, "        Self.anteil.Wert(prozent)", "        Self.anteil.Wert(prozent)" + CHR$(10) + "        PRINT " + CHR$(34) + "anteil " + CHR$(34) + "; prozent"))
PRINT zeile$(bedienen$(CWD$() + "/kap18_verliehen/_studio/main.dh", statistik(), 40), "anteil ")
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../..
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
--- erwartet
kap18_mediathek geprueft TRUE beendet TRUE
kap18_zeitraum geprueft TRUE beendet TRUE
kap18_verliehen geprueft TRUE beendet TRUE
label#hinweis "Musik: 1 Eintrag"
monat TRUE
listbox#liste 0 "Tetris -- Lena"
zwoelf TRUE dropdown#wahlzeitraum 1 "12 Monate"
anteil 20.0

=== kapitel 19: ein- und ausfuhr
' Kapitel 19: Datei -> Liste einlesen (der Dialog wird in der Kopie durch
' GETENV$("LISTE") ersetzt): die alte Liste aus dem Buch, Windows-1252 mit
' Semikolon -- vier neu, Momo schon da, drei mit Fehler; ein zweites Mal
' nichts neu; eine UTF-8-Liste mit Komma und anderer Spaltenfolge. Dazu
' die Ausfuhr als Excel-Mappe (ZIEL) und die Loesungen: CSV fuer Excel und
' die Fehlerdatei neben der Liste.
IMPORT "laeufer.dh"
IMPORT "db"
SUB kopieren(von AS STRING, nach AS STRING)
    IF NOT DIREXISTS(nach) THEN MKDIR(nach)
    DIM n AS STRING
    FOR EACH n IN DIRLIST(von)
        IF DIREXISTS(von + "/" + n) THEN
            IF n <> "_studio" THEN kopieren(von + "/" + n, nach + "/" + n)
        ELSEIF RIGHT$(n, 3) <> ".db" THEN
            COPYFILE(von + "/" + n, nach + "/" + n)
        END IF
    NEXT
END SUB
FUNCTION laufen$(main AS STRING, bilder AS INTEGER) AS STRING
    DIM q AS INTEGER : q = PROCESS_START("dhrt", "run", "--bilder", STR$(bilder), main)
    DIM aus AS STRING : aus = ""
    DIM leer AS INTEGER : leer = 0
    WHILE leer < 5
        DIM t AS STRING : t = PROCESS_READ$(q) + PROCESS_ERR$(q)
        aus = aus + t
        IF t = "" AND NOT PROCESS_RUNNING(q) THEN leer = leer + 1
        SLEEP(20)
    WEND
    RETURN aus
END FUNCTION
FUNCTION bedienen$(main AS STRING, ev AS ARRAY OF STRING, bilder AS INTEGER) AS STRING
    DIM pf AS STRING : pf = CWD$() + "/bedienung.txt"
    WRITEALL(pf, "c " + STR$(LEN(ev)) + CHR$(10) + JOIN$(ev, CHR$(10)) + CHR$(10) + CHR$(10))
    SETENV("DHRT_ABSPIELEN", pf)
    SETENV("DHRT_GUI_ZUSTAND", "1")
    DIM aus AS STRING : aus = laufen$(main, bilder)
    SETENV("DHRT_ABSPIELEN", "")
    SETENV("DHRT_GUI_ZUSTAND", "")
    IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
    RETURN aus
END FUNCTION
SUB klick(ev AS ARRAY OF STRING, b AS INTEGER, x AS INTEGER, y AS INTEGER)
    ARRAY_PUSH(ev, "e " + STR$(b) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 2) + " 7 " + STR$(x) + " " + STR$(y) + " 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 4) + " 6 0 0 0 0")
    ARRAY_PUSH(ev, "e " + STR$(b + 6) + " 5 0 0 0 0")
END SUB
FUNCTION zeile$(aus AS STRING, was AS STRING) AS STRING
    DIM z AS STRING
    FOR EACH z IN SPLIT$(REPLACE$(aus, CHR$(13), ""), CHR$(10))
        IF INSTR(z, was) >= 0 THEN RETURN TRIM$(z)
    NEXT
    RETURN ""
END FUNCTION
SUB f5(nm AS STRING, p AS STRING)
    slZeilen = []
    slBild = 0
    slHin(10, 10)
    slWarten(10)
    slTaste(294)
    slWarten(150)
    slAufnahmeSchreiben(CWD$() + "/f5.txt")
    SETENV("DH_STUDIO_LAUF_BILDER", "20")
    DIM lg AS STRING : lg = CWD$() + "/" + nm + ".log"
    DIM aus AS STRING : aus = slStarten(lg, CWD$() + "/f5.txt", slBild + 20, p)
    PRINT nm; " geprueft "; slHat(lg, "geprueft 0 0"); " beendet "; slHat(lg, "beendet 0")
    IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
END SUB
SUB ersetzen(datei AS STRING, alt AS STRING, neu AS STRING)
    DIM t AS STRING : t = READALL(datei)
    IF INSTR(t, alt) < 0 THEN PRINT "nicht gefunden: "; alt
    WRITEALL(datei, REPLACE$(t, alt, neu))
END SUB
' Die Dialoge der Kopie durch Umgebungsvariablen ersetzen.
SUB ohneDialoge(nm AS STRING)
    DIM h AS STRING : h = CWD$() + "/" + nm + "/_studio/projekt/Hauptfenster.dh"
    DIM q AS STRING : q = CHR$(34)
    ersetzen(h, "FILE_OPEN_DIALOG(" + q + "Liste einlesen" + q + ", " + q + "csv,txt" + q + ")", "GETENV$(" + q + "LISTE" + q + ")")
    ersetzen(h, "FILE_SAVE_DIALOG(" + q + "Als Excel-Mappe sichern" + q + ", _" + CHR$(10) + "                                " + q + "mediathek.xlsx" + q + ", " + q + "xlsx" + q + ")", "GETENV$(" + q + "ZIEL" + q + ")")
END SUB
' Datei -> Eintrag nr (ab 0, 24 Punkte je Zeile).
FUNCTION menue(nr AS INTEGER) AS ARRAY OF STRING
    DIM ev AS ARRAY OF STRING : ev = []
    klick(ev, 4, 20, 13)
    klick(ev, 14, 80, 39 + 24 * nr)
    RETURN ev
END FUNCTION
FUNCTION wert$(datei AS STRING, sql AS STRING) AS STRING
    DIM d AS DB_CONN : d = DB_OPEN(datei)
    DIM r AS DB_RESULT : r = DB_QUERY(d, sql)
    DIM w AS STRING : w = "?"
    IF DB_NEXT(r) THEN w = DB_GET_STRING(r, 0)
    DB_CLOSE(d)
    RETURN w
END FUNCTION

DIM code AS STRING : code = ARG$(1) + "/buecher/anwendungen/code/"
DIM proj AS STRING
FOR EACH proj IN ["kap19/mediathek", "loesungen/kap19_csv", "loesungen/kap19_fehler"]
    DIM nm AS STRING : nm = BASENAME(proj)
    IF nm = "mediathek" THEN nm = "kap19_mediathek"
    kopieren(code + proj, CWD$() + "/" + nm)
    f5(nm, CWD$() + "/" + nm)
    ohneDialoge(nm)
NEXT
COPYFILE(code + "kap19/alte_liste.csv", CWD$() + "/alte_liste.csv")
WRITEALL(CWD$() + "/neue_liste.csv", "Jahr,Titel,Art,Urheber" + CHR$(10) + "1957,Die kleine Hexe,Buch,Otfried Preußler" + CHR$(10) + ",Das kalte Herz,Buch,Wilhelm Hauff" + CHR$(10))
DIM m AS STRING : m = CWD$() + "/kap19_mediathek/_studio/main.dh"
DIM db AS STRING : db = CWD$() + "/kap19_mediathek/_studio/mediathek.db"
DIM ev AS ARRAY OF STRING
DIM a AS STRING
' Die alte Liste; die zweite Meldung waehlen.
SETENV("LISTE", CWD$() + "/alte_liste.csv")
ev = menue(3)
klick(ev, 40, 300, 166)
a = bedienen$(m, ev, 60)
PRINT zeile$(a, "label#zusammenfassung")
