' Nachtflug -- eine Demo in Drachenhauch: Musik und Bild aus einem Programm.
'
' Die Musik (musik.dh) ist ganz synthetisiert -- Trance in A-Moll, 128 Schlaege
' je Minute, in Stereo, knapp drei Minuten. Die Bilder folgen ihr: jede
' Szene gehoert zu einem Abschnitt des Stuecks, was pulsiert, pulsiert mit
' der Bassdrum, was aufblitzt, blitzt mit der Melodie, und die Farbe geht
' mit dem Akkord. Die Szenen gehen durch Licht ineinander ueber. Gezeichnet
' wird in 1280x720; die Szenen 1 bis 4 rechnet je ein Fragment-Shader
' (Raymarching, assets/shader), die fuenfte ist eine echte 3D-Szene.
'
'     dhrt run main.dh                    ' im Vollbild, von vorn
'     dhrt run main.dh -- --fenster       ' im Fenster
'     dhrt run main.dh -- --ab 32         ' ab Takt 32
'     dhrt run main.dh -- --leicht        ' fuer schwaechere Grafikkarten
'     dhrt run main.dh -- --wav datei.wav ' nur die Musik als WAV schreiben (trocken)
'     dhrt run main.dh -- --mitschnitt datei.wav  ' abspielen und mitschneiden,
'                                         ' so wie man es hoert (mit Hall)
'
' ESC beendet, F11 schaltet das Vollbild.
IMPORT "g3d"
IMPORT "m3d"
IMPORT "musik.dh"

CONST BREITE = 1280
CONST HOEHE = 720

' --- Argumente ------------------------------------------------------------
DIM abTakt AS INTEGER
DIM imFenster AS BOOLEAN
DIM wavZiel AS STRING
DIM messen AS BOOLEAN
' Guete der Bilder: 1 = voll, --leicht nimmt etwas mehr als die Haelfte der
' Schritte in den Shadern und zeichnet weniger Lichtspuren
DIM guete AS FLOAT : guete = 1.0
DIM mitschnitt AS STRING
DIM ai AS INTEGER
WHILE ai < ARGC()
    SELECT CASE ARG$(ai)
        CASE "--ab"
            ai = ai + 1 : abTakt = CLAMP(VAL(ARG$(ai)), 0, TAKTE - 1)
        CASE "--fenster"
            imFenster = TRUE
        CASE "--leicht"
            guete = 0.55
        CASE "--messen"
            messen = TRUE
        CASE "--wav"
            ai = ai + 1 : wavZiel = ARGPATH$(ai)
        CASE "--mitschnitt"
            ai = ai + 1 : mitschnitt = ARGPATH$(ai)
    END SELECT
    ai = ai + 1
WEND
IF wavZiel <> "" THEN
    musikAusschreiben(wavZiel)
    PRINT "geschrieben: "; wavZiel
    END
END IF

SCREEN(BREITE, HOEHE, "Nachtflug -- eine Demo in Drachenhauch", 1)
SETFPS(60)
WINDOW_ESC_QUIT(FALSE)
IF NOT imFenster THEN SET_FULLSCREEN(TRUE)

DIM schriftGross AS INTEGER : schriftGross = LOADFONT("serif", 72)
DIM schrift AS INTEGER : schrift = LOADFONT("sans", 32)

' --- Shader ------------------------------------------------------------------
FUNCTION shader(name AS STRING) AS INTEGER
    DIM h AS INTEGER : h = SHADER_LOAD("assets/shader/" + name + ".fs")
    IF h < 0 THEN THROW "Shader " + name + " liess sich nicht laden"
    SHADER_SET2(h, "resolution", BREITE, HOEHE)
    RETURN h
END FUNCTION
DIM shOzean AS INTEGER : shOzean = shader("ozean")
DIM shFlug AS INTEGER : shFlug = shader("flug")
DIM shTunnel AS INTEGER : shTunnel = shader("tunnel")
DIM shNebel AS INTEGER : shNebel = shader("nebel")
DIM shGlanz AS INTEGER : shGlanz = shader("glanz")

' --- Galaxie (Szene 5): Lichtspuren auf Umlaufbahnen ---------------------------
' Jeder Stern ist ein langgezogener, duenner Quader entlang seiner Bahn --
' mit dem Glanz-Shader darueber wird daraus eine Lichtspur wie auf einer
' Langzeitbelichtung. Alle in EINEM Aufruf (MODEL_INSTANCED), jede Spur in
' ihrer eigenen Farbe: der Kern von Weiss nach Gold, die Arme von Blau ueber
' Tuerkis nach Violett, rosa Knoten, wo Sterne entstehen -- dazu ein Hauch der
' Akkordfarbe und so hell, wie Welle und Melodie es gerade wollen. Dahinter rechnet der Shader die
' leuchtende Scheibe mit Spiralarmen und Staubbahnen (glanz.fs) -- mit
' derselben Kamera und derselben Drehung, damit beides deckungsgleich ist.
' Auf jeden Schlag laeuft eine Welle von innen nach aussen: die Spuren, die
' sie erreicht, heben sich und leuchten auf.
CONST STERNE = 2600
DIM spur AS INTEGER : spur = MESH_CUBE(1.0, 1.0, 1.0)
DIM gR[STERNE] AS FLOAT       ' Abstand zur Mitte
DIM gW[STERNE] AS FLOAT       ' Winkel
DIM gH[STERNE] AS FLOAT       ' Hoehe ueber der Scheibe
DIM gD[STERNE] AS FLOAT       ' Dicke
DIM gFR[STERNE] AS FLOAT      ' Grundfarbe der Spur, 0..1
DIM gFG[STERNE] AS FLOAT
DIM gFB[STERNE] AS FLOAT
DIM gMat[STERNE] AS MAT4
DIM gFarbe[STERNE] AS INTEGER
DIM gi AS INTEGER
RANDOMIZE(7)
FOR gi = 0 TO STERNE - 1
    DIM arm AS INTEGER : arm = gi MOD 2
    DIM r AS FLOAT
    IF gi < STERNE \ 8 THEN
        r = 0.4 + RND() ^ 1.6 * 6.0
    ELSE
        r = 3.0 + RND() ^ 0.9 * 32.0
    END IF
    gR[gi] = r
    ' um den Arm gestreut, aussen weiter
    gW[gi] = arm * PI + r * 0.22 + (RND() - 0.5) * (0.35 + 4.0 / (r + 2.0)) + (RND() - 0.5) * 0.25
    gH[gi] = (RND() - 0.5) * 2.0 * (0.25 + 1.6 * EXP(-r * 0.25))
    gD[gi] = 0.022 + RND() ^ 4 * 0.07
    ' Grundfarbe: im Kern von Weiss nach Gold, auf den Armen ein Verlauf von
    ' Blau ueber Tuerkis nach Violett (mit etwas Streuung), dazwischen rosa
    DIM k AS FLOAT
    IF r < 6 THEN
        k = CLAMP(r / 6.0 + (RND() - 0.5) * 0.3, 0.0, 1.0)
        gFR[gi] = 1.0
        gFG[gi] = 0.92 - 0.2 * k
        gFB[gi] = 0.8 - 0.42 * k
    ELSE
        k = CLAMP((r - 6.0) / 29.0 + (RND() - 0.5) * 0.35, 0.0, 1.0)
        IF k < 0.5 THEN
            gFR[gi] = 0.42 - 0.04 * k * 2.0
            gFG[gi] = 0.62 + 0.33 * k * 2.0
            gFB[gi] = 1.0 - 0.08 * k * 2.0
        ELSE
            gFR[gi] = 0.38 + 0.4 * (k - 0.5) * 2.0
            gFG[gi] = 0.95 - 0.47 * (k - 0.5) * 2.0
            gFB[gi] = 0.92 + 0.08 * (k - 0.5) * 2.0
        END IF
        IF RND() < 0.12 THEN
            gFR[gi] = 1.0 : gFG[gi] = 0.5 + RND() * 0.15 : gFB[gi] = 0.78
        END IF
    END IF
NEXT

' Die Kamera der Galaxie -- main und Shader brauchen dieselbe
DIM kamX AS FLOAT
DIM kamY AS FLOAT
DIM kamZ AS FLOAT
CONST KAM_FOV = 52.0

' wie schnell eine Bahn im Abstand r umlaeuft (Bogenmass je Sekunde)
FUNCTION umlauf(r AS FLOAT) AS FLOAT
    RETURN 0.9 / (r + 2.0)
END FUNCTION

SUB galaxieZeichnen(zeit AS FLOAT, kick AS FLOAT, fort AS FLOAT, takt AS FLOAT, ton AS FLOAT)
    ' Kamera: von hoch oben ueber der Scheibe in einem Bogen hinab, bis knapp
    ' ueber die Arme
    DIM kw AS FLOAT : kw = 0.6 + zeit * 0.05
    DIM kr AS FLOAT : kr = 46.0 - 20.0 * fort
    kamX = COS(kw) * kr
    kamZ = SIN(kw) * kr
    kamY = 4.0 + 30.0 * (1.0 - fort) ^ 2
    CAMERA3D(kamX, kamY, kamZ, 0, -0.5 * fort, 0, KAM_FOV)
    LIGHT_ENABLE()
    LIGHT_AMBIENT(RGB(255, 255, 255), 1.0)
    ' die Welle: auf jeden Schlag ein Ring, der in einer Viertel nach aussen laeuft
    DIM welle AS FLOAT : welle = (takt * 4.0 - FLOOR(takt * 4.0)) * 36.0
    ' die Melodie: jeder Ton laesst einen Ring aufleuchten -- je hoeher der
    ' Ton, desto weiter aussen
    DIM melRing AS FLOAT : melRing = 4.0 + tonHoehe * 24.0
    DIM i AS INTEGER
    FOR i = 0 TO STERNE - 1
        DIM r AS FLOAT : r = gR[i]
        DIM w AS FLOAT : w = gW[i] - zeit * umlauf(r)
        DIM abst AS FLOAT : abst = r - welle
        DIM hub AS FLOAT : hub = EXP(-abst * abst * 0.08) * (0.25 + 0.75 * kick)
        DIM mabst AS FLOAT : mabst = r - melRing
        hub = hub + EXP(-mabst * mabst * 0.12) * ton * 0.9
        ' die Spur: so lang, wie der Stern in einer Drittelsekunde wandert
        DIM lang AS FLOAT : lang = 0.25 + umlauf(r) * r * 2.6 * (1.0 + 0.6 * hub)
        DIM d AS FLOAT : d = gD[i] * (1.0 + hub)
        gMat[i] = MAT4_MUL(MAT4_TRANSLATE(COS(w) * r, gH[i] + hub * 1.2, SIN(w) * r), MAT4_MUL(MAT4_ROTATE_Y(-w), MAT4_SCALE(d, d, lang)))
        ' der Kern ist dicht, dort bleibt es dunkler -- sonst nur ein weisser Fleck;
        ' auf den Armen ein Hauch der Akkordfarbe
        DIM stufe AS FLOAT : stufe = MIN(1.6, IIF(r < 6.0, 0.5, 0.75) + hub * 0.9)
        DIM akk AS FLOAT : akk = IIF(r < 6.0, 0.0, 0.25)
        gFarbe[i] = RGB(MIN(255, INT(((1.0 - akk) * gFR[i] + akk * farbeR) * stufe * 255.0)), _
                        MIN(255, INT(((1.0 - akk) * gFG[i] + akk * farbeG) * stufe * 255.0)), _
                        MIN(255, INT(((1.0 - akk) * gFB[i] + akk * farbeB) * stufe * 255.0)))
    NEXT
    MODEL_INSTANCED(spur, gMat, gFarbe, IIF(guete < 1.0, STERNE * 6 \ 10, STERNE))
END SUB

' --- Text auf dem Bild ----------------------------------------------------------
' Weiss mit Deckkraft; der Shader legt das Bild obenauf.
SUB mittig(t AS STRING, y AS INTEGER, groesse AS INTEGER, deck AS FLOAT, gross AS BOOLEAN)
    IF deck <= 0.01 THEN RETURN
    SETFONT(IIF(gross, schriftGross, schrift), groesse)
    DIM a AS INTEGER : a = INT(CLAMP(deck, 0.0, 1.0) * 235)
    TEXT((BREITE - TEXT_WIDTH(t)) / 2, y, t, RGBA(225, 232, 255, MAX(1, a)))
END SUB

' Ein- und Ausblenden zwischen zwei Taktzeiten (mit weichen Raendern).
FUNCTION zeigen(takt AS FLOAT, von AS FLOAT, bis AS FLOAT) AS FLOAT
    RETURN CLAMP(MIN((takt - von) / 1.5, (bis - takt) / 1.5), 0.0, 1.0)
END FUNCTION

' Eine Zeile deutsch, darunter englisch, kleiner und etwas zurueckhaltender.
SUB zweisprachig(de AS STRING, en AS STRING, y AS INTEGER, groesse AS INTEGER, deck AS FLOAT, gross AS BOOLEAN)
    mittig(de, y, groesse, deck, gross)
    mittig(en, y + INT(groesse * 1.3), INT(groesse * 0.8), deck * 0.7, FALSE)
END SUB

' --- Lichterschwarm (Abspann) ---------------------------------------------------
' Funken steigen aus der Sonne am Horizont auf, fliegen in weiten Boegen
' heran und setzen sich zum Schriftzug "Drachenhauch" zusammen, funkeln dort
' und verloeschen mit dem Bild. Die Zielpunkte kommen aus dem Schriftzug
' selbst: einmal in ein Render-Ziel geschrieben, als Bild zurueckgeholt
' (RENDERTARGET_IMAGE) und auf einem Raster abgetastet.
CONST SCHWARM = 900
DIM swZielX[SCHWARM] AS FLOAT
DIM swZielY[SCHWARM] AS FLOAT
DIM swStartX[SCHWARM] AS FLOAT
DIM swStartY[SCHWARM] AS FLOAT
DIM swBogen[SCHWARM] AS FLOAT
DIM swVerz[SCHWARM] AS FLOAT
DIM swX[SCHWARM] AS INTEGER
DIM swY[SCHWARM] AS INTEGER
DIM swR[SCHWARM] AS INTEGER
DIM swFarbe[SCHWARM] AS INTEGER
DIM swHofR[SCHWARM] AS INTEGER
DIM swHof[SCHWARM] AS INTEGER
DIM swAnz AS INTEGER
CONST SCHWARM_Y = 565

SUB schwarmVorbereiten()
    DIM wort AS STRING : wort = "Drachenhauch"
    DIM rt AS INTEGER : rt = RENDERTARGET_NEW(BREITE, 140)
    RENDERTARGET_BEGIN(rt)
    SETFONT(schriftGross, 92)
    TEXT((BREITE - TEXT_WIDTH(wort)) \ 2, 20, wort, WHITE)
    RENDERTARGET_END()
    DIM bild AS INTEGER : bild = RENDERTARGET_IMAGE(rt)
    ' alle hellen Rasterpunkte sammeln, dann zufaellig bis zu SCHWARM nehmen
    DIM kx AS ARRAY OF INTEGER : kx = []
    DIM ky AS ARRAY OF INTEGER : ky = []
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = 0 TO 139 STEP 3
        FOR x = 0 TO BREITE - 1 STEP 3
            DIM f AS INTEGER : f = GETPIXEL(bild, x, y)
            IF ((f SHR 8) BAND 255) > 128 THEN
                ARRAY_PUSH(kx, x)
                ARRAY_PUSH(ky, y)
            END IF
        NEXT
    NEXT
    RANDOMIZE(11)
    DIM n AS INTEGER : n = LEN(kx)
    swAnz = MIN(SCHWARM, n)
    DIM i AS INTEGER
    FOR i = 0 TO swAnz - 1
        ' ziehen ohne Zuruecklegen: den gezogenen Platz mit dem letzten fuellen
        DIM j AS INTEGER : j = INT(RND() * n)
        swZielX[i] = kx[j] + (RND() - 0.5) * 1.5
        swZielY[i] = SCHWARM_Y - 70 + ky[j] + (RND() - 0.5) * 1.5
        kx[j] = kx[n - 1] : ky[j] = ky[n - 1]
        n = n - 1
        ' Start: an der Sonne ueber dem Horizont, etwas gestreut
        swStartX[i] = BREITE * 0.72 + (RND() - 0.5) * 60.0
        swStartY[i] = HOEHE * 0.47 + (RND() - 0.5) * 24.0
        swBogen[i] = (RND() - 0.3) * 520.0
        swVerz[i] = RND() * 1.6 + (swZielX[i] / BREITE) * 0.6
    NEXT
END SUB

SUB schwarmZeichnen(takt AS FLOAT, zeit AS FLOAT)
    IF takt < 85.3 OR swAnz = 0 THEN RETURN
    ' verloeschen mit dem Bild am Ende
    DIM aus AS FLOAT : aus = CLAMP((TAKTE + 1.4 - takt) * 0.8, 0.0, 1.0)
    DIM i AS INTEGER
    FOR i = 0 TO swAnz - 1
        DIM t AS FLOAT : t = CLAMP((takt - 85.3 - swVerz[i]) / 2.4, 0.0, 1.0)
        DIM e AS FLOAT : e = t * t * (3.0 - 2.0 * t)
        ' quadratischer Bogen: vom Start ueber einen seitlich versetzten Punkt zum Ziel
        DIM mx AS FLOAT : mx = (swStartX[i] + swZielX[i]) * 0.5 + swBogen[i]
        DIM my AS FLOAT : my = MIN(swStartY[i], swZielY[i]) - 160.0 - ABS(swBogen[i]) * 0.3
        DIM u AS FLOAT : u = 1.0 - e
        swX[i] = INT(u * u * swStartX[i] + 2.0 * u * e * mx + e * e * swZielX[i])
        swY[i] = INT(u * u * swStartY[i] + 2.0 * u * e * my + e * e * swZielY[i])
        ' angekommen: funkeln
        DIM funkeln AS FLOAT : funkeln = 0.75 + 0.25 * SIN(zeit * 5.0 + i * 1.7)
        DIM hell AS FLOAT : hell = IIF(t < 1.0, 0.5 + 0.5 * t, funkeln) * aus * MIN(1.0, t * 6.0)
        swR[i] = IIF(e < 0.9, 2, 1)
        swHofR[i] = 4
        DIM g AS INTEGER : g = INT(215 + 40 * e)
        swFarbe[i] = RGBA(255, g, INT(150 + 90 * e), MAX(1, 255 - INT(255 * hell)))
        swHof[i] = RGBA(255, 190, 120, MAX(1, 255 - INT(70 * hell)))
    NEXT
    CIRCLES(swX, swY, swHofR, swHof, swAnz)
    CIRCLES(swX, swY, swR, swFarbe, swAnz)
END SUB

SUB beschriftung(takt AS FLOAT)
    mittig("N A C H T F L U G", 250, 64, zeigen(takt, 3, 11), TRUE)
    zweisprachig("eine Demo in Drachenhauch", "a demo in Drachenhauch", 352, 24, zeigen(takt, 5, 11), FALSE)
    zweisprachig("von Hans Schnorrenberger", "by Hans Schnorrenberger", 432, 22, zeigen(takt, 6, 11), FALSE)
    zweisprachig("Musik und Bild aus einem Programm -- ohne eine einzige Klang- oder Bilddatei", _
        "Music and pictures from one program -- without a single sound or image file", 636, 18, zeigen(takt, 7, 14), FALSE)
    ' kleine Hinweise, was gerade zu sehen ist
    zweisprachig("Tiefflug: Gelände aus Rauschen, im Fragment-Shader berechnet", _
        "Low flight: terrain made of noise, computed in a fragment shader", 646, 18, zeigen(takt, 17, 22), FALSE)
    zweisprachig("Lichttunnel: die Wellen laufen auf der Audio-Uhr", _
        "Light tunnel: the waves run on the audio clock", 646, 18, zeigen(takt, 33, 38), FALSE)
    zweisprachig("Sternennebel: Volumen-Raymarching", _
        "Star nebula: volume raymarching", 646, 18, zeigen(takt, 49, 54), FALSE)
    zweisprachig(ZAHL$(STERNE) + " Lichtspuren in einem Zeichenaufruf, die Scheibe im Shader", _
        REPLACE$(ZAHL$(STERNE), ".", ",") + " light trails in one draw call, the disc in a shader", 646, 18, zeigen(takt, 65, 70), FALSE)
    ' Abspann
    mittig("Nachtflug", 200, 56, zeigen(takt, 83, 93), TRUE)
    zweisprachig("von Hans Schnorrenberger", "by Hans Schnorrenberger", 290, 26, zeigen(takt, 83.5, 93), FALSE)
    zweisprachig("Musik: Uplifting Trance, 128 BPM, a-Moll -- synthetisiert mit AUDIO_NOTE und einer Audio-Uhr", _
        "Music: uplifting trance, 128 BPM, A minor -- synthesised with AUDIO_NOTE and an audio clock", 380, 19, zeigen(takt, 84, 93), FALSE)
    zweisprachig("Bild: GLSL-Raymarching und 3D-Instancing in dhrt", _
        "Pictures: GLSL raymarching and 3D instancing in dhrt", 440, 19, zeigen(takt, 85, 93), FALSE)
    ' "Drachenhauch" schreibt der Lichterschwarm (schwarmZeichnen)
END SUB

' --- Ablauf ---------------------------------------------------------------------
' Szenenwechsel durch Licht: am Ende einer Szene waechst aus der Mitte ein
' Lichtkreis, bis er das Bild fuellt; die naechste Szene erscheint aus der
' Mitte, waehrend das Licht nach aussen weicht. Je ueber einen Takt.
FUNCTION vorEnde(takt AS FLOAT, ende AS FLOAT) AS FLOAT
    DIM f AS FLOAT : f = CLAMP(takt - (ende - 1.0), 0.0, 1.0)
    RETURN f * f * (3.0 - 2.0 * f)
END FUNCTION
FUNCTION nachBeginn(takt AS FLOAT, beginn AS FLOAT) AS FLOAT
    DIM f AS FLOAT : f = CLAMP(takt - beginn, 0.0, 1.0)
    RETURN f * f * (3.0 - 2.0 * f)
END FUNCTION
SUB uebergang(sh AS INTEGER, aus AS FLOAT, ein AS FLOAT, r AS FLOAT, g AS FLOAT, b AS FLOAT)
    SHADER_SET(sh, "aus", aus)
    SHADER_SET(sh, "ein", ein)
    SHADER_SET3(sh, "uebLicht", r, g, b)
END SUB

' Die Farbe jedes Akkords: a-Moll violett, F tuerkis, C gold, G rosa, F
' gruenblau, G pink, e-Moll tiefblau, a-Moll hellviolett. Die Bilder ziehen
' ihr weich nach.
DIM akkR AS ARRAY OF FLOAT : akkR = [0.55, 0.15, 1.0, 1.0, 0.2, 1.0, 0.3, 0.75]
DIM akkG AS ARRAY OF FLOAT : akkG = [0.3, 0.85, 0.72, 0.35, 1.0, 0.45, 0.45, 0.55]
DIM akkB AS ARRAY OF FLOAT : akkB = [1.0, 1.0, 0.3, 0.65, 0.75, 0.8, 1.0, 1.0]
DIM farbeR AS FLOAT : farbeR = akkR[0]
DIM farbeG AS FLOAT : farbeG = akkG[0]
DIM farbeB AS FLOAT : farbeB = akkB[0]

' --- Startbild: die Klaenge entstehen ------------------------------------------
' Bevor die Musik beginnt, werden alle Klaenge gebaut (rund zwei Sekunden) --
' Stueck fuer Stueck, damit das Bild dabei ruhig bleibt: ein Titel und eine
' feine Linie, die sich fuellt. Ohne Ton gibt es nichts zu bauen.
SUB startbild(anteil AS FLOAT, bild AS INTEGER)
    CLS(BLACK)
    DIM auf AS FLOAT : auf = MIN(1.0, bild / 40.0)
    mittig("N A C H T F L U G", 300, 40, 0.55 * auf, TRUE)
    zweisprachig("die Klänge entstehen ...", "the sounds are being synthesised ...", 372, 16, 0.6 * auf, FALSE)
    DIM b AS INTEGER : b = 320
    DIM x AS INTEGER : x = (BREITE - b) \ 2
    BOX(x, 440, x + b, 441, RGB(30, 34, 52))
    BOX(x, 440, x + INT(b * anteil), 441, RGB(150, 180, 240))
    FLIP()
END SUB

schwarmVorbereiten()
IF tonDa() THEN
    DIM bild AS INTEGER
    DIM fertig AS BOOLEAN
    WHILE NOT fertig AND NOT QUITREQUESTED() AND NOT KEYHIT(KEY_ESCAPE)
        DIM t0 AS FLOAT : t0 = GET_TIME()
        WHILE GET_TIME() - t0 < 0.012
            IF NOT vorbauen() THEN
                fertig = TRUE
                EXIT WHILE
            END IF
        WEND
        startbild(bauStand / bauGesamt(), bild)
        bild = bild + 1
    WEND
END IF

musikStarten(abTakt)
' der Mitschnitt: der fertige Mix hinter allen Effekten, so wie man ihn hoert
IF mitschnitt <> "" THEN
    IF mitTon THEN AUDIO_RECORD_START(400) ELSE PRINT "kein Ton -- kein Mitschnitt"
END IF
DIM start AS FLOAT : start = GET_TIME()
DIM beenden AS BOOLEAN
DIM bilder AS INTEGER
DIM spitze AS FLOAT
DIM letztesBild AS FLOAT : letztesBild = GET_TIME()

WHILE NOT beenden
    IF QUITREQUESTED() OR KEYHIT(KEY_ESCAPE) THEN beenden = TRUE
    IF KEYHIT(KEY_F11) THEN SET_FULLSCREEN(NOT WINDOW_IS_FULLSCREEN())
    musikPlanen()
    DIM takt AS FLOAT : takt = musikTakt()
    DIM zeit AS FLOAT : zeit = GET_TIME() - start + abTakt * 1.875
    DIM kick AS FLOAT : kick = musikKick()
    IF musikZuEnde() THEN beenden = TRUE

    ' Melodie und Akkord
    DIM melTon AS FLOAT : melTon = musikTon()
    DIM nr AS INTEGER : nr = musikAkkord()
    DIM jetzt AS FLOAT : jetzt = GET_TIME()
    DIM zieh AS FLOAT : zieh = 1.0 - EXP(-(jetzt - letztesBild) * 2.5)
    letztesBild = jetzt
    farbeR = farbeR + (akkR[nr] - farbeR) * zieh
    farbeG = farbeG + (akkG[nr] - farbeG) * zieh
    farbeB = farbeB + (akkB[nr] - farbeB) * zieh

    CLS(BLACK)
    DIM sh AS INTEGER
    IF takt < AB_AUFBAU THEN
        sh = shOzean
        SHADER_SET(sh, "hell", MIN(1.0, takt / 2.0 + 0.05))
        SHADER_SET(sh, "licht", CLAMP(takt / AB_AUFBAU, 0.0, 1.0))
        SHADER_SET(sh, "morgen", 0.0)
        uebergang(sh, vorEnde(takt, AB_AUFBAU), 1.0, 0.55, 1.0, 0.8)
    ELSEIF takt < AB_HOCH1 THEN
        sh = shFlug
        SHADER_SET(sh, "hell", 1.0)
        SHADER_SET(sh, "fort", (takt - AB_AUFBAU) / 16.0)
        uebergang(sh, vorEnde(takt, AB_HOCH1), nachBeginn(takt, AB_AUFBAU), IIF(takt < AB_AUFBAU + 1, 0.55, 0.5), IIF(takt < AB_AUFBAU + 1, 1.0, 0.95), IIF(takt < AB_AUFBAU + 1, 0.8, 1.0))
    ELSEIF takt < AB_PAUSE THEN
        sh = shTunnel
        SHADER_SET(sh, "hell", 1.0)
        uebergang(sh, vorEnde(takt, AB_PAUSE), nachBeginn(takt, AB_HOCH1), IIF(takt < AB_HOCH1 + 1, 0.5, 0.92), IIF(takt < AB_HOCH1 + 1, 0.95, 0.88), 1.0)
    ELSEIF takt < AB_HOCH2 THEN
        sh = shNebel
        ' das Ende ist schon hell (der Nebel endet im Weiss des Hoehepunkts)
        SHADER_SET(sh, "hell", 1.0)
        SHADER_SET(sh, "fort", (takt - AB_PAUSE) / 16.0)
        uebergang(sh, 0.0, nachBeginn(takt, AB_PAUSE), 0.92, 0.88, 1.0)
    ELSEIF takt < AB_AUS THEN
        sh = shGlanz
        galaxieZeichnen(zeit, kick, (takt - AB_HOCH2) / 16.0, takt, melTon)
        SHADER_SET3(sh, "kamera", kamX, kamY, kamZ)
        SHADER_SET(sh, "fort", (takt - AB_HOCH2) / 16.0)
        SHADER_SET(sh, "hell", 1.0)
        ' der weisse Blitz auf der Eins des Hoehepunkts
        ' ... und ein kleinerer auf der Rueckung
        SHADER_SET(sh, "blitz", MAX(MAX(0.0, 1.0 - (takt - AB_HOCH2) * 1.5), 0.6 * MAX(0.0, 1.0 - (takt - AB_RUECKUNG) * 2.5) * IIF(takt >= AB_RUECKUNG, 1.0, 0.0)))
        uebergang(sh, vorEnde(takt, AB_AUS), 1.0, 1.0, 0.82, 0.6)
    ELSE
        sh = shOzean
        SHADER_SET(sh, "hell", CLAMP((TAKTE + 1.5 - takt) * 2.0, 0.0, 1.0))
        SHADER_SET(sh, "licht", 0.6)
        SHADER_SET(sh, "morgen", CLAMP((takt - AB_AUS) / 12.0, 0.0, 1.0))
        uebergang(sh, 0.0, nachBeginn(takt, AB_AUS), 1.0, 0.82, 0.6)
    END IF
    SHADER_SET(sh, "time", zeit)
    SHADER_SET(sh, "kick", kick)
    SHADER_SET(sh, "takt", takt)
    SHADER_SET(sh, "guete", guete)
    SHADER_SET(sh, "ton", melTon)
    SHADER_SET(sh, "hoehe", tonHoehe)
    SHADER_SET3(sh, "farbe", farbeR, farbeG, farbeB)
    beschriftung(takt)
    IF takt >= AB_AUS THEN schwarmZeichnen(takt, zeit)
    POSTFX(sh)
    FLIP()
    bilder = bilder + 1
    IF messen AND mitTon THEN spitze = MAX(spitze, AUDIO_PEAK())
WEND
IF messen THEN
    PRINT "Bilder je Sekunde: "; FORMAT$(bilder / MAX(0.001, GET_TIME() - start), "%.1f")
    IF mitTon THEN PRINT "Spitze im Mischer: "; FORMAT$(spitze, "%.2f")
END IF
IF mitschnitt <> "" AND mitTon THEN
    AUDIO_SAVE_WAV(AUDIO_RECORD_STOP(), mitschnitt)
    PRINT "Mitschnitt: "; mitschnitt
END IF
musikStoppen()
