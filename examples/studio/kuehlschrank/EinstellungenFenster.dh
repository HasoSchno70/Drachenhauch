' Die Einstellungen -- wie SettingsDialog der Python-App, mit den Reitern
' Allgemein, Benachrichtigungen, Ablaufdaten, Lagerorte, Supermärkte und
' Datenbank. Die ersten drei und der Standard-Markt gelten mit „Speichern“;
' was auf den Reitern Lagerorte, Supermärkte und Datenbank geschieht, gilt
' sofort (wie dort) -- datenGeaendert sagt es dem Hauptfenster. Geladen und gespeichert wird über die
' Klasse Einstellungen; „Zurücksetzen“ stellt die Vorgaben ins Fenster, erst
' „Speichern“ übernimmt sie. Ohne Benachrichtigungen sind ihre Häkchen,
' das Intervall und die Zusammenfassung gesperrt (_toggle_options), ohne
' Zusammenfassung auch ihre Uhrzeit.
'
' Anders als dort: Dunkles Design, Sprache und Barcode-Cache wirken (dort
' standen sie im Fenster und wurden nie gelesen; die Sprache gilt ab dem
' nächsten Start), die Uhrzeit behält ihre Minuten, und „Zurücksetzen“ sagt, dass
' noch nichts gespeichert ist (dort hieß es „Einstellungen zurückgesetzt!“,
' und „Abbrechen“ danach behielt die alten).
CLASS EinstellungenFenster EXTENDS EinstellungenFenster_Basis
    DIM gespeichert AS BOOLEAN
    ' Lagerorte, Märkte oder die Datenbank haben sich geändert.
    DIM datenGeaendert AS BOOLEAN
    ' Je Zeile der Tabellen der Name; das Sinnbild für einen neuen Ort.
    DIM ortNamen AS ARRAY OF STRING
    DIM marktNamen AS ARRAY OF STRING
    DIM neuSinnbild AS STRING

    SUB Geoeffnet()
        DIM e AS Einstellungen : e = einstellungen()
        DIM u AS ARRAY OF STRING : u = einheiten()
        IF ARRAY_INDEXOF(u, e.einheit) < 0 THEN ARRAY_PUSH(u, e.einheit)
        GUI_SET_DROPDOWN(Self.einheitWahl, u)
        ' Jede Sprache in ihrem eigenen Namen -- nicht übersetzt.
        GUI_SET_DROPDOWN(Self.spracheWahl, ["Deutsch", "English"])
        Self.neuSinnbild = "📦"
        Self.orteFuellen()
        Self.maerkteFuellen(gewaehlterMarkt$())
        Self.dbFuellen()
        Self.anzeigen(e)
    END SUB

    SUB anzeigen(e AS Einstellungen)
        GUI_SET_CHECKED(Self.dunkelKasten, e.dunkel)
        GUI_DROPDOWN_SET_SELECTED(Self.spracheWahl, IIF(e.sprache = "en", 1, 0))
        GUI_SET_VALUE(Self.auffrischenZahl, e.auffrischenS)
        GUI_SET_CHECKED(Self.cacheKasten, e.cacheAn)
        GUI_SET_TEXT(Self.einheitWahl, e.einheit)
        GUI_SET_CHECKED(Self.meldungenKasten, e.meldungenAn)
        GUI_SET_CHECKED(Self.abgelaufenKasten, e.beiAbgelaufen)
        GUI_SET_CHECKED(Self.heuteKasten, e.beiHeute)
        GUI_SET_CHECKED(Self.morgenKasten, e.beiMorgen)
        GUI_SET_CHECKED(Self.baldKasten, e.beiBald)
        GUI_SET_CHECKED(Self.minimumKasten, e.beiMinimum)
        GUI_SET_VALUE(Self.pruefZahl, e.pruefMin)
        GUI_SET_CHECKED(Self.tagesKasten, e.tagesAn)
        GUI_SET_TIME(Self.tagesZeit, e.tagesZeit$())
        GUI_SET_VALUE(Self.warnZahl, e.warnTage)
        GUI_SET_VALUE(Self.haltbarZahl, e.haltbarTage)
        Self.schalten()
        Self.vorschau()
    END SUB

    ' Was im Fenster steht, als Einstellungen.
    FUNCTION auslesen() AS Einstellungen
        DIM e AS Einstellungen : e = NEW Einstellungen()
        e.vorgaben()
        e.dunkel = GUI_CHECKED(Self.dunkelKasten)
        e.sprache = IIF(GUI_DROPDOWN_SELECTED(Self.spracheWahl) = 1, "en", "de")
        e.auffrischenS = grenzen(INT(GUI_VALUE(Self.auffrischenZahl)), 5, 300)
        e.cacheAn = GUI_CHECKED(Self.cacheKasten)
        IF TRIM$(GUI_TEXT(Self.einheitWahl)) <> "" THEN e.einheit = TRIM$(GUI_TEXT(Self.einheitWahl))
        e.meldungenAn = GUI_CHECKED(Self.meldungenKasten)
        e.beiAbgelaufen = GUI_CHECKED(Self.abgelaufenKasten)
        e.beiHeute = GUI_CHECKED(Self.heuteKasten)
        e.beiMorgen = GUI_CHECKED(Self.morgenKasten)
        e.beiBald = GUI_CHECKED(Self.baldKasten)
        e.beiMinimum = GUI_CHECKED(Self.minimumKasten)
        e.pruefMin = grenzen(INT(GUI_VALUE(Self.pruefZahl)), 15, 1440)
        e.tagesAn = GUI_CHECKED(Self.tagesKasten)
        DIM z AS ARRAY OF STRING : z = SPLIT(GUI_TIME$(Self.tagesZeit), ":")
        IF LEN(z) >= 2 THEN
            e.tagesStunde = grenzen(INT(VAL(z[0])), 0, 23)
            e.tagesMinute = grenzen(INT(VAL(z[1])), 0, 59)
        END IF
        e.warnTage = grenzen(INT(GUI_VALUE(Self.warnZahl)), 1, 14)
        e.haltbarTage = grenzen(INT(GUI_VALUE(Self.haltbarZahl)), 1, 365)
        RETURN e
    END FUNCTION

    ' Wie _toggle_options; die Uhrzeit hängt auch an der Zusammenfassung.
    SUB schalten()
        DIM an AS BOOLEAN : an = GUI_CHECKED(Self.meldungenKasten)
        DIM w AS GUI_WIDGET
        FOR EACH w IN [Self.abgelaufenKasten, Self.heuteKasten, Self.morgenKasten, Self.baldKasten, Self.minimumKasten, Self.pruefZahl, Self.tagesKasten]
            GUI_SET_ENABLED(w, an)
        NEXT
        GUI_SET_ENABLED(Self.tagesZeit, an AND GUI_CHECKED(Self.tagesKasten))
    END SUB

    SUB meldungenKasten_Geaendert()
        Self.schalten()
    END SUB

    SUB tagesKasten_Geaendert()
        Self.schalten()
    END SUB

    ' Was mit der Schwelle als „bald“ gilt -- an einem Datum gezeigt.
    SUB vorschau()
        DIM n AS INTEGER : n = grenzen(INT(GUI_VALUE(Self.warnZahl)), 1, 14)
        DIM bis AS STRING : bis = tagePlus$(n)
        ' {0} Tag, {1} Monat, {2} Jahr -- die Reihenfolge sagt die Übersetzung.
        DIM w AS ARRAY OF STRING : w = [MID$(bis, 8, 2), MID$(bis, 5, 2), LEFT$(bis, 4), STR$(n)]
        GUI_SET_TEXT(Self.warnBeispiel, IIF(n = 1, trf$("Bald ablaufend heißt: heute bis {0}.{1}.{2} ({3} Tag).", w), trf$("Bald ablaufend heißt: heute bis {0}.{1}.{2} ({3} Tage).", w)))
    END SUB

    SUB warnZahl_Geaendert()
        Self.vorschau()
    END SUB

    SUB knopfTest_Klick()
        IF meldungSenden(nachrichtNeu(tr$("🧪 Test-Benachrichtigung"), tr$("Dies ist ein Test der Kühlschrank-App Benachrichtigungen."), FALSE)) THEN
            GUI_TOAST(Self.studioWin, tr$("Test-Benachrichtigung gesendet."), "erfolg")
        ELSE
            GUI_TOAST(Self.studioWin, tr$("Das System hat die Benachrichtigung nicht angenommen."), "warnung")
        END IF
    END SUB

    SUB knopfZuruecksetzen_Klick()
        IF Frage(tr$("Alle Einstellungen auf Standard zurücksetzen?"), "Ja|Nein", tr$("Zurücksetzen")) <> 1 THEN RETURN
        DIM e AS Einstellungen : e = NEW Einstellungen()
        e.vorgaben()
        Self.anzeigen(e)
        GUI_DROPDOWN_SET_SELECTED(Self.marktStandard, 0)
        GUI_TOAST(Self.studioWin, tr$("Vorgaben eingesetzt -- „Speichern“ übernimmt sie."), "info")
    END SUB

    SUB knopfSpeichern_Klick()
        DIM e AS Einstellungen : e = Self.auslesen()
        e.speichern()
        ' Der Standard-Markt erst hier -- die Python-App schrieb ihn bei jeder
        ' Wahl in der Klappliste (auch beim Zurücksetzen), „Abbrechen“ nahm
        ' ihn nicht zurück.
        standardMarktSetzen(IIF(GUI_DROPDOWN_SELECTED(Self.marktStandard) > 0, GUI_DROPDOWN_TEXT(Self.marktStandard), ""))
        themaSetzen(e.dunkel)
        ' Die Fenster sind gebaut -- die Sprache wechselt beim nächsten Start
        ' (wie im Studio), gesagt in beiden.
        IF e.sprache <> IIF(Sprache$() = "en", "en", "de") THEN
            IF e.sprache = "en" THEN
                Meldung("Beim nächsten Start ist die Oberfläche englisch." + CHR$(10) + "The interface will be English at the next start.", "Sprache / Language")
            ELSE
                Meldung("The interface will be German at the next start." + CHR$(10) + "Beim nächsten Start ist die Oberfläche deutsch.", "Language / Sprache")
            END IF
        END IF
        Self.gespeichert = TRUE
        Self.Zumachen()
    END SUB

    SUB knopfAbbrechen_Klick()
        Self.Zumachen()
    END SUB

    ' --- Lagerorte ---------------------------------------------------------------
    SUB orteFuellen()
        GUI_TABLE_CLEAR(Self.ortTabelle)
        Self.ortNamen = lagerorte()
        DIM n AS STRING
        FOR EACH n IN Self.ortNamen
            DIM f AS INTEGER : f = ortFarbe(n)
            DIM z AS INTEGER : z = GUI_TABLE_ADD_ROW(Self.ortTabelle, [ortSinnbild$(n), n, "#" + RIGHT$("000000" + HEX$(f), 6), STR$(ortEintraege(n)), tr$("🎨 Farbe"), "🗑"])
            DIM s AS INTEGER
            FOR EACH s IN [SP_O_SINNBILD, SP_O_FARBKNOPF, SP_O_WEG]
                GUI_TABLE_CELL_KIND(Self.ortTabelle, z, s, "knopf")
            NEXT
            DIM hell AS BOOLEAN : hell = ((f SHR 16) BAND 255) * 3 + ((f SHR 8) BAND 255) * 6 + (f BAND 255) > 1280
            GUI_TABLE_CELL_COLOR(Self.ortTabelle, z, SP_O_FARBE, IIF(hell, &H000000, &HFFFFFF), f)
        NEXT
        GUI_SET_TEXT(Self.ortSinnbildKnopf, Self.neuSinnbild)
    END SUB

    ' Ein Sinnbild aus AVAILABLE_ICONS; "" bei Abbrechen.
    FUNCTION sinnbildWaehlen$(jetzt AS STRING) AS STRING
        DIM l AS ARRAY OF STRING : l = ortSinnbilder()
        DIM namen AS ARRAY OF STRING : namen = []
        DIM vorgabe AS INTEGER : vorgabe = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(l) - 1
            DIM f AS ARRAY OF STRING : f = SPLIT(l[i], "|")
            ARRAY_PUSH(namen, f[0] + "  " + sinnbildName$(f[1]))
            IF f[0] = jetzt THEN vorgabe = i
        NEXT
        i = Auswahl(tr$("Sinnbild:"), namen, vorgabe, tr$("Sinnbild wählen"))
        IF i < 0 THEN RETURN ""
        RETURN SPLIT(l[i], "|")[0]
    END FUNCTION

    SUB ortSinnbildKnopf_Klick()
        DIM s AS STRING : s = Self.sinnbildWaehlen$(Self.neuSinnbild)
        IF s = "" THEN RETURN
        Self.neuSinnbild = s
        GUI_SET_TEXT(Self.ortSinnbildKnopf, s)
    END SUB

    SUB ortNameFeld_Enter()
        Self.knopfOrtNeu_Klick()
    END SUB

    SUB knopfOrtNeu_Klick()
        DIM name AS STRING : name = TRIM$(GUI_TEXT(Self.ortNameFeld))
        DIM m AS STRING : m = ortAnlegen$(name, Self.neuSinnbild)
        IF m <> "" THEN
            Meldung(m, tr$("Lagerort"))
            RETURN
        END IF
        GUI_SET_TEXT(Self.ortNameFeld, "")
        Self.neuSinnbild = "📦"
        Self.datenGeaendert = TRUE
        Self.orteFuellen()
        GUI_TOAST(Self.studioWin, trf$("Lagerort „{0}“ hinzugefügt!", [name]), "erfolg")
    END SUB

    SUB ortTabelle_Zelle(zeile AS INTEGER, spalte AS INTEGER)
        IF zeile < 0 OR zeile >= LEN(Self.ortNamen) THEN RETURN
        DIM n AS STRING : n = Self.ortNamen[zeile]
        IF spalte = SP_O_SINNBILD THEN
            DIM s AS STRING : s = Self.sinnbildWaehlen$(ortSinnbild$(n))
            IF s = "" THEN RETURN
            ortAussehenSetzen(n, ortFarbe(n), s)
        ELSEIF spalte = SP_O_FARBKNOPF THEN
            DIM f AS INTEGER : f = FarbeWaehlen(ortFarbe(n), trf$("Farbe für {0}", [n]))
            IF f < 0 THEN RETURN
            ortAussehenSetzen(n, f, ortSinnbild$(n))
        ELSEIF spalte = SP_O_WEG THEN
            IF Frage(trf$("Lagerort „{0}“ löschen?", [n]), tr$("Löschen|Abbrechen"), tr$("Lagerort löschen")) <> 1 THEN RETURN
            DIM m AS STRING : m = ortLoeschen$(n)
            IF m <> "" THEN
                Meldung(m, tr$("Lagerort"))
                RETURN
            END IF
            GUI_TOAST(Self.studioWin, trf$("Lagerort „{0}“ gelöscht.", [n]), "erfolg")
        ELSE
            RETURN
        END IF
        Self.datenGeaendert = TRUE
        Self.orteFuellen()
    END SUB

    SUB knopfOrteZurueck_Klick()
        IF Frage(tr$("Alle Lagerort-Farben und Sinnbilder auf Standard zurücksetzen?"), "Ja|Nein", tr$("Zurücksetzen")) <> 1 THEN RETURN
        ortAussehenZuruecksetzen()
        Self.datenGeaendert = TRUE
        Self.orteFuellen()
        GUI_TOAST(Self.studioWin, tr$("Lagerort-Farben und Sinnbilder zurückgesetzt."), "erfolg")
    END SUB

    ' --- Supermärkte -------------------------------------------------------------
    ' standard: welcher Markt in der Klappliste stehen soll.
    SUB maerkteFuellen(standard AS STRING)
        Self.marktNamen = marktListe()
        ' Der erste Eintrag zählt über den Index, nicht über seinen Text.
        DIM s AS ARRAY OF STRING : s = [tr$("-- Kein Standard --")]
        DIM v AS ARRAY OF STRING : v = [tr$("-- Standardplan --")]
        DIM m AS STRING
        FOR EACH m IN Self.marktNamen
            ARRAY_PUSH(s, m)
            ARRAY_PUSH(v, m)
        NEXT
        GUI_SET_DROPDOWN(Self.marktStandard, s)
        GUI_DROPDOWN_SET_SELECTED(Self.marktStandard, ARRAY_INDEXOF(Self.marktNamen, standard) + 1)
        GUI_SET_DROPDOWN(Self.marktVorlage, v)
        GUI_DROPDOWN_SET_SELECTED(Self.marktVorlage, 0)
        GUI_TABLE_CLEAR(Self.marktTabelle)
        FOR EACH m IN Self.marktNamen
            DIM ein AS BOOLEAN : ein = istEingebaut(m)
            DIM eigen AS BOOLEAN : eigen = hatEigenenPlan(m)
            DIM art AS STRING : art = IIF(ein AND eigen, tr$("eingebaut, angepasst"), IIF(ein, tr$("eingebaut"), tr$("eigener")))
            DIM z AS INTEGER : z = GUI_TABLE_ADD_ROW(Self.marktTabelle, [IIF(ein, "🏪", "⭐"), m, art, STR$(gangZahl(gangplan(m))), "✏️", IIF(eigen, IIF(ein, "↺", "🗑"), "")])
            GUI_TABLE_CELL_KIND(Self.marktTabelle, z, SP_M_BEARBEITEN, "knopf")
            IF eigen THEN GUI_TABLE_CELL_KIND(Self.marktTabelle, z, SP_M_WEG, "knopf")
        NEXT
    END SUB

    FUNCTION standardJetzt$() AS STRING
        IF GUI_DROPDOWN_SELECTED(Self.marktStandard) <= 0 THEN RETURN ""
        RETURN GUI_DROPDOWN_TEXT(Self.marktStandard)
    END FUNCTION

    SUB marktNameFeld_Enter()
        Self.knopfMarktNeu_Klick()
    END SUB

    SUB knopfMarktNeu_Klick()
        DIM name AS STRING : name = TRIM$(GUI_TEXT(Self.marktNameFeld))
        DIM vorlage AS STRING : vorlage = ""
        IF GUI_DROPDOWN_SELECTED(Self.marktVorlage) > 0 THEN vorlage = GUI_DROPDOWN_TEXT(Self.marktVorlage)
        DIM m AS STRING : m = marktAnlegen$(name, vorlage)
        IF m <> "" THEN
            Meldung(m, tr$("Supermarkt"))
            RETURN
        END IF
        GUI_SET_TEXT(Self.marktNameFeld, "")
        Self.datenGeaendert = TRUE
        Self.maerkteFuellen(Self.standardJetzt$())
        GUI_TOAST(Self.studioWin, trf$("Supermarkt „{0}“ erstellt!", [name]), "erfolg")
        IF Frage(trf$("Möchtest du den Gangplan von „{0}“ jetzt bearbeiten?", [name]), "Ja|Nein", tr$("Gangplan bearbeiten")) = 1 THEN Self.planBearbeiten(name)
    END SUB

    SUB planBearbeiten(markt AS STRING)
        DIM f AS GangplanFenster : f = NEW GangplanFenster()
        f.markt = markt
        f.ZeigenModal()
        IF NOT f.gesichert THEN RETURN
        Self.datenGeaendert = TRUE
        Self.maerkteFuellen(Self.standardJetzt$())
        GUI_TOAST(Self.studioWin, trf$("Gangplan für „{0}“ gespeichert!", [markt]), "erfolg")
    END SUB

    SUB marktTabelle_Zelle(zeile AS INTEGER, spalte AS INTEGER)
        IF zeile < 0 OR zeile >= LEN(Self.marktNamen) THEN RETURN
        DIM m AS STRING : m = Self.marktNamen[zeile]
        IF spalte = SP_M_BEARBEITEN THEN
            Self.planBearbeiten(m)
        ELSEIF spalte = SP_M_WEG AND hatEigenenPlan(m) THEN
            DIM t AS STRING : t = IIF(istEingebaut(m), trf$("Den eigenen Gangplan von „{0}“ verwerfen? Danach gilt wieder der eingebaute.", [m]), trf$("Supermarkt „{0}“ wirklich löschen?", [m]))
            IF Frage(t, "Ja|Nein", tr$("Löschen")) <> 1 THEN RETURN
            DIM standard AS STRING : standard = Self.standardJetzt$()
            planLoeschen(m)
            IF standard = m AND NOT istEingebaut(m) THEN standard = ""
            Self.datenGeaendert = TRUE
            Self.maerkteFuellen(standard)
            GUI_TOAST(Self.studioWin, trf$("„{0}“ gelöscht.", [m]), "erfolg")
        END IF
    END SUB

    ' --- Datenbank ---------------------------------------------------------------
    SUB dbFuellen()
        ' Ein langer Pfad vorne gekürzt, ganz im Tooltip.
        DIM pfad AS STRING : pfad = dbDateiGanz$()
        GUI_SET_TEXT(Self.dbPfad, "📁 " + IIF(LEN(pfad) > 72, "…" + RIGHT$(pfad, 71), pfad))
        GUI_TOOLTIP(Self.dbPfad, pfad)
        GUI_SET_TEXT(Self.dbGroesse, trf$("Größe: {0}", [groesseText$(FILESIZE(dbDatei$()))]))
        GUI_SET_TEXT(Self.dbZahlen, trf$("{0} Produkte · {1} im Bestand · {2} Rezepte · {3} auf der Einkaufsliste", [STR$(dbZahl("SELECT COUNT(*) FROM products")), STR$(dbZahl("SELECT COUNT(*) FROM inventory")), _
            STR$(dbZahl("SELECT COUNT(*) FROM recipes")), STR$(dbZahl("SELECT COUNT(*) FROM shopping_list"))]))
    END SUB

    SUB dbMelden(text AS STRING, art AS STRING)
        GUI_SET_TEXT(Self.dbStatus, text)
        GUI_TOAST(Self.studioWin, text, art)
        Self.dbFuellen()
    END SUB

    SUB knopfSichern_Klick()
        Self.dbMelden(trf$("💾 Gesichert: {0}", [BASENAME(sicherungAnlegen$())]), "erfolg")
    END SUB

    ' Alles neu im Fenster, nachdem der Inhalt ersetzt ist.
    SUB allesNeu()
        Self.datenGeaendert = TRUE
        Self.anzeigen(einstellungen())
        Self.orteFuellen()
        Self.maerkteFuellen(gewaehlterMarkt$())
    END SUB

    ' KUEHL_SICHERUNG nennt die Datei ohne Dialog (für Prüfungen).
    SUB knopfEinspielen_Klick()
        DIM pfad AS STRING : pfad = GETENV$("KUEHL_SICHERUNG")
        IF pfad = "" THEN pfad = FILE_OPEN_DIALOG(tr$("Sicherung einspielen"), "db")
        IF pfad = "" THEN RETURN
        IF Frage(tr$("Der ganze Inhalt wird durch die Sicherung ersetzt:") + CHR$(10) + BASENAME(pfad) + CHR$(10) + CHR$(10) + tr$("Vorher entsteht eine Sicherung des jetzigen Stands."), tr$("Einspielen|Abbrechen"), tr$("Sicherung einspielen")) <> 1 THEN RETURN
        DIM m AS STRING : m = sicherungEinspielen$(pfad)
        IF m <> "" THEN
            Self.dbMelden("❗ " + m, "fehler")
            RETURN
        END IF
        Self.allesNeu()
        Self.dbMelden(trf$("📥 Eingespielt. Der Stand davor: {0}", [BASENAME(vorEinspielen)]), "erfolg")
    END SUB

    ' KUEHL_EXPORT_ORDNER nennt den Ordner ohne Dialog (für Prüfungen).
    SUB knopfCsv_Klick()
        DIM ordner AS STRING : ordner = GETENV$("KUEHL_EXPORT_ORDNER")
        IF ordner = "" THEN ordner = FOLDER_DIALOG(tr$("Ordner für den Export"))
        IF ordner = "" THEN RETURN
        DIM l AS ARRAY OF STRING : l = csvExport(ordner)
        IF LEN(l) = 0 THEN
            Self.dbMelden(tr$("Keine Daten zum Exportieren."), "info")
        ELSE
            Self.dbMelden(trf$("📤 {0} Tabellen: {1}", [STR$(LEN(l)), JOIN$(l, ", ")]), "erfolg")
        END IF
    END SUB

    SUB knopfOptimieren_Klick()
        optimieren()
        Self.dbMelden(tr$("⚡ Optimiert: Indizes und Statistiken sind frisch."), "erfolg")
    END SUB

    SUB knopfAufraeumen_Klick()
        DIM a AS INTEGER, b AS INTEGER
        (a, b) = aufraeumen()
        Self.dbMelden(trf$("🧹 Aufgeräumt: {0} → {1} (gespart {2})", [groesseText$(a), groesseText$(b), groesseText$(MAX(0, a - b))]), "erfolg")
    END SUB

    ' Wie _create_new_database: erst fragen, ob gesichert werden soll, dann
    ' noch einmal; danach steht der Inhalt neu da -- ohne Neustart.
    SUB knopfNeuDb_Klick()
        DIM a AS INTEGER : a = Frage(tr$("Wirklich eine NEUE Datenbank? Alle Produkte, der Bestand, die Einkaufsliste und deine Rezepte werden gelöscht.") + CHR$(10) + CHR$(10) + tr$("Vorher eine Sicherung anlegen?"), tr$("Sichern und weiter|Ohne Sicherung|Abbrechen"), tr$("Neue Datenbank"))
        IF a <> 1 AND a <> 2 THEN RETURN
        DIM gesichert AS STRING : gesichert = ""
        IF a = 1 THEN gesichert = sicherungAnlegen$()
        IF Frage(tr$("Letzte Chance: Der Inhalt wird jetzt gelöscht und durch die Startdaten ersetzt. Fortfahren?"), "Ja|Nein", tr$("Neue Datenbank")) <> 1 THEN RETURN
        datenbankNeu(GUI_CHECKED(Self.rezepteKasten))
        Self.allesNeu()
        Self.dbMelden(IIF(gesichert <> "", trf$("🆕 Neu begonnen -- gesichert: {0}.", [BASENAME(gesichert)]), tr$("🆕 Neu begonnen.")), "erfolg")
    END SUB
END CLASS

CONST SP_O_SINNBILD = 0
CONST SP_O_FARBE = 2
CONST SP_O_FARBKNOPF = 4
CONST SP_O_WEG = 5
CONST SP_M_BEARBEITEN = 4
CONST SP_M_WEG = 5
