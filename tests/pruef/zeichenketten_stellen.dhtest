=== mid an spaeter stelle ist nicht teurer als vorn
' Die Schranke ist grosszuegig: vorher kostete jeder Aufruf gleich viel,
' egal wo -- 28 000 Aufrufe auf 200 000 Zeichen dauerten ueber 2 s.
DIM s AS STRING : s = "x" * 200000
DIM t0 AS FLOAT : t0 = TIMER()
DIM i AS INTEGER
DIM n AS INTEGER
FOR i = 0 TO 20000
    IF MID$(s, 5, 1) = "x" THEN n = n + 1
    IF LEFT$(s, 3) = "xxx" THEN n = n + 1
    IF INSTR(s, "x", 7) = 7 THEN n = n + 1
NEXT
PRINT n; " schnell "; (TIMER() - t0) < 0.5
--- erwartet
60003 schnell TRUE

=== ascii davor und umlaut dahinter
' Die Abkuerzung (M2, 2026-09-25): steht vor der Stelle nur ASCII, ist die
' Byte-Stelle die Zeichenstelle. Hier liegt der Umlaut mal hinter, mal vor
' der Stelle, und die Stelle mal am und mal hinter dem Ende.
IMPORT "regex"
DIM t AS STRING : t = "abcdef" + CHR$(252) + "gh" + CHR$(228) + "ij"
PRINT LEN(t); " "; MID$(t, 3, 2); "|"; MID$(t, 5, 3); "|"; MID$(t, 7); "|"; MID$(t, 11); "|"; MID$(t, 12); "|"
PRINT LEFT$(t, 7); "|"; RIGHT$(t, 4); "|"; INSTR(t, "g"); " "; INSTR(t, "i", 8); " "; INSTR(t, "a", 6); " "; INSTR(t, "", 11); " "; INSTR(t, "", 12)
PRINT REGEX_FIND_POS(t, "[a-j]", 7); " "; REGEX_FIND_POS(t, "h.i", 0); " "; REGEX_FIND_POS(t, "x", 11); " "; REGEX_FIND_POS(t, "x", 12)
--- erwartet
12 de|füg|ghäij|j||
abcdefü|häij|7 10 -1 11 12
(7, 1) (8, 3) (-1, 0) (-1, 0)
