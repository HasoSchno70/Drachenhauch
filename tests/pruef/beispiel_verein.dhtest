=== mysql: anlegen, gleichzeitig bearbeiten, zahlen, liste
' Ziel aus der Umgebung statt aus dem Argument, dann wie beim Start der App.
DB_CLOSE(db)
ziel = GETENV$("DH_TEST_MYSQL")
IF ziel = "" THEN
    PRINT "UEBERSPRINGEN: kein Testserver (DH_TEST_MYSQL)"
    END
END IF
db = DB_OPEN(ziel) : art = DB_KIND$(db) : tabellenAnlegen()
IMPORT "../ablauf.dh"
vaAblauf()
EXIT(0)
