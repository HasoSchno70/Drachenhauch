' Ueberlagerungen und Rueckmeldung (gui_ueber.rs, docs/entwurf-gui-wie-gtk.md
' Paket 1): Popover, Toast, Infoleiste, Suchfeld, Sinnbilder im Textfeld,
' Vorschlaege unter dem Textfeld. Format: docs/werkzeuge.md.
'
' Die Fenster sind randlos (GUI_WINDOW_CHROME FALSE) bei (0, 0): eine
' Widget-Lage ist dann eine Bildschirmlage. Tasten in den Aufnahmen:
' 256 ESC, 257 Enter, 264 runter, 341 Strg, 86 V. Getippt wird ueber die
' Zwischenablage (Strg+V) -- eine Aufnahme fuellt die Zeichenwarteschlange
' nicht.

=== der popover haengt unter dem knopf und geht per klick daneben zu
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM knopf AS GUI_WIDGET
knopf = GUI_BUTTON(w, "Optionen", 20, 20, 120, 30)
DIM anders AS GUI_WIDGET
anders = GUI_BUTTON(w, "Anders", 400, 300, 120, 30)
DIM pop AS GUI_WINDOW
pop = GUI_POPOVER(knopf, 200, 120)
AUTOMATION_PLAY("ev.txt")
DIM zu AS BOOLEAN : zu = FALSE
DIM an AS BOOLEAN : an = FALSE
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(knopf) THEN GUI_POPOVER_SHOW(pop)
    IF GUI_POPOVER_CLOSED(pop) THEN zu = TRUE
    IF GUI_CLICKED(anders) THEN an = TRUE
    n = n + 1
    IF n = 15 THEN PRINT "lage " + STR$(GUI_WINDOW_GET_X(pop)) + " " + STR$(GUI_WINDOW_GET_Y(pop)) + " offen " + STR$(GUI_WINDOW_SHOWN(pop))
    IF n = 40 THEN PRINT "zu " + STR$(zu) + " anders " + STR$(an) + " offen " + STR$(GUI_WINDOW_SHOWN(pop))
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 8
e 4 7 80 35 0 0 // Maus auf den Knopf
e 5 7 80 35 0 0
e 6 6 0 0 0 0 // runter
e 8 5 0 0 0 0 // hoch -> Popover auf
e 20 7 460 315 0 0 // Maus auf "Anders"
e 21 7 460 315 0 0
e 22 6 0 0 0 0
e 24 5 0 0 0 0

--- umgebung
DHRT_FRAMES=45
--- erwartet
lage 4 58 offen TRUE
zu TRUE anders FALSE offen FALSE

