=== wer art oder vorgabe aendert, nimmt das woertliche zurueck
' Dieselbe Vorgabe im Gitter (CURRENT_TIMESTAMP steht dort woertlich) laesst
' sie stehen; eine andere Art nimmt "sql" weg und baut die Tabelle neu auf.
IMPORT "kern.dh"
projOrdner = CWD$()
dateiAnlegen("kuehl.db")
DIM e AS Element : e = elementNeu("datenbank", "Vorrat")
e.schema = dbSchemaAusDatei$("kuehl.db", "kuehl.db")
DIM s AS JSON_HANDLE : s = dbSchema(e)
DIM t AS INTEGER : t = dbTabIndex(s, "inventory")
DIM k AS INTEGER : k = dbSpIndex(s, t, "created_at")
PRINT "gitter "; dbSpVorgabe$(s, t, k)
PRINT "[" + dbSpalteAendern$(e, "inventory", "created_at", "text", FALSE, FALSE, "CURRENT_TIMESTAMP") + "]"
PRINT "[" + dbSpalteAendern$(e, "inventory", "expiry_date", "text", FALSE, FALSE, "") + "]"
PRINT "[" + dbSpalteAendern$(e, "inventory", "notes", "text", FALSE, FALSE, "keine") + "]"
s = dbSchema(e)
spalten(s, "inventory")
DIM db AS DB_CONN : db = DB_OPEN("kuehl.db")
DIM r AS DB_RESULT : r = DB_QUERY(db, "PRAGMA table_info(inventory)")
WHILE DB_NEXT(r)
    IF DB_GET_STRING(r, 1) = "expiry_date" OR DB_GET_STRING(r, 1) = "created_at" OR DB_GET_STRING(r, 1) = "notes" THEN PRINT "datei "; DB_GET_STRING(r, 1); " "; DB_GET_STRING(r, 2); " "; IIF(DB_IS_NULL(r, 4), "-", DB_GET_STRING(r, 4))
WEND
r = DB_QUERY(db, "SELECT expiry_date FROM inventory")
IF DB_NEXT(r) THEN PRINT "zeile "; DB_GET_STRING(r, 0)
' Fehlt der Datei eine Spalte mit CURRENT_TIMESTAMP, baut der Abgleich die
' Tabelle neu auf (ADD COLUMN nimmt diese Vorgabe nicht).
DB_EXEC(db, "ALTER TABLE products DROP COLUMN updated_at")
DB_CLOSE(db)
PRINT "abgleich [" + dbAbgleichen$(e) + "]"
db = DB_OPEN("kuehl.db")
r = DB_QUERY(db, "PRAGMA table_info(products)")
WHILE DB_NEXT(r)
    IF DB_GET_STRING(r, 1) = "updated_at" OR DB_GET_STRING(r, 1) = "name" THEN PRINT "datei "; DB_GET_STRING(r, 1); " "; DB_GET_STRING(r, 2); " "; DB_GET_INT(r, 3); " "; IIF(DB_IS_NULL(r, 4), "-", DB_GET_STRING(r, 4))
WEND
r = DB_QUERY(db, "SELECT name, updated_at IS NOT NULL FROM products")
IF DB_NEXT(r) THEN PRINT "zeile "; DB_GET_STRING(r, 0); " "; DB_GET_INT(r, 1)
DB_CLOSE(db)
