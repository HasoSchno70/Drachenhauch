=== der leer-hinweis steht da, wenn der baum leer ist
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
GUI_WINDOW_CHROME(w, FALSE)
DIM mit AS GUI_WIDGET : mit = GUI_TREE(w, 10, 10, 280, 90)
GUI_TREE_PLACEHOLDER(mit, "Noch keine Dateien")
DIM ohne AS GUI_WIDGET : ohne = GUI_TREE(w, 10, 110, 280, 90)
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
    IF bild = 3 THEN SAVESCREENSHOT("t.png")
WEND
DIM b AS IMAGE : b = LOADIMAGE("t.png")
FUNCTION punkte(y0 AS INTEGER) AS INTEGER
    DIM n AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    FOR y = y0 TO y0 + 20
        FOR x = 20 TO 280
            IF GETPIXEL(b, x, y) <> GETPIXEL(b, 150, y0 + 50) THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
PRINT "mit "; punkte(16) > 20; " ohne "; punkte(116) > 20
--- umgebung
DHRT_FRAMES=5
--- erwartet
mit TRUE ohne FALSE

=== umbenennen und leer-hinweis stehen in der dhform
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 280, 200)
GUI_TREE_SET(t, "bearbeitbar", 1)
GUI_TREE_PLACEHOLDER(t, "Noch nichts")
DIM j AS STRING : j = GUI_TO_JSON(w)
GUI_WINDOW_DESTROY(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
DIM j2 AS STRING : j2 = GUI_TO_JSON(w2)
PRINT INSTR(j2, CHR$(34) + "bearbeitbar" + CHR$(34)) >= 0; " "; INSTR(j2, "Noch nichts") >= 0
--- erwartet
TRUE TRUE
