=== invalid regex throws gb error
' Ungueltige Regex (z.B. unbalanced paren) wirft DHRuntimeError,
IMPORT "regex"
PRINT REGEX_TEST("abc", "(unbalanced")
--- fehler
error: unclosed group

=== regex pattern cache (1)
' Wiederholte Aufrufe mit gleichem Pattern muessen funktionieren --
IMPORT "regex"
DIM i AS INTEGER
DIM count AS INTEGER
count = 0
FOR i = 1 TO 5
    IF REGEX_TEST("hello123", "[0-9]+") THEN count = count + 1
NEXT
PRINT count
--- erwartet
5

