=== die tab-reihenfolge ist setzbar
' Index > 0 zuerst, der Rest in Anlege-Reihenfolge.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM b1 AS GUI_WIDGET : b1 = GUI_BUTTON(w, "Eins", 10, 10, 80, 28)
DIM b2 AS GUI_WIDGET : b2 = GUI_BUTTON(w, "Zwei", 10, 50, 80, 28)
DIM b3 AS GUI_WIDGET : b3 = GUI_BUTTON(w, "Drei", 10, 90, 80, 28)
GUI_SET_TAB_INDEX(b3, 1)
GUI_SET_TAB_INDEX(b1, 2)
DIM letzt AS GUI_WIDGET : letzt = -1
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_FOCUSED() <> letzt THEN
        letzt = GUI_FOCUSED()
        PRINT GUI_TEXT(letzt)
    END IF
    CLS(0) : GUI_DRAW() : FLIP()
WEND
