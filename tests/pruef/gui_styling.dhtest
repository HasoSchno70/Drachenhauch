=== hover und leave feuern je einmal
IMPORT "gui"
SCREEN(300, 200, "E")
DIM w AS GUI_WINDOW
DIM b AS GUI_WIDGET
DIM f AS INTEGER
w = GUI_WINDOW("W", 10, 10, 280, 160)
b = GUI_BUTTON(w, "K", 20, 20, 100, 30)
SUB rein() : PRINT "rein" : END SUB
SUB raus() : PRINT "raus" : END SUB
GUI_ON_HOVER(b, rein)
GUI_ON_LEAVE(b, raus)
FOR f = 1 TO 8
    IF f = 2 THEN MOUSE_SET_POS(60, 55)
    IF f = 5 THEN MOUSE_SET_POS(290, 195)
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
NEXT
--- erwartet
rein
raus

=== fokus und blur folgen dem wechsel
IMPORT "gui"
SCREEN(300, 200, "F")
DIM w AS GUI_WINDOW
DIM t AS GUI_WIDGET
DIM u AS GUI_WIDGET
DIM f AS INTEGER
w = GUI_WINDOW("W", 10, 10, 280, 160)
t = GUI_TEXTINPUT(w, 20, 30, 200, 26)
u = GUI_TEXTINPUT(w, 20, 70, 200, 26)
SUB fa() : PRINT "A auf" : END SUB
SUB ba() : PRINT "A zu" : END SUB
SUB fb() : PRINT "B auf" : END SUB
GUI_ON_FOCUS(t, fa)
GUI_ON_BLUR(t, ba)
GUI_ON_FOCUS(u, fb)
FOR f = 1 TO 8
    IF f = 2 THEN GUI_FOCUS(t)
    IF f = 5 THEN GUI_FOCUS(u)
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
NEXT
--- erwartet
A auf
A zu
B auf

=== ereignisse ueberleben speichern und laden
' Der Form-Designer speichert Handler-NAMEN im .dhform; GUI_LOAD stellt
IMPORT "gui"
SCREEN(300, 200, "S")
DIM w AS GUI_WINDOW
DIM w2 AS GUI_WINDOW
DIM b AS GUI_WIDGET
DIM f AS INTEGER
SUB rein() : PRINT "rein" : END SUB
w = GUI_WINDOW("W", 10, 10, 280, 160)
b = GUI_BUTTON(w, "K", 20, 20, 100, 30)
GUI_ON_HOVER(b, rein)
w2 = GUI_FROM_JSON(GUI_TO_JSON(w))
GUI_WINDOW_DESTROY(w)
FOR f = 1 TO 6
    IF f = 2 THEN MOUSE_SET_POS(60, 55)
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
NEXT
--- erwartet
rein

