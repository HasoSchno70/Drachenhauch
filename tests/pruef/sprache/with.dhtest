=== with compound assign (1)
' `.x += 5` im WITH-Block.
CLASS Score
    DIM points AS INTEGER
END CLASS

DIM s AS Score
s = NEW Score()
s.points = 10
WITH s
    .points += 5
    .points *= 2
END WITH
PRINT s.points
--- erwartet
30

