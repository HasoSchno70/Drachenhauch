DIM f AS ARRAY OF STRING : f = SPLIT$(READLINES("_programm/probe.txt")[0], " ")
PRINT "bis zum bildlimit "; VAL(f[0]) >= 350
PRINT "kasten "; f[1]
--- system windows
--- erwartet
bis zum bildlimit FALSE
kasten keine

=== sfx: zurueckgestellt ist wieder gesichert
DIM prN AS INTEGER
DIM prS AS INTEGER
--- programm ../../examples/183_sfx_generator.dh nach SETFPS(60)
--- einschub nach FLIP()
prN = prN + 1
IF prN = 2 THEN GUI_DROPDOWN_SET_SELECTED(waehlWave, 1)
IF prN = 3 THEN
    GUI_DROPDOWN_SET_SELECTED(waehlWave, 0)
    SETWINDOWTITLE("DH-Kreuz-sfx-z")
    prS = PROCESS_START("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", GETENV$("PRSENDER"), "DH-Kreuz-sfx-z", "kreuz")
END IF
WRITEALL("probe.txt", STR$(prN) + " " + IIF(GUI_MODAL(), "frage", "keine"))

--- umgebung
DHRT_FRAMES=360
PRSENDER={sammlung}/_hilfen/fenstersender.ps1
