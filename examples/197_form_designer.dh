DIM ddThema AS GUI_WIDGET : ddThema = GUI_DROPDOWN(winInsp, 100, 172, INSP_B - 110, 24, ["(keines)", "glas_dunkel", "glas_hell", "dark", "light"])
DIM lblHinweis AS GUI_WIDGET : lblHinweis = GUI_LABEL(winInsp, "", 8, 36 + 19 * 34 + 10)
GUI_SET_WRAP(lblHinweis, INSP_B - 16)

DIM inspStumm AS BOOLEAN : inspStumm = FALSE     ' beim Fuellen nicht als Eingabe werten

' Felder je Art ein- und ausblenden ("" = alle aus).
SUB artSichtbar(art AS STRING)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(artFelder) - 1
        DIM an AS BOOLEAN : an = art <> "" AND ("," + art + ",") IN artArten[i]
        GUI_SET_VISIBLE(artFelder[i], an) : GUI_SET_VISIBLE(artLabels[i], an)
    NEXT
    GUI_SET_VISIBLE(cbZellen, art = "table")
END SUB

FUNCTION zahlText$(f AS FLOAT) AS STRING
    IF f = INT(f) THEN RETURN STR$(INT(f))
    RETURN STR$(f)
END FUNCTION

' Eine JSON-Liste als "a; b; c" -- Texte und Zahlen.
FUNCTION listeText$(pfad AS STRING) AS STRING
    IF NOT JSON_HAS(doc, pfad) THEN RETURN ""
    IF JSON_TYPE(doc, pfad) <> "array" THEN RETURN ""
    DIM teile AS ARRAY OF STRING : teile = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(doc, pfad) - 1
        DIM ep AS STRING : ep = pfad + "." + STR$(i)
        DIM et AS STRING : et = JSON_TYPE(doc, ep)
        IF et = "string" THEN ARRAY_PUSH(teile, JSON_GET_STRING(doc, ep))
        IF et = "number" THEN ARRAY_PUSH(teile, zahlText$(JSON_GET_FLOAT(doc, ep)))
    NEXT
    RETURN JOIN$(teile, "; ")
END FUNCTION

' "a; b; c" als JSON-Liste schreiben; leer entfernt den Schluessel.
SUB listeSetzen(pfad AS STRING, text AS STRING, alsZahl AS BOOLEAN)
    DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
    DIM n AS INTEGER : n = 0
    DIM t AS STRING
    FOR EACH t IN SPLIT$(text, ";")
        DIM s AS STRING : s = TRIM$(t)
        IF s <> "" THEN
            IF alsZahl THEN JSON_APPEND_INT(a, "", INT(VAL(s))) ELSE JSON_APPEND_STRING(a, "", s)
            n = n + 1
        END IF
    NEXT
    IF n = 0 THEN
        IF JSON_HAS(doc, pfad) THEN JSON_REMOVE(doc, pfad)
    ELSE
        JSON_SET_JSON(doc, pfad, a)
    END IF
END SUB

FUNCTION feldZahlText$(i AS INTEGER, feld AS STRING) AS STRING
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN ""
    RETURN zahlText$(JSON_GET_FLOAT(doc, wz$(i, feld)))
END FUNCTION

' Modell -> Felder je Art.
SUB artFuellen(i AS INTEGER)
    DIM art AS STRING : art = feldText$(i, "kind")
    artSichtbar(art)
    GUI_SET_TEXT(aEintraege, listeText$(wz$(i, "items")))
    GUI_SET_TEXT(aMin, feldZahlText$(i, "min"))
    GUI_SET_TEXT(aMax, feldZahlText$(i, "max"))
    GUI_SET_TEXT(aWert, feldZahlText$(i, "value"))
    GUI_SET_TEXT(aBeschr, feldText$(i, "placeholder"))
    DIM tp AS STRING : tp = wz$(i, "table")
    GUI_SET_TEXT(aSpalten, listeText$(tp + ".headers"))
    GUI_SET_TEXT(aBreiten, listeText$(tp + ".col_widths"))
    GUI_SET_TEXT(aArten, listeText$(tp + ".col_type"))
    DIM teile AS ARRAY OF STRING : teile = []
    DIM k AS INTEGER
    IF JSON_HAS(doc, tp + ".col_edit") THEN
        FOR k = 0 TO JSON_LEN(doc, tp + ".col_edit") - 1
            IF JSON_GET_BOOL(doc, tp + ".col_edit." + STR$(k)) THEN ARRAY_PUSH(teile, STR$(k))
        NEXT
    END IF
    GUI_SET_TEXT(aBearb, JOIN$(teile, "; "))
    teile = []
    IF JSON_HAS(doc, tp + ".col_choices") THEN
        FOR k = 0 TO JSON_LEN(doc, tp + ".col_choices") - 1
            DIM lp AS STRING : lp = tp + ".col_choices." + STR$(k)
            IF JSON_LEN(doc, lp) > 0 THEN ARRAY_PUSH(teile, STR$(k) + " = " + REPLACE$(listeText$(lp), "; ", "|"))
        NEXT
    END IF
    GUI_SET_TEXT(aWahl, JOIN$(teile, "; "))
    DIM zm AS BOOLEAN : zm = FALSE
    IF JSON_HAS(doc, tp + ".zellmodus") THEN zm = JSON_GET_BOOL(doc, tp + ".zellmodus")
    GUI_SET_CHECKED(cbZellen, zm)
END SUB

' Felder je Art -> Modell.
SUB artUebernehmen(i AS INTEGER)
    DIM art AS STRING : art = feldText$(i, "kind")
    DIM t AS STRING
    IF art = "dropdown" OR art = "listbox" THEN listeSetzen(wz$(i, "items"), GUI_TEXT(aEintraege), FALSE)
    IF art = "slider" OR art = "progress" OR art = "spinner" OR art = "knob" THEN
        IF TRIM$(GUI_TEXT(aMin)) <> "" THEN JSON_SET_FLOAT(doc, wz$(i, "min"), VAL(GUI_TEXT(aMin)))
        IF TRIM$(GUI_TEXT(aMax)) <> "" THEN JSON_SET_FLOAT(doc, wz$(i, "max"), VAL(GUI_TEXT(aMax)))
        IF TRIM$(GUI_TEXT(aWert)) <> "" THEN JSON_SET_FLOAT(doc, wz$(i, "value"), VAL(GUI_TEXT(aWert)))
    END IF
    IF art = "card" THEN JSON_SET_STRING(doc, wz$(i, "placeholder"), GUI_TEXT(aBeschr))
    IF art <> "table" THEN RETURN
    DIM tp AS STRING : tp = wz$(i, "table")
    IF NOT JSON_HAS(doc, tp) THEN JSON_SET_JSON(doc, tp, JSON_NEW_OBJECT())
    listeSetzen(tp + ".headers", GUI_TEXT(aSpalten), FALSE)
    listeSetzen(tp + ".col_widths", GUI_TEXT(aBreiten), TRUE)
    DIM ns AS INTEGER : ns = 0
    IF JSON_HAS(doc, tp + ".headers") THEN ns = JSON_LEN(doc, tp + ".headers")
    DIM k AS INTEGER
    ' Bearbeitbar: Spaltennummern oder "alle".
    DIM be AS STRING : be = LOWER$(TRIM$(REPLACE$(GUI_TEXT(aBearb), ",", ";")))
    DIM ce AS JSON_HANDLE : ce = JSON_NEW_ARRAY()
    DIM ceN AS INTEGER : ceN = 0
    IF be = "alle" THEN
        FOR k = 0 TO ns - 1
            JSON_APPEND_BOOL(ce, "", TRUE)
            ceN = ceN + 1
        NEXT
    ELSE
        DIM nummern AS ARRAY OF INTEGER : nummern = []
        DIM groesste AS INTEGER : groesste = -1
        FOR EACH t IN SPLIT$(be, ";")
            IF TRIM$(t) <> "" THEN
                ARRAY_PUSH(nummern, INT(VAL(TRIM$(t))))
                groesste = MAX(groesste, INT(VAL(TRIM$(t))))
            END IF
        NEXT
        FOR k = 0 TO groesste
            JSON_APPEND_BOOL(ce, "", ARRAY_INDEXOF(nummern, k) >= 0)
            ceN = ceN + 1
        NEXT
    END IF
    IF ceN > 0 THEN
        JSON_SET_JSON(doc, tp + ".col_edit", ce)
    ELSEIF JSON_HAS(doc, tp + ".col_edit") THEN
        JSON_REMOVE(doc, tp + ".col_edit")
    END IF
    ' Spaltenarten; eine Spalte mit Auswahlliste ist eine Auswahlspalte, auch
    ' wenn das Feld es nicht sagt -- sonst wirkte die Liste beim Laden nicht.
    DIM arten AS ARRAY OF STRING : arten = []
    FOR EACH t IN SPLIT$(GUI_TEXT(aArten), ";")
        IF TRIM$(t) <> "" THEN ARRAY_PUSH(arten, LOWER$(TRIM$(t)))
    NEXT
    DIM spalte AS ARRAY OF INTEGER : spalte = []
    DIM listen AS ARRAY OF STRING : listen = []
    DIM maxS AS INTEGER : maxS = -1
    FOR EACH t IN SPLIT$(GUI_TEXT(aWahl), ";")
        DIM teile AS ARRAY OF STRING : teile = SPLIT$(t, "=")
        IF LEN(teile) = 2 THEN
            ARRAY_PUSH(spalte, INT(VAL(TRIM$(teile[0]))))
            ARRAY_PUSH(listen, TRIM$(teile[1]))
            maxS = MAX(maxS, INT(VAL(TRIM$(teile[0]))))
        END IF
    NEXT
    IF maxS >= 0 THEN
        DIM cw AS JSON_HANDLE : cw = JSON_NEW_ARRAY()
        FOR k = 0 TO maxS
            DIM eintr AS JSON_HANDLE : eintr = JSON_NEW_ARRAY()
            DIM q AS INTEGER : q = ARRAY_INDEXOF(spalte, k)
            IF q >= 0 THEN
                DIM e AS STRING
                FOR EACH e IN SPLIT$(listen[q], "|")
                    IF TRIM$(e) <> "" THEN JSON_APPEND_STRING(eintr, "", TRIM$(e))
                NEXT
                WHILE LEN(arten) <= k
                    ARRAY_PUSH(arten, "text")
                WEND
                arten[k] = "auswahl"
            END IF
            JSON_APPEND_JSON(cw, "", eintr)
        NEXT
        JSON_SET_JSON(doc, tp + ".col_choices", cw)
    ELSEIF JSON_HAS(doc, tp + ".col_choices") THEN
        JSON_REMOVE(doc, tp + ".col_choices")
    END IF
    listeSetzen(tp + ".col_type", JOIN$(arten, ";"), FALSE)
    IF GUI_CHECKED(cbZellen) THEN
        JSON_SET_BOOL(doc, tp + ".zellmodus", TRUE)
    ELSEIF JSON_HAS(doc, tp + ".zellmodus") THEN
        JSON_REMOVE(doc, tp + ".zellmodus")
    END IF
END SUB

SUB inspektorSichtbar(widgetModus AS BOOLEAN)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(inspFelder) - 1
        GUI_SET_VISIBLE(inspFelder[i], widgetModus) : GUI_SET_VISIBLE(inspLabels[i], widgetModus)
    NEXT
    IF NOT widgetModus THEN artSichtbar("")
    GUI_SET_VISIBLE(cbAktiv, widgetModus) : GUI_SET_VISIBLE(btnUebernehmen, TRUE)
    GUI_SET_VISIBLE(fTitel, NOT widgetModus) : GUI_SET_VISIBLE(lTitel, NOT widgetModus)
    GUI_SET_VISIBLE(fFormB, NOT widgetModus) : GUI_SET_VISIBLE(lFormB, NOT widgetModus)
    GUI_SET_VISIBLE(fFormH, NOT widgetModus) : GUI_SET_VISIBLE(lFormH, NOT widgetModus)
    GUI_SET_VISIBLE(cbResizable, NOT widgetModus) : GUI_SET_VISIBLE(lThema, NOT widgetModus) : GUI_SET_VISIBLE(ddThema, NOT widgetModus)
END SUB

SUB inspektorFuellen()
    inspStumm = TRUE
    IF auswahl >= 0 AND auswahl < anzahl() THEN
        inspektorSichtbar(TRUE)
        GUI_SET_TEXT(lblInsp, feldText$(auswahl, "kind") + "  #" + STR$(auswahl))
        DIM i AS INTEGER
        FOR i = 0 TO LEN(inspFelder) - 1
            DIM k AS STRING : k = inspNamen[i]
            IF k = "x" OR k = "y" OR k = "w" OR k = "h" THEN
                GUI_SET_TEXT(inspFelder[i], STR$(feldZahl(auswahl, k)))
            ELSE
                GUI_SET_TEXT(inspFelder[i], feldText$(auswahl, k))
            END IF
        NEXT
        DIM an AS BOOLEAN : an = TRUE
        IF JSON_HAS(doc, wz$(auswahl, "enabled")) THEN an = JSON_GET_BOOL(doc, wz$(auswahl, "enabled"))
        GUI_SET_CHECKED(cbAktiv, an)
        artFuellen(auswahl)
        GUI_SET_TEXT(lblHinweis, "Enter in einem Feld oder [Uebernehmen] schreibt die Werte. Entf loescht, Strg+D verdoppelt, Pfeile schieben.")
    ELSE
        inspektorSichtbar(FALSE)
        GUI_SET_TEXT(lblInsp, "Formular")
        GUI_SET_TEXT(fTitel, JSON_GET_STRING(doc, "title"))
        GUI_SET_TEXT(fFormB, STR$(JSON_GET_INT(doc, "w")))
        GUI_SET_TEXT(fFormH, STR$(JSON_GET_INT(doc, "h")))
        DIM rz AS BOOLEAN : rz = FALSE
        IF JSON_HAS(doc, "resizable") THEN rz = JSON_GET_BOOL(doc, "resizable")
        GUI_SET_CHECKED(cbResizable, rz)
        DIM thema AS STRING : thema = ""
        IF JSON_HAS(doc, "theme") THEN thema = JSON_GET_STRING(doc, "theme")
        DIM ti AS INTEGER : ti = 0
        IF thema = "glas_dunkel" THEN ti = 1
        IF thema = "glas_hell" THEN ti = 2
        IF thema = "dark" THEN ti = 3
        IF thema = "light" THEN ti = 4
        GUI_DROPDOWN_SET_SELECTED(ddThema, ti)
        GUI_SET_TEXT(lblHinweis, "Kein Control ausgewaehlt: das sind die Werte des Formulars. Ein Klick auf ein Control zeigt seine.")
    END IF
    inspStumm = FALSE
END SUB

' Inspektor -> Modell
SUB inspektorUebernehmen()
    IF auswahl >= 0 AND auswahl < anzahl() THEN
        DIM i AS INTEGER
        FOR i = 0 TO LEN(inspFelder) - 1
            DIM k AS STRING : k = inspNamen[i]
            DIM t AS STRING : t = GUI_TEXT(inspFelder[i])
            IF k = "x" OR k = "y" OR k = "w" OR k = "h" THEN
                DIM v AS INTEGER : v = INT(VAL(t))
                IF (k = "w" OR k = "h") AND v < 4 THEN v = 4
                JSON_SET_INT(doc, wz$(auswahl, k), v)
            ELSEIF t = "" THEN
                IF JSON_HAS(doc, wz$(auswahl, k)) THEN JSON_REMOVE(doc, wz$(auswahl, k))
            ELSE
                JSON_SET_STRING(doc, wz$(auswahl, k), t)
            END IF
        NEXT
        IF GUI_CHECKED(cbAktiv) THEN
            IF JSON_HAS(doc, wz$(auswahl, "enabled")) THEN JSON_REMOVE(doc, wz$(auswahl, "enabled"))
        ELSE
            JSON_SET_BOOL(doc, wz$(auswahl, "enabled"), FALSE)
        END IF
        artUebernehmen(auswahl)
    ELSE
        JSON_SET_STRING(doc, "title", GUI_TEXT(fTitel))
        JSON_SET_INT(doc, "w", MAX(INT(VAL(GUI_TEXT(fFormB))), 80))
        JSON_SET_INT(doc, "h", MAX(INT(VAL(GUI_TEXT(fFormH))), 60))
        JSON_SET_BOOL(doc, "resizable", GUI_CHECKED(cbResizable))
        DIM ti AS INTEGER : ti = GUI_DROPDOWN_SELECTED(ddThema)
        IF ti <= 0 THEN
            IF JSON_HAS(doc, "theme") THEN JSON_REMOVE(doc, "theme")
        ELSE
            JSON_SET_STRING(doc, "theme", GUI_DROPDOWN_TEXT(ddThema))
        END IF
    END IF
    ansichtBauen()
    merken()
    inspektorFuellen()
    protokoll("uebernommen")
END SUB

' --- Controls anlegen, loeschen, ordnen -------------------------------------
FUNCTION eindeutigerName$(art AS STRING) AS STRING
    DIM n AS INTEGER : n = 1
    DIM kandidat AS STRING
    REPEAT
        kandidat = art + STR$(n)
        DIM frei AS BOOLEAN : frei = TRUE
        DIM i AS INTEGER
        FOR i = 0 TO anzahl() - 1
            IF feldText$(i, "name") = kandidat THEN frei = FALSE
        NEXT
        n = n + 1
    UNTIL frei
    RETURN kandidat
END FUNCTION

FUNCTION amRaster(v AS INTEGER) AS INTEGER
    RETURN INT((v + RASTER \ 2) \ RASTER) * RASTER
END FUNCTION

SUB controlAnlegen(p AS INTEGER, x AS INTEGER, y AS INTEGER)
    DIM w AS JSON_HANDLE : w = JSON_NEW_OBJECT()
    ' Das Gitter ist keine eigene Art, sondern eine Tabelle im Zellmodus.
    DIM kind AS STRING : kind = palArt[p]
    IF kind = "grid" THEN kind = "table"
    JSON_SET_STRING(w, "kind", kind)
    IF palArt[p] = "grid" THEN JSON_SET_STRING(w, "name", eindeutigerName$("gitter")) ELSE JSON_SET_STRING(w, "name", eindeutigerName$(kind))
    IF palArt[p] = "table" THEN JSON_SET_JSON(w, "table", JSON_PARSE(REPLACE$("{'headers':['Name','Wert']}", "'", CHR$(34))))
    IF palArt[p] = "grid" THEN JSON_SET_JSON(w, "table", JSON_PARSE(REPLACE$("{'headers':['A','B','C'],'zellmodus':true,'col_edit':[true,true,true]}", "'", CHR$(34))))
    JSON_SET_INT(w, "x", amRaster(x)) : JSON_SET_INT(w, "y", amRaster(y))
    JSON_SET_INT(w, "w", palB[p]) : JSON_SET_INT(w, "h", palH[p])
    IF palText[p] THEN JSON_SET_STRING(w, "text", palName[p])
    IF palArt[p] = "dropdown" OR palArt[p] = "listbox" THEN
        JSON_SET_JSON(w, "items", JSON_PARSE("[" + CHR$(34) + "Eintrag 1" + CHR$(34) + "," + CHR$(34) + "Eintrag 2" + CHR$(34) + "]"))
    END IF
    IF palArt[p] = "slider" OR palArt[p] = "progress" THEN JSON_SET_FLOAT(w, "min", 0.0) : JSON_SET_FLOAT(w, "max", 100.0) : JSON_SET_FLOAT(w, "value", 50.0)
    JSON_APPEND_JSON(doc, "widgets", w)
    auswahl = anzahl() - 1
    ansichtBauen()
    merken()
    inspektorFuellen()
    GUI_SET_TEXT(lblStatus, palName[p] + " abgelegt bei " + STR$(amRaster(x)) + ", " + STR$(amRaster(y)))
    protokoll("neu " + palArt[p] + " " + STR$(amRaster(x)) + " " + STR$(amRaster(y)))
END SUB

SUB controlLoeschen()
    IF auswahl < 0 THEN RETURN
    JSON_REMOVE(doc, "widgets." + STR$(auswahl))
    protokoll("geloescht " + STR$(auswahl))
    auswahl = -1
    ansichtBauen()
    merken()
    inspektorFuellen()
END SUB

SUB controlVerdoppeln()
    IF auswahl < 0 THEN RETURN
    ' Das Widget als eigenes Handle (JSON_SET_JSON/APPEND_JSON brauchen eins).
    DIM neu AS JSON_HANDLE : neu = teilbaum(doc, "widgets." + STR$(auswahl))
    JSON_SET_INT(neu, "x", feldZahl(auswahl, "x") + RASTER)
    JSON_SET_INT(neu, "y", feldZahl(auswahl, "y") + RASTER)
    JSON_SET_STRING(neu, "name", eindeutigerName$(feldText$(auswahl, "kind")))
    JSON_APPEND_JSON(doc, "widgets", neu)
    auswahl = anzahl() - 1
    ansichtBauen()
    merken()
    inspektorFuellen()
    protokoll("verdoppelt")
END SUB

' Ein Teilbaum als eigenes Handle -- ueber seinen Text.
FUNCTION teilbaum(h AS JSON_HANDLE, pfad AS STRING) AS JSON_HANDLE
    DIM huelle AS JSON_HANDLE : huelle = JSON_NEW_OBJECT()
    ' JSON_STRINGIFY kennt nur ganze Handles: den Teil in ein neues Objekt heben.
    DIM typ AS STRING : typ = JSON_TYPE(h, pfad)
    IF typ = "array" THEN
        DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
        DIM n AS INTEGER : n = JSON_LEN(h, pfad)
        DIM i AS INTEGER
        FOR i = 0 TO n - 1
            DIM ep AS STRING : ep = pfad + "." + STR$(i)
            DIM et AS STRING : et = JSON_TYPE(h, ep)
            IF et = "string" THEN JSON_APPEND_STRING(a, "", JSON_GET_STRING(h, ep))
            IF et = "number" THEN
                ' JSON_TYPE unterscheidet nicht: eine ganze Zahl bleibt ganz,
                ' sonst laese GUI_FROM_JSON aus 48.0 kein x mehr.
                DIM ef AS FLOAT : ef = JSON_GET_FLOAT(h, ep)
                IF ef = INT(ef) THEN JSON_APPEND_INT(a, "", INT(ef)) ELSE JSON_APPEND_FLOAT(a, "", ef)
            END IF
            IF et = "boolean" THEN JSON_APPEND_BOOL(a, "", JSON_GET_BOOL(h, ep))
            IF et = "array" OR et = "object" THEN JSON_APPEND_JSON(a, "", teilbaum(h, ep))
        NEXT
        RETURN a
    END IF
    DIM o AS JSON_HANDLE : o = JSON_NEW_OBJECT()
    DIM k AS STRING
    FOR EACH k IN JSON_KEYS(h, pfad)
        DIM kp AS STRING : kp = pfad + "." + k
        DIM kt AS STRING : kt = JSON_TYPE(h, kp)
        IF kt = "string" THEN JSON_SET_STRING(o, k, JSON_GET_STRING(h, kp))
        IF kt = "number" THEN
            DIM kf AS FLOAT : kf = JSON_GET_FLOAT(h, kp)
            IF kf = INT(kf) THEN JSON_SET_INT(o, k, INT(kf)) ELSE JSON_SET_FLOAT(o, k, kf)
        END IF
        IF kt = "boolean" THEN JSON_SET_BOOL(o, k, JSON_GET_BOOL(h, kp))
        IF kt = "array" OR kt = "object" THEN JSON_SET_JSON(o, k, teilbaum(h, kp))
    NEXT
    RETURN o
END FUNCTION

' Reihenfolge = Zeichenreihenfolge: das letzte liegt vorn.
SUB controlOrdnen(nachVorn AS BOOLEAN)
    IF auswahl < 0 THEN RETURN
    DIM n AS INTEGER : n = anzahl()
    DIM ziel AS INTEGER
    IF nachVorn THEN ziel = n - 1 ELSE ziel = 0
    IF ziel = auswahl THEN RETURN
    DIM kopie AS JSON_HANDLE : kopie = teilbaum(doc, "widgets." + STR$(auswahl))
    JSON_REMOVE(doc, "widgets." + STR$(auswahl))
    IF nachVorn THEN
        JSON_APPEND_JSON(doc, "widgets", kopie)
        auswahl = n - 1
    ELSE
        ' vorn einfuegen: alle anderen hinten anhaengen, dann die Liste tauschen
        DIM neu AS JSON_HANDLE : neu = JSON_NEW_ARRAY()
        JSON_APPEND_JSON(neu, "", kopie)
        DIM i AS INTEGER
        FOR i = 0 TO n - 2
            JSON_APPEND_JSON(neu, "", teilbaum(doc, "widgets." + STR$(i)))
        NEXT
        JSON_SET_JSON(doc, "widgets", neu)
        auswahl = 0
    END IF
    ansichtBauen()
    merken()
    inspektorFuellen()
END SUB

' --- Datei ------------------------------------------------------------------
SUB neuesFormular()
    doc = JSON_PARSE(leeresFormular$())
    formPfad = ""
    auswahl = -1
    staende = [] : standPos = -1
    ansichtBauen()
    merken()
    geaendert = FALSE
    inspektorFuellen()
    GUI_SET_TEXT(lblStatus, "Neues Formular.")
END SUB

SUB formularLaden(pfad AS STRING)
    IF NOT FILEEXISTS(pfad) THEN
        ' Eine noch nicht vorhandene Datei: neues Formular, das dorthin gesichert wird.
        neuesFormular()
        formPfad = pfad
        GUI_SET_TEXT(lblStatus, "Neu: " + pfad)
        protokoll("neu-datei " + pfad)
        RETURN
    END IF
    doc = JSON_LOAD(pfad)
    IF NOT JSON_HAS(doc, "widgets") THEN JSON_SET_JSON(doc, "widgets", JSON_NEW_ARRAY())
    formPfad = pfad
    auswahl = -1
    staende = [] : standPos = -1
    ansichtBauen()
    merken()
    geaendert = FALSE
    inspektorFuellen()
    GUI_SET_TEXT(lblStatus, "Geladen: " + pfad + " (" + STR$(anzahl()) + " Controls)")
    protokoll("geladen " + STR$(anzahl()))
END SUB

FUNCTION sichern(alsNeu AS BOOLEAN) AS BOOLEAN
    IF formPfad = "" OR alsNeu THEN
        DIM p AS STRING : p = FILE_SAVE_DIALOG("Formular sichern", "formular.dhform", "dhform")
        IF p = "" THEN RETURN FALSE
        formPfad = p
    END IF
    WRITEALL(formPfad, JSON_PRETTY(doc))
    geaendert = FALSE
    GUI_SET_TEXT(lblStatus, "Gesichert: " + formPfad)
    protokoll("gesichert " + formPfad)
    RETURN TRUE
END FUNCTION

' --- Ausfuehren: Programm-Geruest wie der Qt-Designer, dann dhrt run ---------
DIM laufProzess AS INTEGER : laufProzess = -1

FUNCTION handlerNamen() AS ARRAY OF STRING
    DIM namen AS ARRAY OF STRING : namen = []
    DIM i AS INTEGER
    DIM ev AS STRING
    FOR i = 0 TO anzahl() - 1
        FOR EACH ev IN ("on_click", "on_change", "on_enter", "on_hover", "on_leave", "on_focus", "on_blur")
            DIM n AS STRING : n = feldText$(i, ev)
            IF n <> "" AND ARRAY_INDEXOF(namen, n) < 0 THEN ARRAY_PUSH(namen, n)
        NEXT
    NEXT
    RETURN namen
END FUNCTION

FUNCTION dhString$(s AS STRING) AS STRING
    RETURN CHR$(34) + REPLACE$(s, CHR$(34), CHR$(34) + CHR$(34)) + CHR$(34)
END FUNCTION

FUNCTION laufProgramm$() AS STRING
    DIM z AS ARRAY OF STRING : z = []
    ARRAY_PUSH(z, "' Erzeugt vom Form-Designer -- Layout: " + BASENAME(formPfad))
    ARRAY_PUSH(z, "IMPORT " + dhString$("gui"))
    ARRAY_PUSH(z, "SCREEN(" + STR$(JSON_GET_INT(doc, "w")) + ", " + STR$(JSON_GET_INT(doc, "h")) + ", " + dhString$(JSON_GET_STRING(doc, "title")) + ", 1)")
    IF JSON_HAS(doc, "theme") THEN ARRAY_PUSH(z, "GUI_THEME_PRESET(" + dhString$(JSON_GET_STRING(doc, "theme")) + ")")
    IF JSON_HAS(doc, "resizable") THEN
        IF JSON_GET_BOOL(doc, "resizable") THEN ARRAY_PUSH(z, "WINDOW_RESIZABLE(TRUE)")
    END IF
    ARRAY_PUSH(z, "")
    ARRAY_PUSH(z, "DIM frm AS GUI_WINDOW")
    ARRAY_PUSH(z, "frm = GUI_LOAD(" + dhString$(BASENAME(formPfad)) + ")")
    ARRAY_PUSH(z, "GUI_WINDOW_CHROME(frm, FALSE)        ' randlos -- das OS-Fenster liefert den Rahmen")
    ARRAY_PUSH(z, "GUI_WINDOW_RESIZABLE(frm, FALSE)")
    ARRAY_PUSH(z, "")
    DIM n AS STRING
    FOR EACH n IN handlerNamen()
        ARRAY_PUSH(z, "SUB " + n + "()")
        IF JSON_HAS(doc, "code." + n) THEN
            DIM zeile AS STRING
            FOR EACH zeile IN SPLIT$(JSON_GET_STRING(doc, "code." + n), NL)
                ARRAY_PUSH(z, "    " + zeile)
            NEXT
        ELSE
            ARRAY_PUSH(z, "    ' TODO: " + n)
        END IF
        ARRAY_PUSH(z, "END SUB")
        ARRAY_PUSH(z, "")
    NEXT
    ARRAY_PUSH(z, "WHILE NOT QUITREQUESTED()")
    ARRAY_PUSH(z, "    GUI_WINDOW_SET_BOUNDS(frm, 0, 0, SCREENWIDTH(), SCREENHEIGHT())")
    ARRAY_PUSH(z, "    GUI_UPDATE()")
    ARRAY_PUSH(z, "    CLS(&H0E1014)")
    ARRAY_PUSH(z, "    GUI_DRAW()")
    ARRAY_PUSH(z, "    FLIP()")
    ARRAY_PUSH(z, "WEND")
    RETURN JOIN$(z, NL) + NL
END FUNCTION

' --- GB-Code: das Formular Aufruf fuer Aufruf, ohne GUI_LOAD ------------------
' Das Gegenstueck zu laufProgramm$: dort laedt das Programm die .dhform, hier
' steht jedes Control als eigener Aufruf im Quelltext -- lesbar, von Hand
' weiterzuschreiben, und ohne Datei daneben lauffaehig.
DIM gbZeilen AS ARRAY OF STRING : gbZeilen = []
DIM gbBenutzt AS ARRAY OF STRING : gbBenutzt = []

' Ein Text als Drachenhauch-Zeichenkette; mit Umbruch oder Rueckstrich als
' !"..." mit Escape-Folgen, sonst die schlichte Form.
FUNCTION gbText$(s AS STRING) AS STRING
    IF NOT (NL IN s) AND NOT (CHR$(13) IN s) AND NOT (CHR$(9) IN s) THEN RETURN dhString$(s)
    DIM e AS STRING : e = REPLACE$(s, "\", "\\")
    e = REPLACE$(e, CHR$(34), "\" + CHR$(34))
    e = REPLACE$(e, NL, "\n")
    e = REPLACE$(e, CHR$(13), "\r")
    e = REPLACE$(e, CHR$(9), "\t")
    RETURN "!" + CHR$(34) + e + CHR$(34)
END FUNCTION

FUNCTION gbIdent$(s AS STRING) AS STRING
    DIM r AS STRING : r = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(s) - 1
        DIM ch AS STRING : ch = MID$(s, i, 1)
        IF (ch >= "a" AND ch <= "z") OR (ch >= "A" AND ch <= "Z") OR (ch >= "0" AND ch <= "9") OR ch = "_" THEN r = r + ch ELSE r = r + "_"
    NEXT
    IF r = "" THEN RETURN "c"
    IF MID$(r, 0, 1) >= "0" AND MID$(r, 0, 1) <= "9" THEN r = "c" + r
    RETURN r
END FUNCTION

' Eine JSON-Liste als Feld-Literal: Texte in Anfuehrungszeichen, Zahlen blank.
FUNCTION gbListe$(pfad AS STRING) AS STRING
    IF NOT JSON_HAS(doc, pfad) THEN RETURN "[]"
    DIM teile AS ARRAY OF STRING : teile = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(doc, pfad) - 1
        DIM ep AS STRING : ep = pfad + "." + STR$(i)
        IF JSON_TYPE(doc, ep) = "number" THEN ARRAY_PUSH(teile, zahlText$(JSON_GET_FLOAT(doc, ep))) ELSE ARRAY_PUSH(teile, gbText$(JSON_GET_STRING(doc, ep)))
    NEXT
    RETURN "[" + JOIN$(teile, ", ") + "]"
END FUNCTION

FUNCTION gbZahl$(i AS INTEGER, feld AS STRING, vorgabe AS STRING) AS STRING
    IF NOT JSON_HAS(doc, wz$(i, feld)) THEN RETURN vorgabe
    RETURN zahlText$(JSON_GET_FLOAT(doc, wz$(i, feld)))
END FUNCTION

FUNCTION gbSchalter(pfad AS STRING) AS BOOLEAN
    IF NOT JSON_HAS(doc, pfad) THEN RETURN FALSE
    IF JSON_TYPE(doc, pfad) <> "boolean" THEN RETURN FALSE
    RETURN JSON_GET_BOOL(doc, pfad)
END FUNCTION

SUB gb(zeile AS STRING)
    ARRAY_PUSH(gbZeilen, zeile)
END SUB

SUB gbControl(i AS INTEGER)
    DIM k AS STRING : k = feldText$(i, "kind")
    DIM basis AS STRING : basis = feldText$(i, "name")
    IF basis = "" THEN basis = k + STR$(i + 1)
    basis = gbIdent$(basis)
    DIM v AS STRING : v = basis
    DIM nr AS INTEGER : nr = 2
    WHILE ARRAY_INDEXOF(gbBenutzt, LOWER$(v)) >= 0
        v = basis + STR$(nr)
        nr = nr + 1
    WEND
    ARRAY_PUSH(gbBenutzt, LOWER$(v))
    DIM w AS INTEGER : w = feldZahl(i, "w")
    DIM h AS INTEGER : h = feldZahl(i, "h")
    DIM lage AS STRING : lage = STR$(feldZahl(i, "x")) + ", " + STR$(feldZahl(i, "y"))
    DIM rahmen AS STRING : rahmen = lage + ", " + STR$(w) + ", " + STR$(h)
    DIM t AS STRING : t = gbText$(feldText$(i, "text"))
    DIM mn AS STRING : mn = gbZahl$(i, "min", "0")
    DIM mx AS STRING : mx = gbZahl$(i, "max", "100")
    DIM wert AS STRING : wert = gbZahl$(i, "value", "0")
    DIM an AS STRING : an = "FALSE"
    IF gbSchalter(wz$(i, "checked")) THEN an = "TRUE"
    DIM ctor AS STRING : ctor = ""
    DIM groesse AS BOOLEAN : groesse = FALSE
    SELECT CASE k
        CASE "button" : ctor = "GUI_BUTTON(frm, " + t + ", " + rahmen + ")"
        CASE "label" : ctor = "GUI_LABEL(frm, " + t + ", " + lage + ")" : groesse = TRUE
        CASE "checkbox" : ctor = "GUI_CHECKBOX(frm, " + t + ", " + lage + ", " + an + ")" : groesse = TRUE
        CASE "radio"
            DIM gruppe AS STRING : gruppe = feldText$(i, "group")
            IF gruppe = "" THEN gruppe = "gruppe"
            ctor = "GUI_RADIO(frm, " + gbText$(gruppe) + ", " + t + ", " + lage + ")"
            groesse = TRUE
        CASE "slider" : ctor = "GUI_SLIDER(frm, " + lage + ", " + STR$(w) + ", " + mn + ", " + mx + ", " + wert + ")" : groesse = TRUE
        CASE "textinput" : ctor = "GUI_TEXTINPUT(frm, " + rahmen + ", " + gbText$(feldText$(i, "placeholder")) + ")"
        CASE "dropdown" : ctor = "GUI_DROPDOWN(frm, " + rahmen + ", " + gbListe$(wz$(i, "items")) + ")"
        CASE "listbox" : ctor = "GUI_LISTBOX(frm, " + rahmen + ", " + gbListe$(wz$(i, "items")) + ")"
        CASE "progress" : ctor = "GUI_PROGRESS(frm, " + rahmen + ")"
        CASE "table" : ctor = "GUI_TABLE(frm, " + rahmen + ")"
        CASE "canvas" : ctor = "GUI_CANVAS(frm, " + rahmen + ")"
        CASE "panel" : ctor = "GUI_PANEL(frm, " + rahmen + ", " + t + ")"
        CASE "groupbox" : ctor = "GUI_GROUPBOX(frm, " + rahmen + ", " + t + ")"
        CASE "separator" : ctor = "GUI_SEPARATOR(frm, " + lage + ", " + STR$(w) + ")" : groesse = TRUE
        CASE "textarea" : ctor = "GUI_TEXTAREA(frm, " + rahmen + ", " + gbText$(feldText$(i, "placeholder")) + ")"
        CASE "spinner" : ctor = "GUI_SPINNER(frm, " + lage + ", " + STR$(w) + ", " + mn + ", " + mx + ", " + wert + ")" : groesse = TRUE
        CASE "knob" : ctor = "GUI_KNOB(frm, " + lage + ", " + STR$(MIN(w, h)) + ", " + mn + ", " + mx + ", " + wert + ")" : groesse = TRUE
        CASE "toggle" : ctor = "GUI_TOGGLE(frm, " + t + ", " + lage + ", " + an + ")" : groesse = TRUE
        CASE "tree" : ctor = "GUI_TREE(frm, " + rahmen + ")"
        CASE "layout"
            DIM la AS STRING : la = "spalte"
            IF JSON_HAS(doc, wz$(i, "layout.art")) THEN la = JSON_GET_STRING(doc, wz$(i, "layout.art"))
            ctor = "GUI_LAYOUT(frm, " + gbText$(la) + ", " + rahmen + ")"
        CASE "toolbar" : ctor = "GUI_TOOLBAR(frm, " + rahmen + ")"
        CASE "splitter"
            DIM richtung AS STRING : richtung = LOWER$(feldText$(i, "text"))
            IF richtung <> "v" THEN richtung = "h"
            DIM laenge AS INTEGER : laenge = w
            IF richtung = "v" THEN laenge = h
            ctor = "GUI_SPLITTER(frm, " + lage + ", " + STR$(laenge) + ", " + gbText$(richtung) + ", 40, " + STR$(MAX(80, laenge)) + ")"
            groesse = TRUE
        CASE "colorpicker" : ctor = "GUI_COLORPICKER(frm, " + rahmen + ")"
        CASE "datepicker" : ctor = "GUI_DATEPICKER(frm, " + rahmen + ")"
        CASE "richtext" : ctor = "GUI_RICHTEXT(frm, " + rahmen + ", " + t + ")"
        CASE "timepicker" : ctor = "GUI_TIMEPICKER(frm, " + rahmen + ")"
        CASE "tabcontrol" : ctor = "GUI_TABCONTROL(frm, " + rahmen + ")"
        CASE "statusbar" : ctor = "GUI_STATUSBAR(frm, " + rahmen + ", " + t + ")"
        CASE "breadcrumb" : ctor = "GUI_BREADCRUMB(frm, " + rahmen + ")"
        CASE "card" : ctor = "GUI_CARD(frm, " + rahmen + ", -1, " + t + ", " + gbText$(feldText$(i, "placeholder")) + ")"
    END SELECT
    IF ctor = "" THEN
        ' Ein Bild braucht eine Quelle (LOADIMAGE), die die .dhform nicht kennt.
        gb("' " + k + " '" + v + "' uebersprungen -- dafuer gibt es keinen Aufruf ohne weitere Angaben")
        gb("")
        RETURN
    END IF
    gb("DIM " + v + " AS GUI_WIDGET")
    gb(v + " = " + ctor)
    ' Diese Konstruktoren messen sich selbst -- die Groesse aus dem Designer
    ' ginge sonst verloren.
    IF groesse THEN gb("GUI_SET_BOUNDS(" + v + ", " + rahmen + ")")
    IF k = "table" THEN
        DIM tp AS STRING : tp = wz$(i, "table")
        IF JSON_HAS(doc, tp + ".headers") THEN gb("GUI_TABLE_HEADERS(" + v + ", " + gbListe$(tp + ".headers") + ")")
        IF JSON_HAS(doc, tp + ".col_widths") THEN gb("GUI_TABLE_COL_WIDTHS(" + v + ", " + gbListe$(tp + ".col_widths") + ")")
        IF gbSchalter(tp + ".zellmodus") THEN gb("GUI_TABLE_SET(" + v + ", " + dhString$("zellmodus") + ", 1)")
        IF gbSchalter(tp + ".zeilen_anhaengen") THEN gb("GUI_TABLE_SET(" + v + ", " + dhString$("zeilen_anhaengen") + ", 1)")
        IF gbSchalter(tp + ".zebra") THEN gb("GUI_TABLE_SET(" + v + ", " + dhString$("zebra") + ", 1)")
        IF gbSchalter(tp + ".filter_row") THEN gb("GUI_TABLE_SET(" + v + ", " + dhString$("filterzeile") + ", 1)")
        IF gbSchalter(tp + ".multi") THEN gb("GUI_TABLE_SET(" + v + ", " + dhString$("mehrfachauswahl") + ", 1)")
        DIM s AS INTEGER
        IF JSON_HAS(doc, tp + ".col_edit") THEN
            FOR s = 0 TO JSON_LEN(doc, tp + ".col_edit") - 1
                IF gbSchalter(tp + ".col_edit." + STR$(s)) THEN gb("GUI_TABLE_COL_EDIT(" + v + ", " + STR$(s) + ", TRUE)")
            NEXT
        END IF
        IF JSON_HAS(doc, tp + ".col_type") THEN
            FOR s = 0 TO JSON_LEN(doc, tp + ".col_type") - 1
                DIM ct AS STRING : ct = JSON_GET_STRING(doc, tp + ".col_type." + STR$(s))
                IF ct = "ganz" OR ct = "zahl" THEN gb("GUI_TABLE_COL_TYPE(" + v + ", " + STR$(s) + ", " + dhString$(ct) + ")")
            NEXT
        END IF
        IF JSON_HAS(doc, tp + ".col_choices") THEN
            FOR s = 0 TO JSON_LEN(doc, tp + ".col_choices") - 1
                DIM cp AS STRING : cp = tp + ".col_choices." + STR$(s)
                IF JSON_LEN(doc, cp) > 0 THEN gb("GUI_TABLE_COL_CHOICES(" + v + ", " + STR$(s) + ", " + gbListe$(cp) + ")")
            NEXT
        END IF
        gb("' " + v + ": Zeilen zur Laufzeit fuellen -- GUI_TABLE_ADD_ROW / GUI_TABLE_ROWS")
    END IF
    IF k = "datepicker" AND feldText$(i, "date") <> "" THEN gb("GUI_SET_DATE(" + v + ", " + gbText$(feldText$(i, "date")) + ")")
    IF k = "timepicker" AND feldText$(i, "time") <> "" THEN gb("GUI_SET_TIME(" + v + ", " + gbText$(feldText$(i, "time")) + ")")
    IF JSON_HAS(doc, wz$(i, "enabled")) THEN
        IF NOT gbSchalter(wz$(i, "enabled")) THEN gb("GUI_SET_ENABLED(" + v + ", FALSE)")
    END IF
    DIM anker AS STRING : anker = feldText$(i, "anchor")
    IF anker <> "" AND anker <> "lt" THEN gb("GUI_SET_ANCHOR(" + v + ", " + gbText$(anker) + ")")
    IF feldText$(i, "tooltip") <> "" THEN gb("GUI_TOOLTIP(" + v + ", " + gbText$(feldText$(i, "tooltip")) + ")")
    IF feldText$(i, "on_click") <> "" THEN gb("GUI_ON_CLICK(" + v + ", " + feldText$(i, "on_click") + ")")
    IF feldText$(i, "on_change") <> "" THEN gb("GUI_ON_CHANGE(" + v + ", " + feldText$(i, "on_change") + ")")
    IF feldText$(i, "on_enter") <> "" THEN gb("GUI_ON_ENTER(" + v + ", " + feldText$(i, "on_enter") + ")")
    gb("")
END SUB

FUNCTION gbCode$() AS STRING
    gbZeilen = []
    gbBenutzt = ["frm"]
    gb("' Erzeugt vom Form-Designer -- das Formular ausgeschrieben, ohne GUI_LOAD")
    gb("' Vorlage: " + BASENAME(formPfad))
    gb("IMPORT " + dhString$("gui"))
    gb("SCREEN(" + STR$(JSON_GET_INT(doc, "w")) + ", " + STR$(JSON_GET_INT(doc, "h")) + ", " + gbText$(JSON_GET_STRING(doc, "title")) + ", 1)")
    IF JSON_HAS(doc, "theme") THEN gb("GUI_THEME_PRESET(" + dhString$(JSON_GET_STRING(doc, "theme")) + ")")
    IF gbSchalter("resizable") THEN gb("WINDOW_RESIZABLE(TRUE)")
    gb("")
    DIM n AS STRING
    FOR EACH n IN handlerNamen()
        ARRAY_PUSH(gbBenutzt, LOWER$(n))
        gb("SUB " + n + "()")
        IF JSON_HAS(doc, "code." + n) THEN
            DIM zeile AS STRING
            FOR EACH zeile IN SPLIT$(JSON_GET_STRING(doc, "code." + n), NL)
                gb("    " + zeile)
            NEXT
        ELSE
            gb("    ' TODO: " + n)
        END IF
        gb("END SUB")
        gb("")
    NEXT
    gb("DIM frm AS GUI_WINDOW")
    gb("frm = GUI_WINDOW(" + gbText$(JSON_GET_STRING(doc, "title")) + ", 0, 0, " + STR$(JSON_GET_INT(doc, "w")) + ", " + STR$(JSON_GET_INT(doc, "h")) + ")")
    gb("GUI_WINDOW_CHROME(frm, FALSE)        ' randlos -- das OS-Fenster liefert den Rahmen")
    gb("GUI_WINDOW_RESIZABLE(frm, FALSE)")
    IF JSON_HAS(doc, "menus") THEN gb("' Menues stehen in der .dhform -- dieser Code baut sie nicht nach; GUI_LOAD tut es.")
    gb("")
    DIM i AS INTEGER
    FOR i = 0 TO anzahl() - 1
        gbControl(i)
    NEXT
    gb("WHILE NOT QUITREQUESTED()")
    gb("    GUI_WINDOW_SET_BOUNDS(frm, 0, 0, SCREENWIDTH(), SCREENHEIGHT())")
    gb("    GUI_UPDATE()")
    gb("    CLS(&H0E1014)")
    gb("    GUI_DRAW()")
    gb("    FLIP()")
    gb("WEND")
    RETURN JOIN$(gbZeilen, NL) + NL
END FUNCTION

SUB gbCodeSchreiben()
    IF formPfad = "" OR geaendert THEN
        IF NOT sichern(FALSE) THEN RETURN
    END IF
    DIM stamm AS STRING : stamm = formPfad
    IF LOWER$(RIGHT$(stamm, 7)) = ".dhform" THEN stamm = LEFT$(stamm, LEN(stamm) - 7)
    DIM ziel AS STRING : ziel = stamm + "_code.dh"
    WRITEALL(ziel, gbCode$())
    GUI_SET_TEXT(lblStatus, "GB-Code geschrieben: " + BASENAME(ziel))
    protokoll("gbcode " + ziel)
END SUB

SUB ausfuehren()
    IF formPfad = "" OR geaendert THEN
        IF NOT sichern(FALSE) THEN RETURN
    END IF
    IF laufProzess >= 0 THEN PROCESS_KILL(laufProzess) : PROCESS_CLOSE(laufProzess) : laufProzess = -1
    DIM stamm AS STRING : stamm = formPfad
    IF LOWER$(RIGHT$(stamm, 7)) = ".dhform" THEN stamm = LEFT$(stamm, LEN(stamm) - 7)
    DIM lauf AS STRING : lauf = stamm + "_lauf.dh"
    WRITEALL(lauf, laufProgramm$())
    laufProzess = PROCESS_START("dhrt", "run", lauf)
    GUI_SET_TEXT(lblStatus, "Gestartet: " + BASENAME(lauf))
    protokoll("gestartet " + lauf)
END SUB

' --- Maus auf der Form --------------------------------------------------------
DIM modus AS INTEGER : modus = 0          ' 0 nichts, 1 verschieben, 2 groesse
DIM griff AS INTEGER : griff = -1         ' 0..7: NW N NE E SE S SW W
DIM startMx AS INTEGER
DIM startMy AS INTEGER
DIM startX AS INTEGER
DIM startY AS INTEGER
DIM startW AS INTEGER
DIM startH AS INTEGER
DIM bewegt AS BOOLEAN : bewegt = FALSE

FUNCTION indexVonHandle(h AS GUI_WIDGET) AS INTEGER
    IF h < 0 OR frm < 0 THEN RETURN -1
    DIM i AS INTEGER
    FOR i = 0 TO GUI_WINDOW_WIDGET_COUNT(frm) - 1
        IF GUI_WINDOW_WIDGET(frm, i) = h THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Griff unter der Maus (Bildschirmkoordinaten), -1 = keiner.
FUNCTION griffBei(mx AS INTEGER, my AS INTEGER) AS INTEGER
    IF auswahl < 0 THEN RETURN -1
    DIM x AS INTEGER : x = formX + feldZahl(auswahl, "x")
    DIM y AS INTEGER : y = formY + feldZahl(auswahl, "y")
    DIM w AS INTEGER : w = feldZahl(auswahl, "w")
    DIM h AS INTEGER : h = feldZahl(auswahl, "h")
    DIM gx[8] AS INTEGER
    DIM gy[8] AS INTEGER
    gx[0] = x : gy[0] = y : gx[1] = x + w \ 2 : gy[1] = y : gx[2] = x + w : gy[2] = y
    gx[3] = x + w : gy[3] = y + h \ 2 : gx[4] = x + w : gy[4] = y + h : gx[5] = x + w \ 2 : gy[5] = y + h
    gx[6] = x : gy[6] = y + h : gx[7] = x : gy[7] = y + h \ 2
    DIM i AS INTEGER
    FOR i = 0 TO 7
        IF ABS(mx - gx[i]) <= 5 AND ABS(my - gy[i]) <= 5 THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB griffeZeichnen()
    IF auswahl < 0 OR auswahl >= anzahl() THEN RETURN
    DIM x AS INTEGER : x = formX + feldZahl(auswahl, "x")
    DIM y AS INTEGER : y = formY + feldZahl(auswahl, "y")
    DIM w AS INTEGER : w = feldZahl(auswahl, "w")
    DIM h AS INTEGER : h = feldZahl(auswahl, "h")
    RECT(x - 1, y - 1, x + w, y + h, &H4FC3F7)
    DIM gx AS INTEGER
    DIM gy AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO 7
        SELECT CASE i
            CASE 0 : gx = x : gy = y
            CASE 1 : gx = x + w \ 2 : gy = y
            CASE 2 : gx = x + w : gy = y
            CASE 3 : gx = x + w : gy = y + h \ 2
            CASE 4 : gx = x + w : gy = y + h
            CASE 5 : gx = x + w \ 2 : gy = y + h
            CASE 6 : gx = x : gy = y + h
            CASE 7 : gx = x : gy = y + h \ 2
        END SELECT
        BOX(gx - 3, gy - 3, gx + 3, gy + 3, &H4FC3F7)
    NEXT
END SUB

' Lage/Groesse waehrend eines Zuges: ins Modell UND live ins Widget.
SUB lageSetzen(x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER)
    JSON_SET_INT(doc, wz$(auswahl, "x"), x) : JSON_SET_INT(doc, wz$(auswahl, "y"), y)
    JSON_SET_INT(doc, wz$(auswahl, "w"), w) : JSON_SET_INT(doc, wz$(auswahl, "h"), h)
    DIM hd AS GUI_WIDGET : hd = GUI_WINDOW_WIDGET(frm, auswahl)
    IF hd >= 0 THEN GUI_SET_BOUNDS(hd, x, y, w, h)
END SUB

SUB mausAufForm()
    DIM mx AS INTEGER : mx = MOUSEX()
    DIM my AS INTEGER : my = MOUSEY()
    DIM fw AS INTEGER : fw = JSON_GET_INT(doc, "w")
    DIM fh AS INTEGER : fh = JSON_GET_INT(doc, "h")
    DIM drin AS BOOLEAN : drin = mx >= formX AND my >= formY AND mx < formX + fw AND my < formY + fh
    IF MOUSE_HIT(LINKS) AND drin THEN
        IF palScharf >= 0 THEN
            controlAnlegen(palScharf, mx - formX, my - formY)
            palScharf = -1
            GUI_LISTBOX_CLEAR_SELECTION(lstPalette)
            RETURN
        END IF
        griff = griffBei(mx, my)
        IF griff >= 0 THEN
            modus = 2
        ELSE
            DIM h AS GUI_WIDGET : h = GUI_HIT_TEST(mx, my)
            DIM i AS INTEGER : i = indexVonHandle(h)
            IF i <> auswahl THEN auswahl = i : inspektorFuellen()
            IF i >= 0 THEN modus = 1 ELSE modus = 0
        END IF
        IF auswahl >= 0 THEN
            startMx = mx : startMy = my
            startX = feldZahl(auswahl, "x") : startY = feldZahl(auswahl, "y")
            startW = feldZahl(auswahl, "w") : startH = feldZahl(auswahl, "h")
            bewegt = FALSE
        END IF
        GUI_FOCUS(lstPalette)     ' Tastatur (Entf, Pfeile) zum Designer, nicht in ein Inspektor-Feld
        RETURN
    END IF
    IF modus > 0 AND MOUSEBUTTON(LINKS) AND auswahl >= 0 THEN
        DIM dx AS INTEGER : dx = mx - startMx
        DIM dy AS INTEGER : dy = my - startMy
        IF dx <> 0 OR dy <> 0 THEN bewegt = TRUE
        IF modus = 1 THEN
            lageSetzen(amRaster(startX + dx), amRaster(startY + dy), startW, startH)
        ELSE
            DIM x AS INTEGER : x = startX
            DIM y AS INTEGER : y = startY
            DIM w AS INTEGER : w = startW
            DIM hh AS INTEGER : hh = startH
            IF griff = 0 OR griff = 6 OR griff = 7 THEN x = amRaster(startX + dx) : w = startX + startW - x
            IF griff = 2 OR griff = 3 OR griff = 4 THEN w = amRaster(startW + dx)
            IF griff = 0 OR griff = 1 OR griff = 2 THEN y = amRaster(startY + dy) : hh = startY + startH - y
            IF griff = 4 OR griff = 5 OR griff = 6 THEN hh = amRaster(startH + dy)
            IF w < RASTER THEN w = RASTER
            IF hh < RASTER THEN hh = RASTER
            lageSetzen(x, y, w, hh)
        END IF
        RETURN
    END IF
    IF modus > 0 AND NOT MOUSEBUTTON(LINKS) THEN
        IF bewegt THEN
            merken()
            inspektorFuellen()
            protokoll("bewegt " + STR$(auswahl) + " " + STR$(feldZahl(auswahl, "x")) + " " + STR$(feldZahl(auswahl, "y")) + " " + STR$(feldZahl(auswahl, "w")) + " " + STR$(feldZahl(auswahl, "h")))
        END IF
        modus = 0
    END IF
END SUB

SUB schieben(dx AS INTEGER, dy AS INTEGER)
    IF auswahl < 0 THEN RETURN
    lageSetzen(feldZahl(auswahl, "x") + dx, feldZahl(auswahl, "y") + dy, feldZahl(auswahl, "w"), feldZahl(auswahl, "h"))
    merken()
    inspektorFuellen()
END SUB

' --- Start ------------------------------------------------------------------
IF ARGC() >= 1 THEN
    DIM startDatei AS STRING : startDatei = ARG$(0)
    IF LEFT$(startDatei, 1) <> "/" AND LEFT$(startDatei, 1) <> "\" AND MID$(startDatei, 1, 1) <> ":" THEN
        DIM start AS STRING : start = GETENV$("DHRT_START_DIR")
        IF start <> "" THEN startDatei = PATHJOIN(start, startDatei)
    END IF
    formularLaden(startDatei)
ELSE
    neuesFormular()
END IF
GUI_FOCUS(lstPalette)      ' Kuerzel gelten im Fenster mit Fokus -- vor dem ersten Klick gaebe es keins
protokoll("bereit")

DIM warBreite AS INTEGER : warBreite = SCREENWIDTH()
DIM warHoehe AS INTEGER : warHoehe = SCREENHEIGHT()
DIM beenden AS BOOLEAN : beenden = FALSE
DIM dlgSchliessen AS GUI_WINDOW : dlgSchliessen = 0

' [Beenden] und das Kreuz fragen dasselbe -- bis 2026-09-19 beendete das
' Kreuz ohne Rueckfrage. Ein anderer offener Kasten geht vor.
SUB endeAnfragen()
    IF dlgSchliessen <> 0 OR GUI_MODAL() THEN RETURN
    IF geaendert THEN dlgSchliessen = GUI_DIALOG("Beenden", "Das Formular ist nicht gesichert.", "Sichern|Verwerfen|Abbrechen") ELSE beenden = TRUE
END SUB

WHILE NOT beenden
    ' Das Kreuz (und Alt+F4) fragt wie [Beenden] nach, wenn etwas nicht
    ' gesichert ist. QUITREQUESTED ohne das Kreuz ist das Bildlimit eines
    ' Testlaufs -- dort endet das Programm hart wie bisher.
    IF WINDOW_CLOSE_REQUESTED() THEN
        endeAnfragen()
    ELSEIF QUITREQUESTED() THEN
        BREAK
    END IF
    GUI_UPDATE()
    IF SCREENWIDTH() <> warBreite OR SCREENHEIGHT() <> warHoehe THEN
        warBreite = SCREENWIDTH() : warHoehe = SCREENHEIGHT()
        GUI_WINDOW_SET_BOUNDS(winPal, 0, 0, PAL_B, warHoehe)
        GUI_WINDOW_SET_BOUNDS(winInsp, warBreite - INSP_B, 0, INSP_B, warHoehe)
    END IF

    ' Menue
    IF GUI_CLICKED(miNeu) THEN neuesFormular()
    IF GUI_CLICKED(miOeffnen) THEN
        DIM p AS STRING : p = FILE_OPEN_DIALOG("Formular oeffnen", "dhform")
        IF p <> "" THEN formularLaden(p)
    END IF
    IF GUI_CLICKED(miSichern) THEN sichern(FALSE)
    IF GUI_CLICKED(miSichernAls) THEN sichern(TRUE)
    IF GUI_CLICKED(miLauf) THEN ausfuehren()
    IF GUI_CLICKED(miGbCode) THEN gbCodeSchreiben()
    IF GUI_CLICKED(miBeenden) THEN endeAnfragen()
    IF GUI_CLICKED(miRueck) THEN rueckgaengig()
    IF GUI_CLICKED(miWieder) THEN wiederholen()
    IF GUI_CLICKED(miDoppel) THEN controlVerdoppeln()
    IF GUI_CLICKED(miLoeschen) THEN controlLoeschen()
    IF GUI_CLICKED(miVorn) THEN controlOrdnen(TRUE)
    IF GUI_CLICKED(miHinten) THEN controlOrdnen(FALSE)
    IF dlgSchliessen <> 0 THEN
        DIM a AS INTEGER : a = GUI_ANSWER(dlgSchliessen)
        IF a = 1 THEN
            dlgSchliessen = 0
            IF sichern(FALSE) THEN beenden = TRUE
        ELSEIF a = 2 THEN
            dlgSchliessen = 0 : beenden = TRUE
        ELSEIF a = 3 THEN
            dlgSchliessen = 0
        END IF
    END IF

    ' Palette: eine (neue) Auswahl macht die Art scharf, der naechste Klick auf
    ' die Form legt ab. Eine Liste meldet kein GUI_CLICKED -- die Auswahl ist
    ' das Ereignis.
    IF GUI_LISTBOX_SELECTED(lstPalette) <> palScharf AND GUI_LISTBOX_SELECTED(lstPalette) >= 0 THEN
        palScharf = GUI_LISTBOX_SELECTED(lstPalette)
        GUI_SET_TEXT(lblStatus, palName[palScharf] + ": jetzt auf die Form klicken.")
        protokoll("palette " + palArt[palScharf])
    END IF

    ' Inspektor: Enter in einem Feld oder der Knopf uebernimmt.
    DIM uebernehmen AS BOOLEAN : uebernehmen = GUI_CLICKED(btnUebernehmen)
    DIM fi AS INTEGER
    FOR fi = 0 TO LEN(inspFelder) - 1
        IF GUI_ENTERED(inspFelder[fi]) THEN uebernehmen = TRUE
    NEXT
    FOR fi = 0 TO LEN(artFelder) - 1
        IF GUI_ENTERED(artFelder[fi]) THEN uebernehmen = TRUE
    NEXT
    IF GUI_ENTERED(fTitel) OR GUI_ENTERED(fFormB) OR GUI_ENTERED(fFormH) THEN uebernehmen = TRUE
    IF uebernehmen AND NOT inspStumm THEN inspektorUebernehmen()

    ' Tastatur, solange kein Eingabefeld den Fokus hat
    DIM fokus AS GUI_WIDGET : fokus = GUI_FOCUSED()
    DIM imFeld AS BOOLEAN : imFeld = FALSE
    IF fokus >= 0 THEN
        DIM art AS STRING : art = GUI_KIND(fokus)
        imFeld = art = "textinput" OR art = "textarea" OR art = "spinner"
    END IF
    IF NOT imFeld THEN
        IF KEYHIT(KEY_DELETE) THEN controlLoeschen()
        DIM schritt AS INTEGER : schritt = RASTER
        IF KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT) THEN schritt = 1
        IF KEYHIT(KEY_LEFT) THEN schieben(-schritt, 0)
        IF KEYHIT(KEY_RIGHT) THEN schieben(schritt, 0)
        IF KEYHIT(KEY_UP) THEN schieben(0, -schritt)
        IF KEYHIT(KEY_DOWN) THEN schieben(0, schritt)
        IF KEYHIT(KEY_ESCAPE) THEN palScharf = -1 : auswahl = -1 : inspektorFuellen()
    END IF

    mausAufForm()

    IF laufProzess >= 0 THEN
        IF NOT PROCESS_RUNNING(laufProzess) THEN
            GUI_SET_TEXT(lblStatus, "Formular beendet mit Code " + STR$(PROCESS_CODE(laufProzess)))
            PROCESS_CLOSE(laufProzess)
            laufProzess = -1
        END IF
    END IF

    CLS(&H0B1119)
    ' Rahmen und Titel der Form -- die Form selbst ist randlos
    DIM fw2 AS INTEGER : fw2 = JSON_GET_INT(doc, "w")
    DIM fh2 AS INTEGER : fh2 = JSON_GET_INT(doc, "h")
    BOX(formX - 1, formY - 28, formX + fw2, formY - 1, &H1F2A38)
    TEXT(formX + 8, formY - 22, JSON_GET_STRING(doc, "title") + "   " + STR$(fw2) + " x " + STR$(fh2), &HD8E4F0)
    RECT(formX - 1, formY - 28, formX + fw2, formY + fh2, &H3A4A5C)
    GUI_DRAW()
    griffeZeichnen()
    FLIP()
WEND

IF laufProzess >= 0 THEN PROCESS_KILL(laufProzess)
protokoll("ende")
