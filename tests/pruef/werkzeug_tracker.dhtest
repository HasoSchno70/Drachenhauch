--- nachher
IMPORT "json"
FUNCTION ti(h AS JSON_HANDLE, p AS STRING) AS STRING
    IF JSON_TYPE(h, p) = "null" THEN RETURN "null"
    RETURN STR$(JSON_GET_INT(h, p))
END FUNCTION
DIM h AS JSON_HANDLE : h = JSON_LOAD("_programm/song.json")
PRINT JSON_GET_STRING(h, "format")
PRINT JSON_GET_INT(h, "channels") ; " " ; JSON_GET_INT(h, "bpm")
PRINT ti(h, "patterns.0.data.0.0") ; " " ; ti(h, "patterns.0.data.0.1") ; " " ; ti(h, "patterns.0.data.0.2")
PRINT ti(h, "patterns.0.data.1.0")
PRINT JSON_LEN(h, "instruments")
PRINT JSON_GET_STRING(h, "instruments.0.name") ; "|" ; JSON_GET_STRING(h, "instruments.1.name")
PRINT ti(h, "channel_inst.0") ; " " ; ti(h, "channel_inst.1") ; " " ; ti(h, "channel_inst.2") ; " " ; ti(h, "channel_inst.3")
