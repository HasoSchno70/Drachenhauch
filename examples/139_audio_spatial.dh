' 139_audio_spatial.dh -- Modul "audio": raeumliches Audio (Listener/Emitter)
'
'   AUDIO_LISTENER_NEW(x,y,z)              das "Ohr" der Szene
'   AUDIO_LISTENER_SET_ORIENTATION(l,yaw)  Blickrichtung drehen (Grad, um Y)
'   AUDIO_EMITTER_NEW(l,x,y,z,min,max)     raeumlicher Sub-Track (an l gebunden)
'   AUDIO_EMITTER_SET_POSITION(e,x,y,z)    Emitter bewegen
'   AUDIO_PLAY_ON(sound,e,...)             Sound auf dem Emitter starten
'
' Pfeiltasten bewegen den Emitter (die Schallquelle) um den Listener (Ohr,
' Bildschirmmitte) herum -- Kira berechnet Panning + Lautstaerke-Abnahme aus
' der Position selbst, hier wird nur die Position jeden Frame nachgefuehrt.
' Q/E dreht den Listener (Blickrichtung) -- das Panning dreht sich mit.
IMPORT "audio"
IMPORT "input"

SCREEN(640, 480, "Audio-Spatial-Demo")
INPUT_BIND("left", KEY_LEFT)
INPUT_BIND("right", KEY_RIGHT)
INPUT_BIND("up", KEY_UP)
INPUT_BIND("down", KEY_DOWN)
INPUT_BIND("turn_l", KEY_Q)
INPUT_BIND("turn_r", KEY_E)

DIM CX AS INTEGER
DIM CY AS INTEGER
CX = 320
CY = 240

DIM listener AS AUDIO_LISTENER
listener = AUDIO_LISTENER_NEW(0.0, 0.0, 0.0)

DIM MIN_D AS FLOAT
DIM MAX_D AS FLOAT
MIN_D = 40.0
MAX_D = 350.0
DIM emitter AS AUDIO_EMITTER
emitter = AUDIO_EMITTER_NEW(listener, 150.0, 0.0, 0.0, MIN_D, MAX_D)

DIM snd AS SOUND
snd = AUDIO_TONE(300, 60000, "sine", 0.8)
AUDIO_PLAY_ON(snd, emitter, -1, 1.0)

DIM ex AS FLOAT
DIM ez AS FLOAT
DIM yaw AS FLOAT
ex = 150.0
ez = 0.0
yaw = 0.0

WHILE NOT QUITREQUESTED()
    INPUT_UPDATE()
    IF INPUT_HELD("left") THEN ex = ex - 200.0 * DELTA()
    IF INPUT_HELD("right") THEN ex = ex + 200.0 * DELTA()
    IF INPUT_HELD("up") THEN ez = ez - 200.0 * DELTA()
    IF INPUT_HELD("down") THEN ez = ez + 200.0 * DELTA()
    IF INPUT_HELD("turn_l") THEN yaw = yaw - 90.0 * DELTA()
    IF INPUT_HELD("turn_r") THEN yaw = yaw + 90.0 * DELTA()

    AUDIO_EMITTER_SET_POSITION(emitter, ex, 0.0, ez)
    AUDIO_LISTENER_SET_ORIENTATION(listener, yaw)

    CLS(BLACK)
    ' Bildschirm-Mapping: Welt-X -> Screen-X, Welt-Z -> Screen-Y (Blick "nach oben").
    DIM sx AS INTEGER
    DIM sy AS INTEGER
    sx = CX + INT(ex)
    sy = CY + INT(ez)
    LINE(CX, CY, sx, sy, GRAY)
    CIRCLE(CX, CY, 12, CYAN)          ' Listener (Ohr)
    CIRCLE(sx, sy, 10, YELLOW)        ' Emitter (Schallquelle)

    DIM dist AS FLOAT
    dist = SQR(ex * ex + ez * ez)

    TEXT(20, 20, "Modul audio: Listener/Emitter (raeumliches Audio)", WHITE)
    TEXT(20, 400, "Pfeiltasten: Emitter bewegen  --  Q/E: Listener drehen", YELLOW)
    TEXT(20, 425, "Distanz: " + STR$(INT(dist)) + "  (laut ab " + STR$(INT(MIN_D)) + ", lautlos ab " + STR$(INT(MAX_D)) + ")", YELLOW)
    TEXT(20, 450, "Listener-Blickrichtung (Yaw): " + STR$(INT(yaw)) + " Grad", YELLOW)
    FLIP()
WEND

AUDIO_EMITTER_REMOVE(emitter)
AUDIO_LISTENER_REMOVE(listener)
