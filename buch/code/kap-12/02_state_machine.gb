' GameState als ENUM, dispatched mit SELECT CASE - Konsolen-Mock
' fuer das Pattern, das wir gleich in main.gb einsetzen.

ENUM GameState = MENU, PLAYING, GAMEOVER

DIM state AS GameState
DIM frame AS INTEGER

state = GameState.MENU

FOR frame = 1 TO 6
    SELECT CASE state
        CASE GameState.MENU
            PRINT f"Frame {frame}: [MENU] druecke ENTER zum Starten"
        CASE GameState.PLAYING
            PRINT f"Frame {frame}: [PLAYING] Gegner kommen!"
        CASE GameState.GAMEOVER
            PRINT f"Frame {frame}: [GAMEOVER] druecke R fuer Restart"
    END SELECT

    ' State-Wechsel zu Demo-Zwecken
    IF frame = 2 THEN state = GameState.PLAYING
    IF frame = 5 THEN state = GameState.GAMEOVER
NEXT frame
