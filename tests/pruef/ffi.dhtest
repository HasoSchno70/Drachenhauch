=== buffer und byref schreiben zurueck
DECLARE SUB GetSystemTime LIB "kernel32" (zeit AS BUFFER)
DECLARE FUNCTION QueryPerformanceFrequency LIB "kernel32" (BYREF f AS INTEGER) AS BOOLEAN
DECLARE FUNCTION GetComputerNameW LIB "kernel32" (puffer AS BUFFER, BYREF laenge AS ULONG) AS BOOLEAN
DIM st AS BUFFER
st = BUFFER_NEW(16)
GetSystemTime(st)
PRINT BUFFER_GET_U16(st, 0) >= 2026, BUFFER_GET_U16(st, 2) >= 1 AND BUFFER_GET_U16(st, 2) <= 12
DIM f AS INTEGER
PRINT QueryPerformanceFrequency(f), f > 0
' Ein und aus: hinein geht die Groesse des Puffers in Zeichen, heraus die
' Laenge des Namens -- hier in einem Feldelement statt einer Variable.
DIM n[1] AS INTEGER
n[0] = 64
DIM b AS BUFFER
b = BUFFER_NEW(128)
PRINT GetComputerNameW(b, n[0])
DIM name AS STRING
FOR i = 0 TO n[0] - 1
    name = name + CHR$(BUFFER_GET_U16(b, i * 2))
NEXT
PRINT name = GETENV$("COMPUTERNAME"), n[0] > 0
--- system windows
--- erwartet
TRUE TRUE
TRUE TRUE
TRUE
TRUE TRUE

