=== die bibliothek bietet im control andere controls an, aber keinen kreis
' Im Fenster stehen beide zur Wahl. In Zwei (enthaelt Zaehler) nur Zaehler;
' in Zaehler keins -- Zwei hineinzulegen ergaebe einen Kreis.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
DIM m AS STRING : m = CWD$() + "/m.log"
slStarten(m, "", 6, p)
PRINT "["; slAnfang(m, "projektbausteine ")[0]; "]"
DIM nx AS INTEGER
DIM ny AS INTEGER
DIM ziel AS STRING
FOR EACH ziel IN ["Zwei", "Zaehler"]
    (nx, ny) = slLage(m, "knoten " + ziel)
    slZeilen = [] : slBild = 0
    slHin(10, 10)
    slWarten(6)
    slKlick(nx, ny)
    slWarten(10)
    slAufnahmeSchreiben(CWD$() + "/ev.txt")
    DIM log AS STRING : log = CWD$() + "/s.log"
    slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
    DIM zl AS ARRAY OF STRING : zl = slAnfang(log, "projektbausteine ")
    PRINT "["; zl[LEN(zl) - 1]; "]"
NEXT
