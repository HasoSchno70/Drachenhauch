=== pdf: vorgabe mit stickpfad, ohne keine linien, im diamond-modus kein absatz
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")

FUNCTION zaehlen$(ab AS ARRAY OF STRING) AS STRING
    DIM z AS STRING, absatz AS INTEGER
    DIM a AS STRING
    FOR EACH a IN ab
        IF LEFT$(a, 2) = "D " AND INSTR(a, "String:203") >= 0 THEN z = MID$(a, INSTR(a, "| ") + 2, INSTR(a, " Rect") - INSTR(a, "| ") - 2)
        IF INSTR(a, "Stickpfad:") >= 0 THEN absatz = absatz + 1
    NEXT
    RETURN z + " absatz " + STR$(absatz)
END FUNCTION
DIM o AS kern.PdfOptionen : o = NEW kern.PdfOptionen()
o.datum = "16.10.2026"
PRINT "vorgabe an: "; o.stickpfad
PRINT "mit: "; zaehlen$(kern.pdfExportieren(m, "a.pdf", o))
o.stickpfad = FALSE
PRINT "ohne: "; zaehlen$(kern.pdfExportieren(m, "b.pdf", o))
o.stickpfad = TRUE
m.modus = "diamond" : m.stoff = 10
PRINT "diamond: "; zaehlen$(kern.pdfExportieren(m, "c.pdf", o))
--- argumente
{sammlung}/../../examples/glutfaden
