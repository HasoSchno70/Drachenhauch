GUI_TOOLTIP(ddDauer, "Notendauer -- zugleich das Raster fuer den Klick")
DIM cbPunkt AS GUI_WIDGET : cbPunkt = GUI_CHECKBOX(winTop, "punktiert", 126, 12)
DIM ddVorz AS GUI_WIDGET : ddVorz = GUI_DROPDOWN(winTop, 226, 8, 100, 24, ["natuerlich", "Kreuz", "B"])
GUI_TOOLTIP(ddVorz, "Vorzeichen: verschiebt die geklickte Stammnote um einen Halbton")
DIM modusNamen AS ARRAY OF STRING : modusNamen = ["Note", "Pause", "Bindebogen", "Fingersatz", "Staccato"]
DIM ddModus AS GUI_WIDGET : ddModus = GUI_DROPDOWN(winTop, 334, 8, 120, 24, modusNamen)
GUI_TOOLTIP(ddModus, "Was ein Klick tut")
DIM ddFinger AS GUI_WIDGET : ddFinger = GUI_DROPDOWN(winTop, 462, 8, 50, 24, ["1", "2", "3", "4", "5"])
GUI_TOOLTIP(ddFinger, "Fingersatz-Zahl (Modus Fingersatz)")
DIM lblBpm AS GUI_WIDGET : lblBpm = GUI_LABEL(winTop, "BPM", 522, 12)
