=== unten am rand klappt die liste nach oben auf
' Klappliste bei y 360 in einem 400 hohen Fenster: darunter ist kein Platz,
' die Liste steht ueber der Box (y 340 ist blau).
IMPORT "gui"
SCREEN(300, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 10, 360, 190, 28, ["Apfel", "Birne", "Kirsche", "Dattel", "Feige"])
GUI_SET_COLOR(dd, "bg", &H0000FF)
GUI_METRIC_SET("uebergang", 0)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
