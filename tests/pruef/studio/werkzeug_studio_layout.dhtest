=== das erzeugte programm legt die kinder wie der entwurf
' F5 erzeugt das Programm; danach laeuft es mit einem Klick auf knopf1. Die
' Spalte (40, 40, 200 breit) dehnt ihn auf ihre Breite -- im Modell ist er
' 100 breit und steht bei 0, 0. Das Ereignis gibt aus, wo er wirklich ist.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
slHin(10, 10)
slWarten(10)
slTaste(294)
slWarten(150)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_LAUF_BILDER", "20")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
PRINT "erzeugt "; slHat(log, "erzeugt 2")
DIM basis AS STRING : basis = JOIN$(READLINES(p + "/_studio/Hauptfenster_basis.dh"), CHR$(10))
PRINT "kinder in der basis "; INSTR(basis, "kinder") >= 0
DIM neu AS ARRAY OF STRING : neu = []
DIM s AS STRING
FOR EACH s IN READLINES(p + "/_studio/main.dh")
    IF LEFT$(s, 11) = "studioLauf(" THEN ARRAY_PUSH(neu, "AUTOMATION_PLAY(" + CHR$(34) + "klick.txt" + CHR$(34) + ")")
    ARRAY_PUSH(neu, s)
NEXT
WRITEALL(p + "/_studio/probe.dh", JOIN$(neu, CHR$(10)) + CHR$(10))
WRITEALL(p + "/_studio/klick.txt", "c 4" + CHR$(10) + "e 0 7 200 55 0 0" + CHR$(10) + "e 5 7 200 55 0 0" + CHR$(10) + "e 10 6 0 0 0 0" + CHR$(10) + "e 12 5 0 0 0 0" + CHR$(10))
DIM k AS INTEGER : k = PROCESS_START("dhrt", "run", "--bilder", "30", p + "/_studio/probe.dh")
DIM leer AS INTEGER : leer = 0
WHILE leer < 5
    DIM kt AS STRING : kt = PROCESS_READ$(k)
    IF kt <> "" THEN
        ' Unter Last kommen mehrere Zeilen in einem Stueck.
        DIM kz AS STRING
        FOR EACH kz IN SPLIT(REPLACE$(kt, CHR$(13), ""), CHR$(10))
            IF TRIM$(kz) <> "" AND LEFT$(kz, 8) <> "WARNING:" THEN PRINT "lauf "; TRIM$(kz)
        NEXT
        leer = 0
    ELSEIF NOT PROCESS_RUNNING(k) THEN
        leer = leer + 1
        SLEEP(30)
    END IF
WEND
PRINT "code "; PROCESS_CODE(k)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../studio/studio.dh
--- datei laeufer.dh
IMPORT "{sammlung}/_hilfen/studiolauf.dh"
slStudio = ARG$(0)
