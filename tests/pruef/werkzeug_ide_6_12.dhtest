    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION alleEnden(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            n = n + 1
            IF RIGHT$(L[i], LEN(e)) <> e THEN RETURN FALSE
        END IF
    NEXT
    RETURN n > 0
END FUNCTION
FUNCTION inhalt$(datei AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(z) - 1
        r = r + z[i] + CHR$(10)
    NEXT
    RETURN r
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
PRINT "projekt ersetzt 2 " ; hat("projekt ersetzt 2")
zeige("a.dh")
PRINT "b ohne hallo " ; INSTR(inhalt$("b.dh"), "hallo") < 0
--- erwartet
projekt ersetzt 2 TRUE
|PRINT |
b ohne hallo TRUE

