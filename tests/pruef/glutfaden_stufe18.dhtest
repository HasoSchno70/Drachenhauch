' Glutfaden Stufe 18: das ganze Muster drehen, spiegeln, zuschneiden und
' auto-zuschneiden (kern/verwalten.dh, PySticky Pattern.rotate_*, flip_*,
' crop, auto_crop), alle Ebenen vereinen (kern/bearbeiten.dh,
' LayerStack.flatten) und die Ansicht der Ebenen ("Nur aktive", "Andere
' abdunkeln" in ansicht/leinwand.dh).
'
' Der erste Fall ist gegen PySticky aufgezeichnet: je Muster und Wandlung
' Groesse, je Ebene die belegten Zellen (x, y, Farbe, Typ, erledigt) als MD5,
' die Rueckstiche als MD5 und die Stichzahlen. 180 Grad ist dort zweimal
' rechts -- PyStickys eigenes rotate_180 laesst die Teilstich-Typen stehen
' (siehe zweiten Fall).

=== drehen, spiegeln, zuschneiden, vereinen wie pysticky
IMPORT "helfer.dh"
FUNCTION kurz$(t AS STRING) AS STRING
    RETURN LEFT$(LOWER$(MD5$(t)), 12)
END FUNCTION

SUB abzug(name AS STRING, m AS kern.Muster)
    PRINT name; ": "; m.breite; "x"; m.hoehe
    DIM i AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR i = 0 TO m.ebenen.anzahl() - 1
        DIM e AS kern.Ebene : e = m.ebenen.ebenen[i]
        DIM z AS ARRAY OF STRING : z = []
        FOR y = 0 TO m.hoehe - 1
            FOR x = 0 TO m.breite - 1
                DIM q AS INTEGER : q = y * m.breite + x
                IF e.raster[q] < 0 THEN CONTINUE
                ARRAY_PUSH(z, STR$(x) + "," + STR$(y) + "," + STR$(e.raster[q]) + "," + STR$(e.art[q]) + "," + STR$(IIF(e.erledigt[q] <> 0, 1, 0)))
            NEXT
        NEXT
        PRINT "  ebene "; i; " "; e.name; " "; IIF(e.sichtbar, "an", "aus"); ": "; LEN(z); " "; kurz$(JOIN$(z, ";"))
    NEXT
    DIM b AS ARRAY OF STRING : b = []
    DIM r AS kern.Rueckstich
    FOR EACH r IN m.rueckstiche
        ARRAY_PUSH(b, STR$(r.x1) + "," + STR$(r.y1) + "," + STR$(r.x2) + "," + STR$(r.y2) + "," + STR$(r.farbe))
    NEXT
    PRINT "  rueck "; LEN(b); " "; kurz$(JOIN$(b, ";"))
    m.stichzahlenNeu()
    DIM zl AS ARRAY OF STRING : zl = []
    DIM f AS kern.Farbeintrag
    FOR EACH f IN m.farben
        ARRAY_PUSH(zl, STR$(f.stichzahl))
    NEXT
    PRINT "  zahlen "; JOIN$(zl, ",")
END SUB

DIM pfad AS STRING
FOR EACH pfad IN ["alle.pxs", "farbprobe.pxs", GLUTORDNER + "/daten/muster/demo_kreuzstich.pxs"]
    DIM name AS STRING : name = BASENAME(pfad)
    abzug(name + " geladen", kern.pxsLaden(pfad))
    DIM m AS kern.Muster
    DIM v AS kern.Verlauf
    DIM ok AS BOOLEAN
    DIM k AS INTEGER
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : ok = kern.musterUmlegen(m, v, kern.UMLEGEN_RECHTS) : abzug(name + " rechts", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : ok = kern.musterUmlegen(m, v, kern.UMLEGEN_LINKS) : abzug(name + " links", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : ok = kern.musterUmlegen(m, v, kern.UMLEGEN_180) : abzug(name + " 180", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : ok = kern.musterUmlegen(m, v, kern.UMLEGEN_WAAGERECHT) : abzug(name + " waagerecht", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : ok = kern.musterUmlegen(m, v, kern.UMLEGEN_SENKRECHT) : abzug(name + " senkrecht", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf()
    FOR k = 1 TO 4 : ok = kern.musterUmlegen(m, v, kern.UMLEGEN_RECHTS) : NEXT
    abzug(name + " rechts viermal", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : ok = kern.musterZuschneiden(m, v, 1, 1, m.breite - 2, m.hoehe - 2, "x") : abzug(name + " zuschneiden 1 1", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : ok = kern.musterZuschneiden(m, v, 2, 0, 5, 4, "x") : abzug(name + " zuschneiden 2 0", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf()
    DIM ra AS ARRAY OF INTEGER : ra = kern.autoZuschneiden(m, v)
    PRINT "  auto -> "; IIF(LEN(ra) = 0, "None", "(" + JOIN$(ra, ", ") + ")")
    abzug(name + " auto", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : ok = kern.ebenenVereinen(m, v) : abzug(name + " vereinen", m)
    m = kern.pxsLaden(pfad) : v = kern.neuerVerlauf() : m.ebenen.ebenen[0].sichtbar = FALSE : ok = kern.ebenenVereinen(m, v) : abzug(name + " vereinen ohne ebene 0", m)
NEXT
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
CONST GLUTORDNER = "{sammlung}/../../examples/glutfaden"
