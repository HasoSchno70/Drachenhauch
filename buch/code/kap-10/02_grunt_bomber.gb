' Zwei Enemy-Typen, beide erben von Entity.
'
' Grunt:  fliegt geradeaus runter
' Bomber: faengt links an und schwingt zickzack, langsamer

CLASS Entity
    DIM x      AS INTEGER
    DIM y      AS INTEGER
    DIM alive  AS BOOLEAN

    SUB Init(start_x AS INTEGER, start_y AS INTEGER)
        x = start_x
        y = start_y
        alive = TRUE
    END SUB

    SUB Update()
    END SUB
END CLASS

CLASS Grunt EXTENDS Entity
    SUB Update()
        IF NOT alive THEN RETURN
        y = y + 2
        IF y > 240 THEN alive = FALSE
    END SUB
END CLASS

CLASS Bomber EXTENDS Entity
    DIM dx AS INTEGER     ' Bewegungs-Richtung horizontal: +1 oder -1

    SUB Init(start_x AS INTEGER, start_y AS INTEGER)
        x = start_x
        y = start_y
        alive = TRUE
        dx = 1            ' faengt nach rechts an
    END SUB

    SUB Update()
        IF NOT alive THEN RETURN
        y = y + 1                       ' langsamer als Grunt
        x = x + dx                      ' seitwaerts
        IF x < 0 OR x > 320 THEN
            dx = -dx                    ' am Rand abprallen
        END IF
        IF y > 240 THEN alive = FALSE
    END SUB
END CLASS

' Test: Beide simulieren
DIM g AS Grunt
DIM b AS Bomber
g = NEW Grunt(50, 0)
b = NEW Bomber(0, 0)

DIM frame AS INTEGER
FOR frame = 1 TO 30
    g.Update()
    b.Update()
NEXT frame

PRINT f"Grunt nach 30 Frames:  ({g.x}, {g.y}), alive = {g.alive}"
PRINT f"Bomber nach 30 Frames: ({b.x}, {b.y}), alive = {b.alive}, dx = {b.dx}"
