' BREAK verlaesst die Schleife sofort.
' CONTINUE springt zum naechsten Durchlauf, ohne den Rest des Bodys.

DIM i AS INTEGER

' BREAK: suche Wert in Liste, brich ab wenn gefunden
PRINT "Suche Welle 7:"
FOR i = 1 TO 100
    IF i = 7 THEN
        PRINT f"  Gefunden bei Welle {i}!"
        BREAK
    END IF
NEXT i

' CONTINUE: Vielfache von 3 ueberspringen
PRINT ""
PRINT "Zahlen 1..15 ohne Vielfache von 3:"
FOR i = 1 TO 15
    IF i MOD 3 = 0 THEN CONTINUE
    PRINT f"  {i}"
NEXT i
