=== excel csv laesst sich lesen
' Der Fall, um den es geht.
DIM t AS ARRAY OF STRING
t = CSV_LOAD("kunden.csv", ";", "cp1252")
PRINT DIMSIZE(t, 0)
PRINT t[1, 0]
PRINT t[2, 1]
--- datei kunden.csv base64
TmFtZTtPcnQ7VW1zYXR6Ck38bGxlcjtL9mxuOzEyNTAKU2NocvZkZXI7Tfxuc3Rlcjs4MzAK
--- erwartet
3
Müller
Münster

=== ohne angabe erklaert die meldung den ausweg
' Vorher stand da wortwoertlich 'stream did not contain valid UTF-8'.
DIM t AS ARRAY OF STRING
t = READLINES("k.csv")
--- datei k.csv base64
TmFtZQpN/GxsZXIK
--- fehler
READLINES: k.csv: Zeile 2 ist kein UTF-8 (Byte 0xFC an Stelle 6). Kommt die Datei aus Excel oder einem alten Windows-Programm, ist sie meist cp1252 -- dann als letztes Argument "cp1252" mitgeben. Moeglich sind: utf8, cp1252 (= ansi, windows-1252), latin1 (= iso-8859-1)

=== unbekannte kodierung zaehlt die moeglichen auf
DIM t AS ARRAY OF STRING
t = READLINES("k.txt", "klingonisch")
--- datei k.txt
a
--- fehler
READLINES: Kodierung 'klingonisch' kenne ich nicht -- moeglich sind: utf8, cp1252 (= ansi, windows-1252), latin1 (= iso-8859-1)

=== namen sind nachsichtig[cp1252]
DIM t AS ARRAY OF STRING
t = READLINES("k.txt", "cp1252")
PRINT t[0]
--- datei k.txt base64
R3L832UK
--- erwartet
Grüße

=== namen sind nachsichtig[CP-1252]
DIM t AS ARRAY OF STRING
t = READLINES("k.txt", "CP-1252")
PRINT t[0]
--- datei k.txt base64
R3L832UK
--- erwartet
Grüße

=== namen sind nachsichtig[windows-1252]
DIM t AS ARRAY OF STRING
t = READLINES("k.txt", "windows-1252")
PRINT t[0]
--- datei k.txt base64
R3L832UK
--- erwartet
Grüße

=== namen sind nachsichtig[ANSI]
DIM t AS ARRAY OF STRING
t = READLINES("k.txt", "ANSI")
PRINT t[0]
--- datei k.txt base64
R3L832UK
--- erwartet
Grüße

=== schreiben erzeugt echte cp1252 bytes
WRITEALL("raus.txt", "Grüße;Köln", "cp1252")
--- erwartet

=== hin und zurueck
WRITEALL("r.txt", "Straße in Köln", "cp1252")
DIM t AS ARRAY OF STRING
t = READLINES("r.txt", "cp1252")
PRINT t[0]
--- erwartet
Straße in Köln

=== anhaengen kann die kodierung auch
WRITEALL("a.txt", "Köln" + CHR$(10), "cp1252")
APPENDFILE("a.txt", "Münster" + CHR$(10), "cp1252")
--- erwartet

=== csv save mit kodierung
DIM t AS ARRAY OF STRING
t = CSV_PARSE("Müller;Köln", ";")
CSV_SAVE("k.csv", t, ";", "cp1252")
--- erwartet

=== zeichen das es nicht gibt ist ein fehler
' Kein stilles Fragezeichen: eine Rechnung, in der aus dem Euro-Zeichen
WRITEALL("r.txt", "Preis 5 " + CHR$(8364), "latin1")
--- fehler
WRITEALL: das Zeichen '€' (U+20AC) gibt es in latin1 nicht -- die Datei in utf8 schreiben oder das Zeichen ersetzen

=== euro geht in cp1252
' cp1252 hat das Euro-Zeichen (0x80), latin1 nicht -- genau dafuer gibt
WRITEALL("r.txt", CHR$(8364), "cp1252")
--- erwartet

=== openfile liest zeilenweise mit kodierung
DIM f AS FILE
DIM z AS STRING
f = OPENFILE("gross.txt", "r", "cp1252")
WHILE NOT ENDOFFILE(f)
    z = READLINE(f)
    PRINT z
WEND
CLOSEFILE(f)
--- datei gross.txt base64
TfxsbGVyClNjaHL2ZGVyCldlad8K
--- erwartet
Müller
Schröder
Weiß

=== openfile schreibt mit kodierung
DIM f AS FILE
f = OPENFILE("w.txt", "w", "cp1252")
WRITELINE(f, "Grüße")
CLOSEFILE(f)
--- erwartet

=== readall auf dem handle kann es auch
DIM f AS FILE
f = OPENFILE("g.txt", "r", "cp1252")
PRINT READALL$(f)
CLOSEFILE(f)
--- datei g.txt base64
S/Zsbg==
--- erwartet
Köln

=== bom faellt weg
' Excel schreibt ihn -- sonst hiesse die erste Spalte fuer immer
DIM t AS ARRAY OF STRING
t = READLINES("b.csv")
PRINT LEFT$(t[0], 4)
--- datei b.csv
﻿Name;Ort
--- erwartet
Name

=== bom faellt auch beim zeilenweisen lesen weg
DIM f AS FILE
f = OPENFILE("b.csv", "r")
PRINT LEFT$(READLINE(f), 4)
CLOSEFILE(f)
--- datei b.csv
﻿Name
Ort
--- erwartet
Name

=== utf8 bleibt die vorgabe
' Kein bestehendes Programm aendert sein Verhalten.
DIM t AS ARRAY OF STRING
t = READLINES("u.txt")
PRINT t[0]
PRINT LEN(t[0])
--- datei u.txt
Grüße 😀
--- erwartet
Grüße 😀
7

