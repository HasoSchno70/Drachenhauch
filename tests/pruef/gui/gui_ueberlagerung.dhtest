=== das kreuz und esc leeren das suchfeld
' Das zweite ESC (Feld schon leer) gehoert wieder dem Abbrechen-Knopf.
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM abbr AS GUI_WIDGET
abbr = GUI_BUTTON(w, "Abbrechen", 400, 300, 120, 30)
GUI_WINDOW_CANCEL(w, abbr)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 20, 20, 200, 28)
GUI_TEXTINPUT_SET(tf, "suche", 1)
GUI_SET_TEXT(tf, "apfel")
AUTOMATION_PLAY("ev.txt")
DIM ab AS INTEGER : ab = 0
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF GUI_ICON_CLICKED(tf) <> 0 THEN PRINT "sinnbild " + STR$(GUI_ICON_CLICKED(tf)) + " text '" + GUI_TEXT(tf) + "' gemeldet " + STR$(GUI_SEARCH_CHANGED(tf))
    IF GUI_CLICKED(abbr) THEN ab = ab + 1
    IF n = 20 THEN GUI_SET_TEXT(tf, "birne")
    IF n = 30 THEN PRINT "vor esc '" + GUI_TEXT(tf) + "'"
    IF n = 45 THEN PRINT "nach esc '" + GUI_TEXT(tf) + "' abbrechen " + STR$(ab)
    IF n = 60 THEN PRINT "zweites esc: abbrechen " + STR$(ab)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
