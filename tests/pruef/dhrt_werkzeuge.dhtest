=== fmt schreibt die schluesselwoerter gross
IMPORT "helfer.dh"
WRITEALL("a.dh", !"dim i as integer\nfor i = 1 to 3\n    print i\nnext\n")
dlStarten(["fmt", CWD$() + "/a.dh"])
PRINT "rueckgabe "; dlCode
PRINT "|" + REPLACE$(dlText$("a.dh"), CHR$(10), "|")
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
rueckgabe 0
|DIM i AS INTEGER|FOR i = 1 TO 3|    PRINT i|NEXT|

=== fmt laesst namen, texte und kommentare in ruhe
' Entschieden wird an den Token, nicht am Text: Variablen, Builtins und
' Klassen bleiben, wie sie geschrieben sind.
IMPORT "helfer.dh"
WRITEALL("a.dh", !"DIM meinWert AS STRING\nmeinWert = Left$(\"abc\", 2)\nPRINT \"das end vom lied\"    ' hier steht auch ein for\n")
dlStarten(["fmt", CWD$() + "/a.dh"])
DIM neu AS STRING : neu = dlText$("a.dh")
PRINT "meinWert "; (INSTR(neu, "meinWert") >= 0)
PRINT "Left$ "; (INSTR(neu, "Left$") >= 0)
PRINT "text "; (INSTR(neu, CHR$(34) + "das end vom lied" + CHR$(34)) >= 0)
PRINT "kommentar "; (INSTR(neu, "hier steht auch ein for") >= 0)
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
meinWert TRUE
Left$ TRUE
text TRUE
kommentar TRUE

=== fmt laesst das f vor einer zeichenkette klein
' Der Lexer loest einen f-String schon beim Lesen in eine Token-Folge auf;
' die erben alle die Position des `f`. Ohne Gegenprobe wurde daraus `F"..."`
' -- beim ersten Lauf ueber den Bestand tatsaechlich passiert.
IMPORT "helfer.dh"
WRITEALL("a.dh", !"DIM n AS INTEGER\nn = 5\nPRINT f\"Wert {n}\"\n")
dlStarten(["fmt", CWD$() + "/a.dh"])
PRINT "klein geblieben "; (INSTR(dlText$("a.dh"), "f" + CHR$(34) + "Wert {n}" + CHR$(34)) >= 0)
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
klein geblieben TRUE

=== fmt ruehrt die einrueckung erst mit dem flag an
' Die Vorgabe ist verlustfrei: sie ruehrt kein Layout an.
IMPORT "helfer.dh"
WRITEALL("a.dh", !"if 1 = 1 then\n        PRINT 1\nend if\n")
dlStarten(["fmt", CWD$() + "/a.dh"])
PRINT "acht leerzeichen bleiben "; (INSTR(dlText$("a.dh"), "        PRINT 1") >= 0)
WRITEALL("b.dh", !"IF 1 = 1 THEN\nPRINT 1\nEND IF\n")
dlStarten(["fmt", "--einruecken", CWD$() + "/b.dh"])
PRINT "rueckgabe "; dlCode
PRINT "|" + REPLACE$(dlText$("b.dh"), CHR$(10), "|")
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
acht leerzeichen bleiben TRUE
rueckgabe 0
|IF 1 = 1 THEN|    PRINT 1|END IF|

=== fmt rueckt select case wie der hausstil ein
' CASE steht INNERHALB von SELECT -- so schreiben es alle Beispiele. Die
' erste, stapellose Fassung war hier anderer Meinung als 26 Dateien.
IMPORT "helfer.dh"
WRITEALL("a.dh", !"DIM x AS INTEGER\nx = 1\nSELECT CASE x\nCASE 1\nPRINT 1\nCASE ELSE\nPRINT 0\nEND SELECT\n")
dlStarten(["fmt", "--einruecken", CWD$() + "/a.dh"])
PRINT "|" + REPLACE$(dlText$("a.dh"), CHR$(10), "|")
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
|DIM x AS INTEGER|x = 1|SELECT CASE x|    CASE 1|        PRINT 1|    CASE ELSE|        PRINT 0|END SELECT|

=== fmt laesst ein einzeiliges if und ausgerichtete fortsetzungen stehen
' Wer seine Parameter untereinander ausrichtet, hat sich etwas dabei gedacht
' -- und die Zeile darf die Ebenen-Rechnung nicht verwirren.
IMPORT "helfer.dh"
WRITEALL("a.dh", !"DIM x AS INTEGER\nIF x = 1 THEN x = 2\nPRINT x\n")
dlStarten(["fmt", "--einruecken", CWD$() + "/a.dh"])
PRINT "|" + REPLACE$(dlText$("a.dh"), CHR$(10), "|")
WRITEALL("b.dh", !"DIM i AS INTEGER\nFOR i = 1 TO 2\n    IF MAX(1, _\n           2) = 2 THEN\n        PRINT 1\n    END IF\nNEXT\nPRINT 9\n")
dlStarten(["fmt", "--einruecken", CWD$() + "/b.dh"])
DIM neu AS STRING : neu = dlText$("b.dh")
PRINT "ausrichtung erhalten "; (INSTR(neu, "           2) = 2 THEN") >= 0)
DIM ende AS STRING : ende = !"NEXT\nPRINT 9\n"
PRINT "ebene laeuft nicht weg "; (RIGHT$(neu, LEN(ende)) = ende)
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
--- erwartet
|DIM x AS INTEGER|IF x = 1 THEN x = 2|PRINT x|
ausrichtung erhalten TRUE
ebene laeuft nicht weg TRUE

