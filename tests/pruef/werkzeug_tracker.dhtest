--- einschub nach FLIP()
IF bildNr = 3 THEN
    DIM x AS INTEGER : x = GUI_CANVAS_X(gitter) + 40 + 1 * 118 + 59
    DIM y AS INTEGER : y = GUI_CANVAS_Y(gitter) + 24 + 5 * 20 + 10
    DIM t AS STRING : t = "# Test-Aufnahme" + CHR$(10) + "c 7" + CHR$(10)
    t = t + "e 0 7 0 0 0 0" + CHR$(10)
    t = t + "e 5 7 " + STR$(x) + " " + STR$(y) + " 0 0" + CHR$(10)
    t = t + "e 6 7 " + STR$(x) + " " + STR$(y) + " 0 0" + CHR$(10)
    t = t + "e 6 6 0 0 0 0" + CHR$(10)
    t = t + "e 7 5 0 0 0 0" + CHR$(10)
    t = t + "e 14 2 90 0 0 0" + CHR$(10)
    t = t + "e 15 1 90 0 0 0" + CHR$(10)
    WRITEALL("klick.txt", t)
    AUTOMATION_PLAY("klick.txt")
END IF
prSchreib("n10 " + STR$(note[patAkt, 1, 0]) + " n11 " + STR$(note[patAkt, 1, 1]) + " curC " + STR$(curC) + " curR " + STR$(curR))

