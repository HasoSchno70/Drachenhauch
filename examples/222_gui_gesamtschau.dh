DIM p1 AS INTEGER : p1 = GUI_TABCONTROL_ADD(reiter, "Allgemein")
DIM p2 AS INTEGER : p2 = GUI_TABCONTROL_ADD(reiter, "Ansicht")
DIM p3 AS INTEGER : p3 = GUI_TABCONTROL_ADD(reiter, "Erweitert")
GUI_TABCONTROL_ADD_WIDGET(reiter, GUI_TEXTINPUT(s5, 40, 80, 300, 30, "Projektname"), p1)
GUI_TABCONTROL_ADD_WIDGET(reiter, GUI_CHECKBOX(s5, "Beim Start oeffnen", 40, 130, TRUE), p1)
GUI_TABCONTROL_ADD_WIDGET(reiter, GUI_SLIDER(s5, 40, 90, 300, 8, 32, 14), p2)
GUI_TABCONTROL_ADD_WIDGET(reiter, GUI_LABEL(s5, "Schriftgroesse", 40, 130), p2)
GUI_TABCONTROL_ADD_WIDGET(reiter, GUI_TOGGLE(s5, "Maschinencode", 40, 90, TRUE), p3)
DIM akk AS GUI_WIDGET : akk = GUI_ACCORDION(s5, 520, 20, 500, 280)
DIM a1 AS INTEGER : a1 = GUI_ACCORDION_ADD(akk, "Was ist ein Akkordeon?")
DIM a2 AS INTEGER : a2 = GUI_ACCORDION_ADD(akk, "Wie viele Abschnitte?")
DIM a3 AS INTEGER : a3 = GUI_ACCORDION_ADD(akk, "Und die Tastatur?")
GUI_ACCORDION_ADD_WIDGET(akk, GUI_LABEL(s5, "Abschnitte, die auf- und zuklappen -- weich.", 12, 10), a1)
GUI_ACCORDION_ADD_WIDGET(akk, GUI_LABEL(s5, "So viele, wie Platz ist; der Rest rollt.", 12, 10), a2)
GUI_ACCORDION_ADD_WIDGET(akk, GUI_LABEL(s5, "Pfeile wandern, Leertaste klappt.", 12, 10), a3)
GUI_ACCORDION_OPEN(akk, a1, TRUE)
DIM wz AS GUI_WIDGET : wz = GUI_WIZARD(s5, 20, 320, 1000, 300)
DIM w1 AS INTEGER : w1 = GUI_WIZARD_ADD(wz, "Willkommen")
DIM w2 AS INTEGER : w2 = GUI_WIZARD_ADD(wz, "Deine Angaben")
DIM w3 AS INTEGER : w3 = GUI_WIZARD_ADD(wz, "Fertig")
GUI_WIZARD_ADD_WIDGET(wz, GUI_LABEL(s5, "Ein Assistent fuehrt Schritt fuer Schritt -- Weiter, Zurueck, Fertig.", 50, 400), w1)
GUI_WIZARD_ADD_WIDGET(wz, GUI_TEXTINPUT(s5, 50, 400, 300, 30, "E-Mail"), w2)
GUI_WIZARD_ADD_WIDGET(wz, GUI_LABEL(s5, "Geschafft! Der Knopf Fertig beendet den Assistenten.", 50, 400), w3)

' --------------------------------------------------- 6 Lebendig
DIM s6 AS GUI_WINDOW : s6 = seite("Lebendig")
DIM pa AS GUI_WIDGET : pa = GUI_PANEL(s6, 30, 30, 220, 150, "schwebt und wandert")
DIM pb AS GUI_WIDGET : pb = GUI_PANEL(s6, 280, 30, 220, 150, "pulsiert")
