=== in spalte 0 bleibt der block wie kopiert
' Beim Dogfooding 2026-09-30 gefunden: eine ganze Zeile markiert (Ende,
' Umschalt+Pos1) und einen eingerueckten Block darueber gesetzt -- IF, ELSE
' und END IF landeten in Spalte 0, der Rumpf eingerueckt. In Spalte 0 sagt
' nichts, wohin der Block gehoert; er bleibt, wie er kopiert wurde.
DIM prT AS GUI_WIDGET : prT = tabFelder[aktiverTab]
CLIPBOARD_SET("    IF a THEN" + NL + "        b = 1" + NL + "    ELSE" + NL + "        b = 2" + NL + "    END IF")
GUI_TEXTAREA_SELECT(prT, 2, 1, 2, 1000000)
befehl("code_einfuegen")
protokoll("pr spalte0 |" + REPLACE$(GUI_TEXT(prT), NL, "/") + "|")
EXIT(0)
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- argumente
haupt.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei haupt.dh
SUB s()
    x = 1
END SUB
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 22) = "eingefuegt eingerueckt" THEN PRINT L[i]
NEXT
--- erwartet
pr spalte0 |SUB s()/    IF a THEN/        b = 1/    ELSE/        b = 2/    END IF/END SUB|
