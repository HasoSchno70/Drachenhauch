    END PROPERTY

    PROPERTY SET n(v AS INTEGER)
        Self._n = v
    END PROPERTY

    SUB Increment()
        Self.n = Self.n + 1
    END SUB
END CLASS

DIM c AS Counter
c = NEW Counter()
c.n = 5
c.Increment()
c.Increment()
PRINT c.n
--- erwartet
7

=== property does not collide with method (1)
' User-Methode `Get()` mit Pascal-Namen bleibt unbeeinflusst (kein
CLASS Foo
    DIM val AS INTEGER

    FUNCTION Get() AS INTEGER
        RETURN Self.val * 2
    END FUNCTION
END CLASS

DIM f AS Foo
f = NEW Foo()
f.val = 21
PRINT f.Get()
--- erwartet
42

