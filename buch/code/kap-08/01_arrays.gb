' Arrays: feste Anzahl Werte unter einem Namen.
'
' DIM zahlen[5] legt 5 Slots an, indiziert 0..4. Das nullte Element heisst
' zahlen[0], das letzte zahlen[4]. Wer zahlen[5] anspricht, bekommt einen
' Index-out-of-Range-Fehler.

DIM zahlen[5] AS INTEGER

zahlen[0] = 10
zahlen[1] = 20
zahlen[2] = 30
zahlen[3] = 40
zahlen[4] = 50

DIM i AS INTEGER
PRINT "Inhalt:"
FOR i = 0 TO 4
    PRINT f"  zahlen[{i}] = {zahlen[i]}"
NEXT i

' Summe ueber alle Elemente
DIM summe AS INTEGER
summe = 0
FOR i = 0 TO 4
    summe += zahlen[i]
NEXT i
PRINT f"Summe: {summe}"

' Maximum suchen
DIM groesster AS INTEGER
groesster = zahlen[0]
FOR i = 1 TO 4
    IF zahlen[i] > groesster THEN
        groesster = zahlen[i]
    END IF
NEXT i
PRINT f"Groesster: {groesster}"
