geladen: TRUE blau 6 stiche 185
aktive ebene Herz
auswahl 108 14,12-25,20
eingefuegt: +52 oben Einfügen auswahl jetzt 3,3
verschoben: auswahl 8,3 schritte +1 zelle 4,5 -1
gedreht: Drehen breite 9 hoehe 12 stiche gleich TRUE
geloescht: Löschen stiche -49
esc: auswahl weg TRUE
vieleck: blau 52 oben Vieleck ecken 0
vierfach: +4 TRUE TRUE TRUE
rueckstiche 2 oben Rückstich
entfernt: 1 oben Rückstich entfernen
zurueck: 2
erledigt 1 1 oben Fortschritt markieren
naechster offen 11,3
nach enter 12,3 erster offen 12,3
zurueckgenommen 10,5: 0
text: an der maus TRUE groesse 15x12 stiche > 20 TRUE
text gesetzt: +TRUE oben Text haengt FALSE
selten: 15 oben Seltene Farben zusammenlegen
geladen: rueckstiche 2 erledigt 30,5 TRUE stiche TRUE
text blau: TRUE
haken: TRUE
