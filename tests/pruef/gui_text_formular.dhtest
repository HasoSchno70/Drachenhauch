IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 10, 200, 26)
TRY
    GUI_WINDOW_DEFAULT(w, tf)
CATCH e
    PRINT e
END TRY
DIM w2 AS GUI_WINDOW : w2 = GUI_WINDOW("B", 20, 20, 100, 100)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w2, "x", 5, 5, 40, 20)
TRY
    GUI_WINDOW_DEFAULT(w, b)
CATCH e2
    PRINT e2
END TRY
GUI_WINDOW_DEFAULT(w, -1)
PRINT "ok"
