=== suche im netz: katalog zuerst, dann internet, uebersetzt, importiert
' Die Treffer des Katalogs stehen sofort da, die aus dem Internet kommen im
' Hintergrund dazu (englisch gefragt, der Schluessel in der Kopfzeile, nicht
' in der Adresse). Titel und Texte kommen erst englisch, dann deutsch;
' Einzelheiten laedt erst die Auswahl, importieren geht, wenn alles da ist.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
DIM srv AS INTEGER : srv = kNetzStarten(ARG$(2))
kSchluessel = "testschluessel"
PRINT "code "; kProbe(p, "probe.dh", "", 1500)
kOffEnde(srv)
DIM a AS STRING
' Die Uebersetzungen laufen zu viert gleichzeitig: sortiert.
DIM gets AS ARRAY OF STRING : gets = []
FOR EACH a IN READLINES(CWD$() + "/anfragen.txt")
    IF LEFT$(a, 5) = "/get " THEN
        ARRAY_PUSH(gets, a)
    ELSEIF a <> "" THEN
        PRINT "anfrage "; a
    END IF
NEXT
SORT(gets)
FOR EACH a IN gets
    PRINT "uebersetzt "; a
NEXT
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
{sammlung}/../_hilfen/spoon_server.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
SUB warten(kf AS KatalogFenster)
    DIM n AS INTEGER
    WHILE (kf.sucheAbruf >= 0 OR LEN(kf.detailAbrufe) > 0 OR ueOffen() > 0) AND n < 900 AND studioBild()
        n = n + 1
    WEND
END SUB
SUB zeilen(kf AS KatalogFenster)
    DIM i AS INTEGER
    FOR i = 0 TO GUI_TABLE_ROW_COUNT(kf.tabelle) - 1
        PRINT "  "; GUI_TABLE_GET_CELL(kf.tabelle, i, 0); " "; GUI_TABLE_GET_CELL(kf.tabelle, i, 1); " | "; GUI_TABLE_GET_CELL(kf.tabelle, i, 2); " | "; GUI_TABLE_GET_CELL(kf.tabelle, i, 3)
    NEXT
END SUB
DIM kf AS KatalogFenster : kf = NEW KatalogFenster()
kf.Zeigen()
PRINT "hinweis ["; GUI_TEXT(kf.hinweis); "]"
GUI_SET_TEXT(kf.sucheFeld, "Hähnchen")
kf.sucheFeld_Enter()
PRINT "sofort: "; GUI_TEXT(kf.ergebnis); " | "; GUI_TEXT(kf.hinweis); " | suchen an "; GUI_ENABLED(kf.knopfSuchen)
zeilen(kf)
warten(kf)
PRINT "danach: "; GUI_TEXT(kf.ergebnis); " | "; GUI_TEXT(kf.hinweis); " | suchen an "; GUI_ENABLED(kf.knopfSuchen); " | gewaehlt "; GUI_TABLE_SELECTED(kf.tabelle); " | details ["; GUI_TEXT(kf.details); "]"
zeilen(kf)
DIM z AS INTEGER
FOR z = 0 TO LEN(kf.treffer) - 1
    IF kf.treffer[z].netzId = 101 THEN GUI_TABLE_SET_SELECTED(kf.tabelle, z)
NEXT
kf.tabelle_Geaendert()
PRINT "gewaehlt: import an "; GUI_ENABLED(kf.knopfImport); " | "; REPLACE$(GUI_TEXT(kf.details), CHR$(10), " / ")
DIM n AS INTEGER
WHILE LEN(kf.detailAbrufe) > 0 AND n < 900 AND studioBild()
    n = n + 1
WEND
PRINT "einzelheiten da, uebersetzung offen "; ueOffen() > 0; " | import an "; GUI_ENABLED(kf.knopfImport); " | "; SPLIT(GUI_TEXT(kf.details), CHR$(10))[0]
kf.knopfImport_Klick()
PRINT "zu frueh importiert "; kf.importiert
warten(kf)
PRINT "uebersetzt: import an "; GUI_ENABLED(kf.knopfImport)
PRINT GUI_TEXT(kf.details)
GUI_SET_CHECKED(kf.uebersetzenSchalter, FALSE)
kf.uebersetzenSchalter_Geaendert()
PRINT "englisch: "; GUI_TABLE_GET_CELL(kf.tabelle, 0, 1); " | "; REPLACE$(GUI_TEXT(kf.details), CHR$(10), " / ")
GUI_SET_CHECKED(kf.uebersetzenSchalter, TRUE)
kf.uebersetzenSchalter_Geaendert()
PRINT "wieder deutsch: "; GUI_TABLE_GET_CELL(kf.tabelle, 0, 1); " | offen "; ueOffen()
kf.knopfImport_Klick()
PRINT "importiert "; kf.importiert
PRINT JOIN$(textListe("SELECT name || ' | ' || servings || ' | ' || IFNULL(prep_time_minutes, '-') || '+' || IFNULL(cook_time_minutes, '-') || ' | ' || REPLACE(IFNULL(description, '-'), CHAR(10), ' / ') || ' | ' || REPLACE(IFNULL(instructions, '-'), CHAR(10), ' / ') FROM recipes WHERE name LIKE 'Honig%'"), CHR$(10))
PRINT JOIN$(textListe("SELECT product_name || ' ' || quantity || ' ' || unit FROM recipe_ingredients WHERE recipe_id = (SELECT MAX(id) FROM recipes) ORDER BY id"), " / ")
PRINT "zurueck "; verlauf.rueckgaengig$(); " | "; dbZahl("SELECT COUNT(*) FROM recipes WHERE name LIKE 'Honig%'")
' Die Suppe hat nur bekannte Zutaten: nur ihre Texte sind noch unterwegs.
FOR z = 0 TO LEN(kf.treffer) - 1
    IF kf.treffer[z].netzId = 102 THEN GUI_TABLE_SET_SELECTED(kf.tabelle, z)
NEXT
kf.tabelle_Geaendert()
n = 0
WHILE LEN(kf.detailAbrufe) > 0 AND n < 900 AND studioBild()
    n = n + 1
WEND
PRINT "suppe da: offen "; ueOffen() > 0; " | import an "; GUI_ENABLED(kf.knopfImport)
warten(kf)
PRINT "suppe uebersetzt: import an "; GUI_ENABLED(kf.knopfImport)
DIM j AS JSON_HANDLE : j = JSON_PARSE(READALL(studioDbPfad$("uebersetzungen.json")))
PRINT "cache "; JSON_LEN(j, ""); " | "; JSON_GET_STRING(j, JSON_KEY$("Chicken Soup"))
END
