' ============================================================
'  DRACHENHAUCH -- Notenblatt (Weg B, der dritte der vier fehlenden Editoren)
' ============================================================
'  Komponieren in Notensatz-Darstellung wie im Qt-Notenblatt-Editor dhscore
'  (docs/score-editor.md), aber IN Drachenhauch: fuenf Linien je Spur,
'  Violin- oder Bassschluessel, Hilfslinien, Vorzeichen, Haelse, Faehnchen,
'  Balken, Pausen, Bindeboegen, Fingersatz, Staccato. Oben die Werkzeuge
'  (Dauer, Vorzeichen, Modus, Tempo), links je Spur Name, Schluessel und
'  Instrument, in der Mitte die Notensysteme -- mit den normalen
'  Zeichenbefehlen gemalt.
'
'  Das Modell ist das JSON der Qt-Fassung ("format": "dhscore-song",
'  Zeiten in Viertel-Beats), das Rueckgaengig ein JSON-Text je Stand.
'  [In Tracker oeffnen] rechnet das Stueck mit denselben Regeln wie
'  drachenhauch/score/convert.py in ein Tracker-Projekt um (4 Zeilen je
'  Beat, Patterns zu 64 Zeilen, Akkord -> hoechste Note, Staccato halbiert,
'  NOTE_OFF am Ende) und startet den Tracker-Piloten (190) damit.
'
'  Bedienung: Klick setzt eine Note (Dauer = Raster), Klick auf eine Note
'  entfernt sie, Ziehen verschiebt sie; rechte Maustaste entfernt immer.
'  Modus Pause/Bindebogen (zwei Klicks)/Fingersatz/Staccato wie in Qt.
'  Leertaste oder F5 spielt alles auf einer Audio-Uhr, Mausrad rollt die
'  Zeit (Umschalt: die Spuren), Strg+Z/Y Rueckgaengig/Wiederholen.
'
'  Aufruf:  dhrt run examples/199_notenblatt.dh [-- stueck.json]
'  Test:    DH_SCORE_LOG=<datei> protokolliert die Ereignisse zeilenweise.
' ============================================================
IMPORT "gui"
IMPORT "json"
IMPORT "audio"

CONST LINKS = 0                 ' Maustasten
CONST RECHTS = 1
CONST TOP_B = 96                ' Hoehe der Werkzeugleiste (mit Menue)
CONST LINKS_B = 250             ' Breite des Spurfensters
CONST STAFF_H = 190             ' Hoehe je Notensystem
CONST HALB = 7                  ' halber Linienabstand (STEP ist ein Schluesselwort)
CONST LEFT_MARGIN = 76          ' Platz fuer den Schluessel
CONST PPB = 64                  ' Pixel je Viertel-Beat
CONST NOTE_R = 6
CONST STEM_LEN = 32
CONST BARLINE_LEAD = 8
CONST MID_STEP = 4              ' ab hier zeigt der Hals nach unten
CONST MAX_SPUREN = 8
CONST ROWS_PER_BEAT = 4         ' Tracker: eine Zeile = Sechzehntel
CONST MAX_ROWS = 64
CONST NOTE_OFF = -1
CONST NL = CHR$(10)

SCREEN(1280, 800, "Drachenhauch - Notenblatt", 1)
WINDOW_RESIZABLE(TRUE)
WINDOW_MIN_SIZE(1024, 600)
SETFPS(60)
WINDOW_MAXIMIZE()
GUI_THEME_PRESET("glas_dunkel")

DIM uiFont AS INTEGER : uiFont = -1
DIM fp AS STRING
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "/System/Library/Fonts/Supplemental/Arial.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    IF uiFont < 0 AND FILEEXISTS(fp) THEN uiFont = LOADFONT(fp, 32)
NEXT
IF uiFont >= 0 THEN SETFONT(uiFont) : TEXT_SIZE(16)

DIM logDatei AS STRING : logDatei = GETENV$("DH_SCORE_LOG")
SUB protokoll(text AS STRING)
    IF logDatei = "" THEN RETURN
    DIM f AS FILE
    f = OPENFILE(logDatei, "a")
    WRITELINE(f, text)
    CLOSEFILE(f)
END SUB

FUNCTION zahl$(v AS FLOAT) AS STRING
    IF v = INT(v) THEN RETURN STR$(INT(v))
    RETURN STR$(v)
END FUNCTION

' --- Instrumente: dieselbe Tabelle wie tracker/presets.py und der Tracker-Pilot
DIM pName AS ARRAY OF STRING : pName = []
DIM pWave AS ARRAY OF STRING : pWave = []
DIM pAtk AS ARRAY OF INTEGER : pAtk = []
DIM pDec AS ARRAY OF INTEGER : pDec = []
DIM pSus AS ARRAY OF FLOAT : pSus = []
DIM pRel AS ARRAY OF INTEGER : pRel = []
DIM pVd AS ARRAY OF FLOAT : pVd = []
DIM pVs AS ARRAY OF FLOAT : pVs = []
DIM pDet AS ARRAY OF FLOAT : pDet = []

SUB preset(nm AS STRING, wf AS STRING, atk AS INTEGER, dec AS INTEGER, sus AS FLOAT, rel AS INTEGER, vd AS FLOAT, vs AS FLOAT, det AS FLOAT)
    ARRAY_PUSH(pName, nm) : ARRAY_PUSH(pWave, wf)
    ARRAY_PUSH(pAtk, atk) : ARRAY_PUSH(pDec, dec) : ARRAY_PUSH(pSus, sus) : ARRAY_PUSH(pRel, rel)
    ARRAY_PUSH(pVd, vd) : ARRAY_PUSH(pVs, vs) : ARRAY_PUSH(pDet, det)
END SUB

preset("Fluegel (Piano)", "triangle",   2, 700, 0.0,  200, 0.0,  0.0, 6.0)
preset("E-Piano",         "sine",       2, 450, 0.30, 220, 0.0,  0.0, 8.0)
preset("Orgel",           "square",     6,   0, 1.0,   70, 0.06, 6.0, 5.0)
preset("Kirchenorgel",    "saw",       14,   0, 1.0,  140, 0.04, 5.0, 10.0)
preset("Streicher",       "saw",      140,   0, 1.0,  280, 0.05, 5.0, 14.0)
preset("Synth-Pad",       "triangle", 220,   0, 0.85, 420, 0.03, 4.0, 18.0)
preset("Bass",            "square",     2, 140, 0.55,  80, 0.0,  0.0, 0.0)
preset("Synth-Bass",      "saw",        2, 120, 0.50,  70, 0.0,  0.0, 6.0)
preset("Lead",            "saw",        2,   0, 0.9,   90, 0.05, 6.0, 4.0)
preset("Pluck",           "triangle",   1, 220, 0.0,  130, 0.0,  0.0, 4.0)
preset("Glocke",          "sine",       1, 900, 0.0,  320, 0.0,  0.0, 10.0)
preset("Marimba",         "sine",       1, 260, 0.0,  130, 0.0,  0.0, 0.0)
preset("Chip-Square",     "square",     1,   0, 1.0,   20, 0.0,  0.0, 0.0)
preset("Chip-Saw",        "saw",        1,   0, 1.0,   20, 0.0,  0.0, 0.0)
preset("Kick",            "sine",       0,  90, 0.0,   30, 0.0,  0.0, 0.0)
preset("Snare",           "noise",      0, 140, 0.0,   40, 0.0,  0.0, 0.0)
preset("HiHat",           "noise",      0,  40, 0.0,   20, 0.0,  0.0, 0.0)
preset("Tom",             "sine",       0, 160, 0.0,   40, 0.0,  0.0, 0.0)

FUNCTION presetJson(j AS INTEGER) AS JSON_HANDLE
    DIM io AS JSON_HANDLE : io = JSON_NEW_OBJECT()
    JSON_SET_STRING(io, "name", pName[j])
    JSON_SET_STRING(io, "kind", "synth")
    JSON_SET_INT(io, "default_vol", 15)
    JSON_SET_FLOAT(io, "pan", 0.0)
    JSON_SET_STRING(io, "waveform", pWave[j])
    JSON_SET_STRING(io, "loop_mode", "none")
    JSON_SET_INT(io, "loop_start", 0) : JSON_SET_INT(io, "loop_end", 0)
    JSON_SET_INT(io, "env_attack_ms", pAtk[j]) : JSON_SET_INT(io, "env_decay_ms", pDec[j])
    JSON_SET_FLOAT(io, "env_sustain", pSus[j]) : JSON_SET_INT(io, "env_release_ms", pRel[j])
    JSON_SET_FLOAT(io, "vib_depth", pVd[j]) : JSON_SET_FLOAT(io, "vib_speed", pVs[j])
    JSON_SET_FLOAT(io, "detune_cents", pDet[j])
    RETURN io
END FUNCTION

' Namen fuer die Klappliste: alle Presets plus ein Platz fuer ein Instrument
' aus einer Datei, das keinem Preset entspricht.
DIM instNamen AS ARRAY OF STRING : instNamen = []
DIM pi AS INTEGER
FOR pi = 0 TO LEN(pName) - 1
    ARRAY_PUSH(instNamen, pName[pi])
NEXT
ARRAY_PUSH(instNamen, "(aus Datei)")

' --- Modell -----------------------------------------------------------------
DIM doc AS JSON_HANDLE
DIM pfad AS STRING : pfad = ""
DIM geaendert AS BOOLEAN : geaendert = FALSE
DIM staende AS ARRAY OF STRING : staende = []
DIM standPos AS INTEGER : standPos = -1
DIM scrollX AS INTEGER : scrollX = 0
DIM scrollY AS INTEGER : scrollY = 0

FUNCTION nt() AS INTEGER
    RETURN JSON_LEN(doc, "tracks")
END FUNCTION
FUNCTION tp$(i AS INTEGER, feld AS STRING) AS STRING
    RETURN "tracks." + STR$(i) + "." + feld
END FUNCTION
FUNCTION nn(i AS INTEGER) AS INTEGER
    RETURN JSON_LEN(doc, tp$(i, "notes"))
END FUNCTION
FUNCTION np$(i AS INTEGER, k AS INTEGER, feld AS STRING) AS STRING
    RETURN "tracks." + STR$(i) + ".notes." + STR$(k) + "." + feld
END FUNCTION

FUNCTION text$(p AS STRING) AS STRING
    IF NOT JSON_HAS(doc, p) THEN RETURN ""
    IF JSON_TYPE(doc, p) <> "string" THEN RETURN ""
    RETURN JSON_GET_STRING(doc, p)
END FUNCTION
FUNCTION ganz(p AS STRING, sonst AS INTEGER) AS INTEGER
    IF NOT JSON_HAS(doc, p) THEN RETURN sonst
    IF JSON_TYPE(doc, p) <> "number" THEN RETURN sonst
    RETURN INT(JSON_GET_FLOAT(doc, p))
END FUNCTION
FUNCTION komma(p AS STRING, sonst AS FLOAT) AS FLOAT
    IF NOT JSON_HAS(doc, p) THEN RETURN sonst
    IF JSON_TYPE(doc, p) <> "number" THEN RETURN sonst
    RETURN JSON_GET_FLOAT(doc, p)
END FUNCTION
FUNCTION wahr(p AS STRING, sonst AS BOOLEAN) AS BOOLEAN
    IF NOT JSON_HAS(doc, p) THEN RETURN sonst
    IF JSON_TYPE(doc, p) <> "boolean" THEN RETURN sonst
    RETURN JSON_GET_BOOL(doc, p)
END FUNCTION

FUNCTION istPause(i AS INTEGER, k AS INTEGER) AS BOOLEAN
    IF wahr(np$(i, k, "rest"), FALSE) THEN RETURN TRUE
    RETURN NOT JSON_HAS(doc, np$(i, k, "pitch"))
END FUNCTION
FUNCTION nStart(i AS INTEGER, k AS INTEGER) AS FLOAT
    RETURN komma(np$(i, k, "start"), 0.0)
END FUNCTION
FUNCTION nDauer(i AS INTEGER, k AS INTEGER) AS FLOAT
    RETURN komma(np$(i, k, "dur"), 1.0)
END FUNCTION
FUNCTION nPitch(i AS INTEGER, k AS INTEGER) AS INTEGER
    RETURN ganz(np$(i, k, "pitch"), 60)
END FUNCTION
FUNCTION bpm() AS INTEGER
    RETURN CLAMP(ganz("bpm", 120), 20, 400)
END FUNCTION
FUNCTION spurLaenge(i AS INTEGER) AS FLOAT
    DIM m AS FLOAT : m = 0.0
    DIM k AS INTEGER
    FOR k = 0 TO nn(i) - 1
        m = MAX(m, nStart(i, k) + nDauer(i, k))
    NEXT
    RETURN m
END FUNCTION
FUNCTION stueckLaenge() AS FLOAT
    DIM m AS FLOAT : m = 0.0
    DIM i AS INTEGER
    FOR i = 0 TO nt() - 1
        m = MAX(m, spurLaenge(i))
    NEXT
    RETURN m
END FUNCTION
FUNCTION notenGesamt() AS INTEGER
    DIM s AS INTEGER : s = 0
    DIM i AS INTEGER
    FOR i = 0 TO nt() - 1
        s = s + nn(i)
    NEXT
    RETURN s
END FUNCTION

' Note an einem Beat (erste Treffende), -1 = keine.
FUNCTION noteBei(i AS INTEGER, beat AS FLOAT) AS INTEGER
    DIM k AS INTEGER
    FOR k = 0 TO nn(i) - 1
        IF ABS(nStart(i, k) - beat) < 0.000001 THEN RETURN k
    NEXT
    RETURN -1
END FUNCTION

' Ein Teilbaum als eigenes Handle -- ueber seine Werte; ganze Zahlen bleiben ganz.
FUNCTION teilbaum(h AS JSON_HANDLE, p AS STRING) AS JSON_HANDLE
    DIM typ AS STRING : typ = JSON_TYPE(h, p)
    IF typ = "array" THEN
        DIM a AS JSON_HANDLE : a = JSON_NEW_ARRAY()
        DIM n AS INTEGER : n = JSON_LEN(h, p)
        DIM i AS INTEGER
        FOR i = 0 TO n - 1
            DIM ep AS STRING : ep = p + "." + STR$(i)
            DIM et AS STRING : et = JSON_TYPE(h, ep)
            IF et = "string" THEN JSON_APPEND_STRING(a, "", JSON_GET_STRING(h, ep))
            IF et = "number" THEN
                DIM ef AS FLOAT : ef = JSON_GET_FLOAT(h, ep)
                IF ef = INT(ef) THEN JSON_APPEND_INT(a, "", INT(ef)) ELSE JSON_APPEND_FLOAT(a, "", ef)
            END IF
            IF et = "boolean" THEN JSON_APPEND_BOOL(a, "", JSON_GET_BOOL(h, ep))
            IF et = "null" THEN JSON_APPEND_NULL(a, "")
            IF et = "array" OR et = "object" THEN JSON_APPEND_JSON(a, "", teilbaum(h, ep))
        NEXT
        RETURN a
    END IF
    DIM o AS JSON_HANDLE : o = JSON_NEW_OBJECT()
    DIM k AS STRING
    FOR EACH k IN JSON_KEYS(h, p)
        DIM kp AS STRING : kp = p + "." + k
        DIM kt AS STRING : kt = JSON_TYPE(h, kp)
        IF kt = "string" THEN JSON_SET_STRING(o, k, JSON_GET_STRING(h, kp))
        IF kt = "number" THEN
            DIM kf AS FLOAT : kf = JSON_GET_FLOAT(h, kp)
            IF kf = INT(kf) THEN JSON_SET_INT(o, k, INT(kf)) ELSE JSON_SET_FLOAT(o, k, kf)
        END IF
        IF kt = "boolean" THEN JSON_SET_BOOL(o, k, JSON_GET_BOOL(h, kp))
        IF kt = "null" THEN JSON_SET_NULL(o, k)
        IF kt = "array" OR kt = "object" THEN JSON_SET_JSON(o, k, teilbaum(h, kp))
    NEXT
    RETURN o
END FUNCTION

' Noten einer Spur nach Beginn sortieren (die Datei der Qt-Fassung ist sortiert,
' und die Balkengruppen verlassen sich darauf).
SUB notenSortieren(i AS INTEGER)
    DIM n AS INTEGER : n = nn(i)
    IF n < 2 THEN RETURN
    DIM idx AS ARRAY OF INTEGER : idx = []
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        ARRAY_PUSH(idx, k)
    NEXT
    DIM a AS INTEGER
    DIM b AS INTEGER
    FOR a = 1 TO n - 1
        b = a
        WHILE b > 0
            IF nStart(i, idx[b - 1]) > nStart(i, idx[b]) THEN
                DIM tmp AS INTEGER : tmp = idx[b - 1] : idx[b - 1] = idx[b] : idx[b] = tmp
                b = b - 1
            ELSE
                b = 0
            END IF
        WEND
    NEXT
    DIM neu AS JSON_HANDLE : neu = JSON_NEW_ARRAY()
    FOR k = 0 TO n - 1
        JSON_APPEND_JSON(neu, "", teilbaum(doc, "tracks." + STR$(i) + ".notes." + STR$(idx[k])))
    NEXT
    JSON_SET_JSON(doc, tp$(i, "notes"), neu)
END SUB

' --- Rueckgaengig -------------------------------------------------------------
SUB merken()
    DIM t AS STRING : t = JSON_STRINGIFY(doc)
    WHILE LEN(staende) > standPos + 1
        ARRAY_REMOVE_AT(staende, LEN(staende) - 1)
    WEND
    ARRAY_PUSH(staende, t)
    IF LEN(staende) > 200 THEN ARRAY_REMOVE_AT(staende, 0)
    standPos = LEN(staende) - 1
    geaendert = TRUE
END SUB

' --- Tonhoehe <-> Linie ---------------------------------------------------------
DIM natur AS ARRAY OF INTEGER : natur = [0, 2, 4, 5, 7, 9, 11]

FUNCTION naturIndex(pc AS INTEGER) AS INTEGER
    DIM j AS INTEGER
    FOR j = 0 TO 6
        IF natur[j] = pc THEN RETURN j
    NEXT
    RETURN -1
END FUNCTION

' Diatonischer Index: streng monoton mit der Tonhoehe, Linien sind diatonisch
' gleich verteilt (C->D und E->F je EIN Schritt), nicht halbtonlinear.
FUNCTION diaIndex(midi AS INTEGER) AS INTEGER
    DIM pc AS INTEGER : pc = midi MOD 12
    DIM okt AS INTEGER : okt = midi \ 12 - 1
    DIM ni AS INTEGER : ni = naturIndex(pc)
    IF ni < 0 THEN ni = naturIndex(pc - 1)
    RETURN okt * 7 + ni
END FUNCTION

FUNCTION hatVorzeichen(midi AS INTEGER) AS BOOLEAN
    RETURN naturIndex(midi MOD 12) < 0
END FUNCTION

FUNCTION schluesselRef(i AS INTEGER) AS INTEGER
    IF text$(tp$(i, "clef")) = "bass" THEN RETURN 43
    RETURN 64
END FUNCTION

DIM gx0 AS INTEGER : gx0 = LINKS_B
DIM gy0 AS INTEGER : gy0 = TOP_B + 8

FUNCTION spurOben(i AS INTEGER) AS INTEGER
    RETURN gy0 + i * STAFF_H - scrollY
END FUNCTION
FUNCTION yRef(i AS INTEGER) AS INTEGER
    RETURN spurOben(i) + 30 + 8 * HALB
END FUNCTION
FUNCTION stufe(i AS INTEGER, midi AS INTEGER) AS INTEGER
    RETURN diaIndex(midi) - diaIndex(schluesselRef(i))
END FUNCTION
FUNCTION yStufe(i AS INTEGER, s AS INTEGER) AS INTEGER
    RETURN yRef(i) - s * HALB
END FUNCTION
FUNCTION yNote(i AS INTEGER, k AS INTEGER) AS INTEGER
    IF istPause(i, k) THEN RETURN yStufe(i, 4)
    RETURN yStufe(i, stufe(i, nPitch(i, k)))
END FUNCTION
FUNCTION pitchBeiY(i AS INTEGER, y AS INTEGER, acc AS INTEGER) AS INTEGER
    DIM s AS INTEGER : s = INT(ROUND((yRef(i) - y) / HALB))
    DIM dia AS INTEGER : dia = diaIndex(schluesselRef(i)) + s
    DIM okt AS INTEGER : okt = dia \ 7
    DIM ni AS INTEGER : ni = dia MOD 7
    RETURN (okt + 1) * 12 + natur[ni] + acc
END FUNCTION
FUNCTION xBeat(beat AS FLOAT) AS INTEGER
    RETURN INT(gx0 + LEFT_MARGIN + beat * PPB) - scrollX
END FUNCTION
FUNCTION beatBeiX(x AS INTEGER) AS FLOAT
    RETURN MAX(0.0, (x + scrollX - gx0 - LEFT_MARGIN) / PPB)
END FUNCTION

' --- Fenster oben: Werkzeuge mit Menue --------------------------------------------
DIM winTop AS GUI_WINDOW : winTop = GUI_WINDOW("Werkzeuge", 0, 0, SCREENWIDTH(), TOP_B)
