' Bedienung aufnehmen und als Fall speichern (aufnahme.rs, gui_zustand.rs):
' GUI_STATE$ ist der Zustand der gui als Text; DHRT_ABSPIELEN spielt eine
' Aufnahme nach SCREEN ab, DHRT_GUI_ZUSTAND=1 gibt am Ende den Zustand aus;
' `dhrt aufnehmen` setzt beides zu einem Fall zusammen.
' Format: docs/werkzeuge.md, dhrt test.

=== gui_state nennt felder haken werte und auswahl
TRY
    SCREEN(500, 300, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Form", 0, 0, 500, 300)
DIM l AS GUI_WIDGET : l = GUI_LABEL(w, "Hallo", 10, 10)
DIM t AS GUI_WIDGET : t = GUI_TEXTINPUT(w, 10, 40, 200, 26)
GUI_SET_NAME(t, "name")
GUI_SET_TEXT(t, "Ada" + CHR$(10) + "L.")
DIM pw AS GUI_WIDGET : pw = GUI_TEXTINPUT(w, 10, 70, 200, 26)
GUI_SET_TEXT(pw, "geheim")
GUI_TEXTINPUT_SET(pw, "passwort", 1)
DIM c AS GUI_WIDGET : c = GUI_CHECKBOX(w, "Rabatt", 10, 100, TRUE)
DIM s AS GUI_WIDGET : s = GUI_SLIDER(w, 10, 130, 200, 0, 10, 2.5)
DIM d AS GUI_WIDGET : d = GUI_DROPDOWN(w, 10, 160, 200, 26, ["rot", "gruen", "blau"])
GUI_DROPDOWN_SET_SELECTED(d, 2)
' Eine Tabelle: Zeilen, die gewaehlte und die erste Spalte (seit 2026-11-22).
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 220, 100, 260, 120)
GUI_TABLE_HEADERS(tb, ["Titel", "Jahr"])
GUI_TABLE_ADD_ROW(tb, ["Momo", "1973"])
GUI_TABLE_ADD_ROW(tb, ["Tetris", "1984"])
GUI_TABLE_SET_SELECTED(tb, 1)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "Knopf", 300, 10, 100, 30)
DIM weg AS GUI_WIDGET : weg = GUI_LABEL(w, "versteckt", 300, 60)
GUI_SET_VISIBLE(weg, FALSE)
GUI_UPDATE()
PRINT GUI_STATE$()
--- erwartet
fenster "Form"
  label(1) "Hallo"
  textinput#name "Ada\nL."
  textinput(2) "******"
  checkbox(1) "Rabatt" an
  slider(1) 2.5
  dropdown(1) 2 "blau"
  table(1) 2 Zeilen, gewaehlt 1: "Momo" "Tetris"

=== eine aufnahme spielt ohne code ab und der zustand steht am ende da
IMPORT "gui"
SCREEN(400, 200, "T", 1)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Zaehler", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "Mehr", 20, 20, 120, 40)
DIM l AS GUI_WIDGET : l = GUI_LABEL(w, "0", 20, 100)
DIM n AS INTEGER
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_CLICKED(b) THEN
        n = n + 1
        GUI_SET_TEXT(l, STR$(n))
    END IF
    CLS(0) : GUI_DRAW() : FLIP()
WEND
--- datei ev.txt
c 7
e 0 7 60 40 0 0
e 3 6 0 0 0 0
e 4 5 0 0 0 0
e 8 6 0 0 0 0
e 9 5 0 0 0 0
e 13 6 0 0 0 0
e 14 5 0 0 0 0

--- umgebung
DHRT_FRAMES=30
DHRT_ABSPIELEN=ev.txt
DHRT_GUI_ZUSTAND=1
DHRT_ABSEITS=1
--- erwartet
gui-zustand
fenster "Zaehler"
  label(1) "3"

=== dhrt aufnehmen schreibt einen fall der sich abspielen laesst
' Ohne Hand am Geraet nimmt die Aufnahme nichts auf -- der Fall prueft den
' Weg: Programm laufen lassen, Fall schreiben (Pfad, Beilage, Umgebung,
' Zustand), und der Fall laeuft gruen.
TRY
    SCREEN(100, 100, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
WRITEALL("prog.dh", "IMPORT " + CHR$(34) + "gui" + CHR$(34) + CHR$(10) + _
    "SCREEN(300, 120, " + CHR$(34) + "P" + CHR$(34) + ", 1)" + CHR$(10) + _
    "DIM w AS GUI_WINDOW : w = GUI_WINDOW(" + CHR$(34) + "Probe" + CHR$(34) + ", 0, 0, 300, 120)" + CHR$(10) + _
    "DIM l AS GUI_WIDGET : l = GUI_LABEL(w, " + CHR$(34) + "bereit" + CHR$(34) + ", 10, 10)" + CHR$(10) + _
    "WHILE NOT QUITREQUESTED() : GUI_UPDATE() : CLS(0) : GUI_DRAW() : FLIP() : WEND" + CHR$(10))
FUNCTION lauf$(p AS INTEGER) AS STRING
    DIM aus AS STRING
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE PROCESS_RUNNING(p) AND MILLIS() - t0 < 60000
        aus = aus + PROCESS_READ$(p) + PROCESS_ERR$(p)
        SLEEP(20)
    WEND
    DIM stille AS INTEGER
    WHILE stille < 5
        DIM r AS STRING : r = PROCESS_READ$(p) + PROCESS_ERR$(p)
        IF r = "" THEN
            stille = stille + 1
            SLEEP(30)
        ELSE
            aus = aus + r
        END IF
    WEND
    RETURN aus
END FUNCTION
DIM a AS STRING : a = lauf$(PROCESS_START("dhrt", "aufnehmen", "prog.dh", "faelle.dhtest", "die probe", "--bilder", "20"))
DIM fall AS STRING : fall = READALL$("faelle.dhtest")
PRINT "programm "; INSTR(fall, "--- programm prog.dh") >= 0; " beilage "; INSTR(fall, "--- datei aufnahme.txt") >= 0; _
    " abspielen "; INSTR(fall, "DHRT_ABSPIELEN=aufnahme.txt") >= 0; " zustand "; INSTR(fall, "  label(1) " + CHR$(34) + "bereit" + CHR$(34)) >= 0
DIM t AS STRING : t = lauf$(PROCESS_START("dhrt", "test", "faelle.dhtest"))
PRINT "abgespielt "; INSTR(t, "1 Faelle, 1 ok") >= 0
--- erwartet
programm TRUE beilage TRUE abspielen TRUE zustand TRUE
abgespielt TRUE
