=== regex find first (1)
IMPORT "regex"
PRINT REGEX_FIND("foo123bar456", "[0-9]+")
PRINT REGEX_FIND("nothing here", "[0-9]+")
--- erwartet
123

=== regex find first (2)
IMPORT "regex"
PRINT REGEX_FIND("foo123bar456", "[0-9]+")
PRINT REGEX_FIND("nothing here", "[0-9]+")
--- erwartet
123

=== regex find all (1)
IMPORT "regex"
DIM nums AS ARRAY OF STRING
nums = REGEX_FIND_ALL("a1 b22 c333", "[0-9]+")
PRINT nums.length()
PRINT nums[0]
PRINT nums[1]
PRINT nums[2]
--- erwartet
3
1
22
333

=== regex find all (2)
