' Datenbindung im gui-Modul: GUI_BIND, GUI_FORM_GET/SET/CLEAR/CLEAN/CHANGED
' und GUI_FORM_LOAD/SAVE gegen SQLite.
'
' Der sechste Pilot fuellte drei Formulare von Hand aus der Datenbank und
' schrieb sie von Hand zurueck. Jetzt traegt jedes Widget einen Schluessel, und
' ein Aufruf laedt, speichert oder vergleicht das ganze Formular.
'
' Bis 2026-09-16 tests/test_gui_bindung.py (dort las Pythons sqlite3 die
' Datenbank). Jetzt liest sie ein zweiter Prozess im --- nachher, mit
' typeof() -- also am gespeicherten Typ, nicht an dem, was das Formular zeigt.

=== get und changed kennen den sauberen stand
IMPORT "gui"
IMPORT "db"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM name AS GUI_WIDGET : name = GUI_TEXTINPUT(w, 10, 10, 200, 28, "")
DIM plz AS GUI_WIDGET : plz = GUI_TEXTINPUT(w, 10, 50, 200, 28, "")
GUI_TEXTINPUT_SET(plz, "zahlen", 1)
DIM preis AS GUI_WIDGET : preis = GUI_TEXTINPUT(w, 10, 90, 200, 28, "")
GUI_TEXTINPUT_SET(preis, "zahlen", 2)
DIM aktiv AS GUI_WIDGET : aktiv = GUI_CHECKBOX(w, "aktiv", 10, 130)
DIM art AS GUI_WIDGET : art = GUI_DROPDOWN(w, 10, 160, 200, 28, ["Privat", "Firma"])
DIM andere AS GUI_WIDGET : andere = GUI_TEXTINPUT(w, 250, 10, 200, 28, "")
GUI_BIND(name, "name", "kunde") : GUI_BIND(plz, "plz", "kunde") : GUI_BIND(preis, "preis", "kunde")
GUI_BIND(aktiv, "aktiv", "kunde") : GUI_BIND(art, "art", "kunde")
GUI_BIND(andere, "titel", "artikel")
DIM db AS DB_CONN : db = DB_OPEN("b.db")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT, plz INTEGER, preis REAL, aktiv INTEGER, art INTEGER)")
GUI_UPDATE()
PRINT GUI_FORM_CHANGED(w, "kunde")
GUI_SET_TEXT(name, "Anna") : GUI_SET_CHECKED(aktiv, TRUE) : GUI_DROPDOWN_SET_SELECTED(art, 1)
' Das andere Formular bleibt unberuehrt.
PRINT GUI_FORM_CHANGED(w, "kunde") ; " " ; GUI_FORM_CHANGED(w, "artikel")
' Texte; Kaestchen 1/0, Klappliste als Index; fremde Schluessel fehlen.
DIM m AS MAP OF STRING : m = GUI_FORM_GET(w, "kunde")
PRINT MAPGET(m, "name") ; "|" ; MAPGET(m, "plz") ; "|" ; MAPGET(m, "aktiv") ; "|" ; MAPGET(m, "art") ; "|" ; MAPHAS(m, "titel")
GUI_FORM_CLEAN(w, "kunde")
PRINT GUI_FORM_CHANGED(w, "kunde")
' Leeren heisst leer UND sauber.
GUI_FORM_CLEAR(w, "kunde")
PRINT "[" ; GUI_TEXT(name) ; "] " ; GUI_CHECKED(aktiv) ; " " ; GUI_DROPDOWN_SELECTED(art) ; " " ; GUI_FORM_CHANGED(w, "kunde")
--- erwartet
FALSE
TRUE FALSE
Anna||1|1|FALSE
FALSE
[] FALSE -1 FALSE

=== save schreibt typisiert und load holt zurueck
IMPORT "gui"
IMPORT "db"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM name AS GUI_WIDGET : name = GUI_TEXTINPUT(w, 10, 10, 200, 28, "")
DIM plz AS GUI_WIDGET : plz = GUI_TEXTINPUT(w, 10, 50, 200, 28, "")
GUI_TEXTINPUT_SET(plz, "zahlen", 1)
DIM preis AS GUI_WIDGET : preis = GUI_TEXTINPUT(w, 10, 90, 200, 28, "")
GUI_TEXTINPUT_SET(preis, "zahlen", 2)
DIM aktiv AS GUI_WIDGET : aktiv = GUI_CHECKBOX(w, "aktiv", 10, 130)
DIM art AS GUI_WIDGET : art = GUI_DROPDOWN(w, 10, 160, 200, 28, ["Privat", "Firma"])
DIM andere AS GUI_WIDGET : andere = GUI_TEXTINPUT(w, 250, 10, 200, 28, "")
GUI_BIND(name, "name", "kunde") : GUI_BIND(plz, "plz", "kunde") : GUI_BIND(preis, "preis", "kunde")
GUI_BIND(aktiv, "aktiv", "kunde") : GUI_BIND(art, "art", "kunde")
GUI_BIND(andere, "titel", "artikel")
DIM db AS DB_CONN : db = DB_OPEN("b.db")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT, plz INTEGER, preis REAL, aktiv INTEGER, art INTEGER)")
GUI_UPDATE()
' Die Ausgabe geht zusaetzlich in aus.txt: verglichen wird die Ausgabe des
' nachher-Programms, das die Datenbank als zweiter Prozess liest.
DIM aus AS STRING : aus = ""
GUI_SET_TEXT(name, "Anna") : GUI_SET_TEXT(plz, "80331") : GUI_SET_TEXT(preis, "19,99")
GUI_SET_CHECKED(aktiv, TRUE) : GUI_DROPDOWN_SET_SELECTED(art, 1)
DIM id AS INTEGER : id = GUI_FORM_SAVE(w, db, "kunden", -1, "kunde")
' INSERT liefert die neue id, danach ist der Stand sauber.
aus = aus + STR$(id) + " " + STR$(GUI_FORM_CHANGED(w, "kunde")) + CHR$(10)
GUI_FORM_CLEAR(w, "kunde")
aus = aus + STR$(GUI_FORM_LOAD(w, db, "kunden", id, "kunde")) + CHR$(10)
' Geladen und sauber; die Kommazahl deutsch.
aus = aus + GUI_TEXT(name) + "|" + GUI_TEXT(plz) + "|" + GUI_TEXT(preis) + "|" + STR$(GUI_CHECKED(aktiv)) + "|" + STR$(GUI_DROPDOWN_SELECTED(art)) + "|" + STR$(GUI_FORM_CHANGED(w, "kunde")) + CHR$(10)
GUI_SET_TEXT(name, "Anna Berger")
' UPDATE liefert dieselbe id; eine id, die es nicht gibt, laedt nichts.
aus = aus + STR$(GUI_FORM_SAVE(w, db, "kunden", id, "kunde")) + CHR$(10)
aus = aus + STR$(GUI_FORM_LOAD(w, db, "kunden", 999, "kunde")) + CHR$(10)
DB_CLOSE(db)
WRITEALL("aus.txt", aus)
--- nachher
IMPORT "db"
DIM z AS ARRAY OF STRING : z = READLINES("aus.txt")
DIM i AS INTEGER
FOR i = 0 TO LEN(z) - 1
    PRINT z[i]
NEXT
' Zahlenfeld -> Zahl, Kaestchen -> 0/1, Klappliste -> Index -- nachgesehen mit
' typeof(), also am gespeicherten Typ, nicht an der Anzeige.
' Die PLZ beweist dabei nichts -- SQLite macht aus "80331" ueber die
' Spaltenaffinitaet ohnehin eine Zahl. Die Probe ist der Preis: "19,99" wird nur
' als Zahlenfeld zu real (Gegenprobe ohne GUI_TEXTINPUT_SET(preis, ...) faellt).
DIM c AS DB_CONN : c = DB_OPEN("b.db")
DIM r AS DB_RESULT : r = DB_QUERY(c, "SELECT name, plz, preis, aktiv, art, typeof(plz), typeof(preis), typeof(aktiv), (SELECT COUNT(*) FROM kunden) FROM kunden")
IF DB_NEXT(r) THEN
    PRINT DB_GET_STRING(r, 0); "|"; DB_GET_INT(r, 1); "|"; DB_GET_FLOAT(r, 2); "|"; DB_GET_INT(r, 3); "|"; DB_GET_INT(r, 4)
    PRINT DB_GET_STRING(r, 5); " "; DB_GET_STRING(r, 6); " "; DB_GET_STRING(r, 7); " zeilen "; DB_GET_INT(r, 8)
END IF
--- erwartet
1 FALSE
TRUE
Anna|80331|19,99|TRUE|1|FALSE
1
FALSE
Anna Berger|80331|19.99|1|1
integer real integer zeilen 1

=== set aus einer map ist tolerant
IMPORT "gui"
IMPORT "db"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM name AS GUI_WIDGET : name = GUI_TEXTINPUT(w, 10, 10, 200, 28, "")
DIM plz AS GUI_WIDGET : plz = GUI_TEXTINPUT(w, 10, 50, 200, 28, "")
GUI_TEXTINPUT_SET(plz, "zahlen", 1)
DIM preis AS GUI_WIDGET : preis = GUI_TEXTINPUT(w, 10, 90, 200, 28, "")
GUI_TEXTINPUT_SET(preis, "zahlen", 2)
DIM aktiv AS GUI_WIDGET : aktiv = GUI_CHECKBOX(w, "aktiv", 10, 130)
DIM art AS GUI_WIDGET : art = GUI_DROPDOWN(w, 10, 160, 200, 28, ["Privat", "Firma"])
DIM andere AS GUI_WIDGET : andere = GUI_TEXTINPUT(w, 250, 10, 200, 28, "")
GUI_BIND(name, "name", "kunde") : GUI_BIND(plz, "plz", "kunde") : GUI_BIND(preis, "preis", "kunde")
GUI_BIND(aktiv, "aktiv", "kunde") : GUI_BIND(art, "art", "kunde")
GUI_BIND(andere, "titel", "artikel")
DIM db AS DB_CONN : db = DB_OPEN("b.db")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT, plz INTEGER, preis REAL, aktiv INTEGER, art INTEGER)")
GUI_UPDATE()
' "ja" -> Haken, Eintragstext -> Index, Text bleibt Text (fuehrende Null).
DIM m AS MAP OF STRING : m = {"name": "Kolb", "aktiv": "ja", "art": "firma", "plz": "01067"}
GUI_FORM_SET(w, m, "kunde")
PRINT GUI_TEXT(name) ; "|" ; GUI_CHECKED(aktiv) ; "|" ; GUI_DROPDOWN_SELECTED(art) ; "|" ; GUI_TEXT(plz) ; "|" ; GUI_FORM_CHANGED(w, "kunde")
' Zahlen aus einer MAP OF INTEGER; nicht genannte Felder bleiben.
DIM z AS MAP OF INTEGER : z = {"aktiv": 0, "art": 0}
GUI_FORM_SET(w, z, "kunde")
PRINT GUI_CHECKED(aktiv) ; "|" ; GUI_DROPDOWN_SELECTED(art) ; "|" ; GUI_TEXT(name)
--- erwartet
Kolb|TRUE|1|01067|FALSE
FALSE|0|Kolb

=== die bindung prueft ihre argumente
IMPORT "gui"
IMPORT "db"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM name AS GUI_WIDGET : name = GUI_TEXTINPUT(w, 10, 10, 200, 28, "")
DIM plz AS GUI_WIDGET : plz = GUI_TEXTINPUT(w, 10, 50, 200, 28, "")
GUI_TEXTINPUT_SET(plz, "zahlen", 1)
DIM preis AS GUI_WIDGET : preis = GUI_TEXTINPUT(w, 10, 90, 200, 28, "")
GUI_TEXTINPUT_SET(preis, "zahlen", 2)
DIM aktiv AS GUI_WIDGET : aktiv = GUI_CHECKBOX(w, "aktiv", 10, 130)
DIM art AS GUI_WIDGET : art = GUI_DROPDOWN(w, 10, 160, 200, 28, ["Privat", "Firma"])
DIM andere AS GUI_WIDGET : andere = GUI_TEXTINPUT(w, 250, 10, 200, 28, "")
GUI_BIND(name, "name", "kunde") : GUI_BIND(plz, "plz", "kunde") : GUI_BIND(preis, "preis", "kunde")
GUI_BIND(aktiv, "aktiv", "kunde") : GUI_BIND(art, "art", "kunde")
GUI_BIND(andere, "titel", "artikel")
DIM db AS DB_CONN : db = DB_OPEN("b.db")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT, plz INTEGER, preis REAL, aktiv INTEGER, art INTEGER)")
GUI_UPDATE()
TRY
    GUI_BIND(name, "na-me")
CATCH e
    PRINT "spaltenname "; (INSTR(e, "Spaltenname") >= 0)
END TRY
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 0, 0, 40, 20)
TRY
    GUI_BIND(b, "x")
CATCH e2
    PRINT "knopf hat keinen wert "; (INSTR(e2, "keinen Wert") >= 0)
END TRY
TRY
    GUI_FORM_LOAD(w, db, "kun den", 1, "kunde")
CATCH e3
    PRINT "tabellenname "; (INSTR(e3, "kein Tabellenname") >= 0)
END TRY
TRY
    GUI_FORM_SAVE(w, db, "kunden", -1, "nix")
CATCH e4
    PRINT "leeres formular "; (INSTR(e4, "kein Widget gebunden") >= 0)
END TRY
--- erwartet
spaltenname TRUE
knopf hat keinen wert TRUE
tabellenname TRUE
leeres formular TRUE

=== die bindung ueberlebt die datei
IMPORT "gui"
IMPORT "db"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM name AS GUI_WIDGET : name = GUI_TEXTINPUT(w, 10, 10, 200, 28, "")
DIM plz AS GUI_WIDGET : plz = GUI_TEXTINPUT(w, 10, 50, 200, 28, "")
GUI_TEXTINPUT_SET(plz, "zahlen", 1)
DIM preis AS GUI_WIDGET : preis = GUI_TEXTINPUT(w, 10, 90, 200, 28, "")
GUI_TEXTINPUT_SET(preis, "zahlen", 2)
DIM aktiv AS GUI_WIDGET : aktiv = GUI_CHECKBOX(w, "aktiv", 10, 130)
DIM art AS GUI_WIDGET : art = GUI_DROPDOWN(w, 10, 160, 200, 28, ["Privat", "Firma"])
DIM andere AS GUI_WIDGET : andere = GUI_TEXTINPUT(w, 250, 10, 200, 28, "")
GUI_BIND(name, "name", "kunde") : GUI_BIND(plz, "plz", "kunde") : GUI_BIND(preis, "preis", "kunde")
GUI_BIND(aktiv, "aktiv", "kunde") : GUI_BIND(art, "art", "kunde")
GUI_BIND(andere, "titel", "artikel")
DIM db AS DB_CONN : db = DB_OPEN("b.db")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT, plz INTEGER, preis REAL, aktiv INTEGER, art INTEGER)")
GUI_UPDATE()
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT GUI_TO_JSON(w2) = j ; " " ; INSTR(j, "bind") >= 0
DIM m AS MAP OF STRING : m = GUI_FORM_GET(w2, "kunde")
PRINT MAPHAS(m, "name") ; " " ; MAPHAS(m, "titel")
--- erwartet
TRUE TRUE
TRUE FALSE
