' ---- Daten im Speicher ---------------------------------------------------
' Die Datenbank ist die Wahrheit, die Tabelle nur ihre Ansicht. Deshalb
' merkt sich jede Tabellenzeile die id ihres Spiels.
CONST MAXSPIELE = 200
DIM spielId[MAXSPIELE] AS INTEGER
DIM anstoss[MAXSPIELE] AS INTEGER      ' Anstoss als Zeitpunkt, 0 = unbekannt
DIM spieleAnzahl AS INTEGER

' ---- Tippschluss ---------------------------------------------------------
' Eine Regel, eine Stelle -- wie bei punkte(). Beide Fragen, die das
' Programm stellt ("darf noch?" und "wie lange noch?"), rechnen mit
' derselben Zahl.
FUNCTION tippschluss(zeile AS INTEGER) AS INTEGER
    IF anstoss[zeile] = 0 THEN RETURN 0
    RETURN ZEIT_PLUS(anstoss[zeile], -TIPPSCHLUSS_VOR)
END FUNCTION

FUNCTION offen(zeile AS INTEGER) AS BOOLEAN
    ' Ohne bekannten Anstoss bleibt getippt erlaubt -- ein fehlender
    ' Termin darf niemanden aussperren.
    IF anstoss[zeile] = 0 THEN RETURN TRUE
    RETURN ZEIT_JETZT() < tippschluss(zeile)
END FUNCTION

FUNCTION restText(zeile AS INTEGER) AS STRING
    IF anstoss[zeile] = 0 THEN RETURN "Termin offen"
    IF offen(zeile) THEN
        RETURN "noch " + ZEIT_DAUER$(ZEIT_DIFF(tippschluss(zeile), ZEIT_JETZT())) + " zu tippen"
    END IF
    RETURN "Tippschluss war " + ZEIT_DAUER$(ZEIT_DIFF(tippschluss(zeile), ZEIT_JETZT()))
END FUNCTION

CONST MAXSPIELER = 50
DIM spielerId[MAXSPIELER] AS INTEGER
DIM spielerAnzahl AS INTEGER

CONST MAXGRUPPEN = 50
DIM gruppeId[MAXGRUPPEN] AS INTEGER      ' je Zeile der Gruppentabelle
DIM gruppenAnzahl AS INTEGER
DIM wertungId[MAXGRUPPEN + 1] AS INTEGER ' je Eintrag der Wertungsauswahl, 0 = alle
DIM mitgliedId[MAXSPIELER] AS INTEGER    ' je Zeile der Mitgliedertabelle
DIM mitgliedAnzahl AS INTEGER

SUB melde(text AS STRING)
    GUI_SET_TEXT(stand, text)
END SUB

SUB meldeGruppe(text AS STRING)
    GUI_SET_TEXT(gruppenStand, text)
END SUB

FUNCTION aktiverSpieler() AS INTEGER
    DIM i AS INTEGER : i = GUI_DROPDOWN_SELECTED(spielerWahl)
    IF i < 0 OR i >= spielerAnzahl THEN RETURN 0
    RETURN spielerId[i]
END FUNCTION

FUNCTION aktiverSpieltag() AS INTEGER
    RETURN INT(GUI_VALUE(tagWahl))
END FUNCTION

' Das Kuerzel der gewaehlten Liga -- 'bl1' oder 'bl2'. Es ist dasselbe, das
' die API benutzt und das in der Datenbank steht: eine Schreibweise, keine
' Umrechnungstabelle.
FUNCTION aktiveLiga() AS STRING
    DIM i AS INTEGER : i = GUI_DROPDOWN_SELECTED(ligaWahl)
    IF i < 0 OR i >= LIGEN THEN RETURN ligaKuerzel[0]
    RETURN ligaKuerzel[i]
END FUNCTION

' Auf welchen Spieltag schaut man beim Start? Auf den, in dem das naechste
' Spiel liegt, das noch nicht angepfiffen ist -- dort steht die Arbeit an.
' Ist die Saison durch, bleibt der letzte stehen.
'
' Der Vergleich laeuft als Text: anstoss steht als "JJJJ-MM-TT hh:mm:ss"
' in der Datenbank, und in dieser Schreibweise sortiert Text wie Zeit.
' Jede Liga hat ihren eigenen Spielplan -- gefragt ist der Spieltag der
' Liga, die gerade gewaehlt ist.
FUNCTION spieltagVorschlag() AS INTEGER
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT spieltag FROM spiele " + _
                     "WHERE liga = ? AND anstoss IS NOT NULL AND anstoss >= ? " + _
                     "ORDER BY anstoss LIMIT 1", aktiveLiga(), ZEIT_TEXT$(ZEIT_JETZT()))
    DIM tag AS INTEGER : tag = 0
    IF DB_NEXT(r) THEN tag = DB_GET_INT(r, 0)
    DB_CLOSE_RESULT(r)

    IF tag = 0 THEN
        r = DB_QUERY(db, "SELECT COALESCE(MAX(spieltag), 1) FROM spiele WHERE liga = ?", _
                     aktiveLiga())
        IF DB_NEXT(r) THEN tag = DB_GET_INT(r, 0)
        DB_CLOSE_RESULT(r)
    END IF
    IF tag < 1 THEN RETURN 1
    IF tag > MAX_SPIELTAG THEN RETURN MAX_SPIELTAG
    RETURN tag
END FUNCTION

SUB spielerLaden()
    spielerAnzahl = 0
    DIM namen[MAXSPIELER] AS STRING
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT id, name FROM spieler ORDER BY name")
    WHILE DB_NEXT(r)
        IF spielerAnzahl >= MAXSPIELER THEN BREAK
        spielerId[spielerAnzahl] = DB_GET_INT(r, 0)
        namen[spielerAnzahl] = DB_GET_STRING(r, 1)
        spielerAnzahl = spielerAnzahl + 1
    WEND
    DB_CLOSE_RESULT(r)

    DIM liste[spielerAnzahl] AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO spielerAnzahl - 1
        liste[i] = namen[i]
    NEXT
    GUI_SET_DROPDOWN(spielerWahl, liste)
    GUI_DROPDOWN_SET_SELECTED(spielerWahl, 0)
END SUB

' Die Spiele des Spieltags mit dem Tipp des gewaehlten Spielers.
' Ein LEFT JOIN, damit auch Spiele ohne Tipp in der Liste stehen.
SUB spieleLaden()
    GUI_TABLE_CLEAR(tabelle)
    spieleAnzahl = 0
    DIM getippt AS INTEGER : getippt = 0

    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT s.id, s.heim, s.gast, s.tore_heim, s.tore_gast, " + _
                     "       t.tipp_heim, t.tipp_gast, t.punkte, s.anstoss " + _
                     "FROM spiele s " + _
                     "LEFT JOIN tipps t ON t.spiel_id = s.id AND t.spieler_id = ? " + _
                     "WHERE s.liga = ? AND s.spieltag = ? " + _
                     "ORDER BY s.anstoss, s.id", _
                 aktiverSpieler(), aktiveLiga(), aktiverSpieltag())

    WHILE DB_NEXT(r)
        IF spieleAnzahl >= MAXSPIELE THEN BREAK

        DIM tippText AS STRING : tippText = "-:-"
        IF NOT DB_IS_NULL(r, 5) THEN
            tippText = STR$(DB_GET_INT(r, 5)) + ":" + STR$(DB_GET_INT(r, 6))
            getippt = getippt + 1
        END IF

        DIM ergText AS STRING : ergText = "-:-"
        DIM beendet AS BOOLEAN : beendet = NOT DB_IS_NULL(r, 3)
        IF beendet THEN
            ergText = STR$(DB_GET_INT(r, 3)) + ":" + STR$(DB_GET_INT(r, 4))
        END IF

        DIM punkteText AS STRING : punkteText = ""
        IF beendet AND NOT DB_IS_NULL(r, 7) THEN punkteText = STR$(DB_GET_INT(r, 7))

        ' Aus "2026-08-28 20:30:00" wird "Fr 28.08. 20:30" -- der Text aus der
        ' Datenbank einmal in eine Zahl und wieder heraus.
        DIM anstossText AS STRING : anstossText = "offen"
        anstoss[spieleAnzahl] = 0
        IF NOT DB_IS_NULL(r, 8) THEN
            IF ZEIT_LESBAR(DB_GET_STRING(r, 8)) THEN
                anstoss[spieleAnzahl] = ZEIT_PARSE(DB_GET_STRING(r, 8))
                anstossText = ZEIT_FORMAT$(anstoss[spieleAnzahl], "WT TT.MM. hh:mm")
            END IF
        END IF

        DIM zeile AS ARRAY OF STRING
        zeile = SPLIT$(anstossText + "|" + _
                       DB_GET_STRING(r, 1) + "|" + DB_GET_STRING(r, 2) + "|" + _
                       tippText + "|" + ergText + "|" + punkteText, "|")
        GUI_TABLE_ADD_ROW(tabelle, zeile)
        spielId[spieleAnzahl] = DB_GET_INT(r, 0)

        ' Ist die Zeile schon zu? Grau heisst: hier geht nichts mehr.
        IF anstoss[spieleAnzahl] > 0 AND NOT offen(spieleAnzahl) THEN
            GUI_TABLE_CELL_COLOR(tabelle, spieleAnzahl, 0, &H8A93A6, -1)
        END IF

        ' Gewertete Zeilen nach Ausbeute faerben -- man sieht auf einen
        ' Blick, wo Punkte liegen.
        IF punkteText <> "" THEN
            DIM p AS INTEGER : p = DB_GET_INT(r, 7)
            IF p >= 3 THEN
                GUI_TABLE_CELL_COLOR(tabelle, spieleAnzahl, 4, &H7CE38B, -1)
            ELIF p >= 1 THEN
                GUI_TABLE_CELL_COLOR(tabelle, spieleAnzahl, 4, &HE8C46A, -1)
            ELSE
                GUI_TABLE_CELL_COLOR(tabelle, spieleAnzahl, 4, &HE07A7A, -1)
            END IF
        END IF

        spieleAnzahl = spieleAnzahl + 1
    WEND
    DB_CLOSE_RESULT(r)

    IF spieleAnzahl = 0 THEN
        GUI_SET_TEXT(lblGetippt, "keine Spiele -- Spielplan holen")
    ELSE
        GUI_SET_TEXT(lblGetippt, STR$(getippt) + " von " + STR$(spieleAnzahl) + " getippt")
    END IF
END SUB

' Welche Wertung ist gewaehlt? 0 = alle Spieler, sonst die Gruppen-id.
FUNCTION aktiveWertung() AS INTEGER
    DIM i AS INTEGER : i = GUI_DROPDOWN_SELECTED(wertungWahl)
    IF i < 0 OR i > gruppenAnzahl THEN RETURN 0
    RETURN wertungId[i]
END FUNCTION

SUB ranglisteLaden()
    GUI_TABLE_CLEAR(rang)
    DIM r AS DB_RESULT
    ' Gewertet wird nur, was ein Ergebnis hat -- ein Tipp auf ein noch
    ' nicht gespieltes Spiel ist keine Null, er zaehlt einfach nicht.
    '
    ' Die Tippgemeinschaft engt nur den Kreis ein, die Rechnung bleibt
    ' dieselbe: "? = 0" heisst alle. So steht die Rangliste einmal da und
    ' nicht zweimal -- eine Regel, eine Stelle, auch beim Auswerten.
    r = DB_QUERY(db, "SELECT p.name, " + _
                     "  COALESCE(SUM(CASE WHEN s.tore_heim IS NOT NULL " + _
                     "                    THEN t.punkte END), 0) AS punkte, " + _
                     "  COUNT(t.id) AS tipps " + _
                     "FROM spieler p " + _
                     "LEFT JOIN tipps t ON t.spieler_id = p.id " + _
                     "LEFT JOIN spiele s ON s.id = t.spiel_id " + _
                     "WHERE ? = 0 OR EXISTS (SELECT 1 FROM gruppen_mitglieder m " + _
                     "                       WHERE m.gruppe_id = ? AND m.spieler_id = p.id) " + _
                     "GROUP BY p.id, p.name " + _
                     "ORDER BY punkte DESC, p.name", aktiveWertung(), aktiveWertung())
    DIM platz AS INTEGER : platz = 1
    WHILE DB_NEXT(r)
        DIM zeile AS ARRAY OF STRING
        zeile = SPLIT$(STR$(platz) + "|" + DB_GET_STRING(r, 0) + "|" + _
                       STR$(DB_GET_INT(r, 1)) + "|" + STR$(DB_GET_INT(r, 2)), "|")
        GUI_TABLE_ADD_ROW(rang, zeile)
        IF platz = 1 THEN GUI_TABLE_ROW_COLOR(rang, platz - 1, &HF4E3A6, -1)
        platz = platz + 1
    WEND
    DB_CLOSE_RESULT(r)
END SUB

' ---- Tippgemeinschaften --------------------------------------------------
' Die Gruppentabelle und die Wertungsauswahl kommen aus derselben Abfrage:
' beide zeigen dieselbe Liste, nur an zwei Orten.
SUB gruppenLaden()
    ' Die angeklickte Zeile ueberlebt das Neuladen -- sonst spraenge die
    ' Mitgliederliste weg, sobald man jemanden aufnimmt.
    DIM warZeile AS INTEGER : warZeile = GUI_TABLE_SELECTED(gruppenTab)

    GUI_TABLE_CLEAR(gruppenTab)
    gruppenAnzahl = 0

    DIM namen[MAXGRUPPEN + 1] AS STRING
    namen[0] = "Alle Spieler"
    wertungId[0] = 0

    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT g.id, g.name, COUNT(m.spieler_id) " + _
                     "FROM gruppen g " + _
                     "LEFT JOIN gruppen_mitglieder m ON m.gruppe_id = g.id " + _
                     "GROUP BY g.id, g.name ORDER BY g.name")
    WHILE DB_NEXT(r)
        IF gruppenAnzahl >= MAXGRUPPEN THEN BREAK
        DIM zeile AS ARRAY OF STRING
        zeile = SPLIT$(DB_GET_STRING(r, 1) + "|" + STR$(DB_GET_INT(r, 2)), "|")
        GUI_TABLE_ADD_ROW(gruppenTab, zeile)
        gruppeId[gruppenAnzahl] = DB_GET_INT(r, 0)
        namen[gruppenAnzahl + 1] = DB_GET_STRING(r, 1)
        wertungId[gruppenAnzahl + 1] = DB_GET_INT(r, 0)
        gruppenAnzahl = gruppenAnzahl + 1
    WEND
    DB_CLOSE_RESULT(r)

    ' Die Auswahl wieder auf dieselbe Gemeinschaft stellen, wenn es sie noch
    ' gibt -- sonst spraenge die Wertung bei jedem Umbau auf "Alle Spieler".
    DIM vorher AS INTEGER : vorher = aktiveWertung()
    DIM liste[gruppenAnzahl + 1] AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO gruppenAnzahl
        liste[i] = namen[i]
    NEXT
    GUI_SET_DROPDOWN(wertungWahl, liste)

    DIM wieder AS INTEGER : wieder = 0
    FOR i = 0 TO gruppenAnzahl
        IF wertungId[i] = vorher THEN wieder = i
    NEXT
    GUI_DROPDOWN_SET_SELECTED(wertungWahl, wieder)

    ' Beim ersten Mal die oberste waehlen: sonst steht der halbe Reiter leer
    ' da und man muss erst raten, dass ein Klick fehlt.
    IF warZeile < 0 AND gruppenAnzahl > 0 THEN warZeile = 0
    IF warZeile >= 0 AND warZeile < gruppenAnzahl THEN
        GUI_TABLE_SET_SELECTED(gruppenTab, warZeile)
    END IF
END SUB

' Welche Gemeinschaft ist in der Tabelle angeklickt? 0 = keine.
FUNCTION gewaehlteGruppe() AS INTEGER
    DIM z AS INTEGER : z = GUI_TABLE_SELECTED(gruppenTab)
    IF z < 0 OR z >= gruppenAnzahl THEN RETURN 0
    RETURN gruppeId[z]
END FUNCTION

' Alle Spieler, mit Haken bei denen, die dabei sind. Bewusst ALLE und nicht
' nur die Mitglieder: aufnehmen kann man nur, wen man sieht.
SUB mitgliederLaden()
    GUI_TABLE_CLEAR(mitgliedTab)
    mitgliedAnzahl = 0

    DIM g AS INTEGER : g = gewaehlteGruppe()
    IF g = 0 THEN
        GUI_SET_TEXT(lblMitglieder, "Mitglieder: (keine Gemeinschaft gewählt)")
        RETURN
    END IF
    GUI_SET_TEXT(lblMitglieder, "Mitglieder:")

    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT p.id, p.name, " + _
                     "  EXISTS (SELECT 1 FROM gruppen_mitglieder m " + _
                     "          WHERE m.gruppe_id = ? AND m.spieler_id = p.id) " + _
                     "FROM spieler p ORDER BY p.name", g)
    WHILE DB_NEXT(r)
        IF mitgliedAnzahl >= MAXSPIELER THEN BREAK
        DIM dabei AS STRING : dabei = ""
        IF DB_GET_INT(r, 2) = 1 THEN dabei = "ja"
        DIM zeile AS ARRAY OF STRING
        zeile = SPLIT$(DB_GET_STRING(r, 1) + "|" + dabei, "|")
        GUI_TABLE_ADD_ROW(mitgliedTab, zeile)
        mitgliedId[mitgliedAnzahl] = DB_GET_INT(r, 0)
        mitgliedAnzahl = mitgliedAnzahl + 1
    WEND
    DB_CLOSE_RESULT(r)
END SUB

' Punkte aller Tipps eines Spiels neu rechnen -- nach jedem Ergebnis.
SUB punkteNeu(spiel AS INTEGER, ergH AS INTEGER, ergA AS INTEGER)
    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT id, tipp_heim, tipp_gast FROM tipps WHERE spiel_id = ?", spiel)

    CONST MAXT = 200
    DIM ids[MAXT] AS INTEGER
    DIM werte[MAXT] AS INTEGER
    DIM n AS INTEGER : n = 0
    WHILE DB_NEXT(r)
        IF n >= MAXT THEN BREAK
        ids[n] = DB_GET_INT(r, 0)
        werte[n] = punkte(DB_GET_INT(r, 1), DB_GET_INT(r, 2), ergH, ergA)
        n = n + 1
    WEND
    DB_CLOSE_RESULT(r)

    ' Erst lesen, dann schreiben: waehrend ein Ergebnis-Cursor offen ist,
    ' schreibt es sich schlecht in dieselbe Tabelle.
    DB_BEGIN(db)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DB_EXEC(db, "UPDATE tipps SET punkte = ? WHERE id = ?", werte[i], ids[i])
    NEXT
    DB_COMMIT(db)
END SUB

' Punkte ALLER gewerteten Tipps neu rechnen -- nach einem Ergebnis-Import.
'
' Warum alles statt nur der geaenderten Spiele? Nach einem Abruf ist nicht
' abzusehen, welche Ergebnisse dazukamen und welche berichtigt wurden. Die
' Regel einmal ueber alles laufen zu lassen ist bei dieser Datenmenge
' billiger als Buch darueber zu fuehren -- und es kann nichts stehenbleiben.
'
' Die Listen wachsen mit (ARRAY OF INTEGER + ARRAY_PUSH) statt fester
' Groesse: wie viele Tipps zusammenkommen, haengt an der Zahl der Mitspieler.
SUB punkteAlleNeu()
    DIM ids AS ARRAY OF INTEGER
    DIM werte AS ARRAY OF INTEGER
    ids = []
    werte = []

    DIM r AS DB_RESULT
    r = DB_QUERY(db, "SELECT t.id, t.tipp_heim, t.tipp_gast, " + _
                     "       s.tore_heim, s.tore_gast " + _
                     "FROM tipps t JOIN spiele s ON s.id = t.spiel_id " + _
                     "WHERE s.tore_heim IS NOT NULL")
    WHILE DB_NEXT(r)
        ARRAY_PUSH(ids, DB_GET_INT(r, 0))
        ARRAY_PUSH(werte, punkte(DB_GET_INT(r, 1), DB_GET_INT(r, 2), _
                                 DB_GET_INT(r, 3), DB_GET_INT(r, 4)))
    WEND
    DB_CLOSE_RESULT(r)

    DB_BEGIN(db)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(ids) - 1
        DB_EXEC(db, "UPDATE tipps SET punkte = ? WHERE id = ?", werte[i], ids[i])
    NEXT
    DB_COMMIT(db)
END SUB

' ---- Spielplan aus dem Netz ----------------------------------------------
' Der Abruf laeuft im Hintergrund: HTTP_GET_START gibt sofort eine Nummer
' zurueck, die Schleife fragt jedes Bild einmal nach. Mit HTTP_GET stuende
' das Fenster stattdessen eine Fuenftelsekunde still -- bei schlechter
' Verbindung bis zu zehn Sekunden.
'
' Zwei Ligen heissen zwei Abrufe -- und die laufen NEBENEINANDER, nicht
' nacheinander: zwei gleichzeitig sind zusammen so schnell wie einer.
DIM abruf[LIGEN] AS INTEGER
DIM holSpiele AS INTEGER
DIM holErgVorher AS INTEGER

SUB abrufeLeeren()
    DIM i AS INTEGER
    FOR i = 0 TO LIGEN - 1
        abruf[i] = -1
    NEXT
END SUB
abrufeLeeren()

FUNCTION abrufLaeuft() AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LIGEN - 1
        IF abruf[i] >= 0 THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

SUB spielplanHolen()
    IF abrufLaeuft() THEN
        melde("Es wird schon geholt.")
        RETURN
    END IF
    holSpiele = 0
    ' Wie viele Spiele hatten VORHER ein Ergebnis? Die Differenz am Ende
    ' sagt, wie viele dazugekommen sind -- billiger als jedes Spiel einzeln
    ' zu vergleichen, und fuer die Meldung genau die richtige Zahl. Der Stand
    ' muss vor dem ERSTEN Abruf genommen werden, nicht vor jedem.
    holErgVorher = anzahl("SELECT COUNT(*) FROM spiele WHERE tore_heim IS NOT NULL")

    DIM i AS INTEGER
    FOR i = 0 TO LIGEN - 1
        abruf[i] = HTTP_GET_START(API + ligaKuerzel[i] + "/" + SAISON)
    NEXT
    melde("Spielplan und Ergebnisse beider Ligen werden geholt ...")
END SUB

' Das ENDERGEBNIS eines Spiels aus der Antwort holen -- nicht das erstbeste.
'
' Hier liegt die Falle: matchResults hat zwei Eintraege, und der ERSTE ist
' das Halbzeitergebnis. Gladbach gegen Leverkusen stand zur Pause 0:2 und
' endete 2:3. Wer matchResults.0 nimmt, wertet die ganze Saison falsch aus,
' und zwar plausibel falsch -- es stehen ja Zahlen da.
' Woran man das Endergebnis erkennt: resultTypeID = 2 (1 ist die Halbzeit).
'
' Gewertet wird nur, was abgepfiffen ist. Ein laufendes Spiel hat schon ein
' matchResults, aber noch kein Ergebnis.
FUNCTION endergebnis(wurzel AS JSON_HANDLE, pfad AS STRING, _
                     BYREF toreHeim AS INTEGER, BYREF toreGast AS INTEGER) AS BOOLEAN
    IF NOT JSON_HAS(wurzel, pfad + ".matchIsFinished") THEN RETURN FALSE
    IF NOT JSON_GET_BOOL(wurzel, pfad + ".matchIsFinished") THEN RETURN FALSE

    DIM n AS INTEGER : n = JSON_LEN(wurzel, pfad + ".matchResults")
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        DIM rp AS STRING : rp = pfad + ".matchResults." + STR$(k)
        IF JSON_GET_INT(wurzel, rp + ".resultTypeID") = 2 THEN
            toreHeim = JSON_GET_INT(wurzel, rp + ".pointsTeam1")
            toreGast = JSON_GET_INT(wurzel, rp + ".pointsTeam2")
            RETURN TRUE
        END IF
    NEXT
    RETURN FALSE
END FUNCTION

' Aus der Antwort die Paarungen, Anstosszeiten und Ergebnisse uebernehmen.
' Nur eintragen -- was danach zu tun ist, entscheidet abrufPruefen(), wenn
' BEIDE Ligen da sind.
SUB spielplanUebernehmen(text AS STRING)
    DIM wurzel AS JSON_HANDLE
    wurzel = JSON_PARSE(text)
    DIM n AS INTEGER : n = JSON_LEN(wurzel, "")
    IF n <= 0 THEN RETURN

    ' Zu welcher Liga gehoert diese Antwort? Sie sagt es selbst. Sich zu
    ' merken, welche Nummer welchen Abruf angestossen hat, waere Buchfuehrung
    ' ueber etwas, das sowieso mitgeliefert wird -- und sie koennte falsch
    ' sein, die Antwort nicht.
    DIM liga AS STRING : liga = JSON_GET_STRING(wurzel, "0.leagueShortcut")
    IF liga = "" THEN RETURN

    DB_BEGIN(db)
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        ' Pfade sind durchgehend Punkte, auch fuer Array-Plaetze:
        ' "0.team1.teamName" ist das Heimteam des ersten Spiels.
        DIM pfad AS STRING : pfad = STR$(i)
        DIM heim AS STRING : heim = JSON_GET_STRING(wurzel, pfad + ".team1.teamName")
        DIM gast AS STRING : gast = JSON_GET_STRING(wurzel, pfad + ".team2.teamName")
        ' Welcher Spieltag -- die Antwort weiss es selbst. Aus der URL liesse
        ' es sich nicht mehr ablesen: sie holt die ganze Saison.
        DIM tag AS INTEGER : tag = JSON_GET_INT(wurzel, pfad + ".group.groupOrderID")
        IF heim <> "" AND gast <> "" AND tag >= 1 AND tag <= MAX_SPIELTAG THEN
            ' Die API liefert "2026-08-28T20:30:00" -- ZEIT_PARSE versteht
            ' das T, ZEIT_TEXT$ macht die Normalform daraus, die in der
            ' Datenbank steht.
            DIM roh AS STRING : roh = JSON_GET_STRING(wurzel, pfad + ".matchDateTime")
            DIM termin AS STRING : termin = ""
            IF ZEIT_LESBAR(roh) THEN termin = ZEIT_TEXT$(ZEIT_PARSE(roh))
            spielAnlegen(liga, tag, heim, gast, termin)
            holSpiele = holSpiele + 1

            ' Ist das Spiel gelaufen, kommt das Ergebnis gleich mit -- es
            ' steht in derselben Antwort. Ein zweiter Abruf dafuer waere
            ' derselbe Abruf.
            DIM eh AS INTEGER : eh = 0
            DIM ea AS INTEGER : ea = 0
            IF endergebnis(wurzel, pfad, eh, ea) THEN
                ergebnisSetzen(liga, tag, heim, gast, eh, ea)
            END IF
        END IF
    NEXT
    DB_COMMIT(db)
END SUB

' Was nach dem letzten Abruf zu tun ist -- einmal, nicht je Liga.
SUB abrufAbschliessen()
    ' punkteAlleNeu fuehrt seine eigene Transaktion, deshalb erst hier und
    ' nicht im Import: Transaktionen lassen sich nicht schachteln.
    punkteAlleNeu()

    DIM neueErg AS INTEGER
    neueErg = anzahl("SELECT COUNT(*) FROM spiele WHERE tore_heim IS NOT NULL") - holErgVorher

    ' Nach einem frischen Spielplan dorthin springen, wo die Arbeit ansteht.
    IF holSpiele > 0 THEN GUI_SET_VALUE(tagWahl, spieltagVorschlag())
    spieleLaden()
    ranglisteLaden()

    DIM meldung AS STRING
    meldung = STR$(holSpiele) + " Spiele aus beiden Ligen"
    IF neueErg = 1 THEN
        meldung = meldung + ", 1 neues Ergebnis"
    ELIF neueErg > 1 THEN
        meldung = meldung + ", " + STR$(neueErg) + " neue Ergebnisse"
    END IF
    melde(meldung + ".")
END SUB

' Einmal pro Bild nachsehen -- nicht warten. Beide Abrufe werden gefragt;
' welcher zuerst fertig ist, ist gleichgueltig.
SUB abrufPruefen()
    IF NOT abrufLaeuft() THEN RETURN

    DIM i AS INTEGER
    DIM angekommen AS BOOLEAN : angekommen = FALSE
    FOR i = 0 TO LIGEN - 1
        IF abruf[i] >= 0 AND HTTP_READY(abruf[i]) THEN
            DIM nummer AS INTEGER : nummer = abruf[i]
            abruf[i] = -1                ' erst freigeben, dann auswerten
            angekommen = TRUE
            TRY
                spielplanUebernehmen(HTTP_RESULT(nummer))
            CATCH e
                melde("Spielplan nicht erreichbar: " + e)
            END TRY
        END IF
    NEXT

    ' Erst wenn keiner mehr aussteht -- sonst rechnete die zweite Liga die
    ' Punkte der ersten gleich noch einmal nach.
    IF angekommen AND NOT abrufLaeuft() THEN abrufAbschliessen()
END SUB

' Die Ligen stehen fest -- sie kommen aus den Konstanten, nicht aus der
' Datenbank.
DIM ligaListe[LIGEN] AS STRING
DIM li AS INTEGER
FOR li = 0 TO LIGEN - 1
    ligaListe[li] = ligaName[li]
NEXT
GUI_SET_DROPDOWN(ligaWahl, ligaListe)
GUI_DROPDOWN_SET_SELECTED(ligaWahl, 0)

spielerLaden()
gruppenLaden()
mitgliederLaden()
' Nicht bei 1 anfangen, sondern dort, wo der naechste Anpfiff liegt.
GUI_SET_VALUE(tagWahl, spieltagVorschlag())
spieleLaden()
ranglisteLaden()
meldeGruppe("Gemeinschaft anklicken, dann Spieler aufnehmen oder entfernen.")
melde("Liga, Spieltag und Spieler waehlen, Zeile anklicken, Tipp eingeben.")

' ---- Hauptschleife -------------------------------------------------------
DIM letzterSpieler AS INTEGER : letzterSpieler = 0
DIM letzterTag AS INTEGER : letzterTag = aktiverSpieltag()
DIM letzteZeile AS INTEGER : letzteZeile = -1
DIM letzteSekunde AS INTEGER : letzteSekunde = 0
DIM letzteWertung AS INTEGER : letzteWertung = 0
DIM letzteGruppe AS INTEGER : letzteGruppe = -1
DIM letzteLiga AS INTEGER : letzteLiga = GUI_DROPDOWN_SELECTED(ligaWahl)

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    GUI_UPDATE()
    abrufPruefen()

    IF GUI_CLICKED(bHolen) THEN spielplanHolen()

    ' Spielerwechsel -> Liste neu laden
    IF GUI_DROPDOWN_SELECTED(spielerWahl) <> letzterSpieler THEN
        letzterSpieler = GUI_DROPDOWN_SELECTED(spielerWahl)
        letzteZeile = -1
        spieleLaden()
        melde("Spieler gewechselt.")
    END IF

    ' Ligawechsel -> anderer Spielplan. Der Spieltag springt mit: die 2. Liga
    ' war am 7. August schon am 1. Spieltag, die 1. beginnt erst am 28.
    IF GUI_DROPDOWN_SELECTED(ligaWahl) <> letzteLiga THEN
        letzteLiga = GUI_DROPDOWN_SELECTED(ligaWahl)
        letzteZeile = -1
        GUI_SET_VALUE(tagWahl, spieltagVorschlag())
        letzterTag = aktiverSpieltag()
        spieleLaden()
        melde(ligaName[letzteLiga] + ", " + STR$(letzterTag) + ". Spieltag.")
    END IF

    ' Spieltagswechsel -> andere Spiele. Die Zeilennummer merken sich zu
    ' lassen waere falsch: Zeile 3 ist danach ein anderes Spiel.
    IF aktiverSpieltag() <> letzterTag THEN
        letzterTag = aktiverSpieltag()
        letzteZeile = -1
        spieleLaden()
        melde(STR$(letzterTag) + ". Spieltag.")
    END IF

    ' --- Reiter Rangliste: andere Wertung ---
    IF GUI_DROPDOWN_SELECTED(wertungWahl) <> letzteWertung THEN
        letzteWertung = GUI_DROPDOWN_SELECTED(wertungWahl)
        ranglisteLaden()
    END IF

    ' --- Reiter Gruppen ---
    ' Andere Gemeinschaft angeklickt -> ihre Mitglieder zeigen
    IF GUI_TABLE_SELECTED(gruppenTab) <> letzteGruppe THEN
        letzteGruppe = GUI_TABLE_SELECTED(gruppenTab)
        mitgliederLaden()
    END IF

    IF GUI_CLICKED(bNeu) THEN
        DIM name AS STRING : name = TRIM$(GUI_TEXT(neuName))
        IF name = "" THEN
            meldeGruppe("Erst einen Namen eintippen.")
        ELSE
            ' Denselben Namen zweimal laesst die Datenbank nicht zu (UNIQUE).
            ' Statt vorher zu suchen und dann zu entscheiden: hinschreiben
            ' und den Einwand abfangen -- dazwischen kann nichts passieren.
            TRY
                DB_EXEC(db, "INSERT INTO gruppen (name) VALUES (?)", name)
                GUI_SET_TEXT(neuName, "")
                gruppenLaden()
                meldeGruppe("'" + name + "' angelegt.")
            CATCH e
                meldeGruppe("'" + name + "' gibt es schon.")
            END TRY
        END IF
    END IF

    IF GUI_CLICKED(bWeg) THEN
        DIM weg AS INTEGER : weg = gewaehlteGruppe()
        IF weg = 0 THEN
            meldeGruppe("Erst eine Gemeinschaft anklicken.")
        ELSE
            DIM wegName AS STRING
            wegName = GUI_TABLE_GET_CELL(gruppenTab, GUI_TABLE_SELECTED(gruppenTab), 0)
            IF GUI_CONFIRM("Gemeinschaft löschen?", _
                    "'" + wegName + "' und ihre Mitgliederliste werden gelöscht." + CHR$(10) + _
                    "Die Tipps der Spieler bleiben.", "janein") THEN
                DB_BEGIN(db)
                DB_EXEC(db, "DELETE FROM gruppen_mitglieder WHERE gruppe_id = ?", weg)
                DB_EXEC(db, "DELETE FROM gruppen WHERE id = ?", weg)
                DB_COMMIT(db)
                GUI_TABLE_SET_SELECTED(gruppenTab, -1)
                letzteGruppe = -1
                gruppenLaden()
                mitgliederLaden()
                ranglisteLaden()
                meldeGruppe("'" + wegName + "' gelöscht.")
            END IF
        END IF
    END IF

    IF GUI_CLICKED(bMit) THEN
        DIM gid AS INTEGER : gid = gewaehlteGruppe()
        DIM mz AS INTEGER : mz = GUI_TABLE_SELECTED(mitgliedTab)
        IF gid = 0 THEN
            meldeGruppe("Erst eine Gemeinschaft anklicken.")
        ELIF mz < 0 OR mz >= mitgliedAnzahl THEN
            meldeGruppe("Erst einen Spieler anklicken.")
        ELSE
            DIM pid AS INTEGER : pid = mitgliedId[mz]
            DIM pName AS STRING : pName = GUI_TABLE_GET_CELL(mitgliedTab, mz, 0)
            IF GUI_TABLE_GET_CELL(mitgliedTab, mz, 1) = "ja" THEN
                DB_EXEC(db, "DELETE FROM gruppen_mitglieder " + _
                            "WHERE gruppe_id = ? AND spieler_id = ?", gid, pid)
                meldeGruppe(pName + " ist raus.")
            ELSE
                DB_EXEC(db, "INSERT INTO gruppen_mitglieder (gruppe_id, spieler_id) " + _
                            "VALUES (?, ?)", gid, pid)
                meldeGruppe(pName + " ist dabei.")
            END IF
            ' Die Mitgliederzahl steht in der Gruppentabelle, die Wertung
            ' haengt daran -- beides muss mit.
            gruppenLaden()
            mitgliederLaden()
            GUI_TABLE_SET_SELECTED(mitgliedTab, mz)
            ranglisteLaden()
        END IF
    END IF

    ' Zeilenauswahl -> Tipp der Zeile in die Felder holen
    DIM zeile AS INTEGER : zeile = GUI_TABLE_SELECTED(tabelle)
    IF zeile >= 0 AND zeile <> letzteZeile THEN
        letzteZeile = zeile
        DIM tippText AS STRING : tippText = GUI_TABLE_GET_CELL(tabelle, zeile, 3)
        IF tippText <> "-:-" THEN
            DIM teile AS ARRAY OF STRING
            teile = SPLIT$(tippText, ":")
            GUI_SET_VALUE(tippHeim, VAL(teile[0]))
            GUI_SET_VALUE(tippGast, VAL(teile[1]))
        END IF
        melde(GUI_TABLE_GET_CELL(tabelle, zeile, 1) + " gegen " + _
              GUI_TABLE_GET_CELL(tabelle, zeile, 2) + " -- " + restText(zeile))
    END IF

    ' Der Countdown laeuft weiter, auch wenn niemand etwas anklickt.
    ' Einmal je Sekunde reicht -- die Anzeige zeigt keine Zehntel.
    IF zeile >= 0 AND NOT abrufLaeuft() AND ZEIT_JETZT() <> letzteSekunde THEN
        letzteSekunde = ZEIT_JETZT()
        melde(GUI_TABLE_GET_CELL(tabelle, zeile, 1) + " gegen " + _
              GUI_TABLE_GET_CELL(tabelle, zeile, 2) + " -- " + restText(zeile))
    END IF

    ' --- Tipp speichern ---
    IF GUI_CLICKED(bTipp) THEN
        IF zeile < 0 THEN
            melde("Erst eine Zeile anklicken.")
        ELIF NOT offen(zeile) THEN
            ' Die Sperre steht hier, nicht im Knopf: eine Regel, eine Stelle.
            melde("Zu spaet -- Tippschluss war " + _
                  ZEIT_FORMAT$(tippschluss(zeile), "WT hh:mm") + ".")
        ELSE
            DIM th AS INTEGER : th = INT(GUI_VALUE(tippHeim))
            DIM tg AS INTEGER : tg = INT(GUI_VALUE(tippGast))
            ' Ein Tipp je Spieler und Spiel -- UNIQUE + UPSERT statt
            ' erst suchen, dann entscheiden.
            DB_EXEC(db, "INSERT INTO tipps (spieler_id, spiel_id, tipp_heim, tipp_gast) " + _
                        "VALUES (?, ?, ?, ?) " + _
                        "ON CONFLICT(spieler_id, spiel_id) DO UPDATE SET " + _
                        "  tipp_heim = excluded.tipp_heim, " + _
                        "  tipp_gast = excluded.tipp_gast, punkte = NULL", _
                    aktiverSpieler(), spielId[zeile], th, tg)

            ' Steht das Ergebnis schon, wird gleich neu gewertet.
            DIM r AS DB_RESULT
            r = DB_QUERY(db, "SELECT tore_heim, tore_gast FROM spiele WHERE id = ?", spielId[zeile])
            IF DB_NEXT(r) THEN
                IF NOT DB_IS_NULL(r, 0) THEN
                    punkteNeu(spielId[zeile], DB_GET_INT(r, 0), DB_GET_INT(r, 1))
                END IF
            END IF
            DB_CLOSE_RESULT(r)

            spieleLaden()
            ranglisteLaden()
            melde("Tipp gespeichert: " + STR$(th) + ":" + STR$(tg))
        END IF
    END IF

    ' --- Ergebnis eintragen ---
    IF GUI_CLICKED(bErg) THEN
        IF zeile < 0 THEN
            melde("Erst eine Zeile anklicken.")
        ELSE
            DIM eh AS INTEGER : eh = INT(GUI_VALUE(ergHeim))
            DIM eg AS INTEGER : eg = INT(GUI_VALUE(ergGast))
            ' Steht schon ein Ergebnis, werden alle Punkte dieses Spiels neu
            ' gerechnet. Vorher fragen -- die Rueckfrage steht als Bedingung
            ' da, damit sie nur bei einer echten Aenderung erscheint.
            DIM altes AS STRING : altes = GUI_TABLE_GET_CELL(tabelle, zeile, 4)
            DIM weiter AS BOOLEAN : weiter = TRUE
            IF altes <> "-:-" AND altes <> STR$(eh) + ":" + STR$(eg) THEN
                weiter = GUI_CONFIRM("Ergebnis aendern?", _
                    "Fuer dieses Spiel steht schon " + altes + "." + CHR$(10) + _
                    "Auf " + STR$(eh) + ":" + STR$(eg) + " aendern und alle Punkte neu rechnen?", _
                    "janein")
            END IF
            IF NOT weiter THEN
                melde("Ergebnis unveraendert gelassen.")
            ELSE
                DB_EXEC(db, "UPDATE spiele SET tore_heim = ?, tore_gast = ? WHERE id = ?", _
                        eh, eg, spielId[zeile])
                punkteNeu(spielId[zeile], eh, eg)
                spieleLaden()
                ranglisteLaden()
                melde("Ergebnis " + STR$(eh) + ":" + STR$(eg) + " eingetragen, Punkte neu gerechnet.")
            END IF
        END IF
    END IF

    GRADIENTV(0, 0, SW - 1, SH - 1, &H0A0F16, &H161E29)
    GUI_DRAW()
    FLIP()
WEND

DB_CLOSE(db)
