=== property set and field distinct (1)
' Property-Name und Backing-Field-Name muessen verschieden sein --
CLASS Counter
    DIM _x AS INTEGER

    PROPERTY GET x() AS INTEGER
        RETURN Self._x
    END PROPERTY

    PROPERTY SET x(v AS INTEGER)
        Self._x = v * 10
    END PROPERTY
END CLASS

DIM c AS Counter
c = NEW Counter()
c.x = 5
PRINT c.x
PRINT c._x
--- erwartet
50
50

