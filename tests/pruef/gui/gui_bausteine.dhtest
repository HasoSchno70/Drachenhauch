=== reglermarken: einrasten per klick und von marke zu marke
IMPORT "gui"
SCREEN(400, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM sl AS GUI_WIDGET : sl = GUI_SLIDER(w, 20, 20, 200, 0, 100, 0)
GUI_SLIDER_SET(sl, "marken", 5)
GUI_SLIDER_SET(sl, "einrasten", 1)
GUI_SLIDER_SET(sl, "wert_zeigen", 1)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 12 THEN PRINT "klick bei 30 % -> " + STR$(GUI_VALUE(sl))
    IF n = 25 THEN PRINT "pfeil -> " + STR$(GUI_VALUE(sl))
    IF n = 26 THEN
        GUI_SLIDER_CLEAR_MARKS(sl)
        GUI_SLIDER_MARK(sl, 10, "wenig")
        GUI_SLIDER_MARK(sl, 90, "viel")
        GUI_SET_VALUE(sl, 10)
    END IF
    IF n = 40 THEN PRINT "benannte marken -> " + STR$(GUI_VALUE(sl))
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
