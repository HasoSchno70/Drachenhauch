=== das info-fenster zeigt symbol und schriftzug, enter schliesst
befehl("ueber")
protokoll("probe offen " + STR$(GUI_WINDOW_SHOWN(winUeber)))
protokoll("probe text " + LEFT$(GUI_TEXT(lblUeber), 16))
AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach protokoll("bereit")
--- datei _programm/ev.txt
c 2
e 10 2 257 0 0 0
e 11 1 257 0 0 0

--- umgebung
DHRT_FRAMES=40
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 13) = "ueber bilder " OR L[i] = "ueber zu" OR LEFT$(L[i], 6) = "probe " THEN PRINT L[i]
NEXT
--- erwartet
ueber bilder 2
probe offen TRUE
probe text Drachenhauch-IDE
ueber zu

=== ohne bilder bleibt das info-fenster beim text
befehl("ueber")
protokoll("probe offen " + STR$(GUI_WINDOW_SHOWN(winUeber)))
EXIT(0)
