=== aendern schreibt die datei, vorgabe und zuruecksetzen raeumen auf
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 20 THEN
    tastenSetzen("neu", "Strg+Alt+N")
    tastenSetzen("zeile", "")
    protokoll("pr datei " + JOIN$(READLINES(tastenPfad$()), ""))
    tastenSetzen("neu", "strg+n")
    protokoll("pr datei " + JOIN$(READLINES(tastenPfad$()), ""))
    protokoll("pr zeile " + befehle[befehlNr("zeile")].kuerzel + ".")
    tastenZuruecksetzen()
    protokoll("pr zeile " + befehle[befehlNr("zeile")].kuerzel + " " + STR$(FILEEXISTS(tastenPfad$())))
    EXIT(0)
END IF
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr datei {"neu":"Strg+Alt+N","zeile":""}
pr datei {"zeile":""}
pr zeile .
pr zeile Strg+G FALSE
