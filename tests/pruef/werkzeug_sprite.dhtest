    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
SUB prFall()
    DIM t AS INTEGER
    prKnopf(2, GUI_GET_X(bGroesse), GUI_GET_Y(bGroesse), 128)
    prKnopf(8, GUI_WINDOW_GET_X(winGr) + GUI_GET_X(bGrOk), GUI_WINDOW_GET_Y(winGr) + GUI_GET_Y(bGrOk), 128)
    prKnopf(16, GUI_GET_X(bDrehR), GUI_GET_Y(bDrehR), 62)
    prAbspielen()
END SUB
SUB prProbe(k AS INTEGER)
    IF k = 14 THEN prMerke("vorher " + STR$(gw) + "x" + STR$(gh))
    IF k >= 28 THEN
        prZaehlen()
        prSchreib("nachher " + STR$(gw) + "x" + STR$(gh))
    END IF
END SUB
