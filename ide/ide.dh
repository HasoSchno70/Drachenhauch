' ============================================================
'  DRACHENHAUCH -- die IDE in Drachenhauch (Weg C, Stand 23)
' ============================================================
'  Eine Entwicklungsumgebung, geschrieben in der Sprache, die sie
'  bedient. Sie soll die Qt-IDE abloesen; bis sie gleichzieht, bleibt
'  die Qt-IDE im Installer (docs/entwurf-python-abbau.md, Weg C).
'
'  Stand 1 kann: Dateien in Reitern oeffnen, bearbeiten, sichern;
'  Projektbaum; Syntax-Einfaerbung des sichtbaren Ausschnitts; Fehler-
'  liste aus der Front-End-Kette (CODE_CHECK$), Klick springt zur Zeile;
'  Hilfe zum Wort unter der Marke (CODE_HOVER$); Vervollstaendigung
'  (Strg+Leertaste, CODE_COMPLETE); Suchen, Ersetzen, Gehe zu Zeile;
'  Programm starten und stoppen mit laufender Ausgabe (PROCESS_*),
'  Eingaben an INPUT durchreichen.
'  Stand 2 dazu: Debugger (Haltepunkte F9, Schritte F8/F10/F11, Variablen
'  im Fenster -- Client von `dhrt debug`), Profil (`dhrt profile`, Tabelle
'  nach Zeit), Suche im Projekt, Befehlspalette, Marken in der Nummern-
'  spalte (GUI_TEXTAREA_MARKS), echte Schriften, Start maximiert.
'  Stand 3 dazu: Handbuch im Fenster (F1 = das Wort unter der Marke in
'  docs/ nachschlagen), Listing drucken oder als PDF (pdf-Modul), die
'  Begleit-Editoren in Drachenhauch aus dem Menue Werkzeuge, Ausdruecke im
'  angehaltenen Debugger auswerten (Strg+E in die Eingabezeile).
'  Stand 4 dazu: Willkommensseite mit den zuletzt geoeffneten Dateien,
'  Sitzung und Einstellungen in einer JSON-Datei im Nutzerprofil, Datei im
'  Projekt oeffnen (Strg+Umschalt+O, unscharf gefiltert), die Handgriffe
'  im Text (Kommentar umschalten, Zeilen duplizieren/loeschen/verschieben,
'  ein- und ausruecken, Formatieren ueber CODE_FORMAT$), Lesezeichen,
'  Gliederung links unten, bedingte Haltepunkte (Umschalt+F9), Export als
'  eigenstaendiges Programm (dhrt --export), Druckdialog mit Druckerwahl,
'  TODO/FIXME-Liste, Tastenkuerzel-Uebersicht, Schriftgroesse.
'  Stand 5 dazu: Bloecke falten (F4, die Bloecke aus CODE_SYMBOLS$),
'  Zeilenumbruch, Sitzung je Projektordner, Umbenennen (Umschalt+F6 ueber
'  CODE_RENAME$), Schnipsel (Strg+J), Signaturhilfe in der Statuszeile,
'  geteilte Ansicht (Alt+G, zwei Reiter nebeneinander), Uebersichtskarte,
'  git blame (Strg+Umschalt+B), das Handbuch GESETZT statt roh, mehrere
'  Schreibmarken (Alt+Klick, Strg+Umschalt+L) und Symbole in den Menues.
'  Stand 6 dazu: Einrueckung beim Zeilenumbruch, Fundstellen und
'  Klammernpaar farbig, Vorschlagsliste beim Tippen, git diff/log samt
'  geaenderten Zeilen am Rand, Suche mit regulaerem Ausdruck, Lesezeichen
'  ueber Dateien hinweg, Reiter wieder oeffnen, Faltung nach Einrueckung.
'  Stand 7 dazu: Farbfelder neben &H-Literalen samt Farbwaehler,
'  Einstellungen an einer Stelle (Strg+U), Verzeichnis der eingebauten
'  Befehle (Strg+F3), Definition hier zeigen (Alt+F12), Symbolspur ueber
'  dem Code, automatisch sichern, Schnipsel-Filter vorbelegt.
'  Stand 8 dazu: Schnipsel per Kuerzel und Tabulator, Symbolverzeichnis
'  ueber alle Dateien des Projekts (Strg+Umschalt+S), Definition und
'  Vorschau ueber Dateigrenzen, Mehrfachauswahl im Projektbaum.
'  Stand 9 dazu: Einrueckungslinien, Ausgabe durchsuchen (Strg+Umschalt+A),
'  Marke auf die naechste Fundstelle (Strg+Umschalt+N), im ganzen Projekt
'  ersetzen (Strg+Umschalt+H), andere Reiter schliessen, und ein
'  Ueber-Kasten, der die Fassung der Laufzeit nennt.
'  Stand 10 dazu: Spaltenauswahl (Alt+Zug), Marke an jedes Zeilenende
'  (Strg+Umschalt+I), Zeilen sortieren/entdoppeln/beschneiden, im ganzen
'  Projekt umbenennen (Strg+Umschalt+F6), zwei Dateien vergleichen.
'  Stand 11 dazu: Werkzeugleiste mit Sinnbildern unter dem Menue und
'  Kacheln auf der Willkommensseite -- acht wichtige Beispiele mit einem
'  BILD davon, erzeugt mit `dhrt bild`, eines nach dem anderen.
'  Stand 12 dazu: Auswahl erweitern/verkleinern (Strg+Umschalt+Hoch/Runter),
'  Auswahl in ein Unterprogramm herausloesen (Strg+Umschalt+R) und zwei
'  Reiter nebeneinander vergleichen.
'  Stand 13 dazu: Vorschau vor dem Umbau (Umbenennen, Herausloesen,
'  Ersetzen und Parameter zeigen erst den Unterschied und fragen),
'  Parameter umsortieren samt Aufrufen (Strg+Umschalt+U) und das Geruest,
'  das beim Tippen mitwaechst (`IF ... THEN` + Enter setzt das END IF).
'  Stand 14 dazu: Parameter umsortieren geht durch das GANZE Projekt,
'  "Wer ruft das auf?" (Umschalt+F12) listet die Aufrufstellen, und die
'  Vervollstaendigung setzt die Argumente einer Signatur als Platzhalter
'  (der Tabulator geht zum naechsten).
'  Stand 15 dazu: ein Einwand, wenn der neue Name im Projekt schon
'  vergeben ist; Parameter hinzufuegen und entfernen (der Wert hinter dem
'  Gleichheitszeichen kommt an jede Aufrufstelle); und die Aufrufer als
'  BAUM -- unter jedem Aufruf stehen die Aufrufer seines Unterprogramms.
'  Stand 16 dazu: ein Unterprogramm in eine andere Datei verschieben
'  (Strg+Umschalt+V, samt dem IMPORT fuer jeden Aufrufer), die Umbauten
'  auch fuer Methoden, und den letzten Umbau in EINEM Zug zuruecknehmen
'  (Strg+Umschalt+Z).
'  Stand 17 dazu: auch ganze KLASSEN verschieben, das Verschieben legt die
'  Zieldatei an, ein Einwand wenn eine Umbenennung eine Ueberschreibung
'  zerreisst, und die Pfeiltasten waehlen im Datei-/Befehlswaehler.
'  Stand 18 dazu: eine mattere Oberflaeche (der Verlauf klingt auf grossen
'  Flaechen aus), das Verschobene nimmt mit was es selbst braucht, der
'  Umbau laesst sich mehrfach zuruecknehmen, und die Aufrufer-Liste kennt
'  auch die Weitergabe als FUNCREF.
'  Stand 19 dazu: in der Vorschau einzelne Dateien abwaehlen, ein Einwand
'  wenn der Name im Ziel schon steht, und auch CONST-/DIM-Zeilen lassen
'  sich verschieben.
'  Stand 20 dazu: in der Vorschau einzelne BLOECKE auslassen (dahinter
'  liegt jetzt eine Folge von Schritten statt einer Textausgabe), das
'  Umbenennen zieht die Handler in .dhform-Dateien mit, und der
'  Aufrufer-Baum zeigt die im Profil gemessenen Durchlaeufe.
'  Stand 21 dazu: den letzten Umbau nachbessern (Strg+Umschalt+G), alle
'  Umbauten sehen auch Unterordner, und eine gebrauchte Konstante zaehlt
'  fuer den IMPORT beim Verschieben.
'  Stand 22 dazu: der Projektbaum zeigt die Unterordner als Aeste, der
'  Umbau laesst sich in der Vorschau pruefen, bevor er geschrieben ist,
'  und eine neu angelegte Datei bekommt einen Reiter.
'  Stand 23 dazu: der Baum zeigt auch Formulare, Daten und Bilder (was der
'  Editor nicht kann, geht ans System), ein Umbau ueber das ganze Projekt
'  sammelt in Schritten und laesst sich mit ESC abbrechen, und das Pruefen
'  nennt die Fehler statt nur ihrer Zahl.
'
'  Ordner: docs/ und examples/ liegen neben ide/ (Repo wie Installation);
'  DH_IDE_WURZEL uebersteuert das (Tests, verschobene Kopien).
'
'  Aufruf:  dhrt run ide/ide.dh [-- datei.dh]
'  Test:    DH_IDE_LOG=<datei> schreibt die Ereignisse zeilenweise mit --
'           so pruefen die Tests, was die IDE getan hat, ohne ins Bild zu sehen.
' ============================================================
IMPORT "gui"
IMPORT "json"
IMPORT "pdf"
IMPORT "imgfx"      ' fuer die gezeichneten Menue-Symbole (IMAGE_NEW/IMAGE_DRAW_*)
IMPORT "regex"      ' fuer die Suche mit regulaeren Ausdruecken
IMPORT "zeit"       ' ZEIT_JETZT fuer das Lebenszeichen der Absturz-Wiederherstellung
IMPORT "video"      ' der Vorspann beim Start (daten/video/vorspann.mp4)

CONST MAX_TABS = 12
CONST NL = CHR$(10)

' --- Farben der Einfaerbung ------------------------------------------
' Die Farben haengen am THEMA: das dunkle Glas-Thema will helle, kraeftige
' Toene, auf dem hellen waeren genau die unleserlich (hellgelbe Zeichenketten
' auf Weiss). `codeFarben` setzt sie nach dem Laden der Einstellungen und
' nach jedem Themawechsel.
DIM F_GRUND AS INTEGER : F_GRUND = &HD8E4F0
DIM F_KOMMENTAR AS INTEGER : F_KOMMENTAR = &H6A8A5A
DIM F_TEXT AS INTEGER : F_TEXT = &HE0A060
DIM F_ZAHL AS INTEGER : F_ZAHL = &HD07070
DIM F_SCHLUESSEL AS INTEGER : F_SCHLUESSEL = &H2BC4E8
DIM F_OPERATOR AS INTEGER : F_OPERATOR = &H9AA8B8
DIM F_FUNDSTELLE AS INTEGER : F_FUNDSTELLE = &HFFD070      ' das Wort unter der Marke, ueberall
DIM F_KLAMMER AS INTEGER : F_KLAMMER = &H70FFA0            ' das zusammengehoerende Klammernpaar
DIM F_SUCHTREFFER AS INTEGER : F_SUCHTREFFER = &HFF8AD0    ' die Treffer der offenen Suchleiste

' Typ-Hinweise hinter der Zeile (CODE_TYPES$), gedaempft blau.
DIM F_TYP AS INTEGER : F_TYP = &H7FA6C8
SUB codeFarben(licht AS BOOLEAN)
    IF licht THEN
        F_GRUND = &H1E2530 : F_KOMMENTAR = &H3D7A2E : F_TEXT = &HA5570A
        F_ZAHL = &HB22E2E : F_SCHLUESSEL = &H0B63A8 : F_OPERATOR = &H4B5563
        F_FUNDSTELLE = &H9A6300 : F_KLAMMER = &H1B7F3F : F_SUCHTREFFER = &HA5217A
    ELSE
        F_GRUND = &HD8E4F0 : F_KOMMENTAR = &H6A8A5A : F_TEXT = &HE0A060
        F_ZAHL = &HD07070 : F_SCHLUESSEL = &H2BC4E8 : F_OPERATOR = &H9AA8B8
        F_FUNDSTELLE = &HFFD070 : F_KLAMMER = &H70FFA0 : F_SUCHTREFFER = &HFF8AD0
    END IF
    F_TYP = IIF(licht, &H5A7A9A, &H7FA6C8)
    TON_PROJEKT = &H3B7BD8 : TON_AUSGABE = &H2E9E62 : TON_PROBLEME = &HD98B2B : TON_DEBUG = &H8C5BD6
END SUB

SCREEN(1280, 800, "Drachenhauch", 1)
WINDOW_RESIZABLE(TRUE)
WINDOW_MIN_SIZE(800, 500)
SETFPS(60)
WINDOW_MAXIMIZE()
GUI_THEME_PRESET("glas_dunkel")

' Der Feinschliff am Thema -- nach JEDEM Preset, denn ein Preset setzt die
' Metriken mit.
'
' Das Glas-Thema ist fuer Knoepfe und Regler gemacht: kraeftiger Verlauf,
' deutlicher Glanz. Eine Entwicklungsumgebung besteht aber aus grossen
' Flaechen -- Code-Feld, Ausgabe, Problemliste, Projektbaum --, und auf
' denen wirkt derselbe Verlauf wie ein Schlagschatten quer ueber die halbe
' Hoehe. Darum matter (Verlauf und Glanz herunter) und `verlauf_hoehe`:
' ueber 120 Pixeln klingt beides aus, ein Knopf woelbt sich weiter.
' Jeder Bereich traegt einen Hauch seiner eigenen Farbe -- Projekt und
' Gliederung blau, Ausgabe gruen, Probleme orange, Debugger violett --, sonst
' ist alles dasselbe Weiss bzw. Grau und das Auge findet nichts. Gemischt
' aus der Widget-Grundfarbe des Themas, damit es in beiden Themen passt;
' der Verlauf des Themas liegt darueber wie auf jeder anderen Flaeche.
FUNCTION farbMisch(a AS INTEGER, b AS INTEGER, t AS FLOAT) AS INTEGER
    DIM r AS INTEGER : r = INT(((a SHR 16) BAND 255) * (1.0 - t) + ((b SHR 16) BAND 255) * t + 0.5)
    DIM gg AS INTEGER : gg = INT(((a SHR 8) BAND 255) * (1.0 - t) + ((b SHR 8) BAND 255) * t + 0.5)
    DIM bb AS INTEGER : bb = INT((a BAND 255) * (1.0 - t) + (b BAND 255) * t + 0.5)
    RETURN (r SHL 16) BOR (gg SHL 8) BOR bb
END FUNCTION

' Die Toene der Bereiche -- Variablen, weil eigene Farben (farben.json) sie
' ueberschreiben duerfen; codeFarben setzt sie auf die Vorgabe zurueck.
DIM TON_PROJEKT AS INTEGER : TON_PROJEKT = &H3B7BD8
DIM TON_AUSGABE AS INTEGER : TON_AUSGABE = &H2E9E62
DIM TON_PROBLEME AS INTEGER : TON_PROBLEME = &HD98B2B
DIM TON_DEBUG AS INTEGER : TON_DEBUG = &H8C5BD6

SUB bereichsFarben()
    DIM grund AS INTEGER : grund = GUI_THEME_GET("widget_bg")
    DIM anteil AS FLOAT : anteil = 0.2
    IF hell THEN anteil = 0.16
    GUI_SET_COLOR(baum, "bg", farbMisch(grund, TON_PROJEKT, anteil))
    GUI_SET_COLOR(lstGliederung, "bg", farbMisch(grund, TON_PROJEKT, anteil))
    GUI_SET_COLOR(lstWkZuletzt, "bg", farbMisch(grund, TON_PROJEKT, anteil))
    GUI_SET_COLOR(lstAusgabe, "bg", farbMisch(grund, TON_AUSGABE, anteil))
    GUI_SET_COLOR(lstTerminal, "bg", farbMisch(grund, TON_AUSGABE, anteil))
    GUI_SET_COLOR(tfEingabe, "bg", farbMisch(grund, TON_AUSGABE, anteil))
    GUI_SET_COLOR(lstProbleme, "bg", farbMisch(grund, TON_PROBLEME, anteil))
    GUI_SET_COLOR(tblVars, "bg", farbMisch(grund, TON_DEBUG, anteil))
    protokoll("bereichsfarben " + COLOR_HEX$(farbMisch(grund, TON_AUSGABE, anteil)))
END SUB

SUB themaFeinschliff()
    GUI_METRIC_SET("gradient", 9)
    GUI_METRIC_SET("gloss", 12)
    GUI_METRIC_SET("verlauf_hoehe", 120)
    GUI_METRIC_SET("shadow", 12)
END SUB
themaFeinschliff()

' Schrift: eine Textschrift fuer die Oberflaeche, eine dicktengleiche fuer den
' Code. Geladen in 32 px und in 16 gezeichnet -- so bleibt sie scharf. Ohne
' Fund bleibt raylibs Bitmapschrift.
DIM uiFont AS INTEGER : uiFont = -1
DIM codeFont AS INTEGER : codeFont = -1
DIM fp AS STRING
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "/System/Library/Fonts/Supplemental/Arial.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    IF uiFont < 0 AND FILEEXISTS(fp) THEN uiFont = LOADFONT(fp, 32)
NEXT
FOR EACH fp IN ("C:/Windows/Fonts/consola.ttf", "/System/Library/Fonts/Menlo.ttc", "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf")
    IF codeFont < 0 AND FILEEXISTS(fp) THEN codeFont = LOADFONT(fp, 32)
NEXT
IF uiFont >= 0 THEN SETFONT(uiFont) : TEXT_SIZE(16)

' --- Zustand -----------------------------------------------------------
DIM logDatei AS STRING : logDatei = GETENV$("DH_IDE_LOG")
' dhrt wechselt vor dem Lauf ins Verzeichnis der IDE -- der Nutzer steht
' woanders, und DORT liegt sein Projekt (DHRT_START_DIR, von dhrt gesetzt).
DIM startOrdner AS STRING : startOrdner = GETENV$("DHRT_START_DIR")
IF startOrdner = "" THEN startOrdner = CWD$()
DIM projektOrdner AS STRING : projektOrdner = startOrdner

DIM tabPfade[MAX_TABS] AS STRING
DIM tabFelder[MAX_TABS] AS GUI_WIDGET
DIM tabGesichert[MAX_TABS] AS STRING
DIM tabLetzterText[MAX_TABS] AS STRING
' Gefaltete Zeilen, die beim Oeffnen wieder zugeklappt werden sollen ("3,17")
' -- erst, wenn der Reiter seine faltbaren Bloecke kennt.
DIM tabFaltenOffen[MAX_TABS] AS STRING
' Gemerkte Faltungen je Datei (ide.json `falten_pfade`/`falten_zeilen`),
' die zuletzt benutzte zuerst.
DIM faltPfade AS ARRAY OF STRING : faltPfade = []
DIM faltListe AS ARRAY OF STRING : faltListe = []
DIM tabAnzahl AS INTEGER : tabAnzahl = 0
DIM aktiverTab AS INTEGER : aktiverTab = -1

DIM prozess AS INTEGER : prozess = -1
DIM prozessDatei AS STRING : prozessDatei = ""
' Der letzte Profillauf: welche Datei, und wie oft jede Zeile lief. Die
' Aufrufer-Liste haengt die Zahl an ihre Zeilen.
DIM profDatei AS STRING : profDatei = ""
DIM profZeilen AS ARRAY OF INTEGER : profZeilen = []
DIM profAnzahl AS ARRAY OF INTEGER : profAnzahl = []
DIM pruefungFaellig AS FLOAT : pruefungFaellig = -1.0
DIM letzteMarke AS STRING : letzteMarke = ""
DIM suchtext AS STRING : suchtext = ""
DIM ersatztext AS STRING : ersatztext = ""
DIM fertigNachStopp AS BOOLEAN : fertigNachStopp = FALSE
' Neu starten: das laufende Programm stoppen und, sobald es weg ist, dasselbe
' noch einmal -- mit derselben Art (Lauf, Debugger, Profil).
DIM neustartArt AS STRING : neustartArt = ""
DIM neustartDatei AS STRING : neustartDatei = ""
DIM neustartVomSichern AS BOOLEAN : neustartVomSichern = FALSE
' Waehrend des Debuggens geaendert: einmal sagen, dass die Zeilen nicht mehr passen.
DIM debugGeaendertGesagt AS BOOLEAN : debugGeaendertGesagt = FALSE
DIM prozessArt AS STRING : prozessArt = ""          ' run / debug / profile
DIM prozessRest AS STRING : prozessRest = ""        ' halbe Zeile aus stdout

' Debugger
DIM debugPause AS BOOLEAN : debugPause = FALSE
' Das Feld, in dem die Werte des letzten Halts hinter den Zeilen stehen.
DIM werteFeld AS GUI_WIDGET : werteFeld = -1
DIM debugErst AS BOOLEAN : debugErst = FALSE
DIM debugZeile AS INTEGER : debugZeile = 0
' Die Datei, in der er steht -- mit IMPORT nicht mehr immer die gestartete.
DIM debugDatei AS STRING : debugDatei = ""
' Nach dem ersten Halt: warten, bis das Kind sagt, wo die Haltepunkte
' WIRKLICH halten (eine Zeile ohne Code rutscht nach unten); erst dann
' entscheidet sich, ob es weiterlaeuft. Der Halt selbst wartet solange hier.
DIM debugErstWarten AS BOOLEAN : debugErstWarten = FALSE
DIM debugErstHalt AS STRING : debugErstHalt = ""
' Das Programm steht in einem INPUT und wartet auf die Eingabezeile.
DIM debugEingabe AS BOOLEAN : debugEingabe = FALSE
' Die Datei je Zeile des Aufrufstapels (Doppelklick springt dorthin).
DIM stapelDateien AS ARRAY OF STRING : stapelDateien = []
DIM stapelZeilen AS ARRAY OF INTEGER : stapelZeilen = []
DIM hpDateien AS ARRAY OF STRING : hpDateien = []
DIM hpZeilen AS ARRAY OF INTEGER : hpZeilen = []
DIM hpBedingungen AS ARRAY OF STRING : hpBedingungen = []   ' "" = unbedingt
' Abgeschaltete Haltepunkte bleiben stehen (grau), halten aber nicht --
' man will einen nicht jedes Mal neu setzen, nur weil er gerade stoert.
DIM hpAktiv AS ARRAY OF BOOLEAN : hpAktiv = []
' Trefferzahl ("5" = ab dem 5. Mal, "=5" genau, "%5" jedes 5. Mal) und
' Protokolltext (ein Protokollpunkt haelt nicht, er schreibt "i = {i}").
DIM hpTreffer AS ARRAY OF STRING : hpTreffer = []
DIM hpLog AS ARRAY OF STRING : hpLog = []
DIM markenSchluessel AS STRING : markenSchluessel = ""
' Welche gesetzte Marke wofuer steht: beim Bearbeiten wandern die Marken im
' Feld mit ihrer Zeile (GUI_TEXTAREA_MARKS_GET), und Haltepunkte und
' Lesezeichen ziehen hier nach.
DIM markenFeld AS GUI_WIDGET : markenFeld = -1
DIM markenPfad AS STRING : markenPfad = ""
DIM markenArt AS ARRAY OF STRING : markenArt = []
DIM markenIdx AS ARRAY OF INTEGER : markenIdx = []
DIM markenGesetzt AS ARRAY OF INTEGER : markenGesetzt = []

' Lesezeichen (Strg+F2 setzt, F2 springt zum naechsten)
DIM lzDateien AS ARRAY OF STRING : lzDateien = []
DIM lzZeilen AS ARRAY OF INTEGER : lzZeilen = []

' Export als eigenstaendiges Programm (dhrt --export), ein eigener Prozess
DIM exportProzess AS INTEGER : exportProzess = -1
DIM exportDatei AS STRING : exportDatei = ""

' Gliederung (SUB/FUNCTION/CLASS der aktiven Datei, links unten)
DIM gliederungZeilen AS ARRAY OF INTEGER : gliederungZeilen = []
DIM gliederungSchluessel AS STRING : gliederungSchluessel = ""

DIM hell AS BOOLEAN : hell = FALSE
' Die Vorgabe ist auch das Ziel von Strg+0 ("Schrift normal").
CONST SCHRIFT_NORMAL AS INTEGER = 16
DIM codeGroesse AS INTEGER : codeGroesse = SCHRIFT_NORMAL
' Gliederung, Ausgabe und Probleme lesen sich eine Stufe groesser als die
' Vorgabe der gui; das Handbuch hat seine eigene Groesse.
CONST LISTEN_NORMAL = 18
CONST HANDBUCH_NORMAL = 18
' Die Schrift der Oberflaeche (Menue, Reiter, Baum, Beschriftungen). 16 war
' auf einem grossen Schirm zu klein; 18 passt noch in die festen Zeilen der
' gui (Baum 22, Menue 26).
CONST UI_NORMAL = 18
DIM uiGroesse AS INTEGER : uiGroesse = UI_NORMAL
DIM listenGroesse AS INTEGER : listenGroesse = LISTEN_NORMAL
DIM handbuchGroesse AS INTEGER : handbuchGroesse = HANDBUCH_NORMAL
DIM umbruchAn AS BOOLEAN : umbruchAn = FALSE
' Geteilte Ansicht: links ein ZWEITER Reiter, rechts der aktive. Beide sind
' echte Code-Felder -- nichts wird gespiegelt, es gibt nichts abzugleichen.
DIM geteilt AS BOOLEAN : geteilt = FALSE
' Dieselbe Datei zweimal nebeneinander: links ein zweites Feld, das den Text
' des aktiven Reiters TEILT (GUI_TEXTAREA_SHARE) -- mit eigener Marke und
' eigenem Ausschnitt, aber einem Text und einem Verlauf.
DIM spiegelAn AS BOOLEAN : spiegelAn = FALSE
DIM taSpiegel AS GUI_WIDGET : taSpiegel = -1
DIM spiegelBesitzer AS GUI_WIDGET : spiegelBesitzer = -1
DIM spiegelFaerbSchl AS STRING : spiegelFaerbSchl = ""
DIM linkerTab AS INTEGER : linkerTab = -1
DIM minimapAn AS BOOLEAN : minimapAn = FALSE
' Geaenderte Zeilen am Rand (git diff -U0), per Vorgabe an.
DIM gitRandAn AS BOOLEAN : gitRandAn = TRUE
' Suche mit regulaerem Ausdruck (Suchen, Ersetzen und Projektsuche).
DIM regexAn AS BOOLEAN : regexAn = FALSE
' Die beiden anderen Schalter der Suche (seit 2026-09-19): sie gelten fuer
' JEDE Suche der IDE -- Suchleiste, Projektsuche, Ersetzen im Projekt --, weil
' alle ueber suchMuster$ gehen.
DIM grossKlein AS BOOLEAN : grossKlein = FALSE
DIM ganzesWort AS BOOLEAN : ganzesWort = FALSE
' Zuletzt geschlossene Reiter -- Strg+Umschalt+T holt sie zurueck.
DIM zuGemacht AS ARRAY OF STRING : zuGemacht = []
' Vorschlagsliste beim Tippen -- hier oben, weil die Einstellungen ganz am
' Anfang gelesen werden: eine Zuweisung an eine spaeter angelegte Variable
' bricht mit "Slot leer" ab, und zwar nur beim ZWEITEN Start (beim ersten
' steht der Schluessel noch nicht in der Datei).
DIM vorschlagAn AS BOOLEAN : vorschlagAn = TRUE
' Einrueckungslinien im Code-Feld (ein Strich je Stufe).
DIM linienAn AS BOOLEAN : linienAn = TRUE
' Mitlaufender Blockkopf: SUB/IF/FOR, deren Kopf oben hinausgerollt ist,
' bleiben oben angeheftet (hoechstens drei).
DIM kopfAn AS BOOLEAN : kopfAn = TRUE
' Profil im Code: nach einem Profillauf ein Farbband hinter jeder gemessenen
' Zeile (gelb bis rot nach Zeitanteil) und bei den teuersten die Zahlen am
' Zeilenende. Hier oben, weil die Einstellung sie beim Laden setzt.
DIM waermeAn AS BOOLEAN : waermeAn = TRUE
' Gibt es eine Messung, die im Code stehen soll? (Entfernen laesst die
' Tabelle stehen, nimmt aber die Farben weg.)
DIM waermeDaten AS BOOLEAN : waermeDaten = FALSE
DIM waermeFelder AS ARRAY OF INTEGER : waermeFelder = []
DIM waermeNr AS ARRAY OF INTEGER : waermeNr = []
DIM waermeTexte AS ARRAY OF STRING : waermeTexte = []
' Aufrufzaehler: hinter jeder SUB/FUNCTION steht, wie oft sie im Projekt
' vorkommt; ein Klick darauf zeigt die Aufrufer.
DIM zaehlerAn AS BOOLEAN : zaehlerAn = TRUE
' Fehlertext am Zeilenende: die Meldung von Pruefen steht gedaempft rot bzw.
' gelb hinter ihrer Zeile -- man liest sie, ohne die Maus hinzubewegen.
DIM fehlerEndeAn AS BOOLEAN : fehlerEndeAn = TRUE
' Typ-Hinweise: hinter einer Zeile mit FOR EACH steht, was die Variable
' haelt (CODE_TYPES$) -- ihr Typ steht sonst nirgends.
DIM typHinweiseAn AS BOOLEAN : typHinweiseAn = TRUE
DIM typFeld AS GUI_WIDGET : typFeld = -1
DIM typZeilen AS ARRAY OF INTEGER : typZeilen = []
DIM typTexte AS ARRAY OF STRING : typTexte = []
DIM fehlerFeld AS GUI_WIDGET : fehlerFeld = -1
DIM fehlerZeilen AS ARRAY OF INTEGER : fehlerZeilen = []
DIM fehlerTexte AS ARRAY OF STRING : fehlerTexte = []
DIM fehlerFarben AS ARRAY OF INTEGER : fehlerFarben = []
' Beim Sichern neu starten: laeuft ein Programm (F5), startet Strg+S es neu.
' Aus per Vorgabe -- ein Neustart wirft den Zustand des Programms weg.
DIM neustartSichernAn AS BOOLEAN : neustartSichernAn = FALSE
' Startargumente und Umgebung je Datei (ide.json `start`: Liste von
' {datei, argumente, umgebung}). Eine Liste statt Pfad-Schluesseln, weil ein
' Punkt im Schluessel fuer das json-Modul ein Pfad waere.
DIM startDateien AS ARRAY OF STRING : startDateien = []
DIM startArgs AS ARRAY OF STRING : startArgs = []
DIM startUmg AS ARRAY OF STRING : startUmg = []
' Das Geruest, das beim Tippen mitwaechst: `IF ... THEN` und Enter setzen
' das `END IF` gleich mit (GUI_TEXTAREA_CLOSE_WORDS).
DIM geruestAn AS BOOLEAN : geruestAn = TRUE
' Klammern und Anfuehrungszeichen schliesst das Code-Feld beim Tippen
' selbst (GUI_TEXTAREA_PAIRS). `'` fehlt mit Absicht: es beginnt einen
' Kommentar, und ein zweites dahinter waere Unsinn.
DIM klammernAn AS BOOLEAN : klammernAn = TRUE
' Beim Sichern formatieren (CODE_FORMAT$). Aus per Vorgabe: es aendert den
' Text, ohne dass man darum gebeten hat. Das automatische Sichern formatiert
' NIE -- mitten im Tippen rueckte sonst die Zeile unter der Marke weg.
DIM formatSichernAn AS BOOLEAN : formatSichernAn = FALSE
DIM sichernOhneFormat AS BOOLEAN : sichernOhneFormat = FALSE
' Vorschau vor dem Umbau: Umbenennen, Herausloesen und Parameter-Umsortieren
' zeigen erst den Unterschied und fragen, statt gleich zu schreiben.
DIM vorschauAn AS BOOLEAN : vorschauAn = TRUE
' Werkzeugleiste mit Sinnbildern unter der Menueleiste.
DIM leisteAn AS BOOLEAN : leisteAn = TRUE
' Seitenleiste (Projekt + Gliederung) und untere Leiste (Ausgabe, Probleme,
' Debugger) ein- und ausblenden -- mehr Platz fuer den Code. Die untere
' kommt von selbst zurueck, sobald ein Programm startet: seine Ausgabe
' nicht zu sehen, waere schlimmer als die verlorenen Zeilen.
DIM seitenAn AS BOOLEAN : seitenAn = TRUE
' Druckoptionen fuer das Listing (auch fuer die PDF daneben), gemerkt.
DIM druckGroesse AS INTEGER : druckGroesse = 9
DIM druckRand AS INTEGER : druckRand = 20
DIM druckNummern AS BOOLEAN : druckNummern = TRUE
DIM untenAn AS BOOLEAN : untenAn = TRUE
' Automatisch sichern: Sekunden ohne Anschlag, 0 = aus.
DIM autoSichern AS INTEGER : autoSichern = 0
DIM autoFaellig AS FLOAT : autoFaellig = -1.0
' Faltung: die Bloecke kommen aus CODE_SYMBOLS$ (dieselbe Quelle wie die
' Gliederung), die Laufzeit kennt keine Sprache. Der Schluessel merkt sich,
' was zuletzt gemeldet wurde -- ohne ihn ginge bei jedem Pruefen ein Feld
' durch die Bruecke, obwohl sich nichts geaendert hat.
DIM faltSchluessel AS STRING : faltSchluessel = "-"
' Dieselben Bloecke bleiben stehen: die Auswahl waechst an ihnen entlang,
' und das Herausloesen fragt, in welchem Unterprogramm die Marke steht.
DIM blockVon AS ARRAY OF INTEGER : blockVon = []
DIM blockBis AS ARRAY OF INTEGER : blockBis = []   ' "" waere eine echte Gliederung (Datei ohne SUB)

' Suche im Projekt: die Trefferliste teilt sich die Liste mit den Problemen.
DIM problemModus AS INTEGER : problemModus = 0      ' 0 Probleme, 1 Suche
DIM sucheDateien AS ARRAY OF STRING : sucheDateien = []
DIM sucheZeilen AS ARRAY OF INTEGER : sucheZeilen = []

' Profil
DIM profilZeilen AS ARRAY OF INTEGER : profilZeilen = []
' Die Datei je Tabellenzeile -- mit IMPORT misst der Profiler auch Zeilen
' anderer Dateien, und ein Klick muss dorthin.
DIM profilDateien AS ARRAY OF STRING : profilDateien = []
DIM profRohD AS ARRAY OF STRING : profRohD = []
DIM profBerDatei AS ARRAY OF STRING : profBerDatei = []
DIM profLeseDatei AS STRING : profLeseDatei = ""
DIM profLeseZeilen AS ARRAY OF STRING : profLeseZeilen = []
' Die Messung selbst, nach Zeit absteigend -- die Tabelle zeigt sie je
' Zeile oder je Funktion, ohne neu zu messen.
DIM profRohZ AS ARRAY OF INTEGER : profRohZ = []
DIM profRohA AS ARRAY OF INTEGER : profRohA = []
DIM profRohT AS ARRAY OF FLOAT : profRohT = []
DIM profGesamt AS FLOAT : profGesamt = 0.0
DIM profQuelle AS ARRAY OF STRING : profQuelle = []
DIM profBerName AS ARRAY OF STRING : profBerName = []
DIM profBerVon AS ARRAY OF INTEGER : profBerVon = []
DIM profBerBis AS ARRAY OF INTEGER : profBerBis = []

' Wo Handbuch und Beispiele liegen: neben ide/ (dhrt hat nach ide/ gewechselt).
DIM wurzel AS STRING : wurzel = GETENV$("DH_IDE_WURZEL")
IF wurzel = "" THEN wurzel = PATHJOIN(CWD$(), "..")
DIM docsOrdner AS STRING : docsOrdner = PATHJOIN(wurzel, "docs")
' DH_IDE_BEISPIELE nennt den Ordner ausdruecklich: unter macOS und Linux liegen
' ide/ und examples/ im Paket, das der Nutzer nicht beschreiben soll (in einem
' .app-Bundle braeche jede Aenderung die Signatur) -- der Starter kopiert die
' Beispiele beim ersten Start in den Nutzerordner und sagt der IDE, wo.
DIM beispielOrdner AS STRING : beispielOrdner = GETENV$("DH_IDE_BEISPIELE")
IF beispielOrdner = "" THEN beispielOrdner = PATHJOIN(wurzel, "examples")

' Logo und Schriftzug liegen unter daten/bilder/ neben ide/ -- im Repo wie in
' der Installation. Fehlen sie (eine Kopie der IDE woanders), bleibt es beim
' raylib-Symbol und beim Titel als Text.
DIM bilderOrdner AS STRING : bilderOrdner = PATHJOIN(wurzel, "daten/bilder")
IF FILEEXISTS(PATHJOIN(bilderOrdner, "logo.png")) THEN
    WINDOW_ICON(IMAGE_SCALE(LOADIMAGE(PATHJOIN(bilderOrdner, "logo.png")), 128, 128))
    protokoll("fenstersymbol")
END IF
IF GETENV$("DH_IDE_BEISPIELE") = "" AND NOT FILEEXISTS(PATHJOIN(beispielOrdner, "183_sfx_generator.dh")) AND GETENV$("PUBLIC") <> "" THEN
    ' Installation: der Installer legt die Beispiele in die oeffentlichen Dokumente.
    beispielOrdner = PATHJOIN(GETENV$("PUBLIC"), "Documents/Drachenhauch/examples")
END IF
DIM werkzeuge AS ARRAY OF INTEGER : werkzeuge = []     ' laufende Begleitprogramme
DIM docNamen AS ARRAY OF STRING : docNamen = []
DIM docLetzteWahl AS INTEGER : docLetzteWahl = -1

' Einstellungen und Sitzung: EINE JSON-Datei im Nutzerprofil. DH_IDE_KONFIG
' uebersteuert den Ort -- die Tests duerfen die echte nicht anfassen, sonst
' stellte jeder Testlauf dem Nutzer eine fremde Sitzung wieder her.
DIM konfigPfad AS STRING : konfigPfad = GETENV$("DH_IDE_KONFIG")
IF konfigPfad = "" THEN
    DIM konfigBasis AS STRING : konfigBasis = GETENV$("APPDATA")
    IF konfigBasis = "" THEN konfigBasis = PATHJOIN(GETENV$("HOME"), ".config")
    konfigPfad = PATHJOIN(konfigBasis, "Drachenhauch/ide.json")
END IF
DIM konfig AS JSON_HANDLE : konfig = JSON_PARSE("{}")
IF FILEEXISTS(konfigPfad) THEN
    TRY
        konfig = JSON_LOAD(konfigPfad)
    CATCH e
        konfig = JSON_PARSE("{}")     ' eine kaputte Datei ist kein Grund, nicht zu starten
    END TRY
END IF

' --- Sprache der Oberflaeche (seit 2026-09-29) ---------------------------
' Jeder Anzeigetext geht durch tr$("..."): auf Deutsch kommt er unveraendert
' zurueck, auf Englisch aus ide/sprache/en.txt (je Zeile Deutsch, Tabulator,
' Englisch). Keine JSON-Datei: das json-Modul liest einen Punkt im Schluessel
' als Pfad, und "Oeffnen ..." hat drei. Was die Tabelle nicht kennt, bleibt
' deutsch -- ein fehlender Eintrag ist ein Schoenheitsfehler, kein Absturz;
' tests/pruef/werkzeug_ide_englisch.dhtest prueft, dass keiner fehlt.
' Gewechselt wird beim naechsten Start: die Fenster sind dann schon gebaut.
DIM sprache AS STRING : sprache = "de"
IF JSON_HAS(konfig, "sprache") THEN sprache = JSON_GET_STRING(konfig, "sprache")
IF GETENV$("DH_IDE_SPRACHE") <> "" THEN sprache = GETENV$("DH_IDE_SPRACHE")
DIM englisch AS BOOLEAN : englisch = LOWER$(sprache) = "en"
DIM uebersetzung AS MAP OF STRING : uebersetzung = {}
DIM sprachFehlt AS INTEGER : sprachFehlt = 0
IF englisch THEN
    DIM spDatei AS STRING : spDatei = PATHJOIN(wurzel, "ide/sprache/en.txt")
    IF NOT FILEEXISTS(spDatei) THEN spDatei = "sprache/en.txt"
    IF FILEEXISTS(spDatei) THEN
        DIM spZeile AS STRING
        FOR EACH spZeile IN READLINES(spDatei)
            spZeile = REPLACE$(spZeile, CHR$(13), "")
            DIM spTab AS INTEGER : spTab = INSTR(spZeile, CHR$(9))
            ' Ein Eintrag hat einen Tabulator, ein Kommentar keinen -- am "#"
            ' allein zu gehen verlor "# Tastenkürzel der IDE".
            IF spTab > 0 THEN MAPPUT(uebersetzung, LEFT$(spZeile, spTab), MID$(spZeile, spTab + 1))
        NEXT
    ELSE
        englisch = FALSE
    END IF
END IF

FUNCTION tr$(t AS STRING) AS STRING
    IF NOT englisch THEN RETURN t
    IF MAPHAS(uebersetzung, t) THEN RETURN MAPGET(uebersetzung, t)
    sprachFehlt = sprachFehlt + 1
    RETURN t
END FUNCTION

' Kuerzel fuer die Anzeige: auf Englisch "Ctrl+Shift+Down" statt
' "Strg+Umschalt+Runter". Die Laufzeit versteht beide Schreibweisen.
FUNCTION kz$(k AS STRING) AS STRING
    IF NOT englisch OR k = "" THEN RETURN k
    DIM plusTaste AS BOOLEAN : plusTaste = RIGHT$(k, 2) = "++"
    DIM rumpf AS STRING : rumpf = IIF(plusTaste, LEFT$(k, LEN(k) - 2), k)
    DIM teile AS ARRAY OF STRING : teile = SPLIT$(rumpf, "+")
    DIM aus AS STRING : aus = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(teile) - 1
        DIM w AS STRING : w = teile[i]
        SELECT CASE LOWER$(w)
            CASE "strg" : w = "Ctrl"
            CASE "umschalt" : w = "Shift"
            CASE "entf" : w = "Del"
            CASE "einfg" : w = "Ins"
            CASE "pos1" : w = "Home"
            CASE "ende" : w = "End"
            CASE "bild auf" : w = "PageUp"
            CASE "bild ab" : w = "PageDown"
            CASE "leer" : w = "Space"
            CASE "rueck" : w = "Backspace"
            CASE "links" : w = "Left"
            CASE "rechts" : w = "Right"
            CASE "hoch" : w = "Up"
            CASE "runter" : w = "Down"
        END SELECT
        aus = aus + IIF(i > 0, "+", "") + w
    NEXT
    IF plusTaste THEN aus = aus + "++"
    RETURN aus
END FUNCTION

' Der Vorspann: daten/video/vorspann.mp4, vor allem anderen, auf die ganze
' Flaeche eingepasst (schwarze Raender, wo das Seitenverhaeltnis nicht
' passt). Jede Taste und jeder Klick ueberspringt ihn, das Kreuz beendet die
' IDE gleich. Abschalten in den Einstellungen (`vorspann` in der ide.json).
' Ein Testlauf (DHRT_FRAMES gesetzt) zeigt ihn nicht -- sonst verschoebe er
' jede Aufnahme um zehn Sekunden --, ausser er verlangt ihn mit
' DH_IDE_VORSPANN=1. Fehlt die Datei oder kann dieser Bau keine Videos,
' startet die IDE ohne.
DIM vorspannAn AS BOOLEAN : vorspannAn = TRUE
IF JSON_HAS(konfig, "vorspann") THEN vorspannAn = JSON_GET_BOOL(konfig, "vorspann")
' Der Lichtstreif (GUI_WINDOW_GLOW): beim Start und wenn ein Programm
' losgeht, streift ein warmes Licht schraeg von rechts nach links ueber das
' Fenster, und die Rahmen blitzen auf, wo es sie kreuzt -- ein neuer
' Drachenhauch. Abschalten in den Einstellungen (`glanz`).
DIM glanzAn AS BOOLEAN : glanzAn = TRUE
IF JSON_HAS(konfig, "glanz") THEN glanzAn = JSON_GET_BOOL(konfig, "glanz")
' Der Schriftzug schwach hinter dem Code -- er fuellt das Feld, rollt aber
' nicht mit: Grund, kein Inhalt.
DIM wasserzeichenAn AS BOOLEAN : wasserzeichenAn = TRUE
IF JSON_HAS(konfig, "wasserzeichen") THEN wasserzeichenAn = JSON_GET_BOOL(konfig, "wasserzeichen")
DIM hgBild AS INTEGER : hgBild = -1
IF FILEEXISTS(PATHJOIN(bilderOrdner, "schriftzug.png")) THEN hgBild = LOADIMAGE(PATHJOIN(bilderOrdner, "schriftzug.png"))
IF JSON_HAS(konfig, "ui_schrift") THEN uiGroesse = MAX(12, MIN(22, JSON_GET_INT(konfig, "ui_schrift")))
IF uiFont >= 0 THEN TEXT_SIZE(uiGroesse)
' Die Kaestchen im Projektbaum (Suche und Umbau auf eine Auswahl beschraenken)
' stehen nur auf Wunsch da -- immer sichtbar sahen sie aus wie etwas, das
' beim Anklicken etwas tun muesste (`baum_haken` in der ide.json).
DIM baumHakenAn AS BOOLEAN : baumHakenAn = FALSE
IF JSON_HAS(konfig, "baum_haken") THEN baumHakenAn = JSON_GET_BOOL(konfig, "baum_haken")
' Welcher Vorspann: jede .mp4 in daten/video steht in den Einstellungen zur
' Wahl (`vorspann_datei` in der ide.json), dazu "abwechselnd" -- dann kommt
' bei jedem Start der naechste (`vorspann_zuletzt`). Eine gewaehlte Datei,
' die es nicht mehr gibt, faellt auf die erste zurueck.
DIM vorspannOrdner AS STRING : vorspannOrdner = PATHJOIN(wurzel, "daten/video")
DIM vorspannDatei AS STRING : vorspannDatei = "vorspann.mp4"
IF JSON_HAS(konfig, "vorspann_datei") THEN vorspannDatei = JSON_GET_STRING(konfig, "vorspann_datei")
DIM vorspannZuletzt AS INTEGER : vorspannZuletzt = -1
IF JSON_HAS(konfig, "vorspann_zuletzt") THEN vorspannZuletzt = JSON_GET_INT(konfig, "vorspann_zuletzt")
DIM vorspannPfad AS STRING : vorspannPfad = ""
DIM vorspannSchluss AS BOOLEAN : vorspannSchluss = FALSE
IF (GETENV$("DHRT_FRAMES") = "" OR GETENV$("DH_IDE_VORSPANN") = "1") AND vorspannAn THEN
    DIM vsListe AS ARRAY OF STRING : vsListe = vorspannListe()
    IF LEN(vsListe) > 0 THEN
        IF LOWER$(vorspannDatei) = "abwechselnd" THEN
            vorspannZuletzt = (vorspannZuletzt + 1) MOD LEN(vsListe)
            IF vorspannZuletzt < 0 THEN vorspannZuletzt = 0
            vorspannPfad = PATHJOIN(vorspannOrdner, vsListe[vorspannZuletzt])
            ' Gleich merken: beendet die IDE nicht sauber, kaeme sonst
            ' beim naechsten Start derselbe.
            JSON_SET_INT(konfig, "vorspann_zuletzt", vorspannZuletzt)
            TRY
                MKDIR(DIRNAME(konfigPfad))
                WRITEALL(konfigPfad, JSON_STRINGIFY(konfig))
            CATCH e
            END TRY
        ELSEIF ARRAY_INDEXOF(vsListe, vorspannDatei) >= 0 THEN
            vorspannPfad = PATHJOIN(vorspannOrdner, vorspannDatei)
        ELSE
            vorspannPfad = PATHJOIN(vorspannOrdner, vsListe[0])
        END IF
    END IF
    IF vorspannPfad <> "" THEN
        protokoll("film " + BASENAME(vorspannPfad))
        IF vorspannSpielen(vorspannPfad) = "kreuz" THEN vorspannSchluss = TRUE
    END IF
END IF
IF vorspannSchluss THEN END

' Absturz-Wiederherstellung: jede laufende IDE schreibt alle `whTakt`
' Sekunden die Texte ihrer ungesicherten Reiter nach
' wiederherstellung/<kennung>/stand.json neben die ide.json. Ein EIGENER
' Ordner je IDE, nicht einer fuer alle wie in der Qt-Fassung: sonst hielte
' eine zweite, gleichzeitig gestartete IDE die Sicherungen der ersten fuer
' Absturzreste, und wer zuerst sauber beendet, loeschte die des anderen.
' Die Zeit im Stand ist zugleich das Lebenszeichen.
DIM whOrdner AS STRING : whOrdner = PATHJOIN(DIRNAME(konfigPfad), "wiederherstellung")
DIM whKennung AS STRING : whKennung = UUID4$()
DIM whTakt AS INTEGER : whTakt = 30
IF JSON_HAS(konfig, "wiederherstellung_s") THEN whTakt = MAX(1, MIN(600, JSON_GET_INT(konfig, "wiederherstellung_s")))
DIM whFaellig AS FLOAT : whFaellig = 0.0
DIM whFremd AS ARRAY OF STRING : whFremd = []     ' verwaiste Staende, die angeboten werden
DIM whGewarnt AS BOOLEAN : whGewarnt = FALSE
DIM dlgWieder AS GUI_WINDOW : dlgWieder = 0
' Sitzung JE PROJEKT. Im Speicher als drei gleich lange Felder, nicht als
' JSON-Teilbaum: das json-Modul kann einen Teilbaum nicht herausloesen, und
' ein Pfad als JSON-Schluessel kollidierte ohnehin mit der Punkt-Notation
' ("mein.spiel" waere zwei Ebenen).
CONST PROJEKTE_MAX = 12
DIM projOrdner AS ARRAY OF STRING : projOrdner = []
DIM projDateien AS ARRAY OF STRING : projDateien = []     ' Pfade, mit | getrennt
DIM projAktiv AS ARRAY OF INTEGER : projAktiv = []
IF JSON_HAS(konfig, "projekte") THEN
    DIM pj AS INTEGER
    FOR pj = 0 TO JSON_LEN(konfig, "projekte") - 1
        DIM pp AS STRING : pp = "projekte." + STR$(pj)
        DIM pfl AS ARRAY OF STRING : pfl = []
        DIM pd AS INTEGER
        FOR pd = 0 TO JSON_LEN(konfig, pp + ".sitzung") - 1
            ARRAY_PUSH(pfl, JSON_GET_STRING(konfig, pp + ".sitzung." + STR$(pd)))
        NEXT
        ARRAY_PUSH(projOrdner, JSON_GET_STRING(konfig, pp + ".ordner"))
        ARRAY_PUSH(projDateien, JOIN$(pfl, "|"))
        ARRAY_PUSH(projAktiv, JSON_GET_INT(konfig, pp + ".aktiv"))
    NEXT
END IF

DIM zuletzt AS ARRAY OF STRING : zuletzt = []
IF JSON_HAS(konfig, "zuletzt") THEN
    DIM kz AS INTEGER
    FOR kz = 0 TO JSON_LEN(konfig, "zuletzt") - 1
        ARRAY_PUSH(zuletzt, JSON_GET_STRING(konfig, "zuletzt." + STR$(kz)))
    NEXT
END IF
IF JSON_HAS(konfig, "hell") THEN hell = JSON_GET_BOOL(konfig, "hell")
IF JSON_HAS(konfig, "schrift") THEN codeGroesse = MAX(10, MIN(32, JSON_GET_INT(konfig, "schrift")))
IF JSON_HAS(konfig, "listen_schrift") THEN listenGroesse = MAX(10, MIN(32, JSON_GET_INT(konfig, "listen_schrift")))
IF JSON_HAS(konfig, "handbuch_schrift") THEN handbuchGroesse = MAX(10, MIN(32, JSON_GET_INT(konfig, "handbuch_schrift")))
IF JSON_HAS(konfig, "umbruch") THEN umbruchAn = JSON_GET_BOOL(konfig, "umbruch")
IF JSON_HAS(konfig, "karte") THEN minimapAn = JSON_GET_BOOL(konfig, "karte")
IF JSON_HAS(konfig, "git_rand") THEN gitRandAn = JSON_GET_BOOL(konfig, "git_rand")
IF JSON_HAS(konfig, "regex") THEN regexAn = JSON_GET_BOOL(konfig, "regex")
IF JSON_HAS(konfig, "gross_klein") THEN grossKlein = JSON_GET_BOOL(konfig, "gross_klein")
IF JSON_HAS(konfig, "ganzes_wort") THEN ganzesWort = JSON_GET_BOOL(konfig, "ganzes_wort")
IF JSON_HAS(konfig, "vorschlag") THEN vorschlagAn = JSON_GET_BOOL(konfig, "vorschlag")
IF JSON_HAS(konfig, "linien") THEN linienAn = JSON_GET_BOOL(konfig, "linien")
IF JSON_HAS(konfig, "blockkopf") THEN kopfAn = JSON_GET_BOOL(konfig, "blockkopf")
IF JSON_HAS(konfig, "profil_waerme") THEN waermeAn = JSON_GET_BOOL(konfig, "profil_waerme")
IF JSON_HAS(konfig, "aufrufzaehler") THEN zaehlerAn = JSON_GET_BOOL(konfig, "aufrufzaehler")
IF JSON_HAS(konfig, "fehler_am_ende") THEN fehlerEndeAn = JSON_GET_BOOL(konfig, "fehler_am_ende")
IF JSON_HAS(konfig, "typ_hinweise") THEN typHinweiseAn = JSON_GET_BOOL(konfig, "typ_hinweise")
IF JSON_HAS(konfig, "neustart_beim_sichern") THEN neustartSichernAn = JSON_GET_BOOL(konfig, "neustart_beim_sichern")
IF JSON_HAS(konfig, "start") THEN
    DIM sk AS INTEGER
    FOR sk = 0 TO JSON_LEN(konfig, "start") - 1
        DIM skp AS STRING : skp = "start." + STR$(sk)
        IF NOT JSON_HAS(konfig, skp + ".datei") THEN CONTINUE
        ARRAY_PUSH(startDateien, JSON_GET_STRING(konfig, skp + ".datei"))
        ARRAY_PUSH(startArgs, IIF(JSON_HAS(konfig, skp + ".argumente"), JSON_GET_STRING(konfig, skp + ".argumente"), ""))
        ARRAY_PUSH(startUmg, IIF(JSON_HAS(konfig, skp + ".umgebung"), JSON_GET_STRING(konfig, skp + ".umgebung"), ""))
    NEXT
END IF
IF JSON_HAS(konfig, "geruest") THEN geruestAn = JSON_GET_BOOL(konfig, "geruest")
IF JSON_HAS(konfig, "klammern") THEN klammernAn = JSON_GET_BOOL(konfig, "klammern")
IF JSON_HAS(konfig, "format_sichern") THEN formatSichernAn = JSON_GET_BOOL(konfig, "format_sichern")
IF JSON_HAS(konfig, "umbau_vorschau") THEN vorschauAn = JSON_GET_BOOL(konfig, "umbau_vorschau")
IF JSON_HAS(konfig, "leiste") THEN leisteAn = JSON_GET_BOOL(konfig, "leiste")
IF JSON_HAS(konfig, "seitenleiste") THEN seitenAn = JSON_GET_BOOL(konfig, "seitenleiste")
IF JSON_HAS(konfig, "untere_leiste") THEN untenAn = JSON_GET_BOOL(konfig, "untere_leiste")
IF JSON_HAS(konfig, "druck_groesse") THEN druckGroesse = MAX(6, MIN(16, JSON_GET_INT(konfig, "druck_groesse")))
IF JSON_HAS(konfig, "druck_rand") THEN druckRand = MAX(10, MIN(40, JSON_GET_INT(konfig, "druck_rand")))
IF JSON_HAS(konfig, "druck_nummern") THEN druckNummern = JSON_GET_BOOL(konfig, "druck_nummern")
IF JSON_HAS(konfig, "falten_pfade") AND JSON_HAS(konfig, "falten_zeilen") THEN
    DIM fk AS INTEGER
    FOR fk = 0 TO MIN(JSON_LEN(konfig, "falten_pfade"), JSON_LEN(konfig, "falten_zeilen")) - 1
        ARRAY_PUSH(faltPfade, JSON_GET_STRING(konfig, "falten_pfade." + STR$(fk)))
        ARRAY_PUSH(faltListe, JSON_GET_STRING(konfig, "falten_zeilen." + STR$(fk)))
    NEXT
END IF
IF JSON_HAS(konfig, "haltepunkte") THEN
    DIM hl AS INTEGER
    FOR hl = 0 TO JSON_LEN(konfig, "haltepunkte") - 1
        DIM hlP AS STRING : hlP = "haltepunkte." + STR$(hl)
        IF NOT JSON_HAS(konfig, hlP + ".datei") OR NOT JSON_HAS(konfig, hlP + ".zeile") THEN CONTINUE
        ARRAY_PUSH(hpDateien, JSON_GET_STRING(konfig, hlP + ".datei"))
        ARRAY_PUSH(hpZeilen, JSON_GET_INT(konfig, hlP + ".zeile"))
        IF JSON_HAS(konfig, hlP + ".bedingung") THEN ARRAY_PUSH(hpBedingungen, JSON_GET_STRING(konfig, hlP + ".bedingung")) ELSE ARRAY_PUSH(hpBedingungen, "")
        IF JSON_HAS(konfig, hlP + ".aktiv") THEN ARRAY_PUSH(hpAktiv, JSON_GET_BOOL(konfig, hlP + ".aktiv")) ELSE ARRAY_PUSH(hpAktiv, TRUE)
        IF JSON_HAS(konfig, hlP + ".treffer") THEN ARRAY_PUSH(hpTreffer, JSON_GET_STRING(konfig, hlP + ".treffer")) ELSE ARRAY_PUSH(hpTreffer, "")
        IF JSON_HAS(konfig, hlP + ".log") THEN ARRAY_PUSH(hpLog, JSON_GET_STRING(konfig, hlP + ".log")) ELSE ARRAY_PUSH(hpLog, "")
    NEXT
END IF
IF JSON_HAS(konfig, "lesezeichen") THEN
    DIM ll AS INTEGER
    FOR ll = 0 TO JSON_LEN(konfig, "lesezeichen") - 1
        DIM llP AS STRING : llP = "lesezeichen." + STR$(ll)
        IF NOT JSON_HAS(konfig, llP + ".datei") OR NOT JSON_HAS(konfig, llP + ".zeile") THEN CONTINUE
        ARRAY_PUSH(lzDateien, JSON_GET_STRING(konfig, llP + ".datei"))
        ARRAY_PUSH(lzZeilen, JSON_GET_INT(konfig, llP + ".zeile"))
    NEXT
END IF
IF JSON_HAS(konfig, "autosichern") THEN autoSichern = MAX(0, MIN(120, JSON_GET_INT(konfig, "autosichern")))
IF hell THEN GUI_THEME_PRESET("glas_hell") : themaFeinschliff()
codeFarben(hell)

