DHRT_FRAMES=58
--- nachher
DIM g AS BUFFER : g = READALL_BYTES("_programm/raus.gif")
DIM marke AS BUFFER : marke = BUFFER_FROM_HEX("21f904")
DIM dauern AS ARRAY OF INTEGER : dauern = []
DIM p AS INTEGER : p = BUFFER_INDEXOF(g, marke)
WHILE p >= 0
    ARRAY_PUSH(dauern, BUFFER_GET_U16(g, p + 4) * 10)
    p = BUFFER_INDEXOF(g, marke, p + 3)
WEND
PRINT "bilder " ; LEN(dauern)
PRINT "verschieden " ; dauern[0] <> dauern[1]
PRINT "eins folgt dem regler " ; dauern[0] = 130 OR dauern[1] = 130
--- erwartet
bilder 2
verschieden TRUE
eins folgt dem regler TRUE

=== die dauer uebersteht die eigene datei
' Setzen, sichern, neu anfangen, laden. Die Zwischenpruefung (erst 0, dann wieder
' da) haelt fest, dass [Neu] samt [Anlegen] wirklich gegriffen hat.
DIM prBild AS INTEGER : prBild = 0
DIM prStart AS INTEGER : prStart = -1
DIM prF AS ARRAY OF INTEGER : prF = []
DIM prZ AS ARRAY OF STRING : prZ = []
DIM prFlag AS STRING : prFlag = ""
DIM prG AS INTEGER : prG = 0
DIM prD AS INTEGER : prD = 0
DIM prL AS INTEGER : prL = 0
