=== bitfelder der windows-api: buildcommdcba fuellt ein dcb
' Das DCB einer seriellen Schnittstelle traegt 13 Bitfelder in einer
' DWORD-Einheit. BuildCommDCBA fuellt es aus einem Text, ohne dass es einen
' Anschluss braucht.
STRUCT DCB LAYOUT C
    DCBlength AS ULONG
    BaudRate AS ULONG
    fBinary AS ULONG : 1
    fParity AS ULONG : 1
    fOutxCtsFlow AS ULONG : 1
    fOutxDsrFlow AS ULONG : 1
    fDtrControl AS ULONG : 2
    fDsrSensitivity AS ULONG : 1
    fTXContinueOnXoff AS ULONG : 1
    fOutX AS ULONG : 1
    fInX AS ULONG : 1
    fErrorChar AS ULONG : 1
    fNull AS ULONG : 1
    fRtsControl AS ULONG : 2
    fAbortOnError AS ULONG : 1
    fDummy2 AS ULONG : 17
    wReserved AS USHORT
    XonLim AS USHORT
    XoffLim AS USHORT
    ByteSize AS UBYTE
    Parity AS UBYTE
    StopBits AS UBYTE
    XonChar AS BYTE
    XoffChar AS BYTE
    ErrorChar AS BYTE
    EofChar AS BYTE
    EvtChar AS BYTE
    wReserved1 AS USHORT
END STRUCT
DECLARE FUNCTION BuildCommDCBA LIB "kernel32" (def AS TEXT, dcb AS DCB) AS BOOLEAN
PRINT SIZEOF(DCB), OFFSETOF(DCB, wReserved), OFFSETOF(DCB, ByteSize)
DIM d AS DCB
d.DCBlength = SIZEOF(DCB)
PRINT BuildCommDCBA("baud=19200 parity=e data=7 stop=2 dtr=on rts=on octs=on idsr=on", d)
PRINT d.BaudRate, d.ByteSize, d.Parity, d.StopBits
PRINT d.fOutxCtsFlow, d.fOutxDsrFlow, d.fDtrControl, d.fDsrSensitivity, d.fRtsControl
d.fDtrControl = 2
d.fRtsControl = 3
d.fAbortOnError = 1
PRINT HEX$(BUFFER_GET_I32(d, 8) BAND &H7FFF), d.fOutxCtsFlow, d.fDsrSensitivity
--- system windows
--- erwartet
28 12 18
TRUE
19200 7 2 2
1 0 1 1 1
7064 1 1

=== felder von structs liegen hintereinander in einem puffer
' DIM pts[n] AS Punkt ist EIN Puffer mit n Structs hintereinander, wie in C;
' LEN zaehlt die Structs. ARRAY OF Punkt als Parameter und Rueckgabe meint
' dasselbe, die Groesse darf erst zur Laufzeit feststehen.
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
DIM pts[4] AS Punkt
DIM i AS INTEGER
FOR i = 0 TO LEN(pts) - 1
    pts[i].x = i * 10
    pts[i].y = -i
NEXT
PRINT LEN(pts), BUFFER_LEN(pts), TYPEOF(pts)
PRINT pts[2].x, pts[3].y, BUFFER_GET_I32(pts, 16), BUFFER_GET_I32(pts, 28)
TRY
    PRINT pts[4].x
CATCH e
    PRINT e
END TRY
FUNCTION reihe(n AS INTEGER) AS ARRAY OF Punkt
    DIM r[n] AS Punkt
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        r[k].x = k * k
    NEXT
    RETURN r
END FUNCTION
FUNCTION summe(ps AS ARRAY OF Punkt) AS INTEGER
    DIM s AS INTEGER
    DIM k AS INTEGER
    FOR k = 0 TO LEN(ps) - 1
        s = s + ps[k].x
    NEXT
    RETURN s
END FUNCTION
DIM q AS ARRAY OF Punkt
PRINT LEN(q)
q = reihe(5)
PRINT LEN(q), summe(q), summe(pts)
DIM leer AS ARRAY OF Punkt
TRY
    PRINT leer[0].x
CATCH e
    PRINT e
END TRY
--- erwartet
4 32 BUFFER
20 -3 20 -3
pts[].x: Index 4 liegt ausserhalb 0..3
0
5 30 60
leer[].x: Index 0 -- das Feld ist leer

=== ein struct als feld einer klasse
' Jedes Objekt bekommt bei NEW seinen eigenen Puffer -- fuer einen Struct
' und fuer ein Feld davon; obj.p.x, Self.p.x und p.x in einer Methode
' greifen an fester Stelle zu. Ein ganzes Feld ist der Puffer selbst (eine
' Zuweisung teilt die Bytes, wie bei jeder Struct-Variable).
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
CLASS Figur
    DIM name AS STRING
    DIM ort AS Punkt
    DIM ecken[3] AS Punkt
    SUB setze(x AS INTEGER, y AS INTEGER)
        Self.ort.x = x
        ort.y = y
        ecken[1].x = x + 1
    END SUB
    FUNCTION weite() AS INTEGER
        RETURN Self.ecken[1].x + LEN(ecken)
    END FUNCTION
END CLASS
CLASS Quadrat EXTENDS Figur
    FUNCTION mitte() AS INTEGER
        RETURN ort.x + 5
    END FUNCTION
END CLASS
DIM f AS Figur
f = NEW Figur()
DIM g AS Figur
g = NEW Figur()
f.setze(3, 4)
f.ort.x = f.ort.x + 100
PRINT f.ort.x, f.ort.y, f.weite(), g.ort.x, TYPEOF(f.ort), BUFFER_LEN(f.ecken)
DIM p AS Punkt
p = f.ort
p.y = 99
PRINT f.ort.y
DIM qu AS Quadrat
qu = NEW Quadrat()
qu.setze(1, 2)
PRINT qu.mitte(), qu.ecken[1].x
--- erwartet
103 4 7 0 BUFFER 24
99
6 2

=== ein feld von structs geht an eine bibliothek
' Als Parameter AS Punkt bekommt die Bibliothek einen Zeiger auf das erste
' Element (C: Punkt*), die uebrigen liegen dahinter -- qsort sortiert sie an
' Ort und Stelle.
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
DECLARE SUB qsort LIB "c" (feld AS Punkt, n AS ZEIGER, groesse AS ZEIGER, vergleich AS FUNCTION(a AS ZEIGER, b AS ZEIGER) AS LONG)
FUNCTION nachY(a AS INTEGER, b AS INTEGER) AS INTEGER
    DIM p AS Punkt
    p = BUFFER_AUS_ZEIGER(a, SIZEOF(Punkt))
    DIM q AS Punkt
    q = BUFFER_AUS_ZEIGER(b, SIZEOF(Punkt))
    RETURN SGN(p.y - q.y)
END FUNCTION
DIM ps[5] AS Punkt
DIM i AS INTEGER
FOR i = 0 TO 4
    ps[i].x = i
    ps[i].y = (i * 7) MOD 5
NEXT
qsort(ps, LEN(ps), SIZEOF(Punkt), nachY)
DIM z AS STRING
FOR i = 0 TO 4
    z = z + STR$(ps[i].x) + ":" + STR$(ps[i].y) + " "
NEXT
PRINT TRIM$(z)
--- erwartet
0:0 3:1 1:2 4:3 2:4

