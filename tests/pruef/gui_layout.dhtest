=== geschachtelt und anker am behaelter
' Eine Spalte mit einer Knopfzeile unten; der Behaelter klebt an allen
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM s AS GUI_WIDGET : s = GUI_LAYOUT(w, "spalte", 0, 0, 500, 400)
GUI_SET_ANCHOR(s, "lrtb")
GUI_LAYOUT_SET(s, "abstand", 0)
DIM f AS GUI_WIDGET : f = GUI_TEXTAREA(w, 0, 0, 10, 10)
DIM z AS GUI_WIDGET : z = GUI_LAYOUT(w, "zeile", 0, 0, 10, 30)
GUI_LAYOUT_SET(z, "abstand", 0)
DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(w, "OK", 0, 0, 80, 30)
GUI_LAYOUT_SPACER(z) : GUI_LAYOUT_ADD(z, ok)
GUI_LAYOUT_ADD(s, f, 1) : GUI_LAYOUT_ADD(s, z)
GUI_UPDATE()
PRINT GUI_GET_X(ok) ; " " ; GUI_GET_Y(ok) ; " " ; GUI_GET_W(ok) ; " " ; GUI_GET_H(ok)
PRINT GUI_GET_X(f) ; " " ; GUI_GET_Y(f) ; " " ; GUI_GET_W(f) ; " " ; GUI_GET_H(f)
GUI_WINDOW_SET_BOUNDS(w, 0, 0, 600, 300)
GUI_UPDATE()
GUI_UPDATE()
PRINT GUI_GET_X(ok) ; " " ; GUI_GET_Y(ok) ; " " ; GUI_GET_W(ok) ; " " ; GUI_GET_H(ok)
PRINT GUI_GET_X(f) ; " " ; GUI_GET_Y(f) ; " " ; GUI_GET_W(f) ; " " ; GUI_GET_H(f)
--- umgebung
DHRT_FRAMES=2
--- erwartet
420 370 80 30
0 0 500 370
520 270 80 30
0 0 600 270

=== ein widget steckt in hoechstens einem behaelter
IMPORT "gui"
SCREEN(500, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 500, 400)
