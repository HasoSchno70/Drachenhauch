--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
SUB rezept(name AS STRING, zutaten AS STRING)
    DIM x AS Rezept : x = NEW Rezept()
    x.name = name
    x.portionen = 2
    x.zutaten = []
    DIM t AS STRING
    FOR EACH t IN SPLIT(zutaten, ";")
        DIM g AS ARRAY OF STRING : g = SPLIT(t, "|")
        DIM z AS Zutat : z = NEW Zutat() : z.name = g[0] : z.menge = VAL(g[1]) : z.einheit = "Stück"
        ARRAY_PUSH(x.zutaten, z)
    NEXT
    rezeptAnlegen(x)
END SUB
rezept("Alles da", "Ei|2;Milch|1")
rezept("Fast", "Ei|2;Milch|1;Butter|1;Mehl|1")
rezept("Halb", "Ei|2;Salz|1")
rezept("Zu knapp", "Ei|20;Mehl|1;Zucker|1")
rezept("Nichts", "Zimt|1;Mehl|1")
' Zwei ablaufende Zutaten heben es ueber "Halb" (gleicher Anteil).
rezept("Zwei ablaufend", "Ei|2;Butter|1;Zimt|1;Zucker|1")
' Die erste passende Milch reicht nicht, die zweite (groessere) schon.
rezept("Viel Milch", "Milch|2")
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Ei'), ('Milch'), ('Butter')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 10, 'Stück', '2026-11-09'), (2, 1, 'Liter', '2026-11-30'), (3, 1, 'Stück', '2026-11-10')")
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Milch 3,5 %')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (4, 3, 'Liter', '2026-12-31')")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
SUB zeilen(v AS VorschlagFenster)
    PRINT "  "; GUI_TEXT(v.titel); " | "; GUI_TEXT(v.info)
    DIM i AS INTEGER
    FOR i = 0 TO GUI_TABLE_ROW_COUNT(v.tabelle) - 1
        DIM h AS STRING : h = IIF(GUI_TABLE_GET_VALUE(v.tabelle, i, 0) > 0.5, "x", ".")
        PRINT "  "; h; " "; GUI_TABLE_GET_CELL(v.tabelle, i, 1); " | "; GUI_TABLE_GET_CELL(v.tabelle, i, 2); " | "; GUI_TABLE_GET_CELL(v.tabelle, i, 3); " | "; GUI_TABLE_GET_CELL(v.tabelle, i, 4)
    NEXT
END SUB
DIM v AS VorschlagFenster : v = NEW VorschlagFenster()
v.art = "kochbar"
v.Zeigen()
zeilen(v)
v.knopfEinkaufen_Klick()
PRINT "einkauf "; v.einkauf; " | "; JOIN$(textListe("SELECT product_name || ':' || quantity || ':' || notes FROM shopping_list ORDER BY id"), " ")
v.Zumachen()
DIM w AS VorschlagFenster : w = NEW VorschlagFenster()
w.art = "ablauf"
w.Zeigen()
zeilen(w)
GUI_TABLE_SET_SELECTED(w.tabelle, 1)
w.knopfKochen_Klick()
PRINT "kochen "; w.kochenId; " | offen "; w.studioOffen
