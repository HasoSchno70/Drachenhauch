CLASS App EXTENDS StudioApp
    SUB Geoeffnet()
        DIM r AS DB_RESULT : r = DB_QUERY(Daten, "SELECT COUNT(*) FROM kunden")
        IF DB_NEXT(r) THEN PRINT "kunden "; DB_GET_INT(r, 0)
    END SUB
END CLASS
