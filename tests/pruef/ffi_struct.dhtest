=== klassen mit structs ueber eine dhc-datei
' Die Groesse des Puffers eines Struct-Feldes steht im .dhc (struct_bytes);
' ein exportiertes Programm laeuft so.
DIM d AS INTEGER
d = PROCESS_START("dhrt", "--dumpbc", CWD$() + "/prog.dh")
DIM aus AS STRING
DIM leer AS INTEGER
WHILE leer < 5
    DIM t AS STRING
    t = PROCESS_READ$(d)
    IF t = "" THEN
        IF NOT PROCESS_RUNNING(d) THEN leer = leer + 1
        SLEEP(30)
    ELSE
        aus = aus + t
    END IF
WEND
WRITEALL("prog.dhc", aus)
DIM p AS INTEGER
p = PROCESS_START("dhrt", CWD$() + "/prog.dhc")
aus = ""
leer = 0
WHILE leer < 5
    t = PROCESS_READ$(p)
    IF t = "" THEN
        IF NOT PROCESS_RUNNING(p) THEN leer = leer + 1
        SLEEP(30)
    ELSE
        aus = aus + t
    END IF
WEND
PRINT TRIM$(aus)
--- datei prog.dh
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
CLASS K
    DIM p AS Punkt
    DIM ps[2] AS Punkt
END CLASS
DIM k AS K
k = NEW K()
k.p.y = 7
k.ps[1].x = 8
PRINT k.p.y + k.ps[1].x, BUFFER_LEN(k.ps)
--- erwartet
15 16

=== felder von structs mit mehreren dimensionen
' Wie in C: zeilenweise in EINEM Puffer, die hinteren Groessen stehen beim
' Uebersetzen fest, die erste darf erst zur Laufzeit kommen. Jeder Index
' wird gegen seine eigene Groesse geprueft.
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
CONST SP = 3
DIM n AS INTEGER
n = 2
DIM g[n, SP] AS Punkt
DIM i AS INTEGER
DIM j AS INTEGER
FOR i = 0 TO n - 1
    FOR j = 0 TO SP - 1
        g[i, j].x = i * 10 + j
    NEXT
NEXT
PRINT LEN(g), BUFFER_LEN(g), g[1, 2].x
DIM flach AS ARRAY OF Punkt
flach = g
PRINT flach[4].x, LEN(flach)
TRY
    PRINT g[0, 3].x
CATCH e
    PRINT e
END TRY
TRY
    PRINT g[2, 0].x
CATCH e
    PRINT e
END TRY
SUB setze(i AS INTEGER, j AS INTEGER)
    g[i, j].y = 7
END SUB
setze(1, 1)
PRINT g[1, 1].y, flach[4].y
CLASS Brett
    DIM feld[2, 2] AS Punkt
END CLASS
DIM b AS Brett
b = NEW Brett()
b.feld[1, 0].x = 4
PRINT b.feld[1, 0].x, LEN(b.feld), BUFFER_LEN(b.feld)
--- erwartet
2 48 12
11 6
g[,].x: Index 3 liegt ausserhalb 0..2
g[,].x: Index 2 liegt ausserhalb 0..1
7 7
4 2 32

=== ein element als ganzes ist eine kopie
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
STRUCT Linie LAYOUT C
    a AS Punkt
    b AS Punkt
END STRUCT
DIM ps[3] AS Punkt
ps[1].x = 5
DIM p AS Punkt
p = ps[1]
p.y = 9
PRINT p.x, p.y, ps[1].y
ps[2] = p
PRINT ps[2].x, ps[2].y
ps[2] = ps[2]
PRINT ps[2].x
' Die Quelle ist derselbe Puffer: erst gelesen, dann geschrieben.
ps[1] = ps
PRINT ps[1].x
DIM l AS Linie
l.b = p
l.a = l.b
PRINT l.a.x, l.b.y, BUFFER_LEN(l.a)
DIM kurz AS BUFFER
kurz = BUFFER_NEW(4)
TRY
    ps[0] = kurz
CATCH e
    PRINT e
END TRY
TRY
    ps[0] = 3
CATCH e
    PRINT e
END TRY
--- erwartet
5 9 0
5 9
5
0
5 9 8
ps[]: der Puffer ist 4 Bytes lang, der Struct braucht 8
ps[]: erwartet einen Struct (einen BUFFER), erhalten INTEGER

=== for each ueber ein feld von structs liefert kopien
STRUCT Punkt LAYOUT C
    x AS LONG
    y AS LONG
END STRUCT
STRUCT Reihe LAYOUT C
    w[3] AS LONG
    ecken[2] AS Punkt
END STRUCT
DIM ps[4] AS Punkt
DIM i AS INTEGER
FOR i = 0 TO 3
    ps[i].y = i + 1
NEXT
DIM summe AS INTEGER
FOR EACH q IN ps
    summe = summe + q.y
    IF q.y = 3 THEN BREAK
NEXT
PRINT summe
SUB zeige(reihe AS ARRAY OF Punkt)
    FOR EACH r IN reihe
        IF r.y = 2 THEN CONTINUE
        PRINT r.y;
    NEXT
    PRINT
END SUB
zeige(ps)
DIM leer AS ARRAY OF Punkt
zeige(leer)
DIM st AS Reihe
st.w[2] = 5
st.ecken[1].x = 8
FOR EACH v IN st.w
    PRINT v;
NEXT
PRINT
FOR EACH e IN st.ecken
    PRINT e.x;
NEXT
PRINT
