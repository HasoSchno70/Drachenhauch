=== das pruefprogramm tippspiel_pruefung.dh ist gruen
' Seit der Umstellung auf ASSERT_* endet ein Pruefprogramm mit einem
' Rueckgabewert -- vorher war er IMMER 0. Nur den Text zu pruefen wuerde die
' eigentliche Zusage wieder verlieren. (abruf_pruefung.dh geht ins Netz und
' bleibt aussen vor.)
IMPORT "helfer.dh"
kopieLaufen(ARG$(0), "tippspiel_pruefung.dh", 0)
PRINT "alles gruen "; (INSTR(blAus, "ALLES GRUEN") >= 0)
PRINT "rueckgabe "; blCode
IF blCode <> 0 OR INSTR(blAus, "ALLES GRUEN") < 0 THEN PRINT blAus; blErr
--- argumente
{sammlung}/../..
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/buchlauf.dh"
--- erwartet
alles gruen TRUE
rueckgabe 0

