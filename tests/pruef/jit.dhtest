=== ueberschreibung aus der vm gerufen
CLASS Tier
    DIM n AS INTEGER
    FUNCTION laut() AS INTEGER
        RETURN 1
    END FUNCTION
    SUB rufen()
        Self.n = Self.n + laut()
    END SUB
END CLASS
CLASS Hund EXTENDS Tier
    FUNCTION laut() AS INTEGER
        RETURN 10
    END FUNCTION
END CLASS
DIM t AS Tier : t = NEW Tier()
DIM h AS Hund : h = NEW Hund()
DIM i AS INTEGER
FOR i = 1 TO 3
    t.rufen()
    h.rufen()
    PRINT t.n; " "; h.n
NEXT
--- umgebung
DHRT_JIT=aus
--- erwartet
1 10
2 20
3 30

