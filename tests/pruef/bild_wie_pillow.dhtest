' Skalieren mit Filter und Bildanpassung, gerechnet wie Pillow (resample.rs).
' Die Beilagen hat Pillow 12.1.1 geschrieben (Image.resize, ImageEnhance) --
' ein fremder Rechner, nicht der eigene. Erwartet ist: kein Punkt weicht ab.
' Erzeugt aus einem 31x23-Bild mit Verlaeufen und Rauschen (random.Random(7)).

=== lanczos wie pillow
IMPORT "helfer.dh"
IMPORT "imgfx"
DIM q AS IMAGE : q = LOADIMAGE("quelle.png")
PRINT "klein "; bvAbweichung$(IMAGE_SCALE(q, 11, 8, "lanczos"), LOADIMAGE("klein_lanczos.png"))
PRINT "gross "; bvAbweichung$(IMAGE_SCALE(q, 47, 35, "lanczos"), LOADIMAGE("gross_lanczos.png"))
PRINT "flach "; bvAbweichung$(IMAGE_SCALE(q, 31, 9, "LANCZOS"), LOADIMAGE("flach_lanczos.png"))
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/bildvergleich.dh"

