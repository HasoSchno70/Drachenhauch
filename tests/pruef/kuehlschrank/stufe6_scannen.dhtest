=== stapelscan: vorgaben, gleichzeitig unterwegs, duplikat, mhd-knopf, entfernen, speichern, rueckgaengig
' Drei Barcodes hintereinander, bevor eine Antwort da ist: alle drei kommen
' an (die Python-App brach die vorige Suche ab). Derselbe noch einmal fragt
' (Enter = Ja, Menge 2). +14T in einer Zeile, das Kreuz entfernt nach
' Frage (Enter). Speichern mit Markt: Produkte samt Marke und Kategorie,
' Bestand, Markt, Gelerntes -- ein Schritt. Ein zweites Fenster nimmt das
' Gelernte fuer 4002.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
COPYFILE(ARG$(2), CWD$() + "/bild.png")
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
DIM srv AS INTEGER : srv = kOffStarten(ARG$(3))
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(150)
slTaste(257)
slWarten(12)
slTaste(257)
slWarten(12)
slTaste(257)
slAufnahmeSchreiben(p + "/_studio/tasten.txt")
PRINT "code "; kProbe(p, "probe.dh", "tasten.txt", 400)
kOffEnde(srv)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
{sammlung}/../../../daten/bilder/logo.png
{sammlung}/../_hilfen/off_server.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "DELETE FROM inventory")
DB_EXEC(db, "DELETE FROM products")
DB_EXEC(db, "DELETE FROM user_learning")
DB_EXEC(db, "DELETE FROM product_stores")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
SUB zeilen(sc AS ScanFenster)
    DIM z AS INTEGER
    FOR z = 0 TO GUI_TABLE_ROW_COUNT(sc.tabelle) - 1
        PRINT "  "; GUI_TABLE_GET_VALUE(sc.tabelle, z, 0); " | "; GUI_TABLE_GET_CELL(sc.tabelle, z, 1); " | "; GUI_TABLE_GET_CELL(sc.tabelle, z, 2); " | "; GUI_TABLE_GET_CELL(sc.tabelle, z, 3); " | "; GUI_TABLE_GET_CELL(sc.tabelle, z, 4); " | "; GUI_TABLE_GET_CELL(sc.tabelle, z, 10)
    NEXT
    PRINT "  "; GUI_TEXT(sc.anzahlKopf); " | "; GUI_TEXT(sc.anzahlText); " | speichern "; GUI_ENABLED(sc.knopfSpeichern)
END SUB
SUB scannen(sc AS ScanFenster, b AS STRING)
    GUI_SET_TEXT(sc.barcodeFeld, b)
    sc.knopfScannen_Klick()
END SUB
SUB warten(sc AS ScanFenster, zahl AS INTEGER)
    DIM n AS INTEGER
    WHILE (GUI_TABLE_ROW_COUNT(sc.tabelle) < zahl OR LEN(sc.abrufe) > 0) AND n < 300 AND studioBild()
        n = n + 1
    WEND
END SUB
DIM sc AS ScanFenster : sc = NEW ScanFenster()
sc.Zeigen()
PRINT "markt "; GUI_DROPDOWN_ITEM(sc.marktWahl, 0); " | "; GUI_DROPDOWN_COUNT(sc.marktWahl) > 1
scannen(sc, "")
PRINT "leer "; GUI_TEXT(sc.scanStatus)
scannen(sc, "4001")
scannen(sc, "4002")
scannen(sc, "4003")
PRINT "unterwegs "; LEN(sc.abrufe); " | "; GUI_TEXT(sc.scanStatus)
warten(sc, 3)
zeilen(sc)
PRINT "status "; GUI_TEXT(sc.scanStatus)
' Derselbe Barcode noch einmal (aus dem Cache): Enter = Ja, Menge 2.
scannen(sc, "4001")
PRINT "duplikat "; GUI_TEXT(sc.scanStatus)
sc.tabelle_Zelle(1, SP_S_SCHNELL + 2)
GUI_TABLE_SET_CELL(sc.tabelle, 1, SP_S_ORT, "Kühlschrank")
sc.tabelle_Zelle(2, SP_S_WEG)
zeilen(sc)
GUI_DROPDOWN_SET_SELECTED(sc.marktWahl, 1)
DIM markt AS STRING : markt = GUI_DROPDOWN_TEXT(sc.marktWahl)
sc.knopfSpeichern_Klick()
PRINT "gespeichert "; sc.gespeichert; " | offen "; sc.studioOffen; " | "; verlauf.textZurueck$()
PRINT "produkte "; JOIN$(textListe("SELECT name || ':' || IFNULL(barcode, '-') || ':' || IFNULL(brand, '-') || ':' || IFNULL(category, '-') FROM products ORDER BY id"), " / ")
PRINT "bestand "; JOIN$(textListe("SELECT p.name || ':' || i.quantity || ':' || i.unit || ':' || i.expiry_date || ':' || i.storage_location || ':' || (i.purchased_at_store = '" + markt + "') FROM inventory i JOIN products p ON p.id = i.product_id ORDER BY i.id"), " / ")
PRINT "markt "; dbZahl("SELECT COUNT(*) FROM product_stores WHERE last_purchased = '2026-11-08'")
PRINT "gelernt "; JOIN$(textListe("SELECT barcode || ':' || field || ':' || value FROM user_learning ORDER BY id"), " / ")
f.miRueckgaengig_Aktion()
PRINT "zurueck "; dbZahl("SELECT COUNT(*) FROM inventory"); " "; dbZahl("SELECT COUNT(*) FROM products"); " "; dbZahl("SELECT COUNT(*) FROM user_learning"); " "; dbZahl("SELECT COUNT(*) FROM product_stores")
f.miWiederholen_Aktion()
PRINT "wieder "; dbZahl("SELECT COUNT(*) FROM inventory"); " "; dbZahl("SELECT COUNT(*) FROM user_learning")
' Ein neues Fenster: 4002 nimmt Ort und Haltbarkeit aus dem Gelernten.
DIM s2 AS ScanFenster : s2 = NEW ScanFenster()
s2.Zeigen()
scannen(s2, "4002")
warten(s2, 1)
zeilen(s2)
--- erwartet
markt -- Markt wählen -- | TRUE
leer ❗ Bitte Barcode eingeben
