' Star Pilot - Kap 10: Player + Bullets + zwei Enemy-Typen.
'
' Was sich gegenueber Kap 9 geaendert hat:
'   - Neue Basisklasse Entity (gemeinsame Position + alive-Flag)
'   - Player erbt jetzt von Entity
'   - Zwei neue Klassen: Grunt und Bomber, beide erben von Entity
'   - Pool fuer Enemies (gleiches Pattern wie Bullets)
'   - Enemies spawnen alle 60 Frames an zufaelligen X-Positionen
'
' Bullet ist bewusst eine "Hilfs-Sprite", nicht Entity - es macht den Code
' nicht einfacher, das mit zu vererben (Bullet hat eigene Geometrie und
' Logik, die mit Enemy/Player wenig gemein hat).

CONST WIDTH        AS INTEGER = 320
CONST HEIGHT       AS INTEGER = 240
CONST BG_COLOR     AS INTEGER = &H141E3C
CONST PLAYER_C     AS INTEGER = &HFFDC00
CONST BULLET_C     AS INTEGER = &HFFFFFF
CONST GRUNT_C      AS INTEGER = &HFF6677
CONST BOMBER_C     AS INTEGER = &HFFAA33
CONST PLAYER_SPEED AS INTEGER = 3
CONST BULLET_SPEED AS INTEGER = 5
CONST BULLET_POOL  AS INTEGER = 20
CONST ENEMY_POOL   AS INTEGER = 15

' --- Helper ---
FUNCTION Clamp(wert AS INTEGER, lo AS INTEGER, hi AS INTEGER) AS INTEGER
    IF wert < lo THEN RETURN lo
    IF wert > hi THEN RETURN hi
    RETURN wert
END FUNCTION

' --- Basisklasse fuer alle Spielobjekte ---
CLASS Entity
    DIM x      AS INTEGER
    DIM y      AS INTEGER
    DIM w      AS INTEGER
    DIM h      AS INTEGER
    DIM alive  AS BOOLEAN

    SUB Init(start_x AS INTEGER, start_y AS INTEGER)
        x = start_x
        y = start_y
        alive = TRUE
        w = 16
        h = 16
    END SUB

    SUB Update()
    END SUB

    SUB Draw()
    END SUB
END CLASS

' --- Player ---
CLASS Player EXTENDS Entity
    SUB Init(start_x AS INTEGER, start_y AS INTEGER)
        x = start_x
        y = start_y
        alive = TRUE
        w = 40
        h = 24
    END SUB

    SUB Update()
        IF KEYPRESSED(KEY_LEFT) THEN
            x = x - PLAYER_SPEED
        END IF
        IF KEYPRESSED(KEY_RIGHT) THEN
            x = x + PLAYER_SPEED
        END IF
        x = Clamp(x, 0, WIDTH - w)
    END SUB

    SUB Draw()
        BOX(x, y, x + w, y + h, PLAYER_C)
    END SUB
END CLASS

' --- Grunt: einfacher Gegner, fliegt geradeaus runter ---
CLASS Grunt EXTENDS Entity
    SUB Spawn(at_x AS INTEGER)
        x = at_x
        y = -16
        w = 16
        h = 14
        alive = TRUE
    END SUB

    SUB Update()
        IF NOT alive THEN RETURN
        y = y + 1
        IF y > HEIGHT THEN alive = FALSE
    END SUB

    SUB Draw()
        IF alive THEN
            BOX(x, y, x + w, y + h, GRUNT_C)
        END IF
    END SUB
END CLASS

' --- Bomber: Zickzack, langsamer aber breiter ---
CLASS Bomber EXTENDS Entity
    DIM dx AS INTEGER

    SUB Spawn(at_x AS INTEGER)
        x = at_x
        y = -20
        w = 22
        h = 18
        alive = TRUE
        dx = 1
    END SUB

    SUB Update()
        IF NOT alive THEN RETURN
        y = y + 1
        x = x + dx
        IF x < 0 OR x > WIDTH - w THEN
            dx = -dx
        END IF
        IF y > HEIGHT THEN alive = FALSE
    END SUB

    SUB Draw()
        IF alive THEN
            BOX(x, y, x + w, y + h, BOMBER_C)
        END IF
    END SUB
END CLASS

' --- Bullet bleibt eine eigene Klasse (nicht von Entity erbend) ---
CLASS Bullet
    DIM x      AS INTEGER
    DIM y      AS INTEGER
    DIM alive  AS BOOLEAN

    SUB Init()
        alive = FALSE
    END SUB

    SUB Spawn(at_x AS INTEGER, at_y AS INTEGER)
        x = at_x
        y = at_y
        alive = TRUE
    END SUB

    SUB Update()
        IF NOT alive THEN RETURN
        y = y - BULLET_SPEED
        IF y < -8 THEN alive = FALSE
    END SUB

    SUB Draw()
        IF alive THEN
            BOX(x, y, x + 3, y + 8, BULLET_C)
        END IF
    END SUB
END CLASS

' --- Globale Spielobjekte ---
DIM player AS Player
DIM bullets[BULLET_POOL] AS Bullet
DIM grunts[ENEMY_POOL] AS Grunt
DIM bombers[ENEMY_POOL] AS Bomber

DIM space_was_pressed AS BOOLEAN
DIM spawn_timer AS INTEGER

' --- Setup ---
SUB Setup()
    player = NEW Player(WIDTH / 2 - 20, HEIGHT - 40)

    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        bullets[i] = NEW Bullet()
    NEXT i
    FOR i = 0 TO ENEMY_POOL - 1
        grunts[i]  = NEW Grunt(0, 0)
        grunts[i].alive = FALSE
        bombers[i] = NEW Bomber(0, 0)
        bombers[i].alive = FALSE
    NEXT i

    space_was_pressed = FALSE
    spawn_timer = 60
    RANDOMIZE(MILLIS())

    SCREEN(WIDTH, HEIGHT, "Star Pilot", 2)
END SUB

SUB SpawnBullet(at_x AS INTEGER, at_y AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        IF NOT bullets[i].alive THEN
            bullets[i].Spawn(at_x, at_y)
            RETURN
        END IF
    NEXT i
END SUB

SUB SpawnGrunt(at_x AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO ENEMY_POOL - 1
        IF NOT grunts[i].alive THEN
            grunts[i].Spawn(at_x)
            RETURN
        END IF
    NEXT i
END SUB

SUB SpawnBomber(at_x AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO ENEMY_POOL - 1
        IF NOT bombers[i].alive THEN
            bombers[i].Spawn(at_x)
            RETURN
        END IF
    NEXT i
END SUB

SUB UpdateAll()
    player.Update()

    ' Schiessen mit Edge-Detection
    DIM space_now AS BOOLEAN
    space_now = KEYPRESSED(KEY_SPACE)
    IF space_now AND NOT space_was_pressed THEN
        SpawnBullet(player.x + player.w / 2 - 1, player.y - 8)
    END IF
    space_was_pressed = space_now

    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        bullets[i].Update()
    NEXT i
    FOR i = 0 TO ENEMY_POOL - 1
        grunts[i].Update()
        bombers[i].Update()
    NEXT i

    ' Spawn-Timer: alle 60 Frames (1 Sek) ein neuer Gegner
    spawn_timer = spawn_timer - 1
    IF spawn_timer <= 0 THEN
        spawn_timer = 60
        IF INT(RND() * 2) = 0 THEN
            SpawnGrunt(INT(RND() * (WIDTH - 16)))
        ELSE
            SpawnBomber(INT(RND() * (WIDTH - 22)))
        END IF
    END IF
END SUB

SUB DrawAll()
    DIM i AS INTEGER
    FOR i = 0 TO BULLET_POOL - 1
        bullets[i].Draw()
    NEXT i
    FOR i = 0 TO ENEMY_POOL - 1
        grunts[i].Draw()
        bombers[i].Draw()
    NEXT i
    player.Draw()
END SUB

Setup()

WHILE NOT QUITREQUESTED()
    UpdateAll()

    CLS(BG_COLOR)
    DrawAll()
    FLIP()
    SLEEP(16)
WEND
