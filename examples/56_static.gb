' 56_static.gb -- STATIC CONST Klassen-Members.
'
' Erlaubt klassen-bezogene Konstanten ohne globalen Namespace zu
' verschmutzen. Zugriff via `<ClassName>.<MEMBER>` -- analog ENUM.

CLASS Player
    STATIC CONST MAX_HP AS INTEGER = 100
    STATIC CONST DEFAULT_NAME AS STRING = "Hero"
    STATIC CONST WALK_SPEED AS FLOAT = 4.5
    STATIC CONST RUN_SPEED AS FLOAT = 8.0
    DIM hp AS INTEGER
    DIM name AS STRING
    SUB Init()
        Self.hp = Player.MAX_HP
        Self.name = Player.DEFAULT_NAME
    END SUB
END CLASS

CLASS Game
    STATIC CONST SCREEN_W AS INTEGER = 800
    STATIC CONST SCREEN_H AS INTEGER = 600
    STATIC CONST FPS AS INTEGER = 60
    STATIC CONST DEBUG AS BOOLEAN = TRUE
END CLASS

DIM p AS Player
p = NEW Player()

PRINT "=== Class-Konstanten direkt zugreifbar ==="
PRINT "Player.MAX_HP       =", Player.MAX_HP
PRINT "Player.DEFAULT_NAME =", Player.DEFAULT_NAME
PRINT "Player.WALK_SPEED   =", Player.WALK_SPEED
PRINT "Player.RUN_SPEED    =", Player.RUN_SPEED

PRINT ""
PRINT "=== Init() benutzt Statics ==="
PRINT "p.hp   =", p.hp
PRINT "p.name =", p.name

PRINT ""
PRINT "=== Game-Cfg ==="
PRINT "Game.SCREEN_W =", Game.SCREEN_W
PRINT "Game.SCREEN_H =", Game.SCREEN_H
PRINT "Game.FPS      =", Game.FPS
IF Game.DEBUG THEN
    PRINT "DEBUG-Modus an"
ELSE
    PRINT "Release-Modus"
END IF

PRINT ""
PRINT "=== Negative Konstanten ==="

CLASS Bounds
    STATIC CONST MIN_X AS INTEGER = -100
    STATIC CONST MAX_X AS INTEGER = 100
END CLASS

PRINT "Bounds:", Bounds.MIN_X, "..", Bounds.MAX_X
