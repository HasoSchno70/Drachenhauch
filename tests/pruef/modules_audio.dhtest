--- erwartet
AUDIO_PITCH: faktor muss > 0 sein
AUDIO_MUSIC_PITCH: faktor muss > 0 sein

=== sample type compiles
IMPORT "audio"
DIM s AS SAMPLE
PRINT "sample-typ ok"
--- erwartet
sample-typ ok

=== lofi validation
IMPORT "audio"
TRY
    AUDIO_LOFI(TRUE, 99)
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_LOFI(TRUE, 8, -1.0)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_LOFI: bits muss 1..16 sein
AUDIO_LOFI: cutoff_hz muss >= 0 sein

=== bus volume validation
IMPORT "audio"
TRY
    AUDIO_BUS_VOLUME("foo", 0.5)
CATCH e
    PRINT e
END TRY
TRY
    PRINT STR$(AUDIO_BUS_GET_VOLUME("bar"))
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_BUS_VOLUME: unbekannter Bus 'foo' (sfx, music, master, speech)
AUDIO_BUS_GET_VOLUME: unbekannter Bus 'bar' (sfx, music, master, speech)

=== bus effects validation
IMPORT "audio"
TRY
    AUDIO_FILTER("nope", 1000, 0.5)
CATCH e
    PRINT e
END TRY
TRY
