zurueck: blau 0 ebenen 4
linie gerade: TRUE -1
stift: TRUE art 1
radiert: FALSE
pipette: 1 1
gefuellt: 1600 schritte +1
fuellen zurueck: 68
gesperrt: TRUE
geloescht: ebenen 3 blau 0
zurueckgeholt: ebenen 4 blau 68
deckkraft 0.5 geaendert TRUE
gesichert: TRUE geaendert FALSE titel Demo Kreuzstich
geladen: ebenen 4 farben 7 stiche 253 = 253
zelle 5,4: TRUE DMC 996
nach zurueck TRUE
nach vor FALSE
ebene umbenannt: TRUE
oben Ebene umbenennen liste Blau  (68)
blau im rechteck: TRUE
blau nach zurueck: 0
blau wieder: TRUE
halb: rein TRUE gemischt TRUE

=== glutfaden stufe 3 auswahl vieleck rueckstich fortschritt text
' Auswahl (nur die aktive Ebene) kopieren, einfuegen, verschieben (ein
' Schritt), drehen, loeschen; gefuelltes Vieleck; vierfache Symmetrie;
' Rueckstiche setzen, rechts entfernen, zurueck; Fortschritt ziehen, Pfeil und
' Enter; Text ohne Dialog; seltene Farben; sichern und laden (Rueckstiche und
' erledigt kommen mit). Bilder: das Blau des Texts, die gruenen Haken.
IMPORT "helfer.dh"
dlStarten(["run", BEISPIEL, "--", "--probe-stufe3", "--foto", "d"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    PRINT "text blau: "; punkte("d_text.png", &H0097E1) > 1500
    ' gruen gibt es vorher schon an den Kanten der blauen Rueckstiche ueber Gelb
    PRINT "haken: "; gruenePunkte("d_fortschritt.png") - gruenePunkte("d_rueckstich.png") > 400
END IF
--- datei helfer.dh
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_bild.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- erwartet
