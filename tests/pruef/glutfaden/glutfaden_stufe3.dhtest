=== auswahl kopieren einfuegen verschieben drehen spiegeln
IMPORT "k.dh"
DIM m AS kern.Muster : m = neuesTestmuster()
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM n AS INTEGER
' ein L aus drei Zellen mit Teilstichen: (1,1) Viertel oben links, (1,2) und (2,2) voll
DIM ok AS BOOLEAN
ok = kern.stichSetzen(m, v, 1, 1, 0, kern.VIERTEL_OL)
ok = kern.stichSetzen(m, v, 1, 2, 0, kern.VOLL)
ok = kern.stichSetzen(m, v, 2, 2, 0, kern.HALB_OL_UR)
PRINT bild$(m)
DIM a AS kern.Auswahl : a = kern.auswahlRechteck(6, 5, 1, 1, 2, 2)
PRINT "auswahl "; a.anzahl; " "; a.x0; ","; a.y0; "-"; a.x1; ","; a.y1
DIM s AS kern.Ausschnitt : s = kern.ausschnittVon(m.ebenen.aktiveEbene(), a)
PRINT "ausschnitt "; s.breite; "x"; s.hoehe; " stiche "; s.stiche()
' einfuegen an (3, 2): nur Zellen mit Stich, die leere laesst stehen
ok = kern.stichSetzen(m, v, 4, 2, 1, kern.VOLL)
n = kern.ausschnittSetzen(m, v, NIL, s, 3, 2, "Einfügen")
PRINT "eingefuegt "; n; " schritte "; LEN(v.rueck)
PRINT bild$(m)
ok = v.zurueckNehmen(m)
' verschieben um (2, 1): alte Zellen weg, neue da, ein Schritt
n = kern.ausschnittSetzen(m, v, a, s, 3, 2, "Verschieben")
PRINT "verschoben "; n; " oben "; v.textZurueck$()
PRINT bild$(m)
ok = v.zurueckNehmen(m)
PRINT "zurueck"
PRINT bild$(m)
' im Uhrzeigersinn drehen: (x, y) -> (h-1-y, x), Viertel oben links -> oben rechts
DIM d AS kern.Ausschnitt : d = kern.ausschnittGedreht(s, TRUE)
n = kern.ausschnittSetzen(m, v, a, d, 1, 1, "Drehen")
PRINT "gedreht"
PRINT bild$(m)
ok = v.zurueckNehmen(m)
d = kern.ausschnittGedreht(kern.ausschnittGedreht(kern.ausschnittGedreht(kern.ausschnittGedreht(s, TRUE), TRUE), TRUE), TRUE)
PRINT "viermal gedreht gleich: "; ausschnittGleich(d, s)
PRINT "rechts und links gleich: "; ausschnittGleich(kern.ausschnittGedreht(kern.ausschnittGedreht(s, TRUE), FALSE), s)
' waagerecht spiegeln: Halbstich kippt
d = kern.ausschnittGespiegelt(s, TRUE)
n = kern.ausschnittSetzen(m, v, a, d, 1, 1, "Spiegeln")
PRINT "gespiegelt"
PRINT bild$(m)
ok = v.zurueckNehmen(m)
' loeschen und fuellen
n = kern.zellenSetzen(m, v, a.zellen(), -1, kern.VOLL, "Löschen")
PRINT "geloescht "; n
n = kern.zellenSetzen(m, v, a.zellen(), 1, kern.VOLL, "Füllen")
PRINT "gefuellt "; n; " (Perlenfarbe)"
PRINT bild$(m)
' gesperrte Ebene: nichts
WHILE v.zurueckNehmen(m) : WEND
m.ebenen.aktiveEbene().gesperrt = TRUE
PRINT "gesperrt "; kern.ausschnittSetzen(m, v, a, s, 3, 2, "Verschieben")
' Lasso und verschobene Auswahl
DIM l AS kern.Auswahl : l = kern.auswahlLasso(6, 5, [0, 0, 5, 0, 0, 4])
PRINT "lasso "; l.anzahl; " rechteck "; l.istRechteck
DIM w AS kern.Auswahl : w = kern.auswahlVerschoben(l, 3, 0)
PRINT "verschoben "; w.anzahl; " "; w.x0; "-"; w.x1
