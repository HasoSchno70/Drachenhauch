=== print in der schleife mit trennern
DIM i AS INTEGER
DIM s AS FLOAT
DIM t AS STRING
FOR i = 1 TO 4
    s = s + SQR(i)
    t = t + CHR$(64 + i)
    PRINT i; " "; s, t; "|"
    PRINT i, i * 2, i * 0.5
    PRINT
    PRINT "ende"; i;
NEXT
PRINT
--- umgebung
DHRT_JIT=aus
