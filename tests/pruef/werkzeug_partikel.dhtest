    IF k = 34 THEN prMerke("z wie vorher " + prJa$(INT(p(P_GY)) = prMerk) + " uPos " + STR$(uPos))
    IF k = 46 THEN prMerke("y bewegt " + prJa$(INT(p(P_GY)) <> prMerk) + " uPos " + STR$(uPos))
END SUB
