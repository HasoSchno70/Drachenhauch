' ============================================================
'  DRACHENHAUCH STUDIO
' ============================================================
'  Eine IDE fuer Programme mit Oberflaeche, im Stil von Xojo, mit der
'  Laufzeit dhrt. Entwurf: docs/intern/entwurf-studio.md. Stufe 1: das Fenster
'  entwerfen -- Bibliothek mit Sinnbildern, Entwurfsflaeche mit Griffen,
'  Ausrichtungslinien und Rueckgaengig, Inspektor mit Gruppen und echten
'  Editoren, Navigator. Stufe 2: Projekte als Ordner, mehrere Fenster,
'  Module und Klassen, Ereignisse und ein Code-Feld je Methode. Starten
'  folgt in Stufe 3.
'
'  Aufruf:  dhrt run studio/studio.dh [-- projektordner | fenster.dhform]
'  Test:    DH_STUDIO_LOG=<datei> protokolliert die Ereignisse zeilenweise.
' ============================================================
IMPORT "gui"
IMPORT "json"
IMPORT "regex"
IMPORT "imgfx"
IMPORT "db"
IMPORT "pdf"
IMPORT "chart"

DIM logDatei AS STRING : logDatei = GETENV$("DH_STUDIO_LOG")
' Gesammelt und einmal je Bild geschrieben: die Lagen aller Controls sind bei
' einem grossen Fenster Tausende Zeilen je Aenderung, und jede einzeln die
' Datei oeffnen kostete mehr als das Studio selbst.
DIM logPuffer AS ARRAY OF STRING : logPuffer = []
SUB protokoll(text AS STRING)
    IF logDatei = "" THEN RETURN
    ARRAY_PUSH(logPuffer, text)
END SUB

SUB protokollSchreiben()
    IF LEN(logPuffer) = 0 THEN RETURN
    APPENDFILE(logDatei, JOIN$(logPuffer, CHR$(10)) + CHR$(10))
    logPuffer = []
END SUB

IMPORT "sprache.dh"
IMPORT "modell.dh"
IMPORT "projekt.dh"
IMPORT "datenbank.dh"
IMPORT "berichte_laufzeit.dh"
IMPORT "berichte.dh"
IMPORT "bibliothek.dh"
IMPORT "entwurf.dh"
IMPORT "inspektor.dh"
IMPORT "oberflaeche.dh"
IMPORT "code.dh"
IMPORT "dbeditor.dh"
IMPORT "berichte_reiter.dh"
IMPORT "erzeugen.dh"
IMPORT "menue.dh"
IMPORT "debug.dh"
IMPORT "vervoll.dh"

' Fuer Pruefungen: DH_STUDIO_GROESSE=BxH haelt das Fenster fest (sonst haengen
' alle Lagen am Bildschirm), DH_STUDIO_AUFNAHME spielt eine Aufnahme ab,
' DH_STUDIO_ABLAGE legt Text in die Zwischenablage (zum Tippen per Strg+V).
DIM festeGroesse AS STRING : festeGroesse = GETENV$("DH_STUDIO_GROESSE")
DIM schirmB AS INTEGER : schirmB = 1440
DIM schirmH AS INTEGER : schirmH = 900
IF INSTR(festeGroesse, "x") > 0 THEN
    schirmB = INT(VAL(LEFT$(festeGroesse, INSTR(festeGroesse, "x"))))
    schirmH = INT(VAL(MID$(festeGroesse, INSTR(festeGroesse, "x") + 1, 10)))
END IF
SCREEN(schirmB, schirmH, tr$("Drachenhauch Studio"), 1)
WINDOW_RESIZABLE(TRUE)
WINDOW_MIN_SIZE(1100, 700)
SETFPS(60)
IF festeGroesse = "" THEN WINDOW_MAXIMIZE()

' Eine Schrift fuer die Oberflaeche UND fuer das, was das Studio selbst
' zeichnet (Titelleiste, Masse) -- TEXT bliebe sonst bei der Pixelschrift.
DIM sans AS INTEGER : sans = LOADFONT("sans", 32, "×…–")
GUI_FONT(sans, 15)
SETFONT(sans, 14)
themaSetzen()

bausteineAnlegen()
oberflaecheAnlegen()

' Der Mittelgrund mit Punkten: ein Bereich im Hauptfenster (gezeichnet unter
' dem Entwurfsfenster), die Punkte nur ausserhalb des Entwurfsfensters.
DIM mittePanel AS GUI_WIDGET : mittePanel = GUI_PANEL(win, 0, 0, 10, 10)
GUI_ADD_CLASS(mittePanel, "mitte")
DIM punkteX AS ARRAY OF INTEGER : punkteX = []
DIM punkteY AS ARRAY OF INTEGER : punkteY = []
DIM punkteX2 AS ARRAY OF INTEGER : punkteX2 = []
DIM punkteY2 AS ARRAY OF INTEGER : punkteY2 = []
DIM punkteFuer AS STRING : punkteFuer = ""

SUB mitteNachziehen()
    GUI_SET_BOUNDS(mittePanel, mitteX, mitteY - inhaltOben, mitteB, mitteH)
    GUI_SET_COLOR(mittePanel, "bg", farbe("mitte"))
    GUI_SET_COLOR(mittePanel, "border", farbe("mitte"))
END SUB

' Die Punkte im Mittelgrund, nur neu gerechnet, wenn sich Lage oder Groesse
' aendern -- je Bild waeren es einige tausend Rechnungen.
SUB punkteRechnen()
    DIM schluessel AS STRING : schluessel = STR$(mitteX) + "," + STR$(mitteY) + "," + STR$(mitteB) + "," + STR$(mitteH) + "," + STR$(formX) + "," + STR$(formY) + "," + STR$(zS(fensterB())) + "," + STR$(zS(fensterH()))
    IF schluessel = punkteFuer THEN RETURN
    punkteFuer = schluessel
    punkteX = [] : punkteY = [] : punkteX2 = [] : punkteY2 = []
    DIM x1 AS INTEGER : x1 = formX - 18
    DIM y1 AS INTEGER : y1 = formY - kopfH() - 18
    DIM x2 AS INTEGER : x2 = formX + zS(fensterB()) + 18
    DIM y2 AS INTEGER : y2 = formY + zS(fensterH()) + 28
    DIM y AS INTEGER
    DIM x AS INTEGER
    FOR y = mitteY + 12 TO mitteY + mitteH - 4 STEP 20
        FOR x = mitteX + 12 TO mitteX + mitteB - 4 STEP 20
            IF x >= x1 AND x <= x2 AND y >= y1 AND y <= y2 THEN CONTINUE
            ARRAY_PUSH(punkteX, x) : ARRAY_PUSH(punkteY, y)
            ARRAY_PUSH(punkteX2, x + 1) : ARRAY_PUSH(punkteY2, y + 1)
        NEXT
    NEXT
END SUB

' --- Datei ------------------------------------------------------------------
' Ein neues Projekt im Speicher; gesichert wird es in einen Ordner.
SUB projektAnfangen(ordner AS STRING)
    alleReiterZu()
    projektNeu(ordner)
    nachLaden()
    unberuehrt()
    status(IIF(ordner = "", tr$("Neues Projekt. Bausteine aus der Bibliothek ins Fenster ziehen."), trf$("Neues Projekt in {0}.", [ordner])))
    protokoll("neu-fenster")
    protokoll("neues projekt " + projName)
END SUB

' Ein neues Projekt, an dem noch niemand etwas getan hat, ist nicht
' "geaendert": Neu, Oeffnen und Beenden fragen dann nicht -- es geht nichts
' verloren. Gesichert wird trotzdem alles (projektSchreiben schreibt jedes
' Element), und F5 sichert, solange es keinen Ordner hat.
SUB unberuehrt()
    projGeaendert = FALSE
    geaendert = FALSE
    DIM e AS Element
    FOR EACH e IN elemente
        e.geaendert = FALSE
    NEXT
    werkzeugeNachziehen()
END SUB

' Ein neues Projekt aus einer Vorlage: geladen wie ein Projekt, aber ohne
' Ordner -- die Vorlage selbst wird nie ueberschrieben, Sichern fragt.
SUB projektAusVorlage(ordner AS STRING, titel AS STRING)
    alleReiterZu()
    DIM fehler AS STRING : fehler = projektLaden$(ordner)
    IF fehler <> "" THEN
        status(trf$("Die Vorlage geht nicht auf: {0}", [fehler]))
        projektAnfangen("")
        RETURN
    END IF
    projOrdner = ""
    DIM e AS Element
    FOR EACH e IN elemente
        e.gesichertAls = ""
    NEXT
    nachLaden()
    unberuehrt()
    status(trf$("Neues Projekt aus der Vorlage {0}. F5 startet es; Sichern fragt nach einem Ordner.", [CHR$(34) + titel + CHR$(34)]))
    protokoll("neues projekt aus vorlage " + BASENAME(ordner))
END SUB

' Ein einzelnes .dhform ohne Projekt (so arbeitete Stufe 1). Sobald etwas
' dazukommt, das nur ein Projekt kennt, fragt Sichern nach einem Ordner.
SUB fensterLaden(pfad AS STRING)
    alleReiterZu()
    projektLeeren()
    projLose = TRUE
    projOrdner = ""
    DIM name AS STRING : name = REGEX_REPLACE(BASENAME(pfad), "(?i)\.dhform$", "")
    IF NOT istBezeichner(name) THEN name = tr$("Fenster1")
    DIM e AS Element : e = elementNeu("fenster", name)
    projName = name
    formPfad = pfad
    IF FILEEXISTS(pfad) THEN
        DIM d AS JSON_HANDLE : d = JSON_LOAD(pfad)
        IF NOT JSON_HAS(d, "widgets") THEN JSON_SET_JSON(d, "widgets", JSON_NEW_ARRAY())
        IF NOT JSON_HAS(d, "name") THEN JSON_SET_STRING(d, "name", name)
        IF istBezeichner(JSON_GET_STRING(d, "name")) THEN e.name = JSON_GET_STRING(d, "name") ELSE JSON_SET_STRING(d, "name", name)
        e.layout = JSON_STRINGIFY(d)
        DIM cp AS STRING : cp = REGEX_REPLACE(pfad, "(?i)\.dhform$", ".dh")
        IF FILEEXISTS(cp) THEN codeZerlegen(e, JOIN$(READLINES(cp), CHR$(10)))
    END IF
    projStart = e.name
    e.geaendert = FALSE
    projGeaendert = FALSE
    nachLaden()
    ' Controls ohne Namen bekommen einen -- er wird zum Feld der Klasse.
    DIM i AS INTEGER
    DIM ohne AS BOOLEAN : ohne = FALSE
    FOR i = 0 TO anzahl() - 1
        IF feldText$(i, "name") = "" THEN
            JSON_SET_STRING(doc, wz$(i, "name"), eindeutigerName$(feldText$(i, "kind")))
            ohne = TRUE
        END IF
    NEXT
    IF ohne THEN
        staende = [] : standPos = -1 : merken() : geaendert = FALSE
        nachAenderung(FALSE)
    END IF
    IF FILEEXISTS(pfad) THEN
        status(trf$("Geladen: {0} ({1} Controls)", [BASENAME(pfad), STR$(anzahl())]))
        protokoll("geladen " + STR$(anzahl()))
    ELSE
        status(trf$("Neu: {0}", [pfad]))
        protokoll("neu-fenster")
    END IF
END SUB

SUB projektOeffnen(ordner AS STRING)
    alleReiterZu()
    DIM fehler AS STRING : fehler = projektLaden$(ordner)
    IF fehler <> "" THEN
        status(fehler)
        protokoll("fehler " + fehler)
        projektNeu(ordner)
    END IF
    nachLaden()
    status(trf$("Projekt {0}: {1} Elemente, {2} Methoden.", [projName, STR$(LEN(elemente)), STR$(LEN(methoden))]))
    DIM dbf AS STRING : dbf = datenbankenAbgleichen$()
    IF dbf <> "" THEN
        status(dbf)
        protokoll("db fehler " + dbf)
    END IF
    protokoll("projekt geladen " + projName + " " + STR$(LEN(elemente)) + " " + STR$(LEN(methoden)))
END SUB

' Nach Laden oder Anlegen: das Startfenster vorn.
SUB nachLaden()
    aktFenster = -1
    staende = [] : standPos = -1
    DIM s AS INTEGER : s = elementIndex(projStart)
    IF s >= 0 THEN
        IF elemente[s].art <> "fenster" THEN s = -1
    END IF
    IF s < 0 THEN
        DIM k AS INTEGER
        FOR k = 0 TO LEN(elemente) - 1
            IF elemente[k].art = "fenster" THEN
                s = k
                BREAK
            END IF
        NEXT
    END IF
    navigatorFuellen()
    IF s >= 0 THEN layoutOeffnen(s)
    auswahlSetzen(-1)
    auswahlGeaendert()
    lageAnzeigen()
    werkzeugeNachziehen()
END SUB

SUB alleReiterZu()
    WHILE LEN(reiter) > 0
        reiterSchliessen(LEN(reiter) - 1)
    WEND
    wegDateien = []
END SUB

' Ein lose geoeffnetes Fenster ohne Code bleibt eine .dhform -- alles andere
' ist ein Projekt.
FUNCTION nurDasFenster() AS BOOLEAN
    IF NOT projLose OR LEN(elemente) <> 1 OR LEN(methoden) > 0 THEN RETURN FALSE
    RETURN elemente[0].dekl = ""
END FUNCTION

FUNCTION sichern(alsNeu AS BOOLEAN) AS BOOLEAN
    DIM r AS Reiter
    FOR EACH r IN reiter
        codeUebernehmen(r)
    NEXT
    layoutZurueck()
    IF nurDasFenster() AND NOT alsNeu THEN
        IF formPfad = "" THEN
            DIM p AS STRING : p = FILE_SAVE_DIALOG(tr$("Fenster sichern"), fensterText$("name") + ".dhform", "dhform")
            IF p = "" THEN RETURN FALSE
            IF LOWER$(RIGHT$(p, 7)) <> ".dhform" THEN p = p + ".dhform"
            formPfad = p
        END IF
        WRITEALL(formPfad, JSON_PRETTY(doc))
        geaendert = FALSE
        elemente[0].geaendert = FALSE
        projGeaendert = FALSE
        werkzeugeNachziehen()
        status(trf$("Gesichert: {0}", [BASENAME(formPfad)]))
        protokoll("gesichert " + formPfad)
        RETURN TRUE
    END IF
    IF projOrdner = "" OR alsNeu THEN
        ' Fuer Pruefungen: DH_STUDIO_ORDNER statt des Dialogs.
        DIM o AS STRING : o = GETENV$("DH_STUDIO_ORDNER")
        IF o = "" THEN o = FOLDER_DIALOG(tr$("Ordner für das Projekt"))
        IF o = "" THEN RETURN FALSE
        projOrdner = o
        projName = BASENAME(o)
        DIM e AS Element
        FOR EACH e IN elemente
            e.gesichertAls = ""
        NEXT
    END IF
    IF projLose THEN
        projLose = FALSE
        IF elementIndex("App") < 0 THEN
            DIM a AS Element : a = elementNeu("app", "App")
        END IF
    END IF
    wegDateienLoeschen()
    projektSchreiben()
    ' Die Entwicklungsdaten gibt es erst mit einem Ordner.
    DIM dbf AS STRING : dbf = datenbankenAbgleichen$()
    IF dbf <> "" THEN protokoll("db fehler " + dbf)
    geaendert = FALSE
    navigatorFuellen()
    werkzeugeNachziehen()
    status(trf$("Gesichert: {0} ({1} Elemente)", [projName, STR$(LEN(elemente))]))
    protokoll("gesichert " + projOrdner)
    RETURN TRUE
END FUNCTION

' Neu, Oeffnen und Beenden fragen bei Ungesichertem; `wartet` merkt, was
' nach der Antwort geschehen soll.
DIM frage AS GUI_WINDOW : frage = -1
DIM wartet AS STRING : wartet = ""
DIM beenden AS BOOLEAN : beenden = FALSE

SUB ausfuehren(was AS STRING)
    SELECT CASE was
        CASE "neu" : vorlageDialog()
        CASE "oeffnen"
            DIM p AS STRING : p = FILE_OPEN_DIALOG(tr$("Projekt oder Fenster öffnen"), "dhstudio,dhform")
            IF p <> "" THEN
                IF LOWER$(RIGHT$(p, 7)) = ".dhform" THEN fensterLaden(p) ELSE projektOeffnen(DIRNAME(p))
            END IF
        CASE "beenden" : beenden = TRUE
    END SELECT
END SUB

SUB anfragen(was AS STRING)
    IF frage >= 0 OR GUI_MODAL() THEN RETURN
    IF NOT projektGeaendert() THEN
        ausfuehren(was)
        RETURN
    END IF
    wartet = was
    frage = GUI_DIALOG(tr$("Ungesicherte Änderungen"), trf$("{0} ist nicht gesichert.", [IIF(projLose, trf$("Das Fenster {0}", [fensterText$("name")]), trf$("Das Projekt {0}", [projName]))]), tr$("Sichern|Verwerfen|Abbrechen"))
END SUB

SUB frageAuswerten()
    IF frage < 0 THEN RETURN
    DIM a AS INTEGER : a = GUI_ANSWER(frage)
    IF a = 0 THEN RETURN
    frage = -1
    IF a = 1 THEN
        IF NOT sichern(FALSE) THEN RETURN
    ELSEIF a = 3 THEN
        wartet = ""
        RETURN
    END IF
    ausfuehren(wartet)
    wartet = ""
END SUB

DIM ueber AS GUI_WINDOW : ueber = -1
SUB ueberZeigen()
    IF ueber >= 0 THEN GUI_WINDOW_DESTROY(ueber)
    ueber = GUI_DIALOG(tr$("Drachenhauch Studio"), trf$("Eine IDE für Programme mit Oberfläche, mit der Laufzeit dhrt {0}.{1}Fenster entwerfen, Ereignisse und Code je Methode, prüfen, starten, debuggen und bauen.", [VERSION$(), CHR$(10)]), "ok")
END SUB

' --- Menue und Werkzeugleiste -------------------------------------------------
SUB befehle()
    DIM t AS INTEGER : t = GUI_TOOLBAR_CLICKED(tb)
    IF GUI_CLICKED(miNeu) OR t = tbNeu THEN anfragen("neu")
    IF GUI_CLICKED(miOeffnen) OR t = tbOeffnen THEN anfragen("oeffnen")
    IF GUI_CLICKED(miSichern) OR t = tbSichern THEN sichern(FALSE)
    IF GUI_CLICKED(miSichernUnter) THEN sichern(TRUE)
    IF GUI_CLICKED(miBeenden) THEN anfragen("beenden")
    IF GUI_CLICKED(miZurueck) OR t = tbZurueck THEN zurueck()
    IF GUI_CLICKED(miVor) OR t = tbVor THEN vor()
    IF berichtVorn() THEN
        ' Ein Bericht hat seine eigene Auswahl (berichte_reiter.dh).
        IF GUI_CLICKED(miVerdoppeln) THEN berichtVerdoppeln()
        IF GUI_CLICKED(miLoeschen) THEN berichtLoeschen()
        IF GUI_CLICKED(miAlles) THEN berichtAllesWaehlen()
    ELSE
        IF GUI_CLICKED(miVerdoppeln) AND auswahl >= 0 THEN controlsVerdoppeln() : nachAenderung(TRUE) : protokoll("verdoppelt")
        IF GUI_CLICKED(miLoeschen) AND (auswahl >= 0 OR trayWahl >= 0 OR abstandL >= 0) THEN loeschen()
        IF GUI_CLICKED(miAlles) THEN allesWaehlen() : auswahlGeaendert()
    END IF
    IF t = tbLinks THEN anordnen("links")
    IF t = tbOben THEN anordnen("oben")
    IF t = tbMitteW THEN anordnen("mitte_w")
    IF t = tbVerteilen THEN anordnen("vert_w")
    IF GUI_CLICKED(miGroesser) OR t = tbGroesser THEN zoomStufe(1)
    IF GUI_CLICKED(miKleiner) OR t = tbKleiner THEN zoomStufe(-1)
    IF GUI_CLICKED(miNormal) OR GUI_STATUSBAR_CLICKED(sb) = 2 THEN zoomStufe(0)
    IF GUI_CLICKED(miRaster) THEN rasterAn = GUI_MENU_CHECKED(miRaster)
    IF GUI_CLICKED(miLinien) THEN linienAn = GUI_MENU_CHECKED(miLinien)
    IF GUI_CLICKED(miHell) THEN
        hell = GUI_MENU_CHECKED(miHell)
        themaSetzen()
        codeFarbenNeu()
        mitteNachziehen()
        punkteFuer = ""
    END IF
    IF GUI_CLICKED(miSprache) THEN spracheWechseln()
    IF GUI_CLICKED(miUeber) THEN ueberZeigen()
    IF GUI_CLICKED(miStarten) OR t = tbStart THEN starten()
    IF GUI_CLICKED(miAnhalten) OR t = tbStopp THEN anhalten()
    IF GUI_CLICKED(miBauen) OR t = tbBauen THEN bauen()
    IF GUI_CLICKED(miMenues) THEN menueEditor()
    IF GUI_CLICKED(miDebug) THEN debuggen()
    IF GUI_CLICKED(miSchritt) AND dbgHaelt THEN dbgKommando("step-over")
    IF GUI_CLICKED(miHinein) AND dbgHaelt THEN dbgKommando("step-into")
    IF GUI_CLICKED(miHeraus) AND dbgHaelt THEN dbgKommando("step-out")
    IF GUI_CLICKED(miHaltepunkt) THEN haltepunktAnDerMarke()
    IF GUI_CLICKED(miBildNeu) THEN bildHinzufuegen()
    IF GUI_CLICKED(miPruefen) OR t = tbPruefen THEN
        DIM pf AS INTEGER : pf = projektPruefen()
        GUI_DOCK_ACTIVATE(win, "probleme")
        status(IIF(LEN(befunde) = 0, tr$("Keine Probleme."), trf$("{0} Fehler, {1} Warnungen.", [STR$(pf), STR$(LEN(befunde) - pf)])))
    END IF
    IF GUI_CLICKED(lstProbleme) THEN befundAnspringen(GUI_LISTBOX_SELECTED(lstProbleme))
    IF GUI_CLICKED(miFensterNeu) OR t = tbFenster THEN elementFragen("fenster")
    IF GUI_CLICKED(miControlNeu) THEN elementFragen("control")
    IF GUI_CLICKED(miModulNeu) THEN elementFragen("modul")
    IF GUI_CLICKED(miKlasseNeu) THEN elementFragen("klasse")
    IF GUI_CLICKED(miDatenbankNeu) THEN elementFragen("datenbank")
    IF GUI_CLICKED(miDatenbankDatei) THEN datenbankUebernehmenFragen()
    IF GUI_CLICKED(miBerichtNeu) THEN elementFragen("bericht")
    IF GUI_CLICKED(miMethodeNeu) OR t = tbMethode THEN methodeDialog(elementJetzt())
    IF GUI_CLICKED(miEreignisNeu) OR t = tbEreignis THEN
        IF layoutVorn() THEN ereignisDialog(aktFenster, auswahl) ELSE ereignisDialog(elementJetzt(), -1)
    END IF
    IF GUI_CLICKED(miMethodeWeg) THEN methodeEntfernen()
    IF GUI_CLICKED(miStartfenster) THEN alsStartSetzen(elementJetzt())
    IF GUI_CLICKED(miElementWeg) THEN elementLoeschenFragen(elementJetzt())
    DIM k AS INTEGER
    FOR k = 0 TO LEN(anordnenPunkte) - 1
        IF GUI_CLICKED(anordnenPunkte[k]) THEN anordnen(anordnenWas[k])
    NEXT
END SUB

SUB zurueck()
    IF berichtVorn() THEN
        berichtZurueck()
        RETURN
    END IF
    IF NOT kannZurueck() THEN RETURN
    standPos = standPos - 1
    doc = JSON_PARSE(staende[standPos])
    auswahlBereinigen()
    nachAenderung(FALSE)
    geaendert = TRUE
    werkzeugeNachziehen()
    protokoll("rueckgaengig " + STR$(anzahl()))
END SUB

SUB vor()
    IF berichtVorn() THEN
        berichtVor()
        RETURN
    END IF
    IF NOT kannVor() THEN RETURN
    standPos = standPos + 1
    doc = JSON_PARSE(staende[standPos])
    auswahlBereinigen()
    nachAenderung(FALSE)
    geaendert = TRUE
    werkzeugeNachziehen()
    protokoll("wiederholen " + STR$(anzahl()))
END SUB

SUB loeschen()
    IF abstandL >= 0 THEN
        DIM ln AS STRING : ln = feldText$(abstandL, "name")
        abstandEntfernen(abstandL, abstandK)
        auswahlSetzen(-1)
        nachAenderung(TRUE)
        status(trf$("Abstandhalter aus {0} gelöscht.", [ln]))
        protokoll("geloescht abstand " + ln)
        RETURN
    END IF
    IF trayWahl >= 0 THEN
        DIM tn AS STRING : tn = timerName$(trayWahl)
        JSON_REMOVE(doc, "timer." + STR$(trayWahl))
        trayWahl = -1
        nachAenderung(TRUE)
        status(trf$("Timer gelöscht: {0}", [tn]))
        protokoll("geloescht timer " + tn)
        RETURN
    END IF
    DIM n AS INTEGER : n = LEN(gewaehlt)
    controlsLoeschen()
    nachAenderung(TRUE)
    status(IIF(n = 1, tr$("1 Control gelöscht."), trf$("{0} Controls gelöscht.", [STR$(n)])))
    protokoll("geloescht " + STR$(n))
END SUB

' Tasten, die das Entwurfsfenster meinen -- nur, wenn kein Eingabefeld den
' Fokus hat (sonst gehoeren Pfeile und Esc dem Feld).
SUB tasten()
    DIM fokus AS GUI_WIDGET : fokus = GUI_FOCUSED()
    IF fokus >= 0 THEN
        DIM art AS STRING : art = GUI_KIND(fokus)
        IF art = "textinput" OR art = "textarea" OR art = "spinner" OR art = "dropdown" THEN RETURN
    END IF
    IF GUI_MODAL() OR NOT layoutVorn() THEN RETURN
    DIM schritt AS INTEGER : schritt = IIF(umschalt(), RASTER, 1)
    IF NOT strg() THEN
        IF KEYREPEAT(KEY_LEFT) THEN schieben(-schritt, 0)
        IF KEYREPEAT(KEY_RIGHT) THEN schieben(schritt, 0)
        IF KEYREPEAT(KEY_UP) THEN schieben(0, -schritt)
        IF KEYREPEAT(KEY_DOWN) THEN schieben(0, schritt)
    END IF
    IF strg() AND KEYHIT(KEY_A) THEN allesWaehlen() : auswahlGeaendert()
    IF KEYHIT(KEY_ESCAPE) THEN
        IF bibScharf() THEN
            bibEntschaerfen()
            status(tr$("Abgebrochen."))
        ELSE
            auswahlSetzen(-1)
            auswahlGeaendert()
        END IF
    END IF
END SUB

' --- Start ------------------------------------------------------------------
' Ein Ordner (oder seine projekt.dhstudio) oeffnet das Projekt; ein Ordner
' ohne Projekt bekommt ein neues; eine .dhform geht ohne Projekt auf.
IF ARGC() >= 1 THEN
    DIM startDatei AS STRING : startDatei = ARGPATH$(0)
    IF LOWER$(RIGHT$(startDatei, 7)) = ".dhform" THEN
        fensterLaden(startDatei)
    ELSE
        IF LOWER$(BASENAME(startDatei)) = PROJEKT_DATEI THEN startDatei = DIRNAME(startDatei)
        IF FILEEXISTS(PATHJOIN(startDatei, PROJEKT_DATEI)) THEN projektOeffnen(startDatei) ELSE projektAnfangen(startDatei)
    END IF
ELSE
    projektAnfangen("")
END IF
mitteNachziehen()
protokoll("bereit")
IF GETENV$("DH_STUDIO_ABLAGE") <> "" THEN CLIPBOARD_SET(GETENV$("DH_STUDIO_ABLAGE"))
IF GETENV$("DH_STUDIO_AUFNAHME") <> "" THEN
    IF FILEEXISTS(GETENV$("DH_STUDIO_AUFNAHME")) THEN AUTOMATION_PLAY(GETENV$("DH_STUDIO_AUFNAHME"))
END IF

' Wo Bibliothekszeilen, Inspektorfelder, Leistenknoepfe und das Fenster auf
' dem Schirm liegen -- eine Pruefung liest das aus einem ersten Lauf und
' klickt im zweiten dorthin. Gemessen im dritten Bild: vor dem ersten
' GUI_UPDATE gilt die Stildatei noch nicht, und die Zeilen der Bibliothek
' waeren 22 statt 36 Punkte hoch.
SUB lagenProtokollieren()
    protokoll("lage fenster " + STR$(formX) + " " + STR$(formY))
    protokoll("lage fenstergriff " + STR$(formX + zS(fensterB())) + " " + STR$(formY + zS(fensterH())))
    DIM r AS INTEGER
    FOR r = 0 TO LEN(bibZeile) - 1
        IF bibZeile[r] < 0 THEN CONTINUE
        DIM x AS INTEGER
        DIM y AS INTEGER
        DIM b AS INTEGER
        DIM h AS INTEGER
        (x, y, b, h) = GUI_LISTBOX_ITEM_RECT(lstBib, r)
        IF h > 0 AND y >= GUI_GET_Y(lstBib) + inhaltOben AND y + h <= GUI_GET_Y(lstBib) + GUI_GET_H(lstBib) + inhaltOben THEN
            protokoll("lage zeile " + bausteine[bibZeile[r]].kind + "/" + bausteine[bibZeile[r]].grundname + " " + STR$(x + b \ 2) + " " + STR$(y + h \ 2))
        END IF
    NEXT
    DIM k AS INTEGER
    FOR k = 0 TO GUI_TOOLBAR_COUNT(tb) - 1
        protokoll("lage leiste " + STR$(k) + " " + STR$(GUI_TOOLBAR_ITEM_X(tb, k) + GUI_TOOLBAR_ITEM_W(tb, k) \ 2) + " " + STR$(inhaltOben + LEISTE_H \ 2))
    NEXT
    protokoll("lage suche " + STR$(GUI_GET_X(tfSuche) + 40) + " " + STR$(GUI_GET_Y(tfSuche) + inhaltOben + 12))
    trayProtokollieren()
END SUB

' Die Lage der Inspektorfelder (nach jeder Auswahl neu, darum eine eigene SUB).
SUB felderProtokollieren()
    IF logDatei = "" THEN RETURN
    DIM z AS InspZeile
    FOR EACH z IN inspZeilen
        IF NOT z.sichtbar OR NOT GUI_VISIBLE(z.ed) THEN CONTINUE
        protokoll("lage feld " + z.schluessel + " " + STR$(GUI_GET_X(z.ed) + 30) + " " + STR$(GUI_GET_Y(z.ed) + inhaltOben + 12))
    NEXT
END SUB

' Fuer Pruefungen der Sprache (DH_STUDIO_SPRACHPROBE): Texte der Oberflaeche
' und jedes Dialogs ins Protokoll, dazu die Zahl der Texte ohne Uebersetzung.
' Die Dialoge gehen einer nach dem anderen auf und gleich wieder zu -- jeder
' uebersetzt seine Texte beim Aufbau. "wechseln" schaltet die Sprache um.
' Ein Dialog der Probe wieder zu -- erst nicht mehr modal, sonst nimmt der
' naechste keine Eingabe an.
SUB probeZu(w AS GUI_WINDOW)
    IF w < 0 THEN RETURN
    GUI_WINDOW_MODAL(w, FALSE)
    GUI_WINDOW_DESTROY(w)
END SUB

SUB spracheProbe(was AS STRING)
    IF was = "wechseln" THEN
        spracheWechseln()
        beenden = TRUE
        RETURN
    END IF
    protokoll("probe sprache " + sprache)
    protokoll("probe dhrt_lang [" + GETENV$("DHRT_LANG") + "]")
    protokoll("probe status " + GUI_TEXT(sb))
    protokoll("probe bibliothek " + GUI_LISTBOX_ITEM(lstBib, 0) + " | " + GUI_LISTBOX_ITEM(lstBib, 1))
    protokoll("probe inspektor " + GUI_TEXT(inspKoepfe[0]))
    protokoll("probe name " + elemente[startIndex()].name)
    DIM pj AS JSON_HANDLE : pj = JSON_PARSE(CODE_CHECK$("IF x THEN" + CHR$(10)))
    protokoll("probe pruefen " + JSON_GET_STRING(pj, "0.meldung"))
    ereignisDialog(startIndex(), -1)
    protokoll("probe ereignis " + GUI_TEXT(erText))
    probeZu(dlgEr) : dlgEr = -1
    methodeDialog(startIndex())
    probeZu(dlgMe) : dlgMe = -1
    elementFragen("klasse")
    protokoll("probe element " + STR$(dlgEl >= 0))
    probeZu(dlgEl) : dlgEl = -1
    menueEditor()
    protokoll("probe menue " + GUI_TEXT(mnHinweis))
    probeZu(dlgMn) : dlgMn = -1
    vorlageDialog()
    protokoll("probe vorlagen " + JOIN$(vlTitel, ","))
    protokoll("probe vorlage " + GUI_TEXT(vlText))
    probeZu(dlgVl) : dlgVl = -1
    ueberZeigen()
    probeZu(ueber) : ueber = -1
    protokoll(TRIM$("probe fehlt " + STR$(sprachFehlt) + " " + JOIN$(sprachLuecken, " | ")))
    beenden = TRUE
END SUB

SUB elementOeffnenNach(was AS STRING)
    DIM teile AS ARRAY OF STRING : teile = SPLIT(was, ".")
    DIM ei AS INTEGER : ei = elementIndex(teile[0])
    IF ei < 0 THEN RETURN
    DIM e AS Element : e = elemente[ei]
    IF e.art = "datenbank" THEN
        dbOeffnen(e, IIF(LEN(teile) > 1, teile[LEN(teile) - 1], ""))
    ELSEIF e.art = "bericht" THEN
        berichtOeffnen(e)
    ELSEIF hatLayout(e) THEN
        layoutOeffnen(ei)
    ELSE
        deklOeffnen(e)
    END IF
END SUB

DIM bildNr AS INTEGER : bildNr = 0
DIM warB AS INTEGER : warB = SCREENWIDTH()
DIM warH AS INTEGER : warH = SCREENHEIGHT()
' Fuer Messungen: DH_STUDIO_TEMPO=1 schreibt je Bild, wie lange es gerechnet
' hat (ohne das Warten auf das naechste Bild), als "tempo <ms>" ins Protokoll.
DIM tempoMessen AS BOOLEAN : tempoMessen = GETENV$("DH_STUDIO_TEMPO") <> "" AND logDatei <> ""
DIM tempoAb AS FLOAT : tempoAb = 0.0
WHILE NOT beenden
    IF tempoMessen THEN tempoAb = GET_TIME()
    IF WINDOW_CLOSE_REQUESTED() THEN anfragen("beenden")
    IF QUITREQUESTED() AND NOT WINDOW_CLOSE_REQUESTED() THEN BREAK
    IF SCREENWIDTH() <> warB OR SCREENHEIGHT() <> warH THEN
        warB = SCREENWIDTH() : warH = SCREENHEIGHT()
        GUI_WINDOW_SET_BOUNDS(win, 0, 0, warB, warH)
        dockGroesse()
        verteilen()
        mitteNachziehen()
    END IF
    bibVorUpdate()
    navVorUpdate()
    berichtVorUpdate()
    GUI_UPDATE()
    bildNr = bildNr + 1
    IF bildNr = 3 AND logDatei <> "" THEN lagenProtokollieren() : felderProtokollieren() : controlsProtokollieren()
    IF bildNr = 4 AND GETENV$("DH_STUDIO_SPRACHPROBE") <> "" THEN spracheProbe(GETENV$("DH_STUDIO_SPRACHPROBE"))
    ' Fuer Pruefungen: DH_STUDIO_LOESCHEN=<Element> fragt wie "Element loeschen".
    IF bildNr = 4 AND GETENV$("DH_STUDIO_LOESCHEN") <> "" THEN elementLoeschenFragen(elementIndex(GETENV$("DH_STUDIO_LOESCHEN")))
    ' Fuer Pruefungen: DH_STUDIO_OEFFNEN=<Element>[.<Tabelle>] wie ein Klick im Navigator.
    IF bildNr = 4 AND GETENV$("DH_STUDIO_OEFFNEN") <> "" THEN elementOeffnenNach(GETENV$("DH_STUDIO_OEFFNEN"))
    ' Fuer Pruefungen: DH_STUDIO_UEBERNEHMEN=<datei> wie Projekt -> Datenbank aus Datei uebernehmen.
    IF bildNr = 4 AND GETENV$("DH_STUDIO_UEBERNEHMEN") <> "" THEN datenbankUebernehmen(GETENV$("DH_STUDIO_UEBERNEHMEN"))
    IF controlsNachBild > 0 THEN
        controlsNachBild = controlsNachBild - 1
        IF controlsNachBild = 0 THEN controlsProtokollieren()
    END IF
    IF lagenNachSuche > 0 THEN
        lagenNachSuche = lagenNachSuche - 1
        IF lagenNachSuche = 0 AND logDatei <> "" THEN lagenProtokollieren()
    END IF
    IF GUI_DOCK_CHANGED(win) THEN verteilen() : mitteNachziehen()
    befehle()
    bibNachUpdate()
    navNachUpdate()
    navigatorPruefen()
    inspektorPruefen()
    reiterPruefen()
    tasten()
    berichtTasten()
    mausAufEntwurf()
    berichtMaus()
    frageAuswerten()
    dialogePruefen()
    prozessePruefen()
    debugPruefen()
    vervollPruefen()
    berichtVorschauPruefen()
    ' Das Entwurfsfenster obenauf -- ein Klick ins Hauptfenster legte es
    ' sonst darunter. Dialoge, Menues und Popover liegen weiter oben.
    IF frm >= 0 AND NOT GUI_MODAL() AND layoutVorn() THEN GUI_WINDOW_FRONT(frm)
    vorschauLegen()

    CLS(farbe("mitte"))
    GUI_DRAW(FALSE)
    IF layoutVorn() THEN
        punkteRechnen()
        IF LEN(punkteX) > 0 THEN BOXES(punkteX, punkteY, punkteX2, punkteY2, farbe("punkte"))
    END IF
    entwurfZeichnen()
    IF reiterVorn() >= 0 AND reiterVorn() < LEN(reiter) THEN
        IF reiter[reiterVorn()].art = "bericht" THEN berichtZeichnen(reiter[reiterVorn()])
    END IF
    dialogeObenauf()
    GUI_DRAW_TOP()
    bibZugZeichnen()
    navZugZeichnen()
    IF tempoMessen THEN protokoll("tempo " + FORMAT$((GET_TIME() - tempoAb) * 1000.0, "%.2f"))
    protokollSchreiben()
    FLIP()
WEND
IF lauf >= 0 THEN PROCESS_KILL(lauf)
IF dbgProz >= 0 THEN PROCESS_KILL(dbgProz)
IF bau >= 0 THEN PROCESS_KILL(bau)
protokoll("ende")
protokollSchreiben()
