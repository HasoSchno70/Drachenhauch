=== kreisel und kalendermarken sind zu sehen
' Gezaehlt werden kraeftig magentafarbene Punkte: der Kreisel (Akzent) und
' der Punkt unter dem markierten Tag. Unten die Gegenprobe ohne Marke.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
GUI_THEME_SET("accent", &HFF00FF)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM k AS GUI_WIDGET : k = GUI_BUSY(w, 320, 20, 48)
DIM dp AS GUI_WIDGET : dp = GUI_DATEPICKER(w, 10, 10, 280, 240)
GUI_SET_DATE(dp, "2026-10-15")
GUI_DATE_MARK(dp, "2026-10-20", &H00FF00)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H000000)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=6
DHRT_SCREENSHOT={fall}/bild.png
--- nachher
SCREEN(10, 10, "N", 1)
DIM b AS INTEGER : b = LOADIMAGE("bild.png")
FUNCTION zaehlen(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER, gruen AS BOOLEAN) AS INTEGER
    DIM n AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM c AS INTEGER
    FOR y = y0 TO y1
        FOR x = x0 TO x1
            c = GETPIXEL(b, x, y)
            IF gruen THEN
                IF ((c SHR 8) BAND &HFF) > 200 AND ((c SHR 16) BAND &HFF) < 80 AND (c BAND &HFF) < 80 THEN n = n + 1
            ELSE
                IF ((c SHR 16) BAND &HFF) > 150 AND (c BAND &HFF) > 150 AND ((c SHR 8) BAND &HFF) < 90 THEN n = n + 1
            END IF
        NEXT
    NEXT
    RETURN n
END FUNCTION
PRINT "kreisel " + STR$(zaehlen(318, 18, 370, 70, FALSE) >= 6)
PRINT "tagesmarke " + STR$(zaehlen(10, 60, 290, 250, TRUE) >= 3)
--- erwartet
kreisel TRUE
tagesmarke TRUE

=== der kreisel mit wert ist ein ring, kein balken
' Ein Viertel: der Ring fuellt oben rechts, ein Balken fuellte links.
IMPORT "gui"
SCREEN(200, 120, "T", 1)
GUI_THEME_SET("accent", &HFF00FF)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 200, 120)
GUI_WINDOW_CHROME(w, FALSE)
DIM k AS GUI_WIDGET : k = GUI_BUSY(w, 20, 20, 60)
GUI_PROGRESS_SET(k, "unbestimmt", 0)
GUI_SET_VALUE(k, 0.25)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H000000)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=4
DHRT_SCREENSHOT={fall}/bild.png
--- nachher
SCREEN(10, 10, "N", 1)
DIM b AS INTEGER : b = LOADIMAGE("bild.png")
FUNCTION zaehlen(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER) AS INTEGER
    DIM n AS INTEGER
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM c AS INTEGER
    FOR y = y0 TO y1
        FOR x = x0 TO x1
            c = GETPIXEL(b, x, y)
            IF ((c SHR 16) BAND &HFF) > 150 AND (c BAND &HFF) > 150 AND ((c SHR 8) BAND &HFF) < 90 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
PRINT "oben rechts " + STR$(zaehlen(51, 20, 79, 49) > 20) + " links " + STR$(zaehlen(20, 20, 48, 79) = 0)
--- erwartet
oben rechts TRUE links TRUE

=== tage markieren und wieder freigeben
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM dp AS GUI_WIDGET : dp = GUI_DATEPICKER(w, 10, 10, 280, 180)
GUI_DATE_MARK(dp, "2026-10-20", &H00FF00)
GUI_DATE_MARK(dp, "2026-10-22")
GUI_DATE_UNMARK(dp, "2026-10-22")
PRINT "markiert " + STR$(GUI_DATE_MARKED(dp, "2026-10-20")) + " " + STR$(GUI_DATE_MARKED(dp, "2026-10-22"))
GUI_DATE_CLEAR_MARKS(dp)
PRINT "geleert " + STR$(GUI_DATE_MARKED(dp, "2026-10-20"))
--- erwartet
markiert TRUE FALSE
geleert FALSE

=== groessengruppen machen gleich breit
IMPORT "gui"
SCREEN(400, 300, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(w, "OK", 10, 10, 0, 0)
DIM ab AS GUI_WIDGET : ab = GUI_BUTTON(w, "Abbrechen", 10, 50, 0, 0)
DIM f1 AS GUI_WIDGET : f1 = GUI_TEXTINPUT(w, 10, 90, 100, 28)
DIM f2 AS GUI_WIDGET : f2 = GUI_TEXTINPUT(w, 10, 130, 180, 28)
DIM sp AS GUI_WIDGET : sp = GUI_LAYOUT(w, "spalte", 200, 10, 190, 200)
GUI_LAYOUT_SET(sp, "dehnen", 0)
DIM l1 AS GUI_WIDGET : l1 = GUI_LABEL(w, "Name", 0, 0)
DIM l2 AS GUI_WIDGET : l2 = GUI_LABEL(w, "Postleitzahl", 0, 0)
GUI_LAYOUT_ADD(sp, l1)
GUI_LAYOUT_ADD(sp, l2)
GUI_UPDATE()
PRINT "vorher " + STR$(GUI_GET_W(ok) < GUI_GET_W(ab)) + " " + STR$(GUI_GET_W(f1)) + " " + STR$(GUI_GET_W(l1) < GUI_GET_W(l2))
GUI_SIZE_GROUP(ok, "knoepfe")
GUI_SIZE_GROUP(ab, "knoepfe")
GUI_SIZE_GROUP(f1, "felder", "breite")
GUI_SIZE_GROUP(f2, "felder")
GUI_SIZE_GROUP(l1, "marken")
GUI_SIZE_GROUP(l2, "marken")
GUI_UPDATE()
GUI_UPDATE()
PRINT "knoepfe " + STR$(GUI_GET_W(ok) = GUI_GET_W(ab)) + " felder " + STR$(GUI_GET_W(f1)) + " " + STR$(GUI_GET_W(f2)) + " beschriftungen " + STR$(GUI_GET_W(l1) = GUI_GET_W(l2))
GUI_SIZE_GROUP(ok, "")
GUI_UPDATE()
PRINT "ohne gruppe wieder schmal " + STR$(GUI_GET_W(ok) < GUI_GET_W(ab))
--- erwartet
vorher TRUE 100 TRUE
knoepfe TRUE felder 180 180 beschriftungen TRUE
ohne gruppe wieder schmal TRUE

=== die schriftwahl listet, filtert und liefert die wahl
IMPORT "gui"
SCREEN(600, 500, "T", 1)
DIM dlg AS GUI_WINDOW
dlg = GUI_FONT_DIALOG("Schrift", 20)
DIM liste AS GUI_WIDGET : liste = GUI_WINDOW_WIDGET(dlg, 1)
DIM such AS GUI_WIDGET : such = GUI_WINDOW_WIDGET(dlg, 0)
GUI_UPDATE()
PRINT "eintraege " + STR$(GUI_LISTBOX_COUNT(liste)) + " erster " + GUI_LISTBOX_ITEM(liste, 0)
PRINT "pfad " + STR$(RIGHT$(GUI_FONT_DIALOG_PATH$(dlg), 17) = "roboto_medium.ttf") + " groesse " + STR$(GUI_FONT_DIALOG_SIZE(dlg))
GUI_SET_TEXT(such, "gibtsnicht")
GUI_UPDATE()
PRINT "gefiltert " + STR$(GUI_LISTBOX_COUNT(liste)) + " pfad '" + GUI_FONT_DIALOG_PATH$(dlg) + "'"
GUI_SET_TEXT(such, "ROBO")
GUI_UPDATE()
PRINT "wieder " + STR$(GUI_LISTBOX_COUNT(liste)) + " modal " + STR$(GUI_MODAL())
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF GUI_ANSWER(dlg) > 0 THEN PRINT "antwort " + STR$(GUI_ANSWER(dlg)) + " pfad danach " + STR$(RIGHT$(GUI_FONT_DIALOG_PATH$(dlg), 4) = ".ttf")
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 2
e 4 2 257 0 0 0
e 6 1 257 0 0 0

--- umgebung
DHRT_SCHRIFT_ORDNER={sammlung}/../../examples/assets
DHRT_FRAMES=20
--- erwartet
eintraege 1 erster roboto_medium
pfad TRUE groesse 20
gefiltert 0 pfad ''
wieder 1 modal TRUE
antwort 1 pfad danach TRUE

=== die zusaetze stehen in der dhform
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM lb AS GUI_WIDGET : lb = GUI_LABEL(w, "x", 10, 10)
GUI_LABEL_SET(lb, "kuerzen", "mitte")
GUI_LABEL_SET(lb, "auswaehlbar", TRUE)
DIM sl AS GUI_WIDGET : sl = GUI_SLIDER(w, 10, 40, 100, 0, 10, 0)
GUI_SLIDER_SET(sl, "marken", 3)
GUI_SLIDER_MARK(sl, 5, "Mitte")
GUI_SLIDER_SET(sl, "einrasten", 1)
DIM k AS GUI_WIDGET : k = GUI_BUSY(w, 10, 80, 24)
DIM l AS GUI_WIDGET : l = GUI_LAYOUT(w, "fluss", 10, 110, 200, 60)
GUI_LAYOUT_SET(l, "auswahl", 1)
GUI_SIZE_GROUP(lb, "g", "beide")
DIM j AS STRING : j = GUI_TO_JSON(w)
DIM w2 AS GUI_WINDOW : w2 = GUI_FROM_JSON(j)
PRINT "rundweg " + STR$(GUI_TO_JSON(w2) = j)
DIM q AS STRING : q = CHR$(34)
PRINT STR$(INSTR(j, q + "kuerzen" + q + ": " + q + "mitte" + q) >= 0) + " " + STR$(INSTR(j, q + "fluss" + q) >= 0) + " " + STR$(INSTR(j, q + "kreis" + q + ": true") >= 0) + " " + STR$(INSTR(j, q + "Mitte" + q) >= 0)
--- erwartet
rundweg TRUE
TRUE TRUE TRUE TRUE

=== falsche angaben sind fehler
IMPORT "gui"
SCREEN(300, 200, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 200)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "x", 10, 10, 50, 20)
DIM sl AS GUI_WIDGET : sl = GUI_SLIDER(w, 10, 40, 100, 0, 10, 0)
DIM dp AS GUI_WIDGET : dp = GUI_DATEPICKER(w, 10, 80, 200, 100)
TRY
    GUI_LABEL_SET(b, "kuerzen", "ende")
CATCH e
    PRINT e
END TRY
TRY
    DIM lb AS GUI_WIDGET : lb = GUI_LABEL(w, "x", 0, 0)
    GUI_LABEL_SET(lb, "kuerzen", "links")
CATCH e
    PRINT e
END TRY
TRY
    GUI_SLIDER_MARK(sl, 20, "zu weit")
CATCH e
    PRINT e
END TRY
TRY
    GUI_SLIDER_SET(sl, "marken", 1)
CATCH e
    PRINT e
END TRY
TRY
    GUI_DATE_MARK(dp, "31.12.2026")
CATCH e
    PRINT e
END TRY
TRY
    GUI_SIZE_GROUP(b, "g", "diagonal")
CATCH e
    PRINT e
END TRY
TRY
    DIM x AS GUI_WIDGET : x = GUI_BUSY(w, 0, 0, 4)
CATCH e
    PRINT e
END TRY
TRY
    DIM l AS GUI_WIDGET : l = GUI_LAYOUT(w, "kreis", 0, 0, 10, 10)
CATCH e
    PRINT e
END TRY
--- erwartet
GUI_LABEL_SET: Widget ist keine Beschriftung (GUI_LABEL)
GUI_LABEL_SET: kuerzen ist aus, ende, mitte oder anfang -- nicht 'links'
GUI_SLIDER_MARK: 20 liegt ausserhalb des Reglers (0..10)
GUI_SLIDER_SET: marken ist 0 oder 2..101
GUI_DATE_MARK: '31.12.2026' ist kein Datum JJJJ-MM-TT
GUI_SIZE_GROUP: 'diagonal' -- breite, hoehe oder beide
GUI_BUSY: der Durchmesser muss mindestens 8 sein
GUI_LAYOUT: 'kreis' ist keine Art -- zeile, spalte, fluss oder raster:N
