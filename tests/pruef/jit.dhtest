=== vorbelegte namen in einer funktion
FUNCTION kreis(r AS FLOAT) AS FLOAT
    RETURN PI * r * r + TAU
END FUNCTION
FUNCTION farbe(i AS INTEGER) AS INTEGER
    IF i MOD 2 = 0 THEN RETURN RED
    RETURN GREEN + DARKBLUE
END FUNCTION
DIM i AS INTEGER
DIM s AS FLOAT
DIM n AS INTEGER
FOR i = 1 TO 4
    s = s + kreis(i)
    n = n + farbe(i)
NEXT
PRINT s; " "; n
