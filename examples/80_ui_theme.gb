' 80_ui_theme.gb - Aussehen des "ui"-Moduls (Immediate-Mode) aendern
'
' UI_THEME_PRESET schaltet das ganze Farbschema um; UI_THEME_SET aendert
' eine einzelne Farbe; UI_METRIC_SET aendert eine Groesse. Direkt als
' Argument uebergebene Farben (z.B. beim roten Button) gewinnen weiterhin.

IMPORT "ui"

SCREEN(420, 320, "UI-Theming-Demo", 2)

DIM presets AS ARRAY OF STRING
' "glas_*" bringen zusaetzlich Plastik mit: Verlauf, Glanzkante, Fase.
' Ein Preset setzt Farben UND Metriken, ist also ein kompletter Look.
presets = SPLIT$("dark|light|retro|contrast|glas_dunkel|glas_hell", "|")
DIM pidx AS INTEGER
pidx = 0

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(KEY_ESCAPE) THEN BREAK

    CLS(UI_THEME_GET("win_bg"))         ' Hintergrund passend zum Theme

    UI_LABEL(12, 10, "Theme: " + presets[pidx], UI_THEME_GET("accent"))

    ' Preset durchschalten
    IF UI_BUTTON("next", 12, 36, 150, 28, "Theme wechseln") THEN
        pidx = (pidx + 1) MOD presets.length()   ' nicht fest 4 -- sonst faellt
                                                 ' ein neues Thema hinten raus
        UI_THEME_PRESET(presets[pidx])
    END IF

    ' Eine Einzelfarbe global setzen
    IF UI_BUTTON("green", 172, 36, 150, 28, "Akzent = Gruen") THEN
        UI_THEME_SET("accent", RGB(60, 200, 90))
    END IF

    ' Diese Widgets nutzen die Theme-Defaults ...
    DIM snd AS BOOLEAN
    snd = UI_CHECKBOX("snd", 12, 80, "Sound an", TRUE)

    DIM vol AS FLOAT
    vol = UI_SLIDER("vol", 12, 108, 220, 0.0, 1.0, 0.6)
    UI_LABEL(12, 130, "Lautstaerke: " + STR$(INT(vol * 100.0)) + "%")

    UI_PROGRESS(12, 158, 220, 14, vol, 1.0)

    DIM name AS STRING
    name = UI_TEXTFIELD("name", 12, 184, 220, 26, "Name eingeben ...")

    ' ... dieser Button hat eine feste Farbe (Argument schlaegt Theme):
    IF UI_BUTTON("del", 12, 222, 120, 28, "Loeschen", RGB(170, 45, 45)) THEN
        UI_TEXTFIELD_SET("name", "")
    END IF

    ' Groesse live: Checkbox groesser/kleiner per Pfeiltasten hoch/runter
    IF KEYPRESSED(KEY_UP) THEN UI_METRIC_SET("checkbox_size", 22)
    IF KEYPRESSED(KEY_DOWN) THEN UI_METRIC_SET("checkbox_size", 14)

    UI_LABEL(12, 258, "Pfeil hoch/runter aendert Checkbox-Groesse", UI_THEME_GET("muted_fg"))

    UI_END_FRAME()
    FLIP()
    SLEEP(16)
WEND
