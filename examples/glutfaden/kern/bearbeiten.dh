' Das Muster bearbeiten -- jede Aenderung geht durch diese Datei und landet
' im Verlauf. Wer Zellen oder Ebenen anders anfasst, hat kein Rueckgaengig.
'
' Steht kein Zug offen (Verlauf.beginnen), oeffnet jeder Befehl seinen
' eigenen Schritt; in einem Zug sammeln sich alle Aenderungen in EINEM.

' Eine Zelle der aktiven Ebene setzen (farbe -1 = Stich entfernen). FALSE,
' wenn nichts geschah: ausserhalb, gesperrte Ebene oder schon so.
FUNCTION stichSetzen(m AS Muster, v AS Verlauf, x AS INTEGER, y AS INTEGER, farbe AS INTEGER, typ AS INTEGER) AS BOOLEAN
    DIM e AS Ebene : e = m.ebenen.aktiveEbene()
    IF e IS NIL THEN RETURN FALSE
    IF e.gesperrt OR NOT e.drin(x, y) THEN RETURN FALSE
    IF farbe >= m.farbanzahl() THEN RETURN FALSE
    DIM i AS INTEGER : i = y * e.breite + x
    DIM af AS INTEGER : af = e.raster[i]
    DIM aa AS INTEGER : aa = e.art[i]
    DIM ae AS INTEGER : ae = e.erledigt[i]
    DIM nf AS INTEGER, na AS INTEGER, ne AS INTEGER
    IF farbe < 0 THEN
        nf = KEIN_STICH                       ' entfernen: auch erledigt und Typ weg
    ELSE
        nf = farbe
        na = m.typFuer(farbe, typ)
        ne = ae                               ' setzen laesst "erledigt" stehen
    END IF
    IF nf = af AND na = aa AND ne = ae THEN RETURN FALSE
    DIM eigen AS BOOLEAN : eigen = NOT v.istOffen()
    IF eigen THEN v.beginnen(IIF(farbe < 0, "Stich entfernen", "Stich setzen"))
    v.zelle(e, i, af, aa, ae, nf, na, ne)
    m.zaehlen(af, nf)
    e.raster[i] = nf : e.art[i] = na : e.erledigt[i] = ne
    IF eigen THEN v.beenden()
    RETURN TRUE
END FUNCTION

' Viele Zellen auf einmal, [x0, y0, x1, y1, ...], in EINEM Schritt (Formen,
' Fuellen). Dieselben Regeln wie stichSetzen, aber ohne Aufruf je Zelle: die
' Schleife arbeitet auf festen Zahlenfeldern und laeuft als Maschinencode --
' eine gefuellte Flaeche von einer Million Zellen kostete Zelle fuer Zelle
' ueber stichSetzen dreieinhalb Sekunden. Liefert, wie viele sich geaendert
' haben.
FUNCTION zellenSetzen(m AS Muster, v AS Verlauf, punkte AS ARRAY OF INTEGER, farbe AS INTEGER, typ AS INTEGER, text AS STRING) AS INTEGER
    DIM e AS Ebene : e = m.ebenen.aktiveEbene()
    IF e IS NIL THEN RETURN 0
    IF e.gesperrt THEN RETURN 0
    DIM nfarben AS INTEGER : nfarben = m.farbanzahl()
    IF farbe >= nfarben THEN RETURN 0
    DIM nf AS INTEGER : nf = KEIN_STICH
    DIM na AS INTEGER
    IF farbe >= 0 THEN
        nf = farbe
        na = m.typFuer(farbe, typ)
    END IF
    DIM b AS INTEGER : b = e.breite
    DIM h AS INTEGER : h = e.hoehe
    DIM r AS ARRAY OF INTEGER : r = e.raster
    DIM a AS ARRAY OF INTEGER : a = e.art
    DIM d AS ARRAY OF INTEGER : d = e.erledigt
    DIM n AS INTEGER : n = LEN(punkte) \ 2
    DIM zi[n] AS INTEGER
    DIM af[n] AS INTEGER
    DIM aa[n] AS INTEGER
    DIM ae[n] AS INTEGER
    DIM ne[n] AS INTEGER
    DIM zaehl[nfarben + 1] AS INTEGER
    DIM k AS INTEGER, x AS INTEGER, y AS INTEGER, i AS INTEGER, c AS INTEGER, alt AS INTEGER, fe AS INTEGER
    FOR k = 0 TO n - 1
        x = punkte[2 * k]
        y = punkte[2 * k + 1]
        IF x < 0 OR y < 0 OR x >= b OR y >= h THEN CONTINUE
        i = y * b + x
        alt = r[i]
        fe = 0
        IF nf >= 0 THEN fe = d[i]            ' setzen laesst "erledigt" stehen
        IF alt = nf AND a[i] = na AND d[i] = fe THEN CONTINUE
        zi[c] = i
        af[c] = alt
        aa[c] = a[i]
        ae[c] = d[i]
        ne[c] = fe
        IF alt >= 0 AND alt < nfarben THEN zaehl[alt] = zaehl[alt] - 1
        IF nf >= 0 THEN zaehl[nf] = zaehl[nf] + 1
        r[i] = nf
        a[i] = na
        d[i] = fe
        c = c + 1
    NEXT
    IF c = 0 THEN RETURN 0
    FOR k = 0 TO nfarben - 1
        IF zaehl[k] <> 0 THEN m.farben[k].stichzahl = m.farben[k].stichzahl + zaehl[k]
    NEXT
    v.beginnen(text)
    DIM t AS Aenderung : t = v.teil(TEIL_STICHE)
    t.ebene = e
    t.zellen = zi[0:c]
    t.altFarbe = af[0:c]
    t.altArt = aa[0:c]
    t.altFertig = ae[0:c]
    t.neuFertig = ne[0:c]
    ' Farbe und Art sind fuer alle Zellen gleich
    DIM gleichF[c] AS INTEGER
    DIM gleichA[c] AS INTEGER
    FOR k = 0 TO c - 1
        gleichF[k] = nf
        gleichA[k] = na
    NEXT
    t.neuFarbe = gleichF
    t.neuArt = gleichA
    v.beenden()
    RETURN c
END FUNCTION

' --- Ebenen ---------------------------------------------------------------------

' Vorher-Stand eines Umbaus festhalten; ebenenNachher() schliesst ihn ab.
FUNCTION ebenenVorher(m AS Muster, v AS Verlauf, text AS STRING) AS Aenderung
    v.beginnen(text)
    DIM t AS Aenderung : t = v.teil(TEIL_EBENEN)
    t.ebenenVorher = ARRAY_COPY(m.ebenen.ebenen)
    t.aktivVorher = m.ebenen.aktiv
    RETURN t
END FUNCTION

SUB ebenenNachher(m AS Muster, v AS Verlauf, t AS Aenderung)
    t.ebenenNachher = ARRAY_COPY(m.ebenen.ebenen)
    t.aktivNachher = m.ebenen.aktiv
    v.beenden()
END SUB

' Ein freier Name "Ebene n".
FUNCTION ebenenName$(m AS Muster) AS STRING
    DIM n AS INTEGER : n = m.ebenen.anzahl() + 1
    DO
        DIM name AS STRING : name = "Ebene " + STR$(n)
        DIM frei AS BOOLEAN : frei = TRUE
        DIM e AS Ebene
        FOR EACH e IN m.ebenen.ebenen
            IF e.name = name THEN frei = FALSE
        NEXT
        IF frei THEN RETURN name
        n = n + 1
    LOOP
END FUNCTION

' Neue leere Ebene ueber der aktiven; sie wird aktiv. Liefert ihre Nummer.
FUNCTION ebeneNeu(m AS Muster, v AS Verlauf, name AS STRING) AS INTEGER
    DIM t AS Aenderung : t = ebenenVorher(m, v, "Ebene anlegen")
    IF name = "" THEN name = ebenenName$(m)
    DIM nr AS INTEGER : nr = m.ebenen.aktiv + 1
    ARRAY_INSERT(m.ebenen.ebenen, nr, neueEbene(name, m.breite, m.hoehe))
    m.ebenen.aktiv = nr
    ebenenNachher(m, v, t)
    RETURN nr
END FUNCTION

' Eine Ebene loeschen; die letzte bleibt. FALSE, wenn nicht geloescht.
FUNCTION ebeneLoeschen(m AS Muster, v AS Verlauf, nr AS INTEGER) AS BOOLEAN
    IF m.ebenen.anzahl() <= 1 OR nr < 0 OR nr >= m.ebenen.anzahl() THEN RETURN FALSE
    DIM t AS Aenderung : t = ebenenVorher(m, v, "Ebene löschen")
    ARRAY_REMOVE_AT(m.ebenen.ebenen, nr)
    DIM a AS INTEGER : a = m.ebenen.aktiv
    IF a >= m.ebenen.anzahl() THEN
        a = m.ebenen.anzahl() - 1
    ELSEIF a > nr THEN
        a = a - 1
    END IF
    m.ebenen.aktiv = a
    m.stichzahlenNeu()
    ebenenNachher(m, v, t)
    RETURN TRUE
END FUNCTION

' Kopie direkt ueber der Ebene, die Kopie wird aktiv.
FUNCTION ebeneDuplizieren(m AS Muster, v AS Verlauf, nr AS INTEGER) AS INTEGER
    IF nr < 0 OR nr >= m.ebenen.anzahl() THEN RETURN -1
    DIM t AS Aenderung : t = ebenenVorher(m, v, "Ebene duplizieren")
    DIM q AS Ebene : q = m.ebenen.ebenen[nr]
    ARRAY_INSERT(m.ebenen.ebenen, nr + 1, q.kopie(q.name + " (Kopie)"))
    m.ebenen.aktiv = nr + 1
    m.stichzahlenNeu()
    ebenenNachher(m, v, t)
    RETURN nr + 1
END FUNCTION

' Eine Ebene an eine andere Stelle; die aktive folgt ihrer Ebene.
FUNCTION ebeneVerschieben(m AS Muster, v AS Verlauf, von AS INTEGER, nach AS INTEGER) AS BOOLEAN
    DIM n AS INTEGER : n = m.ebenen.anzahl()
    IF von < 0 OR von >= n OR nach < 0 OR nach >= n OR von = nach THEN RETURN FALSE
    DIM t AS Aenderung : t = ebenenVorher(m, v, "Ebene verschieben")
    DIM aktivE AS Ebene : aktivE = m.ebenen.aktiveEbene()
    DIM e AS Ebene : e = m.ebenen.ebenen[von]
    ARRAY_REMOVE_AT(m.ebenen.ebenen, von)
    ARRAY_INSERT(m.ebenen.ebenen, nach, e)
    m.ebenen.aktiv = ebenenNummer(m, aktivE)
    ebenenNachher(m, v, t)
    RETURN TRUE
END FUNCTION

FUNCTION ebenenNummer(m AS Muster, e AS Ebene) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO m.ebenen.anzahl() - 1
        IF m.ebenen.ebenen[i] = e THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Mit der Ebene darunter zusammenfuehren: ihre Stiche gehen nach unten (samt
' Typ und erledigt), dann verschwindet sie. FALSE bei der untersten oder wenn
' die untere gesperrt ist.
FUNCTION ebeneNachUnten(m AS Muster, v AS Verlauf, nr AS INTEGER) AS BOOLEAN
    IF nr <= 0 OR nr >= m.ebenen.anzahl() THEN RETURN FALSE
    DIM oben AS Ebene : oben = m.ebenen.ebenen[nr]
    DIM unten AS Ebene : unten = m.ebenen.ebenen[nr - 1]
    IF unten.gesperrt THEN RETURN FALSE
    v.beginnen("Ebenen zusammenführen")
    ' Die Stiche der oberen als Zellen auf die untere -- ueber zellenUebernehmen,
    ' damit es ein Stiche-Teil wird, den Rueckgaengig zuruecknimmt
    zellenUebernehmen(v, oben, unten)
    DIM t AS Aenderung : t = v.teil(TEIL_EBENEN)
    t.ebenenVorher = ARRAY_COPY(m.ebenen.ebenen)
    t.aktivVorher = m.ebenen.aktiv
    ARRAY_REMOVE_AT(m.ebenen.ebenen, nr)
    m.ebenen.aktiv = nr - 1
    m.stichzahlenNeu()
    t.ebenenNachher = ARRAY_COPY(m.ebenen.ebenen)
    t.aktivNachher = m.ebenen.aktiv
    v.beenden()
    RETURN TRUE
END FUNCTION

' Alle Stiche von quelle auf ziel schreiben (Farbe, Typ, erledigt), als ein
' Stiche-Teil im offenen Schritt. Stichzahlen aendern sich nicht (dieselben
' Farben, nur auf einer anderen Ebene) -- der Umbau zaehlt danach neu.
SUB zellenUebernehmen(v AS Verlauf, quelle AS Ebene, ziel AS Ebene)
    DIM qr AS ARRAY OF INTEGER : qr = quelle.raster
    DIM qa AS ARRAY OF INTEGER : qa = quelle.art
    DIM qd AS ARRAY OF INTEGER : qd = quelle.erledigt
    DIM r AS ARRAY OF INTEGER : r = ziel.raster
    DIM a AS ARRAY OF INTEGER : a = ziel.art
    DIM d AS ARRAY OF INTEGER : d = ziel.erledigt
    DIM n AS INTEGER : n = LEN(qr)
    DIM c AS INTEGER, i AS INTEGER
    FOR i = 0 TO n - 1
        IF qr[i] <> KEIN_STICH THEN
            IF r[i] <> qr[i] OR a[i] <> qa[i] OR d[i] <> qd[i] THEN c = c + 1
        END IF
    NEXT
    IF c = 0 THEN RETURN
    DIM zi[c] AS INTEGER
    DIM af[c] AS INTEGER
    DIM aa[c] AS INTEGER
    DIM ae[c] AS INTEGER
    DIM nf[c] AS INTEGER
    DIM na[c] AS INTEGER
    DIM ne[c] AS INTEGER
    DIM k AS INTEGER
    FOR i = 0 TO n - 1
        IF qr[i] = KEIN_STICH THEN CONTINUE
        IF r[i] = qr[i] AND a[i] = qa[i] AND d[i] = qd[i] THEN CONTINUE
        zi[k] = i
        af[k] = r[i] : aa[k] = a[i] : ae[k] = d[i]
        nf[k] = qr[i] : na[k] = qa[i] : ne[k] = qd[i]
        r[i] = qr[i] : a[i] = qa[i] : d[i] = qd[i]
        k = k + 1
    NEXT
    DIM t AS Aenderung : t = v.teil(TEIL_STICHE)
    t.ebene = ziel
    t.zellen = zi
    t.altFarbe = af : t.altArt = aa : t.altFertig = ae
    t.neuFarbe = nf : t.neuArt = na : t.neuFertig = ne
END SUB

FUNCTION ebeneUmbenennen(m AS Muster, v AS Verlauf, nr AS INTEGER, name AS STRING) AS BOOLEAN
    IF nr < 0 OR nr >= m.ebenen.anzahl() THEN RETURN FALSE
    name = TRIM$(name)
    DIM e AS Ebene : e = m.ebenen.ebenen[nr]
    IF name = "" OR name = e.name THEN RETURN FALSE
    v.beginnen("Ebene umbenennen")
    DIM t AS Aenderung : t = v.teil(TEIL_NAME)
    t.ebene = e
    t.textVorher = e.name
    t.textNachher = name
    e.name = name
    v.beenden()
    RETURN TRUE
END FUNCTION

' --- Farben ---------------------------------------------------------------------

' Ein Garn ins Muster nehmen. Gibt es dasselbe (Hersteller und Nummer) schon,
' liefert es dessen Nummer und aendert nichts. Neue Farben bekommen das erste
' freie Symbol, danach "#1", "#2" ... (nie "?" -- das hiesse "nicht vergeben").
FUNCTION farbeHinzufuegen(m AS Muster, v AS Verlauf, g AS Garn, symbole AS ARRAY OF STRING, perle AS BOOLEAN, diamant AS BOOLEAN) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO m.farbanzahl() - 1
        DIM h AS Garn : h = m.farben[i].garn
        IF g.nummer <> "" AND h.nummer = g.nummer AND h.hersteller = g.hersteller THEN RETURN i
    NEXT
    DIM benutzt AS MAP OF BOOLEAN : benutzt = {}
    DIM f AS Farbeintrag
    FOR EACH f IN m.farben
        MAPPUT(benutzt, f.symbol, TRUE)
    NEXT
    DIM symbol AS STRING
    DIM s AS STRING
    FOR EACH s IN symbole
        IF NOT MAPHAS(benutzt, s) THEN
            symbol = s
            BREAK
        END IF
    NEXT
    IF symbol = "" THEN
        DIM k AS INTEGER : k = 1
        WHILE MAPHAS(benutzt, "#" + STR$(k)) : k = k + 1 : WEND
        symbol = "#" + STR$(k)
    END IF
    DIM neu AS Farbeintrag : neu = neuerFarbeintrag(g, symbol)
    neu.istPerle = perle
    neu.istDiamant = diamant
    v.beginnen("Farbe hinzufügen")
    DIM t AS Aenderung : t = v.teil(TEIL_FARBEN)
    t.farbenVorher = ARRAY_COPY(m.farben)
    t.rueckVorher = ARRAY_COPY(m.rueckstiche)
    ARRAY_PUSH(m.farben, neu)
    t.farbenNachher = ARRAY_COPY(m.farben)
    t.rueckNachher = ARRAY_COPY(m.rueckstiche)
    t.hin = gleicheAbbildung(m.farbanzahl())
    t.zurueck = t.hin
    v.beenden()
    RETURN m.farbanzahl() - 1
END FUNCTION

FUNCTION gleicheAbbildung(n AS INTEGER) AS ARRAY OF INTEGER
    DIM a[n] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1 : a[i] = i : NEXT
    RETURN a
END FUNCTION

' Farben ohne Stich in irgendeiner Ebene (auch unsichtbaren) und ohne
' Rueckstich entfernen; die uebrigen ruecken auf. Liefert, wie viele weg sind.
FUNCTION unbenutzteEntfernen(m AS Muster, v AS Verlauf) AS INTEGER
    m.stichzahlenNeu()
    DIM n AS INTEGER : n = m.farbanzahl()
    DIM genutzt[n] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        IF m.farben[i].stichzahl > 0 THEN genutzt[i] = 1
    NEXT
    DIM r AS Rueckstich
    FOR EACH r IN m.rueckstiche
        IF r.farbe >= 0 AND r.farbe < n THEN genutzt[r.farbe] = 1
    NEXT
    DIM hin[n] AS INTEGER
    DIM zurueck AS ARRAY OF INTEGER : zurueck = []
    DIM neueFarben AS ARRAY OF Farbeintrag : neueFarben = []
    FOR i = 0 TO n - 1
        IF genutzt[i] = 1 THEN
            hin[i] = LEN(neueFarben)
            ARRAY_PUSH(zurueck, i)
            ARRAY_PUSH(neueFarben, m.farben[i])
        ELSE
            hin[i] = KEIN_STICH
        END IF
    NEXT
    DIM weg AS INTEGER : weg = n - LEN(neueFarben)
    IF weg = 0 THEN RETURN 0
    v.beginnen("Unbenutzte Farben entfernen")
    DIM t AS Aenderung : t = v.teil(TEIL_FARBEN)
    t.farbenVorher = ARRAY_COPY(m.farben)
    t.rueckVorher = ARRAY_COPY(m.rueckstiche)
    t.farbenNachher = neueFarben
    ' Rueckstiche sind Objekte: neue anlegen statt die alten umzuschreiben,
    ' sonst stuende nach einem Rueckgaengig die neue Nummer im alten Stich.
    DIM rn AS ARRAY OF Rueckstich : rn = []
    FOR EACH r IN m.rueckstiche
        ARRAY_PUSH(rn, neuerRueckstich(r.x1, r.y1, r.x2, r.y2, IIF(r.farbe >= 0 AND r.farbe < n, hin[r.farbe], r.farbe)))
    NEXT
    t.rueckNachher = rn
    t.hin = hin
    t.zurueck = zurueck
    v.beenden()
    teilAnwenden(m, t, TRUE)
    RETURN weg
END FUNCTION
