' Modul Rezeptkatalog: SUBs und FUNCTIONs fuer das ganze Projekt.

' Die deutschen Rezepte der Python-App (data/german_recipes.py, 29 Stück) --
' der Katalog, den „Rezept suchen“ ohne Internet durchsucht und aus dem man
' ein Rezept in die eigenen übernimmt. Erzeugt aus der Python-Datei; Zutaten
' je Rezept als "Name|Menge|Einheit" durch Semikolon getrennt.
FUNCTION katalog() AS ARRAY OF Rezept
    DIM k AS ARRAY OF Rezept : k = []
    ARRAY_PUSH(k, katalogRezept("Jägerschnitzel", "Paniertes Schweineschnitzel mit cremiger Champignon-Rahmsauce. Ein Klassiker der deutschen Küche.", 4, 20, 25, "Hauptgericht", _
        !"1. Schnitzel zwischen Frischhaltefolie dünn klopfen, salzen und pfeffern.\n2. Schnitzel in Mehl, verquirltem Ei und Semmelbröseln wenden.\n3. In heißem Butterschmalz von beiden Seiten goldbraun braten, warmhalten.\n4. Champignons in Scheiben schneiden und in Butter anbraten.\n5. Zwiebeln würfeln, zu den Pilzen geben und glasig dünsten.\n6. Mit Weißwein ablöschen, Sahne zugeben und einkochen lassen.\n7. Mit Salz, Pfeffer und Petersilie abschmecken.\n8. Schnitzel mit Sauce servieren, dazu Spätzle oder Pommes.", _
        "Schweineschnitzel|4|Stück;Champignons|300|g;Zwiebel|1|Stück;Sahne|200|ml;Weißwein|100|ml;Mehl|100|g;Ei|2|Stück;Semmelbrösel|150|g;Butterschmalz|100|g;Petersilie|1|Bund;Salz|1|TL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Wiener Schnitzel", "Das Original aus Kalbfleisch - dünn geklopft, paniert und goldbraun gebraten.", 4, 20, 15, "Hauptgericht", _
        !"1. Kalbsschnitzel zwischen Folie sehr dünn klopfen (ca. 4mm).\n2. Salzen und pfeffern.\n3. Schnitzel erst in Mehl wenden, überschüssiges abklopfen.\n4. Durch verquirltes Ei ziehen.\n5. In Semmelbröseln wenden, leicht andrücken.\n6. In reichlich heißem Butterschmalz schwimmend ausbacken.\n7. Dabei die Pfanne schwenken, damit die Panade wellig wird.\n8. Auf Küchenpapier abtropfen lassen.\n9. Mit Zitronenscheibe und Petersilie servieren.", _
        "Kalbsschnitzel|4|Stück;Mehl|100|g;Ei|3|Stück;Semmelbrösel|200|g;Butterschmalz|200|g;Zitrone|1|Stück;Petersilie|1|Bund;Salz|1|TL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Zigeunerschnitzel", "Schnitzel mit würziger Paprika-Zwiebel-Sauce. Deftig und aromatisch.", 4, 25, 30, "Hauptgericht", _
        !"1. Schnitzel klopfen, würzen und in Mehl wenden.\n2. In Öl von beiden Seiten braten, warmhalten.\n3. Paprika und Zwiebeln in Streifen schneiden.\n4. Im Bratfett anbraten bis sie weich sind.\n5. Tomatenmark einrühren und kurz mitrösten.\n6. Mit Brühe ablöschen, gewürfelte Tomaten zugeben.\n7. Paprikapulver, Salz und Pfeffer einrühren.\n8. 10 Minuten köcheln lassen.\n9. Schnitzel in der Sauce servieren.", _
        "Schweineschnitzel|4|Stück;Paprika rot|2|Stück;Paprika gelb|1|Stück;Zwiebel|2|Stück;Tomatenmark|2|EL;Dosentomaten|400|g;Gemüsebrühe|200|ml;Paprikapulver edelsüß|2|TL;Öl|4|EL;Mehl|50|g;Salz|1|TL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Rahmschnitzel", "Zartes Schnitzel in cremiger Sahnesauce mit feinen Kräutern.", 4, 15, 20, "Hauptgericht", _
        !"1. Schnitzel klopfen und würzen.\n2. In Mehl wenden und in Butter goldbraun braten.\n3. Schnitzel herausnehmen und warmhalten.\n4. Zwiebeln im Bratfett glasig dünsten.\n5. Mit Weißwein ablöschen.\n6. Sahne und Crème fraîche einrühren.\n7. Mit Salz, Pfeffer und Muskat abschmecken.\n8. Kräuter unterheben.\n9. Schnitzel mit Sauce servieren.", _
        "Schweineschnitzel|4|Stück;Sahne|200|ml;Crème fraîche|100|g;Weißwein|100|ml;Zwiebel|1|Stück;Butter|50|g;Mehl|50|g;Petersilie|1|Bund;Schnittlauch|1|Bund;Muskatnuss|1|Prise;Salz|1|TL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Schweinebraten", "Klassischer bayerischer Schweinebraten mit knuspriger Kruste und dunkler Sauce.", 6, 30, 150, "Hauptgericht", _
        !"1. Schwarte rautenförmig einschneiden, mit Salz einreiben.\n2. Fleisch mit Kümmel, Salz und Pfeffer würzen.\n3. Suppengemüse grob würfeln und in Bräter geben.\n4. Fleisch mit Schwarte nach oben auf Gemüse setzen.\n5. Dunkelbier angießen.\n6. Bei 180°C ca. 2,5 Stunden braten.\n7. Regelmäßig mit Bratensaft übergießen.\n8. Für knusprige Kruste am Ende Grill zuschalten.\n9. Sauce durch Sieb passieren und abschmecken.", _
        "Schweinebraten mit Schwarte|1.5|kg;Dunkelbier|500|ml;Zwiebel|2|Stück;Karotten|2|Stück;Sellerie|100|g;Kümmel|1|EL;Salz|2|EL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Sauerbraten", "In Essig und Gewürzen marinierter Rinderbraten mit süß-saurer Sauce.", 6, 30, 180, "Hauptgericht", _
        !"1. Marinade aus Essig, Wasser, Gewürzen und Gemüse kochen, abkühlen lassen.\n2. Fleisch 5-7 Tage in Marinade im Kühlschrank einlegen.\n3. Fleisch herausnehmen, trocken tupfen, Marinade aufheben.\n4. Fleisch scharf anbraten.\n5. Mariniertes Gemüse zugeben und mitrösten.\n6. Mit Marinade ablöschen.\n7. Bei 160°C ca. 3 Stunden schmoren.\n8. Fleisch herausnehmen, Sauce pürieren.\n9. Mit Lebkuchen und Rosinen verfeinern.", _
        "Rinderbraten|1.5|kg;Rotweinessig|500|ml;Wasser|500|ml;Zwiebel|3|Stück;Karotten|2|Stück;Lorbeerblätter|3|Stück;Wacholderbeeren|10|Stück;Nelken|5|Stück;Pfefferkörner|10|Stück;Lebkuchen|50|g;Rosinen|50|g"))
    ARRAY_PUSH(k, katalogRezept("Rinderrouladen", "Gefüllte Rinderrouladen mit Senf, Speck und Gewürzgurken in dunkler Sauce.", 4, 40, 120, "Hauptgericht", _
        !"1. Rouladen flach ausbreiten, mit Senf bestreichen.\n2. Mit Speck, Zwiebeln und Gurkenstreifen belegen.\n3. Aufrollen und mit Rouladennadeln oder Garn fixieren.\n4. In heißem Fett von allen Seiten anbraten.\n5. Suppengemüse zugeben und mitrösten.\n6. Mit Rotwein und Brühe ablöschen.\n7. Bei 160°C ca. 2 Stunden schmoren.\n8. Rouladen herausnehmen, Sauce binden.\n9. Mit Kartoffeln oder Klößen servieren.", _
        "Rinderrouladen|4|Stück;Senf mittelscharf|4|EL;Speck durchwachsen|100|g;Zwiebel|2|Stück;Gewürzgurken|4|Stück;Rotwein|250|ml;Rinderbrühe|500|ml;Karotten|2|Stück;Sellerie|100|g;Tomatenmark|2|EL"))
    ARRAY_PUSH(k, katalogRezept("Erbseneintopf", "Deftiger Eintopf mit gelben Erbsen, Kartoffeln und Würstchen.", 6, 20, 90, "Eintopf", _
        !"1. Erbsen über Nacht einweichen.\n2. Erbsen in frischem Wasser aufkochen.\n3. Suppengemüse und Kartoffeln würfeln, zugeben.\n4. Speck und Mettwurst mitkochen.\n5. Ca. 1,5 Stunden köcheln bis Erbsen weich sind.\n6. Würstchen in Scheiben schneiden, zugeben.\n7. Mit Majoran, Salz und Pfeffer abschmecken.\n8. Mit frischer Petersilie servieren.", _
        "Gelbe Erbsen|500|g;Kartoffeln|500|g;Mettwurst|200|g;Wiener Würstchen|4|Stück;Speck durchwachsen|150|g;Zwiebel|2|Stück;Karotten|2|Stück;Sellerie|100|g;Lauch|1|Stange;Majoran|1|TL;Petersilie|1|Bund"))
    ARRAY_PUSH(k, katalogRezept("Linseneintopf", "Herzhafter Eintopf mit Linsen, Gemüse und Essig-Aroma.", 6, 20, 60, "Eintopf", _
        !"1. Linsen waschen, mit Wasser aufsetzen.\n2. Speck und Zwiebeln würfeln, anbraten.\n3. Karotten, Sellerie und Kartoffeln würfeln.\n4. Alles zu den Linsen geben.\n5. Lorbeer und Nelken zugeben.\n6. Ca. 45 Minuten köcheln.\n7. Würstchen in Scheiben schneiden, zugeben.\n8. Mit Essig, Salz und Pfeffer abschmecken.\n9. Mit Petersilie garnieren.", _
        "Braune Linsen|400|g;Kartoffeln|400|g;Karotten|3|Stück;Sellerie|150|g;Speck|150|g;Zwiebel|2|Stück;Würstchen|4|Stück;Lorbeerblatt|2|Stück;Essig|3|EL;Petersilie|1|Bund"))
    ARRAY_PUSH(k, katalogRezept("Kartoffelsuppe", "Cremige Kartoffelsuppe mit Würstchen - Soulfood für kalte Tage.", 4, 20, 35, "Suppe", _
        !"1. Kartoffeln schälen und würfeln.\n2. Zwiebeln und Lauch in Butter andünsten.\n3. Kartoffeln zugeben, kurz mitdünsten.\n4. Mit Brühe ablöschen und weichkochen.\n5. Teil der Kartoffeln pürieren für Cremigkeit.\n6. Sahne einrühren.\n7. Mit Muskat, Salz und Pfeffer würzen.\n8. Würstchen in Scheiben in der Suppe erwärmen.\n9. Mit Schnittlauch servieren.", _
        "Kartoffeln mehlig|800|g;Gemüsebrühe|1|Liter;Sahne|150|ml;Lauch|1|Stange;Zwiebel|1|Stück;Wiener Würstchen|4|Stück;Butter|40|g;Muskatnuss|1|Prise;Schnittlauch|1|Bund"))
    ARRAY_PUSH(k, katalogRezept("Königsberger Klopse", "Zarte Fleischklößchen in cremiger Kapernsauce - ostpreußischer Klassiker.", 4, 30, 25, "Hauptgericht", _
        !"1. Brötchen in Milch einweichen.\n2. Hackfleisch mit ausgedrücktem Brötchen, Ei und Zwiebeln mischen.\n3. Mit Salz, Pfeffer und Zitronenschale würzen.\n4. Klopse formen und in Salzwasser garziehen (nicht kochen!).\n5. Butter schmelzen, Mehl einrühren (Mehlschwitze).\n6. Mit Kochbrühe ablöschen, glatt rühren.\n7. Sahne und Eigelb einrühren.\n8. Kapern und Zitronensaft zugeben.\n9. Klopse in der Sauce servieren, dazu Reis.", _
        "Hackfleisch gemischt|500|g;Brötchen altbacken|1|Stück;Ei|1|Stück;Zwiebel|1|Stück;Kapern|3|EL;Sahne|200|ml;Eigelb|2|Stück;Butter|40|g;Mehl|40|g;Zitrone|1|Stück;Salz|1|TL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Frikadellen", "Deutsche Buletten - saftig gewürzt mit Senf und Zwiebeln.", 4, 20, 20, "Hauptgericht", _
        !"1. Brötchen in Wasser einweichen.\n2. Zwiebeln fein würfeln.\n3. Hackfleisch mit ausgedrücktem Brötchen mischen.\n4. Ei, Senf, Zwiebeln und Gewürze zugeben.\n5. Kräftig durchkneten.\n6. Flache Frikadellen formen.\n7. In heißem Öl von beiden Seiten braten.\n8. Bei mittlerer Hitze durchgaren.\n9. Mit Kartoffelsalat servieren.", _
        "Hackfleisch gemischt|500|g;Brötchen altbacken|1|Stück;Zwiebel|1|Stück;Ei|1|Stück;Senf|1|EL;Paprikapulver|1|TL;Majoran|1|TL;Petersilie|2|EL;Öl|4|EL;Salz|1|TL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Käsespätzle", "Schwäbischer Klassiker - Spätzle mit viel Käse und Röstzwiebeln.", 4, 30, 20, "Hauptgericht", _
        !"1. Mehl mit Eiern und Salz zu zähem Teig verarbeiten.\n2. Teig durch Spätzlepresse in kochendes Salzwasser drücken.\n3. Spätzle abschöpfen wenn sie aufschwimmen.\n4. Zwiebeln in Butter goldbraun rösten.\n5. Käse reiben.\n6. Spätzle schichtweise mit Käse in Auflaufform geben.\n7. Im Ofen bei 180°C überbacken bis Käse schmilzt.\n8. Mit Röstzwiebeln toppen.\n9. Mit grünem Salat servieren.", _
        "Mehl|400|g;Ei|4|Stück;Bergkäse gerieben|300|g;Emmentaler gerieben|100|g;Zwiebel|3|Stück;Butter|80|g;Salz|1|TL;Pfeffer|1|TL;Muskatnuss|1|Prise"))
    ARRAY_PUSH(k, katalogRezept("Maultaschen", "Schwäbische Teigtaschen gefüllt mit Fleisch und Spinat.", 4, 60, 15, "Hauptgericht", _
        !"1. Nudelteig aus Mehl, Eiern und Salz kneten.\n2. Spinat blanchieren und hacken.\n3. Hackfleisch mit Brötchen, Spinat und Gewürzen mischen.\n4. Teig dünn ausrollen.\n5. Füllung aufstreichen, Teig aufrollen.\n6. In Stücke schneiden oder Taschen formen.\n7. In Salzwasser oder Brühe garziehen.\n8. Mit zerlassener Butter und Röstzwiebeln servieren.\n9. Alternativ: In Brühe als Suppe.", _
        "Mehl|400|g;Ei|4|Stück;Hackfleisch gemischt|300|g;Spinat|200|g;Brötchen altbacken|1|Stück;Zwiebel|2|Stück;Petersilie|1|Bund;Butter|60|g;Salz|1|TL;Pfeffer|1|TL;Muskatnuss|1|Prise"))
    ARRAY_PUSH(k, katalogRezept("Kartoffelpuffer", "Knusprige Reibekuchen - perfekt mit Apfelmus oder herzhaft mit Lachs.", 4, 20, 20, "Hauptgericht", _
        !"1. Kartoffeln schälen und fein reiben.\n2. Zwiebel ebenfalls reiben.\n3. Masse gut ausdrücken.\n4. Eier und Mehl unterrühren.\n5. Mit Salz und Muskat würzen.\n6. In heißem Öl kleine Puffer ausbacken.\n7. Von beiden Seiten goldbraun braten.\n8. Auf Küchenpapier abtropfen lassen.\n9. Mit Apfelmus oder Räucherlachs servieren.", _
        "Kartoffeln festkochend|1|kg;Zwiebel|1|Stück;Ei|2|Stück;Mehl|3|EL;Öl zum Braten|150|ml;Salz|1|TL;Muskatnuss|1|Prise;Apfelmus|400|g"))
    ARRAY_PUSH(k, katalogRezept("Bratkartoffeln", "Knusprige Bratkartoffeln mit Speck und Zwiebeln - deutscher Klassiker.", 4, 10, 30, "Beilage", _
        !"1. Pellkartoffeln vom Vortag schälen und in Scheiben schneiden.\n2. Speck würfeln und in der Pfanne auslassen.\n3. Zwiebeln würfeln und mitbraten.\n4. Kartoffelscheiben zugeben.\n5. Bei mittlerer Hitze knusprig braten.\n6. Nicht zu oft wenden für Kruste.\n7. Mit Salz und Pfeffer würzen.\n8. Mit Petersilie bestreuen.\n9. Zu Spiegelei oder Fleisch servieren.", _
        "Pellkartoffeln vom Vortag|1|kg;Speck durchwachsen|150|g;Zwiebel|2|Stück;Butterschmalz|50|g;Petersilie|1|Bund;Salz|1|TL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Kartoffelklöße", "Traditionelle thüringische Klöße - halb und halb aus rohen und gekochten Kartoffeln.", 6, 45, 25, "Beilage", _
        !"1. Hälfte der Kartoffeln kochen und stampfen.\n2. Andere Hälfte roh reiben und auspressen.\n3. Gepresste Stärke aufheben.\n4. Rohe Masse mit heißer Kartoffelmasse überbrühen.\n5. Stärke und Salz unterkneten.\n6. Runde Klöße formen.\n7. Optional: Croutons in die Mitte drücken.\n8. In Salzwasser 20 Min. ziehen lassen.\n9. Zu Braten mit Sauce servieren.", _
        "Kartoffeln mehlig|1.5|kg;Kartoffelstärke|50|g;Salz|2|TL;Weißbrot für Croutons|100|g;Butter|50|g"))
    ARRAY_PUSH(k, katalogRezept("Kaiserschmarrn", "Fluffiger zerrissener Pfannkuchen mit Rosinen und Puderzucker.", 2, 15, 15, "Dessert", _
        !"1. Eigelb mit Milch, Mehl und Salz verrühren.\n2. Eiweiß steif schlagen.\n3. Vorsichtig unterheben.\n4. Rosinen optional in Rum einlegen.\n5. Butter in Pfanne erhitzen.\n6. Teig eingießen und stocken lassen.\n7. Wenden und mit Gabeln zerreißen.\n8. Mit Butter und Zucker karamellisieren.\n9. Mit Puderzucker bestäuben, Apfelmus dazu.", _
        "Mehl|150|g;Milch|200|ml;Ei|4|Stück;Zucker|30|g;Rosinen|50|g;Butter|50|g;Puderzucker|30|g;Salz|1|Prise;Apfelmus|200|g"))
    ARRAY_PUSH(k, katalogRezept("Apfelstrudel", "Knuspriger Strudel mit saftiger Apfelfüllung und Vanillesauce.", 8, 45, 40, "Dessert", _
        !"1. Strudelteig dünn ausziehen oder Fertigteig verwenden.\n2. Äpfel schälen und in dünne Scheiben schneiden.\n3. Mit Zucker, Zimt und Rosinen mischen.\n4. Semmelbrösel in Butter rösten.\n5. Brösel auf Teig verteilen.\n6. Äpfel darauf geben.\n7. Teig einrollen.\n8. Mit Butter bestreichen.\n9. Bei 180°C ca. 40 Min. goldbraun backen.\n10. Mit Puderzucker und Vanillesauce servieren.", _
        "Strudelteig|1|Packung;Äpfel säuerlich|1|kg;Zucker|100|g;Rosinen|50|g;Semmelbrösel|80|g;Butter|100|g;Zimt|1|TL;Puderzucker|30|g;Vanillesauce|250|ml"))
    ARRAY_PUSH(k, katalogRezept("Rote Grütze", "Norddeutsches Beerendessert mit Vanillesauce oder Sahne.", 4, 15, 10, "Dessert", _
        !"1. Beeren verlesen und waschen.\n2. Mit Zucker und Saft aufkochen.\n3. Speisestärke mit kaltem Wasser anrühren.\n4. Unter Rühren in die Früchte geben.\n5. Kurz aufkochen lassen.\n6. In Schalen füllen.\n7. Abkühlen lassen bis fest.\n8. Mit Vanillesauce oder Sahne servieren.", _
        "Himbeeren|250|g;Erdbeeren|250|g;Johannisbeeren|200|g;Kirschen entsteint|200|g;Zucker|150|g;Kirschsaft|200|ml;Speisestärke|40|g;Vanillesauce|250|ml"))
    ARRAY_PUSH(k, katalogRezept("Milchreis", "Cremiger Milchreis mit Zimt und Zucker - deutsches Comfort Food.", 4, 5, 40, "Dessert", _
        !"1. Milch mit Salz und Zucker aufkochen.\n2. Milchreis einrühren.\n3. Bei niedrigster Hitze 35-40 Min. quellen lassen.\n4. Regelmäßig umrühren.\n5. Butter unterrühren.\n6. In Schalen anrichten.\n7. Mit Zimt und Zucker bestreuen.\n8. Optional mit Kirschen servieren.", _
        "Milchreis|250|g;Milch|1|Liter;Zucker|80|g;Butter|30|g;Zimt|2|TL;Salz|1|Prise;Kirschen|200|g"))
    ARRAY_PUSH(k, katalogRezept("Currywurst", "Berliner Kultgericht - Bratwurst mit Curryketchup und Pommes.", 2, 10, 15, "Hauptgericht", _
        !"1. Bratwürste braten oder grillen.\n2. Ketchup mit Currypulver mischen.\n3. Würste in Scheiben schneiden.\n4. Curryketchup darüber geben.\n5. Mit extra Currypulver bestreuen.\n6. Mit Pommes servieren.\n7. Optional: Brötchen dazu.", _
        "Bratwurst|2|Stück;Ketchup|150|ml;Currypulver|2|EL;Pommes frites|400|g;Salz|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Labskaus", "Norddeutsches Seemannsgericht mit Corned Beef, Kartoffeln und Roter Bete.", 4, 20, 25, "Hauptgericht", _
        !"1. Kartoffeln kochen und stampfen.\n2. Zwiebeln in Butter glasig dünsten.\n3. Corned Beef zerkleinern und zugeben.\n4. Mit Kartoffelpüree mischen.\n5. Mit Salz, Pfeffer und Muskat würzen.\n6. Spiegeleier braten.\n7. Labskaus mit Spiegelei anrichten.\n8. Mit Rollmops und Roter Bete servieren.\n9. Gewürzgurke dazu.", _
        "Kartoffeln mehlig|600|g;Corned Beef|350|g;Zwiebel|2|Stück;Rote Bete|200|g;Gewürzgurken|4|Stück;Rollmops|4|Stück;Ei|4|Stück;Butter|50|g"))
    ARRAY_PUSH(k, katalogRezept("Grünkohl mit Pinkel", "Norddeutscher Winterklassiker - Grünkohl mit Kochwürsten.", 6, 30, 120, "Hauptgericht", _
        !"1. Grünkohl waschen, von Stielen befreien und hacken.\n2. Zwiebeln in Schmalz anbraten.\n3. Grünkohl zugeben und anschwitzen.\n4. Mit Brühe ablöschen.\n5. Speck und Kasseler zugeben.\n6. 1,5 Stunden köcheln lassen.\n7. Pinkel und Kohlwurst zugeben.\n8. Weitere 30 Min. garen.\n9. Mit Senf und Kartoffeln servieren.", _
        "Grünkohl|1.5|kg;Pinkelwurst|4|Stück;Kohlwurst|4|Stück;Kasseler|400|g;Speck durchwachsen|200|g;Zwiebel|2|Stück;Schmalz|50|g;Haferflocken|50|g;Gemüsebrühe|500|ml"))
    ARRAY_PUSH(k, katalogRezept("Himmel und Erde", "Rheinländisches Gericht mit Kartoffelpüree, Apfelmus und Blutwurst.", 4, 25, 30, "Hauptgericht", _
        !"1. Kartoffeln kochen und zu Püree stampfen.\n2. Mit Butter und Milch cremig rühren.\n3. Äpfel schälen und zu Mus kochen.\n4. Zwiebeln in Ringe schneiden.\n5. Zwiebeln in Butter goldbraun rösten.\n6. Blutwurst in Scheiben braten.\n7. Püree mit Apfelmus mischen oder getrennt anrichten.\n8. Blutwurst und Zwiebeln darauf geben.\n9. Mit Petersilie garnieren.", _
        "Kartoffeln mehlig|800|g;Äpfel säuerlich|500|g;Blutwurst|400|g;Zwiebel|3|Stück;Butter|80|g;Milch|100|ml;Zucker|2|EL;Salz|1|TL;Petersilie|1|Bund"))
    ARRAY_PUSH(k, katalogRezept("Handkäs mit Musik", "Hessische Spezialität - marinierter Sauermilchkäse mit Zwiebeln.", 2, 15, 0, "Vorspeise", _
        !"1. Zwiebeln fein würfeln.\n2. Mit Essig, Öl und Kümmel mischen.\n3. Handkäse in dicke Scheiben schneiden.\n4. Mit Zwiebelmarinade übergießen.\n5. Mindestens 2 Stunden marinieren.\n6. Mit frischem Brot servieren.\n7. Dazu passt Apfelwein.", _
        "Handkäse|4|Stück;Zwiebel|2|Stück;Essig|4|EL;Öl|4|EL;Kümmel|1|TL;Salz|1|TL;Pfeffer|1|TL;Bauernbrot|4|Scheiben"))
    ARRAY_PUSH(k, katalogRezept("Flammkuchen", "Elsässer Klassiker - dünner Teig mit Crème fraîche, Speck und Zwiebeln.", 2, 20, 15, "Hauptgericht", _
        !"1. Mehl mit Wasser, Öl und Salz zu Teig kneten.\n2. Teig sehr dünn ausrollen.\n3. Mit Crème fraîche bestreichen.\n4. Zwiebeln in dünne Ringe schneiden.\n5. Speck in Streifen schneiden.\n6. Zwiebeln und Speck auf Teig verteilen.\n7. Bei 250°C ca. 12-15 Min. backen.\n8. Der Rand sollte knusprig braun sein.\n9. Sofort heiß servieren.", _
        "Mehl|250|g;Wasser|125|ml;Öl|2|EL;Crème fraîche|200|g;Zwiebel|2|Stück;Speck durchwachsen|150|g;Salz|1|TL;Pfeffer|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Zwiebelkuchen", "Herzhafter Kuchen mit Zwiebeln und Speck - perfekt zum Federweißen.", 8, 40, 45, "Hauptgericht", _
        !"1. Hefeteig zubereiten und gehen lassen.\n2. Zwiebeln in Ringe schneiden.\n3. Speck würfeln und auslassen.\n4. Zwiebeln im Speckfett glasig dünsten.\n5. Abkühlen lassen.\n6. Sahne, Eier und Kümmel mischen.\n7. Zwiebeln unterheben.\n8. Teig in Form geben, Rand hochziehen.\n9. Füllung darauf verteilen.\n10. Bei 180°C ca. 45 Min. backen.", _
        "Mehl|300|g;Hefe|1|Würfel;Zwiebel|1|kg;Speck durchwachsen|150|g;Sahne|200|ml;Ei|3|Stück;Kümmel|1|TL;Butter|50|g;Salz|1|TL"))
    ARRAY_PUSH(k, katalogRezept("Falscher Hase", "Klassischer deutscher Hackbraten - außen knusprig, innen saftig.", 6, 25, 60, "Hauptgericht", _
        !"1. Brötchen in Wasser einweichen.\n2. Hackfleisch mit ausgedrücktem Brötchen mischen.\n3. Eier, Zwiebeln und Senf zugeben.\n4. Mit Salz, Pfeffer und Majoran würzen.\n5. Optional: Hartgekochte Eier in die Mitte.\n6. Zu Laib formen.\n7. In gefettete Auflaufform legen.\n8. Bei 180°C ca. 1 Stunde braten.\n9. Mit Bratenrückstand Sauce machen.\n10. Mit Kartoffeln servieren.", _
        "Hackfleisch gemischt|750|g;Brötchen altbacken|2|Stück;Ei|2|Stück;Zwiebel|2|Stück;Senf|2|EL;Majoran|1|TL;Ei hartgekocht|3|Stück;Salz|1|TL;Pfeffer|1|TL"))
    RETURN k
END FUNCTION

FUNCTION katalogRezept(name AS STRING, beschreibung AS STRING, portionen AS INTEGER, vorb AS INTEGER, koch AS INTEGER, kategorie AS STRING, anleitung AS STRING, zutaten AS STRING) AS Rezept
    DIM r AS Rezept : r = NEW Rezept()
    r.name = name
    r.beschreibung = beschreibung
    r.portionen = portionen
    r.vorb = vorb
    r.koch = koch
    r.kategorie = kategorie
    r.anleitung = anleitung
    r.zutaten = []
    DIM t AS STRING
    FOR EACH t IN SPLIT(zutaten, ";")
        DIM f AS ARRAY OF STRING : f = SPLIT(t, "|")
        DIM zu AS Zutat : zu = NEW Zutat()
        zu.name = f[0]
        zu.menge = VAL(f[1])
        zu.einheit = f[2]
        ARRAY_PUSH(r.zutaten, zu)
    NEXT
    r.zutatenZahl = LEN(r.zutaten)
    RETURN r
END FUNCTION
