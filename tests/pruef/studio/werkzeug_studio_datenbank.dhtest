=== der inspektor zeigt die datenbank, solange ihr reiter vorn ist
' Bis dahin zeigte er im Reiter einer Datenbank (oder eines Moduls) weiter
' das zuletzt offene Fenster samt seinen Feldern. Erster Lauf misst den
' Reiter des Fensters, der zweite oeffnet die Datenbank und klickt zurueck:
' dort sind die Felder des Fensters wieder da. Gezeigt wird die Folge der
' Reiter, der Inspektor-Koepfe und ob Felder protokolliert wurden.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
SETENV("DH_STUDIO_OEFFNEN", "Daten")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, "", 12, p)
DIM x AS INTEGER
DIM y AS INTEGER
slHin(10, 10)
slWarten(14)
(x, y) = slLage(log, "reiter 0")
slKlick(x, y)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM vorher AS STRING : vorher = ""
DIM folge AS STRING : folge = ""
DIM z AS STRING
FOR EACH z IN slProtokoll(log)
    DIM was AS STRING : was = ""
    IF LEFT$(z, 5) = "vorn " OR LEFT$(z, 18) = "inspektor element " THEN was = z
    IF LEFT$(z, 10) = "lage feld " THEN was = "felder"
    IF was <> "" AND was <> vorher THEN folge = folge + was + " | "
    IF was <> "" THEN vorher = was
NEXT
PRINT TRIM$(folge)
--- argumente
{sammlung}/../../../studio/studio.dh
--- datei laeufer.dh
IMPORT "db"
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
