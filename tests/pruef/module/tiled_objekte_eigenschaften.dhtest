=== name typ und rechteck lassen sich aendern
' (Bis Stufe 46 in test_tiled_objekte_eigenschaften.py.)
IMPORT "tiled"
IMPORT "json"
DIM m AS TILED_MAP : m = TILED_NEW(4, 4, 16, 16)
DIM t AS INTEGER : t = TILED_ADD_TILESET(m, "k.png", 4)
DIM o AS INTEGER : o = TILED_ADD_OBJECT_LAYER(m, "s")
DIM a1 AS INTEGER : a1 = TILED_ADD_OBJECT(m, "s", "a", "spawn", 0, 0, 16, 16)
DIM a2 AS INTEGER : a2 = TILED_ADD_OBJECT(m, "s", "b", "spawn", 32, 0, 16, 16)
DIM a3 AS INTEGER : a3 = TILED_ADD_OBJECT(m, "s", "c", "spawn", 64, 0, 16, 16)
TILED_OBJECT_SET_NAME(m, "s", 2, "cc")
TILED_OBJECT_SET_TYPE(m, "s", 2, "trigger")
TILED_OBJECT_SET_RECT(m, "s", 2, 10.5, 20.5, 8, 4)
TILED_SAVE(m, "karte.json")
DIM h AS JSON_HANDLE
FUNCTION wert$(pfad AS STRING) AS STRING
    DIM art AS STRING : art = JSON_TYPE(h, pfad)
    IF art = "boolean" THEN RETURN STR$(JSON_GET_BOOL(h, pfad))
    IF art = "string" THEN RETURN JSON_GET_STRING(h, pfad)
    RETURN STR$(JSON_GET_FLOAT(h, pfad))
END FUNCTION
FUNCTION props$(pfad AS STRING) AS STRING
    ' sortiert: die Reihenfolge in der Datei ist nicht festgelegt
    DIM teile AS ARRAY OF STRING
    teile = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(h, pfad) - 1
        DIM q AS STRING : q = pfad + "." + STR$(i)
        ARRAY_PUSH(teile, JSON_GET_STRING(h, q + ".name") + "=" + wert$(q + ".value") + ":" + JSON_GET_STRING(h, q + ".type"))
    NEXT
    SORT(teile)
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(teile) - 1
        r = r + teile[i] + " "
    NEXT
    RETURN TRIM$(r)
END FUNCTION
FUNCTION objektEbene$() AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(h, "layers") - 1
        IF JSON_GET_STRING(h, "layers." + STR$(i) + ".type") = "objectgroup" THEN RETURN "layers." + STR$(i)
    NEXT
    RETURN ""
END FUNCTION
FUNCTION objekt$(name AS STRING) AS STRING
    DIM eb AS STRING : eb = objektEbene$()
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(h, eb + ".objects") - 1
        IF JSON_GET_STRING(h, eb + ".objects." + STR$(i) + ".name") = name THEN RETURN eb + ".objects." + STR$(i)
    NEXT
    RETURN ""
END FUNCTION
FUNCTION kachel$(id AS INTEGER) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(h, "tilesets.0.tiles") - 1
        IF JSON_GET_INT(h, "tilesets.0.tiles." + STR$(i) + ".id") = id THEN RETURN "tilesets.0.tiles." + STR$(i)
    NEXT
    RETURN ""
END FUNCTION
h = JSON_LOAD("karte.json")
DIM cc AS STRING : cc = objekt$("cc")
PRINT JSON_GET_STRING(h, cc + ".type"); " "; JSON_GET_FLOAT(h, cc + ".x"); " "; JSON_GET_FLOAT(h, cc + ".y"); " "; JSON_GET_FLOAT(h, cc + ".width"); " "; JSON_GET_FLOAT(h, cc + ".height")
PRINT "c weg "; objekt$("c") = ""
--- erwartet
trigger 10.5 20.5 8.0 4.0
c weg TRUE
