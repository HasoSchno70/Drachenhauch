' Drei Handgriffe der IDE:
' (1) GROSS/klein/Anfangsbuchstaben Gross auf der Auswahl (sonst dem Wort)
'     und Zeilen verbinden (Einrueckung der ersten bleibt, " _" faellt weg).
' (2) Klammerpaare farbig: jede Tiefe eine eigene Farbe, am Bild geprueft.
' (3) Suchtreffer einzeln ersetzen: die Treffer der Projektsuche tragen
'     Haken, ersetzt wird nur in den angehakten Zeilen.
--- seriell
--- langsam

=== gross klein und anfangsbuchstaben auf auswahl und wort
DIM prTa AS GUI_WIDGET : prTa = tabFelder[aktiverTab]
DIM prZ1 AS INTEGER
DIM prS1 AS INTEGER
DIM prZ2 AS INTEGER
DIM prS2 AS INTEGER
GUI_TEXTAREA_SELECT(prTa, 1, 1, 1, 18)
befehl("fall_gross")
(prZ1, prS1, prZ2, prS2) = GUI_TEXTAREA_SELECTION_RANGE(prTa)
protokoll("pr gross |" + SPLIT$(GUI_TEXT(prTa), NL)[0] + "| " + STR$(prS1) + "-" + STR$(prS2))
befehl("fall_anfang")
protokoll("pr anfang |" + SPLIT$(GUI_TEXT(prTa), NL)[0] + "|")
befehl("fall_klein")
protokoll("pr klein |" + SPLIT$(GUI_TEXT(prTa), NL)[0] + "|")
' Ohne Auswahl: das Wort unter der Marke.
GUI_TEXTAREA_GOTO(prTa, 2, 3)
befehl("fall_gross")
protokoll("pr wort |" + SPLIT$(GUI_TEXT(prTa), NL)[1] + "|")
EXIT(0)
