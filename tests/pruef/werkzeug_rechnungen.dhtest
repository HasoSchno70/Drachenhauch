END SUB
SUB prMerke(z AS STRING)
    IF INSTR(prFlag, "|" + z + "|") < 0 THEN prFlag = prFlag + "|" + z + "|" + CHR$(10)
END SUB
SUB prSchreib(z AS STRING)
    IF z = "" THEN
        WRITEALL("probe.txt", prFlag)
    ELSE
        WRITEALL("probe.txt", prFlag + "|" + z + "|" + CHR$(10))
    END IF
END SUB
FUNCTION prJa$(b AS BOOLEAN) AS STRING
    RETURN IIF(b, "ja", "nein")
END FUNCTION
SUB prFall()
    prKlick(3, prMx(tfKName), prMy(tfKName))
    prTaste(7, 86, 341)
    prKlick(12, prMx(tfKPlz), prMy(tfKPlz))
    prTaste(16, 86, 341)
    prKlick(21, prMx(bKSpeichern), prMy(bKSpeichern))
    prAbspielen()
END SUB
