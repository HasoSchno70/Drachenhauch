=== bitwise lower than addition (1)
' `a + b BAND c` parsen als `(a + b) BAND c`, weil + hoehere Praezedenz hat.
PRINT 5 + 3 BAND 6
--- erwartet
0

=== bitwise lower than addition (2)
' `a + b BAND c` parsen als `(a + b) BAND c`, weil + hoehere Praezedenz hat.
PRINT 5 + 3 BAND 6
--- erwartet
0

=== bitwise higher than comparison (1)
' `a BAND b = c` parsen als `(a BAND b) = c`.
IF 12 BAND 4 = 4 THEN PRINT "yes" ELSE PRINT "no"
--- erwartet
yes

=== bitwise higher than comparison (2)
' `a BAND b = c` parsen als `(a BAND b) = c`.
IF 12 BAND 4 = 4 THEN PRINT "yes" ELSE PRINT "no"
--- erwartet
yes

=== bitwise left assoc (1)
' Alle Bitwise auf einer Ebene, links-assoziativ.
PRINT 1 BOR 2 BAND 3
--- erwartet
3

=== bitwise left assoc (2)
' Alle Bitwise auf einer Ebene, links-assoziativ.
PRINT 1 BOR 2 BAND 3
--- erwartet
3

=== explicit paren for c style (1)
' Wer C-Praezedenz will, klammert. (1 BOR (2 BAND 3)) = 3.
PRINT 1 BOR (2 BAND 3)
--- erwartet
3

=== explicit paren for c style (2)
' Wer C-Praezedenz will, klammert. (1 BOR (2 BAND 3)) = 3.
PRINT 1 BOR (2 BAND 3)
--- erwartet
3

