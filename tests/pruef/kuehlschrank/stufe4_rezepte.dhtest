=== vorschlaege: was kann ich kochen, ablaufende verwerten
' Nach Anteil im Bestand; Haken ab 50 % (vorbelegt ab 75 %) fuer das
' Fehlende. Ablaufende: Rezepte, die ein bald ablaufendes Produkt
' verwenden, Rang = 10 je solcher Zutat + Anteil.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slTaste(257)
slAufnahmeSchreiben(p + "/_studio/enter.txt")
PRINT "code "; kProbe(p, "probe.dh", "enter.txt", 60)
