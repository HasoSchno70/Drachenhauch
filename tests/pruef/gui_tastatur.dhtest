=== klappliste mit tastatur aufklappen und waehlen
' Enter klappt auf, Pfeil-ab wählt weiter, Enter übernimmt.
IMPORT "gui"
SCREEN(360, 240, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 300, 200)

DIM items AS ARRAY OF STRING
items = SPLIT$("rot|gruen|blau", "|")
DIM d AS GUI_WIDGET
d = GUI_DROPDOWN(w, 10, 10, 120, 24, items)

AUTOMATION_PLAY("ev.txt")
DIM f AS INTEGER
FOR f = 0 TO 11
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT

PRINT GUI_DROPDOWN_TEXT(d)
