' Tempo: Objektfelder in einer Schleife (10 000 Teilchen, 100 Schritte).
CLASS Teilchen
    DIM x AS FLOAT
    DIM y AS FLOAT
    DIM vx AS FLOAT
    DIM vy AS FLOAT
END CLASS
DIM n AS INTEGER : n = 10000
DIM teile[n] AS Teilchen
DIM i AS INTEGER
FOR i = 0 TO n - 1
    teile[i] = NEW Teilchen()
    teile[i].vx = (i MOD 7) - 3
    teile[i].vy = (i MOD 5) - 2
NEXT
DIM t0 AS FLOAT : t0 = TIMER()
DIM schritt AS INTEGER
FOR schritt = 1 TO 100
    FOR EACH t IN teile
        t.x = t.x + t.vx * 0.5
        t.y = t.y + t.vy * 0.5
        IF t.y > 100.0 THEN t.vy = 0.0 - t.vy
    NEXT
NEXT
PRINT "ZEIT "; (TIMER() - t0) * 1000.0
IF teile[9].x <> -50.0 OR teile[3].y = 0.0 THEN EXIT(1)
