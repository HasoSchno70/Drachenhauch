=== ausschnitt: eine seite zaehlt ihre stiche und spruenge neu
IMPORT "helfer.dh"
DIM sp AS kern.Stickpfad : sp = NEW kern.Stickpfad()
DIM p AS kern.Farbpfad : p = NEW kern.Farbpfad()
p.farbe = 2
p.xs = [0, 1, 9, 2, 3, 8] : p.ys = [0, 0, 0, 0, 5, 1]
ARRAY_PUSH(sp.pfade, p)
DIM q AS kern.Farbpfad : q = NEW kern.Farbpfad()
q.farbe = 0
q.xs = [7] : q.ys = [7]
ARRAY_PUSH(sp.pfade, q)
' (0,0) -> (2,3) -> (0,6): kein Schritt ueber 4; faellt (2,3) weg, ist es einer
DIM u AS kern.Farbpfad : u = NEW kern.Farbpfad()
u.farbe = 5
u.xs = [0, 2, 0] : u.ys = [0, 3, 6]
ARRAY_PUSH(sp.pfade, u)
SUB zeigen(t AS ARRAY OF kern.Farbpfad)
    DIM a AS kern.Farbpfad
    FOR EACH a IN t
        DIM z AS STRING : z = "  farbe " + STR$(a.farbe) + ":"
        DIM i AS INTEGER
        FOR i = 0 TO a.stiche() - 1
            z = z + " (" + STR$(a.xs[i]) + "," + STR$(a.ys[i]) + ")"
        NEXT
        PRINT z; " distanz "; FORMAT$(a.distanz, "%.3f"); " spruenge "; a.spruenge
    NEXT
    PRINT "  "; LEN(t); " farben"
END SUB
PRINT "links oben 0..4 x 0..4:"
zeigen(kern.spAusschnitt(sp, 0, 0, 4, 4))
PRINT "rechts 5..9 x 0..9:"
zeigen(kern.spAusschnitt(sp, 5, 0, 9, 9))
PRINT "unten 0..3 x 5..9 (der Stich bei 3,5 wird 3,0):"
zeigen(kern.spAusschnitt(sp, 0, 5, 3, 9))
PRINT "schmal 0..1 x 0..9 (ohne 2,3 wird es ein sprung):"
zeigen(kern.spAusschnitt(sp, 0, 0, 1, 9))
