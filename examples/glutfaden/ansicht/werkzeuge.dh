' Die Werkzeuge (PySticky ui/tools/): Stift, Radierer, Fuellen, Pipette,
' Linie, Rechteck, Ellipse, Vieleck, Hand -- und die Leiste, die sie waehlt.
' Auswahl, Lasso, Text, Rueckstich und Fortschritt (Stufe 3) stehen in
' ansicht/mehr.dh; hier wird nur dorthin verteilt.
'
' Symmetrie (PySticky MirrorMode): Striche, Formen, Fuellen und Rueckstiche
' werden gespiegelt (waagerecht, senkrecht, vierfach, achtfach nur bei
' quadratischen Mustern); Auswahl, Einfuegen und Text nicht -- wie dort.
'
' Die Zeichenflaeche meldet Zellen (wzDruck/wzZiehen/wzLos), die Werkzeuge
' entscheiden, was daraus wird. Alles, was das Muster aendert, geht ueber
' kern/bearbeiten.dh und damit in den Verlauf: ein Zug vom Druecken bis zum
' Loslassen ist ein Schritt.
'
' Wie im Original: die rechte Maustaste radiert in jedem Werkzeug, die
' mittlere verschiebt die Ansicht. Umschalt haelt Linien auf 0/45/90 Grad und
' macht aus Rechteck und Ellipse Quadrat und Kreis.

CONST WZ_STIFT = 0
CONST WZ_RADIERER = 1
CONST WZ_FUELLEN = 2
CONST WZ_PIPETTE = 3
CONST WZ_LINIE = 4
CONST WZ_RECHTECK = 5
CONST WZ_ELLIPSE = 6
CONST WZ_HAND = 7
CONST WZ_AUSWAHL = 8
CONST WZ_LASSO = 9
CONST WZ_VIELECK = 10
CONST WZ_TEXT = 11
CONST WZ_RUECKSTICH = 12
CONST WZ_FORTSCHRITT = 13
CONST WZ_FARBVERLAUF = 14
CONST WZ_ANZAHL = 15

CONST ZUG_KEINER = 0
CONST ZUG_WERKZEUG = 1
CONST ZUG_RADIEREN = 2
CONST ZUG_HAND = 3
CONST ZUG_MEHR = 4                    ' ein Zug eines Werkzeugs aus mehr.dh

DIM wzAktiv AS INTEGER                ' WZ_*
DIM wzGefuellt AS BOOLEAN             ' Rechteck und Ellipse gefuellt
DIM wzFarbe AS INTEGER                ' Farbnummer im Muster, -1 = keine
DIM wzStichart AS INTEGER             ' kern.VOLL ...
DIM wzVerlauf AS kern.Verlauf
DIM wzZug AS INTEGER
DIM wzStartX AS INTEGER
DIM wzStartY AS INTEGER
DIM wzLetzteX AS INTEGER
DIM wzLetzteY AS INTEGER
DIM wzVorschau AS ARRAY OF INTEGER    ' [x0, y0, ...], leer = keine
DIM wzVorschauFarben AS ARRAY OF INTEGER  ' je Punkt eine Farbe (Farbverlauf), sonst leer
DIM wzKnoepfe AS ARRAY OF INTEGER     ' Werkzeugknoepfe der Leiste
DIM wzKnopfSperre AS BOOLEAN          ' beim Umschalten nicht noch einmal ausloesen
DIM wzStichWahl AS INTEGER            ' GtkComboBoxText
DIM wzFarbeLeiste AS INTEGER          ' Farbfeld der aktuellen Farbe
DIM wzSpiegel AS INTEGER              ' kern.SPIEGEL_*
DIM wzSpiegelWahl AS INTEGER

' Die Sticharten der Auswahl, in der Reihenfolge der Kuerzel Alt+1 .. Alt+0
FUNCTION wzSticharten() AS ARRAY OF INTEGER
    RETURN [kern.VOLL, kern.HALB_OL_UR, kern.HALB_OR_UL, kern.VIERTEL_OL, kern.VIERTEL_OR, _
            kern.VIERTEL_UL, kern.VIERTEL_UR, kern.DREIVIERTEL, kern.KNOTEN, kern.PERLE]
END FUNCTION

FUNCTION wzStichartName$(t AS INTEGER) AS STRING
    SELECT CASE t
        CASE kern.VOLL : RETURN "Voller Stich"
        CASE kern.HALB_OL_UR : RETURN "Halbstich ╲"
        CASE kern.HALB_OR_UL : RETURN "Halbstich ╱"
        CASE kern.VIERTEL_OL : RETURN "Viertel oben links"
        CASE kern.VIERTEL_OR : RETURN "Viertel oben rechts"
        CASE kern.VIERTEL_UL : RETURN "Viertel unten links"
        CASE kern.VIERTEL_UR : RETURN "Viertel unten rechts"
        CASE kern.DREIVIERTEL : RETURN "Dreiviertelstich"
        CASE kern.KNOTEN : RETURN "Französischer Knoten"
        CASE kern.PERLE : RETURN "Perle"
    END SELECT
    RETURN "Stich " + STR$(t)
END FUNCTION

FUNCTION wzName$(nr AS INTEGER) AS STRING
    SELECT CASE nr
        CASE WZ_STIFT : RETURN "Stift ({wz_stift})"
        CASE WZ_RADIERER : RETURN "Radierer ({wz_radierer})"
        CASE WZ_FUELLEN : RETURN "Füllen ({wz_fuellen})"
        CASE WZ_PIPETTE : RETURN "Pipette ({wz_pipette})"
        CASE WZ_LINIE : RETURN "Linie ({wz_linie}) -- Umschalt: 0/45/90 Grad"
        CASE WZ_RECHTECK : RETURN "Rechteck ({wz_rechteck}, gefüllt {wz_rechteck_voll}) -- Umschalt beim Ziehen: Quadrat"
        CASE WZ_ELLIPSE : RETURN "Ellipse ({wz_ellipse}, gefüllt {wz_ellipse_voll}) -- Umschalt beim Ziehen: Kreis"
        CASE WZ_HAND : RETURN "Hand ({wz_hand}) -- Ansicht verschieben, auch mit der mittleren Maustaste"
        CASE WZ_AUSWAHL : RETURN "Auswahl ({wz_auswahl}) -- ziehen wählt, in die Auswahl ziehen verschiebt; {kopieren}/{ausschneiden}/{einfuegen}, Entf, F füllen, R drehen, H/V spiegeln"
        CASE WZ_LASSO : RETURN "Lasso ({wz_lasso}) -- freie Auswahl"
        CASE WZ_VIELECK : RETURN "Vieleck ({wz_vieleck}, gefüllt {wz_vieleck_voll}) -- Klick = Ecke, rechte Taste schließt, Rücktaste nimmt die letzte"
        CASE WZ_TEXT : RETURN "Text ({wz_text})"
        CASE WZ_RUECKSTICH : RETURN "Rückstich ({wz_rueckstich}) -- Klick für Klick eine Linie, rechte Taste entfernt"
        CASE WZ_FORTSCHRITT : RETURN "Fortschritt ({wz_fortschritt}) -- ziehen markiert erledigt, rechts zurück; Pfeile springen, Enter markiert"
        CASE WZ_FARBVERLAUF : RETURN "Farbverlauf ({wz_farbverlauf}) -- eine Linie ziehen: von der Start- zur Endfarbe, dazwischen die nächsten Farben der Palette"
    END SELECT
    RETURN ""
END FUNCTION

SUB werkzeugeStart()
    wzVerlauf = kern.neuerVerlauf()
    wzVorschau = []
    wzVorschauFarben = []
    wzFarbe = -1
    wzKnoepfe = []
    mrEcken = []
    mrLasso = []
    mrCursor = -1
END SUB

' Fuellen nach den Einstellungen (Werkzeuge -> Fuellen): ohne Toleranz und
' nicht diagonal der schnelle Weg von Anfang an.
FUNCTION wzFuellung(e AS kern.Ebene, x AS INTEGER, y AS INTEGER) AS ARRAY OF INTEGER
    IF einst.fuellToleranz = 0 AND NOT einst.fuellenDiagonal THEN RETURN kern.fuellung(e, x, y, wzFarbe)
    DIM n AS INTEGER : n = lwMuster.farbanzahl()
    DIM farben[n] AS INTEGER
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        farben[k] = lwMuster.farben[k].garn.farbe
    NEXT
    DIM ziel AS INTEGER : ziel = -1
    IF e.drin(x, y) THEN ziel = e.raster[y * e.breite + x]
    RETURN kern.fuellungWie(e, x, y, wzFarbe, kern.fuellPassend(farben, ziel, einst.fuellToleranz), einst.fuellenDiagonal)
END FUNCTION

' --- Waehlen ------------------------------------------------------------------------

SUB werkzeugWaehlen(nr AS INTEGER, gefuellt AS BOOLEAN)
    IF wzZug <> ZUG_KEINER THEN RETURN
    IF nr <> wzAktiv THEN mehrWechsel(nr)
    DIM vorher AS INTEGER : vorher = wzAktiv
    wzAktiv = nr
    IF vorher <> nr THEN stickzeitWerkzeug(vorher, nr)
    wzGefuellt = gefuellt AND wzKannGefuellt(nr)
    wzKnopfSperre = TRUE
    DIM i AS INTEGER
    FOR i = 0 TO LEN(wzKnoepfe) - 1
        IF wzKnoepfe[i] = 0 THEN CONTINUE
        gtk_toggle_button_set_active(wzKnoepfe[i], i = nr)
        gtk_widget_queue_draw(wzKnoepfe[i])
    NEXT
    wzKnopfSperre = FALSE
    verlaufLeisteZeigen(nr = WZ_FARBVERLAUF)
    leinwandZeiger()
    statusNachziehen()
END SUB

SUB wzKnopfGeklickt(knopf AS INTEGER, nr AS INTEGER)
    IF wzKnopfSperre THEN RETURN
    ' Ein zweiter Klick auf Rechteck, Ellipse oder Vieleck schaltet gefuellt um, wie im Original
    IF nr = wzAktiv AND wzKannGefuellt(nr) THEN
        werkzeugWaehlen(nr, NOT wzGefuellt)
    ELSE
        werkzeugWaehlen(nr, FALSE)
    END IF
END SUB

FUNCTION wzKannGefuellt(nr AS INTEGER) AS BOOLEAN
    RETURN nr = WZ_RECHTECK OR nr = WZ_ELLIPSE OR nr = WZ_VIELECK
END FUNCTION

SUB spiegelWaehlen(modus AS INTEGER)
    wzSpiegel = CLAMP(modus, 0, 4)
    IF wzSpiegelWahl <> 0 THEN
        IF gtk_combo_box_get_active(wzSpiegelWahl) <> wzSpiegel THEN gtk_combo_box_set_active(wzSpiegelWahl, wzSpiegel)
    END IF
    gtk_widget_queue_draw(lwFlaeche)
    statusNachziehen()
END SUB

FUNCTION spiegelName$(modus AS INTEGER) AS STRING
    SELECT CASE modus
        CASE 1 : RETURN "Spiegel ↔"
        CASE 2 : RETURN "Spiegel ↕"
        CASE 3 : RETURN "vierfach gespiegelt"
        CASE 4 : RETURN "achtfach gespiegelt"
    END SELECT
    RETURN "ohne Spiegel"
END FUNCTION

SUB wzSpiegelGeaendert(wahl AS INTEGER, daten AS INTEGER)
    spiegelWaehlen(gtk_combo_box_get_active(wahl))
END SUB

SUB stichartWaehlen(t AS INTEGER)
    wzStichart = t
    DIM arten AS ARRAY OF INTEGER : arten = wzSticharten()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(arten) - 1
        IF arten[i] = t AND wzStichWahl <> 0 THEN
            IF gtk_combo_box_get_active(wzStichWahl) <> i THEN gtk_combo_box_set_active(wzStichWahl, i)
        END IF
    NEXT
    statusNachziehen()
END SUB

SUB wzStichGeaendert(wahl AS INTEGER, daten AS INTEGER)
    DIM i AS INTEGER : i = gtk_combo_box_get_active(wahl)
    DIM arten AS ARRAY OF INTEGER : arten = wzSticharten()
    IF i >= 0 AND i < LEN(arten) THEN wzStichart = arten[i]
    statusNachziehen()
END SUB

' Die aktuelle Farbe; -1 = keine. Die Seitenleiste markiert sie.
SUB farbeWaehlen(nr AS INTEGER)
    IF NOT lwHat THEN RETURN
    IF nr >= lwMuster.farbanzahl() THEN nr = -1
    wzFarbe = nr
    seitenleisteFarbeMarkieren()
    farbleisteMarkieren()
    IF wzFarbeLeiste <> 0 THEN gtk_widget_queue_draw(wzFarbeLeiste)
    statusNachziehen()
END SUB

' --- Die Zeichenflaeche meldet --------------------------------------------------------

' Druck auf Zelle (x, y) -- die Zelle darf ausserhalb liegen. taste 1 links,
' 2 mitte, 3 rechts. Liefert ZUG_HAND, wenn die Flaeche verschieben soll.
FUNCTION wzDruck(x AS INTEGER, y AS INTEGER, taste AS INTEGER, umschalt AS BOOLEAN) AS INTEGER
    IF NOT lwHat OR wzZug <> ZUG_KEINER THEN RETURN ZUG_KEINER
    IF taste = 2 OR (taste = 1 AND wzAktiv = WZ_HAND) THEN
        wzZug = ZUG_HAND
        RETURN ZUG_HAND
    END IF
    IF mehrIstWerkzeug(wzAktiv) THEN
        ' rechts radiert auch hier, ausser dort, wo die rechte Taste etwas tut
        IF taste = 3 AND (wzAktiv = WZ_AUSWAHL OR wzAktiv = WZ_LASSO OR wzAktiv = WZ_TEXT) AND NOT mrEinfuegen THEN
            wzZug = ZUG_RADIEREN
            wzVerlauf.beginnen("Radieren")
            wzStrich(x, y, x, y, -1)
            RETURN wzZug
        END IF
        wzZug = mehrDruck(x, y, taste, umschalt)
        RETURN wzZug
    END IF
    IF taste = 3 THEN
        wzZug = ZUG_RADIEREN
        wzVerlauf.beginnen("Radieren")
        wzStrich(x, y, x, y, -1)
        RETURN wzZug
    END IF
    IF taste <> 1 THEN RETURN ZUG_KEINER
    wzStartX = x : wzStartY = y
    wzLetzteX = x : wzLetzteY = y
    SELECT CASE wzAktiv
        CASE WZ_STIFT, WZ_RADIERER
            IF wzAktiv = WZ_STIFT AND NOT wzFarbeDa() THEN RETURN ZUG_KEINER
            wzZug = ZUG_WERKZEUG
            wzVerlauf.beginnen(IIF(wzAktiv = WZ_STIFT, "Stift", "Radierer"))
            wzStrich(x, y, x, y, IIF(wzAktiv = WZ_STIFT, wzFarbe, -1))
        CASE WZ_FUELLEN
            IF NOT wzFarbeDa() THEN RETURN ZUG_KEINER
            DIM e AS kern.Ebene : e = lwMuster.ebenen.aktiveEbene()
            IF e.gesperrt THEN
                statusMeldung("Die Ebene „" + e.name + "“ ist gesperrt.")
                RETURN ZUG_KEINER
            END IF
            wzAnwenden(wzFuellung(e, x, y), wzFarbe, "Füllen")
        CASE WZ_PIPETTE
            DIM c AS INTEGER : c = lwMuster.stich(x, y)
            IF c >= 0 THEN
                farbeWaehlen(c)
                ' Einstellungen -> Werkzeuge -> Pipette
                IF einst.pipetteInfo THEN statusMeldung("Farbe aufgenommen: " + lwMuster.farben[c].garn.name + " (" + lwMuster.farben[c].symbol + ")")
                IF einst.pipetteDanach = 0 THEN werkzeugWaehlen(WZ_STIFT, FALSE)
                IF einst.pipetteDanach = 2 THEN werkzeugWaehlen(WZ_AUSWAHL, FALSE)
            END IF
        CASE WZ_LINIE, WZ_RECHTECK, WZ_ELLIPSE
            IF NOT wzFarbeDa() THEN RETURN ZUG_KEINER
            wzZug = ZUG_WERKZEUG
            wzVorschauBauen(x, y, umschalt)
        CASE WZ_FARBVERLAUF
            ' wie im Original: nur im Muster beginnen, das Ende wird hineingezogen
            IF x < 0 OR y < 0 OR x >= lwMuster.breite OR y >= lwMuster.hoehe THEN RETURN ZUG_KEINER
            IF lwMuster.farbanzahl() = 0 THEN
                statusMeldung("Erst Farben ins Muster holen -- der Verlauf nimmt sie aus der Palette.")
                RETURN ZUG_KEINER
            END IF
            wzZug = ZUG_WERKZEUG
            wzVorschauBauen(x, y, umschalt)
    END SELECT
    RETURN wzZug
END FUNCTION

SUB wzZiehen(x AS INTEGER, y AS INTEGER, umschalt AS BOOLEAN)
    SELECT CASE wzZug
        CASE ZUG_MEHR
            mehrZiehen(x, y, umschalt)
        CASE ZUG_RADIEREN
            wzStrich(wzLetzteX, wzLetzteY, x, y, -1)
        CASE ZUG_WERKZEUG
            IF wzAktiv = WZ_STIFT OR wzAktiv = WZ_RADIERER THEN
                wzStrich(wzLetzteX, wzLetzteY, x, y, IIF(wzAktiv = WZ_STIFT, wzFarbe, -1))
            ELSE
                wzVorschauBauen(x, y, umschalt)
            END IF
    END SELECT
    wzLetzteX = x : wzLetzteY = y
END SUB

SUB wzLos(x AS INTEGER, y AS INTEGER, umschalt AS BOOLEAN)
    DIM zug AS INTEGER : zug = wzZug
    wzZug = ZUG_KEINER
    SELECT CASE zug
        CASE ZUG_MEHR
            mehrLos(x, y, umschalt)
        CASE ZUG_RADIEREN
            wzVerlauf.beenden()
            nachAenderung()
        CASE ZUG_WERKZEUG
            IF wzAktiv = WZ_STIFT OR wzAktiv = WZ_RADIERER THEN
                wzVerlauf.beenden()
                nachAenderung()
            ELSE
                wzVorschauBauen(x, y, umschalt)
                DIM p AS ARRAY OF INTEGER : p = wzVorschau
                wzVorschau = []
                IF wzAktiv = WZ_FARBVERLAUF THEN
                    DIM pf AS ARRAY OF INTEGER : pf = wzVorschauFarben
                    wzVorschauFarben = []
                    wzVerlaufAnwenden(p, pf)
                    gtk_widget_queue_draw(lwFlaeche)
                    RETURN
                END IF
                DIM text AS STRING
                SELECT CASE wzAktiv
                    CASE WZ_LINIE : text = "Linie"
                    CASE WZ_RECHTECK : text = "Rechteck"
                    CASE ELSE : text = "Ellipse"
                END SELECT
                wzAnwenden(p, wzFarbe, text)
                gtk_widget_queue_draw(lwFlaeche)
            END IF
    END SELECT
END SUB

' Ein Strich von (x1, y1) nach (x2, y2) im offenen Zug -- jeder Punkt der
' Linie, damit ein schneller Zug keine Luecken laesst.
SUB wzStrich(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, farbe AS INTEGER)
    DIM p AS ARRAY OF INTEGER : p = kern.gespiegelt(kern.linie(x1, y1, x2, y2), lwMuster.breite, lwMuster.hoehe, wzSpiegel)
    DIM geaendert AS ARRAY OF INTEGER : geaendert = []
    DIM k AS INTEGER
    FOR k = 0 TO LEN(p) - 2 STEP 2
        IF kern.stichSetzen(lwMuster, wzVerlauf, p[k], p[k + 1], farbe, wzStichart) THEN
            ARRAY_PUSH(geaendert, p[k]) : ARRAY_PUSH(geaendert, p[k + 1])
        END IF
    NEXT
    IF LEN(geaendert) > 0 THEN
        leinwandZellen(geaendert)
        zustandNachziehen()
    ELSEIF NOT lwMuster.ebenen.aktiveEbene().gesperrt THEN
        RETURN
    ELSE
        statusMeldung("Die Ebene „" + lwMuster.ebenen.aktiveEbene().name + "“ ist gesperrt.")
    END IF
END SUB

' Eine fertige Form in einem Schritt setzen -- mit Symmetrie.
SUB wzAnwenden(p AS ARRAY OF INTEGER, farbe AS INTEGER, text AS STRING)
    wzAnwendenOhneSpiegel(kern.gespiegelt(p, lwMuster.breite, lwMuster.hoehe, wzSpiegel), farbe, text)
END SUB

' Der Farbverlauf: je Punkt eine eigene Farbe, mit Symmetrie (jedes
' Spiegelbild in der Farbe seines Punkts, wie _apply_changes_with_mirror)
SUB wzVerlaufAnwenden(p AS ARRAY OF INTEGER, f AS ARRAY OF INTEGER)
    IF LEN(p) = 0 THEN
        statusMeldung("Start- oder Endfarbe fehlt -- in der Leiste wählen.")
        RETURN
    END IF
    IF lwMuster.ebenen.aktiveEbene().gesperrt THEN
        statusMeldung("Die Ebene „" + lwMuster.ebenen.aktiveEbene().name + "“ ist gesperrt.")
        RETURN
    END IF
    DIM pp AS ARRAY OF INTEGER : pp = []
    DIM ff AS ARRAY OF INTEGER : ff = []
    DIM aa AS ARRAY OF INTEGER : aa = []
    DIM i AS INTEGER, k AS INTEGER
    FOR i = 0 TO LEN(f) - 1
        DIM s AS ARRAY OF INTEGER : s = kern.spiegelZellen(p[2 * i], p[2 * i + 1], lwMuster.breite, lwMuster.hoehe, wzSpiegel)
        FOR k = 0 TO LEN(s) - 2 STEP 2
            ARRAY_PUSH(pp, s[k]) : ARRAY_PUSH(pp, s[k + 1])
            ARRAY_PUSH(ff, f[i])
            ARRAY_PUSH(aa, wzStichart)
        NEXT
    NEXT
    DIM n AS INTEGER : n = kern.zellenSetzenJe(lwMuster, wzVerlauf, pp, ff, aa, "Farbverlauf")
    IF n > 0 THEN leinwandZellen(pp)
    nachAenderung()
END SUB

SUB wzAnwendenOhneSpiegel(p AS ARRAY OF INTEGER, farbe AS INTEGER, text AS STRING)
    IF LEN(p) = 0 THEN RETURN
    IF lwMuster.ebenen.aktiveEbene().gesperrt THEN
        statusMeldung("Die Ebene „" + lwMuster.ebenen.aktiveEbene().name + "“ ist gesperrt.")
        RETURN
    END IF
    DIM n AS INTEGER : n = kern.zellenSetzen(lwMuster, wzVerlauf, p, farbe, wzStichart, text)
    IF n > 0 THEN leinwandZellen(p)
    nachAenderung()
END SUB

SUB wzVorschauBauen(x AS INTEGER, y AS INTEGER, umschalt AS BOOLEAN)
    DIM ex AS INTEGER : ex = x
    DIM ey AS INTEGER : ey = y
    wzVorschauFarben = []
    SELECT CASE wzAktiv
        CASE WZ_FARBVERLAUF
            ex = CLAMP(x, 0, lwMuster.breite - 1)
            ey = CLAMP(y, 0, lwMuster.hoehe - 1)
            (wzVorschau, wzVorschauFarben) = kern.farbverlauf(lwMuster, wzStartX, wzStartY, ex, ey, fvlStart, fvlEnde)
        CASE WZ_LINIE
            IF umschalt THEN (ex, ey) = kern.winkelGerade(wzStartX, wzStartY, x, y)
            wzVorschau = kern.linie(wzStartX, wzStartY, ex, ey)
        CASE WZ_RECHTECK
            IF umschalt THEN (ex, ey) = kern.quadratEcke(wzStartX, wzStartY, x, y)
            wzVorschau = kern.rechteck(wzStartX, wzStartY, ex, ey, wzGefuellt)
        CASE WZ_ELLIPSE
            IF umschalt THEN (ex, ey) = kern.quadratEcke(wzStartX, wzStartY, x, y)
            wzVorschau = kern.ellipse(wzStartX, wzStartY, ex, ey, wzGefuellt)
    END SELECT
    gtk_widget_queue_draw(lwFlaeche)
END SUB

FUNCTION wzFarbeDa() AS BOOLEAN
    IF wzFarbe >= 0 AND wzFarbe < lwMuster.farbanzahl() THEN RETURN TRUE
    statusMeldung("Erst eine Farbe wählen -- rechts in der Liste oder aus dem Katalog.")
    RETURN FALSE
END FUNCTION

' --- Rueckgaengig ---------------------------------------------------------------------

' Die aktuelle Farbe folgt beim Zuruecknehmen und Wiederholen ihrem Eintrag:
' ein Schritt, der die Liste umstellt (Farben verwalten, Loeschen), nimmt nur
' die Liste zurueck -- die Nummer zeigte danach auf eine andere Farbe.
FUNCTION wzFarbKennung$(nr AS INTEGER) AS STRING
    IF nr < 0 OR nr >= lwMuster.farbanzahl() THEN RETURN ""
    DIM f AS kern.Farbeintrag : f = lwMuster.farben[nr]
    RETURN f.symbol + CHR$(1) + f.garn.name + CHR$(1) + HEX$(f.garn.farbe)
END FUNCTION

SUB wzFarbeWiederfinden(kennung AS STRING)
    wzFarbe = wzNummerWiederfinden(wzFarbe, kennung)
END SUB

FUNCTION wzNummerWiederfinden(nr AS INTEGER, kennung AS STRING) AS INTEGER
    IF kennung = "" OR wzFarbKennung$(nr) = kennung THEN RETURN nr
    DIM i AS INTEGER
    FOR i = 0 TO lwMuster.farbanzahl() - 1
        IF wzFarbKennung$(i) = kennung THEN RETURN i
    NEXT
    IF nr >= lwMuster.farbanzahl() THEN RETURN -1
    RETURN nr
END FUNCTION

' Vorher: die Kennungen von aktueller, Start- und Endfarbe; nachher dieselben
' Eintraege wieder (Rueckgaengig stellt die Liste um, nicht die Nummern)
FUNCTION wzKennungen() AS ARRAY OF STRING
    RETURN [wzFarbKennung$(wzFarbe), wzFarbKennung$(fvlStart), wzFarbKennung$(fvlEnde)]
END FUNCTION

SUB wzKennungenWiederfinden(k AS ARRAY OF STRING)
    wzFarbeWiederfinden(k[0])
    fvlStart = MAX(0, wzNummerWiederfinden(fvlStart, k[1]))
    fvlEnde = MAX(0, wzNummerWiederfinden(fvlEnde, k[2]))
END SUB

SUB werkzeugZurueck()
    IF wzZug <> ZUG_KEINER THEN RETURN
    DIM text AS STRING : text = wzVerlauf.textZurueck$()
    DIM kennung AS ARRAY OF STRING : kennung = wzKennungen()
    IF wzVerlauf.zurueckNehmen(lwMuster) THEN
        wzKennungenWiederfinden(kennung)
        allesNeu()
        statusMeldung("Zurückgenommen: " + text)
    END IF
END SUB

SUB werkzeugVor()
    IF wzZug <> ZUG_KEINER THEN RETURN
    DIM text AS STRING : text = wzVerlauf.textVor$()
    DIM kennung AS ARRAY OF STRING : kennung = wzKennungen()
    IF wzVerlauf.wiederholen(lwMuster) THEN
        wzKennungenWiederfinden(kennung)
        allesNeu()
        statusMeldung("Wiederholt: " + text)
    END IF
END SUB

' --- Die Leiste -------------------------------------------------------------------------

' Werkzeugknoepfe mit selbst gezeichneten Symbolen (Themen bringen nicht
' ueberall dieselben mit), dann die aktuelle Farbe und die Stichart.
FUNCTION werkzeugleisteNeu() AS INTEGER
    DIM box AS INTEGER : box = gtk_box_new(GTK_WAAGERECHT, 2)
    gtkKlasse(box, "werkzeuge")
    DIM folge AS ARRAY OF INTEGER : folge = [WZ_STIFT, WZ_RADIERER, WZ_FUELLEN, WZ_PIPETTE, -1, _
        WZ_LINIE, WZ_RECHTECK, WZ_ELLIPSE, WZ_VIELECK, WZ_FARBVERLAUF, -1, WZ_AUSWAHL, WZ_LASSO, WZ_TEXT, -1, _
        WZ_RUECKSTICH, WZ_FORTSCHRITT, -1, WZ_HAND]
    DIM kn[WZ_ANZAHL] AS INTEGER
    wzKnoepfe = kn
    DIM i AS INTEGER
    FOR EACH i IN folge
        IF i < 0 THEN
            gtk_box_pack_start(box, gtk_separator_new(GTK_SENKRECHT), FALSE, FALSE, 4)
            CONTINUE
        END IF
        DIM k AS INTEGER : k = gtk_toggle_button_new()
        gtk_widget_set_can_focus(k, FALSE)
        tipp(k, wzName$(i))
        DIM bild AS INTEGER : bild = gtk_drawing_area_new()
        gtk_widget_set_size_request(bild, 20, 20)
        signalZeichnen(bild, "draw", wzSymbolZeichnen, i, 0, 0)
        gtk_container_add(k, bild)
        signal(k, "toggled", wzKnopfGeklickt, i, 0, 0)
        gtk_box_pack_start(box, k, FALSE, FALSE, 0)
        wzKnoepfe[i] = k
    NEXT
    gtk_box_pack_start(box, gtk_separator_new(GTK_SENKRECHT), FALSE, FALSE, 4)
    wzFarbeLeiste = gtk_drawing_area_new()
    gtk_widget_set_size_request(wzFarbeLeiste, 26, 26)
    gtk_widget_set_valign(wzFarbeLeiste, GTK_AUSRICHTEN_MITTE)
    gtk_widget_set_tooltip_text(wzFarbeLeiste, "Aktuelle Farbe")
    signalZeichnen(wzFarbeLeiste, "draw", wzFarbeZeichnen, 0, 0, 0)
    gtk_box_pack_start(box, wzFarbeLeiste, FALSE, FALSE, 4)
    wzStichWahl = gtk_combo_box_text_new()
    gtk_widget_set_can_focus(wzStichWahl, FALSE)
    gtk_widget_set_tooltip_text(wzStichWahl, "Stichart (Alt+1 … Alt+0)")
    DIM t AS INTEGER
    FOR EACH t IN wzSticharten()
        gtk_combo_box_text_append_text(wzStichWahl, wzStichartName$(t))
    NEXT
    gtk_combo_box_set_active(wzStichWahl, 0)
    signal(wzStichWahl, "changed", wzStichGeaendert, 0, 0, 0)
    gtk_box_pack_start(box, wzStichWahl, FALSE, FALSE, 0)
    wzSpiegelWahl = gtk_combo_box_text_new()
    gtk_widget_set_can_focus(wzSpiegelWahl, FALSE)
    gtk_widget_set_tooltip_text(wzSpiegelWahl, "Symmetrie: Striche, Formen und Rückstiche gespiegelt (Achtfach nur bei quadratischen Mustern)")
    DIM sn AS STRING
    FOR EACH sn IN ["Ohne Spiegel", "Spiegel ↔", "Spiegel ↕", "Vierfach", "Achtfach"]
        gtk_combo_box_text_append_text(wzSpiegelWahl, sn)
    NEXT
    gtk_combo_box_set_active(wzSpiegelWahl, 0)
    signal(wzSpiegelWahl, "changed", wzSpiegelGeaendert, 0, 0, 0)
    gtk_box_pack_start(box, wzSpiegelWahl, FALSE, FALSE, 4)
    gtk_box_pack_start(box, verlaufLeisteNeu(), FALSE, FALSE, 4)
    werkzeugWaehlen(WZ_STIFT, FALSE)
    RETURN box
END FUNCTION

FUNCTION wzFarbeZeichnen(w AS INTEGER, cr AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM g AS FLOAT : g = gtk_widget_get_allocated_width(w)
    IF lwHat AND wzFarbe >= 0 AND wzFarbe < lwMuster.farbanzahl() THEN
        cairoFarbe(cr, lwMuster.farben[wzFarbe].garn.farbe)
        cairo_rectangle(cr, 0, 0, g, g)
        cairo_fill(cr)
    ELSE
        ' keine Farbe: Stoff mit rotem Schraegstrich
        cairoFarbe(cr, einst.stoff)
        cairo_rectangle(cr, 0, 0, g, g)
        cairo_fill(cr)
        cairo_set_source_rgb(cr, 0.85, 0.2, 0.2)
        cairo_set_line_width(cr, 2.0)
        cairo_move_to(cr, 2, g - 2)
        cairo_line_to(cr, g - 2, 2)
        cairo_stroke(cr)
    END IF
    cairo_set_source_rgba(cr, 1.0, 1.0, 1.0, 0.35)
    cairo_set_line_width(cr, 1.0)
    cairo_rectangle(cr, 0.5, 0.5, g - 1, g - 1)
    cairo_stroke(cr)
    RETURN TRUE
END FUNCTION

' Die Symbole: Striche auf 20 x 20, in der Textfarbe; das aktive Werkzeug in Glut.
FUNCTION wzSymbolZeichnen(w AS INTEGER, cr AS INTEGER, nr AS INTEGER) AS BOOLEAN
    IF nr = wzAktiv THEN
        cairo_set_source_rgb(cr, 1.0, 0.60, 0.25)
    ELSE
        cairo_set_source_rgb(cr, 0.84, 0.85, 0.88)
    END IF
    cairo_set_line_width(cr, 1.6)
    SELECT CASE nr
        CASE WZ_STIFT
            cairo_move_to(cr, 4, 16) : cairo_line_to(cr, 5, 12) : cairo_line_to(cr, 14, 3)
            cairo_line_to(cr, 17, 6) : cairo_line_to(cr, 8, 15) : cairo_close_path(cr)
            cairo_stroke(cr)
            cairo_move_to(cr, 12, 5) : cairo_line_to(cr, 15, 8) : cairo_stroke(cr)
        CASE WZ_RADIERER
            cairo_move_to(cr, 3, 13) : cairo_line_to(cr, 11, 5) : cairo_line_to(cr, 17, 11)
            cairo_line_to(cr, 12, 16) : cairo_line_to(cr, 6, 16) : cairo_close_path(cr)
            cairo_stroke(cr)
            cairo_move_to(cr, 7, 9) : cairo_line_to(cr, 13, 15) : cairo_stroke(cr)
        CASE WZ_FUELLEN
            cairo_move_to(cr, 3, 9) : cairo_line_to(cr, 9, 3) : cairo_line_to(cr, 15, 9)
            cairo_line_to(cr, 9, 15) : cairo_close_path(cr)
            cairo_stroke(cr)
            cairo_arc(cr, 16, 14, 2, 0, TAU) : cairo_fill(cr)
        CASE WZ_PIPETTE
            cairo_move_to(cr, 3, 17) : cairo_line_to(cr, 4, 13) : cairo_line_to(cr, 12, 5)
            cairo_line_to(cr, 15, 8) : cairo_line_to(cr, 7, 16) : cairo_close_path(cr)
            cairo_stroke(cr)
            cairo_arc(cr, 15, 5, 2.6, 0, TAU) : cairo_fill(cr)
        CASE WZ_LINIE
            cairo_move_to(cr, 3, 17) : cairo_line_to(cr, 17, 3) : cairo_stroke(cr)
        CASE WZ_RECHTECK
            cairo_rectangle(cr, 3.5, 5.5, 13, 10)
            IF wzGefuellt AND nr = wzAktiv THEN cairo_fill(cr) ELSE cairo_stroke(cr)
        CASE WZ_ELLIPSE
            cairo_save(cr)
            cairo_translate(cr, 10, 10)
            cairo_scale(cr, 1.0, 0.72)
            cairo_arc(cr, 0, 0, 7, 0, TAU)
            cairo_restore(cr)
            IF wzGefuellt AND nr = wzAktiv THEN cairo_fill(cr) ELSE cairo_stroke(cr)
        CASE WZ_VIELECK
            cairo_move_to(cr, 3, 15) : cairo_line_to(cr, 6, 4) : cairo_line_to(cr, 17, 7)
            cairo_line_to(cr, 13, 17) : cairo_close_path(cr)
            IF wzGefuellt AND nr = wzAktiv THEN cairo_fill(cr) ELSE cairo_stroke(cr)
        CASE WZ_AUSWAHL
            wzGestrichelt(cr, 3.5, 4.5, 16.5, 4.5)
            wzGestrichelt(cr, 16.5, 4.5, 16.5, 15.5)
            wzGestrichelt(cr, 16.5, 15.5, 3.5, 15.5)
            wzGestrichelt(cr, 3.5, 15.5, 3.5, 4.5)
        CASE WZ_LASSO
            cairo_save(cr)
            cairo_translate(cr, 10, 8)
            cairo_scale(cr, 1.0, 0.6)
            cairo_arc(cr, 0, 0, 7, 0, TAU)
            cairo_restore(cr)
            cairo_stroke(cr)
            cairo_move_to(cr, 6, 12) : cairo_line_to(cr, 5, 17) : cairo_line_to(cr, 8, 15)
            cairo_stroke(cr)
        CASE WZ_TEXT
            cairo_move_to(cr, 4, 4) : cairo_line_to(cr, 16, 4) : cairo_stroke(cr)
            cairo_move_to(cr, 10, 4) : cairo_line_to(cr, 10, 17) : cairo_stroke(cr)
            cairo_move_to(cr, 7, 17) : cairo_line_to(cr, 13, 17) : cairo_stroke(cr)
        CASE WZ_RUECKSTICH
            cairo_move_to(cr, 3, 15) : cairo_line_to(cr, 8, 10) : cairo_stroke(cr)
            cairo_move_to(cr, 10, 8) : cairo_line_to(cr, 15, 3) : cairo_stroke(cr)
            cairo_arc(cr, 3, 15, 1.6, 0, TAU) : cairo_fill(cr)
            cairo_arc(cr, 9, 9, 1.6, 0, TAU) : cairo_fill(cr)
            cairo_arc(cr, 16, 3, 1.6, 0, TAU) : cairo_fill(cr)
        CASE WZ_FARBVERLAUF
            ' vier Kaestchen von Glut nach Blau
            DIM vk AS INTEGER
            FOR vk = 0 TO 3
                cairo_set_source_rgb(cr, (255 - vk * 60) / 255.0, (138 - vk * 10) / 255.0, (61 + vk * 50) / 255.0)
                cairo_rectangle(cr, 2 + vk * 4, 6, 4, 8)
                cairo_fill(cr)
            NEXT
            IF nr = wzAktiv THEN cairo_set_source_rgb(cr, 1.0, 0.60, 0.25) ELSE cairo_set_source_rgb(cr, 0.84, 0.85, 0.88)
            cairo_rectangle(cr, 1.5, 5.5, 17, 9)
            cairo_stroke(cr)
        CASE WZ_FORTSCHRITT
            cairo_set_line_width(cr, 2.2)
            cairo_move_to(cr, 3, 10) : cairo_line_to(cr, 8, 15) : cairo_line_to(cr, 17, 4)
            cairo_stroke(cr)
        CASE WZ_HAND
            ' vier Pfeile
            cairo_move_to(cr, 10, 2) : cairo_line_to(cr, 10, 18) : cairo_stroke(cr)
            cairo_move_to(cr, 2, 10) : cairo_line_to(cr, 18, 10) : cairo_stroke(cr)
            cairo_move_to(cr, 7, 5) : cairo_line_to(cr, 10, 2) : cairo_line_to(cr, 13, 5) : cairo_stroke(cr)
            cairo_move_to(cr, 7, 15) : cairo_line_to(cr, 10, 18) : cairo_line_to(cr, 13, 15) : cairo_stroke(cr)
            cairo_move_to(cr, 5, 7) : cairo_line_to(cr, 2, 10) : cairo_line_to(cr, 5, 13) : cairo_stroke(cr)
            cairo_move_to(cr, 15, 7) : cairo_line_to(cr, 18, 10) : cairo_line_to(cr, 15, 13) : cairo_stroke(cr)
    END SELECT
    RETURN TRUE
END FUNCTION

' Eine gestrichelte Linie (fuer das Auswahl-Symbol).
SUB wzGestrichelt(cr AS INTEGER, x1 AS FLOAT, y1 AS FLOAT, x2 AS FLOAT, y2 AS FLOAT)
    DIM l AS FLOAT : l = HYPOT(x2 - x1, y2 - y1)
    DIM n AS INTEGER : n = MAX(1, ROUND(l / 3))
    DIM k AS INTEGER
    FOR k = 0 TO n - 1 STEP 2
        cairo_move_to(cr, x1 + (x2 - x1) * k / n, y1 + (y2 - y1) * k / n)
        cairo_line_to(cr, x1 + (x2 - x1) * (k + 1) / n, y1 + (y2 - y1) * (k + 1) / n)
    NEXT
    cairo_stroke(cr)
END SUB

' --- Tasten ------------------------------------------------------------------------------

' Kuerzel der Werkzeuge; TRUE, wenn die Taste genommen wurde.
FUNCTION werkzeugTaste(t AS INTEGER, strg AS BOOLEAN, alt AS BOOLEAN) AS BOOLEAN
    IF strg THEN RETURN FALSE
    IF NOT alt THEN
        IF mehrTaste(t) THEN RETURN TRUE
    END IF
    IF alt THEN
        ' Alt+1 .. Alt+9, Alt+0 = die zehnte
        DIM arten AS ARRAY OF INTEGER : arten = wzSticharten()
        IF t >= &H31 AND t <= &H39 THEN
            stichartWaehlen(arten[t - &H31])
            RETURN TRUE
        END IF
        IF t = &H30 THEN
            stichartWaehlen(arten[9])
            RETURN TRUE
        END IF
        RETURN FALSE
    END IF
    ' Die Buchstaben der Werkzeuge stehen in der Kuerzel-Tafel (befehlAusfuehren)
    SELECT CASE t
        CASE &HFF1B                                                    ' ESC: Form abbrechen
            IF wzZug = ZUG_WERKZEUG AND LEN(wzVorschau) > 0 THEN
                wzZug = ZUG_KEINER
                wzVorschau = []
                wzVorschauFarben = []
                gtk_widget_queue_draw(lwFlaeche)
            END IF
        CASE ELSE : RETURN FALSE
    END SELECT
    RETURN TRUE
END FUNCTION
