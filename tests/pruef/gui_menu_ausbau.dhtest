IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM s AS INTEGER : s = GUI_SUBMENU(m, "Zuletzt")
DIM z AS INTEGER : z = GUI_MENU_ITEM(s, "alt.dh")
DIM c AS INTEGER : c = GUI_CONTEXT(w)
DIM ci AS INTEGER : ci = GUI_MENU_ITEM(c, "Kontext")
DIM f AS INTEGER
FOR f = 1 TO 10
    GUI_UPDATE()
    IF GUI_CLICKED(ci) THEN PRINT "kontext"
    IF GUI_CLICKED(z) THEN PRINT "unter"
    GUI_DRAW()
    FLIP()
NEXT
