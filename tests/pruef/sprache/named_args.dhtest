' Aus test_named_args.py uebertragen (15 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== all named
SUB f(a AS INTEGER, b AS INTEGER)
    PRINT a, b
END SUB
f(a: 1, b: 2)
--- erwartet
1 2

=== named can reorder
SUB f(a AS INTEGER, b AS INTEGER)
    PRINT a, b
END SUB
f(b: 99, a: 7)
--- erwartet
7 99

=== positional then named
SUB f(a AS INTEGER, b AS INTEGER, c AS INTEGER)
    PRINT a, b, c
END SUB
f(1, b: 2, c: 3)
--- erwartet
1 2 3

=== named skips to later default
' Named-Arg auf einen Param mit Default - Slots dazwischen kriegen Default.
SUB f(a AS INTEGER, b AS INTEGER = 10, c AS INTEGER = 20)
    PRINT a, b, c
END SUB
f(1, c: 3)
--- erwartet
1 10 3

=== named only with defaults
SUB f(a AS INTEGER = 1, b AS INTEGER = 2, c AS INTEGER = 3)
    PRINT a, b, c
END SUB
f(c: 99)
--- erwartet
1 2 99

=== default with string
SUB g(name AS STRING, greet AS STRING = "Hallo", suffix AS STRING = "!")
    PRINT greet + ", " + name + suffix
END SUB
g(name: "Anna")
g("Bob", suffix: "?")
--- erwartet
Hallo, Anna!
Hallo, Bob?

=== named args in function
FUNCTION add(a AS INTEGER, b AS INTEGER = 10) AS INTEGER
    RETURN a + b
END FUNCTION
PRINT add(a: 5, b: 7)
PRINT add(b: 100, a: 1)
PRINT add(2)
--- erwartet
12
101
12

=== named in new class
CLASS P
    DIM n AS STRING
    DIM a AS INTEGER
    SUB Init(n AS STRING, a AS INTEGER = 0)
        MyName = n
        MyAge = a
    END SUB
    SUB Show()
        PRINT MyName, MyAge
    END SUB
END CLASS
CLASS Person
    DIM mname AS STRING
    DIM mage AS INTEGER
    SUB Init(name AS STRING, age AS INTEGER = 0)
        mname = name
        mage = age
    END SUB
    SUB Show()
        PRINT mname, mage
    END SUB
END CLASS
DIM p AS Person
p = NEW Person(name: "Anna", age: 30)
p.Show()
p = NEW Person("Bob")
p.Show()
p = NEW Person(age: 50, name: "Cara")
p.Show()
--- erwartet
Anna 30
Bob 0
Cara 50

=== unknown name raises
SUB f(a AS INTEGER)
END SUB
f(schwurbel: 1)
--- fehler
f: kein Parameter 'schwurbel'

=== duplicate named raises
SUB f(a AS INTEGER)
END SUB
f(a: 1, a: 2)
--- fehler
f: Parameter 'a' doppelt belegt

=== positional and named overlap raises
' Slot via positional UND named ist auch 'doppelt belegt'.
SUB f(a AS INTEGER, b AS INTEGER)
END SUB
f(1, a: 2)
--- fehler
f: Parameter 'a' doppelt belegt

=== positional after named raises
SUB f(a AS INTEGER, b AS INTEGER)
END SUB
f(a: 1, 2)
--- fehler
f: positional Argument nach Named-Arg

=== missing required param raises
SUB f(a AS INTEGER, b AS INTEGER)
END SUB
f(b: 2)
--- fehler
f: Parameter 'a' fehlt

=== benannte argumente an builtins
' Die Namen kommen aus der Signatur in daten/builtin_index.json. Ein Name
' darf ein Schluesselwort sein (new) und ein $ tragen.
PRINT ABS(v: -5)
PRINT MID$("Drachenhauch", start: 0, n: 7)
PRINT MID$(s: "Drachenhauch", n: 4, start: 2)
PRINT CLAMP(hi: 10, lo: 0, v: 15)
PRINT REPLACE$("a-b-c", old: "-", new: "+")
PRINT REPLACE_BETWEEN$("a[b]c", "[", "]", new$: "X")
--- erwartet
5
Drachen
ache
10
a+b+c
a[X]c

=== builtin luecke bekommt die vorgabe aus dem index
' second ist benannt, hour und minute fuellt ihre Vorgabe (= 0).
IMPORT "zeit"
PRINT TIME_FROM_PARTS(2026, 11, 18, second: 30) = TIME_FROM_PARTS(2026, 11, 18, 0, 0, 30)
PRINT TIME_FROM_PARTS(day: 18, month: 11, year: 2026) = TIME_FROM_PARTS(2026, 11, 18)
--- erwartet
TRUE
TRUE

=== range mit namen
' Der erste Parameter heisst start_or_stop: allein ist er das Ende.
DIM i AS INTEGER
DIM s AS STRING : s = ""
FOR EACH i IN RANGE(start_or_stop: 3)
    s = s + STR$(i)
NEXT
PRINT s
s = ""
FOR EACH i IN RANGE(start_or_stop: 10, stop: 0, step: -3)
    s = s + STR$(i) + " "
NEXT
PRINT TRIM$(s)
--- erwartet
012
10 7 4 1

=== builtin unbekannter parametername
PRINT ABS(wert: -5)
--- fehler
ABS: kein Parameter 'wert'. Die Parameter heissen v

=== builtin luecke ohne vorgabe
' Ohne color behaelt das Fenster seine Lichtfarbe -- kein Wert sagt dasselbe,
' darum hat color im Index keine Vorgabe, und wer duration_ms benennt, gibt
' color mit an.
GUI_WINDOW_GLOW(1, duration_ms: 500)
--- fehler
GUI_WINDOW_GLOW: 'color' hat keine Vorgabe -- wer 'duration_ms' benennt, gibt 'color' mit an

=== builtin luecke mit vorgabe aus dem index
' ARC zeichnet ohne color weiss; der Index sagt color = &HFFFFFF. Nur
' uebersetzt (die SUB laeuft nie) -- gezeichnet wird ohne Fenster nicht.
SUB nie()
    ARC(1, 2, 3, 4, 0.0, 1.0, width: 3)
END SUB
PRINT "uebersetzt"
--- erwartet
uebersetzt

=== builtin pflichtparameter fehlt
PRINT CLAMP(15, lo: 0)
--- fehler
CLAMP: Parameter 'hi' fehlt

=== builtin doppelt belegt
PRINT CLAMP(15, lo: 0, hi: 3, v: 1)
--- fehler
CLAMP: Parameter 'v' ist doppelt belegt

=== builtin wert nach stelle hinter benanntem
PRINT CLAMP(v: 15, 0, 3)
--- fehler
CLAMP: nach einem benannten Argument muessen alle weiteren benannt sein

=== builtin ohne parameternamen
GUI_RULE(1, x: 2)
--- fehler
GUI_RULE: benannte Argumente gehen hier nicht

=== eigene funktion verdeckt den builtin
' Heisst eine eigene FUNCTION wie ein Builtin, gelten ihre Namen.
FUNCTION clamp(wert AS INTEGER, unten AS INTEGER, oben AS INTEGER) AS INTEGER
    RETURN unten
END FUNCTION
PRINT clamp(oben: 1, unten: 7, wert: 3)
--- erwartet
7

=== tw and vm match
SUB g(name AS STRING, age AS INTEGER, greet AS STRING = "Hi", excl AS STRING = ".")
    PRINT greet + ", " + name + " (" + STR$(age) + ")" + excl
END SUB
g("Anna", 30)
g(name: "Bob", age: 25)
g("Cara", 40, excl: "!")
g(name: "Dora", age: 50, greet: "Hey")
--- erwartet
Hi, Anna (30).
Hi, Bob (25).
Hi, Cara (40)!
Hey, Dora (50).


=== ein vertippter name einer eigenen funktion bekommt einen vorschlag
' Wie bei den Builtins (2026-11-19, gefunden am Buch "Kleine Wunder"):
' vorher nur "kein Parameter 'hohe'", ohne Hinweis auf "hoehe".
FUNCTION flaeche(breite AS FLOAT, hoehe AS FLOAT = 1.0) AS FLOAT
    RETURN breite * hoehe
END FUNCTION
PRINT flaeche(breite: 5, hohe: 2)
--- fehler
flaeche: kein Parameter 'hohe'. Meintest du hoehe? Die Parameter heissen breite, hoehe

=== eine vorgabe darf die gleichnamige konstante meinen
' `ring AS FLOAT = RING`: Namen kennen keine Gross-/Kleinschreibung, der
' Parameter heisst wie die Konstante. Die Vorgabe meint die Konstante --
' bis 2026-11-19 las sie den (noch leeren) Parameter selbst und brach mit
' "Erwartet FLOAT, erhalten NIL" ab, ohne Zeile. Eine fruehere Vorgabe darf
' weiter einen frueheren Parameter nehmen.
CONST RING = 220
FUNCTION innen(rad AS FLOAT, ring AS FLOAT = RING, rest AS FLOAT = ring - rad) AS FLOAT
    RETURN rest
END FUNCTION
PRINT innen(84)
PRINT innen(84, ring: 100)
PRINT innen(84, rest: 1)
--- erwartet
136.0
16.0
1.0

=== ein fehler in einer vorgabe nennt die kopfzeile der funktion
DIM teiler AS INTEGER : teiler = 0
FUNCTION anteil(x AS INTEGER = 10 \ teiler) AS INTEGER
    RETURN x
END FUNCTION
PRINT anteil(3)
PRINT anteil()
--- erwartet
3
--- fehler
fall.dh:2: Integer-Division durch 0

=== ein parameter nimmt auch seinen zweitnamen
' Rangliste Punkt 9 (B6): die Parameternamen im Index sind zugesagt, aber
' uneinheitlich -- FILE_EXISTS(p) neben FILE_SIZE(path), ROUND(x, digits)
' neben NUMFMT$(x, decimals), SQR(v) neben SQRT(number). Ein benanntes
' Argument nimmt jetzt auch den anderen Namen der Gruppe (compiler.rs,
' PARAM_ZWEITNAMEN). Bis 2026.53: "FILE_EXISTS: kein Parameter 'path'".
WRITEALL("da.txt", "x")
PRINT FILE_EXISTS(path: "da.txt")
PRINT ROUND(5.678, decimals: 1)
PRINT SQR(number: 16)
RENAME(alt: "da.txt", new: "dort.txt")
PRINT FILE_EXISTS(p: "dort.txt")
--- erwartet
TRUE
5.7
4.0
TRUE

=== ein unbekannter name bleibt ein fehler
PRINT ROUND(5.678, stellen: 1)
--- fehler
ROUND: kein Parameter 'stellen'
