--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
PRINT "angeboten "; hat("wiederherstellung angeboten 1")
PRINT "spaeter "; hat("wiederherstellung spaeter")
PRINT "stand liegt noch "; FILEEXISTS("_programm/wiederherstellung/alt/stand.json")
PRINT "staende "; JOIN$(DIRLIST("_programm/wiederherstellung"), ",")
--- erwartet
angeboten TRUE
spaeter TRUE
stand liegt noch TRUE
staende alt

=== der stand einer laufenden ide wird nicht angefasst
' Lebenszeichen von eben, als offen markiert: das ist eine zweite IDE, die
' gerade laeuft. Sie darf weder angeboten noch weggeraeumt werden.
--- programm ../../ide/ide.dh nach SETFPS(60)
--- umgebung
DHRT_FRAMES=60
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- vorher
IMPORT "json"
IMPORT "zeit"
DIM h AS JSON_HANDLE : h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "zeit", ZEIT_JETZT())
JSON_SET_BOOL(h, "offen", TRUE)
JSON_SET_JSON(h, "reiter", JSON_NEW_ARRAY())
DIM f AS JSON_HANDLE : f = JSON_NEW_OBJECT()
JSON_SET_STRING(f, "pfad", "")
JSON_SET_STRING(f, "text", "PRINT 4")
JSON_APPEND_JSON(h, "reiter", f)
MKDIR("_programm/wiederherstellung")
MKDIR("_programm/wiederherstellung/lebt")
WRITEALL("_programm/wiederherstellung/lebt/stand.json", JSON_STRINGIFY(h))
--- nachher
IMPORT "json"
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM angeboten AS BOOLEAN : angeboten = FALSE
DIM z AS STRING
FOR EACH z IN L
    IF LEFT$(z, 28) = "wiederherstellung angeboten " THEN angeboten = TRUE
NEXT
PRINT "angeboten "; angeboten
DIM h AS JSON_HANDLE : h = JSON_LOAD("_programm/wiederherstellung/lebt/stand.json")
PRINT "stand unveraendert "; JSON_GET_STRING(h, "reiter.0.text")
PRINT "staende "; JOIN$(DIRLIST("_programm/wiederherstellung"), ",")
--- erwartet
angeboten FALSE
stand unveraendert PRINT 4
staende lebt

=== ein abgestuerzter lauf wird angeboten, ein leerer still entfernt
' Ein Absturz meldet sich nicht ab: der Stand steht noch auf offen, aber
' sein Lebenszeichen ist alt. Der leere Stand daneben hat nichts zu bieten
' und verschwindet ohne Frage.
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- umgebung
DHRT_FRAMES=80
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei _programm/ev.txt
c 2
e 20 2 256 0 0 0
e 22 1 256 0 0 0

--- vorher
IMPORT "json"
IMPORT "zeit"
DIM h AS JSON_HANDLE : h = JSON_NEW_OBJECT()
JSON_SET_INT(h, "zeit", ZEIT_JETZT() - 5000)
JSON_SET_BOOL(h, "offen", TRUE)
JSON_SET_JSON(h, "reiter", JSON_NEW_ARRAY())
DIM f AS JSON_HANDLE : f = JSON_NEW_OBJECT()
JSON_SET_STRING(f, "pfad", "")
JSON_SET_STRING(f, "text", "PRINT 5")
JSON_APPEND_JSON(h, "reiter", f)
MKDIR("_programm/wiederherstellung")
MKDIR("_programm/wiederherstellung/absturz")
WRITEALL("_programm/wiederherstellung/absturz/stand.json", JSON_STRINGIFY(h))
DIM g AS JSON_HANDLE : g = JSON_NEW_OBJECT()
JSON_SET_INT(g, "zeit", ZEIT_JETZT() - 5000)
JSON_SET_BOOL(g, "offen", FALSE)
JSON_SET_JSON(g, "reiter", JSON_NEW_ARRAY())
MKDIR("_programm/wiederherstellung/leer")
WRITEALL("_programm/wiederherstellung/leer/stand.json", JSON_STRINGIFY(g))
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
PRINT "angeboten "; hat("wiederherstellung angeboten 1")
PRINT "staende "; JOIN$(DIRLIST("_programm/wiederherstellung"), ",")
--- erwartet
angeboten TRUE
staende absturz

=== ohne aenderungen verschwindet der eigene stand beim ende
' Das Lebenszeichen entsteht gleich beim Start (auch ohne ungesicherte
' Reiter), und ein Ende ohne ungesicherte Reiter raeumt es wieder weg.
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=60
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT 1
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
PRINT "lebenszeichen beim start "; hat("sicherung 0")
PRINT "entfernt "; hat("sicherung entfernt")
PRINT "staende "; LEN(DIRLIST("_programm/wiederherstellung"))
--- erwartet
lebenszeichen beim start TRUE
entfernt TRUE
staende 0
