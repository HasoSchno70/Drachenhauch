' --- GObject und GLib
' g_signal_connect ist in C ein Makro; je Form des Rueckrufs ein Name.
DECLARE FUNCTION signal LIB GOBJECT ALIAS "g_signal_connect_data" _
    (objekt AS ZEIGER, name AS TEXT, rueckruf AS SUB(objekt AS ZEIGER, daten AS ZEIGER), _
     daten AS ZEIGER, freigabe AS ZEIGER, flags AS LONG) AS ULONG
DECLARE FUNCTION signalZeichnen LIB GOBJECT ALIAS "g_signal_connect_data" _
    (objekt AS ZEIGER, name AS TEXT, rueckruf AS FUNCTION(objekt AS ZEIGER, cr AS ZEIGER, daten AS ZEIGER) AS BOOLEAN, _
     daten AS ZEIGER, freigabe AS ZEIGER, flags AS LONG) AS ULONG
DECLARE FUNCTION signalEreignis LIB GOBJECT ALIAS "g_signal_connect_data" _
    (objekt AS ZEIGER, name AS TEXT, rueckruf AS FUNCTION(objekt AS ZEIGER, ereignis AS ZEIGER, daten AS ZEIGER) AS BOOLEAN, _
     daten AS ZEIGER, freigabe AS ZEIGER, flags AS LONG) AS ULONG
DECLARE SUB g_object_unref LIB GOBJECT (objekt AS ZEIGER)
DECLARE FUNCTION g_timeout_add LIB GLIB (ms AS ULONG, rueckruf AS FUNCTION(daten AS ZEIGER) AS BOOLEAN, daten AS ZEIGER) AS ULONG
DECLARE SUB g_free LIB GLIB (z AS ZEIGER)
DECLARE SUB g_error_free LIB GLIB (fehler AS ZEIGER)

STRUCT GError LAYOUT C
    bereich AS ULONG
    nummer AS LONG
    meldung AS ZEIGER
END STRUCT

' Werte aus den Kopfdateien
CONST GTK_SENKRECHT = 1
CONST GTK_WAAGERECHT = 0
CONST GTK_ICON_KNOPF = 4
CONST GTK_POLITIK_AUTO = 1
CONST GTK_POLITIK_NIE = 2
CONST GTK_AUSRICHTEN_START = 1
CONST GTK_AUSRICHTEN_ENDE = 2
CONST GTK_AUSRICHTEN_MITTE = 3
CONST GTK_ELLIPSE_ENDE = 3
CONST GTK_AUSWAHL_KEINE = 0
CONST GTK_DATEI_OEFFNEN = 0
CONST GTK_ANTWORT_ANNEHMEN = -3
CONST GTK_ANTWORT_ABBRECHEN = -6
CONST GTK_VORRANG_ANWENDUNG = 600
CONST GDK_MASKE_BEWEGUNG = 4              ' GDK_POINTER_MOTION_MASK
CONST GDK_MASKE_DRUCK = 256               ' GDK_BUTTON_PRESS_MASK
CONST GDK_MASKE_LOSLASSEN = 512           ' GDK_BUTTON_RELEASE_MASK
CONST GDK_MASKE_RAD = 2097152             ' GDK_SCROLL_MASK
CONST GDK_MASKE_RAD_FEIN = 8388608        ' GDK_SMOOTH_SCROLL_MASK
CONST GDK_RAD_HOCH = 0
CONST GDK_RAD_RUNTER = 1
CONST GDK_RAD_FEIN = 4
CONST CAIRO_ARGB32 = 0
CONST CAIRO_FILTER_NAECHST = 3            ' CAIRO_FILTER_NEAREST
CONST PANGO_SCALE = 1024

' --- Kleine Helfer
SUB gtkKlasse(w AS INTEGER, name AS STRING)
    gtk_style_context_add_class(gtk_widget_get_style_context(w), name)
END SUB

FUNCTION gtkFehler$(f AS INTEGER) AS STRING
    IF f = 0 THEN RETURN ""
    DIM g AS GError : g = BUFFER_AUS_ZEIGER(f, SIZEOF(GError))
    DIM t AS STRING : t = TEXT_AUS_ZEIGER$(g.meldung)
    g_error_free(f)
    RETURN t
END FUNCTION

' Eine Farbe &HRRGGBB als Quelle fuer Cairo.
SUB cairoFarbe(cr AS INTEGER, f AS INTEGER)
    cairo_set_source_rgb(cr, ((f SHR 16) BAND 255) / 255.0, ((f SHR 8) BAND 255) / 255.0, (f BAND 255) / 255.0)
END SUB

' Ein Stylesheet fuer den ganzen Bildschirm laden; Rueckgabe "" oder der Fehler.
FUNCTION gtkStil$(css AS STRING) AS STRING
    DIM p AS INTEGER : p = gtk_css_provider_new()
    DIM f AS INTEGER
    IF NOT gtk_css_provider_load_from_data(p, css, -1, f) THEN RETURN gtkFehler$(f)
    gtk_style_context_add_provider_for_screen(gdk_screen_get_default(), p, GTK_VORRANG_ANWENDUNG)
    RETURN ""
END FUNCTION

' Ein Widget in eine PNG zeichnen (unabhaengig davon, ob es zu sehen ist).
FUNCTION gtkFoto(w AS INTEGER, pfad AS STRING) AS BOOLEAN
    DIM flaeche AS INTEGER : flaeche = cairo_image_surface_create(CAIRO_ARGB32, gtk_widget_get_allocated_width(w), gtk_widget_get_allocated_height(w))
    DIM cr AS INTEGER : cr = cairo_create(flaeche)
    gtk_widget_draw(w, cr)
    DIM st AS INTEGER : st = cairo_surface_write_to_png(flaeche, pfad)
    cairo_destroy(cr)
    cairo_surface_destroy(flaeche)
    RETURN st = 0
END FUNCTION
