' Fremde Bibliotheken aufrufen: DECLARE ... LIB
'
' Eine Funktion aus einer DLL (Windows), .so (Linux) oder .dylib (macOS)
' wird einmal deklariert und dann aufgerufen wie eine eigene. Die Typwoerter
' der Zeile sagen, wie breit ein Wert in C ist -- mehr in docs/ffi.md.
'
' Der erste Teil laeuft auf jedem System (die C-Bibliothek ist ueberall da),
' der zweite nur unter Windows. Dort, wo es kernel32 nicht gibt, faengt CATCH
' den Fehler ab: geladen wird erst beim ersten Aufruf.

' --- die C-Bibliothek des Systems ("c") und ihre Mathematik ("m")
DECLARE FUNCTION strlen LIB "c" (s AS TEXT) AS ZEIGER
DECLARE FUNCTION getenv LIB "c" (name AS TEXT) AS TEXT
DECLARE FUNCTION strtod LIB "c" (s AS TEXT, BYREF ende AS ZEIGER) AS FLOAT
DECLARE FUNCTION hypot LIB "m" (x AS FLOAT, y AS FLOAT) AS FLOAT
DECLARE FUNCTION malloc LIB "c" (n AS ZEIGER) AS ZEIGER
DECLARE FUNCTION strcpy LIB "c" (ziel AS ZEIGER, quelle AS TEXT) AS ZEIGER
DECLARE SUB free LIB "c" (z AS ZEIGER)
' Ein Rueckruf: qsort ruft fuer jedes Paar eine Funktion des Programms.
DECLARE SUB qsort LIB "c" (feld AS BUFFER, n AS ZEIGER, groesse AS ZEIGER, _
                           vergleich AS FUNCTION(a AS ZEIGER, b AS ZEIGER) AS LONG)

' --- die Windows-API
DECLARE FUNCTION GetTickCount64 LIB "kernel32" () AS INTEGER
DECLARE SUB GetSystemTime LIB "kernel32" (zeit AS BUFFER)
DECLARE FUNCTION GetComputerNameW LIB "kernel32" (puffer AS BUFFER, BYREF laenge AS ULONG) AS BOOLEAN
DECLARE FUNCTION Bytes LIB "kernel32" ALIAS "lstrlenA" (s AS TEXT) AS LONG
DECLARE FUNCTION GetCommandLineW LIB "kernel32" () AS ZEIGER
DECLARE FUNCTION EnumWindows LIB "user32" (rueckruf AS FUNCTION(hwnd AS ZEIGER, extra AS ZEIGER) AS BOOLEAN, _
                                           extra AS ZEIGER) AS BOOLEAN
DECLARE FUNCTION IsWindowVisible LIB "user32" (hwnd AS ZEIGER) AS BOOLEAN

' qsort gibt zwei Zeiger auf Elemente; die vier Bytes dahinter sind die Zahl.
FUNCTION zahlBei(z AS INTEGER) AS INTEGER
    RETURN BUFFER_GET_I32(BUFFER_AUS_ZEIGER(z, 4), 0)
END FUNCTION

FUNCTION vergleiche(a AS INTEGER, b AS INTEGER) AS INTEGER
    RETURN SGN(zahlBei(a) - zahlBei(b))
END FUNCTION

' EnumWindows ruft fuer jedes Fenster; TRUE heisst weitermachen.
DIM sichtbar AS INTEGER
FUNCTION fensterZaehlen(hwnd AS INTEGER, extra AS INTEGER) AS BOOLEAN
    IF IsWindowVisible(hwnd) THEN sichtbar = sichtbar + 1
    RETURN TRUE
END FUNCTION

PRINT "== C-Bibliothek"
PRINT "strlen(""Drachenhauch"") = "; strlen("Drachenhauch")
' TEXT ist UTF-8: fuenf Zeichen, aber sieben Bytes.
PRINT "strlen(""Grüße"")        = "; strlen("Grüße")
PRINT "hypot(3, 4)            = "; hypot(3.0, 4.0)
DIM ende AS INTEGER
PRINT "strtod(""2.5 Meter"")    = "; strtod("2.5 Meter", ende)
DIM pfad AS STRING
pfad = getenv("PATH")
PRINT "PATH hat "; LEN(pfad); " Zeichen"

' Zeiger: Speicher, der der C-Bibliothek gehoert. TEXT_AUS_ZEIGER$ und
' BUFFER_AUS_ZEIGER kopieren heraus -- danach darf free ihn freigeben.
DIM z AS INTEGER
z = malloc(32)
strcpy(z, "aus dem C-Speicher")
PRINT "TEXT_AUS_ZEIGER$       = "; TEXT_AUS_ZEIGER$(z)
PRINT "erstes Byte            = "; BUFFER_GET(BUFFER_AUS_ZEIGER(z, 4), 0)
free(z)

' Rueckruf: qsort sortiert die Zahlen mit unserer Vergleichsfunktion.
DIM zahlen AS BUFFER
zahlen = BUFFER_NEW(20)
DIM werte[5] AS INTEGER
werte[0] = 42 : werte[1] = -7 : werte[2] = 13 : werte[3] = 0 : werte[4] = 99
FOR i = 0 TO 4
    BUFFER_SET_I32(zahlen, i * 4, werte[i])
NEXT
qsort(zahlen, 5, 4, vergleiche)
PRINT "qsort                  = ";
FOR i = 0 TO 4
    PRINT BUFFER_GET_I32(zahlen, i * 4); " ";
NEXT
PRINT

PRINT
PRINT "== Windows-API"
TRY
    PRINT "Rechner laeuft seit "; GetTickCount64() \ 60000; " Minuten"

    ' Ein Struct ist ein Stueck Speicher: SYSTEMTIME sind acht WORD.
    DIM st AS BUFFER
    st = BUFFER_NEW(16)
    GetSystemTime(st)
    PRINT "UTC: "; BUFFER_GET_U16(st, 0); "-"; BUFFER_GET_U16(st, 2); "-"; BUFFER_GET_U16(st, 6); _
          " "; BUFFER_GET_U16(st, 8); ":"; PADL$(STR$(BUFFER_GET_U16(st, 10)), 2, "0")

    ' Hinein geht der Platz im Puffer (in Zeichen), heraus die Laenge.
    DIM n AS INTEGER
    n = 64
    DIM b AS BUFFER
    b = BUFFER_NEW(128)
    IF GetComputerNameW(b, n) THEN
        DIM name AS STRING
        FOR i = 0 TO n - 1
            name = name + CHR$(BUFFER_GET_U16(b, i * 2))
        NEXT
        PRINT "Rechnername: "; name
    END IF
    PRINT "lstrlenA(""Grüße"") = "; Bytes("Grüße")
    ' Ein Zeiger auf UTF-16-Text, der Windows gehoert (nicht freigeben).
    PRINT "Kommandozeile: "; TEXT_AUS_ZEIGER$(GetCommandLineW(), TRUE)
    EnumWindows(fensterZaehlen, 0)
    PRINT "sichtbare Fenster: "; sichtbar
CATCH e
    PRINT "(nicht unter Windows: "; e; ")"
END TRY
