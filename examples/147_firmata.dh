' Direkte Arduino/ESP32-Steuerung ueber Firmata (kein eigener Sketch, kein
' Text-Protokoll -- einmalig StandardFirmata hochladen).
'
'   dhrt run 147_firmata.dh                         erster serieller Port
'   dhrt run 147_firmata.dh -- COM5                 dieser Port
'   dhrt run 147_firmata.dh -- tcp:192.168.1.50:3030   StandardFirmataWiFi
'
' Zeigt die Firmware, laesst Pin 13 (eingebaute LED auf vielen Boards) ein
' paar Mal blinken und liest den Analog-Kanal A0. Serielle Ports gibt es nur
' in einem Bau mit 'python rust/build_runtime.py --hardware'; tcp: geht immer.
' Servo, I2C und Schrittmotor: docs/module-firmata.md.

IMPORT "firmata"

DIM ziel AS STRING : ziel = ""
IF ARGC() > 0 THEN
    ziel = ARG$(0)
ELSE
    DIM ports AS STRING : ports = ""
    TRY
        ports = FIRMATA_PORTS()
    CATCH e
        PRINT e
    END TRY
    PRINT "Verfuegbare Ports: ", ports
    ' INSTR zaehlt ab 0 und liefert -1, wenn nichts gefunden wird.
    DIM komma AS INTEGER : komma = INSTR(ports, ",")
    IF komma >= 0 THEN ports = LEFT$(ports, komma)
    ziel = TRIM$(ports)
END IF

IF ziel = "" THEN
    PRINT "Kein Board angegeben und kein serieller Port gefunden - Beispiel uebersprungen."
ELSE
    PRINT "Oeffne ", ziel, " ..."
    ' Seriell wartet das ~2 s (viele Boards starten beim Oeffnen neu), ueber
    ' das Netz nicht. Die Baudrate gilt nur seriell.
    DIM board AS FIRMATA_HANDLE
    board = FIRMATA_OPEN(ziel, 57600)

    TRY
        PRINT "Firmware: ", FIRMATA_FIRMWARE$(board)
    CATCH e
        PRINT e
    END TRY

    FIRMATA_PIN_MODE(board, 13, 1)   ' Pin 13 = OUTPUT

    DIM i AS INTEGER
    DIM an AS BOOLEAN
    an = TRUE
    FOR i = 1 TO 6
        FIRMATA_DIGITAL_WRITE(board, 13, an)
        an = NOT an
        SLEEP(300)
    NEXT

    ' Kanal 0 = A0 -- Analog-Kanal, NICHT die digitale Pin-Nummer (siehe
    ' docs/module-firmata.md fuer die Pin-vs-Kanal-Unterscheidung). Der
    ' erste Aufruf schaltet die Meldung ein, der Wert kommt mit einem
    ' spaeteren FIRMATA_UPDATE.
    FIRMATA_ANALOG_READ(board, 0)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 300
        FIRMATA_UPDATE(board)
        SLEEP(10)
    WEND
    PRINT "A0: ", FIRMATA_ANALOG_READ(board, 0)

    FIRMATA_CLOSE(board)
END IF
