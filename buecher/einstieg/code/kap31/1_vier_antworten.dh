' Kapitel 31 -- Lernmuster eins: vier Antworten, eine stimmt.
' Tasten 1 bis 4 waehlen aus.

SUB liste_lesen(datei AS STRING, links AS ARRAY OF STRING, _
                rechts AS ARRAY OF STRING)
    DIM roh AS STRING
    DIM z AS STRING
    DIM t AS ARRAY OF STRING
    FOR EACH roh IN READLINES(datei)
        z = TRIM$(roh)
        IF z <> "" AND LEFT$(z, 1) <> "#" THEN
            t = SPLIT$(z, ";")
            IF LEN(t) >= 2 THEN
                ARRAY_PUSH(links, TRIM$(t[0]))
                ARRAY_PUSH(rechts, TRIM$(t[1]))
            END IF
        END IF
    NEXT
END SUB

SCREEN(640, 400, "Vier Antworten")

DIM de[0] AS STRING
DIM fremd[0] AS STRING
DIM auswahl[4] AS INTEGER
DIM richtig AS INTEGER
DIM gewaehlt AS INTEGER
DIM warten AS INTEGER
DIM neue_frage AS BOOLEAN
DIM treffer AS INTEGER
DIM gesamt AS INTEGER
DIM jubel AS SOUND
DIM brumm AS SOUND
DIM i AS INTEGER
DIM k AS INTEGER
DIM f AS INTEGER

liste_lesen("englisch_grund.txt", de, fremd)
jubel = AUDIO_TONE(880, 90, "square", 0.35)
brumm = AUDIO_TONE(160, 180, "saw", 0.35)
neue_frage = TRUE
gewaehlt = -1

WHILE NOT QUITREQUESTED() AND NOT KEYPRESSED(KEY_ESCAPE)

    IF neue_frage THEN
        neue_frage = FALSE
        gewaehlt = -1
        FOR i = 1 TO 3
            auswahl[i] = -1
        NEXT
        auswahl[0] = INT(RND() * LEN(de))
        i = 1
        WHILE i < 4
            k = INT(RND() * LEN(de))
            IF ARRAY_INDEXOF(auswahl, k) < 0 THEN
                auswahl[i] = k
                i = i + 1
            END IF
        WEND
        richtig = INT(RND() * 4)
        k = auswahl[richtig]
        auswahl[richtig] = auswahl[0]
        auswahl[0] = k
    END IF

    IF gewaehlt < 0 THEN
        IF KEYPRESSED(KEY_1) THEN gewaehlt = 0
        IF KEYPRESSED(KEY_2) THEN gewaehlt = 1
        IF KEYPRESSED(KEY_3) THEN gewaehlt = 2
        IF KEYPRESSED(KEY_4) THEN gewaehlt = 3
        IF gewaehlt >= 0 THEN
            gesamt = gesamt + 1
            warten = 60
            IF gewaehlt = richtig THEN
                treffer = treffer + 1
                PLAYSOUND(jubel)
            ELSE
                PLAYSOUND(brumm)
            END IF
        END IF
    ELSE
        warten = warten - 1
        IF warten <= 0 THEN neue_frage = TRUE
    END IF

    CLS(RGB(28, 32, 50))
    TEXT(20, 20, "Was heisst ...", RGB(150, 165, 190))
    TEXT(20, 54, de[auswahl[richtig]], RGB(240, 240, 250))

    FOR i = 0 TO 3
        f = 1
        IF gewaehlt >= 0 AND i = richtig THEN f = 2
        IF gewaehlt = i AND i <> richtig THEN f = 3
        IF f = 1 THEN BOX(20, 110 + i * 58, 620, 152 + i * 58, _
                          RGB(46, 54, 78))
        IF f = 2 THEN BOX(20, 110 + i * 58, 620, 152 + i * 58, _
                          RGB(40, 130, 70))
        IF f = 3 THEN BOX(20, 110 + i * 58, 620, 152 + i * 58, _
                          RGB(150, 50, 60))
        TEXT(36, 122 + i * 58, STR$(i + 1) + "   " + _
             fremd[auswahl[i]], RGB(240, 240, 250))
    NEXT

    TEXT(20, 360, STR$(treffer) + " von " + STR$(gesamt) + " richtig", _
         RGB(150, 165, 190))
    FLIP()
WEND
