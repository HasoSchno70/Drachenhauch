=== die eingebauten themen bestehen ihre eigene pruefung
TRY
    SCREEN(600, 400, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Form", 0, 0, 600, 400)
DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(w, "Speichern", 20, 20, 120, 32)
DIM lbl AS GUI_WIDGET : lbl = GUI_LABEL(w, "Name", 20, 80)
DIM name AS GUI_WIDGET : name = GUI_TEXTINPUT(w, 80, 76, 200, 28)
GUI_SET_TEXT(name, "Anna")
DIM k1 AS GUI_WIDGET : k1 = GUI_CHECKBOX(w, "Eins", 20, 130, FALSE)
DIM t1 AS GUI_WIDGET : t1 = GUI_TOGGLE(w, "Schalter", 20, 170, FALSE)
DIM r1 AS GUI_WIDGET : r1 = GUI_RADIO(w, "g", "Option", 20, 210)
DIM v AS INTEGER
DIM arten AS ARRAY OF STRING : arten = ["standard", "primaer", "erfolg", "warnung", "gefahr", "umriss", "flach", "link"]
DIM kn AS ARRAY OF GUI_WIDGET
FOR v = 0 TO 7
    ARRAY_PUSH(kn, GUI_BUTTON(w, arten[v], 300, 20 + v * 40, 120, 32))
    GUI_BUTTON_VARIANT(kn[v], arten[v])
NEXT
DIM th AS STRING
FOR EACH th IN ["dark", "light", "retro", "contrast", "modern_dark", "modern_light"]
    GUI_THEME_PRESET(th)
    GUI_UPDATE()
    DIM b AS STRING : b = GUI_A11Y_CHECK$()
    PRINT th; ": "; IIF(b = "", "ok", "")
    IF b <> "" THEN PRINT b
NEXT
--- umgebung
DHRT_FRAMES=1
--- erwartet
dark: ok
light: ok
retro: ok
contrast: ok
modern_dark: ok
modern_light: ok

=== die gewaehlte zeile einer tabelle ist in jedem thema lesbar
' Die Auswahl liegt halbdurchsichtig ueber dem Grund; die Schrift blieb
' text_fg. Im hellen modern-Thema stand so dunkle Schrift auf Violett mit
' 3,0:1 (Buch "Fenster, Formulare, Daten", Kapitel 21; GUI_A11Y_CHECK$ misst
' die Auswahl nicht). Gemessen am Bild: der haeufigste Ton der Zeile ist der
' Grund, der zweithaeufigste die Schrift (nicht der staerkste: der Rahmen der
' aktuellen Zelle ist weiss und hob die Messung ueber die Grenze).
TRY
    SCREEN(400, 200, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
FUNCTION kanal(v AS INTEGER) AS FLOAT
    DIM s AS FLOAT : s = v / 255.0
    IF s <= 0.03928 THEN RETURN s / 12.92
    RETURN ((s + 0.055) / 1.055) ^ 2.4
END FUNCTION
FUNCTION leucht(c AS INTEGER) AS FLOAT
    RETURN 0.2126 * kanal((c SHR 16) BAND 255) + 0.7152 * kanal((c SHR 8) BAND 255) + 0.0722 * kanal(c BAND 255)
END FUNCTION
FUNCTION abstand(a AS INTEGER, b AS INTEGER) AS FLOAT
    DIM la AS FLOAT : la = leucht(a)
    DIM lb AS FLOAT : lb = leucht(b)
    RETURN (MAX(la, lb) + 0.05) / (MIN(la, lb) + 0.05)
END FUNCTION
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM tb AS GUI_WIDGET : tb = GUI_TABLE(w, 10, 10, 380, 150)
GUI_TABLE_HEADERS(tb, ["Titel", "Urheber"])
GUI_TABLE_ADD_ROW(tb, ["Die unendliche Geschichte", "Michael Ende"])
GUI_TABLE_ADD_ROW(tb, ["Momo", "Michael Ende"])
GUI_TABLE_SET_SELECTED(tb, 0)
DIM th AS STRING
DIM nr AS INTEGER
FOR EACH th IN ["dark", "light", "modern_dark", "modern_light", "contrast"]
    GUI_THEME_PRESET(th)
    DIM k AS INTEGER
    FOR k = 1 TO 3
        GUI_UPDATE() : CLS(0) : GUI_DRAW() : FLIP()
    NEXT
    nr = nr + 1
    DIM datei AS STRING : datei = "z" + STR$(nr) + ".png"
    SAVESCREENSHOT(datei)
    FOR k = 1 TO 2
        GUI_UPDATE() : CLS(0) : GUI_DRAW() : FLIP()
    NEXT
    DIM img AS IMAGE : img = LOADIMAGE(datei)
    DIM x AS INTEGER
    DIM y AS INTEGER
    DIM b AS INTEGER
    DIM h AS INTEGER
    (x, y, b, h) = GUI_TABLE_ROW_RECT(tb, 0)
    DIM farben AS ARRAY OF INTEGER : farben = []
    DIM zahl AS ARRAY OF INTEGER : zahl = []
    DIM px AS INTEGER
    DIM py AS INTEGER
    FOR py = y + 1 TO y + h - 2
        FOR px = x + 2 TO x + b - 3
            DIM c AS INTEGER : c = GETPIXEL(img, px, py) BAND &HFFFFFF
            DIM i AS INTEGER : i = ARRAY_INDEXOF(farben, c)
            IF i < 0 THEN
                ARRAY_PUSH(farben, c) : ARRAY_PUSH(zahl, 1)
            ELSE
                zahl[i] = zahl[i] + 1
            END IF
        NEXT
    NEXT
    DIM grund AS INTEGER : grund = 0
    FOR i = 1 TO LEN(farben) - 1
        IF zahl[i] > zahl[grund] THEN grund = i
    NEXT
    ' Die Schrift: der zweithaeufigste Ton (Kantenglaettung streut, aber der
    ' Kern der Buchstaben ist eine Farbe; Rahmen und Gitter sind duenner).
    DIM schrift AS INTEGER : schrift = -1
    FOR i = 0 TO LEN(farben) - 1
        IF i <> grund THEN
            IF schrift < 0 THEN
                schrift = i
            ELSEIF zahl[i] > zahl[schrift] THEN
                schrift = i
            END IF
        END IF
    NEXT
    DIM best AS FLOAT : best = abstand(farben[schrift], farben[grund])
    PRINT th; ": "; IIF(best >= 4.5, "lesbar", "zu blass " + FORMAT$(best, "%.2f"))
NEXT
--- umgebung
DHRT_FRAMES=40
--- erwartet
dark: lesbar
light: lesbar
modern_dark: lesbar
modern_light: lesbar
contrast: lesbar

=== tab springt zurueck nach oben -- spaltenweise und mit tab-index nicht
TRY
    SCREEN(600, 400, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Form", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
' Von unten nach oben angelegt: Tab laeuft gegen die Lage.
DIM ort AS GUI_WIDGET : ort = GUI_BUTTON(w, "Ort", 20, 120, 120, 32)
DIM name AS GUI_WIDGET : name = GUI_BUTTON(w, "Name", 20, 20, 120, 32)
' Eine zweite Spalte rechts, oben anfangend: das ist erlaubt.
DIM plz AS GUI_WIDGET : plz = GUI_BUTTON(w, "PLZ", 300, 20, 120, 32)
DIM land AS GUI_WIDGET : land = GUI_BUTTON(w, "Land", 300, 120, 120, 32)
' Dieselbe Zeile rueckwaerts.
DIM rechts AS GUI_WIDGET : rechts = GUI_BUTTON(w, "Rechts", 300, 250, 120, 32)
DIM links AS GUI_WIDGET : links = GUI_BUTTON(w, "Links", 20, 250, 120, 32)
GUI_UPDATE()
PRINT GUI_A11Y_CHECK$()
' Der Tab-Index stellt die Reihenfolge richtig.
GUI_SET_TAB_INDEX(name, 1) : GUI_SET_TAB_INDEX(ort, 2) : GUI_SET_TAB_INDEX(plz, 3)
GUI_SET_TAB_INDEX(land, 4) : GUI_SET_TAB_INDEX(links, 5) : GUI_SET_TAB_INDEX(rechts, 6)
GUI_UPDATE()
PRINT "danach ["; GUI_A11Y_CHECK$(); "]"
--- umgebung
DHRT_FRAMES=1
--- erwartet
button "Name" in "Form": Tab springt hierher zurueck (von button "Ort" in "Form") -- die Reihenfolge folgt nicht der Lage: Widgets in Lesereihenfolge anlegen oder GUI_SET_TAB_INDEX
button "Links" in "Form": Tab springt hierher zurueck (von button "Rechts" in "Form") -- die Reihenfolge folgt nicht der Lage: Widgets in Lesereihenfolge anlegen oder GUI_SET_TAB_INDEX
danach []

=== im gespiegelten fenster gilt die leserichtung von rechts
TRY
    SCREEN(600, 400, "T", 1)
CATCH e
    PRINT "UEBERSPRINGEN: kein Fenster moeglich"
    EXIT(0)
END TRY
IMPORT "gui"
DIM w AS GUI_WINDOW : w = GUI_WINDOW("Form", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM a AS GUI_WIDGET : a = GUI_BUTTON(w, "A", 20, 20, 120, 32)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "B", 300, 20, 120, 32)
GUI_UPDATE()
PRINT "links nach rechts ["; GUI_A11Y_CHECK$(); "]"
GUI_WINDOW_RTL(w, TRUE)
GUI_UPDATE()
' Gespiegelt steht A rechts, B links: von rechts nach links gelesen passt es.
PRINT "gespiegelt ["; GUI_A11Y_CHECK$(); "]"
--- umgebung
DHRT_FRAMES=1
--- erwartet
links nach rechts []
gespiegelt []
