=== schleife ueber ein feld mit untergrenze
DIM werte[-500 TO 500] AS INTEGER
DIM summe AS INTEGER
DIM i AS INTEGER
DIM r AS INTEGER
FOR r = 1 TO 20
    FOR i = LBOUND(werte) TO UBOUND(werte)
        werte[i] = werte[i] + i
    NEXT
NEXT
FOR i = LBOUND(werte) TO UBOUND(werte)
    summe = summe + ABS(werte[i])
NEXT
PRINT summe, werte[-500], werte[500]
FUNCTION mitte() AS INTEGER
    RETURN werte[0] + werte[1]
END FUNCTION
PRINT mitte()
--- umgebung
DHRT_JIT=aus
--- erwartet
5010000 -10000 10000
20

