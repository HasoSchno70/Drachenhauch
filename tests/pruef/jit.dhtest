=== print in der schleife mit trennern (maschinencode)
DIM i AS INTEGER
DIM s AS FLOAT
DIM t AS STRING
FOR i = 1 TO 4
    s = s + SQR(i)
    t = t + CHR$(64 + i)
    PRINT i; " "; s, t; "|"
    PRINT i, i * 2, i * 0.5
    PRINT
    PRINT "ende"; i;
NEXT
PRINT
--- umgebung
DHRT_JIT=immer
DHRT_JIT_BILANZ=1
--- erwartet
1 1.0 A|
1 2 0.5

ende12 2.414213562373095 AB|
2 4 1.0

ende23 4.146264369941973 ABC|
3 6 1.5

ende34 6.146264369941973 ABCD|
4 8 2.0

ende4
