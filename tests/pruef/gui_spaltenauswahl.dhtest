' Spaltenauswahl im Textbereich: ein RECHTECK statt eines Laufs. Jede Zeile
' bekommt ihre eigene Marke samt Auswahl -- getippt wird in allen zugleich.
' Alt+Zug macht dasselbe mit der Maus. Format: docs/werkzeuge.md, dhrt test.
--- seriell

=== jede zeile des blocks bekommt eine marke
IMPORT "gui"
SCREEN(600, 400, "S", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("S", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "aaaa" + CHR$(10) + "bbbb" + CHR$(10) + "cccc")
PRINT GUI_TEXTAREA_SELECT_COLUMNS(ta, 1, 2, 3, 4)
PRINT GUI_TEXTAREA_CARETS(ta)
PRINT GUI_TEXTAREA_SELECTION$(ta)
--- umgebung
DHRT_FRAMES=1
--- erwartet
3
3
aa

=== eine kurze zeile faellt nicht heraus
' Die dritte Zeile reicht nicht bis Spalte 4 -- ihre Marke steht am Ende,
' statt dass die Zeile beim Tippen stumm uebersprungen wird.
IMPORT "gui"
SCREEN(600, 400, "S", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("S", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "aaaa" + CHR$(10) + "bbbb" + CHR$(10) + "c")
PRINT GUI_TEXTAREA_SELECT_COLUMNS(ta, 1, 2, 3, 4)
--- umgebung
DHRT_FRAMES=1
--- erwartet
3

=== getippt wird in jeder zeile des blocks
IMPORT "gui"
SCREEN(600, 400, "S", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("S", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "aaaa" + CHR$(10) + "bbbb" + CHR$(10) + "cccc")
GUI_TEXTAREA_SELECT_COLUMNS(ta, 1, 2, 3, 4)
GUI_FOCUS(ta)
CLIPBOARD_SET("X")
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 30 THEN PRINT REPLACE$(GUI_TEXT(ta), CHR$(10), " | ")
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
# Strg+V ersetzt in jeder Zeile die zwei gewaehlten Zeichen
c 4
e 4 2 341 0 0 0 // Strg runter
e 4 2 86 0 0 0 // V runter
e 6 1 86 0 0 0 //
e 6 1 341 0 0 0 //
--- umgebung
DHRT_FRAMES=40
--- erwartet
aXa | bXb | cXc

=== die reihenfolge der ecken ist gleich
' Von unten rechts nach oben links gezogen ergibt denselben Block.
IMPORT "gui"
SCREEN(600, 400, "S", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("S", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "aaaa" + CHR$(10) + "bbbb" + CHR$(10) + "cccc")
PRINT GUI_TEXTAREA_SELECT_COLUMNS(ta, 3, 4, 1, 2)
PRINT GUI_TEXTAREA_SELECTION$(ta)
--- umgebung
DHRT_FRAMES=1
--- erwartet
3
aa

=== ein leerer bereich ist ein fehler im klartext
IMPORT "gui"
SCREEN(600, 400, "S", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("S", 5, 5, 580, 380)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "aaaa")
TRY
    GUI_TEXTAREA_SELECT_COLUMNS(ta, 9, 1, 12, 3)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
GUI_TEXTAREA_SELECT_COLUMNS: leerer Bereich

=== alt und ziehen spannt den block mit der maus
' Die Lagen kommen aus einer Zeichenflaeche bei (0,0): der Textbereich
' beginnt bei x = 20, eine Zeile ist 25 Punkte hoch, ein Zeichen gut 7 breit.
IMPORT "gui"
SCREEN(600, 400, "S", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("S", 5, 5, 580, 380)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 10, 10, 500, 200)
GUI_SET_TEXT(ta, "aaaa" + CHR$(10) + "bbbb" + CHR$(10) + "cccc")
GUI_FOCUS(ta)
DIM f AS INTEGER
FOR f = 1 TO 30
    GUI_UPDATE()
    IF f = 20 THEN PRINT GUI_TEXTAREA_CARETS(ta)
    IF f = 20 THEN PRINT GUI_TEXTAREA_SELECTION$(ta)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
NEXT
--- datei ev.txt
# Alt gedrueckt halten, von Zeile 1 Spalte 2 bis Zeile 3 Spalte 4 ziehen
c 9
e 2 2 342 0 0 0 // Alt runter
e 2 7 35 50 0 0 // Maus in Zeile 1
e 3 7 35 50 0 0 //
e 3 6 0 0 0 0 // Taste runter
e 6 7 49 100 0 0 // bis Zeile 3
e 7 7 49 100 0 0 //
e 9 7 49 100 0 0 //
e 11 5 0 0 0 0 // Taste hoch
e 13 1 342 0 0 0 // Alt hoch
--- umgebung
DHRT_FRAMES=34
--- erwartet
3
aa
