=== loadfont mit zeichenwahl und schriftsammlung
' arial.ttf mit zwei Bloecken, msgothic.ttc als Sammlung (raylib liest .ttc
' nicht selbst und tauschte frueher still gegen die Bitmapschrift).
IMPORT "helfer.dh"
foto("lf", "DIM f AS INTEGER : DIM g AS INTEGER" + CHR$(10) + "f = LOADFONT(" + CHR$(34) + "C:/Windows/Fonts/arial.ttf" + CHR$(34) + ", 24, " + CHR$(34) + "kyrillisch, griechisch" + CHR$(34) + ")" + CHR$(10) + "g = LOADFONT(" + CHR$(34) + "C:/Windows/Fonts/msgothic.ttc" + CHR$(34) + ", 24, " + CHR$(34) + "japanisch" + CHR$(34) + ")" + CHR$(10), "    SETFONT(f) : " + "    TEXT(10, 10, " + CHR$(34) + "Привет Γειά" + CHR$(34) + ")" + CHR$(10) + "    SETFONT(g) : " + "    TEXT(10, 50, " + CHR$(34) + "東京" + CHR$(34) + ")" + CHR$(10))
foto("frage", "DIM f AS INTEGER : DIM g AS INTEGER" + CHR$(10) + "f = LOADFONT(" + CHR$(34) + "C:/Windows/Fonts/arial.ttf" + CHR$(34) + ", 24, " + CHR$(34) + "kyrillisch, griechisch" + CHR$(34) + ")" + CHR$(10) + "g = LOADFONT(" + CHR$(34) + "C:/Windows/Fonts/msgothic.ttc" + CHR$(34) + ", 24, " + CHR$(34) + "japanisch" + CHR$(34) + ")" + CHR$(10), "    SETFONT(f) : " + "    TEXT(10, 10, " + CHR$(34) + "?????? ????" + CHR$(34) + ")" + CHR$(10) + "    SETFONT(g) : " + "    TEXT(10, 50, " + CHR$(34) + "??" + CHR$(34) + ")" + CHR$(10))
PRINT "unterschiede ueber 100 "; (unterschiede("lf.png", "frage.png") > 100)
DIM f AS INTEGER : DIM g AS INTEGER
f = LOADFONT("C:/Windows/Fonts/arial.ttf", 24, "kyrillisch, griechisch")
g = LOADFONT("C:/Windows/Fonts/msgothic.ttc", 24, "japanisch")
PRINT f ; " " ; g
TRY
    f = LOADFONT("C:/Windows/Fonts/arial.ttf", 24, "klingonisch")
CATCH e
    PRINT "unbekannter block "; (INSTR(e, "unbekannter Schriftblock") >= 0); ", nennt die gueltigen "; (INSTR(e, "kyrillisch") >= 0)
END TRY
