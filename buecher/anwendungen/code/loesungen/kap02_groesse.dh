' Loesung Kapitel 2, Erweitern 2 -- das Fenster merkt sich seine Groesse
' in mediathek.ini neben dem Programm.
IMPORT "gui"
' >>> neu
IMPORT "ini"

DIM einstellungen AS MAP OF STRING
IF FILEEXISTS("mediathek.ini") THEN
    einstellungen = INI_LOAD("mediathek.ini")
END IF
DIM breite AS INTEGER
breite = INT(VAL(MAP_GET_OR(einstellungen, "fenster.breite", "560")))
DIM hoehe AS INTEGER
hoehe = INT(VAL(MAP_GET_OR(einstellungen, "fenster.hoehe", "300")))
SCREEN(breite, hoehe, "Mediathek", 1)
' <<< neu
WINDOW_RESIZABLE(TRUE)
DIM fenster AS GUI_WINDOW
fenster = GUI_WINDOW("Mediathek", 0, 0, breite, hoehe)
GUI_WINDOW_CHROME(fenster, FALSE)

' Aussen eine Spalte, so gross wie das Fenster und an allen vier Kanten
' verankert -- sie ist das Einzige, das eine Lage und eine Groesse hat.
DIM form AS GUI_WIDGET
form = GUI_LAYOUT(fenster, "spalte", 0, 0, breite, hoehe)
GUI_SET_ANCHOR(form, "lrtb")
GUI_LAYOUT_SET(form, "rand", 20)
GUI_LAYOUT_SET(form, "abstand", 8)

' Eine Zeile des Formulars: Beschriftung links, Feld rechts daneben.
' Alle Beschriftungen sind in einer Groessengruppe und darum so breit
' wie die breiteste -- so stehen die Felder buendig untereinander.
SUB zeile(text AS STRING, feld AS GUI_WIDGET, gewicht AS INTEGER)
    DIM z AS GUI_WIDGET : z = GUI_LAYOUT(fenster, "zeile", 0, 0, 10, 10)
    GUI_LAYOUT_SET(z, "abstand", 12)
    GUI_LAYOUT_SET(z, "ausrichtung", 1)
    GUI_LAYOUT_SET(z, "dehnen", 0)
    DIM l AS GUI_WIDGET : l = GUI_LABEL(fenster, text, 0, 0)
    GUI_SIZE_GROUP(l, "beschriftung", "breite")
    GUI_LAYOUT_ADD(z, l)
    GUI_LAYOUT_ADD(z, feld, gewicht)
    IF gewicht = 0 THEN GUI_LAYOUT_SPACER(z)
    GUI_LAYOUT_ADD(form, z)
END SUB

DIM titel AS GUI_WIDGET : titel = GUI_TEXTINPUT(fenster, 0, 0, 0, 0)
DIM urheber AS GUI_WIDGET : urheber = GUI_TEXTINPUT(fenster, 0, 0, 0, 0)
DIM art AS GUI_WIDGET
DIM arten AS ARRAY OF STRING
arten = ["Buch", "Film", "Spiel", "Musik"]
art = GUI_DROPDOWN(fenster, 0, 0, 160, 0, arten)
GUI_DROPDOWN_SET_SELECTED(art, 0)
DIM jahr AS GUI_WIDGET : jahr = GUI_TEXTINPUT(fenster, 0, 0, 80, 0)
zeile("Titel", titel, 1)
zeile("Urheber", urheber, 1)
zeile("Art", art, 0)
zeile("Erscheinungsjahr", jahr, 0)

' Die Knopfreihe: ein Leerraum vorn schiebt den Knopf nach rechts.
DIM knoepfe AS GUI_WIDGET
knoepfe = GUI_LAYOUT(fenster, "zeile", 0, 0, 10, 10)
DIM status AS GUI_WIDGET
status = GUI_LABEL(fenster, "Noch nichts aufgenommen.", 0, 0)
DIM knopf AS GUI_WIDGET
knopf = GUI_BUTTON(fenster, "Aufnehmen", 0, 0, 0, 0)
GUI_LAYOUT_SET(knoepfe, "ausrichtung", 1)
GUI_LAYOUT_SET(knoepfe, "dehnen", 0)
GUI_LAYOUT_ADD(knoepfe, status)
GUI_LAYOUT_SPACER(knoepfe)
GUI_LAYOUT_ADD(knoepfe, knopf)
GUI_LAYOUT_SPACER(form)
GUI_LAYOUT_ADD(form, knoepfe)

GUI_WINDOW_DEFAULT(fenster, knopf)
GUI_FOCUS(titel)

' Die Spalte weiss, wie viel Platz ihr Inhalt mindestens braucht --
' kleiner laesst sich das Fenster nicht ziehen.
WINDOW_MIN_SIZE(GUI_LAYOUT_MIN_W(form), GUI_LAYOUT_MIN_H(form))

WINDOW_WAIT_EVENTS(1)
WHILE NOT QUITREQUESTED()
    ' Das Programmfenster waechst -> das gui-Fenster mit -> die Spalte
    ' (Anker) -> alles darin.
    IF WINDOW_RESIZED() THEN
        DIM b AS INTEGER : b = SCREENWIDTH()
        DIM h AS INTEGER : h = SCREENHEIGHT()
        GUI_WINDOW_SET_BOUNDS(fenster, 0, 0, b, h)
    END IF
    GUI_UPDATE()
    IF GUI_CLICKED(knopf) THEN
        GUI_SET_TEXT(status, "Aufgenommen: " + GUI_TEXT(titel))
    END IF
    CLS(RGB(32, 36, 44))
    GUI_DRAW()
    FLIP()
WEND

' >>> neu
' Beim Beenden die Groesse ablegen -- beim naechsten Start oeffnet
' SCREEN das Fenster gleich so.
MAP_PUT(einstellungen, "fenster.breite", STR$(SCREENWIDTH()))
MAP_PUT(einstellungen, "fenster.hoehe", STR$(SCREENHEIGHT()))
INI_SAVE("mediathek.ini", einstellungen)
' <<< neu
