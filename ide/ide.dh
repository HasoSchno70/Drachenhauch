' Eine Zeile des Felds (ab 1), "" ausserhalb. Die Zerlegung wird gemerkt,
' solange der Text derselbe ist: wortAnfang$ laeuft in JEDEM Bild, und den
' ganzen Text dafuer jedesmal in Zeilen zu zerlegen kostete bei 20000
' Zeilen fast 2 ms je Bild (Stresstest 2026-10-02).
DIM zvText AS STRING : zvText = ""
DIM zvZeilen AS ARRAY OF STRING : zvZeilen = []
FUNCTION zeileVon$(ta AS GUI_WIDGET, z AS INTEGER) AS STRING
    DIM t AS STRING : t = GUI_TEXT(ta)
    IF t <> zvText OR LEN(zvZeilen) = 0 THEN
        zvText = t
        zvZeilen = SPLIT$(t, NL)
    END IF
    IF z < 1 OR z > LEN(zvZeilen) THEN RETURN ""
    RETURN zvZeilen[z - 1]
END FUNCTION

' Der Wortanfang links der Marke -- so viel wird beim Uebernehmen ersetzt.
FUNCTION wortAnfang$() AS STRING
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN ""
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeile AS STRING : zeile = zeileVon$(ta, z)
    DIM a AS INTEGER : a = s - 1
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    RETURN MID$(zeile, a, s - 1 - a)
END FUNCTION

' Steht der Wortanfang hinter `objekt.` (vor dem Punkt ein Name, `)` oder
' `]`, keine Zahl wie in `1.5`)? Dann zeigt die Vorschlagsliste die
' Mitglieder seiner Klasse, auch ohne drei getippte Zeichen.
FUNCTION nachPunkt() AS BOOLEAN
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN FALSE
    DIM z AS INTEGER
    DIM s AS INTEGER
    (z, s) = GUI_TEXTAREA_CURSOR(ta)
    DIM zeile AS STRING : zeile = zeileVon$(ta, z)
    DIM a AS INTEGER : a = s - 1
    WHILE a > 0 AND istWortzeichen(MID$(zeile, a - 1, 1)) : a = a - 1 : WEND
    IF a < 2 THEN RETURN FALSE
    IF MID$(zeile, a - 1, 1) <> "." THEN RETURN FALSE
    DIM c AS STRING : c = MID$(zeile, a - 2, 1)
    IF c = ")" OR c = "]" THEN RETURN TRUE
    IF NOT istWortzeichen(c) THEN RETURN FALSE
    DIM k AS INTEGER : k = a - 1
    WHILE k > 0 AND istWortzeichen(MID$(zeile, k - 1, 1)) : k = k - 1 : WEND
    RETURN NOT REGEX_TEST(MID$(zeile, k, a - 1 - k), "^[0-9]+$")
END FUNCTION

' Was die Vorschlagsliste sich merkt: der Wortanfang, hinter einem Punkt
' mit dem Punkt davor -- sonst gliche `s.` dem leeren Wortanfang.
FUNCTION vorschlagWort$() AS STRING
    RETURN IIF(nachPunkt(), ".", "") + wortAnfang$()
END FUNCTION

' Von wo aus IMPORTs gelten, wenn die IDE den Uebersetzer fragt: der Ordner
' der Datei im Reiter, sonst der Projektordner.
FUNCTION codeBasis$() AS STRING
    IF aktiverTab >= 0 THEN
        IF reiter[aktiverTab].pfad <> "" THEN RETURN DIRNAME(reiter[aktiverTab].pfad)
    END IF
    RETURN projektOrdner
END FUNCTION

