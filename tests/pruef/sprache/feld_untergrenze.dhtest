=== array_map behaelt die grenzen, array_filter beginnt bei 0
DIM a[1 TO 3] AS INTEGER
a[1] = 1 : a[2] = 2 : a[3] = 3
DIM b AS ARRAY OF INTEGER
b = ARRAY_MAP(a, FUNCTION(x) x * 10)
PRINT LBOUND(b), UBOUND(b), b[1], b[3]
DIM c AS ARRAY OF INTEGER
c = ARRAY_FILTER(a, FUNCTION(x) x > 1)
PRINT LBOUND(c), c[0]
PRINT a
DIM f[-1 TO 1, 4] AS STRING
PRINT f
DIM n[3] AS INTEGER
PRINT n
