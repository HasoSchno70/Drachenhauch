=== global in der schleife und danach in einer funktion
DIM stand AS INTEGER
DIM i AS INTEGER
FUNCTION doppelt() AS INTEGER
    stand = stand * 2
    RETURN stand
END FUNCTION
FOR i = 1 TO 1000
    stand = stand + 1
    IF stand MOD 100 = 0 THEN stand = stand + doppelt() - stand
NEXT
PRINT stand; " "; doppelt()
