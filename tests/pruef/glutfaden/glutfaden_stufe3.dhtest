=== rueckstiche setzen finden entfernen
IMPORT "k.dh"
DIM m AS kern.Muster : m = neuesTestmuster()
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
' Halbstich-Einheiten, gespiegelt vierfach: eine Linie wird vier
DIM l AS ARRAY OF INTEGER : l = kern.spiegelRueckstich(1, 1, 4, 3, 6, 5, kern.SPIEGEL_VIERFACH)
PRINT "linien "; JOIN$(l, ",")
PRINT "gesetzt "; kern.ruecksticheSetzen(m, v, l, 0); " schritte "; LEN(v.rueck)
PRINT "laenge null "; kern.ruecksticheSetzen(m, v, [2, 2, 2, 2], 0); " schritte "; LEN(v.rueck)
PRINT "bei 2,2 "; kern.rueckstichBei(m, 2.5, 2.0, 2.0); "  bei 11,1 "; kern.rueckstichBei(m, 10.5, 1.5, 2.0); "  weit weg "; kern.rueckstichBei(m, 6.0, 9.0, 1.0)
PRINT "entfernt "; kern.rueckstichEntfernen(m, v, 1); " uebrig "; LEN(m.rueckstiche)
DIM ok AS BOOLEAN : ok = v.zurueckNehmen(m)
PRINT "zurueck "; LEN(m.rueckstiche); " zweiter "; m.rueckstiche[1].x1; ","; m.rueckstiche[1].y1
ok = v.zurueckNehmen(m)
PRINT "ganz zurueck "; LEN(m.rueckstiche)
ok = v.wiederholen(m)
' sichern und laden: die Rueckstiche kommen mit
DIM pfad AS STRING : pfad = PATHJOIN(CWD$(), "r.pxs")
kern.pxsSpeichern(m, pfad)
DIM g AS kern.Muster : g = kern.pxsLaden(pfad)
PRINT "geladen "; LEN(g.rueckstiche); " "; g.rueckstiche[3].x1; ","; g.rueckstiche[3].y1; " "; g.rueckstiche[3].x2; ","; g.rueckstiche[3].y2; " farbe "; g.rueckstiche[3].farbe
--- datei k.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden.dh"

--- erwartet
linien 1,1,4,3,11,1,8,3,1,9,4,7,11,9,8,7
gesetzt 4 schritte 1
laenge null 0 schritte 1
bei 2,2 0  bei 11,1 1  weit weg -1
entfernt TRUE uebrig 3
zurueck 4 zweiter 11,1
ganz zurueck 0
geladen 4 11,9 8,7 farbe 0

=== fortschritt markieren und naechster offener stich
IMPORT "k.dh"
DIM m AS kern.Muster : m = neuesTestmuster()
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM ok AS BOOLEAN
DIM n AS INTEGER
' unten Farbe 0 in Zeile 0, oben (neue Ebene) Farbe 0 bei (2,0) und (4,1)
n = kern.zellenSetzen(m, v, [0, 0, 1, 0, 2, 0, 3, 0], 0, kern.VOLL, "unten")
n = kern.ebeneNeu(m, v, "Oben")
n = kern.zellenSetzen(m, v, [2, 0, 4, 1], 0, kern.VOLL, "oben")
' (2,0) markieren trifft die OBERE Ebene, (5,4) ist leer
PRINT "markiert "; kern.erledigtSetzen(m, v, [2, 0, 5, 4, 0, 0], TRUE)
PRINT "oben "; m.ebenen.ebenen[1].istErledigt(2, 0); " unten "; m.ebenen.ebenen[0].istErledigt(2, 0); " (0,0) "; m.ebenen.ebenen[0].istErledigt(0, 0)
PRINT "naechster ab vorn "; kern.naechsterOffen(m, 0, -1, TRUE); " ab 1 "; kern.naechsterOffen(m, 0, 1, TRUE); " ab 3 "; kern.naechsterOffen(m, 0, 3, TRUE)
PRINT "rueckwaerts ab 1 "; kern.naechsterOffen(m, 0, 1, FALSE); " ab vorn "; kern.naechsterOffen(m, 0, -1, FALSE)
ok = v.zurueckNehmen(m)
PRINT "zurueck "; m.ebenen.ebenen[1].istErledigt(2, 0); " "; m.ebenen.ebenen[0].istErledigt(0, 0)
' eine ganze Farbe -- auch auf unsichtbaren Ebenen
m.ebenen.ebenen[1].sichtbar = FALSE
PRINT "farbe erledigt "; kern.farbeErledigt(m, v, 0); " oben "; m.ebenen.ebenen[1].istErledigt(4, 1)
PRINT "keiner offen "; kern.naechsterOffen(m, 0, -1, TRUE)
ok = v.zurueckNehmen(m)
PRINT "wieder offen "; kern.naechsterOffen(m, 0, -1, TRUE)
' markieren laesst die Stiche und Stichzahlen stehen
PRINT "stiche "; m.farben[0].stichzahl
--- datei k.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden.dh"

--- erwartet
markiert 2
oben TRUE unten FALSE (0,0) TRUE
naechster ab vorn 1 ab 1 3 ab 3 10
rueckwaerts ab 1 10 ab vorn 10
zurueck FALSE FALSE
farbe erledigt 6 oben TRUE
keiner offen -1
wieder offen 0
stiche 6

=== farbe ersetzen und symbol aendern
IMPORT "k.dh"
DIM m AS kern.Muster : m = neuesTestmuster()
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM sym AS ARRAY OF STRING : sym = ["A", "B", "C", "D", "E"]
DIM rot2 AS INTEGER : rot2 = kern.farbeHinzufuegen(m, v, kern.neuesGarn("Rot dunkler", &HF00000, "DMC", "666"), sym, FALSE, FALSE)
DIM ok AS BOOLEAN
DIM n AS INTEGER
' unten Rot (0) in einer Zeile, Perle (1) bei (0,1); oben Rot (0) ueber (0,0)
n = kern.zellenSetzen(m, v, [0, 0, 1, 0, 2, 0], 0, kern.HALB_OL_UR, "unten")
ok = kern.stichSetzen(m, v, 0, 1, 1, kern.VOLL)
ok = kern.stichSetzen(m, v, 3, 0, rot2, kern.VOLL)
n = kern.ebeneNeu(m, v, "Oben")
ok = kern.stichSetzen(m, v, 0, 0, 0, kern.VOLL)
m.ebenen.ebenen[1].sichtbar = FALSE
' Rot -> Diamant: nur sichtbare oberste Zellen; (0,0) unten zaehlt, weil oben unsichtbar
PRINT "quellen ohne toleranz "; JOIN$(kern.ersetzenQuellen(m, 0, 2, 0.0), ","); " mit 5 "; JOIN$(kern.ersetzenQuellen(m, 0, 2, 5.0), ",")
n = kern.farbeErsetzen(m, v, kern.ersetzenQuellen(m, 0, 2, 5.0), 2)
PRINT "ersetzt "; n; " "; zustand$(m)
DIM u AS kern.Ebene : u = m.ebenen.ebenen[0]
PRINT "unten "; u.stich(0, 0); "/"; u.stichArt(0, 0); " "; u.stich(3, 0); "/"; u.stichArt(3, 0); "  oben "; m.ebenen.ebenen[1].stich(0, 0)
ok = v.zurueckNehmen(m)
PRINT "zurueck "; zustand$(m)
' sichtbar oben: dann bleibt die verdeckte untere Zelle
m.ebenen.ebenen[1].sichtbar = TRUE
n = kern.farbeErsetzen(m, v, [0], 2)
PRINT "mit oben "; n; " unten 0,0 "; u.stich(0, 0); " oben "; m.ebenen.ebenen[1].stich(0, 0)
ok = v.zurueckNehmen(m)
' Perle -> gewoehnliche Farbe: wird voller Stich
n = kern.farbeErsetzen(m, v, [1], 0)
PRINT "perle zu rot "; u.stich(0, 1); "/"; u.stichArt(0, 1)
' Symbol: doppelt abgelehnt, sonst ein Schritt
PRINT "doppelt: "; kern.symbolSetzen(m, v, 0, "B")
PRINT "leer: "; kern.symbolSetzen(m, v, 0, " ")
PRINT "neu: '"; kern.symbolSetzen(m, v, 0, "★"); "' "; m.farben[0].symbol; " oben "; v.textZurueck$()
ok = v.zurueckNehmen(m)
PRINT "zurueck "; m.farben[0].symbol
--- datei k.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden.dh"

--- erwartet
quellen ohne toleranz 0 mit 5 0,3
ersetzt 4 [Hintergrund:5 *Oben:1] farben A=1 B=1 C=4 D=0 summe 35568723
unten 2/11 2/11  oben 0
zurueck [Hintergrund:5 *Oben:1] farben A=4 B=1 C=0 D=1 summe 733915379
mit oben 3 unten 0,0 0 oben 2
perle zu rot 0/0
doppelt: B hat schon Mill Hill 00557.
leer: Ein Symbol braucht ein Zeichen.
neu: '' ★ oben Symbol ändern
zurueck A
