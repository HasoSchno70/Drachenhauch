--- stderr
jit: 0 Funktionen, 6 Schleifen, 4 Schleifenlaeufe
jit: 2 mal mitten in einer Schleife ausgestiegen

=== eine funktion liest ein globales feld mit untergrenze
' Eine Funktion hat keine Feldbeschreibung; sie liest ueber einen Helfer,
' der die Untergrenze am Feld selbst findet. Bis Stufe 2 blieb sie der VM.
DIM t[1 TO 5] AS INTEGER
DIM i AS INTEGER
FOR i = 1 TO 5
    t[i] = i * i
NEXT
FUNCTION wert(k AS INTEGER) AS INTEGER
    RETURN t[k] + 1
END FUNCTION
PRINT wert(1); " "; wert(5)
TRY
    PRINT wert(0)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_JIT=immer
DHRT_JIT_BILANZ=1
--- erwartet
2 26
Index 0 ausserhalb [1..5] in Dimension 1
--- stderr
jit: 1 Funktionen, 1 Schleifen, 1 Schleifenlaeufe

=== dieselbe schleife mit und ohne untergrenze
' Ein Bereich, gebaut fuer ein Feld ab 0, passt nicht auf eines mit
' Untergrenze (und umgekehrt) -- dann rechnet die VM, das Ergebnis bleibt
' gleich. Zuerst ab 0: andersherum rechnete auch ein falsch gepruefter Bau
' richtig, weil er bei einem Feld ab 0 die Untergrenze 0 abzieht.
FUNCTION summe(a AS ARRAY OF INTEGER) AS INTEGER
    DIM s AS INTEGER
    DIM j AS INTEGER
    FOR j = LBOUND(a) TO UBOUND(a)
        s = s + a[j]
    NEXT
    RETURN s
END FUNCTION
DIM t[1 TO 5] AS INTEGER
DIM u[3] AS INTEGER
DIM i AS INTEGER
FOR i = 1 TO 5
    t[i] = i * i
NEXT
u[0] = 7 : u[1] = 8 : u[2] = 9
PRINT summe(u); " "; summe(t); " "; summe(u)
--- umgebung
DHRT_JIT=immer
--- erwartet
24 55 24
