' Kapitel 3 -- Sinus und Kosinus malen eine Spirale.

SCREEN(640, 400, "Spirale")

DIM i AS INTEGER
DIM winkel AS FLOAT
DIM weite AS FLOAT
DIM _bild AS INTEGER
FOR _bild = 1 TO 12
    CLS(RGB(10, 10, 20))
    FOR i = 0 TO 720
        winkel = RAD(i)
        weite = i / 4
        CIRCLE(320 + COS(winkel) * weite, 200 + SIN(winkel) * weite, 3, RGB(255, i \ 3, 60))
    NEXT
    FLIP()
NEXT
