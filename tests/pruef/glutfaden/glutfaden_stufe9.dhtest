=== vorrat: setzen, 0 nimmt heraus, leere entfernen, schluessel
IMPORT "helfer.dh"
DIM v AS kern.Vorrat : v = kern.vorratLaden("gibt_es_nicht.json")
DIM g AS kern.Garn : g = kern.neuesGarn("Black", 0, "DMC", "310")
DIM e AS kern.Garn : e = kern.neuesGarn("Eigen", 0, "", "")
v.setze(g, 3)
v.setze(e, 2)
PRINT JOIN$(v.schluessel(), " | "); " -> "; v.hole(g); " "; v.hole(e)
v.setze(g, 0)
v.setze(e, -4)
PRINT "nach 0 und -4: "; v.anzahl()
v.setzeSchluessel("x", 1)
MAPPUT(v.daten, "null", 0)
MAPPUT(v.daten, "minus", -1)
PRINT "leere entfernt: "; v.leereEntfernen(); " | "; JOIN$(v.schluessel(), " | ")
DIM a AS STRING, b AS STRING, c AS STRING
(a, b, c) = kern.vorratTeile("unknown::unknown::a::b::c")
PRINT "teile: "; a; "|"; b; "|"; c
