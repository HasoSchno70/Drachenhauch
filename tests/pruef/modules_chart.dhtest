DIM c AS CHART
c = CHART_NEW("tacho", 0, 0, 200, 200)
CHART_ZONE(c, 0, 50, 16711680, "SCHLECHT")
CHART_ZONE(c, 50, 100, 65280)
PRINT "ok"
