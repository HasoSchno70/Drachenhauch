' Namen der Sondertasten: (Name, Keyval) -- der erste Name je Keyval ist der,
' den Glutfaden schreibt; die uebrigen versteht es beim Lesen.
FUNCTION tastenNamen() AS ARRAY OF STRING
    RETURN ["Entf", "Einfg", "Pos1", "Ende", "Bild auf", "Bild ab", "Leertaste", "Enter", "Tab", "Rücktaste", "Esc", _
        "Links", "Rechts", "Hoch", "Runter", "Plus", "Minus", "Komma", "Punkt", _
        "Del", "Delete", "Ins", "Insert", "Home", "End", "PgUp", "PageUp", "PgDown", "PageDown", "Space", "Return", "Backspace", "Escape", _
        "Left", "Right", "Up", "Down", "Comma", "Period"]
END FUNCTION

FUNCTION tastenWerte() AS ARRAY OF INTEGER
    RETURN [&HFFFF, &HFF63, &HFF50, &HFF57, &HFF55, &HFF56, &H20, &HFF0D, &HFF09, &HFF08, &HFF1B, _
        &HFF51, &HFF53, &HFF52, &HFF54, &H2B, &H2D, &H2C, &H2E, _
        &HFFFF, &HFFFF, &HFF63, &HFF63, &HFF50, &HFF57, &HFF55, &HFF55, &HFF56, &HFF56, &H20, &HFF0D, &HFF08, &HFF1B, _
        &HFF51, &HFF53, &HFF52, &HFF54, &H2C, &H2E]
END FUNCTION

' Keyval -> Tastenname ("" fuer Umschalt, Strg & Co. allein)
FUNCTION tastenName$(t AS INTEGER) AS STRING
    IF t >= &H61 AND t <= &H7A THEN RETURN CHR$(t - 32)
    IF t >= &H41 AND t <= &H5A THEN RETURN CHR$(t)
    IF t >= &H30 AND t <= &H39 THEN RETURN CHR$(t)
    IF t >= &HFFB0 AND t <= &HFFB9 THEN RETURN CHR$(t - &HFFB0 + &H30)     ' Ziffernblock
    IF t >= &HFFBE AND t <= &HFFC9 THEN RETURN "F" + STR$(t - &HFFBE + 1)
    SELECT CASE t
        CASE &HFFAB : t = &H2B                  ' Ziffernblock +, -, ., Enter
        CASE &HFFAD : t = &H2D
        CASE &HFFAE : t = &H2E
        CASE &HFF8D : t = &HFF0D
    END SELECT
    DIM w AS ARRAY OF INTEGER : w = tastenWerte()
    DIM i AS INTEGER : i = ARRAY_INDEXOF(w, t)
    IF i >= 0 THEN RETURN tastenNamen()[i]
    IF (t >= &H21 AND t <= &H7E) OR (t >= &HA1 AND t <= &HFF) THEN RETURN UPPER$(CHR$(t))
    RETURN ""
END FUNCTION

' Zaehlt Umschalt mit? Bei Zeichen nicht -- das Zeichen traegt es schon
' (Umschalt+0 ist auf deutscher Tastatur "=", nicht "Umschalt+=").
FUNCTION tasteMitUmschalt(name AS STRING) AS BOOLEAN
    IF LEN(name) > 1 THEN RETURN name <> "Plus" AND name <> "Minus" AND name <> "Komma" AND name <> "Punkt"
    IF (name >= "A" AND name <= "Z") OR (name >= "0" AND name <= "9") THEN RETURN TRUE
    RETURN UPPER$(name) <> LOWER$(name)      ' Buchstaben wie Ä
END FUNCTION

FUNCTION kuerzelBauen$(strg AS BOOLEAN, alt AS BOOLEAN, umschalt AS BOOLEAN, name AS STRING) AS STRING
    IF name = "" THEN RETURN ""
    DIM t AS STRING
    IF strg THEN t = t + "Strg+"
    IF alt THEN t = t + "Alt+"
    IF umschalt AND tasteMitUmschalt(name) THEN t = t + "Umschalt+"
    RETURN t + name
END FUNCTION

' Ein Tastendruck als Kuerzel-Text
FUNCTION kuerzelAusTaste$(t AS INTEGER, strg AS BOOLEAN, alt AS BOOLEAN, umschalt AS BOOLEAN) AS STRING
    RETURN kuerzelBauen$(strg, alt, umschalt, tastenName$(t))
END FUNCTION

' Ein Kuerzel in die Form, die Glutfaden schreibt ("ctrl+shift+s" ->
' "Strg+Umschalt+S"); mehrere durch Komma. "" bei leerem oder krummem Text --
' kuerzelGueltig sagt, welches von beiden.
FUNCTION kuerzelEins$(text AS STRING) AS STRING
    DIM teile AS ARRAY OF STRING : teile = SPLIT$(TRIM$(text), "+")
    ' "Strg++" -- das letzte Plus ist die Taste
    IF RIGHT$(TRIM$(text), 2) = "++" THEN
        teile = SPLIT$(LEFT$(TRIM$(text), LEN(TRIM$(text)) - 2), "+")
        ARRAY_PUSH(teile, "Plus")
    END IF
    IF LEN(teile) = 0 THEN RETURN ""
    DIM strg AS BOOLEAN, alt AS BOOLEAN, umschalt AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(teile) - 2
        SELECT CASE LOWER$(TRIM$(teile[i]))
            CASE "strg", "ctrl", "control" : strg = TRUE
            CASE "alt" : alt = TRUE
            CASE "umschalt", "shift" : umschalt = TRUE
            CASE ELSE : RETURN ""
        END SELECT
    NEXT
    DIM n AS STRING : n = TRIM$(teile[LEN(teile) - 1])
    IF n = "" THEN RETURN ""
    DIM name AS STRING
    IF LEN(n) = 1 THEN
        name = UPPER$(n)
        IF name = "+" THEN name = "Plus"
        IF name = "-" THEN name = "Minus"
        IF name = "," THEN name = "Komma"
        IF name = "." THEN name = "Punkt"
        IF name = " " THEN RETURN ""
    ELSEIF REGEX_TEST(UPPER$(n), "^F([1-9]|1[0-2])$") THEN
        name = UPPER$(n)
    ELSE
        DIM namen AS ARRAY OF STRING : namen = tastenNamen()
        DIM k AS INTEGER
        FOR k = 0 TO LEN(namen) - 1
            IF LOWER$(namen[k]) = LOWER$(n) THEN
                name = tastenName$(tastenWerte()[k])
                EXIT FOR
            END IF
        NEXT
        IF name = "" THEN RETURN ""
    END IF
    RETURN kuerzelBauen$(strg, alt, umschalt, name)
END FUNCTION

FUNCTION kuerzelNormal$(text AS STRING) AS STRING
    IF TRIM$(text) = "" THEN RETURN ""
    DIM aus AS ARRAY OF STRING : aus = []
    DIM s AS STRING
    FOR EACH s IN SPLIT$(text, ",")
        DIM n AS STRING : n = kuerzelEins$(s)
        IF n = "" THEN RETURN ""
        IF ARRAY_INDEXOF(aus, n) < 0 THEN ARRAY_PUSH(aus, n)
    NEXT
    RETURN JOIN$(aus, ", ")
END FUNCTION

FUNCTION kuerzelGueltig(text AS STRING) AS BOOLEAN
    RETURN TRIM$(text) = "" OR kuerzelNormal$(text) <> ""
END FUNCTION

' Die Kuerzel, die gerade gelten, je Aktion in Reihenfolge der Tafel. Ein
' eigenes Kuerzel, das mit einem anderen zusammenstoesst, wird uebergangen --
' die Aktion behaelt ihre Vorgabe (apply_saved_overrides).
FUNCTION kuerzelWirksam(e AS Einstellungen) AS ARRAY OF STRING
    DIM aktionen AS ARRAY OF Kuerzelaktion : aktionen = kuerzelAktionen()
    DIM w AS ARRAY OF STRING : w = []
    DIM a AS Kuerzelaktion
    FOR EACH a IN aktionen
        ARRAY_PUSH(w, kuerzelNormal$(a.vorgabe))
    NEXT
    DIM i AS INTEGER
    FOR i = 0 TO LEN(aktionen) - 1
        IF NOT MAPHAS(e.kuerzel, aktionen[i].kennung) THEN CONTINUE
        DIM eigen AS STRING : eigen = kuerzelNormal$(e.kuerzel[aktionen[i].kennung])
        IF eigen = "" THEN CONTINUE
        IF kuerzelKonflikt(w, eigen, i) < 0 THEN w[i] = eigen
    NEXT
    RETURN w
END FUNCTION

' Welche andere Aktion (Nummer in der Tafel) hat schon eine dieser Tasten?
' -1 = keine.
FUNCTION kuerzelKonflikt(w AS ARRAY OF STRING, kuerzel AS STRING, ausser AS INTEGER) AS INTEGER
    IF kuerzel = "" THEN RETURN -1
    DIM s AS STRING
    FOR EACH s IN SPLIT$(kuerzel, ", ")
        DIM j AS INTEGER
        FOR j = 0 TO LEN(w) - 1
            IF j = ausser OR w[j] = "" THEN CONTINUE
            IF ARRAY_INDEXOF(SPLIT$(w[j], ", "), s) >= 0 THEN RETURN j
        NEXT
    NEXT
    RETURN -1
END FUNCTION

' Taste -> Kennung der Aktion, fuer die Tastenabfrage
FUNCTION kuerzelTafel(e AS Einstellungen) AS MAP OF STRING
    DIM tafel AS MAP OF STRING : tafel = {}
    DIM aktionen AS ARRAY OF Kuerzelaktion : aktionen = kuerzelAktionen()
    DIM w AS ARRAY OF STRING : w = kuerzelWirksam(e)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(aktionen) - 1
        IF w[i] = "" THEN CONTINUE
        DIM s AS STRING
        FOR EACH s IN SPLIT$(w[i], ", ")
            MAPPUT(tafel, s, aktionen[i].kennung)
        NEXT
    NEXT
    RETURN tafel
END FUNCTION

' Fuer die Anzeige: das wirksame Kuerzel einer Aktion
FUNCTION kuerzelVon$(e AS Einstellungen, kennung AS STRING) AS STRING
    DIM aktionen AS ARRAY OF Kuerzelaktion : aktionen = kuerzelAktionen()
    DIM w AS ARRAY OF STRING : w = kuerzelWirksam(e)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(aktionen) - 1
        IF aktionen[i].kennung = kennung THEN RETURN w[i]
    NEXT
    RETURN ""
END FUNCTION

' --- Fuellen mit Toleranz ----------------------------------------------------------

' Welche Farbnummern beim Fuellen als "gleich" gelten: die Zielfarbe selbst
' und, mit Toleranz, jede Farbe mit CIEDE2000 <= 50 * Toleranz/100 zur Zielfarbe
' (fill_tool.py). Ohne Stich (-1) zaehlt nur ohne Stich. passt[k+1] fuer k.
FUNCTION fuellPassend(farben AS ARRAY OF INTEGER, ziel AS INTEGER, toleranz AS INTEGER) AS ARRAY OF INTEGER
    DIM n AS INTEGER : n = LEN(farben)
    DIM passt[n + 1] AS INTEGER
    passt[ziel + 1] = 1
    IF ziel < 0 OR ziel >= n OR toleranz <= 0 THEN RETURN passt
    DIM grenze AS FLOAT : grenze = 50.0 * toleranz / 100.0
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        IF farbAbstand(farben[ziel], farben[k]) <= grenze THEN passt[k + 1] = 1
    NEXT
    RETURN passt
END FUNCTION

' Die Tastenkuerzel-Uebersicht (PySticky _on_show_shortcuts): je Aktion
' "Name<TAB>Kuerzel" mit dem WIRKSAMEN Kuerzel -- dieselbe Tafel wie der
' Einstellungsreiter, sonst zeigte die Hilfe nach einem Umlegen die alte Taste.
FUNCTION kuerzelListe(e AS Einstellungen) AS ARRAY OF STRING
    DIM aktionen AS ARRAY OF Kuerzelaktion : aktionen = kuerzelAktionen()
    DIM w AS ARRAY OF STRING : w = kuerzelWirksam(e)
    DIM aus AS ARRAY OF STRING : aus = []
    DIM i AS INTEGER
    FOR i = 0 TO LEN(aktionen) - 1
        ARRAY_PUSH(aus, aktionen[i].name + CHR$(9) + w[i])
    NEXT
    RETURN aus
END FUNCTION

' Der Bereich des Zoom-Reglers in Prozent (PySticky ZoomSlider.set_zoom_range):
' aus den Zellgroessen der Einstellungen, 100 % = Standardzelle. Ein fester
' Bereich liesse den Regler bei eigenen Groessen etwas anderes zeigen, als die
' Flaeche tut.
FUNCTION zoomBereich(e AS Einstellungen) AS TUPLE
    DIM s AS INTEGER : s = MAX(1, e.zelleStandard)
    DIM von AS INTEGER : von = MAX(1, ROUND(e.zelleMin * 100.0 / s))
    DIM bis AS INTEGER : bis = MAX(von + 1, ROUND(e.zelleMax * 100.0 / s))
    RETURN (von, bis)
END FUNCTION

' --- Erscheinungsbild (PySticky styles: DARK_THEME / LIGHT_THEME) -------------------

' Je Rolle: Name, dunkel, hell. Das Stylesheet benutzt die Namen (@gf_name,
' GTKs @define-color); die gezeichneten Teile um die Flaeche fragen
' themaFarbe mit der dunklen Farbe -- so steht jede Farbe genau einmal hier.
FUNCTION themaTafel() AS ARRAY OF STRING
    RETURN ["fenster", "1b1c20", "fbfbfd",
        "kopf_oben", "2c2e35", "f3f4f8",
        "kopf_unten", "22242a", "e6e8ef",
        "linie", "0c0d10", "b8bccf",
        "titel", "f2f3f7", "1a1a2e",
        "leise2", "9aa0ad", "6a6a8a",
        "knopf_text", "d6d9e1", "3a3a60",
        "leiste", "202228", "ecedf3",
        "feld", "2a2c33", "ffffff",
        "text", "e4e5ea", "1a1a2e",
        "rand", "3a3c44", "9aa1bd",
        "zoom", "c9ccd4", "3a3a60",
        "leise", "8d93a1", "6a6a8a",
        "akzent", "ff8a3d", "d4661a",
        "benutzt", "ffb27a", "b8601e",
        "flaeche2", "33363e", "dde0eb",
        "status", "16171b", "e6e8ef",
        "zahl", "5c606b", "9aa0ad",
        "karte", "26282f", "f3f4f8",
        "reiter", "b9bdc8", "4a4a6a",
        "warn", "e0b040", "a87a10",
        "ok", "40c870", "22a060",
        "t_orange", "4a3527", "fbe3d2",
        "t_blau", "263547", "dbe6f5",
        "t_tuerkis", "234240", "d6efec",
        "t_lila", "3a2f4a", "ece2f7",
        "lineal_text", "6a6e78", "9aa0ad"]
END FUNCTION

FUNCTION themaHell(e AS Einstellungen) AS BOOLEAN
    RETURN e.thema = "light"
END FUNCTION

' Die Farbdefinitionen vor dem Stylesheet
FUNCTION stilFarben$(hell AS BOOLEAN) AS STRING
    DIM t AS ARRAY OF STRING : t = themaTafel()
    DIM aus AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(t) - 1 STEP 3
        aus = aus + "@define-color gf_" + t[i] + " #" + t[i + IIF(hell, 2, 1)] + ";" + CHR$(10)
    NEXT
    aus = aus + "@define-color gf_hover " + IIF(hell, "alpha(#000000, 0.06)", "alpha(#ffffff, 0.08)") + ";" + CHR$(10)
    aus = aus + "@define-color gf_gewaehlt_text " + IIF(hell, "#1a1a2e", "#ffffff") + ";" + CHR$(10)
    RETURN aus
END FUNCTION

' Eine Farbe der dunklen Oberflaeche im gewaehlten Thema (unbekannte bleiben)
FUNCTION themaFarbe(f AS INTEGER, hell AS BOOLEAN) AS INTEGER
    IF NOT hell THEN RETURN f
    DIM t AS ARRAY OF STRING : t = themaTafel()
    DIM i AS INTEGER
    FOR i = 0 TO LEN(t) - 1 STEP 3
        IF VAL("&H" + t[i + 1]) = f THEN RETURN VAL("&H" + t[i + 2])
    NEXT
    RETURN f
END FUNCTION
