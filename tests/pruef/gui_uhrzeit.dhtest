' Der Uhrzeitwaehler (GUI_TIMEPICKER) -- das Gegenstueck zum Datumswaehler.
' Nach aussen gilt EIN Format, `HH:MM:SS` wie TIME$(), auch wenn die
' Sekunden nicht dastehen; hinein darf `HH:MM`. Geprueft wird das Format,
' das Umlaufen an den Grenzen, die Schrittweite und der Klick auf die
' Pfeile. Format: docs/werkzeuge.md, dhrt test.

=== setzen und lesen
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tp AS GUI_WIDGET : tp = GUI_TIMEPICKER(w, 20, 20)
PRINT GUI_TIME$(tp)
GUI_SET_TIME(tp, "07:05")
PRINT GUI_TIME$(tp)
GUI_SET_TIME(tp, "23:59:58")
PRINT GUI_TIME$(tp)
--- umgebung
DHRT_FRAMES=1
--- erwartet
12:00:00
07:05:00
23:59:58

=== eine krumme uhrzeit wird abgelehnt
' Still auf 00:00 zu fallen waere schlimmer: man saehe es erst an dem, was
' das Programm damit macht.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tp AS GUI_WIDGET : tp = GUI_TIMEPICKER(w, 20, 20)
TRY
    GUI_SET_TIME(tp, "25:00")
CATCH e
    PRINT e
END TRY
TRY
    GUI_SET_TIME(tp, "viertel nach drei")
CATCH e
    PRINT e
END TRY
PRINT GUI_TIME$(tp)
--- umgebung
DHRT_FRAMES=1
--- enthaelt
liegt ausserhalb
ist keine Uhrzeit
12:00:00

=== die pfeile drehen, und an der grenze laeuft es um
' Der erste Klick trifft die obere Haelfte des Stundenfelds (hoch), der
' zweite die untere (runter). Das Widget sitzt bei (20,20) im Fenster
' (10,10); ein Feld ist 47 Punkte breit, die Hoehe 34.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM tp AS GUI_WIDGET : tp = GUI_TIMEPICKER(w, 20, 20)
GUI_SET_TIME(tp, "23:58")
DIM f AS INTEGER
FOR f = 1 TO 24
    GUI_UPDATE()
    IF f = 8 OR f = 16 OR f = 23 THEN PRINT GUI_TIME$(tp)
    GUI_DRAW()
    FLIP()
NEXT
--- datei ev.txt
# hoch im Stundenfeld (23 -> 0), dann runter (0 -> 23), dann hoch in der Minute
c 16
e 3 7 45 62 0 0
e 4 7 45 62 0 0
e 4 6 0 0 0 0
e 5 5 0 0 0 0
e 11 7 45 80 0 0
e 12 7 45 80 0 0
e 12 6 0 0 0 0
e 13 5 0 0 0 0
e 18 7 100 62 0 0
e 19 7 100 62 0 0
e 19 6 0 0 0 0
e 20 5 0 0 0 0
--- umgebung
DHRT_FRAMES=26
--- erwartet
00:58:00
23:58:00
23:59:00

=== die schrittweite gilt fuer die minute
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM tp AS GUI_WIDGET : tp = GUI_TIMEPICKER(w, 20, 20)
GUI_SET_TIME(tp, "08:00")
GUI_TIMEPICKER_SET(tp, "schritt", 15)
DIM f AS INTEGER
FOR f = 1 TO 16
    GUI_UPDATE()
    IF f = 15 THEN PRINT GUI_TIME$(tp)
    GUI_DRAW()
    FLIP()
NEXT
--- datei ev.txt
# zweimal hoch im Minutenfeld
c 8
e 3 7 100 62 0 0
e 4 7 100 62 0 0
e 4 6 0 0 0 0
e 5 5 0 0 0 0
e 8 6 0 0 0 0
e 9 5 0 0 0 0
--- umgebung
DHRT_FRAMES=18
--- erwartet
08:30:00

=== mit sekunden wird das widget breiter
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM tp AS GUI_WIDGET : tp = GUI_TIMEPICKER(w, 20, 20)
DIM schmal AS INTEGER : schmal = GUI_GET_W(tp)
GUI_TIMEPICKER_SET(tp, "sekunden", 1)
PRINT GUI_GET_W(tp) > schmal
' Eine selbst gesetzte Breite bleibt, wie sie ist.
DIM tp2 AS GUI_WIDGET : tp2 = GUI_TIMEPICKER(w, 20, 80, 200, 30)
GUI_TIMEPICKER_SET(tp2, "sekunden", 1)
PRINT GUI_GET_W(tp2)
--- umgebung
DHRT_FRAMES=1
--- erwartet
TRUE
200

=== ein anderes widget ist kein uhrzeitwaehler
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "A", 10, 10, 80, 30)
TRY
    PRINT GUI_TIME$(b)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_FRAMES=1
--- enthaelt
kein Uhrzeitwaehler
