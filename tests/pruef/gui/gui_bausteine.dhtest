=== alt-buchstaben druecken, kippen und springen
' Ohne GUI_MNEMONICS steht das & woertlich da und Alt tut nichts (zweiter
' Fall). GUI_TEXT liefert den Text samt &; gemessen wird ohne.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
GUI_MNEMONICS(TRUE)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 400, 300)
GUI_WINDOW_CHROME(w, FALSE)
DIM sp AS GUI_WIDGET : sp = GUI_BUTTON(w, "&Speichern", 10, 10, 0, 0)
DIM ohne AS GUI_WIDGET : ohne = GUI_BUTTON(w, "Speichern", 10, 50, 0, 0)
DIM cb AS GUI_WIDGET : cb = GUI_CHECKBOX(w, "&Raster", 10, 90)
DIM lb AS GUI_WIDGET : lb = GUI_LABEL(w, "&Name:", 10, 130)
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 80, 126, 150, 28)
GUI_FOCUS(sp)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
DIM geklickt AS INTEGER : geklickt = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF GUI_CLICKED(sp) THEN geklickt = geklickt + 1
    IF n = 3 THEN PRINT "text " + GUI_TEXT(sp) + " gleich breit " + STR$(GUI_GET_W(sp) = GUI_GET_W(ohne))
    IF n = 40 THEN PRINT "geklickt " + STR$(geklickt) + " haken " + STR$(GUI_CHECKED(cb)) + " feld hat fokus " + STR$(GUI_FOCUSED() = tf)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
