' 90_billboards_picking.gb -- Billboards + Ray-Kollision/Picking (native-only, F6)
'
' BILLBOARD(bild, x,y,z, groesse, farbe)
'     Textur im 3D-Raum, die immer zur Kamera zeigt (Baeume/Sprites/Funken).
' RAY_HIT_BOX(ox,oy,oz, dx,dy,dz, cx,cy,cz, sx,sy,sz) -> dist | -1
' RAY_HIT_SPHERE(ox,oy,oz, dx,dy,dz, cx,cy,cz, r)      -> dist | -1
' PICK_BOX(cx,cy,cz, sx,sy,sz) / PICK_SPHERE(cx,cy,cz, r)
'     Mausstrahl durch die aktuelle 3D-Kamera; Distanz oder -1 (Klick-Selektion).

IMPORT "g3d"

SCREEN(800, 480, "Billboards + Picking", 1)

DIM coin AS INTEGER
coin = LOADIMAGE("assets/coin.png")

' Positionen dreier auswaehlbarer Objekte.
DIM bx AS FLOAT
DIM sx AS FLOAT
bx = -2.5
sx = 2.5

DIM t AS FLOAT
t = 0.0

DIM frame AS INTEGER
FOR frame = 0 TO 100000
    IF QUITREQUESTED() THEN BREAK
    t = t + 0.01

    CLS(&H0C1018)
    CAMERA3D(0, 5, 9, 0, 1, 0, 45)

    GRID3D(16, 1.0)

    ' Maus-Picking: leuchtet das Objekt unter dem Cursor?
    DIM box_hit AS FLOAT
    DIM sph_hit AS FLOAT
    box_hit = PICK_BOX(bx, 1, 0, 1.6, 1.6, 1.6)
    sph_hit = PICK_SPHERE(sx, 1, 0, 1.0)

    DIM box_col AS INTEGER
    DIM sph_col AS INTEGER
    box_col = IIF(box_hit >= 0, &HFFE060, &H4080FF)
    sph_col = IIF(sph_hit >= 0, &HFFE060, &HFF5080)

    CUBE(bx, 1, 0, 1.6, 1.6, 1.6, box_col)
    CUBE_WIRES(bx, 1, 0, 1.6, 1.6, 1.6, &H101820)
    SPHERE(sx, 1, 0, 1.0, sph_col)

    ' Drei zur Kamera ausgerichtete Billboards (schweben + bobben leicht).
    DIM i AS INTEGER
    FOR i = -1 TO 1
        DIM bbx AS FLOAT
        DIM bby AS FLOAT
        bbx = i * 2.0
        bby = 2.6 + SIN(t * 3.0 + i) * 0.25
        BILLBOARD(coin, bbx, bby, -2.0, 1.0, WHITE)
    NEXT

    TEXT(12, 10, "Billboards (Coins) zeigen immer zur Kamera", WHITE)
    TEXT(12, 34, "Maus ueber Wuerfel/Kugel -> leuchtet (Picking)", &H88AACC)

    FLIP()
NEXT
