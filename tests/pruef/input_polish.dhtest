' Aus test_input_polish.py uebertragen (11 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== special keys have readable names
SCREEN(160, 120, "In", 1)
PRINT KEY_NAME$(KEY_SPACE)
PRINT KEY_NAME$(KEY_LEFT)
PRINT KEY_NAME$(KEY_F5)
PRINT KEY_NAME$(KEY_LSHIFT)
PRINT KEY_NAME$(KEY_KP_ENTER)
--- umgebung
DHRT_FRAMES=1
--- erwartet
LEER
LINKS
F5
UMSCHALT
ENTER

=== printable key uses the keyboard layout
SCREEN(160, 120, "In", 1)
PRINT KEY_NAME$(KEY_A)
--- umgebung
DHRT_FRAMES=1
--- erwartet
A

=== unknown code yields an empty name
SCREEN(160, 120, "In", 1)
PRINT "[" + KEY_NAME$(JOY_BUTTON_A) + "]"
PRINT "[" + KEY_NAME$(999999) + "]"
--- umgebung
DHRT_FRAMES=1
--- erwartet
[]
[]

=== key any hit is idle without input
SCREEN(160, 120, "In", 1)
PRINT KEY_ANY_HIT()
--- umgebung
DHRT_FRAMES=1
--- erwartet
-1

=== every new key constant maps to a real key
SCREEN(160, 120, "In", 1)
PRINT "KEY_LSHIFT=" + KEY_NAME$(KEY_LSHIFT)
PRINT "KEY_RSHIFT=" + KEY_NAME$(KEY_RSHIFT)
PRINT "KEY_LCTRL=" + KEY_NAME$(KEY_LCTRL)
PRINT "KEY_RCTRL=" + KEY_NAME$(KEY_RCTRL)
PRINT "KEY_LALT=" + KEY_NAME$(KEY_LALT)
PRINT "KEY_RALT=" + KEY_NAME$(KEY_RALT)
PRINT "KEY_LSUPER=" + KEY_NAME$(KEY_LSUPER)
PRINT "KEY_RSUPER=" + KEY_NAME$(KEY_RSUPER)
PRINT "KEY_CAPSLOCK=" + KEY_NAME$(KEY_CAPSLOCK)
PRINT "KEY_INSERT=" + KEY_NAME$(KEY_INSERT)
PRINT "KEY_DELETE=" + KEY_NAME$(KEY_DELETE)
PRINT "KEY_HOME=" + KEY_NAME$(KEY_HOME)
PRINT "KEY_END=" + KEY_NAME$(KEY_END)
PRINT "KEY_PAGEUP=" + KEY_NAME$(KEY_PAGEUP)
PRINT "KEY_PAGEDOWN=" + KEY_NAME$(KEY_PAGEDOWN)
PRINT "KEY_KP0 da: " + IIF(KEY_NAME$(KEY_KP0) <> "", "ja", "nein")
PRINT "KEY_KP1 da: " + IIF(KEY_NAME$(KEY_KP1) <> "", "ja", "nein")
PRINT "KEY_KP2 da: " + IIF(KEY_NAME$(KEY_KP2) <> "", "ja", "nein")
PRINT "KEY_KP3 da: " + IIF(KEY_NAME$(KEY_KP3) <> "", "ja", "nein")
PRINT "KEY_KP4 da: " + IIF(KEY_NAME$(KEY_KP4) <> "", "ja", "nein")
PRINT "KEY_KP5 da: " + IIF(KEY_NAME$(KEY_KP5) <> "", "ja", "nein")
PRINT "KEY_KP6 da: " + IIF(KEY_NAME$(KEY_KP6) <> "", "ja", "nein")
PRINT "KEY_KP7 da: " + IIF(KEY_NAME$(KEY_KP7) <> "", "ja", "nein")
PRINT "KEY_KP8 da: " + IIF(KEY_NAME$(KEY_KP8) <> "", "ja", "nein")
PRINT "KEY_KP9 da: " + IIF(KEY_NAME$(KEY_KP9) <> "", "ja", "nein")
PRINT "KEY_KP_ENTER=" + KEY_NAME$(KEY_KP_ENTER)
' Die ZEICHEN der Rechentasten am Ziffernblock kommen aus der
' Tastaturbelegung (GLFW `glfwGetKeyName`), nicht aus einer Tabelle von
' dhrt -- und was dort steht, hing hier schon einmal davon ab, ob die
' Belegung beim ersten Bild ueberhaupt geladen war (einmal `^` statt `/`).
' Geprueft wird darum, DASS ein Name da ist; die Frage dieses Falls ist
' ohnehin, ob jede neue Konstante auf eine echte Taste zeigt.
PRINT "KEY_KP_PLUS da: " + IIF(KEY_NAME$(KEY_KP_PLUS) <> "", "ja", "nein")
PRINT "KEY_KP_MINUS da: " + IIF(KEY_NAME$(KEY_KP_MINUS) <> "", "ja", "nein")
PRINT "KEY_KP_MULTIPLY da: " + IIF(KEY_NAME$(KEY_KP_MULTIPLY) <> "", "ja", "nein")
PRINT "KEY_KP_DIVIDE da: " + IIF(KEY_NAME$(KEY_KP_DIVIDE) <> "", "ja", "nein")
PRINT "KEY_KP_PERIOD da: " + IIF(KEY_NAME$(KEY_KP_PERIOD) <> "", "ja", "nein")
--- umgebung
DHRT_FRAMES=1
--- erwartet
KEY_LSHIFT=UMSCHALT
KEY_RSHIFT=UMSCHALT
KEY_LCTRL=STRG
KEY_RCTRL=STRG
KEY_LALT=ALT
KEY_RALT=ALT
KEY_LSUPER=SUPER
KEY_RSUPER=SUPER
KEY_CAPSLOCK=FESTSTELL
KEY_INSERT=EINFG
KEY_DELETE=ENTF
KEY_HOME=POS1
KEY_END=ENDE
KEY_PAGEUP=BILD-AUF
KEY_PAGEDOWN=BILD-AB
KEY_KP0 da: ja
KEY_KP1 da: ja
KEY_KP2 da: ja
KEY_KP3 da: ja
KEY_KP4 da: ja
KEY_KP5 da: ja
KEY_KP6 da: ja
KEY_KP7 da: ja
KEY_KP8 da: ja
KEY_KP9 da: ja
KEY_KP_ENTER=ENTER
KEY_KP_PLUS da: ja
KEY_KP_MINUS da: ja
KEY_KP_MULTIPLY da: ja
KEY_KP_DIVIDE da: ja
KEY_KP_PERIOD da: ja

=== new keys are queryable and idle
SCREEN(160, 120, "In", 1)
PRINT KEYPRESSED(KEY_LSHIFT)
PRINT KEYHIT(KEY_KP_ENTER)
PRINT KEYRELEASED(KEY_PAGEUP)
--- umgebung
DHRT_FRAMES=1
--- erwartet
FALSE
FALSE
FALSE

=== mouse wheel has both axes and is fractional
SCREEN(160, 120, "In", 1)
PRINT MOUSEWHEEL_X()
PRINT MOUSEWHEEL_Y()
--- umgebung
DHRT_FRAMES=1
--- erwartet
0.0
0.0

=== mouse wheel axes work without a window
PRINT MOUSEWHEEL_X()
PRINT MOUSEWHEEL_Y()
--- umgebung
DHRT_FRAMES=1
--- erwartet
0.0
0.0

=== gamepad mappings accepts an sdl line
SCREEN(160, 120, "In", 1)
PRINT JOYSTICK_MAPPINGS("030000005e0400008e02000014010000,Xbox 360 Controller,a:b0,b:b1,x:b2,y:b3,platform:Windows,")
--- umgebung
DHRT_FRAMES=1
--- erwartet
1

=== garbage mappings do not crash
SCREEN(160, 120, "In", 1)
PRINT JOYSTICK_MAPPINGS("")
PRINT JOYSTICK_MAPPINGS("kein mapping")
--- umgebung
DHRT_FRAMES=1
--- erwartet
1
1

=== window dpi scale is positive
SCREEN(160, 120, "In", 1)
PRINT WINDOW_DPI_X() > 0.0
PRINT WINDOW_DPI_Y() > 0.0
--- umgebung
DHRT_FRAMES=1
--- erwartet
TRUE
TRUE

