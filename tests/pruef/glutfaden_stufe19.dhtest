=== probe: leisten, pipette, paletten, drucken
IMPORT "helfer.dh"
' --probe-stufe19 mit alle.pxs: Rueckstich- und Text-Leiste, Bildschirm-
' Pipette (schliesst sich selbst), Farbe uebernehmen, Palette schreiben und
' lesen, Drucken als PDF und als Bild.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe19", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["rueckstich", "text", "pipette"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    PRINT "pdf: "; LEFT$(JOIN$(READLINES("druck.pdf", "latin1"), " "), 5)
    ' Das Druckbild (794 x 1123): eine Zelle mit vollem Stich in ihrer Farbe
    ' (nahe der Ecke gemessen, weg vom Symbol), der Rand weiss, das Raster grau.
    ' Zwei der neun Ecken liegen unter einer Rueckstichlinie (1,1 blau, 10,1
    ' rot) und zeigen deren Farbe -- die Rueckstiche kommen also mit aufs Blatt
    DIM b AS IMAGE : b = LOADIMAGE("d_druck.png")
    DIM m AS kern.Muster : m = kern.pxsLaden("alle.pxs")
    DIM fa AS ARRAY OF INTEGER, ta AS ARRAY OF INTEGER, ea AS ARRAY OF INTEGER
    m.ebenen.zusammensetzen(fa, ta, ea)
    DIM z AS FLOAT, ox AS FLOAT, oy AS FLOAT
    (z, ox, oy) = kern.druckLage(m.breite, m.hoehe, 794.0, 1123.0)
    DIM i AS INTEGER, treffer AS INTEGER, geprueft AS INTEGER
    FOR i = 0 TO LEN(fa) - 1
        IF fa[i] < 0 OR ta[i] <> kern.VOLL THEN CONTINUE
        DIM px AS INTEGER : px = INT(ox + (i MOD m.breite) * z + 5)
        DIM py AS INTEGER : py = INT(oy + (i \ m.breite) * z + 5)
        geprueft = geprueft + 1
        IF (GETPIXEL(b, px, py) BAND &HFFFFFF) = m.farben[fa[i]].garn.farbe THEN treffer = treffer + 1
    NEXT
    PRINT "druck: "; IMAGE_WIDTH(b); "x"; IMAGE_HEIGHT(b); " | volle zellen in ihrer farbe "; treffer; " von "; geprueft; " | rand "; HEX$(GETPIXEL(b, 10, 10) BAND &HFFFFFF); " | raster grau "; HEX$(GETPIXEL(b, INT(ox + z), INT(oy + z / 2)) BAND &HFFFFFF)
    PRINT "datei unveraendert: "; READLINES("alle.pxs")[0] = READLINES("vorher.pxs")[0]
END IF
