=== zuschneiden beachtet auch ausgeblendete ebenen
' Was auf einer ausgeblendeten Ebene liegt, darf nicht weggeschnitten werden.
DIM prBild AS INTEGER : prBild = 0
DIM prStart AS INTEGER : prStart = -1
DIM prF AS ARRAY OF INTEGER : prF = []
DIM prZ AS ARRAY OF STRING : prZ = []
DIM prFlag AS STRING : prFlag = ""
DIM prG AS INTEGER : prG = 0
DIM prD AS INTEGER : prD = 0
DIM prL AS INTEGER : prL = 0
DIM prA AS INTEGER : prA = 0
DIM prB AS INTEGER : prB = 0
DIM prC AS INTEGER : prC = 0
DIM prE4 AS INTEGER : prE4 = 0
SUB prE(f AS INTEGER, typ AS INTEGER, a AS INTEGER, b AS INTEGER)
    ARRAY_PUSH(prF, f)
    ARRAY_PUSH(prZ, STR$(typ) + " " + STR$(a) + " " + STR$(b) + " 0 0")
END SUB
SUB prKlick(f AS INTEGER, x AS INTEGER, y AS INTEGER)
    prE(f, 7, x, y)
    prE(f + 1, 7, x, y)
    prE(f + 1, 6, 0, 0)
    prE(f + 2, 5, 0, 0)
END SUB
SUB prKnopf(f AS INTEGER, x AS INTEGER, y AS INTEGER, breite AS INTEGER)
    ' Mitte eines Knopfes -- die Lage ist seine linke obere Ecke.
    prKlick(f, x + breite \ 2, y + 14)
END SUB
SUB prTaste(f AS INTEGER, code AS INTEGER)
    prE(f, 2, code, 0)
    prE(f + 1, 1, code, 0)
END SUB
SUB prStrg(f AS INTEGER, code AS INTEGER)
    ' Strg in JEDEM Bild; der Buchstabe hat seine Flanke, waehrend Strg steht.
    DIM i AS INTEGER
    FOR i = 0 TO 4
        prE(f + i, 2, 341, 0)
    NEXT
    prE(f + 2, 2, code, 0)
    prE(f + 3, 1, code, 0)
    prE(f + 5, 1, 341, 0)
END SUB
FUNCTION prMx(x AS INTEGER) AS INTEGER
    RETURN ox + x * zoom + zoom \ 2
END FUNCTION
FUNCTION prMy(y AS INTEGER) AS INTEGER
    RETURN oy + y * zoom + zoom \ 2
END FUNCTION
SUB prZugPunkte(f AS INTEGER, xs AS ARRAY OF INTEGER, ys AS ARRAY OF INTEGER)
    ' Ein Mausweg in Bildpunkten; der Knopf wird in JEDEM Bild gemeldet.
    DIM i AS INTEGER
    FOR i = 0 TO LEN(xs) - 1
        prE(f + i, 7, prMx(xs[i]), prMy(ys[i]))
        prE(f + i, 6, 0, 0)
    NEXT
    prE(f + LEN(xs), 5, 0, 0)
END SUB
FUNCTION prStrich(f AS INTEGER, y AS INTEGER, von AS INTEGER, bis AS INTEGER) AS INTEGER
    ' Waagerechter Strich x = von .. bis - 1; liefert die Zahl der Punkte.
    DIM xs AS ARRAY OF INTEGER : xs = []
    DIM ys AS ARRAY OF INTEGER : ys = []
    DIM x AS INTEGER
    FOR x = von TO bis - 1
        ARRAY_PUSH(xs, x) : ARRAY_PUSH(ys, y)
    NEXT
    prZugPunkte(f, xs, ys)
    RETURN LEN(xs)
END FUNCTION
FUNCTION prDreieck(f AS INTEGER) AS INTEGER
    ' Ein Weg um das Dreieck (2,2)-(20,2)-(2,20), je Kante 7 Punkte.
    DIM ex AS ARRAY OF INTEGER : ex = [2, 20, 2]
    DIM ey AS ARRAY OF INTEGER : ey = [2, 2, 20]
    DIM xs AS ARRAY OF INTEGER : xs = []
    DIM ys AS ARRAY OF INTEGER : ys = []
    DIM i AS INTEGER
    DIM t AS INTEGER
    FOR i = 0 TO 2
        DIM ax AS INTEGER : ax = ex[i]
        DIM ay AS INTEGER : ay = ey[i]
        DIM bx AS INTEGER : bx = ex[(i + 1) MOD 3]
        DIM by AS INTEGER : by = ey[(i + 1) MOD 3]
        FOR t = 0 TO 6
            ARRAY_PUSH(xs, INT(ROUND(ax + (bx - ax) * t / 7.0)))
            ARRAY_PUSH(ys, INT(ROUND(ay + (by - ay) * t / 7.0)))
        NEXT
    NEXT
    prZugPunkte(f, xs, ys)
    RETURN LEN(xs)
END FUNCTION
