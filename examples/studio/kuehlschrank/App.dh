' Die Kühlschrank-Verwaltung: Vorrat, Lagerorte, Einkauf, Statistik und
' Rezepte. Ein Port der PySide6-App „Kühlschrank“ ins Drachenhauch Studio --
' sie liest dieselbe Datei fridge_database.db. Beim Start öffnet die App die
' Datenbank (eine neue bekommt die Startdaten), am Ende schließt sie sie.
CLASS App EXTENDS StudioApp

    SUB Geoeffnet()
        dbOeffnen()
        ' Die Sprache aus den Einstellungen (Tafel sprache/en.txt); ohne
        ' Einstellung die von DHRT_LANG -- das wählt die Laufzeit schon selbst.
        DIM sp AS STRING : sp = einstellung$("language", "")
        IF sp <> "" THEN SpracheWaehlen(IIF(sp = "en", "en", ""))
        ' Hell oder dunkel nach den Einstellungen, mit dem Teal der Python-App.
        themaSetzen(einstellungJa("dark_mode", TRUE))
    END SUB

    SUB Beenden()
        DB_CLOSE(db)
    END SUB
END CLASS
