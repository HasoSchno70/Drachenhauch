--- erwartet
gleich: FALSE FALSE | schritte 0
kleiner: TRUE | 20x12 ebenen 20x12 rueck 12 | Größe ändern
rueckgaengig wie vorher: TRUE
wiederholt: 20x12 20 240
smart: TRUE | 60x48 stiche 2800
rueckgaengig wie vorher: TRUE
fehler: Ungültige Größe: 0x10 (min. 1x1)
fehler: Ungültige Größe: -3x10 (min. 1x1)

=== versionen: anlegen, hoechstens 20, faellig, schluessel
IMPORT "helfer.dh"
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
DIM s AS STRING : s = kern.schnappschussSchluessel$(m, "C:/irgendwo/Mein Muster.v2.pxs", "abcd")
PRINT "schluessel datei: "; s; " | ordner "; BASENAME(kern.schnappschussOrdner$(s)); " in "; BASENAME(DIRNAME(kern.schnappschussOrdner$(s)))
PRINT "schluessel ungesichert: "; kern.schnappschussSchluessel$(m, "", "abcd"); " | "; kern.schnappschussSchluessel$(kern.neuesMuster("", 2, 2), "", "x1")
DIM t0 AS INTEGER : t0 = ZEIT_AUS_TEILEN(2026, 3, 29, 1, 59, 30)
PRINT "faellig ohne: "; kern.schnappschussFaellig(s, t0, 1800)
DIM erster AS STRING : erster = kern.schnappschussAnlegen(m, s, t0, 20)
PRINT "erster: "; BASENAME(erster); " zeit "; kern.schnappschussZeit(erster) = t0
DIM gleich AS STRING : gleich = kern.schnappschussAnlegen(m, s, t0, 20)
PRINT "gleiche sekunde: "; BASENAME(gleich)
PRINT "faellig nach 1799: "; kern.schnappschussFaellig(s, t0 + 1 + 1799, 1800); " nach 1800: "; kern.schnappschussFaellig(s, t0 + 1 + 1800, 1800)
DIM i AS INTEGER
FOR i = 1 TO 22
    erster = kern.schnappschussAnlegen(m, s, t0 + 60 * i, 20)
NEXT
DIM alle AS ARRAY OF STRING : alle = kern.schnappschuesse(s)
PRINT "nach 24: "; LEN(alle); " | neuester "; BASENAME(alle[0]); " | aeltester "; BASENAME(alle[LEN(alle) - 1])
WRITEALL(PATHJOIN(kern.schnappschussOrdner$(s), "v_kaputt.pxs"), "x")
WRITEALL(PATHJOIN(kern.schnappschussOrdner$(s), "v_2026-02-30_10-00-00.pxs"), "x")
PRINT "fremde dateien zaehlen nicht: "; LEN(kern.schnappschuesse(s)); " | "; kern.schnappschussZeit("v_kaputt.pxs"); " "; kern.schnappschussZeit("v_2026-02-30_10-00-00.pxs")
DIM g AS kern.Muster : g = kern.pxsLaden(alle[0])
PRINT "gelesen: "; g.breite; "x"; g.hoehe; " "; g.farbanzahl(); " farben"
PRINT "unbekannt: "; LEN(kern.schnappschuesse("gibt es nicht"))
