=== dim in einer schleife beginnt wieder bei der untergrenze
SUB runde(k AS INTEGER)
    DIM z[k TO k + 1] AS INTEGER
    PRINT LBOUND(z), UBOUND(z), z[k]
    z[k] = 99
END SUB
DIM i AS INTEGER
FOR i = 1 TO 3
    DIM w[i TO 5] AS STRING
    PRINT LBOUND(w), LEN(w), "["; w[i]; "]"
    w[i] = "x"
    runde(i * 10)
NEXT
--- umgebung
DHRT_JIT=aus
--- erwartet
1 5 []
10 11 0
2 4 []
20 21 0
3 3 []
30 31 0

