=== skin setzen und wieder wegnehmen
IMPORT "gui"
SCREEN(200, 120, "S")
DIM b AS IMAGE
b = GENTEX_COLOR(32, 32, 16750848)
GUI_SKIN("button", b, 8)
GUI_SKIN("button", -1)
PRINT "ok"
--- erwartet
ok

=== skin meldet unbekannte widget art
IMPORT "gui"
SCREEN(200, 120, "S")
DIM b AS IMAGE
b = GENTEX_COLOR(32, 32, 16750848)
TRY
    GUI_SKIN("knopfdruck", b, 8)
CATCH e
    PRINT e
END TRY
--- erwartet
GUI_SKIN: unbekannte Widget-Art 'knopfdruck'

=== skin ueberlebt winzige widgets
' Ein Widget kleiner als seine Skin-Raender darf zusammenschrumpfen,
IMPORT "gui"
SCREEN(200, 120, "S")
DIM w AS GUI_WINDOW
DIM b AS IMAGE
DIM f AS INTEGER
b = GENTEX_COLOR(48, 48, 16750848)
w = GUI_WINDOW("W", 5, 5, 180, 100)
GUI_BUTTON(w, "x", 5, 5, 6, 4)
GUI_SKIN("button", b, 20)
FOR f = 1 TO 2
    GUI_UPDATE()
    GUI_DRAW()
    FLIP()
NEXT
PRINT "ok"
--- erwartet
ok

