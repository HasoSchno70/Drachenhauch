' Schleifen und Verzweigungen
DIM i AS INTEGER

PRINT "FOR-Schleife 1 bis 5:"
FOR i = 1 TO 5
    PRINT "  i =", i
NEXT i

PRINT ""
PRINT "FOR mit STEP 2:"
FOR i = 0 TO 10 STEP 2
    PRINT "  ", i
NEXT

PRINT ""
PRINT "Rueckwaerts mit STEP -1:"
FOR i = 5 TO 1 STEP -1
    PRINT "  ", i
NEXT

PRINT ""
PRINT "WHILE-Schleife (Quadrate < 100):"
DIM n AS INTEGER
n = 1
WHILE n * n < 100
    PRINT "  ", n, "^2 =", n * n
    n = n + 1
WEND

PRINT ""
PRINT "IF / ELSEIF / ELSE:"
DIM punkte AS INTEGER
punkte = 75
IF punkte >= 90 THEN
    PRINT "Note: 1"
ELSEIF punkte >= 75 THEN
    PRINT "Note: 2"
ELSEIF punkte >= 60 THEN
    PRINT "Note: 3"
ELSE
    PRINT "Durchgefallen"
END IF

REM Single-Line-IF
IF punkte > 50 THEN PRINT "Bestanden" ELSE PRINT "Nicht bestanden"
