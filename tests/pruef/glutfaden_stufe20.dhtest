=== probe: leeren, notiz, f1, ansicht, pfeile, rollbalken, ablegen
IMPORT "helfer.dh"
' --probe-stufe20 mit alle.pxs: Ebene leeren, Notiz, F1, die Ansichtsschalter
' gegen das Bild der Leinwand, Spiegelachsen, Pfeile, Rollbalken, Ablegen.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
' ein Name mit Leerzeichen (im Ablegen als %20) -- als Beilage geht er nicht
COPYFILE("farbe.pxs", "mit leer.pxs")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe20", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["notiz", "f1", "achsen"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    PRINT "datei unveraendert: "; READLINES("alle.pxs")[0] = READLINES("vorher.pxs")[0]
END IF
