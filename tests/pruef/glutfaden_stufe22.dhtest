=== probe: textur, kante, ziehen, hervorheben, stickzeit, ordner, neu
IMPORT "helfer.dh"
' --probe-stufe22 mit alle.pxs: Aida-Punkt, laufende Kante, Ziehen (Quellen,
' Ziele, Garn, Ebenen samt Rueckgaengig und gesperrt), Hervorheben,
' Stickzeit, Ordner, Neu in Glutfaden, Einstellungsdialog.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe22", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT REPLACE$(dlAus, CHR$(13), "");
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    PRINT "neu "; FILEEXISTS("d_neu.png")
    PRINT "datei unveraendert: "; READLINES("alle.pxs")[0] = READLINES("vorher.pxs")[0]
END IF
