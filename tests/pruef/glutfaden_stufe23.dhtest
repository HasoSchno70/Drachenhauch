' Glutfaden Stufe 23: magnetisches Raster (Linie, Rechteck, Ellipse und
' Vieleck rasten ein, kern.einrasten, Knopf mit Magnet), Pinsel nach
' Stiftdruck (kern.pinselZellen, lwDruckLesen) und Pinch-Zoom (GtkGestureZoom,
' kern.pinchSchritt).
'
' Der erste Fall ist gegen PySticky aufgezeichnet: CoordinatesMixin.
' snap_position, PencilTool._brush_cells und TabletGestureMixin.
' _handle_gesture, mit Stellvertretern fuer Leinwand, Werkzeug und Geste
' aufgerufen -- PySticky rundet mit Pythons round (bei .5 zur geraden Zahl).
' Stiftdruck und Geste lassen sich ohne Geraet nicht ausloesen; die Probe
' setzt den Zustand, den ein Stift hinterlaesst, und prueft, dass ein
' Maus-Ereignis keinen Druck liefert.

=== einrasten, pinsel und pinch wie pysticky
IMPORT "helfer.dh"
FUNCTION kurz$(t AS STRING) AS STRING
    RETURN LEFT$(LOWER$(MD5$(t)), 12)
END FUNCTION

DIM st AS ARRAY OF INTEGER : st = [5, 14, 8, 2, 30, 30, 4, 30, 30, 1, 9, 9, 7, 40, 20, 10, 23, 17]
DIM pk AS ARRAY OF INTEGER : pk = [0, 0, 1, 1, 2, 3, 3, 4, 5, 5, 6, 7, 9, 9, 12, 7, 13, 7, 15, 2, 22, 16, -3, 4, 40, 40]
DIM i AS INTEGER, k AS INTEGER, sx AS INTEGER, sy AS INTEGER
FOR i = 0 TO LEN(st) - 3 STEP 3
    DIM teile AS ARRAY OF STRING : teile = []
    FOR k = 0 TO LEN(pk) - 2 STEP 2
        (sx, sy) = kern.einrasten(pk[k], pk[k + 1], st[i], st[i + 1], st[i + 2])
        ARRAY_PUSH(teile, STR$(pk[k]) + "," + STR$(pk[k + 1]) + "->" + STR$(sx) + "," + STR$(sy))
    NEXT
    PRINT "einrasten "; st[i]; " in "; st[i + 1]; "x"; st[i + 2]; ": "; JOIN$(teile, " ")
NEXT
DIM g AS INTEGER, d AS STRING
FOR EACH g IN [1, 2, 5, 8, 20]
    FOR EACH d IN ["0.0", "0.1", "0.125", "0.25", "0.375", "0.5", "0.75", "1.0"]
        DIM z AS ARRAY OF INTEGER : z = kern.pinselZellen(10, 10, VAL(d), g)
        DIM s AS ARRAY OF STRING : s = []
        FOR k = 0 TO LEN(z) - 2 STEP 2
            ARRAY_PUSH(s, STR$(z[k]) + "," + STR$(z[k + 1]))
        NEXT
        PRINT "pinsel "; g; " druck "; d; ": "; LEN(s); " "; kurz$(JOIN$(s, ";"))
    NEXT
NEXT
DIM folgen AS ARRAY OF STRING : folgen = ["1.1 1.2 1.3 1.4 1.2 1.15 0.9", "1.15 1.16 1.33 1.34", "0.87 0.86 0.75 0.74", "2.0 4.0 1.0 0.5", "1.0 1.0001 0.99"]
DIM f AS STRING
FOR EACH f IN folgen
    DIM letzte AS FLOAT : letzte = 1.0
    DIM aus AS STRING : aus = ""
    DIM w AS STRING
    FOR EACH w IN SPLIT$(f, " ")
        DIM sch AS INTEGER : sch = kern.pinchSchritt(VAL(w), letzte)
        aus = aus + IIF(sch > 0, "+", IIF(sch < 0, "-", "0"))
        IF sch <> 0 THEN letzte = VAL(w)
    NEXT
    PRINT "pinch "; f; ": "; aus
NEXT
