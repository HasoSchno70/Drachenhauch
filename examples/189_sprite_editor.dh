DIM palette AS GUI_WIDGET
palette = GUI_CANVAS(win, 12, y, LINKS - 24, 72)
y = y + 84

lbl = GUI_LABEL(win, "Pinsel", 12, y)
DIM spPinsel AS GUI_WIDGET : spPinsel = GUI_SPINNER(win, 90, y - 4, 120, 1, 6, 1)

DIM pal AS ARRAY OF INTEGER
pal = [&H000000, &HFFFFFF, &HE84B4B, &HE8C44B, &H4BE87A, &H2BC4E8, _
       &HB44BE8, &HE87ABF, &H8C6239, &H5A6472, &HF0A868, &H3C8C5A, _
       &H2E4A78, &HC8C8C8, &H6E2B2B, &H1E2430]

' --------------------------------------------------------- rechts: Bilder
