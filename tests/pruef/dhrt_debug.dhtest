=== ein nicht abgefangener fehler haelt an seiner stelle an
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("d.dh", ["{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "eval" + q + "," + q + "expr" + q + ":" + q + "i * 10" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}"])
DIM i AS INTEGER
FOR i = 0 TO LEN(ereignisse) - 1
    IF art$(i) = "paused" THEN PRINT "halt "; feld$(i, "line"); " ["; feld$(i, "reason"); "] "; paar$(i, "locals", "i"); " "; feld$(i, "stack.0.name")
    IF art$(i) = "eval-result" THEN PRINT "wert "; feld$(i, "value")
    IF art$(i) = "error" THEN PRINT "fehler "; feld$(i, "line")
NEXT
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
' Ein Fehler, der abgefangen wird, haelt NICHT an.
TRY
    THROW "harmlos"
CATCH e
    PRINT "gefangen"
END TRY
SUB fuellen()
    DIM f[3] AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO 5
        f[i] = i
    NEXT
END SUB
fuellen()

--- erwartet
halt 2 []  __main__
halt 11 [error] 3 fuellen
wert 30
fehler 11

=== ein grafikfenster bleibt im halt ansprechbar
' Waehrend der Debugger auf Kommandos wartet, holt er alle 50 ms die
' Fensternachrichten ab -- sonst meldete Windows das Fenster nach wenigen
' Sekunden als "reagiert nicht" (vorher gemessen: Responding False).
DIM q AS STRING : q = CHR$(34)
DIM p AS INTEGER : p = PROCESS_START("dhrt", "debug", CWD$() + "/fenster.dh")
PROCESS_WRITE(p, "{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "lines" + q + ":[4]}" + CHR$(10))
PROCESS_WRITE(p, "{" + q + "cmd" + q + ":" + q + "continue" + q + "}" + CHR$(10))
SLEEP(7000)
DIM ps AS STRING : ps = "Get-Process dhrt | Where-Object { $_.MainWindowTitle -eq 'Halt-Pruefung' } | ForEach-Object { $_.Responding }"
DIM antwort AS STRING : antwort = TRIM$(SHELL_OUT$("powershell", "-NoProfile", "-Command", ps))
PROCESS_WRITE(p, "{" + q + "cmd" + q + ":" + q + "stop" + q + "}" + CHR$(10))
SLEEP(300)
IF PROCESS_RUNNING(p) THEN PROCESS_KILL(p)
IF antwort = "" THEN
    PRINT "UEBERSPRINGEN: kein Fenster gefunden"
ELSE
    PRINT "ansprechbar "; antwort
END IF
--- datei fenster.dh
SCREEN(320, 200, "Halt-Pruefung")
DIM n AS INTEGER
WHILE NOT QUITREQUESTED()
    n = n + 1
    CLS(RGB(20, 40, 80))
    FLIP()
WEND
--- system windows
--- erwartet
ansprechbar True
