=== ein feld ohne groesse ist leer statt nil
DIM a AS ARRAY OF INTEGER
PRINT LEN(a)
ARRAY_PUSH(a, 7)
PRINT a[0]; LEN(a)
SUB s()
    DIM b AS ARRAY OF STRING
    ARRAY_PUSH(b, "x")
    PRINT LEN(b)
END SUB
s()
s()
CLASS K
    DIM teile AS ARRAY OF STRING
END CLASS
DIM k AS K
k = NEW K()
ARRAY_PUSH(k.teile, "y")
PRINT LEN(k.teile)
--- erwartet
0
71
1
1
1

