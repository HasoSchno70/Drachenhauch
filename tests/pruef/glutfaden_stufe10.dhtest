--- erwartet
schluessel: author copyright notes started_date
setzen: TRUE nochmal: FALSE | 'Anna'
notizen: aus dem pdf
eigene notizen: TRUE eigene
leer: TRUE FALSE nochmal leer: FALSE
zahl: '7'
stoff: Aida 16
  2.5 mm Square
  2.8 mm Round
  3.0 mm Round
  12.5 (Drill-Pitch)
cm: 25.40 15.88

=== probe: eigenschaften, groesse, versionen, stickzeit, vorlagen, neues muster
IMPORT "helfer.dh"
' --probe-stufe10 mit dem Probemuster und einem eigenen Einstellungsordner
' (APPDATA/HOME): Eigenschaften samt falschem Datum, Groesse aendern mit
' Rueckgaengig, Smart-Resize, Versionen (faellig, anlegen, waehlen,
' vergleichen, loeschen, wiederherstellen), Stickzeit ueber das Werkzeug,
' eigene Vorlagen, Neues Muster aus Vorlage, DP-Groesse und eigenen Werten.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe10", "--foto", "d", "probe.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["eigenschaften", "groesse", "versionen", "vergleich", "neu"]
        PRINT f; " "; FILEEXISTS("d_" + f + ".png")
    NEXT
    PRINT "versionen: "; LEN(DIRLIST("app/Glutfaden/snapshots/probe", "v_*.pxs"))
    PRINT "vorlagen: "; REPLACE$(geLies$("app/Glutfaden/user_templates.json"), CHR$(10), " ")
END IF
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_verwalten.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
--- datei probe.pxs
