CONST LOGO = "daten/bilder/glutfaden_256.png"
CONST LOGO_KLEIN = "daten/bilder/glutfaden_32.png"

DIM fenster AS INTEGER
DIM kopf AS INTEGER
DIM zoomText AS INTEGER
DIM status AS INTEGER
DIM kZurueck AS INTEGER
DIM kVor AS INTEGER
DIM kSichern AS INTEGER
DIM kModus AS INTEGER
DIM musterPfad AS STRING
DIM musterTitel AS STRING
DIM extraGeaendert AS BOOLEAN         ' Sichtbarkeit, Sperre, Deckkraft (kein Schritt)
DIM meldung AS STRING
DIM meldungZeit AS INTEGER
DIM schliessenErlaubt AS BOOLEAN

' --- Was andere Teile rufen ---------------------------------------------------------

' Statuszeile und Zoom nachfuehren -- die Zeichenflaeche und die Werkzeuge rufen das.
SUB statusNachziehen()
    IF zoomText = 0 THEN RETURN
    gtk_label_set_text(zoomText, STR$(leinwandZoomProzent()) + " %")
    IF NOT lwHat THEN RETURN
    DIM t AS STRING
    IF meldung <> "" AND MILLIS() - meldungZeit < einst.meldungSekunden * 1000 THEN t = meldung + "   ·   "
    t = t + wzKurzname$(wzAktiv) + ", " + wzStichartName$(wzStichart)
    IF wzSpiegel > 0 THEN t = t + ", " + spiegelName$(wzSpiegel)
    IF NOT (mrAuswahl IS NIL) THEN t = t + ", Auswahl " + STR$(mrAuswahl.anzahl)
    IF wzFarbe >= 0 AND wzFarbe < lwMuster.farbanzahl() THEN
        DIM gf AS kern.Garn : gf = lwMuster.farben[wzFarbe].garn
        t = t + ", " + TRIM$(gf.hersteller + " " + gf.nummer)
    END IF
    t = t + " auf „" + lwMuster.ebenen.aktiveEbene().name + "“   ·   "
    t = t + STR$(lwMuster.breite) + " × " + STR$(lwMuster.hoehe) + " Stiche, " + _
        ZAHL$(lwMuster.breiteCm(), 1) + " × " + ZAHL$(lwMuster.hoeheCm(), 1) + " cm auf " + ZAHL$(lwMuster.stoff, 0) + "er Stoff"
    IF lwMausX >= 0 THEN
        t = t + "   ·   Stich " + STR$(lwMausX + 1) + ", " + STR$(lwMausY + 1)
        DIM c AS INTEGER : c = lwFarbe[lwMausY * lwMuster.breite + lwMausX]
        IF einst.pipetteInfo AND c >= 0 AND c < lwMuster.farbanzahl() THEN
            DIM g AS kern.Garn : g = lwMuster.farben[c].garn
            t = t + ": " + TRIM$(g.hersteller + " " + g.nummer) + " " + g.name
        END IF
    END IF
    gtk_label_set_text(status, t)
END SUB

FUNCTION wzKurzname$(nr AS INTEGER) AS STRING
    DIM n AS STRING : n = wzName$(nr)
    DIM p AS INTEGER : p = INSTR(n, " (")
    IF p >= 0 THEN n = LEFT$(n, p)
    IF wzKannGefuellt(nr) AND wzGefuellt THEN n = n + " gefüllt"
    RETURN n
END FUNCTION

' Eine Meldung, die ein paar Sekunden vorne in der Statuszeile steht.
SUB statusMeldung(text AS STRING)
    meldung = text
    meldungZeit = MILLIS()
    statusNachziehen()
END SUB

FUNCTION istGeaendert() AS BOOLEAN
    RETURN wzVerlauf.geaendert() OR extraGeaendert
END FUNCTION

' Titel (mit • fuer Ungesichertes) und die Knoepfe Zurueck/Vor.
SUB zustandNachziehen()
    IF kopf = 0 OR NOT lwHat THEN RETURN
    gtk_header_bar_set_title(kopf, musterTitel + IIF(istGeaendert(), " •", ""))
    gtk_header_bar_set_subtitle(kopf, BASENAME(musterPfad) + "  ·  " + STR$(lwMuster.farbanzahl()) + " Farben  ·  " + ZAHL$(lwMuster.sticheGesamt(), 0) + " Stiche")
    gtk_widget_set_sensitive(kZurueck, wzVerlauf.kannZurueck())
    gtk_widget_set_sensitive(kVor, wzVerlauf.kannVor())
    gtk_widget_set_tooltip_text(kZurueck, IIF(wzVerlauf.kannZurueck(), "Rückgängig: " + wzVerlauf.textZurueck$() + kuerzelHinweis$("zurueck"), "Nichts zurückzunehmen"))
    gtk_widget_set_tooltip_text(kVor, IIF(wzVerlauf.kannVor(), "Wiederholen: " + wzVerlauf.textVor$() + kuerzelHinweis$("vor"), "Nichts zu wiederholen"))
END SUB

SUB extraAenderung()
    extraGeaendert = TRUE
    zustandNachziehen()
END SUB

' Nach einem Strich oder einer Form: Zahlen, Titel, Status.
SUB nachAenderung()
    seitenleisteZahlen()
    zustandNachziehen()
    statusNachziehen()
END SUB

' Nach Rueckgaengig und Umbauten: Bild und Seitenleiste ganz neu.
SUB allesNeu()
    IF wzFarbe >= lwMuster.farbanzahl() THEN wzFarbe = -1
    leinwandAufbauen()
    seitenleisteMuster(lwMuster)
    gtk_widget_queue_draw(lwFlaeche)
    IF wzFarbeLeiste <> 0 THEN gtk_widget_queue_draw(wzFarbeLeiste)
    zustandNachziehen()
    statusNachziehen()
END SUB

' Ein Text vom Benutzer; "" bei Abbrechen.
FUNCTION textFragen(titel AS STRING, frage AS STRING, vorgabe AS STRING) AS STRING
    DIM d AS INTEGER : d = gtk_dialog_new_with_buttons(titel, fenster, GTK_DIALOG_MODAL BOR GTK_DIALOG_EIGENE_LEISTE, _
        "Abbrechen", GTK_ANTWORT_ABBRECHEN, "OK", GTK_ANTWORT_OK, 0)
    gtk_dialog_set_default_response(d, GTK_ANTWORT_OK)
    DIM innen AS INTEGER : innen = gtk_dialog_get_content_area(d)
    gtk_container_set_border_width(innen, 12)
    DIM l AS INTEGER : l = gtk_label_new(frage)
    gtk_label_set_xalign(l, 0.0)
    DIM feld AS INTEGER : feld = gtk_entry_new()
    gtk_entry_set_text(feld, vorgabe)
    gtk_entry_set_activates_default(feld, TRUE)
    gtk_box_pack_start(innen, l, FALSE, FALSE, 4)
    gtk_box_pack_start(innen, feld, FALSE, FALSE, 4)
    gtk_widget_show_all(d)
    DIM ergebnis AS STRING
    IF gtk_dialog_run(d) = GTK_ANTWORT_OK THEN ergebnis = TRIM$(gtk_entry_get_text(feld))
    gtk_widget_destroy(d)
    RETURN ergebnis
END FUNCTION

' --- Oeffnen und sichern -------------------------------------------------------------

' Ein Muster als das aktuelle zeigen (Oeffnen, Neu, eine Version). Eine
' laufende Stickzeit gehoert dem alten Muster und endet mit ihm.
SUB musterZeigen(m AS kern.Muster, pfad AS STRING, titel AS STRING)
    stickzeitBeenden(FALSE)
    musterPfad = pfad
    musterTitel = titel
    wzVerlauf.leeren()
    extraGeaendert = FALSE
    wzFarbe = IIF(m.farbanzahl() > 0, 0, -1)
    leinwandMuster(m)
    seitenleisteMuster(m)
    modusKnopfNachziehen()
    vwNeuesMuster()
    zustandNachziehen()
    statusNachziehen()
END SUB

FUNCTION musterOeffnen(pfad AS STRING) AS BOOLEAN
    DIM m AS kern.Muster
    DIM fremdHinweis AS STRING
    DIM endung AS STRING : endung = LOWER$(RIGHT$(pfad, 4))
    DIM fremd AS BOOLEAN : fremd = endung = ".oxs" OR endung = ".pat" OR endung = ".xsd"
    TRY
        ' ein fremdes Format: eingelesen, gesichert wird als .pxs
        DIM warnungen AS ARRAY OF STRING : warnungen = []
        IF endung = ".oxs" THEN
            DIM imp AS kern.OxsImport : imp = kern.oxsLaden(pfad, slPaletten, slSymbole)
            m = imp.muster
            warnungen = imp.warnungen
            fremdHinweis = "Aus OXS eingelesen -- Sichern legt eine .pxs an."
        ELSEIF endung = ".pat" THEN
            DIM pimp AS kern.PatImport : pimp = kern.patLaden(pfad, slPaletten, slSymbole)
            m = pimp.muster
            warnungen = pimp.warnungen
            fremdHinweis = "Aus PCStitch eingelesen -- Sichern legt eine .pxs an."
        ELSEIF endung = ".xsd" THEN
            DIM ximp AS kern.XsdImport : ximp = kern.xsdLaden(pfad, slPaletten, slSymbole)
            m = ximp.muster
            warnungen = ximp.warnungen
            fremdHinweis = "Aus Pattern Maker eingelesen -- Sichern legt eine .pxs an."
        ELSE
            m = kern.pxsLaden(pfad)
        END IF
        IF LEN(warnungen) > 0 THEN fremdHinweis = fremdHinweis + " " + JOIN$(warnungen, " ")
    CATCH e
        statusMeldung("Nicht geöffnet: " + e)
        RETURN FALSE
    END TRY
    musterZeigen(m, IIF(fremd, "", pfad), IIF(m.name <> "", m.name, BASENAME(pfad)))
    IF fremdHinweis <> "" THEN statusMeldung(fremdHinweis)
    zuletztMerken(pfad)
    ' liegt ein neuerer automatisch gesicherter Stand daneben?
    IF NOT fremd THEN asNebenDatei(pfad)
    RETURN TRUE
END FUNCTION

FUNCTION musterSichern(pfad AS STRING) AS BOOLEAN
    ' ein Schnappschuss nur beim Sichern in die schon bekannte Datei, nicht
    ' bei "Sichern unter" (wie PySticky)
    DIM schonDa AS BOOLEAN : schonDa = pfad <> "" AND pfad = musterPfad
    IF pfad = "" THEN pfad = dateiWaehlen(TRUE)
    IF pfad = "" THEN RETURN FALSE
    TRY
        ' Einstellungen -> Allgemein: die alte Fassung als .bak daneben
        IF einst.sicherungskopie AND FILEEXISTS(pfad) THEN COPYFILE(pfad, pfad + ".bak")
        kern.pxsSpeichern(lwMuster, pfad)
    CATCH e
        statusMeldung("Nicht gesichert: " + e)
        RETURN FALSE
    END TRY
    musterPfad = pfad
    wzVerlauf.alsGesichert()
    extraGeaendert = FALSE
    zustandNachziehen()
    statusMeldung("Gesichert: " + BASENAME(pfad))
    IF schonDa THEN vwSchnappschussWennFaellig()
    autosicherungWeg(pfad)
    zuletztMerken(pfad)
    RETURN TRUE
END FUNCTION

' Einen Pfad waehlen; "" bei Abbrechen.
FUNCTION dateiWaehlen(sichern AS BOOLEAN) AS STRING
    DIM d AS INTEGER
    IF sichern THEN
        d = gtk_file_chooser_dialog_new("Muster sichern unter", fenster, GTK_DATEI_SICHERN, _
            "Abbrechen", GTK_ANTWORT_ABBRECHEN, "Sichern", GTK_ANTWORT_ANNEHMEN, 0)
        gtk_file_chooser_set_do_overwrite_confirmation(d, einst.ueberschreibenFragen)
        DIM ok AS BOOLEAN
        IF musterPfad = "" THEN
            ' frisch importiert: neben das Quellbild, unter seinem Namen;
            ' sonst in den Ordner aus den Einstellungen
            gtk_file_chooser_set_current_name(d, musterTitel + ".pxs")
            IF einstOrdner$() <> "" THEN ok = gtk_file_chooser_set_current_folder(d, einstOrdner$())
            IF lwHat THEN
                IF lwMuster.quellBild <> "" THEN ok = gtk_file_chooser_set_current_folder(d, DIRNAME(lwMuster.quellBild))
            END IF
        ELSE
            gtk_file_chooser_set_current_name(d, BASENAME(musterPfad))
            ok = gtk_file_chooser_set_current_folder(d, DIRNAME(musterPfad))
        END IF
    ELSE
        d = gtk_file_chooser_dialog_new("Muster öffnen", fenster, GTK_DATEI_OEFFNEN, _
            "Abbrechen", GTK_ANTWORT_ABBRECHEN, "Öffnen", GTK_ANTWORT_ANNEHMEN, 0)
        DIM ok2 AS BOOLEAN
        IF einstOrdner$() <> "" THEN ok2 = gtk_file_chooser_set_current_folder(d, einstOrdner$())
    END IF
    DIM filter AS INTEGER : filter = gtk_file_filter_new()
    gtk_file_filter_set_name(filter, IIF(sichern, "Kreuzstich-Muster (*.pxs)", "Kreuzstich-Muster (*.pxs, *.oxs, *.pat, *.xsd)"))
    gtk_file_filter_add_pattern(filter, "*.pxs")
    IF NOT sichern THEN
        gtk_file_filter_add_pattern(filter, "*.oxs")
        gtk_file_filter_add_pattern(filter, "*.pat")
        gtk_file_filter_add_pattern(filter, "*.xsd")
    END IF
    gtk_file_chooser_add_filter(d, filter)
    DIM pfad AS STRING
    IF gtk_dialog_run(d) = GTK_ANTWORT_ANNEHMEN THEN
        DIM z AS INTEGER : z = gtk_file_chooser_get_filename(d)
        pfad = TEXT_AUS_ZEIGER$(z)
        g_free(z)
    END IF
    gtk_widget_destroy(d)
    IF sichern AND pfad <> "" AND LOWER$(RIGHT$(pfad, 4)) <> ".pxs" THEN pfad = pfad + ".pxs"
    RETURN pfad
END FUNCTION

' Ungesichertes? Sichern, Verwerfen oder Abbrechen. TRUE = weitermachen.
FUNCTION ungesichertFragen(was AS STRING) AS BOOLEAN
    IF NOT istGeaendert() THEN RETURN TRUE
    DIM d AS INTEGER : d = gtk_message_dialog_new(fenster, GTK_DIALOG_MODAL, GTK_NACHRICHT_FRAGE, GTK_KNOEPFE_KEINE, _
        "%s", "„" + musterTitel + "“ hat ungesicherte Änderungen.")
    gtk_message_dialog_format_secondary_text(d, "%s", "Vor dem " + was + " sichern?")
    DIM k AS INTEGER
    k = gtk_dialog_add_button(d, "Verwerfen", 2)
    k = gtk_dialog_add_button(d, "Abbrechen", GTK_ANTWORT_ABBRECHEN)
    k = gtk_dialog_add_button(d, "Sichern", 1)
    gtk_dialog_set_default_response(d, 1)
    DIM a AS INTEGER : a = gtk_dialog_run(d)
    gtk_widget_destroy(d)
    IF a = 1 THEN RETURN musterSichern(musterPfad)
    RETURN a = 2
END FUNCTION

SUB oeffnenGeklickt(knopf AS INTEGER, daten AS INTEGER)
    IF NOT ungesichertFragen("Öffnen") THEN RETURN
    DIM pfad AS STRING : pfad = dateiWaehlen(FALSE)
    IF pfad <> "" THEN
        DIM ok AS BOOLEAN : ok = musterOeffnen(pfad)
    END IF
END SUB

SUB sichernGeklickt(knopf AS INTEGER, daten AS INTEGER)
    IF lwHat THEN
        DIM ok AS BOOLEAN : ok = musterSichern(musterPfad)
    END IF
END SUB

SUB exportGeklickt(knopf AS INTEGER, daten AS INTEGER) : exportDialog() : END SUB
SUB vorschauGeklickt(k AS INTEGER, daten AS INTEGER)
    vorschauDialog()
END SUB

SUB pfadGeklickt(knopf AS INTEGER, daten AS INTEGER) : stickpfadDialog() : END SUB

' Kreuzstich <-> Diamond Painting (Strg+D, PySticky "Diamond-Painting-Ansicht").
' Wie dort ist der Wechsel kein Schritt im Verlauf -- der Verlauf wird geleert,
' weil er die alten Stichtypen haelt; Strg+D noch einmal holt die Garne genau
' zurueck (der gemerkte Stand in mode_backups).
SUB modusUmschalten()
    IF NOT lwHat THEN RETURN
    DIM ziel AS STRING : ziel = IIF(lwMuster.modus = "diamond", "stitch", "diamond")
    DIM ok AS BOOLEAN : ok = kern.modusWechseln(lwMuster, ziel, slPaletten)
    wzVerlauf.leeren()
    mrAblage = NIL
    extraGeaendert = TRUE
    allesNeu()
    modusKnopfNachziehen()
    statusMeldung(IIF(ziel = "diamond", "Diamond Painting -- die Farben sind jetzt Drills der Palette DMC Diamond Painting (" + kern.kuerzelVon$(einst, "modus") + " zurück).", "Kreuzstich -- die Garne von vorher sind zurück (" + kern.kuerzelVon$(einst, "modus") + ": wieder Diamond Painting)."))
END SUB

SUB modusGeklickt(knopf AS INTEGER, daten AS INTEGER) : modusUmschalten() : END SUB

SUB modusKnopfNachziehen()
    IF kModus = 0 THEN RETURN
    DIM dp AS BOOLEAN : dp = lwHat
    IF dp THEN dp = lwMuster.modus = "diamond"
    gtk_button_set_label(kModus, IIF(dp, "◆ Diamond", "✕ Kreuzstich"))
END SUB

SUB sichernUnter()
    IF NOT lwHat THEN RETURN
    DIM pfad AS STRING : pfad = dateiWaehlen(TRUE)
    IF pfad <> "" THEN
        DIM ok AS BOOLEAN : ok = musterSichern(pfad)
    END IF
END SUB

SUB zurueckGeklickt(knopf AS INTEGER, daten AS INTEGER) : werkzeugZurueck() : END SUB
SUB vorGeklickt(knopf AS INTEGER, daten AS INTEGER) : werkzeugVor() : END SUB
SUB kleinerGeklickt(knopf AS INTEGER, daten AS INTEGER) : leinwandZoomMitte(1 / kern.zoomFaktor(einst)) : END SUB
SUB groesserGeklickt(knopf AS INTEGER, daten AS INTEGER) : leinwandZoomMitte(kern.zoomFaktor(einst)) : END SUB
SUB einpassenGeklickt(knopf AS INTEGER, daten AS INTEGER) : leinwandEinpassen() : END SUB
' Beim Ende: Werkzeug und Fenstergroesse merken, die eigene automatische
' Sicherung wegraeumen (wer ohne Sichern schliesst, hat sich entschieden).
SUB fensterZu(objekt AS INTEGER, daten AS INTEGER)
    einstellungenBeimEnde()
    autosichernEnde()
    gtk_main_quit()
END SUB

' Das Kreuz: bei Ungesichertem erst fragen. TRUE haelt das Fenster offen.
FUNCTION schliessenAngefragt(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    IF schliessenErlaubt THEN RETURN FALSE
    ' Einstellungen -> Allgemein -> "Vor Beenden bestätigen" (nur, wenn nicht
    ' ohnehin nach Ungesichertem gefragt wird)
    IF einst.beendenFragen AND NOT istGeaendert() THEN
        IF NOT pdFrage(fenster, "Beenden", "Glutfaden beenden?") THEN RETURN TRUE
    END IF
    fensterMessen()
    stickzeitBeenden(FALSE)
    RETURN NOT ungesichertFragen("Schließen")
END FUNCTION

SUB ueberGeklickt(knopf AS INTEGER, daten AS INTEGER)
    DIM f AS INTEGER
    DIM bild AS INTEGER : bild = gdk_pixbuf_new_from_file_at_size(PATHJOIN(CWD$(), LOGO), 128, 128, f)
    IF bild = 0 THEN g_error_free(f)
    gtk_show_about_dialog(fenster, "program-name", "Glutfaden", "logo", bild, "version", "Stufe 12", _
        "comments", "Kreuzstich-Muster ansehen und bearbeiten -- eine Portierung von PySticky nach Drachenhauch und GTK 3.", _
        "website", "https://github.com/HasoSchno70/Pysticky", "website-label", "PySticky (das Original)", 0)
END SUB

' Ein Befehl aus der Kuerzel-Tafel (kern/einstellungen.dh kuerzelAktionen) --
' die Tasten selbst stehen in den Einstellungen und lassen sich umlegen.
SUB befehlAusfuehren(kennung AS STRING)
    DIM ok AS BOOLEAN
    SELECT CASE kennung
        CASE "neu" : neuDialog()
        CASE "oeffnen" : oeffnenGeklickt(0, 0)
        CASE "sichern"
            IF lwHat THEN ok = musterSichern(musterPfad)
        CASE "sichern_unter" : sichernUnter()
        CASE "export" : exportDialog()
        CASE "import" : bildImportieren()
        CASE "import_neu" : bildNeuImportieren()
        CASE "zurueck" : werkzeugZurueck()
        CASE "vor" : werkzeugVor()
        CASE "kopieren" : auswahlKopieren()
        CASE "ausschneiden" : auswahlAusschneiden()
        CASE "einfuegen" : einfuegenBeginnen()
        CASE "alles" : auswahlAlles()
        CASE "ersetzen" : farbeErsetzenDialog()
        CASE "modus" : modusUmschalten()
        CASE "blend" : blendDialog()
        CASE "statistik" : statistikDialog()
        CASE "ebene" : ebenenBefehl(0)
        CASE "tauschen" : tauschenDialog()
        CASE "palette" : paletteDialog()
        CASE "bibliothek" : bibliothekDialog()
        CASE "harmonie" : harmonieDialog()
        CASE "stickpfad" : stickpfadDialog()
        CASE "eigenschaften" : eigenschaftenDialog()
        CASE "versionen" : versionenDialog()
        CASE "vorschau" : vorschauDialog()
        CASE "einstellungen" : einstellungenDialog()
        CASE "raster" : rasterDialog()
        CASE "zoom_rein" : leinwandZoomMitte(kern.zoomFaktor(einst))
        CASE "zoom_raus" : leinwandZoomMitte(1 / kern.zoomFaktor(einst))
        CASE "einpassen" : leinwandEinpassen()
        CASE "zoom_100" : leinwandZoomMitte(einst.zelleStandard / lwZelle)
        CASE "wz_stift" : werkzeugWaehlen(WZ_STIFT, FALSE)
        CASE "wz_radierer" : werkzeugWaehlen(WZ_RADIERER, FALSE)
        CASE "wz_fuellen" : werkzeugWaehlen(WZ_FUELLEN, FALSE)
        CASE "wz_pipette" : werkzeugWaehlen(WZ_PIPETTE, FALSE)
        CASE "wz_linie" : werkzeugWaehlen(WZ_LINIE, FALSE)
        CASE "wz_rechteck" : werkzeugWaehlen(WZ_RECHTECK, FALSE)
        CASE "wz_rechteck_voll" : werkzeugWaehlen(WZ_RECHTECK, TRUE)
        CASE "wz_ellipse" : werkzeugWaehlen(WZ_ELLIPSE, FALSE)
        CASE "wz_ellipse_voll" : werkzeugWaehlen(WZ_ELLIPSE, TRUE)
        CASE "wz_hand" : werkzeugWaehlen(WZ_HAND, FALSE)
        CASE "wz_auswahl" : werkzeugWaehlen(WZ_AUSWAHL, FALSE)
        CASE "wz_lasso" : werkzeugWaehlen(WZ_LASSO, FALSE)
        CASE "wz_vieleck" : werkzeugWaehlen(WZ_VIELECK, FALSE)
        CASE "wz_vieleck_voll" : werkzeugWaehlen(WZ_VIELECK, TRUE)
        CASE "wz_text" : werkzeugWaehlen(WZ_TEXT, FALSE)
        CASE "wz_rueckstich" : werkzeugWaehlen(WZ_RUECKSTICH, FALSE)
        CASE "wz_fortschritt" : werkzeugWaehlen(WZ_FORTSCHRITT, FALSE)
    END SELECT
END SUB

FUNCTION taste(w AS INTEGER, ereignis AS INTEGER, daten AS INTEGER) AS BOOLEAN
    DIM t AS INTEGER
    IF NOT gdk_event_get_keyval(ereignis, t) THEN RETURN FALSE
    DIM z AS INTEGER
    DIM ok AS BOOLEAN : ok = gdk_event_get_state(ereignis, z)
    DIM strg AS BOOLEAN : strg = (z BAND GDK_STRG) <> 0
    DIM umschalt AS BOOLEAN : umschalt = (z BAND GDK_UMSCHALT) <> 0
    DIM alt AS BOOLEAN : alt = (z BAND GDK_ALT) <> 0
    DIM k AS STRING : k = kern.kuerzelAusTaste$(t, strg, alt, umschalt)
    ' Im Suchfeld gehoeren Zeichen und Kopieren/Einfuegen/Alles dem Feld
    IF gtk_widget_has_focus(slSuche) THEN
        IF NOT strg AND NOT alt AND (LEN(k) = 1 OR k = "Plus" OR k = "Minus" OR k = "Leertaste") THEN RETURN FALSE
        IF k = "Strg+C" OR k = "Strg+X" OR k = "Strg+V" OR k = "Strg+A" THEN RETURN FALSE
    END IF
    ' Was nur in einem Zustand gilt (Esc, Entf und R/H/V an einer Auswahl,
    ' Pfeile im Fortschritt) geht den umlegbaren Kuerzeln vor
    IF NOT strg AND NOT alt THEN
        IF mehrTaste(t) THEN RETURN TRUE
    END IF
    IF k <> "" AND MAPHAS(einstTafel, k) THEN
        befehlAusfuehren(einstTafel[k])
        RETURN TRUE
    END IF
    RETURN werkzeugTaste(t, strg, alt)
END FUNCTION

FUNCTION knopf(symbol AS STRING, tippText AS STRING) AS INTEGER
    DIM k AS INTEGER : k = gtk_button_new_from_icon_name(symbol, GTK_ICON_KNOPF)
    tipp(k, tippText)
    gtk_widget_set_can_focus(k, FALSE)
    RETURN k
END FUNCTION

