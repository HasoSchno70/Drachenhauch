=== umwandeln beim schreiben in globale
DIM gf AS FLOAT
DIM gi AS INTEGER
SUB setze(a AS INTEGER, b AS FLOAT)
    gf = a
    gi = b
END SUB
setze(3, 4.0)
PRINT gf; " "; TYPEOF(gf); " "; gi; " "; TYPEOF(gi)
TRY
    setze(5, 2.5)
CATCH e
    PRINT LEFT$(e, 35)
END TRY
PRINT gf; " "; gi
