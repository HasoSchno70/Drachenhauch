=== ein klick im popover erreicht sein widget
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 600, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM knopf AS GUI_WIDGET
knopf = GUI_BUTTON(w, "Optionen", 20, 20, 120, 30)
DIM pop AS GUI_WINDOW
pop = GUI_POPOVER(knopf, 200, 120)
DIM kb AS GUI_WIDGET
kb = GUI_CHECKBOX(pop, "Raster", 10, 10)
GUI_POPOVER_SHOW(pop)
AUTOMATION_PLAY("ev.txt")
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 30 THEN PRINT "haken " + STR$(GUI_CHECKED(kb)) + " offen " + STR$(GUI_WINDOW_SHOWN(pop))
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
