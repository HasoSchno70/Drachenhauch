    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
PRINT letzte$("suche ")
--- erwartet
suche 3

=== tab geht vom suchfeld ins ersatzfeld
' Beim Dogfooding gefunden: Tab ging vom Suchfeld erst durch Weiter,
' Zurueck und die drei Schalter. Ohne Ersetzen-Zeile bleibt es beim Rest.
DIM prBild AS INTEGER : prBild = 0
FUNCTION prName$(f AS GUI_WIDGET) AS STRING
    IF f = tfSuche THEN RETURN "suche"
    IF f = tfErsatz THEN RETURN "ersatz"
    IF f = btnSuErsetzen THEN RETURN "ersetzen"
    IF f = btnSuAlle THEN RETURN "alle"
    IF f = btnSuZurueck THEN RETURN "zurueck"
    RETURN "anderes"
END FUNCTION
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 30 THEN
    befehl("ersetzen")
    WRITEALL("prtab.txt", "c 6" + CHR$(10) + "e 0 2 258 0 0" + CHR$(10) + "e 2 1 258 0 0" + CHR$(10) + "e 10 2 258 0 0" + CHR$(10) + "e 12 1 258 0 0" + CHR$(10) + "e 20 2 258 0 0" + CHR$(10) + "e 22 1 258 0 0" + CHR$(10) + CHR$(10))
END IF
IF prBild = 34 THEN protokoll("pr fokus " + prName$(GUI_FOCUSED())) : AUTOMATION_PLAY("prtab.txt")
IF prBild = 40 OR prBild = 50 OR prBild = 60 THEN protokoll("pr fokus " + prName$(GUI_FOCUSED()))
IF prBild = 70 THEN
    sucheSchliessen()
    befehl("suchen")
END IF
IF prBild = 74 THEN AUTOMATION_PLAY("prtab.txt")
IF prBild = 80 THEN protokoll("pr ohne ersetzen " + prName$(GUI_FOCUSED()))
IF prBild = 90 THEN EXIT(0)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
DIM hp AS INTEGER

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " THEN PRINT L[i]
NEXT
--- erwartet
pr fokus suche
pr fokus ersatz
pr fokus ersetzen
pr fokus alle
pr ohne ersetzen zurueck

=== die uebersichtskarte malt nicht ueber die suchleiste
' Beim Dogfooding 2026-09-30 gefunden: die Karte wird nach GUI_DRAW ueber das
' Hauptfenster gemalt und lag damit auch ueber der Suchleiste ("Alle" halb
' verdeckt). Zwei Bilder derselben Leiste, einmal mit, einmal ohne Karte:
' im Streifen der Karte muessen sie gleich sein.
DIM prBild AS INTEGER
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach     trefferNachziehen()
    prBild = prBild + 1
    IF prBild = 5 THEN minimapSetzen(TRUE)
    IF prBild = 10 THEN befehl("ersetzen")
    IF prBild = 30 THEN
        DIM prX AS INTEGER
        DIM prY AS INTEGER
        DIM prX1 AS INTEGER : prX1 = 99999
        DIM prY1 AS INTEGER : prY1 = 99999
        DIM prX2 AS INTEGER : prX2 = -1
        DIM prY2 AS INTEGER : prY2 = -1
        FOR prY = 0 TO SCREENHEIGHT() - 1 STEP 2
            FOR prX = SCREENWIDTH() - 600 TO SCREENWIDTH() - 1 STEP 2
                IF GUI_WINDOW_AT(prX, prY) = winSuche THEN
                    prX1 = MIN(prX1, prX) : prY1 = MIN(prY1, prY)
                    prX2 = MAX(prX2, prX) : prY2 = MAX(prY2, prY)
                END IF
            NEXT
        NEXT
        ' nur der Streifen, in dem die Karte liegt -- weiter links blinkt die Schreibmarke
        WRITEALL("rect.txt", STR$(MAX(prX1, SCREENWIDTH() - 96)) + " " + STR$(prY1 + 2) + " " + STR$(prX2 - 2) + " " + STR$(prY2 - 2))
    END IF
    IF prBild = 40 THEN SAVESCREENSHOT("mit.png")
    IF prBild = 45 THEN minimapSetzen(FALSE)
    IF prBild = 60 THEN SAVESCREENSHOT("ohne.png")
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=70
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
' eine lange Zeile, damit die Karte etwas zu zeigen hat ...................................
PRINT "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
PRINT "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
PRINT "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
--- nachher
DIM r AS ARRAY OF STRING : r = SPLIT$(READLINES("_programm/rect.txt")[0], " ")
DIM a AS IMAGE : a = LOADIMAGE("_programm/mit.png")
DIM b AS IMAGE : b = LOADIMAGE("_programm/ohne.png")
DIM x AS INTEGER
DIM y AS INTEGER
DIM n AS INTEGER : n = 0
DIM anders AS INTEGER : anders = 0
FOR y = VAL(r[1]) TO VAL(r[3]) STEP 2
    FOR x = VAL(r[0]) TO VAL(r[2]) STEP 2
        n = n + 1
        IF GETPIXEL(a, x, y) <> GETPIXEL(b, x, y) THEN anders = anders + 1
    NEXT
NEXT
PRINT "gemessen " ; n > 100
PRINT "anders " ; anders
--- erwartet
gemessen TRUE
anders 0
