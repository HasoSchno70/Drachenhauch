=== stichtypen drehen und spiegeln
' Die Tabellen von PySticky (core/stitch.py ROTATE_CW_MAP, FLIP_H_MAP, FLIP_V_MAP)
IMPORT "k.dh"
DIM d AS STRING, h AS STRING, v AS STRING
DIM t AS INTEGER
FOR t = 0 TO kern.STICHTYP_MAX
    d = d + STR$(kern.stichGedreht(t)) + " "
    h = h + STR$(kern.stichGespiegeltH(t)) + " "
    v = v + STR$(kern.stichGespiegeltV(t)) + " "
NEXT
PRINT TRIM$(d) : PRINT TRIM$(h) : PRINT TRIM$(v)
PRINT kern.istTeilstich(kern.VOLL); " "; kern.istTeilstich(kern.VIERTEL_OL); " "; LEN(kern.teilstichPunkte(kern.VIERTEL_OL))
--- datei k.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern

--- erwartet
0 2 1 4 6 3 5 7 8 9 10 11
0 2 1 4 3 6 5 7 8 9 10 11
0 2 1 5 6 3 4 7 8 9 10 11
FALSE TRUE 6
