=== probe: vorschau-dialog, zoom und bild-export
IMPORT "helfer.dh"
' --probe-stufe12 mit alle.pxs: der Dialog (Stoff, Pixel auf Aida 11 und
' schwarzem Stoff, Symbol mit Fortschritt), 1:1, Mausrad grob und fein,
' die Grenzen 20 und 300, Regler, Einpassen, der Bild-Export und das
' Diamond Painting. Danach muss das exportierte Bild genau das sein, was
' vbPng mit derselben Einstellung zeichnet.
MKDIR("app")
SETENV("APPDATA", CWD$() + "/app")
SETENV("HOME", CWD$() + "/app")
dlStarten(["run", BEISPIEL, "--", "--probe-stufe12", "--foto", "d", "alle.pxs"])
IF INSTR(dlAus, "GTK nicht gefunden") >= 0 OR INSTR(dlAus, "keinen Bildschirm") >= 0 THEN
    PRINT "UEBERSPRINGEN: kein GTK mit Bildschirm"
ELSE
    PRINT "rueckgabe "; dlCode
    PRINT dlAus;
    IF dlErr <> "" THEN PRINT "stderr: "; dlErr
    DIM f AS STRING
    FOR EACH f IN ["stoff", "pixel", "symbol", "drills"]
        PRINT f; " "; FILEEXISTS("d_vorschau_" + f + ".png")
    NEXT
    DIM s AS Vorschaustil : s = neuerVorschaustil(VB_SYMBOL)
    s.erledigt = TRUE
    DIM ok AS BOOLEAN : ok = vbPng(kern.pxsLaden("alle.pxs"), s, 12, "selbst.png")
    PRINT "export wie vbPng: "; gvAbweichung("selbst.png", "vorschau_export.png")
    DIM ie AS IMAGE : ie = LOADIMAGE("vorschau_export.png")
    PRINT "export "; IMAGE_WIDTH(ie); "x"; IMAGE_HEIGHT(ie)
END IF
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/../../examples/glutfaden/gtk/gtk.dh"
IMPORT "{sammlung}/../../examples/glutfaden/ansicht/vorschaubild.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_qtfarbe.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_vorschau.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
