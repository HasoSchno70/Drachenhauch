' Aus test_modules_chart.py uebertragen (75 Faelle, aufgezeichnet 2026-09-07). Format: docs/werkzeuge.md, dhrt test.

=== chart new liefert handle
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("kuchen", 0, 0, 100, 100)
PRINT CHART_COUNT(c)
--- erwartet
0

=== chart new kennt deutsche und englische arten
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("kuchen", 0, 0, 10, 10)
c = CHART_NEW("pie", 0, 0, 10, 10)
c = CHART_NEW("donut", 0, 0, 10, 10)
c = CHART_NEW("balken", 0, 0, 10, 10)
c = CHART_NEW("bar", 0, 0, 10, 10)
c = CHART_NEW("linie", 0, 0, 10, 10)
c = CHART_NEW("line", 0, 0, 10, 10)
c = CHART_NEW("flaeche", 0, 0, 10, 10)
c = CHART_NEW("area", 0, 0, 10, 10)
c = CHART_NEW("tacho", 0, 0, 10, 10)
c = CHART_NEW("gauge", 0, 0, 10, 10)
PRINT "ok"
--- erwartet
ok

=== chart new meldet unbekannte art
IMPORT "chart"
DIM c AS CHART
TRY
    c = CHART_NEW("torte", 0, 0, 10, 10)
CATCH e
    PRINT e
END TRY
--- erwartet
CHART_NEW: unbekannte Art 'torte' (gueltig: kuchen, balken, linie, tacho)

=== chart add und get
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("kuchen", 0, 0, 100, 100)
CHART_ADD(c, "Holz", 45.0, 100)
CHART_ADD(c, "Stein", 30.0, 200)
PRINT CHART_COUNT(c)
PRINT CHART_GET(c, 0, 1)
--- erwartet
2
30.0

=== chart data aus array
IMPORT "chart"
DIM c AS CHART
DIM s AS INTEGER
DIM v[3] AS FLOAT
c = CHART_NEW("balken", 0, 0, 100, 100)
s = CHART_SERIES(c, "a", 0)
v[0] = 1.5
v[1] = 2.5
v[2] = 3.5
CHART_DATA(c, s, v)
PRINT CHART_COUNT(c)
PRINT CHART_GET(c, s, 2)
--- erwartet
3
3.5

=== chart push mit fenster laesst vorne herausfallen
' Gleitendes Fenster fuer Live-Kurven -- der aelteste Wert faellt raus.
IMPORT "chart"
DIM c AS CHART
DIM i AS INTEGER
c = CHART_NEW("linie", 0, 0, 100, 100)
CHART_SERIES(c, "s", 0)
CHART_SET_NUM(c, "fenster", 3)
FOR i = 0 TO 5
    CHART_PUSH(c, 0, i)
NEXT
PRINT CHART_COUNT(c)
PRINT CHART_GET(c, 0, 0)
--- erwartet
3
3.0

=== chart stat kennzahlen
IMPORT "chart"
DIM c AS CHART
DIM v[4] AS FLOAT
c = CHART_NEW("balken", 0, 0, 100, 100)
CHART_SERIES(c, "s", 0)
v[0] = 2.0
v[1] = 4.0
v[2] = 6.0
v[3] = 8.0
CHART_DATA(c, 0, v)
PRINT CHART_STAT(c, 0, "summe")
PRINT CHART_STAT(c, 0, "mittel")
PRINT CHART_STAT(c, 0, "min")
PRINT CHART_STAT(c, 0, "max")
PRINT CHART_STAT(c, 0, "anzahl")
--- erwartet
20.0
5.0
2.0
8.0
4.0

=== chart value geht ohne series
' Beim Tacho legt CHART_NEW die Reihe schon an.
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("tacho", 0, 0, 100, 100)
CHART_VALUE(c, 42.0)
PRINT CHART_GET(c, 0, 0)
--- erwartet
42.0

=== chart get liefert den echten wert trotz animation
' CHART_GET meldet immer den gesetzten Wert -- die Animation betrifft
IMPORT "chart"
DIM c AS CHART
c = CHART_NEW("tacho", 0, 0, 100, 100)
CHART_SET_NUM(c, "animation", 0.5)
CHART_VALUE(c, 100.0)
CHART_UPDATE(c, 0.016)
PRINT CHART_GET(c, 0, 0)
--- erwartet
100.0

