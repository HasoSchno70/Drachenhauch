' 53_bitwise.dh -- Bitwise-Operatoren in GameBasic.
'
' BAND, BOR, BXOR, SHL, SHR sind binaere Operatoren.
' BNOT ist unaer.
' Alle erwarten strikt INTEGER -- FLOAT oder BOOL wirft TypeMismatchError.

PRINT "=== Flag-Manipulation per BAND/BOR ==="
CONST PERM_READ = 1
CONST PERM_WRITE = 2
CONST PERM_EXEC = 4
CONST PERM_ADMIN = 8

DIM perms AS INTEGER
perms = PERM_READ BOR PERM_WRITE BOR PERM_EXEC

PRINT "Berechtigungs-Maske:        " + HEX$(perms)
PRINT "  hat READ?  ", (perms BAND PERM_READ)  <> 0
PRINT "  hat WRITE? ", (perms BAND PERM_WRITE) <> 0
PRINT "  hat EXEC?  ", (perms BAND PERM_EXEC)  <> 0
PRINT "  hat ADMIN? ", (perms BAND PERM_ADMIN) <> 0

' Flag entfernen: AND mit dem invertierten Bit
perms = perms BAND BNOT PERM_WRITE
PRINT ""
PRINT "Nach Entfernen von WRITE:   " + HEX$(perms)
PRINT "  hat WRITE? ", (perms BAND PERM_WRITE) <> 0

PRINT ""
PRINT "=== Shift-Operationen ==="
PRINT "1 SHL 0  =", 1 SHL 0
PRINT "1 SHL 8  =", 1 SHL 8        ' = 256
PRINT "1 SHL 16 =", 1 SHL 16       ' = 65536
PRINT "256 SHR 4=", 256 SHR 4      ' = 16

PRINT ""
PRINT "=== RGB packen / entpacken ==="
DIM color AS INTEGER
DIM r AS INTEGER
DIM g AS INTEGER
DIM b AS INTEGER
r = 200 : g = 150 : b = 75
color = (r SHL 16) BOR (g SHL 8) BOR b
PRINT "Gepackt:    " + HEX$(color)
PRINT "  R = ", (color SHR 16) BAND 255
PRINT "  G = ", (color SHR 8)  BAND 255
PRINT "  B = ",  color         BAND 255

PRINT ""
PRINT "=== XOR-Toggle ==="
DIM state AS INTEGER
state = 0
state = state BXOR 1
PRINT "Toggle einmal:   ", state
state = state BXOR 1
PRINT "Toggle zweimal:  ", state

PRINT ""
PRINT "=== Praezedenz: + ist hoeher als BAND ==="
' "5 + 3 BAND 6" parst als "(5 + 3) BAND 6" = 8 BAND 6 = 0
PRINT "5 + 3 BAND 6 =", 5 + 3 BAND 6
' Wer C-Stil will, klammert: "5 + (3 BAND 6)" = 5 + 2 = 7
PRINT "5 + (3 BAND 6) =", 5 + (3 BAND 6)
