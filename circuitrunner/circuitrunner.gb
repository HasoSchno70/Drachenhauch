' =====================================================================
'  CIRCUIT RUNNER  --  ein Chip's-Challenge-artiges Kachel-Puzzle
'  Sammle alle Daten-Chips, dann oeffnet der Sockel den Weg zum Ausgang.
'  Weiche Wasser/Feuer/Monstern aus, nutze Schluessel, Stiefel und Bloecke.
'
'  Steuerung:
'    Pfeile / WASD   bewegen
'    R               Level neu starten
'    N               Level ueberspringen (Entwicklung)
'    P               Passwort eingeben (Level anspringen, im Menue/Intro)
'    ESC             zurueck / Menue
'    LEER / ENTER    bestaetigen
'
'  Fortschritt + Bestzeiten werden in  circuitrunner.save  gesichert.
'
'  Level liegen als JSON-Sets in  levels/ . Eigene Demos erzeugt
'  make_demo_levels.py; echte Fansite-Sets (.dat/.ccl) wandelt
'  convert_dat.py um. Tile-Codes 0x00..0x6F = Zellen in assets/tiles.png.
'
'  Start:  gbrun.py circuitrunner\circuitrunner.gb       (oder im Editor F5)
' =====================================================================
IMPORT "json"
IMPORT "input"
IMPORT "audio"
IMPORT "save"

CONST SAVEPATH = "circuitrunner.save"

CONST FULLSCREEN = TRUE

CONST GW = 32
CONST GH = 32
CONST NCELL = 1024
CONST TILE = 64
CONST VIEW = 9                 ' sichtbare Kacheln je Achse
CONST BLOG = 576               ' Board-Render-Target = VIEW*TILE
CONST BX = 0                   ' Board-Ursprung im Render-Target
CONST BY = 0

CONST TICK_MS = 120            ' eine Spielwelt-Stufe (Bewegung)
CONST MON_EVERY = 1            ' Monster ziehen mit Spielertempo (CCLP1/MS-treu); Teeth/Blob via *2 halb

' ----- Tile-Codes (= Tileset-Zellen) ---------------------------------
CONST T_FLOOR = &H00
CONST T_WALL = &H01
CONST T_CHIP = &H02
CONST T_WATER = &H03
CONST T_FIRE = &H04
CONST T_INVWALL = &H05
CONST T_WALLN = &H06
CONST T_WALLW = &H07
CONST T_WALLS = &H08
CONST T_WALLE = &H09
CONST T_BLOCK = &H0A
CONST T_DIRT = &H0B
CONST T_ICE = &H0C
CONST T_FORCE_S = &H0D
CONST T_FORCE_N = &H12
CONST T_FORCE_E = &H13
CONST T_FORCE_W = &H14
CONST T_EXIT = &H15
CONST T_DOOR_BLUE = &H16
CONST T_DOOR_RED = &H17
CONST T_DOOR_GREEN = &H18
CONST T_DOOR_YELLOW = &H19
CONST T_ICE_NW2 = &H1A
CONST T_ICE_NE2 = &H1B
CONST T_ICE_SE2 = &H1C
CONST T_ICE_SW2 = &H1D
CONST T_BLUEBLOCK_F = &H1E
CONST T_BLUEBLOCK_W = &H1F
CONST T_THIEF = &H21
CONST T_SOCKET = &H22
CONST T_BTN_GREEN = &H23
CONST T_BTN_RED = &H24
CONST T_TOGGLE_C = &H25
CONST T_TOGGLE_O = &H26
CONST T_BTN_BROWN = &H27
CONST T_BTN_BLUE = &H28
CONST T_TELEPORT = &H29
CONST T_BOMB = &H2A
CONST T_TRAP = &H2B
CONST T_HIDDEN = &H2C
CONST T_GRAVEL = &H2D
CONST T_PASSONCE = &H2E
CONST T_HINT = &H2F
CONST T_WALL_SE = &H30
CONST T_CLONER = &H31
CONST T_FORCE_RND = &H32
CONST T_KEY_BLUE = &H64
CONST T_KEY_RED = &H65
CONST T_KEY_GREEN = &H66
CONST T_KEY_YELLOW = &H67
CONST T_FLIPPERS = &H68
CONST T_FIREBOOTS = &H69
CONST T_ICESKATES = &H6A
CONST T_SUCTION = &H6B
CONST T_CHIP_N = &H6C

' Richtungen 0=N 1=W 2=S 3=E (= CC-Codierung)
DIM dxv[4] AS INTEGER
DIM dyv[4] AS INTEGER

' ----- Weltzustand ---------------------------------------------------
DIM terr[NCELL] AS INTEGER            ' Terrain/Items/Geraete

CONST MAXMOB = 320
DIM mob_x[MAXMOB] AS INTEGER
DIM mob_y[MAXMOB] AS INTEGER
DIM mob_dir[MAXMOB] AS INTEGER
DIM mob_type[MAXMOB] AS INTEGER
DIM mob_alive[MAXMOB] AS BOOLEAN
DIM mob_trapped[MAXMOB] AS BOOLEAN
DIM mob_ox[MAXMOB] AS INTEGER
DIM mob_oy[MAXMOB] AS INTEGER
DIM nmob AS INTEGER
DIM mob_did AS BOOLEAN          ' Ergebnis des letzten mob_try
' Umsortier-Puffer fuer die MS-Bewegungsreihenfolge (0x0A-Monsterliste)
DIM mord[MAXMOB] AS INTEGER
DIM mplaced[MAXMOB] AS BOOLEAN
DIM tmob_x[MAXMOB] AS INTEGER
DIM tmob_y[MAXMOB] AS INTEGER
DIM tmob_dir[MAXMOB] AS INTEGER
DIM tmob_type[MAXMOB] AS INTEGER

CONST MAXBLK = 320
DIM blk_x[MAXBLK] AS INTEGER
DIM blk_y[MAXBLK] AS INTEGER
DIM blk_alive[MAXBLK] AS BOOLEAN
DIM blk_ox[MAXBLK] AS INTEGER
DIM blk_oy[MAXBLK] AS INTEGER
DIM blk_sdir[MAXBLK] AS INTEGER   ' Rutsch-Richtung (-1 = ruht)
DIM nblk AS INTEGER
DIM pushed_blk AS INTEGER          ' diesen Tick geschobener Block (kein Sofort-Rutsch)

' Geraete-Verdrahtung (Falle/Cloner): bx,by -> tx,ty
CONST MAXWIRE = 256
DIM trap_bx[MAXWIRE] AS INTEGER
DIM trap_by[MAXWIRE] AS INTEGER
DIM trap_tx[MAXWIRE] AS INTEGER
DIM trap_ty[MAXWIRE] AS INTEGER
DIM ntrap AS INTEGER
DIM clone_bx[MAXWIRE] AS INTEGER
DIM clone_by[MAXWIRE] AS INTEGER
DIM clone_mx[MAXWIRE] AS INTEGER
DIM clone_my[MAXWIRE] AS INTEGER
DIM nclone AS INTEGER

' Spieler
DIM px AS INTEGER
DIM py AS INTEGER
DIM pdir AS INTEGER
DIM chips_left AS INTEGER
DIM chips_total AS INTEGER     ' Chips zu Levelbeginn (fuer den HUD-Balken)
DIM keys_blue AS INTEGER
DIM keys_red AS INTEGER
DIM keys_green AS INTEGER
DIM keys_yellow AS INTEGER
DIM has_flippers AS BOOLEAN
DIM has_fireboots AS BOOLEAN
DIM has_iceskates AS BOOLEAN
DIM has_suction AS BOOLEAN
DIM slide_kind AS INTEGER             ' 0 keine, 1 Eis, 2 Force
DIM slide_dir AS INTEGER
DIM on_water AS BOOLEAN                ' fuer Schwimm-Sprite
' Gleit-Animation
DIM pox AS INTEGER
DIM poy AS INTEGER
DIM anim_t AS FLOAT
DIM tick_timer AS FLOAT

' Ablauf
DIM state AS STRING                    ' menu intro play win dead done
DIM cur_level AS INTEGER
DIM nlevels AS INTEGER
DIM lvl_title AS STRING
DIM lvl_hint AS STRING
DIM lvl_time AS INTEGER
DIM death_msg AS STRING
DIM acc AS FLOAT
DIM tickcount AS INTEGER
DIM time_left AS INTEGER
DIM start_ms AS INTEGER

DIM js AS JSON_HANDLE
DIM tiles AS IMAGE
DIM rtb AS INTEGER             ' Board-Render-Target (288x288, scharf hochskaliert)

' Soundeffekte (Kenney Interface Sounds, CC0 -- siehe assets/sfx/CREDITS.txt)
DIM snd_step AS SOUND
DIM snd_chip AS SOUND
DIM snd_door AS SOUND
DIM snd_block AS SOUND
DIM snd_die AS SOUND
DIM snd_win AS SOUND
DIM snd_blocked AS SOUND
DIM snd_ok AS BOOLEAN          ' TRUE wenn die WAVs geladen werden konnten

' Hintergrundmusik (Juhani Junkala, CC0 -- siehe assets/music/CREDITS.txt)
' Menue = title, Spiel = level1..3 (rotieren pro Level), alle geschafft = ending
CONST MUS_TITLE = "assets/music/title.ogg"
CONST MUS_ENDING = "assets/music/ending.ogg"
CONST MUS_VOL = 0.5
DIM music_ok AS BOOLEAN        ' TRUE wenn die OGGs vorhanden sind
DIM music_on AS BOOLEAN        ' Musik an/aus (Taste M)
DIM cur_music AS STRING        ' aktuell laufender Track

' Bildschirm-Layout (native Aufloesung; Text/Icons scharf, Board pixelig)
DIM SW AS INTEGER
DIM SH AS INTEGER
DIM bscale AS INTEGER          ' ganzzahlige Board-Vergroesserung
DIM bsize AS INTEGER           ' BLOG * bscale
DIM board_x AS INTEGER
DIM board_y AS INTEGER
DIM hud_x AS INTEGER
DIM hud_w AS INTEGER

' Font (eine TTF; Groesse via TEXTROT-Scale, da LOADFONT-Groesse fix ist)
DIM gfont AS INTEGER
DIM BASEH AS INTEGER
DIM sc_big AS FLOAT
DIM sc_med AS FLOAT
DIM sc_sm AS FLOAT

' HUD-Icons (vorskaliert, scharf)
DIM ic_sz AS INTEGER          ' HUD-Icon-Groesse (direkt aus dem Tileset via DRAWIMAGEPARTEX)

' Level-Set-Auswahl (alle .json in levels/ + levels/_downloaded/)
CONST MAXSETS = 64
DIM set_path[MAXSETS] AS STRING
DIM set_name[MAXSETS] AS STRING
DIM set_count[MAXSETS] AS INTEGER
DIM nsets AS INTEGER
DIM sel_set AS INTEGER

' Persistenz (Bestzeiten + Fortschritt) und Passwort-Eingabe
DIM sav AS SAVE_HANDLE
DIM cur_setkey AS STRING        ' Save-Key-Praefix des aktiven Sets
DIM lvl_best AS INTEGER         ' Bestzeit (Sek.) des aktuellen Levels, -1 = keine
DIM win_secs AS INTEGER         ' Sekunden fuer den letzten Sieg
DIM new_record AS BOOLEAN
DIM pw_input AS STRING          ' aktuell getipptes Passwort
DIM pw_msg AS STRING            ' Rueckmeldung der Passwort-Eingabe
DIM next_pw AS STRING           ' Passwort des naechsten Levels (im Sieg-Overlay)

' ----------------------------------------------------------------------
'  HELFER
' ----------------------------------------------------------------------
FUNCTION cidx(x AS INTEGER, y AS INTEGER) AS INTEGER
    RETURN y * GW + x
END FUNCTION

FUNCTION inb(x AS INTEGER, y AS INTEGER) AS BOOLEAN
    RETURN x >= 0 AND y >= 0 AND x < GW AND y < GH
END FUNCTION

FUNCTION tat(x AS INTEGER, y AS INTEGER) AS INTEGER
    IF NOT inb(x, y) THEN RETURN T_WALL
    RETURN terr[cidx(x, y)]
END FUNCTION

FUNCTION hexnib(ch AS STRING) AS INTEGER
    DIM a AS INTEGER
    a = ASC(ch)
    IF a >= 48 AND a <= 57 THEN RETURN a - 48
    IF a >= 65 AND a <= 70 THEN RETURN a - 55
    IF a >= 97 AND a <= 102 THEN RETURN a - 87
    RETURN 0
END FUNCTION

FUNCTION turn_left(d AS INTEGER) AS INTEGER
    RETURN (d + 1) MOD 4
END FUNCTION
FUNCTION turn_right(d AS INTEGER) AS INTEGER
    RETURN (d + 3) MOD 4
END FUNCTION
FUNCTION turn_back(d AS INTEGER) AS INTEGER
    RETURN (d + 2) MOD 4
END FUNCTION

FUNCTION mob_at(x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO nmob - 1
        IF mob_alive[i] AND mob_x[i] = x AND mob_y[i] = y THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION block_at(x AS INTEGER, y AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO nblk - 1
        IF blk_alive[i] AND blk_x[i] = x AND blk_y[i] = y THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' Blockiert eine duenne Wand die Bewegung von (x,y) in Richtung d?
FUNCTION edge_blocked(x AS INTEGER, y AS INTEGER, d AS INTEGER) AS BOOLEAN
    DIM here AS INTEGER
    here = tat(x, y)
    DIM nx AS INTEGER
    DIM ny AS INTEGER
    nx = x + dxv[d]
    ny = y + dyv[d]
    DIM there AS INTEGER
    there = tat(nx, ny)
    ' Wand auf der Austritts-Kante der Quelle
    IF d = 0 AND (here = T_WALLN OR there = T_WALLS) THEN RETURN TRUE
    IF d = 2 AND (here = T_WALLS OR there = T_WALLN) THEN RETURN TRUE
    IF d = 1 AND (here = T_WALLW OR there = T_WALLE) THEN RETURN TRUE
    IF d = 3 AND (here = T_WALLE OR there = T_WALLW) THEN RETURN TRUE
    ' Eck-Wand SE (blockiert S und E)
    IF here = T_WALL_SE AND (d = 2 OR d = 3) THEN RETURN TRUE
    IF there = T_WALL_SE AND (d = 0 OR d = 1) THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' Ist das Terrain bei (x,y) fuer ein Monster eine Wand?
FUNCTION mob_solid(mt AS INTEGER, t AS INTEGER) AS BOOLEAN
    IF t = T_WALL OR t = T_INVWALL OR t = T_HIDDEN OR t = T_WALL_SE THEN RETURN TRUE
    IF t = T_WALLN OR t = T_WALLW OR t = T_WALLS OR t = T_WALLE THEN RETURN TRUE
    IF t = T_BLUEBLOCK_W OR t = T_BLUEBLOCK_F THEN RETURN TRUE
    IF t = T_TOGGLE_C THEN RETURN TRUE
    IF t = T_SOCKET OR t = T_EXIT OR t = T_CLONER THEN RETURN TRUE
    IF t = T_DOOR_BLUE OR t = T_DOOR_RED OR t = T_DOOR_GREEN OR t = T_DOOR_YELLOW THEN RETURN TRUE
    IF t = T_CHIP OR t = T_DIRT THEN RETURN TRUE
    IF t = T_KEY_BLUE OR t = T_KEY_RED OR t = T_KEY_GREEN OR t = T_KEY_YELLOW THEN RETURN TRUE
    IF t = T_FLIPPERS OR t = T_FIREBOOTS OR t = T_ICESKATES OR t = T_SUCTION THEN RETURN TRUE
    IF t = T_THIEF OR t = T_HINT THEN RETURN TRUE
    ' Wasser ist Wand ausser fuer Gleiter(4); Feuer Wand ausser Feuerball(1)
    IF t = T_WATER AND mt <> 4 THEN RETURN TRUE
    IF t = T_FIRE AND mt <> 1 THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

FUNCTION mob_can_enter(idx AS INTEGER, x AS INTEGER, y AS INTEGER, d AS INTEGER) AS BOOLEAN
    IF NOT inb(x, y) THEN RETURN FALSE
    IF edge_blocked(mob_x[idx], mob_y[idx], d) THEN RETURN FALSE
    IF mob_solid(mob_type[idx], terr[cidx(x, y)]) THEN RETURN FALSE
    IF block_at(x, y) >= 0 THEN RETURN FALSE
    IF mob_at(x, y) >= 0 THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' ----------------------------------------------------------------------
'  LEVEL-SETS FINDEN
' ----------------------------------------------------------------------
SUB scan_sets()
    nsets = 0
    add_sets_in("levels")
    add_sets_in("levels/_downloaded")
END SUB

SUB add_sets_in(dir AS STRING)
    IF NOT DIREXISTS(dir) THEN RETURN
    DIM files AS ARRAY OF STRING
    files = DIRLIST(dir)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(files) - 1
        DIM fn AS STRING
        fn = files[i]
        IF RIGHT$(LOWER$(fn), 5) = ".json" AND nsets < MAXSETS THEN
            DIM path AS STRING
            path = PATHJOIN(dir, fn)
            TRY
                DIM h AS JSON_HANDLE
                h = JSON_LOAD(path)
                DIM cnt AS INTEGER
                cnt = JSON_LEN(h, "levels")
                IF cnt > 0 THEN
                    set_path[nsets] = path
                    DIM nm AS STRING
                    nm = JSON_GET_STRING(h, "name")
                    IF LEN(nm) = 0 THEN nm = fn
                    set_name[nsets] = nm
                    set_count[nsets] = cnt
                    nsets = nsets + 1
                END IF
            CATCH e
                ' ungueltige JSON ueberspringen
            END TRY
        END IF
    NEXT
END SUB

' ----------------------------------------------------------------------
'  SAVE / FORTSCHRITT / PASSWORT
' ----------------------------------------------------------------------
' Set-Name -> stabiler Save-Key-Praefix (nur a-z0-9, Rest -> '_')
FUNCTION set_key(nm AS STRING) AS STRING
    DIM low AS STRING
    low = LOWER$(nm)
    DIM r AS STRING
    r = ""
    DIM i AS INTEGER
    FOR i = 0 TO LEN(low) - 1
        DIM c AS STRING
        c = MID$(low, i, 1)
        DIM a AS INTEGER
        a = ASC(c)
        IF (a >= 97 AND a <= 122) OR (a >= 48 AND a <= 57) THEN
            r = r + c
        ELSE
            r = r + "_"
        END IF
    NEXT
    RETURN r
END FUNCTION

FUNCTION best_key(idx AS INTEGER) AS STRING
    RETURN cur_setkey + "/" + STR$(idx) + "/best"
END FUNCTION

' Bestwert des Levels, oder -1 wenn noch nie geschafft.
' Getimte Level: hoechste verbliebene Zeit (CC-Zeitbonus). Ungetimte: kuerzeste
' verbrauchte Zeit. Welche Lesart gilt, sagt lvl_time des Levels.
FUNCTION best_for(idx AS INTEGER) AS INTEGER
    RETURN SAVE_GET_INT_OR(sav, best_key(idx), -1)
END FUNCTION

' Bestwert/Sieg-Wert als Text -- getimt = "… übrig", ungetimt = verbrauchte Zeit
FUNCTION score_label(v AS INTEGER) AS STRING
    IF lvl_time > 0 THEN RETURN fmt_time(v) + " uebrig"
    RETURN fmt_time(v)
END FUNCTION

' Sieg verbuchen: Bestwert aktualisieren, Fortschritt sichern, Datei schreiben
SUB record_win()
    DIM elapsed AS INTEGER
    elapsed = (MILLIS() - start_ms) \ 1000
    IF lvl_time > 0 THEN
        win_secs = lvl_time - elapsed       ' CC-Zeitbonus: verbliebene Zeit
        IF win_secs < 0 THEN win_secs = 0
    ELSE
        win_secs = elapsed                  ' ungetimt: verbrauchte Zeit
    END IF
    new_record = FALSE
    DIM old AS INTEGER
    old = best_for(cur_level)
    DIM better AS BOOLEAN
    IF lvl_time > 0 THEN
        better = (old < 0 OR win_secs > old)   ' mehr Zeit uebrig = besser
    ELSE
        better = (old < 0 OR win_secs < old)   ' weniger verbraucht = besser
    END IF
    IF better THEN
        SAVE_SET_INT(sav, best_key(cur_level), win_secs)
        new_record = TRUE
    END IF
    DIM mk AS STRING
    mk = cur_setkey + "/max"
    IF cur_level + 1 > SAVE_GET_INT_OR(sav, mk, 0) THEN
        SAVE_SET_INT(sav, mk, cur_level + 1)
    END IF
    SAVE_WRITE(sav, SAVEPATH)
    lvl_best = best_for(cur_level)
    ' Passwort des naechsten Levels merken (fuer das Sieg-Overlay)
    next_pw = ""
    IF cur_level + 1 < nlevels THEN
        next_pw = JSON_GET_STRING(js, "levels." + STR$(cur_level + 1) + ".password")
    END IF
END SUB

' Sekunden -> "m:ss" bzw. "s" fuer kurze Zeiten
FUNCTION fmt_time(s AS INTEGER) AS STRING
    IF s < 60 THEN RETURN STR$(s) + "s"
    DIM m AS INTEGER
    m = s \ 60
    DIM r AS INTEGER
    r = s MOD 60
    DIM rs AS STRING
    rs = STR$(r)
    IF r < 10 THEN rs = "0" + rs
    RETURN STR$(m) + ":" + rs
END FUNCTION

' Passwort-Eingabe pro Frame verarbeiten (Tippen / Loeschen / Bestaetigen)
SUB update_password()
    IF INPUT_PRESSED("back") THEN
        state = "menu"
        RETURN
    END IF
    ' getippte Zeichen aus der Tipp-Queue holen (A-Z, 0-9)
    DIM ch AS STRING
    ch = INKEY$()
    WHILE LEN(ch) > 0
        DIM ca AS INTEGER
        ca = ASC(UPPER$(ch))
        IF ((ca >= 65 AND ca <= 90) OR (ca >= 48 AND ca <= 57)) AND LEN(pw_input) < 9 THEN
            pw_input = pw_input + UPPER$(ch)
            pw_msg = ""
        END IF
        ch = INKEY$()
    WEND
    IF INPUT_PRESSED("delchar") AND LEN(pw_input) > 0 THEN
        pw_input = pw_input[0:LEN(pw_input) - 1]
        pw_msg = ""
    END IF
    IF INPUT_PRESSED("confirm") AND LEN(pw_input) > 0 THEN
        DIM hit AS INTEGER
        hit = find_password(pw_input)
        IF hit >= 0 THEN
            cur_level = hit
            load_level(cur_level)
            state = "intro"
        ELSE
            pw_msg = "Unbekanntes Passwort"
        END IF
    END IF
END SUB

' Level-Index mit passendem Passwort (case-insensitiv), sonst -1
FUNCTION find_password(pw AS STRING) AS INTEGER
    DIM up AS STRING
    up = UPPER$(pw)
    IF LEN(up) = 0 THEN RETURN -1
    DIM i AS INTEGER
    FOR i = 0 TO nlevels - 1
        DIM lp AS STRING
        lp = UPPER$(JSON_GET_STRING(js, "levels." + STR$(i) + ".password"))
        IF LEN(lp) > 0 AND lp = up THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' ----------------------------------------------------------------------
'  LEVEL LADEN
' ----------------------------------------------------------------------
SUB load_level(idx AS INTEGER)
    DIM base AS STRING
    base = "levels." + STR$(idx) + "."
    lvl_title = JSON_GET_STRING(js, base + "title")
    lvl_hint = JSON_GET_STRING(js, base + "hint")
    lvl_time = JSON_GET_INT(js, base + "time")
    DIM want_chips AS INTEGER
    want_chips = JSON_GET_INT(js, base + "chips")
    DIM up AS STRING
    DIM lo AS STRING
    up = JSON_GET_STRING(js, base + "upper")
    lo = JSON_GET_STRING(js, base + "lower")

    nmob = 0
    nblk = 0
    chips_left = 0
    px = 1
    py = 1
    pdir = 2

    DIM i AS INTEGER
    FOR i = 0 TO NCELL - 1
        DIM uc AS INTEGER
        DIM lc AS INTEGER
        uc = hexnib(MID$(up, i * 2, 1)) * 16 + hexnib(MID$(up, i * 2 + 1, 1))
        lc = hexnib(MID$(lo, i * 2, 1)) * 16 + hexnib(MID$(lo, i * 2 + 1, 1))
        DIM cx AS INTEGER
        DIM cy AS INTEGER
        cx = i MOD GW
        cy = i \ GW
        IF uc >= &H40 AND uc <= &H63 THEN
            ' Monster
            IF nmob < MAXMOB THEN
                mob_x[nmob] = cx
                mob_y[nmob] = cy
                mob_type[nmob] = (uc - &H40) \ 4
                mob_dir[nmob] = (uc - &H40) MOD 4
                mob_alive[nmob] = TRUE
                mob_trapped[nmob] = FALSE
                nmob = nmob + 1
            END IF
            terr[i] = lc
        ELSEIF uc = T_BLOCK OR (uc >= &H0E AND uc <= &H11) THEN
            ' Block (auch Clone-Block)
            IF nblk < MAXBLK THEN
                blk_x[nblk] = cx
                blk_y[nblk] = cy
                blk_alive[nblk] = TRUE
                nblk = nblk + 1
            END IF
            terr[i] = lc
        ELSEIF uc >= T_CHIP_N AND uc <= &H6F THEN
            ' Spieler-Start
            px = cx
            py = cy
            pdir = uc - T_CHIP_N
            terr[i] = lc
        ELSEIF uc >= &H3C AND uc <= &H3F THEN
            ' Chip schwimmend = Spieler-Start im Wasser
            px = cx
            py = cy
            pdir = uc - &H3C
            terr[i] = T_WATER
        ELSE
            terr[i] = uc
            IF uc = T_CHIP THEN chips_left = chips_left + 1
        END IF
    NEXT
    IF want_chips > 0 THEN chips_left = want_chips
    chips_total = chips_left

    ' Verdrahtung laden
    load_wires(idx)
    ' Monster in MS-Bewegungsreihenfolge bringen (CCLP1-Timing)
    reorder_monsters(idx)

    keys_blue = 0
    keys_red = 0
    keys_green = 0
    keys_yellow = 0
    has_flippers = FALSE
    has_fireboots = FALSE
    has_iceskates = FALSE
    has_suction = FALSE
    slide_kind = 0
    slide_dir = pdir
    on_water = FALSE
    tickcount = 0
    acc = 0.0
    time_left = lvl_time
    start_ms = MILLIS()
    pox = px
    poy = py
    anim_t = 1.0
    tick_timer = 0.0
    DIM gi AS INTEGER
    FOR gi = 0 TO nmob - 1
        mob_ox[gi] = mob_x[gi]
        mob_oy[gi] = mob_y[gi]
    NEXT
    FOR gi = 0 TO nblk - 1
        blk_ox[gi] = blk_x[gi]
        blk_oy[gi] = blk_y[gi]
        blk_sdir[gi] = -1
    NEXT
    pushed_blk = -1
    lvl_best = best_for(idx)
END SUB

SUB load_wires(idx AS INTEGER)
    ntrap = 0
    nclone = 0
    DIM base AS STRING
    base = "levels." + STR$(idx) + "."
    DIM ts AS STRING
    ts = JSON_GET_STRING(js, base + "traps")
    IF LEN(ts) > 0 THEN
        DIM recs AS ARRAY OF STRING
        recs = SPLIT$(ts, ";")
        DIM r AS INTEGER
        FOR r = 0 TO LEN(recs) - 1
            DIM p AS ARRAY OF STRING
            p = SPLIT$(recs[r], ",")
            IF LEN(p) >= 4 AND ntrap < MAXWIRE THEN
                trap_bx[ntrap] = VAL(p[0])
                trap_by[ntrap] = VAL(p[1])
                trap_tx[ntrap] = VAL(p[2])
                trap_ty[ntrap] = VAL(p[3])
                ntrap = ntrap + 1
            END IF
        NEXT
    END IF
    DIM cs AS STRING
    cs = JSON_GET_STRING(js, base + "cloners")
    IF LEN(cs) > 0 THEN
        DIM recs2 AS ARRAY OF STRING
        recs2 = SPLIT$(cs, ";")
        DIM r2 AS INTEGER
        FOR r2 = 0 TO LEN(recs2) - 1
            DIM p2 AS ARRAY OF STRING
            p2 = SPLIT$(recs2[r2], ",")
            IF LEN(p2) >= 4 AND nclone < MAXWIRE THEN
                clone_bx[nclone] = VAL(p2[0])
                clone_by[nclone] = VAL(p2[1])
                clone_mx[nclone] = VAL(p2[2])
                clone_my[nclone] = VAL(p2[3])
                nclone = nclone + 1
            END IF
        NEXT
    END IF
END SUB

' MS-Ruleset: Monster ziehen in der Reihenfolge der 0x0A-Bewegungsliste,
' NICHT in Map-Lesereihenfolge. CCLP1-Puzzles sind darauf getimt.
' Monster, die nicht in der Liste stehen, haengen wir in Lesereihenfolge an.
SUB reorder_monsters(idx AS INTEGER)
    IF nmob = 0 THEN RETURN
    DIM base AS STRING
    base = "levels." + STR$(idx) + "."
    DIM ms AS STRING
    ms = JSON_GET_STRING(js, base + "monsters")
    IF LEN(ms) = 0 THEN RETURN
    DIM k AS INTEGER
    FOR k = 0 TO nmob - 1
        mplaced[k] = FALSE
    NEXT
    DIM nord AS INTEGER
    nord = 0
    DIM recs AS ARRAY OF STRING
    recs = SPLIT$(ms, ";")
    DIM r AS INTEGER
    FOR r = 0 TO LEN(recs) - 1
        DIM p AS ARRAY OF STRING
        p = SPLIT$(recs[r], ",")
        IF LEN(p) >= 2 THEN
            DIM mx AS INTEGER
            DIM my AS INTEGER
            mx = VAL(p[0])
            my = VAL(p[1])
            DIM j AS INTEGER
            FOR j = 0 TO nmob - 1
                IF NOT mplaced[j] AND mob_x[j] = mx AND mob_y[j] = my THEN
                    mord[nord] = j
                    nord = nord + 1
                    mplaced[j] = TRUE
                    BREAK
                END IF
            NEXT
        END IF
    NEXT
    ' restliche Monster (nicht gelistet) in Lesereihenfolge
    FOR k = 0 TO nmob - 1
        IF NOT mplaced[k] THEN
            mord[nord] = k
            nord = nord + 1
            mplaced[k] = TRUE
        END IF
    NEXT
    ' Arrays gemaess Permutation neu aufbauen (alive=TRUE/trapped=FALSE bei Load,
    ' ox/oy werden danach aus x/y gesetzt -- nur x/y/dir/type permutieren)
    FOR k = 0 TO nmob - 1
        tmob_x[k] = mob_x[k]
        tmob_y[k] = mob_y[k]
        tmob_dir[k] = mob_dir[k]
        tmob_type[k] = mob_type[k]
    NEXT
    FOR k = 0 TO nmob - 1
        mob_x[k] = tmob_x[mord[k]]
        mob_y[k] = tmob_y[mord[k]]
        mob_dir[k] = tmob_dir[mord[k]]
        mob_type[k] = tmob_type[mord[k]]
    NEXT
END SUB

' ----------------------------------------------------------------------
'  AUDIO
' ----------------------------------------------------------------------
' Kenney-WAVs mit angepasster Lautstaerke; ohne sie Synth-Toene als Fallback.
SUB sfx_step()
    IF snd_ok THEN
        PLAYSOUND(snd_step, 0, 0.30)        ' leise -- spielt bei jedem Zug
    ELSE
        AUDIO_PLAY(AUDIO_TONE(220.0, 25, "sine", 0.05))
    END IF
END SUB
SUB sfx_chip()
    IF snd_ok THEN
        PLAYSOUND(snd_chip, 0, 0.7)
    ELSE
        AUDIO_PLAY(AUDIO_TONE(880.0, 70, "sine", 0.18))
    END IF
END SUB
SUB sfx_door()
    IF snd_ok THEN
        PLAYSOUND(snd_door, 0, 0.6)
    ELSE
        AUDIO_PLAY(AUDIO_SFX("square", 320.0, 460.0, 2, 60, 120, 0.0, 0.0, 0.2))
    END IF
END SUB
SUB sfx_block()
    IF snd_ok THEN
        PLAYSOUND(snd_block, 0, 0.6)
    ELSE
        AUDIO_PLAY(AUDIO_TONE(120.0, 50, "square", 0.12))
    END IF
END SUB
SUB sfx_die()
    IF snd_ok THEN
        PLAYSOUND(snd_die, 0, 0.85)
    ELSE
        AUDIO_PLAY(AUDIO_SFX("noise", 220.0, -200.0, 3, 120, 260, 0.0, 0.0, 0.3))
    END IF
END SUB
SUB sfx_win()
    IF snd_ok THEN
        PLAYSOUND(snd_win, 0, 0.85)
    ELSE
        AUDIO_PLAY(AUDIO_SFX("square", 440.0, 660.0, 4, 160, 240, 4.0, 4.0, 0.28))
        AUDIO_PLAY(AUDIO_TONE(990.0, 240, "sine", 0.2))
    END IF
END SUB
SUB sfx_blocked()
    IF snd_ok THEN
        PLAYSOUND(snd_blocked, 0, 0.45)
    ELSE
        AUDIO_PLAY(AUDIO_TONE(90.0, 40, "square", 0.1))
    END IF
END SUB

' Spiel-Track fuer das aktuelle Level (level1..3 rotierend)
FUNCTION music_for_level() AS STRING
    RETURN "assets/music/level" + STR$((cur_level MOD 3) + 1) + ".ogg"
END FUNCTION

' Gewuenschten Track abspielen -- wechselt nur, wenn er sich aendert
SUB set_music(track AS STRING)
    IF NOT music_ok OR NOT music_on THEN RETURN
    IF track = cur_music THEN RETURN
    PLAYMUSIC(track, 0, MUS_VOL)
    cur_music = track
END SUB

' Musik an/aus schalten (Taste M)
SUB toggle_music()
    music_on = NOT music_on
    IF music_on THEN
        cur_music = ""          ' erzwingt Neustart des passenden Tracks
    ELSE
        STOPMUSIC()
        cur_music = ""
    END IF
END SUB

' ----------------------------------------------------------------------
'  SPIELER-BEWEGUNG + MECHANIK
' ----------------------------------------------------------------------
SUB player_die(msg AS STRING)
    state = "dead"
    death_msg = msg
    sfx_die()
END SUB

' Kann der Spieler von (px,py) nach (nx,ny) in Richtung d?
' Behandelt Tueren/Sockel/Bloecke direkt (Seiteneffekte beim Betreten via land_on).
FUNCTION player_can_enter(nx AS INTEGER, ny AS INTEGER, d AS INTEGER) AS BOOLEAN
    IF NOT inb(nx, ny) THEN RETURN FALSE
    IF edge_blocked(px, py, d) THEN RETURN FALSE
    DIM t AS INTEGER
    t = terr[cidx(nx, ny)]
    IF t = T_WALL OR t = T_INVWALL OR t = T_HIDDEN OR t = T_WALL_SE THEN RETURN FALSE
    IF t = T_WALLN OR t = T_WALLW OR t = T_WALLS OR t = T_WALLE THEN RETURN FALSE
    IF t = T_BLUEBLOCK_W THEN RETURN FALSE
    IF t = T_TOGGLE_C THEN RETURN FALSE
    IF t = T_CLONER THEN RETURN FALSE
    IF t = T_DOOR_BLUE AND keys_blue <= 0 THEN RETURN FALSE
    IF t = T_DOOR_RED AND keys_red <= 0 THEN RETURN FALSE
    IF t = T_DOOR_GREEN AND keys_green <= 0 THEN RETURN FALSE
    IF t = T_DOOR_YELLOW AND keys_yellow <= 0 THEN RETURN FALSE
    IF t = T_SOCKET AND chips_left > 0 THEN RETURN FALSE
    ' Block davor -> nur wenn schiebbar
    DIM bi AS INTEGER
    bi = block_at(nx, ny)
    IF bi >= 0 THEN
        DIM tx AS INTEGER
        DIM ty AS INTEGER
        tx = nx + dxv[d]
        ty = ny + dyv[d]
        IF NOT block_can_move(nx, ny, tx, ty, d) THEN RETURN FALSE
    END IF
    RETURN TRUE
END FUNCTION

FUNCTION block_can_move(fx AS INTEGER, fy AS INTEGER, tx AS INTEGER, ty AS INTEGER, d AS INTEGER) AS BOOLEAN
    IF NOT inb(tx, ty) THEN RETURN FALSE
    IF edge_blocked(fx, fy, d) THEN RETURN FALSE
    IF block_at(tx, ty) >= 0 THEN RETURN FALSE
    IF mob_at(tx, ty) >= 0 THEN RETURN FALSE
    DIM t AS INTEGER
    t = terr[cidx(tx, ty)]
    IF t = T_WALL OR t = T_INVWALL OR t = T_HIDDEN OR t = T_WALL_SE THEN RETURN FALSE
    IF t = T_WALLN OR t = T_WALLW OR t = T_WALLS OR t = T_WALLE THEN RETURN FALSE
    IF t = T_BLUEBLOCK_W OR t = T_BLUEBLOCK_F THEN RETURN FALSE
    IF t = T_TOGGLE_C OR t = T_CLONER OR t = T_SOCKET OR t = T_EXIT THEN RETURN FALSE
    IF t = T_CHIP THEN RETURN FALSE
    IF t = T_DOOR_BLUE OR t = T_DOOR_RED OR t = T_DOOR_GREEN OR t = T_DOOR_YELLOW THEN RETURN FALSE
    IF t = T_KEY_BLUE OR t = T_KEY_RED OR t = T_KEY_GREEN OR t = T_KEY_YELLOW THEN RETURN FALSE
    IF t = T_FLIPPERS OR t = T_FIREBOOTS OR t = T_ICESKATES OR t = T_SUCTION THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' Block von (fx,fy) nach (tx,ty) schieben (inkl. Wasser->Dreck, Bombe).
SUB push_block(bi AS INTEGER, tx AS INTEGER, ty AS INTEGER)
    DIM t AS INTEGER
    t = terr[cidx(tx, ty)]
    IF t = T_WATER THEN
        terr[cidx(tx, ty)] = T_DIRT
        blk_alive[bi] = FALSE
        sfx_block()
        RETURN
    END IF
    IF t = T_BOMB THEN
        terr[cidx(tx, ty)] = T_FLOOR
        blk_alive[bi] = FALSE
        sfx_die()
        RETURN
    END IF
    DIM d AS INTEGER
    IF tx > blk_x[bi] THEN
        d = 3
    ELSEIF tx < blk_x[bi] THEN
        d = 1
    ELSEIF ty < blk_y[bi] THEN
        d = 0
    ELSE
        d = 2
    END IF
    blk_x[bi] = tx
    blk_y[bi] = ty
    IF t = T_DIRT THEN terr[cidx(tx, ty)] = T_FLOOR
    pushed_blk = bi
    set_block_slide(bi, d)
    sfx_block()
    ' Block toggelt gruenen Knopf
    IF t = T_BTN_GREEN THEN toggle_walls()
END SUB

' Rutsch-Richtung eines Blocks aus seiner aktuellen Kachel bestimmen
SUB set_block_slide(bi AS INTEGER, d AS INTEGER)
    DIM t AS INTEGER
    t = terr[cidx(blk_x[bi], blk_y[bi])]
    DIM fdir AS INTEGER
    fdir = force_dir(t)
    IF t = T_ICE THEN
        blk_sdir[bi] = d
    ELSEIF t = T_ICE_NW2 OR t = T_ICE_NE2 OR t = T_ICE_SE2 OR t = T_ICE_SW2 THEN
        blk_sdir[bi] = corner_redirect(t, d)
    ELSEIF fdir >= 0 THEN
        blk_sdir[bi] = fdir
    ELSE
        blk_sdir[bi] = -1
    END IF
END SUB

' Rutschende Bloecke einen Schritt weiterbewegen (1 Zelle/Tick)
SUB advance_blocks()
    DIM i AS INTEGER
    FOR i = 0 TO nblk - 1
        IF blk_alive[i] AND blk_sdir[i] >= 0 AND i <> pushed_blk THEN
            DIM d AS INTEGER
            d = blk_sdir[i]
            DIM here AS INTEGER
            here = terr[cidx(blk_x[i], blk_y[i])]
            IF here = T_ICE_NW2 OR here = T_ICE_NE2 OR here = T_ICE_SE2 OR here = T_ICE_SW2 THEN
                d = corner_redirect(here, d)
            ELSE
                DIM fd2 AS INTEGER
                fd2 = force_dir(here)
                IF fd2 >= 0 THEN d = fd2
            END IF
            blk_sdir[i] = d
            DIM tx AS INTEGER
            DIM ty AS INTEGER
            tx = blk_x[i] + dxv[d]
            ty = blk_y[i] + dyv[d]
            DIM tt AS INTEGER
            tt = tat(tx, ty)
            IF tt = T_WATER THEN
                terr[cidx(tx, ty)] = T_DIRT
                blk_alive[i] = FALSE
            ELSEIF tt = T_BOMB THEN
                terr[cidx(tx, ty)] = T_FLOOR
                blk_alive[i] = FALSE
                sfx_die()
            ELSEIF tx = px AND ty = py THEN
                blk_x[i] = tx
                blk_y[i] = ty
                player_die("Von einem Block zerquetscht!")
            ELSEIF block_can_move(blk_x[i], blk_y[i], tx, ty, d) THEN
                blk_x[i] = tx
                blk_y[i] = ty
                IF tt = T_DIRT THEN terr[cidx(tx, ty)] = T_FLOOR
                set_block_slide(i, d)
            ELSE
                blk_sdir[i] = -1
            END IF
        END IF
    NEXT
END SUB

' Effekte beim Betreten von (px,py)
SUB land_on()
    DIM t AS INTEGER
    t = terr[cidx(px, py)]
    on_water = FALSE
    IF t = T_DIRT THEN
        terr[cidx(px, py)] = T_FLOOR
        RETURN
    END IF
    IF t = T_CHIP THEN
        terr[cidx(px, py)] = T_FLOOR
        IF chips_left > 0 THEN chips_left = chips_left - 1
        sfx_chip()
        RETURN
    END IF
    IF t = T_KEY_BLUE THEN
        keys_blue = keys_blue + 1
        terr[cidx(px, py)] = T_FLOOR
        sfx_chip()
        RETURN
    END IF
    IF t = T_KEY_RED THEN
        keys_red = keys_red + 1
        terr[cidx(px, py)] = T_FLOOR
        sfx_chip()
        RETURN
    END IF
    IF t = T_KEY_GREEN THEN
        keys_green = keys_green + 1
        terr[cidx(px, py)] = T_FLOOR
        sfx_chip()
        RETURN
    END IF
    IF t = T_KEY_YELLOW THEN
        keys_yellow = keys_yellow + 1
        terr[cidx(px, py)] = T_FLOOR
        sfx_chip()
        RETURN
    END IF
    IF t = T_FLIPPERS THEN
        has_flippers = TRUE
        terr[cidx(px, py)] = T_FLOOR
        sfx_chip()
        RETURN
    END IF
    IF t = T_FIREBOOTS THEN
        has_fireboots = TRUE
        terr[cidx(px, py)] = T_FLOOR
        sfx_chip()
        RETURN
    END IF
    IF t = T_ICESKATES THEN
        has_iceskates = TRUE
        terr[cidx(px, py)] = T_FLOOR
        sfx_chip()
        RETURN
    END IF
    IF t = T_SUCTION THEN
        has_suction = TRUE
        terr[cidx(px, py)] = T_FLOOR
        sfx_chip()
        RETURN
    END IF
    IF t = T_DOOR_BLUE THEN
        keys_blue = keys_blue - 1
        terr[cidx(px, py)] = T_FLOOR
        sfx_door()
        RETURN
    END IF
    IF t = T_DOOR_RED THEN
        keys_red = keys_red - 1
        terr[cidx(px, py)] = T_FLOOR
        sfx_door()
        RETURN
    END IF
    IF t = T_DOOR_GREEN THEN
        terr[cidx(px, py)] = T_FLOOR
        sfx_door()
        RETURN
    END IF
    IF t = T_DOOR_YELLOW THEN
        keys_yellow = keys_yellow - 1
        terr[cidx(px, py)] = T_FLOOR
        sfx_door()
        RETURN
    END IF
    IF t = T_SOCKET THEN
        terr[cidx(px, py)] = T_FLOOR
        sfx_door()
        RETURN
    END IF
    IF t = T_THIEF THEN
        has_flippers = FALSE
        has_fireboots = FALSE
        has_iceskates = FALSE
        has_suction = FALSE
        sfx_blocked()
        RETURN
    END IF
    IF t = T_BTN_GREEN THEN
        toggle_walls()
        RETURN
    END IF
    IF t = T_BTN_BLUE THEN
        reverse_tanks()
        RETURN
    END IF
    IF t = T_BTN_RED THEN
        fire_cloners(px, py)
        RETURN
    END IF
    IF t = T_EXIT THEN
        state = "win"
        record_win()
        sfx_win()
        RETURN
    END IF
    IF t = T_WATER THEN
        IF has_flippers THEN
            on_water = TRUE
        ELSE
            player_die("Ertrunken!")
        END IF
        RETURN
    END IF
    IF t = T_FIRE THEN
        IF NOT has_fireboots THEN player_die("Verbrannt!")
        RETURN
    END IF
    IF t = T_BOMB THEN
        terr[cidx(px, py)] = T_FLOOR
        player_die("In die Luft gesprengt!")
        RETURN
    END IF
    IF t = T_TELEPORT THEN
        do_teleport()
        RETURN
    END IF
    IF t = T_PASSONCE THEN
        terr[cidx(px, py)] = T_WALL    ' wird hinter dir zur Wand
        RETURN
    END IF
END SUB

' Eis-/Force-Rutschzustand nach dem Landen bestimmen
SUB update_slide()
    DIM t AS INTEGER
    t = terr[cidx(px, py)]
    slide_kind = 0
    IF t = T_ICE AND NOT has_iceskates THEN
        slide_kind = 1
        slide_dir = pdir
    ELSEIF (t = T_ICE_NW2 OR t = T_ICE_NE2 OR t = T_ICE_SE2 OR t = T_ICE_SW2) AND NOT has_iceskates THEN
        slide_kind = 1
        slide_dir = corner_redirect(t, pdir)
        pdir = slide_dir
    ELSEIF t = T_FORCE_N AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = 0
    ELSEIF t = T_FORCE_W AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = 1
    ELSEIF t = T_FORCE_S AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = 2
    ELSEIF t = T_FORCE_E AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = 3
    ELSEIF t = T_FORCE_RND AND NOT has_suction THEN
        slide_kind = 2
        slide_dir = RANDINT(0, 3)
    END IF
END SUB

FUNCTION force_dir(t AS INTEGER) AS INTEGER
    IF t = T_FORCE_N THEN RETURN 0
    IF t = T_FORCE_W THEN RETURN 1
    IF t = T_FORCE_S THEN RETURN 2
    IF t = T_FORCE_E THEN RETURN 3
    IF t = T_FORCE_RND THEN RETURN RANDINT(0, 3)
    RETURN -1
END FUNCTION

FUNCTION corner_redirect(t AS INTEGER, m AS INTEGER) AS INTEGER
    ' offene Richtungen je Eck-Tile
    ' offene Kanten je CC-Code (1A=SE,1B=SW,1C=NW,1D=NE); 0=N 1=W 2=S 3=E
    DIM oa AS INTEGER
    DIM ob AS INTEGER
    IF t = T_ICE_NW2 THEN
        oa = 2
        ob = 3
    ELSEIF t = T_ICE_NE2 THEN
        oa = 2
        ob = 1
    ELSEIF t = T_ICE_SE2 THEN
        oa = 0
        ob = 1
    ELSE
        oa = 0
        ob = 3
    END IF
    IF m = turn_back(oa) THEN RETURN ob
    IF m = turn_back(ob) THEN RETURN oa
    RETURN m
END FUNCTION

SUB do_teleport()
    ' naechsten Teleporter in Rueckwaerts-Lesereihenfolge suchen, von dem aus
    ' in pdir ausgetreten werden kann
    DIM start AS INTEGER
    start = cidx(px, py)
    DIM c AS INTEGER
    c = start - 1
    DIM guard AS INTEGER
    guard = 0
    WHILE guard < NCELL
        IF c < 0 THEN c = NCELL - 1
        IF terr[c] = T_TELEPORT AND c <> start THEN
            DIM tx2 AS INTEGER
            DIM ty2 AS INTEGER
            tx2 = c MOD GW
            ty2 = c \ GW
            DIM ex AS INTEGER
            DIM ey AS INTEGER
            ex = tx2 + dxv[pdir]
            ey = ty2 + dyv[pdir]
            ' Spieler dorthin setzen (Austritt versucht der naechste Tick)
            px = tx2
            py = ty2
            pox = tx2
            poy = ty2
            RETURN
        END IF
        c = c - 1
        guard = guard + 1
    WEND
END SUB

' Ein Schritt des Spielers in Richtung d
SUB player_step(d AS INTEGER)
    pdir = d
    DIM nx AS INTEGER
    DIM ny AS INTEGER
    nx = px + dxv[d]
    ny = py + dyv[d]
    IF NOT player_can_enter(nx, ny, d) THEN
        ' blockiert: blaue Schein-Bloecke aufdecken
        DIM t0 AS INTEGER
        t0 = tat(nx, ny)
        IF t0 = T_BLUEBLOCK_F THEN terr[cidx(nx, ny)] = T_FLOOR
        IF t0 = T_BLUEBLOCK_W THEN terr[cidx(nx, ny)] = T_WALL
        IF t0 = T_HIDDEN THEN terr[cidx(nx, ny)] = T_WALL
        slide_kind = 0
        sfx_blocked()
        RETURN
    END IF
    ' evtl. Block schieben
    DIM bi AS INTEGER
    bi = block_at(nx, ny)
    IF bi >= 0 THEN
        push_block(bi, nx + dxv[d], ny + dyv[d])
    END IF
    px = nx
    py = ny
    land_on()
    IF state <> "play" THEN RETURN
    ' Kollision mit Monster?
    IF mob_at(px, py) >= 0 THEN
        player_die("Von einem Roboter erwischt!")
        RETURN
    END IF
    update_slide()
    IF slide_kind = 0 THEN sfx_step()
END SUB

' ----------------------------------------------------------------------
'  GERAETE
' ----------------------------------------------------------------------
SUB toggle_walls()
    DIM i AS INTEGER
    FOR i = 0 TO NCELL - 1
        IF terr[i] = T_TOGGLE_C THEN
            terr[i] = T_TOGGLE_O
        ELSEIF terr[i] = T_TOGGLE_O THEN
            terr[i] = T_TOGGLE_C
        END IF
    NEXT
    sfx_door()
END SUB

SUB reverse_tanks()
    DIM i AS INTEGER
    FOR i = 0 TO nmob - 1
        IF mob_alive[i] AND mob_type[i] = 3 THEN
            mob_dir[i] = turn_back(mob_dir[i])
        END IF
    NEXT
    sfx_door()
END SUB

SUB fire_cloners(bx AS INTEGER, by AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO nclone - 1
        IF clone_bx[i] = bx AND clone_by[i] = by THEN
            clone_one(clone_mx[i], clone_my[i])
        END IF
    NEXT
END SUB

SUB clone_one(mx AS INTEGER, my AS INTEGER)
    DIM src AS INTEGER
    src = mob_at(mx, my)
    IF src < 0 THEN RETURN
    DIM d AS INTEGER
    d = mob_dir[src]
    DIM nx AS INTEGER
    DIM ny AS INTEGER
    nx = mx + dxv[d]
    ny = my + dyv[d]
    IF nmob < MAXMOB AND mob_can_enter(src, nx, ny, d) THEN
        mob_x[nmob] = nx
        mob_y[nmob] = ny
        mob_dir[nmob] = d
        mob_type[nmob] = mob_type[src]
        mob_alive[nmob] = TRUE
        mob_trapped[nmob] = FALSE
        mob_ox[nmob] = nx
        mob_oy[nmob] = ny
        nmob = nmob + 1
    END IF
END SUB

' ----------------------------------------------------------------------
'  MONSTER-KI
' ----------------------------------------------------------------------
SUB mob_try(idx AS INTEGER, d AS INTEGER)
    ' versucht Bewegung; bei Erfolg world-update; setzt mob_did
    mob_did = FALSE
    IF mob_can_enter(idx, mob_x[idx] + dxv[d], mob_y[idx] + dyv[d], d) THEN
        mob_x[idx] = mob_x[idx] + dxv[d]
        mob_y[idx] = mob_y[idx] + dyv[d]
        mob_dir[idx] = d
        mob_did = TRUE
    END IF
END SUB

SUB update_traps()
    ' Falle offen, solange ihr brauner Knopf belegt ist (Spieler/Block/Monster)
    DIM i AS INTEGER
    FOR i = 0 TO ntrap - 1
        DIM held AS BOOLEAN
        held = (px = trap_bx[i] AND py = trap_by[i])
        IF block_at(trap_bx[i], trap_by[i]) >= 0 THEN held = TRUE
        IF mob_at(trap_bx[i], trap_by[i]) >= 0 THEN held = TRUE
        DIM m AS INTEGER
        m = mob_at(trap_tx[i], trap_ty[i])
        IF m >= 0 THEN mob_trapped[m] = NOT held
    NEXT
END SUB

SUB move_monsters()
    DIM i AS INTEGER
    FOR i = 0 TO nmob - 1
        IF NOT mob_alive[i] THEN
            ' skip
        ELSEIF mob_trapped[i] THEN
            ' in Falle gefangen
        ELSE
            DIM mt AS INTEGER
            mt = mob_type[i]
            DIM period AS INTEGER
            period = MON_EVERY
            IF mt = 5 OR mt = 7 THEN period = MON_EVERY * 2
            IF (tickcount MOD period) = 0 THEN
                mob_ox[i] = mob_x[i]
                mob_oy[i] = mob_y[i]
                ai_move(i, mt)
                mob_terrain(i)
            END IF
        END IF
    NEXT
    ' Kollision Monster-auf-Spieler
    IF mob_at(px, py) >= 0 AND state = "play" THEN
        player_die("Von einem Roboter erwischt!")
    END IF
END SUB

SUB ai_move(i AS INTEGER, mt AS INTEGER)
    DIM here AS INTEGER
    here = terr[cidx(mob_x[i], mob_y[i])]
    ' --- Force-Boden: Richtung erzwingen ---
    DIM fdir AS INTEGER
    fdir = force_dir(here)
    IF fdir >= 0 THEN
        mob_try(i, fdir)
        RETURN
    END IF
    ' --- Eis: gleiten (Ecken lenken um, an Wand umkehren) ---
    IF here = T_ICE OR here = T_ICE_NW2 OR here = T_ICE_NE2 OR here = T_ICE_SE2 OR here = T_ICE_SW2 THEN
        DIM sd AS INTEGER
        sd = mob_dir[i]
        IF here <> T_ICE THEN sd = corner_redirect(here, sd)
        mob_dir[i] = sd
        mob_try(i, sd)
        IF NOT mob_did THEN
            mob_dir[i] = turn_back(sd)
            mob_try(i, mob_dir[i])
        END IF
        RETURN
    END IF
    DIM d AS INTEGER
    d = mob_dir[i]
    IF mt = 0 THEN
        ' Kaefer: linke Wand
        mob_order4(i, turn_left(d), d, turn_right(d), turn_back(d))
    ELSEIF mt = 8 THEN
        ' Paramecium: rechte Wand
        mob_order4(i, turn_right(d), d, turn_left(d), turn_back(d))
    ELSEIF mt = 4 THEN
        ' Gleiter: vor, links, rechts, zurueck
        mob_order4(i, d, turn_left(d), turn_right(d), turn_back(d))
    ELSEIF mt = 1 THEN
        ' Feuerball: vor, rechts, links, zurueck
        mob_order4(i, d, turn_right(d), turn_left(d), turn_back(d))
    ELSEIF mt = 2 THEN
        ' Ball: vor, sonst zurueck (prallt)
        mob_try(i, d)
        IF NOT mob_did THEN mob_try(i, turn_back(d))
    ELSEIF mt = 3 THEN
        ' Tank: nur vor; sonst stehen
        mob_try(i, d)
    ELSEIF mt = 6 THEN
        ' Walker: vor; sonst zufaellige neue Richtung
        mob_try(i, d)
        IF NOT mob_did THEN
            DIM tries AS INTEGER
            tries = 0
            WHILE tries < 6 AND NOT mob_did
                mob_try(i, RANDINT(0, 3))
                tries = tries + 1
            WEND
        END IF
    ELSEIF mt = 7 THEN
        ' Blob: zufaellig
        mob_try(i, RANDINT(0, 3))
    ELSEIF mt = 5 THEN
        ' Teeth: verfolgt den Spieler
        teeth_chase(i)
    END IF
END SUB

SUB mob_order4(i AS INTEGER, a AS INTEGER, b AS INTEGER, c AS INTEGER, e AS INTEGER)
    mob_try(i, a)
    IF mob_did THEN RETURN
    mob_try(i, b)
    IF mob_did THEN RETURN
    mob_try(i, c)
    IF mob_did THEN RETURN
    mob_try(i, e)
END SUB

SUB teeth_chase(i AS INTEGER)
    DIM dx AS INTEGER
    DIM dy AS INTEGER
    dx = px - mob_x[i]
    dy = py - mob_y[i]
    DIM dh AS INTEGER
    DIM dv AS INTEGER
    dh = 3
    IF dx < 0 THEN dh = 1
    dv = 2
    IF dy < 0 THEN dv = 0
    ' groessere Achse zuerst
    IF ABS(dx) >= ABS(dy) THEN
        IF dx <> 0 THEN mob_try(i, dh)
        IF NOT mob_did AND dy <> 0 THEN mob_try(i, dv)
    ELSE
        IF dy <> 0 THEN mob_try(i, dv)
        IF NOT mob_did AND dx <> 0 THEN mob_try(i, dh)
    END IF
END SUB

' Terrain-Folgen, wenn ein Monster eine Zelle betritt
SUB mob_terrain(i AS INTEGER)
    DIM t AS INTEGER
    t = terr[cidx(mob_x[i], mob_y[i])]
    IF t = T_BOMB THEN
        terr[cidx(mob_x[i], mob_y[i])] = T_FLOOR
        mob_alive[i] = FALSE
    ELSEIF t = T_TRAP THEN
        mob_trapped[i] = TRUE
    ELSEIF t = T_BTN_GREEN THEN
        toggle_walls()
    ELSEIF t = T_BTN_BLUE THEN
        reverse_tanks()
    END IF
END SUB

' ----------------------------------------------------------------------
'  WELT-TICK
' ----------------------------------------------------------------------
DIM want_dir AS INTEGER
DIM anim_frame AS INTEGER       ' Tile-Animations-Frame 0..3
DIM anim_ms AS FLOAT
DIM buf_dir AS INTEGER          ' gepufferter Tap (geht zwischen Ticks nicht verloren)
DIM held_dir AS INTEGER

SUB world_tick()
    tickcount = tickcount + 1
    pushed_blk = -1
    pox = px
    poy = py
    DIM oi AS INTEGER
    FOR oi = 0 TO nblk - 1
        blk_ox[oi] = blk_x[oi]
        blk_oy[oi] = blk_y[oi]
    NEXT
    ' --- Spieler ---
    IF slide_kind = 1 THEN
        ' Eis: kein Steuern, weiter in slide_dir bis blockiert
        IF player_can_enter(px + dxv[slide_dir], py + dyv[slide_dir], slide_dir) THEN
            player_step(slide_dir)
        ELSE
            slide_kind = 0
            IF want_dir >= 0 THEN player_step(want_dir)
        END IF
    ELSEIF slide_kind = 2 THEN
        ' Force: seitlich steuerbar, aber NICHT gegen die Kraftrichtung
        DIM ov AS INTEGER
        ov = want_dir
        IF ov = turn_back(slide_dir) THEN ov = -1
        IF ov >= 0 AND player_can_enter(px + dxv[ov], py + dyv[ov], ov) THEN
            player_step(ov)
        ELSEIF player_can_enter(px + dxv[slide_dir], py + dyv[slide_dir], slide_dir) THEN
            player_step(slide_dir)
        ELSE
            slide_kind = 0
        END IF
    ELSE
        IF want_dir >= 0 THEN player_step(want_dir)
    END IF
    advance_blocks()
    IF state <> "play" THEN RETURN
    ' --- Monster ---
    update_traps()
    move_monsters()
    ' --- Zeitlimit ---
    IF lvl_time > 0 THEN
        time_left = lvl_time - ((MILLIS() - start_ms) \ 1000)
        IF time_left <= 0 THEN
            time_left = 0
            player_die("Zeit abgelaufen!")
        END IF
    END IF
END SUB

' ----------------------------------------------------------------------
'  RENDERN
' ----------------------------------------------------------------------
' Animierte Kacheln: Frame-0-Zelle (Sheet-Zeilen 8-9). -1 = statisch.
FUNCTION anim_base(code AS INTEGER) AS INTEGER
    IF code = T_WATER THEN RETURN 128
    IF code = T_FIRE THEN RETURN 132
    IF code = T_FORCE_S THEN RETURN 136
    IF code = T_FORCE_N THEN RETURN 140
    IF code = T_FORCE_E THEN RETURN 144
    IF code = T_FORCE_W THEN RETURN 148
    IF code = T_FORCE_RND THEN RETURN 152
    IF code = T_EXIT THEN RETURN 156
    IF code = T_TELEPORT THEN RETURN 160
    IF code = T_BOMB THEN RETURN 164
    IF code = T_TOGGLE_C THEN RETURN 168
    IF code = T_TOGGLE_O THEN RETURN 172
    IF code = T_SOCKET THEN RETURN 176
    IF code = T_CLONER THEN RETURN 180
    IF code = T_THIEF THEN RETURN 184
    IF code = T_KEY_BLUE THEN RETURN 188
    IF code = T_KEY_RED THEN RETURN 192
    IF code = T_KEY_GREEN THEN RETURN 196
    IF code = T_KEY_YELLOW THEN RETURN 200
    IF code = T_FLIPPERS THEN RETURN 204
    IF code = T_FIREBOOTS THEN RETURN 208
    IF code = T_ICESKATES THEN RETURN 212
    IF code = T_SUCTION THEN RETURN 216
    RETURN -1
END FUNCTION

SUB draw_tile(code AS INTEGER, sx AS INTEGER, sy AS INTEGER)
    DIM cell AS INTEGER
    cell = code
    DIM ab AS INTEGER
    ab = anim_base(code)
    IF ab >= 0 THEN cell = ab + (anim_frame MOD 4)
    DIM srcx AS INTEGER
    DIM srcy AS INTEGER
    srcx = (cell MOD 16) * TILE
    srcy = (cell \ 16) * TILE
    DRAWIMAGEPART(tiles, srcx, srcy, TILE, TILE, sx, sy)
END SUB

DIM camx AS INTEGER
DIM camy AS INTEGER

SUB draw_board()
    DIM ease AS FLOAT
    ease = anim_t
    DIM pfx AS FLOAT
    DIM pfy AS FLOAT
    pfx = pox + (px - pox) * ease
    pfy = poy + (py - poy) * ease
    DIM camfx AS FLOAT
    DIM camfy AS FLOAT
    camfx = pfx - (VIEW - 1) / 2.0
    camfy = pfy - (VIEW - 1) / 2.0
    IF camfx < 0.0 THEN camfx = 0.0
    IF camfy < 0.0 THEN camfy = 0.0
    IF camfx > GW - VIEW THEN camfx = GW - VIEW
    IF camfy > GH - VIEW THEN camfy = GH - VIEW
    DIM bcx AS INTEGER
    DIM bcy AS INTEGER
    bcx = INT(camfx)
    bcy = INT(camfy)

    DIM vy AS INTEGER
    DIM vx AS INTEGER
    FOR vy = 0 TO VIEW
        FOR vx = 0 TO VIEW
            DIM cx AS INTEGER
            DIM cy AS INTEGER
            cx = bcx + vx
            cy = bcy + vy
            DIM sx AS INTEGER
            DIM sy AS INTEGER
            sx = INT((cx - camfx) * TILE)
            sy = INT((cy - camfy) * TILE)
            IF inb(cx, cy) THEN
                draw_tile(T_FLOOR, sx, sy)
                DIM t AS INTEGER
                t = terr[cidx(cx, cy)]
                IF t <> T_FLOOR THEN draw_tile(t, sx, sy)
            ELSE
                draw_tile(T_WALL, sx, sy)
            END IF
        NEXT
    NEXT
    ' Bloecke (interpoliert)
    DIM i AS INTEGER
    FOR i = 0 TO nblk - 1
        IF blk_alive[i] THEN
            DIM bfx AS FLOAT
            DIM bfy AS FLOAT
            bfx = blk_ox[i] + (blk_x[i] - blk_ox[i]) * ease
            bfy = blk_oy[i] + (blk_y[i] - blk_oy[i]) * ease
            draw_tile(T_BLOCK, INT((bfx - camfx) * TILE), INT((bfy - camfy) * TILE))
        END IF
    NEXT
    ' Monster (interpoliert)
    FOR i = 0 TO nmob - 1
        IF mob_alive[i] THEN
            DIM mp AS INTEGER
            mp = MON_EVERY
            IF mob_type[i] = 5 OR mob_type[i] = 7 THEN mp = MON_EVERY * 2
            DIM mph AS FLOAT
            mph = ((tickcount MOD mp) + ease) / mp
            IF mph > 1.0 THEN mph = 1.0
            DIM mfx AS FLOAT
            DIM mfy AS FLOAT
            mfx = mob_ox[i] + (mob_x[i] - mob_ox[i]) * mph
            mfy = mob_oy[i] + (mob_y[i] - mob_oy[i]) * mph
            DIM mc AS INTEGER
            mc = &H40 + mob_type[i] * 4 + mob_dir[i]
            draw_tile(mc, INT((mfx - camfx) * TILE), INT((mfy - camfy) * TILE))
        END IF
    NEXT
    ' Spieler (interpoliert, Geh-Frame wechselt pro Tick)
    DIM moving AS BOOLEAN
    moving = (pox <> px OR poy <> py)
    DIM pc AS INTEGER
    pc = T_CHIP_N + pdir
    IF on_water THEN
        pc = &H3C + pdir
    ELSEIF moving AND (tickcount MOD 2) = 1 THEN
        pc = &H70 + pdir
    END IF
    draw_tile(pc, INT((pfx - camfx) * TILE), INT((pfy - camfy) * TILE))
END SUB

SUB ct(cx AS INTEGER, cy AS INTEGER, scale AS FLOAT, s AS STRING, col AS INTEGER)
    TEXTROT(cx, cy, s, 0, scale, col)
END SUB

' HUD-Icon direkt aus dem Tileset skaliert zeichnen (nativ, scharf)
SUB draw_icon(code AS INTEGER, x AS INTEGER, y AS INTEGER)
    DRAWIMAGEPARTEX(tiles, (code MOD 16) * TILE, (code \ 16) * TILE, TILE, TILE, x, y, ic_sz, ic_sz)
END SUB

' Vertikale HUD-Position als Bruchteil der Panel-Hoehe
FUNCTION hb(f AS FLOAT) AS INTEGER
    RETURN board_y + INT(bsize * f)
END FUNCTION

' Gerundetes Sub-Panel mit Neon-Rand
SUB hud_panel(x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, y1 AS INTEGER)
    BOXROUND(x0, y0, x1, y1, 9, RGB(15, 21, 33))
    RECTROUND(x0, y0, x1, y1, 9, RGB(42, 84, 104))
END SUB

' zentriertes Sektions-Label (gedimmtes Neon)
SUB hud_label(cx AS INTEGER, y AS INTEGER, s AS STRING)
    ct(cx, y, sc_sm * 0.82, s, RGB(98, 156, 174))
END SUB

' Schluessel-Zelle: Icon + Anzahl (gedimmt bei 0)
SUB hud_keycell(cx AS INTEGER, y AS INTEGER, code AS INTEGER, n AS INTEGER)
    draw_icon(code, cx - ic_sz \ 2, y)
    DIM col AS INTEGER
    col = RGB(214, 222, 236)
    IF n = 0 THEN col = RGB(78, 90, 114)
    ct(cx, y + ic_sz + INT(BASEH * sc_sm * 0.55), sc_sm, "x" + STR$(n), col)
END SUB

' Ausruestungs-Slot: Icon wenn vorhanden, sonst leerer Slot
SUB hud_slot(cx AS INTEGER, y AS INTEGER, code AS INTEGER, have AS BOOLEAN)
    DIM h AS INTEGER
    h = (ic_sz \ 2) + INT(SH * 0.006)
    BOXROUND(cx - h, y - INT(SH * 0.005), cx + h, y + ic_sz + INT(SH * 0.005), 6, RGB(20, 27, 40))
    IF have THEN
        RECTROUND(cx - h, y - INT(SH * 0.005), cx + h, y + ic_sz + INT(SH * 0.005), 6, RGB(70, 160, 150))
        draw_icon(code, cx - ic_sz \ 2, y)
    ELSE
        RECTROUND(cx - h, y - INT(SH * 0.005), cx + h, y + ic_sz + INT(SH * 0.005), 6, RGB(36, 48, 64))
    END IF
END SUB

SUB draw_hud()
    DIM pad AS INTEGER
    pad = INT(SH * 0.018)
    DIM x0 AS INTEGER
    DIM x1 AS INTEGER
    DIM cxp AS INTEGER
    DIM ix0 AS INTEGER
    DIM ix1 AS INTEGER
    x0 = hud_x
    x1 = hud_x + hud_w
    cxp = hud_x + hud_w \ 2
    ix0 = x0 + pad
    ix1 = x1 - pad
    DIM kw AS INTEGER
    kw = (ix1 - ix0) \ 4

    ' --- Aussen-Panel (Verlauf + Neon-Rahmen) ---
    GRADIENTV(x0, board_y, x1, board_y + bsize, RGB(23, 31, 47), RGB(12, 16, 26))
    RECTROUND(x0, board_y, x1, board_y + bsize, 12, RGB(58, 112, 132))

    ' --- Header ---
    GRADIENTV(ix0, hb(0.014), ix1, hb(0.078), RGB(16, 60, 66), RGB(13, 28, 40))
    RECTROUND(ix0, hb(0.014), ix1, hb(0.078), 8, RGB(64, 158, 154))
    ct(cxp, hb(0.047), sc_med, "CIRCUIT RUNNER", RGB(122, 246, 234))

    ' --- Level + Fortschrittsbalken ---
    ct(cxp, hb(0.107), sc_sm, "LEVEL " + STR$(cur_level + 1) + " / " + STR$(nlevels), RGB(216, 224, 238))
    DIM pb0 AS INTEGER
    DIM pbh AS INTEGER
    pb0 = hb(0.138)
    pbh = INT(SH * 0.013)
    BOXROUND(ix0, pb0, ix1, pb0 + pbh, 4, RGB(24, 34, 50))
    DIM frac AS FLOAT
    frac = 0.0
    IF nlevels > 0 THEN frac = (cur_level + 1) * 1.0 / nlevels
    IF frac > 1.0 THEN frac = 1.0
    IF frac > 0.02 THEN BOXROUND(ix0, pb0, ix0 + INT((ix1 - ix0) * frac), pb0 + pbh, 4, RGB(92, 222, 162))
    ct(cxp, hb(0.178), sc_sm, lvl_title, RGB(150, 200, 240))

    ' --- Chips-Panel ---
    hud_panel(ix0, hb(0.21), ix1, hb(0.33))
    hud_label(cxp, hb(0.233), "DATEN-CHIPS")
    draw_icon(T_CHIP, ix0 + pad, hb(0.256))
    ct(ix0 + pad + ic_sz + INT(ic_sz * 1.2), hb(0.256) + ic_sz \ 2, sc_med, "x " + STR$(chips_left), RGB(122, 246, 152))
    DIM cb0 AS INTEGER
    cb0 = hb(0.307)
    BOXROUND(ix0 + pad, cb0, ix1 - pad, cb0 + INT(SH * 0.010), 3, RGB(22, 32, 46))
    IF chips_total > 0 THEN
        DIM got AS FLOAT
        got = (chips_total - chips_left) * 1.0 / chips_total
        IF got > 0.02 THEN BOXROUND(ix0 + pad, cb0, ix0 + pad + INT((ix1 - ix0 - 2 * pad) * got), cb0 + INT(SH * 0.010), 3, RGB(80, 210, 130))
    END IF

    ' --- Schluessel-Panel ---
    hud_panel(ix0, hb(0.35), ix1, hb(0.50))
    hud_label(cxp, hb(0.372), "SCHLUESSEL")
    DIM ky AS INTEGER
    ky = hb(0.40)
    hud_keycell(ix0 + kw \ 2, ky, T_KEY_BLUE, keys_blue)
    hud_keycell(ix0 + kw \ 2 + kw, ky, T_KEY_RED, keys_red)
    hud_keycell(ix0 + kw \ 2 + kw * 2, ky, T_KEY_GREEN, keys_green)
    hud_keycell(ix0 + kw \ 2 + kw * 3, ky, T_KEY_YELLOW, keys_yellow)

    ' --- Ausruestung-Panel ---
    hud_panel(ix0, hb(0.52), ix1, hb(0.67))
    hud_label(cxp, hb(0.542), "AUSRUESTUNG")
    DIM sy AS INTEGER
    sy = hb(0.575)
    hud_slot(ix0 + kw \ 2, sy, T_FLIPPERS, has_flippers)
    hud_slot(ix0 + kw \ 2 + kw, sy, T_FIREBOOTS, has_fireboots)
    hud_slot(ix0 + kw \ 2 + kw * 2, sy, T_ICESKATES, has_iceskates)
    hud_slot(ix0 + kw \ 2 + kw * 3, sy, T_SUCTION, has_suction)

    ' --- Zeit/Best-Panel ---
    hud_panel(ix0, hb(0.69), ix1, hb(0.86))
    hud_label(cxp, hb(0.712), "ZEIT")
    IF lvl_time > 0 THEN
        ct(cxp, hb(0.762), sc_big, fmt_time(time_left), RGB(244, 222, 120))
    ELSE
        ct(cxp, hb(0.762), sc_med, "frei", RGB(184, 194, 214))
    END IF
    IF lvl_best >= 0 THEN
        ct(cxp, hb(0.822), sc_sm, "Bestzeit  " + score_label(lvl_best), RGB(180, 200, 214))
    ELSE
        ct(cxp, hb(0.822), sc_sm, "noch keine Bestzeit", RGB(108, 122, 148))
    END IF

    ' --- Footer (Steuerung) ---
    ct(cxp, hb(0.93), sc_sm * 0.80, "Pfeile / WASD bewegen", RGB(122, 136, 162))
    ct(cxp, hb(0.965), sc_sm * 0.80, "R neu  -  P Passwort  -  M Musik  -  ESC Menue", RGB(110, 124, 150))
END SUB

' Hinweis-Banner, wenn der Spieler auf einem Fragezeichen-Stein steht
SUB draw_hint()
    IF LEN(lvl_hint) = 0 THEN RETURN
    DIM bx0 AS INTEGER
    DIM bx1 AS INTEGER
    DIM by0 AS INTEGER
    DIM by1 AS INTEGER
    bx0 = board_x
    bx1 = board_x + bsize
    by1 = board_y + bsize
    by0 = by1 - INT(SH * 0.20)
    BOX(bx0, by0, bx1, by1, RGB(16, 22, 32))
    RECT(bx0, by0, bx1, by1, RGB(80, 200, 220))
    ct((bx0 + bx1) \ 2, by0 + INT(SH * 0.035), sc_sm, "HINWEIS", RGB(110, 238, 226))
    draw_wrapped(lvl_hint, bx0 + INT(SW * 0.02), by0 + INT(SH * 0.08), bx1 - INT(SW * 0.02), RGB(206, 220, 236))
END SUB

SUB draw_menu()
    DIM cx AS INTEGER
    cx = SW \ 2
    ct(cx, INT(SH * 0.13), sc_big, "CIRCUIT RUNNER", RGB(110, 238, 226))
    ct(cx, INT(SH * 0.22), sc_sm, "waehle ein Level-Set", RGB(150, 162, 184))
    IF nsets = 0 THEN
        ct(cx, SH \ 2, sc_med, "Keine Sets in levels/", RGB(245, 130, 130))
        RETURN
    END IF
    DIM lo AS INTEGER
    lo = sel_set - 3
    IF lo < 0 THEN lo = 0
    DIM hi AS INTEGER
    hi = lo + 6
    IF hi > nsets - 1 THEN hi = nsets - 1
    DIM yy AS INTEGER
    yy = INT(SH * 0.37)
    DIM lh AS INTEGER
    lh = INT(BASEH * sc_med * 1.5)
    DIM si AS INTEGER
    FOR si = lo TO hi
        DIM lab AS STRING
        lab = set_name[si] + "    " + STR$(set_count[si]) + " Level"
        DIM col AS INTEGER
        col = RGB(160, 172, 196)
        IF si = sel_set THEN
            lab = "> " + lab + " <"
            col = RGB(120, 244, 160)
        END IF
        ct(cx, yy, sc_med, lab, col)
        yy = yy + lh
    NEXT
    DIM mx AS INTEGER
    mx = SAVE_GET_INT_OR(sav, set_key(set_name[sel_set]) + "/max", 0)
    DIM hint AS STRING
    hint = "Pfeile waehlen   LEER = Start   P = Passwort   ESC = Ende"
    IF mx > 0 THEN
        DIM nx AS INTEGER
        nx = mx + 1
        IF nx > set_count[sel_set] THEN nx = set_count[sel_set]
        ct(cx, INT(SH * 0.82), sc_sm, "Fortschritt: Level " + STR$(mx) + " / " + STR$(set_count[sel_set]), RGB(150, 200, 240))
        hint = "LEER = Start   C = Weiter ab Level " + STR$(nx) + "   P = Passwort   ESC = Ende"
    END IF
    ct(cx, INT(SH * 0.90), sc_sm, hint, RGB(170, 182, 206))
    DIM mhint AS STRING
    mhint = "M = Musik an"
    IF music_on THEN mhint = "M = Musik aus"
    ct(cx, INT(SH * 0.95), sc_sm, mhint, RGB(120, 134, 160))
END SUB

SUB draw_intro()
    DIM cx AS INTEGER
    cx = SW \ 2
    ct(cx, INT(SH * 0.22), sc_med, "Level " + STR$(cur_level + 1), RGB(110, 238, 226))
    ct(cx, INT(SH * 0.34), sc_big, lvl_title, RGB(232, 238, 248))
    IF lvl_best >= 0 THEN
        ct(cx, INT(SH * 0.43), sc_sm, "Bestzeit  " + score_label(lvl_best), RGB(244, 222, 120))
    END IF
    IF LEN(lvl_hint) > 0 THEN
        draw_wrapped(lvl_hint, INT(SW * 0.16), INT(SH * 0.52), INT(SW * 0.84), RGB(184, 196, 216))
    END IF
    ct(cx, INT(SH * 0.85), sc_med, "LEER = los", RGB(200, 214, 232))
    ct(cx, INT(SH * 0.91), sc_sm, "P = Passwort      ESC = Menue", RGB(150, 162, 184))
END SUB

SUB draw_password()
    DIM cx AS INTEGER
    cx = SW \ 2
    ct(cx, INT(SH * 0.22), sc_med, "PASSWORT", RGB(110, 238, 226))
    ct(cx, INT(SH * 0.31), sc_sm, "Set: " + set_name[sel_set], RGB(150, 162, 184))
    ' Eingabefeld
    DIM disp AS STRING
    disp = pw_input
    ' blinkender Cursor
    IF (INT(MILLIS() / 400) MOD 2) = 0 AND LEN(pw_input) < 9 THEN disp = disp + "_"
    IF LEN(disp) = 0 THEN disp = " "
    DIM by0 AS INTEGER
    by0 = INT(SH * 0.40)
    DIM bw AS INTEGER
    bw = INT(SW * 0.30)
    BOX(cx - bw \ 2, by0, cx + bw \ 2, by0 + INT(SH * 0.10), RGB(20, 26, 38))
    RECT(cx - bw \ 2, by0, cx + bw \ 2, by0 + INT(SH * 0.10), RGB(80, 200, 220))
    ct(cx, by0 + INT(SH * 0.05), sc_big, disp, RGB(232, 238, 248))
    IF LEN(pw_msg) > 0 THEN
        ct(cx, INT(SH * 0.60), sc_med, pw_msg, RGB(245, 130, 130))
    END IF
    ct(cx, INT(SH * 0.85), sc_sm, "tippen      ENTER = los      ESC = zurueck", RGB(170, 182, 206))
END SUB

SUB draw_done()
    DIM cx AS INTEGER
    cx = SW \ 2
    ct(cx, INT(SH * 0.34), sc_big, "ALLE LEVEL GESCHAFFT!", RGB(120, 244, 160))
    ct(cx, INT(SH * 0.50), sc_med, "Gut gemacht, Runner.", RGB(224, 230, 240))
    ct(cx, INT(SH * 0.64), sc_med, "LEER = Menue", RGB(200, 214, 232))
END SUB

SUB draw_overlay(kind AS STRING)
    DIM cx AS INTEGER
    cx = SW \ 2
    DIM x0 AS INTEGER
    DIM x1 AS INTEGER
    DIM y0 AS INTEGER
    DIM y1 AS INTEGER
    x0 = INT(SW * 0.26)
    x1 = INT(SW * 0.74)
    y0 = INT(SH * 0.36)
    y1 = INT(SH * 0.66)
    IF kind = "win" THEN
        BOX(x0, y0, x1, y1, RGB(14, 32, 24))
        RECT(x0, y0, x1, y1, RGB(80, 222, 142))
        ct(cx, INT(SH * 0.42), sc_big, "GESCHAFFT!", RGB(120, 244, 160))
        ct(cx, INT(SH * 0.50), sc_med, "Zeit  " + score_label(win_secs), RGB(224, 234, 228))
        IF new_record THEN
            ct(cx, INT(SH * 0.555), sc_sm, "NEUER REKORD!", RGB(244, 222, 120))
        ELSEIF lvl_best >= 0 THEN
            ct(cx, INT(SH * 0.555), sc_sm, "Bestzeit  " + score_label(lvl_best), RGB(180, 200, 214))
        END IF
        IF LEN(next_pw) > 0 THEN
            ct(cx, INT(SH * 0.595), sc_sm, "Passwort Level " + STR$(cur_level + 2) + ":  " + next_pw, RGB(110, 238, 226))
        END IF
        ct(cx, INT(SH * 0.635), sc_med, "LEER = weiter", RGB(204, 224, 214))
    ELSE
        BOX(x0, y0, x1, y1, RGB(34, 16, 16))
        RECT(x0, y0, x1, y1, RGB(224, 92, 92))
        ct(cx, INT(SH * 0.47), sc_med, death_msg, RGB(246, 134, 134))
        ct(cx, INT(SH * 0.55), sc_sm, "R / LEER = nochmal", RGB(232, 204, 204))
    END IF
END SUB

SUB draw_wrapped(s AS STRING, x0 AS INTEGER, y0 AS INTEGER, x1 AS INTEGER, col AS INTEGER)
    DIM words AS ARRAY OF STRING
    words = SPLIT$(s, " ")
    DIM line AS STRING
    line = ""
    DIM yy AS INTEGER
    yy = y0
    DIM maxw AS FLOAT
    maxw = (x1 - x0) * 1.0
    DIM lh AS INTEGER
    lh = INT(BASEH * sc_sm * 1.5)
    DIM cxm AS INTEGER
    cxm = (x0 + x1) \ 2
    DIM i AS INTEGER
    FOR i = 0 TO LEN(words) - 1
        DIM cand AS STRING
        IF LEN(line) = 0 THEN
            cand = words[i]
        ELSE
            cand = line + " " + words[i]
        END IF
        IF TEXT_WIDTH(cand) * sc_sm > maxw AND LEN(line) > 0 THEN
            ct(cxm, yy, sc_sm, line, col)
            yy = yy + lh
            line = words[i]
        ELSE
            line = cand
        END IF
    NEXT
    IF LEN(line) > 0 THEN ct(cxm, yy, sc_sm, line, col)
END SUB

' ----------------------------------------------------------------------
'  EINGABE
' ----------------------------------------------------------------------
SUB read_intent()
    ' Tastendruck (Tap) puffern -- bleibt bis zum naechsten Tick erhalten,
    ' damit einzelne Schritte/Kistenschuebe nicht zwischen den Ticks verloren gehen.
    IF INPUT_PRESSED("up") THEN buf_dir = 0
    IF INPUT_PRESSED("left") THEN buf_dir = 1
    IF INPUT_PRESSED("down") THEN buf_dir = 2
    IF INPUT_PRESSED("right") THEN buf_dir = 3
    ' aktuell gehaltene Richtung (fuer Dauerlauf)
    held_dir = -1
    IF INPUT_HELD("up") THEN held_dir = 0
    IF INPUT_HELD("left") THEN held_dir = 1
    IF INPUT_HELD("down") THEN held_dir = 2
    IF INPUT_HELD("right") THEN held_dir = 3
END SUB

' ======================================================================
'  INITIALISIERUNG
' ======================================================================
IF FULLSCREEN THEN
    SCREEN_NATIVE("Circuit Runner")
ELSE
    SCREEN(1280, 800, "Circuit Runner")
END IF
SETFPS(60)
WINDOW_ESC_QUIT(FALSE)

SW = SCREENWIDTH()
SH = SCREENHEIGHT()
' Board so gross wie moeglich (ganzzahlige Vergroesserung), HUD rechts daneben
bscale = (SH * 92) \ (100 * BLOG)
IF bscale < 1 THEN bscale = 1
WHILE BLOG * bscale > (SW * 58) \ 100 AND bscale > 1
    bscale = bscale - 1
WEND
bsize = BLOG * bscale
board_x = INT(SW * 0.04)
board_y = (SH - bsize) \ 2
hud_x = board_x + bsize + INT(SW * 0.03)
hud_w = SW - hud_x - INT(SW * 0.04)

dxv[0] = 0
dyv[0] = -1
dxv[1] = -1
dyv[1] = 0
dxv[2] = 0
dyv[2] = 1
dxv[3] = 1
dyv[3] = 0

rtb = RENDERTARGET_NEW(BLOG, BLOG)
tiles = LOADIMAGE("assets/tiles.png")

' Soundeffekte laden (fehlt der Ordner, faellt sfx_* auf Synth-Toene zurueck)
snd_ok = FALSE
TRY
    snd_step = LOADSOUND("assets/sfx/step.wav")
    snd_chip = LOADSOUND("assets/sfx/chip.wav")
    snd_door = LOADSOUND("assets/sfx/door.wav")
    snd_block = LOADSOUND("assets/sfx/block.wav")
    snd_die = LOADSOUND("assets/sfx/die.wav")
    snd_win = LOADSOUND("assets/sfx/win.wav")
    snd_blocked = LOADSOUND("assets/sfx/blocked.wav")
    snd_ok = TRUE
CATCH e
    snd_ok = FALSE
END TRY

' Hintergrundmusik vorhanden? (streamt via PLAYMUSIC, kein Preload)
music_ok = FILEEXISTS(MUS_TITLE) AND FILEEXISTS("assets/music/level1.ogg")
music_on = TRUE
cur_music = ""

' Font (eine TTF; Skalierung via TEXTROT, da LOADFONT-Groesse fix)
gfont = LOADFONT("assets/font.ttf", 64)
SETFONT(gfont)
TEXT_SIZE(20)
BASEH = 26
sc_big = SH / 470.0
sc_med = SH / 760.0
sc_sm = SH / 1040.0

' HUD-Icons vorskalieren (scharf in nativer Aufloesung)
ic_sz = INT(SH * 0.044)

scan_sets()
sel_set = 0
sav = SAVE_LOAD_OR_NEW(SAVEPATH)
SAVE_SET_VERSION(sav, 1)
cur_setkey = ""
lvl_best = -1
pw_input = ""
pw_msg = ""

INPUT_BIND("up", KEY_UP, KEY_W)
INPUT_BIND("down", KEY_DOWN, KEY_S)
INPUT_BIND("left", KEY_LEFT, KEY_A)
INPUT_BIND("right", KEY_RIGHT, KEY_D)
INPUT_BIND("confirm", KEY_SPACE, KEY_ENTER)
INPUT_BIND("restart", KEY_R)
INPUT_BIND("skip", KEY_N)
INPUT_BIND("back", KEY_ESCAPE)
INPUT_BIND("password", KEY_P)
INPUT_BIND("delchar", KEY_BACKSPACE)
INPUT_BIND("continue", KEY_C)
INPUT_BIND("mute", KEY_M)

state = "menu"
cur_level = 0
want_dir = -1
buf_dir = -1
held_dir = -1
anim_frame = 0
anim_ms = 0.0

' ======================================================================
'  HAUPTSCHLEIFE
' ======================================================================
WHILE NOT QUITREQUESTED()
    INPUT_UPDATE()
    anim_ms = anim_ms + DELTA() * 1000.0
    IF anim_ms >= 520.0 THEN anim_ms = anim_ms - 520.0
    anim_frame = INT(anim_ms / 130.0) MOD 4

    ' Hintergrundmusik: Titel im Menue, rotierende Level-Loops im Spiel, Ending am Ziel
    IF INPUT_PRESSED("mute") THEN toggle_music()
    IF state = "done" THEN
        set_music(MUS_ENDING)
    ELSEIF state = "intro" OR state = "play" OR state = "win" OR state = "dead" THEN
        set_music(music_for_level())
    ELSE
        set_music(MUS_TITLE)
    END IF

    IF state = "menu" THEN
        IF INPUT_PRESSED("back") THEN BREAK
        IF INPUT_PRESSED("up") AND sel_set > 0 THEN sel_set = sel_set - 1
        IF INPUT_PRESSED("down") AND sel_set < nsets - 1 THEN sel_set = sel_set + 1
        IF INPUT_PRESSED("confirm") AND nsets > 0 THEN
            js = JSON_LOAD(set_path[sel_set])
            nlevels = JSON_LEN(js, "levels")
            cur_setkey = set_key(set_name[sel_set])
            cur_level = 0
            load_level(cur_level)
            state = "intro"
        END IF
        IF INPUT_PRESSED("password") AND nsets > 0 THEN
            js = JSON_LOAD(set_path[sel_set])
            nlevels = JSON_LEN(js, "levels")
            cur_setkey = set_key(set_name[sel_set])
            pw_input = ""
            pw_msg = ""
            state = "password"
        END IF
        IF INPUT_PRESSED("continue") AND nsets > 0 THEN
            cur_setkey = set_key(set_name[sel_set])
            IF SAVE_GET_INT_OR(sav, cur_setkey + "/max", 0) > 0 THEN
                js = JSON_LOAD(set_path[sel_set])
                nlevels = JSON_LEN(js, "levels")
                cur_level = SAVE_GET_INT_OR(sav, cur_setkey + "/max", 0)
                IF cur_level > nlevels - 1 THEN cur_level = nlevels - 1
                IF cur_level < 0 THEN cur_level = 0
                load_level(cur_level)
                state = "intro"
            END IF
        END IF
    ELSEIF state = "password" THEN
        update_password()
    ELSEIF state = "intro" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"
        IF INPUT_PRESSED("confirm") THEN state = "play"
        IF INPUT_PRESSED("password") THEN
            pw_input = ""
            pw_msg = ""
            state = "password"
        END IF
    ELSEIF state = "play" THEN
        IF INPUT_PRESSED("back") THEN state = "menu"
        IF INPUT_PRESSED("restart") THEN load_level(cur_level)
        IF INPUT_PRESSED("skip") THEN
            cur_level = cur_level + 1
            IF cur_level >= nlevels THEN
                state = "done"
            ELSE
                load_level(cur_level)
                state = "intro"
            END IF
        END IF
        IF state = "play" THEN
            read_intent()
            tick_timer = tick_timer + DELTA() * 1000.0
            IF tick_timer > TICK_MS * 3.0 THEN tick_timer = TICK_MS
            IF tick_timer >= TICK_MS AND state = "play" THEN
                tick_timer = tick_timer - TICK_MS
                want_dir = buf_dir
                IF want_dir < 0 THEN want_dir = held_dir
                buf_dir = -1
                world_tick()
            END IF
            anim_t = tick_timer / TICK_MS
            IF anim_t > 1.0 THEN anim_t = 1.0
        END IF
    ELSEIF state = "win" THEN
        IF INPUT_PRESSED("confirm") THEN
            cur_level = cur_level + 1
            IF cur_level >= nlevels THEN
                state = "done"
            ELSE
                load_level(cur_level)
                state = "intro"
            END IF
        END IF
    ELSEIF state = "dead" THEN
        IF INPUT_PRESSED("confirm") OR INPUT_PRESSED("restart") THEN
            load_level(cur_level)
            state = "play"
        END IF
        IF INPUT_PRESSED("back") THEN state = "menu"
    ELSEIF state = "done" THEN
        IF INPUT_PRESSED("confirm") THEN state = "menu"
    END IF

    ' --- Render ---
    IF state = "play" OR state = "win" OR state = "dead" THEN
        RENDERTARGET_BEGIN(rtb)
        draw_board()
        RENDERTARGET_END()
    END IF
    CLS(RGB(12, 16, 24))
    IF state = "menu" THEN
        draw_menu()
    ELSEIF state = "password" THEN
        draw_password()
    ELSEIF state = "intro" THEN
        draw_intro()
    ELSEIF state = "done" THEN
        draw_done()
    ELSE
        RENDERTARGET_DRAW(rtb, board_x, board_y, bscale)
        draw_hud()
        IF state = "play" AND tat(px, py) = T_HINT THEN draw_hint()
        IF state = "win" THEN draw_overlay("win")
        IF state = "dead" THEN draw_overlay("dead")
    END IF
    FLIP()
WEND
