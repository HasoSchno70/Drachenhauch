=== rmdir loescht ein leeres verzeichnis
PRINT DIREXISTS("leer")
RMDIR("leer")
PRINT DIREXISTS("leer")
--- verzeichnis leer
--- erwartet
TRUE
FALSE

=== rmdir verweigert ein volles und sagt wie
' Ein Aufruf, der versehentlich einen ganzen Baum loescht, ist der teuerste
' Tippfehler, den ein Dateibefehl anrichten kann.
TRY
    RMDIR("voll")
    PRINT "geloescht"
CATCH e
    PRINT "nennt den ausweg "; (INSTR(e, "RMDIR(pfad, TRUE)") >= 0)
END TRY
PRINT "steht noch "; DIREXISTS("voll/drin")
--- verzeichnis voll/drin
--- erwartet
nennt den ausweg TRUE
steht noch TRUE

=== rmdir mit flag loescht alles
PRINT FILEEXISTS("voll/drin/x.txt")
RMDIR("voll", TRUE)
PRINT DIREXISTS("voll")
--- datei voll/drin/x.txt
x
--- erwartet
TRUE
FALSE

=== rmdir nimmt nur boolean
TRY
    RMDIR("leer", 1)
    PRINT "angenommen"
CATCH e
    PRINT "boolean verlangt "; (INSTR(e, "BOOLEAN") >= 0)
END TRY
PRINT DIREXISTS("leer")
--- verzeichnis leer
--- erwartet
boolean verlangt TRUE
TRUE

=== filetime passt zur zeitrechnung des moduls
' Der Grund, warum es FILETIME gibt: wie alt ist die Datei? Das geht nur, wenn
' beide Seiten dieselbe Zeitrechnung benutzen.
IMPORT "zeit"
WRITEALL("neu.txt", "x")
DIM alter AS INTEGER
alter = ZEIT_JETZT() - FILETIME("neu.txt")
PRINT alter >= 0 AND alter < 120
--- erwartet
TRUE

=== filetime nimmt die sommerzeit vom tag der datei
' Bis 2026.53 rechnete FILETIME mit dem Zeitzonenversatz von HEUTE: eine
' Datei vom Juli stand im Winter eine Stunde zu frueh da (und umgekehrt).
' Zwei Dateien, eine im Winter, eine im Sommer -- eine liegt immer in der
' anderen Jahreshaelfte als der Tag des Laufs.
IMPORT "zeit"
DIM r AS INTEGER
r = SHELL("powershell", "-NoProfile", "-Command", "(Get-Item 'winter.txt').LastWriteTime = [datetime]'2026-01-15 12:00:00'; (Get-Item 'sommer.txt').LastWriteTime = [datetime]'2026-07-15 12:00:00'")
PRINT TIME_TEXT$(FILETIME("winter.txt"))
PRINT TIME_TEXT$(FILETIME("sommer.txt"))
--- datei winter.txt
w
--- datei sommer.txt
s
--- system windows
--- erwartet
2026-01-15 12:00:00
2026-07-15 12:00:00

=== filetime nimmt die sommerzeit vom tag der datei (posix)
IMPORT "zeit"
DIM r AS INTEGER
r = SHELL("touch", "-t", "202601151200", "winter.txt")
r = SHELL("touch", "-t", "202607151200", "sommer.txt")
PRINT TIME_TEXT$(FILETIME("winter.txt"))
PRINT TIME_TEXT$(FILETIME("sommer.txt"))
--- datei winter.txt
w
--- datei sommer.txt
s
--- system posix
--- erwartet
2026-01-15 12:00:00
2026-07-15 12:00:00

=== filetime unterscheidet alt und neu
' Die Grundlage jeder Sicherung: welche Datei ist neuer? Die alte Datei legt
' der Laeufer vor dem Start an, die neue entsteht gut eine Sekunde spaeter.
SLEEP(1100)
WRITEALL("neu.txt", "b")
PRINT FILETIME("neu.txt") > FILETIME("alt.txt")
PRINT FILETIME("alt.txt") > FILETIME("neu.txt")
--- datei alt.txt
a
--- erwartet
TRUE
FALSE

=== filetime meldet die fehlende datei
PRINT FILETIME("gibtsnicht.txt")
--- fehler
gibtsnicht.txt

=== tempdir zeigt auf ein verzeichnis
PRINT DIREXISTS(TEMPDIR$())
--- erwartet
TRUE

=== tempfile ist da, leer, eindeutig und liegt im tempordner
' Angelegt wird sie sofort -- sonst koennte zwischen "Name ausgedacht" und
' "Datei geschrieben" ein zweiter Lauf denselben Namen bekommen.
DIM t AS STRING
t = TEMPFILE$("dhtest", ".txt")
PRINT FILEEXISTS(t)
PRINT FILESIZE(t)
PRINT ENDSWITH(t, ".txt")
PRINT STARTSWITH(t, TEMPDIR$())
DELETEFILE(t)
DIM a AS STRING
DIM b AS STRING
a = TEMPFILE$()
b = TEMPFILE$()
PRINT a <> b
DELETEFILE(a)
DELETEFILE(b)
--- erwartet
TRUE
0
TRUE
TRUE
TRUE

=== samefile und realpath vergleichen dieselbe datei
' Ein Textvergleich irrt bei `/` gegen den Rueckstrich, bei `..` und
' unter Windows bei Gross/klein -- SAMEFILE fragt die Platte.
MKDIR("unter")
PRINT SAMEFILE("b.txt", "unter/../b.txt")
PRINT SAMEFILE("b.txt", CWD$() + "/b.txt")
PRINT SAMEFILE("b.txt", "unter")
' Gibt es die Datei nicht, wird nur bereinigt -- verglichen wird trotzdem.
PRINT SAMEFILE("fehlt.txt", "unter/../fehlt.txt")
DIM r AS STRING : r = REALPATH$("unter/../b.txt")
PRINT RIGHT$(r, 5); " "; INSTR(r, "..") < 0; " "; LEN(r) > LEN("b.txt")
PRINT RIGHT$(REALPATH$("nix/../fehlt.txt"), 9)
--- datei b.txt
b
--- erwartet
TRUE
TRUE
FALSE
TRUE
b.txt TRUE TRUE
fehlt.txt

=== samefile ohne unterschied der schreibweise unter windows
PRINT SAMEFILE("B.TXT", "b.txt")
PRINT SAMEFILE(REPLACE$(REALPATH$("b.txt"), "\", "/"), "b.txt")
--- system windows
--- datei b.txt
b
--- erwartet
TRUE
TRUE

=== dir_user_data legt den ordner fuer die daten des benutzers an
' Windows nimmt APPDATA, macOS HOME/Library/Application Support, sonst
' XDG_DATA_HOME -- alle drei zeigen hier auf einen Ordner der Pruefung.
' Der Ordner entsteht beim ersten Aufruf; ein zweiter laesst ihn, wie er ist.
DIM b AS STRING : b = REPLACE$(CWD$(), CHR$(92), "/") + "/benutzer"
MKDIR(b)
SETENV("APPDATA", b)
SETENV("XDG_DATA_HOME", b)
SETENV("HOME", b)
DIM d AS STRING : d = REPLACE$(DIR_USER_DATA$("Mediathek"), CHR$(92), "/")
PRINT "da "; DIREXISTS(d)
PRINT "unter dem benutzerordner "; LEFT$(d, LEN(b)) = b
DIM rest AS STRING : rest = MID$(d, LEN(b))
IF rest = "/Library/Application Support/Mediathek" THEN rest = "/Mediathek"
PRINT "rest "; rest
WRITEALL(d + "/x.txt", "bleibt")
DIM d2 AS STRING : d2 = REPLACE$(DIR_USER_DATA$(" Mediathek "), CHR$(92), "/")
PRINT "nochmal "; d2 = d; " "; READALL(d + "/x.txt")
--- erwartet
da TRUE
unter dem benutzerordner TRUE
rest /Mediathek
nochmal TRUE bleibt

=== dir_user_data will den namen eines programms, keinen pfad
PRINT DIR_USER_DATA$("../anderswo")
--- fehler
DIR_USER_DATA$: erwartet den Namen des Programms
