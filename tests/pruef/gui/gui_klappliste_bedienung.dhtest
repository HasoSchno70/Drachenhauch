=== beim oeffnen steht die auswahl markiert, enter laesst sie
IMPORT "gui"
SCREEN(300, 400, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 400)
GUI_WINDOW_CHROME(w, FALSE)
DIM namen AS ARRAY OF STRING : namen = []
DIM k AS INTEGER
FOR k = 1 TO 30
    ARRAY_PUSH(namen, "Stadt " + STR$(k))
NEXT
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 10, 10, 190, 28, namen)
GUI_DROPDOWN_SET_SELECTED(dd, 17)
GUI_FOCUS(dd)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT GUI_DROPDOWN_TEXT(dd)
