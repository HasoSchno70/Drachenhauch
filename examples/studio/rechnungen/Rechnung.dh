' Eine Rechnung samt Positionen, wie sie in der Datenbank steht -- laden,
' rechnen, sichern und als PDF ausgeben. Die Fenster kennen nur diese Klasse,
' nicht die Tabellen dahinter.
CLASS Rechnung
    ' -1, solange die Rechnung noch nicht gesichert ist.
    DIM id AS INTEGER
    DIM nummer AS STRING
    DIM kunde AS INTEGER
    DIM datum AS STRING
    DIM texte AS ARRAY OF STRING
    DIM mengen AS ARRAY OF INTEGER
    DIM preise AS ARRAY OF INTEGER
    DIM saetze AS ARRAY OF INTEGER
    ' Warum das letzte Sichern nicht ging.
    DIM fehler AS STRING

    ' Eine neue, leere Rechnung mit der naechsten Nummer und dem Datum von heute.
    SUB neu()
        Self.leeren()
        Self.id = -1
        Self.nummer = naechsteNummer$()
        Self.kunde = -1
        Self.datum = DATE$()
    END SUB

    SUB leeren()
        Self.texte = []
        Self.mengen = []
        Self.preise = []
        Self.saetze = []
    END SUB

    FUNCTION laden(rid AS INTEGER) AS BOOLEAN
        DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT nummer, kunde, datum FROM rechnungen WHERE id = ?", rid)
        IF NOT DB_NEXT(r) THEN RETURN FALSE
        Self.leeren()
        Self.id = rid
        Self.nummer = DB_GET_STRING(r, 0)
        Self.kunde = DB_GET_INT(r, 1)
        Self.datum = DB_GET_STRING(r, 2)
        DIM q AS DB_RESULT : q = DB_QUERY(db, "SELECT bezeichnung, menge, preis, mwst FROM positionen WHERE rechnung = ? ORDER BY id", rid)
        WHILE DB_NEXT(q)
            Self.anhaengen(DB_GET_STRING(q, 0), DB_GET_INT(q, 1), DB_GET_INT(q, 2), DB_GET_INT(q, 3))
        WEND
        RETURN TRUE
    END FUNCTION

    SUB anhaengen(text AS STRING, menge AS INTEGER, preis AS INTEGER, satz AS INTEGER)
        ARRAY_PUSH(Self.texte, text)
        ARRAY_PUSH(Self.mengen, menge)
        ARRAY_PUSH(Self.preise, preis)
        ARRAY_PUSH(Self.saetze, satz)
    END SUB

    ' Eine Position dazu; steht dieselbe zum selben Preis schon da, waechst
    ' ihre Menge, statt dass sie zweimal auf der Rechnung steht.
    SUB dazu(text AS STRING, menge AS INTEGER, preis AS INTEGER, satz AS INTEGER)
        DIM i AS INTEGER
        FOR i = 0 TO LEN(Self.texte) - 1
            IF Self.texte[i] = text AND Self.preise[i] = preis AND Self.saetze[i] = satz THEN
                Self.mengen[i] = Self.mengen[i] + menge
                RETURN
            END IF
        NEXT
        Self.anhaengen(text, menge, preis, satz)
    END SUB

    ' Einen Artikel aus der Datenbank als Position dazu.
    FUNCTION artikelDazu(aid AS INTEGER, menge AS INTEGER) AS BOOLEAN
        DIM r AS DB_RESULT : r = DB_QUERY(db, "SELECT bezeichnung, preis, mwst FROM artikel WHERE id = ?", aid)
        IF NOT DB_NEXT(r) THEN RETURN FALSE
        Self.dazu(DB_GET_STRING(r, 0), menge, DB_GET_INT(r, 1), DB_GET_INT(r, 2))
        RETURN TRUE
    END FUNCTION

    SUB entfernen(i AS INTEGER)
        IF i < 0 OR i >= LEN(Self.texte) THEN RETURN
        ARRAY_REMOVE_AT(Self.texte, i)
        ARRAY_REMOVE_AT(Self.mengen, i)
        ARRAY_REMOVE_AT(Self.preise, i)
        ARRAY_REMOVE_AT(Self.saetze, i)
    END SUB

    FUNCTION anzahl() AS INTEGER
        RETURN LEN(Self.texte)
    END FUNCTION

    ' Netto einer Position in Cent.
    FUNCTION summe(i AS INTEGER) AS INTEGER
        RETURN Self.mengen[i] * Self.preise[i]
    END FUNCTION

    ' Die Steuer einer Position, auf den Cent gerundet. Gerundet wird je
    ' Position, nicht erst die Summe -- so steht es auf jeder Zeile richtig.
    FUNCTION steuerVon(i AS INTEGER) AS INTEGER
        RETURN (Self.summe(i) * Self.saetze[i] + 50) \ 100
    END FUNCTION

    FUNCTION netto() AS INTEGER
        DIM s AS INTEGER : s = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(Self.texte) - 1
            s = s + Self.summe(i)
        NEXT
        RETURN s
    END FUNCTION

    FUNCTION steuer() AS INTEGER
        DIM s AS INTEGER : s = 0
        DIM i AS INTEGER
        FOR i = 0 TO LEN(Self.texte) - 1
            s = s + Self.steuerVon(i)
        NEXT
        RETURN s
    END FUNCTION

    FUNCTION brutto() AS INTEGER
        RETURN Self.netto() + Self.steuer()
    END FUNCTION

    ' Schreibt Kopf und Positionen in EINER Transaktion: entweder steht die
    ' ganze Rechnung in der Datenbank oder gar nichts von ihr.
    FUNCTION speichern() AS BOOLEAN
        DIM warNeu AS BOOLEAN : warNeu = Self.id < 0
        DIM ok AS BOOLEAN : ok = TRUE
        Self.fehler = ""
        DB_BEGIN(db)
        TRY
            IF warNeu THEN
                DB_EXEC(db, "INSERT INTO rechnungen (nummer, kunde, datum) VALUES (?, ?, ?)", Self.nummer, Self.kunde, Self.datum)
                Self.id = DB_LAST_ROWID(db)
            ELSE
                DB_EXEC(db, "UPDATE rechnungen SET kunde = ?, datum = ? WHERE id = ?", Self.kunde, Self.datum, Self.id)
                DB_EXEC(db, "DELETE FROM positionen WHERE rechnung = ?", Self.id)
            END IF
            DIM i AS INTEGER
            FOR i = 0 TO LEN(Self.texte) - 1
                DB_EXEC(db, "INSERT INTO positionen (rechnung, bezeichnung, menge, preis, mwst) VALUES (?, ?, ?, ?, ?)", Self.id, Self.texte[i], Self.mengen[i], Self.preise[i], Self.saetze[i])
            NEXT
            DB_COMMIT(db)
        CATCH grund
            DB_ROLLBACK(db)
            IF warNeu THEN Self.id = -1
            Self.fehler = grund
            ok = FALSE
        END TRY
        RETURN ok
    END FUNCTION

    ' Die Rechnung als PDF: gesetzt vom Bericht Rechnungsbeleg aus der
    ' Datenbank -- die Rechnung muss also gesichert sein. Seitenkopf,
    ' Umbruch und die Steuer je Satz stehen dort, nicht hier.
    SUB alsPdf(pfad AS STRING)
        Rechnungsbeleg.Pdf(pfad, {"id": Self.id})
    END SUB

    ' Dieselbe Rechnung im Vorschaufenster, mit Blaettern und Drucken.
    SUB zeigen()
        Rechnungsbeleg.Vorschau({"id": Self.id})
    END SUB
END CLASS
