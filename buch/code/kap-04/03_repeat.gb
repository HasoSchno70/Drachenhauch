' REPEAT/UNTIL: Post-Test-Schleife.
'
' Body laeuft mindestens einmal, Bedingung wird AM ENDE geprueft. Hier
' wuerfeln wir, bis eine 6 faellt - das soll auch passieren wenn beim
' ersten Wurf gleich eine 6 kommt.

DIM wurf    AS INTEGER
DIM zaehler AS INTEGER
zaehler = 0

RANDOMIZE(42)               ' fester Seed -> reproduzierbare Wuerfe

REPEAT
    wurf = INT(RND() * 6) + 1
    zaehler += 1
    PRINT f"Wurf {zaehler}: {wurf}"
UNTIL wurf = 6

PRINT f"Insgesamt {zaehler} Wuerfe bis zur ersten 6."
