=== echt: ablaufende verwerten, im internet suchen, waehlen, importieren
' Reiter Rezepte, "Ablaufende verwerten", dort "Im Internet suchen": die
' Rezeptsuche geht modal auf und sucht gleich nach den Zutaten; ein Klick
' auf den Treffer laedt die Einzelheiten, "Rezept importieren" legt es an,
' ESC schliesst. Zwei modale Fenster nacheinander, das Netz im Takt.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
kProbe(p, "mess.dh", "", 10)
DIM w AS ARRAY OF STRING : w = SPLIT(TRIM$(READALL(p + "/_studio/lage.txt")), " ")
FUNCTION z(i AS INTEGER) AS INTEGER
    RETURN INT(VAL(w[i]))
END FUNCTION
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slKlick(z(0), z(1))
slWarten(10)
slKlick(z(2), z(3))
slWarten(20)
slKlick(z(4), z(5))
slWarten(60)
slKlick(z(6), z(7))
slWarten(60)
slKlick(z(8), z(9))
slWarten(20)
slTaste(256)
slWarten(20)
slAufnahmeSchreiben(p + "/_studio/klick.txt")
DIM srv AS INTEGER : srv = kNetzStarten(ARG$(2))
kSchluessel = "testschluessel"
PRINT "code "; kProbe(p, "klick.dh", "klick.txt", slBild + 20)
kOffEnde(srv)
PRINT "anfragen "; kOffAnfragen$()
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
{sammlung}/../_hilfen/spoon_server.dh
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei daten.dh
' Messlauf und Abspiellauf teilen die Datei: jedes Mal frisch.
DB_EXEC(db, "DELETE FROM recipe_ingredients")
DB_EXEC(db, "DELETE FROM recipes")
DB_EXEC(db, "DELETE FROM inventory")
DB_EXEC(db, "DELETE FROM products")
DB_EXEC(db, "INSERT INTO recipes (name, servings) VALUES ('Toast', 1)")
DB_EXEC(db, "INSERT INTO recipe_ingredients (recipe_id, product_name, quantity, unit) VALUES (1, 'Brot', 2, 'Scheiben')")
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Sriracha')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 1, 'Flasche', '2026-11-09')")
DIM f AS Hauptfenster : f = studioStartFenster
DIM s AS RezepteSeite : s = f.rezepte
f.geaendert()
--- datei mess.dh
IMPORT "../../daten.dh"
GUI_TABCONTROL_SET_PAGE(f.reiter, 4)
DIM n AS INTEGER
WHILE n < 4 AND studioBild()
    n = n + 1
WEND
DIM t AS INTEGER : t = GUI_METRIC_GET("title_h")
DIM rx AS INTEGER, ry AS INTEGER, rw AS INTEGER, rh AS INTEGER
(rx, ry, rw, rh) = GUI_TABCONTROL_ITEM_RECT(f.reiter, 4)
DIM vf AS VorschlagFenster : vf = NEW VorschlagFenster()
vf.art = "ablauf"
vf.Zeigen()
DIM vx AS INTEGER : vx = GUI_WINDOW_GET_X(vf.Fenster())
DIM vy AS INTEGER : vy = GUI_WINDOW_GET_Y(vf.Fenster()) + t
vf.Zumachen()
DIM kf AS KatalogFenster : kf = NEW KatalogFenster()
kf.Zeigen()
DIM kx AS INTEGER : kx = GUI_WINDOW_GET_X(kf.Fenster())
DIM ky AS INTEGER : ky = GUI_WINDOW_GET_Y(kf.Fenster()) + t
WRITEALL("lage.txt", STR$(rx + rw \ 2) + " " + STR$(ry + rh \ 2) + " " + _
    STR$(GUI_GET_X(s.knopfAblauf) + GUI_GET_W(s.knopfAblauf) \ 2) + " " + STR$(GUI_GET_Y(s.knopfAblauf) + 26 + GUI_GET_H(s.knopfAblauf) \ 2) + " " + _
    STR$(vx + GUI_GET_X(vf.knopfInternet) + GUI_GET_W(vf.knopfInternet) \ 2) + " " + STR$(vy + GUI_GET_Y(vf.knopfInternet) + GUI_GET_H(vf.knopfInternet) \ 2) + " " + _
    STR$(kx + GUI_GET_X(kf.tabelle) + 120) + " " + STR$(ky + GUI_GET_Y(kf.tabelle) + INT(GUI_TABLE_GET(kf.tabelle, "kopfhoehe")) + INT(GUI_TABLE_GET(kf.tabelle, "zeilenhoehe")) \ 2) + " " + _
    STR$(kx + GUI_GET_X(kf.knopfImport) + GUI_GET_W(kf.knopfImport) \ 2) + " " + STR$(ky + GUI_GET_Y(kf.knopfImport) + GUI_GET_H(kf.knopfImport) \ 2))
--- datei klick.dh
IMPORT "../../daten.dh"
FUNCTION stand$() AS STRING
    RETURN JOIN$(textListe("SELECT r.name || ':' || (SELECT GROUP_CONCAT(product_name || ' ' || quantity || ' ' || unit) FROM recipe_ingredients WHERE recipe_id = r.id) FROM recipes r ORDER BY r.id"), " ") + " / Seite " + STR$(GUI_TABCONTROL_PAGE(f.reiter)) + " / Liste " + STR$(GUI_TABLE_ROW_COUNT(s.tabelle))
END FUNCTION
DIM folge AS ARRAY OF STRING : folge = []
DIM war AS STRING : war = ""
WHILE studioBild()
    DIM jetzt AS STRING : jetzt = stand$()
    IF jetzt <> war THEN ARRAY_PUSH(folge, jetzt)
    war = jetzt
WEND
PRINT JOIN$(folge, " -> ")
--- erwartet
