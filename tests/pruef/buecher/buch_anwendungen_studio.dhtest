WRITEALL(ha, REPLACE$(hat, "        Self.ausleihe.haupt = Self", "        Self.ausleihe.haupt = Self" + CHR$(10) + "        GUI_SET_TEXT(Self.feldSuche, " + q$("Game") + ") : Self.Neuladen()"))
PRINT "game "; zeile$(bedienen$(ma, [], 20), "table#tabelle")
WRITEALL(ha, REPLACE$(hat, "        Self.ausleihe.haupt = Self", "        Self.ausleihe.haupt = Self" + CHR$(10) + "        GUI_SET_TEXT(Self.feldSuche, " + q$("Spiel") + ") : Self.Neuladen()"))
PRINT "spiel "; zeile$(bedienen$(ma, [], 20), "table#tabelle")
