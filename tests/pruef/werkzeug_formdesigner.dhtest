=== die palette kennt jede art der laufzeit
' Der Designer bot 25 Arten an, die Laufzeit kann 30 -- dieselbe Drift, die
' der Qt-Designer 2026-08-31 hatte. Gemessen an Kind::from_str in gui.rs.
DIM Q AS STRING : Q = CHR$(34)
DIM arten AS ARRAY OF STRING : arten = []
DIM teile AS ARRAY OF STRING
DIM k AS INTEGER
DIM zeile AS STRING
DIM drin AS BOOLEAN : drin = FALSE
FOR EACH zeile IN READLINES(ARG$(0))
    IF "fn from_str(s: &str) -> Option<Kind>" IN zeile THEN drin = TRUE
    IF drin AND "_ => return None" IN zeile THEN drin = FALSE
    IF drin THEN
        teile = SPLIT$(zeile, Q)
        FOR k = 1 TO LEN(teile) - 2 STEP 2
            IF LEFT$(TRIM$(teile[k + 1]), 8) = "=> Kind:" THEN ARRAY_PUSH(arten, teile[k])
        NEXT
    END IF
NEXT
DIM palette AS ARRAY OF STRING : palette = []
FOR EACH zeile IN READLINES(ARG$(1))
    IF LEFT$(zeile, 9) = "palette(" + Q THEN
        teile = SPLIT$(zeile, Q)
        ARRAY_PUSH(palette, teile[1])
    END IF
NEXT
DIM fehlen AS STRING : fehlen = ""
DIM a AS STRING
FOR EACH a IN arten
    IF ARRAY_INDEXOF(palette, a) < 0 THEN fehlen = fehlen + " " + a
NEXT
PRINT "arten " + STR$(LEN(arten))
PRINT "fehlen[" + fehlen + "]"
PRINT "gitter " + STR$(ARRAY_INDEXOF(palette, "grid") >= 0)
--- argumente
{sammlung}/../../rust/drachenhauch_runtime/src/gui.rs
{sammlung}/../../examples/197_form_designer.dh
--- erwartet
arten 33
fehlen[]
gitter TRUE

=== entwurfsmodus nimmt den widgets die eingabe
' GUI_WINDOW_DESIGN: ein Klick auf den Knopf loest NICHTS aus, GUI_HIT_TEST
' findet ihn trotzdem. Gegenprobe im naechsten Fall.
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("T", 0, 0, 300, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "Ok", 20, 20, 100, 30)
GUI_WINDOW_DESIGN(w, TRUE)
DIM f AS INTEGER
DIM traf AS BOOLEAN : traf = FALSE
FOR f = 1 TO 8
    GUI_UPDATE()
    IF GUI_CLICKED(b) THEN traf = TRUE
    CLS(0) : GUI_DRAW() : FLIP()
NEXT
PRINT traf ; " " ; GUI_HIT_TEST(60, 35) = b
--- datei ev.txt
c 4
e 2 7 60 35 0 0
e 3 7 60 35 0 0
e 3 6 0 0 0 0
e 5 5 0 0 0 0

--- umgebung
DHRT_FRAMES=10
--- erwartet
FALSE TRUE

