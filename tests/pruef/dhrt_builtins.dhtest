' Befehle, die nur dhrt kennt: Feld-Aggregate und dynamische Felder, Zeichenketten,
' funktions-lokale Plaetze, Dateien, SORT mit Vergleichsfunktion, FLT, NUMFMT$.
' Bis Stufe 50 (2026-09-14) tests/test_dhrt_builtins.py; erzeugt wie
' sprach_erweiterungen.dhtest. Format: docs/werkzeuge.md, dhrt test.

=== array sum avg min max int
DIM a[3] AS INTEGER
a[0]=5 : a[1]=9 : a[2]=1
PRINT ARRAY_SUM(a), ARRAY_AVG(a), ARRAY_MIN(a), ARRAY_MAX(a)
--- erwartet
15 5.0 1 9

=== array aggregate float
DIM f[3] AS FLOAT
f[0]=1.5 : f[1]=2.5 : f[2]=4.0
PRINT ARRAY_SUM(f), ARRAY_MIN(f), ARRAY_MAX(f)
PRINT ARRAY_AVG(f)
--- erwartet
8.0 1.5 4.0
2.6666666666666665

=== array fill coerces int to float
DIM b[3] AS INTEGER
ARRAY_FILL(b, 7)
PRINT b[0], b[1], b[2]
DIM f[2] AS FLOAT
ARRAY_FILL(f, 9)
PRINT f[0], f[1]
--- erwartet
7 7 7
9.0 9.0

=== array copy is independent
DIM a[3] AS INTEGER
a[0]=5 : a[1]=9 : a[2]=1
DIM c AS ARRAY OF INTEGER
c = ARRAY_COPY(a)
c[0] = 100
PRINT a[0], c[0]
--- erwartet
5 100

