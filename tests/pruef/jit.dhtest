=== methode ruft methode eines anderen objekts
CLASS Rad
    DIM umdrehungen AS INTEGER
    SUB drehen(n AS INTEGER)
        Self.umdrehungen = Self.umdrehungen + n
    END SUB
END CLASS
CLASS Auto
    DIM vorne AS Rad
    DIM hinten AS Rad
    DIM km AS INTEGER
    SUB fahren(n AS INTEGER)
        Self.vorne.drehen(n)
        Self.hinten.drehen(n * 2)
        Self.km = Self.km + n
    END SUB
END CLASS
DIM a AS Auto : a = NEW Auto()
a.vorne = NEW Rad()
a.hinten = NEW Rad()
DIM i AS INTEGER
FOR i = 1 TO 10
    a.fahren(i)
NEXT
PRINT a.km; " "; a.vorne.umdrehungen; " "; a.hinten.umdrehungen
--- umgebung
DHRT_JIT=aus
--- erwartet
55 55 110

