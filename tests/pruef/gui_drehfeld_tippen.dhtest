=== komma wie punkt, ganzzahlig bleibt ganz
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM komma AS GUI_WIDGET
komma = GUI_SPINNER(w, 10, 10, 120, 0, 10, 1, 0.5)
DIM ganz AS GUI_WIDGET
ganz = GUI_SPINNER(w, 10, 50, 120, 0, 10, 1, 1)
GUI_FOCUS(komma)
CLIPBOARD_SET("2,5")
DIM f AS INTEGER
FOR f = 1 TO 20
    GUI_UPDATE()
    IF f = 7 THEN
        PRINT GUI_VALUE(komma)
        GUI_FOCUS(ganz)
        CLIPBOARD_SET("7,6")
    END IF
    IF f = 16 THEN PRINT GUI_VALUE(ganz)
    GUI_DRAW()
    FLIP()
NEXT
