=== text vergleichen und sortieren
DIM w AS STRING : w = "zebra"
DIM k AS STRING : k = "zebra"
DIM i AS INTEGER
DIM z AS INTEGER
DIM s AS STRING
FOR i = 0 TO 25
    s = CHR$(97 + i) + "x"
    IF s < w THEN z = z + 1
    IF s <> k THEN z = z + 100
    IF s >= "mx" THEN k = s
    IF s < "mx" THEN z = z + 10000
NEXT
