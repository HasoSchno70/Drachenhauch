=== anlegen von hand, verknuepfen, loeschen und wieder holen
' Eine Zutat, die genau wie ein Produkt im Bestand heisst, wird verknuepft.
' Loeschen merkt erst die Zutaten, dann das Rezept: Rueckgaengig setzt
' beides mit denselben ids wieder ein (Fremdschluessel an).
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
SETENV("KUEHL_HEUTE", "2026-11-08")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slTaste(257)
slAufnahmeSchreiben(p + "/_studio/enter.txt")
PRINT "code "; kProbe(p, "probe.dh", "enter.txt", 60)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
DB_EXEC(db, "INSERT INTO products (name) VALUES ('Nudeln'), ('Tomaten')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit) VALUES (1, 500, 'g'), (2, 4, 'Stück')")
DB_EXEC(db, "INSERT INTO inventory (product_id, quantity, unit, expiry_date) VALUES (1, 200, 'g', '2026-11-10')")
DIM f AS Hauptfenster : f = studioStartFenster
f.geaendert()
FUNCTION stand$() AS STRING
    RETURN JOIN$(textListe("SELECT id || ':' || name || ':' || IFNULL(description, '-') || ':' || servings || ':' || IFNULL(prep_time_minutes, '-') FROM recipes ORDER BY id"), " ") + " | " + _
        JOIN$(textListe("SELECT id || ':' || recipe_id || ':' || product_name || ':' || quantity || ':' || unit || ':' || IFNULL(product_id, '-') FROM recipe_ingredients ORDER BY id"), " ")
END FUNCTION
DIM nf AS RezeptNeuFenster : nf = NEW RezeptNeuFenster()
nf.Zeigen()
' Ohne Namen: Meldung (Enter), nichts gesichert.
nf.knopfSpeichern_Klick()
PRINT "ohne namen "; nf.gesichert
GUI_SET_TEXT(nf.nameFeld, "Nudeln mit Soße")
GUI_SET_TEXT(nf.beschreibungFeld, "Für zwei")
GUI_SET_VALUE(nf.portionenFeld, 2)
GUI_SET_VALUE(nf.vorbFeld, 10)
GUI_SET_TEXT(nf.zutatFeld, "Nudeln")
GUI_SET_VALUE(nf.mengeFeld, 250)
GUI_SET_TEXT(nf.einheitListe, "g")
nf.knopfZutat_Klick()
GUI_SET_TEXT(nf.zutatFeld, "Basilikum")
nf.knopfZutat_Klick()
GUI_SET_TEXT(nf.zutatFeld, "tomaten")
GUI_SET_VALUE(nf.mengeFeld, 3)
GUI_SET_TEXT(nf.einheitListe, "Stück")
nf.knopfZutat_Klick()
PRINT "zutaten "; GUI_TABLE_ROW_COUNT(nf.tabelle); " | "; GUI_TABLE_GET_CELL(nf.tabelle, 0, 3); " "; GUI_TABLE_GET_CELL(nf.tabelle, 1, 3); " "; GUI_TABLE_GET_CELL(nf.tabelle, 2, 3); " | "; GUI_TEXT(nf.info)
nf.tabelle_Zelle(1, 4)
GUI_SET_TEXT(nf.anleitungFeld, "Kochen.")
nf.knopfSpeichern_Klick()
PRINT "gesichert "; nf.gesichert; " | "; stand$()
' Verknuepft: ueber das Produkt, was zuerst ablaeuft zuerst.
PRINT "gekocht "; JOIN$(kochen(rezeptLaden(1), 1.0), ", "); " | "; JOIN$(textListe("SELECT id || ':' || quantity FROM inventory ORDER BY id"), " ")
PRINT "zurueck "; verlauf.rueckgaengig$(); " | "; JOIN$(textListe("SELECT id || ':' || quantity FROM inventory ORDER BY id"), " ")
rezeptLoeschen(1, "Nudeln mit Soße")
PRINT "geloescht ["; stand$(); "] | "; verlauf.textZurueck$()
f.miRueckgaengig_Aktion()
PRINT "zurueck "; stand$()
f.miWiederholen_Aktion()
PRINT "wieder ["; stand$(); "]"
f.miRueckgaengig_Aktion()
f.miRueckgaengig_Aktion()
PRINT "angelegt zurueck ["; stand$(); "]"
--- erwartet
ohne namen FALSE
zutaten 3 | ✅ Ja ➖ Nein ✅ Ja | ✅ 3 Zutat(en) -- bereit zum Speichern
gesichert TRUE | 1:Nudeln mit Soße:Für zwei:2:10 | 1:1:Nudeln:250.0:g:1 2:1:tomaten:3.0:Stück:2
gekocht 250 g Nudeln, 3 Stück tomaten | 1:450.0 2:1.0
zurueck Nudeln mit Soße gekocht | 1:500.0 2:4.0 3:200.0
geloescht [ | ] | Nudeln mit Soße gelöscht
zurueck 1:Nudeln mit Soße:Für zwei:2:10 | 1:1:Nudeln:250.0:g:1 2:1:tomaten:3.0:Stück:2
wieder [ | ]
angelegt zurueck [ | ]
