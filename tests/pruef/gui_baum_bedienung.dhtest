=== der rollbalken laesst sich ziehen
' 30 Knoten: rollen kann der Baum 30 * 22 - 198 = 462. Griff bei x 281..288;
' nach unten gezogen trifft ein Klick in die erste Zeile (y 12) Knoten
' (1 + 462) / 22 = 21.
IMPORT "gui"
SCREEN(300, 450, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 450)
GUI_WINDOW_CHROME(w, FALSE)
DIM t AS GUI_WIDGET : t = GUI_TREE(w, 10, 10, 280, 200)
DIM k AS INTEGER
FOR k = 0 TO 29
    GUI_TREE_ADD(t, -1, "Knoten " + STR$(k))
NEXT
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
PRINT "gewaehlt "; GUI_TREE_LABEL(t, GUI_TREE_SELECTED(t))
