' Kuehlschrank-App im Drachenhauch Studio, Stufe 4: die Rezepte
' (examples/studio/kuehlschrank: RezepteSeite, RezeptFenster, KochenFenster,
' RezeptNeuFenster, KatalogFenster, VorschlagFenster, Module Rezepte und
' Rezeptkatalog, Klassen Rezept und Zutat). Proben wie in den Stufen davor:
' F5 im Studio, dann main.dh mit einer Probe statt der Bildschleife; Heute
' ist fest.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== katalogsuche wie die python-app, zutaten nach woertern
' Die Punkte der Suche wie LocalRecipeSearch (nachgerechnet mit difflib auf
' denselben 29 Rezepten). Zutat und Produkt passen, wenn jedes Wort des
' kuerzeren im laengeren steht, gleich oder mit Plural-Endung -- die
' Python-App fand mit Teilzeichenketten "Reis" fuer "Ei".
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("KUEHL_HEUTE", "2026-11-08")
PRINT "code "; kProbe(p, "probe.dh", "", 5)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe.dh
PRINT "katalog "; LEN(katalog())
DIM q AS STRING
FOR EACH q IN ["kartoffel", "Schnitzel", "suppe", "rahm", "dessert", "ei", "käsespatzle", "wiener schnitzel"]
    DIM t AS ARRAY OF STRING : t = []
    DIM x AS Rezept
    FOR EACH x IN katalogSuchen(q)
        ARRAY_PUSH(t, x.name + " " + FORMAT$(katalogPunkte(LOWER$(TRIM$(q)), x), "%.2f"))
    NEXT
    PRINT q; " -> "; JOIN$(t, " / ")
NEXT
DIM paar AS STRING
FOR EACH paar IN ["Ei|Reis", "Ei|Ei", "Zwiebel|Zwiebeln", "Kartoffeln festkochend|Kartoffeln", "Mehl|Kartoffeln mehlig", "Emmentaler gerieben|Emmentaler", "Butter|Butterschmalz", "Milch|Milch 3,5 %", "Ei|Eis"]
    DIM f AS ARRAY OF STRING : f = SPLIT(paar, "|")
    PRINT "passt "; paar; " "; namePasst(f[0], f[1])
NEXT
' Bei gleich langen Bloecken der frueheste, wie difflib (salat/atlas: 0,6).
FOR EACH paar IN ["salat|atlas", "strudel|rudelst", "rahm|rahmschnitzel"]
    f = SPLIT(paar, "|")
    PRINT "aehnlich "; paar; " "; FORMAT$(aehnlichkeit(f[0], f[1]), "%.4f")
NEXT
' Der Import nimmt die Beschreibung mit (die Python-App liess sie fallen).
DIM kf AS KatalogFenster : kf = NEW KatalogFenster()
kf.Zeigen()
PRINT "import an "; GUI_ENABLED(kf.knopfImport)
GUI_SET_TEXT(kf.sucheFeld, "grütze")
kf.sucheFeld_Enter()
PRINT GUI_TEXT(kf.ergebnis); " | import an "; GUI_ENABLED(kf.knopfImport); " | "; SPLIT$(GUI_TEXT(kf.details), CHR$(10))[0]
kf.knopfImport_Klick()
PRINT "importiert "; kf.importiert; " | "; JOIN$(textListe("SELECT name || ':' || IFNULL(description, '-') || ':' || servings || ':' || IFNULL(prep_time_minutes, 0) || ':' || IFNULL(cook_time_minutes, 0) || ':' || (SELECT COUNT(*) FROM recipe_ingredients WHERE recipe_id = recipes.id) FROM recipes WHERE name = 'Rote Grütze'"), " ")
PRINT "zurueck "; verlauf.rueckgaengig$(); " | "; JOIN$(textListe("SELECT name FROM recipes WHERE name = 'Rote Grütze'"), " ")
--- erwartet
