' Farbfelder im Textbereich (GUI_TEXTAREA_SWATCHES + SWATCH_CLICKED).
' Format: docs/werkzeuge.md, dhrt test.
--- seriell

=== ein farbfeld steht hinter seinem stueck (Bild)
' Der Beleg, dass wirklich gezeichnet wird: das Quadrat liegt am ENDE der
' Zeile, in seiner Farbe -- direkt hinter dem Stueck laege es auf dem
' naechsten Zeichen. Gegenprobe: ueber dem Wort steht es nicht.
IMPORT "gui"
SCREEN(400, 200, "F", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("F", 0, 0, 400, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM ta AS GUI_WIDGET
ta = GUI_TEXTAREA(w, 0, 0, 400, 200)
GUI_SET_TEXT(ta, "rot")
GUI_TEXTAREA_SWATCHES(ta, [0], [3], [&HFF0000])
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(&H000000)
    GUI_DRAW()
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=3
--- bild
groesse 400 200
54 17 #FF0000 +-30
20 17 nicht #FF0000 +-30

