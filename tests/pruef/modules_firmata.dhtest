=== schrittmotor ueber accelstepperfirmata
IMPORT "board.dh"
fbStart()
FIRMATA_STEPPER_CONFIG(fbH, 0, "treiber", 2, 3)
PRINT "einrichten: " + fbEmpfangen$()
FIRMATA_STEPPER_SPEED(fbH, 0, 400.0)
FIRMATA_STEPPER_ACCEL(fbH, 0, 0.0)
PRINT "tempo: " + fbEmpfangen$()
FIRMATA_STEPPER_MOVE(fbH, 0, 200)
PRINT "fahren: " + fbEmpfangen$()
PRINT FIRMATA_STEPPER_RUNNING(fbH, 0)
' Das Board meldet "fertig" bei 200.
fbSenden("F0 62 0A 00 48 01 00 00 00 F7")
SLEEP(30)
FIRMATA_UPDATE(fbH)
PRINT FIRMATA_STEPPER_RUNNING(fbH, 0)
PRINT FIRMATA_STEPPER_POSITION(fbH, 0)
PRINT "lage: " + fbEmpfangen$()
FIRMATA_STEPPER_TO(fbH, 0, -50)
PRINT "ziel: " + fbEmpfangen$()
' Eine Lagemeldung unterwegs, dann anhalten.
fbSenden("F0 62 06 00 05 00 00 00 08 F7")
SLEEP(30)
FIRMATA_UPDATE(fbH)
PRINT FIRMATA_STEPPER_POSITION(fbH, 0)
FIRMATA_STEPPER_STOP(fbH, 0)
FIRMATA_STEPPER_ZERO(fbH, 0)
PRINT FIRMATA_STEPPER_RUNNING(fbH, 0)
PRINT "halt: " + fbEmpfangen$()
FIRMATA_STEPPER_CONFIG(fbH, 1, "vierdraht", 8, 9, 10, 11)
PRINT "vier: " + fbEmpfangen$()
--- datei board.dh
IMPORT "{sammlung}/_hilfen/firmataboard.dh"

--- erwartet
einrichten: F0 62 00 00 10 02 03 F7
tempo: F0 62 09 00 00 12 74 1D F7 F0 62 08 00 00 00 00 00 F7
fahren: F0 62 02 00 48 01 00 00 00 F7
