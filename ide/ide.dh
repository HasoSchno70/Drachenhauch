DIM dlgAusgabeSuche AS GUI_WINDOW : dlgAusgabeSuche = 0
DIM ausgabeSuchtext AS STRING : ausgabeSuchtext = ""

SUB protokoll(text AS STRING)
    IF logDatei = "" THEN RETURN
    DIM f AS FILE
    f = OPENFILE(logDatei, "a")
    WRITELINE(f, text)
    CLOSEFILE(f)
END SUB

' --- Hauptfenster ------------------------------------------------------
DIM win AS GUI_WINDOW
' `massstab` in der ide.json: fest (0.5 .. 4.0); fehlt er oder ist er 0,
' gilt die Skalierung des Systems (WINDOW_DPI_X), auf eine Viertelstufe
' gerundet -- 1,0 heisst: wie bisher.
DIM massWunsch AS FLOAT : massWunsch = 0.0
IF JSON_HAS(konfig, "massstab") THEN
    IF JSON_TYPE(konfig, "massstab") = "number" THEN massWunsch = JSON_GET_FLOAT(konfig, "massstab") ELSE konfigFalsch("massstab")
END IF
massEinst = massWunsch
IF massWunsch <= 0.0 THEN massWunsch = INT(WINDOW_DPI_X() * 4.0 + 0.5) / 4.0
massWunsch = MAX(0.5, MIN(4.0, massWunsch))
IF ABS(massWunsch - 1.0) > 0.01 THEN
    TRY
        GUI_SCALE(massWunsch)
        uiMassstab = massWunsch
    CATCH massFehler
        uiMassstab = 1.0
    END TRY
END IF
win = GUI_WINDOW(tr$("Drachenhauch"), 0, 0, schirmB(), schirmH())
' Jeder Reiter bekommt ein Kreuz -- ohne das war ein Reiter mit der MAUS
' gar nicht zu schliessen, nur mit Strg+W. Die mittlere Taste tut es auch.
GUI_TABS_CLOSABLE(win, TRUE)
GUI_WINDOW_CHROME(win, FALSE)
GUI_WINDOW_MOVABLE(win, FALSE)
' Die Leisten stehen in einem Dock (seit 2026-10-24): links Projekt und
' Gliederung, unten Ausgabe|Terminal und Probleme|Debugger als Reiter. Am
' Reiter laesst sich jede Leiste in einen anderen Bereich ziehen oder
' abtrennen; die Anordnung steht in der ide.json (`dock`). Das Rechteck
' setzt layout(), die Inhalte verteilt layoutLeisten -- die Widgets kommen
' weiter unten dazu (GUI_DOCK_ADD), wenn es sie gibt.
GUI_DOCK(win, 0, 0, schirmB(), schirmH())
GUI_DOCK_PANEL(win, "projekt", tr$("Projekt"), "links")
GUI_DOCK_PANEL(win, "gliederung", tr$("Gliederung"), "links")
GUI_DOCK_PANEL(win, "ausgabe", tr$("Ausgabe"), "unten")
GUI_DOCK_TAB(win, "terminal", tr$("Terminal"), "ausgabe")
GUI_DOCK_TAB(win, "seriell", tr$("Seriell"), "ausgabe")
GUI_DOCK_PANEL(win, "probleme", tr$("Probleme"), "unten")
GUI_DOCK_TAB(win, "debugger", tr$("Debugger"), "probleme")
GUI_DOCK_SHOW(win, "debugger", FALSE)
GUI_DOCK_SIZE(win, "links", 220)
GUI_DOCK_SIZE(win, "unten", 202)
GUI_DOCK_SHARE(win, "projekt", 3)
GUI_DOCK_SHARE(win, "gliederung", 2)
' Die Vorgabe, fuer "Leisten zuruecksetzen".
DIM dockVorgabe AS STRING : dockVorgabe = GUI_DOCK_STATE$(win)
IF JSON_HAS(konfig, "dock") THEN
    TRY
        GUI_DOCK_SET_STATE(win, JSON_STRINGIFY(JSON_GET_JSON(konfig, "dock")))
    CATCH dockFehler
        konfigFalsch("dock")
    END TRY
END IF

