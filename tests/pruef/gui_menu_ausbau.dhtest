=== unbekannte taste ist ein fehler
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
TRY
    GUI_MENU_ITEM(m, "x", "Hyper+Q")
CATCH e
    PRINT e
END TRY
TRY
    GUI_MENU_ITEM(m, "y", "Strg+")
CATCH e2
    PRINT e2
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
GUI_MENU_ITEM: Tastenkuerzel 'Hyper+Q': Taste 'Hyper' unbekannt -- Buchstabe, Ziffer, F1..F12, Entf, Einfg, Pos1, Ende, Bild auf/ab, Leer, Enter, Esc, Tab, Rueck, Links/Rechts/Hoch/Runter
GUI_MENU_ITEM: Tastenkuerzel 'Strg+': keine Taste angegeben

