=== nachbar: jeder schritt zum naechsten offenen stich, gleichstand oben und links
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden(ARG$(0) + "/daten/muster/demo_kreuzstich.pxs")

' Ist jeder Schritt der zum naechsten noch offenen Stich, bei Gleichstand der
' obere, dann der linke? Und ist der Start der mit kleinstem x + y (oben)?
FUNCTION nachbarPruefen$(p AS kern.Farbpfad) AS STRING
    DIM n AS INTEGER : n = p.stiche()
    DIM weg[n] AS BOOLEAN
    DIM i AS INTEGER, j AS INTEGER
    ' Start
    FOR j = 0 TO n - 1
        DIM a AS INTEGER : a = p.xs[j] + p.ys[j]
        DIM b AS INTEGER : b = p.xs[0] + p.ys[0]
        IF a < b OR (a = b AND p.ys[j] < p.ys[0]) THEN RETURN "start falsch"
    NEXT
    weg[0] = TRUE
    FOR i = 1 TO n - 1
        DIM cx AS INTEGER : cx = p.xs[i - 1]
        DIM cy AS INTEGER : cy = p.ys[i - 1]
        DIM beste AS INTEGER : beste = -1
        FOR j = 0 TO n - 1
            IF weg[j] THEN CONTINUE
            IF beste < 0 THEN
                beste = j
                CONTINUE
            END IF
            DIM dj AS INTEGER : dj = (p.xs[j] - cx) ^ 2 + (p.ys[j] - cy) ^ 2
            DIM db AS INTEGER : db = (p.xs[beste] - cx) ^ 2 + (p.ys[beste] - cy) ^ 2
            IF dj < db OR (dj = db AND (p.ys[j] < p.ys[beste] OR (p.ys[j] = p.ys[beste] AND p.xs[j] < p.xs[beste]))) THEN beste = j
        NEXT
        IF p.xs[beste] <> p.xs[i] OR p.ys[beste] <> p.ys[i] THEN RETURN "schritt " + STR$(i) + " falsch"
        weg[beste] = TRUE
    NEXT
    RETURN "gueltig"
END FUNCTION

DIM r AS kern.Stickpfad : r = kern.stickpfadBerechnen(m, kern.SP_NACHBAR, 14)
DIM p AS kern.Farbpfad
FOR EACH p IN r.pfade
    PRINT "farbe "; p.farbe; " stiche "; p.stiche(); ": "; nachbarPruefen$(p)
NEXT
' viele Gleichstaende: ein Schachbrett, dazu ein Ring mit Loechern
DIM g AS kern.Muster : g = kern.neuesMuster("brett", 23, 17)
DIM sy AS ARRAY OF STRING : sy = ["A", "B"]
DIM v AS kern.Verlauf : v = NEW kern.Verlauf()
DIM f0 AS INTEGER : f0 = kern.farbeHinzufuegen(g, v, kern.neuesGarn("eins", &H112233, "", ""), sy, FALSE, FALSE)
DIM f1 AS INTEGER : f1 = kern.farbeHinzufuegen(g, v, kern.neuesGarn("zwei", &HDDCCBB, "", ""), sy, FALSE, FALSE)
DIM x AS INTEGER, y AS INTEGER
FOR y = 0 TO 16
    FOR x = 0 TO 22
        IF (x + y) MOD 2 = 0 THEN
            g.ebenen.aktiveEbene().raster[y * 23 + x] = f0
        ELSEIF ABS(x - 11) + ABS(y - 8) > 3 AND (x * 7 + y * 3) MOD 5 <> 0 THEN
            g.ebenen.aktiveEbene().raster[y * 23 + x] = f1
        END IF
    NEXT
NEXT
r = kern.stickpfadBerechnen(g, kern.SP_NACHBAR, 14)
FOR EACH p IN r.pfade
    PRINT "brett farbe "; p.farbe; " stiche "; p.stiche(); " spruenge "; p.spruenge; ": "; nachbarPruefen$(p)
NEXT
