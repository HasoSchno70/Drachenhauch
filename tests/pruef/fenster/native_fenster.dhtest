DIM art AS STRING : art = ARG$(1)
SCREEN(500, 300, IIF(art = "haupt", kennung, "Haupt-" + kennung), 1)
DIM haupt AS GUI_WINDOW : haupt = GUI_WINDOW("Haupt", 10, 10, 300, 200)
DIM hk AS GUI_WIDGET : hk = GUI_BUTTON(haupt, "Haupt-Knopf", 20, 40, 120, 30)
DIM d AS GUI_WINDOW : d = GUI_WINDOW(IIF(art = "haupt", "Dialog-" + kennung, kennung), 60, 60, 260, 140)
DIM ok AS GUI_WIDGET : ok = GUI_BUTTON(d, "OK", 30, 80, 80, 30)
DIM ab AS GUI_WIDGET : ab = GUI_BUTTON(d, "Abbrechen", 130, 80, 100, 30)
DIM feld AS GUI_WIDGET : feld = GUI_TEXTINPUT(d, 30, 30, 200, 26)
GUI_WINDOW_DEFAULT(d, ok)
GUI_WINDOW_CANCEL(d, ab)
DIM kontext AS INTEGER : kontext = GUI_CONTEXT(d)
DIM eintrag AS INTEGER : eintrag = GUI_MENU_ITEM(kontext, "Einfuegen")
GUI_CONTEXT_WIDGET(kontext, feld)
IF art <> "frei" THEN GUI_WINDOW_MODAL(d, TRUE)
DIM nativ AS BOOLEAN : nativ = GUI_WINDOW_NATIVE(d, TRUE)
DIM t0 AS INTEGER : t0 = MILLIS()
