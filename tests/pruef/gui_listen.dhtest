' Aus test_gui_listen.py uebertragen (16 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== eintraege einzeln und auswahl rueckt mit
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM lb AS GUI_WIDGET
lb = GUI_LISTBOX(w, 20, 20, 200, 120, SPLIT$("Apfel|Birne|Kirsche|Dattel", "|"))
GUI_LISTBOX_SET_SELECTED(lb, 2)
PRINT GUI_LISTBOX_ADD(lb, "Ananas", 0)
PRINT GUI_LISTBOX_TEXT(lb)
GUI_LISTBOX_REMOVE(lb, 0)
PRINT GUI_LISTBOX_SELECTED(lb) ; " " ; GUI_LISTBOX_COUNT(lb)
GUI_LISTBOX_MOVE(lb, 3, 0)
PRINT GUI_LISTBOX_ITEM(lb, 0) ; " " ; GUI_LISTBOX_TEXT(lb)
GUI_LISTBOX_SET_ITEM(lb, 0, "Feige")
PRINT GUI_LISTBOX_ITEM(lb, 0)
GUI_LISTBOX_REMOVE(lb, GUI_LISTBOX_SELECTED(lb))
PRINT GUI_LISTBOX_SELECTED(lb)
--- umgebung
DHRT_FRAMES=1
--- erwartet
0
Kirsche
2 4
Dattel Kirsche
Feige
-1

=== auch die klappliste kann eintraege einzeln
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM lb AS GUI_WIDGET
lb = GUI_LISTBOX(w, 20, 20, 200, 120, SPLIT$("Apfel|Birne|Kirsche|Dattel", "|"))
DIM dd AS GUI_WIDGET : dd = GUI_DROPDOWN(w, 20, 160, 160, 24, SPLIT$("a|b", "|"))
GUI_LISTBOX_ADD(dd, "c")
GUI_LISTBOX_REMOVE(dd, 0)
PRINT GUI_LISTBOX_COUNT(dd) ; " " ; GUI_LISTBOX_ITEM(dd, 1)
TRY
    GUI_LISTBOX_SET(dd, "kaestchen", 1)
CATCH e
    PRINT e
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
2 c
GUI_LISTBOX_SET: das Widget ist keine Liste (GUI_LISTBOX)

=== falscher index im klartext
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM lb AS GUI_WIDGET
lb = GUI_LISTBOX(w, 20, 20, 200, 120, SPLIT$("Apfel|Birne|Kirsche|Dattel", "|"))
TRY
    GUI_LISTBOX_ITEM(lb, 4)
CATCH e
    PRINT e
END TRY
TRY
    GUI_LISTBOX_SET(lb, "farbe", 1)
CATCH e2
    PRINT e2
END TRY
--- umgebung
DHRT_FRAMES=1
--- erwartet
GUI_LISTBOX_ITEM: Eintrag 4 gibt es nicht (die Liste hat 4)
GUI_LISTBOX_SET: unbekannter Schluessel 'farbe' -- mehrfachauswahl, kaestchen

=== strg klick sammelt umschalt klick spannt (1)
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM lb AS GUI_WIDGET
lb = GUI_LISTBOX(w, 20, 20, 200, 120, SPLIT$("Apfel|Birne|Kirsche|Dattel", "|"))
DIM f AS INTEGER
FOR f = 1 TO 2
    GUI_UPDATE()
    PRINT "O " + STR$(GUI_CANVAS_X(nullpunkt)) + " " + STR$(GUI_CANVAS_Y(nullpunkt))
    GUI_DRAW()
    FLIP()
NEXT
--- umgebung
DHRT_FRAMES=3
--- erwartet
O 11 33
O 11 33

=== strg klick sammelt umschalt klick spannt (2)
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM nullpunkt AS GUI_WIDGET : nullpunkt = GUI_CANVAS(w, 0, 0, 1, 1)
DIM lb AS GUI_WIDGET
lb = GUI_LISTBOX(w, 20, 20, 200, 120, SPLIT$("Apfel|Birne|Kirsche|Dattel", "|"))
GUI_LISTBOX_SET(lb, "mehrfachauswahl", 1)
DIM f AS INTEGER
FOR f = 1 TO 20
    GUI_UPDATE()
    IF f = 6 OR f = 12 OR f = 19 THEN PRINT STR$(GUI_LISTBOX_SEL_COUNT(lb)) + " " + STR$(GUI_LISTBOX_SEL_ROW(lb, 0)) + " " + STR$(GUI_LISTBOX_SEL_ROW(lb, 1)) + " " + STR$(GUI_LISTBOX_SELECTED(lb))
    GUI_DRAW()
    FLIP()
NEXT
