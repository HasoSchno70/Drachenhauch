=== strg b ohne auswahl gilt fuer das naechste getippte
IMPORT "gui"
SCREEN(300, 220, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 220)
DIM ta AS GUI_WIDGET : ta = GUI_TEXTAREA(w, 10, 10, 280, 200)
GUI_TEXTAREA_SET(ta, "formatiert", 1)
GUI_SET_TEXT(ta, "ab")
GUI_FOCUS(ta)
CLIPBOARD_SET("cd")
DIM bild AS INTEGER
WHILE NOT QUITREQUESTED()
    bild = bild + 1
    GUI_UPDATE()
    IF bild = 2 THEN AUTOMATION_PLAY("ev.txt")
    IF bild = 10 THEN PRINT GUI_TEXTAREA_GET_STYLE$(ta)
    IF bild = 20 THEN PRINT GUI_TEXTAREA_MARKDOWN$(ta)
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
