=== die sprache aus den einstellungen gilt ab dem naechsten start
' Erster Lauf (deutsch): im Einstellungsfenster English waehlen und
' speichern -- language = "en", eine Meldung in beiden Sprachen (Enter aus
' der Aufnahme), die Fenster bleiben deutsch. Zweiter Lauf: englisch. Dann
' language = "de" -- und mit DHRT_LANG=en bleibt der naechste Lauf deutsch.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
kKopieren(ARG$(1), p)
DIM log AS STRING : log = CWD$() + "/s.log"
DIM aus AS STRING : aus = kF5(p, log)
PRINT "geprueft "; slHat(log, "geprueft 0 0")
SETENV("DHRT_LANG", "")
slZeilen = [] : slBild = 0
slHin(10, 10)
slWarten(10)
slTaste(257)
slWarten(30)
slTaste(257)
slAufnahmeSchreiben(p + "/_studio/enter.txt")
PRINT "code "; kProbe(p, "probe1.dh", "enter.txt", 1500)
PRINT "code "; kProbe(p, "probe2.dh", "", 1500)
SETENV("DHRT_LANG", "en")
PRINT "code "; kProbe(p, "probe2.dh", "", 1500)
IF INSTR(aus, "Laufzeitfehler") >= 0 THEN PRINT aus
--- argumente
{sammlung}/../../../studio/studio.dh
{sammlung}/../../../examples/studio/kuehlschrank
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/kuehlschrank.dh"
slStudio = ARG$(0)
--- datei probe1.dh
PRINT "sprache '"; Sprache$(); "' einstellung '"; einstellung$("language", ""); "' geladen "; einstellungen().sprache
DIM f AS EinstellungenFenster : f = NEW EinstellungenFenster()
f.Zeigen()
studioBild()
PRINT "wahl "; GUI_DROPDOWN_SELECTED(f.spracheWahl); " "; GUI_DROPDOWN_TEXT(f.spracheWahl); " | "; GUI_TEXT(f.spracheText)
GUI_DROPDOWN_SET_SELECTED(f.spracheWahl, 1)
f.knopfSpeichern_Klick()
PRINT "gespeichert "; einstellung$("language", ""); " sprache jetzt '"; Sprache$(); "' offen "; f.studioOffen
END
--- datei probe2.dh
PRINT "sprache '"; Sprache$(); "' "; GUI_TEXT(studioStartFenster.titel)
' Fuer den naechsten Lauf: Deutsch.
einstellungSetzen("language", jsonText$("de"))
END
