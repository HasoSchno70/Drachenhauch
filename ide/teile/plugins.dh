' ide/teile/plugins.dh -- ein Teil der IDE (ide/ide.dh), dort per IMPORT
' an genau dieser Stelle eingebunden: Plugins: Leitung, Leisten, Verwaltung, Vorlage, Holen.
' Kein eigenes Programm -- die Namen gehoeren der IDE.

' --- Befehlspalette und Datei-Waehler ------------------------------------
' EINE Liste aller Befehle mit Kuerzel: Palette, Tastenkuerzel-Uebersicht.
' --- Plugins (seit 2026-10-24, docs/ide-plugins.md) -----------------------
' Ein Plugin ist ein eigenes Programm (plugins/<name>/plugin.dh neben der
' ide.json); die IDE startet es mit WINDOW_OPEN und spricht ueber dessen
' Leitung mit ihm -- eine JSON-Zeile je Nachricht, die Seite des Plugins
' steht in ide/dh_plugin.dh. Ein Plugin, das abstuerzt oder haengt, reisst
' die IDE nicht mit: sein Zustand wird "abgestuerzt", seine Leisten gehen zu,
' seine Befehle werden gesperrt.
FUNCTION pluginOrdner$() AS STRING
    RETURN PATHJOIN(konfigOrdner$(), "plugins")
END FUNCTION

' Abgeschaltet ist, was in der ide.json unter "plugins_aus" steht.
FUNCTION pluginAus(name AS STRING) AS BOOLEAN
    IF NOT JSON_HAS(konfig, "plugins_aus") THEN RETURN FALSE
    IF JSON_TYPE(konfig, "plugins_aus") <> "array" THEN RETURN FALSE
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(konfig, "plugins_aus") - 1
        DIM p AS STRING : p = "plugins_aus." + STR$(i)
        IF JSON_TYPE(konfig, p) = "string" THEN
            IF LOWER$(JSON_GET_STRING(konfig, p)) = LOWER$(name) THEN RETURN TRUE
        END IF
    NEXT
    RETURN FALSE
END FUNCTION

SUB pluginAusSetzen(name AS STRING, aus AS BOOLEAN)
    DIM liste AS JSON_HANDLE : liste = JSON_PARSE("[]")
    IF JSON_HAS(konfig, "plugins_aus") THEN
        IF JSON_TYPE(konfig, "plugins_aus") = "array" THEN
            DIM i AS INTEGER
            FOR i = 0 TO JSON_LEN(konfig, "plugins_aus") - 1
                DIM p AS STRING : p = "plugins_aus." + STR$(i)
                IF JSON_TYPE(konfig, p) = "string" THEN
                    IF LOWER$(JSON_GET_STRING(konfig, p)) <> LOWER$(name) THEN JSON_APPEND_STRING(liste, "", JSON_GET_STRING(konfig, p))
                END IF
            NEXT
        END IF
    END IF
    IF aus THEN JSON_APPEND_STRING(liste, "", name)
    JSON_SET_JSON(konfig, "plugins_aus", liste)
    konfigSichern()
END SUB

' Die Bibliothek dh_plugin.dh liegt neben der IDE; DH_PATH zeigt dorthin,
' damit ein Plugin schlicht IMPORT "dh_plugin.dh" schreibt. Ein Kind erbt
' die Umgebung beim Start.
FUNCTION pluginBibOrdner$() AS STRING
    DIM bib AS STRING : bib = CWD$()
    IF NOT FILEEXISTS(PATHJOIN(bib, "dh_plugin.dh")) THEN bib = PATHJOIN(wurzel, "ide")
    RETURN bib
END FUNCTION

SUB pluginPfadSetzen()
    DIM bib AS STRING : bib = pluginBibOrdner$()
    DIM trenner AS STRING : trenner = IIF(MID$(bib, 1, 1) = ":", ";", ":")
    DIM alt AS STRING : alt = GETENV$("DH_PATH")
    IF INSTR(alt, bib) >= 0 THEN RETURN
    SETENV("DH_PATH", IIF(alt = "", bib, bib + trenner + alt))
END SUB

' Die mitgelieferten Plugins: examples/plugins/ (kommen mit dem Installer).
FUNCTION pluginMitOrdner$() AS STRING
    IF beispielOrdner = "" THEN RETURN ""
    RETURN PATHJOIN(beispielOrdner, "plugins")
END FUNCTION

' Ein mitgeliefertes Plugin laeuft nur, wenn es in "plugins_an" steht.
FUNCTION pluginAn(name AS STRING) AS BOOLEAN
    IF NOT JSON_HAS(konfig, "plugins_an") THEN RETURN FALSE
    IF JSON_TYPE(konfig, "plugins_an") <> "array" THEN RETURN FALSE
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(konfig, "plugins_an") - 1
        DIM p AS STRING : p = "plugins_an." + STR$(i)
        IF JSON_TYPE(konfig, p) = "string" THEN
            IF LOWER$(JSON_GET_STRING(konfig, p)) = LOWER$(name) THEN RETURN TRUE
        END IF
    NEXT
    RETURN FALSE
END FUNCTION

SUB pluginAnSetzen(name AS STRING, an AS BOOLEAN)
    DIM liste AS JSON_HANDLE : liste = JSON_PARSE("[]")
    IF JSON_HAS(konfig, "plugins_an") THEN
        IF JSON_TYPE(konfig, "plugins_an") = "array" THEN
            DIM i AS INTEGER
            FOR i = 0 TO JSON_LEN(konfig, "plugins_an") - 1
                DIM p AS STRING : p = "plugins_an." + STR$(i)
                IF JSON_TYPE(konfig, p) = "string" THEN
                    IF LOWER$(JSON_GET_STRING(konfig, p)) <> LOWER$(name) THEN JSON_APPEND_STRING(liste, "", JSON_GET_STRING(konfig, p))
                END IF
            NEXT
        END IF
    END IF
    IF an THEN JSON_APPEND_STRING(liste, "", name)
    JSON_SET_JSON(konfig, "plugins_an", liste)
    konfigSichern()
END SUB

' Soll das Plugin laufen? Eigene: ja, ausser abgeschaltet; mitgelieferte:
' nur angehakt.
FUNCTION pluginGewollt(k AS INTEGER) AS BOOLEAN
    IF plugins[k].mitgeliefert THEN RETURN pluginAn(plugins[k].name)
    RETURN NOT pluginAus(plugins[k].name)
END FUNCTION

SUB pluginGewolltSetzen(k AS INTEGER, an AS BOOLEAN)
    IF plugins[k].mitgeliefert THEN pluginAnSetzen(plugins[k].name, an) ELSE pluginAusSetzen(plugins[k].name, NOT an)
END SUB

' Fassungen wie "2026.36" der Reihe nach vergleichen: -1, 0, 1.
FUNCTION fassungVergleich(a AS STRING, b AS STRING) AS INTEGER
    DIM ta AS ARRAY OF STRING : ta = SPLIT$(a, ".")
    DIM tb AS ARRAY OF STRING : tb = SPLIT$(b, ".")
    DIM i AS INTEGER
    FOR i = 0 TO MAX(LEN(ta), LEN(tb)) - 1
        DIM x AS INTEGER : x = 0
        DIM y AS INTEGER : y = 0
        IF i < LEN(ta) THEN x = VAL(ta[i])
        IF i < LEN(tb) THEN y = VAL(tb[i])
        IF x < y THEN RETURN -1
        IF x > y THEN RETURN 1
    NEXT
    RETURN 0
END FUNCTION

' Den Steckbrief lesen: plugin.json neben plugin.dh. Fehlt er oder ist er
' krumm, gelten der Ordnername und leere Angaben -- ein Plugin laeuft auch
' ohne.
SUB pluginSteckbrief(pl AS Plugin, ordner AS STRING)
    DIM sb AS STRING : sb = PATHJOIN(ordner, "plugin.json")
    IF NOT FILEEXISTS(sb) THEN RETURN
    TRY
        DIM j AS JSON_HANDLE : j = JSON_LOAD(sb)
        IF JSON_HAS(j, "name") THEN pl.titel = JSON_GET_STRING(j, "name")
        IF JSON_HAS(j, "fassung") THEN pl.fassung = JSON_GET_STRING(j, "fassung")
        IF JSON_HAS(j, "beschreibung") THEN pl.info = JSON_GET_STRING(j, "beschreibung")
        IF JSON_HAS(j, "autor") THEN pl.autor = JSON_GET_STRING(j, "autor")
        IF JSON_HAS(j, "ide") THEN pl.ideMin = JSON_GET_STRING(j, "ide")
    CATCH e
        protokoll("plugin " + pl.name + " steckbrief unlesbar")
    END TRY
END SUB

' Alle Plugins eines Ordners anmelden; ein Name, den es schon gibt, zaehlt
' nicht -- ein eigenes Plugin verdeckt so ein mitgeliefertes gleichen Namens.
SUB pluginsAusOrdner(ordner AS STRING, mit AS BOOLEAN, geholt AS BOOLEAN = FALSE)
    IF ordner = "" THEN RETURN
    IF NOT DIREXISTS(ordner) THEN RETURN
    DIM namen AS ARRAY OF STRING : namen = DIRLIST(ordner)
    SORT(namen)
    DIM n AS STRING
    FOR EACH n IN namen
        DIM pfad AS STRING : pfad = PATHJOIN(PATHJOIN(ordner, n), "plugin.dh")
        IF LEFT$(n, 1) = "." OR NOT FILEEXISTS(pfad) THEN CONTINUE
        IF pluginNr(n) >= 0 THEN CONTINUE
        DIM pl AS Plugin : pl = NEW Plugin(n, pfad, mit, geholt)
        pluginSteckbrief(pl, PATHJOIN(ordner, n))
        ARRAY_PUSH(plugins, pl)
        IF pluginGewollt(LEN(plugins) - 1) THEN pluginStarten(LEN(plugins) - 1)
    NEXT
END SUB

SUB pluginsStarten()
    pluginPfadSetzen()
    pluginsAusOrdner(pluginOrdner$(), FALSE)
    ' Geholte (dhrt paket) zaehlen zu den eigenen.
    pluginsAusOrdner(PATHJOIN(pluginOrdner$(), "pakete"), FALSE, TRUE)
    ' Gezaehlt werden die eigenen; die mitgelieferten in einer eigenen Zeile.
    protokoll("plugins " + STR$(LEN(plugins)))
    DIM eigene AS INTEGER : eigene = LEN(plugins)
    pluginsAusOrdner(pluginMitOrdner$(), TRUE)
    protokoll("mitgeliefert " + STR$(LEN(plugins) - eigene))
END SUB

' Der Ordner, in den ein Plugin schreiben darf (Einstellungen, Listen): neben
' der ide.json, je Plugin einer. Sein eigener Ordner kann schreibgeschuetzt
' sein -- ein mitgeliefertes liegt im Beispiel-Ordner.
FUNCTION pluginDaten$(name AS STRING) AS STRING
    RETURN PATHJOIN(PATHJOIN(konfigOrdner$(), "plugin-daten"), name)
END FUNCTION

SUB pluginStarten(k AS INTEGER)
    IF plugins[k].laeuft() THEN RETURN
    ' Braucht es eine neuere IDE, startet es nicht -- es liefe womoeglich
    ' gegen Nachrichten, die diese IDE nicht kennt.
    IF plugins[k].ideMin <> "" AND fassungVergleich(plugins[k].ideMin, VERSION$()) > 0 THEN
        plugins[k].zustand = tr$("braucht IDE ") + plugins[k].ideMin
        protokoll("plugin " + plugins[k].name + " braucht " + plugins[k].ideMin)
        RETURN
    END IF
    TRY
        DIM daten AS STRING : daten = pluginDaten$(plugins[k].name)
        IF NOT DIREXISTS(PATHJOIN(konfigOrdner$(), "plugin-daten")) THEN MKDIR(PATHJOIN(konfigOrdner$(), "plugin-daten"))
        IF NOT DIREXISTS(daten) THEN MKDIR(daten)
        ' Das Kind erbt die Umgebung beim Start (PLUGIN_DATENORDNER$) -- als
        ' voller Pfad, denn es laeuft in seinem eigenen Ordner, und der
        ' Konfig-Ordner ist bei einer ide.json ohne Ordner nur ".".
        SETENV("DH_PLUGIN_DATEN", REALPATH$(daten))
        plugins[k].leitung = WINDOW_OPEN(plugins[k].pfad)
        ' Die erste Nachricht: Fassung des Protokolls und der IDE. Vor der
        ' Verbindung Gesendetes merkt sich die Leitung vor.
        DIM hallo AS JSON_HANDLE : hallo = JSON_PARSE("{}")
        JSON_SET_STRING(hallo, "art", "hallo")
        JSON_SET_INT(hallo, "protokoll", PLUGIN_PROTOKOLL_FASSUNG)
        JSON_SET_STRING(hallo, "ide", VERSION$())
        WINDOW_SEND(plugins[k].leitung, JSON_STRINGIFY(hallo))
        plugins[k].zustand = "läuft"
        plugins[k].hoert = ";"
        protokoll("plugin " + plugins[k].name + " gestartet")
    CATCH e
        plugins[k].zustand = "Fehler: " + e
        protokoll("plugin " + plugins[k].name + " fehler " + e)
    END TRY
END SUB

' Beenden: "ende" schicken, dann die Leitung zu. Leisten gehen zu, Befehle
' werden gesperrt -- ein neuer Start meldet sie wieder an.
SUB pluginStoppen(k AS INTEGER, zustand AS STRING)
    IF plugins[k].laeuft() THEN
        TRY
            WINDOW_SEND(plugins[k].leitung, "{" + CHR$(34) + "art" + CHR$(34) + ":" + CHR$(34) + "ende" + CHR$(34) + "}")
            WINDOW_CLOSE(plugins[k].leitung)
        CATCH e
        END TRY
    END IF
    plugins[k].leitung = -1
    plugins[k].zustand = zustand
    DIM vor AS STRING : vor = "plugin:" + plugins[k].name + ":"
    DIM i AS INTEGER
    FOR i = 0 TO LEN(plugBefehle) - 1
        IF LEFT$(plugBefehle[i].kennung, LEN(vor)) = vor THEN GUI_MENU_ENABLE(plugBefehle[i].item, FALSE)
    NEXT
    ' Ein Menue wird Eintraege nicht wieder los -- gesperrt, und ein Neustart
    ' gibt sie frei (pluginKontextAnmelden).
    FOR i = 0 TO LEN(ctxEintraege) - 1
        IF LEFT$(ctxEintraege[i].kennung, LEN(vor)) = vor THEN GUI_MENU_ENABLE(ctxEintraege[i].item, FALSE)
    NEXT
    DIM lv AS STRING : lv = "plugin." + plugins[k].name + "."
    FOR i = 0 TO LEN(plugLeisten) - 1
        IF LEFT$(plugLeisten[i].name, LEN(lv)) = lv THEN GUI_DOCK_SHOW(win, plugLeisten[i].name, FALSE)
    NEXT
    ' Befunde, Schnipsel und Faerbungen des Plugins gelten nicht mehr.
    DIM bk AS STRING
    FOR EACH bk IN MAPKEYS(plugBefunde)
        IF LEFT$(bk, LEN(plugins[k].name) + 1) = plugins[k].name + "|" THEN MAPREMOVE(plugBefunde, bk)
    NEXT
    pluginSchnipselWeg(plugins[k].name)
    pluginFaerbungWeg(plugins[k].name)
    protokoll("plugin " + plugins[k].name + " " + zustand)
END SUB

SUB pluginsBeenden()
    DIM k AS INTEGER
    FOR k = 0 TO LEN(plugins) - 1
        IF plugins[k].laeuft() THEN pluginStoppen(k, "aus")
    NEXT
END SUB

SUB pluginsNeuLaden()
    pluginsBeenden()
    plugins = []
    pluginsStarten()
    GUI_SET_TEXT(lblStatus, tr$("Plugins neu geladen: ") + STR$(LEN(plugins)))
    IF GUI_WINDOW_SHOWN(winPlug) THEN pluginListeFuellen()
END SUB

FUNCTION pluginNr(name AS STRING) AS INTEGER
    DIM k AS INTEGER
    FOR k = 0 TO LEN(plugins) - 1
        IF plugins[k].name = name THEN RETURN k
    NEXT
    RETURN -1
END FUNCTION

SUB pluginSenden(k AS INTEGER, j AS JSON_HANDLE)
    IF k < 0 OR NOT plugins[k].laeuft() THEN RETURN
    TRY
        WINDOW_SEND(plugins[k].leitung, JSON_STRINGIFY(j))
    CATCH e
    END TRY
END SUB

' Ein Ereignis an alle, die es hoeren wollen (PLUGIN_HOERE).
SUB pluginEreignis(name AS STRING, datei AS STRING)
    DIM k AS INTEGER
    FOR k = 0 TO LEN(plugins) - 1
        IF NOT plugins[k].laeuft() THEN CONTINUE
        IF NOT plugins[k].hoertAuf(name) THEN CONTINUE
        DIM j AS JSON_HANDLE : j = JSON_PARSE("{}")
        JSON_SET_STRING(j, "art", "ereignis")
        JSON_SET_STRING(j, "name", name)
        JSON_SET_STRING(j, "datei", datei)
        pluginSenden(k, j)
    NEXT
END SUB

' "plugin:<plugin>:<id>" -- ausgeloest ueber Menue, Kuerzel oder Palette.
SUB pluginBefehl(kennung AS STRING)
    DIM rest AS STRING : rest = MID$(kennung, 7)
    DIM t AS INTEGER : t = INSTR(rest, ":")
    IF t < 0 THEN RETURN
    DIM k AS INTEGER : k = pluginNr(LEFT$(rest, t))
    IF k < 0 THEN RETURN
    IF NOT plugins[k].laeuft() THEN
        GUI_SET_TEXT(lblStatus, tr$("Das Plugin läuft nicht: ") + plugins[k].name)
        RETURN
    END IF
    DIM j AS JSON_HANDLE : j = JSON_PARSE("{}")
    JSON_SET_STRING(j, "art", "befehl")
    JSON_SET_STRING(j, "id", MID$(rest, t + 1))
    ' Aus dem Kontextmenue meint ein Befehl meist das Wort, auf das geklickt
    ' wurde -- der Rechtsklick hat die Marke dorthin gesetzt.
    JSON_SET_STRING(j, "wert", wortAnDerMarke$())
    pluginSenden(k, j)
    protokoll("plugin befehl " + kennung)
END SUB

' Je Bild: Nachrichten der Plugins lesen (hoechstens 50 je Plugin, sonst
' haelt ein geschwaetziges Plugin die IDE an), Abstuerze erkennen, Klicks
' und Aenderungen in ihren Leisten weitergeben.
SUB pluginsNachziehen()
    DIM k AS INTEGER
    FOR k = 0 TO LEN(plugins) - 1
        IF NOT plugins[k].laeuft() THEN CONTINUE
        DIM zaehl AS INTEGER : zaehl = 0
        WHILE zaehl < 50
            DIM z AS STRING : z = ""
            TRY
                z = WINDOW_RECV$(plugins[k].leitung)
            CATCH e
                z = ""
            END TRY
            IF z = "" THEN BREAK
            pluginNachricht(k, z)
            zaehl = zaehl + 1
            IF NOT plugins[k].laeuft() THEN BREAK
        WEND
        IF plugins[k].laeuft() THEN
            IF NOT WINDOW_ALIVE(plugins[k].leitung) THEN pluginStoppen(k, "abgestürzt")
        END IF
    NEXT
    DIM i AS INTEGER
    FOR i = 0 TO LEN(plugLeisten) - 1
        IF NOT GUI_DOCK_SHOWN(win, plugLeisten[i].name) THEN CONTINUE
        DIM pw AS INTEGER : pw = plugLeisten[i].fenster
        DIM teile AS ARRAY OF STRING : teile = SPLIT$(plugLeisten[i].name, ".")
        IF LEN(teile) < 3 THEN CONTINUE
        DIM pk AS INTEGER : pk = pluginNr(teile[1])
        IF pk < 0 THEN CONTINUE
        DIM leisteId AS STRING : leisteId = MID$(plugLeisten[i].name, LEN(teile[0]) + LEN(teile[1]) + 2)
        DIM wi AS INTEGER
        FOR wi = 0 TO GUI_WINDOW_WIDGET_COUNT(pw) - 1
            DIM h AS GUI_WIDGET : h = GUI_WINDOW_WIDGET(pw, wi)
            IF GUI_CLICKED(h) THEN pluginWidgetEreignis(pk, "klick", leisteId, wi, "")
            IF GUI_CHANGED(h) THEN pluginWidgetEreignis(pk, "geaendert", leisteId, wi, pluginWert$(h))
        NEXT
    NEXT
END SUB

FUNCTION pluginWert$(h AS GUI_WIDGET) AS STRING
    SELECT CASE LOWER$(GUI_KIND(h))
        CASE "checkbox", "toggle", "radio" : RETURN IIF(GUI_CHECKED(h), "TRUE", "FALSE")
        CASE "slider", "spinner", "knob", "progress" : RETURN STR$(GUI_VALUE(h))
        CASE "listbox" : RETURN STR$(GUI_LISTBOX_SELECTED(h))
        CASE "dropdown" : RETURN STR$(GUI_DROPDOWN_SELECTED(h))
        CASE "tree" : RETURN STR$(GUI_TREE_SELECTED(h))
    END SELECT
    RETURN GUI_TEXT(h)
END FUNCTION

SUB pluginWidgetEreignis(k AS INTEGER, art AS STRING, leiste AS STRING, widget AS INTEGER, wert AS STRING)
    DIM j AS JSON_HANDLE : j = JSON_PARSE("{}")
    JSON_SET_STRING(j, "art", art)
    JSON_SET_STRING(j, "leiste", leiste)
    JSON_SET_INT(j, "widget", widget)
    JSON_SET_STRING(j, "wert", wert)
    pluginSenden(k, j)
END SUB

FUNCTION plugText$(j AS JSON_HANDLE, k AS STRING) AS STRING
    IF NOT JSON_HAS(j, k) THEN RETURN ""
    IF JSON_TYPE(j, k) = "string" THEN RETURN JSON_GET_STRING(j, k)
    IF JSON_TYPE(j, k) = "number" THEN RETURN STR$(JSON_GET_INT(j, k))
    RETURN ""
END FUNCTION

FUNCTION plugZahl(j AS JSON_HANDLE, k AS STRING) AS INTEGER
    IF NOT JSON_HAS(j, k) THEN RETURN 0
    IF JSON_TYPE(j, k) <> "number" THEN RETURN 0
    RETURN JSON_GET_INT(j, k)
END FUNCTION

' Eine Nachricht eines Plugins. Was nicht stimmt, steht im Protokoll und in
' der Ausgabe -- ein Fehler im Plugin ist nicht der Fehler der IDE.
SUB pluginNachricht(k AS INTEGER, zeile AS STRING)
    DIM j AS JSON_HANDLE
    TRY
        j = JSON_PARSE(zeile)
    CATCH e
        protokoll("plugin " + plugins[k].name + " unlesbar")
        RETURN
    END TRY
    DIM art AS STRING : art = plugText$(j, "art")
    TRY
        SELECT CASE art
            CASE "befehl" : pluginBefehlAnmelden(k, j)
            CASE "kontext" : pluginKontextAnmelden(k, j)
            CASE "hover" : pluginHoverAntwort(k, j)
            CASE "vorschlaege" : pluginVervollAntwort(k, j)
            CASE "leiste" : pluginLeisteAnmelden(k, j)
            CASE "hoere"
                DIM ev AS STRING : ev = plugText$(j, "ereignis")
                IF NOT plugins[k].hoertAuf(ev) THEN plugins[k].hoert = plugins[k].hoert + ev + ";"
            CASE "setze" : pluginSetze(k, j)
            CASE "liste" : pluginListe(k, j)
            CASE "baum" : pluginBaum(k, j)
            CASE "frage" : pluginAntwort(k, j)
            CASE "tue" : pluginTue(k, j)
            CASE "befunde"
                MAPPUT(plugBefunde, plugins[k].name + "|" + wegGleich$(plugText$(j, "datei")), JSON_STRINGIFY(JSON_GET_JSON(j, "liste")))
                pruefungFaellig = GET_TIME()
            CASE "schnipsel"
                ARRAY_PUSH(plugSchnipsel, NEW SchnipselEintrag(plugText$(j, "name"), plugText$(j, "kuerzel"), _
                                                        plugText$(j, "text"), "Plugin " + plugins[k].name))
                schnipselLaden()
            CASE "faerbung"
                ARRAY_PUSH(plugFaerbungen, NEW Faerbung(plugins[k].name, LOWER$(plugText$(j, "endung")), _
                                                        plugText$(j, "muster"), plugZahl(j, "farbe")))
                faerbSchluessel = ""
            CASE ELSE
                protokoll("plugin " + plugins[k].name + " unbekannt " + art)
        END SELECT
    CATCH e
        protokoll("plugin " + plugins[k].name + " fehler " + e)
        ausgabe("[" + plugins[k].name + "] " + e)
    END TRY
END SUB

FUNCTION pluginBefehlNr(kennung AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(plugBefehle) - 1
        IF plugBefehle[i].kennung = kennung THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

FUNCTION pluginLeisteNr(name AS STRING) AS INTEGER
    DIM i AS INTEGER
    FOR i = 0 TO LEN(plugLeisten) - 1
        IF plugLeisten[i].name = name THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB pluginBefehlAnmelden(k AS INTEGER, j AS JSON_HANDLE)
    DIM kennung AS STRING : kennung = "plugin:" + plugins[k].name + ":" + plugText$(j, "id")
    DIM titel AS STRING : titel = plugText$(j, "titel")
    DIM kuerzel AS STRING : kuerzel = plugText$(j, "kuerzel")
    DIM i AS INTEGER : i = pluginBefehlNr(kennung)
    IF i >= 0 THEN
        ' Neu gestartet: derselbe Menuepunkt, wieder bedienbar.
        GUI_MENU_ENABLE(plugBefehle[i].item, TRUE)
        GUI_MENU_TEXT(plugBefehle[i].item, titel)
        RETURN
    END IF
    DIM item AS INTEGER
    IF kuerzel = "" THEN
        item = GUI_MENU_ITEM(mPlugins, titel)
    ELSE
        item = GUI_MENU_ITEM(mPlugins, titel, kz$(kuerzel))
    END IF
    ARRAY_PUSH(plugBefehle, NEW PluginMenuepunkt(kennung, item))
    menueBefehl(item, kennung, kuerzel)
    paletteEintrag(titel, kennung, kuerzel)
    protokoll("plugin befehl angemeldet " + kennung)
END SUB

SUB pluginLeisteAnmelden(k AS INTEGER, j AS JSON_HANDLE)
    DIM name AS STRING : name = "plugin." + plugins[k].name + "." + plugText$(j, "id")
    DIM bereich AS STRING : bereich = plugText$(j, "bereich")
    IF bereich = "" THEN bereich = "rechts"
    DIM pw AS INTEGER : pw = GUI_FROM_JSON(JSON_STRINGIFY(JSON_GET_JSON(j, "form")))
    DIM i AS INTEGER : i = pluginLeisteNr(name)
    IF i >= 0 THEN
        ' Neu gestartet: das alte Fenster weg, das neue an seinen Platz.
        GUI_WINDOW_DESTROY(plugLeisten[i].fenster)
        plugLeisten[i].fenster = pw
        GUI_DOCK_TITLE(win, name, plugText$(j, "titel"))
        GUI_DOCK_SHOW(win, name, TRUE)
    ELSE
        GUI_DOCK_PANEL(win, name, plugText$(j, "titel"), bereich)
        ARRAY_PUSH(plugLeisten, NEW PluginLeiste(name, pw))
    END IF
    GUI_DOCK_WINDOW(win, name, pw)
    layout()
    protokoll("plugin leiste " + name + " " + GUI_DOCK_WHERE$(win, name))
END SUB

FUNCTION pluginLeisteFenster(k AS INTEGER, j AS JSON_HANDLE) AS INTEGER
    DIM i AS INTEGER : i = pluginLeisteNr("plugin." + plugins[k].name + "." + plugText$(j, "leiste"))
    IF i < 0 THEN RETURN -1
    RETURN plugLeisten[i].fenster
END FUNCTION

SUB pluginSetze(k AS INTEGER, j AS JSON_HANDLE)
    DIM pw AS INTEGER : pw = pluginLeisteFenster(k, j)
    IF pw < 0 THEN RETURN
    DIM nr AS INTEGER : nr = plugZahl(j, "widget")
    IF nr < 0 OR nr >= GUI_WINDOW_WIDGET_COUNT(pw) THEN RETURN
    DIM h AS GUI_WIDGET : h = GUI_WINDOW_WIDGET(pw, nr)
    DIM wert AS STRING : wert = plugText$(j, "wert")
    DIM wahr AS BOOLEAN : wahr = UPPER$(wert) = "TRUE" OR wert = "1"
    SELECT CASE plugText$(j, "was")
        CASE "text" : GUI_SET_TEXT(h, wert)
        CASE "checked" : GUI_SET_CHECKED(h, wahr)
        CASE "value" : GUI_SET_VALUE(h, VAL(wert))
        CASE "enabled" : GUI_SET_ENABLED(h, wahr)
        CASE "visible" : GUI_SET_VISIBLE(h, wahr)
        CASE "selected"
            SELECT CASE LOWER$(GUI_KIND(h))
                CASE "dropdown" : GUI_DROPDOWN_SET_SELECTED(h, VAL(wert))
                CASE "tree" : GUI_TREE_SET_SELECTED(h, VAL(wert))
                CASE ELSE : GUI_LISTBOX_SET_SELECTED(h, VAL(wert))
            END SELECT
    END SELECT
END SUB

SUB pluginListe(k AS INTEGER, j AS JSON_HANDLE)
    DIM pw AS INTEGER : pw = pluginLeisteFenster(k, j)
    IF pw < 0 THEN RETURN
    DIM nr AS INTEGER : nr = plugZahl(j, "widget")
    IF nr < 0 OR nr >= GUI_WINDOW_WIDGET_COUNT(pw) THEN RETURN
    DIM h AS GUI_WIDGET : h = GUI_WINDOW_WIDGET(pw, nr)
    DIM eintraege AS ARRAY OF STRING : eintraege = []
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "eintraege") - 1
        ARRAY_PUSH(eintraege, JSON_GET_STRING(j, "eintraege." + STR$(i)))
    NEXT
    IF LOWER$(GUI_KIND(h)) = "dropdown" THEN GUI_SET_DROPDOWN(h, eintraege) ELSE GUI_SET_LISTBOX(h, eintraege)
END SUB

' Einen Baum der Leiste fuellen: je Eintrag eine Ebene (0 = oben) und ein
' Text, in der Reihenfolge, in der sie unter einander stehen. Ein Knoten
' haengt am letzten davor mit kleinerer Ebene; seine Nummer ist die Stelle
' in der Liste, und dieselbe Nummer kommt bei "geaendert" als Wert zurueck.
SUB pluginBaum(k AS INTEGER, j AS JSON_HANDLE)
    DIM pw AS INTEGER : pw = pluginLeisteFenster(k, j)
    IF pw < 0 THEN RETURN
    DIM nr AS INTEGER : nr = plugZahl(j, "widget")
    IF nr < 0 OR nr >= GUI_WINDOW_WIDGET_COUNT(pw) THEN RETURN
    DIM h AS GUI_WIDGET : h = GUI_WINDOW_WIDGET(pw, nr)
    IF LOWER$(GUI_KIND(h)) <> "tree" THEN RETURN
    GUI_TREE_CLEAR(h)
    DIM eltern AS ARRAY OF INTEGER : eltern = []
    DIM auf AS BOOLEAN : auf = TRUE
    IF JSON_HAS(j, "auf") THEN auf = JSON_GET_BOOL(j, "auf")
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "texte") - 1
        DIM ebene AS INTEGER : ebene = MAX(0, JSON_GET_INT(j, "ebenen." + STR$(i)))
        ' Ein Sprung um mehrere Ebenen haengt am tiefsten vorhandenen.
        WHILE LEN(eltern) > ebene : ARRAY_POP(eltern) : WEND
        DIM oben AS INTEGER : oben = -1
        IF LEN(eltern) > 0 THEN oben = eltern[LEN(eltern) - 1]
        DIM knoten AS INTEGER : knoten = GUI_TREE_ADD(h, oben, JSON_GET_STRING(j, "texte." + STR$(i)))
        IF oben >= 0 THEN GUI_TREE_EXPAND(h, oben, auf)
        ARRAY_PUSH(eltern, knoten)
    NEXT
END SUB

' Das Wort an der Schreibmarke des Feldes vorn ("" = keins).
FUNCTION wortAnDerMarke$() AS STRING
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    IF ta < 0 THEN RETURN ""
    DIM mz AS INTEGER
    DIM ms AS INTEGER
    (mz, ms) = GUI_TEXTAREA_CURSOR(ta)
    DIM zl AS ARRAY OF STRING : zl = SPLIT$(GUI_TEXT(ta), NL)
    IF mz < 1 OR mz > LEN(zl) THEN RETURN ""
    DIM w AS STRING
    DIM a AS INTEGER
    (w, a) = wortBeiZeichen(zl[mz - 1], ms)
    ' Hinter dem Wort (die Marke steht oft direkt dahinter) zaehlt es auch.
    IF w = "" AND ms > 1 THEN (w, a) = wortBeiZeichen(zl[mz - 1], ms - 1)
    RETURN w
END FUNCTION

' Ein Eintrag im Kontextmenue des Code-Felds (PLUGIN_KONTEXT). Er loest
' denselben Weg aus wie ein Befehl ("plugin:<name>:<id>"); bei einem
' Neustart des Plugins wird der alte Eintrag wieder bedienbar.
SUB pluginKontextAnmelden(k AS INTEGER, j AS JSON_HANDLE)
    DIM kennung AS STRING : kennung = "plugin:" + plugins[k].name + ":" + plugText$(j, "id")
    DIM titel AS STRING : titel = plugText$(j, "titel")
    DIM i AS INTEGER : i = ctxNr(kennung)
    IF i >= 0 THEN
        GUI_MENU_ENABLE(ctxEintraege[i].item, TRUE)
        GUI_MENU_TEXT(ctxEintraege[i].item, titel)
        RETURN
    END IF
    IF NOT plugKontextTrenner THEN
        GUI_MENU_SEPARATOR(ctxCode)
        plugKontextTrenner = TRUE
    END IF
    ctxEintrag(ctxCode, titel, kennung)
    protokoll("plugin kontext angemeldet " + kennung)
END SUB

' Beim Ueberfahren: alle Plugins, die "hover" hoeren, bekommen Wort und
' Stelle. Die Antwort kommt Bilder spaeter (pluginHoverAntwort) und haengt
' sich an den Tooltip, wenn die Maus noch dort steht -- ein Plugin, das
' nicht antwortet, haelt so nichts auf.
SUB pluginHoverFragen(ta AS GUI_WIDGET, z AS INTEGER, sp AS INTEGER, wort AS STRING, text AS STRING)
    plugHoverStelle = ""
    IF wort = "" THEN RETURN
    DIM k AS INTEGER
    DIM gefragt AS BOOLEAN : gefragt = FALSE
    FOR k = 0 TO LEN(plugins) - 1
        IF NOT plugins[k].laeuft() THEN CONTINUE
        IF NOT plugins[k].hoertAuf("hover") THEN CONTINUE
        IF NOT gefragt THEN plugHoverNr = plugHoverNr + 1
        gefragt = TRUE
        DIM j AS JSON_HANDLE : j = JSON_PARSE("{}")
        JSON_SET_STRING(j, "art", "hover")
        JSON_SET_INT(j, "nr", plugHoverNr)
        JSON_SET_STRING(j, "wert", wort)
        JSON_SET_INT(j, "zeile", z)
        JSON_SET_INT(j, "spalte", sp)
        DIM d AS STRING : d = ""
        IF aktiverTab >= 0 THEN d = reiter[aktiverTab].pfad
        JSON_SET_STRING(j, "datei", d)
        pluginSenden(k, j)
    NEXT
    IF NOT gefragt THEN RETURN
    plugHoverStelle = tippStelle
    plugHoverFeld = ta
    plugHoverText = text
END SUB

' Beim Vervollstaendigen: alle Plugins, die "vervollstaendigen" hoeren,
' bekommen den Wortanfang und die Stelle. Gefragt wird auch, wenn die Laufzeit
' nichts weiss -- die erste Antwort oeffnet die Liste dann selbst.
SUB pluginVervollFragen(z AS INTEGER, sp AS INTEGER, wort AS STRING)
    plugVervollWort = ""
    DIM k AS INTEGER
    DIM gefragt AS BOOLEAN : gefragt = FALSE
    FOR k = 0 TO LEN(plugins) - 1
        IF NOT plugins[k].laeuft() THEN CONTINUE
        IF NOT plugins[k].hoertAuf("vervollstaendigen") THEN CONTINUE
        IF NOT gefragt THEN plugVervollNr = plugVervollNr + 1
        gefragt = TRUE
        DIM j AS JSON_HANDLE : j = JSON_PARSE("{}")
        JSON_SET_STRING(j, "art", "vervollstaendigen")
        JSON_SET_INT(j, "nr", plugVervollNr)
        JSON_SET_STRING(j, "wert", wort)
        JSON_SET_INT(j, "zeile", z)
        JSON_SET_INT(j, "spalte", sp)
        DIM d AS STRING : d = ""
        IF aktiverTab >= 0 THEN d = reiter[aktiverTab].pfad
        JSON_SET_STRING(j, "datei", d)
        pluginSenden(k, j)
    NEXT
    IF gefragt THEN plugVervollWort = wort
END SUB

FUNCTION vervollHat(e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO GUI_LISTBOX_COUNT(lstVervoll) - 1
        IF GUI_LISTBOX_ITEM(lstVervoll, i) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Die Vorschlaege eines Plugins: nur zur letzten Frage und nur, wenn an der
' Marke noch derselbe Wortanfang steht. Doppelte fallen weg.
SUB pluginVervollAntwort(k AS INTEGER, j AS JSON_HANDLE)
    IF plugZahl(j, "nr") <> plugVervollNr OR plugVervollWort = "" THEN RETURN
    IF vorschlagWort$() <> plugVervollWort THEN RETURN
    IF NOT JSON_HAS(j, "eintraege") THEN RETURN
    DIM neu AS INTEGER : neu = 0
    DIM i AS INTEGER
    FOR i = 0 TO JSON_LEN(j, "eintraege") - 1
        DIM e AS STRING : e = JSON_GET_STRING(j, "eintraege." + STR$(i))
        IF e = "" OR vervollHat(e) THEN CONTINUE
        GUI_LISTBOX_ADD(lstVervoll, e)
        neu = neu + 1
    NEXT
    IF neu = 0 THEN RETURN
    IF NOT vervollOffen THEN
        GUI_LISTBOX_SET_SELECTED(lstVervoll, 0)
        vervollFensterZeigen(FALSE)
    END IF
    protokoll("plugin vorschlaege " + plugins[k].name + " " + STR$(neu))
END SUB

SUB pluginHoverAntwort(k AS INTEGER, j AS JSON_HANDLE)
    DIM t AS STRING : t = TRIM$(plugText$(j, "text"))
    IF t = "" OR plugZahl(j, "nr") <> plugHoverNr THEN RETURN
    IF plugHoverStelle = "" OR plugHoverStelle <> tippStelle THEN RETURN
    DIM teil AS STRING : teil = tippText$(t)
    IF plugHoverText = "" THEN plugHoverText = teil ELSE plugHoverText = plugHoverText + NL + NL + teil
    GUI_TOOLTIP(plugHoverFeld, plugHoverText)
    tippFeld = plugHoverFeld
    protokoll("plugin hover " + plugins[k].name + " " + LEFT$(t, 40))
END SUB

SUB pluginAntwort(k AS INTEGER, j AS JSON_HANDLE)
    DIM a AS JSON_HANDLE : a = JSON_PARSE("{}")
    JSON_SET_STRING(a, "art", "antwort")
    JSON_SET_INT(a, "nr", plugZahl(j, "nr"))
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    DIM wert AS STRING : wert = ""
    SELECT CASE plugText$(j, "was")
        CASE "text" : IF ta >= 0 THEN wert = GUI_TEXT(ta)
        CASE "datei" : IF aktiverTab >= 0 THEN wert = reiter[aktiverTab].pfad
        CASE "auswahl" : IF ta >= 0 THEN wert = GUI_TEXTAREA_SELECTION$(ta)
        CASE "projekt" : wert = projektOrdner
        CASE "wort" : wert = wortAnDerMarke$()
        CASE "marke"
            IF ta >= 0 THEN
                DIM mz AS INTEGER
                DIM ms AS INTEGER
                (mz, ms) = GUI_TEXTAREA_CURSOR(ta)
                wert = STR$(mz) + "," + STR$(ms)
            END IF
    END SELECT
    JSON_SET_STRING(a, "wert", wert)
    pluginSenden(k, a)
END SUB

SUB pluginTue(k AS INTEGER, j AS JSON_HANDLE)
    DIM ta AS GUI_WIDGET : ta = aktivesFeld()
    SELECT CASE plugText$(j, "was")
        CASE "einfuegen" : IF ta >= 0 THEN GUI_TEXTAREA_INSERT(ta, plugText$(j, "text"))
        CASE "meldung" : GUI_SET_TEXT(lblStatus, plugText$(j, "text"))
        CASE "ausgabe" : ausgabe(plugText$(j, "text"))
        CASE "ersetzen", "waehlen"
            ' Mit Datei erst dorthin (oeffnet sie, wenn noetig), ohne der Reiter vorn.
            IF plugText$(j, "datei") <> "" THEN dateiOeffnen(plugText$(j, "datei"))
            ta = aktivesFeld()
            IF ta < 0 THEN RETURN
            DIM z1 AS INTEGER : z1 = MAX(1, plugZahl(j, "zeile"))
            DIM s1 AS INTEGER : s1 = MAX(1, plugZahl(j, "spalte"))
            DIM z2 AS INTEGER : z2 = plugZahl(j, "bis_zeile")
            DIM s2 AS INTEGER : s2 = plugZahl(j, "bis_spalte")
            IF z2 < 1 THEN z2 = z1
            IF s2 < 1 THEN s2 = s1
            GUI_TEXTAREA_SELECT(ta, z1, s1, z2, s2)
            ' Auswahl + INSERT: ein Schritt fuer Strg+Z.
            IF plugText$(j, "was") = "ersetzen" THEN GUI_TEXTAREA_INSERT(ta, plugText$(j, "text"))
            GUI_FOCUS(ta)
        CASE "oeffnen"
            ' Ohne Datei: die Zeile im Reiter vorn (ein ungesicherter Text).
            IF plugText$(j, "datei") <> "" THEN dateiOeffnen(plugText$(j, "datei"))
            DIM zl AS INTEGER : zl = plugZahl(j, "zeile")
            ta = aktivesFeld()
            IF ta >= 0 AND zl > 0 THEN GUI_TEXTAREA_GOTO(ta, zl, 1)
    END SELECT
END SUB

' Die Befunde aller Plugins fuer eine Datei hinten an die Meldungen von
' CODE_CHECK$ (`liste`, ein JSON-Feld), in derselben Form: Zeile, Spalte,
' Laenge, Meldung mit dem Namen des Plugins davor, Schwere, Korrekturen.
' Ohne Spalte gilt die Zeile ohne Einrueckung, wie bei der Laufzeit.
SUB pluginBefundeAnhaengen(datei AS STRING, liste AS JSON_HANDLE, text AS STRING)
    IF datei = "" OR LEN(MAPKEYS(plugBefunde)) = 0 THEN RETURN
    DIM d AS STRING : d = wegGleich$(datei)
    DIM tz AS ARRAY OF STRING : tz = SPLIT$(text, NL)
    DIM bk AS STRING
    FOR EACH bk IN MAPKEYS(plugBefunde)
        DIM t AS INTEGER : t = INSTR(bk, "|")
        IF MID$(bk, t + 1) <> d THEN CONTINUE
        DIM bl AS JSON_HANDLE : bl = JSON_PARSE(MAPGET(plugBefunde, bk))
        DIM i AS INTEGER
        FOR i = 0 TO JSON_LEN(bl, "") - 1
            DIM p AS STRING : p = STR$(i)
            DIM z AS INTEGER : z = plugZahl(bl, p + ".zeile")
            DIM sp AS INTEGER : sp = plugZahl(bl, p + ".spalte")
            DIM ln AS INTEGER : ln = plugZahl(bl, p + ".laenge")
            IF sp < 1 AND z >= 1 AND z <= LEN(tz) THEN
                DIM zt AS STRING : zt = RTRIM$(REPLACE$(tz[z - 1], CHR$(13), ""))
                sp = LEN(zt) - LEN(LTRIM$(zt)) + 1
                ln = MAX(1, LEN(LTRIM$(zt)))
            END IF
            IF sp < 1 THEN sp = 1
            IF ln < 1 THEN ln = 1
            DIM b AS JSON_HANDLE : b = JSON_PARSE("{}")
            JSON_SET_INT(b, "zeile", z)
            JSON_SET_INT(b, "spalte", sp)
            JSON_SET_INT(b, "laenge", ln)
            JSON_SET_STRING(b, "meldung", "[" + LEFT$(bk, t) + "] " + plugText$(bl, p + ".meldung"))
            DIM sw AS STRING : sw = LOWER$(plugText$(bl, p + ".schwere"))
            JSON_SET_STRING(b, "schwere", IIF(sw = "fehler" OR sw = "hinweis", sw, "warnung"))
            IF JSON_HAS(bl, p + ".korrekturen") THEN JSON_SET_JSON(b, "korrekturen", JSON_GET_JSON(bl, p + ".korrekturen"))
            JSON_APPEND_JSON(liste, "", b)
        NEXT
    NEXT
END SUB

SUB pluginSchnipselWeg(name AS STRING)
    DIM i AS INTEGER : i = LEN(plugSchnipsel) - 1
    DIM weg AS BOOLEAN : weg = FALSE
    WHILE i >= 0
        IF plugSchnipsel[i].herkunft = "Plugin " + name THEN
            ARRAY_REMOVE_AT(plugSchnipsel, i)
            weg = TRUE
        END IF
        i = i - 1
    WEND
    IF weg THEN schnipselLaden()
END SUB

SUB pluginFaerbungWeg(name AS STRING)
    DIM i AS INTEGER : i = LEN(plugFaerbungen) - 1
    WHILE i >= 0
        IF plugFaerbungen[i].vonPlugin = name THEN ARRAY_REMOVE_AT(plugFaerbungen, i)
        i = i - 1
    WEND
    faerbSchluessel = ""
END SUB

' Ein Feld einer Dateiart, fuer die ein Plugin Regeln angemeldet hat: deren
' Treffer im Ausschnitt faerben, zeilenweise wie die Suche. FALSE heisst:
' keine Regel, die Faerbung fuer Drachenhauch gilt.
FUNCTION pluginFaerben(ta AS GUI_WIDGET, stueck AS STRING, von AS INTEGER) AS BOOLEAN
    IF LEN(plugFaerbungen) = 0 THEN RETURN FALSE
    DIM pfad AS STRING : pfad = ""
    DIM i AS INTEGER
    FOR i = 0 TO tabAnzahl - 1
        IF reiter[i].feld = ta THEN pfad = reiter[i].pfad
    NEXT
    DIM pkt AS INTEGER : pkt = INSTRREV(pfad, ".")
    IF pkt < 0 THEN RETURN FALSE
    DIM endung AS STRING : endung = LOWER$(MID$(pfad, pkt))
    DIM s2 AS ARRAY OF INTEGER : s2 = []
    DIM l2 AS ARRAY OF INTEGER : l2 = []
    DIM f2 AS ARRAY OF INTEGER : f2 = []
    DIM treffer AS BOOLEAN : treffer = FALSE
    DIM zeilen AS ARRAY OF STRING : zeilen = SPLIT$(stueck, NL)
    FOR i = 0 TO LEN(plugFaerbungen) - 1
        IF plugFaerbungen[i].endung <> endung THEN CONTINUE
        treffer = TRUE
        DIM off AS INTEGER : off = 0
        DIM zi AS INTEGER
        FOR zi = 0 TO LEN(zeilen) - 1
            DIM ab AS INTEGER : ab = 0
            DIM wie AS INTEGER : wie = 0
            WHILE ab <= LEN(zeilen[zi]) AND wie < 200
                DIM sp AS INTEGER
                DIM sl AS INTEGER
                TRY
                    (sp, sl) = REGEX_FIND_POS(zeilen[zi], plugFaerbungen[i].muster, ab)
                CATCH fe
                    sp = -1
                END TRY
                IF sp < 0 THEN BREAK
                IF sl > 0 THEN
                    ARRAY_PUSH(s2, von + off + sp) : ARRAY_PUSH(l2, sl) : ARRAY_PUSH(f2, plugFaerbungen[i].farbe)
                END IF
                ab = sp + MAX(sl, 1)
                wie = wie + 1
            WEND
            off = off + LEN(zeilen[zi]) + 1
        NEXT
    NEXT
    IF NOT treffer THEN RETURN FALSE
    GUI_TEXTAREA_SPANS(ta, s2, l2, f2)
    RETURN TRUE
END FUNCTION

' --- Plugins verwalten (Plugins -> Plugins verwalten ...) -------------------
DIM winPlug AS GUI_WINDOW : winPlug = GUI_WINDOW(tr$("Plugins"), 260, 120, 560, 420)
GUI_WINDOW_CLOSABLE(winPlug, TRUE)
