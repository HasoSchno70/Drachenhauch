=== die mittlere taste meldet von ueberall auf dem reiter
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 580, 380)
GUI_TABS(w, ["eins", "zwei"])
GUI_TABS_CLOSABLE(w, TRUE)
AUTOMATION_PLAY("ev.txt")
DIM zu AS INTEGER : zu = -9
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_TAB_CLOSED(w) >= 0 THEN zu = GUI_TAB_CLOSED(w)
    n = n + 1
    IF n = 30 THEN PRINT "zu " + STR$(zu) + " aktiv " + STR$(GUI_ACTIVE_TAB(w))
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
# Mittlere Taste auf der Beschriftung des zweiten Reiters
c 4
e 4 7 100 36 0 0 // Maus hin
e 5 7 100 36 0 0 // Maus hin
e 6 6 2 0 0 0 // mittlere Taste runter
e 8 5 2 0 0 0 // mittlere Taste hoch
--- umgebung
DHRT_FRAMES=40
--- erwartet
zu 1 aktiv 0

=== die meldung gilt genau ein bild
IMPORT "gui"
SCREEN(600, 400, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 580, 380)
GUI_TABS(w, ["eins", "zwei"])
GUI_TABS_CLOSABLE(w, TRUE)
AUTOMATION_PLAY("ev.txt")
DIM bilder AS INTEGER : bilder = 0
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    IF GUI_TAB_CLOSED(w) >= 0 THEN bilder = bilder + 1
    n = n + 1
    IF n = 30 THEN PRINT "bilder " + STR$(bilder)
    CLS(&H101820)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
# Klick aufs Kreuz, Taste laenger gehalten
c 4
e 4 7 69 36 0 0 // Maus hin
e 5 7 69 36 0 0 // Maus hin
e 6 6 0 0 0 0 // Taste runter
e 20 5 0 0 0 0 // Taste hoch
--- umgebung
DHRT_FRAMES=40
--- erwartet
bilder 1
