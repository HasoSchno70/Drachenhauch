=== globale werden erst nach dem aufruf uebernommen
DIM zaehler AS INTEGER
DIM summe AS FLOAT
DIM an AS BOOLEAN
SUB schritt(k AS INTEGER)
    zaehler = zaehler + 1
    summe = summe + k * 0.5
    IF zaehler > 5 THEN an = TRUE
END SUB
FUNCTION lauf(n AS INTEGER) AS INTEGER
    DIM i AS INTEGER
    FOR i = 1 TO n
        schritt(i)
    NEXT
    RETURN zaehler
END FUNCTION
PRINT lauf(10); " "; summe; " "; an
zaehler = 9223372036854775806
TRY
    PRINT lauf(3)
CATCH e
    PRINT "fehler: "; LEFT$(e, 30)
END TRY
PRINT zaehler; " "; summe
zaehler = 0
PRINT lauf(2); " "; zaehler
--- erwartet
10 27.5 TRUE
fehler: Ganzzahl-Ueberlauf bei '+' (IN
9223372036854775807 28.0
2 2

