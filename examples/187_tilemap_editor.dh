' ============================================================
'  DRACHENHAUCH -- Tilemap-Editor (dritter Editor-Pilot)
' ============================================================
'  Nachbau des Qt-Werkzeugs `dhtilemap` in Drachenhauch selbst.
'
'  Die ersten beiden Piloten (SFX-Generator, Partikel-Editor) waren
'  REGLER-Editoren: viele Zahlen, eine Vorschau, kein Dateiformat. Dieser
'  hier stammt aus einer anderen Familie -- Werkzeuge mit Zugbewegung, eine
'  Auswahl mit Zwischenablage, Rueckgaengig/Wiederholen und eine Datei, die
'  ein FREMDES Programm lesen koennen muss (Tiled-JSON).
'
'  Was drin ist:
'    Werkzeuge   Stift, Radierer, Fuellen, Rechteck, Pipette, Auswahl
'    Auswahl     Strg+C/X/V kopieren/ausschneiden/einfuegen, Entf leert
'    Ebenen      anlegen, umbenennen, ein-/ausblenden, loeschen und
'                umsortieren -- die Reihenfolge IST die Zeichenreihenfolge,
'                die erste Ebene liegt hinten
'    Kacheln     Eigenschaften je Kachel ([solid] und beliebige
'                Schluessel/Werte) -- sie gehoeren dem Tileset, gelten also
'                fuer jedes Vorkommen dieser Kachel
'    Ansicht     Zoom 1..6, schieben (rechte Maustaste oder Pfeiltasten),
'                Gitter, Kachelnummern
'    Datei       Neu / Oeffnen / Speichern -- echtes Tiled-JSON
'    Historie    Strg+Z / Strg+Y, 16 Schritte
'
'    Ausgabe     [GB-Code] schreibt einen lauffaehigen Renderer, die Karte
'                als Tiled-JSON und das Tileset-Bild -- alle drei unter
'                demselben Namen, damit keins ins Leere zeigt
'
'    Objekte     Objekt-Ebenen fuer Spawns, Trigger und Zonen: ziehen legt
'                ein Rechteck an, klicken einen PUNKT (Tiled: Breite und
'                Hoehe 0), ein Klick auf ein vorhandenes waehlt es aus.
'                Name und Typ aendern, Entf entfernt
'
'    Tilesets   mehrere je Karte ([+] haengt eins an, die Klappliste
'                schaltet um). Jede Kachel wird mit IHREM Tileset gezeichnet,
'                die Pipette schaltet mit um
'
'  Was NICHT drin ist (wie bei den anderen Piloten offen gesagt):
'    ein Tileset wieder ENTFERNEN -- dabei verschoeben sich die GIDs
'    dahinter, und jede damit gemalte Kachel zeigte danach stumm auf ein
'    anderes Bild. Rueckgaengig deckt KACHEL-Aenderungen ab, nicht das
'    Anlegen/Loeschen von Ebenen, nicht die Kachel-Eigenschaften und nicht
'    die Objekte -- die Ebenen-NUMMERN darin wandern beim Umsortieren aber
'    mit, sonst schriebe ein Rueckgaengig danach in die falsche Ebene.
'
'  [ESC] Ende
' ============================================================
IMPORT "gui"
IMPORT "tiled"
IMPORT "imgfx"   ' IMAGE_SAVE fuer das Tileset neben dem Code

SCREEN(1400, 880, "Drachenhauch - Tilemap-Editor", 1)
SET_FULLSCREEN(TRUE)
SETFPS(60)

DIM uiFont AS INTEGER : uiFont = -1
DIM fp AS STRING
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "C:/Windows/Fonts/calibri.ttf")
    IF uiFont < 0 AND FILEEXISTS(fp) THEN uiFont = LOADFONT(fp, 30)
NEXT
IF uiFont >= 0 THEN SETFONT(uiFont)
TEXT_SIZE(15)
GUI_THEME_PRESET("glas_dunkel")

' ---------------------------------------------------------------- Groessen
CONST KACHEL = 16              ' Kantenlaenge einer Kachel im Tileset
CONST MAXB = 128               ' Obergrenze der Karte -- sie bestimmt, wie
CONST MAXH = 128               ' gross der Verlauf-Speicher unten wird.
CONST MAXZELLEN = MAXB * MAXH
CONST UNDO_MAX = 16
CONST PZ = 2                   ' Vergroesserung der Kachel-Auswahl links
CONST LINKS = 300              ' Breite der linken Spalte
CONST TB_H = 46                  ' Hoehe der Werkzeugleiste
CONST FUSS = 28                ' Hoehe der Statuszeile

DIM SW AS INTEGER : SW = SCREENWIDTH()
DIM SH AS INTEGER : SH = SCREENHEIGHT()

' --------------------------------------------------------------- Tilesets
' Eine Karte darf mehrere Tilesets mitbringen. Jedes hat einen eigenen
' GID-Bereich (`firstgid` .. `firstgid + Kachelzahl`), und die Zuordnung
' GID -> Tileset laeuft ueber genau diese Kette -- deshalb vergibt die
' Laufzeit die firstgid selbst und niemand hier rechnet sie nach.
'
' Die Palette zeigt immer EINES davon (`tsAkt`); gemalt wird eine GID aus
' dessen Bereich. Gezeichnet wird dagegen JEDE Kachel mit ihrem eigenen
' Tileset -- eine Ebene kann Kacheln aus allen enthalten.
CONST MAXTS = 8
DIM tsPfadA[MAXTS] AS STRING
DIM tsBildA[MAXTS] AS IMAGE
DIM tsSpA[MAXTS] AS INTEGER
DIM tsReA[MAXTS] AS INTEGER
DIM tsNA[MAXTS] AS INTEGER
' Liegt das Bild da? Fehlt es, bleiben SEINE Kacheln leer statt mit einem
' fremden Bild gefuellt zu werden -- das saehe richtig aus und waere falsch.
DIM tsDaA[MAXTS] AS BOOLEAN
DIM tsAnz AS INTEGER : tsAnz = 0
DIM tsAkt AS INTEGER : tsAkt = 0

' Spiegel des aktiven Tilesets. Die Palette rechnet damit, und die Spiegel
' stehen an EINER Stelle (`tsSpiegeln`) -- zwei Quellen fuer dieselbe Zahl
' laufen auseinander, sobald eine Stelle das Umschalten vergisst.
DIM tsPfad AS STRING : tsPfad = "assets/editor_tileset.png"
DIM tsBild AS IMAGE  : tsBild = LOADIMAGE(tsPfad)
DIM tsSp AS INTEGER  : tsSp = IMAGEWIDTH(tsBild) \ KACHEL
DIM tsRe AS INTEGER  : tsRe = IMAGEHEIGHT(tsBild) \ KACHEL
DIM tsN AS INTEGER   : tsN = tsSp * tsRe

' Ausschnitt der Kachel-Auswahl -- ein Tileset kann groesser sein als der
' Platz in der linken Spalte.
DIM palSp AS INTEGER : palSp = 0       ' erste sichtbare Spalte
DIM palZe AS INTEGER : palZe = 0       ' erste sichtbare Zeile

' ---------------------------------------------------------------- Zustand
DIM karte AS TILED_MAP
DIM kb AS INTEGER : kb = 40            ' Kartenbreite in Kacheln
DIM kh AS INTEGER : kh = 30
DIM ebene AS INTEGER : ebene = 0       ' aktive Ebene
DIM gewaehlt AS INTEGER : gewaehlt = 0 ' gewaehlte Kachel (0-basiert im Tileset)
DIM dateiname AS STRING : dateiname = ""
DIM geaendert AS BOOLEAN : geaendert = FALSE

DIM zoom AS INTEGER : zoom = 2
DIM panX AS INTEGER : panX = 0
DIM panY AS INTEGER : panY = 0

DIM werkzeug AS INTEGER : werkzeug = 0
CONST WZ_STIFT = 0
CONST WZ_RADIER = 1
CONST WZ_FUELL = 2
CONST WZ_RECHT = 3
CONST WZ_PIPETTE = 4
CONST WZ_AUSWAHL = 5

' Zugbewegung: Anker der laufenden Geste in Kachelkoordinaten.
DIM zieht AS BOOLEAN : zieht = FALSE
DIM ankerX AS INTEGER : ankerX = 0
DIM ankerY AS INTEGER : ankerY = 0
DIM schiebt AS BOOLEAN : schiebt = FALSE
DIM schiebX AS INTEGER : schiebX = 0
DIM schiebY AS INTEGER : schiebY = 0

' Auswahl + Zwischenablage.
DIM selAn AS BOOLEAN : selAn = FALSE
DIM selX AS INTEGER : selX = 0
DIM selY AS INTEGER : selY = 0
DIM selB AS INTEGER : selB = 0
DIM selH AS INTEGER : selH = 0
DIM clip[MAXZELLEN] AS INTEGER
DIM clipB AS INTEGER : clipB = 0
DIM clipH AS INTEGER : clipH = 0

' Verlauf: je Schritt der Zustand der BETROFFENEN Ebene davor und danach.
' Eine Momentaufnahme der ganzen Karte waere bei mehreren Ebenen ein
' Vielfaches davon, und ein Werkzeug fasst immer nur eine Ebene an.
DIM uVor[UNDO_MAX, MAXZELLEN] AS INTEGER
DIM uNach[UNDO_MAX, MAXZELLEN] AS INTEGER
DIM uEbene[UNDO_MAX] AS INTEGER
DIM uStart AS INTEGER : uStart = 0     ' Ringpuffer: aeltester Schritt
DIM uAnz AS INTEGER : uAnz = 0         ' aufgezeichnete Schritte
DIM uPos AS INTEGER : uPos = 0         ' davon geltend (Rest = wiederholbar)
DIM puffer[MAXZELLEN] AS INTEGER

' Objekt-Ebenen. Der Verlauf (Strg+Z) fasst sie NICHT an -- er speichert das
' Kachelfeld einer Ebene, und eine Objektebene hat keins.
DIM objSel AS INTEGER : objSel = -1    ' gewaehltes Objekt der aktiven Ebene
DIM objZieht AS BOOLEAN : objZieht = FALSE
DIM objAx AS INTEGER : objAx = 0       ' Anker des Zugs in KARTEN-Punkten
DIM objAy AS INTEGER : objAy = 0
DIM objBx AS INTEGER : objBx = 0
DIM objBy AS INTEGER : objBy = 0

' ============================================================ Hilfsmittel

FUNCTION basisGid() AS INTEGER
    ' Kachel 0 des AKTIVEN Tilesets -- die Palette malt aus dessen Bereich.
    IF TILED_TILESET_COUNT(karte) = 0 THEN RETURN 1
    RETURN TILED_TILESET_FIRSTGID(karte, MIN(tsAkt, TILED_TILESET_COUNT(karte) - 1))
END FUNCTION

FUNCTION tsFuerGid(g AS INTEGER) AS INTEGER
    ' Welches Tileset gehoert zu dieser GID? Von hinten gesucht: das letzte,
    ' dessen Bereich sie noch trifft. Eine GID ausserhalb aller Bereiche
    ' (fremde Datei, geloeschtes Tileset) gibt -1 statt eines falschen Bildes.
    DIM i AS INTEGER
    FOR i = tsAnz - 1 TO 0 STEP -1
        DIM fg AS INTEGER : fg = TILED_TILESET_FIRSTGID(karte, i)
        IF g >= fg AND g < fg + tsNA[i] THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB tsSpiegeln()
    IF tsAnz = 0 THEN RETURN
    tsAkt = MAX(0, MIN(tsAkt, tsAnz - 1))
    tsPfad = tsPfadA[tsAkt]
    tsBild = tsBildA[tsAkt]
    tsSp = tsSpA[tsAkt]
    tsRe = tsReA[tsAkt]
    tsN = tsNA[tsAkt]
END SUB

FUNCTION zell() AS INTEGER
    RETURN KACHEL * zoom
END FUNCTION

SUB neueKarte(b AS INTEGER, h AS INTEGER)
    kb = b : kh = h
    karte = TILED_NEW(kb, kh, KACHEL, KACHEL)
    ' Die neue Karte beginnt mit dem Tileset, mit dem gerade gearbeitet
    ' wurde -- die anderen sind weg, weil ihre GIDs zu nichts mehr gehoeren.
    DIM t AS INTEGER : t = TILED_ADD_TILESET(karte, tsPfad, tsN)
    DIM e AS INTEGER : e = TILED_ADD_LAYER(karte, "Boden")
    tilesetsLaden()
    ebene = 0
    panX = 0 : panY = 0
    selAn = FALSE
    uStart = 0 : uAnz = 0 : uPos = 0
    dateiname = ""
    geaendert = FALSE
END SUB

' ---------------------------------------------------------------- Verlauf
SUB schrittBeginn()
    DIM i AS INTEGER
    FOR i = 0 TO kb * kh - 1
        puffer[i] = TILED_TILE_AT(karte, ebene, i MOD kb, i \ kb)
    NEXT
END SUB

SUB schrittEnde()
    DIM n AS INTEGER : n = kb * kh
    DIM i AS INTEGER
    DIM anders AS BOOLEAN : anders = FALSE
    FOR i = 0 TO n - 1
        IF TILED_TILE_AT(karte, ebene, i MOD kb, i \ kb) <> puffer[i] THEN
            anders = TRUE
            BREAK
        END IF
    NEXT
    IF anders THEN
        uAnz = uPos                    ' alles Wiederholbare verfaellt
        IF uAnz = UNDO_MAX THEN
            ' Ringpuffer: der aelteste Schritt faellt weg. Die Eintraege zu
            ' verschieben waere bei 16 x 16384 Zahlen ein spuerbarer Ruckler.
            uStart = (uStart + 1) MOD UNDO_MAX
            uAnz = uAnz - 1
        END IF
        DIM s AS INTEGER : s = (uStart + uAnz) MOD UNDO_MAX
        FOR i = 0 TO n - 1
            uVor[s, i] = puffer[i]
            uNach[s, i] = TILED_TILE_AT(karte, ebene, i MOD kb, i \ kb)
        NEXT
        uEbene[s] = ebene
        uAnz = uAnz + 1
        uPos = uAnz
        geaendert = TRUE
    END IF
END SUB

SUB verlaufAnwenden(s AS INTEGER, nachher AS BOOLEAN)
    ebene = uEbene[s]
    DIM i AS INTEGER
    FOR i = 0 TO kb * kh - 1
        IF nachher THEN
            TILED_TILE_SET(karte, ebene, i MOD kb, i \ kb, uNach[s, i])
        ELSE
            TILED_TILE_SET(karte, ebene, i MOD kb, i \ kb, uVor[s, i])
        END IF
    NEXT
    geaendert = TRUE
END SUB

' Ein aufgezeichneter Schritt merkt sich die NUMMER seiner Ebene. Stellt
' man die Ebenen um, zeigt sie auf eine andere -- ein Rueckgaengig schriebe
' dann in die falsche, ohne dass etwas meldete. Die Nummern wandern deshalb
' mit, statt den Verlauf zu leeren: die Arbeit davor ist ja noch gueltig.
SUB ebeneVerschieben(richtung AS INTEGER)
    DIM ziel AS INTEGER : ziel = ebene + richtung
    IF ziel < 0 OR ziel >= TILED_LAYER_COUNT(karte) THEN RETURN
    TRY
        TILED_MOVE_LAYER(karte, ebene, ziel)
    CATCH e
        meldung = e
        RETURN
    END TRY
    verlaufUmnummerieren(ebene, ziel)
    ebene = ziel
    geaendert = TRUE
    listeAuffrischen()
    objListeAuffrischen()
    meldung = "'" + TILED_LAYER_NAME(karte, ebene) + "' liegt jetzt weiter " + _
              IIF(richtung < 0, "hinten", "vorne")
END SUB

SUB verlaufUmnummerieren(von AS INTEGER, nach AS INTEGER)
    DIM i AS INTEGER
    FOR i = 0 TO uAnz - 1
        DIM s AS INTEGER : s = (uStart + i) MOD UNDO_MAX
        DIM e AS INTEGER : e = uEbene[s]
        IF e = von THEN
            uEbene[s] = nach
        ELSEIF von < nach AND e > von AND e <= nach THEN
            uEbene[s] = e - 1
        ELSEIF von > nach AND e >= nach AND e < von THEN
            uEbene[s] = e + 1
        END IF
    NEXT
END SUB

' Ein Schritt gehoert zu SEINER Ebene, und `verlaufAnwenden` schaltet
' dorthin zurueck -- die Anzeige muss also mit. Ohne das zeigte die linke
' Spalte nach einem Strg+Z die Bloecke der vorigen Ebene.
SUB verlaufAnzeige()
    objSel = -1
    listeAuffrischen()
    objListeAuffrischen()
    bloeckeUmschalten()
END SUB

SUB zurueck()
    IF uPos > 0 THEN
        uPos = uPos - 1
        verlaufAnwenden((uStart + uPos) MOD UNDO_MAX, FALSE)
        verlaufAnzeige()
    END IF
END SUB

SUB wieder()
    IF uPos < uAnz THEN
        verlaufAnwenden((uStart + uPos) MOD UNDO_MAX, TRUE)
        uPos = uPos + 1
        verlaufAnzeige()
    END IF
END SUB

' ============================================================ Oberflaeche

DIM win AS GUI_WINDOW
win = GUI_WINDOW("Tilemap", 0, 0, SW, SH)
GUI_WINDOW_CHROME(win, FALSE)

DIM tb AS GUI_WIDGET : tb = GUI_TOOLBAR(win, 0, 0, SW, TB_H)
GUI_SET_ANCHOR(tb, "lr")

DIM bNeu AS GUI_WIDGET  : bNeu  = GUI_BUTTON(win, "Neu", 10, 7, 62, 32)
DIM bAuf AS GUI_WIDGET  : bAuf  = GUI_BUTTON(win, "Oeffnen", 76, 7, 84, 32)
DIM bSpei AS GUI_WIDGET : bSpei = GUI_BUTTON(win, "Speichern", 164, 7, 100, 32)
DIM bCode AS GUI_WIDGET : bCode = GUI_BUTTON(win, "GB-Code", 268, 7, 104, 32)
GUI_TOOLTIP(bCode, "Ein lauffaehiger Renderer + Karte + Tileset daneben -- alles unter einem Namen")

' Werkzeuge. GUI_TOGGLE waere das naheliegende Widget, ist aber ein
' SCHIEBEschalter: schmal, mit dem Text daneben statt darin -- sechs davon
' in einer Reihe sind weder lesbar noch treffsicher. Also Knoepfe, und das
' aktive Werkzeug faerbt sich selbst.
CONST WZ_B = 92                          ' Knopfbreite
DIM wzName AS ARRAY OF STRING
wzName = SPLIT$("Stift|Radierer|Fuellen|Rechteck|Pipette|Auswahl", "|")
DIM wzKnopf[6] AS GUI_WIDGET
DIM wx AS INTEGER : wx = 384
DIM i AS INTEGER
FOR i = 0 TO 5
    wzKnopf[i] = GUI_BUTTON(win, wzName[i], wx, 7, WZ_B, 32)
    wx = wx + WZ_B + 4
NEXT

DIM bZur AS GUI_WIDGET : bZur = GUI_BUTTON(win, "Zurueck", wx + 10, 7, 84, 32)
DIM bVor AS GUI_WIDGET : bVor = GUI_BUTTON(win, "Vor", wx + 98, 7, 60, 32)
DIM cbGitter AS GUI_WIDGET : cbGitter = GUI_CHECKBOX(win, "Gitter", wx + 168, 15, TRUE)
DIM cbNr AS GUI_WIDGET : cbNr = GUI_CHECKBOX(win, "Nummern", wx + 250, 15, FALSE)

' --------------------------------------------------------- linke Spalte
DIM y AS INTEGER : y = TB_H + 10
DIM lbl AS GUI_WIDGET
lbl = GUI_LABEL(win, "Kacheln", 12, y) : y = y + 22

' Welches Tileset die Palette zeigt. Entfernen gibt es NICHT: die GIDs
' dahinter wuerden sich verschieben, und jede damit gemalte Kachel zeigte
' danach stumm auf ein anderes Bild.
DIM ddTs AS GUI_WIDGET
ddTs = GUI_DROPDOWN(win, 12, y, LINKS - 24 - 38, 26, SPLIT$("tileset", "|"))
DIM bTsNeu AS GUI_WIDGET
bTsNeu = GUI_BUTTON(win, "+", LINKS - 12 - 32, y, 32, 26)
y = y + 32

' Die Palette ist ein AUSSCHNITT fester Groesse: ein zweites Tileset hat
' selten dieselben Masse wie das erste, und die Spalte darunter darf nicht
' bei jedem Umschalten wandern. Was nicht hineinpasst, wird gerollt.
CONST PAL_SP = 8                           ' sichtbare Spalten
CONST PAL_RE = 4                           ' sichtbare Zeilen
DIM palH AS INTEGER : palH = PAL_RE * KACHEL * PZ
DIM palette AS GUI_WIDGET
palette = GUI_CANVAS(win, 12, y, PAL_SP * KACHEL * PZ, palH)
y = y + palH + 14

lbl = GUI_LABEL(win, "Ebenen   (weiter unten = weiter vorne)", 12, y) : y = y + 22
DIM lstEbenen AS GUI_WIDGET
lstEbenen = GUI_LISTBOX(win, 12, y, LINKS - 24, 132, SPLIT$("Boden", "|"))
y = y + 140

DIM edName AS GUI_WIDGET
edName = GUI_TEXTINPUT(win, 12, y, LINKS - 24, 28, "Boden")
y = y + 34

DIM bEbNeu AS GUI_WIDGET  : bEbNeu  = GUI_BUTTON(win, "Anlegen", 12, y, 86, 28)
DIM bEbUm AS GUI_WIDGET   : bEbUm   = GUI_BUTTON(win, "Umbenennen", 102, y, 116, 28)
DIM bEbWeg AS GUI_WIDGET  : bEbWeg  = GUI_BUTTON(win, "Weg", 222, y, 54, 28)
y = y + 36
' Nach der ZEICHENwirkung benannt, nicht nach der Liste: "hoch/runter"
' waere doppeldeutig, weil die Liste die hinterste Ebene oben zeigt.
DIM bEbHinten AS GUI_WIDGET
bEbHinten = GUI_BUTTON(win, "Nach hinten", 12, y, 130, 28)
DIM bEbVorne AS GUI_WIDGET
bEbVorne = GUI_BUTTON(win, "Nach vorne", 146, y, 130, 28)
y = y + 36
DIM cbSicht AS GUI_WIDGET : cbSicht = GUI_CHECKBOX(win, "sichtbar", 12, y, TRUE)
DIM bObjEbene AS GUI_WIDGET
bObjEbene = GUI_BUTTON(win, "Objekt-Ebene", 126, y - 6, 150, 28)
GUI_TOOLTIP(bObjEbene, "Eine Ebene fuer Spawns, Trigger und Zonen -- ohne Kacheln")
y = y + 32

' Ab hier zwei Bloecke auf DEMSELBEN Platz: welcher zu sehen ist, entscheidet
' die Art der aktiven Ebene. Untereinander waere die Spalte laenger als der
' Schirm -- und sinnvoll ist ohnehin immer nur einer: auf einer Kachelebene
' gibt es keine Objekte, auf einer Objektebene keine Kacheln.
DIM blockY AS INTEGER : blockY = y

' --- Block A: Eigenschaften der GEWAEHLTEN Palettenkachel. Sie gehoeren dem
' Tileset, nicht der Karte, gelten also fuer jedes Vorkommen dieser Kachel.
DIM lblProp AS GUI_WIDGET
lblProp = GUI_LABEL(win, "Eigenschaften der Kachel", 12, y) : y = y + 22
DIM cbSolid AS GUI_WIDGET : cbSolid = GUI_CHECKBOX(win, "solid", 12, y, FALSE)
GUI_TOOLTIP(cbSolid, "Die haeufigste Eigenschaft -- genau sie fragt tile_collide ab")
y = y + 28
DIM lstProp AS GUI_WIDGET
lstProp = GUI_LISTBOX(win, 12, y, LINKS - 24, 88, SPLIT$("", "|"))
y = y + 96
DIM edKey AS GUI_WIDGET : edKey = GUI_TEXTINPUT(win, 12, y, 130, 28, "damage")
DIM edWert AS GUI_WIDGET : edWert = GUI_TEXTINPUT(win, 148, y, 128, 28, "5")
y = y + 34
DIM bPropSetz AS GUI_WIDGET : bPropSetz = GUI_BUTTON(win, "Setzen", 12, y, 100, 28)
DIM bPropWeg AS GUI_WIDGET : bPropWeg = GUI_BUTTON(win, "Weg", 116, y, 80, 28)
GUI_TOOLTIP(bPropWeg, "Die in der Liste gewaehlte Eigenschaft entfernen")

' --- Block B: die Objekte der aktiven Objekt-Ebene.
y = blockY
DIM lblObj AS GUI_WIDGET
lblObj = GUI_LABEL(win, "Objekte  (ziehen legt eins an)", 12, y) : y = y + 22
DIM lstObj AS GUI_WIDGET
lstObj = GUI_LISTBOX(win, 12, y, LINKS - 24, 110, SPLIT$("", "|"))
y = y + 118
DIM edObjName AS GUI_WIDGET : edObjName = GUI_TEXTINPUT(win, 12, y, 130, 28, "held")
DIM edObjTyp AS GUI_WIDGET : edObjTyp = GUI_TEXTINPUT(win, 148, y, 128, 28, "spawn")
GUI_TOOLTIP(edObjName, "Name des NAECHSTEN Objekts -- und mit [Uebernehmen] auch des gewaehlten")
y = y + 34
DIM bObjUeb AS GUI_WIDGET : bObjUeb = GUI_BUTTON(win, "Uebernehmen", 12, y, 130, 28)
DIM bObjWeg AS GUI_WIDGET : bObjWeg = GUI_BUTTON(win, "Objekt weg", 148, y, 128, 28)

' Die beiden Bloecke als Listen -- so laeuft das Umschalten ueber EINE
' Schleife, und ein spaeter dazukommendes Widget wird nicht vergessen.
' Platzweise gefuellt, nicht als Feld-Literal: `[a, b, c]` aus Widget-Nummern
' kommt als ARRAY OF INTEGER heraus und passt dann nicht in ein
' ARRAY OF GUI_WIDGET -- der Fehler faellt erst zur Laufzeit auf.
DIM blockA[7] AS GUI_WIDGET
blockA[0] = lblProp : blockA[1] = cbSolid : blockA[2] = lstProp
blockA[3] = edKey : blockA[4] = edWert : blockA[5] = bPropSetz
blockA[6] = bPropWeg
DIM blockB[6] AS GUI_WIDGET
blockB[0] = lblObj : blockB[1] = lstObj : blockB[2] = edObjName
blockB[3] = edObjTyp : blockB[4] = bObjUeb : blockB[5] = bObjWeg

' --------------------------------------------------------- Karten-Flaeche
DIM leinwand AS GUI_WIDGET
leinwand = GUI_CANVAS(win, LINKS, TB_H + 8, SW - LINKS - 10, SH - TB_H - FUSS - 16)
GUI_SET_ANCHOR(leinwand, "lrtb")

DIM status AS GUI_WIDGET
status = GUI_LABEL(win, "", 12, SH - FUSS + 4)
GUI_SET_ANCHOR(status, "lb")

' ------------------------------------------------- Fenster "Neue Karte"
DIM winNeu AS GUI_WINDOW
winNeu = GUI_WINDOW("Neue Karte", SW \ 2 - 150, SH \ 2 - 90, 300, 170)
DIM lblB AS GUI_WIDGET : lblB = GUI_LABEL(winNeu, "Breite", 16, 16)
DIM spB AS GUI_WIDGET  : spB = GUI_SPINNER(winNeu, 110, 12, 160, 4, MAXB, 40)
DIM lblH AS GUI_WIDGET : lblH = GUI_LABEL(winNeu, "Hoehe", 16, 52)
DIM spH AS GUI_WIDGET  : spH = GUI_SPINNER(winNeu, 110, 48, 160, 4, MAXH, 30)
DIM bNeuOk AS GUI_WIDGET : bNeuOk = GUI_BUTTON(winNeu, "Anlegen", 110, 92, 90, 30)
DIM bNeuAb AS GUI_WIDGET : bNeuAb = GUI_BUTTON(winNeu, "Abbrechen", 206, 92, 90, 30)
GUI_WINDOW_VISIBLE(winNeu, FALSE)

' ======================================================== Objekt-Ebenen

FUNCTION istObjEbene() AS BOOLEAN
    RETURN TILED_LAYER_TYPE(karte, ebene) = "object"
END FUNCTION

FUNCTION ebenenName$() AS STRING
    RETURN TILED_LAYER_NAME(karte, ebene)
END FUNCTION

' Welcher der beiden Bloecke zu sehen ist. EINE Stelle dafuer -- sonst
' bleibt beim naechsten neuen Widget eins von beiden stehen.
SUB bloeckeUmschalten()
    DIM obj AS BOOLEAN : obj = istObjEbene()
    DIM w AS GUI_WIDGET
    FOR EACH w IN blockA
        GUI_SET_VISIBLE(w, NOT obj)
    NEXT
    FOR EACH w IN blockB
        GUI_SET_VISIBLE(w, obj)
    NEXT
END SUB

SUB objListeAuffrischen()
    IF NOT istObjEbene() THEN
        GUI_SET_LISTBOX(lstObj, SPLIT$("", "|"))
        RETURN
    END IF
    DIM nm AS STRING : nm = ebenenName$()
    DIM n AS INTEGER : n = TILED_OBJECT_COUNT(karte, nm)
    DIM zeilen[MAX(n, 1)] AS STRING
    zeilen[0] = ""
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        DIM t AS STRING : t = TILED_OBJECT_TYPE(karte, nm, i)
        zeilen[i] = TILED_OBJECT_NAME(karte, nm, i) + _
                    IIF(t = "", "", "  [" + t + "]") + "   " + _
                    STR$(INT(TILED_OBJECT_X(karte, nm, i))) + "," + _
                    STR$(INT(TILED_OBJECT_Y(karte, nm, i)))
    NEXT
    GUI_SET_LISTBOX(lstObj, zeilen)
    IF objSel >= 0 AND objSel < n THEN GUI_LISTBOX_SET_SELECTED(lstObj, objSel)
END SUB

' Das Objekt unter einem Kartenpunkt -- das ZULETZT angelegte gewinnt, weil
' es auch oben drauf gezeichnet wird.
FUNCTION objektBei(px AS INTEGER, py AS INTEGER) AS INTEGER
    IF NOT istObjEbene() THEN RETURN -1
    DIM nm AS STRING : nm = ebenenName$()
    DIM i AS INTEGER
    FOR i = TILED_OBJECT_COUNT(karte, nm) - 1 TO 0 STEP -1
        DIM ox AS INTEGER : ox = INT(TILED_OBJECT_X(karte, nm, i))
        DIM oy AS INTEGER : oy = INT(TILED_OBJECT_Y(karte, nm, i))
        ' Ein Punkt-Objekt (Breite 0) braucht trotzdem eine Trefferflaeche,
        ' sonst laesst es sich nie wieder anklicken.
        DIM ow AS INTEGER : ow = MAX(INT(TILED_OBJECT_WIDTH(karte, nm, i)), 6)
        DIM oh AS INTEGER : oh = MAX(INT(TILED_OBJECT_HEIGHT(karte, nm, i)), 6)
        IF px >= ox AND px < ox + ow AND py >= oy AND py < oy + oh THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' =================================================== Kachel-Eigenschaften

FUNCTION palGid() AS INTEGER
    RETURN basisGid() + gewaehlt
END FUNCTION

SUB eigenschaftenAuffrischen()
    DIM g AS INTEGER : g = palGid()
    DIM k AS ARRAY OF STRING : k = TILED_TILE_PROP_KEYS(karte, g)
    DIM n AS INTEGER : n = LEN(k)
    DIM zeilen[MAX(n, 1)] AS STRING
    zeilen[0] = ""
    DIM i AS INTEGER
    FOR i = 0 TO n - 1
        ' Der Wert als Text -- die Laufzeit gibt jeden Typ so aus, und in
        ' einer Liste ist genau das die brauchbare Form.
        zeilen[i] = k[i] + " = " + TILED_TILE_PROP_STRING(karte, g, k[i])
    NEXT
    GUI_SET_LISTBOX(lstProp, zeilen)
    GUI_SET_CHECKED(cbSolid, TILED_TILE_HAS_PROP(karte, g, "solid"))
END SUB

FUNCTION istZahl(t AS STRING) AS BOOLEAN
    IF LEN(t) = 0 THEN RETURN FALSE
    DIM punkte AS INTEGER : punkte = 0
    DIM i AS INTEGER
    FOR i = 0 TO LEN(t) - 1
        DIM c AS STRING : c = MID$(t, i, 1)
        DIM o AS INTEGER : o = ASC(c)
        IF c = "." THEN
            punkte = punkte + 1
        ELIF c = "-" AND i = 0 THEN
            ' Vorzeichen nur ganz vorn
        ELIF o < 48 OR o > 57 THEN
            RETURN FALSE
        END IF
    NEXT
    IF punkte > 1 THEN RETURN FALSE
    ' "-" und "." allein sind keine Zahlen.
    RETURN INSTR(t, "0") >= 0 OR INSTR(t, "1") >= 0 OR INSTR(t, "2") >= 0 OR _
           INSTR(t, "3") >= 0 OR INSTR(t, "4") >= 0 OR INSTR(t, "5") >= 0 OR _
           INSTR(t, "6") >= 0 OR INSTR(t, "7") >= 0 OR INSTR(t, "8") >= 0 OR _
           INSTR(t, "9") >= 0
END FUNCTION

' Aus dem Eingetippten die passende Art machen. Tiled unterscheidet vier
' (bool/int/float/string), EIN Eingabefeld kann sie nicht erfragen -- also
' wird gedeutet: "true"/"false" (auch deutsch), eine Zahl mit Punkt wird
' FLOAT, eine ohne INTEGER, alles andere bleibt Text.
'
' Das Ergebnis steht sofort in der Liste. Deuten ohne Rueckmeldung waere die
' unangenehme Fassung: "3" als Text abgelegt sieht in der Datei genauso aus
' wie eine 3, verhaelt sich aber anders, sobald jemand damit rechnet.
SUB eigenschaftSetzen(g AS INTEGER, key AS STRING, roh AS STRING)
    DIM t AS STRING : t = TRIM$(roh)
    DIM kl AS STRING : kl = LOWER$(t)
    IF kl = "true" OR kl = "wahr" THEN
        TILED_TILE_SET_PROP(karte, g, key, TRUE)
    ELIF kl = "false" OR kl = "falsch" THEN
        TILED_TILE_SET_PROP(karte, g, key, FALSE)
    ELIF istZahl(t) THEN
        IF INSTR(t, ".") >= 0 THEN
            TILED_TILE_SET_PROP(karte, g, key, VAL(t))
        ELSE
            TILED_TILE_SET_PROP(karte, g, key, INT(VAL(t)))
        END IF
    ELSE
        TILED_TILE_SET_PROP(karte, g, key, t)
    END IF
END SUB

' ============================================================ Ebenenliste

SUB listeAuffrischen()
    DIM n AS INTEGER : n = TILED_LAYER_COUNT(karte)
    DIM namen[MAX(n, 1)] AS STRING
    DIM k AS INTEGER
    FOR k = 0 TO n - 1
        IF TILED_LAYER_VISIBLE(karte, k) THEN
            namen[k] = IIF(TILED_LAYER_TYPE(karte, k) = "object", "[Obj] ", "") + _
                       TILED_LAYER_NAME(karte, k)
        ELSE
            namen[k] = "(aus)  " + TILED_LAYER_NAME(karte, k)
        END IF
    NEXT
    IF n = 0 THEN namen[0] = ""
    GUI_SET_LISTBOX(lstEbenen, namen)
    GUI_LISTBOX_SET_SELECTED(lstEbenen, ebene)
    IF n > 0 THEN
        GUI_SET_TEXT(edName, TILED_LAYER_NAME(karte, ebene))
        GUI_SET_CHECKED(cbSicht, TILED_LAYER_VISIBLE(karte, ebene))
    END IF
END SUB

' ============================================================ Datei

SUB tsListeAuffrischen()
    DIM n AS INTEGER : n = MAX(tsAnz, 1)
    DIM namen[n] AS STRING
    namen[0] = "(keins)"
    DIM i AS INTEGER
    FOR i = 0 TO tsAnz - 1
        ' Der Dateiname, nicht der ganze Pfad -- der passt nicht in die
        ' Klappliste und sagt fuer die Auswahl auch nichts mehr.
        namen[i] = BASENAME(tsPfadA[i])
        IF NOT tsDaA[i] THEN namen[i] = namen[i] + "  (fehlt)"
    NEXT
    GUI_SET_DROPDOWN(ddTs, namen)
    GUI_DROPDOWN_SET_SELECTED(ddTs, MIN(tsAkt, MAX(tsAnz - 1, 0)))
END SUB

SUB tsWaehlen(i AS INTEGER)
    IF i < 0 OR i >= tsAnz THEN RETURN
    tsAkt = i
    tsSpiegeln()
    gewaehlt = 0
    palSp = 0 : palZe = 0
    tsListeAuffrischen()
    eigenschaftenAuffrischen()
END SUB

SUB tilesetsLaden()
    ' Die Tilesets der Karte einlesen -- ihre Bilder liegen dort, wo die
    ' Datei sie nennt. Fehlt eins, wird es GEMELDET und bleibt leer: mit dem
    ' eingebauten Bild einzuspringen saehe richtig aus und waere falsch.
    tsAnz = MIN(TILED_TILESET_COUNT(karte), MAXTS)
    DIM fehlt AS STRING : fehlt = ""
    DIM i AS INTEGER
    FOR i = 0 TO tsAnz - 1
        tsPfadA[i] = TILED_TILESET_IMAGE(karte, i)
        tsNA[i] = TILED_TILESET_TILES(karte, i)
        tsDaA[i] = FILEEXISTS(tsPfadA[i])
        IF tsDaA[i] THEN
            tsBildA[i] = LOADIMAGE(tsPfadA[i])
            tsSpA[i] = MAX(1, IMAGEWIDTH(tsBildA[i]) \ KACHEL)
            tsReA[i] = MAX(1, IMAGEHEIGHT(tsBildA[i]) \ KACHEL)
        ELSE
            tsSpA[i] = 1 : tsReA[i] = 1
            fehlt = fehlt + IIF(fehlt = "", "", ", ") + BASENAME(tsPfadA[i])
        END IF
    NEXT
    tsAkt = 0
    tsSpiegeln()
    IF gewaehlt >= tsN THEN gewaehlt = 0
    palSp = 0 : palZe = 0
    tsListeAuffrischen()
    IF fehlt <> "" THEN meldung = "Tileset-Bild fehlt: " + fehlt
END SUB

SUB tilesetAnhaengen(pf AS STRING)
    IF tsAnz >= MAXTS THEN
        meldung = "Mehr als " + STR$(MAXTS) + " Tilesets kann dieser Editor nicht."
        RETURN
    END IF
    IF NOT FILEEXISTS(pf) THEN
        meldung = "Datei nicht gefunden: " + BASENAME(pf)
        RETURN
    END IF
    DIM b AS IMAGE : b = LOADIMAGE(pf)
    DIM sp AS INTEGER : sp = IMAGEWIDTH(b) \ KACHEL
    DIM re AS INTEGER : re = IMAGEHEIGHT(b) \ KACHEL
    IF sp < 1 OR re < 1 THEN
        meldung = "Zu klein fuer " + STR$(KACHEL) + "x" + STR$(KACHEL) + "-Kacheln."
        RETURN
    END IF
    ' Die Kachelzahl muss stimmen: aus ihr vergibt die Laufzeit die firstgid
    ' des NAECHSTEN Tilesets. Eine zu kleine Zahl liesse die Bereiche
    ' ueberlappen -- und das zerstoert die Zuordnung ALLER Kacheln, stumm.
    DIM idx AS INTEGER : idx = TILED_ADD_TILESET(karte, pf, sp * re)
    tsAnz = tsAnz + 1
    tsPfadA[idx] = pf : tsBildA[idx] = b
    tsSpA[idx] = sp : tsReA[idx] = re : tsNA[idx] = sp * re
    tsDaA[idx] = TRUE
    geaendert = TRUE
    tsWaehlen(idx)
    meldung = BASENAME(pf) + ": " + STR$(sp * re) + " Kacheln, ab GID " + _
              STR$(TILED_TILESET_FIRSTGID(karte, idx))
END SUB

SUB oeffnen()
    DIM p AS STRING : p = FILE_OPEN_DIALOG("Karte oeffnen", "json")
    IF p <> "" THEN
        TRY
            karte = TILED_LOAD(p)
            kb = TILED_WIDTH(karte)
            kh = TILED_HEIGHT(karte)
            IF kb > MAXB OR kh > MAXH THEN
                GUI_MESSAGE("Zu gross", "Diese Karte ist " + STR$(kb) + "x" + STR$(kh) + _
                            " Kacheln. Der Editor kann bis " + STR$(MAXB) + "x" + STR$(MAXH) + ".")
                neueKarte(40, 30)
            ELSE
                ebene = 0
                panX = 0 : panY = 0
                selAn = FALSE
                uStart = 0 : uAnz = 0 : uPos = 0
                dateiname = p
                geaendert = FALSE
                tilesetsLaden()
            END IF
        CATCH e
            GUI_MESSAGE("Fehler", "Die Datei liess sich nicht lesen." + CHR$(10) + e)
        END TRY
        listeAuffrischen()
    END IF
END SUB

SUB speichern()
    DIM p AS STRING : p = dateiname
    IF p = "" THEN p = FILE_SAVE_DIALOG("Karte speichern", "karte.json", "json")
    IF p <> "" THEN
        TRY
            TILED_SAVE(karte, p)
            dateiname = p
            geaendert = FALSE
        CATCH e
            GUI_MESSAGE("Fehler", "Speichern misslungen." + CHR$(10) + e)
        END TRY
    END IF
END SUB

' ============================================================ Werkzeuge

' ---------------------------------------------------------------- GB-Code
' Ein LAUFFAEHIGER Renderer zu dieser Karte: das Programm, die Karte als
' Tiled-JSON und das Tileset-Bild -- alle drei unter demselben Namen und in
' einem Zug.
'
' Das Bild kommt mit, obwohl die Karte seinen Pfad ohnehin nennt: der Pfad in
' der JSON zeigt dorthin, wo das Tileset beim BEARBEITEN lag. Wer den Ordner
' weitergibt, haette sonst eine Karte, die auf nichts zeigt -- und das faellt
' erst beim Starten auf.
SUB gbCodeSichern(pfad AS STRING)
    DIM basis AS STRING : basis = pfad
    IF LEN(basis) > 3 AND RIGHT$(LOWER$(basis), 3) = ".dh" THEN
        basis = LEFT$(basis, LEN(basis) - 3)
    END IF
    TILED_SAVE(karte, basis + ".json")
    ' Jedes Tileset kommt mit, unter dem Namen, den der erzeugte Code sucht.
    ' Ein fehlendes Bild wird UEBERGANGEN statt einen Abbruch zu erzeugen --
    ' der Rest der Karte ist deswegen nicht weniger brauchbar.
    DIM ti AS INTEGER
    FOR ti = 0 TO tsAnz - 1
        IF tsDaA[ti] THEN IMAGE_SAVE(tsBildA[ti], basis + "_" + STR$(ti + 1) + ".png")
    NEXT

    DIM z AS STRING : z = CHR$(10)
    DIM q AS STRING : q = CHR$(34)
    ' Fenstergroesse aus der Karte, aber gedeckelt -- eine 128x128-Karte
    ' waere 2048 Punkte breit und passte auf keinen Schirm.
    DIM fw AS INTEGER : fw = MIN(1280, kb * KACHEL)
    DIM fh AS INTEGER : fh = MIN(800, kh * KACHEL)
    DIM t AS STRING
    t = "' Von 187_tilemap_editor.dh erzeugt." + z + _
        "IMPORT " + q + "tiled" + q + z + z + _
        "CONST TW = " + STR$(KACHEL) + z + _
        "CONST TH = " + STR$(KACHEL) + z + z + _
        "SCREEN(" + STR$(fw) + ", " + STR$(fh) + ", " + q + "Karte" + q + ", 1)" + z + z + _
        "DIM lvl AS TILED_MAP" + z + _
        "lvl = TILED_LOAD(" + q + BASENAME(basis) + ".json" + q + ")" + z + z + _
        "' Ein Blatt je Tileset. Die Spalten kommen aus dem BILD, nicht aus" + z + _
        "' der Karte: die JSON nennt sie nicht, und geraten waeren sie eine" + z + _
        "' stille Fehlerquelle." + z + _
        "CONST TSN = " + STR$(MAX(tsAnz, 1)) + z + _
        "DIM blatt[TSN] AS IMAGE" + z + _
        "DIM sp[TSN] AS INTEGER" + z + _
        "DIM ti AS INTEGER" + z + _
        "FOR ti = 0 TO TSN - 1" + z + _
        "    blatt[ti] = LOADIMAGE(" + q + BASENAME(basis) + "_" + q + " + STR$(ti + 1) + " + _
        q + ".png" + q + ")" + z + _
        "    sp[ti] = MAX(1, IMAGEWIDTH(blatt[ti]) \ TW)" + z + _
        "NEXT" + z + z + _
        "WHILE NOT QUITREQUESTED()" + z + _
        "    CLS(&H0A0F16)" + z + _
        "    DIM e AS INTEGER" + z + _
        "    FOR e = 0 TO TILED_LAYER_COUNT(lvl) - 1" + z + _
        "        IF TILED_LAYER_VISIBLE(lvl, e) AND TILED_LAYER_TYPE(lvl, e) <> " + _
        q + "object" + q + " THEN" + z + _
        "            DIM ty AS INTEGER" + z + _
        "            DIM tx AS INTEGER" + z + _
        "            FOR ty = 0 TO TILED_HEIGHT(lvl) - 1" + z + _
        "                FOR tx = 0 TO TILED_WIDTH(lvl) - 1" + z + _
        "                    DIM g AS INTEGER : g = TILED_TILE_AT(lvl, e, tx, ty)" + z + _
        "                    ' GID -> Tileset: das letzte, dessen firstgid sie" + z + _
        "                    ' noch trifft." + z + _
        "                    DIM ts AS INTEGER : ts = -1" + z + _
        "                    DIM k AS INTEGER" + z + _
        "                    FOR k = TILED_TILESET_COUNT(lvl) - 1 TO 0 STEP -1" + z + _
        "                        IF g >= TILED_TILESET_FIRSTGID(lvl, k) THEN" + z + _
        "                            ts = k" + z + _
        "                            BREAK" + z + _
        "                        END IF" + z + _
        "                    NEXT" + z + _
        "                    IF ts >= 0 AND ts < TSN THEN" + z + _
        "                        DIM lid AS INTEGER" + z + _
        "                        lid = g - TILED_TILESET_FIRSTGID(lvl, ts)" + z + _
        "                        DRAWIMAGEPART(blatt[ts], (lid MOD sp[ts]) * TW, _" + z + _
        "                                      (lid \ sp[ts]) * TH, _" + z + _
        "                                      TW, TH, tx * TW, ty * TH)" + z + _
        "                    END IF" + z + _
        "                NEXT" + z + _
        "            NEXT" + z + _
        "        END IF" + z + _
        "    NEXT" + z + _
        "    FLIP()" + z + _
        "WEND" + z
    WRITEALL(pfad, t)
    meldung = "Renderer + Karte + " + STR$(tsAnz) + " Tileset(s): " + BASENAME(pfad)
END SUB

SUB rechteckFuellen(x1 AS INTEGER, y1 AS INTEGER, x2 AS INTEGER, y2 AS INTEGER, gid AS INTEGER)
    DIM ax AS INTEGER : ax = MIN(x1, x2)
    DIM ay AS INTEGER : ay = MIN(y1, y2)
    TILED_FILL_RECT(karte, ebene, ax, ay, ABS(x2 - x1) + 1, ABS(y2 - y1) + 1, gid)
END SUB

SUB auswahlKopieren(ausschneiden AS BOOLEAN)
    IF selAn THEN
        clipB = selB : clipH = selH
        DIM ax AS INTEGER
        DIM ay AS INTEGER
        FOR ay = 0 TO selH - 1
            FOR ax = 0 TO selB - 1
                clip[ay * clipB + ax] = TILED_TILE_AT(karte, ebene, selX + ax, selY + ay)
            NEXT
        NEXT
        IF ausschneiden THEN
            schrittBeginn()
            TILED_FILL_RECT(karte, ebene, selX, selY, selB, selH, 0)
            schrittEnde()
        END IF
    END IF
END SUB

SUB einfuegen(zx AS INTEGER, zy AS INTEGER)
    IF clipB > 0 THEN
        schrittBeginn()
        DIM ax AS INTEGER
        DIM ay AS INTEGER
        FOR ay = 0 TO clipH - 1
            FOR ax = 0 TO clipB - 1
                ' Was ueber den Rand ragt, faellt weg -- die Karte waechst
                ' beim Einfuegen nicht.
                IF zx + ax < kb AND zy + ay < kh THEN
                    TILED_TILE_SET(karte, ebene, zx + ax, zy + ay, clip[ay * clipB + ax])
                END IF
            NEXT
        NEXT
        schrittEnde()
    END IF
END SUB

' ============================================================ Hauptschleife

neueKarte(kb, kh)
listeAuffrischen()
eigenschaftenAuffrischen()
objListeAuffrischen()
bloeckeUmschalten()

DIM neuOffen AS BOOLEAN : neuOffen = FALSE
DIM meldung AS STRING : meldung = ""

WHILE NOT QUITREQUESTED()
    IF KEYHIT(KEY_ESCAPE) AND NOT neuOffen THEN BREAK

    SW = SCREENWIDTH() : SH = SCREENHEIGHT()
    GUI_WINDOW_SET_BOUNDS(win, 0, 0, SW, SH)
    GUI_UPDATE()

    DIM strg AS BOOLEAN
    strg = KEYPRESSED(KEY_LCTRL) OR KEYPRESSED(KEY_RCTRL)

    ' ------------------------------------------------------ Werkzeugwahl
    FOR i = 0 TO 5
        IF GUI_CLICKED(wzKnopf[i]) THEN werkzeug = i
    NEXT
    ' Welches Werkzeug gilt, muss man SEHEN -- ein Knopf zeigt es von sich
    ' aus nicht an (anders als ein Radio, das aber keine Knopfform hat).
    FOR i = 0 TO 5
        GUI_SET_COLOR(wzKnopf[i], "bg", IIF(i = werkzeug, &H1B5C74, &H1A2430))
    NEXT
    IF NOT neuOffen THEN
        IF KEYHIT(KEY_P) THEN werkzeug = WZ_STIFT
        IF KEYHIT(KEY_E) THEN werkzeug = WZ_RADIER
        IF KEYHIT(KEY_F) THEN werkzeug = WZ_FUELL
        IF KEYHIT(KEY_R) THEN werkzeug = WZ_RECHT
        IF KEYHIT(KEY_I) THEN werkzeug = WZ_PIPETTE
        IF KEYHIT(KEY_S) AND NOT strg THEN werkzeug = WZ_AUSWAHL
    END IF

    ' ------------------------------------------------------------ Datei
    IF GUI_CLICKED(bNeu) THEN
        GUI_WINDOW_VISIBLE(winNeu, TRUE)
        neuOffen = TRUE
    END IF
    IF GUI_CLICKED(bNeuAb) THEN
        GUI_WINDOW_VISIBLE(winNeu, FALSE)
        neuOffen = FALSE
    END IF
    IF GUI_CLICKED(bNeuOk) THEN
        neueKarte(INT(GUI_VALUE(spB)), INT(GUI_VALUE(spH)))
        listeAuffrischen()
        GUI_WINDOW_VISIBLE(winNeu, FALSE)
        neuOffen = FALSE
    END IF
    IF GUI_CLICKED(bAuf) OR (strg AND KEYHIT(KEY_O)) THEN oeffnen()
    IF GUI_CLICKED(bSpei) OR (strg AND KEYHIT(KEY_S)) THEN speichern()
    ' ------------------------------------------------------- Objekt-Ebenen
    IF GUI_CLICKED(bObjEbene) THEN
        DIM on2 AS STRING : on2 = TRIM$(GUI_TEXT(edName))
        IF on2 = "" THEN on2 = "Objekte" + STR$(TILED_LAYER_COUNT(karte) + 1)
        TRY
            ebene = TILED_ADD_OBJECT_LAYER(karte, on2)
            objSel = -1
            geaendert = TRUE
            listeAuffrischen()
            objListeAuffrischen()
            bloeckeUmschalten()
            meldung = "Objekt-Ebene '" + on2 + "' angelegt"
        CATCH e
            meldung = e
        END TRY
    END IF
    IF istObjEbene() THEN
        DIM osel AS INTEGER : osel = GUI_LISTBOX_SELECTED(lstObj)
        IF osel >= 0 AND osel <> objSel AND _
           osel < TILED_OBJECT_COUNT(karte, ebenenName$()) THEN
            objSel = osel
            ' Die Felder folgen der Auswahl -- sonst muesste man zum Aendern
            ' alles noch einmal eintippen.
            GUI_SET_TEXT(edObjName, TILED_OBJECT_NAME(karte, ebenenName$(), objSel))
            GUI_SET_TEXT(edObjTyp, TILED_OBJECT_TYPE(karte, ebenenName$(), objSel))
        END IF
        IF GUI_CLICKED(bObjUeb) AND objSel >= 0 THEN
            TILED_OBJECT_SET_NAME(karte, ebenenName$(), objSel, TRIM$(GUI_TEXT(edObjName)))
            TILED_OBJECT_SET_TYPE(karte, ebenenName$(), objSel, TRIM$(GUI_TEXT(edObjTyp)))
            geaendert = TRUE
            objListeAuffrischen()
            meldung = "Objekt " + STR$(objSel) + " geaendert"
        END IF
        IF GUI_CLICKED(bObjWeg) AND objSel >= 0 THEN
            TILED_REMOVE_OBJECT(karte, ebenenName$(), objSel)
            ' Die Nummern dahinter ruecken auf -- ein gemerkter Index zeigt
            ' danach auf ein anderes Objekt, also lieber gar keinen behalten.
            objSel = -1
            geaendert = TRUE
            objListeAuffrischen()
            meldung = "Objekt entfernt"
        END IF
    END IF

    ' ---------------------------------------------------- Kachel-Eigenschaften
    DIM pg AS INTEGER : pg = palGid()
    IF GUI_CLICKED(cbSolid) THEN
        ' Beim Abwaehlen ENTFERNEN statt auf FALSE zu setzen. `solid = FALSE`
        ' waere nicht dasselbe: sobald IRGENDEINE Kachel ein `solid` hat,
        ' schaltet die Kollision von "jede Kachel blockiert" auf "nur die mit
        ' solid = TRUE" um (`solid_aware`). Ein zurueckgelassenes FALSE haelt
        ' diesen Schalter also umgelegt, ohne dass man es sieht.
        IF GUI_CHECKED(cbSolid) THEN
            TILED_TILE_SET_PROP(karte, pg, "solid", TRUE)
        ELSE
            TILED_TILE_REMOVE_PROP(karte, pg, "solid")
        END IF
        geaendert = TRUE
        eigenschaftenAuffrischen()
    END IF
    IF GUI_CLICKED(bPropSetz) THEN
        DIM sk AS STRING : sk = TRIM$(GUI_TEXT(edKey))
        IF sk = "" THEN
            meldung = "Ohne Schluessel geht es nicht."
        ELSE
            TRY
                eigenschaftSetzen(pg, sk, GUI_TEXT(edWert))
                geaendert = TRUE
                eigenschaftenAuffrischen()
                meldung = "Kachel " + STR$(gewaehlt) + ": " + sk + " gesetzt"
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF
    IF GUI_CLICKED(bPropWeg) THEN
        DIM pi AS INTEGER : pi = GUI_LISTBOX_SELECTED(lstProp)
        DIM pk AS ARRAY OF STRING : pk = TILED_TILE_PROP_KEYS(karte, pg)
        IF pi >= 0 AND pi < LEN(pk) THEN
            TILED_TILE_REMOVE_PROP(karte, pg, pk[pi])
            geaendert = TRUE
            eigenschaftenAuffrischen()
            meldung = pk[pi] + " entfernt"
        ELSE
            meldung = "Erst eine Eigenschaft in der Liste waehlen."
        END IF
    END IF

    IF GUI_CLICKED(bCode) THEN
        DIM pc AS STRING
        pc = FILE_SAVE_DIALOG("GB-Code sichern", "karte.dh", "dh")
        IF pc <> "" THEN
            TRY
                gbCodeSichern(pc)
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF

    ' ---------------------------------------------------------- Verlauf
    IF GUI_CLICKED(bZur) OR (strg AND KEYHIT(KEY_Z)) THEN zurueck()
    IF GUI_CLICKED(bVor) OR (strg AND KEYHIT(KEY_Y)) THEN wieder()
    GUI_SET_ENABLED(bZur, uPos > 0)
    GUI_SET_ENABLED(bVor, uPos < uAnz)

    ' --------------------------------------------------------- Tilesets
    DIM tsel AS INTEGER : tsel = GUI_DROPDOWN_SELECTED(ddTs)
    IF tsel >= 0 AND tsel <> tsAkt AND tsel < tsAnz THEN tsWaehlen(tsel)
    IF GUI_CLICKED(bTsNeu) THEN
        DIM tp AS STRING : tp = FILE_OPEN_DIALOG("Tileset hinzufuegen", "png")
        IF tp <> "" THEN
            TRY
                tilesetAnhaengen(tp)
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF

    ' ----------------------------------------------------------- Ebenen
    DIM lsel AS INTEGER : lsel = GUI_LISTBOX_SELECTED(lstEbenen)
    IF lsel >= 0 AND lsel <> ebene AND lsel < TILED_LAYER_COUNT(karte) THEN
        ebene = lsel
        ' Die Auswahl gilt je Ebene -- eine gemerkte Nummer zeigte in der
        ' naechsten auf ein anderes Objekt oder ins Leere.
        objSel = -1
        listeAuffrischen()
        objListeAuffrischen()
        bloeckeUmschalten()
    END IF
    IF GUI_CLICKED(bEbNeu) THEN
        objSel = -1
        DIM nn AS STRING : nn = "Ebene " + STR$(TILED_LAYER_COUNT(karte) + 1)
        TRY
            ebene = TILED_ADD_LAYER(karte, nn)
            geaendert = TRUE
            uStart = 0 : uAnz = 0 : uPos = 0     ' Verlauf gilt je Ebene
        CATCH e
            meldung = e
        END TRY
        listeAuffrischen()
        objListeAuffrischen()
        bloeckeUmschalten()
    END IF
    IF GUI_CLICKED(bEbUm) THEN
        TRY
            TILED_LAYER_RENAME(karte, ebene, GUI_TEXT(edName))
            geaendert = TRUE
        CATCH e
            meldung = e
        END TRY
        listeAuffrischen()
    END IF
    IF GUI_CLICKED(bEbHinten) THEN ebeneVerschieben(-1)
    IF GUI_CLICKED(bEbVorne) THEN ebeneVerschieben(1)
    GUI_SET_ENABLED(bEbHinten, ebene > 0)
    GUI_SET_ENABLED(bEbVorne, ebene < TILED_LAYER_COUNT(karte) - 1)
    IF GUI_CLICKED(bEbWeg) THEN
        IF TILED_LAYER_COUNT(karte) > 1 THEN
            TILED_REMOVE_LAYER(karte, ebene)
            IF ebene >= TILED_LAYER_COUNT(karte) THEN ebene = TILED_LAYER_COUNT(karte) - 1
            geaendert = TRUE
            uStart = 0 : uAnz = 0 : uPos = 0
            objSel = -1
            listeAuffrischen()
            objListeAuffrischen()
            bloeckeUmschalten()
        ELSE
            meldung = "Die letzte Ebene bleibt."
        END IF
    END IF
    IF GUI_CLICKED(cbSicht) THEN
        TILED_LAYER_SET_VISIBLE(karte, ebene, GUI_CHECKED(cbSicht))
        geaendert = TRUE
        listeAuffrischen()
    END IF

    ' ------------------------------------------------------- Kartenmaus
    DIM cx AS INTEGER : cx = GUI_CANVAS_X(leinwand)
    DIM cy AS INTEGER : cy = GUI_CANVAS_Y(leinwand)
    DIM cw AS INTEGER : cw = GUI_CANVAS_W(leinwand)
    DIM ch AS INTEGER : ch = GUI_CANVAS_H(leinwand)
    DIM mx AS INTEGER : mx = MOUSEX()
    DIM my AS INTEGER : my = MOUSEY()
    DIM z AS INTEGER : z = zell()
    DIM ueber AS BOOLEAN
    ueber = mx >= cx AND mx < cx + cw AND my >= cy AND my < cy + ch AND NOT neuOffen
    DIM tx AS INTEGER : tx = (mx - cx + panX) \ z
    DIM ty AS INTEGER : ty = (my - cy + panY) \ z
    DIM aufKarte AS BOOLEAN
    aufKarte = ueber AND tx >= 0 AND tx < kb AND ty >= 0 AND ty < kh

    ' Zoom am Mausrad -- der Punkt unter dem Zeiger bleibt stehen, sonst
    ' rutscht einem beim Hineinzoomen die Stelle weg, die man ansieht.
    IF ueber AND MOUSEWHEEL() <> 0 THEN
        DIM altZ AS INTEGER : altZ = zoom
        zoom = MAX(1, MIN(6, zoom + SGN(MOUSEWHEEL())))
        IF zoom <> altZ THEN
            DIM wx2 AS FLOAT : wx2 = (mx - cx + panX) / (KACHEL * altZ)
            DIM wy2 AS FLOAT : wy2 = (my - cy + panY) / (KACHEL * altZ)
            panX = INT(wx2 * KACHEL * zoom) - (mx - cx)
            panY = INT(wy2 * KACHEL * zoom) - (my - cy)
        END IF
    END IF

    ' Schieben mit der rechten Maustaste.
    IF ueber AND MOUSE_HIT(1) THEN
        schiebt = TRUE : schiebX = mx : schiebY = my
    END IF
    IF schiebt THEN
        IF MOUSEBUTTON(1) THEN
            panX = panX - (mx - schiebX)
            panY = panY - (my - schiebY)
            schiebX = mx : schiebY = my
        ELSE
            schiebt = FALSE
        END IF
    END IF
    IF NOT neuOffen THEN
        IF KEYPRESSED(KEY_LEFT) THEN panX = panX - 12
        IF KEYPRESSED(KEY_RIGHT) THEN panX = panX + 12
        IF KEYPRESSED(KEY_UP) THEN panY = panY - 12
        IF KEYPRESSED(KEY_DOWN) THEN panY = panY + 12
    END IF
    panX = MAX(0, MIN(panX, MAX(0, kb * z - cw)))
    panY = MAX(0, MIN(panY, MAX(0, kh * z - ch)))

    ' ----------------------------------------------------- Kachelauswahl
    DIM px AS INTEGER : px = GUI_CANVAS_X(palette)
    DIM py AS INTEGER : py = GUI_CANVAS_Y(palette)
    DIM ueberPal AS BOOLEAN
    ueberPal = mx >= px AND mx < px + PAL_SP * KACHEL * PZ AND _
               my >= py AND my < py + PAL_RE * KACHEL * PZ AND NOT neuOffen
    ' Rollen, solange etwas ausserhalb liegt. Waagerecht mit Umschalt --
    ' ein Tileset ist meist hoch, breit ist es der Ausnahmefall.
    IF ueberPal AND MOUSEWHEEL() <> 0 THEN
        IF KEYPRESSED(KEY_LSHIFT) OR KEYPRESSED(KEY_RSHIFT) THEN
            palSp = MAX(0, MIN(palSp - SGN(MOUSEWHEEL()), MAX(0, tsSp - PAL_SP)))
        ELSE
            palZe = MAX(0, MIN(palZe - SGN(MOUSEWHEEL()), MAX(0, tsRe - PAL_RE)))
        END IF
    END IF
    IF ueberPal AND MOUSE_HIT(0) THEN
        DIM pxi AS INTEGER : pxi = (mx - px) \ (KACHEL * PZ) + palSp
        DIM pyi AS INTEGER : pyi = (my - py) \ (KACHEL * PZ) + palZe
        IF pxi < tsSp AND pyi < tsRe THEN
            DIM k AS INTEGER : k = pyi * tsSp + pxi
            IF k < tsN AND k <> gewaehlt THEN
                gewaehlt = k
                eigenschaftenAuffrischen()
            END IF
        END IF
    END IF

    ' --------------------------------------------------------- Zeichnen
    DIM gid AS INTEGER : gid = basisGid() + gewaehlt

    ' Auf einer Objekt-Ebene gelten die Kachelwerkzeuge nicht -- dort gibt es
    ' keine Kacheln. Gezogen wird ein Rechteck, geklickt ein PUNKT (in Tiled
    ' ist ein Objekt mit Breite und Hoehe 0 genau das), und ein Klick auf ein
    ' vorhandenes waehlt es aus, statt eins darueber zu legen.
    DIM opx AS INTEGER : opx = (mx - cx + panX) \ zoom
    DIM opy AS INTEGER : opy = (my - cy + panY) \ zoom
    IF istObjEbene() THEN
        IF ueber AND MOUSE_HIT(0) THEN
            DIM tr AS INTEGER : tr = objektBei(opx, opy)
            IF tr >= 0 THEN
                objSel = tr
                GUI_SET_TEXT(edObjName, TILED_OBJECT_NAME(karte, ebenenName$(), tr))
                GUI_SET_TEXT(edObjTyp, TILED_OBJECT_TYPE(karte, ebenenName$(), tr))
                objListeAuffrischen()
            ELSE
                objZieht = TRUE
                objAx = opx : objAy = opy
                objBx = opx : objBy = opy
            END IF
        END IF
        IF objZieht AND MOUSEBUTTON(0) THEN
            objBx = opx : objBy = opy
        END IF
        IF objZieht AND NOT MOUSEBUTTON(0) THEN
            objZieht = FALSE
            DIM nx AS INTEGER : nx = MIN(objAx, objBx)
            DIM ny AS INTEGER : ny = MIN(objAy, objBy)
            DIM nw AS INTEGER : nw = ABS(objBx - objAx)
            DIM nh AS INTEGER : nh = ABS(objBy - objAy)
            DIM nm3 AS STRING : nm3 = TRIM$(GUI_TEXT(edObjName))
            IF nm3 = "" THEN nm3 = "objekt"
            TRY
                objSel = TILED_ADD_OBJECT(karte, ebenenName$(), nm3, _
                                          TRIM$(GUI_TEXT(edObjTyp)), nx, ny, nw, nh)
                geaendert = TRUE
                objListeAuffrischen()
                meldung = IIF(nw = 0 AND nh = 0, "Punkt", "Rechteck") + _
                          " '" + nm3 + "' bei " + STR$(nx) + "," + STR$(ny)
            CATCH e
                meldung = e
            END TRY
        END IF
    END IF

    IF aufKarte AND MOUSE_HIT(0) AND NOT istObjEbene() THEN
        zieht = TRUE
        ankerX = tx : ankerY = ty
        SELECT CASE werkzeug
            CASE WZ_STIFT
                schrittBeginn()
                TILED_TILE_SET(karte, ebene, tx, ty, gid)
            CASE WZ_RADIER
                schrittBeginn()
                TILED_TILE_SET(karte, ebene, tx, ty, 0)
            CASE WZ_FUELL
                schrittBeginn()
                TILED_FLOOD_FILL(karte, ebene, tx, ty, gid)
                schrittEnde()
                zieht = FALSE
            CASE WZ_RECHT
                schrittBeginn()
            CASE WZ_PIPETTE
                DIM g AS INTEGER : g = TILED_TILE_AT(karte, ebene, tx, ty)
                DIM pts AS INTEGER : pts = IIF(g > 0, tsFuerGid(g), -1)
                IF pts >= 0 THEN
                    ' Auch das TILESET umschalten, sonst zeigte die Palette
                    ' die aufgenommene Kachel gar nicht -- und der naechste
                    ' Strich malte eine andere.
                    IF pts <> tsAkt THEN tsWaehlen(pts)
                    gewaehlt = g - TILED_TILESET_FIRSTGID(karte, pts)
                    ' Den Ausschnitt mitziehen, wenn sie ausserhalb liegt.
                    DIM ps2 AS INTEGER : ps2 = gewaehlt MOD tsSp
                    DIM pz2 AS INTEGER : pz2 = gewaehlt \ tsSp
                    IF ps2 < palSp THEN palSp = ps2
                    IF ps2 >= palSp + PAL_SP THEN palSp = ps2 - PAL_SP + 1
                    IF pz2 < palZe THEN palZe = pz2
                    IF pz2 >= palZe + PAL_RE THEN palZe = pz2 - PAL_RE + 1
                    eigenschaftenAuffrischen()
                END IF
                zieht = FALSE
            CASE WZ_AUSWAHL
                selAn = TRUE
                selX = tx : selY = ty : selB = 1 : selH = 1
        END SELECT
    END IF

    IF zieht AND MOUSEBUTTON(0) AND aufKarte THEN
        SELECT CASE werkzeug
            CASE WZ_STIFT
                TILED_TILE_SET(karte, ebene, tx, ty, gid)
            CASE WZ_RADIER
                TILED_TILE_SET(karte, ebene, tx, ty, 0)
            CASE WZ_AUSWAHL
                selX = MIN(ankerX, tx) : selY = MIN(ankerY, ty)
                selB = ABS(tx - ankerX) + 1 : selH = ABS(ty - ankerY) + 1
        END SELECT
    END IF

    IF zieht AND NOT MOUSEBUTTON(0) THEN
        zieht = FALSE
        SELECT CASE werkzeug
            CASE WZ_STIFT, WZ_RADIER
                schrittEnde()
            CASE WZ_RECHT
                rechteckFuellen(ankerX, ankerY, MAX(0, MIN(kb - 1, tx)), _
                                MAX(0, MIN(kh - 1, ty)), gid)
                schrittEnde()
        END SELECT
    END IF

    ' -------------------------------------------------- Zwischenablage
    ' Nur auf Kachel-Ebenen: sie kopiert ein KACHELfeld, und `TILED_TILE_AT`
    ' auf einer Objekt-Ebene ist ein Fehler, kein leeres Ergebnis.
    IF strg AND NOT neuOffen AND NOT istObjEbene() THEN
        IF KEYHIT(KEY_C) THEN auswahlKopieren(FALSE)
        IF KEYHIT(KEY_X) THEN auswahlKopieren(TRUE)
        IF KEYHIT(KEY_V) THEN
            IF selAn THEN
                einfuegen(selX, selY)
            ELSEIF aufKarte THEN
                einfuegen(tx, ty)
            END IF
        END IF
    END IF
    IF KEYHIT(KEY_DELETE) AND istObjEbene() AND objSel >= 0 AND NOT neuOffen THEN
        TILED_REMOVE_OBJECT(karte, ebenenName$(), objSel)
        objSel = -1
        geaendert = TRUE
        objListeAuffrischen()
        meldung = "Objekt entfernt"
    END IF
    IF KEYHIT(KEY_DELETE) AND selAn AND NOT neuOffen AND NOT istObjEbene() THEN
        schrittBeginn()
        TILED_FILL_RECT(karte, ebene, selX, selY, selB, selH, 0)
        schrittEnde()
    END IF

    ' ============================================================ Bild
    GRADIENTV(0, 0, SW - 1, SH - 1, &H0A0F16, &H161E29)
    GUI_DRAW()

    ' ---------------------------------------------------- Kachelauswahl
    ' Nur der Ausschnitt: bei einem grossen Tileset liefe der Rest sonst in
    ' die Ebenenliste darunter.
    DIM palC AS INTEGER
    DIM palR AS INTEGER
    IF tsAnz > 0 AND tsDaA[tsAkt] THEN
        FOR palR = 0 TO PAL_RE - 1
            FOR palC = 0 TO PAL_SP - 1
                DIM qs AS INTEGER : qs = palSp + palC
                DIM qz AS INTEGER : qz = palZe + palR
                IF qs < tsSp AND qz < tsRe AND qz * tsSp + qs < tsN THEN
                    DRAWIMAGEPARTEX(tsBild, qs * KACHEL, qz * KACHEL, KACHEL, KACHEL, _
                                    px + palC * KACHEL * PZ, py + palR * KACHEL * PZ, _
                                    KACHEL * PZ, KACHEL * PZ)
                END IF
            NEXT
        NEXT
    END IF
    ' Der Rahmen um die gewaehlte Kachel nur, wenn sie im Ausschnitt liegt --
    ' sonst saesse er an der Kante auf einer fremden Kachel.
    DIM gsp AS INTEGER : gsp = (gewaehlt MOD tsSp) - palSp
    DIM gze AS INTEGER : gze = (gewaehlt \ tsSp) - palZe
    IF gsp >= 0 AND gsp < PAL_SP AND gze >= 0 AND gze < PAL_RE THEN
        RECT(px + gsp * KACHEL * PZ, py + gze * KACHEL * PZ, _
             px + gsp * KACHEL * PZ + KACHEL * PZ - 1, _
             py + gze * KACHEL * PZ + KACHEL * PZ - 1, &H2BC4E8)
    END IF
    ' Ein Hinweis, dass mehr da ist als zu sehen -- ohne ihn sucht man die
    ' fehlenden Kacheln im Tileset statt im Ausschnitt.
    IF tsRe > PAL_RE OR tsSp > PAL_SP THEN
        ' Auf einem dunklen Streifen -- ueber hellen Kacheln waere der
        ' Hinweis sonst nicht zu lesen.
        BOX(px + PAL_SP * KACHEL * PZ - 100, py + PAL_RE * KACHEL * PZ - 20, _
            px + PAL_SP * KACHEL * PZ - 2, py + PAL_RE * KACHEL * PZ - 2, &H90101820)
        TEXT(px + PAL_SP * KACHEL * PZ - 94, py + PAL_RE * KACHEL * PZ - 17, _
             "Rad rollt", &HAABBCC)
    END IF

    ' ------------------------------------------------------------ Karte
    SCISSOR(cx, cy, cw, ch)
    ' Zwei Toene: die Karte und das, was NEBEN ihr liegt. Mit einer Farbe
    ' fuer beides sieht man dem Bild nicht an, wo die Karte aufhoert.
    BOX(cx, cy, cx + cw - 1, cy + ch - 1, &H070A0F)
    BOX(cx - panX, cy - panY, cx + kb * z - panX - 1, cy + kh * z - panY - 1, &H0C1118)

    DIM vonX AS INTEGER : vonX = MAX(0, panX \ z)
    DIM vonY AS INTEGER : vonY = MAX(0, panY \ z)
    DIM bisX AS INTEGER : bisX = MIN(kb - 1, (panX + cw) \ z)
    DIM bisY AS INTEGER : bisY = MIN(kh - 1, (panY + ch) \ z)

    DIM lay AS INTEGER
    DIM ax2 AS INTEGER
    DIM ay2 AS INTEGER
    FOR lay = 0 TO TILED_LAYER_COUNT(karte) - 1
        ' Objekt-Ebenen haben kein Kachelfeld -- `TILED_TILE_AT` darauf ist
        ' ein Fehler, kein leeres Ergebnis. Sie werden weiter unten eigens
        ' gezeichnet.
        IF TILED_LAYER_VISIBLE(karte, lay) AND TILED_LAYER_TYPE(karte, lay) <> "object" THEN
            FOR ay2 = vonY TO bisY
                FOR ax2 = vonX TO bisX
                    DIM gg AS INTEGER : gg = TILED_TILE_AT(karte, lay, ax2, ay2)
                    IF gg > 0 THEN
                        ' Jede Kachel mit IHREM Tileset -- eine Ebene darf
                        ' Kacheln aus allen enthalten, und mit dem aktiven
                        ' gerechnet saehe die halbe Karte falsch aus.
                        DIM its AS INTEGER : its = tsFuerGid(gg)
                        IF its >= 0 AND tsDaA[its] THEN
                            DIM lokal AS INTEGER
                            lokal = gg - TILED_TILESET_FIRSTGID(karte, its)
                            DRAWIMAGEPARTEX(tsBildA[its], (lokal MOD tsSpA[its]) * KACHEL, _
                                            (lokal \ tsSpA[its]) * KACHEL, KACHEL, KACHEL, _
                                            cx + ax2 * z - panX, cy + ay2 * z - panY, z, z)
                        END IF
                    END IF
                NEXT
            NEXT
        END IF
    NEXT

    ' Gitter -- nur solange eine Linie noch etwas trennt, und nur UEBER der
    ' Karte: ueber die volle Leinwand gezogen liefen die Linien ins Leere
    ' weiter und die Karte verlor ihre Kante.
    IF GUI_CHECKED(cbGitter) AND z >= 12 THEN
        DIM g0 AS INTEGER : g0 = cy - panY
        DIM g1 AS INTEGER : g1 = cy + kh * z - panY - 1
        FOR ax2 = vonX TO bisX + 1
            LINE(cx + ax2 * z - panX, g0, cx + ax2 * z - panX, g1, &H1E2A38)
        NEXT
        DIM h0 AS INTEGER : h0 = cx - panX
        DIM h1 AS INTEGER : h1 = cx + kb * z - panX - 1
        FOR ay2 = vonY TO bisY + 1
            LINE(h0, cy + ay2 * z - panY, h1, cy + ay2 * z - panY, &H1E2A38)
        NEXT
    END IF
    ' Rand der Karte
    RECT(cx - panX, cy - panY, cx + kb * z - panX - 1, cy + kh * z - panY - 1, &H33455A)

    IF GUI_CHECKED(cbNr) AND z >= 24 AND NOT istObjEbene() THEN
        FOR ay2 = vonY TO bisY
            FOR ax2 = vonX TO bisX
                DIM g2 AS INTEGER : g2 = TILED_TILE_AT(karte, ebene, ax2, ay2)
                IF g2 > 0 THEN
                    TEXT(cx + ax2 * z - panX + 2, cy + ay2 * z - panY + 2, STR$(g2))
                END IF
            NEXT
        NEXT
    END IF

    ' Auswahl
    IF selAn THEN
        BOX(cx + selX * z - panX, cy + selY * z - panY, _
            cx + (selX + selB) * z - panX - 1, cy + (selY + selH) * z - panY - 1, &H302BC4E8)
        RECT(cx + selX * z - panX, cy + selY * z - panY, _
             cx + (selX + selB) * z - panX - 1, cy + (selY + selH) * z - panY - 1, &HE8C44B)
    END IF

    ' Objekte der aktiven Objekt-Ebene. Nur DIESER Ebene -- eine Karte kann
    ' mehrere haben, und alle uebereinander waeren nicht auseinanderzuhalten.
    IF istObjEbene() THEN
        DIM onm AS STRING : onm = ebenenName$()
        DIM oi AS INTEGER
        FOR oi = 0 TO TILED_OBJECT_COUNT(karte, onm) - 1
            DIM px1 AS INTEGER : px1 = cx + INT(TILED_OBJECT_X(karte, onm, oi)) * zoom - panX
            DIM py1 AS INTEGER : py1 = cy + INT(TILED_OBJECT_Y(karte, onm, oi)) * zoom - panY
            DIM pw AS INTEGER : pw = INT(TILED_OBJECT_WIDTH(karte, onm, oi)) * zoom
            DIM ph AS INTEGER : ph = INT(TILED_OBJECT_HEIGHT(karte, onm, oi)) * zoom
            DIM farbe AS INTEGER : farbe = IIF(oi = objSel, &HE8C44B, &H2BC4E8)
            IF pw <= 0 OR ph <= 0 THEN
                ' Punkt-Objekt: ein Kreuz, damit es ueberhaupt zu sehen ist.
                LINE(px1 - 5, py1, px1 + 5, py1, farbe)
                LINE(px1, py1 - 5, px1, py1 + 5, farbe)
                CIRCLEOUTLINE(px1, py1, 4, farbe)
            ELSE
                BOX(px1, py1, px1 + pw - 1, py1 + ph - 1, &H302BC4E8)
                RECT(px1, py1, px1 + pw - 1, py1 + ph - 1, farbe)
            END IF
            TEXT(px1 + 3, py1 - 16, TILED_OBJECT_NAME(karte, onm, oi))
        NEXT
        ' Das gerade aufgezogene Rechteck.
        IF objZieht THEN
            DIM zx1 AS INTEGER : zx1 = cx + MIN(objAx, objBx) * zoom - panX
            DIM zy1 AS INTEGER : zy1 = cy + MIN(objAy, objBy) * zoom - panY
            RECT(zx1, zy1, zx1 + ABS(objBx - objAx) * zoom - 1, _
                 zy1 + ABS(objBy - objAy) * zoom - 1, &HFFFFFF)
        END IF
    END IF

    ' Zeiger: beim Rechteck der ganze aufgezogene Bereich, sonst die Kachel.
    IF aufKarte AND NOT istObjEbene() THEN
        DIM hx AS INTEGER : hx = tx
        DIM hy AS INTEGER : hy = ty
        DIM hb AS INTEGER : hb = 1
        DIM hh AS INTEGER : hh = 1
        IF zieht AND werkzeug = WZ_RECHT THEN
            hx = MIN(ankerX, tx) : hy = MIN(ankerY, ty)
            hb = ABS(tx - ankerX) + 1 : hh = ABS(ty - ankerY) + 1
        END IF
        RECT(cx + hx * z - panX, cy + hy * z - panY, _
             cx + (hx + hb) * z - panX - 1, cy + (hy + hh) * z - panY - 1, &HFFFFFF)
    END IF
    SCISSOR_END()

    ' -------------------------------------------------------- Statuszeile
    DIM info AS STRING
    info = wzName[werkzeug] + "   " + IIF(tsAnz > 0, BASENAME(tsPfad), "-") + _
           " #" + STR$(gewaehlt) + "   Zoom " + STR$(zoom) + "x"
    IF aufKarte THEN info = info + "   [" + STR$(tx) + ", " + STR$(ty) + "]"
    IF selAn THEN info = info + "   Auswahl " + STR$(selB) + "x" + STR$(selH)
    IF clipB > 0 THEN info = info + "   Ablage " + STR$(clipB) + "x" + STR$(clipH)
    info = info + "   |   " + IIF(dateiname = "", "(ungespeichert)", dateiname)
    IF geaendert THEN info = info + " *"
    IF meldung <> "" THEN info = info + "   |   " + meldung
    GUI_SET_TEXT(status, info)

    FLIP()
WEND
