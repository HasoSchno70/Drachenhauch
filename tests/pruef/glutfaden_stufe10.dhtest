--- erwartet
gleich (98 Zeilen)

=== groesse aendern ist ein schritt, rueckgaengig stellt alles her
IMPORT "helfer.dh"
DIM m AS kern.Muster : m = kern.pxsLaden("probe.pxs")
DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
DIM vorher AS STRING : vorher = JSON_STRINGIFY(kern.musterNachJson(m))
PRINT "gleich: "; kern.groesseAendern(m, v, 30, 24); " "; kern.groesseSkalieren(m, v, 30, 24); " | schritte "; v.stand()
PRINT "kleiner: "; kern.groesseAendern(m, v, 20, 12); " | "; m.breite; "x"; m.hoehe; " ebenen "; m.ebenen.breite; "x"; m.ebenen.hoehe; " rueck "; LEN(m.rueckstiche); " | "; v.textZurueck$()
DIM ok AS BOOLEAN : ok = v.zurueckNehmen(m)
PRINT "rueckgaengig wie vorher: "; JSON_STRINGIFY(kern.musterNachJson(m)) = vorher
ok = v.wiederholen(m)
PRINT "wiederholt: "; m.breite; "x"; m.hoehe; " "; m.ebenen.ebenen[0].breite; " "; LEN(m.ebenen.ebenen[0].raster)
ok = v.zurueckNehmen(m)
PRINT "smart: "; kern.groesseSkalieren(m, v, 60, 48); " | "; m.breite; "x"; m.hoehe; " stiche "; m.sticheGesamt()
ok = v.zurueckNehmen(m)
PRINT "rueckgaengig wie vorher: "; JSON_STRINGIFY(kern.musterNachJson(m)) = vorher
DIM b AS INTEGER
FOR EACH b IN [0, -3]
    TRY
        ok = kern.groesseAendern(m, v, b, 10)
        PRINT "ok?"
    CATCH f
        PRINT "fehler: "; f
    END TRY
NEXT
