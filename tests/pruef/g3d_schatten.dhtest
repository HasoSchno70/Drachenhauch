' Schatten in 3D (SHADOW_ENABLE) -- wer wirft einen?
'
' Bis 2026.27 zeichnete der Schatten-Durchgang nur MODEL/MODEL_EX in die
' Tiefenkarte. Was ueber MODEL_MATRIX kam -- also alles, was sich dreht:
' Physik-Koerper, Bones, Hierarchien --, stand ohne Schatten auf dem Boden.
' Gefunden beim Dogfooding der 3D-Werkstatt (Einsturz ueber physics3d).
'
' Die Proben vergleichen relativ (gleich wie / anders als), damit ein anderer
' Grafiktreiber mit anderen Grautoenen nicht stoert: von oben gesehen liegen
' die beiden Wuerfel spiegelgleich, ihre Schatten muessen es auch.
' Format: docs/werkzeuge.md, dhrt test.

=== model_matrix wirft denselben schatten wie model
IMPORT "g3d"
IMPORT "m3d"
SCREEN(320, 200, "Schatten", 1)
LIGHT_ENABLE()
LIGHT_AMBIENT(&HFFFFFF, 0.3)
LIGHT_DIRECTIONAL(0.0, -1.0, -0.6, &HFFFFFF)
SHADOW_ENABLE(1024)
SHADOW_AREA(8.0, 30.0)
DIM boden AS INTEGER : boden = MESH_PLANE(20, 20, 1, 1) : MODEL_LIT(boden)
DIM w AS INTEGER : w = MESH_CUBE(1.0, 1.0, 1.0) : MODEL_LIT(w)
WHILE NOT QUITREQUESTED()
    CLS(&H000000)
    CAMERA3D(0, 12, 0.01, 0, 0, 0, 40)
    MODEL(boden, 0, 0, 0, 1.0, &HFFFFFF)
    MODEL(w, -2.0, 1.5, 0, 1.0, &HFFFFFF)
    MODEL_MATRIX(w, MAT4_TRANSLATE(2.0, 1.5, 0), &HFFFFFF)
    FLIP()
WEND
--- umgebung
DHRT_FRAMES=3
--- bild
groesse 320 200
113 72 <> 160 72
207 72 = 113 72
207 72 <> 160 72
