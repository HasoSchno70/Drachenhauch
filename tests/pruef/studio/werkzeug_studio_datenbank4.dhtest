' Drachenhauch Studio: Datenbanken im Projekt, Stufe 4 -- Bildspalten
' (studio/datenbank.dh, studio/dbeditor.dh, studio/inspektor.dh,
' docs/studio.md). Eine Spalte der Art "bild" ist ein BLOB mit den Bytes
' einer Bilddatei; im Daten-Gitter steht ihre Groesse, „Bild …“ setzt eines.
' Im erzeugten Fenster zeigt eine Tabelle das Bild in der Zelle, und ein
' Bild-Control an einer Bildspalte (studio_bildspalte) laedt und sichert es
' mit dem Datensatz.
' Format: docs/werkzeuge.md, dhrt test.

--- langsam
=== der kern legt bildspalten an, setzt und zeigt bilder
' BLOB in der Datei, Groesse im Gitter, ein Text in die Zelle ist ein Fehler,
' eine Datei, die kein Bild ist, auch; leer macht die Zelle wieder NULL.
IMPORT "kern.dh"
projOrdner = CWD$() + "/proj"
DIM e AS Element : e = elementNeu("datenbank", "Daten")
e.schema = READLINES("proj/Daten.dhdb")[0]
PRINT "abgleich ["; dbAbgleichen$(e); "]"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DIM r AS DB_RESULT : r = DB_QUERY(db, "PRAGMA table_info(produkte)")
WHILE DB_NEXT(r)
    PRINT "  "; DB_GET_STRING(r, 1); " "; DB_GET_STRING(r, 2); " ["; DB_GET_STRING(r, 4); "]"
WEND
DB_CLOSE(db)
PRINT "art "; dbTypName$("bild"); " "; dbTypSql$("bild"); " vorgabe ["; dbLiteral$("bild", "x"); "]"
PRINT "neu ["; dbZeileNeu$(e, "produkte"); "] "; dbNeueId
PRINT "setzen ["; dbBildSetzen$(e, "produkte", 1, "foto", "bild.png"); "]"
PRINT "lesen ["; dbZeilenLesen$(e, "produkte", 10); "] "; dbZellen[1]
PRINT "text ["; dbZelleSetzen$(e, "produkte", 1, "foto", "abc"); "]"
PRINT "kein bild ["; dbBildSetzen$(e, "produkte", 1, "foto", "text.txt"); "]"
PRINT "keine bildspalte ["; dbBildSetzen$(e, "produkte", 1, "name", "bild.png"); "]"
PRINT "pflicht ["; dbBildSetzen$(e, "produkte", 1, "muss", ""); "] "; dbDefault$("bild", TRUE, "")
PRINT "leer ["; dbBildSetzen$(e, "produkte", 1, "foto", ""); "]"
PRINT "lesen ["; dbZeilenLesen$(e, "produkte", 10); "] ["; dbZellen[1]; "] ["; dbZellen[2]; "]"
PRINT "spalten "; JOIN$(dbSpaltenBild("Daten.produkte", TRUE), ","); " / "; JOIN$(dbSpaltenBild("Daten.produkte", FALSE), ",")
--- datei bild.png base64
iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAE0lEQVR4nGP4z8DwnwGM/zMwAAAf7gP9NRsAMwAAAABJRU5ErkJggg==
--- datei text.txt
kein Bild
--- datei proj/Daten.dhdb
{"datei":"daten.sqlite","tabellen":[{"name":"produkte","spalten":[{"name":"name","typ":"text","pflicht":false,"eindeutig":false,"vorgabe":""},{"name":"foto","typ":"bild","pflicht":false,"eindeutig":false,"vorgabe":""},{"name":"muss","typ":"bild","pflicht":true,"eindeutig":false,"vorgabe":""}]}]}
--- datei kern.dh
IMPORT "json"
IMPORT "regex"
IMPORT "imgfx"
IMPORT "db"
IMPORT "{sammlung}/../../../studio/sprache.dh"
IMPORT "{sammlung}/../../../studio/bibliothek.dh"
IMPORT "{sammlung}/../../../studio/modell.dh"
IMPORT "{sammlung}/../../../studio/projekt.dh"
IMPORT "{sammlung}/../../../studio/datenbank.dh"
--- erwartet
abgleich []
  id INTEGER []
  name TEXT []
  foto BLOB []
  muss BLOB [X'']
art Bild BLOB vorgabe []
neu [] 1
setzen []
lesen [] Bild (1 KB)
text [foto ist eine Bildspalte -- ein Bild setzt „Bild …“.]
kein bild [text.txt ist kein Bild (PNG, JPG, BMP oder GIF).]
keine bildspalte [name ist keine Bildspalte.]
pflicht [muss ist ein Pflichtfeld.] X''
leer []
lesen [] [] []
spalten foto,muss / name

=== das erzeugte fenster zeigt, setzt und leert bilder
' Die Tabelle zeigt das Bild der ersten Zeile in der Zelle (die zweite hat
' keins), Laden zeigt es im Bild-Control. BildSetzen macht den Datensatz
' ungesichert, Sichern schreibt die Bytes, BildLeeren + Sichern macht die
' Spalte NULL; eine Datei, die kein Bild ist, nimmt BildSetzen nicht.
IMPORT "laeufer.dh"
IMPORT "imgfx"
DIM p AS STRING : p = CWD$() + "/proj"
slHin(10, 10)
slWarten(10)
slTaste(294)
slWarten(200)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_LAUF_BILDER", "60")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, CWD$() + "/ev.txt", slBild + 20, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "ausgabe ")
    IF INSTR(z, "▶") < 0 AND INSTR(z, "■") < 0 AND INSTR(z, "WARNING") < 0 THEN PRINT z
NEXT
' Rote Punkte im Bild des Programms: das Bild der Zelle.
DIM bild AS IMAGE : bild = LOADIMAGE(p + "/schirm.png")
DIM rot AS INTEGER : rot = 0
DIM bx AS INTEGER
DIM by AS INTEGER
FOR by = 0 TO IMAGE_HEIGHT(bild) - 1 STEP 2
    FOR bx = 0 TO IMAGE_WIDTH(bild) - 1 STEP 2
        IF GETPIXEL(bild, bx, by) = RGB(255, 0, 0) THEN rot = rot + 1
    NEXT
NEXT
PRINT "rot im bild "; rot > 0
--- argumente
{sammlung}/../../../studio/studio.dh
--- vorher
IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE produkte (id INTEGER PRIMARY KEY, name TEXT, foto BLOB)")
DB_EXEC(db, "INSERT INTO produkte (name, foto) VALUES (?, ?)", "Tasse", READALL_BYTES("proj/rot.png"))
DB_EXEC(db, "INSERT INTO produkte (name, foto) VALUES ('Teller', NULL)")
DB_CLOSE(db)
--- datei laeufer.dh
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
