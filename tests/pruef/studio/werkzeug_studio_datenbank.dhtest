=== im spalten-gitter umbenennen, pflicht ankreuzen und eine tabelle anlegen
' In die Namenszelle von ort "stadt" einfuegen (umbenennen), das Kaestchen
' Pflicht derselben Zeile anklicken (die Tabelle wird neu aufgebaut), dann
' [Neu ...] mit demselben Text in der Zwischenablage: eine Tabelle stadt.
' Strg+S sichert den Aufbau in Daten.dhdb.
IMPORT "laeufer.dh"
DIM p AS STRING : p = CWD$() + "/proj"
SETENV("DH_STUDIO_OEFFNEN", "Daten.kunden")
DIM log AS STRING : log = CWD$() + "/s.log"
slStarten(log, "", 12, p)
DIM x AS INTEGER
DIM y AS INTEGER
slHin(10, 10)
slWarten(10)
(x, y) = slLage(log, "dbzelle sp 1 0")
slKlick(x, y)
slWarten(4)
slMit([341], 86)
slWarten(10)
(x, y) = slLage(log, "dbzelle sp 1 2")
slKlick(x, y)
slWarten(10)
(x, y) = slLage(log, "db tabneu")
slKlick(x, y)
slWarten(10)
slMit([341], 86)
slWarten(6)
slTaste(257)
slWarten(10)
slMit([341], 83)
slWarten(10)
slAufnahmeSchreiben(CWD$() + "/ev.txt")
SETENV("DH_STUDIO_ABLAGE", "stadt")
slStarten(log, CWD$() + "/ev.txt", slBild + 10, p)
DIM z AS STRING
FOR EACH z IN slAnfang(log, "db ")
    PRINT z
NEXT
DIM db AS DB_CONN : db = DB_OPEN(p + "/daten.sqlite")
DIM r AS DB_RESULT : r = DB_QUERY(db, "PRAGMA table_info(kunden)")
WHILE DB_NEXT(r)
    PRINT "  "; DB_GET_STRING(r, 1); " nn="; DB_GET_INT(r, 3); " df="; IIF(DB_IS_NULL(r, 4), "-", DB_GET_STRING(r, 4))
WEND
r = DB_QUERY(db, "SELECT stadt FROM kunden")
IF DB_NEXT(r) THEN PRINT "wert "; DB_GET_STRING(r, 0)
DB_CLOSE(db)
DIM j AS JSON_HANDLE : j = JSON_LOAD(p + "/Daten.dhdb")
PRINT "dhdb "; JSON_GET_STRING(j, "tabellen.0.spalten.1.name"); " "; JSON_GET_BOOL(j, "tabellen.0.spalten.1.pflicht"); " "; JSON_GET_STRING(j, "tabellen.1.name")
DIM kx AS INTEGER
DIM ky AS INTEGER
(kx, ky) = slLage(log, "knoten Daten.stadt")
PRINT "navigator "; kx > 0
--- argumente
{sammlung}/../../../studio/studio.dh
--- vorher
IMPORT "db"
DIM db AS DB_CONN : db = DB_OPEN("proj/daten.sqlite")
DB_EXEC(db, "CREATE TABLE kunden (id INTEGER PRIMARY KEY, name TEXT NOT NULL DEFAULT '', ort TEXT DEFAULT 'Berlin')")
DB_EXEC(db, "INSERT INTO kunden (name, ort) VALUES ('Anna', 'Köln')")
DB_CLOSE(db)
--- datei laeufer.dh
IMPORT "db"
IMPORT "json"
IMPORT "{sammlung}/../_hilfen/studiolauf.dh"
slStudio = ARG$(0)
