FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 7) = "wellen " THEN wellen = L[i]
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 10) = "korrektur " THEN PRINT L[i]
NEXT
PRINT "zuletzt "; wellen
--- erwartet
korrektur angebot Ersetzen durch zaehler | DIM zaehlr AS INTEGER anlegen
korrektur DIM zaehlr AS INTEGER anlegen
pr text DIM zaehlr AS INTEGER/DIM zaehler AS INTEGER/  zaehlr = zaehler + 1
zuletzt wellen 0

=== ohne meldung gibt es nichts zu korrigieren
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 80 THEN
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 1, 3)
    befehl("korrektur")
    protokoll("pr status " + GUI_TEXT(lblStatus))
    EXIT(0)
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=120
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
DIM zaehler AS INTEGER
  zaehlr = zaehler + 1
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 10) = "korrektur " THEN PRINT L[i]
NEXT
--- erwartet
korrektur keine
pr status Hier gibt es nichts zu korrigieren.

=== ein fehlendes end if ergaenzen
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 80 THEN
    ' Die Meldung steht am Programmende, hinter der letzten Zeile.
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 5, 1)
    befehl("korrektur")
END IF
IF prBild = 90 THEN paletteAusfuehren()
IF prBild = 150 THEN
    protokoll("pr text " + REPLACE$(GUI_TEXT(tabFelder[aktiverTab]), NL, "/"))
    EXIT(0)
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
DIM x AS INTEGER
IF x = 0 THEN
    PRINT(1)
PRINT(2)
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
DIM wellen AS STRING : wellen = ""
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 7) = "wellen " THEN wellen = L[i]
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 10) = "korrektur " THEN PRINT L[i]
NEXT
PRINT "zuletzt "; wellen
--- erwartet
korrektur angebot END IF ergaenzen
korrektur END IF ergaenzen
pr text DIM x AS INTEGER/IF x = 0 THEN/    PRINT(1)/END IF/PRINT(2)
zuletzt wellen 0

=== eine unbenutzte variable ist ein hinweis und laesst sich entfernen
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 80 THEN
    protokoll("pr probleme " + GUI_TEXT(lblProbleme))
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 2, 10)
    befehl("korrektur")
END IF
IF prBild = 90 THEN paletteAusfuehren()
IF prBild = 150 THEN
    protokoll("pr text " + REPLACE$(GUI_TEXT(tabFelder[aktiverTab]), NL, "/"))
    EXIT(0)
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
SUB tu()
    DIM leer AS INTEGER
    PRINT(1)
END SUB
tu()
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
DIM erst AS STRING : erst = ""
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 9) = "geprueft " AND erst = "" THEN erst = L[i]
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 10) = "korrektur " OR LEFT$(L[i], 9) = "hinweise " THEN PRINT L[i]
NEXT
PRINT "zuerst "; erst
--- erwartet
hinweise 1
pr probleme Probleme: 0 Fehler, 0 Warnungen, 1 Hinweis
korrektur angebot Zeile entfernen
korrektur Zeile entfernen
pr text SUB tu()/    PRINT(1)/END SUB/tu()
zuerst geprueft 0

=== ein angebot gilt nur fuer den text, zu dem es gehoert
' Geht der Text weiter, waehrend die Auswahl offen ist, passen die Stellen
' der Korrektur nicht mehr. Vorher zeigte die gemerkte Nummer in die Liste
' der NEUEN Pruefung -- je nach Text tat Enter nichts, etwas Falsches oder
' brach die IDE mit "JSON_LEN: Pfad 'k.1.aenderungen' nicht aufloesbar" ab.
DIM prBild AS INTEGER : prBild = 0
--- programm ../../ide/ide.dh nach SETFPS(60)
--- einschub nach hbInhaltNachziehen()
prBild = prBild + 1
IF prBild = 80 THEN
    GUI_TEXTAREA_GOTO(tabFelder[aktiverTab], 2, 5)
    GUI_FOCUS(tabFelder[aktiverTab])
    befehl("korrektur")
END IF
IF prBild = 84 THEN GUI_SET_TEXT(tabFelder[aktiverTab], "DIM zaehler AS INTEGER" + NL + "  zaehler = zaehler + 1" + NL)
IF prBild = 170 THEN
    DIM prEv AS STRING : prEv = "c 2" + NL + "e 0 2 257 0 0 0" + NL + "e 2 1 257 0 0 0" + NL + NL
    WRITEALL("ev.txt", prEv)
    AUTOMATION_PLAY("ev.txt")
END IF
IF prBild = 220 THEN
    protokoll("pr text " + REPLACE$(GUI_TEXT(tabFelder[aktiverTab]), NL, "/"))
    protokoll("pr status " + GUI_TEXT(lblStatus))
    EXIT(0)
END IF
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=260
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
DIM zaehler AS INTEGER
  zaehlr = zaehler + 1
--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
DIM i AS INTEGER
FOR i = 0 TO LEN(L) - 1
    IF LEFT$(L[i], 3) = "pr " OR LEFT$(L[i], 10) = "korrektur " THEN PRINT L[i]
NEXT
--- erwartet
korrektur angebot Ersetzen durch zaehler | DIM zaehlr AS INTEGER anlegen
korrektur veraltet
pr text DIM zaehler AS INTEGER/  zaehler = zaehler + 1/
pr status Der Text hat sich seit dem Vorschlag geändert -- Strg+. noch einmal.
