=== ungueltige namen und vorhandene dateien werden abgelehnt
baumAktion = "datei" : baumZiel = projektOrdner
baumAusfuehren("../raus.dh")
protokoll("pr status " + GUI_TEXT(lblStatus))
baumAusfuehren("da.dh")
protokoll("pr status " + GUI_TEXT(lblStatus))
baumAktion = "ordner"
baumAusfuehren("unter")
protokoll("pr ordner " + STR$(DIREXISTS(PATHJOIN(projektOrdner, "unter"))))
EXIT(0)
