=== ein passwortfeld prueft nicht
IMPORT "gui"
SCREEN(300, 100, "T", 1)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 0, 0, 300, 100)
DIM tf AS GUI_WIDGET
tf = GUI_TEXTINPUT(w, 10, 40, 200, 28)
GUI_SET_TEXT(tf, "Hasu Gartn")
GUI_TEXTINPUT_SET(tf, "passwort", 1)
DIM tf2 AS GUI_WIDGET
tf2 = GUI_TEXTINPUT(w, 10, 70, 200, 28)
GUI_SET_TEXT(tf2, "Hasu Gartn")
DIM h AS INTEGER
h = SPELL_LOAD("de-TEST.dic")
GUI_SPELL(tf, h)
GUI_SPELL(tf2, h)
DIM n AS INTEGER : n = 0
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    n = n + 1
    IF n = 5 THEN PRINT GUI_SPELL_COUNT(tf); " "; GUI_SPELL_COUNT(tf2)
    GUI_DRAW()
    FLIP()
WEND
