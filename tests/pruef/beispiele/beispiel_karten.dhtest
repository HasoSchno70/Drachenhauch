abgebrochen 4, aus dem netz 0, hoechstens zugleich 4, offen = laufend TRUE
fehler sagt 404: TRUE

=== spur marker bild und pdf
' Die Beispielspur des Beispiels. Kacheln gibt es keine (die Adresse fuehrt
' ins Leere) -- geprueft werden Spur, Marker und die Ausfuhr.
kUrl = "http://127.0.0.1:1/{z}/{x}/{y}.png"
DIM prB AS INTEGER
DIM prAus AS ARRAY OF STRING : prAus = []
SUB prZeile(t AS STRING)
    ARRAY_PUSH(prAus, t)
END SUB
SUB prProbe()
    prB = prB + 1
    IF prB < 5 THEN RETURN
    prZeile(REPLACE$(GUI_TEXT(lbSpur), CHR$(10), " | "))
    prZeile("marker " + STR$(GUI_LISTBOX_COUNT(lstMarker)) + " " + GUI_LISTBOX_ITEM(lstMarker, 0))
    ' dieselbe Datei noch einmal: die Wegpunkte kommen nicht doppelt
    spurLaden(spurDatei)
    prZeile("nochmal geladen, marker " + STR$(GUI_LISTBOX_COUNT(lstMarker)))
    ' Punkt 40 der Spur liegt im Bild auf der Linie in Spurfarbe
    DIM bild AS IMAGE : bild = ansichtBild()
    DIM sx AS INTEGER : sx = INT(weltX(spur.lon[40], zoom) - (mitteX - karteB() / 2))
    DIM sy AS INTEGER : sy = INT(weltY(spur.lat[40], zoom) - (mitteY - karteH() / 2))
    DIM treffer AS BOOLEAN
    DIM ix AS INTEGER
    DIM iy AS INTEGER
    FOR ix = -1 TO 1
        FOR iy = -1 TO 1
            IF GETPIXEL(bild, sx + ix, sy + iy) = FARBE_SPUR THEN treffer = TRUE
        NEXT
    NEXT
    prZeile("spur im bild " + STR$(treffer) + ", ganze spur im bild " + STR$(sx > 0 AND sx < karteB()))
    IMAGE_FREE(bild)
    bildSichern("karte.png")
    DIM gb AS IMAGE : gb = LOADIMAGE("karte.png")
    prZeile("bild " + STR$(IMAGE_WIDTH(gb) = karteB()) + " " + STR$(IMAGE_HEIGHT(gb) = karteH()))
    PDF_SAVE(karteAlsPdf(), "karte.pdf")
    einstellungenSichern()
    WRITEALL("probe.txt", JOIN$(prAus, CHR$(10)) + CHR$(10))
    EXIT(0)
END SUB
