--- nachher
IMPORT "json"
IMPORT "animfsm"
IMPORT "sprite"
FUNCTION zustand$(datei AS STRING, speed AS FLOAT, schritt AS BOOLEAN) AS STRING
    DIM sp AS SPRITE : sp = SPRITE_NEW(0, 16, 16)
    DIM fsm AS ANIM_FSM : fsm = ANIM_FSM_LOAD(datei)
    ANIM_FSM_SETUP(fsm, sp)
    IF schritt THEN
        ANIM_FSM_SET_FLOAT(fsm, "speed", speed)
        ANIM_FSM_UPDATE(fsm, sp, 16)
    END IF
    RETURN ANIM_FSM_STATE(fsm)
END FUNCTION
DIM h AS JSON_HANDLE : h = JSON_LOAD("held.dhanim")
DIM i AS INTEGER
DIM namen AS STRING : namen = ""
FOR i = 0 TO JSON_LEN(h, "states") - 1
    namen = namen + JSON_GET_STRING(h, "states." + STR$(i) + ".name") + " "
NEXT
DIM mitFall AS INTEGER : mitFall = 0
FOR i = 0 TO JSON_LEN(h, "transitions") - 1
    DIM p AS STRING : p = "transitions." + STR$(i)
    IF JSON_GET_STRING(h, p + ".from") = "fall" OR JSON_GET_STRING(h, p + ".to") = "fall" THEN mitFall = mitFall + 1
NEXT
PRINT TRIM$(namen)
PRINT "mit fall " ; mitFall
' Stuende noch ein Uebergang zu fall, laedt die Laufzeit die Datei nicht.
PRINT "laufzeit " + zustand$("held.dhanim", 0.0, FALSE)
--- erwartet
idle run jump
mit fall 0
laufzeit idle

