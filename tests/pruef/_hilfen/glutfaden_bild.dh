' Bildproben fuer glutfaden_ansicht: Punkte einer Farbe (+-12 je Kanal) im
' Bereich der Zeichenflaeche -- ohne Kopfleiste, Werkzeugzeile, Seitenleiste
' und Statuszeile, dort stehen Farbfelder derselben Farben.
FUNCTION punkte(pfad AS STRING, farbe AS INTEGER) AS INTEGER
    IF NOT FILEEXISTS(pfad) THEN RETURN -1
    DIM b AS IMAGE : b = LOADIMAGE(pfad)
    DIM r AS INTEGER : r = (farbe SHR 16) BAND 255
    DIM g AS INTEGER : g = (farbe SHR 8) BAND 255
    DIM bl AS INTEGER : bl = farbe BAND 255
    DIM n AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR y = 120 TO IMAGE_HEIGHT(b) - 40 STEP 3
        FOR x = 0 TO IMAGE_WIDTH(b) - 340 STEP 3
            DIM f AS INTEGER : f = GETPIXEL(b, x, y)
            ' BAND bindet schwaecher als das Minus -- darum die Klammern
            IF ABS(((f SHR 16) BAND 255) - r) < 12 AND ABS(((f SHR 8) BAND 255) - g) < 12 AND ABS((f BAND 255) - bl) < 12 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
