=== variablen tragen ihre kinder und klassen ihren namen
' Felder, Objekte und MAPs klappen in der IDE auf -- der Debugger liefert
' die Inhalte mit, je Ebene hoechstens 100, und nennt die Klasse, wie sie
' geschrieben wurde (der Parser fuehrt sie klein).
IMPORT "sitzung.dh"
DIM q AS STRING : q = CHR$(34)
sitzung("d.dh", ["{" + q + "cmd" + q + ":" + q + "set-breakpoints" + q + "," + q + "lines" + q + ":[12]}", _
    "{" + q + "cmd" + q + ":" + q + "continue" + q + "}", _
    "{" + q + "cmd" + q + ":" + q + "stop" + q + "}"])
DIM h AS INTEGER : h = ersteMit("paused", 12)
DIM k AS JSON_HANDLE : k = JSON_PARSE(ereignisse[h])
DIM i AS INTEGER
FOR i = 0 TO JSON_LEN(k, "globals") - 1
    DIM p AS STRING : p = "globals." + STR$(i)
    DIM z AS STRING : z = JSON_GET_STRING(k, p + ".name") + " " + JSON_GET_STRING(k, p + ".type") + " " + JSON_GET_STRING(k, p + ".value")
    IF JSON_HAS(k, p + ".children") THEN
        z = z + " | " + STR$(JSON_LEN(k, p + ".children")) + ": " + JSON_GET_STRING(k, p + ".children.0.name") + "=" + JSON_GET_STRING(k, p + ".children.0.value")
        DIM letzt AS INTEGER : letzt = JSON_LEN(k, p + ".children") - 1
        z = z + " ... " + JSON_GET_STRING(k, p + ".children." + STR$(letzt) + ".name") + "=" + JSON_GET_STRING(k, p + ".children." + STR$(letzt) + ".value")
    END IF
    PRINT z
NEXT
--- datei sitzung.dh
IMPORT "{sammlung}/_hilfen/debugsitzung.dh"

--- datei d.dh
CLASS Held
    DIM hp AS INTEGER
    DIM name AS STRING
END CLASS
DIM held AS Held : held = NEW Held()
held.hp = 7 : held.name = "Ada"
DIM gross[150] AS INTEGER
DIM m AS MAP OF INTEGER : m = {"a": 1, "b": 2}
DIM t AS TUPLE : t = (1, "zwei")
DIM i AS INTEGER
FOR i = 0 TO 149 : gross[i] = i : NEXT
PRINT held.hp

