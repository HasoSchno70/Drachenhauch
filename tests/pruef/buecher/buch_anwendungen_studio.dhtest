PRINT "einstellungen "; FILEEXISTS(beim + "/einstellungen.save")
einschieben("kap23_mediathek", ["    DIM probeN AS INTEGER", _
    "    SUB Takt()", _
    "        Self.probeN = Self.probeN + 1", _
    "        IF Self.probeN = 3 THEN", _
    "            DIM bg AS INTEGER : bg = GUI_THEME_GET(" + q$("win_bg") + ")", _
    "            PRINT " + q$("hell ") + "; ((bg SHR 16) BAND 255) > 200; " + q$(" haken ") + "; GUI_MENU_CHECKED(Self.miHell)", _
    "            END", _
    "        END IF", _
    "    END SUB"])
PRINT zeile$(laufen$(m, 20, ""), "hell ")
' Bauen: Strg+B im Studio, dann die Exe von woanders gestartet.
slZeilen = []
slBild = 0
slHin(10, 10)
slWarten(10)
slMit([341], 66)
slWarten(600)
slAufnahmeSchreiben(CWD$() + "/bau.txt")
DIM lg AS STRING : lg = CWD$() + "/bau.log"
a = slStarten(lg, CWD$() + "/bau.txt", slBild + 20, pm)
PRINT "gebaut "; LEN(slAnfang(lg, "gebaut ")) = 1
DIM exe AS STRING : exe = "Mediathek" + IIF(LOWER$(RIGHT$(EXEPATH$(), 4)) = ".exe", ".exe", "")
PRINT "im bau "; JOIN$(DIRLIST(pm + "/bau"), " ") = "Mediathek.exe assets mediathek.db" OR JOIN$(DIRLIST(pm + "/bau"), " ") = "Mediathek assets mediathek.db"
PRINT "assets "; JOIN$(DIRLIST_REC(pm + "/bau/assets"), " ")
benutzer(CWD$() + "/jonas")
SETENV("DHRT_FRAMES", "20")
DIM lauf AS STRING : lauf = SHELL_OUT$(PATHJOIN(pm + "/bau", exe))
SETENV("DHRT_FRAMES", "")
PRINT "exe beim benutzer "; wert$(DIR_USER_DATA$("Mediathek") + "/mediathek.db", "SELECT COUNT(*) FROM eintrag")
' Erweitern 1: grosse Schrift ab dem naechsten Start.
benutzer(CWD$() + "/gross")
DIM mg AS STRING : mg = CWD$() + "/kap23_gross/_studio/main.dh"
IF NOT FILEEXISTS(CWD$() + "/kap23_gross/_studio/mediathek.db") THEN COPYFILE(CWD$() + "/kap23_gross/mediathek.db", CWD$() + "/kap23_gross/_studio/mediathek.db")
ev = []
klick(ev, 4, 215, 13)
klick(ev, 14, 260, 111)
a = bedienen$(mg, ev, 40)
PRINT zeile$(a, "label#status")
einschieben("kap23_gross", ["    DIM probeN AS INTEGER", _
    "    SUB Takt()", _
    "        Self.probeN = Self.probeN + 1", _
    "        IF Self.probeN = 3 THEN", _
    "            PRINT " + q$("schirm ") + "; SCREENWIDTH(); " + q$(" haken ") + "; GUI_MENU_CHECKED(Self.miGross)", _
    "            END", _
