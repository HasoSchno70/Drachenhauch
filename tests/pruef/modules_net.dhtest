=== set timeout null ist non blocking
' `NET_SET_TIMEOUT(sock, 0)` stellt NON-BLOCKING her, nicht blockierend.
IMPORT "net"
DIM l AS NET_LISTENER
DIM c AS NET_SOCKET
DIM s AS NET_SOCKET
l = NET_TCP_LISTEN(0)
c = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
WHILE IS_NIL(s)
    s = NET_TCP_ACCEPT(l)
WEND
DIM t0 AS INTEGER
DIM r AS STRING
NET_SET_TIMEOUT(c, 0)
t0 = MILLIS()
r = NET_RECV(c, 64)
PRINT MILLIS() - t0 < 100
PRINT r = ""
NET_CLOSE(c)
NET_CLOSE(s)
NET_CLOSE_LISTENER(l)
--- erwartet
TRUE
TRUE

=== set timeout positiv wartet und wirft nicht
' `ms > 0` wartet hoechstens so lange -- und ein abgelaufener Timeout ist
IMPORT "net"
DIM l AS NET_LISTENER
DIM c AS NET_SOCKET
DIM s AS NET_SOCKET
l = NET_TCP_LISTEN(0)
c = NET_TCP_CONNECT("127.0.0.1", NET_LISTENER_PORT(l))
WHILE IS_NIL(s)
    s = NET_TCP_ACCEPT(l)
WEND
DIM t0 AS INTEGER
DIM r AS STRING
NET_SET_TIMEOUT(c, 300)
t0 = MILLIS()
r = NET_RECV(c, 64)
PRINT MILLIS() - t0 >= 250
PRINT r = ""
NET_CLOSE(c)
NET_CLOSE(s)
NET_CLOSE_LISTENER(l)
--- erwartet
TRUE
TRUE

