DIM links AS INTEGER : links = GETPIXEL(img, 24, 24)
DIM rechts AS INTEGER : rechts = GETPIXEL(img, 88, 24)
PRINT "links gemalt " ; links <> grund
PRINT "rechts gemalt " ; rechts <> grund
PRINT "verschieden " ; links <> rechts
