SUB prFall()
    DIM t AS INTEGER
    prKnopf(2, GUI_GET_X(bBildName), GUI_GET_Y(bBildName), 128)
    prKnopf(10, GUI_WINDOW_GET_X(winName) + GUI_GET_X(bNamOk), GUI_WINDOW_GET_Y(winName) + GUI_GET_Y(bNamOk), 128)
