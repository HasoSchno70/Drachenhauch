=== funktionstaste trifft auch aus dem textfeld
' Ohne Strg/Alt gehoert eine Taste dem Textfeld mit Fokus -- F1..F12 aber
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM a AS INTEGER : a = GUI_MENU_ITEM(m, "Start", "F5")
DIM b AS INTEGER : b = GUI_MENU_ITEM(m, "Loeschen", "Entf")
DIM tf AS GUI_WIDGET : tf = GUI_TEXTINPUT(w, 10, 40, 200, 24, "abc")
GUI_FOCUS(tf)
DIM f AS INTEGER
FOR f = 1 TO 12
    GUI_UPDATE()
    IF GUI_CLICKED(a) THEN PRINT "start"
    IF GUI_CLICKED(b) THEN PRINT "loeschen"
    IF f = 12 THEN PRINT "text=" + GUI_TEXT(tf)
    GUI_DRAW()
    FLIP()
NEXT
