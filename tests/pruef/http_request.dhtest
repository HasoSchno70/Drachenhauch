4
fehler
0

=== timeout greift
' Gegenserver: tests/pruef/_hilfen/gegenserver.dh (Bis Stufe 48 in test_http_request.py.)
IMPORT "html"
FUNCTION starten$(modus AS STRING, verz AS STRING, schl AS STRING) AS STRING
    ' Gegenserver als Kind: ARG$(0) ist sein Pfad, er schreibt seinen Port in
    ' diesen Ordner. Rueckgabe "basis|prozess".
    DIM portdatei AS STRING : portdatei = CWD$() + "/port.txt"
    IF FILEEXISTS(portdatei) THEN DELETEFILE(portdatei)
    DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", ARG$(0), "--", modus, verz, schl, portdatei)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS(portdatei) THEN
            DIM z AS ARRAY OF STRING : z = READLINES(portdatei)
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN "http://127.0.0.1:" + TRIM$(z[0]) + "|" + STR$(p)
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN "|" + STR$(p)
END FUNCTION
DIM srv AS ARRAY OF STRING : srv = SPLIT$(starten$("echo", "2000", "-"), "|")
DIM basis AS STRING : basis = srv[0]
DIM t0 AS INTEGER
TRY
    HTTP_TIMEOUT(1)
    t0 = MILLIS()
    PRINT HTTP_REQUEST("GET", basis + "/langsam")
CATCH e
    PRINT "fehler: "; e
    ' Erst nach der Zeitgrenze -- eine abgewiesene Verbindung waere ein SOFORTIGER Fehler.
    PRINT "nach der zeitgrenze "; MILLIS() - t0 >= 900 AND MILLIS() - t0 < 1900
END TRY
PROCESS_KILL(VAL(srv[1]))
--- argumente
{sammlung}/_hilfen/gegenserver.dh
--- enthaelt
fehler: HTTP-Fehler
nach der zeitgrenze TRUE

=== hintergrund kann jetzt auch post
' Vorher konnte der Hintergrund-Pfad NUR GET -- ausgerechnet ein POST
' gegen eine langsame API liess sich nicht auslagern.
' Gegenserver: tests/pruef/_hilfen/gegenserver.dh (Bis Stufe 48 in test_http_request.py.)
IMPORT "html"
FUNCTION starten$(modus AS STRING, verz AS STRING, schl AS STRING) AS STRING
    ' Gegenserver als Kind: ARG$(0) ist sein Pfad, er schreibt seinen Port in
    ' diesen Ordner. Rueckgabe "basis|prozess".
    DIM portdatei AS STRING : portdatei = CWD$() + "/port.txt"
    IF FILEEXISTS(portdatei) THEN DELETEFILE(portdatei)
    DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", ARG$(0), "--", modus, verz, schl, portdatei)
    DIM t0 AS INTEGER : t0 = MILLIS()
    WHILE MILLIS() - t0 < 15000
        IF FILEEXISTS(portdatei) THEN
            DIM z AS ARRAY OF STRING : z = READLINES(portdatei)
            IF LEN(z) > 0 THEN
                IF TRIM$(z[0]) <> "" THEN RETURN "http://127.0.0.1:" + TRIM$(z[0]) + "|" + STR$(p)
            END IF
        END IF
        SLEEP(10)
    WEND
    RETURN "|" + STR$(p)
END FUNCTION
DIM srv AS ARRAY OF STRING : srv = SPLIT$(starten$("echo", "0", "-"), "|")
DIM basis AS STRING : basis = srv[0]
DIM nr AS INTEGER
DIM k AS MAP OF STRING
MAPPUT(k, "Authorization", "Bearer hintergrund")
nr = HTTP_REQUEST_START("POST", basis + "/x", "nutzlast", k)
WHILE NOT HTTP_READY(nr)
    SLEEP(10)
WEND
PRINT HTTP_RESULT(nr)
PROCESS_KILL(VAL(srv[1]))
