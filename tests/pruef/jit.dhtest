=== methodenrumpf aus der vm gerufen
CLASS Punkt
    DIM x AS FLOAT
    DIM y AS FLOAT
    SUB schieben(dx AS FLOAT, dy AS FLOAT)
        Self.x = Self.x + dx
        Self.y = Self.y + dy
    END SUB
    FUNCTION laenge2() AS FLOAT
        RETURN Self.x * Self.x + Self.y * Self.y
    END FUNCTION
    FUNCTION rechts(grenze AS FLOAT) AS BOOLEAN
        RETURN Self.x > grenze
    END FUNCTION
END CLASS
DIM p AS Punkt : p = NEW Punkt()
DIM i AS INTEGER
FOR i = 1 TO 5
    p.schieben(1.5, -0.5)
    PRINT p.laenge2(); " "; p.rechts(4.0)
NEXT
--- umgebung
DHRT_JIT=aus
--- erwartet
2.5 FALSE
10.0 FALSE
22.5 TRUE
40.0 TRUE
62.5 TRUE

