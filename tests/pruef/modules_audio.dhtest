CATCH e
    PRINT e
END TRY
TRY
    AUDIO_DELAY("nope", 0.5)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_FILTER: unbekannter Bus 'nope' (sfx, music, master)
AUDIO_REVERB: unbekannter Bus 'nope' (sfx, music, master)
AUDIO_DELAY: unbekannter Bus 'nope' (sfx, music, master)

=== bus dynamics eq validation
IMPORT "audio"
TRY
    AUDIO_DISTORTION("nope", 0.5)
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_COMPRESSOR("nope", -18, 4)
CATCH e
    PRINT e
END TRY
TRY
    AUDIO_EQ("nope", 100, 3)
CATCH e
    PRINT e
END TRY
--- erwartet
AUDIO_DISTORTION: unbekannter Bus 'nope' (sfx, music, master)
AUDIO_COMPRESSOR: unbekannter Bus 'nope' (sfx, music, master)
AUDIO_EQ: unbekannter Bus 'nope' (sfx, music, master)

