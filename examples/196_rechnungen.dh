reiter(lKPlz, 0) : GUI_LAYOUT_ADD(fK, lKPlz)
DIM tfKPlz AS GUI_WIDGET : tfKPlz = GUI_TEXTINPUT(win, 0, 0, 70, 0, "PLZ")
GUI_TEXTINPUT_SET(tfKPlz, "zahlen", 1) : GUI_TEXTINPUT_SET(tfKPlz, "maxlaenge", 5)
DIM tfKOrt AS GUI_WIDGET : tfKOrt = GUI_TEXTINPUT(win, 0, 0, 0, 0, "Ort")
reiter(tfKPlz, 0) : reiter(tfKOrt, 0)
GUI_LAYOUT_ADD(zK, tfKPlz) : GUI_LAYOUT_ADD(zK, tfKOrt, 1)
GUI_LAYOUT_ADD(fK, zK)
DIM tfKMail AS GUI_WIDGET : tfKMail = feld(fK, 0, "E-Mail", "name@firma.de")
DIM lKNotiz AS GUI_WIDGET : lKNotiz = GUI_LABEL(win, "Notiz", 0, 0)
