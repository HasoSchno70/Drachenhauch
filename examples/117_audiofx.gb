' 117_audiofx.gb -- Echtzeit-Audio-Effekte auf den Mixer-Bussen (Kira)
'
' Filter / Reverb / Delay liegen auf den Bussen (sfx/music/master) und werden
' zur Laufzeit gesteuert -- KEIN Buffer-Bake wie bei AUDIO_LOFI, sondern echte
' DSP auf dem Audio-Thread:
'
'   AUDIO_FILTER(bus$, cutoff_hz[, resonance])   ' Tiefpass (SID/Acid-Sweep)
'   AUDIO_REVERB(bus$, mix[, feedback[, damping]])' Hall (Hoehle/Halle)
'   AUDIO_DELAY (bus$, mix[, feedback])           ' Echo (300 ms)
'
' Maus links/rechts = Filter-Cutoff auf der Musik (links zu = dumpf).
'   F = Filter an/aus   R = Reverb an/aus   D = Delay an/aus   ESC = Ende

SCREEN(560, 280, "Echtzeit-Audio-Effekte", 2)
SETFPS(60)

PLAYMUSIC("assets/amiga_title.ogg", -1, 0.9)

DIM reverbOn AS BOOLEAN
DIM delayOn AS BOOLEAN
DIM filterOn AS BOOLEAN
reverbOn = FALSE : delayOn = FALSE : filterOn = TRUE

DIM rPrev AS BOOLEAN
DIM dPrev AS BOOLEAN
DIM fPrev AS BOOLEAN
rPrev = FALSE : dPrev = FALSE : fPrev = FALSE

DIM cutoff AS FLOAT
cutoff = 18000.0

DIM t AS FLOAT
DIM fft[28] AS FLOAT

WHILE NOT QUITREQUESTED()
    IF KEYPRESSED(27) THEN BREAK
    t = MILLIS() / 1000.0

    ' --- Tasten (Edge) ---
    DIM rNow AS BOOLEAN
    rNow = KEYPRESSED(114)         ' r
    IF rNow AND NOT rPrev THEN
        reverbOn = NOT reverbOn
        IF reverbOn THEN AUDIO_REVERB("master", 0.45, 0.85, 0.25) ELSE AUDIO_REVERB("master", 0.0, 0.0, 0.0)
    END IF
    rPrev = rNow

    DIM dNow AS BOOLEAN
    dNow = KEYPRESSED(100)         ' d
    IF dNow AND NOT dPrev THEN
        delayOn = NOT delayOn
        IF delayOn THEN AUDIO_DELAY("master", 0.4, 0.55) ELSE AUDIO_DELAY("master", 0.0, 0.0)
    END IF
    dPrev = dNow

    DIM fNow AS BOOLEAN
    fNow = KEYPRESSED(102)         ' f
    IF fNow AND NOT fPrev THEN filterOn = NOT filterOn
    fPrev = fNow

    ' --- Filter-Cutoff aus Maus-X (nur Musik-Bus) ---
    IF filterOn THEN
        DIM mx AS FLOAT
        mx = MOUSEX() / 560.0
        IF mx < 0.0 THEN mx = 0.0
        IF mx > 1.0 THEN mx = 1.0
        ' exponentiell 120 Hz .. 18000 Hz
        cutoff = 120.0 * 150.0 ^ mx
        AUDIO_FILTER("music", cutoff, 0.5)
    ELSE
        AUDIO_FILTER("music", 0, 0)        ' offen
    END IF

    ' --- Zeichnen ---
    CLS(&H0A0A18)
    TEXT_SIZE(22)
    TEXT(20, 16, "ECHTZEIT-AUDIO-EFFEKTE", HSV(INT(t * 60.0) MOD 360, 0.5, 1.0))
    TEXT_SIZE(13)
    TEXT(20, 52, "Maus L/R = Filter-Cutoff (Musik) -- links = dumpf", &H9FB4C8)
    TEXT(20, 74, "F Filter: " + IIF(filterOn, "AN  (" + STR$(INT(cutoff)) + " Hz)", "aus"), IIF(filterOn, &HFFC040, &H607090))
    TEXT(20, 94, "R Reverb (master): " + IIF(reverbOn, "AN", "aus"), IIF(reverbOn, &H80FF80, &H607090))
    TEXT(20, 114, "D Delay  (master): " + IIF(delayOn, "AN", "aus"), IIF(delayOn, &H80C0FF, &H607090))

    ' Spektrum (zeigt die Filterwirkung schoen)
    AUDIO_FFT(fft)
    DIM i AS INTEGER
    DIM h AS INTEGER
    FOR i = 0 TO 27
        h = INT(fft[i] * 120.0)
        BOX(20 + i * 19, 250 - h, 20 + i * 19 + 15, 250, HSV((i * 10) MOD 360, 0.8, 0.95))
    NEXT
    RECT(18, 140, 552, 252, &H303048)
    TEXT_SIZE(10)
    TEXT(20, 128, "FFT (master, post-FX)  --  ESC = Ende", &H708090)

    FLIP()
WEND

STOPMUSIC()
