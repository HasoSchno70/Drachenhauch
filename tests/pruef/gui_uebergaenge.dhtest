=== ohne uebergang springt das ueberfahren wie frueher
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
GUI_METRIC_SET("uebergang", 0)
AUTOMATION_PLAY("ev.txt")
