=== pdf: vier seiten mit 30 stichen, ueberlappung, anchor und wasserzeichen
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' breit.pxs: viermal das Probemuster auf 50 x 45, ueber die Seitengrenzen
' gelegt, mit Autor, Notizen und Beginn in den Metadaten. Ohne Hersteller
' schreibt PySticky ein Leerzeichen in die Zelle, Glutfaden keins.
DIM m AS kern.Muster : m = kern.pxsLaden("breit.pxs")
DIM o AS kern.PdfOptionen : o = gePdfOptionen(pal, "A4", 30, 3, "Anchor", "", FALSE, "NUR ANSICHT")
o.titel = "breit"
DIM ab AS ARRAY OF STRING : ab = kern.pdfExportieren(m, "aus.pdf", o)
PRINT geAbweichungen$(geLies$("breit.txt"), JOIN$(ab, CHR$(10)) + CHR$(10))
PRINT "datei "; FILEEXISTS("aus.pdf"); " seiten "; ab[LEN(ab) - 1]
--- argumente
{sammlung}/../../examples/glutfaden
