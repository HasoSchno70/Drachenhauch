' Die IDE in Drachenhauch (ide/ide.dh), Staende 13 bis 25 -- ohne Python
' geprueft. Bis Stufe 36 standen diese Faelle in tests/test_ide.py.
'
' Aufbau wie tests/pruef/werkzeug_ide.dhtest: die IDE als Kopie in _programm/,
' Aufnahme und Zwischenablage ueber einen Einschub hinter SETFPS(60), gelesen
' mit `--- nachher` (Protokoll zeilenweise, Dateien ueber `steht`/`zeige`,
' `pruefe$` laesst `dhrt --check` laufen). Feste Lagen: Parameter-Fenster ab
' (420, 230), Vorschau-Fenster ab (240, 120) mit dem Unterschied ab y = 160 je
' 22 Punkte, Knoepfe der Vorschau bei y = 681, Projektbaum ab y = 128.
' In der Aufnahme: 7 Mauslage, 6 Taste runter, 5 hoch, 2 Taste runter, 1 hoch.
--- seriell

=== das geruest setzt den abschluss gleich mit
' `IF x > 0 THEN` getippt und Enter -- das END IF steht da, die Marke dazwischen.
AUTOMATION_PLAY("ev.txt")
CLIPBOARD_SET("IF x > 0 THEN")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=230
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
--- datei spiel.dh
PRINT 1
--- datei _programm/ev.txt
c 14
e 25 2 269 0 0 0
e 27 1 269 0 0 0
e 45 2 257 0 0 0
e 47 1 257 0 0 0
e 70 2 341 0 0 0
e 70 2 86 0 0 0
e 72 1 86 0 0 0
e 72 1 341 0 0 0
e 100 2 257 0 0 0
e 102 1 257 0 0 0
e 140 2 341 0 0 0
e 140 2 83 0 0 0
e 142 1 83 0 0 0
e 142 1 341 0 0 0

--- nachher
DIM L AS ARRAY OF STRING : L = READLINES("_programm/ide.log")
FUNCTION hat(z AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF L[i] = z THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION zahl(p AS STRING) AS INTEGER
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION
FUNCTION erste$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION letzte$(p AS STRING) AS STRING
    DIM i AS INTEGER
    FOR i = LEN(L) - 1 TO 0 STEP -1
        IF LEFT$(L[i], LEN(p)) = p THEN RETURN L[i]
    NEXT
    RETURN ""
END FUNCTION
FUNCTION endet(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p AND RIGHT$(L[i], LEN(e)) = e THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION
FUNCTION alleEnden(p AS STRING, e AS STRING) AS BOOLEAN
    DIM i AS INTEGER
    DIM n AS INTEGER : n = 0
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            n = n + 1
            IF RIGHT$(L[i], LEN(e)) <> e THEN RETURN FALSE
        END IF
    NEXT
    RETURN n > 0
END FUNCTION
FUNCTION inhalt$(datei AS STRING) AS STRING
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(z) - 1
        r = r + z[i] + CHR$(10)
    NEXT
    RETURN r
END FUNCTION
SUB zeige(datei AS STRING)
    DIM z AS ARRAY OF STRING : z = READLINES(datei)
    DIM i AS INTEGER
    FOR i = 0 TO LEN(z) - 1
        PRINT "|" + z[i] + "|"
    NEXT
END SUB
FUNCTION alle$(p AS STRING) AS STRING
    DIM i AS INTEGER
    DIM r AS STRING : r = ""
    FOR i = 0 TO LEN(L) - 1
        IF LEFT$(L[i], LEN(p)) = p THEN
            IF r <> "" THEN r = r + "|"
            r = r + L[i]
        END IF
    NEXT
    RETURN r
END FUNCTION
FUNCTION pruefe$(datei AS STRING) AS STRING
    DIM pc AS INTEGER : pc = PROCESS_START("dhrt", "--check", datei)
    DIM bis AS INTEGER : bis = MILLIS() + 60000
    DIM befund AS STRING : befund = ""
    WHILE MILLIS() < bis
        DIM zz AS STRING : zz = PROCESS_READ$(pc)
        IF zz <> "" THEN befund = befund + zz
        IF zz = "" AND NOT PROCESS_RUNNING(pc) THEN BREAK
    WEND
    RETURN TRIM$(befund)
END FUNCTION
FUNCTION steht(datei AS STRING, t AS STRING) AS BOOLEAN
    RETURN INSTR(inhalt$(datei), t) >= 0
END FUNCTION
PRINT "geruest " ; LEFT$(inhalt$("spiel.dh"), LEN("PRINT 1" + CHR$(10) + "IF x > 0 THEN" + CHR$(10) + "    " + CHR$(10) + "END IF")) = "PRINT 1" + CHR$(10) + "IF x > 0 THEN" + CHR$(10) + "    " + CHR$(10) + "END IF"
--- erwartet
geruest TRUE

