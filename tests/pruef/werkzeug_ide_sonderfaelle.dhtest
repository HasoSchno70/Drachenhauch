END FUNCTION
FUNCTION nahe(c AS INTEGER, r AS INTEGER, g AS INTEGER, b AS INTEGER, tol AS INTEGER) AS BOOLEAN
    IF c < 0 THEN RETURN FALSE
    DIM cr AS INTEGER : cr = (c SHR 16) BAND 255
    DIM cg AS INTEGER : cg = (c SHR 8) BAND 255
    DIM cb AS INTEGER : cb = c BAND 255
    RETURN ABS(cr - r) <= tol AND ABS(cg - g) <= tol AND ABS(cb - b) <= tol
END FUNCTION
DIM bild AS IMAGE : bild = LOADIMAGE("bild.png")
' Zeilen (y), in denen die Fundstellenfarbe &HFFD070 vorkommt
DIM hatY[260] AS BOOLEAN
DIM x AS INTEGER
DIM y AS INTEGER
FOR y = 60 TO 259
    FOR x = 220 TO 1199
        IF nahe(GETPIXEL(bild, x, y), 255, 208, 112, 40) THEN
            hatY[y] = TRUE
            BREAK
        END IF
    NEXT
NEXT
' zusammenhaengende Baender (Luecke > 3 beginnt ein neues)
DIM baender AS INTEGER : baender = 0
DIM letztesY AS INTEGER : letztesY = -100
DIM bandVon AS INTEGER : bandVon = 0
DIM bandBis AS INTEGER : bandBis = 0
FOR y = 60 TO 259
    IF hatY[y] THEN
        IF y - letztesY > 3 THEN
            baender = baender + 1
            bandVon = y
        END IF
        bandBis = y
        letztesY = y
    END IF
NEXT
PRINT "drei baender " ; baender = 3
' im letzten Band: Woerter nach x (Luecke > 6)
DIM hatX[1200] AS BOOLEAN
FOR y = bandVon TO bandBis
    FOR x = 220 TO 1199
        IF nahe(GETPIXEL(bild, x, y), 255, 208, 112, 40) THEN hatX[x] = TRUE
    NEXT
NEXT
DIM woerter AS INTEGER : woerter = 0
DIM letztesX AS INTEGER : letztesX = -100
FOR x = 220 TO 1199
    IF hatX[x] THEN
        IF x - letztesX > 6 THEN woerter = woerter + 1
        letztesX = x
    END IF
NEXT
PRINT "zwei woerter in zeile 4 " ; woerter = 2
--- erwartet
drei baender TRUE
zwei woerter in zeile 4 TRUE

=== farbfeld oeffnet den waehler
' Zwei Laeufe: der erste liefert das Bildschirmfoto, das `--- zwischen` sucht
' darin das Farbfeld (&HFF8800) und schreibt eine Aufnahme mit einem Klick
' auf seine Mitte, der zweite Lauf spielt sie ab.
IF FILEEXISTS("ev.txt") THEN AUTOMATION_PLAY("ev.txt")
--- programm ../../ide/ide.dh nach SETFPS(60)
--- argumente
spiel.dh
--- umgebung
DHRT_FRAMES=200
DH_IDE_LOG=ide.log
DH_IDE_WURZEL={sammlung}/../..
DH_IDE_KONFIG=ide.json
DHRT_SCREENSHOT={fall}/bild.png
--- datei spiel.dh
SCREEN(320, 240)
CLS(&HFF8800)
--- zwischen
FUNCTION nahe(c AS INTEGER, r AS INTEGER, g AS INTEGER, b AS INTEGER, tol AS INTEGER) AS BOOLEAN
    IF c < 0 THEN RETURN FALSE
    DIM cr AS INTEGER : cr = (c SHR 16) BAND 255
    DIM cg AS INTEGER : cg = (c SHR 8) BAND 255
    DIM cb AS INTEGER : cb = c BAND 255
    RETURN ABS(cr - r) <= tol AND ABS(cg - g) <= tol AND ABS(cb - b) <= tol
END FUNCTION
DIM bild AS IMAGE : bild = LOADIMAGE("bild.png")
DIM x AS INTEGER
DIM y AS INTEGER
DIM sx AS INTEGER : sx = 0
DIM sy AS INTEGER : sy = 0
DIM n AS INTEGER : n = 0
FOR y = 60 TO 199
    FOR x = 220 TO 1399
        IF nahe(GETPIXEL(bild, x, y), 255, 136, 0, 20) THEN
            sx = sx + x : sy = sy + y : n = n + 1
        END IF
    NEXT
NEXT
IF n = 0 THEN
    EPRINT("kein Farbfeld im Bild")
    EXIT(2)
END IF
DIM mx AS INTEGER : mx = sx \ n
DIM my AS INTEGER : my = sy \ n
' Klick auf das Feld (Lage, Lage, Druck, Loslassen) -- raylibs Aufnahmeformat
DIM t AS STRING : t = "c 4" + CHR$(10)
t = t + "e 40 7 " + STR$(mx) + " " + STR$(my) + " 0 0" + CHR$(10)
t = t + "e 41 7 " + STR$(mx) + " " + STR$(my) + " 0 0" + CHR$(10)
t = t + "e 42 6 0 0 0 0" + CHR$(10)
t = t + "e 44 5 0 0 0 0" + CHR$(10)
WRITEALL("_programm/ev.txt", t + CHR$(10))
--- nochmal
spiel.dh
