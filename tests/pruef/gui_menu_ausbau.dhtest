=== text aendern und falsche handles
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM a AS INTEGER : a = GUI_MENU_ITEM(m, "Pause")
GUI_MENU_TEXT(a, "Weiter")
PRINT INSTR(GUI_TO_JSON(w), "Weiter") >= 0
TRY
    GUI_MENU_ENABLE(m, FALSE)
CATCH e
    PRINT e
END TRY
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "k", 10, 40, 60, 24)
TRY
    GUI_MENU_CHECK(b, TRUE)
CATCH e2
    PRINT e2
END TRY
GUI_MENU_SEPARATOR(m)
--- umgebung
DHRT_FRAMES=1
--- erwartet
TRUE
GUI_MENU_ENABLE: erwartet einen Menue-Eintrag (von GUI_MENU_ITEM)
GUI_MENU_CHECK: erwartet einen Menue-Eintrag (von GUI_MENU_ITEM)

