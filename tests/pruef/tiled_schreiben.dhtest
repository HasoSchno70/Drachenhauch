' Aus test_tiled_schreiben.py uebertragen (18 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== ein fremder leser versteht die datei
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(8, 5, 16, 16)
DIM ts AS INTEGER
ts = TILED_ADD_TILESET(m, "tiles.png", 64)
DIM boden AS INTEGER
boden = TILED_ADD_LAYER(m, "Boden")
DIM deko AS INTEGER
deko = TILED_ADD_LAYER(m, "Deko")
TILED_FILL_RECT(m, boden, 0, 0, 8, 5, 1)
TILED_TILE_SET(m, boden, 3, 2, 7)
TILED_TILE_SET(m, deko, 1, 1, 12)
TILED_SAVE(m, "karte.json")
--- erwartet

=== die datei ist eine tiled map
' `type: "map"` ist das, woran jeder Leser sie erkennt -- der eigene
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(8, 5, 16, 16)
DIM ts AS INTEGER
ts = TILED_ADD_TILESET(m, "tiles.png", 64)
DIM boden AS INTEGER
boden = TILED_ADD_LAYER(m, "Boden")
DIM deko AS INTEGER
deko = TILED_ADD_LAYER(m, "Deko")
TILED_FILL_RECT(m, boden, 0, 0, 8, 5, 1)
TILED_TILE_SET(m, boden, 3, 2, 7)
TILED_TILE_SET(m, deko, 1, 1, 12)
TILED_SAVE(m, "karte.json")
--- erwartet

=== der eigene leser bekommt dasselbe zurueck
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(8, 5, 16, 16)
DIM ts AS INTEGER
ts = TILED_ADD_TILESET(m, "tiles.png", 64)
DIM boden AS INTEGER
boden = TILED_ADD_LAYER(m, "Boden")
DIM deko AS INTEGER
deko = TILED_ADD_LAYER(m, "Deko")
TILED_FILL_RECT(m, boden, 0, 0, 8, 5, 1)
TILED_TILE_SET(m, boden, 3, 2, 7)
TILED_TILE_SET(m, deko, 1, 1, 12)
TILED_SAVE(m, "karte.json")

DIM m2 AS TILED_MAP
m2 = TILED_LOAD("karte.json")
PRINT TILED_WIDTH(m2); " "; TILED_HEIGHT(m2); " "; TILED_LAYER_COUNT(m2); " "; _
      TILED_TILE_AT(m2, 0, 3, 2); " "; TILED_TILE_AT(m2, 1, 1, 1)
--- erwartet
8 5 2 7 12

=== gids der tilesets ueberlappen nicht
' Die `firstgid` wird selbst vergeben. Überlappende Bereiche zerstören
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER
a = TILED_ADD_TILESET(m, "a.png", 64)
DIM b AS INTEGER
b = TILED_ADD_TILESET(m, "b.png", 20)
DIM c AS INTEGER
c = TILED_ADD_TILESET(m, "c.png", 5)
PRINT TILED_TILESET_FIRSTGID(m, 0); " "; TILED_TILESET_FIRSTGID(m, 1); " "; _
      TILED_TILESET_FIRSTGID(m, 2)
--- erwartet
1 65 85

=== doppelter ebenenname wird abgelehnt
' Ebenen werden auch über den Namen gefunden (`TILED_LAYER_INDEX`) --
IMPORT "tiled"
DIM m AS TILED_MAP
m = TILED_NEW(4, 4, 16, 16)
DIM a AS INTEGER
a = TILED_ADD_LAYER(m, "Boden")
TRY
    DIM b AS INTEGER
    b = TILED_ADD_LAYER(m, "Boden")
    PRINT "angenommen"
CATCH e
    PRINT "abgelehnt"
END TRY
--- erwartet
abgelehnt

=== unsinnige masse werden abgelehnt (1)
IMPORT "tiled"
TRY
    DIM m AS TILED_MAP
    m = TILED_NEW(0, 5, 16, 16)
    PRINT "angenommen"
CATCH e
    PRINT "abgelehnt"
END TRY
--- erwartet
abgelehnt

