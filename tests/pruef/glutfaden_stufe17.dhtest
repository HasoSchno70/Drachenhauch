' Glutfaden Stufe 17: Info- und Fortschritts-Leiste (ansicht/infoleiste.dh,
' PySticky InfoPanel und ProgressPanel) und der Symbol-Editor
' (ansicht/dialoge.dh, SymbolEditorDialog).
'
' Die Texte der Info-Leiste und die Symbolsuche sind gegen PySticky
' aufgezeichnet (InfoPanel.update_info, _calculate_thread_per_color,
' get_progress_statistics, _symbol_matches_query) -- die Erwartungen der
' ersten beiden Faelle SIND diese Aufzeichnung. Der Rest ist Bedienung: die
' Probe der beiden Reiter und des Editors.

=== info-leiste wie pysticky
IMPORT "helfer.dh"
' Je Muster: wie geladen, im Diamond-Modus, jeder Stoff, Farbe 1 ausgelassen,
' Farbe 0 erledigt -- die neun Karten, je Farbe Stiche und Garn, und die
' Fortschritts-Zahlen (Gesamt in Promille wie der Balken, je Farbe Prozent)
SUB karten(name AS STRING, m AS kern.Muster, modus AS STRING)
    PRINT name; " | "; JOIN$(kern.infoKarten(m, modus), " | ")
    DIM je AS ARRAY OF STRING : je = []
    DIM i AS INTEGER
    FOR i = 0 TO m.farbanzahl() - 1
        DIM f AS kern.Farbeintrag : f = m.farben[i]
        IF f.stichzahl > 0 AND NOT f.auslassen THEN
            ARRAY_PUSH(je, STR$(f.stichzahl) + " " + kern.garnJeFarbeText$(f.stichzahl, m.stoff, modus))
        ELSEIF f.auslassen THEN
            ARRAY_PUSH(je, "uebersp")
        ELSE
            ARRAY_PUSH(je, "0")
        END IF
    NEXT
    PRINT "  je farbe: "; JOIN$(je, "; ")
    DIM p AS kern.Fortschritt : p = kern.fortschrittVon(m)
    DIM pf AS ARRAY OF STRING : pf = []
    FOR i = 0 TO m.farbanzahl() - 1
        IF p.farbeGesamt[i] > 0 THEN ARRAY_PUSH(pf, STR$(p.farbeErledigt[i]) + "/" + STR$(p.farbeGesamt[i]) + " " + kern.farbeProzentText$(p, i))
    NEXT
    PRINT "  fortschritt "; p.erledigt; "/"; p.gesamt; " "; INT(p.prozent * 10 + 0.000001); ": "; JOIN$(pf, "; ")
END SUB

DIM pfad AS STRING
FOR EACH pfad IN ["alle.pxs", "farbprobe.pxs", GLUTORDNER + "/daten/muster/demo_kreuzstich.pxs"]
    DIM name AS STRING : name = BASENAME(pfad)
    DIM m AS kern.Muster : m = kern.pxsLaden(pfad)
    m.stichzahlenNeu()
    karten(name + " geladen", m, "stitch")
    karten(name + " diamond", m, "diamond")
    DIM st AS INTEGER
    FOR EACH st IN [11, 16, 18, 22, 28, 32]
        m.stoff = st
        karten(name + " stoff " + STR$(st), m, "stitch")
    NEXT
    m.stoff = 14
    IF m.farbanzahl() > 1 THEN
        m.farben[1].auslassen = TRUE
        karten(name + " farbe 1 aus", m, "stitch")
        m.farben[1].auslassen = FALSE
    END IF
    DIM v AS kern.Verlauf : v = kern.neuerVerlauf()
    DIM n AS INTEGER : n = kern.farbeErledigt(m, v, 0)
    karten(name + " farbe 0 erledigt", m, "stitch")
NEXT
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
CONST GLUTORDNER = "{sammlung}/../../examples/glutfaden"
