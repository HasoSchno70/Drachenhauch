' Uebergaenge (Metrik `uebergang`, 2026-09-23): Ueberfahren blendet ueber
' die Dauer ein und aus, Druecken und Fokus erscheinen SOFORT und blenden nur
' aus. Geprueft am BILD: ein Knopf mit eigenen Farben fuer Grund (dunkelblau),
' Ueberfahren (hellgrau) und Druecken (gruen), die Maus kommt ueber eine
' Aufnahme. Headless ist DELTA fest 1/60 -- jedes Bild ist dieselbe Stufe.
' Die Faelle mit `uebergang` 0 sind die Gegenprobe: dort springt es wie vor
' der Aenderung.
' Format: docs/werkzeuge.md, dhrt test.

=== die metrik ist da und hat eine vorgabe
IMPORT "gui"
PRINT GUI_METRIC_GET("uebergang")
GUI_METRIC_SET("uebergang", 0)
PRINT GUI_METRIC_GET("uebergang")
--- erwartet
120
0

=== ueberfahren blendet ein
IMPORT "gui"
SCREEN(300, 200, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW : w = GUI_WINDOW("A", 0, 0, 300, 200)
GUI_WINDOW_CHROME(w, FALSE)
DIM b AS GUI_WIDGET : b = GUI_BUTTON(w, "", 50, 50, 100, 40)
GUI_SET_COLOR(b, "bg", &H204080)
GUI_SET_COLOR(b, "hover", &HE0E0E0)
GUI_SET_COLOR(b, "pressed", &H00FF00)
WHILE NOT QUITREQUESTED()
    GUI_UPDATE()
    CLS(0)
    GUI_DRAW()
    FLIP()
WEND
--- datei ev.txt
c 2
e 0 7 5 5 0 0
e 1 7 100 70 0 0

--- umgebung
DHRT_FRAMES=5
--- bild
100 60 nicht #204080 +-20
100 60 nicht #E0E0E0 +-20

