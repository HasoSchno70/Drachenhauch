--- erwartet
schluessel datei: Mein Muster.v2 | ordner Mein_Muster_v2 in snapshots
schluessel ungesichert: Analyseprobe__abcd | _unnamed__x1
faellig ohne: TRUE
erster: v_2026-03-29_01-59-30.pxs zeit TRUE
gleiche sekunde: v_2026-03-29_01-59-31.pxs
faellig nach 1799: FALSE nach 1800: TRUE
nach 24: 20 | neuester v_2026-03-29_02-21-30.pxs | aeltester v_2026-03-29_02-02-30.pxs
fremde dateien zaehlen nicht: 20 | -1 -1
gelesen: 30x24 8 farben
unbekannt: 0

=== vorlagen: eingebaut, dp-groessen, eigene schreiben und lesen
IMPORT "helfer.dh"
DIM k AS STRING
DIM v AS kern.Vorlage
FOR EACH k IN kern.vorlagenKategorien()
    DIM n AS ARRAY OF STRING : n = []
    FOR EACH v IN kern.vorlagen()
        IF v.kategorie = k THEN ARRAY_PUSH(n, v.name + " " + STR$(v.breite) + "x" + STR$(v.hoehe))
    NEXT
    PRINT k; ": "; JOIN$(n, " | ")
NEXT
DIM dn AS ARRAY OF STRING : dn = kern.dpVorlagenNamen()
DIM dm AS ARRAY OF INTEGER : dm = kern.dpVorlagenMasse()
DIM i AS INTEGER
FOR i = 0 TO LEN(dn) - 1
    PRINT "dp "; dn[i]; " = "; dm[2 * i]; "x"; dm[2 * i + 1]
NEXT
DIM l AS ARRAY OF kern.Vorlage : l = kern.eigeneVorlagen("user_templates.json")
v = kern.vorlageNeu("Saisonal", "Neu " + CHR$(34) + "mit" + CHR$(34) + " Zeichen", 11, 22, "", "Zeile 1" + CHR$(10) + "Zeile 2")
v.stoff = 18
ARRAY_PUSH(l, v)
WRITEALL("neu.json", kern.eigeneVorlagenJson$(l))
FOR EACH v IN kern.eigeneVorlagen("neu.json")
    PRINT "rundweg "; v.name; " "; v.breite; "x"; v.hoehe; " "; v.stoff; " "; v.kategorie; " "; LEN(v.beschreibung)
NEXT
WRITEALL("kaputt.json", "[{""name"": 1")
PRINT "kaputt: "; LEN(kern.eigeneVorlagen("kaputt.json")); " fehlt: "; LEN(kern.eigeneVorlagen("gibt_es_nicht.json"))
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"
IMPORT "{sammlung}/_hilfen/glutfaden_verwalten.dh"
IMPORT "{sammlung}/_hilfen/dhrtlauf.dh"
CONST BEISPIEL = "{sammlung}/../../examples/glutfaden/main.dh"
