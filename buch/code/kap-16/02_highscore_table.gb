' Top-5-Highscore-Tabelle: Score + Name in 10 Save-Keys.
'
' Layout der Save-Datei:
'   score_0..score_4    -> INTEGER, hoechster bei Index 0
'   name_0..name_4      -> STRING, parallel zu den scores
'
' AddScore findet die Einfuege-Position, schiebt darunter liegende
' Eintraege um eins nach hinten, fuegt den neuen ein. Wer nicht in
' die Top-5 kommt, wird stillschweigend verworfen.

IMPORT "save"

CONST SAVE_PATH AS STRING  = "kap16_table.save"
CONST TABLE_LEN AS INTEGER = 5

DIM s AS SAVE_HANDLE
s = SAVE_LOAD_OR_NEW(SAVE_PATH)

SUB AddScore(player AS STRING, score AS INTEGER)
    ' Position suchen, ab der unser Score eingefuegt wird
    DIM pos AS INTEGER
    pos = -1
    DIM i AS INTEGER
    FOR i = 0 TO TABLE_LEN - 1
        DIM existing AS INTEGER
        existing = SAVE_GET_INT_OR(s, f"score_{i}", 0)
        IF score > existing THEN
            pos = i
            BREAK
        END IF
    NEXT i

    IF pos = -1 THEN RETURN     ' Score nicht gut genug

    ' Eintraege ab pos um eins nach hinten verschieben (von hinten her)
    FOR i = TABLE_LEN - 1 TO pos + 1 STEP -1
        SAVE_SET_INT(s,    f"score_{i}", SAVE_GET_INT_OR(s,    f"score_{i - 1}", 0))
        SAVE_SET_STRING(s, f"name_{i}",  SAVE_GET_STRING_OR(s, f"name_{i - 1}",  ""))
    NEXT i

    ' Neuen Eintrag bei pos einfuegen
    SAVE_SET_INT(s,    f"score_{pos}", score)
    SAVE_SET_STRING(s, f"name_{pos}",  player)
END SUB

SUB ShowTable()
    PRINT "TOP 5"
    PRINT "-----"
    DIM i AS INTEGER
    FOR i = 0 TO TABLE_LEN - 1
        DIM sc   AS INTEGER
        DIM name AS STRING
        sc   = SAVE_GET_INT_OR(s,    f"score_{i}", 0)
        name = SAVE_GET_STRING_OR(s, f"name_{i}",  "---")
        PRINT f"  {i + 1}. {name}: {sc}"
    NEXT i
END SUB

PRINT "Anfangs (leer):"
ShowTable()

PRINT ""
PRINT "Sechs Spiele werden gespielt:"
AddScore("ANNA",  1500)
AddScore("BERT",   800)
AddScore("CARA",  2300)
AddScore("DORA",   100)
AddScore("EREN",  1700)
AddScore("FELIX",   50)        ' zu wenig - faellt raus

ShowTable()

PRINT ""
SAVE_WRITE(s, SAVE_PATH)
PRINT "Tabelle gespeichert nach " + SAVE_PATH

' Aufraeumen
SAVE_DELETE_FILE(SAVE_PATH)
