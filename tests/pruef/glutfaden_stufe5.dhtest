--- erwartet
demo: 800x800 gegen 800x800, abweichend 0 von 1600
probe: 240x180 gegen 240x180, abweichend 2 von 108

=== bild: teilstiche, knoten und perle wie pysticky
IMPORT "helfer.dh"
DIM pal AS ARRAY OF kern.Palette : pal = kern.palettenLaden(ARG$(0) + "/daten/paletten")
DIM sym AS ARRAY OF STRING : sym = kern.symboleLaden(ARG$(0) + "/daten/symbole.txt")
' Je Kaestchen die Punkte, die nicht Stoff sind -- gegen PyStickys Bild. Ohne
' Kantenglaettung weichen sie etwas ab; verlangt ist hoechstens ein Fuenftel
' (der Knoten ist der knappste: 44 gegen 52).
FUNCTION punkte(b AS IMAGE, cx AS INTEGER, cy AS INTEGER) AS INTEGER
    DIM n AS INTEGER, x AS INTEGER, y AS INTEGER
    FOR y = cy * 20 TO cy * 20 + 19
        FOR x = cx * 20 TO cx * 20 + 19
            IF GETPIXEL(b, x, y) <> &HFAFAF5 THEN n = n + 1
        NEXT
    NEXT
    RETURN n
END FUNCTION
DIM p AS kern.Muster : p = kern.pxsLaden("probe.pxs")
kern.bildExportieren(p, "probe.png", 20, FALSE, FALSE)
DIM a AS IMAGE : a = LOADIMAGE("probe.png")
DIM b AS IMAGE : b = LOADIMAGE("probe_py_nackt.png")
DIM zellen AS ARRAY OF INTEGER : zellen = [1, 2, 2, 2, 3, 2, 4, 2, 5, 2, 6, 2, 7, 2, 1, 4, 3, 4]
DIM namen AS ARRAY OF STRING : namen = ["halb 1", "halb 2", "viertel ol", "viertel or", "viertel ul", "viertel ur", "dreiviertel", "knoten", "perle"]
DIM i AS INTEGER
FOR i = 0 TO LEN(namen) - 1
    DIM u AS INTEGER : u = punkte(a, zellen[i * 2], zellen[i * 2 + 1])
    DIM s AS INTEGER : s = punkte(b, zellen[i * 2], zellen[i * 2 + 1])
    PRINT namen[i]; ": "; ABS(u - s) * 5 <= s
NEXT
' die Perle hat ihren Glanzpunkt: oben links heller als die Mitte
PRINT "glanz: "; GETPIXEL(a, 3 * 20 + 7, 4 * 20 + 7) <> GETPIXEL(a, 3 * 20 + 10, 4 * 20 + 12)
--- argumente
{sammlung}/../../examples/glutfaden
--- datei helfer.dh
IMPORT "{sammlung}/../../examples/glutfaden/kern/kern.dh" AS kern
IMPORT "{sammlung}/_hilfen/glutfaden_export.dh"

