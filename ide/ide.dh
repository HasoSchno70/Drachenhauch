' ============================================================
'  DRACHENHAUCH -- die IDE in Drachenhauch (Weg C, Stand 4)
' ============================================================
'  Eine Entwicklungsumgebung, geschrieben in der Sprache, die sie
'  bedient. Sie soll die Qt-IDE abloesen; bis sie gleichzieht, bleibt
'  die Qt-IDE im Installer (docs/entwurf-python-abbau.md, Weg C).
'
'  Stand 1 kann: Dateien in Reitern oeffnen, bearbeiten, sichern;
'  Projektbaum; Syntax-Einfaerbung des sichtbaren Ausschnitts; Fehler-
'  liste aus der Front-End-Kette (CODE_CHECK$), Klick springt zur Zeile;
'  Hilfe zum Wort unter der Marke (CODE_HOVER$); Vervollstaendigung
'  (Strg+Leertaste, CODE_COMPLETE); Suchen, Ersetzen, Gehe zu Zeile;
'  Programm starten und stoppen mit laufender Ausgabe (PROCESS_*),
'  Eingaben an INPUT durchreichen.
'  Stand 2 dazu: Debugger (Haltepunkte F9, Schritte F8/F10/F11, Variablen
'  im Fenster -- Client von `dhrt debug`), Profil (`dhrt profile`, Tabelle
'  nach Zeit), Suche im Projekt, Befehlspalette, Marken in der Nummern-
'  spalte (GUI_TEXTAREA_MARKS), echte Schriften, Start maximiert.
'  Stand 3 dazu: Handbuch im Fenster (F1 = das Wort unter der Marke in
'  docs/ nachschlagen), Listing drucken oder als PDF (pdf-Modul), die
'  Begleit-Editoren in Drachenhauch aus dem Menue Werkzeuge, Ausdruecke im
'  angehaltenen Debugger auswerten (Strg+E in die Eingabezeile).
'  Stand 4 dazu: Willkommensseite mit den zuletzt geoeffneten Dateien,
'  Sitzung und Einstellungen in einer JSON-Datei im Nutzerprofil, Datei im
'  Projekt oeffnen (Strg+Umschalt+O, unscharf gefiltert), die Handgriffe
'  im Text (Kommentar umschalten, Zeilen duplizieren/loeschen/verschieben,
'  ein- und ausruecken, Formatieren ueber CODE_FORMAT$), Lesezeichen,
'  Gliederung links unten, bedingte Haltepunkte (Umschalt+F9), Export als
'  eigenstaendiges Programm (dhrt --export), Druckdialog mit Druckerwahl,
'  TODO/FIXME-Liste, Tastenkuerzel-Uebersicht, Schriftgroesse.
'
'  Ordner: docs/ und examples/ liegen neben ide/ (Repo wie Installation);
'  DH_IDE_WURZEL uebersteuert das (Tests, verschobene Kopien).
'
'  Aufruf:  dhrt run ide/ide.dh [-- datei.dh]
'  Test:    DH_IDE_LOG=<datei> schreibt die Ereignisse zeilenweise mit --
'           so pruefen die Tests, was die IDE getan hat, ohne ins Bild zu sehen.
' ============================================================
IMPORT "gui"
IMPORT "json"
IMPORT "pdf"

CONST MAX_TABS = 12
CONST NL = CHR$(10)

' --- Farben der Einfaerbung ------------------------------------------
CONST F_GRUND      = &HD8E4F0
CONST F_KOMMENTAR  = &H6A8A5A
CONST F_TEXT       = &HE0A060
CONST F_ZAHL       = &HD07070
CONST F_SCHLUESSEL = &H2BC4E8
CONST F_OPERATOR   = &H9AA8B8

SCREEN(1280, 800, "Drachenhauch", 1)
WINDOW_RESIZABLE(TRUE)
WINDOW_MIN_SIZE(800, 500)
SETFPS(60)
WINDOW_MAXIMIZE()
GUI_THEME_PRESET("glas_dunkel")

' Schrift: eine Textschrift fuer die Oberflaeche, eine dicktengleiche fuer den
' Code. Geladen in 32 px und in 16 gezeichnet -- so bleibt sie scharf. Ohne
' Fund bleibt raylibs Bitmapschrift.
DIM uiFont AS INTEGER : uiFont = -1
DIM codeFont AS INTEGER : codeFont = -1
DIM fp AS STRING
FOR EACH fp IN ("C:/Windows/Fonts/segoeui.ttf", "/System/Library/Fonts/Supplemental/Arial.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    IF uiFont < 0 AND FILEEXISTS(fp) THEN uiFont = LOADFONT(fp, 32)
NEXT
FOR EACH fp IN ("C:/Windows/Fonts/consola.ttf", "/System/Library/Fonts/Menlo.ttc", "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf")
    IF codeFont < 0 AND FILEEXISTS(fp) THEN codeFont = LOADFONT(fp, 32)
NEXT
IF uiFont >= 0 THEN SETFONT(uiFont) : TEXT_SIZE(16)

' --- Zustand -----------------------------------------------------------
DIM logDatei AS STRING : logDatei = GETENV$("DH_IDE_LOG")
' dhrt wechselt vor dem Lauf ins Verzeichnis der IDE -- der Nutzer steht
' woanders, und DORT liegt sein Projekt (DHRT_START_DIR, von dhrt gesetzt).
DIM startOrdner AS STRING : startOrdner = GETENV$("DHRT_START_DIR")
IF startOrdner = "" THEN startOrdner = CWD$()
DIM projektOrdner AS STRING : projektOrdner = startOrdner

DIM tabPfade[MAX_TABS] AS STRING
DIM tabFelder[MAX_TABS] AS GUI_WIDGET
DIM tabGesichert[MAX_TABS] AS STRING
DIM tabLetzterText[MAX_TABS] AS STRING
DIM tabAnzahl AS INTEGER : tabAnzahl = 0
DIM aktiverTab AS INTEGER : aktiverTab = -1

DIM prozess AS INTEGER : prozess = -1
DIM prozessDatei AS STRING : prozessDatei = ""
DIM pruefungFaellig AS FLOAT : pruefungFaellig = -1.0
DIM letzteMarke AS STRING : letzteMarke = ""
DIM suchtext AS STRING : suchtext = ""
DIM ersatztext AS STRING : ersatztext = ""
DIM fertigNachStopp AS BOOLEAN : fertigNachStopp = FALSE
DIM prozessArt AS STRING : prozessArt = ""          ' run / debug / profile
DIM prozessRest AS STRING : prozessRest = ""        ' halbe Zeile aus stdout

' Debugger
DIM debugPause AS BOOLEAN : debugPause = FALSE
DIM debugErst AS BOOLEAN : debugErst = FALSE
DIM debugZeile AS INTEGER : debugZeile = 0
DIM hpDateien AS ARRAY OF STRING : hpDateien = []
DIM hpZeilen AS ARRAY OF INTEGER : hpZeilen = []
DIM hpBedingungen AS ARRAY OF STRING : hpBedingungen = []   ' "" = unbedingt
DIM markenSchluessel AS STRING : markenSchluessel = ""

' Lesezeichen (Strg+F2 setzt, F2 springt zum naechsten)
DIM lzDateien AS ARRAY OF STRING : lzDateien = []
DIM lzZeilen AS ARRAY OF INTEGER : lzZeilen = []

' Export als eigenstaendiges Programm (dhrt --export), ein eigener Prozess
DIM exportProzess AS INTEGER : exportProzess = -1
DIM exportDatei AS STRING : exportDatei = ""

' Gliederung (SUB/FUNCTION/CLASS der aktiven Datei, links unten)
DIM gliederungZeilen AS ARRAY OF INTEGER : gliederungZeilen = []
DIM gliederungSchluessel AS STRING : gliederungSchluessel = ""

DIM hell AS BOOLEAN : hell = FALSE
DIM codeGroesse AS INTEGER : codeGroesse = 16
DIM umbruchAn AS BOOLEAN : umbruchAn = FALSE
' Geteilte Ansicht: links ein ZWEITER Reiter, rechts der aktive. Beide sind
' echte Code-Felder -- nichts wird gespiegelt, es gibt nichts abzugleichen.
DIM geteilt AS BOOLEAN : geteilt = FALSE
DIM linkerTab AS INTEGER : linkerTab = -1
DIM minimapAn AS BOOLEAN : minimapAn = FALSE
' Faltung: die Bloecke kommen aus CODE_SYMBOLS$ (dieselbe Quelle wie die
' Gliederung), die Laufzeit kennt keine Sprache. Der Schluessel merkt sich,
' was zuletzt gemeldet wurde -- ohne ihn ginge bei jedem Pruefen ein Feld
' durch die Bruecke, obwohl sich nichts geaendert hat.
DIM faltSchluessel AS STRING : faltSchluessel = ""

' Suche im Projekt: die Trefferliste teilt sich die Liste mit den Problemen.
DIM problemModus AS INTEGER : problemModus = 0      ' 0 Probleme, 1 Suche
DIM sucheDateien AS ARRAY OF STRING : sucheDateien = []
DIM sucheZeilen AS ARRAY OF INTEGER : sucheZeilen = []

' Profil
DIM profilZeilen AS ARRAY OF INTEGER : profilZeilen = []

' Wo Handbuch und Beispiele liegen: neben ide/ (dhrt hat nach ide/ gewechselt).
DIM wurzel AS STRING : wurzel = GETENV$("DH_IDE_WURZEL")
IF wurzel = "" THEN wurzel = PATHJOIN(CWD$(), "..")
DIM docsOrdner AS STRING : docsOrdner = PATHJOIN(wurzel, "docs")
DIM beispielOrdner AS STRING : beispielOrdner = PATHJOIN(wurzel, "examples")
IF NOT FILEEXISTS(PATHJOIN(beispielOrdner, "183_sfx_generator.dh")) AND GETENV$("PUBLIC") <> "" THEN
    ' Installation: der Installer legt die Beispiele in die oeffentlichen Dokumente.
    beispielOrdner = PATHJOIN(GETENV$("PUBLIC"), "Documents/Drachenhauch/examples")
END IF
DIM werkzeuge AS ARRAY OF INTEGER : werkzeuge = []     ' laufende Begleitprogramme
DIM docNamen AS ARRAY OF STRING : docNamen = []
DIM docLetzteWahl AS INTEGER : docLetzteWahl = -1

' Einstellungen und Sitzung: EINE JSON-Datei im Nutzerprofil. DH_IDE_KONFIG
' uebersteuert den Ort -- die Tests duerfen die echte nicht anfassen, sonst
' stellte jeder Testlauf dem Nutzer eine fremde Sitzung wieder her.
DIM konfigPfad AS STRING : konfigPfad = GETENV$("DH_IDE_KONFIG")
IF konfigPfad = "" THEN
    DIM konfigBasis AS STRING : konfigBasis = GETENV$("APPDATA")
    IF konfigBasis = "" THEN konfigBasis = PATHJOIN(GETENV$("HOME"), ".config")
    konfigPfad = PATHJOIN(konfigBasis, "Drachenhauch/ide.json")
END IF
DIM konfig AS JSON_HANDLE : konfig = JSON_PARSE("{}")
IF FILEEXISTS(konfigPfad) THEN
    TRY
        konfig = JSON_LOAD(konfigPfad)
    CATCH e
        konfig = JSON_PARSE("{}")     ' eine kaputte Datei ist kein Grund, nicht zu starten
    END TRY
END IF
' Sitzung JE PROJEKT. Im Speicher als drei gleich lange Felder, nicht als
' JSON-Teilbaum: das json-Modul kann einen Teilbaum nicht herausloesen, und
' ein Pfad als JSON-Schluessel kollidierte ohnehin mit der Punkt-Notation
' ("mein.spiel" waere zwei Ebenen).
CONST PROJEKTE_MAX = 12
DIM projOrdner AS ARRAY OF STRING : projOrdner = []
DIM projDateien AS ARRAY OF STRING : projDateien = []     ' Pfade, mit | getrennt
DIM projAktiv AS ARRAY OF INTEGER : projAktiv = []
IF JSON_HAS(konfig, "projekte") THEN
    DIM pj AS INTEGER
    FOR pj = 0 TO JSON_LEN(konfig, "projekte") - 1
        DIM pp AS STRING : pp = "projekte." + STR$(pj)
        DIM pfl AS ARRAY OF STRING : pfl = []
        DIM pd AS INTEGER
        FOR pd = 0 TO JSON_LEN(konfig, pp + ".sitzung") - 1
            ARRAY_PUSH(pfl, JSON_GET_STRING(konfig, pp + ".sitzung." + STR$(pd)))
        NEXT
        ARRAY_PUSH(projOrdner, JSON_GET_STRING(konfig, pp + ".ordner"))
        ARRAY_PUSH(projDateien, JOIN$(pfl, "|"))
        ARRAY_PUSH(projAktiv, JSON_GET_INT(konfig, pp + ".aktiv"))
    NEXT
END IF

DIM zuletzt AS ARRAY OF STRING : zuletzt = []
IF JSON_HAS(konfig, "zuletzt") THEN
    DIM kz AS INTEGER
    FOR kz = 0 TO JSON_LEN(konfig, "zuletzt") - 1
        ARRAY_PUSH(zuletzt, JSON_GET_STRING(konfig, "zuletzt." + STR$(kz)))
    NEXT
END IF
IF JSON_HAS(konfig, "hell") THEN hell = JSON_GET_BOOL(konfig, "hell")
IF JSON_HAS(konfig, "schrift") THEN codeGroesse = MAX(10, MIN(32, JSON_GET_INT(konfig, "schrift")))
IF JSON_HAS(konfig, "umbruch") THEN umbruchAn = JSON_GET_BOOL(konfig, "umbruch")
IF JSON_HAS(konfig, "karte") THEN minimapAn = JSON_GET_BOOL(konfig, "karte")
IF hell THEN GUI_THEME_PRESET("glas_hell")

' offene Dialoge (0 = keiner)
DIM dlgSuche AS GUI_WINDOW : dlgSuche = 0
DIM dlgErsetze AS GUI_WINDOW : dlgErsetze = 0
DIM dlgZeile AS GUI_WINDOW : dlgZeile = 0
DIM dlgEingabe AS GUI_WINDOW : dlgEingabe = 0
DIM dlgSchliessen AS GUI_WINDOW : dlgSchliessen = 0
DIM dlgUeber AS GUI_WINDOW : dlgUeber = 0
DIM dlgProjekt AS GUI_WINDOW : dlgProjekt = 0
DIM dlgBedingung AS GUI_WINDOW : dlgBedingung = 0
DIM dlgUmbenennen AS GUI_WINDOW : dlgUmbenennen = 0
DIM umbenennZeile AS INTEGER : umbenennZeile = 0
DIM umbenennSpalte AS INTEGER : umbenennSpalte = 0
DIM bedingungZeile AS INTEGER : bedingungZeile = 0
DIM schliessenNachDialog AS BOOLEAN : schliessenNachDialog = FALSE

SUB protokoll(text AS STRING)
    IF logDatei = "" THEN RETURN
    DIM f AS FILE
    f = OPENFILE(logDatei, "a")
    WRITELINE(f, text)
    CLOSEFILE(f)
END SUB

' --- Hauptfenster ------------------------------------------------------
DIM win AS GUI_WINDOW
win = GUI_WINDOW("Drachenhauch", 0, 0, SCREENWIDTH(), SCREENHEIGHT())
GUI_WINDOW_CHROME(win, FALSE)
GUI_WINDOW_MOVABLE(win, FALSE)

' Menue
DIM mDatei AS INTEGER : mDatei = GUI_MENU(win, "Datei")
DIM miNeu AS INTEGER : miNeu = GUI_MENU_ITEM(mDatei, "Neu", "Strg+N")
DIM miOeffnen AS INTEGER : miOeffnen = GUI_MENU_ITEM(mDatei, "Oeffnen ...", "Strg+O")
DIM miSchnell AS INTEGER : miSchnell = GUI_MENU_ITEM(mDatei, "Datei im Projekt oeffnen ...", "Strg+Umschalt+O")
' Zuletzt geoeffnet: acht feste Eintraege, die Texte wechseln -- ein Menue
' kann Eintraege nicht wieder loswerden, also werden freie gesperrt.
CONST ZULETZT_MAX = 8
DIM mZuletzt AS INTEGER : mZuletzt = GUI_SUBMENU(mDatei, "Zuletzt geoeffnet")
DIM miZuletzt[ZULETZT_MAX] AS INTEGER
DIM mz AS INTEGER
FOR mz = 0 TO ZULETZT_MAX - 1
    miZuletzt[mz] = GUI_MENU_ITEM(mZuletzt, "-")
    GUI_MENU_ENABLE(miZuletzt[mz], FALSE)
NEXT
DIM miSichern AS INTEGER : miSichern = GUI_MENU_ITEM(mDatei, "Sichern", "Strg+S")
DIM miSichernAls AS INTEGER : miSichernAls = GUI_MENU_ITEM(mDatei, "Sichern unter ...")
GUI_MENU_SEPARATOR(mDatei)
DIM miDrucken AS INTEGER : miDrucken = GUI_MENU_ITEM(mDatei, "Listing drucken", "Strg+P")
DIM miPdf AS INTEGER : miPdf = GUI_MENU_ITEM(mDatei, "Listing als PDF neben die Quelle")
GUI_MENU_SEPARATOR(mDatei)
DIM miSchliessen AS INTEGER : miSchliessen = GUI_MENU_ITEM(mDatei, "Reiter schliessen", "Strg+W")
DIM miBeenden AS INTEGER : miBeenden = GUI_MENU_ITEM(mDatei, "Beenden", "Strg+Q")

DIM mBearb AS INTEGER : mBearb = GUI_MENU(win, "Bearbeiten")
DIM miSuchen AS INTEGER : miSuchen = GUI_MENU_ITEM(mBearb, "Suchen ...", "Strg+F")
DIM miWeiter AS INTEGER : miWeiter = GUI_MENU_ITEM(mBearb, "Weitersuchen", "F3")
DIM miErsetzen AS INTEGER : miErsetzen = GUI_MENU_ITEM(mBearb, "Ersetzen ...", "Strg+H")
DIM miZeile AS INTEGER : miZeile = GUI_MENU_ITEM(mBearb, "Gehe zu Zeile ...", "Strg+G")
DIM miProjekt AS INTEGER : miProjekt = GUI_MENU_ITEM(mBearb, "Im Projekt suchen ...", "Strg+Umschalt+F")
GUI_MENU_SEPARATOR(mBearb)
DIM miVervoll AS INTEGER : miVervoll = GUI_MENU_ITEM(mBearb, "Vervollstaendigen", "Strg+Leer")
DIM miDefinition AS INTEGER : miDefinition = GUI_MENU_ITEM(mBearb, "Zur Definition", "F12")
DIM miUmbenennen AS INTEGER : miUmbenennen = GUI_MENU_ITEM(mBearb, "Umbenennen ...", "Umschalt+F6")
DIM miSchnipsel AS INTEGER : miSchnipsel = GUI_MENU_ITEM(mBearb, "Schnipsel einfuegen ...", "Strg+J")
DIM miPalette AS INTEGER : miPalette = GUI_MENU_ITEM(mBearb, "Befehlspalette ...", "Strg+Umschalt+P")
GUI_MENU_SEPARATOR(mBearb)
' Die Handgriffe im Text. Tab/Umschalt+Tab gehoeren dem Feld selbst (Tab
' rueckt dort schon ein), darum Alt+Pfeile fuers Ein-/Ausruecken.
DIM mZeilen AS INTEGER : mZeilen = GUI_SUBMENU(mBearb, "Zeilen")
DIM miKommentar AS INTEGER : miKommentar = GUI_MENU_ITEM(mZeilen, "Kommentar umschalten", "Strg+K")
DIM miDuplizieren AS INTEGER : miDuplizieren = GUI_MENU_ITEM(mZeilen, "Zeile duplizieren", "Strg+D")
DIM miZeileWeg AS INTEGER : miZeileWeg = GUI_MENU_ITEM(mZeilen, "Zeile loeschen", "Strg+Umschalt+K")
DIM miHoch AS INTEGER : miHoch = GUI_MENU_ITEM(mZeilen, "Zeilen nach oben", "Alt+Hoch")
DIM miRunter AS INTEGER : miRunter = GUI_MENU_ITEM(mZeilen, "Zeilen nach unten", "Alt+Runter")
DIM miEinruecken AS INTEGER : miEinruecken = GUI_MENU_ITEM(mZeilen, "Einruecken", "Alt+Rechts")
DIM miAusruecken AS INTEGER : miAusruecken = GUI_MENU_ITEM(mZeilen, "Ausruecken", "Alt+Links")
DIM miFormat AS INTEGER : miFormat = GUI_MENU_ITEM(mBearb, "Dokument formatieren", "Umschalt+Alt+F")
DIM miLesezeichen AS INTEGER : miLesezeichen = GUI_MENU_ITEM(mBearb, "Lesezeichen setzen/entfernen", "Strg+F2")
DIM miLzWeiter AS INTEGER : miLzWeiter = GUI_MENU_ITEM(mBearb, "Naechstes Lesezeichen", "F2")
DIM miTodo AS INTEGER : miTodo = GUI_MENU_ITEM(mBearb, "TODO / FIXME im Projekt", "Strg+Umschalt+M")

DIM mLauf AS INTEGER : mLauf = GUI_MENU(win, "Ausfuehren")
DIM miStart AS INTEGER : miStart = GUI_MENU_ITEM(mLauf, "Starten", "F5")
DIM miStopp AS INTEGER : miStopp = GUI_MENU_ITEM(mLauf, "Stoppen", "Umschalt+F5")
DIM miPruefen AS INTEGER : miPruefen = GUI_MENU_ITEM(mLauf, "Pruefen", "Umschalt+F7")
GUI_MENU_SEPARATOR(mLauf)
DIM miDebug AS INTEGER : miDebug = GUI_MENU_ITEM(mLauf, "Debuggen", "F7")
DIM miHaltepunkt AS INTEGER : miHaltepunkt = GUI_MENU_ITEM(mLauf, "Haltepunkt setzen/entfernen", "F9")
DIM miBedingung AS INTEGER : miBedingung = GUI_MENU_ITEM(mLauf, "Bedingter Haltepunkt ...", "Umschalt+F9")
DIM miWeiterD AS INTEGER : miWeiterD = GUI_MENU_ITEM(mLauf, "Weiter", "F8")
DIM miDrueber AS INTEGER : miDrueber = GUI_MENU_ITEM(mLauf, "Schritt drueber", "F10")
DIM miHinein AS INTEGER : miHinein = GUI_MENU_ITEM(mLauf, "Schritt hinein", "F11")
DIM miHeraus AS INTEGER : miHeraus = GUI_MENU_ITEM(mLauf, "Schritt heraus", "Umschalt+F11")
GUI_MENU_SEPARATOR(mLauf)
DIM miProfil AS INTEGER : miProfil = GUI_MENU_ITEM(mLauf, "Profil aufnehmen", "Strg+Umschalt+Y")
GUI_MENU_SEPARATOR(mLauf)
DIM miExport AS INTEGER : miExport = GUI_MENU_ITEM(mLauf, "Als eigenstaendiges Programm exportieren", "Strg+F6")

DIM mWerkzeuge AS INTEGER : mWerkzeuge = GUI_MENU(win, "Werkzeuge")
DIM miWzSfx AS INTEGER : miWzSfx = GUI_MENU_ITEM(mWerkzeuge, "SFX-Generator")
DIM miWzPartikel AS INTEGER : miWzPartikel = GUI_MENU_ITEM(mWerkzeuge, "Partikel-Editor")
DIM miWzTilemap AS INTEGER : miWzTilemap = GUI_MENU_ITEM(mWerkzeuge, "Tilemap-Editor")
DIM miWzSprite AS INTEGER : miWzSprite = GUI_MENU_ITEM(mWerkzeuge, "Sprite-Editor")
DIM miWzTracker AS INTEGER : miWzTracker = GUI_MENU_ITEM(mWerkzeuge, "Tracker")
DIM miWzForm AS INTEGER : miWzForm = GUI_MENU_ITEM(mWerkzeuge, "Form-Designer")
DIM miWzAnim AS INTEGER : miWzAnim = GUI_MENU_ITEM(mWerkzeuge, "Anim-FSM-Editor")
DIM miWzNoten AS INTEGER : miWzNoten = GUI_MENU_ITEM(mWerkzeuge, "Notenblatt")
GUI_MENU_SEPARATOR(mWerkzeuge)
DIM miBeispiele AS INTEGER : miBeispiele = GUI_MENU_ITEM(mWerkzeuge, "Beispiele als Projekt oeffnen")
DIM miAusdruck AS INTEGER : miAusdruck = GUI_MENU_ITEM(mWerkzeuge, "Ausdruck im Debugger auswerten", "Strg+E")

DIM mAnsicht AS INTEGER : mAnsicht = GUI_MENU(win, "Ansicht")
DIM miThema AS INTEGER : miThema = GUI_MENU_ITEM(mAnsicht, "Helles Thema")
GUI_MENU_CHECK(miThema, hell)
DIM miVollbild AS INTEGER : miVollbild = GUI_MENU_ITEM(mAnsicht, "Vollbild", "Alt+Enter")
GUI_MENU_SEPARATOR(mAnsicht)
DIM miGeteilt AS INTEGER : miGeteilt = GUI_MENU_ITEM(mAnsicht, "Geteilte Ansicht", "Alt+G")
GUI_MENU_CHECK(miGeteilt, FALSE)
DIM miMinimap AS INTEGER : miMinimap = GUI_MENU_ITEM(mAnsicht, "Uebersichtskarte")
GUI_MENU_CHECK(miMinimap, FALSE)
DIM miUmbruch AS INTEGER : miUmbruch = GUI_MENU_ITEM(mAnsicht, "Zeilenumbruch", "Alt+Z")
GUI_MENU_CHECK(miUmbruch, FALSE)
DIM miFalten AS INTEGER : miFalten = GUI_MENU_ITEM(mAnsicht, "Block zuklappen/aufklappen", "F4")
DIM miFaltenAlle AS INTEGER : miFaltenAlle = GUI_MENU_ITEM(mAnsicht, "Alles zuklappen", "Strg+F4")
DIM miFaltenAuf AS INTEGER : miFaltenAuf = GUI_MENU_ITEM(mAnsicht, "Alles aufklappen", "Umschalt+F4")
DIM miGroesser AS INTEGER : miGroesser = GUI_MENU_ITEM(mAnsicht, "Schrift groesser")
DIM miKleiner AS INTEGER : miKleiner = GUI_MENU_ITEM(mAnsicht, "Schrift kleiner")

DIM mHilfe AS INTEGER : mHilfe = GUI_MENU(win, "Hilfe")
DIM miHandbuch AS INTEGER : miHandbuch = GUI_MENU_ITEM(mHilfe, "Handbuch (Wort unter der Marke)", "F1")
DIM miKuerzel AS INTEGER : miKuerzel = GUI_MENU_ITEM(mHilfe, "Tastenkuerzel", "Strg+F1")
DIM miUeber AS INTEGER : miUeber = GUI_MENU_ITEM(mHilfe, "Ueber ...")

' Bereiche -- die Masse setzt `layout` bei jeder Groessenaenderung.
DIM baum AS GUI_WIDGET : baum = GUI_TREE(win, 0, 0, 10, 10)
DIM lblProjekt AS GUI_WIDGET : lblProjekt = GUI_LABEL(win, "Projekt", 0, 0)
DIM lblGliederung AS GUI_WIDGET : lblGliederung = GUI_LABEL(win, "Gliederung", 0, 0)
DIM lstGliederung AS GUI_WIDGET : lstGliederung = GUI_LISTBOX(win, 0, 0, 10, 10, [])
' Willkommensseite -- sie steht dort, wo sonst die Code-Felder liegen, und
' verschwindet mit dem ersten Reiter.
DIM lblWkTitel AS GUI_WIDGET : lblWkTitel = GUI_LABEL(win, "Drachenhauch", 0, 0)
GUI_SET_FONT_SIZE(lblWkTitel, 34)
DIM lblWkUnter AS GUI_WIDGET : lblWkUnter = GUI_LABEL(win, "BASIC fuer Spiele -- mit Pascal-strikter Typisierung und OOP. Diese IDE ist selbst in Drachenhauch geschrieben.", 0, 0)
DIM btnWkNeu AS GUI_WIDGET : btnWkNeu = GUI_BUTTON(win, "Neue Datei", 0, 0, 130, 30)
DIM btnWkOeffnen AS GUI_WIDGET : btnWkOeffnen = GUI_BUTTON(win, "Datei oeffnen ...", 0, 0, 150, 30)
DIM btnWkBeispiele AS GUI_WIDGET : btnWkBeispiele = GUI_BUTTON(win, "Beispiele als Projekt", 0, 0, 180, 30)
