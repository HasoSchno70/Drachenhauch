' Interaktive gui-Beispiele muessen sich beenden lassen.
'
' Der Schleifenkopf eines Fenster-Programms gehoert `QUITREQUESTED()`. Wer
' stattdessen `WHILE TRUE` schreibt, baut ein Programm, das auf den
' Schliessen-Knopf nicht reagiert und sich headless nicht pruefen laesst.
' Beides ist beim Bau des SFX-Generators am 2026-08-30 passiert, gleich
' zweimal -- und niemandem aufgefallen, weil die Beispiel-Pruefung nur die
' NICHT-grafischen Programme ausfuehrt.
'
' Bis 2026-09-16 tests/test_beispiele_gui_enden.py. Gestartet wird mit
' `dhrt run --bilder 20` (der Schalter kam fuer genau diesen Fall dazu: aus
' einem Programm heraus nimmt PROCESS_START dem Kind DHRT_FRAMES ab).

=== jedes interaktive gui-beispiel endet von selbst
DIM ordner AS STRING : ordner = ARG$(0)
' Wer ein neues Fenster-Programm baut, traegt es hier ein.
DIM namen AS ARRAY OF STRING
namen = ["155_gui_glas", "156_gui_alle_widgets", "182_gui_tastatur_massstab", _
         "183_sfx_generator", "184_codefeld", "185_partikel_editor", _
         "186_farbe_und_datum", "187_tilemap_editor", "188_bild_erzeugen", _
         "189_sprite_editor"]
DIM i AS INTEGER
FOR i = 0 TO LEN(namen) - 1
    DIM pfad AS STRING : pfad = ordner + "/" + namen[i] + ".dh"
    IF NOT FILEEXISTS(pfad) THEN
        PRINT namen[i]; " fehlt"
        CONTINUE
    END IF
    DIM t0 AS INTEGER : t0 = MILLIS()
    DIM p AS INTEGER : p = PROCESS_START("dhrt", "run", "--bilder", "20", pfad)
    DIM fehler AS STRING : fehler = ""
    ' Mitlesen: ein voller Puffer hielte das Kind an.
    WHILE PROCESS_RUNNING(p) AND MILLIS() - t0 < 25000
        DIM weg AS STRING : weg = PROCESS_READ$(p)
        fehler = fehler + PROCESS_ERR$(p)
        SLEEP(20)
    WEND
    IF PROCESS_RUNNING(p) THEN
        PROCESS_KILL(p)
        ' 20 Bilder sind ein Drittel einer Sekunde. Alles jenseits weniger
        ' Sekunden heisst: es lief bis zu irgendeiner Grenze statt bis zum
        ' Kennzeichen.
        PRINT namen[i]; " endet NICHT -- Schleifenkopf auf QUITREQUESTED umstellen"
        CONTINUE
    END IF
    fehler = fehler + PROCESS_ERR$(p)
    IF PROCESS_CODE(p) <> 0 THEN
        ' Ohne Bildschirm (oder im Bau ohne raylib) kommt gar kein Fenster
        ' zustande -- dann ist hier nichts zu pruefen.
        PRINT "UEBERSPRINGEN: " + REPLACE$(TRIM$(SPLIT$(fehler, CHR$(10))[0]), CHR$(13), "")
        EXIT(0)
    END IF
    PRINT namen[i]; " endet"
NEXT
--- argumente
{sammlung}/../../examples
--- erwartet
155_gui_glas endet
156_gui_alle_widgets endet
182_gui_tastatur_massstab endet
183_sfx_generator endet
184_codefeld endet
185_partikel_editor endet
186_farbe_und_datum endet
187_tilemap_editor endet
188_bild_erzeugen endet
189_sprite_editor endet
