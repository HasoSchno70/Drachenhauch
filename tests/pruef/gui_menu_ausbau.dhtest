' Aus test_gui_menu_ausbau.py uebertragen (17 Faelle, aufgezeichnet 2026-09-08). Format: docs/werkzeuge.md, dhrt test.

=== strg s loest den eintrag aus
IMPORT "gui"
SCREEN(400, 300, "T", 1)
SET_WINDOW_POS(-3000, -3000)
AUTOMATION_PLAY("ev.txt")
DIM w AS GUI_WINDOW
w = GUI_WINDOW("T", 10, 10, 360, 260)
DIM m AS INTEGER : m = GUI_MENU(w, "Datei")
DIM a AS INTEGER : a = GUI_MENU_ITEM(m, "Sichern", "Strg+S")
DIM f AS INTEGER
FOR f = 1 TO 10
    GUI_UPDATE()
    IF GUI_CLICKED(a) THEN PRINT "sichern " + STR$(f)
    GUI_DRAW()
    FLIP()
NEXT
